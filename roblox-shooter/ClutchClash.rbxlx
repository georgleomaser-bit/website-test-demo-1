        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Core</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Texte "core." (Shared/Lang/Core)
--  Besitzer: WP1 (Core & Plattform). Nur Schlüssel mit Präfix "core.".
--  Platzhalter wie string.format: %s = Text, %d = ganze Zahl.
--  Pflicht-Schlüssel (C16): core.gameName, core.loading, core.error, core.noAnswer, core.studioNoSave.
--  Vom Server benutzt: core.tooFast, core.unknownAction, core.invalid, core.studioNoApi, core.loadFailed.
-- =====================================================================

return {
	de = {
		["core.gameName"] = "CLUTCH CLASH",
		["core.tagline"] = "Sofort-Duelle. Null Warten. Reiner Skill.",
		["core.welcome"] = "Willkommen bei CLUTCH CLASH!",
		["core.version"] = "Version %s",
		["core.loading"] = "Lädt noch…",
		["core.error"] = "Etwas ist schiefgelaufen – versuch es nochmal.",
		["core.noAnswer"] = "📡 Keine Antwort vom Server",
		["core.studioNoSave"] = "Studio: Fortschritt wird nicht gespeichert",
		["core.studioNoApi"] = "Studio: Speichern ist AUS – aktiviere in Game Settings → Security „Studio Access to API Services“.",
		["core.tooFast"] = "Langsam! 🐢",
		["core.unknownAction"] = "Unbekannte Aktion",
		["core.invalid"] = "Ungültige Eingabe",
		["core.settingsSaved"] = "Einstellungen gespeichert",
		["core.loadFailed"] = "Dein Spielstand konnte nicht geladen werden. Bitte tritt erneut bei. (Roblox-Server ausgelastet)",
		["core.dataReset"] = "Dein Spielstand wurde zurückgesetzt.",
	},
	en = {
		["core.gameName"] = "CLUTCH CLASH",
		["core.tagline"] = "Instant duels. Zero waiting. Pure skill.",
		["core.welcome"] = "Welcome to CLUTCH CLASH!",
		["core.version"] = "Version %s",
		["core.loading"] = "Loading…",
		["core.error"] = "Something went wrong – please try again.",
		["core.noAnswer"] = "📡 No answer from the server",
		["core.studioNoSave"] = "Studio: progress is not saved",
		["core.studioNoApi"] = "Studio: saving is OFF – enable “Studio Access to API Services” in Game Settings → Security.",
		["core.tooFast"] = "Slow down! 🐢",
		["core.unknownAction"] = "Unknown action",
		["core.invalid"] = "Invalid input",
		["core.settingsSaved"] = "Settings saved",
		["core.loadFailed"] = "Your progress could not be loaded. Please rejoin. (Roblox servers are busy)",
		["core.dataReset"] = "Your progress has been reset.",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Texte "item." (Shared/Lang/Items)
--  Besitzer: WP9 (Wirtschaft, Monetarisierung, Kosmetik). Nur Schlüssel mit Präfix "item.".
--  Seltenheiten, Item-Arten und Bezugsquellen. Die Namen der einzelnen Items stehen als { de, en }
--  direkt in Config.Cosmetics (Lang.Pick), damit Daten und Namen nie auseinanderlaufen.
-- =====================================================================

return {
	de = {
		["item.rarity.Common"] = "Gewöhnlich",
		["item.rarity.Rare"] = "Selten",
		["item.rarity.Epic"] = "Episch",
		["item.rarity.Legendary"] = "Legendär",
		["item.rarity.Mythic"] = "Mythisch",
		["item.kind.Wrap"] = "Wrap",
		["item.kind.Skin"] = "Skin",
		["item.kind.Charm"] = "Anhänger",
		["item.kind.Finisher"] = "Finisher",
		["item.kind.Tracer"] = "Leuchtspur",
		["item.kind.Title"] = "Titel",
		["item.kinds.Wrap"] = "Wraps",
		["item.kinds.Skin"] = "Skins",
		["item.kinds.Charm"] = "Anhänger",
		["item.kinds.Finisher"] = "Finisher",
