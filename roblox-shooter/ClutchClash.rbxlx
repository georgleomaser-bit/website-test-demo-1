      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Damage</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Schadensrechnung (Shared/Damage)
--  Besitzer: WP3 (Kampf Server & Treffer-Mathematik). Vertrag: DESIGN.md C6.2, B11.1.
--  Reines Modul – Server (Wertung) und Client (Vorschau, Training-DPS) rechnen identisch.
--
--  Öffentliche API:
--    Damage.Compute(def, dist, region, rules?): number
--        base = lerp(Damage, Damage × MinMult, clamp((dist − FalloffStart) / (FalloffEnd − FalloffStart), 0, 1))
--        × (Kopf: HeadMult, Körper: 1.0) × rules.DamageMult; rules.HeadOnly -> Körper = 0.
--        Schrot-Waffen: Wert gilt pro Schrot (der Server summiert die Treffer).
--    Damage.Splash(def, dist): number
--        linear SplashMax (Mitte) -> SplashMin (Rand bei Projectile.Radius), außerhalb 0.
--        Selbstschaden (SelfMult) und rules.DamageMult rechnet der Aufrufer.
--    Damage.Falloff(def, dist): number      nur der Abfall-Faktor 0..1 (0 = voller Schaden)
--  Werte werden NICHT gerundet (die Anzeige rundet).
-- =====================================================================

local Types = require(script.Parent:WaitForChild("Types"))

local Damage = {}

local function finiteOr(n: number?, default: number): number
	if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then
		return default
	end
	return n
end

local function lerp(a: number, b: number, alpha: number): number
	return a + (b - a) * alpha
end

function Damage.Falloff(def: Types.WeaponDef, dist: number): number
	local d = math.max(0, finiteOr(dist, 0))
	local s = finiteOr(def.FalloffStart, 0)
	local e = finiteOr(def.FalloffEnd, s)
	if e <= s then
		return if d >= e and d > s then 1 else 0
	end
	return math.clamp((d - s) / (e - s), 0, 1)
end

function Damage.Compute(def: Types.WeaponDef, dist: number, region: "Head" | "Body", rules: Types.ContextRules?): number
	local damage = math.max(0, finiteOr(def.Damage, 0))
	local minMult = finiteOr(def.MinMult, 1)
	local base = lerp(damage, damage * minMult, Damage.Falloff(def, dist))
	if region == "Head" then
		base *= math.max(0, finiteOr(def.HeadMult, 1))
	elseif rules and rules.HeadOnly then
		return 0
	end
	if rules then
		base *= math.max(0, finiteOr(rules.DamageMult, 1))
	end
	return math.max(0, base)
end

function Damage.Splash(def: Types.WeaponDef, dist: number): number
	local proj = def.Projectile
	if not proj then
		return 0
	end
	local radius = finiteOr(proj.Radius, 0)
	local d = math.max(0, finiteOr(dist, math.huge))
	if radius <= 0 or d >= radius then
		return 0
	end
	local maxDamage = math.max(0, finiteOr(proj.SplashMax, 0))
	local minDamage = math.max(0, finiteOr(proj.SplashMin, 0))
	return lerp(maxDamage, minDamage, d / radius)
end

return Damage
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Hitbox</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Analytische Hitboxen (Shared/Hitbox)
--  Besitzer: WP3 (Kampf Server & Treffer-Mathematik). Vertrag: DESIGN.md C6.2, B13.2, C10.
--  Reines Modul. Feste Größe für JEDEN Avatar – nur aus HRP-CFrame + Kopf-Position:
--    Kopf   = Kugel um head, Radius headRadius (+ tol)
--    Körper = OBB aus root × CFrame.new(BodyOffset), Halbmaße BodyHalf (+ tol je Achse)
--  Region = näherer Eintrittspunkt; der Kopf gewinnt einen Gleichstand innerhalb HeadTieBreak (0.5 Studs).
--
--  Öffentliche API:
--    Hitbox.Ray(origin, dir, range, root, head, headRadius, tol): (("Head" | "Body")?, number?)
--        Strahl gegen beide Formen; Rückgabe Region + Entfernung des Eintrittspunkts (<= range), sonst nil.
--        Liegt origin schon in einer Form, ist die Entfernung 0.
--    Hitbox.PointDistance(p, root, head): number
--        Abstand von p zum nächsten Hitbox-Punkt (Kopf-Radius HeadRadius, Körper ohne Toleranz), >= 0.
--    Hitbox.BodyCFrame(root): CFrame      Mitte der Körper-OBB
--  Werte (HeadRadius, BodyOffset, BodyHalf, HeadTieBreak) kommen aus Config.Combat.
-- =====================================================================

local Hitbox = {}

-- Startwerte = Config.Combat (zur Laufzeit von dort gelesen)
local headRadiusBase = 0.8
local bodyOffset = Vector3.new(0, -1, 0)
local bodyHalf = Vector3.new(1.5, 2.0, 0.8)
local headTieBreak = 0.5

do
	local ok, combat = pcall(function()
		return require(script.Parent:WaitForChild("Config"):WaitForChild("Combat"))
	end)
	if ok and type(combat) == "table" then
		local c = combat :: any
		if type(c.HeadRadius) == "number" and c.HeadRadius > 0 then
			headRadiusBase = c.HeadRadius
		end
		if typeof(c.BodyOffset) == "Vector3" then
			bodyOffset = c.BodyOffset
		end
		if typeof(c.BodyHalf) == "Vector3" then
			bodyHalf = c.BodyHalf
		end
		if type(c.HeadTieBreak) == "number" and c.HeadTieBreak >= 0 then
			headTieBreak = c.HeadTieBreak
		end
	end
end

local EPS = 1e-9

local function finite(n: number): boolean
	return n == n and n ~= math.huge and n ~= -math.huge
end

local function finiteVec(v: Vector3): boolean
	return finite(v.X) and finite(v.Y) and finite(v.Z)
end

function Hitbox.BodyCFrame(root: CFrame): CFrame
	return root * CFrame.new(bodyOffset)
end

-- Strahl (Einheitsrichtung d) gegen Kugel: Eintrittsentfernung oder nil
local function raySphere(o: Vector3, d: Vector3, center: Vector3, radius: number): number?
	local oc = o - center
	local b = oc:Dot(d)
	local c = oc:Dot(oc) - radius * radius
	if c <= 0 then
		return 0 -- Ursprung liegt in der Kugel
	end
	if b > 0 then
		return nil -- Kugel liegt hinter dem Ursprung
	end
	local disc = b * b - c
	if disc < 0 then
		return nil
	end
	return math.max(0, -b - math.sqrt(disc))
end

-- eine Achse des Slab-Tests: neues (tmin, tmax) oder nil, wenn der Strahl die Platte verfehlt
local function slab(ov: number, dv: number, hv: number, tmin: number, tmax: number): (number?, number)
	if math.abs(dv) < EPS then
		if ov < -hv or ov > hv then
			return nil, tmax
		end
		return tmin, tmax
	end
	local t1 = (-hv - ov) / dv
	local t2 = (hv - ov) / dv
	if t1 > t2 then
		t1, t2 = t2, t1
	end
	if t1 > tmin then
		tmin = t1
	end
	if t2 < tmax then
		tmax = t2
	end
	if tmin > tmax then
		return nil, tmax
	end
	return tmin, tmax
end

-- Strahl gegen OBB (Slab-Test im lokalen Raum, ohne Tabellen): Eintrittsentfernung oder nil
local function rayBox(o: Vector3, d: Vector3, box: CFrame, half: Vector3): number?
	local lo = box:PointToObjectSpace(o)
	local ld = box:VectorToObjectSpace(d)
	local tmin: number? = -math.huge
	local tmax = math.huge
	tmin, tmax = slab(lo.X, ld.X, half.X, tmin :: number, tmax)
	if tmin == nil then
		return nil
	end
	tmin, tmax = slab(lo.Y, ld.Y, half.Y, tmin, tmax)
	if tmin == nil then
		return nil
	end
	tmin, tmax = slab(lo.Z, ld.Z, half.Z, tmin, tmax)
	if tmin == nil or tmax < 0 then
		return nil
	end
	return math.max(0, tmin)
end

function Hitbox.Ray(
	origin: Vector3,
	dir: Vector3,
	range: number,
	root: CFrame,
	head: Vector3,
	headRadius: number,
	tol: number
): (("Head" | "Body")?, number?)
	if not (finiteVec(origin) and finiteVec(dir) and finiteVec(head) and finite(range)) then
		return nil, nil
	end
	local m = dir.Magnitude
	if m < 1e-6 then
		return nil, nil
	end
	local d = dir / m
	local extra = if finite(tol) then math.max(0, tol) else 0
	local r = (if finite(headRadius) then math.max(0, headRadius) else headRadiusBase) + extra
	local maxDist = math.max(0, range)

	local tHead = raySphere(origin, d, head, r)
	if tHead and tHead > maxDist then
		tHead = nil
	end
	local half = bodyHalf + Vector3.new(extra, extra, extra)
	local tBody = rayBox(origin, d, Hitbox.BodyCFrame(root), half)
	if tBody and tBody > maxDist then
		tBody = nil
	end

	if tHead and tBody then
		if tHead <= tBody + headTieBreak then
			return "Head", tHead
		end
		return "Body", tBody
	elseif tHead then
		return "Head", tHead
	elseif tBody then
		return "Body", tBody
	end
	return nil, nil
end

function Hitbox.PointDistance(p: Vector3, root: CFrame, head: Vector3): number
	if not (finiteVec(p) and finiteVec(head)) then
		return math.huge
	end
	local headDist = math.max(0, (p - head).Magnitude - headRadiusBase)
	local box = Hitbox.BodyCFrame(root)
	local lp = box:PointToObjectSpace(p)
	local cx = math.clamp(lp.X, -bodyHalf.X, bodyHalf.X)
	local cy = math.clamp(lp.Y, -bodyHalf.Y, bodyHalf.Y)
	local cz = math.clamp(lp.Z, -bodyHalf.Z, bodyHalf.Z)
	local bodyDist = (lp - Vector3.new(cx, cy, cz)).Magnitude
	return math.min(headDist, bodyDist)
end

return Hitbox
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Lang</string>
          <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Sprachen DE/EN (Shared/Lang)
--  Besitzer: WP1 (Core & Plattform). Vertrag: DESIGN.md C16 + C6.1.
--
--  Domänen-Dateien (jedes Paket pflegt seine, Präfix-Pflicht):
--    Core core. (WP1) · World world. (WP2) · Combat combat. (WP3) · Match match. (WP5) · Bots bot. (WP6)
--    Admin admin. (WP7) · Progress prog. (WP8) · Shop + Items shop./item. (WP9) · Ui ui. (WP10)
--  Jede Datei gibt { de = { [key] = text }, en = { [key] = text } } zurück.
--
--  Öffentliche API:
--    Lang.T(lang, key, ...): string      string.format(text, ...) in pcall; fehlt der Schlüssel -> Englisch -> Schlüssel
--    Lang.Pick(lang, { de, en }): string Config-Anzeigenamen
--    Lang.For(p, override?): "de" | "en" override "de"/"en" aus Einstellungen, sonst LocaleId "de…" -> "de", sonst "en"
--    Lang.Missing(): { string }          Schlüssel, die in einer Sprache fehlen (+ fehlende/kaputte Dateien)
--    Lang.Has(key): boolean
-- =====================================================================

local RunService = game:GetService("RunService")

local Types = require(script.Parent:WaitForChild("Types"))

local Lang = {}

local LANGUAGES: { Types.Lang } = { "de", "en" }
local MAX_ARGS = 16

local FILES: { { Name: string, Prefixes: { string } } } = {
	{ Name = "Core", Prefixes = { "core." } },
	{ Name = "World", Prefixes = { "world." } },
	{ Name = "Combat", Prefixes = { "combat." } },
	{ Name = "Match", Prefixes = { "match." } },
	{ Name = "Bots", Prefixes = { "bot." } },
	{ Name = "Admin", Prefixes = { "admin." } },
	{ Name = "Progress", Prefixes = { "prog." } },
	{ Name = "Shop", Prefixes = { "shop.", "item." } },
	{ Name = "Items", Prefixes = { "item.", "shop." } },
	{ Name = "Ui", Prefixes = { "ui." } },
}

local dict: { [string]: { [string]: string } } = { de = {}, en = {} }
local sourceOf: { [string]: { [string]: string } } = { de = {}, en = {} } -- Schlüssel -> Datei (für Doppelte)
local loadIssues: { string } = {}

-- Client: erst warten, bis die erste Replikation fertig ist (sonst fehlen Dateien evtl. noch)
if RunService:IsClient() and not RunService:IsServer() and not game:IsLoaded() then
	game.Loaded:Wait()
end

local function hasPrefix(key: string, prefixes: { string }): boolean
	for _, prefix in ipairs(prefixes) do
		if string.sub(key, 1, #prefix) == prefix then
			return true
		end
	end
	return false
end

local function loadFile(name: string, prefixes: { string })
	local module = script:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		table.insert(loadIssues, "Lang." .. name .. " (Datei fehlt)")
		return
	end
	local ok, result = pcall(require, module)
	if not ok or type(result) ~= "table" then
		table.insert(loadIssues, "Lang." .. name .. " (Fehler beim Laden)")
		warn("[Lang] Lang." .. name .. " konnte nicht geladen werden: " .. tostring(result))
		return
	end
	for _, lang in ipairs(LANGUAGES) do
		local entries = result[lang]
		if type(entries) ~= "table" then
			table.insert(loadIssues, ("Lang.%s.%s (Tabelle fehlt)"):format(name, lang))
			continue
		end
		local target, sources = dict[lang], sourceOf[lang]
		for key, text in pairs(entries) do
			if type(key) ~= "string" or type(text) ~= "string" then
				warn(
					("[Lang] Lang.%s.%s: Schlüssel und Text müssen Strings sein (%s)"):format(
						name,
						lang,
						tostring(key)
					)
				)
			elseif sources[key] ~= nil then
				warn(
					("[Lang] Doppelter Schlüssel %s (%s) in Lang.%s, schon in Lang.%s"):format(
						key,
						lang,
						name,
						sources[key]
					)
				)
			else
				if not hasPrefix(key, prefixes) then
					warn(
						("[Lang] Lang.%s: Schlüssel %s hat das falsche Präfix (erwartet %s)"):format(
							name,
							key,
							table.concat(prefixes, " / ")
						)
					)
				end
				target[key] = text
				sources[key] = name
			end
		end
	end
end

for _, file in ipairs(FILES) do
	loadFile(file.Name, file.Prefixes)
end

-- Text in der gewünschten Sprache; fehlt er -> Englisch -> der Schlüssel selbst.
-- Argumente wie string.format (%d, %s, …). Kaputtes Format -> Text ohne Ersetzung.
function Lang.T(lang: Types.Lang, key: string, ...: any): string
	local name = if type(key) == "string" then key else tostring(key)
	local entries = dict[lang]
	local text = (entries and entries[name]) or dict.en[name] or name
	local count = select("#", ...)
	if count == 0 and not string.find(text, "%", 1, true) then
		return text
	end
	-- nil/Tabellen/Instanzen sicher in Text verwandeln (string.format würde sonst scheitern)
	local args = table.create(math.min(count, MAX_ARGS))
	for i = 1, math.min(count, MAX_ARGS) do
		local value = select(i, ...)
		local kind = type(value)
		if kind == "number" then
			args[i] = if value == value then value else 0
		elseif kind == "string" then
			args[i] = value
		elseif value == nil then
			args[i] = ""
		else
			args[i] = tostring(value)
		end
	end
	local ok, result = pcall(string.format, text, table.unpack(args, 1, math.min(count, MAX_ARGS)))
	if ok then
		return result
	end
	return text
end

-- { de = "…", en = "…" } -> Text in der Sprache (Fallback Englisch, dann Deutsch)
function Lang.Pick(lang: Types.Lang, t: { de: string, en: string }): string
	local raw: any = t
	if type(raw) == "string" then
		return raw
	elseif type(raw) ~= "table" then
		return ""
	end
	local value = raw[lang]
	if type(value) ~= "string" then
		value = raw.en
	end
	if type(value) ~= "string" then
		value = raw.de
	end
	return if type(value) == "string" then value else ""
end

-- Sprache eines Spielers: Einstellung "de"/"en" gewinnt, sonst LocaleId ("de-de" -> "de"), sonst "en"
function Lang.For(p: Player, override: string?): Types.Lang
	if override == "de" or override == "en" then
		return override
	end
	local ok, locale = pcall(function()
		return p.LocaleId
	end)
	if ok and type(locale) == "string" and string.lower(string.sub(locale, 1, 2)) == "de" then
		return "de"
	end
	return "en"
end

function Lang.Has(key: string): boolean
	return dict.en[key] ~= nil or dict.de[key] ~= nil
end

-- Schlüssel, die in einer Sprache fehlen (sortiert) + fehlende/kaputte Dateien. Leer = alles ok.
function Lang.Missing(): { string }
	local missing: { string } = {}
	for _, lang in ipairs(LANGUAGES) do
		for _, other in ipairs(LANGUAGES) do
			if other ~= lang then
				for key in pairs(dict[other]) do
					if dict[lang][key] == nil then
						table.insert(missing, ("%s (fehlt in %s)"):format(key, lang))
					end
				end
			end
		end
	end
	table.sort(missing)
	for _, issue in ipairs(loadIssues) do
		table.insert(missing, issue)
	end
	return missing
end

return Lang
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Admin</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Texte "admin." (Shared/Lang/Admin)
--  Besitzer: WP7 (Sicherheit, Admin, Live-Balance). Nur Schlüssel mit Präfix "admin.".
--  Platzhalter wie string.format: %s = Text, %d = ganze Zahl, %.2f = Kommazahl, %% = Prozentzeichen.
--  Pflicht-Schlüssel (C16): admin.denied, admin.tainted.
--  Benutzt von: AdminService, AntiCheatService, BalanceService (Server) und AdminPanel, AdminTools, Fly,
--  PhotoMode, DebugOverlay (Client, nur Besitzer). Spieler sehen: acKick, acBanReason, report*,
--  abuseEnd, kickDefault, kickAllDefault, lockedKick.
-- =====================================================================

return {
	de = {
		-- Pflicht / allgemein
		["admin.denied"] = "Kein Zugriff",
		["admin.tainted"] = "TAINTED / Admin-Show",
		["admin.error"] = "Fehler: %s",
