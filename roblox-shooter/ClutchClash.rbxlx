		["admin.popped"] = "Gepoppt: %s",
		["admin.healed"] = "Geheilt: %s",
		["admin.giveEmpty"] = "Nichts zu geben (Zahlen oder Waffen/Kosmetik eintragen)",
		["admin.given"] = "Gegeben an: %s",
