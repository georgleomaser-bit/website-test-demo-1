		["admin.kickDefault"] = "Du wurdest vom Admin gekickt.",
		["admin.banDuration"] = "Dauer: 1h, 1d, 7d, 30d oder perm",
		["admin.banDefault"] = "Verstoß gegen die Spielregeln",
		["admin.banFailed"] = "Bann fehlgeschlagen: %s",
