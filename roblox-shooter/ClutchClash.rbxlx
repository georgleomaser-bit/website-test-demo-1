-- ---------------------------------------------------------------------
-- 3) ANZEIGE-TEILE
-- ---------------------------------------------------------------------
local function showBanner(text: string, color: Color3?, sub: string?, seconds: number?)
	local b = bannerLabel
	if not b then
		return
	end
	b.Text = text
	b.TextColor3 = color or WHITE
	b.Visible = true
	if bannerScale then
		bannerScale.Scale = 0.4
		TweenService:Create(bannerScale, BANNER_POP, { Scale = 1 }):Play()
	end
	if subBanner then
		subBanner.Text = sub or ""
		subBanner.Visible = sub ~= nil and sub ~= ""
	end
	bannerUntil = os.clock() + (seconds or BANNER_SECONDS)
end

local function showNotice(text: string, seconds: number)
	local n = noticeLabel
	if not n then
		return
	end
	n.Text = text
	n.Visible = true
	noticeUntil = os.clock() + seconds
end

local function rebuildPips(holder: Frame?, wins: number, total: number, color: Color3)
	if not holder then
		return
	end
	local pips = {}
	for _, child in ipairs(holder:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(pips, child)
		end
	end
	if #pips ~= total then
		for _, pip in ipairs(pips) do
			pip:Destroy()
		end
		pips = {}
		for i = 1, total do
			local pip = UI.Create("Frame", {
				Name = "Pip" .. i,
				LayoutOrder = i,
				Size = UDim2.fromOffset(16, 16),
				BackgroundColor3 = UI.Theme.PanelDark,
				ZIndex = 22,
				Parent = holder,
			}, { UI.Corner(8), UI.Stroke(BLACK, 2), UI.Create("UIScale", {}) })
			table.insert(pips, pip)
		end
	end
	for i, pip in ipairs(pips) do
		local filled = i <= wins
		local target = if filled then color else UI.Theme.PanelDark
		if pip.BackgroundColor3 ~= target then
			pip.BackgroundColor3 = target
			local scale = pip:FindFirstChildOfClass("UIScale")
			if scale and filled then
				UI.Pulse(scale, 0.6)
			end
		end
	end
end

local function refreshTopBar()
	if not match or not topBar then
		return
	end
	if isFfa() then
		local scores = match.Scores or {}
		local mine = scores[match.MyId] or 0
		local best, bestId = -1, nil
		for id, value in pairs(scores) do
			if value > best then
				best, bestId = value, id
			end
		end
		setText(leftName, T("match.ffa.me", mine))
		local leader = if bestId then (nameOf(bestId)) else "—"
		setText(rightName, T("match.ffa.leader", leader, math.max(0, best)))
		if leftName then
			leftName.TextColor3 = UI.Theme.Yellow
		end
		if rightName then
			rightName.TextColor3 = WHITE
		end
		local modes = ctx.Config.Modes
		local ffaDef = modes and modes.Modes and modes.Modes.FFA
		local goal = (ffaDef and ffaDef.ScoreToWin) or 25
		rebuildPips(leftPips, 0, 0, WHITE)
		rebuildPips(rightPips, 0, 0, WHITE)
		setText(roundLabel, T("match.ffa.goal", goal))
		return
	end
	local my = match.MyTeam
	local other = if my == 2 then 1 else 2
	local score = match.Score or { 0, 0 }
	setText(leftName, teamName(my))
	setText(rightName, teamName(other))
	if leftName then
		leftName.TextColor3 = teamColor(my)
	end
	if rightName then
		rightName.TextColor3 = teamColor(other)
	end
	local rtw = match.RoundsToWin or 4
	rebuildPips(leftPips, score[my] or 0, rtw, teamColor(my))
	rebuildPips(rightPips, score[other] or 0, rtw, teamColor(other))
end

local function hideTransient()
	for _, frame in ipairs({ voteOverlay, introOverlay, prepBar, afkOverlay, recapPanel }) do
		if frame then
			frame.Visible = false
		end
	end
	if loadingLabel then
		loadingLabel.Visible = false
	end
end

-- ---------------------------------------------------------------------
-- 4) KARTENWAHL
-- ---------------------------------------------------------------------
local function refreshVoteCounts(counts: { number }?)
	for i, labelObj in ipairs(voteCountLabels) do
		local n = if counts then tonumber(counts[i]) or 0 else 0
		setText(labelObj, T("match.vote.count", n))
	end
	for i, button in ipairs(voteButtons) do
		button.SetColor(if i == myVote then UI.Theme.Yellow else UI.Theme.Blue)
	end
end

local function onFound(data: any)
	foundData = data
	myVote = 0
	hideTransient()
	if resultsFrame then
		resultsFrame.Visible = false
	end
	local overlay = voteOverlay
	local cards = voteCards
	if not overlay or not cards then
		return
	end
	for _, child in ipairs(cards:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
	table.clear(voteCountLabels)
	table.clear(voteButtons)
	local sub = modeName(data.Mode)
	local mut = mutatorName(data.Mutator)
	if mut then
		sub ..= " · " .. mut
	end
	setText(voteTitle, T("match.found"))
	sfx("Go")
	local options = if type(data.VoteOptions) == "table" then data.VoteOptions else {}
	if #options == 0 then
		setText(voteTimer, sub)
		overlay.Visible = true
		overlay.Size = UDim2.fromOffset(560, 120)
		task.delay(1.6, function()
			if foundData == data and overlay.Visible then
				overlay.Visible = false
				if loadingLabel and match == nil then
					loadingLabel.Text = T("match.loading")
					loadingLabel.Visible = true
				end
			end
		end)
		return
	end
	overlay.Size = UDim2.fromOffset(760, 380)
	local entries = {}
	for i, opt in ipairs(options) do
		table.insert(entries, {
			Index = i,
			Title = mapName(opt.Map),
			Sub = T("match.mood." .. tostring(opt.Mood)),
		})
	end
	table.insert(entries, { Index = 4, Title = T("match.vote.random"), Sub = "?" })
	for order, entry in ipairs(entries) do
		local card = UI.Card({
			LayoutOrder = order,
			Size = UDim2.fromOffset(166, 240),
			BackgroundColor3 = UI.Theme.PanelLight,
			ZIndex = 32,
			Parent = cards,
		})
		label({
			Position = UDim2.fromOffset(8, 12),
			Size = UDim2.new(1, -16, 0, 26),
			Text = UI.Upper(entry.Sub),
			MaxText = 18,
			Outline = 2,
			TextColor3 = UI.Theme.Yellow,
			ZIndex = 33,
			Parent = card,
		})
		label({
			Position = UDim2.fromOffset(8, 42),
			Size = UDim2.new(1, -16, 0, 60),
			Text = entry.Title,
			MaxText = 26,
			Outline = 3,
			TextWrapped = true,
			ZIndex = 33,
			Parent = card,
		})
		local count = label({
			Position = UDim2.fromOffset(8, 110),
			Size = UDim2.new(1, -16, 0, 30),
			Text = T("match.vote.count", 0),
			MaxText = 20,
			Outline = 2,
			ZIndex = 33,
			Parent = card,
		})
		voteCountLabels[entry.Index] = count
		local button = UI.Button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -12),
			Size = UDim2.new(1, -24, 0, 56),
			Text = T("match.vote.pick"),
			Color = UI.Theme.Blue,
			MaxText = 20,
			ZIndex = 34,
			Parent = card,
		}, function()
			myVote = entry.Index
			refreshVoteCounts(nil)
			request("VoteMap", entry.Index)
		end)
		voteButtons[entry.Index] = button
	end
	setText(voteTimer, sub)
	overlay.Visible = true
	refreshVoteCounts({ 0, 0, 0, 0 })
end

-- ---------------------------------------------------------------------
-- 5) START / INTRO / PREP / LIVE
-- ---------------------------------------------------------------------
local function sendArenaReady(slot: number, buildId: number, matchId: number)
	task.spawn(function()
		if slot ~= 0 then
			local deadline = os.clock() + ARENA_WAIT
			while os.clock() < deadline do
				local arenas = workspace:FindFirstChild("Arenas")
				local folder = arenas and arenas:FindFirstChild("Slot_" .. tostring(slot))
				local map = folder and folder:FindFirstChild("Map")
				if map and tonumber(map:GetAttribute("BuildId")) == buildId then
					break
				end
				task.wait(0.1)
			end
		end
		if match and match.Id == matchId then
			ctx.RequestFull("ArenaReady", buildId, true)
		end
	end)
end

local function onStart(data: any)
	local newMatch = match == nil or match.Id ~= data.MatchId
	if newMatch then
		match = {
			Id = data.MatchId,
			Mode = data.Mode,
			Mutator = data.Mutator,
			MyTeam = tonumber(data.MyTeam) or 1,
			MyId = tonumber(data.MyId) or player.UserId,
			RoundsToWin = tonumber(data.RoundsToWin) or 4,
			Score = { 0, 0 },
			Scores = {},
			Phase = "Load",
			EndsAt = 0,
			Tutorial = data.Tutorial == true,
			Tainted = data.Tainted == true,
		}
		table.clear(roster)
		reportedKiller = false
		for _, row in ipairs(killRows) do
			row.Frame:Destroy()
		end
		table.clear(killRows)
		hideTransient()
		if resultsFrame then
			resultsFrame.Visible = false
		end
		setCoreGui(false)
		if loadingLabel then
			loadingLabel.Text = T("match.loading")
			loadingLabel.Visible = true
		end
		sendArenaReady(tonumber(data.Slot) or 0, tonumber(data.BuildId) or 0, data.MatchId)
	end
	if type(data.Roster) == "table" then
		for _, entry in ipairs(data.Roster) do
			local id = tonumber(entry.Id)
			if id and id ~= 0 then
				roster[id] = {
					Slot = tonumber(entry.Slot) or 0,
					Id = id,
					Name = tostring(entry.Name or "?"),
					Team = tonumber(entry.Team) or 0,
					IsBot = entry.IsBot == true,
					Level = tonumber(entry.Level) or 0,
					Title = tostring(entry.Title or ""),
					Finisher = tostring(entry.Finisher or ""),
				}
			end
		end
	end
	if voteOverlay then
		voteOverlay.Visible = false
	end
	if topBar then
		topBar.Visible = true
	end
	if taintBadge then
		taintBadge.Visible = match.Tainted
	end
	refreshTopBar()
end

local function onIntro(data: any)
	if not match then
		return
	end
	match.Phase = "Intro"
	match.EndsAt = tonumber(data.EndsAt) or serverNow() + 2
	if data.Tainted == true then
		match.Tainted = true
		if taintBadge then
			taintBadge.Visible = true
		end
	end
	if loadingLabel then
		loadingLabel.Visible = false
	end
	local parent = root
	if not parent then
		return
	end
	if introOverlay then
		introOverlay:Destroy()
	end
	local frame = overlayFrame("Intro", parent, Vector2.new(780, 330), 30)
	frame.BackgroundTransparency = 0.05
	introOverlay = frame
	local my = match.MyTeam
	local ffa = isFfa()
	local title = if ffa
		then modeName(match.Mode)
		else ("%s  %s  %s"):format(teamName(my), T("match.intro.vs"), teamName(if my == 2 then 1 else 2))
	label({
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -32, 0, 60),
		Text = title,
		Font = UI.Fonts.Banner,
		MaxText = 52,
		Outline = 4,
		TextColor3 = UI.Theme.Yellow,
		ZIndex = 31,
		Parent = frame,
	})
	local function column(entries: { RosterEntry }, x: number, align: Enum.TextXAlignment, loadouts: { [number]: any })
		local y = 76
		for _, entry in ipairs(entries) do
			if y > 300 then
				break
			end
			local name = if entry.IsBot then T("match.scoreboard.bot") .. " " .. entry.Name else entry.Name
			if not entry.IsBot and entry.Level > 0 then
				name = ("[%d] %s"):format(entry.Level, name)
			end
			local line = name
			local titleStr = titleText(entry.Title)
			if titleStr ~= "" then
				line ..= "  · " .. titleStr
			end
			label({
				Position = UDim2.new(x, 12, 0, y),
				Size = UDim2.new(0.5, -24, 0, 26),
				Text = line,
				MaxText = 20,
				Outline = 2,
				TextXAlignment = align,
				TextColor3 = teamColor(entry.Team),
				ZIndex = 31,
				Parent = frame,
			})
			local extra = ""
			local lo = loadouts[entry.Slot]
			if lo then
				extra = ("%s · %s · %s · %s"):format(
					weaponShort(lo.P),
					weaponShort(lo.S),
					weaponShort(lo.M),
					weaponShort(lo.U)
				)
			elseif entry.Finisher ~= "" then
				extra = T("match.intro.finisher", finisherName(entry.Finisher))
			end
			label({
				Position = UDim2.new(x, 12, 0, y + 26),
				Size = UDim2.new(0.5, -24, 0, 20),
				Text = extra,
				Font = UI.Fonts.Number,
				MaxText = 15,
				Outline = 1,
				TextXAlignment = align,
				TextColor3 = UI.Theme.SubText,
				ZIndex = 31,
				Parent = frame,
			})
			y += 52
		end
	end
	local loadouts: { [number]: any } = {}
	if type(data.Enemies) == "table" then
		for _, enemy in ipairs(data.Enemies) do
			local slot = tonumber(enemy.Slot)
			if slot then
				loadouts[slot] = enemy
			end
		end
	end
	local mine, theirs = {}, {}
	for _, entry in pairs(roster) do
		if entry.Team == my then
			table.insert(mine, entry)
		else
			table.insert(theirs, entry)
		end
	end
	table.sort(mine, function(a, b)
		return a.Slot < b.Slot
	end)
	table.sort(theirs, function(a, b)
		return a.Slot < b.Slot
	end)
	column(mine, 0, Enum.TextXAlignment.Left, {})
	column(theirs, 0.5, Enum.TextXAlignment.Right, loadouts)
	if match.Tainted then
		label({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.fromOffset(320, 26),
			Text = T("match.taintedBadge"),
			MaxText = 18,
			Outline = 2,
			TextColor3 = UI.Theme.Red,
			ZIndex = 31,
			Parent = frame,
		})
	end
	frame.Visible = true
	sfx("Countdown")
end

local function bindPrepControls()
	for _, unbind in ipairs(unbinds) do
		pcall(unbind)
	end
	table.clear(unbinds)
	local controls = module("Controls")
	if not controls or type(controls.Bind) ~= "function" then
		return
	end
	table.insert(
		unbinds,
		controls.Bind("Ready", function(state)
			if state == "Begin" and match and match.Phase == "Prep" and not ready then
				ready = true
				if readyButton then
					readyButton.SetText(T("match.readyDone"))
				end
				request("Ready")
			end
		end, 2)
	)
	table.insert(
		unbinds,
		controls.Bind("Loadout", function(state)
			if state == "Begin" and match and (match.Phase == "Prep" or match.Phase == "RoundEnd") then
				ctx.Windows.Open("Locker")
			end
		end, 2)
	)
end

local function onPrep(data: any)
	if not match then
		return
	end
	match.Phase = "Prep"
	match.EndsAt = tonumber(data.EndsAt) or serverNow() + 3
	match.Round = tonumber(data.Round) or 1
	if type(data.Score) == "table" then
		match.Score = { tonumber(data.Score[1]) or 0, tonumber(data.Score[2]) or 0 }
	end
	if data.Tainted == true and not match.Tainted then
		match.Tainted = true
		if taintBadge then
			taintBadge.Visible = true
		end
	end
	ready = false
	lastCountdown = 0
	if introOverlay then
		introOverlay.Visible = false
	end
	if loadingLabel then
		loadingLabel.Visible = false
	end
	if recapPanel then
		recapPanel.Visible = false
	end
	if zoneBar then
		zoneBar.Frame.Visible = false
	end
	if readyButton then
		readyButton.SetText(T("match.ready"))
	end
	if prepBar then
		prepBar.Visible = true
	end
	setText(roundLabel, T("match.round", match.Round))
	refreshTopBar()
	if data.SuddenDeath == true then
		showBanner(T("match.suddenDeath"), UI.Theme.Red, T("match.suddenDeathSub"), 3)
	elseif data.MatchPoint == true then
		showBanner(T("match.round", match.Round), WHITE, T("match.matchPoint"), 2)
	else
		showBanner(T("match.round", match.Round), WHITE, nil, 1.6)
	end
end

local function onLive(data: any)
	if not match then
		return
	end
	match.Phase = "Live"
	match.EndsAt = tonumber(data.EndsAt) or serverNow() + 60
	if prepBar then
		prepBar.Visible = false
	end
	if introOverlay then
		introOverlay.Visible = false
	end
	if loadingLabel then
		loadingLabel.Visible = false
	end
	local cd = countdownLabel
	if cd then
		cd.Text = T("match.go")
		cd.Visible = true
		if countdownScale then
			countdownScale.Scale = 1.8
			TweenService:Create(countdownScale, BANNER_POP, { Scale = 1 }):Play()
		end
		task.delay(0.8, function()
			if cd.Text == T("match.go") then
				cd.Visible = false
			end
		end)
	end
	sfx("Go")
end

local function onOvertime(data: any)
	if not match then
		return
	end
	match.EndsAt = tonumber(data.EndsAt) or match.EndsAt
	match.Phase = "Overtime"
	if zoneBar then
		zoneBar.Frame.Visible = true
		UI.SetBar(zoneBar, 0, T("match.zone.empty"))
	end
	showBanner(T("match.overtime"), UI.Theme.Yellow, nil, 2.5)
	sfx("Countdown")
end

local function onZone(data: any)
	if not match or not zoneBar then
		return
	end
	zoneBar.Frame.Visible = true
	local team = tonumber(data.Team) or 0
	local progress = tonumber(data.Progress) or 0
	local text
	if data.Contested == true then
		text = T("match.zone.contested")
	elseif team == 0 then
		text = T("match.zone.empty")
	else
		text = T("match.zone.hold", teamName(team))
	end
	zoneBar.Fill.BackgroundColor3 = WHITE
	local gradient = zoneBar.Fill:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = UI.ButtonSequence(if team == 0 then UI.Theme.Gray else teamColor(team))
	end
	UI.SetBar(zoneBar, progress, text)
end

-- ---------------------------------------------------------------------
-- 6) KILLFEED + FINISHER
-- ---------------------------------------------------------------------
local MULTI_KEYS = { [2] = "match.double", [3] = "match.triple", [4] = "match.quad" }

local function coloredName(id: number?): string
	local name, isBot = nameOf(id)
	local text = escape(name)
	if isBot then
		return ('<font color="%s">%s %s</font>'):format(hex(GRAY), escape(T("match.scoreboard.bot")), text)
	end
	local entry = id and roster[id]
	local color = if entry then teamColor(entry.Team) else WHITE
	if match and id == match.MyId then
		color = UI.Theme.Yellow
	end
	return ('<font color="%s">%s</font>'):format(hex(color), text)
end

local function addKillRow(data: any)
	local feed = killfeed
	if not feed then
		return
	end
	local k, v = tonumber(data.K), tonumber(data.V)
	local parts = {}
	local fl = if type(data.Fl) == "table" then data.Fl else {}
	if k then
		local badges = ""
		if fl.Crown then
			badges ..= "👑"
		end
		if tonumber(fl.Streak) then
			badges ..= "🔥" .. tostring(fl.Streak)
		end
		if tonumber(fl.Bounty) then
			badges ..= "🪙"
		end
		if tonumber(fl.Mastery) then
			badges ..= "★" .. tostring(fl.Mastery)
		end
		table.insert(parts, badges .. coloredName(k))
	end
	local weapon = escape(weaponShort(data.W))
	if fl.Void then
		weapon = "↓ " .. weapon
	end
	if data.H == true then
		weapon ..= ' <font color="#ffd23f">★</font>'
	end
	table.insert(parts, ("[%s]"):format(weapon))
	table.insert(parts, coloredName(v))
	if type(data.A) == "table" and #data.A > 0 then
		local assist = tonumber(data.A[1])
		if assist and assist ~= k then
			table.insert(parts, "+ " .. coloredName(assist))
		end
	end
	local multi = tonumber(fl.Multi)
	if multi and MULTI_KEYS[math.min(multi, 4)] then
		table.insert(parts, ('<font color="#ffd23f">%s</font>'):format(escape(T(MULTI_KEYS[math.min(multi, 4)]))))
	end
	local mine = match and (k == match.MyId or v == match.MyId)
	local row = UI.Create("Frame", {
		Name = "Kill",
		Size = UDim2.fromOffset(440, 28),
		BackgroundColor3 = if mine then UI.Theme.Yellow:Lerp(BLACK, 0.55) else BLACK,
		BackgroundTransparency = if mine then 0.25 else 0.55,
		LayoutOrder = -math.floor(os.clock() * 100),
		ZIndex = 22,
		Parent = feed,
	}, { UI.Corner(8) })
	label({
		Position = UDim2.fromOffset(8, 2),
		Size = UDim2.new(1, -16, 1, -4),
		Text = table.concat(parts, "  "),
		RichText = true,
		MaxText = 18,
		Outline = 2,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 23,
		Parent = row,
	})
	table.insert(killRows, { Frame = row, Until = os.clock() + KILLFEED_SECONDS })
	while #killRows > KILLFEED_MAX do
		local old = table.remove(killRows, 1)
		if old then
			old.Frame:Destroy()
		end
	end
end

local function onElim(data: any)
	-- Finisher an der letzten Position (auch für Crown-Zuschauer)
	local fx = module("CombatFX")
	if fx and type(fx.Pop) == "function" and typeof(data.P) == "Vector3" then
		local color = if typeof(data.C) == "Color3" then data.C else UI.Theme.Yellow
		pcall(fx.Pop, data.P, tostring(data.Fin or "F_Confetti"), color)
	end
	if not match then
		return
	end
	addKillRow(data)
end

-- ---------------------------------------------------------------------
-- 7) TODES-RÜCKBLICK
-- ---------------------------------------------------------------------
local function onRecap(data: any)
	local panel = recapPanel
	if not panel or not match then
		return
	end
	for _, child in ipairs(panel:GetChildren()) do
		if not child:IsA("UICorner") and not child:IsA("UIStroke") then
			child:Destroy()
		end
	end
	local killerId = tonumber(data.KillerId)
	local killerEntry = killerId and roster[killerId]
	local isBot = killerEntry ~= nil and killerEntry.IsBot or (killerId ~= nil and killerId < -1000)
	UI.Create("ImageLabel", {
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.fromOffset(64, 64),
		BackgroundColor3 = UI.Theme.PanelLight,
		Image = if killerId
				and killerId > 0
				and not isBot
			then ("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150"):format(killerId)
			else FACE,
		ZIndex = 29,
		Parent = panel,
	}, { UI.Corner(32), UI.Stroke(BLACK, 2) })
	local killerName = tostring(data.KillerName or (nameOf(killerId)))
	label({
		Position = UDim2.fromOffset(82, 10),
		Size = UDim2.new(1, -92, 0, 22),
		Text = T("match.recap.title"),
		MaxText = 14,
		Outline = 2,
		TextColor3 = UI.Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 29,
		Parent = panel,
	})
	label({
		Position = UDim2.fromOffset(82, 30),
		Size = UDim2.new(1, -92, 0, 28),
		Text = if isBot then T("match.scoreboard.bot") .. " " .. killerName else killerName,
		MaxText = 22,
		Outline = 3,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 29,
		Parent = panel,
	})
	local subline = weaponName(data.WeaponKey)
	if killerEntry and titleText(killerEntry.Title) ~= "" then
		subline = titleText(killerEntry.Title) .. " · " .. subline
	end
	label({
		Position = UDim2.fromOffset(82, 58),
		Size = UDim2.new(1, -92, 0, 18),
		Text = subline,
		MaxText = 14,
		Outline = 1,
		TextColor3 = UI.Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 29,
		Parent = panel,
	})
	label({
		Position = UDim2.fromOffset(10, 82),
		Size = UDim2.new(1, -20, 0, 30),
		Text = T("combat.hpLeft", math.max(0, math.floor((tonumber(data.KillerHp) or 0) + 0.5))),
		Font = UI.Fonts.Banner,
		MaxText = 26,
		Outline = 3,
		TextColor3 = UI.Theme.Red,
		ZIndex = 29,
		Parent = panel,
	})
	local list = UI.Create("Frame", {
		Position = UDim2.fromOffset(10, 116),
		Size = UDim2.new(1, -20, 0, 200),
		BackgroundTransparency = 1,
		ZIndex = 29,
		Parent = panel,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }) })
	local taken = if type(data.Taken) == "table" then data.Taken else {}
	local shown = 0
	for i = #taken, 1, -1 do
		local hit = taken[i]
		if shown >= 12 or type(hit) ~= "table" then
			break
		end
		shown += 1
		local text = ("%s  −%d  %s  %dm"):format(
			weaponShort(hit.W),
			math.floor((tonumber(hit.D) or 0) + 0.5),
			if hit.H == true then T("match.recap.head") else "",
			math.floor((tonumber(hit.Dist) or 0) + 0.5)
		)
		label({
			LayoutOrder = shown,
			Size = UDim2.new(1, 0, 0, 15),
			Text = text,
			Font = UI.Fonts.Number,
			MaxText = 13,
			Outline = 1,
			TextColor3 = if hit.H == true then UI.Theme.Yellow else WHITE,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 29,
			Parent = list,
		})
	end
	label({
		Position = UDim2.fromOffset(10, 322),
		Size = UDim2.new(1, -20, 0, 40),
		Text = T(
			"combat.dealt",
			math.floor((tonumber(data.DealtToKiller) or 0) + 0.5),
			tonumber(data.DealtHits) or 0,
			tonumber(data.DealtHeads) or 0
		),
		MaxText = 15,
		Outline = 2,
		TextWrapped = true,
		ZIndex = 29,
		Parent = panel,
	})
	if killerId and killerId > 0 and not isBot and not reportedKiller then
		local reportButton: any = nil
		reportButton = UI.Button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.fromOffset(160, 40),
			Text = T("match.recap.report"),
			Color = UI.Theme.Red,
			MaxText = 18,
			ZIndex = 30,
			Parent = panel,
		}, function()
			if reportedKiller then
				return
			end
			reportedKiller = true
			reportButton.SetText(T("match.recap.reported"))
			request("Report", { UserId = killerId, Reason = "Other" })
		end)
	end
	panel.Visible = true
end

-- ---------------------------------------------------------------------
-- 8) RUNDEN-ENDE
-- ---------------------------------------------------------------------
local BANNER_KEYS = {
	Clutch = "match.clutch",
	Ace = "match.ace",
	Flawless = "match.flawless",
	Comeback = "match.comeback",
	MatchPoint = "match.matchPoint",
	SuddenDeath = "match.suddenDeath",
}

local function onRoundEnd(data: any)
	if not match then
		return
	end
	match.Phase = "RoundEnd"
	if type(data.Score) == "table" then
		match.Score = { tonumber(data.Score[1]) or 0, tonumber(data.Score[2]) or 0 }
	end
	if zoneBar then
		zoneBar.Frame.Visible = false
	end
	refreshTopBar()
	local winner = tonumber(data.Winner) or 0
	local title, color
	if winner == 0 then
		title, color = T("match.roundDraw"), WHITE
	elseif winner == match.MyTeam then
		title, color = T("match.roundWon"), teamColor(winner)
		sfx("Win")
	else
		title, color = T("match.roundLost"), teamColor(winner)
		sfx("Lose")
	end
	local subs = {}
	if type(data.Reason) == "string" then
		table.insert(subs, T("match.reason." .. data.Reason))
	end
	local flags: { [string]: boolean } = {}
	if type(data.Banners) == "table" then
		for _, key in ipairs(data.Banners) do
			flags[key] = true
			if BANNER_KEYS[key] then
				table.insert(subs, T(BANNER_KEYS[key]))
			end
		end
	end
	-- Skill-Momente: CLUTCH-/ACE-Bonus für mich
	local clutch = data.Clutch
	if type(clutch) == "table" and tonumber(clutch.Id) == match.MyId then
		local xp = tonumber(clutch.Xp) or 0
		showNotice(
			T("match.clutchYou", tonumber(clutch.Vs) or 2) .. (if xp > 0 then "  " .. T("match.bonusXp", xp) else ""),
			3
		)
		confetti(1.5)
	elseif type(clutch) == "table" then
		local name = nameOf(tonumber(clutch.Id))
		showNotice(T("match.clutchBy", name, tonumber(clutch.Vs) or 2), 3)
	end
	local ace = data.Ace
	if type(ace) == "table" and tonumber(ace.Id) == match.MyId then
		local xp = tonumber(ace.Xp) or 0
		showNotice(T("match.aceYou") .. (if xp > 0 then "  " .. T("match.bonusXp", xp) else ""), 3)
		confetti(1.2)
	end
	if flags.Flawless and winner == match.MyTeam then
		confetti(0.8)
	end
	local mvp = tonumber(data.Mvp)
	if mvp then
		table.insert(subs, T("match.mvp", (nameOf(mvp))))
	end
	showBanner(title, color, table.concat(subs, "  ·  "), 2.4)
end

local function onScore(data: any)
	if not match or type(data.Scores) ~= "table" then
		return
	end
	local scores = {}
	for key, value in pairs(data.Scores) do
		local id = tonumber(key)
		if id then
			scores[id] = tonumber(value) or 0
		end
	end
	match.Scores = scores
	if tonumber(data.EndsAt) then
		match.EndsAt = tonumber(data.EndsAt)
	end
	refreshTopBar()
end

-- ---------------------------------------------------------------------
-- 9) ERGEBNIS
-- ---------------------------------------------------------------------
local function seasonInfo(): any
	local state = ctx.State and ctx.State.Season
	if type(state) == "table" and tonumber(state.TierXp) then
		return state
	end
	local seasons = ctx.Config.Season and ctx.Config.Season.Seasons
	return if type(seasons) == "table" then seasons[1] else nil
end

local function describeReward(reward: any): string
	if type(reward) ~= "table" then
		return ""
	end
	if ProgressMath and type(ProgressMath.DescribeReward) == "function" then
		local ok, text = pcall(ProgressMath.DescribeReward, reward, ctx.T)
		if ok and type(text) == "string" then
			return text
		end
	end
	local parts = {}
	for key, value in pairs(reward) do
		table.insert(parts, ("%s %s"):format(tostring(value), tostring(key)))
	end
	return table.concat(parts, " + ")
end

local function nextRewards(season: any, tier: number): (string, string)
	if type(season) ~= "table" then
		return "", ""
	end
	local free, prem = "", ""
	local maxTier = tonumber(season.Tiers) or 30
	for t = tier + 1, maxTier do
		local key = tostring(t)
		if free == "" and type(season.Free) == "table" and season.Free[key] then
			free = describeReward(season.Free[key])
		end
		if prem == "" and type(season.Premium) == "table" and season.Premium[key] then
			prem = describeReward(season.Premium[key])
		end
		if free ~= "" and prem ~= "" then
			break
		end
	end
	return free, prem
end

local function coinsHint(): string?
	local coins = tonumber(ctx.State and ctx.State.Coins) or 0
	local weapons = ctx.State and ctx.State.Weapons
	local owned = if type(weapons) == "table" and type(weapons.Owned) == "table" then weapons.Owned else {}
	local list = ctx.Config.Weapons and ctx.Config.Weapons.List
	if type(list) ~= "table" then
		return nil
	end
	local best: any = nil
	for _, base in ipairs(list) do
		local def = ctx.Config.Weapon(base.Key) or base
		if
			def.Enabled ~= false
			and not def.AdminOnly
			and not def.Free
			and not owned[def.Key]
			and (tonumber(def.Price) or 0) > coins
		then
			if best == nil or def.Price < best.Price then
				best = def
			end
		end
	end
	if best then
		return T("match.result.toWeapon", best.Price - coins, pick(best.Name))
	end
	return nil
end

local function resultsBar(parent: Frame, y: number, title: string, color: Color3): any
	label({
		Position = UDim2.fromOffset(20, y),
		Size = UDim2.fromOffset(160, 26),
		Text = title,
		MaxText = 18,
		Outline = 2,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 52,
		Parent = parent,
	})
	local bar = UI.Bar({
		Position = UDim2.fromOffset(184, y),
		Size = UDim2.new(1, -204, 0, 26),
		Color = color,
		MaxText = 15,
		Parent = parent,
	})
	bar.Frame.ZIndex = 52
	bar.Fill.ZIndex = 53
	bar.Text.ZIndex = 54
	return bar
end

local function onEnd(data: any)
	if not match then
		return
	end
	match.Phase = "MatchEnd"
	hideTransient()
	if zoneBar then
		zoneBar.Frame.Visible = false
	end
	local frame = resultsFrame
	if not frame then
		return
	end
	for _, child in ipairs(frame:GetChildren()) do
		if not child:IsA("UICorner") and not child:IsA("UIStroke") and not child:IsA("UIGradient") then
			child:Destroy()
		end
	end
	local me = if type(data.Me) == "table" then data.Me else {}
	local stats = if type(me.Stats) == "table" then me.Stats else {}
	local winner = tonumber(data.Winner) or 0
	local draw = data.Draw == true
	local won = not draw and winner == match.MyTeam
	local titleText_, color
	if draw then
		titleText_, color = T("match.result.draw"), WHITE
	elseif won then
		titleText_, color = T("match.result.win"), UI.Theme.Yellow
	elseif isFfa() then
		local mine = match.Scores[match.MyId] or 0
		local place = 1
		for id, value in pairs(match.Scores) do
			if id ~= match.MyId and value > mine then
				place += 1
			end
		end
		titleText_, color = T("match.result.place", place), WHITE
	else
		titleText_, color = T("match.result.loss"), UI.Theme.Red
	end
	if won then
		sfx("Win")
		confetti(2)
	elseif not draw then
		sfx("Lose")
	end
	label({
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -32, 0, 64),
		Text = titleText_,
		Font = UI.Fonts.Banner,
		MaxText = 56,
		Outline = 5,
		TextColor3 = color,
		ZIndex = 51,
		Parent = frame,
	})
	if data.Tainted == true then
		label({
			Position = UDim2.fromOffset(16, 70),
			Size = UDim2.new(1, -32, 0, 20),
			Text = T("match.taintedBadge"),
			MaxText = 15,
			Outline = 2,
			TextColor3 = UI.Theme.Red,
			ZIndex = 51,
			Parent = frame,
		})
	end
	-- MVP + Werte
	local acc = math.floor((tonumber(stats.Acc) or 0) * 100 + 0.5)
	local statLine = ("%s  %d/%d/%d   ·   %s  %d   ·   %s  %d%%"):format(
		T("match.result.kda"),
		tonumber(stats.K) or 0,
		tonumber(stats.D) or 0,
		tonumber(stats.A) or 0,
		T("match.result.damage"),
		tonumber(stats.Dmg) or 0,
		T("match.result.accuracy"),
		acc
	)
	if me.Mvp == true then
		statLine = "⭐ " .. T("match.result.mvp") .. "   ·   " .. statLine
	end
	label({
		Position = UDim2.fromOffset(16, 94),
		Size = UDim2.new(1, -32, 0, 28),
		Text = statLine,
		MaxText = 18,
		Outline = 2,
		ZIndex = 51,
		Parent = frame,
	})
	-- Balken: XP -> Coins -> Meisterschaft -> Pass (nacheinander)
	local xpBar = resultsBar(frame, 132, T("match.result.xp"), UI.Theme.Cyan)
	local coinBar = resultsBar(frame, 166, T("match.result.coins"), UI.Theme.Gold)
	local masteryBar = resultsBar(frame, 200, T("match.result.mastery", weaponShort(me.MasteryWeapon)), UI.Theme.Purple)
	local passBar = resultsBar(frame, 234, T("match.result.pass"), UI.Theme.Pink)
	local xpNext = tonumber(me.XpNext) or 0
	local xpIn = tonumber(me.XpInLevel) or 0
	local level = tonumber(me.Level) or 1
	local season = seasonInfo()
	local tierXp = if season then tonumber(season.TierXp) or 3000 else 3000
	local passAfter = tonumber(me.PassXpAfter) or 0
	local passBefore = tonumber(me.PassXpBefore) or passAfter
	local tier = math.floor(passAfter / tierXp)
	local masteryAfter = tonumber(me.MasteryAfter) or 0
	local masteryBefore = tonumber(me.MasteryBefore) or masteryAfter
	local masteryRatio, masteryText = 0, ("+%d"):format(math.max(0, masteryAfter - masteryBefore))
	if ProgressMath and type(ProgressMath.MasteryTier) == "function" then
		local okT, tierNow = pcall(ProgressMath.MasteryTier, masteryAfter)
		local okG, goal = pcall(ProgressMath.MasteryGoal, if okT then tierNow else 0)
		if okT and okG and type(goal) == "number" and goal > 0 then
			masteryRatio = math.clamp(masteryAfter / goal, 0, 1)
			masteryText = ("%s %d · %d/%d"):format(T("match.result.tier"), tierNow, masteryAfter, goal)
		elseif okT then
			masteryRatio = 1
			masteryText = ("%s %d"):format(T("match.result.tier"), tierNow)
		end
	end
	local steps = {
		function()
			UI.SetBar(
				xpBar,
				if xpNext > 0 then xpIn / xpNext else 1,
				("+%d XP  ·  Lv %d"):format(tonumber(me.XpGain) or 0, level)
			)
		end,
		function()
			UI.SetBar(coinBar, 1, ("+%d"):format(tonumber(me.Coins) or 0))
			local hud = module("Hud")
			if hud and type(hud.PulseCoins) == "function" and (tonumber(me.Coins) or 0) > 0 then
				pcall(hud.PulseCoins, tonumber(me.Coins))
			end
		end,
		function()
			UI.SetBar(masteryBar, masteryRatio, masteryText)
		end,
		function()
			UI.SetBar(
				passBar,
				(passAfter % tierXp) / tierXp,
				("%s %d  ·  +%d"):format(T("match.result.tier"), tier, math.max(0, passAfter - passBefore))
			)
		end,
	}
	for i, fn in ipairs(steps) do
		task.delay(0.35 + (i - 1) * 0.55, function()
			if match and match.Phase == "MatchEnd" then
				fn()
			end
		end)
	end
	-- nächste Pass-Belohnungen (Premium mit Schloss, B23.5)
	local free, prem = nextRewards(season, tier)
	local passState = ctx.State and ctx.State.Pass
	local premium = type(passState) == "table" and passState.Premium == true
	local passLine = ""
	if free ~= "" then
		passLine = T("match.result.free", free)
	end
	if prem ~= "" then
		passLine ..= (if passLine ~= "" then "   ·   " else "") .. T("match.result.premium", prem) .. (if premium
			then ""
			else " 🔒")
	end
	label({
		Position = UDim2.fromOffset(20, 262),
		Size = UDim2.new(1, -40, 0, 20),
		Text = passLine,
		MaxText = 14,
		Outline = 1,
		TextColor3 = UI.Theme.SubText,
		ZIndex = 51,
		Parent = frame,
	})
	-- Quest-Häkchen
	local questLines = {}
	if type(me.QuestTicks) == "table" then
		for i, q in ipairs(me.QuestTicks) do
			if i > 3 then
				break
			end
			local goal = tonumber(q.Goal) or 1
			local p = tonumber(q.P) or 0
			local mark = if p >= goal then "✅" else "▶"
			table.insert(
				questLines,
				("%s %s  %d/%d"):format(mark, T("prog.q." .. tostring(q.Id), goal), math.min(p, goal), goal)
			)
		end
	end
	label({
		Position = UDim2.fromOffset(20, 286),
		Size = UDim2.new(1, -40, 0, 60),
		Text = table.concat(questLines, "\n"),
		MaxText = 15,
		Outline = 1,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 51,
		Parent = frame,
	})
	-- Hinweise "Nur noch 40 XP bis Level 12!" / "120 Coins bis Fernschuss"
	local hints = {}
	if xpNext > 0 then
		table.insert(hints, T("match.result.toLevel", math.max(0, xpNext - xpIn), level + 1))
	end
	local coinText = coinsHint()
	if coinText then
		table.insert(hints, coinText)
	end
	label({
		Position = UDim2.fromOffset(20, 348),
		Size = UDim2.new(1, -40, 0, 24),
		Text = table.concat(hints, "   ·   "),
		MaxText = 16,
		Outline = 2,
		TextColor3 = UI.Theme.Yellow,
		ZIndex = 51,
		Parent = frame,
	})
	-- Knöpfe
	local row = UI.Create("Frame", {
		Position = UDim2.fromOffset(16, 382),
		Size = UDim2.new(1, -32, 0, 60),
		BackgroundTransparency = 1,
		ZIndex = 51,
		Parent = frame,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local mode = match.Mode
	local ggButton: any = nil
	ggButton = UI.Button({
		LayoutOrder = 1,
		Size = UDim2.fromOffset(100, 54),
		Text = T("match.result.gg"),
		Color = UI.Theme.Green,
		MaxText = 22,
		ZIndex = 52,
		Parent = row,
	}, function()
		ggButton.SetText("GG ✓")
		request("PressGG")
	end)
	UI.Button({
		LayoutOrder = 2,
		Size = UDim2.fromOffset(110, 54),
		Text = T("match.result.commend"),
		Color = UI.Theme.Cyan,
		MaxText = 20,
		ZIndex = 52,
		Parent = row,
	}, function()
		local board = module("Scoreboard")
		if board and type(board.Show) == "function" then
			pcall(board.Show, true)
		end
	end)
	rematchButton = nil
	if data.Rematch ~= false then
		rematchButton = UI.Button({
			LayoutOrder = 3,
			Size = UDim2.fromOffset(150, 54),
			Text = T("match.result.rematch", 0, 1),
			Color = UI.Theme.Orange,
			MaxText = 20,
			ZIndex = 52,
			Parent = row,
		}, function()
			request("Rematch")
		end)
	end
	if mode ~= "Crown" and mode ~= "Practice" then
		UI.Button({
			LayoutOrder = 4,
			Size = UDim2.fromOffset(150, 54),
			Text = T("match.result.again"),
			Color = UI.Theme.Yellow,
			MaxText = 18,
			ZIndex = 52,
			Parent = row,
		}, function()
			ctx.Request("LeaveMatch")
			local controls = module("Controls")
			local input = if controls and type(controls.Input) == "function" then controls.Input() else "KBM"
			ctx.Request("QueueJoin", { Mode = mode, Input = input })
		end)
	end
	UI.Button({
		LayoutOrder = 5,
		Size = UDim2.fromOffset(110, 54),
		Text = T("match.result.lobby"),
		Color = UI.Theme.Red,
		MaxText = 20,
		ZIndex = 52,
		Parent = row,
	}, function()
		request("LeaveMatch")
	end)
	-- Auto-Requeue-Haken
	local settings = ctx.State and ctx.State.Settings
	if type(settings) == "table" and type(settings.AutoRequeue) == "boolean" and not autoTouched then
		autoRequeue = settings.AutoRequeue
	end
	local autoButton: any = nil
	local function autoText(): string
		return T("match.result.autoRequeue") .. ": " .. T(if autoRequeue then "match.on" else "match.off")
	end
	if mode ~= "Crown" and mode ~= "Practice" then
		autoButton = UI.Button({
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 16, 1, -12),
			Size = UDim2.fromOffset(300, 40),
			Text = autoText(),
			Color = if autoRequeue then UI.Theme.Green else UI.Theme.Gray,
			MaxText = 16,
			ZIndex = 52,
			Parent = frame,
		}, function()
			autoRequeue = not autoRequeue
			autoTouched = true
			autoButton.SetText(autoText())
			autoButton.SetColor(if autoRequeue then UI.Theme.Green else UI.Theme.Gray)
			request("AutoRequeue", autoRequeue)
		end)
	end
	resultsTimer = label({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(300, 30),
		Text = "",
		MaxText = 16,
		Outline = 2,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 52,
		Parent = frame,
	})
	local matchCfg = ctx.Config.Modes and ctx.Config.Modes.Match or {}
	resultsUntil = os.clock() + (if mode == "Crown" then matchCfg.CrownResults or 4 else matchCfg.Results or 10)
	frame.Visible = true
	-- Starter-Karte NUR wenn der Server ein Angebot mitschickt (B23)
	if type(data.Offer) == "string" and data.Offer ~= "" then
		local shop = module("Shop")
		if shop and type(shop.BuildStarterCard) == "function" then
			local ok, card = pcall(shop.BuildStarterCard, frame)
			if ok and typeof(card) == "Instance" and card:IsA("GuiObject") then
				card.AnchorPoint = Vector2.new(0.5, 0.5)
				card.Position = UDim2.fromScale(0.5, 0.5)
				card.ZIndex = 60
				for _, d in ipairs(card:GetDescendants()) do
					if d:IsA("GuiObject") then
						d.ZIndex = math.max(d.ZIndex, 60) + 1
					end
				end
				UI.Button({
					AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.new(0.5, 0, 1, 8),
					Size = UDim2.fromOffset(220, 48),
					Text = T("match.result.later"),
					Color = UI.Theme.Gray,
					MaxText = 22,
					ZIndex = 62,
					Parent = card,
				}, function()
					card:Destroy()
				end)
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- 10) TAKT + ABSCHLUSS
-- ---------------------------------------------------------------------
local function onClosed()
	match = nil
	foundData = nil
	table.clear(roster)
	hideTransient()
	for _, frame in ipairs({ topBar, resultsFrame }) do
		if frame then
			frame.Visible = false
		end
	end
	for _, labelObj in ipairs({ bannerLabel, subBanner, countdownLabel, noticeLabel, taintBadge }) do
		if labelObj then
			labelObj.Visible = false
		end
	end
	for _, row in ipairs(killRows) do
		row.Frame:Destroy()
	end
	table.clear(killRows)
	setCoreGui(true)
end

local accum = 0
local function step(dt: number)
	accum += dt
	if accum < REFRESH then
		return
	end
	accum = 0
	local clock = os.clock()
	if bannerLabel and bannerLabel.Visible and clock >= bannerUntil then
		bannerLabel.Visible = false
		if subBanner then
			subBanner.Visible = false
		end
	end
	if noticeLabel and noticeLabel.Visible and clock >= noticeUntil then
		noticeLabel.Visible = false
	end
	for i = #killRows, 1, -1 do
		if clock >= killRows[i].Until then
			killRows[i].Frame:Destroy()
			table.remove(killRows, i)
		end
	end
	-- Kartenwahl-Countdown
	if voteOverlay and voteOverlay.Visible and foundData and tonumber(foundData.VoteEnds) then
		local left = math.max(0, math.ceil(foundData.VoteEnds - serverNow()))
		local sub = modeName(foundData.Mode)
		local mut = mutatorName(foundData.Mutator)
		if mut then
			sub ..= " · " .. mut
		end
		setText(voteTimer, ("%s  ·  %s"):format(sub, T("match.vote.timer", left)))
	end
	if not match then
		return
	end
	local now = serverNow()
	local left = math.max(0, (match.EndsAt or 0) - now)
	if match.Phase == "Live" or match.Phase == "Overtime" or match.Phase == "Prep" or match.Phase == "Intro" then
		setText(timerLabel, formatTime(left))
		if timerLabel then
			timerLabel.TextColor3 = if match.Phase == "Overtime" or (match.Phase == "Live" and left <= 10)
				then UI.Theme.Red
				else WHITE
		end
	end
	-- 3-2-1 in den letzten Prep-Sekunden
	local cd = countdownLabel
	if match.Phase == "Prep" and cd then
		local n = math.ceil(left)
		if n >= 1 and n <= 3 then
			if n ~= lastCountdown then
				lastCountdown = n
				cd.Text = tostring(n)
				cd.Visible = true
				if countdownScale then
					countdownScale.Scale = 1.6
					TweenService:Create(countdownScale, BANNER_POP, { Scale = 1 }):Play()
				end
				sfx("Countdown")
			end
		elseif cd.Visible and cd.Text ~= T("match.go") then
			cd.Visible = false
		end
	end
	if match.Phase == "MatchEnd" and resultsTimer then
		setText(resultsTimer, T("match.result.backIn", math.max(0, math.ceil(resultsUntil - clock))))
	end
end

function MatchUI.InMatch(): boolean
	return match ~= nil
end

function MatchUI.Init(context: any)
	ctx = context
	local progressModule = ReplicatedStorage:WaitForChild("Shared"):FindFirstChild("ProgressMath")
	if progressModule and progressModule:IsA("ModuleScript") then
		local ok, result = pcall(require, progressModule)
		if ok and type(result) == "table" then
			ProgressMath = result
		end
	end
	local frame = UI.Create("Frame", {
		Name = "MatchUI",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = ctx.Gui,
	})
	root = frame
	buildTopBar(frame)
	buildBanners(frame)
	buildKillfeed(frame)
	buildPrep(frame)
	buildAfk(frame)
	buildVote(frame)
	buildRecap(frame)
	buildResults(frame)
end

function MatchUI.Start()
	local hooks = ctx.Hooks
	hooks.On("Match:Found", onFound)
	hooks.On("Match:Vote", function(data)
		if type(data) == "table" then
			refreshVoteCounts(data.Counts)
		end
	end)
	hooks.On("Match:Start", onStart)
	hooks.On("Match:Intro", onIntro)
	hooks.On("Match:Prep", onPrep)
	hooks.On("Match:Live", onLive)
	hooks.On("Match:Overtime", onOvertime)
	hooks.On("Match:Zone", onZone)
	hooks.On("Match:AntiCamp", function()
		if match then
			showNotice(T("match.antiCamp"), 1.5)
		end
	end)
	hooks.On("Match:Elim", onElim)
	hooks.On("Match:Recap", onRecap)
	hooks.On("Match:RoundEnd", onRoundEnd)
	hooks.On("Match:Score", onScore)
	hooks.On("Match:End", onEnd)
	hooks.On("Match:Rematch", function(data)
		if rematchButton and type(data) == "table" then
			rematchButton.SetText(T("match.result.rematch", tonumber(data.Votes) or 0, tonumber(data.Needed) or 1))
		end
	end)
	hooks.On("Match:Afk", function(data)
		if afkOverlay and type(data) == "table" then
			afkOverlay.Visible = data.Warn == true
			if data.Warn == true then
				sfx("UIError")
			end
		end
	end)
	hooks.On("Match:Closed", onClosed)
	hooks.On("LocalRevived", function()
		if recapPanel then
			recapPanel.Visible = false
		end
	end)
	bindPrepControls()
	RunService.Heartbeat:Connect(step)
end

return MatchUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="126">
            <Properties>
              <string name="Name">Movement</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Bewegung: Sprint, Rutschen, Rutsch-Sprung, Doppelsprung, Schwerkraft-Lift, Impulse
--  (Client/Modules/Movement)
--  Besitzer: WP4 (Kampf Client). Vertrag: DESIGN.md B12, C7.4, C12.3 (Budget), SKILL-WUENSCHE (Slide-Hop).
--  Bewegung läuft auf dem Client (eigene Physik, Netzwerk-Besitzer). Werte aus Config.Player.
--    Gehen    = BaseSpeed (Server-Attribut) × MoveMult der Waffe (× AdsMoveMult beim Zielen, × Block 0.65)
--    Sprinten = BaseSpeed × Sprint/Walk × MoveMult; kein Schießen (WeaponClient ruft StopSprint, 0.12 s Sperre)
--    Rutschen = aus Sprint (Tempo ≥ 18) + Rutsch-Taste: 32 -> exponentiell 14 in 0.75 s, Kamera −1.6, FOV +6,
--               Cooldown 1.0 s. KEINE Hitbox-Änderung. Lokaler Staub-Trail.
--    Rutsch-Sprung: Sprung im Rutschen behält 90 % horizontal (max. 30).
--    Slide-Hop: Landen mit gehaltener/kurz zuvor gedrückter Rutsch-Taste kettet ein neues Rutschen mit dem
--               mitgebrachten Tempo (ohne Cooldown, ohne Auffüllen – Obergrenze JumpCap, klingt ab).
--    Luftsteuerung: Schwung bleibt in der Luft, Richtung begrenzt lenkbar (Air-Strafe).
--    Doppelsprung: nur mit Melee.AirJump (BoxingGloves): 1 Luftsprung Höhe 6, Richtung neu wählbar.
--    GravityLift: VectorForce hebt den Anteil frac der Schwerkraft auf (Mutatoren, z. B. MoonJump).
--  Budget des Anti-Cheats (C12.3): 32 × SpeedMult × 1.15 + 6 – Rutschen (32) und Slide-Hop (≤ 30) bleiben darunter.
--
--  Öffentliche API (C7.4):
--    Movement.ApplyImpulse(v: Vector3)     Rückstoß/Raketensprung (auch aus Combat("Impulse"))
--    Movement.SetGravityLift(frac: number) 0..0.95
--    Movement.IsSliding(): boolean
--  Zusätzlich: Movement.IsSprinting(), Movement.StopSprint(), Movement.IsAirborne(), Movement.Speed()
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Movement = {}

local player = Players.LocalPlayer
local ctx: any = nil

type Carry = { Dir: Vector3, Speed: number }

-- ---------------------------------------------------------------------
-- 1) KONSTANTEN (Startwerte = Config.Player, zur Laufzeit von dort gelesen)
-- ---------------------------------------------------------------------
local DEFAULT_PLAYER = {
	Walk = 16,
	Sprint = 22,
	JumpHeight = 7.2,
	AirJumpHeight = 6,
	SprintToFire = 0.12,
	Slide = {
		MinSpeed = 18,
		Start = 32,
		End = 14,
		Time = 0.75,
		Cooldown = 1.0,
		JumpKeep = 0.9,
		JumpCap = 30,
		CamDrop = 1.6,
		FovKick = 6,
		SpreadAdd = 1,
	},
}
local SLIDE_DECAY = math.log(20) -- nach Time s sind 95 % des Überschusses weg
local SLIDE_BUFFER = 0.15 -- Rutsch-Taste so lange vorher gedrückt zählt noch
local HOP_WINDOW = 0.2 -- Slide-Hop: Taste bis zu 0.2 s vor der Landung
local GROUND_CARRY = 0.12 -- so lange bleibt der Schwung nach der Landung (Zeit für den Hop)
local COYOTE = 0.12 -- Rutsch-Sprung kurz nach Rutsch-Ende
local SLIDE_TURN = math.rad(70) -- rad/s Lenken im Rutschen
local AIR_TURN = math.rad(150) -- rad/s Luftsteuerung
local AIR_DRAG = 0.18 -- 1/s Abbau des Schwungs in der Luft
local AIR_JUMP_DELAY = 0.1 -- Luftsprung frühestens 0.1 s nach dem Abheben
local IMPULSE_MAX = 95
local DUST_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"

-- ---------------------------------------------------------------------
-- 2) ZUSTAND
-- ---------------------------------------------------------------------
local armed = false
local haveArmed = false -- Combat("Armed") erhalten
local rules: { [string]: any } = {}
local character: Model? = nil
local humanoid: Humanoid? = nil
local root: BasePart? = nil
local liftForce: VectorForce? = nil
local dust: ParticleEmitter? = nil

local gravityLift = 0
local sprintHeld = false
local sprintToggled = false
local sprinting = false
local sprintSuppressUntil = 0
local slideHeld = false
local slideQueuedAt = -10
local sliding = false
local slideStart = -10
local slideS0 = 32
local slideDir = Vector3.new(0, 0, -1)
local slideSpeed = 0
local lastSlideStart = -10
local slideEndAt = -10
local slideSpeedAtEnd = 0
local carry: Carry? = nil
local airJumpsUsed = 0
local wasGrounded = true
local leftGroundAt = -10
local landedAt = -10
local lastJumpReq = -10
local camDropAlpha = 0
local appliedWalk: number? = nil
local appliedJump: number? = nil
local restored = true

-- ---------------------------------------------------------------------
-- 3) HELFER
-- ---------------------------------------------------------------------
local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function modules(): { [string]: any }
	return if ctx and type(ctx.Modules) == "table" then ctx.Modules else {}
end

local function call(moduleName: string, fnName: string, ...: any): any
	local mod = modules()[moduleName]
	if mod and type(mod[fnName]) == "function" then
		local ok, result = pcall(mod[fnName], ...)
		if ok then
			return result
		end
	end
	return nil
end

local function cfgPlayer(): any
	local p = ctx and ctx.Config and ctx.Config.Player
	return if type(p) == "table" then p else DEFAULT_PLAYER
end

local function cfgNum(tbl: any, key: string, default: number): number
	local value = if type(tbl) == "table" then tbl[key] else nil
	return if finite(value) then value else default
end

local function slideCfg(key: string): number
	local p = cfgPlayer()
	return cfgNum(p.Slide, key, (DEFAULT_PLAYER.Slide :: any)[key])
end

local function setting(key: string): any
	local mod = modules().Settings
	if mod and type(mod.Get) == "function" then
		local ok, s = pcall(mod.Get)
		if ok and type(s) == "table" then
			return s[key]
		end
	end
	return nil
end

local function horizontal(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatLook(): Vector3
	local camera = workspace.CurrentCamera
	local look = if camera then horizontal(camera.CFrame.LookVector) else Vector3.new(0, 0, -1)
	return if look.Magnitude > 1e-3 then look.Unit else Vector3.new(0, 0, -1)
end

-- Richtung a mit höchstens maxAngle (rad) zu b drehen (beide horizontal, Einheitsvektoren)
local function turnToward(a: Vector3, b: Vector3, maxAngle: number): Vector3
	local dot = math.clamp(a:Dot(b), -1, 1)
	local angle = math.acos(dot)
	if angle <= maxAngle or angle < 1e-4 then
		return b
	end
	local t = maxAngle / angle
	local mixed = a:Lerp(b, t)
	if mixed.Magnitude < 1e-3 then
		return a
	end
	return mixed.Unit
end

local function currentDef(): any
	local wc = modules().WeaponClient
	if wc and type(wc.Current) == "function" then
		local ok, _key, d = pcall(wc.Current)
		if ok and type(d) == "table" then
			return d
		end
	end
	return nil
end

local function adsAlpha(): number
	local value = call("WeaponClient", "AdsAlpha")
	return if finite(value) then math.clamp(value, 0, 1) else 0
end

local function isFlying(h: Humanoid): boolean
	return h.PlatformStand or h.Sit or player:GetAttribute("Flying") == true
end

-- BaseSpeed setzt der Server als Attribut (CharacterService.SetBaseSpeed); Admin-Kraft AdminSpeed zählt
local function baseSpeed(): number
	if player:GetAttribute("IsAdmin") == true then
		local admin = player:GetAttribute("AdminSpeed")
		if finite(admin) then
			return math.clamp(admin, 1, 150)
		end
	end
	local value = character and character:GetAttribute("BaseSpeed")
	if not finite(value) then
		value = player:GetAttribute("BaseSpeed")
	end
	if finite(value) then
		return math.clamp(value :: number, 1, 150)
	end
	local walk = cfgNum(cfgPlayer(), "Walk", 16)
	local mult = if finite(rules.SpeedMult) then rules.SpeedMult else 1
	return walk * mult
end

local function jumpHeight(): number
	if player:GetAttribute("IsAdmin") == true then
		local admin = player:GetAttribute("AdminJump")
		if finite(admin) then
			return math.clamp(admin, 0, 100)
		end
	end
	return cfgNum(cfgPlayer(), "JumpHeight", 7.2)
end

local function airJumpsAllowed(): number
	local d = currentDef()
	if d and type(d.Melee) == "table" and d.Melee.AirJump == true then
		return 1
	end
	if finite(rules.AirJumps) then
		return math.clamp(math.floor(rules.AirJumps), 0, 3)
	end
	return 0
end

-- ---------------------------------------------------------------------
-- 4) CHARACTER-TEILE (Lift-Kraft, Staub)
-- ---------------------------------------------------------------------
local function attachCharacter(char: Model)
	character = char
	humanoid = nil
	root = nil
	liftForce = nil
	dust = nil
	appliedWalk = nil
	appliedJump = nil
	sliding = false
	carry = nil
	task.spawn(function()
		local h = char:WaitForChild("Humanoid", 10)
		local r = char:WaitForChild("HumanoidRootPart", 10)
		if character ~= char or not (h and h:IsA("Humanoid") and r and r:IsA("BasePart")) then
			return
		end
		humanoid = h
		root = r
		h.UseJumpPower = false
		local attachment = Instance.new("Attachment")
		attachment.Name = "CC_MoveAtt"
		attachment.Parent = r
		local force = Instance.new("VectorForce")
		force.Name = "CC_Lift"
		force.Attachment0 = attachment
		force.RelativeTo = Enum.ActuatorRelativeTo.World
		force.ApplyAtCenterOfMass = true
		force.Force = Vector3.zero
		force.Enabled = false
		force.Parent = r
		liftForce = force
		local feet = Instance.new("Attachment")
		feet.Name = "CC_DustAtt"
		feet.Position = Vector3.new(0, -2.6, 0.4)
		feet.Parent = r
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "CC_SlideDust"
		emitter.Texture = DUST_TEXTURE
		emitter.Color = ColorSequence.new(Color3.fromRGB(240, 232, 220))
		emitter.Lifetime = NumberRange.new(0.35, 0.6)
		emitter.Speed = NumberRange.new(2, 5)
		emitter.SpreadAngle = Vector2.new(35, 35)
		emitter.EmissionDirection = Enum.NormalId.Back
		emitter.Size = NumberSequence.new(0.6, 1.8)
		emitter.Transparency = NumberSequence.new(0.35, 1)
		emitter.Rate = 40
		emitter.Enabled = false
		emitter.Parent = feet
		dust = emitter
	end)
end

-- ---------------------------------------------------------------------
-- 5) RUTSCHEN
-- ---------------------------------------------------------------------
local function startSlide(now: number, s0: number, chained: boolean)
	local r = root
	if not r then
		return
	end
	local vel = horizontal(r.AssemblyLinearVelocity)
	local dir = if vel.Magnitude > 2 then vel.Unit else flatLook()
	sliding = true
	slideStart = now
	slideDir = dir
	slideS0 = math.clamp(s0, slideCfg("End"), math.max(slideCfg("Start"), slideCfg("JumpCap")))
	slideSpeed = slideS0
	if not chained then
		lastSlideStart = now
	end
	slideQueuedAt = -10
	carry = nil
	sprinting = false
	local v = r.AssemblyLinearVelocity
	r.AssemblyLinearVelocity = Vector3.new(dir.X * slideS0, math.min(v.Y, 0), dir.Z * slideS0)
	call("Sfx", "Play", "MeleeSwing", nil, { Volume = 0.35, Speed = 0.7 })
end

local function endSlide(now: number)
	if not sliding then
		return
	end
	sliding = false
	slideEndAt = now
	slideSpeedAtEnd = slideSpeed
end

local function wantsSlide(now: number): boolean
	return now - slideQueuedAt <= SLIDE_BUFFER
end

-- ---------------------------------------------------------------------
-- 6) SPRUNG-ANFRAGE (Rutsch-Sprung, Doppelsprung)
-- ---------------------------------------------------------------------
local function onJumpRequest()
	local h, r = humanoid, root
	if not (armed and h and r) or isFlying(h) then
		return
	end
	local now = os.clock()
	if now - lastJumpReq < 0.18 then
		return
	end
	lastJumpReq = now
	local grounded = h.FloorMaterial ~= Enum.Material.Air
	local fromSlide = sliding or (now - slideEndAt <= COYOTE and slideSpeedAtEnd > 0)
	if grounded and fromSlide then
		-- Rutsch-Sprung: 90 % horizontal behalten (max. 30); den Sprung selbst macht der Humanoid
		local speed = if sliding then slideSpeed else slideSpeedAtEnd
		local keep = math.min(speed * slideCfg("JumpKeep"), slideCfg("JumpCap"))
		endSlide(now)
		slideSpeedAtEnd = 0
		carry = { Dir = slideDir, Speed = keep }
		landedAt = now -- Boden-Fenster, bis der Humanoid abhebt
		local v = r.AssemblyLinearVelocity
		r.AssemblyLinearVelocity = Vector3.new(slideDir.X * keep, v.Y, slideDir.Z * keep)
		return
	end
	if not grounded and now - leftGroundAt >= AIR_JUMP_DELAY and airJumpsUsed < airJumpsAllowed() then
		airJumpsUsed += 1
		local g = workspace.Gravity * (1 - gravityLift)
		local vy = math.sqrt(2 * math.max(g, 1) * cfgNum(cfgPlayer(), "AirJumpHeight", 6))
		local v = r.AssemblyLinearVelocity
		local flat = horizontal(v)
		local md = horizontal(h.MoveDirection)
		local speed = math.max(flat.Magnitude, h.WalkSpeed)
		local newFlat = if md.Magnitude > 0.1 then md.Unit * speed else flat
		r.AssemblyLinearVelocity = Vector3.new(newFlat.X, vy, newFlat.Z)
		if carry and newFlat.Magnitude > 0.1 then
			carry.Dir = newFlat.Unit
		end
		call("Sfx", "Play", "MeleeSwing", nil, { Volume = 0.4, Speed = 1.4 })
	end
end

-- ---------------------------------------------------------------------
-- 7) PHYSIK-SCHRITT (PreSimulation: nach dem ControlModule, vor der Physik)
-- ---------------------------------------------------------------------
local function setWalk(h: Humanoid, value: number)
	if appliedWalk == nil or math.abs((appliedWalk :: number) - value) > 0.01 then
		appliedWalk = value
		h.WalkSpeed = value
	end
end

local function restoreDefaults()
	local h = humanoid
	if h then
		h.WalkSpeed = cfgNum(cfgPlayer(), "Walk", 16)
		h.JumpHeight = cfgNum(cfgPlayer(), "JumpHeight", 7.2)
		h.CameraOffset = Vector3.zero
	end
	appliedWalk = nil
	appliedJump = nil
	sliding = false
	carry = nil
	sprinting = false
	sprintToggled = false
	camDropAlpha = 0
	if liftForce then
		liftForce.Enabled = false
	end
	if dust then
		dust.Enabled = false
	end
	call("FpsCamera", "SetFovOffset", "Slide", 0)
	restored = true
end

local function step(dt: number)
	local h, r = humanoid, root
	if not (h and r) or h.Health <= 0 then
		return
	end
	if not armed then
		if not restored then
			restoreDefaults()
		end
		return
	end
	restored = false
	if isFlying(h) then
		return
	end
	local now = os.clock()
	local grounded = h.FloorMaterial ~= Enum.Material.Air
	if grounded and not wasGrounded then
		landedAt = now
		airJumpsUsed = 0
		if carry then
			-- Slide-Hop: Rutsch-Taste gehalten oder kurz vor der Landung gedrückt
			if slideHeld or now - slideQueuedAt <= HOP_WINDOW then
				local c = carry :: Carry
				startSlide(now, math.min(c.Speed, slideCfg("JumpCap")), true)
			end
		end
	elseif not grounded and wasGrounded then
		leftGroundAt = now
	end
	wasGrounded = grounded

	-- Tempo-Werte
	local d = currentDef()
	local moveMult = if d and finite(d.MoveMult) then d.MoveMult else 1
	local adsMult = if d and finite(d.AdsMoveMult) then d.AdsMoveMult else 1
	local ads = adsAlpha()
	local blocking = call("WeaponClient", "IsBlocking") == true
	local blockMult = 1
	if blocking and d and type(d.Melee) == "table" and type(d.Melee.Block) == "table" then
		blockMult = cfgNum(d.Melee.Block, "MoveMult", 0.65)
	end
	local p = cfgPlayer()
	local base = baseSpeed()
	local walk = base * moveMult * (1 + (adsMult - 1) * ads) * blockMult
	local sprintSpeed = base * (cfgNum(p, "Sprint", 22) / math.max(cfgNum(p, "Walk", 16), 1)) * moveMult

	-- Sprint-Absicht
	local md = horizontal(h.MoveDirection)
	local forward = md.Magnitude > 0.1 and md.Unit:Dot(flatLook()) > 0.5
	local touchAuto = call("Controls", "Input") == "Touch" and h.MoveDirection.Magnitude >= 0.9
	local intent = sprintHeld or sprintToggled or touchAuto
	if ads > 0.05 or blocking then
		sprintToggled = false
		intent = false
	end
	sprinting = intent and forward and not sliding and now >= sprintSuppressUntil

	-- Rutschen starten
	if not sliding and grounded and wantsSlide(now) then
		local speedNow = horizontal(r.AssemblyLinearVelocity).Magnitude
		-- "aus Sprint (Tempo ≥ 18)": Schwelle skaliert mit langsameren Mutatoren (BaseSpeed < Walk)
		local minSlide = slideCfg("MinSpeed") * math.min(1, base / math.max(cfgNum(p, "Walk", 16), 1)) - 0.5
		if (sprinting or carry ~= nil) and speedNow >= minSlide and now - lastSlideStart >= slideCfg("Cooldown") then
			startSlide(now, slideCfg("Start"), false)
		end
	end

	if sliding then
		local e = now - slideStart
		local finish = slideCfg("End")
		local duration = math.max(slideCfg("Time"), 0.1)
		slideSpeed = finish + (slideS0 - finish) * math.exp(-SLIDE_DECAY / duration * e)
		if md.Magnitude > 0.1 then
			slideDir = turnToward(slideDir, md.Unit, SLIDE_TURN * dt)
		end
		if e >= duration then
			endSlide(now)
		elseif not grounded and now - leftGroundAt > 0.15 then
			-- über eine Kante gerutscht: Schwung in die Luft mitnehmen
			carry = { Dir = slideDir, Speed = slideSpeed }
			endSlide(now)
		else
			setWalk(h, slideSpeed)
			h:Move(slideDir, false)
		end
	end
	if not sliding then
		local c = carry
		if c then
			if grounded and now - landedAt > GROUND_CARRY then
				carry = nil
			else
				if not grounded then
					c.Speed *= math.exp(-AIR_DRAG * dt)
				end
				if md.Magnitude > 0.1 then
					c.Dir = turnToward(c.Dir, md.Unit, AIR_TURN * dt)
				end
				if c.Speed <= walk + 0.5 then
					carry = nil
				else
					setWalk(h, math.min(c.Speed, IMPULSE_MAX))
					h:Move(c.Dir, false)
				end
			end
		end
		if carry == nil then
			setWalk(h, if sprinting then sprintSpeed else walk)
		end
	end

	-- Sprunghöhe
	local jh = jumpHeight()
	if appliedJump == nil or math.abs((appliedJump :: number) - jh) > 0.01 then
		appliedJump = jh
		h.UseJumpPower = false
		h.JumpHeight = jh
	end

	-- Kamera −1.6 beim Rutschen (CameraOffset), FOV +6
	local target = if sliding then 1 else 0
	camDropAlpha += (target - camDropAlpha) * (1 - math.exp(-dt * 14))
	local offset = Vector3.new(0, -slideCfg("CamDrop") * camDropAlpha, 0)
	if (h.CameraOffset - offset).Magnitude > 0.005 then
		h.CameraOffset = offset
	end
	call("FpsCamera", "SetFovOffset", "Slide", if sliding then slideCfg("FovKick") else 0)

	-- Schwerkraft-Lift
	local force = liftForce
	if force then
		local on = gravityLift > 0
		if force.Enabled ~= on then
			force.Enabled = on
		end
		if on then
			local f = Vector3.new(0, r.AssemblyMass * workspace.Gravity * gravityLift, 0)
			if (force.Force - f).Magnitude > 0.5 then
				force.Force = f
			end
		end
	end

	-- Staub-Trail
	local emitter = dust
	if emitter then
		local on = sliding and grounded
		if emitter.Enabled ~= on then
			emitter.Enabled = on
			emitter.Rate = if setting("ReducedFx") == true then 18 else 40
		end
	end
end

-- ---------------------------------------------------------------------
-- 8) ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function Movement.ApplyImpulse(v: Vector3)
	local h, r = humanoid, root
	if typeof(v) ~= "Vector3" or not (finite(v.X) and finite(v.Y) and finite(v.Z)) or not (h and r) then
		return
	end
	if v.Magnitude > IMPULSE_MAX then
		v = v.Unit * IMPULSE_MAX
	end
	local now = os.clock()
	endSlide(now)
	local newV = r.AssemblyLinearVelocity + v
	if newV.Magnitude > IMPULSE_MAX then
		newV = newV.Unit * IMPULSE_MAX
	end
	r.AssemblyLinearVelocity = newV
	if v.Y > 5 then
		h:ChangeState(Enum.HumanoidStateType.Freefall)
		leftGroundAt = now
		wasGrounded = false
	end
	local flat = horizontal(newV)
	if flat.Magnitude > h.WalkSpeed + 2 then
		carry = { Dir = flat.Unit, Speed = flat.Magnitude }
		landedAt = now -- Boden-Schwung-Fenster ab jetzt
	end
end

function Movement.SetGravityLift(frac: number)
	gravityLift = if finite(frac) then math.clamp(frac, 0, 0.95) else 0
end

function Movement.IsSliding(): boolean
	return sliding
end

function Movement.IsSprinting(): boolean
	return sprinting
end

function Movement.StopSprint()
	sprintToggled = false
	sprinting = false
	local p = cfgPlayer()
	sprintSuppressUntil = os.clock() + math.max(cfgNum(p, "SprintToFire", 0.12), 0.12) + 0.1
end

function Movement.IsAirborne(): boolean
	local h = humanoid
	if not h then
		return false
	end
	return h.FloorMaterial == Enum.Material.Air
end

function Movement.Speed(): number
	local r = root
	return if r then horizontal(r.AssemblyLinearVelocity).Magnitude else 0
end

-- ---------------------------------------------------------------------
-- 9) MODUL-FORM
-- ---------------------------------------------------------------------
local function onArmed(info: any)
	haveArmed = true
	armed = true
	rules = if type(info) == "table" and type(info.Rules) == "table" then info.Rules else {}
	Movement.SetGravityLift(if finite(rules.GravityLift) then rules.GravityLift else 0)
	lastSlideStart = -10
	airJumpsUsed = 0
end

local function onDisarmed()
	haveArmed = false
	armed = false
	rules = {}
	gravityLift = 0
	if not restored then
		restoreDefaults()
	end
end

local function bindInput()
	local controls = modules().Controls
	if controls and type(controls.Bind) == "function" then
		controls.Bind("Sprint", function(state: string)
			if state == "Begin" then
				sprintHeld = true
				if setting("SprintToggle") == true then
					sprintToggled = not sprintToggled
				end
			elseif state == "End" then
				sprintHeld = false
			end
		end)
		controls.Bind("Slide", function(state: string)
			if state == "Begin" then
				slideHeld = true
				slideQueuedAt = os.clock()
			elseif state == "End" then
				slideHeld = false
			end
		end)
		return
	end
	-- Ersatz ohne Controls-Modul (nur Tastatur, damit Studio-Tests trotzdem laufen)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftShift then
			sprintHeld = true
		elseif input.KeyCode == Enum.KeyCode.C or input.KeyCode == Enum.KeyCode.LeftControl then
			slideHeld = true
			slideQueuedAt = os.clock()
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.LeftShift then
			sprintHeld = false
		elseif input.KeyCode == Enum.KeyCode.C or input.KeyCode == Enum.KeyCode.LeftControl then
			slideHeld = false
		end
	end)
end

function Movement.Init(context: any)
	ctx = context
end

function Movement.Start()
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		hooks.On("Armed", onArmed)
		hooks.On("Disarmed", onDisarmed)
		hooks.On("LocalPopped", function()
			armed = false -- gepoppt: zuschauen, keine Bewegungs-Tech
		end)
		hooks.On("LocalRevived", function()
			armed = haveArmed
		end)
		hooks.On("Combat:Impulse", function(data: any)
			if type(data) == "table" and typeof(data.V) == "Vector3" then
				Movement.ApplyImpulse(data.V)
			end
		end)
	end
	bindInput()
	UserInputService.JumpRequest:Connect(onJumpRequest)
	if player.Character then
		attachCharacter(player.Character)
	end
	player.CharacterAdded:Connect(attachCharacter)
	RunService.PreSimulation:Connect(step)
end

return Movement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="127">
            <Properties>
              <string name="Name">PhotoMode</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Foto-Modus für Thumbnails (Client/Modules/PhotoMode)
--  Besitzer: WP7 (Sicherheit, Admin, Live-Balance). Basis: Meteor-Heist-PhotoMode (REUSE §1.4, COPY + Shooter-Teile).
--  Nur für den Besitzer (Modul lädt nur bei IsAdmin). Taste H (Config.Client.Keys.PhotoMode, falls gesetzt) oder
--  Admin-Panel -> Kräfte -> Foto-Modus. Rein clientseitig: 1.5 s Toast, dann ausblenden:
--  eigene UI (ctx.Gui), Touch-Knöpfe (ctx.TouchGui), Viewmodel, Fadenkreuz (CombatHud), Effekte (Ansagen/Zahlen),
--  Roblox-Oberfläche (gemerkt und wiederhergestellt) und alle ProximityPrompts (auch wenn der Server sie wieder
--  einschaltet). Nochmal = alles wieder an. Hook "PhotoMode"(on) für Admin-Anzeigen (ESP, F8).
--
--  Öffentliche API (C7.4):
--    PhotoMode.Toggle()
--    PhotoMode.IsActive(): boolean
--    PhotoMode.Init(ctx) / PhotoMode.Start()
-- =====================================================================

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local PhotoMode = {}

local player = Players.LocalPlayer
local ctx: any = nil

local DELAY = 1.5 -- Sekunden Toast, bevor ausgeblendet wird

local photoMode = false
local photoPending = false
local photoToken = 0
local photoHidden: { [ProximityPrompt]: boolean } = {}
local photoConnections: { RBXScriptConnection } = {}
local savedCoreGui: { [Enum.CoreGuiType]: boolean } = {}
local savedGui: { [Instance]: boolean } = {}

local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function module(name: string): any
	local modules = ctx and ctx.Modules
	return if type(modules) == "table" then modules[name] else nil
end

-- Modul-Funktion sicher aufrufen (fehlende Module sind kein Fehler)
local function tryCall(name: string, fnName: string, ...: any)
	local m = module(name)
	local fn = if type(m) == "table" then m[fnName] else nil
	if type(fn) == "function" then
		pcall(fn, ...)
	end
end

local function fireHook(name: string, ...: any)
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.Fire) == "function" then
		hooks.Fire(name, ...)
	end
end

local function setGuiEnabled(gui: any, on: boolean)
	if typeof(gui) ~= "Instance" or not gui:IsA("LayerCollector") then
		return
	end
	if not on then
		savedGui[gui] = gui.Enabled
		gui.Enabled = false
	elseif savedGui[gui] ~= nil then
		gui.Enabled = savedGui[gui] == true
		savedGui[gui] = nil
	end
end

local function hidePrompt(prompt: ProximityPrompt)
	local function off()
		if photoMode and prompt.Enabled then
			photoHidden[prompt] = true
			prompt.Enabled = false
		end
	end
	off()
	-- Der Server schaltet Prompts evtl. wieder ein -> sofort wieder aus
	table.insert(photoConnections, prompt:GetPropertyChangedSignal("Enabled"):Connect(off))
end

local function startPhotoMode()
	photoMode = true
	local ui = ctx and ctx.UI
	if ui and type(ui.CloseAll) == "function" then
		pcall(ui.CloseAll) -- offene Fenster zu
	end
	setGuiEnabled(ctx and ctx.Gui, false)
	setGuiEnabled(ctx and ctx.TouchGui, false)
	tryCall("Effects", "SetHidden", true)
	tryCall("Viewmodel", "SetHidden", true)
	tryCall("CombatHud", "Show", false)
	fireHook("PhotoMode", true)
	-- Roblox-Oberfläche merken und ausblenden
	savedCoreGui = {}
	for _, item in ipairs(Enum.CoreGuiType:GetEnumItems()) do
		if item ~= Enum.CoreGuiType.All then
			local ok, enabled = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, item)
			-- Nicht lesbar -> beim Beenden trotzdem wieder einschalten (sonst bliebe es für immer aus)
			savedCoreGui[item] = not ok or enabled == true
		end
	end
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.All, false)
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("ProximityPrompt") then
			hidePrompt(inst)
		end
	end
	table.insert(
		photoConnections,
		workspace.DescendantAdded:Connect(function(inst)
			if inst:IsA("ProximityPrompt") then
				hidePrompt(inst)
			end
		end)
	)
end

local function stopPhotoMode()
	photoMode = false
	for _, connection in ipairs(photoConnections) do
		connection:Disconnect()
	end
	photoConnections = {}
	setGuiEnabled(ctx and ctx.Gui, true)
	setGuiEnabled(ctx and ctx.TouchGui, true)
	table.clear(savedGui)
	tryCall("Effects", "SetHidden", false)
	tryCall("Viewmodel", "SetHidden", false)
	local weapon = module("WeaponClient")
	local armed = false
	if weapon and type(weapon.IsArmed) == "function" then
		local ok, result = pcall(weapon.IsArmed)
		armed = ok and result == true
	end
	if armed then
		tryCall("CombatHud", "Show", true)
	end
	for item, enabled in pairs(savedCoreGui) do
		pcall(StarterGui.SetCoreGuiEnabled, StarterGui, item, enabled)
	end
	-- Backpack/Health bleiben im Shooter immer aus (WP10)
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false)
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Health, false)
	for prompt in pairs(photoHidden) do
		if prompt.Parent then
			prompt.Enabled = true
		end
	end
	photoHidden = {}
	fireHook("PhotoMode", false)
end

function PhotoMode.IsActive(): boolean
	return photoMode
end

local function keyName(): string
	local keys = ctx and ctx.Config and ctx.Config.Client and ctx.Config.Client.Keys
	local list = keys and keys.PhotoMode
	if type(list) == "table" and type(list[1]) == "string" then
		return list[1]
	end
	return "H"
end

function PhotoMode.Toggle()
	if photoMode or photoPending then
		photoToken += 1
		photoPending = false
		if photoMode then
			stopPhotoMode()
			if ctx and type(ctx.Toast) == "function" then
				ctx.Toast(T("admin.photoOff"), "Info")
			end
		end
		return
	end
	if player:GetAttribute("IsAdmin") ~= true then
		return
	end
	photoPending = true
	photoToken += 1
	local token = photoToken
	if ctx and type(ctx.Toast) == "function" then
		ctx.Toast(T("admin.photoOn", keyName()), "Info")
	end
	task.delay(DELAY, function()
		if photoPending and photoToken == token then
			photoPending = false
			startPhotoMode()
		end
	end)
end

function PhotoMode.Init(context: any)
	ctx = context
end

function PhotoMode.Start()
	local ok, code = pcall(function()
		return (Enum.KeyCode :: any)[keyName()]
	end)
	local key: EnumItem = if ok and typeof(code) == "EnumItem" then code else Enum.KeyCode.H
	-- Funktioniert auch bei versteckter UI, aber nicht beim Tippen in einer TextBox
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.KeyCode ~= key or UserInputService:GetFocusedTextBox() then
			return
		end
		PhotoMode.Toggle()
	end)
end

return PhotoMode
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">Progress</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Fortschritts-Fenster: Quests, Clutch Pass, Täglich (Login, Glücksrad, Geschenke,
--  Codes, Einladen), Statistik + Gratis-Waffen-Wahl, Level-Up-Karte (Client/Modules/Progress)
--  Besitzer: WP8 (Fortschritt). Vertrag: DESIGN.md C7.3/C7.4 + B16 + B21.2 + B24.
--
--  Öffentliche API (C7.4):
--    Progress.Open(tab: "Quests" | "Pass" | "Daily" | "Stats")
--    Progress.Init(ctx) / Progress.Start()
--  Fenster (ctx.Windows): "Quests", "Pass", "Daily" (C7.3) + zusätzlich "Stats" (Statistik/Erfolge/Waffen-Wahl).
--  Liest nur ctx.State (Level, XP, XPNext, Stats, Quests, Login, Daily, Pass, Season, Achievements, Honor,
--  Mastery, FreeWeaponPicks) und schickt Requests (ClaimQuest, RerollQuest, ClaimLogin, SpinWheel, ClaimGift,
--  ClaimPass, ClaimLevelPick, RedeemCode). Der Server prüft alles; das UI schreibt nur bei Wertänderung.
--  Hooks: "State", "Effect:LevelUp" (Belohnungskarte; Blitz/Konfetti macht WP10-Effects).
--  Freund-Toast (Effect "Friend") zeigt WP10-Effects; der Einladen-Knopf sitzt im Fenster "Täglich".
-- =====================================================================

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SocialService = game:GetService("SocialService")
local TweenService = game:GetService("TweenService")

local ProgressMath = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ProgressMath"))

local Progress = {}

local ctx: any = nil
local UI: any = nil
local Config: any = nil
local P: any = nil

local WINDOW_W, WINDOW_H = 660, 580
local MY_KEYS = {
	"Level",
	"XP",
	"XPNext",
	"Stats",
	"Quests",
	"Login",
	"Daily",
	"Pass",
	"Season",
	"Achievements",
	"Honor",
	"Mastery",
	"FreeWeaponPicks",
	"Weapons",
	"OwnedWeapons",
}
local TABS = { "Quests", "Pass", "Daily", "Stats" }
local TAB_ICONS = { Quests = "📜", Pass = "🎟️", Daily = "🎁", Stats = "📊" }
local ROMAN = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X" }
local LEVEL_CARD_TIME = 4.5

type View = { Win: any, Refresh: () -> (), Tick: (() -> ())? }
local views: { [string]: View } = {}
local hudButtons: { [string]: any } = {}
local hudBadges: { [string]: any } = {}
local levelCard: Frame? = nil
local levelCardToken = 0
local tickAcc = 0

-- ---------------------------------------------------------------------
-- 0) HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function num(v: any, default: number): number
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return default
end

local function state(key: string): any
	local value = ctx.State[key]
	return if type(value) == "table" then value else nil
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function formatTime(seconds: number): string
	return ctx.Util.FormatTime(math.max(0, seconds))
end

local function fmt(n: number): string
	return ctx.Util.FormatNumber(n)
end

local function pick(t: any): string
	if type(t) == "table" then
		return ctx.Lang.Pick(ctx.Lang_(), t)
	end
	return tostring(t)
end

local function cosmeticName(id: string): string
	local cosmetics = Config.Cosmetics
	local def = cosmetics and cosmetics.ById and cosmetics.ById[id]
	if type(def) == "table" and type(def.Name) == "table" then
		return pick(def.Name)
	end
	return id
end

local function describe(reward: any): string
	return ProgressMath.DescribeReward(reward, T, cosmeticName)
end

local function weaponName(key: string): string
	local def = Config.Weapon(key)
	if def and type(def.Name) == "table" then
		return pick(def.Name)
	end
	return key
end

local function setText(label: TextLabel, text: string)
	if label.Text ~= text then
		label.Text = text
	end
end

local function setVisible(inst: GuiObject, on: boolean)
	if inst.Visible ~= on then
		inst.Visible = on
	end
end

local function request(action: string, arg: any?): any
	local ok, result = pcall(ctx.Request, action, arg)
	if ok then
		return result
	end
	return nil
end

local function percent(part: number, total: number): string
	if total <= 0 then
		return "–"
	end
	return ("%d %%"):format(math.floor(part / total * 100 + 0.5))
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	props.Parent = parent
	if props.TextXAlignment == nil then
		props.TextXAlignment = Enum.TextXAlignment.Left
	end
	if props.Outline == nil then
		props.Outline = 2
	end
	return UI.Label(props)
end

local function activeSeasonConfig(): any
	local season = state("Season")
	local list = Config.Season and Config.Season.Seasons
	if type(list) ~= "table" then
		return nil
	end
	local id = season and season.Id
	for _, s in ipairs(list) do
		if s.Id == id then
			return s
		end
	end
	return ProgressMath.PickSeason(list, os.time())
end

-- ---------------------------------------------------------------------
-- 1) GERÜST: Fenster mit Reiter-Zeile
-- ---------------------------------------------------------------------
local function tabRow(win: any, current: string)
	local row = UI.Row(win.Content, 0, 48)
	for i, name in ipairs(TABS) do
		local selected = name == current
		UI.Button({
			Size = UDim2.new(0.25, -6, 1, -4),
			LayoutOrder = i,
			Parent = row,
			Text = TAB_ICONS[name] .. " " .. T("prog.ui.tab" .. name),
			Color = if selected then UI.Theme.Yellow else UI.Theme.Blue,
			MaxText = 20,
		}, function()
			if not selected then
				Progress.Open(name)
			end
		end)
	end
end

local function newWindow(name: string, titleKey: string, color: Color3): any
	local win = UI.Window(T(titleKey), WINDOW_W, WINDOW_H, color)
	tabRow(win, name)
	return win
end

-- Quest-/Belohnungs-Karte mit Text, Balken und Knopf rechts
type QuestCard = {
	Frame: Frame,
	Title: TextLabel,
	Reward: TextLabel,
	Bar: any,
	Claim: any,
	Reroll: any?,
}

local function questCard(
	parent: Instance,
	order: number,
	withReroll: boolean,
	onClaim: () -> (),
	onReroll: (() -> ())?
): QuestCard
	local frame = UI.Card({ Size = UDim2.new(1, -6, 0, 92), LayoutOrder = order, Parent = parent })
	local title = label(frame, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -200, 0, 28), MaxText = 22 })
	local reward = label(frame, {
		Position = UDim2.fromOffset(12, 34),
		Size = UDim2.new(1, -200, 0, 20),
		MaxText = 16,
		TextColor3 = UI.Theme.Yellow,
	})
	local bar = UI.Bar({
		Position = UDim2.fromOffset(12, 58),
		Size = UDim2.new(1, -200, 0, 24),
		Parent = frame,
		Color = UI.Theme.Green,
	})
	local claim = UI.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(170, 52),
		Parent = frame,
		Text = T("prog.ui.claim"),
		Color = UI.Theme.Green,
		MaxText = 20,
	}, onClaim)
	local reroll = nil
	if withReroll and onReroll then
		reroll = UI.Button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(170, 52),
			Parent = frame,
			Text = T("prog.ui.reroll"),
			Color = UI.Theme.Purple,
			MaxText = 18,
			SubMax = 14,
		}, onReroll)
	end
	return { Frame = frame, Title = title, Reward = reward, Bar = bar, Claim = claim, Reroll = reroll }
end

-- Zustand einer Quest-Karte setzen (P/Goal/Claimed)
local function showQuest(
	card: QuestCard,
	text: string,
	rewardText: string,
	p: number,
	goal: number,
	claimed: boolean,
	rerollText: string?
)
	setText(card.Title, text)
	setText(card.Reward, rewardText)
	UI.SetBar(card.Bar, if goal > 0 then p / goal else 0, ("%s / %s"):format(fmt(math.floor(p)), fmt(goal)))
	local done = p >= goal
	if claimed then
		card.Claim.SetText("✓ " .. T("prog.ui.claimed"))
		card.Claim.SetColor(UI.Theme.Gray)
	else
		card.Claim.SetText(T("prog.ui.claim"))
		card.Claim.SetColor(UI.Theme.Green)
	end
	setVisible(card.Claim.Frame, claimed or done or card.Reroll == nil)
	if card.Reroll then
		setVisible(card.Reroll.Frame, not claimed and not done)
		if rerollText then
			card.Reroll.SetSub(rerollText)
		end
	end
end

-- ---------------------------------------------------------------------
-- 2) QUESTS (Anfänger-Kette, 3 täglich, 5 wöchentlich)
-- ---------------------------------------------------------------------
local function buildQuests(): View
	local win = newWindow("Quests", "prog.ui.questsTitle", UI.Theme.Orange)
	local content = win.Content
	local dayTimer = label(content, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, MaxText = 16 })

	UI.Section(content, T("prog.ui.beginner"), 2, UI.Theme.Cyan)
	local beginnerCard = questCard(content, 3, false, function()
		local quests = state("Quests")
		local id = quests and quests.Beginner and quests.Beginner.Id
		if type(id) == "string" and id ~= "" then
			request("ClaimQuest", id)
		end
	end)

	UI.Section(content, T("prog.ui.daily"), 10)
	local dailyCards: { QuestCard } = {}
	for i = 1, 3 do
		dailyCards[i] = questCard(content, 10 + i, true, function()
			local quests = state("Quests")
			local q = quests and quests.Daily and quests.Daily[i]
			if q then
				request("ClaimQuest", q.Id)
			end
		end, function()
			request("RerollQuest", i)
		end)
	end
	local dailyBonus = label(content, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 20, MaxText = 16 })

	local weeklyHeader = UI.Section(content, T("prog.ui.weekly"), 30)
	local weeklyCards: { QuestCard } = {}
	for i = 1, 8 do
		weeklyCards[i] = questCard(content, 30 + i, false, function()
			local quests = state("Quests")
			local q = quests and quests.Weekly and quests.Weekly[i]
			if q then
				request("ClaimQuest", q.Id)
			end
		end)
	end
	local chest = label(content, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 50, MaxText = 16 })

	local function tick()
		local quests = state("Quests")
		if quests then
			setText(dayTimer, T("prog.ui.dayReset", formatTime(num(quests.DayEndsAt, 0) - serverNow())))
			setText(
				weeklyHeader,
				T("prog.ui.weekly")
					.. "  ·  "
					.. T("prog.ui.weekReset", formatTime(num(quests.WeekEndsAt, 0) - serverNow()))
			)
		end
	end

	local function refresh()
		local quests = state("Quests")
		if not quests then
			return
		end
		-- Anfänger
		local b = quests.Beginner
		local beginnerDone = type(b) ~= "table" or b.Done == true
		setVisible(beginnerCard.Frame, not beginnerDone)
		if not beginnerDone then
			local reward: { [string]: any } = { Coins = b.Coins }
			if num(b.FreePick, 0) > 0 then
				reward.FreePick = b.FreePick
			end
			showQuest(
				beginnerCard,
				("%d/%d · %s"):format(num(b.Step, 1), num(b.Total, 10), T("prog.q." .. tostring(b.Id), num(b.Goal, 1))),
				describe(reward),
				num(b.P, 0),
				num(b.Goal, 1),
				false
			)
		end
		-- Täglich
		local dailyCfg = P.Quests.DailyRewards
		local rerolls = num(quests.Rerolls, 0)
		local rerollText = if rerolls > 0
			then T("prog.ui.rerollFree", rerolls)
			else T("prog.r.coins", num(quests.RerollCoins, 100))
		for i, card in ipairs(dailyCards) do
			local q = quests.Daily and quests.Daily[i]
			setVisible(card.Frame, q ~= nil)
			if q then
				local reward = dailyCfg[q.Tier or "Easy"] or dailyCfg.Easy
				showQuest(
					card,
					T("prog.tier." .. tostring(q.Tier or "Easy")) .. " · " .. T("prog.q." .. q.Id, q.Goal),
					describe({ Coins = reward.Coins, PassXp = reward.PassXp }),
					num(q.P, 0),
					num(q.Goal, 1),
					q.Claimed == true,
					rerollText
				)
			end
		end
		setText(
			dailyBonus,
			if quests.DailyBonus then "✓ " .. T("prog.ui.dailyBonusDone") else T("prog.ui.dailyBonus")
		)
		-- Wöchentlich
		local weeklyCfg = P.Quests.WeeklyReward
		for i, card in ipairs(weeklyCards) do
			local q = quests.Weekly and quests.Weekly[i]
			setVisible(card.Frame, q ~= nil)
			if q then
				showQuest(
					card,
					T("prog.q." .. q.Id, q.Goal),
					describe({ Coins = weeklyCfg.Coins, PassXp = weeklyCfg.PassXp }),
					num(q.P, 0),
					num(q.Goal, 1),
					q.Claimed == true
				)
			end
		end
		setText(
			chest,
			if quests.WeeklyChest
				then "✓ " .. T("prog.ui.chestDone")
				else T("prog.ui.chest", describe(P.Quests.WeeklyChest))
		)
		tick()
	end
	return { Win = win, Refresh = refresh, Tick = tick }
end

-- ---------------------------------------------------------------------
-- 3) CLUTCH PASS (30 Stufen, Gratis + Premium, rückwirkend)
-- ---------------------------------------------------------------------
local function premiumProductId(): number
	local products = Config.Shop and Config.Shop.Products
	if type(products) == "table" then
		for _, product in ipairs(products) do
			if product.Key == "PassPremium" then
				return num(product.Id, 0)
			end
		end
	end
	return 0
end

local function buyPremium()
	local id = premiumProductId()
	if id > 0 then
		local ok, err = pcall(function()
			MarketplaceService:PromptProductPurchase(ctx.Player, id)
		end)
		if not ok then
			warn("[Progress] Pass-Kauf: " .. tostring(err))
		end
		return
	end
	local shop = ctx.Modules.Shop
	if shop and type(shop.Open) == "function" then
		pcall(shop.Open, "Pass")
	else
		ctx.Toast(T("prog.ui.notSetUp"), "Info")
	end
end

local function buildPass(): View
	local win = newWindow("Pass", "prog.ui.passTitle", UI.Theme.Pink)
	local content = win.Content
	local seasonLabel =
		label(content, { Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 1, MaxText = 22, TextColor3 = UI.Theme.Cyan })
	local endsLabel = label(content, { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 2, MaxText = 16 })
	local bar = UI.Bar({ Size = UDim2.new(1, -6, 0, 30), LayoutOrder = 3, Parent = content, Color = UI.Theme.Pink })
	local premiumRow = UI.Row(content, 4, 56)
	local premiumButton = UI.Button({
		Size = UDim2.new(1, -6, 1, -4),
		Parent = premiumRow,
		Text = T("prog.ui.passBuy"),
		Color = UI.Theme.Gold,
		MaxText = 22,
	}, buyPremium)
	local note =
		label(content, { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 5, MaxText = 14, TextColor3 = UI.Theme.SubText })
	note.Text = T("prog.ui.passNote")

	type TierRow = { Frame: Frame, Tier: TextLabel, Free: any, Prem: any }
	local rows: { TierRow } = {}
	local built = 0

	local function claim(tier: number, track: string)
		request("ClaimPass", { Tier = tier, Track = track })
	end

	local function ensureRows(count: number)
		-- Zeilen nur einmal bauen (max. 100 Stufen)
		for tier = built + 1, math.min(count, 100) do
			local frame = UI.Card({ Size = UDim2.new(1, -6, 0, 62), LayoutOrder = 10 + tier, Parent = content })
			local tierLabel = label(frame, {
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(0, 80, 1, 0),
				Text = T("prog.ui.tier", tier),
				MaxText = 18,
				TextXAlignment = Enum.TextXAlignment.Center,
			})
			local free = UI.Button({
				Position = UDim2.new(0, 94, 0.5, -26),
				Size = UDim2.new(0.5, -60, 0, 52),
				Parent = frame,
				Text = "",
				Sub = "",
				Color = UI.Theme.Blue,
				MaxText = 16,
				SubMax = 13,
			}, function()
				claim(tier, "Free")
			end)
			local prem = UI.Button({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -8, 0.5, -26),
				Size = UDim2.new(0.5, -60, 0, 52),
				Parent = frame,
				Text = "",
				Sub = "",
				Color = UI.Theme.Purple,
				MaxText = 16,
				SubMax = 13,
			}, function()
				claim(tier, "Premium")
			end)
			rows[tier] = { Frame = frame, Tier = tierLabel, Free = free, Prem = prem }
			built = tier
		end
	end

	local function showCell(
		button: any,
		reward: any,
		reached: boolean,
		claimed: boolean,
		locked: boolean,
		tier: number,
		baseColor: Color3
	)
		if type(reward) ~= "table" then
			setVisible(button.Frame, false)
			return
		end
		setVisible(button.Frame, true)
		button.SetText(describe(reward))
		if claimed then
			button.SetSub("✓ " .. T("prog.ui.claimed"))
			button.SetColor(UI.Theme.Gray)
		elseif locked then
			button.SetSub("🔒 " .. T("prog.ui.premium"))
			button.SetColor(baseColor:Lerp(UI.Theme.Gray, 0.5))
		elseif reached then
			button.SetSub(T("prog.ui.claim") .. "!")
			button.SetColor(UI.Theme.Green)
		else
			button.SetSub(T("prog.ui.tier", tier))
			button.SetColor(baseColor)
		end
	end

	local function tick()
		local season = state("Season")
		if season then
			setText(endsLabel, T("prog.ui.seasonEnds", formatTime(num(season.EndsAt, 0) - serverNow())))
		end
	end

	local function refresh()
		local season = state("Season")
		local pass = state("Pass")
		local cfg = activeSeasonConfig()
		if not season or not pass or not cfg then
			return
		end
		setText(seasonLabel, pick(season.Name))
		local tiers = num(season.Tiers, 30)
		local tierXp = math.max(1, num(season.TierXp, 3000))
		local tier = num(pass.Tier, 0)
		local xp = num(pass.XP, 0)
		local inTier = if tier >= tiers then tierXp else xp - tier * tierXp
		UI.SetBar(bar, inTier / tierXp, T("prog.ui.passBar", tier, tiers, fmt(math.floor(inTier)), fmt(tierXp)))
		setVisible(premiumRow, not pass.Premium)
		premiumButton.SetText(T("prog.ui.passBuy"))
		ensureRows(tiers)
		for i = 1, built do
			local row = rows[i]
			local active = i <= tiers
			setVisible(row.Frame, active)
			if active then
				local key = tostring(i)
				local reached = tier >= i
				local freeRewards = cfg.Free or {}
				local premRewards = cfg.Premium or {}
				showCell(
					row.Free,
					freeRewards[key],
					reached,
					pass.Free and pass.Free[key] == true,
					false,
					i,
					UI.Theme.Blue
				)
				showCell(
					row.Prem,
					premRewards[key],
					reached,
					pass.Prem and pass.Prem[key] == true,
					not pass.Premium,
					i,
					UI.Theme.Purple
				)
				row.Tier.TextColor3 = if reached then UI.Theme.Yellow else UI.Theme.Text
			end
		end
		tick()
	end
	return { Win = win, Refresh = refresh, Tick = tick }
end

-- ---------------------------------------------------------------------
-- 4) TÄGLICH (Login-Kalender, Glücksrad mit Quoten, Spielzeit-Geschenke, erster Sieg, Codes, Einladen)
-- ---------------------------------------------------------------------
local function invite()
	local ok, canInvite = pcall(function()
		return SocialService:CanSendGameInviteAsync(ctx.Player)
	end)
	if ok and canInvite then
		pcall(function()
			SocialService:PromptGameInvite(ctx.Player)
		end)
	else
		ctx.Toast(T("prog.ui.inviteNo"), "Info")
	end
end

local function buildDaily(): View
	local win = newWindow("Daily", "prog.ui.dailyTitle", UI.Theme.Green)
	local content = win.Content
	local reset = label(content, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, MaxText = 16 })

	-- Login-Kalender
	UI.Section(content, T("prog.ui.login"), 2)
	local calendar = UI.Grid(content, 3, 82, 96)
	local calCells: { { Frame: Frame, Day: TextLabel, Reward: TextLabel } } = {}
	for day, reward in ipairs(P.Login.Calendar) do
		local cell = UI.Card({ LayoutOrder = day, Parent = calendar })
		local dayLabel = label(cell, {
			Position = UDim2.fromOffset(4, 4),
			Size = UDim2.new(1, -8, 0, 24),
			Text = T("prog.ui.day", day),
			MaxText = 18,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		local rewardLabel = label(cell, {
			Position = UDim2.fromOffset(4, 30),
			Size = UDim2.new(1, -8, 1, -34),
			Text = describe(reward),
			MaxText = 14,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = UI.Theme.Yellow,
		})
		calCells[day] = { Frame = cell, Day = dayLabel, Reward = rewardLabel }
	end
	local loginRow = UI.Row(content, 4, 56)
	local loginButton = UI.Button({
		Size = UDim2.new(0.5, -6, 1, -4),
		Parent = loginRow,
		Text = T("prog.ui.loginClaim"),
		Color = UI.Theme.Green,
		MaxText = 20,
	}, function()
		request("ClaimLogin")
	end)
	local streakLabel = label(loginRow, { Size = UDim2.new(0.5, -6, 1, 0), MaxText = 16 })

	-- Glücksrad
	UI.Section(content, T("prog.ui.wheel"), 10)
	local wheelRow = UI.Row(content, 11, 56)
	local wheelResult = label(content, {
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 12,
		MaxText = 22,
		TextColor3 = UI.Theme.Yellow,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local wheelScale = UI.Create("UIScale", { Parent = wheelResult })
	local odds = UI.Card({
		Size = UDim2.new(1, -6, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 13,
		Parent = content,
		Visible = false,
	})
	-- Gratis-Dreh (keine bezahlten Drehs, B16.4); Ergebnis kommt vom Server
	local spinButton = UI.Button({
		Size = UDim2.new(0.5, -6, 1, -4),
		Parent = wheelRow,
		Text = T("prog.ui.spin"),
		Sub = "",
		Color = UI.Theme.Orange,
		MaxText = 20,
		SubMax = 14,
	}, function()
		local result = request("SpinWheel")
		if type(result) == "table" and type(result.Reward) == "table" then
			wheelResult.Text = "🎉 " .. describe(result.Reward)
			wheelScale.Scale = 0.6
			TweenService
				:Create(wheelScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
				:Play()
		end
	end)
	-- Quoten sind vor dem Drehen sichtbar ("Details", Summe 100 %)
	UI.Button({
		Size = UDim2.new(0.5, -6, 1, -4),
		Parent = wheelRow,
		Text = T("prog.ui.odds"),
		Color = UI.Theme.Blue,
		MaxText = 18,
	}, function()
		odds.Visible = not odds.Visible
	end)
	UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = odds })
	UI.Create(
		"UIPadding",
		{ PaddingLeft = UDim.new(0, 10), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = odds }
	)
	local total = 0
	for _, prize in ipairs(P.Wheel.Prizes) do
		total += num(prize.W, 0)
	end
	for i, prize in ipairs(P.Wheel.Prizes) do
		label(odds, {
			Size = UDim2.new(1, -10, 0, 20),
			LayoutOrder = i,
			MaxText = 15,
			Text = ("%s – %s"):format(describe(prize), percent(num(prize.W, 0), total)),
		})
	end
	label(odds, { Size = UDim2.new(1, -10, 0, 20), LayoutOrder = 99, MaxText = 14, Text = T("prog.ui.oddsNote") })

	-- Spielzeit-Geschenke
	UI.Section(content, T("prog.ui.gifts"), 20)
	local giftGrid = UI.Grid(content, 21, 145, 104)
	type GiftCell = { Button: any, Minutes: number, Sub: string, Color: Color3? }
	local giftCells: { GiftCell } = {}
	for i, minutes in ipairs(P.Playtime.Minutes) do
		local index = i
		local button = UI.Button({
			LayoutOrder = i,
			Parent = giftGrid,
			Size = UDim2.fromScale(1, 1),
			Text = describe(P.Playtime.Rewards[i]),
			Sub = T("prog.ui.minutes", minutes),
			Color = UI.Theme.Blue,
			MaxText = 16,
			SubMax = 14,
			Wrap = true,
		}, function()
			request("ClaimGift", index)
		end)
		giftCells[i] = { Button = button, Minutes = minutes, Sub = "", Color = nil }
	end

	-- Erster Sieg, Codes, Einladen
	local firstWin = label(content, { Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 30, MaxText = 18 })
	UI.Section(content, T("prog.ui.code"), 31)
	local codeRow = UI.Row(content, 32, 50)
	local codeBox =
		UI.TextBox({ Size = UDim2.new(0.6, -6, 1, -6), PlaceholderText = T("prog.ui.codeHint"), Parent = codeRow })
	UI.Button({
		Size = UDim2.new(0.4, -6, 1, -4),
		Parent = codeRow,
		Text = T("prog.ui.redeem"),
		Color = UI.Theme.Purple,
		MaxText = 18,
	}, function()
		local code = codeBox.Text
		if #code > 0 and #code <= 28 then
			local result = request("RedeemCode", code)
			if type(result) == "table" then
				codeBox.Text = ""
			end
		end
	end)
	local inviteRow = UI.Row(content, 40, 52)
	UI.Button({
		Size = UDim2.new(1, -6, 1, -4),
		Parent = inviteRow,
		Text = "👋 " .. T("prog.ui.invite"),
		Color = UI.Theme.Cyan,
		MaxText = 18,
	}, invite)

	local function tick()
		local daily = state("Daily")
		local login = state("Login")
		if daily then
			local text = T("prog.ui.dayReset", formatTime(num(daily.DayEndsAt, 0) - serverNow()))
			if login and not login.CanClaim then
				local nextReward = P.Login.Calendar[num(login.NextDay, 1)]
				text ..= "  ·  " .. T("prog.ui.tomorrow", describe(nextReward))
			end
			setText(reset, text)
			-- Spielzeit läuft lokal weiter (Server schickt sie nur alle 30 s)
			local played = num(daily.PlaySec, 0) + math.max(0, serverNow() - num(daily.PlayAt, serverNow()))
			local gifts = daily.Gifts or {}
			for i, cell in ipairs(giftCells) do
				local needed = cell.Minutes * 60
				local sub, color
				if gifts[tostring(i)] then
					sub, color = "✓ " .. T("prog.ui.claimed"), UI.Theme.Gray
				elseif played >= needed then
					sub, color = T("prog.ui.claim") .. "!", UI.Theme.Green
				else
					sub, color = formatTime(needed - played), UI.Theme.Blue
				end
				-- nur bei Änderung schreiben
				if cell.Sub ~= sub then
					cell.Sub = sub
					cell.Button.SetSub(sub)
				end
				if cell.Color ~= color then
					cell.Color = color
					cell.Button.SetColor(color)
				end
			end
		end
	end

	local function refresh()
		local login = state("Login")
		local daily = state("Daily")
		if login then
			local calDay = num(login.CalDay, 0)
			local nextDay = num(login.NextDay, 1)
			for day, cell in ipairs(calCells) do
				local claimedDay = (not login.CanClaim and day <= calDay) or (login.CanClaim and day < nextDay)
				local isNext = login.CanClaim and day == nextDay
				cell.Frame.BackgroundColor3 = if isNext
					then UI.Theme.Yellow:Lerp(UI.Theme.PanelLight, 0.4)
					elseif claimedDay then UI.Theme.Green:Lerp(UI.Theme.PanelLight, 0.5)
					else UI.Theme.PanelLight
				setText(cell.Day, (if claimedDay then "✓ " else "") .. T("prog.ui.day", day))
			end
			setVisible(loginButton.Frame, login.CanClaim == true)
			setText(streakLabel, T("prog.ui.streak", num(login.Streak, 0), num(login.Best, 0)))
		end
		if daily then
			local spins = num(daily.SpinsLeft, 0)
			spinButton.SetSub(T("prog.ui.spinsLeft", spins))
			spinButton.SetColor(if spins > 0 then UI.Theme.Orange else UI.Theme.Gray)
			setText(
				firstWin,
				if daily.FirstWinDone
					then "✓ " .. T("prog.ui.firstWinDone")
					else T("prog.ui.firstWin", P.FirstWin.Xp, P.FirstWin.Coins)
			)
		end
		tick()
	end
	return { Win = win, Refresh = refresh, Tick = tick }
end

-- ---------------------------------------------------------------------
-- 5) STATISTIK (Skill sichtbar machen), Erfolge, Gratis-Waffen-Wahl
-- ---------------------------------------------------------------------
local function ownedWeapons(): { [string]: boolean }
	-- WP9-State: "Weapons" = { Owned = {...} } oder "OwnedWeapons" = {...} (beides wird akzeptiert)
	local weapons = state("Weapons")
	if weapons and type(weapons.Owned) == "table" then
		return weapons.Owned
	end
	local owned = state("OwnedWeapons") or state("Owned")
	return owned or {}
end

local function buildStats(): View
	local win = newWindow("Stats", "prog.ui.statsTitle", UI.Theme.Cyan)
	local content = win.Content

	-- Gratis-Waffen-Wahl
	local pickHeader = UI.Section(content, T("prog.ui.pickTitle"), 1, UI.Theme.Gold)
	local pickGrid = UI.Grid(content, 2, 150, 56)
	local pickButtons: { [string]: any } = {}
	local list = Config.Weapons and Config.Weapons.List or {}
	for i, def in ipairs(list) do
		if not def.AdminOnly and def.Free ~= true then
			local key = def.Key
			pickButtons[key] = UI.Button({
				LayoutOrder = i,
				Parent = pickGrid,
				Size = UDim2.fromScale(1, 1),
				Text = pick(def.Name),
				Color = UI.Theme.Gold,
				MaxText = 16,
			}, function()
				request("ClaimLevelPick", key)
			end)
		end
	end

	UI.Section(content, T("prog.ui.overview"), 10)
	local overview = UI.Grid(content, 11, 196, 64)
	local tileKeys = {
		"Level",
		"KD",
		"Accuracy",
		"Headshot",
		"Elims",
		"Wins",
		"PvpWins",
		"BestStreak",
		"Matches",
		"CrownBest",
		"Honor",
		"Flick",
	}
	local tiles: { [string]: { Frame: Frame, Value: TextLabel } } = {}
	for i, key in ipairs(tileKeys) do
		local card = UI.Card({ LayoutOrder = i, Parent = overview })
		label(card, {
			Position = UDim2.fromOffset(8, 4),
			Size = UDim2.new(1, -16, 0, 22),
			Text = T("prog.stat." .. key),
			MaxText = 15,
			TextColor3 = UI.Theme.SubText,
		})
		local value = label(card, { Position = UDim2.fromOffset(8, 26), Size = UDim2.new(1, -16, 0, 32), MaxText = 24 })
		tiles[key] = { Frame = card, Value = value }
	end

	UI.Section(content, T("prog.ui.weapons"), 20)
	local weaponHeader = UI.Row(content, 21, 24)
	for i, key in ipairs({ "colWeapon", "colTier", "colPops", "colAccuracy", "colHeadshot" }) do
		label(weaponHeader, {
			Size = UDim2.new(if i == 1 then 0.32 else 0.16, -6, 1, 0),
			LayoutOrder = i,
			Text = T("prog.ui." .. key),
			MaxText = 14,
			TextColor3 = UI.Theme.SubText,
		})
	end
	type WeaponRow = { Frame: Frame, Cells: { TextLabel } }
	local weaponRows: { WeaponRow } = {}
	for i = 1, #list do
		local row = UI.Row(content, 21 + i, 28)
		local cells = {}
		for c = 1, 5 do
			cells[c] =
				label(row, { Size = UDim2.new(if c == 1 then 0.32 else 0.16, -6, 1, 0), LayoutOrder = c, MaxText = 16 })
		end
		row.Visible = false
		weaponRows[i] = { Frame = row, Cells = cells }
	end

	UI.Section(content, T("prog.ui.achievements"), 200)
	type AchRow = { Card: any, Id: string }
	local achRows: { AchRow } = {}
	local ids = {}
	for id, def in pairs(P.Achievements) do
		table.insert(ids, { Id = id, Order = num(def.Order, 99) })
	end
	table.sort(ids, function(a, b)
		return a.Order < b.Order
	end)
	for i, entry in ipairs(ids) do
		local card = questCard(content, 200 + i, false, function() end)
		setVisible(card.Claim.Frame, false)
		achRows[i] = { Card = card, Id = entry.Id }
	end
	local ranked = label(content, {
		Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = 300,
		MaxText = 14,
		TextWrapped = true,
		TextColor3 = UI.Theme.SubText,
	})
	ranked.Text = T("prog.ui.rankedSoon")

	local function refresh()
		local stats = state("Stats") or {}
		local honor = state("Honor") or {}
		-- Waffen-Wahl
		local picks = num(ctx.State.FreeWeaponPicks, 0)
		setVisible(pickHeader, picks > 0)
		setVisible(pickGrid, picks > 0)
		if picks > 0 then
			setText(pickHeader, T("prog.ui.pickTitle") .. (if picks > 1 then (" ×%d"):format(picks) else ""))
			local owned = ownedWeapons()
			for key, button in pairs(pickButtons) do
				setVisible(button.Frame, owned[key] ~= true)
			end
		end
		-- Übersicht
		local deaths = num(stats.Deaths, 0)
		local elims = num(stats.Elims, 0)
		local values: { [string]: string } = {
			Level = tostring(num(ctx.State.Level, 1)),
			KD = if deaths > 0 then ("%.2f"):format(elims / deaths) else fmt(elims),
			Accuracy = percent(num(stats.ShotsHit, 0), num(stats.ShotsFired, 0)),
			Headshot = percent(num(stats.Headshots, 0), elims),
			Wins = fmt(num(stats.Wins, 0)),
			PvpWins = fmt(num(stats.PvpWins, 0)),
			BestStreak = fmt(num(stats.BestStreak, 0)),
			Matches = fmt(num(stats.Matches, 0)),
			CrownBest = fmt(num(stats.CrownBest, 0)),
			Honor = ("%s 👍"):format(fmt(num(honor.Commends, 0)))
				.. (if num(honor.Badge, 0) > 0 then " " .. string.rep("🏅", num(honor.Badge, 0)) else ""),
			Flick = if num(stats.FlickBest, 0) > 0 then fmt(num(stats.FlickBest, 0)) else "–",
			Elims = fmt(elims),
		}
		for key, tile in pairs(tiles) do
			setText(tile.Value, values[key] or "–")
		end
		-- pro Waffe (nach Pops sortiert)
		local mastery = state("Mastery") or {}
		local entries = {}
		for key, entry in pairs(mastery) do
			if type(entry) == "table" and Config.Weapon(key) then
				table.insert(entries, { Key = key, E = entry })
			end
		end
		table.sort(entries, function(a, b)
			return num(a.E.K, 0) > num(b.E.K, 0)
		end)
		for i, row in ipairs(weaponRows) do
			local item = entries[i]
			setVisible(row.Frame, item ~= nil)
			if item then
				local e = item.E
				local tier = ProgressMath.MasteryTier(num(e.K, 0))
				local goal = ProgressMath.MasteryGoal(tier)
				setText(row.Cells[1], weaponName(item.Key))
				setText(
					row.Cells[2],
					(if tier > 0 then ROMAN[tier] else "–")
						.. (if goal then (" (%d/%d)"):format(math.floor(num(e.K, 0)), goal) else " ★")
				)
				setText(row.Cells[3], fmt(num(e.Pops, 0)))
				setText(row.Cells[4], percent(num(e.Hits, 0), num(e.Shots, 0)))
				setText(row.Cells[5], percent(num(e.HeadPops, 0), num(e.Pops, 0)))
			end
		end
		-- Erfolge
		local achievements = state("Achievements") or {}
		for _, row in ipairs(achRows) do
			local def = P.Achievements[row.Id]
			local a = achievements[row.Id] or {}
			showQuest(
				row.Card,
				(if a.Done then "🏆 " else "") .. pick(def.Name) .. " – " .. pick(def.Desc),
				describe(def.Reward),
				if a.Done then num(def.Goal, 1) else num(a.P, 0),
				num(def.Goal, 1),
				a.Done == true
			)
			setVisible(row.Card.Claim.Frame, false)
		end
	end
	return { Win = win, Refresh = refresh }
end

-- ---------------------------------------------------------------------
-- 6) ÖFFNEN, HUD-ABZEICHEN, LEVEL-UP-KARTE
-- ---------------------------------------------------------------------
local BUILDERS: { [string]: () -> View } = {
	Quests = buildQuests,
	Pass = buildPass,
	Daily = buildDaily,
	Stats = buildStats,
}

local function viewOf(name: string): View?
	local view = views[name]
	if view then
		return view
	end
	local builder = BUILDERS[name]
	if not builder then
		return nil
	end
	local ok, result = pcall(builder)
	if not ok then
		warn("[Progress] Fenster " .. name .. " bauen: " .. tostring(result))
		return nil
	end
	views[name] = result
	return result
end

local function refreshView(view: View)
	local ok, err = pcall(view.Refresh)
	if not ok then
		warn("[Progress] Aktualisieren: " .. tostring(err))
	end
end

-- Wird von ctx.Windows.Open(name) aufgerufen (registriert in Init)
local function openWindow(name: string)
	local view = viewOf(name)
	if not view then
		return
	end
	refreshView(view)
	UI.OpenWindow(view.Win)
end

function Progress.Open(tab: string) -- "Quests" | "Pass" | "Daily" | "Stats"
	local name = if BUILDERS[tab] then tab else "Quests"
	if ctx and ctx.Windows then
		ctx.Windows.Open(name)
	end
end

local function claimableQuests(): number
	local quests = state("Quests")
	if not quests then
		return 0
	end
	local count = 0
	for _, listName in ipairs({ "Daily", "Weekly" }) do
		for _, q in ipairs(quests[listName] or {}) do
			if not q.Claimed and num(q.P, 0) >= num(q.Goal, 1) then
				count += 1
			end
		end
	end
	local b = quests.Beginner
	if type(b) == "table" and not b.Done and num(b.P, 0) >= num(b.Goal, 1) then
		count += 1
	end
	return count
end

local function claimablePass(): number
	local pass = state("Pass")
	local cfg = activeSeasonConfig()
	if not pass or not cfg then
		return 0
	end
	local count = 0
	for tier = 1, num(pass.Tier, 0) do
		local key = tostring(tier)
		if cfg.Free and cfg.Free[key] and not (pass.Free and pass.Free[key]) then
			count += 1
		end
		if pass.Premium and cfg.Premium and cfg.Premium[key] and not (pass.Prem and pass.Prem[key]) then
			count += 1
		end
	end
	return count
end

local function claimableDaily(): number
	local count = 0
	local login = state("Login")
	if login and login.CanClaim then
		count += 1
	end
	local daily = state("Daily")
	if daily then
		count += math.max(0, num(daily.SpinsLeft, 0))
		local played = num(daily.PlaySec, 0) + math.max(0, serverNow() - num(daily.PlayAt, serverNow()))
		for i, minutes in ipairs(P.Playtime.Minutes) do
			if played >= minutes * 60 and not (daily.Gifts and daily.Gifts[tostring(i)]) then
				count += 1
			end
		end
	end
	return count
end

local function refreshBadges()
	local counts = {
		Quests = claimableQuests(),
		Pass = claimablePass(),
		Daily = claimableDaily(),
		Stats = num(ctx.State.FreeWeaponPicks, 0),
	}
	for name, badge in pairs(hudBadges) do
		local n = counts[name] or 0
		UI.SetBadge(badge, if n > 0 then tostring(n) else nil)
	end
end

local function addHudButtons()
	local hud = ctx.Modules.Hud
	if not hud or type(hud.AddRightButton) ~= "function" then
		return
	end
	local specs = {
		{ Name = "Quests", Icon = "📜", Key = "prog.hud.quests", Color = UI.Theme.Orange, Order = 30 },
		{ Name = "Daily", Icon = "🎁", Key = "prog.hud.daily", Color = UI.Theme.Green, Order = 31 },
		{ Name = "Pass", Icon = "🎟️", Key = "prog.hud.pass", Color = UI.Theme.Pink, Order = 32 },
		{ Name = "Stats", Icon = "📊", Key = "prog.hud.stats", Color = UI.Theme.Cyan, Order = 33 },
	}
	for _, spec in ipairs(specs) do
		local ok, button = pcall(hud.AddRightButton, spec.Icon, spec.Key, spec.Color, spec.Order, function()
			Progress.Open(spec.Name)
		end)
		if ok and type(button) == "table" and button.Frame then
			hudButtons[spec.Name] = button
			local okBadge, badge = pcall(UI.Badge, button, nil)
			if okBadge and badge then
				hudBadges[spec.Name] = badge
			end
		end
	end
end

-- Level-Up-Karte (oben Mitte, 4.5 s): Level, Belohnungen, Hinweis auf Gratis-Waffen-Wahl
local function showLevelCard(data: any)
	if type(data) ~= "table" or not ctx.Gui then
		return
	end
	local card = levelCard
	if not card then
		local frame = UI.Card({
			Name = "LevelUpCard",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 110),
			Size = UDim2.fromOffset(420, 120),
			BackgroundColor3 = UI.Theme.PanelDark,
			Visible = false,
			ZIndex = 50,
			Parent = ctx.Gui,
		})
		UI.Create("UIScale", { Name = "Scale", Parent = frame })
		label(frame, {
			Name = "Title",
			Position = UDim2.fromOffset(12, 8),
			Size = UDim2.new(1, -24, 0, 44),
			MaxText = 40,
			Outline = 3,
			ZIndex = 51,
			TextColor3 = UI.Theme.Yellow,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		label(frame, {
			Name = "Rewards",
			Position = UDim2.fromOffset(12, 54),
			Size = UDim2.new(1, -24, 0, 28),
			MaxText = 20,
			ZIndex = 51,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		label(frame, {
			Name = "Pick",
			Position = UDim2.fromOffset(12, 84),
			Size = UDim2.new(1, -24, 0, 26),
			MaxText = 18,
			ZIndex = 51,
			TextColor3 = UI.Theme.Cash,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		levelCard = frame
		card = frame
	end
	local frame = card :: Frame
	local title = frame:FindFirstChild("Title") :: TextLabel
	local rewards = frame:FindFirstChild("Rewards") :: TextLabel
	local pickLabel = frame:FindFirstChild("Pick") :: TextLabel
	local scale = frame:FindFirstChild("Scale") :: UIScale
	title.Text = T("prog.ui.levelUp", num(data.Level, 1))
	rewards.Text = describe(data.Rewards)
	local picks = if type(data.Rewards) == "table" then num(data.Rewards.FreeWeaponPicks, 0) else 0
	pickLabel.Text = if picks > 0 then T("prog.freePick") else ""
	frame.Visible = true
	scale.Scale = 0.5
	TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()
	levelCardToken += 1
	local token = levelCardToken
	task.delay(LEVEL_CARD_TIME, function()
		if levelCardToken == token and levelCard then
			levelCard.Visible = false
		end
	end)
end

local function onState(_state: any, changed: any)
	if type(changed) ~= "table" then
		return
	end
	local mine = changed.Full == true
	if not mine then
		for _, key in ipairs(MY_KEYS) do
			if changed[key] then
				mine = true
				break
			end
		end
	end
	if not mine then
		return
	end
	refreshBadges()
	for name, view in pairs(views) do
		if ctx.Windows.IsOpen(name) then
			refreshView(view)
		end
	end
end

-- 1-s-Takt nur für Countdown-Texte offener Fenster (und Abzeichen der Spielzeit-Geschenke)
local function onHeartbeat(dt: number)
	tickAcc += dt
	if tickAcc < 1 then
		return
	end
	tickAcc = 0
	for name, view in pairs(views) do
		if view.Tick and ctx.Windows.IsOpen(name) then
			local ok, err = pcall(view.Tick)
			if not ok then
				warn("[Progress] Takt: " .. tostring(err))
			end
		end
	end
	refreshBadges()
end

-- ---------------------------------------------------------------------
-- 7) INIT / START
-- ---------------------------------------------------------------------
function Progress.Init(context: any)
	ctx = context
	UI = ctx.UI
	Config = ctx.Config
	P = Config.Progression
	for _, name in ipairs(TABS) do
		ctx.Windows.Register(name, function()
			openWindow(name)
		end)
	end
end

function Progress.Start()
	addHudButtons()
	ctx.Hooks.On("State", onState)
	ctx.Hooks.On("Effect:LevelUp", function(_strength: number, data: any)
		showLevelCard(data)
	end)
	RunService.Heartbeat:Connect(onHeartbeat)
	refreshBadges()
	-- Spieler, der den Client neu lädt: offene Gratis-Waffen-Wahl erwähnen
	if Players.LocalPlayer and num(ctx.State.FreeWeaponPicks, 0) > 0 then
		ctx.Toast(T("prog.freePick"), "Event")
	end
end

return Progress
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">QueueUI</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – PLAY-Menü, Warteschlangen-Anzeige, Pad-Schilder (Client/Modules/QueueUI)
--  Besitzer: WP5 (Match-UI). Vertrag: DESIGN.md C7.3 (Fenster "Play"), C7.4 (QueueUI.OpenPlay), B3.2, B3.3.
--
--  - Fenster "Play": Duell 1v1/2v2/3v3/4v4, Mutator des Tages, FFA-Brawl, Krone herausfordern, Training (Teleport),
--    Gegen Bots üben (Schwierigkeit wählen). Jeder Eintrag zeigt "N suchen" (State.Queue.Counts).
--    Auswahl = Request("QueueJoin", { Mode, Input }) (Eingabegruppe fürs Matchmaking, B3.1).
--  - Such-Leiste unten Mitte: Modus, "N suchen", "BOT KOMMT IN 6", "Arenen voll …", Knöpfe BOTS JETZT / Abbrechen;
--    Krone: Platz in der Herausforderer-Linie bzw. "Du bist König".
--  - Pad-Schilder: lokalisierte BillboardGui je Pad aus den Pad-Attributen (Mode, NeedA/B, CountA/B, BotAt,
--    Searching, Phase) + halbtransparente Hologramm-Bots auf freien Sitzen, solange ein Bot-Timer läuft.
--  - Bot-Duell-Kabine: Server-Prompts (Tag "CCPracticePrompt") werden hier lokalisiert.
--
--  Öffentliche API (C7.4): QueueUI.OpenPlay()   (+ QueueUI.Init(ctx), QueueUI.Start())
-- =====================================================================

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local UI = require(script.Parent:WaitForChild("UI"))

local QueueUI = {}

local player = Players.LocalPlayer
local ctx: any = nil

local REFRESH = 0.25 -- Anzeige 4 Hz
local PAD_SCAN_EVERY = 3
local PAD_SCAN_TRIES = 12
local GHOST_POOL = 16
local BILLBOARD_DISTANCE = 140
local PRACTICE_PROMPT_TAG = "CCPracticePrompt"
local DIFFICULTIES = { "Rookie", "Easy", "Normal", "Hard", "Insane" }
local DUEL_MODES = { "Duel1", "Duel2", "Duel3", "Duel4" }

type PadView = {
	Part: BasePart,
	Gui: BillboardGui,
	Title: TextLabel,
	Counts: TextLabel,
	Status: TextLabel,
	Searching: TextLabel,
}

local window: any = nil
local modeButtons: { [string]: any } = {}
local cancelRow: Frame? = nil
local mutatorButton: any = nil
local statusBar: Frame? = nil
local statusTitle: TextLabel? = nil
local statusLine: TextLabel? = nil
local botsNowButton: any = nil
local padViews: { PadView } = {}
local padFolder: Folder? = nil
local ghostPool: { Model } = {}
local ghostFolder: Folder? = nil
local padScanTries = 0
local padScanAt = 0
local accum = 0
local inMatch = false

local function T(key: string, ...: any): string
	return if ctx then ctx.T(key, ...) else key
end

local function pick(t: any): string
	if type(t) ~= "table" then
		return tostring(t or "")
	end
	return ctx.Lang.Pick(ctx.Lang_(), t)
end

local function modesCfg(): any
	return ctx.Config.Modes or {}
end

local function modeName(key: string): string
	local def = modesCfg().Modes and modesCfg().Modes[key]
	return if def then pick(def.Name) else key
end

local function queueState(): any
	local state = ctx.State and ctx.State.Queue
	return if type(state) == "table" then state else {}
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function request(action: string, arg: any?, after: ((any) -> ())?)
	task.spawn(function()
		local result = ctx.Request(action, arg)
		if after then
			after(result)
		end
	end)
end

local function inputKind(): string
	local controls = ctx.Modules and ctx.Modules.Controls
	if controls and type(controls.Input) == "function" then
		local ok, kind = pcall(controls.Input)
		if ok and type(kind) == "string" then
			return kind
		end
	end
	return "KBM"
end

local function joinMode(mode: string)
	request("QueueJoin", { Mode = mode, Input = inputKind() }, function(result)
		if result ~= nil then
			ctx.Windows.Close("Play")
		end
	end)
end

-- ---------------------------------------------------------------------
-- 1) PLAY-FENSTER
-- ---------------------------------------------------------------------
local function searchingText(mode: string): string
	local counts = queueState().Counts
	local n = if type(counts) == "table" then tonumber(counts[mode]) or 0 else 0
	return T("match.searching", n)
end

local function mutatorKey(): string?
	local key = ctx.State and ctx.State.Mutator
	return if type(key) == "string" then key else nil
end

local function refreshWindow()
	if not window then
		return
	end
	for mode, button in pairs(modeButtons) do
		if mode == "Crown" then
			local crown = queueState().Crown
			local king = type(crown) == "table" and crown.King or ""
			button.SetSub(if king ~= "" then T("match.play.kingIs", king) else T("match.play.noKing"))
		elseif mode ~= "Training" then
			button.SetSub(searchingText(mode))
		end
	end
	if mutatorButton then
		local key = mutatorKey()
		local def = key and modesCfg().Mutators and modesCfg().Mutators[key]
		mutatorButton.SetText(if def then pick(def.Name) else modeName("Mutator"))
	end
	local row = cancelRow
	if row then
		local q = queueState()
		local crown = q.Crown
		row.Visible = q.Mode ~= nil or (type(crown) == "table" and (tonumber(crown.Line) or 0) > 0)
	end
end

local function buildWindow()
	local theme = UI.Theme
	window = UI.Window(T("match.play.title"), 620, 580, theme.Yellow)
	local content = window.Content

	UI.Section(content, T("match.play.duels"), 1, theme.Green)
	local duels = UI.Grid(content, 2, 132, 78)
	for i, mode in ipairs(DUEL_MODES) do
		modeButtons[mode] = UI.Button({
			LayoutOrder = i,
			Parent = duels,
			Size = UDim2.fromOffset(132, 78),
			Text = modeName(mode),
			Sub = searchingText(mode),
			Color = if i == 1
				then theme.Green
				elseif i == 2 then theme.Blue
				elseif i == 3 then theme.Purple
				else theme.Red,
			MaxText = 22,
		}, function()
			joinMode(mode)
		end)
	end

	UI.Section(content, T("match.play.special"), 3, theme.Pink)
	local special = UI.Grid(content, 4, 132, 78)
	mutatorButton = UI.Button({
		LayoutOrder = 1,
		Parent = special,
		Size = UDim2.fromOffset(132, 78),
		Text = modeName("Mutator"),
		Sub = searchingText("Mutator"),
		Color = theme.Yellow,
		MaxText = 20,
	}, function()
		joinMode("Mutator")
	end)
	modeButtons.Mutator = mutatorButton
	modeButtons.FFA = UI.Button({
		LayoutOrder = 2,
		Parent = special,
		Size = UDim2.fromOffset(132, 78),
		Text = modeName("FFA"),
		Sub = searchingText("FFA"),
		Color = theme.Pink,
		MaxText = 20,
	}, function()
		joinMode("FFA")
	end)
	modeButtons.Crown = UI.Button({
		LayoutOrder = 3,
		Parent = special,
		Size = UDim2.fromOffset(132, 78),
		Text = T("match.play.crown"),
		Sub = T("match.play.noKing"),
		Color = theme.Gold,
		MaxText = 20,
	}, function()
		request("CrownJoin", nil, function(result)
			if result ~= nil then
				ctx.Windows.Close("Play")
			end
		end)
	end)
	modeButtons.Training = UI.Button({
		LayoutOrder = 4,
		Parent = special,
		Size = UDim2.fromOffset(132, 78),
		Text = T("match.play.training"),
		Sub = T("match.play.trainingSub"),
		Color = theme.Cyan,
		MaxText = 20,
	}, function()
		request("GoRange", nil, function(result)
			if result ~= nil then
				ctx.Windows.Close("Play")
			end
		end)
	end)

	UI.Section(content, T("match.play.practice"), 5, theme.Orange)
	local bots = UI.Grid(content, 6, 104, 56)
	for i, diff in ipairs(DIFFICULTIES) do
		UI.Button({
			LayoutOrder = i,
			Parent = bots,
			Size = UDim2.fromOffset(104, 56),
			Text = T("bot.diff." .. diff),
			Color = if i <= 2
				then theme.Green
				elseif i == 3 then theme.Blue
				elseif i == 4 then theme.Orange
				else theme.Red,
			MaxText = 18,
		}, function()
			request("PracticeStart", diff, function(result)
				if result ~= nil then
					ctx.Windows.Close("Play")
				end
			end)
		end)
	end

	local row = UI.Row(content, 7, 54)
	UI.Button({
		Parent = row,
		Size = UDim2.fromOffset(260, 50),
		Text = T("match.queue.cancel"),
		Color = theme.Red,
		MaxText = 20,
	}, function()
		request("QueueLeave")
		request("CrownLeave")
	end)
	cancelRow = row
	refreshWindow()

	ctx.Windows.Register("Play", function()
		refreshWindow()
		UI.OpenWindow(window)
	end, function()
		UI.CloseWindow(window)
	end)
end

function QueueUI.OpenPlay()
	if inMatch then
		return
	end
	ctx.Windows.Open("Play")
end

-- ---------------------------------------------------------------------
-- 2) SUCH-LEISTE (unten Mitte)
-- ---------------------------------------------------------------------
local function buildStatusBar()
	local theme = UI.Theme
	local bar = UI.Create("Frame", {
		Name = "QueueStatus",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -150),
		Size = UDim2.fromOffset(520, 76),
		BackgroundColor3 = theme.PanelDark,
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 12,
		Parent = ctx.Gui,
	}, { UI.Corner(14), UI.Stroke(theme.Black, 3) })
	statusTitle = UI.Label({
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -230, 0, 34),
		Text = "",
		MaxText = 24,
		Outline = 3,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 13,
		Parent = bar,
	})
	statusLine = UI.Label({
		Position = UDim2.fromOffset(12, 40),
		Size = UDim2.new(1, -230, 0, 28),
		Text = "",
		MaxText = 18,
		Outline = 2,
		TextColor3 = theme.Yellow,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 13,
		Parent = bar,
	})
	botsNowButton = UI.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -66, 0.5, 0),
		Size = UDim2.fromOffset(150, 54),
		Text = T("match.queue.botsNow"),
		Color = theme.Orange,
		MaxText = 18,
		ZIndex = 13,
		Parent = bar,
	}, function()
		request("FillBots")
	end)
	UI.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(52, 54),
		Text = "✕",
		Color = theme.Red,
		MaxText = 24,
		ZIndex = 13,
		Parent = bar,
	}, function()
		local q = queueState()
		local crown = q.Crown
		if q.Mode then
			request("QueueLeave")
		elseif type(crown) == "table" and (crown.IsKing or (tonumber(crown.Line) or 0) > 0) then
			request("CrownLeave")
		end
	end)
	statusBar = bar
end

local function setText(label: TextLabel?, text: string)
	if label and label.Text ~= text then
		label.Text = text
	end
end

local function refreshStatus()
	local bar = statusBar
	if not bar then
		return
	end
	local q = queueState()
	local crown = q.Crown
	local line = if type(crown) == "table" then tonumber(crown.Line) or 0 else 0
	local isKing = type(crown) == "table" and crown.IsKing == true
	local visible = not inMatch and (q.Mode ~= nil or line > 0 or isKing)
	if bar.Visible ~= visible then
		bar.Visible = visible
	end
	if not visible then
		return
	end
	local t = serverNow()
	if q.Mode then
		setText(statusTitle, T("match.queue.status", modeName(q.Mode)))
		local parts = { T("match.searching", tonumber(q.Searching) or 0) }
		if q.Held == "Arenas" then
			table.insert(parts, T("match.arenasFull"))
		elseif q.Held == "Bots" then
			table.insert(parts, T("match.botsBusy"))
		elseif type(q.BotAt) == "number" then
			local left = math.max(0, math.ceil(q.BotAt - t))
			table.insert(parts, if left > 0 then T("match.botIn", left) else T("match.queue.forming"))
		end
		setText(statusLine, table.concat(parts, "  ·  "))
		local canFill = type(q.FillAt) == "number" and t >= q.FillAt
		local botSoon = type(q.BotAt) == "number" and q.BotAt - t > 0.5
		if botsNowButton then
			botsNowButton.Frame.Visible = canFill and botSoon and q.Held == nil
		end
	elseif isKing then
		setText(statusTitle, T("match.queue.king"))
		setText(statusLine, T("match.queue.kingStreak", tonumber(crown.Streak) or 0))
		if botsNowButton then
			botsNowButton.Frame.Visible = false
		end
	else
		setText(statusTitle, T("match.queue.crownLine", line, tonumber(crown.LineSize) or line))
		local king = tostring(crown.King or "")
		setText(statusLine, if king ~= "" then T("match.play.kingIs", king) else T("match.play.noKing"))
		if botsNowButton then
			botsNowButton.Frame.Visible = false
		end
	end
end

-- ---------------------------------------------------------------------
-- 3) PAD-SCHILDER + HOLOGRAMM-BOTS
-- ---------------------------------------------------------------------
local function makeLabel(parent: Instance, y: number, h: number, maxText: number, color: Color3?): TextLabel
	return UI.Label({
		Position = UDim2.fromScale(0, y),
		Size = UDim2.fromScale(1, h),
		Text = "",
		MaxText = maxText,
		Outline = 3,
		TextColor3 = color or Color3.new(1, 1, 1),
		Parent = parent,
	})
end

local function addPad(part: BasePart)
	for _, view in ipairs(padViews) do
		if view.Part == part then
			return
		end
	end
	local folder = padFolder
	if not folder then
		return
	end
	local gui = UI.Create("BillboardGui", {
		Name = "Pad" .. tostring(part:GetAttribute("PadId")),
		Adornee = part,
		Size = UDim2.fromOffset(280, 120),
		StudsOffsetWorldSpace = Vector3.new(0, 7, 0),
		MaxDistance = BILLBOARD_DISTANCE,
		LightInfluence = 0,
		AlwaysOnTop = false,
		ResetOnSpawn = false,
		Parent = folder,
	})
	table.insert(padViews, {
		Part = part,
		Gui = gui,
		Title = makeLabel(gui, 0, 0.3, 30, UI.Theme.Yellow),
		Counts = makeLabel(gui, 0.3, 0.26, 26),
		Status = makeLabel(gui, 0.56, 0.24, 22, UI.Theme.Cyan),
		Searching = makeLabel(gui, 0.8, 0.2, 18, UI.Theme.SubText),
	})
end

local function scanPads()
	local found = 0
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("BasePart") and inst:GetAttribute("PadId") ~= nil and inst:GetAttribute("Mode") ~= nil then
			addPad(inst)
			found += 1
		end
	end
	return found
end

local function seatOffsets(mode: string, part: BasePart): { { Side: string, Offset: Vector3 } }
	local list = {}
	local def = modesCfg().Modes and modesCfg().Modes[mode]
	if not def then
		return list
	end
	local top = part.Size.Y / 2 + 2.6
	if def.Ruleset == "Respawn" then
		local n = def.MaxPlayers or 8
		for i = 1, n do
			local angle = (i - 1) / n * math.pi * 2
			table.insert(list, { Side = "A", Offset = Vector3.new(math.cos(angle) * 4, top, math.sin(angle) * 4) })
		end
		return list
	end
	local size = def.TeamSize or 1
	local zs = if size == 1
		then { 0 }
		elseif size == 2 then { -2, 2 }
		elseif size == 3 then { -3.5, 0, 3.5 }
		else { -4.5, -1.5, 1.5, 4.5 }
	for _, side in ipairs({ "A", "B" }) do
		local x = if side == "A" then -5 else 5
		for i = 1, math.min(size, #zs) do
			table.insert(list, { Side = side, Offset = Vector3.new(x, top, zs[i]) })
		end
	end
	return list
end

local function newGhost(): Model
	local model = Instance.new("Model")
	model.Name = "QueueGhost"
	local function part(name: string, shape: Enum.PartType, size: Vector3, offset: Vector3): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Shape = shape
		p.Size = size
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		p.Color = UI.Theme.Cyan
		p.Transparency = 0.65
		p:SetAttribute("Offset", offset)
		p.Parent = model
		return p
	end
	local body = part("Body", Enum.PartType.Block, Vector3.new(1.8, 2.4, 1), Vector3.new(0, 0, 0))
	part("Head", Enum.PartType.Ball, Vector3.new(1.4, 1.4, 1.4), Vector3.new(0, 1.95, 0))
	part("Base", Enum.PartType.Cylinder, Vector3.new(0.2, 2.6, 2.6), Vector3.new(0, -1.5, 0))
	model.PrimaryPart = body
	return model
end

local function placeGhost(ghost: Model, cf: CFrame)
	for _, p in ipairs(ghost:GetChildren()) do
		if p:IsA("BasePart") then
			local offset = p:GetAttribute("Offset")
			local o = if typeof(offset) == "Vector3" then offset else Vector3.zero
			local rot = if p.Name == "Base" then CFrame.Angles(0, 0, math.rad(90)) else CFrame.identity
			p.CFrame = cf * CFrame.new(o) * rot
		end
	end
end

local function occupied(world: Vector3): boolean
	for _, p in ipairs(Players:GetPlayers()) do
		local char = p.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local d = Vector3.new(root.Position.X - world.X, 0, root.Position.Z - world.Z)
			if d.Magnitude <= 2.4 and math.abs(root.Position.Y - world.Y) < 6 then
				return true
			end
		end
	end
	return false
end

local function refreshPads()
	local t = serverNow()
	local ghostIndex = 0
	local folder = ghostFolder
	for _, view in ipairs(padViews) do
		local part = view.Part
		if part.Parent then
			local mode = tostring(part:GetAttribute("Mode") or "")
			local phase = tostring(part:GetAttribute("Phase") or "Idle")
			local countA = tonumber(part:GetAttribute("CountA")) or 0
			local countB = tonumber(part:GetAttribute("CountB")) or 0
			local needA = tonumber(part:GetAttribute("NeedA")) or 0
			local needB = tonumber(part:GetAttribute("NeedB")) or 0
			local botAt = tonumber(part:GetAttribute("BotAt")) or 0
			local searching = tonumber(part:GetAttribute("Searching")) or 0
			local def = modesCfg().Modes and modesCfg().Modes[mode]
			local ffa = def ~= nil and def.Ruleset == "Respawn"
			setText(view.Title, UI.Upper(modeName(mode)))
			if ffa then
				setText(view.Counts, ("%d / %d"):format(countA, countA + needA))
			else
				setText(
					view.Counts,
					("%d/%d  %s  %d/%d"):format(countA, countA + needA, T("match.pad.vs"), countB, countB + needB)
				)
			end
			local status
			if phase == "Vote" then
				status = T("match.pad.vote")
			elseif phase == "Full" then
				status = T("match.pad.full")
			elseif phase == "Held" then
				status = T("match.arenasFull")
			elseif phase == "Waiting" then
				local left = math.ceil(botAt - t)
				status = if botAt > 0 and left > 0 then T("match.botIn", left) else T("match.queue.forming")
			else
				status = T("match.pad.idle")
			end
			setText(view.Status, status)
			setText(view.Searching, T("match.searching", searching))
			-- Hologramm-Bots auf freien Sitzen, solange ein Bot-Timer läuft
			if folder and phase == "Waiting" and botAt > 0 then
				for _, seat in ipairs(seatOffsets(mode, part)) do
					local cf = part.CFrame * CFrame.new(seat.Offset)
					local need = if seat.Side == "A" then needA else needB
					if need > 0 and not occupied(cf.Position) and ghostIndex < GHOST_POOL then
						ghostIndex += 1
						local ghost = ghostPool[ghostIndex]
						if not ghost then
							ghost = newGhost()
							ghostPool[ghostIndex] = ghost
						end
						placeGhost(ghost, CFrame.new(cf.Position))
						if ghost.Parent ~= folder then
							ghost.Parent = folder
						end
					end
				end
			end
		end
	end
	for i = ghostIndex + 1, #ghostPool do
		local ghost = ghostPool[i]
		if ghost.Parent ~= nil then
			ghost.Parent = nil
		end
	end
end

-- ---------------------------------------------------------------------
-- 4) BOT-DUELL-KABINE (Prompts lokalisieren)
-- ---------------------------------------------------------------------
local function localizePrompt(inst: Instance)
	if not inst:IsA("ProximityPrompt") then
		return
	end
	local diff = inst:GetAttribute("PracticeDifficulty")
	if type(diff) ~= "string" then
		return
	end
	inst.ActionText = T("match.practice.action")
	inst.ObjectText = T("match.practice.object", T("bot.diff." .. diff))
end

local function relabelAll()
	for _, inst in ipairs(CollectionService:GetTagged(PRACTICE_PROMPT_TAG)) do
		localizePrompt(inst)
	end
end

-- ---------------------------------------------------------------------
-- 5) INIT / START
-- ---------------------------------------------------------------------
local function step(dt: number)
	accum += dt
	if accum < REFRESH then
		return
	end
	accum = 0
	refreshStatus()
	if #padViews == 0 or padScanTries < PAD_SCAN_TRIES then
		local now = os.clock()
		if now >= padScanAt and padScanTries < PAD_SCAN_TRIES then
			padScanAt = now + PAD_SCAN_EVERY
			padScanTries += 1
			if scanPads() >= 9 then
				padScanTries = PAD_SCAN_TRIES -- alle 9 Pads gefunden
			end
		end
	end
	refreshPads()
end

function QueueUI.Init(context: any)
	ctx = context
	local playerGui = player:WaitForChild("PlayerGui")
	local folder = Instance.new("Folder")
	folder.Name = "ClutchClashPads"
	folder.Parent = playerGui
	padFolder = folder
	local ghosts = Instance.new("Folder")
	ghosts.Name = "ClutchClashQueueGhosts"
	ghosts.Parent = workspace
	ghostFolder = ghosts
	buildWindow()
	buildStatusBar()
end

function QueueUI.Start()
	local hooks = ctx.Hooks
	hooks.On("State", function(_state, changed)
		if type(changed) ~= "table" then
			return
		end
		if changed.Queue or changed.Mutator or changed.Full then
			refreshWindow()
			refreshStatus()
		end
		if changed.Settings then
			relabelAll()
		end
	end)
	hooks.On("Effect:Mutator", function()
		refreshWindow()
	end)
	hooks.On("Settings", relabelAll)
	hooks.On("Match:Found", function()
		inMatch = true
		ctx.Windows.Close("Play")
		refreshStatus()
	end)
	hooks.On("Match:Start", function()
		inMatch = true
		ctx.Windows.Close("Play")
		refreshStatus()
	end)
	hooks.On("Match:Closed", function()
		inMatch = false
		refreshStatus()
	end)
	CollectionService:GetInstanceAddedSignal(PRACTICE_PROMPT_TAG):Connect(localizePrompt)
	relabelAll()
	RunService.Heartbeat:Connect(step)
end

return QueueUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">Replication</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Blick-Replikation & 3rd-Person-Darstellung (Client/Modules/Replication)
--  Besitzer: WP4 (Kampf Client). Vertrag: DESIGN.md B14.8 (Client-Teil), C8 (Look/LookBatch), B11.1 (Zielfernrohr-Glanz).
--    Senden:     Look (UnreliableRemoteEvent, 4 Byte über Net.EncodeLook) mit ≤ 12 Hz, nur bei Pitch-Änderung > 1°
--                oder geänderten Flags, nur bewaffnet und nicht gepoppt.
--    Empfangen:  LookBatch (10 Hz pro Kontext) -> Neck-C0 (×0.5) und Waist-C0 (×0.15) der anderen (R15/R6),
--                weich nachgeführt, nur lokal (C0 wird nie vom Animator überschrieben).
--    Flags anderer: Nachladen kippt die Waffen-Schweißung lokal (sonst Schulter), Schwung dreht die Schulter,
--                Rutschen -> Staub, ADS mit Fernschuss -> Zielfernrohr-Glanz nach ScopeGlintAfter s (nur Gegner).
--    Eigener Character: toolnone 507768375 (Looped, Priority Action) solange bewaffnet.
--    BigHead-Bälle: Combatant-Modelle mit Attribut BigHead bekommen lokal eine große Kopf-Kugel.
--  Slot -> Combatant: Roster aus Match("Start"); sonst Attribut "Slot" am Modell (Range).
--
--  Öffentliche API (C7.4):
--    Replication.Flags(): number     aktuelle Net.LookFlags des lokalen Spielers
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local Replication = {}

local player = Players.LocalPlayer
local ctx: any = nil

type Motors = { Neck: Motor6D?, Waist: Motor6D?, Shoulder: Motor6D? }
type Entry = {
	Slot: number,
	Model: Model?,
	Motors: Motors?,
	Pitch: number,
	Shown: number,
	AppliedPitch: number,
	Flags: number,
	AdsSince: number,
	SwingStart: number,
	Reload: number,
	AppliedArm: number,
	NextResolve: number,
	Glint: BillboardGui?,
	Dust: ParticleEmitter?,
	WeaponJoint: JointInstance?,
	JointTilted: boolean,
	WeaponScan: number,
}

-- ---------------------------------------------------------------------
-- 1) KONSTANTEN
-- ---------------------------------------------------------------------
local SEND_INTERVAL = 1 / 12
local NECK_MULT = 0.5
local WAIST_MULT = 0.15
local MAX_ENTRIES = 32
local CULL_DISTANCE = 250
local SWING_TIME = 0.3
local TOOLNONE_ID = "rbxassetid://507768375"
local GLOW_TEXTURE = "rbxasset://textures/glow.png"
local DUST_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"
local FLAGS = Net.LookFlags

-- ---------------------------------------------------------------------
-- 2) ZUSTAND
-- ---------------------------------------------------------------------
local remotes: { [string]: Instance } = {}
local armed = false
local popped = false
local sendAccum = 0
local lastSentPitch = 1000
local lastSentFlags = -1
local seq = 0
local lastBatchSeq = -1

local entries: { [number]: Entry } = {}
local slotToId: { [number]: number } = {}
local idTeam: { [number]: number } = {}
local myTeam = 0
local origC0: { [Instance]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
local bigBalls: { [Model]: BasePart } = setmetatable({}, { __mode = "k" }) :: any
local bigHeadAccum = 0

local holdAnimation = Instance.new("Animation")
holdAnimation.AnimationId = TOOLNONE_ID
local holdTrack: AnimationTrack? = nil
local holdToken = 0

-- ---------------------------------------------------------------------
-- 3) HELFER
-- ---------------------------------------------------------------------
local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function modules(): { [string]: any }
	return if ctx and type(ctx.Modules) == "table" then ctx.Modules else {}
end

local function call(moduleName: string, fnName: string, ...: any): any
	local mod = modules()[moduleName]
	if mod and type(mod[fnName]) == "function" then
		local ok, result = pcall(mod[fnName], ...)
		if ok then
			return result
		end
	end
	return nil
end

local function has(flags: number, bit: number): boolean
	return bit32.band(flags, bit) ~= 0
end

local function glintAfter(): number
	local combat = ctx and ctx.Config and ctx.Config.Combat
	return if combat and finite(combat.ScopeGlintAfter) then combat.ScopeGlintAfter else 0.3
end

local function motorC0(motor: Motor6D): CFrame
	local orig = origC0[motor]
	if not orig then
		orig = motor.C0
		origC0[motor] = orig
	end
	return orig
end

local function restoreMotor(motor: Motor6D?)
	if motor and origC0[motor] then
		motor.C0 = origC0[motor]
	end
end

local function findMotors(model: Model): Motors
	local function motor(parentName: string, name: string): Motor6D?
		local parent = model:FindFirstChild(parentName)
		local m = parent and parent:FindFirstChild(name)
		return if m and m:IsA("Motor6D") then m else nil
	end
	local neck = motor("Head", "Neck") or motor("Torso", "Neck")
	local waist = motor("UpperTorso", "Waist")
	local shoulder = motor("RightUpperArm", "RightShoulder") or motor("Torso", "Right Shoulder")
	return { Neck = neck, Waist = waist, Shoulder = shoulder }
end

-- Combatant-Modell zu einer Id (Spieler direkt, Bots/Puppen über das Register von WeaponClient)
local function modelOfId(id: number): Model?
	if id > 0 or (id < 0 and id >= -999) then
		local p = Players:GetPlayerByUserId(id)
		if p and p.Character then
			return p.Character
		end
	end
	local m = call("WeaponClient", "ModelOf", id)
	if typeof(m) == "Instance" and m:IsA("Model") then
		return m
	end
	return nil
end

local function modelOfSlot(slot: number): Model?
	local id = slotToId[slot]
	if id then
		return modelOfId(id)
	end
	-- Ohne Roster (Range): Attribut "Slot" am Combatant-Modell
	local list = call("WeaponClient", "Combatants")
	if type(list) == "table" then
		for _, m in ipairs(list) do
			if typeof(m) == "Instance" and m:IsA("Model") and m:GetAttribute("Slot") == slot then
				return m
			end
		end
	end
	return nil
end

local function isEnemyModel(model: Model): boolean
	local team = model:GetAttribute("Team")
	if not finite(team) then
		local id = model:GetAttribute("CombatantId")
		team = if finite(id) then idTeam[id :: number] else nil
	end
	if not finite(team) or myTeam == 0 then
		return true
	end
	return team ~= myTeam
end

-- sichtbares Waffen-Modell im Character (CharacterService schaltet per Transparenz um)
local function visibleWeapon(model: Model): Model?
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Model") and d:GetAttribute("WeaponKey") ~= nil then
			local primary = d.PrimaryPart
			if primary and primary.Transparency < 1 then
				return d
			end
		end
	end
	return nil
end

-- ---------------------------------------------------------------------
-- 4) EINTRÄGE
-- ---------------------------------------------------------------------
local function clearEntry(e: Entry)
	local motors = e.Motors
	if motors and e.Model and e.Model.Parent then
		restoreMotor(motors.Neck)
		restoreMotor(motors.Waist)
		restoreMotor(motors.Shoulder)
	end
	local joint = e.WeaponJoint
	if joint and joint.Parent and origC0[joint] then
		(joint :: any).C0 = origC0[joint]
	end
	if e.Glint then
		e.Glint:Destroy()
	end
	if e.Dust then
		e.Dust:Destroy()
	end
end

local function clearAll()
	for slot, e in pairs(entries) do
		clearEntry(e)
		entries[slot] = nil
	end
	lastBatchSeq = -1
end

local function entryFor(slot: number): Entry?
	local e = entries[slot]
	if e then
		return e
	end
	local count = 0
	for _ in pairs(entries) do
		count += 1
	end
	if count >= MAX_ENTRIES then
		return nil
	end
	e = {
		Slot = slot,
		Model = nil,
		Motors = nil,
		Pitch = 0,
		Shown = 0,
		AppliedPitch = 0,
		Flags = 0,
		AdsSince = 0,
		SwingStart = -10,
		Reload = 0,
		AppliedArm = 0,
		NextResolve = 0,
		Glint = nil,
		Dust = nil,
		WeaponJoint = nil,
		JointTilted = false,
		WeaponScan = 0,
	}
	entries[slot] = e
	return e
end

local function resolve(e: Entry, now: number): Model?
	local m = e.Model
	if m and m.Parent then
		return m
	end
	if now < e.NextResolve then
		return nil
	end
	e.NextResolve = now + 1
	if e.Glint then
		e.Glint:Destroy()
		e.Glint = nil
	end
	if e.Dust then
		e.Dust:Destroy()
		e.Dust = nil
	end
	e.WeaponJoint = nil
	local model = modelOfSlot(e.Slot)
	if model == player.Character then
		model = nil -- eigener Character: kein Neigen (Ego-Sicht)
	end
	e.Model = model
	e.Motors = if model then findMotors(model) else nil
	e.AppliedPitch = 0
	e.AppliedArm = 0
	return model
end

-- ---------------------------------------------------------------------
-- 5) LOOKBATCH EMPFANGEN
-- ---------------------------------------------------------------------
local function onLookBatch(b: any)
	if typeof(b) ~= "buffer" then
		return
	end
	local batchSeq, list = Net.DecodeLookBatch(b)
	if batchSeq == nil then
		return
	end
	if lastBatchSeq >= 0 then
		local diff = (batchSeq - lastBatchSeq) % 65536
		if diff == 0 or diff > 32768 then
			return -- älteres oder doppeltes Paket
		end
	end
	lastBatchSeq = batchSeq
	local now = os.clock()
	for _, item in ipairs(list) do
		local e = entryFor(item.Slot)
		if e then
			e.Pitch = math.clamp(item.Pitch, -80, 80)
			local old = e.Flags
			local new = item.Flags
			if has(new, FLAGS.Ads) and not has(old, FLAGS.Ads) then
				e.AdsSince = now
			end
			if has(new, FLAGS.Swing) and not has(old, FLAGS.Swing) then
				e.SwingStart = now
			end
			e.Flags = new
		end
	end
end

-- ---------------------------------------------------------------------
-- 6) DARSTELLUNG ANDERER (PreRender)
-- ---------------------------------------------------------------------
local function ensureGlint(e: Entry, weapon: Model): BillboardGui?
	if e.Glint and e.Glint.Parent then
		return e.Glint
	end
	local primary = weapon.PrimaryPart
	if not primary then
		return nil
	end
	local sight = primary:FindFirstChild("Sight")
	local gui = Instance.new("BillboardGui")
	gui.Name = "CC_ScopeGlint"
	gui.Size = UDim2.fromScale(3, 3)
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Enabled = false
	gui.Adornee = if sight and sight:IsA("Attachment") then sight else primary
	local image = Instance.new("ImageLabel")
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromScale(1, 1)
	image.Image = GLOW_TEXTURE
	image.ImageColor3 = Color3.fromRGB(255, 250, 220)
	image.Parent = gui
	gui.Parent = primary
	e.Glint = gui
	return gui
end

local function ensureDust(e: Entry, model: Model): ParticleEmitter?
	if e.Dust and e.Dust.Parent then
		return e.Dust
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		return nil
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "CC_RemoteDust"
	attachment.Position = Vector3.new(0, -2.6, 0.4)
	attachment.Parent = root
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = DUST_TEXTURE
	emitter.Color = ColorSequence.new(Color3.fromRGB(240, 232, 220))
	emitter.Lifetime = NumberRange.new(0.35, 0.6)
	emitter.Speed = NumberRange.new(2, 5)
	emitter.SpreadAngle = Vector2.new(35, 35)
	emitter.EmissionDirection = Enum.NormalId.Back
	emitter.Size = NumberSequence.new(0.6, 1.8)
	emitter.Transparency = NumberSequence.new(0.35, 1)
	emitter.Rate = 30
	emitter.Enabled = false
	emitter.Parent = attachment
	-- Attachment mit aufräumen
	emitter.Destroying:Connect(function()
		attachment:Destroy()
	end)
	e.Dust = emitter
	return emitter
end

-- Gelenk zwischen Hand und sichtbarer Waffe (Weld/Motor6D mit C0) – sonst nil (dann kippt die Schulter)
local function weaponJoint(model: Model): JointInstance?
	local weapon = visibleWeapon(model)
	local primary = weapon and weapon.PrimaryPart
	if not primary then
		return nil
	end
	local hand = model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm")
	for _, holder in ipairs({ primary, hand }) do
		if holder then
			for _, child in ipairs((holder :: Instance):GetChildren()) do
				if
					(child:IsA("Weld") or child:IsA("Motor6D"))
					and ((child :: Weld).Part0 == primary or (child :: Weld).Part1 == primary)
				then
					return child :: JointInstance
				end
			end
		end
	end
	return nil
end

local function swingCurve(t: number): number
	if t <= 0 or t >= 1 then
		return 0
	end
	if t < 0.35 then
		return math.sin((t / 0.35) * math.pi * 0.5) * 70
	end
	local u = (t - 0.35) / 0.65
	return 70 * (1 - u) - 15 * math.sin(u * math.pi)
end

local function updateEntry(e: Entry, model: Model, dt: number, now: number, camPos: Vector3)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) or (root.Position - camPos).Magnitude > CULL_DISTANCE then
		return
	end
	local motors = e.Motors
	if not motors then
		return
	end
	-- Neigung (weich)
	e.Shown += (e.Pitch - e.Shown) * (1 - math.exp(-dt * 14))
	if math.abs(e.Shown - e.AppliedPitch) > 0.25 then
		e.AppliedPitch = e.Shown
		local p = math.rad(e.Shown)
		local neck = motors.Neck
		if neck and neck.Parent then
			local orig = motorC0(neck)
			neck.C0 = CFrame.new(orig.Position) * CFrame.Angles(p * NECK_MULT, 0, 0) * orig.Rotation
		end
		local waist = motors.Waist
		if waist and waist.Parent then
			local orig = motorC0(waist)
			waist.C0 = CFrame.new(orig.Position) * CFrame.Angles(p * WAIST_MULT, 0, 0) * orig.Rotation
		end
	end

	-- Nachladen (Waffen-Schweißung kippen) und Schwung (Schulter)
	local reloading = has(e.Flags, FLAGS.Reload)
	e.Reload += ((if reloading then 1 else 0) - e.Reload) * (1 - math.exp(-dt * 10))
	if reloading and e.WeaponJoint == nil and now >= e.WeaponScan then
		e.WeaponScan = now + 1
		e.WeaponJoint = weaponJoint(model)
	end
	local swingDeg = swingCurve((now - e.SwingStart) / SWING_TIME)
	local blockDeg = if has(e.Flags, FLAGS.Block) then 35 else 0
	local shoulderReload = e.Reload
	local joint = e.WeaponJoint
	if joint and joint.Parent then
		-- bevorzugt: Waffen-Schweißung lokal kippen
		local orig = origC0[joint]
		if not orig then
			orig = (joint :: any).C0
			origC0[joint] = orig
		end
		local tilt = e.Reload
		if tilt > 0.002 or e.JointTilted then
			(joint :: any).C0 = (orig :: CFrame) * CFrame.Angles(math.rad(-35) * tilt, 0, math.rad(25) * tilt)
			e.JointTilted = tilt > 0.002
		end
		shoulderReload = 0
	end
	local armDeg = swingDeg + blockDeg
	local armValue = armDeg + shoulderReload * 100
	local shoulder = motors.Shoulder
	if shoulder and shoulder.Parent and math.abs(armValue - e.AppliedArm) > 0.3 then
		e.AppliedArm = armValue
		local orig = motorC0(shoulder)
		shoulder.C0 = CFrame.new(orig.Position)
			* CFrame.Angles(math.rad(armDeg) + math.rad(-20) * shoulderReload, 0, math.rad(15) * shoulderReload)
			* orig.Rotation
	end

	-- Rutsch-Staub
	local sliding = has(e.Flags, FLAGS.Slide)
	if sliding or e.Dust then
		local dust = ensureDust(e, model)
		if dust and dust.Enabled ~= sliding then
			dust.Enabled = sliding
		end
	end

	-- Zielfernrohr-Glanz (nur Gegner, nur Fernschuss, nach ScopeGlintAfter s ADS)
	local glintOn = false
	if has(e.Flags, FLAGS.Ads) and now - e.AdsSince >= glintAfter() and isEnemyModel(model) then
		local weapon = visibleWeapon(model)
		if weapon and weapon:GetAttribute("WeaponKey") == "Longshot" then
			local gui = ensureGlint(e, weapon)
			if gui then
				glintOn = true
				local pulse = 2.6 + math.sin(now * 9) * 0.5
				gui.Size = UDim2.fromScale(pulse, pulse)
			end
		end
	end
	if e.Glint and e.Glint.Enabled ~= glintOn then
		e.Glint.Enabled = glintOn
	end
end

-- BigHead-Bälle (Mutator BigHeads): Attribut BigHead am Combatant-Modell
local function updateBigHeads()
	local list = call("WeaponClient", "Combatants")
	if type(list) ~= "table" then
		list = {}
	end
	local seen: { [Model]: boolean } = {}
	for _, m in ipairs(list) do
		if typeof(m) == "Instance" and m:IsA("Model") and m ~= player.Character then
			local flag = m:GetAttribute("BigHead")
			local head = m:FindFirstChild("Head")
			if flag and flag ~= 0 and head and head:IsA("BasePart") then
				seen[m] = true
				local ball = bigBalls[m]
				if not (ball and ball.Parent) then
					local mult = if finite(flag) then math.clamp(flag :: number, 1, 3) else 1.6
					local d = 1.6 * mult
					local part = Instance.new("Part")
					part.Name = "CC_BigHead"
					part.Shape = Enum.PartType.Ball
					part.Size = Vector3.new(d, d, d)
					part.Color = head.Color
					part.Material = Enum.Material.SmoothPlastic
					part.CanCollide = false
					part.CanQuery = false
					part.CanTouch = false
					part.CastShadow = false
					part.Massless = true
					part.CFrame = head.CFrame
					local face = head:FindFirstChildOfClass("Decal")
					if face then
						face:Clone().Parent = part
					end
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = head
					weld.Part1 = part
					weld.Parent = part
					part.Parent = m
					bigBalls[m] = part
				end
			end
		end
	end
	for m, ball in pairs(bigBalls) do
		if not seen[m] then
			ball:Destroy()
			bigBalls[m] = nil
		end
	end
end

local function onRender(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local now = os.clock()
	local camPos = camera.CFrame.Position
	for _, e in pairs(entries) do
		local model = resolve(e, now)
		if model then
			updateEntry(e, model, dt, now, camPos)
		end
	end
	bigHeadAccum += dt
	if bigHeadAccum >= 1 then
		bigHeadAccum = 0
		updateBigHeads()
	end
end

-- ---------------------------------------------------------------------
-- 7) EIGENER CHARACTER: toolnone + Look senden
-- ---------------------------------------------------------------------
local function stopHold()
	holdToken += 1
	if holdTrack then
		holdTrack:Stop(0.2)
		holdTrack:Destroy()
		holdTrack = nil
	end
end

local function playHold()
	stopHold()
	local token = holdToken
	task.spawn(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5)
		if token ~= holdToken or not (animator and animator:IsA("Animator")) then
			return
		end
		local ok, track = pcall(function()
			return animator:LoadAnimation(holdAnimation)
		end)
		if ok and track and token == holdToken then
			track.Looped = true
			track.Priority = Enum.AnimationPriority.Action
			track:Play(0.15)
			holdTrack = track
		end
	end)
end

function Replication.Flags(): number
	local flags = 0
	if call("WeaponClient", "IsAds") == true then
		flags += FLAGS.Ads
	end
	if call("Movement", "IsSprinting") == true then
		flags += FLAGS.Sprint
	end
	if call("Movement", "IsSliding") == true then
		flags += FLAGS.Slide
	end
	if call("WeaponClient", "IsReloading") == true then
		flags += FLAGS.Reload
	end
	if call("WeaponClient", "IsBlocking") == true then
		flags += FLAGS.Block
	end
	if call("Movement", "IsAirborne") == true then
		flags += FLAGS.Air
	end
	if call("WeaponClient", "IsSwinging") == true then
		flags += FLAGS.Swing
	end
	return flags
end

local function onHeartbeat(dt: number)
	if not armed or popped then
		return
	end
	sendAccum += dt
	if sendAccum < SEND_INTERVAL then
		return
	end
	sendAccum = math.min(sendAccum - SEND_INTERVAL, SEND_INTERVAL)
	local camera = workspace.CurrentCamera
	local look = remotes.Look
	if not (camera and look and look:IsA("UnreliableRemoteEvent")) then
		return
	end
	local pitch = math.floor(math.deg(math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1))) + 0.5)
	pitch = math.clamp(pitch, -80, 80)
	local flags = Replication.Flags()
	if math.abs(pitch - lastSentPitch) > 1 or flags ~= lastSentFlags then
		seq = (seq + 1) % 65536
		lastSentPitch = pitch
		lastSentFlags = flags
		look:FireServer(Net.EncodeLook(pitch, flags, seq))
	end
end

-- ---------------------------------------------------------------------
-- 8) MODUL-FORM
-- ---------------------------------------------------------------------
local function onArmed(info: any)
	armed = true
	popped = false
	lastSentPitch = 1000
	lastSentFlags = -1
	if type(info) == "table" and finite(info.Team) then
		myTeam = info.Team
	end
	playHold()
end

local function onDisarmed()
	armed = false
	popped = false
	stopHold()
	clearAll()
end

function Replication.Init(context: any)
	ctx = context
	if ctx and type(ctx.Remotes) == "table" then
		remotes = ctx.Remotes
	else
		remotes = Net.GetRemotes()
	end
end

function Replication.Start()
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		hooks.On("Armed", onArmed)
		hooks.On("Disarmed", onDisarmed)
		hooks.On("LocalPopped", function()
			popped = true
			stopHold()
		end)
		hooks.On("LocalRevived", function()
			popped = false
			if armed then
				playHold()
			end
		end)
		hooks.On("Match:Start", function(data: any)
			clearAll()
			table.clear(slotToId)
			table.clear(idTeam)
			if type(data) ~= "table" then
				return
			end
			if finite(data.MyTeam) then
				myTeam = data.MyTeam
			end
			if type(data.Roster) == "table" then
				for _, r in ipairs(data.Roster) do
					if type(r) == "table" and finite(r.Slot) and finite(r.Id) then
						slotToId[r.Slot] = r.Id
						if finite(r.Team) then
							idTeam[r.Id] = r.Team
						end
					end
				end
			end
		end)
		hooks.On("Match:Left", function(data: any)
			if type(data) ~= "table" or not finite(data.Id) then
				return
			end
			for slot, id in pairs(slotToId) do
				if id == data.Id then
					local e = entries[slot]
					if e then
						clearEntry(e)
						entries[slot] = nil
					end
				end
			end
		end)
		hooks.On("Match:Closed", function()
			clearAll()
			table.clear(slotToId)
			table.clear(idTeam)
		end)
	end
	local batch = remotes.LookBatch
	if batch and batch:IsA("UnreliableRemoteEvent") then
		batch.OnClientEvent:Connect(onLookBatch)
	end
	player.CharacterAdded:Connect(function()
		holdTrack = nil
		if armed and not popped then
			playHold()
		end
	end)
	RunService.Heartbeat:Connect(onHeartbeat)
	RunService.PreRender:Connect(onRender)
end

return Replication
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">Scoreboard</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Scoreboard im Match (Client/Modules/Scoreboard)
--  Besitzer: WP5 (Match-UI). Vertrag: DESIGN.md B14.7, C7.4.
--
--  Tab halten / View (Gamepad) / Knopf (Touch): pro Team Avatar, Name, Level-Abzeichen, Titel, K/D/A,
--  Schaden, Ping (Player-Attribut "PingMs", vom Server alle 2 s), [BOT]. Knöpfe Loben 👍 (nach dem Match,
--  Request "Commend") und Melden ⚑ (Request "Report", 1× pro Spieler und Match).
--  Datenquelle: Roster aus Match:Start, live K/D/A aus Match:Elim, Schaden aus den Stats-Schnappschüssen
--  in Match:RoundEnd / Match:End (Server-Werte gewinnen). Außerhalb eines Matches unsichtbar.
--
--  Öffentliche API: Scoreboard.Show(on), Scoreboard.Toggle(), Scoreboard.IsOpen(), Scoreboard.Init(ctx), Scoreboard.Start()
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local UI = require(script.Parent:WaitForChild("UI"))

local Scoreboard = {}

local player = Players.LocalPlayer
local ctx: any = nil

local ROW_H = 46
local REFRESH = 0.5
local FACE = "rbxasset://textures/face.png"

type Row = {
	Id: number,
	Name: string,
	Team: number,
	IsBot: boolean,
	Level: number,
	Title: string,
	K: number,
	D: number,
	A: number,
	Dmg: number,
	Score: number?,
}

local rows: { [number]: Row } = {}
local order: { number } = {}
local inMatch = false
local matchOver = false
local matchMode: string? = nil
local myTeam = 0
local myId = player.UserId
local reported: { [number]: boolean } = {}
local commended = false
local open = false
local holding = false
local root: Frame? = nil
local listFrame: Frame? = nil
local titleLabel: TextLabel? = nil
local touchButton: TextButton? = nil
local accum = 0
local dirty = true
local currentMatchId: any = nil

local function T(key: string, ...: any): string
	return if ctx then ctx.T(key, ...) else key
end

local function teamColor(team: number): Color3
	local colors = ctx and ctx.Config and ctx.Config.Colors
	if matchMode == "FFA" then
		return UI.Theme.Pink
	end
	if colors then
		return if team == 2 then colors.TeamB else colors.TeamA
	end
	return if team == 2 then UI.Theme.Cyan else UI.Theme.Orange
end

local function titleText(title: string): string
	if title == "" then
		return ""
	end
	local cosmetics = ctx and ctx.Config and ctx.Config.Cosmetics
	local def = cosmetics and type(cosmetics.Titles) == "table" and cosmetics.Titles[title]
	if def and type(def.Name) == "table" then
		return ctx.Lang.Pick(ctx.Lang_(), def.Name)
	end
	return title
end

local function playerById(id: number): Player?
	if id == 0 then
		return nil
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.UserId == id then
			return p
		end
	end
	return nil
end

-- ---------------------------------------------------------------------
-- Aufbau
-- ---------------------------------------------------------------------
local function build()
	local gui = ctx.Gui
	local frame = UI.Create("Frame", {
		Name = "Scoreboard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.48),
		Size = UDim2.fromOffset(640, 440),
		BackgroundColor3 = UI.Theme.PanelDark,
		BackgroundTransparency = 0.1,
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	}, { UI.Corner(16), UI.Stroke(UI.Theme.Black, 3) })
	titleLabel = UI.Label({
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 34),
		Text = T("match.scoreboard.title"),
		MaxText = 26,
		Outline = 3,
		ZIndex = 41,
		Parent = frame,
	})
	-- Spaltenköpfe
	local head = UI.Create("Frame", {
		Position = UDim2.fromOffset(12, 42),
		Size = UDim2.new(1, -24, 0, 22),
		BackgroundTransparency = 1,
		ZIndex = 41,
		Parent = frame,
	})
	local columns = {
		{ "match.scoreboard.name", 0.06, 0.4 },
		{ "match.scoreboard.kda", 0.5, 0.16 },
		{ "match.scoreboard.damage", 0.66, 0.12 },
		{ "match.scoreboard.ping", 0.78, 0.1 },
	}
	for _, col in ipairs(columns) do
		UI.Label({
			Position = UDim2.fromScale(col[2], 0),
			Size = UDim2.fromScale(col[3], 1),
			Text = T(col[1]),
			MaxText = 14,
			Outline = 2,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 41,
			Parent = head,
		})
	end
	local list = UI.Create("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(12, 68),
		Size = UDim2.new(1, -24, 1, -80),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 41,
		Parent = frame,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }),
	})
	listFrame = list
	root = frame

	-- Touch: kleiner Knopf oben links (nur im Match sichtbar)
	local button = UI.Create("TextButton", {
		Name = "ScoreboardButton",
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromOffset(12, 70),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = UI.Theme.PanelDark,
		Text = "☰",
		TextScaled = true,
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 30,
		Parent = ctx.TouchGui or gui,
	}, { UI.Corner(12), UI.Stroke(UI.Theme.Black, 2) })
	button.Activated:Connect(function()
		Scoreboard.Toggle()
	end)
	touchButton = button
end

local function sortedIds(): { number }
	local ids: { number } = {}
	for id in pairs(rows) do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		local ra, rb = rows[a], rows[b]
		if ra.Team ~= rb.Team then
			-- eigenes Team zuerst
			if ra.Team == myTeam then
				return true
			elseif rb.Team == myTeam then
				return false
			end
			return ra.Team < rb.Team
		end
		local sa = (ra.Score or 0) * 1000 + ra.K * 10 + ra.A
		local sb = (rb.Score or 0) * 1000 + rb.K * 10 + rb.A
		if sa ~= sb then
			return sa > sb
		end
		return a < b
	end)
	return ids
end

local function request(action: string, arg: any)
	task.spawn(function()
		if ctx then
			ctx.Request(action, arg)
		end
	end)
end

local function redraw()
	local list = listFrame
	if not list then
		return
	end
	dirty = false
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	order = sortedIds()
	for i, id in ipairs(order) do
		local r = rows[id]
		local color = teamColor(r.Team)
		local mine = id == myId
		local row = UI.Create("Frame", {
			Name = "Row" .. i,
			LayoutOrder = i,
			Size = UDim2.new(1, -8, 0, ROW_H),
			BackgroundColor3 = if mine then UI.Theme.Yellow:Lerp(color, 0.35) else color:Lerp(UI.Theme.PanelDark, 0.45),
			ZIndex = 42,
			Parent = list,
		}, { UI.Corner(10), UI.Stroke(UI.Theme.Black, 2) })
		local p = playerById(id)
		UI.Create("ImageLabel", {
			Position = UDim2.fromOffset(4, 3),
			Size = UDim2.fromOffset(ROW_H - 6, ROW_H - 6),
			BackgroundColor3 = UI.Theme.PanelLight,
			Image = if p
					and id > 0
					and not r.IsBot
				then ("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48"):format(id)
				else FACE,
			ZIndex = 43,
			Parent = row,
		}, { UI.Corner(20) })
		local nameText = r.Name
		if r.IsBot then
			nameText = T("match.scoreboard.bot") .. " " .. nameText
		elseif r.Level > 0 then
			nameText = ("[%d] %s"):format(r.Level, nameText)
		end
		local title = titleText(r.Title)
		UI.Label({
			Position = UDim2.new(0.06, 8, 0, 2),
			Size = UDim2.new(0.42, 0, 0, if title ~= "" then 24 else ROW_H - 4),
			Text = nameText,
			MaxText = 20,
			Outline = 2,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = if r.IsBot then Color3.fromRGB(200, 200, 205) else Color3.new(1, 1, 1),
			ZIndex = 43,
			Parent = row,
		})
		if title ~= "" then
			UI.Label({
				Position = UDim2.new(0.06, 8, 0, 25),
				Size = UDim2.new(0.42, 0, 0, 17),
				Text = title,
				MaxText = 13,
				Outline = 1,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = UI.Theme.SubText,
				ZIndex = 43,
				Parent = row,
			})
		end
		local kda = ("%d / %d / %d"):format(r.K, r.D, r.A)
		if r.Score ~= nil then
			kda = ("%d  ·  %s"):format(r.Score, kda)
		end
		UI.Label({
			Position = UDim2.fromScale(0.5, 0),
			Size = UDim2.fromScale(0.16, 1),
			Text = kda,
			Font = UI.Fonts.Number,
			MaxText = 18,
			Outline = 2,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 43,
			Parent = row,
		})
		UI.Label({
			Position = UDim2.fromScale(0.66, 0),
			Size = UDim2.fromScale(0.12, 1),
			Text = tostring(math.floor(r.Dmg + 0.5)),
			Font = UI.Fonts.Number,
			MaxText = 18,
			Outline = 2,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 43,
			Parent = row,
		})
		local ping = UI.Label({
			Name = "Ping",
			Position = UDim2.fromScale(0.78, 0),
			Size = UDim2.fromScale(0.1, 1),
			Text = if r.IsBot then "BOT" else "–",
			Font = UI.Fonts.Number,
			MaxText = 16,
			Outline = 2,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 43,
			Parent = row,
		})
		ping:SetAttribute("UserId", id)
		-- Loben (nach dem Match) / Melden (Menschen, nicht man selbst)
		if not r.IsBot and not mine and p then
			if matchOver and not commended then
				local commend = UI.Create("TextButton", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -46, 0.5, 0),
					Size = UDim2.fromOffset(38, 34),
					BackgroundColor3 = UI.Theme.Green,
					Text = "👍",
					TextScaled = true,
					Font = UI.Font,
					ZIndex = 44,
					Parent = row,
				}, { UI.Corner(8), UI.Stroke(UI.Theme.Black, 2) })
				commend.Activated:Connect(function()
					if commended then
						return
					end
					commended = true
					request("Commend", id)
					dirty = true
				end)
			end
			if not reported[id] then
				local report = UI.Create("TextButton", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -4, 0.5, 0),
					Size = UDim2.fromOffset(38, 34),
					BackgroundColor3 = UI.Theme.Red,
					Text = "⚑",
					TextScaled = true,
					Font = UI.Font,
					TextColor3 = Color3.new(1, 1, 1),
					ZIndex = 44,
					Parent = row,
				}, { UI.Corner(8), UI.Stroke(UI.Theme.Black, 2) })
				report.Activated:Connect(function()
					if reported[id] then
						return
					end
					reported[id] = true
					request("Report", { UserId = id, Reason = "Other" })
					dirty = true
				end)
			end
		end
	end
end

local function refreshPings()
	local list = listFrame
	if not list then
		return
	end
	for _, row in ipairs(list:GetChildren()) do
		local ping = row:FindFirstChild("Ping")
		if ping and ping:IsA("TextLabel") then
			local id = tonumber(ping:GetAttribute("UserId")) or 0
			local p = playerById(id)
			if p then
				local ms = tonumber(p:GetAttribute("PingMs"))
				local text = if ms then tostring(math.floor(ms + 0.5)) else "–"
				if ping.Text ~= text then
					ping.Text = text
				end
			end
		end
	end
end

function Scoreboard.Show(on: boolean)
	open = on and inMatch
	local frame = root
	if frame then
		frame.Visible = open
	end
	if open then
		if titleLabel then
			local key = if matchOver then "match.scoreboard.final" else "match.scoreboard.title"
			titleLabel.Text = T(key)
		end
		redraw()
		refreshPings()
	end
end

function Scoreboard.Toggle()
	Scoreboard.Show(not open)
end

function Scoreboard.IsOpen(): boolean
	return open
end

-- ---------------------------------------------------------------------
-- Daten
-- ---------------------------------------------------------------------
local function applySnapshot(stats: any)
	if type(stats) ~= "table" then
		return
	end
	for key, value in pairs(stats) do
		local id = tonumber(key)
		local r = id and rows[id]
		if r and type(value) == "table" then
			r.K = tonumber(value.K) or r.K
			r.D = tonumber(value.D) or r.D
			r.A = tonumber(value.A) or r.A
			r.Dmg = tonumber(value.Dmg) or r.Dmg
		end
	end
	dirty = true
end

local function onStart(data: any)
	if type(data) ~= "table" then
		return
	end
	local newMatch = not inMatch or data.MatchId ~= currentMatchId
	currentMatchId = data.MatchId
	inMatch = true
	matchMode = data.Mode
	myTeam = tonumber(data.MyTeam) or 0
	myId = tonumber(data.MyId) or player.UserId
	if newMatch then
		table.clear(rows)
		table.clear(reported)
		commended = false
		matchOver = false
	end
	if type(data.Roster) == "table" then
		local seen: { [number]: boolean } = {}
		for _, entry in ipairs(data.Roster) do
			local id = tonumber(entry.Id)
			if id and id ~= 0 then
				seen[id] = true
				local old = rows[id]
				rows[id] = {
					Id = id,
					Name = tostring(entry.Name or "?"),
					Team = tonumber(entry.Team) or 0,
					IsBot = entry.IsBot == true,
					Level = tonumber(entry.Level) or 0,
					Title = tostring(entry.Title or ""),
					K = if old then old.K else 0,
					D = if old then old.D else 0,
					A = if old then old.A else 0,
					Dmg = if old then old.Dmg else 0,
					Score = if old then old.Score else nil,
				}
			end
		end
		for id in pairs(rows) do
			if not seen[id] then
				rows[id] = nil
			end
		end
	end
	local button = touchButton
	if button then
		local controls = ctx.Modules.Controls
		button.Visible = controls ~= nil and type(controls.Input) == "function" and controls.Input() == "Touch"
	end
	dirty = true
end

local function onElim(data: any)
	if type(data) ~= "table" or not inMatch then
		return
	end
	local k, v = tonumber(data.K), tonumber(data.V)
	if k and rows[k] and k ~= v then
		rows[k].K += 1
	end
	if v and rows[v] then
		rows[v].D += 1
	end
	if type(data.A) == "table" then
		for _, a in ipairs(data.A) do
			local id = tonumber(a)
			if id and rows[id] and id ~= k then
				rows[id].A += 1
			end
		end
	end
	dirty = true
end

local function onClosed()
	inMatch = false
	matchOver = false
	table.clear(rows)
	Scoreboard.Show(false)
	if touchButton then
		touchButton.Visible = false
	end
end

local function step(dt: number)
	if not open then
		return
	end
	accum += dt
	if accum < REFRESH then
		return
	end
	accum = 0
	if dirty then
		redraw()
	end
	refreshPings()
end

function Scoreboard.Init(context: any)
	ctx = context
	build()
end

function Scoreboard.Start()
	local hooks = ctx.Hooks
	hooks.On("Match:Start", onStart)
	hooks.On("Match:Elim", onElim)
	hooks.On("Match:RoundEnd", function(data)
		if type(data) == "table" then
			applySnapshot(data.Stats)
		end
	end)
	hooks.On("Match:Score", function(data)
		if type(data) ~= "table" or type(data.Scores) ~= "table" then
			return
		end
		for key, value in pairs(data.Scores) do
			local id = tonumber(key)
			if id and rows[id] then
				rows[id].Score = tonumber(value) or 0
			end
		end
		dirty = true
	end)
	hooks.On("Match:End", function(data)
		matchOver = true
		if type(data) == "table" then
			applySnapshot(data.Stats)
		end
	end)
	hooks.On("Match:Left", function(data)
		local id = type(data) == "table" and tonumber(data.Id) or nil
		if id and rows[id] then
			rows[id] = nil
			dirty = true
		end
	end)
	hooks.On("Match:Closed", onClosed)
	hooks.On("Input", function(kind)
		if touchButton then
			touchButton.Visible = inMatch and kind == "Touch"
		end
	end)
	local controls = ctx.Modules.Controls
	if controls and type(controls.Bind) == "function" then
		controls.Bind("Scoreboard", function(state)
			if state == "Begin" then
				holding = true
				Scoreboard.Show(true)
			elseif state == "End" and holding then
				holding = false
				Scoreboard.Show(false)
			end
		end)
	end
	RunService.Heartbeat:Connect(step)
end

return Scoreboard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Einstellungen (Client/Modules/Settings)
--  Besitzer: WP10 (Client-Hülle). Vertrag: DESIGN.md C7.3 ("Settings"), C7.4, B15.3, C19 (Info).
--
--  Ein Fenster "Settings", gebaut aus Config.Client.SettingsSchema (jeder Schlüssel aus
--  DefaultSettings): Regler (Zahlen), Schalter (an/aus), Auswahl (Optionen) + Fadenkreuz-Vorschau.
--  Änderungen wirken sofort (Hook "Settings"), gespeichert wird gebündelt über Request
--  "SaveSettings" (nur geänderte Schlüssel, geklemmt wie auf dem Server). Fällt die Bildrate
--  5 s lang unter 35 FPS, schaltet sich "Reduzierte Effekte" einmal automatisch ein (mit Hinweis).
--  Info-Bereich: Regeln + Einspruch bei Banns (C19), Version.
--
--  Öffentliche API (C7.4):
--    Settings.Get(): { [string]: any }      aktuelle Werte (NICHT verändern – Settings.Set benutzen)
--  Zusätzlich: Settings.Set(key, value) (geklemmt, speichert), Settings.Fps(): number,
--    Settings.Open(), Settings.Frame(dt), Settings.Tick(), Settings.Init(ctx), Settings.Start()
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")) :: any

local Settings = {}

local Theme = UI.Theme
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local SAVE_DELAY = 0.8 -- Sekunden nach der letzten Änderung speichern (Server-Limit 2/s)
local WINDOW_W = 620
local WINDOW_H = 560

-- Reihenfolge + Abschnitte im Fenster (Schlüssel aus dem Schema; "Crosshair.<Feld>" = Teilwert)
local SECTIONS: { { Key: string, Color: Color3, Items: { string } } } = {
	{
		Key = "controls",
		Color = Theme.Orange,
		Items = {
			"SensMouse",
			"SensPad",
			"SensTouch",
			"AdsMult",
			"ScopeMult",
			"InvertY",
			"AdsToggle",
			"SprintToggle",
			"AutoReload",
			"AimAssist",
			"AutoFire",
		},
	},
	{
		Key = "crosshair",
		Color = Theme.Pink,
		Items = { "Crosshair.Style", "Crosshair.Color", "Crosshair.Size", "Crosshair.Gap", "Crosshair.Dot" },
	},
	{
		Key = "visual",
		Color = Theme.Cyan,
		Items = { "Fov", "EnemyColor", "DamageNumbers", "HitSound", "ReducedFx", "Shake", "ShowNet" },
	},
	{ Key = "touch", Color = Theme.Purple, Items = { "LeftHanded", "ButtonScale" } },
	{ Key = "audio", Color = Theme.Green, Items = { "Sfx", "Music", "Ui" } },
	{ Key = "game", Color = Theme.Yellow, Items = { "Lang", "AutoRequeue", "PublicDrops" } },
}
-- Regler, die als Prozent angezeigt werden
local PERCENT = {
	AimAssist = true,
	Shake = true,
	Sfx = true,
	Music = true,
	Ui = true,
	ButtonScale = true,
}

local ctx: any = nil
local schema: { [string]: any } = Config.Client and Config.Client.SettingsSchema or {}
local defaults: { [string]: any } = Config.Client and Config.Client.DefaultSettings or {}
local current: { [string]: any } = {}
local pending: { [string]: any } = {}
local saveToken = 0
local window: any = nil
local rows: { { Refresh: () -> () } } = {}
local rowConns: { RBXScriptConnection } = {} -- globale Eingabe-Verbindungen der Regler (beim Neubau trennen)
local builtLang = ""
local statusLabel: TextLabel? = nil

-- Bildrate + automatische Reduzierte Effekte
local fps = 60
local fpsAccum = 0
local fpsFrames = 0
local lowFor = 0
local startedAt = os.clock()
local autoDone = false
local focused = true

-- ---------------------------------------------------------------------
-- HILFEN
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

-- Text eines Schlüssels; fehlt er (Lang gibt den Schlüssel zurück), den Ersatz nehmen
local function TOr(key: string, fallback: string): string
	local text = T(key)
	if text == key then
		return fallback
	end
	return text
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- Startwerte schon beim Laden (andere Module fragen Settings.Get evtl. vor Settings.Init)
current = deepCopy(defaults)

local function entryFor(path: string): (any, string, string?)
	local key, field = string.match(path, "^(%w+)%.(%w+)$")
	if key and field then
		local parent = schema[key]
		local fields = parent and parent.Fields
		return fields and fields[field], key, field
	end
	return schema[path], path, nil
end

-- Wert prüfen + klemmen wie der Server (Zahl: Min/Max/Step/Integer; Enum: Option; Bool)
local function clean(entry: any, value: any, fallback: any): any
	if type(entry) ~= "table" then
		return fallback
	end
	if entry.Type == "number" then
		if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
			return fallback
		end
		local v = math.clamp(value, entry.Min or value, entry.Max or value)
		local step = entry.Step
		if type(step) == "number" and step > 0 then
			local base = entry.Min or 0
			v = base + math.floor((v - base) / step + 0.5) * step
			v = math.clamp(v, entry.Min or v, entry.Max or v)
			v = math.floor(v * 1000 + 0.5) / 1000
		end
		if entry.Integer then
			v = math.floor(v + 0.5)
		end
		return v
	elseif entry.Type == "boolean" then
		return if type(value) == "boolean" then value else fallback
	elseif entry.Type == "enum" then
		return if type(value) == "string" and table.find(entry.Options or {}, value) then value else fallback
	elseif entry.Type == "table" then
		if type(value) ~= "table" then
			return fallback
		end
		local result = {}
		local fb = if type(fallback) == "table" then fallback else {}
		for field, sub in pairs(entry.Fields or {}) do
			result[field] = clean(sub, value[field], fb[field])
		end
		return result
	end
	return fallback
end

local function fire()
	ctx.Hooks.Fire("Settings", current)
end

-- ---------------------------------------------------------------------
-- SPEICHERN (gebündelt, nur geänderte Schlüssel)
-- ---------------------------------------------------------------------
local function setStatus(text: string, color: Color3?)
	local label = statusLabel
	if label then
		label.Text = text
		label.TextColor3 = color or WHITE
	end
end

local function flush()
	if next(pending) == nil then
		return
	end
	local batch = pending
	pending = {}
	local reply = ctx.RequestFull("SaveSettings", batch, true)
	if reply.Ok then
		setStatus(T("ui.set.saved"), Theme.Cash)
	else
		setStatus(T("ui.set.saveFailed"), Theme.Red)
		if type(reply.Message) == "string" and reply.Message ~= "" then
			UI.Toast(reply.Message, "Error")
		end
	end
	if batch.AutoRequeue ~= nil then
		ctx.RequestFull("AutoRequeue", batch.AutoRequeue == true, true)
	end
end

local function scheduleSave(key: string)
	pending[key] = deepCopy(current[key])
	saveToken += 1
	local token = saveToken
	setStatus(T("ui.set.saving"), Theme.SubText)
	task.delay(SAVE_DELAY, function()
		if token == saveToken then
			flush()
		end
	end)
end

function Settings.Get(): { [string]: any }
	return current
end

-- Wert setzen ("Key" oder "Crosshair.Feld"): geklemmt, sofort wirksam, gebündelt gespeichert
function Settings.Set(path: string, value: any)
	if type(path) ~= "string" then
		return
	end
	local entry, key, field = entryFor(path)
	if not entry then
		warn("[Settings] Unbekannte Einstellung: " .. path)
		return
	end
	if field then
		local parent = current[key]
		if type(parent) ~= "table" then
			parent = deepCopy(defaults[key]) or {}
			current[key] = parent
		end
		local cleaned = clean(entry, value, parent[field])
		if parent[field] == cleaned then
			return
		end
		parent[field] = cleaned
	else
		local cleaned = clean(entry, value, current[key])
		if current[key] == cleaned and type(cleaned) ~= "table" then
			return
		end
		current[key] = cleaned
	end
	scheduleSave(key)
	fire()
	for _, row in ipairs(rows) do
		row.Refresh()
	end
end

function Settings.Fps(): number
	return fps
end

-- Server-Stand übernehmen (lokal noch nicht gespeicherte Änderungen bleiben)
local function mergeServer(serverSettings: any)
	if type(serverSettings) ~= "table" then
		return
	end
	local changed = false
	for key, entry in pairs(schema) do
		if pending[key] == nil and serverSettings[key] ~= nil then
			local cleaned = clean(entry, serverSettings[key], current[key])
			if type(cleaned) == "table" or cleaned ~= current[key] then
				current[key] = cleaned
				changed = true
			end
		end
	end
	if changed then
		fire()
		for _, row in ipairs(rows) do
			row.Refresh()
		end
	end
end

-- ---------------------------------------------------------------------
-- FENSTER-BAUSTEINE
-- ---------------------------------------------------------------------
local function labelFor(path: string): string
	return TOr("ui.set." .. path, path)
end

local function optionText(path: string, option: any): string
	local _, key, field = entryFor(path)
	local name = field or key
	return TOr("ui.opt." .. name .. "." .. tostring(option), tostring(option))
end

local function getValue(path: string): any
	local _, key, field = entryFor(path)
	if field then
		local parent = current[key]
		return type(parent) == "table" and parent[field] or nil
	end
	return current[key]
end

local function formatNumber(path: string, entry: any, value: number): string
	local _, key = entryFor(path)
	if PERCENT[key] then
		return tostring(math.floor(value * 100 + 0.5)) .. " %"
	end
	if entry.Integer then
		return tostring(math.floor(value + 0.5))
	end
	return string.format("%.2f", value)
end

local function makeRow(parent: Instance, order: number): (Frame, Frame)
	-- eigene Zeile ohne Listen-Layout (Beschriftung links, Bedienelement rechtsbündig)
	local row: Frame = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	local label = UI.Label({
		Size = UDim2.new(0.5, -6, 1, 0),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 20,
		Outline = 2,
		Parent = row,
	})
	label.Name = "Label"
	local control = UI.Create("Frame", {
		Name = "Control",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0.5, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = row,
	})
	return row, control
end

local function boolRow(parent: Instance, order: number, path: string)
	local row, control = makeRow(parent, order)
	local button = UI.Button({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Color = Theme.Gray,
		MaxText = 20,
		Parent = control,
	}, function()
		Settings.Set(path, not (getValue(path) == true))
	end)
	local label = row:FindFirstChild("Label") :: TextLabel
	table.insert(rows, {
		Refresh = function()
			label.Text = labelFor(path)
			local on = getValue(path) == true
			button.SetText(if on then T("ui.on") else T("ui.off"))
			button.SetColor(if on then Theme.Green else Theme.Gray)
		end,
	})
end

local function enumRow(parent: Instance, order: number, path: string, entry: any)
	local row, control = makeRow(parent, order)
	local options: { any } = entry.Options or {}
	local isNumberChoice = entry.Type == "number" -- z. B. Fadenkreuz-Stil 1..4
	if isNumberChoice then
		options = {}
		for v = entry.Min or 1, entry.Max or 1 do
			table.insert(options, v)
		end
	end
	local button = UI.Button({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Color = Theme.Blue,
		MaxText = 20,
		Parent = control,
	}, function()
		local value = getValue(path)
		local index = table.find(options, value) or 0
		local nextValue = options[index % math.max(1, #options) + 1]
		if nextValue ~= nil then
			Settings.Set(path, nextValue)
		end
	end)
	local label = row:FindFirstChild("Label") :: TextLabel
	table.insert(rows, {
		Refresh = function()
			label.Text = labelFor(path)
			button.SetText("◀ " .. optionText(path, getValue(path)) .. " ▶")
		end,
	})
end

local function numberRow(parent: Instance, order: number, path: string, entry: any)
	local row, control = makeRow(parent, order)
	local minV: number = entry.Min or 0
	local maxV: number = entry.Max or 1
	local step: number = entry.Step or ((maxV - minV) / 20)
	local function nudge(direction: number)
		local value = tonumber(getValue(path)) or minV
		Settings.Set(path, value + direction * step)
	end
	UI.Button({
		Size = UDim2.new(0, 40, 1, 0),
		Text = "−",
		Color = Theme.Red,
		MaxText = 26,
		Parent = control,
	}, function()
		nudge(-1)
	end)
	UI.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 40, 1, 0),
		Text = "+",
		Color = Theme.Green,
		MaxText = 26,
		Parent = control,
	}, function()
		nudge(1)
	end)
	-- Regler-Schiene zum Ziehen (Maus/Touch)
	local track: Frame = UI.Create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -96, 0, 26),
		BackgroundColor3 = Theme.PanelDark:Lerp(BLACK, 0.4),
		Active = true,
		Parent = control,
	}, { UI.Corner(10), UI.Stroke(BLACK, 2) })
	local fill: Frame = UI.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Yellow,
		Parent = track,
	}, { UI.Corner(10) })
	local valueLabel = UI.Label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Font = UI.Fonts.Number,
		MaxText = 18,
		Outline = 2,
		ZIndex = 2,
		Parent = track,
	})
	local dragging: InputObject? = nil
	local function setFromX(x: number)
		local absPos = track.AbsolutePosition.X
		local width = math.max(1, track.AbsoluteSize.X)
		local ratio = math.clamp((x - absPos) / width, 0, 1)
		Settings.Set(path, minV + (maxV - minV) * ratio)
	end
	track.InputBegan:Connect(function(input: InputObject)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = input
			setFromX(input.Position.X)
		end
	end)
	table.insert(
		rowConns,
		UserInputService.InputChanged:Connect(function(input: InputObject)
			local active = dragging
			if not active or not track.Parent then
				return
			end
			if
				(
					active.UserInputType == Enum.UserInputType.MouseButton1
					and input.UserInputType == Enum.UserInputType.MouseMovement
				) or input == active
			then
				setFromX(input.Position.X)
			end
		end)
	)
	table.insert(
		rowConns,
		UserInputService.InputEnded:Connect(function(input: InputObject)
			if input == dragging then
				dragging = nil
			end
		end)
	)
	local label = row:FindFirstChild("Label") :: TextLabel
	table.insert(rows, {
		Refresh = function()
			label.Text = labelFor(path)
			local value = tonumber(getValue(path)) or minV
			local ratio = if maxV > minV then (value - minV) / (maxV - minV) else 0
			fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
			valueLabel.Text = formatNumber(path, entry, value)
		end,
	})
end

local function clearContent(content: ScrollingFrame)
	for _, child in ipairs(content:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	table.clear(rows)
	for _, conn in ipairs(rowConns) do
		conn:Disconnect()
	end
	table.clear(rowConns)
end

local function buildContent()
	local win = window
	if not win then
		return
	end
	local content: ScrollingFrame = win.Content
	clearContent(content)
	builtLang = ctx.Lang_()
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	statusLabel = UI.Label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = T("ui.set.hint"),
		TextColor3 = Theme.SubText,
		MaxText = 18,
		Outline = 2,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
	for _, section in ipairs(SECTIONS) do
		UI.Section(content, T("ui.sec." .. section.Key), nextOrder(), section.Color)
		if section.Key == "crosshair" then
			local combatHud = ctx.Modules.CombatHud
			if combatHud and type(combatHud.MakePreview) == "function" then
				local ok, preview = pcall(combatHud.MakePreview, content)
				if ok and typeof(preview) == "Instance" and preview:IsA("GuiObject") then
					preview.LayoutOrder = nextOrder()
				end
			end
		end
		for _, path in ipairs(section.Items) do
			local entry = entryFor(path)
			if entry then
				local isChoice = entry.Type == "enum" or path == "Crosshair.Style"
				if entry.Type == "boolean" then
					boolRow(content, nextOrder(), path)
				elseif isChoice then
					enumRow(content, nextOrder(), path, entry)
				elseif entry.Type == "number" then
					numberRow(content, nextOrder(), path, entry)
				end
			end
		end
	end
	-- Info: Regeln + Einspruch (C19) + Version
	UI.Section(content, T("ui.sec.info"), nextOrder(), Theme.Gray)
	for _, key in ipairs({ "ui.info.rules", "ui.info.appeal" }) do
		UI.Label({
			Size = UDim2.new(1, 0, 0, 64),
			Text = T(key),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 17,
			Outline = 2,
			LayoutOrder = nextOrder(),
			Parent = content,
		})
	end
	local config = ctx.Config
	UI.Label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = T("core.version", tostring(config and config.Version or "?")),
		TextColor3 = Theme.SubText,
		MaxText = 16,
		Outline = 2,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
	for _, row in ipairs(rows) do
		row.Refresh()
	end
end

local function openWindow()
	if not window then
		window = UI.Window(T("ui.settingsTitle"), WINDOW_W, WINDOW_H, Theme.Blue)
		buildContent()
	elseif builtLang ~= ctx.Lang_() then
		buildContent()
	else
		for _, row in ipairs(rows) do
			row.Refresh()
		end
	end
	UI.OpenWindow(window)
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
end

function Settings.Open()
	ctx.Windows.Open("Settings")
end

-- ---------------------------------------------------------------------
-- FRAME (Bildrate) / TICK
-- ---------------------------------------------------------------------
function Settings.Frame(dt: number)
	if not focused or dt <= 0 then
		return
	end
	fpsAccum += dt
	fpsFrames += 1
	if fpsAccum < 0.5 then
		return
	end
	fps = fpsFrames / fpsAccum
	local window_ = fpsAccum
	fpsAccum = 0
	fpsFrames = 0
	local config = ctx.Config
	local auto = config and config.Client and config.Client.AutoReducedFx or {}
	local threshold = tonumber(auto.Fps) or 35
	local needed = tonumber(auto.Seconds) or 5
	local delay = tonumber(auto.StartDelay) or 15
	if autoDone or current.ReducedFx == true or os.clock() - startedAt < delay then
		lowFor = 0
		return
	end
	if fps < threshold then
		lowFor += window_
		if lowFor >= needed then
			autoDone = true
			Settings.Set("ReducedFx", true)
			UI.Toast(T("ui.autoReduced"), "Info")
		end
	else
		lowFor = 0
	end
end

function Settings.Tick()
	-- Sprache gewechselt, während das Fenster zu ist: beim nächsten Öffnen neu bauen (siehe openWindow)
	local win = window
	if win and win.IsOpen and builtLang ~= ctx.Lang_() then
		buildContent()
	end
end

function Settings.Init(context: any)
	ctx = context
	local initialState = ctx.State
	if type(initialState) == "table" and type(initialState.Settings) == "table" then
		mergeServer(initialState.Settings)
	end
	ctx.Windows.Register("Settings", openWindow, closeWindow)

	local hooks = ctx.Hooks
	hooks.On("State", function(newState, changed)
		if type(changed) == "table" and changed.Settings and type(newState) == "table" then
			mergeServer(newState.Settings)
		end
	end)
	-- Menü-Taste (M / Start / ⚙️-Knopf): offenes Fenster schließen, sonst Einstellungen öffnen
	local controls = ctx.Modules.Controls
	if controls and type(controls.Bind) == "function" then
		controls.Bind("Menu", function(state)
			if state ~= "Begin" then
				return
			end
			if ctx.Windows.IsOpen() then
				ctx.Windows.Close()
			else
				ctx.Windows.Open("Settings")
			end
		end)
	end
	local hud = ctx.Modules.Hud
	if hud and type(hud.AddRightButton) == "function" then
		hud.AddRightButton("⚙️", "ui.btn.settings", Theme.Gray, 90, function()
			ctx.Windows.Toggle("Settings")
		end)
	end
	UserInputService.WindowFocused:Connect(function()
		focused = true
		fpsAccum, fpsFrames, lowFor = 0, 0, 0
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		focused = false
	end)
end

function Settings.Start()
	startedAt = os.clock()
	fire() -- alle Module bekommen die Startwerte
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">Sfx</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Sounds nur aus eingebauten Dateien (Client/Modules/Sfx)
--  Besitzer: WP10 (Client-Hülle). Vertrag: DESIGN.md C7.4, B14.1, docs/ASSETS.md §2.2.
--
--  Jede Rolle (z. B. "RifleShot", "Headshot", "Kill") ist ein REZEPT aus den 11 eingebauten
--  Roblox-Sounds: Tonhöhe (PlaybackSpeed), Ausschnitt (PlaybackRegion), Effekte (Verzerrung,
--  Equalizer, Echo) und mehrere Schichten nacheinander (Jingles). Trägt der Besitzer in
--  Config.Client.Sounds.<Rolle> eine Audio-ID ein (≠ 0), wird stattdessen diese gespielt.
--  Feste Stimmen-Vorräte (Pools.Sounds: halb 2D, halb 3D) im Rundlauf – kein neues Sound-Objekt
--  pro Schuss. Lautstärke über SoundGroups (Einstellungen Sfx / Ui / Musik).
--
--  Öffentliche API:
--    Sfx.Play(role, pos?, opts?)        opts { Volume?, Speed? } – pos = 3D-Sound an dieser Stelle
--    Sfx.Has(role): boolean             gibt es ein Rezept/eine ID für die Rolle?
--    Sfx.Duck(amount, seconds)          andere Kampf-Sounds kurz leiser (Treffer-Stopp, Kill-Bestätigung)
--    Sfx.SetMusic(kind?)                "Lobby" | "Match" | nil – nur mit eingetragener Musik-ID
--    Sfx.ApplySettings(settings)        Lautstärken übernehmen (macht der "Settings"-Hook automatisch)
--    Sfx.Init(ctx) / Sfx.Start()
-- =====================================================================

local ContentProvider = game:GetService("ContentProvider")
local SoundService = game:GetService("SoundService")

local Sfx = {}

local ctx: any = nil

-- Die eingebauten Dateien (exakte Pfade aus docs/ASSETS.md §2 – nichts anderes benutzen!)
local FILES = {
	Boom = "rbxasset://sounds/impact_explosion_03.mp3",
	Land = "rbxasset://sounds/action_jump_land.mp3",
	Tick = "rbxasset://sounds/volume_slider.ogg",
	Jump = "rbxasset://sounds/action_jump.mp3",
	GetUp = "rbxasset://sounds/action_get_up.mp3",
	Wind = "rbxasset://sounds/action_falling.ogg",
	Water = "rbxasset://sounds/impact_water.mp3",
	Ouch = "rbxasset://sounds/ouch.ogg",
	Oof = "rbxasset://sounds/oof.ogg",
}

type Echo = { Delay: number, Feedback: number, Wet: number }
type Layer = {
	File: string,
	Speed: number,
	Vol: number,
	Region: { number }?, -- { Start, Ende } in Sekunden der Original-Datei
	Delay: number?, -- Sekunden nach der ersten Schicht
	Dist: number?, -- DistortionSoundEffect.Level
	EqLow: number?,
	EqMid: number?,
	EqHigh: number?,
	Echo: Echo?,
	Jitter: number?, -- ± Anteil zufällige Tonhöhe (0.04 = ±4 %)
	Range: number?, -- RollOffMaxDistance (3D)
}
type Recipe = { Group: string, Layers: { Layer } }

local ECHO_DING: Echo = { Delay = 0.08, Feedback = 0.2, Wet = -6 }
local ECHO_SNIPER: Echo = { Delay = 0.15, Feedback = 0.25, Wet = -8 }
local ECHO_JINGLE: Echo = { Delay = 0.12, Feedback = 0.3, Wet = -4 }

-- Gruppen: SFX (wird beim Treffer-Stopp kurz leiser), HIT (Treffer-Töne – nie geduckt), UI, MUSIC
local function notes(file: string, speeds: { number }, gap: number, vol: number, extra: { [string]: any }?): { Layer }
	local list: { Layer } = {}
	for i, speed in ipairs(speeds) do
		local layer: Layer = { File = file, Speed = speed, Vol = vol, Delay = (i - 1) * gap }
		if extra then
			if extra.EchoLast and i == #speeds then
				layer.Echo = ECHO_JINGLE
			end
			if extra.EchoAll then
				layer.Echo = ECHO_JINGLE
			end
			if extra.EqHigh then
				layer.EqHigh = extra.EqHigh
			end
		end
		table.insert(list, layer)
	end
	return list
end

-- Startwerte aus ASSETS.md §2.2 (nach Gehör im Studio nachstellen)
local RECIPES: { [string]: Recipe } = {
	PistolShot = {
		Group = "SFX",
		Layers = {
			{
				File = FILES.Boom,
				Speed = 2.4,
				Vol = 0.6,
				Region = { 0, 0.3 },
				Dist = 0.5,
				EqLow = -6,
				EqHigh = 4,
				Jitter = 0.04,
			},
			{ File = FILES.Land, Speed = 3.0, Vol = 0.35, Jitter = 0.04 },
		},
	},
	RifleShot = {
		Group = "SFX",
		Layers = {
			{ File = FILES.Boom, Speed = 3.0, Vol = 0.45, Region = { 0, 0.2 }, Dist = 0.6, EqHigh = 6, Jitter = 0.04 },
		},
	},
	SmgShot = {
		Group = "SFX",
		Layers = {
			{ File = FILES.Boom, Speed = 3.3, Vol = 0.4, Region = { 0, 0.16 }, Dist = 0.6, EqHigh = 6, Jitter = 0.04 },
		},
	},
	ShotgunShot = {
		Group = "SFX",
		Layers = {
			{ File = FILES.Boom, Speed = 1.7, Vol = 0.8, Region = { 0, 0.5 }, Dist = 0.75, EqLow = 4, Jitter = 0.04 },
			{ File = FILES.GetUp, Speed = 1.8, Vol = 0.4, Region = { 0, 0.25 }, Delay = 0.32 }, -- Pump
		},
	},
	SniperShot = {
		Group = "SFX",
		Layers = {
			{ File = FILES.Boom, Speed = 1.3, Vol = 0.9, Dist = 0.4, Echo = ECHO_SNIPER, Jitter = 0.03, Range = 600 },
		},
	},
	CannonShot = {
		Group = "SFX",
		Layers = {
			{ File = FILES.Boom, Speed = 1.5, Vol = 0.75, Region = { 0, 0.45 }, Dist = 0.5, EqLow = 6, Jitter = 0.04 },
		},
	},
	RocketLaunch = {
		Group = "SFX",
		Layers = { { File = FILES.Wind, Speed = 2.2, Vol = 0.6, Region = { 0, 0.6 }, EqHigh = 6, Jitter = 0.03 } },
	},
	Explosion = {
		Group = "SFX",
		Layers = { { File = FILES.Boom, Speed = 1.0, Vol = 1.0, Dist = 0.2, Jitter = 0.1, Range = 500 } },
	},
	DryFire = { Group = "SFX", Layers = { { File = FILES.Tick, Speed = 0.8, Vol = 0.5 } } },
	MagOut = { Group = "SFX", Layers = { { File = FILES.Land, Speed = 3.2, Vol = 0.5, EqHigh = 4 } } },
	MagIn = { Group = "SFX", Layers = { { File = FILES.Land, Speed = 2.6, Vol = 0.5, Dist = 0.2 } } },
	Bolt = { Group = "SFX", Layers = { { File = FILES.GetUp, Speed = 2.0, Vol = 0.5, Region = { 0, 0.25 } } } },
	LowAmmo = { Group = "SFX", Layers = notes(FILES.Tick, { 1.2, 1.2 }, 0.07, 0.4) },
	Equip = {
		Group = "SFX",
		Layers = {
			{ File = FILES.Jump, Speed = 2.2, Vol = 0.3 },
			{ File = FILES.Land, Speed = 3.0, Vol = 0.3, Delay = 0.08 },
		},
	},
	MeleeSwing = { Group = "SFX", Layers = { { File = FILES.Jump, Speed = 1.8, Vol = 0.5, Jitter = 0.05 } } },
	MeleeHit = {
		Group = "SFX",
		Layers = {
			{ File = FILES.Land, Speed = 1.4, Vol = 0.6, Dist = 0.3, Jitter = 0.05 },
			{ File = FILES.Tick, Speed = 1.2, Vol = 0.3 },
		},
	},
	Throw = { Group = "SFX", Layers = { { File = FILES.Jump, Speed = 1.5, Vol = 0.45, Jitter = 0.05 } } },
	Heal = { Group = "SFX", Layers = notes(FILES.Tick, { 1.26, 1.5 }, 0.08, 0.4) },
	Water = { Group = "SFX", Layers = { { File = FILES.Water, Speed = 1.3, Vol = 0.5, Jitter = 0.05 } } },
	Slide = { Group = "SFX", Layers = { { File = FILES.Wind, Speed = 1.6, Vol = 0.35, Region = { 0, 0.5 } } } },
	-- Treffer-Feedback (B14.1 + SKILL-WÜNSCHE): knackig, hoch, kurz – eigene Gruppe, wird nie geduckt
	Hitmarker = { Group = "HIT", Layers = { { File = FILES.Tick, Speed = 1.6, Vol = 0.55 } } },
	Headshot = {
		Group = "HIT",
		Layers = {
			{ File = FILES.Tick, Speed = 2.2, Vol = 0.75, Echo = ECHO_DING },
			{ File = FILES.Tick, Speed = 2.8, Vol = 0.75, Echo = ECHO_DING, Delay = 0.05 },
		},
	},
	Kill = { Group = "HIT", Layers = notes(FILES.Tick, { 1.0, 1.26, 1.5 }, 0.06, 0.75) },
	Eliminated = { Group = "HIT", Layers = { { File = FILES.Ouch, Speed = 1.0, Vol = 0.6 } } },
	Hurt = { Group = "SFX", Layers = { { File = FILES.Ouch, Speed = 1.15, Vol = 0.22 } } }, -- leise, nur ≤ 30 HP
	-- Oberfläche
	UIClick = { Group = "UI", Layers = { { File = FILES.Tick, Speed = 1.0, Vol = 0.5 } } },
	UIHover = { Group = "UI", Layers = { { File = FILES.Tick, Speed = 1.5, Vol = 0.2 } } },
	UIError = { Group = "UI", Layers = { { File = FILES.Land, Speed = 0.7, Vol = 0.5 } } },
	Countdown = { Group = "UI", Layers = { { File = FILES.Tick, Speed = 1.0, Vol = 0.7 } } },
	Go = {
		Group = "UI",
		Layers = {
			{ File = FILES.Tick, Speed = 2.0, Vol = 0.7 },
			{ File = FILES.Tick, Speed = 1.5, Vol = 0.5 },
		},
	},
	Win = { Group = "UI", Layers = notes(FILES.Tick, { 1.0, 1.26, 1.5, 2.0 }, 0.09, 0.8, { EchoLast = true }) },
	Lose = { Group = "UI", Layers = notes(FILES.Tick, { 1.0, 0.841, 0.667 }, 0.16, 0.7, { EqHigh = -6 }) },
	LevelUp = { Group = "UI", Layers = notes(FILES.Tick, { 1.0, 1.26, 1.5, 2.0 }, 0.09, 0.8, { EchoAll = true }) },
	Oof = { Group = "UI", Layers = { { File = FILES.Oof, Speed = 1.0, Vol = 0.4 } } },
}

-- Rollen ohne eingebautes Rezept (nur mit eigener ID): Musik
local MUSIC_ROLES = { LobbyMusic = true, MatchMusic = true }
-- Treffer-Töne, die die Einstellung "Treffer-Ton" abschaltet
local HIT_SOUND_ROLES = { Hitmarker = true, Headshot = true }

local DEDUPE_GAP = 0.025 -- dieselbe Rolle innerhalb so kurzer Zeit nur einmal (zwei Module melden denselben Treffer)
local DEFAULT_RANGE = 300
local MIN_RANGE = 10
local WARN_GAP = 30

type Voice = {
	Sound: Sound,
	Dist: DistortionSoundEffect,
	Eq: EqualizerSoundEffect,
	Echo: EchoSoundEffect,
	Attachment: Attachment?,
	StartedAt: number,
}

local voices2D: { Voice } = {}
local voices3D: { Voice } = {}
local next2D = 1
local next3D = 1
local groups: { [string]: SoundGroup } = {}
local baseVolume: { [string]: number } = { SFX = 1, HIT = 1, UI = 0.8, MUSIC = 0.5 }
local duckFactor = 1
local duckToken = 0
local lastPlayed: { [string]: number } = {}
local warnedRole: { [string]: number } = {}
local hitSoundOn = true
local anchorPart: Part? = nil
local musicSound: Sound? = nil
local musicKind: string? = nil
local random = Random.new()

-- ---------------------------------------------------------------------
-- AUFBAU
-- ---------------------------------------------------------------------
local function makeVoice(parent: Instance, name: string, attachment: Attachment?): Voice
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.Volume = 0.5
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = MIN_RANGE
	sound.RollOffMaxDistance = DEFAULT_RANGE
	local dist = Instance.new("DistortionSoundEffect")
	dist.Enabled = false
	dist.Parent = sound
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Enabled = false
	eq.Parent = sound
	local echo = Instance.new("EchoSoundEffect")
	echo.Enabled = false
	echo.Parent = sound
	sound.Parent = parent
	return { Sound = sound, Dist = dist, Eq = eq, Echo = echo, Attachment = attachment, StartedAt = -math.huge }
end

local function makeGroup(name: string): SoundGroup
	local existing = SoundService:FindFirstChild("ClutchClash" .. name)
	if existing and existing:IsA("SoundGroup") then
		return existing
	end
	local group = Instance.new("SoundGroup")
	group.Name = "ClutchClash" .. name
	group.Volume = 1
	group.Parent = SoundService
	return group
end

local function applyGroupVolumes()
	for name, group in pairs(groups) do
		local volume = baseVolume[name] or 1
		if name == "SFX" then
			volume *= duckFactor
		end
		group.Volume = math.clamp(volume, 0, 2)
	end
end

local function build()
	groups.SFX = makeGroup("Sfx")
	groups.HIT = makeGroup("Hit")
	groups.UI = makeGroup("Ui")
	groups.MUSIC = makeGroup("Music")

	local poolSize = 24
	local config = ctx and ctx.Config
	local pools = config and config.Client and config.Client.Pools
	if pools and type(pools.Sounds) == "number" then
		poolSize = math.clamp(math.floor(pools.Sounds), 4, 64)
	end
	local half = math.max(2, math.floor(poolSize / 2))

	-- 2D-Stimmen: direkt im SoundService (überall gleich laut)
	local folder2D = Instance.new("Folder")
	folder2D.Name = "ClutchClashVoices"
	folder2D.Parent = SoundService
	for i = 1, half do
		table.insert(voices2D, makeVoice(folder2D, "Voice2D_" .. i, nil))
	end

	-- 3D-Stimmen: an Attachments eines unsichtbaren Ankers im Ursprung (WorldPosition = Klangquelle)
	local anchor = Instance.new("Part")
	anchor.Name = "ClutchClashSfxAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new()
	anchor.Parent = workspace
	anchorPart = anchor
	for i = 1, half do
		local attachment = Instance.new("Attachment")
		attachment.Name = "Voice3D_" .. i
		attachment.Parent = anchor
		table.insert(voices3D, makeVoice(attachment, "Sound", attachment))
	end

	local music = Instance.new("Sound")
	music.Name = "ClutchClashMusic"
	music.Looped = true
	music.Volume = 0.5
	music.SoundGroup = groups.MUSIC
	music.Parent = SoundService
	musicSound = music

	applyGroupVolumes()
end

-- Eingebaute Dateien einmal vorladen (sonst kann der allererste Schuss stumm sein)
local function preload()
	local list: { Instance } = {}
	for _, path in pairs(FILES) do
		local sound = Instance.new("Sound")
		sound.SoundId = path
		table.insert(list, sound)
	end
	local ok, err = pcall(function()
		ContentProvider:PreloadAsync(list)
	end)
	if not ok then
		warn("[Sfx] Vorladen fehlgeschlagen: " .. tostring(err))
	end
	for _, sound in ipairs(list) do
		sound:Destroy()
	end
end

-- ---------------------------------------------------------------------
-- ABSPIELEN
-- ---------------------------------------------------------------------
local function pickVoice(list: { Voice }, is3D: boolean): Voice?
	local count = #list
	if count == 0 then
		return nil
	end
	local start = if is3D then next3D else next2D
	local chosen: Voice? = nil
	local oldest: Voice? = nil
	for offset = 0, count - 1 do
		local index = (start + offset - 1) % count + 1
		local voice = list[index]
		if not voice.Sound.IsPlaying then
			chosen = voice
			if is3D then
				next3D = index % count + 1
			else
				next2D = index % count + 1
			end
			break
		end
		if not oldest or voice.StartedAt < oldest.StartedAt then
			oldest = voice
		end
	end
	return chosen or oldest -- alle belegt: die älteste Stimme wird übernommen
end

local function configure(voice: Voice, layer: Layer, group: SoundGroup?, volume: number, speed: number)
	local sound = voice.Sound
	if sound.SoundId ~= layer.File then
		sound.SoundId = layer.File
	end
	sound.SoundGroup = group
	local jitter = layer.Jitter or 0
	local pitch = layer.Speed * speed
	if jitter > 0 then
		pitch *= 1 + random:NextNumber(-jitter, jitter)
	end
	sound.PlaybackSpeed = math.clamp(pitch, 0.1, 8)
	sound.Volume = math.clamp(layer.Vol * volume, 0, 3)
	local region = layer.Region
	if region then
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(region[1], region[2])
	elseif sound.PlaybackRegionsEnabled then
		sound.PlaybackRegionsEnabled = false
	end
	sound.RollOffMaxDistance = layer.Range or DEFAULT_RANGE
	-- Effekte: nur einschalten, was die Schicht braucht (keine neuen Instanzen)
	local dist = layer.Dist
	voice.Dist.Enabled = dist ~= nil
	if dist then
		voice.Dist.Level = dist
	end
	local hasEq = layer.EqLow ~= nil or layer.EqMid ~= nil or layer.EqHigh ~= nil
	voice.Eq.Enabled = hasEq
	if hasEq then
		voice.Eq.LowGain = layer.EqLow or 0
		voice.Eq.MidGain = layer.EqMid or 0
		voice.Eq.HighGain = layer.EqHigh or 0
	end
	local echo = layer.Echo
	voice.Echo.Enabled = echo ~= nil
	if echo then
		voice.Echo.Delay = echo.Delay
		voice.Echo.Feedback = echo.Feedback
		voice.Echo.WetLevel = echo.Wet
		voice.Echo.DryLevel = 0
	end
end

local function playLayer(layer: Layer, groupName: string, pos: Vector3?, volume: number, speed: number)
	local is3D = pos ~= nil
	local voice = pickVoice(if is3D then voices3D else voices2D, is3D)
	if not voice then
		return
	end
	if voice.Sound.IsPlaying then
		voice.Sound:Stop()
	end
	configure(voice, layer, groups[groupName], volume, speed)
	local attachment = voice.Attachment
	if attachment and pos then
		attachment.WorldPosition = pos
	end
	voice.StartedAt = os.clock()
	voice.Sound.TimePosition = if layer.Region then layer.Region[1] else 0
	voice.Sound:Play()
end

-- Eigene Audio-ID aus der Config (0 = eingebautes Rezept)
local function customId(role: string): number
	local config = ctx and ctx.Config
	local sounds = config and config.Client and config.Client.Sounds
	local id = sounds and sounds[role]
	if type(id) == "number" and id > 0 and id % 1 == 0 then
		return id
	end
	return 0
end

local customRecipes: { [string]: Recipe } = {}
local function recipeFor(role: string): Recipe?
	local id = customId(role)
	if id > 0 then
		local cached = customRecipes[role]
		local path = "rbxassetid://" .. tostring(id)
		if not cached or cached.Layers[1].File ~= path then
			local base = RECIPES[role]
			cached = {
				Group = if base then base.Group elseif MUSIC_ROLES[role] then "MUSIC" else "SFX",
				Layers = { { File = path, Speed = 1, Vol = 0.6, Jitter = if base then base.Layers[1].Jitter else nil } },
			}
			customRecipes[role] = cached
		end
		return cached
	end
	return RECIPES[role]
end

function Sfx.Has(role: string): boolean
	return type(role) == "string" and recipeFor(role) ~= nil
end

function Sfx.Play(role: string, pos: Vector3?, opts: { Volume: number?, Speed: number? }?)
	if type(role) ~= "string" or MUSIC_ROLES[role] then
		return
	end
	if HIT_SOUND_ROLES[role] and not hitSoundOn then
		return
	end
	local recipe = recipeFor(role)
	if not recipe then
		local now = os.clock()
		if now - (warnedRole[role] or -math.huge) > WARN_GAP then
			warnedRole[role] = now
			warn("[Sfx] Unbekannte Sound-Rolle: " .. role)
		end
		return
	end
	local now = os.clock()
	local dedupeKey = if pos then role .. "@3d" else role
	if now - (lastPlayed[dedupeKey] or -math.huge) < DEDUPE_GAP then
		return
	end
	lastPlayed[dedupeKey] = now
	if pos and typeof(pos) ~= "Vector3" then
		pos = nil
	end
	local volume = 1
	local speed = 1
	if opts then
		if type(opts.Volume) == "number" and opts.Volume == opts.Volume then
			volume = math.clamp(opts.Volume, 0, 3)
		end
		if type(opts.Speed) == "number" and opts.Speed == opts.Speed then
			speed = math.clamp(opts.Speed, 0.25, 4)
		end
	end
	for _, layer in ipairs(recipe.Layers) do
		local delay = layer.Delay or 0
		if delay > 0 then
			task.delay(delay, playLayer, layer, recipe.Group, pos, volume, speed)
		else
			playLayer(layer, recipe.Group, pos, volume, speed)
		end
	end
end

-- Kampf-Sounds kurz leiser (Treffer-Töne bleiben laut) – fühlt sich wie ein kleiner "Treffer-Stopp" an
function Sfx.Duck(amount: number, seconds: number)
	if type(amount) ~= "number" or type(seconds) ~= "number" or amount ~= amount or seconds ~= seconds then
		return
	end
	duckToken += 1
	local token = duckToken
	duckFactor = 1 - math.clamp(amount, 0, 0.9)
	applyGroupVolumes()
	task.delay(math.clamp(seconds, 0.01, 1), function()
		if duckToken == token then
			duckFactor = 1
			applyGroupVolumes()
		end
	end)
end

function Sfx.SetMusic(kind: string?)
	local music = musicSound
	if not music then
		return
	end
	local role = if kind == "Lobby" then "LobbyMusic" elseif kind == "Match" then "MatchMusic" else nil
	local id = if role then customId(role) else 0
	if id == 0 then
		musicKind = nil
		if music.IsPlaying then
			music:Stop()
		end
		return
	end
	if musicKind == kind and music.IsPlaying then
		return
	end
	musicKind = kind
	music.SoundId = "rbxassetid://" .. tostring(id)
	music.TimePosition = 0
	music:Play()
end

local function settingNumber(settings: any, key: string, fallback: number): number
	local value = settings and settings[key]
	if type(value) == "number" and value == value then
		return math.clamp(value, 0, 1)
	end
	return fallback
end

function Sfx.ApplySettings(settings: { [string]: any }?)
	local sfx = settingNumber(settings, "Sfx", 1)
	baseVolume.SFX = sfx
	baseVolume.HIT = sfx
	baseVolume.UI = settingNumber(settings, "Ui", 0.8)
	baseVolume.MUSIC = settingNumber(settings, "Music", 0.5)
	hitSoundOn = not (settings and settings.HitSound == false)
	applyGroupVolumes()
end

function Sfx.Init(context: any)
	ctx = context
	build()
	local settingsModule = ctx.Modules and ctx.Modules.Settings
	if settingsModule and type(settingsModule.Get) == "function" then
		local ok, settings = pcall(settingsModule.Get)
		if ok then
			Sfx.ApplySettings(settings)
		end
	end
	ctx.Hooks.On("Settings", function(settings)
		Sfx.ApplySettings(settings)
	end)
	-- Musik je Welt (nur wenn der Besitzer eine Musik-ID eingetragen hat)
	ctx.Hooks.On("World", function(world)
		Sfx.SetMusic(if world == "Lobby" then "Lobby" else "Match")
	end)
end

function Sfx.Start()
	task.spawn(preload)
	Sfx.SetMusic("Lobby")
	if anchorPart and anchorPart.Parent == nil then
		anchorPart.Parent = workspace
	end
end

return Sfx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="134">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Shop-Fenster (Client/Modules/Shop)
--  Besitzer: WP9 (Wirtschaft, Monetarisierung, Kosmetik). Vertrag: DESIGN.md B21.1, B20, B22, B23, C7.4.
--  Tabs: Waffen (Münzen, "Gratis testen") · Täglich im Rampenlicht (6 Items −20 %, Timer) · Katalog ·
--  Kisten (Gem-Öffnung nur wenn erlaubt, mit Schlüssel immer) · Splitter · Gems & Pässe (Robux).
--  Kopf-Banner "ALLE WAFFEN ERSPIELBAR – KEIN PAY-TO-WIN". Vor JEDEM Kauf: "Details & Quoten".
--  Angezeigte Preise/Quoten kommen aus derselben Config wie der Server (Shop.PriceOf, Shared/Odds).
--  Außerdem: Kisten-Automat in der Lobby lokal verstecken, solange Zufallsitems nicht erlaubt sind;
--  VIP-Tür lokal öffnen (Player-Attribut "Vip").
--
--  Öffentliche API (C7.4):
--    Shop.Open(tab?)                        "Weapons" | "Featured" | "Catalog" | "Crates" | "Shards" | "Robux"
--    Shop.BuildStarterCard(parent): GuiObject?   Starter-Angebot (Ergebnis-Bildschirm, großer "Später"-Knopf)
-- =====================================================================

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Lang = require(Shared:WaitForChild("Lang"))
local Util = require(Shared:WaitForChild("Util"))
local Odds = require(Shared:WaitForChild("Odds"))

local Shop = {}
local ctx: any = nil
local UI: any = nil

local SHOP: any = Config.Shop
local COSMETICS: any = Config.Cosmetics
local TABS = { "Weapons", "Featured", "Catalog", "Crates", "Shards", "Robux" }
-- andere Namen, die Pakete/Prompts benutzen (z. B. Progress: Shop.Open("Pass"))
local TAB_ALIASES: { [string]: string } =
	{ Pass = "Robux", Passes = "Robux", Gems = "Robux", Crate = "Crates", Weapon = "Weapons", Spotlight = "Featured" }
local TAB_KEYS: { [string]: { string } } = {
	Weapons = { "Coins", "Weapons", "FreeWeaponPicks" },
	Featured = { "Featured", "Cosmetics", "Gems" },
	Catalog = { "Cosmetics", "Coins", "Gems", "Season" },
	Crates = { "Crates", "Keys", "Gems", "RandomAllowed" },
	Shards = { "Shards", "Cosmetics" },
	Robux = { "Passes", "Offer", "Boosts", "Pass" },
}
local CURRENCY_ICON: { [string]: string } = { Coins = "💰", Gems = "💎", Keys = "🔑", Shards = "🧩" }
local KIND_ORDER = { "Wrap", "Skin", "Charm", "Finisher", "Tracer" }
local KIND_ICON: { [string]: string } =
	{ Wrap = "🎨", Skin = "🔫", Charm = "🧸", Finisher = "✨", Tracer = "〰️" }
local SLOT_ORDER: { [string]: number } = { Primary = 1, Secondary = 2, Melee = 3, Utility = 4 }
local FIND_TRIES = 40 -- Lobby-Objekte (Kisten-Automat, VIP-Tür) so oft suchen (alle 3 s)
local TICKER_MAX = 36000 -- Rampenlicht-Timer: höchstens so viele Sekunden-Schritte pro Öffnung

local win: any = nil
local body: Frame? = nil
local dialog: Frame? = nil
local dialogList: ScrollingFrame? = nil
local dialogButtons: Frame? = nil
local dialogTitle: TextLabel? = nil
local tabButtons: { [string]: any } = {}
local currencyLabels: { [string]: TextLabel } = {}
local currentTab = "Weapons"
local pending = false
local renderQueued = false
local tickerToken = 0
local crateMachine: Instance? = nil
local crateMachineParent: Instance? = nil
local vipDoor: BasePart? = nil

-- =====================================================================
-- 1) HELFER
-- =====================================================================
local function lang(): "de" | "en"
	local ok, value = pcall(function()
		return ctx.Lang_()
	end)
	return if ok and value == "de" then "de" else "en"
end

local function t(key: string, ...: any): string
	return Lang.T(lang(), key, ...)
end

local function state(): { [string]: any }
	return if ctx and type(ctx.State) == "table" then ctx.State else {}
end

local function num(n: any): string
	return Util.FormatNumber(tonumber(n) or 0)
end

local function balance(currency: string): number
	return tonumber(state()[currency]) or 0
end

local function rarityColor(rarity: any): Color3
	local colors = Config.Colors and Config.Colors.Rarity
	return colors and colors[rarity] or UI.Theme.Gray
end

local function pick(name: any): string
	return if type(name) == "table" then Lang.Pick(lang(), name) else tostring(name)
end

local function seasonId(): number
	local season = state().Season
	if type(season) == "table" and type(season.Id) == "number" then
		return season.Id
	end
	return SHOP.SeasonIdAt(Config.Season and Config.Season.Seasons, os.time())
end

local function ownsCosmetic(id: string): boolean
	local cos = state().Cosmetics
	return type(cos) == "table" and type(cos.Owned) == "table" and cos.Owned[id] == true
end

local function ownsWeapon(key: string, def: any): boolean
	if def and def.Free then
		return true
	end
	local weapons = state().Weapons
	return type(weapons) == "table" and type(weapons.Owned) == "table" and weapons.Owned[key] == true
end

local function hasPass(key: string): boolean
	local passes = state().Passes
	return type(passes) == "table" and passes[key] == true
end

local function randomAllowed(): boolean?
	local ok, value = pcall(UI.RandomItemsAllowed)
	if ok then
		return value
	end
	local raw = state().RandomAllowed
	return if type(raw) == "boolean" then raw else nil
end

local function decimalSep(): string
	return if lang() == "de" then "," else "."
end

local function percent(hundredths: number): string
	return Odds.FormatPercent(hundredths, decimalSep()) .. " %"
end

local function changedHas(changed: any, key: string): boolean
	if type(changed) ~= "table" then
		return true
	end
	return changed[key] == true or table.find(changed, key) ~= nil
end

local function clear(frame: Instance)
	for _, child in ipairs(frame:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

-- Anfrage an den Server; Doppelklick-Schutz bis zur Antwort (MH-Fix §14.1 #4)
local function request(action: string, arg: any, onOk: ((any) -> ())?)
	if pending then
		return
	end
	pending = true
	task.spawn(function()
		local ok, reply = pcall(ctx.RequestFull, action, arg, true) -- silent: Meldung zeigen wir selbst
		pending = false
		if not ok or type(reply) ~= "table" then
			ctx.Toast(t("shop.noAnswer"), "Error")
			return
		end
		if type(reply.Message) == "string" and reply.Message ~= "" then
			ctx.Toast(reply.Message, if reply.Ok then "Success" else "Error")
		end
		if reply.Ok and onOk then
			onOk(reply)
		end
	end)
end

local function modules(): { [string]: any }
	return if ctx and type(ctx.Modules) == "table" then ctx.Modules else {}
end

-- =====================================================================
-- 2) "DETAILS & QUOTEN" – Dialog vor jedem Kauf
-- =====================================================================
type DialogButton = { Text: string, Color: Color3?, OnClick: (() -> ())?, Enabled: boolean? }
type DialogSpec = { Title: string, Color: Color3?, Lines: { string }, Crate: any?, Buttons: { DialogButton } }

local function hideDialog()
	if dialog then
		dialog.Visible = false
	end
end

local function addLine(parent: Instance, textValue: string, order: number, color: Color3?, height: number?)
	UI.Label({
		Size = UDim2.new(1, -8, 0, height or 26),
		Text = textValue,
		TextColor3 = color or Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		MaxText = 18,
		Outline = 2,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function addOdds(parent: Instance, crateDef: any, startOrder: number): number
	local order = startOrder
	addLine(parent, t("shop.odds.byRarity"), order, UI.Theme.Yellow)
	order += 1
	for _, row in ipairs(Odds.RarityTable(crateDef, false)) do
		addLine(
			parent,
			("%s (%d): %s"):format(t("item.rarity." .. row.Rarity), row.Count, percent(row.Hundredths)),
			order,
			rarityColor(row.Rarity)
		)
		order += 1
	end
	addLine(parent, t("shop.odds.items"), order, UI.Theme.Yellow)
	order += 1
	local total = 0
	for _, row in ipairs(Odds.Table(crateDef)) do
		local def = COSMETICS.ById[row.Id]
		local name = if def then pick(def.Name) else row.Id
		local kind = if def then t("item.kind." .. def.Kind) else ""
		addLine(parent, ("%s – %s: %s"):format(name, kind, percent(row.Hundredths)), order, rarityColor(row.Rarity))
		total += row.Hundredths
		order += 1
	end
	addLine(parent, t("shop.odds.sum", percent(total)), order, UI.Theme.Cash)
	order += 1
	local pityAfter = tonumber(crateDef.PityAfter) or 29
	addLine(parent, t("shop.odds.pityRule", pityAfter, pityAfter + 1), order, UI.Theme.Yellow, 46)
	order += 1
	for _, row in ipairs(Odds.PityTable(crateDef)) do
		local def = COSMETICS.ById[row.Id]
		addLine(
			parent,
			("  %s: %s"):format(if def then pick(def.Name) else row.Id, percent(row.Hundredths)),
			order,
			rarityColor(row.Rarity)
		)
		order += 1
	end
	addLine(
		parent,
		t(
			"shop.odds.dupes",
			SHOP.DupeShards.Common,
			SHOP.DupeShards.Rare,
			SHOP.DupeShards.Epic,
			SHOP.DupeShards.Legendary,
			SHOP.DupeShards.Mythic
		),
		order,
		nil,
		46
	)
	return order + 1
end

local function showDialog(spec: DialogSpec)
	local frame, list, buttons, title = dialog, dialogList, dialogButtons, dialogTitle
	if not (frame and list and buttons and title) then
		return
	end
	title.Text = UI.Upper(t("shop.oddsTitle") .. " · " .. spec.Title)
	title.TextColor3 = spec.Color or Color3.new(1, 1, 1)
	clear(list)
	clear(buttons)
	local order = 1
	for _, line in ipairs(spec.Lines) do
		addLine(list, line, order, nil, 30)
		order += 1
	end
	if spec.Crate then
		addOdds(list, spec.Crate, order)
	end
	list.CanvasPosition = Vector2.zero
	for i, button in ipairs(spec.Buttons) do
		local enabled = button.Enabled ~= false
		UI.Button({
			Size = UDim2.fromOffset(190, 48),
			Text = button.Text,
			Color = if enabled then (button.Color or UI.Theme.Green) else UI.Theme.Gray,
			MaxText = 18,
			LayoutOrder = i,
			Parent = buttons,
		}, function()
			if enabled and button.OnClick then
				hideDialog()
				button.OnClick()
			end
		end)
	end
	UI.Button({
		Size = UDim2.fromOffset(150, 48),
		Text = t("shop.cancel"),
		Color = UI.Theme.Red,
		LayoutOrder = 99,
		Parent = buttons,
	}, hideDialog)
	frame.Visible = true
end

local function buildDialog(panel: Frame)
	local frame = UI.Create("Frame", {
		Name = "Details",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(20, 24, 48),
		BackgroundTransparency = 0.08,
		Visible = false,
		Active = true,
		ZIndex = 30,
		Parent = panel,
	}, { UI.Corner(20) })
	dialogTitle = UI.Label({
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 40),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 26,
		Outline = 3,
		Parent = frame,
	})
	dialogList = UI.Create("ScrollingFrame", {
		Position = UDim2.fromOffset(16, 56),
		Size = UDim2.new(1, -32, 1, -130),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = frame,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }) })
	dialogButtons = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.new(1, -32, 0, 56),
		BackgroundTransparency = 1,
		Parent = frame,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 10),
		}),
	})
	dialog = frame
end

-- =====================================================================
-- 3) KARTEN
-- =====================================================================
local function card(
	parent: Instance,
	order: number,
	titleText: string,
	color: Color3,
	lines: { string },
	buttonText: string,
	buttonColor: Color3,
	onClick: () -> (),
	enabled: boolean?
): (Frame, { TextLabel })
	local frame = UI.Card({ Size = UDim2.fromOffset(180, 156), LayoutOrder = order, Parent = parent })
	local lineLabels: { TextLabel } = {}
	UI.Label({
		Position = UDim2.fromOffset(6, 4),
		Size = UDim2.new(1, -12, 0, 30),
		Text = titleText,
		TextColor3 = color,
		TextWrapped = true,
		MaxText = 18,
		Outline = 2,
		Parent = frame,
	})
	for i, line in ipairs(lines) do
		if i > 3 then
			break
		end
		table.insert(
			lineLabels,
			UI.Label({
				Position = UDim2.fromOffset(6, 34 + (i - 1) * 22),
				Size = UDim2.new(1, -12, 0, 22),
				Text = line,
				TextWrapped = true,
				MaxText = 15,
				Outline = 2,
				Parent = frame,
			})
		)
	end
	local on = enabled ~= false
	UI.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.new(1, -14, 0, 42),
		Text = buttonText,
		Color = if on then buttonColor else UI.Theme.Gray,
		MaxText = 16,
		Parent = frame,
	}, function()
		if on then
			onClick()
		end
	end)
	return frame, lineLabels
end

local function grid(parent: Instance, order: number): Frame
	return UI.Grid(parent, order, 180, 156)
end

-- =====================================================================
-- 4) KOSMETIK-KAUF (Katalog, Rampenlicht, Splitter)
-- =====================================================================
local function cosmeticLines(def: any): { string }
	local lines = { t("item.kind." .. def.Kind) .. " · " .. t("item.rarity." .. tostring(def.Rarity)) }
	if def.Kind == "Skin" and type(def.Weapon) == "string" then
		local weapon = Config.Weapon(def.Weapon)
		table.insert(lines, t("shop.forWeapon", if weapon then pick(weapon.Name) else def.Weapon))
	elseif def.Kind == "Wrap" or def.Kind == "Charm" then
		table.insert(lines, t("shop.anyWeapon"))
	end
	if def.Anim then
		table.insert(lines, t("shop.animated"))
	end
	return lines
end

local function openCosmeticDetails(id: string, currencies: { string }, featured: boolean)
	local def = COSMETICS.ById[id]
	if def == nil then
		return
	end
	local lines = cosmeticLines(def)
	table.insert(lines, t("item.source." .. tostring(def.Source)))
	table.insert(lines, t("shop.cosmeticOnly"))
	local buttons: { DialogButton } = {}
	local owned = ownsCosmetic(id)
	for _, currency in ipairs(currencies) do
		local price = SHOP.PriceOf(COSMETICS, id, currency, seasonId(), featured and currency == "Gems")
		if price then
			table.insert(buttons, {
				Text = ("%s %s %s"):format(t("shop.buy"), num(price), CURRENCY_ICON[currency]),
				Color = if currency == "Coins" then UI.Theme.Orange else UI.Theme.Purple,
				Enabled = not owned and balance(currency) >= price,
				OnClick = function()
					request("BuyItem", { Id = id, Currency = currency, Featured = featured or nil })
				end,
			})
		end
	end
	if owned then
		table.insert(lines, t("shop.ownedLine"))
	end
	showDialog({ Title = pick(def.Name), Color = rarityColor(def.Rarity), Lines = lines, Buttons = buttons })
end

local function cosmeticCard(parent: Instance, order: number, id: string, currencies: { string }, featured: boolean)
	local def = COSMETICS.ById[id]
	if def == nil then
		return
	end
	local owned = ownsCosmetic(id)
	local priceText = ""
	for _, currency in ipairs(currencies) do
		local price = SHOP.PriceOf(COSMETICS, id, currency, seasonId(), featured and currency == "Gems")
		if price then
			local base = if featured and currency == "Gems"
				then SHOP.PriceOf(COSMETICS, id, currency, seasonId(), false)
				else nil
			local part = if base and base ~= price
				then ("%s→%s %s"):format(num(base), num(price), CURRENCY_ICON[currency])
				else ("%s %s"):format(num(price), CURRENCY_ICON[currency])
			priceText = if priceText == "" then part else priceText .. " / " .. part
		end
	end
	local lines =
		{ (KIND_ICON[def.Kind] or "") .. " " .. t("item.kind." .. def.Kind), t("item.rarity." .. tostring(def.Rarity)) }
	table.insert(lines, if owned then t("shop.ownedLine") else priceText)
	card(parent, order, pick(def.Name), rarityColor(def.Rarity), lines, t("shop.details"), UI.Theme.Blue, function()
		openCosmeticDetails(id, currencies, featured)
	end)
end

local function sortedCosmetics(filter: (id: string, def: any) -> boolean): { string }
	local list: { string } = {}
	for id, def in pairs(COSMETICS.ById) do
		if filter(id, def) then
			table.insert(list, id)
		end
	end
	table.sort(list, function(a, b)
		local da, db = COSMETICS.ById[a], COSMETICS.ById[b]
		local ra = COSMETICS.RarityRank[da.Rarity] or 0
		local rb = COSMETICS.RarityRank[db.Rarity] or 0
		if ra ~= rb then
			return ra < rb
		end
		return a < b
	end)
	return list
end

-- =====================================================================
-- 5) TABS
-- =====================================================================
local Builders: { [string]: (Frame) -> () } = {}

Builders.Weapons = function(root)
	local list = Config.Weapons and Config.Weapons.List
	if type(list) ~= "table" or #list == 0 then
		addLine(root, t("shop.noWeapons"), 1)
		return
	end
	local weapons = {}
	for _, def in ipairs(list) do
		if type(def) == "table" and not def.AdminOnly then
			table.insert(weapons, def)
		end
	end
	table.sort(weapons, function(a, b)
		local sa, sb = SLOT_ORDER[a.Slot] or 9, SLOT_ORDER[b.Slot] or 9
		if sa ~= sb then
			return sa < sb
		end
		return (a.Id or 0) < (b.Id or 0)
	end)
	-- Gratis-Waffen-Wahl: State-Schlüssel "FreeWeaponPicks" (WP8), sonst Weapons.FreePicks (WP9)
	local freePicks = tonumber(state().FreeWeaponPicks)
	if freePicks == nil then
		local weaponsState = state().Weapons
		freePicks = if type(weaponsState) == "table" then tonumber(weaponsState.FreePicks) or 0 else 0
	end
	if freePicks > 0 then
		addLine(root, t("shop.freePicks", freePicks), 1, UI.Theme.Cash)
	end
	local g = grid(root, 2)
	for i, def in ipairs(weapons) do
		local owned = ownsWeapon(def.Key, def)
		local lines = { t("shop.slot." .. tostring(def.Slot)) }
		if def.Enabled == false then
			table.insert(lines, t("shop.weaponOff"))
		end
		table.insert(
			lines,
			if def.Free then t("shop.free") elseif owned then t("shop.ownedLine") else ("%s 💰"):format(num(def.Price))
		)
		card(g, i, pick(def.Name), Color3.new(1, 1, 1), lines, t("shop.details"), UI.Theme.Blue, function()
			local buttons: { DialogButton } = {}
			if not owned then
				table.insert(buttons, {
					Text = ("%s %s 💰"):format(t("shop.buy"), num(def.Price)),
					Color = UI.Theme.Orange,
					Enabled = balance("Coins") >= (tonumber(def.Price) or math.huge),
					OnClick = function()
						request("BuyWeapon", def.Key)
					end,
				})
				if freePicks > 0 then
					table.insert(buttons, {
						Text = t("shop.pickFree"),
						Color = UI.Theme.Green,
						OnClick = function()
							request("ClaimLevelPick", def.Key)
						end,
					})
				end
			end
			table.insert(buttons, {
				Text = t("shop.tryFree"),
				Color = UI.Theme.Cyan,
				OnClick = function()
					local training = modules().Training
					if training and type(training.Open) == "function" then
						ctx.Windows.Close("Shop")
						pcall(training.Open)
					else
						ctx.Toast(t("shop.tryHint"), "Info")
					end
				end,
			})
			local detail = {
				t("shop.slot." .. tostring(def.Slot)),
				t("shop.weaponStats", tonumber(def.Damage) or 0, tonumber(def.Mag) or 0),
				t("shop.noP2WShort"),
			}
			showDialog({ Title = pick(def.Name), Lines = detail, Buttons = buttons })
		end)
	end
end

local function updateTicker(label: TextLabel, endsAt: number)
	tickerToken += 1
	local token = tickerToken
	task.spawn(function()
		for _ = 1, TICKER_MAX do
			if token ~= tickerToken or not (win and win.IsOpen) or label.Parent == nil then
				return
			end
			local left = math.max(0, endsAt - os.time())
			label.Text = t("shop.featuredTimer", Util.FormatTime(left))
			task.wait(1)
		end
	end)
end

Builders.Featured = function(root)
	local featured = state().Featured
	if type(featured) ~= "table" or type(featured.Ids) ~= "table" then
		addLine(root, t("core.loading"), 1)
		return
	end
	local timer = UI.Label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = "",
		TextColor3 = UI.Theme.Yellow,
		MaxText = 20,
		Outline = 2,
		LayoutOrder = 1,
		Parent = root,
	})
	updateTicker(timer, tonumber(featured.EndsAt) or 0)
	local g = grid(root, 2)
	for i, id in ipairs(featured.Ids) do
		cosmeticCard(g, i, id, { "Gems" }, true)
	end
end

Builders.Catalog = function(root)
	local season = seasonId()
	local order = 1
	for _, kind in ipairs(KIND_ORDER) do
		local ids = sortedCosmetics(function(id, def)
			return def.Kind == kind
				and (
					SHOP.PriceOf(COSMETICS, id, "Gems", season, false) ~= nil
					or SHOP.PriceOf(COSMETICS, id, "Coins", season, false) ~= nil
				)
		end)
		if #ids > 0 then
			UI.Section(root, (KIND_ICON[kind] or "") .. " " .. t("item.kinds." .. kind), order)
			order += 1
			local g = grid(root, order)
			order += 1
			for i, id in ipairs(ids) do
				cosmeticCard(g, i, id, { "Coins", "Gems" }, false)
			end
		end
	end
end

local function openCrate(use: string)
	request("OpenCrate", { Crate = "S1", Use = use }, function(reply)
		local reveal = modules().CrateReveal
		if reply.Result and reveal and type(reveal.Play) == "function" then
			reveal.Play(reply.Result)
		end
	end)
end

Builders.Crates = function(root)
	local crateDef = SHOP.Crates.S1
	local crates = state().Crates
	local pity = if type(crates) == "table" then tonumber(crates.Pity) or 0 else 0
	local pityAfter = tonumber(crateDef.PityAfter) or 29
	local allowed = randomAllowed()
	UI.Section(root, "🎁 " .. pick(crateDef.Name), 1)
	local left = pityAfter + 1 - pity
	addLine(root, if left <= 1 then t("shop.pityNext") else t("shop.pityLeft", left), 2, UI.Theme.Yellow)
	addLine(root, t("shop.keysHave", balance("Keys")), 3)
	local row = UI.Row(root, 4, 54)
	local keys = balance("Keys")
	UI.Button({
		Size = UDim2.fromOffset(220, 50),
		Text = t("shop.oddsTitle"),
		Color = UI.Theme.Blue,
		LayoutOrder = 1,
		Parent = row,
	}, function()
		showDialog({ Title = pick(crateDef.Name), Lines = { t("shop.crateIntro") }, Crate = crateDef, Buttons = {} })
	end)
	UI.Button({
		Size = UDim2.fromOffset(240, 50),
		Text = t("shop.openKey"),
		Color = if keys >= 1 then UI.Theme.Green else UI.Theme.Gray,
		LayoutOrder = 2,
		Parent = row,
	}, function()
		showDialog({
			Title = pick(crateDef.Name),
			Lines = { t("shop.crateIntro") },
			Crate = crateDef,
			Buttons = {
				{
					Text = t("shop.openKey"),
					Enabled = keys >= 1,
					OnClick = function()
						openCrate("Key")
					end,
				},
			},
		})
	end)
	if allowed == true then -- Gem-Öffnung nur, wenn bezahlte Zufallsitems erlaubt sind (B20.2)
		local price = tonumber(crateDef.GemPrice) or 120
		UI.Button({
			Size = UDim2.fromOffset(240, 50),
			Text = t("shop.openGems", price),
			Color = if balance("Gems") >= price then UI.Theme.Purple else UI.Theme.Gray,
			LayoutOrder = 3,
			Parent = row,
		}, function()
			showDialog({
				Title = pick(crateDef.Name),
				Lines = { t("shop.crateIntro") },
				Crate = crateDef,
				Buttons = {
					{
						Text = t("shop.openGems", price),
						Color = UI.Theme.Purple,
						Enabled = balance("Gems") >= price,
						OnClick = function()
							openCrate("Gems")
						end,
					},
				},
			})
		end)
	elseif allowed == false then
		addLine(root, t("shop.restricted") .. " – " .. t("shop.keysStillOk"), 5, UI.Theme.SubText)
	end
	addLine(root, t("shop.crateSingle"), 6, UI.Theme.SubText)
	local g = grid(root, 7)
	for i, item in ipairs(crateDef.Items) do
		local def = COSMETICS.ById[item.Id]
		if def then
			local lines = { t("item.kind." .. def.Kind), percent(item.Weight) }
			if ownsCosmetic(item.Id) then
				table.insert(lines, t("shop.ownedLine"))
			end
			card(g, i, pick(def.Name), rarityColor(item.Rarity), lines, t("shop.details"), UI.Theme.Blue, function()
				openCosmeticDetails(item.Id, { "Gems" }, false)
			end)
		end
	end
end

Builders.Shards = function(root)
	addLine(root, t("shop.shardsHave", balance("Shards")), 1, UI.Theme.Yellow)
	addLine(root, t("shop.shardsIntro"), 2, UI.Theme.SubText, 40)
	local g = grid(root, 3)
	local items = table.clone(SHOP.Crates.S1.Items)
	table.sort(items, function(a, b)
		local ra = COSMETICS.RarityRank[a.Rarity] or 0
		local rb = COSMETICS.RarityRank[b.Rarity] or 0
		if ra ~= rb then
			return ra < rb
		end
		return a.Id < b.Id
	end)
	for i, item in ipairs(items) do
		cosmeticCard(g, i, item.Id, { "Shards" }, false)
	end
end

-- Robux-Produkte: Beschreibung aus dem Grant
local function productLines(product: any): { string }
	local lines: { string } = {}
	local grant = product.Grant or {}
	local offer = state().Offer
	local firstUsed = type(offer) == "table"
		and type(offer.FirstPack) == "table"
		and offer.FirstPack[product.Key] == true
	if type(grant.Gems) == "number" then
		table.insert(lines, ("+%s 💎"):format(num(grant.Gems)))
		if product.FirstBonus and not firstUsed then
			table.insert(lines, t("shop.firstX2"))
		end
	end
	if grant.PassPremium then
		table.insert(lines, t("shop.desc.premium"))
	end
	if type(grant.PassTiers) == "number" then
		table.insert(lines, t("shop.desc.tiers", grant.PassTiers))
	end
	if type(grant.XpBoostSeconds) == "number" then
		table.insert(lines, t("shop.desc.xpBoost", Util.FormatTime(grant.XpBoostSeconds)))
	end
	if product.PartyBoost then
		table.insert(lines, t("shop.desc.party"))
	end
	if product.Supporter then
		table.insert(lines, t("shop.desc.support"))
	end
	if type(grant.Cosmetics) == "table" then
		for _, id in ipairs(grant.Cosmetics) do
			local def = COSMETICS.ById[id]
			if def then
				table.insert(lines, "+ " .. pick(def.Name) .. " (" .. t("item.kind." .. def.Kind) .. ")")
			end
		end
	end
	if product.Once then
		table.insert(lines, t("shop.desc.once", tonumber(product.Fallback and product.Fallback.Gems) or 0))
	elseif product.PerSeason then
		table.insert(lines, t("shop.desc.perSeason", tonumber(SHOP.PassOwnedGems) or 500))
	elseif product.Kind == "Tiers" then
		table.insert(lines, t("shop.desc.tierRest", tonumber(SHOP.TierGemFallback) or 40))
	end
	table.insert(lines, t("shop.noP2WShort"))
	return lines
end

local function robuxButtonText(entry: any, livePrice: number?): string
	if (tonumber(entry.Id) or 0) <= 0 then
		return t("shop.notSetUp")
	end
	return ("%s R$ %s"):format(t("shop.buy"), num(livePrice or entry.Price))
end

local function promptRobux(entry: any, isPass: boolean)
	local id = tonumber(entry.Id) or 0
	if id <= 0 then
		ctx.Toast(t("shop.notSetUp"), "Info")
		return
	end
	local player = ctx.Player or Players.LocalPlayer
	local ok, err = pcall(function()
		if isPass then
			MarketplaceService:PromptGamePassPurchase(player, id)
		else
			MarketplaceService:PromptProductPurchase(player, id)
		end
	end)
	if not ok then
		warn("[Shop] Kauf-Dialog: " .. tostring(err))
	end
end

local function robuxCard(parent: Instance, order: number, entry: any, isPass: boolean)
	local lines = if isPass then { pick(entry.Desc) } else productLines(entry)
	local owned = isPass and hasPass(entry.Key)
	local ready = (tonumber(entry.Id) or 0) > 0
	local livePrice: number? = nil
	local priceLine = if owned
		then t("shop.ownedLine")
		elseif ready then ("R$ %s"):format(num(entry.Price))
		else t("shop.notSetUp")
	local _, labels = card(
		parent,
		order,
		(entry.Icon or "") .. " " .. pick(entry.Name),
		UI.Theme.Yellow,
		{ lines[1] or "", priceLine },
		t("shop.details"),
		if ready then UI.Theme.Green else UI.Theme.Gray,
		function()
			local buttons: { DialogButton } = {}
			if not owned then
				table.insert(buttons, {
					Text = robuxButtonText(entry, livePrice),
					Color = UI.Theme.Green,
					Enabled = ready,
					OnClick = function()
						promptRobux(entry, isPass)
					end,
				})
			end
			showDialog({ Title = pick(entry.Name), Color = UI.Theme.Yellow, Lines = lines, Buttons = buttons })
		end
	)
	-- echter Preis aus Roblox (falls der Besitzer ihn im Dashboard geändert hat)
	if ready and not owned then
		local priceLabel = labels[2]
		UI.FetchPrice(
			entry.Id,
			if isPass then Enum.InfoType.GamePass else Enum.InfoType.Product,
			function(price: number?)
				if price then
					livePrice = price
					if priceLabel and priceLabel.Parent then
						priceLabel.Text = ("R$ %s"):format(num(price))
					end
				end
			end
		)
	end
end

local function starterVisible(): boolean
	local offer = state().Offer
	if type(offer) ~= "table" or offer.Starter == true then
		return false
	end
	return (tonumber(offer.StarterUntil) or 0) > os.time()
end

Builders.Robux = function(root)
	local order = 1
	local function section(key: string)
		UI.Section(root, t(key), order)
		order += 1
	end
	local function products(kinds: { [string]: boolean })
		local g = grid(root, order)
		order += 1
		local i = 0
		for _, product in ipairs(SHOP.Products) do
			if kinds[product.Kind] then
				i += 1
				robuxCard(g, i, product, false)
			end
		end
	end
	if starterVisible() then
		section("shop.section.starter")
		local holder = UI.Create(
			"Frame",
			{ Size = UDim2.new(1, 0, 0, 230), BackgroundTransparency = 1, LayoutOrder = order, Parent = root }
		)
		order += 1
		Shop.BuildStarterCard(holder)
	end
	section("shop.section.gems")
	products({ Gems = true })
	section("shop.section.pass")
	products({ Pass = true, Tiers = true })
	section("shop.section.boosts")
	products({ Boost = true, Party = true })
	section("shop.section.passes")
	local g = grid(root, order)
	order += 1
	for i, pass in ipairs(SHOP.GamePasses) do
		robuxCard(g, i, pass, true)
	end
	section("shop.section.support")
	products({ Support = true })
end

-- =====================================================================
-- 6) FENSTER
-- =====================================================================
local function setCurrencies()
	for currency, label in pairs(currencyLabels) do
		local textValue = ("%s %s"):format(CURRENCY_ICON[currency], num(balance(currency)))
		if label.Text ~= textValue then
			label.Text = textValue
		end
	end
end

local function render()
	local root = body
	if not root or not win then
		return
	end
	hideDialog()
	tickerToken += 1
	clear(root)
	for name, button in pairs(tabButtons) do
		button.SetColor(if name == currentTab then UI.Theme.Orange else UI.Theme.Blue)
	end
	setCurrencies()
	local builder = Builders[currentTab]
	if builder then
		local ok, err = pcall(builder, root)
		if not ok then
			warn("[Shop] Tab " .. currentTab .. ": " .. tostring(err))
		end
	end
end

local function ensureWindow()
	if win then
		return
	end
	win = UI.Window(t("shop.title"), 820, 560, UI.Theme.Orange)
	local content = win.Content
	UI.Label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = t("shop.noP2W"),
		TextColor3 = UI.Theme.Yellow,
		MaxText = 22,
		Outline = 3,
		LayoutOrder = 1,
		Parent = content,
	})
	local currencyRow = UI.Row(content, 2, 30)
	for i, currency in ipairs({ "Coins", "Gems", "Keys", "Shards" }) do
		currencyLabels[currency] = UI.Label({
			Size = UDim2.fromOffset(150, 28),
			Text = "",
			MaxText = 20,
			Outline = 2,
			LayoutOrder = i,
			Parent = currencyRow,
		})
	end
	local tabRow = UI.Row(content, 3, 46)
	for i, name in ipairs(TABS) do
		tabButtons[name] = UI.Button({
			Size = UDim2.fromOffset(122, 42),
			Text = t("shop.tab." .. name),
			Color = UI.Theme.Blue,
			MaxText = 15,
			LayoutOrder = i,
			Parent = tabRow,
		}, function()
			if currentTab ~= name then
				currentTab = name
				render()
			end
		end)
	end
	body = UI.Create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 4,
		Parent = content,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }) })
	buildDialog(win.Panel)
end

local function openWindow()
	ensureWindow()
	render()
	UI.OpenWindow(win)
end

local function closeWindow()
	hideDialog()
	tickerToken += 1
end

function Shop.Open(tab: string?)
	local wanted = if type(tab) == "string" then TAB_ALIASES[tab] or tab else nil
	if wanted and table.find(TABS, wanted) then
		currentTab = wanted
	end
	if ctx.Windows.IsOpen("Shop") then
		render()
	else
		ctx.Windows.Open("Shop")
	end
end

-- Starter-Angebot (B23.2): einmal im Ergebnis des ersten echten Siegs, danach 72 h im Shop
function Shop.BuildStarterCard(parent: GuiObject): GuiObject?
	local product = SHOP.ProductsByKey.StarterPack
	local offer = state().Offer
	if product == nil or (type(offer) == "table" and offer.Starter == true) then
		return nil
	end
	local frame = UI.Card({
		Name = "StarterCard",
		Size = UDim2.fromOffset(420, 220),
		BackgroundColor3 = UI.Theme.Yellow,
		Parent = parent,
	})
	UI.Label({
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.new(1, -20, 0, 36),
		Text = "⭐ " .. UI.Upper(pick(product.Name)),
		MaxText = 28,
		Outline = 3,
		Parent = frame,
	})
	local lines = productLines(product)
	for i = 1, math.min(4, #lines) do
		UI.Label({
			Position = UDim2.fromOffset(14, 42 + (i - 1) * 24),
			Size = UDim2.new(1, -28, 0, 24),
			Text = lines[i],
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 17,
			Outline = 2,
			Parent = frame,
		})
	end
	local ready = (tonumber(product.Id) or 0) > 0
	UI.Button({
		Position = UDim2.new(0, 10, 1, -62),
		Size = UDim2.new(0.5, -15, 0, 54),
		Text = robuxButtonText(product, nil),
		Color = if ready then UI.Theme.Green else UI.Theme.Gray,
		MaxText = 18,
		Parent = frame,
	}, function()
		promptRobux(product, false)
	end)
	UI.Button({
		Position = UDim2.new(0.5, 5, 1, -62),
		Size = UDim2.new(0.5, -15, 0, 54),
		Text = t("shop.later"),
		Color = UI.Theme.Blue,
		MaxText = 22,
		Parent = frame,
	}, function()
		frame:Destroy()
	end)
	return frame
end

-- =====================================================================
-- 7) LOBBY: Kisten-Automat (lokal verstecken) & VIP-Tür (lokal öffnen)
-- =====================================================================
local function updateCrateMachine()
	local machine = crateMachine
	if machine == nil then
		return
	end
	if randomAllowed() == true then
		if machine.Parent == nil and crateMachineParent and crateMachineParent.Parent then
			machine.Parent = crateMachineParent
		end
	elseif machine.Parent ~= nil then
		crateMachineParent = machine.Parent
		machine.Parent = nil -- nur lokal: andere Spieler sehen ihn weiter (falls erlaubt)
	end
end

local function updateVipDoor()
	local door = vipDoor
	if door == nil then
		return
	end
	local player = ctx.Player or Players.LocalPlayer
	local vip = player:GetAttribute("Vip") == true
	door.CanCollide = not vip
	door.Transparency = if vip then 0.6 else 0
end

local function findLobbyObjects()
	task.spawn(function()
		for _ = 1, FIND_TRIES do
			if crateMachine == nil then
				local found = workspace:FindFirstChild("CrateMachine", true)
				if found then
					crateMachine = found
					crateMachineParent = found.Parent
					updateCrateMachine()
				end
			end
			if vipDoor == nil then
				local door = workspace:FindFirstChild("VipDoor", true)
				if door and door:IsA("BasePart") then
					vipDoor = door
					updateVipDoor()
				end
			end
			if crateMachine and vipDoor then
				return
			end
			task.wait(3)
		end
	end)
end

-- =====================================================================
-- 8) INIT / START
-- =====================================================================
local function onState(_state: any, changed: any)
	if changedHas(changed, "RandomAllowed") then
		updateCrateMachine()
	end
	if not (win and win.IsOpen) then
		return
	end
	setCurrencies()
	local keys = TAB_KEYS[currentTab] or {}
	local relevant = false
	for _, key in ipairs(keys) do
		if changedHas(changed, key) then
			relevant = true
			break
		end
	end
	if relevant and not renderQueued and not (dialog and dialog.Visible) then
		renderQueued = true
		task.delay(0.2, function()
			renderQueued = false
			if win and win.IsOpen and not (dialog and dialog.Visible) then
				render()
			end
		end)
	end
end

function Shop.Init(c: any)
	ctx = c
	UI = c.UI
end

function Shop.Start()
	ctx.Windows.Register("Shop", openWindow, closeWindow)
	local hud = modules().Hud
	if hud and type(hud.AddRightButton) == "function" then
		pcall(hud.AddRightButton, "🛒", "shop.hud.shop", UI.Theme.Orange, 20, function()
			ctx.Windows.Open("Shop")
		end)
	end
	local hooks = ctx.Hooks
	hooks.On("State", onState)
	hooks.On("Effect:CrateFound", function(_strength: number, data: any)
		if type(data) == "table" and randomAllowed() == true and type(data.Name) == "string" then
			local def = COSMETICS.ById[data.ItemId]
			ctx.Toast(
				t("shop.crateFoundItem", data.Name, if def then pick(def.Name) else tostring(data.Rarity)),
				"Event"
			)
		end
	end)
	hooks.On("Effect:PartyBoost", function()
		if win and win.IsOpen and currentTab == "Robux" then
			render()
		end
	end)
	local player = ctx.Player or Players.LocalPlayer
	player:GetAttributeChangedSignal("Vip"):Connect(updateVipDoor)
	pcall(UI.WhenRandomItemsKnown, function()
		updateCrateMachine()
		if win and win.IsOpen and currentTab == "Crates" then
			render()
		end
	end)
	findLobbyObjects()
	-- Kisten-Automat & Co.: Prompt mit Window = "Shop" und Tab = "<Tab>" öffnet direkt diesen Tab
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		local tab = prompt:GetAttribute("Tab")
		if prompt:GetAttribute("Window") == "Shop" and type(tab) == "string" then
			Shop.Open(tab)
		end
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">Spectate</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Zuschauen nach dem Pop (Client/Modules/Spectate)
--  Besitzer: WP5 (Match-UI). Vertrag: DESIGN.md C7.4 (Spectate.Start/Stop), B14.5.
--
--  Rundenmodi: 1.5 s Blick auf den Killer (Name + HP), dann Verfolger-Kamera über die Schulter
--    (CameraSubject = Humanoid des Teamkollegen, Zoom 8) auf lebende Teamkollegen; wechseln mit
--    Klick / LB-RB / Pfeile (Controls-Aktionen SpecNext/SpecPrev).
--  1v1: Killer 2 s, dann bleibt die Kamera beim Killer (Rückblick-Panel zeigt MatchUI).
--  FFA: Killer 2.5 s (Rückblick), dann Respawn – kein Teamkollegen-Wechsel.
--  Stoppt bei LocalRevived, Match:Prep, Match:Closed, Disarmed.
--
--  Öffentliche API (C7.4):
--    Spectate.Start(candidates: { Model })   Verfolger-Kamera über diese Figuren (erste lebende zuerst)
--    Spectate.Stop()
--  Zusätzlich: Spectate.Target(): Model?, Spectate.Init(ctx).
--  Modul-Start (C7.1): Main.client ruft Spectate.Start() OHNE Argument -> Hooks anmelden (einmal).
--  Feuert Hooks "Spectate"(model?) (Controls schaltet damit den Eingabe-Kontext).
-- =====================================================================

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local UI = require(script.Parent:WaitForChild("UI"))

local Spectate = {}

local player = Players.LocalPlayer
local ctx: any = nil

local KILLER_SECONDS = 1.5
local KILLER_SECONDS_DUEL = 2
local KILLER_SECONDS_FFA = 2.5
local REFRESH = 0.25

local candidates: { Model } = {}
local index = 0
local target: Model? = nil
local active = false
local followMode = false -- true = Teamkollegen-Wechsel aktiv
local token = 0
local armed = false
local alive = true
local inMatch = false
local matchMode: string? = nil
local myTeam = 0
local myId = player.UserId
local unbinds: { () -> () } = {}
local panel: Frame? = nil
local nameLabel: TextLabel? = nil
local hintLabel: TextLabel? = nil
local accum = 0
local killerId: number? = nil

local function module(name: string): any
	return ctx and ctx.Modules and ctx.Modules[name]
end

local function T(key: string, ...: any): string
	return if ctx then ctx.T(key, ...) else key
end

-- ---------------------------------------------------------------------
-- Figuren finden (Attribute CombatantId/Team/Alive setzt CombatService)
-- ---------------------------------------------------------------------
local function allCombatantModels(): { Model }
	local list: { Model } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local char = p.Character
		if char and char:GetAttribute("CombatantId") ~= nil then
			table.insert(list, char)
		end
	end
	for _, inst in ipairs(CollectionService:GetTagged("Bot")) do
		if inst:IsA("Model") and inst:GetAttribute("CombatantId") ~= nil then
			table.insert(list, inst)
		end
	end
	return list
end

local function modelById(id: number?): Model?
	if id == nil then
		return nil
	end
	for _, model in ipairs(allCombatantModels()) do
		if tonumber(model:GetAttribute("CombatantId")) == id then
			return model
		end
	end
	return nil
end

local function isAlive(model: Model?): boolean
	if not model or not model.Parent then
		return false
	end
	return model:GetAttribute("Alive") ~= false
end

local function teammates(): { Model }
	local list: { Model } = {}
	for _, model in ipairs(allCombatantModels()) do
		local id = tonumber(model:GetAttribute("CombatantId"))
		if id ~= myId and tonumber(model:GetAttribute("Team")) == myTeam and isAlive(model) then
			table.insert(list, model)
		end
	end
	return list
end

local function displayName(model: Model): string
	local p = Players:GetPlayerFromCharacter(model)
	if p then
		return p.DisplayName
	end
	return model.Name
end

-- ---------------------------------------------------------------------
-- Kamera + Anzeige
-- ---------------------------------------------------------------------
local function setSubject(model: Model?)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	else
		local own = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if own then
			camera.CameraSubject = own
		end
	end
end

local function updatePanel()
	local label = nameLabel
	local p = panel
	if not label or not p then
		return
	end
	local model = target
	if not active or not model then
		p.Visible = false
		return
	end
	p.Visible = true
	local hp = tonumber(model:GetAttribute("Hp")) or 0
	local name = displayName(model)
	local key = if not followMode then "match.spectate.killer" else "match.spectate.watching"
	local text = T(key, name, math.max(0, math.floor(hp + 0.5)))
	if label.Text ~= text then
		label.Text = text
	end
	if hintLabel then
		hintLabel.Visible = followMode and #candidates > 1
	end
end

local function watch(model: Model?)
	target = model
	setSubject(model)
	if ctx then
		ctx.Hooks.Fire("Spectate", model)
	end
	updatePanel()
end

local function cycle(step: number)
	if not active or not followMode then
		return
	end
	local fresh: { Model } = {}
	for _, model in ipairs(candidates) do
		if isAlive(model) then
			table.insert(fresh, model)
		end
	end
	candidates = fresh
	if #candidates == 0 then
		return
	end
	index = ((index - 1 + step) % #candidates) + 1
	watch(candidates[index])
end

local function clearBinds()
	for _, unbind in ipairs(unbinds) do
		pcall(unbind)
	end
	table.clear(unbinds)
end

local function bindControls()
	clearBinds()
	local controls = module("Controls")
	if not controls or type(controls.Bind) ~= "function" then
		return
	end
	table.insert(
		unbinds,
		controls.Bind("SpecNext", function(state)
			if state == "Begin" then
				cycle(1)
			end
		end, 5)
	)
	table.insert(
		unbinds,
		controls.Bind("SpecPrev", function(state)
			if state == "Begin" then
				cycle(-1)
			end
		end, 5)
	)
end

-- ---------------------------------------------------------------------
-- Öffentliche API
-- ---------------------------------------------------------------------
local moduleStarted = false
local startModule: () -> () = function() end

function Spectate.Start(list: { Model }?)
	if list == nil then
		-- Modul-Start durch Main.client (C7.1)
		if not moduleStarted then
			moduleStarted = true
			startModule()
		end
		return
	end
	token += 1
	candidates = {}
	for _, model in ipairs(list) do
		if typeof(model) == "Instance" and model:IsA("Model") then
			table.insert(candidates, model)
		end
	end
	if #candidates == 0 then
		return
	end
	active = true
	followMode = true
	index = 1
	local camera = module("FpsCamera")
	if camera and type(camera.SetMode) == "function" then
		pcall(camera.SetMode, "Spectate")
	end
	bindControls()
	watch(candidates[1])
end

function Spectate.Stop()
	token += 1
	local was = active
	active = false
	followMode = false
	candidates = {}
	index = 0
	killerId = nil
	clearBinds()
	if was then
		target = nil
		setSubject(nil)
		if ctx then
			ctx.Hooks.Fire("Spectate", nil)
		end
		local camera = module("FpsCamera")
		if camera and type(camera.SetMode) == "function" then
			pcall(camera.SetMode, if armed and alive then "Match" elseif inMatch then "Spectate" else "Lobby")
		end
	end
	updatePanel()
end

function Spectate.Target(): Model?
	return target
end

-- Eigener Pop: Killer zeigen, danach Teamkollegen (Rundenmodi)
local function onLocalPop(kid: number?)
	if not inMatch then
		return
	end
	token += 1
	local myToken = token
	killerId = kid
	local killer = modelById(kid)
	local ffa = matchMode == "FFA"
	local mates = if ffa then {} else teammates()
	local seconds = if ffa then KILLER_SECONDS_FFA elseif #mates == 0 then KILLER_SECONDS_DUEL else KILLER_SECONDS
	if killer then
		active = true
		followMode = false
		local camera = module("FpsCamera")
		if camera and type(camera.SetMode) == "function" then
			pcall(camera.SetMode, "Spectate")
		end
		watch(killer)
	end
	task.delay(seconds, function()
		if myToken ~= token or alive then
			return
		end
		if ffa then
			Spectate.Stop() -- Respawn kommt gleich
			return
		end
		local now = teammates()
		if #now > 0 then
			Spectate.Start(now)
		end
		-- 1v1/keine Teamkollegen: Kamera bleibt beim Killer
	end)
end

local function buildPanel()
	local gui = ctx and ctx.Gui
	if not gui then
		return
	end
	local frame = UI.Create("Frame", {
		Name = "SpectatePanel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 132),
		Size = UDim2.fromOffset(420, 64),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 22,
		Parent = gui,
	})
	nameLabel = UI.Label({
		Size = UDim2.new(1, 0, 0, 36),
		Text = "",
		MaxText = 26,
		Outline = 3,
		ZIndex = 22,
		Parent = frame,
	})
	hintLabel = UI.Label({
		Position = UDim2.fromOffset(0, 38),
		Size = UDim2.new(1, 0, 0, 22),
		Text = T("match.spectate.hint"),
		MaxText = 16,
		Outline = 2,
		TextColor3 = UI.Theme.SubText,
		Visible = false,
		ZIndex = 22,
		Parent = frame,
	})
	panel = frame
end

local function step(dt: number)
	if not active then
		return
	end
	accum += dt
	if accum < REFRESH then
		return
	end
	accum = 0
	-- Ziel gepoppt -> nächster lebender Teamkollege
	if followMode and target and not isAlive(target) then
		local mates = teammates()
		if #mates > 0 then
			candidates = mates
			index = 1
			watch(mates[1])
		end
	elseif not followMode and target == nil and killerId then
		local killer = modelById(killerId)
		if killer then
			watch(killer)
		end
	end
	updatePanel()
end

function Spectate.Init(context: any)
	ctx = context
	buildPanel()
end

startModule = function()
	local hooks = ctx.Hooks
	hooks.On("Match:Start", function(data)
		inMatch = true
		matchMode = type(data) == "table" and data.Mode or nil
		myTeam = type(data) == "table" and tonumber(data.MyTeam) or 0
		myId = type(data) == "table" and tonumber(data.MyId) or player.UserId
	end)
	hooks.On("Match:Elim", function(data)
		if type(data) == "table" and inMatch and tonumber(data.V) == myId then
			alive = false
			onLocalPop(tonumber(data.K))
		end
	end)
	hooks.On("Match:Spectate", function(data)
		-- Server nennt das Ziel (Killer), falls das Elim schon vorbei ist
		if type(data) == "table" and not alive and not active then
			onLocalPop(tonumber(data.TargetId))
		end
	end)
	hooks.On("Match:Prep", function()
		alive = true
		Spectate.Stop()
	end)
	hooks.On("Match:Closed", function()
		inMatch = false
		alive = true
		matchMode = nil
		Spectate.Stop()
	end)
	hooks.On("LocalRevived", function()
		alive = true
		Spectate.Stop()
	end)
	hooks.On("LocalPopped", function()
		alive = false
	end)
	hooks.On("Armed", function()
		armed = true
	end)
	hooks.On("Disarmed", function()
		armed = false
		Spectate.Stop()
	end)
	RunService.Heartbeat:Connect(step)
end

return Spectate
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">TouchControls</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Eigene Touch-Knöpfe (Client/Modules/TouchControls)
--  Besitzer: WP10 (Client-Hülle). Vertrag: DESIGN.md C7.4, B15.1, B15.2 (Auto-Feuer), REUSE §12.
--
--  Liegt in der UNSKALIERTEN ctx.TouchGui (ScreenInsets = DeviceSafeInsets): jeder Knopf ist
--  mindestens Config.Client.TouchButtonMin (64) Pixel groß – auch bei Knopfgröße 90 % – und nichts
--  liegt unter der Notch. Roblox-Stick und Roblox-Sprungknopf bleiben (B15.1 "Standard"); unsere
--  Knöpfe sitzen über/neben dem Sprungknopf.
--    großer FEUER-Knopf rechts (ziehen = zielen über FpsCamera.AddLookDelta) + kleiner links,
--    ZIELEN (umschalten), NACHLADEN, RUTSCHEN, UTILITY, Slot-Leiste (4 Icons, aktives Icon tippen =
--    letzte Waffe), oben rechts Scoreboard/Loadout/Inspizieren/Menü, BEREIT in der Vorbereitung.
--  Linkshänder spiegelt alles, Knopfgröße 90–130 % (Einstellungen). Automatisch sprinten bei Stick ≥ 0.9.
--  Alle Knöpfe speisen Aktionen über Controls.Emit ein (andere Module hören nur Controls).
--
--  Öffentliche API (C7.4):
--    TouchControls.Show(set)          "Match" | "Range" | "Lobby" | "None"
--    TouchControls.SetAutoFire(on)    Auto-Feuer-Anzeige/-Zustand (Standard aus Einstellung "auto")
--  Zusätzlich: TouchControls.IsAutoFire(): boolean, TouchControls.SetSlots(loadout, equipped, charges),
--    TouchControls.SetAmmo(mag, max, reloading, progress?) (Munition am FEUER-Knopf),
--    TouchControls.Frame(dt), TouchControls.Init(ctx), TouchControls.Start()
-- =====================================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))

local TouchControls = {}

local player = Players.LocalPlayer
local WHITE = Color3.new(1, 1, 1)
local DISK = "rbxasset://textures/ui/Input/Disk_padded.png"
local RING = "rbxasset://textures/ui/Input/Ring_padded.png"
local AIM_ICON = "rbxasset://textures/ui/Input/AimStrafeButtonRegular.png"

local SLOT_NAMES = { "Primary", "Secondary", "Melee", "Utility" }
local SLOT_ACTIONS = { "Slot1", "Slot2", "Slot3", "Slot4" }

type TouchButton = {
	Name: string,
	Root: ImageButton,
	Ring: ImageLabel,
	Label: TextLabel,
	Base: number, -- Größe bei 100 %
	Sets: { [string]: boolean },
	Visible: boolean,
	Pressed: boolean,
	Color: Color3,
}

local ctx: any = nil
local holder: Frame? = nil
local buttons: { [string]: TouchButton } = {}
local slotButtons: { TouchButton } = {}
local currentSet = "Lobby"
local autoFire = false
local autoFireOverride: boolean? = nil
local adsOn = false
local readyVisible = false
local sprintFromStick = false
local equippedSlot = "Primary"
local slotLoadout: { [string]: string } = {}
local touchCfg = {
	FireSize = 116,
	SmallFireSize = 76,
	ButtonSize = 72,
	SlotSize = 66,
	SmallSize = 64,
	Margin = 16,
	LookPerPixel = 0.0065,
}
local minSize = 64

-- ---------------------------------------------------------------------
-- HILFEN
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function settings(): { [string]: any }
	local module = ctx and ctx.Modules and ctx.Modules.Settings
	if module and type(module.Get) == "function" then
		local ok, value = pcall(module.Get)
		if ok and type(value) == "table" then
			return value
		end
	end
	local config = ctx and ctx.Config
	return config and config.Client and config.Client.DefaultSettings or {}
end

local function controls(): any
	return ctx and ctx.Modules and ctx.Modules.Controls
end

local function emit(action: string, state: string)
	local c = controls()
	if c and type(c.Emit) == "function" then
		pcall(c.Emit, action, state, "touch:" .. action)
	end
end

local function tap(action: string)
	emit(action, "Begin")
	emit(action, "End")
end

local function isTouch(): boolean
	local c = controls()
	if c and type(c.Input) == "function" then
		local ok, kind = pcall(c.Input)
		if ok then
			return kind == "Touch"
		end
	end
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function scaled(base: number): number
	local scale = tonumber(settings().ButtonScale) or 1
	return math.max(minSize, math.floor(base * math.clamp(scale, 0.9, 1.3) + 0.5))
end

-- ---------------------------------------------------------------------
-- KNOPF-BAUSTEIN (runde Scheibe + Ring, Text in der Mitte)
-- ---------------------------------------------------------------------
local function makeButton(
	name: string,
	base: number,
	color: Color3,
	text: string,
	sets: { string },
	maxText: number?
): TouchButton
	local parent = holder
	local root: ImageButton = UI.Create("ImageButton", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(base, base),
		BackgroundTransparency = 1,
		Image = DISK,
		ImageColor3 = color,
		ImageTransparency = 0.25,
		AutoButtonColor = false,
		Visible = false,
		Parent = parent,
	})
	local ring: ImageLabel = UI.Create("ImageLabel", {
		Name = "Ring",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = RING,
		ImageColor3 = WHITE,
		ImageTransparency = 0.1,
		Parent = root,
	})
	local label = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.86, 0.5),
		Text = text,
		MaxText = maxText or 22,
		Outline = 2,
		Parent = root,
	})
	local setMap: { [string]: boolean } = {}
	for _, s in ipairs(sets) do
		setMap[s] = true
	end
	local button: TouchButton = {
		Name = name,
		Root = root,
		Ring = ring,
		Label = label,
		Base = base,
		Sets = setMap,
		Visible = false,
		Pressed = false,
		Color = color,
	}
	buttons[name] = button
	return button
end

local function setPressed(button: TouchButton, on: boolean)
	button.Pressed = on
	button.Root.ImageTransparency = if on then 0.05 else 0.25
	button.Ring.ImageColor3 = if on then Color3.fromRGB(255, 230, 80) else WHITE
end

-- Halten-Knopf: Begin beim Drücken, End beim Loslassen (auch wenn der Finger rausrutscht)
local function bindHold(button: TouchButton, action: string)
	local activeInput: InputObject? = nil
	button.Root.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType ~= Enum.UserInputType.Touch or activeInput then
			return
		end
		activeInput = input
		setPressed(button, true)
		emit(action, "Begin")
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input == activeInput then
			activeInput = nil
			setPressed(button, false)
			emit(action, "End")
		end
	end)
end

local function bindTap(button: TouchButton, fn: () -> ())
	button.Root.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		setPressed(button, true)
		fn()
		task.delay(0.12, function()
			setPressed(button, false)
		end)
	end)
end

-- FEUER: halten = feuern, dabei ziehen = zielen (Blick-Delta an die FpsCamera)
local function bindFire(button: TouchButton)
	local activeInput: InputObject? = nil
	local last = Vector2.zero
	button.Root.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType ~= Enum.UserInputType.Touch or activeInput then
			return
		end
		activeInput = input
		last = Vector2.new(input.Position.X, input.Position.Y)
		setPressed(button, true)
		emit("Fire", "Begin")
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input ~= activeInput then
			return
		end
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		local delta = pos - last
		last = pos
		if delta.Magnitude < 0.01 then
			return
		end
		local camera = ctx and ctx.Modules and ctx.Modules.FpsCamera
		if camera and type(camera.AddLookDelta) == "function" then
			local sens = tonumber(settings().SensTouch) or 0.6
			local k = touchCfg.LookPerPixel * sens
			pcall(camera.AddLookDelta, delta.X * k, delta.Y * k)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input == activeInput then
			activeInput = nil
			setPressed(button, false)
			emit("Fire", "End")
		end
	end)
end

-- ---------------------------------------------------------------------
-- AUFBAU
-- ---------------------------------------------------------------------
local autoBadge: TextLabel? = nil
local ammoLabel: TextLabel? = nil

local function build()
	local cfg = touchCfg
	local fire =
		makeButton("Fire", cfg.FireSize, Color3.fromRGB(255, 70, 70), T("ui.touch.fire"), { "Match", "Range" }, 26)
	bindFire(fire)
	autoBadge = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -18),
		Size = UDim2.fromOffset(64, 18),
		Text = "AUTO",
		TextColor3 = Color3.fromRGB(120, 255, 120),
		MaxText = 16,
		Outline = 2,
		Visible = false,
		Parent = fire.Root,
	})
	fire.Label.Position = UDim2.fromScale(0.5, 0.4)
	ammoLabel = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.74),
		Size = UDim2.fromScale(0.6, 0.24),
		Text = "",
		Font = UI.Fonts.Number,
		MaxText = 22,
		Outline = 2,
		Parent = fire.Root,
	})
	local small = makeButton(
		"FireSmall",
		cfg.SmallFireSize,
		Color3.fromRGB(255, 70, 70),
		T("ui.touch.fire"),
		{ "Match", "Range" }
	)
	bindFire(small)
	local ads = makeButton("Ads", cfg.ButtonSize, Color3.fromRGB(60, 140, 255), T("ui.touch.ads"), { "Match", "Range" })
	ads.Label.Position = UDim2.fromScale(0.5, 0.72)
	ads.Label.Size = UDim2.fromScale(0.8, 0.3)
	UI.Create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.fromScale(0.42, 0.42),
		BackgroundTransparency = 1,
		Image = AIM_ICON,
		Parent = ads.Root,
	})
	bindTap(ads, function()
		-- Touch: immer umschalten (B15.1)
		adsOn = not adsOn
		emit("Ads", if adsOn then "Begin" else "End")
		ads.Ring.ImageColor3 = if adsOn then Color3.fromRGB(255, 230, 80) else WHITE
	end)
	local reload = makeButton("Reload", cfg.ButtonSize, Color3.fromRGB(255, 170, 40), T("ui.touch.reload"), {
		"Match",
		"Range",
	})
	bindTap(reload, function()
		tap("Reload")
	end)
	local slide =
		makeButton("Slide", cfg.ButtonSize, Color3.fromRGB(150, 110, 255), T("ui.touch.slide"), { "Match", "Range" })
	bindHold(slide, "Slide")
	local utility =
		makeButton("Utility", cfg.ButtonSize, Color3.fromRGB(70, 210, 120), T("ui.touch.utility"), { "Match", "Range" })
	bindHold(utility, "Utility")
	local ready = makeButton("Ready", cfg.ButtonSize + 8, Color3.fromRGB(70, 210, 80), T("ui.touch.ready"), { "Match" })
	bindTap(ready, function()
		tap("Ready")
	end)
	-- kleine Knöpfe oben rechts
	local smallButtons = {
		{ "Scoreboard", "📋", { "Match" } },
		{ "Loadout", "🎒", { "Match", "Range" } },
		{ "Inspect", "🔍", { "Match", "Range" } },
		{ "Menu", "⚙️", { "Match", "Range" } },
	}
	for _, spec in ipairs(smallButtons) do
		local action = spec[1] :: string
		local b =
			makeButton(action, cfg.SmallSize, Color3.fromRGB(40, 45, 70), spec[2] :: string, spec[3] :: { string }, 30)
		if action == "Scoreboard" then
			bindHold(b, action) -- Scoreboard nur solange gedrückt
		else
			bindTap(b, function()
				tap(action)
			end)
		end
	end
	-- Slot-Leiste (aktives Icon tippen = letzte Waffe)
	for i = 1, 4 do
		local b = makeButton("Slot" .. i, cfg.SlotSize, Color3.fromRGB(30, 34, 55), "", { "Match", "Range" }, 18)
		bindTap(b, function()
			if SLOT_NAMES[i] == equippedSlot then
				tap("LastWeapon")
			else
				tap(SLOT_ACTIONS[i])
			end
		end)
		table.insert(slotButtons, b)
	end
end

-- ---------------------------------------------------------------------
-- LAYOUT (über dem Roblox-Sprungknopf, Linkshänder gespiegelt)
-- ---------------------------------------------------------------------
local function place(button: TouchButton, x: number, y: number, mirror: boolean, width: number)
	local size = scaled(button.Base)
	button.Root.Size = UDim2.fromOffset(size, size)
	local px = if mirror then x else width - x
	button.Root.Position = UDim2.fromOffset(px, y)
end

local function layout()
	local frame = holder
	if not frame then
		return
	end
	local size = frame.AbsoluteSize
	local w, h = size.X, size.Y
	if w < 10 or h < 10 then
		return
	end
	local mirror = settings().LeftHanded == true
	local m = touchCfg.Margin
	-- Roblox-Sprungknopf: klein (70 px, rechts 25 / unten 20) auf kleinen Schirmen, sonst 120 px (rechts 170 / unten 210)
	local smallScreen = math.min(w, h) <= 500
	local jumpTop = if smallScreen then h - 90 else h - 210
	local jumpLeft = if smallScreen then w - 95 else w - 170
	local fire = scaled(touchCfg.FireSize)
	local btn = scaled(touchCfg.ButtonSize)
	local gap = 10
	-- x-Werte sind Abstände vom rechten Rand (Mitte des Knopfs); bei Linkshändern vom linken
	local fireX = m + fire / 2 + 6
	local fireY = jumpTop - gap - fire / 2
	place(buttons.Fire, fireX, fireY, mirror, w)
	place(buttons.Reload, fireX + fire / 2 + gap + btn / 2, fireY + fire / 2 - btn / 2, mirror, w)
	local adsY = fireY - fire / 2 - gap - btn / 2
	place(buttons.Ads, fireX + fire / 2 - btn / 2, adsY, mirror, w)
	place(buttons.Utility, fireX + fire / 2 + gap + btn / 2, adsY, mirror, w)
	local slideX = (w - jumpLeft) + gap + btn / 2
	place(buttons.Slide, slideX, h - m - btn / 2, mirror, w)
	local readySize = scaled(touchCfg.ButtonSize + 8)
	place(
		buttons.Ready,
		fireX + fire / 2 + gap + btn + gap + readySize / 2,
		fireY + fire / 2 - readySize / 2,
		mirror,
		w
	)
	-- kleiner Feuerknopf auf der anderen Seite, oberhalb des Sticks
	local smallFire = scaled(touchCfg.SmallFireSize)
	place(buttons.FireSmall, w - (m + smallFire / 2 + 10), h * 0.6, mirror, w)
	-- oben rechts: Menü, Scoreboard, Loadout in einer Reihe (die Mitte bleibt frei für Timer/Score)
	local small = scaled(touchCfg.SmallSize)
	for i, name in ipairs({ "Menu", "Scoreboard", "Loadout" }) do
		place(buttons[name], m + small / 2 + (i - 1) * (small + 8), 8 + small / 2, mirror, w)
	end
	-- Inspizieren links oben unter der Lebensanzeige
	place(buttons.Inspect, w - (m + small / 2), 108 + small / 2, mirror, w)
	-- Slot-Leiste unten Mitte
	local slot = scaled(touchCfg.SlotSize)
	local totalW = 4 * slot + 3 * 8
	for i, b in ipairs(slotButtons) do
		local cx = w / 2 - totalW / 2 + slot / 2 + (i - 1) * (slot + 8)
		local s = scaled(b.Base)
		b.Root.Size = UDim2.fromOffset(s, s)
		b.Root.Position = UDim2.fromOffset(if mirror then w - cx else cx, h - m - slot / 2)
	end
end

-- ---------------------------------------------------------------------
-- SICHTBARKEIT
-- ---------------------------------------------------------------------
local function windowOpen(): boolean
	local ui = ctx and ctx.UI
	if ui and type(ui.IsAnyWindowOpen) == "function" then
		local ok, open = pcall(ui.IsAnyWindowOpen)
		return ok and open == true
	end
	return false
end

local function applyVisibility()
	local touch = isTouch()
	local menu = windowOpen()
	for name, button in pairs(buttons) do
		local visible = touch and not menu and button.Sets[currentSet] == true
		if name == "Ready" then
			visible = visible and readyVisible
		end
		if button.Visible ~= visible then
			button.Visible = visible
			button.Root.Visible = visible
		end
	end
	if autoBadge then
		autoBadge.Visible = autoFire
	end
end

function TouchControls.Show(set: string)
	if set ~= "Match" and set ~= "Range" and set ~= "Lobby" and set ~= "None" then
		warn("[TouchControls] Unbekanntes Set: " .. tostring(set))
		return
	end
	if set ~= currentSet then
		currentSet = set
		if adsOn then
			adsOn = false
			emit("Ads", "End")
			local ads = buttons.Ads
			if ads then
				ads.Ring.ImageColor3 = WHITE
			end
		end
	end
	applyVisibility()
end

-- Auto-Feuer: "auto" = an bei Touch in Casual (B15.2), "on"/"off" fest; SetAutoFire überschreibt (z. B. Ranked)
local function computeAutoFire(): boolean
	if autoFireOverride ~= nil then
		return autoFireOverride
	end
	local mode = settings().AutoFire
	if mode == "on" then
		return true
	elseif mode == "off" then
		return false
	end
	return isTouch()
end

function TouchControls.SetAutoFire(on: boolean)
	autoFireOverride = on == true
	autoFire = autoFireOverride
	applyVisibility()
end

function TouchControls.IsAutoFire(): boolean
	return autoFire
end

local function weaponShort(key: string?): string
	if type(key) ~= "string" or key == "" then
		return ""
	end
	local config = ctx and ctx.Config
	if config and type(config.Weapon) == "function" then
		local ok, def = pcall(config.Weapon, key)
		if ok and type(def) == "table" and type(def.Short) == "string" then
			return def.Short
		end
	end
	return key
end

function TouchControls.SetSlots(loadout: { [string]: string }, equipped: string, charges: { [string]: number })
	if type(loadout) == "table" then
		slotLoadout = loadout
	end
	if type(equipped) == "string" then
		equippedSlot = equipped
	end
	for i, b in ipairs(slotButtons) do
		local name = SLOT_NAMES[i]
		local text = weaponShort(slotLoadout[name])
		local charge = type(charges) == "table" and charges[name] or nil
		if name == "Utility" and type(charge) == "number" then
			text ..= " x" .. charge
		end
		b.Label.Text = text
		local active = name == equippedSlot
		b.Ring.ImageColor3 = if active then Color3.fromRGB(255, 230, 80) else WHITE
		b.Root.ImageTransparency = if active then 0.05 else 0.35
	end
end

-- Munition direkt am FEUER-Knopf (auf Touch zeigt CombatHud keine eigene Munitionsanzeige)
function TouchControls.SetAmmo(mag: number, max: number, reloading: boolean, reloadProgress: number?)
	local label = ammoLabel
	if not label or type(mag) ~= "number" or type(max) ~= "number" then
		return
	end
	local text: string
	if max <= 0 then
		text = ""
	elseif reloading then
		local p = if type(reloadProgress) == "number" then math.clamp(reloadProgress, 0, 1) else 0
		text = string.rep("•", 1 + math.floor(p * 4))
	else
		text = tostring(math.max(0, math.floor(mag)))
	end
	if label.Text ~= text then
		label.Text = text
	end
	label.TextColor3 = if mag <= 0 and not reloading and max > 0 then Color3.fromRGB(255, 80, 80) else WHITE
end

local function relabel()
	local map = {
		Fire = "ui.touch.fire",
		FireSmall = "ui.touch.fire",
		Ads = "ui.touch.ads",
		Reload = "ui.touch.reload",
		Slide = "ui.touch.slide",
		Utility = "ui.touch.utility",
		Ready = "ui.touch.ready",
	}
	for name, key in pairs(map) do
		local b = buttons[name]
		if b then
			b.Label.Text = T(key)
		end
	end
end

-- Jeder Frame (nur Touch im Kampf): automatisch sprinten, wenn der Stick ≥ 0.9 ausgelenkt ist
function TouchControls.Frame(_dt: number)
	if currentSet ~= "Match" and currentSet ~= "Range" then
		if sprintFromStick then
			sprintFromStick = false
			emit("Sprint", "End")
		end
		return
	end
	if not isTouch() then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local magnitude = humanoid and humanoid.MoveDirection.Magnitude or 0
	local want = magnitude >= 0.9
	if want ~= sprintFromStick then
		sprintFromStick = want
		emit("Sprint", if want then "Begin" else "End")
	end
end

function TouchControls.Init(context: any)
	ctx = context
	local config = ctx.Config
	local client = config and config.Client
	if client then
		if type(client.TouchButtonMin) == "number" then
			minSize = math.max(44, client.TouchButtonMin)
		end
		if type(client.Touch) == "table" then
			for key, value in pairs(client.Touch) do
				if type(value) == "number" and touchCfg[key] ~= nil then
					touchCfg[key] = value
				end
			end
		end
	end
	local frame: Frame = UI.Create("Frame", {
		Name = "TouchControls",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = ctx.TouchGui,
	})
	holder = frame
	build()
	autoFire = computeAutoFire()
	frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)

	local hooks = ctx.Hooks
	hooks.On("Input", function()
		autoFire = computeAutoFire()
		applyVisibility()
	end)
	hooks.On("Settings", function()
		autoFire = computeAutoFire()
		relabel()
		layout()
		applyVisibility()
	end)
	hooks.On("WindowOpened", applyVisibility)
	hooks.On("WindowClosed", applyVisibility)
	-- Standard-Sets aus den Spiel-Ereignissen (WeaponClient darf jederzeit Show aufrufen)
	local armedSet = "Match"
	hooks.On("Armed", function(info)
		local isRange = type(info) == "table" and info.Ctx == "Range"
		armedSet = if isRange then "Range" else "Match"
		TouchControls.Show(armedSet)
	end)
	hooks.On("Disarmed", function()
		readyVisible = false
		TouchControls.Show("Lobby")
	end)
	hooks.On("LocalPopped", function()
		TouchControls.Show("None")
	end)
	hooks.On("LocalRevived", function()
		TouchControls.Show(armedSet)
	end)
	hooks.On("Match:Prep", function()
		readyVisible = true
		applyVisibility()
	end)
	hooks.On("Match:Live", function()
		readyVisible = false
		applyVisibility()
	end)
	hooks.On("Match:Closed", function()
		readyVisible = false
		applyVisibility()
	end)
end

function TouchControls.Start()
	layout()
	relabel()
	applyVisibility()
end

return TouchControls
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">Training</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Training-Fenster, DPS-Anzeige & Aim-Trainer (Client/Modules/Training)
--  Besitzer: WP6 (Bots & Training-Range). Vertrag: DESIGN.md C7.3 (Fenster "Training"), C7.4 (Training.Open),
--  B2 (Waffen-Regal öffnet Training-UI), D WP6 (DPS-Anzeige, Flick-Test, Bestzeit nur lokal in v1),
--  docs/SKILL-WUENSCHE.md (Aim-Trainer: Flick, Tracking, Reaktion mit Highscores).
--
--  Inhalt:
--    * Fenster "Training": Waffen-Regal (jede der 15 Waffen gratis, Request "RangeWeapon" {Slot, Key}),
--      "Zur Range"-Knopf (außerhalb der Range), Bot-Duell (Request "PracticeStart"), Aim-Trainer.
--    * DPS-Anzeige rechts, solange man in der Range bewaffnet ist (Combat:Hit -> DPS, Schaden, letzter Treffer).
--    * Lebensbalken + Entfernung über jeder Puppe (Tag "RangeDummy", Attribute Hp/MaxHp/Distance), nur lokal.
--    * Aim-Trainer mit lokalen Zielen (Teile unter der Kamera, nicht repliziert): Flick (10 Ziele, Bestzeit),
--      Tracking (Fadenkreuz auf wandernder Kugel halten, % auf dem Ziel), Reaktion (Ø ms über 5 Runden).
--      Treffer = Fadenkreuz-Strahl der Kamera beim Hook "Shot". Bestwerte nur in dieser Sitzung (v1).
--    * Fallback: Bot-Kabinen-Prompts (Attribut "Practice") starten Practice, falls QueueUI fehlt.
--
--  Öffentliche API (C7.4):
--    Training.Open()
--    Training.Init(ctx) / Training.Start()   (Modul-Form C7.1)
-- =====================================================================

local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Training = {}

local SLOTS = { "Primary", "Secondary", "Melee", "Utility" }
local DUEL_DIFFS = { "Easy", "Normal", "Hard", "Insane" }
local DUMMY_TAG = "RangeDummy"
local HUD_REFRESH = 0.2
local MAX_DUMMY_GUIS = 40

type Card = { Button: any, Slot: string, Def: any, Stats: string, Color: Color3 }
type Run = {
	Mode: string,
	Phase: string, -- "Count" | "Live" | "Wait" | "Show"
	GoAt: number,
	T0: number,
	Folder: Folder,
	Target: BasePart,
	Radius: number,
	BaseCF: CFrame,
	Hits: number,
	Shots: number,
	Index: number,
	OnTime: number,
	Elapsed: number,
	Omega1: number,
	Omega2: number,
	Phase1: number,
	Phase2: number,
	Round: number,
	AppearAt: number,
	ShownAt: number,
	Times: { number },
	Conn: RBXScriptConnection?,
}

local ctx: any = nil
local UI: any = nil
local config: any = nil
local rangeCfg: any = {}
local rng = Random.new()

local inRange = false
local rangeLoadout: { [string]: string } = {}
local win: any = nil
local cards: { [string]: Card } = {}
local goRow: Frame? = nil
local bestLabels: { [string]: TextLabel } = {}
local best: { [string]: number } = {} -- Flick (s, kleiner besser), Tracking (%, größer), Reaction (ms, kleiner)

local hud: { Frame: Frame, Dps: TextLabel, Total: TextLabel, Last: TextLabel, Popped: TextLabel }? = nil
local dpsState = { Start = 0, Last = -math.huge, Session = 0, Total = 0, LastText = "–", PoppedUntil = 0 }
local hudAccum = 0

local trainerHud: { Frame: Frame, Title: TextLabel, Info: TextLabel }? = nil
local run: Run? = nil

local dummyGuis: { [Model]: { Gui: BillboardGui, Fill: Frame, Conns: { RBXScriptConnection } } } = {}
local dummyCount = 0

-- ---------------------------------------------------------------------
-- HILFEN
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		local ok, text = pcall(ctx.T, key, ...)
		if ok and type(text) == "string" then
			return text
		end
	end
	return key
end

local function toast(text: string, kind: string?)
	if ctx and type(ctx.Toast) == "function" then
		pcall(ctx.Toast, text, kind)
	end
end

local function cfgNum(key: string, default: number): number
	local v = rangeCfg[key]
	if type(v) == "number" and v == v then
		return v
	end
	return default
end

local function cfgPair(key: string, a: number, b: number): (number, number)
	local v = rangeCfg[key]
	if type(v) == "table" and type(v[1]) == "number" and type(v[2]) == "number" then
		return math.min(v[1], v[2]), math.max(v[1], v[2])
	end
	return a, b
end

local function between(lo: number, hi: number): number
	return lo + (hi - lo) * rng:NextNumber()
end

local function weaponName(def: any): string
	local name = def and def.Name
	if type(name) == "table" and ctx and ctx.Lang and type(ctx.Lang.Pick) == "function" then
		local lang = if type(ctx.Lang_) == "function" then ctx.Lang_() else "en"
		local ok, text = pcall(ctx.Lang.Pick, lang, name)
		if ok and type(text) == "string" then
			return text
		end
	end
	return if def and type(def.Key) == "string" then def.Key else "?"
end

local function weaponsOf(slot: string): { any }
	local list: { any } = {}
	local weapons = config and config.Weapons
	local all = if type(weapons) == "table" then weapons.List else nil
	if type(all) ~= "table" then
		return list
	end
	for _, def in all do
		if type(def) == "table" and def.Slot == slot and def.Enabled ~= false and def.AdminOnly ~= true then
			table.insert(list, def)
		end
	end
	table.sort(list, function(a, b)
		return (tonumber(a.Id) or 0) < (tonumber(b.Id) or 0)
	end)
	return list
end

local function statsText(def: any): string
	local damage = math.floor((tonumber(def.Damage) or 0) + 0.5)
	local mag = math.floor(tonumber(def.Mag) or 0)
	if def.Kind == "Melee" then
		local melee = def.Melee
		local range = if type(melee) == "table" then tonumber(melee.Range) or 0 else 0
		return T("bot.training.statsMelee", damage, tostring(range))
	end
	if def.Slot == "Utility" or def.Kind == "Throwable" or def.Kind == "Consumable" then
		return T("bot.training.statsUtility")
	end
	if def.Kind == "Projectile" and type(def.Projectile) == "table" and type(def.Projectile.Direct) == "number" then
		damage = math.floor(def.Projectile.Direct + 0.5)
	end
	local pellets = math.floor(tonumber(def.Pellets) or 1)
	if pellets > 1 then
		return T("bot.training.statsPellets", pellets, damage, mag)
	end
	return T("bot.training.statsGun", damage, mag)
end

local function slotColor(slot: string): Color3
	if slot == "Primary" then
		return UI.Theme.Orange
	elseif slot == "Secondary" then
		return UI.Theme.Blue
	elseif slot == "Melee" then
		return UI.Theme.Purple
	end
	return UI.Theme.Pink
end

local function diffColor(diff: string): Color3
	if diff == "Easy" then
		return UI.Theme.Green
	elseif diff == "Normal" then
		return UI.Theme.Blue
	elseif diff == "Hard" then
		return UI.Theme.Orange
	end
	return UI.Theme.Red
end

local function request(action: string, arg: any): any
	if ctx == nil or type(ctx.Request) ~= "function" then
		return nil
	end
	local ok, reply = pcall(ctx.Request, action, arg)
	if ok then
		return reply
	end
	return nil
end

local function formatSeconds(s: number): string
	return string.format("%.2f", s)
end

-- ---------------------------------------------------------------------
-- AIM-TRAINER: Anzeige oben in der Mitte
-- ---------------------------------------------------------------------
local function ensureTrainerHud(): { Frame: Frame, Title: TextLabel, Info: TextLabel }?
	if trainerHud then
		return trainerHud
	end
	if UI == nil or ctx == nil or ctx.Gui == nil then
		return nil
	end
	local frame = UI.Create("Frame", {
		Name = "AimTrainer",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 120),
		Size = UDim2.fromOffset(360, 74),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = ctx.Gui,
	})
	local title = UI.Label({
		Size = UDim2.new(1, 0, 0, 38),
		Text = "",
		TextColor3 = UI.Theme.Yellow,
		MaxText = 34,
		Outline = 3,
		Font = UI.Fonts and UI.Fonts.Banner or UI.Font,
		Parent = frame,
	})
	local info = UI.Label({
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 30),
		Text = "",
		MaxText = 24,
		Outline = 2.5,
		Parent = frame,
	})
	trainerHud = { Frame = frame, Title = title, Info = info }
	return trainerHud
end

local function setTrainerText(title: string?, info: string?)
	local h = ensureTrainerHud()
	if h == nil then
		return
	end
	if title and h.Title.Text ~= title then
		h.Title.Text = title
	end
	if info and h.Info.Text ~= info then
		h.Info.Text = info
	end
	h.Frame.Visible = run ~= nil
end

local function hideTrainerHud(delaySeconds: number?)
	local h = trainerHud
	if h == nil then
		return
	end
	if delaySeconds and delaySeconds > 0 then
		task.delay(delaySeconds, function()
			if run == nil and trainerHud then
				trainerHud.Frame.Visible = false
			end
		end)
	else
		h.Frame.Visible = false
	end
end

local function bestText(mode: string): string
	local value = best[mode]
	if value == nil then
		return T("bot.training.noBest")
	end
	if mode == "Flick" then
		return T("bot.training.flickBest", formatSeconds(value))
	elseif mode == "Tracking" then
		return T("bot.training.trackingBest", math.floor(value + 0.5))
	end
	return T("bot.training.reactionBest", math.floor(value + 0.5))
end

local function refreshBestLabels()
	for mode, label in bestLabels do
		local text = bestText(mode)
		if label.Text ~= text then
			label.Text = text
		end
	end
end

-- ---------------------------------------------------------------------
-- AIM-TRAINER: Logik
-- ---------------------------------------------------------------------
local function now(): number
	return os.clock()
end

-- Liegt das Ziel unter dem Fadenkreuz (Kamera-Mitte)?
local function onTarget(target: BasePart, radius: number): boolean
	local camera = workspace.CurrentCamera
	if camera == nil or target.Transparency >= 1 then
		return false
	end
	local cf = camera.CFrame
	local to = target.Position - cf.Position
	local dir = cf.LookVector
	local along = to:Dot(dir)
	if along <= 0 then
		return false
	end
	return (to - dir * along).Magnitude <= radius
end

local function placeAt(r: Run, yawDeg: number, pitchDeg: number, distance: number)
	local rot = r.BaseCF * CFrame.Angles(0, math.rad(yawDeg), 0) * CFrame.Angles(math.rad(pitchDeg), 0, 0)
	r.Target.Position = r.BaseCF.Position + rot.LookVector * distance
end

local function newTarget(folder: Folder, radius: number): BasePart
	local part = Instance.new("Part")
	part.Name = "AimTarget"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(255, 65, 75)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = folder
	return part
end

local function stopRun()
	local r = run
	if r == nil then
		return
	end
	run = nil
	if r.Conn then
		r.Conn:Disconnect()
	end
	r.Folder:Destroy()
end

local function abortRun(showToast: boolean)
	if run == nil then
		return
	end
	stopRun()
	hideTrainerHud()
	if showToast then
		toast(T("bot.training.abort"), "Info")
	end
end

local function finish(mode: string, value: number, resultText: string)
	stopRun()
	local better = best[mode] == nil
		or (mode == "Tracking" and value > best[mode])
		or (mode ~= "Tracking" and value < best[mode])
	if better then
		best[mode] = value
	end
	local h = ensureTrainerHud()
	if h then
		h.Title.Text = if better then T("bot.training.newBest") else T("bot.training." .. string.lower(mode))
		h.Info.Text = resultText
		h.Frame.Visible = true
	end
	toast(resultText, if better then "Success" else "Info")
	refreshBestLabels()
	hideTrainerHud(3)
end

local function spawnFlick(r: Run)
	local yawLo, yawHi = cfgPair("FlickYaw", 12, 42)
	local distLo, distHi = cfgPair("FlickDistance", 16, 34)
	local pitchMax = cfgNum("FlickPitch", 12)
	local side = if rng:NextNumber() < 0.5 then -1 else 1
	placeAt(r, side * between(yawLo, yawHi), between(-pitchMax, pitchMax), between(distLo, distHi))
	r.Target.Transparency = 0
end

local function showReactionTarget(r: Run)
	local yawMax = cfgNum("ReactionYaw", 14)
	placeAt(r, between(-yawMax, yawMax), between(-5, 5), cfgNum("ReactionDistance", 20))
	r.Target.Transparency = 0
	r.Target.Color = Color3.fromRGB(70, 210, 80)
	r.ShownAt = now()
	r.Phase = "Show"
end

local function nextReactionRound(r: Run)
	local rounds = math.max(1, math.floor(cfgNum("ReactionRounds", 5)))
	if r.Round >= rounds then
		local sum = 0
		for _, v in r.Times do
			sum += v
		end
		local avg = sum / math.max(1, #r.Times)
		finish("Reaction", avg, T("bot.training.reactionResult", math.floor(avg + 0.5)))
		return
	end
	r.Round += 1
	r.Target.Transparency = 1
	local lo, hi = cfgPair("ReactionDelay", 1.2, 3.5)
	r.AppearAt = now() + between(lo, hi)
	r.Phase = "Wait"
	setTrainerText(T("bot.training.reaction"), T("bot.training.reactionWait", r.Round, rounds))
end

local function onShot()
	local r = run
	if r == nil or not inRange then
		return
	end
	if r.Phase == "Count" then
		return
	end
	r.Shots += 1
	if r.Mode == "Flick" then
		if onTarget(r.Target, r.Radius) then
			r.Hits += 1
			r.Index += 1
			local total = math.max(1, math.floor(cfgNum("FlickTargets", 10)))
			if r.Index >= total then
				local elapsed = now() - r.T0
				local acc = math.floor(r.Hits / math.max(1, r.Shots) * 100 + 0.5)
				finish("Flick", elapsed, T("bot.training.flickResult", formatSeconds(elapsed), r.Hits, r.Shots, acc))
				return
			end
			spawnFlick(r)
			setTrainerText(nil, T("bot.training.count", r.Index, total))
		end
	elseif r.Mode == "Reaction" then
		if r.Phase == "Wait" then
			-- zu früh: Wartezeit neu
			local lo, hi = cfgPair("ReactionDelay", 1.2, 3.5)
			r.AppearAt = now() + between(lo, hi)
			setTrainerText(nil, T("bot.training.reactionEarly"))
		elseif r.Phase == "Show" and onTarget(r.Target, r.Radius) then
			local ms = (now() - r.ShownAt) * 1000
			table.insert(r.Times, ms)
			setTrainerText(nil, T("bot.training.reactionHit", math.floor(ms + 0.5)))
			nextReactionRound(r)
		end
	end
	-- Tracking: Schüsse egal (Fadenkreuz halten zählt)
end

local function stepRun(dt: number)
	local r = run
	if r == nil then
		return
	end
	if not inRange then
		abortRun(true)
		return
	end
	local t = now()
	if r.Phase == "Count" then
		if t < r.GoAt then
			return
		end
		r.T0 = t
		if r.Mode == "Flick" then
			r.Phase = "Live"
			spawnFlick(r)
			setTrainerText(T("bot.training.go"), T("bot.training.count", 0, math.floor(cfgNum("FlickTargets", 10))))
		elseif r.Mode == "Tracking" then
			r.Phase = "Live"
			r.Target.Transparency = 0
		else
			nextReactionRound(r)
		end
		return
	end
	if r.Mode == "Flick" then
		if t - r.T0 > cfgNum("FlickTimeout", 30) then
			abortRun(true)
		end
	elseif r.Mode == "Tracking" then
		local duration = cfgNum("TrackSeconds", 15)
		r.Elapsed += dt
		local e = r.Elapsed
		placeAt(
			r,
			cfgNum("TrackYaw", 30) * math.sin(r.Omega1 * e + r.Phase1),
			cfgNum("TrackPitch", 10) * math.sin(r.Omega2 * e + r.Phase2),
			cfgNum("TrackDistance", 24)
		)
		local on = onTarget(r.Target, r.Radius)
		if on then
			r.OnTime += dt
		end
		r.Target.Color = if on then Color3.fromRGB(70, 210, 80) else Color3.fromRGB(255, 65, 75)
		local pct = r.OnTime / math.max(0.01, e) * 100
		setTrainerText(nil, T("bot.training.trackingLive", math.floor(pct + 0.5), math.max(0, math.ceil(duration - e))))
		if e >= duration then
			local score = r.OnTime / duration * 100
			finish("Tracking", score, T("bot.training.trackingResult", math.floor(score + 0.5)))
		end
	elseif r.Mode == "Reaction" then
		if r.Phase == "Wait" and t >= r.AppearAt then
			showReactionTarget(r)
		elseif r.Phase == "Show" and t - r.ShownAt > cfgNum("ReactionTimeout", 2.5) then
			table.insert(r.Times, cfgNum("ReactionTimeout", 2.5) * 1000)
			nextReactionRound(r)
		end
	end
end

local function startRun(mode: string)
	if not inRange then
		toast(T("bot.training.onlyRange"), "Error")
		return
	end
	local camera = workspace.CurrentCamera
	if camera == nil then
		return
	end
	abortRun(false)
	if ctx and ctx.Windows then
		pcall(ctx.Windows.Close, "Training")
	end
	local folder = Instance.new("Folder")
	folder.Name = "AimTrainer"
	folder.Parent = camera
	local radius = if mode == "Flick"
		then cfgNum("FlickRadius", 1.1)
		elseif mode == "Tracking" then cfgNum("TrackRadius", 1.3)
		else cfgNum("ReactionRadius", 1.4)
	local target = newTarget(folder, radius)
	target.Transparency = 1
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	local origin = camera.CFrame.Position
	local speedLo, speedHi = cfgPair("TrackSpeed", 0.6, 1.4)
	local omega = between(speedLo, speedHi)
	local r: Run = {
		Mode = mode,
		Phase = "Count",
		GoAt = now() + 1,
		T0 = now(),
		Folder = folder,
		Target = target,
		Radius = radius,
		BaseCF = CFrame.lookAt(origin, origin + flat.Unit),
		Hits = 0,
		Shots = 0,
		Index = 0,
		OnTime = 0,
		Elapsed = 0,
		Omega1 = omega,
		Omega2 = omega * 1.37,
		Phase1 = rng:NextNumber() * math.pi * 2,
		Phase2 = rng:NextNumber() * math.pi * 2,
		Round = 0,
		AppearAt = 0,
		ShownAt = 0,
		Times = {},
		Conn = nil,
	}
	run = r
	r.Conn = RunService.PreRender:Connect(stepRun)
	local hint = if mode == "Flick"
		then T("bot.training.flickHint", math.floor(cfgNum("FlickTargets", 10)))
		elseif mode == "Tracking" then T("bot.training.trackingHint", math.floor(cfgNum("TrackSeconds", 15)))
		else T("bot.training.reactionHint", math.floor(cfgNum("ReactionRounds", 5)))
	setTrainerText(T("bot.training." .. string.lower(mode)), hint)
end

-- ---------------------------------------------------------------------
-- DPS-ANZEIGE (rechts, nur in der Range)
-- ---------------------------------------------------------------------
local function ensureHud()
	if hud or UI == nil or ctx == nil or ctx.Gui == nil then
		return
	end
	local frame = UI.Create("Frame", {
		Name = "TrainingDps",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.45, 0),
		Size = UDim2.fromOffset(190, 150),
		BackgroundColor3 = UI.Theme.PanelDark,
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = ctx.Gui,
	}, { UI.Corner(12), UI.Stroke(UI.Theme.Black, 3) })
	local function row(y: number, caption: string, height: number, maxText: number): TextLabel
		UI.Label({
			Position = UDim2.fromOffset(10, y),
			Size = UDim2.new(0.45, -10, 0, height),
			Text = caption,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = UI.Theme.SubText,
			MaxText = 16,
			Outline = 2,
			Parent = frame,
		})
		return UI.Label({
			Position = UDim2.new(0.45, 0, 0, y),
			Size = UDim2.new(0.55, -10, 0, height),
			Text = "0",
			TextXAlignment = Enum.TextXAlignment.Right,
			MaxText = maxText,
			Outline = 2.5,
			Font = UI.Fonts and UI.Fonts.Number or UI.Font,
			Parent = frame,
		})
	end
	local dps = row(8, T("bot.training.dps"), 40, 34)
	local total = row(52, T("bot.training.total"), 28, 22)
	local last = row(84, T("bot.training.last"), 28, 20)
	local popped = UI.Label({
		Position = UDim2.fromOffset(6, 114),
		Size = UDim2.new(1, -12, 0, 30),
		Text = T("bot.training.popped"),
		TextColor3 = UI.Theme.Yellow,
		MaxText = 26,
		Outline = 3,
		Visible = false,
		Font = UI.Fonts and UI.Fonts.Pop or UI.Font,
		Parent = frame,
	})
	dps.TextColor3 = UI.Theme.Yellow
	hud = { Frame = frame, Dps = dps, Total = total, Last = last, Popped = popped }
end

local function refreshHud()
	local h = hud
	if h == nil then
		return
	end
	local t = now()
	local reset = cfgNum("DpsReset", 3)
	local s = dpsState
	local dps = 0
	if s.Session > 0 then
		if t - s.Last <= reset then
			dps = s.Session / math.max(1, t - s.Start)
		else
			dps = s.Session / math.max(1, s.Last - s.Start)
		end
	end
	local dpsText = tostring(math.floor(dps + 0.5))
	if h.Dps.Text ~= dpsText then
		h.Dps.Text = dpsText
	end
	local totalText = tostring(math.floor(s.Total + 0.5))
	if h.Total.Text ~= totalText then
		h.Total.Text = totalText
	end
	if h.Last.Text ~= s.LastText then
		h.Last.Text = s.LastText
	end
	local showPopped = t < s.PoppedUntil
	if h.Popped.Visible ~= showPopped then
		h.Popped.Visible = showPopped
	end
end

local function setHudVisible(on: boolean)
	ensureHud()
	local h = hud
	if h and h.Frame.Visible ~= on then
		h.Frame.Visible = on
	end
end

local function confettiAt(targetId: any)
	if type(targetId) ~= "number" then
		return
	end
	local modules = ctx and ctx.Modules
	local fx = if type(modules) == "table" then modules.CombatFX else nil
	if not (fx and type(fx.Pop) == "function") then
		return
	end
	for _, model in CollectionService:GetTagged(DUMMY_TAG) do
		if model:IsA("Model") and model:GetAttribute("CombatantId") == targetId then
			local head = model:FindFirstChild("Head")
			if head and head:IsA("BasePart") then
				pcall(fx.Pop, head.Position, "F_Confetti", Color3.fromRGB(255, 220, 50))
			end
			return
		end
	end
end

local function onHit(data: any)
	if not inRange or type(data) ~= "table" then
		return
	end
	local amount = tonumber(data.D) or 0
	if amount ~= amount or amount < 0 then
		return
	end
	local t = now()
	local s = dpsState
	if t - s.Last > cfgNum("DpsReset", 3) then
		s.Start = t
		s.Session = 0
	end
	s.Session += amount
	s.Total += amount
	s.Last = t
	s.LastText = string.format(
		"%d %s",
		math.floor(amount + 0.5),
		if data.H == true then T("bot.training.head") else T("bot.training.body")
	)
	if data.K == true then
		s.PoppedUntil = t + 1.2
		confettiAt(data.T)
	end
	refreshHud()
end

-- ---------------------------------------------------------------------
-- PUPPEN-ANZEIGE (lokale BillboardGuis)
-- ---------------------------------------------------------------------
local function removeDummy(model: Model)
	local entry = dummyGuis[model]
	if entry == nil then
		return
	end
	dummyGuis[model] = nil
	dummyCount -= 1
	for _, conn in entry.Conns do
		conn:Disconnect()
	end
	entry.Gui:Destroy()
end

local function updateDummy(model: Model)
	local entry = dummyGuis[model]
	if entry == nil then
		return
	end
	local maxHp = tonumber(model:GetAttribute("MaxHp")) or 150
	local hp = tonumber(model:GetAttribute("Hp")) or maxHp
	local ratio = math.clamp(hp / math.max(1, maxHp), 0, 1)
	entry.Fill.Size = UDim2.fromScale(ratio, 1)
	entry.Fill.BackgroundColor3 = Color3.fromRGB(255, 65, 75):Lerp(Color3.fromRGB(70, 210, 80), ratio)
end

local function addDummy(instance: Instance)
	if not instance:IsA("Model") or dummyGuis[instance] or dummyCount >= MAX_DUMMY_GUIS then
		return
	end
	local model = instance :: Model
	task.spawn(function()
		local head = model:WaitForChild("Head", 10)
		if not (head and head:IsA("BasePart")) or dummyGuis[model] or model.Parent == nil then
			return
		end
		local gui = Instance.new("BillboardGui")
		gui.Name = "TrainingDummyGui"
		gui.Size = UDim2.fromOffset(110, 34)
		gui.StudsOffset = Vector3.new(0, 1.9, 0)
		gui.MaxDistance = 170
		gui.LightInfluence = 0
		gui.ResetOnSpawn = false
		gui.Adornee = head
		local distance = tonumber(model:GetAttribute("Distance")) or 0
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 0, 18)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0.2
		label.Text = T("bot.training.dummy", math.floor(distance + 0.5))
		label.Parent = gui
		local back = Instance.new("Frame")
		back.Position = UDim2.new(0.1, 0, 0, 21)
		back.Size = UDim2.new(0.8, 0, 0, 10)
		back.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
		back.BorderSizePixel = 0
		back.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = back
		local fill = Instance.new("Frame")
		fill.Size = UDim2.fromScale(1, 1)
		fill.BorderSizePixel = 0
		fill.BackgroundColor3 = Color3.fromRGB(70, 210, 80)
		fill.Parent = back
		local fillCorner = Instance.new("UICorner")
		fillCorner.CornerRadius = UDim.new(0, 5)
		fillCorner.Parent = fill
		gui.Parent = head
		local conns: { RBXScriptConnection } = {}
		dummyGuis[model] = { Gui = gui, Fill = fill, Conns = conns }
		dummyCount += 1
		table.insert(
			conns,
			model:GetAttributeChangedSignal("Hp"):Connect(function()
				updateDummy(model)
			end)
		)
		table.insert(
			conns,
			model.AncestryChanged:Connect(function(_, parent)
				if parent == nil then
					removeDummy(model)
				end
			end)
		)
		updateDummy(model)
	end)
end

-- ---------------------------------------------------------------------
-- FENSTER "Training"
-- ---------------------------------------------------------------------
local function refreshWindow()
	if win == nil then
		return
	end
	if goRow then
		goRow.Visible = not inRange
	end
	for key, card in cards do
		local equipped = inRange and rangeLoadout[card.Slot] == key
		card.Button.SetColor(if equipped then UI.Theme.Green else card.Color)
		card.Button.SetSub(if equipped then T("bot.training.equipped") else card.Stats)
	end
	refreshBestLabels()
end

local function chooseWeapon(def: any)
	task.spawn(function()
		local reply = request("RangeWeapon", { Slot = def.Slot, Key = def.Key })
		if type(reply) ~= "table" or reply.Ok ~= true then
			return
		end
		if reply.Status == "Teleported" then
			if ctx and ctx.Windows then
				pcall(ctx.Windows.Close, "Training")
			end
		elseif reply.Status == "Equipped" then
			rangeLoadout[def.Slot] = def.Key
			refreshWindow()
			toast(T("bot.range.equipped", weaponName(def)), "Success")
		end
	end)
end

local function goToRange()
	local key = rangeLoadout.Primary
	if type(key) ~= "string" then
		local weapons = config and config.Weapons
		local default = if type(weapons) == "table" then weapons.DefaultLoadout else nil
		key = if type(default) == "table" and type(default.Primary) == "string" then default.Primary else "PopRifle"
	end
	local def = config and type(config.Weapon) == "function" and config.Weapon(key) or nil
	chooseWeapon(def or { Slot = "Primary", Key = key })
end

local function startPractice(diff: string)
	if ctx and ctx.Windows then
		pcall(ctx.Windows.Close, "Training")
	end
	task.spawn(function()
		local reply = request("PracticeStart", diff)
		if type(reply) == "table" and reply.Ok == true then
			toast(T("bot.training.practice", T("bot.diff." .. diff)), "Info")
		end
	end)
end

local function buildWindow()
	win = UI.Window(T("bot.training.title"), 660, 560, UI.Theme.Cyan)
	local content = win.Content
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	UI.Label({
		Size = UDim2.new(1, 0, 0, 26),
		Text = T("bot.training.hint"),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 18,
		Outline = 2,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
	-- außerhalb der Range: Hinweis + Teleport-Knopf
	local row = UI.Row(content, nextOrder(), 48)
	UI.Label({
		Size = UDim2.new(1, -196, 1, 0),
		Text = T("bot.training.goRange"),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		MaxText = 16,
		Outline = 2,
		LayoutOrder = 1,
		Parent = row,
	})
	UI.Button({
		Size = UDim2.fromOffset(186, 44),
		Text = T("bot.training.goButton"),
		Color = UI.Theme.Green,
		MaxText = 20,
		LayoutOrder = 2,
		Parent = row,
	}, goToRange)
	goRow = row

	-- Waffen-Regal: jede Waffe gratis
	UI.Section(content, T("bot.training.rack"), nextOrder())
	for _, slot in SLOTS do
		UI.Label({
			Size = UDim2.new(1, 0, 0, 22),
			Text = T("bot.training.slot." .. slot),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = UI.Theme.SubText,
			MaxText = 16,
			Outline = 2,
			LayoutOrder = nextOrder(),
			Parent = content,
		})
		local grid = UI.Grid(content, nextOrder(), 196, 66)
		local color = slotColor(slot)
		for i, def in weaponsOf(slot) do
			local stats = statsText(def)
			local button = UI.Button({
				Name = def.Key,
				Text = weaponName(def),
				Sub = stats,
				Color = color,
				MaxText = 20,
				SubMax = 13,
				LayoutOrder = i,
				Parent = grid,
			}, function()
				chooseWeapon(def)
			end)
			cards[def.Key] = { Button = button, Slot = slot, Def = def, Stats = stats, Color = color }
		end
	end

	-- Bot-Duell (Practice)
	UI.Section(content, T("bot.training.duel"), nextOrder())
	UI.Label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = T("bot.training.duelHint"),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 16,
		Outline = 2,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
	local duelRow = UI.Row(content, nextOrder(), 50)
	for i, diff in DUEL_DIFFS do
		UI.Button({
			Size = UDim2.fromOffset(146, 46),
			Text = T("bot.diff." .. diff),
			Color = diffColor(diff),
			MaxText = 20,
			LayoutOrder = i,
			Parent = duelRow,
		}, function()
			startPractice(diff)
		end)
	end

	-- Aim-Trainer
	UI.Section(content, T("bot.training.aim"), nextOrder())
	UI.Label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = T("bot.training.aimHint"),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 15,
		Outline = 2,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
	local modes = {
		{ Mode = "Flick", Hint = T("bot.training.flickHint", math.floor(cfgNum("FlickTargets", 10))) },
		{ Mode = "Tracking", Hint = T("bot.training.trackingHint", math.floor(cfgNum("TrackSeconds", 15))) },
		{ Mode = "Reaction", Hint = T("bot.training.reactionHint", math.floor(cfgNum("ReactionRounds", 5))) },
	}
	for _, m in modes do
		local card = UI.Card({ Size = UDim2.new(1, 0, 0, 64), LayoutOrder = nextOrder(), Parent = content })
		UI.Label({
			Position = UDim2.fromOffset(12, 4),
			Size = UDim2.new(1, -190, 0, 26),
			Text = T("bot.training." .. string.lower(m.Mode)),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = UI.Theme.Yellow,
			MaxText = 22,
			Outline = 2.5,
			Parent = card,
		})
		UI.Label({
			Position = UDim2.fromOffset(12, 30),
			Size = UDim2.new(0.5, -100, 0, 28),
			Text = m.Hint,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			MaxText = 14,
			Outline = 2,
			Parent = card,
		})
		bestLabels[m.Mode] = UI.Label({
			Position = UDim2.new(0.5, -84, 0, 30),
			Size = UDim2.new(0.5, -104, 0, 28),
			Text = bestText(m.Mode),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = UI.Theme.Cash,
			MaxText = 15,
			Outline = 2,
			Parent = card,
		})
		UI.Button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(160, 46),
			Text = T("bot.training.start"),
			Color = UI.Theme.Orange,
			MaxText = 20,
			Parent = card,
		}, function()
			startRun(m.Mode)
		end)
	end
end

local function openWindow()
	if UI == nil then
		return
	end
	abortRun(false)
	if win == nil then
		buildWindow()
	end
	refreshWindow()
	UI.OpenWindow(win)
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function Training.Open()
	if ctx and ctx.Windows and type(ctx.Windows.Open) == "function" then
		ctx.Windows.Open("Training")
	else
		openWindow()
	end
end

function Training.Init(context: any)
	ctx = context
	UI = if type(ctx) == "table" then ctx.UI else nil
	config = if type(ctx) == "table" then ctx.Config else nil
	local bots = config and config.Bots
	rangeCfg = if type(bots) == "table" and type(bots.Range) == "table" then bots.Range else {}
end

function Training.Start()
	if ctx == nil then
		return
	end
	if ctx.Windows and type(ctx.Windows.Register) == "function" then
		ctx.Windows.Register("Training", openWindow)
	end
	local hooks = ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		hooks.On("Armed", function(info: any)
			local wasInRange = inRange
			inRange = type(info) == "table" and info.Ctx == "Range"
			if inRange then
				table.clear(rangeLoadout)
				if type(info.Loadout) == "table" then
					for slot, key in info.Loadout do
						if type(slot) == "string" and type(key) == "string" then
							rangeLoadout[slot] = key
						end
					end
				end
				if not wasInRange then
					dpsState.Total = 0
					dpsState.Session = 0
					dpsState.Last = -math.huge
					dpsState.LastText = "–"
				end
			else
				abortRun(false)
			end
			setHudVisible(inRange)
			refreshHud()
			refreshWindow()
		end)
		hooks.On("Disarmed", function()
			if inRange then
				abortRun(run ~= nil)
			end
			inRange = false
			setHudVisible(false)
			refreshWindow()
		end)
		hooks.On("Combat:Hit", onHit)
		hooks.On("Shot", function()
			onShot()
		end)
		hooks.On("LocalPopped", function()
			abortRun(run ~= nil)
		end)
		hooks.On("WindowOpened", function(name: any)
			if name ~= "Training" and run ~= nil then
				abortRun(true)
			end
		end)
	end
	-- Fallback ohne WeaponClient (WP4): Linksklick zählt als Schuss für den Aim-Trainer
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or run == nil then
			return
		end
		local modules = ctx.Modules
		if type(modules) == "table" and modules.WeaponClient ~= nil then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			onShot()
		end
	end)
	-- Bot-Kabine: Prompts mit Attribut "Practice" (QueueUI übernimmt das normalerweise)
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		local diff = prompt:GetAttribute("Practice")
		if type(diff) ~= "string" then
			return
		end
		local modules = ctx.Modules
		if type(modules) == "table" and modules.QueueUI ~= nil then
			return
		end
		startPractice(diff)
	end)
	-- Puppen-Anzeigen
	CollectionService:GetInstanceAddedSignal(DUMMY_TAG):Connect(addDummy)
	CollectionService:GetInstanceRemovedSignal(DUMMY_TAG):Connect(function(instance: Instance)
		if instance:IsA("Model") then
			removeDummy(instance)
		end
	end)
	for _, instance in CollectionService:GetTagged(DUMMY_TAG) do
		addDummy(instance)
	end
	-- DPS-Anzeige weich nachführen (nur in der Range)
	RunService.Heartbeat:Connect(function(dt: number)
		if not inRange then
			return
		end
		hudAccum += dt
		if hudAccum >= HUD_REFRESH then
			hudAccum = 0
			refreshHud()
		end
	end)
end

return Training
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Erste Minuten / FTUE (Client/Modules/Tutorial)
--  Besitzer: WP5 (Match-UI). Vertrag: DESIGN.md B1.1 (Funnel-Schritte über Request/Server), C7.4.
--
--  Schritt 1: Willkommens-Karten ("Duelle!", "Alles erspielbar", "Fair: kein Pay-to-Win") mit
--    "ERSTES DUELL!" (Request "TutorialStart") und "Überspringen" (TutorialFlag "Skipped");
--    beim Zeigen TutorialFlag "Welcome" (Funnel 2). Nur wenn Flags.Tutorial ~= true.
--  Schritt 2: im Tutorial-Match (Match:Start Tutorial = true) je Runde eine Hinweis-Karte
--    (Bewegen/Zielen+Schießen · Nachladen/Wechseln · Rutschen), passend zum Gerät.
--  Schritt 4/5: nach dem Tutorial-Match TutorialFlag "Done", dann Pfeil-Tour Locker → Shop → Pads
--    (Leuchtpfeil + Leitstrahl, lokal), am Ende TutorialFlag "TourDone" (Funnel 8).
--  Funnel 3–7 meldet MatchService, 1 MetricsService, 9–11 WP8/WP9.
--
--  Öffentliche API: Tutorial.ShowWelcome(), Tutorial.StartTour(), Tutorial.Init(ctx), Tutorial.Start()
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local Tutorial = {}

local player = Players.LocalPlayer
local ctx: any = nil

local HINT_SECONDS = 6
local TOUR_STEP_TIMEOUT = 90

local welcome: Frame? = nil
local hintCard: Frame? = nil
local hintText: TextLabel? = nil
local hintToken = 0
local tourCard: Frame? = nil
local tourText: TextLabel? = nil
local welcomeShown = false
local tutorialMatch = false
local tutorialFinished = false
local inMatch = false
local touring = false
local tourStep = 0
local tourStepAt = 0
local tourParts: { Instance } = {}
local tourBeam: Beam? = nil
local tourConn: RBXScriptConnection? = nil
local flagsKnown = false

local function T(key: string, ...: any): string
	return if ctx then ctx.T(key, ...) else key
end

local function flags(): any
	local f = ctx.State and ctx.State.Flags
	return if type(f) == "table" then f else nil
end

local function request(action: string, arg: any?)
	task.spawn(function()
		ctx.Request(action, arg)
	end)
end

local function inputKind(): string
	local controls = ctx.Modules and ctx.Modules.Controls
	if controls and type(controls.Input) == "function" then
		local ok, kind = pcall(controls.Input)
		if ok and type(kind) == "string" then
			return kind
		end
	end
	return "KBM"
end

local function tourCfg(): any
	local modes = ctx.Config.Modes
	return if modes and type(modes.Tutorial) == "table" then modes.Tutorial else {}
end

-- ---------------------------------------------------------------------
-- 1) WILLKOMMEN (3 Karten)
-- ---------------------------------------------------------------------
local function hideWelcome()
	if welcome then
		welcome.Visible = false
	end
end

local function buildWelcome()
	local theme = UI.Theme
	local frame = UI.Create("Frame", {
		Name = "TutorialWelcome",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Visible = false,
		ZIndex = 60,
		Parent = ctx.Gui,
	})
	UI.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.08, 0),
		Size = UDim2.fromOffset(700, 64),
		Text = T("match.tutorial.welcome"),
		Font = UI.Fonts.Banner,
		MaxText = 52,
		Outline = 4,
		TextColor3 = theme.Yellow,
		ZIndex = 61,
		Parent = frame,
	})
	local row = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46),
		Size = UDim2.fromOffset(720, 230),
		BackgroundTransparency = 1,
		ZIndex = 61,
		Parent = frame,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 16),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local cards = {
		{ "match.tutorial.card1Title", "match.tutorial.card1Text", theme.Orange, "⚔" },
		{ "match.tutorial.card2Title", "match.tutorial.card2Text", theme.Green, "🔓" },
		{ "match.tutorial.card3Title", "match.tutorial.card3Text", theme.Blue, "⚖" },
	}
	for i, card in ipairs(cards) do
		local c = UI.Card({
			LayoutOrder = i,
			Size = UDim2.fromOffset(224, 230),
			BackgroundColor3 = card[3],
			ZIndex = 62,
			Parent = row,
		})
		UI.Label({
			Position = UDim2.fromOffset(0, 10),
			Size = UDim2.new(1, 0, 0, 56),
			Text = card[4],
			MaxText = 48,
			ZIndex = 63,
			Parent = c,
		})
		UI.Label({
			Position = UDim2.fromOffset(10, 70),
			Size = UDim2.new(1, -20, 0, 40),
			Text = UI.Upper(T(card[1])),
			MaxText = 26,
			Outline = 3,
			ZIndex = 63,
			Parent = c,
		})
		UI.Label({
			Position = UDim2.fromOffset(12, 114),
			Size = UDim2.new(1, -24, 0, 104),
			Text = T(card[2]),
			MaxText = 18,
			Outline = 2,
			TextWrapped = true,
			ZIndex = 63,
			Parent = c,
		})
	end
	UI.Button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.72, 0),
		Size = UDim2.fromOffset(320, 72),
		Text = T("match.tutorial.start"),
		Color = theme.Yellow,
		MaxText = 32,
		ZIndex = 62,
		Parent = frame,
	}, function()
		hideWelcome()
		local reply = ctx.Request("TutorialStart")
		if reply == nil then
			-- Start ging nicht (z. B. Arenen voll): Karten bleiben erreichbar über das PLAY-Menü
			welcomeShown = false
		end
	end)
	UI.Button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.72, 84),
		Size = UDim2.fromOffset(200, 44),
		Text = T("match.tutorial.skip"),
		Color = theme.Gray,
		MaxText = 20,
		ZIndex = 62,
		Parent = frame,
	}, function()
		hideWelcome()
		ctx.Request("TutorialFlag", "Skipped")
	end)
	welcome = frame
end

function Tutorial.ShowWelcome()
	if inMatch or welcomeShown then
		return
	end
	welcomeShown = true
	if welcome then
		welcome.Visible = true
	end
	request("TutorialFlag", "Welcome")
end

-- ---------------------------------------------------------------------
-- 2) HINWEIS-KARTEN im Tutorial-Match
-- ---------------------------------------------------------------------
local function buildHint()
	local theme = UI.Theme
	local card = UI.Card({
		Name = "TutorialHint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -170),
		Size = UDim2.fromOffset(520, 92),
		BackgroundColor3 = theme.PanelDark,
		Visible = false,
		ZIndex = 35,
		Parent = ctx.Gui,
	})
	hintText = UI.Label({
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -28, 1, -16),
		Text = "",
		MaxText = 22,
		Outline = 2,
		TextWrapped = true,
		ZIndex = 36,
		Parent = card,
	})
	hintCard = card
end

local function showHint(round: number)
	local card, label = hintCard, hintText
	if not card or not label then
		return
	end
	local index = math.clamp(round, 1, 3)
	local suffix = if inputKind() == "Touch" then "Touch" elseif inputKind() == "Gamepad" then "Pad" else ""
	label.Text = T("match.tutorial.hint" .. index .. suffix)
	card.Visible = true
	hintToken += 1
	local token = hintToken
	task.delay(HINT_SECONDS, function()
		if token == hintToken and card then
			card.Visible = false
		end
	end)
end

-- ---------------------------------------------------------------------
-- 3) PFEIL-TOUR (Locker → Shop → Pads)
-- ---------------------------------------------------------------------
local function clearTourWorld()
	for _, inst in ipairs(tourParts) do
		inst:Destroy()
	end
	table.clear(tourParts)
	tourBeam = nil
end

local function finishTour()
	touring = false
	clearTourWorld()
	if tourConn then
		tourConn:Disconnect()
		tourConn = nil
	end
	if tourCard then
		tourCard.Visible = false
	end
	request("TutorialFlag", "TourDone")
	ctx.Toast(T("match.tutorial.tourDone"), "Success")
end

local function tourTargets(): { { Key: string, Pos: Vector3 } }
	local list = tourCfg().TourTargets
	return if type(list) == "table" then list else {}
end

local function stepText(key: string): string
	if key == "Shop" then
		local weaponKey = tourCfg().TourWeapon or "BuzzSMG"
		local def = ctx.Config.Weapon and ctx.Config.Weapon(weaponKey)
		local name = if def then ctx.Lang.Pick(ctx.Lang_(), def.Name) else weaponKey
		local price = if def then def.Price else 0
		return T("match.tutorial.tour.Shop", name, price)
	end
	return T("match.tutorial.tour." .. key)
end

local function buildArrow(pos: Vector3): BasePart
	-- Leuchtpfeil aus Parts (Keil nach unten + Stiel), lokal, nicht abfragbar
	local model = Instance.new("Model")
	model.Name = "TourArrow"
	local function part(className: string, size: Vector3): BasePart
		local p = Instance.new(className) :: BasePart
		p.Size = size
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		p.Color = UI.Theme.Yellow
		p.Parent = model
		return p
	end
	local stem = part("Part", Vector3.new(1.2, 3, 1.2))
	local tip = part("WedgePart", Vector3.new(1.2, 2.4, 2.8))
	stem.CFrame = CFrame.new(pos + Vector3.new(0, 10.5, 0))
	tip.CFrame = CFrame.new(pos + Vector3.new(0, 7.8, 0)) * CFrame.Angles(math.rad(180), 0, 0)
	local attachment = Instance.new("Attachment")
	attachment.Name = "BeamEnd"
	attachment.Position = Vector3.new(0, -1.5, 0)
	attachment.Parent = stem
	model.Parent = workspace
	table.insert(tourParts, model)
	-- Wippen (lokal, eine Tween-Schleife je Schritt)
	local info = TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	TweenService:Create(stem, info, { CFrame = stem.CFrame + Vector3.new(0, 1.2, 0) }):Play()
	TweenService:Create(tip, info, { CFrame = tip.CFrame + Vector3.new(0, 1.2, 0) }):Play()
	return stem
end

local function showTourStep()
	clearTourWorld()
	local targets = tourTargets()
	local target = targets[tourStep]
	if not target then
		finishTour()
		return
	end
	tourStepAt = os.clock()
	local stem = buildArrow(target.Pos)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		local a0 = Instance.new("Attachment")
		a0.Name = "TourBeamStart"
		a0.Parent = root
		table.insert(tourParts, a0)
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = stem:FindFirstChild("BeamEnd") :: Attachment
		beam.Color = ColorSequence.new(UI.Theme.Yellow)
		beam.Transparency = NumberSequence.new(0.35)
		beam.Width0 = 0.5
		beam.Width1 = 0.5
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Segments = 12
		beam.Parent = root
		table.insert(tourParts, beam)
		tourBeam = beam
	end
	if tourText then
		tourText.Text = stepText(target.Key)
	end
	if tourCard then
		tourCard.Visible = true
	end
end

local function nextTourStep()
	tourStep += 1
	showTourStep()
end

local function buildTourCard()
	local theme = UI.Theme
	local card = UI.Card({
		Name = "TutorialTour",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 90),
		Size = UDim2.fromOffset(560, 100),
		BackgroundColor3 = theme.PanelDark,
		Visible = false,
		ZIndex = 34,
		Parent = ctx.Gui,
	})
	tourText = UI.Label({
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -170, 1, -16),
		Text = "",
		MaxText = 22,
		Outline = 2,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 35,
		Parent = card,
	})
	UI.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(140, 56),
		Text = T("match.tutorial.next"),
		Color = theme.Green,
		MaxText = 20,
		ZIndex = 35,
		Parent = card,
	}, function()
		if touring then
			nextTourStep()
		end
	end)
	tourCard = card
end

function Tutorial.StartTour()
	if touring or inMatch then
		return
	end
	local f = flags()
	if f and f.TourDone == true then
		return
	end
	touring = true
	tourStep = 1
	showTourStep()
	if tourConn then
		tourConn:Disconnect()
	end
	local accum = 0
	tourConn = RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.25 or not touring then
			return
		end
		accum = 0
		local target = tourTargets()[tourStep]
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not target then
			return
		end
		if root and root:IsA("BasePart") then
			local d = Vector3.new(root.Position.X - target.Pos.X, 0, root.Position.Z - target.Pos.Z)
			if d.Magnitude <= (tourCfg().TourRadius or 12) then
				nextTourStep()
				return
			end
			-- neue Figur: Leitstrahl neu anhängen
			if tourBeam and tourBeam.Parent ~= root then
				showTourStep()
			end
		end
		if os.clock() - tourStepAt > TOUR_STEP_TIMEOUT then
			nextTourStep()
		end
	end)
end

-- ---------------------------------------------------------------------
-- 4) INIT / START
-- ---------------------------------------------------------------------
local function checkWelcome()
	local f = flags()
	if not f then
		return
	end
	flagsKnown = true
	if f.Tutorial ~= true and not welcomeShown and not inMatch then
		Tutorial.ShowWelcome()
	end
end

function Tutorial.Init(context: any)
	ctx = context
	buildWelcome()
	buildHint()
	buildTourCard()
end

function Tutorial.Start()
	local hooks = ctx.Hooks
	hooks.On("State", function(_state, changed)
		if type(changed) == "table" and (changed.Flags or changed.Full) and not flagsKnown then
			checkWelcome()
		end
	end)
	hooks.On("Match:Found", function()
		inMatch = true
		hideWelcome()
	end)
	hooks.On("Match:Start", function(data)
		inMatch = true
		hideWelcome()
		tutorialMatch = type(data) == "table" and data.Tutorial == true
		if touring then
			touring = false
			clearTourWorld()
			if tourCard then
				tourCard.Visible = false
			end
		end
	end)
	hooks.On("Match:Prep", function(data)
		if tutorialMatch and type(data) == "table" then
			showHint(tonumber(data.Round) or 1)
		end
	end)
	hooks.On("Match:End", function()
		if tutorialMatch then
			tutorialFinished = true
			request("TutorialFlag", "Done")
		end
	end)
	hooks.On("Match:Closed", function()
		inMatch = false
		if hintCard then
			hintCard.Visible = false
		end
		if tutorialFinished then
			tutorialFinished = false
			tutorialMatch = false
			task.delay(1.5, Tutorial.StartTour)
		end
		tutorialMatch = false
	end)
	-- State schon da (Module starten nach dem ersten State)?
	if ctx.State and type(ctx.State.Flags) == "table" then
		task.defer(checkWelcome)
	end
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – UI-BAUKASTEN im knalligen Roblox-Stil (Client/Modules/UI)
--  Besitzer: WP10 (Client-Hülle). Basis: Meteor-Heist-UI-Kit (REUSE §11) + Shooter-Ergänzungen.
--  Schrift überall FredokaOne mit schwarzer Kontur. Knöpfe: Volltonfarbe mit Verlauf, dicke
--  schwarze Kontur, dunklere 3D-Kante unten ("Lippe"), Glanz-Streifen und Feder-Effekt
--  (größer beim Drüberfahren, Stauchen + Einsinken beim Drücken). Fenster: helle blaue Fläche,
--  dicke Kontur, Titel in GROSSBUCHSTABEN, rotes X; gehen federnd auf und zeichnen die Welt
--  dahinter leicht weich. Meldungen (Toasts) ohne Kasten: großer farbiger Text mit dicker Kontur,
--  ploppt oben in der Mitte auf und verblasst. Dazu flüssig hochzählende Zahlen und getweente Balken.
--
--  Öffentliche API (REUSE §11 + C7.3/C7.4):
--    UI.Font, UI.Fonts, UI.Theme, UI.Root
--    UI.Init(ctxOrGui)                ScreenGui oder ctx (nimmt ctx.Gui) – Wurzel-UIScale, Toasts, Modal-Knopf
--    UI.Frame(dt)                     pro Frame (ruft Main.client aus dem einen PreRender-Loop)
--    UI.Create, UI.Corner, UI.Stroke, UI.TextStroke, UI.Gradient, UI.ButtonSequence, UI.FormatMult,
--    UI.FormatSteps, UI.Upper, UI.Label, UI.TextBox, UI.Button, UI.Badge, UI.SetBadge, UI.Section, UI.Row,
--    UI.Grid, UI.Card, UI.Bar, UI.SetBar, UI.Pulse, UI.Counter, UI.SetCounter, UI.RedrawCounter
--    UI.Window, UI.OpenWindow, UI.CloseWindow, UI.ToggleWindow, UI.CloseAll
--    UI.IsAnyWindowOpen(): boolean    (Shooter: Kamera gibt die Maus frei, Kampf-Eingaben gesperrt)
--    UI.Toast(text, kind?), UI.SetToastTop(offset?)
--    UI.FetchPrice(id, infoType, cb), UI.WhenRandomItemsKnown(cb), UI.RandomItemsAllowed()
--    UI.Windows = { Register(name, open, close?), Open(name), Close(name?), IsOpen(name?), Toggle(name) }  (= ctx.Windows)
--  Fenster offen -> sichtbarer Modal-Knopf (Modal = true, gibt die Maus in der Ego-Sicht frei),
--  Hooks "WindowOpened"/"WindowClosed"(name). ProximityPrompt mit Attribut "Window" öffnet das Fenster.
-- =====================================================================

local Lighting = game:GetService("Lighting")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

-- Die Roblox-Schrift (rund, dick, gut lesbar) – für ALLE normalen Texte
UI.Font = Enum.Font.FredokaOne
-- Weitere Schriften (A4): HUD-Zahlen RobotoMono, Banner LuckiestGuy, "HEADSHOT!"/"POP!" Bangers
UI.Fonts = {
	Main = Enum.Font.FredokaOne,
	Number = Enum.Font.RobotoMono,
	Banner = Enum.Font.LuckiestGuy,
	Pop = Enum.Font.Bangers,
}

-- Helle, kräftige Farben. Fensterflächen sind hellblau: weißer Text braucht darauf immer
-- eine schwarze Kontur (UI.TextStroke bzw. Outline = 2 in UI.Label).
UI.Theme = {
	Panel = Color3.fromRGB(70, 170, 255),
	PanelDark = Color3.fromRGB(35, 115, 230),
	PanelLight = Color3.fromRGB(120, 205, 255),
	Text = WHITE,
	SubText = Color3.fromRGB(235, 245, 255),
	Black = BLACK,
	Yellow = Color3.fromRGB(255, 220, 50),
	Cash = Color3.fromRGB(110, 255, 100),
	Red = Color3.fromRGB(255, 65, 75),
	Blue = Color3.fromRGB(40, 100, 245), -- kräftiges Königsblau: hebt sich vom hellblauen Fenster ab
	Green = Color3.fromRGB(70, 210, 80),
	Orange = Color3.fromRGB(255, 145, 35),
	Purple = Color3.fromRGB(175, 85, 255),
	Pink = Color3.fromRGB(255, 85, 195),
	Gray = Color3.fromRGB(120, 125, 145),
	Gold = Color3.fromRGB(255, 200, 40),
	Cyan = Color3.fromRGB(60, 220, 255),
}

-- Tween-Einstellungen (einmal angelegt und immer wiederverwendet)
local HOVER_INFO = TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local PRESS_INFO = TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local RELEASE_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local SQUASH_RELEASE_INFO = TweenInfo.new(0.45, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
local GLOW_INFO = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local OPEN_FADE_INFO = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local OPEN_POP_INFO = TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local CLOSE_INFO = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local BLUR_IN_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local BLUR_OUT_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local COUNTER_FLASH_INFO = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true)
local BAR_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PULSE_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TOAST_GROW_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TOAST_RISE_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TOAST_POP_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TOAST_FADE_INFO = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TOAST_OUT_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local COUNTER_INTERVAL = 1 / 30 -- Zahlen höchstens 30x pro Sekunde neu schreiben
local COUNTER_POP_GAP = 0.15 -- so oft höchstens ein Aufploppen pro Zähler
local BUTTON_LIP = 4 -- so viele Pixel dunklere 3D-Kante ("Lippe") unter jedem Knopf
local LIP_DARKEN = 0.45 -- Lippe = Knopffarbe, so viel Richtung Schwarz
local BUTTON_NORMAL = UDim2.new(1, 0, 1, -BUTTON_LIP) -- Knopf-Fläche (darunter schaut die Lippe raus)
local BUTTON_SQUASH = UDim2.new(1.07, 0, 0.86, -BUTTON_LIP) -- gedrückter Knopf: breiter + flacher
local BUTTON_UP = UDim2.new(0.5, 0, 0.5, -BUTTON_LIP / 2)
local BUTTON_DOWN = UDim2.new(0.5, 0, 0.5, BUTTON_LIP / 2) -- gedrückt: sinkt auf die Lippe
local BUTTON_PRESSED_TINT = Color3.fromRGB(215, 215, 215) -- gedrückt: Knopf etwas dunkler
local SHINE_NORMAL = 0.8 -- Glanz-Streifen (Durchsichtigkeit)
local SHINE_HOVER = 0.55 -- Maus drüber: Glanz heller
local BLUR_SIZE = 6 -- dezenter Weichzeichner hinter offenen Fenstern
local WINDOW_SLIDE = 36 -- Fenster gleiten aus so vielen Pixeln von unten herein
local WINDOW_STROKE = 5 -- dicke schwarze Fenster-Kontur (passt genau in den Rand der Animations-Fläche)
local TOAST_WIDTH = 680
local TOAST_TEXT_WIDTH = TOAST_WIDTH - 24
local TOAST_MIN_HEIGHT = 34
local TOAST_GAP = 2
local TOAST_RISE = 10 -- Toasts ploppen aus so vielen Pixeln weiter unten auf (und steigen beim Gehen hoch)
local MAX_TOASTS = 5
local MAX_TOAST_POOL = 8 -- so viele fertige Toasts werden zum Wiederverwenden aufgehoben
local RANDOM_STATE_WAIT = 30 -- so lange auf den Server-Wert "RandomAllowed" warten, dann PolicyService selbst fragen
local HOVER_SOUND_GAP = 0.08 -- Hover-Ton höchstens so oft

-- Gotham-Schriften (alter Look, keine lokale Datei) werden automatisch durch FredokaOne ersetzt
local GOTHAM_FONTS: { [Enum.Font]: boolean } = {
	[Enum.Font.Gotham] = true,
	[Enum.Font.GothamMedium] = true,
	[Enum.Font.GothamBold] = true,
	[Enum.Font.GothamBlack] = true,
}

local root: ScreenGui? = nil
local ctx: any = nil -- gemeinsamer Rucksack (nach UI.Init mit ctx gesetzt; für Hooks/Sfx/State)
UI.Root = nil :: ScreenGui? -- die ScreenGui der Oberfläche (nach UI.Init gesetzt)

-- Optionale Sounds über Sfx (fehlt das Modul, passiert einfach nichts)
local lastHoverSound = 0
local function playUiSound(role: string)
	local modules = ctx and ctx.Modules
	local sfx = modules and modules.Sfx
	if sfx and type(sfx.Play) == "function" then
		pcall(sfx.Play, role)
	end
end

local function fireHook(name: string, ...: any)
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.Fire) == "function" then
		hooks.Fire(name, ...)
	end
end

-- ---------------------------------------------------------------------
-- GRUNDBAUSTEINE
-- ---------------------------------------------------------------------
function UI.Create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	inst.Parent = parent
	return inst
end

function UI.Corner(radius: number?): UICorner
	return UI.Create("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

-- Dicke Kontur um einen Rahmen/Knopf
function UI.Stroke(color: Color3?, thickness: number?): UIStroke
	return UI.Create("UIStroke", {
		Color = color or BLACK,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

-- Schwarzer Rand um Schrift (gut lesbar auf jedem Hintergrund)
function UI.TextStroke(thickness: number?): UIStroke
	return UI.Create("UIStroke", { Thickness = thickness or 2, Color = BLACK, LineJoinMode = Enum.LineJoinMode.Round })
end

-- Farbverlauf von oben nach unten
function UI.Gradient(top: Color3, bottom: Color3, rotation: number?): UIGradient
	return UI.Create("UIGradient", { Rotation = rotation or 90, Color = ColorSequence.new(top, bottom) })
end

-- Knallige Verlaufsfarbe für einen Knopf: oben heller, unten dunkler
function UI.ButtonSequence(color: Color3): ColorSequence
	return ColorSequence.new(color:Lerp(WHITE, 0.28), color:Lerp(BLACK, 0.18))
end

-- 1.25 -> "1.25", 2 -> "2", 2.5 -> "2.5"
function UI.FormatMult(value: number?): string
	local n = tonumber(value) or 1
	if n ~= n or n <= 0 then
		return "1"
	end
	local text = string.format("%.2f", n)
	text = text:gsub("0+$", "")
	text = text:gsub("%.$", "")
	return text
end

-- Kleine Mengen mit einer Nachkommastelle (2.5 statt 2), große wie gewohnt (3.1M)
function UI.FormatSteps(value: number, formatNumber: (number) -> string): string
	local n = tonumber(value) or 0
	if n ~= n then
		return "0"
	end
	if math.abs(n) < 100 and math.floor(n) ~= n then
		local text = string.format("%.1f", n)
		text = text:gsub("%.0$", "")
		return text
	end
	return formatNumber(n)
end

-- Text in GROSSBUCHSTABEN (Titel, Knopf-Wörter). Auch ä/ö/ü -> Ä/Ö/Ü; Emojis bleiben, wie sie sind.
local UMLAUT_UPPER: { [string]: string } = { ["ä"] = "Ä", ["ö"] = "Ö", ["ü"] = "Ü" }
function UI.Upper(text: string): string
	local upper = string.gsub(string.upper(text), "\195[\164\182\188]", UMLAUT_UPPER)
	return upper
end

function UI.Label(props: { [string]: any }): TextLabel
	local base: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = WHITE,
		TextScaled = true,
		Text = "",
	}
	for key, value in pairs(props) do
		if key ~= "MaxText" and key ~= "Outline" then
			base[key] = value
		end
	end
	if GOTHAM_FONTS[base.Font] then
		base.Font = UI.Font
	end
	local children: { Instance } = { UI.Create("UITextSizeConstraint", { MaxTextSize = props.MaxText or 28 }) }
	if props.Outline then
		table.insert(children, UI.TextStroke(props.Outline))
	end
	return UI.Create("TextLabel", base, children)
end

function UI.TextBox(props: { [string]: any }): TextBox
	local base: { [string]: any } = {
		BackgroundColor3 = UI.Theme.PanelDark,
		Font = UI.Font,
		TextColor3 = WHITE,
		PlaceholderColor3 = Color3.fromRGB(165, 205, 255), -- blasser als echter Text
		TextScaled = true,
		ClearTextOnFocus = false,
		Text = "",
	}
	for key, value in pairs(props) do
		base[key] = value
	end
	if GOTHAM_FONTS[base.Font] then
		base.Font = UI.Font
	end
	return UI.Create("TextBox", base, {
		UI.Corner(8),
		UI.Stroke(BLACK, 2),
		UI.Create("UITextSizeConstraint", { MaxTextSize = 18 }),
		UI.Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
	})
end

-- ---------------------------------------------------------------------
-- KNÖPFE (Halter-Rahmen für das Layout + federnder Knopf in der Mitte)
-- Aufbau: Halter (unsichtbar) -> "Lip" (dunklere 3D-Kante, schaut unten ein paar Pixel raus)
--         + "Button" (die Knopf-Fläche mit Verlauf, Kontur, Glanz und Text)
-- props: Name, Size, Position, AnchorPoint, LayoutOrder, Parent, Visible, ZIndex,
--        Text, Sub (kleine zweite Zeile), Color, MaxText, SubMax, Corner, StrokeSize, Wrap, Silent (kein Klick-Ton)
-- ---------------------------------------------------------------------
export type Button = {
	Frame: Frame,
	Button: TextButton,
	Label: TextLabel,
	Sub: TextLabel?,
	Stroke: UIStroke,
	SetText: (text: string) -> (),
	SetSub: (text: string) -> (),
	SetColor: (color: Color3) -> (),
}

function UI.Button(props: { [string]: any }, onClick: (() -> ())?): Button
	local cornerRadius: number = props.Corner or 12
	local strokeSize: number = props.StrokeSize or 3
	local z: number = props.ZIndex or 1
	local silent = props.Silent == true
	local holder: Frame = UI.Create("Frame", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(120, 40),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = props.Parent,
	})
	local currentColor: Color3 = props.Color or UI.Theme.Orange

	-- 3D-Kante: dunklere Kopie der unteren Knopfhälfte, liegt hinter der Fläche und schaut unten raus
	-- (nur die untere Hälfte, damit sie beim Stauchen oben nicht hervorblitzt)
	local lip: Frame = UI.Create("Frame", {
		Name = "Lip",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(1, 0.62),
		BackgroundColor3 = currentColor:Lerp(BLACK, LIP_DARKEN),
		ZIndex = z - 1,
		Parent = holder,
	}, { UI.Corner(cornerRadius), UI.Stroke(BLACK, strokeSize) })

	local gradient: UIGradient = UI.Create("UIGradient", {
		Rotation = 90,
		Color = UI.ButtonSequence(currentColor),
	})
	local scale: UIScale = UI.Create("UIScale")
	local outline = UI.Stroke(BLACK, strokeSize)
	local btn: TextButton = UI.Create("TextButton", {
		Name = "Button",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = BUTTON_UP,
		Size = BUTTON_NORMAL,
		BackgroundColor3 = WHITE,
		AutoButtonColor = false,
		Text = "",
		ZIndex = z,
		Parent = holder,
	}, { UI.Corner(cornerRadius), gradient, outline, scale })

	-- Glanz-Streifen oben (macht den "Bonbon"-Look der Roblox-Knöpfe; wird beim Drüberfahren heller)
	local shine: Frame = UI.Create("Frame", {
		Name = "Shine",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 3),
		Size = UDim2.new(1, -8, 0.4, -2),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = SHINE_NORMAL,
		ZIndex = z,
		Parent = btn,
	}, { UI.Corner(math.max(2, cornerRadius - 3)) })

	local hasSub = props.Sub ~= nil
	local main = UI.Label({
		Name = "Label",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, hasSub and 0.06 or 0.12, 0),
		Size = UDim2.new(1, -12, hasSub and 0.58 or 0.76, 0),
		Text = props.Text or "",
		TextWrapped = props.Wrap == true,
		MaxText = props.MaxText or 24,
		Outline = 2,
		ZIndex = z + 1,
		Parent = btn,
	})
	local sub: TextLabel? = nil
	if hasSub then
		sub = UI.Label({
			Name = "Sub",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0.62, 0),
			Size = UDim2.new(1, -12, 0.32, 0),
			Text = props.Sub,
			MaxText = props.SubMax or 16,
			Outline = 2,
			ZIndex = z + 1,
			Parent = btn,
		})
	end

	-- Feder-Effekt: Maus drüber = etwas größer + hellerer Glanz, drücken = kleiner + gestaucht
	-- (breit/flach), sinkt auf die Lippe und wird etwas dunkler, loslassen = federt elastisch zurück
	local hovering = false
	local pressed = false
	local shineTarget = SHINE_NORMAL
	local function spring(target: number, info: TweenInfo)
		TweenService:Create(scale, info, { Scale = target }):Play()
	end
	local function setShine(transparency: number)
		if shineTarget ~= transparency then
			shineTarget = transparency
			TweenService:Create(shine, GLOW_INFO, { BackgroundTransparency = transparency }):Play()
		end
	end
	local function setPressed(on: boolean)
		if pressed ~= on then
			pressed = on
			TweenService:Create(btn, GLOW_INFO, { BackgroundColor3 = if on then BUTTON_PRESSED_TINT else WHITE }):Play()
		end
	end
	btn.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement then
			hovering = true
			spring(1.06, HOVER_INFO)
			setShine(SHINE_HOVER)
			local now = os.clock()
			if not silent and now - lastHoverSound >= HOVER_SOUND_GAP then
				lastHoverSound = now
				playUiSound("UIHover")
			end
		elseif kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			spring(0.93, PRESS_INFO)
			TweenService:Create(btn, PRESS_INFO, { Size = BUTTON_SQUASH, Position = BUTTON_DOWN }):Play()
			setPressed(true)
		end
	end)
	btn.InputEnded:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			TweenService:Create(btn, SQUASH_RELEASE_INFO, { Size = BUTTON_NORMAL, Position = BUTTON_UP }):Play()
			setPressed(false)
		end
		if kind == Enum.UserInputType.MouseButton1 then
			spring(if hovering then 1.06 else 1, RELEASE_INFO)
		elseif kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch then
			-- Maus raus bzw. Finger weg: zurück auf normale Größe
			hovering = false
			spring(1, RELEASE_INFO)
			setShine(SHINE_NORMAL)
			setPressed(false)
		end
	end)

	-- Klick: Fehler im Callback brechen die Oberfläche nicht, Doppelklicks werden ignoriert
	local busy = false
	btn.Activated:Connect(function()
		if busy or not onClick then
			return
		end
		busy = true
		if not silent then
			playUiSound("UIClick")
		end
		local callback = onClick :: () -> ()
		task.spawn(function()
			local ok, err = pcall(callback)
			if not ok then
				warn("[UI] " .. tostring(err))
			end
			busy = false
		end)
	end)

	local result: Button = {
		Frame = holder,
		Button = btn,
		Label = main,
		Sub = sub,
		Stroke = outline,
		SetText = function(text: string)
			if main.Text ~= text then
				main.Text = text
			end
		end,
		SetSub = function(text: string)
			if sub and sub.Text ~= text then
				sub.Text = text
			end
		end,
		SetColor = function(color: Color3)
			if color ~= currentColor then
				currentColor = color
				gradient.Color = UI.ButtonSequence(color)
				lip.BackgroundColor3 = color:Lerp(BLACK, LIP_DARKEN)
			end
		end,
	}
	return result
end

-- Roter Kreis mit "!" oben rechts an einem Knopf (z.B. Belohnung bereit)
-- (rechts verankert: längere Texte wie "4:59" wachsen als Pille nach links, nicht aus dem Bild)
function UI.Badge(target: Button, text: string?): Frame
	local badge: Frame = UI.Create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 8, 0, 6),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = UI.Theme.Red,
		Visible = false,
		ZIndex = target.Button.ZIndex + 2,
		Parent = target.Button,
	}, { UI.Corner(14), UI.Stroke(BLACK, 2), UI.Create("UIScale", { Name = "Pulse" }) })
	UI.Label({
		Name = "Text",
		Position = UDim2.fromOffset(3, 2),
		Size = UDim2.new(1, -6, 1, -4),
		Text = text or "!",
		MaxText = 20,
		Outline = 2,
		ZIndex = target.Button.ZIndex + 3,
		Parent = badge,
	})
	return badge
end

local BADGE_PULSE_INFO = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local badgePulses: { [Frame]: Tween } = {}

-- Badge setzen: text nil/"" = ausblenden. pulse = sanft pulsieren (z.B. "abholbereit").
-- Schreibt nur bei Änderungen (wird jede Sekunde aufgerufen).
function UI.SetBadge(badge: Frame, text: string?, color: Color3?, pulse: boolean?)
	local show = text ~= nil and text ~= ""
	if badge.Visible ~= show then
		badge.Visible = show
	end
	local label = badge:FindFirstChild("Text")
	if show and label and label:IsA("TextLabel") and label.Text ~= text then
		local value = text :: string
		label.Text = value
		local chars = utf8.len(value) or #value
		local width = if chars <= 1 then 28 else math.min(76, 12 + chars * 10)
		badge.Size = UDim2.fromOffset(width, 28)
	end
	local wanted = color or UI.Theme.Red
	if badge.BackgroundColor3 ~= wanted then
		badge.BackgroundColor3 = wanted
	end
	local scale = badge:FindFirstChild("Pulse")
	if not scale or not scale:IsA("UIScale") then
		return
	end
	local tween = badgePulses[badge]
	local wantPulse = show and pulse == true
	if wantPulse and not tween then
		scale.Scale = 1
		local newTween = TweenService:Create(scale, BADGE_PULSE_INFO, { Scale = 1.22 })
		badgePulses[badge] = newTween
		newTween:Play()
	elseif not wantPulse and tween then
		tween:Cancel()
		badgePulses[badge] = nil
		scale.Scale = 1
	end
end

-- ---------------------------------------------------------------------
-- LAYOUT-HELFER (für Fenster-Inhalte)
-- ---------------------------------------------------------------------
function UI.Section(parent: Instance, text: string, order: number, color: Color3?): TextLabel
	return UI.Label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color or UI.Theme.Yellow,
		LayoutOrder = order,
		MaxText = 24,
		Outline = 2.5,
		Parent = parent,
	})
end

function UI.Row(parent: Instance, order: number, height: number?): Frame
	return UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, height or 40),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})
end

function UI.Grid(parent: Instance, order: number, cellX: number, cellY: number): Frame
	return UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.Create("UIGridLayout", {
			CellSize = UDim2.fromOffset(cellX, cellY),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		UI.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 3),
			PaddingTop = UDim.new(0, 3),
			PaddingBottom = UDim.new(0, 3),
		}),
	})
end

-- Karte mit hellerem Hintergrund und schwarzer Kontur
function UI.Card(props: { [string]: any }): Frame
	local base: { [string]: any } = { BackgroundColor3 = UI.Theme.PanelLight }
	for key, value in pairs(props) do
		base[key] = value
	end
	return UI.Create("Frame", base, { UI.Corner(12), UI.Stroke(BLACK, 2) })
end

-- ---------------------------------------------------------------------
-- FORTSCHRITTSBALKEN (Füllung gleitet weich)
-- ---------------------------------------------------------------------
export type Bar = { Frame: Frame, Fill: Frame, Text: TextLabel, Ratio: number }

function UI.Bar(props: { [string]: any }): Bar
	local color: Color3 = props.Color or UI.Theme.Orange
	local back: Frame = UI.Create("Frame", {
		Size = props.Size or UDim2.new(1, 0, 0, 30),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = UI.Theme.PanelDark:Lerp(BLACK, 0.4), -- dunkle Rinne: die bunte Füllung leuchtet darauf
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	}, { UI.Corner(10), UI.Stroke(BLACK, 3) })
	local fill: Frame = UI.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		Parent = back,
	}, { UI.Corner(10), UI.Create("UIGradient", { Rotation = 90, Color = UI.ButtonSequence(color) }) })
	local text = UI.Label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		MaxText = props.MaxText or 18,
		Outline = 2,
		ZIndex = 2,
		Parent = back,
	})
	return { Frame = back, Fill = fill, Text = text, Ratio = 0 }
end

function UI.SetBar(bar: Bar, ratio: number, text: string?)
	if ratio ~= ratio then
		ratio = 0
	end
	ratio = math.clamp(ratio, 0, 1)
	if text and bar.Text.Text ~= text then
		bar.Text.Text = text
	end
	if math.abs(ratio - bar.Ratio) > 0.001 then
		bar.Ratio = ratio
		TweenService:Create(bar.Fill, BAR_INFO, { Size = UDim2.fromScale(ratio, 1) }):Play()
	end
end

-- Kurzes "Aufploppen" (z.B. wenn Coins reinkommen)
function UI.Pulse(scale: UIScale, amount: number?)
	scale.Scale = 1 + (amount or 0.12)
	TweenService:Create(scale, PULSE_INFO, { Scale = 1 }):Play()
end

-- ---------------------------------------------------------------------
-- FLÜSSIG ZÄHLENDE ZAHLEN (Coins, Gems, Schlüssel)
-- ---------------------------------------------------------------------
export type Counter = {
	Label: TextLabel,
	Format: (number) -> string,
	Target: number,
	Shown: number,
	Text: string,
	Scale: UIScale?, -- UIScale am Label (falls vorhanden): ploppt bei Zuwachs kurz auf
	Color: Color3, -- eigentliche Schriftfarbe (Farbblitz kehrt dahin zurück)
	PopAt: number,
}

local counters: { Counter } = {}
local counterClock = 0
local COUNTER_UP_COLOR = Color3.fromRGB(255, 255, 255)
local COUNTER_DOWN_COLOR = Color3.fromRGB(255, 110, 110)

function UI.Counter(target: TextLabel, format: (number) -> string): Counter
	local counter: Counter = {
		Label = target,
		Format = format,
		Target = 0,
		Shown = 0,
		Text = format(0),
		Scale = target:FindFirstChildOfClass("UIScale"),
		Color = target.TextColor3,
		PopAt = 0,
	}
	target.Text = counter.Text
	table.insert(counters, counter)
	return counter
end

-- Kurzer Farbblitz (weiß bei Zuwachs, rot bei Abnahme) + Aufploppen bei Zuwachs
local function popCounter(counter: Counter, up: boolean)
	local now = os.clock()
	if now - counter.PopAt < COUNTER_POP_GAP then
		return
	end
	counter.PopAt = now
	local label = counter.Label
	label.TextColor3 = counter.Color
	TweenService:Create(label, COUNTER_FLASH_INFO, { TextColor3 = if up then COUNTER_UP_COLOR else COUNTER_DOWN_COLOR })
		:Play()
	local scale = counter.Scale
	if up and scale then
		UI.Pulse(scale, 0.1)
	end
end

-- instant = true: sofort anzeigen (z.B. beim ersten Laden)
function UI.SetCounter(counter: Counter, value: number, instant: boolean?)
	if type(value) ~= "number" or value ~= value then
		return
	end
	if not instant and value ~= counter.Target then
		popCounter(counter, value > counter.Target)
	end
	counter.Target = value
	if instant then
		counter.Shown = value
		UI.RedrawCounter(counter)
	end
end

-- Schreibt den Text sofort neu (z.B. wenn sich das Format geändert hat)
function UI.RedrawCounter(counter: Counter)
	local text = counter.Format(counter.Shown)
	counter.Text = text
	counter.Label.Text = text
end

local function stepCounters(dt: number)
	counterClock += dt
	if counterClock < COUNTER_INTERVAL then
		return
	end
	local alpha = 1 - math.exp(-counterClock * 7)
	counterClock = 0
	for _, counter in ipairs(counters) do
		local target = counter.Target
		if counter.Shown ~= target then
			local diff = target - counter.Shown
			if math.abs(diff) <= math.max(0.5, math.abs(target) * 0.0002) then
				counter.Shown = target
			else
				counter.Shown += diff * alpha
			end
			local text = counter.Format(counter.Shown)
			if text ~= counter.Text then
				counter.Text = text
				counter.Label.Text = text
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- FENSTER (immer nur eins offen; öffnen = Ploppen + Einblenden)
-- Der Inhalt steckt nur WÄHREND des Auf-/Zugehens in einer CanvasGroup (für das weiche Einblenden).
-- Danach hängt er in einem normalen Frame: Eine CanvasGroup malt bei jeder kleinen Änderung
-- (Text, Balken, Scrollen) ihren ganzen Inhalt neu und macht Schrift auf Handys unscharf.
-- ---------------------------------------------------------------------
export type Window = {
	Group: Frame, -- Halter (Position, Größe, sichtbar ja/nein)
	Fader: CanvasGroup, -- nur während der Animation benutzt
	Panel: Frame, -- der eigentliche Fensterinhalt
	Scale: UIScale,
	Content: ScrollingFrame,
	IsOpen: boolean,
	Token: number,
	OnOpen: (() -> ())?,
	Title: string,
}

-- Registrierte Fenster (C7.3): Name -> öffnen/schließen. Ein UI.Window, das während open() aufgeht,
-- wird automatisch mit dem Namen verknüpft (dann meldet auch das rote X das Schließen richtig).
type WindowEntry = {
	Name: string,
	OpenFn: () -> (),
	CloseFn: (() -> ())?,
	Win: Window?,
	Flag: boolean, -- offen (für Fenster ohne verknüpftes UI.Window)
	Announced: boolean, -- "WindowOpened" schon gefeuert
}

local windows: { Window } = {}
local registry: { [string]: WindowEntry } = {}
local entryOfWin: { [Window]: WindowEntry } = {}
local openingName: string? = nil
local warnedUnknown: { [string]: boolean } = {}
local blur: BlurEffect? = nil
local modalButton: TextButton? = nil

local function entryIsOpen(entry: WindowEntry): boolean
	local win = entry.Win
	if win then
		return win.IsOpen
	end
	return entry.Flag
end

-- true, sobald irgendein Fenster offen ist (UI.Window oder registriertes Fremd-Fenster)
function UI.IsAnyWindowOpen(): boolean
	for _, win in ipairs(windows) do
		if win.IsOpen then
			return true
		end
	end
	for _, entry in pairs(registry) do
		if entryIsOpen(entry) then
			return true
		end
	end
	return false
end

-- Welt hinter offenen Fenstern weichzeichnen (lokaler BlurEffect, nach dem Schließen wieder weg)
-- + Modal-Knopf: solange ein Fenster offen ist, gibt er die Maus in der Ego-Sicht frei
local function updateWindowState()
	local open = UI.IsAnyWindowOpen()
	local modal = modalButton
	if modal and modal.Visible ~= open then
		modal.Visible = open
	end
	if open then
		UserInputService.MouseIconEnabled = true
		local effect = blur
		if not effect or effect.Parent == nil then
			effect = UI.Create("BlurEffect", { Name = "ClutchClashWindowBlur", Size = 0, Parent = Lighting })
			blur = effect
		end
		if effect then
			TweenService:Create(effect, BLUR_IN_INFO, { Size = BLUR_SIZE }):Play()
		end
	else
		local effect = blur
		if not effect then
			return
		end
		local fade = TweenService:Create(effect, BLUR_OUT_INFO, { Size = 0 })
		fade.Completed:Once(function()
			-- inzwischen wieder ein Fenster offen? Dann bleibt er
			if blur == effect and not UI.IsAnyWindowOpen() then
				blur = nil
				effect:Destroy()
			end
		end)
		fade:Play()
	end
end

-- Zustand eines registrierten Fensters setzen und die Hooks genau einmal pro Wechsel feuern
local function announceEntry(entry: WindowEntry)
	local open = entryIsOpen(entry)
	if open and not entry.Announced then
		entry.Announced = true
		fireHook("WindowOpened", entry.Name)
	elseif not open and entry.Announced then
		entry.Announced = false
		fireHook("WindowClosed", entry.Name)
	end
end

-- Inhalt für die Animation in die CanvasGroup hängen
local function beginFade(win: Window)
	if win.Panel.Parent ~= win.Fader then
		win.Panel.Parent = win.Fader
	end
	win.Fader.Visible = true
end

-- Animation fertig: Inhalt zurück in den normalen Frame, CanvasGroup aus
local function endFade(win: Window)
	win.Panel.Parent = win.Group
	win.Fader.Visible = false
end

function UI.CloseWindow(win: Window)
	if not win.IsOpen then
		return
	end
	win.IsOpen = false
	win.Token += 1
	local token = win.Token
	beginFade(win)
	TweenService:Create(win.Scale, CLOSE_INFO, { Scale = 0.86 }):Play()
	TweenService:Create(win.Group, CLOSE_INFO, { Position = UDim2.new(0.5, 0, 0.5, WINDOW_SLIDE * 0.6) }):Play()
	local fade = TweenService:Create(win.Fader, CLOSE_INFO, { GroupTransparency = 1 })
	fade.Completed:Connect(function()
		if win.Token == token then
			win.Group.Visible = false
			endFade(win)
		end
	end)
	fade:Play()
	local entry = entryOfWin[win]
	if entry then
		announceEntry(entry)
	else
		fireHook("WindowClosed", win.Title)
	end
	updateWindowState()
end

-- Registrierte Fremd-Fenster (ohne UI.Window) schließen, wenn ein anderes Fenster aufgeht
local function closeOtherEntries(except: WindowEntry?)
	for _, entry in pairs(registry) do
		if entry ~= except and entry.Win == nil and entry.Flag then
			entry.Flag = false
			local closeFn = entry.CloseFn
			if closeFn then
				local ok, err = pcall(closeFn)
				if not ok then
					warn("[UI] Fenster " .. entry.Name .. " schließen: " .. tostring(err))
				end
			end
			announceEntry(entry)
		end
	end
end

function UI.OpenWindow(win: Window)
	-- Wird das Fenster gerade über Windows.Open(name) geöffnet? Dann mit dem Namen verknüpfen.
	local pending = openingName
	if pending and not entryOfWin[win] then
		local entry = registry[pending]
		if entry and entry.Win == nil then
			entry.Win = win
			entry.Flag = false
			entryOfWin[win] = entry
		end
	end
	for _, other in ipairs(windows) do
		if other ~= win then
			UI.CloseWindow(other)
		end
	end
	closeOtherEntries(entryOfWin[win])
	if win.IsOpen then
		return
	end
	win.IsOpen = true
	win.Token += 1
	local token = win.Token
	beginFade(win)
	if not win.Group.Visible then
		win.Fader.GroupTransparency = 1
		win.Scale.Scale = 0.7
		win.Group.Position = UDim2.new(0.5, 0, 0.5, WINDOW_SLIDE)
		win.Group.Visible = true
	end
	local fade = TweenService:Create(win.Fader, OPEN_FADE_INFO, { GroupTransparency = 0 })
	fade.Completed:Connect(function()
		if win.Token == token and win.IsOpen then
			endFade(win)
		end
	end)
	fade:Play()
	-- federnd aufgehen (Back-Easing schießt etwas über 1 hinaus) und von unten hereingleiten
	TweenService:Create(win.Scale, OPEN_POP_INFO, { Scale = 1 }):Play()
	TweenService:Create(win.Group, OPEN_POP_INFO, { Position = UDim2.fromScale(0.5, 0.5) }):Play()
	local entry = entryOfWin[win]
	if entry then
		announceEntry(entry)
	else
		fireHook("WindowOpened", win.Title)
	end
	updateWindowState()
	if win.OnOpen then
		task.spawn(win.OnOpen)
	end
end

function UI.ToggleWindow(win: Window)
	if win.IsOpen then
		UI.CloseWindow(win)
	else
		UI.OpenWindow(win)
	end
end

function UI.CloseAll()
	for _, win in ipairs(windows) do
		UI.CloseWindow(win)
	end
	closeOtherEntries(nil)
	updateWindowState()
end

function UI.Window(title: string, width: number, height: number, color: Color3?): Window
	assert(root, "UI.Init zuerst aufrufen")
	local accent = color or UI.Theme.Orange
	local group: Frame = UI.Create("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 10,
		Parent = root,
	})
	local scale: UIScale = UI.Create("UIScale", { Scale = 0.86, Parent = group })
	local fader: CanvasGroup = UI.Create("CanvasGroup", {
		Name = "Fader",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		Parent = group,
	})
	-- helle, kräftig blaue Fläche mit dicker schwarzer Kontur (Rand = Konturdicke, damit die
	-- Kontur beim Ein-/Ausblenden in der CanvasGroup nicht abgeschnitten wird)
	local panel = UI.Create("Frame", {
		Name = "Panel",
		Position = UDim2.fromOffset(WINDOW_STROKE, WINDOW_STROKE),
		Size = UDim2.new(1, -WINDOW_STROKE * 2, 1, -WINDOW_STROKE * 2),
		BackgroundColor3 = WHITE,
		Parent = group,
	}, {
		UI.Corner(20),
		UI.Stroke(BLACK, WINDOW_STROKE),
		UI.Gradient(UI.Theme.Panel:Lerp(WHITE, 0.12), UI.Theme.PanelDark),
	})
	local header = UI.Create("Frame", {
		Name = "Header",
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(1, -20, 0, 50),
		BackgroundColor3 = WHITE,
		Parent = panel,
	}, {
		UI.Corner(14),
		UI.Stroke(BLACK, 3),
		UI.Create("UIGradient", { Rotation = 90, Color = UI.ButtonSequence(accent) }),
	})
	-- Titel in GROSSBUCHSTABEN mit dicker Kontur
	UI.Label({
		Name = "Title",
		Position = UDim2.fromOffset(14, 4),
		Size = UDim2.new(1, -78, 1, -8),
		Text = UI.Upper(title),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 34,
		Outline = 4,
		Parent = header,
	})
	local content: ScrollingFrame = UI.Create("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(12, 70),
		Size = UDim2.new(1, -24, 1, -82),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
		UI.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 3),
			PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 3),
			PaddingBottom = UDim.new(0, 10),
		}),
	})
	local win: Window = {
		Group = group,
		Fader = fader,
		Panel = panel,
		Scale = scale,
		Content = content,
		IsOpen = false,
		Token = 0,
		OnOpen = nil,
		Title = title,
	}
	-- Schließen: rotes Quadrat mit weißem X
	UI.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -5, 0.5, 0),
		Size = UDim2.fromOffset(42, 42),
		Text = "X",
		Color = UI.Theme.Red,
		MaxText = 28,
		Corner = 8,
		Parent = header,
	}, function()
		UI.CloseWindow(win)
	end)
	table.insert(windows, win)
	return win
end

-- ---------------------------------------------------------------------
-- WINDOWS-REGISTRY (C7.3) = ctx.Windows
-- Namen: "Play" (WP5), "Shop", "Locker" (WP9), "Quests", "Pass", "Daily" (WP8), "Settings" (WP10),
-- "Training" (WP6), "Admin" (WP7). Immer nur ein Fenster offen.
-- ---------------------------------------------------------------------
local Windows = {}
UI.Windows = Windows

function Windows.Register(name: string, open: () -> (), close: (() -> ())?)
	if type(name) ~= "string" or type(open) ~= "function" then
		warn("[UI] Windows.Register: Name (string) und open-Funktion erwartet")
		return
	end
	local old = registry[name]
	if old and old.Win then
		entryOfWin[old.Win] = nil
	end
	registry[name] = { Name = name, OpenFn = open, CloseFn = close, Win = nil, Flag = false, Announced = false }
end

function Windows.IsOpen(name: string?): boolean
	if name == nil then
		return UI.IsAnyWindowOpen()
	end
	local entry = registry[name]
	return entry ~= nil and entryIsOpen(entry)
end

function Windows.Close(name: string?)
	if name == nil then
		for _, entry in pairs(registry) do
			Windows.Close(entry.Name)
		end
		UI.CloseAll()
		return
	end
	local entry = registry[name]
	if not entry or not entryIsOpen(entry) then
		return
	end
	local closeFn = entry.CloseFn
	if closeFn then
		local ok, err = pcall(closeFn)
		if not ok then
			warn("[UI] Fenster " .. name .. " schließen: " .. tostring(err))
		end
	end
	local win = entry.Win
	if win and win.IsOpen then
		UI.CloseWindow(win)
	end
	entry.Flag = false
	announceEntry(entry)
	updateWindowState()
end

function Windows.Open(name: string)
	local entry = registry[name]
	if not entry then
		if not warnedUnknown[name] then
			warnedUnknown[name] = true
			warn("[UI] Fenster nicht registriert: " .. tostring(name))
		end
		return
	end
	-- andere registrierte Fenster zu (nur eins gleichzeitig)
	for _, other in pairs(registry) do
		if other ~= entry and entryIsOpen(other) then
			Windows.Close(other.Name)
		end
	end
	openingName = name
	local ok, err = pcall(entry.OpenFn)
	openingName = nil
	if not ok then
		warn("[UI] Fenster " .. name .. " öffnen: " .. tostring(err))
		return
	end
	if entry.Win == nil then
		entry.Flag = true -- Fremd-Fenster ohne UI.Window: offen, bis Windows.Close(name) kommt
	end
	announceEntry(entry)
	updateWindowState()
end

function Windows.Toggle(name: string)
	if Windows.IsOpen(name) then
		Windows.Close(name)
	else
		Windows.Open(name)
	end
end

-- ---------------------------------------------------------------------
-- TOASTS ohne Kasten: großer farbiger Text mit dicker schwarzer Kontur,
-- oben in der Mitte gestapelt (neueste unten), ploppt auf, steigt beim Gehen hoch und verblasst.
-- Normale Frames (keine CanvasGroup) + ein kleiner Vorrat, der wiederverwendet wird.
-- ---------------------------------------------------------------------
type ToastEntry = {
	Container: Frame, -- Platzhalter in der Liste (wächst/schrumpft -> andere rutschen weich nach)
	Inner: Frame, -- trägt den Text; bewegt sich + ploppt (UIScale), ohne die Liste zu verschieben
	Scale: UIScale,
	Label: TextLabel,
	LabelStroke: UIStroke,
	Height: number,
	Leaving: boolean,
	Token: number,
	Kind: string,
}

-- Textfarbe je Art
local TOAST_COLORS: { [string]: Color3 } = {
	Info = WHITE,
	Success = Color3.fromRGB(90, 255, 90),
	Error = Color3.fromRGB(255, 80, 80),
	Event = Color3.fromRGB(255, 205, 45),
	Alarm = Color3.fromRGB(255, 45, 45),
	Announce = Color3.fromRGB(110, 210, 255),
}

-- Schriftgröße je Art (wichtige Meldungen größer)
local TOAST_TEXT_SIZE: { [string]: number } = {
	Info = 24,
	Success = 26,
	Error = 26,
	Event = 26,
	Announce = 28,
	Alarm = 32,
}

-- Zu viele Toasts: zuerst fliegt der älteste mit der KLEINSTEN Wichtigkeit raus.
local TOAST_PRIORITY: { [string]: number } = {
	Info = 1,
	Event = 1,
	Success = 2,
	Error = 2,
	Announce = 2,
	Alarm = 3,
}

local toastHolder: Frame? = nil
local TOAST_TOP = 56 -- Meldungen stehen so weit unter dem oberen Rand
local toastCount = 0
local activeToasts: { ToastEntry } = {}
local toastPool: { ToastEntry } = {}

-- Position des Texts im Platzhalter (Mitte, damit das Aufploppen aus der Mitte kommt)
local function toastPosition(height: number, offsetY: number): UDim2
	return UDim2.new(0.5, 0, 0, height / 2 + offsetY)
end

local function newToastEntry(): ToastEntry
	local container: Frame = UI.Create("Frame", {
		Name = "Toast",
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
	})
	local toastScale: UIScale = UI.Create("UIScale", { Scale = 1 })
	local inner: Frame = UI.Create("Frame", {
		Name = "Inner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(1, 0, 0, TOAST_MIN_HEIGHT),
		BackgroundTransparency = 1,
		Parent = container,
	}, { toastScale })
	local stroke: UIStroke = UI.Create("UIStroke", {
		Color = BLACK,
		Thickness = 3,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
	local label: TextLabel = UI.Create("TextLabel", {
		Name = "Text",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, TOAST_TEXT_WIDTH, 1, 0),
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = WHITE,
		TextSize = 24,
		TextWrapped = true,
		Text = "",
		Parent = inner,
	}, { stroke })
	return {
		Container = container,
		Inner = inner,
		Scale = toastScale,
		Label = label,
		LabelStroke = stroke,
		Height = TOAST_MIN_HEIGHT,
		Leaving = false,
		Token = 0,
		Kind = "Info",
	}
end

-- Welcher Toast soll weichen? Der älteste mit der kleinsten Wichtigkeit.
local function toastToDrop(): ToastEntry
	local drop = activeToasts[1]
	local lowest = math.huge
	for _, entry in ipairs(activeToasts) do
		local priority = TOAST_PRIORITY[entry.Kind] or 1
		if priority < lowest then
			drop, lowest = entry, priority
		end
	end
	return drop
end

-- Ein-/Ausblenden über die Transparenz von Text + Kontur. Gibt den Tween des Texts zurück.
local function fadeToast(entry: ToastEntry, info: TweenInfo, transparency: number): Tween
	local textTween = TweenService:Create(entry.Label, info, { TextTransparency = transparency })
	TweenService:Create(entry.LabelStroke, info, { Transparency = transparency }):Play()
	textTween:Play()
	return textTween
end

local function setToastTransparency(entry: ToastEntry, transparency: number)
	entry.Label.TextTransparency = transparency
	entry.LabelStroke.Transparency = transparency
end

local function removeToast(entry: ToastEntry)
	if entry.Leaving then
		return
	end
	entry.Leaving = true
	local token = entry.Token
	local index = table.find(activeToasts, entry)
	if index then
		table.remove(activeToasts, index)
	end
	-- steigt etwas hoch und verblasst, danach rutschen die anderen nach
	TweenService:Create(entry.Inner, TOAST_OUT_INFO, { Position = toastPosition(entry.Height, -TOAST_RISE * 2) }):Play()
	local fade = fadeToast(entry, TOAST_OUT_INFO, 1)
	fade.Completed:Connect(function()
		if entry.Token ~= token then
			return
		end
		local shrink = TweenService:Create(entry.Container, TOAST_GROW_INFO, { Size = UDim2.new(1, 0, 0, 0) })
		shrink.Completed:Connect(function()
			if entry.Token ~= token then
				return
			end
			-- fertig -> aufheben und später wiederverwenden
			entry.Container.Parent = nil
			if #toastPool < MAX_TOAST_POOL then
				table.insert(toastPool, entry)
			else
				entry.Container:Destroy()
			end
		end)
		shrink:Play()
	end)
end

-- Meldungen tiefer setzen, solange oben etwas anderes steht (z.B. Runden-Timer im Match).
-- nil = wieder an die normale Stelle.
function UI.SetToastTop(offset: number?)
	local holder = toastHolder
	if holder then
		holder.Position = UDim2.new(0.5, 0, 0, offset or TOAST_TOP)
	end
end

function UI.Toast(text: string, kind: string?)
	local holder = toastHolder
	if not holder or type(text) ~= "string" or text == "" then
		return
	end
	toastCount += 1
	local key = if kind and TOAST_COLORS[kind] then kind else "Info"
	local entry = table.remove(toastPool) or newToastEntry()
	entry.Token += 1
	entry.Leaving = false
	entry.Kind = key
	local token = entry.Token
	-- Höhe passend zum Text (lange Meldungen brechen um, statt winzig zu werden)
	local textSize = TOAST_TEXT_SIZE[key] or 24
	local bounds = TextService:GetTextSize(text, textSize, UI.Font, Vector2.new(TOAST_TEXT_WIDTH, 1000))
	local height = math.max(TOAST_MIN_HEIGHT, math.ceil(bounds.Y) + 10)
	entry.Height = height
	entry.Label.Text = text
	entry.Label.TextSize = textSize
	entry.Label.TextColor3 = TOAST_COLORS[key]
	entry.LabelStroke.Thickness = if key == "Alarm" then 4 else 3
	entry.Inner.Size = UDim2.new(1, 0, 0, height)
	entry.Inner.Position = toastPosition(height, TOAST_RISE)
	entry.Container.Size = UDim2.new(1, 0, 0, 0)
	entry.Container.LayoutOrder = toastCount
	entry.Scale.Scale = 0.5
	setToastTransparency(entry, 1)
	entry.Container.Parent = holder
	table.insert(activeToasts, entry)
	TweenService:Create(entry.Container, TOAST_GROW_INFO, { Size = UDim2.new(1, 0, 0, height + TOAST_GAP) }):Play()
	-- ploppt auf (schießt etwas über die volle Größe hinaus) und rutscht dabei an seinen Platz
	TweenService:Create(entry.Inner, TOAST_RISE_INFO, { Position = toastPosition(height, 0) }):Play()
	TweenService:Create(entry.Scale, TOAST_POP_INFO, { Scale = 1 }):Play()
	fadeToast(entry, TOAST_FADE_INFO, 0)
	while #activeToasts > MAX_TOASTS do
		removeToast(toastToDrop())
	end
	if key == "Error" then
		playUiSound("UIError")
	end
	task.delay((key == "Announce" or key == "Event") and 7 or 4, function()
		if entry.Token == token then
			removeToast(entry)
		end
	end)
end

-- ---------------------------------------------------------------------
-- PREISE (Robux) aus dem Marktplatz – einmal laden, dann merken (Id 0 = nicht eingerichtet -> nil)
-- ---------------------------------------------------------------------
local priceCache: { [number]: number } = {}
local priceWaiting: { [number]: { (number?) -> () } } = {}

function UI.FetchPrice(id: number, infoType: Enum.InfoType, callback: (number?) -> ())
	if type(id) ~= "number" or id == 0 then
		task.spawn(callback, nil)
		return
	end
	local cached = priceCache[id]
	if cached then
		task.spawn(callback, cached)
		return
	end
	local waiting = priceWaiting[id]
	if waiting then
		table.insert(waiting, callback)
		return
	end
	priceWaiting[id] = { callback }
	task.spawn(function()
		local ok, info = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, id, infoType)
		local price = if ok and type(info) == "table" then tonumber(info.PriceInRobux) else nil
		if price then
			priceCache[id] = price
		end
		local list = priceWaiting[id] or {}
		priceWaiting[id] = nil
		for _, cb in ipairs(list) do
			task.spawn(cb, price)
		end
	end)
end

-- ---------------------------------------------------------------------
-- LÄNDER-REGEL "Paid Random Items" (B20.2): Dürfen wir bezahlte Zufallsitems zeigen?
-- Quelle 1: Server-State "RandomAllowed" (gecacht, inkl. Debug/Admin-Simulation).
-- Quelle 2 (nur falls der Server nach 30 s nichts sagt): PolicyService selbst fragen.
-- Im Zweifel/bei Fehler: NICHT zeigen.
-- ---------------------------------------------------------------------
local randomAllowed: boolean? = nil
local randomWaiting: { (boolean) -> () } = {}
local randomStarted = false

local function resolveRandom(allowed: boolean)
	randomAllowed = allowed
	if #randomWaiting == 0 then
		return
	end
	local waiting = randomWaiting
	randomWaiting = {}
	for _, cb in ipairs(waiting) do
		task.spawn(cb, allowed)
	end
end

local function stateRandom(): boolean?
	local state = ctx and ctx.State
	if type(state) == "table" and type(state.RandomAllowed) == "boolean" then
		return state.RandomAllowed
	end
	return nil
end

function UI.WhenRandomItemsKnown(callback: (allowed: boolean) -> ())
	local known = stateRandom()
	if known ~= nil then
		randomAllowed = known
	end
	if randomAllowed ~= nil then
		task.spawn(callback, randomAllowed)
		return
	end
	table.insert(randomWaiting, callback)
	if randomStarted then
		return
	end
	randomStarted = true
	task.delay(RANDOM_STATE_WAIT, function()
		if randomAllowed ~= nil then
			return
		end
		local ok, info = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, Players.LocalPlayer)
		if randomAllowed == nil then
			resolveRandom(ok and type(info) == "table" and info.ArePaidRandomItemsRestricted == false)
		end
	end)
end

-- true/false, oder nil solange die Antwort noch nicht da ist
function UI.RandomItemsAllowed(): boolean?
	local known = stateRandom()
	if known ~= nil then
		return known
	end
	return randomAllowed
end

-- ---------------------------------------------------------------------
-- START
-- ---------------------------------------------------------------------
function UI.Frame(dt: number)
	stepCounters(dt)
end

function UI.Init(ctxOrGui: any)
	local screenGui: ScreenGui? = nil
	if typeof(ctxOrGui) == "Instance" and ctxOrGui:IsA("ScreenGui") then
		screenGui = ctxOrGui
	elseif type(ctxOrGui) == "table" then
		ctx = ctxOrGui
		local gui = ctxOrGui.Gui
		if typeof(gui) == "Instance" and gui:IsA("ScreenGui") then
			screenGui = gui
		end
	end
	assert(screenGui, "UI.Init: ScreenGui oder ctx mit Gui erwartet")
	if root == screenGui then
		return -- schon initialisiert
	end
	root = screenGui
	UI.Root = screenGui

	-- Alles passend zur Bildschirmgröße skalieren (Handy bis großer Monitor)
	local rootScale: UIScale = UI.Create("UIScale", { Name = "RootScale", Parent = screenGui })
	local cameraConnection: RBXScriptConnection? = nil
	local function updateScale()
		local camera = workspace.CurrentCamera
		if camera then
			local size = camera.ViewportSize
			rootScale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 760), 0.55, 1.15)
		end
	end
	local function bindCamera()
		if cameraConnection then
			cameraConnection:Disconnect()
			cameraConnection = nil
		end
		local camera = workspace.CurrentCamera
		if camera then
			cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		end
		updateScale()
	end
	bindCamera()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)

	-- Meldungen oben in der Mitte
	toastHolder = UI.Create("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, TOAST_TOP),
		Size = UDim2.fromOffset(TOAST_WIDTH, 320),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = screenGui,
	}, {
		UI.Create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})

	-- Modal-Knopf: sichtbar, solange ein Fenster offen ist -> Roblox gibt die Maus frei (Ego-Sicht)
	modalButton = UI.Create("TextButton", {
		Name = "WindowModal",
		Size = UDim2.fromOffset(1, 1),
		Position = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		Modal = true,
		Visible = false,
		Parent = screenGui,
	})

	-- Kiosk-Prompts in der Lobby (Attribut "Window") öffnen dasselbe Fenster wie der HUD-Knopf
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if who ~= Players.LocalPlayer then
			return
		end
		local name = prompt:GetAttribute("Window")
		if type(name) == "string" and name ~= "" then
			Windows.Open(name)
		end
	end)

	-- Server-Wert "RandomAllowed" kommt mit dem State -> wartende Rückfragen beantworten
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		hooks.On("State", function()
			local known = stateRandom()
			if known ~= nil then
				resolveRandom(known)
			end
		end)
	end
end

function UI.Start() end

return UI
]]></string>
