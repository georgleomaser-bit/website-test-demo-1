      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Netzwerk: Remote-Liste + Buffer-Codecs (Shared/Net)
--  Besitzer: WP1 (Core & Plattform). Vertrag: DESIGN.md C6.1 + C8.
--
--  Öffentliche API:
--    Net.RemoteList                      alle Remotes { Name, Class } (Server erzeugt sie: Services/Remotes)
--    Net.GetRemotes(): { [string]: Instance }   Client: WaitForChild je Name (10 s), gecacht
--    Net.EncodeLook(pitchDeg, flags, seq): buffer           4 Byte: i8 pitch, u8 flags, u16 seq
--    Net.DecodeLook(b): (pitch?, flags, seq)                pitch = nil bei falscher Größe / pitch außerhalb ±80
--    Net.EncodeLookBatch(seq, entries): buffer              u16 seq, u8 n, n × (u8 slot, i8 pitch, u8 flags)
--    Net.DecodeLookBatch(b): (seq?, entries)                seq = nil bei kaputtem Paket (entries dann leer)
--    Net.EncodeFx(entries, origin): buffer                  u8 n, n × (u8 kind, u8 slot, u8 weapon, i16×3, i16×3)
--    Net.DecodeFx(b, origin): entries?                      Positionen relativ zum Arena-Ursprung ×10
--    Net.LookFlags = { Ads = 1, Sprint = 2, Slide = 4, Reload = 8, Block = 16, Air = 32, Swing = 64 }
--  Alle Zahlen werden vor dem Schreiben geklemmt/gerundet (nie Fehler beim Kodieren, auch bei NaN).
--  Hinweis: Luau kann "(a, b, c)?" nicht ausdrücken -> ein kaputtes Paket erkennt man am ERSTEN
--  Rückgabewert nil:  local pitch, flags, seq = Net.DecodeLook(b); if pitch == nil then return end
-- =====================================================================

local Net = {}

export type RemoteClass = "RemoteEvent" | "RemoteFunction" | "UnreliableRemoteEvent"
export type RemoteSpec = { Name: string, Class: RemoteClass }
export type LookEntry = { Slot: number, Pitch: number, Flags: number }
export type FxEntry = { Kind: number, Slot: number, Weapon: number, O: Vector3, E: Vector3 }

-- ---------------------------------------------------------------------
-- 1) REMOTES (C8) – Reihenfolge egal, Namen sind der Vertrag
-- ---------------------------------------------------------------------
Net.RemoteList = {
	{ Name = "Notify", Class = "RemoteEvent" }, -- S→C (text, kind) – bereits lokalisiert
	{ Name = "State", Class = "RemoteEvent" }, -- S→C (partial, full) – Sticky-Merge
	{ Name = "Effect", Class = "RemoteEvent" }, -- S→C (name, strength, data?)
	{ Name = "Request", Class = "RemoteFunction" }, -- C→S (action, arg?) → Reply (C9)
	{ Name = "Admin", Class = "RemoteFunction" }, -- C→S (action, args?) → {Ok, Message, Data}
	{ Name = "Match", Class = "RemoteEvent" }, -- S→C (kind, data) – nur an Empfänger des Matches
	{ Name = "Combat", Class = "RemoteEvent" }, -- S→C (op, data)
	{ Name = "Fire", Class = "RemoteEvent" }, -- C→S (shotId, weaponId, t, origin, aim, scale, targets)
	{ Name = "WeaponAction", Class = "RemoteEvent" }, -- C→S (action, a..e)
	{ Name = "Look", Class = "UnreliableRemoteEvent" }, -- C→S buffer 4 Byte
	{ Name = "LookBatch", Class = "UnreliableRemoteEvent" }, -- S→C buffer ≤ 51 Byte
	{ Name = "FX", Class = "UnreliableRemoteEvent" }, -- S→C buffer ≤ 871 Byte
	{ Name = "GrantCoins", Class = "RemoteEvent" }, -- Honeypot – unser Code feuert ihn NIE
} :: { RemoteSpec }

Net.LookFlags = { Ads = 1, Sprint = 2, Slide = 4, Reload = 8, Block = 16, Air = 32, Swing = 64 }

-- Grenzen der Pakete
Net.LookSize = 4
Net.MaxPitch = 80
Net.MaxLookBatch = 16 -- 3 + 16 × 3 = 51 Byte
Net.MaxFx = 58 -- 1 + 58 × 15 = 871 Byte
Net.FxScale = 10 -- Positionen ×10 als i16 (±3276 Studs um den Arena-Ursprung)

local REMOTE_WAIT = 10
local cachedRemotes: { [string]: Instance }? = nil

-- Alle Remotes als Tabelle Name -> Instanz. Wartet je Name höchstens 10 s (fehlende -> warn, ausgelassen).
function Net.GetRemotes(): { [string]: Instance }
	if cachedRemotes then
		return cachedRemotes
	end
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local result: { [string]: Instance } = {}
	local folder = ReplicatedStorage:WaitForChild("Remotes", REMOTE_WAIT)
	if not folder then
		warn("[Net] Ordner ReplicatedStorage.Remotes fehlt")
		return result
	end
	local complete = true
	for _, spec in ipairs(Net.RemoteList) do
		local remote = folder:FindFirstChild(spec.Name) or folder:WaitForChild(spec.Name, REMOTE_WAIT)
		if remote and remote:IsA(spec.Class) then
			result[spec.Name] = remote
		else
			complete = false
			warn("[Net] Remote fehlt: " .. spec.Name .. " (" .. spec.Class .. ")")
		end
	end
	if complete then
		cachedRemotes = result -- nur vollständige Ergebnisse merken (sonst später nochmal versuchen)
	end
	return result
end

-- ---------------------------------------------------------------------
-- 2) QUANTISIERUNG
-- ---------------------------------------------------------------------
local function finite(n: any): number
	if typeof(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then
		return 0
	end
	return n
end

-- auf ganze Zahl runden und in [lo, hi] klemmen
local function intIn(n: any, lo: number, hi: number): number
	return math.clamp(math.floor(finite(n) + 0.5), lo, hi)
end

local function pitchByte(pitch: any): number
	return intIn(pitch, -Net.MaxPitch, Net.MaxPitch)
end

-- Bitmaske auf 0..255 (nur ganze, nicht negative Werte)
local function flagsByte(flags: any): number
	return bit32.band(intIn(flags, 0, 255), 0xFF)
end

local function writeVec(b: buffer, offset: number, v: Vector3, origin: Vector3)
	local rel = v - origin
	buffer.writei16(b, offset, intIn(rel.X * Net.FxScale, -32768, 32767))
	buffer.writei16(b, offset + 2, intIn(rel.Y * Net.FxScale, -32768, 32767))
	buffer.writei16(b, offset + 4, intIn(rel.Z * Net.FxScale, -32768, 32767))
end

local function readVec(b: buffer, offset: number, origin: Vector3): Vector3
	local x = buffer.readi16(b, offset) / Net.FxScale
	local y = buffer.readi16(b, offset + 2) / Net.FxScale
	local z = buffer.readi16(b, offset + 4) / Net.FxScale
	return origin + Vector3.new(x, y, z)
end

local function safeVector(v: any): Vector3
	if typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z then
		return v
	end
	return Vector3.zero
end

-- ---------------------------------------------------------------------
-- 3) LOOK (C→S, 4 Byte): i8 pitchDeg, u8 flags, u16 seq
-- ---------------------------------------------------------------------
function Net.EncodeLook(pitchDeg: number, flags: number, seq: number): buffer
	local b = buffer.create(Net.LookSize)
	buffer.writei8(b, 0, pitchByte(pitchDeg))
	buffer.writeu8(b, 1, flagsByte(flags))
	buffer.writeu16(b, 2, math.floor(finite(seq)) % 65536)
	return b
end

function Net.DecodeLook(b: buffer): (number?, number, number)
	if typeof(b) ~= "buffer" or buffer.len(b) ~= Net.LookSize then
		return nil, 0, 0
	end
	local pitch = buffer.readi8(b, 0)
	if pitch < -Net.MaxPitch or pitch > Net.MaxPitch then
		return nil, 0, 0
	end
	return pitch, buffer.readu8(b, 1), buffer.readu16(b, 2)
end

-- ---------------------------------------------------------------------
-- 4) LOOKBATCH (S→C, ≤ 51 Byte): u16 seq, u8 n, n × (u8 slot, i8 pitch, u8 flags)
-- ---------------------------------------------------------------------
function Net.EncodeLookBatch(seq: number, entries: { LookEntry }): buffer
	local n = math.min(#entries, Net.MaxLookBatch)
	local b = buffer.create(3 + n * 3)
	buffer.writeu16(b, 0, math.floor(finite(seq)) % 65536)
	buffer.writeu8(b, 2, n)
	for i = 1, n do
		local e = entries[i]
		local offset = 3 + (i - 1) * 3
		buffer.writeu8(b, offset, intIn(e.Slot, 0, 255))
		buffer.writei8(b, offset + 1, pitchByte(e.Pitch))
		buffer.writeu8(b, offset + 2, flagsByte(e.Flags))
	end
	return b
end

function Net.DecodeLookBatch(b: buffer): (number?, { LookEntry })
	if typeof(b) ~= "buffer" or buffer.len(b) < 3 then
		return nil, {}
	end
	local n = buffer.readu8(b, 2)
	if n > Net.MaxLookBatch or buffer.len(b) ~= 3 + n * 3 then
		return nil, {}
	end
	local entries: { LookEntry } = table.create(n)
	for i = 1, n do
		local offset = 3 + (i - 1) * 3
		entries[i] = {
			Slot = buffer.readu8(b, offset),
			Pitch = math.clamp(buffer.readi8(b, offset + 1), -Net.MaxPitch, Net.MaxPitch),
			Flags = buffer.readu8(b, offset + 2),
		}
	end
	return buffer.readu16(b, 0), entries
end

-- ---------------------------------------------------------------------
-- 5) FX (S→C, ≤ 871 Byte): u8 n, n × (u8 kind, u8 slot, u8 weapon, i16×3 origin, i16×3 end)
--    kind 1 = Tracer + Flächen-Treffer, 2 = Tracer + Spieler-Treffer, 3 = Nahkampf-Schwung, 4 = Wurf
--    Mehr als 58 Einträge: die ältesten (vorne in der Liste) fallen raus.
-- ---------------------------------------------------------------------
local FX_ENTRY = 15

function Net.EncodeFx(entries: { FxEntry }, origin: Vector3): buffer
	local base = safeVector(origin)
	local total = #entries
	local n = math.min(total, Net.MaxFx)
	local first = total - n + 1 -- nur die neuesten n
	local b = buffer.create(1 + n * FX_ENTRY)
	buffer.writeu8(b, 0, n)
	for i = 0, n - 1 do
		local e = entries[first + i]
		local offset = 1 + i * FX_ENTRY
		buffer.writeu8(b, offset, intIn(e.Kind, 0, 255))
		buffer.writeu8(b, offset + 1, intIn(e.Slot, 0, 255))
		buffer.writeu8(b, offset + 2, intIn(e.Weapon, 0, 255))
		writeVec(b, offset + 3, safeVector(e.O), base)
		writeVec(b, offset + 9, safeVector(e.E), base)
	end
	return b
end

function Net.DecodeFx(b: buffer, origin: Vector3): { FxEntry }?
	if typeof(b) ~= "buffer" or buffer.len(b) < 1 then
		return nil
	end
	local n = buffer.readu8(b, 0)
	if n > Net.MaxFx or buffer.len(b) ~= 1 + n * FX_ENTRY then
		return nil
	end
	local base = safeVector(origin)
	local entries: { FxEntry } = table.create(n)
	for i = 0, n - 1 do
		local offset = 1 + i * FX_ENTRY
		entries[i + 1] = {
			Kind = buffer.readu8(b, offset),
			Slot = buffer.readu8(b, offset + 1),
			Weapon = buffer.readu8(b, offset + 2),
			O = readVec(b, offset + 3, base),
			E = readVec(b, offset + 9, base),
		}
	end
	return entries
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Odds</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Kisten-Quoten (Shared/Odds)
--  Besitzer: WP9 (Wirtschaft, Monetarisierung, Kosmetik). Vertrag: DESIGN.md B20.1 + C6.3.
--  Anzeige-Tabelle (Shop "Details & Quoten") und Server-Wurf kommen aus DERSELBEN Tabelle
--  (Config.Shop.Crates.S1) – so stimmen angezeigte Quoten immer mit dem Server überein.
--  Reines Modul (keine Roblox-Dienste) -> mit der Luau-CLI testbar (tests/odds.test.luau).
--
--  Öffentliche API:
--    Odds.Table(crate): { { Id, Percent, Hundredths, Weight, Rarity? } }   Summe exakt 100.00
--    Odds.PityTable(crate): dito, nur die Garantie-Items (Legendary + Mythic)
--    Odds.RarityTable(crate, pity?): { { Rarity, Hundredths, Percent, Count } }  Summe exakt 100.00
--    Odds.Roll(crate, rng, pityActive): string     rng:NextInteger(1, Summe) (Server: Random.new())
--    Odds.Validate(crate): (boolean, string?)        Gewichte ganzzahlig > 0, Summe 10000
--    Odds.PityItems(crate): { item }                 Items der Garantie-Seltenheiten
--    Odds.FormatPercent(hundredths, decimalSep?): string   500 -> "5.00" (oder "5,00")
--  Rundung: Hundertstel-Prozent nach dem Verfahren der größten Reste (Summe immer genau 10000).
-- =====================================================================

local Odds = {}

export type CrateItem = { Id: string, Weight: number, Rarity: string? }
export type Crate = { Items: { CrateItem }, PityRarities: { string }?, PityAfter: number?, [string]: any }
export type OddsRow = { Id: string, Percent: number, Hundredths: number, Weight: number, Rarity: string? }
export type RarityRow = { Rarity: string, Percent: number, Hundredths: number, Count: number }

Odds.TOTAL = 10000 -- Basispunkte (= 100,00 %)

local function itemsOf(crate: any): { CrateItem }
	if type(crate) ~= "table" or type(crate.Items) ~= "table" then
		return {}
	end
	return crate.Items
end

local function validWeight(w: any): boolean
	return type(w) == "number" and w == w and w > 0 and w ~= math.huge and w % 1 == 0
end

-- Gewichte -> Hundertstel-Prozent (Summe genau 10000) nach der Methode der größten Reste.
-- Gleichstand bei den Resten: größeres Gewicht zuerst, dann Reihenfolge in der Liste.
local function apportion(weights: { number }): { number }
	local total = 0
	for _, w in ipairs(weights) do
		total += w
	end
	local result: { number } = table.create(#weights, 0)
	if total <= 0 then
		return result
	end
	local remainders: { { Index: number, Rest: number, Weight: number } } = {}
	local assigned = 0
	for i, w in ipairs(weights) do
		local exact = w * Odds.TOTAL / total
		local floor = math.floor(exact + 1e-9)
		result[i] = floor
		assigned += floor
		table.insert(remainders, { Index = i, Rest = exact - floor, Weight = w })
	end
	table.sort(remainders, function(a, b)
		if math.abs(a.Rest - b.Rest) > 1e-9 then
			return a.Rest > b.Rest
		end
		if a.Weight ~= b.Weight then
			return a.Weight > b.Weight
		end
		return a.Index < b.Index
	end)
	local missing = Odds.TOTAL - assigned
	local i = 1
	while missing > 0 and #remainders > 0 do -- höchstens #weights Schritte (Reste < 1 je Eintrag)
		local entry = remainders[((i - 1) % #remainders) + 1]
		result[entry.Index] += 1
		missing -= 1
		i += 1
	end
	return result
end

local function buildRows(items: { CrateItem }): { OddsRow }
	local weights: { number } = {}
	for _, item in ipairs(items) do
		table.insert(weights, if validWeight(item.Weight) then item.Weight else 0)
	end
	local hundredths = apportion(weights)
	local rows: { OddsRow } = {}
	for i, item in ipairs(items) do
		table.insert(rows, {
			Id = item.Id,
			Percent = hundredths[i] / 100,
			Hundredths = hundredths[i],
			Weight = weights[i],
			Rarity = item.Rarity,
		})
	end
	return rows
end

-- Items der Garantie-Seltenheiten (Legendary + Mythic)
function Odds.PityItems(crate: any): { CrateItem }
	local result: { CrateItem } = {}
	local rarities = if type(crate) == "table" and type(crate.PityRarities) == "table" then crate.PityRarities else {}
	for _, item in ipairs(itemsOf(crate)) do
		if item.Rarity ~= nil and table.find(rarities, item.Rarity) ~= nil then
			table.insert(result, item)
		end
	end
	return result
end

-- Anzeige-Tabelle: { Id, Percent } je Item, Summe exakt 100.00 (bei Summe 10000 = Gewicht/100)
function Odds.Table(crate: { Items: { { Id: string, Weight: number } } }): { OddsRow }
	return buildRows(itemsOf(crate))
end

-- Garantie-Tabelle (30. Öffnung): nur Legendary + Mythic, z. B. 250/250/100 -> 41.67/41.67/16.66
function Odds.PityTable(crate: any): { OddsRow }
	return buildRows(Odds.PityItems(crate))
end

-- Summen pro Seltenheit (Reihenfolge wie in der Kiste), Summe exakt 100.00
function Odds.RarityTable(crate: any, pity: boolean?): { RarityRow }
	local items = if pity then Odds.PityItems(crate) else itemsOf(crate)
	local order: { string } = {}
	local weightOf: { [string]: number } = {}
	local countOf: { [string]: number } = {}
	for _, item in ipairs(items) do
		local rarity = item.Rarity or "?"
		if weightOf[rarity] == nil then
			table.insert(order, rarity)
			weightOf[rarity] = 0
			countOf[rarity] = 0
		end
		weightOf[rarity] += if validWeight(item.Weight) then item.Weight else 0
		countOf[rarity] += 1
	end
	local weights: { number } = {}
	for _, rarity in ipairs(order) do
		table.insert(weights, weightOf[rarity])
	end
	local hundredths = apportion(weights)
	local rows: { RarityRow } = {}
	for i, rarity in ipairs(order) do
		table.insert(rows, {
			Rarity = rarity,
			Hundredths = hundredths[i],
			Percent = hundredths[i] / 100,
			Count = countOf[rarity],
		})
	end
	return rows
end

-- Ein Wurf. pityActive -> nur unter den Garantie-Items (mit ihren normalen Gewichten).
-- rng braucht NextInteger(min, max) (Roblox: Random.new(); Tests: eigene Tabelle).
function Odds.Roll(crate: any, rng: Random, pityActive: boolean): string
	local items = if pityActive then Odds.PityItems(crate) else itemsOf(crate)
	if #items == 0 then
		items = itemsOf(crate) -- Garantie ohne passende Items: normaler Wurf (Validate meldet das)
	end
	local total = 0
	for _, item in ipairs(items) do
		if validWeight(item.Weight) then
			total += item.Weight
		end
	end
	assert(total > 0, "[Odds] Kiste ohne gültige Gewichte")
	local roll = (rng :: any):NextInteger(1, total)
	if type(roll) ~= "number" or roll ~= roll then
		roll = 1
	end
	roll = math.clamp(math.floor(roll), 1, total)
	local last = items[1].Id
	for _, item in ipairs(items) do
		if validWeight(item.Weight) then
			last = item.Id
			roll -= item.Weight
			if roll <= 0 then
				return item.Id
			end
		end
	end
	return last
end

-- Gewichte ganzzahlig > 0, eindeutige Ids, Summe genau 10000, Garantie-Items vorhanden
function Odds.Validate(crate: any): (boolean, string?)
	local items = itemsOf(crate)
	if #items == 0 then
		return false, "keine Items"
	end
	local total = 0
	local seen: { [string]: boolean } = {}
	for i, item in ipairs(items) do
		if type(item.Id) ~= "string" or item.Id == "" then
			return false, ("Item %d: Id fehlt"):format(i)
		end
		if seen[item.Id] then
			return false, "doppelte Id " .. item.Id
		end
		seen[item.Id] = true
		if not validWeight(item.Weight) then
			return false, ("Item %s: Gewicht muss eine ganze Zahl > 0 sein"):format(item.Id)
		end
		total += item.Weight
	end
	if total ~= Odds.TOTAL then
		return false, ("Gewichte ergeben %d statt %d"):format(total, Odds.TOTAL)
	end
	if type(crate.PityAfter) == "number" and #Odds.PityItems(crate) == 0 then
		return false, "Garantie ohne Legendary/Mythic-Items"
	end
	return true, nil
end

-- 500 -> "5.00", 4167 -> "41.67" (decimalSep "," für Deutsch)
function Odds.FormatPercent(hundredths: number, decimalSep: string?): string
	local h = if type(hundredths) == "number" and hundredths == hundredths then math.floor(hundredths + 0.5) else 0
	local whole = math.floor(h / 100)
	local frac = h % 100
	return ("%d%s%02d"):format(whole, decimalSep or ".", frac)
end

return Odds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">ProgressMath</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Fortschritts-Mathematik (Shared/ProgressMath)
--  Besitzer: WP8 (Fortschritt). Vertrag: DESIGN.md C6.3 + B16 + B21.2.
--  Reines Modul (keine Roblox-Dienste, kein Random/Vector3) -> auch mit der
--  Luau-CLI testbar (tests/progressmath.test.luau). Server UND Client rechnen
--  damit gleich (Level-Balken, Pass-Stufen, Login-Kalender, Quest-Rotation).
--
--  Öffentliche API (C6.3):
--    ProgressMath.XpToNext(level): number                 250 + 50·(L−1); 0 ab Max-Level
--    ProgressMath.LevelFromTotal(totalXp): (level, xpInLevel)
--    ProgressMath.Expected(a, b): number                  Elo-Erwartung von a gegen b (0..1)
--    ProgressMath.EloDelta(a, b, score, k): number        ganzzahlig, symmetrisch gerundet
--    ProgressMath.MasteryTier(kills): number              0..10
--  Zusätzlich (von WP8 benutzt, ebenfalls rein):
--    ProgressMath.Configure(progressionConfig)            Kurve/Meisterschaft aus Config.Progression übernehmen
--    ProgressMath.MaxLevel(), ProgressMath.TotalForLevel(level)
--    ProgressMath.MasteryGoal(tier): number?              Pops für die nächste Stufe (nil = max)
--    ProgressMath.ParseIsoUtc(text): number?              "2026-10-15T00:00:00Z" -> Unix-Sekunden
--    ProgressMath.PickSeason(seasons, now): season?       Datumsfenster + Fallback (B21.2)
--    ProgressMath.PassTier(xp, tierXp, tiers): number     erreichte Pass-Stufe
--    ProgressMath.LoginStep(login, today, isoWeek, calendarLength, freezesPerWeek): LoginResult?
--    ProgressMath.Bounty(streak, cfg?): number            Kopfgeld (B16.7)
--    ProgressMath.CapMult(bonusSum, cap): number          additive Multiplikatoren, gedeckelt
--    ProgressMath.Rng(seed): () -> number                 deterministischer Zufall 0..1 (LCG)
--    ProgressMath.Seed(a, b): number                      Seed aus zwei Zahlen (Tag, UserId)
--    ProgressMath.PickDaily(pool, tiers, seed): { string }   je Stufe eine Quest-Id
--    ProgressMath.PickWeekly(pool, count, seed): { string }  count verschiedene Quest-Ids
--    ProgressMath.MatchXp(r, xpCfg): number               Basis-XP eines Matches (B16.1, ohne Multiplikatoren)
--    ProgressMath.MatchCoins(r, coinsCfg, opts): number   Coins eines Matches (B18.2, ohne Tageslimit)
--    ProgressMath.RewriteChat(text, rewrites, lang): string?  Chat-Umschreibung (B24), nil = unverändert
--    ProgressMath.DescribeReward(reward, t, nameOf?): string  Belohnung als Text ("150 Coins + 1 Schlüssel")
-- =====================================================================

local ProgressMath = {}

export type LoginData = {
	LastDay: number,
	CalDay: number,
	Streak: number,
	Best: number,
	FreezeWeek: number,
}
export type LoginResult = { CalDay: number, Streak: number, UsedFreeze: boolean, NewCycle: boolean }
export type QuestDef = { Id: string, Tier: string?, [string]: any }

local TWO32 = 4294967296

-- Startwerte = Config.Progression (B16.1 / B16.2); Configure() überschreibt sie
local curveBase = 250
local curveStep = 50
local maxLevel = 100
local masteryTiers: { number } = { 10, 30, 75, 150, 300, 600, 1000, 2000, 3500, 6000 }
local bountyCfg = { MinStreak = 5, Base = 100, Step = 25, Cap = 300 }

local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function int(n: any, default: number): number
	if not finite(n) then
		return default
	end
	return math.floor(n)
end

-- ---------------------------------------------------------------------
-- 0) EINSTELLUNGEN ÜBERNEHMEN (Config.Progression, fehlende Teile bleiben)
-- ---------------------------------------------------------------------
function ProgressMath.Configure(cfg: any)
	if type(cfg) ~= "table" then
		return
	end
	local curve = cfg.Curve
	if type(curve) == "table" then
		if finite(curve.Base) and curve.Base > 0 then
			curveBase = curve.Base
		end
		if finite(curve.Step) and curve.Step >= 0 then
			curveStep = curve.Step
		end
		if finite(curve.MaxLevel) and curve.MaxLevel >= 2 then
			maxLevel = math.floor(curve.MaxLevel)
		end
	end
	local mastery = cfg.Mastery
	if type(mastery) == "table" and type(mastery.Tiers) == "table" then
		local list: { number } = {}
		local last = 0
		for _, goal in ipairs(mastery.Tiers) do
			if finite(goal) and goal > last then
				table.insert(list, goal)
				last = goal
			end
		end
		if #list > 0 then
			masteryTiers = list
		end
	end
	local bounty = cfg.Bounty
	if type(bounty) == "table" then
		for _, key in ipairs({ "MinStreak", "Base", "Step", "Cap" }) do
			local v = bounty[key]
			if finite(v) and v >= 0 then
				(bountyCfg :: any)[key] = v
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- 1) XP & LEVEL (B16.1)
-- ---------------------------------------------------------------------
function ProgressMath.MaxLevel(): number
	return maxLevel
end

-- XP von Level L nach L+1. Ab dem Max-Level gibt es kein "nächstes" Level -> 0.
function ProgressMath.XpToNext(level: number): number
	local l = math.max(1, int(level, 1))
	if l >= maxLevel then
		return 0
	end
	return curveBase + curveStep * (l - 1)
end

-- Gesamt-XP, die man braucht, um Level "level" zu erreichen (Level 1 = 0)
function ProgressMath.TotalForLevel(level: number): number
	local l = math.clamp(int(level, 1), 1, maxLevel)
	local n = l - 1
	return n * curveBase + curveStep * n * (n - 1) / 2
end

-- Gesamt-XP -> (Level, XP im Level). Am Max-Level ist "XP im Level" immer 0.
function ProgressMath.LevelFromTotal(totalXp: number): (number, number)
	if not finite(totalXp) or totalXp <= 0 then
		return 1, 0
	end
	local level = 1
	local rest = totalXp
	-- höchstens maxLevel Durchläufe
	while level < maxLevel do
		local need = ProgressMath.XpToNext(level)
		if need <= 0 or rest < need then
			break
		end
		rest -= need
		level += 1
	end
	if level >= maxLevel then
		return maxLevel, 0
	end
	return level, rest
end

-- ---------------------------------------------------------------------
-- 2) ELO / VERDECKTES MMR (B16.6)
-- ---------------------------------------------------------------------
function ProgressMath.Expected(a: number, b: number): number
	local ra = if finite(a) then a else 1000
	local rb = if finite(b) then b else 1000
	return 1 / (1 + 10 ^ ((rb - ra) / 400))
end

-- k × (score − Erwartung), symmetrisch gerundet (Gewinn des einen = Verlust des anderen)
function ProgressMath.EloDelta(a: number, b: number, score: number, k: number): number
	local s = if finite(score) then math.clamp(score, 0, 1) else 0.5
	local factor = if finite(k) then math.max(0, k) else 0
	local raw = factor * (s - ProgressMath.Expected(a, b))
	if raw >= 0 then
		return math.floor(raw + 0.5)
	end
	return -math.floor(-raw + 0.5)
end

-- ---------------------------------------------------------------------
-- 3) WAFFEN-MEISTERSCHAFT (B16.2)
-- ---------------------------------------------------------------------
function ProgressMath.MasteryTier(kills: number): number
	if not finite(kills) or kills <= 0 then
		return 0
	end
	local tier = 0
	for i, goal in ipairs(masteryTiers) do
		if kills + 1e-9 >= goal then
			tier = i
		else
			break
		end
	end
	return tier
end

-- Pops, die für Stufe tier+1 nötig sind (nil = höchste Stufe erreicht)
function ProgressMath.MasteryGoal(tier: number): number?
	return masteryTiers[int(tier, 0) + 1]
end

function ProgressMath.MasteryTierCount(): number
	return #masteryTiers
end

-- ---------------------------------------------------------------------
-- 4) DATUM & SAISON (B21.2)
-- ---------------------------------------------------------------------

-- (Jahr, Monat, Tag) -> Tage seit 1970-01-01 (H. Hinnant)
local function daysFromCivil(year: number, month: number, day: number): number
	local y = year - (if month <= 2 then 1 else 0)
	local era = math.floor(y / 400)
	local yoe = y - era * 400
	local mp = (month + 9) % 12
	local doy = math.floor((153 * mp + 2) / 5) + day - 1
	local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
	return era * 146097 + doe - 719468
end

-- "YYYY-MM-DDTHH:MM:SSZ" (oder nur "YYYY-MM-DD") -> Unix-Sekunden UTC; kaputt -> nil
function ProgressMath.ParseIsoUtc(text: string): number?
	if type(text) ~= "string" then
		return nil
	end
	local y, mo, d, h, mi, s = string.match(text, "^(%d%d%d%d)%-(%d%d)%-(%d%d)T(%d%d):(%d%d):(%d%d)Z$")
	if not y then
		y, mo, d = string.match(text, "^(%d%d%d%d)%-(%d%d)%-(%d%d)$")
		h, mi, s = "0", "0", "0"
	end
	if not (y and mo and d and h and mi and s) then
		return nil
	end
	local year, month, day = tonumber(y) :: number, tonumber(mo) :: number, tonumber(d) :: number
	local hour, minute, second = tonumber(h) :: number, tonumber(mi) :: number, tonumber(s) :: number
	if month < 1 or month > 12 or day < 1 or day > 31 or hour > 23 or minute > 59 or second > 60 then
		return nil
	end
	return daysFromCivil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
end

-- Aktive Saison: Datumsfenster StartUtc ≤ jetzt < EndUtc (bei Überschneidung der jüngste Start).
-- Passt keins: jüngster Start ≤ jetzt. Liegt jetzt vor allen: Saison mit Id 1 (sonst die früheste).
-- Leere/kaputte Liste -> nil.
function ProgressMath.PickSeason(seasons: { any }, now: number): any
	if type(seasons) ~= "table" then
		return nil
	end
	local t = if finite(now) then now else 0
	local inWindow, inWindowStart = nil, -math.huge
	local lastStarted, lastStartedAt = nil, -math.huge
	local earliest, earliestAt = nil, math.huge
	local first = nil
	for _, season in ipairs(seasons) do
		if type(season) == "table" then
			local start = ProgressMath.ParseIsoUtc(season.StartUtc)
			local finish = ProgressMath.ParseIsoUtc(season.EndUtc)
			if start then
				if season.Id == 1 then
					first = season
				end
				if start <= t and (finish == nil or t < finish) and start > inWindowStart then
					inWindow, inWindowStart = season, start
				end
				if start <= t and start > lastStartedAt then
					lastStarted, lastStartedAt = season, start
				end
				if start < earliestAt then
					earliest, earliestAt = season, start
				end
			end
		end
	end
	return inWindow or lastStarted or first or earliest
end

-- Erreichte Pass-Stufe für Pass-XP (0..tiers)
function ProgressMath.PassTier(xp: number, tierXp: number, tiers: number): number
	if not finite(xp) or not finite(tierXp) or tierXp <= 0 then
		return 0
	end
	return math.clamp(math.floor(xp / tierXp + 1e-9), 0, math.max(0, int(tiers, 0)))
end

-- ---------------------------------------------------------------------
-- 5) LOGIN-KALENDER (B16.4) – verändert "login" direkt; nil = heute schon abgeholt
--    Kalender rückt nur an Login-Tagen vor; ein verpasster Tag setzt nur die Serie zurück.
--    Genau EIN verpasster Tag wird pro ISO-Woche automatisch mit einem Freeze überbrückt.
-- ---------------------------------------------------------------------
function ProgressMath.LoginStep(
	login: LoginData,
	today: number,
	isoWeek: number,
	calendarLength: number,
	freezesPerWeek: number
): LoginResult?
	local last = int(login.LastDay, 0)
	if last == today then
		return nil
	end
	local length = math.max(1, int(calendarLength, 7))
	local streak = math.max(0, int(login.Streak, 0))
	local gap = today - last
	local usedFreeze = false
	if last > 0 and gap == 1 then
		streak += 1
	elseif last > 0 and gap == 2 and int(freezesPerWeek, 0) > 0 and int(login.FreezeWeek, 0) ~= isoWeek then
		streak += 1
		usedFreeze = true
		login.FreezeWeek = isoWeek
	else
		streak = 1
	end
	local calDay = (math.clamp(int(login.CalDay, 0), 0, length) % length) + 1
	login.CalDay = calDay
	login.Streak = streak
	login.Best = math.max(int(login.Best, 0), streak)
	login.LastDay = today
	return { CalDay = calDay, Streak = streak, UsedFreeze = usedFreeze, NewCycle = calDay == length }
end

-- ---------------------------------------------------------------------
-- 6) KOPFGELD & MULTIPLIKATOREN (B16.7 / B16.1)
-- ---------------------------------------------------------------------
function ProgressMath.Bounty(streak: number, cfg: any): number
	local c: any = if type(cfg) == "table" then cfg else bountyCfg
	local minStreak = if finite(c.MinStreak) then c.MinStreak else bountyCfg.MinStreak
	local s = int(streak, 0)
	if s < minStreak then
		return 0
	end
	local base = if finite(c.Base) then c.Base else bountyCfg.Base
	local step = if finite(c.Step) then c.Step else bountyCfg.Step
	local cap = if finite(c.Cap) then c.Cap else bountyCfg.Cap
	return math.min(cap, base + step * (s - minStreak))
end

-- 1 + Summe der Boni, gedeckelt (B16.1: additiv, Deckel ×3.0)
function ProgressMath.CapMult(bonusSum: number, cap: number): number
	local sum = if finite(bonusSum) then math.max(0, bonusSum) else 0
	local limit = if finite(cap) then math.max(1, cap) else 3
	return math.min(limit, 1 + sum)
end

-- ---------------------------------------------------------------------
-- 7) DETERMINISTISCHER ZUFALL + QUEST-ROTATION (B16.3)
--    Gleicher Seed -> gleiche Quests (auf jedem Server, nach jedem Neubeitritt).
-- ---------------------------------------------------------------------
function ProgressMath.Seed(a: number, b: number): number
	local x = int(a, 0) % TWO32
	local y = int(b, 0) % TWO32
	-- Knuth-Mischung (Produkte bleiben < 2^53, also exakt)
	local h = (x * 2654435761 + y) % TWO32
	h = (h * 40503 + 2246822519) % TWO32
	return h
end

-- Lineare Kongruenz (Numerical Recipes), liefert Zahlen in [0, 1)
function ProgressMath.Rng(seed: number): () -> number
	local state = int(seed, 1) % TWO32
	return function(): number
		state = (state * 1664525 + 1013904223) % TWO32
		return state / TWO32
	end
end

local function pickIndex(rng: () -> number, count: number): number
	return math.clamp(math.floor(rng() * count) + 1, 1, count)
end

-- Je Stufe (z. B. {"Easy","Medium","Hard"}) eine Quest; fehlt eine Stufe, kommt eine beliebige freie Quest.
function ProgressMath.PickDaily(pool: { QuestDef }, tiers: { string }, seed: number): { string }
	local rng = ProgressMath.Rng(seed)
	local used: { [string]: boolean } = {}
	local result: { string } = {}
	for _, tier in ipairs(tiers) do
		local candidates: { QuestDef } = {}
		for _, def in ipairs(pool) do
			if def.Tier == tier and not used[def.Id] then
				table.insert(candidates, def)
			end
		end
		if #candidates == 0 then
			for _, def in ipairs(pool) do
				if not used[def.Id] then
					table.insert(candidates, def)
				end
			end
		end
		if #candidates > 0 then
			local def = candidates[pickIndex(rng, #candidates)]
			used[def.Id] = true
			table.insert(result, def.Id)
		end
	end
	return result
end

-- count verschiedene Quests (Fisher-Yates mit festem Seed)
function ProgressMath.PickWeekly(pool: { QuestDef }, count: number, seed: number): { string }
	local rng = ProgressMath.Rng(seed)
	local ids: { string } = {}
	for _, def in ipairs(pool) do
		table.insert(ids, def.Id)
	end
	for i = #ids, 2, -1 do
		local j = pickIndex(rng, i)
		ids[i], ids[j] = ids[j], ids[i]
	end
	local result: { string } = {}
	for i = 1, math.min(math.max(0, int(count, 0)), #ids) do
		table.insert(result, ids[i])
	end
	return result
end

-- ---------------------------------------------------------------------
-- 8) MATCH-BELOHNUNG (B16.1 / B18.2) – reine Rechnung, Server ruft sie bei Match-Ende auf
--    r = Ausschnitt aus Types.PlayerResult (fehlende Felder = 0 / false)
-- ---------------------------------------------------------------------
local function field(r: any, key: string): number
	local v = if type(r) == "table" then r[key] else nil
	if finite(v) then
		return math.max(0, v)
	end
	return 0
end

local function flag(r: any, key: string): boolean
	return type(r) == "table" and r[key] == true
end

local function cfgNumber(cfg: any, key: string): number
	local v = if type(cfg) == "table" then cfg[key] else nil
	return if finite(v) then v else 0
end

-- Basis-XP: Match beendet + Sieg + Runden + Pops + Assists + Kopf-/Nahkampf-Extra + MVP + Kronen-Verteidigung (Mensch)
function ProgressMath.MatchXp(r: any, xpCfg: any): number
	local xp = cfgNumber(xpCfg, "Played")
	if flag(r, "Won") then
		xp += cfgNumber(xpCfg, "Win")
	end
	xp += field(r, "RoundsWon") * cfgNumber(xpCfg, "Round")
	xp += field(r, "Elims") * cfgNumber(xpCfg, "Elim")
	xp += field(r, "Assists") * cfgNumber(xpCfg, "Assist")
	xp += field(r, "Headshots") * cfgNumber(xpCfg, "HeadElim")
	xp += field(r, "MeleeElims") * cfgNumber(xpCfg, "MeleeElim")
	if flag(r, "Mvp") then
		xp += cfgNumber(xpCfg, "Mvp")
	end
	xp += field(r, "CrownVsHuman") * cfgNumber(xpCfg, "CrownDefence")
	return math.floor(xp + 0.5)
end

export type CoinOpts = {
	Practice: boolean?, -- Practice/Tutorial: 0 Coins
	VsBots: boolean?, -- gegen Bots: ×BotMult, mindestens BotMin
	Streak: number?, -- Siegesserie NACH diesem Match (nur bei Sieg)
	Comeback: boolean?, -- +CoinBonus (Comeback-Bonus)
	ComebackBonus: number?,
	EventMult: number?, -- Admin-Abuse-Event (1 oder 2)
	CrownHumanCoins: number?, -- je Kronen-Verteidigung gegen Menschen
	CrownBotCoins: number?, -- je Kronen-Verteidigung gegen Bots
}

-- Coins eines Matches (Tageslimit für Bot-Coins rechnet der Server)
function ProgressMath.MatchCoins(r: any, coinsCfg: any, opts: CoinOpts?): number
	local o: CoinOpts = opts or {}
	if o.Practice then
		return 0
	end
	local won = flag(r, "Won")
	local coins = cfgNumber(coinsCfg, "Played")
	coins += field(r, "RoundsWon") * cfgNumber(coinsCfg, "Round")
	coins += field(r, "Elims") * cfgNumber(coinsCfg, "Elim")
	coins += field(r, "Assists") * cfgNumber(coinsCfg, "Assist")
	coins += field(r, "Headshots") * cfgNumber(coinsCfg, "HeadElim")
	if won then
		coins += cfgNumber(coinsCfg, "Win")
		-- Siegesserie: +StreakStep je Stufe ab dem 2. Sieg in Folge, höchstens StreakCap
		local streak = if finite(o.Streak) then math.floor(o.Streak :: number) else 0
		if streak >= 2 then
			coins += math.min(cfgNumber(coinsCfg, "StreakCap"), cfgNumber(coinsCfg, "StreakStep") * (streak - 1))
		end
	elseif flag(r, "Draw") then
		coins *= 1 + cfgNumber(coinsCfg, "DrawBonus")
	end
	if flag(r, "Mvp") then
		coins += cfgNumber(coinsCfg, "Mvp")
	end
	if o.Comeback then
		coins *= 1 + (if finite(o.ComebackBonus) then math.max(0, o.ComebackBonus :: number) else 0)
	end
	if o.VsBots then
		coins = math.max(cfgNumber(coinsCfg, "BotMin"), coins * cfgNumber(coinsCfg, "BotMult"))
	end
	-- Kronen-Verteidigungen (flach, nach dem Bot-Faktor)
	local crownHuman = math.min(field(r, "CrownVsHuman"), field(r, "CrownDefences"))
	local crownBot = math.max(0, field(r, "CrownDefences") - crownHuman)
	coins += crownHuman * (if finite(o.CrownHumanCoins) then o.CrownHumanCoins :: number else 0)
	coins += crownBot * (if finite(o.CrownBotCoins) then o.CrownBotCoins :: number else 0)
	local event = if finite(o.EventMult) then math.clamp(o.EventMult :: number, 1, 2) else 1
	return math.max(0, math.floor(coins * event + 0.5))
end

-- ---------------------------------------------------------------------
-- 9) CHAT-UMSCHREIBUNG (B24) – nur ganze Nachricht oder ganze Wörter,
--    Groß/Klein egal, Satzzeichen trennen. Bytes ≥ 128 (Umlaute, Emoji) zählen
--    zum Wort, damit z. B. "Trashübung" NICHT umgeschrieben wird.
--    rewrites = { [wortKlein] = { de, en } }. Rückgabe nil = nichts geändert.
-- ---------------------------------------------------------------------
local WORD_PATTERN = "()([%w\128-\255]+)()"
local MAX_CHAT_LEN = 400

function ProgressMath.RewriteChat(text: string, rewrites: any, lang: string): string?
	if type(text) ~= "string" or text == "" or #text > MAX_CHAT_LEN or type(rewrites) ~= "table" then
		return nil
	end
	local function replacement(word: string): string?
		local entry = rewrites[string.lower(word)]
		if type(entry) ~= "table" then
			return nil
		end
		local out = entry[lang] or entry.en or entry.de
		return if type(out) == "string" then out else nil
	end
	local parts: { string } = {}
	local changed = false
	local last = 1
	-- Positions-Captures "()" liefern zur Laufzeit Zahlen (Typ-Prüfer kennt nur Text)
	for startCap, word, endCap in string.gmatch(text, WORD_PATTERN) do
		local startPos = tonumber(startCap) or 1
		local endPos = tonumber(endCap) or (#text + 1)
		local out = replacement(word)
		if out then
			table.insert(parts, string.sub(text, last, startPos - 1))
			table.insert(parts, out)
			last = endPos
			changed = true
		end
	end
	if not changed then
		return nil
	end
	table.insert(parts, string.sub(text, last))
	return table.concat(parts)
end

-- ---------------------------------------------------------------------
-- 10) BELOHNUNG ALS TEXT – t = Übersetzer (Lang-Schlüssel "prog.r.*"),
--     nameOf = Anzeigename einer Kosmetik-Id (sonst die Id selbst)
-- ---------------------------------------------------------------------
local REWARD_ORDER = { "Coins", "Gems", "Keys", "Shards", "PassXp", "XpBoostSeconds", "FreeWeaponPicks", "FreePick" }
local REWARD_KEYS: { [string]: string } = {
	Coins = "prog.r.coins",
	Gems = "prog.r.gems",
	Keys = "prog.r.keys",
	Shards = "prog.r.shards",
	PassXp = "prog.r.passXp",
	XpBoostSeconds = "prog.r.xpBoost",
	FreeWeaponPicks = "prog.r.pick",
	FreePick = "prog.r.pick",
}

function ProgressMath.DescribeReward(reward: any, t: (string, ...any) -> string, nameOf: ((string) -> string)?): string
	if type(reward) ~= "table" then
		return ""
	end
	local parts: { string } = {}
	for _, key in ipairs(REWARD_ORDER) do
		local v = reward[key]
		if finite(v) and v > 0 then
			local amount = math.floor(v + 0.5)
			if key == "XpBoostSeconds" then
				amount = math.max(1, math.floor(v / 60 + 0.5))
			end
			table.insert(parts, t(REWARD_KEYS[key], amount))
		end
	end
	local function addItem(id: any)
		if type(id) == "string" and id ~= "" and #parts < 12 then
			table.insert(parts, if nameOf then nameOf(id) else id)
		end
	end
	addItem(reward.Cosmetic)
	addItem(reward.Title)
	addItem(reward.Wrap)
	if type(reward.Cosmetics) == "table" then
		for _, id in ipairs(reward.Cosmetics) do
			addItem(id)
		end
	end
	if type(reward.Weapons) == "table" then
		for _, id in ipairs(reward.Weapons) do
			addItem(id)
		end
	end
	return table.concat(parts, " + ")
end

return ProgressMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Spread</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Streuung (Shared/Spread)
--  Besitzer: WP3 (Kampf Server & Treffer-Mathematik). Vertrag: DESIGN.md C6.2, B11.1, C10.
--  Reines Modul: keine Dienste, kein Zufall von Roblox – Client und Server rechnen
--  mit derselben Ganzzahl-Mathematik (bit32) exakt dieselben Strahlen.
--
--  Öffentliche API:
--    Spread.Seed(salt, shotId): number
--        ganzzahlig 1..2^31-1, deterministisch. salt = Combatant.Salt (vom Server, Combat("Armed")),
--        shotId = fortlaufende Schuss-Nummer des Clients. NIE einen Client-Seed benutzen.
--    Spread.Directions(aim, def, scaleDeg, seed): { Vector3 }
--        genau def.Pellets Einheitsvektoren, gleichmäßig in einem Kegel mit Halbwinkel scaleDeg um aim.
--        scaleDeg <= 0 -> alle Strahlen = aim.
--    Spread.Bloom(def, shotTimes, t): number
--        min(BloomMax, BloomPerShot × Kettenlänge). shotTimes = Zeitstempel der VORHERIGEN Schüsse
--        (ein Eintrag gleich t wird ignoriert). Kette reißt bei Abstand > Interval × 1.6.
--    Spread.MinScale(def, adsOk, speed, airborne): number
--        Untergrenze des Server-Spreads (C10 Schritt 7): (adsOk ? SpreadAds : SpreadHip)
--        + (speed > Config.Combat.MovingSpeed ? SpreadMove : 0) + (airborne ? SpreadAir : 0).
--        Ohne Bloom (der Server nimmt max(Client-Anspruch, MinScale)).
--    Spread.MaxBloomChain                  Obergrenze der Kettenlänge (Schleifen-Grenze)
--  Ergänzungen von WP3 (Besitzer-Wunsch docs/SKILL-WUENSCHE.md – Client und Server rechnen gleich):
--    Spread.Chain(def, shotTimes, t): number       Anzahl vorheriger Schüsse in der laufenden Kette
--    Spread.FirstShot(def, shotTimes, t): number   def.FirstShotMult beim ersten Schuss einer Kette, sonst 1
--    Spread.Recoil(def, index, seed?): (pitchDeg, yawDeg)
--        Rückstoß des index-ten Schusses der Kette (1 = erster). Mit def.RecoilPattern fest und lernbar,
--        sonst RecoilPitch hoch + RecoilYaw zufällig ± (aus seed deterministisch).
--
--  Client-Formel (B11.1, WP4): lerp(SpreadHip, SpreadAds, adsAlpha) + Move + Air + Bloom (+ Rutschen).
--  Solange das Zielen noch nicht "fertig" ist (AdsTime − 0.1 s), rechnet der Server mit SpreadHip.
-- =====================================================================

local Types = require(script.Parent:WaitForChild("Types"))

local Spread = {}

local TWO32 = 4294967296
local TWO16 = 65536
local TAU = math.pi * 2

Spread.MaxBloomChain = 64

-- Startwerte = Config.Combat (zur Laufzeit von dort gelesen, damit es nur EINE Quelle gibt)
local movingSpeed = 10

do
	local ok, combat = pcall(function()
		return require(script.Parent:WaitForChild("Config"):WaitForChild("Combat"))
	end)
	if ok and type(combat) == "table" then
		local value = (combat :: any).MovingSpeed
		if type(value) == "number" and value == value and value >= 0 and value < math.huge then
			movingSpeed = value
		end
	end
end

-- ---------------------------------------------------------------------
-- 1) GANZZAHL-HELFER (exakt, ohne Genauigkeitsverlust über 2^53)
-- ---------------------------------------------------------------------

-- beliebige Zahl -> 0..2^32-1 (NaN/unendlich -> 0)
local function toU32(n: number): number
	if n ~= n or n == math.huge or n == -math.huge then
		return 0
	end
	return math.floor(n) % TWO32
end

-- (a × b) mod 2^32, a und b in 0..2^32-1
local function mul32(a: number, b: number): number
	local bl = b % TWO16
	local bh = (b - bl) / TWO16
	return (a * bl + ((a * bh) % TWO16) * TWO16) % TWO32
end

-- murmur3 fmix32 – verteilt benachbarte Werte gut
local function fmix32(h: number): number
	h = bit32.bxor(h, bit32.rshift(h, 16))
	h = mul32(h, 0x85EBCA6B)
	h = bit32.bxor(h, bit32.rshift(h, 13))
	h = mul32(h, 0xC2B2AE35)
	h = bit32.bxor(h, bit32.rshift(h, 16))
	return h
end

-- xorshift32: nächster Zustand (nie 0, wenn der Start nicht 0 ist)
local function xorshift(x: number): number
	x = bit32.bxor(x, bit32.lshift(x, 13))
	x = bit32.bxor(x, bit32.rshift(x, 17))
	x = bit32.bxor(x, bit32.lshift(x, 5))
	return x
end

local function finiteOr(n: number, default: number): number
	if n ~= n or n == math.huge or n == -math.huge then
		return default
	end
	return n
end

-- ---------------------------------------------------------------------
-- 2) SEED
-- ---------------------------------------------------------------------
function Spread.Seed(salt: number, shotId: number): number
	local s = toU32(salt)
	local n = toU32(shotId)
	local h = bit32.bxor(fmix32(bit32.bxor(s, 0x5BD1E995)), mul32(n, 0x9E3779B1))
	h = fmix32(h)
	h = bit32.band(h, 0x7FFFFFFF)
	if h == 0 then
		h = 1
	end
	return h
end

-- ---------------------------------------------------------------------
-- 3) RICHTUNGEN
-- ---------------------------------------------------------------------
local FALLBACK_AIM = Vector3.new(0, 0, -1)

local function unitAim(aim: Vector3): Vector3
	local m = aim.Magnitude
	if m ~= m or m < 1e-6 or m == math.huge then
		return FALLBACK_AIM
	end
	return aim / m
end

function Spread.Directions(aim: Vector3, def: Types.WeaponDef, scaleDeg: number, seed: number): { Vector3 }
	local pellets = math.clamp(math.floor(finiteOr(def.Pellets, 1)), 1, 32)
	local a = unitAim(aim)
	local scale = math.clamp(finiteOr(scaleDeg, 0), 0, 89)
	local dirs: { Vector3 } = table.create(pellets)
	if scale <= 0 then
		for i = 1, pellets do
			dirs[i] = a
		end
		return dirs
	end
	-- Orthonormalbasis um die Zielrichtung
	local helper = if math.abs(a.Y) < 0.99 then Vector3.yAxis else Vector3.xAxis
	local right = a:Cross(helper).Unit
	local up = right:Cross(a)
	local maxAngle = math.rad(scale)
	local state = toU32(seed)
	if state == 0 then
		state = 0x6D2B79F5
	end
	for i = 1, pellets do
		state = xorshift(state)
		local u1 = state / TWO32
		state = xorshift(state)
		local u2 = state / TWO32
		-- gleichmäßig über die Kegel-Kappe (Fläche ~ Winkel²) -> sqrt
		local theta = maxAngle * math.sqrt(u1)
		local phi = TAU * u2
		local s = math.sin(theta)
		local offset = right * (math.cos(phi) * s) + up * (math.sin(phi) * s)
		dirs[i] = (a * math.cos(theta) + offset).Unit
	end
	return dirs
end

-- ---------------------------------------------------------------------
-- 4) BLOOM
-- ---------------------------------------------------------------------
function Spread.Chain(def: Types.WeaponDef, shotTimes: { number }, t: number): number
	local gapLimit = math.max(0, finiteOr(def.Interval, 0)) * 1.6
	local chain = 0
	local now = finiteOr(t, 0)
	local prev = now
	local count = #shotTimes
	local stop = math.max(1, count - Spread.MaxBloomChain * 2)
	for i = count, stop, -1 do
		local st = shotTimes[i]
		if type(st) == "number" and st == st then
			local gap = prev - st
			if prev == now and math.abs(gap) < 1e-4 then
				continue -- derselbe Schuss (schon eingetragen) zählt nicht
			end
			if gap < 0 then
				continue -- spätere Einträge ignorieren
			end
			if gap > gapLimit then
				break
			end
			chain += 1
			prev = st
			if chain >= Spread.MaxBloomChain then
				break
			end
		end
	end
	return chain
end

function Spread.Bloom(def: Types.WeaponDef, shotTimes: { number }, t: number): number
	local perShot = finiteOr(def.BloomPerShot, 0)
	local maxBloom = finiteOr(def.BloomMax, 0)
	if perShot <= 0 or maxBloom <= 0 then
		return 0
	end
	return math.min(maxBloom, perShot * Spread.Chain(def, shotTimes, t))
end

function Spread.FirstShot(def: Types.WeaponDef, shotTimes: { number }, t: number): number
	local mult = (def :: any).FirstShotMult
	if type(mult) ~= "number" or mult ~= mult or mult >= 1 or mult < 0 then
		return 1
	end
	if Spread.Chain(def, shotTimes, t) > 0 then
		return 1
	end
	return mult
end

function Spread.Recoil(def: Types.WeaponDef, index: number, seed: number?): (number, number)
	local pitch = math.max(0, finiteOr(def.RecoilPitch, 0))
	local yaw = math.max(0, finiteOr(def.RecoilYaw, 0))
	local n = math.max(1, math.floor(finiteOr(index, 1)))
	local pattern = (def :: any).RecoilPattern
	if type(pattern) == "table" and #pattern > 0 then
		local len = math.min(#pattern, Spread.MaxBloomChain)
		local loopFrom = math.clamp(math.floor(finiteOr((def :: any).RecoilLoopFrom or 1, 1)), 1, len)
		local i = n
		if i > len then
			local loopLen = len - loopFrom + 1
			i = loopFrom + ((i - len - 1) % loopLen)
		end
		local step = pattern[i]
		if type(step) == "table" then
			local p = finiteOr(tonumber(step[1]) or 1, 1)
			local y = math.clamp(finiteOr(tonumber(step[2]) or 0, 0), -1.5, 1.5)
			return pitch * p, yaw * y
		end
	end
	-- ohne Muster: zufälliger Seitenkick ±RecoilYaw, aus seed + index deterministisch
	local state = toU32((seed or 0) + n * 0x9E37)
	if state == 0 then
		state = 0x6D2B79F5
	end
	state = xorshift(xorshift(state))
	return pitch, yaw * ((state / TWO32) * 2 - 1)
end

-- ---------------------------------------------------------------------
-- 5) SERVER-UNTERGRENZE
-- ---------------------------------------------------------------------
function Spread.MinScale(def: Types.WeaponDef, adsOk: boolean, speed: number, airborne: boolean): number
	local base = if adsOk then finiteOr(def.SpreadAds, 0) else finiteOr(def.SpreadHip, 0)
	local v = finiteOr(speed, 0)
	if v > movingSpeed then
		base += finiteOr(def.SpreadMove, 0)
	end
	if airborne then
		base += finiteOr(def.SpreadAir, 0)
	end
	return math.max(0, base)
end

return Spread
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Spring</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Frame-unabhängige Feder (Shared/Spring)
--  Besitzer: WP1 (Core & Plattform). Für Kamera-Rückstoß, Viewmodel-Sway/Bob (WP4).
--
--  Öffentliche API (DESIGN.md C6.1):
--    Spring.new(initial: Vector3, speed: number, damper: number): SpringObj
--    spring:Step(dt): Vector3        dt wird auf 0..1/30 geklemmt, intern feste Unterschritte (≤ 1/240 s)
--    spring:Impulse(v: Vector3)      addiert v zur Geschwindigkeit (z. B. Rückstoß-Kick)
--    spring:SetTarget(v: Vector3)    neues Ziel (Ruhelage)
--  Felder (lesbar/schreibbar): Position, Velocity, Target, Speed, Damper
--  speed = Eigenfrequenz (rad/s, größer = schneller), damper = Dämpfung (1 = kritisch, < 1 schwingt nach)
-- =====================================================================

local Spring = {}

export type SpringObj = {
	Position: Vector3,
	Velocity: Vector3,
	Target: Vector3,
	Speed: number,
	Damper: number,
	Step: (self: SpringObj, dt: number) -> Vector3,
	Impulse: (self: SpringObj, v: Vector3) -> (),
	SetTarget: (self: SpringObj, v: Vector3) -> (),
}

local MAX_DT = 1 / 30
local SUB_STEP = 1 / 240
local MAX_SUB_STEPS = 8 -- 1/30 ÷ 1/240

local function finite(n: number, fallback: number): number
	if n ~= n or n == math.huge or n == -math.huge then
		return fallback
	end
	return n
end

local function finiteVector(v: Vector3): boolean
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z and v.Magnitude < math.huge
end

local function step(self: SpringObj, dt: number): Vector3
	local total = math.clamp(finite(dt, 0), 0, MAX_DT)
	if total <= 0 then
		return self.Position
	end
	local steps = math.clamp(math.ceil(total / SUB_STEP), 1, MAX_SUB_STEPS)
	local h = total / steps
	local speed = math.max(0, finite(self.Speed, 0))
	local damper = math.max(0, finite(self.Damper, 1))
	local k = speed * speed -- Federkonstante
	local c = 2 * damper * speed -- Dämpfung
	local position, velocity, target = self.Position, self.Velocity, self.Target
	for _ = 1, steps do
		-- semi-implizites Euler-Verfahren: stabil bei kleinen festen Schritten
		local acceleration = (target - position) * k - velocity * c
		velocity += acceleration * h
		position += velocity * h
	end
	if not (finiteVector(position) and finiteVector(velocity)) then
		-- Sicherheitsnetz: nie NaN in die Kamera schreiben
		position, velocity = target, Vector3.zero
	end
	self.Position = position
	self.Velocity = velocity
	return position
end

local function impulse(self: SpringObj, v: Vector3)
	if finiteVector(v) then
		self.Velocity += v
	end
end

local function setTarget(self: SpringObj, v: Vector3)
	if finiteVector(v) then
		self.Target = v
	end
end

function Spring.new(initial: Vector3, speed: number, damper: number): SpringObj
	local start = if finiteVector(initial) then initial else Vector3.zero
	local obj: SpringObj = {
		Position = start,
		Velocity = Vector3.zero,
		Target = start,
		Speed = math.max(0, finite(speed, 10)),
		Damper = math.max(0, finite(damper, 1)),
		Step = step,
		Impulse = impulse,
		SetTarget = setTarget,
	}
	return obj
end

return Spring
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Gemeinsame Typen (Shared/Types)
--  Besitzer: WP1 (Core & Plattform). Vertrag: DESIGN.md C4 – alle Pakete
--  annotieren damit: local Types = require(Shared:WaitForChild("Types"))
--  Öffentliche API: nur Typen (export type …), zur Laufzeit eine leere Tabelle.
--  Nichts hier ändern, ohne den Vertrag in DESIGN.md mitzuändern!
-- =====================================================================

export type Lang = "de" | "en"
export type SlotName = "Primary" | "Secondary" | "Melee" | "Utility"
export type Loadout = { Primary: string, Secondary: string, Melee: string, Utility: string }
export type NotifyKind = "Info" | "Success" | "Error" | "Event" | "Alarm" | "Announce"
export type Reply = { Ok: boolean, Message: string?, [string]: any }
export type Grant = {
	Coins: number?,
	Gems: number?,
	Keys: number?,
	Shards: number?,
	Weapons: { string }?,
	Cosmetics: { string }?,
	FreeWeaponPicks: number?,
	PassPremium: boolean?,
	PassTiers: number?,
	XpBoostSeconds: number?,
}
export type Currency = "Coins" | "Gems" | "Keys" | "Shards"
export type WeaponKind = "Hitscan" | "Projectile" | "Melee" | "Throwable" | "Consumable"
export type ProjectileDef = {
	Speed: number,
	Gravity: number,
	Lifetime: number,
	Radius: number,
	SplashMax: number,
	SplashMin: number,
	Direct: number?,
	Bounces: number?,
	Restitution: number?,
	Fuse: number?,
	SelfMult: number,
	PopOnLand: boolean?,
}
export type MeleeDef = {
	Range: number,
	Cone: number,
	Windup: number?,
	Knockback: Vector3?,
	AirJump: boolean?,
	Block: { Mult: number, Cone: number, Max: number, Cooldown: number, MoveMult: number }?,
}
export type WeaponDef = {
	Id: number,
	Key: string,
	Slot: SlotName,
	Kind: WeaponKind,
	Name: { de: string, en: string },
	Short: string,
	Damage: number,
	MinMult: number,
	HeadMult: number,
	FireMode: "Auto" | "Semi" | "Burst" | "Single",
	Interval: number,
	BurstCount: number?,
	BurstInterval: number?,
	Pellets: number,
	Mag: number,
	Reload: number,
	Equip: number,
	SpreadHip: number,
	SpreadAds: number,
	SpreadMove: number,
	SpreadAir: number,
	BloomPerShot: number,
	BloomMax: number,
	FalloffStart: number,
	FalloffEnd: number,
	Range: number,
	AdsZoom: number,
	AdsTime: number,
	MoveMult: number,
	AdsMoveMult: number,
	RecoilPitch: number,
	RecoilYaw: number,
	RecoilRecover: number,
	Projectile: ProjectileDef?,
	Melee: MeleeDef?,
	Heal: { Amount: number, Duration: number, UseTime: number }?,
	Smoke: { Radius: number, Duration: number }?,
	Charges: number?,
	Cooldown: number?,
	Price: number,
	Free: boolean,
	AdminOnly: boolean?,
	Model: string,
	Sound: string,
	Enabled: boolean,
}
export type CombatantKind = "Player" | "Bot" | "Dummy"
export type AmmoState = { Mag: number, ReloadUntil: number, Charges: number, CooldownUntil: number, BurstLeft: number }
export type Combatant = {
	Id: number, -- UserId (>0 live; -1..-999 Studio) | Bot -1001 abwärts | Puppe -5001 abwärts
	Kind: CombatantKind,
	Player: Player?,
	Name: string,
	Model: Model,
	Root: BasePart,
	Head: BasePart,
	Humanoid: Humanoid?,
	Ctx: string,
	Team: number,
	Slot: number, -- Roster-Slot 1..32 im Kontext (u8 in Buffern)
	Hp: number,
	MaxHp: number,
	Alive: boolean,
	ShieldUntil: number,
	Loadout: Loadout,
	Equipped: SlotName,
	EquipReadyAt: number,
	Ammo: { [SlotName]: AmmoState },
	Ads: boolean,
	AdsSince: number,
	Blocking: boolean,
	BlockUntil: number,
	BlockCooldownUntil: number,
	HealUntil: number,
	Salt: number,
	LastShotId: number,
	LastShotT: number,
	ShotTimes: { number },
	LastDamagerId: number?,
	LastDamageAt: number,
	Difficulty: string?,
	IsAdmin: boolean,
}
export type NavGraph = { Nodes: { { P: Vector3, Cover: boolean } }, Edges: { { number } } }
export type Arena = {
	Slot: number,
	Key: string,
	BuildId: number,
	Model: Model,
	Origin: CFrame,
	Spawns: { A: { CFrame }, B: { CFrame }, FFA: { CFrame } },
	Zone: Vector3,
	ZoneRadius: number,
	KillY: number,
	Vault: CFrame,
	Nav: NavGraph,
	MapParams: RaycastParams,
}
export type ContextRules = {
	DamageMult: number,
	HeadOnly: boolean,
	HeadRadiusMult: number,
	IntervalMult: number,
	ReloadMult: number,
	SpeedMult: number,
	GravityLift: number,
	AllowedSlots: { [SlotName]: boolean }?,
	ForcedLoadout: Loadout?,
	RandomLoadout: boolean,
	Regen: boolean,
	UtilityMode: "Charges" | "Cooldown",
	FriendlyFire: boolean,
	IgnoreOwnership: boolean, -- Range/Practice/LuckyLoadout: jede Waffe erlaubt
}
export type ContextInfo = {
	Ctx: string,
	Arena: Arena,
	Rules: ContextRules,
	Recipients: () -> { Player },
	MatchId: number?,
}
export type DamageInfo = {
	WeaponKey: string,
	Head: boolean,
	Kind: "Hitscan" | "Splash" | "Melee" | "Void" | "Admin" | "Fallback",
	Dist: number,
	From: Vector3,
}
export type ElimInfo = {
	WeaponKey: string,
	Head: boolean,
	Kind: string,
	KillerId: number?,
	Assists: { number },
	Pos: Vector3,
	KillerSliding: boolean?,
	Melee: boolean?,
	Splash: boolean?,
	Void: boolean?,
}
export type RecapHit = { W: string, D: number, H: boolean, Dist: number, T: number }
export type RecapData = {
	KillerId: number?,
	KillerName: string,
	KillerHp: number,
	WeaponKey: string,
	Taken: { RecapHit },
	DealtToKiller: number,
	DealtHits: number,
	DealtHeads: number,
}
export type BotRequest = { Bot: true, Difficulty: string }
export type MatchSpec = {
	Mode: string,
	Teams: { { Player | BotRequest } },
	Map: string?,
	Mood: string?,
	Mutator: string?,
	Tutorial: boolean?,
	RematchOf: number?,
	AdminStarted: boolean?,
}
export type PlayerResult = {
	Team: number,
	Won: boolean,
	Draw: boolean,
	Left: boolean,
	AfkRemoved: boolean,
	RoundsWon: number,
	Elims: number,
	PvpElims: number,
	Headshots: number,
	MeleeElims: number,
	Assists: number,
	Damage: number,
	Deaths: number,
	Mvp: boolean,
	Flawless: number,
	Clutches: number,
	Aces: number,
	OvertimeCaps: number,
	CrownDefences: number,
	CrownVsHuman: number,
	BountyClaimed: number,
	WeaponKills: { [string]: number },
	WeaponUsed: { [string]: boolean },
	ShotsFired: number,
	ShotsHit: number,
	Comeback: boolean,
}
export type MatchResult = {
	MatchId: number,
	Mode: string,
	Map: string,
	Winner: number,
	Draw: boolean,
	Tainted: boolean,
	VsBots: boolean,
	Practice: boolean,
	Tutorial: boolean,
	Duration: number,
	PerPlayer: { [Player]: PlayerResult },
}
export type MapPart = {
	Shape: "Block" | "Wedge" | "Cylinder" | "Ball" | "CornerWedge",
	Pos: Vector3,
	Size: Vector3,
	Rot: Vector3?, -- Grad (X,Y,Z)
	HighEnd: number?, -- Wedge: z-Wert des hohen Endes (lokal)
	Color: string | Color3,
	Material: string?,
	Transparency: number?,
	CanCollide: boolean?,
	Center: boolean?,
	Mirror: boolean?,
	Tag: string?,
	Text: string?, -- Text = SurfaceGui-Buchstabe
	Barrier: boolean?, -- unsichtbare ArenaBarrier
}
export type MapLayout = {
	Key: string,
	Size: Vector3,
	WallHeight: number,
	Parts: { MapPart },
	SpawnsA: { Vector3 },
	FFA: { Vector3 }?,
	Zone: Vector3,
	ZoneRadius: number?,
	CoverNodes: { Vector3 },
	CustomBounds: { Min: Vector3, Max: Vector3 }?,
	KillY: number?,
}
export type PlayerData = { [string]: any } -- Schema siehe C13

-- Reines Typ-Modul: zur Laufzeit gibt es nichts zu holen
return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Kleine Helfer für Server UND Client (Shared/Util)
--  Besitzer: WP1 (Core & Plattform). Basis: Meteor-Heist-Util + Fix REUSE §14.2.
--  Reines Modul (keine Roblox-Dienste beim Laden) -> auch mit der Luau-CLI testbar
--  (tests/util.test.luau).
--
--  Öffentliche API (DESIGN.md C6.1):
--    Util.FormatNumber(n): string          1150 -> "1.15K", math.huge -> "MAX", -0.5 -> "0"
--    Util.FormatTime(seconds): string      "5h 12m" (ab 1 Stunde), sonst "3:07"
--    Util.DeepCopy(v), Util.Reconcile(target, template)
--    Util.WeightedPick(list, weightOf?, rng?): T?   Gewicht 0/NaN/negativ/unendlich wird nie gewählt
--    Util.RateLimiter(maxCalls, perSeconds, clock?)  -> { Check(key): boolean, Clear(key) }
--    Util.TokenBucket(capacity, refillPerSecond, clock?) -> { Take(key, n?): boolean, Clear(key) }
--    Util.IsFinite(n), Util.IsFiniteVector(v)
--    Util.UtcDay(now?), Util.IsoWeek(now?), Util.SetDayOffset(n), Util.GetDayOffset()
--    Util.Snapshot(t): { K }, Util.Hash(s): number (FNV-1a 32 Bit, 0..2^31-1)
--  "clock" ist optional (künstliche Uhr für Tests), Standard os.clock.
-- =====================================================================

local Util = {}

export type RateLimiter = {
	Check: (key: any) -> boolean,
	Clear: (key: any) -> (),
}

export type TokenBucket = {
	Take: (key: any, n: number?) -> boolean,
	Clear: (key: any) -> (),
}

local HUGE = math.huge

-- ---------------------------------------------------------------------
-- 1) ZAHLEN PRÜFEN
-- ---------------------------------------------------------------------

-- true nur für echte, endliche Zahlen (kein NaN, kein ±unendlich, kein String)
function Util.IsFinite(n: any): boolean
	return typeof(n) == "number" and n == n and n ~= HUGE and n ~= -HUGE
end

-- true nur für einen Vector3 mit drei endlichen Komponenten
function Util.IsFiniteVector(v: any): boolean
	if typeof(v) ~= "Vector3" then
		return false
	end
	return Util.IsFinite(v.X) and Util.IsFinite(v.Y) and Util.IsFinite(v.Z)
end

-- ---------------------------------------------------------------------
-- 2) ANZEIGE
-- ---------------------------------------------------------------------
local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
local EPS = 1e-9

-- 1234 -> "1.23K", 15000000 -> "15M" (abgerundet, nie "1000K")
function Util.FormatNumber(n: number): string
	if typeof(n) ~= "number" or n ~= n then
		return "0"
	elseif n == HUGE or n == -HUGE then
		return if n > 0 then "MAX" else "-MAX"
	end
	local negative = n <= -1 -- -0.5 -> "0" statt "-0"
	n = math.abs(n)
	if n < 1000 then
		local s = string.format("%d", math.floor(n + EPS))
		return if negative then "-" .. s else s
	end
	-- Stufe über Vergleiche statt wiederholtem Teilen (sonst wird 1e33 zu "999No")
	local index, scale = 1, 1
	while index < #SUFFIXES and n * (1 + EPS) >= scale * 1000 do
		scale *= 1000
		index += 1
	end
	local v = n / scale
	local text: string
	if v >= 100 then
		-- relativer Puffer (über "Dc" hinaus wird v sehr groß); %.0f: kein Überlauf bei riesigen Zahlen
		text = string.format("%.0f", math.floor(v * (1 + EPS)))
	elseif v >= 10 then
		text = string.format("%.1f", math.floor(v * 10 + EPS) / 10)
	else
		text = string.format("%.2f", math.floor(v * 100 + EPS) / 100)
	end
	if string.find(text, ".", 1, true) then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return (if negative then "-" else "") .. text .. SUFFIXES[index]
end

-- 187 -> "3:07", 18720 -> "5h 12m" (ab einer Stunde ohne Sekunden)
function Util.FormatTime(seconds: number): string
	if not Util.IsFinite(seconds) then
		seconds = 0
	end
	local total = math.clamp(math.floor(seconds), 0, 359999999) -- höchstens 99999h 59m
	local h = math.floor(total / 3600)
	local m = math.floor((total % 3600) / 60)
	local s = total % 60
	if h > 0 then
		return string.format("%dh %dm", h, m)
	end
	return string.format("%d:%02d", m, s)
end

-- ---------------------------------------------------------------------
-- 3) TABELLEN
-- ---------------------------------------------------------------------
function Util.DeepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value :: any) do
		copy[k] = Util.DeepCopy(v)
	end
	return copy :: any
end

-- Ergänzt fehlende Felder aus "template" (für Spielstände nach Updates).
function Util.Reconcile(target: { [any]: any }, template: { [any]: any })
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = Util.DeepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" then
			Util.Reconcile(target[k], v)
		end
	end
end

-- Liste der Schlüssel (zum sicheren Durchlaufen, während die Tabelle sich ändert)
function Util.Snapshot<K, V>(t: { [K]: V }): { K }
	local keys: { any } = {}
	local count = 0
	for k in pairs(t :: any) do
		count += 1
		keys[count] = k
	end
	return keys :: any
end

-- ---------------------------------------------------------------------
-- 4) ZUFALL
-- ---------------------------------------------------------------------

-- Gewichtete Zufallsauswahl: list = { {Weight = 5, ...}, ... } oder eigene weightOf-Funktion.
-- Einträge mit Gewicht 0 (oder NaN/negativ/unendlich) werden NIE gewählt.
-- Haben alle Einträge Gewicht 0 (oder ist die Liste leer) -> nil.
function Util.WeightedPick<T>(list: { T }, weightOf: ((T) -> number)?, rng: Random?): T?
	local function weight(item: T): number
		local raw: any
		if weightOf then
			local ok, result = pcall(weightOf, item)
			raw = if ok then result else 0
		elseif type(item) == "table" then
			raw = (item :: any).Weight
		end
		local w = tonumber(raw) or 0
		if not Util.IsFinite(w) or w < 0 then
			return 0
		end
		return w
	end
	local total = 0
	local lastPositive: T? = nil
	for _, item in ipairs(list) do
		local w = weight(item)
		total += w
		if w > 0 then
			lastPositive = item
		end
	end
	if total <= 0 or not Util.IsFinite(total) then
		return nil
	end
	local random: any = rng or Random.new()
	local roll = random:NextNumber() * total
	for _, item in ipairs(list) do
		local w = weight(item)
		if w > 0 then
			roll -= w
			if roll <= 0 then
				return item
			end
		end
	end
	-- Rundungsfehler: letzter Eintrag mit Gewicht > 0
	return lastPositive
end

-- ---------------------------------------------------------------------
-- 5) SPAM-BREMSEN
-- ---------------------------------------------------------------------

-- Gleitendes Fenster pro Schlüssel (meist der Player): höchstens maxCalls in perSeconds.
-- PlayerRemoving: limiter.Clear(player) (sonst hält die Tabelle den Player fest)
function Util.RateLimiter(maxCalls: number, perSeconds: number, clock: (() -> number)?): RateLimiter
	local limit = math.max(1, math.floor(if Util.IsFinite(maxCalls) then maxCalls else 1))
	local window = if Util.IsFinite(perSeconds) then math.max(0, perSeconds) else 1
	local now: () -> number = clock or os.clock
	local buckets: { [any]: { number } } = {}

	local limiter = {}
	function limiter.Check(key: any): boolean
		local t = now()
		local bucket = buckets[key]
		if not bucket then
			bucket = {}
			buckets[key] = bucket
		end
		-- alte Einträge vorne entfernen (höchstens #bucket <= limit Durchläufe)
		while bucket[1] ~= nil and t - bucket[1] >= window do
			table.remove(bucket, 1)
		end
		if #bucket >= limit then
			return false
		end
		table.insert(bucket, t)
		return true
	end
	function limiter.Clear(key: any)
		buckets[key] = nil
	end
	return limiter
end

-- Token-Eimer pro Schlüssel: startet voll (capacity), füllt refillPerSecond Marken pro Sekunde nach.
-- Take(key, n) nimmt n Marken (Standard 1), wenn genug da sind.
function Util.TokenBucket(capacity: number, refillPerSecond: number, clock: (() -> number)?): TokenBucket
	local cap = if Util.IsFinite(capacity) then math.max(0, capacity) else 1
	local rate = if Util.IsFinite(refillPerSecond) then math.max(0, refillPerSecond) else 0
	local now: () -> number = clock or os.clock
	local tokens: { [any]: number } = {}
	local stamps: { [any]: number } = {}

	local bucket = {}
	function bucket.Take(key: any, n: number?): boolean
		local amount = if n == nil then 1 else n
		if not Util.IsFinite(amount) or amount < 0 then
			return false
		end
		local t = now()
		local have = tokens[key]
		if have == nil then
			have = cap
		else
			local elapsed = math.max(0, t - (stamps[key] or t))
			have = math.min(cap, have + elapsed * rate)
		end
		stamps[key] = t
		if have >= amount then
			tokens[key] = have - amount
			return true
		end
		tokens[key] = have
		return false
	end
	function bucket.Clear(key: any)
		tokens[key] = nil
		stamps[key] = nil
	end
	return bucket
end

-- ---------------------------------------------------------------------
-- 6) DATUM (UTC) – Tages-/Wochenindex für Quests, Login, Bestenlisten
-- ---------------------------------------------------------------------
local dayOffset = 0 -- nur Debug (Studio, Admin "SkipDay")

-- Tage seit 1970-01-01 -> (Jahr, Monat, Tag) (Algorithmus von H. Hinnant, ohne os.date)
local function civilFromDays(days: number): (number, number, number)
	local z = days + 719468
	local era = math.floor(z / 146097)
	local doe = z - era * 146097
	local yoe = math.floor((doe - math.floor(doe / 1460) + math.floor(doe / 36524) - math.floor(doe / 146096)) / 365)
	local doy = doe - (365 * yoe + math.floor(yoe / 4) - math.floor(yoe / 100))
	local mp = math.floor((5 * doy + 2) / 153)
	local d = doy - math.floor((153 * mp + 2) / 5) + 1
	local m = if mp < 10 then mp + 3 else mp - 9
	local y = yoe + era * 400 + (if m <= 2 then 1 else 0)
	return y, m, d
end

-- (Jahr, Monat, Tag) -> Tage seit 1970-01-01
local function daysFromCivil(year: number, month: number, day: number): number
	local y = year - (if month <= 2 then 1 else 0)
	local era = math.floor(y / 400)
	local yoe = y - era * 400
	local mp = (month + 9) % 12
	local doy = math.floor((153 * mp + 2) / 5) + day - 1
	local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
	return era * 146097 + doe - 719468
end

-- UTC-Tagesindex: floor(os.time() / 86400) + DayOffset. UtcDay(0) == 0 (ohne Offset).
function Util.UtcDay(now: number?): number
	local t = if Util.IsFinite(now) then now :: number else os.time()
	return math.floor(t / 86400) + dayOffset
end

-- ISO-Woche als Zahl JJJJWW (Montag = Wochenstart, Woche 1 enthält den ersten Donnerstag).
-- Beispiel: 2026-10-11 -> 202641. Der Debug-Tagesversatz zählt mit.
function Util.IsoWeek(now: number?): number
	local day = Util.UtcDay(now)
	local weekday = ((day + 3) % 7) + 1 -- 1 = Montag … 7 = Sonntag (1970-01-01 war ein Donnerstag)
	local thursday = day - weekday + 4
	local year = civilFromDays(thursday)
	local week = math.floor((thursday - daysFromCivil(year, 1, 1)) / 7) + 1
	return year * 100 + week
end

-- Nur Debug (Studio): verschiebt UtcDay/IsoWeek um n Tage (geklemmt auf ±10 Jahre)
function Util.SetDayOffset(n: number)
	if Util.IsFinite(n) then
		dayOffset = math.clamp(math.floor(n), -3650, 3650)
	end
end

function Util.GetDayOffset(): number
	return dayOffset
end

-- ---------------------------------------------------------------------
-- 7) HASH – deterministisch (z. B. Shard = Util.Hash(game.JobId) % 8)
-- ---------------------------------------------------------------------

-- FNV-1a 32 Bit, auf 0..2^31-1 begrenzt
function Util.Hash(s: string): number
	local text = if type(s) == "string" then s else tostring(s)
	local h = 2166136261
	for i = 1, #text do
		h = bit32.bxor(h, string.byte(text, i))
		-- h * 16777619 mod 2^32 ohne Genauigkeitsverlust: 16777619 = 2^24 + 403
		h = (bit32.lshift(h, 24) + h * 403) % 4294967296
	end
	return bit32.band(h, 0x7FFFFFFF)
end

return Util
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">WeaponModels</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Waffen-Modelle aus Parts (Shared/WeaponModels)
--  Besitzer: WP4 (Kampf Client). Vertrag: DESIGN.md B11.8, B19 (Skins), C6.3.
--  Keine hochgeladenen Assets: jede Waffe und jeder Skin ist ein REZEPT aus Parts
--  (Block/Cylinder/Ball/Wedge/CornerWedge/SpecialMesh Sphere+Cylinder). Spielzeug-Blaster
--  mit ORANGER SPITZE (Rolle "Tip", immer 255,120,0 Neon – Wraps ändern sie nie).
--  Gleiches Rezept für Viewmodel (Skala 1.0), 3rd Person (Skala 0.8) und Shop/Locker-Vorschau.
--
--  Öffentliche API:
--    WeaponModels.Build(key, opts?): Model
--        key  = Waffen-Key (Config.Weapons) ODER Skin-Id (S_…); unbekannt -> Ersatz-Blaster
--        opts = { Skin: string?, Scale: number?, Viewmodel: boolean? }
--        Ergebnis: Model (Name = Waffen-Key, Attribute WeaponKey/Skin/Recipe), PrimaryPart = erster Body-Teil,
--        WorldPivot = Griff (Grip). Attachments Grip/Muzzle/Sight/Charm/Support im PrimaryPart,
--        ein Teil heißt "Mag", jeder Teil hat das Attribut "Role". Alle Teile:
--        CanQuery/CanTouch/CanCollide = false, Massless, CastShadow = false.
--        Viewmodel = true -> alle Teile verankert, KEINE Schweißungen (Viewmodel setzt CFrames selbst);
--        sonst unverankert, per WeldConstraint an den PrimaryPart geschweißt (zum Anschweißen an die Hand).
--    WeaponModels.HasRecipe(key): boolean        Waffen-Keys, Admin-Waffen und Skin-Ids
--    WeaponModels.Recipes: { [key]: { PartSpec } }   Teile-Listen { Shape, Size, Offset, Role, Material?, Name?, Color?, Transparency? }
--    WeaponModels.Specs:   { [key]: { Base, Palette, Points, Emitters? } }   Farben je Rolle + Punkte
--    WeaponModels.SkinBase(id): string?           Waffe eines Skins (nil = kein Skin)
--    WeaponModels.TipColor                         Color3.fromRGB(255, 120, 0)
--  Koordinaten im Rezept: Ursprung = Handfläche am Griff, vorne = −Z, oben = +Y (Studs bei Skala 1).
-- =====================================================================

local WeaponModels = {}

export type PartSpec = {
	Shape: string,
	Size: Vector3,
	Offset: CFrame,
	Role: string,
	Material: string?,
	Name: string?,
	Color: Color3?,
	Transparency: number?,
}
export type EmitterSpec = { At: CFrame, Color: Color3, Rate: number, Size: number }
export type RecipeSpec = {
	Base: string,
	Palette: { [string]: Color3 },
	Points: { [string]: CFrame },
	Emitters: { EmitterSpec }?,
}
export type BuildOpts = { Skin: string?, Scale: number?, Viewmodel: boolean? }

WeaponModels.TipColor = Color3.fromRGB(255, 120, 0)
WeaponModels.Recipes = {} :: { [string]: { PartSpec } }
WeaponModels.Specs = {} :: { [string]: RecipeSpec }

local Recipes = WeaponModels.Recipes
local Specs = WeaponModels.Specs

local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local MAX_PARTS = 30

-- ---------------------------------------------------------------------
-- 1) REZEPT-HELFER (kurze Schreibweise)
-- ---------------------------------------------------------------------
local rad = math.rad
local v3 = Vector3.new
local rgb = Color3.fromRGB

local function at(x: number, y: number, z: number, rx: number?, ry: number?, rz: number?): CFrame
	return CFrame.new(x, y, z) * CFrame.Angles(rad(rx or 0), rad(ry or 0), rad(rz or 0))
end

type Extra = { M: string?, N: string?, C: Color3?, T: number? }

local function spec(shape: string, role: string, size: Vector3, offset: CFrame, extra: Extra?): PartSpec
	local e: Extra = extra or {}
	return {
		Shape = shape,
		Size = size,
		Offset = offset,
		Role = role,
		Material = e.M,
		Name = e.N,
		Color = e.C,
		Transparency = e.T,
	}
end

local AXIS_Z = CFrame.Angles(0, rad(90), 0) -- Zylinder-Achse (X) zeigt nach Z
local AXIS_Y = CFrame.Angles(0, 0, rad(90)) -- Zylinder-Achse (X) zeigt nach Y

local function blk(role: string, size: Vector3, offset: CFrame, extra: Extra?): PartSpec
	return spec("Block", role, size, offset, extra)
end
-- Zylinder entlang Z (Läufe, Rohre): Durchmesser d, Länge len
local function cylZ(role: string, d: number, len: number, offset: CFrame, extra: Extra?): PartSpec
	return spec("Cylinder", role, v3(len, d, d), offset * AXIS_Z, extra)
end
-- Zylinder entlang Y (Griffe, Klingen)
local function cylY(role: string, d: number, len: number, offset: CFrame, extra: Extra?): PartSpec
	return spec("Cylinder", role, v3(len, d, d), offset * AXIS_Y, extra)
end
-- Zylinder entlang X (Querbolzen)
local function cylX(role: string, d: number, len: number, offset: CFrame, extra: Extra?): PartSpec
	return spec("Cylinder", role, v3(len, d, d), offset, extra)
end
local function ball(role: string, d: number, offset: CFrame, extra: Extra?): PartSpec
	return spec("Ball", role, v3(d, d, d), offset, extra)
end
-- Ellipsoid (SpecialMesh Sphere, Größe = Part-Größe)
local function ell(role: string, size: Vector3, offset: CFrame, extra: Extra?): PartSpec
	return spec("MeshSphere", role, size, offset, extra)
end
-- weicher Zylinder (SpecialMesh Cylinder, Achse = lokales Y)
local function mcyl(role: string, size: Vector3, offset: CFrame, extra: Extra?): PartSpec
	return spec("MeshCylinder", role, size, offset, extra)
end
-- Keil: hohe Kante hinten (+Z), Schräge fällt nach vorne (−Z)
local function wedge(role: string, size: Vector3, offset: CFrame, extra: Extra?): PartSpec
	return spec("Wedge", role, size, offset, extra)
end
local function corner(role: string, size: Vector3, offset: CFrame, extra: Extra?): PartSpec
	return spec("CornerWedge", role, size, offset, extra)
end

local function pal(body: Color3, detail: Color3, accent: Color3, metal: Color3, grip: Color3): { [string]: Color3 }
	return { Body = body, Detail = detail, Accent = accent, Metal = metal, Grip = grip }
end

local function points(
	muzzle: CFrame,
	sight: CFrame,
	charm: CFrame,
	support: CFrame,
	grip: CFrame?
): { [string]: CFrame }
	return { Grip = grip or CFrame.identity, Muzzle = muzzle, Sight = sight, Charm = charm, Support = support }
end

local function define(
	key: string,
	base: string,
	palette: { [string]: Color3 },
	pts: { [string]: CFrame },
	parts: { PartSpec },
	emitters: { EmitterSpec }?
)
	assert(Recipes[key] == nil, "[WeaponModels] Doppeltes Rezept: " .. key)
	assert(#parts <= MAX_PARTS, "[WeaponModels] Zu viele Teile: " .. key)
	Recipes[key] = parts
	Specs[key] = { Base = base, Palette = palette, Points = pts, Emitters = emitters }
end

-- Skin: Punkte der Basis-Waffe übernehmen, einzelne überschreiben (gleiche Attachments -> gleiche Animationen)
local function skinPoints(base: string, overrides: { [string]: CFrame }?): { [string]: CFrame }
	local result: { [string]: CFrame } = {}
	local baseSpec = Specs[base]
	if baseSpec then
		for name, cf in pairs(baseSpec.Points) do
			result[name] = cf
		end
	end
	if overrides then
		for name, cf in pairs(overrides) do
			result[name] = cf
		end
	end
	return result
end

-- Farben (A4: Pastell-Plastik + Neon-Kanten)
local CREAM = rgb(244, 235, 221)
local MINT = rgb(154, 209, 212)
local PINK = rgb(247, 183, 200)
local LILAC = rgb(185, 167, 242)
local SAND = rgb(242, 213, 154)
local CHARCOAL = rgb(43, 43, 51)
local NAVY = rgb(28, 32, 64)
local WHITE = rgb(235, 238, 245)
local SILVER = rgb(196, 202, 214)
local WOOD = rgb(156, 106, 66)

-- =====================================================================
-- 2) PRIMÄRWAFFEN (B11.2)
-- =====================================================================

-- 1 PopRifle – Pop-Gewehr (Beispiel aus B11.8)
define(
