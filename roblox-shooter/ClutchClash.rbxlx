-- 7) EXKLUSIV – Pass-Items: während ihrer Saison (Id) nur über den Pass,
--    nicht im Katalog/in Kisten. Ab der nächsten Saison im Katalog.
-- ---------------------------------------------------------------------
Cosmetics.Exclusive = {
	S_PipPistol_RayGun = 1,
	S_PopRifle_CarrotCannon = 1,
	W_S1_Neon = 1,
	W_S1_Sunset = 1,
	W_S1_Ice = 1,
	W_S1_Gold = 1,
	W_S1_Circuit = 1,
	W_S1_Champion = 1,
	C_Ghost = 1,
	C_Crown = 1,
	C_Cactus = 1,
	C_Trophy = 1,
	F_BalloonFloat = 1,
	F_RainbowPuff = 1,
	T_Zigzag = 1,
	T_Rainbow = 1,
}

-- =====================================================================
-- 8) NACHSCHLAGEN – ById mit Kind und Id (doppelte Ids = Fehler beim Laden)
-- =====================================================================
Cosmetics.ById = {} :: { [string]: any }

local KIND_TABLES = {
	{ Kind = "Wrap", List = Cosmetics.Wraps },
	{ Kind = "Skin", List = Cosmetics.Skins },
	{ Kind = "Charm", List = Cosmetics.Charms },
	{ Kind = "Finisher", List = Cosmetics.Finishers },
	{ Kind = "Tracer", List = Cosmetics.Tracers },
	{ Kind = "Title", List = Cosmetics.Titles },
}

for _, entry in ipairs(KIND_TABLES) do
	for id, def in pairs(entry.List :: { [string]: any }) do
		assert(Cosmetics.ById[id] == nil, "[Config.Cosmetics] Doppelte Kosmetik-Id: " .. id)
		def.Id = id
		def.Kind = entry.Kind
		Cosmetics.ById[id] = def
	end
end

function Cosmetics.Get(id: string): any
	if type(id) ~= "string" then
		return nil
	end
	return Cosmetics.ById[id]
end

-- Pass-Item, dessen Saison noch läuft (oder noch nicht vorbei ist)? -> nicht im Katalog/Splitter-Shop
function Cosmetics.IsExclusive(id: string, seasonId: number): boolean
	local season = Cosmetics.Exclusive[id]
	if season == nil then
		return false
	end
	return (tonumber(seasonId) or 1) <= season
end

-- Anim als Liste (Config erlaubt Text oder Liste)
function Cosmetics.AnimList(def: any): { string }
	local anim = def and def.Anim
	if type(anim) == "string" then
		return { anim }
	elseif type(anim) == "table" then
		return anim
	end
	return {}
end

-- =====================================================================
-- 9) PRÜFEN (Config.Validate sammelt das; leere Liste = alles ok)
-- =====================================================================
local SOURCES = {
	Catalog = true,
	Coins = true,
	Pass = true,
	VIP = true,
	Starter = true,
	Mastery = true,
	Login = true,
	Default = true,
	Earned = true,
}

local function checkName(errors: { string }, path: string, name: any)
	if type(name) ~= "table" or type(name.de) ~= "string" or type(name.en) ~= "string" then
		table.insert(errors, path .. ".Name: { de, en } erwartet")
	elseif name.de == "" or name.en == "" then
		table.insert(errors, path .. ".Name: leerer Text")
	end
end

function Cosmetics.Validate(Config: any): { string }
	local errors: { string } = {}
	local weaponSet: { [string]: boolean } = {}
	for _, key in ipairs(Cosmetics.WeaponKeys) do
		weaponSet[key] = true
	end
	for _, entry in ipairs(KIND_TABLES) do
		for id, def in pairs(entry.List :: { [string]: any }) do
			local path = ("Config.Cosmetics.%ss.%s"):format(entry.Kind, id)
			checkName(errors, path, def.Name)
			if not SOURCES[def.Source] then
				table.insert(errors, path .. ".Source: unbekannte Quelle " .. tostring(def.Source))
			end
			if entry.Kind ~= "Title" and Cosmetics.RarityRank[def.Rarity] == nil then
				table.insert(errors, path .. ".Rarity: Common/Rare/Epic/Legendary/Mythic erwartet")
			end
			if def.Price ~= nil then
				local coins = type(def.Price) == "table" and def.Price.Coins
				if type(coins) ~= "number" or coins <= 0 or coins % 1 ~= 0 then
					table.insert(errors, path .. ".Price: { Coins = ganze Zahl > 0 } oder nil erwartet")
				end
			end
		end
	end
	-- Wraps: Rollen + Material (nie Ice) + Anim
	for id, def in pairs(Cosmetics.Wraps :: { [string]: any }) do
		local path = "Config.Cosmetics.Wraps." .. id
		for _, role in ipairs(Cosmetics.WrapRoles) do
			local r = def.Roles and def.Roles[role]
			if type(r) ~= "table" or typeof(r.Color) ~= "Color3" then
				table.insert(errors, ("%s.Roles.%s: { Color = Color3, Material } erwartet"):format(path, role))
			elseif not Cosmetics.Materials[r.Material] then
				table.insert(
					errors,
					("%s.Roles.%s.Material: nicht erlaubt (%s)"):format(path, role, tostring(r.Material))
				)
			end
		end
		if def.Roles and def.Roles.Tip ~= nil then
			table.insert(errors, path .. ".Roles.Tip: die orange Spitze darf kein Wrap verändern")
		end
		for _, anim in ipairs(Cosmetics.AnimList(def)) do
			if not Cosmetics.Anims[anim] then
				table.insert(errors, path .. ".Anim: unbekannt " .. tostring(anim))
			end
		end
		if def.Source == "Mastery" and (type(def.MasteryTier) ~= "number" or def.MasteryTier < 1) then
			table.insert(errors, path .. ".MasteryTier: Zahl ≥ 1 erwartet")
		end
	end
	-- Skins: Waffe muss existieren (+ Rezept in WeaponModels, falls schon vorhanden)
	local weaponModels: any = nil
	local ok, shared = pcall(function()
		return script.Parent.Parent
	end)
	if ok and typeof(shared) == "Instance" then
		local module = shared:FindFirstChild("WeaponModels")
		if module and module:IsA("ModuleScript") then
			local loaded, result = pcall(require, module)
			if loaded and type(result) == "table" then
				weaponModels = result
			end
		end
	end
	for id, def in pairs(Cosmetics.Skins :: { [string]: any }) do
		local path = "Config.Cosmetics.Skins." .. id
		if not weaponSet[def.Weapon] then
			table.insert(errors, path .. ".Weapon: unbekannte Waffe " .. tostring(def.Weapon))
		elseif Config and type(Config.Weapon) == "function" and type(Config.Weapons) == "table" then
			if type(Config.Weapons.List) == "table" and Config.Weapon(def.Weapon) == nil then
				table.insert(errors, path .. ".Weapon: fehlt in Config.Weapons")
			end
		end
		if weaponModels and type(weaponModels.HasRecipe) == "function" then
			local has, result = pcall(weaponModels.HasRecipe, def.Recipe)
			if has and result ~= true then
				table.insert(errors, path .. ".Recipe: kein Rezept in WeaponModels (" .. tostring(def.Recipe) .. ")")
			end
		end
	end
	-- Tracer: Helligkeit ≥ 0.5, Breiten > 0
	for id, def in pairs(Cosmetics.Tracers :: { [string]: any }) do
		local path = "Config.Cosmetics.Tracers." .. id
		if typeof(def.Color) == "Color3" then
			local _, _, v = def.Color:ToHSV()
			if v < 0.5 then
				table.insert(errors, path .. ".Color: Helligkeit ≥ 0.5 erwartet")
			end
		elseif def.Color ~= "Team" and def.Color ~= "Rainbow" then
			table.insert(errors, path .. '.Color: Color3, "Team" oder "Rainbow" erwartet')
		end
		if type(def.Width0) ~= "number" or type(def.Width1) ~= "number" or def.Width0 <= 0 or def.Width1 <= 0 then
			table.insert(errors, path .. ".Width0/Width1: Zahlen > 0 erwartet")
		end
		if def.Texture ~= "" and def.Texture ~= GRADIENT then
			table.insert(errors, path .. '.Texture: nur gradient.png oder "" (ASSETS.md)')
		end
	end
	-- Exklusiv: nur Pass-Items, Saison-Id ≥ 1
	for id, season in pairs(Cosmetics.Exclusive :: { [string]: number }) do
		local def = Cosmetics.ById[id]
		if def == nil then
			table.insert(errors, "Config.Cosmetics.Exclusive." .. id .. ": unbekannte Id")
		elseif def.Source ~= "Pass" then
			table.insert(errors, "Config.Cosmetics.Exclusive." .. id .. ": nur Pass-Items sind exklusiv")
		end
		if type(season) ~= "number" or season < 1 then
			table.insert(errors, "Config.Cosmetics.Exclusive." .. id .. ": Saison-Id ≥ 1 erwartet")
		end
	end
	for id, def in pairs(Cosmetics.ById) do
		if def.Source == "Pass" and def.Kind ~= "Title" and Cosmetics.Exclusive[id] == nil then
			table.insert(errors, "Config.Cosmetics: Pass-Item " .. id .. " fehlt in Exclusive")
		end
	end
	-- Standard-Items vorhanden
	for kind, id in pairs(Cosmetics.Defaults) do
		local def = Cosmetics.ById[id]
		if def == nil or def.Kind ~= kind then
			table.insert(errors, ("Config.Cosmetics.Defaults.%s: %s fehlt"):format(kind, tostring(id)))
		end
	end
	return errors
end

return Cosmetics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Maps</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Maps & Licht-Stimmungen (Shared/Config/Maps)
--  Besitzer: WP2 (Welt). Vertrag: DESIGN.md C15 (Config/Maps), B8.1–B8.3, B9.
--  Erreichbar als Config.Maps (wird von Config/init dynamisch geladen).
--
--  Inhalt:
--    Maps         = 6 Arenen + Crown Ring: Name {de,en}, Größenklasse, Teamgrößen, Modi,
--                   Stimmungs-Gewichte (oder ForcedMood), Teilebudget
--    Moods        = 5 Licht-Stimmungen (B8.2) – NUR client-lokal (ArenaLook), die Lobby nutzt LobbyMood
--    LobbyMood, StagingOrigin (Template-Bau), CrownOrigin (Crown Ring in der Lobby), Nav (Nav-Graph)
--    Validate(Config): { string }   Fehlertexte mit exaktem Pfad (leere Liste = alles ok)
--
--  Ändern ohne Code: Gewichte/Stimmungen/Budgets hier anpassen. Die Map-GEOMETRIE steht in
--  src/server/World/Maps/<Key>.luau.
-- =====================================================================

export type MoodDef = {
	ClockTime: number,
	Ambient: Color3,
	OutdoorAmbient: Color3,
	Atmosphere: {
		Density: number,
		Haze: number,
		Color: Color3,
		Decay: Color3,
		Glare: number,
		Offset: number,
	},
	Bloom: { Intensity: number, Size: number, Threshold: number },
	ColorCorrection: { Saturation: number, Contrast: number, Brightness: number, TintColor: Color3 },
	Snow: boolean,
}

export type MapDef = {
	Name: { de: string, en: string },
	Class: "S" | "M" | "L",
	TeamSizes: { number },
	Modes: { string },
	Moods: { [string]: number }?,
	ForcedMood: string?,
	Fixed: boolean?,
	PartBudget: number,
}

local WHITE = Color3.fromRGB(255, 255, 255)

local Maps = {}

-- ---------------------------------------------------------------------
-- 1) ARENEN (B8.3) – Modi/Teamgrößen bestimmen, welche Karten im Vote erscheinen
-- ---------------------------------------------------------------------
local MAPS: { [string]: MapDef } = {
	PillarBox = {
		Name = { de = "Säulenkiste", en = "Pillar Box" },
		Class = "S",
		TeamSizes = { 1, 2 },
		Modes = { "Duel1", "Duel2", "Mutator", "Practice" },
		Moods = { Day = 40, Sunset = 30, NeonNight = 15, Fog = 15 },
		PartBudget = 700,
	},
	BlockYard = {
		Name = { de = "Bauklotz-Hof", en = "Block Yard" },
		Class = "M",
		TeamSizes = { 1, 2, 3, 4 },
		Modes = { "Duel1", "Duel2", "Duel3", "Duel4", "Mutator", "Practice", "FFA" },
		Moods = { Day = 45, Sunset = 35, Fog = 20 },
		PartBudget = 900,
	},
	NeonGrid = {
		Name = { de = "Neon-Raster", en = "Neon Grid" },
		Class = "S",
		TeamSizes = { 1, 2 },
		Modes = { "Duel1", "Duel2", "Mutator", "Practice", "FFA" },
		ForcedMood = "NeonNight",
		PartBudget = 700,
	},
	CandyDocks = {
		Name = { de = "Zuckerhafen", en = "Candy Docks" },
		Class = "L",
		TeamSizes = { 2, 3, 4 },
		Modes = { "Duel2", "Duel3", "Duel4", "FFA" },
		Moods = { Day = 40, Sunset = 35, Fog = 25 },
		PartBudget = 1100,
	},
	SnowFort = {
		Name = { de = "Schneefestung", en = "Snow Fort" },
		Class = "M",
		TeamSizes = { 2, 3, 4 },
		Modes = { "Duel2", "Duel3", "Duel4" },
		ForcedMood = "Snowy",
		PartBudget = 900,
	},
	SkyGarden = {
		Name = { de = "Himmelsgarten", en = "Sky Garden" },
		Class = "M",
		TeamSizes = { 1, 2, 3 },
		Modes = { "Duel1", "Duel2", "Duel3", "Mutator", "Practice", "FFA" },
		Moods = { Day = 45, Sunset = 35, NeonNight = 20 },
		PartBudget = 800,
	},
	CrownRing = {
		Name = { de = "Kronen-Ring", en = "Crown Ring" },
		Class = "S",
		TeamSizes = { 1 },
		Modes = { "Crown" },
		Fixed = true, -- fest in der Lobby (Slot 0), nie im Vote, nie in Slot 1..8
		PartBudget = 400,
	},
}
Maps.Maps = MAPS

-- ---------------------------------------------------------------------
-- 2) LICHT-STIMMUNGEN (B8.2) – Werte 1:1 aus der Tabelle.
--    Atmosphere-Dichte immer ≥ 0.32 (fremde Welten verschwinden im Dunst, B9.4).
-- ---------------------------------------------------------------------
local MOODS: { [string]: MoodDef } = {
	Day = {
		ClockTime = 14,
		Ambient = Color3.fromRGB(140, 140, 150),
		OutdoorAmbient = Color3.fromRGB(150, 150, 160),
		Atmosphere = {
			Density = 0.32,
			Haze = 1.0,
			Color = Color3.fromRGB(199, 210, 230),
			Decay = Color3.fromRGB(106, 112, 125),
			Glare = 0,
			Offset = 0.25,
		},
		Bloom = { Intensity = 0.5, Size = 24, Threshold = 1.6 },
		ColorCorrection = { Saturation = 0.15, Contrast = 0.05, Brightness = 0, TintColor = WHITE },
		Snow = false,
	},
	Sunset = {
		ClockTime = 17.6,
		Ambient = Color3.fromRGB(170, 120, 100),
		OutdoorAmbient = Color3.fromRGB(190, 130, 110),
		Atmosphere = {
			Density = 0.35,
			Haze = 1.5,
			Color = Color3.fromRGB(255, 190, 150),
			Decay = Color3.fromRGB(190, 110, 90),
			Glare = 0,
			Offset = 0.25,
		},
		Bloom = { Intensity = 0.6, Size = 24, Threshold = 1.5 },
		ColorCorrection = {
			Saturation = 0.2,
			Contrast = 0,
			Brightness = 0,
			TintColor = Color3.fromRGB(255, 235, 215),
		},
		Snow = false,
	},
	NeonNight = {
		ClockTime = 0.5,
		Ambient = Color3.fromRGB(60, 60, 90),
		OutdoorAmbient = Color3.fromRGB(40, 40, 70),
		Atmosphere = {
			Density = 0.32,
			Haze = 0.8,
			Color = Color3.fromRGB(60, 60, 120),
			Decay = Color3.fromRGB(40, 40, 90),
			Glare = 0,
			Offset = 0.25,
		},
		Bloom = { Intensity = 1.0, Size = 32, Threshold = 1.2 },
		ColorCorrection = { Saturation = 0.25, Contrast = 0, Brightness = 0, TintColor = WHITE },
		Snow = false,
	},
	Fog = {
		ClockTime = 12,
		Ambient = Color3.fromRGB(150, 150, 150),
		OutdoorAmbient = Color3.fromRGB(150, 150, 155),
		Atmosphere = {
			Density = 0.45,
			Haze = 2.5,
			Color = Color3.fromRGB(200, 200, 205),
			Decay = Color3.fromRGB(180, 180, 185),
			Glare = 0,
			Offset = 0.25,
		},
		Bloom = { Intensity = 0.3, Size = 24, Threshold = 1.8 },
		ColorCorrection = { Saturation = -0.1, Contrast = 0, Brightness = 0, TintColor = WHITE },
		Snow = false,
	},
	Snowy = {
		ClockTime = 13,
		Ambient = Color3.fromRGB(170, 180, 200),
		OutdoorAmbient = Color3.fromRGB(180, 190, 210),
		Atmosphere = {
			Density = 0.38,
			Haze = 1.5,
			Color = Color3.fromRGB(220, 230, 245),
			Decay = Color3.fromRGB(200, 210, 230),
			Glare = 0,
			Offset = 0.25,
		},
		Bloom = { Intensity = 0.4, Size = 24, Threshold = 1.6 },
		ColorCorrection = { Saturation = 0.05, Contrast = 0, Brightness = 0, TintColor = WHITE },
		Snow = true, -- Schnee-Emitter an der Kamera (smoke_main.dds, weiß, Size 0.15, Rate 60)
	},
}
Maps.Moods = MOODS

-- ---------------------------------------------------------------------
-- 3) WELT-KONSTANTEN
-- ---------------------------------------------------------------------
Maps.LobbyMood = "Day" -- Lobby, Range und Crown Ring
Maps.StagingOrigin = Vector3.new(0, 3000, 0) -- hier steht jede Map beim Boot kurz für Nav-Graph + Spawn-Prüfung
Maps.CrownOrigin = Vector3.new(95, -6, 0) -- Welt-Ursprung des Crown Rings (Grubenboden-Oberkante)
-- MaxNodes 400 statt 300 (C15): M-Maps brauchen bei Raster 6 inkl. Deckungs-/Zonen-/Brücken-Knoten ~310
Maps.Nav = { Grid = 6, Headroom = 5.5, StepMax = 4.5, MaxNodes = 400 }
Maps.DefaultKillY = -40 -- lokal unter der Map-Oberkante (gilt, wenn eine Map keine eigene KillY hat)
Maps.BarrierCeiling = 40 -- Decke der automatischen Barrieren (B8.1)
Maps.NeonShare = 0.08 -- Richtwert: höchstens ~8 % Neon-Teile pro Map (A4)

-- ---------------------------------------------------------------------
-- 4) PRÜFEN (Config.Validate sammelt das ein)
-- ---------------------------------------------------------------------
local CLASSES = { S = true, M = true, L = true }

local function isFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function checkColor(errors: { string }, path: string, value: any)
	if typeof(value) ~= "Color3" then
		table.insert(errors, path .. ": Color3 erwartet")
	end
end

local function checkNumber(errors: { string }, path: string, value: any, lo: number?, hi: number?)
	if not isFinite(value) then
		table.insert(errors, path .. ": Zahl erwartet")
		return
	end
	if lo ~= nil and value < lo then
		table.insert(errors, ("%s: mindestens %s erwartet"):format(path, tostring(lo)))
	end
	if hi ~= nil and value > hi then
		table.insert(errors, ("%s: höchstens %s erwartet"):format(path, tostring(hi)))
	end
end

local function validateMood(errors: { string }, key: string, mood: any)
	local path = "Config.Maps.Moods." .. key
	if type(mood) ~= "table" then
		table.insert(errors, path .. ": Tabelle erwartet")
		return
	end
	checkNumber(errors, path .. ".ClockTime", mood.ClockTime, 0, 24)
	checkColor(errors, path .. ".Ambient", mood.Ambient)
	checkColor(errors, path .. ".OutdoorAmbient", mood.OutdoorAmbient)
	local atmo = mood.Atmosphere
	if type(atmo) ~= "table" then
		table.insert(errors, path .. ".Atmosphere: Tabelle erwartet")
	else
		-- B9.4: Dichte ≥ 0.32 in ALLEN Stimmungen (sonst sieht man fremde Arenen)
		checkNumber(errors, path .. ".Atmosphere.Density", atmo.Density, 0.32, 1)
		checkNumber(errors, path .. ".Atmosphere.Haze", atmo.Haze, 0, 10)
		checkNumber(errors, path .. ".Atmosphere.Glare", atmo.Glare, 0, 10)
		checkNumber(errors, path .. ".Atmosphere.Offset", atmo.Offset, 0, 1)
		checkColor(errors, path .. ".Atmosphere.Color", atmo.Color)
		checkColor(errors, path .. ".Atmosphere.Decay", atmo.Decay)
	end
	local bloom = mood.Bloom
	if type(bloom) ~= "table" then
		table.insert(errors, path .. ".Bloom: Tabelle erwartet")
	else
		checkNumber(errors, path .. ".Bloom.Intensity", bloom.Intensity, 0, 5)
		checkNumber(errors, path .. ".Bloom.Size", bloom.Size, 0, 56)
		checkNumber(errors, path .. ".Bloom.Threshold", bloom.Threshold, 0, 4)
	end
	local cc = mood.ColorCorrection
	if type(cc) ~= "table" then
		table.insert(errors, path .. ".ColorCorrection: Tabelle erwartet")
	else
		checkNumber(errors, path .. ".ColorCorrection.Saturation", cc.Saturation, -1, 1)
		checkNumber(errors, path .. ".ColorCorrection.Contrast", cc.Contrast, -1, 1)
		checkNumber(errors, path .. ".ColorCorrection.Brightness", cc.Brightness, -1, 1)
		checkColor(errors, path .. ".ColorCorrection.TintColor", cc.TintColor)
	end
	if type(mood.Snow) ~= "boolean" then
		table.insert(errors, path .. ".Snow: true/false erwartet")
	end
end

local function validateMap(errors: { string }, key: string, map: any, knownModes: { [string]: any }?)
	local path = "Config.Maps.Maps." .. key
	if type(map) ~= "table" then
		table.insert(errors, path .. ": Tabelle erwartet")
		return
	end
	if type(map.Name) ~= "table" or type(map.Name.de) ~= "string" or type(map.Name.en) ~= "string" then
		table.insert(errors, path .. ".Name: { de, en } erwartet")
	end
	if not CLASSES[map.Class] then
		table.insert(errors, path .. '.Class: "S", "M" oder "L" erwartet')
	end
	if type(map.TeamSizes) ~= "table" or #map.TeamSizes == 0 then
		table.insert(errors, path .. ".TeamSizes: Liste erwartet")
	else
		for i, size in ipairs(map.TeamSizes) do
			if not isFinite(size) or size < 1 or size > 4 or size % 1 ~= 0 then
				table.insert(errors, ("%s.TeamSizes[%d]: ganze Zahl 1–4 erwartet"):format(path, i))
			end
		end
	end
	if type(map.Modes) ~= "table" or #map.Modes == 0 then
		table.insert(errors, path .. ".Modes: Liste erwartet")
	else
		for i, mode in ipairs(map.Modes) do
			if type(mode) ~= "string" then
				table.insert(errors, ("%s.Modes[%d]: Text erwartet"):format(path, i))
			elseif knownModes and knownModes[mode] == nil then
				table.insert(errors, ("%s.Modes[%d]: unbekannter Modus %s"):format(path, i, mode))
			end
		end
	end
	if map.ForcedMood ~= nil then
		if type(map.ForcedMood) ~= "string" or MOODS[map.ForcedMood] == nil then
			table.insert(errors, path .. ".ForcedMood: unbekannte Stimmung " .. tostring(map.ForcedMood))
		end
	elseif not map.Fixed then
		if type(map.Moods) ~= "table" then
			table.insert(errors, path .. ".Moods: Gewichte oder ForcedMood erwartet")
		else
			local total = 0
			for mood, weight in pairs(map.Moods) do
				if type(mood) ~= "string" or MOODS[mood] == nil then
					table.insert(errors, path .. ".Moods: unbekannte Stimmung " .. tostring(mood))
				elseif not isFinite(weight) or weight < 0 then
					table.insert(errors, path .. ".Moods." .. mood .. ": Gewicht ≥ 0 erwartet")
				else
					total += weight
				end
			end
			if total <= 0 then
				table.insert(errors, path .. ".Moods: Summe der Gewichte muss > 0 sein")
			end
		end
	end
	checkNumber(errors, path .. ".PartBudget", map.PartBudget, 50, 1100)
end

function Maps.Validate(Config: any): { string }
	local errors: { string } = {}
	local knownModes: { [string]: any }? = nil
	local modes = if type(Config) == "table" and type(Config.Modes) == "table" then Config.Modes.Modes else nil
	if type(modes) == "table" and next(modes) ~= nil then
		knownModes = modes
	end
	for key, map in pairs(MAPS) do
		validateMap(errors, key, map, knownModes)
	end
	for key, mood in pairs(MOODS) do
		validateMood(errors, key, mood)
	end
	if MOODS[Maps.LobbyMood] == nil then
		table.insert(errors, "Config.Maps.LobbyMood: unbekannte Stimmung " .. tostring(Maps.LobbyMood))
	end
	local nav = Maps.Nav
	checkNumber(errors, "Config.Maps.Nav.Grid", nav.Grid, 2, 20)
	checkNumber(errors, "Config.Maps.Nav.Headroom", nav.Headroom, 3, 20)
	checkNumber(errors, "Config.Maps.Nav.StepMax", nav.StepMax, 0.5, 10)
	checkNumber(errors, "Config.Maps.Nav.MaxNodes", nav.MaxNodes, 20, 2000)
	checkNumber(errors, "Config.Maps.DefaultKillY", Maps.DefaultKillY, -200, -5)
	checkNumber(errors, "Config.Maps.BarrierCeiling", Maps.BarrierCeiling, 10, 200)
	checkNumber(errors, "Config.Maps.NeonShare", Maps.NeonShare, 0, 1)
	-- Vault (Ursprung − VaultDepth) und KillY müssen über FallenPartsDestroyHeight (−500) liegen
	local server = if type(Config) == "table" and type(Config.Server) == "table" then Config.Server else nil
	if server and isFinite(server.VaultDepth) and server.VaultDepth + 10 >= 500 then
		table.insert(errors, "Config.Server.VaultDepth: Vault muss über −500 liegen (FallenPartsDestroyHeight)")
	end
	return errors
end

return Maps
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Modes</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – MODI, MUTATOREN, MATCH-TIMER, WARTESCHLANGEN (Shared/Config/Modes)
--  Besitzer: WP5 (Match & Warteschlangen). Vertrag: DESIGN.md C15 (Config/Modes), B3–B7.
--  -> erreichbar als Config.Modes
--
--  Abschnitte:
--    1) Modes        – alle 8 Modi (B4): Teams, Regelwerk, Siegbedingung, Zeiten, Kartenwahl, Bots
--    2) Mutators     – 8 Mutatoren (B7) mit partiellen ContextRules
--    3) Rotation     – Tages-Mutator = Rotation[(Util.UtcDay() % #Rotation) + 1]
--    4) DefaultRules – Grund-Regeln jedes Match-Kontexts (Types.ContextRules)
--    5) Match        – Timer der Zustandsmaschine (B5/B6), AFK, Verlassen
--    6) Queue        – Pads, Matcher, Bot-Füllung, Neulings-Schutz, Krone (B3/B4)
--    7) Tutorial     – Tutorial-Duell (B1.1)
--    8) Skill        – Skill-Momente (DOUBLE/TRIPLE/QUAD, CLUTCH-Bonus-XP) aus docs/SKILL-WUENSCHE.md
--  Alle Zahlen sind Startwerte aus DESIGN.md – hier änderbar, ohne Code anzufassen.
--  Validate(Config): { string } prüft alles (SelfTest + Boot-warn).
-- =====================================================================

local Modes = {}

export type ModeDef = {
	Name: { de: string, en: string },
	Teams: number, -- 2 = Rundenmodus mit zwei Teams, 0 = jeder für sich (FFA)
	TeamSize: number,
	MaxPlayers: number?,
	Ruleset: "Rounds" | "Respawn",
	RoundsToWin: number?,
	RoundTime: number?,
	Overtime: number?,
	RoundCap: number?,
	Vote: boolean,
	Bots: boolean?,
	UsesMutator: boolean?,
	FixedMap: string?,
	AlwaysBot: boolean?,
	RandomMap: boolean?,
	Queue: boolean, -- über Pads/PLAY-Menü in eine virtuelle Schlange
	Order: number, -- Reihenfolge im PLAY-Menü
	Rewards: { XpMult: number, CoinMult: number, MasteryMult: number }?,
	ScoreToWin: number?,
	KillPoints: number?,
	AssistPoints: number?,
	MatchTime: number?,
	RespawnDelay: number?,
	FillTo: number?,
	DropInUntil: number?,
	MinPlayers: number?,
}

-- ---------------------------------------------------------------------
-- 1) MODI (B4) – Name, Teams, Regelwerk, Sieg, Rundenzeit, Overtime, Rundenlimit, Kartenwahl, Bots
--    RoundCap = 2 × RoundsToWin + 1 (B6.4)
-- ---------------------------------------------------------------------
local MODES: { [string]: ModeDef } = {
	Duel1 = {
		Name = { de = "Duell 1v1", en = "Duel 1v1" },
		Teams = 2,
		TeamSize = 1,
		Ruleset = "Rounds",
		RoundsToWin = 4,
		RoundTime = 60,
		Overtime = 15,
		RoundCap = 9,
		Vote = true,
		Bots = true,
		Queue = true,
		Order = 1,
	},
	Duel2 = {
		Name = { de = "Duell 2v2", en = "Duel 2v2" },
		Teams = 2,
		TeamSize = 2,
		Ruleset = "Rounds",
		RoundsToWin = 4,
		RoundTime = 75,
		Overtime = 15,
		RoundCap = 9,
		Vote = true,
		Bots = true,
		Queue = true,
		Order = 2,
	},
	Duel3 = {
		Name = { de = "Duell 3v3", en = "Duel 3v3" },
		Teams = 2,
		TeamSize = 3,
		Ruleset = "Rounds",
		RoundsToWin = 4,
		RoundTime = 90,
		Overtime = 15,
		RoundCap = 9,
		Vote = true,
		Bots = true,
		Queue = true,
		Order = 3,
	},
	Duel4 = {
		Name = { de = "Duell 4v4", en = "Duel 4v4" },
		Teams = 2,
		TeamSize = 4,
		Ruleset = "Rounds",
		RoundsToWin = 4,
		RoundTime = 90,
		Overtime = 15,
		RoundCap = 9,
		Vote = true,
		Bots = true,
		Queue = true,
		Order = 4,
	},
	Mutator = {
		Name = { de = "Mutator-Duell", en = "Mutator Duel" },
		Teams = 2,
		TeamSize = 1,
		Ruleset = "Rounds",
		RoundsToWin = 3,
		RoundTime = 50,
		Overtime = 15,
		RoundCap = 7,
		Vote = true,
		Bots = true,
		UsesMutator = true,
		Queue = true,
		Order = 5,
	},
	Crown = {
		Name = { de = "Kronen-Duell", en = "Crown Duel" },
		Teams = 2,
		TeamSize = 1,
		Ruleset = "Rounds",
		RoundsToWin = 2,
		RoundTime = 45,
		Overtime = 10,
		RoundCap = 5,
		Vote = false,
		Bots = true,
		FixedMap = "CrownRing",
		Queue = false, -- eigene Herausforderer-Linie (QueueService.CrownJoin)
		Order = 7,
	},
	Practice = {
		Name = { de = "Training gegen Bots", en = "Bot Practice" },
		Teams = 2,
		TeamSize = 1,
		Ruleset = "Rounds",
		RoundsToWin = 3,
		RoundTime = 60,
		Overtime = 15,
		RoundCap = 7,
		Vote = false,
		AlwaysBot = true,
		RandomMap = true, -- zufällige 1v1-Map
		Queue = false, -- startet sofort (Request "PracticeStart")
		Order = 8,
		Rewards = { XpMult = 0.3, CoinMult = 0, MasteryMult = 0.5 },
	},
	FFA = {
		Name = { de = "FFA-Brawl", en = "FFA Brawl" },
		Teams = 0,
		TeamSize = 1,
		MaxPlayers = 8,
		MinPlayers = 2,
		Ruleset = "Respawn",
		ScoreToWin = 25,
		KillPoints = 2,
		AssistPoints = 1,
		MatchTime = 300,
		RespawnDelay = 3,
		FillTo = 6,
		DropInUntil = 240, -- Drop-in nur in den ersten 4:00
		Vote = true,
		Bots = true,
		Queue = true,
		Order = 6,
	},
}
Modes.Modes = MODES

-- Reihenfolge der Modi (PLAY-Menü, Tests)
Modes.Order = { "Duel1", "Duel2", "Duel3", "Duel4", "Mutator", "FFA", "Crown", "Practice" }

-- ---------------------------------------------------------------------
-- 2) MUTATOREN (B7) – Rules = partielle ContextRules (überschreiben DefaultRules)
-- ---------------------------------------------------------------------
export type MutatorDef = {
	Name: { de: string, en: string },
	Desc: { de: string, en: string },
	Rules: { [string]: any },
}

local MUTATORS: { [string]: MutatorDef } = {
	MoonJump = {
		Name = { de = "Mondsprung", en = "Moon Jump" },
		Desc = { de = "Fast schwerelos – springe über alles!", en = "Almost weightless – jump over everything!" },
		Rules = { GravityLift = 0.55 },
	},
	HeadsOnly = {
		Name = { de = "Nur Kopftreffer", en = "Headshots Only" },
		Desc = {
			de = "Nur Kopftreffer machen Schaden. Nahkampf und Explosionen wirken normal.",
			en = "Only headshots deal damage. Melee and explosions work normally.",
		},
		Rules = { HeadOnly = true },
	},
	BigHeads = {
		Name = { de = "Großkopf", en = "Big Heads" },
		Desc = { de = "Riesige Köpfe – leichter zu treffen!", en = "Huge heads – easier to hit!" },
		Rules = { HeadRadiusMult = 1.6 },
	},
	Turbo = {
		Name = { de = "Turbo", en = "Turbo" },
		Desc = {
			de = "Schneller laufen, schneller schießen, schneller nachladen.",
			en = "Run faster, shoot faster, reload faster.",
		},
		Rules = { SpeedMult = 1.35, IntervalMult = 0.8, ReloadMult = 0.7 },
	},
	MeleeMayhem = {
		Name = { de = "Nahkampf-Chaos", en = "Melee Mayhem" },
		Desc = { de = "Nur Nahkampf und Utility – ran an den Gegner!", en = "Melee and utility only – get close!" },
		Rules = { AllowedSlots = { Melee = true, Utility = true }, SpeedMult = 1.2 },
	},
	SnipersOnly = {
		Name = { de = "Nur Scharfschützen", en = "Snipers Only" },
		Desc = { de = "Fernschuss für alle. Ein Treffer zählt!", en = "Longshots for everyone. Every hit counts!" },
		Rules = {
			ForcedLoadout = {
				Primary = "Longshot",
				Secondary = "HandCannon",
				Melee = "BoxingGloves",
				Utility = "SmokeBomb",
			},
			IgnoreOwnership = true,
		},
	},
	LuckyLoadout = {
		Name = { de = "Glücks-Loadout", en = "Lucky Loadout" },
		Desc = {
			de = "Jede Runde ein zufälliges Loadout – für beide Seiten gleich. Gratis-Probe!",
			en = "A random loadout every round – the same for both sides. Free trial!",
		},
		Rules = { RandomLoadout = true, IgnoreOwnership = true },
	},
	Instapop = {
		Name = { de = "Sofort-Pop", en = "Instapop" },
		Desc = {
			de = "Fünffacher Schaden – ein Treffer, ein Pop!",
			en = "Five times the damage – one hit, one pop!",
		},
		Rules = {
			ForcedLoadout = {
				Primary = "Longshot",
				Secondary = "PipPistol",
				Melee = "BoxingGloves",
				Utility = "PopGrenade",
			},
			DamageMult = 5,
			IgnoreOwnership = true,
		},
	},
}
Modes.Mutators = MUTATORS

-- ---------------------------------------------------------------------
-- 3) ROTATION – Tages-Mutator (Admin-Override lokal oder global möglich)
-- ---------------------------------------------------------------------
Modes.Rotation =
	{ "MoonJump", "HeadsOnly", "Turbo", "BigHeads", "MeleeMayhem", "SnipersOnly", "LuckyLoadout", "Instapop" }

-- ---------------------------------------------------------------------
-- 4) GRUND-REGELN jedes Match-Kontexts (Types.ContextRules)
--    Modus-Besonderheiten: FFA -> Regen + Utility-Abklingzeit, Practice/Tutorial -> jede Waffe erlaubt.
-- ---------------------------------------------------------------------
Modes.DefaultRules = {
	DamageMult = 1,
	HeadOnly = false,
	HeadRadiusMult = 1,
	IntervalMult = 1,
	ReloadMult = 1,
	SpeedMult = 1,
	GravityLift = 0,
	RandomLoadout = false,
	Regen = false,
	UtilityMode = "Charges",
	FriendlyFire = false,
	IgnoreOwnership = false,
}
Modes.ModeRules = {
	FFA = { Regen = true, UtilityMode = "Cooldown" },
	Practice = { IgnoreOwnership = true },
} :: { [string]: { [string]: any } }

-- ---------------------------------------------------------------------
-- 5) MATCH – Zustandsmaschine (B5/B6), AFK und Verlassen
-- ---------------------------------------------------------------------
Modes.Match = {
	VoteSeconds = 5, -- Kartenwahl (Spieler bleiben in der Lobby)
	BotVoteMin = 1, -- Bots stimmen nach 1–3 s zufällig
	BotVoteMax = 3,
	LoadTimeout = 4, -- weiter, wenn alle Menschen "ArenaReady" gesendet haben oder nach 4 s
	ArenaWait = 10, -- kein freier Slot beim Laden: so lange neu versuchen, dann abbrechen
	IntroSeconds = 2,
	FirstPrep = 4, -- Prep Runde 1 (und Rematch)
	Prep = 3, -- Prep ab Runde 2
	ReadyMinPrep = 1, -- alle Menschen "BEREIT" -> Prep endet nach ≥ 1 s
	RoundEnd = 2.5,
	Results = 10, -- Ergebnis-Bildschirm
	CrownResults = 4, -- Krone: kurzer Ergebnis-Bildschirm, damit der König schnell weiterkämpft
	ZoneRadius = 8,
	ZoneCapture = 3, -- 3 s halten = Rundensieg
	ZoneDecay = 0.5, -- −0.5/s wenn leer
	ZoneHeight = 10, -- Höhen-Toleranz der Zone (Studs über/unter dem Mittelpunkt)
	SuddenDeath = 30,
	SuddenDeathHp = 50,
	AfkWarn = 20,
	AfkKick = 30,
	AfkMoveStuds = 2, -- weniger Bewegung = "ohne Eingabe"
	LeaverCooldown = 60, -- Pad-Sperre nach Verlassen
	LeaverBotDelay = 10, -- Team-Modi: Bot ersetzt nach 10 s
	RecentMaps = 2, -- nie die letzten 2 Maps dieses Servers für diesen Modus
	ZoneHz = 5,
	SpawnLift = 3, -- Teleport an Spawns +3 Y
	FfaSpawnCandidates = 8, -- Respawn-Wertung: beste von 8 Kandidaten
	FfaSightPenalty = 40, -- minDist − 40 × (Gegner mit Sicht)
	FfaFillEvery = 2, -- FFA: höchstens alle 2 s einen Bot nachfüllen
	CrownEdgeX = 60, -- Verlierer an den Rand der Grube (Lobby-Ebene)
	CrownEdgeZ = 16,
	ArenaLobbyY = 3,
}

-- ---------------------------------------------------------------------
-- 6) WARTESCHLANGEN & PADS (B3) + KRONE (B4)
-- ---------------------------------------------------------------------
Modes.Queue = {
	BotFillSeconds = 8, -- Studio: Config.Studio.BotFillSeconds (2)
	RookieFillSeconds = 3, -- wartet ein Rookie, kommen Bots schon nach 3 s
	FillNowAfter = 3, -- "Bots jetzt" frühestens nach 3 s
	MatcherHz = 2,
	PadScanHz = 4,
	SeatRadius = 2.2,
	SeatHeight = 5, -- |ΔY| < 5
	SeatLeaveSeconds = 1.5,
	InputMatchSeconds = 6,
	MmrWindow = 200,
	MmrWiden = 50,
	MmrWidenEvery = 3,
	NewPlayerMatches = 5, -- < 5 Matches = Neuling …
	NewPlayerPool = 15, -- … trifft nur Spieler mit < 15 Matches oder Bots
	CrownLine = 6,
	CrownIdleBot = 15,
	CrownSoloWait = 8,
	CrownRejoinGrace = 3, -- nach einem Kronen-Teleport zählt ein Kreis erst nach 3 s wieder
	PracticeCooldown = 5,
	RangeTeleportCooldown = 2,
	MaxEntries = 64, -- Obergrenze Einträge pro Modus
}

-- ---------------------------------------------------------------------
-- 7) TUTORIAL (B1.1) – Practice 1v1 gegen Rookie auf PillarBox, Erster auf 3
-- ---------------------------------------------------------------------
Modes.Tutorial = {
	Map = "PillarBox",
	Mood = "Day",
	Difficulty = "Rookie",
	RoundsToWin = 3,
	TourRadius = 12, -- Pfeil-Tour: Ziel erreicht, wenn näher als 12 Studs
	TourTargets = {
		{ Key = "Locker", Pos = Vector3.new(-10, 0, 70) },
		{ Key = "Shop", Pos = Vector3.new(-30, 0, 70) },
		{ Key = "Pads", Pos = Vector3.new(0, 0, -60) },
	},
	TourWeapon = "BuzzSMG", -- "Summ-MP 600 Coins – im Training gratis testen"
}

-- ---------------------------------------------------------------------
-- 8) SKILL-MOMENTE (docs/SKILL-WUENSCHE.md)
-- ---------------------------------------------------------------------
Modes.Skill = {
	MultiKillWindow = 4, -- DOUBLE/TRIPLE/QUAD: nächster Pop innerhalb von 4 s
	MultiKillMax = 4, -- ab 4 heißt es QUAD
	ClutchXpPerEnemy = 15, -- CLUTCH 1vX: +15 XP je Gegner (1v2 = 30, 1v4 = 60), über ProgressionService.AddXp
	AceXp = 20, -- ACE (ab 3v3): Bonus-XP für den Spieler
}

-- =====================================================================
-- PRÜFEN – Fehlertexte mit exaktem Pfad
-- =====================================================================
local RULE_KEYS: { [string]: string } = {
	DamageMult = "number",
	HeadOnly = "boolean",
	HeadRadiusMult = "number",
	IntervalMult = "number",
	ReloadMult = "number",
	SpeedMult = "number",
	GravityLift = "number",
	AllowedSlots = "table",
	ForcedLoadout = "table",
	RandomLoadout = "boolean",
	Regen = "boolean",
	UtilityMode = "string",
	FriendlyFire = "boolean",
	IgnoreOwnership = "boolean",
}
local SLOTS = { "Primary", "Secondary", "Melee", "Utility" }

local function isNum(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function checkRules(errors: { string }, path: string, rules: any, weaponOf: ((string) -> any)?)
	if type(rules) ~= "table" then
		table.insert(errors, path .. ": Tabelle erwartet")
		return
	end
	for key, value in pairs(rules) do
		local expected = RULE_KEYS[key]
		if expected == nil then
			table.insert(errors, path .. "." .. tostring(key) .. ": unbekannte Regel")
		elseif type(value) ~= expected then
			table.insert(errors, path .. "." .. tostring(key) .. ": " .. expected .. " erwartet")
		elseif expected == "number" and (not isNum(value) or value < 0) then
			table.insert(errors, path .. "." .. tostring(key) .. ": Zahl ≥ 0 erwartet")
		end
	end
	if rules.UtilityMode ~= nil and rules.UtilityMode ~= "Charges" and rules.UtilityMode ~= "Cooldown" then
		table.insert(errors, path .. '.UtilityMode: "Charges" oder "Cooldown" erwartet')
	end
	local forced = rules.ForcedLoadout
	if type(forced) == "table" then
		for _, slot in ipairs(SLOTS) do
			local key = forced[slot]
			if type(key) ~= "string" then
				table.insert(errors, path .. ".ForcedLoadout." .. slot .. ": Waffen-Key erwartet")
			elseif weaponOf then
				local def = weaponOf(key)
				if def == nil then
					table.insert(errors, path .. ".ForcedLoadout." .. slot .. ": unbekannte Waffe " .. key)
				elseif def.Slot ~= slot then
					table.insert(
						errors,
						path .. ".ForcedLoadout." .. slot .. ": " .. key .. " passt nicht in diesen Platz"
					)
				end
			end
		end
	end
	local allowed = rules.AllowedSlots
	if type(allowed) == "table" then
		for slot, on in pairs(allowed) do
			if table.find(SLOTS, slot) == nil or on ~= true then
				table.insert(errors, path .. ".AllowedSlots." .. tostring(slot) .. ": Platzname = true erwartet")
			end
		end
	end
end

local function checkNumbers(errors: { string }, path: string, t: any)
	if type(t) ~= "table" then
		table.insert(errors, path .. ": Tabelle erwartet")
		return
	end
	for key, value in pairs(t) do
		if type(value) == "number" and (not isNum(value) or value < 0) then
			table.insert(errors, path .. "." .. tostring(key) .. ": Zahl ≥ 0 erwartet")
		end
	end
end

function Modes.Validate(Config: any): { string }
	local errors: { string } = {}
	local weaponOf: ((string) -> any)? = nil
	if type(Config) == "table" and type(Config.Weapon) == "function" then
		local list = type(Config.Weapons) == "table" and Config.Weapons.List or nil
		if type(list) == "table" and #list > 0 then
			weaponOf = Config.Weapon
		end
	end
	local mapsCfg = if type(Config) == "table" and type(Config.Maps) == "table" then Config.Maps.Maps else nil

	for key, def in pairs(MODES) do
		local path = "Config.Modes.Modes." .. key
		if type(def.Name) ~= "table" or type(def.Name.de) ~= "string" or type(def.Name.en) ~= "string" then
			table.insert(errors, path .. ".Name: { de, en } erwartet")
		end
		if def.Ruleset ~= "Rounds" and def.Ruleset ~= "Respawn" then
			table.insert(errors, path .. '.Ruleset: "Rounds" oder "Respawn" erwartet')
		end
		if not isNum(def.TeamSize) or def.TeamSize < 1 or def.TeamSize > 8 or def.TeamSize % 1 ~= 0 then
			table.insert(errors, path .. ".TeamSize: ganze Zahl 1–8 erwartet")
		end
		if table.find(Modes.Order, key) == nil then
			table.insert(errors, path .. ": fehlt in Config.Modes.Order")
		end
		if def.Ruleset == "Rounds" then
			if def.Teams ~= 2 then
				table.insert(errors, path .. ".Teams: Rundenmodi brauchen 2 Teams")
			end
			local rtw, cap = def.RoundsToWin, def.RoundCap
			if not isNum(rtw) or (rtw :: number) < 1 then
				table.insert(errors, path .. ".RoundsToWin: Zahl ≥ 1 erwartet")
			elseif not isNum(cap) or cap ~= 2 * (rtw :: number) + 1 then
				table.insert(errors, path .. ".RoundCap: muss 2 × RoundsToWin + 1 sein (B6.4)")
			end
			if not isNum(def.RoundTime) or (def.RoundTime :: number) < 5 then
				table.insert(errors, path .. ".RoundTime: Zahl ≥ 5 erwartet")
			end
			if not isNum(def.Overtime) or (def.Overtime :: number) < 1 then
				table.insert(errors, path .. ".Overtime: Zahl ≥ 1 erwartet")
			end
			if (def.TeamSize :: number) * 2 > 16 then
				table.insert(errors, path .. ".TeamSize: höchstens 8 pro Team")
			end
		else
			for _, field in ipairs({ "ScoreToWin", "KillPoints", "AssistPoints", "MatchTime", "RespawnDelay", "FillTo" }) do
				local value = (def :: any)[field]
				if not isNum(value) or value < 0 then
					table.insert(errors, path .. "." .. field .. ": Zahl ≥ 0 erwartet")
				end
			end
			local maxPlayers = def.MaxPlayers
			if not isNum(maxPlayers) or (maxPlayers :: number) < 2 or (maxPlayers :: number) > 32 then
				table.insert(errors, path .. ".MaxPlayers: Zahl 2–32 erwartet")
			elseif isNum(def.FillTo) and (def.FillTo :: number) > (maxPlayers :: number) then
				table.insert(errors, path .. ".FillTo: darf nicht größer als MaxPlayers sein")
			end
		end
		if def.FixedMap ~= nil and type(mapsCfg) == "table" and mapsCfg[def.FixedMap] == nil then
			table.insert(errors, path .. ".FixedMap: unbekannte Map " .. tostring(def.FixedMap))
		end
		if def.Rewards ~= nil then
			checkNumbers(errors, path .. ".Rewards", def.Rewards)
		end
	end

	for key, mutator in pairs(MUTATORS) do
		local path = "Config.Modes.Mutators." .. key
		if type(mutator.Name) ~= "table" or type(mutator.Name.de) ~= "string" or type(mutator.Name.en) ~= "string" then
			table.insert(errors, path .. ".Name: { de, en } erwartet")
		end
		if type(mutator.Desc) ~= "table" or type(mutator.Desc.de) ~= "string" or type(mutator.Desc.en) ~= "string" then
			table.insert(errors, path .. ".Desc: { de, en } erwartet")
		end
		checkRules(errors, path .. ".Rules", mutator.Rules, weaponOf)
	end
	if #Modes.Rotation == 0 then
		table.insert(errors, "Config.Modes.Rotation: mindestens ein Mutator erwartet")
	end
	for i, key in ipairs(Modes.Rotation) do
		if MUTATORS[key] == nil then
			table.insert(errors, ("Config.Modes.Rotation[%d]: unbekannter Mutator %s"):format(i, tostring(key)))
		end
	end
	checkRules(errors, "Config.Modes.DefaultRules", Modes.DefaultRules, weaponOf)
	for key, rules in pairs(Modes.ModeRules) do
		if MODES[key] == nil then
			table.insert(errors, "Config.Modes.ModeRules." .. key .. ": unbekannter Modus")
		end
		checkRules(errors, "Config.Modes.ModeRules." .. key, rules, weaponOf)
	end

	checkNumbers(errors, "Config.Modes.Match", Modes.Match)
	checkNumbers(errors, "Config.Modes.Queue", Modes.Queue)
	checkNumbers(errors, "Config.Modes.Skill", Modes.Skill)
	local match = Modes.Match
	if match.AfkWarn >= match.AfkKick then
		table.insert(errors, "Config.Modes.Match.AfkWarn: muss kleiner als AfkKick sein")
	end
	if match.BotVoteMax < match.BotVoteMin or match.BotVoteMax > match.VoteSeconds then
		table.insert(errors, "Config.Modes.Match.BotVoteMax: zwischen BotVoteMin und VoteSeconds erwartet")
	end
	if match.ReadyMinPrep > match.Prep then
		table.insert(errors, "Config.Modes.Match.ReadyMinPrep: darf nicht größer als Prep sein")
	end
	local queue = Modes.Queue
	if queue.MatcherHz <= 0 or queue.PadScanHz <= 0 then
		table.insert(errors, "Config.Modes.Queue: MatcherHz und PadScanHz müssen > 0 sein")
	end
	if queue.NewPlayerMatches > queue.NewPlayerPool then
		table.insert(errors, "Config.Modes.Queue.NewPlayerMatches: darf nicht größer als NewPlayerPool sein")
	end
	local tutorial = Modes.Tutorial
	if type(mapsCfg) == "table" and mapsCfg[tutorial.Map] == nil then
		table.insert(errors, "Config.Modes.Tutorial.Map: unbekannte Map " .. tostring(tutorial.Map))
	end
	if weaponOf and weaponOf(tutorial.TourWeapon) == nil then
		table.insert(errors, "Config.Modes.Tutorial.TourWeapon: unbekannte Waffe " .. tostring(tutorial.TourWeapon))
	end
	local bots = if type(Config) == "table" and type(Config.Bots) == "table" then Config.Bots.Difficulties else nil
	if type(bots) == "table" and next(bots) ~= nil and bots[tutorial.Difficulty] == nil then
		table.insert(errors, "Config.Modes.Tutorial.Difficulty: unbekannte Bot-Stufe " .. tostring(tutorial.Difficulty))
	end
	return errors
end

return Modes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – FORTSCHRITT & BELOHNUNGEN (Config.Progression)
--  Besitzer: WP8 (Fortschritt). Vertrag: DESIGN.md C15 + B16 + B24.
--  Alle Zahlen sind Startwerte aus DESIGN.md und hier 1:1 änderbar
--  (XP, Coins, Quests, Login, Glücksrad, Erfolge, Kopfgeld, Codes, Chat).
--  ACHTUNG: wird an alle Clients repliziert -> KEINE Geheimnisse (Codes sind öffentlich gedacht).
--
--  Aufbau:
--    1) Level-Kurve + XP-Quellen + Multiplikatoren      7) Glücksrad + Spielzeit-Geschenke
--    2) Coins pro Match                                 8) Erfolge (12)
--    3) Level-Belohnungen                               9) MMR, Kopfgeld, Comeback, Krone, Ehre, GG
--    4) Waffen-Meisterschaft                           10) Codes
--    5) Quests (Anfänger, Täglich, Wöchentlich)        11) Bestenlisten + Chat-Umschreibungen
--    6) Login-Kalender
--  Validate(Config) prüft alles (SelfTest + Boot-warn), Fehlertexte mit exaktem Pfad.
-- =====================================================================

local Progression = {}

-- ---------------------------------------------------------------------
-- 1) LEVEL-KURVE (B16.1): XPToNext(L) = Base + Step·(L − 1), Max-Level 100
-- ---------------------------------------------------------------------
Progression.Curve = { Base = 250, Step = 50, MaxLevel = 100 }

-- XP-Quellen (Casual gegen Menschen)
Progression.Xp = {
	Played = 40, -- Match beendet
	Win = 60, -- Sieg
	Round = 12, -- je gewonnene Runde
	Elim = 15, -- je Pop
	Assist = 7,
	HeadElim = 5, -- Kopf-Pop extra
	MeleeElim = 10, -- Nahkampf-Pop extra
	Mvp = 20,
	GG = 5, -- beide Seiten drücken GG
	CrownDefence = 15, -- Kronen-Verteidigung gegen Menschen
}

-- Multiplikatoren: additiv, gedeckelt auf Cap. Danach Bot- bzw. Practice-Faktor.
-- Gilt NUR für XP (und Pass-XP aus Matches) – nie für Coins (kein Pay-to-Win).
Progression.XpMult = {
	Vip = 0.2,
	DoubleXP = 1.0,
	Boost = 1.0, -- XP-Boost-Produkt / Glücksrad (Boosts.XP2Until)
	Party = 1.0, -- Party-Boost (ganzer Server)
	Event = 1.0, -- Admin-Abuse-Event
	Cap = 3.0,
	Bot = 0.6,
	Practice = 0.3,
}

-- ---------------------------------------------------------------------
-- 2) COINS PRO MATCH (B18.2) – gutgeschrieben NUR über ShopService.Grant
-- ---------------------------------------------------------------------
Progression.Coins = {
	Played = 30,
	Round = 10,
	Elim = 6,
	Assist = 3,
	HeadElim = 2,
	Win = 50,
	Mvp = 15,
	GG = 5,
	StreakStep = 5, -- Siegesserie: +5 je Stufe ab dem 2. Sieg in Folge …
	StreakCap = 30, -- … höchstens +30
	BotMult = 0.6, -- gegen Bots ×0.6 …
	BotMin = 15, -- … mindestens 15 …
	BotDailyCap = 2500, -- … höchstens 2.500 pro UTC-Tag
	DrawBonus = 0.1, -- Unentschieden: Niederlagen-Belohnung +10 %
}

Progression.FirstWin = { Xp = 200, Coins = 150 } -- erster Sieg des UTC-Tages (flach)
Progression.Tutorial = { Xp = 250, Coins = 300 } -- Tutorial-Duell (einmalig)

-- ---------------------------------------------------------------------
-- 3) LEVEL-BELOHNUNGEN (B16.1)
-- ---------------------------------------------------------------------
Progression.LevelRewards = {
	CoinsBase = 50, -- jedes Level: 50 + 10·L Coins
	CoinsPerLevel = 10,
	FreeWeaponLevels = { 4, 10, 20 }, -- "Wähle eine Waffe gratis!"
	KeyEvery = 5, -- jedes 5. Level 1 Schlüssel
	GemsEvery = 10, -- jedes 10. Level …
	Gems = 25, -- … 25 Gems
	Titles = { [10] = "TT_Lv10", [25] = "TT_Lv25", [50] = "TT_Lv50", [75] = "TT_Lv75", [100] = "TT_Lv100" },
	AnnounceLevels = { 25, 50, 100 }, -- Lobby-Ansage (B24)
}

-- Level-Abzeichen-Farben (Chat, Scoreboard): ab Level Min
Progression.LevelColors = {
	{ Min = 1, Color = Color3.fromRGB(255, 255, 255) },
	{ Min = 10, Color = Color3.fromRGB(90, 220, 110) },
	{ Min = 25, Color = Color3.fromRGB(60, 140, 255) },
	{ Min = 50, Color = Color3.fromRGB(170, 90, 255) },
	{ Min = 75, Color = Color3.fromRGB(255, 145, 35) },
	{ Min = 100, Color = Color3.fromRGB(255, 200, 40) },
}

-- ---------------------------------------------------------------------
-- 4) WAFFEN-MEISTERSCHAFT (B16.2) – Pops je Stufe; Nahkampf/Utility ×2, MasteryBoost ×2
--    Wraps sind NICHT kaufbar; Ausrüsten prüft die Stufe (kein Besitz-Eintrag).
--    Title = "Master" -> Titel "TT_Master_<WeaponKey>"
-- ---------------------------------------------------------------------
Progression.Mastery = {
	Tiers = { 10, 30, 75, 150, 300, 600, 1000, 2000, 3500, 6000 },
	MeleeUtilityMult = 2,
	BoostMult = 2,
	PracticeMult = 0.5,
	StarTier = 5, -- Stern im Killfeed ab Stufe V
	Rewards = {
		{ Coins = 150 },
		{ Wrap = "W_MBronze" },
		{ Keys = 1, Coins = 250 },
		{ Wrap = "W_MSilver" },
		{ Wrap = "W_MGold" },
		{ Gems = 50 },
		{ Wrap = "W_MDiamond" },
		{ Wrap = "W_MNeon" },
		{ Wrap = "W_MGalaxy", Title = "Master" },
		{ Wrap = "W_MPrism" },
	},
}

-- ---------------------------------------------------------------------
-- 5) QUESTS (B16.3)
--    Kind = Zähl-Art (RewardService.Track), Goal = Ziel, Tier = Easy/Medium/Hard,
--    Filter = nur zählen, wenn ctx.Mode / ctx.Map passt. Text = Lang "prog.q.<Id>" (%d = Ziel).
--    Pvp = true: zählt nur in PvP-Matches ("gegen Spieler").
-- ---------------------------------------------------------------------
Progression.Quests = {
	DailyCount = 3,
	WeeklyCount = 5,
	FreeRerolls = 1, -- pro Tag gratis tauschen (VIP +1)
	VipRerolls = 1,
	RerollCoins = 100, -- jeder weitere Tausch
	DailyTiers = { "Easy", "Medium", "Hard" },
	DailyRewards = {
		Easy = { Coins = 150, PassXp = 300 },
		Medium = { Coins = 250, PassXp = 300 },
