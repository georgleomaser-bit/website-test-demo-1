		["admin.title"] = "🛠️ ADMIN",
		["admin.targetHint"] = "Ziel: me / all / others / Name / UserId",
		["admin.targetSet"] = "Ziel: %s",
		["admin.setTarget"] = "Ziel",
		["admin.refresh"] = "Aktualisieren",
		["admin.nothing"] = "Nichts da.",

		-- Reiter
		["admin.tabPlayers"] = "👥 SPIELER",
		["admin.tabPowers"] = "⚡ KRÄFTE",
		["admin.tabWeapons"] = "🔫 WAFFEN",
		["admin.tabMatch"] = "🏟️ MATCH",
		["admin.tabEvents"] = "🎉 EVENTS",
		["admin.tabBalance"] = "⚖️ BALANCE",
		["admin.tabStats"] = "📊 STATISTIK",
		["admin.tabMod"] = "🛡️ MODERATION",
		["admin.tabDebug"] = "🐞 DEBUG",

		-- Ziele / Schutzregeln
		["admin.noTarget"] = "Kein Ziel gefunden",
		["admin.oneTarget"] = "Bitte genau EIN Ziel angeben",
		["admin.notSelf"] = "Nicht bei dir selbst und nicht beim Besitzer",
		["admin.notOwner"] = "Der Besitzer ist geschützt",
		["admin.studioUser"] = "Im Studio-Test nicht möglich (Test-Spieler haben keine echte UserId)",
		["admin.liveOnly"] = "Nur im echten Spiel (nicht im Studio)",
		["admin.studioOnly"] = "Nur im Studio",
