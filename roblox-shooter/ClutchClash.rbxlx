		["admin.gems"] = "Gems",
		["admin.keys"] = "Schlüssel",
		["admin.shards"] = "Splitter",
		["admin.give"] = "Geben",
		["admin.amount"] = "Menge",
		["admin.giveXp"] = "XP geben",
		["admin.level"] = "Level",
		["admin.setLevel"] = "Level setzen",
		["admin.secData"] = "Spielstand & Käufe",
