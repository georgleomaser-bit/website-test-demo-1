		["admin.secActions"] = "Aktionen (gelten für das Ziel oben)",
		["admin.reasonHint"] = "Grund / Text (für Kick, Warnen, Bann)",
		["admin.kick"] = "Kick",
		["admin.warn"] = "Warnen",
		["admin.freeze"] = "Einfrieren",
		["admin.unfreeze"] = "Auftauen",
		["admin.bring"] = "Herholen",
