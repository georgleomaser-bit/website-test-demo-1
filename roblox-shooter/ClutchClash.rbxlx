        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Match</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Texte "match." (Shared/Lang/Match)
--  Besitzer: WP5 (Match & Warteschlangen). Nur Schlüssel mit Präfix "match.".
--  Pflicht-Schlüssel (C16): match.found, match.botIn, match.searching, match.overtime, match.clutch, match.ace,
--  match.flawless, match.comeback, match.matchPoint, match.suddenDeath, match.arenasFull, match.botsBusy.
--  Platzhalter wie string.format: %s = Text, %d = ganze Zahl, %% = Prozentzeichen.
-- =====================================================================

