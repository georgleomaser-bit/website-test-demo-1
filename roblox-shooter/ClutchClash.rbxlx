        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="103">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="104">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Client-Start (src/client/Main.client.luau)
--  Besitzer: WP10 (Client-Hülle). Vertrag: DESIGN.md C7.1–C7.3, REUSE §10 (Meteor-Heist-Skelett).
--
--  Dieses Skript baut die Oberfläche (ScreenGui + unskalierte TouchGui), den gemeinsamen
--  "Rucksack" ctx für alle Client-Module, den Request-Wrapper, den State-Merge und leitet alle
--  Server-Nachrichten als Hooks weiter. Danach startet es die Module in fester Reihenfolge:
--  jedes Init(ctx) in pcall, danach jedes Start() in pcall – fehlt ein Modul (anderes Paket noch
--  nicht fertig), gibt es nur ein warn und alles andere läuft weiter.
--  Admin-Module nur, wenn der Server das Attribut IsAdmin = true setzt.
--
--  ctx (C7.1): Player, Config, Lang, Util, Net, Types, Remotes, Gui, TouchGui, State, StateTime,
--    Request(action, arg?) -> Antwort bei Ok, sonst nil (Toast bei Message / keine Antwort)
--    RequestFull(action, arg?, silent?) -> { Ok, Message?, ... } (immer eine Tabelle)
--    Toast(text, kind?), T(key, ...), Lang_() -> "de" | "en", Hooks, Windows, UI, Modules
--  Hooks, die Main.client feuert: "State"(state, changed), "Notify"(text, kind), "Match:<Kind>"(data),
--    "Combat:<Op>"(data), "Effect:<Name>"(strength, data), "Armed"(info), "Disarmed"(),
--    "LocalPopped"(recap?), "LocalRevived"(), "World"(world, slot?), "Balance"(version).
--  Ein PreRender-Loop für alle Effekte (Frame(dt) der WP10-Module) + 1-s-Takt (Tick()) in pcall.
-- =====================================================================

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Lang = require(Shared:WaitForChild("Lang")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Net = require(Shared:WaitForChild("Net")) :: any
local Types = require(Shared:WaitForChild("Types")) :: any

local ModulesFolder = script.Parent:WaitForChild("Modules")

-- Startreihenfolge (C7.1) – fehlende Module werden übersprungen
local MODULE_ORDER = {
	"UI",
	"Hooks",
	"Sfx",
	"Effects",
	"Highlights",
	"CombatFX",
	"Controls",
	"TouchControls",
	"Hud",
	"CombatHud",
	"Settings",
	"ArenaLook",
	"FpsCamera",
	"AimAssist",
	"Viewmodel",
	"Movement",
	"Replication",
	"WeaponClient",
	"QueueUI",
	"MatchUI",
	"Spectate",
	"Scoreboard",
	"Tutorial",
	"BotAnimator",
	"Training",
	"Progress",
	"ChatClient",
	"Shop",
	"Locker",
	"CrateReveal",
	"Finishers",
}
local ADMIN_MODULES = { "AdminPanel", "AdminTools", "Fly", "PhotoMode", "DebugOverlay" }
-- Nur diese (eigenen) Module bekommen Frame(dt)/Tick() aus den zentralen Schleifen
local FRAME_MODULES = { "UI", "Effects", "CombatFX", "CombatHud", "TouchControls", "Settings" }
local TICK_MODULES = { "Hud", "CombatHud", "Settings" }

local ERROR_LOG_GAP = 10 -- Fehler derselben Quelle höchstens alle 10 s loggen
local GETFULL_AFTER = 5 -- Sekunden ohne State -> einmal "GetFull" anfragen

-- ---------------------------------------------------------------------
-- MODULE LADEN (require in pcall)
-- ---------------------------------------------------------------------
local loaded: { [string]: any } = {}
local function load(name: string): any?
	if loaded[name] ~= nil then
		return loaded[name] or nil
	end
	local moduleScript = ModulesFolder:FindFirstChild(name)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		loaded[name] = false
		return nil
	end
	local ok, result = pcall(require, moduleScript)
	if not ok or type(result) ~= "table" then
		warn(("[Client] Modul %s konnte nicht geladen werden: %s"):format(name, tostring(result)))
		loaded[name] = false
		return nil
	end
	loaded[name] = result
	return result
end

local UI = load("UI")
local Hooks = load("Hooks")
assert(UI and Hooks, "[Client] UI und Hooks werden gebraucht")

-- ---------------------------------------------------------------------
-- GRUNDGERÜST: Oberfläche (mit UIScale) + unskalierte Touch-Ebene
-- ---------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "ClutchClashUI"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.IgnoreGuiInset = false
gui.DisplayOrder = 1
gui.Parent = playerGui

-- Touch-Knöpfe: eigene ScreenGui OHNE UIScale (sonst schrumpfen sie unter 64 px), nichts unter der Notch
local touchGui = Instance.new("ScreenGui")
touchGui.Name = "ClutchClashTouch"
touchGui.ResetOnSpawn = false
touchGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
touchGui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
touchGui.DisplayOrder = 3
touchGui.Parent = playerGui

-- Gemeinsamer "Rucksack" für alle Module (C7.1)
local ctx: { [string]: any } = {
	Player = player,
	Config = Config,
	Lang = Lang,
	Util = Util,
	Net = Net,
	Types = Types,
	Remotes = {},
	Gui = gui,
	TouchGui = touchGui,
	State = {},
	StateTime = 0,
	Hooks = Hooks,
	UI = UI,
	Windows = UI.Windows,
	Modules = { UI = UI, Hooks = Hooks },
}

-- Aktuelle Sprache: Einstellung "de"/"en", sonst LocaleId des Spielers
function ctx.Lang_(): "de" | "en"
	local settings: any = nil
	local settingsModule = ctx.Modules.Settings
	if settingsModule and type(settingsModule.Get) == "function" then
		local ok, value = pcall(settingsModule.Get)
		if ok then
			settings = value
		end
	end
	if type(settings) ~= "table" then
		settings = ctx.State.Settings
	end
	local choice = type(settings) == "table" and settings.Lang or nil
	if choice == "de" or choice == "en" then
		return choice
	end
	local ok, lang = pcall(Lang.For, player, nil)
	if ok and (lang == "de" or lang == "en") then
		return lang
	end
	return "en"
end

function ctx.T(key: string, ...: any): string
	return Lang.T(ctx.Lang_(), key, ...)
end

function ctx.Toast(text: string, kind: string?)
	UI.Toast(text, kind)
end

-- ---------------------------------------------------------------------
-- ANFRAGEN AN DEN SERVER (MH-Muster: pcall um InvokeServer, Toast bei Message)
-- ---------------------------------------------------------------------
function ctx.RequestFull(action: string, arg: any?, silent: boolean?): { [string]: any }
	local remote = ctx.Remotes.Request
	if not remote or not remote:IsA("RemoteFunction") then
		if not silent then
			UI.Toast(ctx.T("core.noAnswer"), "Error")
		end
		return { Ok = false, Message = ctx.T("core.noAnswer") }
	end
	local ok, result = pcall(function()
		return (remote :: RemoteFunction):InvokeServer(action, arg)
	end)
	if ok and type(result) == "table" then
		if not silent and type(result.Message) == "string" and result.Message ~= "" then
			UI.Toast(result.Message, if result.Ok then "Success" else "Error")
		end
		result.Ok = result.Ok == true
		return result
	end
	if not silent then
		UI.Toast(ctx.T("core.noAnswer"), "Error")
	end
	return { Ok = false, Message = ctx.T("core.noAnswer") }
end

-- Kurzform: Antwort-Tabelle bei Erfolg, sonst nil (Meldung kam schon als Toast)
function ctx.Request(action: string, arg: any?): any
	local reply = ctx.RequestFull(action, arg)
	if reply.Ok then
		return reply
	end
	return nil
end

-- ---------------------------------------------------------------------
-- MODULE STARTEN (Init alle, dann Start alle – jeweils in pcall)
-- ---------------------------------------------------------------------
local function safeCall(label: string, fn: any, ...: any): boolean
	if type(fn) ~= "function" then
		return true
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn(("[Client] %s fehlgeschlagen: %s"):format(label, tostring(err)))
	end
	return ok
end

local function startModules(names: { string })
	local ready: { { Name: string, Module: any } } = {}
	for _, name in ipairs(names) do
		local module = load(name)
		if module then
			ctx.Modules[name] = module
			table.insert(ready, { Name = name, Module = module })
		else
			warn("[Client] Modul fehlt (übersprungen): " .. name)
		end
	end
	for _, entry in ipairs(ready) do
		if not safeCall(entry.Name .. ".Init", entry.Module.Init, ctx) then
			entry.Module = nil
		end
	end
	for _, entry in ipairs(ready) do
		if entry.Module then
			safeCall(entry.Name .. ".Start", entry.Module.Start)
		end
	end
end

-- ---------------------------------------------------------------------
-- REMOTES + WELT-ZUSTAND
-- ---------------------------------------------------------------------
local myCombatId: number = player.UserId
local armed: { [string]: any }? = nil
local inMatch = false
local popped = false

local function fireWorld(world: string, slot: number?)
	Hooks.Fire("World", world, slot)
end

local function setPopped(recap: any?)
	if popped then
		return
	end
	popped = true
	Hooks.Fire("LocalPopped", recap)
end

local function setRevived()
	if not popped then
		return
	end
	popped = false
	Hooks.Fire("LocalRevived")
end

-- State: Sticky-Merge (fehlende Schlüssel bleiben – auch beim vollen State alle 20 s), changed = Liste + Set
local function onState(partial: any, _full: any)
	if type(partial) ~= "table" then
		return
	end
	local state = ctx.State
	local changed: { [any]: any } = {}
	for key, value in pairs(partial) do
		if type(key) == "string" then
			state[key] = value
			table.insert(changed, key)
			changed[key] = true
		end
	end
	ctx.StateTime = os.clock()
	Hooks.Fire("State", state, changed)
end

local function onMatch(kind: any, data: any)
	if type(kind) ~= "string" then
		return
	end
	if type(data) ~= "table" then
		data = {}
	end
	if kind == "Start" then
		inMatch = true
		local slot = tonumber(data.Slot) or 0
		if slot == 0 or data.Mode == "Crown" then
			fireWorld("Crown", 0)
		else
			fireWorld("Match", slot)
		end
	elseif kind == "Elim" then
		if tonumber(data.V) == myCombatId then
			setPopped(nil)
		end
	elseif kind == "Recap" then
		-- Rückblick kommt nach dem Pop: falls das Elim fehlte, gilt man jetzt als gepoppt
		setPopped(data)
	end
	Hooks.Fire("Match:" .. kind, data)
	if kind == "Closed" then
		inMatch = false
		if popped then
			popped = false
		end
		if not armed then
			fireWorld("Lobby", nil)
		end
	end
end

local function onCombat(op: any, data: any)
	if type(op) ~= "string" then
		return
	end
	if type(data) ~= "table" then
		data = {}
	end
	if op == "Armed" then
		armed = data
		myCombatId = tonumber(data.Id) or player.UserId
		setRevived()
		Hooks.Fire("Combat:Armed", data)
		Hooks.Fire("Armed", data)
		if data.Ctx == "Range" then
			fireWorld("Range", nil)
		end
		return
	elseif op == "Disarmed" then
		armed = nil
		popped = false
		Hooks.Fire("Combat:Disarmed", data)
		Hooks.Fire("Disarmed")
		if not inMatch then
			fireWorld("Lobby", nil)
		end
		return
	end
	Hooks.Fire("Combat:" .. op, data)
end

-- Eigener Character: Attribut "Alive" (CombatService) als zweite Quelle für Pop/Revive
local aliveConn: RBXScriptConnection? = nil
local function watchCharacter(character: Model)
	if aliveConn then
		aliveConn:Disconnect()
		aliveConn = nil
	end
	aliveConn = character:GetAttributeChangedSignal("Alive"):Connect(function()
		if not armed then
			return
		end
		local alive = character:GetAttribute("Alive")
		if alive == false then
			setPopped(nil)
		elseif alive == true then
			setRevived()
		end
	end)
end

-- Erst NACH dem Modul-Start verbinden: bis dahin hält Roblox die Pakete in der Warteschlange,
-- so verpasst kein Modul den ersten vollen State oder ein frühes "Armed".
local function connectRemotes()
	local remotes = ctx.Remotes
	local function event(name: string): RemoteEvent?
		local remote = remotes[name]
		if remote and remote:IsA("RemoteEvent") then
			return remote
		end
		warn("[Client] Remote fehlt: " .. name)
		return nil
	end
	local stateRemote = event("State")
	if stateRemote then
		stateRemote.OnClientEvent:Connect(onState)
	end
	local notify = event("Notify")
	if notify then
		notify.OnClientEvent:Connect(function(text, kind)
			if type(text) ~= "string" then
				return
			end
			local k = if type(kind) == "string" then kind else "Info"
			UI.Toast(text, k)
			Hooks.Fire("Notify", text, k)
		end)
	end
	local effect = event("Effect")
	if effect then
		effect.OnClientEvent:Connect(function(name, strength, data)
			if type(name) ~= "string" then
				return
			end
			local amount = if type(strength) == "number" and strength == strength then strength else 0
			local effects = ctx.Modules.Effects
			if effects and type(effects.Play) == "function" then
				safeCall("Effects.Play(" .. name .. ")", effects.Play, name, amount, data)
			end
			Hooks.Fire("Effect:" .. name, amount, data)
		end)
	end
	local match = event("Match")
	if match then
		match.OnClientEvent:Connect(onMatch)
	end
	local combat = event("Combat")
	if combat then
		combat.OnClientEvent:Connect(onCombat)
	end
end

-- ---------------------------------------------------------------------
-- LIVE-BALANCE: ReplicatedStorage.LiveBalance (StringValue mit JSON) -> Config.ApplyBalance
-- ---------------------------------------------------------------------
local lastBalance = ""
local function applyBalance(value: StringValue)
	local text = value.Value
	if type(text) ~= "string" or text == "" or text == lastBalance then
		return
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(text)
	end)
	if not ok or type(data) ~= "table" then
		warn("[Client] LiveBalance: kein gültiges JSON")
		return
	end
	lastBalance = text
	if safeCall("Config.ApplyBalance", Config.ApplyBalance, data) then
		Hooks.Fire("Balance", tonumber(data.Version) or 0)
	end
end

local balanceConn: RBXScriptConnection? = nil
local function watchBalance(child: Instance)
	if child.Name ~= "LiveBalance" or not child:IsA("StringValue") then
		return
	end
	if balanceConn then
		balanceConn:Disconnect()
	end
	local value = child :: StringValue
	balanceConn = value.Changed:Connect(function()
		applyBalance(value)
	end)
	applyBalance(value)
end

-- ---------------------------------------------------------------------
-- ADMIN-MODULE (nur wenn der Server dich als Admin markiert; Server prüft trotzdem jede Aktion)
-- ---------------------------------------------------------------------
local adminStarted = false
local function checkAdmin()
	if adminStarted or player:GetAttribute("IsAdmin") ~= true then
		return
	end
	adminStarted = true
	startModules(ADMIN_MODULES)
end

-- ---------------------------------------------------------------------
-- SCHLEIFEN: ein PreRender für alle Effekte + 1-s-Takt
-- ---------------------------------------------------------------------
local lastLoopError: { [string]: number } = {}
local function loopCall(label: string, fn: any, ...: any)
	local ok, err = pcall(fn, ...)
	if not ok then
		local now = os.clock()
		if now - (lastLoopError[label] or -math.huge) >= ERROR_LOG_GAP then
			lastLoopError[label] = now
			warn(("[Client] %s: %s"):format(label, tostring(err)))
		end
	end
end

local frameFns: { { Label: string, Fn: (number) -> () } } = {}
local tickFns: { { Label: string, Fn: () -> () } } = {}
local function collectLoops()
	for _, name in ipairs(FRAME_MODULES) do
		local module = ctx.Modules[name]
		if module and type(module.Frame) == "function" then
			table.insert(frameFns, { Label = name .. ".Frame", Fn = module.Frame })
		end
	end
	for _, name in ipairs(TICK_MODULES) do
		local module = ctx.Modules[name]
		if module and type(module.Tick) == "function" then
			table.insert(tickFns, { Label = name .. ".Tick", Fn = module.Tick })
		end
	end
end

-- ---------------------------------------------------------------------
-- LOS GEHT'S
-- ---------------------------------------------------------------------
-- Roblox-Rucksack und Lebensbalken aus (wir haben eigene); mit Wiederholung, falls CoreGui noch lädt
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

-- UI zuerst (braucht ctx für Hooks/Sounds), dann alle anderen in fester Reihenfolge
UI.Init(ctx)
ctx.Remotes = Net.GetRemotes() -- Module brauchen die Remotes schon im Init (FX, Look, …)
startModules(MODULE_ORDER)
collectLoops()
fireWorld("Lobby", nil) -- Start-Welt (vor den ersten Server-Paketen)
connectRemotes()

RunService.PreRender:Connect(function(dt: number)
	for _, entry in ipairs(frameFns) do
		loopCall(entry.Label, entry.Fn, dt)
	end
end)

task.spawn(function()
	while true do
		-- Ein Fehler darf die Schleife nicht für immer anhalten
		for _, entry in ipairs(tickFns) do
			loopCall(entry.Label, entry.Fn)
		end
		task.wait(1)
	end
end)

-- Admin
player:GetAttributeChangedSignal("IsAdmin"):Connect(checkAdmin)
checkAdmin()

-- Eigener Character (Pop/Revive über Attribut "Alive")
player.CharacterAdded:Connect(watchCharacter)
if player.Character then
	watchCharacter(player.Character)
end

-- Live-Balance (StringValue kann auch später erst erscheinen)
ReplicatedStorage.ChildAdded:Connect(watchBalance)
local existingBalance = ReplicatedStorage:FindFirstChild("LiveBalance")
if existingBalance then
	watchBalance(existingBalance)
end

-- Kam nach ein paar Sekunden noch kein State (sehr langsamer Join), einmal voll nachfragen
task.delay(GETFULL_AFTER, function()
	if ctx.StateTime == 0 then
		local reply = ctx.RequestFull("GetFull", nil, true)
		if reply.Ok and type(reply.State) == "table" then
			onState(reply.State, true)
		end
	end
end)

-- Willkommen (lokalisiert, mit der passenden Taste für das Gerät)
task.delay(2, function()
	UI.Toast(ctx.T("ui.welcome", tostring(Config.GameName)), "Event")
	local controls = ctx.Modules.Controls
	local kind = if controls and type(controls.Input) == "function" then controls.Input() else "KBM"
	local hintKey = if kind == "Touch"
		then "ui.welcomeTouch"
		elseif kind == "Gamepad" then "ui.welcomePad"
		else "ui.welcomeKbm"
	task.delay(3.5, function()
		UI.Toast(ctx.T(hintKey), "Info")
	end)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="105">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">AdminPanel</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Admin-Panel (Client/Modules/AdminPanel)
--  Besitzer: WP7 (Sicherheit, Admin, Live-Balance). Vertrag: DESIGN.md B25.1/B25.3, C7.3/C7.4, docs/ADMIN-WUENSCHE.md.
--  MH-Gerüst (REUSE §1.4): Fenster 720×600, Reiter, gemeinsames Ziel-Feld (me/all/others/Name/Präfix/UserId),
--  Statuszeile, needsConfirm (2. Klick ≤ 5 s), Schieberegler (senden beim Loslassen), Listen, Zuschauen (Taste X).
--  Wird nur gebaut, wenn der Server dich als Admin markiert (Attribut IsAdmin). JEDE Aktion prüft der Server erneut.
--  Öffnen: Taste P (Config.Client.Keys.AdminPanel) oder rechter HUD-Knopf (Order 99). Fenster-Name "Admin".
--  9 Reiter: Spieler · Kräfte · Waffen & Items · Match & Server · Events · Balance · Statistik · Moderation · Debug.
--
--  Öffentliche API (C7.4):
--    AdminPanel.Toggle()
--    AdminPanel.Init(ctx) / AdminPanel.Start()
-- =====================================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local AdminPanel = {}

local player = Players.LocalPlayer
local ctx: any = nil
local UI: any = nil
local Theme: any = nil

local WINDOW_NAME = "Admin"
local CONFIRM_TIME = 5 -- Sekunden: so lange gilt der erste Klick einer gefährlichen Aktion
local MAX_LINES = 80
local STATUS_POP_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TAB_POP_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local BLACK = Color3.new(0, 0, 0)

local BOOL_POWERS = {
	{ Name = "AdminAimbot", Key = "admin.pAimbot" },
	{ Name = "AdminSilentAim", Key = "admin.pSilentAim" },
	{ Name = "AdminTriggerbot", Key = "admin.pTriggerbot" },
	{ Name = "AdminESP", Key = "admin.pESP" },
	{ Name = "CanFly", Key = "admin.pFly" },
	{ Name = "AdminNoclip", Key = "admin.pNoclip" },
	{ Name = "AdminGod", Key = "admin.pGod" },
	{ Name = "AdminInvisible", Key = "admin.pInvisible" },
	{ Name = "AdminInfAmmo", Key = "admin.pInfAmmo" },
	{ Name = "AdminNoReload", Key = "admin.pNoReload" },
	{ Name = "AdminOneShot", Key = "admin.pOneShot" },
}

local built = false
local win: any = nil
local spectating: Player? = nil

-- ---------------------------------------------------------------------
-- KLEINE HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function module(name: string): any
	local modules = ctx and ctx.Modules
	return if type(modules) == "table" then modules[name] else nil
end

local function tryModule(name: string, fnName: string, ...: any): boolean
	local m = module(name)
	local fn = if type(m) == "table" then m[fnName] else nil
	if type(fn) ~= "function" then
		return false
	end
	return (pcall(fn, ...))
end

local function sortedKeys(t: any): { string }
	local out: { string } = {}
	if type(t) == "table" then
		for key in pairs(t) do
			if type(key) == "string" then
				table.insert(out, key)
			end
		end
	end
	table.sort(out)
	return out
end

local function weaponDefs(): { any }
	local weapons = ctx and ctx.Config and ctx.Config.Weapons
	local list = weapons and weapons.List
	return if type(list) == "table" then list else {}
end

local function weaponName(def: any): string
	local lang = if ctx and type(ctx.Lang_) == "function" then ctx.Lang_() else "de"
	if type(def) == "table" and type(def.Name) == "table" then
		return tostring(def.Name[lang] or def.Name.de or def.Key)
	end
	return tostring(if type(def) == "table" then def.Key else "?")
end

local function clearChildren(parent: Instance)
	for _, child in ipairs(parent:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function fmtTime(t: any): string
	if type(t) ~= "number" or t <= 0 then
		return "-"
	end
	return os.date("%d.%m. %H:%M", math.floor(t)) :: string
end

-- ---------------------------------------------------------------------
-- ZUSCHAUEN (Client, Taste X beendet)
-- ---------------------------------------------------------------------
local function stopSpectate()
	if not spectating then
		return
	end
	spectating = nil
	if not tryModule("Spectate", "Stop") then
		local camera = workspace.CurrentCamera
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if camera and humanoid then
			camera.CameraSubject = humanoid
		end
	end
	if ctx and type(ctx.Toast) == "function" then
		ctx.Toast(T("admin.spectateStop"), "Info")
	end
end

local function spectate(target: Player?)
	if not target or target == player or not target.Character then
		return false
	end
	local character: Model = target.Character
	spectating = target
	if not tryModule("Spectate", "Start", { character }) then
		local camera = workspace.CurrentCamera
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if camera and humanoid then
			camera.CameraSubject = humanoid
		end
	end
	if ctx and type(ctx.Toast) == "function" then
		ctx.Toast(T("admin.spectating", target.DisplayName), "Info")
	end
	return true
end

local function findPlayer(text: string): Player?
	local lower = string.lower(text)
	local id = tonumber(text)
	for _, p in ipairs(Players:GetPlayers()) do
		if (id and p.UserId == id) or string.lower(p.Name) == lower or string.lower(p.DisplayName) == lower then
			return p
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if string.sub(string.lower(p.Name), 1, #lower) == lower then
			return p
		end
	end
	return nil
end

-- ---------------------------------------------------------------------
-- BAUSTEINE (MH-Gerüst)
-- ---------------------------------------------------------------------
local function listFrame(parent: Instance, order: number): Frame
	return UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }),
	})
end

local function textLine(parent: Instance, text: string, order: number, color: Color3?): TextLabel
	local label = UI.Label({
		Size = UDim2.new(1, 0, 0, 22),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = text,
		TextScaled = false,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color or Theme.Text,
		LayoutOrder = order,
		Outline = 1.5,
		Parent = parent,
	})
	return label
end

local function showLines(out: Frame, lines: { string })
	clearChildren(out)
	for i, line in ipairs(lines) do
		if i > MAX_LINES then
			textLine(out, ("… +%d"):format(#lines - MAX_LINES), i, Theme.SubText)
			break
		end
		textLine(out, line, i)
	end
end

local function button(parent: Instance, text: string, color: Color3, size: UDim2, onClick: () -> ()): any
	return UI.Button({ Size = size, Text = text, Color = color, MaxText = 16, Parent = parent }, onClick)
end

local function textBox(parent: Instance, placeholder: string, size: UDim2, default: string?): TextBox
	return UI.TextBox({
		Size = size,
		Text = default or "",
		PlaceholderText = placeholder,
		Font = UI.Font,
		Parent = parent,
	})
end

type Slider = { Set: (value: number) -> (), Get: () -> number }

-- Schieberegler: Wert wird beim Loslassen geschickt (spart Anfragen)
local function slider(
	parent: Instance,
	order: number,
	title: string,
	min: number,
	max: number,
	default: number,
	onRelease: (number) -> ()
): Slider
	local row = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	UI.Label({
		Size = UDim2.new(0.24, 0, 1, 0),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 18,
		Outline = 2,
		Parent = row,
	})
	local track: TextButton = UI.Create("TextButton", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.26, 0, 0.5, 0),
		Size = UDim2.new(0.56, 0, 0, 18),
		BackgroundColor3 = Theme.PanelDark,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	}, { UI.Corner(9), UI.Stroke(BLACK, 3) })
	local fill: Frame = UI.Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Green,
		Parent = track,
	}, { UI.Corner(9) })
	local knob: Frame = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
		Parent = track,
	}, { UI.Corner(13), UI.Stroke(BLACK, 3) })
	local valueLabel = UI.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0.16, 0, 1, 0),
		Text = "",
		MaxText = 20,
		Outline = 2,
		Parent = row,
	})
	local value = default
	local function show()
		local ratio = math.clamp((value - min) / math.max(1, max - min), 0, 1)
		fill.Size = UDim2.fromScale(ratio, 1)
		knob.Position = UDim2.fromScale(ratio, 0.5)
		valueLabel.Text = tostring(value)
	end
	local function setFromX(x: number)
		local width = math.max(1, track.AbsoluteSize.X)
		local ratio = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		value = math.floor(min + ratio * (max - min) + 0.5)
		show()
	end
	local dragging = false
	track.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		local kind = input.UserInputType
		if dragging and (kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local kind = input.UserInputType
		if dragging and (kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch) then
			dragging = false
			task.spawn(onRelease, value)
		end
	end)
	show()
	return {
		Set = function(newValue: number)
			value = math.clamp(math.floor(newValue + 0.5), min, max)
			show()
		end,
		Get = function(): number
			return value
		end,
	}
end

type Cycler = { Get: () -> string?, Set: (value: string?) -> (), OnChange: ((string?) -> ())? }

-- Knopf, der beim Klicken durch eine Liste schaltet ("Modus: Duel1")
local function cycler(parent: Instance, title: string, options: { string }, size: UDim2, emptyLabel: string?): Cycler
	local list: { string } = table.clone(options)
	if emptyLabel then
		table.insert(list, 1, "")
	end
	local index = 1
	local state: Cycler = {
		Get = function(): string?
			return nil
		end,
		Set = function(_v: string?) end,
		OnChange = nil,
	}
	local btn: any = nil
	local function label(): string
		local value = list[index]
		if value == nil or value == "" then
			return ("%s: %s"):format(title, emptyLabel or "-")
		end
		return ("%s: %s"):format(title, value)
	end
	btn = button(parent, label(), Theme.Purple, size, function()
		if #list == 0 then
			return
		end
		index = (index % #list) + 1
		btn.SetText(label())
		if state.OnChange then
			task.spawn(state.OnChange, state.Get())
		end
	end)
	state.Get = function(): string?
		local value = list[index]
		if value == nil or value == "" then
			return nil
		end
		return value
	end
	state.Set = function(value: string?)
		local found = table.find(list, value or "")
		if found then
			index = found
			btn.SetText(label())
		end
	end
	return state
end

-- =====================================================================
-- AUFBAU
-- =====================================================================
local function build()
	if built then
		return
	end
	built = true
	local Config = ctx.Config or {}
	local remotes = ctx.Remotes or {}

	win = UI.Window(T("admin.title"), 720, 600, Theme.Red)

	-- Kopf: Reiter (2 Reihen) + Ziel-Feld + Statuszeile (scrollen nicht mit)
	local tabBar = UI.Create("Frame", {
		Name = "Tabs",
		Position = UDim2.fromOffset(12, 66),
		Size = UDim2.new(1, -24, 0, 76),
		BackgroundTransparency = 1,
		Parent = win.Panel,
	}, {
		UI.Create("UIGridLayout", {
			CellSize = UDim2.new(0.2, -5, 0, 34),
			CellPadding = UDim2.fromOffset(5, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local topRow = UI.Create("Frame", {
		Name = "TargetRow",
		Position = UDim2.fromOffset(12, 148),
		Size = UDim2.new(1, -24, 0, 34),
		BackgroundTransparency = 1,
		Parent = win.Panel,
	})
	local targetBox = textBox(topRow, T("admin.targetHint"), UDim2.new(0.3, 0, 1, 0), "me")
	local status = UI.Label({
		Position = UDim2.new(0.31, 0, 0, 0),
		Size = UDim2.new(0.69, 0, 1, 0),
		Text = T("admin.ready"),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.SubText,
		MaxText = 17,
		Outline = 2,
		Parent = topRow,
	})
	win.Content.Position = UDim2.fromOffset(12, 190)
	win.Content.Size = UDim2.new(1, -24, 1, -202)

	local statusScale: UIScale = UI.Create("UIScale", { Scale = 1, Parent = status })
	local function setStatus(text: string, color: Color3)
		status.Text = text
		status.TextColor3 = color
		statusScale.Scale = 1.1
		TweenService:Create(statusScale, STATUS_POP_INFO, { Scale = 1 }):Play()
	end

	local function admin(action: string, args: { [string]: any }?): any
		local remote = remotes.Admin
		if not remote or not remote:IsA("RemoteFunction") then
			setStatus(T("core.noAnswer"), Theme.Red)
			return nil
		end
		local ok, result = pcall(function()
			return remote:InvokeServer(action, args or {})
		end)
		if ok and type(result) == "table" then
			local message = tostring(result.Message or "")
			setStatus(
				if result.Ok then T("admin.ok", message) else T("admin.fail", message),
				if result.Ok then Theme.Cash else Theme.Red
			)
			return result
		end
		setStatus(T("core.noAnswer"), Theme.Red)
		return nil
	end

	-- Gefährliche Aktion: erst beim zweiten Klick (innerhalb von CONFIRM_TIME Sekunden) ausführen
	local confirmKey: string? = nil
	local confirmAt = 0
	local function needsConfirm(key: string, label: string): boolean
		local now = os.clock()
		if confirmKey ~= key or now - confirmAt > CONFIRM_TIME then
			confirmKey = key
			confirmAt = now
			setStatus(T("admin.confirm", label), Theme.Orange)
			return true
		end
		confirmKey = nil
		return false
	end

	local function target(): string
		return targetBox.Text
	end

	-- Reiter-Seiten
	local TABS = {
		{ Id = "Players", Key = "admin.tabPlayers", Color = Theme.Blue },
		{ Id = "Powers", Key = "admin.tabPowers", Color = Theme.Green },
		{ Id = "Weapons", Key = "admin.tabWeapons", Color = Theme.Orange },
		{ Id = "Match", Key = "admin.tabMatch", Color = Theme.Purple },
		{ Id = "Events", Key = "admin.tabEvents", Color = Theme.Pink },
		{ Id = "Balance", Key = "admin.tabBalance", Color = Theme.Gold },
		{ Id = "Stats", Key = "admin.tabStats", Color = Theme.Cyan },
		{ Id = "Mod", Key = "admin.tabMod", Color = Theme.Red },
		{ Id = "Debug", Key = "admin.tabDebug", Color = Theme.Gray:Lerp(Theme.Blue, 0.4) },
	}
	local pages: { [string]: Frame } = {}
	local tabButtons: { [string]: any } = {}
	local onTabOpen: { [string]: () -> () } = {}
	local currentTab = "Players"
	local function selectTab(id: string)
		currentTab = id
		for pageId, page in pairs(pages) do
			page.Visible = pageId == id
			local scale = page:FindFirstChildOfClass("UIScale")
			if pageId == id and scale then
				scale.Scale = 0.95
				TweenService:Create(scale, TAB_POP_INFO, { Scale = 1 }):Play()
			end
		end
		for _, tab in ipairs(TABS) do
			local b = tabButtons[tab.Id]
			if b then
				b.SetColor(if tab.Id == id then tab.Color else Theme.Gray)
			end
		end
		win.Content.CanvasPosition = Vector2.zero
		local hook = onTabOpen[id]
		if hook then
			task.spawn(hook)
		end
	end
	for i, tab in ipairs(TABS) do
		pages[tab.Id] = UI.Create("Frame", {
			Name = tab.Id,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = i,
			Visible = false,
			Parent = win.Content,
		}, {
			UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
			UI.Create("UIScale", { Scale = 1 }),
		})
		tabButtons[tab.Id] = UI.Button({
			Size = UDim2.fromScale(1, 1),
			Text = T(tab.Key),
			Color = Theme.Gray,
			LayoutOrder = i,
			MaxText = 15,
			Parent = tabBar,
		}, function()
			selectTab(tab.Id)
		end)
	end

	local FULL = UDim2.new(1, 0, 1, 0)
	local function part(scale: number): UDim2
		return UDim2.new(scale, -6, 1, 0)
	end

	-- =================================================================
	-- REITER SPIELER
	-- =================================================================
	do
		local page = pages.Players
		UI.Section(page, T("admin.secPlayers"), 1)
		local listRow = UI.Row(page, 2, 40)
		local playerList = listFrame(page, 3)
		local function refresh()
			local result = admin("GetPlayers")
			if not result or not result.Ok or type(result.Data) ~= "table" then
				return
			end
			clearChildren(playerList)
			for i, info in ipairs(result.Data) do
				if type(info) == "table" then
					local row = UI.Row(playerList, i, 36)
					local text = T(
						"admin.playerRow",
						tostring(info.DisplayName),
						tostring(info.UserId),
						tonumber(info.Level) or 1,
						tonumber(info.PingMs) or 0,
						tonumber(info.MatchId) or 0,
						tonumber(info.Suspicion) or 0
					)
					UI.Label({
						Size = UDim2.new(0.64, 0, 1, 0),
						Text = (if info.IsAdmin then "🛠️ " else "") .. text,
						TextXAlignment = Enum.TextXAlignment.Left,
						MaxText = 16,
						Outline = 2,
						Parent = row,
					})
					button(row, T("admin.setTarget"), Theme.Blue, UDim2.new(0.17, 0, 1, 0), function()
						targetBox.Text = tostring(info.Name)
						setStatus(T("admin.targetSet", tostring(info.Name)), Theme.Cash)
					end)
					button(row, "👁", Theme.Purple, UDim2.new(0.15, 0, 1, 0), function()
						spectate(findPlayer(tostring(info.Name)))
					end)
				end
			end
		end
		button(listRow, T("admin.refresh"), Theme.Blue, part(0.3), refresh)
		onTabOpen.Players = refresh

		UI.Section(page, T("admin.secActions"), 4)
		local reasonRow = UI.Row(page, 5, 36)
		local reasonBox = textBox(reasonRow, T("admin.reasonHint"), FULL)
		local grid = UI.Grid(page, 6, 160, 40)
		local function act(key: string, color: Color3, fn: () -> ())
			button(grid, T(key), color, UDim2.fromScale(1, 1), fn)
		end
		act("admin.kick", Theme.Red, function()
			if needsConfirm("Kick" .. target(), T("admin.kick")) then
				return
			end
			admin("Kick", { Target = target(), Reason = reasonBox.Text })
		end)
		act("admin.warn", Theme.Orange, function()
			admin("Warn", { Target = target(), Text = reasonBox.Text })
		end)
		act("admin.freeze", Theme.Cyan, function()
			admin("Freeze", { Target = target(), On = true })
		end)
		act("admin.unfreeze", Theme.Blue, function()
			admin("Freeze", { Target = target(), On = false })
		end)
		act("admin.bring", Theme.Purple, function()
			admin("Bring", { Target = target() })
		end)
		act("admin.goto", Theme.Purple, function()
			admin("Goto", { Target = target() })
		end)
		act("admin.pop", Theme.Red, function()
			if needsConfirm("Pop" .. target(), T("admin.pop")) then
				return
			end
			admin("Pop", { Target = target() })
		end)
		act("admin.heal", Theme.Green, function()
			admin("Heal", { Target = target() })
		end)
		act("admin.spectate", Theme.Gray, function()
			local p = findPlayer(target())
			if not spectate(p) then
				setStatus(T("admin.noTarget"), Theme.Red)
			end
		end)

		UI.Section(page, T("admin.secBan"), 7)
		local banGrid = UI.Grid(page, 8, 120, 40)
		local idRow = UI.Row(page, 9, 40)
		local userIdBox = textBox(idRow, T("admin.userIdHint"), part(0.28))
		local out: Frame
		local function banArgs(duration: string): { [string]: any }
			local id = tonumber(userIdBox.Text)
			if id then
				return { UserId = id, Duration = duration, Reason = reasonBox.Text }
			end
			return { Target = target(), Duration = duration, Reason = reasonBox.Text }
		end
		for _, duration in ipairs({ "1h", "1d", "7d", "30d", "perm" }) do
			button(banGrid, T("admin.banFor", duration), Theme.Red, UDim2.fromScale(1, 1), function()
				local label = T("admin.banFor", duration)
				if needsConfirm("Ban" .. duration .. target() .. userIdBox.Text, label) then
					return
				end
				admin("Ban", banArgs(duration))
			end)
		end
		button(idRow, T("admin.unban"), Theme.Green, part(0.24), function()
			if needsConfirm("Unban" .. userIdBox.Text, T("admin.unban")) then
				return
			end
			admin("Unban", { UserId = tonumber(userIdBox.Text) })
		end)
		button(idRow, T("admin.banListBtn"), Theme.Blue, part(0.24), function()
			local result = admin("BanList")
			if result and result.Ok and type(result.Data) == "table" then
				local lines: { string } = {}
				for _, e in ipairs(result.Data) do
					if type(e) == "table" then
						table.insert(
							lines,
							T(
								"admin.banLine",
								tostring(e.Name),
								tostring(e.UserId),
								fmtTime(e.T),
								tostring(e.Duration),
								tostring(e.Reason),
								if e.Active then "" else " ✔"
							)
						)
					end
				end
				showLines(out, lines)
			end
		end)
		button(idRow, T("admin.banHistoryBtn"), Theme.Blue, part(0.24), function()
			local result = admin("BanHistory", { UserId = tonumber(userIdBox.Text) })
			if result and result.Ok and type(result.Data) == "table" then
				local lines: { string } = {}
				for _, e in ipairs(result.Data) do
					if type(e) == "table" then
						table.insert(
							lines,
							("%s · %s · %ss · %s"):format(
								if e.Ban then "BAN" else "UNBAN",
								tostring(e.StartTime),
								tostring(e.Duration),
								tostring(e.DisplayReason)
							)
						)
					end
				end
				showLines(out, lines)
			end
		end)

		UI.Section(page, T("admin.secGive"), 10)
		local giveRow = UI.Row(page, 11, 40)
		local coinsBox = textBox(giveRow, T("admin.coins"), part(0.19))
		local gemsBox = textBox(giveRow, T("admin.gems"), part(0.19))
		local keysBox = textBox(giveRow, T("admin.keys"), part(0.19))
		local shardsBox = textBox(giveRow, T("admin.shards"), part(0.19))
		button(giveRow, T("admin.give"), Theme.Green, part(0.24), function()
			admin("Give", {
				Target = target(),
				Grant = {
					Coins = tonumber(coinsBox.Text),
					Gems = tonumber(gemsBox.Text),
					Keys = tonumber(keysBox.Text),
					Shards = tonumber(shardsBox.Text),
				},
			})
		end)
		local xpRow = UI.Row(page, 12, 40)
		local xpBox = textBox(xpRow, T("admin.amount"), part(0.25))
		button(xpRow, T("admin.giveXp"), Theme.Green, part(0.25), function()
			admin("GiveXp", { Target = target(), Amount = tonumber(xpBox.Text) })
		end)
		local levelBox = textBox(xpRow, T("admin.level"), part(0.25))
		button(xpRow, T("admin.setLevel"), Theme.Orange, part(0.25), function()
			admin("SetLevel", { Target = target(), Level = tonumber(levelBox.Text) })
		end)

		UI.Section(page, T("admin.secData"), 13)
		local dataRow = UI.Row(page, 14, 40)
		button(dataRow, T("admin.playerData"), Theme.Blue, part(0.2), function()
			local result = admin("PlayerData", { Target = target() })
			if result and result.Ok and type(result.Data) == "table" then
				local lines: { string } = {}
				for _, key in ipairs(sortedKeys(result.Data)) do
					table.insert(lines, ("%s: %s"):format(key, tostring(result.Data[key])))
				end
				showLines(out, lines)
			end
		end)
		button(dataRow, T("admin.receiptsBtn"), Theme.Blue, part(0.18), function()
			local result = admin("Receipts", { Target = target() })
			if result and result.Ok and type(result.Data) == "table" then
				local lines: { string } = {}
				for _, r in ipairs(result.Data) do
					if type(r) == "table" then
						table.insert(lines, ("%s · %s"):format(tostring(r.Id), fmtTime(r.T)))
					end
				end
				showLines(out, lines)
			end
		end)
		local productBox = textBox(dataRow, T("admin.productHint"), part(0.22))
		button(dataRow, T("admin.regrant"), Theme.Orange, part(0.18), function()
			if needsConfirm("Regrant" .. productBox.Text, T("admin.regrant")) then
				return
			end
			admin("Regrant", { Target = target(), ProductKey = productBox.Text })
		end)
		button(dataRow, T("admin.resetData"), Theme.Red, part(0.22), function()
			if needsConfirm("Reset" .. target(), T("admin.resetData")) then
				return
			end
			admin("ResetData", { Target = target(), Confirm = true })
		end)
		out = listFrame(page, 20)
	end

	-- =================================================================
	-- REITER KRÄFTE (eigene Attribute)
	-- =================================================================
	do
		local page = pages.Powers
		textLine(page, T("admin.powersHint"), 1, Theme.Yellow)
		local grid = UI.Grid(page, 2, 160, 40)
		for i, info in ipairs(BOOL_POWERS) do
			local b: any = nil
			local function refresh()
				local on = player:GetAttribute(info.Name) == true
				b.SetText(("%s: %s"):format(T(info.Key), T(if on then "admin.on" else "admin.off")))
				b.SetColor(if on then Theme.Green else Theme.Gray)
			end
			b = UI.Button(
				{ Size = UDim2.fromScale(1, 1), Text = T(info.Key), MaxText = 15, LayoutOrder = i, Parent = grid },
				function()
					local on = player:GetAttribute(info.Name) == true
					admin("SetPower", { Name = info.Name, Value = not on })
				end
			)
			player:GetAttributeChangedSignal(info.Name):Connect(refresh)
			refresh()
		end
		local powers = Config.Security and Config.Security.Powers or {}
		local speed = powers.Speed or { Min = 16, Max = 150 }
		local jump = powers.Jump or { Min = 7.2, Max = 100 }
		local rapid = powers.RapidFire or { Min = 1, Max = 5 }
		local function sendNumber(name: string, minValue: number)
			return function(value: number)
				admin("SetPower", { Name = name, Value = if value <= minValue then nil else value })
			end
		end
		local speedMin = math.floor(speed.Min)
		local jumpMin = math.floor(jump.Min)
		local rapidMin = math.floor(rapid.Min)
		local speedSlider = slider(
			page,
			3,
			T("admin.pSpeed"),
			speedMin,
			math.floor(speed.Max),
			tonumber(player:GetAttribute("AdminSpeed")) or speedMin,
			sendNumber("AdminSpeed", speedMin)
		)
		local jumpSlider = slider(
			page,
			4,
			T("admin.pJump"),
			jumpMin,
			math.floor(jump.Max),
			tonumber(player:GetAttribute("AdminJump")) or jumpMin,
			sendNumber("AdminJump", jumpMin)
		)
		local rapidSlider = slider(
			page,
			5,
			T("admin.pRapid"),
			rapidMin,
			math.floor(rapid.Max),
			tonumber(player:GetAttribute("AdminRapidFire")) or rapidMin,
			sendNumber("AdminRapidFire", rapidMin)
		)
		player:GetAttributeChangedSignal("AdminSpeed"):Connect(function()
			speedSlider.Set(tonumber(player:GetAttribute("AdminSpeed")) or speedMin)
		end)
		player:GetAttributeChangedSignal("AdminJump"):Connect(function()
			jumpSlider.Set(tonumber(player:GetAttribute("AdminJump")) or jumpMin)
		end)
		player:GetAttributeChangedSignal("AdminRapidFire"):Connect(function()
			rapidSlider.Set(tonumber(player:GetAttribute("AdminRapidFire")) or rapidMin)
		end)
		local toolRow = UI.Row(page, 6, 40)
		button(toolRow, T("admin.flyNow"), Theme.Cyan, part(0.33), function()
			if not tryModule("Fly", "Toggle") then
				setStatus(T("admin.moduleMissing", "Fly"), Theme.Red)
			end
		end)
		button(toolRow, T("admin.photo"), Theme.Pink, part(0.33), function()
			if not tryModule("PhotoMode", "Toggle") then
				setStatus(T("admin.moduleMissing", "PhotoMode"), Theme.Red)
			end
		end)
		button(toolRow, T("admin.debugOverlay"), Theme.Gray, part(0.34), function()
			tryModule("DebugOverlay", "Toggle")
		end)
	end

	-- =================================================================
	-- REITER WAFFEN & ITEMS
	-- =================================================================
	do
		local page = pages.Weapons
		UI.Section(page, T("admin.secAdminWeapons"), 1)
		local adminGrid = UI.Grid(page, 2, 160, 40)
		local normalDefs: { any } = {}
		for _, def in ipairs(weaponDefs()) do
			if type(def) == "table" and def.AdminOnly == true then
				button(adminGrid, "⚡ " .. weaponName(def), Theme.Red, UDim2.fromScale(1, 1), function()
					admin("AdminWeapon", { Id = def.Id })
				end)
			elseif type(def) == "table" and type(def.Key) == "string" then
				table.insert(normalDefs, def)
			end
		end
		UI.Section(page, T("admin.secGiveWeapons"), 3)
		local grid = UI.Grid(page, 4, 130, 40)
		for _, def in ipairs(normalDefs) do
			button(grid, weaponName(def), Theme.Orange, UDim2.fromScale(1, 1), function()
				admin("Give", { Target = target(), Grant = { Weapons = { def.Key } } })
			end)
		end
		local row = UI.Row(page, 5, 40)
		button(row, T("admin.giveAll"), Theme.Green, part(0.3), function()
			if needsConfirm("GiveAll" .. target(), T("admin.giveAll")) then
				return
			end
			admin("GiveAll", { Target = target() })
		end)
		local cosmeticBox = textBox(row, T("admin.cosmeticHint"), part(0.45))
		button(row, T("admin.give"), Theme.Green, part(0.25), function()
			admin("Give", { Target = target(), Grant = { Cosmetics = { cosmeticBox.Text } } })
		end)
	end

	-- =================================================================
	-- REITER MATCH & SERVER
	-- =================================================================
	do
		local page = pages.Match
		local out: Frame
		UI.Section(page, T("admin.secMatches"), 1)
		local listRow = UI.Row(page, 2, 40)
		local matchList = listFrame(page, 3)
		local function refreshMatches()
			local result = admin("Matches")
			if not result or not result.Ok or type(result.Data) ~= "table" then
				return
			end
			clearChildren(matchList)
			if #result.Data == 0 then
				textLine(matchList, T("admin.noMatches"), 1, Theme.SubText)
			end
			for i, m in ipairs(result.Data) do
				if type(m) == "table" then
					local row = UI.Row(matchList, i, 36)
					local score = if type(m.Score) == "table" then table.concat(m.Score, ":") else "-"
					local who = if type(m.Players) == "table" then table.concat(m.Players, ", ") else ""
					UI.Label({
						Size = UDim2.new(0.76, 0, 1, 0),
						Text = ("#%s %s · %s · %s · %s · %s +%d🤖%s"):format(
							tostring(m.MatchId),
							tostring(m.Mode),
							tostring(m.Map),
							tostring(m.Phase),
							score,
							who,
							tonumber(m.Bots) or 0,
							if m.Tainted then " · TAINTED" else ""
						),
						TextXAlignment = Enum.TextXAlignment.Left,
						MaxText = 15,
						Outline = 2,
						Parent = row,
					})
					button(row, T("admin.endMatch"), Theme.Red, UDim2.new(0.22, 0, 1, 0), function()
						if needsConfirm("End" .. tostring(m.MatchId), T("admin.endMatch")) then
							return
						end
						admin("EndMatch", { MatchId = m.MatchId })
						task.delay(0.5, refreshMatches)
					end)
				end
			end
		end
		button(listRow, T("admin.refresh"), Theme.Blue, part(0.3), refreshMatches)
		onTabOpen.Match = refreshMatches

		UI.Section(page, T("admin.secStart"), 4)
		local grid = UI.Grid(page, 5, 210, 40)
		local modes = Config.Modes and Config.Modes.Modes or {}
		local maps = Config.Maps and Config.Maps.Maps or {}
		local moods = Config.Maps and Config.Maps.Moods or {}
		local mutators = Config.Modes and Config.Modes.Mutators or {}
		local difficulties = Config.Bots and Config.Bots.Order or sortedKeys(Config.Bots and Config.Bots.Difficulties)
		local modeList = sortedKeys(modes)
		local modeCycler = cycler(grid, T("admin.mode"), modeList, UDim2.fromScale(1, 1))
		local mapCycler = cycler(grid, T("admin.map"), sortedKeys(maps), UDim2.fromScale(1, 1), T("admin.random"))
		local moodCycler = cycler(grid, T("admin.mood"), sortedKeys(moods), UDim2.fromScale(1, 1), T("admin.random"))
		local mutCycler = cycler(grid, T("admin.mutator"), sortedKeys(mutators), UDim2.fromScale(1, 1), "-")
		local diffCycler = cycler(grid, T("admin.difficulty"), difficulties, UDim2.fromScale(1, 1))
		diffCycler.Set("Normal")
		local botCycler =
			cycler(grid, T("admin.bots"), { "0", "1", "2", "3", "4", "5", "6", "7" }, UDim2.fromScale(1, 1), "auto")
		local startRow = UI.Row(page, 6, 40)
		local idsBox = textBox(startRow, T("admin.userIdsHint"), part(0.65))
		button(startRow, T("admin.startMatch"), Theme.Green, part(0.35), function()
			admin("StartMatch", {
				Mode = modeCycler.Get(),
				Map = mapCycler.Get(),
				Mood = moodCycler.Get(),
				Mutator = mutCycler.Get(),
				UserIds = idsBox.Text,
				BotDifficulty = diffCycler.Get(),
				Bots = tonumber(botCycler.Get() or ""),
			})
			task.delay(1, refreshMatches)
		end)

		UI.Section(page, T("admin.secServer"), 7)
		local serverGrid = UI.Grid(page, 8, 160, 40)
		button(serverGrid, T("admin.spawnBot"), Theme.Orange, UDim2.fromScale(1, 1), function()
			admin("SpawnBot", { Difficulty = diffCycler.Get() })
		end)
		button(serverGrid, T("admin.fillPads"), Theme.Orange, UDim2.fromScale(1, 1), function()
			admin("FillPads")
		end)
		button(serverGrid, T("admin.lock"), Theme.Red, UDim2.fromScale(1, 1), function()
			admin("LockServer", { On = true })
		end)
		button(serverGrid, T("admin.unlock"), Theme.Green, UDim2.fromScale(1, 1), function()
			admin("LockServer", { On = false })
		end)
		local reasonRow = UI.Row(page, 9, 40)
		local reasonBox = textBox(reasonRow, T("admin.reasonHint"), part(0.5))
		button(reasonRow, T("admin.kickAll"), Theme.Red, part(0.25), function()
			if needsConfirm("KickAll", T("admin.kickAll")) then
				return
			end
			admin("KickAll", { Reason = reasonBox.Text })
		end)
		button(reasonRow, T("admin.serverInfo"), Theme.Blue, part(0.25), function()
			local result = admin("ServerInfo")
			if result and result.Ok and type(result.Data) == "table" then
				local d = result.Data
				local lines: { string } = {
					T(
						"admin.infoPlayers",
						tonumber(d.Players) or 0,
						tonumber(d.MaxPlayers) or 0,
						tonumber(d.Bots) or 0
					),
					T("admin.infoLoad", tonumber(d.HeartbeatMs) or 0, tonumber(d.HeartbeatMaxMs) or 0),
					T(
						"admin.infoMisc",
						tonumber(d.Projectiles) or 0,
						tonumber(d.MemoryMb) or 0,
						tonumber(d.Uptime) or 0
					),
					T("admin.infoVersion", tostring(d.Version), tostring(d.JobId), tonumber(d.Balance) or 0),
				}
				if type(d.Slots) == "table" then
					for _, s in ipairs(d.Slots) do
						if type(s) == "table" then
							table.insert(
								lines,
								("  Slot %s: %s %s"):format(
									tostring(s.Slot),
									tostring(s.State),
									tostring(s.MapKey or "")
								)
							)
						end
					end
				end
				if d.Locked then
					table.insert(lines, T("admin.locked"))
				end
				showLines(out, lines)
			end
		end)
		out = listFrame(page, 10)
	end

	-- =================================================================
	-- REITER EVENTS
	-- =================================================================
	do
		local page = pages.Events
		local security = Config.Security or {}
		UI.Section(page, T("admin.secAnnounce"), 1)
		local textRow = UI.Row(page, 2, 40)
		local announceBox = textBox(textRow, T("admin.announceHint", security.AnnounceMax or 200), FULL)
		local announceRow = UI.Row(page, 3, 40)
		button(announceRow, T("admin.announce"), Theme.Blue, part(0.5), function()
			admin("Announce", { Text = announceBox.Text, Global = false })
		end)
		button(announceRow, T("admin.announceGlobal"), Theme.Purple, part(0.5), function()
			if needsConfirm("AnnounceGlobal", T("admin.announceGlobal")) then
				return
			end
			admin("Announce", { Text = announceBox.Text, Global = true })
		end)

		UI.Section(page, T("admin.secAbuse"), 4)
		local minutesSlider = slider(
			page,
			5,
			T("admin.minutes"),
			1,
			security.AdminAbuseMaxMinutes or 60,
			5,
			function() end
		)
		local abuseRow = UI.Row(page, 6, 40)
		local coins2, xp2 = true, true
		local coinsBtn: any = nil
		local xpBtn: any = nil
		local function refreshBoost()
			coinsBtn.SetText(("2x Coins: %s"):format(T(if coins2 then "admin.on" else "admin.off")))
			coinsBtn.SetColor(if coins2 then Theme.Gold else Theme.Gray)
			xpBtn.SetText(("2x XP: %s"):format(T(if xp2 then "admin.on" else "admin.off")))
			xpBtn.SetColor(if xp2 then Theme.Cyan else Theme.Gray)
		end
		coinsBtn = button(abuseRow, "2x Coins", Theme.Gold, part(0.25), function()
			coins2 = not coins2
			refreshBoost()
		end)
		xpBtn = button(abuseRow, "2x XP", Theme.Cyan, part(0.25), function()
			xp2 = not xp2
			refreshBoost()
		end)
		refreshBoost()
		button(abuseRow, T("admin.abuseStartBtn"), Theme.Green, part(0.25), function()
			admin("AdminAbuse", { Minutes = minutesSlider.Get(), Coins2 = coins2, Xp2 = xp2, Global = false })
		end)
		button(abuseRow, T("admin.global"), Theme.Purple, part(0.25), function()
			if needsConfirm("AbuseGlobal", T("admin.abuse")) then
				return
			end
			admin("AdminAbuse", { Minutes = minutesSlider.Get(), Coins2 = coins2, Xp2 = xp2, Global = true })
		end)

		UI.Section(page, T("admin.secMutator"), 7)
		local mutRow = UI.Row(page, 8, 40)
		local mutators = Config.Modes and Config.Modes.Mutators or {}
		local mutCycler = cycler(mutRow, T("admin.mutator"), sortedKeys(mutators), part(0.4), "-")
		button(mutRow, T("admin.setBtn"), Theme.Green, part(0.2), function()
			admin("Mutator", { Key = mutCycler.Get(), Global = false })
		end)
		button(mutRow, T("admin.global"), Theme.Purple, part(0.2), function()
			if needsConfirm("MutatorGlobal", T("admin.mutator")) then
				return
			end
			admin("Mutator", { Key = mutCycler.Get(), Global = true })
		end)
		button(mutRow, T("admin.off"), Theme.Gray, part(0.2), function()
			admin("Mutator", { Key = nil, Global = false })
		end)

		UI.Section(page, T("admin.secFun"), 9)
		local funRow = UI.Row(page, 10, 40)
		button(funRow, T("admin.confettiBtn"), Theme.Pink, part(0.33), function()
			admin("Confetti")
		end)
		local gravity = security.LobbyGravity or { Min = 50, Max = 196.2 }
		local gravitySlider = slider(
			page,
			11,
			T("admin.gravityBtn"),
			math.floor(gravity.Min),
			math.floor(gravity.Max),
			math.floor(gravity.Max),
			function(value: number)
				admin("LobbyGravity", { Value = if value >= math.floor(gravity.Max) then gravity.Max else value })
			end
		)
		button(funRow, T("admin.gravityNormal"), Theme.Blue, part(0.33), function()
			gravitySlider.Set(gravity.Max)
			admin("LobbyGravity", { Value = gravity.Max })
		end)
		local lookRow = UI.Row(page, 12, 40)
		local moods = Config.Maps and Config.Maps.Moods or {}
		local moodCycler = cycler(lookRow, T("admin.mood"), sortedKeys(moods), part(0.6))
		button(lookRow, T("admin.lookBtn"), Theme.Gold, part(0.4), function()
			admin("LobbyLook", { Mood = moodCycler.Get() })
		end)
	end

	-- =================================================================
	-- REITER BALANCE (Live)
	-- =================================================================
	do
		local page = pages.Balance
		local out: Frame
		local balanceData: any = nil
		local headRow = UI.Row(page, 1, 40)
		local infoLabel = UI.Label({
			Size = UDim2.new(0.7, -6, 1, 0),
			Text = T("admin.balanceHint"),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 16,
			Outline = 2,
			LayoutOrder = 2,
			Parent = headRow,
		})
		local keys: { string } = {}
		for _, def in ipairs(weaponDefs()) do
			if type(def) == "table" and type(def.Key) == "string" then
				table.insert(keys, def.Key)
			end
		end
		local fields = sortedKeys(Config.Weapons and Config.Weapons.BalanceFields)
		local pickRow = UI.Row(page, 2, 40)
		local weaponCycler = cycler(pickRow, T("admin.weapon"), keys, part(0.5))
		local fieldCycler = cycler(pickRow, T("admin.field"), fields, part(0.5))
		local currentLabel = textLine(page, "", 3, Theme.Yellow)
		local function showCurrent()
			local weapon, field = weaponCycler.Get(), fieldCycler.Get()
			if not weapon or not field then
				currentLabel.Text = ""
				return
			end
			local bounds = Config.Weapons and Config.Weapons.BalanceFields and Config.Weapons.BalanceFields[field]
			local base: any = "?"
			local now: any = "-"
			if balanceData then
				local d = balanceData.Defaults and balanceData.Defaults[weapon]
				base = if d and d[field] ~= nil then d[field] else "-"
				local o = balanceData.Overrides and balanceData.Overrides[weapon]
				now = if o and o[field] ~= nil then o[field] else base
			end
			currentLabel.Text = T(
				"admin.fieldInfo",
				tostring(base),
				tostring(now),
				tostring(bounds and bounds[1] or "?"),
				tostring(bounds and bounds[2] or "?")
			)
		end
		weaponCycler.OnChange = function()
			showCurrent()
		end
		fieldCycler.OnChange = function()
			showCurrent()
		end
		local function load()
			local result = admin("GetBalance")
			if not result or not result.Ok or type(result.Data) ~= "table" then
				return
			end
			balanceData = result.Data
			infoLabel.Text = T(
				"admin.balanceInfo",
				tonumber(balanceData.Version) or 0,
				if balanceData.Preview then T("admin.previewOn") else ""
			)
			local lines: { string } = {}
			for _, weapon in ipairs(sortedKeys(balanceData.Overrides)) do
				local parts: { string } = {}
				for _, field in ipairs(sortedKeys(balanceData.Overrides[weapon])) do
					table.insert(parts, ("%s=%s"):format(field, tostring(balanceData.Overrides[weapon][field])))
				end
				table.insert(lines, ("%s: %s"):format(weapon, table.concat(parts, ", ")))
			end
			for _, weapon in ipairs(sortedKeys(balanceData.Disabled)) do
				table.insert(lines, T("admin.offLine", weapon))
			end
			if type(balanceData.History) == "table" then
				table.insert(lines, T("admin.history"))
				for _, h in ipairs(balanceData.History) do
					if type(h) == "table" then
						table.insert(
							lines,
							T(
								"admin.historyLine",
								tonumber(h.Version) or 0,
								fmtTime(h.T),
								tostring(h.ByName),
								tonumber(h.Changes) or 0,
								tonumber(h.Off) or 0
							)
						)
					end
				end
			end
			showLines(out, lines)
			showCurrent()
		end
		local loadBtn = button(headRow, T("admin.loadBalance"), Theme.Blue, part(0.3), load)
		loadBtn.Frame.LayoutOrder = 1
		onTabOpen.Balance = load
		local setRow = UI.Row(page, 4, 40)
		local valueBox = textBox(setRow, T("admin.value"), part(0.4))
		button(setRow, T("admin.setField"), Theme.Orange, part(0.6), function()
			admin(
				"SetField",
				{ Weapon = weaponCycler.Get(), Field = fieldCycler.Get(), Value = tonumber(valueBox.Text) }
			)
			load()
		end)
		local actRow = UI.Row(page, 5, 40)
		button(actRow, T("admin.save"), Theme.Green, part(0.28), function()
			if needsConfirm("SaveBalance", T("admin.save")) then
				return
			end
			admin("SaveBalance")
			load()
		end)
		button(actRow, T("admin.resetWeapon"), Theme.Blue, part(0.26), function()
			admin("ResetWeapon", { Weapon = weaponCycler.Get() })
			load()
		end)
		button(actRow, T("admin.kill"), Theme.Red, part(0.23), function()
			local weapon = weaponCycler.Get()
			if needsConfirm("Kill" .. tostring(weapon), T("admin.kill")) then
				return
			end
			admin("SetEnabled", { Weapon = weapon, On = false })
			load()
		end)
		button(actRow, T("admin.enable"), Theme.Green, part(0.23), function()
			admin("SetEnabled", { Weapon = weaponCycler.Get(), On = true })
			load()
		end)
		local revertRow = UI.Row(page, 6, 40)
		local versionBox = textBox(revertRow, T("admin.versionHint"), part(0.4))
		button(revertRow, T("admin.revert"), Theme.Orange, part(0.6), function()
			if needsConfirm("Revert" .. versionBox.Text, T("admin.revert")) then
				return
			end
			admin("Revert", { Version = tonumber(versionBox.Text) })
			load()
		end)
		out = listFrame(page, 7)
		showCurrent()
	end

	-- =================================================================
	-- REITER STATISTIK
	-- =================================================================
	do
		local page = pages.Stats
		local out: Frame
		local row = UI.Row(page, 1, 40)
		local function load(days: number)
			setStatus(T("core.loading"), Theme.SubText)
			local result = admin("GetStats", { Days = days })
			if not result or not result.Ok or type(result.Data) ~= "table" then
				return
			end
			local d = result.Data
			local lines: { string } = {
				T(
					"admin.statsHead",
					tonumber(d.Days) or days,
					math.floor(tonumber(d.Matches) or 0),
					tonumber(d.BotPct) or 0,
					tonumber(d.AvgQueue) or 0
				),
			}
			if type(d.Weapons) == "table" then
				for _, w in ipairs(d.Weapons) do
					if type(w) == "table" then
						table.insert(
							lines,
							T(
								"admin.statsWeapon",
								tostring(w.Key),
								math.floor(tonumber(w.Picks) or 0),
								tonumber(w.PickPct) or 0,
								math.floor(tonumber(w.Pops) or 0),
								tonumber(w.PopsPerMatch) or 0,
								tonumber(w.WinPct) or 0,
								tonumber(w.HeadPct) or 0,
								tonumber(w.AccuracyPct) or 0
							) .. (if w.BuffFirst then "  ⬆ " .. T("admin.buffFirst") else "")
						)
					end
				end
			end
			local function listLine(title: string, list: any)
				if type(list) ~= "table" or #list == 0 then
					return
				end
				local parts: { string } = {}
				for _, e in ipairs(list) do
					if type(e) == "table" then
						table.insert(parts, ("%s %d"):format(tostring(e.Key), tonumber(e.Picks) or 0))
					end
				end
				table.insert(lines, title .. ": " .. table.concat(parts, " · "))
			end
			listLine(T("admin.statsMaps"), d.Maps)
			listLine(T("admin.statsModes"), d.Modes)
			if type(d.Queue) == "table" then
				for _, q in ipairs(d.Queue) do
					if type(q) == "table" then
						table.insert(lines, T("admin.statsQueue", tostring(q.Mode), tonumber(q.Seconds) or 0))
					end
				end
			end
			showLines(out, lines)
		end
		button(row, T("admin.days1"), Theme.Cyan, part(0.5), function()
			load(1)
		end)
		button(row, T("admin.days7"), Theme.Blue, part(0.5), function()
			load(7)
		end)
		out = listFrame(page, 2)
	end

	-- =================================================================
	-- REITER MODERATION
	-- =================================================================
	do
		local page = pages.Mod
		local row = UI.Row(page, 1, 40)
		local list = listFrame(page, 2)
		local mode = "Flags"
		local function load(kind: string)
			mode = kind
			local result = admin(kind)
			if not result or not result.Ok or type(result.Data) ~= "table" then
				return
			end
			clearChildren(list)
			if #result.Data == 0 then
				textLine(list, T("admin.nothing"), 1, Theme.SubText)
			end
			for i, e in ipairs(result.Data) do
				if i > 60 then
					break
				end
				if type(e) == "table" then
					local text
					if kind == "Flags" then
						local reasons = if type(e.Reasons) == "table" then table.concat(e.Reasons, ", ") else ""
						text = T(
							"admin.flagLine",
							tostring(e.Name),
							tostring(e.UserId),
							tonumber(e.Score) or 0,
							reasons,
							fmtTime(e.T)
						)
					else
						text = T(
							"admin.reportLine",
							tostring(e.FromName),
							tostring(e.Name),
							tostring(e.Reason),
							type(e.Snapshot) == "table" and tostring(e.Snapshot.HeadPct) or "?",
							type(e.Snapshot) == "table" and tostring(e.Snapshot.Accuracy) or "?",
							fmtTime(e.T)
						)
					end
					local card = UI.Card({
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						LayoutOrder = i,
						Parent = list,
					})
					UI.Create(
						"UIListLayout",
						{ SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = card }
					)
					UI.Create("UIPadding", {
						PaddingLeft = UDim.new(0, 6),
						PaddingRight = UDim.new(0, 6),
						PaddingTop = UDim.new(0, 4),
						PaddingBottom = UDim.new(0, 4),
						Parent = card,
					})
					textLine(card, text, 1)
					local actions = UI.Row(card, 2, 34)
					local userId = tonumber(e.UserId)
					button(actions, "👁", Theme.Purple, part(0.14), function()
						spectate(if userId then Players:GetPlayerByUserId(userId) else nil)
					end)
					for _, duration in ipairs({ "1d", "7d", "perm" }) do
						button(actions, T("admin.banFor", duration), Theme.Red, part(0.18), function()
							if needsConfirm("ModBan" .. tostring(userId) .. duration, T("admin.banFor", duration)) then
								return
							end
							admin("Ban", { UserId = userId, Duration = duration, Reason = T("admin.modReason") })
						end)
					end
					button(actions, T("admin.dismiss"), Theme.Gray, part(0.32), function()
						admin("DismissFlag", { Id = e.Id })
						load(mode)
					end)
				end
			end
		end
		button(row, T("admin.flagsBtn"), Theme.Red, part(0.5), function()
			load("Flags")
		end)
		button(row, T("admin.reportsBtn"), Theme.Orange, part(0.5), function()
			load("Reports")
		end)
	end

	-- =================================================================
	-- REITER DEBUG
	-- =================================================================
	do
		local page = pages.Debug
		local products: { string } = {}
		local shop = Config.Shop
		if shop and type(shop.Products) == "table" then
			for _, product in ipairs(shop.Products) do
				if type(product) == "table" and type(product.Key) == "string" then
					table.insert(products, product.Key)
				end
			end
		end
		UI.Section(page, T("admin.secShopTest"), 1)
		local buyRow = UI.Row(page, 2, 40)
		local productCycler = cycler(buyRow, T("admin.product"), products, part(0.6))
		button(buyRow, T("admin.simPurchase"), Theme.Green, part(0.4), function()
			admin("SimulatePurchase", { ProductKey = productCycler.Get() })
		end)
		local policyRow = UI.Row(page, 3, 40)
		button(policyRow, T("admin.policyAllowedBtn"), Theme.Green, part(0.34), function()
			admin("SimulatePolicy", { Allowed = true })
		end)
		button(policyRow, T("admin.policyRestrictedBtn"), Theme.Red, part(0.33), function()
			admin("SimulatePolicy", { Allowed = false })
		end)
		button(policyRow, T("admin.policyAutoBtn"), Theme.Gray, part(0.33), function()
			admin("SimulatePolicy", {})
		end)
		UI.Section(page, T("admin.secTools"), 4)
		local toolRow = UI.Row(page, 5, 40)
		button(toolRow, T("admin.skipDay"), Theme.Orange, part(0.5), function()
			admin("SkipDay")
		end)
		button(toolRow, T("admin.unlockAll"), Theme.Purple, part(0.5), function()
			if needsConfirm("UnlockAll", T("admin.unlockAll")) then
				return
			end
			admin("UnlockAll")
		end)
		local flagRow = UI.Row(page, 6, 40)
		local flags = {
			{ Key = "ShowHitboxes", Label = "admin.hitboxes" },
			{ Key = "LogRejects", Label = "admin.rejects" },
			{ Key = "BotPaths", Label = "admin.botPaths" },
		}
		for _, info in ipairs(flags) do
			local b: any = nil
			local function refresh()
				local on = workspace:GetAttribute("Debug" .. info.Key) == true
				b.SetText(("%s: %s"):format(T(info.Label), T(if on then "admin.on" else "admin.off")))
				b.SetColor(if on then Theme.Green else Theme.Gray)
			end
			b = button(flagRow, T(info.Label), Theme.Gray, part(0.333), function()
				local on = workspace:GetAttribute("Debug" .. info.Key) == true
				admin("SetDebug", { [info.Key] = not on })
			end)
			workspace:GetAttributeChangedSignal("Debug" .. info.Key):Connect(refresh)
			refresh()
		end
		local lastRow = UI.Row(page, 7, 40)
		button(lastRow, T("admin.selfTest"), Theme.Blue, part(0.5), function()
			admin("RunSelfTest")
		end)
		button(lastRow, T("admin.debugOverlay"), Theme.Gray, part(0.5), function()
			tryModule("DebugOverlay", "Toggle")
		end)
	end

	selectTab(currentTab)
	-- Beim Öffnen den aktuellen Reiter auffrischen
	win.OnOpen = function()
		local hook = onTabOpen[currentTab]
		if hook then
			task.spawn(hook)
		end
	end
end

-- =====================================================================
-- ÖFFENTLICHE API + LEBENSZYKLUS
-- =====================================================================
local function openWindow()
	if player:GetAttribute("IsAdmin") ~= true then
		return
	end
	build()
	if win and not win.IsOpen then
		UI.OpenWindow(win) -- ruft win.OnOpen selbst auf (aktueller Reiter wird aufgefrischt)
	end
end

local function closeWindow()
	if win and win.IsOpen then
		UI.CloseWindow(win)
	end
end

function AdminPanel.Toggle()
	local windows = ctx and ctx.Windows
	if windows and type(windows.IsOpen) == "function" and type(windows.Open) == "function" then
		if windows.IsOpen(WINDOW_NAME) then
			windows.Close(WINDOW_NAME)
		else
			windows.Open(WINDOW_NAME)
		end
		return
	end
	if win and win.IsOpen then
		closeWindow()
	else
		openWindow()
	end
end

function AdminPanel.Init(context: any)
	ctx = context
	UI = ctx.UI or require(script.Parent:WaitForChild("UI"))
	Theme = UI.Theme
	local windows = ctx.Windows
	if windows and type(windows.Register) == "function" then
		windows.Register(WINDOW_NAME, openWindow, closeWindow)
	end
end

function AdminPanel.Start()
	if player:GetAttribute("IsAdmin") ~= true then
		return
	end
	-- Rechter HUD-Knopf (Order 99)
	local hud = module("Hud")
	if hud and type(hud.AddRightButton) == "function" then
		pcall(hud.AddRightButton, "🛠️", "admin.button", Theme.Red, 99, AdminPanel.Toggle)
	end
	-- Taste P (über Controls, sonst direkt)
	local controls = module("Controls")
	local bound = false
	if controls and type(controls.Bind) == "function" then
		bound = pcall(controls.Bind, "AdminPanel", function(state: string)
			if state == "Begin" then
				AdminPanel.Toggle()
			end
		end)
	end
	local keys = ctx.Config and ctx.Config.Client and ctx.Config.Client.Keys or {}
	local function codeOf(list: any, fallback: Enum.KeyCode): Enum.KeyCode
		if type(list) == "table" and type(list[1]) == "string" then
			local ok, code = pcall(function()
				return (Enum.KeyCode :: any)[list[1]]
			end)
			if ok and typeof(code) == "EnumItem" then
				return code :: any
			end
		end
		return fallback
	end
	local panelKey = codeOf(keys.AdminPanel, Enum.KeyCode.P)
	local spectateKey = codeOf(keys.Spectate, Enum.KeyCode.X)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		if not bound and input.KeyCode == panelKey then
			AdminPanel.Toggle()
		elseif input.KeyCode == spectateKey and spectating then
			stopSpectate()
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		if p == spectating then
			stopSpectate()
		end
	end)
end

return AdminPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">AdminTools</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Admin-Kräfte auf dem Client (Client/Modules/AdminTools)
--  Besitzer: WP7 (Sicherheit, Admin, Live-Balance). Vertrag: DESIGN.md B25.2/B25.3 (Kräfte), B14.4, docs/ADMIN-WUENSCHE.md.
--  Nur für den Besitzer (Modul lädt nur bei IsAdmin). Alle Kräfte sind Attribute am eigenen Player, die NUR der
--  Server setzt (SetPower) – und der Server ehrt sie nur bei IsAdmin. Hier passiert nur die lokale Seite:
--    * ESP / Wallhack (AdminESP): ≤ 20 Highlights über den zentralen Verteiler "Highlights" (AlwaysOnTop) +
--      Name, Leben und Abstand über dem Kopf.
--    * Sichtbarer Aimbot (AdminAimbot): zieht die Kamera sanft auf den Kopf des nächsten sichtbaren Gegners,
--      solange Zielen oder Feuern gehalten wird (über FpsCamera.AddLookDelta, Vorzeichen wird selbst erkannt).
--    * Silent Aim (AdminSilentAim) / Triggerbot (AdminTriggerbot): AdminTools.AimTarget() / AdminTools.WantsFire()
--      für den Feuer-Haken von WeaponClient (WP4); Hook "AdminTrigger"(on) bei jeder Änderung.
--    * Noclip lokal (AdminNoclip), Tempo (AdminSpeed) und Super-Sprung (AdminJump) am eigenen Humanoid.
--    * Rotes Schild "TAINTED / Admin-Show", solange das aktuelle Match getaintet ist (Attribut TaintedMatch).
--    * Lobby-Licht-Event (Effect "LobbyLook") sofort lokal über ArenaLook.ApplyMood anzeigen.
--
--  Öffentliche API:
--    AdminTools.WantsFire(): boolean                 Triggerbot: Fadenkreuz liegt auf einem Gegner
--    AdminTools.AimTarget(): (number?, Vector3?)     Silent Aim/Aimbot: CombatantId + Kopfposition des Ziels
--    AdminTools.Init(ctx) / AdminTools.Start()
-- =====================================================================

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local AdminTools = {}

local player = Players.LocalPlayer
local ctx: any = nil

local ESP_OWNER = "AdminESP"
local ESP_MAX = 20
local ESP_HZ = 4
local ESP_RANGE = 2000
local ESP_COLOR = Color3.fromRGB(255, 60, 60)
local AIM_CONE = math.rad(25) -- sichtbarer Aimbot: nur Ziele in diesem Kegel um das Fadenkreuz
local AIM_SPEED = 14 -- je größer, desto schneller rastet die Kamera ein
local AIM_RANGE = 500
local SILENT_CONE = math.rad(60)
local TRIGGER_RANGE = 1000
local FLIP_COOLDOWN = 0.5

type Target = { Model: Model, Id: number, Head: BasePart, Root: BasePart }
type EspSlot = { Gui: BillboardGui, Label: TextLabel, Model: Model?, Handle: any? }

local armedInfo: { Ctx: string?, Team: number? }? = nil
local photoHidden = false
local wantsFire = false
local aimTarget: Target? = nil

local espSlots: { EspSlot } = {}
local espAcc = 0
local espActive = false

local noclipParts: { [BasePart]: boolean } = {}
local speedOverridden = false
local jumpOverridden = false

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local signX, signY = 1, 1
local lastErrX, lastErrY = 0, 0
local lastFlipX, lastFlipY = 0, 0
local applied = false

local taintSign: TextLabel? = nil

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function module(name: string): any
	local modules = ctx and ctx.Modules
	return if type(modules) == "table" then modules[name] else nil
end

local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function power(name: string): any
	if player:GetAttribute("IsAdmin") ~= true then
		return nil
	end
	return player:GetAttribute(name)
end

local function fireHook(name: string, ...: any)
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.Fire) == "function" then
		hooks.Fire(name, ...)
	end
end

local function isArmed(): boolean
	local weapon = module("WeaponClient")
	if weapon and type(weapon.IsArmed) == "function" then
		local ok, result = pcall(weapon.IsArmed)
		if ok then
			return result == true
		end
	end
	return armedInfo ~= nil
end

local function aimingHeld(): boolean
	local controls = module("Controls")
	if controls and type(controls.IsDown) == "function" then
		local okAds, ads = pcall(controls.IsDown, "Ads")
		local okFire, fire = pcall(controls.IsDown, "Fire")
		return (okAds and ads == true) or (okFire and fire == true)
	end
	return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
end

-- Alle Modelle, die Combatants sein können (Spieler, Bots, Übungspuppen)
local function candidateModels(): { Model }
	local list: { Model } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			table.insert(list, p.Character)
		end
	end
	for _, tag in ipairs({ "Bot", "Dummy" }) do
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			if inst:IsA("Model") and not table.find(list, inst) then
				table.insert(list, inst)
			end
		end
	end
	return list
end

-- Gegner im eigenen Kontext? (bewaffnet: gleicher Ctx, anderes Team bzw. FFA; Lobby: jeder andere Spieler)
local function isEnemy(model: Model): boolean
	if model == player.Character then
		return false
	end
	if model:GetAttribute("Alive") == false then
		return false
	end
	local info = armedInfo
	if not info or not info.Ctx then
		return Players:GetPlayerFromCharacter(model) ~= nil
	end
	if model:GetAttribute("Ctx") ~= info.Ctx then
		return false
	end
	local team = model:GetAttribute("Team")
	local myTeam = info.Team or 0
	return myTeam == 0 or team == nil or team ~= myTeam
end

local function targetOf(model: Model): Target?
	local head = model:FindFirstChild("Head")
	local root = model:FindFirstChild("HumanoidRootPart")
	local id = model:GetAttribute("CombatantId")
	if head and root and head:IsA("BasePart") and root:IsA("BasePart") and type(id) == "number" then
		return { Model = model, Id = id, Head = head, Root = root }
	end
	return nil
end

local filterCharacter: Model? = nil
local filterCamera: Camera? = nil

local function refreshRayFilter()
	local camera = workspace.CurrentCamera
	if player.Character == filterCharacter and camera == filterCamera then
		return
	end
	filterCharacter = player.Character
	filterCamera = camera
	local list: { Instance } = {}
	if player.Character then
		table.insert(list, player.Character)
	end
	if camera then
		table.insert(list, camera)
	end
	rayParams.ExcludeInstances = list
end

local function visible(target: Target, from: Vector3): boolean
	local direction = target.Head.Position - from
	if direction.Magnitude > AIM_RANGE * 2 then
		return false
	end
	local result = workspace:Raycast(from, direction, rayParams)
	if not result then
		return true
	end
	return result.Instance:IsDescendantOf(target.Model)
end

-- Gegner mit dem kleinsten Winkel zum Fadenkreuz (optional nur sichtbare)
local function bestTarget(cone: number, needVisible: boolean): Target?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local cf = camera.CFrame
	local best: Target? = nil
	local bestAngle = cone
	for _, model in ipairs(candidateModels()) do
		if isEnemy(model) then
			local target = targetOf(model)
			if target then
				local offset = target.Head.Position - cf.Position
				local dist = offset.Magnitude
				if dist > 0.5 and dist <= AIM_RANGE then
					local angle = math.acos(math.clamp(cf.LookVector:Dot(offset.Unit), -1, 1))
					if angle < bestAngle and (not needVisible or visible(target, cf.Position)) then
						best = target
						bestAngle = angle
					end
				end
			end
		end
	end
	return best
end

local function wrapAngle(a: number): number
	return (a + math.pi) % (2 * math.pi) - math.pi
end

-- ---------------------------------------------------------------------
-- AIMBOT (sichtbar, sanft)
-- ---------------------------------------------------------------------
local function aimStep(dt: number, target: Target)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local cf = camera.CFrame
	local dir = (target.Head.Position - cf.Position).Unit
	local look = cf.LookVector
	local errX = wrapAngle(math.atan2(-dir.X, -dir.Z) - math.atan2(-look.X, -look.Z)) -- + = Ziel links
	local errY = math.asin(math.clamp(dir.Y, -1, 1)) - math.asin(math.clamp(look.Y, -1, 1)) -- + = Ziel oben
	local alpha = 1 - math.exp(-AIM_SPEED * math.clamp(dt, 0, 0.1))
	local camera3 = module("FpsCamera")
	if camera3 and type(camera3.AddLookDelta) == "function" then
		-- Vorzeichen selbst erkennen: wurde der Fehler nach dem letzten Schritt deutlich größer -> umdrehen
		local now = os.clock()
		if applied then
			if math.abs(lastErrX) > 0.01 and math.abs(errX) > math.abs(lastErrX) * (1 + alpha * 0.5) then
				if now - lastFlipX > FLIP_COOLDOWN then
					signX = -signX
					lastFlipX = now
				end
			end
			if math.abs(lastErrY) > 0.01 and math.abs(errY) > math.abs(lastErrY) * (1 + alpha * 0.5) then
				if now - lastFlipY > FLIP_COOLDOWN then
					signY = -signY
					lastFlipY = now
				end
			end
		end
		-- Maus-Konvention: positives dx dreht nach rechts, positives dy nach unten
		pcall(camera3.AddLookDelta, -errX * alpha * signX, -errY * alpha * signY)
		applied = true
	else
		camera.CFrame = cf:Lerp(CFrame.lookAt(cf.Position, target.Head.Position), alpha)
		applied = false
	end
	lastErrX, lastErrY = errX, errY
end

-- ---------------------------------------------------------------------
-- TRIGGERBOT
-- ---------------------------------------------------------------------
local function crosshairOnEnemy(): boolean
	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end
	local cf = camera.CFrame
	local result = workspace:Raycast(cf.Position, cf.LookVector * TRIGGER_RANGE, rayParams)
	if not result then
		return false
	end
	local model = result.Instance:FindFirstAncestorWhichIsA("Model")
	while model and model:GetAttribute("CombatantId") == nil do
		model = model:FindFirstAncestorWhichIsA("Model")
	end
	return model ~= nil and isEnemy(model)
end

local function setWantsFire(on: boolean)
	if wantsFire ~= on then
		wantsFire = on
		fireHook("AdminTrigger", on)
	end
end

-- ---------------------------------------------------------------------
-- ESP (≤ 20, über Highlights)
-- ---------------------------------------------------------------------
local function espSlot(index: number): EspSlot
	local slot = espSlots[index]
	if slot then
		return slot
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "CC_AdminESP"
	gui.Size = UDim2.fromOffset(180, 34)
	gui.StudsOffset = Vector3.new(0, 2.8, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = ESP_RANGE
	gui.ResetOnSpawn = false
	gui.Enabled = false
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = ESP_COLOR
	label.Text = ""
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = player:FindFirstChildOfClass("PlayerGui")
	local created: EspSlot = { Gui = gui, Label = label, Model = nil, Handle = nil }
	espSlots[index] = created
	return created
end

local function releaseSlot(slot: EspSlot)
	local highlights = module("Highlights")
	if slot.Handle ~= nil and highlights and type(highlights.Release) == "function" then
		pcall(highlights.Release, slot.Handle)
	end
	slot.Handle = nil
	slot.Model = nil
	slot.Gui.Enabled = false
	slot.Gui.Adornee = nil :: any
end

local function clearEsp()
	for _, slot in ipairs(espSlots) do
		releaseSlot(slot)
	end
	local highlights = module("Highlights")
	if highlights and type(highlights.ReleaseOwner) == "function" then
		pcall(highlights.ReleaseOwner, ESP_OWNER)
	end
	espActive = false
end

local function updateEsp()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local camPos = camera.CFrame.Position
	local list: { { Target: Target, Dist: number } } = {}
	for _, model in ipairs(candidateModels()) do
		if isEnemy(model) then
			local target = targetOf(model)
			if not target then
				-- Lobby-Spieler ohne Combatant-Id: trotzdem zeigen
				local head = model:FindFirstChild("Head")
				local root = model:FindFirstChild("HumanoidRootPart")
				if head and root and head:IsA("BasePart") and root:IsA("BasePart") then
					target = { Model = model, Id = 0, Head = head, Root = root }
				end
			end
			if target then
				local dist = (target.Root.Position - camPos).Magnitude
				if dist <= ESP_RANGE then
					table.insert(list, { Target = target, Dist = dist })
				end
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Dist < b.Dist
	end)
	local highlights = module("Highlights")
	local used = math.min(#list, ESP_MAX)
	-- erst alle Slots freigeben, deren Modell nicht mehr dabei ist
	local wanted: { [Model]: number } = {}
	for i = 1, used do
		wanted[list[i].Target.Model] = i
	end
	for _, slot in ipairs(espSlots) do
		if slot.Model and not wanted[slot.Model] then
			releaseSlot(slot)
		end
	end
	for i = 1, used do
		local entry = list[i]
		local model = entry.Target.Model
		local slot: EspSlot? = nil
		for _, s in ipairs(espSlots) do
			if s.Model == model then
				slot = s
				break
			end
		end
		if not slot then
			for index = 1, ESP_MAX do
				local s = espSlot(index)
				if s.Model == nil then
					slot = s
					break
				end
			end
		end
		if slot then
			if slot.Model ~= model then
				slot.Model = model
				slot.Gui.Adornee = entry.Target.Head
				if highlights and type(highlights.Acquire) == "function" then
					local ok, handle = pcall(highlights.Acquire, ESP_OWNER, model, {
						Outline = ESP_COLOR,
						Fill = ESP_COLOR,
						FillTransparency = 0.75,
						Depth = Enum.HighlightDepthMode.AlwaysOnTop,
					})
					slot.Handle = if ok then handle else nil
				end
			end
			local hp = model:GetAttribute("Hp")
			local name = model.Name
			local owner = Players:GetPlayerFromCharacter(model)
			if owner then
				name = owner.DisplayName
			end
			local text = if type(hp) == "number"
				then ("%s ❤%d · %dm"):format(name, math.floor(hp + 0.5), math.floor(entry.Dist))
				else ("%s · %dm"):format(name, math.floor(entry.Dist))
			if slot.Label.Text ~= text then
				slot.Label.Text = text
			end
			slot.Gui.Enabled = not photoHidden
		end
	end
	espActive = true
end

-- ---------------------------------------------------------------------
-- NOCLIP / TEMPO / SPRUNG (vor der Physik, damit Movement sie nicht überschreibt)
-- ---------------------------------------------------------------------
local function restoreNoclip()
	for part, original in pairs(noclipParts) do
		if part.Parent then
			part.CanCollide = original
		end
	end
	table.clear(noclipParts)
end

local function preSimulation()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid then
		return
	end
	if power("AdminNoclip") == true then
		for _, d in ipairs(character:GetDescendants()) do
			if d:IsA("BasePart") and d.CanCollide then
				if noclipParts[d] == nil then
					noclipParts[d] = true
				end
				d.CanCollide = false
			end
		end
	elseif next(noclipParts) ~= nil then
		restoreNoclip()
	end
	local speed = power("AdminSpeed")
	if type(speed) == "number" then
		humanoid.WalkSpeed = speed
		speedOverridden = true
	elseif speedOverridden then
		speedOverridden = false
		local base = character:GetAttribute("BaseSpeed")
		local walk = ctx and ctx.Config and ctx.Config.Player and ctx.Config.Player.Walk or 16
		humanoid.WalkSpeed = if type(base) == "number" then base else walk
	end
	local jump = power("AdminJump")
	if type(jump) == "number" then
		humanoid.UseJumpPower = false
		humanoid.JumpHeight = jump
		jumpOverridden = true
	elseif jumpOverridden then
		jumpOverridden = false
		humanoid.JumpHeight = ctx and ctx.Config and ctx.Config.Player and ctx.Config.Player.JumpHeight or 7.2
	end
end

-- ---------------------------------------------------------------------
-- TAINTED-SCHILD
-- ---------------------------------------------------------------------
local function updateTaintSign()
	local show = player:GetAttribute("TaintedMatch") ~= nil and not photoHidden
	if show and not taintSign then
		local parent = ctx and ctx.Gui
		if typeof(parent) ~= "Instance" then
			return
		end
		local label = Instance.new("TextLabel")
		label.Name = "CC_TaintedSign"
		label.AnchorPoint = Vector2.new(0.5, 0)
		label.Position = UDim2.new(0.5, 0, 0, 56)
		label.Size = UDim2.fromOffset(300, 34)
		label.BackgroundColor3 = Color3.fromRGB(200, 30, 40)
		label.BorderSizePixel = 0
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Text = T("admin.tainted")
		label.ZIndex = 40
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = label
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.new(0, 0, 0)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = label
		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 4)
		pad.PaddingBottom = UDim.new(0, 4)
		pad.Parent = label
		label.Parent = parent
		taintSign = label
	end
	if taintSign then
		taintSign.Visible = show
	end
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function AdminTools.WantsFire(): boolean
	return wantsFire
end

function AdminTools.AimTarget(): (number?, Vector3?)
	local target = aimTarget
	if not target or not target.Head.Parent then
		return nil, nil
	end
	return target.Id, target.Head.Position
end

local function preRender(dt: number)
	refreshRayFilter()
	local armed = isArmed()
	local aimbot = power("AdminAimbot") == true
	local silent = power("AdminSilentAim") == true
	-- Ziel für Aimbot / Silent Aim
	if armed and (aimbot or silent) then
		local target = bestTarget(if silent then SILENT_CONE else AIM_CONE, not silent)
		aimTarget = target
		if aimbot and target and aimingHeld() then
			aimStep(dt, target)
		else
			applied = false
		end
	else
		aimTarget = nil
		applied = false
	end
	-- Triggerbot
	setWantsFire(armed and power("AdminTriggerbot") == true and crosshairOnEnemy())
	-- ESP mit 4 Hz
	espAcc += dt
	if espAcc >= 1 / ESP_HZ then
		espAcc = 0
		if power("AdminESP") == true and not photoHidden then
			updateEsp()
		elseif espActive then
			clearEsp()
		end
	end
end

function AdminTools.Init(context: any)
	ctx = context
end

function AdminTools.Start()
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		hooks.On("Armed", function(info: any)
			if type(info) == "table" then
				armedInfo = {
					Ctx = if type(info.Ctx) == "string" then info.Ctx else nil,
					Team = if type(info.Team) == "number" then info.Team else nil,
				}
			end
		end)
		hooks.On("Disarmed", function()
			armedInfo = nil
			setWantsFire(false)
		end)
		-- Lobby-Licht (Admin-Event "LobbyLook"): auf dem eigenen Client sofort anwenden, solange man in der Lobby ist
		local world = "Lobby"
		hooks.On("World", function(w: any)
			if type(w) == "string" then
				world = w
			end
		end)
		hooks.On("Effect:LobbyLook", function(_strength: any, data: any)
			local mood = if type(data) == "table" then data.Mood else nil
			local look = module("ArenaLook")
			if type(mood) == "string" and world ~= "Match" and look and type(look.ApplyMood) == "function" then
				pcall(look.ApplyMood, mood)
			end
		end)
		hooks.On("PhotoMode", function(on: any)
			photoHidden = on == true
			if photoHidden then
				clearEsp()
			end
			updateTaintSign()
		end)
	end
	RunService.PreRender:Connect(preRender)
	RunService.PreSimulation:Connect(preSimulation)
	player:GetAttributeChangedSignal("TaintedMatch"):Connect(updateTaintSign)
	player:GetAttributeChangedSignal("AdminESP"):Connect(function()
		if player:GetAttribute("AdminESP") ~= true then
			clearEsp()
		end
	end)
	player.CharacterAdded:Connect(function()
		table.clear(noclipParts)
		speedOverridden = false
		jumpOverridden = false
	end)
	updateTaintSign()
end

return AdminTools
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">AimAssist</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Zielhilfe für Touch & Gamepad (Client/Modules/AimAssist)
--  Besitzer: WP4 (Kampf Client). Vertrag: DESIGN.md B15.2, C7.4. Werte: Config.Client.AimAssist.
--  NIE mit Maus: Filter gibt bei "KBM" (oder wenn Controls.Input() "KBM" meldet) die Eingabe unverändert zurück.
--  Nur sichtbare Gegner (Sichtlinien-Ray gegen die Kontext-Map, nicht durch Rauch-Kugeln aus Combat("Smoke")),
--  höchstens Range (70) Studs entfernt.
--    Reibung:      Blick-Eingabe × Friction (0.55), wenn das Fadenkreuz ≤ Cone° (3.5 Gamepad / 4.5 Touch) am Gegner ist
--    Magnetismus:  nur bei Bewegung oder Blick-Eingabe, max. Magnet °/s (4 / 5) zum Torso, kein Einrasten
--    Stärke:       Einstellung AimAssist 0..1 (× RankedMult in Ranked, v1.1)
--
--  Öffentliche API (C7.4):
--    AimAssist.Filter(dt, look: Vector2, input: "Gamepad" | "Touch"): Vector2
--        look = Blick-Änderung dieses Frames in rad, Maus-Konvention (+x rechts, +y runter)
--  Zusätzlich (für WeaponClient: Touch-Auto-Feuer, Admin-Triggerbot):
--    AimAssist.TargetUnderCrosshair(range?): (Model?, ("Head" | "Body")?)   sichtbarer Gegner genau unter dem Fadenkreuz
--    AimAssist.IsVisible(model): boolean
--    AimAssist.SmokeBlocks(a, b): boolean       Strecke a→b läuft durch eine aktive Rauch-Kugel
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Hitbox = require(Shared:WaitForChild("Hitbox"))

local AimAssist = {}

local player = Players.LocalPlayer
local ctx: any = nil

type Smoke = { P: Vector3, R: number, Until: number }

local MAX_SMOKES = 16
local LOS_INTERVAL = 0.1 -- Sichtlinie pro Ziel höchstens 10× pro Sekunde
local DEFAULTS = {
	Gamepad = { Cone = 3.5, Friction = 0.55, Magnet = 4 },
	Touch = { Cone = 4.5, Friction = 0.55, Magnet = 5 },
	Range = 70,
	RankedMult = 0.5,
}

local smokes: { Smoke } = {}
local losCache: { [Model]: { T: number, Visible: boolean } } = setmetatable({}, { __mode = "k" }) :: any
local mapParams = RaycastParams.new()
mapParams.FilterType = Enum.RaycastFilterType.Include
mapParams.IgnoreWater = true
local mapInstance: Instance? = nil
local ranked = false

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function wrapAngle(a: number): number
	return (a + math.pi) % (2 * math.pi) - math.pi
end

local function toYawPitch(look: Vector3): (number, number)
	return math.atan2(-look.X, -look.Z), math.asin(math.clamp(look.Y, -1, 1))
end

local function modules(): { [string]: any }
	return if ctx and type(ctx.Modules) == "table" then ctx.Modules else {}
end

local function config(): any
	local client = ctx and ctx.Config and ctx.Config.Client
	local aa = client and client.AimAssist
	return if type(aa) == "table" then aa else DEFAULTS
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function strength(): number
	local value: any = nil
	local settingsMod = modules().Settings
	if settingsMod and type(settingsMod.Get) == "function" then
		local ok, s = pcall(settingsMod.Get)
		if ok and type(s) == "table" then
			value = s.AimAssist
		end
	end
	if not finite(value) then
		value = 1
	end
	local s = math.clamp(value, 0, 1)
	if ranked then
		local mult = config().RankedMult
		s *= if finite(mult) then mult else 0.5
	end
	return s
end

local function weaponClient(): any
	return modules().WeaponClient
end

local function enemies(): { Model }
	local wc = weaponClient()
	if wc and type(wc.Enemies) == "function" then
		local ok, list = pcall(wc.Enemies)
		if ok and type(list) == "table" then
			return list
		end
	end
	return {}
end

local function headRadius(): number
	local mult = 1
	local wc = weaponClient()
	if wc and type(wc.Rules) == "function" then
		local ok, rules = pcall(wc.Rules)
		if ok and type(rules) == "table" and finite(rules.HeadRadiusMult) then
			mult = rules.HeadRadiusMult
		end
	end
	local combat = ctx and ctx.Config and ctx.Config.Combat
	local base = if combat and finite(combat.HeadRadius) then combat.HeadRadius else 0.8
	return base * mult
end

local function hitTol(): number
	local combat = ctx and ctx.Config and ctx.Config.Combat
	return if combat and finite(combat.HitTol) then combat.HitTol else 0.35
end

local function rootAndHead(model: Model): (BasePart?, BasePart?)
	local root = model:FindFirstChild("HumanoidRootPart")
	local head = model:FindFirstChild("Head")
	if root and root:IsA("BasePart") and head and head:IsA("BasePart") then
		return root, head
	end
	return nil, nil
end

-- ---------------------------------------------------------------------
-- RAUCH (analytische Kugeln, wie beim Server)
-- ---------------------------------------------------------------------
function AimAssist.SmokeBlocks(a: Vector3, b: Vector3): boolean
	if #smokes == 0 then
		return false
	end
	local now = serverNow()
	local seg = b - a
	local len2 = seg:Dot(seg)
	for _, s in ipairs(smokes) do
		if s.Until > now then
			local t = if len2 > 1e-6 then math.clamp((s.P - a):Dot(seg) / len2, 0, 1) else 0
			local closest = a + seg * t
			if (s.P - closest).Magnitude <= s.R then
				return true
			end
		end
	end
	return false
end

local function purgeSmokes()
	local now = serverNow()
	for i = #smokes, 1, -1 do
		if smokes[i].Until <= now then
			table.remove(smokes, i)
		end
	end
end

-- ---------------------------------------------------------------------
-- SICHTLINIE (gegen die Map des Kontexts, gecacht)
-- ---------------------------------------------------------------------
local function lineClear(from: Vector3, to: Vector3): boolean
	if not mapInstance then
		return true
	end
	local dir = to - from
	local dist = dir.Magnitude
	if dist < 0.5 then
		return true
	end
	local hit = workspace:Raycast(from, dir.Unit * math.max(dist - 0.5, 0.1), mapParams)
	return hit == nil
end

function AimAssist.IsVisible(model: Model): boolean
	local root, head = rootAndHead(model)
	local camera = workspace.CurrentCamera
	if not (root and head and camera) then
		return false
	end
	local camPos = camera.CFrame.Position
	if AimAssist.SmokeBlocks(camPos, root.Position) and AimAssist.SmokeBlocks(camPos, head.Position) then
		return false
	end
	local now = os.clock()
	local cached = losCache[model]
	if cached and now - cached.T < LOS_INTERVAL then
		return cached.Visible
	end
	local visible = lineClear(camPos, root.Position) or lineClear(camPos, head.Position)
	losCache[model] = { T = now, Visible = visible }
	return visible
end

-- bester Gegner im Kegel um die Blickrichtung (Torso oder Kopf), sichtbar
local function bestTarget(coneDeg: number, range: number): (Model?, Vector3?)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil, nil
	end
	local camPos = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	local cosCone = math.cos(math.rad(coneDeg))
	local best: Model? = nil
	local bestPoint: Vector3? = nil
	local bestDot = cosCone
	for _, model in ipairs(enemies()) do
		local root, head = rootAndHead(model)
		if root and head then
			local torso = root.Position
			local offset = torso - camPos
			local dist = offset.Magnitude
			if dist > 1 and dist <= range then
				local dot = look:Dot(offset / dist)
				local headOffset = head.Position - camPos
				local headDot = if headOffset.Magnitude > 1 then look:Dot(headOffset.Unit) else -1
				local d = math.max(dot, headDot)
				if d >= bestDot and AimAssist.IsVisible(model) then
					best = model
					bestPoint = torso
					bestDot = d
				end
			end
		end
	end
	return best, bestPoint
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH
-- ---------------------------------------------------------------------
function AimAssist.Filter(dt: number, look: Vector2, input: "Gamepad" | "Touch"): Vector2
	if typeof(look) ~= "Vector2" then
		return Vector2.zero
	end
	if input ~= "Gamepad" and input ~= "Touch" then
		return look -- nie Maus
	end
	local controls = modules().Controls
	if controls and type(controls.Input) == "function" then
		local ok, kind = pcall(controls.Input)
		if ok and kind == "KBM" and input ~= "Touch" then
			return look
		end
	end
	local wc = weaponClient()
	if not (wc and type(wc.IsArmed) == "function" and wc.IsArmed()) then
		return look
	end
	local s = strength()
	if s <= 0 or not finite(dt) or dt <= 0 then
		return look
	end
	local cfg = config()
	local entry = cfg[input] or DEFAULTS[input]
	local cone = if finite(entry.Cone) then entry.Cone else DEFAULTS[input].Cone
	local friction = if finite(entry.Friction) then math.clamp(entry.Friction, 0, 1) else 0.55
	local magnet = if finite(entry.Magnet) then math.max(entry.Magnet, 0) else DEFAULTS[input].Magnet
	local range = if finite(cfg.Range) then cfg.Range else DEFAULTS.Range

	local target, point = bestTarget(cone, range)
	if not (target and point) then
		return look
	end
	local hadInput = look.Magnitude > 1e-6
	-- Reibung
	local result = look * (1 - (1 - friction) * s)
	-- Magnetismus (nur bei Bewegung oder Blick-Eingabe)
	local moving = false
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.MoveDirection.Magnitude > 0.1 then
		moving = true
	end
	if (moving or hadInput) and magnet > 0 then
		local camera = workspace.CurrentCamera
		if camera then
			local camPos = camera.CFrame.Position
			local tYaw, tPitch = toYawPitch((point - camPos).Unit)
			local cYaw, cPitch = toYawPitch(camera.CFrame.LookVector)
			local pull = Vector2.new(-wrapAngle(tYaw - cYaw), -(tPitch - cPitch))
			local maxStep = math.rad(magnet) * s * dt
			if pull.Magnitude > maxStep then
				pull = pull.Unit * maxStep
			end
			result += pull
		end
	end
	return result
end

function AimAssist.TargetUnderCrosshair(range: number?): (Model?, ("Head" | "Body")?)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil, nil
	end
	local maxRange = if finite(range) then math.clamp(range :: number, 1, 2000) else 300
	local origin = camera.CFrame.Position
	local dir = camera.CFrame.LookVector
	local radius = headRadius()
	local tol = hitTol()
	local best: Model? = nil
	local bestRegion: ("Head" | "Body")? = nil
	local bestDist = maxRange
	for _, model in ipairs(enemies()) do
		local root, head = rootAndHead(model)
		if root and head then
			local region, dist = Hitbox.Ray(origin, dir, bestDist, root.CFrame, head.Position, radius, tol)
			if region and dist and dist <= bestDist then
				local hitPoint = origin + dir * dist
				if lineClear(origin, hitPoint) and not AimAssist.SmokeBlocks(origin, hitPoint) then
					best = model
					bestRegion = region
					bestDist = dist
				end
			end
		end
	end
	return best, bestRegion
end

-- ---------------------------------------------------------------------
-- MODUL-FORM
-- ---------------------------------------------------------------------
local function onArmed(info: any)
	if type(info) ~= "table" then
		return
	end
	table.clear(smokes)
	table.clear(losCache)
	local map = info.Map
	if typeof(map) == "Instance" then
		mapInstance = map
		mapParams.IncludeInstances = { map }
	else
		mapInstance = nil
	end
	local rules = info.Rules
	ranked = type(rules) == "table" and rules.Ranked == true
end

local function onDisarmed()
	table.clear(smokes)
	table.clear(losCache)
	mapInstance = nil
	ranked = false
end

function AimAssist.Init(context: any)
	ctx = context
end

function AimAssist.Start()
	local hooks = ctx and ctx.Hooks
	if not (hooks and type(hooks.On) == "function") then
		return
	end
	hooks.On("Armed", onArmed)
	hooks.On("Disarmed", onDisarmed)
	hooks.On("Combat:Smoke", function(data: any)
		if type(data) ~= "table" or typeof(data.P) ~= "Vector3" or not finite(data.R) or not finite(data.Until) then
			return
		end
		purgeSmokes()
		if #smokes >= MAX_SMOKES then
			table.remove(smokes, 1)
		end
		table.insert(smokes, { P = data.P, R = math.clamp(data.R, 0, 60), Until = data.Until })
	end)
end

return AimAssist
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">ArenaLook</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Welt-Ausblendung & Licht-Stimmungen (Client/Modules/ArenaLook)
--  Besitzer: WP2 (Welt). Vertrag: DESIGN.md B9.4 (nur die eigene Welt zeigen), B8.2 (Stimmungen,
--  nur client-lokal), C7.4 (API).
--
--  Welten:   "Lobby" = workspace.Lobby + workspace.Arenas.Crown (Crown Ring und Range gehören dazu)
--            Slot k  = workspace.Arenas.Slot_k
--  Verstecken = für alle Nachfahren LOKAL: BasePart.LocalTransparencyModifier = 1,
--            SurfaceGui/BillboardGui/ParticleEmitter/Beam/Trail/Light.Enabled = false.
--            Originalwerte in einer schwachen Tabelle; neue Nachfahren (DescendantAdded) sofort mit.
--  Stimmungen: eigene Instanzen CC_MoodAtmosphere/CC_MoodBloom/CC_MoodColorCorrection; die Lobby-
--            Effekte des Servers werden solange lokal geparkt/abgeschaltet. Snowy = Schnee an der Kamera.
--
--  Öffentliche API (C7.4):
--    ArenaLook.SetWorld(world: "Lobby" | number)   Slot-Nummer (0 = Crown = Lobby)
--    ArenaLook.ApplyMood(moodKey: string)
--    ArenaLook.RestoreLobby()
--  Hooks (C7.2): "Match:Start" {Slot, Mood, Map} · "Match:Closed" · "Armed" {Ctx} · "Disarmed"
-- =====================================================================

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local ArenaLook = {}

local ctx: any = nil
local Config: any = nil

local MOOD_PREFIX = "CC_Mood"
local MOOD_NAMES = { "CC_MoodAtmosphere", "CC_MoodBloom", "CC_MoodColorCorrection" }
local SNOW_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"
local SNOW_RATE = 60
local SNOW_HEIGHT = 14

-- Originalwerte versteckter Instanzen (schwach: zerstörte Instanzen verschwinden von selbst)
local saved: { [Instance]: any } = setmetatable({}, { __mode = "k" }) :: any
local hiddenRoots: { [Instance]: RBXScriptConnection } = {}
local currentWorld: string | number = "Lobby"
local inMatch = false
local watchers: { RBXScriptConnection } = {}

local moodActive = false
local lightingSnapshot: { ClockTime: number, Ambient: Color3, OutdoorAmbient: Color3 }? = nil
local parkFolder = Instance.new("Folder") -- bleibt unparented: hier liegen die Lobby-Atmosphären während einer Stimmung
parkFolder.Name = "CC_MoodParked"
local parked: { Instance } = {}
local disabledEffects: { [Instance]: boolean } = {}
local snowPart: Part? = nil
local snowConn: RBXScriptConnection? = nil

-- ---------------------------------------------------------------------
-- Verstecken / Zeigen
-- ---------------------------------------------------------------------
local function hideOne(inst: Instance)
	if inst:IsA("BasePart") then
		if saved[inst] == nil then
			saved[inst] = inst.LocalTransparencyModifier
		end
		inst.LocalTransparencyModifier = 1
	elseif
		inst:IsA("SurfaceGui")
		or inst:IsA("BillboardGui")
		or inst:IsA("ParticleEmitter")
		or inst:IsA("Beam")
		or inst:IsA("Trail")
		or inst:IsA("Light")
	then
		local any = inst :: any
		if saved[inst] == nil then
			saved[inst] = any.Enabled
		end
		any.Enabled = false
	end
end

local function showOne(inst: Instance)
	local value = saved[inst]
	if value == nil then
		return
	end
	saved[inst] = nil
	if inst:IsA("BasePart") then
		inst.LocalTransparencyModifier = value
	else
		(inst :: any).Enabled = value
	end
end

local function hideRoot(root: Instance)
	if hiddenRoots[root] then
		return
	end
	for _, inst in ipairs(root:GetDescendants()) do
		hideOne(inst)
	end
	hiddenRoots[root] = root.DescendantAdded:Connect(hideOne)
end

local function showRoot(root: Instance)
	local conn = hiddenRoots[root]
	if not conn then
		return
	end
	conn:Disconnect()
	hiddenRoots[root] = nil
	for _, inst in ipairs(root:GetDescendants()) do
		showOne(inst)
	end
end

-- Alle Welt-Wurzeln: { Root, Kind = "Lobby" | "Slot", Slot }
local function worldRoots(): { { Root: Instance, Kind: string, Slot: number } }
	local out = {}
	local lobby = workspace:FindFirstChild("Lobby")
	if lobby then
		table.insert(out, { Root = lobby, Kind = "Lobby", Slot = 0 })
	end
	local arenas = workspace:FindFirstChild("Arenas")
	if arenas then
		for _, child in ipairs(arenas:GetChildren()) do
			if child.Name == "Crown" then
				table.insert(out, { Root = child, Kind = "Lobby", Slot = 0 })
			else
				local slot = tonumber(child:GetAttribute("Slot")) or tonumber(string.match(child.Name, "^Slot_(%d+)$"))
				if slot and slot > 0 then
					table.insert(out, { Root = child, Kind = "Slot", Slot = slot })
				end
			end
		end
	end
	return out
end

local function applyWorld()
	-- zerstörte Wurzeln vergessen
	for root, conn in pairs(hiddenRoots) do
		if root.Parent == nil then
			conn:Disconnect()
			hiddenRoots[root] = nil
		end
	end
	for _, entry in ipairs(worldRoots()) do
		local show
		if currentWorld == "Lobby" then
			show = entry.Kind == "Lobby"
		else
			show = entry.Kind == "Slot" and entry.Slot == currentWorld
		end
		if show then
			showRoot(entry.Root)
		else
			hideRoot(entry.Root)
		end
	end
end

function ArenaLook.SetWorld(world: string | number)
	local target: string | number = "Lobby"
	local slot = tonumber(world)
	if slot and slot >= 1 then
		target = math.floor(slot)
	end
	currentWorld = target
	applyWorld()
end

-- ---------------------------------------------------------------------
-- Schnee an der Kamera (Snowy)
-- ---------------------------------------------------------------------
local function reducedFx(): boolean
	local modules = ctx and ctx.Modules
	local settings = modules and modules.Settings
	if settings and type(settings.Get) == "function" then
		local ok, values = pcall(settings.Get)
		if ok and type(values) == "table" then
			return values.ReducedFx == true
		end
	end
	return false
end

local function setSnow(on: boolean)
	if not on then
		if snowConn then
			snowConn:Disconnect()
			snowConn = nil
		end
		if snowPart then
			snowPart:Destroy()
			snowPart = nil
		end
		return
	end
	if snowPart then
		return
	end
	local part = Instance.new("Part")
	part.Name = "CC_MoodSnow"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(80, 1, 80)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Snow"
	emitter.Texture = SNOW_TEXTURE
	emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
	emitter.Size = NumberSequence.new(0.15)
	emitter.Rate = if reducedFx() then SNOW_RATE / 2 else SNOW_RATE
	emitter.Lifetime = NumberRange.new(5, 7)
	emitter.Speed = NumberRange.new(3, 5)
	emitter.SpreadAngle = Vector2.new(20, 20)
	emitter.EmissionDirection = Enum.NormalId.Bottom
	emitter.Acceleration = Vector3.new(0.4, -0.8, 0)
	emitter.LightEmission = 0.4
	emitter.LockedToPart = false
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.1, 0.1),
		NumberSequenceKeypoint.new(0.85, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = part
	local camera = workspace.CurrentCamera
	if camera then
		part.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, SNOW_HEIGHT, 0))
	end
	part.Parent = workspace -- vom Client erzeugt -> nur lokal
	snowPart = part
	snowConn = RunService.PreRender:Connect(function()
		local cam = workspace.CurrentCamera
		local p = snowPart
		if cam and p then
			p.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, SNOW_HEIGHT, 0))
		end
	end)
end

-- ---------------------------------------------------------------------
-- Stimmungen
-- ---------------------------------------------------------------------
local function ensureEffect(className: string, name: string): Instance
	local inst = Lighting:FindFirstChild(name)
	if inst and inst.ClassName ~= className then
		inst:Destroy()
		inst = nil
	end
	if not inst then
		local created = Instance.new(className)
		created.Name = name
		created.Parent = Lighting
		inst = created
	end
	return inst :: Instance
end

local function moodTable(moodKey: string?): any
	local maps = Config and Config.Maps
	local moods = maps and maps.Moods
	if type(moods) ~= "table" then
		return nil
	end
	local mood = if moodKey then moods[moodKey] else nil
	if type(mood) ~= "table" then
		mood = moods[maps.LobbyMood or "Day"] or moods.Day
	end
	return mood
end

-- Lobby-Effekte des Servers lokal beiseitelegen (eine Atmosphere zur Zeit; Bloom/Farbe aus)
local function parkLobbyEffects()
	for _, child in ipairs(Lighting:GetChildren()) do
		if string.sub(child.Name, 1, #MOOD_PREFIX) ~= MOOD_PREFIX then
			if child:IsA("Atmosphere") then
				table.insert(parked, child)
				child.Parent = parkFolder
			elseif child:IsA("BloomEffect") or child:IsA("ColorCorrectionEffect") then
				if disabledEffects[child] == nil then
					disabledEffects[child] = child.Enabled
				end
				child.Enabled = false
			end
		end
	end
end

function ArenaLook.ApplyMood(moodKey: string)
	local mood = moodTable(moodKey)
	if not mood then
		return
	end
	if not moodActive then
		moodActive = true
		lightingSnapshot = {
			ClockTime = Lighting.ClockTime,
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
		}
		parkLobbyEffects()
	end
	Lighting.ClockTime = mood.ClockTime
	Lighting.Ambient = mood.Ambient
	Lighting.OutdoorAmbient = mood.OutdoorAmbient

	local atmoDef = mood.Atmosphere or {}
	local atmo = ensureEffect("Atmosphere", "CC_MoodAtmosphere") :: Atmosphere
	atmo.Density = math.max(0.32, tonumber(atmoDef.Density) or 0.32) -- B9.4: nie unter 0.32
	atmo.Haze = tonumber(atmoDef.Haze) or 1
	atmo.Glare = tonumber(atmoDef.Glare) or 0
	atmo.Offset = tonumber(atmoDef.Offset) or 0.25
	if typeof(atmoDef.Color) == "Color3" then
		atmo.Color = atmoDef.Color
	end
	if typeof(atmoDef.Decay) == "Color3" then
		atmo.Decay = atmoDef.Decay
	end

	local bloomDef = mood.Bloom or {}
	local bloom = ensureEffect("BloomEffect", "CC_MoodBloom") :: BloomEffect
	bloom.Intensity = tonumber(bloomDef.Intensity) or 0.5
	bloom.Size = tonumber(bloomDef.Size) or 24
	bloom.Threshold = tonumber(bloomDef.Threshold) or 1.6
	bloom.Enabled = not reducedFx() -- ReducedFx schaltet Bloom aus (C17)

	local ccDef = mood.ColorCorrection or {}
	local cc = ensureEffect("ColorCorrectionEffect", "CC_MoodColorCorrection") :: ColorCorrectionEffect
	cc.Saturation = tonumber(ccDef.Saturation) or 0
	cc.Contrast = tonumber(ccDef.Contrast) or 0
	cc.Brightness = tonumber(ccDef.Brightness) or 0
	cc.TintColor = if typeof(ccDef.TintColor) == "Color3" then ccDef.TintColor else Color3.new(1, 1, 1)

	setSnow(mood.Snow == true)
end

function ArenaLook.RestoreLobby()
	setSnow(false)
	for _, name in ipairs(MOOD_NAMES) do
		local inst = Lighting:FindFirstChild(name)
		if inst then
			inst:Destroy()
		end
	end
	if not moodActive then
		return
	end
	moodActive = false
	local snap = lightingSnapshot
	if snap then
		Lighting.ClockTime = snap.ClockTime
		Lighting.Ambient = snap.Ambient
		Lighting.OutdoorAmbient = snap.OutdoorAmbient
	end
	lightingSnapshot = nil
	for _, inst in ipairs(parked) do
		inst.Parent = Lighting
	end
	table.clear(parked)
	for inst, enabled in pairs(disabledEffects) do
		if inst.Parent then
			(inst :: any).Enabled = enabled
		end
	end
	table.clear(disabledEffects)
end

-- ---------------------------------------------------------------------
-- Hooks
-- ---------------------------------------------------------------------
local function moodFor(data: any): string
	local maps = Config and Config.Maps
	local mood = data.Mood
	if type(mood) == "string" and maps and maps.Moods and maps.Moods[mood] then
		return mood
	end
	local def = maps and maps.Maps and type(data.Map) == "string" and maps.Maps[data.Map]
	if def and type(def.ForcedMood) == "string" then
		return def.ForcedMood
	end
	return (maps and maps.LobbyMood) or "Day"
end

local function backToLobby()
	ArenaLook.SetWorld("Lobby")
	ArenaLook.RestoreLobby()
end

local function onMatchStart(data: any)
	if type(data) ~= "table" then
		return
	end
	inMatch = true
	local slot = tonumber(data.Slot) or 0
	if slot >= 1 then
		ArenaLook.SetWorld(slot)
		ArenaLook.ApplyMood(moodFor(data))
	else
		backToLobby() -- Slot 0 = Crown Ring = Lobby-Welt mit Lobby-Licht
	end
end

function ArenaLook.Init(c: any)
	ctx = c
	Config = c and c.Config
end

function ArenaLook.Start()
	if #watchers > 0 then
		return -- schon gestartet
	end
	ArenaLook.SetWorld("Lobby")
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		hooks.On("Match:Start", onMatchStart)
		hooks.On("Match:Closed", function()
			inMatch = false
			backToLobby()
		end)
		hooks.On("Armed", function(info: any)
			if not inMatch and type(info) == "table" and info.Ctx == "Range" then
				backToLobby()
			end
		end)
		hooks.On("Disarmed", function()
			if not inMatch then
				backToLobby()
			end
		end)
	else
		warn("[ArenaLook] ctx.Hooks fehlt – Welt-Ausblendung reagiert nicht auf Matches")
	end
	-- Später auftauchende Wurzeln (Lobby/Arenas/Slots) gleich richtig ein-/ausblenden
	table.insert(
		watchers,
		workspace.ChildAdded:Connect(function(child)
			if child.Name == "Lobby" or child.Name == "Arenas" then
				applyWorld()
				if child.Name == "Arenas" then
					table.insert(watchers, child.ChildAdded:Connect(applyWorld))
				end
			end
		end)
	)
	local arenas = workspace:FindFirstChild("Arenas")
	if arenas then
		table.insert(watchers, arenas.ChildAdded:Connect(applyWorld))
	end
end

return ArenaLook
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">BotAnimator</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Bot-Animationen (Client/Modules/BotAnimator)
--  Besitzer: WP6 (Bots & Training-Range). Vertrag: DESIGN.md B10.3 ("Animationen"), Muss-Regel 2.
--  Spielt auf allen Modellen mit Tag "Bot" LOKAL die Roblox-Standard-Animationen (idle 507766388,
--  walk 507777826, run 507767714, jump 507765000, fall 507767968) + toolnone 507768375 als Halte-Pose
--  für die Waffe. Keine eigenen Animationen. Der Server besitzt die Bots (Netzwerk) -> die Tracks
--  laufen nur auf diesem Client. R6-Fallback-Rigs gleiten ohne Animation (R15-IDs passen nicht).
--  Nur bis Config.Bots.AnimateDistance (260 Studs) zur Kamera, 10 Hz Zustandswahl, ein Heartbeat.
--
--  Öffentliche API (Modul-Form C7.1):
--    BotAnimator.Init(ctx)   BotAnimator.Start()
--    BotAnimator.Count(): number      animierte Bots gerade (Debug)
-- =====================================================================

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local BotAnimator = {}

local TAG = "Bot"
local TICK = 0.1 -- 10 Hz
local FADE = 0.15
local IDLE_SPEED = 0.6 -- Studs/s darunter = stehen
local RUN_SPEED = 18 -- Studs/s darüber = rennen
local WALK_BASE = 16 -- Walk-Animation ist für 16 Studs/s gemacht
local RUN_BASE = 22
local MAX_BOTS = 32 -- Schutz (Server hat höchstens 12)

type BotAnim = {
	Model: Model,
	Humanoid: Humanoid?,
	Root: BasePart?,
	Animator: Animator?,
	Tracks: { [string]: AnimationTrack },
	Current: string?,
	Hold: AnimationTrack?,
	Active: boolean,
	Skip: boolean, -- R6-Fallback: nie animieren
	Conn: RBXScriptConnection?,
}

local ctx: any = nil
local config: any = nil
local animations: { [string]: Animation } = {}
local bots: { [Model]: BotAnim } = {}
local botCount = 0
local accumulator = 0
local heartbeat: RBXScriptConnection? = nil
local maxDistance = 260

-- ---------------------------------------------------------------------
-- HILFEN
-- ---------------------------------------------------------------------
local function animationFor(name: string): Animation?
	local existing = animations[name]
	if existing then
		return existing
	end
	local ids: any = config and config.Bots and config.Bots.Animations
	local id = if type(ids) == "table" then ids[name] else nil
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local anim = Instance.new("Animation")
	anim.Name = "Bot" .. name
	anim.AnimationId = id
	animations[name] = anim
	return anim
end

local function stopAll(b: BotAnim)
	for _, track in b.Tracks do
		if track.IsPlaying then
			track:Stop(FADE)
		end
	end
	b.Current = nil
	b.Active = false
end

local function destroyTracks(b: BotAnim)
	for _, track in b.Tracks do
		pcall(function()
			track:Stop(0)
			track:Destroy()
		end)
	end
	table.clear(b.Tracks)
	b.Hold = nil
	b.Current = nil
	b.Active = false
end

-- Humanoid/Animator/Wurzel nachschlagen (Modelle replizieren evtl. stückweise)
local function resolve(b: BotAnim): boolean
	local model = b.Model
	if b.Humanoid == nil or b.Humanoid.Parent ~= model then
		b.Humanoid = model:FindFirstChildOfClass("Humanoid")
		b.Animator = nil
		destroyTracks(b)
	end
	local humanoid = b.Humanoid
	if humanoid == nil then
		return false
	end
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		b.Skip = true
		return false
	end
	if b.Root == nil or b.Root.Parent ~= model then
		local root = model:FindFirstChild("HumanoidRootPart")
		b.Root = if root and root:IsA("BasePart") then root else nil
	end
	if b.Animator == nil or b.Animator.Parent ~= humanoid then
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if animator == nil then
			-- lokal angelegt: spielt nur auf diesem Client (gewollt)
			local created = Instance.new("Animator")
			created.Parent = humanoid
			animator = created
		end
		b.Animator = animator
		destroyTracks(b)
	end
	return b.Root ~= nil and b.Animator ~= nil
end

local function loadTrack(b: BotAnim, name: string, looped: boolean, priority: Enum.AnimationPriority): AnimationTrack?
	local existing = b.Tracks[name]
	if existing then
		return existing
	end
	local animator = b.Animator
	local anim = animationFor(name)
	if animator == nil or anim == nil then
		return nil
	end
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if not ok or track == nil then
		return nil
	end
	track.Looped = looped
	track.Priority = priority
	b.Tracks[name] = track
	return track
end

local function play(b: BotAnim, name: string, speed: number)
	local looped = name ~= "Jump"
	local track = loadTrack(b, name, looped, Enum.AnimationPriority.Core)
	if track == nil then
		return
	end
	if b.Current ~= name then
		local old = if b.Current then b.Tracks[b.Current] else nil
		if old and old.IsPlaying then
			old:Stop(FADE)
		end
		track:Play(FADE)
		b.Current = name
	elseif not track.IsPlaying and looped then
		track:Play(FADE)
	end
	track:AdjustSpeed(speed)
end

local function chooseState(humanoid: Humanoid, root: BasePart): (string, number)
	local state = humanoid:GetState()
	if state == Enum.HumanoidStateType.Jumping then
		return "Jump", 1
	end
	if state == Enum.HumanoidStateType.Freefall then
		return "Fall", 1
	end
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	if speed < IDLE_SPEED then
		return "Idle", 1
	end
	if speed < RUN_SPEED then
		return "Walk", math.clamp(speed / WALK_BASE, 0.4, 1.6)
	end
	return "Run", math.clamp(speed / RUN_BASE, 0.6, 1.8)
end

-- ---------------------------------------------------------------------
-- VERWALTUNG
-- ---------------------------------------------------------------------
local function remove(model: Model)
	local b = bots[model]
	if b == nil then
		return
	end
	bots[model] = nil
	botCount -= 1
	if b.Conn then
		b.Conn:Disconnect()
	end
	destroyTracks(b)
end

local function add(instance: Instance)
	if not instance:IsA("Model") or bots[instance] or botCount >= MAX_BOTS then
		return
	end
	local model = instance :: Model
	local b: BotAnim = {
		Model = model,
		Humanoid = nil,
		Root = nil,
		Animator = nil,
		Tracks = {},
		Current = nil,
		Hold = nil,
		Active = false,
		Skip = false,
		Conn = nil,
	}
	b.Conn = model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			remove(model)
		end
	end)
	bots[model] = b
	botCount += 1
end

local function update(b: BotAnim, camPos: Vector3)
	if b.Skip then
		return
	end
	local model = b.Model
	if not model:IsDescendantOf(workspace) then
		if b.Active then
			stopAll(b)
		end
		return
	end
	if not resolve(b) then
		return
	end
	local humanoid = b.Humanoid :: Humanoid
	local root = b.Root :: BasePart
	local alive = model:GetAttribute("Alive") ~= false
	local near = (root.Position - camPos).Magnitude <= maxDistance
	if not alive or not near then
		if b.Active then
			stopAll(b)
		end
		return
	end
	b.Active = true
	-- Halte-Pose für die Waffe (toolnone), über den Lauf-Animationen
	local hold = b.Hold or loadTrack(b, "ToolNone", true, Enum.AnimationPriority.Action)
	b.Hold = hold
	if hold and not hold.IsPlaying then
		hold:Play(FADE)
	end
	local name, speed = chooseState(humanoid, root)
	play(b, name, speed)
end

local function step(dt: number)
	accumulator += dt
	if accumulator < TICK then
		return
	end
	accumulator = 0
	local camera = workspace.CurrentCamera
	if camera == nil then
		return
	end
	local camPos = camera.CFrame.Position
	for _, b in bots do
		local ok, err = pcall(update, b, camPos)
		if not ok then
			-- kaputter Bot (z. B. halb repliziert): nächstes Mal neu auflösen
			b.Humanoid = nil
			warn("[BotAnimator] " .. tostring(err))
		end
	end
end

-- ---------------------------------------------------------------------
-- MODUL-FORM (C7.1)
-- ---------------------------------------------------------------------
function BotAnimator.Init(context: any)
	ctx = context
	config = if type(ctx) == "table" and ctx.Config then ctx.Config else nil
	if config == nil then
		local ok, result = pcall(function()
			return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")) :: any
		end)
		if ok then
			config = result
		end
	end
	local distance = config and config.Bots and config.Bots.AnimateDistance
	if type(distance) == "number" and distance > 0 then
		maxDistance = distance
	end
end

function BotAnimator.Start()
	if heartbeat then
		return
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(instance: Instance)
		if instance:IsA("Model") then
			remove(instance)
		end
	end)
	for _, instance in CollectionService:GetTagged(TAG) do
		add(instance)
	end
	heartbeat = RunService.Heartbeat:Connect(step)
end

function BotAnimator.Count(): number
	local n = 0
	for _, b in bots do
		if b.Active then
			n += 1
		end
	end
	return n
end

return BotAnimator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">ChatClient</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Chat-Anzeige: freundliche Umschreibungen + Namens-Präfixe (Client/Modules/ChatClient)
--  Besitzer: WP8 (Fortschritt/Sozial). Vertrag: DESIGN.md B24 + C7.1.
--
--  TextChatService.OnIncomingMessage (nur Anzeige, nur auf diesem Gerät):
--    • Umschreibungen NUR für Nachrichten ANDERER, nur ganze Nachricht oder ganze Wörter
--      (Groß/Klein egal, Satzzeichen trennen): ez → „gg wp“, ggez → „GG ❤“, noob → „Freund“, p2w → „faires Loadout“,
--      trash → „gutes Spiel“ (Liste: Config.Progression.Chat.Rewrites, Logik: ProgressMath.RewriteChat).
--      Normale deutsche Wörter („schlecht“) werden nie angefasst; eigene Nachrichten bleiben unverändert.
--    • PrefixText: [Besitzer] gold, [VIP] gold, Level-Abzeichen (Farbe nach Level), Titel – aus den
--      Player-Attributen IsAdmin / Vip / Level / Title (gesetzt von WP7/WP9/WP8).
--  Öffentliche API: ChatClient.Init(ctx) · ChatClient.Start() · ChatClient.Rewrite(text): string?  (Debug/Tests)
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local ProgressMath = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ProgressMath"))

local ChatClient = {}

local ctx: any = nil
local chatCfg: any = nil
local levelColors: { { Min: number, Color: Color3 } } = {}

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function hex(color: Color3): string
	return ("#%02X%02X%02X"):format(
		math.clamp(math.floor(color.R * 255 + 0.5), 0, 255),
		math.clamp(math.floor(color.G * 255 + 0.5), 0, 255),
		math.clamp(math.floor(color.B * 255 + 0.5), 0, 255)
	)
end

-- Rich-Text-sicher (Titel/Namen kommen aus der Config, trotzdem escapen)
local function escape(text: string): string
	return (
		string.gsub(text, "[&<>\"']", {
			["&"] = "&amp;",
			["<"] = "&lt;",
			[">"] = "&gt;",
			['"'] = "&quot;",
			["'"] = "&apos;",
		})
	)
end

local function colored(text: string, color: string): string
	return ('<font color="%s">%s</font>'):format(color, escape(text))
end

local function levelColor(level: number): string
	local color = Color3.new(1, 1, 1)
	for _, entry in ipairs(levelColors) do
		if level >= entry.Min then
			color = entry.Color
		end
	end
	return hex(color)
end

local function titleText(id: string): (string?, Color3?)
	local cosmetics = ctx.Config.Cosmetics
	local def = cosmetics and cosmetics.Titles and cosmetics.Titles[id]
	if type(def) ~= "table" or type(def.Name) ~= "table" then
		return nil, nil
	end
	local color = if typeof(def.Color) == "Color3" then def.Color else nil
	return ctx.Lang.Pick(ctx.Lang_(), def.Name), color
end

-- [Besitzer] [VIP] [Lv 12] [Titel]
local function buildPrefix(sender: Player): string
	local parts: { string } = {}
	if sender:GetAttribute("IsAdmin") == true then
		table.insert(parts, colored("[" .. ctx.T("prog.chat.owner") .. "]", chatCfg.OwnerColor or "#FFC828"))
	end
	if sender:GetAttribute("Vip") == true then
		table.insert(parts, colored("[VIP]", chatCfg.VipColor or "#FFD700"))
	end
	local level = sender:GetAttribute("Level")
	if type(level) == "number" and level >= 1 then
		local lvl = math.floor(level)
		table.insert(parts, colored("[" .. ctx.T("prog.chat.level", lvl) .. "]", levelColor(lvl)))
	end
	local title = sender:GetAttribute("Title")
	if type(title) == "string" and title ~= "" then
		local text, color = titleText(title)
		if text then
			table.insert(
				parts,
				colored("[" .. text .. "]", if color then hex(color) else (chatCfg.TitleColor or "#B9A7F2"))
			)
		end
	end
	return table.concat(parts, " ")
end

function ChatClient.Rewrite(text: string): string?
	if not chatCfg then
		return nil
	end
	return ProgressMath.RewriteChat(text, chatCfg.Rewrites, ctx.Lang_())
end

-- ---------------------------------------------------------------------
-- OnIncomingMessage (wird pro Nachricht ggf. mehrfach gerufen: Senden + Erfolg)
-- ---------------------------------------------------------------------
local function onIncoming(message: TextChatMessage): TextChatMessageProperties?
	local source = message.TextSource
	if not source then
		return nil -- System-/Spielnachrichten bleiben, wie sie sind
	end
	local props = Instance.new("TextChatMessageProperties")
	local sender = Players:GetPlayerByUserId(source.UserId)
	if sender then
		local ok, prefix = pcall(buildPrefix, sender)
		if ok and prefix ~= "" then
			props.PrefixText = prefix .. " " .. message.PrefixText
		end
	end
	-- nur Nachrichten ANDERER, nur fertig gefilterte Texte umschreiben
	if source.UserId ~= ctx.Player.UserId and message.Status == Enum.TextChatMessageStatus.Success then
		local ok, rewritten = pcall(ChatClient.Rewrite, message.Text)
		if ok and type(rewritten) == "string" then
			props.Text = rewritten
		end
	end
	return props
end

-- ---------------------------------------------------------------------
-- INIT / START
-- ---------------------------------------------------------------------
function ChatClient.Init(context: any)
	ctx = context
	local progression = ctx.Config.Progression
	chatCfg = if type(progression) == "table" and type(progression.Chat) == "table"
		then progression.Chat
		else { Rewrites = {} }
	if type(progression) == "table" and type(progression.LevelColors) == "table" then
		for _, entry in ipairs(progression.LevelColors) do
			if type(entry) == "table" and type(entry.Min) == "number" and typeof(entry.Color) == "Color3" then
				table.insert(levelColors, { Min = entry.Min, Color = entry.Color })
			end
		end
		table.sort(levelColors, function(a, b)
			return a.Min < b.Min
		end)
	end
end

function ChatClient.Start()
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		warn("[ChatClient] Altes Chat-System aktiv – Umschreibungen/Präfixe aus")
		return
	end
	TextChatService.OnIncomingMessage = onIncoming
end

return ChatClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">CombatFX</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Kampf-Effekte mit festen Vorräten (Client/Modules/CombatFX)
--  Besitzer: WP10 (Client-Hülle). Vertrag: DESIGN.md C7.4, C8 (FX-Buffer), C11, C17, ASSETS §5.
--
--  Alles wird beim Start EINMAL gebaut und danach nur noch umgestellt: ein Schuss erzeugt keine
--  neue Instanz (Abnahme 4). Tracer = Beam zwischen zwei Attachments, Treffer = Partikel-Stöße an
--  wiederverwendeten Attachments (≤ 8 Partikel pro Schuss), Lichter ≤ 4, Projektile als
--  Kugel-Teile mit Trail (BulkMoveTo, ein Frame-Schritt für alles). Reduzierte Effekte halbieren
--  Partikel und schalten Lichter aus.
--
--  Öffentliche API (C7.4):
--    CombatFX.Tracer(from, to, color?, tracerId?)
--    CombatFX.Impact(pos, normal?, kind)          kind "Surface" | "Player" | "Head" | "Water"
--    CombatFX.Muzzle(cf, weaponKey)
--    CombatFX.Explosion(pos, radius)
--    CombatFX.Smoke(pos, radius, untilT)          untilT = workspace:GetServerTimeNow()-Zeit
--    CombatFX.Projectile(id, weaponKey, origin, velocity, gravity, t0)
--    CombatFX.RemoveProjectile(id)
--    CombatFX.Pop(pos, finisherId, color)         Finishers.Play (WP9), sonst Konfetti-Puff
--    CombatFX.Frame(dt) (aus dem einen PreRender-Loop), CombatFX.Init(ctx) / CombatFX.Start()
--  Hört selbst: Remote "FX" (Buffer der anderen Schützen), Hooks "Combat:Proj/Boom/Smoke",
--  "Match:Start"/"Combat:Armed" (Arena-Ursprung + Map für Abpraller).
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombatFX = {}

local player = Players.LocalPlayer
local ctx: any = nil

local WHITE = Color3.new(1, 1, 1)
local TRACER_DEFAULT = Color3.fromRGB(255, 236, 150)
local HIDDEN_CF = CFrame.new(0, -4000, 0)
local TEX = {
	Gradient = "rbxasset://textures/gradient.png",
	Square = "rbxasset://textures/particles/SquareParticle.png",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Puff = "rbxasset://textures/explosion.png",
	Star = "rbxasset://textures/particles/sparkles_main.dds",
	Ring = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	Glow = "rbxasset://textures/particles/explosion01_implosion_main.dds",
	Burst = "rbxasset://textures/glow.png",
	Fire = "rbxasset://textures/particles/explosion01_core_main.dds",
	DarkSmoke = "rbxasset://textures/particles/explosion01_smoke_main.dds",
	Dot = "rbxasset://textures/ui/traildot.png",
}

-- Grenzen (C17); echte Werte aus Config.Client.Pools
local poolSizes = { Tracers = 48, Impacts = 32, Lights = 4, Projectiles = 40 }
local IMPACT_ATTACHMENTS = 16 -- Partikel leben in Weltkoordinaten weiter -> 16 Halter reichen für 32 Treffer/s
local MUZZLES = 6
local EXPLOSIONS = 4
local SMOKES = 4
local POPS = 4
local FX_RANGE = 450
local FINISHER_RANGE = 300
local PROJECTILE_LIFE = 6
local PROJECTILE_FASTFORWARD = 0.5
local PREDICT_MATCH_TIME = 0.6 -- eigenes Projektil-Echo vom Server so lange einem vorhergesagten zuordnen
local PREDICT_MATCH_DIST = 8

-- ---------------------------------------------------------------------
-- ZUSTAND
-- ---------------------------------------------------------------------
type Tracer = { Beam: Beam, A0: Attachment, A1: Attachment, Age: number, Life: number, Active: boolean }
type ImpactSlot = {
	Attachment: Attachment,
	Sparks: ParticleEmitter,
	Dust: ParticleEmitter,
	Puff: ParticleEmitter,
	Stars: ParticleEmitter,
	Ring: ParticleEmitter,
}
type MuzzleSlot = { Attachment: Attachment, Core: ParticleEmitter, Star: ParticleEmitter, Smoke: ParticleEmitter }
type ExplosionSlot = {
	Attachment: Attachment,
	Fire: ParticleEmitter,
	Wave: ParticleEmitter,
	Smoke: ParticleEmitter,
	Debris: ParticleEmitter,
}
type SmokeSlot = {
	Attachment: Attachment,
	Emitter: ParticleEmitter,
	Ball: Part,
	Until: number,
	Radius: number,
	Active: boolean,
}
type LightSlot = { Attachment: Attachment, Light: PointLight, Until: number, Active: boolean }
type Projectile = {
	Part: Part,
	Trail: Trail,
	Active: boolean,
	Id: string,
	Aliases: { string },
	Key: string,
	Pos: Vector3,
	Vel: Vector3,
	Gravity: number,
	Bounces: number,
	Restitution: number,
	Age: number,
	Life: number,
	Stopped: boolean,
	Local: boolean,
	SpawnedAt: number,
	Origin: Vector3,
}

local anchor: Part? = nil
local folder: Folder? = nil
local tracers: { Tracer } = {}
local tracerNext = 1
local tracersActive = 0
local impacts: { ImpactSlot } = {}
local impactNext = 1
local impactWindowStart = 0
local impactWindowCount = 0
local muzzles: { MuzzleSlot } = {}
local muzzleNext = 1
local explosions: { ExplosionSlot } = {}
local explosionNext = 1
local smokes: { SmokeSlot } = {}
local lights: { LightSlot } = {}
local pops: { ParticleEmitter } = {}
local popAttachments: { Attachment } = {}
local popNext = 1
local projectiles: { Projectile } = {}
local projectileById: { [string]: Projectile } = {}
local projectilesActive = 0
local moveParts: { BasePart } = {}
local moveCFrames: { CFrame } = {}
local tracerSeqs: { NumberSequence } = {}
local tracerStyles: { [string]: any } = {}
local arenaOrigin = Vector3.zero
local arenaMap: Instance? = nil
local myCombatId = player.UserId
local rayParams = RaycastParams.new()
local cosmeticModels: any = nil
local ballistics: any = nil

-- ---------------------------------------------------------------------
-- HILFEN
-- ---------------------------------------------------------------------
local function setting(key: string): any
	local module = ctx and ctx.Modules and ctx.Modules.Settings
	if module and type(module.Get) == "function" then
		local ok, settings = pcall(module.Get)
		if ok and type(settings) == "table" then
			return settings[key]
		end
	end
	return nil
end

local function reduced(): boolean
	return setting("ReducedFx") == true
end

local function count(n: number): number
	if reduced() then
		return math.max(1, math.floor(n / 2))
	end
	return n
end

local function camPos(): Vector3?
	local camera = workspace.CurrentCamera
	return camera and camera.CFrame.Position or nil
end

local function near(pos: Vector3, range: number): boolean
	local cam = camPos()
	return cam == nil or (cam - pos).Magnitude <= range
end

local function sfx(role: string, pos: Vector3?, opts: any?)
	local module = ctx and ctx.Modules and ctx.Modules.Sfx
	if module and type(module.Play) == "function" then
		pcall(module.Play, role, pos, opts)
	end
end

local function weaponDef(key: string?): any
	if type(key) ~= "string" or not ctx then
		return nil
	end
	local config = ctx.Config
	if type(config.Weapon) == "function" then
		local ok, def = pcall(config.Weapon, key)
		if ok then
			return def
		end
	end
	return nil
end

local function weaponDefById(id: number): any
	local config = ctx and ctx.Config
	if config and type(config.WeaponById) == "function" then
		local ok, def = pcall(config.WeaponById, id)
		if ok then
			return def
		end
	end
	return nil
end

-- Schuss-Sound einer Waffe: def.Sound (Rolle), sonst nach Art/Slot geraten
local function shotRole(def: any): string?
	if type(def) ~= "table" then
		return nil
	end
	local sfxModule = ctx.Modules.Sfx
	if type(def.Sound) == "string" and sfxModule and type(sfxModule.Has) == "function" and sfxModule.Has(def.Sound) then
		return def.Sound
	end
	if def.Kind == "Melee" then
		return "MeleeSwing"
	elseif def.Kind == "Throwable" or def.Kind == "Consumable" then
		return "Throw"
	elseif def.Kind == "Projectile" then
		return "RocketLaunch"
	elseif def.Slot == "Secondary" then
		return "PistolShot"
	elseif (def.Pellets or 1) > 1 then
		return "ShotgunShot"
	end
	return "RifleShot"
end

local function attachment(name: string): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.Parent = anchor
	return a
end

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.LightInfluence = 0
	e.Enabled = true
	for key, value in pairs(props) do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

local function seq(a: number, b: number, c: number?): NumberSequence
	if c then
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, a),
			NumberSequenceKeypoint.new(0.4, b),
			NumberSequenceKeypoint.new(1, c),
		})
	end
	return NumberSequence.new(a, b)
end

-- ---------------------------------------------------------------------
-- AUFBAU (einmal)
-- ---------------------------------------------------------------------
local function buildTracers()
	-- Ausblend-Stufen vorberechnet (keine neuen NumberSequences pro Frame)
	for i = 0, 5 do
		local t = i / 5
		table.insert(
			tracerSeqs,
			NumberSequence.new({
				NumberSequenceKeypoint.new(0, math.min(1, 0.05 + t)),
				NumberSequenceKeypoint.new(1, math.min(1, 0.35 + t)),
			})
		)
	end
	for i = 1, poolSizes.Tracers do
		local a0 = attachment("T0_" .. i)
		local a1 = attachment("T1_" .. i)
		local beam = Instance.new("Beam")
		beam.Name = "Tracer"
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Texture = TEX.Gradient
		beam.TextureMode = Enum.TextureMode.Stretch
		beam.Segments = 1
		beam.Width0 = 0.12
		beam.Width1 = 0.05
		beam.Color = ColorSequence.new(TRACER_DEFAULT)
		beam.Transparency = tracerSeqs[1]
		beam.Enabled = false
		beam.Parent = anchor
		table.insert(tracers, { Beam = beam, A0 = a0, A1 = a1, Age = 0, Life = 0.07, Active = false })
	end
end

local function buildImpacts()
	for i = 1, IMPACT_ATTACHMENTS do
		local a = attachment("Impact_" .. i)
		table.insert(impacts, {
			Attachment = a,
			Sparks = emitter(a, {
				Texture = TEX.Square,
				Color = ColorSequence.new(Color3.fromRGB(255, 240, 120), Color3.fromRGB(255, 170, 40)),
				LightEmission = 1,
				Size = seq(0.12, 0),
				Lifetime = NumberRange.new(0.2, 0.35),
				Speed = NumberRange.new(15, 25),
				SpreadAngle = Vector2.new(40, 40),
				Acceleration = Vector3.new(0, -40, 0),
				Drag = 3,
				EmissionDirection = Enum.NormalId.Top,
			}),
			Dust = emitter(a, {
				Texture = TEX.Smoke,
				Color = ColorSequence.new(Color3.fromRGB(220, 215, 205)),
				Size = seq(0.4, 1.2),
				Transparency = seq(0.4, 1),
				Lifetime = NumberRange.new(0.35, 0.45),
				Speed = NumberRange.new(2, 4),
				SpreadAngle = Vector2.new(30, 30),
				EmissionDirection = Enum.NormalId.Top,
				Rotation = NumberRange.new(0, 360),
			}),
			Puff = emitter(a, {
				Texture = TEX.Puff,
				Color = ColorSequence.new(WHITE),
				LightEmission = 0.3,
				Size = seq(0.5, 1.6, 0),
				Transparency = seq(0.05, 0.3, 1),
				Lifetime = NumberRange.new(0.25, 0.4),
				Speed = NumberRange.new(3, 6),
				SpreadAngle = Vector2.new(180, 180),
				Drag = 6,
				Rotation = NumberRange.new(0, 360),
				RotSpeed = NumberRange.new(-120, 120),
			}),
			Stars = emitter(a, {
				Texture = TEX.Star,
				Color = ColorSequence.new(WHITE),
				LightEmission = 0.8,
				Size = seq(0.9, 0),
				Lifetime = NumberRange.new(0.35, 0.55),
				Speed = NumberRange.new(6, 11),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, -10, 0),
				Drag = 3,
				RotSpeed = NumberRange.new(-260, 260),
			}),
			Ring = emitter(a, {
				Texture = TEX.Ring,
				Color = ColorSequence.new(Color3.fromRGB(255, 230, 80)),
				LightEmission = 1,
				Size = seq(0.4, 3.2),
				Transparency = seq(0.1, 1),
				Lifetime = NumberRange.new(0.25, 0.25),
				Speed = NumberRange.new(0, 0),
				Orientation = Enum.ParticleOrientation.FacingCamera,
			}),
		})
	end
end

local function buildMuzzles()
	for i = 1, MUZZLES do
		local a = attachment("Muzzle_" .. i)
		table.insert(muzzles, {
			Attachment = a,
			Core = emitter(a, {
				Texture = TEX.Glow,
				Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 150, 40)),
				LightEmission = 1,
				Size = seq(0.9, 0),
				Lifetime = NumberRange.new(0.04, 0.07),
				Speed = NumberRange.new(0, 0),
				LockedToPart = true,
			}),
			Star = emitter(a, {
				Texture = TEX.Burst,
				Color = ColorSequence.new(Color3.fromRGB(255, 240, 180)),
				LightEmission = 1,
				Size = seq(1.0, 0.2),
				Lifetime = NumberRange.new(0.05, 0.06),
				Speed = NumberRange.new(0, 0),
				Rotation = NumberRange.new(0, 360),
				LockedToPart = true,
			}),
			Smoke = emitter(a, {
				Texture = TEX.Smoke,
				Color = ColorSequence.new(Color3.fromRGB(235, 235, 235)),
				Size = seq(0.3, 1.1),
				Transparency = seq(0.55, 1),
				Lifetime = NumberRange.new(0.35, 0.5),
				Speed = NumberRange.new(1.5, 3),
				SpreadAngle = Vector2.new(15, 15),
				EmissionDirection = Enum.NormalId.Front,
				Rotation = NumberRange.new(0, 360),
			}),
		})
	end
end

local function buildExplosions()
	for i = 1, EXPLOSIONS do
		local a = attachment("Explosion_" .. i)
		table.insert(explosions, {
			Attachment = a,
			Fire = emitter(a, {
				Texture = TEX.Fire,
				Color = ColorSequence.new(WHITE),
				LightEmission = 0.6,
				Size = seq(2, 6, 3),
				Transparency = seq(0, 0.2, 1),
				Lifetime = NumberRange.new(0.35, 0.55),
				Speed = NumberRange.new(4, 12),
				SpreadAngle = Vector2.new(180, 180),
				Drag = 4,
				Rotation = NumberRange.new(0, 360),
				RotSpeed = NumberRange.new(-90, 90),
			}),
			Wave = emitter(a, {
				Texture = TEX.Ring,
				Color = ColorSequence.new(Color3.fromRGB(255, 220, 160)),
				LightEmission = 1,
				Size = seq(1, 18),
				Transparency = seq(0.1, 1),
				Lifetime = NumberRange.new(0.35, 0.35),
				Speed = NumberRange.new(0, 0),
			}),
			Smoke = emitter(a, {
				Texture = TEX.DarkSmoke,
				Color = ColorSequence.new(WHITE),
				Size = seq(3, 8),
				Transparency = seq(0.2, 1),
				Lifetime = NumberRange.new(0.9, 1.4),
				Speed = NumberRange.new(2, 6),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 3, 0),
				Drag = 2,
				Rotation = NumberRange.new(0, 360),
			}),
			Debris = emitter(a, {
				Texture = TEX.Square,
				Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(90, 80, 70)),
				LightEmission = 0.5,
				Size = seq(0.35, 0.1),
				Lifetime = NumberRange.new(0.5, 0.9),
				Speed = NumberRange.new(20, 38),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, -60, 0),
				RotSpeed = NumberRange.new(-300, 300),
			}),
		})
	end
end

local function buildSmokes()
	local parent = folder
	for i = 1, SMOKES do
		local a = attachment("Smoke_" .. i)
		local ball = Instance.new("Part")
		ball.Name = "SmokeBall"
		ball.Shape = Enum.PartType.Ball
		ball.Anchored = true
		ball.CanCollide = false
		ball.CanQuery = false
		ball.CanTouch = false
		ball.CastShadow = false
		ball.Material = Enum.Material.SmoothPlastic
		ball.Color = Color3.fromRGB(205, 208, 214)
		ball.Transparency = 1
		ball.Size = Vector3.new(1, 1, 1)
		ball.CFrame = HIDDEN_CF
		ball.Parent = parent
		table.insert(smokes, {
			Attachment = a,
			Emitter = emitter(a, {
				Texture = TEX.Smoke,
				Color = ColorSequence.new(Color3.fromRGB(215, 218, 224)),
				Size = seq(5, 11),
				Transparency = seq(0.15, 0.3, 1),
				Lifetime = NumberRange.new(2.5, 3.5),
				Speed = NumberRange.new(1, 3),
				SpreadAngle = Vector2.new(180, 180),
				Rotation = NumberRange.new(0, 360),
				RotSpeed = NumberRange.new(-20, 20),
				Enabled = false,
			}),
			Ball = ball,
			Until = 0,
			Radius = 0,
			Active = false,
		})
	end
end

local function buildLights()
	for i = 1, poolSizes.Lights do
		local a = attachment("Light_" .. i)
		local light = Instance.new("PointLight")
		light.Enabled = false
		light.Shadows = false
		light.Brightness = 6
		light.Range = 14
		light.Parent = a
		table.insert(lights, { Attachment = a, Light = light, Until = 0, Active = false })
	end
end

local function buildPops()
	local colors = { Color3.fromRGB(255, 220, 50), Color3.fromRGB(255, 85, 195), Color3.fromRGB(60, 220, 255) }
	for i = 1, POPS do
		local a = attachment("Pop_" .. i)
		table.insert(popAttachments, a)
		table.insert(
			pops,
			emitter(a, {
				Texture = TEX.Square,
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, colors[1]),
					ColorSequenceKeypoint.new(0.5, colors[2]),
					ColorSequenceKeypoint.new(1, colors[3]),
				}),
				LightEmission = 0.4,
				Size = seq(0.45, 0.25),
				Lifetime = NumberRange.new(0.8, 1.4),
				Speed = NumberRange.new(10, 22),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, -30, 0),
				Drag = 1.5,
				Rotation = NumberRange.new(0, 360),
				RotSpeed = NumberRange.new(-400, 400),
			})
		)
	end
end

local function buildProjectiles()
	local parent = folder
	for i = 1, poolSizes.Projectiles do
		local part = Instance.new("Part")
		part.Name = "Projectile_" .. i
		part.Shape = Enum.PartType.Ball
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Size = Vector3.new(0.7, 0.7, 0.7)
		part.CFrame = HIDDEN_CF
		part.Parent = parent
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.25, 0)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.25, 0)
		a1.Parent = part
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Texture = TEX.Gradient
		trail.LightEmission = 0.8
		trail.LightInfluence = 0
		trail.Lifetime = 0.25
		trail.FaceCamera = true
		trail.Transparency = seq(0.2, 1)
		trail.Enabled = false
		trail.Parent = part
		table.insert(projectiles, {
			Part = part,
			Trail = trail,
			Active = false,
			Id = "",
			Aliases = {},
			Key = "",
			Pos = Vector3.zero,
			Vel = Vector3.zero,
			Gravity = 0,
			Bounces = 0,
			Restitution = 0.35,
			Age = 0,
			Life = PROJECTILE_LIFE,
			Stopped = false,
			Local = true,
			SpawnedAt = 0,
			Origin = Vector3.zero,
		})
	end
end

-- ---------------------------------------------------------------------
-- LICHTER (≤ 4, aus bei Reduzierten Effekten)
-- ---------------------------------------------------------------------
local function flashLight(pos: Vector3, color: Color3, range: number, seconds: number)
	if reduced() or not near(pos, 200) then
		return
	end
	local chosen: LightSlot? = nil
	for _, slot in ipairs(lights) do
		if not slot.Active then
			chosen = slot
			break
		end
	end
	if not chosen then
		return
	end
	chosen.Active = true
	chosen.Until = os.clock() + seconds
	chosen.Attachment.WorldPosition = pos
	chosen.Light.Color = color
	chosen.Light.Range = range
	chosen.Light.Enabled = true
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH: TRACER, TREFFER, MÜNDUNG
-- ---------------------------------------------------------------------
local function tracerStyle(tracerId: string?): any
	if type(tracerId) ~= "string" or tracerId == "" or not cosmeticModels then
		return nil
	end
	local cached = tracerStyles[tracerId]
	if cached ~= nil then
		return cached or nil
	end
	local ok, style = pcall(cosmeticModels.TracerStyle, tracerId)
	if ok and type(style) == "table" and typeof(style.Color) == "ColorSequence" then
		tracerStyles[tracerId] = style
		return style
	end
	tracerStyles[tracerId] = false
	return nil
end

function CombatFX.Tracer(from: Vector3, to: Vector3, color: Color3?, tracerId: string?)
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" or #tracers == 0 then
		return
	end
	if not near(from, FX_RANGE) and not near(to, FX_RANGE) then
		return
	end
	local tracer = tracers[tracerNext]
	tracerNext = tracerNext % #tracers + 1
	if not tracer.Active then
		tracersActive += 1
	end
	tracer.Active = true
	tracer.Age = 0
	tracer.Life = 0.07
	tracer.A0.WorldPosition = from
	tracer.A1.WorldPosition = to
	local beam = tracer.Beam
	local style = tracerStyle(tracerId)
	if typeof(color) == "Color3" then
		beam.Color = ColorSequence.new(color)
		beam.Width0, beam.Width1 = 0.12, 0.05
	elseif style then
		beam.Color = style.Color
		beam.Width0 = tonumber(style.Width0) or 0.12
		beam.Width1 = tonumber(style.Width1) or 0.05
		local texture = style.Texture
		beam.Texture = if type(texture) == "string" then texture else TEX.Gradient
	else
		beam.Color = ColorSequence.new(TRACER_DEFAULT)
		beam.Width0, beam.Width1 = 0.12, 0.05
	end
	beam.Transparency = tracerSeqs[1]
	beam.Enabled = true
end

local function allowImpact(): boolean
	local now = os.clock()
	if now - impactWindowStart >= 1 then
		impactWindowStart = now
		impactWindowCount = 0
	end
	impactWindowCount += 1
	return impactWindowCount <= poolSizes.Impacts
end

function CombatFX.Impact(pos: Vector3, normal: Vector3?, kind: string)
	if typeof(pos) ~= "Vector3" or #impacts == 0 or not near(pos, FX_RANGE) or not allowImpact() then
		return
	end
	local slot = impacts[impactNext]
	impactNext = impactNext % #impacts + 1
	local up = if typeof(normal) == "Vector3" and normal.Magnitude > 0.01 then normal.Unit else Vector3.yAxis
	-- Attachment so drehen, dass "oben" (Top) entlang der Flächennormale zeigt
	slot.Attachment.WorldCFrame = CFrame.lookAt(pos, pos + up) * CFrame.Angles(-math.pi / 2, 0, 0)
	if kind == "Head" then
		slot.Puff.Color = ColorSequence.new(Color3.fromRGB(255, 245, 160))
		slot.Stars.Color = ColorSequence.new(Color3.fromRGB(255, 225, 60))
		slot.Puff:Emit(count(2))
		slot.Stars:Emit(count(4))
		slot.Ring:Emit(1)
	elseif kind == "Player" then
		slot.Puff.Color = ColorSequence.new(WHITE)
		slot.Stars.Color = ColorSequence.new(WHITE)
		slot.Puff:Emit(count(3))
		slot.Stars:Emit(count(2))
	elseif kind == "Water" then
		slot.Dust.Color = ColorSequence.new(Color3.fromRGB(200, 230, 255))
		slot.Dust:Emit(count(5))
		sfx("Water", pos)
	else
		slot.Dust.Color = ColorSequence.new(Color3.fromRGB(220, 215, 205))
		slot.Sparks:Emit(count(5))
		slot.Dust:Emit(count(2))
	end
end

function CombatFX.Muzzle(cf: CFrame, weaponKey: string)
	if typeof(cf) ~= "CFrame" or #muzzles == 0 or not near(cf.Position, FX_RANGE) then
		return
	end
	local slot = muzzles[muzzleNext]
	muzzleNext = muzzleNext % #muzzles + 1
	slot.Attachment.WorldCFrame = cf
	local def = weaponDef(weaponKey)
	local big = type(def) == "table" and ((def.Pellets or 1) > 1 or def.Kind == "Projectile")
	slot.Core.Size = if big then seq(1.4, 0) else seq(0.9, 0)
	slot.Core:Emit(1)
	slot.Star:Emit(1)
	if not reduced() then
		slot.Smoke:Emit(1)
	end
	flashLight(cf.Position, Color3.fromRGB(255, 190, 90), 12, 0.05)
end

-- ---------------------------------------------------------------------
-- EXPLOSION, RAUCH, POP
-- ---------------------------------------------------------------------
function CombatFX.Explosion(pos: Vector3, radius: number)
	if typeof(pos) ~= "Vector3" then
		return
	end
	local r = if type(radius) == "number" and radius == radius then math.clamp(radius, 2, 40) else 10
	sfx("Explosion", pos)
	local cam = camPos()
	if cam then
		local dist = (cam - pos).Magnitude
		if dist < r * 3 then
			local effects = ctx and ctx.Modules and ctx.Modules.Effects
			if effects and type(effects.Shake) == "function" then
				pcall(effects.Shake, math.clamp(1.4 * (1 - dist / (r * 3)), 0.1, 1.4))
			end
		end
	end
	if #explosions == 0 or not near(pos, FX_RANGE) then
		return
	end
	local slot = explosions[explosionNext]
	explosionNext = explosionNext % #explosions + 1
	slot.Attachment.WorldPosition = pos
	local scale = r / 10
	slot.Fire.Size = seq(2 * scale, 6 * scale, 3 * scale)
	slot.Wave.Size = seq(1, r * 1.8)
	slot.Fire:Emit(count(8))
	slot.Wave:Emit(1)
	slot.Smoke:Emit(count(5))
	slot.Debris:Emit(count(10))
	flashLight(pos, Color3.fromRGB(255, 160, 60), math.clamp(r * 2, 10, 40), 0.18)
end

function CombatFX.Smoke(pos: Vector3, radius: number, untilT: number)
	if typeof(pos) ~= "Vector3" or type(untilT) ~= "number" or #smokes == 0 then
		return
	end
	local r = if type(radius) == "number" and radius == radius then math.clamp(radius, 2, 30) else 13
	local chosen: SmokeSlot? = nil
	for _, slot in ipairs(smokes) do
		if not slot.Active then
			chosen = slot
			break
		end
	end
	if not chosen then
		-- alle belegt: die, die am frühesten endet, wird umgesetzt
		for _, slot in ipairs(smokes) do
			if not chosen or slot.Until < chosen.Until then
				chosen = slot
			end
		end
	end
	if not chosen then
		return
	end
	chosen.Active = true
	chosen.Until = untilT
	chosen.Radius = r
	chosen.Attachment.WorldPosition = pos
	chosen.Emitter.Rate = if reduced() then 6 else 12
	chosen.Emitter.Enabled = true
	chosen.Ball.Size = Vector3.new(r * 2, r * 1.6, r * 2)
	chosen.Ball.CFrame = CFrame.new(pos)
	chosen.Ball.Transparency = 0.3
end

function CombatFX.Pop(pos: Vector3, finisherId: string, color: Color3)
	if typeof(pos) ~= "Vector3" or not near(pos, FINISHER_RANGE) then
		return
	end
	local tint = if typeof(color) == "Color3" then color else Color3.fromRGB(255, 220, 50)
	local finishers = ctx and ctx.Modules and ctx.Modules.Finishers
	if finishers and type(finishers.Play) == "function" and type(finisherId) == "string" and finisherId ~= "" then
		local ok, err = pcall(finishers.Play, finisherId, pos, tint)
		if ok then
			return
		end
		warn("[CombatFX] Finisher " .. finisherId .. ": " .. tostring(err))
	end
	-- Rückfall: Konfetti-Puff (wie der Standard-Finisher)
	if #pops == 0 then
		return
	end
	local index = popNext
	popNext = popNext % #pops + 1
	popAttachments[index].WorldPosition = pos
	pops[index]:Emit(count(24))
	local slot = impacts[impactNext]
	if slot then
		impactNext = impactNext % #impacts + 1
		slot.Attachment.WorldCFrame = CFrame.new(pos)
		slot.Puff.Color = ColorSequence.new(tint:Lerp(WHITE, 0.4))
		slot.Puff:Emit(count(6))
	end
end

-- ---------------------------------------------------------------------
-- PROJEKTILE (Kugeln/Raketen/Granaten; Server rechnet den Schaden)
-- ---------------------------------------------------------------------
local function projectileLook(def: any): (Color3, number, Enum.Material)
	local proj = type(def) == "table" and def.Projectile or nil
	if type(def) == "table" and (def.Kind == "Throwable" or def.Slot == "Utility") then
		if type(def.Smoke) == "table" then
			return Color3.fromRGB(200, 205, 215), 0.6, Enum.Material.SmoothPlastic
		end
		return Color3.fromRGB(90, 200, 90), 0.6, Enum.Material.SmoothPlastic
	end
	local radius = proj and tonumber(proj.Radius) or 0
	if radius > 0 then
		return Color3.fromRGB(255, 120, 0), 0.9, Enum.Material.Neon -- Rakete/Kanone (orange Spitze)
	end
	return Color3.fromRGB(150, 230, 255), 0.6, Enum.Material.Neon
end

local function freeProjectile(): Projectile?
	for _, p in ipairs(projectiles) do
		if not p.Active then
			return p
		end
	end
	-- alle belegt: das älteste fällt raus
	local oldest: Projectile? = nil
	for _, p in ipairs(projectiles) do
		if not oldest or p.SpawnedAt < oldest.SpawnedAt then
			oldest = p
		end
	end
	if oldest then
		CombatFX.RemoveProjectile(oldest.Id)
	end
	return oldest
end

local function spawnProjectile(
	id: string,
	weaponKey: string,
	origin: Vector3,
	velocity: Vector3,
	gravity: number,
	t0: number,
	isLocal: boolean
): Projectile?
	local p = freeProjectile()
	if not p then
		return nil
	end
	local def = weaponDef(weaponKey)
	local proj = type(def) == "table" and def.Projectile or nil
	local color, size, material = projectileLook(def)
	local age = math.clamp(workspace:GetServerTimeNow() - t0, 0, PROJECTILE_FASTFORWARD)
	local g = if type(gravity) == "number" and gravity == gravity then gravity else 0
	local pos = origin
	local vel = velocity
	if ballistics and age > 0 then
		pos, vel = ballistics.Step(origin, velocity, g, age) -- um die Laufzeit vorgespult (C11)
	end
	p.Active = true
	p.Id = id
	table.clear(p.Aliases)
	p.Key = weaponKey
	p.Pos = pos
	p.Vel = vel
	p.Gravity = g
	p.Bounces = proj and tonumber(proj.Bounces) or 0
	p.Restitution = proj and tonumber(proj.Restitution) or 0.35
	p.Age = age
	local life = proj and tonumber(proj.Lifetime) or PROJECTILE_LIFE
	local fuse = proj and tonumber(proj.Fuse)
	if fuse then
		life = math.min(life, fuse + 0.3)
	end
	p.Life = math.clamp(life, 0.2, 12)
	p.Stopped = false
	p.Local = isLocal
	p.SpawnedAt = os.clock()
	p.Origin = origin
	p.Part.Color = color
	p.Part.Material = material
	p.Part.Size = Vector3.new(size, size, size)
	p.Part.CFrame = CFrame.new(pos)
	p.Trail.Color = ColorSequence.new(color:Lerp(WHITE, 0.4), color)
	p.Trail.Enabled = not reduced()
	projectileById[id] = p
	projectilesActive += 1
	return p
end

function CombatFX.Projectile(
	id: string,
	weaponKey: string,
	origin: Vector3,
	velocity: Vector3,
	gravity: number,
	t0: number
)
	if typeof(origin) ~= "Vector3" or typeof(velocity) ~= "Vector3" then
		return
	end
	local key = tostring(id)
	if projectileById[key] then
		CombatFX.RemoveProjectile(key)
	end
	local start = if type(t0) == "number" and t0 == t0 then t0 else workspace:GetServerTimeNow()
	spawnProjectile(key, tostring(weaponKey), origin, velocity, gravity, start, true)
end

function CombatFX.RemoveProjectile(id: string)
	local key = tostring(id)
	local p = projectileById[key]
	if not p then
		return
	end
	projectileById[p.Id] = nil
	for _, alias in ipairs(p.Aliases) do
		projectileById[alias] = nil
	end
	table.clear(p.Aliases)
	if p.Active then
		p.Active = false
		projectilesActive -= 1
	end
	p.Trail.Enabled = false
	p.Part.CFrame = HIDDEN_CF
end

-- Server-Echo: eigenes Projektil (schon vorhergesagt) nur verknüpfen, fremdes neu zeigen
local function onServerProjectile(data: any)
	if type(data) ~= "table" or typeof(data.O) ~= "Vector3" or typeof(data.V) ~= "Vector3" then
		return
	end
	local serverId = "S" .. tostring(data.Id)
	local def = weaponDefById(tonumber(data.W) or 0)
	local key = if type(def) == "table" and type(def.Key) == "string" then def.Key else ""
	if tonumber(data.Own) == myCombatId then
		local now = os.clock()
		for _, p in ipairs(projectiles) do
			if
				p.Active
				and p.Local
				and now - p.SpawnedAt <= PREDICT_MATCH_TIME
				and (p.Key == key or key == "")
				and (p.Origin - data.O).Magnitude <= PREDICT_MATCH_DIST
				and #p.Aliases == 0
			then
				table.insert(p.Aliases, serverId)
				projectileById[serverId] = p
				return
			end
		end
	end
	if not near(data.O, FX_RANGE + 200) then
		return
	end
	local t0 = if type(data.T) == "number" then data.T else workspace:GetServerTimeNow()
	local p = spawnProjectile(serverId, key, data.O, data.V, tonumber(data.G) or 0, t0, false)
	if p and type(def) == "table" then
		local role = shotRole(def)
		if role then
			sfx(role, data.O)
		end
	end
end

local function stepProjectiles(dt: number)
	if projectilesActive <= 0 then
		return
	end
	table.clear(moveParts)
	table.clear(moveCFrames)
	local n = 0
	local params = rayParams
	for _, p in ipairs(projectiles) do
		if p.Active then
			p.Age += dt
			if p.Age >= p.Life then
				CombatFX.RemoveProjectile(p.Id)
			elseif not p.Stopped then
				local newPos, newVel
				if ballistics then
					newPos, newVel = ballistics.Step(p.Pos, p.Vel, p.Gravity, dt)
				else
					newVel = p.Vel - Vector3.new(0, p.Gravity * dt, 0)
					newPos = p.Pos + p.Vel * dt
				end
				local delta = newPos - p.Pos
				local hit = if arenaMap and delta.Magnitude > 1e-4 then workspace:Raycast(p.Pos, delta, params) else nil
				if hit then
					if p.Bounces > 0 and ballistics then
						p.Bounces -= 1
						p.Vel = ballistics.Reflect(newVel, hit.Normal, p.Restitution)
						p.Pos = hit.Position + hit.Normal * 0.3
					else
						p.Pos = hit.Position + hit.Normal * 0.3
						p.Vel = Vector3.zero
						p.Stopped = true -- liegt, bis "Boom" kommt oder die Lebenszeit abläuft
					end
				else
					p.Pos = newPos
					p.Vel = newVel
				end
				n += 1
				moveParts[n] = p.Part
				local look = if p.Vel.Magnitude > 0.1 then CFrame.lookAt(p.Pos, p.Pos + p.Vel) else CFrame.new(p.Pos)
				moveCFrames[n] = look
			end
		end
	end
	if n > 0 then
		workspace:BulkMoveTo(moveParts, moveCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- ---------------------------------------------------------------------
-- FX-BUFFER (Tracer anderer Schützen, 20 Hz pro Kontext)
-- ---------------------------------------------------------------------
local function onFx(b: any)
	if typeof(b) ~= "buffer" or not ctx then
		return
	end
	local ok, entries = pcall(ctx.Net.DecodeFx, b, arenaOrigin)
	if not ok or type(entries) ~= "table" then
		return
	end
	local fxCount = 0
	for _, entry in ipairs(entries) do
		fxCount += 1
		if fxCount > 58 then
			break
		end
		local def = weaponDefById(entry.Weapon)
		local key = if type(def) == "table" and type(def.Key) == "string" then def.Key else ""
		local o: Vector3, e: Vector3 = entry.O, entry.E
		if entry.Kind == 1 or entry.Kind == 2 then
			CombatFX.Tracer(o, e)
			CombatFX.Impact(e, (o - e), if entry.Kind == 2 then "Player" else "Surface")
			if (e - o).Magnitude > 0.5 then
				CombatFX.Muzzle(CFrame.lookAt(o, e), key)
			end
			local role = shotRole(def)
			if role then
				sfx(role, o)
			end
		elseif entry.Kind == 3 then
			sfx("MeleeSwing", o)
			if (e - o).Magnitude > 0.5 then
				sfx("MeleeHit", e)
				CombatFX.Impact(e, o - e, "Player")
			end
		elseif entry.Kind == 4 then
			sfx("Throw", o)
		end
	end
end

-- ---------------------------------------------------------------------
-- FRAME (aus dem einen PreRender-Loop von Main.client)
-- ---------------------------------------------------------------------
function CombatFX.Frame(dt: number)
	if tracersActive > 0 then
		for _, tracer in ipairs(tracers) do
			if tracer.Active then
				tracer.Age += dt
				local t = tracer.Age / tracer.Life
				if t >= 1 then
					tracer.Active = false
					tracer.Beam.Enabled = false
					tracersActive -= 1
				else
					tracer.Beam.Transparency = tracerSeqs[math.clamp(math.floor(t * 5) + 1, 1, #tracerSeqs)]
				end
			end
		end
	end
	local now = os.clock()
	for _, slot in ipairs(lights) do
		if slot.Active and now >= slot.Until then
			slot.Active = false
			slot.Light.Enabled = false
		end
	end
	local serverNow = workspace:GetServerTimeNow()
	for _, slot in ipairs(smokes) do
		if slot.Active then
			local left = slot.Until - serverNow
			if left <= 0 then
				slot.Active = false
				slot.Emitter.Enabled = false
				slot.Ball.Transparency = 1
				slot.Ball.CFrame = HIDDEN_CF
			elseif left < 1 then
				slot.Emitter.Enabled = false
				slot.Ball.Transparency = 0.3 + 0.7 * (1 - left)
			end
		end
	end
	stepProjectiles(dt)
end

-- ---------------------------------------------------------------------
-- START
-- ---------------------------------------------------------------------
local function setArena(origin: any, map: any)
	if typeof(origin) == "Vector3" then
		arenaOrigin = origin
	end
	if typeof(map) == "Instance" then
		arenaMap = map
		rayParams.FilterType = Enum.RaycastFilterType.Include
		rayParams.IncludeInstances = { map }
	end
end

local function clearAll()
	for _, p in ipairs(projectiles) do
		if p.Active then
			CombatFX.RemoveProjectile(p.Id)
		end
	end
	for _, slot in ipairs(smokes) do
		slot.Active = false
		slot.Emitter.Enabled = false
		slot.Ball.Transparency = 1
		slot.Ball.CFrame = HIDDEN_CF
	end
end

function CombatFX.Init(context: any)
	ctx = context
	local config = ctx.Config
	local pools = config and config.Client and config.Client.Pools
	if type(pools) == "table" then
		for key in pairs(poolSizes) do
			local value = pools[key]
			if type(value) == "number" and value >= 1 then
				poolSizes[key] = math.clamp(math.floor(value), 1, 128)
			end
		end
	end
	local client = config and config.Client
	if client then
		FX_RANGE = tonumber(client.FxRange) or FX_RANGE
		FINISHER_RANGE = tonumber(client.FinisherRange) or FINISHER_RANGE
	end
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local ballisticsModule = shared and shared:FindFirstChild("Ballistics")
	if ballisticsModule and ballisticsModule:IsA("ModuleScript") then
		local ok, result = pcall(require, ballisticsModule)
		ballistics = if ok then result else nil
	end
	local cosmeticModule = shared and shared:FindFirstChild("CosmeticModels")
	if cosmeticModule and cosmeticModule:IsA("ModuleScript") then
		local ok, result = pcall(require, cosmeticModule)
		cosmeticModels = if ok
				and type(result) == "table"
				and type(result.TracerStyle) == "function"
			then result
			else nil
	end

	local newFolder = Instance.new("Folder")
	newFolder.Name = "ClutchClashCombatFX"
	newFolder.Parent = workspace
	folder = newFolder
	local newAnchor = Instance.new("Part")
	newAnchor.Name = "FxAnchor"
	newAnchor.Anchored = true
	newAnchor.CanCollide = false
	newAnchor.CanQuery = false
	newAnchor.CanTouch = false
	newAnchor.CastShadow = false
	newAnchor.Transparency = 1
	newAnchor.Size = Vector3.new(0.2, 0.2, 0.2)
	newAnchor.CFrame = CFrame.new() -- im Ursprung: Attachment.Position == Weltposition
	newAnchor.Parent = newFolder
	anchor = newAnchor
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.ExcludeInstances = { newFolder }

	buildTracers()
	buildImpacts()
	buildMuzzles()
	buildExplosions()
	buildSmokes()
	buildLights()
	buildPops()
	buildProjectiles()

	local hooks = ctx.Hooks
	hooks.On("Match:Start", function(data)
		setArena(data.Origin, nil)
	end)
	hooks.On("Combat:Armed", function(data)
		myCombatId = tonumber(data.Id) or player.UserId
		setArena(data.Origin, data.Map)
	end)
	hooks.On("Combat:Disarmed", clearAll)
	hooks.On("Match:Closed", clearAll)
	hooks.On("Combat:Proj", onServerProjectile)
	hooks.On("Combat:Boom", function(data)
		if type(data) ~= "table" then
			return
		end
		CombatFX.RemoveProjectile("S" .. tostring(data.Id))
		if typeof(data.P) == "Vector3" then
			CombatFX.Explosion(data.P, tonumber(data.R) or 10)
		end
	end)
	hooks.On("Combat:Smoke", function(data)
		if type(data) == "table" and typeof(data.P) == "Vector3" then
			CombatFX.Smoke(data.P, tonumber(data.R) or 13, tonumber(data.Until) or 0)
		end
	end)
	local fxRemote = ctx.Remotes and ctx.Remotes.FX
	if fxRemote and fxRemote:IsA("UnreliableRemoteEvent") then
		fxRemote.OnClientEvent:Connect(onFx)
	end
end

function CombatFX.Start() end

return CombatFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">CombatHud</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Kampf-HUD (Client/Modules/CombatHud)
--  Besitzer: WP10 (Client-Hülle). Vertrag: DESIGN.md C7.4, B14.1 (Juice-Tabelle), B14.4, B15.3,
--  docs/SKILL-WUENSCHE.md (Kopfschuss-Ding, Kill-Bestätigung, Treffer-Stopp, knackige Marker).
--
--  Fadenkreuz (4 Stile: Kreuz, Punkt, Kreis, T; Farbe/Größe/Lücke/Punkt aus den Einstellungen,
--  Streuung öffnet es), Leben (Herzschlag-Vignette < 30 HP), Munition (wackelt rot bei 0 + Nachlade-
--  Hinweis passend zum Gerät), Slot-Leiste, Hitmarker (vorläufig sofort, Server-Bestätigung ersetzt
--  ihn; Kopf = großes gelbes X + "HEADSHOT!" + Ding, Pop = rotes X + Kill-Jingle + Treffer-Stopp +
--  FOV-Punch), Schadenszahlen (stapeln pro Ziel 0.6 s), Richtungspfeile + rote Rand-Blende,
--  Kill-Banner + DOUBLE!/TRIPLE!/QUAD!/ACE!, Gegner-Umrisse über den Highlights-Verteiler.
--  Alles ist vorgebaut/gepoolt; UI-Werte werden nur bei Änderung geschrieben.
--
--  Öffentliche API (C7.4):
--    CombatHud.Show(on)  CombatHud.SetHp(hp, max)  CombatHud.SetAmmo(mag, max, reloading, reloadProgress?)
--    CombatHud.SetSpread(deg)  CombatHud.Hitmarker(region, killed, provisional?)
--    CombatHud.DamageNumber(pos, amount, head)  CombatHud.Hurt(fromPos, amount)  CombatHud.KillBanner(name)
--    CombatHud.SetSlots(loadout, equipped, charges)
--  Zusätzlich: CombatHud.MakePreview(parent): Frame (Fadenkreuz-Vorschau fürs Einstellungen-Fenster),
--    CombatHud.Frame(dt), CombatHud.Tick(), CombatHud.Init(ctx), CombatHud.Start()
--  Hört selbst: Hooks "Combat:Hit/Hurt/Heal/Armed/Disarmed", "Match:Start/Elim/AntiCamp/Left/Closed",
--    "Equip", "LocalPopped", "LocalRevived", "Settings", "Input". Feuert "Hitmarker"(region, killed).
-- =====================================================================

local CollectionService = game:GetService("CollectionService")
local HapticService = game:GetService("HapticService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local CombatHud = {}

local player = Players.LocalPlayer
local Theme = UI.Theme
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local RED = Color3.fromRGB(255, 50, 60)
local YELLOW = Color3.fromRGB(255, 225, 40)
local HIDDEN_CF = CFrame.new(0, -4000, 0)
local TRIANGLE = "rbxasset://textures/triangle.png"

-- Zeiten (Config.Client.Hud überschreibt)
local HUD = {
	HitmarkerBody = 0.12,
	HitmarkerHead = 0.22,
	HitmarkerKill = 0.4,
	DamageStack = 0.6,
	DamageLife = 0.85,
	HurtArrow = 1.2,
	LowHp = 30,
	LowAmmo = 0.25,
	MultiKillWindow = 4,
	KillBanner = 1.6,
	HitStopKill = 0.07, -- Treffer-Stopp beim Pop (Marker hält, Sounds geduckt, Mini-Ruck)
	HitStopHead = 0.04,
	FovPunch = 3, -- FOV +3 beim Pop (B14.1)
}

local ctx: any = nil
local combatGui: ScreenGui? = nil
local hudRoot: Frame? = nil -- Panels in ctx.Gui (Leben, Munition, Slots)
local shown = false
local popped = false

-- ---------------------------------------------------------------------
-- HILFEN
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

-- Schlüssel eines anderen Pakets (z. B. combat.popped von WP3), sonst eigener ui.-Ersatz
local function TOr(key: string, fallback: string, ...: any): string
	local lang = ctx and ctx.Lang
	if lang and type(lang.Has) == "function" then
		local ok, has = pcall(lang.Has, key)
		if ok and has then
			return T(key, ...)
		end
	end
	return T(fallback, ...)
end

local function settings(): { [string]: any }
	local module = ctx and ctx.Modules and ctx.Modules.Settings
	if module and type(module.Get) == "function" then
		local ok, value = pcall(module.Get)
		if ok and type(value) == "table" then
			return value
		end
	end
	local config = ctx and ctx.Config
	return config and config.Client and config.Client.DefaultSettings or {}
end

local function sfx(role: string, pos: Vector3?, opts: any?)
	local module = ctx and ctx.Modules and ctx.Modules.Sfx
	if module and type(module.Play) == "function" then
		pcall(module.Play, role, pos, opts)
	end
end

local function module(name: string): any
	return ctx and ctx.Modules and ctx.Modules[name]
end

local function inputKind(): string
	local controls = module("Controls")
	if controls and type(controls.Input) == "function" then
		local ok, kind = pcall(controls.Input)
		if ok and type(kind) == "string" then
			return kind
		end
	end
	return "KBM"
end

local function frame(props: { [string]: any }, children: { Instance }?): Frame
	local base: { [string]: any } = { BorderSizePixel = 0, BackgroundColor3 = WHITE }
	for key, value in pairs(props) do
		base[key] = value
	end
	return UI.Create("Frame", base, children)
end

local function outline(parent: Instance, thickness: number?)
	UI.Create("UIStroke", {
		Thickness = thickness or 1,
		Color = BLACK,
		Transparency = 0.25,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

-- ---------------------------------------------------------------------
-- FADENKREUZ (auch als Vorschau im Einstellungen-Fenster)
-- ---------------------------------------------------------------------
type Crosshair = {
	Root: Frame,
	Top: Frame,
	Bottom: Frame,
	Left: Frame,
	Right: Frame,
	Dot: Frame,
	Ring: Frame,
	RingStroke: UIStroke,
	Key: string,
}

local THICK = 2

local function buildCrosshair(parent: Instance, z: number): Crosshair
	local rootFrame = frame({
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})
	local function bar(name: string): Frame
		local f = frame({ Name = name, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z, Parent = rootFrame })
		outline(f)
		return f
	end
	local dot = frame({
		Name = "Dot",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(THICK + 1, THICK + 1),
		ZIndex = z,
		Parent = rootFrame,
	})
	UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = dot })
	outline(dot)
	local ring = frame({
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = rootFrame,
	})
	UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = ring })
	local ringStroke: UIStroke = UI.Create("UIStroke", { Thickness = THICK, Color = WHITE, Parent = ring })
	return {
		Root = rootFrame,
		Top = bar("Top"),
		Bottom = bar("Bottom"),
		Left = bar("Left"),
		Right = bar("Right"),
		Dot = dot,
		Ring = ring,
		RingStroke = ringStroke,
		Key = "",
	}
end

local function crosshairColor(name: any): Color3
	local config = ctx and ctx.Config
	local colors = config and config.Client and config.Client.CrosshairColors
	local color = type(colors) == "table" and colors[name] or nil
	return if typeof(color) == "Color3" then color else WHITE
end

-- Stil 1 Kreuz, 2 Punkt, 3 Kreis, 4 T; spreadPx öffnet die Lücke (nur bei Änderung neu schreiben)
local function applyCrosshair(c: Crosshair, cfg: any, spreadPx: number)
	local style = math.clamp(math.floor(tonumber(cfg and cfg.Style) or 1), 1, 4)
	local size = math.clamp(tonumber(cfg and cfg.Size) or 8, 4, 16)
	local gap = math.clamp(tonumber(cfg and cfg.Gap) or 4, 0, 10) + spreadPx
	local dotOn = cfg == nil or cfg.Dot ~= false
	local colorName = cfg and cfg.Color or "White"
	local key = ("%d|%d|%.1f|%s|%s"):format(style, math.floor(size), gap, tostring(dotOn), tostring(colorName))
	if key == c.Key then
		return
	end
	c.Key = key
	local color = crosshairColor(colorName)
	local bars = style == 1 or style == 4
	c.Top.Visible = style == 1
	c.Bottom.Visible = bars
	c.Left.Visible = bars
	c.Right.Visible = bars
	c.Ring.Visible = style == 3
	c.Dot.Visible = style == 2 or dotOn
	local offset = gap + size / 2
	c.Top.Size = UDim2.fromOffset(THICK, size)
	c.Bottom.Size = UDim2.fromOffset(THICK, size)
	c.Left.Size = UDim2.fromOffset(size, THICK)
	c.Right.Size = UDim2.fromOffset(size, THICK)
	c.Top.Position = UDim2.fromOffset(0, -offset)
	c.Bottom.Position = UDim2.fromOffset(0, offset)
	c.Left.Position = UDim2.fromOffset(-offset, 0)
	c.Right.Position = UDim2.fromOffset(offset, 0)
	local ringSize = math.max(8, (gap + size / 2) * 2)
	c.Ring.Size = UDim2.fromOffset(ringSize, ringSize)
	local dotSize = if style == 2 then THICK + 3 else THICK + 1
	c.Dot.Size = UDim2.fromOffset(dotSize, dotSize)
	for _, f in ipairs({ c.Top, c.Bottom, c.Left, c.Right, c.Dot }) do
		f.BackgroundColor3 = color
	end
	c.RingStroke.Color = color
end

local crosshair: Crosshair? = nil
local previews: { Crosshair } = {}
local spreadDeg = 0
local spreadPx = 0

local function spreadToPixels(deg: number): number
	local camera = workspace.CurrentCamera
	if not camera or deg <= 0 then
		return 0
	end
	local fov = math.rad(math.clamp(camera.FieldOfView, 1, 120))
	local px = math.tan(math.rad(math.min(deg, 30))) / math.tan(fov / 2) * (camera.ViewportSize.Y / 2)
	return math.clamp(px, 0, 120)
end

local function refreshCrosshair()
	local cfg = settings().Crosshair
	if crosshair then
		applyCrosshair(crosshair, cfg, spreadPx)
	end
	for _, preview in ipairs(previews) do
		if preview.Root.Parent then
			applyCrosshair(preview, cfg, 0)
		end
	end
end

-- ---------------------------------------------------------------------
-- HITMARKER (vier schräge Balken um die Mitte)
-- ---------------------------------------------------------------------
type Marker =
	{ Holder: Frame, Scale: UIScale, Bars: { Frame }, Age: number, Life: number, Hold: number, Active: boolean }
local marker: Marker? = nil
local headshotLabel: TextLabel? = nil
local headshotScale: UIScale? = nil
local headshotUntil = 0

local function buildMarker(parent: Instance)
	local holder = frame({
		Name = "Hitmarker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(44, 44),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 6,
		Parent = parent,
	})
	local scale: UIScale = UI.Create("UIScale", { Parent = holder })
	local bars: { Frame } = {}
	for i, dir in ipairs({ Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(-1, 1), Vector2.new(1, 1) }) do
		local b = frame({
			Name = "Bar" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, dir.X * 11, 0.5, dir.Y * 11),
			Size = UDim2.fromOffset(3, 12),
			Rotation = if dir.X * dir.Y > 0 then -45 else 45,
			ZIndex = 6,
			Parent = holder,
		})
		outline(b)
		table.insert(bars, b)
	end
	marker = { Holder = holder, Scale = scale, Bars = bars, Age = 0, Life = 0.1, Hold = 0, Active = false }
	headshotLabel = UI.Label({
		Name = "Headshot",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 34),
		Size = UDim2.fromOffset(260, 40),
		Text = "",
		Font = UI.Fonts.Pop,
		TextColor3 = YELLOW,
		MaxText = 36,
		Outline = 3,
		Visible = false,
		ZIndex = 7,
		Parent = parent,
	})
	headshotScale = UI.Create("UIScale", { Parent = headshotLabel })
end

local function showMarker(color: Color3, length: number, thickness: number, life: number, hold: number, alpha: number)
	local m = marker
	if not m then
		return
	end
	m.Active = true
	m.Age = 0
	m.Life = life
	m.Hold = hold
	m.Scale.Scale = 1.55
	m.Holder.Rotation = math.random(-6, 6) -- jeder Treffer etwas anders = knackiger
	m.Holder.Visible = true
	for _, b in ipairs(m.Bars) do
		b.BackgroundColor3 = color
		b.Size = UDim2.fromOffset(thickness, length)
		b.BackgroundTransparency = alpha
	end
end

local function stepMarker(dt: number)
	local m = marker
	if m and m.Active then
		if m.Hold > 0 then
			m.Hold -= dt -- Treffer-Stopp: Marker friert kurz in voller Größe ein
			return
		end
		m.Age += dt
		local t = m.Age / m.Life
		if t >= 1 then
			m.Active = false
			m.Holder.Visible = false
			return
		end
		m.Scale.Scale = 1 + 0.55 * math.max(0, 1 - m.Age / 0.06)
		if t > 0.55 then
			local fade = (t - 0.55) / 0.45
			for _, b in ipairs(m.Bars) do
				b.BackgroundTransparency = math.max(b.BackgroundTransparency, fade)
			end
		end
	end
	local label = headshotLabel
	if label and label.Visible then
		local now = os.clock()
		if now >= headshotUntil then
			label.Visible = false
		elseif headshotScale then
			headshotScale.Scale = math.max(1, headshotScale.Scale - dt * 4)
		end
	end
end

-- ---------------------------------------------------------------------
-- FOV-PUNCH + TREFFER-STOPP (nach der FpsCamera, ohne deren FOV zu verfälschen)
-- ---------------------------------------------------------------------
local FOV_BIND = "ClutchClashFovPunch"
local punchAmount = 0
local punchTime = 0
local punchLeft = 0
local punchBound = false
local lastWrittenFov: number? = nil
local lastBaseFov: number? = nil

local function stepPunch(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	punchLeft -= dt
	local current = camera.FieldOfView
	-- Hat jemand (FpsCamera) seit unserem letzten Schreiben das FOV gesetzt? Dann ist das die neue Basis.
	local base = if lastWrittenFov
			and math.abs(current - lastWrittenFov) < 1e-3
			and lastBaseFov
		then lastBaseFov
		else current
	if punchLeft <= 0 then
		camera.FieldOfView = base
		lastWrittenFov, lastBaseFov = nil, nil
		if punchBound then
			punchBound = false
			RunService:UnbindFromRenderStep(FOV_BIND)
		end
		return
	end
	local t = 1 - punchLeft / punchTime
	local curve = if t < 0.2 then t / 0.2 else 1 - (t - 0.2) / 0.8 -- schnell rein, weich raus
	local value = math.clamp(base + punchAmount * curve, 1, 120)
	camera.FieldOfView = value
	lastWrittenFov, lastBaseFov = value, base
end

local function fovPunch(amount: number, duration: number)
	local mult = tonumber(settings().Shake)
	if mult then
		amount *= math.clamp(mult, 0, 1)
	end
	if amount <= 0.05 then
		return
	end
	punchAmount = amount
	punchTime = duration
	punchLeft = duration
	if not punchBound then
		punchBound = true
		RunService:BindToRenderStep(FOV_BIND, Enum.RenderPriority.Camera.Value + 5, stepPunch)
	end
end

local function hitStop(seconds: number, duck: number)
	local m = marker
	if m and m.Active then
		m.Hold = math.max(m.Hold, seconds)
	end
	local sfxModule = module("Sfx")
	if sfxModule and type(sfxModule.Duck) == "function" then
		pcall(sfxModule.Duck, duck, seconds + 0.05)
	end
	local camera = module("FpsCamera")
	local mult = tonumber(settings().Shake) or 1
	if camera and type(camera.Shake) == "function" and mult > 0 then
		pcall(camera.Shake, 0.18 * mult, seconds + 0.03)
	end
end

local function rumble(strength: number, seconds: number)
	if inputKind() ~= "Gamepad" then
		return
	end
	local ok = pcall(function()
		if HapticService:IsMotorSupported(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small) then
			HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, strength)
		end
	end)
	if ok then
		task.delay(seconds, function()
			pcall(function()
				HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, 0)
			end)
		end)
	end
end

-- ---------------------------------------------------------------------
-- KILL-BANNER + MEHRFACH-POPS
-- ---------------------------------------------------------------------
local bannerLabel: TextLabel? = nil
local bannerScale: UIScale? = nil
local bannerUntil = 0
local multiLabel: TextLabel? = nil
local multiScale: UIScale? = nil
local multiUntil = 0
local killTimes: { number } = {}
local MULTI_KEYS = { "", "ui.multi2", "ui.multi3", "ui.multi4", "ui.multi5" }
local BANNER_POP = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local function buildBanners(parent: Instance)
	bannerLabel = UI.Label({
		Name = "KillBanner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.66),
		Size = UDim2.fromOffset(560, 52),
		Text = "",
		Font = UI.Fonts.Pop,
		TextColor3 = WHITE,
		MaxText = 46,
		Outline = 4,
		Visible = false,
		ZIndex = 8,
		Parent = parent,
	})
	bannerScale = UI.Create("UIScale", { Parent = bannerLabel })
	multiLabel = UI.Label({
		Name = "MultiKill",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.6),
		Size = UDim2.fromOffset(420, 60),
		Text = "",
		Font = UI.Fonts.Banner,
		TextColor3 = YELLOW,
		MaxText = 56,
		Outline = 4,
		Visible = false,
		ZIndex = 8,
		Parent = parent,
	})
	multiScale = UI.Create("UIScale", { Parent = multiLabel })
end

local function countKill(): number
	local now = os.clock()
	local window = HUD.MultiKillWindow
	local kept: { number } = {}
	for _, t in ipairs(killTimes) do
		if now - t <= window then
			table.insert(kept, t)
		end
	end
	table.insert(kept, now)
	while #kept > 5 do
		table.remove(kept, 1)
	end
	killTimes = kept
	return #kept
end

local lastBannerName = ""
local lastBannerAt = -math.huge

function CombatHud.KillBanner(name: string)
	local label = bannerLabel
	if not label then
		return
	end
	local shortName = string.sub(tostring(name or "?"), 1, 32)
	-- derselbe Pop von zwei Stellen gemeldet (Combat-Hit + Match-Elim): nur einmal zählen
	local now = os.clock()
	if shortName == lastBannerName and now - lastBannerAt < 0.3 then
		return
	end
	lastBannerName, lastBannerAt = shortName, now
	local text = TOr("combat.popped", "ui.popped", shortName)
	label.Text = text
	label.TextColor3 = WHITE
	label.Visible = true
	bannerUntil = os.clock() + HUD.KillBanner
	if bannerScale then
		bannerScale.Scale = 0.5
		TweenService:Create(bannerScale, BANNER_POP, { Scale = 1 }):Play()
	end
	local n = countKill()
	local pitch = 1 + 0.12 * (n - 1) -- Tonhöhe steigt bei Mehrfach-Pops
	sfx("Kill", nil, { Speed = pitch })
	if n >= 2 and multiLabel then
		multiLabel.Text = T(MULTI_KEYS[math.min(n, #MULTI_KEYS)])
		multiLabel.Visible = true
		multiUntil = os.clock() + HUD.KillBanner + 0.3
		if multiScale then
			multiScale.Scale = 1.8
			TweenService:Create(multiScale, BANNER_POP, { Scale = 1 }):Play()
		end
		local effects = module("Effects")
		if n >= 3 and effects and type(effects.Confetti) == "function" then
			pcall(effects.Confetti, 0.5 + 0.25 * n)
		end
	end
end

local function stepBanners()
	local now = os.clock()
	if bannerLabel and bannerLabel.Visible and now >= bannerUntil then
		bannerLabel.Visible = false
	end
	if multiLabel and multiLabel.Visible and now >= multiUntil then
		multiLabel.Visible = false
	end
end

-- ---------------------------------------------------------------------
-- HITMARKER (öffentlich)
-- ---------------------------------------------------------------------
local lastMarkerKey = ""
local lastMarkerAt = -math.huge

function CombatHud.Hitmarker(region: string, killed: boolean, provisional: boolean?)
	if not shown then
		return
	end
	-- dieselbe Bestätigung im selben Moment doppelt (zwei Module hören auf Combat:Hit): einmal reicht
	local markerKey = tostring(region) .. tostring(killed) .. tostring(provisional)
	local now = os.clock()
	if markerKey == lastMarkerKey and now - lastMarkerAt < 0.03 then
		return
	end
	lastMarkerKey, lastMarkerAt = markerKey, now
	if provisional then
		-- vorläufig (sofort beim Schuss): klein, halbdurchsichtig, nie als Kill
		showMarker(WHITE, 9, 2, 0.1, 0, 0.45)
		return
	end
	local head = region == "Head"
	if killed then
		showMarker(RED, 15, 4, HUD.HitmarkerKill, 0, 0)
		hitStop(HUD.HitStopKill, 0.55)
		fovPunch(HUD.FovPunch, 0.32)
		rumble(0.9, 0.08)
	elseif head then
		showMarker(YELLOW, 14, 4, HUD.HitmarkerHead, 0, 0)
		hitStop(HUD.HitStopHead, 0.35)
		rumble(0.7, 0.05)
	else
		showMarker(WHITE, 11, 3, HUD.HitmarkerBody, 0, 0)
		rumble(0.5, 0.04)
	end
	if head then
		sfx("Headshot")
		local label = headshotLabel
		if label then
			label.Text = T("ui.headshot")
			label.Visible = true
			headshotUntil = os.clock() + 0.7
			if headshotScale then
				headshotScale.Scale = 1.6
			end
		end
	elseif not killed then
		sfx("Hitmarker")
	end
	ctx.Hooks.Fire("Hitmarker", region, killed == true)
end

-- ---------------------------------------------------------------------
-- SCHADENSZAHLEN (24 BillboardGuis im Vorrat, stapeln pro Ziel)
-- ---------------------------------------------------------------------
type DamageEntry = {
	Gui: BillboardGui,
	Label: TextLabel,
	Scale: UIScale,
	Attachment: Attachment,
	Active: boolean,
	Age: number,
	Total: number,
	Head: boolean,
	Key: string,
	Base: Vector3,
	Drift: number,
	LastAdd: number,
}
local damagePool: { DamageEntry } = {}
local damageAnchor: Part? = nil

local function buildDamagePool(size: number)
	local folder = Instance.new("Folder")
	folder.Name = "ClutchClashDamageNumbers"
	folder.Parent = player:WaitForChild("PlayerGui")
	local anchorPart = Instance.new("Part")
	anchorPart.Name = "ClutchClashDamageAnchor"
	anchorPart.Anchored = true
	anchorPart.CanCollide = false
	anchorPart.CanQuery = false
	anchorPart.CanTouch = false
	anchorPart.CastShadow = false
	anchorPart.Transparency = 1
	anchorPart.Size = Vector3.new(0.2, 0.2, 0.2)
	anchorPart.CFrame = CFrame.new()
	anchorPart.Parent = workspace
	damageAnchor = anchorPart
	for i = 1, size do
		local attachment = Instance.new("Attachment")
		attachment.Name = "Dmg" .. i
		attachment.WorldPosition = HIDDEN_CF.Position
		attachment.Parent = anchorPart
		local gui = Instance.new("BillboardGui")
		gui.Name = "Damage" .. i
		gui.Adornee = attachment
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.MaxDistance = 600
		gui.Size = UDim2.fromOffset(150, 56)
		gui.ResetOnSpawn = false
		gui.Enabled = false
		gui.Parent = folder
		local label = UI.Label({
			Size = UDim2.fromScale(1, 1),
			Text = "",
			Font = UI.Fonts.Pop,
			MaxText = 44,
			Outline = 3,
			Parent = gui,
		})
		local scale: UIScale = UI.Create("UIScale", { Parent = label })
		table.insert(damagePool, {
			Gui = gui,
			Label = label,
			Scale = scale,
			Attachment = attachment,
			Active = false,
			Age = 0,
			Total = 0,
			Head = false,
			Key = "",
			Base = Vector3.zero,
			Drift = 0,
			LastAdd = 0,
		})
	end
end

local photoHidden = false -- Foto-Modus (Hook "PhotoMode"): keine Zahlen über den Köpfen

local function showDamage(key: string, pos: Vector3, amount: number, head: boolean)
	if photoHidden or settings().DamageNumbers == false or #damagePool == 0 then
		return
	end
	local now = os.clock()
	local entry: DamageEntry? = nil
	-- gleiches Ziel innerhalb von 0.6 s: Zahl stapelt sich
	for _, e in ipairs(damagePool) do
		if e.Active and e.Key == key and now - e.LastAdd <= HUD.DamageStack then
			entry = e
			break
		end
	end
	if not entry then
		local oldest: DamageEntry? = nil
		for _, e in ipairs(damagePool) do
			if not e.Active then
				entry = e
				break
			end
			if not oldest or e.LastAdd < oldest.LastAdd then
				oldest = e
			end
		end
		entry = entry or oldest
		if not entry then
			return
		end
		entry.Total = 0
		entry.Head = false
		entry.Drift = (math.random() - 0.5) * 1.2
	end
	local e = entry :: DamageEntry
	e.Active = true
	e.Key = key
	e.Age = 0
	e.LastAdd = now
	e.Total += math.max(0, math.floor(amount + 0.5))
	e.Head = e.Head or head
	e.Base = pos
	e.Label.Text = if e.Head then tostring(e.Total) .. "!" else tostring(e.Total)
	e.Label.TextColor3 = if e.Head then YELLOW else WHITE
	e.Label.TextTransparency = 0
	e.Scale.Scale = if head then 1.9 else 1.5
	e.Gui.Enabled = true
	e.Attachment.WorldPosition = pos
end

function CombatHud.DamageNumber(pos: Vector3, amount: number, head: boolean)
	if typeof(pos) ~= "Vector3" or type(amount) ~= "number" or amount ~= amount then
		return
	end
	-- öffentliche Variante ohne Ziel-Id: stapelt nach Nähe (≈ gleiches Ziel)
	local key = ("p%d_%d_%d"):format(math.floor(pos.X / 4), math.floor(pos.Y / 4), math.floor(pos.Z / 4))
	showDamage(key, pos, amount, head == true)
end

local function stepDamage(dt: number)
	local life = HUD.DamageLife
	for _, e in ipairs(damagePool) do
		if e.Active then
			e.Age += dt
			local t = e.Age / life
			if t >= 1 then
				e.Active = false
				e.Gui.Enabled = false
			else
				e.Scale.Scale = math.max(1, e.Scale.Scale - dt * 6)
				e.Attachment.WorldPosition = e.Base + Vector3.new(e.Drift * t, 1.2 + 2.2 * t, 0)
				if t > 0.6 then
					e.Label.TextTransparency = (t - 0.6) / 0.4
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- SCHADEN ERHALTEN: Richtungspfeile + rote Rand-Blende + Herzschlag
-- ---------------------------------------------------------------------
type Arrow = { Image: ImageLabel, From: Vector3, Age: number, Active: boolean }
local arrows: { Arrow } = {}
local arrowNext = 1
local edgeFrames: { Frame } = {}
local hurtFlash = 0
local hpNow = 100
local hpMax = 100
local heartClock = 0

local function buildHurt(parent: Instance)
	for i = 1, 4 do
		local image: ImageLabel = UI.Create("ImageLabel", {
			Name = "HurtArrow" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(30, 40),
			BackgroundTransparency = 1,
			Image = TRIANGLE,
			ImageColor3 = RED,
			Visible = false,
			ZIndex = 5,
			Parent = parent,
		})
		table.insert(arrows, { Image = image, From = Vector3.zero, Age = 0, Active = false })
	end
	-- Rand-Verlauf: vier Kanten, außen rot, innen durchsichtig (Frame + UIGradient)
	local edges = {
		{
			AnchorPoint = Vector2.new(0, 0),
			Position = UDim2.fromScale(0, 0),
			Size = UDim2.fromScale(1, 0.22),
			Rot = 90,
		},
		{
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0.22),
			Rot = -90,
		},
		{ AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(0.16, 1), Rot = 0 },
		{
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromScale(0.16, 1),
			Rot = 180,
		},
	}
	for i, spec in ipairs(edges) do
		local f = frame({
			Name = "HurtEdge" .. i,
			AnchorPoint = spec.AnchorPoint,
			Position = spec.Position,
			Size = spec.Size,
			BackgroundColor3 = Color3.fromRGB(255, 20, 30),
			BackgroundTransparency = 1,
			ZIndex = 1,
			Parent = parent,
		})
		UI.Create("UIGradient", {
			Rotation = spec.Rot,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = f,
		})
		table.insert(edgeFrames, f)
	end
end

function CombatHud.Hurt(fromPos: Vector3, amount: number)
	if typeof(fromPos) == "Vector3" and #arrows > 0 then
		local arrow = arrows[arrowNext]
		arrowNext = arrowNext % #arrows + 1
		arrow.From = fromPos
		arrow.Age = 0
		arrow.Active = true
		arrow.Image.Visible = shown
	end
	local strength = math.clamp((tonumber(amount) or 10) / 40, 0.25, 1)
	hurtFlash = math.max(hurtFlash, strength)
	if hpNow <= HUD.LowHp then
		sfx("Hurt")
	end
	local effects = module("Effects")
	if effects and type(effects.Shake) == "function" then
		pcall(effects.Shake, 0.25 * strength)
	end
end

local function stepHurt(dt: number)
	local camera = workspace.CurrentCamera
	local gui = combatGui
	for _, arrow in ipairs(arrows) do
		if arrow.Active then
			arrow.Age += dt
			if arrow.Age >= HUD.HurtArrow or not camera or not gui then
				arrow.Active = false
				arrow.Image.Visible = false
			else
				local rel = camera.CFrame:PointToObjectSpace(arrow.From)
				local angle = math.atan2(rel.X, -rel.Z) -- 0 = vorne (oben auf dem Schirm)
				local size = gui.AbsoluteSize
				local radius = math.min(size.X, size.Y) * 0.2
				arrow.Image.Position =
					UDim2.fromOffset(size.X / 2 + math.sin(angle) * radius, size.Y / 2 - math.cos(angle) * radius)
				arrow.Image.Rotation = math.deg(angle)
				arrow.Image.ImageTransparency = math.clamp((arrow.Age / HUD.HurtArrow - 0.5) * 2, 0, 1)
				arrow.Image.Visible = shown
			end
		end
	end
	-- Blende: Treffer-Blitz + Herzschlag unter 30 HP
	hurtFlash = math.max(0, hurtFlash - dt * 2.2)
	local low = shown and not popped and hpNow > 0 and hpNow <= HUD.LowHp
	local beat = 0
	if low then
		heartClock += dt
		local danger = 1 - hpNow / math.max(1, HUD.LowHp)
		beat = (0.25 + 0.3 * danger) * (0.5 + 0.5 * math.sin(heartClock * (6 + 4 * danger)))
	end
	local alpha = math.max(hurtFlash * 0.75, beat)
	local transparency = if shown then 1 - alpha else 1
	for _, f in ipairs(edgeFrames) do
		if math.abs(f.BackgroundTransparency - transparency) > 0.01 then
			f.BackgroundTransparency = transparency
		end
	end
end

-- ---------------------------------------------------------------------
-- PANELS: Leben, Munition, Slots (in ctx.Gui, skaliert)
-- ---------------------------------------------------------------------
local hpPanel: Frame? = nil
local hpText: TextLabel? = nil
local hpFill: Frame? = nil
local ammoPanel: Frame? = nil
local ammoText: TextLabel? = nil
local ammoMaxText: TextLabel? = nil
local reloadBack: Frame? = nil
local reloadFill: Frame? = nil
local reloadHint: TextLabel? = nil
local slotPanel: Frame? = nil
local slotCells: { { Frame: Frame, Name: TextLabel, Key: TextLabel, Charges: TextLabel, Stroke: UIStroke, Scale: UIScale } } =
	{}
local lastHpKey = ""
local lastAmmoKey = ""
local lastSlotsKey = ""
local ammoMag = 0
local ammoShake = 0
local slotLoadout: { [string]: string } = {}
local slotCharges: { [string]: number } = {}
local slotEquipped = "Primary"
local SLOT_NAMES = { "Primary", "Secondary", "Melee", "Utility" }

local function buildPanels(parent: Frame)
	-- Leben unten links
	local hp = frame({
		Name = "Health",
		Size = UDim2.fromOffset(260, 64),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	hpText = UI.Label({
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(150, 40),
		Text = "❤ 100",
		Font = UI.Fonts.Number,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 36,
		Outline = 3,
		Parent = hp,
	})
	local back = frame({
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.fromOffset(240, 14),
		BackgroundColor3 = Color3.fromRGB(30, 30, 40),
		BackgroundTransparency = 0.25,
		Parent = hp,
	})
	UI.Create("UICorner", { CornerRadius = UDim.new(0, 7), Parent = back })
	UI.Create("UIStroke", { Thickness = 2, Color = BLACK, Parent = back })
	hpFill = frame({
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Green,
		Parent = back,
	})
	UI.Create("UICorner", { CornerRadius = UDim.new(0, 7), Parent = hpFill })
	hpPanel = hp

	-- Munition unten rechts
	local ammo = frame({
		Name = "Ammo",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -12),
		Size = UDim2.fromOffset(240, 90),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	ammoText = UI.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -78, 0, 0),
		Size = UDim2.fromOffset(150, 52),
		Text = "",
		Font = UI.Fonts.Number,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxText = 50,
		Outline = 3,
		Parent = ammo,
	})
	ammoMaxText = UI.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 18),
		Size = UDim2.fromOffset(76, 30),
		Text = "",
		Font = UI.Fonts.Number,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(220, 225, 235),
		MaxText = 26,
		Outline = 2,
		Parent = ammo,
	})
	local rBack = frame({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 56),
		Size = UDim2.fromOffset(200, 8),
		BackgroundColor3 = Color3.fromRGB(30, 30, 40),
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = ammo,
	})
	UI.Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = rBack })
	reloadFill = frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = YELLOW, Parent = rBack })
	UI.Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = reloadFill })
	reloadBack = rBack
	reloadHint = UI.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 64),
		Size = UDim2.fromOffset(240, 26),
		Text = "",
		TextColor3 = RED,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxText = 22,
		Outline = 2,
		Visible = false,
		Parent = ammo,
	})
	ammoPanel = ammo

	-- Slot-Leiste unten Mitte (auf Touch übernimmt TouchControls die Leiste zum Antippen)
	local slots = frame({
		Name = "Slots",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(4 * 92 + 3 * 8, 64),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i = 1, 4 do
		local cell = frame({
			Name = "Slot" .. i,
			Size = UDim2.fromOffset(92, 56),
			BackgroundColor3 = Color3.fromRGB(25, 28, 45),
			BackgroundTransparency = 0.35,
			LayoutOrder = i,
			Parent = slots,
		})
		UI.Create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = cell })
		local stroke: UIStroke = UI.Create("UIStroke", { Thickness = 2, Color = BLACK, Parent = cell })
		local scale: UIScale = UI.Create("UIScale", { Parent = cell })
		local key = UI.Label({
			Position = UDim2.fromOffset(6, 2),
			Size = UDim2.fromOffset(20, 18),
			Text = tostring(i),
			Font = UI.Fonts.Number,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(200, 205, 220),
			MaxText = 16,
			Outline = 1.5,
			Parent = cell,
		})
		local name = UI.Label({
			Position = UDim2.fromOffset(4, 18),
			Size = UDim2.new(1, -8, 0, 32),
			Text = "",
			MaxText = 22,
			Outline = 2,
			Parent = cell,
		})
		local charges = UI.Label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 2),
			Size = UDim2.fromOffset(40, 18),
			Text = "",
			Font = UI.Fonts.Number,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = YELLOW,
			MaxText = 16,
