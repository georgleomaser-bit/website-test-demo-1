      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Ballistics</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Flugbahnen (Shared/Ballistics)
--  Besitzer: WP3 (Kampf Server & Treffer-Mathematik). Vertrag: DESIGN.md C6.2, C11.
--  Reines Modul – Server-Projektile (ProjectileService) und Client-Visuals (CombatFX)
--  benutzen dieselbe Formel, damit die Kugel auf beiden Seiten gleich fliegt.
--  Schwerkraft g wirkt nach −Y (g = 0: gerader Flug, z. B. Raketen).
--
--  Öffentliche API:
--    Ballistics.Position(p0, v, g, t): Vector3                p0 + v·t + ½·(0, −g, 0)·t²
--    Ballistics.Step(p, v, g, dt): (Vector3, Vector3)          neue Position + neue Geschwindigkeit
--    Ballistics.Reflect(v, normal, restitution): Vector3
--        Abprall: Normal-Anteil umgedreht × restitution, Tangential-Anteil × Ballistics.TangentKeep.
--    Ballistics.TangentKeep = 0.8                              Reibung beim Abprall
-- =====================================================================

local Ballistics = {}

Ballistics.TangentKeep = 0.8

local function finiteOr(n: number, default: number): number
	if n ~= n or n == math.huge or n == -math.huge then
		return default
	end
	return n
end

function Ballistics.Position(p0: Vector3, v: Vector3, g: number, t: number): Vector3
	local time = math.max(0, finiteOr(t, 0))
	local grav = finiteOr(g, 0)
	return p0 + v * time + Vector3.new(0, -0.5 * grav * time * time, 0)
end

function Ballistics.Step(p: Vector3, v: Vector3, g: number, dt: number): (Vector3, Vector3)
	local step = math.max(0, finiteOr(dt, 0))
	local grav = finiteOr(g, 0)
	local newP = p + v * step + Vector3.new(0, -0.5 * grav * step * step, 0)
	local newV = v + Vector3.new(0, -grav * step, 0)
	return newP, newV
end

function Ballistics.Reflect(v: Vector3, normal: Vector3, restitution: number): Vector3
	local m = normal.Magnitude
	if m ~= m or m < 1e-6 then
		return v * math.clamp(finiteOr(restitution, 0), 0, 1)
	end
	local n = normal / m
	local e = math.clamp(finiteOr(restitution, 0), 0, 1)
	local vn = n * v:Dot(n)
	local vt = v - vn
	return vt * Ballistics.TangentKeep - vn * e
end

return Ballistics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – ZENTRALE EINSTELLUNGEN (Shared/Config)
--  Besitzer: WP1 (Core & Plattform). Vertrag: DESIGN.md C15 + C6.1.
--  Hier stellst du (fast) alles ein, ohne anderen Code anzufassen.
--  Zahlen sind Startwerte aus DESIGN.md und 1:1 änderbar.
--  ACHTUNG: Config wird an alle Clients repliziert -> KEINE Geheimnisse hier!
--
--  Kindmodule (werden automatisch geladen, jedes Paket pflegt sein eigenes):
--    Weapons (WP3), Combat (WP3), Maps (WP2), Modes (WP5), Bots (WP6), Security (WP7),
--    Progression (WP8), Season (WP8), Cosmetics (WP9), Shop (WP9), Client (WP10)
--    -> erreichbar als Config.Weapons, Config.Modes, … Jedes darf Validate(Config): { string } haben.
--
--  Öffentliche Helfer:
--    Config.Weapon(key): WeaponDef?          Basiswerte + Live-Balance-Overrides
--    Config.WeaponById(id): WeaponDef?
--    Config.ApplyBalance(data)               { Version, Weapons = {[key] = {[field] = value}}, Disabled = {[key] = true} }
--    Config.CurrentBalance()                 Kopie der gerade aktiven Overrides { Version, Weapons, Disabled }
--    Config.Validate(): { string }           sammelt Child.Validate(Config) aller Kindmodule + eigene Prüfungen
-- =====================================================================

local RunService = game:GetService("RunService")

local Shared = script.Parent
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))

local Config = {}

Config.GameName = "CLUTCH CLASH"
Config.Version = "1.0.0"

-- ---------------------------------------------------------------------
-- 1) ADMINS – NUR DU: Wem das Spiel gehört (dein Account, mit dem du es
--    veröffentlichst), ist Admin. Du musst hier nichts eintragen!
--    Admin kann man NICHT kaufen – der Server prüft es bei jeder Aktion.
--    Im Studio-Test bist du Admin (Player1 = -1), Player2 (-2) bewusst NICHT.
-- ---------------------------------------------------------------------
Config.Admin = {
	OwnerIsAdmin = true,
	StudioIsAdmin = true,
	StudioAllPlayersAdmin = false, -- false lassen, sonst ist der "Abgelehnt"-Weg nicht testbar
}

-- ---------------------------------------------------------------------
-- 2) TECHNIK (nur ändern, wenn du weißt was du tust)
--    DataStoreName ändern = alle Spielstände sind weg!
-- ---------------------------------------------------------------------
Config.Tech = {
	DataStoreName = "CC_Player_v1",
	DataVersion = 1,
	MessagingTopic = "CC_Global",
	AutoSaveSeconds = 90, -- Auto-Save aller Spielstände
	AutoSaveStagger = 0.5, -- Abstand zwischen zwei Spielern beim Auto-Save
	LoadAttempts = 6,
	SaveAttempts = 4,
	LockStaleSeconds = 1800, -- Session-Lock älter als 30 Min gilt als verwaist
	BindToCloseSeconds = 25, -- Roblox gibt beim Herunterfahren max. 30 s
	ReceiptKeep = 60, -- so viele Kauf-Belege bleiben im Spielstand
	StateFlush = 0.2, -- State an den Client höchstens alle 0.2 s (≤ 5 Pakete/s)
	FullStateEvery = 20, -- voller State als Sicherheitsnetz
	LiveStore = "CC_Live_v1",
	StatsStore = "CC_Stats_v1",
	ModStore = "CC_Mod_v1",
	Shards = 8,
	BoardPrefix = "CC_LB_",
	BoardWriteSeconds = 300,
	BalancePollSeconds = 120,
	StatsFlushSeconds = 600,
	PingAttrEvery = 2, -- Attribut "PingMs" am Player alle 2 s
}

-- ---------------------------------------------------------------------
-- 3) STUDIO – Testen ohne Speichern, schnelle Bots, Selbsttest
-- ---------------------------------------------------------------------
Config.Studio = {
	NoSave = true, -- im Studio nie speichern (Toast "Studio: Fortschritt wird nicht gespeichert")
	BotFillSeconds = 2, -- Pads füllen im Studio schon nach 2 s mit Bots
	SelfTest = true, -- "[SelfTest] n/n PASS" im Output beim Start
}

-- ---------------------------------------------------------------------
-- 4) DEBUG – auch im Admin-Panel (Tab Debug) umschaltbar
-- ---------------------------------------------------------------------
Config.Debug = {
	LogRejects = false, -- abgelehnte Schüsse mit Grund an den Schützen melden
	ShowHitboxes = false,
	BotPaths = false,
	ForceRestricted = false, -- so tun, als wären bezahlte Zufallsitems verboten (Policy-Test)
}

-- ---------------------------------------------------------------------
-- 5) SERVER – Arenen, Bots, Grenzen
-- ---------------------------------------------------------------------
Config.Server = {
	MaxPlayers = 18,
	ArenaSlots = 8,
	SlotSpacing = 4000,
	SlotRowZ = 4000,
	VaultDepth = 250,
	IdleMapSeconds = 180,
	KeepWarmMaps = 3,
	CleanupEvery = 30,
	MaxBots = 12,
	MaxBotsPerMatch = 7,
	MaxProjectilesPerArena = 40,
	MaxProjectilesTotal = 160,
	CrownAudienceRadius = 150,
}

-- ---------------------------------------------------------------------
-- 6) SPIELER – Leben, Bewegung (B12/B13)
-- ---------------------------------------------------------------------
Config.Player = {
	MaxHp = 100,
	Walk = 16,
	Sprint = 22,
	JumpHeight = 7.2,
	AirJumpHeight = 6,
	SprintToFire = 0.12,
	Slide = {
		MinSpeed = 18,
		Start = 32,
		End = 14,
		Time = 0.75,
		Cooldown = 1.0,
		JumpKeep = 0.9,
		JumpCap = 30,
		CamDrop = 1.6,
		FovKick = 6,
		SpreadAdd = 1,
	},
	SpawnShield = 1.5,
	Regen = { Delay = 5, Rate = 12 },
	KillY = -40,
	LobbyZoomMax = 14,
}

-- ---------------------------------------------------------------------
-- 7) FARBEN (A4) – Teamfarben farbenblind-tauglich
-- ---------------------------------------------------------------------
Config.Colors = {
	TeamA = Color3.fromRGB(255, 140, 40), -- BLAZE
	TeamB = Color3.fromRGB(60, 170, 255), -- FROST
	Enemy = {
		Red = Color3.fromRGB(255, 59, 59),
		Magenta = Color3.fromRGB(255, 59, 216),
		Yellow = Color3.fromRGB(255, 212, 59),
		White = Color3.fromRGB(255, 255, 255),
	},
	Rarity = {
		Common = Color3.fromRGB(170, 170, 170),
		Rare = Color3.fromRGB(60, 140, 255),
		Epic = Color3.fromRGB(170, 90, 255),
		Legendary = Color3.fromRGB(255, 200, 40),
		Mythic = Color3.fromRGB(255, 60, 170),
	},
	Palette = {
		Cream = Color3.fromRGB(244, 235, 221),
		Mint = Color3.fromRGB(154, 209, 212),
		Pink = Color3.fromRGB(247, 183, 200),
		Lilac = Color3.fromRGB(185, 167, 242),
		Sand = Color3.fromRGB(242, 213, 154),
		Charcoal = Color3.fromRGB(43, 43, 51),
		Navy = Color3.fromRGB(28, 32, 64),
		White = Color3.fromRGB(235, 238, 245),
		Tip = Color3.fromRGB(255, 120, 0), -- orange Spitze jedes Blasters
	},
}

-- =====================================================================
-- 8) KINDMODULE – dynamisch geladen (fehlt eins, gibt es eine leere Tabelle
--    und Config.Validate() meldet es; der Rest läuft weiter)
-- =====================================================================
local CHILDREN = {
	"Weapons",
	"Combat",
	"Maps",
	"Modes",
	"Bots",
	"Security",
	"Progression",
	"Season",
	"Cosmetics",
	"Shop",
	"Client",
}

-- Client: erst warten, bis die erste Replikation fertig ist (sonst fehlen Kindmodule evtl. noch)
if RunService:IsClient() and not RunService:IsServer() and not game:IsLoaded() then
	game.Loaded:Wait()
end

local children: { [string]: { [string]: any } } = {}
local loadErrors: { [string]: string } = {}

local function loadChild(name: string): { [string]: any }
	local module = script:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		loadErrors[name] = "Modul fehlt"
		children[name] = {}
		return children[name]
	end
	local ok, result = pcall(require, module)
	if not ok then
		loadErrors[name] = "Fehler beim Laden: " .. tostring(result)
		warn("[Config] Config." .. name .. " konnte nicht geladen werden: " .. tostring(result))
		result = {}
	elseif type(result) ~= "table" then
		loadErrors[name] = "gibt keine Tabelle zurück"
		warn("[Config] Config." .. name .. " gibt keine Tabelle zurück")
		result = {}
	end
	children[name] = result
	return result
end

Config.Weapons = loadChild("Weapons")
Config.Combat = loadChild("Combat")
Config.Maps = loadChild("Maps")
Config.Modes = loadChild("Modes")
Config.Bots = loadChild("Bots")
Config.Security = loadChild("Security")
Config.Progression = loadChild("Progression")
Config.Season = loadChild("Season")
Config.Cosmetics = loadChild("Cosmetics")
Config.Shop = loadChild("Shop")
Config.Client = loadChild("Client")

-- =====================================================================
-- 9) WAFFEN-NACHSCHLAGEN + LIVE-BALANCE
--    Basis = Config.Weapons.List. Overrides nur für Felder aus
--    Config.Weapons.BalanceFields (geklemmt), Disabled -> Enabled = false.
-- =====================================================================
type WeaponDef = Types.WeaponDef
type BalanceData = { Version: number, Weapons: { [string]: { [string]: number } }, Disabled: { [string]: boolean } }

local INTEGER_FIELDS = { Mag = true } -- ganze Zahlen (Magazin)

local baseByKey: { [string]: WeaponDef } = {}
local baseById: { [number]: WeaponDef } = {}
local effectiveByKey: { [string]: WeaponDef } = {}
local effectiveById: { [number]: WeaponDef } = {}
local weaponIssues: { string } = {}
local balance: BalanceData = { Version = 0, Weapons = {}, Disabled = {} }

local function balanceFields(): { [string]: { number } }
	local fields = Config.Weapons.BalanceFields
	return if type(fields) == "table" then fields else {}
end

-- Gültige Grenzen {min, max} eines Balance-Felds (oder nil)
local function boundsOf(field: string): (number?, number?)
	local bounds = balanceFields()[field]
	if type(bounds) ~= "table" then
		return nil, nil
	end
	local lo, hi = bounds[1], bounds[2]
	if not (Util.IsFinite(lo) and Util.IsFinite(hi)) or lo > hi then
		return nil, nil
	end
	return lo, hi
end

-- Ein Override auf eine Kopie der Waffe schreiben ("Projectile.SplashMax" = verschachteltes Feld)
local function applyField(def: { [string]: any }, path: string, value: number): boolean
	local lo, hi = boundsOf(path)
	if lo == nil or hi == nil or not Util.IsFinite(value) then
		return false
	end
	local v = math.clamp(value, lo, hi)
	local parent: { [string]: any } = def
	local leaf = path
	local dot = string.find(path, ".", 1, true)
	if dot then
		local head = string.sub(path, 1, dot - 1)
		leaf = string.sub(path, dot + 1)
		local nested = def[head]
		if type(nested) ~= "table" then
			return false -- z. B. Projectile-Feld bei einer Hitscan-Waffe
		end
		parent = nested
	end
	if type(parent[leaf]) ~= "number" then
		return false -- nur vorhandene Zahlenfelder überschreiben
	end
	if INTEGER_FIELDS[leaf] then
		v = math.clamp(math.floor(v + 0.5), math.ceil(lo), math.floor(hi))
	end
	parent[leaf] = v
	return true
end

local function rebuildEffective()
	table.clear(effectiveByKey)
	table.clear(effectiveById)
	for key, base in pairs(baseByKey) do
		local def: any = Util.DeepCopy(base)
		local overrides = balance.Weapons[key]
		if overrides then
			for field, value in pairs(overrides) do
				applyField(def, field, value)
			end
		end
		if balance.Disabled[key] then
			def.Enabled = false
		end
		effectiveByKey[key] = def
		effectiveById[def.Id] = def
	end
end

local function buildWeaponLookups()
	local list = Config.Weapons.List
	if list == nil then
		return
	end
	if type(list) ~= "table" then
		table.insert(weaponIssues, "Config.Weapons.List: Tabelle erwartet")
		return
	end
	for index, def in ipairs(list) do
		if type(def) ~= "table" or type(def.Key) ~= "string" or not Util.IsFinite(def.Id) then
			table.insert(weaponIssues, ("Config.Weapons.List[%d]: Key (string) und Id (Zahl) erwartet"):format(index))
		else
			assert(baseByKey[def.Key] == nil, "[Config] Doppelter Waffen-Key: " .. def.Key)
			assert(baseById[def.Id] == nil, "[Config] Doppelte Waffen-Id: " .. tostring(def.Id))
			baseByKey[def.Key] = def
			baseById[def.Id] = def
		end
	end
	rebuildEffective()
end

buildWeaponLookups()

-- Waffe mit Live-Balance (gecachte Tabelle – NICHT verändern!)
function Config.Weapon(key: string): Types.WeaponDef?
	if type(key) ~= "string" then
		return nil
	end
	return effectiveByKey[key]
end

function Config.WeaponById(id: number): Types.WeaponDef?
	if type(id) ~= "number" then
		return nil
	end
	return effectiveById[id]
end

-- Live-Balance übernehmen (BalanceService auf dem Server, LiveBalance-StringValue auf dem Client).
-- Unbekannte Waffen/Felder und kaputte Zahlen werden still ignoriert, Werte geklemmt.
function Config.ApplyBalance(data: {
	Version: number,
	Weapons: { [string]: { [string]: any } },
	Disabled: { [string]: boolean },
})
	if type(data) ~= "table" then
		warn("[Config] ApplyBalance: Tabelle erwartet")
		return
	end
	local raw: any = data
	local clean: BalanceData = {
		Version = if Util.IsFinite(raw.Version) then raw.Version else 0,
		Weapons = {},
		Disabled = {},
	}
	if type(raw.Weapons) == "table" then
		for key, fields in pairs(raw.Weapons) do
			if type(key) == "string" and baseByKey[key] and type(fields) == "table" then
				local entry: { [string]: number } = {}
				local count = 0
				for field, value in pairs(fields) do
					if type(field) == "string" and boundsOf(field) ~= nil and Util.IsFinite(value) then
						entry[field] = value
						count += 1
					end
				end
				if count > 0 then
					clean.Weapons[key] = entry
				end
			end
		end
	end
	if type(raw.Disabled) == "table" then
		for key, flag in pairs(raw.Disabled) do
			if type(key) == "string" and baseByKey[key] and flag == true then
				clean.Disabled[key] = true
			end
		end
	end
	balance = clean
	rebuildEffective()
end

-- Kopie der aktiven Overrides (für Admin-Panel/Anzeige)
function Config.CurrentBalance(): {
	Version: number,
	Weapons: { [string]: { [string]: number } },
	Disabled: { [string]: boolean },
}
	return Util.DeepCopy(balance)
end

-- =====================================================================
-- 10) PRÜFEN – SelfTest und Boot-warn nutzen das (leere Liste = alles ok)
-- =====================================================================
local function checkNumber(errors: { string }, path: string, value: any, min: number?, integer: boolean?)
	if not Util.IsFinite(value) then
		table.insert(errors, path .. ": Zahl erwartet")
	elseif min ~= nil and value < min then
		table.insert(errors, ("%s: mindestens %s erwartet"):format(path, tostring(min)))
	elseif integer and value % 1 ~= 0 then
		table.insert(errors, path .. ": ganze Zahl erwartet")
	end
end

local function checkColors(errors: { string }, path: string, t: any)
	if type(t) ~= "table" then
		table.insert(errors, path .. ": Tabelle erwartet")
		return
	end
	for key, value in pairs(t) do
		if type(value) == "table" then
			checkColors(errors, path .. "." .. tostring(key), value)
		elseif typeof(value) ~= "Color3" then
			table.insert(errors, path .. "." .. tostring(key) .. ": Color3 erwartet")
		end
	end
end

local function validateCore(): { string }
	local errors: { string } = {}
	if type(Config.GameName) ~= "string" or Config.GameName == "" then
		table.insert(errors, "Config.GameName: Text erwartet")
	end
	if type(Config.Version) ~= "string" then
		table.insert(errors, "Config.Version: Text erwartet")
	end
	for key, value in pairs(Config.Admin) do
		if type(value) ~= "boolean" then
			table.insert(errors, "Config.Admin." .. key .. ": true/false erwartet")
		end
	end
	for _, name in ipairs({ "DataStoreName", "MessagingTopic", "LiveStore", "StatsStore", "ModStore", "BoardPrefix" }) do
		local value = (Config.Tech :: any)[name]
		if type(value) ~= "string" or value == "" or #value > 50 then
			table.insert(errors, "Config.Tech." .. name .. ": Text (1–50 Zeichen) erwartet")
		end
	end
	local tech = Config.Tech
	checkNumber(errors, "Config.Tech.DataVersion", tech.DataVersion, 1, true)
	checkNumber(errors, "Config.Tech.AutoSaveSeconds", tech.AutoSaveSeconds, 10)
	checkNumber(errors, "Config.Tech.AutoSaveStagger", tech.AutoSaveStagger, 0)
	checkNumber(errors, "Config.Tech.LoadAttempts", tech.LoadAttempts, 1, true)
	checkNumber(errors, "Config.Tech.SaveAttempts", tech.SaveAttempts, 1, true)
	checkNumber(errors, "Config.Tech.LockStaleSeconds", tech.LockStaleSeconds, 60)
	checkNumber(errors, "Config.Tech.BindToCloseSeconds", tech.BindToCloseSeconds, 1)
	checkNumber(errors, "Config.Tech.ReceiptKeep", tech.ReceiptKeep, 1, true)
	checkNumber(errors, "Config.Tech.StateFlush", tech.StateFlush, 0.05)
	checkNumber(errors, "Config.Tech.FullStateEvery", tech.FullStateEvery, 1)
	checkNumber(errors, "Config.Tech.Shards", tech.Shards, 1, true)
	checkNumber(errors, "Config.Tech.BoardWriteSeconds", tech.BoardWriteSeconds, 1)
	checkNumber(errors, "Config.Tech.BalancePollSeconds", tech.BalancePollSeconds, 1)
	checkNumber(errors, "Config.Tech.StatsFlushSeconds", tech.StatsFlushSeconds, 1)
	checkNumber(errors, "Config.Tech.PingAttrEvery", tech.PingAttrEvery, 0.1)
	if tech.BindToCloseSeconds > 29 then
		table.insert(errors, "Config.Tech.BindToCloseSeconds: höchstens 29 (Roblox gibt 30 s)")
	end
	for key, value in pairs(Config.Studio) do
		if type(value) ~= "boolean" and not Util.IsFinite(value) then
			table.insert(errors, "Config.Studio." .. key .. ": Zahl oder true/false erwartet")
		end
	end
	for key, value in pairs(Config.Debug) do
		if type(value) ~= "boolean" then
			table.insert(errors, "Config.Debug." .. key .. ": true/false erwartet")
		end
	end
	for key, value in pairs(Config.Server) do
		checkNumber(errors, "Config.Server." .. key, value, 0)
	end
	local slots = Config.Server.ArenaSlots
	if not Util.IsFinite(slots) or slots % 1 ~= 0 or slots < 1 or slots > 8 then
		table.insert(errors, "Config.Server.ArenaSlots: ganze Zahl 1–8 erwartet (Slot-Koordinaten B9.1)")
	end
	if Config.Server.MaxBotsPerMatch > Config.Server.MaxBots then
		table.insert(errors, "Config.Server.MaxBotsPerMatch: darf nicht größer als MaxBots sein")
	end
	if Config.Server.MaxProjectilesPerArena > Config.Server.MaxProjectilesTotal then
		table.insert(errors, "Config.Server.MaxProjectilesPerArena: darf nicht größer als MaxProjectilesTotal sein")
	end
	local player = Config.Player
	checkNumber(errors, "Config.Player.MaxHp", player.MaxHp, 1)
	checkNumber(errors, "Config.Player.Walk", player.Walk, 1)
	checkNumber(errors, "Config.Player.Sprint", player.Sprint, player.Walk)
	checkNumber(errors, "Config.Player.JumpHeight", player.JumpHeight, 0)
	checkNumber(errors, "Config.Player.SpawnShield", player.SpawnShield, 0)
	checkNumber(errors, "Config.Player.KillY", player.KillY, -490) -- über FallenPartsDestroyHeight (−500)
	for key, value in pairs(player.Slide) do
		checkNumber(errors, "Config.Player.Slide." .. key, value, 0)
	end
	checkNumber(errors, "Config.Player.Regen.Delay", player.Regen.Delay, 0)
	checkNumber(errors, "Config.Player.Regen.Rate", player.Regen.Rate, 0)
	checkColors(errors, "Config.Colors", Config.Colors)
	-- Balance-Grenzen (von ApplyBalance benutzt)
	local fields = Config.Weapons.BalanceFields
	if fields ~= nil then
		if type(fields) ~= "table" then
			table.insert(errors, "Config.Weapons.BalanceFields: Tabelle erwartet")
		else
			for field in pairs(fields) do
				if type(field) ~= "string" or boundsOf(field) == nil then
					table.insert(errors, "Config.Weapons.BalanceFields." .. tostring(field) .. ": {min, max} erwartet")
				end
			end
		end
	end
	return errors
end

function Config.Validate(): { string }
	local errors: { string } = {}
	for _, name in ipairs(CHILDREN) do
		local loadError = loadErrors[name]
		if loadError then
			table.insert(errors, "Config." .. name .. ": " .. loadError)
		else
			local validate = children[name].Validate
			if type(validate) == "function" then
				local ok, result = pcall(validate, Config)
				if not ok then
					table.insert(errors, "Config." .. name .. ".Validate: Fehler " .. tostring(result))
				elseif type(result) == "table" then
					for _, message in ipairs(result) do
						table.insert(errors, tostring(message))
					end
				elseif result ~= nil then
					table.insert(errors, "Config." .. name .. ".Validate: Liste von Texten erwartet")
				end
			end
		end
	end
	for _, message in ipairs(weaponIssues) do
		table.insert(errors, message)
	end
	for _, message in ipairs(validateCore()) do
		table.insert(errors, message)
	end
	return errors
end

return Config
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Bots</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – BOTS & TRAINING (Shared/Config/Bots)
--  Besitzer: WP6 (Bots & Training-Range). Vertrag: DESIGN.md C15 + B10 + B2 (Range).
--  Erreichbar als Config.Bots. Zahlen = Startwerte aus DESIGN.md, 1:1 änderbar.
--  ACHTUNG: wird an alle Clients repliziert -> keine Geheimnisse!
--
--  Inhalt:
--    1) Difficulties   – die 5 Stufen (Tabelle B10.3) + Feinwerte fürs Spielgefühl
--    2) Names          – 30 Bot-Namen (B10.2)
--    3) Loadouts       – Gewichte ab Normal, Gratis-Set für Rookie/Easy
--    4) Gehirn         – Takt, Raycast-Budget, Navigation, Handicap, Adaptiv
--    5) Crown          – Bot-Herausforderer je Serie
--    6) Range          – Übungspuppen, Schiene, Zone, Flick-Test
--    7) Aussehen       – Gesicht, Namensschild, Standard-Animationen (Muss-Regel 2)
--  Validate(Config): { string } prüft alles (leere Liste = ok).
-- =====================================================================

export type Difficulty = {
	-- Pflichtspalten aus B10.3 (Prozentwerte wie in der Tabelle: 3 = 3 %)
	Reaction: number, -- Sekunden bis zum ersten Schuss, nachdem das Ziel sichtbar wurde
	AimErr: number, -- Grad Zielfehler direkt nach dem Erfassen
	Tau: number, -- Sekunden: Zielfehler fällt exponentiell mit dieser Zeitkonstante
	MinErr: number, -- Grad: kleinster Zielfehler
	HeadChance: number, -- % der Feuerstöße, die auf den Kopf zielen
	StrafeMin: number, -- Sekunden zwischen zwei Seitwärts-Wechseln (min)
	StrafeMax: number, -- … (max)
	MoveTech: number, -- % Chance pro Seitwärts-Wechsel zu springen/rutschen (0 = nie)
	UtilityChance: number, -- % Chance, eine Gelegenheit für Granate/Rauch/Heilung zu nutzen
	RetreatHp: number, -- unter so vielen HP zieht sich der Bot zurück (0 = nie)
	SpeedMult: number, -- Tempo-Faktor (Gehen/Sprinten)
	-- Feinwerte (machen die Stufen fühlbar verschieden; nicht in der Spec-Tabelle)
	Fov: number, -- Sichtkegel in Grad (ganzer Winkel); näher als 14 Studs sieht er immer
	Burst: { number }, -- Schüsse pro Feuerstoß {min, max} (Automatik-Waffen)
	BurstPause: { number }, -- Pause zwischen Feuerstößen in s {min, max}
	ClickDelay: { number }, -- Zusatz-Verzögerung bei Halbautomatik/Einzelschuss in s {min, max}
	Lead: number, -- 0..1 Vorhalt bei Projektilwaffen (Rakete)
	Push: boolean, -- drängt nach PushDelay, wenn der Gegner nachlädt (B10.3: Hard/Insane)
	QuickSwap: boolean, -- wechselt beim Nachladen auf die Sekundärwaffe
	PreAim: boolean, -- zielt nach Sichtverlust auf die letzte bekannte Stelle
	Reposition: number, -- 0..1 Chance pro Entscheidungsfenster, eine Deckung zu wechseln
	Wander: number, -- 0..1 Anteil zufälliger Umwege beim Patrouillieren
	UseAds: boolean, -- zielt mit Visier (ADS) auf Distanz
	MeleeChance: number, -- 0..1 Chance, im Nahbereich (≤ MeleeRange) zur Nahkampfwaffe zu greifen
	Level: { number }, -- angezeigtes Level im Namensschild {min, max} (nur Optik)
	PracticeOnly: boolean?, -- nur Practice/Crown (Insane)
}

local Bots = {}

-- ---------------------------------------------------------------------
-- 1) SCHWIERIGKEITSSTUFEN (B10.3) – Reihenfolge = leicht -> schwer
-- ---------------------------------------------------------------------
Bots.Order = { "Rookie", "Easy", "Normal", "Hard", "Insane" }

Bots.Difficulties = {
	Rookie = {
		Reaction = 0.75,
		AimErr = 9,
		Tau = 0.9,
		MinErr = 3.5,
		HeadChance = 3,
		StrafeMin = 1.5,
		StrafeMax = 2.5,
		MoveTech = 0, -- springt/rutscht nie
		UtilityChance = 0,
		RetreatHp = 0, -- zieht sich nie zurück ("–" in der Tabelle)
		SpeedMult = 0.85,
		Fov = 100,
		Burst = { 2, 4 },
		BurstPause = { 0.45, 0.8 },
		ClickDelay = { 0.18, 0.35 },
		Lead = 0,
		Push = false,
		QuickSwap = false,
		PreAim = false,
		Reposition = 0,
		Wander = 0.5,
		UseAds = false,
		MeleeChance = 0.2,
		Level = { 1, 4 },
	},
	Easy = {
		Reaction = 0.55,
		AimErr = 7,
		Tau = 0.7,
		MinErr = 2.5,
		HeadChance = 6,
		StrafeMin = 1.0,
		StrafeMax = 1.8,
		MoveTech = 5,
		UtilityChance = 10,
		RetreatHp = 25,
		SpeedMult = 0.92,
		Fov = 110,
		Burst = { 3, 5 },
		BurstPause = { 0.35, 0.6 },
		ClickDelay = { 0.12, 0.25 },
		Lead = 0.3,
		Push = false,
		QuickSwap = false,
		PreAim = false,
		Reposition = 0.15,
		Wander = 0.35,
		UseAds = true,
		MeleeChance = 0.25,
		Level = { 3, 12 },
	},
	Normal = {
		Reaction = 0.40,
		AimErr = 5,
		Tau = 0.6,
		MinErr = 1.5,
		HeadChance = 12,
		StrafeMin = 0.8,
		StrafeMax = 1.5,
		MoveTech = 10,
		UtilityChance = 25,
		RetreatHp = 35,
		SpeedMult = 1.0,
		Fov = 120,
		Burst = { 4, 7 },
		BurstPause = { 0.25, 0.45 },
		ClickDelay = { 0.06, 0.15 },
		Lead = 0.6,
		Push = false,
		QuickSwap = true,
		PreAim = true,
		Reposition = 0.3,
		Wander = 0.2,
		UseAds = true,
		MeleeChance = 0.3,
		Level = { 8, 25 },
	},
	Hard = {
		Reaction = 0.28,
		AimErr = 3,
		Tau = 0.5,
		MinErr = 0.9,
		HeadChance = 22,
		StrafeMin = 0.6,
		StrafeMax = 1.2,
		MoveTech = 25,
		UtilityChance = 40,
		RetreatHp = 40,
		SpeedMult = 1.0,
		Fov = 140,
		Burst = { 5, 9 },
		BurstPause = { 0.15, 0.3 },
		ClickDelay = { 0.03, 0.09 },
		Lead = 0.85,
		Push = true,
		QuickSwap = true,
		PreAim = true,
		Reposition = 0.5,
		Wander = 0.1,
		UseAds = true,
		MeleeChance = 0.35,
		Level = { 18, 45 },
	},
	Insane = {
		Reaction = 0.19,
		AimErr = 1.8,
		Tau = 0.4,
		MinErr = 0.5,
		HeadChance = 32,
		StrafeMin = 0.5,
		StrafeMax = 1.0,
		MoveTech = 35,
		UtilityChance = 60,
		RetreatHp = 45,
		SpeedMult = 1.0,
		Fov = 160,
		Burst = { 7, 12 },
		BurstPause = { 0.08, 0.2 },
		ClickDelay = { 0.01, 0.05 },
		Lead = 1.0,
		Push = true,
		QuickSwap = true,
		PreAim = true,
		Reposition = 0.6,
		Wander = 0.05,
		UseAds = true,
		MeleeChance = 0.4,
		Level = { 40, 80 },
		PracticeOnly = true, -- nur Practice/Crown
	},
} :: { [string]: Difficulty }

-- ---------------------------------------------------------------------
-- 2) NAMEN (B10.2) – Namensschild "[BOT] Waffel" (grau)
-- ---------------------------------------------------------------------
Bots.Names = {
	"Waffel",
	"Blinky",
	"Pixel",
	"Nudel",
	"Turbo",
	"Gizmo",
	"Sprocket",
	"Murmel",
	"Keks",
	"Bonbon",
	"Kiwi",
	"Fizz",
	"Mochi",
	"Nugget",
	"Zappy",
	"Biscuit",
	"Mango",
	"Pudding",
	"Rakete",
	"Socke",
	"Toffee",
	"Bolzen",
	"Flummi",
	"Knopf",
	"Wolke",
	"Brezel",
	"Zimt",
	"Quark",
	"Kobold",
	"Funke",
}

-- ---------------------------------------------------------------------
-- 3) LOADOUTS (B10.3) – Rookie/Easy nur Gratis-Set (Config.Weapons.DefaultLoadout),
--    ab Normal gewichtet zufällig aus allen 15 (pro Platz nur Waffen dieses Platzes).
--    Gewicht 0 = Bots nehmen die Waffe nie.
-- ---------------------------------------------------------------------
Bots.LoadoutWeights = {
	-- Primär
	PopRifle = 10,
	BuzzSMG = 8,
	BurstBlaster = 7,
	Scatter = 6,
	Longshot = 4,
	PopRocket = 3,
	-- Sekundär
	PipPistol = 10,
	HandCannon = 6,
	MiniScatter = 5,
	-- Nahkampf
	BoxingGloves = 10,
	BonkHammer = 5,
	LaserSword = 5,
	-- Utility
	PopGrenade = 10,
	SmokeBomb = 4,
	MedFizz = 5,
} :: { [string]: number }

Bots.FreeOnly = { Rookie = true, Easy = true } :: { [string]: boolean }

-- ---------------------------------------------------------------------
-- 4) GEHIRN & NAVIGATION (B10.3)
-- ---------------------------------------------------------------------
Bots.TickHz = 10 -- jeder Bot 1× pro 100 ms (gestaffelt über die Frames)
Bots.MaxRaycastsPerTick = 3 -- Sichtlinien-Strahlen pro Bot-Tick
Bots.LateralErrPerStud = 0.15 -- +0.15° Zielfehler pro Stud/s Querbewegung des Ziels
Bots.RepathSeconds = 2 -- Pfad neu planen alle 2 s (oder bei Zielwechsel)
Bots.StuckSeconds = 1.5 -- < 1 Stud in 1.5 s = hängt fest -> springen + neu planen
Bots.StuckMinMove = 1 -- Studs
Bots.UnstickAfter = 2 -- so viele Hänger in Folge -> auf den nächsten Nav-Knoten setzen (≤ 3 s)
Bots.PushDelay = 0.4 -- Hard/Insane drängen, wenn der Gegner so lange nachlädt
Bots.MeleeRange = 12 -- Studs: Nahkampf-Zustand nur bei Ziel ≤ 12 Studs
Bots.Memory = 4 -- Sekunden: letzte bekannte Position eines Gegners bleibt im Kopf
Bots.HearRange = 80 -- Studs: Schüsse in dieser Nähe verraten die Position
Bots.MaxSight = 400 -- Studs: weiter weg wird niemand wahrgenommen
Bots.RetreatMaxSeconds = 4 -- Rundenmodi: höchstens so lange verstecken, dann wieder kämpfen
Bots.UtilityRollSeconds = 3 -- Abstand zwischen zwei Utility-Würfen
Bots.SwitchCooldown = 0.8 -- s zwischen zwei Waffenwechseln
Bots.WaypointReach = 2.5 -- Studs: Wegpunkt erreicht
Bots.Slide = { Start = 32, End = 14, Time = 0.75 } -- Bot-"Rutschen" = kurzer Tempo-Schub (Hitbox gleich)
Bots.RookieMissShots = 2 -- erste 2 Schüsse jeder Runde gehen absichtlich daneben …
Bots.RookieMatches = 3 -- … in den ersten 3 Matches eines Menschen
Bots.Adaptive = { LossesDown = 2, WinsUp = 3, Range = 1 } -- Data.BotTier = Versatz −1..+1 (WP8 pflegt ihn)
Bots.MmrTiers = { Easy = 900, Hard = 1150 } -- < 900 Easy, 900–1150 Normal, > 1150 Hard

-- ---------------------------------------------------------------------
-- 5) CROWN – Bot-Herausforderer je Serie des Königs (B4)
-- ---------------------------------------------------------------------
Bots.CrownTiers = {
	{ MaxStreak = 2, Diff = "Normal" },
	{ MaxStreak = 5, Diff = "Hard" },
	{ MaxStreak = 1e9, Diff = "Insane" },
}

-- ---------------------------------------------------------------------
-- 6) RANGE (Schießstand B2) – 24 Puppen + 2 Schiene-Puppen, Waffen-Regal, Bot-Duell-Kabine
-- ---------------------------------------------------------------------
Bots.Range = {
	DummyHp = 150, -- Leben einer Puppe
	DummyRegenAfter = 3, -- s ohne Schaden -> wieder voll (gepoppte Puppen kommen nach 3 s zurück)
	RailSpeed = 8, -- Studs/s der Schiene-Puppen
	RailFlip = 2, -- spätestens alle 2 s Richtungswechsel …
	RailAmplitude = 5, -- … und immer an den Enden (pendeln Z ±5, B2)
	ScanHz = 4, -- Zone prüfen (betreten/verlassen)
	PlayerReviveDelay = 1.5, -- eigener Raketen-/Granaten-Pop in der Range -> so schnell zurück
	FlickTargets = 10, -- Flick-Test: so viele Ziele nacheinander
	FlickDistance = { 16, 34 }, -- Studs vor der Kamera
	FlickYaw = { 12, 42 }, -- Grad seitlich (zufällige Seite)
	FlickPitch = 12, -- Grad hoch/runter (max)
	FlickRadius = 1.1, -- Zielkugel-Radius
	FlickTimeout = 30, -- s, danach Abbruch
	DpsReset = 3, -- s ohne Treffer -> DPS-Anzeige beginnt neu
	-- Aim-Trainer (SKILL-WUENSCHE): Tracking = Fadenkreuz auf einer wandernden Kugel halten,
	-- Reaktion = schießen, sobald das Ziel erscheint. Bestwerte nur lokal (wie Flick, v1).
	TrackSeconds = 15, -- Dauer eines Tracking-Laufs
	TrackDistance = 24, -- Studs vor der Kamera
	TrackRadius = 1.3, -- Zielkugel-Radius
	TrackSpeed = { 0.6, 1.4 }, -- Winkelgeschwindigkeit der Bahn (rad/s), zufällig pro Lauf
	TrackYaw = 30, -- Grad seitlicher Ausschlag (max)
	TrackPitch = 10, -- Grad hoch/runter (max)
	ReactionRounds = 5, -- so viele Runden, Ergebnis = Durchschnitt
	ReactionDelay = { 1.2, 3.5 }, -- s Wartezeit bis das Ziel erscheint
	ReactionDistance = 20,
	ReactionRadius = 1.4,
	ReactionYaw = 14, -- Grad seitlicher Versatz (max)
	ReactionTimeout = 2.5, -- s ohne Treffer -> Runde zählt als Fehlversuch (= Timeout)
	-- Roster-Slots im Kontext "Range": Spieler/Bots 1..32, Puppen ab DummySlotBase + 1
	-- (Puppen schießen nie und tauchen daher nie als Quelle in FX/LookBatch auf; u8-tauglich)
	DummySlotBase = 200,
	-- Puppen-Farben je Entfernung (Optik)
	DummyDistances = { 15, 30, 60, 100 },
}

-- ---------------------------------------------------------------------
-- 7) AUSSEHEN & ANIMATION (Muss-Regel 2: nur Roblox-Standard-IDs)
-- ---------------------------------------------------------------------
Bots.PoolSize = 12 -- Klone in ServerStorage.BotPool (= MaxBots)
Bots.Face = "rbxasset://textures/face.png"
Bots.NameplateColor = Color3.fromRGB(190, 190, 200) -- grau = ehrlich als Bot markiert
Bots.Animations = {
	Idle = "rbxassetid://507766388",
	Walk = "rbxassetid://507777826",
	Run = "rbxassetid://507767714",
	Jump = "rbxassetid://507765000",
	Fall = "rbxassetid://507767968",
	ToolNone = "rbxassetid://507768375", -- Halte-Pose für die Waffe
}
Bots.AnimateDistance = 260 -- Client spielt Animationen nur bis zu dieser Entfernung

-- ---------------------------------------------------------------------
-- PRÜFEN (Config.Validate sammelt das) – Fehlertexte mit exaktem Pfad
-- ---------------------------------------------------------------------
local REQUIRED_NUMBERS = {
	"Reaction",
	"AimErr",
	"Tau",
	"MinErr",
	"HeadChance",
	"StrafeMin",
	"StrafeMax",
	"MoveTech",
	"UtilityChance",
	"RetreatHp",
	"SpeedMult",
	"Fov",
	"Lead",
	"Reposition",
	"Wander",
	"MeleeChance",
}
local PERCENT_FIELDS = { HeadChance = true, MoveTech = true, UtilityChance = true }
local RANGE_PAIRS = { "Burst", "BurstPause", "ClickDelay", "Level" }
local BOOL_FIELDS = { "Push", "QuickSwap", "PreAim", "UseAds" }

local function isNum(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

function Bots.Validate(config: any): { string }
	local errors: { string } = {}
	local function add(msg: string)
		table.insert(errors, msg)
	end

	-- Stufen
	local seen: { [string]: boolean } = {}
	for _, name in ipairs(Bots.Order) do
		seen[name] = true
		local d: any = Bots.Difficulties[name]
		local base = "Config.Bots.Difficulties." .. name
		if type(d) ~= "table" then
			add(base .. ": Tabelle fehlt")
			continue
		end
		for _, field in ipairs(REQUIRED_NUMBERS) do
			local v = d[field]
			if not isNum(v) or v < 0 then
				add(("%s.%s: Zahl ≥ 0 erwartet"):format(base, field))
			elseif PERCENT_FIELDS[field] and v > 100 then
				add(("%s.%s: Prozent 0–100 erwartet"):format(base, field))
			end
		end
		if isNum(d.StrafeMin) and isNum(d.StrafeMax) and d.StrafeMin > d.StrafeMax then
			add(base .. ".StrafeMin: darf nicht größer als StrafeMax sein")
		end
		if isNum(d.Tau) and d.Tau <= 0 then
			add(base .. ".Tau: muss größer als 0 sein")
		end
		if isNum(d.MinErr) and isNum(d.AimErr) and d.MinErr > d.AimErr then
			add(base .. ".MinErr: darf nicht größer als AimErr sein")
		end
		if isNum(d.SpeedMult) and (d.SpeedMult < 0.3 or d.SpeedMult > 2) then
			add(base .. ".SpeedMult: 0.3–2 erwartet")
		end
		for _, field in ipairs({ "Lead", "Reposition", "Wander", "MeleeChance" }) do
			if isNum(d[field]) and d[field] > 1 then
				add(("%s.%s: 0–1 erwartet"):format(base, field))
			end
		end
		for _, field in ipairs(RANGE_PAIRS) do
			local pair = d[field]
			if
				type(pair) ~= "table"
				or not isNum(pair[1])
				or not isNum(pair[2])
				or pair[1] < 0
				or pair[1] > pair[2]
			then
				add(("%s.%s: {min, max} mit 0 ≤ min ≤ max erwartet"):format(base, field))
			end
		end
		if type(d.Burst) == "table" and isNum(d.Burst[1]) and d.Burst[1] < 1 then
			add(base .. ".Burst: mindestens 1 Schuss pro Feuerstoß")
		end
		for _, field in ipairs(BOOL_FIELDS) do
			if type(d[field]) ~= "boolean" then
				add(("%s.%s: true/false erwartet"):format(base, field))
			end
		end
	end
	for name in pairs(Bots.Difficulties) do
		if not seen[name] then
			add("Config.Bots.Difficulties." .. tostring(name) .. ": fehlt in Config.Bots.Order")
		end
	end

	-- Namen
	if #Bots.Names < 12 then
		add("Config.Bots.Names: mindestens 12 Namen erwartet (MaxBots)")
	end
	local names: { [string]: boolean } = {}
	for i, n in ipairs(Bots.Names) do
		if type(n) ~= "string" or n == "" or #n > 20 then
			add(("Config.Bots.Names[%d]: Text (1–20 Zeichen) erwartet"):format(i))
		elseif names[n] then
			add(("Config.Bots.Names[%d]: doppelter Name %s"):format(i, n))
		else
			names[n] = true
		end
	end

	-- Loadout-Gewichte (nur prüfbar, wenn Config.Weapons geladen ist)
	local weaponFn = type(config) == "table" and config.Weapon or nil
	local slotsWithWeight: { [string]: boolean } = {}
	for key, weight in pairs(Bots.LoadoutWeights) do
		local path = "Config.Bots.LoadoutWeights." .. tostring(key)
		if not isNum(weight) or weight < 0 then
			add(path .. ": Gewicht ≥ 0 erwartet")
		end
		if type(weaponFn) == "function" then
			local ok, def = pcall(weaponFn, key)
			if ok and def == nil then
				add(path .. ": unbekannte Waffe")
			elseif ok and type(def) == "table" then
				if def.AdminOnly then
					add(path .. ": Admin-Waffen sind für Bots verboten")
				elseif isNum(weight) and weight > 0 and type(def.Slot) == "string" then
					slotsWithWeight[def.Slot] = true
				end
			end
		end
	end
	if type(weaponFn) == "function" then
		local list = config.Weapons and config.Weapons.List
		if type(list) == "table" and #list > 0 then
			for _, slot in ipairs({ "Primary", "Secondary", "Melee", "Utility" }) do
				if not slotsWithWeight[slot] then
					add("Config.Bots.LoadoutWeights: kein Gewicht > 0 für Platz " .. slot)
				end
			end
		end
	end
	for name, flag in pairs(Bots.FreeOnly) do
		if Bots.Difficulties[name] == nil or type(flag) ~= "boolean" then
			add("Config.Bots.FreeOnly." .. tostring(name) .. ": unbekannte Stufe oder kein true/false")
		end
	end

	-- Gehirn-Zahlen
	local numbers: { [string]: number } = {
		TickHz = 1,
		MaxRaycastsPerTick = 1,
		LateralErrPerStud = 0,
		RepathSeconds = 0.2,
		StuckSeconds = 0.3,
		StuckMinMove = 0,
		UnstickAfter = 1,
		PushDelay = 0,
		MeleeRange = 1,
		Memory = 0,
		HearRange = 0,
		MaxSight = 10,
		RetreatMaxSeconds = 0,
		UtilityRollSeconds = 0.2,
		SwitchCooldown = 0,
		WaypointReach = 0.5,
		RookieMissShots = 0,
		RookieMatches = 0,
		PoolSize = 1,
		AnimateDistance = 10,
	}
	local raw: any = Bots
	for key, min in pairs(numbers) do
		local v = raw[key]
		if not isNum(v) or v < min then
			add(("Config.Bots.%s: Zahl ≥ %s erwartet"):format(key, tostring(min)))
		end
	end
	if isNum(Bots.MaxRaycastsPerTick) and Bots.MaxRaycastsPerTick > 3 then
		add("Config.Bots.MaxRaycastsPerTick: höchstens 3 (Budget C17)")
	end
	for key, v in pairs(Bots.Slide) do
		if not isNum(v) or v <= 0 then
			add("Config.Bots.Slide." .. tostring(key) .. ": Zahl > 0 erwartet")
		end
	end
	for key, v in pairs(Bots.Adaptive) do
		if not isNum(v) or v < 0 then
			add("Config.Bots.Adaptive." .. tostring(key) .. ": Zahl ≥ 0 erwartet")
		end
	end
	if not (isNum(Bots.MmrTiers.Easy) and isNum(Bots.MmrTiers.Hard)) or Bots.MmrTiers.Easy > Bots.MmrTiers.Hard then
		add("Config.Bots.MmrTiers: Easy ≤ Hard erwartet")
	end

	-- Crown
	local last = -math.huge
	for i, tier in ipairs(Bots.CrownTiers) do
		local path = ("Config.Bots.CrownTiers[%d]"):format(i)
		if not isNum(tier.MaxStreak) or tier.MaxStreak < last then
			add(path .. ".MaxStreak: aufsteigende Zahl erwartet")
		else
			last = tier.MaxStreak
		end
		if Bots.Difficulties[tier.Diff] == nil then
			add(path .. ".Diff: unbekannte Stufe " .. tostring(tier.Diff))
		end
	end

	-- Range
	local range: any = Bots.Range
	for key, v in pairs(range) do
		local path = "Config.Bots.Range." .. key
		if type(v) == "table" then
			if not isNum(v[1]) or not isNum(v[2]) or v[1] > v[2] or v[1] < 0 then
				add(path .. ": {min, max} erwartet")
			end
		elseif not isNum(v) or v < 0 then
			add(path .. ": Zahl ≥ 0 erwartet")
		end
	end
	if isNum(range.DummyHp) and range.DummyHp < 1 then
		add("Config.Bots.Range.DummyHp: mindestens 1")
	end
	if isNum(range.FlickTargets) and (range.FlickTargets < 1 or range.FlickTargets > 50) then
		add("Config.Bots.Range.FlickTargets: 1–50 erwartet")
	end

	-- Aussehen
	if type(Bots.Face) ~= "string" or string.sub(Bots.Face, 1, 13) ~= "rbxasset://te" then
		add("Config.Bots.Face: rbxasset://textures/… erwartet (ASSETS.md)")
	end
	for key, id in pairs(Bots.Animations) do
		if type(id) ~= "string" or not string.match(id, "^rbxassetid://%d+$") then
			add("Config.Bots.Animations." .. tostring(key) .. ": rbxassetid://<Zahl> erwartet")
		end
	end
	if typeof(Bots.NameplateColor) ~= "Color3" then
		add("Config.Bots.NameplateColor: Color3 erwartet")
	end
	return errors
end

return Bots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Client</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – CLIENT-EINSTELLUNGEN (Shared/Config/Client)
--  Besitzer: WP10 (Client-Hülle). Vertrag: DESIGN.md C15 (Config.Client), B15.1, B15.3.
--  Erreichbar als Config.Client (wird von Config/init automatisch geladen).
--
--  Inhalt:
--    1) Keys / Gamepad          Tastenbelegung (B15.1) – Namen von Enum.KeyCode bzw. Enum.UserInputType
--    2) AimAssist               Zielhilfe (nur Touch & Gamepad, nie Maus – B15.2)
--    3) DefaultSettings         Standardwerte von Data.Settings (B15.3)
--    4) SettingsSchema          [Key] = { Type, Min?, Max?, Step?, Integer?, Options?, Fields? } für JEDEN Standardwert
--                               (Server klemmt SaveSettings damit, Client baut das Einstellungen-Fenster damit)
--    5) Sounds                  0 = eingebautes Rezept aus docs/ASSETS.md §2.2, sonst eigene Audio-ID
--    6) HUD / Touch / Effekte   Grenzen, Pools (Budgets C17), Farben
--  ACHTUNG: Config wird an alle Clients repliziert -> KEINE Geheimnisse hier!
-- =====================================================================

export type SchemaEntry = {
	Type: "number" | "boolean" | "enum" | "table",
	Min: number?,
	Max: number?,
	Step: number?, -- Schrittweite des Reglers im Einstellungen-Fenster
	Integer: boolean?, -- nur ganze Zahlen
	Options: { string }?, -- nur Type = "enum"
	Fields: { [string]: SchemaEntry }?, -- nur Type = "table" (z. B. Crosshair)
}

local Client = {}

-- ---------------------------------------------------------------------
-- 1) TASTEN (B15.1) – alles läuft über ContextActionService (Modul Controls)
--    Werte: Liste von Enum.KeyCode-Namen ("R", "LeftShift", "One" …) oder
--    Enum.UserInputType-Namen ("MouseButton1", "MouseButton2").
--    Mausrad = Waffe weiter/zurück (siehe WheelSwitch).
-- ---------------------------------------------------------------------
Client.Keys = {
	Fire = { "MouseButton1" },
	Ads = { "MouseButton2" },
	Reload = { "R" },
	Slot1 = { "One" },
	Slot2 = { "Two" },
	Slot3 = { "Three" },
	Slot4 = { "Four" },
	LastWeapon = { "Q" },
	Utility = { "E" },
	Melee = { "F" },
	Sprint = { "LeftShift" },
	Slide = { "C", "LeftControl" },
	Inspect = { "V" },
	Scoreboard = { "Tab" },
	Loadout = { "L" },
	Menu = { "M" },
	Ready = { "Return" },
	AdminPanel = { "P" },
	Fly = { "G" },
	Spectate = { "X" },
	Debug = { "F8" },
	-- Zuschauen: wechseln mit Klick / Pfeiltasten (nur im Zuschau-Modus aktiv)
	SpecNext = { "Right", "MouseButton1" },
	SpecPrev = { "Left" },
}
Client.WheelSwitch = true -- Mausrad: runter = NextWeapon, hoch = PrevWeapon

-- Gamepad (B15.1). Y = Primär/Sekundär wechseln, Y doppelt = letzte Waffe.
-- ButtonStart ist im Match "Bereit", sonst "Menü" (Priorität entscheidet).
Client.Gamepad = {
	Fire = "ButtonR2",
	Ads = "ButtonL2",
	Reload = "ButtonX",
	Cycle = "ButtonY",
	Melee = "ButtonL1",
	Utility = "ButtonR1",
	Sprint = "ButtonL3",
	Slide = "ButtonB",
	Scoreboard = "ButtonSelect",
	Ready = "ButtonStart",
	TriggerThreshold = 0.4, -- RT/LT gelten ab Position.Z ≥ 0.4 als gedrückt
	-- Ergänzungen aus der Tabelle B15.1 (D-Pad, Menü, Zuschauen)
	Loadout = "DPadDown",
	Inspect = "DPadUp",
	Menu = "ButtonStart",
	SpecNext = "ButtonR1",
	SpecPrev = "ButtonL1",
	DoubleTap = 0.28, -- Sekunden: zweimal Y in dieser Zeit = letzte Waffe
}

-- ---------------------------------------------------------------------
-- 2) ZIELHILFE (B15.2) – nur Touch & Gamepad, NIE Maus
-- ---------------------------------------------------------------------
Client.AimAssist = {
	Gamepad = { Cone = 3.5, Friction = 0.55, Magnet = 4 },
	Touch = { Cone = 4.5, Friction = 0.55, Magnet = 5 },
	Range = 70,
	RankedMult = 0.5,
	AutoFireRate = 0.85, -- Auto-Feuer feuert mit 85 % der Feuerrate
	AutoFireDwell = 0.15, -- so lange muss das Fadenkreuz auf einem sichtbaren Gegner liegen
}

-- ---------------------------------------------------------------------
-- 3) STANDARD-EINSTELLUNGEN (B15.3) – landen per Reconcile in Data.Settings
-- ---------------------------------------------------------------------
Client.DefaultSettings = {
	Fov = 80,
	SensMouse = 0.5,
	SensPad = 0.5,
	SensTouch = 0.6,
	AdsMult = 0.8,
	ScopeMult = 0.6,
	InvertY = false,
	AdsToggle = false,
	SprintToggle = false,
	AutoReload = true,
	AutoFire = "auto", -- "auto" = an bei Touch in Casual, "on", "off"
	AimAssist = 1,
	Crosshair = { Style = 1, Color = "White", Size = 8, Gap = 4, Dot = true },
	EnemyColor = "Red",
	DamageNumbers = true,
	HitSound = true,
	ReducedFx = false,
	Shake = 1,
	LeftHanded = false,
	ButtonScale = 1,
	Lang = "auto",
	Sfx = 1,
	Music = 0.5,
	Ui = 0.8,
	ShowNet = false,
	AutoRequeue = false,
	PublicDrops = true,
}

-- ---------------------------------------------------------------------
-- 4) SCHEMA – für jeden Standardwert genau ein Eintrag (Config.Validate prüft das)
-- ---------------------------------------------------------------------
local schema: { [string]: SchemaEntry } = {
	Fov = { Type = "number", Min = 70, Max = 100, Step = 1, Integer = true },
	SensMouse = { Type = "number", Min = 0.05, Max = 2, Step = 0.05 },
	SensPad = { Type = "number", Min = 0.05, Max = 2, Step = 0.05 },
	SensTouch = { Type = "number", Min = 0.05, Max = 2, Step = 0.05 },
	AdsMult = { Type = "number", Min = 0.2, Max = 1.5, Step = 0.05 },
	ScopeMult = { Type = "number", Min = 0.2, Max = 1.5, Step = 0.05 },
	InvertY = { Type = "boolean" },
	AdsToggle = { Type = "boolean" },
	SprintToggle = { Type = "boolean" },
	AutoReload = { Type = "boolean" },
	AutoFire = { Type = "enum", Options = { "auto", "on", "off" } },
	AimAssist = { Type = "number", Min = 0, Max = 1, Step = 0.05 },
	Crosshair = {
		Type = "table",
		Fields = {
			Style = { Type = "number", Min = 1, Max = 4, Step = 1, Integer = true }, -- 1 Kreuz, 2 Punkt, 3 Kreis, 4 T
			Color = { Type = "enum", Options = { "White", "Green", "Yellow", "Cyan", "Pink" } },
			Size = { Type = "number", Min = 4, Max = 16, Step = 1, Integer = true },
			Gap = { Type = "number", Min = 0, Max = 10, Step = 1, Integer = true },
			Dot = { Type = "boolean" },
		},
	},
	EnemyColor = { Type = "enum", Options = { "Red", "Magenta", "Yellow", "White" } },
	DamageNumbers = { Type = "boolean" },
	HitSound = { Type = "boolean" },
	ReducedFx = { Type = "boolean" },
	Shake = { Type = "number", Min = 0, Max = 1, Step = 0.05 },
	LeftHanded = { Type = "boolean" },
	ButtonScale = { Type = "number", Min = 0.9, Max = 1.3, Step = 0.05 },
	Lang = { Type = "enum", Options = { "auto", "de", "en" } },
	Sfx = { Type = "number", Min = 0, Max = 1, Step = 0.05 },
	Music = { Type = "number", Min = 0, Max = 1, Step = 0.05 },
	Ui = { Type = "number", Min = 0, Max = 1, Step = 0.05 },
	ShowNet = { Type = "boolean" },
	AutoRequeue = { Type = "boolean" },
	PublicDrops = { Type = "boolean" },
}
Client.SettingsSchema = schema

-- ---------------------------------------------------------------------
-- 5) SOUNDS – 0 = eingebautes Rezept (docs/ASSETS.md §2.2, nur die 11 eingebauten Dateien).
--    Eigene Audio-ID eintragen (z. B. Roblox-Audio aus dem Creator Store) = diese wird benutzt.
-- ---------------------------------------------------------------------
Client.Sounds = {
	RifleShot = 0,
	PistolShot = 0,
	SmgShot = 0,
	ShotgunShot = 0,
	SniperShot = 0,
	CannonShot = 0,
	RocketLaunch = 0,
	Explosion = 0,
	MagOut = 0,
	MagIn = 0,
	Equip = 0,
	MeleeSwing = 0,
	MeleeHit = 0,
	Hitmarker = 0,
	Headshot = 0,
	Kill = 0,
	Eliminated = 0,
	UIClick = 0,
	UIHover = 0,
	UIError = 0,
	Countdown = 0,
	Go = 0,
	Win = 0,
	Lose = 0,
	LevelUp = 0,
	Heal = 0,
	LobbyMusic = 0, -- ohne ID keine Musik (es gibt keine eingebaute Musik)
	MatchMusic = 0,
}

-- ---------------------------------------------------------------------
-- 6) HUD, TOUCH, EFFEKTE (Budgets C17)
-- ---------------------------------------------------------------------
Client.TouchButtonMin = 64 -- kein Touch-Knopf kleiner als 64 px (auch bei Knopfgröße 90 %)
Client.AutoReducedFx = { Fps = 35, Seconds = 5, StartDelay = 15 } -- < 35 FPS für 5 s -> Reduzierte Effekte (erst 15 s nach dem Start)
Client.HighlightCap = 31 -- Roblox zeigt höchstens 31 Highlights gleichzeitig
Client.Pools = {
	Tracers = 48,
	Impacts = 32, -- höchstens so viele Treffer-Effekte pro Sekunde
	DamageNumbers = 24,
	Sounds = 24, -- je Hälfte 2D (Oberfläche) und 3D (Welt)
	Lights = 4,
	Projectiles = 40,
	Finishers = 4,
}

-- Touch-Knöpfe (unskalierte TouchGui). Größen in Pixel bei Knopfgröße 100 %.
Client.Touch = {
	FireSize = 116, -- großer FEUER-Knopf rechts (ziehen = zielen)
	SmallFireSize = 76, -- kleiner FEUER-Knopf links
	ButtonSize = 72, -- ADS, NACHLADEN, RUTSCHEN, UTILITY
	SlotSize = 66, -- Slot-Leiste unten Mitte
	SmallSize = 64, -- Scoreboard/Loadout/Inspizieren/Menü oben rechts
	Margin = 16,
	LookPerPixel = 0.0065, -- Bogenmaß pro Pixel beim Ziehen des Feuerknopfs (× SensTouch)
}

-- Fadenkreuz (4 Stile) und Treffer-Anzeigen (B14.1)
Client.CrosshairColors = {
	White = Color3.fromRGB(255, 255, 255),
	Green = Color3.fromRGB(90, 255, 120),
	Yellow = Color3.fromRGB(255, 230, 60),
	Cyan = Color3.fromRGB(60, 230, 255),
	Pink = Color3.fromRGB(255, 105, 200),
}
Client.Hud = {
	HitmarkerBody = 0.12, -- weißes X
	HitmarkerHead = 0.22, -- gelbes großes X
	HitmarkerKill = 0.4, -- rotes X
	DamageStack = 0.6, -- Schadenszahlen am selben Ziel stapeln sich so lange
	DamageLife = 0.85,
	HurtArrow = 1.2, -- Richtungs-Pfeil nach erhaltenem Schaden
	LowHp = 30, -- ab hier Herzschlag-Vignette + leises "Autsch"
	LowAmmo = 0.25, -- Anteil des Magazins: doppelter Tick
	MultiKillWindow = 4, -- DOUBLE!/TRIPLE!/QUAD! (Team/FFA)
	KillBanner = 1.6,
	-- Treffer-Gefühl (docs/SKILL-WUENSCHE.md): kurzer "Treffer-Stopp" = Marker friert ein, andere
	-- Kampf-Sounds ducken sich, Mini-Ruck der Kamera; beim Pop zusätzlich FOV-Punch (B14.1)
	HitStopKill = 0.07,
	HitStopHead = 0.04,
	FovPunch = 3,
}

-- Tracer (Beam zwischen zwei Attachments, ASSETS §5)
Client.Tracer = {
	Texture = "rbxasset://textures/gradient.png",
	Width0 = 0.12,
	Width1 = 0.05,
	Life = 0.07, -- ausblenden in 0.05–0.08 s
}
Client.FxRange = 450 -- weiter weg: keine Partikel
Client.FinisherRange = 300 -- weiter weg: Finisher ausgeblendet (B19)

-- ---------------------------------------------------------------------
-- 7) PRÜFEN (Config.Validate sammelt das) – leere Liste = alles ok
-- ---------------------------------------------------------------------
local function isFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function checkValue(errors: { string }, path: string, entry: SchemaEntry, value: any)
	if entry.Type == "number" then
		if not isFinite(value) then
			table.insert(errors, path .. ": Zahl erwartet")
			return
		end
		local lo, hi = entry.Min, entry.Max
		if lo == nil or hi == nil or lo > hi then
			table.insert(errors, path .. ": Schema braucht Min ≤ Max")
		elseif value < lo or value > hi then
			table.insert(
				errors,
				("%s: Standard %s außerhalb %s..%s"):format(path, tostring(value), tostring(lo), tostring(hi))
			)
		end
		if entry.Integer and value % 1 ~= 0 then
			table.insert(errors, path .. ": ganze Zahl erwartet")
		end
	elseif entry.Type == "boolean" then
		if type(value) ~= "boolean" then
			table.insert(errors, path .. ": true/false erwartet")
		end
	elseif entry.Type == "enum" then
		local options = entry.Options
		if type(options) ~= "table" or #options == 0 then
			table.insert(errors, path .. ": Schema braucht Options")
		elseif not table.find(options, value) then
			table.insert(errors, path .. ": Standard " .. tostring(value) .. " ist keine Option")
		end
	elseif entry.Type == "table" then
		local fields = entry.Fields
		if type(fields) ~= "table" or type(value) ~= "table" then
			table.insert(errors, path .. ": Tabelle + Fields erwartet")
			return
		end
		for key, sub in pairs(fields) do
			checkValue(errors, path .. "." .. key, sub, value[key])
		end
		for key in pairs(value) do
			if fields[key] == nil then
				table.insert(errors, path .. "." .. tostring(key) .. ": fehlt im Schema")
			end
		end
	else
		table.insert(errors, path .. ": unbekannter Schema-Typ " .. tostring(entry.Type))
	end
end

local function keyExists(name: string): boolean
	return Enum.KeyCode:FromName(name) ~= nil or Enum.UserInputType:FromName(name) ~= nil
end

function Client.Validate(_config: any): { string }
	local errors: { string } = {}
	local defaults: { [string]: any } = Client.DefaultSettings
	for key, value in pairs(defaults) do
		local entry = schema[key]
		if not entry then
			table.insert(errors, "Config.Client.SettingsSchema." .. key .. ": Eintrag fehlt")
		else
			checkValue(errors, "Config.Client.DefaultSettings." .. key, entry, value)
		end
	end
	for key in pairs(schema) do
		if defaults[key] == nil then
			table.insert(errors, "Config.Client.SettingsSchema." .. key .. ": kein Standardwert")
		end
	end
	local keys: { [string]: { string } } = Client.Keys
	for action, list in pairs(keys) do
		if type(list) ~= "table" or #list == 0 then
			table.insert(errors, "Config.Client.Keys." .. action .. ": Liste erwartet")
		else
			for _, name in ipairs(list) do
				if type(name) ~= "string" or not keyExists(name) then
					table.insert(errors, "Config.Client.Keys." .. action .. ": unbekannte Taste " .. tostring(name))
				end
			end
		end
	end
	local pad: { [string]: any } = Client.Gamepad
	for action, name in pairs(pad) do
		if type(name) == "string" and Enum.KeyCode:FromName(name) == nil then
			table.insert(errors, "Config.Client.Gamepad." .. action .. ": unbekannter Knopf " .. name)
		end
	end
	if not isFinite(pad.TriggerThreshold) or pad.TriggerThreshold <= 0 or pad.TriggerThreshold > 1 then
		table.insert(errors, "Config.Client.Gamepad.TriggerThreshold: Zahl 0..1 erwartet")
	end
	local sounds: { [string]: any } = Client.Sounds
	for role, id in pairs(sounds) do
		if not isFinite(id) or id < 0 or id % 1 ~= 0 then
			table.insert(errors, "Config.Client.Sounds." .. role .. ": 0 oder Audio-ID (ganze Zahl) erwartet")
		end
	end
	local pools: { [string]: any } = Client.Pools
	for name, size in pairs(pools) do
		if not isFinite(size) or size < 1 or size % 1 ~= 0 then
			table.insert(errors, "Config.Client.Pools." .. name .. ": ganze Zahl ≥ 1 erwartet")
		end
	end
	if not isFinite(Client.HighlightCap) or Client.HighlightCap < 1 or Client.HighlightCap > 31 then
		table.insert(errors, "Config.Client.HighlightCap: 1..31 erwartet (Roblox-Grenze)")
	end
	if not isFinite(Client.TouchButtonMin) or Client.TouchButtonMin < 44 then
		table.insert(errors, "Config.Client.TouchButtonMin: mindestens 44 px erwartet")
	end
	local touch: { [string]: any } = Client.Touch
	for name, value in pairs(touch) do
		if not isFinite(value) or value <= 0 then
			table.insert(errors, "Config.Client.Touch." .. name .. ": positive Zahl erwartet")
		end
	end
	local crosshair = schema.Crosshair.Fields
	local colorOptions = crosshair and crosshair.Color.Options or {}
	for _, name in ipairs(colorOptions :: { string }) do
		if typeof((Client.CrosshairColors :: any)[name]) ~= "Color3" then
			table.insert(errors, "Config.Client.CrosshairColors." .. name .. ": Color3 fehlt")
		end
	end
	local auto = Client.AutoReducedFx
	if not isFinite(auto.Fps) or not isFinite(auto.Seconds) or auto.Fps <= 0 or auto.Seconds <= 0 then
		table.insert(errors, "Config.Client.AutoReducedFx: Fps und Seconds > 0 erwartet")
	end
	return errors
end

return Client
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  CLUTCH CLASH – Kampf-Einstellungen (Shared/Config/Combat) -> Config.Combat
--  Besitzer: WP3 (Kampf Server & Treffer-Mathematik). Vertrag: DESIGN.md C15, C10, C11, B13.
--  Treffer-Registrierung, Rückspulen, Hitboxen, Toleranzen. Startwerte aus DESIGN.md.
--  ACHTUNG: wird an alle Clients repliziert -> keine Geheimnisse.
--
--  Abschnitte:
--    1) Rückspulen & Verlauf       2) Hitboxen        3) Schuss-Prüfung (C10)
--    4) Nahkampf, Pop, Assists     5) Projektile       6) Sonstiges (Anti-Camp, Zielfernrohr)
--    7) Ergänzungen von WP3 (nicht im Schema-Auszug, aber hier zentral einstellbar)
--  Validate(Config): { string } prüft alle Zahlen (SelfTest + Boot-warn).
-- =====================================================================

local Combat = {
	-- -----------------------------------------------------------------
	-- 1) RÜCKSPULEN & VERLAUF (HistoryService)
	-- -----------------------------------------------------------------
	InterpDelay = 0.10, -- so weit hinkt die Sicht des Schützen hinterher (Roblox-Interpolation)
	MaxRewind = 0.38, -- höchstens so weit wird zurückgespult
	RewindWindow = 0.075, -- zusätzlich T−0.075 und T+0.075 prüfen
	HistoryHz = 30, -- Proben pro Sekunde
	HistorySlots = 24, -- Ringpuffer-Größe (24 / 30 Hz = 0.8 s)

	-- -----------------------------------------------------------------
	-- 2) HITBOXEN (B13.2) – feste Größe für jeden Avatar
	-- -----------------------------------------------------------------
	HitTol = 0.35, -- Toleranz (Studs) auf Kopf-Kugel und Körper-Kasten
	HeadRadius = 0.8, -- × rules.HeadRadiusMult (BigHeads 1.6)
	BodyOffset = Vector3.new(0, -1, 0), -- Mitte des Körper-Kastens relativ zum HRP
	BodyHalf = Vector3.new(1.5, 2.0, 0.8), -- Halbmaße (Boden bis Schulter, Arme inklusive)
	HeadTieBreak = 0.5, -- Kopf gewinnt, wenn sein Eintritt höchstens so viel weiter ist

	-- -----------------------------------------------------------------
	-- 3) SCHUSS-PRÜFUNG (C10)
	-- -----------------------------------------------------------------
	OriginTol = 4, -- Ursprung darf so weit vom Server-Kopf weg sein ...
	OriginSpeedCap = 0.4, -- ... plus Tempo × min(Alter, 0.4)
	LosShorten = 0.75, -- Sichtlinien-Strahl endet so viel vor dem Treffpunkt
	AgeMin = -0.05, -- Paket-Alter (Server-Zeit − t) mindestens ...
	AgeMax = 1.0, -- ... und höchstens
	PingSlack = 0.35, -- Alter <= Ping + 0.35
	IntervalTolerance = 0.75, -- Abstand der Zeitstempel >= Interval × 0.75
	RecvTolerance = 0.5, -- Empfangsabstand am Server >= Interval × 0.5
	PerSecondFactor = 1.15, -- Schüsse pro Sekunde <= 1/Interval × 1.15 + 1
	ShotIdGap = 4, -- shotId darf höchstens um 4 springen (Paketverlust)
	AimNormTol = 0.01, -- |aim| muss in [0.99, 1.01] liegen
	MaxScale = 30, -- größter erlaubter Spread-Anspruch (Grad)

	-- -----------------------------------------------------------------
	-- 4) NAHKAMPF, POP, ASSISTS (B11.4, B13.1)
	-- -----------------------------------------------------------------
	MeleeRangeSlack = 1.5, -- Reichweite + 1.5
	MeleeConeSlack = 10, -- Kegel/2 + 10°
	KillCreditWindow = 8, -- letzter Schadensverursacher <= 8 s bekommt den Pop
	AssistDamage = 25, -- Assist: mindestens 25 Schaden ...
	AssistWindow = 8, -- ... in den letzten 8 s vor dem Pop

	-- -----------------------------------------------------------------
	-- 5) PROJEKTILE (C11)
	-- -----------------------------------------------------------------
	RocketJump = { Radius = 4, Up = 55 }, -- eigene Rakete <= 4 Studs von den Füßen -> 55 nach oben
	ImpulseGrace = 1.5, -- Anti-Cheat-Gnade nach Rückstoß/Raketensprung (s)
	ImpulseMaxSpeed = 95, -- erlaubtes Tempo während der Gnade
	ProjectileRadius = 0.5, -- Kugel-gegen-Strahl-Radius der Projektile
	MaxFastForward = 0.15, -- Projektile werden um min(Alter, 0.15) vorgespult

	-- -----------------------------------------------------------------
	-- 6) SONSTIGES
	-- -----------------------------------------------------------------
	RecapMax = 12, -- Todes-Rückblick: letzte 12 Treffer
	AntiCamp = { Duel = 30, Team = 40, Pulse = 10, Show = 1 }, -- B6.5 (MatchService)
	ScopeGlintAfter = 0.3, -- Zielfernrohr-Glanz für Gegner nach 0.3 s ADS
	ScopeHitKick = 2, -- Treffer während ADS -> 2° Kamera-Kick

	-- -----------------------------------------------------------------
	-- 7) ERGÄNZUNGEN VON WP3 (zentral statt fest im Code)
	-- -----------------------------------------------------------------
	MovingSpeed = 10, -- ab diesem Tempo (Studs/s) rechnet der Server SpreadMove in die Untergrenze ein.
	-- Bewusst großzügig (Gehen = 16): der Client darf SpreadMove schon früher addieren, nie später.
	AdsGrace = 0.1, -- Zielen gilt AdsTime − 0.1 s nach dem Anlegen als "fertig" (C10 Schritt 7)
	ThrowChargedSpeed = 90, -- Wurf voll aufgeladen (0.5 s halten); Tippen = Projectile.Speed (70)
	ThrowFullHold = 0.5, -- so lange halten = charge 1.0 (Client)
	KillYHz = 5, -- Prüftakt für Sturz unter KillY, fehlende Teile, Regeneration
	VaultSpacing = 3, -- Abstand der Roster-Plätze im Tresor
	Admin = { -- Admin-Waffen B11.7
		OrbitalRay = 1000, -- Markier-Strahl
		OrbitalDelay = 1.0, -- Warnkreis-Dauer
		OrbitalRadius = 10, -- Himmelsstrahl-Radius
		OrbitalDamage = 999,
		MinigunSpinUp = 0.4, -- Anlauf (Client)
		VortexTime = 4, -- Wirbel-Dauer
		VortexDamageRadius = 18,
		VortexPullRadius = 25,
		VortexDps = 25,
		VortexImplosion = 150,
		VortexPull = 28, -- Zug-Tempo (Studs/s)
		VortexHz = 4,
		LightningJumps = 4, -- weitere Ziele
		LightningJumpRange = 20,
		LightningDamage = 80,
	},
}

-- ---------------------------------------------------------------------
-- PRÜFEN (leere Liste = alles ok)
-- ---------------------------------------------------------------------
local function isNum(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

function Combat.Validate(_config: any): { string }
	local errors: { string } = {}
	local function num(path: string, value: any, min: number, max: number?)
		if not isNum(value) then
			table.insert(errors, "Config.Combat." .. path .. ": Zahl erwartet")
		elseif value < min or (max ~= nil and value > max) then
			table.insert(
				errors,
				("Config.Combat.%s: %s liegt außerhalb [%s, %s]"):format(
					path,
					tostring(value),
					tostring(min),
					tostring(max or "∞")
				)
			)
		end
	end
	local c: any = Combat
	num("InterpDelay", c.InterpDelay, 0, 0.5)
	num("MaxRewind", c.MaxRewind, 0, 1)
	num("RewindWindow", c.RewindWindow, 0, 0.3)
	num("HistoryHz", c.HistoryHz, 1, 60)
	num("HistorySlots", c.HistorySlots, 2, 120)
	num("HitTol", c.HitTol, 0, 2)
	num("HeadRadius", c.HeadRadius, 0.1, 5)
	num("HeadTieBreak", c.HeadTieBreak, 0, 5)
	num("OriginTol", c.OriginTol, 0, 50)
	num("OriginSpeedCap", c.OriginSpeedCap, 0, 2)
	num("LosShorten", c.LosShorten, 0, 5)
	num("AgeMin", c.AgeMin, -1, 0)
	num("AgeMax", c.AgeMax, 0, 5)
	num("PingSlack", c.PingSlack, 0, 5)
	num("IntervalTolerance", c.IntervalTolerance, 0, 1)
	num("RecvTolerance", c.RecvTolerance, 0, 1)
	num("PerSecondFactor", c.PerSecondFactor, 1, 5)
	num("ShotIdGap", c.ShotIdGap, 1, 64)
	num("AimNormTol", c.AimNormTol, 0, 0.5)
	num("MaxScale", c.MaxScale, 1, 89)
	num("MeleeRangeSlack", c.MeleeRangeSlack, 0, 10)
	num("MeleeConeSlack", c.MeleeConeSlack, 0, 90)
	num("KillCreditWindow", c.KillCreditWindow, 0, 60)
	num("AssistDamage", c.AssistDamage, 0, 1000)
	num("AssistWindow", c.AssistWindow, 0, 60)
	num("ImpulseGrace", c.ImpulseGrace, 0, 10)
	num("ImpulseMaxSpeed", c.ImpulseMaxSpeed, 0, 500)
	num("ProjectileRadius", c.ProjectileRadius, 0, 5)
	num("MaxFastForward", c.MaxFastForward, 0, 1)
	num("RecapMax", c.RecapMax, 1, 50)
	num("ScopeGlintAfter", c.ScopeGlintAfter, 0, 5)
	num("ScopeHitKick", c.ScopeHitKick, 0, 20)
	num("MovingSpeed", c.MovingSpeed, 0, 50)
	num("AdsGrace", c.AdsGrace, 0, 1)
	num("ThrowChargedSpeed", c.ThrowChargedSpeed, 1, 500)
	num("ThrowFullHold", c.ThrowFullHold, 0.05, 5)
	num("KillYHz", c.KillYHz, 1, 30)
	num("VaultSpacing", c.VaultSpacing, 1, 10)
	if c.MaxRewind < c.InterpDelay then
		table.insert(errors, "Config.Combat.MaxRewind: muss >= InterpDelay sein")
	end
	if isNum(c.HistorySlots) and isNum(c.HistoryHz) and c.HistorySlots / c.HistoryHz < c.MaxRewind + c.RewindWindow then
		table.insert(errors, "Config.Combat.HistorySlots: Verlauf zu kurz für MaxRewind + RewindWindow")
	end
	for _, name in ipairs({ "BodyOffset", "BodyHalf" }) do
		local v = c[name]
		if typeof(v) ~= "Vector3" or not (isNum(v.X) and isNum(v.Y) and isNum(v.Z)) then
			table.insert(errors, "Config.Combat." .. name .. ": Vector3 erwartet")
		end
	end
	if typeof(c.BodyHalf) == "Vector3" and (c.BodyHalf.X <= 0 or c.BodyHalf.Y <= 0 or c.BodyHalf.Z <= 0) then
		table.insert(errors, "Config.Combat.BodyHalf: alle Halbmaße müssen > 0 sein")
	end
	if type(c.RocketJump) ~= "table" then
		table.insert(errors, "Config.Combat.RocketJump: Tabelle erwartet")
	else
		num("RocketJump.Radius", c.RocketJump.Radius, 0, 50)
		num("RocketJump.Up", c.RocketJump.Up, 0, 300)
	end
	if type(c.AntiCamp) ~= "table" then
		table.insert(errors, "Config.Combat.AntiCamp: Tabelle erwartet")
	else
		for _, key in ipairs({ "Duel", "Team", "Pulse", "Show" }) do
			num("AntiCamp." .. key, c.AntiCamp[key], 0, 600)
		end
	end
	if type(c.Admin) ~= "table" then
		table.insert(errors, "Config.Combat.Admin: Tabelle erwartet")
	else
		for key, value in pairs(c.Admin) do
			num("Admin." .. tostring(key), value, 0, 100000)
		end
	end
	return errors
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – KOSMETIK-KATALOG (Shared/Config/Cosmetics)
--  Besitzer: WP9 (Wirtschaft, Monetarisierung, Kosmetik). Vertrag: DESIGN.md B19 + C15.
--  Alles ist Part-/UI-basiert (keine hochgeladenen Assets):
--    Wraps     = Farben/Material pro Rollen-Gruppe (Body/Detail/Accent/Metal/Grip – die orange
--                Spitze "Tip" wird NIE verändert), optional Anim ("Pulse"/"Rainbow"/"Galaxy"/"Sparkle")
--    Skins     = alternatives Waffen-Rezept (Rezept liegt in Shared/WeaponModels unter der Skin-Id)
--    Charms    = Mini-Modell (Rezept in Shared/CosmeticModels unter der Charm-Id)
--    Finisher  = Client-Effekt (Builder in Client/Modules/Finishers unter der Finisher-Id)
--    Tracer    = Beam-Farbe/-Breite
--    Titel     = Text unter dem Namen ("TT_…")
--
--  Preise:  Price = { Coins = n }  -> mit Münzen kaufbar (Basis-Wraps)
--           Price = nil            -> Katalog-Listenpreis in Gems nach Rarity (Config.Shop.CatalogPrices)
--  Quelle (Source):
--    "Catalog"  Katalog (+ evtl. Kiste)          "Coins"   Münz-Wrap (+ Kiste -> auch für Gems)
--    "Pass"     Clutch Pass (exklusiv während seiner Saison, siehe Exclusive), danach Katalog
--    "VIP"      gehört automatisch jedem mit VIP-Pass      "Starter" nur im Starter-Paket
--    "Mastery"  Meisterschafts-Stufe der Waffe (nie kaufbar, kein Besitz-Eintrag)
--    "Login"    Login-Kalender    "Default" gehört allen    "Earned" erspielt (Level, Erfolge …)
--
--  Öffentliche API (zusätzlich zu den Daten):
--    Cosmetics.ById[id] -> def (mit def.Id und def.Kind)      Cosmetics.Get(id): def?
--    Cosmetics.IsExclusive(id, seasonId): boolean               Pass-Item noch in seiner Saison?
--    Cosmetics.Validate(Config): { string }
-- =====================================================================

local rgb = Color3.fromRGB

local Cosmetics = {}

Cosmetics.Rarities = { "Common", "Rare", "Epic", "Legendary", "Mythic" }
Cosmetics.RarityRank = { Common = 1, Rare = 2, Epic = 3, Legendary = 4, Mythic = 5 }
Cosmetics.Kinds = { "Wrap", "Skin", "Charm", "Finisher", "Tracer", "Title" }
Cosmetics.Defaults = { Finisher = "F_Confetti", Tracer = "T_Team" }
Cosmetics.WrapRoles = { "Body", "Detail", "Accent", "Metal", "Grip" } -- "Tip" bleibt immer orange
Cosmetics.Anims = { Pulse = true, Rainbow = true, Galaxy = true, Sparkle = true }
Cosmetics.AnimHz = 10 -- Wrap-Animationen: 10 Hz
Cosmetics.AnimRange = 80 -- nur bis 80 Studs zur Kamera
-- Erlaubte Materialien (Muss-Regel 11: NIE "Ice")
Cosmetics.Materials = {
	SmoothPlastic = true,
	Plastic = true,
	Neon = true,
	Foil = true,
	Glass = true,
	Metal = true,
	DiamondPlate = true,
