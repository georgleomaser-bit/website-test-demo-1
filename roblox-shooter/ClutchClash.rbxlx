        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Texte "ui." (Shared/Lang/Ui)
--  Besitzer: WP10 (Client-Hülle). Nur Schlüssel mit Präfix "ui." (C16).
--  Platzhalter wie string.format: %s = Text, %d = ganze Zahl.
--  Inhalt: Willkommen, Lobby-HUD, Kampf-HUD (Hitmarker, Mehrfach-Pops, Nachladen), Touch-Knöpfe,
--  Einstellungen (Abschnitte, jede Einstellung "ui.set.<Key>", Optionen "ui.opt.<Key>.<Wert>"),
--  Info (Regeln + Einspruch, C19), Effekt-Hinweise (Ansagen, Level-Up, Events).
-- =====================================================================

return {
	de = {
		-- Start
		["ui.welcome"] = "🎯 Willkommen bei %s!",
		["ui.welcomeKbm"] = "Geh auf ein Duell-Pad oder drück unten auf PLAY! [M] = Einstellungen",
		["ui.welcomePad"] = "Geh auf ein Duell-Pad oder wähle PLAY! [Start] = Einstellungen",
		["ui.welcomeTouch"] = "Geh auf ein Duell-Pad oder tippe unten auf PLAY!",
		-- Lobby-HUD
		["ui.play"] = "▶ PLAY",
		["ui.playSub"] = "DUELLE · FFA · TRAINING",
		["ui.levelShort"] = "LV %d",
		["ui.netStats"] = "%d FPS · %d ms · %d MB",
		["ui.btn.settings"] = "Einstellungen",
		-- Kampf-HUD
		["ui.headshot"] = "HEADSHOT!",
		["ui.popped"] = "%s GEPOPPT",
		["ui.multi2"] = "DOUBLE!",
		["ui.multi3"] = "TRIPLE!",
		["ui.multi4"] = "QUAD!",
		["ui.multi5"] = "ACE!",
		["ui.reloadHint"] = "[%s] NACHLADEN",
		-- Touch-Knöpfe
		["ui.touch.fire"] = "FEUER",
		["ui.touch.ads"] = "ADS",
		["ui.touch.reload"] = "NACHLADEN",
		["ui.touch.slide"] = "RUTSCHEN",
		["ui.touch.utility"] = "UTILITY",
		["ui.touch.ready"] = "BEREIT",
		-- Effekte / Hinweise
		["ui.adminWarn"] = "⚠️ WARNUNG VOM ADMIN ⚠️",
		["ui.levelUp"] = "LEVEL %d!",
		["ui.levelUpShort"] = "LEVEL UP!",
