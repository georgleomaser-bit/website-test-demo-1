-- =====================================================================
-- PRÜFEN (Config.Validate sammelt das) – leere Liste = alles ok
-- =====================================================================
local function isNumber(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local GRANT_FIELDS = { Coins = true, Gems = true, Keys = true, Shards = true, XpBoostSeconds = true, W = true }

function Progression.Validate(Config: any): { string }
	local errors: { string } = {}
	local function err(path: string, text: string)
		table.insert(errors, "Config.Progression." .. path .. ": " .. text)
	end
	local function num(path: string, v: any, min: number?, integer: boolean?)
		if not isNumber(v) then
			err(path, "Zahl erwartet")
		elseif min ~= nil and v < min then
			err(path, "mindestens " .. tostring(min))
		elseif integer and v % 1 ~= 0 then
			err(path, "ganze Zahl erwartet")
		end
	end
	local function numbers(path: string, t: any, min: number?)
		if type(t) ~= "table" then
			err(path, "Tabelle erwartet")
			return
		end
		for key, value in pairs(t) do
			num(path .. "." .. tostring(key), value, min)
		end
	end
	local function grant(path: string, t: any)
		if type(t) ~= "table" then
			err(path, "Belohnungs-Tabelle erwartet")
			return
		end
		for key, value in pairs(t) do
			if not GRANT_FIELDS[key] then
				err(path .. "." .. tostring(key), "unbekanntes Belohnungsfeld")
			else
				num(path .. "." .. tostring(key), value, 0)
			end
		end
	end

	num("Curve.Base", Progression.Curve.Base, 1)
	num("Curve.Step", Progression.Curve.Step, 0)
	num("Curve.MaxLevel", Progression.Curve.MaxLevel, 2, true)
	numbers("Xp", Progression.Xp, 0)
	numbers("XpMult", Progression.XpMult, 0)
	if isNumber(Progression.XpMult.Cap) and Progression.XpMult.Cap < 1 then
		err("XpMult.Cap", "mindestens 1")
	end
	numbers("Coins", Progression.Coins, 0)
	numbers("FirstWin", Progression.FirstWin, 0)
	numbers("Tutorial", Progression.Tutorial, 0)

	local lr = Progression.LevelRewards
	num("LevelRewards.CoinsBase", lr.CoinsBase, 0)
	num("LevelRewards.CoinsPerLevel", lr.CoinsPerLevel, 0)
	num("LevelRewards.KeyEvery", lr.KeyEvery, 1, true)
	num("LevelRewards.GemsEvery", lr.GemsEvery, 1, true)
	num("LevelRewards.Gems", lr.Gems, 0)
	for i, level in ipairs(lr.FreeWeaponLevels) do
		num("LevelRewards.FreeWeaponLevels[" .. i .. "]", level, 2, true)
	end
	for level, title in pairs(lr.Titles) do
		if not isNumber(level) or type(title) ~= "string" or string.sub(title, 1, 3) ~= "TT_" then
			err("LevelRewards.Titles[" .. tostring(level) .. "]", 'Level -> "TT_…" erwartet')
		end
	end

	-- Meisterschaft: 10 aufsteigende Stufen + 10 Belohnungen
	local mastery = Progression.Mastery
	local last = 0
	for i, goal in ipairs(mastery.Tiers) do
		num("Mastery.Tiers[" .. i .. "]", goal, 1)
		if isNumber(goal) and goal <= last then
			err("Mastery.Tiers[" .. i .. "]", "muss größer als die vorige Stufe sein")
		end
		last = if isNumber(goal) then goal else last
	end
	if #mastery.Rewards ~= #mastery.Tiers then
		err("Mastery.Rewards", "genau eine Belohnung je Stufe erwartet")
	end
	for i, reward in ipairs(mastery.Rewards) do
		for key, value in pairs(reward) do
			if key == "Wrap" then
				if type(value) ~= "string" then
					err("Mastery.Rewards[" .. i .. "].Wrap", "Wrap-Id erwartet")
				end
			elseif key == "Title" then
				if value ~= "Master" then
					err("Mastery.Rewards[" .. i .. "].Title", '"Master" erwartet')
				end
			elseif not GRANT_FIELDS[key] then
				err("Mastery.Rewards[" .. i .. "]." .. tostring(key), "unbekanntes Feld")
			else
				num("Mastery.Rewards[" .. i .. "]." .. tostring(key), value, 0)
			end
		end
	end

	-- Quests
	local q = Progression.Quests
	num("Quests.DailyCount", q.DailyCount, 1, true)
	num("Quests.WeeklyCount", q.WeeklyCount, 1, true)
	num("Quests.FreeRerolls", q.FreeRerolls, 0, true)
	num("Quests.RerollCoins", q.RerollCoins, 0)
	local ids: { [string]: boolean } = {}
	local tierCount: { [string]: number } = {}
	local function questList(path: string, list: any, needsTier: boolean)
		if type(list) ~= "table" then
			err(path, "Liste erwartet")
			return
		end
		for i, def in ipairs(list) do
			local p = ("%s[%d]"):format(path, i)
			if type(def.Id) ~= "string" or def.Id == "" then
				err(p .. ".Id", "Text erwartet")
			elseif ids[def.Id] then
				err(p .. ".Id", "doppelte Quest-Id " .. def.Id)
			else
				ids[def.Id] = true
			end
			if type(def.Kind) ~= "string" then
				err(p .. ".Kind", "Text erwartet")
			end
			num(p .. ".Goal", def.Goal, 1)
			if needsTier then
				if q.DailyRewards[def.Tier] == nil then
					err(p .. ".Tier", "Easy/Medium/Hard erwartet")
				else
					tierCount[def.Tier] = (tierCount[def.Tier] or 0) + 1
				end
			end
			if def.Filter ~= nil and type(def.Filter) ~= "table" then
				err(p .. ".Filter", "Tabelle erwartet")
			end
		end
	end
	questList("Quests.Daily", q.Daily, true)
	questList("Quests.Weekly", q.Weekly, false)
	questList("Quests.Beginner", q.Beginner, false)
	if #q.Daily ~= 20 then
		err("Quests.Daily", "20 Einträge erwartet (B16.3)")
	end
	if #q.Weekly ~= 8 then
		err("Quests.Weekly", "8 Einträge erwartet (B16.3)")
	end
	if #q.Weekly < q.WeeklyCount then
		err("Quests.Weekly", "weniger Einträge als WeeklyCount")
	end
	for _, tier in ipairs(q.DailyTiers) do
		if (tierCount[tier] or 0) < 2 then
			err("Quests.Daily", "Stufe " .. tier .. " braucht mindestens 2 Quests (Tauschen)")
		end
	end
	for tier, reward in pairs(q.DailyRewards) do
		num("Quests.DailyRewards." .. tier .. ".Coins", reward.Coins, 0)
		num("Quests.DailyRewards." .. tier .. ".PassXp", reward.PassXp, 0)
	end
	num("Quests.WeeklyReward.Coins", q.WeeklyReward.Coins, 0)
	num("Quests.WeeklyReward.PassXp", q.WeeklyReward.PassXp, 0)
	grant("Quests.WeeklyChest", q.WeeklyChest)
	local beginnerCoins = 0
	for i, step in ipairs(q.Beginner) do
		num(("Quests.Beginner[%d].Coins"):format(i), step.Coins, 0)
		beginnerCoins += if isNumber(step.Coins) then step.Coins else 0
	end
	if #q.Beginner ~= 10 or beginnerCoins ~= 1250 then
		err("Quests.Beginner", "10 Schritte mit zusammen 1.250 Coins erwartet (B16.3)")
	end

	-- Login
	local login = Progression.Login
	if #login.Calendar ~= 7 then
		err("Login.Calendar", "7 Tage erwartet")
	end
	for i, reward in ipairs(login.Calendar) do
		grant("Login.Calendar[" .. i .. "]", reward)
	end
	num("Login.FreezesPerWeek", login.FreezesPerWeek, 0, true)
	num("Login.PassXp", login.PassXp, 0)
	num("Login.OnFireDays", login.OnFireDays, 1, true)

	-- Glücksrad: Summe genau 100 %
	local wheelSum = 0
	for i, prize in ipairs(Progression.Wheel.Prizes) do
		grant("Wheel.Prizes[" .. i .. "]", prize)
		num("Wheel.Prizes[" .. i .. "].W", prize.W, 0)
		wheelSum += if isNumber(prize.W) then prize.W else 0
	end
	if math.abs(wheelSum - 100) > 1e-6 then
		err("Wheel.Prizes", ("Gewichte müssen 100 ergeben (sind %s)"):format(tostring(wheelSum)))
	end
	num("Wheel.FreeSpins", Progression.Wheel.FreeSpins, 0, true)
	num("Wheel.VipSpins", Progression.Wheel.VipSpins, 0, true)
	num("Wheel.AllDailiesSpins", Progression.Wheel.AllDailiesSpins, 0, true)

	-- Spielzeit
	local pt = Progression.Playtime
	if #pt.Minutes ~= #pt.Rewards then
		err("Playtime", "gleich viele Minuten und Belohnungen erwartet")
	end
	local lastMinute = 0
	for i, minutes in ipairs(pt.Minutes) do
		num("Playtime.Minutes[" .. i .. "]", minutes, 1)
		if isNumber(minutes) and minutes <= lastMinute then
			err("Playtime.Minutes[" .. i .. "]", "aufsteigend erwartet")
		end
		lastMinute = if isNumber(minutes) then minutes else lastMinute
	end
	for i, reward in ipairs(pt.Rewards) do
		grant("Playtime.Rewards[" .. i .. "]", reward)
	end

	-- Erfolge
	local count = 0
	for id, def in pairs(Progression.Achievements) do
		count += 1
		local p = "Achievements." .. tostring(id)
		if type(def.Name) ~= "table" or type(def.Name.de) ~= "string" or type(def.Name.en) ~= "string" then
			err(p .. ".Name", "{ de, en } erwartet")
		end
		if type(def.Desc) ~= "table" or type(def.Desc.de) ~= "string" or type(def.Desc.en) ~= "string" then
			err(p .. ".Desc", "{ de, en } erwartet")
		end
		if type(def.Stat) ~= "string" then
			err(p .. ".Stat", "Text erwartet")
		end
		num(p .. ".Goal", def.Goal, 1)
		num(p .. ".Order", def.Order, 1, true)
		if type(def.Reward) ~= "table" then
			err(p .. ".Reward", "Tabelle erwartet")
		else
			for key, value in pairs(def.Reward) do
				if key == "Title" then
					if type(value) ~= "string" or string.sub(value, 1, 3) ~= "TT_" then
						err(p .. ".Reward.Title", '"TT_…" erwartet')
					end
				elseif key ~= "Coins" and key ~= "Gems" then
					err(p .. ".Reward." .. tostring(key), "nur Coins, Gems, Title erlaubt")
				else
					num(p .. ".Reward." .. tostring(key), value, 0)
				end
			end
		end
	end
	if count ~= 12 then
		err("Achievements", "12 Erfolge erwartet (B16.5)")
	end

	numbers("Mmr", Progression.Mmr, 0)
	numbers("Bounty", Progression.Bounty, 0)
	numbers("Comeback", Progression.Comeback, 0)
	num("Crown.DefenceCoinsHuman", Progression.Crown.DefenceCoinsHuman, 0)
	num("Crown.DefenceCoinsBot", Progression.Crown.DefenceCoinsBot, 0)
	num("Honor.CommendDailyCap", Progression.Honor.CommendDailyCap, 0, true)
	numbers("GG", Progression.GG, 0)

	for code, def in pairs(Progression.Codes) do
		local p = "Codes." .. tostring(code)
		if type(code) ~= "string" or #code > 20 or string.upper(code) ~= code or string.find(code, "[^%w_%-]") then
			err(p, "Code muss aus GROSSBUCHSTABEN/Ziffern bestehen (≤ 20 Zeichen)")
		end
		grant(p .. ".Grant", def.Grant)
		if def.Expires ~= nil then
			local y, mo, d = string.match(tostring(def.Expires), "^(%d%d%d%d)%-(%d%d)%-(%d%d)")
			if not (y and mo and d) then
				err(p .. ".Expires", 'Datum "YYYY-MM-DDTHH:MM:SSZ" erwartet')
			end
		end
	end

	local boards: { [string]: boolean } = {}
	for _, name in ipairs(Progression.Leaderboards) do
		boards[name] = true
	end
	for _, name in ipairs({ "Wins", "Elims", "BestStreak", "TotalXP", "WeeklyWins", "CrownBest" }) do
		if not boards[name] then
			err("Leaderboards", "Tafel " .. name .. " fehlt (B16.9)")
		end
	end
	for word, text in pairs(Progression.Chat.Rewrites) do
		if type(word) ~= "string" or string.lower(word) ~= word or string.find(word, "[^%w]") then
			err("Chat.Rewrites." .. tostring(word), "ein kleingeschriebenes Wort erwartet")
		end
		if type(text) ~= "table" or type(text.de) ~= "string" or type(text.en) ~= "string" then
			err("Chat.Rewrites." .. tostring(word), "{ de, en } erwartet")
		end
	end

	-- Quer-Prüfung gegen andere Config-Teile (nur wenn geladen)
	local weapons = Config and Config.Weapons and Config.Weapons.List
	if type(weapons) == "table" and #weapons > 0 then
		local known: { [string]: boolean } = {}
		for _, def in ipairs(weapons) do
			if type(def) == "table" and type(def.Key) == "string" then
				known[def.Key] = true
			end
		end
		for _, key in ipairs(q.SmgShotgunWeapons) do
			if not known[key] then
				err("Quests.SmgShotgunWeapons", "unbekannte Waffe " .. tostring(key))
			end
		end
	end
	local maps = Config and Config.Maps and Config.Maps.Maps
	if type(maps) == "table" and next(maps) ~= nil then
		for _, def in ipairs(q.Daily) do
			if def.Filter and def.Filter.Map and maps[def.Filter.Map] == nil then
				err("Quests.Daily." .. def.Id .. ".Filter.Map", "unbekannte Map " .. tostring(def.Filter.Map))
			end
		end
	end
	return errors
end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Season</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – CLUTCH PASS / SAISONS (Config.Season)
--  Besitzer: WP8 (Fortschritt). Vertrag: DESIGN.md C15 + B21.2.
--
--  So legst du eine NEUE SAISON an (Anleitung, Abschnitt "Neue Saison"):
--    1. Den kompletten Block { Id = 1, … } unten kopieren und hinter die letzte Saison setzen.
--    2. Id um 1 erhöhen – eine Id wird NIE wiederverwendet (sonst gelten alte Einlösungen weiter).
--    3. StartUtc/EndUtc anpassen (UTC, Format "JJJJ-MM-TTT00:00:00Z"), Name, Farben, Belohnungen.
--    4. Play drücken und im Output auf "[SelfTest]"- bzw. "[Config]"-Meldungen achten.
--  Fallback (das Spiel funktioniert immer): Passt kein Datumsfenster, bleibt die Saison mit dem
--  jüngsten StartUtc ≤ jetzt aktiv; liegt jetzt vor der ersten Saison, ist Saison 1 aktiv.
--
--  Belohnungs-Felder je Stufe ("<Stufe>" als Text-Schlüssel):
--    Coins, Gems, Keys, Shards = Anzahl · Cosmetic = Kosmetik-Id (Skin/Wrap/Charm/Finisher/Tracer/Titel "TT_…")
--  Gratis-Spur: jede 2. Stufe. Premium-Spur: jede Stufe, NIE Coins oder Schlüssel (kein Pay-to-Win).
-- =====================================================================

local Season = {}

Season.Seasons = {
	{
		Id = 1,
		Name = { de = "Saison 1: Neon-Start", en = "Season 1: Neon Start" },
		StartUtc = "2026-10-15T00:00:00Z",
		EndUtc = "2026-12-10T00:00:00Z",
		Tiers = 30,
		TierXp = 3000,
		Theme = { Primary = Color3.fromRGB(255, 60, 170), Accent = Color3.fromRGB(0, 230, 255) },
		Free = {
			["2"] = { Coins = 300 },
			["4"] = { Keys = 1 },
			["6"] = { Coins = 300 },
			["8"] = { Gems = 30 },
			["10"] = { Coins = 300 },
			["12"] = { Keys = 1 },
			["14"] = { Coins = 300 },
			["16"] = { Gems = 30 },
			["18"] = { Coins = 300 },
			["20"] = { Keys = 1 },
			["22"] = { Gems = 30 },
			["24"] = { Gems = 30 },
			["26"] = { Gems = 30 },
			["28"] = { Keys = 1 },
			["30"] = { Cosmetic = "TT_S1Veteran" },
		},
		Premium = {
			["1"] = { Cosmetic = "S_PipPistol_RayGun" },
			["2"] = { Gems = 50 },
			["3"] = { Cosmetic = "W_S1_Neon" },
			["4"] = { Shards = 100 },
			["5"] = { Cosmetic = "C_Ghost" },
			["6"] = { Gems = 50 },
			["7"] = { Cosmetic = "W_S1_Sunset" },
			["8"] = { Shards = 100 },
			["9"] = { Cosmetic = "C_Cactus" },
			["10"] = { Gems = 50 },
			["11"] = { Cosmetic = "W_S1_Ice" },
			["12"] = { Shards = 100 },
			["13"] = { Cosmetic = "F_RainbowPuff" },
			["14"] = { Gems = 50 },
			["15"] = { Cosmetic = "W_S1_Gold" },
			["16"] = { Shards = 100 },
			["17"] = { Cosmetic = "C_Crown" },
			["18"] = { Gems = 50 },
			["19"] = { Cosmetic = "W_S1_Circuit" },
			["20"] = { Cosmetic = "TT_PassHolderS1" },
			["21"] = { Cosmetic = "T_Zigzag" },
			["22"] = { Gems = 50 },
			["23"] = { Cosmetic = "F_BalloonFloat" },
			["24"] = { Shards = 100 },
			["25"] = { Cosmetic = "C_Trophy" },
			["26"] = { Gems = 50 },
			["27"] = { Cosmetic = "W_S1_Champion" },
			["28"] = { Gems = 100 },
			["29"] = { Cosmetic = "T_Rainbow" },
			["30"] = { Cosmetic = "S_PopRifle_CarrotCannon" },
		},
	},
}

-- =====================================================================
-- PRÜFEN (Config.Validate sammelt das)
-- =====================================================================
local REWARD_FIELDS = { Coins = true, Gems = true, Keys = true, Shards = true, Cosmetic = true }

-- "JJJJ-MM-TTTHH:MM:SSZ" -> Sekunden (nur zum Vergleichen; ProgressMath.ParseIsoUtc rechnet genauso)
local function parseIso(text: any): number?
	if type(text) ~= "string" then
		return nil
	end
	local y, mo, d, h, mi, s = string.match(text, "^(%d%d%d%d)%-(%d%d)%-(%d%d)T(%d%d):(%d%d):(%d%d)Z$")
	if not y then
		return nil
	end
	local month = tonumber(mo) :: number
	local day = tonumber(d) :: number
	if month < 1 or month > 12 or day < 1 or day > 31 then
		return nil
	end
	return ((((tonumber(y) :: number) * 12 + month) * 31 + day) * 24 + (tonumber(h) :: number)) * 3600
		+ (tonumber(mi) :: number) * 60
		+ tonumber(s) :: number
end

local function isNumber(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

function Season.Validate(Config: any): { string }
	local errors: { string } = {}
	local function err(path: string, text: string)
		table.insert(errors, "Config.Season." .. path .. ": " .. text)
	end
	if type(Season.Seasons) ~= "table" or #Season.Seasons == 0 then
		err("Seasons", "mindestens eine Saison erwartet")
		return errors
	end
	local ids: { [number]: boolean } = {}
	local cosmetics = Config and Config.Cosmetics
	local function cosmeticKnown(id: string): boolean
		if type(cosmetics) ~= "table" or next(cosmetics) == nil then
			return true -- Kosmetik-Config (WP9) noch nicht da -> nicht prüfen
		end
		for _, group in ipairs({ "Wraps", "Skins", "Charms", "Finishers", "Tracers", "Titles" }) do
			local t = cosmetics[group]
			if type(t) == "table" and t[id] ~= nil then
				return true
			end
		end
		return false
	end
	for index, season in ipairs(Season.Seasons) do
		local p = ("Seasons[%d]"):format(index)
		if not isNumber(season.Id) or season.Id < 1 or season.Id % 1 ~= 0 then
			err(p .. ".Id", "ganze Zahl ≥ 1 erwartet")
		elseif ids[season.Id] then
			err(p .. ".Id", "Saison-Id " .. season.Id .. " doppelt – Ids nie wiederverwenden!")
		else
			ids[season.Id] = true
		end
		if type(season.Name) ~= "table" or type(season.Name.de) ~= "string" or type(season.Name.en) ~= "string" then
			err(p .. ".Name", "{ de, en } erwartet")
		end
		local start, finish = parseIso(season.StartUtc), parseIso(season.EndUtc)
		if not start then
			err(p .. ".StartUtc", 'Datum "JJJJ-MM-TTT00:00:00Z" erwartet')
		end
		if not finish then
			err(p .. ".EndUtc", 'Datum "JJJJ-MM-TTT00:00:00Z" erwartet')
		end
		if start and finish and finish <= start then
			err(p .. ".EndUtc", "muss nach StartUtc liegen")
		end
		if not isNumber(season.Tiers) or season.Tiers < 1 or season.Tiers % 1 ~= 0 then
			err(p .. ".Tiers", "ganze Zahl ≥ 1 erwartet")
		end
		if not isNumber(season.TierXp) or season.TierXp < 1 then
			err(p .. ".TierXp", "Zahl ≥ 1 erwartet")
		end
		if type(season.Theme) ~= "table" or typeof(season.Theme.Primary) ~= "Color3" then
			err(p .. ".Theme.Primary", "Color3 erwartet")
		end
		local tiers = if isNumber(season.Tiers) then season.Tiers else 0
		for _, track in ipairs({ "Free", "Premium" }) do
			local rewards = season[track]
			if type(rewards) ~= "table" then
				err(p .. "." .. track, "Tabelle erwartet")
				continue
			end
			for key, reward in pairs(rewards) do
				local rp = ('%s.%s["%s"]'):format(p, track, tostring(key))
				local tier = tonumber(key)
				if type(key) ~= "string" or tier == nil or tier < 1 or tier > tiers or tier % 1 ~= 0 then
					err(rp, 'Schlüssel muss eine Stufe "1"…"' .. tostring(tiers) .. '" (Text) sein')
				end
				if type(reward) ~= "table" or next(reward) == nil then
					err(rp, "Belohnung erwartet")
					continue
				end
				for field, value in pairs(reward) do
					if not REWARD_FIELDS[field] then
						err(rp .. "." .. tostring(field), "unbekanntes Feld")
					elseif field == "Cosmetic" then
						if type(value) ~= "string" or value == "" then
							err(rp .. ".Cosmetic", "Kosmetik-Id erwartet")
						elseif not cosmeticKnown(value) then
							err(rp .. ".Cosmetic", "unbekannte Kosmetik " .. value .. " (Config.Cosmetics)")
						end
					elseif not isNumber(value) or value <= 0 or value % 1 ~= 0 then
						err(rp .. "." .. field, "ganze Zahl > 0 erwartet")
					end
					if track == "Premium" and (field == "Coins" or field == "Keys") then
						err(rp .. "." .. field, "Premium darf KEINE Coins/Schlüssel geben (B21.2)")
					end
				end
			end
		end
	end
	return errors
end

return Season
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Security</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Sicherheit, Anti-Cheat & Admin-Grenzen (Config.Security)
--  Besitzer: WP7 (Sicherheit, Admin, Live-Balance). Vertrag: DESIGN.md C15 + C12 + B25.
--  Wird an alle Clients repliziert -> KEINE Geheimnisse hier!
--
--  Abschnitte:
--    1) Bewegungs-Prüfung (C12.3)          5 Hz, Weg-Budget, Teleport-Gnade, Höhe, Fliegen
--    2) Verdachtspunkte (C12.4)            Gewichte, Abbau, Prüf-Flag, Kick, Auto-Bann (nur harte Signale)
--    3) Statistik-Prüfung                  Kopf-Quote/Genauigkeit -> nur Prüfliste, NIE Bann
--    4) Spam-Bremsen                       Token-Eimer/Rate-Limits pro Remote
--    5) Moderation & Banns (B25.4)          Melden, Bann-Dauern, Speicher-Grenzen
--    6) Admin-Panel (B25.3)                Text-Längen, Kraft-Grenzen, Events
--  Validate(Config): { string }            prüft alle Zahlen (SelfTest / Boot-warn)
--
--  Zusätzlich zu C15 (nur WP7 liest sie): Weights.Noclip, ImpulseMaxSpeed, ImpulseGrace, FlagsLocalMax,
--  StoreMaxPerKey, StoreWritesPerMinute, StoreReadGap, BanLogMax, BanDisplayMax, BanPrivateMax,
--  Powers (Grenzen der Admin-Kräfte), LobbyGravity, AutoBan.Keep, RateBurstPerMinute, LosBurstPerMinute,
--  FlagCooldown, AnchorRadius, HistoryVersions, MutatorGlobalHours, SkillAirJumps, StallSeconds, StallCredit,
--  MoonVerticalMult, StatsMaxKeys, StatsCacheSeconds.
-- =====================================================================

local Security = {
	-- -----------------------------------------------------------------
	-- 1) BEWEGUNG (C12.3) – Server misst 5x pro Sekunde (gestaffelt)
	-- -----------------------------------------------------------------
	MoveHz = 5,
	BaseAllowedSpeed = 32, -- schnellstes legales Tempo (Rutsch-Start)
	SpeedTolerance = 1.15, -- erlaubtes Tempo = 32 × SpeedMult × 1.15 + 6
	SpeedSlack = 6,
	BucketSeconds = 1.0, -- Weg-Vorrat = so viele Sekunden erlaubtes Tempo
	TeleportGrace = 1.0, -- Sekunden Gnade nach jedem Server-Teleport
	TeleportMaxDist = 40, -- Sprung > 40 Studs ohne Gnade = Teleport-Verstoß (hart)
	VerticalSlack = 3, -- Höhe über letztem Boden ≤ 7.2 × (Luftsprünge + 1) × VerticalMult + 3
	-- Skill-Bewegung (docs/SKILL-WUENSCHE.md) darf NIE Fehlalarm geben: Doppelsprung + Wand-Absprung
	-- zählen immer als 2 erlaubte Luftsprünge (Rutsch-Sprung-Ketten bleiben unter 32 Studs/s, Obergrenze 30).
	SkillAirJumps = 2,
	MoonVerticalMult = 2.5, -- Mutator mit GravityLift (Mondsprung): Vertikal-Toleranz ×2.5 (B7)
	StallSeconds = 0.6, -- so lange keine neue Position = Lag-Hänger (Sprung danach ist kein harter Teleport)
	StallCredit = 1.5, -- nach einem Hänger zählt höchstens so viel Zeit fürs Weg-Budget
	FlyAirSeconds = 3, -- länger in der Luft ohne zu fallen = Fliegen
	FlyAirSecondsMoon = 6, -- Mondsprung-Mutator
	ImpulseMaxSpeed = 95, -- Standard-Höchsttempo während Grace("Impulse"/"Launch")
	ImpulseGrace = 1.5, -- Standard-Dauer, wenn Grace ohne Sekunden kommt
	AnchorRadius = 30, -- während der Teleport-Gnade zählen nur Positionen so nah am Ziel

	-- -----------------------------------------------------------------
	-- 2) VERDACHTSPUNKTE (C12.4) – Abbau 1 Punkt je 30 s
	-- -----------------------------------------------------------------
	Weights = {
		Honeypot = 100, -- hart
		Type = 5, -- kaputtes Paket
		Rate = 1, -- Feuerraten-Verstoß (je)
		RateBurst = 15, -- > 20 Feuerraten-Verstöße pro Minute (hart)
		Origin = 2, -- Schuss-Ursprung zu weit weg
		Los = 1, -- Sichtlinie durch Wand (je)
		LosBurst = 10, -- > 10 pro Minute
		Mismatch = 10, -- Hitbox-Abweichung > 40 % über 30 Behauptungen
		Speed = 2, -- zu schnell
		Teleport = 8, -- Sprung > 40 Studs (hart)
		Fly = 5, -- Fliegen / zu hoch gesprungen
		Noclip = 2, -- durch eine Wand gelaufen
		Stats = 20, -- Statistik (nur Prüfliste, nie Kick/Bann)
	},
	RateBurstPerMinute = 20,
	LosBurstPerMinute = 10,
	DecayEvery = 30, -- Sekunden pro abgebautem Punkt
	Review = 25, -- ab hier: Prüf-Flag (gespeichert)
	Kick = 60, -- ab hier: Kick mit Meldung
	FlagCooldown = 300, -- höchstens ein neues Prüf-Flag pro Spieler in so vielen Sekunden
	AutoBan = {
		Enabled = true,
		HardKicks = 3, -- so viele Kicks wegen HARTER Signale …
		WindowDays = 7, -- … in so vielen Tagen …
		Days = 1, -- … = 1-Tages-Bann (Beweis in PrivateReason)
		Keep = 10, -- so viele Kick-Zeitstempel bleiben im Spielstand (Mod.HardKicks)
	},

	-- -----------------------------------------------------------------
	-- 3) STATISTIK (nur Prüfliste – Statistik bannt NIE automatisch)
	-- -----------------------------------------------------------------
	Stats = {
		MinHits = 60,
		HeadRatio = 0.75,
		Accuracy = 0.70,
		MismatchClaims = 30,
		MismatchRatio = 0.4,
	},

	-- -----------------------------------------------------------------
	-- 4) SPAM-BREMSEN – { Kapazität, Nachfüllung pro s } bzw. { Aufrufe, Sekunden }
	-- -----------------------------------------------------------------
	Buckets = { Fire = { 12, 20 }, WeaponAction = { 12, 12 }, Look = { 20, 20 } },
	Rates = { Request = { 8, 1 }, Admin = { 12, 1 } },

	-- -----------------------------------------------------------------
	-- 5) MODERATION & BANNS (B25.4, C14)
	-- -----------------------------------------------------------------
	ReportLimit = { 3, 600 }, -- 3 Meldungen pro 10 Minuten pro Melder
	BanPresets = { ["1h"] = 3600, ["1d"] = 86400, ["7d"] = 604800, ["30d"] = 2592000, perm = -1 },
	BanDisplayMax = 400, -- Roblox-Grenze DisplayReason
	BanPrivateMax = 1000, -- Roblox-Grenze PrivateReason
	BanLogMax = 100, -- CC_Mod_v1 / BanLog
	FlagsLocalMax = 200, -- Flags/Meldungen im Speicher dieses Servers
	StoreMaxPerKey = 50, -- Flags bzw. Meldungen pro Shard-Schlüssel und Tag
	StoreWritesPerMinute = 6, -- je Art (Flags / Meldungen)
	StoreReadGap = 0.25, -- Sekunden zwischen zwei Lesungen (Admin-Listen/Statistik)

	-- -----------------------------------------------------------------
	-- 6) ADMIN-PANEL (B25.3)
	-- -----------------------------------------------------------------
	AnnounceMax = 200,
	WarnMax = 150,
	AnnounceSeconds = 8,
	AnnounceQueue = 5,
	AdminAbuseMaxMinutes = 60,
	MutatorGlobalHours = 24, -- globaler Mutator-Override gilt so lange
	HistoryVersions = 10, -- Live-Balance: so viele Versionen im Verlauf
	StatsMaxKeys = 64, -- Live-Statistik: höchstens so viele Schlüssel pro Art (Waffen, Maps, Modi …)
	StatsCacheSeconds = 60, -- Admin-Statistik (Shards lesen) so lange zwischenspeichern
	LobbyGravity = { Min = 50, Max = 196.2 },
	Powers = {
		Speed = { Min = 16, Max = 150 }, -- AdminSpeed
		Jump = { Min = 7.2, Max = 100 }, -- AdminJump (JumpHeight)
		RapidFire = { Min = 1, Max = 5 }, -- AdminRapidFire (Faktor)
		FlySpeed = 70, -- Fliegen (Taste G), Shift = ×2
	},
}

-- ---------------------------------------------------------------------
-- PRÜFEN (Config.Validate sammelt das) – leere Liste = alles ok
-- ---------------------------------------------------------------------
local function isNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function Security.Validate(_config: any): { string }
	local errors: { string } = {}
	local function positive(path: string, value: any)
		if not isNumber(value) or value <= 0 then
			table.insert(errors, path .. ": Zahl > 0 erwartet")
		end
	end
	local function pair(path: string, value: any)
		if type(value) ~= "table" or not isNumber(value[1]) or not isNumber(value[2]) or value[1] <= 0 then
			table.insert(errors, path .. ": { Zahl, Zahl } erwartet")
		end
	end
	local function range(path: string, value: any)
		if type(value) ~= "table" or not isNumber(value.Min) or not isNumber(value.Max) or value.Min > value.Max then
			table.insert(errors, path .. ": { Min, Max } mit Min ≤ Max erwartet")
		end
	end

	for _, key in ipairs({
		"MoveHz",
		"BaseAllowedSpeed",
		"SpeedTolerance",
		"BucketSeconds",
		"TeleportGrace",
		"TeleportMaxDist",
		"FlyAirSeconds",
		"FlyAirSecondsMoon",
		"ImpulseMaxSpeed",
		"ImpulseGrace",
		"AnchorRadius",
		"DecayEvery",
		"Review",
		"Kick",
		"FlagCooldown",
		"RateBurstPerMinute",
		"LosBurstPerMinute",
		"BanDisplayMax",
		"BanPrivateMax",
		"BanLogMax",
		"FlagsLocalMax",
		"StoreMaxPerKey",
		"StoreWritesPerMinute",
		"StoreReadGap",
		"AnnounceMax",
		"WarnMax",
		"AnnounceSeconds",
		"AnnounceQueue",
		"AdminAbuseMaxMinutes",
		"MutatorGlobalHours",
		"HistoryVersions",
		"MoonVerticalMult",
		"StallSeconds",
		"StallCredit",
		"StatsMaxKeys",
		"StatsCacheSeconds",
	}) do
		positive("Config.Security." .. key, (Security :: any)[key])
	end
	if not isNumber(Security.SpeedSlack) or Security.SpeedSlack < 0 then
		table.insert(errors, "Config.Security.SpeedSlack: Zahl ≥ 0 erwartet")
	end
	if not isNumber(Security.SkillAirJumps) or Security.SkillAirJumps < 0 or Security.SkillAirJumps > 5 then
		table.insert(errors, "Config.Security.SkillAirJumps: Zahl 0–5 erwartet")
	end
	if not isNumber(Security.VerticalSlack) or Security.VerticalSlack < 0 then
		table.insert(errors, "Config.Security.VerticalSlack: Zahl ≥ 0 erwartet")
	end
	if isNumber(Security.Review) and isNumber(Security.Kick) and Security.Review >= Security.Kick then
		table.insert(errors, "Config.Security.Review: muss kleiner als Kick sein")
	end
	if Security.BanDisplayMax > 400 or Security.BanPrivateMax > 1000 then
		table.insert(errors, "Config.Security.BanDisplayMax/BanPrivateMax: Roblox-Grenzen 400/1000")
	end
	if Security.StoreMaxPerKey > 50 then
		table.insert(errors, "Config.Security.StoreMaxPerKey: höchstens 50 (C14)")
	end
	for key, value in pairs(Security.Weights) do
		if not isNumber(value) or value < 0 then
			table.insert(errors, "Config.Security.Weights." .. tostring(key) .. ": Zahl ≥ 0 erwartet")
		end
	end
	local auto = Security.AutoBan
	if type(auto.Enabled) ~= "boolean" then
		table.insert(errors, "Config.Security.AutoBan.Enabled: true/false erwartet")
	end
	positive("Config.Security.AutoBan.HardKicks", auto.HardKicks)
	positive("Config.Security.AutoBan.WindowDays", auto.WindowDays)
	positive("Config.Security.AutoBan.Days", auto.Days)
	positive("Config.Security.AutoBan.Keep", auto.Keep)
	if isNumber(auto.Keep) and isNumber(auto.HardKicks) and auto.Keep < auto.HardKicks then
		table.insert(errors, "Config.Security.AutoBan.Keep: muss ≥ HardKicks sein")
	end
	for key, value in pairs(Security.Stats) do
		positive("Config.Security.Stats." .. tostring(key), value)
	end
	for key, value in pairs(Security.Buckets) do
		pair("Config.Security.Buckets." .. tostring(key), value)
	end
	for key, value in pairs(Security.Rates) do
		pair("Config.Security.Rates." .. tostring(key), value)
	end
	pair("Config.Security.ReportLimit", Security.ReportLimit)
	for key, value in pairs(Security.BanPresets) do
		if not isNumber(value) or (value ~= -1 and value < 60) then
			table.insert(errors, "Config.Security.BanPresets." .. tostring(key) .. ": Sekunden ≥ 60 oder -1 erwartet")
		end
	end
	range("Config.Security.LobbyGravity", Security.LobbyGravity)
	range("Config.Security.Powers.Speed", Security.Powers.Speed)
	range("Config.Security.Powers.Jump", Security.Powers.Jump)
	range("Config.Security.Powers.RapidFire", Security.Powers.RapidFire)
	positive("Config.Security.Powers.FlySpeed", Security.Powers.FlySpeed)
	return errors
end

return Security
]]></string>
          </Properties>
        </Item>
