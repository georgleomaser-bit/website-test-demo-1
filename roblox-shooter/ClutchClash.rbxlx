			Parent = cell,
		})
		table.insert(
			slotCells,
			{ Frame = cell, Name = name, Key = key, Charges = charges, Stroke = stroke, Scale = scale }
		)
	end
	slotPanel = slots
end

-- Geräte-Layout: Touch -> Leben/Munition oben (unten liegen Stick und Feuerknopf), keine Slot-Leiste
local function layoutPanels()
	local touch = inputKind() == "Touch"
	local hp, ammo, slots = hpPanel, ammoPanel, slotPanel
	if hp then
		hp.AnchorPoint = if touch then Vector2.new(0, 0) else Vector2.new(0, 1)
		hp.Position = if touch then UDim2.fromOffset(16, 8) else UDim2.new(0, 18, 1, -16)
	end
	if ammo then
		ammo.Visible = not touch -- Touch: Munition steht am FEUER-Knopf
	end
	if slots then
		slots.Visible = not touch
	end
	-- Tasten-Hinweise in der Slot-Leiste je Gerät
	local keyTexts = if inputKind() == "Gamepad" then { "Y", "Y", "LB", "RB" } else { "1", "2", "3", "4" }
	for i, cell in ipairs(slotCells) do
		cell.Key.Text = keyTexts[i]
	end
	lastAmmoKey = ""
end

function CombatHud.SetHp(hp: number, max: number)
	if type(hp) ~= "number" or hp ~= hp then
		return
	end
	hpMax = if type(max) == "number" and max > 0 then max else hpMax
	hpNow = math.clamp(hp, 0, hpMax)
	local shownHp = math.ceil(hpNow)
	local key = shownHp .. "/" .. hpMax
	if key == lastHpKey then
		return
	end
	lastHpKey = key
	local ratio = hpNow / hpMax
	if hpText then
		hpText.Text = "❤ " .. tostring(shownHp)
		hpText.TextColor3 = if hpNow <= HUD.LowHp then RED else WHITE
	end
	local fill = hpFill
	if fill then
		fill.Size = UDim2.fromScale(ratio, 1)
		fill.BackgroundColor3 = if ratio > 0.6 then Theme.Green elseif ratio > 0.3 then Theme.Yellow else RED
	end
end

local function reloadKeyText(): string
	local kind = inputKind()
	if kind == "Gamepad" then
		return "X"
	elseif kind == "Touch" then
		return T("ui.touch.reload")
	end
	local config = ctx and ctx.Config
	local keys = config and config.Client and config.Client.Keys
	local list = keys and keys.Reload
	return if type(list) == "table" and type(list[1]) == "string" then list[1] else "R"
end

function CombatHud.SetAmmo(mag: number, max: number, reloading: boolean, reloadProgress: number?)
	if type(mag) ~= "number" or type(max) ~= "number" then
		return
	end
	local touch = module("TouchControls")
	if touch and type(touch.SetAmmo) == "function" then
		pcall(touch.SetAmmo, mag, max, reloading, reloadProgress)
	end
	local m = math.max(0, math.floor(mag))
	local mx = math.max(0, math.floor(max))
	local progress = if reloading and type(reloadProgress) == "number"
		then math.clamp(reloadProgress, 0, 1)
		else if reloading then 0 else -1
	local key = ("%d/%d/%s/%d"):format(m, mx, tostring(reloading), math.floor(progress * 50))
	if key == lastAmmoKey then
		return
	end
	lastAmmoKey = key
	-- wenig Munition: doppelter Tick pro Schuss
	if mx > 0 and m < ammoMag and m > 0 and m / mx <= HUD.LowAmmo and not reloading then
		sfx("LowAmmo")
	end
	if m == 0 and ammoMag > 0 and not reloading then
		ammoShake = 0.45
	end
	ammoMag = m
	local unlimited = mx <= 0 -- Nahkampf/Utility ohne Magazin
	if ammoText then
		ammoText.Text = if unlimited then "∞" else tostring(m)
		ammoText.TextColor3 = if unlimited
			then WHITE
			elseif m == 0 then RED
			elseif m / mx <= HUD.LowAmmo then Theme.Orange
			else WHITE
	end
	if ammoMaxText then
		ammoMaxText.Text = if unlimited then "" else "/ " .. tostring(mx)
	end
	local back = reloadBack
	if back then
		back.Visible = reloading
		if reloadFill and reloading then
			reloadFill.Size = UDim2.fromScale(math.max(0, progress), 1)
		end
	end
	local hint = reloadHint
	if hint then
		local show = not unlimited and not reloading and m == 0
		hint.Visible = show
		if show then
			hint.Text = T("ui.reloadHint", reloadKeyText())
		end
	end
end

function CombatHud.SetSpread(deg: number)
	if type(deg) ~= "number" or deg ~= deg then
		return
	end
	spreadDeg = math.max(0, deg)
	local px = math.floor(spreadToPixels(spreadDeg) * 2 + 0.5) / 2
	if px ~= spreadPx then
		spreadPx = px
		refreshCrosshair()
	end
end

local function weaponShort(key: string?): string
	if type(key) ~= "string" or key == "" then
		return "–"
	end
	local config = ctx and ctx.Config
	if config and type(config.Weapon) == "function" then
		local ok, def = pcall(config.Weapon, key)
		if ok and type(def) == "table" then
			if type(def.Short) == "string" and def.Short ~= "" then
				return def.Short
			end
			if type(def.Name) == "table" then
				local okName, text = pcall(ctx.Lang.Pick, ctx.Lang_(), def.Name)
				if okName and type(text) == "string" then
					return text
				end
			end
		end
	end
	return key
end

function CombatHud.SetSlots(loadout: { [string]: string }, equipped: string, charges: { [string]: number })
	if type(loadout) == "table" then
		slotLoadout = loadout
	end
	if type(equipped) == "string" then
		slotEquipped = equipped
	end
	if type(charges) == "table" then
		slotCharges = charges
	end
	local parts: { string } = {}
	for _, name in ipairs(SLOT_NAMES) do
		table.insert(parts, tostring(slotLoadout[name]) .. ":" .. tostring(slotCharges[name]))
	end
	local key = table.concat(parts, ",") .. "|" .. slotEquipped
	if key ~= lastSlotsKey then
		lastSlotsKey = key
		for i, name in ipairs(SLOT_NAMES) do
			local cell = slotCells[i]
			if cell then
				local weapon = slotLoadout[name]
				cell.Name.Text = weaponShort(weapon)
				local charge = slotCharges[name]
				cell.Charges.Text = if type(charge) == "number" and name == "Utility" then "x" .. charge else ""
				local active = name == slotEquipped
				cell.Stroke.Color = if active then YELLOW else BLACK
				cell.Stroke.Thickness = if active then 3 else 2
				cell.Frame.BackgroundTransparency = if active then 0.1 else 0.45
				cell.Scale.Scale = if active then 1.08 else 1
			end
		end
	end
	local touch = module("TouchControls")
	if touch and type(touch.SetSlots) == "function" then
		pcall(touch.SetSlots, slotLoadout, slotEquipped, slotCharges)
	end
end

-- ---------------------------------------------------------------------
-- SICHTBARKEIT
-- ---------------------------------------------------------------------
local function applyShown()
	local visible = shown and not popped
	if combatGui then
		combatGui.Enabled = shown
	end
	if crosshair then
		crosshair.Root.Visible = visible
	end
	if hudRoot then
		hudRoot.Visible = visible
	end
	if not shown then
		for _, arrow in ipairs(arrows) do
			arrow.Active = false
			arrow.Image.Visible = false
		end
	end
end

function CombatHud.Show(on: boolean)
	shown = on == true
	applyShown()
end

-- ---------------------------------------------------------------------
-- GEGNER-UMRISSE (Highlights, Occluded, nur Umriss, Farbe aus den Einstellungen)
-- ---------------------------------------------------------------------
local myId = player.UserId
local myTeam = 0
local myCtx: string? = nil
local matchMode: string? = nil
local roster: { [number]: { Name: string, Team: number, IsBot: boolean } } = {}
local enemyHandles: { [number]: any } = {}
local modelCache: { [number]: Model } = {}
local armedMap: Instance? = nil -- Map des Kontexts aus "Armed" (für Puppen ohne Tag)
local lastScan = 0
local SCAN_GAP = 5

local function enemyColor(): Color3
	local config = ctx and ctx.Config
	local colors = config and config.Colors and config.Colors.Enemy
	local name = settings().EnemyColor
	local color = type(colors) == "table" and colors[name] or nil
	return if typeof(color) == "Color3" then color else RED
end

-- Combatant-Modell zu einer Id (Spieler, Bot mit Tag "Bot", Puppe) – gecacht, Suche gedrosselt
local function scanModels()
	local now = os.clock()
	if now - lastScan < SCAN_GAP then
		return
	end
	lastScan = now
	for _, tag in ipairs({ "Bot", "Dummy", "Combatant" }) do
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			local id = inst:GetAttribute("CombatantId")
			if inst:IsA("Model") and type(id) == "number" then
				modelCache[id] = inst
			end
		end
	end
	-- Range-Puppen ohne Tag: in der Map des Kontexts suchen (begrenzt, höchstens alle 5 s)
	local map = armedMap
	if map and map.Parent then
		local checked = 0
		for _, inst in ipairs(map:GetDescendants()) do
			checked += 1
			if checked > 4000 then
				break
			end
			if inst:IsA("Model") then
				local id = inst:GetAttribute("CombatantId")
				if type(id) == "number" then
					modelCache[id] = inst
				end
			end
		end
	end
end

local function modelOf(id: number): Model?
	local cached = modelCache[id]
	if cached and cached.Parent and cached:GetAttribute("CombatantId") == id then
		return cached
	end
	modelCache[id] = nil
	local target = Players:GetPlayerByUserId(id)
	if target and target.Character then
		modelCache[id] = target.Character
		return target.Character
	end
	scanModels()
	local found = modelCache[id]
	if found and found.Parent then
		return found
	end
	return nil
end

local function nameOf(id: number): string
	local entry = roster[id]
	if entry then
		return entry.Name
	end
	local target = Players:GetPlayerByUserId(id)
	if target then
		return target.DisplayName
	end
	local model = modelOf(id)
	if model then
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.DisplayName ~= "" then
			return humanoid.DisplayName
		end
		return model.Name
	end
	return "?"
end

local function releaseEnemies()
	local highlights = module("Highlights")
	if highlights and type(highlights.ReleaseOwner) == "function" then
		pcall(highlights.ReleaseOwner, "Enemy")
	end
	table.clear(enemyHandles)
end

local function isEnemy(id: number): boolean
	if id == myId then
		return false
	end
	local entry = roster[id]
	if not entry then
		return false
	end
	return matchMode == "FFA" or entry.Team ~= myTeam
end

local function refreshEnemies()
	local highlights = module("Highlights")
	if not highlights or type(highlights.Acquire) ~= "function" then
		return
	end
	if not myCtx or string.sub(myCtx, 1, 1) ~= "M" then
		if next(enemyHandles) then
			releaseEnemies()
		end
		return
	end
	local color = enemyColor()
	for id in pairs(roster) do
		local handle = enemyHandles[id]
		local model = if isEnemy(id) then modelOf(id) else nil
		local alive = model ~= nil and model:GetAttribute("Alive") ~= false
		if model and alive then
			local ok, newHandle = pcall(highlights.Acquire, "Enemy", model, {
				Outline = color,
				FillTransparency = 1,
				Depth = Enum.HighlightDepthMode.Occluded,
			})
			enemyHandles[id] = if ok then newHandle else nil
		elseif handle then
			pcall(highlights.Release, handle)
			enemyHandles[id] = nil
		end
	end
	for id, handle in pairs(enemyHandles) do
		if not roster[id] then
			pcall(highlights.Release, handle)
			enemyHandles[id] = nil
		end
	end
end

-- ---------------------------------------------------------------------
-- SERVER-EREIGNISSE
-- ---------------------------------------------------------------------
local function targetPos(id: number, head: boolean): Vector3?
	local model = modelOf(id)
	if not model then
		return nil
	end
	local part = model:FindFirstChild(if head then "Head" else "HumanoidRootPart")
	if part and part:IsA("BasePart") then
		return part.Position + Vector3.new(0, if head then 1.2 else 1.4, 0)
	end
	local ok, pivot = pcall(model.GetPivot, model)
	return if ok then pivot.Position + Vector3.new(0, 2.5, 0) else nil
end

local function onHit(data: any)
	if type(data) ~= "table" then
		return
	end
	local head = data.H == true
	local killed = data.K == true
	CombatHud.Hitmarker(if head then "Head" else "Body", killed, false)
	local id = tonumber(data.T)
	local damage = tonumber(data.D) or 0
	if id then
		local pos = targetPos(id, head)
		if pos then
			showDamage("t" .. tostring(id), pos, damage, head)
			local fx = module("CombatFX")
			if head and fx and type(fx.Impact) == "function" then
				pcall(fx.Impact, pos - Vector3.new(0, 1, 0), nil, "Head") -- Sterne am Ziel (B14.1)
			end
		end
		if killed then
			CombatHud.KillBanner(nameOf(id))
		end
	end
end

local function onHurt(data: any)
	if type(data) ~= "table" then
		return
	end
	if type(data.Hp) == "number" then
		CombatHud.SetHp(data.Hp, hpMax)
	end
	local from = data.F
	if typeof(from) == "Vector3" then
		CombatHud.Hurt(from, tonumber(data.D) or 0)
	else
		hurtFlash = math.max(hurtFlash, 0.5)
	end
end

local function onArmed(info: any)
	if type(info) ~= "table" then
		return
	end
	myId = tonumber(info.Id) or player.UserId
	myTeam = tonumber(info.Team) or myTeam
	myCtx = if type(info.Ctx) == "string" then info.Ctx else nil
	armedMap = if typeof(info.Map) == "Instance" then info.Map else nil
	lastScan = 0
	popped = false
	table.clear(killTimes)
	local config = ctx.Config
	local maxHp = config and config.Player and tonumber(config.Player.MaxHp) or 100
	lastHpKey = ""
	CombatHud.SetHp(maxHp, maxHp)
	if type(info.Loadout) == "table" then
		local charges: { [string]: number } = {}
		if type(info.Ammo) == "table" then
			for slot, ammo in pairs(info.Ammo) do
				if type(slot) == "string" and type(ammo) == "table" and type(ammo.Charges) == "number" then
					charges[slot] = ammo.Charges
				end
			end
		end
		CombatHud.SetSlots(info.Loadout, "Primary", charges)
	end
	CombatHud.Show(true)
	refreshEnemies()
end

local function onMatchStart(data: any)
	if type(data) ~= "table" then
		return
	end
	table.clear(roster)
	myTeam = tonumber(data.MyTeam) or myTeam
	matchMode = if type(data.Mode) == "string" then data.Mode else nil
	if type(data.Roster) == "table" then
		local count = 0
		for _, entry in ipairs(data.Roster) do
			count += 1
			if count > 32 then
				break
			end
			if type(entry) == "table" and type(entry.Id) == "number" then
				roster[entry.Id] = {
					Name = string.sub(tostring(entry.Name or "?"), 1, 32),
					Team = tonumber(entry.Team) or 0,
					IsBot = entry.IsBot == true,
				}
			end
		end
	end
	refreshEnemies()
end

-- ---------------------------------------------------------------------
-- VORSCHAU (Einstellungen-Fenster)
-- ---------------------------------------------------------------------
function CombatHud.MakePreview(parent: GuiObject): Frame
	local holder = frame({
		Name = "CrosshairPreview",
		Size = UDim2.new(1, 0, 0, 90),
		BackgroundColor3 = Color3.fromRGB(70, 90, 110),
		Parent = parent,
	})
	UI.Create("UICorner", { CornerRadius = UDim.new(0, 12), Parent = holder })
	UI.Create("UIStroke", { Thickness = 2, Color = BLACK, Parent = holder })
	UI.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(140, 190, 230), Color3.fromRGB(90, 120, 90)),
		Parent = holder,
	})
	local c = buildCrosshair(holder, 3)
	table.insert(previews, c)
	-- aufgeräumte Vorschauen aus der Liste nehmen
	for i = #previews, 1, -1 do
		if previews[i].Root.Parent == nil then
			table.remove(previews, i)
		end
	end
	applyCrosshair(c, settings().Crosshair, 0)
	return holder
end

-- ---------------------------------------------------------------------
-- FRAME / TICK / START
-- ---------------------------------------------------------------------
function CombatHud.Frame(dt: number)
	stepMarker(dt)
	stepDamage(dt)
	stepHurt(dt)
	stepBanners()
	if ammoShake > 0 and ammoText then
		ammoShake = math.max(0, ammoShake - dt)
		local offset = if ammoShake > 0 then math.sin(ammoShake * 70) * 6 * (ammoShake / 0.45) else 0
		ammoText.Position = UDim2.new(1, -78 + offset, 0, 0)
	end
end

function CombatHud.Tick()
	if shown then
		refreshEnemies()
	end
end

function CombatHud.Init(context: any)
	ctx = context
	local config = ctx.Config
	local hudConfig = config and config.Client and config.Client.Hud
	if type(hudConfig) == "table" then
		for key, value in pairs(hudConfig) do
			if type(value) == "number" and HUD[key] ~= nil then
				HUD[key] = value
			end
		end
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "ClutchClashCombat"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true -- Fadenkreuz exakt in der Bildmitte
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 0
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")
	combatGui = gui
	buildHurt(gui)
	crosshair = buildCrosshair(gui, 4)
	buildMarker(gui)
	buildBanners(gui)

	local panels: Frame = frame({
		Name = "CombatHud",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = ctx.Gui,
	})
	hudRoot = panels
	buildPanels(panels)
	local pools = config and config.Client and config.Client.Pools
	local damageSize = pools and tonumber(pools.DamageNumbers) or 24
	buildDamagePool(math.clamp(math.floor(damageSize), 4, 64))
	layoutPanels()
	refreshCrosshair()

	local hooks = ctx.Hooks
	hooks.On("Combat:Hit", onHit)
	hooks.On("Combat:Hurt", onHurt)
	hooks.On("Combat:Heal", function(data)
		if type(data) == "table" and type(data.Hp) == "number" then
			CombatHud.SetHp(data.Hp, hpMax)
		end
	end)
	hooks.On("Armed", onArmed)
	hooks.On("Disarmed", function()
		myCtx = nil
		armedMap = nil
		table.clear(modelCache)
		popped = false
		releaseEnemies()
		CombatHud.Show(false)
	end)
	hooks.On("Match:Start", onMatchStart)
	hooks.On("Match:Elim", function(data)
		local victim = type(data) == "table" and tonumber(data.V) or nil
		if victim and enemyHandles[victim] then
			local highlights = module("Highlights")
			if highlights then
				pcall(highlights.Release, enemyHandles[victim])
			end
			enemyHandles[victim] = nil
		end
	end)
	hooks.On("Match:Prep", refreshEnemies)
	hooks.On("Match:Live", refreshEnemies)
	hooks.On("Match:AntiCamp", function()
		local highlights = module("Highlights")
		local combat = config and config.Combat
		local seconds = combat and combat.AntiCamp and tonumber(combat.AntiCamp.Show) or 1
		if highlights and type(highlights.Pulse) == "function" then
			pcall(highlights.Pulse, "Enemy", seconds)
		end
	end)
	hooks.On("Match:Left", function(data)
		local id = type(data) == "table" and tonumber(data.Id) or nil
		if id then
			roster[id] = nil
			refreshEnemies()
		end
	end)
	hooks.On("Match:Closed", function()
		table.clear(roster)
		matchMode = nil
		releaseEnemies()
	end)
	hooks.On("Equip", function(slot)
		local name = if type(slot) == "number" then SLOT_NAMES[slot] else slot
		if type(name) == "string" then
			CombatHud.SetSlots(slotLoadout, name, slotCharges)
		end
	end)
	hooks.On("LocalPopped", function()
		popped = true
		applyShown()
	end)
	hooks.On("LocalRevived", function()
		popped = false
		applyShown()
		refreshEnemies()
	end)
	hooks.On("Settings", function()
		refreshCrosshair()
		local color = enemyColor()
		local highlights = module("Highlights")
		if highlights and type(highlights.Update) == "function" then
			for _, handle in pairs(enemyHandles) do
				pcall(highlights.Update, handle, { Outline = color, FillTransparency = 1 })
			end
		end
	end)
	hooks.On("Input", layoutPanels)
	-- Spieler weg: keine Verweise auf alte Characters behalten
	Players.PlayerRemoving:Connect(function(leaving: Player)
		modelCache[leaving.UserId] = nil
		local handle = enemyHandles[leaving.UserId]
		local highlights = module("Highlights")
		if handle and highlights then
			pcall(highlights.Release, handle)
		end
		enemyHandles[leaving.UserId] = nil
	end)
	hooks.On("PhotoMode", function(on)
		photoHidden = on == true
		if photoHidden then
			for _, e in ipairs(damagePool) do
				e.Active = false
				e.Gui.Enabled = false
			end
		end
	end)
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			spreadPx = -1
			CombatHud.SetSpread(spreadDeg)
		end)
	end
end

function CombatHud.Start()
	applyShown()
	if damageAnchor and damageAnchor.Parent == nil then
		damageAnchor.Parent = workspace
	end
end

return CombatHud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">Controls</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Eingabe-Belegung über ContextActionService (Client/Modules/Controls)
--  Besitzer: WP10 (Client-Hülle). Vertrag: DESIGN.md C7.4, B15.1.
--
--  Alle Tasten/Knöpfe aus Config.Client.Keys (PC) und Config.Client.Gamepad laufen über
--  ContextActionService:BindActionAtPriority (createTouchButton = false). Eigene Touch-Knöpfe
--  (Modul TouchControls) speisen dieselben Aktionen über Controls.Emit ein. Andere Module hören
--  NUR hier zu – egal ob Maus, Controller oder Touch.
--
--  Öffentliche API:
--    Controls.Bind(action, fn(state, input?), priority?): () -> ()    state "Begin" | "End" | "Change"
--    Controls.IsDown(action): boolean
--    Controls.Input(): "KBM" | "Gamepad" | "Touch"                    folgt UserInputService.PreferredInput (live)
--    Controls.SetContext(c)   "Lobby" | "Match" | "Range" | "Menu" | "Spectate"
--    Controls.Context(): string                                        wirksamer Kontext (Fenster offen = "Menu")
--    Controls.Emit(action, state, source?)                             virtuelle Eingabe (Touch-Knöpfe)
--    Controls.Init(ctx) / Controls.Start()
--  Aktionen: Fire, Ads, Reload, Slot1..Slot4, NextWeapon, PrevWeapon, LastWeapon, Melee, Utility, Sprint, Slide,
--  Inspect, Scoreboard, Loadout, Menu, Ready, AdminPanel, Fly, SpecNext, SpecPrev (+ Spectate, Debug für Admins).
--  Fenster offen -> Kampf-Eingaben gesperrt (Kontext "Menu"). Hook "Input"(kind) bei jedem Wechsel.
-- =====================================================================

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Controls = {}

type State = "Begin" | "End" | "Change"
type Listener = { Fn: (State, InputObject?) -> (), Priority: number, Order: number, Alive: boolean }

local ACTIONS = {
	"Fire",
	"Ads",
	"Reload",
	"Slot1",
	"Slot2",
	"Slot3",
	"Slot4",
	"NextWeapon",
	"PrevWeapon",
	"LastWeapon",
	"Melee",
	"Utility",
	"Sprint",
	"Slide",
	"Inspect",
	"Scoreboard",
	"Loadout",
	"Menu",
	"Ready",
	"AdminPanel",
	"Fly",
	"SpecNext",
	"SpecPrev",
	"Spectate",
	"Debug",
}

local function set(list: { string }): { [string]: boolean }
	local result: { [string]: boolean } = {}
	for _, name in ipairs(list) do
		result[name] = true
	end
	return result
end

-- Welche Aktionen in welchem Kontext wirken (alles andere wird an Roblox weitergereicht)
local ALWAYS = { "Menu", "AdminPanel", "Fly", "Spectate", "Debug" }
local COMBAT = {
	"Fire",
	"Ads",
	"Reload",
	"Slot1",
	"Slot2",
	"Slot3",
	"Slot4",
	"NextWeapon",
	"PrevWeapon",
	"LastWeapon",
	"Melee",
	"Utility",
	"Sprint",
	"Slide",
	"Inspect",
	"Scoreboard",
	"Loadout",
	"Ready",
}
local function withAlways(list: { string }): { [string]: boolean }
	local result = set(list)
	for _, name in ipairs(ALWAYS) do
		result[name] = true
	end
	return result
end

local RANGE = withAlways(COMBAT)
RANGE.Ready = nil -- in der Range gibt es kein "Bereit" -> Start/Enter bleibt "Menü"

local CONTEXT_ACTIONS: { [string]: { [string]: boolean } } = {
	Match = withAlways(COMBAT),
	Range = RANGE,
	Lobby = withAlways({ "Sprint", "Slide", "Loadout" }),
	Spectate = withAlways({ "SpecNext", "SpecPrev", "Scoreboard", "Ready" }),
	Menu = withAlways({}),
}
-- In diesen Kontexten "verschluckt" eine benutzte Taste die Eingabe (z. B. Mausrad zoomt nicht raus)
local SINK_CONTEXTS = { Match = true, Range = true, Spectate = true }

local BASE_PRIORITY = Enum.ContextActionPriority.High.Value
local SLOT_OF_NAME: { [string]: string } = {
	Primary = "Slot1",
	Secondary = "Slot2",
	Melee = "Slot3",
	Utility = "Slot4",
}
local SLOT_OF_NUMBER = { "Slot1", "Slot2", "Slot3", "Slot4" }

local ctx: any = nil
local listeners: { [string]: { Listener } } = {}
local listenerOrder = 0
local held: { [string]: { [string]: boolean } } = {} -- [action][quelle] = true
local downState: { [string]: boolean } = {}
local baseContext = "Lobby"
local lastEffective = "Lobby"
local inputKind: "KBM" | "Gamepad" | "Touch" = "KBM"
local triggerDown: { [string]: boolean } = {} -- "ButtonR2"/"ButtonL2" analog
local currentSlot: string? = nil -- zuletzt ausgerüsteter Slot ("Slot1".."Slot4"), aus Hook "Equip"
local previousSlot: string? = nil
local cycleAt = -math.huge
local cycleRestore: string? = nil

-- ---------------------------------------------------------------------
-- KONTEXT
-- ---------------------------------------------------------------------
local function windowOpen(): boolean
	local ui = ctx and ctx.UI
	if ui and type(ui.IsAnyWindowOpen) == "function" then
		local ok, open = pcall(ui.IsAnyWindowOpen)
		return ok and open == true
	end
	return false
end

function Controls.Context(): string
	if windowOpen() then
		return "Menu"
	end
	return baseContext
end

local function allowed(action: string, context: string?): boolean
	local actions = CONTEXT_ACTIONS[context or Controls.Context()]
	return actions ~= nil and actions[action] == true
end

local function dispatch(action: string, state: State, input: InputObject?)
	local list = listeners[action]
	if not list or #list == 0 then
		return
	end
	local snapshot = table.clone(list)
	for _, entry in ipairs(snapshot) do
		if entry.Alive then
			local ok, err = pcall(entry.Fn, state, input)
			if not ok then
				warn(("[Controls] Fehler in %s-Listener: %s"):format(action, tostring(err)))
			end
		end
	end
end

-- Quelle drückt/lässt los -> Begin/End nur beim Wechsel des Gesamtzustands
local function setHeld(action: string, source: string, down: boolean, input: InputObject?)
	local sources = held[action]
	if not sources then
		sources = {}
		held[action] = sources
	end
	if down then
		sources[source] = true
	else
		sources[source] = nil
	end
	local isDown = next(sources) ~= nil
	if isDown ~= (downState[action] == true) then
		downState[action] = isDown
		dispatch(action, if isDown then "Begin" else "End", input)
	end
end

-- Kontextwechsel: Aktionen, die jetzt gesperrt sind, sauber loslassen (nichts bleibt "hängen")
local function releaseBlocked()
	local effective = Controls.Context()
	if effective == lastEffective then
		return
	end
	lastEffective = effective
	table.clear(triggerDown) -- Abzüge neu bewerten (sonst bleibt ein "gedrückt" hängen)
	for action, isDown in pairs(downState) do
		if isDown and not allowed(action, effective) then
			held[action] = {}
			downState[action] = false
			dispatch(action, "End", nil)
		end
	end
end

function Controls.SetContext(c: string)
	if CONTEXT_ACTIONS[c] == nil then
		warn("[Controls] Unbekannter Kontext: " .. tostring(c))
		return
	end
	baseContext = c
	releaseBlocked()
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH: Bind / IsDown / Emit
-- ---------------------------------------------------------------------
function Controls.Bind(action: string, fn: (State, InputObject?) -> (), priority: number?): () -> ()
	if type(action) ~= "string" or type(fn) ~= "function" then
		warn("[Controls] Bind: Aktion (string) und Funktion erwartet")
		return function() end
	end
	local list = listeners[action]
	if not list then
		list = {}
		listeners[action] = list
	end
	listenerOrder += 1
	local entry: Listener = { Fn = fn, Priority = priority or 0, Order = listenerOrder, Alive = true }
	table.insert(list, entry)
	-- höhere Priorität zuerst, bei Gleichstand der zuerst angemeldete
	table.sort(list, function(a, b)
		if a.Priority ~= b.Priority then
			return a.Priority > b.Priority
		end
		return a.Order < b.Order
	end)
	return function()
		if not entry.Alive then
			return
		end
		entry.Alive = false
		local current = listeners[action]
		if current then
			local index = table.find(current, entry)
			if index then
				table.remove(current, index)
			end
		end
	end
end

function Controls.IsDown(action: string): boolean
	return downState[action] == true
end

function Controls.Input(): "KBM" | "Gamepad" | "Touch"
	return inputKind
end

-- Virtuelle Eingabe (Touch-Knöpfe, automatisches Sprinten am Stick): gleiche Regeln wie echte Tasten
function Controls.Emit(action: string, state: State, source: string?)
	if type(action) ~= "string" then
		return
	end
	local key = "virtual:" .. (source or "touch")
	if state == "Begin" then
		if allowed(action) then
			setHeld(action, key, true, nil)
		end
	elseif state == "End" then
		setHeld(action, key, false, nil)
	elseif state == "Change" and allowed(action) then
		dispatch(action, "Change", nil)
	end
end

-- ---------------------------------------------------------------------
-- CONTEXTACTIONSERVICE
-- ---------------------------------------------------------------------
local function enumFromName(name: string): (Enum.KeyCode | Enum.UserInputType)?
	local key = Enum.KeyCode:FromName(name)
	if key then
		return key
	end
	return Enum.UserInputType:FromName(name)
end

local function sourceOf(input: InputObject): string
	if input.KeyCode.Name ~= "Unknown" then
		return input.KeyCode.Name
	end
	return input.UserInputType.Name
end

local function typingInTextBox(): boolean
	return UserInputService:GetFocusedTextBox() ~= nil
end

local function triggerThreshold(): number
	local config = ctx and ctx.Config
	local pad = config and config.Client and config.Client.Gamepad
	local value = pad and pad.TriggerThreshold
	return if type(value) == "number" then value else 0.4
end

local function handle(action: string, inputState: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
	if typingInTextBox() then
		return Enum.ContextActionResult.Pass
	end
	local context = Controls.Context()
	local source = sourceOf(input)
	local ending = inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel
	if not allowed(action, context) then
		-- gesperrt: evtl. gehaltene Quelle trotzdem loslassen
		if ending then
			triggerDown[source] = nil
			setHeld(action, source, false, input)
		end
		return Enum.ContextActionResult.Pass
	end
	local sink = if SINK_CONTEXTS[context] then Enum.ContextActionResult.Sink else Enum.ContextActionResult.Pass

	-- Mausrad: Waffe weiter/zurück (nur ein kurzer Begin/End-Puls)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		local wheelAction = if input.Position.Z < 0 then "NextWeapon" else "PrevWeapon"
		if allowed(wheelAction, context) then
			dispatch(wheelAction, "Begin", input)
			dispatch(wheelAction, "End", input)
			return sink
		end
		return Enum.ContextActionResult.Pass
	end

	-- Analoge Abzüge: gedrückt ab Position.Z ≥ Schwelle (B15.1)
	if input.KeyCode == Enum.KeyCode.ButtonR2 or input.KeyCode == Enum.KeyCode.ButtonL2 then
		local pressed: boolean
		if ending then
			pressed = false
		elseif inputState == Enum.UserInputState.Begin and input.Position.Z == 0 then
			pressed = true -- digitale Abzüge melden nur Begin/End
		else
			pressed = input.Position.Z >= triggerThreshold()
		end
		if pressed ~= (triggerDown[source] == true) then
			triggerDown[source] = pressed
			setHeld(action, source, pressed, input)
		end
		return sink
	end

	if inputState == Enum.UserInputState.Begin then
		setHeld(action, source, true, input)
	elseif ending then
		setHeld(action, source, false, input)
	elseif inputState == Enum.UserInputState.Change then
		dispatch(action, "Change", input)
	end
	return sink
end

-- Gamepad Y: Primär <-> Sekundär; zweimal schnell = letzte Waffe (relativ zur Waffe VOR dem ersten Tippen)
local function slotNow(): string?
	if currentSlot then
		return currentSlot
	end
	local weapon = ctx and ctx.Modules and ctx.Modules.WeaponClient
	if weapon and type(weapon.Current) == "function" then
		local ok, _key, def = pcall(weapon.Current)
		if ok and type(def) == "table" and type(def.Slot) == "string" then
			return SLOT_OF_NAME[def.Slot]
		end
	end
	return nil
end

local function pulse(action: string, input: InputObject?)
	if allowed(action) then
		dispatch(action, "Begin", input)
		dispatch(action, "End", input)
	end
end

local function handleCycle(_name: string, inputState: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
	if typingInTextBox() then
		return Enum.ContextActionResult.Pass
	end
	local context = Controls.Context()
	if not allowed("Slot1", context) then
		return Enum.ContextActionResult.Pass
	end
	if inputState ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Sink
	end
	local config = ctx and ctx.Config
	local gap = config and config.Client and config.Client.Gamepad and config.Client.Gamepad.DoubleTap or 0.28
	local now = os.clock()
	if now - cycleAt <= gap then
		cycleAt = -math.huge
		local target = cycleRestore
		cycleRestore = nil
		if target and target ~= slotNow() then
			pulse(target, input)
		else
			pulse("LastWeapon", input)
		end
		return Enum.ContextActionResult.Sink
	end
	cycleAt = now
	cycleRestore = previousSlot
	local current = slotNow()
	pulse(if current == "Slot1" then "Slot2" else "Slot1", input)
	return Enum.ContextActionResult.Sink
end

local function bindAll()
	local config = ctx.Config
	local client = config and config.Client or {}
	local keys: { [string]: { string } } = client.Keys or {}
	local pad: { [string]: any } = client.Gamepad or {}
	for index, action in ipairs(ACTIONS) do
		local inputs: { Enum.KeyCode | Enum.UserInputType } = {}
		local seen: { [string]: boolean } = {}
		local function add(name: any)
			if type(name) ~= "string" or seen[name] then
				return
			end
			local value = enumFromName(name)
			if value then
				seen[name] = true
				table.insert(inputs, value)
			end
		end
		for _, name in ipairs(keys[action] or {}) do
			add(name)
		end
		add(pad[action])
		if action == "NextWeapon" and client.WheelSwitch ~= false then
			add("MouseWheel")
		end
		if #inputs > 0 then
			-- Ready vor Menu (Start = Bereit im Match, sonst Menü); spätere Aktionen leicht niedriger
			local priority = BASE_PRIORITY + (#ACTIONS - index)
			if action == "Ready" then
				priority = BASE_PRIORITY + #ACTIONS + 5
			end
			ContextActionService:BindActionAtPriority("CC_" .. action, function(_, state, input)
				return handle(action, state, input)
			end, false, priority, table.unpack(inputs))
		end
	end
	local cycle = pad.Cycle
	local cycleKey = type(cycle) == "string" and Enum.KeyCode:FromName(cycle)
	if cycleKey then
		ContextActionService:BindActionAtPriority("CC_Cycle", handleCycle, false, BASE_PRIORITY, cycleKey)
	end
end

-- ---------------------------------------------------------------------
-- EINGABE-ART (Maus/Tastatur, Controller, Touch) – live
-- ---------------------------------------------------------------------
local function computeInput(): "KBM" | "Gamepad" | "Touch"
	local ok, preferred = pcall(function()
		return UserInputService.PreferredInput
	end)
	if ok and preferred then
		if preferred == Enum.PreferredInput.Touch then
			return "Touch"
		elseif preferred == Enum.PreferredInput.Gamepad or preferred == Enum.PreferredInput.MicroGamepad then
			return "Gamepad"
		end
		return "KBM"
	end
	-- Rückfall (sehr alte Clients): letzte Eingabe
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "Touch"
	elseif string.sub(last.Name, 1, 7) == "Gamepad" then
		return "Gamepad"
	end
	return "KBM"
end

local function updateInput(force: boolean?)
	local kind = computeInput()
	if kind ~= inputKind or force then
		inputKind = kind
		ctx.Hooks.Fire("Input", kind)
	end
end

local function slotFrom(slot: any): string?
	if type(slot) == "number" then
		return SLOT_OF_NUMBER[slot]
	elseif type(slot) == "string" then
		return SLOT_OF_NAME[slot] or (if string.match(slot, "^Slot[1-4]$") then slot else nil)
	end
	return nil
end

function Controls.Init(context: any)
	ctx = context
	inputKind = computeInput()
	local hooks = ctx.Hooks
	-- Standard-Kontexte aus den Spiel-Ereignissen (WeaponClient kann jederzeit SetContext überschreiben)
	local armedCtx: string? = nil
	hooks.On("Armed", function(info)
		armedCtx = type(info) == "table" and info.Ctx or nil
		Controls.SetContext(if armedCtx == "Range" then "Range" else "Match")
	end)
	hooks.On("Disarmed", function()
		armedCtx = nil
		currentSlot, previousSlot = nil, nil
		Controls.SetContext("Lobby")
	end)
	hooks.On("Spectate", function(model)
		if model ~= nil then
			Controls.SetContext("Spectate")
		elseif armedCtx then
			Controls.SetContext(if armedCtx == "Range" then "Range" else "Match")
		end
	end)
	hooks.On("LocalRevived", function()
		if armedCtx then
			Controls.SetContext(if armedCtx == "Range" then "Range" else "Match")
		end
	end)
	hooks.On("Equip", function(slot)
		local name = slotFrom(slot)
		if name and name ~= currentSlot then
			previousSlot = currentSlot
			currentSlot = name
		end
	end)
	hooks.On("WindowOpened", releaseBlocked)
	hooks.On("WindowClosed", releaseBlocked)
end

function Controls.Start()
	bindAll()
	UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(function()
		updateInput(false)
	end)
	-- Rückfall, falls PreferredInput auf einem Gerät nicht wechselt
	UserInputService.LastInputTypeChanged:Connect(function()
		updateInput(false)
	end)
	updateInput(true)
	-- neuer Charakter: nichts darf gedrückt bleiben
	Players.LocalPlayer.CharacterAdded:Connect(function()
		table.clear(triggerDown)
		for action, isDown in pairs(downState) do
			if isDown then
				held[action] = {}
				downState[action] = false
				dispatch(action, "End", nil)
			end
		end
	end)
end

return Controls
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">CrateReveal</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Kisten-Enthüllung (Client/Modules/CrateReveal)
--  Besitzer: WP9 (Wirtschaft, Monetarisierung, Kosmetik). Vertrag: DESIGN.md B20, B23.3, C7.4.
--  EHRLICHE Rolle (2.5 s, jederzeit überspringbar): Das Ergebnis steht schon fest (Server hat gewürfelt).
--  Das Band zeigt nur Zufalls-Füller nach den ECHTEN Gewichten derselben Tabelle (Config.Shop.Crates.S1)
--  und bleibt auf dem Ergebnis stehen – keine absichtlichen Beinahe-Treffer (keine seltenen Items gezielt
--  neben das Ergebnis), kein Abbremsen kurz vor einem Legendary, kein Nachrutschen (B23.3).
--
--  Öffentliche API:
--    CrateReveal.Play(result: { Id, Rarity, Duplicate, Shards })   mehrere Aufrufe werden nacheinander gezeigt
--    CrateReveal.IsPlaying(): boolean
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Lang = require(Shared:WaitForChild("Lang"))

local CrateReveal = {}
local ctx: any = nil
local UI: any = nil

local ROLL_SECONDS = 2.5
local CARD_W, CARD_H, CARD_GAP = 110, 130, 8
local STRIP_CARDS = 40
local RESULT_INDEX = 34
local MAX_QUEUE = 3
local KIND_ICON: { [string]: string } =
	{ Wrap = "🎨", Skin = "🔫", Charm = "🧸", Finisher = "✨", Tracer = "〰️", Title = "🏷️" }

local overlay: Frame? = nil
local playing = false
local queue: { any } = {}
local rng = Random.new()
local skipFn: (() -> ())? = nil

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function lang(): "de" | "en"
	local ok, value = pcall(function()
		return ctx.Lang_()
	end)
	return if ok and value == "de" then "de" else "en"
end

local function t(key: string, ...: any): string
	return Lang.T(lang(), key, ...)
end

local function rarityColor(rarity: any): Color3
	local colors = Config.Colors and Config.Colors.Rarity
	return colors and colors[rarity] or Color3.fromRGB(170, 170, 170)
end

local function itemName(id: string): string
	local def = Config.Cosmetics.ById[id]
	return if def then Lang.Pick(lang(), def.Name) else id
end

local function sfx(role: string)
	local modules = ctx and ctx.Modules
	local s = modules and modules.Sfx
	if s and type(s.Play) == "function" then
		pcall(s.Play, role)
	end
end

local function crate(): any
	return Config.Shop.Crates and Config.Shop.Crates.S1
end

-- Füller nach den echten Gewichten (ehrlich: gleiche Verteilung wie der Server-Wurf)
local function honestFiller(): string
	local items = crate() and crate().Items or {}
	local total = 0
	for _, item in ipairs(items) do
		total += item.Weight
	end
	if total <= 0 then
		return "W_Mint"
	end
	local roll = rng:NextInteger(1, total)
	for _, item in ipairs(items) do
		roll -= item.Weight
		if roll <= 0 then
			return item.Id
		end
	end
	return items[#items].Id
end

local function makeCard(parent: Instance, id: string, order: number, size: UDim2): Frame
	local def = Config.Cosmetics.ById[id]
	local rarity = def and def.Rarity or "Common"
	local color = rarityColor(rarity)
	local card = UI.Create("Frame", {
		Name = "Card",
		Size = size,
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.Corner(12),
		UI.Stroke(Color3.new(0, 0, 0), 3),
		UI.Gradient(color:Lerp(Color3.new(1, 1, 1), 0.25), color:Lerp(Color3.new(0, 0, 0), 0.35)),
	})
	UI.Label({
		Size = UDim2.new(1, 0, 0.5, 0),
		Position = UDim2.fromScale(0, 0.05),
		Text = KIND_ICON[def and def.Kind or "Wrap"] or "🎁",
		MaxText = 42,
		Parent = card,
	})
	UI.Label({
		Size = UDim2.new(1, -8, 0.36, 0),
		Position = UDim2.new(0, 4, 0.58, 0),
		Text = itemName(id),
		TextWrapped = true,
		MaxText = 18,
		Outline = 2,
		Parent = card,
	})
	return card
end

-- ---------------------------------------------------------------------
-- OVERLAY
-- ---------------------------------------------------------------------
local function ensureOverlay(): Frame
	local existing = overlay
	if existing and existing.Parent then
		return existing
	end
	local gui = ctx and ctx.Gui
	local frame = UI.Create("Frame", {
		Name = "CrateReveal",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		Visible = false,
		ZIndex = 60,
		Active = true,
		Parent = gui,
	})
	overlay = frame
	return frame
end

local function clearOverlay(frame: Frame)
	for _, child in ipairs(frame:GetChildren()) do
		child:Destroy()
	end
end

local playNext: () -> ()

local function close()
	local frame = overlay
	if frame then
		clearOverlay(frame)
		frame.Visible = false
	end
	skipFn = nil
	playing = false
	task.defer(playNext)
end

local function showResult(frame: Frame, result: any)
	clearOverlay(frame)
	local id = result.Id
	local rarity = tostring(result.Rarity)
	local color = rarityColor(rarity)
	local panel = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, 420),
		BackgroundTransparency = 1,
		ZIndex = 61,
		Parent = frame,
	})
	local scale = UI.Create("UIScale", { Scale = 0.6, Parent = panel })
	UI.Label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = t("item.rarity." .. rarity),
		TextColor3 = color,
		MaxText = 34,
		Outline = 3,
		ZIndex = 62,
		Parent = panel,
	})
	local card = makeCard(panel, id, 1, UDim2.fromOffset(220, 260))
	card.AnchorPoint = Vector2.new(0.5, 0)
	card.Position = UDim2.new(0.5, 0, 0, 48)
	card.ZIndex = 62
	if rarity == "Mythic" then
		local gradient = card:FindFirstChildOfClass("UIGradient")
		if gradient then
			TweenService:Create(
				gradient,
				TweenInfo.new(1.6, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
				{ Rotation = 360 }
			):Play()
		end
	end
	local def = Config.Cosmetics.ById[id]
	local line = if result.Duplicate
		then t("shop.crate.duplicate", tonumber(result.Shards) or 0)
		else t("shop.crate.new")
	UI.Label({
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 316),
		Text = (if def then t("item.kind." .. def.Kind) .. " · " else "") .. line,
		MaxText = 22,
		Outline = 2,
		ZIndex = 62,
		Parent = panel,
	})
	UI.Button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 356),
		Size = UDim2.fromOffset(180, 50),
		Text = t("shop.ok"),
		Color = UI.Theme.Green,
		ZIndex = 63,
		Parent = panel,
	}, close)
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()
	sfx(if rarity == "Legendary" or rarity == "Mythic" then "Win" else "UIClick")
end

local function roll(result: any)
	local frame = ensureOverlay()
	clearOverlay(frame)
	frame.Visible = true
	local window = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(CARD_W * 5 + CARD_GAP * 4, CARD_H + 24),
		BackgroundColor3 = Color3.fromRGB(28, 32, 64),
		ClipsDescendants = true,
		ZIndex = 61,
		Parent = frame,
	}, { UI.Corner(14), UI.Stroke(Color3.new(0, 0, 0), 4) })
	local strip = UI.Create("Frame", {
		Size = UDim2.fromOffset(STRIP_CARDS * (CARD_W + CARD_GAP), CARD_H),
		Position = UDim2.fromOffset(0, 12),
		BackgroundTransparency = 1,
		ZIndex = 62,
		Parent = window,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, CARD_GAP),
		}),
	})
	for i = 1, STRIP_CARDS do
		local id = if i == RESULT_INDEX then result.Id else honestFiller()
		local card = makeCard(strip, id, i, UDim2.fromOffset(CARD_W, CARD_H))
		card.ZIndex = 62
	end
	-- Mittellinie (zeigt, wo das Ergebnis landet)
	UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.new(0, 4, 1, 0),
		BackgroundColor3 = UI.Theme.Yellow,
		ZIndex = 64,
		Parent = window,
	})
	-- Ziel: Kartenmitte des Ergebnisses unter der Linie, kleiner Zufallsversatz NUR innerhalb der Karte
	local windowWidth = CARD_W * 5 + CARD_GAP * 4
	local cardCenter = (RESULT_INDEX - 1) * (CARD_W + CARD_GAP) + CARD_W / 2
	local jitter = rng:NextNumber(-CARD_W * 0.25, CARD_W * 0.25)
	local targetX = math.floor(windowWidth / 2 - cardCenter + jitter)
	local tweenObj = TweenService:Create(
		strip,
		TweenInfo.new(ROLL_SECONDS, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(targetX, 12) }
	)
	local done = false
	local function reveal()
		if done then
			return
		end
		done = true
		tweenObj:Cancel()
		strip.Position = UDim2.fromOffset(targetX, 12)
		task.delay(0.25, function()
			if overlay == frame and playing then
				showResult(frame, result)
			end
		end)
	end
	skipFn = reveal
	UI.Button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.45, CARD_H / 2 + 30),
		Size = UDim2.fromOffset(200, 46),
		Text = t("shop.crate.skip"),
		Color = UI.Theme.Gray,
		ZIndex = 63,
		Parent = frame,
	}, reveal)
	tweenObj.Completed:Once(function(state: Enum.PlaybackState)
		if state == Enum.PlaybackState.Completed then
			reveal()
		end
	end)
	tweenObj:Play()
	sfx("UIClick")
end

playNext = function()
	if playing or #queue == 0 then
		return
	end
	local result = table.remove(queue, 1)
	playing = true
	local ok, err = pcall(roll, result)
	if not ok then
		warn("[CrateReveal] " .. tostring(err))
		playing = false
		if overlay then
			overlay.Visible = false
		end
		if ctx and type(ctx.Toast) == "function" then
			ctx.Toast(itemName(result.Id), "Success")
		end
	end
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH
-- ---------------------------------------------------------------------
function CrateReveal.Play(result: { Id: string, Rarity: string, Duplicate: boolean, Shards: number })
	if type(result) ~= "table" or type(result.Id) ~= "string" then
		return
	end
	if #queue >= MAX_QUEUE then
		return
	end
	table.insert(queue, result)
	playNext()
end

function CrateReveal.IsPlaying(): boolean
	return playing
end

function CrateReveal.Init(c: any)
	ctx = c
	UI = c.UI
end

function CrateReveal.Start()
	-- Leertaste/Enter/Gamepad-A überspringt die Rolle
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not playing or skipFn == nil then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.Space or key == Enum.KeyCode.Return or key == Enum.KeyCode.ButtonA then
			local fn = skipFn
			if fn then
				fn()
			end
		end
	end)
end

return CrateReveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">DebugOverlay</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Debug-Anzeige F8 (Client/Modules/DebugOverlay)
--  Besitzer: WP7 (Sicherheit, Admin, Live-Balance). Vertrag: DESIGN.md B25.3 (Debug), C18.
--  Nur für den Besitzer (Modul lädt nur bei IsAdmin; der Server prüft "ServerInfo" trotzdem erneut).
--  Zeigt: Server-Heartbeat Ø/max (Scheduler-Statistik) + teuerste Takte, Zustand der Arena-Slots, Bots,
--  Projektile, Spieler, Speicher, Laufzeit, Client-FPS/Ping und den letzten abgelehnten Schuss + Grund
--  (Combat "Reject" kommt für Admins immer). Abfrage 1×/s nur solange sichtbar.
--  Zusätzlich: Hitbox-Anzeige (Admin-Debug "Hitboxen zeigen" = workspace-Attribut DebugShowHitboxes):
--  Kopf-Kugel + Körper-Kasten (analytisch wie B13.2) an allen Combatants in 150 Studs, 10 Hz, ≤ 32 Paare.
--
--  Öffentliche API:
--    DebugOverlay.Toggle()
--    DebugOverlay.Init(ctx) / DebugOverlay.Start()
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local DebugOverlay = {}

local player = Players.LocalPlayer
local ctx: any = nil

local POLL_SECONDS = 1
local HITBOX_HZ = 10
local HITBOX_RANGE = 150
local HITBOX_MAX = 32
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local visible = false
local hiddenByPhoto = false
local frame: Frame? = nil
local lines: TextLabel? = nil
local pollToken = 0
local lastInfo: { [string]: any }? = nil
local lastReject: { Shot: number, Why: string, T: number }? = nil
local fps = 60
local fpsAcc, fpsFrames = 0, 0

type HitboxPair = { Head: SphereHandleAdornment, Body: BoxHandleAdornment }
local hitboxFolder: Folder? = nil
local hitboxPool: { HitboxPair } = {}
local hitboxAcc = 0

local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function formatTime(seconds: number): string
	local util = ctx and ctx.Util
	if util and type(util.FormatTime) == "function" then
		local ok, text = pcall(util.FormatTime, seconds)
		if ok and type(text) == "string" then
			return text
		end
	end
	return ("%ds"):format(math.floor(seconds))
end

local function build()
	if frame then
		return
	end
	local parent = ctx and ctx.Gui
	if typeof(parent) ~= "Instance" then
		return
	end
	local box = Instance.new("Frame")
	box.Name = "CC_DebugOverlay"
	box.Position = UDim2.fromOffset(12, 120)
	box.Size = UDim2.fromOffset(430, 0)
	box.AutomaticSize = Enum.AutomaticSize.Y
	box.BackgroundColor3 = BLACK
	box.BackgroundTransparency = 0.35
	box.BorderSizePixel = 0
	box.ZIndex = 50
	box.Visible = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = box
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = box
	local label = Instance.new("TextLabel")
	label.Name = "Lines"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.Font = Enum.Font.RobotoMono
	label.TextSize = 14
	label.TextColor3 = WHITE
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.TextWrapped = true
	label.RichText = false
	label.Text = ""
	label.ZIndex = 51
	label.Parent = box
	box.Parent = parent
	frame = box
	lines = label
end

local function render()
	if not lines then
		return
	end
	local out: { string } = { T("admin.dbgTitle") }
	local info = lastInfo
	if info then
		table.insert(out, T("admin.dbgHeartbeat", tonumber(info.HeartbeatMs) or 0, tonumber(info.HeartbeatMaxMs) or 0))
		if type(info.Jobs) == "table" then
			for _, job in ipairs(info.Jobs) do
				if type(job) == "table" then
					table.insert(
						out,
						("  %-22s %5.2f / %5.2f ms"):format(
							string.sub(tostring(job.Name), 1, 22),
							tonumber(job.AvgMs) or 0,
							tonumber(job.MaxMs) or 0
						)
					)
				end
			end
		end
		table.insert(
			out,
			T("admin.dbgCounts", tonumber(info.Players) or 0, tonumber(info.Bots) or 0, tonumber(info.Projectiles) or 0)
		)
		local slots: { string } = {}
		if type(info.Slots) == "table" then
			for _, s in ipairs(info.Slots) do
				if type(s) == "table" then
					table.insert(
						slots,
						("%s:%s%s"):format(
							tostring(s.Slot),
							tostring(s.State),
							if s.MapKey then "(" .. tostring(s.MapKey) .. ")" else ""
						)
					)
				end
			end
		end
		table.insert(out, T("admin.dbgSlots", if #slots > 0 then table.concat(slots, "  ") else "-"))
		table.insert(out, T("admin.dbgMem", tonumber(info.MemoryMb) or 0, formatTime(tonumber(info.Uptime) or 0)))
	else
		table.insert(out, T("core.loading"))
	end
	table.insert(out, T("admin.dbgClient", math.floor(fps + 0.5), tonumber(player:GetAttribute("PingMs")) or 0))
	local reject = lastReject
	if reject then
		table.insert(out, T("admin.dbgReject", reject.Shot, reject.Why, math.floor(os.clock() - reject.T)))
	else
		table.insert(out, T("admin.dbgNoReject"))
	end
	lines.Text = table.concat(out, "\n")
end

local function poll(token: number)
	while visible and token == pollToken do
		local remotes = ctx and ctx.Remotes
		local admin = remotes and remotes.Admin
		if admin and admin:IsA("RemoteFunction") then
			local ok, result = pcall(function()
				return admin:InvokeServer("ServerInfo", {})
			end)
			if ok and type(result) == "table" and result.Ok and type(result.Data) == "table" then
				lastInfo = result.Data
			end
		end
		if not visible or token ~= pollToken then
			break
		end
		render()
		task.wait(POLL_SECONDS)
	end
end

local function applyVisible()
	build()
	if frame then
		frame.Visible = visible and not hiddenByPhoto
	end
end

function DebugOverlay.Toggle()
	visible = not visible
	pollToken += 1
	applyVisible()
	if visible then
		render()
		task.spawn(poll, pollToken)
	end
end

-- ---------------------------------------------------------------------
-- HITBOXEN (rein lokal, CanQuery-frei: Adornments sind keine Parts)
-- ---------------------------------------------------------------------
local function pairAt(index: number): HitboxPair?
	local existing = hitboxPool[index]
	if existing then
		return existing
	end
	if index > HITBOX_MAX then
		return nil
	end
	if not hitboxFolder then
		local folder = Instance.new("Folder")
		folder.Name = "CC_DebugHitboxes"
		folder.Parent = workspace.CurrentCamera
		hitboxFolder = folder
	end
	local head = Instance.new("SphereHandleAdornment")
	head.Color3 = Color3.fromRGB(255, 60, 60)
	head.Transparency = 0.6
	head.AlwaysOnTop = true
	head.ZIndex = 1
	head.Visible = false
	head.Parent = hitboxFolder
	local body = Instance.new("BoxHandleAdornment")
	body.Color3 = Color3.fromRGB(60, 200, 255)
	body.Transparency = 0.75
	body.AlwaysOnTop = true
	body.ZIndex = 0
	body.Visible = false
	body.Parent = hitboxFolder
	local pair: HitboxPair = { Head = head, Body = body }
	hitboxPool[index] = pair
	return pair
end

local function hideHitboxes(from: number)
	for i = from, #hitboxPool do
		local pair = hitboxPool[i]
		pair.Head.Visible = false
		pair.Body.Visible = false
		pair.Head.Adornee = nil
		pair.Body.Adornee = nil
	end
end

local function updateHitboxes()
	if workspace:GetAttribute("DebugShowHitboxes") ~= true or hiddenByPhoto then
		hideHitboxes(1)
		return
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local combat = ctx and ctx.Config and ctx.Config.Combat or {}
	local headRadius = tonumber(combat.HeadRadius) or 0.8
	local bodyOffset: Vector3 = if typeof(combat.BodyOffset) == "Vector3"
		then combat.BodyOffset
		else Vector3.new(0, -1, 0)
	local bodyHalf: Vector3 = if typeof(combat.BodyHalf) == "Vector3" then combat.BodyHalf else Vector3.new(1.5, 2, 0.8)
	local camPos = camera.CFrame.Position
	local index = 0
	local candidates: { Model } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local character = p.Character
		if character then
			table.insert(candidates, character)
		end
	end
	for _, tagged in ipairs(game:GetService("CollectionService"):GetTagged("Bot")) do
		if tagged:IsA("Model") then
			table.insert(candidates, tagged)
		end
	end
	for _, model in ipairs(candidates) do
		if index >= HITBOX_MAX then
			break
		end
		local root = model:FindFirstChild("HumanoidRootPart")
		local head = model:FindFirstChild("Head")
		if
			root
			and head
			and root:IsA("BasePart")
			and head:IsA("BasePart")
			and model:GetAttribute("CombatantId") ~= nil
			and (root.Position - camPos).Magnitude <= HITBOX_RANGE
		then
			index += 1
			local pair = pairAt(index)
			if not pair then
				break
			end
			local mult = if model:GetAttribute("BigHead") then 1.6 else 1
			pair.Head.Adornee = head
			pair.Head.Radius = headRadius * mult
			pair.Head.CFrame = CFrame.new()
			pair.Head.Visible = true
			pair.Body.Adornee = root
			pair.Body.Size = bodyHalf * 2
			pair.Body.CFrame = CFrame.new(bodyOffset)
			pair.Body.Visible = true
		end
	end
	hideHitboxes(index + 1)
end

-- ---------------------------------------------------------------------
-- LEBENSZYKLUS
-- ---------------------------------------------------------------------
function DebugOverlay.Init(context: any)
	ctx = context
end

function DebugOverlay.Start()
	local key = Enum.KeyCode.F8
	local keys = ctx and ctx.Config and ctx.Config.Client and ctx.Config.Client.Keys
	if keys and type(keys.Debug) == "table" and type(keys.Debug[1]) == "string" then
		local ok, code = pcall(function()
			return (Enum.KeyCode :: any)[keys.Debug[1]]
		end)
		if ok and typeof(code) == "EnumItem" then
			key = code
		end
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		-- F8 wird nie von Roblox-Menüs "verbraucht"; andere Tasten nur, wenn kein Textfeld/Menü sie nimmt
		if input.KeyCode ~= key or UserInputService:GetFocusedTextBox() then
			return
		end
		if processed and key ~= Enum.KeyCode.F8 then
			return
		end
		DebugOverlay.Toggle()
	end)
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		hooks.On("Combat:Reject", function(data: any)
			if type(data) == "table" then
				lastReject = {
					Shot = tonumber(data.Shot) or 0,
					Why = string.sub(tostring(data.Why or "?"), 1, 24),
					T = os.clock(),
				}
				if visible then
					render()
				end
			end
		end)
		hooks.On("PhotoMode", function(on: any)
			hiddenByPhoto = on == true
			applyVisible()
			if hiddenByPhoto then
				hideHitboxes(1)
			end
		end)
	end
	RunService.PreRender:Connect(function(dt)
		fpsAcc += dt
		fpsFrames += 1
		if fpsAcc >= 0.5 then
			fps = fpsFrames / fpsAcc
			fpsAcc, fpsFrames = 0, 0
		end
		hitboxAcc += dt
		if hitboxAcc >= 1 / HITBOX_HZ then
			hitboxAcc = 0
			if #hitboxPool > 0 or workspace:GetAttribute("DebugShowHitboxes") == true then
				updateHitboxes()
			end
		end
	end)
end

return DebugOverlay
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Bildschirm-Effekte vom Server (Client/Modules/Effects)
--  Besitzer: WP10 (Client-Hülle). Basis: Meteor-Heist-Effects (REUSE §1.4, announce/adminWarn 1:1).
--
--  Remote "Effect"(name, strength, data) -> Effects.Play:
--    "Announce"  {Text, UserId, Name}  Besitzer-Ansage oben in der Mitte: rundes Kopfbild, Name in Blau +
--                selbst gezeichneter blauer Haken, ":" und weißer Text – OHNE Kasten, ploppt auf, ~8 s
--    "AdminWarn" {Text}                großer roter Hinweis in der Bildschirmmitte (ohne Kasten)
--    "Confetti"  (strength = Menge)    Konfetti-Kanonen links/rechts
--    "LevelUp"   {Level, Rewards}      "LEVEL 12!" + Blitz + Konfetti + Jingle (Belohnungskarte macht WP8)
--    "CoinFly"   (strength = Coins)    Münzen fliegen zum Coin-Zähler im HUD
--    "Shake"     (strength)            Kamera wackeln (Einstellung "Kamerawackeln" 0–100 %)
--    "CrateFound", "PartyBoost", "Event", "Friend", "Mutator"  lokalisierte Lobby-Hinweise (Toast)
--  Bausteine: Effects.Burst / Ring / Puff (Welt), Effects.Shake, Effects.Flash(color, text?)
--  Effects.SetHidden(on) / Effects.IsHidden() für den Foto-Modus.
--  Öffentliche API (C7.4): Effects.Play(name, strength, data?), Effects.SetHidden(on)
-- =====================================================================

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local Effects = {}

local player = Players.LocalPlayer
local ctx: any = nil
local fxFolder: Folder? = nil
local overlay: ScreenGui? = nil -- eigene Ebene (ohne UIScale -> Pixel = Bildschirm-Pixel)
local hidden = false

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function sfx(role: string, pos: Vector3?, opts: any?)
	local module = ctx and ctx.Modules and ctx.Modules.Sfx
	if module and type(module.Play) == "function" then
		pcall(module.Play, role, pos, opts)
	end
end

local function setting(key: string): any
	local module = ctx and ctx.Modules and ctx.Modules.Settings
	if module and type(module.Get) == "function" then
		local ok, settings = pcall(module.Get)
		if ok and type(settings) == "table" then
			return settings[key]
		end
	end
	return nil
end

-- ---------------------------------------------------------------------
-- WELT-BAUSTEINE (MH): Funken, Druckwelle, Puff – Reichweiten-Grenze + Licht-Budget
-- ---------------------------------------------------------------------
local BURST_RANGE = 450
local FLASH_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SHELL_INFO = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FLASH_WINDOW = 0.25
local MAX_FLASHES = 3
local flashWindowStart = 0
local flashCount = 0

local function reducedFx(): boolean
	return setting("ReducedFx") == true
end

local function localPart(props: { [string]: any }): Part
	local base: { [string]: any } = {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	}
	for key, value in pairs(props) do
		base[key] = value
	end
	return UI.Create("Part", base)
end

local function makeEmitter(color: Color3, parent: Instance, big: boolean): ParticleEmitter
	return UI.Create("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(color:Lerp(WHITE, 0.45), color),
		LightEmission = 0.4,
		LightInfluence = 0,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, big and 1.4 or 0.8),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.7, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.5, big and 1.2 or 0.7),
		Speed = NumberRange.new(big and 16 or 8, big and 34 or 16),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -28, 0),
		Drag = 2,
		RotSpeed = NumberRange.new(-220, 220),
		Rate = 0,
		Parent = parent,
	})
end

local function inRange(position: Vector3): boolean
	local camera = workspace.CurrentCamera
	return not camera or (camera.CFrame.Position - position).Magnitude <= BURST_RANGE
end

local function burst(position: Vector3, color: Color3, amount: number, flash: boolean)
	local folder = fxFolder
	if not folder or hidden or not inRange(position) then
		return
	end
	if reducedFx() then
		flash = false
		amount *= 0.5
	end
	if flash then
		local t = os.clock()
		if t - flashWindowStart > FLASH_WINDOW then
			flashWindowStart = t
			flashCount = 0
		end
		flashCount += 1
		if flashCount > MAX_FLASHES then
			flash = false
			amount *= 0.5
		end
	end
	local holder = localPart({
		Name = "Burst",
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
		CFrame = CFrame.new(position),
		Parent = folder,
	})
	local emitter = makeEmitter(color, holder, flash)
	emitter:Emit(math.clamp(math.floor(amount), 1, 120))
	if flash then
		local light: PointLight = UI.Create("PointLight", {
			Color = color,
			Range = 26,
			Brightness = 8,
			Shadows = false,
			Parent = holder,
		})
		TweenService:Create(light, FLASH_INFO, { Brightness = 0, Range = 6 }):Play()
		local shell = localPart({
			Name = "Flash",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1),
			Material = Enum.Material.Neon,
			Color = color,
			Transparency = 0.2,
			CFrame = CFrame.new(position),
			Parent = folder,
		})
		TweenService:Create(shell, SHELL_INFO, { Size = Vector3.new(13, 13, 13), Transparency = 1 }):Play()
		Debris:AddItem(shell, 0.5)
	end
	Debris:AddItem(holder, 2)
end

local function ring(position: Vector3, color: Color3, size: number, time: number)
	local folder = fxFolder
	if not folder or hidden or not inRange(position) then
		return
	end
	local cf = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2)
	local wave = localPart({
		Name = "Shockwave",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.15, 1, 1),
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.25,
		CFrame = cf,
		Parent = folder,
	})
	local info = TweenInfo.new(time, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	TweenService:Create(wave, info, { Size = Vector3.new(0.05, size, size), Transparency = 1 }):Play()
	Debris:AddItem(wave, time + 0.05)
end

local function puff(position: Vector3, color: Color3, amount: number)
	local folder = fxFolder
	if not folder or hidden or not inRange(position) then
		return
	end
	local holder = localPart({
		Name = "Puff",
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
		CFrame = CFrame.new(position),
		Parent = folder,
	})
	local poof: ParticleEmitter = UI.Create("ParticleEmitter", {
		Texture = "rbxasset://textures/explosion.png",
		Color = ColorSequence.new(WHITE, color:Lerp(WHITE, 0.3)),
		LightEmission = 0.3,
		LightInfluence = 0,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(0.35, 1.5),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.7, 0.25),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.4, 0.7),
		Speed = NumberRange.new(7, 13),
		SpreadAngle = Vector2.new(80, 10),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -8, 0),
		Drag = 5,
		RotSpeed = NumberRange.new(-120, 120),
		Rotation = NumberRange.new(0, 360),
		Rate = 0,
		Parent = holder,
	})
	local count = math.clamp(math.floor(amount * 0.7), 1, 20)
	if reducedFx() then
		count = math.max(1, math.floor(count / 2))
	end
	poof:Emit(count)
	Debris:AddItem(holder, 1)
end

-- ---------------------------------------------------------------------
-- WACKELN: im Kampf über FpsCamera.Shake (Rotation), sonst MH-Kameraversatz (weich, dezent)
-- ---------------------------------------------------------------------
local SHAKE_TIME = 0.4
local SHAKE_SCALE = 0.55
local SHAKE_MAX = 1.2
local SHAKE_FREQ = 18
local shakeStrength = 0
local shakeClock = 0
local shakeLeft = 0
local shakeHumanoid: Humanoid? = nil

local function shake(strength: number)
	if type(strength) ~= "number" or strength ~= strength or strength <= 0 then
		return
	end
	local mult = setting("Shake")
	if type(mult) == "number" then
		strength *= math.clamp(mult, 0, 1)
	end
	if strength <= 0.001 then
		return
	end
	local camera = ctx and ctx.Modules and ctx.Modules.FpsCamera
	local weapon = ctx and ctx.Modules and ctx.Modules.WeaponClient
	local armed = false
	if weapon and type(weapon.IsArmed) == "function" then
		local ok, value = pcall(weapon.IsArmed)
		armed = ok and value == true
	end
	if armed and camera and type(camera.Shake) == "function" then
		pcall(camera.Shake, math.min(strength, 2), SHAKE_TIME)
		return
	end
	strength = math.min(strength * SHAKE_SCALE, SHAKE_MAX)
	local current = if shakeLeft > 0 then shakeStrength * (shakeLeft / SHAKE_TIME) else 0
	if strength >= current then
		shakeStrength = strength
		shakeLeft = SHAKE_TIME
	end
end

local function stepShake(dt: number)
	if shakeLeft <= 0 then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid ~= shakeHumanoid and shakeHumanoid and shakeHumanoid.Parent then
		shakeHumanoid.CameraOffset = Vector3.zero
	end
	shakeHumanoid = humanoid
	shakeLeft -= dt
	if not humanoid then
		return
	end
	if shakeLeft <= 0 then
		humanoid.CameraOffset = Vector3.zero
		return
	end
	local fade = shakeLeft / SHAKE_TIME
	local power = shakeStrength * fade * fade
	shakeClock += dt * SHAKE_FREQ
	humanoid.CameraOffset = Vector3.new(math.noise(shakeClock, 0.5), math.noise(0.5, shakeClock), 0) * power
end

-- ---------------------------------------------------------------------
-- MÜNZFLUG zum Coin-Zähler (fester Vorrat von 16)
-- ---------------------------------------------------------------------
type Coin = { Label: TextLabel, Busy: boolean }
local COIN_COUNT = 16
local COIN_OUT_INFO = TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local coinPool: { Coin } = {}

local function buildCoins()
	local gui = overlay
	if not gui then
		return
	end
	for _ = 1, COIN_COUNT do
		local coinLabel: TextLabel = UI.Create("TextLabel", {
			Name = "Coin",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(34, 34),
			BackgroundTransparency = 1,
			Text = "🪙",
			TextScaled = true,
			Font = Enum.Font.FredokaOne,
			Visible = false,
			ZIndex = 30,
			Parent = gui,
		})
		table.insert(coinPool, { Label = coinLabel, Busy = false })
	end
end

local function flyCoins(amount: number)
	local gui = overlay
	local camera = workspace.CurrentCamera
	local hud = ctx and ctx.Modules and ctx.Modules.Hud
	if not gui or hidden or not camera or #coinPool == 0 or not hud or type(hud.CoinAnchor) ~= "function" then
		return
	end
	local ok, target = pcall(hud.CoinAnchor)
	if not ok or typeof(target) ~= "Vector2" then
		return
	end
	local goal = UDim2.fromOffset(target.X, target.Y)
	local size = gui.AbsoluteSize
	local start = Vector2.new(size.X / 2, size.Y * 0.55)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local point, onScreen = camera:WorldToScreenPoint(root.Position)
		if onScreen then
			start = Vector2.new(point.X, point.Y)
		end
	end
	local count = math.clamp(math.floor(3 + math.log10(math.max(amount, 1)) * 1.5), 4, 12)
	local launched = 0
	for _, coin in ipairs(coinPool) do
		if launched >= count then
			break
		end
		if not coin.Busy then
			launched += 1
			coin.Busy = true
			local coinLabel = coin.Label
			local angle = math.random() * math.pi * 2
			local spread = 40 + math.random() * 70
			local midX = start.X + math.cos(angle) * spread
			local midY = start.Y + math.sin(angle) * spread * 0.7 - 30
			coinLabel.Position = UDim2.fromOffset(start.X, start.Y)
			coinLabel.Size = UDim2.fromOffset(14, 14)
			coinLabel.Rotation = math.random(-40, 40)
			coinLabel.Visible = true
			local out = TweenService:Create(coinLabel, COIN_OUT_INFO, {
				Position = UDim2.fromOffset(midX, midY),
				Size = UDim2.fromOffset(34, 34),
				Rotation = coinLabel.Rotation + math.random(-120, 120),
			})
			local delay = launched * 0.04
			out.Completed:Once(function()
				local flyInfo = TweenInfo.new(
					0.4 + math.random() * 0.15,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In,
					0,
					false,
					delay
				)
				local fly = TweenService:Create(coinLabel, flyInfo, {
					Position = goal,
					Size = UDim2.fromOffset(20, 20),
					Rotation = 0,
				})
				fly.Completed:Once(function()
					coinLabel.Visible = false
					coin.Busy = false
					if not hidden and type(hud.PulseCoins) == "function" then
						pcall(hud.PulseCoins, 0.06)
					end
					sfx("UIHover", nil, { Speed = 1.2 + math.random() * 0.4 })
				end)
				fly:Play()
			end)
			out:Play()
		end
	end
end

-- ---------------------------------------------------------------------
-- KONFETTI (MH): Kanonen links und rechts unten, Wurfparabel, Drehen + Flattern
-- ---------------------------------------------------------------------
local MAX_CONFETTI = 140
local CONFETTI_GRAVITY = 1500
local confettiAlive = 0

local function confettiPiece(gui: ScreenGui, x: number, y: number, vx: number, vy: number, color: Color3)
	local screen = gui.AbsoluteSize
	local tUp = vy / CONFETTI_GRAVITY
	local peak = y - vy * vy / (2 * CONFETTI_GRAVITY)
	local fallDistance = screen.Y + 30 - peak
	local tDown = math.sqrt(2 * fallDistance / CONFETTI_GRAVITY) * 1.9
	local life = tUp + tDown
	local width, height = math.random(8, 14), math.random(10, 16)
	local holder: Frame = UI.Create("Frame", {
		Size = UDim2.fromOffset(0, 0),
		Position = UDim2.fromOffset(x, y),
		BackgroundTransparency = 1,
		ZIndex = 25,
		Parent = gui,
	})
	local piece: Frame = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Rotation = math.random(0, 360),
		ZIndex = 25,
		Parent = holder,
	})
	if math.random() < 0.35 then
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = piece })
	end
	TweenService:Create(
		holder,
		TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(x + vx * 0.9, y) }
	):Play()
	TweenService:Create(piece, TweenInfo.new(life, Enum.EasingStyle.Linear), {
		Rotation = piece.Rotation + math.random(-720, 720),
	}):Play()
	TweenService:Create(
		piece,
		TweenInfo.new(0.18 + math.random() * 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Size = UDim2.fromOffset(math.max(2, width * 0.15), height) }
	):Play()
	local up = TweenService:Create(
		piece,
		TweenInfo.new(tUp, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(0, peak - y) }
	)
	up.Completed:Once(function()
		local down = TweenService:Create(
			piece,
			TweenInfo.new(tDown, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Position = UDim2.fromOffset(0, screen.Y + 30 - y) }
		)
		down.Completed:Once(function()
			confettiAlive -= 1
			holder:Destroy()
		end)
		down:Play()
	end)
	up:Play()
end

local function confetti(amount: number)
	local gui = overlay
	if not gui or hidden then
		return
	end
	local colors = { UI.Theme.Yellow, UI.Theme.Green, UI.Theme.Blue, UI.Theme.Purple, UI.Theme.Red, UI.Theme.Pink }
	local mult = math.clamp(tonumber(amount) or 1, 0.3, 3)
	if amount <= 0 then
		mult = 1
	end
	local count = math.floor(32 * mult)
	if reducedFx() then
		count = math.floor(count / 2)
	end
	count = math.min(count, MAX_CONFETTI - confettiAlive)
	local screen = gui.AbsoluteSize
	if screen.Y < 10 or count <= 0 then
		return
	end
	for i = 1, count do
		confettiAlive += 1
		local left = i % 2 == 0
		local x = if left then screen.X * 0.04 else screen.X * 0.96
		local y = screen.Y + 10
		local rise = screen.Y * (0.35 + math.random() * 0.5)
		local vy = math.sqrt(2 * CONFETTI_GRAVITY * rise)
		local vx = (screen.X * (0.12 + math.random() * 0.4)) * (if left then 1 else -1)
		confettiPiece(gui, x, y, vx, vy, colors[math.random(1, #colors)])
	end
end

-- ---------------------------------------------------------------------
-- GROSSER BLITZ MIT TEXT (Level-Up, Sieg …) – MH-RebirthFlash
-- ---------------------------------------------------------------------
local FLASH_FADE_INFO = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FLASH_POP_INFO = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local FLASH_TILT_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
local FLASH_OUT_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 1.1)
local flashBusy = false

function Effects.Flash(color: Color3, text: string?)
	local gui = overlay
	if not gui or hidden or flashBusy then
		return
	end
	flashBusy = true
	local flash: Frame = UI.Create("Frame", {
		Name = "BigFlash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = if reducedFx() then 0.5 else 0.1,
		ZIndex = 40,
		Parent = gui,
	}, {
		UI.Create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, color),
				ColorSequenceKeypoint.new(0.5, WHITE),
				ColorSequenceKeypoint.new(1, color),
			}),
		}),
	})
	local label: TextLabel? = nil
	if text and text ~= "" then
		local textScale: UIScale = UI.Create("UIScale", { Scale = 0.3 })
		local newLabel = UI.Label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.4),
			Size = UDim2.fromOffset(640, 120),
			Text = text,
			Font = UI.Fonts.Banner,
			TextColor3 = UI.Theme.Yellow,
			MaxText = 96,
			Outline = 5,
			ZIndex = 41,
			Parent = gui,
		})
		textScale.Parent = newLabel
		newLabel.Rotation = -6
		TweenService:Create(textScale, FLASH_POP_INFO, { Scale = 1 }):Play()
		TweenService:Create(newLabel, FLASH_TILT_INFO, { Rotation = 0 }):Play()
		local stroke = newLabel:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, FLASH_OUT_INFO, { Transparency = 1 }):Play()
		end
		label = newLabel
	end
	TweenService:Create(flash, FLASH_FADE_INFO, { BackgroundTransparency = 1 }):Play()
	task.delay(1.6, function()
		flash:Destroy()
		if label then
			label:Destroy()
		end
		flashBusy = false
	end)
	if label then
		TweenService:Create(label, FLASH_OUT_INFO, { TextTransparency = 1 }):Play()
	end
end

local function levelUp(data: any)
	local level = type(data) == "table" and tonumber(data.Level) or nil
	local text = if level then T("ui.levelUp", math.floor(level)) else T("ui.levelUpShort")
	Effects.Flash(UI.Theme.Orange, text)
	confetti(2)
	shake(0.4)
	sfx("LevelUp")
end

-- ---------------------------------------------------------------------
-- BESITZER-ANSAGE (MH 1:1): Kopfbild, Name in Blau + Haken, ":" und Text – ohne Kasten
-- ---------------------------------------------------------------------
local ANNOUNCE_BLUE = Color3.fromRGB(40, 140, 255)
local ANNOUNCE_TIME = 8
local ANNOUNCE_MAX_QUEUE = 5
local ANNOUNCE_AVATAR = 64
local ANNOUNCE_NAME_SIZE = 34
local ANNOUNCE_BADGE = 30
local ANNOUNCE_Y = 14
local ANNOUNCE_IN = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local ANNOUNCE_FADE_IN = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local ANNOUNCE_OUT = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local THUMB_CACHE_MAX = 64

type AnnounceUI = {
	Group: CanvasGroup,
	Scale: UIScale,
	Avatar: ImageLabel,
	Name: TextLabel,
	Badge: Frame,
	Colon: TextLabel,
	Text: TextLabel,
}
local announceUI: AnnounceUI? = nil
local announceQueue: { any } = {}
local announceBusy = false
local thumbCache: { [number]: string } = {}
local thumbCount = 0

local function textStroke(parent: Instance, thickness: number)
	UI.Create("UIStroke", {
		Thickness = thickness,
		Color = BLACK,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

local function buildAnnounce(): AnnounceUI?
	local gui = overlay
	if not gui then
		return nil
	end
	local group: CanvasGroup = UI.Create("CanvasGroup", {
		Name = "OwnerAnnounce",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, ANNOUNCE_Y),
		Size = UDim2.new(0.86, 0, 0, 96),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	local scale: UIScale = UI.Create("UIScale", { Scale = 1, Parent = group })
	local avatar: ImageLabel = UI.Create("ImageLabel", {
		Name = "Avatar",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 4, 0.5, 0),
		Size = UDim2.fromOffset(ANNOUNCE_AVATAR, ANNOUNCE_AVATAR),
		BackgroundColor3 = Color3.fromRGB(200, 205, 215),
		Image = "",
		ZIndex = 31,
		Parent = group,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	UI.Create("UIStroke", { Thickness = 3, Color = BLACK, Parent = avatar })
	local nameLabel: TextLabel = UI.Create("TextLabel", {
		Name = "Name",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, ANNOUNCE_AVATAR + 14, 0.5, 0),
		Size = UDim2.fromOffset(100, 44),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextSize = ANNOUNCE_NAME_SIZE,
		TextColor3 = ANNOUNCE_BLUE,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
		Parent = group,
	})
	textStroke(nameLabel, 3)
	-- Haken-Badge (selbst gezeichnet): zwei gedrehte blaue Quadrate = Zackenkreis, weißer Haken
	local badge: Frame = UI.Create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(ANNOUNCE_BADGE, ANNOUNCE_BADGE),
		BackgroundTransparency = 1,
		ZIndex = 31,
		Parent = group,
	})
	for _, rotation in ipairs({ 0, 45 }) do
		UI.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.78, 0.78),
			Rotation = rotation,
			BackgroundColor3 = ANNOUNCE_BLUE,
			BorderSizePixel = 0,
			ZIndex = 31,
			Parent = badge,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.2, 0) }) })
	end
	UI.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = "✓",
		TextScaled = true,
		TextColor3 = WHITE,
		ZIndex = 32,
		Parent = badge,
	})
	local colon: TextLabel = UI.Create("TextLabel", {
		Name = "Colon",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(14, 44),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextSize = ANNOUNCE_NAME_SIZE,
		Text = ":",
		TextColor3 = WHITE,
		ZIndex = 31,
		Parent = group,
	})
	textStroke(colon, 3)
	local text: TextLabel = UI.Create("TextLabel", {
		Name = "Text",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextWrapped = true,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
		Parent = group,
	})
	UI.Create("UITextSizeConstraint", { MaxTextSize = 44, MinTextSize = 14, Parent = text })
	textStroke(text, 3)
	return {
		Group = group,
		Scale = scale,
		Avatar = avatar,
		Name = nameLabel,
		Badge = badge,
		Colon = colon,
		Text = text,
	}
end

local function headshot(userId: number): string
	local cached = thumbCache[userId]
	if cached then
		return cached
	end
	if userId <= 0 then
		return ""
	end
	local ok, image = pcall(function()
		return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
	end)
	if ok and type(image) == "string" then
		if thumbCount >= THUMB_CACHE_MAX then
			table.clear(thumbCache)
			thumbCount = 0
		end
		thumbCache[userId] = image
		thumbCount += 1
		return image
	end
	return ""
end

local function layoutAnnounce(ui: AnnounceUI, name: string)
	local nameWidth = TextService:GetTextSize(name, ANNOUNCE_NAME_SIZE, Enum.Font.FredokaOne, Vector2.new(1000, 100)).X
		+ 4
	local x = ANNOUNCE_AVATAR + 14
	ui.Name.Size = UDim2.fromOffset(nameWidth, 44)
	x += nameWidth + 6
	ui.Badge.Position = UDim2.new(0, x, 0.5, 0)
	x += ANNOUNCE_BADGE + 2
	ui.Colon.Position = UDim2.new(0, x, 0.5, 0)
	x += 18
	ui.Text.Position = UDim2.new(0, x, 0.5, 0)
	ui.Text.Size = UDim2.new(1, -x - 4, 1, -4)
end

local function showNextAnnounce()
	local ui = announceUI
	if not ui then
		return
	end
	announceBusy = true
	while #announceQueue > 0 do
		local data = table.remove(announceQueue, 1)
		local name = string.sub(tostring(data.Name or "Admin"), 1, 40)
		ui.Name.Text = name
		ui.Text.Text = tostring(data.Text)
		ui.Avatar.Image = headshot(tonumber(data.UserId) or 0)
		layoutAnnounce(ui, name)
		ui.Group.Visible = not hidden
		ui.Group.GroupTransparency = 1
		ui.Group.Position = UDim2.new(0.5, 0, 0, ANNOUNCE_Y)
		ui.Scale.Scale = 0.6
		TweenService:Create(ui.Group, ANNOUNCE_FADE_IN, { GroupTransparency = 0 }):Play()
		TweenService:Create(ui.Scale, ANNOUNCE_IN, { Scale = 1 }):Play()
		sfx("Countdown", nil, { Speed = 1.5 })
		task.wait(ANNOUNCE_TIME)
		local out = TweenService:Create(ui.Group, ANNOUNCE_OUT, { GroupTransparency = 1 })
		out:Play()
		out.Completed:Wait()
		ui.Group.Visible = false
		task.wait(0.2)
	end
	announceBusy = false
end

local function announce(data: any)
	if type(data) ~= "table" or type(data.Text) ~= "string" or data.Text == "" then
		return
	end
	if not announceUI then
		announceUI = buildAnnounce()
	end
	if #announceQueue >= ANNOUNCE_MAX_QUEUE then
		table.remove(announceQueue, 1) -- die älteste wartende Ansage fällt weg
	end
	table.insert(announceQueue, data)
	if not announceBusy then
		task.spawn(showNextAnnounce)
	end
end

-- ---------------------------------------------------------------------
-- ADMIN-WARNUNG (MH 1:1): riesige rote Überschrift + weißer Text, dicke Kontur, ohne Kasten
-- ---------------------------------------------------------------------
local WARN_TIME = 7
local WARN_RED = Color3.fromRGB(255, 55, 55)
local WARN_IN = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local WARN_OUT = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local warnToken = 0
local warnFrame: Frame? = nil
local warnTitle: TextLabel? = nil
local warnText: TextLabel? = nil
local warnScale: UIScale? = nil

local function buildWarn()
	local gui = overlay
	if not gui or warnFrame then
		return
	end
	local frame: Frame = UI.Create("Frame", {
		Name = "AdminWarn",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.new(0.7, 0, 0, 170),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	}, {
		UI.Create("UISizeConstraint", { MinSize = Vector2.new(300, 0), MaxSize = Vector2.new(820, 400) }),
	})
	local scale: UIScale = UI.Create("UIScale", { Scale = 1, Parent = frame })
	local title = UI.Label({
		Size = UDim2.new(1, 0, 0, 58),
		Text = "",
		TextColor3 = WARN_RED,
		MaxText = 52,
		Outline = 4,
		ZIndex = 41,
		Parent = frame,
	})
	local text = UI.Label({
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 1, -62),
		Text = "",
		TextWrapped = true,
		MaxText = 36,
		Outline = 3,
		ZIndex = 41,
		Parent = frame,
	})
	warnFrame, warnTitle, warnText, warnScale = frame, title, text, scale
end

local function adminWarn(data: any)
	if type(data) ~= "table" or type(data.Text) ~= "string" or data.Text == "" then
		return
	end
	buildWarn()
	local frame, title, text, scale = warnFrame, warnTitle, warnText, warnScale
	if not frame or not title or not text or not scale then
		return
	end
	warnToken += 1
	local token = warnToken
	title.Text = T("ui.adminWarn")
	text.Text = data.Text
	frame.Visible = true
	scale.Scale = 0.6
	TweenService:Create(scale, WARN_IN, { Scale = 1 }):Play()
	shake(0.5)
	sfx("UIError")
	task.delay(WARN_TIME, function()
		if warnToken ~= token then
			return
		end
		local out = TweenService:Create(scale, WARN_OUT, { Scale = 0 })
		out.Completed:Once(function()
			if warnToken == token then
				frame.Visible = false
			end
		end)
		out:Play()
	end)
end

-- ---------------------------------------------------------------------
-- LOBBY-HINWEISE (Kisten-Fund, Party-Boost, Admin-Event, Freund, Mutator)
-- ---------------------------------------------------------------------
local function cosmeticName(id: any): string
	if type(id) ~= "string" then
		return "?"
	end
	local config = ctx and ctx.Config
	local cosmetics = config and config.Cosmetics
	local def = nil
	if cosmetics and type(cosmetics.Get) == "function" then
		local ok, value = pcall(cosmetics.Get, id)
		def = ok and value or nil
	end
	if type(def) == "table" and type(def.Name) == "table" then
		local ok, text = pcall(ctx.Lang.Pick, ctx.Lang_(), def.Name)
		if ok and type(text) == "string" then
			return text
		end
	end
	return id
end

local function minutesLeft(untilT: any): number
	if type(untilT) ~= "number" then
		return 0
	end
	return math.max(0, math.ceil((untilT - workspace:GetServerTimeNow()) / 60))
end

local function lobbyNotice(name: string, data: any)
	if type(data) ~= "table" then
		return
	end
	if name == "CrateFound" then
		local who = string.sub(tostring(data.Name or "?"), 1, 40)
		local rarity = tostring(data.Rarity or "")
		local rarityText = T("ui.rarity." .. rarity)
		if rarityText == "ui.rarity." .. rarity then
			rarityText = rarity
		end
		UI.Toast(T("ui.crateFound", who, rarityText, cosmeticName(data.ItemId)), "Event")
	elseif name == "PartyBoost" then
		UI.Toast(T("ui.partyBoost", string.sub(tostring(data.Name or "?"), 1, 40), minutesLeft(data.Until)), "Event")
		confetti(0.6)
	elseif name == "Event" then
		local parts: { string } = {}
		if data.Coins2 then
			table.insert(parts, T("ui.event.coins"))
		end
		if data.Xp2 then
			table.insert(parts, T("ui.event.xp"))
		end
		UI.Toast(T("ui.event", table.concat(parts, " + "), minutesLeft(data.Until)), "Event")
		confetti(1)
	elseif name == "Friend" then
		UI.Toast(T("ui.friendJoined", string.sub(tostring(data.Name or "?"), 1, 40)), "Info")
	elseif name == "Mutator" then
		local key = tostring(data.Key or "")
		local config = ctx and ctx.Config
		local modes = config and config.Modes
		local mutators = modes and modes.Mutators
		local def = type(mutators) == "table" and mutators[key] or nil
		local label = key
		if type(def) == "table" and type(def.Name) == "table" then
			local ok, text = pcall(ctx.Lang.Pick, ctx.Lang_(), def.Name)
			if ok and type(text) == "string" then
				label = text
			end
		end
		UI.Toast(T("ui.mutatorToday", label), "Event")
	end
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH
-- ---------------------------------------------------------------------
function Effects.Play(name: string, strength: number, data: any?)
	if type(name) ~= "string" then
		return
	end
	local amount = tonumber(strength) or 0
	if amount ~= amount then
		amount = 0
	end
	if name == "Announce" then
		announce(data)
	elseif name == "AdminWarn" or name == "Warn" then
		adminWarn(data)
	elseif name == "Confetti" then
		confetti(if amount > 0 then amount else 1)
	elseif name == "LevelUp" then
		levelUp(data)
	elseif name == "CoinFly" then
		flyCoins(math.max(1, amount))
	elseif name == "Shake" then
		shake(amount)
	elseif name == "CrateFound" or name == "PartyBoost" or name == "Event" or name == "Friend" or name == "Mutator" then
		lobbyNotice(name, data)
	end
	-- "Balance" übernimmt Main.client über den LiveBalance-StringValue; Unbekanntes wird ignoriert
end

function Effects.Burst(position: Vector3, color: Color3, amount: number, flash: boolean?)
	burst(position, color, amount, flash == true)
end

function Effects.Ring(position: Vector3, color: Color3, size: number, time: number?)
	ring(position, color, size, time or 0.6)
end

function Effects.Puff(position: Vector3, color: Color3, amount: number)
	puff(position, color, amount)
end

function Effects.Shake(strength: number)
	shake(strength)
end

function Effects.Confetti(amount: number?)
	confetti(amount or 1)
end

function Effects.IsHidden(): boolean
	return hidden
end

-- Foto-Modus: Overlay (Münzen, Konfetti, Ansagen) aus
function Effects.SetHidden(on: boolean)
	hidden = on == true
	if overlay then
		overlay.Enabled = not hidden
	end
end

function Effects.Frame(dt: number)
	stepShake(dt)
end

function Effects.Init(context: any)
	ctx = context
	local folder = Instance.new("Folder")
	folder.Name = "ClutchClashClientFX"
	folder.Parent = workspace
	fxFolder = folder
	overlay = UI.Create("ScreenGui", {
		Name = "ClutchClashFX",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildCoins()
	player.CharacterAdded:Connect(function()
		shakeLeft = 0
		shakeHumanoid = nil
	end)
end

function Effects.Start() end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">Finishers</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Finisher-Effekte beim Pop (Client/Modules/Finishers)
--  Besitzer: WP9 (Wirtschaft, Monetarisierung, Kosmetik). Vertrag: DESIGN.md B19 + C7.4 + C17.
--  8 Builder (Config.Cosmetics.Finishers). Regeln je Effekt: ≤ 25 Teile/Partikel, ≤ 2.5 s,
--  > 300 Studs von der Kamera = gar nicht abspielen, höchstens 4 gleichzeitig (sonst nur Konfetti).
--  Teile kommen aus einem Pool (werden wiederverwendet), alle nicht abfragbar/berührbar (Muss-Regel 11).
--  ReducedFx (Einstellung) halbiert die Stückzahlen. Kein Blut, nur Spielzeug-Konfetti (Muss-Regel 12).
--
--  Öffentliche API:
--    Finishers.Play(id, pos, color)      CombatFX.Pop ruft das auf (Fallback Konfetti)
--    Finishers.Preview(id)               Locker-Vorschau vor dem eigenen Charakter
--    Finishers.Active(): number
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local Finishers = {}
local ctx: any = nil

local HIDE_DISTANCE = 300
local MAX_ACTIVE = math.max(1, tonumber(Config.Client and Config.Client.Pools and Config.Client.Pools.Finishers) or 4)
local MAX_PARTS_PER_EFFECT = 25
local POOL_MAX = MAX_ACTIVE * MAX_PARTS_PER_EFFECT
local MAX_DURATION = 2.5
local DEFAULT_ID = "F_Confetti"

local TEX_SQUARE = "rbxasset://textures/particles/SquareParticle.png" -- ASSETS.md VERIFIED
local TEX_SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_PUFF = "rbxasset://textures/explosion.png"

local rgb = Color3.fromRGB
local GOLD = rgb(255, 200, 40)
local PALETTE = {
	rgb(255, 90, 90),
	rgb(255, 200, 40),
	rgb(90, 220, 120),
	rgb(70, 170, 255),
	rgb(200, 110, 255),
	rgb(255, 120, 200),
}
local RAINBOW = {
	rgb(255, 70, 70),
	rgb(255, 160, 40),
	rgb(255, 235, 70),
	rgb(80, 220, 110),
	rgb(70, 160, 255),
	rgb(120, 90, 255),
	rgb(200, 90, 255),
}

local folder: Folder? = nil
local emitterPart: Part? = nil
local emitters: { [string]: ParticleEmitter } = {}
local freeParts: { Part } = {}
local createdParts = 0
local active = 0
local rng = Random.new()

-- ---------------------------------------------------------------------
-- 1) POOL & EMITTER
-- ---------------------------------------------------------------------
local function ensureFolder(): Folder
	local existing = folder
	if existing and existing.Parent then
		return existing
	end
	local created = Instance.new("Folder")
	created.Name = "CC_Finishers"
	created.Parent = workspace
	folder = created
	return created
end

local function reducedFx(): boolean
	local modules = ctx and ctx.Modules
	local settings = modules and modules.Settings
	if settings and type(settings.Get) == "function" then
		local ok, values = pcall(settings.Get)
		return ok and type(values) == "table" and values.ReducedFx == true
	end
	return false
end

local function count(n: number): number
	return if reducedFx() then math.max(1, math.floor(n / 2)) else n
end

local function acquire(shape: Enum.PartType, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part?
	local p = table.remove(freeParts)
	if p == nil then
		if createdParts >= POOL_MAX then
			return nil -- Budget voll: dieses Stück einfach weglassen
		end
		createdParts += 1
		local created = Instance.new("Part")
		created.Anchored = true
		created.CanQuery = false
		created.CanTouch = false
		created.CanCollide = false
		created.Massless = true
		created.CastShadow = false
		created.TopSurface = Enum.SurfaceType.Smooth
		created.BottomSurface = Enum.SurfaceType.Smooth
		p = created
	end
	local part = p :: Part
	part.Shape = shape
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Transparency = 0
	part.Parent = ensureFolder()
	return part
end

local function release(part: Part)
	part.Parent = nil
	if #freeParts < POOL_MAX then
		table.insert(freeParts, part)
	else
		part:Destroy()
	end
end

local function makeEmitter(name: string, texture: string, props: { [string]: any }): ParticleEmitter
	local holder = emitterPart :: Part
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.Parent = holder
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.Texture = texture
	emitter.Enabled = false
	emitter.Rate = 0
	for key, value in pairs(props) do
		(emitter :: any)[key] = value
	end
	emitter.Parent = attachment
	emitters[name] = emitter
	return emitter
end

local function ensureEmitters()
	if emitterPart and emitterPart.Parent then
		return
	end
	local part = Instance.new("Part")
	part.Name = "FinisherEmitters"
	part.Anchored = true
	part.CanQuery = false
	part.CanTouch = false
	part.CanCollide = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	part.Parent = ensureFolder()
	emitterPart = part
	makeEmitter("Confetti", TEX_SQUARE, {
		Lifetime = NumberRange.new(1.2, 1.8),
		Speed = NumberRange.new(14, 26),
		SpreadAngle = Vector2.new(60, 60),
		Acceleration = Vector3.new(0, -30, 0),
		Drag = 2,
		RotSpeed = NumberRange.new(-360, 360),
		Rotation = NumberRange.new(0, 360),
		Size = NumberSequence.new(0.35),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.8, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		EmissionDirection = Enum.NormalId.Top,
	})
	makeEmitter("Sparkle", TEX_SPARKLE, {
		Lifetime = NumberRange.new(0.6, 1.0),
		Speed = NumberRange.new(3, 8),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) }),
		LightEmission = 1,
	})
	makeEmitter("Puff", TEX_PUFF, {
		Lifetime = NumberRange.new(0.6, 0.9),
		Speed = NumberRange.new(4, 9),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 4) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		LightEmission = 0.3,
	})
end

local function emit(name: string, pos: Vector3, n: number, colors: { Color3 })
	ensureEmitters()
	local emitter = emitters[name]
	local holder = emitterPart
	if emitter == nil or holder == nil then
		return
	end
	holder.CFrame = CFrame.new(pos)
	local keypoints = {}
	local steps = math.min(#colors, 8)
	for i = 1, steps do
		local t = if steps == 1 then 0 else (i - 1) / (steps - 1)
		table.insert(keypoints, ColorSequenceKeypoint.new(t, colors[i]))
	end
	if #keypoints == 1 then
		table.insert(keypoints, ColorSequenceKeypoint.new(1, colors[1]))
	end
	emitter.Color = ColorSequence.new(keypoints)
	emitter:Emit(math.clamp(count(n), 1, MAX_PARTS_PER_EFFECT))
end

-- ---------------------------------------------------------------------
-- 2) EFFEKT-LAUF: Teile + Tweens sammeln, nach der Dauer alles zurück in den Pool
-- ---------------------------------------------------------------------
type Run = { Parts: { Part }, Tweens: { Tween }, Budget: number }

local function newRun(): Run
	return { Parts = {}, Tweens = {}, Budget = MAX_PARTS_PER_EFFECT }
end

local function spawnPart(
	run: Run,
	shape: Enum.PartType,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part?
	if run.Budget <= 0 then
		return nil
	end
	local part = acquire(shape, size, cf, color, material)
	if part then
		run.Budget -= 1
		table.insert(run.Parts, part)
	end
	return part
end

local function tween(
	run: Run,
	inst: Instance,
	seconds: number,
	props: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?,
	delay: number?
)
	local info = TweenInfo.new(
		seconds,
		style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out,
		0,
		false,
		delay or 0
	)
	local t = TweenService:Create(inst, info, props)
	table.insert(run.Tweens, t)
	t:Play()
end

local function finish(run: Run, seconds: number)
	task.delay(math.min(seconds, MAX_DURATION), function()
		for _, t in ipairs(run.Tweens) do
			t:Cancel()
		end
		for _, p in ipairs(run.Parts) do
			release(p)
		end
		active = math.max(0, active - 1)
	end)
end

local function randomDir(): Vector3
	local v = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.2, 1), rng:NextNumber(-1, 1))
	return if v.Magnitude > 0.01 then v.Unit else Vector3.yAxis
end

local BALL = Enum.PartType.Ball
local BLOCK = Enum.PartType.Block
local CYL = Enum.PartType.Cylinder
local NEON = Enum.Material.Neon
local FOIL = Enum.Material.Foil

-- ---------------------------------------------------------------------
-- 3) DIE 8 BUILDER: (run, pos, color) -> Dauer in Sekunden
-- ---------------------------------------------------------------------
local Builders: { [string]: (Run, Vector3, Color3) -> number } = {}

Builders.F_Confetti = function(_run, pos, color)
	local colors = table.clone(PALETTE)
	table.insert(colors, 1, color)
	emit("Confetti", pos, 24, colors)
	return 0.1
end

Builders.F_PixelBurst = function(run, pos, color)
	for i = 1, count(16) do
		local c = if i % 3 == 0 then color else PALETTE[(i % #PALETTE) + 1]
		local part = spawnPart(run, BLOCK, Vector3.new(0.5, 0.5, 0.5), CFrame.new(pos), c, NEON)
		if part then
			local target = pos + randomDir() * rng:NextNumber(6, 10)
			tween(
				run,
				part,
				0.8,
				{ CFrame = CFrame.new(target) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0) }
			)
			tween(run, part, 0.4, { Transparency = 1 }, nil, nil, 0.8)
		end
	end
	return 1.3
end

Builders.F_IceCube = function(run, pos, _color)
	local cube =
		spawnPart(run, BLOCK, Vector3.new(0.5, 0.5, 0.5), CFrame.new(pos), rgb(170, 225, 255), Enum.Material.Glass)
	if cube then
		cube.Transparency = 0.35
		tween(run, cube, 0.25, { Size = Vector3.new(4, 6, 4) }, Enum.EasingStyle.Back)
		tween(run, cube, 0.3, { Transparency = 1 }, nil, nil, 1.3)
	end
	for _ = 1, count(8) do
		local shard =
			spawnPart(run, BLOCK, Vector3.new(0.7, 0.7, 0.7), CFrame.new(pos), rgb(200, 240, 255), Enum.Material.Glass)
		if shard then
			shard.Transparency = 1
			tween(run, shard, 0.05, { Transparency = 0.3 }, nil, nil, 1.25)
			tween(
				run,
				shard,
				0.6,
				{ CFrame = CFrame.new(pos + randomDir() * 7) * CFrame.Angles(1, 2, 0), Transparency = 1 },
				nil,
				nil,
				1.3
			)
		end
	end
	return 2.0
end

Builders.F_BalloonFloat = function(run, pos, color)
	for i = 1, count(5) do
		local offset = Vector3.new(rng:NextNumber(-2, 2), rng:NextNumber(0, 1.5), rng:NextNumber(-2, 2))
		local start = pos + offset
		local c = if i == 1 then color else PALETTE[(i % #PALETTE) + 1]
		local balloon =
			spawnPart(run, BALL, Vector3.new(1.4, 1.7, 1.4), CFrame.new(start), c, Enum.Material.SmoothPlastic)
		local string_ = spawnPart(
			run,
			CYL,
			Vector3.new(2, 0.06, 0.06),
			CFrame.new(start - Vector3.new(0, 1.8, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			rgb(240, 240, 240)
		)
		local rise = Vector3.new(rng:NextNumber(-2, 2), rng:NextNumber(14, 20), rng:NextNumber(-2, 2))
		local duration = rng:NextNumber(1.8, 2.2)
		if balloon then
			tween(
				run,
				balloon,
				duration,
				{ CFrame = CFrame.new(start + rise), Transparency = 0.6 },
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.In
			)
		end
		if string_ then
			tween(run, string_, duration, {
				CFrame = CFrame.new(start + rise - Vector3.new(0, 1.8, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Transparency = 1,
			}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		end
	end
	return 2.3
end

Builders.F_GoldStatue = function(run, pos, _color)
	local base = pos - Vector3.new(0, 2.6, 0)
	local pieces = {
		{ BLOCK, Vector3.new(0.9, 2, 0.9), Vector3.new(-0.5, 1, 0) },
		{ BLOCK, Vector3.new(0.9, 2, 0.9), Vector3.new(0.5, 1, 0) },
		{ BLOCK, Vector3.new(2, 2, 1), Vector3.new(0, 3, 0) },
		{ BLOCK, Vector3.new(0.9, 2, 0.9), Vector3.new(-1.5, 3, 0) },
		{ BLOCK, Vector3.new(0.9, 2, 0.9), Vector3.new(1.5, 3, 0) },
		{ BALL, Vector3.new(1.3, 1.3, 1.3), Vector3.new(0, 4.7, 0) },
		{ CYL, Vector3.new(0.4, 3.2, 3.2), Vector3.new(0, -0.2, 0) },
	}
	for _, spec in ipairs(pieces) do
		local cf = CFrame.new(base + spec[3])
		if spec[1] == CYL then
			cf *= CFrame.Angles(0, 0, math.rad(90))
		end
		local part = spawnPart(run, spec[1], spec[2], cf, GOLD, FOIL)
		if part then
			part.Transparency = 0.6
			tween(run, part, 0.25, { Transparency = 0 })
			tween(run, part, 0.4, { Transparency = 1 }, nil, nil, 2.0)
		end
	end
	emit("Sparkle", pos + Vector3.new(0, 1.5, 0), 12, { GOLD, rgb(255, 245, 180) })
	return 2.45
end

Builders.F_RainbowPuff = function(run, pos, _color)
	emit("Puff", pos, 8, { rgb(255, 255, 255), rgb(255, 230, 250) })
	local n = count(7)
	for i = 1, n do
		local angle = (i / n) * math.pi * 2
		local dir = Vector3.new(math.cos(angle), 0.4, math.sin(angle))
		local part =
			spawnPart(run, BALL, Vector3.new(0.9, 0.9, 0.9), CFrame.new(pos), RAINBOW[((i - 1) % #RAINBOW) + 1], NEON)
		if part then
			tween(run, part, 0.9, { CFrame = CFrame.new(pos + dir * 7), Size = Vector3.new(1.8, 1.8, 1.8) })
			tween(run, part, 0.4, { Transparency = 1 }, nil, nil, 0.9)
		end
	end
	return 1.4
end

Builders.F_DuckRain = function(run, pos, _color)
	for _ = 1, count(12) do -- 12 Enten × 2 Teile = 24 ≤ 25
		local start = pos + Vector3.new(rng:NextNumber(-6, 6), rng:NextNumber(12, 18), rng:NextNumber(-6, 6))
		local landing = Vector3.new(start.X, pos.Y - 2.5, start.Z)
		local spin = CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
		local body = spawnPart(run, BALL, Vector3.new(1.3, 1.1, 1.3), CFrame.new(start) * spin, rgb(255, 215, 60))
		local head = spawnPart(
			run,
			BALL,
			Vector3.new(0.8, 0.8, 0.8),
			CFrame.new(start + Vector3.new(0, 0.8, 0)) * spin,
			rgb(255, 215, 60)
		)
		local fall = rng:NextNumber(1.3, 1.8)
		if body then
			tween(
				run,
				body,
				fall,
				{ CFrame = CFrame.new(landing) * spin },
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			)
			tween(run, body, 0.3, { Transparency = 1 }, nil, nil, fall)
		end
		if head then
			tween(
				run,
				head,
				fall,
				{ CFrame = CFrame.new(landing + Vector3.new(0, 0.8, 0)) * spin },
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			)
			tween(run, head, 0.3, { Transparency = 1 }, nil, nil, fall)
		end
	end
	return 2.3
end

Builders.F_CrownConfetti = function(run, pos, _color)
	local top = pos + Vector3.new(0, 4, 0)
	local parts: { { Part: Part, Offset: Vector3 } } = {}
	local function add(
		shape: Enum.PartType,
		size: Vector3,
		offset: Vector3,
		color: Color3,
		material: Enum.Material,
		rot: CFrame?
	)
		local part = spawnPart(run, shape, size, CFrame.new(pos + offset) * (rot or CFrame.identity), color, material)
		if part then
			table.insert(parts, { Part = part, Offset = offset })
		end
	end
	add(CYL, Vector3.new(0.8, 2.4, 2.4), Vector3.zero, GOLD, FOIL, CFrame.Angles(0, 0, math.rad(90)))
	for i = 1, 4 do
		local angle = (i / 4) * math.pi * 2
		add(BLOCK, Vector3.new(0.4, 1, 0.4), Vector3.new(math.cos(angle) * 0.9, 0.8, math.sin(angle) * 0.9), GOLD, FOIL)
	end
	add(BALL, Vector3.new(0.5, 0.5, 0.5), Vector3.new(0, 0, -1.2), rgb(255, 50, 90), NEON)
	for _, entry in ipairs(parts) do
		local part, offset = entry.Part, entry.Offset
		local rot = if part.Shape == CYL then CFrame.Angles(0, 0, math.rad(90)) else CFrame.identity
		tween(run, part, 0.6, { CFrame = CFrame.new(top + offset) * rot }, Enum.EasingStyle.Back)
		tween(run, part, 0.4, { Transparency = 1 }, nil, nil, 1.7)
	end
	emit("Confetti", top, 18, { GOLD, rgb(255, 240, 150), rgb(255, 255, 255) })
	return 2.2
end

-- ---------------------------------------------------------------------
-- 4) ÖFFENTLICH
-- ---------------------------------------------------------------------
local function farFromCamera(pos: Vector3): boolean
	local camera = workspace.CurrentCamera
	return camera ~= nil and (camera.CFrame.Position - pos).Magnitude > HIDE_DISTANCE
end

function Finishers.Play(id: string, pos: Vector3, color: Color3)
	if not Util.IsFiniteVector(pos) or farFromCamera(pos) then
		return -- > 300 Studs: ausgeblendet
	end
	local tint = if typeof(color) == "Color3" then color else PALETTE[1]
	if active >= MAX_ACTIVE then
		emit("Confetti", pos, 12, { tint, PALETTE[2], PALETTE[4] }) -- Budget voll: nur Konfetti
		return
	end
	local builder = Builders[if type(id) == "string" then id else DEFAULT_ID] or Builders[DEFAULT_ID]
	active += 1
	local run = newRun()
	local ok, duration = pcall(builder, run, pos, tint)
	if not ok then
		warn("[Finishers] " .. tostring(id) .. ": " .. tostring(duration))
		duration = 0.1
	end
	finish(run, tonumber(duration) or MAX_DURATION)
end

function Finishers.Preview(id: string)
	local player = ctx and ctx.Player or Players.LocalPlayer
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	local pos: Vector3
	if root and root:IsA("BasePart") then
		pos = root.Position + root.CFrame.LookVector * 9 + Vector3.new(0, 1, 0)
	elseif camera then
		pos = camera.CFrame.Position + camera.CFrame.LookVector * 14
	else
		return
	end
	Finishers.Play(id, pos, Config.Colors and Config.Colors.TeamA or PALETTE[1])
end

function Finishers.Active(): number
	return active
end

function Finishers.Init(c: any)
	ctx = c
end

function Finishers.Start()
	-- Pool/Emitter erst beim ersten Effekt anlegen (spart Teile, solange niemand gepoppt wird)
end

return Finishers
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">Fly</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Fliegen / Schweben (Client/Modules/Fly)
--  Besitzer: WP7 (Sicherheit, Admin, Live-Balance). Basis: Meteor-Heist-Fly (REUSE §1.4, COPY).
--  Nur wenn der Server es erlaubt (Attribut CanFly, nur der Besitzer hat es). Taste G (Config.Client.Keys.Fly).
--  WASD/Stick = Richtung (folgt der Kamera, auch hoch/runter), Leertaste = hoch, Strg/C = runter, Shift = schneller.
--  Beim Losfliegen meldet der Client SetPower{CanFly} an den Server -> im Match wird es "TAINTED" (B25.2).
--  Der Anti-Cheat nimmt Admins aus (AntiCheatService).
--
--  Öffentliche API (C7.4):
--    Fly.Toggle()
--    Fly.IsFlying(): boolean
--    Fly.Init(ctx) / Fly.Start()
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Fly = {}

local player = Players.LocalPlayer
local ctx: any = nil

local DEFAULT_SPEED = 70
local BOOST = 2 -- Shift = doppelt so schnell

local flying = false
local flyParts: { Instance } = {}
local flyConnection: RBXScriptConnection? = nil

local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function toast(text: string, kind: string)
	if ctx and type(ctx.Toast) == "function" then
		ctx.Toast(text, kind)
	end
end

local function flySpeed(): number
	local security = ctx and ctx.Config and ctx.Config.Security
	local powers = security and security.Powers
	local speed = powers and tonumber(powers.FlySpeed)
	return if speed and speed > 0 then speed else DEFAULT_SPEED
end

local function keyDown(...: Enum.KeyCode): boolean
	for _, key in ipairs({ ... }) do
		if UserInputService:IsKeyDown(key) then
			return true
		end
	end
	return false
end

local function stopFlying()
	flying = false
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	for _, inst in ipairs(flyParts) do
		inst:Destroy()
	end
	flyParts = {}
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = false
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
end

local function startFlying()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart or not rootPart:IsA("BasePart") or humanoid.Health <= 0 then
		return
	end
	if rootPart.Anchored then
		return -- eingefroren / im Tresor
	end
	local root: BasePart = rootPart
	flying = true
	local attachment = Instance.new("Attachment")
	attachment.Name = "CC_FlyAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "CC_FlyVelocity"
	velocity.Attachment0 = attachment
	velocity.MaxForce = 1e7
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Name = "CC_FlyAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.MaxTorque = 1e7
	align.Responsiveness = 40
	align.CFrame = root.CFrame.Rotation
	align.Parent = root
	flyParts = { attachment, velocity, align }
	humanoid.PlatformStand = true

	local speed = flySpeed()
	flyConnection = RunService.PreRender:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera or not root.Parent or humanoid.Health <= 0 or root.Anchored then
			stopFlying()
			return
		end
		local look = camera.CFrame.LookVector
		local move = humanoid.MoveDirection -- Tastatur, Gamepad und Handy-Stick
		local direction = Vector3.zero
		if move.Magnitude > 0.05 then
			local flatLook = Vector3.new(look.X, 0, look.Z)
			local forwardAmount = if flatLook.Magnitude > 0.01 then move:Dot(flatLook.Unit) else 0
			direction = move + Vector3.new(0, look.Y * math.max(forwardAmount, 0) * 1.5, 0)
		end
		local boost = 1
		if not UserInputService:GetFocusedTextBox() then
			if keyDown(Enum.KeyCode.Space, Enum.KeyCode.ButtonA) then
				direction += Vector3.new(0, 1, 0)
			end
			if keyDown(Enum.KeyCode.LeftControl, Enum.KeyCode.C, Enum.KeyCode.ButtonB) then
				direction -= Vector3.new(0, 1, 0)
			end
			if keyDown(Enum.KeyCode.LeftShift) then
				boost = BOOST
			end
		end
		velocity.VectorVelocity = if direction.Magnitude > 0.01 then direction.Unit * speed * boost else Vector3.zero
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.01 then
			align.CFrame = CFrame.lookAt(Vector3.zero, flat)
		end
	end)

	-- Server erfährt es (Taint im Match); Antwort egal
	local remotes = ctx and ctx.Remotes
	local admin = remotes and remotes.Admin
	if admin and admin:IsA("RemoteFunction") then
		task.spawn(function()
			pcall(function()
				admin:InvokeServer("SetPower", { Name = "CanFly", Value = true })
			end)
		end)
	end
end

function Fly.IsFlying(): boolean
	return flying
end

function Fly.Toggle()
	if flying then
		stopFlying()
		toast(T("admin.flyOff"), "Info")
	elseif player:GetAttribute("CanFly") == true and player:GetAttribute("IsAdmin") == true then
		startFlying()
		if flying then
			toast(T("admin.flyOn"), "Success")
		end
	end
end

local function keyCodes(): { Enum.KeyCode }
	local out: { Enum.KeyCode } = {}
	local keys = ctx and ctx.Config and ctx.Config.Client and ctx.Config.Client.Keys
	local names = if keys and type(keys.Fly) == "table" then keys.Fly else { "G" }
	for _, name in ipairs(names) do
		local ok, code = pcall(function()
			return (Enum.KeyCode :: any)[name]
		end)
		if ok and typeof(code) == "EnumItem" then
			table.insert(out, code :: any)
		end
	end
	return out
end

function Fly.Init(context: any)
	ctx = context
end

function Fly.Start()
	local controls = ctx and ctx.Modules and ctx.Modules.Controls
	local bound = false
	if controls and type(controls.Bind) == "function" then
		bound = pcall(controls.Bind, "Fly", function(state: string)
			if state == "Begin" then
				Fly.Toggle()
			end
		end)
	end
	if not bound then
		local codes = keyCodes()
		UserInputService.InputBegan:Connect(function(input, processed)
			if processed or UserInputService:GetFocusedTextBox() then
				return
			end
			if table.find(codes, input.KeyCode) then
				Fly.Toggle()
			end
		end)
	end
	player.CharacterAdded:Connect(function()
		if flying then
			stopFlying()
		end
	end)
	player:GetAttributeChangedSignal("CanFly"):Connect(function()
		if player:GetAttribute("CanFly") ~= true and flying then
			stopFlying()
		end
	end)
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		hooks.On("LocalPopped", function()
			if flying then
				stopFlying()
			end
		end)
	end
end

return Fly
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">FpsCamera</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Ego-Kamera: Modi, FOV, Rückstoß, Wackeln, Zielfernrohr (Client/Modules/FpsCamera)
--  Besitzer: WP4 (Kampf Client). Vertrag: DESIGN.md C7.4, B11.1 (Rückstoß), B12 (Rutschen), B15.2/B15.3.
--
--  Prinzip: Das Roblox-Kameramodul dreht die Kamera (bei RenderPriority.Camera) und liest dafür jeden
--  Frame die aktuelle Kamera-Blickrichtung. Wir laufen bei Camera + 1, messen die Dreh-Änderung seit
--  unserem letzten Bild (= reine Blick-Eingabe), formen sie um (Empfindlichkeit Gamepad/Touch, Y-Invertieren,
--  Zielhilfe – NIE Maus) und setzen das Bild = Basis-Blick + Rückstoß-Feder + Wackeln.
--  -> Rückstoß und Wackeln "lecken" nie in die Basis: kein Drift. Pitch immer innerhalb ±80°.
--
--  Öffentliche API (C7.4):
--    FpsCamera.SetMode(mode)              "Lobby" | "Match" | "Range" | "Spectate" | "Menu"
--        Match/Range = LockFirstPerson (Zoom 0.5), Maus-Symbol aus, Reset-Knopf aus (nur Match)
--        Lobby = Classic (max. Config.Player.LobbyZoomMax), Spectate = Classic, Menu = Maus frei
--    FpsCamera.Kick(pitchDeg, yawDeg, recover?)   Rückstoß: 85 % erholen sich über recover s, 15 % bleiben
--    FpsCamera.SetAds(alpha, zoom)        ADS-Anteil 0..1 + Zoom (FOV = Einstellung / Zoom)
--    FpsCamera.AddLookDelta(dxRad, dyRad) Touch-Feuerknopf-Ziehen; Maus-Konvention (+dx rechts, +dy runter),
--                                         SensTouch wendet der Aufrufer an, FpsCamera nur den ADS-/Fernrohr-Faktor
--    FpsCamera.Shake(intensity, duration) absolutes Wackeln (Einstellung "Kamerawackeln" skaliert)
--    FpsCamera.SetScope(on)               Zielfernrohr-Overlay, Viewmodel aus
--  Zusätzlich (WP4-intern, nil-sicher nutzbar):
--    FpsCamera.SetFovOffset(key, deg)     z. B. Rutschen +6 (wird beim Zielen ausgeblendet)
--    FpsCamera.Punch(deg)                 kurzer FOV-Stoß (Pop +3)
--    FpsCamera.Mode(): string             aktueller Modus
--  Einziger FOV-Besitzer: Einstellung Fov (70–100), ADS fov/zoom, Rutschen, Punch.
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Spring = require(Shared:WaitForChild("Spring"))

local FpsCamera = {}

type Mode = "Lobby" | "Match" | "Range" | "Spectate" | "Menu"

local player = Players.LocalPlayer
local ctx: any = nil

-- ---------------------------------------------------------------------
-- 1) KONSTANTEN
-- ---------------------------------------------------------------------
local PITCH_LIMIT = math.rad(80)
local RECOIL_KEEP = 0.15 -- 15 % bleiben (Rückstoß kontrollieren = Skill), 85 % erholen sich
local EXTERNAL_JUMP = 1.2 -- rad pro Frame: größer = jemand anderes hat die Kamera gesetzt
local FOV_MIN, FOV_MAX = 70, 100
local LOOK_DELTA_CAP = 0.5 -- rad pro AddLookDelta-Aufruf
local SHAKE_DEG = 1.1 -- Grad bei Intensität 1
local DEFAULT_LOBBY_ZOOM = 14

-- ---------------------------------------------------------------------
-- 2) ZUSTAND
-- ---------------------------------------------------------------------
local mode: Mode = "Lobby"
local modeBeforeMenu: Mode = "Lobby"
local windowOpen = false

local adsAlpha = 0
local adsZoom = 1
local scopeOn = false

local fovOffsets: { [string]: number } = {}
local fovExtra = 0 -- geglättete Summe der Offsets
local punch = 0

local hasLast = false
local baseYaw, basePitch = 0, 0
local lastYaw, lastPitch = 0, 0
local pendingLook = Vector2.zero

-- Rückstoß: kritisch gedämpfte Feder um 0 (x = Pitch rad, y = Yaw rad). Ein Kick = Geschwindigkeits-Stoß,
-- Spitze = 85 % des Kicks nach 1/ω s, zurück auf ~5 % nach RecoilRecover s. Die bleibenden 15 % wandern
-- weich (exponentiell, exakt summiert) in den Basis-Blick -> kein Drift.
local recoilSpring = Spring.new(Vector3.zero, 13, 1)
local pendingPerm = Vector3.zero
local permRate = 20
local windowPoll = 0

local shakeIntensity = 0
local shakeDuration = 0
local shakeUntil = 0
local shakeSeed = math.random() * 100

local originalMouseSens: number = 1
local appliedMouseSens: number? = nil
local appliedIcon: boolean? = nil
local settingsCache: { [string]: any }? = nil
local resetToken = 0
local zoomToken = 0

local scopeGui: ScreenGui? = nil
local scopeHole: Frame? = nil
local scopeStroke: UIStroke? = nil
local scopeBars: { Frame } = {}

-- ---------------------------------------------------------------------
-- 3) HELFER
-- ---------------------------------------------------------------------
local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function wrapAngle(a: number): number
	return (a + math.pi) % (2 * math.pi) - math.pi
end

local function toYawPitch(look: Vector3): (number, number)
	return math.atan2(-look.X, -look.Z), math.asin(math.clamp(look.Y, -1, 1))
end

local function modules(): { [string]: any }
	return if ctx and type(ctx.Modules) == "table" then ctx.Modules else {}
end

local function settings(): { [string]: any }
	if settingsCache then
		return settingsCache
	end
	local result: { [string]: any } = {}
	local mod = modules().Settings
	if mod and type(mod.Get) == "function" then
		local ok, value = pcall(mod.Get)
		if ok and type(value) == "table" then
			result = value
		end
	elseif ctx and type(ctx.State) == "table" and type(ctx.State.Settings) == "table" then
		result = ctx.State.Settings
	end
	settingsCache = result
	return result
end

local function setting(key: string, default: any): any
	local value = settings()[key]
	if value == nil then
		local defaults = ctx and ctx.Config and ctx.Config.Client and ctx.Config.Client.DefaultSettings
		if type(defaults) == "table" and defaults[key] ~= nil then
			return defaults[key]
		end
		return default
	end
	return value
end

local function numberSetting(key: string, default: number, lo: number, hi: number): number
	local value = setting(key, default)
	if not finite(value) then
		return default
	end
	return math.clamp(value, lo, hi)
end

local function inputKind(): string
	local controls = modules().Controls
	if controls and type(controls.Input) == "function" then
		local ok, kind = pcall(controls.Input)
		if ok and type(kind) == "string" then
			return kind
		end
	end
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "Touch"
	elseif last.Name:sub(1, 7) == "Gamepad" then
		return "Gamepad"
	end
	return "KBM"
end

local function armedMode(): boolean
	return mode == "Match" or mode == "Range"
end

local function anyWindowOpen(): boolean
	local ui = ctx and ctx.UI
	if ui and type(ui.IsAnyWindowOpen) == "function" then
		local ok, open = pcall(ui.IsAnyWindowOpen)
		if ok then
			return open == true
		end
	end
	local windows = ctx and ctx.Windows
	if windows and type(windows.IsOpen) == "function" then
		local ok, open = pcall(windows.IsOpen)
		if ok then
			return open == true
		end
	end
	return windowOpen
end

-- ADS-Empfindlichkeit (Einstellungen AdsMult / ScopeMult)
local function adsFactor(): number
	if scopeOn then
		return numberSetting("ScopeMult", 0.6, 0.2, 1.5)
	end
	local ads = numberSetting("AdsMult", 0.8, 0.2, 1.5)
	return 1 + (ads - 1) * adsAlpha
end

local function lobbyZoom(): number
	local value = ctx and ctx.Config and ctx.Config.Player and ctx.Config.Player.LobbyZoomMax
	return if finite(value) then value else DEFAULT_LOBBY_ZOOM
end

-- ---------------------------------------------------------------------
-- 4) MAUS, RESET-KNOPF, ZOOM
-- ---------------------------------------------------------------------
local function applyMouse()
	local armedNow = armedMode() and not windowOpen
	local iconOn = not armedNow
	if appliedIcon ~= iconOn then
		-- nur bei Zustandswechsel schreiben (andere Module dürfen das Symbol sonst frei setzen)
		appliedIcon = iconOn
		UserInputService.MouseIconEnabled = iconOn
	end
	local wanted = originalMouseSens
	if armedNow then
		wanted = originalMouseSens * (numberSetting("SensMouse", 0.5, 0.05, 2) / 0.5) * adsFactor()
	end
	if appliedMouseSens == nil or math.abs(wanted - appliedMouseSens) > 1e-3 then
		appliedMouseSens = wanted
		UserInputService.MouseDeltaSensitivity = wanted
	end
end

-- SetCore kann vor dem Laden der CoreScripts fehlschlagen -> mit Wiederholung (gebunden)
local function setResetButton(enabled: boolean)
	resetToken += 1
	local token = resetToken
	task.spawn(function()
		for _ = 1, 12 do
			if token ~= resetToken then
				return
			end
			local ok = pcall(function()
				StarterGui:SetCore("ResetButtonCallback", enabled)
			end)
			if ok then
				return
			end
			task.wait(0.5)
		end
	end)
end

-- Classic: kurz Mindest-Zoom setzen, damit die Kamera aus der Ego-Sicht herausfährt
local function zoomOut(distance: number, maxZoom: number)
	zoomToken += 1
	local token = zoomToken
	player.CameraMode = Enum.CameraMode.Classic
	player.CameraMaxZoomDistance = maxZoom
	player.CameraMinZoomDistance = math.min(distance, maxZoom)
	task.delay(0.15, function()
		if token == zoomToken then
			player.CameraMinZoomDistance = 0.5
		end
	end)
end

-- ---------------------------------------------------------------------
-- 5) ZIELFERNROHR-OVERLAY (Frame-Ring mit dicker UIStroke + Randbalken)
-- ---------------------------------------------------------------------
local function layoutScope()
	local gui = scopeGui
	local hole = scopeHole
	local stroke = scopeStroke
	local camera = workspace.CurrentCamera
	if not (gui and hole and stroke and camera) then
		return
	end
	local vp = camera.ViewportSize
	local d = math.floor(math.min(vp.X, vp.Y) * 0.92)
	hole.Size = UDim2.fromOffset(d, d)
	stroke.Thickness = math.ceil(d * 0.32)
	local half = d / 2
	-- links, rechts, oben, unten: alles außerhalb des Quadrats schwarz
	local bars = scopeBars
	if #bars == 4 then
		bars[1].Position = UDim2.fromOffset(0, 0)
		bars[1].Size = UDim2.new(0.5, -half + 1, 1, 0)
		bars[2].Position = UDim2.new(0.5, half - 1, 0, 0)
		bars[2].Size = UDim2.new(0.5, -half + 1, 1, 0)
		bars[3].Position = UDim2.fromOffset(0, 0)
		bars[3].Size = UDim2.new(1, 0, 0.5, -half + 1)
		bars[4].Position = UDim2.new(0, 0, 0.5, half - 1)
		bars[4].Size = UDim2.new(1, 0, 0.5, -half + 1)
	end
end

local function buildScope()
	local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 10)
	if not playerGui then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "CC_Scope"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = -1 -- unter dem HUD
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false

	local hole = Instance.new("Frame")
	hole.Name = "Lens"
	hole.AnchorPoint = Vector2.new(0.5, 0.5)
	hole.Position = UDim2.fromScale(0.5, 0.5)
	hole.BackgroundTransparency = 1
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = hole
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = hole
	-- innerer Linsenrand
	local rim = Instance.new("Frame")
	rim.Name = "Rim"
	rim.AnchorPoint = Vector2.new(0.5, 0.5)
	rim.Position = UDim2.fromScale(0.5, 0.5)
	rim.Size = UDim2.fromScale(1, 1)
	rim.BackgroundTransparency = 1
	local rimCorner = Instance.new("UICorner")
	rimCorner.CornerRadius = UDim.new(0.5, 0)
	rimCorner.Parent = rim
	local rimStroke = Instance.new("UIStroke")
	rimStroke.Color = Color3.fromRGB(28, 32, 64)
	rimStroke.Thickness = 6
	rimStroke.Transparency = 0.2
	rimStroke.Parent = rim
	rim.Parent = hole
	-- Fadenkreuz-Linien (dünn, schwarz) + roter Punkt
	local function line(size: UDim2, pos: UDim2)
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Size = size
		f.Position = pos
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.new(0, 0, 0)
		f.BackgroundTransparency = 0.15
		f.Parent = hole
	end
	line(UDim2.new(1, 0, 0, 2), UDim2.fromScale(0.5, 0.5))
	line(UDim2.new(0, 2, 1, 0), UDim2.fromScale(0.5, 0.5))
	line(UDim2.new(0.18, 0, 0, 5), UDim2.fromScale(0.09, 0.5))
	line(UDim2.new(0.18, 0, 0, 5), UDim2.fromScale(0.91, 0.5))
	line(UDim2.new(0, 5, 0.18, 0), UDim2.fromScale(0.5, 0.91))
	local dot = Instance.new("Frame")
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(6, 6)
	dot.BorderSizePixel = 0
	dot.BackgroundColor3 = Color3.fromRGB(255, 59, 59)
	local dotCorner = Instance.new("UICorner")
	dotCorner.CornerRadius = UDim.new(0.5, 0)
	dotCorner.Parent = dot
	dot.Parent = hole
	hole.Parent = gui

	local bars: { Frame } = {}
	for i = 1, 4 do
		local bar = Instance.new("Frame")
		bar.Name = "Bar" .. i
		bar.BorderSizePixel = 0
		bar.BackgroundColor3 = Color3.new(0, 0, 0)
		bar.Parent = gui
		bars[i] = bar
	end

	scopeGui = gui
	scopeHole = hole
	scopeStroke = stroke
	scopeBars = bars
	layoutScope()
	gui.Parent = playerGui
end

-- ---------------------------------------------------------------------
-- 6) FOV (einziger Besitzer)
-- ---------------------------------------------------------------------
local function applyFov(camera: Camera, dt: number)
	local base = numberSetting("Fov", 80, FOV_MIN, FOV_MAX)
	local target = 0
	for _, deg in pairs(fovOffsets) do
		target += deg
	end
	local k = 1 - math.exp(-dt * 12)
	fovExtra += (target - fovExtra) * k
	punch *= math.exp(-dt * 9)
	if math.abs(punch) < 1e-3 then
		punch = 0
	end
	local fov = base
	if armedMode() then
		local zoom = math.max(1, adsZoom)
		fov = base / (1 + (zoom - 1) * adsAlpha) + fovExtra * (1 - adsAlpha) + punch
	elseif mode ~= "Menu" then
		fov = base + punch
	else
		fov = camera.FieldOfView
	end
	fov = math.clamp(fov, 1, 120)
	if math.abs(camera.FieldOfView - fov) > 0.01 then
		camera.FieldOfView = fov
	end
end

-- ---------------------------------------------------------------------
-- 7) WACKELN (absolut, nie in der Basis)
-- ---------------------------------------------------------------------
local function shakeOffsets(now: number): (number, number, number)
	if now >= shakeUntil or shakeIntensity <= 0 then
		return 0, 0, 0
	end
	local scale = numberSetting("Shake", 1, 0, 1)
	if scale <= 0 then
		return 0, 0, 0
	end
	local fade = math.clamp((shakeUntil - now) / math.max(shakeDuration, 1e-3), 0, 1)
	local amp = math.rad(SHAKE_DEG) * shakeIntensity * scale * fade * fade
	local t = now * 22
	return math.noise(t, shakeSeed, 0) * amp, math.noise(shakeSeed, t, 0) * amp, math.noise(0, shakeSeed, t) * amp * 1.3
end

-- ---------------------------------------------------------------------
-- 8) KAMERA-SCHRITT (RenderPriority.Camera + 1)
-- ---------------------------------------------------------------------
local function aimAssistFilter(dt: number, look: Vector2, kind: string): Vector2
	if kind ~= "Gamepad" and kind ~= "Touch" then
		return look -- nie Maus
	end
	local assist = modules().AimAssist
	if assist and type(assist.Filter) == "function" then
		local ok, result = pcall(assist.Filter, dt, look, kind)
		if ok and typeof(result) == "Vector2" and result.X == result.X and result.Y == result.Y then
			return result
		end
	end
	return look
end

local function onCamera(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local scriptable = camera.CameraType == Enum.CameraType.Scriptable
	if not scriptable then
		applyFov(camera, dt)
	end
	-- Fenster, die am Hook vorbei geöffnet/geschlossen wurden, trotzdem erkennen (2 Hz)
	windowPoll += dt
	if windowPoll >= 0.5 then
		windowPoll = 0
		local open = anyWindowOpen()
		if open ~= windowOpen then
			windowOpen = open
		end
		if mode == "Menu" and not open then
			FpsCamera.SetMode(modeBeforeMenu)
		end
	end
	applyMouse()
	if not armedMode() or scriptable or windowOpen then
		hasLast = false
		pendingLook = Vector2.zero
		pendingPerm = Vector3.zero
		recoilSpring.Position = Vector3.zero
		recoilSpring.Velocity = Vector3.zero
		return
	end

	local cur = camera.CFrame
	local yaw, pitch = toYawPitch(cur.LookVector)
	if not hasLast then
		hasLast = true
		baseYaw, basePitch = yaw, math.clamp(pitch, -PITCH_LIMIT, PITCH_LIMIT)
		lastYaw, lastPitch = yaw, pitch
	end
	local dYaw = wrapAngle(yaw - lastYaw)
	local dPitch = pitch - lastPitch
	if math.abs(dYaw) > EXTERNAL_JUMP or math.abs(dPitch) > EXTERNAL_JUMP then
		-- fremd gesetzt (Teleport, Respawn, Admin): übernehmen statt umrechnen
		baseYaw, basePitch = yaw, math.clamp(pitch, -PITCH_LIMIT, PITCH_LIMIT)
		dYaw, dPitch = 0, 0
	end

	-- Blick-Eingabe in Maus-Konvention (+x rechts, +y runter)
	local kind = inputKind()
	local look = Vector2.new(-dYaw, -dPitch)
	local factor = adsFactor()
	if kind == "Gamepad" then
		look *= (numberSetting("SensPad", 0.5, 0.05, 2) / 0.5) * factor
	elseif kind == "Touch" then
		look *= (numberSetting("SensTouch", 0.6, 0.05, 2) / 0.6) * factor
	end
	if pendingLook ~= Vector2.zero then
		look += pendingLook * factor -- SensTouch hat der Aufrufer (TouchControls) schon angewendet
		pendingLook = Vector2.zero
		if kind == "KBM" then
			kind = "Touch" -- Feuerknopf-Ziehen ist immer Touch
		end
	end
	if setting("InvertY", false) == true then
		look = Vector2.new(look.X, -look.Y)
	end
	look = aimAssistFilter(dt, look, kind)

	baseYaw = wrapAngle(baseYaw - look.X)
	basePitch = math.clamp(basePitch - look.Y, -PITCH_LIMIT, PITCH_LIMIT)

	-- bleibender Rückstoß-Anteil weich in die Basis (Summe exakt)
	if pendingPerm ~= Vector3.zero then
		local move = pendingPerm * (1 - math.exp(-dt * permRate))
		if pendingPerm.Magnitude < 1e-6 then
			move = pendingPerm
		end
		pendingPerm -= move
		basePitch = math.clamp(basePitch + move.X, -PITCH_LIMIT, PITCH_LIMIT)
		baseYaw = wrapAngle(baseYaw + move.Y)
	end
	-- federnder Anteil
	local r = recoilSpring:Step(dt)
	if r.Magnitude < 1e-6 and recoilSpring.Velocity.Magnitude < 1e-5 then
		recoilSpring.Position = Vector3.zero
		recoilSpring.Velocity = Vector3.zero
		r = Vector3.zero
	end

	local now = os.clock()
	local sp, sy, sr = shakeOffsets(now)
	local renderPitch = math.clamp(basePitch + r.X + sp, -PITCH_LIMIT, PITCH_LIMIT)
	local renderYaw = wrapAngle(baseYaw + r.Y + sy)
	camera.CFrame = CFrame.new(cur.Position) * CFrame.fromOrientation(renderPitch, renderYaw, sr)
	lastYaw, lastPitch = renderYaw, renderPitch
end

-- ---------------------------------------------------------------------
-- 9) ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function FpsCamera.SetMode(newMode: Mode)
	if
		newMode ~= "Lobby"
		and newMode ~= "Match"
		and newMode ~= "Range"
		and newMode ~= "Spectate"
		and newMode ~= "Menu"
	then
		return
	end
	if newMode == "Menu" then
		if mode ~= "Menu" then
			modeBeforeMenu = mode
		end
		mode = "Menu"
		hasLast = false
		applyMouse()
		return
	end
	local previous = mode
	mode = newMode
	hasLast = false
	if newMode == "Match" or newMode == "Range" then
		zoomToken += 1
		player.CameraMaxZoomDistance = 0.5
		player.CameraMinZoomDistance = 0.5
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		setResetButton(newMode ~= "Match")
	else
		FpsCamera.SetScope(false)
		adsAlpha = 0
		adsZoom = 1
		table.clear(fovOffsets)
		if newMode == "Lobby" then
			if previous ~= "Lobby" then
				zoomOut(10, lobbyZoom())
			end
			setResetButton(true)
		else -- Spectate
			if previous == "Match" or previous == "Range" then
				zoomOut(8, lobbyZoom())
			end
		end
	end
	applyMouse()
end

function FpsCamera.Mode(): string
	return mode
end

function FpsCamera.Kick(pitchDeg: number, yawDeg: number, recover: number?)
	if not (finite(pitchDeg) and finite(yawDeg)) then
		return
	end
	local p = math.rad(math.clamp(pitchDeg, -20, 20))
	local y = -math.rad(math.clamp(yawDeg, -20, 20)) -- +yawDeg = nach rechts
	local seconds = if finite(recover) then math.clamp(recover :: number, 0.1, 2) else 0.35
	-- kritisch gedämpft: x(t) = v0·t·e^(−ωt) -> Spitze v0/(ω·e) nach 1/ω, ~5 % Rest nach 4.7/ω
	local omega = math.clamp(4.7 / seconds, 6, 30)
	recoilSpring.Speed = omega
	recoilSpring.Damper = 1
	local kick = Vector3.new(p, y, 0)
	recoilSpring:Impulse(kick * (1 - RECOIL_KEEP) * omega * math.exp(1))
	pendingPerm += kick * RECOIL_KEEP
	permRate = omega * 1.5
end

function FpsCamera.SetAds(alpha: number, zoom: number)
	adsAlpha = if finite(alpha) then math.clamp(alpha, 0, 1) else 0
	adsZoom = if finite(zoom) then math.clamp(zoom, 1, 10) else 1
end

function FpsCamera.AddLookDelta(dxRad: number, dyRad: number)
	if not (finite(dxRad) and finite(dyRad)) then
		return
	end
	pendingLook += Vector2.new(
		math.clamp(dxRad, -LOOK_DELTA_CAP, LOOK_DELTA_CAP),
		math.clamp(dyRad, -LOOK_DELTA_CAP, LOOK_DELTA_CAP)
	)
end

function FpsCamera.Shake(intensity: number, duration: number)
	if not (finite(intensity) and finite(duration)) or intensity <= 0 or duration <= 0 then
		return
	end
	local now = os.clock()
	local remaining = if now < shakeUntil
		then shakeIntensity * (shakeUntil - now) / math.max(shakeDuration, 1e-3)
		else 0
	shakeIntensity = math.clamp(math.max(intensity, remaining), 0, 4)
	shakeDuration = math.clamp(duration, 0.05, 3)
	shakeUntil = now + shakeDuration
	shakeSeed = math.random() * 100
end

function FpsCamera.SetScope(on: boolean)
	local want = on == true
	if want == scopeOn then
		return
	end
	scopeOn = want
	if scopeGui then
		scopeGui.Enabled = want
	end
	local viewmodel = modules().Viewmodel
	if viewmodel then
		if type(viewmodel.HideFor) == "function" then
			pcall(viewmodel.HideFor, "Scope", want)
		elseif type(viewmodel.SetHidden) == "function" then
			pcall(viewmodel.SetHidden, want)
		end
	end
end

function FpsCamera.SetFovOffset(key: string, deg: number)
	if type(key) ~= "string" then
		return
	end
	if not finite(deg) or deg == 0 then
		fovOffsets[key] = nil
	else
		fovOffsets[key] = math.clamp(deg, -30, 30)
	end
end

function FpsCamera.Punch(deg: number)
	if finite(deg) then
		punch = math.clamp(punch + deg, -15, 15)
	end
end

-- ---------------------------------------------------------------------
-- 10) MODUL-FORM
-- ---------------------------------------------------------------------
function FpsCamera.Init(context: any)
	ctx = context
	originalMouseSens = UserInputService.MouseDeltaSensitivity
	if not finite(originalMouseSens) or originalMouseSens <= 0 then
		originalMouseSens = 1
	end
	buildScope()
end

function FpsCamera.Start()
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		hooks.On("Settings", function()
			settingsCache = nil
		end)
		hooks.On("State", function(_state: any, changed: any)
			if type(changed) == "table" and changed.Settings then
				settingsCache = nil
			end
		end)
		hooks.On("WindowOpened", function()
			windowOpen = true
			applyMouse()
		end)
		hooks.On("WindowClosed", function()
			task.defer(function()
				windowOpen = anyWindowOpen()
				applyMouse()
			end)
		end)
	end
	local function watchCamera(camera: Camera?)
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(layoutScope)
			layoutScope()
		end
	end
	watchCamera(workspace.CurrentCamera)
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		hasLast = false
		watchCamera(workspace.CurrentCamera)
	end)
	player.CharacterAdded:Connect(function()
		hasLast = false
	end)

	RunService:BindToRenderStep("CC_FpsCamera", Enum.RenderPriority.Camera.Value + 1, onCamera)
	FpsCamera.SetMode("Lobby")
end

return FpsCamera
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">Highlights</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Zentraler Highlight-Verteiler (Client/Modules/Highlights)
--  Besitzer: WP10 (Client-Hülle). Vertrag: DESIGN.md C7.4, B14.4.
--
--  Roblox zeigt höchstens 31 Highlights gleichzeitig – mehr werden einfach nicht gezeichnet.
--  Darum holt sich JEDES Modul seine Highlights hier ab (Gegner-Umrisse, Admin-ESP ≤ 20, …).
--  Feste Vorräte: ein Highlight wird nach Release wiederverwendet, nie neu gebaut.
--
--  Öffentliche API:
--    Highlights.Acquire(owner, adornee, props): handle?    nil, wenn das Budget (31) voll ist
--        props { Outline: Color3?, Fill: Color3?, FillTransparency: number?, Depth: Enum.HighlightDepthMode? }
--    Highlights.Update(handle, props)          Farben/Tiefe eines vorhandenen Handles ändern
--    Highlights.Release(handle)                Highlights.ReleaseOwner(owner)
--    Highlights.Count(): number                Highlights.CountOwner(owner): number
--    Highlights.Pulse(owner, seconds)          alle Handles des Owners kurz auf AlwaysOnTop (Anti-Camp)
--    Highlights.Init(ctx) / Highlights.Start()
--  Owner-Grenzen: "AdminESP" ≤ 20 (B14.4). Verschwindet das Ziel (Character weg), wird automatisch freigegeben.
-- =====================================================================

local Highlights = {}

type Props = {
	Outline: Color3?,
	Fill: Color3?,
	FillTransparency: number?,
	Depth: Enum.HighlightDepthMode?,
}

export type Handle = {
	Id: number,
	Owner: string,
	Highlight: Highlight,
	Adornee: Instance,
	Depth: Enum.HighlightDepthMode,
	PulseUntil: number,
	Conn: RBXScriptConnection?,
	Alive: boolean,
}

local DEFAULT_CAP = 31
local OWNER_CAPS: { [string]: number } = { AdminESP = 20 }
local WHITE = Color3.new(1, 1, 1)

local ctx: any = nil
local cap = DEFAULT_CAP
local folder: Folder? = nil
local free: { Highlight } = {}
local created = 0
local active: { [Handle]: boolean } = {}
local activeCount = 0
local ownerCount: { [string]: number } = {}
local nextId = 0
local pulseToken: { [string]: number } = {}

local function getFolder(): Folder
	local current = folder
	if current and current.Parent then
		return current
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = "ClutchClashHighlights"
	newFolder.Parent = workspace
	folder = newFolder
	return newFolder
end

local function takeHighlight(): Highlight?
	local highlight = table.remove(free)
	if highlight and highlight.Parent ~= nil then
		return highlight
	end
	-- (zerstört? dann zählt es nicht mehr zum Vorrat)
	if highlight then
		created -= 1
	end
	if created >= cap then
		return nil
	end
	created += 1
	local newHighlight = Instance.new("Highlight")
	newHighlight.Name = "CCHighlight"
	newHighlight.Enabled = false
	newHighlight.Parent = getFolder()
	return newHighlight
end

local function applyProps(handle: Handle, props: Props?)
	local highlight = handle.Highlight
	local p: Props = props or {}
	highlight.OutlineColor = p.Outline or highlight.OutlineColor
	highlight.OutlineTransparency = 0
	highlight.FillColor = p.Fill or (p.Outline or WHITE)
	local fillT = p.FillTransparency
	if type(fillT) == "number" and fillT == fillT then
		highlight.FillTransparency = math.clamp(fillT, 0, 1)
	elseif props then
		highlight.FillTransparency = 1 -- Standard: nur Umriss (B14.4)
	end
	if p.Depth then
		handle.Depth = p.Depth
	end
	highlight.DepthMode = if os.clock() < handle.PulseUntil then Enum.HighlightDepthMode.AlwaysOnTop else handle.Depth
end

function Highlights.Release(handle: any)
	if type(handle) ~= "table" or not active[handle] then
		return
	end
	local h: Handle = handle
	active[h] = nil
	h.Alive = false
	activeCount -= 1
	ownerCount[h.Owner] = math.max(0, (ownerCount[h.Owner] or 1) - 1)
	if h.Conn then
		h.Conn:Disconnect()
		h.Conn = nil
	end
	local highlight = h.Highlight
	if highlight.Parent ~= nil then
		highlight.Enabled = false
		highlight.Adornee = nil
		table.insert(free, highlight)
	else
		created -= 1
	end
end

function Highlights.Acquire(owner: string, adornee: Instance, props: Props?): any?
	if type(owner) ~= "string" or typeof(adornee) ~= "Instance" or not adornee:IsDescendantOf(workspace) then
		return nil
	end
	-- dasselbe Ziel vom selben Owner: vorhandenes Handle wiederverwenden
	for handle in pairs(active) do
		if handle.Owner == owner and handle.Adornee == adornee then
			applyProps(handle, props)
			return handle
		end
	end
	if activeCount >= cap then
		return nil
	end
	local ownerCap = OWNER_CAPS[owner]
	if ownerCap and (ownerCount[owner] or 0) >= ownerCap then
		return nil
	end
	local highlight = takeHighlight()
	if not highlight then
		return nil
	end
	nextId += 1
	local handle: Handle = {
		Id = nextId,
		Owner = owner,
		Highlight = highlight,
		Adornee = adornee,
		Depth = Enum.HighlightDepthMode.Occluded,
		PulseUntil = 0,
		Conn = nil,
		Alive = true,
	}
	active[handle] = true
	activeCount += 1
	ownerCount[owner] = (ownerCount[owner] or 0) + 1
	highlight.Adornee = adornee
	applyProps(handle, props or {})
	highlight.Enabled = true
	-- Ziel verschwindet (Character entfernt, Bot zurück in den Pool): automatisch freigeben
	handle.Conn = adornee.AncestryChanged:Connect(function()
		if not adornee:IsDescendantOf(workspace) then
			Highlights.Release(handle)
		end
	end)
	return handle
end

function Highlights.Update(handle: any, props: Props)
	if type(handle) == "table" and active[handle] and type(props) == "table" then
		applyProps(handle, props)
	end
end

function Highlights.ReleaseOwner(owner: string)
	local list: { Handle } = {}
	for handle in pairs(active) do
		if handle.Owner == owner then
			table.insert(list, handle)
		end
	end
	for _, handle in ipairs(list) do
		Highlights.Release(handle)
	end
end

function Highlights.Count(): number
	return activeCount
end

function Highlights.CountOwner(owner: string): number
	return ownerCount[owner] or 0
end

-- Anti-Camp-Puls: dieselben Handles kurz durch Wände sichtbar, danach zurück zur eigenen Tiefe
function Highlights.Pulse(owner: string, seconds: number)
	if type(owner) ~= "string" or type(seconds) ~= "number" or seconds ~= seconds then
		return
	end
	seconds = math.clamp(seconds, 0.05, 10)
	local untilT = os.clock() + seconds
	for handle in pairs(active) do
		if handle.Owner == owner then
			handle.PulseUntil = untilT
			handle.Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		end
	end
	pulseToken[owner] = (pulseToken[owner] or 0) + 1
	local token = pulseToken[owner]
	task.delay(seconds, function()
		if pulseToken[owner] ~= token then
			return
		end
		for handle in pairs(active) do
			if handle.Owner == owner and os.clock() >= handle.PulseUntil then
				handle.Highlight.DepthMode = handle.Depth
			end
		end
	end)
end

function Highlights.Init(context: any)
	ctx = context
	local config = ctx and ctx.Config
	local value = config and config.Client and config.Client.HighlightCap
	if type(value) == "number" and value >= 1 then
		cap = math.clamp(math.floor(value), 1, DEFAULT_CAP)
	end
	getFolder()
end

function Highlights.Start() end

return Highlights
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">Hooks</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Hooks: kleiner Signal-Hub für alle Client-Module (Client/Modules/Hooks)
--  Besitzer: WP10 (Client-Hülle). Vertrag: DESIGN.md C7.2.
--
--  Öffentliche API:
--    Hooks.On(name, fn): () -> ()   anmelden, gibt die Trenn-Funktion zurück
--    Hooks.Once(name, fn)           nur beim nächsten Feuern
--    Hooks.Fire(name, ...)          jeder Listener in pcall (ein Fehler stoppt die anderen nicht)
--    Hooks.Count(name?): number     Anzahl Listener (Debug)
--    Hooks.Init(ctx) / Hooks.Start() (Modul-Form C7.1, hier ohne Aufgabe)
--
--  Ereignisse (C7.2): "State"(state, changedKeys) · "Match:<Kind>"(data) · "Combat:<Op>"(data) ·
--  "Effect:<Name>"(strength, data) · "Notify"(text, kind) · "WindowOpened"(name) · "WindowClosed"(name) ·
--  "World"(world, slot?) · "Armed"(info) · "Disarmed"() · "LocalPopped"(recap?) · "LocalRevived"() ·
--  "Spectate"(model?) · "Settings"(settings) · "Input"(kind) · "Equip"(slot, weaponKey) · "Shot"(weaponKey) ·
--  "Hitmarker"(region, killed)
--  changedKeys bei "State": Liste der Schlüssel UND Set (changed[key] == true) – beides geht.
-- =====================================================================

local Hooks = {}

type Listener = { Fn: (...any) -> (), Once: boolean, Alive: boolean }

local MAX_LISTENERS = 256 -- pro Ereignis; mehr deutet auf ein Leck hin (warn einmal)
local ERROR_LOG_GAP = 10 -- Fehler je Ereignis höchstens alle 10 s loggen

local listeners: { [string]: { Listener } } = {}
local lastErrorAt: { [string]: number } = {}
local warnedFull: { [string]: boolean } = {}

local function add(name: string, fn: (...any) -> (), once: boolean): () -> ()
	if type(name) ~= "string" or type(fn) ~= "function" then
		warn("[Hooks] On/Once: Name (string) und Funktion erwartet")
		return function() end
	end
	local list = listeners[name]
	if not list then
		list = {}
		listeners[name] = list
	end
	if #list >= MAX_LISTENERS and not warnedFull[name] then
		warnedFull[name] = true
		warn(("[Hooks] Sehr viele Listener für %s (%d) – wird irgendwo nie getrennt?"):format(name, #list))
	end
	local entry: Listener = { Fn = fn, Once = once, Alive = true }
	table.insert(list, entry)
	return function()
		if not entry.Alive then
			return
		end
		entry.Alive = false
		local current = listeners[name]
		if current then
			local index = table.find(current, entry)
			if index then
				table.remove(current, index)
			end
			if #current == 0 then
				listeners[name] = nil
			end
		end
	end
end

-- Anmelden; Rückgabe trennt wieder ab
function Hooks.On(name: string, fn: (...any) -> ()): () -> ()
	return add(name, fn, false)
end

-- Nur beim nächsten Feuern aufrufen
function Hooks.Once(name: string, fn: (...any) -> ())
	add(name, fn, true)
end

-- Alle Listener aufrufen (Schnappschuss der Liste: An-/Abmelden während Fire ist erlaubt)
function Hooks.Fire(name: string, ...: any)
	local list = listeners[name]
	if not list or #list == 0 then
		return
	end
	local snapshot = table.clone(list)
	for _, entry in ipairs(snapshot) do
		if entry.Alive then
			if entry.Once then
				entry.Alive = false
				local index = table.find(list, entry)
				if index then
					table.remove(list, index)
				end
			end
			local ok, err = pcall(entry.Fn, ...)
			if not ok then
				local now = os.clock()
				if now - (lastErrorAt[name] or -math.huge) >= ERROR_LOG_GAP then
					lastErrorAt[name] = now
					warn(("[Hooks] Fehler in einem Listener von %s: %s"):format(name, tostring(err)))
				end
			end
		end
	end
	if #list == 0 then
		listeners[name] = nil
	end
end

function Hooks.Count(name: string?): number
	if name then
		local list = listeners[name]
		return if list then #list else 0
	end
	local total = 0
	for _, list in pairs(listeners) do
		total += #list
	end
	return total
end

function Hooks.Init(_ctx: any) end

function Hooks.Start() end

return Hooks
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Lobby-HUD (Client/Modules/Hud)
--  Besitzer: WP10 (Client-Hülle). Basis: Meteor-Heist-Hud (REUSE §1.4: squareButton, squareBar,
--  AddRightButton, Badges nur bei Änderung, Refresh/Tick-Trennung). Vertrag: DESIGN.md C7.4, B3.3.
--
--  Oben links: 🪙 Coins, 💎 Gems, 🔑 Schlüssel (flüssig zählend) + Level-Abzeichen mit XP-Balken.
--  Unten Mitte: großer gelber PLAY-Knopf (öffnet das Fenster "Play" von WP5).
--  Rechts: quadratische Menü-Knöpfe in 2 Spalten (andere Pakete hängen sich mit AddRightButton ein).
--  Oben rechts (immer, wenn eingeschaltet): FPS + Ping (Einstellung "Ping/FPS zeigen").
--  Auf Touch rutscht die Anzeige nach oben (unten links liegt der Lauf-Stick); Wechsel live.
--
--  Öffentliche API (C7.4):
--    Hud.AddRightButton(icon, captionKey, color, order, onClick): UI.Button   captionKey = Lang-Schlüssel
--    Hud.SetVisible(on)
--  Zusätzlich: Hud.CoinAnchor(): Vector2? (Ziel für den Münzflug), Hud.PulseCoins(amount?),
--    Hud.Refresh(state), Hud.Tick(), Hud.Init(ctx), Hud.Start()
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Stats = game:GetService("Stats")

local UI = require(script.Parent:WaitForChild("UI"))

local Hud = {}

local Theme = UI.Theme
local player = Players.LocalPlayer

local SQUARE = 86 -- quadratische Menü-Knöpfe (auch auf dem Handy ≥ 44 px nach Skalierung)
local SQUARE_GAP = 10
local PLAY_WIDTH = 300
local PLAY_HEIGHT = 92

local ctx: any = nil
local root: Frame? = nil -- alles Lobby-HUD (für SetVisible)
local stats: Frame? = nil
local rightBar: Frame? = nil
local playButton: UI.Button? = nil
local netLabel: TextLabel? = nil
local coinLabel: TextLabel? = nil
local coinScale: UIScale? = nil
local coinCounter: UI.Counter? = nil
local gemCounter: UI.Counter? = nil
local keyCounter: UI.Counter? = nil
local levelLabel: TextLabel? = nil
local xpBar: UI.Bar? = nil
local progressMath: any = nil

local forcedVisible = true
local inCombat = false
local inMatchWorld = false
local lastLevelKey = ""
local rightButtons: { { Button: UI.Button, Key: string, Icon: string } } = {}
local usedOrders: { [number]: boolean } = {}

-- ---------------------------------------------------------------------
-- HILFEN
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function inputKind(): string
	local controls = ctx and ctx.Modules and ctx.Modules.Controls
	if controls and type(controls.Input) == "function" then
		local ok, kind = pcall(controls.Input)
		if ok and type(kind) == "string" then
			return kind
		end
	end
	return "KBM"
end

local function format(n: number): string
	local util = ctx and ctx.Util
	if util and type(util.FormatNumber) == "function" then
		return util.FormatNumber(n)
	end
	return tostring(math.floor(n))
end

local function setting(key: string): any
	local module = ctx and ctx.Modules and ctx.Modules.Settings
	if module and type(module.Get) == "function" then
		local ok, settings = pcall(module.Get)
		if ok and type(settings) == "table" then
			return settings[key]
		end
	end
	return nil
end

-- Quadratischer Knopf: großes Emoji oben, kurzes Wort in GROSSBUCHSTABEN darunter (MH)
local function squareButton(
	parent: Instance,
	icon: string,
	caption: string,
	color: Color3,
	order: number,
	onClick: () -> ()
): UI.Button
	return UI.Button({
		Size = UDim2.fromOffset(SQUARE, SQUARE),
		Text = icon,
		Sub = UI.Upper(caption),
		Color = color,
		LayoutOrder = order,
		MaxText = 42,
		SubMax = 16,
		Corner = 16,
		Parent = parent,
	}, onClick)
end

-- Leiste mit quadratischen Knöpfen in 2 Spalten (MH)
local function squareBar(
	parent: Instance,
	name: string,
	anchor: Vector2,
	position: UDim2,
	align: Enum.HorizontalAlignment
): Frame
	return UI.Create("Frame", {
		Name = name,
		AnchorPoint = anchor,
		Position = position,
		Size = UDim2.fromOffset(SQUARE * 2 + SQUARE_GAP, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		UI.Create("UIGridLayout", {
			CellSize = UDim2.fromOffset(SQUARE, SQUARE),
			CellPadding = UDim2.fromOffset(SQUARE_GAP, SQUARE_GAP),
			FillDirection = Enum.FillDirection.Horizontal,
			FillDirectionMaxCells = 2,
			HorizontalAlignment = align,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH: Knöpfe rechts
-- ---------------------------------------------------------------------
function Hud.AddRightButton(
	icon: string,
	captionKey: string,
	color: Color3,
	order: number,
	onClick: () -> ()
): UI.Button
	local bar = rightBar
	assert(bar, "Hud.Init zuerst aufrufen")
	-- eindeutige LayoutOrder (gleiche Nummer -> dahinter einsortieren)
	local layoutOrder = if type(order) == "number" then math.floor(order) else 50
	local guard = 0
	while usedOrders[layoutOrder] and guard < 1000 do
		layoutOrder += 1
		guard += 1
	end
	usedOrders[layoutOrder] = true
	local key = if type(captionKey) == "string" then captionKey else ""
	local button = squareButton(bar, icon, T(key), color, layoutOrder, function()
		local ok, err = pcall(onClick)
		if not ok then
			warn("[Hud] Knopf " .. key .. ": " .. tostring(err))
		end
	end)
	table.insert(rightButtons, { Button = button, Key = key, Icon = icon })
	return button
end

local function relabel()
	for _, entry in ipairs(rightButtons) do
		entry.Button.SetSub(UI.Upper(T(entry.Key)))
	end
	local play = playButton
	if play then
		play.SetText(T("ui.play"))
		play.SetSub(T("ui.playSub"))
	end
	lastLevelKey = "" -- Level-Text neu schreiben
end

-- ---------------------------------------------------------------------
-- AUFBAU
-- ---------------------------------------------------------------------
local function buildStats(parent: Frame)
	local frame = UI.Create("Frame", {
		Name = "Stats",
		Size = UDim2.fromOffset(360, 150),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	stats = frame
	-- Level-Abzeichen + XP-Balken
	levelLabel = UI.Label({
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(92, 34),
		Text = "LV 1",
		Font = UI.Fonts.Banner,
		TextColor3 = Theme.Yellow,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 30,
		Outline = 3,
		Parent = frame,
	})
	xpBar = UI.Bar({
		Position = UDim2.fromOffset(96, 4),
		Size = UDim2.fromOffset(220, 26),
		Color = Theme.Cyan,
		MaxText = 16,
		Parent = frame,
	})
	-- Währungen (nur Text mit dicker Kontur, kein Kasten)
	local function currency(y: number, color: Color3, size: number): TextLabel
		return UI.Label({
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.new(1, 0, 0, size),
			Text = "",
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = color,
			MaxText = size - 4,
			Outline = 3,
			Parent = frame,
		})
	end
	local coins = currency(38, Theme.Yellow, 46)
	coinScale = UI.Create("UIScale", { Parent = coins })
	coinLabel = coins
	local gems = currency(86, Theme.Cyan, 30)
	local keys = currency(118, Theme.Orange, 30)
	coinCounter = UI.Counter(coins, function(value: number): string
		return "🪙 " .. format(value)
	end)
	gemCounter = UI.Counter(gems, function(value: number): string
		return "💎 " .. format(value)
	end)
	keyCounter = UI.Counter(keys, function(value: number): string
		return "🔑 " .. format(value)
	end)
end

local function openPlay()
	local windows = ctx.Windows
	if windows and type(windows.IsOpen) == "function" and windows.IsOpen("Play") then
		windows.Close("Play")
		return
	end
	local queue = ctx.Modules.QueueUI
	if queue and type(queue.OpenPlay) == "function" then
		local ok, err = pcall(queue.OpenPlay)
		if ok then
			return
		end
		warn("[Hud] QueueUI.OpenPlay: " .. tostring(err))
	end
	if windows and type(windows.Open) == "function" then
		windows.Open("Play")
	end
end

local function buildPlay(parent: Frame)
	playButton = UI.Button({
		Name = "Play",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(PLAY_WIDTH, PLAY_HEIGHT),
		Text = T("ui.play"),
		Sub = T("ui.playSub"),
		Color = Theme.Yellow,
		MaxText = 54,
		SubMax = 18,
		Corner = 20,
		StrokeSize = 4,
		Parent = parent,
	}, openPlay)
end

local function buildNet()
	netLabel = UI.Label({
		Name = "NetStats",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 4),
		Size = UDim2.fromOffset(220, 22),
		Text = "",
		Font = UI.Fonts.Number,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxText = 18,
		Outline = 2,
		Visible = false,
		ZIndex = 8,
		Parent = ctx.Gui,
	})
end

-- Touch: Anzeige oben links (unten links liegt der Stick), sonst unten links über dem Rand
local function layout()
	local frame = stats
	if not frame then
		return
	end
	if inputKind() == "Touch" then
		frame.AnchorPoint = Vector2.new(0, 0)
		frame.Position = UDim2.fromOffset(14, 6)
	else
		frame.AnchorPoint = Vector2.new(0, 1)
		frame.Position = UDim2.new(0, 16, 1, -14)
	end
end

local function applyVisible()
	local frame = root
	if frame then
		local visible = forcedVisible and not inCombat and not inMatchWorld
		if frame.Visible ~= visible then
			frame.Visible = visible
		end
	end
end

-- ---------------------------------------------------------------------
-- DATEN
-- ---------------------------------------------------------------------
local function xpNeeded(level: number): number?
	if progressMath and type(progressMath.XpToNext) == "function" then
		local ok, value = pcall(progressMath.XpToNext, level)
		if ok and type(value) == "number" then
			return value
		end
	end
	return nil
end

function Hud.Refresh(state: { [string]: any })
	if type(state) ~= "table" then
		return
	end
	if coinCounter and type(state.Coins) == "number" then
		UI.SetCounter(coinCounter, state.Coins)
	end
	if gemCounter and type(state.Gems) == "number" then
		UI.SetCounter(gemCounter, state.Gems)
	end
	if keyCounter and type(state.Keys) == "number" then
		UI.SetCounter(keyCounter, state.Keys)
	end
	local level = tonumber(state.Level) or 1
	local xp = tonumber(state.XP) or 0
	local nextXp = tonumber(state.XPNext) or xpNeeded(level) or 0
	local key = level .. "|" .. xp .. "|" .. nextXp
	if key ~= lastLevelKey then
		lastLevelKey = key
		if levelLabel then
			levelLabel.Text = T("ui.levelShort", math.floor(level))
		end
		local bar = xpBar
		if bar then
			if nextXp > 0 then
				UI.SetBar(bar, xp / nextXp, format(xp) .. " / " .. format(nextXp) .. " XP")
			else
				UI.SetBar(bar, 1, "MAX")
			end
		end
	end
end

-- Jede Sekunde: FPS/Ping (nur wenn eingeschaltet)
function Hud.Tick()
	local label = netLabel
	if not label then
		return
	end
	local show = setting("ShowNet") == true
	if label.Visible ~= show then
		label.Visible = show
	end
	if not show then
		return
	end
	local ping = player:GetAttribute("PingMs")
	if type(ping) ~= "number" then
		local ok, value = pcall(function()
			return player:GetNetworkPing() * 1000
		end)
		ping = if ok then value else nil
	end
	local memory = 0
	local okMem, mb = pcall(function()
		return Stats:GetTotalMemoryUsageMb()
	end)
	if okMem and type(mb) == "number" then
		memory = mb
	end
	local fps = 0
	local settingsModule = ctx.Modules.Settings
	if settingsModule and type(settingsModule.Fps) == "function" then
		local okFps, value = pcall(settingsModule.Fps)
		fps = if okFps and type(value) == "number" then value else 0
	end
	label.Text = T("ui.netStats", math.floor(fps + 0.5), math.floor((tonumber(ping) or 0) + 0.5), math.floor(memory))
end

function Hud.SetVisible(on: boolean)
	forcedVisible = on == true
	applyVisible()
end

-- Bildschirmpunkt des Coin-Zählers (für den Münzflug; Overlay ohne UIScale = echte Pixel)
function Hud.CoinAnchor(): Vector2?
	local label = coinLabel
	if not label or not label.Visible or not root or not root.Visible then
		return nil
	end
	local pos = label.AbsolutePosition
	local size = label.AbsoluteSize
	return Vector2.new(pos.X + math.min(size.X, 40) * 0.5, pos.Y + size.Y * 0.5)
end

function Hud.PulseCoins(amount: number?)
	local scale = coinScale
	if scale then
		UI.Pulse(scale, amount or 0.12)
	end
end

function Hud.Init(context: any)
	ctx = context
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local pm = shared and shared:FindFirstChild("ProgressMath")
	if pm and pm:IsA("ModuleScript") then
		local ok, result = pcall(require, pm)
		progressMath = if ok then result else nil
	end
	local frame: Frame = UI.Create("Frame", {
		Name = "LobbyHud",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = ctx.Gui,
	})
	root = frame
	buildStats(frame)
	buildPlay(frame)
	rightBar =
		squareBar(frame, "RightButtons", Vector2.new(1, 0.5), UDim2.new(1, -14, 0.5, 0), Enum.HorizontalAlignment.Right)
	buildNet()
	layout()

	local hooks = ctx.Hooks
	hooks.On("State", function(state)
		Hud.Refresh(state)
	end)
	hooks.On("Input", layout)
	hooks.On("Settings", relabel)
	hooks.On("Armed", function()
		inCombat = true
		applyVisible()
	end)
	hooks.On("Disarmed", function()
		inCombat = false
		applyVisible()
	end)
	hooks.On("World", function(world)
		inMatchWorld = world == "Match" or world == "Crown"
		if world == "Lobby" then
			inMatchWorld = false
		end
		applyVisible()
	end)
end

function Hud.Start()
	if ctx and type(ctx.State) == "table" then
		Hud.Refresh(ctx.State)
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">Locker</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Spind: Loadouts + Kosmetik pro Waffe (Client/Modules/Locker)
--  Besitzer: WP9 (Wirtschaft, Monetarisierung, Kosmetik). Vertrag: DESIGN.md B19, B22.1 (Loadout+), C7.4, C9.
--  Tab "Loadouts": Vorlagen wählen (3, +2 für Münzen, 8 mit Loadout+), pro Slot eine besessene Waffe
--  wählen, Umbenennen + "Zufall aus Favoriten" (Loadout+). Tab "Kosmetik": Waffe wählen, Drehteller-
--  Vorschau (ViewportFrame), Skin/Wrap/Charm pro Waffe, dazu Finisher (mit Vorschau), Tracer, Titel.
--  Der Server prüft alles noch einmal (Besitz, Meisterschafts-Stufe, Slot) – das UI zeigt nur an.
--
--  Öffentliche API (C7.4):
--    Locker.Open()
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Lang = require(Shared:WaitForChild("Lang"))
local Util = require(Shared:WaitForChild("Util"))
local CosmeticModels = require(Shared:WaitForChild("CosmeticModels"))

local Locker = {}
local ctx: any = nil
local UI: any = nil

local COSMETICS: any = Config.Cosmetics
local SLOTS = { "Primary", "Secondary", "Melee", "Utility" }
local SLOT_FIELD: { [string]: string } = { Primary = "P", Secondary = "S", Melee = "M", Utility = "U" }
local TABS = { "Loadouts", "Cosmetics" }
local TAB_KEYS: { [string]: { string } } = {
	Loadouts = { "Loadouts", "Weapons", "Coins", "Passes" },
	Cosmetics = { "Cosmetics", "Weapons", "Passes", "Mastery" },
}
local SPIN_SPEED = 0.8 -- Drehteller: Radiant pro Sekunde
local FALLBACK_LOADOUT =
	{ Primary = "PopRifle", Secondary = "PipPistol", Melee = "BoxingGloves", Utility = "PopGrenade" }

local win: any = nil
local body: Frame? = nil
local tabButtons: { [string]: any } = {}
local currentTab = "Loadouts"
local selectedWeapon = "PopRifle"
local pending = false
local renderQueued = false
local viewport: ViewportFrame? = nil
local previewModel: Model? = nil
local spinConnection: RBXScriptConnection? = nil
local spinAngle = 0
local weaponModels: any = nil
local weaponModelsTried = false

-- =====================================================================
-- 1) HELFER
-- =====================================================================
local function lang(): "de" | "en"
	local ok, value = pcall(function()
		return ctx.Lang_()
	end)
	return if ok and value == "de" then "de" else "en"
end

local function t(key: string, ...: any): string
	return Lang.T(lang(), key, ...)
end

local function state(): { [string]: any }
	return if ctx and type(ctx.State) == "table" then ctx.State else {}
end

local function pick(name: any): string
	return if type(name) == "table" then Lang.Pick(lang(), name) else tostring(name)
end

local function rarityColor(rarity: any): Color3
	local colors = Config.Colors and Config.Colors.Rarity
	return colors and colors[rarity] or Color3.new(1, 1, 1)
end

local function hasPass(key: string): boolean
	local passes = state().Passes
	return type(passes) == "table" and passes[key] == true
end

local function cosmeticsState(): any
	local cos = state().Cosmetics
	if type(cos) ~= "table" then
		return { Owned = {}, Equipped = {}, PerWeapon = {} }
	end
	return {
		Owned = if type(cos.Owned) == "table" then cos.Owned else {},
		Equipped = if type(cos.Equipped) == "table" then cos.Equipped else {},
		PerWeapon = if type(cos.PerWeapon) == "table" then cos.PerWeapon else {},
	}
end

local function weaponList(): { any }
	local list = Config.Weapons and Config.Weapons.List
	local result = {}
	if type(list) == "table" then
		for _, def in ipairs(list) do
			if type(def) == "table" and not def.AdminOnly then
				table.insert(result, def)
			end
		end
	end
	table.sort(result, function(a, b)
		return (a.Id or 0) < (b.Id or 0)
	end)
	return result
end

local function ownsWeapon(def: any): boolean
	if def.Free then
		return true
	end
	local weapons = state().Weapons
	return type(weapons) == "table" and type(weapons.Owned) == "table" and weapons.Owned[def.Key] == true
end

local function masteryTier(weaponKey: string): number
	local mastery = state().Mastery
	local entry = type(mastery) == "table" and mastery[weaponKey]
	if type(entry) == "number" then
		return entry
	elseif type(entry) == "table" then
		return tonumber(entry.Tier) or tonumber(entry.T) or 0
	end
	return 0
end

-- Darf (laut State) benutzt werden? Server prüft endgültig.
local function canUse(id: string, weaponKey: string?): (boolean, string?)
	local def = COSMETICS.ById[id]
	if def == nil then
		return false, nil
	end
	if def.Source == "Default" then
		return true, nil
	elseif def.Source == "VIP" then
		return hasPass("VIP"), t("shop.lock.vip")
	elseif def.Source == "Mastery" then
		if def.Kind == "Wrap" then
			local need = tonumber(def.MasteryTier) or 99
			return weaponKey ~= nil and masteryTier(weaponKey) >= need, t("shop.lock.mastery", need)
		elseif def.Kind == "Title" and type(def.Weapon) == "string" then
			return cosmeticsState().Owned[id] == true or masteryTier(def.Weapon) >= 9, t("shop.lock.mastery", 9)
		end
	end
	return cosmeticsState().Owned[id] == true, nil
end

local function changedHas(changed: any, key: string): boolean
	if type(changed) ~= "table" then
		return true
	end
	return changed[key] == true or table.find(changed, key) ~= nil
end

local function clear(frame: Instance)
	for _, child in ipairs(frame:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function request(action: string, arg: any, onOk: ((any) -> ())?)
	if pending then
		return
	end
	pending = true
	task.spawn(function()
		local ok, reply = pcall(ctx.RequestFull, action, arg, true) -- silent: Meldung zeigen wir selbst
		pending = false
		if not ok or type(reply) ~= "table" then
			ctx.Toast(t("shop.noAnswer"), "Error")
			return
		end
		if type(reply.Message) == "string" and reply.Message ~= "" then
			ctx.Toast(reply.Message, if reply.Ok then "Success" else "Error")
		end
		if reply.Ok and onOk then
			onOk(reply)
		end
	end)
end

local function label(parent: Instance, textValue: string, order: number, color: Color3?)
	return UI.Label({
		Size = UDim2.new(1, 0, 0, 26),
		Text = textValue,
		TextColor3 = color or Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 18,
		Outline = 2,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function optionGrid(parent: Instance, order: number): Frame
	return UI.Grid(parent, order, 150, 46)
end

local function option(
	parent: Instance,
	order: number,
	textValue: string,
	color: Color3,
	selected: boolean,
	onClick: () -> ()
)
	UI.Button({
		Size = UDim2.fromOffset(150, 46),
		Text = (if selected then "✔ " else "") .. textValue,
		Color = if selected then UI.Theme.Green else color,
		MaxText = 15,
		LayoutOrder = order,
		Parent = parent,
	}, onClick)
end

-- =====================================================================
-- 2) TAB LOADOUTS
-- =====================================================================
local function loadoutsState(): any
	local lo = state().Loadouts
	if type(lo) ~= "table" then
		return { Active = 1, Slots = 3, Max = 3, Presets = {}, Plus = false }
	end
	return lo
end

local function presetLoadout(preset: any): { [string]: string }
	local result = table.clone(FALLBACK_LOADOUT)
	local defaults = Config.Weapons and Config.Weapons.DefaultLoadout
	if type(defaults) == "table" then
		for _, slot in ipairs(SLOTS) do
			if type(defaults[slot]) == "string" then
				result[slot] = defaults[slot]
			end
		end
	end
	if type(preset) == "table" then
		for _, slot in ipairs(SLOTS) do
			local key = preset[SLOT_FIELD[slot]]
			if type(key) == "string" then
				result[slot] = key
			end
		end
	end
	return result
end

local function buildLoadouts(root: Frame)
	local lo = loadoutsState()
	local active = tonumber(lo.Active) or 1
	local max = tonumber(lo.Max) or 3
	local presets = if type(lo.Presets) == "table" then lo.Presets else {}
	local plus = lo.Plus == true
	local row = UI.Row(root, 1, 48)
	for i = 1, max do
		local preset = presets[i]
		local name = if type(preset) == "table" and type(preset.Name) == "string"
			then preset.Name
			else ("Loadout " .. i)
		UI.Button({
			Size = UDim2.fromOffset(if max > 5 then 84 else 130, 44),
			Text = name,
			Color = if i == active then UI.Theme.Green else UI.Theme.Blue,
			MaxText = 14,
			LayoutOrder = i,
			Parent = row,
		}, function()
			if i ~= active then
				request("SelectPreset", i)
			end
		end)
	end
	local coinSlotsMax = tonumber(lo.CoinSlotsMax) or 5
	if not plus and (tonumber(lo.Slots) or 3) < coinSlotsMax then
		UI.Button({
			Size = UDim2.fromOffset(170, 44),
			Text = t("shop.presetBuy", Util.FormatNumber(tonumber(lo.SlotCoins) or 5000)),
			Color = UI.Theme.Orange,
			MaxText = 14,
			LayoutOrder = 20,
			Parent = row,
		}, function()
			request("BuyPresetSlot", nil)
		end)
	end
	-- Loadout+: Umbenennen + Zufall aus Favoriten
	local plusRow = UI.Row(root, 2, 46)
	if plus then
		local box = UI.TextBox({
			Size = UDim2.fromOffset(220, 40),
			PlaceholderText = t("shop.renameHint"),
			Text = "",
			LayoutOrder = 1,
			Parent = plusRow,
		})
		UI.Button({
			Size = UDim2.fromOffset(150, 42),
			Text = t("shop.rename"),
			Color = UI.Theme.Purple,
			LayoutOrder = 2,
			Parent = plusRow,
		}, function()
			request("RenamePreset", { Index = active, Name = string.sub(box.Text, 1, 64) })
		end)
		UI.Button({
			Size = UDim2.fromOffset(170, 42),
			Text = t("shop.randomPreset"),
			Color = UI.Theme.Cyan,
			LayoutOrder = 3,
			Parent = plusRow,
		}, function()
			request("RandomLoadout", nil)
		end)
	else
		label(plusRow, t("shop.plusHint"), 1, UI.Theme.SubText)
	end
	local current = presetLoadout(presets[active])
	local weapons = weaponList()
	if #weapons == 0 then
		label(root, t("shop.noWeapons"), 3)
		return
	end
	local order = 3
	for _, slot in ipairs(SLOTS) do
		label(root, t("shop.slot." .. slot), order, UI.Theme.Yellow)
		order += 1
		local g = optionGrid(root, order)
		order += 1
		local index = 0
		for _, def in ipairs(weapons) do
			if def.Slot == slot then
				index += 1
				local owned = ownsWeapon(def)
				local selected = current[slot] == def.Key
				local caption = pick(def.Name)
					.. (if owned then "" else (" 🔒" .. Util.FormatNumber(tonumber(def.Price) or 0)))
				option(g, index, caption, if owned then UI.Theme.Blue else UI.Theme.Gray, selected, function()
					if not owned then
						local shop = ctx.Modules and ctx.Modules.Shop
						if shop and type(shop.Open) == "function" then
							shop.Open("Weapons")
						end
						return
					end
					if selected then
						return
					end
					local loadout = table.clone(current)
					loadout[slot] = def.Key
					request("SetLoadout", { Index = active, Loadout = loadout })
				end)
			end
		end
	end
end

-- =====================================================================
-- 3) TAB KOSMETIK (mit Drehteller-Vorschau)
-- =====================================================================
local function getWeaponModels(): any
	if weaponModelsTried then
		return weaponModels
	end
	weaponModelsTried = true
	local module = Shared:FindFirstChild("WeaponModels")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			weaponModels = result
		end
	end
	return weaponModels
end

-- Ersatz-Modell, falls WeaponModels (WP4) fehlt: Spielzeug-Blaster mit oranger Spitze
local function fallbackModel(): Model
	local model = Instance.new("Model")
	local function add(
		name: string,
		role: string,
		size: Vector3,
		cf: CFrame,
		color: Color3,
		shape: Enum.PartType?,
		material: Enum.Material?
	)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Shape = shape or Enum.PartType.Block
		p.Material = material or Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanQuery = false
		p.CanTouch = false
		p.CanCollide = false
		p.CastShadow = false
		p:SetAttribute("Role", role)
		p.Parent = model
		return p
	end
	local bodyPart = add("Body", "Body", Vector3.new(0.5, 0.6, 2.2), CFrame.new(), Color3.fromRGB(154, 209, 212))
	add(
		"Barrel",
		"Metal",
		Vector3.new(1.2, 0.25, 0.25),
		CFrame.new(0, 0.1, -1.6) * CFrame.Angles(0, math.rad(90), 0),
		Color3.fromRGB(200, 205, 215),
		Enum.PartType.Cylinder,
		Enum.Material.Foil
	)
	add(
		"Tip",
		"Tip",
		Vector3.new(0.2, 0.3, 0.3),
		CFrame.new(0, 0.1, -2.25) * CFrame.Angles(0, math.rad(90), 0),
		Color3.fromRGB(255, 120, 0),
		Enum.PartType.Cylinder,
		Enum.Material.Neon
	)
	add("Mag", "Detail", Vector3.new(0.3, 0.7, 0.4), CFrame.new(0, -0.55, -0.2), Color3.fromRGB(244, 235, 221))
	add(
		"Grip",
		"Grip",
		Vector3.new(0.3, 0.7, 0.4),
		CFrame.new(0, -0.5, 0.6) * CFrame.Angles(math.rad(-15), 0, 0),
		Color3.fromRGB(43, 43, 51)
	)
	add(
		"Stripe",
		"Accent",
		Vector3.new(0.05, 0.1, 1.6),
		CFrame.new(0.27, 0.1, 0),
		Color3.fromRGB(90, 230, 200),
		nil,
		Enum.Material.Neon
	)
	local charm = Instance.new("Attachment")
	charm.Name = "Charm"
	charm.Position = Vector3.new(0.3, -0.1, 0.4)
	charm.Parent = bodyPart
	model.PrimaryPart = bodyPart
	return model
end

local function stopSpin()
	if spinConnection then
		spinConnection:Disconnect()
		spinConnection = nil
	end
end

local function buildPreview(cos: { Skin: string, Wrap: string, Charm: string })
	local frame = viewport
	if frame == nil then
		return
	end
	if previewModel then
		previewModel:Destroy()
		previewModel = nil
	end
	local model: Model? = nil
	local wm = getWeaponModels()
	if wm and type(wm.Build) == "function" then
		local weaponDef = Config.Weapon(selectedWeapon)
		local modelKey = if weaponDef and type(weaponDef.Model) == "string" then weaponDef.Model else selectedWeapon
		local ok, result =
			pcall(wm.Build, modelKey, { Skin = if cos.Skin ~= "" then cos.Skin else nil, Scale = 1, Viewmodel = false })
		if ok and typeof(result) == "Instance" and result:IsA("Model") then
			model = result
		end
	end
	local m = model or fallbackModel()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	CosmeticModels.ApplyWrap(m, cos.Wrap)
	if cos.Charm ~= "" then
		local charm = CosmeticModels.BuildCharm(cos.Charm)
		local attach = m:FindFirstChild("Charm", true)
		local at = if attach and attach:IsA("Attachment")
			then attach.WorldCFrame
			else m:GetPivot() * CFrame.new(0.3, -0.1, 0.4)
		for _, d in ipairs(charm:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		charm:PivotTo(at)
		charm.Parent = m
	end
	m.Parent = frame
	previewModel = m
	local size = m:GetExtentsSize()
	local radius = math.max(size.X, size.Y, size.Z, 1)
	local camera = frame.CurrentCamera
	if camera == nil then
		local created = Instance.new("Camera")
		created.FieldOfView = 40
		created.Parent = frame
		frame.CurrentCamera = created
		camera = created
	end
	local center = m:GetPivot().Position
	local cam = camera :: Camera
	cam.CFrame = CFrame.lookAt(center + Vector3.new(radius * 1.6, radius * 0.5, 0), center)
	local base = m:GetPivot()
	stopSpin()
	spinConnection = RunService.PreRender:Connect(function(dt: number)
		if not (win and win.IsOpen) or previewModel ~= m or m.Parent == nil then
			stopSpin()
			return
		end
		spinAngle = (spinAngle + dt * SPIN_SPEED) % (math.pi * 2)
		m:PivotTo(CFrame.new(base.Position) * CFrame.Angles(0, spinAngle, 0) * base.Rotation)
	end)
end

local function equip(kind: string, id: string, weaponKey: string?)
	request("EquipCosmetic", { Kind = kind, Id = id, Weapon = weaponKey })
end

local function listFor(kind: string, weaponKey: string?): { string }
	local ids: { string } = {}
	for id, def in pairs(COSMETICS.ById) do
		if def.Kind == kind then
			if kind ~= "Skin" or def.Weapon == weaponKey then
				local usable = canUse(id, weaponKey)
				-- Meisterschafts-Wraps zeigen wir auch gesperrt (als Ziel), alles andere nur, wenn besessen
				if usable or (def.Source == "Mastery" and kind == "Wrap") then
					table.insert(ids, id)
				end
			end
		end
	end
	table.sort(ids, function(a, b)
		local ra = COSMETICS.RarityRank[COSMETICS.ById[a].Rarity] or 0
		local rb = COSMETICS.RarityRank[COSMETICS.ById[b].Rarity] or 0
		if ra ~= rb then
			return ra < rb
		end
		return a < b
	end)
	return ids
end

local function cosmeticSection(
	root: Frame,
	order: number,
	kind: string,
	current: string,
	weaponKey: string?,
	allowNone: boolean
): number
	label(root, t("item.kinds." .. kind), order, UI.Theme.Yellow)
	order += 1
	local g = optionGrid(root, order)
	order += 1
	local index = 0
	if allowNone then
		index += 1
		option(g, index, t("shop.none"), UI.Theme.Gray, current == "", function()
			if current ~= "" then
				equip(kind, "", weaponKey)
			end
		end)
	end
	for _, id in ipairs(listFor(kind, weaponKey)) do
		index += 1
		local def = COSMETICS.ById[id]
		local usable, lockText = canUse(id, weaponKey)
		local caption = pick(def.Name) .. (if usable then "" else " 🔒")
		option(
			g,
			index,
			caption,
			if usable then rarityColor(def.Rarity):Lerp(Color3.new(0, 0, 0), 0.25) else UI.Theme.Gray,
			current == id,
			function()
				if not usable then
					ctx.Toast(lockText or t("shop.notOwnedHint"), "Info")
					return
				end
				if current ~= id then
					equip(kind, id, weaponKey)
				end
			end
		)
		if kind == "Finisher" then
			index += 1
			option(g, index, "▶ " .. t("shop.preview"), UI.Theme.Cyan, false, function()
				local finishers = ctx.Modules and ctx.Modules.Finishers
				if finishers and type(finishers.Preview) == "function" then
					finishers.Preview(id)
				end
			end)
		end
	end
	if index == 0 then
		label(root, t("shop.nothingOwned"), order, UI.Theme.SubText)
		order += 1
	end
	return order
end

local function buildCosmetics(root: Frame)
	local weapons = weaponList()
	local owned: { any } = {}
	for _, def in ipairs(weapons) do
		if ownsWeapon(def) then
			table.insert(owned, def)
		end
	end
	local keys: { string } = {}
	if #owned > 0 then
		for _, def in ipairs(owned) do
			table.insert(keys, def.Key)
		end
	else
		keys = table.clone(COSMETICS.WeaponKeys)
	end
	if not table.find(keys, selectedWeapon) then
		selectedWeapon = keys[1] or "PopRifle"
	end
	label(root, t("shop.pickWeapon"), 1, UI.Theme.Yellow)
	local g = UI.Grid(root, 2, 120, 40)
	for i, key in ipairs(keys) do
		local def = Config.Weapon(key)
		UI.Button({
			Size = UDim2.fromOffset(120, 40),
			Text = if def then pick(def.Name) else key,
			Color = if key == selectedWeapon then UI.Theme.Green else UI.Theme.Blue,
			MaxText = 14,
			LayoutOrder = i,
			Parent = g,
		}, function()
			if selectedWeapon ~= key then
				selectedWeapon = key
				Locker.Refresh()
			end
		end)
	end
	local cos = cosmeticsState()
	local per = cos.PerWeapon[selectedWeapon]
	local current = {
		Skin = if type(per) == "table" and type(per.Skin) == "string" then per.Skin else "",
		Wrap = if type(per) == "table" and type(per.Wrap) == "string" then per.Wrap else "",
		Charm = if type(per) == "table" and type(per.Charm) == "string" then per.Charm else "",
	}
	local previewHolder = UI.Card({ Size = UDim2.new(1, 0, 0, 220), LayoutOrder = 3, Parent = root })
	viewport = UI.Create("ViewportFrame", {
		Size = UDim2.new(1, -12, 1, -12),
		Position = UDim2.fromOffset(6, 6),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 200, 210),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-1, -1, -0.5),
		Parent = previewHolder,
	})
	local okPreview, errPreview = pcall(buildPreview, current)
	if not okPreview then
		warn("[Locker] Vorschau: " .. tostring(errPreview))
	end
	local order = 4
	order = cosmeticSection(root, order, "Skin", current.Skin, selectedWeapon, true)
	order = cosmeticSection(root, order, "Wrap", current.Wrap, selectedWeapon, true)
	order = cosmeticSection(root, order, "Charm", current.Charm, selectedWeapon, true)
	local equipped = cos.Equipped
	order =
		cosmeticSection(root, order, "Finisher", tostring(equipped.Finisher or COSMETICS.Defaults.Finisher), nil, false)
	order = cosmeticSection(root, order, "Tracer", tostring(equipped.Tracer or COSMETICS.Defaults.Tracer), nil, false)
	cosmeticSection(root, order, "Title", tostring(equipped.Title or ""), nil, true)
end

-- =====================================================================
-- 4) FENSTER
-- =====================================================================
local function render()
	local root = body
	if not root or not win then
		return
	end
	stopSpin()
	if previewModel then
		previewModel:Destroy()
		previewModel = nil
	end
	viewport = nil
	clear(root)
	for name, button in pairs(tabButtons) do
		button.SetColor(if name == currentTab then UI.Theme.Orange else UI.Theme.Blue)
	end
	local ok, err = pcall(if currentTab == "Loadouts" then buildLoadouts else buildCosmetics, root)
	if not ok then
		warn("[Locker] Tab " .. currentTab .. ": " .. tostring(err))
	end
end

function Locker.Refresh()
	if win and win.IsOpen then
		render()
	end
end

local function ensureWindow()
	if win then
		return
	end
	win = UI.Window(t("shop.locker.title"), 800, 560, UI.Theme.Purple)
	local tabRow = UI.Row(win.Content, 1, 46)
	for i, name in ipairs(TABS) do
		tabButtons[name] = UI.Button({
			Size = UDim2.fromOffset(180, 42),
			Text = t("shop.locker.tab." .. name),
			Color = UI.Theme.Blue,
			MaxText = 16,
			LayoutOrder = i,
			Parent = tabRow,
		}, function()
			if currentTab ~= name then
				currentTab = name
				render()
			end
		end)
	end
	body = UI.Create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = win.Content,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }) })
end

local function openWindow()
	ensureWindow()
	render()
	UI.OpenWindow(win)
end

local function closeWindow()
	stopSpin()
end

function Locker.Open()
	if ctx.Windows.IsOpen("Locker") then
		render()
	else
		ctx.Windows.Open("Locker")
	end
end

local function onState(_state: any, changed: any)
	if not (win and win.IsOpen) then
		return
	end
	local relevant = false
	for _, key in ipairs(TAB_KEYS[currentTab] or {}) do
		if changedHas(changed, key) then
			relevant = true
			break
		end
	end
	if relevant and not renderQueued then
		renderQueued = true
		task.delay(0.15, function()
			renderQueued = false
			Locker.Refresh()
		end)
	end
end

function Locker.Init(c: any)
	ctx = c
	UI = c.UI
end

function Locker.Start()
	ctx.Windows.Register("Locker", openWindow, closeWindow)
	CosmeticModels.StartAnimator() -- animierte Wraps in Vorschau, Viewmodel und 3rd Person
	local modules = ctx.Modules or {}
	local hud = modules.Hud
	if hud and type(hud.AddRightButton) == "function" then
		pcall(hud.AddRightButton, "🎒", "shop.hud.locker", UI.Theme.Purple, 21, function()
			ctx.Windows.Open("Locker")
		end)
	end
	-- Taste L / Gamepad: Loadout-Fenster (auch in der Vorbereitungsphase eines Matches)
	local controls = modules.Controls
	if controls and type(controls.Bind) == "function" then
		pcall(controls.Bind, "Loadout", function(inputState: string)
			if inputState ~= "Begin" then
				return
			end
			if ctx.Windows.IsOpen("Locker") then
				ctx.Windows.Close("Locker")
			else
				currentTab = "Loadouts"
				ctx.Windows.Open("Locker")
			end
		end)
	end
	ctx.Hooks.On("State", onState)
end

return Locker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">MatchUI</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Match-Oberfläche (Client/Modules/MatchUI)
--  Besitzer: WP5 (Match-UI). Vertrag: DESIGN.md B5, B6.6, B14.2, B14.3, B14.6, C7.2 (Hooks "Match:<Kind>"), C8.
--
--  MATCH GEFUNDEN! + Kartenwahl (3 Karten + Zufall) · Intro "BLAZE vs FROST" mit Gegner-Loadouts ·
--  Countdown 3-2-1-POP · Timer + Punkt-Pips (FFA: eigene Punkte/Führung) · Zonen-Balken (Overtime/Sudden Death) ·
--  Banner (Runde gewonnen/verloren, CLUTCH!, ACE!, FLAWLESS!, COMEBACK!, MATCH POINT, SUDDEN DEATH, CLUTCH-Bonus-XP) ·
--  Killfeed oben rechts (max. 5 Zeilen, je 5 s, eigene gelb, Bots grau, Abzeichen Serie/Kopfgeld/Meisterschaft/
--  Krone/DOUBLE…) · Todes-Rückblick links · Ergebnis-Bildschirm (füllende Balken XP → Coins → Meisterschaft → Pass →
--  Quests, GG/Loben/REMATCH/NOCHMAL SPIELEN/Lobby, Auto-Requeue, Starter-Karte nur bei Offer) · AFK-Warnung ·
--  Bereit/Loadout in Prep · ArenaReady an den Server · Roblox-Spielerliste + Reset im Match aus.
--  Finisher bei jedem Elim über CombatFX.Pop (auch für Crown-Zuschauer).
--
--  Öffentliche API: MatchUI.InMatch(): boolean, MatchUI.Init(ctx), MatchUI.Start()
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local MatchUI = {}

local player = Players.LocalPlayer
local ctx: any = nil
local ProgressMath: any = nil

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local GRAY = Color3.fromRGB(190, 190, 198)
local REFRESH = 0.1
local KILLFEED_MAX = 5
local KILLFEED_SECONDS = 5
local BANNER_SECONDS = 2.4
local ARENA_WAIT = 4
local FACE = "rbxasset://textures/face.png"
local BANNER_POP = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

type RosterEntry = {
	Slot: number,
	Id: number,
	Name: string,
	Team: number,
	IsBot: boolean,
	Level: number,
	Title: string,
	Finisher: string,
}

-- Match-Zustand (nur Anzeige; der Server ist Autorität)
local match: any = nil
local roster: { [number]: RosterEntry } = {}
local foundData: any = nil
local myVote = 0
local ready = false
local reportedKiller = false
local autoRequeue = false
local resultsUntil = 0
local lastCountdown = 0
local autoTouched = false -- Spieler hat den Auto-Requeue-Haken selbst umgeschaltet
local unbinds: { () -> () } = {}

-- UI-Teile
local root: Frame? = nil
local topBar: Frame? = nil
local timerLabel: TextLabel? = nil
local roundLabel: TextLabel? = nil
local leftName: TextLabel? = nil
local rightName: TextLabel? = nil
local leftPips: Frame? = nil
local rightPips: Frame? = nil
local zoneBar: any = nil
local bannerLabel: TextLabel? = nil
local bannerScale: UIScale? = nil
local subBanner: TextLabel? = nil
local bannerUntil = 0
local countdownLabel: TextLabel? = nil
local countdownScale: UIScale? = nil
local noticeLabel: TextLabel? = nil
local noticeUntil = 0
local killfeed: Frame? = nil
