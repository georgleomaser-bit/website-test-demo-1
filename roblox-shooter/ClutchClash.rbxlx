        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Progress</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  CLUTCH CLASH – Texte "prog." (Shared/Lang/Progress)
--  Besitzer: WP8 (Fortschritt). Nur Schlüssel mit Präfix "prog.".
--  Platzhalter wie string.format: %s = Text, %d = ganze Zahl, %% = Prozentzeichen.
--  Gruppen: Belohnungs-Bausteine (prog.r.*), Quests (prog.q.<Id>, %d = Ziel), Meldungen vom Server,
--  Lobby-Ansagen (prog.announce*), Chat-Präfixe (prog.chat.*), HUD (prog.hud.*), Fenster (prog.ui.*),
--  Statistik-Kacheln (prog.stat.*), Quest-Stufen (prog.tier.*).
-- =====================================================================

