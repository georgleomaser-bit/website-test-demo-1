	})
	UI.stroke(Hud.ComboLabel, { Color = C.Black, Transparency = 0.5, Text = true })
	Hud.ComboBar = UI.progress({ Size = UDim2.new(1, 0, 0, 8), Position = UDim2.fromOffset(0, 22), Color = C.Accent, Parent = combo })
	local buttonHolder = UI.frame({
		Name = "ButtonHolder",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(PRESS_SIZE, PRESS_SIZE),
		Parent = press,
	})
	Hud.Button = BigButton.new(buttonHolder, fx, PRESS_SIZE)
	ctx.BigButton = Hud.Button

	-- Quest card (right side; the only HUD element not at the bottom) ---------------------------
	local right = UI.frame({
		Name = "RightColumn",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.4, 0),
		Size = UDim2.fromOffset(270, 116),
		List = { Dir = "Y", Pad = 10, HA = "Right", VA = "Center" },
		Parent = layer,
	})
	Hud.Right = right
	addScale(right)

	local goal = UI.new("TextButton", {
		Name = "GoalCard",
		Size = UDim2.fromOffset(270, 116),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = 1,
		Selectable = true,
		Corner = Theme.Radius.Medium,
		Stroke = { Color = C.StrokeSoft, Thickness = 1.5 },
		Padding = 12,
		Parent = right,
	})
	Hud.GoalCard = goal
	Hud.GoalTitle = UI.label({ Text = "🎯 Next goal", Font = F.Heading, TextSize = 16, Size = UDim2.new(1, 0, 0, 20), Parent = goal })
	Hud.GoalText = UI.label({
		Text = "",
		TextSize = 14,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = C.TextDim,
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 24),
		Parent = goal,
	})
	Hud.GoalBar = UI.progress({ Size = UDim2.new(1, -90, 0, 12), Position = UDim2.fromOffset(0, 72), Color = C.Success, Parent = goal })
	Hud.GoalClaim = UI.button({
		Text = "Claim",
		Variant = "success",
		Size = UDim2.fromOffset(80, 30),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 63),
		TextSize = 14,
		Visible = false,
		OnClick = function()
			local result = ClientNet.once("starter", "ClaimStarter")
			if result then
				ctx.Notifications.result(result, "Reward claimed!")
			end
		end,
		Parent = goal,
	})
	goal.Activated:Connect(function()
		ScreenManager.open("Quests")
	end)

	-- Compact toggle for the quest card on small screens.
	Hud.SideToggle = UI.button({
		Name = "SideToggle",
		Text = "📋",
		Size = UDim2.fromOffset(44, 44),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 70),
		Variant = "ghost",
		Visible = false,
		OnClick = function()
			right.Visible = not right.Visible
		end,
		Parent = layer,
	})

	-- Wiring ------------------------------------------------------------------------------------------
	Hud.layout()
	UI.onViewportChanged(Hud.layout)

	State.subscribe({ "Currencies", "Progress", "Derived", "Stats" }, Hud.refreshTop)
	State.subscribe({ "Derived", "Stats", "Progress" }, Hud.refreshCenter)
	State.subscribe({ "Quests", "Progress", "Stats", "Derived", "Equipped", "Skills" }, Hud.refreshGoal)
	State.subscribe("Obby", Hud.refreshObby)
	State.subscribe({ "*" }, Hud.scheduleBadges)
	State.onReady(function()
		Hud.refreshTop()
		Hud.refreshCenter()
		Hud.refreshGoal()
		Hud.refreshObby()
		Hud.scheduleBadges()
	end)

	RunService.RenderStepped:Connect(Hud.step)
	task.spawn(function()
		while true do
			task.wait(0.5)
			Hud.refreshBoosts()
		end
	end)
end

-- Layout ----------------------------------------------------------------------------------------

function Hud.layout()
	local v = UI.viewport()
	local compact = UI.isCompact()
	local touch = UserInputService.TouchEnabled
	local fit = math.min(v.X / 1280, v.Y / 720)
	local base = math.clamp(fit, 0.55, 1.25)
	if compact then
		base = math.max(base, 0.62)
	end
	-- The UI Scale setting may always shrink the HUD, but only enlarge it while it still fits.
	local scale = math.min(base * Theme.UserScale, math.max(base, fit))
	for _, s in ipairs(scales) do
		s.Scale = scale
	end
	local inset = GuiService:GetGuiInset()
	local margin = 10

	-- PRESS: bottom right. Touch screens keep Roblox's jump button (bottom right) free.
	local jumpReserve = if touch then 140 else 0
	Hud.Center.Position = UDim2.new(1, -14, 1, -(margin + jumpReserve))
	local pressWidth = (PRESS_SIZE + 30) * scale

	-- Phones: icon-only navigation buttons.
	local navHeight = if compact then 46 else NAV_BUTTON.Y
	for _, nav in pairs(Hud.NavButtons) do
		nav.Text.Visible = not compact
		nav.Button.Size = UDim2.fromOffset(NAV_BUTTON.X, navHeight)
		nav.Icon.Position = UDim2.fromOffset(0, if compact then 7 else 4)
	end
	Hud.Rail.Size = UDim2.new(1, 0, 0, navHeight + 6)

	-- Dock: centred in the space beside the PRESS button (or the jump button), shrunk to fit.
	local rightReserve = if touch then 120 else pressWidth + 14 + margin
	local available = math.max(100, v.X - margin - rightReserve)
	Hud.DockScale.Scale = math.min(scale, available / DOCK_WIDTH)
	Hud.Dock.Position = UDim2.new(0, margin + available / 2, 1, -margin)

	-- Quest card: right side; on phones it hides behind a toggle under the top bar.
	Hud.Right.Visible = not compact
	Hud.SideToggle.Visible = compact
	if compact then
		Hud.Right.AnchorPoint = Vector2.new(1, 0)
		Hud.Right.Position = UDim2.new(1, -10, 0, inset.Y + 60)
		Hud.SideToggle.Position = UDim2.new(1, -10, 0, inset.Y + 8)
	else
		Hud.Right.AnchorPoint = Vector2.new(1, 0.5)
		Hud.Right.Position = UDim2.new(1, -14, 0.4, 0)
	end
	Hud.RateLabel.Visible = not compact
end

-- The HUD element a tutorial step points at ("press", "nav:Shop", "quests", "obby").
function Hud.target(key: string): GuiObject?
	if key == "press" then
		return Hud.Button.Cap
	elseif key == "quests" then
		return if Hud.Right.Visible then Hud.GoalCard else Hud.SideToggle
	elseif key == "obby" then
		return Hud.ObbyGo
	end
	local navId = string.match(key, "^nav:(.+)$")
	local nav = navId and Hud.NavButtons[navId]
	return if nav then nav.Button else nil
end

-- Refresh ------------------------------------------------------------------------------------

function Hud.refreshTop()
	local stats = State.stats()
	local progress = State.progress()
	if stats then
		local perSecond = stats.autoRate * stats.clickValue + stats.passivePerSec
		Hud.RateLabel.Text = `+{Format.short(stats.clickValue, true)} / press  ·  +{Format.short(perSecond, true)}/s auto`
		Hud.Button:SetValueText(stats.clickValue)
	end
	Hud.LevelLabel.Text = `Lv {progress.Level}`
	Hud.XPBar.Set(progress.XP / math.max(1, progress.XPRequired))
	local derived = State.get("Derived")
	Hud.SaveBadge.Visible = derived ~= nil and derived.Persistent == false
	local stage = Formulas.stageFor(progress.Rebirths)
	local frenzy = derived and derived.FrenzyEndsAt and derived.FrenzyEndsAt > workspace:GetServerTimeNow()
	local key = tostring(stage.Id) .. tostring(frenzy)
	if Hud.StageKey ~= key then
		Hud.StageKey = key
		Hud.Button:SetStage(stage.Id, frenzy == true)
	end
end

function Hud.refreshCenter()
	local stats = State.stats()
	if not stats then
		return
	end
	Hud.Chips.Crit.Text = `🎯 {Format.pct(stats.critChance)} · ×{Util.round(stats.critMultiplier, 2)}`
	Hud.Chips.Luck.Text = `🍀 +{Format.pct(stats.luck)}`
	Hud.Chips.Auto.Text = `🤖 {Util.round(stats.autoRate, 1)}/s · +{Format.short(stats.autoRate * stats.clickValue, true)}⚡`
	Hud.Chips.Multi.Text = `✖️ {Format.mult(stats.sparksMultiplier * stats.clickMultiplier)}`
	Hud.Chips.Auto.Visible = stats.autoRate > 0

	local data = State.view()
	local requirement = Formulas.rebirthRequirement(data.Rebirths)
	local run = data.Stats.SparksThisRun or 0
	local prisms = Formulas.rebirthPrisms(run, data.Rebirths, stats.prismMultiplier)
	Hud.AscendBar.Set(run / requirement, "")
	local progressText = `{Format.short(run)} / {Format.short(requirement)} Sparks this run`
	if prisms > 0 then
		Hud.AscendTitle.Text = "🔷 Ready!"
		Hud.AscendTitle.TextColor3 = C.Prisms
		Hud.AscendInfoText = `{progressText}\nReady! Ascend now for +{prisms} 🔷`
	else
		local nextStage = Formulas.nextStage(data.Rebirths)
		Hud.AscendTitle.Text = `🔷 {math.floor(math.min(1, run / requirement) * 100)}%`
		Hud.AscendTitle.TextColor3 = C.Text
		Hud.AscendInfoText = progressText
			.. "\n"
			.. (if nextStage then `Next stage: {nextStage.Name} ({nextStage.Rebirths} asc.)` else "All stages unlocked")
	end
end

local function questSummary()
	local quests = State.get("Quests")
	if not quests then
		return nil
	end
	local step = Quests.Starter[quests.StarterIndex]
	if step then
		return {
			Title = `🎯 Starter path {quests.StarterIndex}/{#Quests.Starter}`,
			Text = step.Text,
			Progress = quests.StarterProgress / step.Target,
			Label = `{Format.short(quests.StarterProgress)} / {Format.short(step.Target)}`,
			Claimable = quests.StarterProgress >= step.Target,
		}
	end
	local done, claimable = 0, false
	for _, q in ipairs(quests.Daily or {}) do
		if q.Claimed then
			done += 1
		elseif q.Progress >= q.Target then
			claimable = true
		end
	end
	return {
		Title = "📜 Daily quests",
		Text = if claimable then "A quest is ready to claim!" else `{done}/{#(quests.Daily or {})} claimed today`,
		Progress = done / math.max(1, #(quests.Daily or {})),
		Label = `{done}/{#(quests.Daily or {})}`,
		Claimable = false,
	}
end

function Hud.refreshGoal()
	local summary = questSummary()
	if not summary then
		return
	end
	Hud.GoalTitle.Text = summary.Title
	Hud.GoalText.Text = summary.Text
	Hud.GoalBar.Set(summary.Progress, summary.Label)
	Hud.GoalClaim.Visible = summary.Claimable
end

function Hud.refreshObby()
	local obby = State.get("Obby")
	local stage = if obby then obby.Stage else 0
	local done = if obby then obby.Completions else 0
	Hud.ObbyLabel.Text = `🏃 Obby {stage}/{ObbyConfig.StageCount}` .. (if done > 0 then `  🏆{done}` else "")
end

function Hud.refreshBoosts()
	local lines = {}
	local now = workspace:GetServerTimeNow()
	local derived = State.get("Derived")
	if derived and derived.FrenzyEndsAt and derived.FrenzyEndsAt > now then
		table.insert(lines, { `🔥 Frenzy ×{derived.FrenzyMultiplier or 1}`, derived.FrenzyEndsAt - now, C.Gold })
	end
	-- Boosts bought with Robux (their timer only runs while playing).
	for _, product in ipairs(DevProducts.List) do
		local endsAt = derived and derived.BoostEndsAt and derived.BoostEndsAt[product.Key]
		if product.Boost and type(endsAt) == "number" and endsAt > now then
			local amount = if product.Boost.Add then `+{math.floor(product.Boost.Add * 100 + 0.5)}%` else `×{product.Boost.Mult}`
			table.insert(lines, { `{product.Icon} {product.Name} {amount}`, endsAt - now, product.Color })
		end
	end
	local serverState = ReplicatedStorage:FindFirstChild("ServerState")
	if serverState then
		for _, id in ipairs(GameConfig.Events.Order) do
			local endsAt = serverState:GetAttribute("Event_" .. id)
			if type(endsAt) == "number" and endsAt > now then
				local def = GameConfig.Events.Definitions[id]
				table.insert(lines, { `{def.Icon} {def.Name} · {def.Description}`, endsAt - now, def.Color })
			end
		end
	end
	Hud.BoostsCard.Visible = #lines > 0
	for i, line in ipairs(lines) do
		local label = Hud.BoostLines[i]
		if not label then
			label = UI.label({
				TextSize = 13,
				Font = F.Bold,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 24),
				BackgroundColor3 = C.Panel,
				BackgroundTransparency = 0.1,
				Corner = Theme.Radius.Pill,
				Padding = { X = 10 },
				LayoutOrder = i,
				Parent = Hud.BoostsCard,
			})
			Hud.BoostLines[i] = label
		end
		label.Visible = true
		label.Text = `{line[1]}  ({Format.clock(line[2])})`
		label.TextColor3 = line[3]
	end
	for i = #lines + 1, #Hud.BoostLines do
		Hud.BoostLines[i].Visible = false
	end
	-- Frenzy start/end changes the button colour.
	Hud.refreshTop()
end

-- Badges ----------------------------------------------------------------------------------

local badgePending = false
function Hud.scheduleBadges()
	if badgePending then
		return
	end
	badgePending = true
	task.delay(0.4, function()
		badgePending = false
		Hud.refreshBadges()
	end)
end

local function setBadge(id: string, value: any)
	local nav = Hud.NavButtons[id]
	if not nav then
		return
	end
	if value == nil or value == false or value == 0 then
		nav.Badge.Visible = false
	else
		nav.Badge.Visible = true
		nav.Badge.Text = if type(value) == "number" then (if value > 99 then "99+" else tostring(value)) else "!"
	end
end

function Hud.refreshBadges()
	if not State.Ready then
		return
	end
	local data = State.view()
	local stats = State.stats()
	local sparks = State.currency("Sparks")

	local shop = false
	for _, def in ipairs(Upgrades.List) do
		local level = data.Upgrades[def.Id] or 0
		if level < def.MaxLevel and Formulas.upgradeUnlocked(def, data) and Formulas.upgradeLevelCost(def, level) <= sparks then
			shop = true
			break
		end
	end
	setBadge("Shop", shop)

	local crates = 0
	for _, n in pairs(State.get("Chests") or {}) do
		crates += n
	end
	setBadge("Chests", crates)

	local sp = State.progress().SkillPoints
	local skills = false
	for _, node in ipairs(Skills.List) do
		local rank = data.Skills[node.Id] or 0
		if rank < node.MaxRank and Skills.prerequisitesMet(node, data.Skills) and Skills.costFor(node, rank) <= sp then
			skills = true
			break
		end
	end
	setBadge("Skills", skills)

	local discovered = Formulas.discoveredCount(data)
	local claimedBook = State.get("CollectionClaimed") or {}
	local book = 0
	for _, m in ipairs(Rewards.Collection) do
		local need = if m.Count < 0 then Items.Count else m.Count
		if not claimedBook[m.Id] and discovered >= need then
			book += 1
		end
	end
	setBadge("Collection", book)

	local quests = State.get("Quests") or {}
	local questCount = 0
	for _, q in ipairs(quests.Daily or {}) do
		if not q.Claimed and q.Progress >= q.Target then
			questCount += 1
		end
	end
	local step = Quests.Starter[quests.StarterIndex or 1]
	if step and (quests.StarterProgress or 0) >= step.Target then
		questCount += 1
	end
	local daily = State.get("Daily")
	if daily and daily.LastClaimDay ~= Util.dayNumber(Util.serverTime()) then
		questCount += 1
	end
	setBadge("Quests", questCount)

	local ascend = false
	if stats then
		local requirement = Formulas.rebirthRequirement(data.Rebirths)
		ascend = (data.Stats.SparksThisRun or 0) >= requirement
		if not ascend then
			local prisms = State.currency("Prisms")
			for _, def in ipairs(Ascension.List) do
				local level = data.Ascension[def.Id] or 0
				if level < def.MaxLevel and Formulas.ascensionCost(def, level) <= prisms then
					ascend = true
					break
				end
			end
		end
	end
	setBadge("Ascend", ascend)
end

-- Per-frame: animated counters and combo decay ------------------------------------------------------

local accumulator = 0
function Hud.step(dt: number)
	accumulator += dt
	if accumulator < 1 / 30 then
		return
	end
	local step = accumulator
	accumulator = 0
	for currency, p in pairs(Hud.Pills) do
		local target = State.currency(currency)
		local shown = p.Displayed
		if Theme.ReducedMotion or shown <= 0 or target <= 0 or target / math.max(shown, 1e-9) > 1e3 or target < shown * 0.5 then
			shown = target
		else
			shown += (target - shown) * math.min(1, step * 10)
			if math.abs(target - shown) < math.max(1, target * 1e-4) then
				shown = target
			end
		end
		p.Displayed = shown
		local text = Format.short(shown)
		if p.Value.Text ~= text then
			p.Value.Text = text
		end
	end

	local stats = State.stats()
	if stats and Hud.Combo then
		local elapsed = os.clock() - (Hud.ComboAt or 0)
		if elapsed > stats.comboWindow and Hud.Combo > 0 then
			Hud.Combo = 0
			Hud.ComboLabel.Text = "COMBO 0"
			Hud.ComboLabel.TextColor3 = C.TextDim
			Hud.ComboBar.Set(0, "")
		end
	end
end

-- Server results ------------------------------------------------------------------------------------

function Hud.onClickResult(result)
	if type(result) ~= "table" then
		return
	end
	local settings = State.get("Settings") or {}
	local showNumbers = settings.FloatingNumbers ~= false
	if result.Auto or result.Passive then
		Hud.Button:ShowIncome(result, showNumbers)
		return
	end
	Hud.Button:ShowResult(result, showNumbers)
	local stats = State.stats()
	Hud.Combo = result.Combo or 0
	Hud.ComboAt = os.clock()
	if stats then
		local cap = stats.comboCap
		Hud.ComboLabel.Text = `COMBO {Hud.Combo}  ·  {Format.mult(result.ComboMult or 1)}`
		Hud.ComboLabel.TextColor3 = if Hud.Combo >= cap then C.Gold else C.Text
		Hud.ComboBar.Set(math.min(1, Hud.Combo / cap), "")
	end
	if result.Crit and settings.ScreenShake ~= false then
		Effects.shake(Hud.Ctx.Layers.Hud, 5, 0.15)
	end
	if result.Golden then
		Hud.Ctx.Notifications.golden(result.Golden)
	end
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[--[[
	InputController (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/InputController
	Depends on: Client/ScreenManager

	Pressing works everywhere, also while running around or doing the obby:
	  E (keyboard), R2 / L2 (controller)   press the PRESS button
	Controller menus on top of Roblox's built-in GUI selection:
	  Y         jump into the bottom menu (press again, or B, to leave it)
	  B         close the open window
	D-pad / left stick move between buttons while the menu is selected, A activates.
	Nothing is selected by default, so the left stick and A move and jump the character.
	Mouse and touch work directly on the UI; nothing extra is bound for them.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local ScreenManager = require(script.Parent.ScreenManager)

local InputController = {}

function InputController.init(ctx)
	ContextActionService:BindActionAtPriority("ButtonAscension_Press", function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if ScreenManager.isOpen() or UserInputService:GetFocusedTextBox() then
			return Enum.ContextActionResult.Pass
		end
		ctx.BigButton:Press()
		return Enum.ContextActionResult.Sink
	end, false, 2000, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonL2, Enum.KeyCode.E)

	local function inMenu(): boolean
		local selected = GuiService.SelectedObject
		return selected ~= nil and selected:IsDescendantOf(ctx.Hud.Dock)
	end

	ContextActionService:BindActionAtPriority("ButtonAscension_Back", function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if ScreenManager.isOpen() then
			ScreenManager.close()
			return Enum.ContextActionResult.Sink
		end
		if inMenu() then
			GuiService.SelectedObject = nil
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, 2000, Enum.KeyCode.ButtonB)

	ContextActionService:BindActionAtPriority("ButtonAscension_Nav", function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if inMenu() then
			GuiService.SelectedObject = nil
		else
			GuiService:Select(ctx.Hud.Rail)
		end
		return Enum.ContextActionResult.Sink
	end, false, 2000, Enum.KeyCode.ButtonY)
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">ItemCard</string>
            <string name="Source"><![CDATA[--[[
	ItemCard (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/ItemCard
	Depends on: ReplicatedStorage/UI/{UIKit,Theme}, ReplicatedStorage/Shared/Config/{Items,Rarities}

	Reusable item tile with rarity border, glow, icon, name and badges
	(count, equipped, favourite, new). Secret items get an animated rainbow
	border. Golden variants get a gold tint and border, Rainbow variants the
	animated rainbow border (static with Reduced Motion), both with a ✦ mark.
	Undiscovered items render as a dark silhouette.
	Cards are updated in place (Set) so large grids never get rebuilt.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local Items = require(Config.Items)
local Rarities = require(Config.Rarities)

local C = Theme.Colors
local F = Theme.Fonts

local ItemCard = {}
ItemCard.__index = ItemCard

local secretGradients: { UIGradient } = {}
local spinning = false

local function ensureSpin()
	if spinning then
		return
	end
	spinning = true
	RunService.RenderStepped:Connect(function(dt)
		if Theme.ReducedMotion then
			return
		end
		for i = #secretGradients, 1, -1 do
			local g = secretGradients[i]
			if g.Parent == nil then
				table.remove(secretGradients, i)
			else
				g.Rotation = (g.Rotation + dt * 90) % 360
			end
		end
	end)
end

--[[ props: Parent, Size, LayoutOrder, OnClick(card), ShowName (default true) ]]
function ItemCard.new(props)
	local self = setmetatable({}, ItemCard)
	local button = UI.new("TextButton", {
		Name = "ItemCard",
		Size = props.Size or UDim2.fromOffset(96, 112),
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundColor3 = C.PanelLight,
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		Corner = Theme.Radius.Medium,
		Parent = props.Parent,
	})
	self.Instance = button
	self.Stroke = UI.stroke(button, { Color = C.StrokeSoft, Thickness = 2 })
	self.Gradient = UI.gradient(button, { Color = ColorSequence.new(C.PanelLight, C.Panel), Rotation = 90 })
	self.Scale = Instance.new("UIScale")
	self.Scale.Parent = button

	self.Icon = UI.label({
		Name = "Icon",
		Text = "",
		TextSize = 40,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0.62, 0),
		Position = UDim2.fromScale(0, 0.06),
		ZIndex = 2,
		Parent = button,
	})
	self.Name = UI.label({
		Name = "ItemName",
		Text = "",
		Font = F.Bold,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, -8, 0.3, 0),
		Position = UDim2.new(0, 4, 0.68, 0),
		ZIndex = 2,
		Visible = props.ShowName ~= false,
		Parent = button,
	})
	self.Count = UI.label({
		Name = "Count",
		Text = "",
		Font = F.Heading,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(1, -8, 0, 16),
		Position = UDim2.fromOffset(0, 4),
		ZIndex = 3,
		Parent = button,
	})
	self.Equipped = UI.label({
		Name = "Equipped",
		Text = "E",
		Font = F.Heading,
		TextSize = 11,
		TextColor3 = C.Background,
		TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundColor3 = C.Success,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.fromOffset(4, 4),
		ZIndex = 3,
		Visible = false,
		Corner = Theme.Radius.Pill,
		Parent = button,
	})
	self.Favorite = UI.label({
		Name = "Favorite",
		Text = "★",
		TextSize = 14,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.fromOffset(4, 24),
		ZIndex = 3,
		Visible = false,
		Parent = button,
	})
	self.VariantMark = UI.label({
		Name = "VariantMark",
		Text = "✦",
		Font = F.Heading,
		TextSize = 15,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(1, -8, 0, 16),
		Position = UDim2.fromOffset(0, 20),
		ZIndex = 3,
		Visible = false,
		Parent = button,
	})
	self.NewBadge = UI.label({
		Name = "New",
		Text = "NEW",
		Font = F.Heading,
		TextSize = 11,
		TextColor3 = C.White,
		TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundColor3 = C.Accent,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(38, 16),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 0),
		ZIndex = 4,
		Visible = false,
		Corner = Theme.Radius.Pill,
		Parent = button,
	})

	button.MouseEnter:Connect(function()
		UI.tween(self.Scale, { Scale = 1.05 }, Theme.Motion.Fast)
	end)
	button.MouseLeave:Connect(function()
		UI.tween(self.Scale, { Scale = 1 }, Theme.Motion.Fast)
	end)
	button.SelectionGained:Connect(function()
		UI.tween(self.Scale, { Scale = 1.05 }, Theme.Motion.Fast)
	end)
	button.SelectionLost:Connect(function()
		UI.tween(self.Scale, { Scale = 1 }, Theme.Motion.Fast)
	end)
	if props.OnClick then
		button.Activated:Connect(function()
			props.OnClick(self)
		end)
	end
	return self
end

--[[
	state: { Id, Count?, Equipped?, Favorite?, New?, Undiscovered?, Selected? }
]]
function ItemCard:Set(state)
	self.State = state
	local item = Items.ById[state.Id]
	if not item then
		return
	end
	local rarity = Rarities.ById[item.Rarity]
	local undiscovered = state.Undiscovered == true
	local color = if undiscovered then C.StrokeSoft else rarity.Color

	self.Icon.Text = if undiscovered then "?" else item.Icon
	self.Icon.TextColor3 = if undiscovered then C.TextMuted else C.White
	self.Icon.Font = if undiscovered then F.Heading else F.Medium
	if undiscovered then
		self.Name.Text = if item.Rarity == "Secret" then "Secret" else "???"
		self.Name.TextColor3 = C.TextMuted
	else
		self.Name.Text = item.Name
		self.Name.TextColor3 = rarity.Color
	end
	self.Count.Text = if state.Count and state.Count > 1 then "×" .. tostring(state.Count) else ""
	self.Equipped.Visible = state.Equipped == true
	self.Favorite.Visible = state.Favorite == true
	self.NewBadge.Visible = state.New == true

	local variant = if undiscovered then nil else Items.VariantById[item.Variant or ""]
	self.VariantMark.Visible = variant ~= nil
	if variant then
		self.VariantMark.TextColor3 = variant.Color
	end
	self.Stroke.Color = if state.Selected then C.White elseif variant and variant.Id == "golden" then C.Gold else color
	self.Stroke.Thickness = if state.Selected or variant then 3 else 2
	self.Gradient.Color = if undiscovered
		then ColorSequence.new(C.Panel, C.BackgroundAlt)
		elseif variant and variant.Id == "golden" then ColorSequence.new(Color3.fromRGB(130, 96, 18), C.Panel)
		elseif variant then ColorSequence.new(Color3.fromRGB(110, 40, 120), C.Panel)
		else ColorSequence.new(Theme.darken(rarity.Glow, 0.35), C.Panel)

	local secretGradient = self.Stroke:FindFirstChildOfClass("UIGradient")
	if (item.Rarity == "Secret" or item.Variant == "rainbow") and not undiscovered then
		if not secretGradient then
			secretGradient = Instance.new("UIGradient")
			secretGradient.Color = Rarities.SecretGradient
			secretGradient.Parent = self.Stroke
			table.insert(secretGradients, secretGradient)
			ensureSpin()
		end
		self.Stroke.Color = C.White
	elseif secretGradient then
		secretGradient:Destroy()
	end
end

return ItemCard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">Notifications</string>
            <string name="Source"><![CDATA[--[[
	Notifications (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Notifications
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format, Config/*}

	Toasts (top-right stack), banners (centre-top queue) and announcements.
	Handles every "Notify" kind sent by the server (see ServerScriptService/Core/Net).
]]

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Effects = require(UIFolder.Effects)
local SoundPlayer = require(UIFolder.SoundPlayer)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Config = Shared.Config
local Items = require(Config.Items)
local Chests = require(Config.Chests)
local Achievements = require(Config.Achievements)
local GameConfig = require(Config.GameConfig)
local GamePasses = require(Config.GamePasses)

local C = Theme.Colors
local F = Theme.Fonts

local Notifications = {}

local toastList: Frame
local bannerHolder: Frame
local bannerQueue = {}
local bannerBusy = false
local layer: Frame
local context: any = nil

function Notifications.describeReward(reward): string
	if type(reward) ~= "table" then
		return ""
	end
	local parts = {}
	if reward.Sparks then
		table.insert(parts, "⚡ " .. Format.short(reward.Sparks))
	end
	if reward.Gems then
		table.insert(parts, "💎 " .. Format.short(reward.Gems))
	end
	if reward.Prisms then
		table.insert(parts, "🔷 " .. Format.short(reward.Prisms))
	end
	if reward.SkillPoints then
		table.insert(parts, `🌳 {reward.SkillPoints} SP`)
	end
	if reward.Chests then
		for _, id in ipairs(Chests.Order) do
			local n = reward.Chests[id]
			if n then
				table.insert(parts, `{Chests.ById[id].Icon} {n}× {Chests.ById[id].Name}`)
			end
		end
	end
	if reward.XP then
		table.insert(parts, "📈 " .. Format.short(reward.XP) .. " XP")
	end
	return table.concat(parts, "   ")
end

function Notifications.init(ctx)
	context = ctx
	layer = ctx.Layers.Notifications
	local inset = GuiService:GetGuiInset()
	toastList = UI.frame({
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, inset.Y + 70),
		Size = UDim2.fromOffset(330, 400),
		List = { Dir = "Y", Pad = 8, HA = "Right" },
		Scale = 1,
		Parent = layer,
	})
	bannerHolder = UI.frame({
		Name = "Banners",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, inset.Y + 100),
		Size = UDim2.fromOffset(560, 130),
		Scale = 1,
		Parent = layer,
	})
	local function rescale()
		local v = UI.viewport()
		local s = math.clamp(math.min(v.X / 1280, v.Y / 720), 0.6, 1.2) * Theme.UserScale
		for _, holder in ipairs({ toastList, bannerHolder }) do
			local scale = holder:FindFirstChildOfClass("UIScale")
			if scale then
				scale.Scale = s
			end
		end
	end
	rescale()
	UI.onViewportChanged(rescale)
	Notifications.rescale = rescale
end

-- Toasts ----------------------------------------------------------------------------------

function Notifications.toast(text: string, opts: { Icon: string?, Color: Color3?, Duration: number? }?)
	local o = opts or {}
	local color = o.Color or C.Accent2
	local holder = UI.frame({ Name = "Toast", Size = UDim2.fromOffset(330, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = toastList })
	local card = UI.new("Frame", {
		Name = "Card",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromOffset(360, 0),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.04,
		Corner = Theme.Radius.Medium,
		Stroke = { Color = Theme.darken(color, 0.3), Thickness = 1.5 },
		Padding = { 14, 12, 10, 10 },
		Parent = holder,
	})
	UI.new("Frame", {
		Name = "Accent",
		Size = UDim2.new(0, 4, 1, -12),
		Position = UDim2.fromOffset(-8, 6),
		BackgroundColor3 = color,
		Corner = Theme.Radius.Pill,
		Parent = card,
	})
	UI.label({
		Text = (if o.Icon then o.Icon .. "  " else "") .. text,
		TextWrapped = true,
		RichText = true,
		TextSize = 15,
		Font = F.Medium,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 20),
		Parent = card,
	})
	if Theme.ReducedMotion then
		card.Position = UDim2.fromOffset(0, 0)
	else
		UI.tween(card, { Position = UDim2.fromOffset(0, 0) }, Theme.Motion.Normal)
	end
	task.delay(o.Duration or 3.6, function()
		local t = UI.tween(card, { Position = UDim2.fromOffset(360, 0) }, Theme.Motion.Normal)
		if t then
			t.Completed:Wait()
		end
		holder:Destroy()
	end)
	local toasts = toastList:GetChildren()
	local count = 0
	for _, child in ipairs(toasts) do
		if child:IsA("Frame") then
			count += 1
		end
	end
	if count > 5 then
		for _, child in ipairs(toasts) do
			if child:IsA("Frame") and child ~= holder then
				child:Destroy()
				break
			end
		end
	end
end

function Notifications.error(text: string?)
	SoundPlayer.play("Error")
	Notifications.toast(text or "Something went wrong.", { Icon = "⚠️", Color = C.Danger })
end

-- Shows the error of a failed action result, or an optional success message.
function Notifications.result(result, successText: string?)
	if not result then
		return
	end
	if result.ok then
		if successText then
			SoundPlayer.play("Purchase")
			local rewardText = if result.Reward then "  " .. Notifications.describeReward(result.Reward) else ""
			Notifications.toast(successText .. rewardText, { Icon = "✅", Color = C.Success })
		end
	else
		Notifications.error(result.err)
	end
end

-- Banners -----------------------------------------------------------------------------------

local function showNextBanner()
	if bannerBusy then
		return
	end
	local spec = table.remove(bannerQueue, 1)
	if not spec then
		return
	end
	bannerBusy = true
	local color = spec.Color or C.Accent
	local card = UI.new("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -40),
		Size = UDim2.fromOffset(spec.Width or 520, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.02,
		Corner = Theme.Radius.Large,
		Stroke = { Color = color, Thickness = 2 },
		Padding = { 20, 20, 14, 14 },
		List = { Dir = "Y", Pad = 4, HA = "Center" },
		Parent = bannerHolder,
	})
	UI.gradient(card, { Color = ColorSequence.new(Theme.darken(color, 0.72), C.Panel), Rotation = 90 })
	if spec.Kicker then
		UI.label({ Text = spec.Kicker, Font = F.Bold, TextSize = 13, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 1, Parent = card })
	end
	UI.label({
		Text = spec.Title,
		Font = F.Heading,
		TextSize = spec.TitleSize or 26,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 2,
		Parent = card,
	})
	if spec.Text and spec.Text ~= "" then
		UI.label({
			Text = spec.Text,
			TextColor3 = C.TextDim,
			TextSize = 16,
			TextWrapped = true,
			RichText = spec.RichText == true,
			TextXAlignment = Enum.TextXAlignment.Center,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 20),
			LayoutOrder = 3,
			Parent = card,
		})
	end
	if spec.Sound then
		SoundPlayer.play(spec.Sound)
	end
	if spec.Flash then
		Effects.flash(layer, color, 0.18)
	end
	if Theme.ReducedMotion then
		card.Position = UDim2.new(0.5, 0, 0, 0)
	else
		UI.tween(card, { Position = UDim2.new(0.5, 0, 0, 0) }, Theme.Motion.Pop)
	end
	task.delay(spec.Duration or 3.5, function()
		local t = UI.tween(card, { Position = UDim2.new(0.5, 0, 0, -220) }, Theme.Motion.Normal)
		if t then
			t.Completed:Wait()
		end
		card:Destroy()
		bannerBusy = false
		showNextBanner()
	end)
end

function Notifications.banner(spec)
	table.insert(bannerQueue, spec)
	-- Announcements jump the queue so staff messages are never delayed.
	if spec.Priority then
		table.remove(bannerQueue)
		table.insert(bannerQueue, 1, spec)
	end
	showNextBanner()
end

-- Special notifications ------------------------------------------------------------------------

function Notifications.golden(golden)
	local text
	if golden.Type == "Sparks" then
		text = `+{Format.short(golden.Amount)} Sparks`
	elseif golden.Type == "Gems" then
		text = `+{Format.short(golden.Amount)} Gems`
	elseif golden.Type == "Chest" then
		local chest = Chests.ById[golden.Chest]
		text = if chest then `+1 {chest.Name}` else "A crate"
	elseif golden.Type == "Frenzy" then
		text = `Frenzy! All Sparks ×{golden.Multiplier} for {golden.Duration}s`
	end
	Notifications.toast(`<b>GOLDEN PRESS!</b> {text or ""}`, { Icon = "🌟", Color = C.Gold, Duration = 4 })
end

local HANDLERS = {}

HANDLERS.Toast = function(data)
	Notifications.toast(data.Text or "", { Icon = data.Icon, Color = data.Color })
end

HANDLERS.Error = function(data)
	Notifications.error(data.Text)
end

HANDLERS.Warning = function(data)
	SoundPlayer.play("Error")
	Notifications.toast(data.Text or "", { Icon = "⚠️", Color = C.Warning, Duration = 7 })
end

HANDLERS.LevelUp = function(data)
	local parts = {}
	if data.SkillPoints and data.SkillPoints > 0 then
		table.insert(parts, `+{data.SkillPoints} Skill Point{if data.SkillPoints == 1 then "" else "s"}`)
	end
	for id, n in pairs(data.Chests or {}) do
		local chest = Chests.ById[id]
		if chest then
			table.insert(parts, `+{n} {chest.Name}`)
		end
	end
	Notifications.banner({
		Kicker = "LEVEL UP",
		Title = `Level {data.Level}`,
		Text = table.concat(parts, "  ·  "),
		Color = C.Accent3,
		Sound = "LevelUp",
		Duration = 2.6,
		Width = 380,
	})
end

HANDLERS.Discovery = function(data)
	local item = Items.ById[data.Item]
	if item then
		local hex = Theme.rarityColor(item.Rarity):ToHex()
		Notifications.toast(`New discovery: {item.Icon} <font color="#{hex}"><b>{item.Name}</b></font> ({item.Rarity})`, {
			Icon = "📖",
			Color = Theme.rarityColor(item.Rarity),
		})
	end
end

HANDLERS.Achievement = function(data)
	local def = Achievements.ById[data.Id]
	if def then
		Notifications.banner({
			Kicker = "ACHIEVEMENT UNLOCKED",
			Title = `{def.Icon} {def.Name}`,
			Text = Notifications.describeReward(data.Reward),
			Color = C.Gold,
			Sound = "Unlock",
			Duration = 3.4,
		})
	end
end

HANDLERS.Announcement = function(data)
	local global = data.Scope == "global"
	Notifications.banner({
		Kicker = if global then "🌐 GAME-WIDE ANNOUNCEMENT" else "📢 SERVER ANNOUNCEMENT (this server)",
		Title = data.Text or "",
		TitleSize = 21,
		Text = `— {data.From or "Staff"}`,
		Color = if global then C.Accent3 else C.Accent2,
		Sound = "Announcement",
		Duration = 8,
		Width = 600,
		Priority = true,
		Flash = true,
	})
end

HANDLERS.Event = function(data)
	local def = GameConfig.Events.Definitions[data.Id]
	if not def then
		return
	end
	if data.Started then
		local seconds = (data.EndsAt or 0) - workspace:GetServerTimeNow()
		Notifications.banner({
			Kicker = "SERVER EVENT",
			Title = `{def.Icon} {def.Name}`,
			Text = `{def.Description} for {Format.time(seconds)} in this server!`,
			Color = def.Color,
			Sound = "Unlock",
			Duration = 4,
			Flash = true,
		})
	else
		Notifications.toast(`{def.Icon} {def.Name} has ended.`, { Color = def.Color })
	end
end

HANDLERS.Reward = function(data)
	SoundPlayer.play("Purchase")
	Notifications.toast(`<b>{data.Title or "Reward"}</b>: {data.Text or ""}`, { Icon = "🎁", Color = C.Success })
end

HANDLERS.Pass = function(data)
	local pass = GamePasses.ByKey[data.Key]
	if pass then
		Notifications.banner({
			Kicker = "GAME PASS UNLOCKED",
			Title = `{pass.Icon} {pass.Name}`,
			Text = pass.EffectText,
			Color = pass.Color,
			Sound = "Unlock",
			Duration = 5,
			Flash = true,
		})
	end
end

-- A Robux crate the server already opened and applied: play the opening for it
-- (after any opening that is still on screen).
HANDLERS.CrateOpened = function(data)
	local chest = Chests.RobuxById[data.Chest]
	if not chest or type(data.Results) ~= "table" or #data.Results == 0 then
		return
	end
	task.spawn(function()
		local ChestOpening = require(script.Parent.Screens.ChestOpening)
		local deadline = os.clock() + 60
		while ChestOpening.isActive() and os.clock() < deadline do
			task.wait(0.25)
		end
		ChestOpening.play(context, chest, data.Results)
	end)
end

HANDLERS.Stage = function(data)
	local stage = GameConfig.Stages[data.Stage]
	if stage then
		Notifications.banner({
			Kicker = "NEW STAGE UNLOCKED",
			Title = stage.Name,
			Text = stage.Description,
			Color = stage.Accent,
			Sound = "LevelUp",
			Duration = 5,
			Flash = true,
		})
	end
end

HANDLERS.Offline = function(data)
	Notifications.banner({
		Kicker = "WELCOME BACK",
		Title = `+{Format.short(data.Amount)} Sparks`,
		Text = `Your generators kept running for {Format.time(data.Seconds)} while you were away.`,
		Color = C.Sparks,
		Sound = "Purchase",
		Duration = 5,
	})
end

HANDLERS.Rare = function(data)
	local item = Items.ById[data.Item]
	if item then
		local hex = Theme.rarityColor(item.Rarity):ToHex()
		Notifications.toast(`<b>{data.Player}</b> found {item.Icon} <font color="#{hex}"><b>{item.Name}</b></font> ({item.Rarity})!`, {
			Icon = "🌟",
			Color = Theme.rarityColor(item.Rarity),
			Duration = 5,
		})
	end
end

function Notifications.handle(kind: string, data: any)
	local handler = HANDLERS[kind]
	if handler and type(data) == "table" then
		handler(data)
	end
end

return Notifications
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">ObbyClient</string>
            <string name="Source"><![CDATA[--[[
	ObbyClient (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/ObbyClient
	Depends on: ReplicatedStorage/Shared/Config/Obby, ReplicatedStorage/UI/Theme, Client/State

	Local-only look of the obby: checkpoints you have already cleared in your
	current run turn green, the next one pulses. Nothing here replicates or
	affects progress (the server decides that, see ObbyService).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local ObbyConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Obby"))
local Theme = require(ReplicatedStorage:WaitForChild("UI"):WaitForChild("Theme"))
local State = require(script.Parent.State)

local ObbyClient = {}

local CLEARED = Color3.fromRGB(74, 222, 128)
local AHEAD = Color3.fromRGB(77, 225, 255)
local NEXT = Color3.fromRGB(255, 255, 255)

function ObbyClient.init(_ctx)
	task.spawn(function()
		local model = workspace:WaitForChild("Obby", 60)
		if not model then
			return
		end
		local pads = {}
		for stage = 1, ObbyConfig.StageCount - 1 do
			local pad = model:WaitForChild("Checkpoint" .. stage, 10)
			if pad and pad:IsA("BasePart") then
				pads[stage] = pad
			end
		end
		local pulse: Tween? = nil
		local function apply()
			local obby = State.get("Obby")
			local stage = if obby then obby.Stage else 0
			if pulse then
				pulse:Cancel()
				pulse = nil
			end
			for index, pad in pairs(pads) do
				pad.Color = if index <= stage then CLEARED else AHEAD
			end
			local nextPad = pads[stage + 1]
			if nextPad then
				nextPad.Color = NEXT
				if Theme.ReducedMotion then
					return
				end
				local tween = TweenService:Create(nextPad, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Color = AHEAD })
				tween:Play()
				pulse = tween
			end
		end
		State.subscribe("Obby", apply)
		State.onReady(apply)
	end)
end

return ObbyClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">Orbs</string>
            <string name="Source"><![CDATA[--[[
	Orbs (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Orbs
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format, Config/Chests},
	            Client/{ClientNet, Notifications}

	Renders bonus orbs offered by the server (OrbSpawn) and claims them.
	The server decides whether a claim is valid and what it is worth.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Effects = require(UIFolder.Effects)
local SoundPlayer = require(UIFolder.SoundPlayer)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Chests = require(Shared.Config.Chests)

local ClientNet = require(script.Parent.ClientNet)

local C = Theme.Colors
local Orbs = {}

local layer: Frame
local notifications

function Orbs.init(ctx)
	layer = ctx.Layers.Orbs
	notifications = ctx.Notifications
end

local function describe(reward): string
	if reward.Type == "Sparks" then
		return `+{Format.short(reward.Amount)} Sparks`
	elseif reward.Type == "Gems" then
		return `+{Format.short(reward.Amount)} Gems`
	elseif reward.Type == "Chest" then
		local chest = Chests.ById[reward.Chest]
		return if chest then `+1 {chest.Name}` else "+1 crate"
	elseif reward.Type == "Frenzy" then
		return `Frenzy ×{reward.Multiplier} for {reward.Duration}s!`
	end
	return "Bonus!"
end

function Orbs.spawn(info)
	if type(info) ~= "table" or type(info.Id) ~= "number" then
		return
	end
	local lifetime = info.Lifetime or 8
	local orb = UI.new("TextButton", {
		Name = "Orb",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(info.X or 0.5, info.Y or 0.4),
		Size = UDim2.fromOffset(84, 84),
		BackgroundColor3 = C.Accent2,
		AutoButtonColor = false,
		Text = "✨",
		TextSize = 34,
		ZIndex = 50,
		Selectable = true,
		Corner = Theme.Radius.Pill,
		Stroke = { Color = C.White, Thickness = 3, Transparency = 0.2 },
		Parent = layer,
	})
	UI.gradient(orb, {
		Color = ColorSequence.new(Color3.fromRGB(150, 255, 255), Color3.fromRGB(80, 120, 255)),
		Rotation = 45,
	})
	local scale = Instance.new("UIScale")
	scale.Scale = 0
	scale.Parent = orb
	UI.tween(scale, { Scale = 1 }, Theme.Motion.Pop, true)
	local timer = UI.new("Frame", {
		Name = "Timer",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 6),
		Size = UDim2.fromOffset(70, 6),
		BackgroundColor3 = C.White,
		ZIndex = 50,
		Corner = Theme.Radius.Pill,
		Parent = orb,
	})
	UI.tween(timer, { Size = UDim2.fromOffset(0, 6) }, TweenInfo.new(lifetime, Enum.EasingStyle.Linear), true)
	SoundPlayer.play("Orb")

	local alive = true
	local born = os.clock()
	local origin = orb.Position
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if not alive then
			connection:Disconnect()
			return
		end
		if not Theme.ReducedMotion then
			local t = os.clock() - born
			orb.Position = origin + UDim2.fromOffset(math.sin(t * 2.3) * 10, math.sin(t * 3.1) * 8)
			orb.Rotation = math.sin(t * 1.7) * 8
		end
	end)

	local function remove()
		alive = false
		local t = UI.tween(scale, { Scale = 0 }, Theme.Motion.Fast, true)
		if t then
			t.Completed:Wait()
		end
		orb:Destroy()
	end

	orb.Activated:Connect(function()
		if not alive then
			return
		end
		alive = false
		local center = orb.AbsolutePosition + orb.AbsoluteSize / 2 - layer.AbsolutePosition
		Effects.burst(layer, center, C.Accent2, 18, 180)
		Effects.ring(layer, center, C.Accent2, 220)
		task.spawn(remove)
		local result = ClientNet.action("ClaimOrb", { Id = info.Id })
		if result.ok and result.Reward then
			SoundPlayer.play("Golden")
			notifications.toast(`<b>Bonus orb!</b> {describe(result.Reward)}`, { Icon = "✨", Color = C.Accent2 })
		else
			notifications.error(result.err)
		end
	end)

	task.delay(lifetime, function()
		if alive then
			remove()
		end
	end)
end

return Orbs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">ScreenManager</string>
            <string name="Source"><![CDATA[--[[
	ScreenManager (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/ScreenManager
	Depends on: ReplicatedStorage/Shared/Signal

	Keeps track of the full-screen windows (Shop, Crates, Inventory, ...).
	Only one is open at a time; opening another closes the current one.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Signal"))

local ScreenManager = {
	Current = nil :: string?,
	Changed = Signal.new(),
}

local screens: { [string]: any } = {}

-- screen must expose Window (from UIKit.window); optional OnOpen() / OnClose().
function ScreenManager.register(id: string, screen)
	screens[id] = screen
	screen.Window.Closed.Event:Connect(function()
		if ScreenManager.Current == id then
			ScreenManager.Current = nil
			ScreenManager.Changed:Fire(nil)
		end
		if screen.OnClose then
			screen.OnClose()
		end
	end)
end

function ScreenManager.get(id: string)
	return screens[id]
end

function ScreenManager.open(id: string, ...: any)
	local screen = screens[id]
	if not screen then
		return
	end
	if ScreenManager.Current and ScreenManager.Current ~= id then
		local previous = screens[ScreenManager.Current]
		task.spawn(previous.Window.Close)
	end
	ScreenManager.Current = id
	if screen.OnOpen then
		screen.OnOpen(...)
	end
	screen.Window.Open()
	ScreenManager.Changed:Fire(id)
end

function ScreenManager.close()
	local id = ScreenManager.Current
	if id and screens[id] then
		task.spawn(screens[id].Window.Close)
	end
end

function ScreenManager.toggle(id: string)
	if ScreenManager.Current == id then
		ScreenManager.close()
	else
		ScreenManager.open(id)
	end
end

function ScreenManager.isOpen(id: string?): boolean
	if id then
		return ScreenManager.Current == id
	end
	return ScreenManager.Current ~= nil
end

return ScreenManager
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="105">
          <Properties>
            <string name="Name">Screens</string>
          </Properties>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">Ascend</string>
              <string name="Source"><![CDATA[--[[
	Ascend (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Screens/Ascend
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format,Formulas,Config/*},
	            Client/{State,ClientNet}

	Ascension (rebirth): shows progress toward the requirement, the Prisms
	you would receive, the permanent multiplier and the next stage, plus an
	explicit list of what resets and what is kept. Ascending always asks for
	confirmation. The right side is the Prism shop (permanent perks).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Effects = require(UIFolder.Effects)
local SoundPlayer = require(UIFolder.SoundPlayer)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Config = Shared.Config
local Ascension = require(Config.Ascension)
local GameConfig = require(Config.GameConfig)

local Client = script.Parent.Parent
local State = require(Client.State)
local ClientNet = require(Client.ClientNet)

local C = Theme.Colors
local F = Theme.Fonts

local AscendScreen = {}

AscendScreen.Resets = {
	"Sparks (you start with your Head Start bonus)",
	"All Shop upgrade levels (Auto-Presser kept with Loyal Robots)",
	"Sparks earned this run and your current combo",
}
AscendScreen.Keeps = {
	"Gems, Prisms and Ascension perks",
	"Skill tree, Skill Points, level and XP",
	"Inventory, equipped items, favourites and collection",
	"Owned crates and pity progress",
	"Achievements, quests, login streak, statistics and settings",
}

function AscendScreen.new(ctx)
	local window = UI.window({
		Name = "Ascend",
		Title = "Ascension",
		Subtitle = "Reset your run for Prisms, a permanent Sparks multiplier and new stages.",
		Icon = "🔷",
		Accent = C.Prisms,
		Parent = ctx.Layers.Windows,
	})
	local screen: { [string]: any } = { Window = window }
	local body = window.Body

	local left = UI.panel({ Name = "Info", Size = UDim2.new(0.5, -8, 1, 0), BackgroundColor3 = C.PanelLight, Padding = 16, Parent = body })
	local title = UI.label({ Text = "", Font = F.Heading, TextSize = 22, Size = UDim2.new(1, 0, 0, 28), Parent = left })
	local bar = UI.progress({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 36), Color = C.Prisms, TextSize = 13, Parent = left })
	local gain = UI.label({ Text = "", Font = F.Heading, TextSize = 18, TextColor3 = C.Prisms, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 62), Parent = left })
	local mult = UI.label({ Text = "", TextSize = 14, TextColor3 = C.TextDim, RichText = true, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 88), Parent = left })
	local stageLabel = UI.label({ Text = "", TextSize = 14, TextColor3 = C.TextDim, TextWrapped = true, RichText = true, Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 110), Parent = left })

	-- Scrollable so the lists never collide with the button on small screens.
	local lists = UI.scroll({
		Name = "Lists",
		Size = UDim2.new(1, 0, 1, -214),
		Position = UDim2.fromOffset(0, 150),
		List = { Dir = "Y", Pad = 3 },
		Parent = left,
	})
	local order = 0
	local function list(titleText: string, entries: { string }, color: Color3)
		order += 1
		UI.label({ Text = titleText, Font = F.Heading, TextSize = 15, TextColor3 = color, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = order, Parent = lists })
		for _, text in ipairs(entries) do
			order += 1
			UI.label({
				Text = "•  " .. text,
				TextSize = 13,
				TextColor3 = C.TextDim,
				TextWrapped = true,
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = UDim2.new(1, -8, 0, 18),
				LayoutOrder = order,
				Parent = lists,
			})
		end
	end
	list("Resets", AscendScreen.Resets, C.Danger)
	list("You keep", AscendScreen.Keeps, C.Success)

	local ascend = UI.button({
		Text = "Ascend",
		Icon = "🔷",
		Variant = "violet",
		Size = UDim2.new(1, 0, 0, 52),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		TextSize = 20,
		OnClick = function()
			local data = State.view()
			local stats = State.stats()
			local prisms = Formulas.rebirthPrisms(data.Stats.SparksThisRun or 0, data.Rebirths, if stats then stats.prismMultiplier else 1)
			local ok = UI.confirm({
				Title = `Ascend for +{prisms} Prisms?`,
				Message = "Your Sparks and Shop upgrades reset. Gems, items, skills, level and all permanent progress are kept.",
				ConfirmText = "Ascend",
			})
			if not ok then
				return
			end
			local result = ClientNet.once("rebirth", "Rebirth")
			if not result then
				return
			end
			if result.ok then
				SoundPlayer.play("LevelUp")
				Effects.flash(ctx.Layers.Fx, C.Prisms, 0.6)
				local v = UI.viewport()
				Effects.burst(ctx.Layers.Fx, v / 2, C.Prisms, 40, 420)
				Effects.ring(ctx.Layers.Fx, v / 2, C.Prisms, 900)
				ctx.Notifications.banner({
					Kicker = `ASCENSION {result.Rebirths}`,
					Title = `+{result.Prisms} 🔷 Prisms`,
					Text = `Permanent Sparks ×{1 + GameConfig.Rebirth.MultiplierPerRebirth * result.Rebirths} from ascensions.`,
					Color = C.Prisms,
					Duration = 4,
				})
			else
				ctx.Notifications.error(result.err)
			end
		end,
		Parent = left,
	})

	-- Prism shop -------------------------------------------------------------------------------
	local right = UI.frame({ Size = UDim2.new(0.5, -8, 1, 0), Position = UDim2.new(0.5, 8, 0, 0), Parent = body })
	local prismLabel = UI.label({ Text = "", Font = F.Heading, TextSize = 18, TextColor3 = C.Prisms, Size = UDim2.new(1, 0, 0, 24), Parent = right })
	local shop = UI.scroll({ Size = UDim2.new(1, 0, 1, -32), Position = UDim2.fromOffset(0, 32), List = { Dir = "Y", Pad = 8 }, Padding = { 2, 8, 2, 2 }, Parent = right })
	local perkCards = {}
	for index, def in ipairs(Ascension.List) do
		local card = UI.panel({ Name = def.Id, Size = UDim2.new(1, 0, 0, 74), BackgroundColor3 = C.PanelLight, LayoutOrder = index, Parent = shop })
		UI.label({ Text = def.Icon, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(48, 74), Parent = card })
		UI.label({ Text = def.Name, Font = F.Heading, TextSize = 15, Size = UDim2.new(1, -170, 0, 20), Position = UDim2.fromOffset(48, 8), Parent = card })
		UI.label({ Text = def.Description, TextSize = 12, TextColor3 = C.TextDim, TextWrapped = true, Size = UDim2.new(1, -170, 0, 28), Position = UDim2.fromOffset(48, 28), Parent = card })
		local level = UI.label({ Text = "", Font = F.Bold, TextSize = 12, TextColor3 = C.Accent2, RichText = true, Size = UDim2.new(1, -170, 0, 16), Position = UDim2.fromOffset(48, 54), Parent = card })
		local buy = UI.button({
			Text = "",
			Variant = "violet",
			Size = UDim2.fromOffset(108, 44),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			TextSize = 15,
			Sound = "Purchase",
			OnClick = function()
				local result = ClientNet.once("perk:" .. def.Id, "BuyAscension", { Id = def.Id })
				if result and not result.ok then
					ctx.Notifications.error(result.err)
				end
			end,
			Parent = card,
		})
		perkCards[def.Id] = { Def = def, Level = level, Buy = buy }
	end

	function screen.Refresh()
		if not window.IsOpen() then
			return
		end
		local data = State.view()
		local stats = State.stats()
		local requirement = Formulas.rebirthRequirement(data.Rebirths)
		local run = data.Stats.SparksThisRun or 0
		local prisms = Formulas.rebirthPrisms(run, data.Rebirths, if stats then stats.prismMultiplier else 1)
		title.Text = `Ascension #{data.Rebirths + 1}`
		bar.Set(run / requirement, `{Format.short(run)} / {Format.short(requirement)} Sparks this run`)
		gain.Text = if prisms > 0 then `You will gain +{prisms} 🔷 Prisms` else `Earn {Format.short(requirement - run)} more Sparks this run`
		local perRebirth = GameConfig.Rebirth.MultiplierPerRebirth
		mult.Text = `Permanent Sparks multiplier: {Format.mult(1 + perRebirth * data.Rebirths)} → <font color="#C47DFF"><b>{Format.mult(1 + perRebirth * (data.Rebirths + 1))}</b></font>`
		local current = Formulas.stageFor(data.Rebirths)
		local nextStage = Formulas.nextStage(data.Rebirths)
		stageLabel.Text = `Stage: <b>{current.Name}</b>`
			.. (if nextStage then ` · next: <b>{nextStage.Name}</b> at {nextStage.Rebirths} ascensions (×{nextStage.Multiplier} Sparks, new crate)` else " · all stages unlocked")
		UI.setEnabled(ascend, prisms > 0)

		local balance = State.currency("Prisms")
		prismLabel.Text = `🔷 {Format.short(balance)} Prisms`
		for id, entry in pairs(perkCards) do
			local def = entry.Def
			local lvl = data.Ascension[id] or 0
			if lvl >= def.MaxLevel then
				entry.Level.Text = `Lv {lvl}/{def.MaxLevel} · {Format.display(def.Display, def.Value(lvl))} · MAX`
				UI.setText(entry.Buy, "MAX")
				UI.setEnabled(entry.Buy, false)
			else
				local cost = Formulas.ascensionCost(def, lvl)
				entry.Level.Text = `Lv {lvl}/{def.MaxLevel} · {Format.display(def.Display, def.Value(lvl))} → <b>{Format.display(def.Display, def.Value(lvl + 1))}</b>`
				UI.setText(entry.Buy, Format.short(cost), "🔷")
				UI.setEnabled(entry.Buy, balance >= cost)
			end
		end
	end

	local pending = false
	State.subscribe({ "Stats", "Currencies", "Ascension", "Progress", "Derived" }, function()
		if pending or not window.IsOpen() then
			return
		end
		pending = true
		task.delay(0.2, function()
			pending = false
			screen.Refresh()
		end)
	end)
	window.Opened.Event:Connect(screen.Refresh)
	return screen
end

return AscendScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">ChestOpening</string>
              <string name="Source"><![CDATA[--[[
	ChestOpening (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Screens/ChestOpening
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format,Formulas,Config/*},
	            Client/{ItemCard,State}

	Cinematic reveal of results the server has ALREADY applied:
	  anticipation shake (glow shifts toward the best rarity, ticks speed up
	  and rise in pitch) → whoosh + boom, flash and light rays → item cards pop
	  in one by one with rising chimes and NEW / PITY / BONUS badges → a
	  fanfare that grows with the best rarity (Epic, Legendary, Mythic/Secret).
	Click or press anywhere to skip ahead. Reduced Motion and the Fast Crates
	game pass show the results at once.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Effects = require(UIFolder.Effects)
local SoundPlayer = require(UIFolder.SoundPlayer)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Config = Shared.Config
local Items = require(Config.Items)
local Rarities = require(Config.Rarities)
local GamePasses = require(Config.GamePasses)
local Sounds = require(Config.Sounds)

local ItemCard = require(script.Parent.Parent.ItemCard)
local State = require(script.Parent.Parent.State)

local C = Theme.Colors
local F = Theme.Fonts

local ChestOpening = {}

local active = false

local function bestResult(results)
	local best = results[1]
	for _, r in ipairs(results) do
		if Rarities.index(r.Rarity) > Rarities.index(best.Rarity) then
			best = r
		end
	end
	return best
end

-- Waits up to `seconds`, returning early when the player skips.
local function skippableWait(state, seconds: number)
	local stop = os.clock() + seconds
	while os.clock() < stop and not state.Skip do
		task.wait()
	end
end

function ChestOpening.play(ctx, chest, results, onAgain: (() -> ())?)
	if active or #results == 0 then
		return
	end
	active = true
	-- Fast Crates owners skip straight to the results.
	local state = { Skip = GamePasses.owns(State.get("Passes"), "fast_crates") }
	local best = bestResult(results)
	local bestColor = Theme.rarityColor(best.Rarity)

	local root = UI.new("TextButton", {
		Name = "ChestOpening",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.05,
		AutoButtonColor = false,
		Text = "",
		Selectable = false,
		ZIndex = 80,
		Parent = ctx.Layers.Overlay,
	})
	root.Activated:Connect(function()
		state.Skip = true
	end)
	local stage = UI.frame({
		Name = "Stage",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(900, 620),
		ZIndex = 81,
		Scale = UI.fitScale(900, 620, 0.96, 0.92),
		Parent = root,
	})

	-- Anticipation -------------------------------------------------------------------
	local glow = UI.new("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(220, 220),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.85,
		ZIndex = 82,
		Corner = Theme.Radius.Pill,
		Parent = stage,
	})
	local glowStroke = UI.stroke(glow, { Color = C.White, Thickness = 6, Transparency = 0.3 })
	local crate = UI.label({
		Name = "Crate",
		Text = chest.Icon,
		TextSize = 120,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(200, 200),
		ZIndex = 83,
		Parent = stage,
	})
	local caption = UI.label({
		Text = `Opening {#results > 1 and (#results .. " items from ") or ""}{chest.Name}…`,
		Font = F.Heading,
		TextSize = 22,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromScale(0, 0.72),
		ZIndex = 83,
		Parent = stage,
	})

	if not Theme.ReducedMotion and not state.Skip then
		SoundPlayer.play("CrateWhoosh")
	end
	if not Theme.ReducedMotion then
		local steps = 14
		for i = 1, steps do
			if state.Skip then
				break
			end
			local t = i / steps
			local amount = 2 + t * 12
			crate.Rotation = (if i % 2 == 0 then 1 else -1) * amount
			crate.Position = UDim2.new(0.5, (math.random() - 0.5) * amount, 0.45, (math.random() - 0.5) * amount)
			-- The glow drifts from white toward the colour of the best drop.
			local color = C.White:Lerp(bestColor, t)
			glow.BackgroundColor3 = color
			glowStroke.Color = color
			glow.Size = UDim2.fromOffset(220 + t * 80, 220 + t * 80)
			-- Ticks speed up and climb in pitch toward the burst.
			SoundPlayer.play("CrateTick", { Pitch = 0.8 + t * 0.9, Volume = 0.6 + t * 0.4 })
			skippableWait(state, 0.11 - t * 0.07)
		end
	end
	crate.Rotation = 0

	-- Burst -----------------------------------------------------------------------------
	SoundPlayer.play("ChestBurst")
	SoundPlayer.play("CrateBoom")
	-- Effects draw above the opening layers (ZIndex 80-88).
	Effects.flash(root, bestColor, 0.5, 90)
	local center = Vector2.new(450, 280)
	Effects.burst(stage, center, bestColor, 30, 360, 90)
	Effects.ring(stage, center, bestColor, 700, 89)
	crate.Visible = false
	glow.Visible = false
	caption.Visible = false
	local rays = Effects.rays(stage, bestColor, 760)
	rays.Position = UDim2.fromScale(0.5, 0.45)
	rays.ZIndex = 81

	-- Reveal ----------------------------------------------------------------------------
	local single = #results == 1
	-- Bonus drops can push a 10× opening past 14 results; smaller cards keep them in three rows.
	-- Fast Crates allows ×20 (up to 40 results with bonus drops): tiny cards in four rows.
	local dense = #results > 14
	local tiny = #results > 27
	local cardSize = if single
		then UDim2.fromOffset(220, 256)
		elseif tiny then UDim2.fromOffset(64, 76)
		elseif dense then UDim2.fromOffset(80, 94)
		else UDim2.fromOffset(112, 130)
	local holder = UI.frame({
		Name = "Cards",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, if single then 0.4 else 0.42),
		Size = UDim2.fromOffset(860, if single then 270 elseif tiny then 360 elseif dense then 330 else 290),
		ZIndex = 84,
		Grid = { Cell = cardSize, Pad = UDim2.fromOffset(10, 12), HA = "Center" },
		Parent = stage,
	})
	local grid = holder:FindFirstChildOfClass("UIGridLayout")
	if grid then
		grid.VerticalAlignment = Enum.VerticalAlignment.Center
	end

	local newCount, soldGems, variantDrops = 0, 0, 0
	for index, result in ipairs(results) do
		local item = Items.ById[result.Item]
		if item then
			local card = ItemCard.new({ Parent = holder, LayoutOrder = index, Size = cardSize })
			card:Set({ Id = item.Id, Count = result.Count, New = result.New })
			card.Instance.ZIndex = 85
			if single then
				card.Icon.TextSize = 96
				card.Name.TextSize = 20
			elseif tiny then
				card.Icon.TextSize = 24
				card.Name.TextSize = 9
			elseif dense then
				card.Icon.TextSize = 30
				card.Name.TextSize = 10
			end
			if result.New then
				newCount += 1
			end
			if result.AutoSold then
				soldGems += result.AutoSold
			end
			local variant = item.Variant and Items.VariantById[item.Variant]
			if variant then
				variantDrops += 1
			end
			local tags = {}
			if variant then
				table.insert(tags, string.upper(variant.Name))
			end
			if result.Pity then
				table.insert(tags, "PITY")
			elseif result.Bonus then
				table.insert(tags, "BONUS")
			elseif result.Test then
				table.insert(tags, "TEST")
			end
			if #tags > 0 then
				UI.label({
					Text = table.concat(tags, " · "),
					Font = F.Heading,
					TextSize = 11,
					TextColor3 = C.Background,
					TextXAlignment = Enum.TextXAlignment.Center,
					BackgroundColor3 = if variant then variant.Color elseif result.Pity then C.Gold else C.Accent2,
					BackgroundTransparency = 0,
					AnchorPoint = Vector2.new(0.5, 1),
					Position = UDim2.new(0.5, 0, 1, 6),
					Size = UDim2.fromOffset(52, 16),
					AutomaticSize = Enum.AutomaticSize.X,
					Padding = { X = 4 },
					ZIndex = 88,
					Corner = Theme.Radius.Pill,
					Parent = card.Instance,
				})
			end
			UI.attachTooltip(card.Instance, function()
				return `<b>{item.Icon} {item.Name}</b> ({item.Rarity})\n{Formulas.describeItemBonus(item, result.Count or 1)}\n{item.Description}`
			end)
			if not Theme.ReducedMotion and not state.Skip then
				card.Scale.Scale = 0
				UI.tween(card.Scale, { Scale = 1 }, Theme.Motion.Pop, true)
				local rarityIndex = Rarities.index(item.Rarity)
				-- Each card's chime is a little higher than the last; rarer cards sparkle.
				SoundPlayer.play("CrateChime", { Pitch = math.min(2, 0.9 + (index - 1) * 0.06) + (rarityIndex - 1) * 0.04 })
				if rarityIndex >= 4 then
					SoundPlayer.play("CrateSparkle")
				end
				-- Golden and Rainbow drops get their own sparkle and a burst in their colour.
				if variant then
					SoundPlayer.sequence("CrateSparkle", if variant.Id == "rainbow" then { 2, 2.52, 3, 4 } else { 2, 2.52 }, 0.05)
					if variant.Id == "rainbow" then
						SoundPlayer.play("CrateJackpot")
					end
					local pos = card.Instance.AbsolutePosition + card.Instance.AbsoluteSize / 2 - stage.AbsolutePosition
					Effects.burst(stage, pos / math.max(0.01, (stage:FindFirstChildOfClass("UIScale") :: UIScale).Scale), variant.Color, 20, 180, 90)
				end
				if rarityIndex >= 5 then
					local pos = card.Instance.AbsolutePosition + card.Instance.AbsoluteSize / 2 - stage.AbsolutePosition
					Effects.burst(stage, pos / math.max(0.01, (stage:FindFirstChildOfClass("UIScale") :: UIScale).Scale), Theme.rarityColor(item.Rarity), 16, 160, 90)
				end
				skippableWait(state, if single then 0.2 else 0.12)
			end
		end
	end

	-- Skipped reveals still announce Golden/Rainbow drops with a sparkle.
	if variantDrops > 0 and (Theme.ReducedMotion or state.Skip) then
		SoundPlayer.sequence("CrateSparkle", { 2, 2.52, 3 }, 0.05)
	end

	-- Fanfare for the best drop -----------------------------------------------------------
	local bestIndex = Rarities.index(best.Rarity)
	local fanfare = if bestIndex >= 6
		then Sounds.CrateFanfares.Mythic
		elseif bestIndex >= 5 then Sounds.CrateFanfares.Legendary
		elseif bestIndex >= 4 then Sounds.CrateFanfares.Epic
		else nil
	if fanfare then
		SoundPlayer.sequence("CrateFanfare", fanfare.Notes, fanfare.Gap)
		if fanfare.Sparkle then
			task.delay(#fanfare.Notes * fanfare.Gap, SoundPlayer.sequence, "CrateSparkle", { 2, 2.52, 3 }, 0.06)
		end
		if fanfare.Jackpot then
			SoundPlayer.play("CrateJackpot")
			SoundPlayer.play("CrateBoom", { Pitch = 0.35 })
			Effects.flash(root, bestColor, 0.35, 90)
		end
	end

	-- Summary ---------------------------------------------------------------------------
	local bestItem = Items.ById[best.Item]
	local headline = if single and bestItem then `{bestItem.Rarity} · {bestItem.Name}` else `{#results} items · best: {best.Rarity}`
	UI.label({
		Text = headline,
		Font = F.Heading,
		TextSize = 28,
		TextColor3 = bestColor,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromScale(0, 0.74),
		ZIndex = 86,
		Parent = stage,
	})
	local details = {}
	if newCount > 0 then
		table.insert(details, `✨ {newCount} new discover{if newCount == 1 then "y" else "ies"}!`)
	end
	if soldGems > 0 then
		table.insert(details, `Auto-sold duplicates for 💎 {Format.short(soldGems)}`)
	end
	if single and bestItem then
		table.insert(details, Formulas.describeItemBonus(bestItem, best.Count or 1) .. " when equipped")
	end
	UI.label({
		Text = table.concat(details, "   ·   "),
		TextColor3 = C.TextDim,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromScale(0, 0.8),
		ZIndex = 86,
		Parent = stage,
	})

	local done = false
	local function close()
		if done then
			return
		end
		done = true
		active = false
		root:Destroy()
	end
	local buttons = UI.frame({
		Size = UDim2.fromOffset(420, 50),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.87),
		ZIndex = 86,
		List = { Dir = "X", Pad = 12, HA = "Center" },
		Parent = stage,
	})
	local closeButton = UI.button({
		Text = "Continue",
		Variant = "secondary",
		Size = UDim2.fromOffset(180, 46),
		LayoutOrder = 2,
		ZIndex = 87,
		OnClick = close,
		Parent = buttons,
	})
	if onAgain then
		UI.button({
			Text = "Open again",
			Variant = "gold",
			Size = UDim2.fromOffset(180, 46),
			LayoutOrder = 1,
			ZIndex = 87,
			OnClick = function()
				close()
				onAgain()
			end,
			Parent = buttons,
		})
	end
	if UserInputService.GamepadEnabled then
		GuiService.SelectedObject = closeButton
	end
end

function ChestOpening.isActive(): boolean
	return active
end

return ChestOpening
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">Chests</string>
              <string name="Source"><![CDATA[--[[
	Chests (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Screens/Chests
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format,Formulas,Loot,Config/*},
	            Client/{State,ClientNet,ItemCard,Screens/ChestOpening}

	Crate shop: pick a crate on the left; the right panel shows its price,
	owned count, live drop odds (including your Luck), pity progress and every
	item in its pool (undiscovered ones stay hidden). Opening calls the
	server, which rolls everything; the result is then animated by ChestOpening.
	Below the normal crates, the Robux crates (developer products) open
	Roblox's purchase prompt; the server opens them after the purchase.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Loot = require(Shared.Loot)
local Config = Shared.Config
local Chests = require(Config.Chests)
local Items = require(Config.Items)
local Rarities = require(Config.Rarities)
local GameConfig = require(Config.GameConfig)
local DevProducts = require(Config.DevProducts)
local RobuxSale = require(Shared.RobuxSale)

local Client = script.Parent.Parent
local State = require(Client.State)
local ClientNet = require(Client.ClientNet)
local ChestOpening = require(script.Parent.ChestOpening)

local C = Theme.Colors
local F = Theme.Fonts

local ChestsScreen = {}

function ChestsScreen.new(ctx)
	local window = UI.window({
		Name = "Chests",
		Title = "Crates",
		Subtitle = "Every roll happens on the server. Luck shifts the odds toward rarer items.",
		Icon = "🎁",
		Parent = ctx.Layers.Windows,
	})
	local screen: { [string]: any } = { Window = window }
	local body = window.Body
	local selected = "starter"
	local busy = false

	local listFrame = UI.scroll({
		Name = "CrateList",
		Size = UDim2.new(0, 300, 1, 0),
		List = { Dir = "Y", Pad = 8 },
		Padding = { 2, 8, 2, 2 },
		Parent = body,
	})
	local detail = UI.panel({
		Name = "Detail",
		Size = UDim2.new(1, -316, 1, 0),
		Position = UDim2.fromOffset(316, 0),
		BackgroundColor3 = C.PanelLight,
		Parent = body,
	})
	local detailScroll = UI.scroll({
		Size = UDim2.fromScale(1, 1),
		List = { Dir = "Y", Pad = 10 },
		Padding = 16,
		Parent = detail,
	})

	local crateCards = {}
	for index, chestId in ipairs(Chests.Order) do
		local chest = Chests.ById[chestId]
		local card = UI.new("TextButton", {
			Name = chestId,
			Size = UDim2.new(1, 0, 0, 76),
			BackgroundColor3 = C.PanelLight,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = index,
			Selectable = true,
			Corner = Theme.Radius.Medium,
			Parent = listFrame,
		})
		local stroke = UI.stroke(card, { Color = C.StrokeSoft, Thickness = 1.5 })
		UI.label({ Text = chest.Icon, TextSize = 34, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(64, 76), Parent = card })
		UI.label({ Text = chest.Name, Font = F.Heading, TextSize = 17, TextColor3 = chest.Color, Size = UDim2.new(1, -72, 0, 22), Position = UDim2.fromOffset(64, 12), Parent = card })
		local sub = UI.label({ Text = "", TextSize = 13, TextColor3 = C.TextDim, RichText = true, Size = UDim2.new(1, -72, 0, 18), Position = UDim2.fromOffset(64, 38), Parent = card })
		local owned = UI.label({
			Text = "",
			Font = F.Heading,
			TextSize = 13,
			TextColor3 = C.White,
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundColor3 = C.Accent,
			BackgroundTransparency = 0,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(24, 22),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -8, 0, 8),
			Visible = false,
			Corner = Theme.Radius.Pill,
			Padding = { X = 6 },
			Parent = card,
		})
		card.Activated:Connect(function()
			selected = chestId
			screen.Refresh()
		end)
		crateCards[chestId] = { Card = card, Stroke = stroke, Sub = sub, Owned = owned }
	end

	-- Robux crates: a purchase prompt; hidden in live games until their ProductId is set.
	local isStudio = RunService:IsStudio()
	local robuxTitle = UI.label({
		Name = "RobuxCratesTitle",
		Text = "💰 Robux crates",
		Font = F.Heading,
		TextSize = 15,
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 100,
		Parent = listFrame,
	})
	local robuxCards = {}
	for index, chest in ipairs(Chests.RobuxList) do
		local product = DevProducts.ByKey[chest.Id]
		local card = UI.new("TextButton", {
			Name = chest.Id,
			Size = UDim2.new(1, 0, 0, 64),
			BackgroundColor3 = C.PanelLight,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = 100 + index,
			Selectable = true,
			Corner = Theme.Radius.Medium,
			Parent = listFrame,
		})
		UI.stroke(card, { Color = chest.Color, Thickness = 1.5, Transparency = 0.3 })
		UI.label({ Text = chest.Icon, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(64, 64), Parent = card })
		UI.label({ Text = chest.Name, Font = F.Heading, TextSize = 16, TextColor3 = chest.Color, Size = UDim2.new(1, -72, 0, 22), Position = UDim2.fromOffset(64, 8), Parent = card })
		local sub = UI.label({ Text = "", TextSize = 12, TextColor3 = C.TextDim, Size = UDim2.new(1, -72, 0, 18), Position = UDim2.fromOffset(64, 32), Parent = card })
		card.Activated:Connect(function()
			local kind, id = if product then RobuxSale.of(product) else nil, 0
			if kind == "product" then
				MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
			elseif kind == "pass" then
				MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, id)
			end
		end)
		robuxCards[chest.Id] = { Card = card, Sub = sub, Product = product, Chest = chest }
	end
	local function refreshRobuxCrates()
		local any = false
		for _, entry in pairs(robuxCards) do
			local configured = entry.Product ~= nil and DevProducts.isConfigured(entry.Product)
			entry.Card.Visible = configured or isStudio
			any = any or entry.Card.Visible
			entry.Sub.Text = if configured
				then `{entry.Chest.Description} · R$ {entry.Product.SuggestedPrice}`
				else "Not set up (ProductId missing)"
		end
		robuxTitle.Visible = any
	end

	-- Detail panel content (rebuilt when the selection changes; cheap: one crate).
	local detailItems: { Instance } = {}
	local buyButtons: { { Button: TextButton, Cost: number, Currency: string } } = {}
	local function clearDetail()
		table.clear(buyButtons)
		for _, inst in ipairs(detailItems) do
			inst:Destroy()
		end
		table.clear(detailItems)
	end
	local function add(inst: Instance)
		table.insert(detailItems, inst)
		return inst
	end

	local function openChest(chestId: string, count: number, mode: string)
		if busy then
			return
		end
		local chest = Chests.ById[chestId]
		-- Gems are slow to earn, so spending them is confirmed (Sparks crates are bought quickly).
		if mode == "buy" and chest.Currency == "Gems" then
			local stats = State.stats()
			local price = Formulas.chestPrice(chest, if stats then stats.chestDiscount else 0) * count
			local ok = UI.confirm({
				Title = `Buy {count}× {chest.Name}?`,
				Message = `This spends 💎 {Format.commas(price)} Gems.`,
				ConfirmText = "Buy",
			})
			if not ok then
				return
			end
		end
		busy = true
		local result = ClientNet.action("OpenChest", { Id = chestId, Amount = count, Mode = mode })
		busy = false
		if not result.ok then
			ctx.Notifications.error(result.err)
			return
		end
		ChestOpening.play(ctx, chest, result.Results or {}, function()
			-- "Open again" with the same settings.
			openChest(chestId, count, mode)
		end)
	end
	screen.OpenChest = openChest

	local function buildDetail()
		clearDetail()
		local chest = Chests.ById[selected]
		local data = State.view()
		local stats = State.stats()
		local luck = if stats then stats.luck else 0
		local discount = if stats then stats.chestDiscount else 0
		local unlocked = Formulas.chestUnlocked(chest, data)
		local owned = (State.get("Chests") or {})[chest.Id] or 0
		local order = 0
		local function nextOrder()
			order += 1
			return order
		end

		add(UI.label({
			Text = `{chest.Icon}  {chest.Name}`,
			Font = F.Heading,
			TextSize = 24,
			TextColor3 = chest.Color,
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = nextOrder(),
			Parent = detailScroll,
		}))
		add(UI.label({
			Text = chest.Description,
			TextColor3 = C.TextDim,
			TextSize = 14,
			TextWrapped = true,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = nextOrder(),
			Parent = detailScroll,
		}))

		if not unlocked then
			local stage = GameConfig.Stages[chest.Stage]
			add(UI.label({
				Text = `🔒 Unlocks at stage {stage.Name} ({stage.Rebirths} Ascension{if stage.Rebirths == 1 then "" else "s"}).`,
				Font = F.Bold,
				TextColor3 = C.Warning,
				TextSize = 15,
				Size = UDim2.new(1, 0, 0, 22),
				LayoutOrder = nextOrder(),
				Parent = detailScroll,
			}))
		else
			local price = Formulas.chestPrice(chest, discount)
			local icon = Theme.currencyIcon(chest.Currency)
			local balance = State.currency(chest.Currency)
			-- The Fast Crates pass raises the limit; offer the new maximum as an extra button.
			local amounts = table.clone(Chests.OpenAmounts)
			local maxOpen = Formulas.maxOpen(chest, stats)
			if maxOpen > amounts[#amounts] then
				table.insert(amounts, maxOpen)
			end
			local buyRow = add(UI.frame({ Size = UDim2.new(1, 0, 0, 46), LayoutOrder = nextOrder(), List = { Dir = "X", Pad = 8 }, Parent = detailScroll }))
			for i, n in ipairs(amounts) do
				local cost = price * n
				local buyButton = UI.button({
					Text = `Buy ×{n}  {icon} {Format.short(cost)}`,
					Variant = "gold",
					Size = UDim2.new(1 / #amounts, -6, 1, 0),
					LayoutOrder = i,
					TextSize = if #amounts > 3 then 12 else 14,
					Disabled = balance < cost,
					OnClick = function()
						openChest(chest.Id, n, "buy")
					end,
					Parent = buyRow,
				})
				table.insert(buyButtons, { Button = buyButton, Cost = cost, Currency = chest.Currency })
			end
			local ownRow = add(UI.frame({ Size = UDim2.new(1, 0, 0, 40), LayoutOrder = nextOrder(), List = { Dir = "X", Pad = 8 }, Parent = detailScroll }))
			for i, n in ipairs(amounts) do
				UI.button({
					Text = `Open owned ×{n}`,
					Variant = "primary",
					Size = UDim2.new(1 / #amounts, -6, 1, 0),
					LayoutOrder = i,
					TextSize = if #amounts > 3 then 12 else 14,
					Disabled = owned < n,
					OnClick = function()
						openChest(chest.Id, n, "owned")
					end,
					Parent = ownRow,
				})
			end
			add(UI.label({
				Text = `You own {owned} · Balance {icon} {Format.short(balance)}`
					.. (if discount > 0 and chest.Currency == "Sparks" then ` · {Format.pct(math.min(0.6, discount))} discount` else "")
					.. (if chest.Currency ~= "Sparks" then " · no discounts or bonus drops on Gem crates" else ""),
				TextColor3 = C.TextDim,
				TextSize = 13,
				Size = UDim2.new(1, 0, 0, 18),
				LayoutOrder = nextOrder(),
				Parent = detailScroll,
			}))
		end

		-- Odds
		add(UI.label({
			Text = `Drop odds  ·  Luck +{Format.pct(luck)}`,
			Font = F.Heading,
			TextSize = 16,
			Size = UDim2.new(1, 0, 0, 22),
			LayoutOrder = nextOrder(),
			Parent = detailScroll,
		}))
		for _, entry in ipairs(Loot.effectiveWeights(chest, luck)) do
			local row = add(UI.frame({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = nextOrder(), Parent = detailScroll }))
			UI.label({ Text = entry.Rarity, Font = F.Bold, TextSize = 14, TextColor3 = Theme.rarityColor(entry.Rarity), Size = UDim2.new(0, 110, 1, 0), Parent = row })
			local bar = UI.progress({ Size = UDim2.new(1, -200, 0, 8), Position = UDim2.new(0, 110, 0.5, -4), Color = Theme.rarityColor(entry.Rarity), Parent = row })
			bar.Fill.Size = UDim2.fromScale(math.clamp(entry.Chance ^ 0.5, 0.02, 1), 1)
			UI.label({
				Text = Format.pct(entry.Chance, if entry.Chance < 0.01 then 3 else 1),
				Font = F.Bold,
				TextSize = 13,
				TextColor3 = C.TextDim,
				TextXAlignment = Enum.TextXAlignment.Right,
				Size = UDim2.new(0, 80, 1, 0),
				Position = UDim2.new(1, -80, 0, 0),
				Parent = row,
			})
		end

		-- Pity
		local pityState = (State.get("Pity") or {})[chest.Id] or {}
		local pityMult = if stats then stats.pityMultiplier else 1
		for _, rarityId in ipairs(Rarities.Order) do
			local threshold = Formulas.pityThreshold(chest, rarityId, pityMult)
			if threshold then
				local progressValue = pityState[rarityId] or 0
				local row = add(UI.frame({ Size = UDim2.new(1, 0, 0, 34), LayoutOrder = nextOrder(), Parent = detailScroll }))
				UI.label({
					Text = `Pity: guaranteed {rarityId}+ within {threshold} opens`,
					TextSize = 13,
					TextColor3 = C.TextDim,
					Size = UDim2.new(1, 0, 0, 16),
					Parent = row,
				})
				local bar = UI.progress({ Size = UDim2.new(1, 0, 0, 10), Position = UDim2.fromOffset(0, 20), Color = Theme.rarityColor(rarityId), Parent = row })
				bar.Set(progressValue / threshold, "")
			end
		end

		-- Pool preview
		add(UI.label({ Text = "Possible items", Font = F.Heading, TextSize = 16, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = nextOrder(), Parent = detailScroll }))
		local grid = add(UI.frame({
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = nextOrder(),
			Grid = { Cell = UDim2.fromOffset(52, 52), Pad = UDim2.fromOffset(6, 6) },
			Parent = detailScroll,
		}))
		local discovered = State.get("Discovered") or {}
		local pool = Items.PoolByChest[chest.Id] or {}
		local index = 0
		for _, rarityId in ipairs(Rarities.Order) do
			for _, itemId in ipairs(pool[rarityId] or {}) do
				index += 1
				local item = Items.ById[itemId]
				local known = discovered[itemId] ~= nil
				local tile = UI.label({
					Text = if known then item.Icon else "?",
					TextSize = 26,
					TextColor3 = if known then C.White else C.TextMuted,
					TextXAlignment = Enum.TextXAlignment.Center,
					BackgroundColor3 = if known then Theme.darken(Theme.rarityGlow(rarityId), 0.4) else C.BackgroundAlt,
					BackgroundTransparency = 0,
					LayoutOrder = index,
					Corner = Theme.Radius.Small,
					Stroke = { Color = if known then Theme.rarityColor(rarityId) else C.StrokeSoft, Thickness = 1.5 },
					Parent = grid,
				})
				UI.attachTooltip(tile, function()
					if known then
						return `<b>{item.Icon} {item.Name}</b> ({item.Rarity})\n{Formulas.describeItemBonus(item, 1)}`
					end
					return if rarityId == "Secret" then "A secret item hides in this crate…" else `Undiscovered {rarityId} item`
				end)
			end
		end
	end

	function screen.Refresh()
		if not window.IsOpen() then
			return
		end
		refreshRobuxCrates()
		local data = State.view()
		local stats = State.stats()
		local owned = State.get("Chests") or {}
		for chestId, entry in pairs(crateCards) do
			local chest = Chests.ById[chestId]
			local unlocked = Formulas.chestUnlocked(chest, data)
			local price = Formulas.chestPrice(chest, if stats then stats.chestDiscount else 0)
			entry.Sub.Text = if unlocked
				then `{Theme.currencyIcon(chest.Currency)} {Format.short(price)}`
				else `🔒 {GameConfig.Stages[chest.Stage].Name}`
			entry.Card.BackgroundTransparency = if unlocked then 0 else 0.45
			entry.Stroke.Color = if chestId == selected then chest.Color else C.StrokeSoft
			entry.Stroke.Thickness = if chestId == selected then 2.5 else 1.5
			local n = owned[chestId] or 0
			entry.Owned.Visible = n > 0
			entry.Owned.Text = tostring(n)
		end
		buildDetail()
	end

	-- Balance changes constantly while pressing: only update button states for it.
	local function updateAffordability()
		for _, entry in ipairs(buyButtons) do
			UI.setEnabled(entry.Button, State.currency(entry.Currency) >= entry.Cost)
		end
	end
	local pending, pendingCurrency = false, false
	State.subscribe("Currencies", function()
		if pendingCurrency or not window.IsOpen() then
			return
		end
		pendingCurrency = true
		task.delay(0.2, function()
			pendingCurrency = false
			updateAffordability()
		end)
	end)
	local function scheduleRefresh()
		if pending or not window.IsOpen() then
			return
		end
		pending = true
		task.delay(0.25, function()
			pending = false
			screen.Refresh()
		end)
	end
	State.subscribe({ "Chests", "Pity", "Discovered", "Derived" }, scheduleRefresh)
	-- Progress changes with every XP gain; only an Ascension can unlock a crate.
	local lastRebirths = nil
	State.subscribe("Progress", function()
		local rebirths = State.progress().Rebirths
		if rebirths ~= lastRebirths then
			lastRebirths = rebirths
			scheduleRefresh()
		end
	end)
	window.Opened.Event:Connect(screen.Refresh)

	function screen.OnOpen(chestId: string?)
		if chestId and Chests.ById[chestId] then
			selected = chestId
		end
	end
	return screen
end

return ChestsScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">Collection</string>
              <string name="Source"><![CDATA[--[[
	Collection (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Screens/Collection
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format,Formulas,Config/*},
	            Client/{State,ClientNet,ItemCard}

	The collection book: every item in the game grouped by crate. Discovered
	items show their art and bonus; undiscovered ones are silhouettes (Secret
	items reveal nothing). Each discovery permanently adds +1% Sparks, and
	milestones grant rewards that are claimed here.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Config = Shared.Config
local Items = require(Config.Items)
local Chests = require(Config.Chests)
local Rarities = require(Config.Rarities)
local Rewards = require(Config.Rewards)
local GameConfig = require(Config.GameConfig)

local Client = script.Parent.Parent
local State = require(Client.State)
local ClientNet = require(Client.ClientNet)
local ItemCard = require(Client.ItemCard)

local C = Theme.Colors
local F = Theme.Fonts

local Collection = {}

function Collection.new(ctx)
	local window = UI.window({
		Name = "Collection",
		Title = "Collection Book",
		Subtitle = "Every discovery permanently adds +1% Sparks.",
		Icon = "📖",
		Parent = ctx.Layers.Windows,
	})
	local screen: { [string]: any } = { Window = window }
	local body = window.Body

	local header = UI.frame({ Size = UDim2.new(1, 0, 0, 44), Parent = body })
	local headline = UI.label({ Text = "", Font = F.Heading, TextSize = 17, Size = UDim2.new(0.5, 0, 0, 22), Parent = header })
	local bonus = UI.label({ Text = "", TextSize = 13, TextColor3 = C.Sparks, Size = UDim2.new(0.5, 0, 0, 18), Position = UDim2.fromOffset(0, 24), Parent = header })
	local progress = UI.progress({ Size = UDim2.new(0.5, -10, 0, 14), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Color = C.Accent2, Parent = header })

	local milestoneRow = UI.new("ScrollingFrame", {
		Name = "Milestones",
		Size = UDim2.new(1, 0, 0, 86),
		Position = UDim2.fromOffset(0, 50),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Stroke,
		List = { Dir = "X", Pad = 8, VA = "Center" },
		Parent = body,
	})
	local milestoneCards = {}
	for index, m in ipairs(Rewards.Collection) do
		local card = UI.panel({ Name = m.Id, Size = UDim2.fromOffset(170, 78), BackgroundColor3 = C.PanelLight, LayoutOrder = index, Padding = 8, Parent = milestoneRow })
		local need = if m.Count < 0 then Items.Count else m.Count
		UI.label({ Text = `📖 {need} items`, Font = F.Heading, TextSize = 14, Size = UDim2.new(1, 0, 0, 18), Parent = card })
		UI.label({ Text = m.Text, TextSize = 12, TextColor3 = C.TextDim, TextWrapped = true, Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 18), Parent = card })
		local claim = UI.button({
			Text = "Claim",
			Variant = "success",
			Size = UDim2.new(1, 0, 0, 22),
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			TextSize = 13,
			OnClick = function()
				local result = ClientNet.once("collection:" .. m.Id, "ClaimCollection", { Id = m.Id })
				if result then
					ctx.Notifications.result(result, "Milestone claimed!")
				end
			end,
			Parent = card,
		})
		milestoneCards[m.Id] = { Card = card, Claim = claim, Need = need }
	end

	local book = UI.scroll({
		Name = "Book",
		Size = UDim2.new(1, 0, 1, -146),
		Position = UDim2.fromOffset(0, 146),
		List = { Dir = "Y", Pad = 10 },
		Padding = { 2, 8, 2, 8 },
		Parent = body,
	})
	local sections = {}
	for index, chestId in ipairs(Chests.Order) do
		local chest = Chests.ById[chestId]
		local title = UI.label({
			Name = chestId .. "Title",
			Text = chest.Name,
			Font = F.Heading,
			TextSize = 16,
			TextColor3 = chest.Color,
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = index * 2 - 1,
			Parent = book,
		})
		local grid = UI.frame({
			Name = chestId .. "Grid",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = index * 2,
			Grid = { Cell = UDim2.fromOffset(84, 100), Pad = UDim2.fromOffset(8, 8) },
			Parent = book,
		})
		local cards = {}
		local pool = Items.PoolByChest[chestId] or {}
		local order = 0
		for _, rarityId in ipairs(Rarities.Order) do
			for _, itemId in ipairs(pool[rarityId] or {}) do
				order += 1
				local card = ItemCard.new({ Parent = grid, LayoutOrder = order, Size = UDim2.fromOffset(84, 100) })
				local item = Items.ById[itemId]
				UI.attachTooltip(card.Instance, function()
					local found = State.get("Discovered") or {}
					local discovered = found[itemId]
					if discovered then
						-- Which Golden / Rainbow versions have been found too.
						local variants = {}
						for _, variant in ipairs(Items.Variants) do
							local mark = if found[Items.variantId(itemId, variant.Id)] then "✓" else "✗"
							table.insert(variants, `{variant.Name} {mark}`)
						end
						return `<b>{item.Icon} {item.Name}</b> ({item.Rarity})\n{Formulas.describeItemBonus(item, 1)}\n{item.Description}\nDiscovered {os.date("%Y-%m-%d", discovered)}\n{table.concat(variants, " · ")}`
					end
					if item.Rarity == "Secret" then
						return `A secret hides in the {chest.Name}…`
					end
					return `Undiscovered {item.Rarity} item from the {chest.Name}.`
				end)
				card.Instance.Activated:Connect(function()
					if (State.get("Inventory") or {})[itemId] then
						local screens = ctx.Screens
						screens.open("Inventory", itemId)
					end
				end)
				table.insert(cards, { Card = card, Id = itemId })
			end
		end
		sections[chestId] = { Title = title, Cards = cards, Chest = chest }
	end

	function screen.Refresh()
		if not window.IsOpen() then
			return
		end
		local discovered = State.get("Discovered") or {}
		local claimed = State.get("CollectionClaimed") or {}
		local count = Formulas.discoveredCount(State.view())
		headline.Text = `Discovered {count} / {Items.Count}`
		bonus.Text = `Collection bonus: +{Format.pct(count * GameConfig.Collection.SparksBonusPerItem)} Sparks`
		progress.Set(count / Items.Count, Format.pct(count / Items.Count))
		for _, section in pairs(sections) do
			local found = 0
			for _, entry in ipairs(section.Cards) do
				local isFound = discovered[entry.Id] ~= nil
				if isFound then
					found += 1
				end
				entry.Card:Set({ Id = entry.Id, Undiscovered = not isFound })
			end
			section.Title.Text = `{section.Chest.Icon} {section.Chest.Name} — {found}/{#section.Cards}`
		end
		for id, entry in pairs(milestoneCards) do
			local done = claimed[id] == true
			local ready = count >= entry.Need
			UI.setText(entry.Claim, if done then "Claimed ✓" elseif ready then "Claim" else `{count}/{entry.Need}`)
			UI.setEnabled(entry.Claim, ready and not done)
			entry.Card.BackgroundColor3 = if ready and not done then Theme.darken(C.Success, 0.7) else C.PanelLight
		end
	end

	State.subscribe({ "Discovered", "CollectionClaimed", "Inventory" }, function()
		screen.Refresh()
	end)
	window.Opened.Event:Connect(screen.Refresh)
	return screen
end

return Collection
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">Inventory</string>
              <string name="Source"><![CDATA[--[[
	Inventory (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Screens/Inventory
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format,Formulas,Config/*},
	            Client/{State,ClientNet,ItemCard}

	Owned items as a searchable, filterable, sortable grid. Items stack by
	type, and each card is created once and then reused (only visibility and
	order change when filtering), so the grid stays fast for any collection.
	The detail panel equips, favourites, sells and fuses (3 copies → Golden,
	3 Golden → Rainbow; the server checks and applies it). Selling Epic or
	better asks for confirmation (setting: Confirm rare sales).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Effects = require(UIFolder.Effects)
local SoundPlayer = require(UIFolder.SoundPlayer)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Config = Shared.Config
local Items = require(Config.Items)
local Rarities = require(Config.Rarities)
local Chests = require(Config.Chests)
local GameConfig = require(Config.GameConfig)
local Sounds = require(Config.Sounds)

local Client = script.Parent.Parent
local State = require(Client.State)
local ClientNet = require(Client.ClientNet)
local ItemCard = require(Client.ItemCard)

local C = Theme.Colors
local F = Theme.Fonts

local Inventory = {}

local SORTS = {
	{ Id = "rarity", Text = "Rarity" },
	{ Id = "power", Text = "Power" },
	{ Id = "new", Text = "Newest" },
	{ Id = "count", Text = "Count" },
}

function Inventory.new(ctx)
	local window = UI.window({
		Name = "Inventory",
		Title = "Inventory",
		Subtitle = "Equip items for bonuses. Extra copies make an equipped item up to twice as strong.",
		Icon = "🎒",
		Parent = ctx.Layers.Windows,
	})
	local screen: { [string]: any } = { Window = window }
	local body = window.Body

	local search = ""
	local rarityFilter = 0
	local sortMode = "rarity"
	local selectedId: string? = nil
	local sellMaxRarity = 3

	-- Toolbar -------------------------------------------------------------------------------
	local toolbar = UI.frame({ Name = "Toolbar", Size = UDim2.new(1, 0, 0, 38), Parent = body })
	UI.textbox({
		Placeholder = "🔍 Search…",
		Size = UDim2.fromOffset(150, 36),
		MaxLength = 30,
		OnChanged = function(text)
			search = string.lower(text)
			screen.Render()
		end,
		Parent = toolbar,
	})
	local rarityOptions = { { Id = 0, Text = "All" } }
	for i, id in ipairs(Rarities.Order) do
		table.insert(rarityOptions, { Id = i, Text = string.sub(id, 1, 1) })
	end
	local rarityControl = UI.segmented({
		Options = rarityOptions,
		Value = 0,
		ButtonWidth = 34,
		Position = UDim2.fromOffset(158, 2),
		OnChange = function(id)
			rarityFilter = id
			screen.Render()
		end,
		Parent = toolbar,
	})
	for i, id in ipairs(Rarities.Order) do
		local button = rarityControl.Buttons[i]
		button.TextColor3 = Theme.rarityColor(id)
		UI.attachTooltip(button, id)
	end
	UI.segmented({
		Options = SORTS,
		Value = "rarity",
		ButtonWidth = 56,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 2),
		OnChange = function(id)
			sortMode = id
			screen.Render()
		end,
		Parent = toolbar,
	})

	-- Grid ------------------------------------------------------------------------------------
	local grid = UI.scroll({
		Name = "Grid",
		Size = UDim2.new(1, -326, 1, -150),
		Position = UDim2.fromOffset(0, 48),
		Grid = { Cell = UDim2.fromOffset(92, 108), Pad = UDim2.fromOffset(8, 8) },
		Padding = { 4, 8, 6, 6 },
		Parent = body,
	})
	local empty = UI.label({
		Text = "No items yet — open crates to find some!",
		TextColor3 = C.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -326, 0, 30),
		Position = UDim2.fromOffset(0, 160),
		Visible = false,
		Parent = body,
	})
	local cards: { [string]: any } = {}

	-- Detail panel -----------------------------------------------------------------------------
	local detail = UI.panel({
		Name = "Detail",
		Size = UDim2.new(0, 310, 1, -150),
		Position = UDim2.new(1, -310, 0, 48),
		BackgroundColor3 = C.PanelLight,
		Padding = 14,
		Parent = body,
	})
	-- Item info scrolls above the fixed action buttons, so short windows never overlap them.
	local info = UI.scroll({
		Name = "Info",
		Size = UDim2.new(1, 0, 1, -182),
		List = { Dir = "Y", Pad = 2, HA = "Center" },
		Parent = detail,
	})
	local function infoLabel(order: number, props: { [string]: any }): TextLabel
		props.LayoutOrder = order
		props.TextXAlignment = Enum.TextXAlignment.Center
		props.Parent = info
		return UI.label(props)
	end
	local dIcon = infoLabel(1, { Text = "", TextSize = 56, Size = UDim2.new(1, 0, 0, 70) })
	local dName = infoLabel(2, { Text = "Select an item", Font = F.Heading, TextSize = 20, Size = UDim2.new(1, 0, 0, 24) })
	local dSub = infoLabel(3, { Text = "", TextSize = 13, TextColor3 = C.TextDim, Size = UDim2.new(1, 0, 0, 18) })
	local dEffect = infoLabel(4, { Text = "", Font = F.Bold, TextSize = 15, TextColor3 = C.Accent2, Size = UDim2.new(1, 0, 0, 22) })
	local dCopies = infoLabel(5, { Text = "", TextSize = 13, TextColor3 = C.TextDim, TextWrapped = true, Size = UDim2.new(1, -6, 0, 16), AutomaticSize = Enum.AutomaticSize.Y })
	local dDesc = infoLabel(6, { Text = "", TextSize = 13, TextColor3 = C.TextDim, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, -6, 0, 16), AutomaticSize = Enum.AutomaticSize.Y })
	local dValue = infoLabel(7, { Text = "", TextSize = 13, TextColor3 = C.Gems, Size = UDim2.new(1, 0, 0, 18) })
	local dFuse = infoLabel(8, { Text = "", TextSize = 12, TextColor3 = C.Gold, TextWrapped = true, Size = UDim2.new(1, -6, 0, 16), AutomaticSize = Enum.AutomaticSize.Y })
	local actions = UI.frame({ Size = UDim2.new(1, 0, 0, 176), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = detail })

	local equipButton, favButton, sellOne, sellExtra, sellAll, fuseButton, fuseAllButton

	local function confirmSell(item, count: number): boolean
		local settings = State.get("Settings") or {}
		local equipped = table.find(State.get("Equipped") or {}, item.Id) ~= nil
		local owned = (State.get("Inventory") or {})[item.Id] or 0
		local needs = (settings.ConfirmRareSales ~= false and item.RarityIndex >= 4) or (equipped and count >= owned)
		if not needs then
			return true
		end
		local stats = State.stats()
		local gems = Formulas.sellValue(item, count, if stats then stats.gemMultiplier else 1)
		return UI.confirm({
			Title = `Sell {count}× {item.Name}?`,
			Message = `This {item.Rarity} item sells for 💎 {Format.short(gems)}.` .. (if equipped and count >= owned then " It will be unequipped." else ""),
			ConfirmText = "Sell",
			Danger = true,
		})
	end

	local function sell(count: number)
		local item = selectedId and Items.ById[selectedId]
		if not item then
			return
		end
		if not confirmSell(item, count) then
			return
		end
		local result = ClientNet.once("sell", "Sell", { Id = item.Id, Amount = count })
		if result then
			if result.ok then
				ctx.Notifications.result(result, `Sold {result.Sold}× {item.Name} for 💎 {Format.short(result.Gems)}`)
			else
				ctx.Notifications.error(result.err)
			end
		end
	end

	equipButton = UI.button({
		Text = "Equip",
		Variant = "primary",
		Size = UDim2.new(0.62, -4, 0, 40),
		OnClick = function()
			if not selectedId then
				return
			end
			local isEquipped = table.find(State.get("Equipped") or {}, selectedId) ~= nil
			local result = ClientNet.once("equip", if isEquipped then "Unequip" else "Equip", { Id = selectedId })
			if result and not result.ok then
				ctx.Notifications.error(result.err)
			end
		end,
		Parent = actions,
	})
	favButton = UI.button({
		Text = "☆",
		Variant = "ghost",
		Size = UDim2.new(0.38, -4, 0, 40),
		Position = UDim2.new(0.62, 4, 0, 0),
		Tooltip = "Favourite items can't be sold.",
		OnClick = function()
			if not selectedId then
				return
			end
			local isFav = (State.get("Favorites") or {})[selectedId] == true
			local result = ClientNet.once("fav", "Favorite", { Id = selectedId, State = not isFav })
			if result and not result.ok then
				ctx.Notifications.error(result.err)
			end
		end,
		Parent = actions,
	})
	sellOne = UI.button({
		Text = "Sell 1",
		Variant = "danger",
		Size = UDim2.new(1 / 3, -6, 0, 36),
		Position = UDim2.fromOffset(0, 48),
		TextSize = 14,
		OnClick = function()
			sell(1)
		end,
		Parent = actions,
	})
	sellExtra = UI.button({
		Text = "Sell extras",
		Variant = "danger",
		Size = UDim2.new(1 / 3, -6, 0, 36),
		Position = UDim2.new(1 / 3, 3, 0, 48),
		TextSize = 14,
		Tooltip = "Sell every copy except one.",
		OnClick = function()
			local owned = selectedId and (State.get("Inventory") or {})[selectedId] or 0
			if owned > 1 then
				sell(owned - 1)
			end
		end,
		Parent = actions,
	})
	sellAll = UI.button({
		Text = "Sell all",
		Variant = "danger",
		Size = UDim2.new(1 / 3, -6, 0, 36),
		Position = UDim2.new(2 / 3, 6, 0, 48),
		TextSize = 14,
		OnClick = function()
			local owned = selectedId and (State.get("Inventory") or {})[selectedId] or 0
			if owned > 0 then
				sell(owned)
			end
		end,
		Parent = actions,
	})
	-- Fusing ------------------------------------------------------------------------------------
	local function fuse(amount: any)
		local item = selectedId and Items.ById[selectedId]
		if not item then
			return
		end
		local result = ClientNet.once("fuse", "Fuse", { Id = item.Id, Amount = amount })
		if not result then
			return
		end
		if not result.ok then
			ctx.Notifications.error(result.err)
			return
		end
		local made = Items.ById[result.Result]
		ctx.Notifications.result(result, `Fused {result.Used}× {item.Name} into {result.Fused}× {made.Name}!`)
		-- Celebrate: sparkle burst on the detail panel, rising chimes, a fanfare for Rainbow.
		local color = if made.Variant == "rainbow" then Color3.fromRGB(255, 120, 220) else C.Gold
		local center = Vector2.new(detail.AbsoluteSize.X / 2, 60)
		Effects.burst(detail, center, color, 24, 170, 30)
		Effects.ring(detail, center, color, 220, 29)
		if made.Variant == "rainbow" then
			local fanfare = Sounds.CrateFanfares.Legendary
			SoundPlayer.sequence("CrateFanfare", fanfare.Notes, fanfare.Gap)
		else
			SoundPlayer.sequence("CrateChime", { 1, 1.26, 1.5, 2 }, 0.07)
		end
		SoundPlayer.play("CrateSparkle")
		if not Theme.ReducedMotion then
			dIcon.TextSize = 80
			UI.tween(dIcon, { TextSize = 56 }, Theme.Motion.Pop, true)
		end
		selectedId = made.Id
		screen.Render()
	end
	fuseButton = UI.button({
		Name = "Fuse",
		Text = "✨ Fuse",
		Variant = "gold",
		Size = UDim2.new(0.62, -4, 0, 36),
		Position = UDim2.fromOffset(0, 92),
		TextSize = 14,
		Tooltip = `{Items.FuseCost} copies → 1 Golden (×2.5 power). {Items.FuseCost} Golden → 1 Rainbow (×6 power).`,
		OnClick = function()
			fuse(1)
		end,
		Parent = actions,
	})
	fuseAllButton = UI.button({
		Name = "FuseAll",
		Text = "Fuse all",
		Variant = "secondary",
		Size = UDim2.new(0.38, -4, 0, 36),
		Position = UDim2.new(0.62, 4, 0, 92),
		TextSize = 14,
		OnClick = function()
			fuse("max")
		end,
		Parent = actions,
	})
	local dDate = UI.label({ Text = "", TextSize = 12, TextColor3 = C.TextMuted, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 140), Parent = actions })

	-- Equipped bar -------------------------------------------------------------------------------
	local bar = UI.panel({
		Name = "EquipBar",
		Size = UDim2.new(1, 0, 0, 92),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.PanelLight,
		Padding = 10,
		Parent = body,
	})
	local slotsLabel = UI.label({ Text = "Equipped", Font = F.Heading, TextSize = 15, Size = UDim2.fromOffset(140, 20), Parent = bar })
	local slotsBonus = UI.label({ Text = "", TextSize = 12, TextColor3 = C.TextDim, TextWrapped = true, Size = UDim2.fromOffset(140, 46), Position = UDim2.fromOffset(0, 22), Parent = bar })
	local slotRow = UI.frame({ Size = UDim2.new(1, -460, 1, 0), Position = UDim2.fromOffset(146, 0), List = { Dir = "X", Pad = 6, VA = "Center" }, Parent = bar })
	local slotButtons = {}
	for i = 1, GameConfig.Equip.MaxSlots do
		local slot = UI.new("TextButton", {
			Name = "Slot" .. i,
			Size = UDim2.fromOffset(62, 62),
			BackgroundColor3 = C.BackgroundAlt,
			AutoButtonColor = false,
			Text = "",
			TextSize = 30,
			TextColor3 = C.White,
			LayoutOrder = i,
			Corner = Theme.Radius.Medium,
			Parent = slotRow,
		})
		local stroke = UI.stroke(slot, { Color = C.StrokeSoft, Thickness = 1.5 })
		-- Slots share the row width (sized in renderEquipBar) and stay square, at most 62 px.
		local aspect = Instance.new("UIAspectRatioConstraint")
		aspect.AspectRatio = 1
		aspect.Parent = slot
		slot.Activated:Connect(function()
			local id = (State.get("Equipped") or {})[i]
			if id then
				selectedId = id
				screen.Render()
			end
		end)
		slotButtons[i] = { Button = slot, Stroke = stroke }
	end
	UI.button({
		Text = "Equip best",
		Icon = "⭐",
		Variant = "primary",
		Size = UDim2.fromOffset(140, 34),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -160, 0, 2),
		TextSize = 14,
		OnClick = function()
			local result = ClientNet.once("equipbest", "EquipBest")
			if result then
				ctx.Notifications.result(result, "Equipped your strongest items.")
			end
		end,
		Parent = bar,
	})
	local sellRarity = UI.button({
		Text = "",
		Variant = "ghost",
		Size = UDim2.fromOffset(150, 34),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, -2),
		TextSize = 13,
		Tooltip = "Choose the highest rarity included when selling duplicates.",
		Parent = bar,
	})
	local function renderSellRarity()
		local id = Rarities.Order[sellMaxRarity]
		sellRarity.Text = `up to {id} ▾`
		sellRarity.TextColor3 = Theme.rarityColor(id)
	end
	sellRarity.Activated:Connect(function()
		sellMaxRarity = (sellMaxRarity % 6) + 1
		renderSellRarity()
	end)
	renderSellRarity()
	UI.button({
		Text = "Sell duplicates",
		Icon = "💎",
		Variant = "danger",
		Size = UDim2.fromOffset(150, 34),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 2),
		TextSize = 14,
		OnClick = function()
			local rarityName = Rarities.Order[sellMaxRarity]
			local ok = UI.confirm({
				Title = "Sell duplicates?",
				Message = `Sells every extra copy of Common to {rarityName} items, keeping one of each. Favourites are never sold.`,
				ConfirmText = "Sell duplicates",
				Danger = sellMaxRarity >= 4,
			})
			if not ok then
				return
			end
			local result = ClientNet.once("selldupes", "SellDuplicates", { MaxRarity = sellMaxRarity })
			if result then
				if result.ok then
					ctx.Notifications.result(result, `Sold {result.Sold} duplicates for 💎 {Format.short(result.Gems)}`)
				else
					ctx.Notifications.error(result.err)
				end
			end
		end,
		Parent = bar,
	})

	-- Rendering -----------------------------------------------------------------------------------

	local function renderDetail()
		local inventory = State.get("Inventory") or {}
		local item = selectedId and Items.ById[selectedId]
		local count = if item then inventory[item.Id] or 0 else 0
		if not item or count <= 0 then
			selectedId = nil
			dIcon.Text = "🎒"
			dName.Text = "Select an item"
			dName.TextColor3 = C.Text
			dSub.Text, dEffect.Text, dCopies.Text, dDesc.Text, dValue.Text, dDate.Text = "", "", "", "", "", ""
			dFuse.Text = ""
			for _, b in ipairs({ equipButton, favButton, sellOne, sellExtra, sellAll, fuseButton, fuseAllButton }) do
				UI.setEnabled(b, false)
			end
			return
		end
		local equipped = table.find(State.get("Equipped") or {}, item.Id) ~= nil
		local favorite = (State.get("Favorites") or {})[item.Id] == true
		local stats = State.stats()
		dIcon.Text = item.Icon
		dName.Text = item.Name
		dName.TextColor3 = Theme.rarityColor(item.Rarity)
		dSub.Text = `{item.Rarity} · {Chests.ById[item.Chest].Name} · owned ×{count}`
		dEffect.Text = Formulas.describeItemBonus(item, count) .. (if equipped then " (active)" else "")
		local bonus = Formulas.copyBonus(count)
		dCopies.Text = `Copies bonus: +{Format.pct(bonus)} power` .. (if bonus < GameConfig.Equip.MaxCopyBonus then " · more copies increase it" else " · maxed")
		dDesc.Text = item.Description
		dValue.Text = `Sell value: 💎 {Format.short(Formulas.sellValue(item, 1, if stats then stats.gemMultiplier else 1))} each`
		local found = (State.get("Discovered") or {})[item.Id]
		dDate.Text = if found then "Discovered " .. os.date("%Y-%m-%d", found) else ""
		UI.setText(equipButton, if equipped then "Unequip" else "Equip")
		UI.setVariant(equipButton, if equipped then "secondary" else "primary")
		UI.setEnabled(equipButton, true)
		UI.setText(favButton, if favorite then "★ Favourite" else "☆ Favourite")
		UI.setEnabled(favButton, true)
		UI.setEnabled(sellOne, not favorite)
		UI.setEnabled(sellExtra, not favorite and count > 1)
		UI.setEnabled(sellAll, not favorite)

		local resultId = Items.fuseResult(item.Id)
		local fused = resultId and Items.ById[resultId]
		local possible = math.floor(count / Items.FuseCost)
		if fused then
			local variant = Items.VariantById[fused.Variant]
			dFuse.Text = `Fuse {Items.FuseCost} → {fused.Name}: {Formulas.describeItemBonus(fused, 1)}`
				.. (if favorite then " (unfavourite it first)" elseif possible < 1 then ` · you have {count}/{Items.FuseCost}` else "")
			UI.setText(fuseButton, `✨ Fuse {Items.FuseCost} → {variant.Name}`)
			UI.setText(fuseAllButton, if possible > 1 then `Fuse all ×{possible}` else "Fuse all")
			UI.setEnabled(fuseButton, possible >= 1 and not favorite)
			UI.setEnabled(fuseAllButton, possible >= 1 and not favorite)
		else
			dFuse.Text = "Rainbow is the best variant."
			UI.setText(fuseButton, "✨ Max variant")
			UI.setText(fuseAllButton, "Fuse all")
			UI.setEnabled(fuseButton, false)
			UI.setEnabled(fuseAllButton, false)
		end
	end

	local function renderEquipBar()
		local equippedList = State.get("Equipped") or {}
		local stats = State.stats()
		local slots = if stats then stats.equipSlots else GameConfig.Equip.BaseSlots
		slotsLabel.Text = `Equipped {#equippedList}/{slots}`
		local inventory = State.get("Inventory") or {}
		local totals = {}
		for _, id in ipairs(equippedList) do
			local item = Items.ById[id]
			if item then
				local label = GameConfig.ItemStats[item.Stat].Label
				totals[label] = (totals[label] or 0) + Formulas.itemPower(item, inventory[id] or 1)
			end
		end
		local parts = {}
		for label, value in pairs(totals) do
			table.insert(parts, `+{Format.pct(value)} {label}`)
		end
		table.sort(parts)
		slotsBonus.Text = table.concat(parts, ", ")
		for i, slot in ipairs(slotButtons) do
			local id = equippedList[i]
			local item = id and Items.ById[id]
			slot.Button.Visible = i <= slots
			slot.Button.Size = UDim2.new(1 / slots, -6, 0, 62)
			slot.Button.Text = if item then item.Icon else "+"
			slot.Button.TextColor3 = if item then C.White else C.TextMuted
			slot.Stroke.Color = if item then Theme.rarityColor(item.Rarity) else C.StrokeSoft
		end
	end

	function screen.Render()
		if not window.IsOpen() then
			return
		end
		local inventory = State.get("Inventory") or {}
		local discovered = State.get("Discovered") or {}
		local equippedList = State.get("Equipped") or {}
		local favorites = State.get("Favorites") or {}
		local list = {}
		for id, count in pairs(inventory) do
			local item = Items.ById[id]
			if item and count > 0 then
				local matches = (rarityFilter == 0 or item.RarityIndex == rarityFilter)
					and (search == "" or string.find(string.lower(item.Name), search, 1, true) ~= nil or string.find(item.Id, search, 1, true) ~= nil)
				if matches then
					table.insert(list, { Item = item, Count = count, Power = Formulas.itemPower(item, count), Found = discovered[id] or 0 })
				end
			end
		end
		table.sort(list, function(a, b)
			if sortMode == "power" and a.Power ~= b.Power then
				return a.Power > b.Power
			elseif sortMode == "new" and a.Found ~= b.Found then
				return a.Found > b.Found
			elseif sortMode == "count" and a.Count ~= b.Count then
				return a.Count > b.Count
			end
			if a.Item.RarityIndex ~= b.Item.RarityIndex then
				return a.Item.RarityIndex > b.Item.RarityIndex
			end
			return a.Item.Order < b.Item.Order
		end)
		local visible = {}
		for index, entry in ipairs(list) do
			local id = entry.Item.Id
			local card = cards[id]
			if not card then
				card = ItemCard.new({
					Parent = grid,
					OnClick = function(c)
						selectedId = c.State.Id
						screen.Render()
					end,
				})
				cards[id] = card
			end
			visible[id] = true
			card.Instance.Visible = true
			card.Instance.LayoutOrder = index
			card:Set({
				Id = id,
				Count = entry.Count,
				Equipped = table.find(equippedList, id) ~= nil,
				Favorite = favorites[id] == true,
				Selected = id == selectedId,
			})
		end
		for id, card in pairs(cards) do
			if not visible[id] then
				card.Instance.Visible = false
			end
		end
		empty.Visible = #list == 0
		empty.Text = if next(inventory) == nil then "No items yet — open crates to find some!" else "No items match your filters."
		renderDetail()
		renderEquipBar()
	end

	local pending = false
	State.subscribe({ "Inventory", "Equipped", "Favorites", "Derived", "Discovered" }, function()
		if pending or not window.IsOpen() then
			return
		end
		pending = true
		task.delay(0.1, function()
			pending = false
			screen.Render()
		end)
	end)
	window.Opened.Event:Connect(screen.Render)

	function screen.OnOpen(itemId: string?)
		if itemId then
			selectedId = itemId
		end
	end
	return screen
end

return Inventory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">Quests</string>
              <string name="Source"><![CDATA[--[[
	Quests (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Screens/Quests
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format,Formulas,Util,Config/*},
	            Client/{State,ClientNet}

	Four tabs:
	  Daily       three quests per UTC day + a bonus for finishing all of them
	  Starter     the guided starter path
	  Login       the 7-day login calendar (streak resets if a day is missed)
	  Achievements every achievement with progress toward it
	All claims are validated by the server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Util = require(Shared.Util)
local Config = Shared.Config
local Quests = require(Config.Quests)
local Rewards = require(Config.Rewards)
local Achievements = require(Config.Achievements)

local Client = script.Parent.Parent
local State = require(Client.State)
local ClientNet = require(Client.ClientNet)

local C = Theme.Colors
local F = Theme.Fonts

local QuestsScreen = {}

local function achievementValue(stat: string): number
	local view = State.view()
	if stat == "Rebirths" then
		return view.Rebirths
	elseif stat == "Level" then
		return view.Level
	elseif stat == "ItemsDiscovered" then
		return Formulas.discoveredCount(view)
	elseif stat == "SkillRanks" then
		return Formulas.skillPointsSpent(view)
	end
	return view.Stats[stat] or 0
end

function QuestsScreen.new(ctx)
	local window = UI.window({
		Name = "Quests",
		Title = "Quests & Rewards",
		Subtitle = "Daily quests reset at 00:00 UTC.",
		Icon = "📜",
		Parent = ctx.Layers.Windows,
	})
	local screen: { [string]: any } = { Window = window }
	local body = window.Body
	local describe = ctx.Notifications.describeReward
	local tab = "Daily"

	local pages = {}
	local function page(name: string)
		local frame = UI.scroll({
			Name = name,
			Size = UDim2.new(1, 0, 1, -50),
			Position = UDim2.fromOffset(0, 50),
			List = { Dir = "Y", Pad = 10 },
			Padding = { 2, 8, 2, 8 },
			Visible = false,
			Parent = body,
		})
		pages[name] = frame
		return frame
	end

	UI.segmented({
		Options = {
			{ Id = "Daily", Text = "📜 Daily" },
			{ Id = "Starter", Text = "🎯 Starter" },
			{ Id = "Login", Text = "📅 Login" },
			{ Id = "Achievements", Text = "🏆 Achievements" },
		},
		Value = "Daily",
		ButtonWidth = 150,
		OnChange = function(id)
			tab = id
			screen.Refresh()
		end,
		Parent = body,
	})

	local function claimButton(parent: Instance, onClick: () -> ())
		return UI.button({
			Text = "Claim",
			Variant = "success",
			Size = UDim2.fromOffset(110, 40),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Sound = "Purchase",
			OnClick = onClick,
			Parent = parent,
		})
	end

	-- Daily -------------------------------------------------------------------------------------
	local daily = page("Daily")
	local resetLabel = UI.label({ Text = "", TextSize = 14, TextColor3 = C.TextDim, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 0, Parent = daily })
	local dailyCards = {}
	for i = 1, Quests.DailyCount do
		local card = UI.panel({ Size = UDim2.new(1, 0, 0, 88), BackgroundColor3 = C.PanelLight, LayoutOrder = i, Parent = daily })
		local title = UI.label({ Text = "", Font = F.Heading, TextSize = 17, Size = UDim2.new(1, -150, 0, 22), Position = UDim2.fromOffset(16, 10), Parent = card })
		local reward = UI.label({ Text = "", TextSize = 13, TextColor3 = C.TextDim, Size = UDim2.new(1, -150, 0, 18), Position = UDim2.fromOffset(16, 34), Parent = card })
		local bar = UI.progress({ Size = UDim2.new(1, -160, 0, 14), Position = UDim2.fromOffset(16, 60), Color = C.Success, Parent = card })
		local claim = claimButton(card, function()
			local result = ClientNet.once("quest" .. i, "ClaimQuest", { Index = i })
			if result then
				ctx.Notifications.result(result, "Quest complete!")
			end
		end)
		dailyCards[i] = { Card = card, Title = title, Reward = reward, Bar = bar, Claim = claim }
	end
	local bonusCard = UI.panel({ Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = Theme.darken(C.Gold, 0.82), LayoutOrder = 10, Stroke = { Color = Theme.darken(C.Gold, 0.4) }, Parent = daily })
	UI.label({ Text = "⭐ Daily bonus — claim all three quests", Font = F.Heading, TextSize = 16, Size = UDim2.new(1, -150, 0, 22), Position = UDim2.fromOffset(16, 12), Parent = bonusCard })
	UI.label({ Text = describe(Quests.DailyBonus), TextSize = 13, TextColor3 = C.TextDim, Size = UDim2.new(1, -150, 0, 18), Position = UDim2.fromOffset(16, 38), Parent = bonusCard })
	local bonusClaim = claimButton(bonusCard, function()
		local result = ClientNet.once("questbonus", "ClaimQuestBonus")
		if result then
			ctx.Notifications.result(result, "Daily bonus claimed!")
		end
	end)

	-- Starter -------------------------------------------------------------------------------------
	local starter = page("Starter")
	local starterRows = {}
	for index, step in ipairs(Quests.Starter) do
		local row = UI.panel({ Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = C.PanelLight, LayoutOrder = index, Parent = starter })
		local status = UI.label({ Text = "", TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(52, 64), Parent = row })
		UI.label({ Text = step.Text, Font = F.Bold, TextSize = 15, Size = UDim2.new(1, -200, 0, 20), Position = UDim2.fromOffset(52, 10), Parent = row })
		UI.label({ Text = describe(step.Reward), TextSize = 13, TextColor3 = C.TextDim, Size = UDim2.new(1, -200, 0, 18), Position = UDim2.fromOffset(52, 34), Parent = row })
		local claim = claimButton(row, function()
			local result = ClientNet.once("starter", "ClaimStarter")
			if result then
				ctx.Notifications.result(result, "Step complete!")
			end
		end)
		local progressLabel = UI.label({
			Text = "",
			Font = F.Bold,
			TextSize = 13,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -16, 0.5, 0),
			Size = UDim2.fromOffset(120, 20),
			Parent = row,
		})
		starterRows[index] = { Row = row, Status = status, Claim = claim, Progress = progressLabel }
	end

	-- Login calendar ---------------------------------------------------------------------------------
	local login = page("Login")
	local streakLabel = UI.label({ Text = "", Font = F.Heading, TextSize = 18, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 0, Parent = login })
	local calendar = UI.frame({
		Size = UDim2.new(1, 0, 0, 170),
		LayoutOrder = 1,
		List = { Dir = "X", Pad = 8, HA = "Center" },
		Parent = login,
	})
	local dayCards = {}
	for i, entry in ipairs(Rewards.Daily) do
		local card = UI.panel({ Size = UDim2.new(1 / #Rewards.Daily, -8, 1, 0), BackgroundColor3 = C.PanelLight, LayoutOrder = i, Padding = 8, Parent = calendar })
		UI.label({ Text = `Day {entry.Day}`, Font = F.Heading, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 20), Parent = card })
		UI.label({
			Text = if i == #Rewards.Daily then "🏆" else "🎁",
			TextSize = 34,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 44),
			Position = UDim2.fromOffset(0, 22),
			Parent = card,
		})
		UI.label({
			Text = entry.Text,
			TextSize = 12,
			TextColor3 = C.TextDim,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.new(1, 0, 0, 60),
			Position = UDim2.fromOffset(0, 70),
			Parent = card,
		})
		local stateLabel = UI.label({ Text = "", Font = F.Bold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 16), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = card })
		dayCards[i] = { Card = card, State = stateLabel }
	end
	local loginClaim = UI.button({
		Text = "Claim today's reward",
		Variant = "gold",
		Size = UDim2.fromOffset(260, 46),
		LayoutOrder = 2,
		Sound = "Purchase",
		OnClick = function()
			local result = ClientNet.once("daily", "ClaimDaily")
			if result then
				ctx.Notifications.result(result, `Day {result.Day or "?"} reward claimed!`)
			end
		end,
		Parent = login,
	})
	local loginInfo = UI.label({ Text = "", TextSize = 13, TextColor3 = C.TextDim, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 3, Parent = login })

	-- Achievements -------------------------------------------------------------------------------------
	local achievementsPage = page("Achievements")
	local achSummary = UI.label({ Text = "", Font = F.Heading, TextSize = 16, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 0, Parent = achievementsPage })
	local achRows = {}
	for index, def in ipairs(Achievements.List) do
		local row = UI.panel({ Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = C.PanelLight, LayoutOrder = index, Parent = achievementsPage })
		UI.label({ Text = def.Icon, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(52, 62), Parent = row })
		local name = UI.label({ Text = def.Name, Font = F.Heading, TextSize = 15, Size = UDim2.new(0.45, -52, 0, 20), Position = UDim2.fromOffset(52, 10), Parent = row })
		UI.label({ Text = def.Description, TextSize = 12, TextColor3 = C.TextDim, Size = UDim2.new(0.45, -52, 0, 16), Position = UDim2.fromOffset(52, 33), Parent = row })
		local bar = UI.progress({ Size = UDim2.new(0.3, 0, 0, 12), Position = UDim2.new(0.45, 10, 0.5, -6), Color = C.Gold, Parent = row })
		UI.label({
			Text = describe(def.Reward),
			TextSize = 12,
			TextColor3 = C.TextDim,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.new(0.25, -24, 0, 40),
			Parent = row,
		})
		achRows[def.Id] = { Row = row, Name = name, Bar = bar, Def = def }
	end

	function screen.Refresh()
		if not window.IsOpen() then
			return
		end
		for name, frame in pairs(pages) do
			frame.Visible = name == tab
		end
		local quests = State.get("Quests") or { Daily = {} }
		local now = Util.serverTime()

		if tab == "Daily" then
			resetLabel.Text = `New quests in {Format.time(Util.secondsUntilNextDay(now))}`
			local allClaimed = #quests.Daily > 0
			for i, entry in ipairs(dailyCards) do
				local q = quests.Daily[i]
				entry.Card.Visible = q ~= nil
				if q then
					local def = Quests.DailyById[q.Id]
					entry.Title.Text = string.format(def.Text, Format.short(q.Target))
					entry.Reward.Text = "Reward: " .. describe(def.Reward)
					entry.Bar.Set(q.Progress / q.Target, `{Format.short(q.Progress)} / {Format.short(q.Target)}`)
					local done = q.Progress >= q.Target
					UI.setText(entry.Claim, if q.Claimed then "Claimed ✓" else "Claim")
					UI.setEnabled(entry.Claim, done and not q.Claimed)
					if not q.Claimed then
						allClaimed = false
					end
				end
			end
			UI.setText(bonusClaim, if quests.BonusClaimed then "Claimed ✓" else "Claim")
			UI.setEnabled(bonusClaim, allClaimed and not quests.BonusClaimed)
		elseif tab == "Starter" then
			local current = quests.StarterIndex or 1
			for index, entry in ipairs(starterRows) do
				local step = Quests.Starter[index]
				local done = index < current
				local isCurrent = index == current
				entry.Status.Text = if done then "✅" elseif isCurrent then "▶" else "🔒"
				entry.Row.BackgroundColor3 = if isCurrent then Theme.darken(C.Accent2, 0.8) else C.PanelLight
				local ready = isCurrent and (quests.StarterProgress or 0) >= step.Target
				entry.Claim.Visible = ready
				entry.Progress.Visible = isCurrent and not ready
				entry.Progress.Text = if isCurrent then `{Format.short(quests.StarterProgress or 0)} / {Format.short(step.Target)}` else ""
			end
		elseif tab == "Login" then
			local daily = State.get("Daily") or { LastClaimDay = -1, Streak = 0 }
			local today = Util.dayNumber(now)
			local claimedToday = daily.LastClaimDay == today
			local streakAlive = daily.LastClaimDay >= today - 1
			local streak = if streakAlive then daily.Streak else 0
			local nextDay = if claimedToday then ((streak - 1) % #Rewards.Daily) + 1 else (streak % #Rewards.Daily) + 1
			streakLabel.Text = `🔥 Login streak: {streak} day{if streak == 1 then "" else "s"}`
			for i, entry in ipairs(dayCards) do
				local isNext = i == nextDay
				local past = if claimedToday then i <= nextDay else i < nextDay
				entry.State.Text = if past and not (isNext and not claimedToday) then "✓ Claimed" elseif isNext then "Today" else ""
				entry.State.TextColor3 = if isNext then C.Gold else C.Success
				entry.Card.BackgroundColor3 = if isNext and not claimedToday then Theme.darken(C.Gold, 0.78) else C.PanelLight
			end
			UI.setEnabled(loginClaim, not claimedToday)
			UI.setText(loginClaim, if claimedToday then "Come back tomorrow" else "Claim today's reward")
			loginInfo.Text = if claimedToday
				then `Next reward in {Format.time(Util.secondsUntilNextDay(now))}. Missing a day resets the streak.`
				else "Claim once per UTC day. Missing a day resets the streak."
		elseif tab == "Achievements" then
			local unlocked = State.get("Achievements") or {}
			local count = 0
			for id, entry in pairs(achRows) do
				local def = entry.Def
				local done = unlocked[id] ~= nil
				if done then
					count += 1
				end
				local value = achievementValue(def.Stat)
				entry.Bar.Set(if done then 1 else value / def.Target, if done then "Unlocked ✓" else `{Format.short(value)} / {Format.short(def.Target)}`)
				entry.Name.TextColor3 = if done then C.Gold else C.Text
				entry.Row.LayoutOrder = (if done then 1000 else 0) + def.Order
			end
			achSummary.Text = `{count} / {#Achievements.List} achievements unlocked`
		end
	end

	State.subscribe({ "Quests", "Daily", "Achievements", "Stats", "Progress" }, function()
		screen.Refresh()
	end)
	window.Opened.Event:Connect(screen.Refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			if window.IsOpen() and (tab == "Daily" or tab == "Login") then
				screen.Refresh()
			end
		end
	end)

	function screen.OnOpen(tabId: string?)
		if tabId and pages[tabId] then
			tab = tabId
		end
	end
	return screen
end

return QuestsScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[--[[
	Settings (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Screens/Settings
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/Config/{GameConfig,Rarities},
	            Client/{State,ClientNet}

	Player preferences, saved with the player's data. Changes apply locally
	right away and are sent to the server (debounced); the server validates
	every key and value.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local SoundPlayer = require(UIFolder.SoundPlayer)
local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local GameConfig = require(Config.GameConfig)
local Rarities = require(Config.Rarities)

local Client = script.Parent.Parent
local State = require(Client.State)
local ClientNet = require(Client.ClientNet)

local C = Theme.Colors
local F = Theme.Fonts

local SettingsScreen = {}

function SettingsScreen.new(ctx)
	local window = UI.window({
		Name = "Settings",
		Title = "Settings",
		Subtitle = "Saved with your progress.",
		Icon = "⚙️",
		Size = Vector2.new(760, 600),
		Parent = ctx.Layers.Windows,
	})
	local screen: { [string]: any } = { Window = window }
	local list = UI.scroll({ Size = UDim2.fromScale(1, 1), List = { Dir = "Y", Pad = 8 }, Padding = { 2, 10, 2, 8 }, Parent = window.Body })
	local controls = {}
	local pendingSend: { [string]: any } = {}
	local order = 0

	local function send(key: string, value: any)
		local isNew = pendingSend[key] == nil
		pendingSend[key] = value
		-- Apply locally at once (the server copy arrives with the next sync).
		local settings = State.get("Settings")
		if settings then
			settings[key] = value
		end
		ctx.ApplySettings()
		if isNew then
			task.delay(0.4, function()
				local v = pendingSend[key]
				pendingSend[key] = nil
				local result = ClientNet.action("UpdateSettings", { Key = key, Value = v })
				if not result.ok then
					ctx.Notifications.error(result.err)
				end
			end)
		end
	end

	-- reserve: width kept free on the right for the row's control (default fits a slider).
	local function row(label: string, hint: string?, reserve: number?): Frame
		order += 1
		local free = -((reserve or 330) + 28)
		local frame = UI.panel({ Size = UDim2.new(1, 0, 0, if hint then 62 else 50), BackgroundColor3 = C.PanelLight, LayoutOrder = order, Parent = list })
		UI.label({ Text = label, Font = F.Bold, TextSize = 16, Size = UDim2.new(1, free, 0, 22), Position = UDim2.fromOffset(16, if hint then 9 else 14), Parent = frame })
		if hint then
			UI.label({ Text = hint, TextSize = 12, TextColor3 = C.TextMuted, TextWrapped = true, Size = UDim2.new(1, free, 0, 26), Position = UDim2.fromOffset(16, 31), Parent = frame })
		end
		return frame
	end

	-- commitOnly: apply when the drag ends instead of live (for settings that move the slider itself).
	local function sliderRow(key: string, label: string, hint: string?, format: (number) -> string, step: number, commitOnly: boolean?)
		local def = GameConfig.Settings[key]
		local frame = row(label, hint)
		local function apply(v: number)
			send(key, v)
		end
		controls[key] = UI.slider({
			Min = def.Min,
			Max = def.Max,
			Step = step,
			Value = def.Default,
			Width = 300,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Format = format,
			OnChange = if commitOnly then nil else apply,
			OnCommit = if commitOnly then apply else nil,
			Parent = frame,
		})
	end

	local function toggleRow(key: string, label: string, hint: string?)
		local frame = row(label, hint)
		controls[key] = UI.toggle({
			Value = GameConfig.Settings[key].Default,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -16, 0.5, 0),
			OnChange = function(v)
				send(key, v)
			end,
			Parent = frame,
		})
	end

	local function percent(v: number): string
		return tostring(math.floor(v * 100 + 0.5)) .. "%"
	end

	sliderRow(
		"Music",
		"Music volume",
		if SoundPlayer.hasMusic() then nil else "No music track is configured (see Config/Sounds).",
		percent,
		0.05
	)
	sliderRow("SFX", "Sound effects", nil, percent, 0.05)
	-- Rescaling while dragging would move the slider under the pointer, so it applies on release.
	sliderRow("UIScale", "Interface size", "Scales the whole interface. Applies when you let go.", function(v)
		return string.format("%.2f×", v)
	end, 0.05, true)
	toggleRow("ReducedMotion", "Reduced motion", "Turns off shaking, particles and most animations.")
	toggleRow("ScreenShake", "Screen shake on crits")
	toggleRow("FloatingNumbers", "Floating reward numbers")
	toggleRow("ConfirmRareSales", "Confirm selling Epic or better")

	local autoOptions = { { Id = 0, Text = "Off" } }
	for i = 1, GameConfig.Inventory.AutoSellMaxIndex do
		table.insert(autoOptions, { Id = i, Text = Rarities.Order[i] })
	end
	local autoWidth = #autoOptions * 84 + (#autoOptions - 1) * 4 + 8
	local autoFrame = row("Auto-sell duplicates", "Duplicates up to this rarity are sold for Gems the moment you open them.", autoWidth)
	controls.AutoSell = UI.segmented({
		Options = autoOptions,
		Value = 0,
		ButtonWidth = 84,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		OnChange = function(id)
			send("AutoSell", id)
		end,
		Parent = autoFrame,
	})

	local tutorialFrame = row("Tutorial", "Shows the first-time guide again, step by step.", 140)
	UI.button({
		Name = "ReplayTutorial",
		Text = "Replay",
		Icon = "🎓",
		Variant = "secondary",
		Size = UDim2.fromOffset(130, 36),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		TextSize = 14,
		OnClick = function()
			local result = ClientNet.action("TutorialRestart", {})
			if result.ok then
				window.Close()
			else
				ctx.Notifications.error(result.err)
			end
		end,
		Parent = tutorialFrame,
	})

	order += 1
	local info = UI.panel({ Size = UDim2.new(1, 0, 0, 120), BackgroundColor3 = C.BackgroundAlt, LayoutOrder = order, Padding = 14, Parent = list })
	local dataLabel = UI.label({ Text = "", Font = F.Bold, TextSize = 14, Size = UDim2.new(1, 0, 0, 20), Parent = info })
	UI.label({
		Text = "Controls — Mouse/touch: tap PRESS (bottom right) and the menu buttons at the bottom; move and jump as usual. Keyboard: E presses. Controller: R2/L2 press, Y jumps to the menu (B leaves it), A selects, B closes windows.",
		TextSize = 13,
		TextColor3 = C.TextDim,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 50),
		Position = UDim2.fromOffset(0, 26),
		Parent = info,
	})
	UI.label({
		Text = `{GameConfig.GameName} v{GameConfig.Version}`,
		TextSize = 12,
		TextColor3 = C.TextMuted,
		Size = UDim2.new(1, 0, 0, 16),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Parent = info,
	})

	function screen.Refresh()
		local settings = State.get("Settings") or {}
		for key, control in pairs(controls) do
			local value = settings[key]
			if value ~= nil and pendingSend[key] == nil then
				control.Set(value)
			end
		end
		local derived = State.get("Derived")
		if derived and derived.Persistent == false then
			dataLabel.Text = "⚠ Saving is disabled in this session — progress will not be kept."
			dataLabel.TextColor3 = C.Warning
		else
			dataLabel.Text = "✓ Progress saves automatically every minute and when you leave."
			dataLabel.TextColor3 = C.Success
		end
	end

	State.subscribe({ "Settings", "Derived" }, function()
		if window.IsOpen() then
			screen.Refresh()
		end
	end)
	window.Opened.Event:Connect(screen.Refresh)
	return screen
end

return SettingsScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--[[
	Shop (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Screens/Shop
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format,Formulas,Config/Upgrades},
	            Client/{State,ClientNet}

	Upgrade shop grouped into tiers. Each card shows the current level, the
	effect now and after buying, and the cost for the selected amount
	(×1, ×10 or MAX). Purchases are sent as intent only; the server computes
	the real price and applies the upgrade.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Effects = require(UIFolder.Effects)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Upgrades = require(Shared.Config.Upgrades)

local Client = script.Parent.Parent
local State = require(Client.State)
local ClientNet = require(Client.ClientNet)

local C = Theme.Colors
local F = Theme.Fonts

local Shop = {}

function Shop.new(ctx)
	local window = UI.window({
		Name = "Shop",
		Title = "Upgrade Shop",
		Subtitle = "Upgrades are paid with Sparks and reset when you ascend.",
		Icon = "🛒",
		Parent = ctx.Layers.Windows,
	})
	local screen: { [string]: any } = { Window = window }
	local body = window.Body
	local amount: any = 1

	local toolbar = UI.frame({ Name = "Toolbar", Size = UDim2.new(1, 0, 0, 40), Parent = body })
	local balance = UI.label({
		Text = "",
		Font = F.Heading,
		TextSize = 18,
		TextColor3 = C.Sparks,
		Size = UDim2.new(0.5, 0, 1, 0),
		Parent = toolbar,
	})
	UI.segmented({
		Options = { { Id = 1, Text = "×1" }, { Id = 10, Text = "×10" }, { Id = "max", Text = "MAX" } },
		Value = 1,
		ButtonWidth = 64,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		OnChange = function(id)
			amount = id
			screen.Refresh()
		end,
		Parent = toolbar,
	})

	local list = UI.scroll({
		Name = "List",
		Size = UDim2.new(1, 0, 1, -50),
		Position = UDim2.fromOffset(0, 50),
		List = { Dir = "Y", Pad = 8 },
		Padding = { 2, 8, 2, 8 },
		Parent = body,
	})

	local headers = {}
	local cards = {}
	local order = 0
	for _, tier in ipairs(Upgrades.Tiers) do
		order += 1
		headers[tier.Tier] = UI.label({
			Name = "Tier" .. tier.Tier,
			Text = tier.Name,
			Font = F.Heading,
			TextSize = 16,
			TextColor3 = C.TextDim,
			Size = UDim2.new(1, 0, 0, 28),
			LayoutOrder = order * 100,
			Parent = list,
		})
		for _, def in ipairs(Upgrades.List) do
			if def.Tier == tier.Tier then
				order += 1
				local card = UI.panel({
					Name = def.Id,
					Size = UDim2.new(1, 0, 0, 88),
					BackgroundColor3 = C.PanelLight,
					LayoutOrder = order * 100,
					Parent = list,
				})
				local cardScale = Instance.new("UIScale")
				cardScale.Parent = card
				UI.label({
					Text = def.Icon,
					TextSize = 32,
					TextXAlignment = Enum.TextXAlignment.Center,
					Size = UDim2.fromOffset(64, 88),
					Parent = card,
				})
				local name = UI.label({
					Text = def.Name,
					Font = F.Heading,
					TextSize = 18,
					Size = UDim2.new(1, -250, 0, 22),
					Position = UDim2.fromOffset(64, 10),
					Parent = card,
				})
				local level = UI.label({
					Text = "",
					Font = F.Bold,
					TextSize = 13,
					TextColor3 = C.TextMuted,
					TextXAlignment = Enum.TextXAlignment.Right,
					Size = UDim2.fromOffset(120, 22),
					Position = UDim2.new(1, -306, 0, 10),
					Parent = card,
				})
				UI.label({
					Text = def.Description,
					TextSize = 13,
					TextColor3 = C.TextDim,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Size = UDim2.new(1, -250, 0, 18),
					Position = UDim2.fromOffset(64, 34),
					Parent = card,
				})
				local effect = UI.label({
					Text = "",
					Font = F.Bold,
					TextSize = 14,
					TextColor3 = C.Accent2,
					RichText = true,
					Size = UDim2.new(1, -250, 0, 20),
					Position = UDim2.fromOffset(64, 56),
					Parent = card,
				})
				local buy = UI.button({
					Text = "",
					Variant = "gold",
					Size = UDim2.fromOffset(160, 52),
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -16, 0.5, 0),
					TextSize = 17,
					Sound = "Purchase",
					OnClick = function(button)
						local result = ClientNet.once("upgrade:" .. def.Id, "BuyUpgrade", { Id = def.Id, Amount = amount })
						if not result then
							return
						end
						if result.ok then
							cardScale.Scale = 1.03
							UI.tween(cardScale, { Scale = 1 }, Theme.Motion.Pop)
							local fx = ctx.Layers.Fx
							local center = button.AbsolutePosition + button.AbsoluteSize / 2 - fx.AbsolutePosition
							Effects.burst(fx, center, C.Gold, 10, 90)
							Effects.floatText(fx, center + Vector2.new(0, -30), `Lv {result.Level}`, C.Gold, { Size = 22, Rise = 50 })
						else
							ctx.Notifications.error(result.err)
						end
					end,
					Parent = card,
				})
				UI.attachTooltip(card, function()
					local data = State.view()
					local lvl = data.Upgrades[def.Id] or 0
					return `<b>{def.Icon} {def.Name}</b>\n{def.Description}\nLevel {lvl}/{def.MaxLevel}\nCost growth ×{def.Growth} per level`
				end)
				cards[def.Id] = { Def = def, Card = card, Level = level, Effect = effect, Buy = buy, Name = name }
			end
		end
	end

	local pending = false
	function screen.Refresh()
		if not window.IsOpen() then
			return
		end
		local data = State.view()
		local sparks = State.currency("Sparks")
		balance.Text = "⚡ " .. Format.short(sparks)
		for tierIndex, header in pairs(headers) do
			local tier = Upgrades.Tiers[tierIndex]
			local unlocked = Formulas.requirementMet(tier.Requirement, data)
			header.Text = if unlocked then tier.Name else `🔒 {tier.Name} — {Formulas.requirementText(tier.Requirement)}`
		end
		for _, entry in pairs(cards) do
			local def = entry.Def
			local lvl = data.Upgrades[def.Id] or 0
			local unlocked = Formulas.upgradeUnlocked(def, data)
			entry.Level.Text = `Lv {lvl} / {def.MaxLevel}`
			entry.Card.BackgroundTransparency = if unlocked then 0 else 0.5
			if lvl >= def.MaxLevel then
				entry.Effect.Text = `Effect: {Format.display(def.Display, def.Value(lvl))}  ·  <font color="#FFCD40">MAXED</font>`
				UI.setText(entry.Buy, "MAX")
				UI.setEnabled(entry.Buy, false)
			else
				local count, cost
				if amount == "max" then
					count, cost = Formulas.maxAffordable(def, lvl, sparks)
					if count == 0 then
						count, cost = 1, Formulas.upgradeLevelCost(def, lvl)
					end
				else
					count = math.min(amount, def.MaxLevel - lvl)
					cost = Formulas.upgradeCost(def, lvl, count)
				end
				local now = Format.display(def.Display, def.Value(lvl))
				local nextValue = Format.display(def.Display, def.Value(lvl + count))
				entry.Effect.Text = `{now}  →  <font color="#4DE1FF"><b>{nextValue}</b></font>`
					.. (if count > 1 then `  <font color="#9A96B8">(+{count} levels)</font>` else "")
				UI.setText(entry.Buy, Format.short(cost), "⚡")
				UI.setEnabled(entry.Buy, unlocked and sparks >= cost)
			end
		end
	end

	local function schedule()
		if pending then
			return
		end
		pending = true
		task.delay(0.1, function()
			pending = false
			screen.Refresh()
		end)
	end
	State.subscribe({ "Currencies", "Upgrades", "Progress" }, schedule)

	window.Opened.Event:Connect(screen.Refresh)
	return screen
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">Skills</string>
              <string name="Source"><![CDATA[--[[
	Skills (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Screens/Skills
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format,Formulas,Config/*},
	            Client/{State,ClientNet}

	Visual skill tree on a pannable, zoomable canvas that builds itself up as
	skills are bought (Config/Skills.visibility):
	  visible  core, owned nodes and nodes whose prerequisites are met
	  teaser   the next ring, shown only as a dim "?" silhouette
	  hidden   everything further out (nodes and connector lines)
	The canvas only spans the revealed part of the tree, so it grows as the
	tree grows. Newly revealed nodes pop in and their connector lines draw
	outward; a respec collapses the tree again (instant with Reduced motion).

	Visible nodes show four states:
	  locked     (dim)            prerequisites not met
	  available  (pulsing ring)   prerequisites met, can be bought
	  unlocked   (filled colour)  at least one rank
	  maxed      (gold ring)      all ranks bought
	Selecting a node shows details and the unlock button. The server checks
	prerequisites and costs again before anything is unlocked.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Effects = require(UIFolder.Effects)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Config = Shared.Config
local Skills = require(Config.Skills)
local GameConfig = require(Config.GameConfig)

local Client = script.Parent.Parent
local State = require(Client.State)
local ClientNet = require(Client.ClientNet)

local C = Theme.Colors
local F = Theme.Fonts

local SkillsScreen = {}

local CELL = 118
local NODE = 74
local MARGIN = 70
-- Space kept around the revealed nodes when sizing the canvas.
local PAD = 80
local MIN_ZOOM, MAX_ZOOM = 0.45, 1.4

local STAT_LABELS = {
	clickPct = "Click Power",
	clickMult = "Click Power",
	sparksPct = "Sparks",
	sparksMult = "Sparks",
	luck = "Luck",
	critChance = "Crit Chance",
	critPower = "Crit Multiplier",
	chestBonus = "Bonus item chance",
	goldenPct = "Golden chance",
	goldenMult = "Golden chance",
	passivePct = "Passive income",
	passiveMult = "Passive income",
	gemsPct = "Gems",
	xpPct = "XP",
	xpMult = "XP",
	prismPct = "Prisms",
	comboCap = "Combo cap",
	comboWindow = "Combo window",
	streakPct = "Streak bursts",
	equipSlots = "Equip slots",
	offlineHours = "Offline hours",
	offlineRate = "Offline rate",
	autoRate = "Auto presses/s",
	chestDiscount = "Crate discount",
	pityReduction = "Pity speed",
	orbRate = "Orb frequency",
	orbPct = "Orb rewards",
}

local function effectText(node, rank: number): string
	local parts = {}
	for _, e in ipairs(node.Effects) do
		local label = STAT_LABELS[e.Stat] or e.Stat
		if e.Mult then
			table.insert(parts, `{label} {Format.mult(e.Mult ^ math.max(rank, 1))}`)
		elseif e.Stat == "comboCap" or e.Stat == "equipSlots" or e.Stat == "offlineHours" or e.Stat == "autoRate" then
			table.insert(parts, `+{(e.Add or 0) * math.max(rank, 1)} {label}`)
		elseif e.Stat == "comboWindow" then
			table.insert(parts, `+{Format.short((e.Add or 0) * math.max(rank, 1), true)}s {label}`)
		elseif e.Stat == "critPower" then
			table.insert(parts, `+{(e.Add or 0) * math.max(rank, 1)}× {label}`)
		else
			table.insert(parts, `+{Format.pct((e.Add or 0) * math.max(rank, 1))} {label}`)
		end
	end
	return table.concat(parts, ", ")
end

function SkillsScreen.new(ctx)
	local window = UI.window({
		Name = "Skills",
		Title = "Skill Tree",
		Subtitle = "Spend Skill Points from levelling up. The tree grows as you unlock it.",
		Icon = "🌳",
		Parent = ctx.Layers.Windows,
	})
	local screen: { [string]: any } = { Window = window }
	local body = window.Body
	local selectedId = "core"

	-- Canvas -----------------------------------------------------------------------------------
	-- Nodes live on `content` (the whole tree, in tree coordinates). The scrolling
	-- canvas only covers the revealed bounds, and `zoomScale` scales the content.
	local minX, maxX, minY, maxY = 0, 0, 0, 0
	for _, node in ipairs(Skills.List) do
		minX, maxX = math.min(minX, node.X), math.max(maxX, node.X)
		minY, maxY = math.min(minY, node.Y), math.max(maxY, node.Y)
	end
	local treeW = (maxX - minX) * CELL + MARGIN * 2
	local treeH = (maxY - minY) * CELL + MARGIN * 2

	local view = UI.new("ScrollingFrame", {
		Name = "Tree",
		Size = UDim2.new(1, -320, 1, 0),
		BackgroundColor3 = C.BackgroundAlt,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromOffset(treeW, treeH),
		ScrollingDirection = Enum.ScrollingDirection.XY,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = C.Stroke,
		Corner = Theme.Radius.Medium,
		Stroke = { Color = C.StrokeSoft },
		Parent = body,
	})
	local content = UI.frame({
		Name = "Content",
		Size = UDim2.fromOffset(treeW, treeH),
		Parent = view,
	})
	local zoomScale = Instance.new("UIScale")
	zoomScale.Scale = if UI.isCompact() then 0.8 else 1
	zoomScale.Parent = content
	-- Converts the window's own UIScale out of absolute (screen) sizes.
	local probe = UI.frame({ Name = "ScaleProbe", Size = UDim2.fromOffset(100, 100), Visible = false, Parent = body })

	local function nodePosition(node): Vector2
		return Vector2.new((node.X - minX) * CELL + MARGIN, (node.Y - minY) * CELL + MARGIN)
	end

	local lines = {}
	local function connect(fromId: string, toId: string, optional: boolean)
		local a = nodePosition(Skills.ById[fromId])
		local b = nodePosition(Skills.ById[toId])
		local delta = b - a
		local line = UI.new("Frame", {
			Name = fromId .. "_" .. toId,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2),
			Size = UDim2.fromOffset(delta.Magnitude, if optional then 3 else 5),
			Rotation = math.deg(math.atan2(delta.Y, delta.X)),
			BackgroundColor3 = C.StrokeSoft,
			BackgroundTransparency = if optional then 0.35 else 0,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 1,
			Parent = content,
		})
		table.insert(lines, { Line = line, From = fromId, To = toId, A = a, B = b, Optional = optional, Shown = nil })
	end
	for _, node in ipairs(Skills.List) do
		for _, req in ipairs(node.Requires) do
			connect(req, node.Id, false)
		end
		for _, req in ipairs(node.RequiresAny) do
			connect(req, node.Id, true)
		end
	end

	local nodes = {}
	for _, node in ipairs(Skills.List) do
		local pos = nodePosition(node)
		local branch = Skills.Branches[node.Branch]
		local button = UI.new("TextButton", {
			Name = node.Id,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(pos.X, pos.Y),
			Size = UDim2.fromOffset(NODE, NODE),
			BackgroundColor3 = C.Panel,
			AutoButtonColor = false,
			Text = node.Icon,
			TextSize = 30,
			TextColor3 = C.White,
			Visible = false,
			ZIndex = 3,
			Selectable = true,
			Corner = Theme.Radius.Pill,
			Parent = content,
		})
		local stroke = UI.stroke(button, { Color = branch.Color, Thickness = 3 })
		local scale = Instance.new("UIScale")
		scale.Parent = button
		local rank = UI.label({
			Name = "Rank",
			Text = "",
			Font = F.Heading,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundColor3 = C.Background,
			BackgroundTransparency = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 1, 0),
			Size = UDim2.fromOffset(40, 18),
			ZIndex = 4,
			Corner = Theme.Radius.Pill,
			Stroke = { Color = branch.Color, Thickness = 1 },
			Parent = button,
		})
		local name = UI.label({
			Name = "NodeName",
			Text = node.Name,
			Font = F.Bold,
			TextSize = 12,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(pos.X, pos.Y + NODE / 2 + 12),
			Size = UDim2.fromOffset(CELL - 6, 16),
			Visible = false,
			ZIndex = 3,
			Parent = content,
		})
		button.Activated:Connect(function()
			selectedId = node.Id
			screen.Refresh()
		end)
		button.SelectionGained:Connect(function()
			selectedId = node.Id
			screen.Refresh()
		end)
		local entry = { Node = node, Button = button, Stroke = stroke, Rank = rank, Name = name, Scale = scale, Branch = branch, Shown = nil }
		UI.attachTooltip(button, function()
			if entry.Shown == "teaser" then
				return "<b>❔ Undiscovered skill</b>\nUnlock a connected skill to reveal it."
			end
			local owned = (State.get("Skills") or {})[node.Id] or 0
			return `<b>{node.Icon} {node.Name}</b>  {owned}/{node.MaxRank}\n{node.Description}`
		end)
		nodes[node.Id] = entry
	end

	-- Zoom and canvas bounds -----------------------------------------------------------------------
	local bounds = { X0 = 0, Y0 = 0, X1 = treeW, Y1 = treeH }
	local contentOffset = Vector2.zero

	local function windowScale(): number
		local s = probe.AbsoluteSize.X / 100
		return if s > 0.01 then s else 1
	end
	local function windowLocalSize(): Vector2
		return view.AbsoluteWindowSize / windowScale()
	end

	-- Sizes the canvas to the revealed bounds at the current zoom, keeping what is on screen
	-- in place (the content moves inside the canvas, so the canvas position follows it).
	local function layoutCanvas()
		local z = zoomScale.Scale
		local win = windowLocalSize()
		local w = (bounds.X1 - bounds.X0) * z
		local h = (bounds.Y1 - bounds.Y0) * z
		local centerX = math.max(0, (win.X - w) / 2)
		local centerY = math.max(0, (win.Y - h) / 2)
		local offset = Vector2.new(centerX - bounds.X0 * z, centerY - bounds.Y0 * z)
		local shift = offset - contentOffset
		contentOffset = offset
		content.Position = UDim2.fromOffset(offset.X, offset.Y)
		view.CanvasSize = UDim2.fromOffset(math.max(w, 1), math.max(h, 1))
		local maxScroll = Vector2.new(math.max(0, w - win.X), math.max(0, h - win.Y))
		local target = view.CanvasPosition + shift
		view.CanvasPosition = Vector2.new(math.clamp(target.X, 0, maxScroll.X), math.clamp(target.Y, 0, maxScroll.Y))
	end

	-- Scrolls so that a point of the tree (tree coordinates) is centred in the view.
	local function centerOn(point: Vector2)
		local z = zoomScale.Scale
		local win = windowLocalSize()
		local canvas = Vector2.new(view.CanvasSize.X.Offset, view.CanvasSize.Y.Offset)
		local target = contentOffset + point * z - win / 2
		local maxScroll = Vector2.new(math.max(0, canvas.X - win.X), math.max(0, canvas.Y - win.Y))
		view.CanvasPosition = Vector2.new(math.clamp(target.X, 0, maxScroll.X), math.clamp(target.Y, 0, maxScroll.Y))
	end

	local function viewCenter(): Vector2
		local win = windowLocalSize()
		return (view.CanvasPosition + win / 2 - contentOffset) / zoomScale.Scale
	end

	local function setZoom(z: number)
		local keep = viewCenter()
		zoomScale.Scale = math.clamp(z, MIN_ZOOM, MAX_ZOOM)
		layoutCanvas()
		centerOn(keep)
	end

	local zoomBar = UI.frame({
		Name = "Zoom",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -330, 0, 8),
		Size = UDim2.fromOffset(3 * 38 + 2 * 6, 38),
		List = { Dir = "X", Pad = 6 },
		ZIndex = 20,
		Parent = body,
	})
	local function zoomButton(text: string, order: number, onClick: () -> ())
		UI.button({
			Text = text,
			Variant = "ghost",
			Size = UDim2.fromOffset(38, 38),
			TextSize = 18,
			LayoutOrder = order,
			ZIndex = 21,
			OnClick = onClick,
			Parent = zoomBar,
		})
	end
	zoomButton("−", 1, function()
		setZoom(zoomScale.Scale / 1.2)
	end)
	zoomButton("+", 2, function()
		setZoom(zoomScale.Scale * 1.2)
	end)
	zoomButton("⤢", 3, function()
		-- Fit the revealed part of the tree into the view.
		local win = windowLocalSize()
		local w, h = bounds.X1 - bounds.X0, bounds.Y1 - bounds.Y0
		zoomScale.Scale = math.clamp(math.min(win.X / w, win.Y / h), MIN_ZOOM, MAX_ZOOM)
		layoutCanvas()
		centerOn(Vector2.new((bounds.X0 + bounds.X1) / 2, (bounds.Y0 + bounds.Y1) / 2))
	end)

	-- Detail panel -------------------------------------------------------------------------------
	local detail = UI.panel({
		Name = "Detail",
		Size = UDim2.new(0, 310, 1, 0),
		Position = UDim2.new(1, -310, 0, 0),
		BackgroundColor3 = C.PanelLight,
		Padding = 16,
		Parent = body,
	})
	local spLabel = UI.label({ Text = "", Font = F.Heading, TextSize = 18, TextColor3 = C.Success, Size = UDim2.new(1, 0, 0, 24), Parent = detail })
	local discoverLabel = UI.label({ Name = "Discover", Text = "", TextSize = 12, TextColor3 = C.TextMuted, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 24), Parent = detail })
	local dIcon = UI.label({ Text = "", TextSize = 44, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 56), Position = UDim2.fromOffset(0, 42), Parent = detail })
	local dName = UI.label({ Text = "", Font = F.Heading, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 100), Parent = detail })
	local dBranch = UI.label({ Text = "", Font = F.Bold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 124), Parent = detail })
	local dDesc = UI.label({ Text = "", TextSize = 14, TextColor3 = C.TextDim, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 148), Parent = detail })
	local dEffect = UI.label({ Text = "", Font = F.Bold, TextSize = 14, TextColor3 = C.Accent2, TextWrapped = true, RichText = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 192), Parent = detail })
	local dReq = UI.label({ Text = "", TextSize = 13, TextColor3 = C.TextMuted, TextWrapped = true, RichText = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 236), Parent = detail })
	local unlock = UI.button({
		Text = "Unlock",
		Variant = "success",
		Size = UDim2.new(1, 0, 0, 46),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -50),
		Sound = "Unlock",
		OnClick = function()
			local id = selectedId
			local result = ClientNet.once("skill", "UnlockSkill", { Id = id })
			if not result then
				return
			end
			if result.ok then
				local entry = nodes[id]
				entry.Scale.Scale = 1.35
				UI.tween(entry.Scale, { Scale = 1 }, Theme.Motion.Pop)
				local fx = ctx.Layers.Fx
				local center = entry.Button.AbsolutePosition + entry.Button.AbsoluteSize / 2 - fx.AbsolutePosition
				Effects.burst(fx, center, entry.Branch.Color, 18, 140)
				Effects.ring(fx, center, entry.Branch.Color, 200)
			else
				ctx.Notifications.error(result.err)
			end
		end,
		Parent = detail,
	})
	UI.button({
		Text = `Reset skills (💎 {GameConfig.Skills.RespecGemCost})`,
		Variant = "ghost",
		Size = UDim2.new(1, 0, 0, 40),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		TextSize = 14,
		OnClick = function()
			local ok = UI.confirm({
				Title = "Reset the skill tree?",
				Message = `All spent Skill Points are refunded and the tree folds back to the core. This costs 💎 {GameConfig.Skills.RespecGemCost} Gems.`,
				ConfirmText = "Reset",
				Danger = true,
			})
			if ok then
				local result = ClientNet.once("respec", "ResetSkills")
				if result then
					ctx.Notifications.result(result, "Skill tree reset.")
				end
			end
		end,
		Parent = detail,
	})

	-- Reveal animation ---------------------------------------------------------------------------
	-- Applies a node's visibility state; animates when `animate` and the state changed.
	local function showNode(entry, state: string, animate: boolean, delay: number)
		local previous = entry.Shown
		if previous == state then
			return
		end
		entry.Shown = state
		local button, name = entry.Button, entry.Name
		if state == "hidden" then
			name.Visible = false
			if animate and previous ~= nil and not Theme.ReducedMotion then
				local t = UI.tween(entry.Scale, { Scale = 0 }, Theme.Motion.Fast)
				if t then
					t.Completed:Connect(function()
						if entry.Shown == "hidden" then
							button.Visible = false
						end
					end)
					return
				end
			end
			button.Visible = false
			return
		end
		local teaser = state == "teaser"
		button.Visible = true
		button.Text = if teaser then "?" else entry.Node.Icon
		button.Selectable = true
		entry.Rank.Visible = not teaser
		name.Visible = not teaser
		if not animate or previous == nil or Theme.ReducedMotion then
			entry.Scale.Scale = 1
			return
		end
		-- Pop in, slightly staggered by distance from the core so the tree "grows".
		entry.Scale.Scale = if previous == "hidden" then 0 else 0.6
		task.delay(delay, function()
			if entry.Shown == state then
				UI.tween(entry.Scale, { Scale = 1 }, Theme.Motion.Pop)
			end
		end)
	end

	local function showLine(line, shown: boolean, animate: boolean, delay: number)
		if line.Shown == shown then
			return
		end
		local first = line.Shown == nil
		line.Shown = shown
		local frame = line.Line
		if not shown then
			frame.Visible = false
			return
		end
		frame.Visible = true
		local full = (line.B - line.A).Magnitude
		local thickness = if line.Optional then 3 else 5
		local mid = (line.A + line.B) / 2
		if not animate or first or Theme.ReducedMotion then
			frame.Position = UDim2.fromOffset(mid.X, mid.Y)
			frame.Size = UDim2.fromOffset(full, thickness)
			return
		end
		-- Draw outward from the parent: the line's centre and length grow together.
		frame.Position = UDim2.fromOffset(line.A.X, line.A.Y)
		frame.Size = UDim2.fromOffset(0, thickness)
		task.delay(delay, function()
			if line.Shown then
				UI.tween(frame, { Position = UDim2.fromOffset(mid.X, mid.Y), Size = UDim2.fromOffset(full, thickness) }, Theme.Motion.Slow)
			end
		end)
	end

	-- Rendering ----------------------------------------------------------------------------------
	local pulse = 0
	RunService.RenderStepped:Connect(function(dt)
		if not window.IsOpen() or Theme.ReducedMotion then
			return
		end
		pulse += dt
		local t = (math.sin(pulse * 4) + 1) / 2
		for _, entry in pairs(nodes) do
			if entry.Available and entry.Shown == "visible" then
				entry.Stroke.Transparency = t * 0.6
			end
		end
	end)

	local everShown = false
	function screen.Refresh()
		if not window.IsOpen() then
			return
		end
		local owned = State.get("Skills") or {}
		local sp = State.progress().SkillPoints
		local vis = Skills.visibility(owned)
		local animate = everShown
		everShown = true

		-- Reveal / collapse ------------------------------------------------------------------
		local ownedCount, undiscovered = 0, 0
		local x0, y0, x1, y1 = math.huge, math.huge, -math.huge, -math.huge
		for id, entry in pairs(nodes) do
			local state = vis[id]
			if (owned[id] or 0) > 0 then
				ownedCount += 1
			end
			if state ~= "visible" then
				undiscovered += 1
			end
			if state ~= "hidden" then
				local pos = nodePosition(entry.Node)
				x0, y0 = math.min(x0, pos.X), math.min(y0, pos.Y)
				x1, y1 = math.max(x1, pos.X), math.max(y1, pos.Y)
			end
			local distance = math.abs(entry.Node.X) + math.abs(entry.Node.Y)
			showNode(entry, state, animate, math.min(0.4, distance * 0.04))
		end
		for _, line in ipairs(lines) do
			-- Lines start at a visible node and end at a visible node or a teaser.
			local shown = vis[line.From] == "visible" and vis[line.To] ~= "hidden"
			showLine(line, shown, animate, 0.05)
		end
		if vis[selectedId] == "hidden" then
			selectedId = "core"
		end
		local newBounds = { X0 = x0 - PAD, Y0 = y0 - PAD, X1 = x1 + PAD, Y1 = y1 + PAD + 20 }
		if newBounds.X0 ~= bounds.X0 or newBounds.Y0 ~= bounds.Y0 or newBounds.X1 ~= bounds.X1 or newBounds.Y1 ~= bounds.Y1 then
			bounds = newBounds
			layoutCanvas()
		end

		spLabel.Text = `🌳 {sp} Skill Point{if sp == 1 then "" else "s"}  ·  {Formulas.skillPointsSpent(State.view())} spent`
		discoverLabel.Text = `{ownedCount} / {#Skills.List} skills unlocked` .. (if undiscovered > 0 then `  ·  {undiscovered} still to discover` else "  ·  tree complete!")

		-- Node states ------------------------------------------------------------------------
		for id, entry in pairs(nodes) do
			local node = entry.Node
			local rank = owned[id] or 0
			local met = Skills.prerequisitesMet(node, owned)
			local maxed = rank >= node.MaxRank
			local affordable = Skills.costFor(node, rank) <= sp
			entry.Available = met and not maxed and affordable
			entry.Rank.Text = `{rank}/{node.MaxRank}`
			if entry.Shown == "teaser" then
				entry.Button.BackgroundColor3 = C.Panel
				entry.Stroke.Color = C.StrokeSoft
				entry.Stroke.Transparency = 0.5
				entry.Button.TextTransparency = 0.45
			elseif maxed then
				entry.Button.BackgroundColor3 = Theme.darken(entry.Branch.Color, 0.35)
				entry.Stroke.Color = C.Gold
				entry.Stroke.Transparency = 0
				entry.Button.TextTransparency = 0
			elseif rank > 0 then
				entry.Button.BackgroundColor3 = Theme.darken(entry.Branch.Color, 0.5)
				entry.Stroke.Color = entry.Branch.Color
				entry.Stroke.Transparency = 0
				entry.Button.TextTransparency = 0
			elseif met then
				entry.Button.BackgroundColor3 = C.PanelLight
				entry.Stroke.Color = entry.Branch.Color
				entry.Stroke.Transparency = if entry.Available then entry.Stroke.Transparency else 0.4
				entry.Button.TextTransparency = 0.1
			else
				entry.Button.BackgroundColor3 = C.Panel
				entry.Stroke.Color = C.StrokeSoft
				entry.Stroke.Transparency = 0
				entry.Button.TextTransparency = 0.6
			end
			entry.Name.TextColor3 = if rank > 0 then entry.Branch.Color else C.TextMuted
			entry.Button.Size = if id == selectedId then UDim2.fromOffset(NODE + 10, NODE + 10) else UDim2.fromOffset(NODE, NODE)
		end
		for _, line in ipairs(lines) do
			local active = (owned[line.From] or 0) > 0 and (owned[line.To] or 0) > 0
			local reachable = (owned[line.From] or 0) > 0 and vis[line.To] == "visible"
			line.Line.BackgroundColor3 = if active
				then Skills.Branches[Skills.ById[line.To].Branch].Color
				elseif reachable then C.Stroke
				else C.StrokeSoft
			line.Line.BackgroundTransparency = if vis[line.To] == "teaser" then 0.55 elseif line.Optional then 0.35 else 0
		end

		-- Detail panel ------------------------------------------------------------------------
		local node = Skills.ById[selectedId]
		local branch = Skills.Branches[node.Branch]
		local rank = owned[node.Id] or 0
		if vis[node.Id] == "teaser" then
			-- Undiscovered: no name, effect or cost; only which visible skills lead to it.
			dIcon.Text = "❔"
			dName.Text = "Undiscovered skill"
			dBranch.Text = `{branch.Name} branch`
			dBranch.TextColor3 = branch.Color
			dDesc.Text = "Unlock a connected skill to reveal what this one does."
			dEffect.Text = ""
			local names = {}
			for _, req in ipairs(Skills.prerequisiteIds(node)) do
				if vis[req] == "visible" then
					table.insert(names, Skills.ById[req].Name)
				end
			end
			dReq.Text = if #names > 0 then "Connected to " .. table.concat(names, ", ") else ""
			UI.setText(unlock, "Undiscovered ❔")
			UI.setEnabled(unlock, false)
			return
		end
		dIcon.Text = node.Icon
		dName.Text = node.Name
		dBranch.Text = `{branch.Name} · Rank {rank}/{node.MaxRank}`
		dBranch.TextColor3 = branch.Color
		dDesc.Text = node.Description
		if rank >= node.MaxRank then
			dEffect.Text = "Now: " .. effectText(node, rank)
		elseif rank > 0 then
			dEffect.Text = `Now: {effectText(node, rank)}\n<font color="#9A96B8">Next:</font> {effectText(node, rank + 1)}`
		else
			dEffect.Text = "Unlock: " .. effectText(node, 1)
		end
		local reqParts = {}
		for _, req in ipairs(node.Requires) do
			local done = (owned[req] or 0) > 0
			table.insert(reqParts, (if done then "✓ " else "✗ ") .. Skills.ById[req].Name)
		end
		if #node.RequiresAny > 0 then
			local names = {}
			local any = false
			for _, req in ipairs(node.RequiresAny) do
				-- Only name the options the player can already see.
				table.insert(names, if vis[req] == "visible" then Skills.ById[req].Name else "???")
				if (owned[req] or 0) > 0 then
					any = true
				end
			end
			table.insert(reqParts, (if any then "✓ " else "✗ ") .. "one of: " .. table.concat(names, " / "))
		end
		dReq.Text = if #reqParts > 0 then "Requires " .. table.concat(reqParts, ", ") else "No requirements"
		if rank >= node.MaxRank then
			UI.setText(unlock, "Maxed ✓")
			UI.setEnabled(unlock, false)
		else
			local cost = Skills.costFor(node, rank)
			local met = Skills.prerequisitesMet(node, owned)
			UI.setText(unlock, if met then `Unlock · {cost} SP` else "Locked 🔒")
			UI.setEnabled(unlock, met and sp >= cost)
		end
	end

	State.subscribe({ "Skills", "Progress" }, function()
		screen.Refresh()
	end)
	window.Opened.Event:Connect(function()
		screen.Refresh()
		layoutCanvas()
		centerOn(nodePosition(Skills.ById[selectedId]))
	end)
	return screen
end

return SkillsScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">Stats</string>
              <string name="Source"><![CDATA[--[[
	Stats (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Screens/Stats
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format,Formulas,Util,Config/*},
	            Client/{State,ClientNet}

	Personal statistics and leaderboards (global boards from OrderedDataStores,
	refreshed by the server every couple of minutes, plus a live board for the
	current server).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Util = require(Shared.Util)
local Config = Shared.Config
local GameConfig = require(Config.GameConfig)
local Items = require(Config.Items)

local Client = script.Parent.Parent
local State = require(Client.State)
local ClientNet = require(Client.ClientNet)

local C = Theme.Colors
local F = Theme.Fonts

local StatsScreen = {}

local TILES = {
	{ "Total presses", function(v, s)
		return Format.commas(s.TotalClicks)
	end },
	{ "Auto presses", function(v, s)
		return Format.commas(s.AutoClicks)
	end },
	{ "Lifetime Sparks", function(v, s)
		return Format.short(s.LifetimeSparks)
	end },
	{ "Sparks this run", function(v, s)
		return Format.short(s.SparksThisRun)
	end },
	{ "Best run", function(v, s)
		return Format.short(s.BestRunSparks)
	end },
	{ "Ascensions", function(v)
		return tostring(v.Rebirths)
	end },
	{ "Level", function(v)
		return tostring(v.Level)
	end },
	{ "Crates opened", function(v, s)
		return Format.commas(s.ChestsOpened)
	end },
	{ "Items discovered", function(v)
		return `{Formulas.discoveredCount(v)} / {Items.Count}`
	end },
	{ "Legendary+ found", function(v, s)
		return Format.commas(s.LegendariesFound)
	end },
	{ "Mythic+ found", function(v, s)
		return Format.commas(s.MythicsFound)
	end },
	{ "Secrets found", function(v, s)
		return Format.commas(s.SecretsFound)
	end },
	{ "Critical presses", function(v, s)
		return Format.commas(s.TotalCrits)
	end },
	{ "Highest combo", function(v, s)
		return Format.commas(s.HighestCombo)
	end },
	{ "Streak bursts", function(v, s)
		return Format.commas(s.StreakBursts)
	end },
	{ "Golden presses", function(v, s)
		return Format.commas(s.GoldenClicks)
	end },
	{ "Upgrades bought", function(v, s)
		return Format.commas(s.UpgradesPurchased)
	end },
	{ "Items sold", function(v, s)
		return Format.commas(s.ItemsSold)
	end },
	{ "Quests completed", function(v, s)
		return Format.commas(s.QuestsCompleted)
	end },
	{ "Orbs collected", function(v, s)
		return Format.commas(s.OrbsCollected)
	end },
	{ "Gems earned", function(v, s)
		return Format.short(s.GemsEarned)
	end },
	{ "Prisms earned", function(v, s)
		return Format.short(s.PrismsEarned)
	end },
	{ "Offline earnings", function(v, s)
		return Format.short(s.OfflineEarned)
	end },
	{ "Best login streak", function(v, s)
		return Format.commas(s.BestDailyStreak)
	end },
	{ "Time played", function(v, s)
		return Format.time(s.PlayTime)
	end },
}

function StatsScreen.new(ctx)
	local window = UI.window({
		Name = "Stats",
		Title = "Statistics & Leaderboards",
		Subtitle = "Global boards update every few minutes.",
		Icon = "🏆",
		Parent = ctx.Layers.Windows,
	})
	local screen: { [string]: any } = { Window = window }
	local body = window.Body
	local tab = "Stats"
	local board = GameConfig.Leaderboards.Boards[1].Id
	local scope = "Global"
	local cache = nil
	local lastFetch = 0

	UI.segmented({
		Options = { { Id = "Stats", Text = "📊 My stats" }, { Id = "Boards", Text = "🏆 Leaderboards" } },
		Value = "Stats",
		ButtonWidth = 170,
		OnChange = function(id)
			tab = id
			screen.Refresh()
		end,
		Parent = body,
	})

	local statsPage = UI.scroll({
		Size = UDim2.new(1, 0, 1, -50),
		Position = UDim2.fromOffset(0, 50),
		Grid = { Cell = UDim2.fromOffset(206, 70), Pad = UDim2.fromOffset(10, 10) },
		Padding = { 2, 8, 2, 8 },
		Parent = body,
	})
	local tiles = {}
	for index, spec in ipairs(TILES) do
		local tile = UI.panel({ Size = UDim2.fromOffset(206, 70), BackgroundColor3 = C.PanelLight, LayoutOrder = index, Padding = 12, Parent = statsPage })
		UI.label({ Text = spec[1], TextSize = 13, TextColor3 = C.TextDim, Size = UDim2.new(1, 0, 0, 16), Parent = tile })
		local value = UI.label({ Text = "", Font = F.Heading, TextSize = 21, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 20), Parent = tile })
		tiles[index] = { Value = value, Fn = spec[2] }
	end

	local boardsPage = UI.frame({ Size = UDim2.new(1, 0, 1, -50), Position = UDim2.fromOffset(0, 50), Visible = false, Parent = body })
	local boardOptions = {}
	for _, b in ipairs(GameConfig.Leaderboards.Boards) do
		table.insert(boardOptions, { Id = b.Id, Text = `{b.Icon} {b.Name}` })
	end
	UI.segmented({
		Options = boardOptions,
		Value = board,
		ButtonWidth = 150,
		OnChange = function(id)
			board = id
			screen.Refresh()
		end,
		Parent = boardsPage,
	})
	UI.segmented({
		Options = { { Id = "Global", Text = "🌐 Global" }, { Id = "Server", Text = "🖥️ Server" } },
		Value = "Global",
		ButtonWidth = 100,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		OnChange = function(id)
			scope = id
			screen.Refresh()
		end,
		Parent = boardsPage,
	})
	local status = UI.label({ Text = "", TextSize = 13, TextColor3 = C.TextDim, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 42), Parent = boardsPage })
	local rowsFrame = UI.scroll({ Size = UDim2.new(1, 0, 1, -70), Position = UDim2.fromOffset(0, 66), List = { Dir = "Y", Pad = 4 }, Padding = { 2, 8, 2, 2 }, Parent = boardsPage })
	local rows = {}

	local function row(i: number)
		local r = rows[i]
		if r then
			return r
		end
		local frame = UI.panel({ Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.PanelLight, LayoutOrder = i, Parent = rowsFrame })
		local rank = UI.label({ Text = "", Font = F.Heading, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(56, 40), Parent = frame })
		local name = UI.label({ Text = "", Font = F.Bold, TextSize = 15, Size = UDim2.new(1, -240, 1, 0), Position = UDim2.fromOffset(56, 0), Parent = frame })
		local value = UI.label({
			Text = "",
			Font = F.Heading,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -14, 0, 0),
			Size = UDim2.fromOffset(170, 40),
			Parent = frame,
		})
		r = { Frame = frame, Rank = rank, Name = name, Value = value }
		rows[i] = r
		return r
	end

	local function fetch(force: boolean)
		if not force and cache and os.clock() - lastFetch < 30 then
			return
		end
		lastFetch = os.clock()
		local result = ClientNet.action("GetLeaderboards")
		if result.ok then
			cache = result
		end
	end

	local function formatValue(boardId: string, value: number): string
		if boardId == "LifetimeSparks" then
			return "⚡ " .. Format.short(value)
		end
		return Format.commas(value)
	end

	function screen.Refresh()
		if not window.IsOpen() then
			return
		end
		statsPage.Visible = tab == "Stats"
		boardsPage.Visible = tab == "Boards"
		if tab == "Stats" then
			local view = State.view()
			for _, tile in ipairs(tiles) do
				tile.Value.Text = tile.Fn(view, view.Stats)
			end
			return
		end
		local entries = {}
		if cache then
			if scope == "Global" then
				entries = (cache.Global or {})[board] or {}
				status.Text = if cache.Available
					then (if #entries > 0 then `Updated {Format.time(math.max(0, Util.serverTime() - (cache.UpdatedAt or Util.serverTime())))} ago` else "No entries yet — the board refreshes every few minutes.")
					else "Global leaderboards are unavailable in this session (DataStores disabled)."
			else
				local stat = if board == "LifetimeSparks" then "LifetimeSparks" elseif board == "TotalClicks" then "TotalClicks" else "Rebirths"
				for _, e in ipairs(cache.Server or {}) do
					table.insert(entries, { UserId = e.UserId, Name = e.DisplayName or e.Name, Value = e[stat] or 0 })
				end
				table.sort(entries, function(a, b)
					return a.Value > b.Value
				end)
				for i, e in ipairs(entries) do
					e.Rank = i
				end
				status.Text = `{#entries} player(s) in this server`
			end
		else
			status.Text = "Loading…"
		end
		local me = Players.LocalPlayer.UserId
		for i, e in ipairs(entries) do
			local r = row(i)
			r.Frame.Visible = true
			r.Rank.Text = if e.Rank == 1 then "🥇" elseif e.Rank == 2 then "🥈" elseif e.Rank == 3 then "🥉" else "#" .. tostring(e.Rank)
			r.Name.Text = e.Name or ("Player " .. tostring(e.UserId))
			r.Value.Text = formatValue(board, e.Value or 0)
			r.Frame.BackgroundColor3 = if e.UserId == me then Theme.darken(C.Accent2, 0.75) else C.PanelLight
		end
		for i = #entries + 1, #rows do
			rows[i].Frame.Visible = false
		end
	end

	window.Opened.Event:Connect(function()
		screen.Refresh()
		task.spawn(function()
			fetch(false)
			screen.Refresh()
		end)
	end)
	State.subscribe({ "Stats", "Progress", "Discovered" }, function()
		if tab == "Stats" then
			screen.Refresh()
		end
	end)
	return screen
end

return StatsScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">Store</string>
              <string name="Source"><![CDATA[--[[
	Store (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Screens/Store
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format,RobuxSale,
	            Config/GamePasses,Config/DevProducts}, Client/State

	The Robux store: game passes (buy once, keep forever) and developer
	products (Gem packs, a timed Sparks boost, a crate bundle). Buttons only
	open Roblox's purchase prompt; the server grants everything
	(GamePassService / ProductService). Prices come from Roblox
	(GetProductInfo); until they load, the suggested price is shown with "~".

	Items whose Roblox ID is still 0 in the config are hidden in live games and
	shown as "Not set up" in Studio, so the owner can see what is missing.
	Each item is prompted as a game pass or a developer product depending on
	how it is really sold (Shared/RobuxSale); items Roblox reports as not for
	sale say so instead of opening a prompt that would fail.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local GamePasses = require(Shared.Config.GamePasses)
local DevProducts = require(Shared.Config.DevProducts)
local Chests = require(Shared.Config.Chests)
local RobuxSale = require(Shared.RobuxSale)

local Client = script.Parent.Parent
local State = require(Client.State)

local C = Theme.Colors
local F = Theme.Fonts

local CARD = UDim2.fromOffset(272, 194)

local Store = {}

-- "Epic 70% · Legendary 24% · …" for a Robux crate (before Luck).
local function crateOdds(chestId: string): string
	local chest = Chests.RobuxById[chestId]
	if not chest then
		return ""
	end
	local total = 0
	for _, weight in pairs(chest.Weights) do
		total += weight
	end
	local parts = {}
	for _, rarityId in ipairs({ "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }) do
		local weight = chest.Weights[rarityId]
		if weight then
			table.insert(parts, `{rarityId} {Format.pct(weight / total, if weight / total < 0.1 then 1 else 0)}`)
		end
	end
	local variants = ""
	if chest.ForceVariant then
		variants = " Always Rainbow (×6 power)."
	elseif chest.VariantChances then
		variants = ` Golden {Format.pct(chest.VariantChances.golden or 0, 1)} · Rainbow {Format.pct(chest.VariantChances.rainbow or 0, 1)}.`
	end
	return table.concat(parts, " · ") .. "." .. variants .. " Items from crates you have unlocked."
end

function Store.new(ctx)
	local window = UI.window({
		Name = "Store",
		Title = "Store",
		Subtitle = "Game passes and boosts for Robux. Every purchase goes through Roblox.",
		Icon = "💰",
		Parent = ctx.Layers.Windows,
	})
	local screen: { [string]: any } = { Window = window }
	local isStudio = RunService:IsStudio()
	-- Keyed "<kind>:<id>" (the same number can be a pass and an unrelated product).
	local prices: { [string]: number } = {}
	local notForSale: { [string]: boolean } = {}
	local fetching: { [string]: boolean } = {}

	-- Opens Roblox's prompt for however the entry is really sold.
	local function prompt(entry)
		local kind, id = RobuxSale.of(entry)
		if kind == "pass" then
			MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, id)
		elseif kind == "product" then
			MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
		end
	end

	local list = UI.scroll({
		Name = "List",
		List = { Dir = "Y", Pad = 10 },
		Padding = { 2, 8, 2, 2 },
		Parent = window.Body,
	})

	local function sectionTitle(order: number, text: string, sub: string)
		local frame = UI.frame({ Size = UDim2.new(1, 0, 0, 42), LayoutOrder = order, Parent = list })
		UI.label({ Text = text, Font = F.Heading, TextSize = 18, Size = UDim2.new(1, 0, 0, 22), Parent = frame })
		UI.label({ Text = sub, TextSize = 13, TextColor3 = C.TextDim, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 22), Parent = frame })
	end

	local function grid(order: number): Frame
		return UI.frame({
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
			Grid = { Cell = CARD, Pad = UDim2.fromOffset(10, 10) },
			Parent = list,
		})
	end

	local function emptyLabel(order: number, text: string): TextLabel
		return UI.label({
			Text = text,
			TextColor3 = C.TextMuted,
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = order,
			Visible = false,
			Parent = list,
		})
	end

	local function card(parent: Frame, order: number, spec): { [string]: any }
		local panel = UI.panel({
			Name = spec.Key,
			BackgroundColor3 = C.PanelLight,
			LayoutOrder = order,
			Padding = 12,
			Parent = parent,
		})
		local stroke = UI.stroke(panel, { Color = spec.Color, Thickness = 1.5, Transparency = 0.2 })
		UI.label({ Text = spec.Icon, TextSize = 34, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(44, 44), Parent = panel })
		UI.label({
			Text = spec.Name,
			Font = F.Heading,
			TextSize = 17,
			TextColor3 = spec.Color,
			Size = UDim2.new(1, -96, 0, 22),
			Position = UDim2.fromOffset(52, 0),
			Parent = panel,
		})
		if spec.Op then
			UI.label({
				Text = "OP",
				Font = F.Heading,
				TextSize = 12,
				TextColor3 = C.White,
				TextXAlignment = Enum.TextXAlignment.Center,
				BackgroundColor3 = C.Accent,
				BackgroundTransparency = 0,
				Corner = Theme.Radius.Pill,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 2),
				Size = UDim2.fromOffset(34, 18),
				Parent = panel,
			})
		end
		local effect = UI.label({
			Text = spec.Effect,
			Font = F.Bold,
			TextSize = 13,
			TextColor3 = C.Accent2,
			TextWrapped = true,
			Size = UDim2.new(1, -52, 0, 20),
			Position = UDim2.fromOffset(52, 22),
			Parent = panel,
		})
		local note = UI.label({
			Text = spec.Description,
			TextSize = 12,
			TextColor3 = C.TextDim,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.new(1, 0, 0, 62),
			Position = UDim2.fromOffset(0, 50),
			Parent = panel,
		})
		local button = UI.button({
			Name = "Buy",
			Text = "",
			Variant = "gold",
			TextSize = 14,
			Size = UDim2.new(1, 0, 0, 34),
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			OnClick = spec.OnBuy,
			Parent = panel,
		})
		return { Panel = panel, Stroke = stroke, Button = button, Effect = effect, Note = note }
	end

	local function saleKey(entry): string?
		local kind, id = RobuxSale.of(entry)
		return if kind then `{kind}:{id}` else nil
	end

	local function priceText(entry, suggested: number): string
		local key = saleKey(entry)
		local price = key and prices[key]
		return if price then `R$ {Format.commas(price)}` else `~R$ {Format.commas(suggested)}`
	end

	local function isNotForSale(entry): boolean
		local key = saleKey(entry)
		return key ~= nil and notForSale[key] == true
	end

	-- Asks Roblox for real prices once per item (failures keep the suggested price).
	local function fetchPrices()
		local function fetch(entry)
			local kind, id = RobuxSale.of(entry)
			local key = saleKey(entry)
			if not kind or not key or prices[key] or fetching[key] then
				return
			end
			fetching[key] = true
			local infoType = if kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
			task.spawn(function()
				local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, infoType)
				if ok and type(info) == "table" then
					if type(info.PriceInRobux) == "number" and info.PriceInRobux > 0 then
						prices[key] = info.PriceInRobux
					end
					notForSale[key] = info.IsForSale == false
					screen.Refresh()
				else
					-- Try again next time the store opens.
					fetching[key] = nil
				end
			end)
		end
		for _, pass in ipairs(GamePasses.List) do
			fetch(pass)
		end
		for _, product in ipairs(DevProducts.List) do
			fetch(product)
		end
	end

	local function productNote(product): string
		local kind = RobuxSale.of(product)
		if kind == "pass" then
			return "One-time purchase: each player can buy this once."
		elseif product.Crate then
			return crateOdds(product.Crate)
		elseif product.Boost then
			return `Stacks: every purchase adds {math.floor(product.Boost.Seconds / 60)} more minutes of play.`
		elseif product.Crates and not product.Gems and not product.Sparks then
			return "Picks the most valuable Spark crate your stage has unlocked."
		elseif product.Sparks and not product.Gems then
			return "Spend them on upgrades and crates."
		end
		return "Gems buy Prism Caches and skill respecs."
	end

	-- Game passes ------------------------------------------------------------------------------
	sectionTitle(1, "🎟️ Game Passes", "Buy once, keep forever. Stack them for even more power.")
	local passGrid = grid(2)
	local passEmpty = emptyLabel(3, "No passes available yet.")
	local passCards = {}
	for index, pass in ipairs(GamePasses.List) do
		passCards[pass.Key] = card(passGrid, index, {
			Key = pass.Key,
			Name = pass.Name,
			Icon = pass.Icon,
			Color = pass.Color,
			Op = pass.Op,
			Effect = pass.EffectText,
			Description = pass.Description,
			OnBuy = function()
				if GamePasses.isConfigured(pass) and not GamePasses.owns(State.get("Passes"), pass.Key) and not isNotForSale(pass) then
					prompt(pass)
				end
			end,
		})
	end

	-- Developer products -------------------------------------------------------------------------
	sectionTitle(4, "⚡ Sparks, Gems & Boosts", "Boost time only runs while you play.")
	local productGrid = grid(5)
	local productEmpty = emptyLabel(6, "No products available yet.")
	local productCards = {}
	for index, product in ipairs(DevProducts.List) do
		productCards[product.Key] = card(productGrid, index, {
			Key = product.Key,
			Name = product.Name,
			Icon = product.Icon,
			Color = product.Color,
			Effect = product.Description,
			Op = product.Op,
			Description = productNote(product),
			OnBuy = function()
				local owned = (State.get("PassRewards") or {})[product.Key] == true and RobuxSale.of(product) == "pass"
				if DevProducts.isConfigured(product) and not owned and not isNotForSale(product) then
					prompt(product)
				end
			end,
		})
	end

	UI.label({
		Text = "Purchases are processed by Roblox. Passes are re-checked by the server every time you join.",
		TextSize = 12,
		TextColor3 = C.TextMuted,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 7,
		Parent = list,
	})

	function screen.Refresh()
		if not window.IsOpen() then
			return
		end
		local owned = State.get("Passes")
		local shownPasses = 0
		for _, pass in ipairs(GamePasses.List) do
			local entry = passCards[pass.Key]
			local configured = GamePasses.isConfigured(pass)
			entry.Panel.Visible = configured or isStudio
			if entry.Panel.Visible then
				shownPasses += 1
			end
			if GamePasses.owns(owned, pass.Key) then
				UI.setText(entry.Button, "✓ Owned")
				UI.setVariant(entry.Button, "success")
				UI.setEnabled(entry.Button, false)
				entry.Stroke.Thickness = 3
				entry.Stroke.Color = C.Gold
			elseif not configured then
				UI.setText(entry.Button, "Not set up (GamePassId missing)")
				UI.setVariant(entry.Button, "ghost")
				UI.setEnabled(entry.Button, false)
			elseif isNotForSale(pass) then
				UI.setText(entry.Button, "Not for sale yet")
				UI.setVariant(entry.Button, "ghost")
				UI.setEnabled(entry.Button, false)
			else
				UI.setText(entry.Button, `Buy · {priceText(pass, pass.SuggestedPrice)}`)
				UI.setVariant(entry.Button, "gold")
				UI.setEnabled(entry.Button, true)
			end
		end
		passEmpty.Visible = shownPasses == 0

		local derived = State.get("Derived")
		local now = workspace:GetServerTimeNow()
		local shownProducts = 0
		for _, product in ipairs(DevProducts.List) do
			local entry = productCards[product.Key]
			local configured = DevProducts.isConfigured(product)
			entry.Panel.Visible = configured or isStudio
			if entry.Panel.Visible then
				shownProducts += 1
			end
			local endsAt = derived and derived.BoostEndsAt and derived.BoostEndsAt[product.Key]
			entry.Effect.Text = if type(endsAt) == "number" and endsAt > now
				then `{product.Description} · active {Format.clock(endsAt - now)}`
				else product.Description
			entry.Note.Text = productNote(product)
			local rewarded = (State.get("PassRewards") or {})[product.Key] == true and RobuxSale.of(product) == "pass"
			if rewarded then
				UI.setText(entry.Button, "✓ Owned")
				UI.setVariant(entry.Button, "success")
				UI.setEnabled(entry.Button, false)
			elseif configured and isNotForSale(product) then
				UI.setText(entry.Button, "Not for sale yet")
				UI.setVariant(entry.Button, "ghost")
				UI.setEnabled(entry.Button, false)
			elseif configured then
				UI.setText(entry.Button, `Buy · {priceText(product, product.SuggestedPrice)}`)
				UI.setVariant(entry.Button, "gold")
				UI.setEnabled(entry.Button, true)
			else
				UI.setText(entry.Button, "Not set up (ProductId missing)")
				UI.setVariant(entry.Button, "ghost")
				UI.setEnabled(entry.Button, false)
			end
		end
		productEmpty.Visible = shownProducts == 0
	end

	State.subscribe({ "Passes", "Boosts", "PassRewards", "Derived" }, screen.Refresh)
	local openCount = 0
	window.Opened.Event:Connect(function()
		openCount += 1
		local thisOpen = openCount
		fetchPrices()
		screen.Refresh()
		-- Keep boost timers ticking while the store is open (one loop per opening).
		task.spawn(function()
			while window.IsOpen() and thisOpen == openCount do
				task.wait(1)
				screen.Refresh()
			end
		end)
	end)
	return screen
end

return Store
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--[[
	State (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/State
	Depends on: (none)

	Read-only client mirror of the player's own data, filled by StateSync
	from the server. UI code subscribes to sections and re-renders when they
	change. Nothing here is ever sent back to the server.
]]

local State = {
	Data = {} :: { [string]: any },
	Ready = false,
}

local listeners: { [string]: { (string) -> () } } = {}
local readyCallbacks: { () -> () } = {}
local ALL = "*"

local function notify(sections: { [string]: boolean })
	local called: { [any]: boolean } = {}
	for section in pairs(sections) do
		for _, list in ipairs({ listeners[section] or {}, listeners[ALL] or {} }) do
			for _, fn in ipairs(list) do
				if not called[fn] then
					called[fn] = true
					task.spawn(fn, section)
				end
			end
		end
	end
end

function State.apply(kind: string, payload: { [string]: any })
	if type(payload) ~= "table" then
		return
	end
	local changed = {}
	for section, value in pairs(payload) do
		State.Data[section] = value
		changed[section] = true
	end
	if kind == "full" and not State.Ready then
		State.Ready = true
		for _, fn in ipairs(readyCallbacks) do
			task.spawn(fn)
		end
		table.clear(readyCallbacks)
	end
	if State.Ready then
		notify(changed)
	end
end

-- Calls fn(section) whenever one of the sections changes. Returns an unsubscribe function.
function State.subscribe(sections: { string } | string, fn: (string) -> ()): () -> ()
	local list = if type(sections) == "string" then { sections } else sections
	for _, section in ipairs(list) do
		listeners[section] = listeners[section] or {}
		table.insert(listeners[section], fn)
	end
	return function()
		for _, section in ipairs(list) do
			local l = listeners[section]
			if l then
				local index = table.find(l, fn)
				if index then
					table.remove(l, index)
				end
			end
		end
	end
end

function State.onReady(fn: () -> ())
	if State.Ready then
		task.spawn(fn)
	else
		table.insert(readyCallbacks, fn)
	end
end

function State.get(section: string): any
	return State.Data[section]
end

function State.stats()
	local derived = State.Data.Derived
	return derived and derived.Stats
end

function State.currency(currency: string): number
	local c = State.Data.Currencies
	return c and c[currency] or 0
end

function State.progress()
	return State.Data.Progress or { Level = 1, XP = 0, SkillPoints = 0, Rebirths = 0, XPRequired = 1 }
end

-- A table shaped like the server data, for Shared/Formulas previews.
function State.view()
	local d = State.Data
	local progress = State.progress()
	return {
		Currencies = d.Currencies or {},
		Upgrades = d.Upgrades or {},
		Ascension = d.Ascension or {},
		Skills = d.Skills or {},
		Inventory = d.Inventory or {},
		Equipped = d.Equipped or {},
		Discovered = d.Discovered or {},
		Stats = d.Stats or {},
		Passes = d.Passes or {},
		Boosts = d.Boosts or {},
		Rebirths = progress.Rebirths,
		Level = progress.Level,
	}
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--[[
	Tutorial (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Tutorial
	Depends on: ReplicatedStorage/UI/{UIKit,Theme,SoundPlayer}, ReplicatedStorage/Shared/Config/Tutorial,
	            Client/{State,ClientNet,ScreenManager,Hud}

	Shows the first-time tutorial: a coach card at the top of the screen, plus
	an arrow and a glowing ring on the HUD element the step is about. The
	SERVER decides when a step is done (TutorialService); this module only
	draws the current step from the synced "Tutorial" section and sends
	intents: "seen" (opening the quests, pressing Got it!) and "skip".
	Replaying is started from Settings.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local SoundPlayer = require(UIFolder.SoundPlayer)
local TutorialConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Tutorial"))

local State = require(script.Parent.State)
local ClientNet = require(script.Parent.ClientNet)
local ScreenManager = require(script.Parent.ScreenManager)

local C = Theme.Colors
local F = Theme.Fonts

local Tutorial: { [string]: any } = {}

local function currentStep()
	local state = State.get("Tutorial")
	if not state or state.Done then
		return nil
	end
	return TutorialConfig.Steps[state.Step]
end

function Tutorial.init(ctx)
	local hud = ctx.Hud
	local overlay = ctx.Layers.Overlay

	-- Coach card (top centre; the top of the screen is free now that the HUD is at the bottom).
	local card = UI.new("Frame", {
		Name = "TutorialCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(470, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 50,
		Corner = Theme.Radius.Medium,
		Stroke = { Color = C.Accent2, Thickness = 2 },
		Padding = 12,
		List = { Dir = "Y", Pad = 6 },
		Parent = overlay,
	})
	Tutorial.Card = card
	local scale = Instance.new("UIScale")
	scale.Parent = card
	local counter = UI.label({
		Name = "Counter",
		Text = "",
		Font = F.Bold,
		TextSize = 12,
		TextColor3 = C.Accent2,
		Size = UDim2.new(1, 0, 0, 14),
		LayoutOrder = 1,
		ZIndex = 51,
		Parent = card,
	})
	local title = UI.label({
		Name = "Title",
		Text = "",
		Font = F.Heading,
		TextSize = 18,
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = 2,
		ZIndex = 51,
		Parent = card,
	})
	local body = UI.label({
		Name = "Body",
		Text = "",
		TextSize = 14,
		TextWrapped = true,
		TextColor3 = C.TextDim,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, 0, 0, 18),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 3,
		ZIndex = 51,
		Parent = card,
	})
	local buttons = UI.frame({
		Name = "Buttons",
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 4,
		ZIndex = 51,
		List = { Dir = "X", Pad = 8, HA = "Right", VA = "Center" },
		Parent = card,
	})
	local gotIt = UI.button({
		Name = "GotIt",
		Text = "Got it!",
		Variant = "primary",
		Size = UDim2.fromOffset(110, 30),
		TextSize = 14,
		LayoutOrder = 2,
		ZIndex = 52,
		Visible = false,
		OnClick = function()
			local step = currentStep()
			if step and step.Kind == "seen" then
				ClientNet.action("TutorialSeen", { Step = step.Id })
			end
		end,
		Parent = buttons,
	})
	UI.button({
		Name = "Skip",
		Text = "Skip tutorial",
		Variant = "ghost",
		Size = UDim2.fromOffset(120, 30),
		TextSize = 13,
		LayoutOrder = 1,
		ZIndex = 52,
		OnClick = function()
			ClientNet.action("TutorialSkip", {})
		end,
		Parent = buttons,
	})

	-- Pointer and highlight ring around the target element.
	local ring = UI.new("Frame", {
		Name = "TutorialRing",
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 48,
		Corner = Theme.Radius.Medium,
		Stroke = { Color = C.Gold, Thickness = 3 },
		Parent = overlay,
	})
	ring.Active = false
	local arrow = UI.label({
		Name = "TutorialArrow",
		Text = "▼",
		Font = F.Heading,
		TextSize = 34,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(40, 40),
		Visible = false,
		ZIndex = 49,
		Parent = overlay,
	})
	UI.stroke(arrow, { Color = C.Black, Thickness = 2, Transparency = 0.3, Text = true })
	Tutorial.Ring = ring
	Tutorial.Arrow = arrow

	local shownStep: string? = nil
	local function refresh()
		local step = currentStep()
		card.Visible = step ~= nil
		if not step then
			shownStep = nil
			ring.Visible = false
			arrow.Visible = false
			return
		end
		counter.Text = `TUTORIAL · STEP {step.Index}/{#TutorialConfig.Steps}`
		title.Text = step.Title
		body.Text = step.Text
		gotIt.Visible = step.Final == true
		if shownStep ~= step.Id then
			shownStep = step.Id
			if not Theme.ReducedMotion then
				scale.Scale = 0.9
				UI.tween(scale, { Scale = 1 }, Theme.Motion.Pop)
			end
			if step.Index > 1 then
				SoundPlayer.play("Reveal")
			end
		end
	end

	-- "Look at the quests" completes when the quests are actually opened.
	local function onScreen(current: string?)
		local step = currentStep()
		if step and step.Id == "quests" and current == "Quests" then
			ClientNet.action("TutorialSeen", { Step = "quests" })
		end
	end
	ScreenManager.Changed:Connect(onScreen)

	-- Follow the target every frame (layouts move when the window size changes).
	local clock = 0
	RunService.RenderStepped:Connect(function(dt)
		clock += dt
		local step = currentStep()
		local target = step and hud.target(step.Target)
		-- While a window is open the HUD is covered: only the card stays.
		local show = target ~= nil and target.Visible and not ScreenManager.isOpen()
		ring.Visible = show
		arrow.Visible = show
		card.Position = UDim2.new(0.5, 0, 0, if ScreenManager.isOpen() then 8 else 70)
		if not show or not target then
			return
		end
		local origin = overlay.AbsolutePosition
		local pos = target.AbsolutePosition - origin
		local size = target.AbsoluteSize
		ring.Position = UDim2.fromOffset(pos.X - 6, pos.Y - 6)
		ring.Size = UDim2.fromOffset(size.X + 12, size.Y + 12)
		local bob = if Theme.ReducedMotion then 0 else math.sin(clock * 5) * 6
		arrow.Position = UDim2.fromOffset(pos.X + size.X / 2, pos.Y - 8 + bob)
	end)

	local function fitWidth()
		card.Size = UDim2.fromOffset(math.min(470, UI.viewport().X - 32), 0)
	end
	fitWidth()
	UI.onViewportChanged(fitWidth)

	State.subscribe("Tutorial", refresh)
	State.onReady(refresh)
end

-- Starts the tutorial again (Settings → Replay tutorial).
function Tutorial.replay()
	return ClientNet.action("TutorialRestart", {})
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">WorldFx</string>
            <string name="Source"><![CDATA[--[[
	WorldFx (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/WorldFx
	Depends on: ReplicatedStorage/Shared/{Formulas, Config/GameConfig}, Client/State

	Local-only effects on the 3D giant button in Workspace.Arena:
	  * it dips every time you press,
	  * its glow follows the whole server's presses per second (ServerCPS),
	  * it takes the colour of YOUR current stage.
	Nothing here replicates; every client sees its own view.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Formulas)

local State = require(script.Parent.State)

local WorldFx = {}

function WorldFx.init(ctx)
	task.spawn(function()
		local arena = workspace:WaitForChild("Arena", 30)
		local button = arena and arena:WaitForChild("GiantButton", 10)
		local cap = button and button:WaitForChild("Cap", 10)
		if not cap or not cap:IsA("BasePart") then
			return
		end
		local rim = button:FindFirstChild("Rim")
		local ring = arena:FindFirstChild("NeonRing")
		local light = cap:FindFirstChildOfClass("PointLight")
		local baseCFrame = cap.CFrame
		local pressInfo = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local releaseInfo = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

		ctx.BigButton.Pressed.Event:Connect(function()
			local down = TweenService:Create(cap, pressInfo, { CFrame = baseCFrame * CFrame.new(-0.7, 0, 0) })
			down.Completed:Connect(function()
				TweenService:Create(cap, releaseInfo, { CFrame = baseCFrame }):Play()
			end)
			down:Play()
		end)

		local serverState = ReplicatedStorage:WaitForChild("ServerState", 30)
		if serverState and light then
			serverState:GetAttributeChangedSignal("ServerCPS"):Connect(function()
				local cps = serverState:GetAttribute("ServerCPS") or 0
				TweenService:Create(light, TweenInfo.new(0.8), { Brightness = 1.5 + math.min(cps, 80) / 16 }):Play()
			end)
		end

		local currentStage = 0
		local function applyStage()
			local stage = Formulas.stageFor(State.progress().Rebirths)
			if stage.Id == currentStage then
				return
			end
			currentStage = stage.Id
			cap.Color = stage.Accent
			if light then
				light.Color = stage.Accent
			end
			if rim and rim:IsA("BasePart") then
				rim.Color = stage.Accent
			end
			if ring then
				for _, segment in ipairs(ring:GetChildren()) do
					if segment:IsA("BasePart") then
						segment.Color = stage.Accent
					end
				end
			end
		end
		State.subscribe("Progress", applyStage)
		State.onReady(applyStage)
	end)
end

return WorldFx
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="LocalScript" referent="120">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[--[[
	ClientMain (LocalScript)
	Location: StarterPlayer/StarterPlayerScripts/ClientMain

	Client entry point. Builds the interface at runtime (StarterGui stays
	empty on purpose: building UI in code keeps every screen in version
	control and lets it adapt to any screen size), connects the remotes and
	applies the player's settings.

	Dependencies: StarterPlayerScripts/Client/* (State, ClientNet, Hud, ScreenManager,
	Notifications, Orbs, InputController, WorldFx, ObbyClient, Tutorial, Screens/*), ReplicatedStorage/UI/*,
	ReplicatedStorage/Shared/*
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Client = script.Parent:WaitForChild("Client")
local Screens = Client:WaitForChild("Screens")
local UIFolder = ReplicatedStorage:WaitForChild("UI")

local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local SoundPlayer = require(UIFolder.SoundPlayer)
local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("GameConfig"))

local State = require(Client.State)
local ClientNet = require(Client.ClientNet)
local ScreenManager = require(Client.ScreenManager)
local Notifications = require(Client.Notifications)
local Hud = require(Client.Hud)
local Orbs = require(Client.Orbs)
local InputController = require(Client.InputController)
local WorldFx = require(Client.WorldFx)
local ObbyClient = require(Client.ObbyClient)
local Tutorial = require(Client.Tutorial)

local C = Theme.Colors

-- The game has no tools, so the backpack bar is hidden.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- Root ScreenGui and layers (bottom to top) -------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "ButtonAscensionUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 5
gui.Parent = playerGui

local layers = {}
for index, name in ipairs({ "Backdrop", "Hud", "Orbs", "Windows", "Fx", "Overlay", "Notifications" }) do
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.ZIndex = index
	frame.Parent = gui
	layers[name] = frame
end

-- The 3D world stays fully visible: players run around and do the obby while
-- they press (windows dim the world themselves while they are open).

local ctx = {
	Player = player,
	Gui = gui,
	Layers = layers,
	State = State,
	Net = ClientNet,
	Screens = ScreenManager,
	Notifications = Notifications,
	Hud = Hud,
}

-- Settings ------------------------------------------------------------------------------------
local screenObjects = {}
local function applySettings()
	local settings = State.get("Settings")
	if not settings then
		return
	end
	Theme.ReducedMotion = settings.ReducedMotion == true
	local scale = tonumber(settings.UIScale) or 1
	local scaleChanged = math.abs(scale - Theme.UserScale) > 1e-3
	Theme.UserScale = scale
	SoundPlayer.setVolumes(tonumber(settings.SFX) or 0.7, tonumber(settings.Music) or 0.4)
	if scaleChanged then
		Hud.layout()
		if Notifications.rescale then
			Notifications.rescale()
		end
		for _, screen in pairs(screenObjects) do
			screen.Window.Refit()
		end
	end
end
ctx.ApplySettings = applySettings

-- Build ---------------------------------------------------------------------------------------
Notifications.init(ctx)
Hud.init(ctx)
Orbs.init(ctx)

for _, id in ipairs({ "Shop", "Chests", "Inventory", "Collection", "Skills", "Quests", "Ascend", "Stats", "Store", "Settings" }) do
	local module = require(Screens:WaitForChild(id))
	local screen = module.new(ctx)
	screenObjects[id] = screen
	ScreenManager.register(id, screen)
end

InputController.init(ctx)
WorldFx.init(ctx)
ObbyClient.init(ctx)
Tutorial.init(ctx)

-- Loading screen ---------------------------------------------------------------------------------
local loading = UI.frame({ Name = "Loading", ZIndex = 200, Parent = layers.Overlay })
loading.BackgroundTransparency = 0
loading.BackgroundColor3 = C.Background
-- Swallow input so presses can't reach the button and HUD hidden behind it.
loading.Active = true
local title = UI.label({
	Text = string.upper(GameConfig.GameName),
	Font = Theme.Fonts.Display,
	TextSize = 42,
	TextXAlignment = Enum.TextXAlignment.Center,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.45),
	Size = UDim2.new(1, 0, 0, 50),
	ZIndex = 201,
	Parent = loading,
})
UI.stroke(title, { Color = C.Accent, Thickness = 2, Text = true })
local loadingText = UI.label({
	Text = "Loading your progress…",
	TextColor3 = C.TextDim,
	TextXAlignment = Enum.TextXAlignment.Center,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.fromScale(0.5, 0.52),
	Size = UDim2.new(1, 0, 0, 24),
	ZIndex = 201,
	Parent = loading,
})
local spinner = UI.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.fromScale(0.5, 0.58),
	Size = UDim2.fromOffset(36, 36),
	BackgroundTransparency = 1,
	ZIndex = 201,
	Corner = Theme.Radius.Pill,
	Parent = loading,
})
local spinnerStroke = UI.stroke(spinner, { Color = C.Accent, Thickness = 4 })
UI.gradient(spinnerStroke, {
	Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
	Rotation = 0,
})
local spin = RunService.RenderStepped:Connect(function(dt)
	spinner.Rotation = (spinner.Rotation + dt * 360) % 360
end)

task.delay(15, function()
	if not State.Ready then
		loadingText.Text = "Still loading… Roblox data services may be slow right now."
	end
end)

State.onReady(function()
	applySettings()
	SoundPlayer.startMusic()
	spin:Disconnect()
	local t = UI.tween(loading, { BackgroundTransparency = 1 }, Theme.Motion.Slow, true)
	title.Visible = false
	loadingText.Visible = false
	spinner.Visible = false
	if t then
		t.Completed:Wait()
	end
	loading:Destroy()
end)

-- Remotes ----------------------------------------------------------------------------------------
ClientNet.on("StateSync", function(kind, payload)
	State.apply(kind, payload)
end)
ClientNet.on("ClickResult", function(result)
	if type(result) == "table" and (result.Auto or result.Passive) and ScreenManager.isOpen() then
		return
	end
	Hud.onClickResult(result)
end)
ClientNet.on("Notify", Notifications.handle)
ClientNet.on("OrbSpawn", Orbs.spawn)
State.subscribe("Settings", applySettings)

-- The first snapshot may have arrived before this script connected; ask again if needed.
task.delay(2, function()
	if not State.Ready then
		ClientNet.action("RequestState")
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="121">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>