		return true, `Respawned {ctx.TargetName}.`
	end,
}

-- Bans ------------------------------------------------------------------------------------
-- Stored by UserId in ModerationStore and enforced in every server (AdminService
-- kicks banned players on join and when a ban arrives from another server).

local function durationText(seconds: number): string
	if seconds == 0 then
		return "permanently"
	end
	for _, unit in ipairs({ { 604800, "week" }, { 86400, "day" }, { 3600, "hour" }, { 60, "minute" } }) do
		local count = seconds / unit[1]
		if count >= 1 and count == math.floor(count) then
			return `for {count} {unit[2]}{if count == 1 then "" else "s"}`
		end
	end
	return "for " .. Format.time(seconds)
end

-- What a banned player sees when they are removed or try to join.
function AdminActions.banMessage(entry): string
	local length = if entry.Until == 0 then "permanently" else "until " .. os.date("!%Y-%m-%d %H:%M", entry.Until) .. " UTC"
	return `You are banned from {GameConfig.GameName} {length}. Reason: {entry.Reason}`
end

local function sessionNote(): string
	return if ModerationStore.Persistent then "" else " (temporary Studio session: not saved)"
end

A["players.ban"] = {
	Permission = "players.ban",
	Category = "punish",
	Target = "user",
	NoProfile = true,
	Punitive = true,
	Destructive = true,
	Validate = function(args, ctx)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		local seconds, derr = V.duration(args.Duration)
		if not seconds then
			return nil, derr
		end
		local maxDays = ctx.Limits.MaxBanDays or 0
		if maxDays ~= math.huge and (seconds == 0 or seconds > maxDays * 86400) then
			return nil, `Your role ({ctx.Role}) can ban for at most {maxDays} days.`
		end
		local reason, rerr = V.text(args.Reason, AdminConfig.Text.MaxReason, "A ban reason")
		if not reason then
			return nil, rerr
		end
		return { Target = target, Duration = seconds, Reason = reason }
	end,
	Describe = function(ctx, clean)
		return `Ban {ctx.TargetName} {durationText(clean.Duration)} from every server? Reason: "{clean.Reason}"`
	end,
	Run = function(ctx, clean)
		if ctx.TargetUserId == ctx.AdminId then
			return false, "You cannot ban yourself."
		end
		local existing = ModerationStore.activeBan(ctx.TargetUserId)
		if existing and existing.ByRank > AdminPermissions.rank(ctx.Role) then
			return false, `{ctx.TargetName} is already banned by higher-ranked staff ({existing.ByName}).`
		end
		-- Players and other staff see the reason, so only the filtered text is stored.
		local shown = filterBroadcast(clean.Reason, ctx.AdminId) or "Banned by staff."
		local now = os.time()
		local entry = {
			Name = ctx.TargetName,
			Reason = shown,
			By = ctx.AdminId,
			ByName = ctx.Admin.Name,
			ByRank = AdminPermissions.rank(ctx.Role),
			At = now,
			Until = if clean.Duration == 0 then 0 else now + clean.Duration,
		}
		-- On success AdminService (ModerationStore.onChanged) removes the player from
		-- this server at once; other servers follow when they hear about the change.
		local ok, err = ModerationStore.write("bans", ctx.TargetUserId, entry)
		if not ok then
			return false, err
		end
		local mirrored, mirrorErr =
			ModerationStore.robloxBan(ctx.TargetUserId, clean.Duration, shown, `Banned by {ctx.Admin.Name} (#{ctx.AdminId}): {clean.Reason}`)
		local note = if mirrored
			then " Roblox's ban system blocks them too."
			elseif mirrorErr ~= "off" then " (Roblox's ban system did not accept it; our ban list still applies.)"
			else ""
		return true, `Banned {ctx.TargetName} {durationText(clean.Duration)} from every server.{note}{sessionNote()}`
	end,
}

A["players.unban"] = {
	Permission = "players.ban",
	Category = "punish",
	Target = "user",
	NoProfile = true,
	Validate = function(args)
		local target, err = V.target(args.Target)
		return if target then { Target = target } else nil, err
	end,
	Run = function(ctx)
		local existing = ModerationStore.activeBan(ctx.TargetUserId)
		if not existing then
			return false, `{ctx.TargetName} is not banned.`
		end
		if existing.ByRank > AdminPermissions.rank(ctx.Role) then
			return false, `Only higher-ranked staff can lift this ban (banned by {existing.ByName}).`
		end
		local ok, err = ModerationStore.write("bans", ctx.TargetUserId, nil)
		if not ok then
			return false, err
		end
		ModerationStore.robloxUnban(ctx.TargetUserId)
		return true, `Unbanned {ctx.TargetName}.{sessionNote()}`
	end,
}

A["players.bans"] = {
	Quiet = true,
	Permission = "players.ban",
	Category = "read",
	Validate = function()
		return {}
	end,
	Run = function()
		local bans = ModerationStore.listBans()
		local lines = {}
		for i = 1, math.min(15, #bans) do
			local b = bans[i]
			local length = if b.Until == 0 then "permanent" else "until " .. os.date("!%Y-%m-%d %H:%M", b.Until) .. " UTC"
			table.insert(lines, `{b.Name} (#{b.UserId}) — {length} — by {b.ByName}: {b.Reason}`)
		end
		local text = if #bans == 0 then "Nobody is banned." else `{#bans} banned:\n` .. table.concat(lines, "\n")
		return true, text, { Bans = bans, Persistent = ModerationStore.Persistent }
	end,
}

-- Staff roles handed out in the game ------------------------------------------------------------
-- Only Owners (staff.manage). Roles from AdminConfig / place ownership always win and
-- cannot be changed here; "Owner" itself can never be handed out.

local function powersOf(role: string): string
	local parts = {}
	if AdminPermissions.has(role, "players.kick") then
		table.insert(parts, "kick")
	end
	if AdminPermissions.has(role, "players.freeze") then
		table.insert(parts, "freeze")
	end
	if AdminPermissions.has(role, "players.ban") then
		local days = AdminConfig.Roles[role].Limits.MaxBanDays
		table.insert(parts, if days == math.huge then "ban (any length)" else `ban (up to {days} days)`)
	end
	if AdminPermissions.has(role, "economy.grant") then
		table.insert(parts, "give currency and items")
	end
	if AdminPermissions.has(role, "server.events") then
		table.insert(parts, "start events")
	end
	return table.concat(parts, ", ")
end

A["staff.list"] = {
	Quiet = true,
	Permission = "staff.manage",
	Category = "read",
	Validate = function()
		return {}
	end,
	Run = function()
		local staff = ModerationStore.listStaff()
		local lines = {}
		for _, row in ipairs(staff) do
			table.insert(lines, `{row.Role}: {row.Name} (#{row.UserId}), given by {row.ByName}`)
		end
		local online = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local role = AdminPermissions.roleFor(p)
			if role then
				table.insert(online, {
					UserId = p.UserId,
					Name = p.Name,
					DisplayName = p.DisplayName,
					Role = role,
					Source = AdminPermissions.roleSource(p.UserId),
				})
			end
		end
		local text = if #staff == 0 then "Nobody has a role given in the game yet." else table.concat(lines, "\n")
		return true,
			text,
			{
				Staff = staff,
				Online = online,
				Grantable = AdminConfig.Moderation.GrantableRoles,
				Persistent = ModerationStore.Persistent,
			}
	end,
}

A["staff.setRole"] = {
	Permission = "staff.manage",
	Category = "staff",
	Target = "user",
	NoProfile = true,
	Destructive = true,
	Validate = function(args)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		local role, rerr = V.grantableRole(args.Role)
		if not role then
			return nil, rerr
		end
		return { Target = target, Role = role }
	end,
	Describe = function(ctx, clean)
		return `Make {ctx.TargetName} {clean.Role}? They will be able to {powersOf(clean.Role)}. You can remove the role at any time.`
	end,
	Run = function(ctx, clean)
		if ctx.TargetUserId == ctx.AdminId then
			return false, "You cannot change your own role."
		end
		local fixed = AdminPermissions.configRoleForUserId(ctx.TargetUserId)
		if fixed then
			return false, `{ctx.TargetName} is {fixed} through AdminConfig or place ownership; change it there.`
		end
		if ModerationStore.activeBan(ctx.TargetUserId) then
			return false, `{ctx.TargetName} is banned. Unban them first.`
		end
		if ModerationStore.staffRole(ctx.TargetUserId) == clean.Role then
			return false, `{ctx.TargetName} is already {clean.Role}.`
		end
		local ok, err = ModerationStore.write("staff", ctx.TargetUserId, {
			Role = clean.Role,
			Name = ctx.TargetName,
			By = ctx.AdminId,
			ByName = ctx.Admin.Name,
			At = os.time(),
		})
		if not ok then
			return false, err
		end
		return true, `{ctx.TargetName} is now {clean.Role} in every server.{sessionNote()}`
	end,
}

A["staff.removeRole"] = {
	Permission = "staff.manage",
	Category = "staff",
	Target = "user",
	NoProfile = true,
	Validate = function(args)
		local target, err = V.target(args.Target)
		return if target then { Target = target } else nil, err
	end,
	Run = function(ctx)
		local fixed = AdminPermissions.configRoleForUserId(ctx.TargetUserId)
		if fixed then
			return false, `{ctx.TargetName} is {fixed} through AdminConfig or place ownership; change it there.`
		end
		local current = ModerationStore.staffRole(ctx.TargetUserId)
		if not current then
			return false, `{ctx.TargetName} has no staff role.`
		end
		local ok, err = ModerationStore.write("staff", ctx.TargetUserId, nil)
		if not ok then
			return false, err
		end
		return true, `{ctx.TargetName} is no longer {current}.{sessionNote()}`
	end,
}

-- Economy ---------------------------------------------------------------------------------

local function economyValidate(allowZero: boolean)
	return function(args, ctx)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		local currency, cerr = V.currency(args.Currency or "Sparks")
		if not currency then
			return nil, cerr
		end
		local amount, aerr = V.amount(args.Amount, ctx.Limits.MaxCurrency, allowZero)
		if not amount then
			return nil, aerr
		end
		return { Target = target, Currency = currency, Amount = amount }
	end
end

A["economy.add"] = {
	Permission = "economy.grant",
	Category = "economy",
	Target = "any",
	Validate = economyValidate(false),
	Run = function(ctx, clean)
		local value = DataOps.addCurrency(ctx.TargetProfile.Data, clean.Currency, clean.Amount)
		ctx.Services.SyncService:MarkDirty(ctx.TargetProfile, "Currencies")
		return true, `Gave {Format.short(clean.Amount)} {clean.Currency} to {ctx.TargetName} (now {Format.short(value)}).`
	end,
	Offline = function(data, clean)
		local value = DataOps.addCurrency(data, clean.Currency, clean.Amount)
		return true, `Gave {Format.short(clean.Amount)} {clean.Currency} (now {Format.short(value)}).`
	end,
}

A["economy.remove"] = {
	Permission = "economy.grant",
	Category = "economy",
	Target = "any",
	Punitive = true,
	Validate = economyValidate(false),
	Run = function(ctx, clean)
		local value = DataOps.addCurrency(ctx.TargetProfile.Data, clean.Currency, -clean.Amount)
		ctx.Services.SyncService:MarkDirty(ctx.TargetProfile, "Currencies")
		return true, `Removed {Format.short(clean.Amount)} {clean.Currency} from {ctx.TargetName} (now {Format.short(value)}).`
	end,
	Offline = function(data, clean)
		local value = DataOps.addCurrency(data, clean.Currency, -clean.Amount)
		return true, `Removed {Format.short(clean.Amount)} {clean.Currency} (now {Format.short(value)}).`
	end,
}

A["economy.set"] = {
	Permission = "economy.grant",
	Category = "economy",
	Target = "any",
	Punitive = true,
	Validate = economyValidate(true),
	Run = function(ctx, clean)
		DataOps.setCurrency(ctx.TargetProfile.Data, clean.Currency, clean.Amount)
		ctx.Services.SyncService:MarkDirty(ctx.TargetProfile, "Currencies")
		return true, `Set {ctx.TargetName}'s {clean.Currency} to {Format.short(clean.Amount)}.`
	end,
	Offline = function(data, clean)
		DataOps.setCurrency(data, clean.Currency, clean.Amount)
		return true, `Set {clean.Currency} to {Format.short(clean.Amount)}.`
	end,
}

AdminActions.TestRewards = {
	gems_pack = { Name = "500 Gems", Reward = { Gems = 500 } },
	crate_bundle = { Name = "Crate bundle (5 Spark, 3 Neon, 1 Prism)", Reward = { Chests = { starter = 5, neon = 3, prism = 1 } } },
	frenzy = { Name = "Frenzy ×3 for 60 s" },
	orb = { Name = "Spawn a bonus orb now" },
	level_up = { Name = "XP for the next level" },
}
AdminActions.TestRewardOrder = { "gems_pack", "crate_bundle", "frenzy", "orb", "level_up" }

A["economy.reward"] = {
	Permission = "economy.grant",
	Category = "economy",
	Target = "online",
	Validate = function(args)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		local reward = Guard.id(args.Reward, AdminActions.TestRewards, 32)
		if not reward then
			return nil, "Unknown test reward."
		end
		return { Target = target, Reward = reward }
	end,
	Run = function(ctx, clean)
		local services = ctx.Services
		local profile = ctx.TargetProfile
		local def = AdminActions.TestRewards[clean.Reward]
		if def.Reward then
			services.EconomyService:GrantReward(profile, def.Reward, "admin")
		elseif clean.Reward == "frenzy" then
			services.StatsService:StartFrenzy(profile, 3, 60)
		elseif clean.Reward == "orb" then
			profile.Runtime.Orb = nil
			services.OrbService:_spawn(profile)
		elseif clean.Reward == "level_up" then
			local need = Formulas.xpForLevel(profile.Data.Level) - profile.Data.XP
			services.EconomyService:AddXP(profile, math.max(1, need))
		end
		services.Net.notify(ctx.TargetPlayer, "Reward", { Title = "Staff gift", Text = def.Name })
		return true, `Granted "{def.Name}" to {ctx.TargetName}.`
	end,
}

A["economy.reset"] = {
	Permission = "economy.reset",
	Category = "destructive",
	Target = "online",
	Punitive = true,
	Destructive = true,
	Validate = function(args)
		local target, err = V.target(args.Target)
		return if target then { Target = target } else nil, err
	end,
	Describe = function(ctx)
		return `Reset ALL currencies (Sparks, Gems, Prisms) of {ctx.TargetName} to 0?`
	end,
	Run = function(ctx)
		local data = ctx.TargetProfile.Data
		for _, currency in ipairs(GameConfig.CurrencyOrder) do
			DataOps.setCurrency(data, currency, 0)
		end
		ctx.Services.SyncService:MarkDirty(ctx.TargetProfile, "Currencies")
		return true, `Reset currencies of {ctx.TargetName}.`
	end,
}

-- Items and crates ------------------------------------------------------------------------

local function itemValidate(args, ctx)
	local target, err = V.target(args.Target)
	if not target then
		return nil, err
	end
	local item, ierr = V.lookup(args.Item, Items.ById, "item")
	if not item then
		return nil, ierr
	end
	local amount, aerr = V.amount(args.Amount or 1, ctx.Limits.MaxItems, false)
	if not amount then
		return nil, aerr
	end
	return { Target = target, Item = item, Amount = amount }
end

A["items.grant"] = {
	Permission = "items.grant",
	Category = "items",
	Target = "any",
	Validate = itemValidate,
	Run = function(ctx, clean)
		local isNew = DataOps.addItem(ctx.TargetProfile.Data, clean.Item, clean.Amount)
		if isNew then
			ctx.Services.Net.notify(ctx.TargetPlayer, "Discovery", { Item = clean.Item })
		end
		finish(ctx, "Inventory", "Discovered")
		return true, `Gave {clean.Amount}× {Items.ById[clean.Item].Name} to {ctx.TargetName}.`
	end,
	Offline = function(data, clean)
		DataOps.addItem(data, clean.Item, clean.Amount)
		return true, `Gave {clean.Amount}× {Items.ById[clean.Item].Name}.`
	end,
}

A["items.remove"] = {
	Permission = "items.grant",
	Category = "items",
	Target = "any",
	Punitive = true,
	Validate = itemValidate,
	Run = function(ctx, clean)
		local removed = DataOps.removeItem(ctx.TargetProfile.Data, clean.Item, clean.Amount)
		if removed == 0 then
			return false, `{ctx.TargetName} does not own that item.`
		end
		finish(ctx, "Inventory", "Equipped", "Favorites")
		return true, `Removed {removed}× {Items.ById[clean.Item].Name} from {ctx.TargetName}.`
	end,
	Offline = function(data, clean)
		local removed = DataOps.removeItem(data, clean.Item, clean.Amount)
		if removed == 0 then
			return false, "The player does not own that item."
		end
		return true, `Removed {removed}× {Items.ById[clean.Item].Name}.`
	end,
}

A["chests.grant"] = {
	Permission = "items.grant",
	Category = "items",
	Target = "any",
	Validate = function(args, ctx)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		local chest, cerr = V.lookup(args.Chest, Chests.ById, "crate")
		if not chest then
			return nil, cerr
		end
		local amount, aerr = V.amount(args.Amount or 1, ctx.Limits.MaxChests, false)
		if not amount then
			return nil, aerr
		end
		return { Target = target, Chest = chest, Amount = amount }
	end,
	Run = function(ctx, clean)
		DataOps.addChest(ctx.TargetProfile.Data, clean.Chest, clean.Amount)
		ctx.Services.SyncService:MarkDirty(ctx.TargetProfile, "Chests")
		return true, `Gave {clean.Amount}× {Chests.ById[clean.Chest].Name} to {ctx.TargetName}.`
	end,
	Offline = function(data, clean)
		DataOps.addChest(data, clean.Chest, clean.Amount)
		return true, `Gave {clean.Amount}× {Chests.ById[clean.Chest].Name}.`
	end,
}

A["items.simulate"] = {
	Permission = "items.test",
	Category = "test",
	Validate = function(args)
		local chest, cerr = V.lookup(args.Chest, Chests.ById, "crate")
		if not chest then
			return nil, cerr
		end
		local count, nerr = V.int(args.Count or 10000, 100, 100000, "Count")
		if not count then
			return nil, nerr
		end
		local luck = Guard.number(args.Luck or 0, 0, 10)
		if luck == nil then
			return nil, "Luck must be between 0 and 10 (0 = no bonus, 1 = +100%)."
		end
		return { Chest = chest, Count = count, Luck = luck, Pity = args.Pity == true }
	end,
	Run = function(ctx, clean)
		local chest = Chests.ById[clean.Chest]
		local counts = ctx.Services.ChestService:Simulate(clean.Chest, clean.Count, clean.Luck, clean.Pity)
		local expected = {}
		for _, entry in ipairs(Loot.effectiveWeights(chest, clean.Luck)) do
			expected[entry.Rarity] = entry.Chance
		end
		local parts = {}
		for _, rarityId in ipairs(Rarities.Order) do
			if expected[rarityId] then
				table.insert(parts, `{rarityId} {counts[rarityId]} ({Format.pct(counts[rarityId] / clean.Count, 2)} vs {Format.pct(expected[rarityId], 2)})`)
			end
		end
		return true,
			`Simulated {clean.Count} × {chest.Name} (luck +{Format.pct(clean.Luck)}, pity {if clean.Pity then "on" else "off"}). No player data changed.\n`
				.. table.concat(parts, "\n"),
			{ Counts = counts, Expected = expected, Count = clean.Count, Chest = clean.Chest }
	end,
}

A["items.forceRoll"] = {
	Permission = "items.test",
	Category = "test",
	Target = "online",
	Validate = function(args)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		local chest, cerr = V.lookup(args.Chest, Chests.ById, "crate")
		if not chest then
			return nil, cerr
		end
		local rarity, rerr = V.lookup(args.Rarity, Rarities.ById, "rarity")
		if not rarity then
			return nil, rerr
		end
		return { Target = target, Chest = chest, Rarity = rarity }
	end,
	Run = function(ctx, clean)
		local result, err = ctx.Services.ChestService:GrantForcedRarity(ctx.TargetProfile, clean.Chest, clean.Rarity)
		if not result then
			return false, err
		end
		return true, `Test drop for {ctx.TargetName}: {Items.ById[result.Item].Name} ({result.Rarity}). Real drop odds are unchanged.`, result
	end,
}

-- Progression ---------------------------------------------------------------------------------

A["progression.setUpgrade"] = {
	Permission = "progression.grant",
	Category = "progression",
	Target = "online",
	Punitive = true,
	Validate = function(args)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		local upgrade, uerr = V.lookup(args.Upgrade, Upgrades.ById, "upgrade")
		if not upgrade then
			return nil, uerr
		end
		local level, lerr = V.int(args.Level, 0, Upgrades.ById[upgrade].MaxLevel, "Level")
		if not level then
			return nil, lerr
		end
		return { Target = target, Upgrade = upgrade, Level = level }
	end,
	Run = function(ctx, clean)
		local data = ctx.TargetProfile.Data
		data.Upgrades[clean.Upgrade] = if clean.Level > 0 then clean.Level else nil
		finish(ctx, "Upgrades")
		return true, `Set {Upgrades.ById[clean.Upgrade].Name} of {ctx.TargetName} to level {clean.Level}.`
	end,
}

A["progression.unlockSkill"] = {
	Permission = "progression.grant",
	Category = "progression",
	Target = "online",
	Validate = function(args)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		if args.Skill == "all" then
			return { Target = target, Skill = "all" }
		end
		local skill, serr = V.lookup(args.Skill, Skills.ById, "skill")
		if not skill then
			return nil, serr
		end
		return { Target = target, Skill = skill }
	end,
	Run = function(ctx, clean)
		local data = ctx.TargetProfile.Data
		if clean.Skill == "all" then
			for _, node in ipairs(Skills.List) do
				data.Skills[node.Id] = node.MaxRank
			end
		else
			data.Skills[clean.Skill] = Skills.ById[clean.Skill].MaxRank
		end
		finish(ctx, "Skills", "Progress")
		local label = if clean.Skill == "all" then "every skill" else Skills.ById[clean.Skill].Name
		return true, `Unlocked {label} (max rank) for {ctx.TargetName}.`
	end,
}

A["progression.resetSkills"] = {
	Permission = "progression.reset",
	Category = "destructive",
	Target = "online",
	Punitive = true,
	Destructive = true,
	Validate = function(args)
		local target, err = V.target(args.Target)
		return if target then { Target = target } else nil, err
	end,
	Describe = function(ctx)
		return `Reset the skill tree of {ctx.TargetName}? Spent Skill Points are refunded.`
	end,
	Run = function(ctx)
		local result = ctx.Services.ProgressionService:ResetSkills(ctx.TargetProfile, true)
		if not result.ok then
			return false, result.err
		end
		return true, `Reset skills of {ctx.TargetName} ({result.Refunded} points refunded).`
	end,
}

A["progression.grantRebirth"] = {
	Permission = "progression.grant",
	Category = "progression",
	Target = "online",
	-- An ascension wipes the target's current run, so it is treated like a reset.
	Punitive = true,
	Destructive = true,
	Validate = function(args, ctx)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		local count, cerr = V.amount(args.Count or 1, ctx.Limits.MaxRebirths, false)
		if not count then
			return nil, cerr
		end
		return { Target = target, Count = count }
	end,
	Describe = function(ctx, clean)
		return `Grant {clean.Count} ascension(s) to {ctx.TargetName}? Their current run (Sparks, upgrades, level) resets as in a normal Ascension.`
	end,
	Run = function(ctx, clean)
		local profile = ctx.TargetProfile
		local progression = ctx.Services.ProgressionService
		local totalPrisms = 0
		for _ = 1, clean.Count do
			local data = profile.Data
			local stats = ctx.Services.StatsService:Get(profile)
			-- Grant the prisms an ascension at exactly the requirement would give.
			local prisms = Formulas.rebirthPrisms(Formulas.rebirthRequirement(data.Rebirths), data.Rebirths, stats.prismMultiplier)
			totalPrisms += prisms
			progression:ApplyRebirth(profile, prisms)
		end
		return true, `Granted {clean.Count} ascension(s) to {ctx.TargetName} (+{totalPrisms} Prisms). Their run was reset.`
	end,
}

A["progression.grantLevels"] = {
	Permission = "progression.grant",
	Category = "progression",
	Target = "online",
	Validate = function(args, ctx)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		local count, cerr = V.amount(args.Count or 1, ctx.Limits.MaxLevels, false)
		if not count then
			return nil, cerr
		end
		return { Target = target, Count = count }
	end,
	Run = function(ctx, clean)
		local profile = ctx.TargetProfile
		local data = profile.Data
		local before = data.Level
		for _ = 1, clean.Count do
			if data.Level >= GameConfig.Levels.MaxLevel then
				break
			end
			local need = Formulas.xpForLevel(data.Level) - data.XP
			ctx.Services.EconomyService:AddXP(profile, math.max(1, need))
		end
		return true, `{ctx.TargetName} went from level {before} to {data.Level}.`
	end,
}

A["progression.grantSkillPoints"] = {
	Permission = "progression.grant",
	Category = "progression",
	Target = "online",
	Validate = function(args, ctx)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		local amount, aerr = V.amount(args.Amount, ctx.Limits.MaxSkillPoints, false)
		if not amount then
			return nil, aerr
		end
		return { Target = target, Amount = amount }
	end,
	Run = function(ctx, clean)
		ctx.TargetProfile.Data.SkillPoints += clean.Amount
		ctx.Services.SyncService:MarkDirty(ctx.TargetProfile, "Progress")
		return true, `Gave {clean.Amount} Skill Points to {ctx.TargetName}.`
	end,
}

AdminActions.ResetScopes = {
	upgrades = "Shop upgrades",
	skills = "Skill tree (points refunded)",
	ascension = "Ascensions, Prisms and Ascension perks",
	inventory = "Inventory, equipped items and favourites",
	collection = "Discovered items and collection rewards",
	quests = "Daily quests, starter path and daily streak",
	stats = "Statistics",
	level = "Level, XP, Skill Points and skills",
	all = "EVERYTHING (fresh start; settings, Robux purchases and tutorial kept)",
}
AdminActions.ResetScopeOrder = { "upgrades", "skills", "ascension", "inventory", "collection", "quests", "stats", "level", "all" }

A["progression.reset"] = {
	Permission = "progression.reset",
	Category = "destructive",
	Target = "online",
	Punitive = true,
	Destructive = true,
	Validate = function(args)
		local target, err = V.target(args.Target)
		if not target then
			return nil, err
		end
		local scope = Guard.id(args.Scope or "all", AdminActions.ResetScopes, 16)
		if not scope then
			return nil, "Unknown reset scope. Use: " .. table.concat(AdminActions.ResetScopeOrder, ", ")
		end
		return { Target = target, Scope = scope }
	end,
	Describe = function(ctx, clean)
		return `Reset "{AdminActions.ResetScopes[clean.Scope]}" for {ctx.TargetName}? This cannot be undone.`
	end,
	Run = function(ctx, clean)
		local profile = ctx.TargetProfile
		local data = profile.Data
		local fresh = DataSchema.default()
		local scope = clean.Scope
		if scope == "upgrades" then
			table.clear(data.Upgrades)
		elseif scope == "skills" then
			data.SkillPoints += Formulas.skillPointsSpent(data)
			table.clear(data.Skills)
		elseif scope == "ascension" then
			data.Rebirths = 0
			table.clear(data.Ascension)
			DataOps.setCurrency(data, "Prisms", 0)
		elseif scope == "inventory" then
			table.clear(data.Inventory)
			table.clear(data.Equipped)
			table.clear(data.Favorites)
		elseif scope == "collection" then
			table.clear(data.Discovered)
			table.clear(data.CollectionClaimed)
			for id in pairs(data.Inventory) do
				data.Discovered[id] = os.time()
			end
		elseif scope == "quests" then
			data.Quests = fresh.Quests
			data.Daily = fresh.Daily
		elseif scope == "stats" then
			data.Stats = fresh.Stats
		elseif scope == "level" then
			data.Level = 1
			data.XP = 0
			data.SkillPoints = 0
			table.clear(data.Skills)
		elseif scope == "all" then
			-- Things bought with Robux are never reset: passes, running boosts, and the
			-- processed receipt ids (wiping those could grant a pending purchase twice).
			local KEEP = { "Settings", "Meta", "Passes", "Boosts", "Receipts", "PassRewards", "Tutorial" }
			local keep = {}
			for _, key in ipairs(KEEP) do
				keep[key] = data[key]
			end
			for key in pairs(data) do
				data[key] = nil
			end
			for key, value in pairs(fresh) do
				data[key] = value
			end
			for _, key in ipairs(KEEP) do
				if keep[key] ~= nil then
					data[key] = keep[key]
				end
			end
		end
		local services = ctx.Services
		services.QuestService:EnsureDaily(profile)
		services.StatsService:Invalidate(profile)
		services.SyncService:SendFull(profile)
		services.Net.notify(ctx.TargetPlayer, "Warning", { Text = "Some of your progress was reset by staff." })
		return true, `Reset {AdminActions.ResetScopes[scope]} for {ctx.TargetName}.`
	end,
}

-- Server management ------------------------------------------------------------------------------

A["server.announce"] = {
	Permission = "server.announce",
	Category = "announce",
	Validate = function(args, ctx)
		local message, err = V.text(args.Message, AdminConfig.Text.MaxAnnouncement, "A message")
		if not message then
			return nil, err
		end
		local scope = Guard.oneOf(args.Scope or "server", { "server", "global" })
		if not scope then
			return nil, "Scope must be server or global."
		end
		if scope == "global" then
			if not AdminConfig.CrossServerAnnouncements.Enabled then
				return nil, "Game-wide announcements are disabled in AdminConfig."
			end
			if not AdminPermissions.has(ctx.Role, "server.announce.global") then
				return nil, "Your role cannot send game-wide announcements."
			end
		end
		return { Message = message, Scope = scope }
	end,
	Run = function(ctx, clean)
		local filtered = filterBroadcast(clean.Message, ctx.AdminId)
		if not filtered then
			return false, "Roblox text filtering is unavailable right now; the announcement was not sent."
		end
		local from = ctx.Admin.DisplayName
		if clean.Scope == "global" then
			local ok, err = ctx.Services.AdminService:PublishGlobal(filtered, from, ctx.AdminId)
			if not ok then
				return false, "Could not reach other servers: " .. tostring(err)
			end
			return true, "Game-wide announcement sent to every server."
		end
		ctx.Services.Net.notifyAll("Announcement", { Text = filtered, From = from, Scope = "server" })
		return true, "Server-wide announcement sent (this server only)."
	end,
}

A["server.eventStart"] = {
	Permission = "server.events",
	Category = "events",
	Validate = function(args)
		local event, err = V.lookup(args.Event, GameConfig.Events.Definitions, "event")
		if not event then
			return nil, err
		end
		local duration, derr = V.int(
			args.Duration or GameConfig.Events.Definitions[event].DefaultDuration,
			GameConfig.Events.MinDuration,
			GameConfig.Events.MaxDuration,
			"Duration (seconds)"
		)
		if not duration then
			return nil, derr
		end
		return { Event = event, Duration = duration }
	end,
	Run = function(ctx, clean)
		return ctx.Services.EventService:StartEvent(clean.Event, clean.Duration, ctx.Admin.Name)
	end,
}

A["server.eventStop"] = {
	Permission = "server.events",
	Category = "events",
	Validate = function(args)
		local event, err = V.lookup(args.Event, GameConfig.Events.Definitions, "event")
		return if event then { Event = event } else nil, err
	end,
	Run = function(ctx, clean)
		return ctx.Services.EventService:StopEvent(clean.Event, ctx.Admin.Name)
	end,
}

-- Logs ----------------------------------------------------------------------------------------------

A["logs.recent"] = {
	Quiet = true,
	Permission = "logs.view",
	Category = "read",
	Validate = function(args)
		local filter = if args.Filter == nil then "" else Guard.string(args.Filter, 60)
		if filter == nil then
			return nil, "Filter is too long."
		end
		local result = if args.Result == nil then "all" else Guard.string(args.Result, 20)
		local limit = Guard.integer(args.Limit or 100, 1, 300) or 100
		return { Filter = filter, Result = result or "all", Limit = limit }
	end,
	Run = function(_, clean)
		local entries = AuditLog.recent(clean.Limit, clean.Filter, clean.Result)
		local lines = {}
		for i = 1, math.min(10, #entries) do
			local e = entries[i]
			table.insert(lines, `{os.date("!%H:%M:%S", e.Time)} {e.AdminName or "?"} {e.Action} {e.TargetName or ""} → {e.Result}`)
		end
		return true, if #lines > 0 then table.concat(lines, "\n") else "No matching log entries.", { Entries = entries }
	end,
}

A["logs.security"] = {
	Quiet = true,
	Permission = "logs.view",
	Category = "read",
	Validate = function()
		return {}
	end,
	Run = function(ctx)
		return true, "OK", { Entries = ctx.Services.SecurityService:GetRecent(100) }
	end,
}

A["logs.persisted"] = {
	Permission = "logs.persisted",
	Category = "read",
	Validate = function(args)
		local day = Guard.string(args.Day or os.date("!%Y-%m-%d"), 10, 10)
		if not day then
			return nil, "Use the format YYYY-MM-DD."
		end
		return { Day = day }
	end,
	Run = function(_, clean)
		local entries, err = AuditLog.loadDay(clean.Day)
		if not entries then
			return false, err
		end
		return true, `{#entries} persisted entries for {clean.Day}.`, { Entries = entries }
	end,
}

A["items.find"] = {
	Quiet = true,
	Permission = "panel.open",
	Category = "read",
	Validate = function(args)
		local query = Guard.string(args.Query or "", 40)
		return if query then { Query = string.lower(query) } else nil, "Search is too long."
	end,
	Run = function(_, clean)
		local found = {}
		for _, item in ipairs(Items.List) do
			if clean.Query == "" or string.find(string.lower(item.Id), clean.Query, 1, true) or string.find(string.lower(item.Name), clean.Query, 1, true) then
				table.insert(found, `{item.Id} — {item.Name} ({item.Rarity}, {Chests.ById[item.Chest].Name})`)
				if #found >= 15 then
					break
				end
			end
		end
		return true, if #found > 0 then table.concat(found, "\n") else "No items match."
	end,
}

return AdminActions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">AdminCommands</string>
          <string name="Source"><![CDATA[--[[
	AdminCommands (ModuleScript)
	Location: ServerScriptService/Admin/AdminCommands
	Depends on: Admin/AdminActions, Admin/AdminPermissions

	Parses command-bar text into an admin action + arguments. Parsing happens
	on the SERVER; the parsed action then goes through exactly the same
	permission, validation, confirmation, rate-limit and audit pipeline as
	panel buttons.

	Syntax:  [/admin] <command> <args...>
	  * Arguments are separated by spaces; use "double quotes" for spaces.
	  * Players: name / display name prefix, @username, #UserId, me.
	  * Numbers accept 1500, 1,500, 2.5k, 3m, 1b, 4t, 1e6.
	  * The last argument of kick/ban/announce takes the rest of the line.
	  * Ban lengths: 30m, 12h, 7d, 2w or perm.
]]

local AdminActions = require(script.Parent.AdminActions)
local AdminPermissions = require(script.Parent.AdminPermissions)

local AdminCommands = {}

-- Argument types: player, number, integer, word, rest
local COMMANDS = {
	{ Name = "help", Usage = "help [command]", Description = "List commands or show help for one.", Local = "help" },
	{ Name = "players", Usage = "players", Description = "List online players.", Action = "players.list" },
	{ Name = "stats", Usage = "stats <player>", Description = "Show a player's progression (#UserId works offline).", Action = "players.inspect", Args = { { "Target", "player" } } },
	{ Name = "givecash", Usage = "givecash <player> <amount> [currency]", Description = "Add Sparks (or Gems/Prisms).", Action = "economy.add", Args = { { "Target", "player" }, { "Amount", "number" }, { "Currency", "word", true } } },
	{ Name = "removecash", Usage = "removecash <player> <amount> [currency]", Description = "Remove currency.", Action = "economy.remove", Args = { { "Target", "player" }, { "Amount", "number" }, { "Currency", "word", true } } },
	{ Name = "setcash", Usage = "setcash <player> <amount> [currency]", Description = "Set a currency to an exact amount.", Action = "economy.set", Args = { { "Target", "player" }, { "Amount", "number" }, { "Currency", "word", true } } },
	{ Name = "givegems", Usage = "givegems <player> <amount>", Description = "Add Gems.", Action = "economy.add", Fixed = { Currency = "Gems" }, Args = { { "Target", "player" }, { "Amount", "number" } } },
	{ Name = "giveprisms", Usage = "giveprisms <player> <amount>", Description = "Add Prisms (ascension currency).", Action = "economy.add", Fixed = { Currency = "Prisms" }, Args = { { "Target", "player" }, { "Amount", "number" } } },
	{ Name = "reward", Usage = "reward <player> <gems_pack|crate_bundle|frenzy|orb|level_up>", Description = "Grant a test reward.", Action = "economy.reward", Args = { { "Target", "player" }, { "Reward", "word" } } },
	{ Name = "reseteconomy", Usage = "reseteconomy <player>", Description = "Reset all currencies (asks for confirmation).", Action = "economy.reset", Args = { { "Target", "player" } } },
	{ Name = "giveitem", Usage = "giveitem <player> <itemId> [amount]", Description = "Grant an item.", Action = "items.grant", Args = { { "Target", "player" }, { "Item", "word" }, { "Amount", "integer", true } } },
	{ Name = "removeitem", Usage = "removeitem <player> <itemId> [amount]", Description = "Remove copies of an item.", Action = "items.remove", Args = { { "Target", "player" }, { "Item", "word" }, { "Amount", "integer", true } } },
	{ Name = "givechest", Usage = "givechest <player> <chestId> [amount]", Description = "Grant crates.", Action = "chests.grant", Args = { { "Target", "player" }, { "Chest", "word" }, { "Amount", "integer", true } } },
	{ Name = "finditem", Usage = "finditem [search]", Description = "Search item ids.", Action = "items.find", Args = { { "Query", "rest", true } } },
	{ Name = "testroll", Usage = "testroll <chestId> [count] [luck]", Description = "Simulate crate odds without changing any data.", Action = "items.simulate", Args = { { "Chest", "word" }, { "Count", "integer", true }, { "Luck", "number", true } } },
	{ Name = "forceroll", Usage = "forceroll <player> <chestId> <rarity>", Description = "Grant a test drop of an exact rarity.", Action = "items.forceRoll", Args = { { "Target", "player" }, { "Chest", "word" }, { "Rarity", "word" } } },
	{ Name = "kick", Usage = "kick <player> <reason...>", Description = "Kick a player with a reason.", Action = "players.kick", Args = { { "Target", "player" }, { "Reason", "rest" } } },
	{ Name = "tp", Usage = "tp <player>", Description = "Teleport to a player.", Action = "players.teleportTo", Args = { { "Target", "player" } } },
	{ Name = "bring", Usage = "bring <player>", Description = "Bring a player to you.", Action = "players.bring", Args = { { "Target", "player" } } },
	{ Name = "freeze", Usage = "freeze <player>", Description = "Freeze a player.", Action = "players.freeze", Args = { { "Target", "player" } } },
	{ Name = "unfreeze", Usage = "unfreeze <player>", Description = "Unfreeze a player.", Action = "players.unfreeze", Args = { { "Target", "player" } } },
	{ Name = "respawn", Usage = "respawn <player>", Description = "Reset a player's character.", Action = "players.respawn", Args = { { "Target", "player" } } },
	{ Name = "ban", Usage = "ban <player> <30m|12h|7d|2w|perm> <reason...>", Description = "Ban from every server (also offline: #UserId or exact username). Asks for confirmation.", Action = "players.ban", Args = { { "Target", "player" }, { "Duration", "word" }, { "Reason", "rest" } } },
	{ Name = "unban", Usage = "unban <player|#UserId>", Description = "Lift a ban.", Action = "players.unban", Args = { { "Target", "player" } } },
	{ Name = "bans", Usage = "bans", Description = "List active bans.", Action = "players.bans" },
	{ Name = "setrole", Usage = "setrole <player> <moderator|admin>", Description = "Make someone Moderator or Admin in every server (asks for confirmation).", Action = "staff.setRole", Args = { { "Target", "player" }, { "Role", "word" } } },
	{ Name = "mod", Usage = "mod <player>", Description = "Make someone Moderator (asks for confirmation).", Action = "staff.setRole", Fixed = { Role = "Moderator" }, Args = { { "Target", "player" } } },
	{ Name = "removerole", Usage = "removerole <player>", Description = "Take away a staff role given in the game.", Action = "staff.removeRole", Args = { { "Target", "player" } } },
	{ Name = "staff", Usage = "staff", Description = "List staff roles given in the game.", Action = "staff.list" },
	{ Name = "announce", Usage = "announce <message...>", Description = "Server-wide announcement (this server only).", Action = "server.announce", Fixed = { Scope = "server" }, Args = { { "Message", "rest" } } },
	{ Name = "gannounce", Usage = "gannounce <message...>", Description = "Game-wide announcement (all servers).", Action = "server.announce", Fixed = { Scope = "global" }, Args = { { "Message", "rest" } } },
	{ Name = "event", Usage = "event <start|stop> <eventId> [seconds]", Description = "Start or stop a boost event in this server.", Special = "event" },
	{ Name = "setupgrade", Usage = "setupgrade <player> <upgradeId> <level>", Description = "Set a shop upgrade level.", Action = "progression.setUpgrade", Args = { { "Target", "player" }, { "Upgrade", "word" }, { "Level", "integer" } } },
	{ Name = "unlockskill", Usage = "unlockskill <player> <skillId|all>", Description = "Unlock skills for testing.", Action = "progression.unlockSkill", Args = { { "Target", "player" }, { "Skill", "word" } } },
	{ Name = "resetskills", Usage = "resetskills <player>", Description = "Reset a skill tree with refund (confirmation).", Action = "progression.resetSkills", Args = { { "Target", "player" } } },
	{ Name = "giverebirth", Usage = "giverebirth <player> [count]", Description = "Grant ascensions.", Action = "progression.grantRebirth", Args = { { "Target", "player" }, { "Count", "integer", true } } },
	{ Name = "givelevel", Usage = "givelevel <player> [count]", Description = "Grant levels.", Action = "progression.grantLevels", Args = { { "Target", "player" }, { "Count", "integer", true } } },
	{ Name = "givesp", Usage = "givesp <player> <amount>", Description = "Grant Skill Points.", Action = "progression.grantSkillPoints", Args = { { "Target", "player" }, { "Amount", "integer" } } },
	{ Name = "resetprogress", Usage = "resetprogress <player> [upgrades|skills|ascension|inventory|collection|quests|stats|level|all]", Description = "Reset progression (asks for confirmation).", Action = "progression.reset", Args = { { "Target", "player" }, { "Scope", "word", true } } },
	{ Name = "logs", Usage = "logs [filter]", Description = "Show recent audit log entries.", Action = "logs.recent", Args = { { "Filter", "rest", true } } },
	{ Name = "serverinfo", Usage = "serverinfo", Description = "Server performance and player stats.", Action = "server.stats" },
}

local BY_NAME = {}
for _, cmd in ipairs(COMMANDS) do
	BY_NAME[cmd.Name] = cmd
end
AdminCommands.List = COMMANDS

local SUFFIX = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18 }

function AdminCommands.parseNumber(text: string): number?
	local s = string.lower((string.gsub(text, ",", "")))
	local direct = tonumber(s)
	if direct then
		return direct
	end
	local num, suffix = string.match(s, "^(%-?[%d%.]+)(%a+)$")
	if num and SUFFIX[suffix] then
		local n = tonumber(num)
		if n then
			return n * SUFFIX[suffix]
		end
	end
	return nil
end

-- Splits text into tokens, honouring "double quotes". Returns tokens and the
-- raw remainder after each token (used for "rest" arguments).
function AdminCommands.tokenize(text: string): ({ string }, { string })
	local tokens, rests = {}, {}
	local i = 1
	local len = #text
	while i <= len do
		local c = string.sub(text, i, i)
		if string.match(c, "%s") then
			i += 1
		else
			table.insert(rests, string.sub(text, i))
			if c == '"' then
				local close = string.find(text, '"', i + 1, true)
				if close then
					table.insert(tokens, string.sub(text, i + 1, close - 1))
					i = close + 1
				else
					table.insert(tokens, string.sub(text, i + 1))
					i = len + 1
				end
			else
				local stop = string.find(text, "%s", i) or (len + 1)
				table.insert(tokens, string.sub(text, i, stop - 1))
				i = stop
			end
		end
	end
	return tokens, rests
end

function AdminCommands.available(role: string?)
	local out = {}
	for _, cmd in ipairs(COMMANDS) do
		local permission = "panel.open"
		if cmd.Action then
			permission = AdminActions.Definitions[cmd.Action].Permission
		elseif cmd.Special == "event" then
			permission = "server.events"
		end
		if AdminPermissions.has(role, permission) then
			table.insert(out, { Name = cmd.Name, Usage = cmd.Usage, Description = cmd.Description })
		end
	end
	return out
end

local function helpText(role: string?, name: string?): string
	if name then
		local cmd = BY_NAME[string.lower(name)]
		if not cmd then
			return `Unknown command "{name}". Type help for a list.`
		end
		return `{cmd.Usage}\n{cmd.Description}`
	end
	local lines = { "Commands available to your role (prefix /admin is optional):" }
	for _, cmd in ipairs(AdminCommands.available(role)) do
		table.insert(lines, "  " .. cmd.Usage)
	end
	return table.concat(lines, "\n")
end

--[[
	Parses a command line. Returns one of:
	  { Kind = "text", Text = "..." }                 (help output, no action)
	  { Kind = "action", Action = name, Args = {...} }
	  { Kind = "error", Text = "..." }
]]
function AdminCommands.parse(text: string, role: string?)
	local trimmed = string.gsub(text, "^%s*(.-)%s*$", "%1")
	trimmed = string.gsub(trimmed, "^/admin%s*", "")
	trimmed = string.gsub(trimmed, "^[/;:]", "")
	if trimmed == "" then
		return { Kind = "text", Text = helpText(role, nil) }
	end
	local tokens, rests = AdminCommands.tokenize(trimmed)
	local name = string.lower(tokens[1])
	local cmd = BY_NAME[name]
	if not cmd then
		return { Kind = "error", Text = `Unknown command "{tokens[1]}". Type help for a list.` }
	end
	if cmd.Local == "help" then
		return { Kind = "text", Text = helpText(role, tokens[2]) }
	end

	if cmd.Special == "event" then
		local verb = tokens[2] and string.lower(tokens[2])
		if (verb ~= "start" and verb ~= "stop") or not tokens[3] then
			return { Kind = "error", Text = "Usage: " .. cmd.Usage }
		end
		local args = { Event = tokens[3] }
		if verb == "start" and tokens[4] then
			local seconds = AdminCommands.parseNumber(tokens[4])
			if not seconds then
				return { Kind = "error", Text = `"{tokens[4]}" is not a number of seconds.` }
			end
			args.Duration = math.floor(seconds)
		end
		return { Kind = "action", Action = if verb == "start" then "server.eventStart" else "server.eventStop", Args = args }
	end

	local args = {}
	for key, value in pairs(cmd.Fixed or {}) do
		args[key] = value
	end
	local specs = cmd.Args or {}
	for index, spec in ipairs(specs) do
		local key, kind, optional = spec[1], spec[2], spec[3]
		local tokenIndex = index + 1
		local token = tokens[tokenIndex]
		if kind == "rest" then
			local rest = rests[tokenIndex]
			if rest == nil or rest == "" then
				if not optional then
					return { Kind = "error", Text = "Usage: " .. cmd.Usage }
				end
			else
				args[key] = rest
			end
			break
		end
		if token == nil then
			if not optional then
				return { Kind = "error", Text = "Usage: " .. cmd.Usage }
			end
		elseif kind == "number" or kind == "integer" then
			local n = AdminCommands.parseNumber(token)
			if not n then
				return { Kind = "error", Text = `"{token}" is not a valid number. Usage: {cmd.Usage}` }
			end
			if kind == "integer" and n ~= math.floor(n) then
				return { Kind = "error", Text = `"{token}" must be a whole number.` }
			end
			args[key] = n
		else
			args[key] = token
		end
	end
	if #tokens > #specs + 1 and (#specs == 0 or specs[#specs][2] ~= "rest") then
		return { Kind = "error", Text = "Too many arguments. Usage: " .. cmd.Usage }
	end
	return { Kind = "action", Action = cmd.Action, Args = args }
end

return AdminCommands
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">AdminConfig</string>
          <string name="Source"><![CDATA[--[[
	AdminConfig (ModuleScript)
	Location: ServerScriptService/Admin/AdminConfig

	SERVER-ONLY. ServerScriptService never replicates to clients, so nothing
	in this file can be read by players. Do not move it to ReplicatedStorage.

	================================================================
	HOW TO ADD AN ADMINISTRATOR SAFELY
	================================================================
	1. Find the person's Roblox UserId (a number that never changes):
	     * Open their profile on roblox.com. The URL looks like
	       https://www.roblox.com/users/123456789/profile — 123456789 is the UserId.
	     * Or, in Studio's Command Bar:
	       print(game:GetService("Players"):GetUserIdFromNameAsync("TheirUsername"))
	2. Add one line to AdminConfig.Users below, e.g.
	       [123456789] = "Admin",
	   Valid roles: "Owner", "Admin", "Moderator" (see Roles below).
	3. Publish the place. New servers use the new list; restart old servers
	   (Game Settings > ... > Shut Down All Servers) to apply it everywhere.

	EASIER: Owners can make people Moderator or Admin IN THE GAME, without
	editing this file: Admin Panel (F2) → Moderation tab, or the command
	"/admin setrole <player> moderator". Those roles are stored server-side
	by UserId (DataStore, see AdminConfig.Moderation) and apply in every
	server within seconds. Roles written in this file always win and cannot
	be changed from the game.

	Rules:
	  * Always use UserIds. Never usernames or display names — those can be
	    changed by their owner and could be taken by someone else.
	  * Give the lowest role that does the job. Moderators cannot touch the
	    economy; only Owners can reset progression or announce game-wide.
	  * Remove people who no longer help moderate.
	================================================================
]]

local AdminConfig = {}

-- [UserId] = "Owner" | "Admin" | "Moderator"
AdminConfig.Users = {
	-- [123456789] = "Owner",
	-- [987654321] = "Admin",
	-- [555555555] = "Moderator",
}

-- The Roblox user that owns the place is Owner automatically (user-owned games).
AdminConfig.AutoOwnerForCreator = true

-- For group-owned games, the owner of the group is Owner automatically.
-- (Verified server-side through the group service, never from the client.)
AdminConfig.GroupOwnerIsOwner = true

--[[
	STUDIO TESTING ONLY. Applied only when RunService:IsStudio() is true, so it
	can never grant anything in a live server. Studio's "Local Server" test
	mode creates players Player1, Player2, ... with UserIds -1, -2, ...
	This makes Player1 an Owner, Player2 an Admin, Player3 a Moderator and
	Player4+ normal players, so every permission level can be tested at once.
]]
AdminConfig.StudioTestUsers = {
	[-1] = "Owner",
	[-2] = "Admin",
	[-3] = "Moderator",
}

--[[
	STUDIO TESTING ONLY. A place opened from a file that has never been
	published has no owner (game.CreatorId is 0), so nobody would be Owner in
	Play Solo. With this on, the solo tester is Owner in that one situation.
	It never applies to published places or live servers.
]]
AdminConfig.StudioOwnerWhenUnpublished = true

--[[
	Permissions
	  panel.open               open the panel, dashboard, command bar, help
	  players.view             list online players and basic stats
	  players.inspect          full progression/inventory of a player
	  players.teleport         teleport to a player / bring a player
	  players.kick             kick with a reason
	  players.freeze           freeze / unfreeze
	  players.respawn          reset a character
	  economy.grant            add / remove / set currencies, test rewards
	  economy.reset            reset a player's currencies (destructive)
	  items.grant              grant / remove items and crates
	  items.test               simulate crate odds, forced-rarity test drops
	  progression.grant        upgrade levels, skills, ascensions, levels, skill points
	  progression.reset        reset progression sections (destructive)
	  server.announce          server-wide announcements
	  server.announce.global   game-wide announcements (all servers)
	  server.events            start / stop boost events
	  server.stats             server performance statistics
	  logs.view                audit and security logs of this server
	  logs.persisted           audit logs saved by all servers
	  offline.read             inspect players who are offline
	  offline.write            change data of offline players (verified, lock-checked)
	  players.ban              ban / unban players in every server (up to Limits.MaxBanDays)
	  staff.manage             make players Moderator or Admin in the game (Owner)
]]
AdminConfig.Roles = {
	Owner = {
		Rank = 3,
		Color = Color3.fromRGB(255, 196, 60),
		Permissions = { "*" },
		Limits = {
			MaxCurrency = 1e100,
			MaxItems = 1000,
			MaxChests = 1000,
			MaxRebirths = 100,
			MaxLevels = 500,
			MaxSkillPoints = 1000,
			-- math.huge = no limit; permanent bans allowed.
			MaxBanDays = math.huge,
		},
	},
	Admin = {
		Rank = 2,
		Color = Color3.fromRGB(0, 245, 160),
		Permissions = {
			"panel.open",
			"players.view",
			"players.inspect",
			"players.teleport",
			"players.kick",
			"players.freeze",
			"players.respawn",
			"players.ban",
			"economy.grant",
			"economy.reset",
			"items.grant",
			"items.test",
			"progression.grant",
			"server.announce",
			"server.events",
			"server.stats",
			"logs.view",
			"offline.read",
		},
		Limits = {
			MaxCurrency = 1e15,
			MaxItems = 100,
			MaxChests = 100,
			MaxRebirths = 5,
			MaxLevels = 50,
			MaxSkillPoints = 50,
			MaxBanDays = 30,
		},
	},
	Moderator = {
		Rank = 1,
		Color = Color3.fromRGB(80, 170, 255),
		Permissions = {
			"panel.open",
			"players.view",
			"players.inspect",
			"players.teleport",
			"players.kick",
			"players.freeze",
			"players.respawn",
			"players.ban",
			"server.announce",
			"server.stats",
			"logs.view",
		},
		Limits = {
			MaxCurrency = 0,
			MaxItems = 0,
			MaxChests = 0,
			MaxRebirths = 0,
			MaxLevels = 0,
			MaxSkillPoints = 0,
			MaxBanDays = 7,
		},
	},
}

-- Token buckets per admin. Capacity = burst size, Refill = tokens per second.
AdminConfig.RateLimits = {
	Global = { Capacity = 30, Refill = 3 },
	Categories = {
		read = { Capacity = 20, Refill = 4 },
		player = { Capacity = 10, Refill = 1 },
		punish = { Capacity = 5, Refill = 0.2 },
		economy = { Capacity = 10, Refill = 1 },
		items = { Capacity = 10, Refill = 1 },
		progression = { Capacity = 8, Refill = 0.5 },
		destructive = { Capacity = 3, Refill = 0.05 },
		announce = { Capacity = 3, Refill = 0.1 },
		events = { Capacity = 4, Refill = 0.1 },
		test = { Capacity = 5, Refill = 0.25 },
		staff = { Capacity = 5, Refill = 0.1 },
	},
}

-- Destructive actions must be confirmed with a single-use token within this time.
AdminConfig.ConfirmTokenSeconds = 45

AdminConfig.Text = {
	MaxAnnouncement = 200,
	MaxReason = 200,
	MaxCommand = 300,
}

AdminConfig.Audit = {
	Persist = true,
	StoreName = "ButtonAscension_AdminAudit",
	FlushInterval = 60,
	MaxEntriesPerDay = 1500,
	MemoryLimit = 500,
	-- Unauthorised attempts are logged at most this often per player (seconds).
	DeniedLogCooldown = 10,
}

-- Game-wide announcements use MessagingService. Only Owners have the
-- permission by default; receiving servers re-verify the sender's role.
AdminConfig.CrossServerAnnouncements = {
	Enabled = true,
	Topic = "ButtonAscension_Announce",
}

--[[
	In-game staff roles and bans. Both are stored by UserId in a server-only
	DataStore; servers tell each other about changes over MessagingService and
	then re-read the DataStore (message contents are never trusted).
]]
AdminConfig.Moderation = {
	StoreName = "ButtonAscension_Moderation",
	Topic = "ButtonAscension_Moderation",
	-- Every server also re-reads the lists this often, in case a message was lost.
	RefreshSeconds = 60,
	-- Roles an Owner can hand out in the game. "Owner" is deliberately not here.
	GrantableRoles = { "Moderator", "Admin" },
	MaxStaff = 100,
	MaxBans = 3000,
	-- How long a joining player waits for the ban list after a server starts.
	JoinCheckTimeout = 10,
	-- Also ban through Roblox's own Ban API (Players:BanAsync) in live servers.
	-- Roblox then blocks the player before they can even join, in every server,
	-- and the bans show up in the Creator Hub. Our own list stays the source of truth.
	UseRobloxBanApi = true,
	-- Let Roblox's Ban API also ban suspected alt accounts of the banned player.
	BanAltAccounts = false,
}

-- Key that toggles the panel on keyboards (the panel also has an on-screen button).
AdminConfig.PanelKey = "F2"

return AdminConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">AdminPermissions</string>
          <string name="Source"><![CDATA[--[[
	AdminPermissions (ModuleScript)
	Location: ServerScriptService/Admin/AdminPermissions
	Depends on: Admin/AdminConfig, Admin/ModerationStore

	Resolves a player's staff role from SERVER-SIDE data only and answers
	permission questions. Client-supplied values are never consulted.
	Order (first match wins):
	  1. Studio test list (Studio only)
	  2. AdminConfig.Users allowlist
	  3. place creator / group owner -> Owner
	  4. roles an Owner handed out in the game (ModerationStore, by UserId;
	     only Moderator or Admin, never Owner)
]]

local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local AdminConfig = require(script.Parent.AdminConfig)
local ModerationStore = require(script.Parent.ModerationStore)

local AdminPermissions = {}

-- Roles from config, creator and group ownership never change while a server runs.
local configCache: { [number]: string | false } = {}

local GROUP_RETRY_SECONDS = 30
local GROUP_WAIT_SECONDS = 30
local group = {
	Known = false, -- the lookup succeeded (OwnerId may still be nil for an ownerless group)
	OwnerId = nil :: number?,
	Running = false,
	FailedAt = -math.huge,
}

local function validRole(role: any): string?
	if type(role) == "string" and AdminConfig.Roles[role] then
		return role
	end
	if role ~= nil then
		warn("[AdminPermissions] Unknown role in AdminConfig: " .. tostring(role))
	end
	return nil
end

--[[
	Returns the owning group's owner UserId and whether that answer is known.
	Concurrent callers wait for the one lookup in flight instead of racing it,
	and a failed lookup is retried after GROUP_RETRY_SECONDS.
]]
local function lookupGroupOwner(): (number?, boolean)
	if game.CreatorType ~= Enum.CreatorType.Group or not AdminConfig.GroupOwnerIsOwner then
		return nil, true
	end
	local waitUntil = os.clock() + GROUP_WAIT_SECONDS
	while group.Running and os.clock() < waitUntil do
		task.wait(0.1)
	end
	if group.Known then
		return group.OwnerId, true
	end
	if group.Running or os.clock() - group.FailedAt < GROUP_RETRY_SECONDS then
		return nil, false
	end
	group.Running = true
	local ok, info = pcall(function()
		return GroupService:GetGroupInfoAsync(game.CreatorId)
	end)
	group.Running = false
	if ok and type(info) == "table" then
		group.Known = true
		group.OwnerId = if type(info.Owner) == "table" and type(info.Owner.Id) == "number" then info.Owner.Id else nil
		return group.OwnerId, true
	end
	group.FailedAt = os.clock()
	warn("[AdminPermissions] Group owner lookup failed; retrying later: " .. tostring(info))
	return nil, false
end

-- Role that comes from config, place creator or group owner (not changeable in game).
function AdminPermissions.configRoleForUserId(userId: number): string?
	local cached = configCache[userId]
	if cached ~= nil then
		return if cached == false then nil else cached
	end
	local role: string? = nil
	if RunService:IsStudio() then
		role = validRole(AdminConfig.StudioTestUsers[userId])
		if not role and AdminConfig.StudioOwnerWhenUnpublished and game.CreatorId == 0 and userId > 0 then
			role = "Owner"
		end
	end
	if not role then
		role = validRole(AdminConfig.Users[userId])
	end
	if not role and AdminConfig.AutoOwnerForCreator and game.CreatorType == Enum.CreatorType.User and userId == game.CreatorId and userId > 0 then
		role = "Owner"
	end
	local known = true
	if not role and game.CreatorType == Enum.CreatorType.Group then
		local owner
		owner, known = lookupGroupOwner()
		if owner and owner == userId then
			role = "Owner"
		end
	end
	-- Never cache "not staff" from a failed group lookup, or the owner stays locked out.
	if role or known then
		configCache[userId] = role or false
	end
	return role
end

-- Role for a UserId, or nil for normal players. May yield (group lookup).
function AdminPermissions.roleForUserId(userId: number): string?
	return AdminPermissions.configRoleForUserId(userId) or ModerationStore.staffRole(userId)
end

-- "config" (fixed in AdminConfig / place ownership), "game" (handed out in game) or nil.
function AdminPermissions.roleSource(userId: number): string?
	if AdminPermissions.configRoleForUserId(userId) then
		return "config"
	end
	return if ModerationStore.staffRole(userId) then "game" else nil
end

-- True while a failed group-owner lookup leaves some roles undecided.
function AdminPermissions.groupLookupPending(): boolean
	return game.CreatorType == Enum.CreatorType.Group and AdminConfig.GroupOwnerIsOwner and not group.Known
end

function AdminPermissions.roleFor(player: Player): string?
	return AdminPermissions.roleForUserId(player.UserId)
end

function AdminPermissions.roleDef(role: string?)
	return if role then AdminConfig.Roles[role] else nil
end

function AdminPermissions.rank(role: string?): number
	local def = AdminPermissions.roleDef(role)
	return if def then def.Rank else 0
end

function AdminPermissions.has(role: string?, permission: string): boolean
	local def = AdminPermissions.roleDef(role)
	if not def then
		return false
	end
	for _, p in ipairs(def.Permissions) do
		if p == "*" or p == permission then
			return true
		end
	end
	return false
end

function AdminPermissions.list(role: string?): { string }
	local def = AdminPermissions.roleDef(role)
	if not def then
		return {}
	end
	return table.clone(def.Permissions)
end

function AdminPermissions.limits(role: string?)
	local def = AdminPermissions.roleDef(role)
	return if def then def.Limits else AdminConfig.Roles.Moderator.Limits
end

Players.PlayerRemoving:Connect(function(player)
	configCache[player.UserId] = nil
end)

return AdminPermissions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">AdminService</string>
          <string name="Source"><![CDATA[--[[
	AdminService (ModuleScript)
	Location: ServerScriptService/Admin/AdminService
	Depends on: Admin/AdminConfig, Admin/AdminPermissions, Admin/AdminActions,
	            Admin/AdminCommands, Admin/AuditLog, Admin/PlayerResolver, Admin/ModerationStore,
	            Core/RateLimiter, Core/Guard, Shared/Remotes, ServerStorage/AdminClient,
	            DataService, SecurityService, Net

	The ONLY entry point for admin requests (RemoteFunction "Admin").
	Pipeline for every request, in order:
	  1. Role lookup from server-side config. Non-staff are rejected and the
	     attempt is logged (throttled) and flagged — the remote exists for
	     everyone, so direct exploit calls are expected and harmless.
	  2. Request shape validation (table, action name, unique RequestId).
	  3. Duplicate request rejection (RequestId replay protection).
	  4. Global and per-category rate limits per admin.
	  5. Permission check for the specific action.
	  6. Argument validation and limits (AdminActions.Validate).
	  7. Target resolution (unambiguous player, #UserId for offline tools, or
	     for bans/staff roles also an exact Roblox username).
	  8. Rank protection: punitive actions cannot target equal/higher staff.
	  9. Destructive actions return a single-use confirmation token instead of
	     running; only a matching "confirm" request from the same admin runs them.
	 10. Execution through the normal game services, then an audit record.

	The admin panel client lives in ServerStorage/AdminClient and is cloned
	into the PlayerGui of authorised staff only, so normal players never even
	receive its code. When an Owner hands out or removes a role in the game,
	the panel is delivered or taken away right away, in every server.

	Bans (ModerationStore) are enforced here: banned players are kicked when
	they join and as soon as a ban arrives from another server.
]]

local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Core = script.Parent.Parent.Core
local RateLimiter = require(Core.RateLimiter)
local Guard = require(Core.Guard)

local AdminConfig = require(script.Parent.AdminConfig)
local AdminPermissions = require(script.Parent.AdminPermissions)
local AdminActions = require(script.Parent.AdminActions)
local AdminCommands = require(script.Parent.AdminCommands)
local AuditLog = require(script.Parent.AuditLog)
local PlayerResolver = require(script.Parent.PlayerResolver)
local ModerationStore = require(script.Parent.ModerationStore)

local AdminService = { Name = "AdminService" }

local globalLimiter = RateLimiter.new(AdminConfig.RateLimits.Global.Capacity, AdminConfig.RateLimits.Global.Refill)
local categoryLimiters = {}
for name, rate in pairs(AdminConfig.RateLimits.Categories) do
	categoryLimiters[name] = RateLimiter.new(rate.Capacity, rate.Refill)
end

local seenRequests: { [number]: { ids: { [string]: number }, order: { string } } } = {}
local confirmTokens: { [string]: { AdminId: number, Action: string, Args: any, Expires: number } } = {}
local deniedLog: { [number]: number } = {}
-- Read-only requests (e.g. inspecting the same player while a tab refreshes) are
-- audited at most once per minute per admin/action/target to keep logs useful.
local readAudit: { [string]: number } = {}
local READ_AUDIT_COOLDOWN = 60
-- The role each online player's panel was built for, to notice role changes.
local deliveredRole: { [Player]: string | false } = {}

-- Actions that only need a live player, not their loaded data.
local NO_PROFILE_NEEDED = {
	["players.teleportTo"] = true,
	["players.bring"] = true,
	["players.kick"] = true,
	["players.freeze"] = true,
	["players.unfreeze"] = true,
	["players.respawn"] = true,
}

function AdminService:Init(services)
	self.Services = services
	Remotes.func("Admin").OnServerInvoke = function(player, request)
		local ok, response = pcall(self._handle, self, player, request)
		if not ok then
			warn("[AdminService] Request failed: " .. tostring(response))
			return { ok = false, err = "Internal error." }
		end
		return response
	end
end

function AdminService:Start()
	AuditLog.init(self.Services.DataService:IsPersistent())
	ModerationStore.init(self.Services.DataService:IsPersistent())
	ModerationStore.onChanged(function(kind)
		self:_onModerationChanged(kind)
	end)
	AuditLog.onRecord(function(entry)
		for _, player in ipairs(Players:GetPlayers()) do
			if AdminPermissions.has(AdminPermissions.roleFor(player), "logs.view") then
				self.Services.Net.fire(player, "AdminPush", "log", entry)
			end
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		self:_onPlayerAdded(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(self._onPlayerAdded, self, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		deliveredRole[player] = nil
		seenRequests[player.UserId] = nil
		deniedLog[player.UserId] = nil
		local prefix = tostring(player.UserId) .. ":"
		for key in pairs(readAudit) do
			if string.sub(key, 1, #prefix) == prefix then
				readAudit[key] = nil
			end
		end
		AdminActions.Frozen[player.UserId] = nil
		globalLimiter:reset(player.UserId)
		for _, limiter in pairs(categoryLimiters) do
			limiter:reset(player.UserId)
		end
	end)

	if AdminConfig.CrossServerAnnouncements.Enabled then
		task.spawn(function()
			local ok, err = pcall(function()
				MessagingService:SubscribeAsync(AdminConfig.CrossServerAnnouncements.Topic, function(message)
					self:_onGlobalAnnouncement(message)
				end)
			end)
			if not ok then
				warn("[AdminService] Game-wide announcements unavailable: " .. tostring(err))
			end
		end)
	end

	task.spawn(function()
		while true do
			task.wait(15)
			local now = os.clock()
			for token, entry in pairs(confirmTokens) do
				if now > entry.Expires then
					confirmTokens[token] = nil
				end
			end
		end
	end)
end

-- Panel delivery and per-player hooks ---------------------------------------------------

function AdminService:_onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(char)
		if AdminActions.Frozen[player.UserId] then
			char:WaitForChild("HumanoidRootPart", 10)
			AdminActions.applyFreeze(player, true)
		end
	end)
	-- Bans: right after a server starts, wait briefly for the list. If Roblox's data
	-- services are down the player is let in (Roblox's own Ban API still applies).
	ModerationStore.waitLoaded("bans", AdminConfig.Moderation.JoinCheckTimeout)
	local ban = ModerationStore.activeBan(player.UserId)
	if ban and player.Parent == Players then
		player:Kick(AdminActions.banMessage(ban))
		return
	end
	ModerationStore.waitLoaded("staff", AdminConfig.Moderation.JoinCheckTimeout)
	if player.Parent ~= Players then
		return
	end
	local role = AdminPermissions.roleFor(player)
	-- If Roblox could not tell us who owns the group yet, keep asking for a while
	-- so the group owner still receives the panel.
	local retries = 0
	while not role and retries < 6 and player.Parent == Players and AdminPermissions.groupLookupPending() do
		retries += 1
		task.wait(35)
		role = AdminPermissions.roleFor(player)
	end
	if player.Parent == Players and deliveredRole[player] == nil then
		deliveredRole[player] = role or false
	end
	if role and AdminPermissions.has(role, "panel.open") and player.Parent == Players then
		self:_givePanel(player)
		AuditLog.record({
			AdminId = player.UserId,
			AdminName = player.Name,
			Role = role,
			Action = "session.join",
			Result = "success",
			Message = "Staff member joined; panel delivered.",
		})
	end
end

function AdminService:_givePanel(player: Player)
	local source = ServerStorage:FindFirstChild("AdminClient")
	if not source then
		warn("[AdminService] ServerStorage/AdminClient is missing; the admin panel cannot be delivered.")
		return
	end
	local playerGui = player:WaitForChild("PlayerGui", 30)
	if not playerGui or playerGui:FindFirstChild("AdminPanelGui") then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "AdminPanelGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 50
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	for _, child in ipairs(source:GetChildren()) do
		child:Clone().Parent = gui
	end
	gui.Parent = playerGui
end

-- Moderation changes (from this or another server) ------------------------------------

function AdminService:_onModerationChanged(kind: string)
	for _, player in ipairs(Players:GetPlayers()) do
		if kind == "bans" then
			local ban = ModerationStore.activeBan(player.UserId)
			if ban then
				player:Kick(AdminActions.banMessage(ban))
			end
		else
			task.spawn(self._syncStaffRole, self, player)
		end
	end
end

-- Delivers, rebuilds or removes a player's admin panel after their role changed.
function AdminService:_syncStaffRole(player: Player)
	local before = deliveredRole[player]
	if before == nil then
		return -- still joining; _onPlayerAdded delivers the panel
	end
	local role = AdminPermissions.roleFor(player)
	if (role or false) == before or player.Parent ~= Players then
		return
	end
	deliveredRole[player] = role or false
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	local old = playerGui and playerGui:FindFirstChild("AdminPanelGui")
	if old then
		old:Destroy()
	end
	if role and AdminPermissions.has(role, "panel.open") then
		self:_givePanel(player)
		self.Services.Net.notify(player, "Toast", {
			Icon = "🛡️",
			Text = `You are now {role}! Open the admin panel with {AdminConfig.PanelKey} or the Admin button.`,
		})
	else
		self.Services.Net.notify(player, "Warning", { Text = "Your staff role was removed." })
	end
	AuditLog.record({
		AdminId = player.UserId,
		AdminName = player.Name,
		Role = role,
		Action = "session.role",
		Result = "success",
		Message = if role then `Role is now {role}; panel delivered.` else "Staff role removed; panel taken away.",
	})
end

function AdminService:CommandList(role: string?)
	return AdminCommands.available(role)
end

-- Request handling -------------------------------------------------------------------------

local function audit(admin: Player, role: string?, action: string, fields)
	local entry = {
		AdminId = admin.UserId,
		AdminName = admin.Name,
		Role = role,
		Action = action,
	}
	for k, v in pairs(fields) do
		entry[k] = v
	end
	return AuditLog.record(entry)
end

function AdminService:_logDenied(player: Player, action: any)
	self.Services.SecurityService:Flag(player, "AdminRemoteUnauthorized", tostring(action))
	local now = os.clock()
	local last = deniedLog[player.UserId]
	if last and now - last < AdminConfig.Audit.DeniedLogCooldown then
		return
	end
	deniedLog[player.UserId] = now
	audit(player, nil, if type(action) == "string" then string.sub(action, 1, 40) else "?", {
		Result = "denied",
		Message = "Unauthorised admin request from a non-staff player.",
	})
end

local function isDuplicate(userId: number, requestId: string): boolean
	local entry = seenRequests[userId]
	if not entry then
		entry = { ids = {}, order = {} }
		seenRequests[userId] = entry
	end
	if entry.ids[requestId] then
		return true
	end
	entry.ids[requestId] = os.clock()
	table.insert(entry.order, requestId)
	if #entry.order > 100 then
		local oldest = table.remove(entry.order, 1)
		entry.ids[oldest] = nil
	end
	return false
end

function AdminService:_handle(player: Player, request: any)
	local role = AdminPermissions.roleFor(player)
	local action = if type(request) == "table" then request.Action else nil
	if not role then
		self:_logDenied(player, action)
		return { ok = false, err = "Not authorized." }
	end
	if type(request) ~= "table" or type(action) ~= "string" or #action > 40 then
		audit(player, role, "?", { Result = "invalid", Message = "Malformed request." })
		return { ok = false, err = "Malformed request." }
	end
	local requestId = Guard.string(request.RequestId, 64, 8)
	if not requestId then
		audit(player, role, action, { Result = "invalid", Message = "Missing request id." })
		return { ok = false, err = "Malformed request." }
	end
	if isDuplicate(player.UserId, requestId) then
		audit(player, role, action, { Result = "duplicate", Message = "Duplicate request ignored." })
		return { ok = false, err = "Duplicate request ignored.", duplicate = true }
	end
	if not globalLimiter:allow(player.UserId) then
		audit(player, role, action, { Result = "rate_limited", Message = "Too many admin requests." })
		return { ok = false, err = "Slow down — too many admin requests." }
	end
	local args = if type(request.Args) == "table" then request.Args else {}

	if action == "command" then
		local text = Guard.string(args.Text, AdminConfig.Text.MaxCommand, 1)
		if not text then
			return { ok = false, err = "Command is empty or too long." }
		end
		local parsed = AdminCommands.parse(text, role)
		if parsed.Kind == "text" then
			return { ok = true, message = parsed.Text }
		elseif parsed.Kind == "error" then
			audit(player, role, "command", { Result = "invalid", Message = parsed.Text, Params = { Text = text } })
			return { ok = false, err = parsed.Text }
		end
		return self:Execute(player, role, parsed.Action, parsed.Args, { Via = "command" })
	elseif action == "confirm" then
		local token = Guard.string(args.Token, 64, 8)
		local entry = token and confirmTokens[token]
		if entry and os.clock() > entry.Expires then
			confirmTokens[token :: string] = nil
			entry = nil
		end
		-- A token only works for the admin it was issued to; someone else trying it
		-- is logged but does not invalidate it for its owner.
		if not entry or entry.AdminId ~= player.UserId then
			audit(player, role, "confirm", {
				Result = if entry then "denied" else "invalid",
				Message = if entry then "Confirmation token belongs to another admin." else "Confirmation expired or invalid.",
			})
			return { ok = false, err = "Confirmation expired. Run the action again." }
		end
		confirmTokens[token :: string] = nil
		return self:Execute(player, role, entry.Action, entry.Args, { Confirmed = true })
	elseif action == "cancel" then
		local token = Guard.string(args.Token, 64, 8)
		if token and confirmTokens[token] and confirmTokens[token].AdminId == player.UserId then
			confirmTokens[token] = nil
		end
		return { ok = true, message = "Cancelled." }
	end
	return self:Execute(player, role, action, args, {})
end

function AdminService:Execute(admin: Player, role: string, actionName: string, rawArgs: any, opts)
	local def = AdminActions.Definitions[actionName]
	local args = if type(rawArgs) == "table" then rawArgs else {}
	if not def then
		audit(admin, role, actionName, { Result = "invalid", Message = "Unknown action." })
		return { ok = false, err = "Unknown action." }
	end
	if not AdminPermissions.has(role, def.Permission) then
		audit(admin, role, actionName, { Result = "denied", Params = args, Message = "Missing permission " .. def.Permission })
		return { ok = false, err = `Your role ({role}) does not have permission for that.` }
	end
	if not opts.Confirmed then
		local limiter = categoryLimiters[def.Category] or categoryLimiters.read
		if not limiter:allow(admin.UserId) then
			audit(admin, role, actionName, { Result = "rate_limited", Params = args, Message = "Category limit: " .. def.Category })
			return { ok = false, err = "Slow down — that kind of action is rate limited." }
		end
	end

	local ctx = {
		Admin = admin,
		AdminId = admin.UserId,
		Role = role,
		Limits = AdminPermissions.limits(role),
		Services = self.Services,
	}

	local okValidate, clean, validateErr = pcall(def.Validate, args, ctx)
	if not okValidate or not clean then
		local message = if okValidate then validateErr or "Invalid arguments." else "Invalid arguments."
		audit(admin, role, actionName, { Result = "invalid", Params = args, Message = message })
		return { ok = false, err = message }
	end

	local offline = false
	if def.Target == "user" then
		-- Bans and staff roles only need a UserId; the person may be offline.
		local userId, label, online = PlayerResolver.resolveUser(clean.Target, admin)
		if not userId then
			audit(admin, role, actionName, { Result = "invalid", Params = args, Message = label })
			return { ok = false, err = label }
		end
		ctx.TargetUserId = userId
		ctx.TargetName = label
		ctx.TargetPlayer = online
		ctx.TargetProfile = if online then self.Services.DataService:GetProfile(online) else nil
	elseif def.Target then
		local target, resolveErr = PlayerResolver.resolve(clean.Target, admin)
		if target then
			ctx.TargetPlayer = target
			ctx.TargetUserId = target.UserId
			ctx.TargetName = if target.DisplayName ~= target.Name then `{target.DisplayName} (@{target.Name})` else target.Name
			ctx.TargetProfile = self.Services.DataService:GetProfile(target)
			if not ctx.TargetProfile and not NO_PROFILE_NEEDED[actionName] and not def.NoProfile then
				return { ok = false, err = "That player's data is still loading." }
			end
		elseif def.Target == "any" then
			local userId = if type(clean.Target) == "number" then clean.Target else PlayerResolver.parseUserId(clean.Target, true)
			if not userId then
				audit(admin, role, actionName, { Result = "invalid", Params = args, Message = resolveErr })
				return { ok = false, err = (resolveErr or "No such player.") .. " (Offline tools need #UserId.)" }
			end
			offline = true
			ctx.TargetUserId = userId
			ctx.TargetName = "#" .. tostring(userId)
		else
			audit(admin, role, actionName, { Result = "invalid", Params = args, Message = resolveErr })
			return { ok = false, err = resolveErr }
		end
	end

	if def.Target then
		if def.Punitive and ctx.TargetUserId ~= admin.UserId then
			local targetRole = AdminPermissions.roleForUserId(ctx.TargetUserId)
			if targetRole and AdminPermissions.rank(targetRole) >= AdminPermissions.rank(role) then
				audit(admin, role, actionName, {
					Result = "denied",
					TargetId = ctx.TargetUserId,
					TargetName = ctx.TargetName,
					Params = args,
					Message = "Target is staff of equal or higher rank.",
				})
				return { ok = false, err = "You cannot use that on staff of equal or higher rank." }
			end
		end
	end

	local auditBase = { TargetId = ctx.TargetUserId, TargetName = ctx.TargetName, Params = clean }

	if def.Destructive and not opts.Confirmed then
		local token = HttpService:GenerateGUID(false)
		-- Pin the resolved UserId so the confirmation cannot hit a different player
		-- (for example someone who joins with a matching name before it is confirmed).
		local pinned = table.clone(clean)
		if def.Target then
			pinned.Target = ctx.TargetUserId
		end
		confirmTokens[token] = {
			AdminId = admin.UserId,
			Action = actionName,
			Args = pinned,
			Expires = os.clock() + AdminConfig.ConfirmTokenSeconds,
		}
		local summary = if def.Describe then def.Describe(ctx, clean) else `Confirm {actionName}?`
		local fields = table.clone(auditBase)
		fields.Result = "confirm_required"
		fields.Message = summary
		audit(admin, role, actionName, fields)
		return { ok = false, needsConfirm = true, token = token, summary = summary, expires = AdminConfig.ConfirmTokenSeconds }
	end

	local success, message, data
	if offline then
		if def.ReadOffline then
			if not AdminPermissions.has(role, def.OfflinePermission or "offline.read") then
				success, message = false, "Your role cannot inspect offline players."
			else
				local stored, info = self.Services.DataService:ReadOffline(ctx.TargetUserId)
				if stored then
					success, message, data = def.ReadOffline(ctx.TargetUserId, stored)
					if info.locked then
						message ..= " (currently playing in another server)"
					end
				else
					success, message = false, "No readable data: " .. tostring(info.status)
				end
			end
		elseif def.Offline then
			if not AdminPermissions.has(role, "offline.write") then
				success, message = false, "That player is not online, and your role cannot edit offline players."
			else
				success, message = self.Services.DataService:UpdateOffline(ctx.TargetUserId, function(stored)
					return def.Offline(stored, clean, ctx)
				end)
				message = `Offline {ctx.TargetName}: {message}`
			end
		else
			success, message = false, "That action needs the player to be online in this server."
		end
	else
		local okRun, a, b, c = pcall(def.Run, ctx, clean)
		if okRun then
			success, message, data = a, b, c
		else
			warn(`[AdminService] {actionName} failed: {a}`)
			success, message = false, "The action failed on the server."
		end
	end

	local fields = table.clone(auditBase)
	fields.Result = if success then "success" else "error"
	fields.Message = message
	if opts.Confirmed then
		fields.Message = "(confirmed) " .. tostring(message)
	end
	if opts.Via == "command" then
		fields.Params = table.clone(clean)
		fields.Params.Via = "command"
	end
	-- Panel refresh requests (dashboard, lists) are frequent and reveal nothing; keep them out of the log.
	local shouldAudit = not def.Quiet
	if shouldAudit and def.Category == "read" and success then
		local key = `{admin.UserId}:{actionName}:{tostring(ctx.TargetUserId)}`
		local now = os.clock()
		if readAudit[key] and now - readAudit[key] < READ_AUDIT_COOLDOWN then
			shouldAudit = false
		else
			readAudit[key] = now
		end
	end
	if shouldAudit then
		audit(admin, role, actionName, fields)
	end
	return { ok = success == true, message = message, err = if success then nil else message, data = data }
end

-- Game-wide announcements --------------------------------------------------------------------

function AdminService:PublishGlobal(text: string, from: string, fromUserId: number): (boolean, string?)
	local payload = { Text = text, From = from, FromUserId = fromUserId, JobId = game.JobId, Time = os.time() }
	local ok, err = pcall(function()
		MessagingService:PublishAsync(AdminConfig.CrossServerAnnouncements.Topic, payload)
	end)
	if ok then
		self.Services.Net.notifyAll("Announcement", { Text = text, From = from, Scope = "global" })
		return true, nil
	end
	return false, tostring(err)
end

function AdminService:_onGlobalAnnouncement(message)
	local data = if type(message) == "table" then message.Data else nil
	if type(data) ~= "table" then
		return
	end
	if data.JobId == game.JobId then
		return
	end
	local text = Guard.string(data.Text, 600, 1)
	local from = Guard.string(data.From, 60, 1)
	local fromUserId = Guard.integer(data.FromUserId, -(2 ^ 52), 2 ^ 52)
	if not text or not from or not fromUserId then
		return
	end
	-- Defence in depth: the sender must be authorised by THIS server's config too.
	if not AdminPermissions.has(AdminPermissions.roleForUserId(fromUserId), "server.announce.global") then
		warn("[AdminService] Ignored a game-wide announcement from an unauthorised sender.")
		return
	end
	self.Services.Net.notifyAll("Announcement", { Text = text, From = from, Scope = "global" })
end

return AdminService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">AuditLog</string>
          <string name="Source"><![CDATA[--[[
	AuditLog (ModuleScript)
	Location: ServerScriptService/Admin/AuditLog
	Depends on: Admin/AdminConfig

	Records every admin request: who (UserId, name, role), what (action and
	sanitised parameters), whom (target UserId/name), when (unix time), and
	the result (success | denied | invalid | error | rate_limited |
	confirm_required | duplicate). Unauthorised attempts are recorded too.

	Entries live in a bounded in-memory buffer and are periodically appended
	to a DataStore key per UTC day ("Audit_YYYY-MM-DD") with UpdateAsync, so
	logs from every server end up in one place. Persistence failures are
	retried on the next flush and never block admin actions.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

local AdminConfig = require(script.Parent.AdminConfig)
local CONFIG = AdminConfig.Audit

local AuditLog = {
	Entries = {} :: { any },
	Pending = {} :: { any },
	Persisting = false,
	PersistAvailable = false,
	LastFlushError = nil :: string?,
	Listeners = {} :: { (any) -> () },
}

local counter = 0
local serverTag = string.sub(HttpService:GenerateGUID(false), 1, 8)
local store: DataStore? = nil

local SENSITIVE_KEYS = { Token = true, RequestId = true }

-- Converts parameters into a short, readable, bounded string.
function AuditLog.formatParams(params: any): string
	if type(params) ~= "table" then
		return ""
	end
	local keys = {}
	for k in pairs(params) do
		if type(k) == "string" and not SENSITIVE_KEYS[k] then
			table.insert(keys, k)
		end
	end
	table.sort(keys)
	local parts = {}
	for _, k in ipairs(keys) do
		local v = params[k]
		local text
		if type(v) == "table" then
			text = "{…}"
		else
			text = string.sub(tostring(v), 1, 80)
		end
		table.insert(parts, k .. "=" .. text)
		if #parts >= 8 then
			break
		end
	end
	return table.concat(parts, " ")
end

function AuditLog.init(persist: boolean)
	if CONFIG.Persist and persist then
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(CONFIG.StoreName)
		end)
		if ok then
			store = result
			AuditLog.PersistAvailable = true
		end
	end
	if AuditLog.PersistAvailable then
		task.spawn(function()
			while true do
				task.wait(CONFIG.FlushInterval)
				AuditLog.flush()
			end
		end)
		game:BindToClose(function()
			AuditLog.flush()
		end)
	end
end

--[[
	entry fields: AdminId, AdminName, Role, Action, TargetId, TargetName,
	Params (table), Result, Message
]]
function AuditLog.record(entry)
	counter += 1
	local record = {
		Id = serverTag .. "-" .. counter,
		Time = os.time(),
		AdminId = entry.AdminId,
		AdminName = entry.AdminName,
		Role = entry.Role or "None",
		Action = string.sub(tostring(entry.Action or "?"), 1, 60),
		TargetId = entry.TargetId,
		TargetName = entry.TargetName,
		Params = AuditLog.formatParams(entry.Params),
		Result = entry.Result or "success",
		Message = string.sub(tostring(entry.Message or ""), 1, 200),
		JobId = string.sub(game.JobId, 1, 12),
	}
	table.insert(AuditLog.Entries, record)
	if #AuditLog.Entries > CONFIG.MemoryLimit then
		table.remove(AuditLog.Entries, 1)
	end
	if AuditLog.PersistAvailable then
		table.insert(AuditLog.Pending, record)
		if #AuditLog.Pending > CONFIG.MaxEntriesPerDay then
			table.remove(AuditLog.Pending, 1)
		end
	end
	for _, listener in ipairs(AuditLog.Listeners) do
		task.spawn(listener, record)
	end
	return record
end

function AuditLog.onRecord(listener: (any) -> ())
	table.insert(AuditLog.Listeners, listener)
end

-- Recent entries, newest first, optionally filtered by text and result.
function AuditLog.recent(limit: number, filterText: string?, result: string?)
	local out = {}
	local needle = if filterText and filterText ~= "" then string.lower(filterText) else nil
	for i = #AuditLog.Entries, 1, -1 do
		local e = AuditLog.Entries[i]
		local matches = true
		if result and result ~= "" and result ~= "all" and e.Result ~= result then
			matches = false
		end
		if matches and needle then
			local hay = string.lower(
				table.concat({ e.Action, e.AdminName or "", e.TargetName or "", e.Params, e.Message, tostring(e.AdminId), tostring(e.TargetId or "") }, " ")
			)
			matches = string.find(hay, needle, 1, true) ~= nil
		end
		if matches then
			table.insert(out, e)
			if #out >= limit then
				break
			end
		end
	end
	return out
end

local function dayKey(t: number): string
	return "Audit_" .. os.date("!%Y-%m-%d", t)
end

function AuditLog.flush()
	if not store or AuditLog.Persisting or #AuditLog.Pending == 0 then
		return
	end
	AuditLog.Persisting = true
	-- Take the pending list; entries recorded while saving go into a fresh list.
	local taken = AuditLog.Pending
	AuditLog.Pending = {}
	-- Group pending entries by UTC day.
	local batches = {}
	for _, e in ipairs(taken) do
		local key = dayKey(e.Time)
		batches[key] = batches[key] or {}
		table.insert(batches[key], e)
	end
	local failed = {}
	for key, entries in pairs(batches) do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(key, function(existing)
				local list = if type(existing) == "table" then existing else {}
				for _, e in ipairs(entries) do
					table.insert(list, e)
				end
				while #list > CONFIG.MaxEntriesPerDay do
					table.remove(list, 1)
				end
				return list
			end)
		end)
		if not ok then
			AuditLog.LastFlushError = tostring(err)
			for _, e in ipairs(entries) do
				table.insert(failed, e)
			end
		end
	end
	-- Failed entries are retried on the next flush, ahead of newer ones.
	for _, e in ipairs(AuditLog.Pending) do
		table.insert(failed, e)
	end
	AuditLog.Pending = failed
	AuditLog.Persisting = false
end

-- Loads persisted entries for a UTC day "YYYY-MM-DD" (newest first).
function AuditLog.loadDay(day: string)
	if not store then
		return nil, "Persistent audit logs are unavailable in this session."
	end
	if not string.match(day, "^%d%d%d%d%-%d%d%-%d%d$") then
		return nil, "Use the format YYYY-MM-DD."
	end
	local ok, result = pcall(function()
		return (store :: DataStore):GetAsync("Audit_" .. day)
	end)
	if not ok then
		return nil, "DataStore error: " .. tostring(result)
	end
	local list = if type(result) == "table" then result else {}
	local out = {}
	for i = #list, math.max(1, #list - 199), -1 do
		table.insert(out, list[i])
	end
	return out
end

return AuditLog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">ModerationStore</string>
          <string name="Source"><![CDATA[--[[
	ModerationStore (ModuleScript)
	Location: ServerScriptService/Admin/ModerationStore
	Depends on: Admin/AdminConfig

	SERVER-ONLY storage for the two moderation lists that change while the game
	runs:
	  * Staff roles an Owner handed out in the game ([UserId] = Moderator | Admin)
	  * Bans ([UserId] = { Until, Reason, By, ... }; Until 0 = permanent)

	Both live in one DataStore (AdminConfig.Moderation.StoreName), keyed by
	UserId only. Writes use UpdateAsync, so two servers changing the lists at
	the same time never overwrite each other. After a write the server
	publishes "this list changed" over MessagingService; receiving servers do
	NOT trust the message and simply re-read the DataStore. Every server also
	re-reads both lists every RefreshSeconds in case a message is lost.

	Everything read from the DataStore is sanitised: unknown roles (including
	"Owner"), malformed ids and expired bans are dropped.

	Without DataStore access (Studio without API access) the lists are kept in
	memory for that session only and ModerationStore.Persistent is false.
]]

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local AdminConfig = require(script.Parent.AdminConfig)
local CONFIG = AdminConfig.Moderation

export type StaffEntry = { Role: string, Name: string, By: number, ByName: string, At: number }
export type BanEntry = {
	Name: string,
	Reason: string,
	By: number,
	ByName: string,
	ByRank: number,
	At: number,
	Until: number, -- unix time; 0 = permanent
}

local KEYS = { staff = "StaffRoles", bans = "Bans" }

local ModerationStore = {
	Staff = {} :: { [number]: StaffEntry },
	Bans = {} :: { [number]: BanEntry },
	Loaded = { staff = false, bans = false },
	Persistent = false,
	LastError = nil :: string?,
}

local store: DataStore? = nil
local listeners: { (string) -> () } = {}
local grantable: { [string]: boolean } = {}
for _, role in ipairs(CONFIG.GrantableRoles) do
	if role ~= "Owner" and AdminConfig.Roles[role] then
		grantable[role] = true
	end
end

-- Sanitising -------------------------------------------------------------------------------

local function text(value: any, max: number, fallback: string): string
	if type(value) == "string" and #value > 0 then
		return string.sub(value, 1, max)
	end
	return fallback
end

local function number(value: any): number
	return if type(value) == "number" and value == value and math.abs(value) < 2 ^ 53 then value else 0
end

local function userIdOf(key: any): number?
	local id = tonumber(key)
	if id and id == math.floor(id) and math.abs(id) < 2 ^ 53 then
		return id
	end
	return nil
end

local function cleanStaff(raw: any): { [number]: StaffEntry }
	local out = {}
	if type(raw) ~= "table" then
		return out
	end
	for key, entry in pairs(raw) do
		local userId = userIdOf(key)
		if userId and type(entry) == "table" and grantable[entry.Role] then
			out[userId] = {
				Role = entry.Role,
				Name = text(entry.Name, 60, "#" .. tostring(userId)),
				By = number(entry.By),
				ByName = text(entry.ByName, 60, "?"),
				At = number(entry.At),
			}
		end
	end
	return out
end

local function isActive(entry: BanEntry, now: number): boolean
	return entry.Until == 0 or entry.Until > now
end

local function cleanBans(raw: any, now: number): { [number]: BanEntry }
	local out = {}
	if type(raw) ~= "table" then
		return out
	end
	for key, entry in pairs(raw) do
		local userId = userIdOf(key)
		if userId and type(entry) == "table" then
			local clean: BanEntry = {
				Name = text(entry.Name, 60, "#" .. tostring(userId)),
				Reason = text(entry.Reason, 300, "Banned by staff."),
				By = number(entry.By),
				ByName = text(entry.ByName, 60, "?"),
				ByRank = number(entry.ByRank),
				At = number(entry.At),
				Until = math.max(0, number(entry.Until)),
			}
			if isActive(clean, now) then
				out[userId] = clean
			end
		end
	end
	return out
end

local function clean(kind: string, raw: any)
	return if kind == "staff" then cleanStaff(raw) else cleanBans(raw, os.time())
end

-- DataStore values are JSON: use string keys.
local function encode(map: { [number]: any }): { [string]: any }
	local out = {}
	for userId, entry in pairs(map) do
		out[tostring(userId)] = entry
	end
	return out
end

local function count(map): number
	local n = 0
	for _ in pairs(map) do
		n += 1
	end
	return n
end

-- Loading and change notifications -------------------------------------------------------------

local function notify(kind: string)
	for _, listener in ipairs(listeners) do
		task.spawn(listener, kind)
	end
end

local function apply(kind: string, raw: any)
	if kind == "staff" then
		ModerationStore.Staff = cleanStaff(raw)
	else
		ModerationStore.Bans = cleanBans(raw, os.time())
	end
end

-- Re-reads one list from the DataStore. Returns false if Roblox did not answer.
function ModerationStore.reload(kind: string): boolean
	if not store then
		return true
	end
	local ok, raw = pcall(function()
		return (store :: DataStore):GetAsync(KEYS[kind])
	end)
	if not ok then
		ModerationStore.LastError = tostring(raw)
		return false
	end
	apply(kind, raw)
	ModerationStore.Loaded[kind] = true
	notify(kind)
	return true
end

local function publish(kind: string)
	if not store then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:PublishAsync(CONFIG.Topic, { Kind = kind, JobId = game.JobId })
		end)
		if not ok then
			-- Other servers still pick the change up on their next periodic refresh.
			warn("[ModerationStore] Could not notify other servers: " .. tostring(err))
		end
	end)
end

function ModerationStore.onChanged(listener: (string) -> ())
	table.insert(listeners, listener)
end

function ModerationStore.init(persistent: boolean)
	if persistent then
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(CONFIG.StoreName)
		end)
		if ok then
			store = result
		else
			warn("[ModerationStore] DataStore unavailable: " .. tostring(result))
		end
	end
	ModerationStore.Persistent = store ~= nil
	if not store then
		-- Temporary session: start empty, keep changes in memory only.
		ModerationStore.Loaded.staff = true
		ModerationStore.Loaded.bans = true
		return
	end

	task.spawn(function()
		local attempt = 0
		while not (ModerationStore.Loaded.staff and ModerationStore.Loaded.bans) do
			for kind in pairs(KEYS) do
				if not ModerationStore.Loaded[kind] then
					ModerationStore.reload(kind)
				end
			end
			if ModerationStore.Loaded.staff and ModerationStore.Loaded.bans then
				break
			end
			attempt += 1
			warn(`[ModerationStore] Loading the moderation lists failed (attempt {attempt}); retrying.`)
			task.wait(math.min(30, 2 ^ attempt))
		end
	end)

	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(CONFIG.Topic, function(message)
				local data = if type(message) == "table" then message.Data else nil
				local kind = if type(data) == "table" then data.Kind else nil
				if type(kind) == "string" and KEYS[kind] and data.JobId ~= game.JobId then
					-- Never trust the message itself: re-read the DataStore.
					ModerationStore.reload(kind)
				end
			end)
		end)
		if not ok then
			warn("[ModerationStore] Live updates between servers unavailable: " .. tostring(err))
		end
	end)

	task.spawn(function()
		while true do
			task.wait(CONFIG.RefreshSeconds)
			for kind in pairs(KEYS) do
				ModerationStore.reload(kind)
			end
		end
	end)
end

-- Waits until a list has been loaded once (or the timeout passes).
function ModerationStore.waitLoaded(kind: string, timeout: number): boolean
	local deadline = os.clock() + timeout
	while not ModerationStore.Loaded[kind] and os.clock() < deadline do
		task.wait(0.2)
	end
	return ModerationStore.Loaded[kind]
end

-- Writing ------------------------------------------------------------------------------------------

--[[
	Sets (entry) or removes (nil) one user's entry in a list, atomically.
	Returns ok, error message. The caller has already checked permissions.
]]
function ModerationStore.write(kind: string, userId: number, entry: any): (boolean, string?)
	assert(KEYS[kind], "unknown moderation list")
	local limit = if kind == "staff" then CONFIG.MaxStaff else CONFIG.MaxBans
	if not store then
		local map = if kind == "staff" then ModerationStore.Staff else ModerationStore.Bans
		if entry ~= nil and map[userId] == nil and count(map) >= limit then
			return false, "The list is full."
		end
		local updated = table.clone(map)
		updated[userId] = entry
		apply(kind, encode(updated))
		notify(kind)
		return true, nil
	end

	local full = false
	local result = nil
	local ok, err = pcall(function()
		result = (store :: DataStore):UpdateAsync(KEYS[kind], function(raw)
			full = false
			local map = clean(kind, raw)
			if entry ~= nil and map[userId] == nil and count(map) >= limit then
				full = true
				return nil
			end
			map[userId] = entry
			return encode(map)
		end)
	end)
	if not ok then
		ModerationStore.LastError = tostring(err)
		return false, "Roblox data services did not respond, so nothing was changed. Try again in a moment."
	end
	if full then
		return false, "The list is full."
	end
	apply(kind, result)
	ModerationStore.Loaded[kind] = true
	notify(kind)
	publish(kind)
	return true, nil
end

-- Reading -------------------------------------------------------------------------------------------

-- Role handed out in the game, or nil.
function ModerationStore.staffRole(userId: number): string?
	local entry = ModerationStore.Staff[userId]
	return if entry then entry.Role else nil
end

-- The active ban for a user, or nil (expired bans count as no ban).
function ModerationStore.activeBan(userId: number): BanEntry?
	local entry = ModerationStore.Bans[userId]
	if entry and isActive(entry, os.time()) then
		return entry
	end
	return nil
end

function ModerationStore.listStaff(): { any }
	local out = {}
	for userId, entry in pairs(ModerationStore.Staff) do
		local row = table.clone(entry) :: any
		row.UserId = userId
		table.insert(out, row)
	end
	table.sort(out, function(a, b)
		if a.Role ~= b.Role then
			return a.Role < b.Role
		end
		return a.Name < b.Name
	end)
	return out
end

function ModerationStore.listBans(): { any }
	local out = {}
	local now = os.time()
	for userId, entry in pairs(ModerationStore.Bans) do
		if isActive(entry, now) then
			local row = table.clone(entry) :: any
			row.UserId = userId
			table.insert(out, row)
		end
	end
	table.sort(out, function(a, b)
		return a.At > b.At
	end)
	return out
end

function ModerationStore.isGrantable(role: any): boolean
	return type(role) == "string" and grantable[role] == true
end

-- Roblox Ban API mirror ---------------------------------------------------------------------------

local function robloxBanApiEnabled(): boolean
	return CONFIG.UseRobloxBanApi and not RunService:IsStudio() and store ~= nil
end

--[[
	Also bans through Players:BanAsync so Roblox blocks the user before they
	can join any server. Optional and best-effort: our own list stays the
	source of truth, so a failure here never undoes a ban.
]]
function ModerationStore.robloxBan(userId: number, seconds: number, displayReason: string, privateReason: string): (boolean, string?)
	if not robloxBanApiEnabled() then
		return false, "off"
	end
	local ok, err = pcall(function()
		(Players :: any):BanAsync({
			UserIds = { userId },
			ApplyToUniverse = true,
			Duration = if seconds == 0 then -1 else seconds,
			DisplayReason = string.sub(displayReason, 1, 400),
			PrivateReason = string.sub(privateReason, 1, 1000),
			ExcludeAltAccounts = not CONFIG.BanAltAccounts,
		})
	end)
	return ok, if ok then nil else tostring(err)
end

function ModerationStore.robloxUnban(userId: number): (boolean, string?)
	if not robloxBanApiEnabled() then
		return false, "off"
	end
	local ok, err = pcall(function()
		(Players :: any):UnbanAsync({ UserIds = { userId }, ApplyToUniverse = true })
	end)
	return ok, if ok then nil else tostring(err)
end

return ModerationStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">PlayerResolver</string>
          <string name="Source"><![CDATA[--[[
	PlayerResolver (ModuleScript)
	Location: ServerScriptService/Admin/PlayerResolver

	Safely turns admin input into exactly one online player.
	Resolution order (case-insensitive):
	  me              -> the admin
	  #12345          -> online player with that UserId (or a UserId for offline tools)
	  @name           -> exact username only
	  exact username  -> that player
	  exact display name, if unique
	  unique prefix of a username or display name
	Anything matching more than one player is rejected with the candidates
	listed, so a typo can never hit the wrong person.

	resolveUser() also finds people who are NOT in this server (for bans and
	staff roles): #UserId, or an exact Roblox username looked up through
	Players:GetUserIdFromNameAsync. The result is always a UserId; names are
	only used to find it and to label it.
]]

local Players = game:GetService("Players")

local PlayerResolver = {}

local function describe(p: Player): string
	if p.DisplayName ~= p.Name then
		return `{p.DisplayName} (@{p.Name})`
	end
	return "@" .. p.Name
end

local function listCandidates(list: { Player }): string
	local names = {}
	for i, p in ipairs(list) do
		if i > 5 then
			table.insert(names, "…")
			break
		end
		table.insert(names, describe(p))
	end
	return table.concat(names, ", ")
end

-- Parses "#123" (or a bare number when allowBare) into a UserId.
function PlayerResolver.parseUserId(query: string, allowBare: boolean?): number?
	local digits = string.match(query, "^#(%-?%d+)$")
	if not digits and allowBare then
		digits = string.match(query, "^(%-?%d+)$")
	end
	local id = digits and tonumber(digits)
	if id and math.abs(id) < 2 ^ 53 then
		return id
	end
	return nil
end

-- Returns (player, nil) or (nil, errorMessage, "ambiguous"?).
function PlayerResolver.resolve(query: any, requester: Player?): (Player?, string?, string?)
	if type(query) == "number" then
		local p = Players:GetPlayerByUserId(query)
		if p then
			return p, nil
		end
		return nil, `No online player has UserId {query}.`
	end
	if type(query) ~= "string" then
		return nil, "Specify a player."
	end
	local q = string.lower((string.gsub(query, "^%s*(.-)%s*$", "%1")))
	if q == "" or #q > 50 then
		return nil, "Specify a player."
	end
	if q == "me" then
		if requester then
			return requester, nil
		end
		return nil, "'me' is not available here."
	end

	local userId = PlayerResolver.parseUserId(q, false)
	if userId then
		local p = Players:GetPlayerByUserId(userId)
		if p then
			return p, nil
		end
		return nil, `No online player has UserId {userId}.`
	end

	local exactOnly = false
	if string.sub(q, 1, 1) == "@" then
		q = string.sub(q, 2)
		exactOnly = true
	end

	local all = Players:GetPlayers()
	for _, p in ipairs(all) do
		if string.lower(p.Name) == q then
			return p, nil
		end
	end
	if exactOnly then
		return nil, `No online player is named @{q}.`
	end

	local displayMatches = {}
	for _, p in ipairs(all) do
		if string.lower(p.DisplayName) == q then
			table.insert(displayMatches, p)
		end
	end
	if #displayMatches == 1 then
		return displayMatches[1], nil
	elseif #displayMatches > 1 then
		return nil, `"{query}" matches several display names: {listCandidates(displayMatches)}. Use @username or #UserId.`, "ambiguous"
	end

	local prefixMatches = {}
	for _, p in ipairs(all) do
		local name = string.lower(p.Name)
		local display = string.lower(p.DisplayName)
		if string.sub(name, 1, #q) == q or string.sub(display, 1, #q) == q then
			table.insert(prefixMatches, p)
		end
	end
	if #prefixMatches == 1 then
		return prefixMatches[1], nil
	elseif #prefixMatches > 1 then
		return nil, `"{query}" is ambiguous: {listCandidates(prefixMatches)}. Type more of the name, @username or #UserId.`, "ambiguous"
	end
	return nil, `No online player matches "{query}".`
end

PlayerResolver.describe = describe

--[[
	Resolves someone who may be offline. Returns (userId, label, onlinePlayer?)
	or (nil, errorMessage). Online players in this server win; ambiguous
	online matches are never "fixed" by a username lookup.
]]
function PlayerResolver.resolveUser(query: any, requester: Player?): (number?, string?, Player?)
	local player, err, kind = PlayerResolver.resolve(query, requester)
	if player then
		return player.UserId, describe(player), player
	end
	if kind == "ambiguous" then
		return nil, err
	end
	local userId: number? = nil
	if type(query) == "number" and query == math.floor(query) and math.abs(query) < 2 ^ 53 then
		userId = query
	elseif type(query) == "string" then
		local q = string.gsub(query, "^%s*(.-)%s*$", "%1")
		userId = PlayerResolver.parseUserId(q, false)
		if not userId then
			local name = string.match(q, "^@?([%w_]+)$")
			if name and #name >= 3 and #name <= 20 then
				local ok, result = pcall(function()
					return Players:GetUserIdFromNameAsync(name)
				end)
				if ok and type(result) == "number" then
					return result, "@" .. name, nil
				end
				return nil, `No Roblox user is named "{name}" (or Roblox did not answer). Use #UserId.`
			end
		end
	end
	if not userId then
		return nil, err or "Specify a player."
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId :: number)
	end)
	local label = if ok and type(name) == "string" then `@{name} (#{userId})` else `#{userId}`
	return userId, label, nil
end

return PlayerResolver
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="42">
      <Properties>
        <string name="Name">Core</string>
      </Properties>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">DataOps</string>
          <string name="Source"><![CDATA[--[[
	DataOps (ModuleScript)
	Location: ServerScriptService/Core/DataOps
	Depends on: ReplicatedStorage/Shared/Config/*

	Pure, non-yielding mutations of a player data table. Used by the online
	services AND by DataService:UpdateOffline (inside UpdateAsync transform
	functions, which must not yield). Every function clamps its inputs so a
	caller can never push data out of range.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local GameConfig = require(Config.GameConfig)
local Items = require(Config.Items)
local Chests = require(Config.Chests)

local DataOps = {}

local function finite(v: number): boolean
	return v == v and v ~= math.huge and v ~= -math.huge
end

-- Adds (or subtracts, when negative) currency. Returns the new balance.
function DataOps.addCurrency(data, currency: string, amount: number): number
	assert(GameConfig.Currencies[currency], "Unknown currency " .. tostring(currency))
	assert(type(amount) == "number" and finite(amount), "Invalid amount")
	local current = data.Currencies[currency] or 0
	local value = math.clamp(current + amount, 0, GameConfig.CurrencyCap)
	data.Currencies[currency] = value
	return value
end

function DataOps.setCurrency(data, currency: string, value: number): number
	assert(GameConfig.Currencies[currency], "Unknown currency " .. tostring(currency))
	assert(type(value) == "number" and finite(value), "Invalid amount")
	local v = math.clamp(value, 0, GameConfig.CurrencyCap)
	data.Currencies[currency] = v
	return v
end

-- Adds copies of an item. Returns true when the item was newly discovered.
function DataOps.addItem(data, itemId: string, count: number, timestamp: number?): boolean
	assert(Items.ById[itemId], "Unknown item " .. tostring(itemId))
	assert(count >= 1 and count == math.floor(count), "Invalid item count")
	local current = data.Inventory[itemId] or 0
	data.Inventory[itemId] = math.min(GameConfig.Inventory.MaxStack, current + count)
	local isNew = data.Discovered[itemId] == nil
	if isNew then
		data.Discovered[itemId] = timestamp or os.time()
	end
	return isNew
end

-- Removes up to `count` copies. Unequips/unfavourites when none remain.
-- Returns the number actually removed.
function DataOps.removeItem(data, itemId: string, count: number): number
	local current = data.Inventory[itemId] or 0
	local removed = math.clamp(math.floor(count), 0, current)
	local remaining = current - removed
	if remaining <= 0 then
		data.Inventory[itemId] = nil
		data.Favorites[itemId] = nil
		for i = #data.Equipped, 1, -1 do
			if data.Equipped[i] == itemId then
				table.remove(data.Equipped, i)
			end
		end
	else
		data.Inventory[itemId] = remaining
	end
	return removed
end

function DataOps.addChest(data, chestId: string, count: number): number
	assert(Chests.ById[chestId], "Unknown crate " .. tostring(chestId))
	assert(count >= 1 and count == math.floor(count), "Invalid crate count")
	local value = math.min(1e9, (data.Chests[chestId] or 0) + count)
	data.Chests[chestId] = value
	return value
end

function DataOps.removeChest(data, chestId: string, count: number): number
	local current = data.Chests[chestId] or 0
	local removed = math.clamp(math.floor(count), 0, current)
	local remaining = current - removed
	data.Chests[chestId] = if remaining > 0 then remaining else nil
	return removed
end

-- Drops equipped items beyond the allowed slot count.
function DataOps.trimEquipped(data, slots: number)
	while #data.Equipped > slots do
		table.remove(data.Equipped)
	end
end

return DataOps
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">DataSchema</string>
          <string name="Source"><![CDATA[--[[
	DataSchema (ModuleScript)
	Location: ServerScriptService/Core/DataSchema
	Depends on: ReplicatedStorage/Shared/Config/*

	Defines the persisted player data format, its version, migrations from
	older versions, and sanitisation of loaded data.

	sanitize() rebuilds the data from scratch using only known keys, valid
	types and clamped ranges, so corrupted or tampered values can never reach
	the game. Item ids that no longer exist in the config are moved to
	LegacyInventory instead of being deleted, and are restored automatically
	if the item returns.

	Version history
	  1  Pre-release format: Inventory was an array of item ids (one entry per
	     copy) and Settings had a single "Volume" value.
	  2  Current format: Inventory is a map itemId -> count; Settings has
	     separate Music and SFX volumes, plus newer settings. Later additions
	     that need no migration (missing sections start empty): Passes (owned
	     game passes, a cache re-checked on every join), Boosts (seconds left
	     on bought timed boosts), Receipts (processed purchase IDs),
	     PassRewards (one-time rewards of game passes already granted), Obby
	     (obstacle course progress) and Tutorial (first-time tutorial; data
	     saved before the tutorial existed counts as already finished).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local GameConfig = require(Config.GameConfig)
local Items = require(Config.Items)
local Chests = require(Config.Chests)
local Upgrades = require(Config.Upgrades)
local Ascension = require(Config.Ascension)
local Skills = require(Config.Skills)
local Achievements = require(Config.Achievements)
local Quests = require(Config.Quests)
local Rewards = require(Config.Rewards)
local GamePasses = require(Config.GamePasses)
local DevProducts = require(Config.DevProducts)
local Obby = require(Config.Obby)
local Tutorial = require(Config.Tutorial)

local DataSchema = {}

DataSchema.CURRENT_VERSION = 2

DataSchema.StatKeys = {
	"TotalClicks",
	"AutoClicks",
	"LifetimeSparks",
	"SparksThisRun",
	"BestRunSparks",
	"ChestsOpened",
	"TotalCrits",
	"HighestCombo",
	"GoldenClicks",
	"UpgradesPurchased",
	"LegendariesFound",
	"MythicsFound",
	"SecretsFound",
	"ItemsSold",
	"QuestsCompleted",
	"OrbsCollected",
	"PlayTime",
	"GemsEarned",
	"PrismsEarned",
	"BestDailyStreak",
	"StreakBursts",
	"OfflineEarned",
	"ItemsFused",
	"RainbowsFound",
}

-- Top-level sections replicated to the owning client (see SyncService).
DataSchema.Sections = {
	"Currencies",
	"Progress",
	"Upgrades",
	"Ascension",
	"Skills",
	"Inventory",
	"Favorites",
	"Equipped",
	"Discovered",
	"Chests",
	"Pity",
	"Stats",
	"Achievements",
	"CollectionClaimed",
	"Quests",
	"Daily",
	"Settings",
	"Passes",
	"Boosts",
	"PassRewards",
	"Obby",
	"Tutorial",
}

local function defaultSettings()
	local settings = {}
	for key, def in pairs(GameConfig.Settings) do
		settings[key] = def.Default
	end
	return settings
end

function DataSchema.default()
	local stats = {}
	for _, key in ipairs(DataSchema.StatKeys) do
		stats[key] = 0
	end
	return {
		Version = DataSchema.CURRENT_VERSION,
		Currencies = { Sparks = 0, Gems = 0, Prisms = 0 },
		Level = 1,
		XP = 0,
		SkillPoints = 0,
		Rebirths = 0,
		Upgrades = {},
		Ascension = {},
		Skills = {},
		Inventory = {},
		LegacyInventory = {},
		Favorites = {},
		Equipped = {},
		Discovered = {},
		Chests = {},
		Pity = {},
		Stats = stats,
		Achievements = {},
		CollectionClaimed = {},
		Quests = {
			Day = -1,
			Daily = {},
			BonusClaimed = false,
			StarterIndex = 1,
			StarterProgress = 0,
		},
		Daily = { LastClaimDay = -1, Streak = 0 },
		Settings = defaultSettings(),
		-- [passKey] = true for owned game passes (written only by GamePassService).
		Passes = {},
		-- [productKey] = seconds left on a bought timed boost.
		Boosts = {},
		-- Purchase IDs of processed developer-product receipts (oldest first, bounded).
		Receipts = {},
		-- [productKey] = true once the one-time reward of a game pass was granted.
		PassRewards = {},
		-- Obstacle course progress (written only by ObbyService).
		Obby = { Stage = 0, Best = 0, Completions = 0, Checkpoints = 0 },
		-- First-time tutorial (written only by TutorialService). Base holds the
		-- counters at the moment the current step started.
		Tutorial = { Step = 1, Done = false, Skipped = false, Rewarded = false, Base = 0 },
		Meta = { Created = os.time(), LastSave = 0, LastSeen = 0, Sessions = 0 },
	}
end

-- Migrations ------------------------------------------------------------------
-- MIGRATIONS[n] upgrades data from version n to version n + 1.
local MIGRATIONS = {}

MIGRATIONS[1] = function(data)
	-- Inventory array of ids -> map of counts.
	if type(data.Inventory) == "table" and #data.Inventory > 0 then
		local counts = {}
		for _, id in ipairs(data.Inventory) do
			if type(id) == "string" then
				counts[id] = (counts[id] or 0) + 1
			end
		end
		data.Inventory = counts
	end
	-- Single volume -> separate music and sound effect volumes.
	if type(data.Settings) == "table" and type(data.Settings.Volume) == "number" then
		data.Settings.Music = data.Settings.Volume
		data.Settings.SFX = data.Settings.Volume
		data.Settings.Volume = nil
	end
	data.Version = 2
	return data
end

-- Returns migrated data and whether any migration ran. Data from a NEWER
-- version than this server knows is returned untouched with ok = false so
-- the caller can refuse to overwrite it.
function DataSchema.migrate(data): (any, boolean, boolean)
	if type(data) ~= "table" then
		return data, true, false
	end
	local version = if type(data.Version) == "number" then data.Version else 1
	if version > DataSchema.CURRENT_VERSION then
		return data, false, false
	end
	local migrated = false
	while version < DataSchema.CURRENT_VERSION do
		local step = MIGRATIONS[version]
		assert(step, "Missing migration from version " .. version)
		data = step(data)
		version = data.Version
		migrated = true
	end
	return data, true, migrated
end

-- Sanitisation ---------------------------------------------------------------------

local function isFinite(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function num(value, min, max, default)
	if not isFinite(value) then
		return default
	end
	return math.clamp(value, min, max)
end

local function int(value, min, max, default)
	if not isFinite(value) then
		return default
	end
	return math.clamp(math.floor(value), min, max)
end

local function tbl(value)
	return if type(value) == "table" then value else {}
end

function DataSchema.sanitize(raw)
	local issues = {}
	local d = DataSchema.default()
	if type(raw) ~= "table" then
		table.insert(issues, "data was not a table; using defaults")
		return d, issues
	end

	local cap = GameConfig.CurrencyCap
	local currencies = tbl(raw.Currencies)
	for _, currency in ipairs(GameConfig.CurrencyOrder) do
		d.Currencies[currency] = num(currencies[currency], 0, cap, 0)
	end

	d.Level = int(raw.Level, 1, GameConfig.Levels.MaxLevel, 1)
	d.XP = num(raw.XP, 0, cap, 0)
	d.SkillPoints = int(raw.SkillPoints, 0, 1e9, 0)
	d.Rebirths = int(raw.Rebirths, 0, 1e6, 0)

	for id, level in pairs(tbl(raw.Upgrades)) do
		local def = Upgrades.ById[id]
		if def then
			local v = int(level, 0, def.MaxLevel, 0)
			if v > 0 then
				d.Upgrades[id] = v
			end
		else
			table.insert(issues, "dropped unknown upgrade " .. tostring(id))
		end
	end

	for id, level in pairs(tbl(raw.Ascension)) do
		local def = Ascension.ById[id]
		if def then
			local v = int(level, 0, def.MaxLevel, 0)
			if v > 0 then
				d.Ascension[id] = v
			end
		else
			table.insert(issues, "dropped unknown ascension upgrade " .. tostring(id))
		end
	end

	for id, rank in pairs(tbl(raw.Skills)) do
		local def = Skills.ById[id]
		if def then
			local v = int(rank, 0, def.MaxRank, 0)
			if v > 0 then
				d.Skills[id] = v
			end
		else
			table.insert(issues, "dropped unknown skill " .. tostring(id))
		end
	end

	local maxStack = GameConfig.Inventory.MaxStack
	-- Items that were legacy before but exist again are restored first.
	for id, count in pairs(tbl(raw.LegacyInventory)) do
		if type(id) == "string" and #id <= 64 then
			local c = int(count, 0, maxStack, 0)
			if c > 0 then
				if Items.ById[id] then
					d.Inventory[id] = math.min(maxStack, (d.Inventory[id] or 0) + c)
				else
					d.LegacyInventory[id] = c
				end
			end
		end
	end
	for id, count in pairs(tbl(raw.Inventory)) do
		if type(id) == "string" and #id <= 64 then
			local c = int(count, 0, maxStack, 0)
			if c > 0 then
				if Items.ById[id] then
					d.Inventory[id] = math.min(maxStack, (d.Inventory[id] or 0) + c)
				else
					d.LegacyInventory[id] = math.min(maxStack, (d.LegacyInventory[id] or 0) + c)
					table.insert(issues, "moved unknown item to legacy inventory " .. id)
				end
			end
		end
	end

	for id, fav in pairs(tbl(raw.Favorites)) do
		if fav == true and d.Inventory[id] then
			d.Favorites[id] = true
		end
	end

	local seen = {}
	for _, id in ipairs(tbl(raw.Equipped)) do
		if type(id) == "string" and d.Inventory[id] and not seen[id] and #d.Equipped < GameConfig.Equip.MaxSlots then
			seen[id] = true
			table.insert(d.Equipped, id)
		end
	end

	for id, t in pairs(tbl(raw.Discovered)) do
		if Items.ById[id] then
			d.Discovered[id] = num(t, 0, 1e12, os.time())
		end
	end
	-- Anything owned is discovered by definition.
	for id in pairs(d.Inventory) do
		if not d.Discovered[id] then
			d.Discovered[id] = os.time()
		end
	end

	for id, count in pairs(tbl(raw.Chests)) do
		if Chests.ById[id] then
			local c = int(count, 0, 1e9, 0)
			if c > 0 then
				d.Chests[id] = c
			end
		end
	end

	for id, pity in pairs(tbl(raw.Pity)) do
		local chest = Chests.ById[id]
		if chest and type(pity) == "table" then
			local entry = {}
			for rarityId in pairs(chest.Pity) do
				entry[rarityId] = int(pity[rarityId], 0, 1e6, 0)
			end
			d.Pity[id] = entry
		end
	end

	local stats = tbl(raw.Stats)
	for _, key in ipairs(DataSchema.StatKeys) do
		d.Stats[key] = num(stats[key], 0, cap, 0)
	end

	for id, t in pairs(tbl(raw.Achievements)) do
		if Achievements.ById[id] then
			d.Achievements[id] = num(t, 0, 1e12, os.time())
		end
	end

	for id, claimed in pairs(tbl(raw.CollectionClaimed)) do
		if claimed == true and Rewards.CollectionById[id] then
			d.CollectionClaimed[id] = true
		end
	end

	local quests = tbl(raw.Quests)
	d.Quests.Day = int(quests.Day, -1, 1e7, -1)
	d.Quests.BonusClaimed = quests.BonusClaimed == true
	d.Quests.StarterIndex = int(quests.StarterIndex, 1, #Quests.Starter + 1, 1)
	d.Quests.StarterProgress = num(quests.StarterProgress, 0, cap, 0)
	local dailyOk = type(quests.Daily) == "table" and #quests.Daily <= Quests.DailyCount
	if dailyOk then
		for _, q in ipairs(quests.Daily) do
			if type(q) ~= "table" or not Quests.DailyById[q.Id] then
				dailyOk = false
				break
			end
			table.insert(d.Quests.Daily, {
				Id = q.Id,
				Target = num(q.Target, 1, cap, 1),
				Progress = num(q.Progress, 0, cap, 0),
				Claimed = q.Claimed == true,
			})
		end
	end
	if not dailyOk then
		-- Regenerated by QuestService for the current day.
		d.Quests.Day = -1
		d.Quests.Daily = {}
		d.Quests.BonusClaimed = false
		table.insert(issues, "reset malformed daily quests")
	end

	local daily = tbl(raw.Daily)
	d.Daily.LastClaimDay = int(daily.LastClaimDay, -1, 1e7, -1)
	d.Daily.Streak = int(daily.Streak, 0, 1e6, 0)

	local settings = tbl(raw.Settings)
	for key, def in pairs(GameConfig.Settings) do
		local value = settings[key]
		if type(def.Default) == "boolean" then
			d.Settings[key] = if type(value) == "boolean" then value else def.Default
		elseif type(def.Default) == "number" then
			d.Settings[key] = num(value, def.Min, def.Max, def.Default)
		end
	end

	for key, owned in pairs(tbl(raw.Passes)) do
		if owned == true and GamePasses.ByKey[key] then
			d.Passes[key] = true
		end
	end

	for key, left in pairs(tbl(raw.Boosts)) do
		local product = DevProducts.ByKey[key]
		if product and product.Boost then
			local seconds = num(left, 0, DevProducts.MaxBoostSeconds, 0)
			if seconds > 0 then
				d.Boosts[key] = seconds
			end
		end
	end

	for key, granted in pairs(tbl(raw.PassRewards)) do
		if granted == true and DevProducts.ByKey[key] then
			d.PassRewards[key] = true
		end
	end

	local receipts = tbl(raw.Receipts)
	local first = math.max(1, #receipts - DevProducts.ReceiptHistory + 1)
	for i = first, #receipts do
		local id = receipts[i]
		if type(id) == "string" and #id > 0 and #id <= 100 then
			table.insert(d.Receipts, id)
		end
	end

	local obby = tbl(raw.Obby)
	d.Obby.Best = int(obby.Best, 0, Obby.StageCount, 0)
	-- A run in progress can never be past the last checkpoint (finishing resets it to 0).
	d.Obby.Stage = math.min(int(obby.Stage, 0, Obby.StageCount - 1, 0), d.Obby.Best)
	d.Obby.Completions = int(obby.Completions, 0, 1e9, 0)
	d.Obby.Checkpoints = int(obby.Checkpoints, 0, 1e12, 0)

	local tutorial = raw.Tutorial
	if type(tutorial) == "table" then
		d.Tutorial.Step = int(tutorial.Step, 1, #Tutorial.Steps, 1)
		d.Tutorial.Done = tutorial.Done == true
		d.Tutorial.Skipped = tutorial.Skipped == true
		d.Tutorial.Rewarded = tutorial.Rewarded == true
		d.Tutorial.Base = num(tutorial.Base, 0, cap, 0)
	elseif type(raw.Meta) == "table" and int(raw.Meta.Sessions, 0, 1e9, 0) > 0 then
		-- Saved before the tutorial existed: an experienced player, don't start it.
		d.Tutorial.Done = true
		d.Tutorial.Skipped = true
	end

	local meta = tbl(raw.Meta)
	d.Meta.Created = num(meta.Created, 0, 1e12, os.time())
	d.Meta.LastSave = num(meta.LastSave, 0, 1e12, 0)
	d.Meta.LastSeen = num(meta.LastSeen, 0, 1e12, 0)
	d.Meta.Sessions = int(meta.Sessions, 0, 1e9, 0)

	return d, issues
end

return DataSchema
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">Guard</string>
          <string name="Source"><![CDATA[--[[
	Guard (ModuleScript)
	Location: ServerScriptService/Core/Guard

	Validation helpers for values that arrive from clients. Every helper
	returns the validated value, or nil when the input is unacceptable.
	Client input is never trusted: types, ranges and lengths are all checked.
]]

local Guard = {}

local function isFinite(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- A string of at most maxLength characters (and at least minLength).
function Guard.string(value: any, maxLength: number, minLength: number?): string?
	if type(value) ~= "string" then
		return nil
	end
	local len = #value
	if len > maxLength or len < (minLength or 0) then
		return nil
	end
	return value
end

-- An integer within [min, max].
function Guard.integer(value: any, min: number, max: number): number?
	if not isFinite(value) or value ~= math.floor(value) then
		return nil
	end
	if value < min or value > max then
		return nil
	end
	return value
end

-- A finite number within [min, max].
function Guard.number(value: any, min: number, max: number): number?
	if not isFinite(value) then
		return nil
	end
	if value < min or value > max then
		return nil
	end
	return value
end

function Guard.boolean(value: any): boolean?
	if type(value) ~= "boolean" then
		return nil
	end
	return value
end

-- A string id that exists as a key in lookup (e.g. Items.ById).
function Guard.id(value: any, lookup: { [string]: any }, maxLength: number?): string?
	local s = Guard.string(value, maxLength or 64, 1)
	if s == nil or lookup[s] == nil then
		return nil
	end
	return s
end

-- A value contained in an array of allowed values.
function Guard.oneOf<T>(value: any, allowed: { T }): T?
	for _, v in ipairs(allowed) do
		if v == value then
			return v
		end
	end
	return nil
end

-- A plain table payload (or an empty table when nil). Rejects anything else.
function Guard.payload(value: any): { [any]: any }?
	if value == nil then
		return {}
	end
	if type(value) ~= "table" then
		return nil
	end
	return value
end

Guard.isFinite = isFinite

return Guard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net (ModuleScript)
	Location: ServerScriptService/Core/Net
	Depends on: Shared/Remotes, Core/Guard, Core/RateLimiter

	Server networking hub.
	  * Net.registerAction(name, def) registers a handler for the "Action"
	    RemoteFunction. Every call is validated (action name, payload type),
	    rate limited per player and per action, requires a loaded profile and
	    runs inside pcall so a failing handler can never break the remote.
	  * Net.notify / Net.notifyAll send UI notifications.
	  * Net.fire / Net.fireAll send any server -> client RemoteEvent.

	Handlers receive (profile, payload) and return Net.ok({...}) or Net.fail("message").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Guard = require(script.Parent.Guard)
local RateLimiter = require(script.Parent.RateLimiter)

export type ActionDef = {
	Handler: (profile: any, payload: { [any]: any }) -> { [string]: any }?,
	Rate: { Capacity: number, Refill: number }?,
}

local Net = {}

local services = nil
local actions: { [string]: ActionDef } = {}
local limiters: { [string]: any } = {}
-- Shared budget across every action, so spreading spam over many actions does not help.
local globalLimiter = RateLimiter.new(40, 20)

function Net.ok(t: { [string]: any }?)
	local result = t or {}
	result.ok = true
	return result
end

function Net.fail(message: string, extra: { [string]: any }?)
	local result = extra or {}
	result.ok = false
	result.err = message
	return result
end

function Net.registerAction(name: string, def: ActionDef)
	assert(actions[name] == nil, "Action registered twice: " .. name)
	local rate = def.Rate or { Capacity = 10, Refill = 4 }
	limiters[name] = RateLimiter.new(rate.Capacity, rate.Refill)
	actions[name] = def
end

local function handleAction(player: Player, actionName: any, payload: any)
	local security = services.SecurityService
	if type(actionName) ~= "string" or #actionName > 40 then
		security:Flag(player, "MalformedAction", typeof(actionName))
		return Net.fail("Bad request.")
	end
	local def = actions[actionName]
	if not def then
		security:Flag(player, "UnknownAction", string.sub(actionName, 1, 40))
		return Net.fail("Bad request.")
	end
	local body = Guard.payload(payload)
	if body == nil then
		security:Flag(player, "MalformedPayload", actionName)
		return Net.fail("Bad request.")
	end
	if not globalLimiter:allow(player.UserId) or not limiters[actionName]:allow(player.UserId) then
		security:Note(player, "RateLimited", actionName)
		return Net.fail("You're doing that too fast.", { rateLimited = true })
	end
	local profile = services.DataService:GetProfile(player)
	if not profile then
		return Net.fail("Your data is still loading.")
	end
	local ok, result = pcall(def.Handler, profile, body)
	if not ok then
		warn(`[Net] Action {actionName} failed for {player.Name} ({player.UserId}): {result}`)
		return Net.fail("Something went wrong. Please try again.")
	end
	if type(result) ~= "table" then
		return Net.ok()
	end
	return result
end

function Net.init(serviceTable)
	services = serviceTable
	Remotes.func("Action").OnServerInvoke = handleAction
	Players.PlayerRemoving:Connect(function(player)
		globalLimiter:reset(player.UserId)
		for _, limiter in pairs(limiters) do
			limiter:reset(player.UserId)
		end
	end)
end

function Net.onEvent(name: string, handler: (Player, ...any) -> ())
	Remotes.event(name).OnServerEvent:Connect(function(player, ...)
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(`[Net] Event {name} handler failed for {player.Name}: {err}`)
		end
	end)
end

function Net.fire(player: Player, name: string, ...: any)
	if player.Parent == Players then
		Remotes.event(name):FireClient(player, ...)
	end
end

function Net.fireAll(name: string, ...: any)
	Remotes.event(name):FireAllClients(...)
end

--[[
	Notification kinds understood by the client (Notifications controller):
	  Toast        { Text, Icon?, Color? }
	  Error        { Text }
	  LevelUp      { Level, SkillPoints, Chest? }
	  Discovery    { Item }
	  Achievement  { Id }
	  Announcement { Text, From, Scope }
	  Event        { Id, Started, EndsAt }
	  Reward       { Title, Text }
	  Stage        { Stage }
	  Offline      { Amount, Seconds }
	  Warning      { Text }
	  Rare         { Player, Item }
]]
function Net.notify(player: Player, kind: string, data: { [string]: any }?)
	Net.fire(player, "Notify", kind, data or {})
end

function Net.notifyAll(kind: string, data: { [string]: any }?)
	Net.fireAll("Notify", kind, data or {})
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--[[
	RateLimiter (ModuleScript)
	Location: ServerScriptService/Core/RateLimiter

	Token-bucket rate limiter keyed by any value (usually a UserId or a
	"UserId:action" string). Each bucket holds up to `capacity` tokens and
	refills at `refillPerSecond`. A request that cannot take a token is denied.
]]

local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type RateLimiter = typeof(setmetatable(
	{} :: { capacity: number, refill: number, buckets: { [any]: { tokens: number, last: number } } },
	RateLimiter
))

function RateLimiter.new(capacity: number, refillPerSecond: number): RateLimiter
	return setmetatable({
		capacity = capacity,
		refill = refillPerSecond,
		buckets = {},
	}, RateLimiter)
end

function RateLimiter:allow(key: any, cost: number?): boolean
	local now = os.clock()
	local bucket = self.buckets[key]
	if not bucket then
		bucket = { tokens = self.capacity, last = now }
		self.buckets[key] = bucket
	else
		local elapsed = now - bucket.last
		bucket.tokens = math.min(self.capacity, bucket.tokens + elapsed * self.refill)
		bucket.last = now
	end
	local need = cost or 1
	if bucket.tokens >= need then
		bucket.tokens -= need
		return true
	end
	return false
end

-- Remaining tokens (after refill) without consuming any.
function RateLimiter:peek(key: any): number
	local bucket = self.buckets[key]
	if not bucket then
		return self.capacity
	end
	local elapsed = os.clock() - bucket.last
	return math.min(self.capacity, bucket.tokens + elapsed * self.refill)
end

function RateLimiter:reset(key: any)
	self.buckets[key] = nil
end

return RateLimiter
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="48">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Main (Script)
	Location: ServerScriptService/Main

	Server entry point. Creates the remotes, loads every service, then calls
	Init (wire up, register actions) and Start (begin loops) in a fixed order.
	Services reach each other through the shared `services` table instead of
	requiring each other, which keeps the module graph free of cycles.

	Dependencies: ServerScriptService/Core/*, ServerScriptService/Services/*,
	ServerScriptService/Admin/AdminService, ReplicatedStorage/Shared/Remotes
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
Remotes.init()

local Services = ServerScriptService:WaitForChild("Services")
local Admin = ServerScriptService:WaitForChild("Admin")
local Net = require(ServerScriptService:WaitForChild("Core"):WaitForChild("Net"))

local ORDER = {
	"SecurityService",
	"DataService",
	"EventService",
	"StatsService",
	"SyncService",
	"EconomyService",
	"QuestService",
	"AchievementService",
	"ClickService",
	"UpgradeService",
	"ChestService",
	"InventoryService",
	"ProgressionService",
	"OrbService",
	"GamePassService",
	"ProductService",
	"ObbyService",
	"TutorialService",
	"SettingsService",
	"LeaderboardService",
	"WorldService",
	"AdminService",
}

local services = { Order = ORDER, Net = Net }

for _, name in ipairs(ORDER) do
	local module = Services:FindFirstChild(name) or Admin:FindFirstChild(name)
	assert(module, "Missing service module: " .. name)
	services[name] = require(module)
end

Net.init(services)

for _, name in ipairs(ORDER) do
	local service = services[name]
	if service.Init then
		service:Init(services)
	end
end

for _, name in ipairs(ORDER) do
	local service = services[name]
	if service.Start then
		local ok, err = pcall(service.Start, service)
		if not ok then
			warn(`[Main] {name}.Start failed: {err}`)
		end
	end
end

print(`[Main] Click a Button server started with {#ORDER} services.`)
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="49">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">AchievementService</string>
          <string name="Source"><![CDATA[--[[
	AchievementService (ModuleScript)
	Location: ServerScriptService/Services/AchievementService
	Depends on: Shared/Config/Achievements, Shared/Formulas, EconomyService, SyncService, Net

	Unlocks achievements when tracked values reach their targets and grants
	their rewards. Services call MarkDirty(profile) after changing stats; a
	loop checks dirty profiles once per second, so bursts of clicks never
	cause repeated scans.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Achievements = require(Shared.Config.Achievements)
local Formulas = require(Shared.Formulas)

local AchievementService = { Name = "AchievementService" }

function AchievementService:Init(services)
	self.Services = services
end

function AchievementService:Start()
	task.spawn(function()
		while true do
			task.wait(1)
			for _, profile in pairs(self.Services.DataService.Profiles) do
				if profile.Runtime.AchievementsDirty then
					profile.Runtime.AchievementsDirty = false
					self:Check(profile)
				end
			end
		end
	end)
end

function AchievementService:OnProfileLoaded(profile)
	self:MarkDirty(profile)
end

function AchievementService:MarkDirty(profile)
	profile.Runtime.AchievementsDirty = true
end

function AchievementService:GetValue(profile, stat: string): number
	local data = profile.Data
	if stat == "Rebirths" then
		return data.Rebirths
	elseif stat == "Level" then
		return data.Level
	elseif stat == "ItemsDiscovered" then
		return Formulas.discoveredCount(data)
	elseif stat == "SkillRanks" then
		return Formulas.skillPointsSpent(data)
	end
	return data.Stats[stat] or 0
end

function AchievementService:Check(profile)
	local data = profile.Data
	local unlocked = false
	for _, def in ipairs(Achievements.List) do
		if not data.Achievements[def.Id] and self:GetValue(profile, def.Stat) >= def.Target then
			data.Achievements[def.Id] = os.time()
			unlocked = true
			local granted = self.Services.EconomyService:GrantReward(profile, def.Reward, "achievement")
			self.Services.Net.notify(profile.Player, "Achievement", { Id = def.Id, Reward = granted })
		end
	end
	if unlocked then
		self.Services.SyncService:MarkDirty(profile, "Achievements")
		-- Rewards can unlock further achievements (e.g. skill points); check again soon.
		self:MarkDirty(profile)
	end
end

return AchievementService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">ChestService</string>
          <string name="Source"><![CDATA[--[[
	ChestService (ModuleScript)
	Location: ServerScriptService/Services/ChestService
	Depends on: Shared/Loot, Shared/Formulas, Shared/Config/{Chests,Items,Rarities,GameConfig},
	            Core/DataOps, Core/Net, Core/Guard, EconomyService, StatsService, SyncService,
	            QuestService, AchievementService

	Crate purchasing and opening. Prices, odds, luck, pity and the item pool
	are all evaluated here with a server-side Random; the client only sends
	which crate, how many, and whether to use owned crates or buy them.
	Every drop (bonus drops too) can also come out Golden or Rainbow
	(Items.Variants chances); variants never change pity.
	Results are applied to the player's data BEFORE they are returned, so the
	opening animation on the client is purely cosmetic.

	Action: OpenChest { Id: string, Amount: integer 1..maxOpen, Mode: "owned" | "buy" }
	(maxOpen = the crate's MaxOpen plus the Fast Crates pass bonus, see Formulas.maxOpen)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Chests = require(Shared.Config.Chests)
local Items = require(Shared.Config.Items)
local GameConfig = require(Shared.Config.GameConfig)
local Loot = require(Shared.Loot)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Format)
local Core = script.Parent.Parent.Core
local DataOps = require(Core.DataOps)
local Net = require(Core.Net)
local Guard = require(Core.Guard)

local ChestService = { Name = "ChestService" }

local rng = Random.new()

function ChestService:Init(services)
	self.Services = services
	Net.registerAction("OpenChest", {
		Rate = { Capacity = 6, Refill = 2 },
		Handler = function(profile, payload)
			return self:Open(profile, payload.Id, payload.Amount, payload.Mode)
		end,
	})
end

function ChestService:PityThresholds(chest, stats)
	local thresholds = {}
	for rarityId in pairs(chest.Pity or {}) do
		thresholds[rarityId] = Formulas.pityThreshold(chest, rarityId, stats.pityMultiplier)
	end
	return thresholds
end

--[[
	Adds one item to the player and returns the result entry.
	flags: { Pity = bool?, Bonus = bool?, Test = bool? }
]]
function ChestService:Award(profile, itemId: string, flags)
	local data = profile.Data
	local item = Items.ById[itemId]
	local isNew = DataOps.addItem(data, itemId, 1)
	local stats = data.Stats
	if item.RarityIndex >= 5 then
		stats.LegendariesFound += 1
	end
	if item.RarityIndex >= 6 then
		stats.MythicsFound += 1
	end
	if item.RarityIndex >= 7 then
		stats.SecretsFound += 1
	end
	if item.Variant == "rainbow" then
		stats.RainbowsFound += 1
	end

	local result = {
		Item = itemId,
		Rarity = item.Rarity,
		New = isNew,
		Pity = flags.Pity == true or nil,
		Bonus = flags.Bonus == true or nil,
		Test = flags.Test == true or nil,
	}

	local autoSell = data.Settings.AutoSell or 0
	-- Golden/Rainbow copies are fusing material and are never auto-sold.
	if not isNew
		and not flags.Test
		and not item.Variant
		and autoSell > 0
		and item.RarityIndex <= math.min(autoSell, GameConfig.Inventory.AutoSellMaxIndex)
		and not data.Favorites[itemId]
	then
		DataOps.removeItem(data, itemId, 1)
		local playerStats = self.Services.StatsService:Get(profile)
		local gems = Formulas.sellValue(item, 1, playerStats.gemMultiplier)
		self.Services.EconomyService:Add(profile, "Gems", gems, "autosell")
		stats.ItemsSold += 1
		self.Services.QuestService:Progress(profile, "ItemsSold", 1)
		result.AutoSold = gems
	end

	result.Count = data.Inventory[itemId] or 0
	if isNew then
		self.Services.Net.notify(profile.Player, "Discovery", { Item = itemId })
	end
	if (item.RarityIndex >= 6 or item.Variant == "rainbow") and not flags.Test then
		self.Services.Net.notifyAll("Rare", { Player = profile.Player.DisplayName, Item = itemId })
	end
	return result
end

-- Turns a rolled item into its Golden/Rainbow version by chance (or by force).
function ChestService:_withVariant(itemId: string, chest): string
	local variant = chest.ForceVariant or Loot.rollVariant(rng, chest.VariantChances)
	return if variant then Items.variantId(itemId, variant) else itemId
end

function ChestService:_afterAward(profile)
	self.Services.StatsService:Invalidate(profile)
	self.Services.SyncService:MarkDirty(profile, "Inventory", "Discovered", "Chests", "Pity", "Stats", "Equipped", "Favorites")
	self.Services.AchievementService:MarkDirty(profile)
end

function ChestService:RollMany(profile, chest, amount: number)
	local data = profile.Data
	local stats = self.Services.StatsService:Get(profile)
	local pity = data.Pity[chest.Id]
	if not pity then
		pity = {}
		data.Pity[chest.Id] = pity
	end
	local thresholds = self:PityThresholds(chest, stats)
	local results = {}
	for _ = 1, amount do
		local itemId, _, pityTriggered = Loot.roll(rng, chest, stats.luck, pity, thresholds)
		if itemId then
			table.insert(results, self:Award(profile, self:_withVariant(itemId, chest), { Pity = pityTriggered }))
		end
		local bonusChance = Formulas.chestBonusChance(chest, stats.chestBonus)
		if bonusChance > 0 and rng:NextNumber() < bonusChance then
			-- Bonus drops use the same odds but never advance or consume pity.
			local bonusId = Loot.roll(rng, chest, stats.luck, {}, {})
			if bonusId then
				table.insert(results, self:Award(profile, self:_withVariant(bonusId, chest), { Bonus = true }))
			end
		end
	end
	return results
end

function ChestService:Open(profile, rawId: any, rawAmount: any, rawMode: any)
	local chestId = Guard.id(rawId, Chests.ById)
	if not chestId then
		return Net.fail("Unknown crate.")
	end
	local chest = Chests.ById[chestId]
	local stats = self.Services.StatsService:Get(profile)
	local amount = Guard.integer(rawAmount, 1, Formulas.maxOpen(chest, stats))
	if not amount then
		return Net.fail("Invalid amount.")
	end
	local mode = Guard.oneOf(rawMode, { "owned", "buy" })
	if not mode then
		return Net.fail("Invalid request.")
	end
	local data = profile.Data
	if not Formulas.chestUnlocked(chest, data) then
		local stage = GameConfig.Stages[chest.Stage]
		return Net.fail(`Unlocks at {stage.Name} ({stage.Rebirths} Ascensions).`)
	end

	local spent = 0
	if mode == "owned" then
		if (data.Chests[chestId] or 0) < amount then
			return Net.fail("You don't have enough of those crates.")
		end
		DataOps.removeChest(data, chestId, amount)
	else
		local price = Formulas.chestPrice(chest, stats.chestDiscount) * amount
		if not self.Services.EconomyService:Spend(profile, chest.Currency, price) then
			return Net.fail(`Not enough {chest.Currency}. Need {Format.short(price)}.`)
		end
		spent = price
	end

	local results = self:RollMany(profile, chest, amount)
	data.Stats.ChestsOpened += amount
	self.Services.EconomyService:AddXP(profile, GameConfig.Levels.ChestXP * chest.Tier * amount * stats.xpMultiplier)
	self.Services.QuestService:Progress(profile, "ChestsOpened", amount)
	self:_afterAward(profile)
	return Net.ok({ Chest = chestId, Mode = mode, Spent = spent, Results = results })
end

-- Robux crates ----------------------------------------------------------------------

-- Every item of the crates this player has unlocked, by rarity (Robux crate pool).
function ChestService:RobuxPool(data): { [string]: { string } }
	local pool = {}
	for _, chest in ipairs(Chests.List) do
		if Formulas.chestUnlocked(chest, data) then
			for rarityId, ids in pairs(Items.PoolByChest[chest.Id] or {}) do
				local list = pool[rarityId]
				if not list then
					list = {}
					pool[rarityId] = list
				end
				for _, id in ipairs(ids) do
					if not table.find(list, id) then
						table.insert(list, id)
					end
				end
			end
		end
	end
	return pool
end

--[[
	Opens one Robux crate (only called by ProductService after a verified
	receipt). The roll uses the server's Random; the item is applied before the
	result is returned, the client only plays the animation.
]]
function ChestService:OpenRobuxCrate(profile, chestId: string)
	local chest = Chests.RobuxById[chestId]
	assert(chest, "Unknown Robux crate " .. tostring(chestId))
	local stats = self.Services.StatsService:Get(profile)
	local itemId = Loot.rollFromPool(rng, chest, stats.luck, self:RobuxPool(profile.Data))
	local results = {}
	if itemId then
		table.insert(results, self:Award(profile, self:_withVariant(itemId, chest), {}))
	end
	profile.Data.Stats.ChestsOpened += 1
	self.Services.EconomyService:AddXP(profile, GameConfig.Levels.ChestXP * chest.Tier * stats.xpMultiplier)
	self.Services.QuestService:Progress(profile, "ChestsOpened", 1)
	self:_afterAward(profile)
	return results
end

-- Admin testing helpers -------------------------------------------------------------

-- Grants one item of an exact rarity from a crate's pool (does not touch pity).
function ChestService:GrantForcedRarity(profile, chestId: string, rarityId: string)
	local chest = Chests.ById[chestId]
	if not chest then
		return nil, "Unknown crate."
	end
	local itemId = Loot.rollForcedRarity(rng, chest, rarityId)
	if not itemId then
		return nil, `{chest.Name} has no {rarityId} items.`
	end
	local result = self:Award(profile, itemId, { Test = true })
	self:_afterAward(profile)
	return result
end

-- Simulates openings with production odds and a private pity state.
function ChestService:Simulate(chestId: string, count: number, luck: number, withPity: boolean)
	local chest = Chests.ById[chestId]
	local thresholds = {}
	if withPity then
		for rarityId in pairs(chest.Pity or {}) do
			thresholds[rarityId] = Formulas.pityThreshold(chest, rarityId, 1)
		end
	end
	return Loot.simulate(Random.new(), chest, luck, count, thresholds)
end

return ChestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">ClickService</string>
          <string name="Source"><![CDATA[--[[
	ClickService (ModuleScript)
	Location: ServerScriptService/Services/ClickService
	Depends on: Shared/Config/GameConfig, Shared/Config/Chests, Shared/Formulas, Shared/Util,
	            Core/RateLimiter, Core/DataOps, StatsService, EconomyService, QuestService,
	            AchievementService, SecurityService, SyncService, WorldService, Net

	Server-authoritative pressing.
	  * Manual presses arrive on the "Click" RemoteEvent with NO trusted data.
	    A token bucket caps accepted presses (GameConfig.Click); excess presses
	    are dropped and sustained floods are flagged.
	  * Value, combo, crit, streak bursts and golden presses are rolled here.
	  * Auto-presses and passive income tick on a fixed interval.
	  * Offline earnings are granted once when the profile loads.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Chests = require(Shared.Config.Chests)
local Formulas = require(Shared.Formulas)
local Util = require(Shared.Util)
local Core = script.Parent.Parent.Core
local RateLimiter = require(Core.RateLimiter)
local DataOps = require(Core.DataOps)

local CLICK = GameConfig.Click

local ClickService = {
	Name = "ClickService",
	ServerClicksThisSecond = 0,
}

local limiter = RateLimiter.new(CLICK.BurstCapacity, CLICK.MaxClicksPerSecond)
local rng = Random.new()

function ClickService:Init(services)
	self.Services = services
	services.Net.onEvent("Click", function(player)
		self:_onClick(player)
	end)
end

function ClickService:Start()
	local autoAccumulator = 0
	local passiveAccumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		autoAccumulator += dt
		passiveAccumulator += dt
		if autoAccumulator >= GameConfig.AutoClick.TickInterval then
			local step = autoAccumulator
			autoAccumulator = 0
			for _, profile in pairs(self.Services.DataService.Profiles) do
				self:_autoTick(profile, step)
			end
		end
		if passiveAccumulator >= GameConfig.Passive.TickInterval then
			local step = passiveAccumulator
			passiveAccumulator = 0
			for _, profile in pairs(self.Services.DataService.Profiles) do
				self:_passiveTick(profile, step)
			end
		end
	end)
end

function ClickService:OnProfileLoaded(profile)
	local rt = profile.Runtime
	rt.Combo = 0
	rt.StreakCount = 0
	rt.LastClick = 0
	rt.AutoCarry = 0
	rt.PendingAuto = 0
	rt.PendingAutoCount = 0
	rt.PendingPassive = 0
	rt.AttemptWindow = os.clock()
	rt.AttemptCount = 0
	self:_grantOffline(profile)
end

function ClickService:OnProfileReleasing(profile)
	limiter:reset(profile.UserId)
end

-- Offline earnings: a share of passive income for the time since the last save.
function ClickService:_grantOffline(profile)
	local cfg = GameConfig.Offline
	local data = profile.Data
	local lastSeen = data.Meta.LastSeen
	if not cfg.Enabled or profile.Temporary or lastSeen <= 0 then
		return
	end
	local elapsed = os.time() - lastSeen
	if elapsed < cfg.MinSeconds then
		return
	end
	local stats = self.Services.StatsService:GetBase(profile)
	local seconds = math.min(elapsed, stats.offlineMaxSeconds)
	local amount = stats.passivePerSec * seconds * stats.offlineRate
	if amount >= 1 then
		self.Services.EconomyService:AddSparks(profile, amount, "offline")
		data.Stats.OfflineEarned += amount
		self.Services.Net.notify(profile.Player, "Offline", { Amount = amount, Seconds = seconds, Away = elapsed })
	end
end

local function rollGoldenReward(self, profile, stats)
	local reward = Util.weightedPick(rng, GameConfig.GoldenRewards)
	local result = { Type = reward.Type }
	if reward.Type == "Sparks" then
		local amount = stats.clickValue * reward.Clicks
		self.Services.EconomyService:AddSparks(profile, amount, "golden")
		result.Amount = amount
	elseif reward.Type == "Gems" then
		local gems = math.floor(rng:NextInteger(reward.Min, reward.Max) * stats.gemMultiplier)
		self.Services.EconomyService:Add(profile, "Gems", gems, "golden")
		result.Amount = gems
	elseif reward.Type == "Chest" then
		local chestId = Chests.bestSparksChestForStage(stats.stage)
		DataOps.addChest(profile.Data, chestId, 1)
		self.Services.SyncService:MarkDirty(profile, "Chests")
		result.Chest = chestId
	elseif reward.Type == "Frenzy" then
		self.Services.StatsService:StartFrenzy(profile, reward.Multiplier, reward.Duration)
		result.Multiplier = reward.Multiplier
		result.Duration = reward.Duration
	end
	return result
end

function ClickService:_onClick(player: Player)
	local profile = self.Services.DataService:GetProfile(player)
	if not profile then
		return
	end
	local rt = profile.Runtime
	local now = os.clock()

	-- Flood detection counts attempts, accepted or not.
	if now - rt.AttemptWindow >= 1 then
		if rt.AttemptCount > CLICK.SuspiciousClicksPerSecond then
			self.Services.SecurityService:Flag(player, "ClickFlood", rt.AttemptCount .. " presses/s")
		end
		rt.AttemptWindow = now
		rt.AttemptCount = 0
	end
	rt.AttemptCount += 1

	if not limiter:allow(player.UserId) then
		return
	end

	local stats = self.Services.StatsService:Get(profile)
	local data = profile.Data

	if now - rt.LastClick <= stats.comboWindow then
		rt.Combo = math.min(rt.Combo + 1, CLICK.HardComboLimit)
		rt.StreakCount += 1
	else
		rt.Combo = 1
		rt.StreakCount = 1
	end
	rt.LastClick = now

	local comboMult = Formulas.comboMultiplier(stats, rt.Combo)
	local crit = rng:NextNumber() < stats.critChance
	local amount = stats.clickValue * comboMult * (if crit then stats.critMultiplier else 1)

	local streakBonus = 0
	-- Counted separately from the clamped combo, so a capped combo still bursts only every StreakEvery presses.
	if rt.StreakCount % CLICK.StreakEvery == 0 then
		streakBonus = stats.clickValue * CLICK.StreakBurstClicks * stats.streakMultiplier * (rt.Combo / CLICK.StreakEvery) ^ 0.5
		data.Stats.StreakBursts += 1
	end

	local economy = self.Services.EconomyService
	economy:AddSparks(profile, amount + streakBonus, "click")
	economy:AddXP(profile, CLICK.XPPerClick * stats.xpMultiplier)

	local s = data.Stats
	s.TotalClicks += 1
	if crit then
		s.TotalCrits += 1
	end
	if rt.Combo > s.HighestCombo then
		s.HighestCombo = rt.Combo
	end

	local golden = nil
	if rng:NextNumber() < stats.goldenChance then
		s.GoldenClicks += 1
		golden = rollGoldenReward(self, profile, stats)
	end

	local quests = self.Services.QuestService
	quests:Progress(profile, "Clicks", 1)
	quests:Progress(profile, "Combo", rt.Combo)
	if crit then
		quests:Progress(profile, "Crits", 1)
	end
	if golden then
		quests:Progress(profile, "GoldenClicks", 1)
	end
	self.Services.AchievementService:MarkDirty(profile)
	self.ServerClicksThisSecond += 1

	self.Services.Net.fire(player, "ClickResult", {
		Amount = amount,
		Crit = crit,
		Combo = rt.Combo,
		ComboMult = comboMult,
		Streak = if streakBonus > 0 then streakBonus else nil,
		Golden = golden,
	})
end

function ClickService:_autoTick(profile, dt: number)
	local stats = self.Services.StatsService:Get(profile)
	if stats.autoRate <= 0 then
		return
	end
	local rt = profile.Runtime
	rt.AutoCarry = (rt.AutoCarry or 0) + stats.autoRate * dt
	local presses = math.floor(rt.AutoCarry)
	if presses <= 0 then
		return
	end
	rt.AutoCarry -= presses
	local crits = 0
	for _ = 1, presses do
		if rng:NextNumber() < stats.critChance then
			crits += 1
		end
	end
	local amount = stats.clickValue * (presses + crits * (stats.critMultiplier - 1))
	self.Services.EconomyService:AddSparks(profile, amount, "auto")
	self.Services.EconomyService:AddXP(profile, presses * CLICK.XPPerClick * CLICK.AutoClickXPFactor * stats.xpMultiplier)
	profile.Data.Stats.AutoClicks += presses
	profile.Data.Stats.TotalCrits += crits
	rt.PendingAuto = (rt.PendingAuto or 0) + amount
	rt.PendingAutoCount = (rt.PendingAutoCount or 0) + presses
end

function ClickService:_passiveTick(profile, dt: number)
	local stats = self.Services.StatsService:Get(profile)
	local rt = profile.Runtime
	local data = profile.Data
	data.Stats.PlayTime += dt
	if stats.passivePerSec > 0 then
		local amount = stats.passivePerSec * dt
		self.Services.EconomyService:AddSparks(profile, amount, "passive")
		rt.PendingPassive = (rt.PendingPassive or 0) + amount
	end
	-- One aggregated update per second for the client's floating numbers.
	if (rt.PendingAuto or 0) > 0 or (rt.PendingPassive or 0) > 0 then
		self.Services.Net.fire(profile.Player, "ClickResult", {
			Auto = rt.PendingAuto,
			AutoCount = rt.PendingAutoCount,
			Passive = rt.PendingPassive,
		})
		rt.PendingAuto = 0
		rt.PendingAutoCount = 0
		rt.PendingPassive = 0
	end
end

-- Resets the combo (used by ascension).
function ClickService:ResetCombo(profile)
	profile.Runtime.Combo = 0
	profile.Runtime.StreakCount = 0
	profile.Runtime.LastClick = 0
end

return ClickService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService (ModuleScript)
	Location: ServerScriptService/Services/DataService
	Depends on: Core/DataSchema, Shared/Util, Shared/Signal, Shared/Config/GameConfig

	Loads, saves and protects player data in DataStoreService.

	Record format stored under "Player_<UserId>":
	    { Schema = <version>, Data = <player data>, Lock = { JobId, PlaceId, Time } | nil, UpdatedAt }

	Session locking
	  * Loading uses UpdateAsync to claim the lock. If another live server holds
	    a fresh lock, loading waits and retries (that server is usually saving
	    the player right now). Locks older than LockStaleSeconds are treated as
	    abandoned (crashed server) and taken over.
	  * Every save verifies this server still owns the lock. If another server
	    took it over, this server stops saving and removes the player, so two
	    servers can never overwrite each other.
	  * Leaving / shutdown saves with release = true, which clears the lock.

	Failure handling
	  * Every DataStore call is wrapped in pcall, retried with exponential
	    backoff and waits for request budget.
	  * If data cannot be loaded in a live server the player is kicked with an
	    explanation instead of playing on empty data that could later overwrite
	    real progress (GameConfig.Data.KickOnLoadFailure).
	  * In Studio without "Enable Studio Access to API Services", players get a
	    clearly labelled temporary profile that is never saved.
	  * Saving is never reported as guaranteed: failures are counted, logged and
	    surfaced to admins (GetStatus).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Util = require(Shared.Util)
local Signal = require(Shared.Signal)
local DataSchema = require(script.Parent.Parent.Core.DataSchema)

local CONFIG = GameConfig.Data

local DataService = {
	Name = "DataService",
	Profiles = {} :: { [Player]: any },
	ProfileLoaded = Signal.new(),
	ShuttingDown = false,
	Status = {
		Available = true,
		Mode = "persistent",
		LastError = nil :: string?,
		Loads = 0,
		LoadFailures = 0,
		Saves = 0,
		SaveFailures = 0,
		LockConflicts = 0,
		LastAutosave = 0,
	},
}

local loading: { [Player]: boolean } = {}
local releasing: { [number]: boolean } = {}

local function keyFor(userId: number): string
	return CONFIG.KeyPrefix .. tostring(userId)
end

local function lockIsActive(lock: any, now: number): boolean
	return type(lock) == "table"
		and lock.JobId ~= game.JobId
		and type(lock.Time) == "number"
		and now - lock.Time < CONFIG.LockStaleSeconds
end

local function backoff(attempt: number): number
	return math.min(8, 0.5 * 2 ^ attempt)
end

function DataService:Init(services)
	self.Services = services
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(CONFIG.StoreName)
	end)
	if ok then
		self.Store = store
	else
		self.Status.Available = false
		self.Status.LastError = tostring(store)
	end
end

function DataService:Start()
	if self.Store and RunService:IsStudio() then
		-- Probe once: in Studio, DataStores error unless API access is enabled.
		local ok, err = pcall(function()
			return self.Store:GetAsync("__probe")
		end)
		if not ok then
			self.Status.Available = false
			self.Status.LastError = tostring(err)
		end
	end
	if not self.Status.Available then
		self.Status.Mode = "temporary"
		warn(
			"[DataService] DataStores are unavailable ("
				.. tostring(self.Status.LastError)
				.. "). In Studio, enable Game Settings > Security > 'Enable Studio Access to API Services'. "
				.. "Players receive temporary data that is NOT saved."
		)
	end

	Players.PlayerAdded:Connect(function(player)
		self:_onPlayerAdded(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_onPlayerRemoving(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(self._onPlayerAdded, self, player)
	end

	game:BindToClose(function()
		self:_onClose()
	end)

	task.spawn(function()
		while not self.ShuttingDown do
			task.wait(CONFIG.AutosaveInterval)
			self:_autosave()
		end
	end)
end

-- Public API ------------------------------------------------------------------

function DataService:GetProfile(player: Player)
	return self.Profiles[player]
end

function DataService:WaitForProfile(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 30)
	while player.Parent == Players and os.clock() < deadline do
		local profile = self.Profiles[player]
		if profile then
			return profile
		end
		task.wait(0.1)
	end
	return self.Profiles[player]
end

function DataService:GetProfileByUserId(userId: number)
	for player, profile in pairs(self.Profiles) do
		if player.UserId == userId then
			return profile
		end
	end
	return nil
end

function DataService:IsPersistent(): boolean
	return self.Status.Available
end

function DataService:GetStatus()
	return table.clone(self.Status)
end

-- Saves soon (used after important changes such as ascending and by autosave).
-- Requests made while a save is already queued are merged into it.
function DataService:SaveNow(profile): boolean
	if profile.SaveQueued then
		return false
	end
	-- _save clears SaveQueued when it takes its snapshot, so a request made after
	-- that point queues a new save instead of being lost.
	profile.SaveQueued = true
	return self:_save(profile, false)
end

-- Budget ------------------------------------------------------------------------

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	local deadline = os.clock() + 10
	while os.clock() < deadline do
		local ok, budget = pcall(function()
			return DataStoreService:GetRequestBudgetForRequestType(requestType)
		end)
		if not ok or budget >= 1 then
			return
		end
		task.wait(0.5)
	end
end

-- Loading ------------------------------------------------------------------------

-- Returns ({ data, isNew } | nil, status). status: ok | locked | newer | corrupt | error | left
function DataService:_loadData(player: Player)
	local userId = player.UserId
	local key = keyFor(userId)
	local errors = 0
	local lockDeadline: number? = nil
	local notified = false
	while true do
		if player.Parent ~= Players then
			return nil, "left"
		end
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local status, loaded = nil, nil
		local ok, err = pcall(function()
			self.Store:UpdateAsync(key, function(record)
				status, loaded = nil, nil
				if record ~= nil and type(record) ~= "table" then
					status = "corrupt"
					return nil
				end
				local rec = record or {}
				local now = os.time()
				if lockIsActive(rec.Lock, now) then
					status = "locked"
					return nil
				end
				local raw, versionOk = DataSchema.migrate(rec.Data)
				if not versionOk then
					status = "newer"
					return nil
				end
				loaded = { raw = raw, isNew = rec.Data == nil }
				rec.Lock = { JobId = game.JobId, PlaceId = game.PlaceId, Time = now }
				rec.Schema = DataSchema.CURRENT_VERSION
				status = "ok"
				return rec
			end)
		end)

		if ok and status == "ok" then
			local data
			if loaded.raw == nil then
				data = DataSchema.default()
			else
				local issues
				data, issues = DataSchema.sanitize(loaded.raw)
				if #issues > 0 then
					warn(`[DataService] Sanitised data for {userId}: {table.concat(issues, "; ")}`)
				end
			end
			return { data = data, isNew = loaded.isNew }, "ok"
		elseif ok and (status == "newer" or status == "corrupt") then
			return nil, status
		end

		if not ok then
			errors += 1
			self.Status.LastError = tostring(err)
			warn(`[DataService] Load attempt {errors} for {userId} failed: {err}`)
			if errors >= CONFIG.LoadAttempts then
				return nil, "error"
			end
			task.wait(backoff(errors))
		else
			-- Another server holds a fresh lock. It is usually saving this player right
			-- now; otherwise the lock goes stale after LockStaleSeconds and is taken over.
			self.Status.LockConflicts += 1
			lockDeadline = lockDeadline or (os.clock() + CONFIG.LockStaleSeconds + 15)
			if os.clock() >= lockDeadline then
				return nil, "locked"
			end
			if not notified then
				notified = true
				self.Services.Net.notify(player, "Warning", {
					Text = "Your progress is still being saved by another server. Loading it as soon as it is free…",
				})
			end
			task.wait(CONFIG.LockedRetryDelay)
		end
	end
end

function DataService:_newProfile(player: Player, data, temporary: boolean, isNew: boolean)
	return {
		Player = player,
		UserId = player.UserId,
		Key = keyFor(player.UserId),
		Data = data,
		Temporary = temporary,
		IsNew = isNew,
		Runtime = {},
		Dirty = {},
		LoadedAt = os.clock(),
		Saving = false,
		SaveQueued = false,
		Releasing = false,
		Released = false,
		LockLost = false,
	}
end

local KICK_MESSAGES = {
	locked = "Your progress is still being saved by another server. Please rejoin in a minute — nothing is lost.",
	newer = "Your progress was saved by a newer version of the game. Please rejoin to get the latest version.",
	corrupt = "We could not read your saved progress safely, so we stopped to protect it. Please contact the game owner.",
	error = "Roblox data services are not responding right now. Please rejoin in a minute — your progress is safe.",
}

function DataService:_onPlayerAdded(player: Player)
	if loading[player] or self.Profiles[player] then
		return
	end
	loading[player] = true

	-- If this user is still being saved after leaving this very server, wait for it:
	-- loading before that save finishes would read older data.
	local deadline = os.clock() + 90
	while releasing[player.UserId] and os.clock() < deadline do
		task.wait(0.2)
	end
	if releasing[player.UserId] then
		loading[player] = nil
		player:Kick(KICK_MESSAGES.locked)
		return
	end

	local profile
	if not self.Status.Available then
		if RunService:IsStudio() or not CONFIG.KickOnLoadFailure then
			profile = self:_newProfile(player, DataSchema.default(), true, true)
		else
			loading[player] = nil
			self.Status.LoadFailures += 1
			player:Kick(KICK_MESSAGES.error)
			return
		end
	else
		local result, status = self:_loadData(player)
		if player.Parent ~= Players then
			-- Left while loading: give the lock back without touching the data.
			loading[player] = nil
			if result then
				self:_releaseLockOnly(player.UserId)
			end
			return
		end
		if not result then
			self.Status.LoadFailures += 1
			warn(`[DataService] Could not load data for {player.Name} ({player.UserId}): {status}`)
			if RunService:IsStudio() and status == "error" then
				profile = self:_newProfile(player, DataSchema.default(), true, true)
			else
				loading[player] = nil
				player:Kick(KICK_MESSAGES[status] or KICK_MESSAGES.error)
				return
			end
		else
			self.Status.Loads += 1
			profile = self:_newProfile(player, result.data, false, result.isNew)
		end
	end

	loading[player] = nil
	if player.Parent ~= Players then
		return
	end
	profile.Data.Meta.Sessions += 1
	self.Profiles[player] = profile

	for _, name in ipairs(self.Services.Order) do
		local service = self.Services[name]
		if service ~= self and service.OnProfileLoaded then
			local ok, err = pcall(service.OnProfileLoaded, service, profile)
			if not ok then
				warn(`[DataService] {name}.OnProfileLoaded failed for {player.Name}: {err}`)
			end
		end
	end
	self.Services.SyncService:SendFull(profile)
	if profile.Temporary then
		self.Services.Net.notify(player, "Warning", {
			Text = "Saving is disabled in this session. Progress will not be kept.",
		})
	end
	self.ProfileLoaded:Fire(profile)
end

-- Saving ------------------------------------------------------------------------------

function DataService:_save(profile, release: boolean): boolean
	if profile.Temporary or profile.LockLost or profile.Released then
		return false
	end
	-- Once the release (leave/shutdown) save is requested, it writes the final state;
	-- no other save may run after it and re-claim the lock with older data.
	if not release and profile.Releasing then
		return false
	end
	-- Strictly one save at a time per profile, in order, without a timeout.
	while profile.Saving do
		task.wait(0.1)
	end
	if profile.LockLost or profile.Released or (not release and profile.Releasing) then
		return false
	end
	profile.Saving = true
	profile.SaveQueued = false

	local snapshot = Util.deepCopy(profile.Data)
	local now = os.time()
	snapshot.Meta.LastSave = now
	snapshot.Meta.LastSeen = now
	snapshot.Version = DataSchema.CURRENT_VERSION

	local success = false
	for attempt = 1, CONFIG.SaveAttempts do
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local lost = false
		local ok, err = pcall(function()
			self.Store:UpdateAsync(profile.Key, function(record)
				lost = false
				local rec = if type(record) == "table" then record else {}
				local lock = rec.Lock
				if type(lock) == "table" and lock.JobId ~= game.JobId then
					lost = true
					return nil
				end
				-- Our session holds the lock until its own release save completes. A missing
				-- lock means another server took over and released, or the record was erased:
				-- writing now would overwrite newer data, so never re-claim it (release or not).
				if lock == nil then
					lost = true
					return nil
				end
				rec.Data = snapshot
				rec.Schema = DataSchema.CURRENT_VERSION
				rec.UpdatedAt = os.time()
				rec.Lock = if release then nil else { JobId = game.JobId, PlaceId = game.PlaceId, Time = os.time() }
				return rec
			end)
		end)
		if ok then
			if lost then
				self.Status.LockConflicts += 1
				profile.LockLost = true
				profile.Saving = false
				self:_onLockLost(profile)
				return false
			end
			self.Status.Saves += 1
			profile.Data.Meta.LastSave = now
			success = true
			break
		end
		self.Status.SaveFailures += 1
		self.Status.LastError = tostring(err)
		warn(`[DataService] Save attempt {attempt} for {profile.UserId} failed: {err}`)
		if attempt < CONFIG.SaveAttempts then
			task.wait(backoff(attempt))
		end
	end
	profile.Saving = false
	if not success then
		warn(`[DataService] Could not save data for {profile.UserId} after {CONFIG.SaveAttempts} attempts.`)
	end
	return success
end

function DataService:_onLockLost(profile)
	warn(`[DataService] Session lock for {profile.UserId} was taken by another server; this server stopped saving.`)
	local player = profile.Player
	if self.Profiles[player] == profile then
		self.Profiles[player] = nil
	end
	if player.Parent == Players then
		player:Kick("Your progress was opened in another server. Please rejoin.")
	end
end

function DataService:_releaseLockOnly(userId: number)
	pcall(function()
		self.Store:UpdateAsync(keyFor(userId), function(record)
			if type(record) ~= "table" then
				return nil
			end
			if type(record.Lock) == "table" and record.Lock.JobId == game.JobId then
				record.Lock = nil
				return record
			end
			return nil
		end)
	end)
end

function DataService:_runReleasingHooks(profile)
	for _, name in ipairs(self.Services.Order) do
		local service = self.Services[name]
		if service ~= self and service.OnProfileReleasing then
			local ok, err = pcall(service.OnProfileReleasing, service, profile)
			if not ok then
				warn(`[DataService] {name}.OnProfileReleasing failed: {err}`)
			end
		end
	end
end

function DataService:_onPlayerRemoving(player: Player)
	local profile = self.Profiles[player]
	if not profile then
		return
	end
	self.Profiles[player] = nil
	releasing[player.UserId] = true
	profile.Releasing = true
	self:_runReleasingHooks(profile)
	self:_save(profile, true)
	profile.Released = true
	releasing[player.UserId] = nil
end

function DataService:_autosave()
	self.Status.LastAutosave = os.time()
	local list = {}
	for _, profile in pairs(self.Profiles) do
		if not profile.Temporary then
			table.insert(list, profile)
		end
	end
	for _, profile in ipairs(list) do
		if self.ShuttingDown then
			return
		end
		if self.Profiles[profile.Player] == profile then
			task.spawn(self.SaveNow, self, profile)
			task.wait(0.25)
		end
	end
end

function DataService:_onClose()
	self.ShuttingDown = true
	local pending = 0
	for player, profile in pairs(self.Profiles) do
		self.Profiles[player] = nil
		releasing[profile.UserId] = true
		profile.Releasing = true
		pending += 1
		task.spawn(function()
			self:_runReleasingHooks(profile)
			self:_save(profile, true)
			profile.Released = true
			releasing[profile.UserId] = nil
			pending -= 1
		end)
	end
	-- Also wait for saves that PlayerRemoving started (players are removed as the
	-- server shuts down); returning early could end the server mid-save.
	local deadline = os.clock() + CONFIG.ShutdownTimeout
	while (pending > 0 or next(releasing) ~= nil) and os.clock() < deadline do
		task.wait(0.1)
	end
	if pending > 0 or next(releasing) ~= nil then
		warn(`[DataService] Shutdown timed out with unsaved profile(s).`)
	end
end

-- Offline access (admin tools) -----------------------------------------------------------

-- Reads a player's stored data without locking it. Returns (data | nil, info).
function DataService:ReadOffline(userId: number)
	if not self.Status.Available then
		return nil, { status = "unavailable" }
	end
	local ok, record = pcall(function()
		return self.Store:GetAsync(keyFor(userId))
	end)
	if not ok then
		return nil, { status = "error", message = tostring(record) }
	end
	if record == nil then
		return nil, { status = "nodata" }
	end
	if type(record) ~= "table" then
		return nil, { status = "corrupt" }
	end
	local raw, versionOk = DataSchema.migrate(record.Data)
	if not versionOk then
		return nil, { status = "newer" }
	end
	local data = DataSchema.sanitize(raw)
	return data, { status = "ok", locked = lockIsActive(record.Lock, os.time()) }
end

--[[
	Safely modifies an OFFLINE player's data. The mutator receives sanitised
	data and must be pure (no yielding); it returns (ok, message).
	The update is refused when the player is online in this server or when an
	active session lock shows they are playing in another server, so an
	offline edit can never be overwritten by (or overwrite) a live session.
]]
function DataService:UpdateOffline(userId: number, mutator: (any) -> (boolean, string?)): (boolean, string)
	if not self.Status.Available then
		return false, "DataStores are unavailable in this session."
	end
	if Players:GetPlayerByUserId(userId) then
		return false, "That player is online in this server; use the normal action."
	end
	local result, message = "error", "Unknown error"
	local ok, err = pcall(function()
		self.Store:UpdateAsync(keyFor(userId), function(record)
			result, message = "error", "Unknown error"
			if record == nil then
				result, message = "nodata", "No saved data exists for that UserId."
				return nil
			end
			if type(record) ~= "table" then
				result, message = "corrupt", "Stored data is unreadable."
				return nil
			end
			if lockIsActive(record.Lock, os.time()) then
				result, message = "locked", "That player is currently playing in another server. Try again when they are offline."
				return nil
			end
			local raw, versionOk = DataSchema.migrate(record.Data)
			if not versionOk then
				result, message = "newer", "Data was saved by a newer game version."
				return nil
			end
			local data = DataSchema.sanitize(raw)
			local okMut, mutOk, mutMessage = pcall(mutator, data)
			if not okMut then
				result, message = "error", tostring(mutOk)
				return nil
			end
			if not mutOk then
				result, message = "rejected", mutMessage or "Change rejected."
				return nil
			end
			record.Data = data
			record.Schema = DataSchema.CURRENT_VERSION
			record.UpdatedAt = os.time()
			result, message = "ok", mutMessage or "Saved."
			return record
		end)
	end)
	if not ok then
		return false, "DataStore error: " .. tostring(err)
	end
	return result == "ok", message
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[--[[
	EconomyService (ModuleScript)
	Location: ServerScriptService/Services/EconomyService
	Depends on: Core/DataOps, Shared/Formulas, Shared/Config/*, StatsService, SyncService,
	            QuestService, AchievementService, Net

	The only place currencies, XP and generic rewards are granted or spent.
	All amounts are computed server-side; nothing here accepts client values.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Chests = require(Shared.Config.Chests)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Format)
local DataOps = require(script.Parent.Parent.Core.DataOps)

local EconomyService = { Name = "EconomyService" }

local function finitePositive(v: any): boolean
	return type(v) == "number" and v == v and v > 0 and v ~= math.huge
end

function EconomyService:Init(services)
	self.Services = services
end

-- Sparks earned through gameplay (counts toward lifetime and run totals).
function EconomyService:AddSparks(profile, amount: number, _source: string?)
	if not finitePositive(amount) then
		return
	end
	local data = profile.Data
	DataOps.addCurrency(data, "Sparks", amount)
	local stats = data.Stats
	stats.LifetimeSparks = math.min(GameConfig.CurrencyCap, stats.LifetimeSparks + amount)
	stats.SparksThisRun = math.min(GameConfig.CurrencyCap, stats.SparksThisRun + amount)
	if stats.SparksThisRun > stats.BestRunSparks then
		stats.BestRunSparks = stats.SparksThisRun
	end
	self.Services.QuestService:Progress(profile, "SparksEarned", amount)
	self.Services.SyncService:MarkDirty(profile, "Currencies", "Stats")
	self.Services.AchievementService:MarkDirty(profile)
end

-- Gems or Prisms earned through gameplay. Callers apply multipliers.
function EconomyService:Add(profile, currency: string, amount: number, _source: string?)
	if currency == "Sparks" then
		self:AddSparks(profile, amount, _source)
		return
	end
	if not finitePositive(amount) then
		return
	end
	local data = profile.Data
	DataOps.addCurrency(data, currency, amount)
	if currency == "Gems" then
		data.Stats.GemsEarned += amount
	elseif currency == "Prisms" then
		data.Stats.PrismsEarned += amount
	end
	self.Services.SyncService:MarkDirty(profile, "Currencies", "Stats")
end

function EconomyService:Has(profile, currency: string, amount: number): boolean
	return (profile.Data.Currencies[currency] or 0) >= amount
end

-- Spends currency if affordable. Returns true on success.
function EconomyService:Spend(profile, currency: string, amount: number): boolean
	if type(amount) ~= "number" or amount ~= amount or amount < 0 or amount == math.huge then
		return false
	end
	if not self:Has(profile, currency, amount) then
		return false
	end
	DataOps.addCurrency(profile.Data, currency, -amount)
	self.Services.SyncService:MarkDirty(profile, "Currencies")
	return true
end

-- XP and levels ----------------------------------------------------------------

function EconomyService:AddXP(profile, amount: number)
	if not finitePositive(amount) then
		return
	end
	local data = profile.Data
	local maxLevel = GameConfig.Levels.MaxLevel
	data.XP = math.min(GameConfig.CurrencyCap, data.XP + amount)
	local levelsGained = 0
	local spGained = 0
	local chestsGained = {}
	local guard = 0
	while data.Level < maxLevel and guard < 200 do
		local need = Formulas.xpForLevel(data.Level)
		if data.XP < need then
			break
		end
		guard += 1
		data.XP -= need
		data.Level += 1
		levelsGained += 1
		local sp = Formulas.skillPointsForLevel(data.Level)
		data.SkillPoints += sp
		spGained += sp
		if data.Level % GameConfig.Levels.ChestEvery == 0 then
			local stage = Formulas.stageFor(data.Rebirths).Id
			local chestId = Chests.bestSparksChestForStage(stage)
			DataOps.addChest(data, chestId, 1)
			chestsGained[chestId] = (chestsGained[chestId] or 0) + 1
		end
	end
	if data.Level >= maxLevel then
		data.XP = 0
	end
	self.Services.SyncService:MarkDirty(profile, "Progress")
	if levelsGained > 0 then
		self.Services.SyncService:MarkDirty(profile, "Chests")
		self.Services.Net.notify(profile.Player, "LevelUp", {
			Level = data.Level,
			SkillPoints = spGained,
			Chests = chestsGained,
		})
		self.Services.AchievementService:MarkDirty(profile)
		self.Services.QuestService:Refresh(profile)
	end
end

-- Generic rewards ---------------------------------------------------------------------

function EconomyService:DescribeReward(reward): string
	local parts = {}
	if reward.Sparks then
		table.insert(parts, Format.short(reward.Sparks) .. " Sparks")
	end
	if reward.Gems then
		table.insert(parts, Format.short(reward.Gems) .. " Gems")
	end
	if reward.Prisms then
		table.insert(parts, Format.short(reward.Prisms) .. " Prisms")
	end
	if reward.SkillPoints then
		table.insert(parts, reward.SkillPoints .. " Skill Point" .. (if reward.SkillPoints == 1 then "" else "s"))
	end
	if reward.Chests then
		for _, chestId in ipairs(Chests.Order) do
			local n = reward.Chests[chestId]
			if n then
				table.insert(parts, n .. "× " .. Chests.ById[chestId].Name)
			end
		end
	end
	if reward.XP then
		table.insert(parts, Format.short(reward.XP) .. " XP")
	end
	return table.concat(parts, ", ")
end

--[[
	Grants a reward table { Sparks, Gems, Prisms, SkillPoints, Chests, XP }.
	Gem rewards from gameplay are multiplied by the player's gem multiplier.
	Returns the reward actually granted (after multipliers).
]]
function EconomyService:GrantReward(profile, reward, source: string?)
	local data = profile.Data
	local granted = {}
	local applyMultipliers = source ~= "admin"
	local stats = self.Services.StatsService:Get(profile)

	if reward.Sparks and reward.Sparks > 0 then
		self:AddSparks(profile, reward.Sparks, source)
		granted.Sparks = reward.Sparks
	end
	if reward.Gems and reward.Gems > 0 then
		local gems = if applyMultipliers then math.floor(reward.Gems * stats.gemMultiplier) else reward.Gems
		self:Add(profile, "Gems", gems, source)
		granted.Gems = gems
	end
	if reward.Prisms and reward.Prisms > 0 then
		self:Add(profile, "Prisms", reward.Prisms, source)
		granted.Prisms = reward.Prisms
	end
	if reward.SkillPoints and reward.SkillPoints > 0 then
		data.SkillPoints += math.floor(reward.SkillPoints)
		granted.SkillPoints = math.floor(reward.SkillPoints)
		self.Services.SyncService:MarkDirty(profile, "Progress")
	end
	if reward.Chests then
		granted.Chests = {}
		for chestId, count in pairs(reward.Chests) do
			if Chests.ById[chestId] and count >= 1 then
				DataOps.addChest(data, chestId, math.floor(count))
				granted.Chests[chestId] = math.floor(count)
			end
		end
		self.Services.SyncService:MarkDirty(profile, "Chests")
	end
	if reward.XP and reward.XP > 0 then
		self:AddXP(profile, reward.XP)
		granted.XP = reward.XP
	end
	return granted
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--[[
	EventService (ModuleScript)
	Location: ServerScriptService/Services/EventService
	Depends on: Shared/Config/GameConfig, Shared/Remotes, StatsService, Net

	Server-wide boost events (Spark Surge, Lucky Hour, ...). Started by admins
	or by the automatic scheduler. Active events are replicated through
	attributes on ReplicatedStorage/ServerState ("Event_<id>" = end time as a
	unix timestamp) so every client can show banners and timers. Event effects
	are applied by Formulas through StatsService.

	Events only affect THIS server; they are labelled "server event" in the UI.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Remotes = require(Shared.Remotes)

local EVENTS = GameConfig.Events

local EventService = {
	Name = "EventService",
	Active = {} :: { [string]: { EndsAt: number, StartedBy: string } },
}

local activeList: { string } = {}
local nextAutoAt = 0

local function rebuildList()
	table.clear(activeList)
	for _, id in ipairs(EVENTS.Order) do
		if EventService.Active[id] then
			table.insert(activeList, id)
		end
	end
end

function EventService:Init(services)
	self.Services = services
end

function EventService:Start()
	nextAutoAt = os.time() + EVENTS.AutoSchedule.Interval
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.time()
			for id, info in pairs(self.Active) do
				if now >= info.EndsAt then
					self:StopEvent(id, "expired")
				end
			end
			local auto = EVENTS.AutoSchedule
			if auto.Enabled and now >= nextAutoAt then
				nextAutoAt = now + auto.Interval
				if next(self.Active) == nil and #auto.Pool > 0 then
					local id = auto.Pool[math.random(1, #auto.Pool)]
					self:StartEvent(id, auto.Duration, "Automatic")
				end
			end
		end
	end)
end

function EventService:ActiveList(): { string }
	return activeList
end

function EventService:GetActive()
	local out = {}
	for id, info in pairs(self.Active) do
		out[id] = { EndsAt = info.EndsAt, StartedBy = info.StartedBy }
	end
	return out
end

-- Starts (or extends) an event. Returns ok, message.
function EventService:StartEvent(id: string, duration: number, startedBy: string): (boolean, string)
	local def = EVENTS.Definitions[id]
	if not def then
		return false, "Unknown event."
	end
	local seconds = math.clamp(math.floor(duration), EVENTS.MinDuration, EVENTS.MaxDuration)
	local endsAt = os.time() + seconds
	self.Active[id] = { EndsAt = endsAt, StartedBy = startedBy }
	rebuildList()
	Remotes.serverState():SetAttribute("Event_" .. id, endsAt)
	self.Services.StatsService:InvalidateAll()
	self.Services.Net.notifyAll("Event", { Id = id, Started = true, EndsAt = endsAt })
	return true, `{def.Name} is active for {seconds} seconds.`
end

function EventService:StopEvent(id: string, _stoppedBy: string?): (boolean, string)
	if not self.Active[id] then
		return false, "That event is not running."
	end
	self.Active[id] = nil
	rebuildList()
	Remotes.serverState():SetAttribute("Event_" .. id, nil)
	self.Services.StatsService:InvalidateAll()
	self.Services.Net.notifyAll("Event", { Id = id, Started = false })
	return true, "Event stopped."
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">GamePassService</string>
          <string name="Source"><![CDATA[--[[
	GamePassService (ModuleScript)
	Location: ServerScriptService/Services/GamePassService
	Depends on: Shared/Config/{GamePasses,DevProducts}, Shared/RobuxSale, DataService,
	            StatsService, SyncService, ProductService, Net

	Robux game passes. Ownership is decided on the server only:
	  * When a player's data loads, MarketplaceService:UserOwnsGamePassAsync is
	    asked about every configured pass (with retries). If Roblox can't
	    answer, the last saved answer in data.Passes is kept, so an outage
	    neither takes a pass away nor hands one out.
	  * When Roblox reports a finished purchase on the server
	    (PromptGamePassPurchaseFinished with wasPurchased = true), the pass is
	    granted at once and saved.
	There is no remote for passes: the client can only open Roblox's purchase
	prompt, so nothing a client sends can grant a pass. The effects live in
	Shared/Formulas (computeStats reads data.Passes).

	Developer-product rewards can also be sold as a one-time game pass
	(Config/DevProducts with GamePassId). Owning such a pass grants its reward
	once per player through ProductService:GrantPassReward. Whether an ID is a
	pass at all is confirmed with Roblox first (Shared/RobuxSale).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GamePasses = require(Shared:WaitForChild("Config"):WaitForChild("GamePasses"))
local DevProducts = require(Shared.Config:WaitForChild("DevProducts"))
local RobuxSale = require(Shared:WaitForChild("RobuxSale"))

local GamePassService = { Name = "GamePassService" }

local CHECK_ATTEMPTS = 3
-- How long ownership checks wait for ProductService to confirm the sale kinds.
local RESOLVE_WAIT_SECONDS = 15

function GamePassService:Init(services)
	self.Services = services
end

function GamePassService:Start()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, wasPurchased)
		if wasPurchased == true and typeof(player) == "Instance" and player:IsA("Player") then
			self:_onPurchased(player, passId)
		end
	end)
end

function GamePassService:OnProfileLoaded(profile)
	profile.Runtime.PassesBought = {}
	task.spawn(self.Refresh, self, profile)
end

-- true / false, or nil when Roblox could not answer.
function GamePassService:_owns(userId: number, passId: number): boolean?
	for attempt = 1, CHECK_ATTEMPTS do
		local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, userId, passId)
		if ok then
			return result == true
		end
		warn(`[GamePassService] Ownership check {attempt} for {userId} / pass {passId} failed: {result}`)
		if attempt < CHECK_ATTEMPTS then
			task.wait(attempt * 2)
		end
	end
	return nil
end

function GamePassService:_isActive(profile): boolean
	return self.Services.DataService:GetProfile(profile.Player) == profile
end

function GamePassService:_changed(profile)
	self.Services.StatsService:Invalidate(profile)
	self.Services.SyncService:MarkDirty(profile, "Passes")
end

-- Re-checks every configured pass with Roblox and updates the stored answers.
function GamePassService:Refresh(profile)
	local deadline = os.clock() + RESOLVE_WAIT_SECONDS
	while not RobuxSale.isResolved() and os.clock() < deadline do
		task.wait(0.2)
	end
	local data = profile.Data
	local boughtNow = profile.Runtime.PassesBought or {}
	local gained = {}
	local changed = false
	for _, pass in ipairs(GamePasses.List) do
		-- Passes sold as developer products are kept by ProcessReceipt, not checked here.
		local kind, passId = RobuxSale.of(pass)
		if kind == "pass" then
			local owns = self:_owns(profile.UserId, passId)
			-- A purchase finished while we were asking: Roblox's answer may predate it.
			if owns == false and boughtNow[pass.Key] then
				owns = nil
			end
			if owns ~= nil and (data.Passes[pass.Key] == true) ~= owns then
				data.Passes[pass.Key] = if owns then true else nil
				changed = true
				if owns then
					table.insert(gained, pass)
				end
			end
		end
	end
	if changed and self:_isActive(profile) then
		self:_changed(profile)
		for _, pass in ipairs(gained) do
			self.Services.Net.notify(profile.Player, "Pass", { Key = pass.Key })
		end
	end
	-- One-time rewards sold as game passes (Gems, Sparks, boosts, bundles).
	for _, product in ipairs(DevProducts.List) do
		local kind, passId = RobuxSale.of(product)
		if kind == "pass" and not data.PassRewards[product.Key] and self:_owns(profile.UserId, passId) == true then
			if self:_isActive(profile) then
				self.Services.ProductService:GrantPassReward(profile, product)
			end
		end
	end
end

function GamePassService:_onPurchased(player: Player, passId: any)
	local reward = DevProducts.byGamePassId(passId)
	if reward then
		local DataService = self.Services.DataService
		local profile = DataService:GetProfile(player) or DataService:WaitForProfile(player, 60)
		if profile then
			self.Services.ProductService:GrantPassReward(profile, reward)
		end
		return
	end
	local pass = GamePasses.byGamePassId(passId)
	if not pass then
		warn(`[GamePassService] Purchase of unknown or unconfigured pass {tostring(passId)} by {player.UserId}`)
		return
	end
	local DataService = self.Services.DataService
	local profile = DataService:GetProfile(player) or DataService:WaitForProfile(player, 60)
	if not profile then
		return
	end
	profile.Runtime.PassesBought = profile.Runtime.PassesBought or {}
	profile.Runtime.PassesBought[pass.Key] = true
	if profile.Data.Passes[pass.Key] == true then
		return
	end
	profile.Data.Passes[pass.Key] = true
	self:_changed(profile)
	self.Services.Net.notify(player, "Pass", { Key = pass.Key })
	task.spawn(DataService.SaveNow, DataService, profile)
end

-- Owned and configured pass keys, for admin inspection and diagnostics.
function GamePassService:OwnedList(profile): { string }
	local list = {}
	for _, pass in ipairs(GamePasses.List) do
		if GamePasses.owns(profile.Data.Passes, pass.Key) then
			table.insert(list, pass.Key)
		end
	end
	return list
end

return GamePassService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source"><![CDATA[--[[
	InventoryService (ModuleScript)
	Location: ServerScriptService/Services/InventoryService
	Depends on: Shared/Config/{Items,GameConfig}, Shared/Formulas, Core/DataOps, Core/Net,
	            Core/Guard, EconomyService, StatsService, SyncService, QuestService,
	            AchievementService

	Equip / unequip / favourite / sell / fuse. Items stack by id (inventory is
	a map itemId -> count), so even a huge collection is a small table and
	every operation is O(unique items).

	Actions:
	  Equip { Id }            Unequip { Id }        EquipBest {}
	  Favorite { Id, State }  Sell { Id, Amount }   SellDuplicates { MaxRarity }
	  Fuse { Id, Amount: integer | "max" }   3 copies -> 1 of the next variant
	                                         (Normal -> Golden -> Rainbow)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Formulas)
local Core = script.Parent.Parent.Core
local DataOps = require(Core.DataOps)
local Net = require(Core.Net)
local Guard = require(Core.Guard)

local InventoryService = { Name = "InventoryService" }

-- Relative value of each stat when choosing "Equip Best".
local STAT_WEIGHT = {
	sparks = 1.2,
	click = 1.0,
	passive = 0.6,
	crit = 3.0,
	luck = 0.5,
	golden = 0.4,
	xp = 0.3,
	gems = 0.3,
}

function InventoryService:Init(services)
	self.Services = services
	local rate = { Capacity = 12, Refill = 6 }
	Net.registerAction("Equip", {
		Rate = rate,
		Handler = function(profile, payload)
			return self:Equip(profile, payload.Id)
		end,
	})
	Net.registerAction("Unequip", {
		Rate = rate,
		Handler = function(profile, payload)
			return self:Unequip(profile, payload.Id)
		end,
	})
	Net.registerAction("EquipBest", {
		Rate = { Capacity = 3, Refill = 1 },
		Handler = function(profile)
			return self:EquipBest(profile)
		end,
	})
	Net.registerAction("Favorite", {
		Rate = rate,
		Handler = function(profile, payload)
			return self:Favorite(profile, payload.Id, payload.State)
		end,
	})
	Net.registerAction("Sell", {
		Rate = rate,
		Handler = function(profile, payload)
			return self:Sell(profile, payload.Id, payload.Amount)
		end,
	})
	Net.registerAction("Fuse", {
		Rate = { Capacity = 6, Refill = 2 },
		Handler = function(profile, payload)
			return self:Fuse(profile, payload.Id, payload.Amount)
		end,
	})
	Net.registerAction("SellDuplicates", {
		Rate = { Capacity = 3, Refill = 1 },
		Handler = function(profile, payload)
			return self:SellDuplicates(profile, payload.MaxRarity)
		end,
	})
end

local function changed(self, profile, statsChanged: boolean)
	if statsChanged then
		self.Services.StatsService:Invalidate(profile)
	end
	self.Services.SyncService:MarkDirty(profile, "Inventory", "Equipped", "Favorites", "Currencies", "Stats")
end

local function isEquipped(data, itemId: string): boolean
	return table.find(data.Equipped, itemId) ~= nil
end

function InventoryService:Equip(profile, rawId: any)
	local id = Guard.id(rawId, Items.ById)
	local data = profile.Data
	if not id or (data.Inventory[id] or 0) < 1 then
		return Net.fail("You don't own that item.")
	end
	if isEquipped(data, id) then
		return Net.fail("Already equipped.")
	end
	local stats = self.Services.StatsService:Get(profile)
	if #data.Equipped >= stats.equipSlots then
		return Net.fail("All equip slots are full. Unequip something first.")
	end
	table.insert(data.Equipped, id)
	changed(self, profile, true)
	self.Services.QuestService:Refresh(profile)
	return Net.ok({ Equipped = data.Equipped })
end

function InventoryService:Unequip(profile, rawId: any)
	local id = Guard.id(rawId, Items.ById)
	local data = profile.Data
	local index = id and table.find(data.Equipped, id)
	if not index then
		return Net.fail("That item is not equipped.")
	end
	table.remove(data.Equipped, index)
	changed(self, profile, true)
	return Net.ok({ Equipped = data.Equipped })
end

function InventoryService:Score(itemId: string, count: number): number
	local item = Items.ById[itemId]
	return Formulas.itemPower(item, count) * (STAT_WEIGHT[item.Stat] or 0.5)
end

function InventoryService:EquipBest(profile)
	local data = profile.Data
	local stats = self.Services.StatsService:Get(profile)
	local owned = {}
	for id, count in pairs(data.Inventory) do
		if count > 0 and Items.ById[id] then
			table.insert(owned, { Id = id, Score = self:Score(id, count) })
		end
	end
	table.sort(owned, function(a, b)
		if a.Score == b.Score then
			return a.Id < b.Id
		end
		return a.Score > b.Score
	end)
	table.clear(data.Equipped)
	for i = 1, math.min(stats.equipSlots, #owned) do
		table.insert(data.Equipped, owned[i].Id)
	end
	changed(self, profile, true)
	self.Services.QuestService:Refresh(profile)
	return Net.ok({ Equipped = data.Equipped })
end

function InventoryService:Favorite(profile, rawId: any, rawState: any)
	local id = Guard.id(rawId, Items.ById)
	local state = Guard.boolean(rawState)
	local data = profile.Data
	if not id or state == nil or (data.Inventory[id] or 0) < 1 then
		return Net.fail("You don't own that item.")
	end
	data.Favorites[id] = if state then true else nil
	changed(self, profile, false)
	return Net.ok({ Id = id, State = state })
end

function InventoryService:_sell(profile, id: string, amount: number): number
	local data = profile.Data
	local item = Items.ById[id]
	local stats = self.Services.StatsService:Get(profile)
	local removed = DataOps.removeItem(data, id, amount)
	if removed <= 0 then
		return 0
	end
	local gems = Formulas.sellValue(item, removed, stats.gemMultiplier)
	self.Services.EconomyService:Add(profile, "Gems", gems, "sell")
	data.Stats.ItemsSold += removed
	self.Services.QuestService:Progress(profile, "ItemsSold", removed)
	return gems
end

function InventoryService:Sell(profile, rawId: any, rawAmount: any)
	local id = Guard.id(rawId, Items.ById)
	local data = profile.Data
	local owned = if id then data.Inventory[id] or 0 else 0
	if not id or owned < 1 then
		return Net.fail("You don't own that item.")
	end
	local amount = Guard.integer(rawAmount, 1, owned)
	if not amount then
		return Net.fail("Invalid amount.")
	end
	if data.Favorites[id] then
		return Net.fail("Unfavorite the item before selling it.")
	end
	local wasEquipped = isEquipped(data, id)
	local gems = self:_sell(profile, id, amount)
	changed(self, profile, wasEquipped)
	return Net.ok({ Id = id, Sold = amount, Gems = gems, Remaining = data.Inventory[id] or 0 })
end

-- Sells every copy beyond the first for non-favourite items up to a rarity.
function InventoryService:SellDuplicates(profile, rawMax: any)
	local maxRarity = Guard.integer(rawMax, 1, 7)
	if not maxRarity then
		return Net.fail("Invalid rarity.")
	end
	local data = profile.Data
	local totalGems, totalItems = 0, 0
	local touchedEquipped = false
	for id, count in pairs(table.clone(data.Inventory)) do
		local item = Items.ById[id]
		if item and count > 1 and item.RarityIndex <= maxRarity and not data.Favorites[id] then
			if isEquipped(data, id) then
				touchedEquipped = true
			end
			totalGems += self:_sell(profile, id, count - 1)
			totalItems += count - 1
		end
	end
	if totalItems == 0 then
		return Net.fail("No duplicates to sell.")
	end
	changed(self, profile, touchedEquipped)
	return Net.ok({ Sold = totalItems, Gems = totalGems })
end

--[[
	Fuses copies of one item: every Items.FuseCost copies become one copy of
	the next variant. Amount is how many results to make (or "max").
	Favourites are protected like for selling. If equipped copies are used
	up, the fused item takes over their equip slot.
]]
function InventoryService:Fuse(profile, rawId: any, rawAmount: any)
	local id = Guard.id(rawId, Items.ById)
	local data = profile.Data
	local owned = if id then data.Inventory[id] or 0 else 0
	if not id or owned < 1 then
		return Net.fail("You don't own that item.")
	end
	local resultId = Items.fuseResult(id)
	if not resultId then
		return Net.fail("Rainbow items can't be fused any further.")
	end
	local cost = Items.FuseCost
	local possible = math.floor(owned / cost)
	if possible < 1 then
		return Net.fail(`You need {cost} copies to fuse.`)
	end
	if data.Favorites[id] then
		return Net.fail("Unfavorite the item before fusing it.")
	end
	local amount = if rawAmount == "max" then possible else Guard.integer(rawAmount, 1, possible)
	if not amount then
		return Net.fail("Invalid amount.")
	end

	local slot = table.find(data.Equipped, id)
	DataOps.removeItem(data, id, amount * cost)
	local isNew = DataOps.addItem(data, resultId, amount)
	if slot and (data.Inventory[id] or 0) == 0 and not isEquipped(data, resultId) then
		table.insert(data.Equipped, math.min(slot, #data.Equipped + 1), resultId)
	end

	local result = Items.ById[resultId]
	data.Stats.ItemsFused += amount
	if result.Variant == "rainbow" then
		data.Stats.RainbowsFound += amount
		self.Services.Net.notifyAll("Rare", { Player = profile.Player.DisplayName, Item = resultId })
	end
	if isNew then
		self.Services.Net.notify(profile.Player, "Discovery", { Item = resultId })
	end
	self.Services.AchievementService:MarkDirty(profile)
	self.Services.StatsService:Invalidate(profile)
	self.Services.SyncService:MarkDirty(profile, "Inventory", "Equipped", "Favorites", "Discovered", "Stats")
	return Net.ok({ Id = id, Result = resultId, Fused = amount, Used = amount * cost, Count = data.Inventory[resultId] or 0 })
end

InventoryService.MaxSlots = GameConfig.Equip.MaxSlots

return InventoryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--[[
	LeaderboardService (ModuleScript)
	Location: ServerScriptService/Services/LeaderboardService
	Depends on: Shared/Config/GameConfig, Shared/Format, Core/Net, DataService

	* leaderstats for the Roblox player list (Ascensions, Sparks).
	* Global leaderboards in OrderedDataStores (lifetime Sparks, presses,
	  ascensions), written periodically and cached; failures are logged and
	  the last good cache is kept.
	* A live "this server" board computed from loaded profiles.

	OrderedDataStores only hold integers, so lifetime Sparks are stored as
	floor(log10(value + 1) * 1e6) and decoded for display.

	Action: GetLeaderboards {}
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Format)
local Net = require(script.Parent.Parent.Core.Net)

local CONFIG = GameConfig.Leaderboards

local LeaderboardService = {
	Name = "LeaderboardService",
	Cache = {} :: { [string]: { any } },
	UpdatedAt = 0,
	Available = false,
}

local stores: { [string]: OrderedDataStore } = {}
local nameCache: { [number]: string } = {}

local function encode(kind: string, value: number): number
	if kind == "log" then
		return math.floor(math.log10(math.max(0, value) + 1) * 1e6)
	end
	return math.floor(math.clamp(value, 0, 2 ^ 52))
end

local function decode(kind: string, value: number): number
	if kind == "log" then
		return 10 ^ (value / 1e6) - 1
	end
	return value
end

local function statValue(profile, stat: string): number
	if stat == "Rebirths" then
		return profile.Data.Rebirths
	end
	return profile.Data.Stats[stat] or 0
end

function LeaderboardService:Init(services)
	self.Services = services
	Net.registerAction("GetLeaderboards", {
		Rate = { Capacity = 3, Refill = 0.3 },
		Handler = function(profile)
			return Net.ok({
				Global = self.Cache,
				Server = self:ServerBoard(),
				UpdatedAt = self.UpdatedAt,
				Available = self.Available,
				Me = profile.UserId,
			})
		end,
	})
end

function LeaderboardService:Start()
	task.spawn(function()
		while true do
			task.wait(1)
			for _, profile in pairs(self.Services.DataService.Profiles) do
				self:_updateLeaderstats(profile)
			end
		end
	end)

	if not CONFIG.Enabled then
		return
	end
	local ok = pcall(function()
		for _, board in ipairs(CONFIG.Boards) do
			stores[board.Id] = DataStoreService:GetOrderedDataStore(CONFIG.StorePrefix .. board.Id)
		end
	end)
	self.Available = ok and self.Services.DataService:IsPersistent()
	if not self.Available then
		return
	end
	task.spawn(function()
		task.wait(15)
		while true do
			self:_publish()
			self:_refresh()
			task.wait(math.max(CONFIG.UpdateInterval, CONFIG.RefreshInterval))
		end
	end)
end

function LeaderboardService:OnProfileLoaded(profile)
	local player = profile.Player
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Ascensions"
	rebirths.Parent = folder
	local sparks = Instance.new("StringValue")
	sparks.Name = "Sparks"
	sparks.Parent = folder
	folder.Parent = player
	nameCache[player.UserId] = player.Name
	self:_updateLeaderstats(profile)
end

function LeaderboardService:OnProfileReleasing(profile)
	if self.Available and not profile.Temporary then
		task.spawn(function()
			self:_publishProfile(profile)
		end)
	end
end

function LeaderboardService:_updateLeaderstats(profile)
	local folder = profile.Player:FindFirstChild("leaderstats")
	if not folder then
		return
	end
	local rebirths = folder:FindFirstChild("Ascensions")
	local sparks = folder:FindFirstChild("Sparks")
	if rebirths and rebirths.Value ~= profile.Data.Rebirths then
		rebirths.Value = profile.Data.Rebirths
	end
	local text = Format.short(profile.Data.Currencies.Sparks)
	if sparks and sparks.Value ~= text then
		sparks.Value = text
	end
end

function LeaderboardService:_publishProfile(profile)
	for _, board in ipairs(CONFIG.Boards) do
		local store = stores[board.Id]
		local value = encode(board.Encode, statValue(profile, board.Stat))
		if store and value > 0 then
			local ok, err = pcall(function()
				store:SetAsync(tostring(profile.UserId), value)
			end)
			if not ok then
				warn(`[Leaderboards] Could not publish {board.Id} for {profile.UserId}: {err}`)
			end
		end
	end
end

function LeaderboardService:_publish()
	for _, profile in pairs(self.Services.DataService.Profiles) do
		if not profile.Temporary then
			self:_publishProfile(profile)
			task.wait(0.2)
		end
	end
end

local function resolveName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		nameCache[userId] = name
		return name
	end
	return "Player " .. tostring(userId)
end

function LeaderboardService:_refresh()
	for _, board in ipairs(CONFIG.Boards) do
		local store = stores[board.Id]
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, CONFIG.TopCount)
		end)
		if ok and pages then
			local entries = {}
			local okPage, page = pcall(function()
				return pages:GetCurrentPage()
			end)
			if okPage then
				for rank, entry in ipairs(page) do
					local userId = tonumber(entry.key)
					if userId then
						table.insert(entries, {
							Rank = rank,
							UserId = userId,
							Name = resolveName(userId),
							Value = decode(board.Encode, entry.value),
						})
					end
				end
				self.Cache[board.Id] = entries
			end
		else
			warn(`[Leaderboards] Could not refresh {board.Id}: {pages}`)
		end
	end
	self.UpdatedAt = os.time()
end

-- Live ranking of players in this server.
function LeaderboardService:ServerBoard()
	local out = {}
	for _, profile in pairs(self.Services.DataService.Profiles) do
		table.insert(out, {
			UserId = profile.UserId,
			Name = profile.Player.Name,
			DisplayName = profile.Player.DisplayName,
			LifetimeSparks = profile.Data.Stats.LifetimeSparks,
			TotalClicks = profile.Data.Stats.TotalClicks,
			Rebirths = profile.Data.Rebirths,
		})
	end
	table.sort(out, function(a, b)
		return a.LifetimeSparks > b.LifetimeSparks
	end)
	return out
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">ObbyService</string>
          <string name="Source"><![CDATA[--[[
	ObbyService (ModuleScript)
	Location: ServerScriptService/Services/ObbyService
	Depends on: Shared/Config/{Obby, GameConfig}, Shared/Format, Core/Net,
	            DataService, StatsService, EconomyService, SyncService,
	            SecurityService, Net

	A 15-stage obstacle course next to the plaza (east of it, rising into the
	sky). Players run it while their auto-presses and passive income keep
	earning in the background.

	Built at runtime unless Workspace already contains a model named "Obby"
	with Start, Checkpoint1..N-1 and Finish parts (then it is only wired up).

	Server-authoritative progress:
	  * The server samples every character's position (Obby.AntiCheat.SampleInterval)
	    instead of trusting any client message.
	  * Checkpoints only count in order, while alive, and only if the segment
	    took a plausible amount of time (distance / MaxTravelSpeed).
	  * A jump of more than TeleportDistance between two samples that the
	    server did not cause is flagged and freezes progress for a few seconds.
	  * Kill bricks and falling into the void send you back to your checkpoint.
	  * Rewards are paid here only; the client can merely ask to be moved to
	    its own saved checkpoint or back to the plaza (Action "ObbyTeleport").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ObbyConfig = require(Shared.Config.Obby)
local Format = require(Shared.Format)
local Core = script.Parent.Parent.Core
local Net = require(Core.Net)
local Guard = require(Core.Guard)

local AC = ObbyConfig.AntiCheat
local REWARDS = ObbyConfig.Rewards
local COUNT = ObbyConfig.StageCount

local ObbyService = { Name = "ObbyService" }

local NEON_CYAN = Color3.fromRGB(77, 225, 255)
local NEON_RED = Color3.fromRGB(255, 55, 85)
local GOLD = Color3.fromRGB(255, 205, 64)
local PLAZA_SPAWN = CFrame.lookAt(Vector3.new(0, 4, 36), Vector3.new(0, 4, 0))
-- The root part is ~3 studs above the feet, so kill volumes reach a bit higher than they look.
local KILL_MARGIN = Vector3.new(1, 3.3, 1)
-- After the server moves a character, the owning client can still report old
-- positions for a moment; those are not treated as teleports or deaths.
local SERVER_MOVE_GRACE = 1

-- Course building -------------------------------------------------------------------------------

local function part(props: { [string]: any }): BasePart
	local className = props.ClassName or "Part"
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		if key ~= "ClassName" and key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function label(parent: BasePart, text: string, height: number, color: Color3?, maxDistance: number?)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromOffset(260, 46)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or 140
	local text_ = Instance.new("TextLabel")
	text_.BackgroundTransparency = 1
	text_.Size = UDim2.fromScale(1, 1)
	text_.Font = Enum.Font.BuilderSansBold
	text_.TextScaled = true
	text_.TextColor3 = color or Color3.new(1, 1, 1)
	text_.TextStrokeTransparency = 0.5
	text_.Text = text
	text_.Parent = gui
	gui.Parent = parent
end

--[[
	A cursor walks along +X: x is the far edge of the last thing placed, y the
	height of its top surface. Builders place obstacles and advance it.
]]
local Builder = {}
Builder.__index = Builder

function Builder.new(model: Model, startX: number, topY: number)
	local self = setmetatable({}, Builder)
	self.Model = model
	self.X = startX
	self.Y = topY
	self.Stage = 1
	self.Kill = {} :: { BasePart }
	self.Pads = {} :: { BasePart }
	self.Movers = {} :: { any }
	self.MinY = topY
	self.MaxY = topY
	return self
end

function Builder:color(): Color3
	return Color3.fromHSV((0.9 + self.Stage * 0.045) % 1, 0.55, 0.5)
end

function Builder:gap(distance: number)
	self.X += distance
end

function Builder:platform(length: number, rise: number?, width: number?, z: number?): BasePart
	self.Y += rise or 0
	self.MinY = math.min(self.MinY, self.Y)
	self.MaxY = math.max(self.MaxY, self.Y)
	local p = part({
		Name = "Platform",
		Size = Vector3.new(length, 1, width or 6),
		CFrame = CFrame.new(self.X + length / 2, self.Y - 0.5, z or 0),
		Color = self:color(),
		Parent = self.Model,
	})
	self.X += length
	return p
end

-- A neon strip lying on the surface just walked (offset measured back from the cursor).
function Builder:killStrip(fromX: number, length: number, width: number)
	local p = part({
		Name = "Kill",
		Size = Vector3.new(length, 0.6, width),
		CFrame = CFrame.new(fromX + length / 2, self.Y + 0.25, 0),
		Color = NEON_RED,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = self.Model,
	})
	table.insert(self.Kill, p)
	return p
end

-- Kill floor below a gap (visible lava).
function Builder:lava(fromX: number, length: number, width: number, depth: number)
	local p = part({
		Name = "Kill",
		Size = Vector3.new(length, 1, width),
		CFrame = CFrame.new(fromX + length / 2, self.Y - depth, 0),
		Color = NEON_RED,
		Material = Enum.Material.Neon,
		Parent = self.Model,
	})
	table.insert(self.Kill, p)
	return p
end

--[[
	A platform sliding between two points with a PrismaticConstraint servo, so
	Roblox physics carries players standing on it.
]]
function Builder:mover(size: Vector3, from: Vector3, travel: Vector3, period: number)
	local distance = travel.Magnitude
	local axis = travel.Unit
	local up = if math.abs(axis.Y) > 0.9 then Vector3.xAxis else Vector3.yAxis
	-- The constraint slides along the attachments' primary (X) axis.
	local frame = CFrame.fromMatrix(Vector3.zero, axis, (up - axis * up:Dot(axis)).Unit)
	local base = part({
		Name = "MoverBase",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(from),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = self.Model,
	})
	local platform = part({
		Name = "Mover",
		Size = size,
		CFrame = CFrame.new(from),
		Color = NEON_CYAN,
		Material = Enum.Material.Neon,
		Anchored = false,
		Parent = self.Model,
	})
	local a0 = Instance.new("Attachment")
	a0.CFrame = frame
	a0.Parent = base
	local a1 = Instance.new("Attachment")
	a1.CFrame = frame
	a1.Parent = platform
	local prism = Instance.new("PrismaticConstraint")
	prism.Attachment0 = a0
	prism.Attachment1 = a1
	prism.ActuatorType = Enum.ActuatorType.Servo
	prism.ServoMaxForce = 1e8
	prism.Speed = distance / (period / 2)
	prism.LimitsEnabled = true
	prism.LowerLimit = 0
	prism.UpperLimit = distance
	prism.TargetPosition = 0
	prism.Parent = platform
	table.insert(self.Movers, { Constraint = prism, Distance = distance, Period = period, Part = platform })
	return platform
end

-- A bar spinning around a post (HingeConstraint motor). Touching the bar sends you back.
function Builder:spinner(center: Vector3, length: number, speed: number)
	part({
		Name = "SpinnerPost",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 2, 2),
		CFrame = CFrame.new(center + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(40, 36, 60),
		Parent = self.Model,
	})
	local hub = part({
		Name = "SpinnerHub",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(center + Vector3.new(0, 1.6, 0)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = self.Model,
	})
	local bar = part({
		Name = "Kill",
		Size = Vector3.new(length, 0.8, 0.8),
		CFrame = CFrame.new(center + Vector3.new(0, 1.6, 0)),
		Color = NEON_RED,
		Material = Enum.Material.Neon,
		Anchored = false,
		CanCollide = false,
		Parent = self.Model,
	})
	local vertical = CFrame.fromMatrix(Vector3.zero, Vector3.yAxis, Vector3.xAxis)
	local a0 = Instance.new("Attachment")
	a0.CFrame = vertical
	a0.Parent = hub
	local a1 = Instance.new("Attachment")
	a1.CFrame = vertical
	a1.Parent = bar
	local hinge = Instance.new("HingeConstraint")
	hinge.Attachment0 = a0
	hinge.Attachment1 = a1
	hinge.ActuatorType = Enum.ActuatorType.Motor
	hinge.AngularVelocity = speed
	hinge.MotorMaxTorque = 1e9
	hinge.MotorMaxAcceleration = 1e4
	hinge.Parent = bar
	table.insert(self.Kill, bar)
	table.insert(self.Movers, { Part = bar })
	return bar
end

function Builder:truss(height: number)
	local t = part({
		ClassName = "TrussPart",
		Name = "Truss",
		Size = Vector3.new(2, height, 2),
		CFrame = CFrame.new(self.X + 1, self.Y + height / 2, 0),
		Color = NEON_CYAN,
		Parent = self.Model,
	})
	self.X += 2
	self.Y += height
	self.MaxY = math.max(self.MaxY, self.Y)
	return t
end

-- Ends the current stage with a checkpoint (or the finish) pad.
function Builder:pad()
	self:gap(3)
	local finish = self.Stage == COUNT
	local size = if finish then 14 else 10
	local p = part({
		Name = if finish then "Finish" else "Checkpoint" .. self.Stage,
		Size = Vector3.new(size, 1, size),
		CFrame = CFrame.new(self.X + size / 2, self.Y - 0.5, 0),
		Color = if finish then GOLD else NEON_CYAN,
		Material = Enum.Material.Neon,
		Parent = self.Model,
	})
	p:SetAttribute("Stage", self.Stage)
	label(p, if finish then "🏆 FINISH" else `Stage {self.Stage} ✔ {ObbyConfig.StageNames[self.Stage + 1] or ""}`, 5, if finish then GOLD else nil)
	self.Pads[self.Stage] = p
	self.X += size
	self.Stage += 1
	return p
end

-- The 15 stages. Gaps stay jumpable with the default character (≤ 8 studs flat).
local STAGES = {
	function(b) -- First Steps
		for _ = 1, 4 do
			b:gap(4)
			b:platform(6)
		end
	end,
	function(b) -- Stairway
		for _ = 1, 5 do
			b:gap(3)
			b:platform(5, 2.5)
		end
	end,
	function(b) -- Hot Floor
		b:gap(3)
		local start = b.X
		b:platform(32)
		for _, offset in ipairs({ 7, 15, 23 }) do
			b:killStrip(start + offset, 2.5, 6)
		end
	end,
	function(b) -- Tightrope
		b:gap(3)
		b:platform(22, 0, 1.6)
		b:gap(3)
		b:platform(4)
		b:gap(3)
		b:platform(18, 0, 1.6)
	end,
	function(b) -- Ferry
		b:gap(3)
		b:platform(4)
		local gapStart = b.X
		b:gap(26)
		b:mover(Vector3.new(6, 1, 6), Vector3.new(gapStart + 3.5, b.Y - 0.5, 0), Vector3.new(19, 0, 0), 8)
		b:platform(4)
	end,
	function(b) -- Spinner
		b:gap(3)
		local start = b.X
		b:platform(16, 0, 16)
		b:spinner(Vector3.new(start + 8, b.Y, 0), 14, 1.4)
	end,
	function(b) -- Zigzag
		for i = 1, 5 do
			b:gap(3)
			b:platform(4, 1, 4, if i % 2 == 0 then 5 else -5)
		end
	end,
	function(b) -- Ladder
		b:gap(2)
		b:platform(6)
		b:truss(16)
		b:platform(8)
	end,
	function(b) -- Elevators
		b:gap(3)
		b:platform(4)
		b:gap(1)
		b:mover(Vector3.new(6, 1, 6), Vector3.new(b.X + 3, b.Y - 0.5, 0), Vector3.new(0, 10, 0), 7)
		b:gap(7)
		b:platform(4, 10)
		b:gap(1)
		b:mover(Vector3.new(6, 1, 6), Vector3.new(b.X + 3, b.Y - 0.5, 0), Vector3.new(0, 8, 0), 6)
		b:gap(7)
		b:platform(4, 8)
	end,
	function(b) -- Islands
		for _ = 1, 6 do
			b:gap(5)
			b:platform(3.5, 0.5, 3.5)
		end
	end,
	function(b) -- Double Spin
		b:gap(3)
		local start = b.X
		b:platform(30, 0, 12)
		b:spinner(Vector3.new(start + 9, b.Y, 0), 11, 1.6)
		b:spinner(Vector3.new(start + 21, b.Y, 0), 11, -1.9)
	end,
	function(b) -- Leap of Faith
		for _ = 1, 3 do
			b:gap(8)
			b:platform(6, -1)
		end
	end,
	function(b) -- Needle
		for _ = 1, 4 do
			b:gap(2.5)
			b:platform(10, 1, 1.4)
		end
	end,
	function(b) -- Lava Ferry
		b:gap(3)
		b:platform(4)
		local gapStart = b.X
		b:gap(24)
		b:lava(gapStart, 24, 14, 4)
		b:mover(Vector3.new(6, 1, 6), Vector3.new(gapStart + 3.5, b.Y - 0.5, 0), Vector3.new(17, 0, 0), 7)
		b:platform(4)
	end,
	function(b) -- Summit
		for _ = 1, 6 do
			b:gap(3)
			b:platform(4, 3, 4)
		end
	end,
}
assert(#STAGES == COUNT, "Obby.StageCount must match the number of stage builders")

function ObbyService:_build()
	local model = Instance.new("Model")
	model.Name = "Obby"

	-- Bridge from the plaza edge and the start pad (level with the plaza floor).
	part({ Name = "Bridge", Size = Vector3.new(10, 1, 6), CFrame = CFrame.new(113, -0.5, 0), Color = Color3.fromRGB(26, 24, 40), Parent = model })
	local start = part({
		Name = "Start",
		Size = Vector3.new(12, 1, 12),
		CFrame = CFrame.new(124, -0.5, 0),
		Color = Color3.fromRGB(26, 24, 40),
		Parent = model,
	})
	for _, z in ipairs({ -6.5, 6.5 }) do
		part({
			Name = "Gate",
			Size = Vector3.new(1, 12, 1),
			CFrame = CFrame.new(118, 6, z),
			Color = NEON_CYAN,
			Material = Enum.Material.Neon,
			Parent = model,
		})
	end
	part({ Name = "GateTop", Size = Vector3.new(1, 1, 14), CFrame = CFrame.new(118, 12.5, 0), Color = NEON_CYAN, Material = Enum.Material.Neon, Parent = model })
	-- Readable from the plaza spawn, so new players find the course.
	label(start, `🏃 OBBY · {COUNT} stages · rewards every checkpoint`, 9, NEON_CYAN, 320)

	local b = Builder.new(model, 130, 0)
	for _, build in ipairs(STAGES) do
		build(b)
		b:pad()
	end

	self.Model = model
	self.Start = start
	self.Pads = b.Pads
	self.Kill = b.Kill
	self.Movers = b.Movers
	self.Bounds = {
		Min = Vector3.new(100, b.MinY - 60, -40),
		Max = Vector3.new(b.X + 20, b.MaxY + 60, 40),
	}
	model.Parent = workspace

	for _, mover in ipairs(b.Movers) do
		pcall(function()
			mover.Part:SetNetworkOwner(nil)
		end)
	end
end

-- Wires up an existing Workspace.Obby built by hand in Studio.
function ObbyService:_adopt(model: Model)
	self.Model = model
	self.Start = model:FindFirstChild("Start") :: BasePart
	self.Pads = {}
	for stage = 1, COUNT - 1 do
		self.Pads[stage] = model:FindFirstChild("Checkpoint" .. stage) :: BasePart
	end
	self.Pads[COUNT] = model:FindFirstChild("Finish") :: BasePart
	self.Kill = {}
	self.Movers = {}
	local minY, maxY, minX, maxX = math.huge, -math.huge, math.huge, -math.huge
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Name == "Kill" then
				table.insert(self.Kill, d)
			end
			minY = math.min(minY, d.Position.Y)
			maxY = math.max(maxY, d.Position.Y)
			minX = math.min(minX, d.Position.X)
			maxX = math.max(maxX, d.Position.X)
		end
	end
	self.Bounds = { Min = Vector3.new(minX - 20, minY - 60, -200), Max = Vector3.new(maxX + 20, maxY + 60, 200) }
	assert(self.Start and self.Pads[COUNT], "Workspace.Obby needs parts named Start, Checkpoint1.. and Finish")
end

-- Movers swing between their end points.
function ObbyService:_runMovers()
	for _, mover in ipairs(self.Movers) do
		local prism = mover.Constraint
		if prism then
			task.spawn(function()
				local atEnd = false
				while prism.Parent do
					task.wait(mover.Period / 2)
					atEnd = not atEnd
					prism.TargetPosition = if atEnd then mover.Distance else 0
				end
			end)
		end
	end
end

-- Lifecycle ----------------------------------------------------------------------------------------

function ObbyService:Init(services)
	self.Services = services
	Net.registerAction("ObbyTeleport", {
		Rate = ObbyConfig.TeleportRate,
		Handler = function(profile, payload)
			return self:Teleport(profile, payload.To)
		end,
	})
end

function ObbyService:Start()
	local existing = workspace:FindFirstChild("Obby")
	if existing and existing:IsA("Model") then
		self:_adopt(existing)
	else
		self:_build()
	end
	self:_runMovers()

	local debounce: { [Player]: number } = {}
	for _, kill in ipairs(self.Kill) do
		kill.Touched:Connect(function(hit)
			local character = hit.Parent
			local player = character and Players:GetPlayerFromCharacter(character)
			if not player or (debounce[player] and os.clock() - debounce[player] < 0.5) then
				return
			end
			debounce[player] = os.clock()
			local profile = self.Services.DataService:GetProfile(player)
			if profile then
				self:RespawnAtCheckpoint(profile)
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		debounce[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(AC.SampleInterval)
			for _, profile in pairs(self.Services.DataService.Profiles) do
				local ok, err = pcall(self._sample, self, profile)
				if not ok then
					warn(`[ObbyService] Sample failed for {profile.UserId}: {err}`)
				end
			end
		end
	end)
end

function ObbyService:OnProfileLoaded(profile)
	local rt = profile.Runtime
	rt.Obby = { LastPos = nil, ReachedAt = os.clock(), SuspectUntil = 0, GraceUntil = 0 }
	local player = profile.Player
	player.CharacterAdded:Connect(function(character)
		self:_onCharacter(profile, character)
	end)
	if player.Character then
		self:_onCharacter(profile, player.Character)
	end
end

-- Respawning mid-run puts you back on your checkpoint.
function ObbyService:_onCharacter(profile, character: Model)
	local rt = profile.Runtime.Obby
	if rt then
		rt.LastPos = nil
	end
	if profile.Data.Obby.Stage <= 0 then
		return
	end
	task.spawn(function()
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and character.Parent and self.Services.DataService:GetProfile(profile.Player) == profile then
			self:_moveTo(profile, self:CheckpointCFrame(profile.Data.Obby.Stage))
		end
	end)
end

-- Positions --------------------------------------------------------------------------------------

-- Where a player stands for a stage (0 = start pad).
function ObbyService:CheckpointCFrame(stage: number): CFrame
	local pad = if stage <= 0 then self.Start else self.Pads[math.min(stage, COUNT)]
	local position = pad.Position + Vector3.new(0, pad.Size.Y / 2 + 3, 0)
	return CFrame.lookAt(position, position + Vector3.xAxis)
end

function ObbyService:_moveTo(profile, target: CFrame)
	local character = profile.Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not root then
		return false
	end
	character:PivotTo(target)
	root.AssemblyLinearVelocity = Vector3.zero
	local rt = profile.Runtime.Obby
	if rt then
		rt.LastPos = target.Position
		rt.GraceUntil = os.clock() + SERVER_MOVE_GRACE
	end
	return true
end

function ObbyService:RespawnAtCheckpoint(profile)
	return self:_moveTo(profile, self:CheckpointCFrame(profile.Data.Obby.Stage))
end

local function inside(part: BasePart, position: Vector3, margin: Vector3): boolean
	local localPos = part.CFrame:PointToObjectSpace(position)
	local half = part.Size / 2 + margin
	return math.abs(localPos.X) <= half.X and math.abs(localPos.Y) <= half.Y and math.abs(localPos.Z) <= half.Z
end

-- Standing on a pad: within its footprint and up to a few studs above it.
local function onPad(pad: BasePart, position: Vector3): boolean
	local localPos = pad.CFrame:PointToObjectSpace(position)
	local half = pad.Size / 2
	return math.abs(localPos.X) <= half.X + 0.5 and math.abs(localPos.Z) <= half.Z + 0.5 and localPos.Y >= 0 and localPos.Y <= half.Y + 6
end

function ObbyService:_inBounds(position: Vector3): boolean
	local min, max = self.Bounds.Min, self.Bounds.Max
	return position.X >= min.X and position.X <= max.X and position.Y >= min.Y and position.Y <= max.Y and position.Z >= min.Z and position.Z <= max.Z
end

-- Sampling and progress --------------------------------------------------------------------------


function ObbyService:_sample(profile)
	local rt = profile.Runtime.Obby
	local character = profile.Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not rt or not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	local now = os.clock()
	local position = root.Position
	local grace = now < rt.GraceUntil

	-- Teleport detection (only movement the server did not cause).
	if rt.LastPos and not grace and (position - rt.LastPos).Magnitude > AC.TeleportDistance then
		rt.SuspectUntil = now + AC.SuspectSeconds
		if self:_inBounds(position) or self:_inBounds(rt.LastPos) then
			self.Services.SecurityService:Flag(profile.Player, "ObbyTeleport", `{math.floor((position - rt.LastPos).Magnitude)} studs`)
		end
	end
	rt.LastPos = position

	if grace or not self:_inBounds(position) then
		return
	end
	local data = profile.Data.Obby

	-- Void and kill bricks.
	local checkpoint = self:CheckpointCFrame(data.Stage)
	if position.Y < checkpoint.Position.Y - AC.VoidDepth - 3 then
		self:RespawnAtCheckpoint(profile)
		return
	end
	for _, kill in ipairs(self.Kill) do
		if inside(kill, position, KILL_MARGIN) then
			self:RespawnAtCheckpoint(profile)
			return
		end
	end

	-- Standing on the start pad (re)starts the clock for stage 1.
	if data.Stage == 0 and onPad(self.Start, position) then
		rt.ReachedAt = now
		return
	end

	local nextStage = data.Stage + 1
	local pad = self.Pads[nextStage]
	if not pad or not onPad(pad, position) then
		return
	end
	if now < rt.SuspectUntil then
		return
	end
	local from = if data.Stage == 0 then self.Start.Position else self.Pads[data.Stage].Position
	local minSeconds = math.max(AC.MinSegmentSeconds, (pad.Position - from).Magnitude / AC.MaxTravelSpeed)
	if now - rt.ReachedAt < minSeconds then
		self.Services.SecurityService:Flag(profile.Player, "ObbyTooFast", `stage {nextStage} in {Format.time(now - rt.ReachedAt)}`)
		rt.SuspectUntil = now + AC.SuspectSeconds
		return
	end
	rt.ReachedAt = now
	self:_reach(profile, nextStage)
end

function ObbyService:_reach(profile, stage: number)
	local data = profile.Data.Obby
	local economy = self.Services.EconomyService
	local base = self.Services.StatsService:GetBase(profile).clickValue
	data.Checkpoints += 1

	local gems = 0
	if stage > data.Best then
		data.Best = stage
		gems += if stage % 5 == 0 then REWARDS.MilestoneGems else REWARDS.FirstClearGems
	end

	local sparks, text
	if stage >= COUNT then
		data.Completions += 1
		data.Stage = 0
		sparks = base * REWARDS.FinishPresses
		gems += REWARDS.FinishGems
		if data.Completions == 1 then
			gems += REWARDS.FirstFinishGems
		end
		gems += REWARDS.CompletionMilestones[data.Completions] or 0
		text = `OBBY COMPLETE! (#{data.Completions})`
	else
		data.Stage = stage
		sparks = base * REWARDS.CheckpointPresses * stage
		text = `Stage {stage} cleared!`
	end

	economy:AddSparks(profile, sparks, "obby")
	if gems > 0 then
		economy:Add(profile, "Gems", gems, "obby")
	end
	self.Services.SyncService:MarkDirty(profile, "Obby")
	local reward = `+{Format.short(sparks)} ⚡` .. (if gems > 0 then ` +{gems} 💎` else "")
	self.Services.Net.notify(profile.Player, "Toast", {
		Icon = if stage >= COUNT then "🏆" else "🏁",
		Text = `{text} {reward}`,
	})
	if stage >= COUNT then
		task.delay(3, function()
			if self.Services.DataService:GetProfile(profile.Player) == profile then
				self:_moveTo(profile, PLAZA_SPAWN)
			end
		end)
	end
end

-- Action: move to your own checkpoint (or the start) or back to the plaza.
function ObbyService:Teleport(profile, rawTo: any)
	local to = Guard.oneOf(rawTo, { "checkpoint", "plaza" })
	if not to then
		return Net.fail("Invalid request.")
	end
	local humanoid = profile.Player.Character and profile.Player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return Net.fail("Wait until you have respawned.")
	end
	local target = if to == "plaza" then PLAZA_SPAWN else self:CheckpointCFrame(profile.Data.Obby.Stage)
	if not self:_moveTo(profile, target) then
		return Net.fail("Wait until you have respawned.")
	end
	if to == "checkpoint" then
		-- The clock for the next checkpoint starts again from here.
		profile.Runtime.Obby.ReachedAt = os.clock()
	end
	return Net.ok({ Stage = profile.Data.Obby.Stage })
end

return ObbyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">OrbService</string>
          <string name="Source"><![CDATA[--[[
	OrbService (ModuleScript)
	Location: ServerScriptService/Services/OrbService
	Depends on: Shared/Config/{GameConfig,Chests}, Shared/Util, Core/Net, Core/Guard,
	            Core/DataOps, EconomyService, StatsService, SyncService, QuestService

	Bonus orbs: every 70–140 seconds (shorter with Orb Magnet) the server
	offers a player an orb that floats onto their screen for a few seconds.
	The server remembers the only valid orb id and its expiry, so orbs cannot
	be invented, claimed twice or claimed late by a modified client.

	Action: ClaimOrb { Id: integer }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Chests = require(Shared.Config.Chests)
local Util = require(Shared.Util)
local Core = script.Parent.Parent.Core
local Net = require(Core.Net)
local Guard = require(Core.Guard)
local DataOps = require(Core.DataOps)

local ORBS = GameConfig.Orbs

local OrbService = { Name = "OrbService" }

local rng = Random.new()

function OrbService:Init(services)
	self.Services = services
	Net.registerAction("ClaimOrb", {
		Rate = { Capacity = 3, Refill = 0.5 },
		Handler = function(profile, payload)
			return self:Claim(profile, payload.Id)
		end,
	})
end

function OrbService:Start()
	if not ORBS.Enabled then
		return
	end
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for _, profile in pairs(self.Services.DataService.Profiles) do
				local rt = profile.Runtime
				if rt.Orb and now > rt.Orb.ExpiresAt + ORBS.ClaimGrace then
					rt.Orb = nil
					self:_schedule(profile, false)
				elseif not rt.Orb and rt.NextOrbAt and now >= rt.NextOrbAt then
					self:_spawn(profile)
				end
			end
		end
	end)
end

function OrbService:OnProfileLoaded(profile)
	profile.Runtime.OrbCounter = 0
	self:_schedule(profile, true)
end

function OrbService:_schedule(profile, first: boolean)
	local stats = self.Services.StatsService:Get(profile)
	local delay = if first then rng:NextNumber(30, 60) else rng:NextNumber(ORBS.MinInterval, ORBS.MaxInterval)
	profile.Runtime.NextOrbAt = os.clock() + delay * stats.orbIntervalMultiplier
end

function OrbService:_spawn(profile)
	local rt = profile.Runtime
	rt.OrbCounter += 1
	rt.Orb = { Id = rt.OrbCounter, ExpiresAt = os.clock() + ORBS.Lifetime }
	self.Services.Net.fire(profile.Player, "OrbSpawn", {
		Id = rt.Orb.Id,
		Lifetime = ORBS.Lifetime,
		X = rng:NextNumber(0.18, 0.82),
		Y = rng:NextNumber(0.25, 0.7),
	})
end

function OrbService:Claim(profile, rawId: any)
	local id = Guard.integer(rawId, 1, 1e9)
	local rt = profile.Runtime
	local orb = rt.Orb
	if not id or not orb or orb.Id ~= id then
		return Net.fail("That orb is gone.")
	end
	if os.clock() > orb.ExpiresAt + ORBS.ClaimGrace then
		rt.Orb = nil
		self:_schedule(profile, false)
		return Net.fail("Too slow! The orb faded.")
	end
	rt.Orb = nil
	self:_schedule(profile, false)

	local stats = self.Services.StatsService:Get(profile)
	local reward = Util.weightedPick(rng, ORBS.Rewards)
	local result = { Type = reward.Type }
	local economy = self.Services.EconomyService
	if reward.Type == "Sparks" then
		local amount = math.max(stats.clickValue * reward.MinClicks, stats.passivePerSec * reward.IncomeSeconds)
			* stats.orbRewardMultiplier
		economy:AddSparks(profile, amount, "orb")
		result.Amount = amount
	elseif reward.Type == "Gems" then
		local gems = math.floor(rng:NextInteger(reward.Min, reward.Max) * stats.gemMultiplier * stats.orbRewardMultiplier)
		economy:Add(profile, "Gems", gems, "orb")
		result.Amount = gems
	elseif reward.Type == "Chest" then
		local chestId = Chests.bestSparksChestForStage(stats.stage)
		DataOps.addChest(profile.Data, chestId, 1)
		self.Services.SyncService:MarkDirty(profile, "Chests")
		result.Chest = chestId
	elseif reward.Type == "Frenzy" then
		self.Services.StatsService:StartFrenzy(profile, reward.Multiplier, reward.Duration)
		result.Multiplier = reward.Multiplier
		result.Duration = reward.Duration
	end

	profile.Data.Stats.OrbsCollected += 1
	self.Services.SyncService:MarkDirty(profile, "Stats")
	self.Services.QuestService:Progress(profile, "OrbsCollected", 1)
	self.Services.AchievementService:MarkDirty(profile)
	return Net.ok({ Reward = result })
end

return OrbService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">ProductService</string>
          <string name="Source"><![CDATA[--[[
	ProductService (ModuleScript)
	Location: ServerScriptService/Services/ProductService
	Depends on: Shared/Config/{DevProducts,GamePasses,Chests}, Shared/RobuxSale, Shared/Formulas, Shared/Format,
	            Core/DataOps, DataService, EconomyService, StatsService, SyncService,
	            ChestService (Robux crates), Net

	Developer products (repeatable Robux purchases) through
	MarketplaceService.ProcessReceipt, plus the countdown of bought timed boosts,
	one-time rewards of game passes (GrantPassReward) and the check with Roblox
	whether each configured ID is a pass or a product (ResolveSales).

	Roblox keeps retrying a receipt until it is answered with PurchaseGranted
	(also after the player rejoins), so ProcessReceipt follows these rules:
	  * Unknown product, player not in this server, data not loaded yet, or a
	    session that cannot save (temporary, lock lost, leaving)
	    → NotProcessedYet; Roblox asks again later.
	  * Every receipt's PurchaseId is stored in the player's data (the newest
	    DevProducts.ReceiptHistory). A receipt already in that list is never
	    granted a second time.
	  * The reward is saved right away and PurchaseGranted is returned only
	    after that save succeeded. If it fails, NotProcessedYet; on the retry
	    the stored PurchaseId prevents a second grant and the save runs again.
	The client can only open Roblox's purchase prompt; nothing it sends can
	grant a product.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DevProducts = require(Shared.Config.DevProducts)
local GamePasses = require(Shared.Config.GamePasses)
local Chests = require(Shared.Config.Chests)
local RobuxSale = require(Shared.RobuxSale)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Format)
local DataOps = require(script.Parent.Parent.Core.DataOps)

local ProductService = { Name = "ProductService" }

local SAVE_WAIT_SECONDS = 30

function ProductService:Init(services)
	self.Services = services
end

function ProductService:Start()
	MarketplaceService.ProcessReceipt = function(receipt)
		return self:ProcessReceipt(receipt)
	end
	task.spawn(self.ResolveSales, self)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local now = os.clock()
			self:_tickBoosts(now - last)
			last = now
		end
	end)
end

-- Boosts --------------------------------------------------------------------------------

-- Bought boosts only count down while their owner is in a server.
function ProductService:_tickBoosts(dt: number)
	for _, profile in pairs(self.Services.DataService.Profiles) do
		local boosts = profile.Data.Boosts
		if next(boosts) then
			for key, left in pairs(boosts) do
				local remaining = left - dt
				if remaining > 0 then
					boosts[key] = remaining
				else
					boosts[key] = nil
					self.Services.StatsService:Invalidate(profile)
					self.Services.SyncService:MarkDirty(profile, "Boosts")
					local product = DevProducts.ByKey[key]
					self.Services.Net.notify(profile.Player, "Toast", {
						Text = `{if product then product.Name else "Boost"} has ended.`,
						Icon = if product then product.Icon else "⏱️",
					})
				end
			end
		end
	end
end

-- Granting --------------------------------------------------------------------------------

-- The most valuable Sparks crate this player has unlocked.
function ProductService:BestCrate(data)
	local best = nil
	for _, chest in ipairs(Chests.List) do
		if chest.Currency == "Sparks" and Formulas.chestUnlocked(chest, data) and (best == nil or chest.Price > best.Price) then
			best = chest
		end
	end
	return best
end

-- Applies every reward of a product. Returns a short description for the toast.
function ProductService:Grant(profile, product): string
	local data = profile.Data
	local services = self.Services
	local parts = {}
	if product.Sparks then
		-- Exactly what the name says: no multipliers, and it does not count toward
		-- quests or the ascension run total.
		DataOps.addCurrency(data, "Sparks", product.Sparks)
		services.SyncService:MarkDirty(profile, "Currencies")
		table.insert(parts, `+{Format.commas(product.Sparks)} Sparks`)
	end
	if product.Gems then
		services.EconomyService:Add(profile, "Gems", product.Gems, "robux")
		table.insert(parts, `+{Format.commas(product.Gems)} Gems`)
	end
	if product.Boost then
		local before = data.Boosts[product.Key] or 0
		local total = math.min(DevProducts.MaxBoostSeconds, before + product.Boost.Seconds)
		data.Boosts[product.Key] = total
		services.StatsService:Invalidate(profile)
		services.SyncService:MarkDirty(profile, "Boosts")
		table.insert(parts, `{product.Name} active for {Format.clock(total)}`)
	end
	if product.Crates then
		local chest = self:BestCrate(data)
		if chest then
			DataOps.addChest(data, chest.Id, product.Crates)
			services.SyncService:MarkDirty(profile, "Chests")
			table.insert(parts, `+{product.Crates} {chest.Name}`)
		end
	end
	if product.Crate then
		-- Rolled and applied on the server; the client only plays the animation.
		local results = services.ChestService:OpenRobuxCrate(profile, product.Crate)
		services.Net.notify(profile.Player, "CrateOpened", { Chest = product.Crate, Results = results })
		local first = results[1]
		table.insert(parts, if first then `{product.Name}: {first.Rarity}` else product.Name)
	end
	return if #parts > 0 then table.concat(parts, ", ") else product.Description
end

--[[
	One-time reward of a product sold as a game pass. Granted at most once per
	player (data.PassRewards), whether the pass was bought just now or the
	ownership check on join finds it. Returns true when it was granted now.
]]
function ProductService:GrantPassReward(profile, product): boolean
	local data = profile.Data
	if data.PassRewards[product.Key] then
		return false
	end
	-- Recorded before anything can yield, so two callers can never both grant it.
	data.PassRewards[product.Key] = true
	local summary = self:Grant(profile, product)
	self.Services.SyncService:MarkDirty(profile, "PassRewards")
	if not product.Crate then
		self.Services.Net.notify(profile.Player, "Reward", { Title = `{product.Icon} {product.Name}`, Text = summary })
	end
	task.spawn(self.Services.DataService.SaveNow, self.Services.DataService, profile)
	return true
end

-- Sale kinds ---------------------------------------------------------------------------------

local function nameOf(id: number, infoType: Enum.InfoType): string?
	local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, infoType)
	if ok and type(info) == "table" and type(info.Name) == "string" then
		return info.Name
	end
	return nil
end

--[[
	For entries with a HubName, asks Roblox whether the configured ID is a game
	pass or a developer product (matching the name, so an unrelated item with
	the same number never counts) and publishes the answer (Shared/RobuxSale).
	If Roblox can't tell, the config decides.
]]
function ProductService:ResolveSales()
	local entries = {}
	for _, pass in ipairs(GamePasses.List) do
		table.insert(entries, pass)
	end
	for _, product in ipairs(DevProducts.List) do
		table.insert(entries, product)
	end
	for _, entry in ipairs(entries) do
		local kind, id = RobuxSale.configured(entry)
		if kind and entry.HubName then
			local resolved = nil
			if nameOf(id, Enum.InfoType.GamePass) == entry.HubName then
				resolved = "pass"
			elseif nameOf(id, Enum.InfoType.Product) == entry.HubName then
				resolved = "product"
			end
			if resolved == nil then
				warn(`[ProductService] Could not confirm "{entry.HubName}" ({id}) with Roblox; selling it as a {kind}.`)
			elseif resolved ~= kind then
				warn(`[ProductService] "{entry.HubName}" ({id}) is a {resolved} on Roblox, not a {kind}; selling it as a {resolved}.`)
			end
			RobuxSale.publish(entry, resolved or kind, id)
		elseif kind then
			RobuxSale.publish(entry, kind, id)
		end
	end
	RobuxSale.markResolved()
end

-- Saves now and reports whether the save (with the latest data) succeeded.
function ProductService:_save(profile): boolean
	-- A queued save merges new requests; wait for it so this one really runs.
	local deadline = os.clock() + SAVE_WAIT_SECONDS
	while profile.SaveQueued and os.clock() < deadline do
		task.wait(0.1)
	end
	if profile.SaveQueued then
		return false
	end
	return self.Services.DataService:SaveNow(profile)
end

local function canSave(profile): boolean
	return not (profile.Temporary or profile.LockLost or profile.Releasing or profile.Released)
end

function ProductService:ProcessReceipt(receipt): Enum.ProductPurchaseDecision
	local notYet = Enum.ProductPurchaseDecision.NotProcessedYet
	local granted = Enum.ProductPurchaseDecision.PurchaseGranted
	if type(receipt) ~= "table" then
		return notYet
	end
	local purchaseId = receipt.PurchaseId
	local product = DevProducts.byProductId(receipt.ProductId)
	-- An effect pass sold as a developer product: bought once, kept forever.
	local pass = if product then nil else GamePasses.byProductId(receipt.ProductId)
	if not (product or pass) or type(purchaseId) ~= "string" or purchaseId == "" or #purchaseId > 100 then
		warn(`[ProductService] Receipt for unknown or unconfigured product {tostring(receipt.ProductId)}; leaving it for later.`)
		return notYet
	end
	if type(receipt.PlayerId) ~= "number" then
		return notYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return notYet
	end
	local DataService = self.Services.DataService
	local profile = DataService:GetProfile(player) or DataService:WaitForProfile(player, 20)
	if not profile or not canSave(profile) then
		return notYet
	end

	local data = profile.Data
	if table.find(data.Receipts, purchaseId) then
		-- Granted on an earlier attempt; make sure that grant is saved.
		return if self:_save(profile) then granted else notYet
	end

	-- No yields between the check above and recording the ID, so a receipt
	-- delivered twice at the same time is still granted once.
	if product then
		local summary = self:Grant(profile, product)
		if not product.Crate then
			self.Services.Net.notify(player, "Reward", { Title = `{product.Icon} {product.Name}`, Text = summary })
		end
	elseif not data.Passes[pass.Key] then
		data.Passes[pass.Key] = true
		self.Services.StatsService:Invalidate(profile)
		self.Services.SyncService:MarkDirty(profile, "Passes")
		self.Services.Net.notify(player, "Pass", { Key = pass.Key })
	end
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > DevProducts.ReceiptHistory do
		table.remove(data.Receipts, 1)
	end

	if self:_save(profile) then
		return granted
	end
	warn(`[ProductService] Could not save purchase {purchaseId} for {player.UserId} yet; Roblox will retry.`)
	return notYet
end

return ProductService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">ProgressionService</string>
          <string name="Source"><![CDATA[--[[
	ProgressionService (ModuleScript)
	Location: ServerScriptService/Services/ProgressionService
	Depends on: Shared/Config/{Skills,Ascension,Rewards,Items,GameConfig}, Shared/Formulas,
	            Shared/Util, Core/Net, Core/Guard, EconomyService, StatsService, SyncService,
	            QuestService, AchievementService, ClickService, DataService

	Long-term progression:
	  * Skill tree   UnlockSkill { Id }, ResetSkills {}
	  * Ascension    Rebirth {}, BuyAscension { Id }
	  * Collection   ClaimCollection { Id }
	  * Daily login  ClaimDaily {}

	What ascending (rebirth) RESETS:
	    Sparks (set to the Head Start amount), all Shop upgrade levels (Auto-Presser
	    is kept with the "Loyal Robots" perk), Sparks earned this run, current combo.
	What ascending KEEPS:
	    Gems, Prisms, Ascension perks, skill tree and Skill Points, level and XP,
	    inventory, equipped items, favourites, collection/discoveries, owned crates,
	    pity counters, achievements, quests, daily streak, statistics, settings.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Skills = require(Shared.Config.Skills)
local Ascension = require(Shared.Config.Ascension)
local Rewards = require(Shared.Config.Rewards)
local Items = require(Shared.Config.Items)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Format)
local Util = require(Shared.Util)
local Core = script.Parent.Parent.Core
local Net = require(Core.Net)
local Guard = require(Core.Guard)
local DataOps = require(Core.DataOps)

local ProgressionService = { Name = "ProgressionService" }

function ProgressionService:Init(services)
	self.Services = services
	Net.registerAction("UnlockSkill", {
		Rate = { Capacity = 10, Refill = 5 },
		Handler = function(profile, payload)
			return self:UnlockSkill(profile, payload.Id)
		end,
	})
	Net.registerAction("ResetSkills", {
		Rate = { Capacity = 2, Refill = 0.2 },
		Handler = function(profile)
			return self:ResetSkills(profile, false)
		end,
	})
	Net.registerAction("Rebirth", {
		Rate = { Capacity = 2, Refill = 0.2 },
		Handler = function(profile)
			return self:Rebirth(profile)
		end,
	})
	Net.registerAction("BuyAscension", {
		Rate = { Capacity = 10, Refill = 5 },
		Handler = function(profile, payload)
			return self:BuyAscension(profile, payload.Id)
		end,
	})
	Net.registerAction("ClaimCollection", {
		Rate = { Capacity = 5, Refill = 1 },
		Handler = function(profile, payload)
			return self:ClaimCollection(profile, payload.Id)
		end,
	})
	Net.registerAction("ClaimDaily", {
		Rate = { Capacity = 3, Refill = 0.5 },
		Handler = function(profile)
			return self:ClaimDaily(profile)
		end,
	})
end

-- Skills ------------------------------------------------------------------------

function ProgressionService:UnlockSkill(profile, rawId: any)
	local id = Guard.id(rawId, Skills.ById)
	if not id then
		return Net.fail("Unknown skill.")
	end
	local node = Skills.ById[id]
	local data = profile.Data
	local rank = data.Skills[id] or 0
	if rank >= node.MaxRank then
		return Net.fail("Skill already maxed.")
	end
	if not Skills.prerequisitesMet(node, data.Skills) then
		return Net.fail("Unlock a connected skill first.")
	end
	local cost = Skills.costFor(node, rank)
	if data.SkillPoints < cost then
		return Net.fail(`Not enough Skill Points. Need {cost}.`)
	end
	data.SkillPoints -= cost
	data.Skills[id] = rank + 1
	self.Services.StatsService:Invalidate(profile)
	self.Services.SyncService:MarkDirty(profile, "Skills", "Progress")
	self.Services.QuestService:Refresh(profile)
	self.Services.AchievementService:MarkDirty(profile)
	return Net.ok({ Id = id, Rank = rank + 1 })
end

-- free = true is used by admin tools (no Gem cost).
function ProgressionService:ResetSkills(profile, free: boolean)
	local data = profile.Data
	local refund = Formulas.skillPointsSpent(data)
	if refund <= 0 then
		return Net.fail("No skills to reset.")
	end
	local cost = GameConfig.Skills.RespecGemCost
	if not free and not self.Services.EconomyService:Spend(profile, "Gems", cost) then
		return Net.fail(`Resetting skills costs {cost} Gems.`)
	end
	table.clear(data.Skills)
	data.SkillPoints += refund
	self.Services.StatsService:Invalidate(profile)
	self.Services.SyncService:MarkDirty(profile, "Skills", "Progress", "Equipped")
	return Net.ok({ Refunded = refund })
end

-- Ascension ------------------------------------------------------------------------

function ProgressionService:PreviewRebirth(profile)
	local data = profile.Data
	local stats = self.Services.StatsService:Get(profile)
	local requirement = Formulas.rebirthRequirement(data.Rebirths)
	return {
		Requirement = requirement,
		Progress = data.Stats.SparksThisRun,
		Prisms = Formulas.rebirthPrisms(data.Stats.SparksThisRun, data.Rebirths, stats.prismMultiplier),
	}
end

--[[
	Applies an ascension. force = true (admin) skips the requirement and
	grants the given number of prisms instead of the computed amount.
]]
function ProgressionService:ApplyRebirth(profile, prisms: number)
	local data = profile.Data
	local stageBefore = Formulas.stageFor(data.Rebirths).Id
	local stats = self.Services.StatsService:Get(profile)

	local keptAuto = if stats.keepAuto then data.Upgrades.auto_presser else nil
	table.clear(data.Upgrades)
	if keptAuto then
		data.Upgrades.auto_presser = keptAuto
	end
	DataOps.setCurrency(data, "Sparks", 0)
	data.Stats.SparksThisRun = 0
	data.Rebirths += 1
	if prisms > 0 then
		self.Services.EconomyService:Add(profile, "Prisms", prisms, "rebirth")
	end
	self.Services.ClickService:ResetCombo(profile)
	self.Services.StatsService:Invalidate(profile)

	-- Head Start: computed after the reset so it reflects the perk level.
	local fresh = self.Services.StatsService:Get(profile)
	if fresh.startSparks > 0 then
		DataOps.setCurrency(data, "Sparks", fresh.startSparks)
	end

	self.Services.SyncService:MarkDirty(profile, "Currencies", "Upgrades", "Stats", "Progress")
	self.Services.QuestService:Refresh(profile)
	self.Services.AchievementService:MarkDirty(profile)

	local stageAfter = Formulas.stageFor(data.Rebirths).Id
	if stageAfter > stageBefore then
		self.Services.Net.notify(profile.Player, "Stage", { Stage = stageAfter })
	end
	task.spawn(function()
		self.Services.DataService:SaveNow(profile)
	end)
	return stageAfter
end

function ProgressionService:Rebirth(profile)
	local preview = self:PreviewRebirth(profile)
	if preview.Progress < preview.Requirement then
		return Net.fail(`Earn {Format.short(preview.Requirement)} Sparks this run to ascend.`)
	end
	local stage = self:ApplyRebirth(profile, preview.Prisms)
	return Net.ok({ Prisms = preview.Prisms, Rebirths = profile.Data.Rebirths, Stage = stage })
end

function ProgressionService:BuyAscension(profile, rawId: any)
	local id = Guard.id(rawId, Ascension.ById)
	if not id then
		return Net.fail("Unknown perk.")
	end
	local def = Ascension.ById[id]
	local data = profile.Data
	local level = data.Ascension[id] or 0
	if level >= def.MaxLevel then
		return Net.fail("Already at max level.")
	end
	local cost = Formulas.ascensionCost(def, level)
	if not self.Services.EconomyService:Spend(profile, "Prisms", cost) then
		return Net.fail(`Not enough Prisms. Need {Format.short(cost)}.`)
	end
	data.Ascension[id] = level + 1
	self.Services.StatsService:Invalidate(profile)
	self.Services.SyncService:MarkDirty(profile, "Ascension")
	return Net.ok({ Id = id, Level = level + 1, Cost = cost })
end

-- Collection book -------------------------------------------------------------------

function ProgressionService:ClaimCollection(profile, rawId: any)
	local id = Guard.id(rawId, Rewards.CollectionById)
	if not id then
		return Net.fail("Unknown milestone.")
	end
	local data = profile.Data
	if data.CollectionClaimed[id] then
		return Net.fail("Already claimed.")
	end
	local milestone = Rewards.CollectionById[id]
	local need = if milestone.Count < 0 then Items.Count else milestone.Count
	if Formulas.discoveredCount(data) < need then
		return Net.fail(`Discover {need} items to claim this.`)
	end
	data.CollectionClaimed[id] = true
	local granted = self.Services.EconomyService:GrantReward(profile, milestone.Reward, "collection")
	self.Services.SyncService:MarkDirty(profile, "CollectionClaimed")
	return Net.ok({ Reward = granted })
end

-- Daily login rewards ------------------------------------------------------------------

function ProgressionService:ClaimDaily(profile)
	local data = profile.Data
	local today = Util.dayNumber(os.time())
	local daily = data.Daily
	if daily.LastClaimDay == today then
		return Net.fail(`Come back in {Format.time(Util.secondsUntilNextDay(os.time()))}.`)
	end
	if daily.LastClaimDay == today - 1 then
		daily.Streak += 1
	else
		daily.Streak = 1
	end
	daily.LastClaimDay = today
	if daily.Streak > data.Stats.BestDailyStreak then
		data.Stats.BestDailyStreak = daily.Streak
	end
	local entry = Rewards.Daily[((daily.Streak - 1) % #Rewards.Daily) + 1]
	local granted = self.Services.EconomyService:GrantReward(profile, entry.Reward, "daily")
	self.Services.SyncService:MarkDirty(profile, "Daily", "Stats")
	return Net.ok({ Day = entry.Day, Streak = daily.Streak, Reward = granted })
end

return ProgressionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[--[[
	QuestService (ModuleScript)
	Location: ServerScriptService/Services/QuestService
	Depends on: Shared/Config/Quests, Shared/Formulas, Shared/Util, EconomyService,
	            StatsService, SyncService, AchievementService, Net

	Daily quests (new set every UTC day, deterministic per player) and the
	Starter Path tutorial chain. Progress is reported by gameplay services via
	Progress(profile, kind, amount); rewards are claimed through actions and
	validated here.

	Actions: ClaimQuest { Index }, ClaimQuestBonus {}, ClaimStarter {}
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Quests = require(Shared.Config.Quests)
local Formulas = require(Shared.Formulas)
local Util = require(Shared.Util)
local Core = script.Parent.Parent.Core
local Net = require(Core.Net)
local Guard = require(Core.Guard)

local QuestService = { Name = "QuestService" }

-- Current values for starter-path "check" kinds.
local STARTER_CHECKS = {
	ReachLevel = function(data)
		return data.Level
	end,
	RunSparks = function(data)
		return data.Stats.SparksThisRun
	end,
	Equip = function(data)
		return #data.Equipped
	end,
	SkillUnlocked = function(data)
		return Formulas.skillRanks(data)
	end,
	Rebirth = function(data)
		return data.Rebirths
	end,
}

function QuestService:Init(services)
	self.Services = services

	Net.registerAction("ClaimQuest", {
		Rate = { Capacity = 6, Refill = 2 },
		Handler = function(profile, payload)
			return self:_claimDaily(profile, payload)
		end,
	})
	Net.registerAction("ClaimQuestBonus", {
		Rate = { Capacity = 3, Refill = 1 },
		Handler = function(profile)
			return self:_claimBonus(profile)
		end,
	})
	Net.registerAction("ClaimStarter", {
		Rate = { Capacity = 4, Refill = 1 },
		Handler = function(profile)
			return self:_claimStarter(profile)
		end,
	})
end

function QuestService:Start()
	task.spawn(function()
		local elapsed = 0
		while true do
			task.wait(5)
			elapsed += 5
			for _, profile in pairs(self.Services.DataService.Profiles) do
				self:EnsureDaily(profile)
				self:Refresh(profile)
				local rt = profile.Runtime
				rt.QuestPlaySeconds = (rt.QuestPlaySeconds or 0) + 5
				if rt.QuestPlaySeconds >= 60 then
					rt.QuestPlaySeconds -= 60
					self:Progress(profile, "PlayMinutes", 1)
				end
			end
		end
	end)
end

function QuestService:OnProfileLoaded(profile)
	self:EnsureDaily(profile)
	self:Refresh(profile)
end

-- Generates today's quests if the stored set is from another day.
function QuestService:EnsureDaily(profile)
	local data = profile.Data
	local day = Util.dayNumber(os.time())
	if data.Quests.Day == day and #data.Quests.Daily > 0 then
		return
	end
	local rng = Random.new(profile.UserId * 1000003 + day)
	local pool = table.clone(Quests.Daily)
	-- Base stats (no events or Frenzy), so a boost active at reset cannot inflate the targets.
	local stats = self.Services.StatsService:GetBase(profile)
	local list = {}
	for _ = 1, math.min(Quests.DailyCount, #pool) do
		local index = rng:NextInteger(1, #pool)
		local template = table.remove(pool, index)
		table.insert(list, {
			Id = template.Id,
			Target = Formulas.questTarget(template, data.Rebirths, stats.clickValue),
			Progress = 0,
			Claimed = false,
		})
	end
	data.Quests.Day = day
	data.Quests.Daily = list
	data.Quests.BonusClaimed = false
	self.Services.SyncService:MarkDirty(profile, "Quests")
end

function QuestService:Progress(profile, kind: string, amount: number)
	local data = profile.Data
	local changed = false
	local isMax = Quests.MaxKinds[kind] == true

	for _, q in ipairs(data.Quests.Daily) do
		local def = Quests.DailyById[q.Id]
		if def and def.Kind == kind and not q.Claimed and q.Progress < q.Target then
			local value = if isMax then math.max(q.Progress, amount) else q.Progress + amount
			q.Progress = math.min(q.Target, value)
			changed = true
		end
	end

	local step = Quests.Starter[data.Quests.StarterIndex]
	if step and step.Kind == kind and not Quests.CheckKinds[kind] and data.Quests.StarterProgress < step.Target then
		local value = if isMax then math.max(data.Quests.StarterProgress, amount) else data.Quests.StarterProgress + amount
		data.Quests.StarterProgress = math.min(step.Target, value)
		changed = true
	end

	if changed then
		self.Services.SyncService:MarkDirty(profile, "Quests")
	end
end

-- Re-evaluates check-based starter steps.
function QuestService:Refresh(profile)
	local data = profile.Data
	local step = Quests.Starter[data.Quests.StarterIndex]
	if not step then
		return
	end
	local check = STARTER_CHECKS[step.Kind]
	if check then
		local value = math.min(step.Target, check(data))
		if value ~= data.Quests.StarterProgress then
			data.Quests.StarterProgress = value
			self.Services.SyncService:MarkDirty(profile, "Quests")
		end
	end
end

function QuestService:_claimDaily(profile, payload)
	local index = Guard.integer(payload.Index, 1, Quests.DailyCount)
	if not index then
		return Net.fail("Invalid quest.")
	end
	self:EnsureDaily(profile)
	local data = profile.Data
	local q = data.Quests.Daily[index]
	if not q then
		return Net.fail("Invalid quest.")
	end
	if q.Claimed then
		return Net.fail("Already claimed.")
	end
	if q.Progress < q.Target then
		return Net.fail("Quest not complete yet.")
	end
	local def = Quests.DailyById[q.Id]
	q.Claimed = true
	data.Stats.QuestsCompleted += 1
	local granted = self.Services.EconomyService:GrantReward(profile, def.Reward, "quest")
	self.Services.SyncService:MarkDirty(profile, "Quests", "Stats")
	self.Services.AchievementService:MarkDirty(profile)
	return Net.ok({ Reward = granted })
end

function QuestService:_claimBonus(profile)
	local data = profile.Data
	if data.Quests.BonusClaimed then
		return Net.fail("Bonus already claimed today.")
	end
	if #data.Quests.Daily == 0 then
		return Net.fail("No quests today.")
	end
	for _, q in ipairs(data.Quests.Daily) do
		if not q.Claimed then
			return Net.fail("Claim every daily quest first.")
		end
	end
	data.Quests.BonusClaimed = true
	local granted = self.Services.EconomyService:GrantReward(profile, Quests.DailyBonus, "quest")
	self.Services.SyncService:MarkDirty(profile, "Quests")
	return Net.ok({ Reward = granted })
end

function QuestService:_claimStarter(profile)
	local data = profile.Data
	self:Refresh(profile)
	local step = Quests.Starter[data.Quests.StarterIndex]
	if not step then
		return Net.fail("Starter path complete.")
	end
	if data.Quests.StarterProgress < step.Target then
		return Net.fail("Step not complete yet.")
	end
	data.Quests.StarterIndex += 1
	data.Quests.StarterProgress = 0
	local granted = self.Services.EconomyService:GrantReward(profile, step.Reward, "quest")
	self:Refresh(profile)
	self.Services.SyncService:MarkDirty(profile, "Quests")
	return Net.ok({ Reward = granted })
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">SecurityService</string>
          <string name="Source"><![CDATA[--[[
	SecurityService (ModuleScript)
	Location: ServerScriptService/Services/SecurityService

	Records suspicious client behaviour (malformed remote calls, unknown
	actions, click floods, unauthorised admin requests). Flags are kept in a
	bounded in-memory ring buffer that the Admin Panel can display, and are
	written to the server output with rate limiting so a flood cannot spam
	the logs. Repeats of the same reason from the same player within
	MERGE_SECONDS update one entry, so a single flooder cannot push everyone
	else's flags out of the buffer. Nothing here punishes players
	automatically; admins decide.
]]

local Players = game:GetService("Players")

local MAX_RECENT = 300
local OUTPUT_PER_MINUTE = 6
local MERGE_SECONDS = 30

local SecurityService = {
	Name = "SecurityService",
	Recent = {} :: { any },
	Counts = {} :: { [number]: { [string]: number } },
	TotalFlags = 0,
}

local outputBudget: { [number]: { count: number, windowStart: number } } = {}
-- Newest buffer entry per "userId:reason", for merging repeats.
local lastEntry: { [string]: any } = {}

function SecurityService:Init(services)
	self.Services = services
	Players.PlayerRemoving:Connect(function(player)
		outputBudget[player.UserId] = nil
	end)
end

local function record(self, player: Player, severity: string, reason: string, detail: any)
	local userId = player.UserId
	local counts = self.Counts[userId]
	if not counts then
		counts = {}
		self.Counts[userId] = counts
	end
	counts[reason] = (counts[reason] or 0) + 1

	if severity == "note" then
		return
	end
	self.TotalFlags += 1
	local key = `{userId}:{reason}`
	local entry = lastEntry[key]
	local nowUnix = os.time()
	if entry and nowUnix - entry.Time <= MERGE_SECONDS then
		entry.Time = nowUnix
		entry.Detail = string.sub(tostring(detail), 1, 120)
		entry.Count = counts[reason]
	else
		entry = {
			Time = nowUnix,
			UserId = userId,
			Name = player.Name,
			Reason = reason,
			Detail = string.sub(tostring(detail), 1, 120),
			Count = counts[reason],
		}
		lastEntry[key] = entry
		table.insert(self.Recent, entry)
		if #self.Recent > MAX_RECENT then
			local removed = table.remove(self.Recent, 1)
			local removedKey = `{removed.UserId}:{removed.Reason}`
			if lastEntry[removedKey] == removed then
				lastEntry[removedKey] = nil
			end
		end
	end

	local now = os.clock()
	local budget = outputBudget[userId]
	if not budget or now - budget.windowStart > 60 then
		budget = { count = 0, windowStart = now }
		outputBudget[userId] = budget
	end
	budget.count += 1
	if budget.count <= OUTPUT_PER_MINUTE then
		warn(`[Security] {player.Name} ({userId}) {reason}: {entry.Detail} (x{counts[reason]})`)
	end
end

-- Suspicious behaviour worth an admin's attention.
function SecurityService:Flag(player: Player, reason: string, detail: any?)
	record(self, player, "flag", reason, detail)
end

-- Expected-but-noteworthy behaviour (e.g. a rate-limited request). Counted only.
function SecurityService:Note(player: Player, reason: string, detail: any?)
	record(self, player, "note", reason, detail)
end

function SecurityService:GetRecent(limit: number?)
	local n = math.min(limit or 50, #self.Recent)
	local out = {}
	for i = #self.Recent, #self.Recent - n + 1, -1 do
		table.insert(out, self.Recent[i])
	end
	return out
end

function SecurityService:GetCounts(userId: number)
	return self.Counts[userId] or {}
end

return SecurityService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">SettingsService</string>
          <string name="Source"><![CDATA[--[[
	SettingsService (ModuleScript)
	Location: ServerScriptService/Services/SettingsService
	Depends on: Shared/Config/GameConfig, Core/Net, Core/Guard, SyncService

	Persists player preferences (volumes, reduced motion, UI scale, ...).
	Every key and value is validated against GameConfig.Settings.

	Actions: UpdateSettings { Key, Value }, RequestState {}
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Core = script.Parent.Parent.Core
local Net = require(Core.Net)
local Guard = require(Core.Guard)

local SettingsService = { Name = "SettingsService" }

function SettingsService:Init(services)
	self.Services = services
	Net.registerAction("UpdateSettings", {
		Rate = { Capacity = 20, Refill = 5 },
		Handler = function(profile, payload)
			return self:Update(profile, payload.Key, payload.Value)
		end,
	})
	-- Lets a client that connected late ask for a fresh full snapshot.
	Net.registerAction("RequestState", {
		Rate = { Capacity = 2, Refill = 0.2 },
		Handler = function(profile)
			self.Services.SyncService:SendFull(profile)
			return Net.ok()
		end,
	})
end

function SettingsService:Update(profile, rawKey: any, rawValue: any)
	local key = Guard.id(rawKey, GameConfig.Settings, 32)
	if not key then
		return Net.fail("Unknown setting.")
	end
	local def = GameConfig.Settings[key]
	local value
	if type(def.Default) == "boolean" then
		value = Guard.boolean(rawValue)
	elseif key == "AutoSell" then
		value = Guard.integer(rawValue, def.Min, def.Max)
	else
		value = Guard.number(rawValue, def.Min, def.Max)
	end
	if value == nil then
		return Net.fail("Invalid value.")
	end
	profile.Data.Settings[key] = value
	self.Services.SyncService:MarkDirty(profile, "Settings")
	return Net.ok({ Key = key, Value = value })
end

return SettingsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">StatsService</string>
          <string name="Source"><![CDATA[--[[
	StatsService (ModuleScript)
	Location: ServerScriptService/Services/StatsService
	Depends on: Shared/Formulas, DataService, SyncService, EventService

	Caches each player's computed Stats (see Shared/Formulas.computeStats) and
	recomputes them only when something relevant changes (Invalidate). Also
	owns personal timed boosts ("Frenzy") from golden presses and orbs.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Formulas)
local DataOps = require(script.Parent.Parent.Core.DataOps)

local StatsService = { Name = "StatsService" }

function StatsService:Init(services)
	self.Services = services
end

function StatsService:Start()
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = workspace:GetServerTimeNow()
			for _, profile in pairs(self.Services.DataService.Profiles) do
				local rt = profile.Runtime
				if rt.FrenzyEndsAt and now >= rt.FrenzyEndsAt then
					rt.FrenzyEndsAt = nil
					rt.FrenzyMultiplier = nil
					self:Invalidate(profile)
				end
			end
		end
	end)
end

function StatsService:Context(profile)
	local rt = profile.Runtime
	return {
		Events = self.Services.EventService:ActiveList(),
		FrenzyMultiplier = rt.FrenzyMultiplier,
	}
end

function StatsService:Get(profile): Formulas.Stats
	if profile.Stats == nil or profile.StatsDirty then
		profile.Stats = Formulas.computeStats(profile.Data, self:Context(profile))
		profile.StatsDirty = false
		-- Losing slots (e.g. after a respec) must never leave extra items equipped.
		if #profile.Data.Equipped > profile.Stats.equipSlots then
			DataOps.trimEquipped(profile.Data, profile.Stats.equipSlots)
			self.Services.SyncService:MarkDirty(profile, "Equipped")
			profile.Stats = Formulas.computeStats(profile.Data, self:Context(profile))
		end
	end
	return profile.Stats
end

-- Stats without temporary boosts (used for offline earnings and quest targets).
-- Game passes are permanent and count; timed boosts bought with Robux do not.
function StatsService:GetBase(profile): Formulas.Stats
	return Formulas.computeStats(profile.Data, { Events = {}, ExcludeTimedBoosts = true })
end

function StatsService:Invalidate(profile)
	profile.StatsDirty = true
	self.Services.SyncService:MarkDirty(profile, "Derived")
end

function StatsService:InvalidateAll()
	for _, profile in pairs(self.Services.DataService.Profiles) do
		self:Invalidate(profile)
	end
end

function StatsService:StartFrenzy(profile, multiplier: number, duration: number)
	local rt = profile.Runtime
	local now = workspace:GetServerTimeNow()
	local current = rt.FrenzyEndsAt or now
	-- Stacking extends the duration; the multiplier keeps the strongest value.
	rt.FrenzyEndsAt = math.max(current, now) + duration
	rt.FrenzyMultiplier = math.max(rt.FrenzyMultiplier or 1, multiplier)
	self:Invalidate(profile)
end

function StatsService:BuildDerived(profile)
	local stats = self:Get(profile)
	local data = profile.Data
	local rt = profile.Runtime
	-- Bought timed boosts only tick while playing, so the client gets an end time
	-- from "now + seconds left"; it is refreshed whenever Derived is rebuilt.
	local boostEndsAt = {}
	local now = workspace:GetServerTimeNow()
	for key, left in pairs(data.Boosts or {}) do
		if type(left) == "number" and left > 0 then
			boostEndsAt[key] = now + left
		end
	end
	return {
		Stats = stats,
		RebirthRequirement = Formulas.rebirthRequirement(data.Rebirths),
		FrenzyEndsAt = rt.FrenzyEndsAt,
		FrenzyMultiplier = rt.FrenzyMultiplier,
		BoostEndsAt = boostEndsAt,
		Persistent = not profile.Temporary,
	}
end

function StatsService:OnProfileLoaded(profile)
	self:Get(profile)
end

return StatsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">SyncService</string>
          <string name="Source"><![CDATA[--[[
	SyncService (ModuleScript)
	Location: ServerScriptService/Services/SyncService
	Depends on: Shared/Remotes, StatsService

	Replicates a player's OWN data to their client. Services mark sections
	dirty; a loop sends only the dirty sections as a patch every
	GameConfig.Sync.Interval seconds. The client never sends data back — it
	only reads this mirror to render the UI.

	Sections: every key in DataSchema.Sections plus "Progress" (level, XP,
	skill points, ascensions) and "Derived" (computed stats).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Formulas)
local DataSchema = require(script.Parent.Parent.Core.DataSchema)

local SyncService = { Name = "SyncService" }

local ALL_SECTIONS = table.clone(DataSchema.Sections)
table.insert(ALL_SECTIONS, "Derived")

function SyncService:Init(services)
	self.Services = services
end

function SyncService:Start()
	task.spawn(function()
		while true do
			task.wait(GameConfig.Sync.Interval)
			for _, profile in pairs(self.Services.DataService.Profiles) do
				if next(profile.Dirty) ~= nil then
					self:_flush(profile)
				end
			end
		end
	end)
end

function SyncService:MarkDirty(profile, ...: string)
	for i = 1, select("#", ...) do
		profile.Dirty[select(i, ...)] = true
	end
end

function SyncService:BuildSection(profile, name: string)
	local data = profile.Data
	if name == "Progress" then
		return {
			Level = data.Level,
			XP = data.XP,
			SkillPoints = data.SkillPoints,
			Rebirths = data.Rebirths,
			XPRequired = Formulas.xpForLevel(data.Level),
		}
	elseif name == "Derived" then
		return self.Services.StatsService:BuildDerived(profile)
	end
	return data[name]
end

function SyncService:_flush(profile)
	local patch = {}
	for name in pairs(profile.Dirty) do
		patch[name] = self:BuildSection(profile, name)
	end
	table.clear(profile.Dirty)
	self.Services.Net.fire(profile.Player, "StateSync", "patch", patch)
end

function SyncService:SendFull(profile)
	local snapshot = {}
	for _, name in ipairs(ALL_SECTIONS) do
		snapshot[name] = self:BuildSection(profile, name)
	end
	table.clear(profile.Dirty)
	self.Services.Net.fire(profile.Player, "StateSync", "full", snapshot)
end

return SyncService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">TutorialService</string>
          <string name="Source"><![CDATA[--[[
	TutorialService (ModuleScript)
	Location: ServerScriptService/Services/TutorialService
	Depends on: Shared/Config/Tutorial, Core/Net, EconomyService, SyncService, Net

	Runs the first-time tutorial (steps in Config/Tutorial). The server decides
	when a step is done by looking at the player's real data, e.g. "TotalClicks
	grew by 10 since this step started". The client may only send intents:
	  TutorialSeen     { Step = id }  completes the CURRENT step if it is a "seen" step
	  TutorialSkip     {}             ends the tutorial (no reward)
	  TutorialRestart  {}             replays it from step 1 (reward only once ever)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tutorial = require(Shared.Config.Tutorial)
local Core = script.Parent.Parent.Core
local Net = require(Core.Net)
local Guard = require(Core.Guard)

local TutorialService = { Name = "TutorialService" }

local CHECK_INTERVAL = 0.5

-- The saved counter a "stat" step watches.
local function counter(data, stat: string): number
	if stat == "ObbyCheckpoints" then
		return data.Obby.Checkpoints
	end
	return data.Stats[stat] or 0
end

function TutorialService:Init(services)
	self.Services = services
	Net.registerAction("TutorialSeen", {
		Rate = { Capacity = 4, Refill = 1 },
		Handler = function(profile, payload)
			return self:Seen(profile, payload.Step)
		end,
	})
	Net.registerAction("TutorialSkip", {
		Rate = { Capacity = 2, Refill = 0.2 },
		Handler = function(profile)
			return self:Skip(profile)
		end,
	})
	Net.registerAction("TutorialRestart", {
		Rate = { Capacity = 2, Refill = 0.1 },
		Handler = function(profile)
			return self:Restart(profile)
		end,
	})
end

function TutorialService:Start()
	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)
			for _, profile in pairs(self.Services.DataService.Profiles) do
				if not profile.Data.Tutorial.Done then
					self:Check(profile)
				end
			end
		end
	end)
end

function TutorialService:OnProfileLoaded(profile)
	local state = profile.Data.Tutorial
	if not state.Done and state.Step == 1 and state.Base == 0 then
		self:_begin(profile, 1)
	end
end

-- Starts a step: remembers the watched counter so only NEW progress counts.
function TutorialService:_begin(profile, index: number)
	local state = profile.Data.Tutorial
	local step = Tutorial.Steps[index]
	state.Step = index
	state.Base = if step and step.Kind == "stat" then counter(profile.Data, step.Stat) else 0
	self.Services.SyncService:MarkDirty(profile, "Tutorial")
end

function TutorialService:_complete(profile)
	local state = profile.Data.Tutorial
	local index = state.Step
	if index < #Tutorial.Steps then
		self:_begin(profile, index + 1)
		return
	end
	state.Done = true
	state.Skipped = false
	self.Services.SyncService:MarkDirty(profile, "Tutorial")
	if not state.Rewarded then
		state.Rewarded = true
		self.Services.EconomyService:GrantReward(profile, Tutorial.Reward, "tutorial")
		self.Services.Net.notify(profile.Player, "Toast", { Icon = "🎓", Text = `Tutorial complete! +{Tutorial.Reward.Gems} 💎` })
	else
		self.Services.Net.notify(profile.Player, "Toast", { Icon = "🎓", Text = "Tutorial complete!" })
	end
end

-- Completes the current step if the player really did it.
function TutorialService:Check(profile)
	local state = profile.Data.Tutorial
	local step = Tutorial.Steps[state.Step]
	if state.Done or not step then
		return
	end
	local data = profile.Data
	local done = false
	if step.Kind == "stat" then
		done = counter(data, step.Stat) - state.Base >= step.Amount
	elseif step.Kind == "equip" then
		done = #data.Equipped > 0
	end
	if done then
		self:_complete(profile)
	end
end

function TutorialService:Seen(profile, rawStep: any)
	local state = profile.Data.Tutorial
	local stepId = Guard.id(rawStep, Tutorial.ById)
	local step = Tutorial.Steps[state.Step]
	if state.Done or not stepId or not step or step.Id ~= stepId or step.Kind ~= "seen" then
		-- Only the step that is active right now, and only "look at this" steps.
		return Net.fail("That tutorial step is not active.")
	end
	self:_complete(profile)
	return Net.ok({ Step = profile.Data.Tutorial.Step, Done = profile.Data.Tutorial.Done })
end

function TutorialService:Skip(profile)
	local state = profile.Data.Tutorial
	if state.Done then
		return Net.ok({ Done = true })
	end
	state.Done = true
	state.Skipped = true
	self.Services.SyncService:MarkDirty(profile, "Tutorial")
	return Net.ok({ Done = true })
end

function TutorialService:Restart(profile)
	local state = profile.Data.Tutorial
	state.Done = false
	state.Skipped = false
	self:_begin(profile, 1)
	return Net.ok({ Step = 1 })
end

return TutorialService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">UpgradeService</string>
          <string name="Source"><![CDATA[--[[
	UpgradeService (ModuleScript)
	Location: ServerScriptService/Services/UpgradeService
	Depends on: Shared/Config/Upgrades, Shared/Formulas, Core/Net, Core/Guard,
	            EconomyService, StatsService, SyncService, QuestService, AchievementService

	Shop upgrades bought with Sparks. Prices, requirements and maximum levels
	come from config; the client only sends which upgrade and how many.

	Action: BuyUpgrade { Id: string, Amount: 1 | 10 | "max" }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Upgrades = require(Shared.Config.Upgrades)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Format)
local Core = script.Parent.Parent.Core
local Net = require(Core.Net)
local Guard = require(Core.Guard)

local UpgradeService = { Name = "UpgradeService" }

function UpgradeService:Init(services)
	self.Services = services
	Net.registerAction("BuyUpgrade", {
		Rate = { Capacity = 15, Refill = 8 },
		Handler = function(profile, payload)
			return self:Buy(profile, payload.Id, payload.Amount)
		end,
	})
end

function UpgradeService:Buy(profile, rawId: any, rawAmount: any)
	local id = Guard.id(rawId, Upgrades.ById)
	if not id then
		return Net.fail("Unknown upgrade.")
	end
	local amount = if rawAmount == "max" then "max" else Guard.oneOf(rawAmount, { 1, 10 })
	if amount == nil then
		return Net.fail("Invalid amount.")
	end
	local def = Upgrades.ById[id]
	local data = profile.Data
	if not Formulas.upgradeUnlocked(def, data) then
		return Net.fail(Formulas.requirementText(Upgrades.Tiers[def.Tier].Requirement) .. ".")
	end
	local level = data.Upgrades[id] or 0
	if level >= def.MaxLevel then
		return Net.fail("Already at max level.")
	end

	local count, cost
	local balance = data.Currencies[def.Currency] or 0
	if amount == "max" then
		count, cost = Formulas.maxAffordable(def, level, balance)
		if count == 0 then
			return Net.fail(`Not enough {def.Currency}. Need {Format.short(Formulas.upgradeLevelCost(def, level))}.`)
		end
	else
		count = math.min(amount, def.MaxLevel - level)
		cost = Formulas.upgradeCost(def, level, count)
	end

	if not self.Services.EconomyService:Spend(profile, def.Currency, cost) then
		return Net.fail(`Not enough {def.Currency}. Need {Format.short(cost)}.`)
	end

	data.Upgrades[id] = level + count
	data.Stats.UpgradesPurchased += count
	self.Services.StatsService:Invalidate(profile)
	self.Services.SyncService:MarkDirty(profile, "Upgrades", "Stats")
	self.Services.QuestService:Progress(profile, "UpgradesBought", count)
	self.Services.AchievementService:MarkDirty(profile)
	return Net.ok({ Id = id, Level = level + count, Count = count, Cost = cost })
end

return UpgradeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[--[[
	WorldService (ModuleScript)
	Location: ServerScriptService/Services/WorldService
	Depends on: Shared/Remotes, Shared/Format, Shared/Config/GameConfig, ClickService

	Builds the 3D lobby at runtime if Workspace has no model named "Arena":
	a dark neon plaza with a giant button, a spawn pad, pillars and a sign.
	To use your own map, add a Model named "Arena" (with a SpawnLocation) to
	Workspace and this service leaves it untouched.

	Also publishes server activity every second through ReplicatedStorage/
	ServerState attributes (ServerCPS, ServerPresses, Players), which clients
	use to pulse the giant button so everyone sees each other's presses.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Remotes = require(Shared.Remotes)
local Format = require(Shared.Format)

local WorldService = {
	Name = "WorldService",
	ServerPresses = 0,
}

local ACCENT = GameConfig.Stages[1].Accent
local DARK = Color3.fromRGB(14, 14, 22)
local PANEL = Color3.fromRGB(26, 24, 40)

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		(p :: any)[key] = value
	end
	return p
end

local VERTICAL = CFrame.Angles(0, 0, math.rad(90))

function WorldService:Init(services)
	self.Services = services
end

function WorldService:Start()
	if not workspace:FindFirstChild("Arena") then
		self:_build()
		self:_lighting()
	end
	local state = Remotes.serverState()
	task.spawn(function()
		while true do
			task.wait(1)
			local click = self.Services.ClickService
			local cps = click.ServerClicksThisSecond
			click.ServerClicksThisSecond = 0
			self.ServerPresses += cps
			state:SetAttribute("ServerCPS", cps)
			state:SetAttribute("ServerPresses", self.ServerPresses)
			state:SetAttribute("Players", #Players:GetPlayers())
			if self.StatsLabel then
				self.StatsLabel.Text = `⚡ {cps}/s  ·  {Format.commas(self.ServerPresses)} presses in this server`
			end
		end
	end)
end

function WorldService:_build()
	local arena = Instance.new("Model")
	arena.Name = "Arena"

	part({ Name = "Floor", Size = Vector3.new(220, 2, 220), CFrame = CFrame.new(0, -1, 0), Color = DARK }).Parent = arena
	part({
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 96, 96),
		CFrame = CFrame.new(0, 0.1, 0) * VERTICAL,
		Color = PANEL,
	}).Parent = arena

	local ring = Instance.new("Model")
	ring.Name = "NeonRing"
	local segments = 72
	local radius = 48
	for i = 1, segments do
		local angle = (i / segments) * math.pi * 2
		part({
			Name = "Segment",
			Size = Vector3.new(2 * math.pi * radius / segments + 0.1, 0.3, 0.8),
			CFrame = CFrame.new(0, 0.3, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius),
			Color = ACCENT,
			Material = Enum.Material.Neon,
			CanCollide = false,
		}).Parent = ring
	end
	ring.Parent = arena

	local button = Instance.new("Model")
	button.Name = "GiantButton"
	part({
		Name = "Pedestal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6, 30, 30),
		CFrame = CFrame.new(0, 3, 0) * VERTICAL,
		Color = Color3.fromRGB(32, 30, 50),
		Material = Enum.Material.Metal,
	}).Parent = button
	part({
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, 31, 31),
		CFrame = CFrame.new(0, 6.1, 0) * VERTICAL,
		Color = ACCENT,
		Material = Enum.Material.Neon,
		CanCollide = false,
	}).Parent = button
	local cap = part({
		Name = "Cap",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3.4, 23, 23),
		CFrame = CFrame.new(0, 7.8, 0) * VERTICAL,
		Color = ACCENT,
		Material = Enum.Material.Neon,
	})
	cap:SetAttribute("BaseY", 7.8)
	local light = Instance.new("PointLight")
	light.Name = "Glow"
	light.Color = ACCENT
	light.Range = 45
	light.Brightness = 2
	light.Parent = cap
	cap.Parent = button

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ServerStats"
	billboard.Size = UDim2.fromOffset(420, 60)
	billboard.StudsOffset = Vector3.new(0, 9, 0)
	billboard.AlwaysOnTop = false
	billboard.LightInfluence = 0
	billboard.MaxDistance = 220
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.BuilderSansBold
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.6
	label.Text = "⚡ 0/s"
	label.Parent = billboard
	billboard.Parent = cap
	self.StatsLabel = label
	button.PrimaryPart = cap
	button.Parent = arena

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = CFrame.lookAt(Vector3.new(0, 0.6, 36), Vector3.new(0, 0.6, 0))
	spawn.Color = PANEL
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = arena

	for i = 1, 10 do
		local angle = (i / 10) * math.pi * 2
		local base = CFrame.new(0, 0, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 16, -78)
		part({ Name = "Pillar", Size = Vector3.new(5, 32, 5), CFrame = base, Color = Color3.fromRGB(22, 22, 34) }).Parent = arena
		part({
			Name = "PillarStrip",
			Size = Vector3.new(1, 30, 0.4),
			CFrame = base * CFrame.new(0, 0, 2.6),
			Color = if i % 2 == 0 then ACCENT else Color3.fromRGB(77, 225, 255),
			Material = Enum.Material.Neon,
			CanCollide = false,
		}).Parent = arena
	end

	local sign = part({
		Name = "Sign",
		Size = Vector3.new(70, 14, 1),
		CFrame = CFrame.lookAt(Vector3.new(0, 30, -92), Vector3.new(0, 30, 0)),
		Color = DARK,
	})
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.LightInfluence = 0
	surface.PixelsPerStud = 20
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(1, 1)
	title.Font = Enum.Font.Michroma
	title.TextScaled = true
	title.Text = string.upper(GameConfig.GameName)
	title.TextColor3 = Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Color = ACCENT
	stroke.Thickness = 3
	stroke.Parent = title
	title.Parent = surface
	surface.Parent = sign
	sign.Parent = arena

	arena.Parent = workspace
end

function WorldService:_lighting()
	Lighting.ClockTime = 0
	Lighting.Brightness = 1.5
	Lighting.Ambient = Color3.fromRGB(30, 30, 46)
	Lighting.OutdoorAmbient = Color3.fromRGB(40, 36, 60)
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.32
		atmosphere.Offset = 0.2
		atmosphere.Color = Color3.fromRGB(70, 50, 110)
		atmosphere.Decay = Color3.fromRGB(30, 15, 60)
		atmosphere.Glare = 0
		atmosphere.Haze = 1.2
		atmosphere.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.9
		bloom.Size = 28
		bloom.Threshold = 0.95
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("ColorCorrectionEffect") then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Contrast = 0.08
		cc.Saturation = 0.12
		cc.TintColor = Color3.fromRGB(240, 235, 255)
		cc.Parent = Lighting
	end
end

return WorldService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="71">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="72">
      <Properties>
        <string name="Name">AdminClient</string>
      </Properties>
      <Item class="LocalScript" referent="73">
        <Properties>
          <string name="Name">AdminPanel</string>
          <string name="Source"><![CDATA[--[[
	AdminPanel (LocalScript)
	Location: ServerStorage/AdminClient/AdminPanel
	Runs from: PlayerGui/AdminPanelGui/AdminPanel — AdminService clones the contents of
	           ServerStorage/AdminClient into that ScreenGui ONLY for authorised staff,
	           so normal players never receive this code.
	Depends on: AdminUI/AdminNet, AdminUI/Panel (and through them ReplicatedStorage/UI/*,
	            ReplicatedStorage/Shared/*)

	Asks the server who we are ("hello"), then builds the panel with exactly
	the tabs and controls that role may use. If the server says we are not
	authorised (for example the role was removed), the panel removes itself.
	Security never depends on this script: the server checks every request.
]]

local gui = script.Parent
local AdminUI = gui:WaitForChild("AdminUI")
local AdminNet = require(AdminUI:WaitForChild("AdminNet"))
local Panel = require(AdminUI:WaitForChild("Panel"))

local hello = nil
for attempt = 1, 6 do
	local response = AdminNet.request("hello")
	if response.ok and type(response.data) == "table" then
		hello = response.data
		break
	end
	if response.err == "Not authorized." then
		break
	end
	task.wait(1.5 * attempt)
end

if not hello then
	warn("[AdminPanel] The server did not authorise this client; removing the panel.")
	gui:Destroy()
	return
end

Panel.build(gui, hello)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="74">
        <Properties>
          <string name="Name">AdminUI</string>
        </Properties>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">AdminNet</string>
            <string name="Source"><![CDATA[--[[
	AdminNet (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/AdminNet
	          (runs from PlayerGui/AdminPanelGui/AdminUI/AdminNet for authorised staff)
	Depends on: ReplicatedStorage/Shared/Remotes, ReplicatedStorage/UI/UIKit, ReplicatedStorage/UI/Theme

	Client wrapper around the "Admin" RemoteFunction.
	  * Every request carries a fresh RequestId (the server rejects replays).
	  * InvokeServer is always wrapped in pcall; failures become
	    { ok = false, err = "Connection problem..." } instead of errors.
	  * Destructive actions come back with needsConfirm + a single-use token;
	    run() shows a confirmation dialog and sends "confirm" or "cancel".

	Nothing here grants anything: the server checks permissions, limits,
	targets and confirmations on every call. The client only mirrors those
	rules to hide controls the role cannot use.
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder:WaitForChild("UIKit"))
local Theme = require(UIFolder:WaitForChild("Theme"))

export type Response = {
	ok: boolean,
	message: string?,
	err: string?,
	data: any,
	needsConfirm: boolean?,
	token: string?,
	summary: string?,
	expires: number?,
	cancelled: boolean?,
}

local AdminNet = {}

local adminRemote = Remotes.func("Admin")
local pushRemote = Remotes.event("AdminPush")
local reporter: ((response: Response, label: string?) -> ())? = nil

-- Sends one request. Never throws.
function AdminNet.request(action: string, args: { [string]: any }?): Response
	local ok, response = pcall(function()
		return adminRemote:InvokeServer({
			Action = action,
			Args = args or {},
			RequestId = HttpService:GenerateGUID(false),
		})
	end)
	if not ok then
		return { ok = false, err = "Connection problem. Please try again." }
	end
	if type(response) ~= "table" then
		return { ok = false, err = "Unexpected response from the server." }
	end
	return response :: Response
end

-- The panel installs a reporter that writes results to the console and toasts.
function AdminNet.setReporter(fn: (response: Response, label: string?) -> ())
	reporter = fn
end

--[[
	Runs an action and handles the confirmation flow.
	opts: {
	  Label: string?          short name shown in the console ("Kick", "Add Sparks", ...)
	  Silent: boolean?        do not report the result
	  RequireText: string?    the admin must type this text to confirm
	  ConfirmTitle: string?
	}
]]
function AdminNet.run(action: string, args: { [string]: any }?, opts: { [string]: any }?): Response
	local options = opts or {}
	local response = AdminNet.request(action, args)
	if response.needsConfirm and response.token then
		local message = (response.summary or "Confirm this action?")
			.. `\nThis confirmation expires in {response.expires or 45} seconds.`
		if options.RequireText then
			message ..= `\nType "{options.RequireText}" to confirm.`
		end
		local confirmed = UI.confirm({
			Title = options.ConfirmTitle or "Confirm destructive action",
			Message = message,
			ConfirmText = "Confirm",
			CancelText = "Cancel",
			Danger = true,
			Palette = Theme.Admin,
			RequireText = options.RequireText,
			Placeholder = if options.RequireText then options.RequireText else nil,
		})
		if not confirmed then
			AdminNet.request("cancel", { Token = response.token })
			response = { ok = false, cancelled = true, err = "Cancelled." }
		else
			response = AdminNet.request("confirm", { Token = response.token })
		end
	end
	if reporter and not options.Silent then
		reporter(response, options.Label)
	end
	return response
end

-- Sends a command-bar line ("/admin givecash me 100" or "givecash me 100").
function AdminNet.command(text: string): Response
	return AdminNet.run("command", { Text = text }, { Label = "Command" })
end

function AdminNet.onPush(fn: (kind: string, payload: any) -> ()): RBXScriptConnection
	return pushRemote.OnClientEvent:Connect(fn)
end

return AdminNet
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">CommandBar</string>
            <string name="Source"><![CDATA[--[[
	CommandBar (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/CommandBar
	Depends on: AdminUI/Widgets, AdminUI/AdminNet

	Searchable command bar with console output.
	  * Enter runs the line on the server (parsing happens server-side).
	  * Up / Down walk through history, Tab completes the highlighted suggestion.
	  * Suggestions come from the commands the server says this role may use.
	  * Output: commands in magenta, results in green, errors in red.
]]

local UserInputService = game:GetService("UserInputService")

local Widgets = require(script.Parent.Widgets)
local AdminNet = require(script.Parent.AdminNet)

local UI = Widgets.UI
local P = Widgets.P
local F = Widgets.Theme.Fonts

local MAX_LINES = 200
local MAX_SUGGESTIONS = 6

local CommandBar = {}

function CommandBar.new(ctx, parent: Instance)
	local root = UI.frame({ Name = "CommandBar", Size = UDim2.new(1, 0, 0, 150), ZIndex = 20, Parent = parent })

	local inputRow = UI.new("Frame", {
		Name = "Input",
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundColor3 = P.Background,
		ZIndex = 20,
		Corner = 10,
		Stroke = { Color = P.Accent, Transparency = 0.45 },
		Parent = root,
	})
	Widgets.label({
		Text = "›",
		Font = F.Heading,
		TextSize = 22,
		TextColor3 = P.Accent,
		Size = UDim2.fromOffset(26, 38),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 21,
		Parent = inputRow,
	})
	local box: TextBox = UI.new("TextBox", {
		Name = "Command",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(26, 0),
		Size = UDim2.new(1, -120, 1, 0),
		ClearTextOnFocus = false,
		Font = F.Mono,
		TextSize = 14,
		TextColor3 = P.Text,
		PlaceholderText = "Type a command — e.g. givecash me 1k  ·  help",
		PlaceholderColor3 = Widgets.Theme.darken(P.TextDim, 0.25),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		ZIndex = 21,
		Parent = inputRow,
	})
	local run = Widgets.button({
		Text = "Run",
		Variant = "adminPrimary",
		Size = UDim2.fromOffset(80, 30),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -4, 0.5, 0),
		ZIndex = 21,
		Parent = inputRow,
	})

	local console = UI.scroll({
		Name = "Console",
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 1, -46),
		BackgroundColor3 = P.Background,
		BackgroundTransparency = 0,
		ScrollBarImageColor3 = P.Stroke,
		ZIndex = 20,
		Corner = 10,
		Stroke = { Color = P.Stroke, Transparency = 0.4 },
		Padding = { 10, 10, 6, 6 },
		List = { Pad = 2 },
		Parent = root,
	})

	local suggestionsFrame = UI.new("Frame", {
		Name = "Suggestions",
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, -90, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = P.Panel,
		Visible = false,
		ZIndex = 30,
		Corner = 10,
		Stroke = { Color = P.Accent, Transparency = 0.3 },
		Padding = 4,
		List = { Pad = 2 },
		Parent = root,
	})

	local bar = { Frame = root, Box = box }
	local lineCount = 0
	local history: { string } = {}
	local historyIndex = 0
	local suggestions: { any } = {}
	local highlighted = 1

	function bar.Log(text: string, kind: string?)
		local color = P.TextDim
		if kind == "ok" then
			color = P.Accent
		elseif kind == "error" then
			color = P.Danger
		elseif kind == "command" then
			color = P.Accent2
		elseif kind == "warn" then
			color = P.Warning
		end
		lineCount += 1
		UI.label({
			Name = "Line",
			Text = text,
			Font = F.Mono,
			TextSize = 13,
			TextColor3 = color,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 16),
			LayoutOrder = lineCount,
			ZIndex = 21,
			Parent = console,
		})
		local lines = {}
		for _, child in ipairs(console:GetChildren()) do
			if child:IsA("TextLabel") then
				table.insert(lines, child)
			end
		end
		if #lines > MAX_LINES then
			table.sort(lines, function(a, b)
				return a.LayoutOrder < b.LayoutOrder
			end)
			for i = 1, #lines - MAX_LINES do
				lines[i]:Destroy()
			end
		end
		task.defer(function()
			console.CanvasPosition = Vector2.new(0, math.max(0, console.AbsoluteCanvasSize.Y - console.AbsoluteWindowSize.Y))
		end)
	end

	local function commandWord(text: string): (string, boolean)
		local s = string.gsub(text, "^%s*", "")
		s = string.gsub(s, "^/admin%s*", "")
		s = string.gsub(s, "^[/;:]", "")
		local word = string.match(s, "^(%S*)") or ""
		local hasSpace = string.find(s, "%s") ~= nil
		return string.lower(word), hasSpace
	end

	local function renderSuggestions()
		for _, child in ipairs(suggestionsFrame:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		suggestionsFrame.Visible = #suggestions > 0 and box:IsFocused()
		for index, cmd in ipairs(suggestions) do
			local row = UI.new("TextButton", {
				Name = "Suggestion",
				Size = UDim2.new(1, 0, 0, 34),
				BackgroundColor3 = P.PanelLighter,
				BackgroundTransparency = if index == highlighted then 0 else 1,
				AutoButtonColor = false,
				Text = "",
				LayoutOrder = index,
				ZIndex = 31,
				Corner = 6,
				Parent = suggestionsFrame,
			})
			Widgets.label({
				Text = cmd.Usage,
				Font = F.Mono,
				TextSize = 13,
				TextColor3 = P.Accent,
				Size = UDim2.new(1, -12, 0, 16),
				Position = UDim2.fromOffset(8, 2),
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 32,
				Parent = row,
			})
			Widgets.dim({
				Text = cmd.Description,
				TextSize = 12,
				Size = UDim2.new(1, -12, 0, 14),
				Position = UDim2.fromOffset(8, 18),
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 32,
				Parent = row,
			})
			row.Activated:Connect(function()
				box.Text = cmd.Name .. " "
				box:CaptureFocus()
				box.CursorPosition = #box.Text + 1
			end)
		end
	end

	local function updateSuggestions()
		local word, hasSpace = commandWord(box.Text)
		table.clear(suggestions)
		highlighted = 1
		if word ~= "" or box.Text == "" then
			for _, cmd in ipairs(ctx.Hello.Commands or {}) do
				local name = string.lower(cmd.Name)
				local matches = if hasSpace then name == word else string.sub(name, 1, #word) == word
				if matches then
					table.insert(suggestions, cmd)
					if #suggestions >= MAX_SUGGESTIONS then
						break
					end
				end
			end
		end
		if box.Text == "" then
			table.clear(suggestions)
		end
		renderSuggestions()
	end

	local function submit()
		local text = string.gsub(box.Text, "^%s*(.-)%s*$", "%1")
		if text == "" then
			return
		end
		box.Text = ""
		table.insert(history, text)
		if #history > 50 then
			table.remove(history, 1)
		end
		historyIndex = #history + 1
		bar.Log("> " .. text, "command")
		task.spawn(AdminNet.command, text)
	end
	bar.Submit = submit

	box:GetPropertyChangedSignal("Text"):Connect(function()
		if string.find(box.Text, "\t", 1, true) then
			box.Text = string.gsub(box.Text, "\t", "")
			return
		end
		if #box.Text > 300 then
			box.Text = string.sub(box.Text, 1, 300)
			return
		end
		updateSuggestions()
	end)
	box.Focused:Connect(updateSuggestions)
	box.FocusLost:Connect(function(enterPressed)
		task.delay(0.15, function()
			if not box:IsFocused() then
				suggestionsFrame.Visible = false
			end
		end)
		if enterPressed then
			submit()
			-- Keep typing on keyboards; on touch devices let the keyboard close.
			if not UserInputService.TouchEnabled then
				box:CaptureFocus()
			end
		end
	end)
	run.Activated:Connect(submit)

	UserInputService.InputBegan:Connect(function(input)
		if UserInputService:GetFocusedTextBox() ~= box then
			return
		end
		if input.KeyCode == Enum.KeyCode.Up then
			if #history > 0 then
				historyIndex = math.max(1, historyIndex - 1)
				box.Text = history[historyIndex]
				box.CursorPosition = #box.Text + 1
			end
		elseif input.KeyCode == Enum.KeyCode.Down then
			if historyIndex < #history then
				historyIndex += 1
				box.Text = history[historyIndex]
			else
				historyIndex = #history + 1
				box.Text = ""
			end
			box.CursorPosition = #box.Text + 1
		elseif input.KeyCode == Enum.KeyCode.Tab then
			local cmd = suggestions[highlighted]
			if cmd then
				local _, hasSpace = commandWord(box.Text)
				if not hasSpace then
					box.Text = cmd.Name .. " "
					box.CursorPosition = #box.Text + 1
				end
			end
		end
	end)

	function bar.SetCompact(compact: boolean)
		root.Size = UDim2.new(1, 0, 0, if compact then 112 else 150)
	end

	bar.Log("Admin console ready. Type help for commands. Results of panel actions appear here too.", "info")
	return bar
end

return CommandBar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">LogRow</string>
            <string name="Source"><![CDATA[--[[
	LogRow (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/LogRow
	Depends on: AdminUI/Widgets

	Renders audit-log and security-flag entries as two-line rows. Used by the
	Dashboard and Audit Logs tabs. Rows can be re-filled in place (reuse).
]]

local Widgets = require(script.Parent.Widgets)

local UI = Widgets.UI
local P = Widgets.P
local F = Widgets.Theme.Fonts

local LogRow = {}

function LogRow.create(parent: Instance, compact: boolean?): Frame
	local height = if compact then 36 else 44
	local row = UI.new("Frame", {
		Name = "LogRow",
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = P.Background,
		BackgroundTransparency = 0.2,
		Corner = 8,
		Parent = parent,
	})
	UI.label({
		Name = "Top",
		Font = F.Mono,
		TextSize = if compact then 12 else 13,
		TextColor3 = P.Text,
		RichText = true,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -110, 0, 18),
		Position = UDim2.fromOffset(10, if compact then 2 else 4),
		Parent = row,
	})
	UI.label({
		Name = "Bottom",
		Font = Widgets.Theme.Fonts.Body,
		TextSize = 12,
		TextColor3 = P.TextDim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -20, 0, 16),
		Position = UDim2.fromOffset(10, if compact then 18 else 23),
		Parent = row,
	})
	local result = UI.label({
		Name = "Result",
		Font = F.Bold,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(96, 18),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, if compact then 2 else 4),
		BackgroundTransparency = 0,
		BackgroundColor3 = P.PanelLight,
		Corner = 999,
		Parent = row,
	})
	UI.stroke(result, { Color = P.Stroke, Transparency = 0.3 })
	return row
end

local function escape(text: any): string
	local s = tostring(text or "")
	s = string.gsub(s, "&", "&amp;")
	s = string.gsub(s, "<", "&lt;")
	s = string.gsub(s, ">", "&gt;")
	return s
end

local function hex(color: Color3): string
	return color:ToHex()
end

-- Fills a row with an audit entry.
function LogRow.fillAudit(row: Frame, entry)
	local top = row:FindFirstChild("Top") :: TextLabel
	local bottom = row:FindFirstChild("Bottom") :: TextLabel
	local result = row:FindFirstChild("Result") :: TextLabel
	local color = Widgets.Result[entry.Result] or P.TextDim
	local target = if entry.TargetName then "  → " .. escape(entry.TargetName) else ""
	top.Text = `<font color="#{hex(P.TextDim)}">{Widgets.clock(entry.Time)}</font>  <b>{escape(entry.AdminName or "?")}</b>`
		.. ` <font color="#{hex(P.Accent2)}">[{escape(entry.Role or "None")}]</font>  {escape(entry.Action)}{target}`
	local details = {}
	if entry.Params and entry.Params ~= "" then
		table.insert(details, entry.Params)
	end
	if entry.Message and entry.Message ~= "" then
		table.insert(details, entry.Message)
	end
	bottom.Text = table.concat(details, "  ·  ")
	result.Text = string.upper((string.gsub(tostring(entry.Result or "?"), "_", " ")))
	result.TextColor3 = color
	local stroke = result:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
	end
end

-- Fills a row with a security flag ({ Time, UserId, Name, Reason, Detail, Count }).
function LogRow.fillSecurity(row: Frame, entry)
	local top = row:FindFirstChild("Top") :: TextLabel
	local bottom = row:FindFirstChild("Bottom") :: TextLabel
	local result = row:FindFirstChild("Result") :: TextLabel
	top.Text = `<font color="#{hex(P.TextDim)}">{Widgets.clock(entry.Time)}</font>  <b>{escape(entry.Name or "?")}</b> #{escape(entry.UserId)}  {escape(entry.Reason)}`
	bottom.Text = `{entry.Detail or ""}  ·  seen {entry.Count or 1}×`
	result.Text = "FLAG"
	result.TextColor3 = P.Warning
	local stroke = result:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = P.Warning
	end
end

return LogRow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">Panel</string>
            <string name="Source"><![CDATA[--[[
	Panel (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/Panel
	Depends on: AdminUI/Widgets, AdminUI/AdminNet, AdminUI/CommandBar, AdminUI/Tabs/*,
	            ReplicatedStorage/Shared/Signal, ReplicatedStorage/UI/SoundPlayer

	Builds the admin panel shell: floating toggle button, window with role
	badge, sidebar with the nine tabs, command bar + console, in-panel
	toasts, F2 / gamepad / "/admin" chat shortcuts and the refresh loop.
	Tabs are built lazily the first time they are opened and only the visible
	tab refreshes.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Signal"))
local SoundPlayer = require(ReplicatedStorage:WaitForChild("UI"):WaitForChild("SoundPlayer"))

local Widgets = require(script.Parent.Widgets)
local AdminNet = require(script.Parent.AdminNet)
local CommandBar = require(script.Parent.CommandBar)
local TabModules = script.Parent:WaitForChild("Tabs")

local UI = Widgets.UI
local Theme = Widgets.Theme
local P = Widgets.P
local F = Theme.Fonts

local Panel = {}

local TABS = {
	{ Id = "Dashboard", Name = "Dashboard", Icon = "📊", Any = { "panel.open" } },
	{ Id = "Players", Name = "Players", Icon = "👥", Any = { "players.view" } },
	{ Id = "Moderation", Name = "Moderation", Icon = "🚫", Any = { "players.ban", "staff.manage" } },
	{ Id = "Economy", Name = "Economy", Icon = "💰", Any = { "economy.grant", "economy.reset" } },
	{ Id = "Items", Name = "Items", Icon = "🎁", Any = { "items.grant", "items.test", "players.inspect" } },
	{ Id = "Progression", Name = "Progression", Icon = "📈", Any = { "progression.grant", "progression.reset" } },
	{ Id = "Server", Name = "Server", Icon = "🖥️", Any = { "server.announce", "server.events", "server.stats" } },
	{ Id = "Logs", Name = "Audit Logs", Icon = "📜", Any = { "logs.view" } },
	{ Id = "Settings", Name = "Settings", Icon = "⚙️", Any = {} },
}

local function makeContext(gui: ScreenGui, hello)
	local permissions = {}
	for _, p in ipairs(hello.Permissions or {}) do
		permissions[p] = true
	end
	local ctx = {
		Gui = gui,
		Hello = hello,
		Net = AdminNet,
		W = Widgets,
		UI = UI,
		P = P,
		Target = { Query = nil, Label = "" },
		TargetChanged = Signal.new(),
		Players = {},
		PlayersUpdated = Signal.new(),
		LogPushed = Signal.new(),
		Prefs = { ToastSounds = true, Compact = false, AutoRefresh = true },
		PrefsChanged = Signal.new(),
	}
	function ctx.has(permission: string): boolean
		return permissions["*"] == true or permissions[permission] == true
	end
	function ctx.setTarget(query: any, label: string?, source: any?)
		ctx.Target = { Query = query, Label = label or "" }
		ctx.TargetChanged:Fire(source)
	end
	function ctx.refreshPlayers()
		local action = if ctx.has("players.view") then "players.list" else "dashboard"
		local response = AdminNet.request(action)
		if response.ok and type(response.data) == "table" and type(response.data.Players) == "table" then
			ctx.Players = response.data.Players
			ctx.PlayersUpdated:Fire()
		end
		return ctx.Players
	end
	return ctx
end

function Panel.build(gui: ScreenGui, hello)
	local ctx = makeContext(gui, hello)
	local roleColor = if typeof(hello.RoleColor) == "Color3" then hello.RoleColor else P.Accent

	-- Floating layer: toggle button + toasts (scaled to the screen) ------------------
	-- Above the window (ZIndex 10) so the toggle and toasts stay reachable; transparent frames do not block clicks.
	local floating = UI.frame({ Name = "Floating", ZIndex = 15, Parent = gui })
	local inset = GuiService:GetGuiInset()

	-- The button keeps its own press-animation UIScale, so layout scaling lives on a holder.
	local toggleHolder = UI.frame({
		Name = "AdminToggleHolder",
		Size = UDim2.fromOffset(112, 34),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, inset.Y + 10),
		ZIndex = 6,
		Parent = floating,
	})
	local toggle = Widgets.button({
		Name = "AdminToggle",
		Text = "🛡️ Admin",
		Variant = "adminPrimary",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 6,
		Tooltip = `Admin panel ({hello.PanelKey or "F2"})`,
		Parent = toggleHolder,
	})

	local toasts = UI.frame({
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, inset.Y + 54),
		Size = UDim2.fromOffset(330, 400),
		ZIndex = 80,
		List = { Pad = 6, HA = "Right" },
		Parent = floating,
	})

	-- Scale each right-anchored element on its own: a UIScale on the full-screen
	-- frame would scale from the top-left corner and push them off-screen.
	local floatScales = {}
	for _, element in ipairs({ toggleHolder, toasts }) do
		local s = Instance.new("UIScale")
		s.Parent = element
		table.insert(floatScales, s)
	end
	local function rescaleFloating()
		local v = UI.viewport()
		local scale = math.clamp(math.min(v.X / 1280, v.Y / 720), 0.75, 1.2)
		for _, s in ipairs(floatScales) do
			s.Scale = scale
		end
	end
	rescaleFloating()
	UI.onViewportChanged(rescaleFloating)

	local toastCount = 0
	function ctx.toast(text: string, kind: string?)
		toastCount += 1
		local color = if kind == "error" then P.Danger elseif kind == "warn" then P.Warning else P.Accent
		local firstLine = string.match(text, "^[^\n]*") or text
		local card = UI.new("Frame", {
			Name = "Toast",
			Size = UDim2.fromOffset(320, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = P.Panel,
			LayoutOrder = toastCount,
			ZIndex = 81,
			Corner = 10,
			Stroke = { Color = color, Thickness = 1.5 },
			Padding = { 12, 12, 9, 9 },
			Parent = toasts,
		})
		UI.new("Frame", {
			Size = UDim2.new(0, 3, 1, 0),
			Position = UDim2.fromOffset(-8, 0),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = 82,
			Corner = 2,
			Parent = card,
		})
		Widgets.label({
			Text = firstLine,
			TextWrapped = true,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 16),
			TextSize = 14,
			TextColor3 = P.Text,
			ZIndex = 82,
			Parent = card,
		})
		local scale = Instance.new("UIScale")
		scale.Scale = 0.9
		scale.Parent = card
		UI.tween(scale, { Scale = 1 }, Theme.Motion.Pop)
		if ctx.Prefs.ToastSounds then
			SoundPlayer.play(if kind == "error" then "Error" else "Purchase", { Volume = 0.6 })
		end
		task.delay(4, function()
			if card.Parent then
				local t = UI.tween(scale, { Scale = 0.85 }, Theme.Motion.Fast)
				if t then
					t.Completed:Wait()
				end
				card:Destroy()
			end
		end)
		local cards = {}
		for _, child in ipairs(toasts:GetChildren()) do
			if child:IsA("Frame") then
				table.insert(cards, child)
			end
		end
		if #cards > 5 then
			table.sort(cards, function(a, b)
				return a.LayoutOrder < b.LayoutOrder
			end)
			cards[1]:Destroy()
		end
	end

	-- Window ------------------------------------------------------------------------------------
	local window = UI.window({
		Parent = gui,
		Name = "AdminWindow",
		Title = "Admin Panel",
		Subtitle = "Click a Button · staff tools · every action is validated and logged by the server",
		Icon = "🛡️",
		Size = Vector2.new(1140, 700),
		CompactSize = Vector2.new(940, 590),
		Palette = P,
		Accent = P.Accent,
	})
	ctx.Window = window
	UI.setVariant(window.CloseButton, "adminGhost")

	local badge = UI.label({
		Name = "RoleBadge",
		Text = "ADMIN • " .. string.upper(tostring(hello.Role)),
		Font = F.Heading,
		TextSize = 13,
		TextColor3 = roleColor,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 28),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -52, 0, 6),
		BackgroundColor3 = Theme.darken(roleColor, 0.78),
		BackgroundTransparency = 0,
		ZIndex = 13,
		Corner = Theme.Radius.Pill,
		Padding = { X = 14 },
		Parent = window.Header,
	})
	UI.stroke(badge, { Color = roleColor, Thickness = 1.5 })

	local body = window.Body
	local sidebar = UI.new("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, 178, 1, 0),
		BackgroundColor3 = P.Background,
		ZIndex = 12,
		Corner = 12,
		Stroke = { Color = P.Stroke, Transparency = 0.4 },
		Padding = 8,
		Parent = body,
	})
	local tabList = UI.frame({ Name = "TabList", Size = UDim2.new(1, 0, 1, -48), ZIndex = 12, List = { Pad = 6 }, Parent = sidebar })
	local sideInfo = Widgets.dim({
		Name = "Info",
		Text = `{hello.Role} · server {Widgets.shortId(hello.JobId)}`,
		TextSize = 11,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0, 0, 1, -40),
		ZIndex = 12,
		Parent = sidebar,
	})

	local main = UI.frame({ Name = "Main", Position = UDim2.fromOffset(190, 0), Size = UDim2.new(1, -190, 1, 0), ZIndex = 12, Parent = body })
	local commandBar = CommandBar.new(ctx, main)
	ctx.Console = commandBar
	function ctx.log(text: string, kind: string?)
		commandBar.Log(text, kind)
	end
	local content = UI.frame({ Name = "Content", Position = UDim2.fromOffset(0, 160), Size = UDim2.new(1, 0, 1, -160), ZIndex = 12, Parent = main })

	AdminNet.setReporter(function(response, label)
		local prefix = if label then label .. ": " else ""
		if response.cancelled then
			ctx.log(prefix .. "cancelled.", "warn")
			return
		end
		if response.ok then
			local message = response.message or "Done."
			ctx.log(prefix .. message, "ok")
			ctx.toast("✔ " .. message, "ok")
		else
			local message = response.err or "Failed."
			ctx.log(prefix .. message, "error")
			ctx.toast("✖ " .. message, "error")
		end
	end)

	-- Tabs ------------------------------------------------------------------------------------------
	local tabButtons: { [string]: TextButton } = {}
	local tabs: { [string]: any } = {}
	local containers: { [string]: Frame } = {}
	local current: string? = nil
	local compact = false

	local function allowed(def): boolean
		if #def.Any == 0 then
			return true
		end
		for _, permission in ipairs(def.Any) do
			if ctx.has(permission) then
				return true
			end
		end
		return false
	end

	local function tabText(def): string
		return if compact then def.Icon else def.Icon .. "  " .. def.Name
	end

	local function ensureTab(id: string)
		if tabs[id] then
			return tabs[id]
		end
		local container = UI.frame({ Name = id, Visible = false, ZIndex = 12, Parent = content })
		containers[id] = container
		local module = TabModules:FindFirstChild(id)
		local ok, result = pcall(function()
			return require(module)(ctx, container)
		end)
		if not ok then
			warn("[AdminPanel] Tab " .. id .. " failed to build: " .. tostring(result))
			Widgets.label({ Text = "This tab failed to load: " .. tostring(result), TextColor3 = P.Danger, TextWrapped = true, Size = UDim2.new(1, 0, 0, 60), Parent = container })
			result = {}
		end
		tabs[id] = result
		return result
	end

	function ctx.switchTab(id: string, ...: any)
		if current == id and tabs[id] then
			if tabs[id].OnShow then
				task.spawn(tabs[id].OnShow, ...)
			end
			return
		end
		if current then
			if containers[current] then
				containers[current].Visible = false
			end
			if tabs[current] and tabs[current].OnHide then
				task.spawn(tabs[current].OnHide)
			end
		end
		current = id
		for tabId, button in pairs(tabButtons) do
			UI.setVariant(button, if tabId == id then "adminPrimary" else "adminGhost")
		end
		local tab = ensureTab(id)
		containers[id].Visible = true
		tab.Elapsed = 0
		if tab.OnShow then
			task.spawn(tab.OnShow, ...)
		end
	end

	for index, def in ipairs(TABS) do
		if allowed(def) then
			local button = Widgets.button({
				Name = def.Id,
				Text = tabText(def),
				Size = UDim2.new(1, 0, 0, 40),
				TextXAlignment = Enum.TextXAlignment.Left,
				Padding = { X = 12 },
				LayoutOrder = index,
				Variant = "adminGhost",
				ZIndex = 13,
				OnClick = function()
					ctx.switchTab(def.Id)
				end,
				Parent = tabList,
			})
			tabButtons[def.Id] = button
		end
	end

	local function applyCompact()
		compact = window.Root:GetAttribute("Compact") == true or ctx.Prefs.Compact
		local sideWidth = if compact then 58 else 178
		sidebar.Size = UDim2.new(0, sideWidth, 1, 0)
		sideInfo.Visible = not compact
		main.Position = UDim2.fromOffset(sideWidth + 12, 0)
		main.Size = UDim2.new(1, -(sideWidth + 12), 1, 0)
		commandBar.SetCompact(compact)
		local top = if compact then 120 else 160
		content.Position = UDim2.fromOffset(0, top)
		content.Size = UDim2.new(1, 0, 1, -top)
		for _, def in ipairs(TABS) do
			local button = tabButtons[def.Id]
			if button then
				button.Text = tabText(def)
				button.TextXAlignment = if compact then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left
			end
		end
	end
	window.Root:GetAttributeChangedSignal("Compact"):Connect(applyCompact)
	ctx.PrefsChanged:Connect(applyCompact)
	applyCompact()

	-- Open / close ----------------------------------------------------------------------------------
	local function setOpen(open: boolean)
		if open then
			window.Open()
		else
			task.spawn(window.Close)
		end
	end
	function ctx.IsOpen(): boolean
		return window.IsOpen()
	end

	toggle.Activated:Connect(function()
		setOpen(not window.IsOpen())
	end)

	window.Opened.Event:Connect(function()
		UI.setText(toggle, "Close", "🛡️")
		if not current then
			ctx.switchTab("Dashboard")
		elseif tabs[current] and tabs[current].OnShow then
			task.spawn(tabs[current].OnShow)
		end
		ContextActionService:BindActionAtPriority("AdminPanelBack", function(_, state)
			if state == Enum.UserInputState.Begin then
				setOpen(false)
			end
			return Enum.ContextActionResult.Sink
		end, false, 3000, Enum.KeyCode.ButtonB)
	end)
	window.Closed.Event:Connect(function()
		UI.setText(toggle, "Admin", "🛡️")
		Widgets.closePopup()
		ContextActionService:UnbindAction("AdminPanelBack")
	end)

	local panelKey = Enum.KeyCode.F2
	local okKey, key = pcall(function()
		return (Enum.KeyCode :: any)[hello.PanelKey or "F2"]
	end)
	if okKey and typeof(key) == "EnumItem" then
		panelKey = key
	end
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == panelKey then
			setOpen(not window.IsOpen())
		end
	end)

	-- "/admin ..." in chat. TextChatCommands only trigger with TextChatService chat; with
	-- legacy chat the command simply never fires and the panel's command bar still works.
	pcall(function()
		local command = Instance.new("TextChatCommand")
		command.Name = "AdminPanelCommand"
		command.PrimaryAlias = "/admin"
		command.Triggered:Connect(function(_source, text)
			task.spawn(function()
				ctx.log("> " .. text .. "   (from chat)", "command")
				AdminNet.command(text)
			end)
		end)
		command.Parent = TextChatService:FindFirstChild("TextChatCommands") or TextChatService
	end)

	-- Live pushes ------------------------------------------------------------------------------------
	AdminNet.onPush(function(kind, payload)
		if kind == "log" and type(payload) == "table" then
			ctx.LogPushed:Fire(payload)
		end
	end)

	-- Refresh loop: only the visible tab, only while the panel is open. -------------------------------
	task.spawn(function()
		while gui.Parent do
			task.wait(1)
			local tab = current and tabs[current]
			if tab and window.IsOpen() then
				if tab.Tick then
					task.spawn(tab.Tick)
				end
				if tab.AutoRefresh and tab.Refresh and ctx.Prefs.AutoRefresh then
					tab.Elapsed = (tab.Elapsed or 0) + 1
					if tab.Elapsed >= tab.AutoRefresh and not tab.Refreshing then
						tab.Elapsed = 0
						tab.Refreshing = true
						task.spawn(function()
							pcall(tab.Refresh)
							tab.Refreshing = false
						end)
					end
				end
			end
		end
	end)

	ctx.log(`Signed in as {hello.Role} (rank {hello.Rank}). {#(hello.Commands or {})} commands available.`, "ok")
	ctx.toast(`Admin panel ready — press {hello.PanelKey or "F2"} or tap 🛡️ Admin.`, "ok")
	return ctx
end

return Panel
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="79">
          <Properties>
            <string name="Name">Tabs</string>
          </Properties>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Dashboard</string>
              <string name="Source"><![CDATA[--[[
	Dashboard tab (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/Tabs/Dashboard
	Depends on: AdminUI/Widgets, AdminUI/LogRow, ReplicatedStorage/Shared/Format,
	            ReplicatedStorage/Shared/Config/GameConfig
	Server actions: dashboard (read-only, refreshed every 5 s while visible)

	Server health at a glance: players, uptime, presses, memory, physics,
	heartbeat, DataStore status, events, security flags, recent admin actions.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfig"))

local Widgets = require(script.Parent.Parent.Widgets)
local LogRow = require(script.Parent.Parent.LogRow)

local UI = Widgets.UI
local P = Widgets.P

return function(ctx, container: Frame)
	local scroll = Widgets.scroll(container)

	local grid = UI.frame({ Name = "Cards", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	UI.grid(grid, { Cell = UDim2.new(0.25, -8, 0, 76), Pad = UDim2.fromOffset(10, 10) })

	local cards = {
		players = Widgets.card(grid, "Players online", 1),
		uptime = Widgets.card(grid, "Uptime", 2),
		presses = Widgets.card(grid, "Server presses", 3),
		memory = Widgets.card(grid, "Memory", 4),
		physics = Widgets.card(grid, "Physics", 5),
		heartbeat = Widgets.card(grid, "Heartbeat", 6),
		data = Widgets.card(grid, "Data saving", 7),
		security = Widgets.card(grid, "Security flags", 8),
	}

	local eventsSection = Widgets.section(scroll, "Active events", 2)
	local eventsText = Widgets.dim({ Text = "Loading…", TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = eventsSection })

	local dataSection = Widgets.section(scroll, "DataStore status", 3)
	local dataText = Widgets.dim({ Text = "", TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = dataSection })

	local split = UI.frame({ Name = "Split", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, List = { Dir = "X", Pad = 10 }, Parent = scroll })
	local function half(title: string, order: number)
		local holder = UI.frame({ Size = UDim2.new(0.5, -5, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, List = { Pad = 0 }, Parent = split })
		local section = Widgets.section(holder, title, 1)
		local list = UI.frame({ Name = "List", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, List = { Pad = 4 }, Parent = section })
		return list
	end
	local logsList = half("Recent admin actions", 1)
	local securityList = half("Recent security flags", 2)

	local logRows, securityRows = {}, {}
	local function fill(list: Frame, rows: { Frame }, entries: { any }, filler, emptyText: string)
		for i, entry in ipairs(entries) do
			local row = rows[i]
			if not row then
				row = LogRow.create(list, ctx.Prefs.Compact)
				rows[i] = row
			end
			row.LayoutOrder = i
			row.Visible = true
			filler(row, entry)
		end
		for i = #entries + 1, #rows do
			rows[i].Visible = false
		end
		local empty = list:FindFirstChild("Empty")
		if #entries == 0 and not empty then
			Widgets.dim({ Name = "Empty", Text = emptyText, LayoutOrder = 999, Parent = list })
		elseif #entries > 0 and empty then
			empty:Destroy()
		end
	end

	local lastEvents = {}
	local function renderEvents()
		local lines = {}
		local now = workspace:GetServerTimeNow()
		for _, id in ipairs(GameConfig.Events.Order) do
			local info = lastEvents[id]
			local def = GameConfig.Events.Definitions[id]
			if info and def then
				table.insert(lines, `{def.Icon} {def.Name} — {Format.clock(info.EndsAt - now)} left (started by {info.StartedBy})`)
			end
		end
		eventsText.Text = if #lines > 0 then table.concat(lines, "\n") else "No boost events are running in this server."
	end

	local tab = { AutoRefresh = 5 }

	function tab.Refresh()
		local response = ctx.Net.request("dashboard")
		if not response.ok or type(response.data) ~= "table" then
			cards.players.Value.Text = "—"
			cards.players.Sub.Text = response.err or "Could not load."
			return
		end
		local d = response.data
		cards.players.Value.Text = `{#d.Players} / {d.MaxPlayers}`
		local loaded = 0
		for _, p in ipairs(d.Players) do
			if p.Loaded then
				loaded += 1
			end
		end
		cards.players.Sub.Text = `{loaded} loaded`
		ctx.Players = d.Players
		ctx.PlayersUpdated:Fire()
		cards.uptime.Value.Text = Format.time(d.Uptime)
		cards.uptime.Sub.Text = `place v{d.PlaceVersion}`
		cards.presses.Value.Text = Format.commas(d.ServerPresses)
		cards.presses.Sub.Text = `{d.ServerCPS} presses/s`
		cards.memory.Value.Text = `{math.floor(d.MemoryMb)} MB`
		cards.memory.Sub.Text = "total server memory"
		cards.physics.Value.Text = `{math.floor(d.PhysicsFps)} FPS`
		cards.physics.Sub.Text = "real physics rate"
		cards.heartbeat.Value.Text = string.format("%.1f ms", d.HeartbeatMs or 0)
		cards.heartbeat.Sub.Text = "heartbeat time"
		local data = d.Data or {}
		cards.data.Value.Text = if data.Mode == "persistent" then "Enabled" else "Temporary"
		cards.data.Value.TextColor3 = if data.Mode == "persistent" then P.Accent else P.Warning
		cards.data.Sub.Text = `{data.Saves or 0} saves · {data.SaveFailures or 0} failed`
		cards.security.Value.Text = Format.commas(d.SecurityFlags or 0)
		cards.security.Value.TextColor3 = if (d.SecurityFlags or 0) > 0 then P.Warning else P.Text
		cards.security.Sub.Text = "suspicious requests"

		dataText.Text = `Mode: {data.Mode or "?"}  ·  loads {data.Loads or 0} (failed {data.LoadFailures or 0})  ·  `
			.. `saves {data.Saves or 0} (failed {data.SaveFailures or 0})  ·  lock conflicts {data.LockConflicts or 0}\n`
			.. `Last error: {data.LastError or "none"}\n`
			.. `Audit logs persisted: {if d.AuditPersist then "yes" else "no (memory only)"}`

		lastEvents = d.Events or {}
		renderEvents()
		fill(logsList, logRows, d.RecentLogs or {}, LogRow.fillAudit, if ctx.has("logs.view") then "No admin actions yet." else "Requires logs.view.")
		fill(securityList, securityRows, d.RecentSecurity or {}, LogRow.fillSecurity, "No security flags. 👍")
	end

	function tab.Tick()
		renderEvents()
	end

	function tab.OnShow()
		tab.Refresh()
	end

	return tab
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">Economy</string>
              <string name="Source"><![CDATA[--[[
	Economy tab (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/Tabs/Economy
	Depends on: AdminUI/Widgets, AdminUI/TargetPicker, ReplicatedStorage/Shared/Format,
	            ReplicatedStorage/Shared/Config/GameConfig
	Server actions: economy.add, economy.remove, economy.set, economy.reward,
	                economy.reset (destructive, server-issued confirmation), players.inspect

	Amounts typed here are parsed for convenience (1.5k, 2m, 1e6); the server
	re-validates every amount against the role's limit.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfig"))

local Widgets = require(script.Parent.Parent.Widgets)
local TargetPicker = require(script.Parent.Parent.TargetPicker)

local UI = Widgets.UI
local P = Widgets.P

local TEST_REWARDS = {
	{ Id = "gems_pack", Text = "💎 500 Gems" },
	{ Id = "crate_bundle", Text = "📦 Crate bundle" },
	{ Id = "frenzy", Text = "🔥 Frenzy ×3 (60 s)" },
	{ Id = "orb", Text = "🔮 Spawn bonus orb" },
	{ Id = "level_up", Text = "📈 Next level" },
}

return function(ctx, container: Frame)
	local scroll = Widgets.scroll(container)
	local canGrant = ctx.has("economy.grant")
	local limits = ctx.Hello.Limits or {}

	local targetSection = Widgets.section(scroll, "Target", 1, "Changes apply to this player. Offline players (#UserId) need the offline.write permission.")
	TargetPicker.new(ctx, targetSection, 1)
	local balances = Widgets.dim({ Text = "", LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 18), Parent = targetSection })

	local function refreshBalances()
		local query = ctx.Target.Query
		if query == nil or not ctx.has("players.inspect") then
			balances.Text = ""
			return
		end
		local response = ctx.Net.request("players.inspect", { Target = query })
		if ctx.Target.Query ~= query then
			return
		end
		if response.ok and type(response.data) == "table" and response.data.Currencies then
			local c = response.data.Currencies
			balances.Text = `Current balances — ⚡ {Format.short(c.Sparks)}   💎 {Format.short(c.Gems)}   🔷 {Format.short(c.Prisms)}`
			balances.TextColor3 = P.TextDim
		else
			balances.Text = response.err or ""
			balances.TextColor3 = P.Warning
		end
	end

	local currencySection = Widgets.section(scroll, "Currency", 2, `Your role's limit per action: {Format.short(limits.MaxCurrency or 0)}`)
	local currencyOptions = {}
	for _, id in ipairs(GameConfig.CurrencyOrder) do
		local def = GameConfig.Currencies[id]
		table.insert(currencyOptions, { Id = id, Text = def.Icon .. " " .. def.Name, Color = def.Color })
	end
	local currency = Widgets.chips({ Parent = currencySection, Options = currencyOptions, Value = "Sparks", Order = 1, Height = 30 })

	local amountRow = Widgets.row(currencySection, 2, 34)
	Widgets.rowLabel(amountRow, "Amount", 70, 1)
	local amountBox = Widgets.textbox({ Placeholder = "e.g. 1500, 2.5k, 3m, 1e9", Size = UDim2.fromOffset(220, 32), LayoutOrder = 2, MaxLength = 30, Parent = amountRow })
	local preview = Widgets.dim({ Text = "", Size = UDim2.fromOffset(200, 32), LayoutOrder = 3, Parent = amountRow })
	amountBox:GetPropertyChangedSignal("Text"):Connect(function()
		local n = Widgets.parseNumber(amountBox.Text)
		if amountBox.Text == "" then
			preview.Text = ""
		elseif n then
			preview.Text = "= " .. Format.commas(n)
			preview.TextColor3 = if n > (limits.MaxCurrency or 0) then P.Warning else P.TextDim
		else
			preview.Text = "not a number"
			preview.TextColor3 = P.Danger
		end
	end)

	local function amount(): number?
		local n = Widgets.parseNumber(amountBox.Text)
		if not n then
			ctx.toast("Enter a valid amount.", "error")
			return nil
		end
		return math.floor(n)
	end

	local function target(): any
		local query = ctx.Target.Query
		if query == nil then
			ctx.toast("Select a target player first.", "error")
		end
		return query
	end

	local function runEconomy(action: string, label: string, currencyOverride: string?)
		local t = target()
		local n = amount()
		if t == nil or n == nil then
			return
		end
		ctx.Net.run(action, { Target = t, Currency = currencyOverride or currency.Get(), Amount = n }, { Label = label })
		refreshBalances()
	end

	local buttons = Widgets.row(currencySection, 3, 36)
	local add = Widgets.button({ Text = "＋ Add", Variant = "adminPrimary", LayoutOrder = 1, OnClick = function()
		runEconomy("economy.add", "Add currency")
	end, Parent = buttons })
	local remove = Widgets.button({ Text = "－ Remove", Variant = "adminSecondary", LayoutOrder = 2, OnClick = function()
		runEconomy("economy.remove", "Remove currency")
	end, Parent = buttons })
	local set = Widgets.button({ Text = "＝ Set exactly", Variant = "adminSecondary", LayoutOrder = 3, OnClick = function()
		runEconomy("economy.set", "Set currency")
	end, Parent = buttons })
	local prisms = Widgets.button({ Text = "🔷 Grant Prisms", Variant = "adminMagenta", Size = UDim2.fromOffset(150, 32), LayoutOrder = 4, OnClick = function()
		runEconomy("economy.add", "Grant Prisms", "Prisms")
	end, Parent = buttons })
	for _, button in ipairs({ add, remove, set, prisms }) do
		Widgets.gate(button, canGrant, "economy.grant")
	end

	local rewards = Widgets.section(scroll, "Test rewards & bonuses", 3, "Fixed test grants for checking reward flows. They do not count toward leaderboards.")
	local rewardRow = UI.frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = rewards })
	local rewardLayout = UI.list(rewardRow, { Dir = "X", Pad = 6 })
	rewardLayout.Wraps = true
	for index, reward in ipairs(TEST_REWARDS) do
		local button = Widgets.button({
			Text = reward.Text,
			Size = UDim2.fromOffset(0, 32),
			AutomaticSize = Enum.AutomaticSize.X,
			Padding = { X = 12 },
			LayoutOrder = index,
			OnClick = function()
				local t = target()
				if t ~= nil then
					ctx.Net.run("economy.reward", { Target = t, Reward = reward.Id }, { Label = "Test reward" })
					refreshBalances()
				end
			end,
			Parent = rewardRow,
		})
		Widgets.gate(button, canGrant, "economy.grant")
	end

	local danger = Widgets.section(scroll, "Danger zone", 4, "Resetting currencies sets Sparks, Gems and Prisms to 0. The server asks for confirmation.")
	local reset = Widgets.button({
		Text = "⚠ Reset all currencies",
		Variant = "adminDanger",
		Size = UDim2.fromOffset(220, 34),
		LayoutOrder = 1,
		OnClick = function()
			local t = target()
			if t ~= nil then
				ctx.Net.run("economy.reset", { Target = t }, { Label = "Reset currencies" })
				refreshBalances()
			end
		end,
		Parent = danger,
	})
	Widgets.gate(reset, ctx.has("economy.reset"), "economy.reset")

	-- Only players picked from the list refresh automatically (typed names are
	-- resolved by the server when an action runs), debounced to one request.
	local version = 0
	ctx.TargetChanged:Connect(function()
		version += 1
		local mine = version
		if container.Visible and type(ctx.Target.Query) == "number" then
			task.delay(0.4, function()
				if mine == version then
					refreshBalances()
				end
			end)
		end
	end)

	local tab = {}
	function tab.OnShow()
		refreshBalances()
	end
	return tab
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Items</string>
              <string name="Source"><![CDATA[--[[
	Items tab (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/Tabs/Items
	Depends on: AdminUI/Widgets, AdminUI/TargetPicker, ReplicatedStorage/Shared/Format,
	            ReplicatedStorage/Shared/Config/{Items,Chests,Rarities}
	Server actions: items.grant, items.remove, chests.grant, players.inspect,
	                items.simulate (no data changes), items.forceRoll (test drop)

	Grant/remove items and crates, inspect inventories, and test crate odds.
	Drop-rate tests run the production roll function on the server with a
	private pity state, so real odds for players are never changed.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local Format = require(Shared:WaitForChild("Format"))
local Items = require(Config:WaitForChild("Items"))
local Chests = require(Config:WaitForChild("Chests"))
local Rarities = require(Config:WaitForChild("Rarities"))

local Widgets = require(script.Parent.Parent.Widgets)
local TargetPicker = require(script.Parent.Parent.TargetPicker)

local UI = Widgets.UI
local P = Widgets.P
local F = Widgets.Theme.Fonts

local function chestOptions()
	local options = {}
	for _, id in ipairs(Chests.Order) do
		local chest = Chests.ById[id]
		table.insert(options, { Text = `{chest.Icon} {chest.Name}  ({id})`, Value = id, Color = chest.Color })
	end
	return options
end

local function chestLabel(id: string): string
	local chest = Chests.ById[id]
	return if chest then `{chest.Icon} {chest.Name}` else id
end

return function(ctx, container: Frame)
	local scroll = Widgets.scroll(container)
	local canGrant = ctx.has("items.grant")
	local canTest = ctx.has("items.test")
	local limits = ctx.Hello.Limits or {}

	local function target(): any
		local query = ctx.Target.Query
		if query == nil then
			ctx.toast("Select a target player first.", "error")
		end
		return query
	end

	local function count(box: TextBox, fallback: number): number?
		if box.Text == "" then
			return fallback
		end
		local n = Widgets.parseNumber(box.Text)
		if not n or n < 1 or n ~= math.floor(n) then
			ctx.toast("Amount must be a whole number of at least 1.", "error")
			return nil
		end
		return n
	end

	-- Target ------------------------------------------------------------------------------
	local targetSection = Widgets.section(scroll, "Target", 1)
	TargetPicker.new(ctx, targetSection, 1)

	-- Item grants -----------------------------------------------------------------------------
	local itemSection = Widgets.section(scroll, "Grant or remove items", 2, `Limit per action: {limits.MaxItems or 0} copies.`)
	local search = Widgets.textbox({ Placeholder = "🔍 Search items by name or id", LayoutOrder = 1, Parent = itemSection })
	local rarityOptions = { { Id = "All", Text = "All" } }
	for _, rarityId in ipairs(Rarities.Order) do
		table.insert(rarityOptions, { Id = rarityId, Text = rarityId, Color = Rarities.ById[rarityId].Color })
	end
	local rarityFilter = "All"
	local itemRows: { [string]: TextButton } = {}
	local selectedItem: string? = nil
	local selectedLabel: TextLabel

	local function renderItems()
		local q = string.lower(search.Text)
		for _, item in ipairs(Items.List) do
			local row = itemRows[item.Id]
			local visible = (rarityFilter == "All" or item.Rarity == rarityFilter)
				and (q == "" or string.find(string.lower(item.Name), q, 1, true) ~= nil or string.find(item.Id, q, 1, true) ~= nil)
			row.Visible = visible
			local stroke = row:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = if item.Id == selectedItem then P.Accent else P.Stroke
				stroke.Transparency = if item.Id == selectedItem then 0 else 0.6
			end
		end
	end

	Widgets.chips({
		Parent = itemSection,
		Options = rarityOptions,
		Value = "All",
		Order = 2,
		Height = 26,
		OnChange = function(id)
			rarityFilter = id
			renderItems()
		end,
	})

	local itemList = UI.scroll({
		Name = "ItemList",
		Size = UDim2.new(1, 0, 0, 220),
		LayoutOrder = 3,
		BackgroundColor3 = P.Background,
		BackgroundTransparency = 0,
		ScrollBarImageColor3 = P.Stroke,
		Corner = 10,
		Padding = 6,
		List = { Pad = 4 },
		Parent = itemSection,
	})
	for index, item in ipairs(Items.List) do
		local color = Widgets.rarityColor(item.Rarity)
		local row = UI.new("TextButton", {
			Name = item.Id,
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = P.PanelLight,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = index,
			Corner = 8,
			Stroke = { Color = P.Stroke, Transparency = 0.6 },
			Parent = itemList,
		})
		Widgets.label({ Text = item.Icon, TextSize = 22, Size = UDim2.fromOffset(34, 40), TextXAlignment = Enum.TextXAlignment.Center, Parent = row })
		Widgets.label({ Text = item.Name, Font = F.Bold, TextColor3 = color, Size = UDim2.new(1, -50, 0, 18), Position = UDim2.fromOffset(40, 3), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
		Widgets.dim({ Text = `{item.Id} · {item.Rarity} · {chestLabel(item.Chest)}`, TextSize = 12, Size = UDim2.new(1, -50, 0, 16), Position = UDim2.fromOffset(40, 21), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
		row.Activated:Connect(function()
			selectedItem = item.Id
			selectedLabel.Text = `Selected: {item.Icon} {item.Name} ({item.Id})`
			selectedLabel.TextColor3 = color
			renderItems()
		end)
		itemRows[item.Id] = row
	end
	search:GetPropertyChangedSignal("Text"):Connect(renderItems)

	selectedLabel = Widgets.label({ Text = "Selected: none", LayoutOrder = 4, TextColor3 = P.TextDim, Parent = itemSection })
	local grantRow = Widgets.row(itemSection, 5, 34)
	Widgets.rowLabel(grantRow, "Amount", 70, 1)
	local itemAmount = Widgets.textbox({ Placeholder = "1", Size = UDim2.fromOffset(90, 32), LayoutOrder = 2, MaxLength = 10, Parent = grantRow })
	local grantItem = Widgets.button({
		Text = "＋ Grant item",
		Variant = "adminPrimary",
		LayoutOrder = 3,
		OnClick = function()
			local t = target()
			local n = count(itemAmount, 1)
			if not selectedItem then
				ctx.toast("Pick an item from the list.", "error")
				return
			end
			if t ~= nil and n then
				ctx.Net.run("items.grant", { Target = t, Item = selectedItem, Amount = n }, { Label = "Grant item" })
			end
		end,
		Parent = grantRow,
	})
	local removeItem = Widgets.button({
		Text = "－ Remove item",
		Variant = "adminSecondary",
		LayoutOrder = 4,
		OnClick = function()
			local t = target()
			local n = count(itemAmount, 1)
			if not selectedItem then
				ctx.toast("Pick an item from the list.", "error")
				return
			end
			if t ~= nil and n then
				ctx.Net.run("items.remove", { Target = t, Item = selectedItem, Amount = n }, { Label = "Remove item" })
			end
		end,
		Parent = grantRow,
	})
	Widgets.gate(grantItem, canGrant, "items.grant")
	Widgets.gate(removeItem, canGrant, "items.grant")

	-- Crates -----------------------------------------------------------------------------------------
	local crateSection = Widgets.section(scroll, "Grant crates", 3, `Limit per action: {limits.MaxChests or 0} crates.`)
	local crateRow = Widgets.row(crateSection, 1, 34)
	local crateDropdown = Widgets.dropdown({ Parent = crateRow, Order = 1, Width = 240, Options = chestOptions, Value = "starter", Text = chestLabel("starter") })
	local crateAmount = Widgets.textbox({ Placeholder = "1", Size = UDim2.fromOffset(80, 32), LayoutOrder = 2, MaxLength = 10, Parent = crateRow })
	local grantCrate = Widgets.button({
		Text = "📦 Grant crates",
		Variant = "adminPrimary",
		Size = UDim2.fromOffset(140, 32),
		LayoutOrder = 3,
		OnClick = function()
			local t = target()
			local n = count(crateAmount, 1)
			if t ~= nil and n then
				ctx.Net.run("chests.grant", { Target = t, Chest = crateDropdown.Get(), Amount = n }, { Label = "Grant crates" })
			end
		end,
		Parent = crateRow,
	})
	Widgets.gate(grantCrate, canGrant, "items.grant")

	-- Inventory inspection -------------------------------------------------------------------------
	local inventorySection = Widgets.section(scroll, "Inventory", 4)
	local inventoryButton = Widgets.button({ Text = "🎒 Inspect inventory", Variant = "adminMagenta", Size = UDim2.fromOffset(180, 32), LayoutOrder = 1, Parent = inventorySection })
	Widgets.gate(inventoryButton, ctx.has("players.inspect"), "players.inspect")
	local inventorySummary = Widgets.dim({ Text = "", LayoutOrder = 2, Parent = inventorySection })
	local inventoryList = UI.frame({ Name = "Inventory", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = inventorySection })
	UI.grid(inventoryList, { Cell = UDim2.new(0.5, -4, 0, 26), Pad = UDim2.fromOffset(8, 4) })

	local function inspectInventory()
		local t = target()
		if t == nil then
			return
		end
		Widgets.clear(inventoryList)
		inventorySummary.Text = "Loading…"
		local response = ctx.Net.request("players.inspect", { Target = t })
		if not response.ok or type(response.data) ~= "table" then
			inventorySummary.Text = response.err or "Could not load inventory."
			inventorySummary.TextColor3 = P.Danger
			return
		end
		local data = response.data
		local items = data.Inventory or {}
		local copies = 0
		for index, entry in ipairs(items) do
			copies += entry.Count
			local item = Items.ById[entry.Id]
			Widgets.label({
				Text = `{if item then item.Icon else "?"} {entry.Name} ×{Format.commas(entry.Count)}{if entry.Equipped then "  ✔ equipped" else ""}`,
				TextColor3 = Widgets.rarityColor(entry.Rarity),
				TextSize = 13,
				TextTruncate = Enum.TextTruncate.AtEnd,
				LayoutOrder = index,
				Parent = inventoryList,
			})
		end
		local who = if data.Online == false then `#{data.UserId} (offline)` else `{data.DisplayName} (@{data.Name})`
		inventorySummary.Text = `{who}: {#items} unique items, {Format.commas(copies)} copies.`
		inventorySummary.TextColor3 = P.TextDim
	end
	inventoryButton.Activated:Connect(function()
		if not inventoryButton:GetAttribute("Disabled") then
			inspectInventory()
		end
	end)

	-- Drop-rate testing --------------------------------------------------------------------------
	local testSection = Widgets.section(scroll, "Test drop rates", 5, "Runs the real roll function on the server with a private pity state. No player data changes.")
	local testRow = Widgets.row(testSection, 1, 34)
	local testCrate = Widgets.dropdown({ Parent = testRow, Order = 1, Width = 240, Options = chestOptions, Value = "starter", Text = chestLabel("starter") })
	local countChips = Widgets.chips({
		Parent = testRow,
		Options = { { Id = 1000, Text = "1,000" }, { Id = 10000, Text = "10,000" }, { Id = 100000, Text = "100,000" } },
		Value = 10000,
		Order = 2,
		Height = 30,
		Width = 80,
	})
	countChips.Frame.Size = UDim2.fromOffset(260, 30)
	countChips.Frame.AutomaticSize = Enum.AutomaticSize.None

	local optionsRow = Widgets.row(testSection, 2, 34)
	Widgets.rowLabel(optionsRow, "Luck bonus", 80, 1)
	local luckBox = Widgets.textbox({ Placeholder = "0 (1 = +100%)", Size = UDim2.fromOffset(130, 32), LayoutOrder = 2, MaxLength = 6, Parent = optionsRow })
	Widgets.rowLabel(optionsRow, "Pity", 40, 3)
	local pityOn = false
	UI.toggle({
		Value = false,
		LayoutOrder = 4,
		OnChange = function(value)
			pityOn = value
		end,
		Parent = optionsRow,
	})
	local runTest = Widgets.button({ Text = "▶ Run simulation", Variant = "adminPrimary", Size = UDim2.fromOffset(160, 32), LayoutOrder = 5, Parent = optionsRow })
	Widgets.gate(runTest, canTest, "items.test")

	local resultsFrame = UI.frame({ Name = "Results", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, List = { Pad = 2 }, Parent = testSection })

	local function header(parent: Instance, cells: { string }, color: Color3?, order: number, bold: boolean?)
		local row = UI.frame({ Size = UDim2.new(1, 0, 0, 22), LayoutOrder = order, Parent = parent })
		local widths = { 0.31, 0.23, 0.23, 0.23 }
		local x = 0
		for i, text in ipairs(cells) do
			Widgets.label({
				Text = text,
				Font = if bold then F.Heading else F.Medium,
				TextSize = 13,
				TextColor3 = if i == 1 and color then color else (if bold then P.TextDim else P.Text),
				Size = UDim2.new(widths[i], 0, 1, 0),
				Position = UDim2.fromScale(x, 0),
				TextXAlignment = if i == 1 then Enum.TextXAlignment.Left else Enum.TextXAlignment.Right,
				Parent = row,
			})
			x += widths[i]
		end
	end

	runTest.Activated:Connect(function()
		if runTest:GetAttribute("Disabled") then
			return
		end
		local luck = if luckBox.Text == "" then 0 else tonumber(luckBox.Text)
		if luck == nil or luck < 0 or luck > 10 then
			ctx.toast("Luck must be a number from 0 to 10.", "error")
			return
		end
		Widgets.clear(resultsFrame)
		Widgets.dim({ Text = "Simulating…", LayoutOrder = 1, Parent = resultsFrame })
		local response = ctx.Net.run("items.simulate", { Chest = testCrate.Get(), Count = countChips.Get(), Luck = luck, Pity = pityOn }, { Label = "Simulation", Silent = true })
		Widgets.clear(resultsFrame)
		if not response.ok or type(response.data) ~= "table" then
			Widgets.label({ Text = response.err or "Simulation failed.", TextColor3 = P.Danger, LayoutOrder = 1, Parent = resultsFrame })
			ctx.log("Simulation: " .. tostring(response.err), "error")
			return
		end
		local data = response.data
		header(resultsFrame, { "Rarity", "Drops", "Observed", "Expected" }, nil, 1, true)
		local order = 2
		for _, rarityId in ipairs(Rarities.Order) do
			local expected = data.Expected and data.Expected[rarityId]
			if expected then
				local drops = (data.Counts and data.Counts[rarityId]) or 0
				header(resultsFrame, {
					rarityId,
					Format.commas(drops),
					Format.pct(drops / math.max(1, data.Count), 2),
					Format.pct(expected, 2),
				}, Widgets.rarityColor(rarityId), order)
				order += 1
			end
		end
		Widgets.dim({ Text = `{Format.commas(data.Count)} × {chestLabel(data.Chest)} · No player data changed.`, LayoutOrder = order, Parent = resultsFrame })
		ctx.log(response.message or "Simulation complete.", "ok")
	end)

	-- Forced-rarity test drop ----------------------------------------------------------------------
	local forceSection = Widgets.section(scroll, "Forced-rarity test drop", 6, "Gives the target one item of the chosen rarity from the crate's pool. Logged as a test; real odds are unchanged.")
	local forceRow = Widgets.row(forceSection, 1, 34)
	local forceCrate = Widgets.dropdown({ Parent = forceRow, Order = 1, Width = 240, Options = chestOptions, Value = "starter", Text = chestLabel("starter") })
	local forceRarity = Widgets.dropdown({
		Parent = forceRow,
		Order = 2,
		Width = 160,
		Value = "Legendary",
		Text = "Legendary",
		Options = function()
			local options = {}
			local chest = Chests.ById[forceCrate.Get()]
			for _, rarityId in ipairs(Rarities.Order) do
				if chest and chest.Weights[rarityId] then
					table.insert(options, { Text = rarityId, Value = rarityId, Color = Rarities.ById[rarityId].Color })
				end
			end
			return options
		end,
	})
	local forceButton = Widgets.button({
		Text = "🎲 Give test drop",
		Variant = "adminMagenta",
		Size = UDim2.fromOffset(160, 32),
		LayoutOrder = 3,
		OnClick = function()
			local t = target()
			if t ~= nil then
				ctx.Net.run("items.forceRoll", { Target = t, Chest = forceCrate.Get(), Rarity = forceRarity.Get() }, { Label = "Test drop" })
			end
		end,
		Parent = forceRow,
	})
	Widgets.gate(forceButton, canTest, "items.test")

	renderItems()

	local tab = {}
	function tab.OnShow(mode: string?)
		if mode == "inspect" then
			inspectInventory()
			task.defer(function()
				scroll.CanvasPosition = Vector2.new(0, math.max(0, inventorySection.AbsolutePosition.Y - scroll.AbsolutePosition.Y + scroll.CanvasPosition.Y - 10))
			end)
		end
	end
	return tab
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Logs</string>
              <string name="Source"><![CDATA[--[[
	Audit Logs tab (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/Tabs/Logs
	Depends on: AdminUI/Widgets, AdminUI/LogRow
	Server actions: logs.recent { Filter, Result, Limit }, logs.security, logs.persisted { Day }
	Push: AdminPush "log" appends new entries live while the audit view is shown.

	Three views: this server's audit log (live), security flags (suspicious
	client requests) and the persisted audit log of every server for a UTC day.
]]

local Widgets = require(script.Parent.Parent.Widgets)
local LogRow = require(script.Parent.Parent.LogRow)

local UI = Widgets.UI
local P = Widgets.P

local MAX_ROWS = 300

local RESULTS = {
	{ Id = "all", Text = "All" },
	{ Id = "success", Text = "Success", Color = Widgets.Result.success },
	{ Id = "denied", Text = "Denied", Color = Widgets.Result.denied },
	{ Id = "invalid", Text = "Invalid", Color = Widgets.Result.invalid },
	{ Id = "error", Text = "Error", Color = Widgets.Result.error },
	{ Id = "rate_limited", Text = "Rate limited", Color = Widgets.Result.rate_limited },
	{ Id = "confirm_required", Text = "Confirm", Color = Widgets.Result.confirm_required },
	{ Id = "duplicate", Text = "Duplicate", Color = Widgets.Result.duplicate },
}

return function(ctx, container: Frame)
	local mode = "audit"
	local resultFilter = "all"
	local entries: { any } = {}
	local rows: { Frame } = {}

	local controls = UI.frame({ Name = "Controls", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, List = { Pad = 6 }, Parent = container })
	local topRow = Widgets.row(controls, 1, 32)
	local modeChips
	local search = Widgets.textbox({ Placeholder = "🔍 Filter by admin, action, target, UserId…", Size = UDim2.new(1, -500, 0, 32), LayoutOrder = 2, MaxLength = 60, Parent = topRow })
	local dayBox = Widgets.textbox({ Text = Widgets.today(), Size = UDim2.fromOffset(110, 32), LayoutOrder = 3, MaxLength = 10, Parent = topRow })
	local loadDay = Widgets.button({ Text = "Load day", Size = UDim2.fromOffset(100, 32), LayoutOrder = 4, Variant = "adminMagenta", Parent = topRow })
	Widgets.gate(loadDay, ctx.has("logs.persisted"), "logs.persisted")
	local refresh = Widgets.button({ Text = "↻", Size = UDim2.fromOffset(40, 32), LayoutOrder = 5, Parent = topRow })

	local resultChips = Widgets.chips({
		Parent = controls,
		Options = RESULTS,
		Value = "all",
		Order = 2,
		Height = 26,
		OnChange = function(id)
			resultFilter = id
			ctx.refreshLogs()
		end,
	})
	local status = Widgets.dim({ Text = "", TextSize = 12, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 16), Parent = controls })

	local list = UI.scroll({
		Name = "Entries",
		Position = UDim2.fromOffset(0, 110),
		Size = UDim2.new(1, 0, 1, -110),
		ScrollBarImageColor3 = P.Stroke,
		List = { Pad = 4 },
		Padding = { 0, 8, 0, 4 },
		Parent = container,
	})
	-- Keep the list just below the controls even when the chip row wraps.
	-- The top row has a fixed 32 px height, which gives the current UI scale.
	local function placeList()
		local scale = topRow.AbsoluteSize.Y / 32
		if scale <= 0 then
			return
		end
		local height = math.ceil(controls.AbsoluteSize.Y / scale) + 8
		list.Position = UDim2.fromOffset(0, height)
		list.Size = UDim2.new(1, 0, 1, -height)
	end
	controls:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeList)
	topRow:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeList)

	local function render()
		local filler = if mode == "security" then LogRow.fillSecurity else LogRow.fillAudit
		for i, entry in ipairs(entries) do
			local row = rows[i]
			if not row then
				row = LogRow.create(list, ctx.Prefs.Compact)
				rows[i] = row
			end
			row.LayoutOrder = i
			row.Visible = true
			filler(row, entry)
		end
		for i = #entries + 1, #rows do
			rows[i].Visible = false
		end
	end

	local function setEntries(list_: { any }, text: string)
		entries = {}
		for i = 1, math.min(MAX_ROWS, #list_) do
			entries[i] = list_[i]
		end
		status.Text = text
		render()
	end

	function ctx.refreshLogs()
		if mode == "security" then
			local response = ctx.Net.request("logs.security")
			if response.ok and type(response.data) == "table" then
				setEntries(response.data.Entries or {}, `Security flags in this server (newest first): {#(response.data.Entries or {})}`)
			else
				status.Text = response.err or "Could not load security flags."
			end
			return
		end
		local response = ctx.Net.request("logs.recent", { Filter = search.Text, Result = resultFilter, Limit = MAX_ROWS })
		if response.ok and type(response.data) == "table" then
			setEntries(response.data.Entries or {}, `Audit log of this server (newest first, live): {#(response.data.Entries or {})} entries`)
		else
			status.Text = response.err or "Could not load the audit log."
		end
	end

	modeChips = Widgets.chips({
		Parent = topRow,
		Options = { { Id = "audit", Text = "📜 Audit" }, { Id = "security", Text = "🚩 Security" } },
		Value = "audit",
		Order = 1,
		Height = 32,
		Width = 100,
		OnChange = function(id)
			mode = id
			resultChips.Frame.Visible = id == "audit"
			for _, row in ipairs(rows) do
				row:Destroy()
			end
			rows = {}
			ctx.refreshLogs()
		end,
	})
	modeChips.Frame.Size = UDim2.fromOffset(212, 32)
	modeChips.Frame.AutomaticSize = Enum.AutomaticSize.None

	local searchVersion = 0
	search:GetPropertyChangedSignal("Text"):Connect(function()
		searchVersion += 1
		local mine = searchVersion
		task.delay(0.4, function()
			if mine == searchVersion and mode == "audit" then
				ctx.refreshLogs()
			end
		end)
	end)
	refresh.Activated:Connect(function()
		ctx.refreshLogs()
	end)
	loadDay.Activated:Connect(function()
		if loadDay:GetAttribute("Disabled") then
			return
		end
		local day = string.gsub(dayBox.Text, "%s", "")
		if not string.match(day, "^%d%d%d%d%-%d%d%-%d%d$") then
			ctx.toast("Use the format YYYY-MM-DD.", "error")
			return
		end
		local response = ctx.Net.request("logs.persisted", { Day = day })
		if response.ok and type(response.data) == "table" then
			mode = "persisted"
			modeChips.Set(nil)
			resultChips.Frame.Visible = false
			for _, row in ipairs(rows) do
				row:Destroy()
			end
			rows = {}
			setEntries(response.data.Entries or {}, `Persisted audit log for {day} (all servers, newest first): {#(response.data.Entries or {})} entries — press Audit to return to live view.`)
			ctx.log(response.message or "Loaded persisted logs.", "ok")
		else
			ctx.toast(response.err or "Could not load persisted logs.", "error")
		end
	end)

	local function matches(entry): boolean
		if resultFilter ~= "all" and entry.Result ~= resultFilter then
			return false
		end
		local needle = string.lower(search.Text)
		if needle == "" then
			return true
		end
		local hay = string.lower(table.concat({
			tostring(entry.Action),
			tostring(entry.AdminName),
			tostring(entry.TargetName),
			tostring(entry.Params),
			tostring(entry.Message),
			tostring(entry.AdminId),
			tostring(entry.TargetId),
		}, " "))
		return string.find(hay, needle, 1, true) ~= nil
	end

	ctx.LogPushed:Connect(function(entry)
		if mode ~= "audit" or not matches(entry) then
			return
		end
		table.insert(entries, 1, entry)
		if #entries > MAX_ROWS then
			table.remove(entries)
		end
		if container.Visible then
			render()
		end
	end)

	local tab = {}
	function tab.OnShow()
		ctx.refreshLogs()
	end
	return tab
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">Moderation</string>
              <string name="Source"><![CDATA[--[[
	Moderation tab (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/Tabs/Moderation
	Depends on: AdminUI/Widgets, AdminUI/TargetPicker
	Server actions: players.ban, players.unban, players.bans,
	                staff.list, staff.setRole, staff.removeRole

	Bans work in every server and also for players who are offline (#UserId or
	their exact Roblox username). Owners can hand out the Moderator and Admin
	roles here. Everything is checked again on the server: the ban length limit
	of the role, rank protection, and that roles from AdminConfig cannot be
	changed. This tab only hides what the role cannot use.
]]

local Widgets = require(script.Parent.Parent.Widgets)
local TargetPicker = require(script.Parent.Parent.TargetPicker)

local UI = Widgets.UI
local P = Widgets.P
local F = Widgets.Theme.Fonts

local LENGTHS = {
	{ Id = "1h", Text = "1 hour", Days = 1 / 24 },
	{ Id = "1d", Text = "1 day", Days = 1 },
	{ Id = "7d", Text = "7 days", Days = 7 },
	{ Id = "30d", Text = "30 days", Days = 30 },
	{ Id = "perm", Text = "Permanent", Days = math.huge },
}

return function(ctx, container: Frame)
	local scroll = Widgets.scroll(container)
	local canBan = ctx.has("players.ban")
	local canStaff = ctx.has("staff.manage")
	local maxDays = ctx.Hello.MaxBanDays or 0 -- 0 = no limit
	local persistent = ctx.Hello.ModerationPersistent ~= false
	local tab: { [string]: any } = {}

	if not persistent then
		local note = Widgets.section(scroll, "⚠ Studio test session", 0)
		Widgets.dim({
			Text = "Roblox data services are not available here (enable Studio Access to API Services). Bans and roles only last until this session ends.",
			TextColor3 = P.Warning,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 1,
			Parent = note,
		})
	end

	local function targetBox(parent: Instance, order: number): TextBox
		local row = Widgets.row(parent, order, 34)
		Widgets.rowLabel(row, "Player", 70, 1)
		return Widgets.textbox({
			Placeholder = "name, @username or #UserId (also offline)",
			Size = UDim2.fromOffset(300, 32),
			LayoutOrder = 2,
			MaxLength = 50,
			Parent = row,
		})
	end

	-- Ban ------------------------------------------------------------------------------------------
	local banTarget: TextBox? = nil
	local banList: Frame? = nil

	if canBan then
		local limitText = if maxDays == 0 then "Your role can ban for any length, including permanently." else `Your role can ban for up to {maxDays} days.`
		local banSection = Widgets.section(scroll, "Ban a player", 1, "Bans apply in every server and keep the player out until they end. " .. limitText)
		banTarget = targetBox(banSection, 1)

		local options = {}
		for _, length in ipairs(LENGTHS) do
			if maxDays == 0 or length.Days <= maxDays then
				table.insert(options, { Id = length.Id, Text = length.Text, Color = if length.Id == "perm" then P.Danger else nil })
			end
		end
		local lengthRow = Widgets.row(banSection, 2, 30)
		Widgets.rowLabel(lengthRow, "Length", 70, 1)
		local chipsHolder = UI.frame({ Size = UDim2.new(1, -80, 0, 30), LayoutOrder = 2, Parent = lengthRow })
		local length = Widgets.chips({ Parent = chipsHolder, Options = options, Value = "1d", Height = 30 })

		local reasonRow = Widgets.row(banSection, 3, 34)
		Widgets.rowLabel(reasonRow, "Reason", 70, 1)
		local reason = Widgets.textbox({
			Placeholder = "Shown to the player (filtered by Roblox)",
			Size = UDim2.new(1, -80, 0, 32),
			LayoutOrder = 2,
			MaxLength = 200,
			Parent = reasonRow,
		})

		Widgets.button({
			Text = "🚫 Ban",
			Variant = "adminDanger",
			Size = UDim2.fromOffset(140, 34),
			LayoutOrder = 4,
			OnClick = function()
				local query = TargetPicker.queryFromText((banTarget :: TextBox).Text)
				local text = string.gsub(reason.Text, "^%s*(.-)%s*$", "%1")
				if not query then
					ctx.toast("Enter a player first.", "error")
					return
				end
				if text == "" then
					ctx.toast("A ban reason is required.", "error")
					return
				end
				local response = ctx.Net.run("players.ban", { Target = query, Duration = length.Get(), Reason = text }, { Label = "Ban", ConfirmTitle = "Ban player" })
				if response.ok then
					reason.Text = ""
					task.spawn(tab.RefreshBans)
					task.delay(0.5, ctx.refreshPlayers)
				end
			end,
			Parent = banSection,
		})

		local listSection = Widgets.section(scroll, "Active bans", 2)
		local refreshRow = Widgets.row(listSection, 1, 30)
		Widgets.button({
			Text = "↻ Refresh",
			Variant = "adminGhost",
			Size = UDim2.fromOffset(110, 28),
			LayoutOrder = 1,
			OnClick = function()
				tab.RefreshBans()
			end,
			Parent = refreshRow,
		})
		banList = UI.frame({
			Name = "Bans",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			List = { Pad = 6 },
			Parent = listSection,
		})
	end

	function tab.RefreshBans()
		if not banList then
			return
		end
		local response = ctx.Net.request("players.bans")
		local list = banList :: Frame
		Widgets.clear(list)
		if not response.ok then
			Widgets.dim({ Text = response.err or "Could not load bans.", TextColor3 = P.Danger, Size = UDim2.new(1, 0, 0, 20), Parent = list })
			return
		end
		local bans = if type(response.data) == "table" then response.data.Bans or {} else {}
		if #bans == 0 then
			Widgets.dim({ Text = "Nobody is banned.", Size = UDim2.new(1, 0, 0, 20), Parent = list })
			return
		end
		for index, ban in ipairs(bans) do
			local row = UI.new("Frame", {
				Name = "Ban",
				Size = UDim2.new(1, 0, 0, 52),
				BackgroundColor3 = P.Background,
				LayoutOrder = index,
				Corner = 10,
				Stroke = { Color = P.Danger, Transparency = 0.6 },
				Parent = list,
			})
			local length = if ban.Until == 0 then "permanent" else "until " .. os.date("!%Y-%m-%d %H:%M", ban.Until) .. " UTC"
			Widgets.label({
				Text = `{ban.Name}  ·  {length}`,
				Font = F.Bold,
				Size = UDim2.new(1, -130, 0, 20),
				Position = UDim2.fromOffset(12, 6),
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = row,
			})
			Widgets.dim({
				Text = `by {ban.ByName}: {ban.Reason}`,
				TextSize = 12,
				Size = UDim2.new(1, -130, 0, 18),
				Position = UDim2.fromOffset(12, 28),
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = row,
			})
			Widgets.button({
				Text = "Unban",
				Variant = "adminSecondary",
				Size = UDim2.fromOffset(100, 30),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				OnClick = function()
					local response2 = ctx.Net.run("players.unban", { Target = "#" .. tostring(ban.UserId) }, { Label = "Unban" })
					if response2.ok then
						tab.RefreshBans()
					end
				end,
				Parent = row,
			})
		end
	end

	-- Staff roles ------------------------------------------------------------------------------------
	local staffList: Frame? = nil
	local staffTarget: TextBox? = nil

	if canStaff then
		local staffSection = Widgets.section(
			scroll,
			"Staff roles",
			3,
			"Owners can make players Moderator or Admin in every server. Roles from AdminConfig or place ownership cannot be changed here."
		)
		Widgets.dim({
			Text = "Moderator: kick, freeze, teleport, ban (limited length).   Admin: also currencies, items, events and longer bans.",
			TextSize = 12,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 1,
			Parent = staffSection,
		})
		staffTarget = targetBox(staffSection, 2)
		local roleRow = Widgets.row(staffSection, 3, 30)
		Widgets.rowLabel(roleRow, "Role", 70, 1)
		local roleHolder = UI.frame({ Size = UDim2.new(1, -80, 0, 30), LayoutOrder = 2, Parent = roleRow })
		local roleOptions = {}
		for _, role in ipairs({ "Moderator", "Admin" }) do
			table.insert(roleOptions, { Id = role, Text = if role == "Moderator" then "🛡️ Moderator" else "⭐ Admin" })
		end
		local roleChips = Widgets.chips({ Parent = roleHolder, Options = roleOptions, Value = "Moderator", Height = 30 })

		local buttons = Widgets.row(staffSection, 4, 34)
		Widgets.button({
			Text = "Give role",
			Variant = "adminPrimary",
			Size = UDim2.fromOffset(140, 34),
			LayoutOrder = 1,
			OnClick = function()
				local query = TargetPicker.queryFromText((staffTarget :: TextBox).Text)
				if not query then
					ctx.toast("Enter a player first.", "error")
					return
				end
				local response = ctx.Net.run("staff.setRole", { Target = query, Role = roleChips.Get() }, { Label = "Staff role", ConfirmTitle = "Give staff role" })
				if response.ok then
					task.spawn(tab.RefreshStaff)
				end
			end,
			Parent = buttons,
		})
		Widgets.button({
			Text = "Remove role",
			Variant = "adminDanger",
			Size = UDim2.fromOffset(140, 34),
			LayoutOrder = 2,
			OnClick = function()
				local query = TargetPicker.queryFromText((staffTarget :: TextBox).Text)
				if not query then
					ctx.toast("Enter a player first.", "error")
					return
				end
				local response = ctx.Net.run("staff.removeRole", { Target = query }, { Label = "Staff role" })
				if response.ok then
					task.spawn(tab.RefreshStaff)
				end
			end,
			Parent = buttons,
		})

		staffList = UI.frame({
			Name = "Staff",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 5,
			List = { Pad = 6 },
			Parent = staffSection,
		})
	end

	function tab.RefreshStaff()
		if not staffList then
			return
		end
		local response = ctx.Net.request("staff.list")
		local list = staffList :: Frame
		Widgets.clear(list)
		if not response.ok then
			Widgets.dim({ Text = response.err or "Could not load staff.", TextColor3 = P.Danger, Size = UDim2.new(1, 0, 0, 20), Parent = list })
			return
		end
		local staff = if type(response.data) == "table" then response.data.Staff or {} else {}
		if #staff == 0 then
			Widgets.dim({ Text = "Nobody has a role given in the game yet.", Size = UDim2.new(1, 0, 0, 20), Parent = list })
			return
		end
		for index, entry in ipairs(staff) do
			local row = UI.new("Frame", {
				Name = "StaffEntry",
				Size = UDim2.new(1, 0, 0, 44),
				BackgroundColor3 = P.Background,
				LayoutOrder = index,
				Corner = 10,
				Stroke = { Color = if entry.Role == "Admin" then P.Accent else P.Accent2, Transparency = 0.6 },
				Parent = list,
			})
			Widgets.label({
				Text = `{if entry.Role == "Admin" then "⭐" else "🛡️"} {entry.Role} · {entry.Name}`,
				Font = F.Bold,
				Size = UDim2.new(1, -130, 0, 20),
				Position = UDim2.fromOffset(12, 4),
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = row,
			})
			Widgets.dim({
				Text = `#{entry.UserId} · given by {entry.ByName}`,
				TextSize = 12,
				Size = UDim2.new(1, -130, 0, 16),
				Position = UDim2.fromOffset(12, 24),
				Parent = row,
			})
			Widgets.button({
				Text = "Remove",
				Variant = "adminSecondary",
				Size = UDim2.fromOffset(100, 30),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				OnClick = function()
					local response2 = ctx.Net.run("staff.removeRole", { Target = "#" .. tostring(entry.UserId) }, { Label = "Staff role" })
					if response2.ok then
						tab.RefreshStaff()
					end
				end,
				Parent = row,
			})
		end
	end

	-- Opened from the Players tab with a player already chosen.
	function tab.OnShow(userId: number?, mode: string?)
		if userId then
			local box = if mode == "staff" then staffTarget else banTarget
			if box then
				box.Text = "#" .. tostring(userId)
			end
		end
		tab.RefreshBans()
		tab.RefreshStaff()
	end

	return tab
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Players</string>
              <string name="Source"><![CDATA[--[[
	Players tab (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/Tabs/Players
	Depends on: AdminUI/Widgets, ReplicatedStorage/Shared/Format, ReplicatedStorage/Shared/Config/{Upgrades,Skills,Chests}
	Server actions: players.list, players.inspect, players.teleportTo, players.bring,
	                players.freeze, players.unfreeze, players.respawn, players.kick
	                (Ban and staff-role buttons open the Moderation tab)

	Searchable list of online players; selecting one shows their progression,
	inventory summary, statistics and moderation actions. Offline players can
	be looked up by UserId when the role has offline.read.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local Format = require(Shared:WaitForChild("Format"))
local Upgrades = require(Config:WaitForChild("Upgrades"))
local Chests = require(Config:WaitForChild("Chests"))

local Widgets = require(script.Parent.Parent.Widgets)

local UI = Widgets.UI
local P = Widgets.P
local F = Widgets.Theme.Fonts

local STAT_ROWS = {
	{ "TotalClicks", "Presses" },
	{ "AutoClicks", "Auto presses" },
	{ "LifetimeSparks", "Lifetime Sparks" },
	{ "SparksThisRun", "Sparks this run" },
	{ "ChestsOpened", "Crates opened" },
	{ "HighestCombo", "Highest combo" },
	{ "TotalCrits", "Critical presses" },
	{ "GoldenClicks", "Golden presses" },
	{ "UpgradesPurchased", "Upgrade levels bought" },
	{ "ItemsSold", "Items sold" },
	{ "QuestsCompleted", "Quests completed" },
	{ "OrbsCollected", "Orbs collected" },
	{ "PlayTime", "Play time" },
}

return function(ctx, container: Frame)
	local left = UI.frame({ Name = "Left", Size = UDim2.new(0.38, -6, 1, 0), Parent = container })
	local right = UI.new("Frame", {
		Name = "Right",
		Position = UDim2.new(0.38, 6, 0, 0),
		Size = UDim2.new(0.62, -6, 1, 0),
		BackgroundColor3 = P.PanelLight,
		Corner = 12,
		Stroke = { Color = P.Stroke, Transparency = 0.4 },
		Parent = container,
	})

	local search = Widgets.textbox({ Placeholder = "🔍 Search name, display name or UserId", Size = UDim2.new(1, 0, 0, 32), Parent = left })
	local listHeight = if ctx.has("offline.read") then -86 else -40
	local list = UI.scroll({
		Name = "PlayerList",
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 1, listHeight),
		ScrollBarImageColor3 = P.Stroke,
		List = { Pad = 4 },
		Padding = { 0, 6, 0, 0 },
		Parent = left,
	})

	if ctx.has("offline.read") then
		local offline = UI.frame({ Name = "Offline", Position = UDim2.new(0, 0, 1, -38), Size = UDim2.new(1, 0, 0, 34), List = { Dir = "X", Pad = 6, VA = "Center" }, Parent = left })
		local idBox = Widgets.textbox({ Placeholder = "Offline UserId", Size = UDim2.new(1, -116, 0, 32), LayoutOrder = 1, MaxLength = 20, Parent = offline })
		Widgets.button({
			Text = "Look up",
			Size = UDim2.fromOffset(110, 32),
			LayoutOrder = 2,
			Variant = "adminMagenta",
			OnClick = function()
				local digits = string.match(idBox.Text, "^%s*#?(%d+)%s*$")
				if not digits then
					ctx.toast("Enter a numeric UserId.", "error")
					return
				end
				ctx.showDetails("#" .. digits)
			end,
			Parent = offline,
		})
	end

	local details = UI.scroll({
		Name = "Details",
		Size = UDim2.fromScale(1, 1),
		ScrollBarImageColor3 = P.Stroke,
		List = { Pad = 10 },
		Padding = 14,
		Parent = right,
	})

	local rows: { [number]: TextButton } = {}
	local selected: any = nil
	local lastInspect: any = nil

	local function matches(p, query: string): boolean
		if query == "" then
			return true
		end
		local q = string.lower(query)
		return string.find(string.lower(p.Name), q, 1, true) ~= nil
			or string.find(string.lower(p.DisplayName), q, 1, true) ~= nil
			or string.find(tostring(p.UserId), q, 1, true) ~= nil
	end

	local function renderList()
		local seen = {}
		for index, p in ipairs(ctx.Players) do
			seen[p.UserId] = true
			local row = rows[p.UserId]
			if not row then
				row = UI.new("TextButton", {
					Name = "Player",
					Size = UDim2.new(1, 0, 0, 52),
					BackgroundColor3 = P.PanelLight,
					AutoButtonColor = false,
					Text = "",
					Corner = 10,
					Stroke = { Color = P.Stroke, Transparency = 0.5 },
					Parent = list,
				})
				Widgets.label({ Name = "Display", Font = F.Bold, Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(10, 6), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
				Widgets.dim({ Name = "Sub", Size = UDim2.new(1, -16, 0, 16), Position = UDim2.fromOffset(10, 28), TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
				row.Activated:Connect(function()
					ctx.showDetails(p.UserId)
				end)
				row.MouseEnter:Connect(function()
					row.BackgroundColor3 = P.PanelLighter
				end)
				row.MouseLeave:Connect(function()
					row.BackgroundColor3 = P.PanelLight
				end)
				rows[p.UserId] = row
			end
			row.LayoutOrder = index
			local display = row:FindFirstChild("Display") :: TextLabel
			local sub = row:FindFirstChild("Sub") :: TextLabel
			local tags = {}
			if p.StaffRole then
				table.insert(tags, "★ " .. p.StaffRole)
			end
			if p.Frozen then
				table.insert(tags, "❄ Frozen")
			end
			if not p.Loaded then
				table.insert(tags, "loading…")
			end
			display.Text = p.DisplayName .. (if #tags > 0 then "   " .. table.concat(tags, "  ") else "")
			display.TextColor3 = if p.StaffRole then P.Accent2 else P.Text
			sub.Text = `@{p.Name} · #{p.UserId} · Lv {p.Level} · {Format.short(p.Sparks)} ⚡ · {p.Rebirths} asc.`
			row.Visible = matches(p, search.Text)
			local stroke = row:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = if selected == p.UserId then P.Accent else P.Stroke
				stroke.Transparency = if selected == p.UserId then 0 else 0.5
			end
		end
		for userId, row in pairs(rows) do
			if not seen[userId] then
				row:Destroy()
				rows[userId] = nil
			end
		end
	end

	search:GetPropertyChangedSignal("Text"):Connect(renderList)
	ctx.PlayersUpdated:Connect(renderList)

	local function kv(parent: Instance, key: string, value: string, order: number)
		local row = UI.frame({ Size = UDim2.new(1, 0, 0, 18), LayoutOrder = order, Parent = parent })
		Widgets.dim({ Text = key, Size = UDim2.new(0.45, 0, 1, 0), TextSize = 13, Parent = row })
		Widgets.label({ Text = value, Size = UDim2.new(0.55, 0, 1, 0), Position = UDim2.fromScale(0.45, 0), TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
	end

	local function actionButton(parent: Instance, text: string, variant: string, permission: string, order: number, fn: () -> ())
		local button = Widgets.button({ Text = text, Variant = variant, Size = UDim2.fromOffset(0, 32), AutomaticSize = Enum.AutomaticSize.X, Padding = { X = 12 }, LayoutOrder = order, OnClick = fn, Parent = parent })
		Widgets.gate(button, ctx.has(permission), permission)
		return button
	end

	local function render(data)
		Widgets.clear(details)
		if not data then
			Widgets.dim({ Text = "Select a player on the left to inspect them.", Size = UDim2.new(1, 0, 0, 24), Parent = details })
			return
		end
		local online = data.Online ~= false
		local header = UI.frame({ Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 1, Parent = details })
		Widgets.label({
			Text = if online then data.DisplayName else "Offline player",
			Font = F.Heading,
			TextSize = 22,
			Size = UDim2.new(1, 0, 0, 26),
			Parent = header,
		})
		Widgets.dim({
			Text = if online then `@{data.Name} · UserId {data.UserId} · in session {data.SessionMinutes} min` else `UserId {data.UserId} · last seen {if data.LastSeen and data.LastSeen > 0 then Format.time(workspace:GetServerTimeNow() - data.LastSeen) .. " ago" else "unknown"}`,
			Size = UDim2.new(1, 0, 0, 18),
			Position = UDim2.fromOffset(0, 28),
			Parent = header,
		})
		local tagRow = UI.frame({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 2, List = { Dir = "X", Pad = 6, VA = "Center" }, Parent = details })
		if data.StaffRole then
			Widgets.tag(tagRow, "STAFF · " .. string.upper(data.StaffRole), P.Accent2, 1)
		end
		if data.Frozen then
			Widgets.tag(tagRow, "FROZEN", Color3.fromRGB(120, 200, 255), 2)
		end
		if data.Temporary then
			Widgets.tag(tagRow, "NOT SAVING (temporary data)", P.Warning, 3)
		end
		if not online then
			Widgets.tag(tagRow, "OFFLINE · read-only view", P.TextDim, 4)
		end
		if type(data.Passes) == "table" and #data.Passes > 0 then
			Widgets.tag(tagRow, "PASSES · " .. string.upper(table.concat(data.Passes, ", ")), P.Accent, 5)
		end

		if online then
			local actions = UI.frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = details })
			local layout = UI.list(actions, { Dir = "X", Pad = 6 })
			layout.Wraps = true
			local userId = data.UserId
			local label = `{data.DisplayName} (@{data.Name})`
			actionButton(actions, "📍 Teleport to", "adminSecondary", "players.teleport", 1, function()
				ctx.Net.run("players.teleportTo", { Target = userId }, { Label = "Teleport" })
			end)
			actionButton(actions, "🧲 Bring", "adminSecondary", "players.teleport", 2, function()
				ctx.Net.run("players.bring", { Target = userId }, { Label = "Bring" })
			end)
			actionButton(actions, if data.Frozen then "🔥 Unfreeze" else "❄ Freeze", "adminSecondary", "players.freeze", 3, function()
				ctx.Net.run(if data.Frozen then "players.unfreeze" else "players.freeze", { Target = userId }, { Label = "Freeze" })
				ctx.showDetails(userId)
			end)
			actionButton(actions, "♻ Respawn", "adminSecondary", "players.respawn", 4, function()
				ctx.Net.run("players.respawn", { Target = userId }, { Label = "Respawn" })
			end)
			actionButton(actions, "🎒 Inspect inventory", "adminMagenta", "players.inspect", 5, function()
				ctx.setTarget(userId, label)
				ctx.switchTab("Items", "inspect")
			end)
			actionButton(actions, "🎯 Select as target", "adminGhost", "players.view", 6, function()
				ctx.setTarget(userId, label)
				ctx.toast("Target set to " .. label, "ok")
			end)
			actionButton(actions, "⛔ Kick", "adminDanger", "players.kick", 7, function()
				local reason = UI.prompt({
					Title = "Kick " .. data.DisplayName,
					Message = "The reason is shown to the player (filtered by Roblox) and stored in the audit log.",
					Placeholder = "Reason (required)",
					MaxLength = 200,
					ConfirmText = "Kick",
					Danger = true,
					Palette = P,
				})
				if reason and string.match(reason, "%S") then
					ctx.Net.run("players.kick", { Target = userId, Reason = reason }, { Label = "Kick" })
					task.wait(0.5)
					ctx.refreshPlayers()
				elseif reason then
					ctx.toast("A kick reason is required.", "error")
				end
			end)
		end
		if data.UserId then
			local modActions = UI.frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = details })
			local modLayout = UI.list(modActions, { Dir = "X", Pad = 6 })
			modLayout.Wraps = true
			local targetId = data.UserId
			actionButton(modActions, "🚫 Ban…", "adminDanger", "players.ban", 1, function()
				ctx.switchTab("Moderation", targetId, "ban")
			end)
			if ctx.has("staff.manage") then
				actionButton(modActions, "🛡️ Staff role…", "adminMagenta", "staff.manage", 2, function()
					ctx.switchTab("Moderation", targetId, "staff")
				end)
			end
		end

		local progress = Widgets.section(details, "Currencies & progression", 4)
		local c = data.Currencies or {}
		kv(progress, "⚡ Sparks", Format.short(c.Sparks) .. "  (" .. Format.commas(c.Sparks) .. ")", 1)
		kv(progress, "💎 Gems", Format.commas(c.Gems), 2)
		kv(progress, "🔷 Prisms", Format.commas(c.Prisms), 3)
		kv(progress, "Level", `{data.Level}` .. (if data.XP then `  ({Format.short(data.XP)} XP)` else ""), 4)
		kv(progress, "Skill points", tostring(data.SkillPoints or 0), 5)
		kv(progress, "Ascensions", `{data.Rebirths or 0}` .. (if data.Stage then ` · {data.Stage}` else ""), 6)
		kv(progress, "Items discovered", tostring(data.Discovered or 0), 7)
		if data.Achievements then
			kv(progress, "Achievements", tostring(data.Achievements), 8)
		end
		if data.Derived then
			local derived = data.Derived
			kv(progress, "Per press", Format.short(derived.ClickValue), 9)
			kv(progress, "Passive", Format.short(derived.PassivePerSec) .. "/s", 10)
			kv(progress, "Crit chance", Format.pct(derived.CritChance, 1), 11)
			kv(progress, "Luck", "+" .. Format.pct(derived.Luck), 12)
			kv(progress, "Auto presses", string.format("%.1f/s", derived.AutoRate or 0), 13)
		end

		local upgrades = Widgets.section(details, "Upgrades", 5)
		local upgradeParts = {}
		for _, def in ipairs(Upgrades.List) do
			local level = (data.Upgrades or {})[def.Id]
			if level then
				table.insert(upgradeParts, `{def.Icon} {def.Name} {level}`)
			end
		end
		Widgets.dim({ Text = if #upgradeParts > 0 then table.concat(upgradeParts, "   ") else "No upgrades this run.", TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = upgrades })
		local skillRanks, skillNodes = 0, 0
		for _, rank in pairs(data.Skills or {}) do
			skillRanks += rank
			skillNodes += 1
		end
		Widgets.dim({ Text = `Skills: {skillNodes} nodes, {skillRanks} ranks`, LayoutOrder = 2, Parent = upgrades })

		local inventory = Widgets.section(details, "Inventory", 6)
		local items = data.Inventory or {}
		local copies = 0
		for _, entry in ipairs(items) do
			copies += entry.Count
		end
		Widgets.dim({ Text = `{#items} unique items · {Format.commas(copies)} copies · equipped: {#(data.Equipped or {})}`, LayoutOrder = 1, Parent = inventory })
		for i = 1, math.min(10, #items) do
			local entry = items[i]
			Widgets.label({
				Text = `{if entry.Equipped then "✔ " else ""}{entry.Name} ×{entry.Count}`,
				TextColor3 = Widgets.rarityColor(entry.Rarity),
				TextSize = 13,
				Size = UDim2.new(1, 0, 0, 16),
				LayoutOrder = 1 + i,
				Parent = inventory,
			})
		end
		if #items > 10 then
			Widgets.dim({ Text = `…and {#items - 10} more (see Items tab).`, LayoutOrder = 20, Parent = inventory })
		end
		local crateParts = {}
		for _, chestId in ipairs(Chests.Order) do
			local n = (data.Chests or {})[chestId]
			if n then
				table.insert(crateParts, `{Chests.ById[chestId].Icon} {Chests.ById[chestId].Name} ×{n}`)
			end
		end
		Widgets.dim({ Text = "Crates: " .. (if #crateParts > 0 then table.concat(crateParts, "   ") else "none"), TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 30, Parent = inventory })

		local stats = Widgets.section(details, "Statistics", 7)
		for i, rowDef in ipairs(STAT_ROWS) do
			local value = (data.Stats or {})[rowDef[1]] or 0
			kv(stats, rowDef[2], if rowDef[1] == "PlayTime" then Format.time(value) else Format.short(value), i)
		end

		if data.Security then
			local security = Widgets.section(details, "Security flags", 8)
			local parts = {}
			for reason, count in pairs(data.Security) do
				table.insert(parts, `{reason} ×{count}`)
			end
			table.sort(parts)
			Widgets.dim({ Text = if #parts > 0 then table.concat(parts, "   ") else "None.", TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = security })
		end
	end

	function ctx.showDetails(target: any)
		selected = target
		renderList()
		Widgets.clear(details)
		Widgets.dim({ Text = "Loading…", Size = UDim2.new(1, 0, 0, 24), Parent = details })
		local response = ctx.Net.request("players.inspect", { Target = target })
		if selected ~= target then
			return
		end
		if response.ok and type(response.data) == "table" then
			lastInspect = response.data
			render(response.data)
			if response.message and type(target) == "string" then
				ctx.log("Inspect: " .. response.message, "ok")
			end
		else
			lastInspect = nil
			Widgets.clear(details)
			Widgets.label({ Text = response.err or "Could not load player.", TextColor3 = P.Danger, TextWrapped = true, Size = UDim2.new(1, 0, 0, 40), Parent = details })
		end
	end

	render(nil)

	local tab = { AutoRefresh = 8 }
	function tab.Refresh()
		ctx.refreshPlayers()
	end
	function tab.OnShow()
		ctx.refreshPlayers()
		if not ctx.has("players.inspect") then
			Widgets.clear(details)
			Widgets.dim({ Text = "Your role can list players but not inspect them.", Size = UDim2.new(1, 0, 0, 24), Parent = details })
		elseif lastInspect and selected then
			render(lastInspect)
		end
	end
	return tab
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Progression</string>
              <string name="Source"><![CDATA[--[[
	Progression tab (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/Tabs/Progression
	Depends on: AdminUI/Widgets, AdminUI/TargetPicker, ReplicatedStorage/Shared/Config/{Upgrades,Skills}
	Server actions: progression.setUpgrade, progression.unlockSkill, progression.resetSkills (confirm),
	                progression.grantRebirth, progression.grantLevels, progression.grantSkillPoints,
	                progression.reset (confirm; scope "all" also requires typing the player's name),
	                players.inspect (to show current levels)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local Upgrades = require(Config:WaitForChild("Upgrades"))
local Skills = require(Config:WaitForChild("Skills"))

local Widgets = require(script.Parent.Parent.Widgets)
local TargetPicker = require(script.Parent.Parent.TargetPicker)

local P = Widgets.P
local F = Widgets.Theme.Fonts

local RESET_SCOPES = {
	{ Id = "upgrades", Text = "Upgrades" },
	{ Id = "skills", Text = "Skills (refund)" },
	{ Id = "ascension", Text = "Ascensions" },
	{ Id = "inventory", Text = "Inventory" },
	{ Id = "collection", Text = "Collection" },
	{ Id = "quests", Text = "Quests" },
	{ Id = "stats", Text = "Stats" },
	{ Id = "level", Text = "Level" },
	{ Id = "all", Text = "EVERYTHING", Color = P.Danger },
}

return function(ctx, container: Frame)
	local scroll = Widgets.scroll(container)
	local canGrant = ctx.has("progression.grant")
	local canReset = ctx.has("progression.reset")
	local limits = ctx.Hello.Limits or {}

	local function target(): any
		local query = ctx.Target.Query
		if query == nil then
			ctx.toast("Select a target player first.", "error")
		end
		return query
	end

	local function wholeNumber(box: TextBox, fallback: number?, min: number): number?
		if box.Text == "" and fallback then
			return fallback
		end
		local n = Widgets.parseNumber(box.Text)
		if not n or n ~= math.floor(n) or n < min then
			ctx.toast(`Enter a whole number of at least {min}.`, "error")
			return nil
		end
		return n
	end

	local targetSection = Widgets.section(scroll, "Target", 1)
	TargetPicker.new(ctx, targetSection, 1)
	local loadButton = Widgets.button({ Text = "↻ Load current values", Size = UDim2.fromOffset(190, 30), LayoutOrder = 2, Parent = targetSection })
	Widgets.gate(loadButton, ctx.has("players.inspect"), "players.inspect")
	local summary = Widgets.dim({ Text = "", LayoutOrder = 3, Parent = targetSection })

	-- Upgrades -----------------------------------------------------------------------------------
	local upgradeSection = Widgets.section(scroll, "Shop upgrade levels", 2, "Sets an exact level (0 removes the upgrade).")
	local levelBoxes: { [string]: TextBox } = {}
	for index, def in ipairs(Upgrades.List) do
		local row = Widgets.row(upgradeSection, index, 32)
		Widgets.label({ Text = `{def.Icon} {def.Name}`, Font = F.Bold, Size = UDim2.new(1, -330, 0, 30), LayoutOrder = 1, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
		Widgets.dim({ Text = `max {def.MaxLevel}`, Size = UDim2.fromOffset(70, 30), LayoutOrder = 2, Parent = row })
		local box = Widgets.textbox({ Placeholder = "level", Size = UDim2.fromOffset(90, 30), LayoutOrder = 3, MaxLength = 6, Parent = row })
		levelBoxes[def.Id] = box
		local set = Widgets.button({
			Text = "Set",
			Size = UDim2.fromOffset(80, 30),
			LayoutOrder = 4,
			OnClick = function()
				local t = target()
				local level = wholeNumber(box, nil, 0)
				if t ~= nil and level then
					ctx.Net.run("progression.setUpgrade", { Target = t, Upgrade = def.Id, Level = level }, { Label = def.Name })
				end
			end,
			Parent = row,
		})
		Widgets.gate(set, canGrant, "progression.grant")
	end

	-- Skills -------------------------------------------------------------------------------------
	local skillSection = Widgets.section(scroll, "Skills", 3, "Unlocks a node at max rank for testing (prerequisites are skipped).")
	local skillRow = Widgets.row(skillSection, 1, 34)
	local skillOptions = {}
	for _, node in ipairs(Skills.List) do
		local branch = Skills.Branches[node.Branch]
		table.insert(skillOptions, { Text = `{node.Icon} {node.Name}  ({node.Branch})`, Value = node.Id, Color = branch and branch.Color })
	end
	local first = Skills.List[1]
	local skillDropdown = Widgets.dropdown({ Parent = skillRow, Order = 1, Width = 260, Options = skillOptions, Value = first.Id, Text = `{first.Icon} {first.Name}` })
	local unlock = Widgets.button({
		Text = "Unlock",
		Variant = "adminPrimary",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(100, 32),
		OnClick = function()
			local t = target()
			if t ~= nil then
				ctx.Net.run("progression.unlockSkill", { Target = t, Skill = skillDropdown.Get() }, { Label = "Unlock skill" })
			end
		end,
		Parent = skillRow,
	})
	local unlockAll = Widgets.button({
		Text = "Unlock all",
		LayoutOrder = 3,
		Size = UDim2.fromOffset(110, 32),
		OnClick = function()
			local t = target()
			if t ~= nil then
				ctx.Net.run("progression.unlockSkill", { Target = t, Skill = "all" }, { Label = "Unlock all skills" })
			end
		end,
		Parent = skillRow,
	})
	local resetSkills = Widgets.button({
		Text = "Reset skills",
		Variant = "adminDanger",
		LayoutOrder = 4,
		Size = UDim2.fromOffset(120, 32),
		OnClick = function()
			local t = target()
			if t ~= nil then
				ctx.Net.run("progression.resetSkills", { Target = t }, { Label = "Reset skills" })
			end
		end,
		Parent = skillRow,
	})
	Widgets.gate(unlock, canGrant, "progression.grant")
	Widgets.gate(unlockAll, canGrant, "progression.grant")
	Widgets.gate(resetSkills, canReset, "progression.reset")

	-- Grants ---------------------------------------------------------------------------------------
	local grantSection = Widgets.section(scroll, "Grant progression", 4, `Role limits: {limits.MaxRebirths or 0} ascensions, {limits.MaxLevels or 0} levels, {limits.MaxSkillPoints or 0} skill points per action.`)
	local function grantRow(order: number, label: string, action: string, key: string, placeholder: string)
		local row = Widgets.row(grantSection, order, 34)
		Widgets.rowLabel(row, label, 140, 1)
		local box = Widgets.textbox({ Placeholder = placeholder, Size = UDim2.fromOffset(100, 32), LayoutOrder = 2, MaxLength = 8, Parent = row })
		local button = Widgets.button({
			Text = "Grant",
			Variant = "adminPrimary",
			Size = UDim2.fromOffset(100, 32),
			LayoutOrder = 3,
			OnClick = function()
				local t = target()
				local n = wholeNumber(box, if key == "Amount" then nil else 1, 1)
				if t ~= nil and n then
					ctx.Net.run(action, { Target = t, [key] = n }, { Label = label })
				end
			end,
			Parent = row,
		})
		Widgets.gate(button, canGrant, "progression.grant")
	end
	grantRow(1, "🔷 Ascensions", "progression.grantRebirth", "Count", "1")
	grantRow(2, "📈 Levels", "progression.grantLevels", "Count", "1")
	grantRow(3, "🌳 Skill points", "progression.grantSkillPoints", "Amount", "amount")
	Widgets.dim({ Text = "Granting an ascension resets that player's current run exactly like a normal ascension.", TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = grantSection })

	-- Reset ------------------------------------------------------------------------------------------
	local resetSection = Widgets.section(scroll, "Reset progress", 5, "Destructive. The server issues a single-use confirmation; EVERYTHING also requires typing the player's name.")
	local scopeChips = Widgets.chips({ Parent = resetSection, Options = RESET_SCOPES, Value = "upgrades", Order = 1, Height = 28 })
	local resetButton = Widgets.button({
		Text = "⚠ Reset selected progress",
		Variant = "adminDanger",
		Size = UDim2.fromOffset(230, 34),
		LayoutOrder = 2,
		OnClick = function()
			local t = target()
			if t == nil then
				return
			end
			local scope = scopeChips.Get()
			local requireText = nil
			if scope == "all" then
				local label = ctx.Target.Label or ""
				local name = string.match(label, "@([%w_]+)") or (string.gsub(label, "^%s*(.-)%s*$", "%1"))
				if name == "" then
					name = tostring(t)
				end
				requireText = name
			end
			ctx.Net.run("progression.reset", { Target = t, Scope = scope }, { Label = "Reset progress", RequireText = requireText })
		end,
		Parent = resetSection,
	})
	Widgets.gate(resetButton, canReset, "progression.reset")

	-- Load current values ------------------------------------------------------------------------------
	local function load()
		local t = ctx.Target.Query
		if t == nil or not ctx.has("players.inspect") then
			return
		end
		local response = ctx.Net.request("players.inspect", { Target = t })
		if ctx.Target.Query ~= t then
			return
		end
		if not response.ok or type(response.data) ~= "table" then
			summary.Text = response.err or "Could not load."
			summary.TextColor3 = P.Warning
			return
		end
		local data = response.data
		for id, box in pairs(levelBoxes) do
			box.Text = tostring((data.Upgrades or {})[id] or 0)
		end
		local ranks = 0
		for _, rank in pairs(data.Skills or {}) do
			ranks += rank
		end
		summary.Text = `Level {data.Level} · {data.SkillPoints or 0} skill points · {ranks} skill ranks · {data.Rebirths or 0} ascensions`
		summary.TextColor3 = P.TextDim
	end
	loadButton.Activated:Connect(function()
		if not loadButton:GetAttribute("Disabled") then
			load()
		end
	end)

	local version = 0
	ctx.TargetChanged:Connect(function()
		version += 1
		local mine = version
		if container.Visible and type(ctx.Target.Query) == "number" then
			task.delay(0.4, function()
				if mine == version then
					load()
				end
			end)
		end
	end)

	local tab = {}
	function tab.OnShow()
		if type(ctx.Target.Query) == "number" then
			load()
		end
	end
	return tab
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Server</string>
              <string name="Source"><![CDATA[--[[
	Server tab (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/Tabs/Server
	Depends on: AdminUI/Widgets, ReplicatedStorage/Shared/Format, ReplicatedStorage/Shared/Config/GameConfig
	Server actions: server.announce, server.eventStart, server.eventStop, server.stats, dashboard

	Announcements are filtered by Roblox text filtering on the server.
	"Server-wide" reaches only this server. "Game-wide" uses MessagingService
	and is only offered when the role has server.announce.global and the game
	owner enabled cross-server announcements.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfig"))

local Widgets = require(script.Parent.Parent.Widgets)

local UI = Widgets.UI
local P = Widgets.P
local F = Widgets.Theme.Fonts

local EVENTS = GameConfig.Events

return function(ctx, container: Frame)
	local scroll = Widgets.scroll(container)
	local globalAllowed = ctx.has("server.announce.global") and ctx.Hello.CrossServer == true

	-- Announcements ------------------------------------------------------------------------------
	local announceSection = Widgets.section(scroll, "Announcement", 1, "Shown to players as a banner. Text is filtered by Roblox before it is displayed.")
	local message = Widgets.textbox({
		Placeholder = "Message (max 200 characters)",
		Size = UDim2.new(1, 0, 0, 34),
		LayoutOrder = 1,
		MaxLength = 200,
		Parent = announceSection,
	})
	local counter = Widgets.dim({ Text = "0 / 200", TextSize = 12, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 14), TextXAlignment = Enum.TextXAlignment.Right, Parent = announceSection })
	message:GetPropertyChangedSignal("Text"):Connect(function()
		counter.Text = `{#message.Text} / 200`
	end)

	local scopeOptions = { { Id = "server", Text = "📣 Server-wide (this server only)" } }
	if globalAllowed then
		table.insert(scopeOptions, { Id = "global", Text = "🌐 Game-wide (all servers)", Color = P.Accent2 })
	end
	local scope = Widgets.chips({ Parent = announceSection, Options = scopeOptions, Value = "server", Order = 3, Height = 30 })
	if not globalAllowed then
		Widgets.dim({
			Text = if ctx.has("server.announce.global")
				then "Game-wide announcements are disabled in AdminConfig.CrossServerAnnouncements."
				else "Game-wide announcements need the server.announce.global permission (Owner by default).",
			TextSize = 12,
			TextWrapped = true,
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 4,
			Parent = announceSection,
		})
	end
	local send = Widgets.button({
		Text = "📣 Send announcement",
		Variant = "adminPrimary",
		Size = UDim2.fromOffset(200, 34),
		LayoutOrder = 5,
		OnClick = function()
			local text = string.gsub(message.Text, "^%s*(.-)%s*$", "%1")
			if text == "" then
				ctx.toast("Write a message first.", "error")
				return
			end
			local chosen = scope.Get()
			if chosen == "global" then
				local ok = UI.confirm({
					Title = "Send to every server?",
					Message = "This game-wide announcement will appear in all running servers of the game.",
					ConfirmText = "Send game-wide",
					Palette = P,
				})
				if not ok then
					return
				end
			end
			local response = ctx.Net.run("server.announce", { Message = text, Scope = chosen }, { Label = "Announcement" })
			if response.ok then
				message.Text = ""
			end
		end,
		Parent = announceSection,
	})
	Widgets.gate(send, ctx.has("server.announce"), "server.announce")

	-- Events ---------------------------------------------------------------------------------------
	local eventsSection = Widgets.section(scroll, "Boost events (this server)", 2, `Duration in seconds ({EVENTS.MinDuration}–{EVENTS.MaxDuration}).`)
	local canEvents = ctx.has("server.events")
	local active: { [string]: any } = {}
	local statusLabels: { [string]: TextLabel } = {}

	for index, id in ipairs(EVENTS.Order) do
		local def = EVENTS.Definitions[id]
		local row = UI.new("Frame", {
			Name = id,
			Size = UDim2.new(1, 0, 0, 56),
			BackgroundColor3 = P.Background,
			LayoutOrder = index,
			Corner = 10,
			Stroke = { Color = def.Color, Transparency = 0.6 },
			Parent = eventsSection,
		})
		Widgets.label({ Text = def.Icon, TextSize = 24, Size = UDim2.fromOffset(44, 56), TextXAlignment = Enum.TextXAlignment.Center, Parent = row })
		Widgets.label({ Text = def.Name, Font = F.Bold, TextColor3 = def.Color, Size = UDim2.new(1, -420, 0, 20), Position = UDim2.fromOffset(46, 8), Parent = row })
		Widgets.dim({ Text = def.Description, TextSize = 12, Size = UDim2.new(1, -420, 0, 16), Position = UDim2.fromOffset(46, 30), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
		statusLabels[id] = Widgets.dim({
			Text = "Inactive",
			TextSize = 12,
			Size = UDim2.fromOffset(110, 56),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -296, 0, 0),
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		})
		local duration = Widgets.textbox({
			Text = tostring(def.DefaultDuration),
			Size = UDim2.fromOffset(80, 30),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -204, 0.5, 0),
			MaxLength = 6,
			Parent = row,
		})
		local start = Widgets.button({
			Text = "Start",
			Variant = "adminPrimary",
			Size = UDim2.fromOffset(90, 30),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -108, 0.5, 0),
			OnClick = function()
				local seconds = tonumber(duration.Text)
				if not seconds then
					ctx.toast("Duration must be a number of seconds.", "error")
					return
				end
				ctx.Net.run("server.eventStart", { Event = id, Duration = math.floor(seconds) }, { Label = def.Name })
				ctx.refreshEvents()
			end,
			Parent = row,
		})
		local stop = Widgets.button({
			Text = "Stop",
			Variant = "adminSecondary",
			Size = UDim2.fromOffset(90, 30),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			OnClick = function()
				ctx.Net.run("server.eventStop", { Event = id }, { Label = def.Name })
				ctx.refreshEvents()
			end,
			Parent = row,
		})
		Widgets.gate(start, canEvents, "server.events")
		Widgets.gate(stop, canEvents, "server.events")
	end

	local function renderEvents()
		local now = workspace:GetServerTimeNow()
		for id, label in pairs(statusLabels) do
			local info = active[id]
			if info and info.EndsAt > now then
				label.Text = "● " .. Format.clock(info.EndsAt - now) .. " left"
				label.TextColor3 = P.Accent
			else
				label.Text = "Inactive"
				label.TextColor3 = P.TextDim
			end
		end
	end

	function ctx.refreshEvents()
		local response = ctx.Net.request("dashboard")
		if response.ok and type(response.data) == "table" then
			active = response.data.Events or {}
			renderEvents()
		end
	end

	-- Server stats -------------------------------------------------------------------------------------
	local statsSection = Widgets.section(scroll, "Server statistics", 3)
	local statsText = Widgets.dim({ Text = "Press refresh to load.", TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = statsSection })
	local refreshStats = Widgets.button({
		Text = "↻ Refresh statistics",
		Size = UDim2.fromOffset(180, 30),
		LayoutOrder = 2,
		OnClick = function()
			local response = ctx.Net.request("server.stats")
			if not response.ok or type(response.data) ~= "table" then
				statsText.Text = response.err or "Could not load statistics."
				statsText.TextColor3 = P.Danger
				return
			end
			local d = response.data
			local data = d.Data or {}
			statsText.TextColor3 = P.TextDim
			statsText.Text = table.concat({
				response.message or "",
				`Players: {#(d.Players or {})} / {d.MaxPlayers}   ·   Presses: {Format.commas(d.ServerPresses)} ({d.ServerCPS}/s)`,
				`Memory: {math.floor(d.MemoryMb or 0)} MB   ·   Physics: {math.floor(d.PhysicsFps or 0)} FPS   ·   Heartbeat: {string.format("%.1f", d.HeartbeatMs or 0)} ms`,
				`Data: {data.Mode} · {data.Saves or 0} saves · {data.SaveFailures or 0} failed saves · {data.LoadFailures or 0} failed loads`,
				`Server: {Widgets.shortId(d.JobId)} · place version {d.PlaceVersion}`,
			}, "\n")
		end,
		Parent = statsSection,
	})
	Widgets.gate(refreshStats, ctx.has("server.stats"), "server.stats")

	local tab = { AutoRefresh = 5 }
	function tab.Refresh()
		ctx.refreshEvents()
	end
	function tab.Tick()
		renderEvents()
	end
	function tab.OnShow()
		ctx.refreshEvents()
	end
	return tab
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[--[[
	Settings tab (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/Tabs/Settings
	Depends on: AdminUI/Widgets, ReplicatedStorage/Shared/Format
	Server actions: none (uses the "hello" response received at startup)

	Shows the staff member's role, rank, permissions and limits, plus local
	panel preferences. Preferences live in memory for this session only.
	Roles and permissions are configured on the server in
	ServerScriptService/Admin/AdminConfig and can never be changed from here.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Format"))

local Widgets = require(script.Parent.Parent.Widgets)

local UI = Widgets.UI
local P = Widgets.P
local F = Widgets.Theme.Fonts

local LIMIT_LABELS = {
	{ "MaxCurrency", "Currency per action" },
	{ "MaxItems", "Items per action" },
	{ "MaxChests", "Crates per action" },
	{ "MaxRebirths", "Ascensions per action" },
	{ "MaxLevels", "Levels per action" },
	{ "MaxSkillPoints", "Skill points per action" },
}

return function(ctx, container: Frame)
	local scroll = Widgets.scroll(container)
	local hello = ctx.Hello
	local roleColor = if typeof(hello.RoleColor) == "Color3" then hello.RoleColor else P.Accent

	local roleSection = Widgets.section(scroll, "Your role", 1)
	Widgets.label({
		Text = `{hello.Role} · rank {hello.Rank}`,
		Font = F.Heading,
		TextSize = 22,
		TextColor3 = roleColor,
		Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = 1,
		Parent = roleSection,
	})
	Widgets.dim({
		Text = "Punitive actions (kick, freeze, removals, resets) cannot target staff of equal or higher rank.",
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = roleSection,
	})

	local permSection = Widgets.section(scroll, "Permissions", 2)
	local permFrame = UI.frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = permSection })
	local permLayout = UI.list(permFrame, { Dir = "X", Pad = 6 })
	permLayout.Wraps = true
	local permissions = table.clone(hello.Permissions or {})
	table.sort(permissions)
	for index, permission in ipairs(permissions) do
		Widgets.tag(permFrame, if permission == "*" then "* (all permissions)" else permission, P.Accent, index)
	end

	local limitSection = Widgets.section(scroll, "Limits", 3, "Enforced by the server for every request, including commands.")
	local limits = hello.Limits or {}
	for index, def in ipairs(LIMIT_LABELS) do
		local row = UI.frame({ Size = UDim2.new(1, 0, 0, 18), LayoutOrder = index, Parent = limitSection })
		Widgets.dim({ Text = def[2], Size = UDim2.new(0.5, 0, 1, 0), Parent = row })
		Widgets.label({ Text = Format.short(limits[def[1]] or 0), Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.fromScale(0.5, 0), Parent = row })
	end

	local serverSection = Widgets.section(scroll, "Session", 4)
	Widgets.dim({
		Text = table.concat({
			`Panel key: {hello.PanelKey or "F2"}  ·  chat: /admin <command>  ·  gamepad: select the 🛡️ Admin button, B closes`,
			`Server: {Widgets.shortId(hello.JobId)}{if hello.IsStudio then "  ·  Roblox Studio test session" else ""}`,
			`Game-wide announcements: {if hello.CrossServer then "enabled in AdminConfig" else "disabled"}`,
			`Commands available to you: {#(hello.Commands or {})}`,
		}, "\n"),
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = serverSection,
	})

	local prefSection = Widgets.section(scroll, "Panel preferences", 5, "Stored for this session only.")
	local function prefRow(order: number, label: string, key: string)
		local row = Widgets.row(prefSection, order, 30)
		Widgets.label({ Text = label, Size = UDim2.new(1, -70, 0, 30), LayoutOrder = 1, Parent = row })
		UI.toggle({
			Value = ctx.Prefs[key],
			LayoutOrder = 2,
			OnChange = function(value)
				ctx.Prefs[key] = value
				ctx.PrefsChanged:Fire(key)
			end,
			Parent = row,
		})
	end
	prefRow(1, "Toast sounds", "ToastSounds")
	prefRow(2, "Compact layout (icon-only sidebar, denser rows)", "Compact")
	prefRow(3, "Auto-refresh dashboard, players and events", "AutoRefresh")

	local noteSection = Widgets.section(scroll, "Where roles come from", 6)
	Widgets.dim({
		Text = "Staff roles are assigned on the server in ServerScriptService/Admin/AdminConfig using Roblox UserIds. "
			.. "This panel only shows what the server allows; every request is re-checked server-side, so hiding or "
			.. "changing anything here cannot grant extra access. Ask the game owner to change your role.",
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = noteSection,
	})

	return {}
end
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">TargetPicker</string>
            <string name="Source"><![CDATA[--[[
	TargetPicker (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/TargetPicker
	Depends on: AdminUI/Widgets

	"Target" row used by the Economy, Items and Progression tabs. Every picker
	shares ctx.Target, so selecting a player once (here or in the Players tab)
	selects them everywhere.

	Accepted input (resolved on the SERVER, which rejects ambiguous names):
	  name or display-name prefix, @username, #UserId (also works for offline
	  tools when the role allows it), or "me".
]]

local Widgets = require(script.Parent.Widgets)

local P = Widgets.P

local TargetPicker = {}

-- Converts typed text into the value sent to the server.
function TargetPicker.queryFromText(text: string): any
	local trimmed = string.gsub(text, "^%s*(.-)%s*$", "%1")
	if trimmed == "" then
		return nil
	end
	if string.match(trimmed, "^%d+$") then
		return "#" .. trimmed
	end
	return trimmed
end

function TargetPicker.new(ctx, parent: Instance, order: number?)
	local row = Widgets.row(parent, order, 34)
	Widgets.rowLabel(row, "Target", 70, 1)
	local syncing = false
	local box = Widgets.textbox({
		Placeholder = "name, @username, #UserId or me",
		Size = UDim2.fromOffset(250, 32),
		LayoutOrder = 2,
		MaxLength = 50,
		Text = ctx.Target.Label or "",
		Parent = row,
	})
	local status = Widgets.dim({
		Text = "",
		Size = UDim2.new(1, -470, 0, 32),
		LayoutOrder = 4,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	local online = Widgets.button({
		Text = "Online ▾",
		Size = UDim2.fromOffset(110, 32),
		LayoutOrder = 3,
		Variant = "adminSecondary",
		Parent = row,
	})

	local function describe()
		local target = ctx.Target
		if target.Query == nil then
			status.Text = "No player selected."
			status.TextColor3 = P.TextDim
		elseif type(target.Query) == "number" then
			status.Text = "✔ " .. (target.Label or "") .. "  #" .. tostring(target.Query)
			status.TextColor3 = P.Accent
		else
			status.Text = "Resolved by the server when you run an action."
			status.TextColor3 = P.TextDim
		end
	end

	online.Activated:Connect(function()
		local players = ctx.refreshPlayers()
		local options = {}
		for _, p in ipairs(players) do
			local label = if p.DisplayName ~= p.Name then `{p.DisplayName} (@{p.Name})` else "@" .. p.Name
			if p.StaffRole then
				label ..= "  [" .. p.StaffRole .. "]"
			end
			table.insert(options, { Text = label, Value = p.UserId, Color = if p.StaffRole then P.Accent2 else nil })
		end
		Widgets.popupList(online, options, function(userId)
			for _, p in ipairs(players) do
				if p.UserId == userId then
					local label = if p.DisplayName ~= p.Name then `{p.DisplayName} (@{p.Name})` else "@" .. p.Name
					ctx.setTarget(userId, label)
				end
			end
		end, 280)
	end)

	box:GetPropertyChangedSignal("Text"):Connect(function()
		if syncing then
			return
		end
		ctx.setTarget(TargetPicker.queryFromText(box.Text), box.Text, box)
	end)

	ctx.TargetChanged:Connect(function(source)
		if source ~= box then
			syncing = true
			box.Text = ctx.Target.Label or ""
			syncing = false
		end
		describe()
	end)
	describe()

	return {
		Frame = row,
		Box = box,
		Get = function()
			return ctx.Target.Query
		end,
	}
end

return TargetPicker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">Widgets</string>
            <string name="Source"><![CDATA[--[[
	Widgets (ModuleScript)
	Location: ServerStorage/AdminClient/AdminUI/Widgets
	Depends on: ReplicatedStorage/UI/UIKit, ReplicatedStorage/UI/Theme, ReplicatedStorage/Shared/Config/Rarities

	Admin-styled building blocks on top of UIKit: the same components and
	motion as the player UI, re-skinned with Theme.Admin (near-black teal,
	neon green, magenta) so staff tools are unmistakable.

	Registers extra UIKit button variants at load:
	  adminPrimary, adminSecondary, adminGhost, adminDanger, adminMagenta, adminWarn
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder:WaitForChild("UIKit"))
local Theme = require(UIFolder:WaitForChild("Theme"))
local Rarities = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Rarities"))

local P = Theme.Admin
local F = Theme.Fonts

local W = {}
W.P = P
W.UI = UI
W.Theme = Theme

UI.Variants.adminPrimary = { Bg = P.Accent, Text = Color3.fromRGB(3, 26, 19), Stroke = Theme.lighten(P.Accent, 0.35) }
UI.Variants.adminSecondary = { Bg = P.PanelLighter, Text = P.Text, Stroke = P.Stroke }
UI.Variants.adminGhost = { Bg = P.PanelLight, Text = P.TextDim, Stroke = P.Stroke }
UI.Variants.adminDanger = { Bg = Color3.fromRGB(176, 28, 52), Text = Color3.new(1, 1, 1), Stroke = P.Danger }
UI.Variants.adminMagenta = { Bg = Color3.fromRGB(170, 26, 136), Text = Color3.new(1, 1, 1), Stroke = P.Accent2 }
UI.Variants.adminWarn = { Bg = Color3.fromRGB(196, 136, 26), Text = Color3.fromRGB(30, 18, 0), Stroke = P.Warning }

W.Result = {
	success = P.Accent,
	denied = P.Danger,
	invalid = P.Warning,
	error = P.Danger,
	rate_limited = P.Warning,
	confirm_required = P.Accent2,
	duplicate = P.TextDim,
}

-- Text ---------------------------------------------------------------------------------

function W.label(props: { [string]: any }?): TextLabel
	return UI.label(UI.merge({ TextColor3 = P.Text, TextSize = 14 }, props))
end

function W.dim(props: { [string]: any }?): TextLabel
	return UI.label(UI.merge({ TextColor3 = P.TextDim, TextSize = 13, Font = F.Body }, props))
end

function W.heading(props: { [string]: any }?): TextLabel
	return UI.label(UI.merge({ TextColor3 = P.Text, TextSize = 16, Font = F.Heading, Size = UDim2.new(1, 0, 0, 22) }, props))
end

-- Buttons ---------------------------------------------------------------------------------

function W.button(props: { [string]: any }): TextButton
	local p = table.clone(props)
	p.Variant = p.Variant or "adminSecondary"
	p.TextSize = p.TextSize or 14
	p.Size = p.Size or UDim2.fromOffset(120, 32)
	return UI.button(p)
end

-- Disables a control the role lacks permission for (the server enforces this anyway).
function W.gate(button: TextButton, allowed: boolean, permission: string)
	if not allowed then
		UI.setEnabled(button, false)
		UI.attachTooltip(button, "Your role lacks the permission <b>" .. permission .. "</b>.")
	end
end

-- Inputs ----------------------------------------------------------------------------------

--[[ props: Placeholder, Text, OnSubmit(text), OnChanged(text), MaxLength + TextBox props ]]
function W.textbox(props: { [string]: any }): TextBox
	local onSubmit, onChanged, maxLength = props.OnSubmit, props.OnChanged, props.MaxLength
	local clean = {}
	for k, v in pairs(props) do
		if k ~= "OnSubmit" and k ~= "OnChanged" and k ~= "MaxLength" and k ~= "Placeholder" then
			clean[k] = v
		end
	end
	local box: TextBox = UI.new(
		"TextBox",
		UI.merge({
			BackgroundColor3 = P.Background,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = F.Medium,
			TextSize = 14,
			TextColor3 = P.Text,
			PlaceholderColor3 = Theme.darken(P.TextDim, 0.25),
			PlaceholderText = props.Placeholder or "",
			Text = "",
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(1, 0, 0, 32),
			Corner = 8,
			Padding = { X = 10 },
		}, clean)
	)
	local stroke = UI.stroke(box, { Color = P.Stroke })
	box.Focused:Connect(function()
		UI.tween(stroke, { Color = P.Accent }, Theme.Motion.Fast)
	end)
	box.FocusLost:Connect(function(enterPressed)
		UI.tween(stroke, { Color = P.Stroke }, Theme.Motion.Fast)
		if enterPressed and onSubmit then
			onSubmit(box.Text)
		end
	end)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if maxLength and #box.Text > maxLength then
			box.Text = string.sub(box.Text, 1, maxLength)
			return
		end
		if onChanged then
			onChanged(box.Text)
		end
	end)
	return box
end

local SUFFIX = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18 }

-- Parses 1500, 1,500, 2.5k, 3m, 1b, 4t, 1e6. Returns nil when not a number.
function W.parseNumber(text: string?): number?
	if type(text) ~= "string" then
		return nil
	end
	local s = string.lower((string.gsub(text, "[,%s]", "")))
	if s == "" then
		return nil
	end
	local direct = tonumber(s)
	if direct then
		return if direct == direct and direct ~= math.huge and direct ~= -math.huge then direct else nil
	end
	local num, suffix = string.match(s, "^(%-?[%d%.]+)(%a+)$")
	if num and SUFFIX[suffix] then
		local n = tonumber(num)
		if n then
			return n * SUFFIX[suffix]
		end
	end
	return nil
end

-- Layout ----------------------------------------------------------------------------------

function W.scroll(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local scroll = UI.scroll(UI.merge({
		ScrollBarImageColor3 = P.Stroke,
		Parent = parent,
	}, props))
	UI.list(scroll, { Pad = 10 })
	UI.padding(scroll, { 2, 10, 2, 12 })
	return scroll
end

-- A titled card that grows with its content. Returns the section frame;
-- add children with increasing LayoutOrder (the title uses 0).
function W.section(parent: Instance, title: string, order: number?, subtitle: string?): Frame
	local section = UI.new("Frame", {
		Name = "Section",
		BackgroundColor3 = P.PanelLight,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order or 0,
		Corner = 12,
		Stroke = { Color = P.Stroke, Transparency = 0.35 },
		Padding = 12,
		List = { Pad = 8 },
		Parent = parent,
	})
	local header = UI.frame({ Name = "Title", Size = UDim2.new(1, 0, 0, if subtitle then 38 else 22), LayoutOrder = 0, Parent = section })
	W.heading({ Text = title, Parent = header })
	if subtitle then
		W.dim({ Text = subtitle, Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 18), TextWrapped = true, Parent = header })
	end
	return section
end

-- Horizontal row of controls.
function W.row(parent: Instance, order: number?, height: number?, pad: number?): Frame
	return UI.frame({
		Name = "Row",
		Size = UDim2.new(1, 0, 0, height or 32),
		LayoutOrder = order or 0,
		List = { Dir = "X", Pad = pad or 8, VA = "Center" },
		Parent = parent,
	})
end

-- Small label for a row, fixed width.
function W.rowLabel(parent: Instance, text: string, width: number?, order: number?): TextLabel
	return W.dim({ Text = text, Size = UDim2.fromOffset(width or 90, 32), LayoutOrder = order or 0, Parent = parent })
end

-- Removes every GuiObject child (keeps layouts, padding, corners, strokes).
function W.clear(frame: Instance)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Metric card: title, big value, small subtitle.
function W.card(parent: Instance, title: string, order: number?)
	local frame = UI.new("Frame", {
		Name = "Card",
		BackgroundColor3 = P.PanelLight,
		BorderSizePixel = 0,
		LayoutOrder = order or 0,
		Corner = 12,
		Stroke = { Color = P.Stroke, Transparency = 0.35 },
		Padding = { 12, 12, 10, 10 },
		Parent = parent,
	})
	UI.gradient(frame, {
		Color = ColorSequence.new(Theme.lighten(P.PanelLight, 0.05), P.PanelLight),
		Rotation = 90,
	})
	W.dim({ Text = string.upper(title), TextSize = 11, Font = F.Bold, Size = UDim2.new(1, 0, 0, 14), Parent = frame })
	local value = W.label({
		Name = "Value",
		Text = "—",
		Font = F.Heading,
		TextSize = 22,
		Size = UDim2.new(1, 0, 0, 28),
		Position = UDim2.fromOffset(0, 16),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	local sub = W.dim({
		Name = "Sub",
		Text = "",
		TextSize = 12,
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 44),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	return { Frame = frame, Value = value, Sub = sub }
end

-- Coloured pill tag.
function W.tag(parent: Instance, text: string, color: Color3, order: number?): TextLabel
	local tag = UI.label({
		Text = text,
		Font = F.Bold,
		TextSize = 11,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 18),
		BackgroundColor3 = Theme.darken(color, 0.75),
		BackgroundTransparency = 0,
		LayoutOrder = order or 0,
		Corner = Theme.Radius.Pill,
		Padding = { X = 8 },
		Parent = parent,
	})
	UI.stroke(tag, { Color = color, Transparency = 0.4 })
	return tag
end

--[[
	Chip row (single choice).
	props: Parent, Options = { { Id, Text, Color? } }, Value, OnChange(id), Order, Height, Width
	Returns { Frame, Set(id), Get(), Buttons }
]]
function W.chips(props: { [string]: any })
	local frame = UI.frame({
		Name = "Chips",
		Size = UDim2.new(1, 0, 0, props.Height or 28),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = props.Order or 0,
		Parent = props.Parent,
	})
	local layout = UI.list(frame, { Dir = "X", Pad = 6, VA = "Center" })
	layout.Wraps = true
	local control = { Frame = frame, Buttons = {} }
	local current = props.Value
	local function render()
		for id, button in pairs(control.Buttons) do
			UI.setVariant(button, if id == current then "adminPrimary" else "adminGhost")
		end
	end
	for index, option in ipairs(props.Options) do
		local button = W.button({
			Text = option.Text,
			Size = UDim2.fromOffset(props.Width or 0, props.Height or 28),
			AutomaticSize = if props.Width then Enum.AutomaticSize.None else Enum.AutomaticSize.X,
			Padding = { X = 10 },
			TextSize = 13,
			LayoutOrder = index,
			Variant = "adminGhost",
			OnClick = function()
				current = option.Id
				render()
				if props.OnChange then
					props.OnChange(option.Id)
				end
			end,
			Parent = frame,
		})
		if option.Color then
			button.TextColor3 = option.Color
		end
		control.Buttons[option.Id] = button
	end
	function control.Set(id)
		current = id
		render()
	end
	function control.Get()
		return current
	end
	render()
	return control
end

-- Popups -------------------------------------------------------------------------------------

local openPopup: Frame? = nil

function W.closePopup()
	if openPopup then
		openPopup:Destroy()
		openPopup = nil
	end
end

--[[
	Floating list under an anchor (rendered in the UIKit overlay so scrolling
	containers never clip it). options: { { Text, Value, Color? } }
]]
function W.popupList(anchor: GuiObject, options: { any }, onPick: (any) -> (), width: number?)
	W.closePopup()
	local overlay = UI.overlay()
	local root = UI.frame({ Name = "AdminPopup", ZIndex = 120, Parent = overlay })
	openPopup = root
	UI.new("TextButton", {
		Name = "Catcher",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		ZIndex = 120,
		Activated = function()
			W.closePopup()
		end,
		Parent = root,
	})
	local absPos = anchor.AbsolutePosition
	local absSize = anchor.AbsoluteSize
	local viewport = UI.viewport()
	local rowHeight = 30
	local height = math.min(#options * (rowHeight + 2) + 10, 260)
	local w = math.max(width or absSize.X, 160)
	local y = absPos.Y + absSize.Y + 4
	if y + height > viewport.Y - 8 then
		y = math.max(8, absPos.Y - height - 4)
	end
	local x = math.clamp(absPos.X, 8, math.max(8, viewport.X - w - 8))
	local list = UI.scroll({
		Name = "List",
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, height),
		BackgroundColor3 = P.Panel,
		BackgroundTransparency = 0,
		ScrollBarImageColor3 = P.Stroke,
		ZIndex = 121,
		Corner = 10,
		Stroke = { Color = P.Accent, Transparency = 0.4 },
		Padding = 5,
		List = { Pad = 2 },
		Parent = root,
	})
	if #options == 0 then
		W.dim({ Text = "Nothing to show.", Size = UDim2.new(1, 0, 0, rowHeight), ZIndex = 122, Parent = list })
	end
	local first: GuiObject? = nil
	for index, option in ipairs(options) do
		local row = UI.new("TextButton", {
			Name = "Option",
			Size = UDim2.new(1, 0, 0, rowHeight),
			BackgroundColor3 = P.PanelLight,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = option.Text,
			TextColor3 = option.Color or P.Text,
			Font = F.Medium,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = index,
			ZIndex = 122,
			Corner = 6,
			Padding = { X = 8 },
			Parent = list,
		})
		row.MouseEnter:Connect(function()
			row.BackgroundTransparency = 0
		end)
		row.MouseLeave:Connect(function()
			row.BackgroundTransparency = 1
		end)
		row.SelectionGained:Connect(function()
			row.BackgroundTransparency = 0
		end)
		row.SelectionLost:Connect(function()
			row.BackgroundTransparency = 1
		end)
		row.Activated:Connect(function()
			W.closePopup()
			onPick(option.Value)
		end)
		first = first or row
	end
	if UserInputService.GamepadEnabled and first then
		game:GetService("GuiService").SelectedObject = first
	end
end

--[[
	Dropdown button.
	props: Parent, Order, Width, Placeholder, Options (list or function -> list of { Text, Value, Color? }),
	       Value, Text, OnChange(value)
	Returns { Button, Set(value, text), Get() }
]]
function W.dropdown(props: { [string]: any })
	local current = props.Value
	local dropdown = {}
	local button = W.button({
		Text = (props.Text or props.Placeholder or "Select…") .. "  ▾",
		Size = UDim2.fromOffset(props.Width or 200, props.Height or 32),
		LayoutOrder = props.Order,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Padding = { X = 10 },
		Variant = "adminSecondary",
		Parent = props.Parent,
	})
	dropdown.Button = button
	local function options()
		local list = props.Options
		if type(list) == "function" then
			return list()
		end
		return list
	end
	function dropdown.Set(value, text: string?)
		current = value
		if text then
			button.Text = text .. "  ▾"
		end
	end
	function dropdown.Get()
		return current
	end
	button.Activated:Connect(function()
		W.popupList(button, options(), function(value)
			local label = nil
			for _, option in ipairs(options()) do
				if option.Value == value then
					label = option.Text
				end
			end
			dropdown.Set(value, label)
			if props.OnChange then
				props.OnChange(value)
			end
		end, props.PopupWidth)
	end)
	return dropdown
end

-- Misc ------------------------------------------------------------------------------------------

function W.rarityColor(rarityId: string?): Color3
	local r = rarityId and Rarities.ById[rarityId]
	return if r then r.Color else P.TextDim
end

function W.clock(unix: number?): string
	if type(unix) ~= "number" then
		return "--:--:--"
	end
	local t = os.date("!*t", math.floor(unix))
	return string.format("%02d:%02d:%02d", t.hour, t.min, t.sec)
end

-- Today's UTC date as YYYY-MM-DD (based on the synced server clock).
function W.today(): string
	local t = os.date("!*t", math.floor(workspace:GetServerTimeNow()))
	return string.format("%04d-%02d-%02d", t.year, t.month, t.day)
end

function W.shortId(id: string?): string
	if type(id) ~= "string" or id == "" then
		return "(Studio)"
	end
	return string.sub(id, 1, 8) .. "…"
end

return W
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="91">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="92">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="93">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="94">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="95">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">BigButton</string>
            <string name="Source"><![CDATA[--[[
	BigButton (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/BigButton
	Depends on: ReplicatedStorage/UI/{UIKit,Theme,Effects,SoundPlayer},
	            ReplicatedStorage/Shared/{Format, Config/GameConfig}, Client/ClientNet

	The PRESS button (bottom right of the HUD). Pressing it gives instant local feedback
	(squash, shockwave, sparks, sound) and fires the Click remote; the
	floating reward number appears when the server's ClickResult arrives, so
	what the player sees is always what the server actually awarded.

	Input: mouse and touch press on InputBegan (instant), gamepad via the
	selected button's Activated event or InputController (R2/L2).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Effects = require(UIFolder.Effects)
local SoundPlayer = require(UIFolder.SoundPlayer)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local GameConfig = require(Shared.Config.GameConfig)

local ClientNet = require(script.Parent.ClientNet)

local C = Theme.Colors
local BigButton = {}
BigButton.__index = BigButton

local DEFAULT_SIZE = 300
local MAX_LOCAL_CPS = 25
local rng = Random.new()

-- size: diameter in pixels before HUD scaling (default 300).
function BigButton.new(parent: GuiObject, fxLayer: GuiObject, size: number?)
	local self = setmetatable({}, BigButton)
	local SIZE = size or DEFAULT_SIZE
	local k = SIZE / DEFAULT_SIZE
	self.Size = SIZE
	self.FxLayer = fxLayer
	self.LastPress = 0
	self.Presses = {}
	self.Pressed = Instance.new("BindableEvent")

	local holder = UI.frame({
		Name = "BigButton",
		Size = UDim2.fromOffset(SIZE, SIZE),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Parent = parent,
	})
	self.Instance = holder
	local squash = Instance.new("UIScale")
	squash.Name = "Squash"
	squash.Parent = holder
	self.Squash = squash

	local function circle(name: string, scale: number, color: Color3, z: number, offsetY: number?)
		return UI.new("Frame", {
			Name = name,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, offsetY or 0),
			Size = UDim2.fromScale(scale, scale),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = z,
			Corner = Theme.Radius.Pill,
			Parent = holder,
		})
	end

	-- Soft glow made of stacked translucent strokes.
	self.Glows = {}
	for i, spec in ipairs({ { 1.0, 16, 0.86 }, { 0.95, 10, 0.75 }, { 0.9, 5, 0.6 } }) do
		local ring = circle("Glow" .. i, spec[1], C.Black, 1)
		ring.BackgroundTransparency = 1
		local stroke = UI.stroke(ring, { Color = C.Accent, Thickness = spec[2], Transparency = spec[3] })
		table.insert(self.Glows, { Stroke = stroke, Base = spec[3] })
	end

	local base = circle("Base", 0.86, Color3.fromRGB(24, 18, 36), 2, 6)
	UI.stroke(base, { Color = Color3.fromRGB(60, 40, 80), Thickness = 3 })
	local skirt = circle("Skirt", 0.78, C.AccentSoft, 3, 10)
	self.Skirt = skirt

	local cap = UI.new("TextButton", {
		Name = "Cap",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -4),
		Size = UDim2.fromScale(0.76, 0.76),
		BackgroundColor3 = C.Accent,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 4,
		Selectable = true,
		Corner = Theme.Radius.Pill,
		Parent = holder,
	})
	self.Cap = cap
	self.CapGradient = UI.gradient(cap, {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.45, Color3.fromRGB(235, 235, 235)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 150, 160)),
		}),
		Rotation = 90,
	})
	self.CapStroke = UI.stroke(cap, { Color = Theme.lighten(C.Accent, 0.35), Thickness = 3 })

	UI.new("Frame", {
		Name = "Gloss",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.08),
		Size = UDim2.fromScale(0.66, 0.34),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.55,
		ZIndex = 5,
		Corner = Theme.Radius.Pill,
		Gradient = {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }),
			Rotation = 90,
		},
		Parent = cap,
	})
	local label = UI.label({
		Name = "Label",
		Text = "PRESS",
		Font = Theme.Fonts.Display,
		TextSize = math.max(16, math.floor(34 * k + 0.5)),
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, math.max(20, math.floor(40 * k))),
		Position = UDim2.fromScale(0, 0.38),
		ZIndex = 6,
		Parent = cap,
	})
	UI.stroke(label, { Color = C.Black, Thickness = 2, Transparency = 0.55, Text = true })
	self.ValueLabel = UI.label({
		Name = "Value",
		Text = "+1 ⚡",
		Font = Theme.Fonts.Heading,
		TextSize = math.max(12, math.floor(20 * k + 0.5)),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Color3.fromRGB(255, 240, 210),
		Size = UDim2.new(1, 0, 0, math.max(14, math.floor(24 * k))),
		Position = UDim2.fromScale(0, 0.57),
		ZIndex = 6,
		Parent = cap,
	})
	UI.stroke(self.ValueLabel, { Color = C.Black, Thickness = 1.5, Transparency = 0.5, Text = true })

	cap.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			self:Press()
		end
	end)
	cap.Activated:Connect(function(input)
		if input and string.find(input.UserInputType.Name, "Gamepad") then
			self:Press()
		end
	end)

	local clock = 0
	RunService.RenderStepped:Connect(function(dt)
		if Theme.ReducedMotion then
			return
		end
		clock += dt
		local pulse = math.sin(clock * 2.2) * 0.06
		for i, glow in ipairs(self.Glows) do
			glow.Stroke.Transparency = math.clamp(glow.Base - pulse * (1 + i * 0.3), 0, 1)
		end
	end)

	self:SetStage(1)
	return self
end

function BigButton:SetStage(stageId: number, frenzy: boolean?)
	local stage = GameConfig.Stages[stageId] or GameConfig.Stages[1]
	local accent = if frenzy then C.Gold else stage.Accent
	local dark = if frenzy then Color3.fromRGB(150, 100, 0) else stage.AccentDark
	self.Accent = accent
	UI.tween(self.Cap, { BackgroundColor3 = accent }, Theme.Motion.Slow)
	UI.tween(self.Skirt, { BackgroundColor3 = dark }, Theme.Motion.Slow)
	self.CapStroke.Color = Theme.lighten(accent, 0.35)
	for _, glow in ipairs(self.Glows) do
		glow.Stroke.Color = accent
	end
end

function BigButton:SetValueText(clickValue: number)
	self.ValueLabel.Text = "+" .. Format.short(clickValue, true) .. " ⚡"
end

function BigButton:Center(): Vector2
	local cap = self.Cap
	local layer = self.FxLayer
	return cap.AbsolutePosition + cap.AbsoluteSize / 2 - layer.AbsolutePosition
end

function BigButton:Press()
	local now = os.clock()
	-- Local cap keeps the UI honest; the server enforces the real limit.
	local recent = self.Presses
	while #recent > 0 and now - recent[1] > 1 do
		table.remove(recent, 1)
	end
	if #recent >= MAX_LOCAL_CPS then
		return
	end
	table.insert(recent, now)
	self.LastPress = now

	ClientNet.click()
	self.Pressed:Fire()

	local squash = self.Squash
	if Theme.ReducedMotion then
		squash.Scale = 1
	else
		squash.Scale = 0.93
		UI.tween(squash, { Scale = 1 }, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
		self.Cap.Position = UDim2.new(0.5, 0, 0.5, 4)
		UI.tween(self.Cap, { Position = UDim2.new(0.5, 0, 0.5, -4) }, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
	end
	local center = self:Center()
	Effects.ring(self.FxLayer, center, self.Accent or C.Accent, self.Size * 1.15)
	Effects.burst(self.FxLayer, center, self.Accent or C.Accent, 6, self.Size * 0.57)
	SoundPlayer.play("Click", { Pitch = 0.95 + math.min(#recent, 20) * 0.012 + rng:NextNumber(-0.02, 0.02) })
end

-- Floating number for a server-confirmed press.
function BigButton:ShowResult(result, showNumbers: boolean)
	local center = self:Center()
	local size = self.Size
	-- Numbers float up and to the left, into the open screen above the button.
	local pos = center + Vector2.new(rng:NextNumber(-size * 0.9, size * 0.1), rng:NextNumber(-size * 0.75, -size * 0.45))
	if showNumbers then
		if result.Crit then
			Effects.floatText(self.FxLayer, pos, "CRIT! +" .. Format.short(result.Amount, true), C.Gold, { Size = 34, Rise = 120, Duration = 1.1 })
		else
			Effects.floatText(self.FxLayer, pos, "+" .. Format.short(result.Amount, true), C.Text, { Size = 26 })
		end
	end
	if result.Crit then
		Effects.burst(self.FxLayer, center, C.Gold, 10, size * 0.67)
		SoundPlayer.play("Crit")
	end
	if result.Streak then
		Effects.floatText(self.FxLayer, center + Vector2.new(-size * 0.6, -size * 0.95), `STREAK ×{result.Combo}!  +{Format.short(result.Streak, true)}`, C.Accent2, { Size = 30, Rise = 70, Duration = 1.4 })
		Effects.ring(self.FxLayer, center, C.Accent2, size * 1.8)
		SoundPlayer.play("Streak")
	end
	if result.Golden then
		Effects.burst(self.FxLayer, center, C.Gold, 26, size)
		Effects.ring(self.FxLayer, center, C.Gold, size * 2.2)
		SoundPlayer.play("Golden")
	end
end

-- Aggregated auto-press / passive income for the last second.
function BigButton:ShowIncome(result, showNumbers: boolean)
	if not showNumbers then
		return
	end
	local center = self:Center()
	local size = self.Size
	if result.Auto and result.Auto > 0 then
		Effects.floatText(self.FxLayer, center + Vector2.new(-size * 0.2, -size * 0.7), "🤖 +" .. Format.short(result.Auto, true), C.Accent2, { Size = 18, Rise = 60, Duration = 1.0 })
	end
	if result.Passive and result.Passive > 0 then
		Effects.floatText(self.FxLayer, center + Vector2.new(-size * 0.8, -size * 0.45), "🔋 +" .. Format.short(result.Passive, true), C.Sparks, { Size = 18, Rise = 60, Duration = 1.0 })
	end
end

return BigButton
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">ClientNet</string>
            <string name="Source"><![CDATA[--[[
	ClientNet (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/ClientNet
	Depends on: ReplicatedStorage/Shared/Remotes

	Thin wrapper around the remotes. Actions only send intent (which upgrade,
	which crate, how many); the server computes and validates everything.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local ClientNet = {}

local actionRemote = Remotes.func("Action")
local clickRemote = Remotes.event("Click")
local inFlight: { [string]: boolean } = {}

-- Invokes a server action. Never throws; returns { ok, err?, ... }.
function ClientNet.action(name: string, payload: { [string]: any }?): { [string]: any }
	local ok, result = pcall(function()
		return actionRemote:InvokeServer(name, payload or {})
	end)
	if not ok then
		return { ok = false, err = "Connection problem. Please try again." }
	end
	if type(result) ~= "table" then
		return { ok = false, err = "Unexpected response from the server." }
	end
	return result
end

-- Like action(), but ignores a second call while the first is still running
-- (prevents double purchases from double taps).
function ClientNet.once(key: string, name: string, payload: { [string]: any }?): { [string]: any }?
	if inFlight[key] then
		return nil
	end
	inFlight[key] = true
	local result = ClientNet.action(name, payload)
	inFlight[key] = nil
	return result
end

function ClientNet.click()
	clickRemote:FireServer()
end

function ClientNet.on(eventName: string, handler: (...any) -> ()): RBXScriptConnection
	return Remotes.event(eventName).OnClientEvent:Connect(handler)
end

return ClientNet
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--[[
	Hud (ModuleScript)
	Location: StarterPlayer/StarterPlayerScripts/Client/Hud
	Depends on: ReplicatedStorage/UI/*, ReplicatedStorage/Shared/{Format,Formulas,Util,Config/*},
	            Client/{State,ClientNet,ScreenManager,BigButton}

	Always-visible interface. Everything sits at the BOTTOM of the screen so the
	middle stays free for running around the world and the obby:
	  * Dock (bottom centre), rows from the bottom: navigation (Shop, Crates,
	    Inventory, Skills, Collection, Quests, Ascend, Stats, Store (Robux),
	    Settings, with notification badges); Sparks, Gems, Prisms, level + XP,
	    ascension progress; obby progress with ▶ / 🏠 buttons and live stat
	    chips; active boost timers; the "not saving" warning.
	  * PRESS button with combo meter and income rates (bottom right; on touch
	    screens it sits above Roblox's jump button).
	  * Quest card (right side) — the only element not at the bottom.
	Layout scales with the viewport and the UI Scale setting; small screens
	use a compact layout (icon-only navigation, quest card behind a toggle).
]]

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local UIFolder = ReplicatedStorage:WaitForChild("UI")
local UI = require(UIFolder.UIKit)
local Theme = require(UIFolder.Theme)
local Effects = require(UIFolder.Effects)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Util = require(Shared.Util)
local Config = Shared.Config
local GameConfig = require(Config.GameConfig)
local Upgrades = require(Config.Upgrades)
local Skills = require(Config.Skills)
local Quests = require(Config.Quests)
local Rewards = require(Config.Rewards)
local Items = require(Config.Items)
local Ascension = require(Config.Ascension)
local DevProducts = require(Config.DevProducts)
local ObbyConfig = require(Config.Obby)

local State = require(script.Parent.State)
local ClientNet = require(script.Parent.ClientNet)
local ScreenManager = require(script.Parent.ScreenManager)
local BigButton = require(script.Parent.BigButton)

local C = Theme.Colors
local F = Theme.Fonts

local Hud: { [string]: any } = {}

local NAV = {
	{ Id = "Shop", Icon = "🛒", Text = "Shop" },
	{ Id = "Chests", Icon = "🎁", Text = "Crates" },
	{ Id = "Inventory", Icon = "🎒", Text = "Items" },
	{ Id = "Skills", Icon = "🌳", Text = "Skills" },
	{ Id = "Collection", Icon = "📖", Text = "Book" },
	{ Id = "Quests", Icon = "📜", Text = "Quests" },
	{ Id = "Ascend", Icon = "🔷", Text = "Ascend" },
	{ Id = "Stats", Icon = "🏆", Text = "Stats" },
	{ Id = "Store", Icon = "💰", Text = "Store" },
	{ Id = "Settings", Icon = "⚙️", Text = "Settings" },
}

-- Base sizes (pixels at HUD scale 1).
local DOCK_WIDTH = 770
local DOCK_HEIGHT = 220
local PRESS_SIZE = 180
local NAV_BUTTON = Vector2.new(64, 56)

local scales: { UIScale } = {}

local function addScale(inst: Instance): UIScale
	local s = Instance.new("UIScale")
	s.Name = "HudScale"
	s.Parent = inst
	table.insert(scales, s)
	return s
end

-- Currency pill ------------------------------------------------------------------------

local function pill(parent: Instance, currency: string, width: number, order: number, big: boolean)
	local frame = UI.new("Frame", {
		Name = currency,
		Size = UDim2.fromOffset(width, if big then 54 else 44),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.08,
		LayoutOrder = order,
		Corner = Theme.Radius.Pill,
		Stroke = { Color = Theme.darken(Theme.currencyColor(currency), 0.45), Thickness = 1.5 },
		Parent = parent,
	})
	UI.label({
		Name = "Icon",
		Text = Theme.currencyIcon(currency),
		TextSize = if big then 26 else 20,
		Size = UDim2.fromOffset(if big then 46 else 38, if big then 54 else 44),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = frame,
	})
	local value = UI.label({
		Name = "Value",
		Text = "0",
		Font = F.Heading,
		TextSize = if big then 26 else 19,
		TextColor3 = Theme.currencyColor(currency),
		Size = UDim2.new(1, if big then -54 else -44, 1, 0),
		Position = UDim2.fromOffset(if big then 46 else 38, 0),
		Parent = frame,
	})
	UI.attachTooltip(frame, function()
		local def = GameConfig.Currencies[currency]
		return `<b>{def.Icon} {def.Name}: {Format.commas(State.currency(currency))}</b>\n{def.Description}`
	end)
	return { Frame = frame, Value = value, Displayed = 0 }
end

-- Construction ---------------------------------------------------------------------------

function Hud.init(ctx)
	Hud.Ctx = ctx
	local layer = ctx.Layers.Hud
	local fx = ctx.Layers.Fx

	-- Bottom dock ---------------------------------------------------------------------------
	-- Everything except the quest card lives at the bottom, so the middle of the screen
	-- stays free for the 3D world and the obby. Rows, bottom to top: navigation,
	-- currencies + level + ascension, info strip (obby, stats), boosts, save warning.
	local dock = UI.frame({
		Name = "Dock",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(DOCK_WIDTH, DOCK_HEIGHT),
		List = { Dir = "Y", Pad = 6, HA = "Center", VA = "Bottom" },
		Parent = layer,
	})
	Hud.Dock = dock
	Hud.TopBar = dock
	-- Scaled separately in Hud.layout so the dock always fits beside the PRESS button.
	Hud.DockScale = Instance.new("UIScale")
	Hud.DockScale.Parent = dock

	Hud.SaveBadge = UI.label({
		Name = "SaveBadge",
		Text = "⚠ Not saving (temporary session)",
		TextSize = 13,
		Font = F.Bold,
		TextColor3 = C.Warning,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 1,
		Visible = false,
		Parent = dock,
	})
	UI.stroke(Hud.SaveBadge, { Color = C.Black, Transparency = 0.5, Text = true })

	-- Active boosts as timer pills (filled by Hud.refreshBoosts).
	local boosts = UI.frame({
		Name = "BoostsCard",
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = 2,
		Visible = false,
		List = { Dir = "X", Pad = 6, HA = "Center", VA = "Center" },
		Parent = dock,
	})
	Hud.BoostsCard = boosts
	Hud.BoostLines = {}

	-- Info strip: obby progress and live stat chips.
	local info = UI.frame({
		Name = "Chips",
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 3,
		List = { Dir = "X", Pad = 6, HA = "Center", VA = "Center" },
		Parent = dock,
	})
	local obbyChip = UI.new("Frame", {
		Name = "ObbyChip",
		Size = UDim2.fromOffset(0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = 0,
		Corner = Theme.Radius.Pill,
		Stroke = { Color = C.Accent2, Thickness = 1.5, Transparency = 0.3 },
		Padding = { X = 4 },
		List = { Dir = "X", Pad = 4, VA = "Center" },
		Parent = info,
	})
	Hud.ObbyChip = obbyChip
	Hud.ObbyLabel = UI.label({
		Name = "ObbyLabel",
		Text = `🏃 Obby 0/{ObbyConfig.StageCount}`,
		Font = F.Bold,
		TextSize = 14,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 26),
		LayoutOrder = 1,
		Padding = { X = 6 },
		Parent = obbyChip,
	})
	local function obbyTeleport(to: string)
		local result = ClientNet.once("obby", "ObbyTeleport", { To = to })
		if result and not result.ok then
			ctx.Notifications.result(result)
		end
	end
	Hud.ObbyGo = UI.button({
		Name = "ObbyGo",
		Text = "▶",
		Variant = "primary",
		Size = UDim2.fromOffset(32, 24),
		TextSize = 13,
		LayoutOrder = 2,
		OnClick = function()
			obbyTeleport("checkpoint")
		end,
		Parent = obbyChip,
	})
	UI.attachTooltip(Hud.ObbyGo, "Go to your obby checkpoint. Your auto-presses keep earning while you run!")
	Hud.ObbyHome = UI.button({
		Name = "ObbyHome",
		Text = "🏠",
		Variant = "ghost",
		Size = UDim2.fromOffset(32, 24),
		TextSize = 13,
		LayoutOrder = 3,
		OnClick = function()
			obbyTeleport("plaza")
		end,
		Parent = obbyChip,
	})
	UI.attachTooltip(Hud.ObbyHome, "Back to the plaza (your obby checkpoint is kept).")

	Hud.Chips = {}
	for index, spec in ipairs({
		{ "Crit", "🎯" },
		{ "Luck", "🍀" },
		{ "Auto", "🤖" },
		{ "Multi", "✖️" },
	}) do
		local chip = UI.label({
			Name = spec[1],
			Text = spec[2],
			Font = F.Bold,
			TextSize = 14,
			TextColor3 = C.TextDim,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 28),
			BackgroundColor3 = C.Panel,
			BackgroundTransparency = 0.15,
			LayoutOrder = index,
			Corner = Theme.Radius.Pill,
			Padding = { X = 12 },
			Parent = info,
		})
		Hud.Chips[spec[1]] = chip
	end
	UI.attachTooltip(Hud.Chips.Crit, "Chance for a critical press and its multiplier.")
	UI.attachTooltip(Hud.Chips.Luck, "Luck improves the rarity odds of every crate.")
	UI.attachTooltip(Hud.Chips.Auto, "Automatic presses per second and what they earn. They keep going while you run around or do the obby.")
	UI.attachTooltip(Hud.Chips.Multi, "Total Sparks multiplier from upgrades, skills, items, ascensions and boosts.")

	-- Currencies, level and ascension progress.
	local row = UI.frame({
		Name = "Row",
		Size = UDim2.new(1, 0, 0, 54),
		LayoutOrder = 4,
		List = { Dir = "X", Pad = 8, HA = "Center", VA = "Center" },
		Parent = dock,
	})
	Hud.Pills = {
		Sparks = pill(row, "Sparks", 210, 1, true),
		Gems = pill(row, "Gems", 124, 2, false),
		Prisms = pill(row, "Prisms", 108, 3, false),
	}
	local levelFrame = UI.new("Frame", {
		Name = "Level",
