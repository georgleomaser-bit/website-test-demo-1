        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Achievements</string>
            <string name="Source"><![CDATA[--[[
	Achievements (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Achievements

	Achievements unlock automatically when a tracked statistic reaches its
	target. Rewards are granted by the server on unlock.

	Stat refers to a key of the player's Stats table, or one of the computed
	values: "Rebirths", "Level", "ItemsDiscovered", "SkillRanks".
	Reward fields: Gems, SkillPoints, Chests = { [chestId] = count }
]]

export type Achievement = {
	Id: string,
	Name: string,
	Icon: string,
	Description: string,
	Stat: string,
	Target: number,
	Reward: { Gems: number?, SkillPoints: number?, Chests: { [string]: number }? },
	Order: number,
}

local Achievements = {}

-- stylua: ignore
local LIST = {
	{ "press_100",      "First Steps",        "👆", "Press the button 100 times.",               "TotalClicks",       100,       { Gems = 10 } },
	{ "press_1k",       "Getting the Hang",   "👆", "Press the button 1,000 times.",             "TotalClicks",       1000,      { Gems = 25, SkillPoints = 1 } },
	{ "press_10k",      "Button Enthusiast",  "👆", "Press the button 10,000 times.",            "TotalClicks",       10000,     { Gems = 75, SkillPoints = 1 } },
	{ "press_100k",     "Button Devotee",     "👆", "Press the button 100,000 times.",           "TotalClicks",       100000,    { Gems = 250, SkillPoints = 2 } },
	{ "press_1m",       "Button Legend",      "🏆", "Press the button 1,000,000 times.",         "TotalClicks",       1000000,   { Gems = 1000, SkillPoints = 3 } },

	{ "sparks_1k",      "Spark of Hope",      "⚡", "Earn 1,000 Sparks in total.",               "LifetimeSparks",    1e3,       { Gems = 10 } },
	{ "sparks_1m",      "Millionaire",        "⚡", "Earn 1 million Sparks in total.",           "LifetimeSparks",    1e6,       { Gems = 50, Chests = { neon = 2 } } },
	{ "sparks_1b",      "Billionaire",        "⚡", "Earn 1 billion Sparks in total.",           "LifetimeSparks",    1e9,       { Gems = 150, SkillPoints = 2 } },
	{ "sparks_1t",      "Trillionaire",       "⚡", "Earn 1 trillion Sparks in total.",          "LifetimeSparks",    1e12,      { Gems = 400, SkillPoints = 3 } },
	{ "sparks_1qa",     "Beyond Counting",    "🌌", "Earn 1 quadrillion Sparks in total.",       "LifetimeSparks",    1e15,      { Gems = 1000, SkillPoints = 5 } },

	{ "crate_1",        "Unboxing Day",       "📦", "Open your first crate.",                    "ChestsOpened",      1,         { Gems = 5 } },
	{ "crate_50",       "Crate Collector",    "📦", "Open 50 crates.",                           "ChestsOpened",      50,        { Gems = 40, Chests = { neon = 1 } } },
	{ "crate_500",      "Crate Hoarder",      "🎁", "Open 500 crates.",                          "ChestsOpened",      500,       { Gems = 150, SkillPoints = 2 } },
	{ "crate_5000",     "Crate Tycoon",       "🎁", "Open 5,000 crates.",                        "ChestsOpened",      5000,      { Gems = 600, SkillPoints = 3 } },

	{ "fuse_1",         "Fusion Novice",      "✨", "Fuse 3 copies of an item into a better one.", "ItemsFused",       1,         { Gems = 20 } },
	{ "fuse_25",        "Fusion Master",      "✨", "Fuse items 25 times.",                      "ItemsFused",        25,        { Gems = 150, SkillPoints = 2 } },
	{ "rainbow_1",      "Over the Rainbow",   "🌈", "Get a Rainbow item.",                       "RainbowsFound",     1,         { Gems = 100, SkillPoints = 1 } },

	{ "discover_10",    "Curious Mind",       "📖", "Discover 10 different items.",              "ItemsDiscovered",   10,        { Gems = 25, SkillPoints = 1 } },
	{ "discover_30",    "Archivist",          "📖", "Discover 30 different items.",              "ItemsDiscovered",   30,        { Gems = 100, SkillPoints = 2 } },
	{ "discover_60",    "Museum Curator",     "🏛️", "Discover 60 different items.",              "ItemsDiscovered",   60,        { Gems = 400, SkillPoints = 3 } },

	{ "legendary_1",    "Legendary!",         "🌟", "Find a Legendary item.",                    "LegendariesFound",  1,         { Gems = 50 } },
	{ "mythic_1",       "Myth Made Real",     "🐉", "Find a Mythic item.",                       "MythicsFound",      1,         { Gems = 200, SkillPoints = 1 } },
	{ "secret_1",       "Secret Keeper",      "🤫", "Find a Secret item.",                       "SecretsFound",      1,         { Gems = 1000, SkillPoints = 3 } },

	{ "crit_100",       "Critical Thinker",   "🎯", "Land 100 critical presses.",                "TotalCrits",        100,       { Gems = 15 } },
	{ "crit_10k",       "Crit Machine",       "🎯", "Land 10,000 critical presses.",             "TotalCrits",        10000,     { Gems = 150, SkillPoints = 2 } },
	{ "combo_100",      "Combo Starter",      "🔥", "Reach a 100 press combo.",                  "HighestCombo",      100,       { Gems = 20 } },
	{ "combo_500",      "Combo Fiend",        "🔥", "Reach a 500 press combo.",                  "HighestCombo",      500,       { Gems = 100, SkillPoints = 1 } },
	{ "golden_10",      "Golden Fingers",     "🌟", "Trigger 10 golden presses.",                "GoldenClicks",      10,        { Gems = 50 } },

	{ "rebirth_1",      "Ascended",           "🔷", "Ascend for the first time.",                "Rebirths",          1,         { Gems = 100, SkillPoints = 2 } },
	{ "rebirth_5",      "Seasoned Ascender",  "🔷", "Ascend 5 times.",                           "Rebirths",          5,         { Gems = 300, SkillPoints = 3 } },
	{ "rebirth_10",     "Singular",           "🌌", "Ascend 10 times.",                          "Rebirths",          10,        { Gems = 800, SkillPoints = 5 } },

	{ "upgrade_25",     "Tinkerer",           "🔧", "Buy 25 upgrade levels.",                    "UpgradesPurchased", 25,        { Gems = 20 } },
	{ "upgrade_250",    "Engineer",           "🔧", "Buy 250 upgrade levels.",                   "UpgradesPurchased", 250,       { Gems = 100, SkillPoints = 1 } },
	{ "skills_10",      "Branching Out",      "🌳", "Invest 10 Skill Points.",                   "SkillRanks",        10,        { Gems = 50 } },
	{ "level_25",       "Experienced",        "📈", "Reach level 25.",                           "Level",             25,        { Gems = 100, Chests = { prism = 1 } } },
	{ "quests_10",      "Quest Taker",        "📜", "Complete 10 daily quests.",                 "QuestsCompleted",   10,        { Gems = 75 } },
	{ "orbs_25",        "Orb Catcher",        "🔮", "Collect 25 bonus orbs.",                    "OrbsCollected",     25,        { Gems = 60 } },
}

Achievements.List = {} :: { Achievement }
Achievements.ById = {} :: { [string]: Achievement }

for index, row in ipairs(LIST) do
	local id, name, icon, description, stat, target, reward = table.unpack(row)
	local def: Achievement = {
		Id = id,
		Name = name,
		Icon = icon,
		Description = description,
		Stat = stat,
		Target = target,
		Reward = reward,
		Order = index,
	}
	assert(Achievements.ById[id] == nil, "Duplicate achievement " .. id)
	table.insert(Achievements.List, def)
	Achievements.ById[id] = def
end

function Achievements.get(id: string): Achievement?
	return Achievements.ById[id]
end

return Achievements
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Ascension</string>
            <string name="Source"><![CDATA[--[[
	Ascension (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Ascension

	Permanent upgrades bought with Prisms (earned by ascending).
	These are NEVER reset. Cost for level L -> L+1 is
	    ceil(BaseCost * Growth ^ L)
]]

export type AscensionUpgrade = {
	Id: string,
	Name: string,
	Icon: string,
	Description: string,
	Order: number,
	MaxLevel: number,
	BaseCost: number,
	Growth: number,
	Stat: string,
	Mode: string,
	Display: string,
	Value: (level: number) -> number,
}

local Ascension = {}

Ascension.List = {
	{
		Id = "eternal_power",
		Name = "Eternal Power",
		Icon = "♾️",
		Description = "+25% Sparks from every source per level. Permanent.",
		Order = 1,
		MaxLevel = 100,
		BaseCost = 2,
		Growth = 1.3,
		Stat = "sparksMult",
		Mode = "mult",
		Display = "mult",
		Value = function(level: number): number
			return 1 + 0.25 * level
		end,
	},
	{
		Id = "head_start",
		Name = "Head Start",
		Icon = "🏁",
		Description = "Begin every run with bonus Sparks.",
		Order = 2,
		MaxLevel = 8,
		BaseCost = 3,
		Growth = 2,
		Stat = "startSparks",
		Mode = "add",
		Display = "flat",
		Value = function(level: number): number
			return if level <= 0 then 0 else 500 * 8 ^ (level - 1)
		end,
	},
	{
		Id = "keep_auto",
		Name = "Loyal Robots",
		Icon = "🤖",
		Description = "Keep your Auto-Presser levels when you ascend.",
		Order = 3,
		MaxLevel = 1,
		BaseCost = 12,
		Growth = 1,
		Stat = "keepAuto",
		Mode = "add",
		Display = "unlock",
		Value = function(level: number): number
			return level
		end,
	},
	{
		Id = "prism_luck",
		Name = "Prismatic Luck",
		Icon = "🍀",
		Description = "+10% Luck per level.",
		Order = 4,
		MaxLevel = 20,
		BaseCost = 3,
		Growth = 1.5,
		Stat = "luck",
		Mode = "add",
		Display = "pct",
		Value = function(level: number): number
			return 0.1 * level
		end,
	},
	{
		Id = "extra_slot",
		Name = "Deep Pockets",
		Icon = "🎒",
		Description = "+1 item equip slot per level.",
		Order = 5,
		MaxLevel = 3,
		BaseCost = 10,
		Growth = 3,
		Stat = "equipSlots",
		Mode = "add",
		Display = "flat",
		Value = function(level: number): number
			return level
		end,
	},
	{
		Id = "prism_yield",
		Name = "Prism Refinery",
		Icon = "🔷",
		Description = "+10% Prisms from every ascension per level.",
		Order = 6,
		MaxLevel = 25,
		BaseCost = 4,
		Growth = 1.45,
		Stat = "prismPct",
		Mode = "add",
		Display = "pct",
		Value = function(level: number): number
			return 0.1 * level
		end,
	},
	{
		Id = "crate_discount",
		Name = "Crate Broker",
		Icon = "🏷️",
		Description = "-3% Spark crate prices per level.",
		Order = 7,
		MaxLevel = 10,
		BaseCost = 5,
		Growth = 1.6,
		Stat = "chestDiscount",
		Mode = "add",
		Display = "pct",
		Value = function(level: number): number
			return 0.03 * level
		end,
	},
	{
		Id = "night_owl",
		Name = "Night Owl",
		Icon = "🦉",
		Description = "+1 hour of offline earnings and +5% offline rate per level.",
		Order = 8,
		MaxLevel = 6,
		BaseCost = 4,
		Growth = 1.7,
		Stat = "offlineHours",
		Mode = "add",
		Display = "hours",
		Value = function(level: number): number
			return level
		end,
	},
	{
		Id = "combo_mastery",
		Name = "Combo Mastery",
		Icon = "🔥",
		Description = "+20 combo cap per level.",
		Order = 9,
		MaxLevel = 5,
		BaseCost = 6,
		Growth = 2,
		Stat = "comboCap",
		Mode = "add",
		Display = "flat",
		Value = function(level: number): number
			return 20 * level
		end,
	},
}

Ascension.ById = {}
for _, def in ipairs(Ascension.List) do
	Ascension.ById[def.Id] = def
end
table.sort(Ascension.List, function(a, b)
	return a.Order < b.Order
end)

-- Night Owl also raises the offline rate; Formulas reads this.
Ascension.OfflineRatePerNightOwl = 0.05

function Ascension.get(id: string): AscensionUpgrade?
	return Ascension.ById[id]
end

return Ascension
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Chests</string>
            <string name="Source"><![CDATA[--[[
	Chests (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Chests

	Crate tiers. Weights are relative (they do not need to sum to anything in
	particular); Loot.effectiveWeights applies luck and normalises them.
	Pity: after N openings of the same crate without a drop of at least the
	given rarity, the next drop is guaranteed to be that rarity or better.

	Gem-priced crates (Prism Cache) never get crate discounts or bonus drops,
	and their items use a small SellFactor, so Gems cannot be farmed by
	buying caches and selling what drops (see docs/GAME_DESIGN.md).

	Item pools are built in Items (each item declares its Chest), so this module
	has no dependency on Items.
]]

export type Chest = {
	Id: string,
	Name: string,
	Icon: string,
	Order: number,
	Tier: number,
	TierFactor: number,
	SellFactor: number?,
	Currency: string,
	Price: number,
	Stage: number,
	Color: Color3,
	Description: string,
	Weights: { [string]: number },
	Pity: { [string]: number },
	MaxOpen: number,
}

local Chests = {}

Chests.List = {
	{
		Id = "starter",
		Name = "Spark Crate",
		Icon = "📦",
		Order = 1,
		Tier = 1,
		TierFactor = 1,
		Currency = "Sparks",
		Price = 250,
		Stage = 1,
		Color = Color3.fromRGB(255, 200, 70),
		Description = "A humble crate humming with static. Everyone starts here.",
		Weights = { Common = 62000, Uncommon = 25000, Rare = 9000, Epic = 3000, Legendary = 800, Mythic = 180, Secret = 20 },
		Pity = { Legendary = 80, Mythic = 500 },
		MaxOpen = 10,
	},
	{
		Id = "neon",
		Name = "Neon Crate",
		Icon = "🎁",
		Order = 2,
		Tier = 2,
		TierFactor = 1.5,
		Currency = "Sparks",
		Price = 8000,
		Stage = 1,
		Color = Color3.fromRGB(255, 70, 160),
		Description = "Glows in the dark. Packed with arcade relics.",
		Weights = { Common = 55000, Uncommon = 27000, Rare = 11500, Epic = 4600, Legendary = 1500, Mythic = 360, Secret = 40 },
		Pity = { Legendary = 70, Mythic = 450 },
		MaxOpen = 10,
	},
	{
		Id = "plasma",
		Name = "Plasma Crate",
		Icon = "🧰",
		Order = 3,
		Tier = 3,
		TierFactor = 2.5,
		Currency = "Sparks",
		Price = 1.5e6,
		Stage = 2,
		Color = Color3.fromRGB(255, 140, 50),
		Description = "Superheated lab equipment. Handle with gloves.",
		Weights = { Common = 50000, Uncommon = 28000, Rare = 13500, Epic = 6000, Legendary = 2000, Mythic = 450, Secret = 50 },
		Pity = { Legendary = 65, Mythic = 400 },
		MaxOpen = 10,
	},
	{
		Id = "void",
		Name = "Void Crate",
		Icon = "🗃️",
		Order = 4,
		Tier = 4,
		TierFactor = 4,
		Currency = "Sparks",
		Price = 6e7,
		Stage = 3,
		Color = Color3.fromRGB(140, 90, 255),
		Description = "Contents may not obey the laws of physics.",
		Weights = { Common = 46000, Uncommon = 29000, Rare = 15000, Epic = 7000, Legendary = 2350, Mythic = 580, Secret = 70 },
		Pity = { Legendary = 60, Mythic = 380 },
		MaxOpen = 10,
	},
	{
		Id = "celestial",
		Name = "Celestial Crate",
		Icon = "🌠",
		Order = 5,
		Tier = 5,
		TierFactor = 6.5,
		Currency = "Sparks",
		Price = 1.5e10,
		Stage = 4,
		Color = Color3.fromRGB(70, 200, 255),
		Description = "Fell from the sky. Still warm.",
		Weights = { Common = 42000, Uncommon = 30000, Rare = 16500, Epic = 8000, Legendary = 2700, Mythic = 700, Secret = 100 },
		Pity = { Legendary = 55, Mythic = 350 },
		MaxOpen = 10,
	},
	{
		Id = "singularity",
		Name = "Singularity Core",
		Icon = "🌌",
		Order = 6,
		Tier = 6,
		TierFactor = 10,
		Currency = "Sparks",
		Price = 8e12,
		Stage = 5,
		Color = Color3.fromRGB(235, 235, 255),
		Description = "Infinitely dense. Infinitely valuable.",
		Weights = { Common = 38000, Uncommon = 31000, Rare = 18000, Epic = 9000, Legendary = 3000, Mythic = 850, Secret = 150 },
		Pity = { Legendary = 50, Mythic = 320 },
		MaxOpen = 10,
	},
	{
		Id = "prism",
		Name = "Prism Cache",
		Icon = "💠",
		Order = 7,
		Tier = 3,
		TierFactor = 3,
		-- Items from a Gem-priced crate sell for far less than their equip power
		-- suggests, so buying caches and selling the drops can never create Gems.
		SellFactor = 0.1,
		Currency = "Gems",
		Price = 120,
		Stage = 1,
		Color = Color3.fromRGB(77, 225, 255),
		Description = "Paid for in Gems. Only Rare or better inside.",
		Weights = { Rare = 60000, Epic = 28000, Legendary = 9500, Mythic = 2300, Secret = 200 },
		Pity = { Legendary = 25, Mythic = 150 },
		MaxOpen = 10,
	},
}

Chests.ById = {}
Chests.Order = {}
for _, chest in ipairs(Chests.List) do
	Chests.ById[chest.Id] = chest
	table.insert(Chests.Order, chest.Id)
end
table.sort(Chests.Order, function(a, b)
	return Chests.ById[a].Order < Chests.ById[b].Order
end)

-- Allowed multi-open amounts shown in the UI. The server accepts any integer 1..MaxOpen.
Chests.OpenAmounts = { 1, 5, 10 }

--[[
	Robux crates ("OP crates"). Bought only as Developer Products
	(Config/DevProducts) and opened by the server the moment the purchase is
	processed, so they are kept out of Chests.List / Chests.ById: the
	OpenChest action, owned-crate counts, pity and the collection book never
	see them.
	Weights contain only the guaranteed rarity and better (Luck still shifts
	them upward). The item comes from the combined pools of every crate the
	player has already unlocked, so no item from a locked stage is handed out
	early, and the crates have no items of their own.
	VariantChances: better Golden/Rainbow odds than normal crates (see
	Items.Variants). ForceVariant: every drop is that variant (Rainbow Chest).
]]
Chests.RobuxList = {
	{
		Id = "op_crate",
		Name = "OP Crate",
		Icon = "🔥",
		Order = 101,
		Tier = 4,
		Currency = "Robux",
		Color = Color3.fromRGB(176, 92, 255),
		Description = "Epic or better guaranteed!",
		Weights = { Epic = 7000, Legendary = 2400, Mythic = 550, Secret = 50 },
		VariantChances = { golden = 0.06, rainbow = 0.006 },
	},
	{
		Id = "mega_op_crate",
		Name = "Mega OP Crate",
		Icon = "💥",
		Order = 102,
		Tier = 6,
		Currency = "Robux",
		Color = Color3.fromRGB(255, 180, 40),
		Description = "Legendary or better guaranteed!",
		Weights = { Legendary = 8000, Mythic = 1800, Secret = 200 },
		VariantChances = { golden = 0.1, rainbow = 0.012 },
	},
	{
		Id = "ultra_op_crate",
		Name = "Ultra OP Crate",
		Icon = "🌌",
		Order = 103,
		Tier = 8,
		Currency = "Robux",
		Color = Color3.fromRGB(255, 64, 112),
		Description = "Mythic or better guaranteed, 8% Secret!",
		Weights = { Mythic = 9200, Secret = 800 },
		VariantChances = { golden = 0.15, rainbow = 0.02 },
	},
	{
		Id = "rainbow_chest",
		Name = "Rainbow Chest",
		Icon = "🌈",
		Order = 104,
		Tier = 10,
		Currency = "Robux",
		Color = Color3.fromRGB(255, 120, 220),
		Description = "A guaranteed Rainbow item, Epic or better!",
		Weights = { Epic = 5500, Legendary = 3000, Mythic = 1000, Secret = 500 },
		ForceVariant = "rainbow",
	},
}
Chests.RobuxById = {}
for _, chest in ipairs(Chests.RobuxList) do
	Chests.RobuxById[chest.Id] = chest
end

function Chests.get(id: string): Chest?
	return Chests.ById[id]
end

-- Highest-tier Sparks crate that a player with the given stage can access.
function Chests.bestSparksChestForStage(stage: number): string
	local best = "starter"
	local bestOrder = 0
	for _, chest in ipairs(Chests.List) do
		if chest.Currency == "Sparks" and chest.Stage <= stage and chest.Order > bestOrder then
			best = chest.Id
			bestOrder = chest.Order
		end
	end
	return best
end

return Chests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">DevProducts</string>
            <string name="Source"><![CDATA[--[[
	DevProducts (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/DevProducts

	Developer Products: Robux purchases that can be bought again and again
	(Gem packs, a timed Sparks boost, a crate bundle). Rewards are granted only
	by the server in MarketplaceService.ProcessReceipt (ProductService), saved
	right away, and every receipt is granted exactly once.

	================================================================
	HOW TO SET UP A PRODUCT (once per product)
	================================================================
	1. Publish the game (File → Publish to Roblox).
	2. Open create.roblox.com → Creations → your experience →
	   Monetization → Developer Products → "Create a Developer Product".
	3. Enter the name and description from the list below, upload an image
	   (optional), set the price (SuggestedPrice below) and save.
	4. Copy the product ID (shown in the list, or via "Copy Asset ID") and paste
	   it as ProductId below, e.g.  ProductId = 123456789,
	5. Publish again. Products with ProductId = 0 are "not set up": they are
	   hidden in live games and can't be bought.

	The same rewards can also be sold as a one-time GAME PASS: put the pass
	ID into GamePassId instead. Its reward is then granted once per player
	(recorded in data.PassRewards), on purchase or on the next join.
	With HubName (the exact Creator Hub name) the server checks with Roblox
	which kind the ID really is, so it works either way (Shared/RobuxSale).
	================================================================

	Rewards (a product may combine several; they are granted in this order):
	  Sparks = n                       adds exactly n Sparks (no multipliers; does
	                                   not count toward quests or the run total)
	  Gems = n                         adds n Gems (not affected by Gem boosts)
	  Boost = { Seconds, Stat, Mult }  a timed boost; buying again adds time.
	  Boost = { Seconds, Stat, Add }   (Add for additive stats such as luck)
	                                   The timer only runs while you play.
	  Crates = n                       n of the best Spark crate you have unlocked
	  Crate = "id"                     opens a Robux crate (Config/Chests RobuxList)
	                                   right away and plays the opening animation
]]

export type Product = {
	Key: string,
	Name: string,
	Icon: string,
	Color: Color3,
	Description: string,
	Sparks: number?,
	Gems: number?,
	Boost: { Seconds: number, Stat: string, Mult: number?, Add: number? }?,
	Crates: number?,
	Crate: string?,
	Op: boolean?,
	SuggestedPrice: number,
	ProductId: number,
	GamePassId: number?,
	HubName: string?,
	Order: number?, -- set from the list position below
}

local RobuxSale = require(script.Parent.Parent.RobuxSale)

local DevProducts = {}

DevProducts.List = {
	-- The owner's items from the Creator Hub (created as game passes; the server
	-- confirms the kind with Roblox through HubName and sells them accordingly).
	{
		Key = "starter_pack",
		Name = "Starter Pack",
		Icon = "🎁",
		Color = Color3.fromRGB(255, 200, 70),
		Description = "25,000 Sparks, 150 Gems and 3 crates",
		Sparks = 25000,
		Gems = 150,
		Crates = 3,
		SuggestedPrice = 49,
		ProductId = 0,
		GamePassId = 2037646106,
		HubName = "Starter Pack",
	},
	{
		Key = "sparks_30k",
		Name = "Sparks 30,000",
		Icon = "⚡",
		Color = Color3.fromRGB(255, 214, 74),
		Description = "+30,000 Sparks",
		Sparks = 30000,
		SuggestedPrice = 49,
		ProductId = 0,
		GamePassId = 2037322132,
		HubName = "Spark 30000",
	},
	{
		Key = "sparks_60k",
		Name = "Sparks 60,000",
		Icon = "⚡",
		Color = Color3.fromRGB(255, 214, 74),
		Description = "+60,000 Sparks",
		Sparks = 60000,
		SuggestedPrice = 99,
		ProductId = 0,
		GamePassId = 2036914125,
		HubName = "Spark 60000",
	},
	{
		Key = "op_sparks_200k",
		Name = "OP Sparks 200,000",
		Icon = "⚡",
		Color = Color3.fromRGB(255, 160, 40),
		Description = "+200,000 Sparks",
		Sparks = 200000,
		Op = true,
		SuggestedPrice = 199,
		ProductId = 0,
		GamePassId = 2039811962,
		HubName = "OP Sparks 200000",
	},
	{
		Key = "gems_120",
		Name = "Gems 120",
		Icon = "💎",
		Color = Color3.fromRGB(77, 225, 255),
		Description = "+120 Gems",
		Gems = 120,
		SuggestedPrice = 49,
		ProductId = 0,
		GamePassId = 2039541981,
		HubName = "Gems 120",
	},
	{
		Key = "gems_600",
		Name = "Gems 600",
		Icon = "💎",
		Color = Color3.fromRGB(77, 225, 255),
		Description = "+600 Gems",
		Gems = 600,
		SuggestedPrice = 199,
		ProductId = 0,
		GamePassId = 2039937934,
		HubName = "Gems 600",
	},
	{
		Key = "op_gems_15k",
		Name = "OP Gems 15,000",
		Icon = "💠",
		Color = Color3.fromRGB(176, 92, 255),
		Description = "+15,000 Gems",
		Gems = 15000,
		Op = true,
		SuggestedPrice = 999,
		ProductId = 0,
		GamePassId = 2036932058,
		HubName = "OP Gems 15000",
	},
	{
		Key = "boost_lucky_hour",
		Name = "Lucky Hour Boost",
		Icon = "🍀",
		Color = Color3.fromRGB(74, 222, 128),
		Description = "+100% Luck for 1 hour of play",
		Boost = { Seconds = 60 * 60, Stat = "luck", Add = 1 },
		SuggestedPrice = 99,
		ProductId = 0,
		GamePassId = 2039895926,
		HubName = "Boost Lucky Hour",
	},
	{
		Key = "boost_spark_surge",
		Name = "Spark Surge Boost",
		Icon = "🔥",
		Color = Color3.fromRGB(255, 160, 40),
		Description = "×2 Sparks for 1 hour of play",
		Boost = { Seconds = 60 * 60, Stat = "sparksMult", Mult = 2 },
		SuggestedPrice = 99,
		ProductId = 0,
		GamePassId = 2038198094,
		HubName = "Boost spark search",
	},
	{
		Key = "gems_small",
		Name = "Pouch of Gems",
		Icon = "💎",
		Color = Color3.fromRGB(77, 225, 255),
		Description = "+100 Gems",
		Gems = 100,
		SuggestedPrice = 49,
		ProductId = 0,
	},
	{
		Key = "gems_medium",
		Name = "Sack of Gems",
		Icon = "💎",
		Color = Color3.fromRGB(77, 225, 255),
		Description = "+550 Gems",
		Gems = 550,
		SuggestedPrice = 199,
		ProductId = 0,
	},
	{
		Key = "gems_large",
		Name = "Vault of Gems",
		Icon = "💠",
		Color = Color3.fromRGB(176, 92, 255),
		Description = "+1,200 Gems",
		Gems = 1200,
		SuggestedPrice = 399,
		ProductId = 0,
	},
	{
		Key = "sparks_rush",
		Name = "Sparks Rush",
		Icon = "🔥",
		Color = Color3.fromRGB(255, 160, 40),
		Description = "×3 Sparks for 15 minutes of play. Buy more to add time.",
		Boost = { Seconds = 15 * 60, Stat = "sparksMult", Mult = 3 },
		SuggestedPrice = 99,
		ProductId = 0,
	},
	{
		Key = "op_crate",
		Name = "OP Crate",
		Icon = "🔥",
		Color = Color3.fromRGB(176, 92, 255),
		Description = "Epic or better guaranteed!",
		Crate = "op_crate",
		Op = true,
		SuggestedPrice = 99,
		ProductId = 0,
	},
	{
		Key = "mega_op_crate",
		Name = "Mega OP Crate",
		Icon = "💥",
		Color = Color3.fromRGB(255, 180, 40),
		Description = "Legendary or better guaranteed!",
		Crate = "mega_op_crate",
		Op = true,
		SuggestedPrice = 199,
		ProductId = 0,
	},
	{
		Key = "ultra_op_crate",
		Name = "Ultra OP Crate",
		Icon = "🌌",
		Color = Color3.fromRGB(255, 64, 112),
		Description = "Mythic or better guaranteed, 8% Secret!",
		Crate = "ultra_op_crate",
		Op = true,
		SuggestedPrice = 299,
		ProductId = 0,
	},
	{
		Key = "rainbow_chest",
		Name = "Rainbow Chest",
		Icon = "🌈",
		Color = Color3.fromRGB(255, 120, 220),
		Description = "A guaranteed Rainbow item, Epic or better!",
		Crate = "rainbow_chest",
		Op = true,
		SuggestedPrice = 449,
		ProductId = 0,
	},
	{
		Key = "crate_bundle",
		Name = "Crate Bundle",
		Icon = "🎁",
		Color = Color3.fromRGB(255, 200, 70),
		Description = "5 of the best Spark crate you have unlocked.",
		Crates = 5,
		SuggestedPrice = 149,
		ProductId = 0,
	},
} :: { Product }

-- Stacked boost time is capped so a long purchase streak can't overflow.
DevProducts.MaxBoostSeconds = 24 * 60 * 60

-- How many processed receipt IDs each player keeps (for duplicate protection).
DevProducts.ReceiptHistory = 100

DevProducts.ByKey = {} :: { [string]: Product }
for index, product in ipairs(DevProducts.List) do
	product.Order = index
	DevProducts.ByKey[product.Key] = product
end

function DevProducts.isConfigured(product: Product): boolean
	return (RobuxSale.of(product)) ~= nil
end

local function bySale(kind: string, id: any): Product?
	if type(id) ~= "number" or id <= 0 then
		return nil
	end
	for _, product in ipairs(DevProducts.List) do
		local saleKind, saleId = RobuxSale.of(product)
		if saleKind == kind and saleId == id then
			return product
		end
	end
	return nil
end

-- The entry sold as this developer product (read live, like GamePasses).
function DevProducts.byProductId(id: any): Product?
	return bySale("product", id)
end

-- The entry sold as this one-time game pass.
function DevProducts.byGamePassId(id: any): Product?
	return bySale("pass", id)
end

return DevProducts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--[[
	GameConfig (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/GameConfig

	Central balance and tuning values that are shared between server and client.
	The server is always authoritative: the client only reads these values to
	render previews and timers. Changing a value here changes it everywhere.

	Nothing in this file is secret. Admin roles and permissions live in
	ServerScriptService/Admin/AdminConfig, which never replicates to clients.
]]

local GameConfig = {}

GameConfig.GameName = "Click a Button"
GameConfig.Version = "1.0.0"

-- Currencies ---------------------------------------------------------------
GameConfig.Currencies = {
	Sparks = {
		Id = "Sparks",
		Name = "Sparks",
		Icon = "⚡",
		Color = Color3.fromRGB(255, 214, 74),
		Order = 1,
		Description = "Earned by pressing the button. Spent on upgrades and crates.",
	},
	Gems = {
		Id = "Gems",
		Name = "Gems",
		Icon = "💎",
		Color = Color3.fromRGB(77, 225, 255),
		Order = 2,
		Description = "Earned from quests, achievements, golden presses and selling items.",
	},
	Prisms = {
		Id = "Prisms",
		Name = "Prisms",
		Icon = "🔷",
		Color = Color3.fromRGB(196, 125, 255),
		Order = 3,
		Description = "Ascension currency. Earned by ascending and spent on permanent upgrades.",
	},
}
GameConfig.CurrencyOrder = { "Sparks", "Gems", "Prisms" }
-- Hard cap to keep numbers finite and JSON-safe in DataStores.
GameConfig.CurrencyCap = 1e300

-- Clicking -----------------------------------------------------------------
GameConfig.Click = {
	-- Server-side click rate limiting (token bucket). Humans rarely exceed ~15 CPS.
	MaxClicksPerSecond = 20,
	BurstCapacity = 30,
	-- When a client keeps sending more than this many clicks per second, it is flagged.
	SuspiciousClicksPerSecond = 35,

	BaseCritChance = 0.02,
	MaxCritChance = 0.75,
	BaseCritMultiplier = 3,

	-- Combo: consecutive presses within ComboWindow seconds stack the combo.
	ComboWindow = 1.0,
	ComboStep = 0.01, -- +1% value per combo stack
	BaseComboCap = 100, -- stacks beyond the cap still count toward streaks
	HardComboLimit = 1000000,

	-- Streak: every StreakEvery consecutive presses awards a burst.
	StreakEvery = 50,
	StreakBurstClicks = 20, -- burst = click value * this * streak multiplier

	-- Golden presses: rare bonus rewards on manual presses.
	BaseGoldenChance = 0.004,
	MaxGoldenChance = 0.05,

	XPPerClick = 1,
	AutoClickXPFactor = 0.5,
}

-- Golden press rewards (weighted).
GameConfig.GoldenRewards = {
	{ Type = "Sparks", Weight = 50, Clicks = 150 },
	{ Type = "Gems", Weight = 30, Min = 2, Max = 6 },
	{ Type = "Chest", Weight = 15 },
	{ Type = "Frenzy", Weight = 5, Duration = 15, Multiplier = 3 },
}

-- Bonus orbs that float onto the screen for the player to tap.
GameConfig.Orbs = {
	Enabled = true,
	MinInterval = 70,
	MaxInterval = 140,
	Lifetime = 9,
	ClaimGrace = 1.5, -- extra seconds to tolerate network latency
	Rewards = {
		{ Type = "Sparks", Weight = 45, IncomeSeconds = 60, MinClicks = 120 },
		{ Type = "Gems", Weight = 25, Min = 3, Max = 8 },
		{ Type = "Chest", Weight = 15 },
		{ Type = "Frenzy", Weight = 15, Duration = 20, Multiplier = 3 },
	},
}

-- Levels and XP --------------------------------------------------------------
GameConfig.Levels = {
	BaseXP = 40,
	Exponent = 1.55,
	MaxLevel = 1000,
	SkillPointsPerLevel = 1,
	BonusSkillPointEvery = 5, -- every 5th level gives an extra skill point
	ChestEvery = 5, -- every 5th level gives a crate
	ChestXP = 6, -- XP per crate opened, multiplied by crate tier
}

-- Passive and auto clicking ------------------------------------------------------
GameConfig.Passive = {
	TickInterval = 1,
}
GameConfig.AutoClick = {
	TickInterval = 0.25,
	MaxRate = 15, -- auto presses per second (hard cap)
}

-- Offline earnings (passive income while away).
GameConfig.Offline = {
	Enabled = true,
	BaseRate = 0.25, -- 25% of passive income
	BaseMaxHours = 2,
	MinSeconds = 120,
}

-- Equipping ------------------------------------------------------------------------
GameConfig.Equip = {
	BaseSlots = 3,
	MaxSlots = 8,
	CopyBonusPerExtra = 0.1, -- each extra copy adds +10% to an equipped item's power
	MaxCopyBonus = 1.0, -- up to +100%
}

-- Item stat multipliers: how strongly an item's rarity bonus maps to each stat.
GameConfig.ItemStats = {
	sparks = { Stat = "sparksPct", Factor = 1.0, Label = "Sparks" },
	click = { Stat = "clickPct", Factor = 1.5, Label = "Click Power" },
	luck = { Stat = "luck", Factor = 0.6, Label = "Luck" },
	crit = { Stat = "critChance", Factor = 0.12, Label = "Crit Chance" },
	passive = { Stat = "passivePct", Factor = 2.0, Label = "Passive Income" },
	xp = { Stat = "xpPct", Factor = 1.5, Label = "XP Gain" },
	gems = { Stat = "gemsPct", Factor = 1.0, Label = "Gem Gain" },
	golden = { Stat = "goldenPct", Factor = 1.0, Label = "Golden Chance" },
}

-- Collection -----------------------------------------------------------------------
GameConfig.Collection = {
	SparksBonusPerItem = 0.01, -- +1% Sparks per discovered item (multiplicative group)
}

-- Inventory --------------------------------------------------------------------
GameConfig.Inventory = {
	MaxStack = 1000000000,
	-- Auto-sell setting values: 0 = off, otherwise sells duplicates up to this rarity index.
	AutoSellMaxIndex = 3,
}

-- Skill tree respec.
GameConfig.Skills = {
	RespecGemCost = 100,
}

-- Rebirth ("Ascension") -----------------------------------------------------------
GameConfig.Rebirth = {
	BaseRequirement = 3e6, -- Sparks earned this run required for the first ascension
	RequirementGrowth = 6, -- requirement multiplier per ascension
	BasePrisms = 3,
	PrismsPerRebirth = 1,
	ExcessExponent = 0.35, -- bonus prisms for overshooting the requirement
	MaxExcessFactor = 50,
	MultiplierPerRebirth = 0.5, -- permanent +50% Sparks per ascension (additive)
	ConfirmRequired = true,
}

-- Progression stages unlocked by ascending.
GameConfig.Stages = {
	{
		Id = 1,
		Name = "Neon Core",
		Rebirths = 0,
		Multiplier = 1,
		Accent = Color3.fromRGB(255, 61, 110),
		AccentDark = Color3.fromRGB(150, 20, 70),
		Description = "Where every button legend begins.",
	},
	{
		Id = 2,
		Name = "Plasma Vault",
		Rebirths = 1,
		Multiplier = 1.25,
		Accent = Color3.fromRGB(255, 140, 50),
		AccentDark = Color3.fromRGB(150, 60, 10),
		Description = "Superheated presses. Unlocks the Plasma Crate.",
	},
	{
		Id = 3,
		Name = "Void Expanse",
		Rebirths = 3,
		Multiplier = 1.6,
		Accent = Color3.fromRGB(140, 90, 255),
		AccentDark = Color3.fromRGB(60, 30, 150),
		Description = "The button echoes into nothing. Unlocks the Void Crate.",
	},
	{
		Id = 4,
		Name = "Celestial Spire",
		Rebirths = 6,
		Multiplier = 2.2,
		Accent = Color3.fromRGB(70, 200, 255),
		AccentDark = Color3.fromRGB(20, 90, 160),
		Description = "Presses that move the stars. Unlocks the Celestial Crate.",
	},
	{
		Id = 5,
		Name = "Singularity",
		Rebirths = 10,
		Multiplier = 3.2,
		Accent = Color3.fromRGB(255, 255, 255),
		AccentDark = Color3.fromRGB(120, 120, 140),
		Description = "Everything collapses into one button. Unlocks the Singularity Core.",
	},
}

-- Server-wide boost events (started by admins or the automatic scheduler).
GameConfig.Events = {
	Definitions = {
		spark_surge = {
			Id = "spark_surge",
			Name = "Spark Surge",
			Icon = "⚡",
			Description = "All Sparks ×2",
			Color = Color3.fromRGB(255, 214, 74),
			Effects = { sparksMult = 2 },
			DefaultDuration = 600,
		},
		lucky_hour = {
			Id = "lucky_hour",
			Name = "Lucky Hour",
			Icon = "🍀",
			Description = "+100% Luck on every crate",
			Color = Color3.fromRGB(74, 222, 128),
			Effects = { luck = 1.0 },
			DefaultDuration = 900,
		},
		golden_rush = {
			Id = "golden_rush",
			Name = "Golden Rush",
			Icon = "🌟",
			Description = "Golden presses ×4 more often",
			Color = Color3.fromRGB(255, 190, 40),
			Effects = { goldenMult = 4 },
			DefaultDuration = 600,
		},
		crit_frenzy = {
			Id = "crit_frenzy",
			Name = "Critical Frenzy",
			Icon = "🎯",
			Description = "+25% Crit Chance",
			Color = Color3.fromRGB(255, 80, 80),
			Effects = { critChance = 0.25 },
			DefaultDuration = 600,
		},
		knowledge_storm = {
			Id = "knowledge_storm",
			Name = "Knowledge Storm",
			Icon = "📘",
			Description = "XP ×2",
			Color = Color3.fromRGB(90, 160, 255),
			Effects = { xpMult = 2 },
			DefaultDuration = 900,
		},
	},
	Order = { "spark_surge", "lucky_hour", "golden_rush", "crit_frenzy", "knowledge_storm" },
	MaxDuration = 3 * 3600,
	MinDuration = 30,
	-- Automatic events keep servers lively without an admin present.
	AutoSchedule = {
		Enabled = true,
		Interval = 1800,
		Duration = 300,
		Pool = { "spark_surge", "lucky_hour", "golden_rush", "crit_frenzy", "knowledge_storm" },
	},
}

-- Persistence --------------------------------------------------------------------
GameConfig.Data = {
	StoreName = "ButtonAscension_PlayerData",
	KeyPrefix = "Player_",
	AutosaveInterval = 60,
	-- A session lock older than this is considered abandoned (crashed server) and may be taken over.
	LockStaleSeconds = 150,
	LoadAttempts = 8, -- retries for DataStore errors while loading
	-- While another server holds a fresh lock, loading retries every LockedRetryDelay
	-- seconds until the lock is released or becomes stale (LockStaleSeconds + 15 s).
	LockedRetryDelay = 4,
	SaveAttempts = 4,
	-- In live servers, players whose data cannot be loaded safely are kicked instead of
	-- playing on default data (which could later overwrite their real progress).
	KickOnLoadFailure = true,
	ShutdownTimeout = 25,
}

GameConfig.Leaderboards = {
	Enabled = true,
	UpdateInterval = 150,
	RefreshInterval = 120,
	TopCount = 25,
	Boards = {
		{ Id = "LifetimeSparks", Name = "Lifetime Sparks", Icon = "⚡", Stat = "LifetimeSparks", Encode = "log" },
		{ Id = "TotalClicks", Name = "Total Presses", Icon = "👆", Stat = "TotalClicks", Encode = "int" },
		{ Id = "Rebirths", Name = "Ascensions", Icon = "🔷", Stat = "Rebirths", Encode = "int" },
	},
	StorePrefix = "ButtonAscension_LB_",
}

GameConfig.Sync = {
	Interval = 0.15,
}

-- Client-side defaults for settings. The server validates every change.
GameConfig.Settings = {
	Music = { Default = 0.4, Min = 0, Max = 1 },
	SFX = { Default = 0.7, Min = 0, Max = 1 },
	UIScale = { Default = 1, Min = 0.7, Max = 1.3 },
	ReducedMotion = { Default = false },
	ScreenShake = { Default = true },
	FloatingNumbers = { Default = true },
	ConfirmRareSales = { Default = true },
	AutoSell = { Default = 0, Min = 0, Max = 3 },
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">GamePasses</string>
            <string name="Source"><![CDATA[--[[
	GamePasses (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/GamePasses

	Robux game passes: bought once, owned forever. Ownership is checked on the
	SERVER only (GamePassService); the client can just open the Roblox purchase
	prompt. Effects are applied in Shared/Formulas, so the store previews and the
	server always agree.

	================================================================
	HOW TO SET UP A PASS (once per pass)
	================================================================
	1. Publish the game (File → Publish to Roblox).
	2. Open create.roblox.com → Creations → your experience →
	   Monetization → Passes → "Create a Pass".
	3. Upload an image (512 × 512; ready-made ones are in branding/passes/),
	   enter the name and description from the list below and click
	   "Create Pass".
	4. Open the new pass → Sales → turn "Item for Sale" on, set the price
	   (SuggestedPrice below is a good start) and save.
	5. Copy the pass ID (the number in the pass's URL or under "Copy Asset ID")
	   and paste it as GamePassId below, e.g.  GamePassId = 123456789,
	6. Publish again. Passes with GamePassId = 0 are "not set up": they are
	   hidden in live games and do nothing.
	Optional: HubName = the exact name in the Creator Hub. The server then
	checks with Roblox whether the ID is really a game pass or a developer
	product and sells it the right way (see Shared/RobuxSale). An effect pass
	sold as a developer product is bought once and kept forever too.
	================================================================

	Effects use the same stats as skills (see Shared/Formulas):
	  { Stat = "...", Add = n }   adds to a stat
	  { Stat = "...", Mult = n }  multiplies a stat (stacks multiplicatively)
	Special stats: autoRatePass (auto presses/s on top of the upgrade cap),
	gemsMult (×Gems), extraOpen (more crates per opening).
]]

export type Effect = { Stat: string, Add: number?, Mult: number? }

export type Pass = {
	Key: string,
	Name: string,
	Icon: string,
	Color: Color3,
	Description: string,
	EffectText: string,
	Effects: { Effect },
	SkipCrateAnimation: boolean?,
	Op: boolean?,
	SuggestedPrice: number,
	GamePassId: number,
	ProductId: number?,
	HubName: string?,
	Order: number?, -- set from the list position below
}

local RobuxSale = require(script.Parent.Parent.RobuxSale)

local GamePasses = {}

GamePasses.List = {
	{
		Key = "auto_clicker",
		Name = "Auto Clicker",
		Icon = "🤖",
		Color = Color3.fromRGB(77, 225, 255),
		Description = "Presses the button for you, even while you do other things.",
		EffectText = "+5 auto presses per second (on top of the upgrade limit)",
		Effects = { { Stat = "autoRatePass", Add = 5 } },
		SuggestedPrice = 99,
		GamePassId = 0,
	},
	{
		Key = "op_auto_clicker",
		Name = "OP Auto Clicker",
		Icon = "🚀",
		Color = Color3.fromRGB(255, 61, 110),
		Description = "A turbo presser. Stacks with Auto Clicker for +20 presses per second.",
		EffectText = "+15 auto presses per second",
		Effects = { { Stat = "autoRatePass", Add = 15 } },
		Op = true,
		SuggestedPrice = 349,
		-- Creator Hub: "OP CLICKER".
		GamePassId = 2038330114,
		HubName = "OP CLICKER",
	},
	{
		Key = "double_sparks",
		Name = "2× Sparks",
		Icon = "⚡",
		Color = Color3.fromRGB(255, 214, 74),
		Description = "Doubles every Spark you earn: presses, auto presses and passive income.",
		EffectText = "×2 Sparks",
		Effects = { { Stat = "sparksMult", Mult = 2 } },
		SuggestedPrice = 199,
		GamePassId = 0,
	},
	{
		Key = "triple_sparks",
		Name = "3× Sparks",
		Icon = "🌟",
		Color = Color3.fromRGB(255, 160, 40),
		Description = "Triples every Spark you earn. Stacks with 2× Sparks for ×6.",
		EffectText = "×3 Sparks (×6 with 2× Sparks)",
		Effects = { { Stat = "sparksMult", Mult = 3 } },
		Op = true,
		SuggestedPrice = 799,
		GamePassId = 0,
	},
	{
		Key = "double_gems",
		Name = "2× Gems",
		Icon = "💎",
		Color = Color3.fromRGB(77, 225, 255),
		Description = "Doubles Gems from quests, achievements, golden presses, orbs and selling items.",
		EffectText = "×2 Gems",
		Effects = { { Stat = "gemsMult", Mult = 2 } },
		SuggestedPrice = 149,
		GamePassId = 0,
	},
	{
		Key = "lucky",
		Name = "Lucky Pass",
		Icon = "🍀",
		Color = Color3.fromRGB(74, 222, 128),
		Description = "Better crate odds for rarer items.",
		EffectText = "+50% Luck",
		Effects = { { Stat = "luck", Add = 0.5 } },
		SuggestedPrice = 249,
		GamePassId = 0,
	},
	{
		Key = "super_luck",
		Name = "Super Luck",
		Icon = "🎰",
		Color = Color3.fromRGB(176, 92, 255),
		Description = "Massively better crate odds. Stacks with Lucky Pass for +200% Luck.",
		EffectText = "+150% Luck",
		Effects = { { Stat = "luck", Add = 1.5 } },
		Op = true,
		SuggestedPrice = 599,
		GamePassId = 0,
	},
	{
		Key = "fast_crates",
		Name = "Fast Crates",
		Icon = "📦",
		Color = Color3.fromRGB(255, 200, 70),
		Description = "Skips the crate animation and lets you open up to 20 crates at once.",
		EffectText = "Instant openings · open ×20",
		Effects = { { Stat = "extraOpen", Add = 10 } },
		SkipCrateAnimation = true,
		Op = true,
		SuggestedPrice = 499,
		GamePassId = 0,
	},
	{
		Key = "vip",
		Name = "VIP",
		Icon = "👑",
		Color = Color3.fromRGB(255, 196, 60),
		Description = "The VIP bundle: more Sparks, more Gems and faster levels.",
		EffectText = "×1.25 Sparks · ×1.25 Gems · ×1.25 XP",
		Effects = {
			{ Stat = "sparksMult", Mult = 1.25 },
			{ Stat = "gemsMult", Mult = 1.25 },
			{ Stat = "xpMult", Mult = 1.25 },
		},
		SuggestedPrice = 399,
		GamePassId = 0,
	},
} :: { Pass }

GamePasses.ByKey = {} :: { [string]: Pass }
for index, pass in ipairs(GamePasses.List) do
	pass.Order = index
	GamePasses.ByKey[pass.Key] = pass
end

-- A pass is live only once its Roblox ID has been pasted in.
function GamePasses.isConfigured(pass: Pass): boolean
	return (RobuxSale.of(pass)) ~= nil
end

local function bySale(kind: string, id: any): Pass?
	if type(id) ~= "number" or id <= 0 then
		return nil
	end
	for _, pass in ipairs(GamePasses.List) do
		local saleKind, saleId = RobuxSale.of(pass)
		if saleKind == kind and saleId == id then
			return pass
		end
	end
	return nil
end

-- The pass sold as this Roblox game pass (IDs are read live, so edits in
-- Studio or tests take effect without re-requiring the module).
function GamePasses.byGamePassId(id: any): Pass?
	return bySale("pass", id)
end

-- The pass sold as this developer product (bought once, kept forever).
function GamePasses.byProductId(id: any): Pass?
	return bySale("product", id)
end

-- Whether owned-pass data (data.Passes) includes this configured pass.
function GamePasses.owns(passes: any, key: string): boolean
	local pass = GamePasses.ByKey[key]
	return pass ~= nil and type(passes) == "table" and passes[key] == true and GamePasses.isConfigured(pass)
end

return GamePasses
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[--[[
	Items (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Items
	Depends on: Config/Rarities, Config/Chests, Config/GameConfig

	Every collectible in the game. Each item belongs to one crate pool and
	grants an equip bonus to one stat. Derived values (Bonus, SellValue) are
	computed below from the rarity and crate tier so balance stays centralised.

	Variants: every item also exists as a Golden and a Rainbow version with its
	own id ("<id>:golden", "<id>:rainbow") in Items.ById, so inventory,
	equipping and stats treat them like any other item. Items.List, the
	pools and Items.Count contain base items only (the collection book counts
	base items). Three copies fuse into the next variant; a variant sells for
	exactly as much as the copies it was made from, so fusing never makes Gems.

	Stat keys: sparks, click, luck, crit, passive, xp, gems, golden
	(see GameConfig.ItemStats for how they map onto player stats).
]]

local Rarities = require(script.Parent.Rarities)
local Chests = require(script.Parent.Chests)
local GameConfig = require(script.Parent.GameConfig)

export type Item = {
	Id: string,
	Name: string,
	Icon: string,
	Rarity: string,
	Chest: string,
	Stat: string,
	Description: string,
	-- derived
	Order: number,
	RarityIndex: number,
	Bonus: number,
	SellValue: number,
	-- variants only
	Base: string?, -- id of the normal item
	Variant: string?, -- "golden" | "rainbow"
}

export type VariantDef = {
	Id: string,
	Name: string,
	Level: number,
	Power: number, -- equip power vs. the normal item
	Sell: number, -- sell value vs. the normal item (= copies used to fuse it)
	DropChance: number, -- chance per normal crate roll
	Color: Color3,
}

local Items = {}

-- stylua: ignore
local LIST = {
	-- Spark Crate (starter) -------------------------------------------------------
	{ "paper_clip",      "Paper Clip",         "📎", "Common",    "starter", "click",   "Holds your very first presses together." },
	{ "rusty_bolt",      "Rusty Bolt",         "🔩", "Common",    "starter", "sparks",  "Squeaks with untapped potential." },
	{ "aa_battery",      "AA Battery",         "🔋", "Common",    "starter", "passive", "Slowly leaks energy into your wallet." },
	{ "light_bulb",      "Light Bulb",         "💡", "Uncommon",  "starter", "xp",      "A bright idea, every single time." },
	{ "pocket_magnet",   "Pocket Magnet",      "🧲", "Uncommon",  "starter", "luck",    "Attracts lucky drops like iron filings." },
	{ "spare_cog",       "Spare Cog",          "⚙️", "Rare",      "starter", "click",   "Part of a much bigger machine." },
	{ "floppy_disk",     "Floppy Disk",        "💾", "Rare",      "starter", "gems",    "Contains 1.44 MB of shiny data." },
	{ "arcade_stick",    "Arcade Stick",       "🕹️", "Epic",      "starter", "crit",    "Frame-perfect inputs, frame-perfect crits." },
	{ "golden_plug",     "Golden Plug",        "🔌", "Legendary", "starter", "sparks",  "Plugged straight into the grid." },
	{ "storm_jar",       "Storm in a Jar",     "🌩️", "Mythic",    "starter", "golden",  "A thunderstorm, politely contained." },
	{ "first_button",    "The First Button",   "🔴", "Secret",    "starter", "sparks",  "Where it all began. It still clicks." },
	{ "button_zero",     "Button Zero",        "🟥", "Secret",    "starter", "click",   "The prototype every other button was copied from." },

	-- Neon Crate ---------------------------------------------------------------------
	{ "headphones",      "Bass Headphones",    "🎧", "Common",    "neon", "xp",      "Bass-boosted focus." },
	{ "retro_radio",     "Retro Radio",        "📻", "Common",    "neon", "passive", "Broadcasting Sparks on every frequency." },
	{ "lucky_die",       "Lucky Die",          "🎲", "Common",    "neon", "luck",    "Always rolls just a little higher." },
	{ "puzzle_piece",    "Puzzle Piece",       "🧩", "Uncommon",  "neon", "click",   "Fits perfectly into any combo." },
	{ "neon_disc",       "Neon Disc",          "💿", "Uncommon",  "neon", "sparks",  "Spinning at 45 RPM forever." },
	{ "bullseye",        "Bullseye",           "🎯", "Rare",      "neon", "crit",    "Never misses the sweet spot." },
	{ "game_pad",        "Game Pad",           "🎮", "Rare",      "neon", "click",   "Press A to profit." },
	{ "space_invader",   "Space Invader",      "👾", "Epic",      "neon", "gems",    "Came for the Gems, stayed for the presses." },
	{ "pixel_crown",     "Pixel Crown",        "👑", "Legendary", "neon", "sparks",  "Rule the high-score table." },
	{ "neon_dragon",     "Neon Dragon",        "🐉", "Mythic",    "neon", "luck",    "Breathes pure, glowing luck." },
	{ "glitch",          "The Glitch",         "🌀", "Secret",    "neon", "golden",  "ERR_BUTTON_OVERFLOW." },
	{ "neon_cat",        "Neon Cat",           "🐈", "Secret",    "neon", "luck",    "Always lands on its feet. Usually on a Secret." },

	-- Plasma Crate -------------------------------------------------------------------
	{ "test_tube",       "Test Tube",          "🧪", "Common",    "plasma", "xp",      "Bubbling with experimental knowledge." },
	{ "microscope",      "Microscope",         "🔬", "Common",    "plasma", "luck",    "Spots lucky atoms others miss." },
	{ "petri_dish",      "Petri Dish",         "🧫", "Common",    "plasma", "passive", "Something in here is growing Sparks." },
	{ "dna_helix",       "DNA Helix",          "🧬", "Uncommon",  "plasma", "xp",      "Engineered for faster learning." },
	{ "plasma_orb",      "Plasma Orb",         "🔮", "Uncommon",  "plasma", "sparks",  "Crackles when you get close." },
	{ "fire_core",       "Fire Core",          "🔥", "Rare",      "plasma", "click",   "Every press leaves scorch marks." },
	{ "frost_core",      "Frost Core",         "❄️", "Rare",      "plasma", "crit",    "Cold, calculated, critical." },
	{ "lab_robot",       "Lab Robot",          "🤖", "Epic",      "plasma", "passive", "Presses buttons while you sleep." },
	{ "atomic_heart",    "Atomic Heart",       "⚛️", "Legendary", "plasma", "sparks",  "Splits atoms, multiplies Sparks." },
	{ "plasma_eagle",    "Plasma Eagle",       "🦅", "Mythic",    "plasma", "golden",  "Soars over golden opportunities." },
	{ "mad_button",      "The Mad Button",     "🧠", "Secret",    "plasma", "click",   "Do NOT press. (They pressed.)" },
	{ "golden_alembic",  "Golden Alembic",     "⚗️", "Secret",    "plasma", "golden",  "Distils golden presses out of thin air." },

	-- Void Crate ---------------------------------------------------------------------
	{ "void_pebble",     "Void Pebble",        "🌑", "Common",    "void", "sparks",  "Heavier than it looks." },
	{ "shadow_mask",     "Shadow Mask",        "🎭", "Common",    "void", "crit",    "Strikes from the dark." },
	{ "hourglass_void",  "Leaking Hourglass",  "⌛", "Common",    "void", "passive", "Time drips out as Sparks." },
	{ "ghost_spark",     "Ghost Spark",        "👻", "Uncommon",  "void", "luck",    "Haunts crates until they pay out." },
	{ "dark_matter",     "Dark Matter",        "🌌", "Uncommon",  "void", "xp",      "Nobody knows what it is. It helps." },
	{ "void_eye",        "Void Eye",           "🧿", "Rare",      "void", "gems",    "Stares back. Finds Gems." },
	{ "skull_relay",     "Skull Relay",        "💀", "Rare",      "void", "click",   "Dead serious about pressing." },
	{ "comet_shard",     "Comet Shard",        "☄️", "Epic",      "void", "crit",    "Burning at impact velocity." },
	{ "abyss_key",       "Abyss Key",          "🗝️", "Legendary", "void", "luck",    "Unlocks crates you did not know existed." },
	{ "eclipse",         "Eclipse",            "🌘", "Mythic",    "void", "sparks",  "When the light goes out, Sparks pour in." },
	{ "null_button",     "The Null Button",    "⚫", "Secret",    "void", "sparks",  "Pressing it presses everything." },
	{ "pocket_hole",     "Pocket Black Hole",  "🕳️", "Secret",    "void", "gems",    "Everything falls in. Gems come out." },

	-- Celestial Crate ----------------------------------------------------------------
	{ "stardust",        "Stardust",           "✨", "Common",    "celestial", "sparks",  "Collected one twinkle at a time." },
	{ "moonstone",       "Moonstone",          "🌙", "Common",    "celestial", "xp",      "Glows brighter as you learn." },
	{ "star_compass",    "Star Compass",       "🧭", "Common",    "celestial", "luck",    "Always points toward treasure." },
	{ "shooting_star",   "Shooting Star",      "🌠", "Uncommon",  "celestial", "click",   "Make a wish. Then press." },
	{ "satellite",       "Satellite",          "🛰️", "Uncommon",  "celestial", "passive", "Beams Sparks down from orbit." },
	{ "telescope",       "Telescope",          "🔭", "Rare",      "celestial", "luck",    "Sees Legendary drops light-years away." },
	{ "sun_shard",       "Sun Shard",          "☀️", "Rare",      "celestial", "sparks",  "A sliver of a star." },
	{ "ufo",             "Lost UFO",           "🛸", "Epic",      "celestial", "gems",    "Abducts Gems from other dimensions." },
	{ "galaxy_heart",    "Galaxy Heart",       "💫", "Legendary", "celestial", "click",   "Beats once per press." },
	{ "star_unicorn",    "Star Unicorn",       "🦄", "Mythic",    "celestial", "luck",    "Mythical, therefore lucky." },
	{ "star_button",     "The Star Button",    "⭐", "Secret",    "celestial", "golden",  "Pressed by constellations." },
	{ "cosmic_whale",    "Cosmic Whale",       "🐋", "Secret",    "celestial", "passive", "Swims between stars, humming in Sparks." },

	-- Singularity Core ---------------------------------------------------------------
	{ "hourglass",       "Golden Hourglass",   "⏳", "Common",    "singularity", "passive", "Time itself pays interest." },
	{ "infinity_loop",   "Infinity Loop",      "♾️", "Common",    "singularity", "sparks",  "Never ends. Never stops paying." },
	{ "quantum_bit",     "Quantum Bit",        "💠", "Common",    "singularity", "luck",    "Both lucky and unlucky until observed." },
	{ "rocket",          "Rocket Booster",     "🚀", "Uncommon",  "singularity", "click",   "Presses at escape velocity." },
	{ "prism_shard",     "Prism Shard",        "🔷", "Uncommon",  "singularity", "gems",    "Refracts presses into Gems." },
	{ "supernova",       "Supernova",          "💥", "Rare",      "singularity", "crit",    "One press. Total annihilation." },
	{ "rainbow_bridge",  "Rainbow Bridge",     "🌈", "Rare",      "singularity", "xp",      "A shortcut to the next level." },
	{ "time_crystal",    "Time Crystal",       "🔶", "Epic",      "singularity", "passive", "Earns tomorrow's Sparks today." },
	{ "singular_crown",  "Singularity Crown",  "🏆", "Legendary", "singularity", "sparks",  "For those who pressed beyond infinity." },
	{ "world_serpent",   "World Serpent",      "🐲", "Mythic",    "singularity", "click",   "Coils around the universe, pressing." },
	{ "final_button",    "The Final Button",   "🔘", "Secret",    "singularity", "sparks",  "There is nothing after this. Or is there?" },
	{ "big_bang",        "The Big Bang",       "🎆", "Secret",    "singularity", "click",   "Pressed once. Everything else followed." },

	-- Prism Cache (Gems) --------------------------------------------------------------
	{ "prism_lens",      "Prism Lens",         "🔍", "Rare",      "prism", "luck",    "Splits light into pure luck." },
	{ "gem_core",        "Gem Core",           "💎", "Rare",      "prism", "gems",    "The heart of every Gem." },
	{ "fortune_clover",  "Fortune Clover",     "🍀", "Epic",      "prism", "luck",    "Four leaves, infinite luck." },
	{ "treasure_key",    "Treasure Key",       "🔑", "Epic",      "prism", "golden",  "Opens golden opportunities." },
	{ "royal_shield",    "Royal Shield",       "🛡️", "Legendary", "prism", "crit",    "Deflects anything that is not a crit." },
	{ "crystal_sword",   "Crystal Sword",      "⚔️", "Legendary", "prism", "click",   "Cuts through any price tag." },
	{ "prism_heart",     "Prismatic Heart",    "💖", "Mythic",    "prism", "sparks",  "Loves you back in Sparks." },
	{ "sage_button",     "The Sage Button",    "🌟", "Secret",    "prism", "xp",      "Knows every press you will ever make." },
	{ "prism_peacock",   "Prism Peacock",      "🦚", "Secret",    "prism", "gems",    "Fans out every colour of the Gem spectrum." },
}

Items.List = {} :: { Item }
Items.ById = {} :: { [string]: Item }
-- PoolByChest[chestId][rarityId] = { itemId, ... }
Items.PoolByChest = {} :: { [string]: { [string]: { string } } }
Items.Count = 0

for index, row in ipairs(LIST) do
	local id, name, icon, rarityId, chestId, stat, description = table.unpack(row)
	local rarity = Rarities.ById[rarityId]
	local chest = Chests.ById[chestId]
	local statDef = GameConfig.ItemStats[stat]
	assert(rarity, "Unknown rarity for item " .. id)
	assert(chest, "Unknown chest for item " .. id)
	assert(statDef, "Unknown stat for item " .. id)
	assert(Items.ById[id] == nil, "Duplicate item id " .. id)

	local item: Item = {
		Id = id,
		Name = name,
		Icon = icon,
		Rarity = rarityId,
		Chest = chestId,
		Stat = stat,
		Description = description,
		Order = index,
		RarityIndex = rarity.Index,
		Bonus = rarity.Bonus * chest.TierFactor * statDef.Factor,
		SellValue = math.max(1, math.floor(rarity.SellGems * (chest.SellFactor or chest.TierFactor) + 0.5)),
	}
	table.insert(Items.List, item)
	Items.ById[id] = item
	Items.Count += 1

	local pool = Items.PoolByChest[chestId]
	if not pool then
		pool = {}
		Items.PoolByChest[chestId] = pool
	end
	pool[rarityId] = pool[rarityId] or {}
	table.insert(pool[rarityId], id)
end

-- Sanity check: every weighted rarity in every crate must have at least one item.
for _, chest in ipairs(Chests.List) do
	for rarityId, weight in pairs(chest.Weights) do
		if weight > 0 then
			local pool = Items.PoolByChest[chest.Id]
			assert(pool and pool[rarityId] and #pool[rarityId] > 0, `Crate {chest.Id} has no {rarityId} items`)
		end
	end
end

-- Variants ---------------------------------------------------------------------------

-- Copies of one item (and variant) needed to fuse one of the next variant.
Items.FuseCost = 3

Items.Variants = {
	{ Id = "golden", Name = "Golden", Level = 2, Power = 2.5, Sell = 3, DropChance = 0.015, Color = Color3.fromRGB(255, 205, 64) },
	{ Id = "rainbow", Name = "Rainbow", Level = 3, Power = 6, Sell = 9, DropChance = 0.0015, Color = Color3.fromRGB(255, 120, 220) },
} :: { VariantDef }
Items.VariantById = {} :: { [string]: VariantDef }
for _, variant in ipairs(Items.Variants) do
	Items.VariantById[variant.Id] = variant
end

-- Id of an item's variant ("paper_clip", "golden" -> "paper_clip:golden"); nil variant = normal.
function Items.variantId(baseId: string, variant: string?): string
	return if variant then baseId .. ":" .. variant else baseId
end

for _, base in ipairs(table.clone(Items.List)) do
	for _, variant in ipairs(Items.Variants) do
		local id = Items.variantId(base.Id, variant.Id)
		Items.ById[id] = {
			Id = id,
			Name = `{variant.Name} {base.Name}`,
			Icon = base.Icon,
			Rarity = base.Rarity,
			Chest = base.Chest,
			Stat = base.Stat,
			Description = base.Description,
			Order = base.Order,
			RarityIndex = base.RarityIndex,
			Bonus = base.Bonus * variant.Power,
			SellValue = base.SellValue * variant.Sell,
			Base = base.Id,
			Variant = variant.Id,
		}
	end
end

-- The normal item an id belongs to (itself for normal items).
function Items.baseOf(id: string): string
	local item = Items.ById[id]
	return if item and item.Base then item.Base else id
end

-- Variant level: 1 normal, 2 golden, 3 rainbow.
function Items.variantLevel(id: string): number
	local item = Items.ById[id]
	local variant = item and item.Variant and Items.VariantById[item.Variant]
	return if variant then variant.Level else 1
end

-- The id three copies of `id` fuse into, or nil when it is already Rainbow.
function Items.fuseResult(id: string): string?
	local item = Items.ById[id]
	if not item then
		return nil
	end
	local level = Items.variantLevel(id)
	local nextVariant = Items.Variants[level] -- Variants[1] is golden (level 2)
	if not nextVariant then
		return nil
	end
	return Items.variantId(Items.baseOf(id), nextVariant.Id)
end

function Items.get(id: string): Item?
	return Items.ById[id]
end

return Items
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Obby</string>
            <string name="Source"><![CDATA[--[[
	Obby (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Obby

	Configuration for the obstacle course next to the plaza. The course itself
	is built by ServerScriptService/Services/ObbyService. Players keep earning
	from auto-presses and passive income while they run it.

	Progress (saved per player, written only by the server):
	  Stage        checkpoints cleared in the current run (0 = not started)
	  Best         furthest stage ever cleared
	  Completions  finished runs
	  Checkpoints  checkpoints reached in total (used by the tutorial)

	Rewards are paid ONLY by the server, in Sparks worth a number of base
	presses (so they keep up with progression) plus Gems for first clears.
]]

local Obby = {}

Obby.StageCount = 15

Obby.StageNames = {
	"First Steps",
	"Stairway",
	"Hot Floor",
	"Tightrope",
	"Ferry",
	"Spinner",
	"Zigzag",
	"Ladder",
	"Elevators",
	"Islands",
	"Double Spin",
	"Leap of Faith",
	"Needle",
	"Lava Ferry",
	"Summit",
}

-- Rewards ---------------------------------------------------------------------------------
Obby.Rewards = {
	-- Sparks for each checkpoint in a run: base press value × presses × stage number.
	CheckpointPresses = 25,
	-- Gems the first time a stage is ever cleared; every 5th stage pays the milestone amount.
	FirstClearGems = 5,
	MilestoneGems = 25,
	-- Finishing a run.
	FinishPresses = 600,
	FinishGems = 10,
	FirstFinishGems = 100,
	-- Extra Gems when the total number of completions reaches these values.
	CompletionMilestones = { [5] = 50, [10] = 100, [25] = 250, [50] = 500 },
}

-- Anti-cheat ---------------------------------------------------------------------------------
Obby.AntiCheat = {
	-- How often the server samples character positions (seconds).
	SampleInterval = 0.1,
	-- A checkpoint only counts if the run from the previous one took at least
	-- distance / MaxTravelSpeed seconds (and never less than MinSegmentSeconds).
	MaxTravelSpeed = 45,
	MinSegmentSeconds = 2,
	-- Moving further than this between two samples (not caused by the server) is
	-- treated as a teleport: progress is ignored for SuspectSeconds and flagged.
	TeleportDistance = 40,
	SuspectSeconds = 4,
	-- Falling this far below your checkpoint sends you back to it.
	VoidDepth = 30,
}

-- The "Go to obby" / "Back to plaza" buttons.
Obby.TeleportRate = { Capacity = 2, Refill = 0.25 }

return Obby
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[--[[
	Quests (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Quests

	Two kinds of quests:
	  * Daily quests: DailyCount quests are drawn from the Daily pool each UTC day
	    (deterministically per player). Targets scale with the player's progress.
	  * Starter path: a fixed sequence that teaches the core loop to new players.

	Kinds (progress events reported by server services):
	  Clicks, Crits, ChestsOpened, UpgradesBought, Combo (max value), GoldenClicks,
	  OrbsCollected, ItemsSold, SparksEarned, PlayMinutes.
	Check kinds (evaluated against current data, starter path only):
	  ReachLevel, RunSparks, Equip, SkillUnlocked, Rebirth.

	Reward fields: Sparks, Gems, SkillPoints, Prisms, Chests = { [id] = n }
]]

local Quests = {}

Quests.DailyCount = 3

-- Target = ceil(Base * (1 + ScalePerRebirth * min(rebirths, 20))) for normal quests.
-- Quests with ClickScaled = true use Base * current click value (snapshotted).
Quests.Daily = {
	{ Id = "press", Kind = "Clicks", Text = "Press the button %s times", Base = 400, ScalePerRebirth = 0.15, Reward = { Gems = 15 } },
	{ Id = "crits", Kind = "Crits", Text = "Land %s critical presses", Base = 30, ScalePerRebirth = 0.15, Reward = { Gems = 15 } },
	{ Id = "crates", Kind = "ChestsOpened", Text = "Open %s crates", Base = 6, ScalePerRebirth = 0.1, Reward = { Gems = 20 } },
	{ Id = "upgrades", Kind = "UpgradesBought", Text = "Buy %s upgrade levels", Base = 12, ScalePerRebirth = 0.05, Reward = { Gems = 15 } },
	{ Id = "combo", Kind = "Combo", Text = "Reach a %s press combo", Base = 60, ScalePerRebirth = 0.1, Reward = { Gems = 20 }, Max = 400 },
	{ Id = "golden", Kind = "GoldenClicks", Text = "Trigger %s golden presses", Base = 1, ScalePerRebirth = 0.05, Reward = { Gems = 25 } },
	{ Id = "orbs", Kind = "OrbsCollected", Text = "Collect %s bonus orbs", Base = 2, ScalePerRebirth = 0.05, Reward = { Gems = 20 } },
	{ Id = "sell", Kind = "ItemsSold", Text = "Sell %s items", Base = 5, ScalePerRebirth = 0.1, Reward = { Gems = 10, Chests = { starter = 2 } } },
	{ Id = "earn", Kind = "SparksEarned", Text = "Earn %s Sparks", Base = 1500, ClickScaled = true, Reward = { Gems = 20 } },
	{ Id = "playtime", Kind = "PlayMinutes", Text = "Play for %s minutes", Base = 15, ScalePerRebirth = 0, Reward = { Gems = 15, Chests = { neon = 1 } } },
}

-- Bonus for completing (claiming) every daily quest.
Quests.DailyBonus = { Gems = 40, Chests = { prism = 1 } }

Quests.Starter = {
	{ Id = "s_press", Kind = "Clicks", Text = "Press the button 25 times", Target = 25, Reward = { Sparks = 100 } },
	{ Id = "s_upgrade", Kind = "UpgradesBought", Text = "Buy your first upgrade in the Shop", Target = 1, Reward = { Chests = { starter = 1 } } },
	{ Id = "s_crate", Kind = "ChestsOpened", Text = "Open a crate", Target = 1, Reward = { Gems = 10 } },
	{ Id = "s_equip", Kind = "Equip", Text = "Equip an item from your Inventory", Target = 1, Reward = { Chests = { starter = 2 } } },
	{ Id = "s_level", Kind = "ReachLevel", Text = "Reach level 5", Target = 5, Reward = { SkillPoints = 1 } },
	{ Id = "s_skill", Kind = "SkillUnlocked", Text = "Unlock a skill in the Skill Tree", Target = 1, Reward = { Gems = 20 } },
	{ Id = "s_combo", Kind = "Combo", Text = "Reach a 50 press combo", Target = 50, Reward = { Chests = { neon = 1 } } },
	{ Id = "s_orb", Kind = "OrbsCollected", Text = "Tap a bonus orb when it appears", Target = 1, Reward = { Gems = 15 } },
	{ Id = "s_run", Kind = "RunSparks", Text = "Earn 1M Sparks in this run", Target = 1e6, Reward = { Gems = 50 } },
	{ Id = "s_ascend", Kind = "Rebirth", Text = "Ascend for the first time", Target = 1, Reward = { Gems = 100, Chests = { prism = 1 } } },
}

Quests.DailyById = {}
for _, q in ipairs(Quests.Daily) do
	Quests.DailyById[q.Id] = q
end
Quests.StarterById = {}
for index, q in ipairs(Quests.Starter) do
	q.Index = index
	Quests.StarterById[q.Id] = q
end

-- Kinds whose progress keeps the highest value instead of summing.
Quests.MaxKinds = { Combo = true }
-- Kinds evaluated from current data instead of events (starter path only).
Quests.CheckKinds = { ReachLevel = true, RunSparks = true, Equip = true, SkillUnlocked = true, Rebirth = true }

return Quests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Rarities</string>
            <string name="Source"><![CDATA[--[[
	Rarities (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Rarities

	Rarity tiers in ascending order. Index is used for comparisons, luck scaling
	and sorting. SellGems and Bonus are the base values for tier-1 items; crate
	tier multipliers are applied in Items.
]]

export type Rarity = {
	Id: string,
	Index: number,
	Name: string,
	Color: Color3,
	Glow: Color3,
	SellGems: number,
	Bonus: number,
	LuckPower: number,
}

local Rarities = {}

Rarities.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }

Rarities.ById = {
	Common = {
		Id = "Common",
		Index = 1,
		Name = "Common",
		Color = Color3.fromRGB(176, 186, 204),
		Glow = Color3.fromRGB(120, 130, 150),
		SellGems = 1,
		Bonus = 0.02,
		LuckPower = 0,
	},
	Uncommon = {
		Id = "Uncommon",
		Index = 2,
		Name = "Uncommon",
		Color = Color3.fromRGB(74, 222, 128),
		Glow = Color3.fromRGB(30, 140, 70),
		SellGems = 3,
		Bonus = 0.04,
		LuckPower = 0.2,
	},
	Rare = {
		Id = "Rare",
		Index = 3,
		Name = "Rare",
		Color = Color3.fromRGB(64, 156, 255),
		Glow = Color3.fromRGB(20, 80, 190),
		SellGems = 8,
		Bonus = 0.08,
		LuckPower = 0.5,
	},
	Epic = {
		Id = "Epic",
		Index = 4,
		Name = "Epic",
		Color = Color3.fromRGB(176, 92, 255),
		Glow = Color3.fromRGB(100, 30, 190),
		SellGems = 25,
		Bonus = 0.15,
		LuckPower = 0.8,
	},
	Legendary = {
		Id = "Legendary",
		Index = 5,
		Name = "Legendary",
		Color = Color3.fromRGB(255, 180, 40),
		Glow = Color3.fromRGB(200, 110, 0),
		SellGems = 100,
		Bonus = 0.3,
		LuckPower = 1.0,
	},
	Mythic = {
		Id = "Mythic",
		Index = 6,
		Name = "Mythic",
		Color = Color3.fromRGB(255, 64, 112),
		Glow = Color3.fromRGB(190, 0, 60),
		SellGems = 500,
		Bonus = 0.6,
		LuckPower = 1.1,
	},
	Secret = {
		Id = "Secret",
		Index = 7,
		Name = "Secret",
		Color = Color3.fromRGB(255, 255, 255),
		Glow = Color3.fromRGB(255, 120, 255),
		SellGems = 3000,
		Bonus = 1.5,
		LuckPower = 0.6,
	},
}

-- Rainbow used to render Secret items.
Rarities.SecretGradient = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 120)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 210, 80)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 255, 170)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 100, 255)),
})

function Rarities.get(id: string): Rarity?
	return Rarities.ById[id]
end

function Rarities.index(id: string): number
	local r = Rarities.ById[id]
	return if r then r.Index else 0
end

function Rarities.byIndex(index: number): Rarity?
	local id = Rarities.Order[index]
	return if id then Rarities.ById[id] else nil
end

return Rarities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--[[
	Rewards (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Rewards

	Daily login rewards and collection-book milestones.

	Daily rewards follow a 7-day cycle. Claiming on consecutive UTC days grows
	the streak; missing a day resets it to day 1.

	Collection milestones are claimed manually once enough unique items have
	been discovered. Reward fields: Sparks, Gems, SkillPoints, Prisms,
	Chests = { [id] = n }
]]

local Rewards = {}

Rewards.Daily = {
	{ Day = 1, Text = "15 Gems", Reward = { Gems = 15 } },
	{ Day = 2, Text = "2 Spark Crates", Reward = { Chests = { starter = 2 } } },
	{ Day = 3, Text = "30 Gems", Reward = { Gems = 30 } },
	{ Day = 4, Text = "2 Neon Crates", Reward = { Chests = { neon = 2 } } },
	{ Day = 5, Text = "50 Gems + 1 Skill Point", Reward = { Gems = 50, SkillPoints = 1 } },
	{ Day = 6, Text = "3 Neon Crates", Reward = { Chests = { neon = 3 } } },
	{ Day = 7, Text = "100 Gems + 2 Skill Points + Prism Cache", Reward = { Gems = 100, SkillPoints = 2, Chests = { prism = 1 } } },
}

Rewards.Collection = {
	{ Id = "col_5", Count = 5, Text = "20 Gems", Reward = { Gems = 20 } },
	{ Id = "col_10", Count = 10, Text = "1 Skill Point + 2 Neon Crates", Reward = { SkillPoints = 1, Chests = { neon = 2 } } },
	{ Id = "col_20", Count = 20, Text = "75 Gems + Prism Cache", Reward = { Gems = 75, Chests = { prism = 1 } } },
	{ Id = "col_30", Count = 30, Text = "2 Skill Points", Reward = { SkillPoints = 2 } },
	{ Id = "col_40", Count = 40, Text = "200 Gems + 2 Prism Caches", Reward = { Gems = 200, Chests = { prism = 2 } } },
	{ Id = "col_50", Count = 50, Text = "3 Skill Points + 5 Prisms", Reward = { SkillPoints = 3, Prisms = 5 } },
	{ Id = "col_60", Count = 60, Text = "500 Gems + 3 Prism Caches", Reward = { Gems = 500, Chests = { prism = 3 } } },
	{ Id = "col_all", Count = -1, Text = "5 Skill Points + 25 Prisms", Reward = { SkillPoints = 5, Prisms = 25 } },
}

Rewards.CollectionById = {}
for _, m in ipairs(Rewards.Collection) do
	Rewards.CollectionById[m.Id] = m
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Skills</string>
            <string name="Source"><![CDATA[--[[
	Skills (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Skills

	The skill tree. Nodes are placed on a grid (X right, Y down; the core is 0,0).
	Skill Points come from levelling up, achievements and collection milestones.
	Skills are permanent: they are NOT reset by Ascension (a Gem-priced respec
	refunds every point).

	Layout: four main branches grow outward from the core (Strength up,
	Fortune right, Wealth down, Precision left), each ending in a capstone and,
	further out, an ascended capstone ("_cap2"). Bridge nodes sit between two
	branches near the core, and Special nodes grow along the diagonals.

	The tree reveals itself as it is bought (see Skills.visibility): only the
	core, owned nodes and nodes whose prerequisites are met are shown in full;
	the next ring appears as "?" silhouettes and everything further out stays
	hidden until the player gets closer.

	Requires    = every listed node needs at least rank 1
	RequiresAny = at least one listed node needs rank 1
	Cost        = Skill Points for rank 1; each further rank costs Cost + CostStep * rank
	Effects     = per rank: { Stat, Add = n } adds n per rank; { Stat, Mult = n } multiplies by n per rank
]]

export type SkillEffect = { Stat: string, Add: number?, Mult: number? }
export type SkillNode = {
	Id: string,
	Name: string,
	Icon: string,
	Branch: string,
	Description: string,
	X: number,
	Y: number,
	MaxRank: number,
	Cost: number,
	CostStep: number,
	Requires: { string },
	RequiresAny: { string },
	Effects: { SkillEffect },
}

local Skills = {}

Skills.Branches = {
	Core = { Name = "Core", Color = Color3.fromRGB(255, 255, 255) },
	Strength = { Name = "Strength", Color = Color3.fromRGB(255, 92, 92) },
	Fortune = { Name = "Fortune", Color = Color3.fromRGB(74, 222, 128) },
	Wealth = { Name = "Wealth", Color = Color3.fromRGB(255, 205, 64) },
	Precision = { Name = "Precision", Color = Color3.fromRGB(80, 170, 255) },
	Special = { Name = "Special", Color = Color3.fromRGB(196, 125, 255) },
}

local function node(t)
	t.Requires = t.Requires or {}
	t.RequiresAny = t.RequiresAny or {}
	t.CostStep = t.CostStep or 0
	return t
end

Skills.List = {
	node({ Id = "core", Name = "Awakening", Icon = "✦", Branch = "Core", X = 0, Y = 0, MaxRank = 1, Cost = 1,
		Description = "+10% Sparks. The first step of every button legend.",
		Effects = { { Stat = "sparksPct", Add = 0.1 } } }),

	-- Strength (up) ----------------------------------------------------------------
	node({ Id = "str_1", Name = "Firm Press", Icon = "👊", Branch = "Strength", X = 0, Y = -1, MaxRank = 5, Cost = 1,
		Requires = { "core" }, Description = "+15% Click Power per rank.",
		Effects = { { Stat = "clickPct", Add = 0.15 } } }),
	node({ Id = "str_2", Name = "Heavy Hands", Icon = "🦍", Branch = "Strength", X = 0, Y = -2, MaxRank = 3, Cost = 2,
		Requires = { "str_1" }, Description = "+25% Click Power per rank.",
		Effects = { { Stat = "clickPct", Add = 0.25 } } }),
	node({ Id = "str_3", Name = "Combo Engine", Icon = "🔗", Branch = "Strength", X = -1, Y = -2, MaxRank = 2, Cost = 2,
		Requires = { "str_1" }, Description = "+50 combo cap per rank.",
		Effects = { { Stat = "comboCap", Add = 50 } } }),
	node({ Id = "str_4", Name = "Momentum", Icon = "⏱️", Branch = "Strength", X = 1, Y = -2, MaxRank = 2, Cost = 2,
		Requires = { "str_1" }, Description = "+0.3s combo window per rank.",
		Effects = { { Stat = "comboWindow", Add = 0.3 } } }),
	node({ Id = "str_5", Name = "Titan Grip", Icon = "🗿", Branch = "Strength", X = 0, Y = -3, MaxRank = 1, Cost = 4,
		Requires = { "str_2" }, Description = "Click Power ×1.5.",
		Effects = { { Stat = "clickMult", Mult = 1.5 } } }),
	node({ Id = "str_6", Name = "Streak Master", Icon = "🔥", Branch = "Strength", X = -1, Y = -3, MaxRank = 2, Cost = 3,
		Requires = { "str_3" }, Description = "+100% streak burst rewards per rank.",
		Effects = { { Stat = "streakPct", Add = 1.0 } } }),
	node({ Id = "str_cap", Name = "Button Crusher", Icon = "💢", Branch = "Strength", X = 0, Y = -4, MaxRank = 1, Cost = 8,
		Requires = { "str_5" }, Description = "Click Power ×2. The button fears you.",
		Effects = { { Stat = "clickMult", Mult = 2 } } }),

	-- Fortune (right) --------------------------------------------------------------
	node({ Id = "luck_1", Name = "Four-Leaf", Icon = "🍀", Branch = "Fortune", X = 1, Y = 0, MaxRank = 5, Cost = 1,
		Requires = { "core" }, Description = "+10% Luck per rank.",
		Effects = { { Stat = "luck", Add = 0.1 } } }),
	node({ Id = "luck_2", Name = "Treasure Nose", Icon = "👃", Branch = "Fortune", X = 2, Y = 0, MaxRank = 3, Cost = 2,
		Requires = { "luck_1" }, Description = "+3% bonus item chance from Spark crates per rank.",
		Effects = { { Stat = "chestBonus", Add = 0.03 } } }),
	node({ Id = "luck_3", Name = "Rare Instinct", Icon = "🔎", Branch = "Fortune", X = 2, Y = -1, MaxRank = 3, Cost = 2,
		Requires = { "luck_1" }, Description = "+20% Luck per rank.",
		Effects = { { Stat = "luck", Add = 0.2 } } }),
	node({ Id = "luck_4", Name = "Crate Connoisseur", Icon = "🏷️", Branch = "Fortune", X = 3, Y = 0, MaxRank = 3, Cost = 2,
		Requires = { "luck_2" }, Description = "-5% Spark crate prices per rank.",
		Effects = { { Stat = "chestDiscount", Add = 0.05 } } }),
	node({ Id = "luck_5", Name = "Golden Touch", Icon = "🌟", Branch = "Fortune", X = 2, Y = 1, MaxRank = 3, Cost = 2,
		Requires = { "luck_1" }, Description = "+25% golden press chance per rank.",
		Effects = { { Stat = "goldenPct", Add = 0.25 } } }),
	node({ Id = "luck_6", Name = "Pity Breaker", Icon = "🧿", Branch = "Fortune", X = 3, Y = -1, MaxRank = 2, Cost = 3,
		Requires = { "luck_3" }, Description = "Crate pity triggers 10% sooner per rank.",
		Effects = { { Stat = "pityReduction", Add = 0.1 } } }),
	node({ Id = "luck_cap", Name = "Fortune's Favorite", Icon = "🎰", Branch = "Fortune", X = 4, Y = 0, MaxRank = 1, Cost = 8,
		Requires = { "luck_4", "luck_6" }, Description = "+75% Luck and +5% Spark crate bonus item chance.",
		Effects = { { Stat = "luck", Add = 0.75 }, { Stat = "chestBonus", Add = 0.05 } } }),

	-- Wealth (down) -----------------------------------------------------------------
	node({ Id = "wealth_1", Name = "Pocket Change", Icon = "💰", Branch = "Wealth", X = 0, Y = 1, MaxRank = 5, Cost = 1,
		Requires = { "core" }, Description = "+10% Sparks per rank.",
		Effects = { { Stat = "sparksPct", Add = 0.1 } } }),
	node({ Id = "wealth_2", Name = "Dynamo", Icon = "🔋", Branch = "Wealth", X = 0, Y = 2, MaxRank = 4, Cost = 1,
		Requires = { "wealth_1" }, Description = "+25% passive income per rank.",
		Effects = { { Stat = "passivePct", Add = 0.25 } } }),
	node({ Id = "wealth_3", Name = "Gem Polisher", Icon = "💎", Branch = "Wealth", X = 1, Y = 2, MaxRank = 3, Cost = 2,
		Requires = { "wealth_1" }, Description = "+15% Gems from every source per rank.",
		Effects = { { Stat = "gemsPct", Add = 0.15 } } }),
	node({ Id = "wealth_4", Name = "Night Shift", Icon = "🌙", Branch = "Wealth", X = -1, Y = 2, MaxRank = 2, Cost = 2,
		Requires = { "wealth_1" }, Description = "+2 hours offline earnings and +10% offline rate per rank.",
		Effects = { { Stat = "offlineHours", Add = 2 }, { Stat = "offlineRate", Add = 0.1 } } }),
	node({ Id = "wealth_5", Name = "Overclock", Icon = "⚙️", Branch = "Wealth", X = 0, Y = 3, MaxRank = 3, Cost = 3,
		Requires = { "wealth_2" }, Description = "+1 auto press per second per rank.",
		Effects = { { Stat = "autoRate", Add = 1 } } }),
	node({ Id = "wealth_cap", Name = "Golden Economy", Icon = "🏦", Branch = "Wealth", X = 0, Y = 4, MaxRank = 1, Cost = 8,
		Requires = { "wealth_5" }, Description = "All Sparks ×1.75.",
		Effects = { { Stat = "sparksMult", Mult = 1.75 } } }),

	-- Precision (left) ---------------------------------------------------------------
	node({ Id = "crit_1", Name = "Steady Aim", Icon = "🎯", Branch = "Precision", X = -1, Y = 0, MaxRank = 5, Cost = 1,
		Requires = { "core" }, Description = "+2% Crit Chance per rank.",
		Effects = { { Stat = "critChance", Add = 0.02 } } }),
	node({ Id = "crit_2", Name = "Overload", Icon = "⚡", Branch = "Precision", X = -2, Y = 0, MaxRank = 4, Cost = 2,
		Requires = { "crit_1" }, Description = "+0.5× crit multiplier per rank.",
		Effects = { { Stat = "critPower", Add = 0.5 } } }),
	node({ Id = "crit_3", Name = "Critical Mass", Icon = "☢️", Branch = "Precision", X = -2, Y = -1, MaxRank = 3, Cost = 2,
		Requires = { "crit_1" }, Description = "+3% Crit Chance per rank.",
		Effects = { { Stat = "critChance", Add = 0.03 } } }),
	node({ Id = "crit_4", Name = "Lethal Precision", Icon = "🗡️", Branch = "Precision", X = -3, Y = 0, MaxRank = 1, Cost = 4,
		Requires = { "crit_2" }, Description = "+1.5× crit multiplier.",
		Effects = { { Stat = "critPower", Add = 1.5 } } }),
	node({ Id = "crit_cap", Name = "Supercritical", Icon = "💥", Branch = "Precision", X = -4, Y = 0, MaxRank = 1, Cost = 8,
		Requires = { "crit_4", "crit_3" }, Description = "+10% Crit Chance and +2× crit multiplier.",
		Effects = { { Stat = "critChance", Add = 0.1 }, { Stat = "critPower", Add = 2 } } }),

	-- Special (diagonals) ------------------------------------------------------------
	node({ Id = "spec_slot", Name = "Collector's Satchel", Icon = "🎒", Branch = "Special", X = 2, Y = 2, MaxRank = 2, Cost = 4, CostStep = 2,
		RequiresAny = { "wealth_3", "luck_5" }, Description = "+1 equip slot per rank.",
		Effects = { { Stat = "equipSlots", Add = 1 } } }),
	node({ Id = "spec_xp", Name = "Fast Learner", Icon = "📘", Branch = "Special", X = -2, Y = 2, MaxRank = 4, Cost = 1,
		RequiresAny = { "wealth_4", "crit_2" }, Description = "+25% XP per rank.",
		Effects = { { Stat = "xpPct", Add = 0.25 } } }),
	node({ Id = "spec_prism", Name = "Prism Attunement", Icon = "🔷", Branch = "Special", X = -2, Y = -2, MaxRank = 3, Cost = 3,
		RequiresAny = { "str_3", "crit_3" }, Description = "+15% Prisms per ascension per rank.",
		Effects = { { Stat = "prismPct", Add = 0.15 } } }),
	node({ Id = "spec_orb", Name = "Orb Magnet", Icon = "🔮", Branch = "Special", X = 2, Y = -2, MaxRank = 2, Cost = 2,
		RequiresAny = { "str_4", "luck_3" }, Description = "Bonus orbs appear 20% more often and give +25% rewards per rank.",
		Effects = { { Stat = "orbRate", Add = 0.2 }, { Stat = "orbPct", Add = 0.25 } } }),

	-- Bridges (between two branches, next to the core) -------------------------------
	node({ Id = "bridge_sl", Name = "Lucky Punch", Icon = "🥊", Branch = "Special", X = 1, Y = -1, MaxRank = 2, Cost = 2, CostStep = 1,
		Requires = { "str_1", "luck_1" }, Description = "+10% Click Power and +15% golden press chance per rank.",
		Effects = { { Stat = "clickPct", Add = 0.1 }, { Stat = "goldenPct", Add = 0.15 } } }),
	node({ Id = "bridge_sc", Name = "Precise Strikes", Icon = "🎳", Branch = "Special", X = -1, Y = -1, MaxRank = 2, Cost = 2, CostStep = 1,
		Requires = { "str_1", "crit_1" }, Description = "+10% Click Power and +1% Crit Chance per rank.",
		Effects = { { Stat = "clickPct", Add = 0.1 }, { Stat = "critChance", Add = 0.01 } } }),
	node({ Id = "bridge_wl", Name = "Fortune Flow", Icon = "🌊", Branch = "Special", X = 1, Y = 1, MaxRank = 2, Cost = 2, CostStep = 1,
		Requires = { "wealth_1", "luck_1" }, Description = "+10% Sparks and +15% passive income per rank.",
		Effects = { { Stat = "sparksPct", Add = 0.1 }, { Stat = "passivePct", Add = 0.15 } } }),
	node({ Id = "bridge_wc", Name = "Steady Income", Icon = "📈", Branch = "Special", X = -1, Y = 1, MaxRank = 2, Cost = 2, CostStep = 1,
		Requires = { "wealth_1", "crit_1" }, Description = "+15% passive income and +10% XP per rank.",
		Effects = { { Stat = "passivePct", Add = 0.15 }, { Stat = "xpPct", Add = 0.1 } } }),

	-- Strength, outer ring (up) --------------------------------------------------------
	node({ Id = "str_7", Name = "Rhythm Keeper", Icon = "🥁", Branch = "Strength", X = 1, Y = -3, MaxRank = 2, Cost = 2, CostStep = 1,
		Requires = { "str_4" }, Description = "+0.2s combo window per rank.",
		Effects = { { Stat = "comboWindow", Add = 0.2 } } }),
	node({ Id = "str_8", Name = "Endless Chain", Icon = "⛓️", Branch = "Strength", X = -1, Y = -4, MaxRank = 2, Cost = 3, CostStep = 1,
		Requires = { "str_6" }, Description = "+100 combo cap per rank.",
		Effects = { { Stat = "comboCap", Add = 100 } } }),
	node({ Id = "str_10", Name = "Aftershock", Icon = "🌋", Branch = "Strength", X = 1, Y = -4, MaxRank = 2, Cost = 3, CostStep = 1,
		Requires = { "str_7" }, Description = "+150% streak burst rewards per rank.",
		Effects = { { Stat = "streakPct", Add = 1.5 } } }),
	node({ Id = "str_9", Name = "Iron Knuckles", Icon = "🦾", Branch = "Strength", X = 0, Y = -5, MaxRank = 3, Cost = 3, CostStep = 1,
		Requires = { "str_cap" }, Description = "+50% Click Power per rank.",
		Effects = { { Stat = "clickPct", Add = 0.5 } } }),
	node({ Id = "str_11", Name = "Overdrive", Icon = "🚀", Branch = "Strength", X = -1, Y = -5, MaxRank = 1, Cost = 6,
		Requires = { "str_8" }, Description = "Click Power ×1.25.",
		Effects = { { Stat = "clickMult", Mult = 1.25 } } }),
	node({ Id = "str_12", Name = "Unbreakable", Icon = "🛡️", Branch = "Strength", X = 0, Y = -6, MaxRank = 1, Cost = 8,
		Requires = { "str_9", "str_11" }, Description = "Click Power ×1.5.",
		Effects = { { Stat = "clickMult", Mult = 1.5 } } }),
	node({ Id = "str_cap2", Name = "Earthshaker", Icon = "🌍", Branch = "Strength", X = 0, Y = -7, MaxRank = 1, Cost = 12,
		Requires = { "str_12" }, Description = "Click Power ×2.5 and +200% streak bursts. Every press shakes the world.",
		Effects = { { Stat = "clickMult", Mult = 2.5 }, { Stat = "streakPct", Add = 2 } } }),

	-- Fortune, outer ring (right) -------------------------------------------------------
	node({ Id = "luck_7", Name = "Gilded Fingers", Icon = "🪙", Branch = "Fortune", X = 3, Y = 1, MaxRank = 3, Cost = 2, CostStep = 1,
		Requires = { "luck_5" }, Description = "+25% golden press chance per rank.",
		Effects = { { Stat = "goldenPct", Add = 0.25 } } }),
	node({ Id = "luck_8", Name = "Second Chance", Icon = "🎲", Branch = "Fortune", X = 4, Y = -1, MaxRank = 2, Cost = 3, CostStep = 1,
		Requires = { "luck_6" }, Description = "Crate pity triggers 5% sooner per rank.",
		Effects = { { Stat = "pityReduction", Add = 0.05 } } }),
	node({ Id = "luck_10", Name = "Bargain Sense", Icon = "🛍️", Branch = "Fortune", X = 5, Y = 0, MaxRank = 2, Cost = 4, CostStep = 1,
		Requires = { "luck_cap" }, Description = "-5% Spark crate prices per rank.",
		Effects = { { Stat = "chestDiscount", Add = 0.05 } } }),
	node({ Id = "luck_11", Name = "Bonus Hunter", Icon = "🧲", Branch = "Fortune", X = 5, Y = -1, MaxRank = 2, Cost = 4, CostStep = 1,
		Requires = { "luck_8" }, Description = "+3% bonus item chance from Spark crates per rank.",
		Effects = { { Stat = "chestBonus", Add = 0.03 } } }),
	node({ Id = "luck_12", Name = "Jackpot Aura", Icon = "💫", Branch = "Fortune", X = 6, Y = 0, MaxRank = 1, Cost = 8,
		Requires = { "luck_10", "luck_11" }, Description = "Golden press chance ×1.5 and +25% more.",
		Effects = { { Stat = "goldenMult", Mult = 1.5 }, { Stat = "goldenPct", Add = 0.25 } } }),
	node({ Id = "luck_cap2", Name = "Lady Luck", Icon = "👑", Branch = "Fortune", X = 7, Y = 0, MaxRank = 1, Cost = 12,
		Requires = { "luck_12" }, Description = "+30% Luck and golden press chance ×1.5. Fortune bows to you.",
		Effects = { { Stat = "luck", Add = 0.3 }, { Stat = "goldenMult", Mult = 1.5 } } }),

	-- Wealth, outer ring (down) ----------------------------------------------------------
	node({ Id = "wealth_6", Name = "Compound Interest", Icon = "🧮", Branch = "Wealth", X = 1, Y = 3, MaxRank = 3, Cost = 2, CostStep = 1,
		Requires = { "wealth_3" }, Description = "+25% passive income per rank.",
		Effects = { { Stat = "passivePct", Add = 0.25 } } }),
	node({ Id = "wealth_7", Name = "Sleepwalker", Icon = "😴", Branch = "Wealth", X = -1, Y = 3, MaxRank = 2, Cost = 3, CostStep = 1,
		Requires = { "wealth_4" }, Description = "+2 hours offline earnings and +10% offline rate per rank.",
		Effects = { { Stat = "offlineHours", Add = 2 }, { Stat = "offlineRate", Add = 0.1 } } }),
	node({ Id = "wealth_9", Name = "Power Plant", Icon = "🏭", Branch = "Wealth", X = 1, Y = 4, MaxRank = 1, Cost = 5,
		Requires = { "wealth_6" }, Description = "Passive income ×1.25.",
		Effects = { { Stat = "passiveMult", Mult = 1.25 } } }),
	node({ Id = "wealth_8", Name = "Golden Reserve", Icon = "🏛️", Branch = "Wealth", X = 0, Y = 5, MaxRank = 3, Cost = 3, CostStep = 1,
		Requires = { "wealth_cap" }, Description = "+25% Sparks per rank.",
		Effects = { { Stat = "sparksPct", Add = 0.25 } } }),
	node({ Id = "wealth_10", Name = "Reactor Core", Icon = "☢️", Branch = "Wealth", X = 1, Y = 5, MaxRank = 2, Cost = 4, CostStep = 1,
		Requires = { "wealth_9" }, Description = "+50% passive income per rank.",
		Effects = { { Stat = "passivePct", Add = 0.5 } } }),
	node({ Id = "wealth_11", Name = "Spark Vault", Icon = "🗝️", Branch = "Wealth", X = 0, Y = 6, MaxRank = 1, Cost = 8,
		Requires = { "wealth_8", "wealth_10" }, Description = "All Sparks ×1.25.",
		Effects = { { Stat = "sparksMult", Mult = 1.25 } } }),
	node({ Id = "wealth_cap2", Name = "Infinite Economy", Icon = "♾️", Branch = "Wealth", X = 0, Y = 7, MaxRank = 1, Cost = 12,
		Requires = { "wealth_11" }, Description = "All Sparks ×2 and passive income ×1.5. Money makes money.",
		Effects = { { Stat = "sparksMult", Mult = 2 }, { Stat = "passiveMult", Mult = 1.5 } } }),

	-- Precision, outer ring (left) -------------------------------------------------------
	node({ Id = "crit_5", Name = "Hair Trigger", Icon = "🔫", Branch = "Precision", X = -3, Y = -1, MaxRank = 3, Cost = 2, CostStep = 1,
		Requires = { "crit_3" }, Description = "+2% Crit Chance per rank.",
		Effects = { { Stat = "critChance", Add = 0.02 } } }),
	node({ Id = "crit_6", Name = "Brutal Force", Icon = "🔨", Branch = "Precision", X = -3, Y = 1, MaxRank = 3, Cost = 3, CostStep = 1,
		Requires = { "crit_4" }, Description = "+0.5× crit multiplier per rank.",
		Effects = { { Stat = "critPower", Add = 0.5 } } }),
	node({ Id = "crit_7", Name = "Eagle Eye", Icon = "🦅", Branch = "Precision", X = -4, Y = -1, MaxRank = 2, Cost = 4, CostStep = 1,
		Requires = { "crit_5" }, Description = "+3% Crit Chance per rank.",
		Effects = { { Stat = "critChance", Add = 0.03 } } }),
	node({ Id = "crit_8", Name = "Deadeye", Icon = "🎯", Branch = "Precision", X = -5, Y = 0, MaxRank = 2, Cost = 4, CostStep = 1,
		Requires = { "crit_cap" }, Description = "+1× crit multiplier per rank.",
		Effects = { { Stat = "critPower", Add = 1 } } }),
	node({ Id = "crit_10", Name = "Perfect Timing", Icon = "⌛", Branch = "Precision", X = -5, Y = -1, MaxRank = 2, Cost = 3, CostStep = 1,
		Requires = { "crit_7" }, Description = "+0.2s combo window per rank.",
		Effects = { { Stat = "comboWindow", Add = 0.2 } } }),
	node({ Id = "crit_11", Name = "Executioner", Icon = "⚔️", Branch = "Precision", X = -6, Y = 0, MaxRank = 1, Cost = 8,
		Requires = { "crit_8", "crit_10" }, Description = "+5% Crit Chance and +1.5× crit multiplier.",
		Effects = { { Stat = "critChance", Add = 0.05 }, { Stat = "critPower", Add = 1.5 } } }),
	node({ Id = "crit_cap2", Name = "Singularity Strike", Icon = "🌀", Branch = "Precision", X = -7, Y = 0, MaxRank = 1, Cost = 12,
		Requires = { "crit_11" }, Description = "+5% Crit Chance and +3× crit multiplier. Every crit tears space.",
		Effects = { { Stat = "critChance", Add = 0.05 }, { Stat = "critPower", Add = 3 } } }),

	-- Special, outer diagonals ------------------------------------------------------------
	node({ Id = "spec_prism2", Name = "Prism Resonance", Icon = "🔶", Branch = "Special", X = -3, Y = -3, MaxRank = 3, Cost = 4, CostStep = 1,
		Requires = { "spec_prism" }, Description = "+10% Prisms per ascension per rank.",
		Effects = { { Stat = "prismPct", Add = 0.1 } } }),
	node({ Id = "spec_orb2", Name = "Orb Storm", Icon = "🌪️", Branch = "Special", X = 3, Y = -3, MaxRank = 2, Cost = 3, CostStep = 1,
		Requires = { "spec_orb" }, Description = "Bonus orbs appear 20% more often and give +25% rewards per rank.",
		Effects = { { Stat = "orbRate", Add = 0.2 }, { Stat = "orbPct", Add = 0.25 } } }),
	node({ Id = "spec_xp2", Name = "Scholar's Focus", Icon = "🎓", Branch = "Special", X = -3, Y = 3, MaxRank = 2, Cost = 4, CostStep = 2,
		Requires = { "spec_xp" }, Description = "All XP ×1.25 per rank.",
		Effects = { { Stat = "xpMult", Mult = 1.25 } } }),
	node({ Id = "spec_hoard", Name = "Golden Hoard", Icon = "🏺", Branch = "Special", X = 3, Y = 3, MaxRank = 1, Cost = 6,
		RequiresAny = { "spec_slot", "luck_7", "wealth_6" }, Description = "Golden press chance ×1.25 and +3% bonus item chance from Spark crates.",
		Effects = { { Stat = "goldenMult", Mult = 1.25 }, { Stat = "chestBonus", Add = 0.03 } } }),
}

Skills.ById = {}
for _, n in ipairs(Skills.List) do
	assert(Skills.ById[n.Id] == nil, "Duplicate skill " .. n.Id)
	Skills.ById[n.Id] = n
end
for _, n in ipairs(Skills.List) do
	for _, req in ipairs(n.Requires) do
		assert(Skills.ById[req], `Skill {n.Id} requires unknown {req}`)
	end
	for _, req in ipairs(n.RequiresAny) do
		assert(Skills.ById[req], `Skill {n.Id} requires unknown {req}`)
	end
end

function Skills.get(id: string): SkillNode?
	return Skills.ById[id]
end

-- Cost in Skill Points to go from currentRank to currentRank + 1.
function Skills.costFor(n: SkillNode, currentRank: number): number
	return n.Cost + n.CostStep * currentRank
end

-- Total points invested in a node at a given rank (used for respec refunds).
function Skills.totalCost(n: SkillNode, rank: number): number
	local total = 0
	for r = 0, rank - 1 do
		total += Skills.costFor(n, r)
	end
	return total
end

-- Returns true when the prerequisites of a node are met for the given skills table.
function Skills.prerequisitesMet(n: SkillNode, owned: { [string]: number }): boolean
	for _, req in ipairs(n.Requires) do
		if (owned[req] or 0) < 1 then
			return false
		end
	end
	if #n.RequiresAny > 0 then
		local any = false
		for _, req in ipairs(n.RequiresAny) do
			if (owned[req] or 0) >= 1 then
				any = true
				break
			end
		end
		if not any then
			return false
		end
	end
	return true
end

-- Every prerequisite id of a node (Requires and RequiresAny).
function Skills.prerequisiteIds(n: SkillNode): { string }
	local ids = table.clone(n.Requires)
	for _, id in ipairs(n.RequiresAny) do
		table.insert(ids, id)
	end
	return ids
end

export type Visibility = "visible" | "teaser" | "hidden"

--[[
	How much of the tree a player sees, so it builds itself up as it is bought:
	  visible  the core, owned nodes, and nodes whose prerequisites are met
	  teaser   the next ring: not visible, but connected to a visible node
	           (shown only as a "?" silhouette, without name, effect or cost)
	  hidden   everything further out, including its connector lines
	Pure function; used by the Skills screen and the tests.
]]
function Skills.visibility(owned: { [string]: number }): { [string]: Visibility }
	local result: { [string]: Visibility } = {}
	for _, n in ipairs(Skills.List) do
		if n.Id == "core" or (owned[n.Id] or 0) > 0 or Skills.prerequisitesMet(n, owned) then
			result[n.Id] = "visible"
		end
	end
	for _, n in ipairs(Skills.List) do
		if not result[n.Id] then
			result[n.Id] = "hidden"
			for _, id in ipairs(Skills.prerequisiteIds(n)) do
				if result[id] == "visible" then
					result[n.Id] = "teaser"
					break
				end
			end
		end
	end
	return result
end

return Skills
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--[[
	Sounds (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Sounds

	All sound effects in one place. The defaults use sound files that ship
	with every Roblox client (rbxasset://sounds/...), so the game has audio
	without uploading anything. Replace any Id with your own
	"rbxassetid://<number>" from the Creator Store to customise the audio.

	Music: Roblox does not ship background music with the client, so Music.Id
	is empty by default. Paste the asset id of a track you own or that is
	free to use, e.g. "rbxassetid://1234567890". The music volume setting
	works as soon as an id is set.

	Crate-opening sounds ("Crate..." below) are built from the three bundled
	files, layered and pitch-shifted into ticks, a boom, rising chimes and
	rarity fanfares. Each has an optional Custom slot: paste a Creator Store
	sound ("rbxassetid://<number>") there to use it instead; leave it "" to
	keep the built-in sound. Every Volume stays at or below 0.7 and the SFX
	volume setting scales all of them.
]]

local Sounds = {
	Click = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.45, PitchMin = 0.95, PitchMax = 1.08 },
	Crit = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.55, PitchMin = 1.1, PitchMax = 1.25 },
	Streak = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, PitchMin = 0.7, PitchMax = 0.75 },
	Golden = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.7, PitchMin = 1.45, PitchMax = 1.5 },
	Purchase = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, PitchMin = 0.95, PitchMax = 1.0 },
	Error = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.5, PitchMin = 0.5, PitchMax = 0.55 },
	UIHover = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.12, PitchMin = 1.6, PitchMax = 1.7 },
	UIClick = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.3, PitchMin = 1.2, PitchMax = 1.3 },
	UIOpen = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.25, PitchMin = 1.2, PitchMax = 1.3 },
	ChestShake = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.35, PitchMin = 0.7, PitchMax = 0.9 },
	ChestBurst = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.6, PitchMin = 0.8, PitchMax = 0.85 },
	Reveal = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, PitchMin = 1.0, PitchMax = 1.0 },
	LevelUp = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.65, PitchMin = 0.85, PitchMax = 0.85 },
	Unlock = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, PitchMin = 1.3, PitchMax = 1.3 },
	Orb = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.35, PitchMin = 1.5, PitchMax = 1.6 },
	Announcement = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.7, PitchMin = 0.6, PitchMax = 0.6 },
	-- Crate openings: accelerating ticks with rising pitch, a whoosh + boom on the
	-- burst, a chime per revealed card (pitch climbs card by card) and a fanfare
	-- that grows with the best rarity (Epic / Legendary / Mythic & Secret).
	CrateTick = { Id = "rbxasset://sounds/clickfast.wav", Custom = "", Volume = 0.32, PitchMin = 1, PitchMax = 1 },
	CrateWhoosh = { Id = "rbxasset://sounds/swoosh.wav", Custom = "", Volume = 0.45, PitchMin = 0.55, PitchMax = 0.6 },
	CrateBoom = { Id = "rbxasset://sounds/electronicpingshort.wav", Custom = "", Volume = 0.55, PitchMin = 0.42, PitchMax = 0.45 },
	CrateChime = { Id = "rbxasset://sounds/electronicpingshort.wav", Custom = "", Volume = 0.42, PitchMin = 1, PitchMax = 1, Pool = 8 },
	CrateSparkle = { Id = "rbxasset://sounds/electronicpingshort.wav", Custom = "", Volume = 0.3, PitchMin = 2.0, PitchMax = 2.2, Pool = 6 },
	CrateFanfare = { Id = "rbxasset://sounds/electronicpingshort.wav", Custom = "", Volume = 0.5, PitchMin = 1, PitchMax = 1, Pool = 8 },
	CrateJackpot = { Id = "rbxasset://sounds/swoosh.wav", Custom = "", Volume = 0.5, PitchMin = 1.4, PitchMax = 1.5 },
	Music = { Id = "", Volume = 0.35 },
}

--[[
	Fanfare note patterns (playback-speed ratios; 1.26 ≈ major third, 1.5 = fifth,
	2 = octave). Played as quick arpeggios by ChestOpening for the best drop.
]]
Sounds.CrateFanfares = {
	Epic = { Notes = { 1, 1.26, 1.5 }, Gap = 0.08 },
	Legendary = { Notes = { 1, 1.26, 1.5, 2 }, Gap = 0.09, Sparkle = true },
	Mythic = { Notes = { 0.75, 1, 1.26, 1.5, 2, 2.52 }, Gap = 0.08, Sparkle = true, Jackpot = true },
}

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--[[
	Tutorial (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Tutorial

	The first-time tutorial. Each step completes when the player really does
	the thing; the SERVER decides (ServerScriptService/Services/TutorialService):
	  Kind = "stat"   a saved counter grew by Amount since the step started
	  Kind = "equip"  at least one item is equipped
	  Kind = "seen"   the client reports the player looked at something
	                  (only accepted for the step that is currently active)
	Target names the HUD element the arrow points at (see Hud.target).
]]

local Tutorial = {}

Tutorial.Steps = {
	{
		Id = "press",
		Title = "Press the button",
		Text = "Tap PRESS (or press E / R2) to earn Sparks ⚡. Press it 10 times.",
		Target = "press",
		Kind = "stat",
		Stat = "TotalClicks",
		Amount = 10,
	},
	{
		Id = "upgrade",
		Title = "Buy an upgrade",
		Text = "Open the Shop 🛒 and buy your first upgrade. Upgrades make every press stronger.",
		Target = "nav:Shop",
		Kind = "stat",
		Stat = "UpgradesPurchased",
		Amount = 1,
	},
	{
		Id = "crate",
		Title = "Open a crate",
		Text = "Claim your free crate on the quest card ➡, then open it in the Crates menu 🎁.",
		Target = "nav:Chests",
		Kind = "stat",
		Stat = "ChestsOpened",
		Amount = 1,
	},
	{
		Id = "equip",
		Title = "Equip an item",
		Text = "Open your Items 🎒 and equip what you found. Equipped items give bonuses.",
		Target = "nav:Inventory",
		Kind = "equip",
	},
	{
		Id = "quests",
		Title = "Check your quests",
		Text = "Quests 📜 give free rewards. Open them any time from here.",
		Target = "quests",
		Kind = "seen",
	},
	{
		Id = "obby",
		Title = "Run the Obby",
		Text = "Press ▶ to go to the Obby and reach checkpoint 1. Your auto-presses keep earning while you run!",
		Target = "obby",
		Kind = "stat",
		Stat = "ObbyCheckpoints",
		Amount = 1,
	},
	{
		Id = "auto",
		Title = "Earn while you explore",
		Text = "Buy Auto-Presser upgrades in the Shop: they press for you, even while you run the Obby. You're all set!",
		Target = "nav:Shop",
		Kind = "seen",
		Final = true,
	},
}

Tutorial.ById = {}
for index, step in ipairs(Tutorial.Steps) do
	step.Index = index
	Tutorial.ById[step.Id] = step
end

-- Paid once, the first time the tutorial is finished (not when skipped or replayed).
Tutorial.Reward = { Gems = 50 }

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Upgrades</string>
            <string name="Source"><![CDATA[--[[
	Upgrades (ModuleScript)
	Location: ReplicatedStorage/Shared/Config/Upgrades

	Shop upgrades bought with Sparks. These are reset on Ascension (except where
	an Ascension perk keeps them). Cost for level L -> L+1 is
	    BaseCost * Growth ^ L
	Value(level) returns the total stat contribution at that level.
	Mode "add" sums into the stat; Mode "mult" multiplies it.
	Display controls how the preview is formatted:
	    "flat"  -> +12        "pct" -> +40%       "mult" -> x2.50
	    "cps"   -> 4.5/s      "chance" -> 12.0%   "persec" -> +1.2K/s
]]

export type Upgrade = {
	Id: string,
	Name: string,
	Icon: string,
	Description: string,
	Tier: number,
	Order: number,
	MaxLevel: number,
	BaseCost: number,
	Growth: number,
	Currency: string,
	Stat: string,
	Mode: string,
	Display: string,
	Value: (level: number) -> number,
}

local Upgrades = {}

Upgrades.Tiers = {
	{ Tier = 1, Name = "Tier I — Fundamentals", Requirement = nil },
	{ Tier = 2, Name = "Tier II — Engineering", Requirement = { Level = 8 } },
	{ Tier = 3, Name = "Tier III — Mastery", Requirement = { Rebirths = 1 } },
}

Upgrades.List = {
	{
		Id = "click_power",
		Name = "Reinforced Switch",
		Icon = "👆",
		Description = "Adds base power to every press. Power per level doubles every 25 levels.",
		Tier = 1,
		Order = 1,
		MaxLevel = 500,
		BaseCost = 15,
		Growth = 1.15,
		Currency = "Sparks",
		Stat = "clickFlat",
		Mode = "add",
		Display = "flat",
		Value = function(level: number): number
			local total = 0
			-- closed form of sum_{i=1..level} 2^floor(i/25)
			local full = math.floor(level / 25)
			for block = 0, full - 1 do
				local count = if block == 0 then 24 else 25
				total += count * 2 ^ block
			end
			local start = if full == 0 then 1 else full * 25
			total += (level - start + 1) * 2 ^ full
			return if level <= 0 then 0 else total
		end,
	},
	{
		Id = "generator",
		Name = "Spark Generator",
		Icon = "🔋",
		Description = "Produces Sparks every second, even while you rest.",
		Tier = 1,
		Order = 2,
		MaxLevel = 300,
		BaseCost = 60,
		Growth = 1.16,
		Currency = "Sparks",
		Stat = "passiveFlat",
		Mode = "add",
		Display = "persec",
		Value = function(level: number): number
			return 1.5 * level * 1.06 ^ level
		end,
	},
	{
		Id = "amplifier",
		Name = "Amplifier",
		Icon = "📢",
		Description = "Multiplies ALL Sparks you earn by ×1.1 per level.",
		Tier = 1,
		Order = 3,
		MaxLevel = 60,
		BaseCost = 400,
		Growth = 1.6,
		Currency = "Sparks",
		Stat = "sparksMult",
		Mode = "mult",
		Display = "mult",
		Value = function(level: number): number
			return 1.1 ^ level
		end,
	},
	{
		Id = "precision",
		Name = "Precision Sensor",
		Icon = "🎯",
		Description = "+1% critical press chance per level.",
		Tier = 1,
		Order = 4,
		MaxLevel = 40,
		BaseCost = 200,
		Growth = 1.45,
		Currency = "Sparks",
		Stat = "critChance",
		Mode = "add",
		Display = "chance",
		Value = function(level: number): number
			return 0.01 * level
		end,
	},
	{
		Id = "auto_presser",
		Name = "Auto-Presser",
		Icon = "🤖",
		Description = "A tiny robot that presses the button for you (+0.5 presses/s per level).",
		Tier = 2,
		Order = 5,
		MaxLevel = 20,
		BaseCost = 1500,
		Growth = 2.0,
		Currency = "Sparks",
		Stat = "autoRate",
		Mode = "add",
		Display = "cps",
		Value = function(level: number): number
			return 0.5 * level
		end,
	},
	{
		Id = "fortune",
		Name = "Fortune Coil",
		Icon = "🍀",
		Description = "+4% Luck per level. Luck improves crate rarity odds.",
		Tier = 2,
		Order = 6,
		MaxLevel = 50,
		BaseCost = 800,
		Growth = 1.5,
		Currency = "Sparks",
		Stat = "luck",
		Mode = "add",
		Display = "pct",
		Value = function(level: number): number
			return 0.04 * level
		end,
	},
	{
		Id = "overload",
		Name = "Overload Capacitor",
		Icon = "💥",
		Description = "+0.25× critical press multiplier per level.",
		Tier = 2,
		Order = 7,
		MaxLevel = 20,
		BaseCost = 5000,
		Growth = 1.7,
		Currency = "Sparks",
		Stat = "critPower",
		Mode = "add",
		Display = "flatx",
		Value = function(level: number): number
			return 0.25 * level
		end,
	},
	{
		Id = "treasure_sense",
		Name = "Treasure Sense",
		Icon = "🧭",
		Description = "+1.5% chance per level for a Spark crate to drop a bonus item.",
		Tier = 3,
		Order = 8,
		MaxLevel = 30,
		BaseCost = 5e5,
		Growth = 1.6,
		Currency = "Sparks",
		Stat = "chestBonus",
		Mode = "add",
		Display = "chance",
		Value = function(level: number): number
			return 0.015 * level
		end,
	},
	{
		Id = "lucky_star",
		Name = "Lucky Star",
		Icon = "🌟",
		Description = "+10% golden press chance per level.",
		Tier = 3,
		Order = 9,
		MaxLevel = 30,
		BaseCost = 3e5,
		Growth = 1.55,
		Currency = "Sparks",
		Stat = "goldenPct",
		Mode = "add",
		Display = "pct",
		Value = function(level: number): number
			return 0.1 * level
		end,
	},
	{
		Id = "scholar",
		Name = "Scholar's Lens",
		Icon = "📘",
		Description = "+10% XP from every source per level.",
		Tier = 3,
		Order = 10,
		MaxLevel = 40,
		BaseCost = 2e5,
		Growth = 1.5,
		Currency = "Sparks",
		Stat = "xpPct",
		Mode = "add",
		Display = "pct",
		Value = function(level: number): number
			return 0.1 * level
		end,
	},
}

Upgrades.ById = {}
for _, def in ipairs(Upgrades.List) do
	Upgrades.ById[def.Id] = def
end
table.sort(Upgrades.List, function(a, b)
	return a.Order < b.Order
end)

-- Buy amount options shown in the shop. "max" buys as many as affordable.
Upgrades.BuyAmounts = { 1, 10, "max" }

function Upgrades.get(id: string): Upgrade?
	return Upgrades.ById[id]
end

function Upgrades.tierInfo(tier: number)
	return Upgrades.Tiers[tier]
end

return Upgrades
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--[[
	Format (ModuleScript)
	Location: ReplicatedStorage/Shared/Format

	Number and time formatting used by every UI and by server messages.
	  Format.short(1234567)    -> "1.23M"
	  Format.commas(1234567)   -> "1,234,567"
	  Format.time(3725)        -> "1h 02m"
	  Format.pct(0.25)         -> "25%"
	  Format.mult(2.5)         -> "×2.50"
]]

local Format = {}

local SUFFIXES = {
	"",
	"K",
	"M",
	"B",
	"T",
	"Qa",
	"Qi",
	"Sx",
	"Sp",
	"Oc",
	"No",
	"Dc",
	"Ud",
	"Dd",
	"Td",
	"Qad",
	"Qid",
	"Sxd",
	"Spd",
	"Ocd",
	"Nod",
	"Vg",
}

local function trimZeros(s: string): string
	if string.find(s, "%.") then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return s
end

function Format.short(n: number?, keepDecimals: boolean?): string
	local value = n or 0
	if value ~= value then
		return "0"
	end
	if value == math.huge then
		return "∞"
	end
	local negative = value < 0
	value = math.abs(value)
	local text
	if value < 1000 then
		if value < 10 and value ~= math.floor(value) then
			text = trimZeros(string.format("%.2f", math.floor(value * 100) / 100))
		elseif value < 100 and value ~= math.floor(value) and keepDecimals then
			text = trimZeros(string.format("%.1f", math.floor(value * 10) / 10))
		else
			text = tostring(math.floor(value))
		end
	else
		local tier = math.floor(math.log10(value) / 3)
		if tier >= #SUFFIXES then
			local exponent = math.floor(math.log10(value))
			local mantissa = value / 10 ^ exponent
			text = string.format("%.2fe%d", math.floor(mantissa * 100) / 100, exponent)
		else
			local scaled = value / 10 ^ (tier * 3)
			-- Floor instead of rounding so a value never displays higher than it is.
			if scaled < 10 then
				text = trimZeros(string.format("%.2f", math.floor(scaled * 100) / 100))
			elseif scaled < 100 then
				text = trimZeros(string.format("%.1f", math.floor(scaled * 10) / 10))
			else
				text = tostring(math.floor(scaled))
			end
			text ..= SUFFIXES[tier + 1]
		end
	end
	return if negative then "-" .. text else text
end

function Format.commas(n: number?): string
	local value = math.floor(n or 0)
	if math.abs(value) >= 1e15 then
		return Format.short(value)
	end
	local s = tostring(math.abs(value))
	local formatted = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	formatted = string.gsub(formatted, "^,", "")
	return if value < 0 then "-" .. formatted else formatted
end

function Format.time(seconds: number?): string
	local s = math.max(0, math.floor(seconds or 0))
	local d = math.floor(s / 86400)
	local h = math.floor((s % 86400) / 3600)
	local m = math.floor((s % 3600) / 60)
	local sec = s % 60
	if d > 0 then
		return string.format("%dd %02dh", d, h)
	elseif h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, sec)
	end
	return string.format("%ds", sec)
end

function Format.clock(seconds: number?): string
	local s = math.max(0, math.floor(seconds or 0))
	local h = math.floor(s / 3600)
	local m = math.floor((s % 3600) / 60)
	local sec = s % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, sec)
	end
	return string.format("%d:%02d", m, sec)
end

function Format.pct(fraction: number?, decimals: number?): string
	local v = (fraction or 0) * 100
	local d = decimals or (if math.abs(v) < 10 and v ~= math.floor(v) then 1 else 0)
	if math.abs(v) >= 1000 then
		return Format.short(v) .. "%"
	end
	return trimZeros(string.format("%." .. d .. "f", v)) .. "%"
end

function Format.mult(m: number?): string
	local v = m or 1
	if v >= 1000 then
		return "×" .. Format.short(v)
	end
	return "×" .. trimZeros(string.format("%.2f", v))
end

-- Formats a value according to an upgrade Display hint (see Config/Upgrades).
function Format.display(kind: string, value: number): string
	if kind == "flat" then
		return "+" .. Format.short(value)
	elseif kind == "flatx" then
		return "+" .. trimZeros(string.format("%.2f", value)) .. "×"
	elseif kind == "pct" then
		return "+" .. Format.pct(value)
	elseif kind == "mult" then
		return Format.mult(value)
	elseif kind == "cps" then
		return trimZeros(string.format("%.1f", value)) .. "/s"
	elseif kind == "chance" then
		return "+" .. Format.pct(value, 1)
	elseif kind == "persec" then
		return "+" .. Format.short(value, true) .. "/s"
	elseif kind == "hours" then
		return "+" .. tostring(value) .. "h"
	elseif kind == "unlock" then
		return if value > 0 then "Active" else "Inactive"
	end
	return tostring(value)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Formulas</string>
          <string name="Source"><![CDATA[--[[
	Formulas (ModuleScript)
	Location: ReplicatedStorage/Shared/Formulas
	Depends on: Shared/Config/*, Shared/Format

	Every game formula lives here so the server (authoritative) and the client
	(previews only) can never disagree. The server computes the real values;
	the client uses the same functions to show "current -> next" previews.

	computeStats(data, ctx) folds upgrades, ascension perks, skills, equipped
	items, game passes, bought boosts, rebirths, stage, collection, server
	events and personal boosts into a flat Stats table.
]]

local Config = script.Parent.Config
local GameConfig = require(Config.GameConfig)
local Upgrades = require(Config.Upgrades)
local Ascension = require(Config.Ascension)
local Skills = require(Config.Skills)
local Items = require(Config.Items)
local Chests = require(Config.Chests)
local GamePasses = require(Config.GamePasses)
local DevProducts = require(Config.DevProducts)
local Format = require(script.Parent.Format)

export type Stats = {
	clickBase: number,
	clickMultiplier: number,
	sparksMultiplier: number,
	clickValue: number,
	critChance: number,
	critMultiplier: number,
	comboCap: number,
	comboWindow: number,
	comboStep: number,
	goldenChance: number,
	autoRate: number,
	passivePerSec: number,
	luck: number,
	chestBonus: number,
	xpMultiplier: number,
	gemMultiplier: number,
	equipSlots: number,
	offlineRate: number,
	offlineMaxSeconds: number,
	chestDiscount: number,
	prismMultiplier: number,
	pityMultiplier: number,
	orbIntervalMultiplier: number,
	orbRewardMultiplier: number,
	streakMultiplier: number,
	startSparks: number,
	keepAuto: boolean,
	stage: number,
	rebirthMultiplier: number,
	collectionMultiplier: number,
	discovered: number,
	frenzyMultiplier: number,
	maxOpenBonus: number,
}

export type Context = {
	Events: { string }?,
	FrenzyMultiplier: number?,
	-- Leave out timed boosts bought with Robux (for base stats such as quest targets).
	ExcludeTimedBoosts: boolean?,
}

local Formulas = {}

-- Upper limit for the Gem multiplier. Rainbow Gem items stacked with passes
-- could otherwise reach several hundred; the cap only matters in the late game.
Formulas.MaxGemMultiplier = 50

local ADD_STATS = {
	"clickFlat",
	"clickPct",
	"sparksPct",
	"critChance",
	"critPower",
	"luck",
	"chestBonus",
	"goldenPct",
	"autoRate",
	"passiveFlat",
	"passivePct",
	"xpPct",
	"gemsPct",
	"comboCap",
	"comboWindow",
	"streakPct",
	"equipSlots",
	"offlineHours",
	"offlineRate",
	"chestDiscount",
	"prismPct",
	"pityReduction",
	"orbRate",
	"orbPct",
	"startSparks",
	"keepAuto",
	"autoRatePass", -- auto presses from game passes, added after the upgrade cap
	"extraOpen", -- extra crates per opening (Fast Crates pass)
}

local MULT_STATS = { "clickMult", "sparksMult", "goldenMult", "xpMult", "passiveMult", "gemsMult" }
local IS_MULT = {}
for _, k in ipairs(MULT_STATS) do
	IS_MULT[k] = true
end

Formulas.AddStats = ADD_STATS
Formulas.MultStats = MULT_STATS

function Formulas.newModifiers()
	local m = { add = {}, mult = {} }
	for _, k in ipairs(ADD_STATS) do
		m.add[k] = 0
	end
	for _, k in ipairs(MULT_STATS) do
		m.mult[k] = 1
	end
	return m
end

local function apply(m, stat: string, mode: string?, value: number)
	if mode == "mult" or (mode == nil and IS_MULT[stat]) then
		m.mult[stat] = (m.mult[stat] or 1) * value
	else
		m.add[stat] = (m.add[stat] or 0) + value
	end
end

-- Copies beyond the first boost an equipped item's power.
function Formulas.copyBonus(count: number): number
	local eq = GameConfig.Equip
	return math.min(eq.MaxCopyBonus, eq.CopyBonusPerExtra * math.max(0, count - 1))
end

function Formulas.itemPower(item, count: number): number
	return item.Bonus * (1 + Formulas.copyBonus(count))
end

function Formulas.describeItemBonus(item, count: number?): string
	local statDef = GameConfig.ItemStats[item.Stat]
	local value = Formulas.itemPower(item, count or 1)
	return "+" .. Format.pct(value, if value < 0.1 then 1 else 0) .. " " .. statDef.Label
end

-- Discovered base items (Golden/Rainbow variants are tracked but not counted).
function Formulas.discoveredCount(data): number
	local n = 0
	for id in pairs(data.Discovered or {}) do
		local item = Items.ById[id]
		if item and not item.Variant then
			n += 1
		end
	end
	return n
end

function Formulas.skillRanks(data): number
	local n = 0
	for id, rank in pairs(data.Skills or {}) do
		if Skills.ById[id] then
			n += rank
		end
	end
	return n
end

function Formulas.skillPointsSpent(data): number
	local n = 0
	for id, rank in pairs(data.Skills or {}) do
		local def = Skills.ById[id]
		if def then
			n += Skills.totalCost(def, rank)
		end
	end
	return n
end

function Formulas.stageFor(rebirths: number)
	local best = GameConfig.Stages[1]
	for _, stage in ipairs(GameConfig.Stages) do
		if rebirths >= stage.Rebirths then
			best = stage
		end
	end
	return best
end

function Formulas.nextStage(rebirths: number)
	for _, stage in ipairs(GameConfig.Stages) do
		if stage.Rebirths > rebirths then
			return stage
		end
	end
	return nil
end

-- Collects every modifier from the player's data and the context.
function Formulas.collect(data, ctx: Context?)
	local m = Formulas.newModifiers()

	for id, level in pairs(data.Upgrades or {}) do
		local def = Upgrades.ById[id]
		if def and level > 0 then
			apply(m, def.Stat, def.Mode, def.Value(level))
		end
	end

	for id, level in pairs(data.Ascension or {}) do
		local def = Ascension.ById[id]
		if def and level > 0 then
			apply(m, def.Stat, def.Mode, def.Value(level))
		end
	end
	local nightOwl = (data.Ascension or {}).night_owl or 0
	m.add.offlineRate += nightOwl * Ascension.OfflineRatePerNightOwl

	for id, rank in pairs(data.Skills or {}) do
		local def = Skills.ById[id]
		if def and rank > 0 then
			for _, effect in ipairs(def.Effects) do
				if effect.Mult then
					apply(m, effect.Stat, "mult", effect.Mult ^ rank)
				else
					apply(m, effect.Stat, "add", (effect.Add or 0) * rank)
				end
			end
		end
	end

	local inventory = data.Inventory or {}
	local seen = {}
	for _, itemId in ipairs(data.Equipped or {}) do
		local item = Items.ById[itemId]
		local count = inventory[itemId] or 0
		if item and count > 0 and not seen[itemId] then
			seen[itemId] = true
			local statDef = GameConfig.ItemStats[item.Stat]
			apply(m, statDef.Stat, "add", Formulas.itemPower(item, count))
		end
	end

	-- Robux game passes (only passes whose GamePassId is set count).
	for _, pass in ipairs(GamePasses.List) do
		if GamePasses.owns(data.Passes, pass.Key) then
			for _, effect in ipairs(pass.Effects) do
				if effect.Mult then
					apply(m, effect.Stat, "mult", effect.Mult)
				else
					apply(m, effect.Stat, "add", effect.Add or 0)
				end
			end
		end
	end

	-- Timed boosts bought as developer products (seconds left > 0).
	local boosts = data.Boosts
	if type(boosts) == "table" and not (ctx and ctx.ExcludeTimedBoosts) then
		for _, product in ipairs(DevProducts.List) do
			local left = boosts[product.Key]
			if product.Boost and type(left) == "number" and left > 0 then
				if product.Boost.Add then
					apply(m, product.Boost.Stat, "add", product.Boost.Add)
				else
					apply(m, product.Boost.Stat, "mult", product.Boost.Mult or 1)
				end
			end
		end
	end

	if ctx and ctx.Events then
		for _, eventId in ipairs(ctx.Events) do
			local def = GameConfig.Events.Definitions[eventId]
			if def then
				for stat, value in pairs(def.Effects) do
					apply(m, stat, nil, value)
				end
			end
		end
	end

	return m
end

function Formulas.computeStats(data, ctx: Context?): Stats
	local m = Formulas.collect(data, ctx)
	local a, x = m.add, m.mult
	local click = GameConfig.Click
	local rebirths = data.Rebirths or 0

	local stage = Formulas.stageFor(rebirths)
	local rebirthMultiplier = 1 + GameConfig.Rebirth.MultiplierPerRebirth * rebirths
	local discovered = Formulas.discoveredCount(data)
	local collectionMultiplier = 1 + GameConfig.Collection.SparksBonusPerItem * discovered
	local frenzy = if ctx and ctx.FrenzyMultiplier then ctx.FrenzyMultiplier else 1

	local sparksMultiplier = (1 + a.sparksPct)
		* x.sparksMult
		* rebirthMultiplier
		* stage.Multiplier
		* collectionMultiplier
		* frenzy
	local clickBase = 1 + a.clickFlat
	local clickMultiplier = (1 + a.clickPct) * x.clickMult
	local clickValue = clickBase * clickMultiplier * sparksMultiplier

	local offline = GameConfig.Offline
	local stats: Stats = {
		clickBase = clickBase,
		clickMultiplier = clickMultiplier,
		sparksMultiplier = sparksMultiplier,
		clickValue = math.min(clickValue, GameConfig.CurrencyCap),
		critChance = math.min(click.MaxCritChance, click.BaseCritChance + a.critChance),
		critMultiplier = click.BaseCritMultiplier + a.critPower,
		comboCap = click.BaseComboCap + a.comboCap,
		comboWindow = click.ComboWindow + a.comboWindow,
		comboStep = click.ComboStep,
		goldenChance = math.min(click.MaxGoldenChance, click.BaseGoldenChance * (1 + a.goldenPct) * x.goldenMult),
		-- Upgrades and skills are capped; game passes add on top of the cap.
		autoRate = math.min(GameConfig.AutoClick.MaxRate, a.autoRate) + a.autoRatePass,
		passivePerSec = math.min(a.passiveFlat * (1 + a.passivePct) * x.passiveMult * sparksMultiplier, GameConfig.CurrencyCap),
		luck = a.luck,
		chestBonus = math.min(0.75, a.chestBonus),
		xpMultiplier = (1 + a.xpPct) * x.xpMult,
		gemMultiplier = math.min(Formulas.MaxGemMultiplier, (1 + a.gemsPct) * x.gemsMult),
		equipSlots = math.min(GameConfig.Equip.MaxSlots, GameConfig.Equip.BaseSlots + a.equipSlots),
		offlineRate = math.min(1, offline.BaseRate + a.offlineRate),
		offlineMaxSeconds = (offline.BaseMaxHours + a.offlineHours) * 3600,
		chestDiscount = math.min(0.6, a.chestDiscount),
		prismMultiplier = 1 + a.prismPct,
		pityMultiplier = math.max(0.5, 1 - a.pityReduction),
		orbIntervalMultiplier = 1 / (1 + a.orbRate),
		orbRewardMultiplier = 1 + a.orbPct,
		streakMultiplier = 1 + a.streakPct,
		startSparks = a.startSparks,
		keepAuto = a.keepAuto > 0,
		stage = stage.Id,
		rebirthMultiplier = rebirthMultiplier,
		collectionMultiplier = collectionMultiplier,
		discovered = discovered,
		frenzyMultiplier = frenzy,
		maxOpenBonus = math.max(0, math.floor(a.extraOpen)),
	}
	return stats
end

-- Combo multiplier for a given combo count.
function Formulas.comboMultiplier(stats: Stats, combo: number): number
	return 1 + stats.comboStep * math.min(combo, stats.comboCap)
end

-- Upgrades -------------------------------------------------------------------

function Formulas.upgradeLevelCost(def, level: number): number
	return math.ceil(def.BaseCost * def.Growth ^ level)
end

-- Total cost to buy `count` levels starting at `level`.
function Formulas.upgradeCost(def, level: number, count: number): number
	local total = 0
	for i = 0, count - 1 do
		total += Formulas.upgradeLevelCost(def, level + i)
	end
	return total
end

-- How many levels (up to the max level) can be bought with `money`.
function Formulas.maxAffordable(def, level: number, money: number): (number, number)
	local count, total = 0, 0
	local remaining = math.min(def.MaxLevel - level, 1000)
	for i = 0, remaining - 1 do
		local cost = Formulas.upgradeLevelCost(def, level + i)
		if total + cost > money then
			break
		end
		total += cost
		count += 1
	end
	return count, total
end

function Formulas.requirementMet(requirement, data): boolean
	if not requirement then
		return true
	end
	if requirement.Level and (data.Level or 1) < requirement.Level then
		return false
	end
	if requirement.Rebirths and (data.Rebirths or 0) < requirement.Rebirths then
		return false
	end
	return true
end

function Formulas.requirementText(requirement): string
	if not requirement then
		return ""
	end
	if requirement.Rebirths then
		return "Requires " .. requirement.Rebirths .. " Ascension" .. (if requirement.Rebirths == 1 then "" else "s")
	end
	if requirement.Level then
		return "Requires level " .. requirement.Level
	end
	return ""
end

function Formulas.upgradeUnlocked(def, data): boolean
	local tier = Upgrades.Tiers[def.Tier]
	return Formulas.requirementMet(tier and tier.Requirement, data)
end

function Formulas.ascensionCost(def, level: number): number
	return math.ceil(def.BaseCost * def.Growth ^ level)
end

-- Levels and XP ----------------------------------------------------------------

-- XP needed to advance from `level` to `level + 1`.
function Formulas.xpForLevel(level: number): number
	local cfg = GameConfig.Levels
	return math.floor(cfg.BaseXP * level ^ cfg.Exponent)
end

-- Skill points granted for reaching `level`.
function Formulas.skillPointsForLevel(level: number): number
	local cfg = GameConfig.Levels
	local sp = cfg.SkillPointsPerLevel
	if level % cfg.BonusSkillPointEvery == 0 then
		sp += 1
	end
	return sp
end

-- Ascension ----------------------------------------------------------------------

function Formulas.rebirthRequirement(rebirths: number): number
	local cfg = GameConfig.Rebirth
	return cfg.BaseRequirement * cfg.RequirementGrowth ^ rebirths
end

function Formulas.rebirthPrisms(sparksThisRun: number, rebirths: number, prismMultiplier: number): number
	local cfg = GameConfig.Rebirth
	local requirement = Formulas.rebirthRequirement(rebirths)
	if sparksThisRun < requirement then
		return 0
	end
	local excess = math.min(cfg.MaxExcessFactor, sparksThisRun / requirement)
	local base = cfg.BasePrisms + cfg.PrismsPerRebirth * rebirths
	return math.max(1, math.floor(base * excess ^ cfg.ExcessExponent * prismMultiplier))
end

-- Crates ---------------------------------------------------------------------------

-- Discounts apply to Sparks crates only (Gem crates must not become cheaper than their resale).
function Formulas.chestPrice(chest, discount: number): number
	local d = if chest.Currency == "Sparks" then math.min(0.6, discount) else 0
	return math.ceil(chest.Price * (1 - d))
end

-- Bonus-drop chance for a crate (Sparks crates only, for the same reason).
function Formulas.chestBonusChance(chest, chestBonus: number): number
	return if chest.Currency == "Sparks" then chestBonus else 0
end

function Formulas.chestUnlocked(chest, data): boolean
	return Formulas.stageFor(data.Rebirths or 0).Id >= chest.Stage
end

-- Most crates of one kind per opening (Fast Crates pass adds to it).
function Formulas.maxOpen(chest, stats: Stats?): number
	return chest.MaxOpen + (if stats then stats.maxOpenBonus or 0 else 0)
end

function Formulas.pityThreshold(chest, rarityId: string, pityMultiplier: number): number?
	local base = chest.Pity and chest.Pity[rarityId]
	if not base then
		return nil
	end
	return math.max(1, math.floor(base * pityMultiplier + 0.5))
end

-- Daily quest target for a template.
function Formulas.questTarget(template, rebirths: number, clickValue: number): number
	if template.ClickScaled then
		return math.max(100, math.ceil(template.Base * math.max(1, clickValue)))
	end
	local scale = 1 + (template.ScalePerRebirth or 0) * math.min(rebirths, 20)
	local target = math.ceil(template.Base * scale)
	if template.Max then
		target = math.min(template.Max, target)
	end
	return target
end

-- Sum of sell value for a set of copies.
-- Gems for selling `count` copies. Items from Gem-priced crates (Prism Cache)
-- ignore Gem boosts: otherwise a high Gem multiplier would turn buying and
-- reselling caches into a Gem machine.
function Formulas.sellValue(item, count: number, gemMultiplier: number): number
	local chest = Chests.ById[item.Chest]
	local multiplier = if chest and chest.Currency == "Gems" then 1 else gemMultiplier
	return math.floor(item.SellValue * count * multiplier)
end

return Formulas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Loot</string>
          <string name="Source"><![CDATA[--[[
	Loot (ModuleScript)
	Location: ReplicatedStorage/Shared/Loot
	Depends on: Shared/Config/Rarities, Shared/Config/Items

	Pure crate-roll maths. The SERVER performs every real roll with its own
	Random object; the client only calls effectiveWeights() to display odds.

	Luck: weight' = weight * (1 + luck) ^ LuckPower(rarity). Common has
	LuckPower 0, so luck shifts probability from Common toward rarer tiers.

	Pity: pityState[rarityId] counts openings since the last drop of that
	rarity or better. When the next opening would reach the threshold, the
	roll is restricted to that rarity or better.
]]

local Config = script.Parent.Config
local Rarities = require(Config.Rarities)
local Items = require(Config.Items)

export type WeightEntry = { Rarity: string, Index: number, Weight: number, Chance: number }

local Loot = {}

function Loot.effectiveWeights(chest, luck: number): { WeightEntry }
	local entries = {}
	local total = 0
	local factor = 1 + math.max(0, luck)
	for _, rarityId in ipairs(Rarities.Order) do
		local base = chest.Weights[rarityId]
		if base and base > 0 then
			local rarity = Rarities.ById[rarityId]
			local weight = base * factor ^ rarity.LuckPower
			total += weight
			table.insert(entries, { Rarity = rarityId, Index = rarity.Index, Weight = weight, Chance = 0 })
		end
	end
	for _, entry in ipairs(entries) do
		entry.Chance = entry.Weight / total
	end
	return entries
end

local function pickRarity(rng: Random, entries: { WeightEntry }, minIndex: number): string
	local total = 0
	for _, entry in ipairs(entries) do
		if entry.Index >= minIndex then
			total += entry.Weight
		end
	end
	if total <= 0 then
		-- No rarity at or above the pity floor exists in this crate; fall back to the rarest.
		return entries[#entries].Rarity
	end
	local roll = rng:NextNumber() * total
	local last = entries[#entries].Rarity
	for _, entry in ipairs(entries) do
		if entry.Index >= minIndex then
			roll -= entry.Weight
			last = entry.Rarity
			if roll <= 0 then
				return entry.Rarity
			end
		end
	end
	return last
end

function Loot.pickItem(rng: Random, chestId: string, rarityId: string): string?
	local pool = Items.PoolByChest[chestId]
	local list = pool and pool[rarityId]
	if not list or #list == 0 then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

--[[
	Performs one roll. Mutates pityState (a table keyed by rarity id).
	pityThresholds: { [rarityId] = openings } already adjusted for skills.
	Returns itemId, rarityId, pityTriggered.
]]
function Loot.roll(rng: Random, chest, luck: number, pityState: { [string]: number }, pityThresholds: { [string]: number })
	local entries = Loot.effectiveWeights(chest, luck)
	local minIndex = 0
	local pityTriggered = false
	for rarityId, threshold in pairs(pityThresholds) do
		local count = pityState[rarityId] or 0
		if count + 1 >= threshold then
			local idx = Rarities.index(rarityId)
			if idx > minIndex then
				minIndex = idx
				pityTriggered = true
			end
		end
	end

	local rarityId = pickRarity(rng, entries, minIndex)
	local rolledIndex = Rarities.index(rarityId)
	for pityRarity in pairs(pityThresholds) do
		if rolledIndex >= Rarities.index(pityRarity) then
			pityState[pityRarity] = 0
		else
			pityState[pityRarity] = (pityState[pityRarity] or 0) + 1
		end
	end

	local itemId = Loot.pickItem(rng, chest.Id, rarityId)
	return itemId, rarityId, pityTriggered
end

--[[
	Robux crates: the rarity comes from the crate's own weights (with luck),
	the item from `pool` ({ [rarityId] = { itemId } }, built by the server from
	the crates the player has unlocked). Rarities missing from the pool are
	skipped. Returns itemId, rarityId (nil when the pool is empty).
]]
function Loot.rollFromPool(rng: Random, chest, luck: number, pool: { [string]: { string } }): (string?, string?)
	local entries = {}
	for _, entry in ipairs(Loot.effectiveWeights(chest, luck)) do
		local list = pool[entry.Rarity]
		if list and #list > 0 then
			table.insert(entries, entry)
		end
	end
	if #entries == 0 then
		return nil, nil
	end
	local rarityId = pickRarity(rng, entries, 0)
	local list = pool[rarityId]
	return list[rng:NextInteger(1, #list)], rarityId
end

--[[
	Golden / Rainbow roll for a dropped item: returns "golden", "rainbow" or nil.
	chances: { golden = p, rainbow = p } (defaults to Items.Variants drop chances).
	Independent of rarity and pity.
]]
function Loot.rollVariant(rng: Random, chances: { [string]: number }?): string?
	local roll = rng:NextNumber()
	-- Rarest first, so the chances add up the way they read.
	for i = #Items.Variants, 1, -1 do
		local variant = Items.Variants[i]
		local chance = if chances then chances[variant.Id] or 0 else variant.DropChance
		if roll < chance then
			return variant.Id
		end
		roll -= chance
	end
	return nil
end

-- Admin testing: one item of an exact rarity from a crate's pool. Never touches pity.
function Loot.rollForcedRarity(rng: Random, chest, rarityId: string): string?
	return Loot.pickItem(rng, chest.Id, rarityId)
end

--[[
	Admin testing: simulates `count` openings with a private pity state and
	returns { [rarityId] = drops }. Uses exactly the production roll function,
	so the result reflects real odds without changing anyone's data.
]]
function Loot.simulate(rng: Random, chest, luck: number, count: number, pityThresholds: { [string]: number }?)
	local results = {}
	local pity = {}
	for _, rarityId in ipairs(Rarities.Order) do
		results[rarityId] = 0
	end
	for _ = 1, count do
		local _, rarityId = Loot.roll(rng, chest, luck, pity, pityThresholds or {})
		results[rarityId] += 1
	end
	return results
end

return Loot
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes (ModuleScript)
	Location: ReplicatedStorage/Shared/Remotes

	Single source of truth for every RemoteEvent / RemoteFunction.
	The server calls Remotes.init() once at startup, which creates
	ReplicatedStorage/Remotes and ReplicatedStorage/ServerState. Clients use
	Remotes.event(name) / Remotes.func(name), which wait for the instance.

	Direction and responsibility:
	  Click        (client -> server)  a manual press. No arguments are trusted.
	  ClickResult  (server -> client)  result of a press for effects/floaters.
	  StateSync    (server -> client)  full snapshot or partial patch of the player's own data.
	  Notify       (server -> client)  toasts, discoveries, announcements, level ups.
	  OrbSpawn     (server -> client)  a bonus orb the player may claim.
	  AdminPush    (server -> admin)   live updates for the admin panel (admins only).
	  Action       (client -> server)  RemoteFunction for every player action (validated, rate limited).
	  Admin        (client -> server)  RemoteFunction for admin requests (permission checked per call).

	The server never calls InvokeClient.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.FolderName = "Remotes"
Remotes.StateFolderName = "ServerState"

Remotes.Events = {
	Click = "Click",
	ClickResult = "ClickResult",
	StateSync = "StateSync",
	Notify = "Notify",
	OrbSpawn = "OrbSpawn",
	AdminPush = "AdminPush",
}

Remotes.Functions = {
	Action = "Action",
	Admin = "Admin",
}

local function getFolder(): Folder
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(Remotes.FolderName)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = Remotes.FolderName
			folder.Parent = ReplicatedStorage
		end
		return folder :: Folder
	end
	local folder = ReplicatedStorage:WaitForChild(Remotes.FolderName, 60)
	assert(folder, "Remotes folder did not replicate. Is the server running Main?")
	return folder :: Folder
end

-- Server only: creates every remote and the ServerState folder. Idempotent.
function Remotes.init()
	assert(RunService:IsServer(), "Remotes.init must be called on the server")
	local folder = getFolder()
	for _, name in pairs(Remotes.Events) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in pairs(Remotes.Functions) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
	if not ReplicatedStorage:FindFirstChild(Remotes.StateFolderName) then
		local state = Instance.new("Folder")
		state.Name = Remotes.StateFolderName
		state.Parent = ReplicatedStorage
	end
end

function Remotes.event(name: string): RemoteEvent
	assert(Remotes.Events[name], "Unknown RemoteEvent " .. tostring(name))
	local folder = getFolder()
	local remote = if RunService:IsServer() then folder:FindFirstChild(name) else folder:WaitForChild(name, 60)
	assert(remote and remote:IsA("RemoteEvent"), "RemoteEvent missing: " .. name)
	return remote :: RemoteEvent
end

function Remotes.func(name: string): RemoteFunction
	assert(Remotes.Functions[name], "Unknown RemoteFunction " .. tostring(name))
	local folder = getFolder()
	local remote = if RunService:IsServer() then folder:FindFirstChild(name) else folder:WaitForChild(name, 60)
	assert(remote and remote:IsA("RemoteFunction"), "RemoteFunction missing: " .. name)
	return remote :: RemoteFunction
end

-- Folder whose attributes hold replicated server-wide state (events, server CPS).
function Remotes.serverState(): Folder
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(Remotes.StateFolderName)
		assert(folder, "Remotes.init has not run")
		return folder :: Folder
	end
	local folder = ReplicatedStorage:WaitForChild(Remotes.StateFolderName, 60)
	assert(folder, "ServerState did not replicate")
	return folder :: Folder
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">RobuxSale</string>
          <string name="Source"><![CDATA[--[[
	RobuxSale (ModuleScript)
	Location: ReplicatedStorage/Shared/RobuxSale
	Depends on: Shared/Remotes (ServerState folder name)

	How a store entry (Config/GamePasses or Config/DevProducts) is sold on Roblox:
	  "pass"     a game pass: bought once, owned forever
	  "product"  a developer product: can be bought again and again

	The config holds the ID in GamePassId or ProductId. When an entry also has
	a HubName (its exact name in the Creator Hub), the server asks Roblox at
	start which kind that ID really is, so an ID pasted into the "wrong" field
	still works. The answer is published as the ServerState attribute
	"Sale_<key>" = "pass:<id>" / "product:<id>" so clients prompt the right
	purchase. Until then (and in tests without a server) the config decides.
	Nothing here grants anything: purchases are granted by the server only.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(script.Parent.Remotes)

local RobuxSale = {}

local function stateFolder(): Instance?
	return ReplicatedStorage:FindFirstChild(Remotes.StateFolderName)
end

-- The configured kind and ID, ignoring the server's check.
function RobuxSale.configured(entry): (string?, number)
	if type(entry.GamePassId) == "number" and entry.GamePassId > 0 then
		return "pass", entry.GamePassId
	end
	if type(entry.ProductId) == "number" and entry.ProductId > 0 then
		return "product", entry.ProductId
	end
	return nil, 0
end

-- ("pass" | "product" | nil, id): how this entry is sold right now. The
-- server's answer only decides the kind, and only for the ID it checked: if
-- the config now holds another ID, the config wins.
function RobuxSale.of(entry): (string?, number)
	local configuredKind, configuredId = RobuxSale.configured(entry)
	if not configuredKind then
		return nil, 0
	end
	local folder = stateFolder()
	local value = folder and folder:GetAttribute("Sale_" .. entry.Key)
	if type(value) == "string" then
		local kind, id = string.match(value, "^(%a+):(%d+)$")
		if (kind == "pass" or kind == "product") and tonumber(id) == configuredId then
			return kind, configuredId
		end
	end
	return configuredKind, configuredId
end

-- Server only: records the kind confirmed with Roblox.
function RobuxSale.publish(entry, kind: string, id: number)
	local folder = stateFolder()
	if folder then
		folder:SetAttribute("Sale_" .. entry.Key, `{kind}:{math.floor(id)}`)
	end
end

-- Server only: marks that every entry has been checked (ownership checks wait for it).
function RobuxSale.markResolved()
	local folder = stateFolder()
	if folder then
		folder:SetAttribute("SalesResolved", true)
	end
end

function RobuxSale.isResolved(): boolean
	local folder = stateFolder()
	return folder ~= nil and folder:GetAttribute("SalesResolved") == true
end

return RobuxSale
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[
	Signal (ModuleScript)
	Location: ReplicatedStorage/Shared/Signal

	Minimal Lua signal. Handlers run in their own thread (task.spawn) so an
	error in one handler never breaks the others or the code that fired it.
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	Wait: (self: Signal) -> ...any,
	DisconnectAll: (self: Signal) -> (),
}

local Signal = {}
Signal.__index = Signal

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	local handlers = self._signal._handlers
	for i, h in ipairs(handlers) do
		if h == self then
			table.remove(handlers, i)
			break
		end
	end
end

function Signal.new(): Signal
	return (setmetatable({ _handlers = {} }, Signal) :: any) :: Signal
end

function Signal:Connect(fn)
	local connection = setmetatable({ Connected = true, _fn = fn, _signal = self }, Connection)
	table.insert(self._handlers, connection)
	return connection
end

function Signal:Once(fn)
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...)
	local snapshot = table.clone(self._handlers)
	for _, connection in ipairs(snapshot) do
		if connection.Connected then
			task.spawn(connection._fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, connection in ipairs(table.clone(self._handlers)) do
		connection.Connected = false
	end
	table.clear(self._handlers)
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--[[
	Util (ModuleScript)
	Location: ReplicatedStorage/Shared/Util

	Small pure helpers shared by server and client. No Roblox services
	(serverTime only reads the synced workspace clock).
]]

local Util = {}

function Util.deepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value :: any) do
		copy[Util.deepCopy(k)] = Util.deepCopy(v)
	end
	return (copy :: any) :: T
end

function Util.isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function Util.clamp(value: number, min: number, max: number): number
	if value < min then
		return min
	elseif value > max then
		return max
	end
	return value
end

function Util.round(value: number, decimals: number?): number
	local m = 10 ^ (decimals or 0)
	return math.floor(value * m + 0.5) / m
end

function Util.countKeys(t: { [any]: any }): number
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

function Util.sortedKeys(t: { [any]: any }): { any }
	local keys = {}
	for k in pairs(t) do
		table.insert(keys, k)
	end
	table.sort(keys, function(a, b)
		return tostring(a) < tostring(b)
	end)
	return keys
end

-- Picks an entry from a list of tables that each have a Weight field.
function Util.weightedPick<T>(rng: Random, list: { T }): T
	local total = 0
	for _, entry in ipairs(list) do
		total += (entry :: any).Weight
	end
	local roll = rng:NextNumber() * total
	for _, entry in ipairs(list) do
		roll -= (entry :: any).Weight
		if roll <= 0 then
			return entry
		end
	end
	return list[#list]
end

-- Whole UTC day number for a unix timestamp.
-- Unix time synced to the server clock (a player's device clock can be wrong).
function Util.serverTime(): number
	return math.floor(workspace:GetServerTimeNow())
end

function Util.dayNumber(timestamp: number): number
	return math.floor(timestamp / 86400)
end

-- Seconds until the next UTC midnight.
function Util.secondsUntilNextDay(timestamp: number): number
	return (Util.dayNumber(timestamp) + 1) * 86400 - timestamp
end

function Util.trim(s: string): string
	return (string.gsub(s, "^%s*(.-)%s*$", "%1"))
end

function Util.split(s: string): { string }
	local parts = {}
	for part in string.gmatch(s, "%S+") do
		table.insert(parts, part)
	end
	return parts
end

-- Returns a shallow array of the values of t, in key order (deterministic).
function Util.values<V>(t: { [any]: V }): { V }
	local out = {}
	for _, k in ipairs(Util.sortedKeys(t)) do
		table.insert(out, t[k])
	end
	return out
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="27">
      <Properties>
        <string name="Name">UI</string>
      </Properties>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Effects</string>
          <string name="Source"><![CDATA[--[[
	Effects (ModuleScript)
	Location: ReplicatedStorage/UI/Effects
	Depends on: UI/Theme

	2D juice for the interface: particle bursts, floating numbers, shockwave
	rings, screen shake and flashes. Particles are pooled frames (Roblox
	ParticleEmitters only work in 3D). Every effect respects Reduced Motion.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Effects = {}

local rng = Random.new()
local particlePool: { Frame } = {}
local floaterPool: { TextLabel } = {}
local MAX_POOL = 120

local function takeParticle(): Frame
	local p = table.remove(particlePool)
	if p then
		return p
	end
	local frame = Instance.new("Frame")
	frame.Name = "Particle"
	frame.BorderSizePixel = 0
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 2)
	corner.Parent = frame
	return frame
end

local function releaseParticle(p: Frame)
	p.Parent = nil
	if #particlePool < MAX_POOL then
		table.insert(particlePool, p)
	else
		p:Destroy()
	end
end

-- Burst of square sparks flying outward from a point (offset pixels in parent space).
-- zIndex is optional, for layers whose own content sits above the default.
function Effects.burst(parent: GuiObject, position: Vector2, color: Color3, count: number?, spread: number?, zIndex: number?)
	if Theme.ReducedMotion then
		return
	end
	local n = count or 10
	for _ = 1, n do
		local p = takeParticle()
		local size = rng:NextInteger(5, 11)
		p.Size = UDim2.fromOffset(size, size)
		p.Position = UDim2.fromOffset(position.X, position.Y)
		p.Rotation = rng:NextInteger(0, 90)
		p.BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), rng:NextNumber(0, 0.4))
		p.BackgroundTransparency = 0
		p.ZIndex = zIndex or 40
		p.Parent = parent
		local angle = rng:NextNumber(0, math.pi * 2)
		local distance = rng:NextNumber(50, spread or 140)
		local target = position + Vector2.new(math.cos(angle), math.sin(angle)) * distance
		local duration = rng:NextNumber(0.35, 0.7)
		local tween = TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(target.X, target.Y),
			Rotation = p.Rotation + rng:NextInteger(90, 270),
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(2, 2),
		})
		tween.Completed:Connect(function()
			releaseParticle(p)
		end)
		tween:Play()
	end
end

-- Expanding ring centred on a point.
function Effects.ring(parent: GuiObject, position: Vector2, color: Color3, size: number?, zIndex: number?)
	if Theme.ReducedMotion then
		return
	end
	local ring = Instance.new("Frame")
	ring.Name = "Ring"
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromOffset(position.X, position.Y)
	ring.Size = UDim2.fromOffset(40, 40)
	ring.BackgroundTransparency = 1
	ring.ZIndex = zIndex or 35
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = ring
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 4
	stroke.Parent = ring
	ring.Parent = parent
	local final = size or 320
	local info = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	TweenService:Create(ring, info, { Size = UDim2.fromOffset(final, final) }):Play()
	local fade = TweenService:Create(stroke, info, { Transparency = 1, Thickness = 1 })
	fade.Completed:Connect(function()
		ring:Destroy()
	end)
	fade:Play()
end

local function takeFloater(): TextLabel
	local f = table.remove(floaterPool)
	if f then
		return f
	end
	local label = Instance.new("TextLabel")
	label.Name = "Floater"
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Size = UDim2.fromOffset(240, 40)
	label.Font = Theme.Fonts.Heading
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0.35
	label.RichText = false
	return label
end

local function releaseFloater(f: TextLabel)
	f.Parent = nil
	if #floaterPool < MAX_POOL then
		table.insert(floaterPool, f)
	else
		f:Destroy()
	end
end

-- Floating text that rises and fades. opts: { Size, Rise, Duration, Font }
function Effects.floatText(parent: GuiObject, position: Vector2, text: string, color: Color3, opts: { [string]: any }?)
	local o = opts or {}
	local label = takeFloater()
	label.Text = text
	label.TextColor3 = color
	label.TextSize = o.Size or 26
	label.Font = o.Font or Theme.Fonts.Heading
	label.TextTransparency = 0
	label.TextStrokeTransparency = 0.35
	label.Rotation = if Theme.ReducedMotion then 0 else rng:NextNumber(-6, 6)
	label.Position = UDim2.fromOffset(position.X, position.Y)
	label.ZIndex = 45
	label.Parent = parent
	local rise = o.Rise or 90
	local duration = o.Duration or 0.9
	local goal = {
		Position = UDim2.fromOffset(position.X + rng:NextNumber(-20, 20), position.Y - rise),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}
	local tween = TweenService:Create(label, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), goal)
	tween.Completed:Connect(function()
		releaseFloater(label)
	end)
	tween:Play()
end

-- Shakes a GuiObject around its current position.
local shaking: { [GuiObject]: boolean } = {}
function Effects.shake(target: GuiObject, intensity: number?, duration: number?)
	if Theme.ReducedMotion or shaking[target] then
		return
	end
	shaking[target] = true
	local origin = target.Position
	local amount = intensity or 6
	local stop = os.clock() + (duration or 0.18)
	task.spawn(function()
		while os.clock() < stop do
			target.Position = origin + UDim2.fromOffset(rng:NextNumber(-amount, amount), rng:NextNumber(-amount, amount))
			task.wait(1 / 60)
		end
		target.Position = origin
		shaking[target] = nil
	end)
end

-- Full-screen colour flash inside parent.
function Effects.flash(parent: GuiObject, color: Color3, strength: number?, zIndex: number?)
	if Theme.ReducedMotion then
		return
	end
	local frame = Instance.new("Frame")
	frame.Name = "Flash"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 1 - (strength or 0.35)
	frame.BorderSizePixel = 0
	frame.ZIndex = zIndex or 60
	frame.Parent = parent
	local tween = TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
	tween.Completed:Connect(function()
		frame:Destroy()
	end)
	tween:Play()
end

-- Slowly rotating light rays behind a reveal.
function Effects.rays(parent: GuiObject, color: Color3, size: number): Frame
	local holder = Instance.new("Frame")
	holder.Name = "Rays"
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromOffset(size, size)
	holder.BackgroundTransparency = 1
	holder.ZIndex = 2
	for i = 0, 5 do
		local ray = Instance.new("Frame")
		ray.AnchorPoint = Vector2.new(0.5, 0.5)
		ray.Position = UDim2.fromScale(0.5, 0.5)
		ray.Size = UDim2.new(0, size * 0.12, 1, 0)
		ray.Rotation = i * 30
		ray.BackgroundColor3 = color
		ray.BorderSizePixel = 0
		ray.ZIndex = 2
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = 90
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		})
		gradient.Parent = ray
		ray.Parent = holder
	end
	holder.Parent = parent
	if not Theme.ReducedMotion then
		task.spawn(function()
			while holder.Parent do
				holder.Rotation = (holder.Rotation + 0.4) % 360
				task.wait(1 / 60)
			end
		end)
	end
	return holder
end

return Effects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">SoundPlayer</string>
          <string name="Source"><![CDATA[--[[
	SoundPlayer (ModuleScript)
	Location: ReplicatedStorage/UI/SoundPlayer
	Depends on: Shared/Config/Sounds

	Client-side sound effects and music. Sounds are pooled (a few instances
	per effect, used round-robin) so rapid clicking never creates garbage.
	Volumes follow the player's SFX / Music settings and are capped at
	MAX_VOLUME. A sound's Custom id (Creator Store audio) replaces its
	built-in Id when it is set.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Sounds"))

local SoundPlayer = {}

local POOL_SIZE = 4
local MAX_VOLUME = 0.8
local sfxVolume = 0.7
local musicVolume = 0.4
local pools: { [string]: { sounds: { Sound }, index: number } } = {}
local folder: Folder? = nil
local music: Sound? = nil
local rng = Random.new()

local function getFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "ButtonAscensionSounds"
	f.Parent = SoundService
	folder = f
	return f
end

local function getPool(name: string)
	local pool = pools[name]
	if pool then
		return pool
	end
	local def = Sounds[name]
	if type(def) ~= "table" then
		return nil
	end
	local id = if type(def.Custom) == "string" and def.Custom ~= "" then def.Custom else def.Id
	if type(id) ~= "string" or id == "" then
		return nil
	end
	pool = { sounds = {}, index = 1 }
	for i = 1, def.Pool or POOL_SIZE do
		local sound = Instance.new("Sound")
		sound.Name = name .. i
		sound.SoundId = id
		sound.Volume = def.Volume * sfxVolume
		sound.Parent = getFolder()
		table.insert(pool.sounds, sound)
	end
	pools[name] = pool
	return pool
end

-- opts: { Pitch = number, Volume = multiplier }
function SoundPlayer.play(name: string, opts: { Pitch: number?, Volume: number? }?)
	if sfxVolume <= 0 then
		return
	end
	local def = Sounds[name]
	local pool = getPool(name)
	if not def or not pool then
		return
	end
	local sound = pool.sounds[pool.index]
	pool.index = (pool.index % #pool.sounds) + 1
	local pitch = if opts and opts.Pitch then opts.Pitch else rng:NextNumber(def.PitchMin or 1, def.PitchMax or 1)
	sound.PlaybackSpeed = pitch
	sound.Volume = math.min(MAX_VOLUME, def.Volume * sfxVolume * (if opts and opts.Volume then opts.Volume else 1))
	sound.TimePosition = 0
	sound:Play()
end

-- Plays `name` once per pitch in `notes`, `gap` seconds apart (arpeggios, fanfares).
function SoundPlayer.sequence(name: string, notes: { number }, gap: number, opts: { Volume: number? }?)
	for i, pitch in ipairs(notes) do
		local volume = if opts and opts.Volume then opts.Volume else 1
		if i == 1 then
			SoundPlayer.play(name, { Pitch = pitch, Volume = volume })
		else
			task.delay((i - 1) * gap, SoundPlayer.play, name, { Pitch = pitch, Volume = volume })
		end
	end
end

function SoundPlayer.setVolumes(sfx: number, musicVol: number)
	sfxVolume = math.clamp(sfx, 0, 1)
	musicVolume = math.clamp(musicVol, 0, 1)
	if music then
		music.Volume = Sounds.Music.Volume * musicVolume
		if musicVolume <= 0 then
			music:Pause()
		elseif not music.IsPlaying then
			music:Resume()
		end
	end
end

-- Starts looping background music if Sounds.Music.Id is configured.
function SoundPlayer.startMusic()
	if music or Sounds.Music.Id == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "Music"
	sound.SoundId = Sounds.Music.Id
	sound.Looped = true
	sound.Volume = Sounds.Music.Volume * musicVolume
	sound.Parent = getFolder()
	music = sound
	if musicVolume > 0 then
		sound:Play()
	end
end

function SoundPlayer.hasMusic(): boolean
	return Sounds.Music.Id ~= ""
end

return SoundPlayer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Theme</string>
          <string name="Source"><![CDATA[--[[
	Theme (ModuleScript)
	Location: ReplicatedStorage/UI/Theme
	Depends on: Shared/Config/GameConfig, Shared/Config/Rarities

	Design tokens for the whole interface: colours, typography, radii and
	motion. The player UI and the admin panel share these tokens; the admin
	panel swaps in its own accent palette (Theme.Admin) so it is clearly
	distinct while keeping the same design language.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local GameConfig = require(Config.GameConfig)
local Rarities = require(Config.Rarities)

local Theme = {}

Theme.Colors = {
	Background = Color3.fromRGB(9, 9, 17),
	BackgroundAlt = Color3.fromRGB(15, 14, 27),
	Panel = Color3.fromRGB(20, 19, 35),
	PanelLight = Color3.fromRGB(30, 28, 50),
	PanelLighter = Color3.fromRGB(42, 39, 68),
	Stroke = Color3.fromRGB(62, 57, 98),
	StrokeSoft = Color3.fromRGB(42, 39, 66),
	Text = Color3.fromRGB(242, 240, 255),
	TextDim = Color3.fromRGB(176, 171, 208),
	TextMuted = Color3.fromRGB(118, 113, 150),
	Accent = Color3.fromRGB(255, 61, 110),
	AccentSoft = Color3.fromRGB(140, 30, 70),
	Accent2 = Color3.fromRGB(77, 225, 255),
	Accent3 = Color3.fromRGB(176, 92, 255),
	Success = Color3.fromRGB(64, 220, 130),
	Warning = Color3.fromRGB(255, 190, 60),
	Danger = Color3.fromRGB(255, 72, 88),
	Gold = Color3.fromRGB(255, 205, 64),
	Black = Color3.new(0, 0, 0),
	White = Color3.new(1, 1, 1),
	Sparks = GameConfig.Currencies.Sparks.Color,
	Gems = GameConfig.Currencies.Gems.Color,
	Prisms = GameConfig.Currencies.Prisms.Color,
}

-- Admin panel palette: same structure, neon green + magenta on near-black teal.
Theme.Admin = {
	Background = Color3.fromRGB(6, 11, 13),
	Panel = Color3.fromRGB(11, 19, 22),
	PanelLight = Color3.fromRGB(17, 29, 33),
	PanelLighter = Color3.fromRGB(25, 42, 47),
	Stroke = Color3.fromRGB(32, 74, 70),
	Accent = Color3.fromRGB(0, 245, 160),
	Accent2 = Color3.fromRGB(255, 61, 200),
	Text = Color3.fromRGB(226, 255, 245),
	TextDim = Color3.fromRGB(140, 190, 175),
	Danger = Color3.fromRGB(255, 72, 88),
	Warning = Color3.fromRGB(255, 190, 60),
}

Theme.Fonts = {
	Display = Enum.Font.Michroma,
	Heading = Enum.Font.BuilderSansExtraBold,
	Bold = Enum.Font.BuilderSansBold,
	Medium = Enum.Font.BuilderSansMedium,
	Body = Enum.Font.BuilderSans,
	Mono = Enum.Font.RobotoMono,
}

Theme.TextSize = {
	Hero = 40,
	Title = 26,
	Heading = 19,
	Body = 16,
	Small = 14,
	Tiny = 12,
}

Theme.Radius = {
	Small = 8,
	Medium = 12,
	Large = 18,
	Pill = 999,
}

Theme.Motion = {
	Fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Normal = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	Slow = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	Pop = TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	Linear = TweenInfo.new(1, Enum.EasingStyle.Linear),
}

-- Runtime preferences (set from player settings).
Theme.ReducedMotion = false
Theme.UserScale = 1

function Theme.rarityColor(rarityId: string): Color3
	local r = Rarities.ById[rarityId]
	return if r then r.Color else Theme.Colors.TextDim
end

function Theme.rarityGlow(rarityId: string): Color3
	local r = Rarities.ById[rarityId]
	return if r then r.Glow else Theme.Colors.StrokeSoft
end

function Theme.currencyColor(currency: string): Color3
	local c = GameConfig.Currencies[currency]
	return if c then c.Color else Theme.Colors.Text
end

function Theme.currencyIcon(currency: string): string
	local c = GameConfig.Currencies[currency]
	return if c then c.Icon else ""
end

function Theme.lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

function Theme.darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

function Theme.gradient(a: Color3, b: Color3): ColorSequence
	return ColorSequence.new(a, b)
end

Theme.SecretGradient = Rarities.SecretGradient

return Theme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">UIKit</string>
          <string name="Source"><![CDATA[--[[
	UIKit (ModuleScript)
	Location: ReplicatedStorage/UI/UIKit
	Depends on: UI/Theme, UI/SoundPlayer

	Declarative helpers and themed components used by every screen of the
	player UI and by the admin panel.

	UIKit.new(className, props, children)
	  * Normal keys are assigned as properties.
	  * Function values connect to the event of that name (e.g. Activated = fn).
	  * Extra keys: Corner, Stroke, Padding, Gradient, List, Grid, Aspect,
	    MinSize/MaxSize, TextMax, Scale, Children, Parent (assigned last).

	Components: label, frame, panel, button, progress, scroll, textbox, toggle,
	slider, segmented, window, confirm, prompt, attachTooltip.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local SoundPlayer = require(script.Parent.SoundPlayer)

local C = Theme.Colors
local F = Theme.Fonts
local S = Theme.TextSize

local UI = {}
UI.Theme = Theme

local SPECIAL = {
	Children = true,
	Corner = true,
	Stroke = true,
	Padding = true,
	Gradient = true,
	List = true,
	Grid = true,
	Aspect = true,
	MinSize = true,
	MaxSize = true,
	TextMax = true,
	Scale = true,
	Parent = true,
}

-- Low-level helpers ---------------------------------------------------------------

function UI.corner(inst: Instance, radius: number?): UICorner
	local c = Instance.new("UICorner")
	local r = radius or Theme.Radius.Medium
	c.CornerRadius = if r >= 999 then UDim.new(1, 0) else UDim.new(0, r)
	c.Parent = inst
	return c
end

function UI.stroke(inst: Instance, spec: any): UIStroke
	local s = Instance.new("UIStroke")
	if typeof(spec) == "Color3" then
		s.Color = spec
		s.Thickness = 1
	elseif type(spec) == "table" then
		s.Color = spec.Color or C.StrokeSoft
		s.Thickness = spec.Thickness or 1
		s.Transparency = spec.Transparency or 0
	else
		s.Color = C.StrokeSoft
		s.Thickness = 1
	end
	local textual = inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")
	s.ApplyStrokeMode = if type(spec) == "table" and spec.Text then Enum.ApplyStrokeMode.Contextual
		elseif textual then Enum.ApplyStrokeMode.Border
		else Enum.ApplyStrokeMode.Contextual
	s.Parent = inst
	return s
end

function UI.padding(inst: Instance, spec: any): UIPadding
	local p = Instance.new("UIPadding")
	local l, r, t, b
	if type(spec) == "number" then
		l, r, t, b = spec, spec, spec, spec
	elseif type(spec) == "table" then
		if spec.X or spec.Y then
			l, r, t, b = spec.X or 0, spec.X or 0, spec.Y or 0, spec.Y or 0
		else
			l, r, t, b = spec[1] or 0, spec[2] or 0, spec[3] or 0, spec[4] or 0
		end
	end
	p.PaddingLeft = UDim.new(0, l or 0)
	p.PaddingRight = UDim.new(0, r or 0)
	p.PaddingTop = UDim.new(0, t or 0)
	p.PaddingBottom = UDim.new(0, b or 0)
	p.Parent = inst
	return p
end

function UI.gradient(inst: Instance, spec: any): UIGradient
	local g = Instance.new("UIGradient")
	if typeof(spec) == "ColorSequence" then
		g.Color = spec
		g.Rotation = 90
	elseif type(spec) == "table" then
		if spec.Color then
			g.Color = spec.Color
		end
		if spec.Transparency then
			g.Transparency = spec.Transparency
		end
		g.Rotation = spec.Rotation or 90
	end
	g.Parent = inst
	return g
end

local ALIGN_H = {
	Left = Enum.HorizontalAlignment.Left,
	Center = Enum.HorizontalAlignment.Center,
	Right = Enum.HorizontalAlignment.Right,
}
local ALIGN_V = {
	Top = Enum.VerticalAlignment.Top,
	Center = Enum.VerticalAlignment.Center,
	Bottom = Enum.VerticalAlignment.Bottom,
}

function UI.list(inst: Instance, spec: any): UIListLayout
	local l = Instance.new("UIListLayout")
	spec = spec or {}
	l.FillDirection = if spec.Dir == "X" then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, spec.Pad or 8)
	l.HorizontalAlignment = ALIGN_H[spec.HA or "Left"]
	l.VerticalAlignment = ALIGN_V[spec.VA or "Top"]
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = inst
	return l
end

function UI.grid(inst: Instance, spec: any): UIGridLayout
	local g = Instance.new("UIGridLayout")
	g.CellSize = spec.Cell or UDim2.fromOffset(100, 100)
	g.CellPadding = spec.Pad or UDim2.fromOffset(8, 8)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.HorizontalAlignment = ALIGN_H[spec.HA or "Left"]
	g.Parent = inst
	return g
end

function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local p = props or {}
	for key, value in pairs(p) do
		if not SPECIAL[key] then
			if type(value) == "function" then
				(inst :: any)[key]:Connect(value)
			else
				(inst :: any)[key] = value
			end
		end
	end
	if p.Corner then
		UI.corner(inst, if p.Corner == true then nil else p.Corner)
	end
	if p.Stroke then
		UI.stroke(inst, if p.Stroke == true then nil else p.Stroke)
	end
	if p.Padding then
		UI.padding(inst, p.Padding)
	end
	if p.Gradient then
		UI.gradient(inst, p.Gradient)
	end
	if p.List then
		UI.list(inst, if p.List == true then nil else p.List)
	end
	if p.Grid then
		UI.grid(inst, p.Grid)
	end
	if p.Aspect then
		local a = Instance.new("UIAspectRatioConstraint")
		a.AspectRatio = p.Aspect
		a.Parent = inst
	end
	if p.MinSize or p.MaxSize then
		local c = Instance.new("UISizeConstraint")
		c.MinSize = p.MinSize or Vector2.new(0, 0)
		c.MaxSize = p.MaxSize or Vector2.new(math.huge, math.huge)
		c.Parent = inst
	end
	if p.TextMax then
		local c = Instance.new("UITextSizeConstraint")
		c.MaxTextSize = p.TextMax
		c.Parent = inst
	end
	if p.Scale then
		local s = Instance.new("UIScale")
		s.Scale = p.Scale
		s.Parent = inst
	end
	for _, child in ipairs(p.Children or {}) do
		child.Parent = inst
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if p.Parent then
		inst.Parent = p.Parent
	end
	return inst
end

local function merge(defaults: { [string]: any }, props: { [string]: any }?): { [string]: any }
	local out = table.clone(defaults)
	for k, v in pairs(props or {}) do
		out[k] = v
	end
	return out
end
UI.merge = merge

-- Motion ---------------------------------------------------------------------------

-- Tweens unless reduced motion is on (then the end state is applied instantly).
function UI.tween(inst: Instance, goal: { [string]: any }, info: TweenInfo?, force: boolean?): Tween?
	if Theme.ReducedMotion and not force then
		for k, v in pairs(goal) do
			(inst :: any)[k] = v
		end
		return nil
	end
	local tween = TweenService:Create(inst, info or Theme.Motion.Normal, goal)
	tween:Play()
	return tween
end

-- Viewport / layering ----------------------------------------------------------------

function UI.viewport(): Vector2
	local camera = workspace.CurrentCamera
	return if camera then camera.ViewportSize else Vector2.new(1280, 720)
end

function UI.isCompact(): boolean
	local v = UI.viewport()
	return v.X < 900 or v.Y < 560
end

function UI.onViewportChanged(fn: () -> ()): RBXScriptConnection?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	return camera:GetPropertyChangedSignal("ViewportSize"):Connect(fn)
end

-- Scale that fits a base-size box into the viewport with margins.
function UI.fitScale(width: number, height: number, marginX: number?, marginY: number?): number
	local v = UI.viewport()
	local sx = (v.X * (marginX or 0.94)) / width
	local sy = (v.Y * (marginY or 0.88)) / height
	local fits = math.min(sx, sy)
	-- The UI Scale setting may shrink windows freely but never push them off-screen.
	return math.clamp(math.min(math.min(fits, 1.15) * Theme.UserScale, fits), 0.45, 1.6)
end

local overlayGui: ScreenGui? = nil
function UI.overlay(): ScreenGui
	if overlayGui and overlayGui.Parent then
		return overlayGui
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "UIKitOverlay"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 100
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	overlayGui = gui
	return gui
end

-- Components ---------------------------------------------------------------------------

function UI.label(props: { [string]: any }?): TextLabel
	return UI.new(
		"TextLabel",
		merge({
			BackgroundTransparency = 1,
			Font = F.Medium,
			TextColor3 = C.Text,
			TextSize = S.Body,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			Size = UDim2.new(1, 0, 0, 22),
			RichText = false,
		}, props)
	)
end

function UI.frame(props: { [string]: any }?): Frame
	return UI.new("Frame", merge({ BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, props))
end

function UI.panel(props: { [string]: any }?): Frame
	return UI.new(
		"Frame",
		merge({
			BackgroundColor3 = C.Panel,
			BorderSizePixel = 0,
			Corner = Theme.Radius.Medium,
			Stroke = { Color = C.StrokeSoft, Thickness = 1 },
		}, props)
	)
end

local VARIANTS = {
	primary = { Bg = C.Accent, Text = C.White, Stroke = Theme.lighten(C.Accent, 0.25) },
	secondary = { Bg = C.PanelLighter, Text = C.Text, Stroke = C.Stroke },
	ghost = { Bg = C.PanelLight, Text = C.TextDim, Stroke = C.StrokeSoft },
	success = { Bg = Color3.fromRGB(34, 170, 100), Text = C.White, Stroke = C.Success },
	danger = { Bg = Color3.fromRGB(200, 40, 60), Text = C.White, Stroke = C.Danger },
	gold = { Bg = C.Gold, Text = Color3.fromRGB(40, 28, 0), Stroke = Theme.lighten(C.Gold, 0.3) },
	cyan = { Bg = Color3.fromRGB(30, 150, 190), Text = C.White, Stroke = C.Accent2 },
	violet = { Bg = Color3.fromRGB(120, 60, 200), Text = C.White, Stroke = C.Accent3 },
}
UI.Variants = VARIANTS

local buttonMeta = setmetatable({}, { __mode = "k" })
local lastHoverSound = 0

local function applyVariant(button: TextButton, variant: string)
	local v = VARIANTS[variant] or VARIANTS.secondary
	local meta = buttonMeta[button]
	if meta then
		meta.Variant = variant
	end
	button.BackgroundColor3 = v.Bg
	button.TextColor3 = v.Text
	local stroke = button:FindFirstChild("Border")
	if stroke and stroke:IsA("UIStroke") then
		stroke.Color = v.Stroke
	end
end

--[[
	props: Text, Icon, Variant, OnClick, Disabled, Tooltip, Sound, Radius, plus any
	TextButton property (Size, Position, AnchorPoint, LayoutOrder, Parent, TextSize...).
]]
function UI.button(props: { [string]: any }): TextButton
	local variant = props.Variant or "secondary"
	local onClick = props.OnClick
	local text = props.Text or ""
	if props.Icon then
		text = if text ~= "" then props.Icon .. "  " .. text else props.Icon
	end
	local clean = {}
	for k, v in pairs(props) do
		if k ~= "Variant" and k ~= "OnClick" and k ~= "Icon" and k ~= "Disabled" and k ~= "Tooltip" and k ~= "Sound" and k ~= "Radius" then
			clean[k] = v
		end
	end
	clean.Text = text
	local button = UI.new(
		"TextButton",
		merge({
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Font = F.Bold,
			TextSize = S.Body,
			Size = UDim2.fromOffset(140, 40),
			Selectable = true,
		}, clean)
	)
	UI.corner(button, props.Radius or Theme.Radius.Small + 2)
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Border"
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Thickness = 1
	stroke.Transparency = 0.2
	stroke.Parent = button
	local scale = Instance.new("UIScale")
	scale.Name = "PressScale"
	scale.Parent = button
	UI.gradient(button, {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 215)),
		Rotation = 90,
	})

	buttonMeta[button] = { Variant = variant, Hover = false }
	applyVariant(button, variant)

	local function hover(on: boolean)
		local meta = buttonMeta[button]
		if not meta then
			return
		end
		meta.Hover = on
		local v = VARIANTS[meta.Variant] or VARIANTS.secondary
		if button:GetAttribute("Disabled") then
			return
		end
		UI.tween(scale, { Scale = if on then 1.04 else 1 }, Theme.Motion.Fast)
		UI.tween(button, { BackgroundColor3 = if on then Theme.lighten(v.Bg, 0.1) else v.Bg }, Theme.Motion.Fast)
		if on and os.clock() - lastHoverSound > 0.06 then
			lastHoverSound = os.clock()
			SoundPlayer.play("UIHover")
		end
	end
	button.MouseEnter:Connect(function()
		hover(true)
	end)
	button.MouseLeave:Connect(function()
		hover(false)
	end)
	button.SelectionGained:Connect(function()
		hover(true)
	end)
	button.SelectionLost:Connect(function()
		hover(false)
	end)
	button.MouseButton1Down:Connect(function()
		if not button:GetAttribute("Disabled") then
			UI.tween(scale, { Scale = 0.95 }, Theme.Motion.Fast)
		end
	end)
	button.MouseButton1Up:Connect(function()
		local meta = buttonMeta[button]
		UI.tween(scale, { Scale = if meta and meta.Hover then 1.04 else 1 }, Theme.Motion.Fast)
	end)
	button.Activated:Connect(function()
		if button:GetAttribute("Disabled") then
			SoundPlayer.play("Error")
			return
		end
		SoundPlayer.play(props.Sound or "UIClick")
		if onClick then
			onClick(button)
		end
	end)
	if props.Disabled then
		UI.setEnabled(button, false)
	end
	if props.Tooltip then
		UI.attachTooltip(button, props.Tooltip)
	end
	return button
end

function UI.setEnabled(button: TextButton, enabled: boolean)
	button:SetAttribute("Disabled", not enabled)
	button.BackgroundTransparency = if enabled then 0 else 0.45
	button.TextTransparency = if enabled then 0 else 0.4
	local scale = button:FindFirstChild("PressScale")
	if scale and scale:IsA("UIScale") and not enabled then
		scale.Scale = 1
	end
end

function UI.setVariant(button: TextButton, variant: string)
	applyVariant(button, variant)
end

function UI.setText(button: TextButton, text: string, icon: string?)
	button.Text = if icon then icon .. "  " .. text else text
end

--[[ Progress bar. Returns { Frame, Fill, Label, Set(fraction, text?) } ]]
function UI.progress(props: { [string]: any })
	local frame = UI.new("Frame", {
		Name = props.Name or "Progress",
		Size = props.Size or UDim2.new(1, 0, 0, 14),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		BackgroundColor3 = props.Background or C.BackgroundAlt,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Corner = props.Radius or Theme.Radius.Pill,
		Stroke = { Color = C.StrokeSoft, Transparency = 0.3 },
		Parent = props.Parent,
	})
	local fill = UI.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = props.Color or C.Accent,
		BorderSizePixel = 0,
		Corner = props.Radius or Theme.Radius.Pill,
		Parent = frame,
	})
	UI.gradient(fill, { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 210)), Rotation = 90 })
	local label = UI.label({
		Name = "Label",
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = props.TextSize or S.Tiny,
		Font = F.Bold,
		ZIndex = 3,
		Parent = frame,
	})
	UI.stroke(label, { Color = C.Black, Thickness = 1, Transparency = 0.5, Text = true })
	local bar = { Frame = frame, Fill = fill, Label = label }
	function bar.Set(fraction: number, text: string?)
		local f = math.clamp(if fraction == fraction then fraction else 0, 0, 1)
		UI.tween(fill, { Size = UDim2.fromScale(f, 1) }, Theme.Motion.Normal)
		if text then
			label.Text = text
		end
	end
	function bar.SetColor(color: Color3)
		fill.BackgroundColor3 = color
	end
	return bar
end

function UI.scroll(props: { [string]: any }?): ScrollingFrame
	return UI.new(
		"ScrollingFrame",
		merge({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 5,
			ScrollBarImageColor3 = C.Stroke,
			ScrollBarImageTransparency = 0.2,
			VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
			ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
		}, props)
	)
end

--[[ props: Placeholder, Text, OnChanged(text), OnSubmit(text), MaxLength, + TextBox props ]]
function UI.textbox(props: { [string]: any }): TextBox
	local onChanged = props.OnChanged
	local onSubmit = props.OnSubmit
	local maxLength = props.MaxLength
	local clean = {}
	for k, v in pairs(props) do
		if k ~= "OnChanged" and k ~= "OnSubmit" and k ~= "Placeholder" and k ~= "MaxLength" then
			clean[k] = v
		end
	end
	local box = UI.new(
		"TextBox",
		merge({
			BackgroundColor3 = C.BackgroundAlt,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = F.Medium,
			TextSize = S.Body,
			TextColor3 = C.Text,
			PlaceholderColor3 = C.TextMuted,
			PlaceholderText = props.Placeholder or "",
			Text = "",
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 38),
			Corner = Theme.Radius.Small + 2,
			Padding = { X = 12 },
		}, clean)
	)
	local stroke = UI.stroke(box, { Color = C.StrokeSoft })
	box.Focused:Connect(function()
		UI.tween(stroke, { Color = C.Accent2 }, Theme.Motion.Fast)
	end)
	box.FocusLost:Connect(function(enterPressed)
		UI.tween(stroke, { Color = C.StrokeSoft }, Theme.Motion.Fast)
		if enterPressed and onSubmit then
			onSubmit(box.Text)
		end
	end)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if maxLength and #box.Text > maxLength then
			box.Text = string.sub(box.Text, 1, maxLength)
			return
		end
		if onChanged then
			onChanged(box.Text)
		end
	end)
	return box
end

--[[ Toggle switch. props: Value, OnChange(value), Parent, Position, LayoutOrder ]]
function UI.toggle(props: { [string]: any })
	local value = props.Value == true
	local button = UI.new("TextButton", {
		Name = props.Name or "Toggle",
		Size = UDim2.fromOffset(54, 28),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.PanelLighter,
		Corner = Theme.Radius.Pill,
		Stroke = { Color = C.Stroke },
		Parent = props.Parent,
	})
	local knob = UI.new("Frame", {
		Size = UDim2.fromOffset(22, 22),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		BackgroundColor3 = C.Text,
		Corner = Theme.Radius.Pill,
		Parent = button,
	})
	local toggle = { Instance = button }
	local function render(animate: boolean)
		local goalPos = if value then UDim2.new(1, -25, 0.5, 0) else UDim2.new(0, 3, 0.5, 0)
		local goalColor = if value then C.Success else C.PanelLighter
		if animate then
			UI.tween(knob, { Position = goalPos }, Theme.Motion.Fast)
			UI.tween(button, { BackgroundColor3 = goalColor }, Theme.Motion.Fast)
		else
			knob.Position = goalPos
			button.BackgroundColor3 = goalColor
		end
	end
	function toggle.Set(v: boolean)
		value = v == true
		render(false)
	end
	button.Activated:Connect(function()
		value = not value
		render(true)
		SoundPlayer.play("UIClick")
		if props.OnChange then
			props.OnChange(value)
		end
	end)
	render(false)
	return toggle
end

--[[
	Slider with − / + buttons (for gamepad and precise input).
	props: Min, Max, Step, Value, OnChange(value), OnCommit(value), Format(value) -> string, Width
	OnChange fires continuously while dragging; OnCommit once the drag ends or a − / + press lands.
]]
function UI.slider(props: { [string]: any })
	local min, max, step = props.Min or 0, props.Max or 1, props.Step or 0.05
	local value = math.clamp(props.Value or min, min, max)
	local width = props.Width or 260
	local root = UI.frame({
		Name = props.Name or "Slider",
		Size = UDim2.fromOffset(width, 30),
		LayoutOrder = props.LayoutOrder,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		Parent = props.Parent,
	})
	local slider = { Instance = root }
	local minus, plus
	local track = UI.new("TextButton", {
		Name = "Track",
		AutoButtonColor = false,
		Text = "",
		Size = UDim2.new(1, -110, 0, 8),
		Position = UDim2.new(0, 34, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.PanelLighter,
		Corner = Theme.Radius.Pill,
		Selectable = false,
		Parent = root,
	})
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.Accent2,
		Corner = Theme.Radius.Pill,
		Parent = track,
	})
	local knob = UI.new("Frame", {
		Size = UDim2.fromOffset(18, 18),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		BackgroundColor3 = C.Text,
		Corner = Theme.Radius.Pill,
		Stroke = { Color = C.Accent2, Thickness = 2 },
		Parent = track,
	})
	local valueLabel = UI.label({
		Size = UDim2.fromOffset(44, 30),
		Position = UDim2.new(1, -44, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = F.Bold,
		TextSize = S.Small,
		TextColor3 = C.TextDim,
		Parent = root,
	})
	local function render()
		local f = (value - min) / (max - min)
		fill.Size = UDim2.fromScale(f, 1)
		knob.Position = UDim2.fromScale(f, 0.5)
		valueLabel.Text = if props.Format then props.Format(value) else tostring(value)
	end
	local function set(v: number, fire: boolean)
		local stepped = math.floor((v - min) / step + 0.5) * step + min
		local clamped = math.clamp(stepped, min, max)
		if math.abs(clamped - value) < 1e-9 then
			return
		end
		value = clamped
		render()
		if fire and props.OnChange then
			props.OnChange(value)
		end
	end
	function slider.Set(v: number)
		value = math.clamp(v, min, max)
		render()
	end
	function slider.Get(): number
		return value
	end
	local dragging = false
	local function commit()
		if props.OnCommit then
			props.OnCommit(value)
		end
	end
	local function fromInput(x: number)
		local absPos = track.AbsolutePosition.X
		local absSize = math.max(1, track.AbsoluteSize.X)
		set(min + (max - min) * math.clamp((x - absPos) / absSize, 0, 1), true)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromInput(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromInput(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			commit()
		end
	end)
	minus = UI.button({
		Text = "−",
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Variant = "ghost",
		TextSize = 18,
		OnClick = function()
			set(value - step, true)
			commit()
		end,
		Parent = root,
	})
	plus = UI.button({
		Text = "+",
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, -72, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Variant = "ghost",
		TextSize = 18,
		OnClick = function()
			set(value + step, true)
			commit()
		end,
		Parent = root,
	})
	slider.Minus, slider.Plus = minus, plus
	render()
	return slider
end

--[[ Segmented control. props: Options = { { Id, Text } }, Value, OnChange(id), ButtonWidth ]]
function UI.segmented(props: { [string]: any })
	local root = UI.new("Frame", {
		Name = props.Name or "Segmented",
		BackgroundColor3 = C.BackgroundAlt,
		-- Buttons + 4 px gaps between them + 4 px padding on each side.
		Size = props.Size or UDim2.fromOffset(#props.Options * (props.ButtonWidth or 70) + (#props.Options - 1) * 4 + 8, 34),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		Corner = Theme.Radius.Small + 2,
		Stroke = { Color = C.StrokeSoft },
		Padding = 4,
		List = { Dir = "X", Pad = 4, VA = "Center" },
		Parent = props.Parent,
	})
	local control = { Instance = root, Buttons = {} }
	local current = props.Value
	local function render()
		for id, button in pairs(control.Buttons) do
			UI.setVariant(button, if id == current then "primary" else "ghost")
		end
	end
	for index, option in ipairs(props.Options) do
		local button = UI.button({
			Text = option.Text,
			Size = UDim2.new(0, props.ButtonWidth or 70, 1, 0),
			LayoutOrder = index,
			TextSize = S.Small,
			Variant = "ghost",
			OnClick = function()
				current = option.Id
				render()
				if props.OnChange then
					props.OnChange(option.Id)
				end
			end,
			Parent = root,
		})
		control.Buttons[option.Id] = button
	end
	function control.Set(id)
		current = id
		render()
	end
	function control.Get()
		return current
	end
	render()
	return control
end

-- Tooltip ----------------------------------------------------------------------------------

local tooltip: Frame? = nil
local tooltipLabel: TextLabel? = nil
local tooltipOwner: Instance? = nil

local function ensureTooltip()
	if tooltip and tooltip.Parent then
		return
	end
	tooltip = UI.new("Frame", {
		Name = "Tooltip",
		BackgroundColor3 = C.BackgroundAlt,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		Visible = false,
		ZIndex = 200,
		Corner = Theme.Radius.Small,
		Stroke = { Color = C.Stroke },
		Padding = { X = 10, Y = 8 },
		MaxSize = Vector2.new(320, 400),
		Parent = UI.overlay(),
	})
	tooltipLabel = UI.label({
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		TextWrapped = true,
		RichText = true,
		TextSize = S.Small,
		ZIndex = 201,
		Parent = tooltip,
	})
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(300, 400), Parent = tooltipLabel })
end

local function positionTooltip()
	if not tooltip or not tooltip.Visible then
		return
	end
	local mouse = UserInputService:GetMouseLocation()
	local v = UI.viewport()
	local size = tooltip.AbsoluteSize
	local x = math.min(mouse.X + 16, v.X - size.X - 8)
	local y = math.min(mouse.Y + 16, v.Y - size.Y - 8)
	tooltip.Position = UDim2.fromOffset(x, y)
end

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		positionTooltip()
	end
end)

function UI.showTooltip(owner: Instance, text: string)
	ensureTooltip()
	tooltipOwner = owner
	local tip = tooltip :: Frame
	local label = tooltipLabel :: TextLabel
	label.Text = text
	tip.Visible = true
	if owner:IsA("GuiObject") and GuiService.SelectedObject == owner then
		local pos = owner.AbsolutePosition
		tip.Position = UDim2.fromOffset(pos.X + owner.AbsoluteSize.X + 8, pos.Y)
	else
		positionTooltip()
	end
end

function UI.hideTooltip(owner: Instance?)
	if tooltip and (owner == nil or owner == tooltipOwner) then
		tooltip.Visible = false
		tooltipOwner = nil
	end
end

-- provider: a string or a function returning a (rich text) string.
function UI.attachTooltip(gui: GuiObject, provider: any)
	local function text(): string?
		if type(provider) == "function" then
			return provider()
		end
		return provider
	end
	local function show()
		local t = text()
		if t and t ~= "" then
			UI.showTooltip(gui, t)
		end
	end
	gui.MouseEnter:Connect(show)
	gui.SelectionGained:Connect(show)
	gui.MouseLeave:Connect(function()
		UI.hideTooltip(gui)
	end)
	gui.SelectionLost:Connect(function()
		UI.hideTooltip(gui)
	end)
	gui.AncestryChanged:Connect(function()
		if not gui:IsDescendantOf(game) then
			UI.hideTooltip(gui)
		end
	end)
end

-- Windows ---------------------------------------------------------------------------------

--[[
	A modal window with a dimmed backdrop, header and body.
	props: Parent, Name, Title, Subtitle, Icon, Size (Vector2 base size),
	       CompactSize (Vector2 for small screens), Accent, Palette, OnClose
	Returns { Root, Panel, Body, Header, Open(), Close(), Toggle(), IsOpen(), SetTitle(), Opened, Closed }
]]
function UI.window(props: { [string]: any })
	local palette = props.Palette or C
	local accent = props.Accent or palette.Accent or C.Accent
	local base = props.Size or Vector2.new(920, 600)
	local compactBase = props.CompactSize or Vector2.new(760, 470)

	local root = UI.frame({
		Name = props.Name or "Window",
		Visible = false,
		ZIndex = 10,
		Parent = props.Parent,
	})
	local dim = UI.new("TextButton", {
		Name = "Backdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Black,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Selectable = false,
		ZIndex = 10,
		Parent = root,
	})
	local panel = UI.new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(base.X, base.Y),
		BackgroundColor3 = palette.Panel or C.Panel,
		BorderSizePixel = 0,
		ZIndex = 11,
		Active = true,
		Corner = Theme.Radius.Large,
		Stroke = { Color = palette.Stroke or C.Stroke, Thickness = 1.5 },
		Parent = root,
	})
	UI.gradient(panel, {
		Color = ColorSequence.new(Theme.lighten(palette.Panel or C.Panel, 0.06), palette.Panel or C.Panel),
		Rotation = 90,
	})
	local fit = Instance.new("UIScale")
	fit.Name = "Fit"
	fit.Parent = panel

	-- Accent line along the top edge.
	UI.new("Frame", {
		Name = "AccentLine",
		Size = UDim2.new(0.4, 0, 0, 3),
		Position = UDim2.new(0.3, 0, 0, 0),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		ZIndex = 12,
		Corner = Theme.Radius.Pill,
		Gradient = {
			Color = ColorSequence.new(accent),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Rotation = 0,
		},
		Parent = panel,
	})

	local header = UI.frame({ Name = "Header", Size = UDim2.new(1, 0, 0, 64), ZIndex = 12, Parent = panel })
	UI.padding(header, { 22, 16, 12, 0 })
	local icon = UI.label({
		Name = "Icon",
		Text = props.Icon or "",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.fromOffset(0, 2),
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 12,
		Parent = header,
	})
	local title = UI.label({
		Name = "Title",
		Text = props.Title or "",
		Font = F.Heading,
		TextSize = S.Title,
		Size = UDim2.new(1, -120, 0, 28),
		Position = UDim2.fromOffset(if props.Icon then 48 else 0, 0),
		ZIndex = 12,
		Parent = header,
	})
	local subtitle = UI.label({
		Name = "Subtitle",
		Text = props.Subtitle or "",
		TextColor3 = palette.TextDim or C.TextDim,
		TextSize = S.Small,
		Size = UDim2.new(1, -120, 0, 18),
		Position = UDim2.fromOffset(if props.Icon then 48 else 0, 28),
		ZIndex = 12,
		Parent = header,
	})
	if not props.Icon then
		icon.Visible = false
	end

	local window: { [string]: any } = {
		Root = root,
		Panel = panel,
		Header = header,
		Opened = Instance.new("BindableEvent"),
		Closed = Instance.new("BindableEvent"),
	}
	local open = false

	local close = UI.button({
		Name = "Close",
		Text = "✕",
		Size = UDim2.fromOffset(40, 40),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Variant = "ghost",
		TextSize = 18,
		ZIndex = 13,
		OnClick = function()
			window.Close()
		end,
		Parent = header,
	})
	window.CloseButton = close

	local body = UI.frame({
		Name = "Body",
		Size = UDim2.new(1, -36, 1, -82),
		Position = UDim2.fromOffset(18, 70),
		ZIndex = 12,
		Parent = panel,
	})
	window.Body = body

	local function refit()
		local compact = UI.isCompact()
		local size = if compact then compactBase else base
		panel.Size = UDim2.fromOffset(size.X, size.Y)
		fit.Scale = UI.fitScale(size.X, size.Y)
		root:SetAttribute("Compact", compact)
	end
	refit()
	UI.onViewportChanged(refit)
	window.Refit = refit

	function window.SetTitle(text: string, sub: string?)
		title.Text = text
		if sub then
			subtitle.Text = sub
		end
	end

	function window.IsOpen(): boolean
		return open
	end

	function window.Open()
		if open then
			return
		end
		open = true
		refit()
		root.Visible = true
		dim.BackgroundTransparency = 1
		local targetScale = fit.Scale
		fit.Scale = targetScale * 0.92
		UI.tween(fit, { Scale = targetScale }, Theme.Motion.Pop)
		UI.tween(dim, { BackgroundTransparency = 0.45 }, Theme.Motion.Normal)
		SoundPlayer.play("UIOpen")
		window.Opened:Fire()
		if UserInputService.GamepadEnabled then
			task.defer(function()
				if open then
					GuiService:Select(body)
				end
			end)
		end
	end

	function window.Close()
		if not open then
			return
		end
		open = false
		UI.hideTooltip()
		if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(root) then
			GuiService.SelectedObject = nil
		end
		local t = UI.tween(fit, { Scale = fit.Scale * 0.94 }, Theme.Motion.Fast)
		UI.tween(dim, { BackgroundTransparency = 1 }, Theme.Motion.Fast)
		if t then
			t.Completed:Wait()
		end
		-- Reopened during the close animation: stay open and don't report a close.
		if open then
			return
		end
		root.Visible = false
		window.Closed:Fire()
		if props.OnClose then
			props.OnClose()
		end
	end

	function window.Toggle()
		if open then
			window.Close()
		else
			window.Open()
		end
	end

	dim.Activated:Connect(function()
		window.Close()
	end)

	return window
end

-- Modal dialogs -----------------------------------------------------------------------------

local function dialog(props: { [string]: any }, withInput: boolean): (boolean, string?)
	local palette = props.Palette or C
	local gui = UI.overlay()
	local root = UI.frame({ Name = "Dialog", ZIndex = 150, Parent = gui })
	local dim = UI.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Black,
		BackgroundTransparency = 0.4,
		AutoButtonColor = false,
		Text = "",
		Selectable = false,
		ZIndex = 150,
		Parent = root,
	})
	local height = if withInput then 250 else 210
	local box = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(440, height),
		BackgroundColor3 = palette.Panel or C.Panel,
		ZIndex = 151,
		Active = true,
		Corner = Theme.Radius.Large,
		Stroke = { Color = if props.Danger then C.Danger else (palette.Stroke or C.Stroke), Thickness = 1.5 },
		Padding = 20,
		Scale = UI.fitScale(440, height, 0.9, 0.8),
		Parent = root,
	})
	UI.label({
		Text = props.Title or "Are you sure?",
		Font = F.Heading,
		TextSize = S.Heading + 2,
		Size = UDim2.new(1, 0, 0, 28),
		ZIndex = 152,
		TextColor3 = if props.Danger then Theme.lighten(C.Danger, 0.2) else C.Text,
		Parent = box,
	})
	UI.label({
		Text = props.Message or "",
		TextColor3 = palette.TextDim or C.TextDim,
		TextSize = S.Body,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, 0, 0, 70),
		Position = UDim2.fromOffset(0, 36),
		ZIndex = 152,
		Parent = box,
	})
	local input: TextBox? = nil
	if withInput then
		input = UI.textbox({
			Placeholder = props.Placeholder or "",
			Text = props.Default or "",
			MaxLength = props.MaxLength or 200,
			Size = UDim2.new(1, 0, 0, 38),
			Position = UDim2.fromOffset(0, 112),
			ZIndex = 152,
			Parent = box,
		})
	end
	local thread = coroutine.running()
	local finished = false
	local function finish(result: boolean)
		if finished then
			return
		end
		finished = true
		local text = if input then input.Text else nil
		root:Destroy()
		task.spawn(thread, result, text)
	end
	local confirm = UI.button({
		Text = props.ConfirmText or "Confirm",
		Variant = if props.Danger then "danger" else "primary",
		Size = UDim2.new(0.5, -6, 0, 42),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		ZIndex = 152,
		OnClick = function()
			if props.RequireText and input and string.lower(input.Text) ~= string.lower(props.RequireText) then
				SoundPlayer.play("Error")
				return
			end
			finish(true)
		end,
		Parent = box,
	})
	local cancel = UI.button({
		Text = props.CancelText or "Cancel",
		Variant = "ghost",
		Size = UDim2.new(0.5, -6, 0, 42),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		ZIndex = 152,
		OnClick = function()
			finish(false)
		end,
		Parent = box,
	})
	dim.Activated:Connect(function()
		finish(false)
	end)
	if UserInputService.GamepadEnabled then
		GuiService.SelectedObject = cancel
	end
	if input and not UserInputService.GamepadEnabled then
		input:CaptureFocus()
	end
	local _ = confirm
	local result, text = coroutine.yield()
	return result, text
end

--[[ Yields until the player answers. props: Title, Message, ConfirmText, CancelText, Danger ]]
function UI.confirm(props: { [string]: any }): boolean
	local result = dialog(props, props.RequireText ~= nil)
	return result
end

--[[ Yields; returns the entered text or nil if cancelled. props: Title, Message, Placeholder, Default, MaxLength ]]
function UI.prompt(props: { [string]: any }): string?
	local ok, text = dialog(props, true)
	if ok then
		return text
	end
	return nil
end

return UI
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="32">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="33">
      <Properties>
        <string name="Name">Admin</string>
      </Properties>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">AdminActions</string>
          <string name="Source"><![CDATA[--[[
	AdminActions (ModuleScript)
	Location: ServerScriptService/Admin/AdminActions
	Depends on: Admin/AdminConfig, Admin/AdminPermissions, Admin/AuditLog, Core/DataOps,
	            Core/DataSchema, Shared/Config/*, Shared/Formulas, Shared/Format,
	            gameplay services (through ctx.Services)

	Every admin operation, declared as data:
	  Permission   permission required (see AdminConfig)
	  Category     rate-limit bucket (AdminConfig.RateLimits.Categories)
	  Target       nil | "online" | "any" | "user"
	               "any" also accepts an offline #UserId (edits their saved data);
	               "user" accepts online players, #UserId or an exact Roblox username
	               and only needs the UserId (bans, staff roles)
	  NoProfile    runs without the target's loaded game data
	  Punitive     cannot target staff of equal or higher rank (except yourself)
	  Destructive  requires a single-use confirmation token
	  Validate(args, ctx) -> clean | nil, error     (all client input checked here)
	  Run(ctx, clean)     -> ok, message, data?     (online execution)
	  Offline(data, clean, ctx) -> ok, message      (pure; only for Target = "any")

	Admin actions call the SAME services and DataOps functions as normal
	gameplay, so every server-side rule (caps, clamping, unknown ids) still
	applies; admins cannot bypass core validation.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")
local StarterPlayer = game:GetService("StarterPlayer")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared.Config
local GameConfig = require(Config.GameConfig)
local Items = require(Config.Items)
local Chests = require(Config.Chests)
local Rarities = require(Config.Rarities)
local Upgrades = require(Config.Upgrades)
local Skills = require(Config.Skills)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Format)
local Loot = require(Shared.Loot)

local Core = script.Parent.Parent.Core
local DataOps = require(Core.DataOps)
local DataSchema = require(Core.DataSchema)
local Guard = require(Core.Guard)

local AdminConfig = require(script.Parent.AdminConfig)
local AdminPermissions = require(script.Parent.AdminPermissions)
local AuditLog = require(script.Parent.AuditLog)
local ModerationStore = require(script.Parent.ModerationStore)

local AdminActions = {}
local startedAt = os.clock()

-- Validation helpers --------------------------------------------------------------

local V = {}

function V.target(value: any): (any, string?)
	if type(value) == "number" and Guard.integer(value, -(2 ^ 52), 2 ^ 52) then
		return value, nil
	end
	local s = Guard.string(value, 50, 1)
	if s then
		return s, nil
	end
	return nil, "Select a player."
end

function V.currency(value: any): (string?, string?)
	if type(value) ~= "string" then
		return nil, "Currency must be Sparks, Gems or Prisms."
	end
	for _, id in ipairs(GameConfig.CurrencyOrder) do
		if string.lower(id) == string.lower(value) then
			return id, nil
		end
	end
	return nil, "Currency must be Sparks, Gems or Prisms."
end

function V.amount(value: any, max: number, allowZero: boolean?): (number?, string?)
	local min = if allowZero then 0 else 1
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return nil, "Amount must be a number."
	end
	value = math.floor(value)
	if value < min then
		return nil, if allowZero then "Amount cannot be negative." else "Amount must be at least 1."
	end
	if value > max then
		return nil, `Amount exceeds your role's limit of {Format.short(max)}.`
	end
	return value, nil
end

function V.lookup(value: any, lookup: { [string]: any }, label: string): (string?, string?)
	local s = Guard.string(value, 64, 1)
	if not s then
		return nil, `Specify a {label}.`
	end
	if lookup[s] then
		return s, nil
	end
	local lower = string.lower(s)
	for id, def in pairs(lookup) do
		if string.lower(id) == lower or (type(def) == "table" and type(def.Name) == "string" and string.lower(def.Name) == lower) then
			return id, nil
		end
	end
	return nil, `Unknown {label} "{s}".`
end

function V.text(value: any, max: number, label: string): (string?, string?)
	if type(value) ~= "string" then
		return nil, `{label} is required.`
	end
	local trimmed = string.gsub(value, "^%s*(.-)%s*$", "%1")
	if #trimmed == 0 then
		return nil, `{label} is required.`
	end
	if #trimmed > max then
		return nil, `{label} is too long (max {max} characters).`
	end
	return trimmed, nil
end

local DURATION_UNITS = { m = 60, h = 3600, d = 86400, w = 604800 }
local MAX_BAN_SECONDS = 3650 * 86400

-- "30m", "12h", "7d", "2w" -> seconds; "perm" / "permanent" / "forever" -> 0 (permanent).
-- Whole seconds are accepted too (that is what a confirmation stores).
function V.duration(value: any): (number?, string?)
	if type(value) == "number" then
		if value == 0 or (value == math.floor(value) and value >= 60 and value <= MAX_BAN_SECONDS) then
			return value, nil
		end
		return nil, "Ban length must be between 1 minute and 10 years (or perm)."
	end
	if type(value) ~= "string" then
		return nil, "Choose a ban length, e.g. 1h, 1d, 7d or perm."
	end
	local s = string.lower((string.gsub(value, "%s", "")))
	if s == "perm" or s == "permanent" or s == "forever" then
		return 0, nil
	end
	local amount, unit = string.match(s, "^(%d+)([mhdw])$")
	local n = tonumber(amount)
	if not n or not unit then
		return nil, "Ban length must look like 30m, 12h, 7d, 2w or perm."
	end
	local seconds = n * DURATION_UNITS[unit]
	if seconds < 60 or seconds > MAX_BAN_SECONDS then
		return nil, "Ban length must be between 1 minute and 10 years (or perm)."
	end
	return seconds, nil
end

-- "moderator" / "mod" / "admin" -> a role an Owner may hand out in the game.
function V.grantableRole(value: any): (string?, string?)
	local s = if type(value) == "string" then string.lower(value) else ""
	local role = if s == "mod" or s == "moderator" then "Moderator" elseif s == "admin" then "Admin" else nil
	if role and ModerationStore.isGrantable(role) then
		return role, nil
	end
	return nil, "Choose a role: " .. table.concat(AdminConfig.Moderation.GrantableRoles, " or ") .. "."
end

function V.int(value: any, min: number, max: number, label: string): (number?, string?)
	local n = Guard.integer(value, min, max)
	if not n then
		return nil, `{label} must be a whole number from {min} to {max}.`
	end
	return n, nil
end

AdminActions.V = V

-- Shared helpers -------------------------------------------------------------------

local function character(player: Player): Model?
	local char = player.Character
	if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
		return char
	end
	return nil
end

local frozen: { [number]: boolean } = {}
AdminActions.Frozen = frozen

local function applyFreeze(player: Player, state: boolean)
	local char = player.Character
	if not char then
		return
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if humanoid then
		if state then
			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0
			humanoid.JumpHeight = 0
		else
			humanoid.WalkSpeed = StarterPlayer.CharacterWalkSpeed
			humanoid.JumpPower = StarterPlayer.CharacterJumpPower
			humanoid.JumpHeight = StarterPlayer.CharacterJumpHeight
		end
	end
	if root and root:IsA("BasePart") then
		root.Anchored = state
	end
end
AdminActions.applyFreeze = applyFreeze

local function finish(ctx, ...: string)
	local services = ctx.Services
	local profile = ctx.TargetProfile
	services.StatsService:Invalidate(profile)
	services.SyncService:MarkDirty(profile, ...)
	services.AchievementService:MarkDirty(profile)
end

local function summarizeProfile(profile, services)
	local data = profile.Data
	local player = profile.Player
	local inventory = {}
	for id, count in pairs(data.Inventory) do
		local item = Items.ById[id]
		table.insert(inventory, { Id = id, Name = item.Name, Rarity = item.Rarity, Count = count, Equipped = table.find(data.Equipped, id) ~= nil })
	end
	table.sort(inventory, function(a, b)
		local ra, rb = Rarities.index(a.Rarity), Rarities.index(b.Rarity)
		if ra == rb then
			return a.Name < b.Name
		end
		return ra > rb
	end)
	local stats = services.StatsService:Get(profile)
	return {
		UserId = player.UserId,
		Name = player.Name,
		DisplayName = player.DisplayName,
		StaffRole = AdminPermissions.roleFor(player),
		Online = true,
		Temporary = profile.Temporary,
		Frozen = frozen[player.UserId] == true,
		SessionMinutes = math.floor((os.clock() - profile.LoadedAt) / 60),
		Currencies = table.clone(data.Currencies),
		Level = data.Level,
		XP = data.XP,
		SkillPoints = data.SkillPoints,
		Rebirths = data.Rebirths,
		Stage = Formulas.stageFor(data.Rebirths).Name,
		Upgrades = table.clone(data.Upgrades),
		Ascension = table.clone(data.Ascension),
		Skills = table.clone(data.Skills),
		Inventory = inventory,
		Equipped = table.clone(data.Equipped),
		Chests = table.clone(data.Chests),
		Stats = table.clone(data.Stats),
		Passes = if services.GamePassService then services.GamePassService:OwnedList(profile) else {},
		Discovered = Formulas.discoveredCount(data),
		Achievements = (function()
			local n = 0
			for _ in pairs(data.Achievements) do
				n += 1
			end
			return n
		end)(),
		Derived = {
			ClickValue = stats.clickValue,
			PassivePerSec = stats.passivePerSec,
			CritChance = stats.critChance,
			Luck = stats.luck,
			AutoRate = stats.autoRate,
		},
		Security = services.SecurityService:GetCounts(player.UserId),
	}
end

local function summarizeOffline(userId: number, data)
	local inventory = {}
	for id, count in pairs(data.Inventory) do
		local item = Items.ById[id]
		table.insert(inventory, { Id = id, Name = item.Name, Rarity = item.Rarity, Count = count })
	end
	return {
		UserId = userId,
		Online = false,
		Currencies = data.Currencies,
		Level = data.Level,
		SkillPoints = data.SkillPoints,
		Rebirths = data.Rebirths,
		Upgrades = data.Upgrades,
		Skills = data.Skills,
		Inventory = inventory,
		Chests = data.Chests,
		Stats = data.Stats,
		Discovered = Formulas.discoveredCount(data),
		LastSeen = data.Meta.LastSeen,
	}
end

local function filterBroadcast(text: string, fromUserId: number): string?
	local TextService = game:GetService("TextService")
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, fromUserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(result) == "string" then
		return result
	end
	return nil
end

local function filterForUser(text: string, fromUserId: number, toUserId: number): string?
	local TextService = game:GetService("TextService")
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, fromUserId, Enum.TextFilterContext.PrivateChat)
		return filtered:GetNonChatStringForUserAsync(toUserId)
	end)
	if ok and type(result) == "string" then
		return result
	end
	return nil
end
AdminActions.filterBroadcast = filterBroadcast

-- Action definitions ------------------------------------------------------------------

local A = {}
AdminActions.Definitions = A

A["hello"] = {
	Quiet = true,
	Permission = "panel.open",
	Category = "read",
	Validate = function()
		return {}
	end,
	Run = function(ctx)
		local role = ctx.Role
		local limits = table.clone(AdminPermissions.limits(role))
		local maxBanDays = limits.MaxBanDays or 0
		limits.MaxBanDays = nil
		return true, "Welcome.", {
			Role = role,
			RoleColor = AdminConfig.Roles[role].Color,
			Rank = AdminPermissions.rank(role),
			Permissions = AdminPermissions.list(role),
			Limits = limits,
			-- 0 = no limit (permanent bans allowed).
			MaxBanDays = if maxBanDays == math.huge then 0 else maxBanDays,
			ModerationPersistent = ModerationStore.Persistent,
			Commands = ctx.Services.AdminService:CommandList(role),
			CrossServer = AdminConfig.CrossServerAnnouncements.Enabled,
			PanelKey = AdminConfig.PanelKey,
			IsStudio = RunService:IsStudio(),
			JobId = game.JobId,
		}
	end,
}

A["dashboard"] = {
	Quiet = true,
	Permission = "panel.open",
	Category = "read",
	Validate = function()
		return {}
	end,
	Run = function(ctx)
		local services = ctx.Services
		local players = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local profile = services.DataService:GetProfile(p)
			table.insert(players, {
				UserId = p.UserId,
				Name = p.Name,
				DisplayName = p.DisplayName,
				Loaded = profile ~= nil,
				Sparks = profile and profile.Data.Currencies.Sparks or 0,
				Rebirths = profile and profile.Data.Rebirths or 0,
				Level = profile and profile.Data.Level or 0,
				Frozen = frozen[p.UserId] == true,
				StaffRole = AdminPermissions.roleFor(p),
			})
		end
		local recent = if AdminPermissions.has(ctx.Role, "logs.view") then AuditLog.recent(8) else {}
		local state = ReplicatedStorage:FindFirstChild("ServerState")
		return true, "OK", {
			Players = players,
			MaxPlayers = Players.MaxPlayers,
			Uptime = os.clock() - startedAt,
			ServerCPS = state and state:GetAttribute("ServerCPS") or 0,
			ServerPresses = state and state:GetAttribute("ServerPresses") or 0,
			MemoryMb = Stats:GetTotalMemoryUsageMb(),
			PhysicsFps = workspace:GetRealPhysicsFPS(),
			HeartbeatMs = Stats.HeartbeatTimeMs,
			Data = services.DataService:GetStatus(),
			Events = services.EventService:GetActive(),
			RecentLogs = recent,
			SecurityFlags = services.SecurityService.TotalFlags,
			RecentSecurity = if AdminPermissions.has(ctx.Role, "logs.view") then services.SecurityService:GetRecent(5) else {},
			AuditPersist = AuditLog.PersistAvailable,
			JobId = game.JobId,
			PlaceVersion = game.PlaceVersion,
		}
	end,
}

A["server.stats"] = {
	Quiet = true,
	Permission = "server.stats",
	Category = "read",
	Validate = function()
