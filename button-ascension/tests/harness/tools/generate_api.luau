--[[
	generate_api.luau
	Regenerates tests/harness/generated/ApiMembers.luau from a luau-lsp
	Roblox definitions file (globalTypes.None.d.luau).

	The Roblox reflection database bundled with Lune describes properties only.
	Events, methods and callbacks come from the luau-lsp definitions:
	  https://raw.githubusercontent.com/JohnnyMorganz/luau-lsp/main/scripts/globalTypes.None.d.luau

	Usage (from button-ascension/):
	  lune run tests/harness/tools/generate_api.luau -- path/to/globalTypes.None.d.luau
]]

local fs = require("@lune/fs")
local process = require("@lune/process")
local roblox = require("@lune/roblox")

local reflection = roblox.getReflectionDatabase()
local isClass = { Object = true }
for _, className in ipairs(reflection:GetClassNames()) do
	isClass[className] = true
end

local input = nil
for _, arg in ipairs(process.args) do
	if arg ~= "--" then
		input = arg
	end
end
assert(input, "usage: lune run tests/harness/tools/generate_api.luau -- <globalTypes.None.d.luau>")
local source = fs.readFile(input)

local classes = {}
local current = nil

for line in string.gmatch(source, "[^\n]+") do
	local name, super = string.match(line, "^declare extern type ([%w_]+) extends ([%w_]+) with")
	if not name then
		name = string.match(line, "^declare extern type ([%w_]+) with")
	end
	if name then
		current = { Super = super, Events = {}, Methods = {}, Callbacks = {} }
		classes[name] = current
	elseif line == "end" then
		current = nil
	elseif current then
		local method = string.match(line, "^\t+function ([%w_]+)%(")
		if method then
			current.Methods[method] = true
		else
			local member, rest = string.match(line, "^\t([%w_]+): (.*)$")
			if member then
				if string.sub(rest, 1, 14) == "RBXScriptSignal" or string.sub(rest, 1, 15) == "RBXScriptSignal" then
					current.Events[member] = true
				elseif string.sub(rest, 1, 1) == "(" and string.find(rest, "%) %->") then
					current.Callbacks[member] = true
				end
			end
		end
	end
end

local function sortedKeys(t)
	local out = {}
	for k in pairs(t) do
		table.insert(out, k)
	end
	table.sort(out)
	return out
end

local function list(t)
	local keys = sortedKeys(t)
	for i, k in ipairs(keys) do
		keys[i] = string.format("%q", k)
	end
	return "{ " .. table.concat(keys, ", ") .. " }"
end

local out = {
	"-- Generated by tests/harness/tools/generate_api.luau. Do not edit by hand.",
	"-- Events, methods and callbacks per Roblox class (from luau-lsp definitions).",
	"return {",
}
local count = 0
for _, name in ipairs(sortedKeys(classes)) do
	local c = classes[name]
	if isClass[name] and (next(c.Events) or next(c.Methods) or next(c.Callbacks) or c.Super) then
		count += 1
		table.insert(
			out,
			string.format(
				"\t[%q] = { Super = %s, Events = %s, Methods = %s, Callbacks = %s },",
				name,
				if c.Super then string.format("%q", c.Super) else "nil",
				list(c.Events),
				list(c.Methods),
				list(c.Callbacks)
			)
		)
	end
end
table.insert(out, "}")
fs.writeFile("tests/harness/generated/ApiMembers.luau", table.concat(out, "\n") .. "\n")
print(("Wrote %d classes to tests/harness/generated/ApiMembers.luau"):format(count))
