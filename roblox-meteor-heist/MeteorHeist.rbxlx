local SLOT_COLS = { -26.25, -15.75, -5.25, 5.25, 15.75, 26.25 } -- 6 Spalten
local SLOT_ROWS = { 0, 11.5, 23 } -- 3 Reihen: Reihe 1 nahe Eingang (Slot 1-6), Reihe 3 hinten (Slot 13-18)

-- Spawn-Platz (hinter dem Bandstart, -Z)
