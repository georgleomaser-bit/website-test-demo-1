-- ---------------------------------------------------------------------
-- NACHT – Tag-Nacht-Zyklus (GraphicsService + NightService)
--   Nach "DayLength" Sekunden Tag kommt "NightLength" Sekunden Nacht.
--   Nachts: Nacht-Eier in den Nestern (NightOnly), Sternschnuppen-Eier fallen aufs Nester-Feld,
--   mehr und schnellere Kreaturen, leuchtende Kisten liegen herum (Geld oder 1 Glücksrad-Dreh).
--   BLUTMOND: jede Nacht mit Chance "BloodMoonChance": roter Himmel, "BloodMoonLuck"x Glück.
-- ---------------------------------------------------------------------
Config.Night = {
	DayLength = 600, -- 10 Min Tag
	NightLength = 180, -- 3 Min Nacht
	FadeTime = 10, -- Sekunden für Sonnenuntergang / Sonnenaufgang
	BloodMoonChance = 0.2, -- 1 von 5 Nächten
	BloodMoonLuck = 2,
	NightEggWeight = 2, -- ein Nacht-Ei wird so oft gewählt wie 2 normale Eier seiner Seltenheit
	-- Sternschnuppen-Eier (gratis, wie im Egg Rush: schnappen und heimtragen)
	StarInterval = { 5, 9 }, -- alle 5-9 Sekunden eine Sternschnuppe
	StarLuck = 2, -- Glück für Sternschnuppen-Eier
	StarLifetime = 45, -- Sekunden, bis ein Sternschnuppen-Ei verschwindet
	-- Leuchtende Kisten
	CrateInterval = 12, -- alle 12 Sekunden eine neue Kiste ...
	MaxCrates = 6, -- ... höchstens so viele gleichzeitig
	CrateLifetime = 60,
	CrateHold = 0.6, -- E halten zum Öffnen
	CrateSpinChance = 0.25, -- sonst Geld
	CrateCashSeconds = 120, -- Geld = 2 Min Einkommen ...
	CrateCashMin = 1000, -- ... mindestens so viel
}

-- ---------------------------------------------------------------------
-- 6) TECHNIK (nur ändern, wenn du weißt was du tust)
--    ACHTUNG: DataStoreName ändern = alle Spielstände sind weg!
-- ---------------------------------------------------------------------
Config.DataStoreName = "MeteorHeist_PlayerData_v1"
Config.LeaderboardStoreName = "MeteorHeist_TopEarned_v1"
Config.MessagingTopic = "MeteorHeist_Admin_v1"
Config.AutoSaveInterval = 90

-- =====================================================================
-- Ab hier: automatisch erzeugte Nachschlage-Tabellen (nicht ändern)
-- =====================================================================
Config.MeteorsById = {}
Config.RaritiesByName = {}
Config.RarityIndex = {}
Config.MutationsByName = {}
Config.GamePassesByKey = {}
Config.ProductsById = {}
Config.ProductsByKey = {}
Config.MeteorsByRarity = {} -- nur Meteore, die von selbst in die Nester kommen (ohne Nacht-Eier)
Config.NightMeteorsByRarity = {} -- Nacht-Eier (NightOnly), kommen nur nachts dazu
Config.MeteorsByRarityAll = {} -- alle Meteore (auch Admin / nicht spawnbare)
Config.AdminMeteors = {} -- alle Meteore mit Rarity "Admin"
Config.TreadmillsById = {}
Config.GadgetsById = {}

for i, rarity in ipairs(Config.Rarities) do
	Config.RaritiesByName[rarity.Name] = rarity
	Config.RarityIndex[rarity.Name] = i
	Config.MeteorsByRarity[rarity.Name] = {}
	Config.MeteorsByRarityAll[rarity.Name] = {}
	Config.NightMeteorsByRarity[rarity.Name] = {}
end
for _, meteor in ipairs(Config.Meteors) do
	assert(Config.MeteorsById[meteor.Id] == nil, "Doppelte Meteor-Id: " .. meteor.Id)
	local rarity = Config.RaritiesByName[meteor.Rarity]
	assert(rarity, "Unbekannte Rarity bei " .. meteor.Id)
	Config.MeteorsById[meteor.Id] = meteor
	table.insert(Config.MeteorsByRarityAll[meteor.Rarity], meteor)
	if meteor.NightOnly == true and meteor.Spawnable ~= false and not rarity.AdminOnly then
		table.insert(Config.NightMeteorsByRarity[meteor.Rarity], meteor)
	elseif meteor.Spawnable ~= false and not rarity.AdminOnly then
		table.insert(Config.MeteorsByRarity[meteor.Rarity], meteor)
	end
	if rarity.AdminOnly then
		table.insert(Config.AdminMeteors, meteor)
	end
	if not Aliens.ByMeteor[meteor.Id] then
		warn("[Config] Für Meteor '" .. meteor.Id .. "' fehlen die Aliens in Aliens.luau!")
	end
end
for _, mutation in ipairs(Config.Mutations) do
	Config.MutationsByName[mutation.Name] = mutation
end
for _, pass in ipairs(Config.GamePasses) do
	Config.GamePassesByKey[pass.Key] = pass
end
for _, product in ipairs(Config.Products) do
	Config.ProductsByKey[product.Key] = product
	if product.Id ~= 0 then
		assert(Config.ProductsById[product.Id] == nil, "Doppelte Product-Id: " .. product.Id)
		Config.ProductsById[product.Id] = product
	end
end
for _, gadget in ipairs(Config.Gadgets) do
	assert(Config.GadgetsById[gadget.Id] == nil, "Doppelte Gadget-Id: " .. gadget.Id)
	Config.GadgetsById[gadget.Id] = gadget
end
if not Config.GadgetsById[Config.StarterPack.Gadget] or not Config.RaritiesByName[Config.StarterPack.EggRarity] then
	warn("[Config] Config.StarterPack: Gadget oder EggRarity gibt es nicht!")
end
if #Config.WheelPrizes ~= 8 then
	warn("[Config] Das Glücksrad braucht genau 8 Felder in Config.WheelPrizes!")
end
for _, heavy in ipairs(Config.HeavyCarry) do
	if not Config.RaritiesByName[heavy.FromRarity] then
		warn("[Config] Config.HeavyCarry: Seltenheit '" .. tostring(heavy.FromRarity) .. "' gibt es nicht!")
	end
end
if not Config.RaritiesByName[Config.Nests.BigMinRarity] or not Config.RaritiesByName[Config.Race.MinRarity] then
	warn("[Config] Config.Nests.BigMinRarity oder Config.Race.MinRarity gibt es nicht!")
end
for i, treadmill in ipairs(Config.Treadmills) do
	assert(Config.TreadmillsById[treadmill.Id] == nil, "Doppelte Laufband-Id: " .. treadmill.Id)
	if i > 1 then
		assert(treadmill.Price >= Config.Treadmills[i - 1].Price, "Laufbänder nach Preis aufsteigend sortieren!")
	end
	Config.TreadmillsById[treadmill.Id] = treadmill
end

-- Hilfsfunktionen, die Server und Client gleich rechnen
function Config.LevelMult(level: number): number
	return 1 + Config.IncomePerLevel * (math.max(1, level) - 1)
end

-- Das geschlüpfte Alien eines Eintrags (nil = noch nicht geschlüpft / unbekannt)
function Config.GetAlien(entry)
	if not entry or entry.Alien == nil then
		return nil
	end
	return Aliens.ById[entry.Alien]
end

-- Anzeigename: Alien-Name wenn geschlüpft, sonst Meteor-Name
function Config.EntryName(entry): string
	local alien = Config.GetAlien(entry)
	if alien then
		return alien.Name
	end
	local def = entry and Config.MeteorsById[entry.Id]
	return def and def.Name or "???"
end

-- Sekunden bis zum Schlüpfen für einen Meteor-Typ
function Config.HatchTime(meteorId: string): number
	local def = Config.MeteorsById[meteorId]
	local rarity = def and Config.RaritiesByName[def.Rarity]
	return rarity and rarity.HatchTime or 10
end

-- Einkommen pro Sekunde: nur geschlüpfte Aliens verdienen Geld!
function Config.MeteorIncome(entry): number
	if not entry or entry.Alien == nil then
		return 0
	end
	local def = Config.MeteorsById[entry.Id]
	if not def then
		return 0
	end
	local alien = Aliens.ById[entry.Alien]
	local mut = Config.MutationsByName[entry.Mut] or Config.Mutations[1]
	local alienMult = alien and alien.IncomeMult or 1
	return def.Income * alienMult * mut.Mult * Config.LevelMult(entry.Lv or 1)
end

-- Wert (Kaufpreis am Nest, Verkaufswert = Wert * SellRatio)
function Config.MeteorValue(entry): number
	local def = entry and Config.MeteorsById[entry.Id]
	if not def then
		return 0
	end
	local alien = entry.Alien ~= nil and Aliens.ById[entry.Alien] or nil
	local mut = Config.MutationsByName[entry.Mut] or Config.Mutations[1]
	local alienMult = alien and alien.IncomeMult or 1
	return def.Price * alienMult * mut.Mult * Config.LevelMult(entry.Lv or 1)
end

function Config.ChargeTime(level: number): number
	return Config.ChargeSecondsPerLevel * level
end

-- Schwere Beute (Config.HeavyCarry): Trage-Faktor für ein seltenes Ei/Alien, nil = nicht schwer
function Config.HeavyFactor(entry): number?
	local def = entry and Config.MeteorsById[entry.Id]
	local index = def and Config.RarityIndex[def.Rarity]
	if not index then
		return nil
	end
	local factor: number? = nil
	for _, heavy in ipairs(Config.HeavyCarry) do
		local from = Config.RarityIndex[heavy.FromRarity]
		if from and index >= from and (factor == nil or heavy.Factor < factor) then
			factor = heavy.Factor
		end
	end
	return factor
end

-- Laufgeschwindigkeit aus den Schritten (logarithmisch, max. MaxWalkSpeed)
function Config.StepsSpeed(steps: number): number
	steps = tonumber(steps) or 0
	if steps ~= steps or steps < 0 then
		steps = 0
	end
	return 16 + math.min(64, math.floor(math.log10(1 + steps) * 6))
end

-- Gehört dieses Laufband dem Spieler? owned = { [Id] = true } (Spielstand) oder Liste von Ids (State).
-- Gratis-Laufbänder (Price 0) hat jeder.
function Config.OwnsTreadmill(owned: any, id: string): boolean
	local def = Config.TreadmillsById[id]
	if not def then
		return false
	end
	if def.Price <= 0 then
		return true
	end
	if type(owned) ~= "table" then
		return false
	end
	return owned[id] == true or table.find(owned, id) ~= nil
end

-- Bestes gekauftes Laufband (Holz ist immer frei)
function Config.BestTreadmill(owned: any)
	local best = Config.Treadmills[1]
	for _, treadmill in ipairs(Config.Treadmills) do
		if Config.OwnsTreadmill(owned, treadmill.Id) then
			best = treadmill
		end
	end
	return best
end

function Config.RebirthCost(rebirths: number): number
	return Config.RebirthBaseCost * Config.RebirthCostGrowth ^ rebirths
end

-- ---------------------------------------------------------------------
-- SCHLÄGER (Nachschlagen) – Werte stehen oben bei Config.Bats
-- ---------------------------------------------------------------------
Config.BatsById = {}
for i, bat in ipairs(Config.Bats) do
	assert(Config.BatsById[bat.Id] == nil, "Doppelte Schläger-Id: " .. bat.Id)
	if i > 1 then
		assert(bat.IndexRequired >= Config.Bats[i - 1].IndexRequired, "Schläger nach IndexRequired sortieren!")
	end
	Config.BatsById[bat.Id] = bat
end

-- Bester Schläger für so viele entdeckte Aliens (und der nächste, falls es noch einen gibt)
function Config.BestBat(indexCount: number)
	local best, nextBat = Config.Bats[1], nil
	for _, bat in ipairs(Config.Bats) do
		if (tonumber(indexCount) or 0) >= bat.IndexRequired then
			best = bat
		elseif not nextBat then
			nextBat = bat
		end
	end
	return best, nextBat
end

-- ---------------------------------------------------------------------
-- ADMIN-PANEL (Kräfte, Grenzen)
-- ---------------------------------------------------------------------
Config.AdminPowers = {
	MinSpeed = 8,
	MaxSpeed = 250, -- Speed-Regler im Admin-Panel
	MinJump = 20,
	MaxJump = 300, -- Sprungkraft-Regler (normal 50)
	DefaultJump = 50,
	RareNestCount = 4, -- so viele seltene Eier bringt "Große Nester" (Admin-Panel)
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[-- Kleine Helfer, die Server UND Client benutzen.

local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234 -> "1.23K", 15000000 -> "15M"
function Util.FormatNumber(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = tostring(math.floor(n))
		return negative and ("-" .. s) or s
	end
	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n = n / 1000
		index += 1
	end
	local text
	if n >= 100 then
		text = string.format("%d", math.floor(n))
	elseif n >= 10 then
		text = string.format("%.1f", math.floor(n * 10) / 10)
	else
		text = string.format("%.2f", math.floor(n * 100) / 100)
	end
	if text:find("%.") then
		text = text:gsub("0+$", ""):gsub("%.$", "")
	end
	return (negative and "-" or "") .. text .. SUFFIXES[index]
end

function Util.FormatCash(n: number): string
	return "$" .. Util.FormatNumber(n)
end

-- 75 -> "1:15"
function Util.FormatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

function Util.DeepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value :: any) do
		copy[k] = Util.DeepCopy(v)
	end
	return copy :: any
end

-- Ergänzt fehlende Felder aus "template" (für Spielstände nach Updates).
function Util.Reconcile(target: { [any]: any }, template: { [any]: any })
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = Util.DeepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" then
			Util.Reconcile(target[k], v)
		end
	end
end

-- Gewichtete Zufallsauswahl: list = { {Weight = 5, ...}, ... }
-- Einträge mit Gewicht 0 werden NIE gewählt (z.B. Admin-Seltenheit).
function Util.WeightedPick(list: { any }, weightOf: ((any) -> number)?, rng: Random?)
	local function weight(item): number
		local w = tonumber(if weightOf then weightOf(item) else item.Weight) or 0
		if w ~= w or w < 0 then
			return 0
		end
		return w
	end
	local total = 0
	local lastPositive = nil
	for _, item in ipairs(list) do
		local w = weight(item)
		total += w
		if w > 0 then
			lastPositive = item
		end
	end
	if total <= 0 then
		return list[1]
	end
	local roll = (rng or Random.new()):NextNumber() * total
	for _, item in ipairs(list) do
		local w = weight(item)
		if w > 0 then
			roll -= w
			if roll <= 0 then
				return item
			end
		end
	end
	-- Rundungsfehler: letzter Eintrag mit Gewicht > 0
	return lastPositive or list[#list]
end

-- Einfache Spam-Bremse pro Spieler.
function Util.RateLimiter(maxCalls: number, perSeconds: number)
	local buckets: { [any]: { number } } = {}
	local limiter = {}
	function limiter.Check(key: any): boolean
		local now = os.clock()
		local bucket = buckets[key]
		if not bucket then
			bucket = {}
			buckets[key] = bucket
		end
		while bucket[1] and now - bucket[1] > perSeconds do
			table.remove(bucket, 1)
		end
		if #bucket >= maxCalls then
			return false
		end
		table.insert(bucket, now)
		return true
	end
	function limiter.Clear(key: any)
		buckets[key] = nil
	end
	return limiter
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- =====================================================================
--  METEOR HEIST – Server-Start
--  Lädt alle Services in der richtigen Reihenfolge. Hier musst du nichts ändern.
-- =====================================================================

local Players = game:GetService("Players")
local ServicesFolder = script.Parent:WaitForChild("Services")

local order = {
	"DataService",
	"MonetizationService",
	"GraphicsService", -- Licht & Himmel (vor der Map)
	"PlotService", -- baut die Map (MapBuilder) + Basen
	"MeteorService", -- Ei-Rennen: Eier in Nestern, Gratis-Zone, Eier am Boden, Schauer, Egg Rush, Rennen
	"NightService", -- Tag-Nacht-Zyklus: Blutmond, Sternschnuppen-Eier, leuchtende Kisten
	"FieldService", -- Nester-Feld: wilde Kreaturen + Speed-Pads
	"CarryService", -- Klauen & Tragen, Schläger
	"GadgetService", -- Speed Coil, Falle, Super-Schlag, Umhang
	"EconomyService",
	"RewardService", -- Spielzeit-Geschenke, Glücksrad, Tagesaufgaben
	"TreadmillService", -- Laufbänder kaufen + Schritte farmen
	"RunService", -- ☄️ Meteor-Run: Lauf-Parcours mit Gratis-Ei als Belohnung
	"TradeService", -- 🤝 Handel zwischen Spielern
	"AdminService",
	"LeaderboardService",
}

local Services = {}
local loaded = {}
for _, name in ipairs(order) do
	local module = ServicesFolder:WaitForChild(name, 10)
	if not module or not module:IsA("ModuleScript") then
		warn("[Meteor Heist] Service fehlt: " .. name)
		continue
	end
	local ok, result = xpcall(require, debug.traceback, module)
	if ok and type(result) == "table" then
		Services[name] = result
		table.insert(loaded, name)
	else
		warn("[Meteor Heist] Fehler beim Laden von " .. name .. ": " .. tostring(result))
	end
end

-- Fehler in einem Service sollen nicht das ganze Spiel stoppen -> klar im Output melden
local function run(name: string, phase: string, fn: (...any) -> ...any, ...: any)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[Meteor Heist] Fehler in " .. name .. "." .. phase .. ": " .. tostring(err))
	end
end

-- Phase 1: Init (Map bauen, Verweise setzen)
for _, name in ipairs(loaded) do
	local service = Services[name]
	if service.Init then
		run(name, "Init", service.Init, Services)
	end
end

-- Phase 2: Start (Schleifen + Events). DataService zuletzt, damit alle
-- "Spielstand geladen"-Callbacks schon registriert sind.
for _, name in ipairs(loaded) do
	local service = Services[name]
	if name ~= "DataService" and service.Start then
		run(name, "Start", service.Start)
	end
end
if Services.DataService then
	run("DataService", "Start", Services.DataService.Start)
end

Players.CharacterAutoLoads = true
print("[Meteor Heist] Server gestartet ✅")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[-- Admin-Panel (Server-Seite). JEDE Aktion prüft hier auf dem Server, ob der Spieler
-- der Besitzer des Spiels ist oder in Config.AdminUserIds steht. Exploiter können das Panel also nicht benutzen,
-- selbst wenn sie es sich im Client anzeigen lassen.

local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Aliens = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Aliens"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))

local AdminService = {}
local Services
local limiter = Util.RateLimiter(12, 1)

local adminCache: { [Player]: boolean } = {}
local warnedDenied: { [Player]: boolean } = {} -- "Unerlaubter Zugriff" nur einmal pro Spieler ins Log
local joinedAt: { [Player]: number } = {} -- für die Spielzeit in der Spielerliste
local serverStartedAt = os.clock()
local serverLocked = false -- Server sperren: neue Spieler (außer Admins) werden mit Meldung gekickt
local LOCKED_KICK_TEXT = "Dieser Server ist gerade gesperrt. Bitte such dir einen anderen Server."
-- In dieser Sitzung gebannte Spieler (Roblox liefert keine Liste aller Banns – nur den Verlauf je Spieler)
type BanRecord = { UserId: number, Name: string, Reason: string, Days: number, Time: number, Active: boolean }
local sessionBans: { BanRecord } = {}
local MAX_SESSION_BANS = 50

-- Gehört das Spiel diesem Spieler? (Spiel unter dem eigenen Account veröffentlicht)
-- Bei Gruppen-Spielen: Admins per UserId in Config.AdminUserIds eintragen.
local function isGameOwner(player: Player): boolean
	return Config.OwnerIsAdmin
		and game.CreatorType == Enum.CreatorType.User
		and game.CreatorId ~= 0
		and player.UserId == game.CreatorId
end

local function computeAdmin(player: Player): boolean
	if table.find(Config.AdminUserIds, player.UserId) then
		return true
	end
	if isGameOwner(player) then
		return true
	end
	return RunService:IsStudio() and Config.StudioIsAdmin
end

function AdminService.IsAdmin(player: Player): boolean
	local cached = adminCache[player]
	if cached == nil then
		cached = computeAdmin(player)
		if player.Parent then
			adminCache[player] = cached
		end
	end
	return cached
end

-- "me", "all", "others", UserId oder (Teil vom) Namen
local function resolveTargets(admin: Player, text: any): { Player }
	if type(text) ~= "string" or text == "" or text:lower() == "me" then
		return { admin }
	end
	local userId = tonumber(text)
	if userId then
		local byId = Players:GetPlayerByUserId(userId)
		if byId then
			return { byId }
		end
	end
	local lower = text:lower()
	if lower == "all" then
		return Players:GetPlayers()
	end
	if lower == "others" then
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= admin then
				table.insert(list, p)
			end
		end
		return list
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower() == lower or p.DisplayName:lower() == lower then
			return { p }
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #lower) == lower or p.DisplayName:lower():sub(1, #lower) == lower then
			return { p }
		end
	end
	return {}
end

local function num(value: any, default: number, min: number, max: number): number
	local n = tonumber(value)
	if not n or n ~= n then
		return default
	end
	return math.clamp(n, min, max)
end

local function names(list: { Player }): string
	local out = {}
	for _, p in ipairs(list) do
		table.insert(out, p.DisplayName)
	end
	return table.concat(out, ", ")
end

local function filterBroadcast(text: string, fromUserId: number): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, fromUserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	return ok and result or nil
end

-- -------------------------------------------------------------------
-- SERVERÜBERGREIFEND (alle Server gleichzeitig)
-- -------------------------------------------------------------------
-- -------------------------------------------------------------------
-- ADMIN ABUSE (Spaß-Befehle)
-- -------------------------------------------------------------------
local DEFAULT_GRAVITY = 196.2
local MOON_GRAVITY = 45
local gravityToken = 0

local function setGravity(value: number, seconds: number?)
	gravityToken += 1
	local token = gravityToken
	workspace.Gravity = value
	if seconds then
		task.delay(seconds, function()
			if gravityToken == token then
				workspace.Gravity = DEFAULT_GRAVITY
			end
		end)
	end
end

local function runAdminAbuse()
	Services.EconomyService.NotifyAll(
		"😈 ADMIN ABUSE! 10x Glück, Meteoritenschauer, Geld für alle, Gratis-Secrets, ein Admin-Meteor & Mond-Schwerkraft!",
		"Event"
	)
	Services.MeteorService.SetServerLuck(10, workspace:GetServerTimeNow() + 600)
	Services.MeteorService.StartShower(120)
	setGravity(MOON_GRAVITY, 90)
	for _, p in ipairs(Players:GetPlayers()) do
		local gift = math.floor(math.max(10000, Services.EconomyService.GetIncome(p) * 600))
		Services.EconomyService.AddCash(p, gift)
		Services.EconomyService.Notify(p, "🎁 Admin-Geschenk: " .. Util.FormatCash(gift), "Success")
		Services.EconomyService.Effect(p, "Confetti", 3)
	end
	task.spawn(function()
		-- Gratis-Meteore regnen in die Gratis-Zone, zum Schluss ein Admin-Meteor
		for i = 1, 6 do
			Services.MeteorService.SpawnStatic({
				Rarity = i <= 2 and "Secret" or "Mythic",
				Free = true,
				Announce = false,
			})
			task.wait(1.5)
		end
		local def = Services.MeteorService.RandomAdminMeteor()
		if def then
			Services.MeteorService.SpawnStatic({ Id = def.Id, Mut = "Normal", Free = true, Announce = false })
			Services.EconomyService.NotifyAll(
				"👑 Ein ADMIN-METEOR (" .. def.Name .. ") ist in der Gratis-Zone gelandet! SCHNELL! 🏃",
				"Event"
			)
		end
	end)
end

local function getRoot(p: Player): BasePart?
	local character = p.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Bodenhöhe unter einer Position (ignoriert Spieler und Meteore)
local function groundBelow(position: Vector3): Vector3
	local ignore: { Instance } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	local map = Services.PlotService.MapFolder
	if map then
		for _, name in ipairs({ "NestMeteors", "GroundMeteors" }) do
			local folder = map:FindFirstChild(name)
			if folder then
				table.insert(ignore, folder)
			end
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local result = workspace:Raycast(position + Vector3.new(0, 4, 0), Vector3.new(0, -60, 0), params)
	if result then
		return result.Position
	end
	return Vector3.new(position.X, 0.2, position.Z)
end

local function setInvisible(p: Player, invisible: boolean)
	local character = p.Character
	if not character then
		return
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			if invisible then
				if d:GetAttribute("AdminOrigT") == nil then
					d:SetAttribute("AdminOrigT", d.Transparency)
				end
				d.Transparency = 1
			else
				local orig = d:GetAttribute("AdminOrigT")
				if orig ~= nil then
					d.Transparency = orig
					d:SetAttribute("AdminOrigT", nil)
				end
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = invisible and Enum.HumanoidDisplayDistanceType.None
			or Enum.HumanoidDisplayDistanceType.Viewer
	end
	local head = character:FindFirstChild("Head")
	local overhead = head and head:FindFirstChild("OverheadTag")
	if overhead and overhead:IsA("BillboardGui") then
		overhead.Enabled = not invisible
	end
end

local function setScale(p: Player, scale: number): boolean
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid then
		return false
	end
	local found = false
	for _, name in ipairs({ "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale" }) do
		local value = humanoid:FindFirstChild(name)
		if value and value:IsA("NumberValue") then
			value.Value = scale
			found = true
		end
	end
	if not found then
		-- Fallback (z.B. R6-Avatare)
		local ok = pcall(function()
			character:ScaleTo(scale)
		end)
		found = ok
	end
	return found
end

-- Schild über dem Kopf: 🛠️ ADMIN (Besitzer/Admins) oder 👑 VIP (VIP-Gamepass)
local function updateTag(p: Player)
	local character = p.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("OverheadTag")
	if old then
		old:Destroy()
	end
	local text, color
	if p:GetAttribute("IsAdmin") == true and not RunService:IsStudio() then
		text, color = "🛠️ ADMIN", Color3.fromRGB(255, 80, 80)
	elseif p:GetAttribute("VIP") == true then
		text, color = "👑 VIP", Color3.fromRGB(255, 205, 60)
	end
	if not text then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "OverheadTag"
	gui.Size = UDim2.new(0, 120, 0, 28)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Enabled = head.Transparency < 1
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = head
end

-- -------------------------------------------------------------------
-- EVENTS (Nacht / Blutmond kommen vom Nacht-System – defensiv aufrufen, falls es fehlt)
-- -------------------------------------------------------------------
-- Ruft service[fnName](...) auf, wenn es die Funktion gibt. true = aufgerufen ohne Fehler
local function tryCall(serviceName: string, fnName: string, ...: any): boolean
	local service = Services[serviceName]
	local fn = type(service) == "table" and service[fnName] or nil
	if type(fn) ~= "function" then
		return false
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[Admin] " .. serviceName .. "." .. fnName .. " fehlgeschlagen: " .. tostring(err))
	end
	return ok
end

-- Läuft gerade eine Nacht? (fragt das Nacht-System, sonst die Attribute in ReplicatedStorage)
local function nightStatus(): string?
	local night = Services.NightService
	if type(night) == "table" and type(night.IsNight) == "function" then
		local ok, isNight = pcall(night.IsNight)
		if ok then
			if not isNight then
				return nil
			end
			local okBlood, blood = pcall(function()
				return type(night.IsBloodMoon) == "function" and night.IsBloodMoon()
			end)
			return if okBlood and blood then "Blutmond" else "Nacht"
		end
	end
	if ReplicatedStorage:GetAttribute("IsNight") ~= true then
		return nil
	end
	return if ReplicatedStorage:GetAttribute("BloodMoon") == true then "Blutmond" else "Nacht"
end

-- mode = "Night" | "BloodMoon" | "End". true = das Nacht-System hat reagiert
-- (NightService direkt, sonst über MeteorService)
local function runNight(mode: string): boolean
	if mode == "End" then
		return tryCall("NightService", "EndNight") or tryCall("MeteorService", "EndNight")
	end
	local blood = mode == "BloodMoon"
	return tryCall("NightService", "StartNight", blood) or tryCall("MeteorService", "StartNight", blood)
end

-- Große Nester: mehrere seltene Eier (ab Legendary) erscheinen in den großen Nestern
local function runRareNests(count: number): number
	local from = Config.RarityIndex.Legendary or 5
	local pool: { string } = {}
	for i, rarity in ipairs(Config.Rarities) do
		local list = Config.MeteorsByRarity[rarity.Name]
		if i >= from and not rarity.AdminOnly and list and #list > 0 then
			table.insert(pool, rarity.Name)
		end
	end
	if #pool == 0 then
		return 0
	end
	for i = 1, count do
		-- meist die kleinste Seltenheit ab Legendary, ab und zu eine höhere
		local pick = math.min(#pool, 1 + math.floor(math.random() ^ 2 * #pool))
		Services.MeteorService.QueueNest({ Rarity = pool[pick], Announce = i == 1 })
	end
	Services.EconomyService.NotifyAll("🥚 Seltene Eier in den großen Nestern!", "Event")
	return count
end

-- Große Admin-Ansage oben in der Mitte (Client: Effects "Announce" mit Kopfbild, Name + Haken, Text).
-- text ist schon gefiltert (TextService), userId/name = Absender.
local function showAnnouncement(text: string, userId: number, name: string)
	if #text == 0 or #text > 200 then
		return
	end
	Remotes.Effect:FireAllClients("Announce", 0, { Text = text, UserId = userId, Name = string.sub(name, 1, 40) })
end

local function handleGlobal(message)
	if type(message) ~= "table" then
		return
	end
	if message.Type == "Announce" and type(message.Text) == "string" then
		showAnnouncement(message.Text, tonumber(message.UserId) or 0, tostring(message.Name or "Admin"))
	elseif message.Type == "Luck" then
		Services.MeteorService.SetServerLuck(num(message.Mult, 1, 1, 100), num(message.Until, 0, 0, math.huge))
		Services.EconomyService.NotifyAll(
			"🍀 ADMIN-EVENT: " .. message.Mult .. "x Glück auf ALLEN Servern!",
			"Event"
		)
	elseif message.Type == "Shower" then
		Services.MeteorService.StartShower(num(message.Seconds, Config.ShowerDuration, 10, 3600))
	elseif message.Type == "AdminAbuse" then
		runAdminAbuse()
	elseif message.Type == "Gravity" then
		setGravity(num(message.Value, DEFAULT_GRAVITY, 5, 500))
	elseif message.Type == "Night" then
		runNight(tostring(message.Mode))
	elseif message.Type == "EggRush" then
		Services.MeteorService.StartEggRush()
	elseif message.Type == "RareNests" then
		runRareNests(num(message.Count, 4, 1, 10))
	elseif message.Type == "RaceEvent" then
		Services.MeteorService.StartRace()
	end
end

local function publishGlobal(message): boolean
	local ok, err = pcall(MessagingService.PublishAsync, MessagingService, Config.MessagingTopic, message)
	if not ok then
		warn("[Admin] Global senden fehlgeschlagen: " .. tostring(err))
		handleGlobal(message) -- wenigstens auf diesem Server
	end
	return ok
end

-- -------------------------------------------------------------------
-- FOTO-MODUS (schöne Thumbnail-Screenshots)
-- -------------------------------------------------------------------
local photoRng = Random.new()
local SHOWCASE_DISTANCE = 14 -- Studs vor dem Admin
local SHOWCASE_GAP = 2.5 -- Lücke zwischen zwei Meteoren
local SHOWCASE_LIFETIME = 300 -- Sekunden
-- (nur Seltenheiten, die es in Config.Rarities gibt – siehe Filter unten)
local PHOTO_RARITIES = { "Legendary", "Mythic", "Celestial", "Divine", "Secret", "Godly", "Cosmic", "Infinity" }
for i = #PHOTO_RARITIES, 1, -1 do
	if not Config.RaritiesByName[PHOTO_RARITIES[i]] then
		table.remove(PHOTO_RARITIES, i)
	end
end
local PHOTO_LUCK = 8
local ADMIN_METEOR_LIFETIME = 300 -- Sekunden in der Gratis-Zone
-- Admin-Meteore haben Umriss, starkes Licht und Aura -> per "Spawnen" höchstens so viele auf einmal
local MAX_ADMIN_METEOR_SPAWN = 5
-- Öfter Gold/Diamond/Galaxy als Normal – glänzt schöner auf dem Foto
local PHOTO_MUTATIONS = {
	{ Name = "Normal", Weight = 12 },
	{ Name = "Gold", Weight = 24 },
	{ Name = "Diamond", Weight = 20 },
	{ Name = "Galaxy", Weight = 16 },
	{ Name = "Frost", Weight = 10 },
	{ Name = "Lava", Weight = 10 },
	{ Name = "Rainbow", Weight = 8 },
}

-- Zufälliges Deko-Alien für die Foto-Base (wird NICHT gespeichert)
local function photoEntry()
	local rarity = PHOTO_RARITIES[photoRng:NextInteger(1, #PHOTO_RARITIES)]
	local def = Services.MeteorService.RandomOfRarity(rarity)
	if not def then
		return nil
	end
	local mut = Util.WeightedPick(PHOTO_MUTATIONS, nil, photoRng)
	local level = math.min(photoRng:NextInteger(10, 20), Config.MaxLevel)
	-- viel Glück -> öfter Selten/Ultra-Aliens (sieht auf dem Foto besser aus)
	local alien = Aliens.Roll(def.Id, PHOTO_LUCK, photoRng)
	return { Id = def.Id, Alien = alien, Mut = mut.Name, Lv = level, Xp = 0, Hatch = 0 }
end

-- Je der teuerste Meteor jeder Seltenheit (Common zuerst, Admin zuletzt)
local function showcaseDefs()
	local list = {}
	for _, rarity in ipairs(Config.Rarities) do
		local best = nil
		for _, def in ipairs(Config.MeteorsByRarityAll[rarity.Name]) do
			if not best or def.Price > best.Price then
				best = def
			end
		end
		if best then
			table.insert(list, best)
		end
	end
	return list
end

-- Admin-Meteor aus der Anfrage (nur Rarity "Admin")
local function adminMeteorDef(id: any)
	local def = type(id) == "string" and Config.MeteorsById[id]
	if def and Config.RaritiesByName[def.Rarity].AdminOnly then
		return def
	end
	return nil
end

-- Admin-Meteor in die Gratis-Zone: großer Einschlag + Ansage an alle
local function dropAdminMeteor(def, mutation: string?)
	local record = Services.MeteorService.SpawnStatic({
		Id = def.Id,
		Mut = Config.MutationsByName[mutation] and mutation or "Normal",
		Free = true,
		Announce = false,
		Lifetime = ADMIN_METEOR_LIFETIME,
	})
	return record ~= nil
end

-- -------------------------------------------------------------------
-- AKTIONEN
-- -------------------------------------------------------------------
local Actions = {}

-- Ping eines Spielers in Millisekunden (nil = nicht verfügbar)
local function pingMs(p: Player): number?
	local ok, seconds = pcall(function()
		return p:GetNetworkPing()
	end)
	if ok and type(seconds) == "number" and seconds == seconds and seconds >= 0 then
		return math.floor(seconds * 1000 + 0.5)
	end
	return nil
end

function Actions.GetPlayers(_admin)
	local list = {}
	local now = os.clock()
	for _, p in ipairs(Players:GetPlayers()) do
		local data = Services.DataService.Get(p)
		table.insert(list, {
			Name = p.Name,
			DisplayName = p.DisplayName,
			UserId = p.UserId,
			Cash = data and data.Cash or 0,
			Rebirths = data and data.Rebirths or 0,
			Steps = data and data.Steps or 0,
			Index = data and Services.EconomyService.IndexCount(data) or 0,
			PlayTime = math.floor(now - (joinedAt[p] or now)),
			Ping = pingMs(p),
			IsAdmin = AdminService.IsAdmin(p),
		})
	end
	return true, #list .. " Spieler geladen", list
end

-- Where: "Nest" (Standard: ins Nester-Feld), "Free" (Gratis-Zone) oder "Me" (vor dem Admin)
function Actions.SpawnMeteor(admin, args)
	local id = args.MeteorId
	if type(id) ~= "string" or not Config.MeteorsById[id] then
		return false, "Unbekannter Meteor"
	end
	local count = math.floor(num(args.Count, 1, 1, 25))
	if Config.RaritiesByName[Config.MeteorsById[id].Rarity].AdminOnly then
		count = math.min(count, MAX_ADMIN_METEOR_SPAWN)
	end
	local mutation = Config.MutationsByName[args.Mutation] and args.Mutation or "Normal"
	local where = args.Where
	local origin, right, forward = nil, nil, nil
	if where == "Me" then
		local root = getRoot(admin)
		if not root then
			return false, "Kein Charakter"
		end
		local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
		forward = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
		right = forward:Cross(Vector3.yAxis)
		origin = groundBelow(root.Position + forward * 10)
	end
	local spacing = MeteorFactory.GetSize({ Id = id, Lv = 1 }) + 2
	for i = 1, count do
		local opts: { [string]: any } = {
			Id = id,
			Mut = mutation,
			Free = args.Free == true or where == "Free",
			Announce = i == 1,
			Instant = where == "Me",
		}
		if origin and right and forward then
			-- Raster aus 5er-Reihen vor dem Admin
			local column = (i - 1) % 5 - 2
			local row = math.floor((i - 1) / 5)
			opts.Position = origin + right * column * spacing + forward * row * spacing
			Services.MeteorService.SpawnStatic(opts)
		elseif where == "Free" then
			Services.MeteorService.SpawnStatic(opts)
		else
			Services.MeteorService.QueueNest(opts)
		end
	end
	local target = where == "Me" and "vor dir" or (where == "Free" and "in der Gratis-Zone" or "ins Nester-Feld")
	return true, count .. "x " .. Config.MeteorsById[id].Name .. " " .. target
end

function Actions.MeteorRain(_admin, args)
	local rarity = Config.RaritiesByName[args.Rarity] and args.Rarity or nil
	local count = math.floor(num(args.Count, 10, 1, 40))
	for _ = 1, count do
		Services.MeteorService.QueueNest({ Rarity = rarity, Announce = false })
	end
	Services.EconomyService.NotifyAll(
		"☄️ Admin-Eierregen in den Nestern" .. (rarity and (" (" .. rarity .. ")") or "") .. "!",
		"Event"
	)
	return true, count .. " Eier kommen in die Nester"
end

function Actions.GiveMeteor(admin, args)
	if not Config.MeteorsById[args.MeteorId] then
		return false, "Unbekannter Meteor"
	end
	local targets = resolveTargets(admin, args.Target)
	local given = 0
	for _, p in ipairs(targets) do
		-- Hatched = true -> sofort ein Alien (AlienId wählbar, sonst gewürfelt)
		local alien = nil
		if args.Hatched == true or args.AlienId ~= nil then
			local wanted = Aliens.ById[args.AlienId]
			alien = (wanted and wanted.Meteor == args.MeteorId) and wanted.Id or Aliens.Roll(args.MeteorId)
		end
		local ok = Services.EconomyService.GiveMeteor(p, {
			Id = args.MeteorId,
			Mut = args.Mutation,
			Lv = num(args.Level, 1, 1, Config.MaxLevel),
			Alien = alien,
		})
		if ok then
			given += 1
			Services.EconomyService.Notify(
				p,
				"🎁 Ein Admin hat dir " .. Config.MeteorsById[args.MeteorId].Name .. " geschenkt!",
				"Success"
			)
		end
	end
	return given > 0, "An " .. given .. " Spieler gegeben" .. (given < #targets and " (manche Basen voll)" or "")
end

function Actions.GiveCash(admin, args)
	local amount = num(args.Amount, 0, -1e18, 1e18)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		Services.EconomyService.AddCash(p, amount)
	end
	return #targets > 0, Util.FormatCash(amount) .. " an " .. names(targets)
end

function Actions.SetCash(admin, args)
	local amount = num(args.Amount, 0, 0, 1e18)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		if data then
			data.Cash = amount
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "Cash = " .. Util.FormatCash(amount) .. " für " .. names(targets)
end

function Actions.SetRebirths(admin, args)
	local amount = math.floor(num(args.Amount, 0, 0, 1000))
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		if data then
			data.Rebirths = amount
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "Rebirths = " .. amount .. " für " .. names(targets)
end

function Actions.SetSteps(admin, args)
	local amount = math.floor(num(args.Amount, 0, 0, 1e18))
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		if data then
			data.Steps = amount
			Services.EconomyService.ApplySpeed(p)
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "👟 Schritte = " .. Util.FormatNumber(amount) .. " für " .. names(targets)
end

-- 👑 Admin-Meteor: Where = "Free" (gratis in die Gratis-Zone) oder "Base" (eigene Base)
function Actions.SpawnAdminMeteor(admin, args)
	local def = adminMeteorDef(args.MeteorId)
	if not def then
		return false, "Kein Admin-Meteor"
	end
	if args.Where == "Base" then
		local ok = Services.EconomyService.GiveMeteor(admin, {
			Id = def.Id,
			Mut = Config.MutationsByName[args.Mutation] and args.Mutation or "Normal",
			Lv = 1,
		}, true)
		if not ok then
			return false, "Deine Base ist voll (oder du hast keine)"
		end
		return true, "👑 " .. def.Name .. " fliegt in deine Base!"
	end
	if not dropAdminMeteor(def, args.Mutation) then
		return false, "Spawnen fehlgeschlagen"
	end
	Services.EconomyService.NotifyAll(
		"👑 ADMIN-METEOR: " .. def.Name .. " landet in der Gratis-Zone! GRATIS – SCHNELL HIN! 🏃",
		"Event"
	)
	return true, "👑 " .. def.Name .. " in der Gratis-Zone"
end

-- 👑 Admin-Meteor-Regen: 1-8 zufällige Admin-Meteore gratis in die Gratis-Zone
function Actions.AdminRain(_admin, args)
	local count = math.floor(num(args.Count, 3, 1, 8))
	if #Config.AdminMeteors == 0 then
		return false, "Keine Admin-Meteore in Config"
	end
	Services.EconomyService.NotifyAll(
		"👑 ADMIN-METEOR-REGEN! " .. count .. "x GRATIS in der Gratis-Zone! 🏃",
		"Event"
	)
	task.spawn(function()
		for _ = 1, count do
			local def = Services.MeteorService.RandomAdminMeteor()
			if def then
				dropAdminMeteor(def, "Normal")
			end
			task.wait(0.8)
		end
	end)
	return true, "👑 " .. count .. " Admin-Meteore regnen herab"
end

function Actions.GivePass(admin, args)
	if not Config.GamePassesByKey[args.PassKey] then
		return false, "Unbekannter Pass"
	end
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		Services.MonetizationService.GrantPassSession(p, args.PassKey)
	end
	return #targets > 0, args.PassKey .. " (bis Server-Wechsel) für " .. names(targets)
end

function Actions.StartShower(_admin, args)
	local seconds = num(args.Seconds, Config.ShowerDuration, 10, 3600)
	if args.Global then
		publishGlobal({ Type = "Shower", Seconds = seconds })
		return true, "Schauer auf ALLEN Servern"
	end
	Services.MeteorService.StartShower(seconds)
	return true, "Meteoritenschauer gestartet (" .. seconds .. "s)"
end

function Actions.ServerLuck(_admin, args)
	local mult = num(args.Mult, 2, 1, 100)
	local minutes = num(args.Minutes, 10, 1, 24 * 60)
	local untilTime = workspace:GetServerTimeNow() + minutes * 60
	if args.Global then
		publishGlobal({ Type = "Luck", Mult = mult, Until = untilTime })
		return true, mult .. "x Glück auf ALLEN Servern für " .. minutes .. " Min"
	end
	Services.MeteorService.SetServerLuck(mult, untilTime)
	Services.EconomyService.NotifyAll(
		"🍀 ADMIN-EVENT: " .. mult .. "x Glück für " .. minutes .. " Minuten!",
		"Event"
	)
	return true, mult .. "x Glück für " .. minutes .. " Min"
end

function Actions.Announce(admin, args)
	if type(args.Text) ~= "string" or #args.Text == 0 or #args.Text > 200 then
		return false, "Text 1-200 Zeichen"
	end
	local filtered = filterBroadcast(args.Text, admin.UserId)
	if not filtered then
		return false, "Text-Filter nicht erreichbar"
	end
	if args.Global then
		publishGlobal({ Type = "Announce", Text = filtered, UserId = admin.UserId, Name = admin.DisplayName })
		return true, "An ALLE Server gesendet"
	end
	showAnnouncement(filtered, admin.UserId, admin.DisplayName)
	return true, "Gesendet"
end

function Actions.Kick(admin, args)
	local targets = resolveTargets(admin, args.Target)
	local reason = type(args.Reason) == "string" and args.Reason ~= "" and args.Reason or "Vom Admin gekickt"
	local kicked = {}
	for _, p in ipairs(targets) do
		if p ~= admin then
			table.insert(kicked, p.DisplayName)
			p:Kick(reason)
		end
	end
	return #kicked > 0, "Gekickt: " .. table.concat(kicked, ", ")
end

function Actions.Ban(admin, args)
	local userId = tonumber(args.Target)
	local display = tostring(args.Target)
	if not userId then
		local targets = resolveTargets(admin, args.Target)
		if #targets ~= 1 or targets[1] == admin then
			return false, "Genau EINEN Spieler (Name oder UserId) angeben"
		end
		userId = targets[1].UserId
		display = targets[1].DisplayName
	end
	local isOwner = game.CreatorType == Enum.CreatorType.User and userId == game.CreatorId
	if userId == admin.UserId or isOwner or table.find(Config.AdminUserIds, userId) then
		return false, "Admins können nicht gebannt werden"
	end
	local days = num(args.Days, 0, 0, 3650)
	local reason = type(args.Reason) == "string" and args.Reason ~= "" and args.Reason or "Regelverstoß"
	local ok, err = pcall(function()
		Players:BanAsync({
			UserIds = { userId },
			ApplyToUniverse = true,
			Duration = days > 0 and math.floor(days * 86400) or -1,
			DisplayReason = reason,
			PrivateReason = "Gebannt von " .. admin.Name .. " (" .. admin.UserId .. ")",
			ExcludeAltAccounts = false,
		})
	end)
	if not ok then
		return false, "Bann fehlgeschlagen: " .. tostring(err)
	end
	table.insert(sessionBans, {
		UserId = userId,
		Name = display,
		Reason = reason,
		Days = days,
		Time = os.time(),
		Active = true,
	})
	while #sessionBans > MAX_SESSION_BANS do
		table.remove(sessionBans, 1)
	end
	return true, display .. " gebannt (" .. (days > 0 and (days .. " Tage") or "für immer") .. ")"
end

function Actions.Unban(_admin, args)
	local userId = tonumber(args.Target)
	if not userId then
		return false, "UserId (Zahl) angeben"
	end
	local ok, err = pcall(function()
		Players:UnbanAsync({ UserIds = { userId }, ApplyToUniverse = true })
	end)
	if not ok then
		return false, "Entbannen fehlgeschlagen: " .. tostring(err)
	end
	for _, record in ipairs(sessionBans) do
		if record.UserId == userId then
			record.Active = false
		end
	end
	return true, userId .. " entbannt"
end

function Actions.ClearBase(admin, args)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		local plot = Services.PlotService.GetPlot(p)
		if data then
			if plot then
				Services.CarryService.CancelStealsFromPlot(plot, "cancelled")
			end
			data.Meteors = {}
			if plot then
				Services.PlotService.RenderAll(plot)
			end
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "Base geleert: " .. names(targets)
end

function Actions.ResetData(admin, args)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local plot = Services.PlotService.GetPlot(p)
		if Services.CarryService.IsCarrying(p) then
			Services.CarryService.Fail(p, "cancelled")
		end
		if plot then
			Services.CarryService.CancelStealsFromPlot(plot, "cancelled")
		end
		Services.DataService.Reset(p)
		if plot then
			Services.PlotService.RenderAll(plot)
		end
		Services.EconomyService.ApplySpeed(p)
		Services.EconomyService.MarkDirty(p)
	end
	return #targets > 0, "Spielstand zurückgesetzt: " .. names(targets)
end

function Actions.TeleportTo(admin, args)
	local target = resolveTargets(admin, args.Target)[1]
	local root = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if not root or not admin.Character then
		return false, "Spieler nicht gefunden"
	end
	admin.Character:PivotTo((root :: BasePart).CFrame * CFrame.new(0, 0, 4))
	return true, "Zu " .. target.DisplayName .. " teleportiert"
end

function Actions.Bring(admin, args)
	local targets = resolveTargets(admin, args.Target)
	local root = admin.Character and admin.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false, "Kein Charakter"
	end
	for i, p in ipairs(targets) do
		if p ~= admin and p.Character then
			local target = (root :: BasePart).CFrame * CFrame.new(i * 3, 0, -4)
			p.Character:PivotTo(target)
			Services.CarryService.NoteTeleport(p, target.Position)
		end
	end
	return #targets > 0, "Geholt: " .. names(targets)
end

function Actions.ClearGround(_admin)
	Services.MeteorService.ClearGround()
	return true, "🧹 Nester, Gratis-Zone & Eier am Boden geleert"
end

-- 🥚 Egg Rush sofort starten (läuft schon einer: wird verlängert, mehr Eier)
function Actions.EggRush(_admin, args)
	if args.Global then
		publishGlobal({ Type = "EggRush" })
		return true, "Egg Rush auf ALLEN Servern"
	end
	local count = Services.MeteorService.StartEggRush()
	if count <= 0 then
		return false, "Egg Rush fehlgeschlagen (kein Boden gefunden)"
	end
	return true, "🥚 Egg Rush gestartet: " .. count .. " Eier!"
end

-- 🛠️ Gadget schenken (gehört dem Spieler danach für immer)
function Actions.GiveGadget(admin, args)
	local gadget = type(args.GadgetId) == "string" and Config.GadgetsById[args.GadgetId] or nil
	if not gadget then
		return false, "Unbekanntes Gadget"
	end
	local targets = resolveTargets(admin, args.Target)
	local given = {}
	for _, p in ipairs(targets) do
		if Services.GadgetService.Give(p, gadget.Id) then
			table.insert(given, p.DisplayName)
			Services.EconomyService.Notify(
				p,
				"🎁 Ein Admin hat dir " .. gadget.Icon .. " " .. gadget.Name .. " geschenkt!",
				"Success"
			)
		end
	end
	return #given > 0, gadget.Icon .. " " .. gadget.Name .. " für " .. table.concat(given, ", ")
end

-- 🎡 Glücksrad-Drehs schenken
function Actions.GiveSpins(admin, args)
	local amount = math.floor(num(args.Amount, 1, 1, 1000))
	local rewards = Services.RewardService
	if not rewards or not rewards.AddSpins then
		return false, "Glücksrad nicht verfügbar"
	end
	local targets = resolveTargets(admin, args.Target)
	local given = {}
	for _, p in ipairs(targets) do
		if Services.DataService.Get(p) then
			rewards.AddSpins(p, amount)
			table.insert(given, p.DisplayName)
			Services.EconomyService.Notify(
				p,
				"🎁 Ein Admin hat dir " .. amount .. " 🎡 Drehs geschenkt!",
				"Success"
			)
		end
	end
	return #given > 0, "🎡 " .. amount .. " Drehs für " .. table.concat(given, ", ")
end

function Actions.AdminAbuse(_admin, args)
	if args.Global then
		publishGlobal({ Type = "AdminAbuse" })
		return true, "😈 ADMIN ABUSE auf ALLEN Servern!"
	end
	runAdminAbuse()
	return true, "😈 ADMIN ABUSE gestartet!"
end

function Actions.Gravity(_admin, args)
	local value = args.Moon and MOON_GRAVITY or DEFAULT_GRAVITY
	if args.Global then
		publishGlobal({ Type = "Gravity", Value = value })
	else
		setGravity(value)
	end
	if args.Moon then
		Services.EconomyService.NotifyAll("🌙 Mond-Schwerkraft! Spring mal hoch!", "Event")
	end
	return true, args.Moon and "🌙 Mond-Schwerkraft an" or "Normale Schwerkraft"
end

function Actions.Freeze(admin, args)
	local targets = resolveTargets(admin, args.Target)
	local done = {}
	for _, p in ipairs(targets) do
		local root = getRoot(p)
		if root then
			root:SetAttribute("TrapFreeze", nil) -- Fallen tauen einen Admin-Freeze nicht auf
			root.Anchored = args.Enabled == true
			table.insert(done, p.DisplayName)
			if args.Enabled == true and p ~= admin then
				Services.EconomyService.Notify(p, "🧊 Ein Admin hat dich eingefroren!", "Error")
			end
		end
	end
	return #done > 0, (args.Enabled and "🧊 Eingefroren: " or "Aufgetaut: ") .. table.concat(done, ", ")
end

function Actions.Size(admin, args)
	local scale = num(args.Scale, 1, 0.3, 4)
	local targets = resolveTargets(admin, args.Target)
	local done = {}
	for _, p in ipairs(targets) do
		if setScale(p, scale) then
			table.insert(done, p.DisplayName)
		end
	end
	return #done > 0, "📏 Größe x" .. scale .. ": " .. table.concat(done, ", ")
end

function Actions.Invisible(admin, args)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		-- Erst einen laufenden Umhang (Gadget) beenden: beide ändern dieselben Transparenzen,
		-- sonst merkt sich setInvisible die Umhang-Werte bzw. der Umhang stellt später alte Werte her
		local gadgets = Services.GadgetService
		if gadgets and gadgets.EndCloak then
			gadgets.EndCloak(p, true)
		end
		setInvisible(p, args.Enabled == true)
	end
	return #targets > 0, (args.Enabled and "👻 Unsichtbar: " or "Sichtbar: ") .. names(targets)
end

-- Foto-Modus: Reihe aller Seltenheiten vor dem Admin (links Common, rechts Admin)
function Actions.Showcase(admin)
	local root = getRoot(admin)
	if not root then
		return false, "Kein Charakter"
	end
	local defs = showcaseDefs()
	if #defs == 0 then
		return false, "Keine Meteore gefunden"
	end
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	local right = look:Cross(Vector3.yAxis) -- quer zur Blickrichtung
	local sizes = {}
	local width = SHOWCASE_GAP * (#defs - 1)
	for i, def in ipairs(defs) do
		sizes[i] = MeteorFactory.GetSize({ Id = def.Id, Lv = 1 })
		width += sizes[i]
	end
	local center = groundBelow(root.Position + look * SHOWCASE_DISTANCE)
	local offset = -width / 2
	for i, def in ipairs(defs) do
		Services.MeteorService.SpawnStatic({
			Id = def.Id,
			Mut = "Normal",
			Position = center + right * (offset + sizes[i] / 2),
			Instant = true,
			Announce = false,
			Lifetime = SHOWCASE_LIFETIME,
		})
		offset += sizes[i] + SHOWCASE_GAP
	end
	return true, "✨ Showcase: " .. #defs .. " Meteore (5 Min)"
end

-- Foto-Modus: leere Slots der eigenen Base mit Deko-Aliens füllen (nur Optik, nichts gespeichert)
function Actions.PhotoBase(admin)
	local plot = Services.PlotService.GetPlot(admin)
	if not plot then
		return false, "Du hast keine Base"
	end
	local count = Services.PlotService.FillPhotoShowcase(plot, photoEntry)
	return true, count > 0 and ("🏠 Foto-Base: " .. count .. " Deko-Aliens") or "🏠 Base ist schon voll"
end

-- Foto-Modus: Deko weg, Slot-Farben zurück, Nester + Gratis-Zone leer
function Actions.PhotoClear(admin)
	local plot = Services.PlotService.GetPlot(admin)
	if plot then
		Services.PlotService.ClearPhotoShowcase(plot)
		Services.PlotService.UpdateSlotColors(plot)
	end
	Services.MeteorService.ClearGround()
	return true, "🧹 Foto-Deko entfernt, Nester, Gratis-Zone & Eier geleert"
end

-- -------------------------------------------------------------------
-- NEU: SPAWNEN, EVENTS, GESCHENKE, KRÄFTE, MODERATION, SERVER
-- -------------------------------------------------------------------
-- 👽 Alien direkt: Meteor + Alien-Variante + Mutation + Level.
-- Where = "Base" (fertig geschlüpft in die Base der Ziel-Spieler) oder "Ground" (als Ei vor dem Admin;
-- wer es heimträgt, bekommt genau dieses Alien)
function Actions.SpawnAlien(admin, args)
	local def = type(args.MeteorId) == "string" and Config.MeteorsById[args.MeteorId] or nil
	if not def then
		return false, "Unbekannter Meteor"
	end
	local alien = type(args.AlienId) == "string" and Aliens.ById[args.AlienId] or nil
	if not alien or alien.Meteor ~= def.Id then
		return false, "Dieses Alien gehört nicht zu " .. def.Name
	end
	local entry = {
		Id = def.Id,
		Mut = Config.MutationsByName[args.Mutation] and args.Mutation or "Normal",
		Lv = math.floor(num(args.Level, 1, 1, Config.MaxLevel)),
		Alien = alien.Id,
	}
	if args.Where == "Ground" then
		local root = getRoot(admin)
		if not root then
			return false, "Kein Charakter"
		end
		local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
		look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
		local spot = groundBelow(root.Position + look * 10)
		local record = Services.MeteorService.DropMeteor(entry, spot, spot + Vector3.new(0, 30, 0))
		if not record then
			return false, "Ei konnte nicht abgelegt werden"
		end
		return true, alien.Name .. " liegt als Ei vor dir (30 s)"
	end
	local targets = resolveTargets(admin, args.Target)
	local given = 0
	for _, p in ipairs(targets) do
		if Services.EconomyService.GiveMeteor(p, table.clone(entry), true) then
			given += 1
			if p ~= admin then
				Services.EconomyService.Notify(p, "Ein Admin hat dir " .. alien.Name .. " geschenkt!", "Success")
			end
		end
	end
	return given > 0, alien.Name .. " an " .. given .. " Spieler" .. (given < #targets and " (manche Basen voll)" or "")
end

-- 🌙 Nacht / Blutmond starten, Nacht beenden (Mode = "Night" | "BloodMoon" | "End")
function Actions.Night(_admin, args)
	local mode = if args.Mode == "BloodMoon" or args.Mode == "End" then args.Mode else "Night"
	local label = if mode == "End" then "Nacht beendet" elseif mode == "BloodMoon" then "Blutmond" else "Nacht"
	if args.Global then
		publishGlobal({ Type = "Night", Mode = mode })
		return true, label .. " auf ALLEN Servern"
	end
	if not runNight(mode) then
		return false, "Nacht-System nicht verfügbar"
	end
	return true, label .. (if mode == "End" then "" else " gestartet")
end

function Actions.RareNests(_admin, args)
	local count = math.floor(num(args.Count, Config.AdminPowers.RareNestCount or 4, 1, 10))
	if args.Global then
		publishGlobal({ Type = "RareNests", Count = count })
		return true, "Große Nester auf ALLEN Servern"
	end
	local queued = runRareNests(count)
	return queued > 0,
		if queued > 0 then (queued .. " seltene Eier kommen in die Nester") else "Keine seltenen Eier gefunden"
end

-- 🏁 Ei-Rennen sofort starten (Gold-Ei im entferntesten großen Nest)
function Actions.RaceEvent(_admin, args)
	if args.Global then
		publishGlobal({ Type = "RaceEvent" })
		return true, "Ei-Rennen auf ALLEN Servern"
	end
	return Services.MeteorService.StartRace()
end

-- 🥚 Ei einer Seltenheit schenken (Base voll -> voller Wert als Cash)
function Actions.GiveEgg(admin, args)
	local rarity = type(args.Rarity) == "string" and Config.RaritiesByName[args.Rarity] or nil
	if not rarity then
		return false, "Unbekannte Seltenheit"
	end
	local rewards = Services.RewardService
	if not rewards or not rewards.GiveEgg then
		return false, "Eier-Geschenke nicht verfügbar"
	end
	local targets = resolveTargets(admin, args.Target)
	local given = 0
	for _, p in ipairs(targets) do
		if Services.DataService.Get(p) then
			local ok, text = rewards.GiveEgg(p, rarity.Name, { FullValue = true })
			if ok then
				given += 1
				Services.EconomyService.Notify(p, "Admin-Geschenk: " .. tostring(text), "Success")
				Services.EconomyService.Effect(p, "Confetti", 1)
			end
		end
	end
	return given > 0, rarity.Name .. "-Ei für " .. given .. " Spieler"
end

-- Kräfte nur für den Admin selbst: Power = "God" (kein Bonk/Klauen/Falle) oder "Noclip" (durch Wände)
function Actions.SetPower(admin, args)
	local attribute = if args.Power == "God" then "AdminGod" elseif args.Power == "Noclip" then "AdminNoclip" else nil
	if not attribute then
		return false, "Unbekannte Kraft"
	end
	local enabled = args.Enabled == true
	admin:SetAttribute(attribute, if enabled then true else nil)
	local name = if attribute == "AdminGod" then "Gott-Modus" else "Noclip"
	return true, name .. (if enabled then " an" else " aus")
end

-- Speed-Regler (nil/0 = normales Tempo). EconomyService.ApplySpeed nimmt den Wert für Admins.
function Actions.SetSpeed(admin, args)
	local powers = Config.AdminPowers
	local value = tonumber(args.Value)
	if not value or value <= 0 or value ~= value then
		admin:SetAttribute("AdminSpeed", nil)
		Services.EconomyService.ApplySpeed(admin)
		return true, "Normales Tempo"
	end
	value = math.floor(math.clamp(value, powers.MinSpeed, powers.MaxSpeed))
	admin:SetAttribute("AdminSpeed", value)
	Services.EconomyService.ApplySpeed(admin)
	return true, "Tempo " .. value
end

-- Sprungkraft auf den aktuellen Charakter anwenden (Original wird am Humanoid gemerkt)
local function applyJump(p: Player)
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local value = tonumber(p:GetAttribute("AdminJump"))
	if value then
		if humanoid:GetAttribute("OrigJumpPower") == nil then
			humanoid:SetAttribute("OrigUseJumpPower", humanoid.UseJumpPower)
			humanoid:SetAttribute("OrigJumpPower", humanoid.JumpPower)
			humanoid:SetAttribute("OrigJumpHeight", humanoid.JumpHeight)
		end
		humanoid.UseJumpPower = true
		humanoid.JumpPower = value
	elseif humanoid:GetAttribute("OrigJumpPower") ~= nil then
		humanoid.UseJumpPower = humanoid:GetAttribute("OrigUseJumpPower") == true
		humanoid.JumpPower = tonumber(humanoid:GetAttribute("OrigJumpPower")) or Config.AdminPowers.DefaultJump
		humanoid.JumpHeight = tonumber(humanoid:GetAttribute("OrigJumpHeight")) or 7.2
		humanoid:SetAttribute("OrigUseJumpPower", nil)
		humanoid:SetAttribute("OrigJumpPower", nil)
		humanoid:SetAttribute("OrigJumpHeight", nil)
	end
end

function Actions.SetJump(admin, args)
	local powers = Config.AdminPowers
	local value = tonumber(args.Value)
	if not value or value <= 0 or value ~= value then
		admin:SetAttribute("AdminJump", nil)
		applyJump(admin)
		return true, "Normale Sprungkraft"
	end
	value = math.floor(math.clamp(value, powers.MinJump, powers.MaxJump))
	admin:SetAttribute("AdminJump", value)
	applyJump(admin)
	return true, "Sprungkraft " .. value
end

-- ⚠️ Großer Hinweis auf dem Bildschirm der Ziel-Spieler (Text wird gefiltert)
function Actions.Warn(admin, args)
	if type(args.Text) ~= "string" or #args.Text == 0 or #args.Text > 150 then
		return false, "Text 1-150 Zeichen"
	end
	local filtered = filterBroadcast(args.Text, admin.UserId)
	if not filtered then
		return false, "Text-Filter nicht erreichbar"
	end
	local warned = {}
	for _, p in ipairs(resolveTargets(admin, args.Target)) do
		if p ~= admin or #Players:GetPlayers() == 1 then
			Services.EconomyService.Effect(p, "Warn", 0, { Text = filtered })
			table.insert(warned, p.DisplayName)
		end
	end
	return #warned > 0, "Warnung an " .. table.concat(warned, ", ")
end

function Actions.LockServer(_admin, args)
	serverLocked = args.Enabled == true
	workspace:SetAttribute("ServerLocked", if serverLocked then true else nil)
	return true, if serverLocked then "Server gesperrt (neue Spieler werden gekickt)" else "Server offen"
end

function Actions.KickAll(admin, args)
	local reason = type(args.Reason) == "string" and args.Reason ~= "" and args.Reason or "Der Server wird geleert"
	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= admin and not AdminService.IsAdmin(p) then
			count += 1
			p:Kick(reason)
		end
	end
	return true, count .. " Spieler gekickt"
end

-- In dieser Sitzung gebannte Spieler (neueste zuerst)
function Actions.BanList(_admin)
	local list = {}
	for i = #sessionBans, 1, -1 do
		local record = sessionBans[i]
		table.insert(list, {
			UserId = record.UserId,
			Name = record.Name,
			Reason = record.Reason,
			Days = record.Days,
			Active = record.Active,
		})
	end
	return true, #list .. " Bann(s) in dieser Sitzung", list
end

-- Bann-Verlauf eines Spielers von Roblox (Players:GetBanHistoryAsync), neueste zuerst
function Actions.BanHistory(admin, args)
	local userId = tonumber(args.Target)
	if not userId then
		local target = resolveTargets(admin, args.Target)[1]
		userId = target and target.UserId
	end
	if not userId then
		return false, "UserId (Zahl) angeben"
	end
	local ok, result = pcall(function()
		local pages = Players:GetBanHistoryAsync(userId)
		return pages:GetCurrentPage()
	end)
	if not ok or type(result) ~= "table" then
		return false, "Bann-Verlauf nicht verfügbar: " .. tostring(result)
	end
	local list = {}
	for i = #result, math.max(1, #result - 4), -1 do
		local entry = result[i]
		if type(entry) == "table" then
			table.insert(list, {
				UserId = userId,
				Name = tostring(userId),
				Reason = tostring(entry.DisplayReason or ""),
				Days = if tonumber(entry.Duration) and entry.Duration > 0 then entry.Duration / 86400 else 0,
				Active = entry.Ban == true,
				Start = tostring(entry.StartTime or ""),
			})
		end
	end
	return true, "Verlauf von " .. userId .. ": " .. #result .. " Einträge", list
end

-- 🐣 Alle Eier im ganzen Server schlüpfen sofort
function Actions.HatchAllServer(_admin)
	local total = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if Services.EconomyService.IsReady(p) then
			total += Services.EconomyService.HatchAll(p)
		end
	end
	Services.EconomyService.NotifyAll("Admin: Alle Eier schlüpfen JETZT!", "Event")
	return true, total .. " Aliens geschlüpft"
end

function Actions.ConfettiAll(_admin)
	task.spawn(function()
		for _ = 1, 4 do
			Services.EconomyService.EffectAll("Confetti", 3)
			task.wait(0.8)
		end
	end)
	return true, "Konfetti-Regen für alle"
end

-- Alle zur Mitte (Spawn-Platz). Getragene Beute fällt dabei herunter bzw. fliegt zurück.
function Actions.TeleportAllCenter(_admin)
	local center = Services.PlotService.LobbySpawn
	local players = Players:GetPlayers()
	for i, p in ipairs(players) do
		local character = p.Character
		if character then
			if Services.CarryService.IsCarrying(p) then
				Services.CarryService.Fail(p, "cancelled")
			end
			local angle = (i / math.max(1, #players)) * math.pi * 2
			local target = center * CFrame.new(math.cos(angle) * 6, 0, math.sin(angle) * 6)
			character:PivotTo(target)
			Services.CarryService.NoteTeleport(p, target.Position)
		end
	end
	return true, #players .. " Spieler zur Mitte"
end

-- Server-Info: Spieler, Laufzeit, laufende Events, durchschnittlicher Ping
function Actions.ServerInfo(_admin)
	local players = Players:GetPlayers()
	local pingSum, pingCount = 0, 0
	for _, p in ipairs(players) do
		local ms = pingMs(p)
		if ms then
			pingSum += ms
			pingCount += 1
		end
	end
	local events = {}
	local meteors = Services.MeteorService
	if meteors.IsShowerActive() then
		table.insert(events, "Meteoritenschauer")
	end
	if meteors.IsEggRushActive() then
		table.insert(events, "Egg Rush")
	end
	if meteors.IsRaceActive() then
		table.insert(events, "Ei-Rennen")
	end
	local luck = meteors.GetLuck()
	if luck > 1 then
		table.insert(events, "Glück x" .. Util.FormatNumber(luck))
	end
	local night = nightStatus()
	if night then
		table.insert(events, night)
	end
	if math.abs(workspace.Gravity - DEFAULT_GRAVITY) > 1 then
		table.insert(events, "Schwerkraft " .. math.floor(workspace.Gravity))
	end
	return true,
		"Server-Info geladen",
		{
			Players = #players,
			MaxPlayers = Players.MaxPlayers,
			Uptime = math.floor(os.clock() - serverStartedAt),
			Events = events,
			Ping = if pingCount > 0 then math.floor(pingSum / pingCount + 0.5) else nil,
			Locked = serverLocked,
		}
end

-- -------------------------------------------------------------------
function AdminService.Init(services)
	Services = services
end

function AdminService.Start()
	local function onPlayer(player: Player)
		joinedAt[player] = joinedAt[player] or os.clock()
		if AdminService.IsAdmin(player) then
			player:SetAttribute("IsAdmin", true)
			player:SetAttribute("CanFly", true)
		elseif serverLocked then
			player:Kick(LOCKED_KICK_TEXT) -- Server gesperrt (Admin-Panel)
			return
		end
		player.CharacterAdded:Connect(function(character)
			if player:GetAttribute("AdminJump") ~= nil then
				character:WaitForChild("Humanoid", 10)
				applyJump(player)
			end
			character:WaitForChild("Head", 10)
			updateTag(player)
		end)
		player:GetAttributeChangedSignal("VIP"):Connect(function()
			updateTag(player)
		end)
		if player.Character then
			updateTag(player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		limiter.Clear(player)
		adminCache[player] = nil
		warnedDenied[player] = nil
		joinedAt[player] = nil
	end)

	Remotes.Admin.OnServerInvoke = function(player: Player, action: any, args: any)
		-- Spam-Bremse ZUERST (auch für Nicht-Admins, sonst fluten Exploiter das Server-Log)
		if not limiter.Check(player) then
			return { Ok = false, Message = "Zu schnell" }
		end
		if not AdminService.IsAdmin(player) then
			if not warnedDenied[player] then
				warnedDenied[player] = true
				warn("[Admin] Unerlaubter Zugriff von " .. player.Name .. " (" .. player.UserId .. ")")
			end
			return { Ok = false, Message = "Kein Zugriff" }
		end
		if type(action) ~= "string" or not Actions[action] then
			return { Ok = false, Message = "Unbekannte Aktion" }
		end
		if type(args) ~= "table" then
			args = {}
		end
		local ok, success, message, payload = pcall(Actions[action], player, args)
		if not ok then
			warn("[Admin] Fehler bei " .. action .. ": " .. tostring(success))
			return { Ok = false, Message = "Fehler: " .. tostring(success) }
		end
		print(("[Admin] %s -> %s: %s"):format(player.Name, action, tostring(message)))
		return { Ok = success, Message = message, Data = payload }
	end

	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(Config.MessagingTopic, function(packet)
				handleGlobal(packet.Data)
			end)
		end)
		if not ok then
			warn("[Admin] MessagingService nicht verfügbar (in Studio normal): " .. tostring(err))
		end
	end)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">AlienFactory</string>
            <string name="Source"><![CDATA[--!strict
-- Baut das Aussehen eines Aliens (schlüpft aus einem Meteor) im Stil knuffiger Roblox-Pets:
-- wenige, runde, saubere Formen, große glänzende Augen (mit weißem Lichtreflex), Bäckchen,
-- kleiner Mund. Jede Körperform ("Archetype", Aliens.luau) hat EIN klares Erkennungsmerkmal.
--
--  * Stufen: Normal = schlicht, Selten = ein Extra-Detail (je Form eins), Ultra = Flügel +
--    Heiligenschein (King: Flügel + leuchtender Kronen-Edelstein). Admin: immer Flügel + Schein.
--  * Mutationen: Gold (Folie), Diamond (Glas), Galaxy (Neon + Funken), Frost (Eis-Körper,
--    Schnee-Füße, Schneeflocken), Lava (glühender Körper, Vulkangestein, kleines Feuer),
--    Rainbow (alle farbigen Teile mit Attribut "Rainbow" -> der Client färbt sie durch).
--  * Umriss (Highlight) nur noch bei Tier "Ultra" + Rarity "Admin" (Roblox zeigt nur ~31 gleichzeitig).
--  * Pivot (model:GetPivot()) = Bodenmitte -> model:PivotTo(Pad-Oberseite) stellt das Alien aufs Pad.
--  * Das Gesicht zeigt in Blickrichtung des Pivots (LookVector / lokales -Z).
--  * Alle Teile sind verankert, ohne Kollision. Nur "Body" (PrimaryPart) ist abfragbar (für Prompts).
--  * Höchstens 18 Teile pro Alien (Admin: 24), damit auch volle Basen nicht laggen. Die Teile werden
--    nach Wichtigkeit gebaut (Körper, Augen, Mund, Stufen-Extra, Bäckchen, Antennen, ...), was nicht
--    mehr ins Budget passt, fällt weg.
--  * Augen-Teile (Eye, Iris, Pupil, Shine) haben dieselbe Teilgröße wie ihr Auge (kleiner sichtbar per
--    SpecialMesh.Scale) -> beim Blinzeln (WorldFX) sinken sie alle gleich tief in den Kopf.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")) :: any
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Aliens = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Aliens"))

type AlienDef = Aliens.AlienDef
type Entry = { Id: string, Alien: string?, Mut: string?, Lv: number? }

-- Aussehen einer Mutation an "Main" (Körper), "Light" (Bauch, Schnauze) und "Shade" (Füße, Arme, Antennen).
-- Die Farbe kommt aus Config.Mutations; ohne Eintrag hier wird nur umgefärbt.
type MutStyle = {
	Material: Enum.Material,
	Transparency: number?, -- mindestens so durchsichtig
	Reflectance: number?, -- Standard 0
	ShadeMaterial: Enum.Material?, -- Standard: wie Material
	ShadeTint: Color3?, -- Shade = Körperfarbe in Richtung dieser Farbe (Standard: dunkler)
	ShadeAlpha: number?,
}

-- Ellipsoid (Mitte + Radien), auf dessen Vorderseite (-Z) ein Gesicht sitzt
type Face = { c: Vector3, r: Vector3 }

type Ctx = {
	model: Model,
	s: number, -- Gesamt-Skalierung (Seltenheit * Stufe * Modus * Level)
	color: Color3,
	accent: Color3,
	eyes: number,
	antennas: number,
	tier: number, -- 1 = Normal, 2 = Selten, 3 = Ultra
	rank: number, -- Seltenheits-Rang (1 Common .. 10 Admin)
	admin: boolean,
	faceRole: string, -- Rolle der Fläche, auf der die Augen sitzen (für die Augenfarbe)
	mutStyle: MutStyle?,
	mutColor: Color3?, -- nil = eigene Farbe (Normal, Regenbogen)
	rainbow: boolean, -- Körper + Leucht-Teile färben sich durch
	rainbowShade: boolean, -- auch die Shade-Teile (Regenbogen-Mutation)
	carry: boolean,
	mainMaterial: Enum.Material,
	mainTransparency: number,
	mainReflectance: number,
	count: number,
	max: number,
	top: number, -- höchster Punkt (unskaliert)
	haloZ: number?, -- Heiligenschein vorgemerkt (wird zuletzt über dem höchsten Punkt gebaut)
}

type Builder = (ctx: Ctx) -> (Part, number)

local AlienFactory = {}

local MAX_PARTS = 18
local MAX_PARTS_ADMIN = 24
-- Rang der Seltenheit "Admin" (Godly/Cosmic/Infinity liegen darunter und sind KEINE Admin-Aliens)
local ADMIN_RANK = (Config.RarityIndex and Config.RarityIndex.Admin) or Aliens.RarityRank.Admin or 13
local LEVEL_GROWTH = 0.012 -- +1,2% Größe pro Level (Level 20 = +23%)
local LABEL_GAP = 1.6
local SHADOW_MIN_VOLUME = 6 -- nur große Teile werfen Schatten (bewegte Schattenwerfer kosten viel)
local MODE_SCALE: { [string]: number } = { Base = 1, Photo = 1, Carry = 0.55 }

local DARK = Color3.fromRGB(28, 24, 42) -- Augen, Mund
local WHITE = Color3.fromRGB(250, 250, 255)
local GOLD = Color3.fromRGB(255, 200, 40)
local STALK = Color3.fromRGB(250, 238, 214)
local METAL = Color3.fromRGB(92, 98, 115)
local ROCK = Color3.fromRGB(70, 65, 75)
local BLACK = Color3.new(0, 0, 0)
local BLUSH = Color3.fromRGB(255, 105, 150)
local TONGUE = Color3.fromRGB(255, 110, 130)
local HALO = Color3.fromRGB(255, 226, 110)
local LEAF = Color3.fromRGB(90, 210, 90)
local FROST_LIGHT = Color3.fromRGB(190, 235, 255)
local LAVA_ORANGE = Color3.fromRGB(255, 110, 30)
local LAVA_DARK = Color3.fromRGB(120, 20, 0)
local FALLBACK_RARITY_COLORS: { [string]: Color3 } = { Admin = Color3.fromRGB(255, 40, 40) }

-- Umriss (Highlight) nur für diese Kombination – Roblox zeigt höchstens ~31 Highlights gleichzeitig
local HIGHLIGHT_TIER = "Ultra"
local HIGHLIGHT_RARITY = "Admin"

local SHADE_ALPHA = 0.3 -- Shade-Teile: so viel dunkler als der Körper
local LIGHT_ALPHA = 0.55 -- Light-Teile (Bauch, Schnauze): so viel heller als der Körper
local DARK_FACE = 0.2 -- Gesichtsfläche dunkler als das -> leuchtende statt dunkle Augen

local TIER_INDEX: { [string]: number } = { Normal = 1, Selten = 2, Ultra = 3 }

-- Teile, die der Client als Augen erkennt (Attribut "Eye" -> lokales Blinzeln)
local EYE_PARTS: { [string]: boolean } = { Eye = true, Pupil = true, Iris = true, Shine = true }

local MUT_STYLES: { [string]: MutStyle } = {
	Gold = { Material = Enum.Material.Foil, Reflectance = 0.1 },
	Diamond = { Material = Enum.Material.Glass, Transparency = 0.2, Reflectance = 0.15 },
	Galaxy = { Material = Enum.Material.Neon },
	-- Eis-Körper, Füße/Antennen wie aus Schnee (+ Schneeflocken, siehe addEffects)
	Frost = {
		Material = Enum.Material.Ice,
		Reflectance = 0.05,
		ShadeMaterial = Enum.Material.Snow,
		ShadeTint = WHITE,
		ShadeAlpha = 0.55,
	},
	-- glühender Körper, Füße/Antennen aus dunklem Vulkangestein (+ kleines Feuer, siehe addEffects)
	Lava = {
		Material = Enum.Material.Neon,
		ShadeMaterial = Enum.Material.Basalt,
		ShadeTint = BLACK,
		ShadeAlpha = 0.7,
	},
}

-- Symbol vor dem Mutationsnamen im Namensschild (Config.Mutations -> Icon hat Vorrang; das hier ist der Ersatz)
local MUT_ICONS: { [string]: string } = {
	Gold = "🪙",
	Diamond = "💎",
	Galaxy = "🌌",
	Frost = "❄️",
	Lava = "🔥",
	Rainbow = "🌈",
}

local RAINBOW_SEQUENCE = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(80, 255, 80)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 220, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(90, 90, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 220)),
})

local warned: { [string]: boolean } = {}
local function warnOnce(key: string, message: string)
	if not warned[key] then
		warned[key] = true
		warn(message)
	end
end

-- -------------------------------------------------------------------
-- Nachschlagen (robust, falls Config gerade etwas nicht kennt)
-- -------------------------------------------------------------------
local function resolveAlien(entry: Entry): AlienDef
	local alien = entry.Alien and Aliens.ById[entry.Alien]
	if alien then
		return alien
	end
	local options = Aliens.ByMeteor[entry.Id]
	local fallback = options and options[1] and Aliens.ById[options[1].Id] or Aliens.List[1]
	warnOnce(
		"alien:" .. tostring(entry.Alien) .. ":" .. tostring(entry.Id),
		"[AlienFactory] Unbekanntes Alien '" .. tostring(entry.Alien) .. "' -> zeige " .. fallback.Id
	)
	return fallback
end

local function rarityRank(rarityName: string): number
	local index = Config.RarityIndex and Config.RarityIndex[rarityName]
	return index or Aliens.RarityRank[rarityName] or 1
end

local function rarityColor(rarityName: string): Color3
	local rarity = Config.RaritiesByName and Config.RaritiesByName[rarityName]
	return rarity and rarity.Color or FALLBACK_RARITY_COLORS[rarityName] or WHITE
end

local function getMutation(name: string?): any
	local byName = Config.MutationsByName or {}
	return byName[name or "Normal"] or (Config.Mutations and Config.Mutations[1]) or { Name = "Normal", Mult = 1 }
end

local function maxLevel(): number
	return tonumber(Config.MaxLevel) or 20
end

local function levelOf(entry: Entry): number
	local lv = tonumber(entry.Lv) or 1
	if lv ~= lv then
		return 1
	end
	return math.clamp(math.floor(lv), 1, math.max(1, maxLevel()))
end

local function levelScale(lv: number): number
	return 1 + LEVEL_GROWTH * (lv - 1)
end

-- Symbol + Name einer Mutation fürs Schild, z.B. "🔥 Lava"
local function mutationText(mut: any): string
	local name = tostring(mut.Name)
	local configIcon = if type(mut.Icon) == "string" and mut.Icon ~= "" then mut.Icon else nil
	local icon = configIcon or MUT_ICONS[name] or (mut.Rainbow == true and MUT_ICONS.Rainbow) or nil
	return icon and (icon .. " " .. name) or name
end

local function luminance(color: Color3): number
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- -------------------------------------------------------------------
-- Farben + Material nach Rolle
-- -------------------------------------------------------------------
-- Körperfarbe (Mutation hat Vorrang)
local function mainColorOf(ctx: Ctx): Color3
	return ctx.mutColor or ctx.color
end

-- Farbe der Shade-Teile (Füße, Arme, Antennen) aus der Körperfarbe
local function shadeColorOf(ctx: Ctx, base: Color3): Color3
	local style = ctx.mutStyle
	local tint = style and style.ShadeTint or BLACK
	local alpha = style and style.ShadeAlpha or SHADE_ALPHA
	return base:Lerp(tint, alpha)
end

-- Farbe, die eine Rolle bekommt (ohne Regenbogen-Durchfärben)
local function roleColor(ctx: Ctx, role: string): Color3
	if role == "Main" then
		return mainColorOf(ctx)
	elseif role == "Shade" then
		return shadeColorOf(ctx, mainColorOf(ctx))
	elseif role == "Light" then
		return mainColorOf(ctx):Lerp(WHITE, LIGHT_ALPHA)
	elseif role == "Accent" or role == "Glow" or role == "Cape" then
		return ctx.accent
	elseif role == "Dark" then
		return DARK
	elseif role == "White" or role == "Shine" then
		return WHITE
	elseif role == "Blush" then
		return BLUSH:Lerp(mainColorOf(ctx), 0.2)
	elseif role == "Tongue" then
		return TONGUE
	elseif role == "Gold" then
		return GOLD
	elseif role == "Stalk" then
		return STALK
	elseif role == "StalkShade" then
		return STALK:Lerp(mainColorOf(ctx), 0.35)
	elseif role == "Metal" then
		return METAL
	elseif role == "Rock" then
		return ctx.color:Lerp(ROCK, 0.65)
	elseif role == "Wing" then
		return WHITE:Lerp(ctx.accent, 0.12)
	elseif role == "Halo" then
		return HALO
	elseif role == "Leaf" then
		return LEAF
	end
	return ctx.color
end

-- Farbe der Fläche, auf der das Gesicht sitzt (Regenbogen färbt der Client hell + satt -> zählt als hell)
local function faceColorOf(ctx: Ctx): Color3
	if ctx.rainbow and ctx.faceRole == "Main" then
		return WHITE
	end
	return roleColor(ctx, ctx.faceRole)
end

local function styleRole(ctx: Ctx, part: Part, role: string)
	local material = Enum.Material.SmoothPlastic
	local color = roleColor(ctx, role)
	local transparency = 0
	local reflectance = 0
	if role == "Main" or role == "Shade" or role == "Light" then
		material = ctx.mainMaterial
		transparency = ctx.mainTransparency
		reflectance = ctx.mainReflectance
		local style = ctx.mutStyle
		if style then
			material = style.Material
			transparency = math.max(transparency, style.Transparency or 0)
			reflectance = style.Reflectance or 0
		end
		if role == "Shade" then
			if style and style.ShadeMaterial then
				material = style.ShadeMaterial
			end
			if ctx.rainbowShade then
				part:SetAttribute("Rainbow", true)
			end
		elseif role == "Main" and ctx.rainbow then
			part:SetAttribute("Rainbow", true)
		end
	elseif role == "Glow" then
		material = Enum.Material.Neon
		if ctx.rainbow then
			part:SetAttribute("Rainbow", true)
		end
	elseif role == "Shine" then
		material = Enum.Material.Neon
	elseif role == "Dark" or role == "Metal" then
		reflectance = 0.2
	elseif role == "Blush" then
		transparency = 0.25
	elseif role == "Gold" then
		material = Enum.Material.Foil
		reflectance = 0.1
	elseif role == "Rock" then
		material = Enum.Material.Slate
	elseif role == "Cape" then
		material = Enum.Material.Fabric
	elseif role == "Halo" then
		material = Enum.Material.Neon
		transparency = 0.15
		if ctx.rainbow then
			part:SetAttribute("Rainbow", true)
		end
	end
	part.Material = material
	part.Color = color
	part.Transparency = transparency
	part.Reflectance = reflectance
end

-- -------------------------------------------------------------------
-- Geometrie-Helfer (alle Maße unskaliert, Ursprung = Bodenmitte, vorne = -Z)
-- -------------------------------------------------------------------
local function room(ctx: Ctx, amount: number): boolean
	return ctx.count + amount <= ctx.max
end

-- Halbe Höhe eines gedrehten Quaders (für den höchsten Punkt)
local function halfHeight(cf: CFrame, size: Vector3): number
	return (math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z)
		/ 2
end

-- CFrame, dessen X-Achse in Richtung "axis" zeigt (für Zylinder, Stäbe, Tentakel)
local function axisCFrame(center: Vector3, axis: Vector3): CFrame
	local x = axis.Magnitude > 1e-4 and axis.Unit or Vector3.xAxis
	local ref = math.abs(x.Y) < 0.9 and Vector3.yAxis or Vector3.zAxis
	local z = x:Cross(ref).Unit
	local y = z:Cross(x).Unit
	return CFrame.fromMatrix(center, x, y, z)
end

-- CFrame an "pos", dessen Vorderseite (-Z) in Richtung "normal" zeigt
local function facing(pos: Vector3, normal: Vector3): CFrame
	local n = normal.Magnitude > 1e-4 and normal.Unit or -Vector3.zAxis
	local up = math.abs(n.Y) < 0.95 and Vector3.yAxis or Vector3.zAxis
	return CFrame.lookAt(pos, pos + n, up)
end

-- Punkt + Normale auf der Vorderseite (-Z) eines Ellipsoids bei Höhe y und seitlich x
local function frontPoint(face: Face, x: number, y: number): (Vector3, Vector3)
	local center, radii = face.c, face.r
	local dx = (x - center.X) / radii.X
	local dy = (y - center.Y) / radii.Y
	local depth = math.sqrt(math.max(0, 1 - dx * dx - dy * dy))
	local point = Vector3.new(x, y, center.Z - radii.Z * depth)
	local rel = point - center
	local normal = Vector3.new(rel.X / radii.X ^ 2, rel.Y / radii.Y ^ 2, rel.Z / radii.Z ^ 2)
	return point, normal.Magnitude > 1e-4 and normal.Unit or -Vector3.zAxis
end

-- CFrame auf der Vorderseite eines Ellipsoids, "out" Studs nach außen versetzt, Blick nach außen
local function onFace(face: Face, x: number, y: number, out: number): CFrame
	local point, normal = frontPoint(face, x, y)
	return facing(point + normal * out, normal)
end

-- Ebene Vorderseite (z.B. Roboter-Bildschirm, Kristall): als sehr großes Ellipsoid genähert
local function flatFace(x: number, y: number, z: number): Face
	return { c = Vector3.new(x, y, z + 200), r = Vector3.one * 200 }
end

-- Höhe der Oberseite eines Ellipsoids bei (x, z)
local function topY(face: Face, x: number, z: number): number
	local center, radii = face.c, face.r
	local dx = (x - center.X) / radii.X
	local dz = (z - center.Z) / radii.Z
	return center.Y + radii.Y * math.sqrt(math.max(0, 1 - dx * dx - dz * dz))
end

-- shape: "Block" (Standard), "Ball", "Cylinder" (Achse = X) oder "Ellipsoid".
-- meshScale (nur Ellipsoid): sichtbare Größe = Size * meshScale (für Augen-Teile, siehe oben)
local function makePart(
	ctx: Ctx,
	name: string,
	role: string,
	size: Vector3,
	cf: CFrame,
	shape: string?,
	meshScale: Vector3?
): Part
	ctx.count += 1
	local s = ctx.s
	local part = Instance.new("Part")
	part.Name = name
	if shape == "Ball" then
		part.Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		part.Shape = Enum.PartType.Cylinder
	elseif shape == "Ellipsoid" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		if meshScale then
			mesh.Scale = meshScale
		end
		mesh.Parent = part
	end
	part.Size = size * s
	part.CFrame = CFrame.new(cf.Position * s) * cf.Rotation
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	local visible = meshScale and size * meshScale or size
	local scaled = visible * s
	part.CastShadow = not ctx.carry and scaled.X * scaled.Y * scaled.Z >= SHADOW_MIN_VOLUME
	if ctx.carry then
		part.Massless = true
	end
	styleRole(ctx, part, role)
	if EYE_PARTS[name] then
		part:SetAttribute("Eye", true) -- Client: Augen blinzeln lokal (rein optisch)
	end
	ctx.top = math.max(ctx.top, cf.Position.Y + halfHeight(cf, visible))
	part.Parent = ctx.model
	return part
end

-- Wie makePart, aber nur wenn noch Platz im Teile-Budget ist
local function tryPart(
	ctx: Ctx,
	name: string,
	role: string,
	size: Vector3,
	cf: CFrame,
	shape: string?,
	meshScale: Vector3?
): Part?
	if not room(ctx, 1) then
		return nil
	end
	return makePart(ctx, name, role, size, cf, shape, meshScale)
end

-- Länglicher Teil von "from" nach "to" (Arme, Beine, Tentakel, Antennen)
local function stick(
	ctx: Ctx,
	name: string,
	role: string,
	from: Vector3,
	to: Vector3,
	thickness: number,
	shape: string
): Part?
	local axis = to - from
	return tryPart(
		ctx,
		name,
		role,
		Vector3.new(axis.Magnitude, thickness, thickness),
		axisCFrame((from + to) / 2, axis),
		shape
	)
end

-- Paar links/rechts (nur wenn beide ins Budget passen). make(side) baut eine Seite (-1 / 1).
local function pair(ctx: Ctx, make: (side: number) -> ())
	if room(ctx, 2) then
		make(-1)
		make(1)
	end
end

-- -------------------------------------------------------------------
-- Gesicht: Augen, Mund, Bäckchen, Antennen
-- -------------------------------------------------------------------
-- Seitliche Versätze (x in Studs, Höhe in Augenhöhen) für n Augen
local function eyeLayout(n: number, spread: number): { Vector2 }
	if n <= 1 then
		return { Vector2.zero }
	elseif n == 2 then
		return { Vector2.new(-spread, 0), Vector2.new(spread, 0) }
	elseif n == 3 then
		return { Vector2.new(-spread * 1.2, -0.12), Vector2.new(0, 0.3), Vector2.new(spread * 1.2, -0.12) }
	end
	return {
		Vector2.new(-spread * 1.5, -0.15),
		Vector2.new(-spread * 0.5, 0.08),
		Vector2.new(spread * 0.5, 0.08),
		Vector2.new(spread * 1.5, -0.15),
	}
end

-- Große, glänzende Ovalaugen (dunkel, auf dunkler Fläche leuchtend) mit weißem Lichtreflex.
-- Ohne Platz im Budget: ohne Reflex (aber immer alle Augen).
local function addEyes(ctx: Ctx, face: Face, y: number, spread: number, h: number)
	local n = ctx.eyes
	if n >= 3 then
		h *= 0.7
		spread *= 0.75
	end
	local w, d = h * 0.76, h * 0.5
	local withShine = room(ctx, n * 2)
	local glow = luminance(faceColorOf(ctx)) < DARK_FACE
	local role = glow and "Glow" or "Dark"
	-- leuchtende (helle) Augen auf dunklem Gesicht: dunkler statt weißer Glanzpunkt
	local shineRole = (glow and luminance(ctx.accent) > 0.75) and "Dark" or "Shine"
	local size = Vector3.new(w, h, d)
	local shineScale = Vector3.new(0.36, 0.36 * w / h, 0.3)
	for _, offset in ipairs(eyeLayout(n, spread)) do
		local cf = onFace(face, offset.X, y + offset.Y * h, d * 0.1)
		makePart(ctx, "Eye", role, size, cf, "Ellipsoid")
		if withShine then
			makePart(
				ctx,
				"Shine",
				shineRole,
				size,
				cf * CFrame.new(w * 0.2, h * 0.2, -d * 0.36),
				"Ellipsoid",
				shineScale
			)
		end
	end
end

-- Ein riesiges Zyklopen-Auge: weiß, Iris in Akzentfarbe, Pupille, Lichtreflex
local function addBigEye(ctx: Ctx, face: Face, y: number, h: number)
	local size = Vector3.new(h * 0.94, h, h * 0.6)
	local cf = onFace(face, 0, y, h * 0.06)
	makePart(ctx, "Eye", "White", size, cf, "Ellipsoid")
	local d = size.Z
	makePart(
		ctx,
		"Iris",
		"Accent",
		size,
		cf * CFrame.new(0, -h * 0.03, -d * 0.3),
		"Ellipsoid",
		Vector3.new(0.6, 0.58, 0.5)
	)
	makePart(
		ctx,
		"Pupil",
		"Dark",
		size,
		cf * CFrame.new(0, -h * 0.03, -d * 0.44),
		"Ellipsoid",
		Vector3.new(0.32, 0.32, 0.4)
	)
	tryPart(
		ctx,
		"Shine",
		"Shine",
		size,
		cf * CFrame.new(h * 0.13, h * 0.11, -d * 0.6),
		"Ellipsoid",
		Vector3.new(0.17, 0.16, 0.2)
	)
end

-- Mund. "Open" = kleines offenes Lächeln, "O" = rundes Staunen. Gibt die Lage zurück (für die Zunge).
local function addMouth(ctx: Ctx, face: Face, y: number, w: number, style: string): CFrame?
	if not room(ctx, 1) then
		return nil
	end
	local cf = onFace(face, 0, y, 0.02)
	local role = luminance(faceColorOf(ctx)) < DARK_FACE and "Glow" or "Dark" -- dunkles Gesicht: leuchtender Mund
	if style == "O" then
		makePart(ctx, "Mouth", role, Vector3.new(w * 0.62, w * 0.72, 0.2), cf, "Ellipsoid")
		return nil
	end
	makePart(ctx, "Mouth", role, Vector3.new(w, w * 0.6, 0.22), cf, "Ellipsoid")
	return cf
end

-- Zunge im offenen Mund (unwichtig -> wird spät gebaut)
local function addTongue(ctx: Ctx, mouth: CFrame?, w: number)
	if mouth then
		tryPart(
			ctx,
			"Tongue",
			"Tongue",
			Vector3.new(w * 0.62, w * 0.3, 0.16),
			mouth * CFrame.new(0, -w * 0.12, -0.05),
			"Ellipsoid"
		)
	end
end

local function addBlush(ctx: Ctx, face: Face, y: number, x: number, k: number)
	pair(ctx, function(side)
		makePart(ctx, "Cheek", "Blush", Vector3.new(0.44, 0.24, 0.12) * k, onFace(face, side * x, y, 0), "Ellipsoid")
	end)
end

-- Fläche (Bauch, Schnauze) auf der Vorderseite, etwas herausstehend
local function addPatch(ctx: Ctx, name: string, role: string, face: Face, y: number, size: Vector3): CFrame?
	local cf = onFace(face, 0, y, -size.Z * 0.2)
	if tryPart(ctx, name, role, size, cf, "Ellipsoid") then
		return cf
	end
	return nil
end

local function addFeet(ctx: Ctx, x: number, z: number, size: Vector3, role: string)
	pair(ctx, function(side)
		makePart(ctx, "Foot", role, size, CFrame.new(side * x, size.Y / 2, z), "Ellipsoid")
	end)
end

-- Antennen mit Kugel. Weniger Platz im Budget -> erst ohne Kugel, dann weniger Antennen.
-- baseYAt(x) liefert die Höhe der Kopf-Oberseite an der Stelle x. single = x-Lage einer einzelnen Antenne.
local function addAntennas(
	ctx: Ctx,
	baseYAt: (x: number) -> number,
	z: number,
	spread: number,
	length: number,
	lean: number,
	tilt: number,
	single: number?
)
	local n = ctx.antennas
	local perAntenna = 2
	while n > 0 and not room(ctx, n * perAntenna) do
		if perAntenna == 2 then
			perAntenna = 1
		else
			perAntenna = 2
			n -= 1
		end
	end
	if n <= 0 then
		return
	end
	local xs = n == 1 and { single or 0 } or (n == 2 and { -spread, spread } or { -spread, 0, spread })
	local tipRole = (ctx.tier >= 3 or ctx.rank >= 6) and "Glow" or "Accent"
	for _, x in ipairs(xs) do
		local side = x > 0.01 and 1 or (x < -0.01 and -1 or 0)
		local dir = Vector3.new(side * math.sin(lean), math.cos(lean), -math.sin(tilt)).Unit
		local base = Vector3.new(x, baseYAt(x) - 0.08, z)
		local tip = base + dir * length
		stick(ctx, "Antenna", "Shade", base, tip, 0.13, "Cylinder")
		if perAntenna == 2 then
			tryPart(ctx, "AntennaTip", tipRole, Vector3.one * 0.4, CFrame.new(tip), "Ball")
		end
	end
end

-- -------------------------------------------------------------------
-- Ultra / Admin: Flügel + Heiligenschein
-- -------------------------------------------------------------------
-- anchor = Mitte des oberen Rückens, half = halbe Körperbreite dort, k = Flügelgröße
local function addWings(ctx: Ctx, anchor: Vector3, half: number, k: number)
	pair(ctx, function(side)
		local len = 1.35 * k
		local pos = anchor + Vector3.new(side * (half + len * 0.22), len * 0.25, 0)
		local cf = CFrame.new(pos)
			* CFrame.Angles(0, side * math.rad(-30), 0)
			* CFrame.Angles(0, 0, side * math.rad(30))
		makePart(ctx, "Wing", "Wing", Vector3.new(len, len * 0.62, 0.22 * k), cf, "Ellipsoid")
	end)
	if ctx.admin then
		-- Admin: zweites, kleineres Flügelpaar darunter (Seraph-Look)
		pair(ctx, function(side)
			local len = 1.15 * k
			local pos = anchor + Vector3.new(side * (half + len * 0.25), -len * 0.3, 0.1)
			local cf = CFrame.new(pos)
				* CFrame.Angles(0, side * math.rad(-35), 0)
				* CFrame.Angles(0, 0, side * math.rad(-20))
			makePart(ctx, "Wing", "Wing", Vector3.new(len, len * 0.55, 0.2 * k), cf, "Ellipsoid")
		end)
	end
end

local function addHalo(ctx: Ctx, pos: Vector3, diameter: number)
	tryPart(
		ctx,
		"Halo",
		"Halo",
		Vector3.new(0.12, diameter, diameter),
		CFrame.new(pos) * CFrame.Angles(math.rad(-12), 0, 0) * CFrame.Angles(0, 0, math.rad(90)),
		"Cylinder"
	)
end

local function isUltra(ctx: Ctx): boolean
	return ctx.tier >= 3 or ctx.admin
end

-- Flügel + Heiligenschein (nur Ultra/Admin). Der Schein wird nur vorgemerkt (1 Teil reserviert) und
-- am Ende über dem höchsten Punkt gebaut (finishUltra), damit er nie in Antennen/Krone steckt.
-- haloZ = nil -> nur Flügel.
local function addUltra(ctx: Ctx, anchor: Vector3, half: number, haloZ: number?)
	if not isUltra(ctx) then
		return
	end
	addWings(ctx, anchor, half, ctx.admin and 1.15 or 1)
	if haloZ and room(ctx, 1) then
		ctx.haloZ = haloZ
		ctx.max -= 1
	end
end

local function finishUltra(ctx: Ctx)
	local haloZ = ctx.haloZ
	if haloZ then
		ctx.haloZ = nil
		ctx.max += 1
		addHalo(ctx, Vector3.new(0, ctx.top + 0.4, haloZ), ctx.admin and 1.7 or 1.4)
	end
end

-- -------------------------------------------------------------------
-- KÖRPERFORMEN – jede gibt (Body, Höhe der Body-Mitte) zurück.
-- Reihenfolge = Wichtigkeit (was am Ende nicht mehr ins Budget passt, fällt weg).
-- -------------------------------------------------------------------
local Builders: { [string]: Builder } = {}

-- Mochi-Schleim mit Tropfen-Spitze. Selten: runde Öhrchen.
Builders.Blob = function(ctx: Ctx): (Part, number)
	local face: Face = { c = Vector3.new(0, 1.2, 0), r = Vector3.new(1.55, 1.2, 1.45) }
	local body = makePart(ctx, "Body", "Main", face.r * 2, CFrame.new(face.c), "Ellipsoid")
	makePart(
		ctx,
		"Top",
		"Main",
		Vector3.new(0.62, 0.95, 0.62),
		CFrame.new(0.1, 2.38, 0.05) * CFrame.Angles(0, 0, math.rad(-16)),
		"Ellipsoid"
	)
	addEyes(ctx, face, 1.45, 0.56, 0.82)
	local mouth = addMouth(ctx, face, 0.9, 0.44, "Open")
	if ctx.tier >= 2 then
		pair(ctx, function(side)
			makePart(
				ctx,
				"Ear",
				"Main",
				Vector3.new(0.75, 0.75, 0.5),
				CFrame.new(side * 1.0, 2.05, 0.1) * CFrame.Angles(0, 0, math.rad(side * -25)),
				"Ellipsoid"
			)
		end)
	end
	addUltra(ctx, Vector3.new(0, 1.55, 0.95), 0.85, 0.05)
	addBlush(ctx, face, 1.0, 0.98, 1)
	addAntennas(ctx, function(x)
		return topY(face, x, 0)
	end, 0, 0.55, 0.85, math.rad(22), 0, -0.55)
	addTongue(ctx, mouth, 0.44)
	return body, face.c.Y
end

-- Einäugiges Monsterchen auf zwei Füßen. Selten: heller Bauch.
Builders.Cyclops = function(ctx: Ctx): (Part, number)
	local face: Face = { c = Vector3.new(0, 1.9, 0), r = Vector3.new(1.3, 1.45, 1.2) }
	local body = makePart(ctx, "Body", "Main", face.r * 2, CFrame.new(face.c), "Ellipsoid")
	addFeet(ctx, 0.58, -0.12, Vector3.new(0.85, 0.5, 1.05), "Shade")
	if ctx.eyes == 1 then
		addBigEye(ctx, face, 2.35, 1.3)
	else
		addEyes(ctx, face, 2.3, 0.5, 0.75)
	end
	local mouth = addMouth(ctx, face, 1.5, 0.5, "Open")
	if ctx.tier >= 2 then
		addPatch(ctx, "Belly", "Light", face, 0.95, Vector3.new(1.3, 0.95, 0.5))
	end
	addUltra(ctx, Vector3.new(0, 2.2, 0.95), 0.75, 0.05)
	pair(ctx, function(side)
		stick(
			ctx,
			"Arm",
			"Main",
			Vector3.new(side * 1.1, 1.85, 0),
			Vector3.new(side * 1.5, 1.25, -0.15),
			0.5,
			"Ellipsoid"
		)
	end)
	addBlush(ctx, face, 1.75, 0.92, 1)
	addAntennas(ctx, function(x)
		return topY(face, x, 0)
	end, 0, 0.5, 0.8, math.rad(25), 0)
	addTongue(ctx, mouth, 0.5)
	return body, face.c.Y
end

-- Kawaii-Oktopus: runder Kopf, kurze dicke Tentakel. Selten: Locke in Akzentfarbe.
Builders.Squid = function(ctx: Ctx): (Part, number)
	local face: Face = { c = Vector3.new(0, 2.3, 0), r = Vector3.new(1.35, 1.35, 1.3) }
	local body = makePart(ctx, "Body", "Main", face.r * 2, CFrame.new(face.c), "Ellipsoid")
	local function tentacle(angle: number)
		local dir = Vector3.new(math.sin(angle), 0, -math.cos(angle))
		stick(
			ctx,
			"Tentacle",
			"Main",
			dir * 0.55 + Vector3.new(0, 1.25, 0),
			dir * 1.45 + Vector3.new(0, 0.28, 0),
			0.56,
			"Ellipsoid"
		)
	end
	addEyes(ctx, face, 2.3, 0.55, 0.78)
	addMouth(ctx, face, 1.7, 0.42, "O")
	for _, deg in ipairs({ -40, 40, -110, 110 }) do
		tentacle(math.rad(deg))
	end
	if ctx.tier >= 2 then
		tryPart(
			ctx,
			"Top",
			"Accent",
			Vector3.new(0.5, 0.85, 0.5),
			CFrame.new(0.15, 3.65, 0.1) * CFrame.Angles(0, 0, math.rad(-20)),
			"Ellipsoid"
		)
	end
	addUltra(ctx, Vector3.new(0, 2.4, 0.95), 0.85, 0.05)
	addBlush(ctx, face, 1.9, 0.88, 1)
	pair(ctx, function(side)
		tentacle(math.rad(side * 170))
	end)
	addAntennas(ctx, function(x)
		return topY(face, x, 0)
	end, 0, 0.5, 0.8, math.rad(20), 0, -0.5)
	return body, face.c.Y
end

-- Marienkäfer: runder Panzer mit Mittelnaht, heller Kopf mit Fühlern. Selten: zwei Punkte.
Builders.Bug = function(ctx: Ctx): (Part, number)
	ctx.faceRole = "Light"
	local shell: Face = { c = Vector3.new(0, 1.2, 0.35), r = Vector3.new(1.35, 0.95, 1.35) }
	local body = makePart(ctx, "Body", "Main", shell.r * 2, CFrame.new(shell.c), "Ellipsoid")
	local head: Face = { c = Vector3.new(0, 1.3, -0.85), r = Vector3.new(0.9, 0.82, 0.72) }
	makePart(ctx, "Head", "Light", head.r * 2, CFrame.new(head.c), "Ellipsoid")
	addEyes(ctx, head, 1.45, 0.38, 0.58)
	local mouth = addMouth(ctx, head, 0.98, 0.32, "Open")
	makePart(
		ctx,
		"Seam",
		"Dark",
		Vector3.new(0.1, shell.r.Y * 2 + 0.03, shell.r.Z * 2 + 0.03),
		CFrame.new(shell.c + Vector3.new(0, 0, 0.02)),
		"Ellipsoid"
	)
	for _, z in ipairs({ -0.15, 0.85 }) do
		pair(ctx, function(side)
			stick(
				ctx,
				"Leg",
				"Dark",
				Vector3.new(side * 0.95, 0.6, z),
				Vector3.new(side * 1.35, 0.14, z - 0.1),
				0.28,
				"Ellipsoid"
			)
		end)
	end
	if ctx.tier >= 2 then
		pair(ctx, function(side)
			local x, z = side * 0.62, 0.55
			makePart(
				ctx,
				"Spot",
				"Accent",
				Vector3.new(0.62, 0.3, 0.62),
				CFrame.new(x, topY(shell, x, z) - 0.1, z),
				"Ellipsoid"
			)
		end)
	end
	addUltra(ctx, Vector3.new(0, 1.7, 0.6), 0.8, -0.75)
	addBlush(ctx, head, 1.08, 0.55, 0.75)
	addAntennas(ctx, function(x)
		return topY(head, x, head.c.Z)
	end, head.c.Z, 0.3, 0.85, math.rad(25), math.rad(25))
	addTongue(ctx, mouth, 0.32)
	return body, shell.c.Y
end

-- Knuffiger Roboter: großer Kopf mit Bildschirm-Gesicht, Rolle statt Beine. Selten: Akzent-Streifen.
Builders.Robot = function(ctx: Ctx): (Part, number)
	ctx.faceRole = "Dark"
	makePart(ctx, "Treads", "Metal", Vector3.new(1.8, 0.8, 0.8), CFrame.new(0, 0.4, 0), "Cylinder")
	local bodyY = 1.4
	local body = makePart(ctx, "Body", "Main", Vector3.new(1.7, 1.2, 1.4), CFrame.new(0, bodyY, 0))
	local headY = 2.85
	makePart(ctx, "Head", "Main", Vector3.new(2.3, 1.7, 1.8), CFrame.new(0, headY, 0))
	makePart(ctx, "Visor", "Dark", Vector3.new(1.9, 1.25, 0.1), CFrame.new(0, headY, -0.92))
	local screen = flatFace(0, headY, -0.97)
	for _, offset in ipairs(eyeLayout(ctx.eyes, ctx.eyes >= 3 and 0.36 or 0.45)) do
		local h = ctx.eyes >= 3 and 0.4 or 0.55
		makePart(
			ctx,
			"Eye",
			"Glow",
			Vector3.new(h * 0.72, h, 0.1),
			onFace(screen, offset.X, headY + 0.12 + offset.Y * h, 0),
			"Ellipsoid"
		)
	end
	tryPart(ctx, "Mouth", "Glow", Vector3.new(0.5, 0.14, 0.08), onFace(screen, 0, headY - 0.38, 0), "Ellipsoid")
	if ctx.tier >= 2 then
		tryPart(ctx, "Stripe", "Accent", Vector3.new(2.34, 0.3, 1.84), CFrame.new(0, headY + 0.62, 0))
	end
	addUltra(ctx, Vector3.new(0, headY - 0.1, 0.75), 1.0, 0.05)
	pair(ctx, function(side)
		makePart(ctx, "Ear", "Metal", Vector3.new(0.3, 0.75, 0.75), CFrame.new(side * 1.25, headY, 0), "Cylinder")
	end)
	pair(ctx, function(side)
		stick(
			ctx,
			"Arm",
			"Shade",
			Vector3.new(side * 0.9, 1.75, 0),
			Vector3.new(side * 1.28, 1.05, -0.15),
			0.42,
			"Ellipsoid"
		)
	end)
	addAntennas(ctx, function()
		return headY + 0.85
	end, 0, 0.55, 0.75, math.rad(15), 0)
	tryPart(ctx, "ChestLight", "Glow", Vector3.one * 0.38, CFrame.new(0, bodyY + 0.05, -0.7), "Ball")
	return body, bodyY
end

-- Schwebendes Gespenst mit Wellen-Saum. Selten: Schleife.
Builders.Ghost = function(ctx: Ctx): (Part, number)
	ctx.mainTransparency = math.max(ctx.mainTransparency, 0.08)
	local face: Face = { c = Vector3.new(0, 2.3, 0), r = Vector3.new(1.3, 1.5, 1.25) }
	local body = makePart(ctx, "Body", "Main", face.r * 2, CFrame.new(face.c), "Ellipsoid")
	addEyes(ctx, face, 2.55, 0.5, 0.8)
	local mouth = addMouth(ctx, face, 1.95, 0.42, "Open")
	for i = 0, 2 do
		local angle = math.rad(-60 + 120 * i)
		makePart(
			ctx,
			"Wisp",
			"Main",
			Vector3.new(0.95, 0.85, 0.95),
			CFrame.new(math.sin(angle) * 0.78, 0.9, -math.cos(angle) * 0.78),
			"Ellipsoid"
		)
	end
	if ctx.tier >= 2 and room(ctx, 3) then
		local knot = Vector3.new(0.75, 3.55, -0.1)
		for _, side in ipairs({ -1, 1 }) do
			makePart(
				ctx,
				"Bow",
				"Accent",
				Vector3.new(0.6, 0.42, 0.25),
				CFrame.new(knot + Vector3.new(side * 0.3, 0, 0)) * CFrame.Angles(0, 0, math.rad(side * 20)),
				"Ellipsoid"
			)
		end
		makePart(ctx, "Bow", "Accent", Vector3.one * 0.26, CFrame.new(knot + Vector3.new(0, 0, -0.04)), "Ball")
	end
	addUltra(ctx, Vector3.new(0, 2.5, 0.9), 0.8, 0.05)
	pair(ctx, function(side)
		stick(
			ctx,
			"Arm",
			"Main",
			Vector3.new(side * 1.05, 2.2, 0),
			Vector3.new(side * 1.5, 1.75, -0.25),
			0.5,
			"Ellipsoid"
		)
	end)
	addBlush(ctx, face, 2.1, 0.86, 1)
	addAntennas(ctx, function(x)
		return topY(face, x, 0)
	end, 0, 0.45, 0.8, math.rad(20), 0)
	addTongue(ctx, mouth, 0.42)
	return body, face.c.Y
end

-- Lebender Edelstein (Raute) auf einem Felsen, flankiert von zwei Kristallen. Selten: Kristalle leuchten.
Builders.Crystal = function(ctx: Ctx): (Part, number)
	ctx.mainReflectance = math.max(ctx.mainReflectance, 0.15)
	makePart(ctx, "Rock", "Rock", Vector3.new(3.0, 0.8, 2.6), CFrame.new(0, 0.4, 0), "Ellipsoid")
	local side, depth = 1.75, 1.25
	local bodyY = 0.5 + side * math.sqrt(0.5)
	local body = makePart(
		ctx,
		"Body",
		"Main",
		Vector3.new(side, side, depth),
		CFrame.new(0, bodyY, 0) * CFrame.Angles(0, 0, math.rad(45))
	)
	local face = flatFace(0, bodyY, -depth / 2)
	addEyes(ctx, face, bodyY + 0.2, 0.38, 0.6)
	local mouth = addMouth(ctx, face, bodyY - 0.32, 0.36, "Open")
	local shardRole = ctx.tier >= 2 and "Glow" or "Light"
	pair(ctx, function(sideSign)
		makePart(
			ctx,
			"Shard",
			shardRole,
			Vector3.new(0.6, 1.4, 0.6),
			CFrame.new(sideSign * 1.2, 1.05, 0.3)
				* CFrame.Angles(0, 0, math.rad(-sideSign * 22))
				* CFrame.Angles(0, math.rad(45), 0)
		)
	end)
	addUltra(ctx, Vector3.new(0, bodyY + 0.2, 0.55), 0.7, 0.05)
	addBlush(ctx, face, bodyY - 0.15, 0.62, 0.85)
	addAntennas(ctx, function()
		return bodyY + side * 0.707 - 0.15
	end, 0, 0.25, 0.75, math.rad(25), 0)
	addTongue(ctx, mouth, 0.36)
	return body, bodyY
end

-- Igel: runder Körper, weiche Stacheln auf Rücken + Kopf, Schnäuzchen. Selten: freche Augenbrauen.
Builders.Spiky = function(ctx: Ctx): (Part, number)
	local face: Face = { c = Vector3.new(0, 1.4, 0), r = Vector3.new(1.4, 1.3, 1.35) }
	local body = makePart(ctx, "Body", "Main", face.r * 2, CFrame.new(face.c), "Ellipsoid")
	addEyes(ctx, face, 1.6, 0.52, 0.72)
	local snout = addPatch(ctx, "Snout", "Light", face, 1.05, Vector3.new(0.8, 0.52, 0.75))
	if snout then
		tryPart(ctx, "Nose", "Dark", Vector3.new(0.3, 0.2, 0.2), snout * CFrame.new(0, 0.12, -0.32), "Ellipsoid")
	end
	local function spike(dir: Vector3)
		local d = dir.Unit
		tryPart(
			ctx,
			"Spike",
			"Accent",
			Vector3.new(1.25, 0.5, 0.5),
			axisCFrame(face.c + Vector3.new(d.X * 1.25, d.Y * 1.15, d.Z * 1.2), d),
			"Ellipsoid"
		)
	end
	spike(Vector3.new(0, 1, 0.3))
	for _, dir in ipairs({ Vector3.new(0.6, 0.75, 0.4), Vector3.new(0.75, 0.25, 0.75) }) do
		if room(ctx, 2) then
			spike(dir)
			spike(Vector3.new(-dir.X, dir.Y, dir.Z))
		end
	end
	addFeet(ctx, 0.6, -0.3, Vector3.new(0.75, 0.42, 0.95), "Shade")
	if ctx.tier >= 2 then
		pair(ctx, function(side)
			local cf = onFace(face, side * 0.5, 2.12, 0.02) * CFrame.Angles(0, 0, math.rad(side * -15))
			makePart(ctx, "Brow", "Dark", Vector3.new(0.5, 0.14, 0.14), cf, "Ellipsoid")
		end)
	end
	addUltra(ctx, Vector3.new(0, 1.7, 1.0), 0.8, 0.25)
	addBlush(ctx, face, 1.12, 0.95, 1)
	if room(ctx, 1) then
		spike(Vector3.new(0, 0.45, 1))
	end
	addAntennas(ctx, function(x)
		return topY(face, x, 0)
	end, 0, 0.5, 0.8, math.rad(25), 0)
	return body, face.c.Y
end

-- König: runder Körper, goldene Krone mit Edelstein, Umhang, Schnurrbart. Selten: Zepter.
-- Ultra: Flügel + der Kronen-Edelstein leuchtet (statt Heiligenschein).
Builders.King = function(ctx: Ctx): (Part, number)
	local face: Face = { c = Vector3.new(0, 1.45, 0), r = Vector3.new(1.4, 1.3, 1.3) }
	local body = makePart(ctx, "Body", "Main", face.r * 2, CFrame.new(face.c), "Ellipsoid")
	local crownY = 2.85
	makePart(
		ctx,
		"Crown",
		"Gold",
		Vector3.new(0.55, 1.55, 1.55),
		CFrame.new(0, crownY, 0.05) * CFrame.Angles(0, 0, math.rad(90)),
		"Cylinder"
	)
	for _, pos in ipairs({
		Vector3.new(0, crownY + 0.38, -0.62),
		Vector3.new(-0.62, crownY + 0.38, 0.05),
		Vector3.new(0.62, crownY + 0.38, 0.05),
	}) do
		makePart(ctx, "CrownPoint", "Gold", Vector3.new(0.4, 0.75, 0.4), CFrame.new(pos), "Ellipsoid")
	end
	addEyes(ctx, face, 1.8, 0.52, 0.72)
	if room(ctx, 2) then
		for _, side in ipairs({ -1, 1 }) do
			local cf = onFace(face, side * 0.28, 1.28, 0.02) * CFrame.Angles(0, 0, math.rad(side * 12))
			makePart(ctx, "Mustache", "Dark", Vector3.new(0.62, 0.26, 0.24), cf, "Ellipsoid")
		end
	end
	tryPart(ctx, "Cape", "Cape", Vector3.new(2.6, 2.3, 0.35), CFrame.new(0, 1.4, 1.12), "Ellipsoid")
	tryPart(
		ctx,
		"Gem",
		isUltra(ctx) and "Glow" or "Accent",
		Vector3.one * (isUltra(ctx) and 0.42 or 0.32),
		CFrame.new(0, crownY, -0.78),
		"Ball"
	)
	if ctx.tier >= 2 and room(ctx, 2) then
		stick(ctx, "Scepter", "Gold", Vector3.new(1.45, 0.35, -0.45), Vector3.new(1.45, 2.15, -0.45), 0.16, "Cylinder")
		makePart(ctx, "ScepterGem", "Accent", Vector3.one * 0.42, CFrame.new(1.45, 2.3, -0.45), "Ball")
	end
	addUltra(ctx, Vector3.new(0, 1.9, 1.0), 0.85, nil)
	addFeet(ctx, 0.58, -0.4, Vector3.new(0.82, 0.45, 1.0), "Shade")
	addBlush(ctx, face, 1.45, 0.98, 1)
	addAntennas(ctx, function()
		return crownY + 0.25
	end, 0.3, 0.45, 0.8, math.rad(25), 0)
	return body, face.c.Y
end

-- Pilz: Gesicht im hellen Stiel, großer Hut mit drei Punkten. Selten: Blätter-Spross auf dem Hut.
Builders.Mushroom = function(ctx: Ctx): (Part, number)
	ctx.faceRole = "Stalk"
	local face: Face = { c = Vector3.new(0, 1.15, 0), r = Vector3.new(1.05, 1.15, 1.0) }
	local body = makePart(ctx, "Body", "Stalk", face.r * 2, CFrame.new(face.c), "Ellipsoid")
	local cap: Face = { c = Vector3.new(0, 2.55, 0.05), r = Vector3.new(1.8, 0.95, 1.7) }
	makePart(ctx, "Cap", "Main", cap.r * 2, CFrame.new(cap.c), "Ellipsoid")
	addEyes(ctx, face, 1.3, 0.4, 0.62)
	local mouth = addMouth(ctx, face, 0.8, 0.36, "Open")
	local function spot(x: number, z: number)
		local y = topY(cap, x, z)
		local up = Vector3.new(x / cap.r.X ^ 2, (y - cap.c.Y) / cap.r.Y ^ 2, (z - cap.c.Z) / cap.r.Z ^ 2)
		tryPart(
			ctx,
			"Spot",
			"Accent",
			Vector3.new(0.68, 0.68, 0.26),
			facing(Vector3.new(x, y - 0.06, z), up),
			"Ellipsoid"
		)
	end
	spot(0, -0.55)
	if room(ctx, 2) then
		spot(-1.05, -0.35)
		spot(1.05, -0.35)
	end
	if ctx.tier >= 2 then
		pair(ctx, function(side)
			makePart(
				ctx,
				"Leaf",
				"Leaf",
				Vector3.new(0.7, 0.24, 0.42),
				CFrame.new(side * 0.3, 3.55, 0.3) * CFrame.Angles(0, 0, math.rad(side * 35)),
				"Ellipsoid"
			)
		end)
	end
	addUltra(ctx, Vector3.new(0, 1.7, 0.85), 0.75, 0.05)
	addFeet(ctx, 0.5, -0.25, Vector3.new(0.7, 0.4, 0.85), "StalkShade")
	addBlush(ctx, face, 0.98, 0.66, 0.85)
	addAntennas(ctx, function(x)
		return topY(cap, x, cap.c.Z)
	end, cap.c.Z, 0.55, 0.8, math.rad(20), 0)
	addTongue(ctx, mouth, 0.36)
	return body, face.c.Y
end

-- -------------------------------------------------------------------
-- Effekte + Namensschild
-- -------------------------------------------------------------------
-- Glitzer-Partikel rund ums Alien (Aura der seltenen Aliens, Regenbogen-Mutation)
local function addAura(body: Part, color: ColorSequence, s: number, rate: number)
	local aura = Instance.new("ParticleEmitter")
	aura.Name = "Aura"
	aura.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	aura.Color = color
	aura.LightEmission = 1
	aura.LightInfluence = 0
	aura.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35 * s),
		NumberSequenceKeypoint.new(0.6, 0.25 * s),
		NumberSequenceKeypoint.new(1, 0),
	})
	aura.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	aura.Lifetime = NumberRange.new(1, 1.8)
	aura.Speed = NumberRange.new(0.4, 1.2)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Acceleration = Vector3.new(0, 1.2 * s, 0)
	aura.RotSpeed = NumberRange.new(-90, 90)
	aura.Rate = rate
	aura.Parent = body
end

-- Frost-Mutation: ein paar Schneeflocken rieseln vom Alien herab
local function addSnow(body: Part, s: number, carry: boolean)
	local snow = Instance.new("ParticleEmitter")
	snow.Name = "FrostSnow"
	snow.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	snow.Color = ColorSequence.new(WHITE, FROST_LIGHT)
	snow.LightEmission = 0.5
	snow.LightInfluence = 0.2
	snow.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.22 * s),
		NumberSequenceKeypoint.new(1, 0),
	})
	snow.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	snow.Lifetime = NumberRange.new(1.2, 2)
	snow.Speed = NumberRange.new(0.2, 0.6)
	snow.SpreadAngle = Vector2.new(180, 180)
	snow.Acceleration = Vector3.new(0, -1.5 * s, 0)
	snow.Drag = 1
	snow.RotSpeed = NumberRange.new(-60, 60)
	snow.Rate = carry and 2 or 4
	snow.Parent = body
end

local function addEffects(model: Model, body: Part, alien: AlienDef, mut: any, s: number, carry: boolean)
	local fx = alien.Effects
	local rank = rarityRank(alien.Rarity)
	local color = rarityColor(alien.Rarity)
	local accent = alien.Look.Accent
	local rainbowMut = mut.Rainbow == true
	local mutName = tostring(mut.Name)

	-- Umriss: nur Ultra-Admin-Aliens, getragen keiner. Startet AUS – der Client schaltet nur die
	-- nächsten paar ein (Roblox zeigt höchstens 31 Highlights gleichzeitig, jedes kostet einen Render-Durchgang).
	if fx.Highlight and not carry and alien.Tier == HIGHLIGHT_TIER and alien.Rarity == HIGHLIGHT_RARITY then
		local highlight = Instance.new("Highlight")
		highlight.Name = "Glow"
		highlight.Enabled = false
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.FillColor = color
		highlight.FillTransparency = 0.85
		highlight.OutlineColor = accent
		highlight.OutlineTransparency = 0.1
		if fx.Rainbow or rainbowMut then
			highlight:SetAttribute("Rainbow", true)
		end
		highlight.Parent = model
	end

	if fx.Aura then
		local rate = rank >= ADMIN_RANK and 18 or (rank >= 8 and 10 or 6)
		local auraColor = (fx.Rainbow or rainbowMut) and RAINBOW_SEQUENCE or ColorSequence.new(color, accent)
		addAura(body, auraColor, s, carry and math.ceil(rate / 2) or rate)
	elseif rainbowMut then
		-- Regenbogen-Mutation: bunte Glitzer-Aura auch ohne eigene Aura
		addAura(body, RAINBOW_SEQUENCE, s, carry and 3 or 6)
	end

	if fx.BigLight then
		local light = Instance.new("PointLight")
		light.Name = "BigLight"
		light.Range = 30
		light.Brightness = 2.5
		light.Color = accent:Lerp(color, 0.5)
		light.Shadows = false
		light.Parent = body
	elseif rank >= 8 or (rank >= 5 and alien.Tier ~= "Normal") then
		-- kleines Licht erst ab Legendary (sparsam)
		local light = Instance.new("PointLight")
		light.Name = "Light"
		light.Range = 8 + (rank - 5) * 1.5
		light.Brightness = 1.2
		light.Color = color
		light.Shadows = false
		light.Parent = body
	end

	if fx.Fire then
		local fire = Instance.new("Fire")
		fire.Color = color
		fire.SecondaryColor = accent
		fire.Size = 3 * s
		fire.Heat = 6
		fire.Parent = body
	elseif mutName == "Lava" then
		-- Lava-Mutation: kleines Feuer (nur eins pro Alien)
		local fire = Instance.new("Fire")
		fire.Name = "LavaFire"
		fire.Color = typeof(mut.Color) == "Color3" and mut.Color or LAVA_ORANGE
		fire.SecondaryColor = LAVA_DARK
		fire.Size = math.clamp(2.2 * s, 2, 6)
		fire.Heat = 4
		fire.Parent = body
	end

	if mutName == "Frost" then
		addSnow(body, s, carry)
	end

	if mutName == "Galaxy" then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = mut.Color or color
		sparkles.Parent = body
	elseif rainbowMut and not carry then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = WHITE
		sparkles.Parent = body
	end
end

local function makeLabel(parent: Instance, name: string, order: number, textSize: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, textSize + 4)
	label.LayoutOrder = order
	label.Font = Enum.Font.FredokaOne
	label.TextSize = textSize
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = ""
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function getBody(model: Model): BasePart?
	local primary = model.PrimaryPart
	if primary then
		return primary
	end
	local body = model:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		return body
	end
	return nil
end

-- Abstand Schild <-> Body-Mitte passend zur aktuellen Größe
local function updateLabelOffset(model: Model, body: BasePart)
	local gui = body:FindFirstChild("Info")
	if not gui or not gui:IsA("BillboardGui") then
		return
	end
	local scale = model:GetScale()
	local top = tonumber(model:GetAttribute("TopHeight")) or body.Size.Y
	local pivot = tonumber(model:GetAttribute("PivotHeight")) or body.Size.Y / 2
	gui.StudsOffsetWorldSpace = Vector3.new(0, (top - pivot) * scale + LABEL_GAP, 0)
end

-- -------------------------------------------------------------------
-- ÖFFENTLICH
-- -------------------------------------------------------------------

-- Schild aktualisieren: Name, "Stufe • Seltenheit [• 🔥 Mutation]", "$X/s ⚡Lv n"
function AlienFactory.UpdateLabel(model: Model, entry: Entry)
	local body = getBody(model)
	local gui = body and body:FindFirstChild("Info")
	local frame = gui and gui:FindFirstChild("Frame")
	if not frame then
		return
	end
	local nameLabel = frame:FindFirstChild("NameLabel") :: TextLabel?
	local rarityLabel = frame:FindFirstChild("RarityLabel") :: TextLabel?
	local valueLabel = frame:FindFirstChild("ValueLabel") :: TextLabel?
	local alien = resolveAlien(entry)
	local mut = getMutation(entry.Mut)
	local color = rarityColor(alien.Rarity)

	if nameLabel then
		nameLabel.Text = alien.Name
		nameLabel.TextColor3 = color
	end
	if rarityLabel then
		local tag = alien.Tier .. " • " .. alien.Rarity
		if mut.Name ~= "Normal" then
			tag ..= " • " .. mutationText(mut)
		end
		rarityLabel.Text = tag
		rarityLabel.TextColor3 = mut.Color
			or (alien.Tier == "Normal" and color or Aliens.TierColors[alien.Tier] or color)
	end
	if valueLabel then
		-- Unbekannte Alien-Id -> mit dem Ersatz-Alien rechnen, damit Config nicht stolpert
		local incomeEntry = (entry.Alien == alien.Id) and entry
			or { Id = entry.Id, Alien = alien.Id, Mut = entry.Mut, Lv = entry.Lv }
		local income = tonumber(Config.MeteorIncome(incomeEntry)) or 0
		local lv = levelOf(entry)
		local lvText = lv >= maxLevel() and "MAX" or tostring(lv)
		valueLabel.Text = Util.FormatCash(income) .. "/s  ⚡Lv " .. lvText
		valueLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
	end
end

-- entry = { Id = meteorId, Alien = alienId, Mut, Lv }, mode = "Base" | "Carry" | "Photo"
function AlienFactory.Create(entry: Entry, mode: string?): Model
	local alien = resolveAlien(entry)
	local look = alien.Look
	local fx = alien.Effects
	local rank = rarityRank(alien.Rarity)
	local mut = getMutation(entry.Mut)
	local modeName = (mode == "Carry" or mode == "Photo") and mode or "Base"
	local carry = modeName == "Carry"
	local lvScale = levelScale(levelOf(entry))
	local s = look.Scale * MODE_SCALE[modeName] * lvScale

	local model = Instance.new("Model")
	model.Name = "Alien"

	-- Mutation: Regenbogen färbt der Client durch (eigene Farbe bleibt als Grundfarbe),
	-- alle anderen färben den Körper in der Mutationsfarbe (+ Material aus MUT_STYLES)
	local mutName = tostring(mut.Name)
	local rainbowMut = mut.Rainbow == true
	local mutColor: Color3? = nil
	if not rainbowMut and mutName ~= "Normal" and typeof(mut.Color) == "Color3" then
		mutColor = mut.Color
	end

	local ctx: Ctx = {
		model = model,
		s = s,
		color = look.Color,
		accent = look.Accent,
		eyes = look.Eyes,
		antennas = look.Antennas,
		tier = TIER_INDEX[alien.Tier] or 1,
		rank = rank,
		admin = rank >= ADMIN_RANK,
		faceRole = "Main",
		mutStyle = if rainbowMut then nil else MUT_STYLES[mutName],
		mutColor = mutColor,
		rainbow = fx.Rainbow == true or rainbowMut,
		rainbowShade = rainbowMut,
		carry = carry,
		mainMaterial = Enum.Material.SmoothPlastic,
		mainTransparency = 0,
		mainReflectance = look.Archetype == "Robot" and 0.12 or 0,
		count = 0,
		max = rank >= ADMIN_RANK and MAX_PARTS_ADMIN or MAX_PARTS,
		top = 0,
	}

	local builder = Builders[look.Archetype] or Builders.Blob
	local body, bodyY = builder(ctx)
	finishUltra(ctx)
	body.CanQuery = not carry -- für Prompts/Klicks; getragen stört es nur die Kamera

	-- Pivot = Bodenmitte, aufrecht, Blick nach -Z (beim Bauen = Welt-Ursprung).
	-- Bei gesetztem PrimaryPart zählt dessen PivotOffset (relativ zum gedrehten Body!).
	body.PivotOffset = body.CFrame:Inverse()
	model.WorldPivot = CFrame.new()
	model.PrimaryPart = body

	model:SetAttribute("AlienId", alien.Id)
	model:SetAttribute("MeteorId", entry.Id)
	model:SetAttribute("Rarity", alien.Rarity)
	model:SetAttribute("Tier", alien.Tier)
	model:SetAttribute("Mutation", mutName)
	model:SetAttribute("Bob", not carry) -- getragene Aliens nicht wippen (würde den Spieler mitbewegen)
	if ctx.rainbow then
		model:SetAttribute("Rainbow", true)
	end
	-- für Refresh: Höhen beim Bauen (inkl. Skalierung) + Level-Faktor beim Bauen
	model:SetAttribute("PivotHeight", bodyY * s)
	model:SetAttribute("TopHeight", ctx.top * s)
	model:SetAttribute("BuiltLevelScale", lvScale)
	-- nur für Client-Animationen (Squash & Stretch, Bewegungsstil): Body-Größe beim Bauen, Körperform
	model:SetAttribute("Archetype", look.Archetype)
	body:SetAttribute("BaseSize", body.Size)

	addEffects(model, body, alien, mut, s, carry)

	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.new(0, 240, 0, 70)
	gui.StudsOffsetWorldSpace = Vector3.new(0, (ctx.top - bodyY) * s + LABEL_GAP, 0)
	gui.MaxDistance = carry and 60 or (70 + rank * 15)
	gui.LightInfluence = 0
	gui.Parent = body

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Parent = frame

	makeLabel(frame, "NameLabel", 1, 20)
	makeLabel(frame, "RarityLabel", 2, 15)
	makeLabel(frame, "ValueLabel", 3, 17)

	AlienFactory.UpdateLabel(model, entry)
	return model
end

-- Nach einem Level-Up: Größe leicht anpassen (Boden bleibt, wo er ist) + Schild aktualisieren
function AlienFactory.Refresh(model: Model, entry: Entry)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return
	end
	local body = getBody(model)
	if not body then
		return
	end
	local built = tonumber(model:GetAttribute("BuiltLevelScale")) or 1
	local target = levelScale(levelOf(entry)) / (built > 0 and built or 1)
	local current = model:GetScale()
	if math.abs(current - target) > 0.001 then
		-- Lage des Body relativ zum Boden-Pivot merken, skalieren, Pivot neu setzen, zurückstellen
		local pivot = model:GetPivot()
		local rel = pivot:ToObjectSpace(body.CFrame)
		model:ScaleTo(target)
		local scaledRel = CFrame.new(rel.Position * (target / current)) * rel.Rotation
		body.PivotOffset = scaledRel:Inverse()
		model:PivotTo(pivot)
		body:SetAttribute("BaseSize", body.Size) -- Client-Squash rechnet mit der neuen Größe
		-- Zähler: der Client (Wippen) merkt daran, dass sich die Teile verändert haben
		model:SetAttribute("Rev", (tonumber(model:GetAttribute("Rev")) or 0) + 1)
	end
	updateLabelOffset(model, body)
	AlienFactory.UpdateLabel(model, entry)
end

return AlienFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">BaseBuilder</string>
            <string name="Source"><![CDATA[-- Baut die Basen (von MapBuilder.Build aufgerufen) und ändert sie zur Laufzeit (PlotService):
--   • 8 OFFENE Basen (je 4 pro Seite, Eingang zum Nester-Feld, 80 x 90 Studs): bunter Noppenboden, niedriger
--     Rand an Seiten + hinten, vorne offen mit Laser-Sperre, großer Lock-Knopf, Geld-Pad, Namensschild
--   • Slot-Anker (unsichtbar): 18 im Erdgeschoss + je 6 auf Stockwerk 2 und 3 (immer da, Nummern fest)
--   • STOCKWERKE (Config.BaseFloors): offene Plattformen über dem hinteren Teil, Treppe hoch.
--     Nur gebaut, wenn gekauft (SetFloors)
--   • BASE-LOOK (Config.BaseLooks, Stufe 1-5): Zaun, Laternen, Torbogen, Fahnen, Bodenrand (SetLook)
-- Lokales System einer Base: -Z = Eingang (zum Nester-Feld), X = Breite, Z = Tiefe.
-- Stil: schlicht, bunt, blockig (Plastic + Noppen), wenig Neon, wenige Teile.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local BaseBuilder = {}

-- -------------------------------------------------------------------
-- MASSE & FARBEN (Studs)
-- -------------------------------------------------------------------
local PLOT_WIDTH = 80 -- lokales X
local PLOT_DEPTH = 90 -- lokales Z
local HALF_X = PLOT_WIDTH / 2
local HALF_Z = PLOT_DEPTH / 2
local PLOT_X = 79 -- Abstand Basis-Mitte <-> Map-Mitte (Eingang bei x = ±34, Rückseite bei x = ±124)
local PLOT_Z = { -135, -45, 45, 135 } -- 10 Studs Lücke zwischen den Basen
local PLOT_FLOOR_TOP = 1
local FENCE_HEIGHT = 2 -- niedriger Rand (drüberspringen geht – Schutz macht der Lock-Rauswurf)
local FENCE_THICK = 1
local BARRIER_HEIGHT = 10
local POST_SIZE = 1.4 -- Laser-Pfosten an beiden Seiten des Eingangs
local LASER_BEAMS = 5 -- so viele Laser-Streifen zeichnet der Client
local POST_X = 40 - POST_SIZE / 2 + 0.1 -- Pfosten-Mitte (außen 0,1 über den Zaun -> kein Flackern)
local GATE_Z = -45 + 0.6 -- Laser-Sperre + Pfosten (vor der Zaun-Stirnseite)

-- Stockwerke: Abstand von Boden zu Boden, Rand oben, Platte
local FLOOR_GAP = 16
local FLOOR_THICK = 1
local RIM_HEIGHT = 1.5
local STAIR_WIDTH = 6
local PILLAR = 2

local PLOT_COLORS = {
	Color3.fromRGB(196, 40, 28),
	Color3.fromRGB(218, 133, 65),
	Color3.fromRGB(245, 205, 48),
	Color3.fromRGB(75, 151, 75),
	Color3.fromRGB(13, 105, 172),
	Color3.fromRGB(4, 175, 236),
	Color3.fromRGB(107, 50, 124),
	Color3.fromRGB(255, 102, 204),
}
local WOOD_COLOR = Color3.fromRGB(124, 92, 70)
local TREE_COLORS = {
	Color3.fromRGB(60, 170, 60),
	Color3.fromRGB(80, 190, 70),
	Color3.fromRGB(45, 150, 55),
	Color3.fromRGB(100, 200, 80),
}
local FLAG_COLORS = {
	Color3.fromRGB(196, 40, 28),
	Color3.fromRGB(245, 205, 48),
	Color3.fromRGB(13, 105, 172),
	Color3.fromRGB(75, 151, 75),
	Color3.fromRGB(255, 102, 204),
}
local WHITE = Color3.new(1, 1, 1)

-- Unsichtbare Slot-Anker im Erdgeschoss: versetztes Raster (5-4-5-4 = 18), Reihe 1 nahe Eingang.
-- Abstand 13 Studs + etwas Zufall (fester Seed: alle Basen gleich).
local SLOT_ROWS = {
	{ Z = -14, Count = 5 },
	{ Z = -1, Count = 4 },
	{ Z = 12, Count = 5 },
	{ Z = 25, Count = 4 },
}
local SLOT_SPACING = 13
local SLOT_JITTER = 1
local SLOT_YAW = math.rad(12)
local SLOT_SEED = 4711
-- Anker-Kasten vom Boden bis 3 Studs hoch: durchlaufen = Geld einsammeln (Touched),
-- PlotService.SlotTopCFrame nimmt die Unterkante (= Bodenhöhe)
local SLOT_ANCHOR_SIZE = Vector3.new(6, 3, 6)

-- Stockwerke (Index 1 = Stockwerk 2). MinZ/MaxZ = Plattform (lokal), Stairs = Treppe darunter
-- (X-Mitte, Start-Z unten, End-Z oben), Gap = offene Seite im vorderen Rand für die Treppe, Slots = (X, Z)
type StoryDef = {
	MinZ: number,
	StairX: number,
	StairFromZ: number,
	StairToZ: number,
	GapMinX: number,
	GapMaxX: number,
	Slots: { Vector2 },
}
local STORIES: { StoryDef } = {
	{
		MinZ = 2,
		StairX = -35.5,
		StairFromZ = -18,
		StairToZ = 2,
		GapMinX = -HALF_X,
		GapMaxX = -32.5,
		Slots = {
			Vector2.new(-22, 12),
			Vector2.new(0, 12),
			Vector2.new(22, 12),
			Vector2.new(-22, 32),
			Vector2.new(0, 32),
			Vector2.new(22, 32),
		},
	},
	{
		MinZ = 20,
		StairX = 35.5,
		StairFromZ = 4,
		StairToZ = 20,
		GapMinX = 32.5,
		GapMaxX = HALF_X,
		Slots = {
			Vector2.new(-22, 28),
			Vector2.new(0, 28),
			Vector2.new(22, 28),
			Vector2.new(-22, 39),
			Vector2.new(0, 39),
			Vector2.new(22, 39),
		},
	},
}

-- Base-Look je Stufe (1-5): Zaunfarbe/-material, Lampenfarbe, Torbogen, Fahnen, Bodenrand
type LookStyle = {
	Fence: Color3,
	FenceMat: Enum.Material,
	Cap: Color3?, -- Leuchtkante oben auf dem Zaun (nur Stufe 5)
	Lamp: Color3,
	Arch: Color3?,
	ArchMat: Enum.Material,
	Flags: number,
	Trim: Color3?,
	Lanterns: number,
}
local LOOKS: { LookStyle } = {
	{
		Fence = Color3.fromRGB(242, 243, 243),
		FenceMat = Enum.Material.Plastic,
		Lamp = Color3.fromRGB(255, 220, 120),
		ArchMat = Enum.Material.Plastic,
		Flags = 0,
		Lanterns = 2,
	},
	{
		Fence = Color3.fromRGB(160, 110, 70),
		FenceMat = Enum.Material.Wood,
		Lamp = Color3.fromRGB(255, 220, 120),
		Arch = Color3.fromRGB(124, 92, 70),
		ArchMat = Enum.Material.Wood,
		Flags = 0,
		Lanterns = 4,
	},
	{
		Fence = Color3.fromRGB(150, 150, 160),
		FenceMat = Enum.Material.Slate,
		Lamp = Color3.fromRGB(255, 200, 90),
		Arch = Color3.fromRGB(130, 130, 140),
		ArchMat = Enum.Material.Slate,
		Flags = 2,
		Trim = Color3.fromRGB(110, 110, 120),
		Lanterns = 4,
	},
	{
		Fence = Color3.fromRGB(120, 210, 255),
		FenceMat = Enum.Material.SmoothPlastic,
		Lamp = Color3.fromRGB(110, 230, 255),
		Arch = Color3.fromRGB(90, 190, 255),
		ArchMat = Enum.Material.SmoothPlastic,
		Flags = 4,
		Trim = Color3.fromRGB(80, 170, 240),
		Lanterns = 6,
	},
	{
		Fence = Color3.fromRGB(255, 200, 40),
		FenceMat = Enum.Material.SmoothPlastic,
		Cap = Color3.fromRGB(255, 240, 150),
		Lamp = Color3.fromRGB(255, 230, 90),
		Arch = Color3.fromRGB(255, 190, 30),
		ArchMat = Enum.Material.SmoothPlastic,
		Flags = 6,
		Trim = Color3.fromRGB(255, 210, 60),
		Lanterns = 6,
	},
}

-- -------------------------------------------------------------------
-- BAU-HELFER
-- -------------------------------------------------------------------
local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false -- nur Pads brauchen Touched
	for key, value in pairs(props) do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function anchorPart(name: string, cframe: CFrame, parent: Instance): Part
	return part({
		Name = name,
		Size = Vector3.new(1, 1, 1),
		CFrame = cframe,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = parent,
	})
end

local function addStroke(label: GuiObject, thickness: number)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = thickness
	stroke.Color = Color3.new(0, 0, 0)
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
end

-- Schild in Studs-Größe (wächst mit der Entfernung mit wie ein echtes Schild)
local function bigLabel(
	parent: Instance,
	width: number,
	height: number,
	offset: Vector3,
	maxDistance: number
): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(width, height)
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	gui.Parent = parent
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = WHITE
	addStroke(label, 4)
	label.Parent = gui
	return label
end

-- Blockiger Roblox-Baum: Stamm + großer Blätterblock + kleiner Block obendrauf (3 Teile)
local function blockTree(parent: Instance, cf: CFrame, scale: number, color: Color3)
	local trunkHeight = 6 * scale
	local trunkWidth = 2 * scale
	part({
		Name = "Trunk",
		Size = Vector3.new(trunkWidth, trunkHeight, trunkWidth),
		CFrame = cf * CFrame.new(0, trunkHeight / 2, 0),
		Material = Enum.Material.Plastic,
		Color = WOOD_COLOR,
		Parent = parent,
	})
	local leafWidth, leafHeight = 8 * scale, 5 * scale
	local leaves = part({
		Name = "Leaves",
		Size = Vector3.new(leafWidth, leafHeight, leafWidth),
		CFrame = cf * CFrame.new(0, trunkHeight + leafHeight / 2, 0),
		Material = Enum.Material.Plastic,
		Color = color,
		CanCollide = false,
		Parent = parent,
	})
	leaves.TopSurface = Enum.SurfaceType.Studs
	local topWidth, topHeight = 5 * scale, 3 * scale
	local crown = part({
		Name = "Leaves",
		Size = Vector3.new(topWidth, topHeight, topWidth),
		CFrame = cf * CFrame.new(0, trunkHeight + leafHeight + topHeight / 2, 0),
		Material = Enum.Material.Plastic,
		Color = color,
		CanCollide = false,
		Parent = parent,
	})
	crown.TopSurface = Enum.SurfaceType.Studs
end

-- Laterne: Pfosten + leuchtender Würfel. Nur Würfel namens "LanternLamp" bekommen nachts ein Licht
-- (GraphicsService) – die Extra-Laternen heißen "LanternGlow" (Lichter-Budget).
local function lantern(parent: Instance, cf: CFrame, postColor: Color3, lampColor: Color3, lampName: string)
	local height = 6
	part({
		Name = "LanternPost",
		Size = Vector3.new(0.8, height, 0.8),
		CFrame = cf * CFrame.new(0, height / 2, 0),
		Material = Enum.Material.Plastic,
		Color = postColor,
		Parent = parent,
	})
	part({
		Name = lampName,
		Size = Vector3.new(1.6, 1.6, 1.6),
		CFrame = cf * CFrame.new(0, height + 0.8, 0),
		Material = Enum.Material.Neon,
		Color = lampColor,
		CanCollide = false,
		CastShadow = false,
		Parent = parent,
	})
end

-- Fahne: Stange + Tuch
local function flag(parent: Instance, cf: CFrame, color: Color3, height: number)
	part({
		Name = "FlagPole",
		Size = Vector3.new(0.5, height, 0.5),
		CFrame = cf * CFrame.new(0, height / 2, 0),
		Material = Enum.Material.Plastic,
		Color = WHITE,
		CastShadow = false,
		Parent = parent,
	})
	part({
		Name = "Flag",
		Size = Vector3.new(3.4, 2.2, 0.2),
		CFrame = cf * CFrame.new(1.95, height - 1.3, 0),
		Material = Enum.Material.Plastic,
		Color = color,
		CanCollide = false,
		CastShadow = false,
		Parent = parent,
	})
end

-- Lokale Positionen (X, Z, Drehung) der 18 Erdgeschoss-Anker in Slot-Reihenfolge
local function groundLayout(): { { X: number, Z: number, Yaw: number } }
	local rng = Random.new(SLOT_SEED)
	local list = {}
	for _, row in ipairs(SLOT_ROWS) do
		for i = 1, row.Count do
			local x = (i - (row.Count + 1) / 2) * SLOT_SPACING
			table.insert(list, {
				X = x + rng:NextNumber(-SLOT_JITTER, SLOT_JITTER),
				Z = row.Z + rng:NextNumber(-SLOT_JITTER, SLOT_JITTER),
				Yaw = rng:NextNumber(-SLOT_YAW, SLOT_YAW),
			})
		end
	end
	return list
end

-- Wie viele Stockwerke es geben kann (Erdgeschoss + gebaute Layouts, begrenzt durch Config.BaseFloors)
function BaseBuilder.MaxFloors(): number
	local defs = (Config :: any).BaseFloors
	local count = type(defs) == "table" and #defs or 0
	return 1 + math.min(count, #STORIES)
end

-- Bodenhöhe (lokal) eines Stockwerks (1 = Erdgeschoss)
function BaseBuilder.FloorTop(floor: number): number
	return PLOT_FLOOR_TOP + (floor - 1) * FLOOR_GAP
end

-- Obergrenze für PlotService.IsInside (lokales Y): höchster gebauter Boden + Luft zum Springen
local function topY(floors: number): number
	return 40 + (floors - 1) * FLOOR_GAP
end

-- -------------------------------------------------------------------
-- EINE BASE
-- -------------------------------------------------------------------
local function buildPlot(index: number, cf: CFrame, color: Color3, parent: Instance)
	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model:SetAttribute("PlotIndex", index)
	model:SetAttribute("OwnerUserId", 0)
	model:SetAttribute("LockedUntil", 0)
	model:SetAttribute("BaseFloors", 1)
	model:SetAttribute("BaseLook", 1)

	local top = PLOT_FLOOR_TOP
	-- Boden: kräftige Plastikfarbe mit Noppen. BaseFloor = hier dürfen Fallen stehen (GadgetService)
	local floorPart = part({
		Name = "Floor",
		Size = Vector3.new(PLOT_WIDTH, top, PLOT_DEPTH),
		CFrame = cf * CFrame.new(0, top / 2, 0),
		Material = Enum.Material.Plastic,
		Color = color,
		Parent = model,
	})
	floorPart.TopSurface = Enum.SurfaceType.Studs
	floorPart:SetAttribute("BaseFloor", true)
	model.PrimaryPart = floorPart

	-- Niedriger Rand: hinten über die ganze Breite, Seiten enden STUMPF an der Rückwand (kein Z-Fighting)
	local fences: { BasePart } = {}
	local function fence(name: string, size: Vector3, offset: CFrame)
		local p = part({
			Name = name,
			Size = size,
			CFrame = cf * offset,
			Material = Enum.Material.Plastic,
			Color = LOOKS[1].Fence,
			Parent = model,
		})
		p.TopSurface = Enum.SurfaceType.Studs
		table.insert(fences, p)
	end
	local fenceY = top + FENCE_HEIGHT / 2
	fence(
		"BackFence",
		Vector3.new(PLOT_WIDTH, FENCE_HEIGHT, FENCE_THICK),
		CFrame.new(0, fenceY, HALF_Z - FENCE_THICK / 2)
	)
	local sideLength = PLOT_DEPTH - FENCE_THICK
	for _, s in ipairs({ -1, 1 }) do
		fence(
			"SideFence",
			Vector3.new(FENCE_THICK, FENCE_HEIGHT, sideLength),
			CFrame.new(s * (HALF_X - FENCE_THICK / 2), fenceY, -FENCE_THICK / 2)
		)
	end

	-- Laser-Sperre vorne: Barrier = Kraftfeld (PlotService), die Laser-Streifen zeichnet der Client
	-- zwischen den beiden Pfosten (fahren beim Sperren sichtbar zu).
	local barrier = part({
		Name = "Barrier",
		Size = Vector3.new(PLOT_WIDTH - 2 * POST_SIZE - 0.2, BARRIER_HEIGHT, 0.4),
		CFrame = cf * CFrame.new(0, top + BARRIER_HEIGHT / 2, GATE_Z),
		Material = Enum.Material.ForceField,
		Color = Color3.fromRGB(255, 40, 40),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = model,
	})
	barrier:SetAttribute("Beams", LASER_BEAMS)
	for _, s in ipairs({ -1, 1 }) do
		local post = part({
			Name = s < 0 and "LaserPostL" or "LaserPostR",
			Size = Vector3.new(POST_SIZE, BARRIER_HEIGHT, POST_SIZE),
			CFrame = cf * CFrame.new(s * POST_X, top + BARRIER_HEIGHT / 2, GATE_Z),
			Material = Enum.Material.Plastic,
			Color = Color3.fromRGB(60, 60, 70),
			Parent = model,
		})
		post.TopSurface = Enum.SurfaceType.Studs
		-- rote Linse innen (zeigt zur Mitte)
		part({
			Name = "Lens",
			Size = Vector3.new(0.2, BARRIER_HEIGHT - 1, 0.6),
			CFrame = post.CFrame * CFrame.new(-s * (POST_SIZE / 2 + 0.1), 0, 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 60, 60),
			CanCollide = false,
			CanQuery = false,
			CastShadow = false,
			Parent = model,
		})
	end
	-- großer Countdown mitten über dem Eingang (für Diebe gut sichtbar)
	local barrierLabel = bigLabel(barrier, 14, 3.5, Vector3.new(0, BARRIER_HEIGHT / 2 + 1, 0), 220)
	barrierLabel.Text = ""

	-- Unsichtbare Slot-Anker (Reihenfolge = Slot-Nummer): erst Erdgeschoss, dann Stockwerk 2, 3.
	-- CanTouch: durchlaufen = Geld einsammeln (PlotService), CanQuery aus (Fallen-Strahl, Prompts).
	local slots: { BasePart } = {}
	local function addSlot(localCf: CFrame)
		local number = #slots + 1
		slots[number] = part({
			Name = "Slot" .. number,
			Size = SLOT_ANCHOR_SIZE,
			CFrame = cf * localCf,
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			CanTouch = true,
			CastShadow = false,
			Parent = model,
		})
		return number
	end
	for _, spot in ipairs(groundLayout()) do
		addSlot(CFrame.new(spot.X, top + SLOT_ANCHOR_SIZE.Y / 2, spot.Z) * CFrame.Angles(0, spot.Yaw, 0))
	end
	local groundCount = #slots
	local floorSlots: { [number]: { number } } = {}
	local rng = Random.new(SLOT_SEED + 1)
	for i, story in ipairs(STORIES) do
		local floor = i + 1
		local def = (Config :: any).BaseFloors and (Config :: any).BaseFloors[i]
		local want = math.clamp(math.floor(tonumber(def and def.Slots) or #story.Slots), 0, #story.Slots)
		local list = {}
		local y = BaseBuilder.FloorTop(floor) + SLOT_ANCHOR_SIZE.Y / 2
		for n = 1, want do
			local spot = story.Slots[n]
			local yaw = rng:NextNumber(-SLOT_YAW, SLOT_YAW)
			table.insert(list, addSlot(CFrame.new(spot.X, y, spot.Y) * CFrame.Angles(0, yaw, 0)))
		end
		floorSlots[floor] = list
	end

	-- Geld-Pad vorne links
	local collectPad = part({
		Name = "CollectPad",
		Size = Vector3.new(12, 0.3, 7),
		CFrame = cf * CFrame.new(-22, top + 0.15, -36),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(60, 220, 90),
		CanCollide = false,
		CanTouch = true,
		CastShadow = false,
		Parent = model,
	})
	local collectLabel = bigLabel(collectPad, 9, 2.4, Vector3.new(0, 3.5, 0), 120)
	collectLabel.Text = "💰 $0"

	-- Großer Lock-Knopf vorne rechts: Sockel (begehbar) + roter Knopf (drückt sich ein, PlotService)
	local socket = part({
		Name = "LockSocket",
		Size = Vector3.new(8, 0.6, 8),
		CFrame = cf * CFrame.new(22, top + 0.3, -36),
		Material = Enum.Material.Plastic,
		Color = Color3.fromRGB(60, 60, 70),
		Parent = model,
	})
	socket.TopSurface = Enum.SurfaceType.Studs
	local buttonUp = cf * CFrame.new(22, top + 0.6 + 0.7, -36)
	local lockPad = part({
		Name = "LockPad",
		Size = Vector3.new(5.5, 1.4, 5.5),
		CFrame = buttonUp,
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(230, 60, 60),
		CanCollide = false,
		CanTouch = true,
		Parent = model,
	})
	lockPad.TopSurface = Enum.SurfaceType.Studs
	local lockLabel = bigLabel(lockPad, 10, 3, Vector3.new(0, 4.5, 0), 160)
	lockLabel.Text = "🔒 LOCK"

	-- Deko: Laternen + Look-Teile (SetLook), blockige Bäume hinten in den Ecken
	folder("Look", model)
	local deco = folder("Deco", model)
	for _, s in ipairs({ -1, 1 }) do
		blockTree(deco, cf * CFrame.new(s * 33, top, 38), 0.9, TREE_COLORS[(index + s) % #TREE_COLORS + 1])
	end

	-- Großes Namensschild über dem Eingang: Avatar-Kopf + Name (PlotService setzt Bild + Text)
	local signPart = anchorPart("Sign", cf * CFrame.new(0, top + 21, -HALF_Z + 2), model)
	local signGui = Instance.new("BillboardGui")
	signGui.Name = "NameSign"
	signGui.Size = UDim2.fromScale(30, 7)
	signGui.MaxDistance = 400
	signGui.LightInfluence = 0
	signGui.Parent = signPart
	local board = Instance.new("Frame")
	board.Name = "Board"
	board.Size = UDim2.fromScale(1, 1)
	board.BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.35)
	board.BackgroundTransparency = 0.1
	board.Parent = signGui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.2, 0)
	corner.Parent = board
	local boardStroke = Instance.new("UIStroke")
	boardStroke.Thickness = 4
	boardStroke.Color = Color3.new(0, 0, 0)
	boardStroke.Parent = board
	local signImage = Instance.new("ImageLabel")
	signImage.Name = "Avatar"
	signImage.AnchorPoint = Vector2.new(0, 0.5)
	signImage.Position = UDim2.new(0.02, 0, 0.5, 0)
	signImage.Size = UDim2.fromScale(0.85, 0.85)
	signImage.SizeConstraint = Enum.SizeConstraint.RelativeYY
	signImage.BackgroundColor3 = WHITE
	signImage.BackgroundTransparency = 0.2
	signImage.Image = ""
	signImage.Parent = board
	local imageCorner = Instance.new("UICorner")
	imageCorner.CornerRadius = UDim.new(0.25, 0)
	imageCorner.Parent = signImage
	local signLabel = Instance.new("TextLabel")
	signLabel.Name = "Name"
	signLabel.BackgroundTransparency = 1
	signLabel.Position = UDim2.fromScale(0.27, 0.1)
	signLabel.Size = UDim2.fromScale(0.7, 0.8)
	signLabel.Font = Enum.Font.FredokaOne
	signLabel.TextScaled = true
	signLabel.TextColor3 = WHITE
	signLabel.Text = "Freie Base"
	addStroke(signLabel, 3)
	signLabel.Parent = board

	folder("Floors", model)
	folder("CashPads", model)
	local meteorFolder = folder("Meteors", model)
	model.Parent = parent

	local plot = {
		Index = index,
		Model = model,
		CFrame = cf,
		-- HalfSize = größere Hälfte (alter Code); genau: HalfSizeX (Breite) / HalfSizeZ (Tiefe), lokal
		HalfSize = math.max(HALF_X, HALF_Z),
		HalfSizeX = HALF_X,
		HalfSizeZ = HALF_Z,
		Color = color,
		Owner = nil :: Player?,
		Slots = slots,
		GroundSlots = groundCount, -- Slots 1..GroundSlots liegen im Erdgeschoss
		FloorSlots = floorSlots, -- [2] = { 19..24 }, [3] = { 25..30 }
		MeteorParts = {} :: { [number]: Instance },
		CashPads = {} :: { [number]: BasePart },
		MeteorFolder = meteorFolder,
		CollectPad = collectPad,
		CollectLabel = collectLabel,
		LockPad = lockPad,
		LockPadUp = buttonUp, -- Ruhelage des Knopfs (gedrückt = 0,9 tiefer)
		LockLabel = lockLabel,
		Barrier = barrier,
		BarrierLabel = barrierLabel,
		SignLabel = signLabel,
		SignImage = signImage,
		Fences = fences,
		Floors = 1, -- gebaute Stockwerke (SetFloors)
		Look = 0, -- gebaute Look-Stufe (SetLook)
		TopY = topY(1),
		LockedUntil = 0,
		-- Spawn: vorne in der Mitte zwischen Geld-Pad und Lock-Knopf
		SpawnCFrame = cf * CFrame.new(0, top + 3, -30),
		-- Rauswurf: 8 Studs vor dem Eingang auf der Wiese
		EntranceCFrame = cf * CFrame.new(0, 4, -HALF_Z - 8),
	}
	BaseBuilder.SetLook(plot, 1)
	return plot
end

-- Alle Basen (Ordner "Plots" – der Client sucht ihn!)
function BaseBuilder.BuildPlots(map: Instance): { any }
	local plotsFolder = folder("Plots", map)
	local maxPlots = math.clamp(math.floor(tonumber((Config :: any).MaxPlots) or 8), 1, 2 * #PLOT_Z)
	local plots = {}
	for _, side in ipairs({ -1, 1 }) do
		for _, z in ipairs(PLOT_Z) do
			local index = #plots + 1
			if index > maxPlots then
				break
			end
			local center = Vector3.new(side * PLOT_X, 0, z)
			-- Eingang (lokales -Z) zeigt zum Nester-Feld in der Mitte
			local cf = CFrame.lookAt(center, center + Vector3.new(-side, 0, 0))
			table.insert(plots, buildPlot(index, cf, PLOT_COLORS[(index - 1) % #PLOT_COLORS + 1], plotsFolder))
		end
	end
	return plots
end

-- -------------------------------------------------------------------
-- STOCKWERKE
-- -------------------------------------------------------------------
local function lookStyle(plot): LookStyle
	return LOOKS[math.clamp(tonumber(plot.Look) or 1, 1, #LOOKS)]
end

-- Ein Stockwerk: Platte mit Noppen, niedriger Rand (vorne mit Lücke für die Treppe), 4 Pfeiler, Treppe
local function buildStory(plot, floor: number, parent: Instance)
	local story = STORIES[floor - 1]
	local cf = plot.CFrame
	local style = lookStyle(plot)
	local model = Instance.new("Model")
	model.Name = "Floor" .. floor
	local floorTop = BaseBuilder.FloorTop(floor)
	local belowTop = BaseBuilder.FloorTop(floor - 1)
	local depth = HALF_Z - story.MinZ
	local midZ = (story.MinZ + HALF_Z) / 2

	local plate = part({
		Name = "Floor",
		Size = Vector3.new(PLOT_WIDTH, FLOOR_THICK, depth),
		CFrame = cf * CFrame.new(0, floorTop - FLOOR_THICK / 2, midZ),
		Material = Enum.Material.Plastic,
		Color = plot.Color:Lerp(WHITE, 0.15),
		Parent = model,
	})
	plate.TopSurface = Enum.SurfaceType.Studs
	plate:SetAttribute("BaseFloor", true)

	local rimY = floorTop + RIM_HEIGHT / 2
	local function rim(size: Vector3, offset: Vector3)
		local p = part({
			Name = "Rim",
			Size = size,
			CFrame = cf * CFrame.new(offset),
			Material = style.FenceMat,
			Color = style.Fence,
			Parent = model,
		})
		p.TopSurface = Enum.SurfaceType.Studs
	end
	rim(Vector3.new(PLOT_WIDTH, RIM_HEIGHT, FENCE_THICK), Vector3.new(0, rimY, HALF_Z - FENCE_THICK / 2))
	for _, s in ipairs({ -1, 1 }) do
		rim(
			Vector3.new(FENCE_THICK, RIM_HEIGHT, depth - FENCE_THICK * 2),
			Vector3.new(s * (HALF_X - FENCE_THICK / 2), rimY, midZ)
		)
	end
	-- vorne: Rand überall außer über der Treppe
	local frontZ = story.MinZ + FENCE_THICK / 2
	local fromX = if story.GapMinX <= -HALF_X then story.GapMaxX else -HALF_X
	local toX = if story.GapMinX <= -HALF_X then HALF_X else story.GapMinX
	rim(Vector3.new(toX - fromX, RIM_HEIGHT, FENCE_THICK), Vector3.new((fromX + toX) / 2, rimY, frontZ))

	-- Pfeiler an den Ecken (stehen auf dem Boden darunter)
	local pillarHeight = floorTop - FLOOR_THICK - belowTop
	for _, s in ipairs({ -1, 1 }) do
		for _, z in ipairs({ story.MinZ + PILLAR / 2 + 0.5, HALF_Z - PILLAR / 2 - 1.5 }) do
			part({
				Name = "Pillar",
				Size = Vector3.new(PILLAR, pillarHeight, PILLAR),
				CFrame = cf * CFrame.new(s * (HALF_X - PILLAR / 2 - 1), belowTop + pillarHeight / 2, z),
				Material = style.FenceMat,
				Color = style.Fence,
				Parent = model,
			})
		end
	end

	-- Treppe: 1 Stud hohe Stufen (Klötze bis zum Boden darunter), oberste Stufe = Bodenhöhe oben
	local steps = math.floor(FLOOR_GAP + 0.5)
	local run = (story.StairToZ - story.StairFromZ) / steps
	local stepColor = plot.Color:Lerp(Color3.new(0, 0, 0), 0.25)
	for i = 1, steps do
		local height = i * (FLOOR_GAP / steps)
		local z = story.StairFromZ + (i - 0.5) * run
		local step = part({
			Name = "Step",
			Size = Vector3.new(STAIR_WIDTH, height, math.abs(run)),
			CFrame = cf * CFrame.new(story.StairX, belowTop + height / 2, z),
			Material = Enum.Material.Plastic,
			Color = if i % 2 == 0 then stepColor else stepColor:Lerp(WHITE, 0.15),
			Parent = model,
		})
		step.TopSurface = Enum.SurfaceType.Studs
	end
	model.Parent = parent
	return model
end

-- Baut genau "count" Stockwerke (1 = nur Erdgeschoss). Fremde/alte Stockwerke werden entfernt.
function BaseBuilder.SetFloors(plot, count: number)
	count = math.clamp(math.floor(tonumber(count) or 1), 1, BaseBuilder.MaxFloors())
	local container = plot.Model:FindFirstChild("Floors")
	if not container then
		container = folder("Floors", plot.Model)
	end
	for floor = 2, #STORIES + 1 do
		local existing = container:FindFirstChild("Floor" .. floor)
		if floor <= count and not existing then
			buildStory(plot, floor, container)
		elseif floor > count and existing then
			existing:Destroy()
		end
	end
	plot.Floors = count
	plot.TopY = topY(count)
	plot.Model:SetAttribute("BaseFloors", count)
end

-- -------------------------------------------------------------------
-- BASE-LOOK (rein optisch)
-- -------------------------------------------------------------------
local function setLookParts(plot, style: LookStyle)
	for _, fencePart in ipairs(plot.Fences) do
		fencePart.Material = style.FenceMat
		fencePart.Color = style.Fence
	end
	local container = plot.Model:FindFirstChild("Floors")
	if container then
		for _, p in ipairs(container:GetDescendants()) do
			if p:IsA("BasePart") and (p.Name == "Rim" or p.Name == "Pillar") then
				p.Material = style.FenceMat
				p.Color = style.Fence
			end
		end
	end
end

function BaseBuilder.SetLook(plot, level: number)
	level = math.clamp(math.floor(tonumber(level) or 1), 1, #LOOKS)
	if plot.Look == level then
		return
	end
	plot.Look = level
	plot.Model:SetAttribute("BaseLook", level)
	local style = LOOKS[level]
	setLookParts(plot, style)

	local old = plot.Model:FindFirstChild("Look")
	if old then
		old:Destroy()
	end
	local look = folder("Look", plot.Model)
	local cf = plot.CFrame
	local top = PLOT_FLOOR_TOP
	local postColor = if level >= 3 then style.Fence else WOOD_COLOR

	-- Laternen: vorne in den Ecken, ab Stufe 2 auch vorne an den Seiten, ab Stufe 4 hinten
	local spots = {
		Vector2.new(35.5, -41),
		Vector2.new(38.2, -25),
		Vector2.new(12, 41.5),
	}
	for i = 1, math.min(#spots, math.ceil(style.Lanterns / 2)) do
		for _, s in ipairs({ -1, 1 }) do
			local lampName = if i == 1 then "LanternLamp" else "LanternGlow"
			lantern(look, cf * CFrame.new(s * spots[i].X, top, spots[i].Y), postColor, style.Lamp, lampName)
		end
	end

	-- Stufe 5: Leuchtkante auf dem Zaun
	if style.Cap then
		for _, fencePart in ipairs(plot.Fences) do
			part({
				Name = "FenceCap",
				Size = Vector3.new(fencePart.Size.X, 0.3, fencePart.Size.Z),
				CFrame = fencePart.CFrame * CFrame.new(0, fencePart.Size.Y / 2 + 0.15, 0),
				Material = Enum.Material.Neon,
				Color = style.Cap,
				CanCollide = false,
				CastShadow = false,
				Parent = look,
			})
		end
	end

	-- Bodenrand (ab Stufe 3): flache Leiste innen am Rand (hinten + Seiten)
	if style.Trim then
		local trimY = top + 0.1
		local inner = FENCE_THICK + 0.75
		for _, data in ipairs({
			{ Vector3.new(PLOT_WIDTH - 2 * FENCE_THICK, 0.2, 1.5), Vector3.new(0, trimY, HALF_Z - inner) },
			{ Vector3.new(1.5, 0.2, PLOT_DEPTH - 2 * FENCE_THICK - 3), Vector3.new(-(HALF_X - inner), trimY, -1.5) },
			{ Vector3.new(1.5, 0.2, PLOT_DEPTH - 2 * FENCE_THICK - 3), Vector3.new(HALF_X - inner, trimY, -1.5) },
		}) do
			local p = part({
				Name = "Trim",
				Size = data[1],
				CFrame = cf * CFrame.new(data[2]),
				Material = Enum.Material.Plastic,
				Color = style.Trim,
				CanQuery = false,
				CastShadow = false,
				Parent = look,
			})
			p.TopSurface = Enum.SurfaceType.Studs
		end
	end

	-- Torbogen über dem Eingang (ab Stufe 2): zwei Säulen außen neben dem Zaun + Balken
	local archColor = style.Arch
	if archColor then
		local archHeight = 11 + level
		for _, s in ipairs({ -1, 1 }) do
			local pillar = part({
				Name = "ArchPillar",
				Size = Vector3.new(2, archHeight, 2),
				CFrame = cf * CFrame.new(s * (HALF_X + 1.5), archHeight / 2, -HALF_Z + 1),
				Material = style.ArchMat,
				Color = archColor,
				Parent = look,
			})
			pillar.TopSurface = Enum.SurfaceType.Studs
		end
		local beam = part({
			Name = "ArchBeam",
			Size = Vector3.new(PLOT_WIDTH + 7, 2, 2.4),
			CFrame = cf * CFrame.new(0, archHeight + 1, -HALF_Z + 1),
			Material = style.ArchMat,
			Color = archColor,
			Parent = look,
		})
		beam.TopSurface = Enum.SurfaceType.Studs
		if level >= 4 then
			part({
				Name = "ArchGlow",
				Size = Vector3.new(PLOT_WIDTH + 7.2, 0.4, 2.6),
				CFrame = beam.CFrame * CFrame.new(0, -0.6, 0),
				Material = Enum.Material.Neon,
				Color = style.Lamp,
				CanCollide = false,
				CastShadow = false,
				Parent = look,
			})
		end
		-- Stufe 5: zwei Fahnen oben auf dem Torbogen
		if style.Flags >= 6 then
			for _, s in ipairs({ -1, 1 }) do
				flag(look, beam.CFrame * CFrame.new(s * (HALF_X - 6), 1, 0), FLAG_COLORS[(plot.Index + s) % 5 + 1], 7)
			end
		end
	end

	-- Fahnen: hinten auf dem Zaun (ab Stufe 3), auf den Laser-Pfosten (ab Stufe 4)
	if style.Flags >= 2 then
		for _, s in ipairs({ -1, 1 }) do
			local base = cf * CFrame.new(s * 20, top + FENCE_HEIGHT, HALF_Z - FENCE_THICK / 2)
			flag(look, base, FLAG_COLORS[(plot.Index + s + 2) % 5 + 1], 10)
		end
	end
	if style.Flags >= 4 then
		for _, s in ipairs({ -1, 1 }) do
			local base = cf * CFrame.new(s * POST_X, top + BARRIER_HEIGHT, GATE_Z)
			flag(look, base, FLAG_COLORS[(plot.Index + s + 4) % 5 + 1], 4)
		end
	end
end

-- -------------------------------------------------------------------
-- GELD-FELDER (eins vor jedem besetzten Slot)
-- -------------------------------------------------------------------
-- Kleines grünes Feld 5 Studs vor dem Slot (Richtung Eingang) mit Betrag-Schild. Gibt (Feld, Label) zurück.
function BaseBuilder.MakeCashPad(plot, slot: number): (BasePart?, TextLabel?)
	local anchor = plot.Slots[slot]
	if not anchor then
		return nil, nil
	end
	local floorCf = anchor.CFrame * CFrame.new(0, -anchor.Size.Y / 2, 0)
	local pad = part({
		Name = "CashPad" .. slot,
		Size = Vector3.new(4, 0.2, 2.2),
		CFrame = floorCf * CFrame.new(0, 0.1, -5.6),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(70, 210, 90),
		CanCollide = false,
		CanQuery = false,
		CanTouch = true,
		CastShadow = false,
	})
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(4.5, 1.3)
	gui.StudsOffset = Vector3.new(0, 1, 0)
	gui.MaxDistance = 45
	gui.LightInfluence = 0
	gui.Parent = pad
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(140, 255, 120)
	label.Text = ""
	addStroke(label, 2)
	label.Parent = gui
	local container = plot.Model:FindFirstChild("CashPads")
	if not container then
		container = folder("CashPads", plot.Model)
	end
	pad.Parent = container
	return pad, label
end

return BaseBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CarryService</string>
            <string name="Source"><![CDATA[-- Klauen & Tragen:
--  * Fremde Meteore UND Aliens kann man klauen (E halten), wenn die Base nicht gesperrt ist,
--    und muss sie dann in die eigene Base tragen (Source = "Plot").
--    Wer mit dem Schläger getroffen wird, stirbt, in eine Falle tritt, zu langsam ist oder das Spiel verlässt,
--    verliert die Beute: sie fliegt zurück zum Besitzer.
--  * Eier aus den NESTERN (E = Schnappen) und Eier am Boden (fallen gelassen / Egg Rush) sind gratis,
--    müssen aber auch nach Hause getragen werden (Source = "Ground"). Klappt das nicht,
--    fällt das Ei an Ort und Stelle auf den Boden – und JEDER kann es schnappen.
--  * Gekaufte Meteore (F) muss man NICHT tragen – sie fliegen automatisch in die Base.
--  * Schläger zum Verteidigen (Stufe nach Index, Config.Bats; Gadget "Super-Schlag" = Boost).
--  * Wilde Kreaturen im Nester-Feld (FieldService) schubsen wie ein Schläger-Treffer: CarryService.CreatureHit.
--  * Seltene Beute ist schwer (Config.HeavyCarry, Tempo rechnet EconomyService), wer klaut, verliert
--    den Umhang (sonst könnte man Diebe nie treffen), Eingefrorene können nicht klauen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))
local AlienFactory = require(script.Parent:WaitForChild("AlienFactory"))

local CarryService = {}
local Services

local carrying: { [Player]: any } = {}
local stealing: { [any]: { [number]: Player } } = {} -- [plot][slot] = Dieb
local lastBonk: { [Player]: number } = {}
-- Klau-Versuche aus Basen pro Spieler höchstens so oft pro Sekunde (gegen Massen-Auslösen per Cheat)
local stealLimiter = Util.RateLimiter(6, 1)

local CARRY_HEIGHT = 2.6 -- Abstand über dem HumanoidRootPart (Unterkante der Beute)
-- Mindest-Tragezeit: kürzester möglicher Weg (raus aus der fremden Base, rein in die eigene)
-- geteilt durch Trage-Tempo * diesen Faktor. Schneller geht es nur mit Teleport/Durch-Wände-Laufen.
local MIN_CARRY_SPEED_FACTOR = 1.5
-- Laufbänder (Treadmills) schieben mit (wer mit Beute auf dem Band mitfährt, ist schneller)
local CONVEYOR_EXTRA_SPEED = 14
-- Schläger in Ruhe: Griff in der Hand, Schläger zeigt nach oben und lehnt etwas nach hinten
-- (der Client schwingt ihn beim Schlagen über Tool.Grip, siehe Client-Modul "Bat")
local BAT_REST_GRIP = CFrame.new(0, -0.4, 0) * CFrame.Angles(math.rad(-15), 0, 0)
-- Lange Heimwege (info.ScaleTimeout, z.B. das Ei vom Meteor-Run): Trage-Zeit = Weg / Trage-Tempo * TRIP_SLACK
-- + TRIP_EXTRA, mindestens Config.CarryTimeout. Der Weg wird großzügig gerechnet (|dx| + |dz| bis zum
-- Eingang der eigenen Base – Umwege um Basen und Nester sind darin enthalten).
local TRIP_SLACK = 1.3
local TRIP_EXTRA = 10
local TRIP_MAX = 240

-- Fortschritt für die Tagesaufgaben (RewardService) – ein Fehler dort darf das Klauen nie stören
local function trackReward(player: Player, kind: string, amount: number)
	local rewards = Services.RewardService
	if rewards and rewards.Track then
		local ok, err = pcall(rewards.Track, player, kind, amount)
		if not ok then
			warn("[CarryService] RewardService.Track(" .. kind .. ") fehlgeschlagen: " .. tostring(err))
		end
	end
end

local function ownsGadget(player: Player, id: string): boolean
	local gadgets = Services.GadgetService
	return gadgets ~= nil and gadgets.Owns(player, id) == true
end

-- Höchstes mögliches Trage-Tempo (für die Mindest-Tragezeit): Schritte-Tempo * Trage-Faktor
-- (Gamepass "Volle Speed beim Tragen" = kein Abzug), Speed Coil + Speed-Pad obendrauf
-- (ein Pad kann man unterwegs jederzeit mitnehmen), plus Laufband-Schub
local function maxCarrySpeed(player: Player): number
	local factor = Services.MonetizationService.HasPass(player, "CarryFast") and 1 or Config.CarrySpeedFactor
	local speed = math.max(8, Services.EconomyService.GetSpeed(player) * factor)
	if ownsGadget(player, "SpeedCoil") then
		speed *= 1 + Config.SpeedCoilBonus
	end
	speed *= 1 + (tonumber(Config.SpeedPads and Config.SpeedPads.Boost) or 0)
	return speed + CONVEYOR_EXTRA_SPEED
end

function CarryService.IsCarrying(player: Player): boolean
	return carrying[player] ~= nil
end

-- Was trägt der Spieler gerade? (Eintrag { Id, Mut, ... } oder nil) – z.B. für "schwere Beute"
function CarryService.CarriedEntry(player: Player): any
	local info = carrying[player]
	return info and info.Entry
end

-- -------------------------------------------------------------------
-- BEWEGUNGS-PRÜFUNG (gegen Teleport- und Speed-Exploits)
-- -------------------------------------------------------------------
-- Die Position des Charakters bestimmt der Client. Deshalb hat jeder Spieler ein "Weg-Budget":
-- Es füllt sich mit dem erlaubten Tempo wieder auf, jede Bewegung verbraucht es (nur waagrecht,
-- Fallen zählt nicht). Ist es leer, war der Spieler unmöglich schnell -> kurz keine Käufe/Diebstähle,
-- getragene Beute fliegt zurück. Der Vorrat reicht für kurze Ping-Hänger (Position kommt gesammelt an).
local MOVE_RATE_FACTOR = 1.5 -- erlaubtes Tempo = WalkSpeed * 1.5 + MOVE_RATE_EXTRA
local MOVE_RATE_EXTRA = 16 -- Laufbänder schieben, Bonk-Rückstoß, kleine Physik-Sprünge
local MOVE_BUDGET_SECONDS = 0.75 -- Vorrat = so viele Sekunden erlaubtes Tempo
local MOVE_FLAG_TIME = 1.5 -- nach einem Verstoß so lange gesperrt
-- Nach einem Server-Teleport kurz warten: alte Positionen (vor dem Teleport) können noch ankommen.
-- In der Zeit zählen nur Positionen nahe am Teleport-Ziel, Kaufen/Klauen geht erst danach.
local TELEPORT_GRACE = 1
local TELEPORT_ANCHOR_RADIUS = 30

type MoveTrack = {
	Pos: Vector3?, -- letzte anerkannte Position
	Time: number,
	Budget: number,
	FlaggedUntil: number,
	GraceUntil: number,
	Anchor: Vector3?, -- Ziel des letzten Server-Teleports
	Extra: number?, -- Zusatz-Weg nach einem Schläger-Treffer (Rückstoß ist kein Cheat)
	ExtraUntil: number?,
}
local moveTrack: { [Player]: MoveTrack } = {}

-- Server-Teleports (Home, Laufbänder, Lock-Rauswurf, Admin, Respawn) sind erlaubt.
-- destination = Ziel des Teleports (nil = unbekannt, z.B. neuer Charakter)
function CarryService.NoteTeleport(player: Player, destination: Vector3?)
	local now = os.clock()
	local old = moveTrack[player]
	moveTrack[player] = {
		Pos = destination,
		Time = now,
		Budget = 0,
		FlaggedUntil = old and old.FlaggedUntil or 0,
		GraceUntil = now + TELEPORT_GRACE,
		Anchor = destination,
	}
	local info = carrying[player]
	if info then
		info.MinTime = 0 -- vom Server versetzt -> Mindest-Tragezeit gilt nicht mehr
	end
end

-- Rückstoß vom Schläger: der Getroffene darf kurz weiter "fliegen", ohne als Teleport zu gelten
local function allowKnockback(player: Player, studs: number)
	local track = moveTrack[player]
	if not track then
		return
	end
	local now = os.clock()
	track.Extra = studs
	track.ExtraUntil = now + 1.5
	track.Budget += studs
end

-- Misst die Bewegung seit der letzten Messung:
--   "ok"      = alles plausibel (darf kaufen/klauen)
--   "wait"    = gerade vom Server teleportiert (kurz warten, Beute bleibt)
--   "flagged" = unmöglich schnell oder noch gesperrt (Beute fliegt zurück)
function CarryService.MoveStatus(player: Player): string
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return "ok"
	end
	local admin = Services.AdminService
	if admin and admin.IsAdmin(player) then
		return "ok" -- Admins dürfen fliegen und teleportieren
	end
	local now = os.clock()
	local rate = humanoid.WalkSpeed * MOVE_RATE_FACTOR + MOVE_RATE_EXTRA
	local cap = rate * MOVE_BUDGET_SECONDS
	local pos = root.Position
	local track = moveTrack[player]
	if not track then
		track = { Pos = nil, Time = now, Budget = cap, FlaggedUntil = 0, GraceUntil = 0, Anchor = nil }
		moveTrack[player] = track
	end
	if now < track.GraceUntil then
		local anchor = track.Anchor
		local dx, dz = 0, 0
		if anchor then
			dx, dz = pos.X - anchor.X, pos.Z - anchor.Z
		end
		if dx * dx + dz * dz <= TELEPORT_ANCHOR_RADIUS * TELEPORT_ANCHOR_RADIUS then
			track.Pos = pos
		end
		track.Time = now
		track.Budget = cap
		return "wait"
	end
	local last = track.Pos
	if not last then
		-- erste Messung: nur merken (Kaufen/Klauen erst ab der nächsten Messung)
		track.Pos = pos
		track.Time = now
		track.Budget = cap
		return if now >= track.FlaggedUntil then "wait" else "flagged"
	end
	local dx, dz = pos.X - last.X, pos.Z - last.Z
	local distance = math.sqrt(dx * dx + dz * dz)
	local extra = if now < (track.ExtraUntil or 0) then track.Extra or 0 else 0
	local budget = math.min(cap + extra, track.Budget + rate * math.max(0, now - track.Time)) - distance
	track.Pos = pos
	track.Time = now
	if budget < 0 then
		track.Budget = cap
		track.FlaggedUntil = now + MOVE_FLAG_TIME
		return "flagged"
	end
	track.Budget = budget
	return if now >= track.FlaggedUntil then "ok" else "flagged"
end

-- Kürzester möglicher Weg (Studs) von "from" in der fremden Base bis in die eigene Base.
-- Die Basen sind OFFEN (nur ein niedriger Rand, über den man springen kann): man kann sie an JEDER
-- Kante verlassen und betreten. Gerechnet wird deshalb großzügig (Luftlinie bis zur nächsten Kante,
-- Abstand der beiden Rechtecke) -> echte Spieler sind immer langsamer.
-- Waagrechter Abstand eines Punkts zum Rechteck der Base (0 = drin)
local function distanceToPlot(plot, p: Vector3): number
	local minX, maxX, minZ, maxZ = Services.PlotService.WorldRect(plot)
	local dx = math.max(minX - p.X, 0, p.X - maxX)
	local dz = math.max(minZ - p.Z, 0, p.Z - maxZ)
	return math.sqrt(dx * dx + dz * dz)
end

-- Von innen: Weg bis zur nächsten Kante der Base
local function distanceToEdge(plot, p: Vector3): number
	local hx, hz = Services.PlotService.HalfExtents(plot)
	local localPos = plot.CFrame:PointToObjectSpace(p)
	return math.max(0, math.min(hx - math.abs(localPos.X), hz - math.abs(localPos.Z)))
end

-- Lücke zwischen zwei Basen-Rechtecken (0 = berühren sich)
local function plotGap(a, b): number
	local aMinX, aMaxX, aMinZ, aMaxZ = Services.PlotService.WorldRect(a)
	local bMinX, bMaxX, bMinZ, bMaxZ = Services.PlotService.WorldRect(b)
	local dx = math.max(bMinX - aMaxX, 0, aMinX - bMaxX)
	local dz = math.max(bMinZ - aMaxZ, 0, aMinZ - bMaxZ)
	return math.sqrt(dx * dx + dz * dz)
end

local function minCarryDistance(victimPlot, ownPlot, from: Vector3): number
	if victimPlot == ownPlot then
		return 0
	end
	return distanceToEdge(victimPlot, from) + plotGap(victimPlot, ownPlot)
end

-- Trage-Tempo OHNE Speed Coil (die kann man unterwegs weglegen) – gleiche Regeln wie EconomyService
local function slowCarrySpeed(player: Player, entry): number
	local factor = 1
	if not Services.MonetizationService.HasPass(player, "CarryFast") then
		factor = Config.CarrySpeedFactor
		local heavy = Config.HeavyFactor(entry)
		if heavy then
			factor = math.min(factor, heavy)
		end
	end
	return math.max(8, Services.EconomyService.GetSpeed(player) * factor)
end

-- Trage-Zeit für einen langen Heimweg (info.ScaleTimeout): proportional zur Entfernung zur eigenen Base
local function tripTimeout(player: Player, entry, from: Vector3?): number
	local plot = Services.PlotService.GetPlot(player)
	if not plot or not from then
		return Config.CarryTimeout
	end
	local _, halfZ = Services.PlotService.HalfExtents(plot)
	local entrance = plot.CFrame:PointToWorldSpace(Vector3.new(0, 0, -halfZ))
	local route = math.abs(from.X - entrance.X) + math.abs(from.Z - entrance.Z)
	local seconds = route / slowCarrySpeed(player, entry) * TRIP_SLACK + TRIP_EXTRA
	return math.clamp(math.ceil(seconds), Config.CarryTimeout, TRIP_MAX)
end

-- Mindest-Tragezeit für ein Ei aus einem Nest/vom Boden: Luftlinie bis zum Eingang der eigenen Base
local function minGroundCarryTime(player: Player, from: Vector3?): number
	local plot = Services.PlotService.GetPlot(player)
	if not plot or not from or Services.PlotService.IsInside(plot, from) then
		return 0
	end
	return distanceToPlot(plot, from) / (maxCarrySpeed(player) * MIN_CARRY_SPEED_FACTOR)
end

function CarryService.IsSlotBeingStolen(plot, slot: number): boolean
	local map = stealing[plot]
	return map ~= nil and map[slot] ~= nil
end

local function clearStealMark(info)
	if info.Source == "Plot" and stealing[info.VictimPlot] then
		stealing[info.VictimPlot][info.Slot] = nil
	end
end

local function cleanup(player: Player, info)
	carrying[player] = nil
	player:SetAttribute("CarryTimeout", nil)
	if info.Visual then
		info.Visual:Destroy()
		info.Visual = nil
	end
	Services.EconomyService.ApplySpeed(player)
	Services.EconomyService.MarkDirty(player)
end

-- Getragene Beute: alle Teile lose, gewichtslos, ohne Kollision, an den Spieler geschweißt
local function prepareCarryPart(p: BasePart)
	p.Anchored = false
	p.Massless = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
end

local function weldTo(part0: BasePart, part1: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = part0
	w.Part1 = part1
	w.Parent = part1
end

-- Alien-Kopie über dem Kopf (Model: alle Teile an den Body, Body an den HumanoidRootPart)
local function createAlienVisual(entry, root: BasePart): Instance?
	local ok, result = pcall(AlienFactory.Create, entry, "Carry")
	if not ok or typeof(result) ~= "Instance" or not result:IsA("Model") then
		warn("[CarryService] Alien-Optik fehlgeschlagen: " .. tostring(result))
		return nil
	end
	local model = result :: Model
	local body = model.PrimaryPart or model:FindFirstChild("Body")
	if not body or not body:IsA("BasePart") then
		model:Destroy()
		return nil
	end
	model.Name = "CarriedAlien"
	model:SetAttribute("Bob", false) -- nicht wippen (würde den Spieler mitbewegen)
	model:PivotTo(root.CFrame * CFrame.new(0, CARRY_HEIGHT, 0))
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			prepareCarryPart(d)
			if d ~= body then
				weldTo(body, d)
			end
		end
	end
	weldTo(root, body)
	return model
end

local function createVisual(player: Player, entry): Instance?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not root then
		return nil
	end
	local visual: Instance? = nil
	if entry.Alien ~= nil then
		visual = createAlienVisual(entry, root)
	end
	if not visual then
		local meteor = MeteorFactory.Create(entry, "Carry")
		meteor.Name = "CarriedMeteor"
		prepareCarryPart(meteor)
		meteor.CFrame = root.CFrame * CFrame.new(0, CARRY_HEIGHT + meteor.Size.Y / 2, 0)
		weldTo(root, meteor)
		visual = meteor
	end
	if visual then
		visual.Parent = character
	end
	return visual
end

-- info (Plot):   { Source = "Plot", VictimPlot, VictimPlayer, Slot, EntryRef, MinTime? }
-- info (Ground): { Source = "Ground", From = "Nest"|"Drop"|"Race"|"Run"?, GrabPosition?, MinTime?, ScaleTimeout? }
--   ScaleTimeout = true: Trage-Zeit wächst mit der Entfernung zur eigenen Base (tripTimeout)
-- Dazu kommen hier: Entry, Started, Character, StartPos, LastPos (laufend), Visual, Timeout
function CarryService.StartCarry(player: Player, entry, info)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	info.Entry = entry
	info.Started = os.clock()
	info.Character = character
	info.StartPos = root and root.Position or info.GrabPosition
	info.LastPos = info.StartPos
	if info.MinTime == nil then
		info.MinTime = info.Source == "Ground" and minGroundCarryTime(player, info.StartPos) or 0
	end
	info.Timeout = if info.ScaleTimeout
		then tripTimeout(player, entry, info.StartPos)
		else tonumber(info.Timeout) or Config.CarryTimeout
	-- Client (HUD-Countdown) kennt so die echte Trage-Zeit
	player:SetAttribute("CarryTimeout", info.Timeout)
	-- Wer klaut, wird sichtbar: sonst wäre jeder Diebstahl mit Umhang unbonkbar
	local gadgets = Services.GadgetService
	local uncloaked = false
	if gadgets and gadgets.IsCloaked(player) then
		gadgets.EndCloak(player, true)
		uncloaked = true
	end
	info.Visual = createVisual(player, entry)
	carrying[player] = info
	Services.EconomyService.ApplySpeed(player)
	Services.EconomyService.MarkDirty(player)
	local extra = ""
	if Config.HeavyFactor(entry) and not Services.MonetizationService.HasPass(player, "CarryFast") then
		extra ..= " 🐢 Schwer – du bist langsamer!"
	end
	if uncloaked then
		extra ..= " 👻 Du bist wieder sichtbar!"
	end
	if info.Source == "Ground" then
		Services.EconomyService.Notify(
			player,
			"😈 Geschnappt: " .. Config.EntryName(entry) .. "! Schnell in deine Base 🏃" .. extra,
			"Info"
		)
	else
		Services.EconomyService.Notify(
			player,
			"🏃 Bring " .. Config.EntryName(entry) .. " in deine Base!" .. extra,
			"Info"
		)
	end
end

-- Weltposition der getragenen Beute (für den Fall-Effekt beim Fallenlassen)
local function visualPosition(info): Vector3?
	local visual = info.Visual
	if not visual or not visual.Parent then
		return nil
	end
	if visual:IsA("BasePart") then
		return visual.Position
	elseif visual:IsA("Model") then
		return visual:GetPivot().Position
	end
	return nil
end

-- Ei aus einem Nest/vom Boden sicher zu Hause -> in einen freien Slot, Schlüpf-Countdown startet
-- (das Gold-Ei des Rennens meldet hier den Sieg: MeteorService.FinishRace)
local function succeedGround(player: Player, info)
	local data = Services.DataService.Get(player)
	local plot = Services.PlotService.GetPlot(player)
	local slot = Services.PlotService.FreeSlot(player)
	if not data or not plot or not slot then
		CarryService.Fail(player, "full")
		return
	end
	local from = visualPosition(info)
	cleanup(player, info)
	local placed = Services.EconomyService.DeliverMeteor(player, plot, slot, info.Entry, from)
	if not placed then
		-- (sollte nie passieren) Ei nicht verlieren: an Ort und Stelle fallen lassen
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local spot = root and root.Position or info.LastPos
		if spot then
			Services.MeteorService.DropMeteor(info.Entry, spot, from)
		end
		return
	end
	data.Stats.Grabbed = (tonumber(data.Stats.Grabbed) or 0) + 1
	trackReward(player, "Grab", 1)
	Services.EconomyService.Notify(
		player,
		"🏠 Zuhause! " .. Config.EntryName(info.Entry) .. " schlüpft bald 🐣",
		"Success"
	)
	Services.EconomyService.Effect(player, "Confetti", 1)
	if info.Entry.Race ~= nil and Services.MeteorService.FinishRace then
		local ok, err = pcall(Services.MeteorService.FinishRace, player, info.Entry)
		if not ok then
			warn("[CarryService] FinishRace fehlgeschlagen: " .. tostring(err))
		end
	end
end

local function succeed(player: Player)
	local info = carrying[player]
	if not info then
		return
	end
	if info.Source == "Ground" then
		succeedGround(player, info)
		return
	end
	local data = Services.DataService.Get(player)
	local plot = Services.PlotService.GetPlot(player)
	local slot = Services.PlotService.FreeSlot(player)
	local name = Config.EntryName(info.Entry)

	local victim = info.VictimPlayer
	local victimData = victim and victim.Parent and Services.DataService.Get(victim)
	local key = tostring(info.Slot)
	if not data or not plot or not slot or not victimData or victimData.Meteors[key] ~= info.EntryRef then
		CarryService.Fail(player, slot and "invalid" or "full")
		return
	end
	victimData.Meteors[key] = nil
	data.Meteors[tostring(slot)] = info.EntryRef
	data.Stats.Stolen += 1
	victimData.Stats.Robbed += 1
	clearStealMark(info)
	cleanup(player, info)
	if info.EntryRef.Alien ~= nil then
		Services.EconomyService.Discover(player, info.EntryRef.Alien)
	end
	Services.PlotService.RenderSlot(plot, slot)
	Services.PlotService.RenderSlot(info.VictimPlot, info.Slot)
	Services.EconomyService.MarkDirty(victim)
	trackReward(player, "Steal", 1)
	Services.EconomyService.Notify(player, "😈 Geklaut: " .. name .. "!", "Success")
	Services.EconomyService.Notify(
		victim,
		"💔 " .. player.DisplayName .. " hat dein " .. name .. " geklaut!",
		"Error"
	)
	Services.EconomyService.Effect(player, "Confetti", 1)
end

-- Hinweise beim Verlieren: Beute aus einer Base fliegt zurück, ein Ei aus einem Nest fällt herunter
local PLOT_FAIL_TEXT = {
	bonked = "💥 Getroffen! Die Beute fliegt zurück.",
	timeout = "⏰ Zu langsam! Die Beute fliegt zurück.",
	full = "📦 Deine Base ist voll – die Beute fliegt zurück!",
	teleport = "🚫 Mit Beute kann man nicht teleportieren!",
	locked = "🔒 Die Base wurde gesperrt – deine Beute fliegt zurück!",
	trap = "🪤 FALLE! Die Beute fliegt zurück.",
	creature = "👾 Erwischt! Die Beute fliegt zurück.",
}
local GROUND_FAIL_TEXT = {
	bonked = "💥 Getroffen! Das Ei ist runtergefallen – schnapp es dir zurück!",
	timeout = "⏰ Zu langsam! Das Ei ist runtergefallen.",
	full = "📦 Deine Base ist voll – das Ei liegt jetzt am Boden!",
	teleport = "🚫 Mit Beute kann man nicht teleportieren!",
	locked = "🔒 Gesperrte Base – das Ei ist runtergefallen!",
	trap = "🪤 FALLE! Das Ei ist runtergefallen.",
	died = "💀 Das Ei ist runtergefallen – jemand anderes kann es jetzt schnappen!",
	creature = "👾 Erwischt! Das Ei ist runtergefallen.",
}

-- Ei aus einem Nest/vom Boden verloren -> fällt als GRATIS-Ei auf den Boden (jeder darf es schnappen)
local function dropGroundLoot(player: Player, info, reason: string, from: Vector3?)
	local spot: Vector3? = nil
	if reason == "teleport" or reason == "invalid" then
		-- Verdacht auf Teleport-Trick: dort ablegen, wo das Tragen angefangen hat
		spot = info.StartPos
	else
		-- nur der Charakter, der das Ei getragen hat (nach einem Respawn steht der neue woanders)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if character == info.Character and root and humanoid and humanoid.Health > 0 then
			spot = root.Position
		else
			spot = info.LastPos or info.StartPos
		end
	end
	if not spot then
		return
	end
	local ok, err = pcall(Services.MeteorService.DropMeteor, info.Entry, spot, from)
	if not ok then
		warn("[CarryService] Ei fallen lassen fehlgeschlagen: " .. tostring(err))
	end
end

function CarryService.Fail(player: Player, reason: string)
	local info = carrying[player]
	if not info then
		return
	end
	local from = visualPosition(info)
	clearStealMark(info)
	cleanup(player, info)
	local name = Config.EntryName(info.Entry)

	if info.Source == "Ground" then
		dropGroundLoot(player, info, reason, from)
		local text = GROUND_FAIL_TEXT[reason]
		if text then
			Services.EconomyService.Notify(player, text, "Error")
		end
		return
	end

	-- zurück zum Besitzer
	if info.VictimPlot and info.VictimPlot.Owner == info.VictimPlayer then
		Services.PlotService.RenderSlot(info.VictimPlot, info.Slot)
		Services.EconomyService.MarkDirty(info.VictimPlayer)
		if reason ~= "victimLeft" then
			Services.EconomyService.Notify(info.VictimPlayer, "🛡️ Dein " .. name .. " ist zurück!", "Success")
		end
	end
	local text = PLOT_FAIL_TEXT[reason]
	if text then
		Services.EconomyService.Notify(player, text, "Error")
	end
end

function CarryService.TrySteal(thief: Player, plot, slot: number)
	local owner = plot.Owner
	if not owner or owner == thief then
		return
	end
	if not stealLimiter.Check(thief) then
		return -- zu viele Versuche auf einmal (Cheat) -> still ignorieren
	end
	local thiefData = Services.DataService.Get(thief)
	local ownerData = Services.DataService.Get(owner)
	local Economy = Services.EconomyService
	if not thiefData or not ownerData or not Economy.IsReady(thief) or not Economy.IsReady(owner) then
		return
	end
	if Services.PlotService.IsLocked(plot) then
		Services.EconomyService.Notify(thief, "🔒 Diese Base ist gesperrt!", "Error")
		return
	end
	if owner:GetAttribute("AdminGod") == true then
		Services.EconomyService.Notify(thief, "Diese Base ist geschützt.", "Error")
		return
	end
	if CarryService.IsSlotBeingStolen(plot, slot) or carrying[thief] then
		return
	end
	local entry = ownerData.Meteors[tostring(slot)]
	if not entry then
		return
	end
	local thiefPlot = Services.PlotService.GetPlot(thief)
	if not thiefPlot then
		Services.EconomyService.Notify(thief, "Du hast keine Base auf diesem Server.", "Error")
		return
	end
	if not Services.PlotService.FreeSlot(thief) then
		Services.EconomyService.Notify(thief, "📦 Deine Base ist voll! Verkaufe erst etwas.", "Error")
		return
	end
	local character = thief.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local object = plot.MeteorParts[slot]
	local objectPos = Services.PlotService.ObjectPosition(object)
	if not root or not humanoid or humanoid.Health <= 0 or not objectPos then
		return
	end
	if root.Anchored then
		-- eingefroren (Falle / Admin): erst auftauen, dann klauen
		Services.EconomyService.Notify(thief, "🧊 Du bist eingefroren!", "Error")
		return
	end
	if (root.Position - objectPos).Magnitude > Services.PlotService.ObjectRadius(object) + 16 then
		return -- zu weit weg
	end
	if not Services.PlotService.IsInside(plot, root.Position) then
		return -- klauen nur, wer IN der fremden Base steht (nicht durch die Wand aus der Nachbar-Base)
	end
	if CarryService.MoveStatus(thief) ~= "ok" then
		Services.EconomyService.Notify(thief, "⏳ Kurz warten und nochmal versuchen!", "Error")
		return
	end
	local minTime = minCarryDistance(plot, thiefPlot, root.Position) / (maxCarrySpeed(thief) * MIN_CARRY_SPEED_FACTOR)

	stealing[plot] = stealing[plot] or {}
	stealing[plot][slot] = thief
	Services.PlotService.RenderSlot(plot, slot) -- macht das Objekt in der Base unsichtbar
	CarryService.StartCarry(thief, entry, {
		Source = "Plot",
		VictimPlot = plot,
		VictimPlayer = owner,
		Slot = slot,
		EntryRef = entry,
		MinTime = minTime,
	})
	Services.EconomyService.MarkDirty(owner)
	Services.EconomyService.Notify(
		owner,
		"🚨 " .. thief.DisplayName .. " klaut dein " .. Config.EntryName(entry) .. "! HAU IHN! 🔨",
		"Alarm"
	)
	Services.EconomyService.Effect(owner, "Alarm", 1)
end

-- Alle laufenden Diebstähle aus einer Base abbrechen (Rebirth, Reset, Verlassen)
function CarryService.CancelStealsFromPlot(plot, reason: string?)
	for thief, info in pairs(carrying) do
		if info.Source == "Plot" and info.VictimPlot == plot then
			CarryService.Fail(thief, reason or "cancelled")
		end
	end
end

-- -------------------------------------------------------------------
-- SCHLÄGER (wie in Steal-Spielen): jeder hat automatisch den besten Schläger, den sein Index freischaltet
-- (Config.Bats). Super-Bonk-Gadget = Boost (mehr Reichweite + Wucht, schneller), kein eigenes Werkzeug.
-- Der Klick kommt vom Client – Reichweite, Abklingzeit, Blickrichtung, Umhang und Gott-Modus prüft der Server.
-- -------------------------------------------------------------------
local BAT_ATTRIBUTE = "Bat" -- Werkzeug-Attribut: Id des Schlägers (Config.Bats)
local HIT_SOUND = "rbxasset://sounds/action_jump_land.mp3" -- hoch abgespielt = dumpfes "Bonk"
local KNOCKBACK_TIME = 0.22 -- so lange schiebt der Rückstoß
local STUN_IMMUNE_EXTRA = 0.4 -- nach dem Taumeln kurz kein neuer Rückstoß (kein Dauer-Wegschlagen)
local FACING_DOT = 0.1 -- Ziel muss grob vor dem Schläger stehen

local batTemplates: { [string]: Tool } = {}
local batTier: { [Player]: string } = {} -- zuletzt gegebener Schläger (für die Freischalt-Meldung)
local stunnedUntil: { [Player]: number } = {}

local function batIndex(id: string?): number
	for i, bat in ipairs(Config.Bats) do
		if bat.Id == id then
			return i
		end
	end
	return 0
end

-- Bester erlaubter Schläger und ob der Spielstand schon geladen ist
local function allowedBat(player: Player): (any, boolean)
	local data = Services.DataService.Get(player)
	if not data then
		return Config.Bats[1], false
	end
	local bat = Config.BestBat(Services.EconomyService.IndexCount(data))
	return bat, true
end

-- Reichweite, Wucht, Abklingzeit – mit Super-Bonk-Boost
local function batStats(player: Player, bat): (number, number, number)
	local range, force, cooldown = bat.Range, bat.Force, bat.Cooldown
	if ownsGadget(player, "SuperBonk") then
		range *= Config.SuperBonkRangeMult
		force *= Config.SuperBonkForceMult
		cooldown *= Config.SuperBonkCooldownMult
	end
	return range, force, cooldown
end

local function playHitSound(root: BasePart)
	local sound = Instance.new("Sound")
	sound.Name = "BonkHit"
	sound.SoundId = HIT_SOUND
	sound.Volume = 1
	sound.PlaybackSpeed = 1.5
	sound.RollOffMaxDistance = 120
	sound.Parent = root
	sound:Play()
	Debris:AddItem(sound, 2)
end

-- Ziel fliegt weg (läuft beim Getroffenen, weil er seine Physik besitzt) und taumelt kurz (Client).
-- Getötet wird niemand: nur Schub + kurzes Umfallen (PlatformStand beim Client).
local function knockback(target: Player, targetRoot: BasePart, direction: Vector3, force: number, super: boolean)
	local now = os.clock()
	if now < (stunnedUntil[target] or 0) or targetRoot.Anchored then
		return -- taumelt noch / eingefroren -> kein neuer Rückstoß
	end
	stunnedUntil[target] = now + Config.BonkStunTime + STUN_IMMUNE_EXTRA
	allowKnockback(target, force * 0.8 + 20) -- (fliegt nach dem Schub noch etwas weiter)
	local attachment = Instance.new("Attachment")
	attachment.Name = "BonkAttachment"
	attachment.Parent = targetRoot
	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "BonkVelocity"
	velocity.Attachment0 = attachment
	velocity.MaxForce = 1e6
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VectorVelocity = direction * force + Vector3.new(0, Config.BonkLift + (super and 10 or 0), 0)
	velocity.Parent = targetRoot
	Debris:AddItem(velocity, KNOCKBACK_TIME)
	Debris:AddItem(attachment, KNOCKBACK_TIME)
	Services.EconomyService.Effect(target, "Bonked", 1, { Dir = direction, Time = Config.BonkStunTime })
end

-- Wilde Kreatur im Nester-Feld trifft (FieldService): Schubs wie ein Bonk (niemand stirbt),
-- getragene Beute geht verloren. true = getroffen (false: taumelt noch, eingefroren, Gott-Modus ...)
function CarryService.CreatureHit(player: Player, direction: Vector3, force: number): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 or root.Anchored then
		return false
	end
	if player:GetAttribute("AdminGod") == true or os.clock() < (stunnedUntil[player] or 0) then
		return false
	end
	local flat = Vector3.new(direction.X, 0, direction.Z)
	flat = if flat.Magnitude > 0.01 then flat.Unit else root.CFrame.LookVector * -1
	playHitSound(root)
	knockback(player, root, flat, force, false)
	Services.EconomyService.Effect(player, "Shake", 0.6)
	if carrying[player] then
		CarryService.Fail(player, "creature")
	end
	return true
end

local function swing(player: Player, tool: Tool)
	local bat = Config.BatsById[tool:GetAttribute(BAT_ATTRIBUTE)]
	if not bat then
		return
	end
	-- nie besser als erlaubt (z.B. nach einem Reset mit altem Werkzeug in der Hand)
	local allowed = allowedBat(player)
	if batIndex(bat.Id) > batIndex(allowed.Id) then
		bat = allowed
	end
	local range, force, cooldown = batStats(player, bat)
	local t = os.clock()
	if t - (lastBonk[player] or 0) < cooldown then
		return
	end
	lastBonk[player] = t

	-- Schlag-Animation für alle über das Standard-Animate-Skript (der Besitzer schwingt zusätzlich lokal)
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	Debris:AddItem(anim, 1)

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 or tool.Parent ~= character or root.Anchored then
		return -- nur mit dem Schläger in der Hand, lebendig und nicht eingefroren
	end
	if CarryService.MoveStatus(player) == "flagged" then
		return -- gerade unmöglich schnell bewegt (Teleport-Exploit) -> Schlag zählt nicht
	end
	local gadgets = Services.GadgetService
	local best, bestDist = nil, range
	for _, other in ipairs(Players:GetPlayers()) do
		-- Unsichtbare (Umhang) kann man nicht treffen – wer Beute trägt, aber schon
		-- (Klauen beendet den Umhang sowieso, das hier ist nur das Sicherheitsnetz)
		local cloaked = gadgets ~= nil and gadgets.IsCloaked(other) and not carrying[other]
		local god = other:GetAttribute("AdminGod") == true -- Admin-Gott-Modus
		if other ~= player and not cloaked and not god then
			local otherRoot = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local otherHum = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
			if otherRoot and otherHum and otherHum.Health > 0 then
				local offset = otherRoot.Position - root.Position
				local dist = offset.Magnitude
				local facing = dist < 3 or root.CFrame.LookVector:Dot(offset.Unit) > FACING_DOT
				if dist <= bestDist and facing then
					best, bestDist = other, dist
				end
			end
		end
	end
	if not best then
		return
	end
	local targetRoot = best.Character and best.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not targetRoot then
		return
	end
	local direction = targetRoot.Position - root.Position
	direction = Vector3.new(direction.X, 0, direction.Z)
	direction = direction.Magnitude > 0.01 and direction.Unit or root.CFrame.LookVector
	local super = ownsGadget(player, "SuperBonk")

	playHitSound(targetRoot)
	knockback(best, targetRoot, direction, force, super)
	Services.EconomyService.Effect(best, "Shake", super and 1 or 0.7)
	Services.EconomyService.Effect(player, "Shake", 0.25)
	if carrying[best] then
		CarryService.Fail(best, "bonked")
		trackReward(player, "Bonk", 1)
		Services.EconomyService.Notify(player, "Treffer! " .. best.DisplayName .. " hat die Beute verloren!", "Success")
	end
end

local function batPart(tool: Tool, name: string, size: Vector3, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = tool
	return p
end

-- Blockiger Baseballschläger aus wenigen Teilen, alles entlang +Y des Griffs (Handle):
-- Knauf unten, Griff (Handle), Hals, dicker Schlagteil, Kappe. Hohe Stufen: Leucht-Ringe, König: Krone.
local function createBatTool(bat): Tool
	local tool = Instance.new("Tool")
	tool.Name = bat.Name
	tool.ToolTip = "Klick = Schlagen! Diebe verlieren ihre Beute."
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = BAT_REST_GRIP
	tool:SetAttribute(BAT_ATTRIBUTE, bat.Id)

	local color: Color3 = bat.Color
	local material: Enum.Material = bat.Material or Enum.Material.SmoothPlastic
	local gripColor: Color3 = bat.Grip or Color3.fromRGB(50, 40, 35)
	local handle = batPart(tool, "Handle", Vector3.new(0.4, 1.8, 0.4), gripColor, Enum.Material.SmoothPlastic)
	local function attach(name: string, size: Vector3, y: number, partColor: Color3, partMaterial: Enum.Material): Part
		local p = batPart(tool, name, size, partColor, partMaterial)
		p.CFrame = handle.CFrame * CFrame.new(0, y, 0)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = p
		weld.Parent = p
		return p
	end
	attach("Knob", Vector3.new(0.6, 0.25, 0.6), -1.02, gripColor, Enum.Material.SmoothPlastic)
	attach("Neck", Vector3.new(0.55, 0.8, 0.55), 1.3, color, material)
	attach("Barrel", Vector3.new(0.85, 2.4, 0.85), 2.9, color, material)
	attach("Cap", Vector3.new(0.95, 0.22, 0.95), 4.2, color:Lerp(Color3.new(0, 0, 0), 0.25), material)
	local accent: Color3? = bat.Accent
	if accent then
		attach("Ring", Vector3.new(0.95, 0.22, 0.95), 2.1, accent, Enum.Material.Neon)
		attach("Ring", Vector3.new(0.95, 0.22, 0.95), 3.7, accent, Enum.Material.Neon)
	end
	if bat.Crown and accent then
		for _, offset in ipairs({
			Vector3.new(0.3, 0, 0.3),
			Vector3.new(-0.3, 0, 0.3),
			Vector3.new(0.3, 0, -0.3),
			Vector3.new(-0.3, 0, -0.3),
		}) do
			local spike = attach("Crown", Vector3.new(0.25, 0.45, 0.25), 4.5, accent, Enum.Material.Neon)
			spike.CFrame = handle.CFrame * CFrame.new(offset.X, 4.5, offset.Z)
		end
	end
	return tool
end

-- Gibt den besten erlaubten Schläger – ohne Doppelte; ein schlechterer fliegt raus (war er in der
-- Hand, kommt der neue gleich in die Hand). Beim Spawnen, bei neuem Index, nach dem Laden.
function CarryService.GiveBat(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local character = player.Character
	local bat, loaded = allowedBat(player)
	local template = batTemplates[bat.Id]
	if not template then
		return
	end
	-- Freischalt-Meldung (nur wenn der Spielstand geladen ist und es wirklich besser wurde)
	if loaded then
		local known = batTier[player]
		if known and batIndex(bat.Id) > batIndex(known) then
			Services.EconomyService.Notify(
				player,
				"Neuer Schläger: " .. bat.Name .. "! Mehr Reichweite und Wucht.",
				"Success"
			)
			Services.EconomyService.Effect(player, "Confetti", 2)
		end
		batTier[player] = bat.Id
	end
	local have = false
	local wasEquipped = false
	for _, container in ipairs({ backpack, character }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and child:GetAttribute(BAT_ATTRIBUTE) ~= nil then
					if child:GetAttribute(BAT_ATTRIBUTE) == bat.Id and not have then
						have = true
					else
						wasEquipped = wasEquipped or child.Parent == character
						child:Destroy()
					end
				end
			end
		end
	end
	if have then
		return
	end
	local tool = template:Clone()
	tool.Activated:Connect(function()
		swing(player, tool)
	end)
	tool.Parent = backpack
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if wasEquipped and humanoid and humanoid.Health > 0 then
		humanoid:EquipTool(tool)
	end
end

-- Index hat sich geändert -> passt der Schläger noch? (EconomyService.Discover)
function CarryService.CheckBat(player: Player)
	if player.Parent then
		CarryService.GiveBat(player)
	end
end

local function giveTool(player: Player)
	if player:WaitForChild("Backpack", 10) then
		CarryService.GiveBat(player)
	end
end

function CarryService.Init(services)
	Services = services
	for _, bat in ipairs(Config.Bats) do
		batTemplates[bat.Id] = createBatTool(bat)
	end
end

function CarryService.Start()
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			-- neuer Charakter -> alte Beute ist weg (fliegt zurück bzw. das Ei fällt herunter)
			if carrying[player] then
				CarryService.Fail(player, "died")
			end
			CarryService.NoteTeleport(player) -- neuer Charakter steht woanders
			local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
			if humanoid then
				humanoid.Died:Connect(function()
					CarryService.Fail(player, "died")
				end)
			end
			giveTool(player)
			Services.EconomyService.ApplySpeed(player)
		end)
		if player.Character then
			task.spawn(giveTool, player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end

	-- Beim Verlassen (vor dem Speichern): Diebstähle sauber beenden (Beute geht zurück).
	-- Kann zweimal aufgerufen werden (PlayerRemoving + Speichern) – ist harmlos.
	local function onLeaving(player: Player)
		lastBonk[player] = nil
		batTier[player] = nil
		stunnedUntil[player] = nil
		moveTrack[player] = nil
		stealLimiter.Clear(player)
		if carrying[player] then
			CarryService.Fail(player, "left")
		end
	end
	Services.DataService.OnProfileReleasing(onLeaving)
	Players.PlayerRemoving:Connect(onLeaving)

	-- Prüfen: angekommen? gestorben? zu langsam? teleportiert?
	task.spawn(function()
		while true do
			task.wait(0.15)
			-- Bewegung ALLER Spieler messen (Anti-Teleport fürs Tragen, Kaufen und Klauen)
			for _, player in ipairs(Players:GetPlayers()) do
				if CarryService.MoveStatus(player) == "flagged" and carrying[player] then
					CarryService.Fail(player, "teleport")
				end
			end
			for player, info in pairs(carrying) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local plot = Services.PlotService.GetPlot(player)
				local elapsed = os.clock() - info.Started
				if root and character == info.Character then
					info.LastPos = root.Position -- falls das Ei gleich herunterfällt (Tod, Verlassen)
				end
				if not root or not humanoid or humanoid.Health <= 0 or not info.Visual or not info.Visual.Parent then
					-- (Visual weg = Charakter neu gespawnt oder Beute zerstört)
					CarryService.Fail(player, "died")
				elseif elapsed > (info.Timeout or Config.CarryTimeout) then
					CarryService.Fail(player, "timeout")
				elseif plot and Services.PlotService.IsInside(plot, root.Position) then
					local admin = Services.AdminService
					if elapsed < (info.MinTime or 0) and not (admin and admin.IsAdmin(player)) then
						-- schneller als der kürzeste mögliche Weg -> Teleport oder durch die Wand
						CarryService.Fail(player, "teleport")
					else
						succeed(player)
					end
				end
			end
		end
	end)
end

return CarryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Speichert Spielstände sicher:
--  * Session-Lock: ein Spielstand ist immer nur in EINEM Server offen (keine Duplikate)
--  * Wiederholungen bei DataStore-Fehlern, Auto-Save, Speichern beim Server-Ende
--  * Wenn Laden fehlschlägt, wird der Spieler gekickt statt mit leerem Stand zu spielen
--  * Alte Spielstände (v1: Meteore ohne Aliens, Speed-Level) werden automatisch umgebaut

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Aliens = require(Shared:WaitForChild("Aliens"))

local DataService = {}
DataService.Profiles = {} :: { [Player]: any }

local DATA_VERSION = 2

local DEFAULT_DATA = {
	Version = DATA_VERSION,
	Cash = Config.StartCash,
	Pending = 0,
	-- ["1"] = { Id = "Pebble", Mut = "Normal", Lv = 1, Xp = 0, Hatch = 0, Alien = "PebbleBlob" }
	--   Hatch = Restsekunden bis zum Schlüpfen (0 = geschlüpft), Alien = nil solange noch Meteor
	Meteors = {},
	Rebirths = 0,
	Steps = 0, -- 👟 Schritte von den Laufbändern (bleiben bei Rebirth)
	TotalEarned = 0,
	Index = {}, -- ["PebbleBlob"] = true -> Alien schon entdeckt (bleibt bei Rebirth)
	Stats = { Stolen = 0, Robbed = 0, Bought = 0, RobuxSpent = 0, Grabbed = 0 }, -- Grabbed = Eier aus den Nestern/vom Boden
	Daily = { Last = 0, Streak = 0 },
	Receipts = {}, -- zuletzt verarbeitete Käufe (gegen doppelte Gutschrift)
	LastOnline = 0,
	-- v2.1 (alte Spielstände bekommen die Felder automatisch über Reconcile):
	Spins = 1, -- 🎡 Glücksrad-Drehs (gekauft/gewonnen; der Gratis-Dreh zählt extra)
	LastFreeSpin = 0, -- os.time() des letzten Gratis-Drehs
	-- 📜 Tagesaufgaben: Day = UTC-Tag "YYYY-MM-DD", List = { { Id, Kind, Goal, Progress, Claimed } }
	--    (dazu Rerolled = true, wenn heute schon eine Aufgabe getauscht wurde)
	Quests = { Day = "", List = {} },
	-- 🎁 Spielzeit-Geschenke: Spielzeit von heute (UTC, über alle Besuche), abgeholte als ["1"] = true
	Gifts = { Day = "", Seconds = 0, Claimed = {} },
	Gadgets = {}, -- ["SpeedCoil"] = true -> besessen (bleibt bei Rebirth)
	StarterBought = false, -- ⭐ Starter-Paket schon gekauft (nur einmal im Shop)
	Treadmills = { Holz = true }, -- gekaufte Laufbänder ["Stein"] = true (bleiben bei Rebirth)
	BaseFloors = 1, -- 🏠 gekaufte Stockwerke (1 = nur Erdgeschoss, bleiben bei Rebirth)
	BaseLook = 1, -- 🏠 Base-Look-Stufe 1-5 (nur Optik, bleibt bei Rebirth)
}

local LOCK_EXPIRE = 30 * 60 -- ein Lock älter als 30 Min gilt als verwaist
local LOAD_ATTEMPTS = 6
local LOCK_WAIT = 5

local store = nil
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)

local loadedCallbacks = {}
local releasingCallbacks = {}

local function keyFor(userId: number): string
	return "Player_" .. userId
end

local function jobId(): string
	return game.JobId ~= "" and game.JobId or "studio"
end

function DataService.OnProfileLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

-- Wird VOR dem finalen Speichern aufgerufen (z.B. um laufende Diebstähle abzubrechen)
function DataService.OnProfileReleasing(callback)
	table.insert(releasingCallbacks, callback)
end

function DataService.Get(player: Player)
	local profile = DataService.Profiles[player]
	if profile and profile.Loaded then
		return profile.Data
	end
	return nil
end

function DataService.IsLoaded(player: Player): boolean
	local profile = DataService.Profiles[player]
	return profile ~= nil and profile.Loaded == true
end

-- -------------------------------------------------------------------
-- MIGRATION: alte Spielstände auf das neue Format bringen
-- -------------------------------------------------------------------
-- Umbenannte Mutationen (alter Name -> neuer Name). "Cosmic" ist jetzt eine SELTENHEIT,
-- die Mutation heißt seitdem "Galaxy".
local RENAMED_MUTATIONS: { [string]: string } = { Cosmic = "Galaxy" }

-- Ein Slot-Eintrag reparieren (fehlende Felder, unbekannte Aliens, umbenannte Mutationen)
local function migrateEntry(entry)
	if type(entry.Mut) == "string" and RENAMED_MUTATIONS[entry.Mut] then
		entry.Mut = RENAMED_MUTATIONS[entry.Mut]
	end
	local hatch = tonumber(entry.Hatch)
	if entry.Alien ~= nil and not Aliens.ById[entry.Alien] then
		-- Alien gibt es nicht mehr (Aliens.luau geändert) -> neu würfeln
		entry.Alien = Aliens.Roll(entry.Id)
	end
	if entry.Alien == nil and hatch == nil then
		-- Meteor aus v1 (vor den Aliens): sofort geschlüpft
		entry.Alien = Aliens.Roll(entry.Id)
		entry.Hatch = 0
	elseif entry.Alien ~= nil then
		entry.Hatch = 0
	else
		entry.Hatch = math.max(0, hatch or 0)
		if entry.Hatch ~= entry.Hatch then
			entry.Hatch = 0
		end
	end
end

-- v2.1-Felder prüfen: kaputte Werte auf nil setzen -> Reconcile trägt danach den Standard ein
local function sanitizeRewards(data)
	local spins = data.Spins
	if type(spins) ~= "number" or spins ~= spins then
		data.Spins = nil
	else
		data.Spins = math.clamp(math.floor(spins), 0, 1e6)
	end
	local lastFree = data.LastFreeSpin
	if type(lastFree) ~= "number" or lastFree ~= lastFree or math.abs(lastFree) == math.huge then
		data.LastFreeSpin = nil
	end
	local quests = data.Quests
	if type(quests) ~= "table" or type(quests.Day) ~= "string" or type(quests.List) ~= "table" then
		data.Quests = nil -- der RewardService würfelt dann neue Aufgaben
	elseif quests.Rerolled ~= nil and type(quests.Rerolled) ~= "boolean" then
		quests.Rerolled = nil
	end
	local gifts = data.Gifts
	if type(gifts) ~= "table" or type(gifts.Day) ~= "string" or type(gifts.Claimed) ~= "table" then
		data.Gifts = nil -- Reconcile trägt den Standard ein, der RewardService fängt neu an
	else
		local seconds = gifts.Seconds
		if type(seconds) ~= "number" or seconds ~= seconds or seconds < 0 or seconds == math.huge then
			gifts.Seconds = 0
		end
		for key, claimed in pairs(gifts.Claimed) do
			if type(key) ~= "string" or claimed ~= true then
				gifts.Claimed[key] = nil
			end
		end
	end
	if type(data.Gadgets) ~= "table" then
		data.Gadgets = nil
	else
		for id, owned in pairs(data.Gadgets) do
			if type(id) ~= "string" or owned ~= true then
				data.Gadgets[id] = nil
			end
		end
	end
	if type(data.StarterBought) ~= "boolean" then
		data.StarterBought = nil
	end
	-- Stockwerke / Base-Look: ganze Zahl ab 1 (sonst Standard über Reconcile)
	for _, key in ipairs({ "BaseFloors", "BaseLook" }) do
		local value = data[key]
		if type(value) ~= "number" or value ~= value or value < 1 or value == math.huge then
			data[key] = nil
		else
			data[key] = math.floor(value)
		end
	end
end

-- Laufbänder: früher per Schritte freigeschaltet, jetzt mit Cash gekauft.
-- Alter Spielstand ohne Treadmills -> alle Laufbänder, die man mit seinen Schritten schon hatte, gelten als gekauft.
local function migrateTreadmills(data)
	local owned = data.Treadmills
	if type(owned) ~= "table" then
		owned = {}
		local steps = tonumber(data.Steps) or 0
		for _, def in ipairs(Config.Treadmills) do
			if steps >= (tonumber(def.LegacySteps) or math.huge) then
				owned[def.Id] = true
			end
		end
		data.Treadmills = owned
	end
	for id, value in pairs(owned) do
		if type(id) ~= "string" or value ~= true or not Config.TreadmillsById[id] then
			owned[id] = nil
		end
	end
	for _, def in ipairs(Config.Treadmills) do
		if def.Price <= 0 then
			owned[def.Id] = true -- Gratis-Laufbänder hat jeder
		end
	end
end

function DataService.Migrate(data)
	local version = tonumber(data.Version) or 1
	if version < 2 then
		-- Speed-Level (v1, mit Cash gekauft) -> Schritte, damit niemand langsamer wird
		local speedLevel = tonumber(data.SpeedLevel) or 0
		if speedLevel > 0 then
			data.Steps = math.max(tonumber(data.Steps) or 0, math.floor(10 ^ (speedLevel / 6)))
		end
		-- Index (v1 = Meteor-Ids) -> das Normal-Alien jedes entdeckten Meteors
		local newIndex = {}
		if type(data.Index) == "table" then
			for id in pairs(data.Index) do
				if Aliens.ById[id] then
					newIndex[id] = true
				elseif Config.MeteorsById[id] then
					local options = Aliens.ByMeteor[id]
					if options and options[1] then
						newIndex[options[1].Id] = true
					end
				end
			end
		end
		data.Index = newIndex
	end
	data.SpeedLevel = nil
	data.Version = DATA_VERSION

	if type(data.Meteors) ~= "table" then
		data.Meteors = {}
	end
	for key, entry in pairs(data.Meteors) do
		if type(entry) ~= "table" or type(entry.Id) ~= "string" then
			data.Meteors[key] = nil
		else
			migrateEntry(entry)
		end
	end
	if type(data.Index) == "table" then
		-- Index zählt nur Alien-Ids
		for id in pairs(data.Index) do
			if not Aliens.ById[id] then
				data.Index[id] = nil
			end
		end
	end
	local steps = tonumber(data.Steps) or 0
	data.Steps = (steps == steps and steps >= 0) and steps or 0
	sanitizeRewards(data)
	migrateTreadmills(data)
end

-- Fehlermeldungen, die im Studio bedeuten: DataStores sind hier gar nicht erreichbar
local function isStudioAccessError(err: any): boolean
	local text = string.lower(tostring(err))
	return string.find(text, "studio", 1, true) ~= nil
		or string.find(text, "publish", 1, true) ~= nil
		or string.find(text, "api services", 1, true) ~= nil
		or string.find(text, "403", 1, true) ~= nil
end

local function loadData(userId: number): (boolean, any)
	if not storeOk or not store then
		return false, "DataStore nicht verfügbar"
	end
	for attempt = 1, LOAD_ATTEMPTS do
		local lockedByOther = false
		local forceTake = attempt == LOAD_ATTEMPTS
		local ok, result = pcall(function()
			return store:UpdateAsync(keyFor(userId), function(old)
				old = old or {}
				local lock = old.Lock
				if lock and lock.JobId ~= jobId() and os.time() - (lock.Time or 0) < LOCK_EXPIRE and not forceTake then
					lockedByOther = true
					return nil -- nichts schreiben
				end
				old.Lock = { JobId = jobId(), Time = os.time() }
				return old
			end)
		end)
		if ok and not lockedByOther then
			local data = (result and result.Data) or Util.DeepCopy(DEFAULT_DATA)
			-- erst migrieren (Version prüfen), DANN fehlende Felder ergänzen
			local migrated, err = pcall(DataService.Migrate, data)
			if not migrated then
				warn("[DataService] Migration fehlgeschlagen: " .. tostring(err))
				data.Version = data.Version or 1 -- beim nächsten Laden nochmal versuchen
			end
			Util.Reconcile(data, DEFAULT_DATA)
			return true, data
		end
		if not ok then
			warn("[DataService] Laden fehlgeschlagen (Versuch " .. attempt .. "): " .. tostring(result))
			-- Studio ohne API-Zugriff / unveröffentlichter Ort: Nochmal-Versuchen bringt nichts. Sofort aufgeben,
			-- damit der Studio-Testmodus (ohne Speichern) gleich startet statt nach ~30 s Warten.
			if RunService:IsStudio() and isStudioAccessError(result) then
				break
			end
		end
		task.wait(lockedByOther and LOCK_WAIT or (attempt * 1.5))
	end
	return false, "Konnte Spielstand nicht laden"
end

local function saveData(userId: number, data, release: boolean): boolean
	if not storeOk or not store then
		return false
	end
	for attempt = 1, 4 do
		local lostLock = false
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(userId), function(old)
				old = old or {}
				if old.Lock and old.Lock.JobId ~= jobId() then
					-- Ein anderer Server hat den Spielstand übernommen -> NICHT überschreiben
					lostLock = true
					return nil
				end
				return {
					Data = data,
					Lock = (not release) and { JobId = jobId(), Time = os.time() } or nil,
				}
			end)
		end)
		if ok then
			return not lostLock
		end
		warn("[DataService] Speichern fehlgeschlagen (Versuch " .. attempt .. "): " .. tostring(err))
		task.wait(attempt * 1.5)
	end
	return false
end

function DataService.Save(player: Player): boolean
	local profile = DataService.Profiles[player]
	if not profile or not profile.Loaded or profile.NoSave or profile.Releasing then
		return profile ~= nil and profile.NoSave == true
	end
	profile.Data.LastOnline = os.time()
	return saveData(player.UserId, profile.Data, false)
end

local function onPlayerAdded(player: Player)
	local profile = { Loaded = false, Data = nil, NoSave = false }
	DataService.Profiles[player] = profile

	local ok, data = loadData(player.UserId)
	if not ok then
		if RunService:IsStudio() then
			warn(
				"[DataService] Studio: Speichern ist AUS. Aktiviere in Game Settings > Security 'Enable Studio Access to API Services'."
			)
			data = Util.DeepCopy(DEFAULT_DATA)
			profile.NoSave = true
		else
			DataService.Profiles[player] = nil
			if player.Parent then
				player:Kick(
					"Dein Spielstand konnte nicht geladen werden. Bitte tritt erneut bei. (Roblox-Server ausgelastet)"
				)
			end
			return
		end
	end

	if not player.Parent then
		-- Spieler hat das Spiel während des Ladens verlassen -> Lock freigeben
		if not profile.NoSave then
			saveData(player.UserId, data, true)
		end
		DataService.Profiles[player] = nil
		return
	end

	profile.Data = data
	profile.Loaded = true
	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(callback, player, data)
	end
end

local function releaseProfile(player: Player)
	local profile = DataService.Profiles[player]
	if not profile then
		return
	end
	if profile.Releasing then
		-- wird bereits gespeichert (PlayerRemoving + BindToClose gleichzeitig)
		while DataService.Profiles[player] == profile do
			task.wait(0.1)
		end
		return
	end
	profile.Releasing = true
	if profile.Loaded then
		for _, callback in ipairs(releasingCallbacks) do
			local ok, err = pcall(callback, player, profile.Data)
			if not ok then
				warn("[DataService] Releasing-Callback Fehler: " .. tostring(err))
			end
		end
		if not profile.NoSave then
			profile.Data.LastOnline = os.time()
			saveData(player.UserId, profile.Data, true)
		end
	end
	DataService.Profiles[player] = nil
end

-- Spielstand komplett zurücksetzen (Admin)
function DataService.Reset(player: Player)
	local profile = DataService.Profiles[player]
	if profile and profile.Loaded then
		local fresh = Util.DeepCopy(DEFAULT_DATA)
		fresh.Receipts = profile.Data.Receipts -- Käufe bleiben verbucht
		fresh.StarterBought = profile.Data.StarterBought == true -- Starter-Paket gibt es nur einmal
		for k in pairs(profile.Data) do
			profile.Data[k] = nil
		end
		for k, v in pairs(fresh) do
			profile.Data[k] = v
		end
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(releaseProfile)

	-- Auto-Save
	task.spawn(function()
		while true do
			task.wait(Config.AutoSaveInterval)
			for player in pairs(DataService.Profiles) do
				if player.Parent then
					task.spawn(DataService.Save, player)
					task.wait(0.5) -- verteilen, um Limits zu schonen
				end
			end
		end
	end)

	-- Server fährt herunter: alles speichern (Roblox gibt max. 30 Sekunden)
	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				releaseProfile(player)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[-- Geld & Fortschritt: Einkommen, Schlüpfen (Meteor -> Alien), Aufladen (Level), Einsammeln,
-- Verkaufen, Schritte/Speed, Rebirth, Tagesbonus, Index, Leaderstats und Daten an den Client.
-- Verteilt außerdem die Anfragen vom Client (Remotes.Request) – auch für Geschenke, Glücksrad,
-- Tagesaufgaben (RewardService), Gadgets (GadgetService) und Laufbänder (TreadmillService) –
-- und zählt Fortschritt für die Aufgaben.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Aliens = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Aliens"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))

local EconomyService = {}
local Services

local dirty: { [Player]: boolean } = {}
-- true = Spielstand fertig eingerichtet (Pässe geprüft, Offline-Zeit verrechnet, Base angezeigt).
-- Vorher laufen weder Einkommen/Schlüpfen noch Käufe/Diebstähle.
local readyPlayers: { [Player]: boolean } = {}
local requestLimiter = Util.RateLimiter(8, 1)

-- Selten geänderte Teile des States (Index, Pässe, Statistik) nur bei Änderung mitschicken.
-- Der Client behält die alten Werte, wenn ein Feld fehlt. Ab und zu trotzdem alles (Sicherheitsnetz).
local FULL_STATE_INTERVAL = 20
local sentIndexCount: { [Player]: number } = {}
local sentPasses: { [Player]: string } = {}
local sentStats: { [Player]: string } = {}
local fullStateAt: { [Player]: number } = {}

local DELIVER_TIME = 0.9 -- so lange fliegt ein gekaufter Meteor in die Base (Client-Effekt)
local ULTRA_ANNOUNCE_RARITY = 5 -- ab Legendary wird ein Ultra-Alien allen angesagt
local REVEAL_RARITY = Config.RarityIndex.Epic or 4 -- ab Epic: große Schlüpf-Karte beim Besitzer
local LUCKY_PASS_MULT = 2 -- Gamepass "2x Glück": Selten/Ultra beim Schlüpfen doppelt so wahrscheinlich
local MAX_COIL_BONUS = 1 + (Config.SpeedCoilBonus or 0.3) -- Speed Coil: +30% (auch über MaxWalkSpeed)
local TIER_RANK = { Normal = 1, Selten = 2, Ultra = 3 }
-- "Alle Eier sofort schlüpfen": höchstens so viele Schlüpf-Explosionen an alle (sonst ruckelt es bei allen)
local HATCH_ALL_BURSTS = 3

-- -------------------------------------------------------------------
-- NACHRICHTEN & EFFEKTE
-- -------------------------------------------------------------------
function EconomyService.Notify(player: Player?, text: string, kind: string?)
	if player and player.Parent then
		Remotes.Notify:FireClient(player, text, kind or "Info")
	end
end

function EconomyService.NotifyAll(text: string, kind: string?)
	Remotes.Notify:FireAllClients(text, kind or "Info")
end

-- Effekt für einen Spieler: name, strength, data (optional, z.B. Positionen)
function EconomyService.Effect(player: Player?, name: string, strength: number?, data: any?)
	if player and player.Parent then
		Remotes.Effect:FireClient(player, name, strength or 1, data)
	end
end

-- Effekt für alle Spieler (z.B. "Deliver", "Hatch")
function EconomyService.EffectAll(name: string, strength: number?, data: any?)
	Remotes.Effect:FireAllClients(name, strength or 1, data)
end

-- Fortschritt für die Tagesaufgaben (RewardService) – ein Fehler dort darf Geld/Schlüpfen nie stoppen
local function track(player: Player, kind: string, amount: number)
	local rewards = Services.RewardService
	if rewards then
		local ok, err = pcall(rewards.Track, player, kind, amount)
		if not ok then
			warn("[EconomyService] RewardService.Track(" .. kind .. ") fehlgeschlagen: " .. tostring(err))
		end
	end
end

function EconomyService.MarkDirty(player: Player?)
	if player then
		dirty[player] = true
	end
end

-- Ist der Spielstand fertig geladen und eingerichtet? (für Käufe, Diebstähle, Einkommen)
function EconomyService.IsReady(player: Player): boolean
	return readyPlayers[player] == true
end

-- -------------------------------------------------------------------
-- RECHNEN
-- -------------------------------------------------------------------
-- Anzahl entdeckter Aliens (nur gültige Alien-Ids zählen)
function EconomyService.IndexCount(data): number
	local count = 0
	for id in pairs(data.Index) do
		if Aliens.ById[id] then
			count += 1
		end
	end
	return count
end

function EconomyService.GetMultiplier(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 1
	end
	local Monetization = Services.MonetizationService
	local mult = 1 + data.Rebirths * Config.RebirthMultPerLevel
	if Monetization.HasPass(player, "DoubleCash") then
		mult *= 2
	end
	local bonus = 1 + EconomyService.IndexCount(data) * Config.IndexBonusPerAlien
	if Monetization.HasPass(player, "VIP") then
		bonus += Config.VIPBonus
	end
	if player.MembershipType == Enum.MembershipType.Premium then
		bonus += Config.PremiumBonus
	end
	return mult * bonus
end

function EconomyService.GetIncome(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 0
	end
	local plot = Services.PlotService.GetPlot(player)
	local base = 0
	for key, entry in pairs(data.Meteors) do
		local slot = tonumber(key)
		if not (plot and slot and Services.CarryService.IsSlotBeingStolen(plot, slot)) then
			base += Config.MeteorIncome(entry)
		end
	end
	return base * EconomyService.GetMultiplier(player)
end

-- Schritte-Multiplikator: 2x mit Gamepass "2x Schritte", +25% pro Rebirth
function EconomyService.GetStepsMult(player: Player): number
	local data = Services.DataService.Get(player)
	local rebirths = data and data.Rebirths or 0
	local pass = Services.MonetizationService.HasPass(player, "SpeedBoots") and 2 or 1
	return pass * (1 + Config.StepsPerRebirth * rebirths)
end

-- Tempo aus den Schritten (ohne Gadgets, ohne Tragen) – wird im HUD angezeigt
function EconomyService.GetSpeed(player: Player): number
	local data = Services.DataService.Get(player)
	local steps = data and data.Steps or 0
	return math.min(Config.MaxWalkSpeed, Config.StepsSpeed(steps))
end

-- Speed Coil (GadgetService): Faktor 1 .. 1.3, solange sie ausgerüstet ist
local function gadgetSpeedBonus(player: Player): number
	local gadgets = Services.GadgetService
	if not gadgets or type(gadgets.SpeedBonus) ~= "function" then
		return 1
	end
	local ok, bonus = pcall(gadgets.SpeedBonus, player)
	local factor = ok and tonumber(bonus) or 1
	if factor ~= factor then
		return 1
	end
	return math.clamp(factor, 1, MAX_COIL_BONUS)
end

-- Beim Tragen: Config.CarrySpeedFactor, seltene (schwere) Beute noch langsamer (Config.HeavyCarry),
-- mit Gamepass "Volle Speed beim Tragen" gar kein Abzug
local function carryFactor(player: Player): number
	if Services.MonetizationService.HasPass(player, "CarryFast") then
		return 1
	end
	local factor = Config.CarrySpeedFactor
	local heavy = Config.HeavyFactor(Services.CarryService.CarriedEntry(player))
	if heavy then
		factor = math.min(factor, heavy)
	end
	return factor
end

-- Speed-Pad im Nester-Feld (FieldService setzt das Attribut "SpeedPadUntil" = Serverzeit): Faktor 1 .. 1.5
local function padSpeedBonus(player: Player): number
	local untilTime = tonumber(player:GetAttribute("SpeedPadUntil")) or 0
	if untilTime <= workspace:GetServerTimeNow() then
		return 1
	end
	return 1 + math.clamp(tonumber(Config.SpeedPads and Config.SpeedPads.Boost) or 0, 0, 1)
end

-- Echte Laufgeschwindigkeit: Schritte-Tempo x Speed Coil (Deckel MaxWalkSpeed * 1.3)
-- x Speed-Pad (Deckel Config.SpeedPads.MaxSpeed), beim Tragen langsamer
function EconomyService.GetWalkSpeed(player: Player, carrying: boolean): number
	local speed = EconomyService.GetSpeed(player)
	local bonus = gadgetSpeedBonus(player)
	if bonus > 1 then
		speed = math.min(speed * bonus, Config.MaxWalkSpeed * MAX_COIL_BONUS)
	end
	local pad = padSpeedBonus(player)
	if pad > 1 then
		local cap = tonumber(Config.SpeedPads and Config.SpeedPads.MaxSpeed) or 120
		speed = math.max(speed, math.min(speed * pad, cap))
	end
	if carrying then
		speed = math.max(8, speed * carryFactor(player))
	end
	return speed
end

-- Admin-Speed-Regler (Attribut AdminSpeed, nur für echte Admins): ersetzt das normale Tempo
local function adminSpeed(player: Player): number?
	local value = tonumber(player:GetAttribute("AdminSpeed"))
	if not value or value ~= value then
		return nil
	end
	local admin = Services.AdminService
	if not admin or not admin.IsAdmin(player) then
		return nil
	end
	local powers = Config.AdminPowers or {}
	return math.clamp(value, tonumber(powers.MinSpeed) or 8, tonumber(powers.MaxSpeed) or 250)
end

function EconomyService.ApplySpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local speed = adminSpeed(player) or EconomyService.GetWalkSpeed(player, Services.CarryService.IsCarrying(player))
	if humanoid.WalkSpeed ~= speed then
		humanoid.WalkSpeed = speed
	end
end

-- Schritte gutschreiben (Laufband, Produkte, Belohnungen). Passt die Laufgeschwindigkeit an.
-- (Die Tagesaufgabe "Lauf X Schritte" zählt der TreadmillService – gekaufte Schritte zählen nicht.)
function EconomyService.AddSteps(player: Player, amount: number)
	local data = Services.DataService.Get(player)
	if not data or amount ~= amount or amount == math.huge then
		return
	end
	local before = Config.StepsSpeed(data.Steps)
	data.Steps = math.clamp(data.Steps + amount, 0, 1e30)
	if Config.StepsSpeed(data.Steps) ~= before then
		EconomyService.ApplySpeed(player)
	end
	dirty[player] = true
end

-- -------------------------------------------------------------------
-- GELD
-- -------------------------------------------------------------------
function EconomyService.AddCash(player: Player, amount: number)
	local data = Services.DataService.Get(player)
	if not data or amount ~= amount then
		return
	end
	data.Cash = math.max(0, data.Cash + amount)
	if amount > 0 then
		data.TotalEarned += amount
	end
	dirty[player] = true
end

function EconomyService.Collect(player: Player)
	local data = Services.DataService.Get(player)
	if not data or data.Pending < 1 then
		return
	end
	local amount = math.floor(data.Pending)
	data.Pending -= amount
	EconomyService.AddCash(player, amount)
	EconomyService.Effect(player, "Collect", amount)
	track(player, "Collect", amount)
	local plot = Services.PlotService.GetPlot(player)
	if plot then
		Services.PlotService.SetCollectText(plot, data.Pending)
	end
end

-- Neues Alien im Index? (silent = keine Einzel-Nachricht, z.B. beim Laden)
function EconomyService.Discover(player: Player, alienId: string?, silent: boolean?): boolean
	local data = Services.DataService.Get(player)
	local alien = alienId and Aliens.ById[alienId]
	if not data or not alien or data.Index[alien.Id] then
		return false
	end
	data.Index[alien.Id] = true
	-- Neuer Index-Stand -> vielleicht ein besserer Schläger (CarryService tauscht ihn aus)
	local carry = Services.CarryService
	if carry and carry.CheckBat then
		task.defer(carry.CheckBat, player)
	end
	if not silent then
		EconomyService.Notify(
			player,
			"📖 NEU im Index: "
				.. alien.Name
				.. "! (+"
				.. math.floor(Config.IndexBonusPerAlien * 100 + 0.5)
				.. "% Einkommen)",
			"Success"
		)
	end
	dirty[player] = true
	return true
end

-- Legt einen Meteor in einen Slot. Mit fromPosition fliegt er sichtbar dorthin (Client-Effekt)
-- und erscheint erst nach der Flugzeit. entry.Alien gesetzt + gültig -> schon geschlüpft.
function EconomyService.DeliverMeteor(player: Player, plot, slot: number, entry, fromPosition: Vector3?)
	local data = Services.DataService.Get(player)
	if not data or not Config.MeteorsById[entry.Id] then
		return nil
	end
	local key = tostring(slot)
	local newEntry = {
		Id = entry.Id,
		Mut = Config.MutationsByName[entry.Mut] and entry.Mut or "Normal",
		Lv = math.clamp(math.floor(tonumber(entry.Lv) or 1), 1, Config.MaxLevel),
		Xp = 0,
		Hatch = Config.HatchTime(entry.Id),
		Alien = nil :: string?,
	}
	if entry.Alien ~= nil and Aliens.ById[entry.Alien] then
		newEntry.Alien = entry.Alien
		newEntry.Hatch = 0
	end
	data.Meteors[key] = newEntry
	dirty[player] = true
	if newEntry.Alien then
		EconomyService.Discover(player, newEntry.Alien)
	end

	if fromPosition then
		local top = Services.PlotService.SlotTopCFrame(plot, slot).Position
		local to = top + Vector3.new(0, MeteorFactory.GetSize(newEntry) / 2, 0)
		EconomyService.EffectAll("Deliver", 0, {
			From = fromPosition,
			To = to,
			MeteorId = newEntry.Id,
			Mut = newEntry.Mut,
		})
		task.delay(DELIVER_TIME, function()
			-- nur anzeigen, wenn der Eintrag noch derselbe ist (nicht verkauft, Rebirth, verlassen ...)
			local current = Services.DataService.Get(player)
			if plot.Owner == player and current and current.Meteors[key] == newEntry then
				Services.PlotService.RenderSlot(plot, slot)
			end
		end)
	else
		Services.PlotService.RenderSlot(plot, slot)
	end
	return newEntry
end

-- Meteor direkt in die Base legen (Admin, Produkte). Gibt true zurück, wenn Platz war.
-- fly = true -> fliegt vom Himmel in den Slot
function EconomyService.GiveMeteor(player: Player, entry, fly: boolean?): boolean
	local plot = Services.PlotService.GetPlot(player)
	local slot = Services.PlotService.FreeSlot(player)
	if not plot or not slot or not Config.MeteorsById[entry.Id] then
		return false
	end
	local from = nil
	if fly then
		local top = Services.PlotService.SlotTopCFrame(plot, slot).Position
		from = top + Vector3.new(math.random(-40, 40), 180, math.random(-40, 40))
	end
	return EconomyService.DeliverMeteor(player, plot, slot, entry, from) ~= nil
end

function EconomyService.Sell(player: Player, plot, slot: number)
	if plot.Owner ~= player then
		return
	end
	local data = Services.DataService.Get(player)
	local key = tostring(slot)
	local entry = data and data.Meteors[key]
	if not entry or Services.CarryService.IsSlotBeingStolen(plot, slot) then
		return
	end
	local value = math.floor(Config.MeteorValue(entry) * Config.SellRatio)
	data.Meteors[key] = nil
	EconomyService.AddCash(player, value)
	Services.PlotService.RenderSlot(plot, slot)
	EconomyService.Notify(player, "💰 Verkauft für " .. Util.FormatCash(value), "Success")
end

-- -------------------------------------------------------------------
-- SCHLÜPFEN
-- -------------------------------------------------------------------
-- Glück beim Schlüpfen: Server-Glück/Schauer (baseLuck) x2 mit Gamepass "2x Glück"
function EconomyService.HatchLuck(player: Player, baseLuck: number?): number
	local luck = baseLuck or Services.MeteorService.GetLuck()
	if Services.MonetizationService.HasPass(player, "Lucky") then
		luck *= LUCKY_PASS_MULT
	end
	return luck
end

-- Wertung fürs "beste" Alien (Seltenheit vor Stufe)
local function alienScore(def, tier: string): number
	return (def and Config.RarityIndex[def.Rarity] or 0) * 10 + (TIER_RANK[tier] or 1)
end

-- Stelle der Schlüpf-Explosion über einem Slot
local function hatchPosition(plot, slot: number): Vector3
	return Services.PlotService.SlotTopCFrame(plot, slot).Position + Vector3.new(0, 2, 0)
end

-- Meteor in Slot schlüpft jetzt -> Alien würfeln, Index, Effekt, neu anzeigen. Gibt die Alien-Id zurück.
-- quiet = keine Einzel-Nachrichten/-Karten/-Explosionen (z.B. "Alle Eier sofort schlüpfen" meldet gesammelt)
function EconomyService.Hatch(player: Player, plot, slot: number, entry, luck: number?, quiet: boolean?): string
	local alienId = Aliens.Roll(entry.Id, EconomyService.HatchLuck(player, luck))
	entry.Alien = alienId
	entry.Hatch = 0
	entry.Lv = math.max(1, tonumber(entry.Lv) or 1)
	entry.Xp = 0
	dirty[player] = true

	local alien = Aliens.ById[alienId]
	local def = Config.MeteorsById[entry.Id]
	Services.PlotService.RenderSlot(plot, slot)
	if not quiet then
		EconomyService.EffectAll(
			"Hatch",
			0,
			{ Position = hatchPosition(plot, slot), Rarity = def and def.Rarity or "Common" }
		)
	end

	local name = alien and alien.Name or alienId
	local tier = alien and alien.Tier or "Normal"
	if not quiet then
		local tierText = tier == "Ultra" and "🌟 ULTRA " or (tier == "Selten" and "✨ Selten: " or "")
		EconomyService.Notify(player, "🐣 Geschlüpft: " .. tierText .. name .. "!", "Success")
		-- Große Karte in der Bildschirmmitte (mit Konfetti) ab Epic oder bei Selten/Ultra
		if tier ~= "Normal" or (def and (Config.RarityIndex[def.Rarity] or 0) >= REVEAL_RARITY) then
			EconomyService.Effect(player, "HatchReveal", 0, { AlienId = alienId, Mut = entry.Mut })
		end
	end
	if tier == "Ultra" and def and Config.RarityIndex[def.Rarity] >= ULTRA_ANNOUNCE_RARITY then
		EconomyService.NotifyAll(
			"🌟 " .. player.DisplayName .. " hat ein ULTRA " .. name .. " ausgebrütet!",
			"Event"
		)
	end
	EconomyService.Discover(player, alienId, quiet)
	track(player, "Hatch", 1)
	return alienId
end

-- Alle Eier in der Base schlüpfen sofort (Produkt "🐣 Alle Eier sofort schlüpfen").
-- Eine Sammel-Nachricht + große Karte fürs beste Alien statt vieler Einzel-Nachrichten.
-- Gibt die Anzahl der geschlüpften Aliens zurück (0 = keine Eier in der Base).
function EconomyService.HatchAll(player: Player): number
	local data = Services.DataService.Get(player)
	local plot = Services.PlotService.GetPlot(player)
	if not data or not plot then
		return 0
	end
	local luck = Services.MeteorService.GetLuck()
	local indexBefore = EconomyService.IndexCount(data)
	local count = 0
	local bestId, bestMut, bestScore = nil, nil, -1
	local bursts: { { Position: Vector3, Rarity: string, Score: number } } = {}
	for key, entry in pairs(data.Meteors) do
		local slot = tonumber(key)
		if slot and entry.Alien == nil and not Services.CarryService.IsSlotBeingStolen(plot, slot) then
			local alienId = EconomyService.Hatch(player, plot, slot, entry, luck, true)
			count += 1
			local alien = Aliens.ById[alienId]
			local def = Config.MeteorsById[entry.Id]
			local score = alienScore(def, alien and alien.Tier or "Normal")
			if score > bestScore then
				bestId, bestMut, bestScore = alienId, entry.Mut, score
			end
			table.insert(bursts, {
				Position = hatchPosition(plot, slot),
				Rarity = def and def.Rarity or "Common",
				Score = score,
			})
		end
	end
	-- Nur die besten paar Explosionen an alle schicken (18 auf einmal = Ruckeln bei jedem Spieler)
	table.sort(bursts, function(a, b)
		return a.Score > b.Score
	end)
	for i = 1, math.min(HATCH_ALL_BURSTS, #bursts) do
		EconomyService.EffectAll("Hatch", 0, { Position = bursts[i].Position, Rarity = bursts[i].Rarity })
	end
	if count > 0 then
		local discovered = EconomyService.IndexCount(data) - indexBefore
		EconomyService.Notify(
			player,
			"🐣 "
				.. (count == 1 and "1 Alien ist" or (count .. " Aliens sind"))
				.. " geschlüpft!"
				.. (discovered > 0 and (" 📖 " .. discovered .. " neu im Index!") or ""),
			"Success"
		)
		if bestId then
			EconomyService.Effect(player, "HatchReveal", 0, { AlienId = bestId, Mut = bestMut })
		end
	end
	return count
end

-- -------------------------------------------------------------------
-- REBIRTH / DAILY
-- -------------------------------------------------------------------
function EconomyService.Rebirth(player: Player): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch..."
	end
	if Services.CarryService.IsCarrying(player) then
		return false, "Bring erst deine Beute nach Hause! 🏃"
	end
	local cost = Config.RebirthCost(data.Rebirths)
	if data.Cash < cost then
		return false, "Du brauchst " .. Util.FormatCash(cost) .. " für den Rebirth!"
	end
	local plot = Services.PlotService.GetPlot(player)
	if plot then
		Services.CarryService.CancelStealsFromPlot(plot, "cancelled")
	end
	data.Rebirths += 1
	data.Cash = Config.StartCash
	data.Pending = 0
	data.Meteors = {}
	if plot then
		Services.PlotService.RenderAll(plot)
		Services.PlotService.SetCollectText(plot, 0)
	end
	dirty[player] = true
	EconomyService.NotifyAll("🔥 " .. player.DisplayName .. " hat Rebirth " .. data.Rebirths .. " erreicht!", "Event")
	EconomyService.Effect(player, "Confetti", 2)
	return true,
		"🔥 Rebirth! Jetzt "
			.. Util.FormatNumber(EconomyService.GetMultiplier(player) * 100)
			.. "% Einkommen und x"
			.. Util.FormatNumber(EconomyService.GetStepsMult(player))
			.. " Schritte"
end

local DAY = 24 * 3600

function EconomyService.DailyStatus(data): (boolean, number)
	local elapsed = os.time() - data.Daily.Last
	return elapsed >= DAY, math.max(0, DAY - elapsed)
end

function EconomyService.ClaimDaily(player: Player): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch..."
	end
	local ready, remaining = EconomyService.DailyStatus(data)
	if not ready then
		return false, "⏰ Nächster Bonus in " .. Util.FormatTime(remaining)
	end
	local elapsed = os.time() - data.Daily.Last
	if data.Daily.Last > 0 and elapsed < DAY * 2 then
		data.Daily.Streak += 1
	else
		data.Daily.Streak = 1
	end
	data.Daily.Last = os.time()
	local reward = math.max(
		Config.DailyRewardMinCash,
		EconomyService.GetIncome(player) * Config.DailyRewardIncomeSeconds
	) * math.min(data.Daily.Streak, 7)
	reward = math.floor(reward)
	EconomyService.AddCash(player, reward)
	EconomyService.Effect(player, "Confetti", 1)
	return true, "🎁 Tag " .. data.Daily.Streak .. ": +" .. Util.FormatCash(reward)
end

-- -------------------------------------------------------------------
-- DATEN AN DEN CLIENT
-- -------------------------------------------------------------------
-- Besessene Gadgets als Liste von Ids (Reihenfolge wie in Config.Gadgets)
local function ownedGadgets(data): { string }
	local list = {}
	local gadgets = data.Gadgets
	if type(gadgets) == "table" then
		for _, def in ipairs(Config.Gadgets) do
			if gadgets[def.Id] == true then
				table.insert(list, def.Id)
			end
		end
	end
	return list
end

local function buildState(player: Player)
	local data = Services.DataService.Get(player)
	if not data then
		return nil
	end
	local plot = Services.PlotService.GetPlot(player)
	local dailyReady, dailyIn = EconomyService.DailyStatus(data)
	local indexCount = EconomyService.IndexCount(data)
	local best = Config.BestTreadmill(data.Treadmills)
	local bat, nextBat = Config.BestBat(indexCount)
	local treadmills = {}
	for _, def in ipairs(Config.Treadmills) do
		if Config.OwnsTreadmill(data.Treadmills, def.Id) then
			table.insert(treadmills, def.Id)
		end
	end
	local state = {
		Cash = data.Cash,
		Pending = data.Pending,
		Income = EconomyService.GetIncome(player),
		Multiplier = EconomyService.GetMultiplier(player),
		Rebirths = data.Rebirths,
		RebirthCost = Config.RebirthCost(data.Rebirths),
		Steps = data.Steps,
		StepsMult = EconomyService.GetStepsMult(player),
		Speed = EconomyService.GetSpeed(player),
		BestTreadmill = best and best.Id or nil,
		Treadmills = treadmills, -- gekaufte Laufbänder (Ids)
		Bat = bat and bat.Id or nil, -- bester freigeschalteter Schläger
		NextBat = nextBat and nextBat.Id or nil,
		IndexCount = indexCount,
		Slots = Services.PlotService.SlotCount(player),
		UsedSlots = Services.PlotService.UsedSlots(player),
		DailyReady = dailyReady,
		DailyIn = dailyIn,
		Streak = data.Daily.Streak,
		IndexBonus = indexCount * Config.IndexBonusPerAlien,
		Carrying = Services.CarryService.IsCarrying(player),
		HasPlot = plot ~= nil,
		TotalEarned = data.TotalEarned,
		Gadgets = ownedGadgets(data),
		StarterBought = data.StarterBought == true,
		BaseFloors = tonumber(data.BaseFloors) or 1, -- 🏠 gekaufte Stockwerke
		BaseLook = tonumber(data.BaseLook) or 1, -- 🏠 Base-Look-Stufe
	}
	-- Selten geänderte Teile nur bei Änderung (oder alle FULL_STATE_INTERVAL Sekunden alles)
	local clock = os.clock()
	local full = clock - (fullStateAt[player] or -math.huge) >= FULL_STATE_INTERVAL
	if full then
		fullStateAt[player] = clock
	end

	-- 🎁 Geschenke, 🎡 Glücksrad (Spins, FreeSpinIn), 📜 Aufgaben – ein Fehler dort darf den State nie stoppen.
	-- (Geschenke/Aufgaben schickt der RewardService auch nur bei Änderung bzw. wenn full = true.)
	local rewards = Services.RewardService
	if rewards then
		local ok, err = pcall(rewards.FillState, player, data, state, full)
		if not ok then
			warn("[EconomyService] Belohnungs-Daten fehlgeschlagen: " .. tostring(err))
		end
	end

	-- Index, Pässe und Statistik nur bei Änderung (oder wenn full = true)
	if full or sentIndexCount[player] ~= indexCount then
		-- Der Index wächst nur (Reset leert ihn) -> die Anzahl reicht als Änderungs-Merkmal
		sentIndexCount[player] = indexCount
		local index = {}
		for id in pairs(data.Index) do
			if Aliens.ById[id] then
				table.insert(index, id)
			end
		end
		state.Index = index
	end
	local passKey = ""
	for _, pass in ipairs(Config.GamePasses) do
		passKey ..= Services.MonetizationService.HasPass(player, pass.Key) and "1" or "0"
	end
	if full or sentPasses[player] ~= passKey then
		sentPasses[player] = passKey
		local passes = {}
		for _, pass in ipairs(Config.GamePasses) do
			passes[pass.Key] = Services.MonetizationService.HasPass(player, pass.Key)
		end
		state.Passes = passes
	end
	local stats = data.Stats
	local statsKey = ("%s|%s|%s|%s"):format(
		tostring(stats.Stolen),
		tostring(stats.Robbed),
		tostring(stats.Bought),
		tostring(stats.RobuxSpent)
	)
	if full or sentStats[player] ~= statsKey then
		sentStats[player] = statsKey
		state.Stats = stats
	end
	return state
end

local function updateLeaderstats(player: Player)
	local data = Services.DataService.Get(player)
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	local cash = stats:FindFirstChild("Cash") :: StringValue?
	local rebirths = stats:FindFirstChild("Rebirths") :: IntValue?
	if cash then
		local text = Util.FormatCash(data.Cash)
		if cash.Value ~= text then
			cash.Value = text
		end
	end
	if rebirths and rebirths.Value ~= data.Rebirths then
		rebirths.Value = data.Rebirths
	end
end

local function flush(player: Player)
	local state = buildState(player)
	if state then
		Remotes.State:FireClient(player, state)
		updateLeaderstats(player)
	end
end

local function onProfileLoaded(player: Player, data)
	-- Leaderboard in der Spielerliste
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player

	-- Spielstand reparieren (gelöschte Meteor-Typen entfernen, Slots kappen, Felder prüfen)
	local maxSlots = Services.PlotService.MaxSlots
	for key, entry in pairs(data.Meteors) do
		local slot = tonumber(key)
		if not slot or not Config.MeteorsById[entry.Id] or slot < 1 or slot > maxSlots or slot % 1 ~= 0 then
			data.Meteors[key] = nil
		else
			entry.Lv = math.clamp(math.floor(tonumber(entry.Lv) or 1), 1, Config.MaxLevel)
			entry.Xp = tonumber(entry.Xp) or 0
			entry.Mut = Config.MutationsByName[entry.Mut] and entry.Mut or "Normal"
			entry.Hatch = math.max(0, tonumber(entry.Hatch) or 0)
			if entry.Alien ~= nil then
				data.Index[entry.Alien] = true
			end
		end
	end

	-- Zeitpunkt des letzten Besuchs VOR dem Warten merken (ein Auto-Save setzt LastOnline neu)
	local lastOnline = data.LastOnline

	-- Warten bis die Gamepasses geprüft sind (für Slots / Multiplikator / Schlüpf-Tempo).
	-- Bis "ready" gesetzt ist, laufen weder Einkommen noch Schlüpfen, Käufe oder Diebstähle.
	Services.MonetizationService.LoadPasses(player)
	if not player.Parent then
		return
	end

	-- Offline: Schlüpfzeit vergeht auch ohne dich
	local offline = lastOnline > 0 and math.max(0, os.time() - lastOnline) or 0
	local hatchedOffline = 0
	if offline > 0 then
		local speed = Services.PlotService.HatchSpeed(player)
		local luck = EconomyService.HatchLuck(player, 1) -- ohne Server-Glück, aber mit "2x Glück"-Pass
		for _, entry in pairs(data.Meteors) do
			if entry.Alien == nil then
				entry.Hatch = math.max(0, entry.Hatch - offline * speed)
				if entry.Hatch <= 0 then
					entry.Alien = Aliens.Roll(entry.Id, luck)
					entry.Hatch = 0
					entry.Xp = 0
					EconomyService.Discover(player, entry.Alien, true)
					hatchedOffline += 1
				end
			end
		end
	end

	-- Offline-Einkommen
	if lastOnline > 0 then
		local seconds = math.clamp(offline, 0, Config.OfflineMaxSeconds)
		local earned = math.floor(EconomyService.GetIncome(player) * seconds * Config.OfflineIncomeRate)
		if earned > 0 then
			data.Pending += earned
			task.delay(3, function()
				EconomyService.Notify(
					player,
					"🌙 Offline verdient: " .. Util.FormatCash(earned) .. " – hol es am Geld-Pad in deiner Base!",
					"Success"
				)
			end)
		end
	end
	if hatchedOffline > 0 then
		track(player, "Hatch", hatchedOffline)
		task.delay(4, function()
			EconomyService.Notify(
				player,
				"🐣 Während du weg warst, "
					.. (hatchedOffline == 1 and "ist 1 Alien" or ("sind " .. hatchedOffline .. " Aliens"))
					.. " geschlüpft!",
				"Success"
			)
		end)
	end
	data.LastOnline = os.time()

	local plot = Services.PlotService.GetPlot(player)
	if plot then
		Services.PlotService.RenderAll(plot)
		Services.PlotService.SetCollectText(plot, data.Pending)
	end
	readyPlayers[player] = true
	EconomyService.ApplySpeed(player)
	flush(player)

	local dailyReady = EconomyService.DailyStatus(data)
	if dailyReady then
		task.delay(5, function()
			EconomyService.Notify(player, "🎁 Dein Tagesbonus wartet! Klick auf 'Daily'.", "Info")
		end)
	end
end

-- Etwa jede Sekunde: Schlüpfen, Aufladen (Level) und Einkommen für einen Spieler.
-- dt = echte vergangene Zeit -> der Schlüpf-Countdown beim Client (HatchAt) bleibt genau.
local function tickPlayer(player: Player, data, plot, dt: number)
	local Monetization = Services.MonetizationService
	local speed = (Monetization.HasPass(player, "FastCharge") and 2 or 1) * dt
	local luck = nil
	for key, entry in pairs(data.Meteors) do
		local slot = tonumber(key)
		if slot and not Services.CarryService.IsSlotBeingStolen(plot, slot) then
			if entry.Alien == nil then
				entry.Hatch -= speed
				if entry.Hatch <= 0 then
					luck = luck or Services.MeteorService.GetLuck()
					EconomyService.Hatch(player, plot, slot, entry, luck)
				end
			elseif entry.Lv < Config.MaxLevel then
				entry.Xp += speed
				if entry.Xp >= Config.ChargeTime(entry.Lv) then
					entry.Xp = 0
					entry.Lv += 1
					Services.PlotService.RefreshSlot(plot, slot)
				end
			end
		end
	end
	data.Pending += EconomyService.GetIncome(player) * dt
	if Monetization.HasPass(player, "AutoCollect") then
		local amount = math.floor(data.Pending)
		data.Pending -= amount
		EconomyService.AddCash(player, amount)
		if amount > 0 then
			track(player, "Collect", amount) -- Auto Collect zählt fürs "Sammle $X ein"
		end
	end
	Services.PlotService.SetCollectText(plot, data.Pending)
	dirty[player] = true
end

-- Eingefroren (Falle / Admin-Freeze = HumanoidRootPart verankert)? Dann kein Teleport (Home, Laufbänder)
local function isFrozen(player: Player): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root ~= nil and root:IsA("BasePart") and root.Anchored
end

-- Gadget mit Cash kaufen (GadgetService prüft Cash, zieht ab, gibt das Tool)
local function buyGadget(player: Player, id: any): (boolean, string)
	local gadgets = Services.GadgetService
	if type(id) ~= "string" or #id > 40 then
		return false, "Unbekanntes Gadget"
	end
	if not gadgets or type(gadgets.Buy) ~= "function" then
		return false, "🛠️ Gadgets kommen bald!"
	end
	local ok, success, message = pcall(gadgets.Buy, player, id)
	if not ok then
		warn("[EconomyService] Gadget-Kauf fehlgeschlagen: " .. tostring(success))
		return false, "Kauf fehlgeschlagen – versuch es nochmal"
	end
	return success == true, type(message) == "string" and message or ""
end

function EconomyService.Init(services)
	Services = services
end

function EconomyService.Start()
	Services.DataService.OnProfileLoaded(onProfileLoaded)

	-- Anfragen vom Client. Antwort: { Ok, Message, ...Extras } (z.B. Segment beim Glücksrad)
	Remotes.Request.OnServerInvoke = function(player: Player, action: any, arg: any)
		if not requestLimiter.Check(player) then
			return { Ok = false, Message = "Langsam! 🐢" }
		end
		if type(action) ~= "string" then
			return { Ok = false, Message = "Unbekannt" }
		end
		if not readyPlayers[player] then
			return { Ok = false, Message = "Lädt noch... ⏳" }
		end
		local ok, message = false, "Unbekannt"
		local extra: { [string]: any }? = nil
		local rewards = Services.RewardService
		local rewardAction = action == "ClaimGift"
			or action == "Spin"
			or action == "ClaimQuest"
			or action == "RerollQuest"
		if rewardAction and not rewards then
			ok, message = false, "🎁 Belohnungen kommen bald!"
		elseif action == "ClaimGift" then
			ok, message = rewards.ClaimGift(player, arg)
		elseif action == "Spin" then
			ok, message, extra = rewards.Spin(player)
		elseif action == "ClaimQuest" then
			ok, message = rewards.ClaimQuest(player, arg)
		elseif action == "RerollQuest" then
			ok, message = rewards.RerollQuest(player, arg)
		elseif action == "BuyGadget" then
			ok, message = buyGadget(player, arg)
		elseif action == "BuyTreadmill" then
			local treadmill = Services.TreadmillService
			if treadmill and treadmill.Buy then
				local called, success, text = pcall(treadmill.Buy, player, arg)
				if called then
					ok, message = success == true, type(text) == "string" and text or ""
				else
					warn("[EconomyService] Laufband-Kauf fehlgeschlagen: " .. tostring(success))
					ok, message = false, "Kauf fehlgeschlagen – versuch es nochmal"
				end
			else
				ok, message = false, "Laufbänder kommen bald!"
			end
		elseif action == "BuyFloor" then
			ok, message = Services.PlotService.BuyFloor(player)
		elseif action == "BuyBaseLook" then
			ok, message = Services.PlotService.BuyBaseLook(player)
		elseif action == "Rebirth" then
			ok, message = EconomyService.Rebirth(player)
		elseif action == "Daily" then
			ok, message = EconomyService.ClaimDaily(player)
		elseif action == "Collect" then
			-- nur in der eigenen Base (sonst wäre es ein Gratis-"Auto Collect" von überall)
			local plot = Services.PlotService.GetPlot(player)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if plot and root and Services.PlotService.IsInside(plot, root.Position) then
				EconomyService.Collect(player)
				ok, message = true, ""
			else
				ok, message = false, "🏠 Einsammeln geht nur in deiner Base!"
			end
		elseif action == "Home" then
			if Services.CarryService.IsCarrying(player) then
				ok, message = false, "Mit Beute musst du laufen! 🏃"
			elseif isFrozen(player) then
				ok, message = false, "🧊 Du bist eingefroren!"
			else
				Services.PlotService.TeleportHome(player)
				ok, message = true, ""
			end
		elseif action == "Treadmills" then
			if Services.CarryService.IsCarrying(player) then
				ok, message = false, "Mit Beute musst du laufen! 🏃"
			elseif isFrozen(player) then
				ok, message = false, "🧊 Du bist eingefroren!"
			elseif Services.PlotService.TeleportToTreadmills(player) then
				ok, message = true, "🏃 Ab aufs Laufband!"
			else
				ok, message = false, "Kein Charakter"
			end
		elseif action == "GoRun" then
			-- ☄️ Meteor-Run: zum Start-Tor (RunService prüft Tragen, Einfrieren, Charakter)
			local run = Services.RunService
			if run then
				ok, message = run.Teleport(player)
			else
				ok, message = false, "☄️ Der Meteor-Run kommt bald!"
			end
		end
		dirty[player] = true
		local response: { [string]: any } = { Ok = ok, Message = message }
		if extra then
			for key, value in pairs(extra) do
				if response[key] == nil then
					response[key] = value
				end
			end
		end
		return response
	end

	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
		readyPlayers[player] = nil
		sentIndexCount[player] = nil
		sentPasses[player] = nil
		sentStats[player] = nil
		fullStateAt[player] = nil
		requestLimiter.Clear(player)
	end)

	-- Schlüpfen + Einkommen + Aufladen jede Sekunde
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local clock = os.clock()
			local dt = math.clamp(clock - last, 0, 5) -- nach einem Hänger nicht zu viel auf einmal
			last = clock
			for _, player in ipairs(Players:GetPlayers()) do
				local data = Services.DataService.Get(player)
				local plot = Services.PlotService.GetPlot(player)
				if data and plot and readyPlayers[player] then
					local ok, err = pcall(tickPlayer, player, data, plot, dt)
					if not ok then
						warn("[EconomyService] Tick-Fehler bei " .. player.Name .. ": " .. tostring(err))
					end
				end
			end
		end
	end)

	-- Gesammelte Änderungen max. 5x pro Sekunde an die Clients schicken.
	-- Erst eine Liste machen: flush -> RewardService.FillState kann MarkDirty aufrufen (z.B. neue
	-- Tagesaufgaben um Mitternacht) – neue Einträge während pairs(dirty) wären nicht erlaubt.
	local flushList: { Player } = {}
	task.spawn(function()
		while true do
			task.wait(0.2)
			table.clear(flushList)
			for player in pairs(dirty) do
				table.insert(flushList, player)
			end
			table.clear(dirty)
			for _, player in ipairs(flushList) do
				if player.Parent then
					local ok, err = pcall(flush, player)
					if not ok then
						warn("[EconomyService] State-Fehler bei " .. player.Name .. ": " .. tostring(err))
					end
				end
			end
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">FieldService</string>
            <string name="Source"><![CDATA[-- NESTER-FELD (Map-Mitte, MapBuilder: Ordner "NestField"): WILDE KREATUREN + SPEED-PADS
--
-- KREATUREN (Config.Creatures): laufen in ihrem Revier im Feld herum. Kommt ein Spieler zu nah
-- (AggroRange), jagen sie ihn mit festem Tempo (schneller als Grundtempo 16, langsamer als gute
-- Speed-Werte). Treffer = Schubs wie ein Schläger-Treffer (CarryService.CreatureHit), ein getragenes Ei fällt runter.
-- Niemand stirbt. Ziel weg / zu weit weg / aus dem Feld raus -> zurück ins Revier.
-- Nachts mehr und schnellere Kreaturen (NightService.IsNight). Sie verlassen das Feld NIE
-- (Grenzen = Attribute MinX/MaxX/MinZ/MaxZ am Ordner "NestField" -> betreten keine Basen).
--
-- PERFORMANCE: Der Server hat KEINE Teile für die Kreaturen. Er rechnet nur 5x pro Sekunde Positionen
-- (gerade Linien, kein Pathfinding) und schreibt pro Kreatur EIN Text-Attribut "S" an einen Ordner
-- (NestField/Creatures/Creature): "Serverzeit|x|z|vx|vz|Modus" – nur wenn sich etwas ändert.
-- Der Client baut die blockigen Monster lokal und bewegt sie weich (Vorhersage + Glätten).
-- Modus: 0 = herumlaufen, 1 = jagen, 2 = zurück ins Revier, 3 = kurze Pause nach einem Treffer
--
-- SPEED-PADS (Config.SpeedPads): drüberlaufen = Attribut "SpeedPadUntil" am Spieler, EconomyService
-- rechnet das Tempo (+50 %, Deckel MaxSpeed). Die Bewegungs-Prüfung (CarryService.MoveStatus) nimmt das
-- echte WalkSpeed – ein Boost gilt also nicht als Teleport.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local FieldService = {}
local Services

local CREATURES = Config.Creatures
local PADS = Config.SpeedPads

local TICK = 0.2 -- so oft rechnet der Server (Client glättet dazwischen)
local HOME_RADIUS = 35 -- so weit läuft eine Kreatur um ihren Revier-Mittelpunkt
local ROAM_PAUSE_MIN = 1 -- Pause zwischen zwei Wegen (Sekunden)
local ROAM_PAUSE_MAX = 3.5
local ROAM_GIVE_UP = 12 -- spätestens nach so vielen Sekunden ein neues Ziel
local RETURN_SPEED_MULT = 1.4 -- zurück ins Revier etwas schneller als herumlaufen
local HIT_PAUSE = 0.8 -- nach einem Treffer kurz stehen bleiben
local TARGET_MARGIN = 4 -- Spieler zählt bis so weit außerhalb des Reviers noch als Ziel
local MAX_TARGET_HEIGHT = 25 -- wer so hoch ist (Sprung von der Base, fliegen), wird nicht gejagt
local HIT_HEIGHT = 7 -- Treffer nur, wenn auch die Höhe passt
local SEPARATION = 6 -- Kreaturen schieben sich auseinander, wenn sie sich so nah kommen
local PUBLISH_GAP = 1 -- spätestens so oft neu senden (auch ohne Änderung)
local VEL_CHANGE = 0.6 -- Tempo-Änderung, ab der neu gesendet wird
local HIT_NOTIFY_GAP = 12 -- Hinweis "Monster!" höchstens so oft pro Spieler
local PAD_COOLDOWN = 0.4 -- Touched feuert oft: höchstens so oft pro Spieler auswerten
local PAD_REACH = 4 -- HumanoidRootPart höchstens so weit neben dem Pad-Rand (Ping, breite Avatare)
local PAD_MAX_HEIGHT = 9 -- ... und höchstens so hoch darüber (Springen)
local FALLBACK_BOUNDS = { MinX = -29, MaxX = 29, MinZ = -205, MaxZ = 240 }

type Creature = {
	Folder: Folder,
	Pos: Vector3, -- Y immer 0 (Bodenhöhe macht der Client)
	Vel: Vector3,
	Home: Vector3,
	Goal: Vector3?,
	GoalUntil: number,
	WaitUntil: number,
	Target: Player?,
	Mode: number,
	PauseUntil: number,
	AggroAfter: number,
	SentAt: number,
	SentVel: Vector3,
	SentMode: number,
}

local rng = Random.new()
local creatures: { Creature } = {}
local creatureFolder: Folder? = nil
local bounds = table.clone(FALLBACK_BOUNDS)
local hitNotifyAt: { [Player]: number } = {}
local padAt: { [Player]: number } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function isNight(): boolean
	local night = Services.NightService
	return night ~= nil and night.IsNight() == true
end

local function clampToField(pos: Vector3): Vector3
	return Vector3.new(math.clamp(pos.X, bounds.MinX, bounds.MaxX), 0, math.clamp(pos.Z, bounds.MinZ, bounds.MaxZ))
end

-- Revier-Mittelpunkte gleichmäßig über die Länge des Felds verteilen (abwechselnd links/rechts)
local function assignHomes()
	local count = #creatures
	local length = bounds.MaxZ - bounds.MinZ
	for i, creature in ipairs(creatures) do
		local z = bounds.MinZ + (i - 0.5) * length / math.max(1, count)
		local x = (if i % 2 == 0 then 1 else -1) * rng:NextNumber(4, 14)
		creature.Home = clampToField(Vector3.new(x, 0, z))
		if creature.Mode == 0 then
			creature.Goal = nil
		end
	end
end

local function publish(creature: Creature, t: number)
	local pos, vel = creature.Pos, creature.Vel
	creature.Folder:SetAttribute(
		"S",
		string.format("%.3f|%.2f|%.2f|%.2f|%.2f|%d", t, pos.X, pos.Z, vel.X, vel.Z, creature.Mode)
	)
	creature.SentAt = t
	creature.SentVel = vel
	creature.SentMode = creature.Mode
end

local function addCreature(index: number)
	local folder = Instance.new("Folder")
	folder.Name = "Creature"
	folder:SetAttribute("Look", (index - 1) % 3 + 1) -- 3 Farb-Varianten
	local start = clampToField(Vector3.new(rng:NextNumber(-10, 10), 0, rng:NextNumber(bounds.MinZ, bounds.MaxZ)))
	local creature: Creature = {
		Folder = folder,
		Pos = start,
		Vel = Vector3.zero,
		Home = start,
		Goal = nil,
		GoalUntil = 0,
		WaitUntil = 0,
		Target = nil,
		Mode = 0,
		PauseUntil = 0,
		AggroAfter = 0,
		SentAt = 0,
		SentVel = Vector3.zero,
		SentMode = 0,
	}
	publish(creature, now()) -- Attribut VOR dem Parenten -> kommt zusammen beim Client an
	folder.Parent = creatureFolder
	table.insert(creatures, creature)
end

-- Anzahl an Tag/Nacht anpassen (überzählige verschwinden – bevorzugt die, die gerade nicht jagen)
local function updateCount()
	local wanted = math.max(0, math.floor(tonumber(if isNight() then CREATURES.Night else CREATURES.Day) or 0))
	if #creatures == wanted then
		return
	end
	while #creatures < wanted do
		addCreature(#creatures + 1)
	end
	while #creatures > wanted do
		local index = #creatures
		for i = #creatures, 1, -1 do
			if creatures[i].Mode ~= 1 then
				index = i
				break
			end
		end
		local creature = table.remove(creatures, index)
		if creature then
			creature.Folder:Destroy()
		end
	end
	assignHomes()
end

-- Wen darf man jagen? Lebendig, nicht eingefroren, nicht unsichtbar/Gott-Modus, IM Feld (+ Rand)
local function collectTargets(): { { Player: Player, Root: BasePart } }
	local list = {}
	local gadgets = Services.GadgetService
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 and not root.Anchored then
			local pos = root.Position
			local inside = pos.X >= bounds.MinX - TARGET_MARGIN
				and pos.X <= bounds.MaxX + TARGET_MARGIN
				and pos.Z >= bounds.MinZ - TARGET_MARGIN
				and pos.Z <= bounds.MaxZ + TARGET_MARGIN
				and pos.Y < MAX_TARGET_HEIGHT
			local cloaked = gadgets ~= nil and gadgets.IsCloaked(player) == true
			if inside and not cloaked and player:GetAttribute("AdminGod") ~= true then
				table.insert(list, { Player = player, Root = root })
			end
		end
	end
	return list
end

local function flatDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

local function hit(creature: Creature, player: Player, root: BasePart, t: number)
	local away = root.Position - creature.Pos
	local force = tonumber(CREATURES.PushForce) or 60
	local landed = Services.CarryService.CreatureHit(player, away, force)
	creature.Target = nil
	creature.Mode = 3
	creature.PauseUntil = t + HIT_PAUSE
	creature.AggroAfter = t + (tonumber(CREATURES.HitCooldown) or 2.5)
	if landed then
		local clock = os.clock()
		if clock - (hitNotifyAt[player] or -math.huge) >= HIT_NOTIFY_GAP then
			hitNotifyAt[player] = clock
			Services.EconomyService.Notify(player, "👾 Monster! Lauf schneller!", "Error")
		end
	end
end

local function stepCreature(creature: Creature, targets, t: number, dt: number, chaseSpeed: number)
	local pos = creature.Pos
	-- Pause nach einem Treffer
	if creature.Mode == 3 then
		creature.Vel = Vector3.zero
		if t < creature.PauseUntil then
			return
		end
		creature.Mode = 2
	end
	-- Ziel noch gültig?
	local targetRoot: BasePart? = nil
	if creature.Target then
		for _, item in ipairs(targets) do
			if item.Player == creature.Target then
				targetRoot = item.Root
				break
			end
		end
		local lose = tonumber(CREATURES.LoseRange) or 40
		if not targetRoot or flatDistance(targetRoot.Position, pos) > lose then
			creature.Target = nil
			targetRoot = nil
			creature.Mode = 2
		end
	end
	-- neues Ziel: der nächste Spieler in Reichweite
	if not creature.Target and t >= creature.AggroAfter then
		local best = tonumber(CREATURES.AggroRange) or 25
		for _, item in ipairs(targets) do
			local d = flatDistance(item.Root.Position, pos)
			if d < best then
				best = d
				creature.Target = item.Player
				targetRoot = item.Root
			end
		end
		if creature.Target then
			creature.Mode = 1
		end
	end

	local goal: Vector3
	local speed: number
	if creature.Mode == 1 and targetRoot then
		local targetPos = targetRoot.Position
		if
			flatDistance(targetPos, pos) <= (tonumber(CREATURES.HitRange) or 4.5)
			and math.abs(targetPos.Y - 3) < HIT_HEIGHT
		then
			hit(creature, creature.Target :: Player, targetRoot, t)
			creature.Vel = Vector3.zero
			return
		end
		goal = clampToField(targetPos)
		speed = chaseSpeed
	elseif creature.Mode == 2 then
		goal = creature.Home
		speed = (tonumber(CREATURES.RoamSpeed) or 8) * RETURN_SPEED_MULT
		if flatDistance(goal, pos) < 3 then
			creature.Mode = 0
			creature.Goal = nil
			creature.WaitUntil = t + rng:NextNumber(ROAM_PAUSE_MIN, ROAM_PAUSE_MAX)
		end
	else
		creature.Mode = 0
		local roamGoal = creature.Goal
		if roamGoal and (flatDistance(roamGoal, pos) < 1.5 or t > creature.GoalUntil) then
			creature.Goal = nil
			roamGoal = nil
			creature.WaitUntil = t + rng:NextNumber(ROAM_PAUSE_MIN, ROAM_PAUSE_MAX)
		end
		if not roamGoal and t >= creature.WaitUntil then
			local angle = rng:NextNumber() * math.pi * 2
			local radius = math.sqrt(rng:NextNumber()) * HOME_RADIUS
			roamGoal = clampToField(creature.Home + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius))
			creature.Goal = roamGoal
			creature.GoalUntil = t + ROAM_GIVE_UP
		end
		if not roamGoal then
			creature.Vel = Vector3.zero
			return
		end
		goal = roamGoal
		speed = tonumber(CREATURES.RoamSpeed) or 8
	end

	local delta = Vector3.new(goal.X - pos.X, 0, goal.Z - pos.Z)
	local distance = delta.Magnitude
	if distance < 0.05 then
		creature.Vel = Vector3.zero
		return
	end
	local dir = delta / distance
	local stepLength = math.min(speed * dt, distance)
	creature.Pos = clampToField(pos + dir * stepLength)
	creature.Vel = if stepLength < distance then dir * speed else Vector3.zero
end

-- Kreaturen schieben sich sanft auseinander (sonst laufen beim Jagen alle aufeinander)
local function separate()
	for i = 1, #creatures do
		local a = creatures[i]
		for j = i + 1, #creatures do
			local b = creatures[j]
			local offset = Vector3.new(b.Pos.X - a.Pos.X, 0, b.Pos.Z - a.Pos.Z)
			local d = offset.Magnitude
			if d < SEPARATION then
				local push = if d > 0.01 then offset / d else Vector3.new(1, 0, 0)
				local amount = (SEPARATION - d) / 2
				a.Pos = clampToField(a.Pos - push * amount)
				b.Pos = clampToField(b.Pos + push * amount)
			end
		end
	end
end

local function step(dt: number)
	updateCount()
	if #creatures == 0 then
		return
	end
	local t = now()
	local targets = collectTargets()
	local chaseSpeed = tonumber(if isNight() then CREATURES.NightChaseSpeed else CREATURES.ChaseSpeed) or 21
	for _, creature in ipairs(creatures) do
		stepCreature(creature, targets, t, dt, chaseSpeed)
	end
	separate()
	for _, creature in ipairs(creatures) do
		local changed = creature.Mode ~= creature.SentMode
			or (creature.Vel - creature.SentVel).Magnitude > VEL_CHANGE
			or (creature.Vel.Magnitude > 0 and t - creature.SentAt >= PUBLISH_GAP)
			or t - creature.SentAt >= PUBLISH_GAP * 3
		if changed then
			publish(creature, t)
		end
	end
end

-- -------------------------------------------------------------------
-- SPEED-PADS
-- -------------------------------------------------------------------
local function onPadTouched(pad: BasePart, hitPart: BasePart)
	local model = hitPart:FindFirstAncestorOfClass("Model")
	local player = model and Players:GetPlayerFromCharacter(model)
	if not player then
		return
	end
	local humanoid = (model :: Model):FindFirstChildOfClass("Humanoid")
	local root = (model :: Model):FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") or root.Anchored then
		return
	end
	local clock = os.clock()
	if clock < (padAt[player] or 0) then
		return
	end
	-- Touched meldet der Client: nur zählen, wenn der Spieler wirklich auf/über dem Pad steht
	-- (sonst könnte ein Exploit den Boost von überall auslösen)
	local offset = root.Position - pad.Position
	local reach = math.max(pad.Size.X, pad.Size.Z) / 2 + PAD_REACH
	if offset.X * offset.X + offset.Z * offset.Z > reach * reach or offset.Y > PAD_MAX_HEIGHT or offset.Y < -2 then
		return
	end
	padAt[player] = clock + PAD_COOLDOWN
	local duration = math.clamp(tonumber(PADS.Duration) or 3, 0.5, 30)
	player:SetAttribute("SpeedPadUntil", now() + duration)
	Services.EconomyService.ApplySpeed(player)
	task.delay(duration + 0.05, function()
		if player.Parent and (tonumber(player:GetAttribute("SpeedPadUntil")) or 0) <= now() then
			Services.EconomyService.ApplySpeed(player)
		end
	end)
end

function FieldService.Init(services)
	Services = services
	local map = Services.PlotService.MapFolder
	local field = map and map:FindFirstChild("NestField")
	if not field then
		warn("[FieldService] Kein Nester-Feld gefunden – keine Kreaturen, keine Speed-Pads")
		return
	end
	for key in pairs(FALLBACK_BOUNDS) do
		local value = tonumber(field:GetAttribute(key))
		if value then
			bounds[key] = value
		end
	end
	local existing = field:FindFirstChild("Creatures")
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Creatures" -- Name wird vom Client gesucht!
	folder.Parent = field
	creatureFolder = folder

	local pads = field:FindFirstChild("SpeedPads")
	if pads then
		for _, pad in ipairs(pads:GetChildren()) do
			if pad:IsA("BasePart") then
				pad.Touched:Connect(function(hitPart)
					onPadTouched(pad, hitPart)
				end)
			end
		end
	end
end

function FieldService.Start()
	if not creatureFolder then
		return
	end
	Players.PlayerRemoving:Connect(function(player)
		hitNotifyAt[player] = nil
		padAt[player] = nil
	end)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(TICK)
			local clock = os.clock()
			local dt = math.min(clock - last, 0.5)
			last = clock
			if #Players:GetPlayers() > 0 then
				local ok, err = pcall(step, dt)
				if not ok then
					warn("[FieldService] Fehler: " .. tostring(err))
					task.wait(1)
				end
			end
		end
	end)
end

return FieldService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">GadgetService</string>
            <string name="Source"><![CDATA[-- GADGETS: mit Cash im Shop kaufen (Config.Gadgets). Sie gehören einem für immer (data.Gadgets,
-- bleibt bei Rebirth) und liegen nach jedem Spawn als Werkzeug im Rucksack:
--   🌀 Speed Coil – solange in der Hand: +30% Tempo (EconomyService.ApplySpeed fragt SpeedBonus)
--   🪤 Falle      – Klick in der EIGENEN Base: Falle am Boden, auch auf Stockwerken (max. Config.MaxTrapsPerBase).
--                   Fremde frieren Config.TrapFreezeTime Sekunden ein, getragene Beute ist weg.
--   🔨 Super-Bonk – kein eigenes Werkzeug: Boost für den Schläger (mehr Reichweite + Wucht, schneller;
--                   Schlag-Logik in CarryService)
--   👻 Umhang     – Klick: Config.CloakDuration Sekunden unsichtbar und nicht bonkbar,
--                   danach Config.CloakCooldown Sekunden Abklingzeit (ab dem Sichtbarwerden).
--                   Wer klaut, wird sofort sichtbar (CarryService), mit Beute geht er nicht an.
-- Alles wird hier auf dem Server geprüft und gebremst (Klicks kommen vom Client).
-- Fallen lösen über Touched UND über eine eigene Server-Prüfung aus (Touched meldet der Client –
-- wer das lokal abschaltet, läuft trotzdem nicht einfach drüber).

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local GadgetService = {}
local Services

local useLimiter = Util.RateLimiter(4, 1) -- Werkzeug-Klicks pro Sekunde (Falle, Umhang)
local SYNC_INTERVAL = 2 -- so oft wird geprüft, ob jeder seine Werkzeuge hat
local TRAP_PLACE_COOLDOWN = 1 -- Sekunden zwischen zwei Fallen
local TRAP_SIZE = 4.5
local TRAP_HEIGHT = 0.6 -- so hoch, dass Füße beim Drüberlaufen sicher die Falle berühren
local TRAP_EDGE_MARGIN = TRAP_SIZE / 2 + 1 -- Fallen-Mitte so weit innerhalb der Base (nichts ragt raus)
local TRAP_IMMUNE_EXTRA = 5 -- nach dem Auftauen so viele Sekunden immun (keine Endlos-Falle)
local TRAP_CHECK_INTERVAL = 0.2 -- so oft prüft der Server selbst, ob jemand auf einer Falle steht
local TRAP_REACH = TRAP_SIZE / 2 + 1 -- waagrechter Abstand Fallen-Mitte <-> HumanoidRootPart
local TRAP_MAX_HEIGHT = 5 -- so hoch über der Falle zählt der HumanoidRootPart noch als "draufgetreten"

-- Werkzeug-Namen im Rucksack (Super-Bonk hat kein Werkzeug, er verstärkt den Schläger)
local TOOL_NAMES = {
	SpeedCoil = "Speed Coil",
	Trap = "Falle",
	Cloak = "Umhang",
}

-- Fallen pro Besitzer (eine Base pro Spieler): [player] = { Falle, ... }
local trapsByOwner: { [Player]: { BasePart } } = {}
local trapPlacedAt: { [Player]: number } = {}
local trapImmuneUntil: { [Player]: number } = {} -- gerade aus einer Falle aufgetaut -> kurz immun
-- Umhang: [player] = { Character, Changed = { [Instance] = alte Transparenz }, Conn, ... }
type CloakState = {
	Character: Model,
	Changed: { [Instance]: number },
	Conn: RBXScriptConnection,
	Humanoid: Humanoid?,
	DisplayType: Enum.HumanoidDisplayDistanceType?,
}
local cloaks: { [Player]: CloakState } = {}
local cloakReadyAt: { [Player]: number } = {}
local freezeToken = 0
local templates: { [string]: Tool } = {}

-- -------------------------------------------------------------------
-- BESITZ
-- -------------------------------------------------------------------
local function gadgetTable(data): { [string]: boolean }
	if type(data.Gadgets) ~= "table" then
		data.Gadgets = {} -- alter Spielstand ohne Gadgets
	end
	return data.Gadgets
end

function GadgetService.Owns(player: Player, id: string): boolean
	local data = Services.DataService.Get(player)
	if not data or type(data.Gadgets) ~= "table" then
		return false
	end
	return data.Gadgets[id] == true
end

-- Alle Gadget-Ids, die der Spieler besitzt (Reihenfolge wie in Config.Gadgets)
function GadgetService.OwnedList(player: Player): { string }
	local list = {}
	for _, gadget in ipairs(Config.Gadgets) do
		if GadgetService.Owns(player, gadget.Id) then
			table.insert(list, gadget.Id)
		end
	end
	return list
end

local function aliveCharacter(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not humanoid or humanoid.Health <= 0 or not root then
		return nil, nil, nil
	end
	return character, humanoid, root
end

-- Gadget-Werkzeug (Attribut "Gadget") im Rucksack oder in der Hand?
local function findGadgetTool(container: Instance?, id: string): Tool?
	if not container then
		return nil
	end
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Tool") and child:GetAttribute("Gadget") == id then
			return child
		end
	end
	return nil
end

-- -------------------------------------------------------------------
-- 🌀 SPEED COIL
-- -------------------------------------------------------------------
-- Faktor für die Laufgeschwindigkeit: 1.3 solange die Speed Coil in der Hand ist, sonst 1
function GadgetService.SpeedBonus(player: Player): number
	local character = player.Character
	if character and findGadgetTool(character, "SpeedCoil") and GadgetService.Owns(player, "SpeedCoil") then
		return 1 + Config.SpeedCoilBonus
	end
	return 1
end

-- -------------------------------------------------------------------
-- 🪤 FALLE
-- -------------------------------------------------------------------
local function trapList(player: Player): { BasePart }
	local list = trapsByOwner[player]
	if not list then
		list = {}
		trapsByOwner[player] = list
	end
	for i = #list, 1, -1 do
		if not list[i].Parent then
			table.remove(list, i) -- schon ausgelöst oder mit der Base weg
		end
	end
	return list
end

-- Boden unter den Füßen (nur begehbare Teile, Spieler ignorieren)
local function floorBelow(position: Vector3): (Vector3?, BasePart?)
	local ignore: { Instance } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	local result = workspace:Raycast(position, Vector3.new(0, -12, 0), params)
	if not result then
		return nil, nil
	end
	local hit = result.Instance
	return result.Position, if hit:IsA("BasePart") then hit else nil
end

-- Kurzer Eisblock um den Eingefrorenen (nur Optik)
local function iceEffect(root: BasePart, seconds: number)
	local ice = Instance.new("Part")
	ice.Name = "TrapIce"
	ice.Size = Vector3.new(4.5, 6.5, 4.5)
	ice.CFrame = root.CFrame * CFrame.new(0, -0.4, 0)
	ice.Anchored = true
	ice.CanCollide = false
	ice.CanQuery = false
	ice.CanTouch = false
	ice.CastShadow = false
	ice.Material = Enum.Material.Glass
	ice.Color = Color3.fromRGB(160, 225, 255)
	ice.Transparency = 0.45
	ice.Parent = workspace
	Debris:AddItem(ice, seconds)
end

-- Friert einen Spieler ein (HumanoidRootPart verankert) und taut ihn danach wieder auf.
-- Ein Admin-Freeze in der Zwischenzeit löscht das Attribut -> wird dann nicht aufgetaut.
local function freeze(root: BasePart, seconds: number)
	freezeToken += 1
	local token = freezeToken
	root:SetAttribute("TrapFreeze", token)
	root.Anchored = true
	iceEffect(root, seconds)
	task.delay(seconds, function()
		if root.Parent and root:GetAttribute("TrapFreeze") == token then
			root:SetAttribute("TrapFreeze", nil)
			root.Anchored = false
		end
	end)
end

-- Falle schnappt zu (über Touched oder die Server-Prüfung). Nur für Fremde, die IN der Base des
-- Besitzers stehen (wer am Eingang vorbeiläuft, wird nicht erwischt) und nicht gerade erst aufgetaut sind.
local function springTrap(owner: Player, trap: BasePart, victim: Player)
	if trap:GetAttribute("Sprung") == true or not trap.Parent or victim == owner then
		return
	end
	if victim:GetAttribute("AdminGod") == true then
		return -- Admin-Gott-Modus: Fallen schnappen nicht zu
	end
	if os.clock() < (trapImmuneUntil[victim] or 0) then
		return
	end
	local _, humanoid, root = aliveCharacter(victim)
	local plot = Services.PlotService.GetPlot(owner)
	if not humanoid or not root or not plot or not Services.PlotService.IsInside(plot, root.Position) then
		return
	end
	trap:SetAttribute("Sprung", true)
	trap:Destroy()
	trapImmuneUntil[victim] = os.clock() + Config.TrapFreezeTime + TRAP_IMMUNE_EXTRA
	if not root.Anchored then
		freeze(root, Config.TrapFreezeTime) -- (schon vom Admin eingefroren -> so lassen)
	end
	if Services.CarryService.IsCarrying(victim) then
		Services.CarryService.Fail(victim, "trap") -- Beute aus der Base fliegt zurück, Eier fallen runter
	end
	Services.EconomyService.Effect(victim, "Shake", 0.8)
	Services.EconomyService.Notify(
		victim,
		"🪤 FALLE! Du bist " .. Config.TrapFreezeTime .. " Sekunden eingefroren!",
		"Error"
	)
	Services.EconomyService.Notify(owner, "🪤 " .. victim.DisplayName .. " ist in deine Falle getappt!", "Success")
end

local function onTrapTouched(owner: Player, trap: BasePart, hit: BasePart)
	local character = hit:FindFirstAncestorOfClass("Model")
	local victim = character and Players:GetPlayerFromCharacter(character)
	if victim and victim.Character == character then
		springTrap(owner, trap, victim)
	end
end

-- Server-Prüfung (alle TRAP_CHECK_INTERVAL Sekunden): steht ein Fremder auf einer Falle?
local function checkTraps()
	for owner, list in pairs(trapsByOwner) do
		for _, trap in ipairs(list) do
			if trap.Parent and trap:GetAttribute("Sprung") ~= true then
				local center = trap.Position
				for _, victim in ipairs(Players:GetPlayers()) do
					local character = victim.Character
					local root = character and character:FindFirstChild("HumanoidRootPart")
					if victim ~= owner and root and root:IsA("BasePart") then
						local offset = root.Position - center
						local flatSq = offset.X * offset.X + offset.Z * offset.Z
						if flatSq <= TRAP_REACH * TRAP_REACH and offset.Y > -1 and offset.Y < TRAP_MAX_HEIGHT then
							springTrap(owner, trap, victim)
							if trap:GetAttribute("Sprung") == true then
								break
							end
						end
					end
				end
			end
		end
	end
end

local function buildTrap(position: Vector3): BasePart
	local trap = Instance.new("Part")
	trap.Name = "Trap"
	trap.Shape = Enum.PartType.Cylinder
	trap.Size = Vector3.new(TRAP_HEIGHT, TRAP_SIZE, TRAP_SIZE)
	trap.CFrame = CFrame.new(position + Vector3.new(0, TRAP_HEIGHT / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	trap.Anchored = true
	trap.CanCollide = false
	trap.CanQuery = false
	trap.CanTouch = true
	trap.CastShadow = false
	trap.Material = Enum.Material.DiamondPlate
	trap.Color = Color3.fromRGB(70, 70, 80)

	-- Leuchtring + Zähne (nur Optik)
	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(TRAP_HEIGHT + 0.05, TRAP_SIZE * 0.7, TRAP_SIZE * 0.7)
	ring.CFrame = trap.CFrame
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 60, 60)
	ring.Parent = trap
	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2
		local tooth = Instance.new("Part")
		tooth.Name = "Tooth"
		tooth.Size = Vector3.new(0.3, 0.7, 0.3)
		tooth.CFrame = CFrame.new(
			position
				+ Vector3.new(math.cos(angle) * TRAP_SIZE * 0.42, TRAP_HEIGHT + 0.3, math.sin(angle) * TRAP_SIZE * 0.42)
		)
		tooth.Anchored = true
		tooth.CanCollide = false
		tooth.CanQuery = false
		tooth.CanTouch = false
		tooth.CastShadow = false
		tooth.Material = Enum.Material.Metal
		tooth.Color = Color3.fromRGB(210, 210, 220)
		tooth.Parent = trap
	end
	return trap
end

local function placeTrap(player: Player)
	if not useLimiter.Check(player) or not GadgetService.Owns(player, "Trap") then
		return
	end
	local t = os.clock()
	if t - (trapPlacedAt[player] or -math.huge) < TRAP_PLACE_COOLDOWN then
		return
	end
	local _, _, root = aliveCharacter(player)
	local plot = Services.PlotService.GetPlot(player)
	if not root or not plot then
		return
	end
	if not Services.PlotService.IsInside(plot, root.Position) then
		Services.EconomyService.Notify(player, "🪤 Fallen kannst du nur in deiner eigenen Base aufstellen!", "Error")
		return
	end
	local list = trapList(player)
	if #list >= Config.MaxTrapsPerBase then
		Services.EconomyService.Notify(
			player,
			"🪤 Schon " .. Config.MaxTrapsPerBase .. " Fallen aufgestellt – mehr gehen nicht!",
			"Error"
		)
		return
	end
	local floor, floorPart = floorBelow(root.Position)
	if not floor or not Services.PlotService.IsInside(plot, floor) then
		return
	end
	-- Nur direkt auf einen Boden der eigenen Base (Erdgeschoss oder Stockwerk, Attribut "BaseFloor"),
	-- nicht auf Baumstamm, Laterne, Treppe oder Rand
	if
		not floorPart
		or floorPart:GetAttribute("BaseFloor") ~= true
		or not floorPart:IsDescendantOf(plot.Model)
		or math.abs(floor.Y - (floorPart.Position.Y + floorPart.Size.Y / 2)) > 0.5
	then
		Services.EconomyService.Notify(player, "🪤 Stell die Falle auf den Boden deiner Base!", "Error")
		return
	end
	-- Die ganze Falle muss auf diesem Boden liegen (am Rand würde sie vor den Eingang / übers Stockwerk ragen)
	-- (Rand innen: 1 Stud dick -> mit TRAP_EDGE_MARGIN steht die Falle nie im Rand)
	local localFloor = floorPart.CFrame:PointToObjectSpace(floor)
	local hx, hz = floorPart.Size.X / 2, floorPart.Size.Z / 2
	if math.abs(localFloor.X) > hx - TRAP_EDGE_MARGIN or math.abs(localFloor.Z) > hz - TRAP_EDGE_MARGIN then
		Services.EconomyService.Notify(player, "🪤 Zu nah am Rand – stell die Falle weiter innen auf!", "Error")
		return
	end
	trapPlacedAt[player] = t
	local folder = plot.Model:FindFirstChild("Traps")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Traps"
		folder.Parent = plot.Model
	end
	local trap = buildTrap(floor)
	trap:SetAttribute("OwnerUserId", player.UserId)
	trap.Touched:Connect(function(hit)
		onTrapTouched(player, trap, hit)
	end)
	trap.Parent = folder
	table.insert(list, trap)
	Services.EconomyService.Notify(
		player,
		"🪤 Falle aufgestellt! (" .. #list .. "/" .. Config.MaxTrapsPerBase .. ")",
		"Success"
	)
end

local function clearTraps(player: Player)
	local list = trapsByOwner[player]
	if list then
		for _, trap in ipairs(list) do
			trap:Destroy()
		end
	end
	trapsByOwner[player] = nil
end

-- -------------------------------------------------------------------
-- 👻 UMHANG
-- -------------------------------------------------------------------
function GadgetService.IsCloaked(player: Player): boolean
	return cloaks[player] ~= nil
end

-- Die getragene Beute bleibt sichtbar (man sieht ein schwebendes Ei – bonken geht trotzdem nicht)
local function isCarriedLoot(inst: Instance): boolean
	return inst:FindFirstAncestor("CarriedMeteor") ~= nil
		or inst:FindFirstAncestor("CarriedAlien") ~= nil
		or inst.Name == "CarriedMeteor"
end

local function hide(state: CloakState, inst: Instance)
	if state.Changed[inst] ~= nil or isCarriedLoot(inst) then
		return
	end
	if inst:IsA("BasePart") or inst:IsA("Decal") then
		local item = inst :: any -- beide haben Transparency
		state.Changed[inst] = item.Transparency
		item.Transparency = 1
	end
end

local function setOverheadTag(character: Model)
	local head = character:FindFirstChild("Head")
	local tag = head and head:FindFirstChild("OverheadTag")
	if head and head:IsA("BasePart") and tag and tag:IsA("BillboardGui") then
		tag.Enabled = head.Transparency < 1
	end
end

-- Umhang beenden (Zeit um, Klauen, Respawn, Admin-Unsichtbar). Die Abklingzeit zählt ab JETZT.
-- silent = keine Nachricht
local function endCloak(player: Player, silent: boolean?)
	local state = cloaks[player]
	if not state then
		return
	end
	cloaks[player] = nil
	cloakReadyAt[player] = os.clock() + Config.CloakCooldown
	state.Conn:Disconnect()
	for inst, transparency in pairs(state.Changed) do
		if inst.Parent then
			(inst :: any).Transparency = transparency
		end
	end
	local humanoid = state.Humanoid
	if humanoid and humanoid.Parent and state.DisplayType then
		humanoid.DisplayDistanceType = state.DisplayType
	end
	setOverheadTag(state.Character)
	if player.Parent then
		player:SetAttribute("CloakedUntil", nil)
	end
	if not silent then
		Services.EconomyService.Notify(
			player,
			"👻 Du bist wieder sichtbar! (Umhang lädt " .. Config.CloakCooldown .. " s)",
			"Info"
		)
	end
end
GadgetService.EndCloak = endCloak

local function activateCloak(player: Player)
	if not useLimiter.Check(player) or not GadgetService.Owns(player, "Cloak") then
		return
	end
	if cloaks[player] then
		return -- schon unsichtbar
	end
	local t = os.clock()
	local readyAt = cloakReadyAt[player] or 0
	if t < readyAt then
		Services.EconomyService.Notify(player, "👻 Umhang lädt noch " .. math.ceil(readyAt - t) .. " s", "Error")
		return
	end
	if Services.CarryService.IsCarrying(player) then
		Services.EconomyService.Notify(player, "👻 Mit Beute geht der Umhang nicht – erst heimbringen!", "Error")
		return
	end
	local character, humanoid = aliveCharacter(player)
	if not character or not humanoid then
		return
	end
	-- (falls endCloak nie kommt, z.B. Fehler: spätestens dann wieder bereit)
	cloakReadyAt[player] = t + Config.CloakDuration + Config.CloakCooldown
	local state: CloakState = {
		Character = character,
		Changed = {},
		Conn = (nil :: any) :: RBXScriptConnection,
		Humanoid = humanoid,
		DisplayType = humanoid.DisplayDistanceType,
	}
	for _, inst in ipairs(character:GetDescendants()) do
		hide(state, inst)
	end
	-- Neu dazukommende Teile (Werkzeug in die Hand genommen ...) auch verstecken
	state.Conn = character.DescendantAdded:Connect(function(inst)
		hide(state, inst)
	end)
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	setOverheadTag(character)
	cloaks[player] = state
	player:SetAttribute("CloakedUntil", workspace:GetServerTimeNow() + Config.CloakDuration)
	Services.EconomyService.Notify(
		player,
		"👻 " .. Config.CloakDuration .. " s unsichtbar – niemand kann dich treffen! (Klauen macht sichtbar)",
		"Success"
	)
	task.delay(Config.CloakDuration, function()
		if cloaks[player] == state then
			endCloak(player)
		end
	end)
end

-- -------------------------------------------------------------------
-- WERKZEUGE
-- -------------------------------------------------------------------
local function weld(part0: BasePart, part1: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = part0
	w.Part1 = part1
	w.Parent = part1
end

local function toolPart(tool: Tool, name: string, size: Vector3, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.Massless = true
	p.CastShadow = false
	p.Parent = tool
	return p
end

local function newTool(id: string, tip: string): Tool
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAMES[id] or id
	tool.ToolTip = tip
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("Gadget", id)
	return tool
end

local function buildTemplates()
	-- 🌀 Speed Coil: Griff mit leuchtenden Spiralringen
	local coil = newTool("SpeedCoil", "🌀 +30% Tempo, solange du sie hältst")
	local coilHandle =
		toolPart(coil, "Handle", Vector3.new(0.5, 2.2, 0.5), Color3.fromRGB(60, 60, 75), Enum.Material.Metal)
	for i = 1, 4 do
		local ring =
			toolPart(coil, "Ring", Vector3.new(0.25, 1.1, 1.1), Color3.fromRGB(0, 230, 255), Enum.Material.Neon)
		ring.Shape = Enum.PartType.Cylinder
		ring.CFrame = coilHandle.CFrame * CFrame.new(0, -0.8 + i * 0.4, 0) * CFrame.Angles(0, 0, math.rad(90))
		weld(coilHandle, ring)
	end
	coil.Grip = CFrame.new(0, -0.4, 0)
	templates.SpeedCoil = coil

	-- 🪤 Falle: kleine Falle in der Hand
	local trapTool = newTool("Trap", "🪤 Klick in deiner Base = Falle aufstellen")
	local trapHandle =
		toolPart(trapTool, "Handle", Vector3.new(0.4, 1.6, 1.6), Color3.fromRGB(70, 70, 80), Enum.Material.DiamondPlate)
	trapHandle.Shape = Enum.PartType.Cylinder
	local trapRing =
		toolPart(trapTool, "Ring", Vector3.new(0.45, 1.1, 1.1), Color3.fromRGB(255, 60, 60), Enum.Material.Neon)
	trapRing.Shape = Enum.PartType.Cylinder
	trapRing.CFrame = trapHandle.CFrame
	weld(trapHandle, trapRing)
	trapTool.Grip = CFrame.new(0, 0, -0.6) * CFrame.Angles(0, 0, math.rad(90))
	templates.Trap = trapTool

	-- 👻 Umhang: lila Stoffbündel
	local cloak = newTool("Cloak", "👻 Klick = unsichtbar (Abklingzeit beachten)")
	local cloakHandle =
		toolPart(cloak, "Handle", Vector3.new(1.2, 1.4, 0.5), Color3.fromRGB(120, 60, 200), Enum.Material.Fabric)
	local cloakGlow =
		toolPart(cloak, "Glow", Vector3.new(1.3, 0.2, 0.6), Color3.fromRGB(200, 150, 255), Enum.Material.Neon)
	cloakGlow.CFrame = cloakHandle.CFrame * CFrame.new(0, 0.6, 0)
	weld(cloakHandle, cloakGlow)
	templates.Cloak = cloak
end

-- Gibt das Werkzeug eines Gadgets (ohne Doppelte). Super-Bonk hat keins (Boost für den Schläger).
local function giveGadgetTool(player: Player, id: string)
	if id == "SuperBonk" then
		Services.CarryService.GiveBat(player) -- (Schläger bleibt derselbe, schlägt jetzt stärker)
		return
	end
	local template = templates[id]
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not template or not backpack then
		return
	end
	if findGadgetTool(backpack, id) or findGadgetTool(player.Character, id) then
		return
	end
	local tool = template:Clone()
	if id == "Trap" then
		tool.Activated:Connect(function()
			placeTrap(player)
		end)
	elseif id == "Cloak" then
		tool.Activated:Connect(function()
			activateCloak(player)
		end)
	elseif id == "SpeedCoil" then
		-- In die Hand nehmen / weglegen -> Tempo neu berechnen
		tool.AncestryChanged:Connect(function()
			Services.EconomyService.ApplySpeed(player)
		end)
	end
	tool.Parent = backpack
end

-- Alle besessenen Gadgets als Werkzeug geben, nicht (mehr) besessene wegnehmen (z.B. nach Reset)
function GadgetService.GiveTools(player: Player)
	local character, humanoid = aliveCharacter(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not character or not humanoid or not backpack or not Services.DataService.Get(player) then
		return
	end
	for _, gadget in ipairs(Config.Gadgets) do
		if GadgetService.Owns(player, gadget.Id) then
			giveGadgetTool(player, gadget.Id)
		else
			for _, container in ipairs({ backpack, character }) do
				local tool = findGadgetTool(container, gadget.Id)
				if tool then
					tool:Destroy()
				end
			end
		end
	end
	Services.CarryService.GiveBat(player) -- bester freigeschalteter Schläger (nie doppelt)
end

-- -------------------------------------------------------------------
-- KAUFEN / SCHENKEN
-- -------------------------------------------------------------------
-- Kauf mit Cash (Shop -> Request "BuyGadget"). Gibt (Erfolg, Nachricht) zurück.
function GadgetService.Buy(player: Player, id: any): (boolean, string)
	local gadget = type(id) == "string" and Config.GadgetsById[id] or nil
	if not gadget then
		return false, "Unbekanntes Gadget"
	end
	local data = Services.DataService.Get(player)
	if not data or not Services.EconomyService.IsReady(player) then
		return false, "Lädt noch... ⏳"
	end
	local owned = gadgetTable(data)
	if owned[gadget.Id] then
		return false, "✅ " .. gadget.Name .. " hast du schon!"
	end
	if data.Cash < gadget.Price then
		return false, "💸 Du brauchst " .. Util.FormatCash(gadget.Price) .. " für " .. gadget.Name .. "!"
	end
	data.Cash -= gadget.Price
	owned[gadget.Id] = true
	Services.EconomyService.MarkDirty(player)
	task.spawn(Services.DataService.Save, player) -- teurer Kauf -> gleich sichern
	giveGadgetTool(player, gadget.Id)
	Services.EconomyService.Effect(player, "Confetti", 1)
	if gadget.Id == "SuperBonk" then
		return true, gadget.Name .. " gekauft! Dein Schläger ist jetzt stärker."
	end
	return true, gadget.Icon .. " " .. gadget.Name .. " gekauft! Liegt in deinem Rucksack."
end

-- Geschenk (Admin, Starter-Paket): gehört dem Spieler danach für immer. true = hat geklappt
function GadgetService.Give(player: Player, id: any): boolean
	local gadget = type(id) == "string" and Config.GadgetsById[id] or nil
	local data = Services.DataService.Get(player)
	if not gadget or not data then
		return false
	end
	gadgetTable(data)[gadget.Id] = true
	Services.EconomyService.MarkDirty(player)
	giveGadgetTool(player, gadget.Id)
	return true
end
GadgetService.Grant = GadgetService.Give

-- -------------------------------------------------------------------
function GadgetService.Init(services)
	Services = services
	buildTemplates()
end

function GadgetService.Start()
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function()
			endCloak(player, true) -- neuer Charakter ist sowieso sichtbar
			if player:WaitForChild("Backpack", 10) then
				GadgetService.GiveTools(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end
	-- Spielstand geladen -> gekaufte Gadgets sofort geben (nicht erst nach dem nächsten Spawn)
	Services.DataService.OnProfileLoaded(function(player: Player)
		GadgetService.GiveTools(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		endCloak(player, true)
		clearTraps(player)
		cloakReadyAt[player] = nil
		trapPlacedAt[player] = nil
		trapImmuneUntil[player] = nil
		useLimiter.Clear(player)
	end)

	-- Fallen selbst prüfen (Touched allein reicht nicht – das meldet der Client)
	task.spawn(function()
		while true do
			task.wait(TRAP_CHECK_INTERVAL)
			local ok, err = pcall(checkTraps)
			if not ok then
				warn("[GadgetService] Fallen-Prüfung: " .. tostring(err))
			end
		end
	end)

	-- Sicherheitsnetz: fehlende Werkzeuge nachreichen (z.B. Gadget per Spielstand geschenkt)
	task.spawn(function()
		while true do
			task.wait(SYNC_INTERVAL)
			for _, player in ipairs(Players:GetPlayers()) do
				local ok, err = pcall(GadgetService.GiveTools, player)
				if not ok then
					warn("[GadgetService] Werkzeuge für " .. player.Name .. ": " .. tostring(err))
				end
			end
		end
	end)
end

return GadgetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">GraphicsService</string>
            <string name="Source"><![CDATA[-- Grafik: helles, sattes Sonnenlicht wie in Simulator-Spielen.
-- Licht, Atmosphäre, Bloom (dezent), Sonnenstrahlen, Farbkorrektur, Himmel und Wolken.
-- Hinweis: Lighting.Technology = "Future" und Workspace.StreamingEnabled = false stehen in
-- default.project.json – Technology kann ein Script im laufenden Spiel nicht umstellen.
-- Wird in Main.server.luau VOR PlotService geladen.
--
-- NACHT: GraphicsService.SetNight(isNight, bloodMoon?, fadeTime?) blendet weich zwischen Tag und
-- Nacht um (Uhrzeit, Licht, Atmosphäre, Wolken, Farbton). Nachts sind Mond und Sterne zu sehen und die
-- Laternen der Basen leuchten (PointLight "NightLight"). Blutmond = roter Himmel.
-- Wann es Nacht wird, entscheidet NightService (Config.Night).

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local GraphicsService = {}

-- Uhrzeit: Tag 14 Uhr, Nacht kurz vor Mitternacht (Mond + Sterne)
local DAY_CLOCK = 14
local NIGHT_CLOCK = 23.9
local LANTERN_RANGE = 24
local LANTERN_BRIGHTNESS = 1.8
local LANTERN_COLOR = Color3.fromRGB(255, 210, 130)

-- Aussehen je Tageszeit (Lighting, Atmosphäre, Farbkorrektur, Wolken)
type Look = {
	Lighting: { [string]: any },
	Atmosphere: { [string]: any },
	Color: { [string]: any },
	Clouds: { [string]: any },
}
local LOOKS: { [string]: Look } = {
	Day = {
		Lighting = {
			Brightness = 2.5,
			Ambient = Color3.fromRGB(45, 45, 55),
			OutdoorAmbient = Color3.fromRGB(135, 135, 150),
			ColorShift_Top = Color3.fromRGB(255, 248, 235),
			ExposureCompensation = 0,
		},
		Atmosphere = {
			Density = 0.27,
			Color = Color3.fromRGB(200, 225, 255),
			Decay = Color3.fromRGB(120, 160, 220),
			Glare = 0.15,
			Haze = 0.8,
		},
		Color = { TintColor = Color3.new(1, 1, 1), Saturation = 0.2 },
		Clouds = { Cover = 0.55, Color = Color3.new(1, 1, 1) },
	},
	Night = {
		Lighting = {
			Brightness = 1.2,
			Ambient = Color3.fromRGB(50, 55, 90),
			OutdoorAmbient = Color3.fromRGB(90, 100, 150),
			ColorShift_Top = Color3.fromRGB(170, 190, 255),
			ExposureCompensation = 0.25,
		},
		Atmosphere = {
			Density = 0.32,
			Color = Color3.fromRGB(70, 80, 130),
			Decay = Color3.fromRGB(30, 35, 80),
			Glare = 0,
			Haze = 1.2,
		},
		Color = { TintColor = Color3.fromRGB(215, 225, 255), Saturation = 0.1 },
		Clouds = { Cover = 0.3, Color = Color3.fromRGB(70, 75, 110) },
	},
	Blood = {
		Lighting = {
			Brightness = 1.4,
			Ambient = Color3.fromRGB(95, 35, 40),
			OutdoorAmbient = Color3.fromRGB(150, 70, 70),
			ColorShift_Top = Color3.fromRGB(255, 120, 110),
			ExposureCompensation = 0.25,
		},
		Atmosphere = {
			Density = 0.34,
			Color = Color3.fromRGB(170, 50, 50),
			Decay = Color3.fromRGB(90, 10, 20),
			Glare = 0.1,
			Haze = 1.5,
		},
		Color = { TintColor = Color3.fromRGB(255, 185, 180), Saturation = 0.15 },
		Clouds = { Cover = 0.35, Color = Color3.fromRGB(120, 40, 45) },
	},
}

local lookName = "Day"
local running: { Tween } = {}

-- Diese Effekte bauen wir selbst -> alte/doppelte Versionen vorher entfernen (sonst addieren sie sich)
local OWN_CLASSES = { "Atmosphere", "Sky", "BloomEffect", "SunRaysEffect", "ColorCorrectionEffect" }

local function clearOld()
	for _, child in ipairs(Lighting:GetChildren()) do
		if table.find(OWN_CLASSES, child.ClassName) then
			child:Destroy()
		end
	end
end

local function applyLighting()
	Lighting.ClockTime = 14 -- Nachmittag: Sonne hoch, kurze Schatten
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 2.5
	Lighting.ExposureCompensation = 0
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.Ambient = Color3.fromRGB(45, 45, 55)
	Lighting.OutdoorAmbient = Color3.fromRGB(135, 135, 150)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 248, 235) -- leicht warmes Sonnenlicht
	Lighting.ColorShift_Bottom = Color3.new(0, 0, 0)
end

local function buildEffects()
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "MH_Atmosphere"
	atmosphere.Density = 0.27
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(200, 225, 255)
	atmosphere.Decay = Color3.fromRGB(120, 160, 220)
	atmosphere.Glare = 0.15
	atmosphere.Haze = 0.8
	atmosphere.Parent = Lighting

	local sky = Instance.new("Sky") -- Standard-Himmel von Roblox (blau mit Wolken)
	sky.Name = "MH_Sky"
	sky.SunAngularSize = 16
	sky.MoonAngularSize = 11
	sky.StarCount = 3000
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting

	local bloom = Instance.new("BloomEffect") -- dezent: nur Neon leuchtet etwas über
	bloom.Name = "MH_Bloom"
	bloom.Intensity = 0.6
	bloom.Size = 24
	bloom.Threshold = 1.8
	bloom.Parent = Lighting

	local sunRays = Instance.new("SunRaysEffect")
	sunRays.Name = "MH_SunRays"
	sunRays.Intensity = 0.05
	sunRays.Spread = 0.7
	sunRays.Parent = Lighting

	local colorCorrection = Instance.new("ColorCorrectionEffect") -- knalligere Farben
	colorCorrection.Name = "MH_ColorCorrection"
	colorCorrection.Brightness = 0.03
	colorCorrection.Contrast = 0.08
	colorCorrection.Saturation = 0.2
	colorCorrection.TintColor = Color3.new(1, 1, 1)
	colorCorrection.Parent = Lighting
end

local function buildClouds()
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return
	end
	local clouds = terrain:FindFirstChildOfClass("Clouds")
	if not clouds then
		clouds = Instance.new("Clouds")
		clouds.Name = "MH_Clouds"
		clouds.Parent = terrain
	end
	clouds.Cover = 0.55
	clouds.Density = 0.7
	clouds.Color = Color3.new(1, 1, 1)
	clouds.Enabled = true
end

-- -------------------------------------------------------------------
-- NACHT
-- -------------------------------------------------------------------
local function stopTweens()
	for _, tween in ipairs(running) do
		tween:Cancel()
	end
	table.clear(running)
end

local function play(target: Instance?, info: TweenInfo, props: { [string]: any })
	if not target then
		return
	end
	local tween = TweenService:Create(target, info, props)
	table.insert(running, tween)
	tween:Play()
end

-- Laternen der Basen (Neon-Würfel "LanternLamp" von MapBuilder) bekommen ein Licht für die Nacht
local function lanternLights(): { PointLight }
	local lights: { PointLight } = {}
	local map = workspace:FindFirstChild("MeteorHeistMap")
	if not map then
		return lights
	end
	for _, inst in ipairs(map:GetDescendants()) do
		if inst.Name == "LanternLamp" and inst:IsA("BasePart") then
			local light = inst:FindFirstChild("NightLight")
			if not light then
				local created = Instance.new("PointLight")
				created.Name = "NightLight"
				created.Color = LANTERN_COLOR
				created.Range = LANTERN_RANGE
				created.Brightness = 0
				created.Shadows = false
				created.Enabled = false
				created.Parent = inst
				light = created
			end
			if light and light:IsA("PointLight") then
				table.insert(lights, light)
			end
		end
	end
	return lights
end

-- Weich zwischen Tag, Nacht und Blutmond umblenden (fadeTime Sekunden, Standard 10)
function GraphicsService.SetNight(isNight: boolean, bloodMoon: boolean?, fadeTime: number?)
	local target = if not isNight then "Day" elseif bloodMoon then "Blood" else "Night"
	if target == lookName then
		return
	end
	local wasDay = lookName == "Day"
	lookName = target
	stopTweens()
	local look = LOOKS[target]
	local seconds = math.clamp(tonumber(fadeTime) or 10, 0.1, 60)
	local info = TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

	-- Uhrzeit läuft immer VORWÄRTS: Sonnenuntergang 14 -> 23.9, Sonnenaufgang 0 -> 14
	local lightingProps = table.clone(look.Lighting)
	if target == "Day" then
		if Lighting.ClockTime > 18 then
			Lighting.ClockTime = 0 -- Mitternacht -> weiter über den Sonnenaufgang
		end
		lightingProps.ClockTime = DAY_CLOCK
	elseif wasDay then
		lightingProps.ClockTime = NIGHT_CLOCK
	end
	play(Lighting, info, lightingProps)
	play(Lighting:FindFirstChild("MH_Atmosphere"), info, look.Atmosphere)
	play(Lighting:FindFirstChild("MH_ColorCorrection"), info, look.Color)
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	play(terrain and terrain:FindFirstChildOfClass("Clouds"), info, look.Clouds)

	-- Laternen: nachts an (weich heller), tagsüber aus
	for _, light in ipairs(lanternLights()) do
		if isNight then
			light.Enabled = true
			play(light, info, {
				Brightness = LANTERN_BRIGHTNESS,
				Color = if bloodMoon then Color3.fromRGB(255, 120, 100) else LANTERN_COLOR,
			})
		else
			local tween = TweenService:Create(light, info, { Brightness = 0 })
			table.insert(running, tween)
			tween.Completed:Connect(function(state)
				if state == Enum.PlaybackState.Completed then
					light.Enabled = false
				end
			end)
			tween:Play()
		end
	end
end

function GraphicsService.IsNightLook(): boolean
	return lookName ~= "Day"
end

function GraphicsService.Init(_services)
	clearOld()
	applyLighting()
	buildEffects()
	buildClouds()
end

return GraphicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- Globale Bestenliste (alle Server): Top 10 "Meistes Geld verdient" am Spawn-Platz.
-- Die Tafel steht an PlotService.LeaderboardCFrame (Vorderseite zeigt zur Platzmitte).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local LeaderboardService = {}
local Services

local UPDATE_INTERVAL = 300 -- alle 5 Minuten (schont DataStore-Limits)
local MAX_VALUE = 9e18

local store: OrderedDataStore? = nil
local rowsFrame: Frame

local function buildBoard()
	local board = Instance.new("Part")
	board.Name = "Leaderboard"
	board.Anchored = true
	board.Size = Vector3.new(36, 24, 1)
	board.CFrame = Services.PlotService.LeaderboardCFrame
	board.Color = Color3.fromRGB(25, 20, 35)
	board.Material = Enum.Material.SmoothPlastic
	board.CanTouch = false
	board.Parent = Services.PlotService.MapFolder or workspace

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front -- LookVector der CFrame zeigt zur Platzmitte
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = board

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0.14, 0)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 190, 60)
	title.Text = "🏆 TOP 10 – MEISTES GELD 🏆"
	title.Parent = gui

	rowsFrame = Instance.new("Frame")
	rowsFrame.BackgroundTransparency = 1
	rowsFrame.Position = UDim2.new(0.05, 0, 0.16, 0)
	rowsFrame.Size = UDim2.new(0.9, 0, 0.82, 0)
	rowsFrame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = rowsFrame
end

local function setRows(rows: { { Name: string, Value: number } })
	for _, child in ipairs(rowsFrame:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	if #rows == 0 then
		rows = { { Name = "Noch keine Einträge – sei der Erste!", Value = -1 } }
	end
	for i, row in ipairs(rows) do
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 0.1, 0)
		label.LayoutOrder = i
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = i == 1 and Color3.fromRGB(255, 215, 0)
			or i == 2 and Color3.fromRGB(220, 220, 230)
			or i == 3 and Color3.fromRGB(230, 150, 90)
			or Color3.new(1, 1, 1)
		label.Text = row.Value >= 0 and (("#%d  %s  –  %s"):format(i, row.Name, Util.FormatCash(row.Value)))
			or row.Name
		label.Parent = rowsFrame
	end
end

local function savePlayer(player: Player)
	local data = Services.DataService.Get(player)
	if not store or not data then
		return
	end
	local value = math.floor(math.clamp(data.TotalEarned, 0, MAX_VALUE))
	pcall(function()
		(store :: OrderedDataStore):SetAsync(tostring(player.UserId), value)
	end)
end

local nameCache: { [number]: string } = {}
local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	nameCache[userId] = ok and name or ("User " .. userId)
	return nameCache[userId]
end

local function refresh()
	if not store then
		return
	end
	local ok, pages = pcall(function()
		return (store :: OrderedDataStore):GetSortedAsync(false, 10)
	end)
	if not ok then
		return
	end
	local rows = {}
	for _, item in ipairs(pages:GetCurrentPage()) do
		local userId = tonumber(item.key)
		if userId then
			table.insert(rows, { Name = nameFor(userId), Value = item.value })
		end
	end
	setRows(rows)
end

function LeaderboardService.Init(services)
	Services = services
	pcall(function()
		store = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	buildBoard()
	setRows({})
end

function LeaderboardService.Start()
	Services.DataService.OnProfileReleasing(function(player)
		task.spawn(savePlayer, player)
	end)
	task.spawn(function()
		task.wait(10)
		while true do
			for _, player in ipairs(Players:GetPlayers()) do
				savePlayer(player)
				task.wait(0.5)
			end
			refresh()
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[-- Baut die komplette Map per Code (wird von PlotService.Init EINMAL aufgerufen):
--   • knallgrüner Roblox-Noppenboden mit Block-Bäumen, Büschen, Zaun und unsichtbaren Randwänden
--   • EI-RENNEN: großes Nester-Feld in der Map-Mitte (kleine + große Nester, Speed-Pads, Renn-Nest)
--   • 8 OFFENE Basen (je 4 pro Seite, Eingang zum Nester-Feld) -> gebaut von BaseBuilder.luau
--  Stil: schlicht, bunt, blockig (Plastic + Noppen), wenig Neon, wenige Teile.
--   • großer Spawn-Platz mit SpawnLocation, Gratis-Zone, Bestenliste und der LAUFBAND-ZONE (Treadmills)
-- Rückgabe von MapBuilder.Build(): siehe Typ "MapResult" unten.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local BaseBuilder = require(script.Parent:WaitForChild("BaseBuilder"))

local MapBuilder = {}

export type NestFieldInfo = {
	Folder: Folder, -- Ordner "NestField" (Boden, Nester, Speed-Pads; Attribute = Grenzen der Kreaturen)
	Nests: { BasePart }, -- Teile "Nest" (Attribute NestSize, EggPoint, RaceNest)
}

export type FreeZone = {
	Center: Vector3, -- Mitte der Gratis-Zone, Y = Oberkante des Bodens dort
	Radius: number,
}

export type MapResult = {
	MapFolder: Folder,
	Plots: { any },
	NestField: NestFieldInfo, -- Map-Mitte: Ei-Rennen
	LobbySpawn: CFrame,
	LeaderboardCFrame: CFrame,
	FreeZone: FreeZone,
	TreadmillsFolder: Folder,
	TreadmillSpawn: CFrame, -- Zusatz: Teleport-Ziel für den Knopf "🏃 Laufbänder"
}

type TreadmillDef = {
	Id: string,
	Name: string,
	Price: number,
	Rate: number,
	Color: Color3,
	Rainbow: boolean?,
}

type SignLine = { Name: string, Text: string, Color: Color3, Height: number }

-- -------------------------------------------------------------------
-- MASSE & FARBEN (alle Angaben in Studs)
-- -------------------------------------------------------------------
-- Boden
local GROUND_SIZE = 1024
local GROUND_CENTER_Z = -80
local GROUND_COLOR = Color3.fromRGB(90, 200, 70)

-- Map-Rand (Zaun + unsichtbare Wände)
local EDGE_X = 168 -- Basen-Rückseite bei x = ±124, dahinter (rechts) der Meteor-Run (RunService)
local EDGE_MIN_Z = -406
local EDGE_MAX_Z = 256

-- Ei-Rennen (Nester-Feld in der Map-Mitte, Basen beginnen bei x = ±34)
local FIELD_HALF_X = 33
local FIELD_MIN_Z = -214 -- Spawn-Platz endet bei z = -226
local FIELD_MAX_Z = 246
local FIELD_TOP = 0.2
local FIELD_COLOR = Color3.fromRGB(130, 215, 85)
local NEST_COLOR = Color3.fromRGB(226, 186, 96) -- Stroh
local NEST_INNER_COLOR = Color3.fromRGB(160, 110, 55)
local NEST_GOLD_COLOR = Color3.fromRGB(255, 200, 40)
local NEST_SMALL_SIZE = 6
local NEST_BIG_SIZE = 14
local NEST_RACE_SIZE = 18
-- kleine Nester: 4 Reihen (x), von z = -195 bis 195 alle 15 Studs (vor den Basen bleibt ein Weg frei)
local SMALL_NEST_X = { -23, -14, 14, 23 }
local SMALL_NEST_MIN_Z = -195
local SMALL_NEST_MAX_Z = 195
local SMALL_NEST_STEP = 15
-- große Nester (X, Z): Mitte + weit weg am Ende; das LETZTE ist das Renn-Nest (Gold-Ei)
local BIG_NESTS = {
	Vector2.new(0, -140),
	Vector2.new(0, -50),
	Vector2.new(0, 40),
	Vector2.new(0, 130),
	Vector2.new(-36, 214),
	Vector2.new(36, 214),
	Vector2.new(0, 230),
}
-- Speed-Pads (X, Z): Mitte zwischen den großen Nestern + vor jedem Base-Eingang
local SPEED_PAD_SIZE = 5
local SPEED_PAD_COLOR = Color3.fromRGB(0, 170, 255)
local SPEED_PADS = {
	Vector2.new(0, -190),
	Vector2.new(0, -95),
	Vector2.new(0, -5),
	Vector2.new(0, 85),
	Vector2.new(0, 175),
	Vector2.new(-29.5, -135),
	Vector2.new(-29.5, -45),
	Vector2.new(-29.5, 45),
	Vector2.new(-29.5, 135),
	Vector2.new(29.5, -135),
	Vector2.new(29.5, -45),
	Vector2.new(29.5, 45),
	Vector2.new(29.5, 135),
}
-- Revier der Kreaturen (sie betreten nie eine Base und nie den Spawn-Platz)
local CREATURE_HALF_X = 29
local CREATURE_MIN_Z = -205
local CREATURE_MAX_Z = 240

-- Basen baut BaseBuilder.luau (Maße, Slots, Stockwerke, Look). Hier nur die Holzfarbe der Block-Bäume.
local WOOD_COLOR = Color3.fromRGB(124, 92, 70) -- Reddish brown

-- Spawn-Platz (hinter dem Start-Hangar, -Z)
local PLAZA_MIN_Z = -398
local PLAZA_MAX_Z = -226
local PLAZA_HALF_X = 120
local PLAZA_TOP = 0.2
local PLAZA_CENTER = Vector3.new(0, PLAZA_TOP, (PLAZA_MIN_Z + PLAZA_MAX_Z) / 2)
local SPAWN_Z = -318
local FREE_ZONE_Z = -264
local FREE_ZONE_RADIUS = 22
local LEADERBOARD_POS = Vector3.new(-80, 13.4, -300) -- Mitte der Tafel (36 x 24)
local MONUMENT_POS = Vector3.new(80, PLAZA_TOP, -300)

-- Laufband-Zone (Treadmills) am hinteren Platzrand
local TREADMILL_SPACING = 14
local TREADMILL_BELT_Z = -366 -- Mitte der Laufflächen
local TREADMILL_DECK_TOP = 0.7
local TREADMILL_DECK_MIN_Z = -384
local TREADMILL_DECK_MAX_Z = -342
-- so schnell schiebt das Band den Spieler zurück (Config.TreadmillPush; muss deutlich unter Tempo 8 liegen)
local TREADMILL_PUSH = math.clamp(tonumber((Config :: any).TreadmillPush) or 6, 0, 7)
local TREADMILL_RAMP = 4 -- Rampe am Einstieg (hinten): vom Deck sanft hoch auf die Lauffläche
local TREADMILL_MATERIALS: { [string]: Enum.Material } = {
	Holz = Enum.Material.Wood,
	Stein = Enum.Material.Slate,
	Eisen = Enum.Material.DiamondPlate,
	Gold = Enum.Material.Foil,
	Diamant = Enum.Material.Glass,
	Galaxie = Enum.Material.Glass,
	Regenbogen = Enum.Material.SmoothPlastic,
}

local TREE_COLORS = {
	Color3.fromRGB(60, 170, 60),
	Color3.fromRGB(80, 190, 70),
	Color3.fromRGB(45, 150, 55),
	Color3.fromRGB(100, 200, 80),
}
local BUSH_COLOR = Color3.fromRGB(55, 160, 60)

local WHITE = Color3.new(1, 1, 1)

-- -------------------------------------------------------------------
-- BAU-HELFER
-- -------------------------------------------------------------------
-- Alle Teile werden gebaut, solange die Map noch NICHT im Workspace hängt (kein Nachrutschen,
-- ein einziger Replikations-Schub). Geschwindigkeiten der Treadmills werden erst danach gesetzt.
local pendingVelocities: { { Part: BasePart, Velocity: Vector3 } } = {}

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false -- nur Pads brauchen Touched (spart Physik-Arbeit)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Flache Scheibe (Zylinder mit senkrechter Achse), Unterkante auf bottomY
local function disc(name: string, center: Vector3, bottomY: number, height: number, diameter: number, props)
	local p = part(props)
	p.Name = name
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = CFrame.new(center.X, bottomY + height / 2, center.Z) * CFrame.Angles(0, 0, math.rad(90))
	return p
end

-- Unsichtbarer Ankerpunkt für Schilder
local function anchorPart(name: string, cframe: CFrame, parent: Instance): Part
	return part({
		Name = name,
		Size = Vector3.new(1, 1, 1),
		CFrame = cframe,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = parent,
	})
end

-- Klassische Roblox-Noppen auf der Oberseite
local function studs(target: BasePart)
	target.TopSurface = Enum.SurfaceType.Studs
end

local function addLight(parent: Instance, color: Color3, range: number, brightness: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = parent
end

-- Mehrzeiliges Schild in Studs-Größe (wirkt wie ein echtes Schild in der Welt).
-- Aufbau wie bei MeteorFactory: BillboardGui > Frame "Frame" > TextLabels (UIListLayout)
local function worldSign(
	parent: Instance,
	guiName: string,
	widthStuds: number,
	heightStuds: number,
	offset: Vector3,
	maxDistance: number,
	lines: { SignLine }
): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = guiName
	gui.Size = UDim2.fromScale(widthStuds, heightStuds)
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	gui.Parent = parent

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = frame

	for order, line in ipairs(lines) do
		local label = Instance.new("TextLabel")
		label.Name = line.Name
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, line.Height)
		label.LayoutOrder = order
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = line.Color
		label.Text = line.Text
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 3
		stroke.Color = Color3.new(0, 0, 0)
		stroke.LineJoinMode = Enum.LineJoinMode.Round
		stroke.Parent = label
		label.Parent = frame
	end
	return gui
end

-- Liest Config.Treadmills zur LAUFZEIT und filtert kaputte Einträge raus
local function treadmillDefs(): { TreadmillDef }
	local list = (Config :: any).Treadmills
	local result: { TreadmillDef } = {}
	if type(list) ~= "table" then
		warn("[MapBuilder] Config.Treadmills fehlt – keine Laufbänder gebaut")
		return result
	end
	for _, def in ipairs(list) do
		if type(def) == "table" and type(def.Id) == "string" then
			table.insert(result, {
				Id = def.Id,
				Name = type(def.Name) == "string" and def.Name or def.Id,
				Price = tonumber(def.Price) or 0,
				Rate = tonumber(def.Rate) or 1,
				Color = typeof(def.Color) == "Color3" and def.Color or WHITE,
				Rainbow = def.Rainbow == true or def.Id == "Regenbogen",
			})
		end
	end
	return result
end

-- -------------------------------------------------------------------
-- ALTES ZEUG WEG
-- -------------------------------------------------------------------
local function clearOld()
	for _, child in ipairs(workspace:GetChildren()) do
		if child.Name == "Baseplate" or child.Name == "MeteorHeistMap" or child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end
end

-- -------------------------------------------------------------------
-- BODEN + RAND
-- -------------------------------------------------------------------
local function buildGround(map: Folder)
	local ground = part({
		Name = "Ground",
		Size = Vector3.new(GROUND_SIZE, 1, GROUND_SIZE),
		Position = Vector3.new(0, -0.5, GROUND_CENTER_Z),
		Material = Enum.Material.Plastic,
		Color = GROUND_COLOR,
		Parent = map,
	})
	studs(ground)

	-- Unsichtbare Randwände (durchsichtige Teile verdecken die Kamera nicht)
	local lengthZ = EDGE_MAX_Z - EDGE_MIN_Z
	local centerZ = (EDGE_MAX_Z + EDGE_MIN_Z) / 2
	for _, data in ipairs({
		{ Vector3.new(-EDGE_X - 2, 60, centerZ), Vector3.new(4, 120, lengthZ + 8) },
		{ Vector3.new(EDGE_X + 2, 60, centerZ), Vector3.new(4, 120, lengthZ + 8) },
		{ Vector3.new(0, 60, EDGE_MIN_Z - 2), Vector3.new(EDGE_X * 2 + 8, 120, 4) },
		{ Vector3.new(0, 60, EDGE_MAX_Z + 2), Vector3.new(EDGE_X * 2 + 8, 120, 4) },
	}) do
		part({
			Name = "Boundary",
			Position = data[1],
			Size = data[2],
			Transparency = 1,
			CastShadow = false,
			Parent = map,
		})
	end
end

-- -------------------------------------------------------------------
-- EI-RENNEN: großes Nester-Feld in der Map-Mitte (zwischen den Basen x = ±34)
--   viele kleine Nester (nah an den Basen), wenige große (Mitte / weit weg), Speed-Pads.
--   Attribute: Nester (Teil "Nest") NestSize = "Small"/"Big", EggPoint = Ei-Unterkante, RaceNest = true
--   (entferntestes großes Nest, dort erscheint das Gold-Ei); Ordner "NestField": Grenzen für die
--   Kreaturen (MinX, MaxX, MinZ, MaxZ). Der Server (MeteorService, FieldService) liest alles von hier.
-- -------------------------------------------------------------------
local function buildNest(parent: Instance, x: number, z: number, big: boolean, race: boolean): Part
	local diameter = if race then NEST_RACE_SIZE elseif big then NEST_BIG_SIZE else NEST_SMALL_SIZE
	local height = if big then 1.6 else 1
	local center = Vector3.new(x, 0, z)
	local nest = disc("Nest", center, FIELD_TOP, height, diameter, {
		Material = Enum.Material.Plastic,
		Color = if race then NEST_GOLD_COLOR else NEST_COLOR,
		Parent = parent,
	})
	studs(nest)
	-- Mulde (dunkleres Stroh), steht minimal höher -> kein Flackern
	disc("NestInner", center, FIELD_TOP, height + 0.1, diameter * 0.66, {
		Material = Enum.Material.Plastic,
		Color = NEST_INNER_COLOR,
		CanCollide = false,
		CastShadow = false,
		Parent = parent,
	})
	nest:SetAttribute("NestSize", if big then "Big" else "Small")
	nest:SetAttribute("EggPoint", Vector3.new(x, FIELD_TOP + height + 0.1, z))
	if big then
		-- 4 Strohhalme (Blöcke) schräg am Rand
		for i = 0, 3 do
			local angle = i * math.pi / 2 + math.pi / 4
			local r = diameter / 2 - 0.6
			part({
				Name = "Straw",
				Size = Vector3.new(1, 3.4, 1),
				CFrame = CFrame.new(x + math.cos(angle) * r, FIELD_TOP + height + 0.8, z + math.sin(angle) * r)
					* CFrame.Angles(0, -angle, math.rad(-25)),
				Material = Enum.Material.Plastic,
				Color = NEST_COLOR,
				CanCollide = false,
				Parent = parent,
			})
		end
		-- Lichtsäule (schaltet der Server ein, solange ein Ei drin liegt)
		local bottom = Instance.new("Attachment")
		bottom.Name = "PillarBottom"
		bottom.Position = Vector3.new(height / 2, 0, 0) -- (Zylinder liegt gekippt: lokales X = oben)
		bottom.Parent = nest
		local top = Instance.new("Attachment")
		top.Name = "PillarTop"
		top.Position = Vector3.new(height / 2 + 40, 0, 0)
		top.Parent = nest
		local beam = Instance.new("Beam")
		beam.Name = "NestPillar"
		beam.Attachment0 = bottom
		beam.Attachment1 = top
		beam.Width0 = diameter * 0.5
		beam.Width1 = diameter * 0.3
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Segments = 1
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.4),
			NumberSequenceKeypoint.new(0.6, 0.8),
			NumberSequenceKeypoint.new(1, 1),
		})
		beam.Enabled = false
		beam.Parent = nest
	end
	if race then
		nest:SetAttribute("RaceNest", true)
		-- Zielflagge (schwarz-weiß) neben dem Nest
		local poleX = x + diameter / 2 + 2
		part({
			Name = "RacePole",
			Size = Vector3.new(0.6, 14, 0.6),
			Position = Vector3.new(poleX, FIELD_TOP + 7, z),
			Material = Enum.Material.Plastic,
			Color = WHITE,
			Parent = parent,
		})
		for i = 0, 1 do
			part({
				Name = "RaceFlag",
				Size = Vector3.new(0.2, 2, 2.5),
				CFrame = CFrame.new(poleX, FIELD_TOP + 12.5 - i * 2, z + 1.25 + (i * 2.5)),
				Material = Enum.Material.Plastic,
				Color = if i == 0 then Color3.fromRGB(27, 42, 53) else WHITE,
				CanCollide = false,
				CastShadow = false,
				Parent = parent,
			})
		end
	end
	return nest
end

-- Speed-Pad: flache Platte mit Blitz, Berühren = kurz schneller (FieldService)
local function buildSpeedPad(parent: Instance, x: number, z: number)
	local pad = part({
		Name = "SpeedPad",
		Size = Vector3.new(SPEED_PAD_SIZE, 0.3, SPEED_PAD_SIZE),
		Position = Vector3.new(x, FIELD_TOP + 0.15, z),
		Material = Enum.Material.SmoothPlastic,
		Color = SPEED_PAD_COLOR,
		CanCollide = false,
		CanTouch = true,
		CastShadow = false,
		Parent = parent,
	})
	pad:SetAttribute("SpeedPad", true)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Icon"
	gui.Face = Enum.NormalId.Top
	gui.CanvasSize = Vector2.new(100, 100)
	gui.LightInfluence = 0
	gui.Parent = pad
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "⚡"
	label.TextColor3 = WHITE
	label.Parent = gui
end

local function buildNestField(map: Folder): NestFieldInfo
	local field = folder("NestField", map) -- Name wird von Server und Client gesucht!
	field:SetAttribute("MinX", -CREATURE_HALF_X)
	field:SetAttribute("MaxX", CREATURE_HALF_X)
	field:SetAttribute("MinZ", CREATURE_MIN_Z)
	field:SetAttribute("MaxZ", CREATURE_MAX_Z)

	-- Noppenboden des Felds (etwas helleres Grün als die Wiese)
	local floorPart = part({
		Name = "Floor",
		Size = Vector3.new(FIELD_HALF_X * 2, FIELD_TOP, FIELD_MAX_Z - FIELD_MIN_Z),
		Position = Vector3.new(0, FIELD_TOP / 2, (FIELD_MIN_Z + FIELD_MAX_Z) / 2),
		Material = Enum.Material.Plastic,
		Color = FIELD_COLOR,
		Parent = field,
	})
	studs(floorPart)

	local nestsFolder = folder("Nests", field)
	local nests: { BasePart } = {}
	-- kleine Nester: 4 Reihen nah an den Basen, über die ganze Länge
	for _, x in ipairs(SMALL_NEST_X) do
		local z = SMALL_NEST_MIN_Z
		while z <= SMALL_NEST_MAX_Z do
			table.insert(nests, buildNest(nestsFolder, x, z, false, false))
			z += SMALL_NEST_STEP
		end
	end
	-- große Nester: Mitte + weit weg am Ende (das letzte ist das Renn-Nest)
	for i, pos in ipairs(BIG_NESTS) do
		table.insert(nests, buildNest(nestsFolder, pos.X, pos.Y, true, i == #BIG_NESTS))
	end

	local padsFolder = folder("SpeedPads", field)
	for _, pos in ipairs(SPEED_PADS) do
		buildSpeedPad(padsFolder, pos.X, pos.Y)
	end

	-- Schild am Anfang des Felds (vom Spawn-Platz aus zu sehen)
	local signAnchor = anchorPart("TitleSign", CFrame.new(0, 16, FIELD_MIN_Z + 4), field)
	worldSign(signAnchor, "Sign", 36, 9, Vector3.zero, 700, {
		{ Name = "Title", Text = "🥚 EI-RENNEN", Color = Color3.fromRGB(255, 220, 80), Height = 0.6 },
		{ Name = "Hint", Text = "Schnapp dir Eier! Achtung: Monster!", Color = WHITE, Height = 0.4 },
	})

	return {
		Folder = field,
		Nests = nests,
	}
end

-- -------------------------------------------------------------------
-- BLOCK-BAUM (Deko; die Basen baut BaseBuilder)
-- -------------------------------------------------------------------
-- Blockiger Roblox-Baum: Stamm + großer Blätterblock + kleiner Block obendrauf (3 Teile).
-- cf = Bodenpunkt (Stamm-Unterkante), scale = Größe
local function blockTree(parent: Instance, cf: CFrame, scale: number, color: Color3)
	local trunkHeight = 6 * scale
	local trunkWidth = 2 * scale
	part({
		Name = "Trunk",
		Size = Vector3.new(trunkWidth, trunkHeight, trunkWidth),
		CFrame = cf * CFrame.new(0, trunkHeight / 2, 0),
		Material = Enum.Material.Plastic,
		Color = WOOD_COLOR,
		Parent = parent,
	})
	local leafWidth, leafHeight = 8 * scale, 5 * scale
	local leaves = part({
		Name = "Leaves",
		Size = Vector3.new(leafWidth, leafHeight, leafWidth),
		CFrame = cf * CFrame.new(0, trunkHeight + leafHeight / 2, 0),
		Material = Enum.Material.Plastic,
		Color = color,
		CanCollide = false,
		Parent = parent,
	})
	leaves.TopSurface = Enum.SurfaceType.Studs
	local topWidth, topHeight = 5 * scale, 3 * scale
	local crown = part({
		Name = "Leaves",
		Size = Vector3.new(topWidth, topHeight, topWidth),
		CFrame = cf * CFrame.new(0, trunkHeight + leafHeight + topHeight / 2, 0),
		Material = Enum.Material.Plastic,
		Color = color,
		CanCollide = false,
		Parent = parent,
	})
	crown.TopSurface = Enum.SurfaceType.Studs
end

-- -------------------------------------------------------------------
-- SPAWN-PLATZ (SpawnLocation, Gratis-Zone, Bestenliste, Denkmal)
-- -------------------------------------------------------------------
local function buildPlaza(map: Folder): (CFrame, CFrame, FreeZone)
	local plaza = folder("Plaza", map)

	local floorPart = part({
		Name = "Floor",
		Size = Vector3.new(PLAZA_HALF_X * 2, PLAZA_TOP, PLAZA_MAX_Z - PLAZA_MIN_Z),
		Position = Vector3.new(0, PLAZA_TOP / 2, PLAZA_CENTER.Z),
		Material = Enum.Material.Plastic,
		Color = Color3.fromRGB(205, 212, 225),
		Parent = plaza,
	})
	studs(floorPart)

	-- Große SpawnLocation mit Leuchtrand
	part({
		Name = "SpawnRim",
		Size = Vector3.new(30, 0.6, 30),
		Position = Vector3.new(0, PLAZA_TOP + 0.3, SPAWN_Z),
		Material = Enum.Material.Plastic,
		Color = Color3.fromRGB(13, 105, 172),
		CastShadow = false,
		Parent = plaza,
	})
	local spawnTop = PLAZA_TOP + 0.8
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(26, 0.8, 26)
	spawn.Position = Vector3.new(0, spawnTop - 0.4, SPAWN_Z)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Color = Color3.fromRGB(255, 200, 60)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.AllowTeamChangeOnTouch = false
	spawn.Parent = plaza
	local lobbySpawn = CFrame.lookAt(
		Vector3.new(0, spawnTop + 3.5, SPAWN_Z),
		Vector3.new(0, spawnTop + 3.5, -214) -- Blick zum Nester-Feld
	)

	-- Gratis-Zone: Landeplatz mit gelb-schwarzem Ring (hier landen Gratis- und Admin-Meteore)
	local zoneCenter = Vector3.new(0, 0, FREE_ZONE_Z)
	disc("FreeZoneRing", zoneCenter, PLAZA_TOP, 0.2, FREE_ZONE_RADIUS * 2 + 6, {
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(255, 205, 40),
		CastShadow = false,
		Parent = plaza,
	})
	disc("FreeZoneEdge", zoneCenter, PLAZA_TOP, 0.25, FREE_ZONE_RADIUS * 2 + 2, {
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(28, 28, 32),
		CastShadow = false,
		Parent = plaza,
	})
	local zoneTop = PLAZA_TOP + 0.3
	local zonePad = disc("FreeZone", zoneCenter, PLAZA_TOP, 0.3, FREE_ZONE_RADIUS * 2, {
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(80, 50, 150),
		CastShadow = false,
		Parent = plaza,
	})
	zonePad:SetAttribute("Radius", FREE_ZONE_RADIUS)
	local zoneSign = anchorPart("FreeZoneSign", CFrame.new(0, 15, FREE_ZONE_Z), plaza)
	worldSign(zoneSign, "Sign", 30, 7, Vector3.zero, 400, {
		{ Name = "Title", Text = "🎁 GRATIS-ZONE 🎁", Color = Color3.fromRGB(120, 255, 120), Height = 0.6 },
		{ Name = "Hint", Text = "👑 Hier landen Admin-Meteore!", Color = WHITE, Height = 0.4 },
	})

	-- Ständer für die Bestenliste (die Tafel selbst baut LeaderboardService an LeaderboardCFrame)
	local boardCF = CFrame.lookAt(LEADERBOARD_POS, Vector3.new(PLAZA_CENTER.X, LEADERBOARD_POS.Y, PLAZA_CENTER.Z))
	local boardBottom = LEADERBOARD_POS.Y - 12
	local standColor = Color3.fromRGB(45, 40, 60)
	part({
		Name = "LeaderboardBase",
		Size = Vector3.new(42, boardBottom - PLAZA_TOP, 6),
		CFrame = boardCF * CFrame.new(0, -12 - (boardBottom - PLAZA_TOP) / 2, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = standColor,
		Parent = plaza,
	})
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "LeaderboardPillar",
			Size = Vector3.new(2, 26, 2),
			CFrame = boardCF * CFrame.new(s * 19.5, 1, 0),
			Material = Enum.Material.SmoothPlastic,
			Color = standColor,
			Parent = plaza,
		})
	end
	part({
		Name = "LeaderboardCap",
		Size = Vector3.new(42, 1.2, 3),
		CFrame = boardCF * CFrame.new(0, 14.6, 0),
		Material = Enum.Material.Plastic,
		Color = Color3.fromRGB(255, 190, 40),
		CastShadow = false,
		Parent = plaza,
	})

	-- Meteor-Denkmal (Gegenstück zur Bestenliste)
	disc("MonumentBase", MONUMENT_POS, PLAZA_TOP, 3, 14, {
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(90, 90, 105),
		Parent = plaza,
	})
	local rockCenter = MONUMENT_POS + Vector3.new(0, 3 + 5, 0)
	part({
		Name = "MonumentRock",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(10, 10, 10),
		Position = rockCenter,
		Material = Enum.Material.CrackedLava,
		Color = Color3.fromRGB(110, 70, 60),
		Parent = plaza,
	})
	part({
		Name = "MonumentRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 17, 17),
		CFrame = CFrame.new(rockCenter) * CFrame.Angles(math.rad(20), 0, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Plastic,
		Color = Color3.fromRGB(255, 140, 40),
		CanCollide = false,
		CastShadow = false,
		Parent = plaza,
	})

	return lobbySpawn, boardCF, { Center = Vector3.new(0, zoneTop, FREE_ZONE_Z), Radius = FREE_ZONE_RADIUS }
end

-- -------------------------------------------------------------------
-- LAUFBAND-ZONE (Treadmills zum Schritte-Farmen)
-- -------------------------------------------------------------------
-- Ein Laufband: lokales -Z = Laufrichtung des Spielers, vorne Konsole + Bogen mit Schild.
-- Das Band schiebt den Spieler nach hinten (+Z lokal) -> man muss laufen, um draufzubleiben.
local function buildTreadmill(def: TreadmillDef, order: number, total: number, base: CFrame, parent: Instance)
	local model = Instance.new("Model")
	model.Name = def.Id
	model:SetAttribute("TreadmillId", def.Id)
	model:SetAttribute("Order", order)
	model:SetAttribute("Price", def.Price)
	model:SetAttribute("Rate", def.Rate)

	local color = def.Color
	local material = TREADMILL_MATERIALS[def.Id] or Enum.Material.Metal
	local topTier = order > total - 3 -- die obersten 3 Stufen leuchten extra

	local function glowPart(props): Part
		props.Material = Enum.Material.Neon
		props.Color = color
		props.CastShadow = false
		props.Parent = model
		local p = part(props)
		if def.Rainbow then
			p:SetAttribute("Rainbow", true) -- Client färbt durch
		end
		return p
	end

	part({
		Name = "Chassis",
		Size = Vector3.new(10.4, 0.6, 22),
		CFrame = base * CFrame.new(0, 0.3, 0),
		Material = material,
		Color = color:Lerp(Color3.new(0, 0, 0), 0.35),
		Parent = model,
	})
	local belt = part({
		Name = "Belt",
		Size = Vector3.new(8, 0.3, 20),
		CFrame = base * CFrame.new(0, 0.65, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(32, 32, 38),
		CanCollide = true,
		CanQuery = true, -- Humanoid findet den Boden per Raycast
		Parent = model,
	})
	local backward = -base.LookVector
	belt:SetAttribute("BeltDir", backward)
	belt:SetAttribute("BeltSpeed", TREADMILL_PUSH)
	table.insert(pendingVelocities, { Part = belt, Velocity = backward * TREADMILL_PUSH })
	model.PrimaryPart = belt

	-- Einstieg hinten (+Z lokal): Keil-Rampe vom Deck hoch auf die Lauffläche. Wer stehen bleibt, wird vom
	-- Band hierher geschoben und rutscht sanft aufs Deck (keine Kante, kein Absturz). Die hohe Seite des Keils
	-- (+Z des Keils) liegt am Band, die flache Kante (-Z des Keils = LookVector) zeigt vom Band weg.
	local beltTop = 0.8 -- Oberkante Lauffläche über dem Deck (0.65 + 0.3 / 2)
	local ramp = Instance.new("WedgePart")
	ramp.Name = "Ramp"
	ramp.Anchored = true
	ramp.CanTouch = false
	ramp.TopSurface = Enum.SurfaceType.Smooth
	ramp.BottomSurface = Enum.SurfaceType.Smooth
	ramp.Size = Vector3.new(8, beltTop, TREADMILL_RAMP)
	local rampCenter = base * CFrame.new(0, beltTop / 2, 10 + TREADMILL_RAMP / 2)
	ramp.CFrame = CFrame.lookAt(rampCenter.Position, rampCenter.Position + base.LookVector * -1)
	ramp.Material = Enum.Material.Metal
	ramp.Color = color:Lerp(Color3.new(0, 0, 0), 0.35)
	ramp.Parent = model

	-- Leuchtende Seitenrahmen
	for _, s in ipairs({ -1, 1 }) do
		glowPart({
			Name = "SideFrame",
			Size = Vector3.new(1.2, 0.9, 21),
			CFrame = base * CFrame.new(s * 4.6, 1.05, 0),
		})
	end

	-- Konsole vorne (man läuft dagegen) + unsichtbare Stoppwand gegen Drüberspringen
	part({
		Name = "Console",
		Size = Vector3.new(8, 3.6, 1.2),
		CFrame = base * CFrame.new(0, 2.4, -10.6),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(40, 40, 48),
		Parent = model,
	})
	local screen = glowPart({
		Name = "Screen",
		Size = Vector3.new(5, 1.4, 0.15),
		CFrame = base * CFrame.new(0, 3.2, -9.925),
		CanCollide = false,
	})
	screen.CanQuery = false
	part({
		Name = "FrontStop",
		Size = Vector3.new(8.4, 12, 0.6),
		CFrame = base * CFrame.new(0, 6, -10.5),
		Transparency = 1,
		CastShadow = false,
		CanQuery = false, -- nur Wand (keine Kamera-/Klick-Treffer), Kollision bleibt
		Parent = model,
	})

	-- Bogen: jede Stufe etwas höher (sieht aus wie eine Treppe von Holz bis Regenbogen)
	local archHeight = 8 + (order - 1) * 1.2
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "Pillar",
			Size = Vector3.new(1.2, archHeight, 1.2),
			CFrame = base * CFrame.new(s * 5.6, archHeight / 2, -11.6),
			Material = material,
			Color = color,
			Parent = model,
		})
	end
	local beam = glowPart({
		Name = "Arch",
		Size = Vector3.new(12.4, 1.2, 1.2),
		CFrame = base * CFrame.new(0, archHeight + 0.6, -11.6),
	})
	if topTier then
		addLight(beam, color, 18, 1.6)
	end

	local free = def.Price <= 0
	worldSign(beam, "Sign", 14, 5.2, Vector3.new(0, 3.4, 0), 160, {
		{ Name = "NameLabel", Text = def.Name, Color = color:Lerp(WHITE, 0.45), Height = 0.42 },
		{
			Name = "RateLabel",
			Text = "+" .. Util.FormatNumber(def.Rate) .. " 👟",
			Color = Color3.fromRGB(255, 230, 90),
			Height = 0.3,
		},
		{
			-- Preis (der Client schreibt "Gekauft" / "Dein bestes" darüber, sobald er weiß, was dir gehört)
			Name = "PriceLabel",
			Text = free and "Gratis" or Util.FormatCash(def.Price),
			Color = free and Color3.fromRGB(120, 255, 120) or Color3.fromRGB(255, 220, 90),
			Height = 0.28,
		},
	})

	model.Parent = parent
	return model
end

local function buildTreadmills(map: Folder): (Folder, CFrame)
	local zone = folder("TreadmillZone", map) -- Deko (Boden, Schild)
	local treadmills = folder("Treadmills", map) -- NUR die Laufband-Models
	local defs = treadmillDefs()
	local count = #defs

	local deckWidth = math.max(1, count - 1) * TREADMILL_SPACING + 10.4 + 16
	local deckDepth = TREADMILL_DECK_MAX_Z - TREADMILL_DECK_MIN_Z
	local deckCenterZ = (TREADMILL_DECK_MAX_Z + TREADMILL_DECK_MIN_Z) / 2
	local deck = part({
		Name = "Deck",
		Size = Vector3.new(deckWidth, TREADMILL_DECK_TOP - PLAZA_TOP, deckDepth),
		Position = Vector3.new(0, (TREADMILL_DECK_TOP + PLAZA_TOP) / 2, deckCenterZ),
		Material = Enum.Material.Plastic,
		Color = Color3.fromRGB(55, 65, 95),
		Parent = zone,
	})
	studs(deck)
	-- (früher: Leuchtleiste an der Deck-Kante – lag mit ihrer Außenfläche genau in der Deck-Fläche
	-- und flackerte; weggelassen)
	local zoneSign = anchorPart("ZoneSign", CFrame.new(0, 30, TREADMILL_DECK_MIN_Z + 4), zone)
	worldSign(zoneSign, "Sign", 56, 11, Vector3.zero, 500, {
		{ Name = "Title", Text = "🏃 LAUFBÄNDER 👟", Color = Color3.fromRGB(255, 220, 60), Height = 0.6 },
		{ Name = "Hint", Text = "Laufband kaufen, drauf laufen = schneller!", Color = WHITE, Height = 0.4 },
	})

	for order, def in ipairs(defs) do
		local x = (order - (count + 1) / 2) * TREADMILL_SPACING
		local origin = Vector3.new(x, TREADMILL_DECK_TOP, TREADMILL_BELT_Z)
		-- Laufrichtung des Spielers = -Z (weg vom Platz), Einstieg von der Platzseite
		local base = CFrame.lookAt(origin, origin - Vector3.zAxis)
		buildTreadmill(def, order, count, base, treadmills)
	end

	local spawnY = TREADMILL_DECK_TOP + 3.5
	local spawnCF =
		CFrame.lookAt(Vector3.new(0, spawnY, TREADMILL_DECK_MAX_Z - 5), Vector3.new(0, spawnY, TREADMILL_BELT_Z))
	treadmills:SetAttribute("SpawnCFrame", spawnCF)
	return treadmills, spawnCF
end

-- -------------------------------------------------------------------
-- DEKO (Block-Bäume, Büsche, Zaun) – bewusst sparsam
-- -------------------------------------------------------------------
local function tree(parent: Instance, x: number, z: number, scale: number, color: Color3)
	blockTree(parent, CFrame.new(x, 0, z), scale, color)
end

-- Busch = grüner Noppen-Block (halb im Boden)
local function bush(parent: Instance, x: number, z: number, size: number)
	local p = part({
		Name = "Bush",
		Size = Vector3.new(size, size * 0.6, size),
		Position = Vector3.new(x, size * 0.25, z),
		Material = Enum.Material.Plastic,
		Color = BUSH_COLOR,
		CanCollide = false,
		CastShadow = false,
		Parent = parent,
	})
	p.TopSurface = Enum.SurfaceType.Studs
end

local function buildFence(parent: Instance)
	local color = Color3.fromRGB(245, 240, 228)
	-- Ecken im Kreis, damit jeder Eckpfosten nur einmal gebaut wird
	local corners = {
		Vector3.new(-EDGE_X, 0, EDGE_MIN_Z),
		Vector3.new(EDGE_X, 0, EDGE_MIN_Z),
		Vector3.new(EDGE_X, 0, EDGE_MAX_Z),
		Vector3.new(-EDGE_X, 0, EDGE_MAX_Z),
	}
	for i, a in ipairs(corners) do
		local b = corners[i % #corners + 1]
		local length = (b - a).Magnitude
		local sideCF = CFrame.lookAt((a + b) / 2, b)
		for _, height in ipairs({ 1.4, 2.8 }) do
			part({
				Name = "FenceRail",
				Size = Vector3.new(0.5, 0.5, length),
				CFrame = sideCF + Vector3.new(0, height, 0),
				Material = Enum.Material.Wood,
				Color = color,
				CastShadow = false,
				Parent = parent,
			})
		end
		local posts = math.max(1, math.floor(length / 55 + 0.5))
		for p = 0, posts - 1 do
			local pos = a:Lerp(b, p / posts)
			part({
				Name = "FencePost",
				Size = Vector3.new(1, 3.8, 1),
				Position = pos + Vector3.new(0, 1.9, 0),
				Material = Enum.Material.Wood,
				Color = color,
				CastShadow = false,
				Parent = parent,
			})
		end
	end
end

local function buildDeco(map: Folder)
	local deco = folder("Deco", map)
	local rng = Random.new(20261003) -- fester Seed: jeder Server sieht gleich aus
	local function treeColor(): Color3
		return TREE_COLORS[rng:NextInteger(1, #TREE_COLORS)]
	end

	buildFence(deco)

	-- Bäume AUSSERHALB des Zauns (Horizont), gleichmäßig verteilt
	local strips = {
		{ -EDGE_X - 45, -EDGE_X - 12, EDGE_MIN_Z, EDGE_MAX_Z, 7, true },
		{ EDGE_X + 12, EDGE_X + 45, EDGE_MIN_Z, EDGE_MAX_Z, 7, true },
		{ -EDGE_X + 10, EDGE_X - 10, EDGE_MAX_Z + 10, EDGE_MAX_Z + 40, 5, false },
		{ -EDGE_X + 10, EDGE_X - 10, EDGE_MIN_Z - 40, EDGE_MIN_Z - 10, 5, false },
	}
	for _, strip in ipairs(strips) do
		local x0, x1, z0, z1, count, alongZ = strip[1], strip[2], strip[3], strip[4], strip[5], strip[6]
		for i = 1, count do
			local t = (i - 1 + rng:NextNumber(0.2, 0.8)) / count
			local x, z
			if alongZ then
				x = rng:NextNumber(x0, x1)
				z = z0 + (z1 - z0) * t
			else
				x = x0 + (x1 - x0) * t
				z = rng:NextNumber(z0, z1)
			end
			tree(deco, x, z, rng:NextNumber(1.1, 1.5), treeColor())
		end
	end

	-- Hinter den LINKEN Basen (zwischen Rand x = -124 und Zaun x = -168). Rechts liegt dort der Meteor-Run.
	for _, z in ipairs({ -135, -45, 45, 135 }) do
		tree(deco, -146 + rng:NextNumber(-4, 4), z + rng:NextNumber(-10, 10), rng:NextNumber(0.9, 1.2), treeColor())
	end
	for _, z in ipairs({ -90, 0, 90 }) do
		bush(deco, -146 + rng:NextNumber(-6, 6), z, rng:NextNumber(4, 6))
	end

	-- Hinter dem Ziel-Tor (+Z)
	for _, s in ipairs({ -1, 1 }) do
		tree(deco, s * 60, 240, 1.1, treeColor())
		tree(deco, s * 120, 236, 1, treeColor())
		bush(deco, s * 35, 242, 5)
		bush(deco, s * 90, 246, 4.5)
	end

	-- Spawn-Platz: Ecken + Ränder
	for _, s in ipairs({ -1, 1 }) do
		tree(deco, s * 108, PLAZA_MIN_Z + 10, 1.2, treeColor())
		tree(deco, s * 108, PLAZA_MAX_Z - 12, 1.1, treeColor())
		bush(deco, s * 112, -335, 5)
		bush(deco, s * 112, -275, 5.5)
		bush(deco, s * 70, PLAZA_MIN_Z + 6, 4.5)
	end

	-- Zwischen Platz und Basen
	for _, s in ipairs({ -1, 1 }) do
		bush(deco, s * 60, -195, 4.5)
		bush(deco, s * 98, -210, 5)
	end
end

-- -------------------------------------------------------------------
-- ÖFFENTLICH
-- -------------------------------------------------------------------
-- Baut die komplette Map in workspace.MeteorHeistMap (alte Map/Baseplate/SpawnLocations werden entfernt).
function MapBuilder.Build(): MapResult
	clearOld()
	table.clear(pendingVelocities)

	local map = Instance.new("Folder")
	map.Name = "MeteorHeistMap"

	buildGround(map)
	local nestField = buildNestField(map)
	local plots = BaseBuilder.BuildPlots(map) -- Basen: siehe BaseBuilder.luau
	local lobbySpawn, leaderboardCF, freeZone = buildPlaza(map)
	local treadmillsFolder, treadmillSpawn = buildTreadmills(map)
	buildDeco(map)

	map.Parent = workspace

	-- Erst im Workspace: Treadmill-Geschwindigkeiten setzen (verankerte Teile schieben Spieler)
	for _, item in ipairs(pendingVelocities) do
		item.Part.AssemblyLinearVelocity = item.Velocity
	end
	table.clear(pendingVelocities)

	return {
		MapFolder = map,
		Plots = plots,
		NestField = nestField,
		LobbySpawn = lobbySpawn,
		LeaderboardCFrame = leaderboardCF,
		FreeZone = freeZone,
		TreadmillsFolder = treadmillsFolder,
		TreadmillSpawn = treadmillSpawn,
	}
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">MeteorFactory</string>
            <string name="Source"><![CDATA[-- Baut das Aussehen eines Meteors: Größe nach Seltenheit, Licht/Feuer/Funken für seltene,
-- Material/Farbe nach Mutation, Spezial-Effekte der Admin-Meteore, Namensschild darüber.
-- Lichter und Feuer gibt es bewusst sparsam (viele Meteore gleichzeitig = sonst Lag).
-- Dazu: Prompts anlegen (AddPrompt) und serverseitig prüfen, ob lange genug gehalten wurde (OnHeldTrigger).
--
-- KRASSE EIER (ab Legendary, im Nest / am Boden / in der Base – nicht beim Tragen):
--   • Lichtsäule (Beam zwischen zwei Attachments, nach oben verblassend)
--   • Glitzer-Partikel "RareSparkle" in Seltenheitsfarbe
--   • Mythic+: Funkenregen "RareSparks" (+ Blitze, die der Client lokal zeichnet)
--   • Secret..Cosmic/Admin: Regenbogen-Aura "RareAura" und Regenbogen-Säule
--   • Infinity: dazu kreisende Sterne "RareInfinity", breitere + höhere Säule (stärkster Effekt)
--   • Attribut "RareFX" = Stufe (1 Legendary, 2 Mythic..Divine, 3 Secret..Cosmic/Admin, 4 Infinity):
--     der Client (WorldFX)
--     dreht damit lokal einen Ring ums Ei, lässt das Licht pulsieren und schaltet die Partikel nur in
--     Kameranähe ein (Emitter starten deshalb AUS).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local MeteorFactory = {}

-- Ab welcher Seltenheit (Index in Config.Rarities) gibt es welchen Effekt?
-- Nest: es liegen sehr viele Eier gleichzeitig im Feld -> noch sparsamer.
local LIGHT_FROM = { Base = 5, Ground = 5, Nest = 5, Carry = 7 }
local FIRE_FROM = { Base = 7, Ground = 7, Nest = 99, Carry = 99 }
local SPARKLES_FROM = { Base = 6, Ground = 6, Nest = 7, Carry = 99 }
local SHADOW_MIN_SIZE = 3.5 -- nur große Meteore werfen Schatten
local FROST_WHITEN = 0.4 -- Frost-Meteore etwas weißer als die Mutationsfarbe (sonst fast wie Diamond)

-- Krasse Eier (siehe oben)
local RARE_FROM = Config.RarityIndex.Legendary or 5
local RARE_MYTHIC = Config.RarityIndex.Mythic or 6
local RARE_SECRET = Config.RarityIndex.Secret or 9
local RARE_INFINITY = Config.RarityIndex.Infinity or 12
local RARE_MODES: { [string]: boolean } = { Nest = true, Ground = true, Base = true }
local PILLAR_HEIGHT = 28

local GREEN = Color3.fromRGB(120, 255, 120)
local YELLOW = Color3.fromRGB(255, 230, 90)
local HATCH_COLOR = Color3.fromRGB(255, 220, 120)

function MeteorFactory.GetSize(entry): number
	local def = Config.MeteorsById[entry.Id]
	local rarity = def and Config.RaritiesByName[def.Rarity] or Config.Rarities[1]
	return rarity.Size * (1 + 0.025 * ((entry.Lv or 1) - 1))
end

local function makeLabel(parent: Instance, name: string, order: number, textSize: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, textSize + 4)
	label.LayoutOrder = order
	label.Font = Enum.Font.FredokaOne
	label.TextSize = textSize
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = ""
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label
	label.Parent = parent
	return label
end

-- mode: "Ground"/"Nest" (zeigt Preis), "Base" (Schlüpf-Countdown bzw. Einkommen + Level),
--       "Carry" (getragen: Schlüpfen pausiert)
function MeteorFactory.UpdateLabel(part: BasePart, entry, mode: string, price: number?)
	local gui = part:FindFirstChild("Info")
	if not gui then
		return
	end
	local frame = gui:FindFirstChild("Frame")
	local def = Config.MeteorsById[entry.Id]
	if not frame or not def then
		return
	end
	local nameLabel = frame:FindFirstChild("NameLabel") :: TextLabel?
	local rarityLabel = frame:FindFirstChild("RarityLabel") :: TextLabel?
	local valueLabel = frame:FindFirstChild("ValueLabel") :: TextLabel?
	if not nameLabel or not rarityLabel or not valueLabel then
		return
	end
	local rarity = Config.RaritiesByName[def.Rarity]
	local mut = Config.MutationsByName[entry.Mut] or Config.Mutations[1]

	nameLabel.Text = def.Name
	nameLabel.TextColor3 = rarity.Color
	local tag = def.Rarity == "Admin" and "👑 ADMIN" or def.Rarity
	if mut.Name ~= "Normal" then
		-- gleiche Symbole wie an den Aliens und auf der Schlüpf-Karte (Config.Mutations -> Icon)
		tag = (if type(mut.Icon) == "string" then mut.Icon .. " " else "") .. mut.Name .. " • " .. tag
	end
	rarityLabel.Text = tag
	rarityLabel.TextColor3 = mut.Color or rarity.Color
	if mode == "Ground" or mode == "Nest" then
		if price and price <= 0 then
			valueLabel.Text = "🎁 GRATIS!"
			valueLabel.TextColor3 = GREEN
		else
			valueLabel.Text = Util.FormatCash(price or Config.MeteorValue(entry))
			valueLabel.TextColor3 = YELLOW
		end
	elseif entry.Alien == nil then
		-- Noch nicht geschlüpft: der Client zählt über das Attribut "HatchAt" live herunter
		local hatch = math.max(0, tonumber(entry.Hatch) or 0)
		if mode == "Carry" and entry.Hatch == nil then
			-- frisch aus dem Nest/vom Boden geschnappt: Countdown startet erst in der Base
			valueLabel.Text = "🏠 Heimbringen! 🐣 " .. Util.FormatTime(Config.HatchTime(entry.Id))
		elseif mode == "Carry" then
			valueLabel.Text = "🐣 ⏸ " .. Util.FormatTime(hatch)
		elseif hatch <= 0 then
			valueLabel.Text = "🐣 Schlüpft..."
		else
			valueLabel.Text = "🐣 Schlüpft in " .. Util.FormatTime(hatch)
		end
		valueLabel.TextColor3 = HATCH_COLOR
	else
		local lv = entry.Lv or 1
		local lvText = lv >= Config.MaxLevel and "MAX" or tostring(lv)
		valueLabel.Text = Util.FormatCash(Config.MeteorIncome(entry)) .. "/s  ⚡Lv " .. lvText
		valueLabel.TextColor3 = GREEN
	end
end

-- Spezial-Effekte (Admin-Meteore): Regenbogen, Umriss, Aura, starkes Licht
local function addSpecialEffects(part: BasePart, def, color: Color3, size: number, mode: string)
	local fx = def.Effects
	if type(fx) ~= "table" then
		return
	end
	if fx.Rainbow then
		part:SetAttribute("Rainbow", true) -- Client färbt lokal durch alle Farben
	end
	if fx.Highlight and mode ~= "Carry" then
		-- startet AUS: der Client schaltet nur die nächsten paar Highlights ein (Roblox-Limit 31)
		local highlight = Instance.new("Highlight")
		highlight.Name = "AdminHighlight"
		highlight.Enabled = false
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.FillColor = color
		highlight.FillTransparency = 0.75
		highlight.OutlineColor = color:Lerp(Color3.new(1, 1, 1), 0.4)
		highlight.OutlineTransparency = 0
		if fx.Rainbow then
			highlight:SetAttribute("Rainbow", true)
		end
		highlight.Adornee = part
		highlight.Parent = part
	end
	if fx.Aura then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Aura"
		emitter.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.6))
		emitter.LightEmission = 1
		emitter.LightInfluence = 0
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, size * 0.12),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(0.8, 1.6)
		emitter.Speed = NumberRange.new(size * 0.4, size * 0.9)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Rate = mode == "Nest" and 12 or 25
		emitter.Parent = part
		if fx.Rainbow then
			emitter:SetAttribute("Rainbow", true)
		end
	end
	if fx.BigLight then
		local light = part:FindFirstChildOfClass("PointLight") or Instance.new("PointLight")
		light.Color = color
		light.Range = 30
		light.Brightness = 3
		light.Shadows = false
		light.Parent = part
		if fx.Rainbow then
			light:SetAttribute("Rainbow", true)
		end
	end
end

-- Farbverlauf durch alle Regenbogenfarben (für Säule + Aura der Secret/Admin-Eier)
local function rainbowSequence(): ColorSequence
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.85, 1)))
	end
	return ColorSequence.new(keys)
end

local function rareEmitter(name: string, part: BasePart, props: { [string]: any }): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Enabled = false -- der Client schaltet nur Emitter in Kameranähe ein (WorldFX)
	for key, value in pairs(props) do
		(emitter :: any)[key] = value
	end
	emitter.Parent = part
	return emitter
end

-- Lichtsäule, Glitzern, Funkenregen, Regenbogen-Aura (siehe Kopf der Datei)
local function addRareEffects(part: BasePart, rarityIndex: number, color: Color3, size: number)
	local tier = if rarityIndex == RARE_INFINITY
		then 4
		elseif rarityIndex >= RARE_SECRET then 3
		elseif rarityIndex >= RARE_MYTHIC then 2
		else 1
	local rainbow = tier >= 3
	part:SetAttribute("RareFX", tier)

	-- Lichtsäule: Beam von der Ei-Mitte senkrecht nach oben, unten kräftig, oben unsichtbar.
	local bottom = Instance.new("Attachment")
	bottom.Name = "PillarBottom"
	bottom.Parent = part
	local top = Instance.new("Attachment")
	top.Name = "PillarTop"
	top.Position = Vector3.new(0, PILLAR_HEIGHT + tier * 6, 0)
	top.Parent = part
	local beam = Instance.new("Beam")
	beam.Name = "RarePillar"
	beam.Attachment0 = bottom
	beam.Attachment1 = top
	beam.Color = if rainbow then rainbowSequence() else ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.5))
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(0.55, 0.75),
		NumberSequenceKeypoint.new(1, 1),
	})
	beam.Width0 = size * (if tier >= 4 then 1.2 else 0.85)
	beam.Width1 = size * (if tier >= 4 then 0.7 else 0.45)
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Segments = 1
	beam.Parent = part

	-- Glitzern in Seltenheitsfarbe
	rareEmitter("RareSparkle", part, {
		Color = if rainbow then rainbowSequence() else ColorSequence.new(color, Color3.new(1, 1, 1)),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, math.clamp(size * 0.09, 0.3, 0.7)),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new(0.1, 1),
		Lifetime = NumberRange.new(0.9, 1.6),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 2, 0),
		RotSpeed = NumberRange.new(-180, 180),
		Rate = 6 + tier * 5,
	})
	if tier >= 2 then
		-- Funkenregen: Funken spritzen hoch und regnen herunter
		rareEmitter("RareSparks", part, {
			Color = ColorSequence.new(Color3.new(1, 1, 1), color),
			Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.25),
				NumberSequenceKeypoint.new(1, 0),
			}),
			Transparency = NumberSequence.new(0, 0.6),
			Lifetime = NumberRange.new(0.8, 1.3),
			Speed = NumberRange.new(8, 13),
			SpreadAngle = Vector2.new(28, 28),
			EmissionDirection = Enum.NormalId.Top,
			Acceleration = Vector3.new(0, -24, 0),
			Drag = 0.5,
			Rate = 8 + tier * 3,
		})
	end
	if rainbow then
		-- Regenbogen-Aura: große weiche Kugeln in allen Farben um das Ei
		rareEmitter("RareAura", part, {
			Color = rainbowSequence(),
			Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, size * 0.25),
				NumberSequenceKeypoint.new(1, size * 0.5),
			}),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.3, 0.6),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(1.2, 1.8),
			Speed = NumberRange.new(size * 0.3, size * 0.6),
			SpreadAngle = Vector2.new(180, 180),
			Rate = 10,
		})
	end
	if tier >= 4 then
		-- Infinity: helle Sterne kreisen um das Ei und steigen langsam auf
		rareEmitter("RareInfinity", part, {
			Texture = "rbxasset://textures/particles/sparkles_main.dds",
			Color = ColorSequence.new(Color3.new(1, 1, 1), color),
			Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, size * 0.18),
				NumberSequenceKeypoint.new(1, 0),
			}),
			Transparency = NumberSequence.new(0, 0.8),
			Lifetime = NumberRange.new(1.5, 2.5),
			Speed = NumberRange.new(1, 2),
			SpreadAngle = Vector2.new(180, 180),
			Acceleration = Vector3.new(0, 3, 0),
			RotSpeed = NumberRange.new(90, 270),
			Rate = 14,
		})
	end
end

-- mode: "Nest" (in einem Nest im Ei-Rennen), "Ground" (Gratis-Zone/Showcase), "Base" (in der Base), "Carry" (getragen)
function MeteorFactory.Create(entry, mode: string, price: number?): BasePart
	local def = Config.MeteorsById[entry.Id]
	assert(def, "Unbekannter Meteor: " .. tostring(entry.Id))
	local rarity = Config.RaritiesByName[def.Rarity]
	local rarityIndex = Config.RarityIndex[def.Rarity]
	local mut = Config.MutationsByName[entry.Mut] or Config.Mutations[1]
	local size = MeteorFactory.GetSize(entry)
	local isAdmin = rarity.AdminOnly == true

	local part = Instance.new("Part")
	part.Name = "Meteor"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(size, size, size)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = size >= SHADOW_MIN_SIZE and mode ~= "Nest"
	part.Material = isAdmin and Enum.Material.Neon or Enum.Material.Slate
	part.Color = def.Color
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth

	if mut.Name == "Gold" then
		part.Material = Enum.Material.Foil
		part.Color = mut.Color
	elseif mut.Name == "Diamond" then
		-- türkises Glas + Glitzern (unten bei den Effekten) – so sieht man den Unterschied zu Frost
		part.Material = Enum.Material.Glass
		part.Transparency = 0.15
		part.Color = mut.Color
	elseif mut.Name == "Galaxy" or mut.Name == "Lava" then
		-- Galaxy leuchtet lila, Lava glühend orange (+ kleines Feuer, unten bei den Effekten)
		part.Material = Enum.Material.Neon
		part.Color = mut.Color
	elseif mut.Name == "Frost" then
		-- hellblaues Eis: heller und weißlicher als Diamond, dazu fallen Schneeflocken (unten)
		part.Material = Enum.Material.Glass
		part.Transparency = 0.1
		part.Reflectance = 0.15
		part.Color = mut.Color:Lerp(Color3.new(1, 1, 1), FROST_WHITEN)
	elseif mut.Rainbow == true then
		-- Regenbogen: der Client färbt alle Teile mit dem Attribut "Rainbow" lokal durch
		part.Material = Enum.Material.Neon
		part.Color = mut.Color or Color3.new(1, 1, 1)
		part:SetAttribute("Rainbow", true)
	end

	part:SetAttribute("MeteorId", entry.Id)
	part:SetAttribute("Mutation", mut.Name)
	part:SetAttribute("Rarity", def.Rarity)

	-- Leuchten / Feuer / Funken nur für seltene Meteore (siehe Tabellen oben)
	local lightFrom = LIGHT_FROM[mode] or 5
	if rarityIndex >= lightFrom and not isAdmin then
		local light = Instance.new("PointLight")
		light.Color = rarity.Color
		light.Range = 6 + rarityIndex * 1.5
		light.Brightness = 1 + rarityIndex * 0.2
		light.Shadows = false
		light.Parent = part
	end
	if rarityIndex >= (FIRE_FROM[mode] or 99) and not isAdmin then
		local fire = Instance.new("Fire")
		fire.Color = rarity.Color
		fire.SecondaryColor = def.Color
		fire.Size = size * 0.9
		fire.Heat = 4
		fire.Parent = part
	end
	if mut.Name == "Lava" and not part:FindFirstChildOfClass("Fire") then
		-- Lava-Mutation: kleines Feuer. Im Nest startet es AUS (mit Glück-Events sind dort
		-- viele Lava-Meteore): der Client schaltet nur die nächsten paar ein (Attribut "LavaFire", WorldFX).
		local fire = Instance.new("Fire")
		fire.Color = mut.Color
		fire.SecondaryColor = Color3.fromRGB(120, 20, 0)
		fire.Size = math.max(1.5, size * 0.45)
		fire.Heat = 3
		if mode == "Nest" then
			fire.Enabled = false
			fire:SetAttribute("LavaFire", true)
		end
		fire.Parent = part
	end
	if mut.Name == "Frost" then
		-- Frost-Mutation: ein paar Schneeflocken rieseln herunter
		local snow = Instance.new("ParticleEmitter")
		snow.Name = "FrostSnow"
		snow.Color = ColorSequence.new(Color3.new(1, 1, 1))
		snow.LightEmission = 0.5
		snow.LightInfluence = 0
		snow.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, math.clamp(size * 0.07, 0.15, 0.45)),
			NumberSequenceKeypoint.new(1, 0),
		})
		snow.Lifetime = NumberRange.new(1, 1.6)
		snow.Speed = NumberRange.new(0.5, 1.5)
		snow.SpreadAngle = Vector2.new(180, 180)
		snow.Acceleration = Vector3.new(0, -4, 0)
		snow.Rate = if mode == "Nest" then 3 else 6
		snow.Parent = part
	end
	local specialMut = mut.Name == "Galaxy" or mut.Name == "Diamond" or mut.Rainbow == true
	if (rarityIndex >= (SPARKLES_FROM[mode] or 99) or (specialMut and mode ~= "Carry")) and not isAdmin then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = mut.Color or rarity.Color
		sparkles.Parent = part
	end
	addSpecialEffects(part, def, part.Color, size, mode)
	if rarityIndex >= RARE_FROM and RARE_MODES[mode] then
		addRareEffects(part, rarityIndex, rarity.Color, size)
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.new(0, 220, 0, 70)
	gui.StudsOffset = Vector3.new(0, size / 2 + 1.8, 0)
	if mode == "Nest" then
		gui.MaxDistance = 45 + rarityIndex * 8 -- viele Schilder im Nester-Feld: nur in der Nähe zeigen
	elseif mode == "Carry" then
		gui.MaxDistance = 60
	else
		gui.MaxDistance = 70 + rarityIndex * 15
	end
	gui.LightInfluence = 0
	gui.Parent = part

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Parent = frame

	makeLabel(frame, "NameLabel", 1, 20)
	makeLabel(frame, "RarityLabel", 2, 15)
	makeLabel(frame, "ValueLabel", 3, 17)

	MeteorFactory.UpdateLabel(part, entry, mode, price)
	return part
end

-- Passt Größe + Schild an (z.B. nach Level-Änderung durch den Admin)
function MeteorFactory.Refresh(part: BasePart, entry, mode: string)
	local size = MeteorFactory.GetSize(entry)
	local bottom = part.Position.Y - part.Size.Y / 2
	part.Size = Vector3.new(size, size, size)
	part.Position = Vector3.new(part.Position.X, bottom + size / 2, part.Position.Z)
	local gui = part:FindFirstChild("Info")
	if gui and gui:IsA("BillboardGui") then
		gui.StudsOffset = Vector3.new(0, size / 2 + 1.8, 0)
	end
	local beam = part:FindFirstChild("RarePillar")
	if beam and beam:IsA("Beam") then
		local wide = part:GetAttribute("RareFX") == 4 -- Infinity: breitere Säule
		beam.Width0 = size * (if wide then 1.2 else 0.85)
		beam.Width1 = size * (if wide then 0.7 else 0.45)
	end
	local fire = part:FindFirstChildOfClass("Fire")
	if fire then
		local mut = Config.MutationsByName[entry.Mut]
		-- Lava-Feuer bleibt klein, Seltenheits-Feuer wächst mit
		local onlyLava = mut ~= nil and mut.Name == "Lava" and fire.Color == mut.Color
		fire.Size = onlyLava and math.max(1.5, size * 0.45) or size * 0.9
	end
	MeteorFactory.UpdateLabel(part, entry, mode)
end

-- distance = optionale Aktivierungs-Reichweite (sonst aus der Größe des Teils)
-- Hinweis: Zwei Prompts am selben Teil (z.B. Schnappen + Kaufen am Nest) bekommen über
-- prompt.UIOffset (Pixel) verschiedene Plätze, sonst liegen sie übereinander.
function MeteorFactory.AddPrompt(
	part: BasePart,
	name: string,
	action: string,
	objectText: string,
	hold: number,
	key: Enum.KeyCode?,
	distance: number?
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = distance or math.max(10, part.Size.X / 2 + 7)
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = key or Enum.KeyCode.E
	prompt.Parent = part
	return prompt
end

-- -------------------------------------------------------------------
-- HALTEN PRÜFEN (gegen "sofort auslösen"-Cheats)
-- "Triggered" schickt der Client. Ein Cheater kann einen Prompt auch ohne Halten auslösen
-- (z.B. HoldDuration lokal auf 0). Deshalb merkt sich der Server, wann der Spieler angefangen
-- hat zu halten (PromptButtonHoldBegan kommt auch auf dem Server an), und ruft callback nur auf,
-- wenn wirklich so lange gehalten wurde, wie die HoldDuration HIER auf dem Server sagt.
-- -------------------------------------------------------------------
local HOLD_TOLERANCE = 0.15 -- Sekunden Spielraum für Netzwerk-Schwankungen
local HOLD_MAX_EXTRA = 3 -- ein Halten zählt höchstens so lange über die HoldDuration hinaus

function MeteorFactory.OnHeldTrigger(prompt: ProximityPrompt, callback: (player: Player) -> ())
	local started: { [Player]: number } = {}
	local ended: { [Player]: number } = {}
	prompt.PromptButtonHoldBegan:Connect(function(player: Player)
		started[player] = os.clock()
		ended[player] = nil
	end)
	prompt.PromptButtonHoldEnded:Connect(function(player: Player)
		-- (kommt evtl. kurz VOR Triggered an -> Zeitpunkt merken statt löschen)
		if started[player] then
			ended[player] = os.clock()
		end
	end)
	prompt.Triggered:Connect(function(player: Player)
		local hold = prompt.HoldDuration
		if hold > 0 then
			local t = os.clock()
			local begin = started[player]
			local release = ended[player]
			started[player] = nil
			ended[player] = nil
			if not begin then
				return -- nie angefangen zu halten
			end
			local heldUntil = if release then math.min(release, t) else t
			if heldUntil - begin < hold - HOLD_TOLERANCE or t - begin > hold + HOLD_MAX_EXTRA then
				return -- zu kurz gehalten (oder ein uraltes Halten)
			end
		end
		callback(player)
	end)
end

return MeteorFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">MeteorService</string>
            <string name="Source"><![CDATA[-- Meteore: das EI-RENNEN (Nester-Feld in der Map-Mitte), die Gratis-Zone am Spawn-Platz, Eier am Boden,
-- Meteoritenschauer, EGG RUSH, RENNEN-EVENT (Gold-Ei), Server-Glück und der GLÜCKS-ZÄHLER (Config.Pity).
-- NACHT (NightService): Nacht-Eier in den Nestern, Sternschnuppen-Eier (SpawnSkyEgg), Blutmond-Glück.
-- Öffentliche Nacht-API (auch fürs Admin-Panel): MeteorService.StartNight(bloodMoon?, seconds?),
-- MeteorService.EndNight(), MeteorService.IsNight(), MeteorService.IsBloodMoon().
--
-- NESTER (MapBuilder baut sie, Ordner "NestField"): alle paar Sekunden erscheint in einem zufälligen
-- freien Nest ein Ei, liegt eine Weile und verschwindet wieder (Config.Nests).
--   kleine Nester: oft, normale Seltenheiten
--   große Nester:  seltener, mindestens Config.Nests.BigMinRarity, viel öfter Legendary+ (Lichtsäule + Ansage)
-- Jedes Ei hat ZWEI Knöpfe – wer zuerst kommt, bekommt es:
--   E halten = SCHNAPPEN (GrabPrompt): gratis, aber man muss es selbst nach Hause TRAGEN
--              (CarryService, Source = "Ground"). Klappt das nicht (Schläger, Kreatur, Tod, Falle, zu langsam),
--              fällt es als GRATIS-Ei auf den Boden und jeder kann es schnappen.
--   F        = KAUFEN (BuyPrompt): kostet Cash, fliegt automatisch in die eigene Base.
-- EIER AM BODEN ("Drop"): fallen gelassen, Egg Rush, Sternschnuppen – nur E = Schnappen und Tragen.
-- RENNEN (Config.Race): Gold-Ei im entferntesten großen Nest. Wer es zuerst heimbringt, bekommt das Ei
-- (mindestens Legendary) + Cash (CarryService meldet die Ankunft über MeteorService.FinishRace).
--
-- PERFORMANCE: Nest-Eier liegen still (verankert, keine Bewegung). Höchstens Config.Nests.MaxEggs
-- (+ große Nester) gleichzeitig. Das "Pop" beim Erscheinen macht der Client lokal.
-- METEORITENSCHAUER: Eier kommen viel öfter, mehr große Nester gleichzeitig.
-- ANTI-CHEAT: Halten wird serverseitig geprüft (MeteorFactory.OnHeldTrigger), Schnappen/Kaufen ist
-- pro Spieler gebremst, Eingefrorene (Falle/Admin) können nichts nehmen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))

local MeteorService = {}
local Services

local rng = Random.new()

-- Ein Nest aus der Map (Teil "Nest" im Ordner NestField/Nests)
type Nest = {
	Part: BasePart,
	EggPoint: Vector3, -- Unterkante des Eis (Mitte der Mulde)
	Big: boolean,
	Race: boolean, -- Renn-Nest (dort erscheint das Gold-Ei)
	Pillar: Beam?, -- Lichtsäule großer Nester (an, solange ein Ei drin liegt)
	Record: any, -- Ei, das gerade drin liegt (nil = frei)
}

-- Eier in Nestern: { Kind = "Nest", Entry, Part, Price, Position, Expires, Claimed, Landed, ClientReach, Nest, Race? }
local nestRecords = {}
-- Gratis-Zone/Showcase (Kaufen/Schnappen = fliegt automatisch in die Base):
--   { Kind = "Ground", Entry, Part, Price, Position, Expires, Claimed, Landed, ClientReach }
local groundRecords = {}
-- Eier am Boden zum Schnappen + Tragen (fallen gelassen / Egg Rush / Sternschnuppe):
--   { Kind = "Drop", Entry, Part, Price = 0, Position, Expires, Claimed, Landed, ClientReach, EggRush }
local dropRecords = {}
local nestFolder: Folder
local groundFolder: Folder
local fieldFolder: Instance? = nil

local smallNests: { Nest } = {}
local bigNests: { Nest } = {}
local raceNest: Nest? = nil
-- Warteschlange vom Admin (Eierregen, Ei ins Nester-Feld): ein Ei pro Schritt
local nestQueue = {}
local nextSmallAt = 0 -- os.clock()
local nextBigAt = 0

local NESTS = Config.Nests
local BIG_MIN = Config.RarityIndex[NESTS.BigMinRarity] or 4
local NEST_REACH = tonumber(NESTS.Reach) or 9
local NEST_DROP_CLEAR = 4 -- kein neues Ei in ein Nest, auf dem ein fallen gelassenes Ei liegt
local NEST_RANDOM_TRIES = 8
local BIG_ANNOUNCE = Config.RarityIndex.Legendary or 5 -- ab hier: Ansage + Effekt am großen Nest
local QUEUE_BIG_FROM = Config.RarityIndex.Legendary or 5 -- Admin-Eier ab hier in große Nester

-- Eier am Boden liegen still: Spielraum nur für die Bewegung des Spielers während der Ping-Zeit
local STATIC_REACH_BASE = 2
local STATIC_REACH_PER_SPEED = 0.1 -- pro Laufgeschwindigkeit
local STATIC_REACH_MIN = 3
local STATIC_REACH_MAX = 10
local FALL_TIME = 0.9 -- so lange fliegt ein Meteor vom Himmel bzw. in die Base (Client-Effekt)
-- Zwei Knöpfe am selben Ei: Schnappen oben, Kaufen darunter (Pixel), sonst liegen sie übereinander
local GRAB_UI_OFFSET = Vector2.new(0, -40)
local BUY_UI_OFFSET = Vector2.new(0, 40)
local RARE_GRAB_ANNOUNCE = Config.RarityIndex.Mythic or 6 -- ab Mythic: allen sagen, wer gerade schnappt
local ADMIN_SPAWN_ANNOUNCE = Config.RarityIndex.Mythic or 6 -- vom Admin bestellte Eier: schon ab Mythic
-- ab Secret (auch Admin-Eier): Ansage IMMER (nicht gebremst) – so ein Ei will niemand verpassen
local SECRET_SPAWN_ANNOUNCE = Config.RarityIndex.Secret or 9
local RARE_ANNOUNCE_GAP = 4 -- solche Ansagen höchstens alle 4 Sekunden (sonst ist der Bildschirm voll)
-- Schnappen/Kaufen pro Spieler höchstens so oft pro Sekunde (gegen Massen-Auslösen per Cheat)
local actionLimiter = Util.RateLimiter(6, 1)

-- Egg Rush: Eier fallen nacheinander (sieht nach Regen aus) aus dieser Höhe aufs Nester-Feld
local EGG_RUSH_SKY = 120
local EGG_RUSH_SPAWN_GAP = 0.08
local EGG_SPOT_TRIES = 30 -- Versuche pro Ei, einen freien Platz zu finden
local EGG_EDGE_MARGIN = 8 -- Abstand zum Map-Rand
local EGG_FIELD_MARGIN = 2 -- Abstand zum Rand des Nester-Felds
local EGG_PLOT_MARGIN = 3 -- Abstand zu Basen
local EGG_SPACING = 3 -- Abstand zwischen zwei Eiern
local EGG_RUSH_SHOWER_GAP = 60 -- Egg Rush nicht direkt vor/nach dem Meteoritenschauer
local SHOWER_AFTER_RUSH = 20 -- Schauer wartet, bis der Egg Rush (oder das Rennen) vorbei ist (+ so viele Sekunden)
-- Ersatz-Grenzen, falls die Map keine "Boundary"-Wände hat
local FALLBACK_AREA = { MinX = -168, MaxX = 168, MinZ = -406, MaxZ = 256 }

-- RENNEN (Config.Race)
local RACE = Config.Race
local RACE_MIN = Config.RarityIndex[RACE.MinRarity] or 5
local RACE_BUSY_GAP = 60 -- Rennen nicht kurz vor Egg Rush / Schauer
local RACE_NIGHT_GAP = 30 -- ... und nicht kurz vor dem Nacht-Beginn
local RACE_RETRY = 45 -- war gerade etwas los: so viele Sekunden später nochmal versuchen
local RACE_LOST_CHECKS = 3 -- Gold-Ei so oft hintereinander nicht gefunden -> Rennen vorbei
local raceActive = false
local raceId = 0
local raceUntil = 0
local nextRaceAt = 0
local raceLost = 0

local serverLuckMult = 1
local serverLuckUntil = 0
local showerUntil = 0
local nextShowerAt = 0
local eggRushUntil = 0
local nextEggRushAt = 0
local lastRareAnnounce = -math.huge

-- GLÜCKS-ZÄHLER (pro Server): Nest-Eier seit dem letzten Legendary+ (siehe Config.Pity)
local PITY = Config.Pity or { Step = 20, Bonus = 0.25, Max = 3, FromRarity = "Legendary" }
local PITY_FROM = Config.RarityIndex[PITY.FromRarity] or 5
local PITY_FULL = math.ceil((PITY.Max - 1) / PITY.Bonus) * PITY.Step -- ab so vielen Eiern ist das Glück voll
local pityCount = 0
local NIGHT = Config.Night or {}

-- -------------------------------------------------------------------
-- GLÜCK & EVENTS
-- -------------------------------------------------------------------
local function now(): number
	return workspace:GetServerTimeNow()
end

-- Glück für Legendary+ durch den Glücks-Zähler (1 = kein Bonus)
local function pityMult(): number
	return math.min(PITY.Max, 1 + math.floor(pityCount / PITY.Step) * PITY.Bonus)
end

-- (nur bei Änderung schreiben: die Nester würfeln ~2 Eier pro Sekunde)
local function setAttributeIfChanged(name: string, value: number)
	if ReplicatedStorage:GetAttribute(name) ~= value then
		ReplicatedStorage:SetAttribute(name, value)
	end
end

local function publishPity()
	setAttributeIfChanged("PityCount", pityCount)
	setAttributeIfChanged("PityFull", PITY_FULL)
	setAttributeIfChanged("PityMult", pityMult())
end

-- Nacht / Blutmond (NightService fehlt -> immer Tag)
local function nightState(): (boolean, boolean)
	local night = Services and Services.NightService
	if night then
		return night.IsNight(), night.IsBloodMoon()
	end
	return false, false
end

local function publishAttributes()
	ReplicatedStorage:SetAttribute("LuckMult", serverLuckMult)
	ReplicatedStorage:SetAttribute("LuckUntil", serverLuckUntil)
	ReplicatedStorage:SetAttribute("ShowerUntil", showerUntil)
	ReplicatedStorage:SetAttribute("NextShowerAt", nextShowerAt)
	ReplicatedStorage:SetAttribute("EggRushUntil", eggRushUntil)
	ReplicatedStorage:SetAttribute("NextEggRushAt", nextEggRushAt)
	ReplicatedStorage:SetAttribute("RaceUntil", if raceActive then raceUntil else 0)
	ReplicatedStorage:SetAttribute("NextRaceAt", nextRaceAt)
end

-- Ansage an alle für seltene Eier (Nester, Schnappen) – höchstens alle RARE_ANNOUNCE_GAP Sekunden,
-- überzählige fallen weg (sonst verdrängen sie wichtige eigene Meldungen wie den Diebstahl-Alarm)
local function rareAnnounce(text: string)
	local t = os.clock()
	if t - lastRareAnnounce < RARE_ANNOUNCE_GAP then
		return
	end
	lastRareAnnounce = t
	Services.EconomyService.NotifyAll(text, "Event")
end

function MeteorService.IsShowerActive(): boolean
	return showerUntil > now()
end

function MeteorService.IsEggRushActive(): boolean
	return eggRushUntil > now()
end

function MeteorService.GetLuck(): number
	local luck = 1
	if serverLuckUntil > now() then
		luck *= serverLuckMult
	end
	if MeteorService.IsShowerActive() then
		luck *= Config.ShowerLuck
	end
	local _, bloodMoon = nightState()
	if bloodMoon then
		luck *= tonumber(NIGHT.BloodMoonLuck) or 2
	end
	return luck
end

-- -------------------------------------------------------------------
-- NACHT-API (die Arbeit macht NightService; hier nur weitergereicht, damit alles an EINER Stelle ist)
-- -------------------------------------------------------------------
function MeteorService.IsNight(): boolean
	local night = nightState()
	return night
end

function MeteorService.IsBloodMoon(): boolean
	local _, bloodMoon = nightState()
	return bloodMoon
end

-- Nacht sofort starten (bloodMoon = true -> Blutmond), seconds = Länge (Standard Config.Night.NightLength)
function MeteorService.StartNight(bloodMoon: boolean?, seconds: number?): boolean
	local night = Services and Services.NightService
	if not night then
		return false
	end
	night.StartNight(bloodMoon == true, seconds)
	return true
end

-- Nacht sofort beenden (Sonnenaufgang)
function MeteorService.EndNight(): boolean
	local night = Services and Services.NightService
	if not night then
		return false
	end
	night.EndNight()
	return true
end

-- Verlängert laufendes Glück, statt es zu überschreiben
function MeteorService.AddServerLuck(mult: number, seconds: number)
	local t = now()
	if serverLuckUntil > t and mult <= serverLuckMult then
		serverLuckUntil += seconds
	else
		serverLuckMult = mult
		serverLuckUntil = math.max(serverLuckUntil, t) + seconds
	end
	publishAttributes()
end

function MeteorService.SetServerLuck(mult: number, untilTime: number)
	serverLuckMult = mult
	serverLuckUntil = untilTime
	publishAttributes()
end

function MeteorService.StartShower(duration: number?)
	local t = now()
	showerUntil = math.max(showerUntil, t) + (duration or Config.ShowerDuration)
	nextShowerAt = showerUntil + Config.ShowerInterval
	nextBigAt = 0 -- große Nester sofort füllen
	publishAttributes()
	-- Im Schauer gibt es keine Locks! (Ein gekauftes Base-Schild bleibt aber an.)
	for _, plot in ipairs(Services.PlotService.Plots) do
		if not Services.PlotService.IsShielded(plot) then
			Services.PlotService.SetLocked(plot, 0)
		end
	end
	Services.EconomyService.NotifyAll(
		"🌠 METEORITENSCHAUER! Volle Nester, keine Locks, " .. Config.ShowerLuck .. "x Glück!",
		"Event"
	)
end

-- -------------------------------------------------------------------
-- ZUFALL
-- -------------------------------------------------------------------
-- luck: ab Rare mal Glück. pity: nur Legendary+ mal Glücks-Zähler. Nachts: Godly+ mal NightMult.
-- minIndex (optional): nur Seltenheiten ab diesem Index (große Nester, Gold-Ei)
function MeteorService.RollRarity(luck: number, pity: number?, minIndex: number?)
	local night = nightState()
	local pityBonus = pity or 1
	return Util.WeightedPick(Config.Rarities, function(rarity)
		if rarity.AdminOnly or #Config.MeteorsByRarity[rarity.Name] == 0 then
			return 0
		end
		local index = Config.RarityIndex[rarity.Name]
		if minIndex and index < minIndex then
			return 0
		end
		local weight = index >= 3 and rarity.Weight * luck or rarity.Weight
		if index >= PITY_FROM then
			weight *= pityBonus
		end
		if night and rarity.NightMult then
			weight *= rarity.NightMult
		end
		return weight
	end, rng)
end

function MeteorService.RollMutation(luck: number): string
	local mut = Util.WeightedPick(Config.Mutations, function(m)
		return m.Name == "Normal" and m.Weight or m.Weight * luck
	end, rng)
	return mut.Name
end

-- Zufälliger Meteor einer Seltenheit (nur Meteore, die von selbst in die Nester kommen; includeAll = auch Admin/nicht spawnbare)
-- Nachts kommen die Nacht-Eier dazu (je Config.Night.NightEggWeight so oft wie ein normales Ei).
function MeteorService.RandomOfRarity(rarityName: string, includeAll: boolean?)
	local list = Config.MeteorsByRarity[rarityName]
	if (not list or #list == 0) and includeAll then
		list = Config.MeteorsByRarityAll[rarityName]
	end
	if not list or #list == 0 then
		return nil
	end
	local night, bloodMoon = nightState()
	local nightList = Config.NightMeteorsByRarity and Config.NightMeteorsByRarity[rarityName]
	if night and nightList and #nightList > 0 then
		local nightWeight = tonumber(NIGHT.NightEggWeight) or 2
		local pool = {}
		for _, def in ipairs(list) do
			table.insert(pool, { Def = def, Weight = 1 })
		end
		for _, def in ipairs(nightList) do
			if bloodMoon or def.BloodMoonOnly ~= true then
				table.insert(pool, { Def = def, Weight = nightWeight })
			end
		end
		return Util.WeightedPick(pool, nil, rng).Def
	end
	return list[rng:NextInteger(1, #list)]
end

function MeteorService.RandomAdminMeteor()
	local list = Config.AdminMeteors
	if #list == 0 then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

-- Neuer (noch nicht gekaufter) Eintrag – Hatch/Alien kommen erst in der Base dazu
-- pity = Glücks-Bonus für Legendary+ (nur natürliche Nest-Eier, siehe rollNestEntry), minIndex siehe RollRarity
function MeteorService.RollEntry(luck: number?, pity: number?, minIndex: number?)
	local l = luck or MeteorService.GetLuck()
	local rarity = MeteorService.RollRarity(l, pity, minIndex)
	local def = MeteorService.RandomOfRarity(rarity.Name) or Config.Meteors[1]
	return { Id = def.Id, Mut = MeteorService.RollMutation(l), Lv = 1, Xp = 0 }
end

-- Natürliches Nest-Ei: mit Glücks-Zähler. Legendary+ setzt ihn zurück, sonst +1.
-- big = großes Nest (mehr Glück, mindestens Config.Nests.BigMinRarity)
local function rollNestEntry(big: boolean)
	local luck = MeteorService.GetLuck() * (if big then tonumber(NESTS.BigLuck) or 1 else 1)
	local entry = MeteorService.RollEntry(luck, pityMult(), if big then BIG_MIN else nil)
	local def = Config.MeteorsById[entry.Id]
	if def and (Config.RarityIndex[def.Rarity] or 1) >= PITY_FROM then
		pityCount = 0
	else
		pityCount += 1
	end
	publishPity()
	return entry
end

-- opts: { Id?, Mut?, Rarity? } -> Eintrag (oder nil, wenn es die Seltenheit nicht gibt)
local function makeEntry(opts)
	local entry
	local luck = MeteorService.GetLuck()
	if opts.Id and Config.MeteorsById[opts.Id] then
		entry = { Id = opts.Id, Mut = opts.Mut or MeteorService.RollMutation(luck), Lv = 1, Xp = 0 }
	elseif opts.Rarity and Config.RaritiesByName[opts.Rarity] then
		local def = MeteorService.RandomOfRarity(opts.Rarity, true)
		if not def then
			return nil
		end
		entry = { Id = def.Id, Mut = opts.Mut or MeteorService.RollMutation(luck), Lv = 1, Xp = 0 }
	else
		entry = MeteorService.RollEntry(luck)
	end
	if not Config.MutationsByName[entry.Mut] then
		entry.Mut = "Normal"
	end
	return entry
end

-- -------------------------------------------------------------------
-- EINTRÄGE (Nest, Gratis-Zone, Boden)
-- -------------------------------------------------------------------
local function listFor(kind: string)
	if kind == "Nest" then
		return nestRecords
	elseif kind == "Drop" then
		return dropRecords
	end
	return groundRecords
end

-- Nest wieder frei: Lichtsäule aus
local function freeNest(nest: Nest?, record)
	if nest and nest.Record == record then
		nest.Record = nil
		if nest.Pillar then
			nest.Pillar.Enabled = false
		end
	end
end

local function removeRecord(record)
	local list = listFor(record.Kind)
	local index = table.find(list, record)
	if index then
		table.remove(list, index)
	end
	freeNest(record.Nest, record)
	if record.Part then
		record.Part:Destroy()
		record.Part = nil
	end
end

local function currentPosition(record): Vector3?
	if not record.Part then
		return nil
	end
	return record.Position
end

local function rarityIndexOf(entry): number
	local def = Config.MeteorsById[entry.Id]
	return def and Config.RarityIndex[def.Rarity] or 1
end

-- Schild "🏁 GOLD-EI" über dem Renn-Ei (immer sichtbar, auch durch Wände)
local function addRaceMarker(part: BasePart)
	part:SetAttribute("RaceEgg", true)
	local gui = Instance.new("BillboardGui")
	gui.Name = "RaceMarker"
	gui.Size = UDim2.fromOffset(170, 46)
	gui.StudsOffset = Vector3.new(0, part.Size.Y / 2 + 6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 1000
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "🏁 GOLD-EI"
	label.TextColor3 = Color3.fromRGB(255, 215, 60)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = gui
end

-- -------------------------------------------------------------------
-- KAUFEN / KLAUEN / SCHNAPPEN (alles serverseitig geprüft)
-- -------------------------------------------------------------------
local function aliveRoot(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return root
end

-- Eingefroren (Falle / Admin-Freeze = HumanoidRootPart verankert)? Dann wird nichts genommen.
local function isFrozen(player: Player, root: BasePart): boolean
	if root.Anchored then
		Services.EconomyService.Notify(player, "🧊 Du bist eingefroren!", "Error")
		return true
	end
	return false
end

-- Liegt diese Stelle in einer gesperrten Base (Lock oder Base-Schild)? -> diese Base, sonst nil
local function lockedPlotAt(position: Vector3)
	local Plot = Services.PlotService
	for _, plot in ipairs(Plot.Plots) do
		if plot.Owner and Plot.IsInside(plot, position) and Plot.IsLocked(plot) then
			return plot
		end
	end
	return nil
end

-- Steht der Spieler nah genug dran (analytisch, mit Toleranz) und hat sich nicht unmöglich schnell
-- bewegt? Gibt die aktuelle Meteor-Position zurück, sonst nil (Hinweis wurde dann schon geschickt).
local function checkReach(player: Player, record, root: BasePart): Vector3?
	local position = currentPosition(record)
	if not position then
		return nil
	end
	-- liegt still: nur Spielraum für die eigene Bewegung (schnelle Spieler etwas mehr)
	local clientReach = record.ClientReach or 10
	local offset = root.Position - position
	local character = root.Parent
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local walkSpeed = if humanoid then humanoid.WalkSpeed else Config.NormalWalkSpeed
	local extra = math.clamp(STATIC_REACH_BASE + walkSpeed * STATIC_REACH_PER_SPEED, STATIC_REACH_MIN, STATIC_REACH_MAX)
	local tooFar = offset.Magnitude > clientReach + extra
	if tooFar then
		Services.EconomyService.Notify(player, "🏃 Zu weit weg – lauf näher ran!", "Error")
		return nil
	end
	-- Die Position kommt vom Client: wer gerade unmöglich weit "gesprungen" ist (Teleport-Exploit),
	-- darf nicht kaufen/klauen. (Server-Teleports wie Home sind erlaubt, danach kurz warten.)
	if Services.CarryService.MoveStatus(player) ~= "ok" then
		Services.EconomyService.Notify(player, "⏳ Kurz warten und nochmal versuchen!", "Error")
		return nil
	end
	return position
end

-- KAUFEN (Nest, F) / Schnappen in der Gratis-Zone: fliegt AUTOMATISCH in einen freien Slot
local function tryClaim(player: Player, record)
	if record.Claimed or not record.Part or record.Landed == false or record.Race then
		return
	end
	if not actionLimiter.Check(player) then
		return -- zu viele Versuche auf einmal (Cheat) -> still ignorieren
	end
	local data = Services.DataService.Get(player)
	if not data or not Services.EconomyService.IsReady(player) then
		return
	end
	local root = aliveRoot(player)
	if not root or isFrozen(player, root) then
		return
	end
	local position = checkReach(player, record, root)
	if not position then
		return
	end
	local plot = Services.PlotService.GetPlot(player)
	if not plot then
		Services.EconomyService.Notify(player, "Du hast keine Base auf diesem Server.", "Error")
		return
	end
	local slot = Services.PlotService.FreeSlot(player)
	if not slot then
		Services.EconomyService.Notify(player, "📦 Deine Base ist voll! Verkaufe erst etwas.", "Error")
		return
	end
	local def = Config.MeteorsById[record.Entry.Id]
	if record.Price > 0 then
		-- Rebirth-Anforderung gilt nur fürs KAUFEN – klauen geht immer
		local rarity = Config.RaritiesByName[def.Rarity]
		local required = rarity.RequiredRebirths or 0
		if data.Rebirths < required then
			Services.EconomyService.Notify(
				player,
				"🔥 " .. def.Rarity .. " braucht " .. required .. " Rebirth(s) zum Kaufen – schnappen geht! 😈",
				"Error"
			)
			return
		end
		if data.Cash < record.Price then
			Services.EconomyService.Notify(
				player,
				"💸 Nicht genug Cash! Du brauchst " .. Util.FormatCash(record.Price) .. " – oder schnapp es gratis!",
				"Error"
			)
			return
		end
		data.Cash -= record.Price
		data.Stats.Bought += 1
	end
	record.Claimed = true
	local entry = record.Entry
	removeRecord(record)
	Services.EconomyService.DeliverMeteor(player, plot, slot, entry, position)
	Services.EconomyService.Notify(
		player,
		(record.Price > 0 and "✅ Gekauft: " or "🎁 Geschnappt: ") .. def.Name .. "! Gleich schlüpft ein Alien 🐣",
		"Success"
	)
end

-- SCHNAPPEN aus einem Nest (E) / eines Eis am Boden: gratis, aber selbst nach Hause tragen
local function tryGrab(player: Player, record)
	if record.Claimed or not record.Part or record.Landed == false then
		return
	end
	if not actionLimiter.Check(player) then
		return -- zu viele Versuche auf einmal (Cheat) -> still ignorieren
	end
	local data = Services.DataService.Get(player)
	if not data or not Services.EconomyService.IsReady(player) then
		return
	end
	local root = aliveRoot(player)
	if not root or isFrozen(player, root) then
		return
	end
	if Services.CarryService.IsCarrying(player) then
		Services.EconomyService.Notify(player, "🎒 Du trägst schon etwas – erst nach Hause bringen!", "Error")
		return
	end
	local plot = Services.PlotService.GetPlot(player)
	if not plot then
		Services.EconomyService.Notify(player, "Du hast keine Base auf diesem Server.", "Error")
		return
	end
	if not Services.PlotService.FreeSlot(player) then
		Services.EconomyService.Notify(player, "📦 Deine Base ist voll! Verkaufe erst etwas.", "Error")
		return
	end
	if record.Kind == "Drop" then
		-- Ei liegt in einer gesperrten Base (Lock / Base-Schild): nur der Besitzer darf es nehmen
		local lockedPlot = lockedPlotAt(record.Position)
		if lockedPlot and lockedPlot.Owner ~= player then
			Services.EconomyService.Notify(player, "🔒 Das Ei liegt in einer gesperrten Base!", "Error")
			return
		end
	end
	local position = checkReach(player, record, root)
	if not position then
		return
	end
	record.Claimed = true
	local entry = record.Entry
	local fromNest = record.Kind == "Nest"
	local isRace = entry.Race ~= nil and entry.Race == raceId and raceActive
	removeRecord(record)
	Services.CarryService.StartCarry(player, entry, {
		Source = "Ground",
		From = if isRace then "Race" elseif fromNest then "Nest" else "Drop",
		GrabPosition = position,
		ScaleTimeout = fromNest or isRace, -- weite Wege übers Feld: mehr Zeit
	})
	local def = Config.MeteorsById[entry.Id]
	if isRace then
		rareAnnounce("🏁 " .. player.DisplayName .. " hat das Gold-Ei! Hau ihn! 🔨")
	elseif fromNest and def and Config.RarityIndex[def.Rarity] >= RARE_GRAB_ANNOUNCE then
		local mut = entry.Mut ~= "Normal" and (entry.Mut .. " ") or ""
		rareAnnounce(player.DisplayName .. " schnappt " .. def.Rarity .. " " .. mut .. def.Name .. "! Hau ihn! 🔨")
	end
end

-- Gratis-Zone / Showcase: E = Kaufen bzw. Schnappen (automatische Lieferung)
local function attachClaimPrompt(record)
	local def = Config.MeteorsById[record.Entry.Id]
	local action = record.Price > 0 and ("Kaufen " .. Util.FormatCash(record.Price)) or "🎁 Schnappen (GRATIS)"
	local reach = math.max(10, record.Part.Size.X / 2 + 7)
	record.ClientReach = reach
	local prompt = MeteorFactory.AddPrompt(
		record.Part,
		"BuyPrompt",
		action,
		def.Name .. " (" .. def.Rarity .. ")",
		Config.GrabHoldDuration,
		Enum.KeyCode.E,
		reach
	)
	prompt:SetAttribute("ClientMaxDistance", reach)
	prompt.Enabled = record.Landed ~= false
	local function onClaim(player: Player)
		tryClaim(player, record)
	end
	if record.Price > 0 then
		prompt.Triggered:Connect(onClaim) -- wer bezahlt, braucht keine Halte-Prüfung
	else
		MeteorFactory.OnHeldTrigger(prompt, onClaim) -- gratis -> wirklich halten
	end
	return prompt
end

-- Ei am Boden: nur E = Schnappen (dann selbst nach Hause tragen)
local function attachDropPrompt(record)
	local def = Config.MeteorsById[record.Entry.Id]
	local reach = math.max(10, record.Part.Size.X / 2 + 7)
	record.ClientReach = reach
	local prompt = MeteorFactory.AddPrompt(
		record.Part,
		"GrabPrompt",
		"Schnappen",
		def.Name,
		Config.GroundGrabHold,
		Enum.KeyCode.E,
		reach
	)
	prompt:SetAttribute("ClientMaxDistance", reach)
	prompt.Enabled = record.Landed ~= false
	MeteorFactory.OnHeldTrigger(prompt, function(player)
		tryGrab(player, record)
	end)
	return prompt
end

local function enablePrompts(part: BasePart)
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("ProximityPrompt") then
			child.Enabled = true
		end
	end
end

local function announce(entry, text: string)
	local def = Config.MeteorsById[entry.Id]
	local mut = entry.Mut ~= "Normal" and (entry.Mut .. " ") or ""
	Services.EconomyService.NotifyAll(text:format(def.Rarity .. " " .. mut .. def.Name), "Event")
end

-- Nest-Ei: E = Schnappen (gratis, tragen), F = Kaufen (automatische Lieferung; nicht beim Gold-Ei)
local function attachNestPrompts(record)
	local part: BasePart = record.Part
	local def = Config.MeteorsById[record.Entry.Id]
	local reach = math.max(NEST_REACH, part.Size.X / 2 + 6)
	record.ClientReach = reach

	local grab =
		MeteorFactory.AddPrompt(part, "GrabPrompt", "Schnappen", def.Name, Config.NestGrabHold, Enum.KeyCode.E, reach)
	grab.GamepadKeyCode = Enum.KeyCode.ButtonX
	grab:SetAttribute("ClientMaxDistance", reach)
	-- gratis -> der Server prüft, ob wirklich so lange gehalten wurde
	MeteorFactory.OnHeldTrigger(grab, function(player)
		tryGrab(player, record)
	end)
	if record.Race then
		return
	end
	grab.UIOffset = GRAB_UI_OFFSET

	local action = record.Price > 0 and ("Kaufen " .. Util.FormatCash(record.Price)) or "Gratis holen"
	local buy = MeteorFactory.AddPrompt(
		part,
		"BuyPrompt",
		action,
		def.Name .. " (" .. def.Rarity .. ")",
		Config.NestBuyHold,
		Enum.KeyCode.F,
		reach
	)
	buy.GamepadKeyCode = Enum.KeyCode.ButtonY
	buy.UIOffset = BUY_UI_OFFSET
	buy:SetAttribute("ClientMaxDistance", reach)
	buy.Triggered:Connect(function(player)
		tryClaim(player, record)
	end)
end

-- -------------------------------------------------------------------
-- NESTER – Eier erscheinen in zufälligen freien Nestern
-- -------------------------------------------------------------------
-- Nester aus der Map lesen (MapBuilder: NestField/Nests, Teile "Nest" mit NestSize + EggPoint)
local function loadNests()
	table.clear(smallNests)
	table.clear(bigNests)
	raceNest = nil
	local map = Services.PlotService.MapFolder
	local field = map and map:FindFirstChild("NestField")
	local folder = field and field:FindFirstChild("Nests")
	fieldFolder = field
	if not folder then
		warn("[MeteorService] Kein Nester-Feld (NestField/Nests) gefunden – keine Nest-Eier!")
		return
	end
	for _, child in ipairs(folder:GetChildren()) do
		local point = child:GetAttribute("EggPoint")
		if child:IsA("BasePart") and child.Name == "Nest" and typeof(point) == "Vector3" then
			local pillar = child:FindFirstChild("NestPillar")
			local nest: Nest = {
				Part = child,
				EggPoint = point,
				Big = child:GetAttribute("NestSize") == "Big",
				Race = child:GetAttribute("RaceNest") == true,
				Pillar = if pillar and pillar:IsA("Beam") then pillar else nil,
				Record = nil,
			}
			table.insert(if nest.Big then bigNests else smallNests, nest)
			if nest.Race then
				raceNest = nest
			end
		end
	end
	-- kein markiertes Renn-Nest: das große Nest am weitesten hinten (größtes Z)
	if not raceNest then
		for _, nest in ipairs(bigNests) do
			if not raceNest or nest.EggPoint.Z > raceNest.EggPoint.Z then
				raceNest = nest
			end
		end
		if raceNest then
			raceNest.Race = true
		end
	end
end

local function nestIsFree(nest: Nest): boolean
	if nest.Record then
		return false
	end
	local point = nest.EggPoint
	for _, record in ipairs(dropRecords) do
		local dx, dz = record.Position.X - point.X, record.Position.Z - point.Z
		if dx * dx + dz * dz < NEST_DROP_CLEAR * NEST_DROP_CLEAR then
			return false
		end
	end
	return true
end

-- Zufälliges freies Nest (das Renn-Nest bleibt während des Rennens frei)
local function pickFreeNest(list: { Nest }): Nest?
	local count = #list
	if count == 0 then
		return nil
	end
	local function usable(nest: Nest): boolean
		return nestIsFree(nest) and not (nest.Race and raceActive)
	end
	for _ = 1, NEST_RANDOM_TRIES do
		local nest = list[rng:NextInteger(1, count)]
		if usable(nest) then
			return nest
		end
	end
	local start = rng:NextInteger(1, count)
	for k = 0, count - 1 do
		local nest = list[(start + k - 1) % count + 1]
		if usable(nest) then
			return nest
		end
	end
	return nil
end

local function countNestEggs(): (number, number)
	local small, big = 0, 0
	for _, record in ipairs(nestRecords) do
		if record.Nest and record.Nest.Big then
			big += 1
		else
			small += 1
		end
	end
	return small, big
end

-- Legt ein Ei in ein Nest. opts: { Free?, Lifetime?, Race? }
local function spawnNestEgg(nest: Nest, entry, opts)
	local size = MeteorFactory.GetSize(entry)
	local price = if opts.Free or opts.Race then 0 else math.floor(Config.MeteorValue(entry))
	local position = nest.EggPoint + Vector3.new(0, size / 2, 0)
	local part = MeteorFactory.Create(entry, "Nest", price)
	part.CFrame = CFrame.new(position)
	part:SetAttribute("NestSize", if nest.Big then "Big" else "Small")
	local lifetime = tonumber(opts.Lifetime)
		or (if nest.Big then tonumber(NESTS.BigLifetime) or 45 else tonumber(NESTS.Lifetime) or 30)
	local record = {
		Kind = "Nest",
		Entry = entry,
		Part = part,
		Price = price,
		Position = position,
		Expires = os.clock() + lifetime,
		Claimed = false,
		Landed = true,
		Nest = nest,
		Race = opts.Race,
	}
	nest.Record = record
	table.insert(nestRecords, record)
	attachNestPrompts(record)
	if opts.Race then
		addRaceMarker(part)
	end
	local pillar = nest.Pillar
	if pillar then
		local def = Config.MeteorsById[entry.Id]
		local rarity = def and Config.RaritiesByName[def.Rarity]
		local color: Color3 = if opts.Race
			then Color3.fromRGB(255, 215, 60)
			elseif rarity then rarity.Color
			else Color3.new(1, 1, 1)
		pillar.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.5))
		pillar.Enabled = true
	end
	part.Parent = nestFolder
	return record
end

-- Ansage + Effekt für ein neues Nest-Ei. admin = vom Admin bestellt (schon ab Mythic ansagen)
local function announceNestEgg(record, admin: boolean)
	local entry = record.Entry
	local index = rarityIndexOf(entry)
	local big = record.Nest ~= nil and record.Nest.Big
	if index >= SECRET_SPAWN_ANNOUNCE then
		announce(entry, "🥚 WAHNSINN! %s im Nest!")
	elseif admin and index >= ADMIN_SPAWN_ANNOUNCE then
		announce(entry, "🥚 %s im Nest!")
	elseif big and index >= BIG_ANNOUNCE then
		local def = Config.MeteorsById[entry.Id]
		local mut = entry.Mut ~= "Normal" and (entry.Mut .. " ") or ""
		rareAnnounce("🥚 Großes Nest: " .. def.Rarity .. " " .. mut .. def.Name .. "!")
	end
	if big and index >= BIG_ANNOUNCE then
		local def = Config.MeteorsById[entry.Id]
		Remotes.Effect:FireAllClients("BigNest", 0, { Position = record.Position, Rarity = def.Rarity })
	end
end

-- Ei vom Admin (Warteschlange): Legendary+ in ein großes Nest, sonst klein; alles voll -> ältestes weg
local function spawnQueued(opts)
	local entry = makeEntry(opts)
	if not entry then
		return
	end
	local big = rarityIndexOf(entry) >= QUEUE_BIG_FROM
	local first, second = smallNests, bigNests
	if big then
		first, second = bigNests, smallNests
	end
	local nest = pickFreeNest(first) or pickFreeNest(second)
	if not nest then
		for _, record in ipairs(nestRecords) do
			if not record.Race and not record.Claimed and record.Nest and record.Nest.Big == big then
				nest = record.Nest
				removeRecord(record)
				break
			end
		end
	end
	if not nest then
		return
	end
	local record = spawnNestEgg(nest, entry, { Free = opts.Free == true })
	if opts.Announce == true then
		announceNestEgg(record, true)
	end
end

-- opts: { Id?, Mut?, Rarity?, Free?, Announce? } -> kommt so bald wie möglich in ein Nest
-- (Announce = true: allen ansagen, ab Mythic)
function MeteorService.QueueNest(opts)
	table.insert(nestQueue, opts or {})
end

-- Ein Schritt: abgelaufene Eier weg, Admin-Warteschlange, neue Eier (kleine + große Nester)
local function nestStep()
	local clock = os.clock()
	for i = #nestRecords, 1, -1 do
		local record = nestRecords[i]
		if record and not record.Claimed and not record.Race and clock > record.Expires then
			removeRecord(record)
		end
	end
	local queued = table.remove(nestQueue, 1)
	if queued then
		spawnQueued(queued)
	end
	if #Players:GetPlayers() == 0 then
		return
	end
	local shower = MeteorService.IsShowerActive()
	local small, big = countNestEggs()
	if clock >= nextSmallAt then
		nextSmallAt = clock + (tonumber(if shower then NESTS.ShowerSpawnInterval else NESTS.SpawnInterval) or 0.5)
		local maxEggs = tonumber(if shower then NESTS.ShowerMaxEggs else NESTS.MaxEggs) or 50
		if small < maxEggs then
			local nest = pickFreeNest(smallNests)
			if nest then
				announceNestEgg(spawnNestEgg(nest, rollNestEntry(false), {}), false)
			end
		end
	end
	if clock >= nextBigAt then
		local range = (if shower then NESTS.ShowerBigInterval else NESTS.BigInterval) or { 10, 16 }
		nextBigAt = clock + rng:NextNumber(tonumber(range[1]) or 10, tonumber(range[2]) or 16)
		local maxBig = tonumber(if shower then NESTS.ShowerMaxBigEggs else NESTS.MaxBigEggs) or 3
		if big < maxBig then
			local nest = pickFreeNest(bigNests)
			if nest then
				announceNestEgg(spawnNestEgg(nest, rollNestEntry(true), {}), false)
			end
		end
	end
end

-- -------------------------------------------------------------------
-- BODEN: Raycasts
-- -------------------------------------------------------------------
-- Spieler und Meteore ignorieren (die Liste wird bei jedem Aufruf neu gefüllt)
local function rayParams(respectCanCollide: boolean): RaycastParams
	local ignore: { Instance } = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	if nestFolder then
		table.insert(ignore, nestFolder)
	end
	if groundFolder then
		table.insert(ignore, groundFolder)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = respectCanCollide
	return params
end

-- Boden unter einer Position (nur begehbare Teile). Nichts gefunden -> Höhe 0 (Wiese)
local function groundBelow(position: Vector3): Vector3
	local result = workspace:Raycast(position + Vector3.new(0, 3, 0), Vector3.new(0, -80, 0), rayParams(true))
	if result then
		return result.Position
	end
	return Vector3.new(position.X, 0, position.Z)
end

-- -------------------------------------------------------------------
-- EIER AM BODEN (fallen gelassen / Egg Rush / Sternschnuppe)
-- -------------------------------------------------------------------
-- Legt ein Ei auf den Boden. groundPos = Punkt AUF dem Boden.
-- opts: { From: Vector3?, SkyHeight: number?, Lifetime: number?, EggRush: boolean?, ShootingStar: boolean? }
--   From/SkyHeight -> fällt sichtbar dorthin (Client-Effekt "Deliver"), sonst liegt es sofort da
--   ShootingStar -> Attribut am Ei (der Client lässt es funkeln)
local function spawnDrop(entry, groundPos: Vector3, opts)
	while #dropRecords >= Config.MaxDroppedMeteors do
		removeRecord(dropRecords[1]) -- älteste weg
	end
	local size = MeteorFactory.GetSize(entry)
	local position = Vector3.new(groundPos.X, groundPos.Y + size / 2 + 0.1, groundPos.Z)
	local part = MeteorFactory.Create(entry, "Ground", 0)
	part.CFrame = CFrame.new(position)
	if opts.ShootingStar then
		part:SetAttribute("ShootingStar", true)
	end
	if entry.Race ~= nil then
		addRaceMarker(part)
	end

	local record = {
		Kind = "Drop",
		Entry = entry,
		Part = part,
		Price = 0,
		Position = position,
		Expires = os.clock() + math.max(1, tonumber(opts.Lifetime) or Config.DroppedLifetime),
		Claimed = false,
		Landed = false,
		EggRush = opts.EggRush == true,
	}
	table.insert(dropRecords, record)
	attachDropPrompt(record)

	local from: Vector3? = opts.From
	if not from and opts.SkyHeight then
		from = position + Vector3.new(0, opts.SkyHeight, 0)
	end
	local function land()
		if record.Part ~= part or record.Claimed then
			return -- schon weg (abgelaufen, Admin hat aufgeräumt ...)
		end
		part.Parent = groundFolder
		record.Landed = true
		enablePrompts(part)
	end
	if from then
		Remotes.Effect:FireAllClients("Deliver", 0, {
			From = from,
			To = position,
			MeteorId = entry.Id,
			Mut = entry.Mut,
		})
		task.delay(FALL_TIME, land)
	else
		land()
	end
	return record
end

-- Getragenes Ei fällt zu Boden (gebonkt, Kreatur, gestorben, Falle, zu langsam ...). Es liegt dann GRATIS da
-- und JEDER kann es schnappen. position = ungefähre Stelle (der Boden darunter wird gesucht),
-- from = optional: von hier fällt es sichtbar herunter (z.B. über dem Kopf des Trägers).
-- Das Gold-Ei des laufenden Rennens bleibt dabei das Gold-Ei (liegt bis zum Ende des Rennens).
function MeteorService.DropMeteor(entry, position: Vector3, from: Vector3?)
	if type(entry) ~= "table" or not Config.MeteorsById[entry.Id] or typeof(position) ~= "Vector3" then
		return nil
	end
	local isRace = raceActive and entry.Race ~= nil and entry.Race == raceId
	local clean = {
		Id = entry.Id,
		Mut = Config.MutationsByName[entry.Mut] and entry.Mut or "Normal",
		Lv = math.clamp(math.floor(tonumber(entry.Lv) or 1), 1, Config.MaxLevel),
		Xp = 0,
		Alien = entry.Alien,
		Race = if isRace then raceId else nil,
	}
	local lifetime = if isRace then math.max(5, raceUntil - now()) else Config.DroppedLifetime
	return spawnDrop(clean, groundBelow(position), { From = from, Lifetime = lifetime })
end

-- Spielfläche aus den unsichtbaren Randwänden der Map (sonst Ersatz-Grenzen).
-- Wände links/rechts sind in X dünn, vorne/hinten in Z dünn; gerechnet wird mit den Innenkanten.
local areaCache = nil
local function mapArea()
	if areaCache then
		return areaCache
	end
	local map = Services.PlotService.MapFolder
	local xWalls: { BasePart } = {}
	local zWalls: { BasePart } = {}
	if map then
		for _, child in ipairs(map:GetChildren()) do
			if child.Name == "Boundary" and child:IsA("BasePart") then
				table.insert(child.Size.X < child.Size.Z and xWalls or zWalls, child)
			end
		end
	end
	local area = table.clone(FALLBACK_AREA)
	if #xWalls >= 2 and #zWalls >= 2 then
		table.sort(xWalls, function(a, b)
			return a.Position.X < b.Position.X
		end)
		table.sort(zWalls, function(a, b)
			return a.Position.Z < b.Position.Z
		end)
		local low, high = xWalls[1], xWalls[#xWalls]
		local back, front = zWalls[1], zWalls[#zWalls]
		local candidate = {
			MinX = low.Position.X + low.Size.X / 2,
			MaxX = high.Position.X - high.Size.X / 2,
			MinZ = back.Position.Z + back.Size.Z / 2,
			MaxZ = front.Position.Z - front.Size.Z / 2,
		}
		if candidate.MinX < candidate.MaxX and candidate.MinZ < candidate.MaxZ then
			area = candidate
		end
	end
	areaCache = area
	return area
end

-- Freier Platz auf der Wiese: innerhalb der Map, nicht in/an Basen, nicht auf dem Nester-Feld,
-- nicht auf dem Spawn-Platz/Bäumen (der Strahl muss genau den Wiesenboden "Ground" treffen).
local function findEggSpot(radius: number, groundPart: BasePart, params: RaycastParams): Vector3?
	local area = mapArea()
	local margin = EGG_EDGE_MARGIN + radius
	if area.MaxX - area.MinX <= margin * 2 or area.MaxZ - area.MinZ <= margin * 2 then
		return nil
	end
	for _ = 1, EGG_SPOT_TRIES do
		local x = rng:NextNumber(area.MinX + margin, area.MaxX - margin)
		local z = rng:NextNumber(area.MinZ + margin, area.MaxZ - margin)
		local flatPos = Vector3.new(x, 0, z)
		local ok = true
		do
			for _, plot in ipairs(Services.PlotService.Plots) do
				local hx, hz = Services.PlotService.HalfExtents(plot)
				local plotMargin = radius + EGG_PLOT_MARGIN
				local localPos = plot.CFrame:PointToObjectSpace(flatPos)
				if math.abs(localPos.X) <= hx + plotMargin and math.abs(localPos.Z) <= hz + plotMargin then
					ok = false
					break
				end
			end
		end
		if ok then
			for _, record in ipairs(dropRecords) do
				local other = record.Position
				local otherRadius = record.Part and record.Part.Size.X / 2 or 2
				local dx, dz = other.X - x, other.Z - z
				local minDist = radius + otherRadius + EGG_SPACING
				if dx * dx + dz * dz < minDist * minDist then
					ok = false
					break
				end
			end
		end
		if ok then
			local result = workspace:Raycast(Vector3.new(x, 80, z), Vector3.new(0, -120, 0), params)
			if result and result.Instance == groundPart then
				return result.Position
			end
		end
	end
	return nil
end

-- Boden des Nester-Felds (nil = nicht gefunden)
local function fieldFloor(): BasePart?
	local floor = fieldFolder and fieldFolder:FindFirstChild("Floor")
	if floor and floor:IsA("BasePart") then
		return floor
	end
	return nil
end

-- Freier Platz auf dem Nester-Feld (nicht auf Nestern/Pads, nicht zu nah an anderen Eiern).
-- Der Strahl muss genau den Feld-Boden treffen. Gibt den Punkt AUF dem Boden zurück oder nil.
local function findFieldSpot(radius: number, floor: BasePart, params: RaycastParams): Vector3?
	local half = floor.Size / 2
	local center = floor.Position
	local margin = EGG_FIELD_MARGIN + radius
	if half.X <= margin or half.Z <= margin then
		return nil
	end
	for _ = 1, EGG_SPOT_TRIES do
		local x = rng:NextNumber(center.X - half.X + margin, center.X + half.X - margin)
		local z = rng:NextNumber(center.Z - half.Z + margin, center.Z + half.Z - margin)
		local ok = true
		for _, record in ipairs(dropRecords) do
			local other = record.Position
			local otherRadius = record.Part and record.Part.Size.X / 2 or 2
			local dx, dz = other.X - x, other.Z - z
			local minDist = radius + otherRadius + EGG_SPACING
			if dx * dx + dz * dz < minDist * minDist then
				ok = false
				break
			end
		end
		if ok then
			local result = workspace:Raycast(Vector3.new(x, 60, z), Vector3.new(0, -100, 0), params)
			if result and result.Instance == floor then
				return result.Position
			end
		end
	end
	return nil
end

-- Wiesenboden "Ground" der Map (nil = nicht gefunden)
local function meadowGround(): BasePart?
	local map = Services.PlotService.MapFolder
	local groundPart = map and map:FindFirstChild("Ground")
	if groundPart and groundPart:IsA("BasePart") then
		return groundPart
	end
	return nil
end

-- Platz für ein Gratis-Ei: aufs Nester-Feld (fehlt es, auf die Wiese)
local function freeEggSpot(radius: number, params: RaycastParams): Vector3?
	local floor = fieldFloor()
	if floor then
		return findFieldSpot(radius, floor, params)
	end
	local groundPart = meadowGround()
	if not groundPart then
		return nil
	end
	return findEggSpot(radius, groundPart, params)
end

-- 🥚 EGG RUSH: Config.EggRushCount Gratis-Eier (3x Glück) regnen aufs Nester-Feld.
-- Läuft schon einer, wird er verlängert und es kommen noch mehr Eier dazu.
-- duration/count optional (Standard aus Config). Gibt die Anzahl der geplanten Eier zurück.
function MeteorService.StartEggRush(duration: number?, count: number?): number
	local t = now()
	if not fieldFloor() and not meadowGround() then
		warn("[MeteorService] Egg Rush: kein Boden gefunden – keine Eier")
		nextEggRushAt = t + Config.EggRushInterval
		publishAttributes()
		return 0
	end
	local length = math.clamp(tonumber(duration) or Config.EggRushDuration, 5, 600)
	local amount = math.clamp(math.floor(tonumber(count) or Config.EggRushCount), 1, Config.MaxDroppedMeteors)
	eggRushUntil = math.max(eggRushUntil, t + length)
	nextEggRushAt = eggRushUntil + Config.EggRushInterval
	publishAttributes()
	-- Eier eines laufenden Rush bleiben so lange liegen wie der verlängerte Rush
	local clock = os.clock()
	for _, record in ipairs(dropRecords) do
		if record.EggRush then
			record.Expires = math.max(record.Expires, clock + (eggRushUntil - t))
		end
	end
	Services.EconomyService.NotifyAll("🥚 EGG RUSH! Eier regnen aufs Feld – schnell!", "Event")

	task.spawn(function()
		-- Nester/Pads sollen auch treffen (dann ist dort kein Platz) -> CanCollide nicht beachten
		local params = rayParams(false)
		for _ = 1, amount do
			local remaining = eggRushUntil - now()
			if remaining <= 1 then
				break
			end
			local entry = MeteorService.RollEntry(MeteorService.GetLuck() * Config.EggRushLuck)
			local spot = freeEggSpot(MeteorFactory.GetSize(entry) / 2, params)
			if spot then
				spawnDrop(entry, spot, { SkyHeight = EGG_RUSH_SKY, Lifetime = remaining, EggRush = true })
			end
			task.wait(EGG_RUSH_SPAWN_GAP)
		end
	end)
	return amount
end

-- Freier Platz auf der Wiese (nicht auf dem Nester-Feld) – z.B. für die leuchtenden Kisten der Nacht.
-- Gibt den Punkt AUF dem Boden zurück oder nil.
function MeteorService.FindMeadowSpot(radius: number): Vector3?
	local groundPart = meadowGround()
	if not groundPart then
		return nil
	end
	return findEggSpot(math.max(0.5, radius), groundPart, rayParams(false))
end

-- 🌠 STERNSCHNUPPE: ein Gratis-Ei fällt schräg vom Himmel aufs Nester-Feld (wie Egg-Rush-Eier:
-- schnappen und heimtragen). opts: { Luck: number?, Lifetime: number? } -> Eintrag am Boden oder nil
function MeteorService.SpawnSkyEgg(opts)
	opts = opts or {}
	local luck = MeteorService.GetLuck() * (tonumber(opts.Luck) or 1)
	local entry = MeteorService.RollEntry(luck)
	local spot = freeEggSpot(MeteorFactory.GetSize(entry) / 2, rayParams(false))
	if not spot then
		return nil
	end
	-- schräg von oben: steil genug, dass der Client es als "Fall" (mit Schweif) zeigt
	local angle = rng:NextNumber() * math.pi * 2
	local from = spot + Vector3.new(math.cos(angle) * 60, 160, math.sin(angle) * 60)
	local record = spawnDrop(entry, spot, {
		From = from,
		Lifetime = tonumber(opts.Lifetime) or 45,
		ShootingStar = true,
	})
	local def = Config.MeteorsById[entry.Id]
	if def and (Config.RarityIndex[def.Rarity] or 1) >= RARE_GRAB_ANNOUNCE then
		announce(entry, "🌠 Sternschnuppe: %s auf dem Feld!")
	end
	return record
end

-- -------------------------------------------------------------------
-- GRATIS-ZONE & STATISCHE METEORE (Admin, Showcase)
-- -------------------------------------------------------------------
local function freeZone()
	local zone = Services.PlotService.FreeZone
	local center = zone and zone.Center or Vector3.new(0, 0.2, -264)
	local radius = zone and zone.Radius or 20
	return center, radius
end

local function randomFreeSpot(size: number): Vector3
	local center, radius = freeZone()
	local usable = math.max(1, radius - size / 2 - 1)
	local best = center
	for _ = 1, 12 do
		local angle = rng:NextNumber() * math.pi * 2
		local dist = math.sqrt(rng:NextNumber()) * usable
		local pos = center + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
		local free = true
		for _, record in ipairs(groundRecords) do
			if record.Part and (record.Position - pos).Magnitude < (record.Part.Size.X + size) / 2 + 1 then
				free = false
				break
			end
		end
		best = pos
		if free then
			break
		end
	end
	return best
end

-- Shake + Funken für alle in der Nähe eines Einschlags
local function impactEffect(position: Vector3, size: number, rarityName: string)
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = 0
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Visible = true
	explosion.Parent = workspace
	Remotes.Effect:FireAllClients("Hatch", 0, { Position = position, Rarity = rarityName })
	for _, player in ipairs(Players:GetPlayers()) do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - position).Magnitude < 60 + size * 12 then
			Services.EconomyService.Effect(player, "Shake", math.clamp(size / 6, 0.4, 1.6))
		end
	end
end

-- Statischer Meteor am Boden (Gratis-Zone, vor dem Admin, Showcase).
-- opts: { Id?, Mut?, Rarity?, Position?, Free?, Announce?, Lifetime?, Instant? }
--   Position fehlt -> zufällig in der Gratis-Zone
--   Instant = true -> liegt sofort da; sonst fällt er vom Himmel (Client-Effekt) und schlägt ein
function MeteorService.SpawnStatic(opts)
	opts = opts or {}
	local entry = makeEntry(opts)
	if not entry then
		return nil
	end
	-- Platz schaffen: älteste entfernen, wenn zu viele daliegen
	while #groundRecords >= Config.MaxFreeMeteors do
		removeRecord(groundRecords[1])
	end

	local price = opts.Free and 0 or math.floor(Config.MeteorValue(entry))
	local size = MeteorFactory.GetSize(entry)
	local spot = opts.Position or randomFreeSpot(size)
	local center = freeZone()
	local groundY = opts.Position and opts.Position.Y or center.Y
	local position = Vector3.new(spot.X, groundY + size / 2 + 0.1, spot.Z)
	local part = MeteorFactory.Create(entry, "Ground", price)
	part.CFrame = CFrame.new(position)

	local def = Config.MeteorsById[entry.Id]
	local record = {
		Kind = "Ground",
		Entry = entry,
		Part = part,
		Price = price,
		Position = position,
		Expires = os.clock() + (tonumber(opts.Lifetime) or Config.FreeMeteorLifetime),
		Claimed = false,
		Landed = opts.Instant == true,
	}
	table.insert(groundRecords, record)
	attachClaimPrompt(record)

	if opts.Announce ~= false and Config.RarityIndex[def.Rarity] >= 5 then
		announce(entry, price > 0 and "☄️ Ein %s ist gelandet!" or "🎁 Ein GRATIS %s liegt in der Gratis-Zone!")
	end

	if opts.Instant then
		part.Parent = groundFolder
		return record
	end
	-- Fall-Animation macht der Client ("Deliver" vom Himmel), danach erscheint der echte Meteor
	local sky = position + Vector3.new(rng:NextNumber(-50, 50), 220, rng:NextNumber(-50, 50))
	Remotes.Effect:FireAllClients("Deliver", 0, { From = sky, To = position, MeteorId = entry.Id, Mut = entry.Mut })
	task.delay(FALL_TIME, function()
		if record.Part ~= part or record.Claimed then
			return
		end
		part.Parent = groundFolder
		record.Landed = true
		enablePrompts(part)
		impactEffect(position, size, def.Rarity)
	end)
	return record
end

-- Allgemeiner Spawn (Admin-Panel): opts.Where = "Nest" (Standard), "Free" (Gratis-Zone) oder Position
function MeteorService.SpawnMeteor(opts)
	opts = opts or {}
	if opts.Position or opts.Where == "Free" then
		return MeteorService.SpawnStatic(opts)
	end
	MeteorService.QueueNest(opts)
	return nil
end

-- Nester, Gratis-Zone und alle Eier am Boden leeren (ein laufendes Rennen bleibt, das Gold-Ei auch)
function MeteorService.ClearGround()
	for i = #groundRecords, 1, -1 do
		removeRecord(groundRecords[i])
	end
	for i = #dropRecords, 1, -1 do
		local record = dropRecords[i]
		if not (raceActive and record.Entry.Race == raceId) then
			removeRecord(record)
		end
	end
	for i = #nestRecords, 1, -1 do
		local record = nestRecords[i]
		if not record.Race then
			removeRecord(record)
		end
	end
	table.clear(nestQueue)
end

-- -------------------------------------------------------------------
-- RENNEN-EVENT: Gold-Ei im entferntesten großen Nest – wer es zuerst heimbringt, gewinnt
-- -------------------------------------------------------------------
function MeteorService.IsRaceActive(): boolean
	return raceActive
end

-- Wo ist das Gold-Ei gerade? (im Nest, am Boden oder beim Träger) -> für den Pfeil der Spieler
local function raceTarget(): Vector3?
	for _, record in ipairs(nestRecords) do
		if record.Race == raceId then
			return record.Position
		end
	end
	for _, record in ipairs(dropRecords) do
		if record.Entry.Race == raceId then
			return record.Position
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local entry = Services.CarryService.CarriedEntry(player)
		if type(entry) == "table" and entry.Race == raceId then
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				return root.Position
			end
		end
	end
	return nil
end

local function endRace(winner: Player?)
	if not raceActive then
		return
	end
	raceActive = false
	nextRaceAt = now() + (tonumber(RACE.Interval) or 420)
	-- übrig gebliebenes Gold-Ei weg (wer es gerade trägt, behält es als normales Ei)
	for i = #nestRecords, 1, -1 do
		if nestRecords[i].Race == raceId then
			removeRecord(nestRecords[i])
		end
	end
	for i = #dropRecords, 1, -1 do
		if dropRecords[i].Entry.Race == raceId then
			removeRecord(dropRecords[i])
		end
	end
	ReplicatedStorage:SetAttribute("RaceTarget", nil)
	publishAttributes()
	if not winner then
		Services.EconomyService.NotifyAll("🏁 Rennen vorbei – niemand hat das Gold-Ei heimgebracht.", "Info")
	end
end

-- Rennen sofort starten (Admin oder Timer). Gibt (Erfolg, Text) zurück.
function MeteorService.StartRace(): (boolean, string)
	if raceActive then
		return false, "Das Rennen läuft schon"
	end
	local nest = raceNest
	if not nest then
		return false, "Kein Renn-Nest gefunden"
	end
	if nest.Record then
		removeRecord(nest.Record)
	end
	local rarity = MeteorService.RollRarity(MeteorService.GetLuck(), nil, RACE_MIN)
	local def = MeteorService.RandomOfRarity(rarity.Name, true)
	if not def then
		return false, "Kein Ei für das Rennen gefunden"
	end
	raceId += 1
	raceActive = true
	raceLost = 0
	local duration = tonumber(RACE.Duration) or 150
	raceUntil = now() + duration
	local entry = {
		Id = def.Id,
		Mut = if Config.MutationsByName.Gold then "Gold" else "Normal",
		Lv = 1,
		Xp = 0,
		Race = raceId,
	}
	local record = spawnNestEgg(nest, entry, { Race = raceId, Lifetime = duration + 5 })
	ReplicatedStorage:SetAttribute("RaceTarget", record.Position)
	publishAttributes()
	Services.EconomyService.NotifyAll("🏁 EI-RENNEN! Hol das Gold-Ei am Ende des Felds!", "Event")
	Remotes.Effect:FireAllClients("RaceStart", 0, { Position = record.Position })
	return true, "🏁 Rennen gestartet: " .. def.Rarity .. " " .. def.Name
end

-- CarryService: ein Ei ist zu Hause angekommen. Ist es das Gold-Ei -> Sieg!
function MeteorService.FinishRace(player: Player, entry)
	if not raceActive or type(entry) ~= "table" or entry.Race ~= raceId then
		return
	end
	local Economy = Services.EconomyService
	local seconds = tonumber(RACE.CashSeconds) or 300
	local amount = math.floor(math.max(tonumber(RACE.CashMin) or 25000, Economy.GetIncome(player) * seconds))
	Economy.AddCash(player, amount)
	Economy.Effect(player, "Collect", amount)
	Economy.Effect(player, "Confetti", 2)
	endRace(player)
	Economy.NotifyAll("🏁 " .. player.DisplayName .. " gewinnt das Ei-Rennen! +" .. Util.FormatCash(amount), "Event")
end

local function raceStep()
	if not raceActive then
		return
	end
	if now() >= raceUntil then
		endRace(nil)
		return
	end
	local target = raceTarget()
	if target then
		raceLost = 0
		ReplicatedStorage:SetAttribute("RaceTarget", target)
	else
		-- Gold-Ei verschwunden (Admin aufgeräumt, Träger hat das Spiel verlassen ...)
		raceLost += 1
		if raceLost >= RACE_LOST_CHECKS then
			endRace(nil)
		end
	end
end

-- Ist gerade (oder gleich) ein anderes Event? Dann wartet das Rennen.
local function raceBlocked(t: number): boolean
	if MeteorService.IsShowerActive() or MeteorService.IsEggRushActive() then
		return true
	end
	if nextShowerAt - t < RACE_BUSY_GAP or nextEggRushAt - t < RACE_BUSY_GAP then
		return true
	end
	local night = nightState()
	local nextNight = tonumber(ReplicatedStorage:GetAttribute("NextNightAt")) or 0
	return not night and nextNight > t and nextNight - t < RACE_NIGHT_GAP
end

-- -------------------------------------------------------------------
-- EVENT-TIMER (Schauer, Egg Rush, Rennen – zeitlich versetzt)
-- -------------------------------------------------------------------
local function eventStep()
	local t = now()
	-- Meteoritenschauer: wartet, bis ein laufender Egg Rush / ein Rennen vorbei ist
	if not MeteorService.IsShowerActive() and t >= nextShowerAt then
		if MeteorService.IsEggRushActive() then
			nextShowerAt = eggRushUntil + SHOWER_AFTER_RUSH
			publishAttributes()
		elseif raceActive then
			nextShowerAt = raceUntil + SHOWER_AFTER_RUSH
			publishAttributes()
		else
			MeteorService.StartShower()
		end
	end
	-- Egg Rush: nicht im Schauer/Rennen und nicht kurz davor (sonst gehen beide Events unter)
	if not MeteorService.IsEggRushActive() and t >= nextEggRushAt then
		local showerSoon = nextShowerAt - t < Config.EggRushDuration + SHOWER_AFTER_RUSH
		if #Players:GetPlayers() == 0 then
			nextEggRushAt = t + 30
			publishAttributes()
		elseif raceActive then
			nextEggRushAt = raceUntil + SHOWER_AFTER_RUSH
			publishAttributes()
		elseif MeteorService.IsShowerActive() or showerSoon then
			local showerEnd = MeteorService.IsShowerActive() and showerUntil or (nextShowerAt + Config.ShowerDuration)
			nextEggRushAt = showerEnd + EGG_RUSH_SHOWER_GAP
			publishAttributes()
		else
			MeteorService.StartEggRush()
		end
	end
	-- Rennen
	if not raceActive and t >= nextRaceAt then
		if #Players:GetPlayers() == 0 then
			nextRaceAt = t + 30
			publishAttributes()
		elseif raceBlocked(t) then
			nextRaceAt = t + RACE_RETRY
			publishAttributes()
		else
			MeteorService.StartRace()
		end
	end
	raceStep()
end

function MeteorService.Init(services)
	Services = services
	local map = Services.PlotService.MapFolder or workspace
	local function getFolder(name: string): Folder
		local existing = map:FindFirstChild(name)
		if existing and existing:IsA("Folder") then
			existing:ClearAllChildren()
			return existing
		end
		local created = Instance.new("Folder")
		created.Name = name
		created.Parent = map
		return created
	end
	nestFolder = getFolder("NestMeteors") -- Name wird vom Client gesucht!
	groundFolder = getFolder("GroundMeteors")
	loadNests()
end

function MeteorService.Start()
	local t = now()
	nextShowerAt = t + Config.ShowerInterval
	nextEggRushAt = t + Config.EggRushInterval / 2 -- versetzt: erster Egg Rush lange vor dem ersten Schauer
	nextRaceAt = t + (tonumber(RACE.Interval) or 420) / 2 -- erstes Rennen zwischen Egg Rush und Schauer
	publishAttributes()
	publishPity()
	Players.PlayerRemoving:Connect(function(player)
		actionLimiter.Clear(player)
	end)

	-- Nester-Schleife (nur Rechnen + gelegentlich ein neues Ei – nichts bewegt sich)
	task.spawn(function()
		while true do
			task.wait(0.1)
			local ok, err = pcall(nestStep)
			if not ok then
				warn("[MeteorService] Nester-Fehler: " .. tostring(err))
				task.wait(1)
			end
		end
	end)

	-- Meteore am Boden verschwinden lassen + Event-Timer
	task.spawn(function()
		local wasShower = false
		local wasRush = false
		while true do
			task.wait(1)
			local clock = os.clock()
			for i = #groundRecords, 1, -1 do
				local record = groundRecords[i]
				if not record.Claimed and clock > record.Expires then
					removeRecord(record)
				end
			end
			for i = #dropRecords, 1, -1 do
				local record = dropRecords[i]
				if record and not record.Claimed and clock > record.Expires then
					removeRecord(record)
				end
			end
			local ok, err = pcall(eventStep)
			if not ok then
				warn("[MeteorService] Event-Fehler: " .. tostring(err))
			end
			local shower = MeteorService.IsShowerActive()
			if wasShower and not shower then
				Services.EconomyService.NotifyAll("Der Meteoritenschauer ist vorbei. Locks gehen wieder! 🔒", "Info")
			end
			wasShower = shower
			local rush = MeteorService.IsEggRushActive()
			if wasRush and not rush then
				Services.EconomyService.NotifyAll("🥚 Der Egg Rush ist vorbei!", "Info")
			end
			wasRush = rush
		end
	end)
end

return MeteorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[-- Robux-Einnahmen: Gamepasses + Developer Products.
-- ProcessReceipt ist doppelt abgesichert: jeder Kauf wird im Spielstand vermerkt,
-- damit niemand etwas doppelt bekommt und niemand leer ausgeht.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local MonetizationService = {}
local Services

local owned: { [Player]: { [string]: boolean } } = {}
local loading: { [Player]: boolean } = {}
local adminGranted: { [Player]: { [string]: boolean } } = {} -- vom Admin geschenkte Pässe (nur diese Sitzung)
local randomRestricted: { [Player]: boolean } = {} -- Länder-Regel: keine bezahlten Zufalls-Gegenstände
local processing: { [string]: boolean } = {} -- Käufe, die gerade gutgeschrieben werden (gegen Doppel-Aufrufe)

local MAX_RECEIPTS = 60

-- ⭐ Starter-Paket: Werte in Config.StarterPack (der Shop-Text liest dieselben Werte)
-- Cash max(100K, 15 Min Einkommen), 3 Drehs, zufälliges Legendary-Ei, Speed Coil
local STARTER = Config.StarterPack or {}
local STARTER_MIN_CASH = tonumber(STARTER.MinCash) or 100000
local STARTER_INCOME_SECONDS = tonumber(STARTER.IncomeSeconds) or 900
local STARTER_SPINS = tonumber(STARTER.Spins) or 3
local STARTER_EGG_RARITY = tostring(STARTER.EggRarity or "Legendary")
local STARTER_GADGET = tostring(STARTER.Gadget or "SpeedCoil")
local STARTER_GADGET_FALLBACK_PRICE = 25000 -- Coil schon besessen -> ihr Preis als Cash (falls nicht in Config.Gadgets)
-- Länder ohne bezahlte Zufalls-Gegenstände: statt der Drehs +50% Cash, festes statt zufälliges Ei
local STARTER_RESTRICTED_CASH_MULT = tonumber(STARTER.RestrictedCashMult) or 1.5
-- 🐣 Sofort schlüpfen ohne Eier in der Base: Ersatz-Cash, damit der Kauf nicht verpufft
local INSTANT_HATCH_FALLBACK_SECONDS = 300
local INSTANT_HATCH_FALLBACK_MIN = 5000

function MonetizationService.HasPass(player: Player, key: string): boolean
	local passes = owned[player]
	local gifts = adminGranted[player]
	return (passes ~= nil and passes[key] == true) or (gifts ~= nil and gifts[key] == true)
end

function MonetizationService.LoadPasses(player: Player)
	if owned[player] then
		return
	end
	if loading[player] then
		while loading[player] and player.Parent do
			task.wait(0.1)
		end
		return
	end
	loading[player] = true
	local result = {}
	for _, pass in ipairs(Config.GamePasses) do
		if pass.Id ~= 0 then
			for attempt = 1, 3 do
				local ok, has =
					pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
				if ok then
					result[pass.Key] = has
					break
				end
				task.wait(attempt)
			end
		end
	end
	loading[player] = nil
	if not player.Parent then
		return
	end
	owned[player] = result
	if result.VIP then
		player:SetAttribute("VIP", true)
	end
end

-- Admin kann Pässe für Tests verschenken (nicht gespeichert)
function MonetizationService.GrantPassSession(player: Player, key: string)
	adminGranted[player] = adminGranted[player] or {}
	adminGranted[player][key] = true
	if key == "VIP" then
		player:SetAttribute("VIP", true)
	end
	MonetizationService.OnPassChanged(player)
end

function MonetizationService.OnPassChanged(player: Player)
	Services.EconomyService.ApplySpeed(player)
	local plot = Services.PlotService.GetPlot(player)
	if plot then
		Services.PlotService.UpdateSlotColors(plot)
		Services.PlotService.UpdateHatchTimes(plot) -- "2x Schlüpfen" -> Countdown neu berechnen
	end
	Services.EconomyService.MarkDirty(player)
end

-- Darf dieser Spieler KEINE bezahlten Zufalls-Gegenstände bekommen? (Roblox-Länder-Regel)
-- Im Zweifel (Abfrage klappt nicht) = ja, eingeschränkt. Ergebnis wird pro Sitzung gemerkt.
local function paidRandomRestricted(player: Player): boolean
	local cached = randomRestricted[player]
	if cached ~= nil then
		return cached
	end
	local ok, info = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, player)
	local restricted = not (ok and type(info) == "table" and info.ArePaidRandomItemsRestricted == false)
	if ok and player.Parent then
		randomRestricted[player] = restricted
	end
	return restricted
end

-- -------------------------------------------------------------------
-- PRODUKTE GUTSCHREIBEN
-- -------------------------------------------------------------------
-- Gadget schenken (ohne Cash). Gibt false zurück, wenn der Spieler es schon besitzt.
local function grantGadget(player: Player, data, id: string): boolean
	if type(data.Gadgets) ~= "table" then
		data.Gadgets = {}
	end
	if data.Gadgets[id] == true then
		return false
	end
	local gadgets = Services.GadgetService
	if gadgets then
		-- speichert + gibt das Werkzeug sofort in den Rucksack
		local ok, err = pcall(gadgets.Give, player, id)
		if not ok then
			warn("[Monetization] Gadget schenken fehlgeschlagen: " .. tostring(err))
		end
	end
	data.Gadgets[id] = true -- sicher gespeichert (Tool kommt spätestens beim nächsten Spawn)
	return true
end

local function grantStarterPack(player: Player): boolean
	local Economy = Services.EconomyService
	local data = Services.DataService.Get(player)
	if not data then
		return false
	end
	local restricted = paidRandomRestricted(player) -- kann kurz warten (meist schon gemerkt)
	if Services.DataService.Get(player) ~= data then
		return false -- während des Wartens gegangen -> Roblox versucht es beim nächsten Beitritt erneut
	end
	if data.StarterBought then
		warn(
			"[Monetization] Starter-Paket doppelt gekauft von " .. player.Name .. " – Inhalt trotzdem gutgeschrieben"
		)
	end
	local parts = {}
	local cash = math.max(STARTER_MIN_CASH, Economy.GetIncome(player) * STARTER_INCOME_SECONDS)
	if restricted then
		cash *= STARTER_RESTRICTED_CASH_MULT
	else
		Services.RewardService.AddSpins(player, STARTER_SPINS)
	end
	-- 🌀 Speed Coil (schon besessen -> ihr Preis als Cash)
	local def = Config.GadgetsById[STARTER_GADGET]
	local gadgetName = def and (tostring(def.Icon or "🌀") .. " " .. tostring(def.Name)) or "🌀 Speed Coil"
	if grantGadget(player, data, STARTER_GADGET) then
		table.insert(parts, gadgetName)
	else
		cash += def and def.Price or STARTER_GADGET_FALLBACK_PRICE
	end
	cash = math.floor(cash)
	Economy.AddCash(player, cash)
	table.insert(parts, 1, "💰 " .. Util.FormatCash(cash))
	if not restricted then
		table.insert(parts, 2, "🎡 " .. STARTER_SPINS .. " Drehs")
	end
	local _, eggText = Services.RewardService.GiveEgg(
		player,
		STARTER_EGG_RARITY,
		{ Fixed = restricted, FullValue = true, DayOnly = true }
	)
	data.StarterBought = true

	Economy.Notify(player, "⭐ STARTER-PAKET: " .. table.concat(parts, ", ") .. " – danke!", "Success")
	Economy.Notify(player, eggText, "Success")
	Economy.Effect(player, "Confetti", 3)
	Economy.NotifyAll("⭐ " .. player.DisplayName .. " hat sich das Starter-Paket geholt!", "Event")
	return true
end

-- 🛡️ Base-Schild: sperrt die eigene Base, auch im Meteoritenschauer (läuft schon eins -> länger).
-- Beim Verlassen setzt der PlotService das Schild zurück.
local function grantShield(player: Player, product): boolean
	local plot = Services.PlotService.GetPlot(player)
	if not plot then
		return false -- keine Base auf diesem Server -> Roblox versucht es später erneut
	end
	local minutes = math.max(1, tonumber(product.Minutes) or 10)
	Services.PlotService.AddShield(plot, minutes * 60)
	local Economy = Services.EconomyService
	Economy.Notify(
		player,
		"🛡️ Base-Schild aktiv: " .. minutes .. " Min sicher – sogar im Meteoritenschauer!",
		"Success"
	)
	Economy.Effect(player, "Confetti", 1.5)
	return true
end

local function grantProduct(player: Player, product): boolean
	local Economy = Services.EconomyService
	if product.Type == "Cash" then
		local amount = math.max(product.Min, Economy.GetIncome(player) * 60 * product.Minutes)
		amount = math.floor(amount)
		Economy.AddCash(player, amount)
		Economy.Notify(player, "💰 +" .. Util.FormatCash(amount) .. " – danke für deinen Kauf!", "Success")
		Economy.Effect(player, "Confetti", 1.5)
		return true
	elseif product.Type == "ServerLuck" then
		Services.MeteorService.AddServerLuck(product.Mult, product.Minutes * 60)
		Economy.NotifyAll(
			"🍀 "
				.. player.DisplayName
				.. " hat "
				.. product.Mult
				.. "x Glück für ALLE gekauft! ("
				.. product.Minutes
				.. " Min)",
			"Event"
		)
		return true
	elseif product.Type == "Shower" then
		Services.MeteorService.StartShower()
		Economy.NotifyAll("🌠 " .. player.DisplayName .. " hat einen Meteoritenschauer gestartet!", "Event")
		return true
	elseif product.Type == "Steps" then
		local data = Services.DataService.Get(player)
		if not data then
			return false
		end
		-- so viele Schritte wie "Minutes" Minuten auf dem besten gekauften Laufband
		local best = Config.BestTreadmill(data.Treadmills)
		local ticksPerMinute = 60 / Config.TreadmillTick
		local amount = (best and best.Rate or 1) * ticksPerMinute * product.Minutes * Economy.GetStepsMult(player)
		amount = math.floor(math.max(product.Min, amount))
		Economy.AddSteps(player, amount)
		Economy.Effect(player, "Steps", amount)
		Economy.Notify(
			player,
			"👟 +" .. Util.FormatNumber(amount) .. " Schritte – danke für deinen Kauf!",
			"Success"
		)
		Economy.Effect(player, "Confetti", 1.5)
		return true
	elseif product.Type == "Meteor" then
		-- Base voll -> voller Wert als Cash, damit der Kauf nie verloren geht (macht GiveEgg)
		-- DayOnly: keine Nacht-Eier -> die im Shop angegebenen Chancen stimmen immer
		local ok, text = Services.RewardService.GiveEgg(player, product.Rarity, { FullValue = true, DayOnly = true })
		if not ok then
			return false
		end
		Economy.Notify(player, text .. " 🐣", "Success")
		Economy.Effect(player, "Confetti", 2)
		return true
	elseif product.Type == "StarterPack" then
		return grantStarterPack(player)
	elseif product.Type == "Spins" then
		local amount = math.max(1, math.floor(tonumber(product.Amount) or 1))
		if not Services.RewardService.AddSpins(player, amount) then
			return false
		end
		Economy.Notify(player, "🎡 +" .. amount .. " Glücksrad-Drehs – viel Glück!", "Success")
		Economy.Effect(player, "Confetti", 1.5)
		return true
	elseif product.Type == "InstantHatch" then
		if Economy.HatchAll(player) == 0 then
			-- keine Eier in der Base -> Ersatz-Cash statt eines verpufften Kaufs
			local amount = math.floor(
				math.max(INSTANT_HATCH_FALLBACK_MIN, Economy.GetIncome(player) * INSTANT_HATCH_FALLBACK_SECONDS)
			)
			Economy.AddCash(player, amount)
			Economy.Notify(
				player,
				"🐣 Keine Eier in deiner Base – du bekommst " .. Util.FormatCash(amount) .. " als Ersatz!",
				"Info"
			)
		end
		Economy.Effect(player, "Confetti", 2)
		return true
	elseif product.Type == "Shield" then
		return grantShield(player, product)
	elseif product.Type == "EggRush" then
		local meteors = Services.MeteorService
		if type(meteors.StartEggRush) ~= "function" then
			warn("[Monetization] MeteorService.StartEggRush fehlt – Egg Rush kann nicht starten")
			return false
		end
		meteors.StartEggRush()
		Economy.NotifyAll(
			"🥚 " .. player.DisplayName .. " hat einen EGG RUSH gestartet! Schnell sammeln! 🏃",
			"Event"
		)
		return true
	end
	warn("[Monetization] Unbekannter Produkt-Typ: " .. tostring(product.Type))
	return false
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Roblox versucht es später erneut
	end
	local data = Services.DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local product = Config.ProductsById[receipt.ProductId]
	if not product then
		warn(
			"[Monetization] Unbekannte ProductId "
				.. tostring(receipt.ProductId)
				.. " – in Config.Products eintragen!"
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Schon gutgeschrieben? (z.B. nach Server-Absturz)
	if table.find(data.Receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- Wird gerade gutgeschrieben (Gutschrift kann kurz warten, z.B. Länder-Regel beim Starter-Paket)
	if processing[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	processing[receipt.PurchaseId] = true
	local ok, granted = pcall(grantProduct, player, product)
	processing[receipt.PurchaseId] = nil
	if Services.DataService.Get(player) ~= data then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Spieler ist inzwischen gegangen
	end
	if not ok or not granted then
		warn("[Monetization] Gutschrift fehlgeschlagen: " .. tostring(granted))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	data.Stats.RobuxSpent += receipt.CurrencySpent or 0

	-- Sofort speichern, damit der Kauf sicher verbucht ist
	if Services.DataService.Save(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- Speichern ging nicht: Kauf ist im Spielstand vermerkt, beim nächsten Versuch wird
	-- er als "schon gutgeschrieben" erkannt und nicht doppelt vergeben.
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.Init(services)
	Services = services
end

function MonetizationService.Start()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, purchased)
		if not purchased then
			return
		end
		for _, pass in ipairs(Config.GamePasses) do
			if pass.Id == gamePassId then
				owned[player] = owned[player] or {}
				owned[player][pass.Key] = true
				if pass.Key == "VIP" then
					player:SetAttribute("VIP", true)
				end
				MonetizationService.OnPassChanged(player)
				Services.EconomyService.Notify(player, "🎉 " .. pass.Name .. " freigeschaltet! Danke!", "Success")
				Services.EconomyService.NotifyAll(
					"⭐ " .. player.DisplayName .. " hat " .. pass.Name .. " gekauft!",
					"Event"
				)
				Services.EconomyService.Effect(player, "Confetti", 2)
			end
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		task.spawn(MonetizationService.LoadPasses, player)
		task.spawn(paidRandomRestricted, player) -- vorab merken, damit das Starter-Paket nicht warten muss
	end)
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
		loading[player] = nil
		adminGranted[player] = nil
		randomRestricted[player] = nil
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">NightService</string>
            <string name="Source"><![CDATA[-- NACHT: Tag-Nacht-Zyklus (Config.Night) mit Blutmond, Sternschnuppen-Eiern und leuchtenden Kisten.
--   • Nach Config.Night.DayLength Sekunden Tag kommt Config.Night.NightLength Sekunden Nacht.
--   • Licht/Himmel blendet GraphicsService.SetNight weich um.
--   • Nachts: Nacht-Eier in den Nestern (MeteorService.RandomOfRarity), Sternschnuppen-Eier fallen
--     aufs Nester-Feld (MeteorService.SpawnSkyEgg), mehr Kreaturen (FieldService), leuchtende Kisten.
--   • Kiste öffnen (E halten, serverseitig geprüft): Geld oder 1 Glücksrad-Dreh.
--   • BLUTMOND (Chance Config.Night.BloodMoonChance): roter Himmel, Glück x BloodMoonLuck
--     (MeteorService.GetLuck), dazu das Blutmond-Ei (BloodMoonOnly).
-- Attribute an ReplicatedStorage (für den Client): IsNight, BloodMoon, NightUntil, NextNightAt.
--
-- ÖFFENTLICHE API (auch über MeteorService.StartNight / MeteorService.EndNight erreichbar):
--   NightService.StartNight(bloodMoon: boolean?, seconds: number?)  -- Nacht sofort (läuft eine: verlängern)
--   NightService.EndNight()                                         -- sofort Tag
--   NightService.IsNight(): boolean, NightService.IsBloodMoon(): boolean

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))

local NightService = {}
local Services

local NIGHT = Config.Night or {}
local DAY_LENGTH = tonumber(NIGHT.DayLength) or 600
local NIGHT_LENGTH = tonumber(NIGHT.NightLength) or 180
local FADE_TIME = tonumber(NIGHT.FadeTime) or 10

local CRATE_SIZE = Vector3.new(3, 2.6, 3)
local CRATE_COLOR = Color3.fromRGB(150, 100, 55)
local CRATE_GLOW = Color3.fromRGB(255, 215, 90)
local CRATE_GLOW_BLOOD = Color3.fromRGB(255, 70, 70)
local CRATE_REACH = 10 -- Prompt-Reichweite
local CRATE_REACH_EXTRA = 5 -- Spielraum beim Server (Ping)

local rng = Random.new()
local isNight = false
local bloodMoon = false
local nightUntil = 0
local nextNightAt = 0
local nextStarAt = 0
local nextCrateAt = 0
local crateFolder: Folder? = nil
type Crate = { Model: Model, Box: BasePart, Expires: number, Claimed: boolean }
local crates: { Crate } = {}
local openLimiter = Util.RateLimiter(3, 1)

local function now(): number
	return workspace:GetServerTimeNow()
end

local function publish()
	ReplicatedStorage:SetAttribute("IsNight", isNight)
	ReplicatedStorage:SetAttribute("BloodMoon", bloodMoon)
	ReplicatedStorage:SetAttribute("NightUntil", nightUntil)
	ReplicatedStorage:SetAttribute("NextNightAt", nextNightAt)
end

function NightService.IsNight(): boolean
	return isNight
end

function NightService.IsBloodMoon(): boolean
	return isNight and bloodMoon
end

-- -------------------------------------------------------------------
-- LEUCHTENDE KISTEN
-- -------------------------------------------------------------------
local function removeCrate(crate: Crate)
	local index = table.find(crates, crate)
	if index then
		table.remove(crates, index)
	end
	crate.Model:Destroy()
end

local function clearCrates()
	for i = #crates, 1, -1 do
		removeCrate(crates[i])
	end
end

local function aliveRoot(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return root
end

-- Kiste öffnen: alles serverseitig geprüft (Nacht, Reichweite, lebendig, nicht eingefroren, Spam)
local function openCrate(player: Player, crate: Crate)
	if crate.Claimed or not crate.Model.Parent or not openLimiter.Check(player) then
		return
	end
	local Economy = Services.EconomyService
	if not Economy.IsReady(player) then
		return
	end
	local root = aliveRoot(player)
	if not root or root.Anchored then
		return
	end
	if (root.Position - crate.Box.Position).Magnitude > CRATE_REACH + CRATE_REACH_EXTRA then
		Economy.Notify(player, "Zu weit weg!", "Error")
		return
	end
	-- Position kommt vom Client: wer gerade unmöglich weit "gesprungen" ist (Teleport-Exploit), öffnet nichts
	local carry = Services.CarryService
	if carry and carry.MoveStatus(player) ~= "ok" then
		Economy.Notify(player, "⏳ Kurz warten und nochmal versuchen!", "Error")
		return
	end
	crate.Claimed = true
	local position = crate.Box.Position
	removeCrate(crate)

	local gotSpin = false
	if rng:NextNumber() < (tonumber(NIGHT.CrateSpinChance) or 0.25) and Services.RewardService then
		gotSpin = Services.RewardService.AddSpins(player, 1)
	end
	if gotSpin then
		Economy.Notify(player, "📦 Kiste: 1 Glücksrad-Dreh!", "Success")
	else
		local seconds = tonumber(NIGHT.CrateCashSeconds) or 120
		local amount = math.floor(math.max(tonumber(NIGHT.CrateCashMin) or 1000, Economy.GetIncome(player) * seconds))
		Economy.AddCash(player, amount)
		Economy.Effect(player, "Collect", amount)
		Economy.Notify(player, "📦 Kiste: +" .. Util.FormatCash(amount), "Success")
	end
	Remotes.Effect:FireAllClients("NightCrate", 0, { Position = position, Spin = gotSpin })
end

local function spawnCrate()
	if not crateFolder or #crates >= (tonumber(NIGHT.MaxCrates) or 6) then
		return
	end
	local spot = Services.MeteorService.FindMeadowSpot(CRATE_SIZE.X)
	if not spot then
		return
	end
	local glow = if bloodMoon then CRATE_GLOW_BLOOD else CRATE_GLOW
	local model = Instance.new("Model")
	model.Name = "NightCrate"
	local box = Instance.new("Part")
	box.Name = "Box"
	box.Size = CRATE_SIZE
	box.CFrame = CFrame.new(spot + Vector3.new(0, CRATE_SIZE.Y / 2, 0))
		* CFrame.Angles(0, rng:NextNumber() * math.pi, 0)
	box.Material = Enum.Material.WoodPlanks
	box.Color = CRATE_COLOR
	box.Anchored = true
	box.CanCollide = false
	box.CanTouch = false
	box.Parent = model
	-- leuchtendes Band um den Deckel
	local band = Instance.new("Part")
	band.Name = "Glow"
	band.Size = Vector3.new(CRATE_SIZE.X + 0.2, 0.5, CRATE_SIZE.Z + 0.2)
	band.CFrame = box.CFrame * CFrame.new(0, CRATE_SIZE.Y / 2 - 0.5, 0)
	band.Material = Enum.Material.Neon
	band.Color = glow
	band.Anchored = true
	band.CanCollide = false
	band.CanQuery = false
	band.CanTouch = false
	band.CastShadow = false
	band.Parent = model
	local light = Instance.new("PointLight")
	light.Color = glow
	light.Range = 14
	light.Brightness = 2
	light.Shadows = false
	light.Parent = band
	model.PrimaryPart = box
	model:SetAttribute("NightCrate", true)

	local crate: Crate = {
		Model = model,
		Box = box,
		Expires = os.clock() + (tonumber(NIGHT.CrateLifetime) or 60),
		Claimed = false,
	}
	local prompt = MeteorFactory.AddPrompt(
		box,
		"CratePrompt",
		"Öffnen",
		"Leuchtende Kiste",
		tonumber(NIGHT.CrateHold) or 0.6,
		Enum.KeyCode.E,
		CRATE_REACH
	)
	prompt:SetAttribute("ClientMaxDistance", CRATE_REACH)
	MeteorFactory.OnHeldTrigger(prompt, function(player)
		openCrate(player, crate)
	end)
	table.insert(crates, crate)
	model.Parent = crateFolder
end

-- -------------------------------------------------------------------
-- NACHT STARTEN / BEENDEN
-- -------------------------------------------------------------------
-- Zahl für Texte: 2 -> "2", 1.5 -> "1.5"
local function multText(value: any): string
	local n = tonumber(value) or 2
	return if n == math.floor(n) then tostring(n) else string.format("%.1f", n)
end

function NightService.StartNight(blood: boolean?, seconds: number?)
	local t = now()
	local length = math.clamp(tonumber(seconds) or NIGHT_LENGTH, 10, 3600)
	local wasNight = isNight
	local wasBlood = bloodMoon
	isNight = true
	bloodMoon = blood == true or (wasNight and bloodMoon)
	nightUntil = math.max(if wasNight then nightUntil else 0, t + length)
	nextNightAt = nightUntil + DAY_LENGTH
	if not wasNight then
		nextStarAt = t + 3
		nextCrateAt = t + 4
	end
	publish()
	Services.GraphicsService.SetNight(true, bloodMoon, FADE_TIME)
	local Economy = Services.EconomyService
	if bloodMoon and not wasBlood then
		Economy.NotifyAll("🔴 BLUTMOND! " .. multText(NIGHT.BloodMoonLuck) .. "x Glück bis zum Morgen.", "Event")
	elseif not wasNight then
		Economy.NotifyAll("🌙 Nacht: Sternschnuppen, Kisten – und mehr Monster!", "Event")
	end
end

function NightService.EndNight()
	if not isNight then
		return
	end
	local t = now()
	isNight = false
	bloodMoon = false
	nightUntil = t
	nextNightAt = t + DAY_LENGTH
	clearCrates()
	publish()
	Services.GraphicsService.SetNight(false, false, FADE_TIME)
	Services.EconomyService.NotifyAll("☀️ Die Sonne geht auf.", "Info")
end

-- Jede Sekunde: Zyklus, Sternschnuppen, Kisten
local function step()
	local t = now()
	if not isNight then
		if t >= nextNightAt then
			if #Players:GetPlayers() == 0 then
				nextNightAt = t + 30 -- niemand da: Nacht verschieben
				publish()
			else
				NightService.StartNight(rng:NextNumber() < (tonumber(NIGHT.BloodMoonChance) or 0.2))
			end
		end
		return
	end
	if t >= nightUntil then
		NightService.EndNight()
		return
	end
	-- alte Kisten weg
	local clock = os.clock()
	for i = #crates, 1, -1 do
		local crate = crates[i]
		if not crate.Claimed and clock > crate.Expires then
			removeCrate(crate)
		end
	end
	if #Players:GetPlayers() == 0 then
		return
	end
	if t >= nextStarAt then
		local interval = NIGHT.StarInterval or { 5, 9 }
		nextStarAt = t + rng:NextNumber(tonumber(interval[1]) or 5, tonumber(interval[2]) or 9)
		Services.MeteorService.SpawnSkyEgg({
			Luck = tonumber(NIGHT.StarLuck) or 2,
			Lifetime = tonumber(NIGHT.StarLifetime) or 45,
		})
	end
	if t >= nextCrateAt then
		nextCrateAt = t + (tonumber(NIGHT.CrateInterval) or 12)
		spawnCrate()
	end
end

function NightService.Init(services)
	Services = services
	local map = Services.PlotService.MapFolder or workspace
	local existing = map:FindFirstChild("NightCrates")
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "NightCrates" -- Name wird vom Client gesucht!
	folder.Parent = map
	crateFolder = folder
end

function NightService.Start()
	nextNightAt = now() + DAY_LENGTH
	publish()
	Players.PlayerRemoving:Connect(function(player)
		openLimiter.Clear(player)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(step)
			if not ok then
				warn("[NightService] Fehler: " .. tostring(err))
			end
		end
	end)
end

return NightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[-- Lässt die Map bauen (MapBuilder -> BaseBuilder) und verwaltet die Basen:
-- Zuweisung, Meteore/Aliens anzeigen, Geld-Pad + Geld-Felder + Slot-Anker, Lock-Knopf, Schutz gegen Eindringlinge,
-- Stockwerke + Base-Look kaufen (BuyFloor / BuyBaseLook).
-- Basen sind OFFEN (niedriger Rand): Slots sind unsichtbare Anker-Teile (plot.Slots in Slot-Reihenfolge:
-- 1-18 Erdgeschoss, danach Stockwerk 2 und 3 = plot.FloorSlots), Basen können rechteckig sein
-- (plot.HalfSizeX = halbe Breite, plot.HalfSizeZ = halbe Tiefe, lokal; Eingang = lokales -Z).
-- BASE-SCHILD (Produkt): plot.ShieldUntil (Serverzeit) sperrt die Base zusätzlich zum Lock –
-- auch während des Meteoritenschauers. Setzen über PlotService.AddShield/SetShield
-- (wer plot.ShieldUntil direkt ändert: wird innerhalb von 0,25 s übernommen).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))
local AlienFactory = require(script.Parent:WaitForChild("AlienFactory"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))
local BaseBuilder = require(script.Parent:WaitForChild("BaseBuilder"))

local PlotService = {}
PlotService.Plots = {} :: { any } -- Liste aller Basen (Felder siehe MapBuilder)
PlotService.ByPlayer = {} :: { [Player]: any }
PlotService.MapFolder = nil :: Folder?
-- Ei-Rennen in der Map-Mitte: { Folder, Nests } (siehe MapBuilder.NestFieldInfo)
PlotService.NestField = nil :: any
PlotService.FreeZone = { Center = Vector3.new(0, 0.2, -264), Radius = 20 }
PlotService.LobbySpawn = CFrame.new(0, 4, -300)
PlotService.LeaderboardCFrame = CFrame.new(0, 13, -190)
PlotService.TreadmillsFolder = nil :: Folder?
PlotService.TreadmillSpawn = CFrame.new(0, 4, -330)
PlotService.MaxSlots = Config.BaseSlots + Config.ExtraSlotsAmount

local Services

local LOCK_NOTIFY_COOLDOWN = 2 -- Lock-Knopf im Schauer: Hinweis höchstens alle 2 s (Touched feuert sehr oft)
local BUTTON_DEPTH = 0.9 -- so tief drückt sich der Lock-Knopf ein
local PRESS_DOWN = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PRESS_UP = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local lockNotifyAt: { [Player]: number } = {}
local collectDebounce: { [Player]: number } = {}

-- -------------------------------------------------------------------
-- ABFRAGEN
-- -------------------------------------------------------------------
function PlotService.GetPlot(player: Player)
	return PlotService.ByPlayer[player]
end

-- Halbe Breite (lokales X) und halbe Tiefe (lokales Z) einer Base
function PlotService.HalfExtents(plot): (number, number)
	local half = tonumber(plot.HalfSize) or 36
	return tonumber(plot.HalfSizeX) or half, tonumber(plot.HalfSizeZ) or half
end

-- Rechteck der Base in Weltkoordinaten (waagrecht, aus den 4 Ecken): minX, maxX, minZ, maxZ
function PlotService.WorldRect(plot): (number, number, number, number)
	local hx, hz = PlotService.HalfExtents(plot)
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, corner in ipairs({
		Vector3.new(-hx, 0, -hz),
		Vector3.new(hx, 0, -hz),
		Vector3.new(hx, 0, hz),
		Vector3.new(-hx, 0, hz),
	}) do
		local p = plot.CFrame:PointToWorldSpace(corner)
		minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
		minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
	end
	return minX, maxX, minZ, maxZ
end

function PlotService.IsInside(plot, position: Vector3): boolean
	local hx, hz = PlotService.HalfExtents(plot)
	local localPos = plot.CFrame:PointToObjectSpace(position)
	-- Höhe: bis über das oberste gebaute Stockwerk (plot.TopY, setzt BaseBuilder.SetFloors)
	local topY = tonumber(plot.TopY) or 40
	return math.abs(localPos.X) <= hx and math.abs(localPos.Z) <= hz and localPos.Y > -6 and localPos.Y < topY
end

-- Gesperrt = Lock (Lock-Pad) ODER Base-Schild aktiv
function PlotService.IsLocked(plot): boolean
	local now = workspace:GetServerTimeNow()
	return plot.LockedUntil > now or (tonumber(plot.ShieldUntil) or 0) > now
end

-- Läuft ein gekauftes Base-Schild?
function PlotService.IsShielded(plot): boolean
	return (tonumber(plot.ShieldUntil) or 0) > workspace:GetServerTimeNow()
end

-- Gekaufte Stockwerke (1 = nur Erdgeschoss) und Base-Look-Stufe aus dem Spielstand
local function floorsOf(data): number
	return math.clamp(math.floor(tonumber(data and data.BaseFloors) or 1), 1, BaseBuilder.MaxFloors())
end

local function lookOf(data): number
	local looks = (Config :: any).BaseLooks
	local max = type(looks) == "table" and math.max(1, #looks) or 1
	return math.clamp(math.floor(tonumber(data and data.BaseLook) or 1), 1, max)
end

-- Alle Slot-Nummern, die der Spieler benutzen darf (Reihenfolge = Füll-Reihenfolge):
-- Erdgeschoss (Config.BaseSlots, mit Pass + Config.ExtraSlotsAmount), dann die gekauften Stockwerke.
-- Slot-Nummern sind fest: 1-18 Erdgeschoss, danach Stockwerk 2, dann 3.
function PlotService.UsableSlots(player: Player): { number }
	local plot = PlotService.ByPlayer[player]
	local data = Services.DataService.Get(player)
	local extra = Services.MonetizationService.HasPass(player, "ExtraSlots") and Config.ExtraSlotsAmount or 0
	local groundMax = plot and tonumber(plot.GroundSlots) or (Config.BaseSlots + Config.ExtraSlotsAmount)
	local list = {}
	for slot = 1, math.min(Config.BaseSlots + extra, groundMax, PlotService.MaxSlots) do
		table.insert(list, slot)
	end
	local floorSlots = plot and plot.FloorSlots
	if floorSlots then
		for floor = 2, floorsOf(data) do
			for _, slot in ipairs(floorSlots[floor] or {}) do
				if slot <= PlotService.MaxSlots then
					table.insert(list, slot)
				end
			end
		end
	end
	return list
end

function PlotService.SlotCount(player: Player): number
	return #PlotService.UsableSlots(player)
end

function PlotService.FreeSlot(player: Player): number?
	local data = Services.DataService.Get(player)
	if not data then
		return nil
	end
	for _, slot in ipairs(PlotService.UsableSlots(player)) do
		if data.Meteors[tostring(slot)] == nil then
			return slot
		end
	end
	return nil
end

function PlotService.UsedSlots(player: Player): number
	local data = Services.DataService.Get(player)
	local count = 0
	if data then
		for _ in pairs(data.Meteors) do
			count += 1
		end
	end
	return count
end

-- Schlüpf-Tempo (Sekunden pro Sekunde): 2 mit dem Gamepass "2x Schlüpfen & Wachsen"
function PlotService.HatchSpeed(player: Player?): number
	if player and Services.MonetizationService.HasPass(player, "FastCharge") then
		return 2
	end
	return 1
end

-- Standpunkt eines Slots (Bodenhöhe, Drehung des Ankers) – hier steht der Meteor bzw. das Alien.
-- Der unsichtbare Anker ist ein Kasten, der AUF dem Boden steht -> seine Unterkante = Boden.
function PlotService.SlotTopCFrame(plot, slot: number): CFrame
	local slotPart = plot.Slots[slot]
	if not slotPart then
		return plot.CFrame
	end
	return slotPart.CFrame * CFrame.new(0, -slotPart.Size.Y / 2, 0)
end

-- Weltposition eines angezeigten Meteors (Part) oder Aliens (Model)
function PlotService.ObjectPosition(object: Instance?): Vector3?
	if not object then
		return nil
	end
	if object:IsA("BasePart") then
		return object.Position
	elseif object:IsA("Model") then
		return object:GetPivot().Position
	end
	return nil
end

-- Halbe Breite eines angezeigten Objekts (für Reichweiten)
function PlotService.ObjectRadius(object: Instance?): number
	if not object then
		return 2
	end
	if object:IsA("BasePart") then
		return object.Size.X / 2
	elseif object:IsA("Model") then
		local size = object:GetExtentsSize()
		return math.max(size.X, size.Z) / 2
	end
	return 2
end

-- -------------------------------------------------------------------
-- METEORE / ALIENS IN DER BASE ANZEIGEN
-- -------------------------------------------------------------------
-- Foto-Deko (Admin-Panel → 📸 Foto-Modus): Ordner im Plot-Model, Teile heißen "Slot<n>"
local PHOTO_FOLDER = "PhotoShowcase"

local function removePhotoDeco(plot, slot: number)
	local folder = plot.Model:FindFirstChild(PHOTO_FOLDER)
	local deco = folder and folder:FindFirstChild("Slot" .. slot)
	if deco then
		deco:Destroy()
	end
end

-- Baut die Optik für einen Eintrag: Alien (geschlüpft) oder Meteor (schlüpft noch).
-- Gibt (Objekt, Teil für Prompts) zurück. Klappt das Alien nicht, wird ein Meteor gezeigt.
local function buildVisual(plot, slot: number, entry, mode: string): (Instance, BasePart)
	local top = PlotService.SlotTopCFrame(plot, slot)
	if entry.Alien ~= nil then
		local ok, result = pcall(AlienFactory.Create, entry, mode)
		if ok and typeof(result) == "Instance" and result:IsA("Model") then
			local model = result :: Model
			model:PivotTo(top)
			local body = model.PrimaryPart or model:FindFirstChild("Body")
			if body and body:IsA("BasePart") then
				return model, body
			end
			model:Destroy()
		else
			warn("[PlotService] Alien konnte nicht gebaut werden: " .. tostring(result))
		end
	end
	local meteor = MeteorFactory.Create(entry, "Base")
	meteor.CFrame = top * CFrame.new(0, meteor.Size.Y / 2, 0)
	return meteor, meteor
end

-- Setzt das Attribut HatchAt (Serverzeit, wann der Meteor schlüpft) – der Client zählt damit herunter
local function setHatchAt(plot, object: Instance, entry)
	if entry.Alien == nil and object:IsA("BasePart") then
		local remaining = math.max(0, tonumber(entry.Hatch) or 0)
		object:SetAttribute("HatchAt", workspace:GetServerTimeNow() + remaining / PlotService.HatchSpeed(plot.Owner))
	else
		object:SetAttribute("HatchAt", nil)
	end
end

local function sellText(entry): string
	return "Verkaufen " .. Util.FormatCash(Config.MeteorValue(entry) * Config.SellRatio)
end

local function setText(label: TextLabel?, text: string)
	if label and label.Text ~= text then
		label.Text = text
	end
end

-- -------------------------------------------------------------------
-- GELD-FELDER: vor jedem besetzten Slot ein kleines Feld (zeigt Einkommen/s, durchlaufen = einsammeln)
-- -------------------------------------------------------------------
local function onCollectTouch(plot, hit: BasePart)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if player and player == plot.Owner and os.clock() - (collectDebounce[player] or 0) > 0.5 then
		collectDebounce[player] = os.clock()
		Services.EconomyService.Collect(player)
	end
end

local function removeCashPad(plot, slot: number)
	local pad = plot.CashPads[slot]
	if pad then
		pad:Destroy()
		plot.CashPads[slot] = nil
		plot.CashLabels[slot] = nil
	end
end

local function cashPadText(entry, mult: number): string
	if entry.Alien == nil then
		return "🥚"
	end
	return "+" .. Util.FormatCash(Config.MeteorIncome(entry) * mult) .. "/s"
end

-- Beträge auf allen Geld-Feldern einer Base neu schreiben (nur bei Änderung)
function PlotService.UpdateCashPads(plot)
	local owner = plot.Owner
	local data = owner and Services.DataService.Get(owner)
	if not data or next(plot.CashPads) == nil then
		return
	end
	local mult = Services.EconomyService.GetMultiplier(owner)
	for slot, label in pairs(plot.CashLabels) do
		local entry = data.Meteors[tostring(slot)]
		if entry then
			setText(label, cashPadText(entry, mult))
		end
	end
end

local function addCashPad(plot, slot: number, entry)
	removeCashPad(plot, slot)
	local pad, label = BaseBuilder.MakeCashPad(plot, slot)
	if not pad or not label then
		return
	end
	pad.Touched:Connect(function(hit)
		onCollectTouch(plot, hit)
	end)
	plot.CashPads[slot] = pad
	plot.CashLabels[slot] = label
	setText(label, cashPadText(entry, Services.EconomyService.GetMultiplier(plot.Owner)))
end

function PlotService.RenderSlot(plot, slot: number)
	local existing = plot.MeteorParts[slot]
	if existing then
		existing:Destroy()
		plot.MeteorParts[slot] = nil
	end
	removeCashPad(plot, slot)
	if not plot.Owner or not plot.Slots[slot] then
		return
	end
	local data = Services.DataService.Get(plot.Owner)
	local entry = data and data.Meteors[tostring(slot)]
	if not entry or not Config.MeteorsById[entry.Id] then
		return
	end
	if Services.CarryService.IsSlotBeingStolen(plot, slot) then
		return -- wird gerade geklaut -> unsichtbar in der Base
	end
	removePhotoDeco(plot, slot) -- echter Meteor/Alien ersetzt die Foto-Deko

	local object, promptPart = buildVisual(plot, slot, entry, "Base")
	object:SetAttribute("PlotIndex", plot.Index)
	object:SetAttribute("Slot", slot)
	object:SetAttribute("OwnerUserId", plot.Owner.UserId)
	setHatchAt(plot, object, entry)

	local reach = math.max(10, PlotService.ObjectRadius(object) + 7)
	local name = Config.EntryName(entry)
	local stealPrompt = MeteorFactory.AddPrompt(
		promptPart,
		"StealPrompt",
		"Klauen",
		name,
		Config.StealHoldDuration,
		Enum.KeyCode.E,
		reach
	)
	local sellPrompt =
		MeteorFactory.AddPrompt(promptPart, "SellPrompt", sellText(entry), name, 1, Enum.KeyCode.F, reach)
	-- Klauen: der Server prüft, ob wirklich Config.StealHoldDuration lang gehalten wurde
	MeteorFactory.OnHeldTrigger(stealPrompt, function(player)
		Services.CarryService.TrySteal(player, plot, slot)
	end)
	sellPrompt.Triggered:Connect(function(player)
		Services.EconomyService.Sell(player, plot, slot)
	end)
	object.Parent = plot.MeteorFolder
	plot.MeteorParts[slot] = object
	addCashPad(plot, slot, entry)
end

-- Nach Level-Up nur Größe/Schild anpassen statt neu bauen
function PlotService.RefreshSlot(plot, slot: number)
	local object = plot.MeteorParts[slot]
	local data = plot.Owner and Services.DataService.Get(plot.Owner)
	local entry = data and data.Meteors[tostring(slot)]
	if not object or not entry then
		return
	end
	local isAlienModel = object:IsA("Model")
	if (entry.Alien ~= nil) ~= isAlienModel then
		-- z.B. gerade geschlüpft -> komplett neu bauen
		PlotService.RenderSlot(plot, slot)
		return
	end
	local promptPart: BasePart? = nil
	if isAlienModel then
		local model = object :: Model
		local ok, err = pcall(AlienFactory.Refresh, model, entry)
		if not ok then
			warn("[PlotService] Alien-Refresh fehlgeschlagen: " .. tostring(err))
		end
		local body = model.PrimaryPart or model:FindFirstChild("Body")
		promptPart = body and body:IsA("BasePart") and body or nil
	elseif object:IsA("BasePart") then
		MeteorFactory.Refresh(object, entry, "Base")
		setHatchAt(plot, object, entry)
		promptPart = object
	end
	local sellPrompt = promptPart and promptPart:FindFirstChild("SellPrompt")
	if sellPrompt and sellPrompt:IsA("ProximityPrompt") then
		sellPrompt.ActionText = sellText(entry)
	end
	local label = plot.CashLabels[slot]
	if label and plot.Owner then
		setText(label, cashPadText(entry, Services.EconomyService.GetMultiplier(plot.Owner)))
	end
end

-- Schlüpf-Zeitpunkte neu berechnen (z.B. nach Kauf von "2x Schlüpfen")
function PlotService.UpdateHatchTimes(plot)
	local data = plot.Owner and Services.DataService.Get(plot.Owner)
	if not data then
		return
	end
	for slot, object in pairs(plot.MeteorParts) do
		local entry = data.Meteors[tostring(slot)]
		if entry and object.Parent then
			setHatchAt(plot, object, entry)
		end
	end
end

-- Stockwerke + Look so bauen, wie sie dem Besitzer gehören (frei = Grundzustand).
-- Im Foto-Modus (plot.PhotoFloors) stehen alle Stockwerke.
function PlotService.ApplyBase(plot)
	local data = plot.Owner and Services.DataService.Get(plot.Owner)
	BaseBuilder.SetFloors(plot, if plot.PhotoFloors then BaseBuilder.MaxFloors() else floorsOf(data))
	BaseBuilder.SetLook(plot, lookOf(data))
end

function PlotService.RenderAll(plot)
	PlotService.ApplyBase(plot)
	for slot = 1, #plot.Slots do
		PlotService.RenderSlot(plot, slot)
	end
	PlotService.UpdateSlotColors(plot)
end

-- Früher: Slot-Pads einfärben (frei / gesperrt / Foto-Modus). Die Slots sind jetzt unsichtbare
-- Anker ohne Optik – gesperrte Slots (ohne Gamepass) zeigen einfach nichts. Bleibt als Einstieg
-- erhalten (MonetizationService, AdminService, Foto-Modus rufen es auf) und hält die Anker unsichtbar.
function PlotService.UpdateSlotColors(plot)
	for _, slotPart in ipairs(plot.Slots) do
		if slotPart.Transparency ~= 1 then
			slotPart.Transparency = 1
		end
	end
end

-- -------------------------------------------------------------------
-- FOTO-DEKO (nur Optik für Thumbnails: keine Spieldaten, keine Prompts)
-- -------------------------------------------------------------------
-- Füllt ALLE Slots ohne echten Meteor (auch die gesperrten und alle Stockwerke – die werden dafür
-- gebaut) mit Deko-Aliens. makeEntry() liefert { Id, Alien, Mut, Lv }. Gibt die Anzahl der Deko-Objekte zurück.
function PlotService.FillPhotoShowcase(plot, makeEntry: () -> any): number
	plot.PhotoFloors = true
	PlotService.ApplyBase(plot)
	local folder = plot.Model:FindFirstChild(PHOTO_FOLDER)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = PHOTO_FOLDER
		folder.Parent = plot.Model
	end
	local count = 0
	for slot = 1, #plot.Slots do
		removePhotoDeco(plot, slot) -- nochmal drücken = neu würfeln
		local entry = plot.MeteorParts[slot] == nil and makeEntry() or nil
		if entry and Config.MeteorsById[entry.Id] then
			local object = buildVisual(plot, slot, entry, "Photo")
			object.Name = "Slot" .. slot
			object.Parent = folder
			count += 1
		end
	end
	PlotService.UpdateSlotColors(plot)
	return count
end

-- Entfernt nur die Deko (und die Foto-Stockwerke)
function PlotService.ClearPhotoShowcase(plot)
	local folder = plot.Model:FindFirstChild(PHOTO_FOLDER)
	if folder then
		folder:Destroy()
	end
	if plot.PhotoFloors then
		plot.PhotoFloors = nil
		PlotService.ApplyBase(plot)
	end
end

-- -------------------------------------------------------------------
-- LOCK
-- -------------------------------------------------------------------
local LOCK_BARRIER_COLOR = Color3.fromRGB(255, 40, 40)
local SHIELD_BARRIER_COLOR = Color3.fromRGB(60, 170, 255)

local function setColor(part: BasePart, color: Color3)
	if part.Color ~= color then
		part.Color = color
	end
end

function PlotService.UpdateLockVisual(plot)
	local now = workspace:GetServerTimeNow()
	local showerActive = Services.MeteorService and Services.MeteorService.IsShowerActive()
	local shieldUntil = tonumber(plot.ShieldUntil) or 0
	-- Barrier = schwaches Kraftfeld; die Laser-Streifen, die zufahren, zeichnet der Client (Modul Base)
	if shieldUntil > now then
		local text = "🛡️ " .. Util.FormatTime(math.ceil(shieldUntil - now))
		plot.Barrier.Transparency = 0.5
		setColor(plot.Barrier, SHIELD_BARRIER_COLOR)
		setText(plot.LockLabel, text)
		setText(plot.BarrierLabel, text)
		setColor(plot.LockPad, Color3.fromRGB(70, 130, 200))
	elseif plot.LockedUntil > now then
		local text = "🔒 " .. math.ceil(plot.LockedUntil - now) .. "s"
		plot.Barrier.Transparency = 0.6
		setColor(plot.Barrier, LOCK_BARRIER_COLOR)
		setText(plot.LockLabel, text)
		setText(plot.BarrierLabel, text)
		setColor(plot.LockPad, Color3.fromRGB(90, 90, 90))
	else
		plot.Barrier.Transparency = 1
		setColor(plot.Barrier, LOCK_BARRIER_COLOR)
		setText(plot.LockLabel, showerActive and "🌠 KEIN LOCK" or "🔒 LOCK")
		setText(plot.BarrierLabel, "")
		setColor(plot.LockPad, Color3.fromRGB(230, 60, 60))
	end
end

-- Lock-Knopf drückt sich kurz ein (nur Optik, bei jeder Berührung durch den Besitzer)
local function pressLockButton(plot)
	local up = plot.LockPadUp
	if typeof(up) ~= "CFrame" or plot.LockPressing then
		return
	end
	plot.LockPressing = true
	TweenService:Create(plot.LockPad, PRESS_DOWN, { CFrame = up * CFrame.new(0, -BUTTON_DEPTH, 0) }):Play()
	task.delay(0.45, function()
		TweenService:Create(plot.LockPad, PRESS_UP, { CFrame = up }):Play()
		task.delay(0.35, function()
			plot.LockPressing = nil
		end)
	end)
end

-- Attribute fürs Model (der Client liest sie): LockedUntil = Ende der Sperre (Lock ODER Schild),
-- ShieldUntil = Ende des Base-Schilds
local function publishLock(plot)
	local shieldUntil = tonumber(plot.ShieldUntil) or 0
	plot.PublishedShield = shieldUntil
	local effective = math.max(plot.LockedUntil, shieldUntil)
	if plot.Model:GetAttribute("LockedUntil") ~= effective then
		plot.Model:SetAttribute("LockedUntil", effective)
	end
	if plot.Model:GetAttribute("ShieldUntil") ~= shieldUntil then
		plot.Model:SetAttribute("ShieldUntil", shieldUntil)
	end
	PlotService.UpdateLockVisual(plot)
end

function PlotService.SetLocked(plot, untilTime: number)
	plot.LockedUntil = untilTime
	publishLock(plot)
end

-- Base-Schild bis zu dieser Serverzeit (0 = aus)
function PlotService.SetShield(plot, untilTime: number)
	plot.ShieldUntil = math.max(0, tonumber(untilTime) or 0)
	publishLock(plot)
end

-- Base-Schild um "seconds" verlängern (läuft schon eins, wird es länger)
function PlotService.AddShield(plot, seconds: number)
	local now = workspace:GetServerTimeNow()
	PlotService.SetShield(plot, math.max(tonumber(plot.ShieldUntil) or 0, now) + math.max(0, seconds))
end

local function tryLock(player: Player, plot)
	if plot.Owner ~= player or PlotService.IsLocked(plot) then
		return -- schon gesperrt (Lock oder Base-Schild)
	end
	if Services.MeteorService.IsShowerActive() then
		local t = os.clock()
		if t - (lockNotifyAt[player] or -math.huge) >= LOCK_NOTIFY_COOLDOWN then
			lockNotifyAt[player] = t
			Services.EconomyService.Notify(player, "🌠 Während des Meteoritenschauers gibt es keine Locks!", "Error")
		end
		return
	end
	local duration = Services.MonetizationService.HasPass(player, "VIP") and Config.LockDurationVIP
		or Config.LockDuration
	PlotService.SetLocked(plot, workspace:GetServerTimeNow() + duration)
	Services.EconomyService.Notify(player, "🔒 Base für " .. duration .. " Sekunden gesperrt!", "Success")
end

-- Geld-Anzeige über dem Collect-Pad (nur schreiben, wenn sich etwas ändert)
function PlotService.SetCollectText(plot, pending: number)
	setText(plot.CollectLabel, "💰 " .. Util.FormatCash(pending))
end

-- -------------------------------------------------------------------
-- ZUWEISUNG & TELEPORT
-- -------------------------------------------------------------------
local function teleportToPlot(player: Player)
	local character = player.Character
	local plot = PlotService.ByPlayer[player]
	if not character then
		return
	end
	local target = plot and plot.SpawnCFrame or PlotService.LobbySpawn
	character:PivotTo(target)
	Services.CarryService.NoteTeleport(player, target.Position)
end

function PlotService.AssignPlot(player: Player)
	if PlotService.ByPlayer[player] then
		return PlotService.ByPlayer[player]
	end
	for _, plot in ipairs(PlotService.Plots) do
		if plot.Owner == nil then
			plot.Owner = player
			plot.Model:SetAttribute("OwnerUserId", player.UserId)
			plot.SignLabel.Text = player.DisplayName .. "s Base"
			-- Avatar-Kopf aufs Namensschild (Web-Aufruf -> im Hintergrund, Fehler egal)
			local image = plot.SignImage
			if image then
				image.Image = ""
				task.spawn(function()
					local ok, content = pcall(function()
						return Players:GetUserThumbnailAsync(
							player.UserId,
							Enum.ThumbnailType.HeadShot,
							Enum.ThumbnailSize.Size180x180
						)
					end)
					if ok and type(content) == "string" and plot.Owner == player then
						image.Image = content
					end
				end)
			end
			PlotService.ByPlayer[player] = plot
			plot.ShieldUntil = 0
			PlotService.SetLocked(plot, 0)
			PlotService.UpdateSlotColors(plot)
			return plot
		end
	end
	return nil
end

function PlotService.ReleasePlot(player: Player)
	local plot = PlotService.ByPlayer[player]
	if not plot then
		return
	end
	PlotService.ByPlayer[player] = nil
	plot.Owner = nil
	plot.Model:SetAttribute("OwnerUserId", 0)
	plot.SignLabel.Text = "Freie Base"
	if plot.SignImage then
		plot.SignImage.Image = ""
	end
	PlotService.SetCollectText(plot, 0)
	plot.ShieldUntil = 0
	PlotService.SetLocked(plot, 0)
	-- Fallen (Gadget) gehören dem alten Besitzer -> weg
	local traps = plot.Model:FindFirstChild("Traps")
	if traps then
		traps:Destroy()
	end
	for slot, object in pairs(plot.MeteorParts) do
		object:Destroy()
		plot.MeteorParts[slot] = nil
	end
	for slot in pairs(plot.CashPads) do
		removeCashPad(plot, slot)
	end
	plot.PhotoFloors = nil
	PlotService.ClearPhotoShowcase(plot)
	PlotService.ApplyBase(plot) -- Stockwerke weg, Look zurück auf Stufe 1
	PlotService.UpdateSlotColors(plot)
end

-- -------------------------------------------------------------------
-- STOCKWERKE & BASE-LOOK KAUFEN (Request "BuyFloor" / "BuyBaseLook", über EconomyService)
-- -------------------------------------------------------------------
function PlotService.BuyFloor(player: Player): (boolean, string)
	local data = Services.DataService.Get(player)
	local plot = PlotService.ByPlayer[player]
	if not data or not plot then
		return false, "Du hast keine Base"
	end
	local current = floorsOf(data)
	if current >= BaseBuilder.MaxFloors() then
		return false, "🏠 Alle Stockwerke gebaut!"
	end
	local def = Config.BaseFloors[current]
	local price = math.max(0, tonumber(def.Price) or 0)
	local need = math.max(0, math.floor(tonumber(def.RequiredRebirths) or 0))
	if (tonumber(data.Rebirths) or 0) < need then
		return false, "🔥 Erst " .. need .. " Rebirth" .. (need == 1 and "" or "s") .. "!"
	end
	if data.Cash < price then
		return false, "💵 Du brauchst " .. Util.FormatCash(price)
	end
	Services.EconomyService.AddCash(player, -price)
	data.BaseFloors = current + 1
	PlotService.ApplyBase(plot)
	Services.EconomyService.Effect(player, "Confetti", 1)
	-- Bau-Animation bei allen (Client-Modul Base: Teile fliegen/wachsen rein)
	Services.EconomyService.EffectAll("FloorBuilt", 0, { Plot = plot.Index, Floor = current + 1 })
	local added = #(plot.FloorSlots and plot.FloorSlots[current + 1] or {})
	return true, "🏠 Stockwerk " .. (current + 1) .. " gebaut! +" .. added .. " Plätze"
end

function PlotService.BuyBaseLook(player: Player): (boolean, string)
	local data = Services.DataService.Get(player)
	local plot = PlotService.ByPlayer[player]
	if not data or not plot then
		return false, "Du hast keine Base"
	end
	local current = lookOf(data)
	local def = Config.BaseLooks[current + 1]
	if not def then
		return false, "👑 Schönste Base erreicht!"
	end
	local price = math.max(0, tonumber(def.Price) or 0)
	if data.Cash < price then
		return false, "💵 Du brauchst " .. Util.FormatCash(price)
	end
	Services.EconomyService.AddCash(player, -price)
	data.BaseLook = current + 1
	PlotService.ApplyBase(plot)
	Services.EconomyService.Effect(player, "Confetti", 1)
	-- Funkeln + Reinploppen der neuen Deko bei allen (Client-Modul Base)
	Services.EconomyService.EffectAll("LookUpgrade", 0, { Plot = plot.Index, Look = current + 1 })
	return true, "✨ Base-Look: " .. tostring(def.Name) .. "!"
end

function PlotService.TeleportHome(player: Player)
	teleportToPlot(player)
end

-- AUF das beste gekaufte Laufband (hinteres Drittel der Lauffläche, Blick zur Konsole).
-- Neulinge landen so auf dem Holz-Laufband, nicht vor Gold. Lauffläche: lokales -Z (LookVector) = Laufrichtung.
local function treadmillTarget(player: Player): CFrame
	local data = Services.DataService.Get(player)
	local best = Config.BestTreadmill(data and data.Treadmills)
	local folder = PlotService.TreadmillsFolder
	if best and folder then
		for _, model in ipairs(folder:GetChildren()) do
			local belt = model:IsA("Model") and model:GetAttribute("TreadmillId") == best.Id and model.PrimaryPart
			if belt and belt:IsA("BasePart") then
				local look = belt.CFrame.LookVector
				local top = belt.Position + belt.CFrame.UpVector * (belt.Size.Y / 2)
				local spot = top - look * math.max(0, belt.Size.Z / 2 - 4) + Vector3.new(0, 3.5, 0)
				return CFrame.lookAt(spot, spot + Vector3.new(look.X, 0, look.Z))
			end
		end
	end
	return PlotService.TreadmillSpawn
end

function PlotService.TeleportToTreadmills(player: Player): boolean
	local character = player.Character
	if not character then
		return false
	end
	local target = treadmillTarget(player)
	character:PivotTo(target)
	Services.CarryService.NoteTeleport(player, target.Position)
	return true
end

-- Teleport-Ziel der Laufband-Zone: von MapBuilder, sonst aus den Laufbändern berechnet
local function findTreadmillSpawn(map: any): CFrame
	if typeof(map.TreadmillSpawn) == "CFrame" then
		return map.TreadmillSpawn
	end
	local folder = map.TreadmillsFolder
	if not folder then
		return PlotService.LobbySpawn
	end
	local fromAttribute = folder:GetAttribute("SpawnCFrame")
	if typeof(fromAttribute) == "CFrame" then
		return fromAttribute
	end
	local sum, count = Vector3.zero, 0
	local look, halfLength = Vector3.new(0, 0, -1), 10
	for _, model in ipairs(folder:GetChildren()) do
		local belt = model:IsA("Model") and model.PrimaryPart
		if belt then
			sum += belt.Position
			count += 1
			look = belt.CFrame.LookVector
			halfLength = belt.Size.Z / 2
		end
	end
	if count == 0 then
		return PlotService.LobbySpawn
	end
	local center = sum / count + Vector3.new(0, 3.5, 0)
	-- Einstieg von hinten (gegen die Laufrichtung), Blick auf die Laufbänder
	local spot = center - look * (halfLength + 7)
	return CFrame.lookAt(spot, center)
end

function PlotService.Init(services)
	Services = services
	local map = MapBuilder.Build() :: any
	PlotService.MapFolder = map.MapFolder
	PlotService.Plots = map.Plots or {}
	PlotService.NestField = map.NestField
	if map.FreeZone then
		PlotService.FreeZone = map.FreeZone
	end
	if typeof(map.LobbySpawn) == "CFrame" then
		PlotService.LobbySpawn = map.LobbySpawn
	end
	if typeof(map.LeaderboardCFrame) == "CFrame" then
		PlotService.LeaderboardCFrame = map.LeaderboardCFrame
	end
	PlotService.TreadmillsFolder = map.TreadmillsFolder
	PlotService.TreadmillSpawn = findTreadmillSpawn(map)

	local maxSlots = Config.BaseSlots + Config.ExtraSlotsAmount
	for _, def in ipairs(Config.BaseFloors) do
		maxSlots += math.max(0, math.floor(tonumber(def.Slots) or 0))
	end
	for _, plot in ipairs(PlotService.Plots) do
		plot.MeteorParts = plot.MeteorParts or {}
		plot.CashPads = plot.CashPads or {}
		plot.CashLabels = plot.CashLabels or {}
		plot.LockedUntil = plot.LockedUntil or 0
		plot.ShieldUntil = plot.ShieldUntil or 0
		plot.PublishedShield = plot.ShieldUntil
		maxSlots = math.min(maxSlots, #plot.Slots)
	end
	PlotService.MaxSlots = maxSlots
end

function PlotService.Start()
	local function onCharacter(player: Player, character: Model)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.1)
		if character.Parent and player.Character == character then
			teleportToPlot(player)
		end
	end

	local function onPlayer(player: Player)
		local plot = PlotService.AssignPlot(player)
		if not plot then
			task.delay(3, function()
				if player.Parent then
					Services.EconomyService.Notify(
						player,
						"😢 Server voll – keine Base frei. Wechsle den Server!",
						"Error"
					)
				end
			end)
		end
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end

	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end

	-- Pads: Geld-Pad + Geld-Felder + ALLE eigenen Slot-Anker (durchlaufen) sammeln Geld ein,
	-- Lock-Knopf sperrt (Touched mit Entprellung)
	for _, plot in ipairs(PlotService.Plots) do
		plot.CollectPad.CanTouch = true
		plot.LockPad.CanTouch = true
		plot.CollectPad.Touched:Connect(function(hit)
			onCollectTouch(plot, hit)
		end)
		for _, slotPart in ipairs(plot.Slots) do
			slotPart.CanTouch = true
			slotPart.Touched:Connect(function(hit)
				onCollectTouch(plot, hit)
			end)
		end
		plot.LockPad.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player and player == plot.Owner then
				pressLockButton(plot)
				tryLock(player, plot)
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		collectDebounce[player] = nil
		lockNotifyAt[player] = nil
		local plot = PlotService.ByPlayer[player]
		if plot then
			-- laufende Diebstähle aus dieser Base abbrechen, dann Base freigeben
			Services.CarryService.CancelStealsFromPlot(plot, "victimLeft")
		end
		PlotService.ReleasePlot(player)
	end)

	-- Eindringlinge aus gesperrten Basen werfen + Lock-Anzeige aktualisieren
	task.spawn(function()
		local tick = 0
		while true do
			task.wait(0.25)
			tick += 1
			for _, plot in ipairs(PlotService.Plots) do
				-- plot.ShieldUntil direkt geändert (z.B. vom Produkt)? -> Attribute + Anzeige nachziehen
				if (tonumber(plot.ShieldUntil) or 0) ~= plot.PublishedShield then
					publishLock(plot)
				end
				if plot.Owner and PlotService.IsLocked(plot) then
					for _, other in ipairs(Players:GetPlayers()) do
						local character = other.Character
						local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
						if other ~= plot.Owner and character and root and PlotService.IsInside(plot, root.Position) then
							if Services.CarryService.IsCarrying(other) then
								-- Dieb noch drin, als gesperrt wurde -> Beute zurück (eigener Hinweis statt "Teleport")
								Services.CarryService.Fail(other, "locked")
							end
							character:PivotTo(plot.EntranceCFrame)
							Services.CarryService.NoteTeleport(other, plot.EntranceCFrame.Position)
							Services.EconomyService.Notify(other, "🔒 Diese Base ist gesperrt!", "Error")
						end
					end
				end
				if tick % 4 == 0 then
					PlotService.UpdateLockVisual(plot)
				end
				if tick % 20 == 0 and plot.Owner then
					-- Geld-Felder: Multiplikator (Rebirth, Index, Pässe) kann sich ändern
					local ok, err = pcall(PlotService.UpdateCashPads, plot)
					if not ok then
						warn("[PlotService] Geld-Felder: " .. tostring(err))
					end
				end
			end
		end
	end)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[-- Erstellt alle RemoteEvents/RemoteFunctions in ReplicatedStorage.Remotes
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
end

local function make(className: string, name: string)
	local existing = folder:FindFirstChild(name)
	if existing then
		return existing
	end
	local remote = Instance.new(className)
	remote.Name = name
	remote.Parent = folder
	return remote
end

return {
	Notify = make("RemoteEvent", "Notify") :: RemoteEvent, -- Server -> Client: Toast-Nachricht
	State = make("RemoteEvent", "State") :: RemoteEvent, -- Server -> Client: Cash, Einkommen, ...
	-- Server -> Client: Effekte (name, strength, data) – z.B. "Shake", "Steps", "Deliver", "Hatch",
	-- "FloorBuilt"/"LookUpgrade" (Modul Base), "RaceStart" (Effects + NestField), "Run…" (MeteorRun), "NightCrate" (Night)
	Effect = make("RemoteEvent", "Effect") :: RemoteEvent,
	-- Client -> Server: "Rebirth", "Daily", "Collect", "Home", "Treadmills", "BuyTreadmill", "BuyGadget",
	-- "BuyFloor", "BuyBaseLook", "GoRun", "ClaimGift", "Spin", "ClaimQuest", "RerollQuest"
	Request = make("RemoteFunction", "Request") :: RemoteFunction,
	Admin = make("RemoteFunction", "Admin") :: RemoteFunction, -- Client -> Server: Admin-Aktionen (geprüft!)
	-- 🤝 Handel (TradeService): Client -> Server (Aktion, Wert) / Server -> Client (Art, Daten)
	Trade = make("RemoteFunction", "Trade") :: RemoteFunction,
	TradeEvent = make("RemoteEvent", "TradeEvent") :: RemoteEvent,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[-- Belohnungen, die zum Wiederkommen locken (v2.1):
--  * 🎁 SPIELZEIT-GESCHENKE: nach 2, 5, 10 ... 60 Minuten Spielzeit ein Geschenk. Die Spielzeit zählt
--    pro UTC-Tag über ALLE Besuche und steht im Spielstand (data.Gifts) – neu beitreten setzt sie
--    nicht zurück (sonst könnte man alle 10 Minuten neu beitreten und dieselben Geschenke abholen).
--  * 🎡 GLÜCKSRAD: Drehs (data.Spins) + alle Config.FreeSpinHours Stunden ein Gratis-Dreh
--  * 📜 TAGESAUFGABEN: pro UTC-Tag 3 Aufgaben (Klauen, Schlüpfen, Laufen ...) -> Cash + 1 Dreh,
--    eine davon darf man einmal am Tag tauschen (z.B. "Bonk 3 Diebe" auf einem leeren Server)
-- Gewürfelt und gutgeschrieben wird NUR hier auf dem Server. Der Client zeigt nur an (State)
-- und schickt Anfragen ("ClaimGift", "Spin", "ClaimQuest", "RerollQuest" über den EconomyService).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local RewardService = {}
local Services

local rng = Random.new()

-- -------------------------------------------------------------------
-- EINSTELLUNGEN
-- Geschenke und Glücksrad-Felder stehen in Config (PlaytimeGifts, WheelPrizes, FreeSpinHours):
--   Type "Cash"  -> max(Min, Einkommen pro Sekunde * Seconds)
--   Type "Steps" -> so viele Schritte wie Seconds Sekunden auf dem besten Laufband (mind. Min)
--   Type "Spins" -> Amount Glücksrad-Drehs
--   Type "Egg"   -> zufälliges Ei (Meteor) der Seltenheit Rarity in die Base (Base voll -> Wert als Cash)
-- -------------------------------------------------------------------
local MAX_SPINS = 100000
local SPIN_COOLDOWN = 2 -- Sekunden zwischen zwei Drehs (der Client dreht das Rad in der Zeit)
local SPIN_REVEAL_DELAY = 5 -- große Gewinne erst ansagen, wenn das Rad beim Gewinner stehen geblieben ist
local SPIN_ANNOUNCE_RARITY = "Legendary" -- ab dieser Seltenheit wird ein Ei-Gewinn allen angesagt
local FIRST_NOTIFY_DELAY = 8 -- "Gratis-Dreh bereit" erst nach den Willkommens-Nachrichten
local MAX_TICK = 5 -- Spielzeit: nach einem Server-Hänger höchstens so viele Sekunden auf einmal
local MAX_GIFT_SECONDS = 86400 -- mehr als ein Tag Spielzeit geht an einem Tag nicht

-- Tagesaufgaben: Goals = feste Auswahl, Scale = wächst mit dem Fortschritt des Spielers.
-- Social = braucht andere Spieler (Klauen aus Basen, Bonken) -> höchstens eine davon pro Tag.
local QUEST_POOL = {
	{ Id = "Grab", Kind = "Grab", Text = "🥚 Schnapp dir %s Eier aus den Nestern", Goals = { 5, 6, 8, 10 } },
	{ Id = "Steal", Kind = "Steal", Text = "😈 Klau %s Aliens/Eier aus Basen", Goals = { 2, 3 }, Social = true },
	{ Id = "Hatch", Kind = "Hatch", Text = "🐣 Lass %s Aliens schlüpfen", Goals = { 5, 6, 8 } },
	{ Id = "Steps", Kind = "Steps", Text = "👟 Lauf %s Schritte", Scale = "Steps" },
	{ Id = "Collect", Kind = "Collect", Text = "💰 Sammle %s ein", Scale = "Collect" },
	{ Id = "Bonk", Kind = "Bonk", Text = "🔨 Triff %s Diebe mit dem Schläger", Goals = { 2, 3 }, Social = true },
}
local QUESTS_PER_DAY = 3
local QUEST_STEPS_SECONDS = 240 -- "Lauf X Schritte" = 4 Minuten auf dem besten Laufband
local QUEST_STEPS_MIN = 200
local QUEST_COLLECT_SECONDS = 300 -- "Sammle $X ein" = 5 Minuten Einkommen
local QUEST_COLLECT_MIN = 500
local QUEST_REWARD_SECONDS = 240 -- Belohnung = 4 Minuten Einkommen ...
local QUEST_REWARD_MIN = 2000 -- ... mindestens so viel
local QUEST_REWARD_SPINS = 1

local QUEST_BY_ID = {}
for _, def in ipairs(QUEST_POOL) do
	QUEST_BY_ID[def.Id] = def
end

local TRACK_KINDS = { Grab = true, Steal = true, Hatch = true, Steps = true, Collect = true, Bonk = true }

-- Sitzungs-Daten (nicht gespeichert – die Spielzeit für Geschenke steht in data.Gifts)
local joinedAt: { [Player]: number } = {}
local lastTick: { [Player]: number } = {}
local notifiedGifts: { [Player]: { [number]: boolean } } = {}
local notifiedDay: { [Player]: string } = {}
local freeSpinNotified: { [Player]: boolean } = {}
local lastSpin: { [Player]: number } = {}
-- Zuletzt geschickte Geschenke/Aufgaben (nur bei Änderung neu schicken, spart Netzwerk)
local sentGiftKey: { [Player]: string } = {}
local sentQuestKey: { [Player]: string } = {}

-- -------------------------------------------------------------------
-- HELFER
-- -------------------------------------------------------------------
local function giftList(): { any }
	return Config.PlaytimeGifts or {}
end

local function wheelList(): { any }
	return Config.WheelPrizes or {}
end

local function freeSpinPeriod(): number
	local hours = tonumber(Config.FreeSpinHours) or 4
	if hours ~= hours or hours <= 0 then
		hours = 4
	end
	return hours * 3600
end

local function finite(n: number): number
	if n ~= n or n < 0 then
		return 0
	end
	return math.min(n, 1e30)
end

-- 1234 -> 1200, 56789 -> 57000 (2 gültige Stellen – Ziele sehen so schöner aus)
local function roundNice(n: number): number
	n = finite(n)
	if n < 100 then
		return math.max(1, math.floor(n + 0.5))
	end
	local magnitude = 10 ^ (math.floor(math.log10(n)) - 1)
	return math.floor(n / magnitude + 0.5) * magnitude
end

local function today(): string
	return tostring(os.date("!%Y-%m-%d"))
end

local function notify(player: Player, text: string, kind: string?)
	Services.EconomyService.Notify(player, text, kind)
end

local function markDirty(player: Player)
	Services.EconomyService.MarkDirty(player)
end

-- Sekunden seit dem Beitritt (nur für den ersten Hinweis, NICHT für die Geschenke)
local function sessionSeconds(player: Player): number
	local t = joinedAt[player]
	if not t then
		t = os.clock()
		joinedAt[player] = t
	end
	return os.clock() - t
end

-- 🎁 Spielzeit von heute (UTC) aus dem Spielstand: { Day, Seconds, Claimed = { ["1"] = true } }.
-- Neuer Tag oder kaputte Daten -> wieder bei 0, alle Geschenke neu.
type GiftData = { Day: string, Seconds: number, Claimed: { [string]: boolean } }

local function giftData(data): GiftData
	local gifts = data.Gifts
	local day = today()
	if
		type(gifts) ~= "table"
		or gifts.Day ~= day
		or type(gifts.Claimed) ~= "table"
		or type(gifts.Seconds) ~= "number"
		or gifts.Seconds ~= gifts.Seconds
	then
		gifts = { Day = day, Seconds = 0, Claimed = {} }
		data.Gifts = gifts
	end
	return gifts
end

local function prizeType(prize): string
	return tostring(prize.Type or prize.Kind or "Cash")
end

-- Einkommen + Schritte-Tempo einmal ausrechnen (für mehrere Belohnungstexte auf einmal).
-- state (optional) = schon gebauter State: dann werden Income/StepsMult daraus genommen statt neu gerechnet.
type Rates = { Income: number, StepsPerSecond: number }

local function rates(player: Player, data, state: { [string]: any }?): Rates
	local best = Config.BestTreadmill(data.Treadmills)
	local rate = best and best.Rate or 1
	local income = state and tonumber(state.Income)
	local stepsMult = state and tonumber(state.StepsMult)
	return {
		Income = finite(income or Services.EconomyService.GetIncome(player)),
		StepsPerSecond = finite(
			rate / Config.TreadmillTick * (stepsMult or Services.EconomyService.GetStepsMult(player))
		),
	}
end

local function cashAmount(prize, r: Rates): number
	return math.floor(math.max(tonumber(prize.Min) or 0, r.Income * (tonumber(prize.Seconds) or 60)))
end

local function stepsAmount(prize, r: Rates): number
	return math.floor(math.max(tonumber(prize.Min) or 0, r.StepsPerSecond * (tonumber(prize.Seconds) or 60)))
end

local function spinsAmount(prize): number
	return math.clamp(math.floor(tonumber(prize.Amount) or 1), 1, 100)
end

local function spinsWord(n: number): string
	return n .. (n == 1 and " Dreh" or " Drehs")
end

-- Feld-Name fürs Glücksrad, z.B. "🌟 Legendary-Ei"
local function prizeLabel(prize): string
	local name = prize.Name or (prizeType(prize) == "Egg" and (tostring(prize.Rarity) .. "-Ei")) or prizeType(prize)
	return (prize.Icon and (tostring(prize.Icon) .. " ") or "") .. tostring(name)
end

-- Was gibt es? (Anzeige im Client, mit den aktuellen Beträgen)
local function prizeText(prize, r: Rates): string
	local kind = prizeType(prize)
	if kind == "Steps" then
		return tostring(prize.Icon or "👟") .. " " .. Util.FormatNumber(stepsAmount(prize, r)) .. " Schritte"
	elseif kind == "Spins" then
		return tostring(prize.Icon or "🎡") .. " " .. spinsWord(spinsAmount(prize))
	elseif kind == "Egg" then
		return tostring(prize.Icon or "🥚") .. " " .. tostring(prize.Name or (tostring(prize.Rarity) .. "-Ei"))
	end
	return tostring(prize.Icon or "💵") .. " " .. Util.FormatCash(cashAmount(prize, r))
end

-- -------------------------------------------------------------------
-- EIER & PREISE GUTSCHREIBEN
-- -------------------------------------------------------------------
-- Ei (Meteor) einer Seltenheit in die Base. Base voll / keine Base -> Geld statt Ei:
--   Gratis-Belohnung (Geschenk, Glücksrad): der Verkaufswert (Wert * Config.SellRatio) – sonst lohnt
--   es sich, die Base absichtlich voll zu lassen. opts.FullValue (Robux-Käufe): der volle Wert.
-- opts.Fixed = immer der günstigste Meteor der Seltenheit (z.B. Länder ohne Zufalls-Käufe)
-- opts.RandomMutation = Mutation würfeln (Gold, Frost ...), sonst "Normal"
-- opts.DayOnly = nie Nacht-Eier (Robux-Käufe: die angegebenen Chancen gelten immer, auch nachts)
-- Gibt (true, Text) zurück – false nur, wenn es die Seltenheit nicht gibt.
function RewardService.GiveEgg(
	player: Player,
	rarityName: string,
	opts: { Fixed: boolean?, RandomMutation: boolean?, FullValue: boolean?, DayOnly: boolean? }?
): (boolean, string)
	local Meteor = Services.MeteorService
	local def = nil
	if opts and (opts.Fixed or opts.DayOnly) then
		local list = Config.MeteorsByRarity[rarityName]
		if not list or #list == 0 then
			list = Config.MeteorsByRarityAll[rarityName]
		end
		if list and #list > 0 then
			def = if opts.Fixed then list[1] else list[rng:NextInteger(1, #list)]
		end
	else
		def = Meteor.RandomOfRarity(rarityName, true)
	end
	if not def then
		warn("[RewardService] Keine Meteore der Seltenheit " .. tostring(rarityName))
		return false, "???"
	end
	local mut = "Normal"
	if opts and opts.RandomMutation then
		mut = Meteor.RollMutation(1)
	end
	local entry = { Id = def.Id, Mut = Config.MutationsByName[mut] and mut or "Normal", Lv = 1 }
	local label = (entry.Mut ~= "Normal" and (entry.Mut .. " ") or "") .. def.Name .. " (" .. def.Rarity .. ")"
	if Services.EconomyService.GiveMeteor(player, entry, true) then
		return true, "🥚 " .. label .. " fliegt in deine Base!"
	end
	local ratio = if opts and opts.FullValue then 1 else Config.SellRatio
	local value = math.floor(Config.MeteorValue(entry) * ratio)
	Services.EconomyService.AddCash(player, value)
	return true, "📦 Base voll – du bekommst " .. Util.FormatCash(value) .. " statt " .. label
end

-- Schreibt einen Preis (Geschenk / Glücksrad) gut und gibt den Text zurück.
-- effects = fliegende Zahlen sofort zeigen (beim Glücksrad macht das der Client nach dem Drehen)
local function grantPrize(player: Player, data, prize, effects: boolean): string
	local Economy = Services.EconomyService
	local kind = prizeType(prize)
	local r = rates(player, data)
	if kind == "Steps" then
		local amount = stepsAmount(prize, r)
		Economy.AddSteps(player, amount) -- geschenkt, nicht gelaufen -> zählt nicht für "Lauf X Schritte"
		if effects then
			Economy.Effect(player, "Steps", amount)
		end
		return "+" .. Util.FormatNumber(amount) .. " Schritte 👟"
	elseif kind == "Spins" then
		local amount = spinsAmount(prize)
		RewardService.AddSpins(player, amount)
		return "+" .. spinsWord(amount) .. " 🎡"
	elseif kind == "Egg" then
		-- DayOnly: Glücksrad-Drehs kann man kaufen -> gleiche Eier-Auswahl wie im Shop angezeigt (ohne Nacht-Eier)
		local ok, text =
			RewardService.GiveEgg(player, tostring(prize.Rarity), { RandomMutation = true, DayOnly = true })
		if ok then
			return text
		end
		-- Seltenheit gibt es nicht (Config geändert) -> kleines Cash-Geschenk statt nichts
	end
	local amount = cashAmount(prize, r)
	Economy.AddCash(player, amount)
	if effects then
		Economy.Effect(player, "Collect", amount)
	end
	return "+" .. Util.FormatCash(amount) .. " 💵"
end

function RewardService.AddSpins(player: Player, n: number): boolean
	local data = Services.DataService.Get(player)
	local amount = math.floor(tonumber(n) or 0)
	if not data or amount ~= amount or amount == 0 then
		return false
	end
	data.Spins = math.clamp((tonumber(data.Spins) or 0) + amount, 0, MAX_SPINS)
	markDirty(player)
	return true
end

-- -------------------------------------------------------------------
-- 📜 TAGESAUFGABEN
-- -------------------------------------------------------------------
local function questGoal(def, r: Rates): number
	if def.Scale == "Steps" then
		return math.max(QUEST_STEPS_MIN, roundNice(r.StepsPerSecond * QUEST_STEPS_SECONDS))
	elseif def.Scale == "Collect" then
		return math.max(QUEST_COLLECT_MIN, roundNice(r.Income * QUEST_COLLECT_SECONDS))
	end
	return def.Goals[rng:NextInteger(1, #def.Goals)]
end

local function questText(quest): string
	local def = QUEST_BY_ID[quest.Id]
	if not def then
		return "???"
	end
	local goal = def.Scale == "Collect" and Util.FormatCash(quest.Goal) or Util.FormatNumber(quest.Goal)
	return def.Text:format(goal)
end

local function questRewardCash(r: Rates): number
	return math.floor(math.max(QUEST_REWARD_MIN, r.Income * QUEST_REWARD_SECONDS))
end

local function questsValid(quests, day: string): boolean
	if type(quests) ~= "table" or quests.Day ~= day or type(quests.List) ~= "table" or #quests.List == 0 then
		return false
	end
	for _, quest in ipairs(quests.List) do
		local def = type(quest) == "table" and QUEST_BY_ID[quest.Id]
		if
			not def
			or quest.Kind ~= def.Kind
			or type(quest.Goal) ~= "number"
			or type(quest.Progress) ~= "number"
			or quest.Goal ~= quest.Goal
			or quest.Progress ~= quest.Progress
		then
			return false
		end
	end
	return true
end

-- 3 zufällige Aufgaben (verschiedene Arten, höchstens eine "mit anderen Spielern")
local function rollQuests(player: Player, data)
	local pool = table.clone(QUEST_POOL)
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local r = rates(player, data)
	local list = {}
	local hasSocial = false
	for _, def in ipairs(pool) do
		if #list >= QUESTS_PER_DAY then
			break
		end
		if not (def.Social and hasSocial) then
			hasSocial = hasSocial or def.Social == true
			table.insert(list, {
				Id = def.Id,
				Kind = def.Kind,
				Goal = questGoal(def, r),
				Progress = 0,
				Claimed = false,
			})
		end
	end
	data.Quests = { Day = today(), List = list }
end

-- Neuer UTC-Tag (oder kaputte Daten) -> neue Aufgaben. Gibt true zurück, wenn neu gewürfelt wurde.
local function ensureQuests(player: Player, data): boolean
	local day = today()
	local quests = data.Quests
	if questsValid(quests, day) then
		return false
	end
	local hadOld = type(quests) == "table" and type(quests.Day) == "string" and quests.Day ~= ""
	rollQuests(player, data)
	if hadOld then
		notify(player, "📜 Neue Tagesaufgaben sind da!", "Info")
	end
	markDirty(player)
	return true
end

-- Fortschritt zählen: kind = "Grab" | "Steal" | "Hatch" | "Steps" | "Collect" | "Bonk"
function RewardService.Track(player: Player, kind: string, amount: number?)
	if not TRACK_KINDS[kind] then
		return
	end
	local n = tonumber(amount) or 1
	if n ~= n or n <= 0 or n == math.huge then
		return
	end
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	ensureQuests(player, data)
	for _, quest in ipairs(data.Quests.List) do
		if quest.Kind == kind and not quest.Claimed and quest.Progress < quest.Goal then
			quest.Progress = math.min(quest.Goal, quest.Progress + n)
			if quest.Progress >= quest.Goal then
				notify(
					player,
					"📜 Aufgabe geschafft: " .. questText(quest) .. " – hol dir die Belohnung! 🎁",
					"Success"
				)
			end
			markDirty(player)
		end
	end
end

function RewardService.ClaimQuest(player: Player, index: any): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch... ⏳"
	end
	if ensureQuests(player, data) then
		return false, "📜 Neuer Tag – neue Aufgaben!"
	end
	local i = tonumber(index)
	local quest = i and data.Quests.List[i]
	if type(quest) ~= "table" then
		return false, "Unbekannte Aufgabe"
	end
	if quest.Claimed then
		return false, "✅ Schon abgeholt!"
	end
	if quest.Progress < quest.Goal then
		return false,
			"📜 Noch nicht geschafft ("
				.. Util.FormatNumber(quest.Progress)
				.. "/"
				.. Util.FormatNumber(quest.Goal)
				.. ")"
	end
	quest.Claimed = true
	local cash = questRewardCash(rates(player, data))
	Services.EconomyService.AddCash(player, cash)
	RewardService.AddSpins(player, QUEST_REWARD_SPINS)
	Services.EconomyService.Effect(player, "Collect", cash)
	Services.EconomyService.Effect(player, "Confetti", 1)
	markDirty(player)
	return true, "📜 Belohnung: +" .. Util.FormatCash(cash) .. " und +" .. spinsWord(QUEST_REWARD_SPINS) .. " 🎡!"
end

-- 🔄 Einmal pro Tag eine (noch nicht geschaffte) Aufgabe tauschen – z.B. "Bonk 3 Diebe" auf einem
-- leeren Server. Die neue Aufgabe braucht nie andere Spieler und ist von einer Art, die heute noch fehlt.
function RewardService.RerollQuest(player: Player, index: any): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch... ⏳"
	end
	if ensureQuests(player, data) then
		return false, "📜 Neuer Tag – neue Aufgaben!"
	end
	local quests = data.Quests
	if quests.Rerolled == true then
		return false, "🔄 Heute schon getauscht – morgen wieder!"
	end
	local i = tonumber(index)
	local quest = i and quests.List[i]
	if type(quest) ~= "table" then
		return false, "Unbekannte Aufgabe"
	end
	if quest.Claimed or quest.Progress >= quest.Goal then
		return false, "✅ Die hast du schon geschafft!"
	end
	local used = {}
	for _, other in ipairs(quests.List) do
		used[other.Id] = true
	end
	local options = {}
	for _, def in ipairs(QUEST_POOL) do
		if not def.Social and not used[def.Id] then
			table.insert(options, def)
		end
	end
	if #options == 0 then
		return false, "🔄 Gerade keine andere Aufgabe frei"
	end
	local def = options[rng:NextInteger(1, #options)]
	local fresh = {
		Id = def.Id,
		Kind = def.Kind,
		Goal = questGoal(def, rates(player, data)),
		Progress = 0,
		Claimed = false,
	}
	quests.List[i] = fresh
	quests.Rerolled = true
	markDirty(player)
	return true, "🔄 Neue Aufgabe: " .. questText(fresh)
end

-- -------------------------------------------------------------------
-- 🎁 SPIELZEIT-GESCHENKE (Spielzeit von heute, siehe giftData)
-- -------------------------------------------------------------------
local function giftReadyIn(gifts: GiftData, gift): number
	return math.max(0, math.ceil((tonumber(gift.Minutes) or 0) * 60 - gifts.Seconds))
end

function RewardService.ClaimGift(player: Player, index: any): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch... ⏳"
	end
	local i = tonumber(index)
	local gift = i and giftList()[i]
	if type(gift) ~= "table" or not i then
		return false, "Unbekanntes Geschenk"
	end
	local gifts = giftData(data)
	local key = tostring(i)
	if gifts.Claimed[key] then
		return false, "✅ Schon abgeholt!"
	end
	local remaining = giftReadyIn(gifts, gift)
	if remaining > 0 then
		return false, "⏳ Noch " .. Util.FormatTime(remaining) .. " spielen!"
	end
	gifts.Claimed[key] = true
	local text = grantPrize(player, data, gift, true)
	Services.EconomyService.Effect(player, "Confetti", 1)
	markDirty(player)
	return true, "🎁 Geschenk: " .. text
end

-- -------------------------------------------------------------------
-- 🎡 GLÜCKSRAD
-- -------------------------------------------------------------------
-- Sekunden bis zum nächsten Gratis-Dreh (0 = bereit)
function RewardService.FreeSpinIn(data): number
	local elapsed = math.max(0, os.time() - (tonumber(data.LastFreeSpin) or 0))
	return math.max(0, math.ceil(freeSpinPeriod() - elapsed))
end

-- Dreht das Rad: erst den Gratis-Dreh, sonst einen aus data.Spins.
-- Antwort-Extras für den Client: Segment = Feld (Index in Config.WheelPrizes), Prize = Feld-Text
function RewardService.Spin(player: Player): (boolean, string, { [string]: any }?)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch... ⏳", nil
	end
	local t = os.clock()
	if t - (lastSpin[player] or -math.huge) < SPIN_COOLDOWN then
		return false, "🎡 Das Rad dreht sich noch!", nil
	end
	local freeIn = RewardService.FreeSpinIn(data)
	local free = freeIn <= 0
	if not free and (tonumber(data.Spins) or 0) < 1 then
		return false, "🎡 Keine Drehs mehr! Gratis-Dreh in " .. Util.FormatTime(freeIn), nil
	end
	local prizes = wheelList()
	if #prizes == 0 then
		return false, "🎡 Das Glücksrad ist noch nicht eingerichtet", nil
	end
	local index = table.find(prizes, Util.WeightedPick(prizes, nil, rng)) or 1
	local prize = prizes[index]

	lastSpin[player] = t
	if free then
		data.LastFreeSpin = os.time()
		freeSpinNotified[player] = nil
	else
		data.Spins -= 1
	end
	local text = grantPrize(player, data, prize, false)
	markDirty(player)

	-- Großer Ei-Gewinn: allen ansagen, sobald das Rad beim Gewinner stehen geblieben ist
	local rarity = prizeType(prize) == "Egg" and Config.RarityIndex[prize.Rarity] or nil
	if rarity and rarity >= (Config.RarityIndex[SPIN_ANNOUNCE_RARITY] or math.huge) then
		local name = player.DisplayName
		task.delay(SPIN_REVEAL_DELAY, function()
			Services.EconomyService.NotifyAll(
				"🎡 " .. name .. " hat ein " .. tostring(prize.Rarity) .. "-Ei am Glücksrad gewonnen!",
				"Event"
			)
		end)
	end
	return true, "🎡 Gewonnen: " .. text, {
		Segment = index,
		Prize = prizeLabel(prize),
		Free = free,
	}
end

-- -------------------------------------------------------------------
-- DATEN AN DEN CLIENT (EconomyService ruft das bei jedem State auf)
--   Spins, FreeSpinIn, QuestReroll: klein -> immer
--   Gifts (+ GiftsAt), Quests: nur bei Änderung oder wenn full = true (alle ~20 s). Der Client behält
--   sonst die alten. ReadyIn gilt ab GiftsAt (Serverzeit) – so zählt der Client auch mit einem
--   älteren Paket richtig herunter.
-- -------------------------------------------------------------------
function RewardService.FillState(player: Player, data, state, full: boolean?)
	ensureQuests(player, data)
	local r = rates(player, data, state)
	local gifts = giftData(data)

	state.Spins = tonumber(data.Spins) or 0
	state.FreeSpinIn = RewardService.FreeSpinIn(data)
	state.QuestReroll = data.Quests.Rerolled ~= true -- heute noch eine Aufgabe tauschbar?

	local giftRows = {}
	local giftKey = { gifts.Day }
	for i, gift in ipairs(giftList()) do
		local claimed = gifts.Claimed[tostring(i)] == true
		local text = prizeText(gift, r)
		giftRows[i] = {
			Minutes = tonumber(gift.Minutes) or 0,
			Claimed = claimed,
			ReadyIn = giftReadyIn(gifts, gift),
			Text = text,
		}
		table.insert(giftKey, (if claimed then "1" else "0") .. text)
	end
	local giftSignature = table.concat(giftKey, "|")
	if full or sentGiftKey[player] ~= giftSignature then
		sentGiftKey[player] = giftSignature
		state.Gifts = giftRows
		state.GiftsAt = workspace:GetServerTimeNow()
	end

	local quests = {}
	local questKey = { data.Quests.Day }
	local rewardText = "💵 " .. Util.FormatCash(questRewardCash(r)) .. " + 🎡 " .. spinsWord(QUEST_REWARD_SPINS)
	for i, quest in ipairs(data.Quests.List) do
		local text = questText(quest)
		local claimed = quest.Claimed == true
		quests[i] = {
			Text = text,
			Kind = quest.Kind, -- z.B. "Collect" -> der Client zeigt den Fortschritt mit $
			Goal = quest.Goal,
			Progress = quest.Progress,
			Claimed = claimed,
			RewardText = rewardText,
		}
		table.insert(questKey, text .. "#" .. tostring(quest.Progress) .. (if claimed then "1" else "0"))
	end
	table.insert(questKey, rewardText)
	local questSignature = table.concat(questKey, "|")
	if full or sentQuestKey[player] ~= questSignature then
		sentQuestKey[player] = questSignature
		state.Quests = quests
	end
end

-- Jede Sekunde: Spielzeit hochzählen, "Geschenk bereit" / "Gratis-Dreh bereit" melden (je einmal)
local function tickPlayer(player: Player, dt: number)
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	local gifts = giftData(data)
	gifts.Seconds = math.min(MAX_GIFT_SECONDS, gifts.Seconds + dt)
	if sessionSeconds(player) < FIRST_NOTIFY_DELAY then
		return
	end
	local notified = notifiedGifts[player]
	if not notified or notifiedDay[player] ~= gifts.Day then
		notified = {} -- neuer Tag -> alle Geschenke wieder neu melden
		notifiedGifts[player] = notified
		notifiedDay[player] = gifts.Day
	end
	local ready = 0
	for i, gift in ipairs(giftList()) do
		if not notified[i] and not gifts.Claimed[tostring(i)] and giftReadyIn(gifts, gift) <= 0 then
			notified[i] = true
			ready += 1
		end
	end
	if ready > 0 then
		notify(player, "🎁 Ein Geschenk wartet auf dich! Klick auf 🎁 Geschenke.", "Success")
		markDirty(player)
	end
	if not freeSpinNotified[player] and RewardService.FreeSpinIn(data) <= 0 then
		freeSpinNotified[player] = true
		notify(player, "🎡 Gratis-Dreh bereit! Dreh am Glücksrad!", "Success")
		markDirty(player)
	end
end

function RewardService.Init(services)
	Services = services
end

function RewardService.Start()
	local function onPlayer(player: Player)
		joinedAt[player] = joinedAt[player] or os.clock()
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		joinedAt[player] = nil
		lastTick[player] = nil
		notifiedGifts[player] = nil
		notifiedDay[player] = nil
		freeSpinNotified[player] = nil
		lastSpin[player] = nil
		sentGiftKey[player] = nil
		sentQuestKey[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				if Services.EconomyService.IsReady(player) then
					-- echte vergangene Zeit (task.wait ist nie genau 1 s), nach Hängern gedeckelt
					local clock = os.clock()
					local dt = math.clamp(clock - (lastTick[player] or clock), 0, MAX_TICK)
					lastTick[player] = clock
					local ok, err = pcall(tickPlayer, player, dt)
					if not ok then
						warn("[RewardService] Fehler bei " .. player.Name .. ": " .. tostring(err))
					end
				end
			end
		end
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">RunService</string>
            <string name="Source"><![CDATA[-- ☄️ METEOR-RUN: langer Lauf-Parcours (Obby) – wer schnell ist, gewinnt ein Gratis-Ei!
--
-- LAGE: rechts neben dem Spawn-Platz, dann hinter den rechten Basen entlang bis zum Map-Ende
-- (zwischen den Rückwänden der Basen und der rechten Randwand). X-Mitte, Breite und Start werden
-- aus der Map abgeleitet (Basen, Randwände, Spawn-Platz). Deko (Bäume/Büsche) im Weg wird entfernt.
-- Die Strecke liegt erhöht (TOP Studs): wer runterfällt, muss zurück zum letzten Checkpoint.
--
-- ABLAUF: Rampe hoch -> durchs Start-Tor ("Bereit") -> über die Startlinie = Timer läuft
--   1 🔥 Lava-Felder   2 🦘 Sprünge über Lücken   3 🌀 rotierende Balken
--   4 ☄️ Meteor-Einschläge   5 🔥 Lava-Steine   -> 🏁 Ziel-Podest mit Belohnungs-Ei
-- Checkpoints (Pads) speichern den Fortschritt im Run. Lava, Runterfallen und Einschläge = zurück
-- zum letzten Checkpoint (niemand stirbt). Im Ziel: Cash + ein Gratis-Ei (Epic..Mythic, selten höher),
-- das man wie ein geklautes Ei nach Hause TRAGEN muss (CarryService, Source = "Ground", mit
-- ScaleTimeout = mehr Trage-Zeit, je weiter die eigene Base vom Ziel weg ist).
-- Abklingzeit pro Spieler zwischen zwei Belohnungen (auch im Spielstand: data.RunRewardAt),
-- Bestzeit in data.RunBest.
--
-- PERFORMANCE: Der Server bewegt NICHTS. Die rotierenden Balken dreht jeder Client selbst
-- (Attribute SpinPivot/SpinAxis/SpinSpeed/SpinT0, Winkel aus der Serverzeit -> alle sehen dasselbe).
-- Der Server prüft nur alle 0,2 s die Positionen (Lava, Checkpoints, Ziel, Runterfallen).
-- Einschläge bestimmt der Server: Effekt "RunImpact" an alle (Warnkreis 1 s vorher), dann Treffer-Prüfung.
--
-- ANTI-CHEAT: Checkpoints nur in der richtigen Reihenfolge, Ziel nur mit allen Checkpoints und
-- frühestens nach Streckenlänge / (MaxWalkSpeed * 1.3). Teleport-/Speed-Verstoß (CarryService.MoveStatus)
-- bricht den Run ab; Linien zählen nur bei einem zu Fuß möglichen Schritt (plausibleStep – auch in der
-- Schonzeit nach einem Zurücksetzen). Schweben über Lava (zu lange in der Luft, nicht auf einem Stein)
-- und Fliegen (viel zu hoch) = zurück zum Checkpoint. Wer etwas trägt, kann nicht starten.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))

local RunService = {}
local Services

local rng = Random.new()

-- -------------------------------------------------------------------
-- EINSTELLUNGEN
-- -------------------------------------------------------------------
local TOP = 8 -- Höhe der Lauffläche über der Wiese
local DECK = 1 -- Dicke der Lauffläche
local RAMP_LENGTH = 32 -- Rampe von der Wiese hoch zum Start
local PLAZA_GAP = 6 -- Abstand Rampen-Oberkante <-> Rand des Spawn-Platzes (Z)
local MAX_WIDTH = 14
local MIN_WIDTH = 8
-- Ersatzwerte, falls die Map anders aussieht (Werte aus MapBuilder)
local FALLBACK_PLOT_EDGE = 124
local FALLBACK_WALL_X = 168
local FALLBACK_WALL_MAX_Z = 256
local FALLBACK_PLAZA_MAX_Z = -226

local TICK = 0.2 -- so oft prüft der Server die Läufer
local REWARD_COOLDOWN = 180 -- Sekunden zwischen zwei Belohnungen pro Spieler
local MAX_RUN_TIME = 600 -- länger = Run abgebrochen
local AREA_SIDE = 20 -- so weit seitlich neben der Streckenmitte = Run abgebrochen (z.B. Home-Teleport)
local AREA_END = 12 -- so weit vor der Rampe / hinter dem Ziel = Run abgebrochen
local FALL_DEPTH = 1 -- Hüfte tiefer als Lauffläche + FALL_DEPTH = runtergefallen
local FOOT = 0.4 -- Lava-Felder zählen so viel breiter (Füße ragen über die Hüfte hinaus)
local NOTIFY_GAP = 1.5 -- Hinweise (Lava, Checkpoint fehlt ...) höchstens so oft pro Spieler
local SPEED_TOLERANCE = 1.3 -- Mindestzeit = Streckenlänge / (MaxWalkSpeed * SPEED_TOLERANCE)
-- Checkpoints/Ziel zählen nur, wenn der Schritt seit der letzten Messung zu Fuß möglich war
-- (WalkSpeed * STEP_FACTOR + STEP_EXTRA) * dt + STEP_SLACK – sonst wäre ein Teleport in der Schonzeit
-- nach einem Zurücksetzen (CarryService.MoveStatus = "wait") ein Abkürzungs-Trick
local STEP_FACTOR = 1.5
local STEP_EXTRA = 16
local STEP_SLACK = 4
local LAVA_AIR_MAX = 1.5 -- so lange darf man über Lava "in der Luft" sein (Sprung ~0,5 s) – länger = Schweben
-- Nach einem Server-Teleport kurz nichts prüfen: bis der Client den Teleport kennt, kommen noch alte
-- Positionen an (sonst: mehrfaches Zurücksetzen hintereinander bei hohem Ping)
local TELEPORT_GRACE = 0.75
local MAX_HEIGHT = 20 -- Hüfte höher als Lauffläche + das = Flug-Cheat -> zurück zum Checkpoint

local IMPACT_WARN = 1 -- Sekunden Warnkreis vor dem Einschlag
local IMPACT_RADIUS = 6
local IMPACT_INTERVAL = 0.7 -- so oft schlägt es ein, solange jemand im Einschlag-Abschnitt ist
local IMPACT_MAX = 6 -- höchstens so viele Einschläge gleichzeitig angekündigt
local IMPACT_AIM_CHANCE = 0.6 -- so oft wird auf einen Läufer gezielt (mit Vorhalt)
local IMPACT_LEAD = 0.6 -- Vorhalt in Sekunden
local IMPACT_HEIGHT = 12 -- so hoch über der Lauffläche trifft ein Einschlag noch (Hochspringen rettet nicht)

-- Belohnung
local PAR_TIME = 40 -- schneller als das = mehr Glück beim Ei
local RUN_MIN_CASH = 2500
local RUN_CASH_SECONDS = 90 -- Cash = max(RUN_MIN_CASH, Einkommen pro Sekunde * das)
local NEW_BEST_CASH_MULT = 1.5
local REBIRTH_LUCK = 0.1 -- pro Rebirth (max. 10) mehr Glück
local ANNOUNCE_RARITY = Config.RarityIndex.Mythic or 6 -- ab Mythic: allen ansagen
-- Gratis-Ei: Lucky = Gewicht wächst mit dem Glück, MinRebirths = erst ab so vielen Rebirths
local EGG_TABLE = {
	{ Rarity = "Epic", Weight = 60 },
	{ Rarity = "Legendary", Weight = 28, Lucky = true },
	{ Rarity = "Mythic", Weight = 10, Lucky = true },
	{ Rarity = "Celestial", Weight = 1.5, Lucky = true },
	{ Rarity = "Divine", Weight = 0.25, Lucky = true, MinRebirths = 3 },
}

-- Strecke: Abstände (Studs) ab der Rampen-Oberkante entlang +Z
local GATE_D = 6 -- Start-Tor
local READY_FROM_D = 7 -- ab hier "Bereit"
local START_LINE_D = 16 -- Startlinie: hier startet der Timer
local START_RESPAWN_D = 19 -- zurückgesetzt ohne Checkpoint -> hierhin (Timer läuft weiter)
local CHECKPOINT_D = { 104, 192, 280, 368 } -- Mitte der Checkpoint-Pads
local CHECKPOINT_DEPTH = 8
local IMPACT_AFTER_CP = 3 -- Einschlag-Abschnitt liegt hinter Checkpoint 3
local IMPACT_FROM_D = 288
local IMPACT_TO_D = 360
local FINISH_D = 434 -- Ziellinie
local END_D = 452 -- Ende des Ziel-Podests

local COLORS = {
	Deck = Color3.fromRGB(46, 40, 78),
	DeckAlt = Color3.fromRGB(60, 44, 96),
	Edge = Color3.fromRGB(0, 220, 255),
	Pillar = Color3.fromRGB(70, 70, 86),
	Lava = Color3.fromRGB(255, 90, 20),
	Stone = Color3.fromRGB(110, 100, 95),
	Gate = Color3.fromRGB(255, 140, 40),
	Finish = Color3.fromRGB(255, 205, 40),
	Checkpoint = Color3.fromRGB(80, 200, 255),
	Spinner = Color3.fromRGB(255, 60, 90),
	Crater = Color3.fromRGB(40, 30, 30),
}
local WHITE = Color3.new(1, 1, 1)

local RESET_TEXT: { [string]: string } = {
	lava = "🔥 Lava! Zurück zum Checkpoint!",
	fall = "🕳️ Runtergefallen! Zurück zum Checkpoint!",
	impact = "☄️ Getroffen! Zurück zum Checkpoint!",
}

-- -------------------------------------------------------------------
-- ZUSTAND
-- -------------------------------------------------------------------
type Box = { MinX: number, MaxX: number, MinZ: number, MaxZ: number, Top: number }
-- Phase "Ready" = im Start-Tor (Timer steht), "Running" = Timer läuft
type RunState = { Phase: string, Start: number, CP: number }

local runs: { [Player]: RunState } = {}
local cooldownUntil: { [number]: number } = {} -- UserId -> Serverzeit (überlebt Neu-Beitreten auf dem Server)
-- Zusätzlich im Spielstand: data.RunRewardAt = os.time(), ab dann gibt es wieder eine Belohnung
-- (sonst: Server wechseln = Abklingzeit weg)
local notifyAt: { [Player]: number } = {}
local lastPos: { [Player]: Vector3 } = {} -- letzte gemessene Position (für Linien und Lava dazwischen)
local lavaAir: { [Player]: number } = {} -- Sekunden ununterbrochen über Lava, ohne auf einem Stein zu stehen
local graceUntil: { [Player]: number } = {} -- os.clock(): bis dann keine Lava-/Fall-/Einschlag-Prüfung
local runFolder: Folder? = nil
local recordLabel: TextLabel? = nil
local serverRecord: { Name: string, Time: number }? = nil

-- Geometrie (wird beim Bauen gesetzt)
local X0 = 146
local Z0 = -232
local WIDTH = MAX_WIDTH
local lavaBoxes: { Box } = {}
local checkpointZ: { number } = {}
local respawnCF: { CFrame } = {} -- [1] = Start, [i + 1] = Checkpoint i
local startSpawnCF = CFrame.new()
local readyMinZ, readyMaxZ = 0, 0
local finishZ = 0
local exitMinZ, exitMaxZ = 0, 0 -- Rampe vom Ziel-Podest runter
local lineMinX, lineMaxX = 0, 0 -- so breit zählen Startlinie, Checkpoints, Ziel
local areaMinX, areaMaxX, areaMinZ, areaMaxZ = 0, 0, 0, 0 -- Strecke mit Rand
local exitMinX = 0 -- Ziel-Rampe zählt auch noch zur Strecke (bis hier)
local minRunTime = 0
local stoneParams = RaycastParams.new() -- Strahl nach unten trifft nur die Lava-Steine
stoneParams.FilterType = Enum.RaycastFilterType.Include

-- -------------------------------------------------------------------
-- KLEINE HELFER
-- -------------------------------------------------------------------
local function now(): number
	return workspace:GetServerTimeNow()
end

-- 41.27 -> "0:41.3"
local function formatRunTime(seconds: number): string
	local tenths = math.floor(math.max(0, seconds) * 10 + 0.5)
	return string.format("%d:%04.1f", tenths // 600, (tenths % 600) / 10)
end

local function world(d: number, x: number, y: number): Vector3
	return Vector3.new(X0 + x, y, Z0 + d)
end

local function aliveRoot(player: Player): (BasePart?, Humanoid?)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return root, humanoid
end

-- Normale Höhe des HumanoidRootPart über dem Boden, wenn man steht (R15 bzw. R6)
local function standHeight(humanoid: Humanoid, root: BasePart): number
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	return root.Size.Y / 2 + 2
end

local function notifyLimited(player: Player, text: string, kind: string)
	local t = os.clock()
	if t - (notifyAt[player] or 0) < NOTIFY_GAP then
		return
	end
	notifyAt[player] = t
	Services.EconomyService.Notify(player, text, kind)
end

-- Schneidet die Strecke a -> b (waagrecht) das Rechteck? (schnelle Läufer überspringen sonst Felder)
local function segmentHitsBox(a: Vector3, b: Vector3, box: Box): boolean
	local t0, t1 = 0, 1
	for axis = 1, 2 do
		local origin = if axis == 1 then a.X else a.Z
		local delta = if axis == 1 then b.X - a.X else b.Z - a.Z
		local lo = if axis == 1 then box.MinX else box.MinZ
		local hi = if axis == 1 then box.MaxX else box.MaxZ
		if math.abs(delta) < 1e-6 then
			if origin < lo or origin > hi then
				return false
			end
		else
			local u0 = (lo - origin) / delta
			local u1 = (hi - origin) / delta
			if u0 > u1 then
				u0, u1 = u1, u0
			end
			t0 = math.max(t0, u0)
			t1 = math.min(t1, u1)
			if t0 > t1 then
				return false
			end
		end
	end
	return true
end

-- Ist die Linie bei z (quer über die Strecke) von a nach b vorwärts überquert worden?
local function crossedLine(a: Vector3, b: Vector3, z: number): boolean
	if not (a.Z < z and b.Z >= z) then
		return false
	end
	local t = (z - a.Z) / (b.Z - a.Z)
	local x = a.X + (b.X - a.X) * t
	local y = a.Y + (b.Y - a.Y) * t
	return x >= lineMinX and x <= lineMaxX and y > TOP - FALL_DEPTH and y < TOP + 20
end

-- Auf/an der Strecke (inkl. Rampe vom Ziel-Podest)? Weiter weg = Run abgebrochen
local function inArea(p: Vector3): boolean
	if p.X >= areaMinX and p.X <= areaMaxX and p.Z >= areaMinZ and p.Z <= areaMaxZ then
		return true
	end
	return p.X >= exitMinX and p.X < areaMinX and p.Z >= exitMinZ - 4 and p.Z <= exitMaxZ + 4
end

local function inReadyZone(p: Vector3): boolean
	return p.X >= lineMinX and p.X <= lineMaxX and p.Z >= readyMinZ and p.Z < readyMaxZ and p.Y > TOP and p.Y < TOP + 12
end

-- -------------------------------------------------------------------
-- BAU-HELFER (wie im MapBuilder)
-- -------------------------------------------------------------------
local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false -- alles wird per Position geprüft (spart Physik-Arbeit)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Unsichtbarer Ankerpunkt für Schilder
local function anchorPart(name: string, position: Vector3, parent: Instance): Part
	return part({
		Name = name,
		Size = Vector3.new(1, 1, 1),
		Position = position,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = parent,
	})
end

type SignLine = { Name: string, Text: string, Color: Color3, Height: number }

-- Mehrzeiliges Schild in Studs-Größe (Aufbau wie MapBuilder: BillboardGui > Frame > TextLabels)
local function worldSign(parent: Instance, width: number, height: number, lines: { SignLine }): { [string]: TextLabel }
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.fromScale(width, height)
	gui.MaxDistance = 400
	gui.LightInfluence = 0
	gui.Parent = parent
	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = frame
	local labels: { [string]: TextLabel } = {}
	for order, line in ipairs(lines) do
		local label = Instance.new("TextLabel")
		label.Name = line.Name
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, line.Height)
		label.LayoutOrder = order
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = line.Color
		label.Text = line.Text
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.new(0, 0, 0)
		stroke.Parent = label
		label.Parent = frame
		labels[line.Name] = label
	end
	return labels
end

-- -------------------------------------------------------------------
-- LAGE AUS DER MAP ABLEITEN
-- -------------------------------------------------------------------
-- X-Mitte zwischen Außenkante der rechten Basen und rechter Randwand, Start neben dem Spawn-Platz
local function computeLayout(map: Instance?)
	local plotEdge = -math.huge
	for _, plot in ipairs(Services.PlotService.Plots) do
		local cf = plot.CFrame
		if typeof(cf) == "CFrame" and cf.Position.X > 0 then
			-- Basen können rechteckig + gedreht sein -> echte Außenkante aus dem Welt-Rechteck
			local _, maxX = Services.PlotService.WorldRect(plot)
			plotEdge = math.max(plotEdge, maxX)
		end
	end
	if plotEdge == -math.huge then
		plotEdge = FALLBACK_PLOT_EDGE
	end
	local wallX, wallMaxZ = FALLBACK_WALL_X, FALLBACK_WALL_MAX_Z
	local plazaMaxZ = FALLBACK_PLAZA_MAX_Z
	if map then
		local foundX, foundZ = math.huge, -math.huge
		for _, child in ipairs(map:GetChildren()) do
			if child.Name == "Boundary" and child:IsA("BasePart") then
				if child.Size.X < child.Size.Z and child.Position.X > 0 then
					foundX = math.min(foundX, child.Position.X - child.Size.X / 2)
				elseif child.Size.Z < child.Size.X and child.Position.Z > 0 then
					foundZ = math.max(foundZ, child.Position.Z - child.Size.Z / 2)
				end
			end
		end
		if foundX < math.huge then
			wallX = foundX
		end
		if foundZ > -math.huge then
			wallMaxZ = foundZ
		end
		local plaza = map:FindFirstChild("Plaza")
		local floorPart = plaza and plaza:FindFirstChild("Floor")
		if floorPart and floorPart:IsA("BasePart") then
			plazaMaxZ = floorPart.Position.Z + floorPart.Size.Z / 2
		end
	end
	local gap = wallX - plotEdge
	WIDTH = math.clamp(gap - 10, MIN_WIDTH, MAX_WIDTH)
	X0 = (plotEdge + wallX) / 2
	Z0 = plazaMaxZ - PLAZA_GAP
	if gap - WIDTH < 4 then
		warn("[RunService] Wenig Platz zwischen Basen und Randwand – der Meteor-Run wird eng")
	end
	if Z0 + END_D + 4 > wallMaxZ then
		warn("[RunService] Der Meteor-Run ist länger als die Map – das Ziel liegt hinter der Randwand!")
	end
end

-- Deko (Bäume/Büsche) im Weg entfernen, andere Kollisionen melden
local function clearArea(map: Instance, center: Vector3, size: Vector3)
	local deco = map:FindFirstChild("Deco")
	-- ohne Filter (alles im Kasten), nur Teile der Map zählen
	local hits = workspace:GetPartBoundsInBox(CFrame.new(center), size)
	local conflicts: { string } = {}
	for _, hit in ipairs(hits) do
		if not hit.Parent or not hit:IsDescendantOf(map) then
			continue -- schon entfernt (Teil eines Baums) oder gehört nicht zur Map
		end
		if deco and hit:IsDescendantOf(deco) then
			-- ganzen Baum entfernen (Stamm + Krone stehen an derselben Stelle)
			local spot = hit.Position
			for _, other in ipairs(deco:GetChildren()) do
				if other ~= hit and other:IsA("BasePart") then
					local dx, dz = other.Position.X - spot.X, other.Position.Z - spot.Z
					if dx * dx + dz * dz < 1 then
						other:Destroy()
					end
				end
			end
			hit:Destroy()
		elseif hit.Name ~= "Ground" and #conflicts < 5 then
			table.insert(conflicts, hit:GetFullName())
		end
	end
	if #conflicts > 0 then
		warn("[RunService] Meteor-Run überschneidet sich mit: " .. table.concat(conflicts, ", "))
	end
end

-- -------------------------------------------------------------------
-- STRECKE BAUEN
-- -------------------------------------------------------------------
local decoFolder: Folder
local lavaFolder: Folder
local spinnerFolder: Folder
local checkpointFolder: Folder

-- Lauffläche von d0 bis d1 (x = Versatz zur Mitte), mit Leuchtkanten und Stützen
local function deck(d0: number, d1: number, x: number, width: number, color: Color3)
	local length = d1 - d0
	local mid = (d0 + d1) / 2
	part({
		Name = "Deck",
		Size = Vector3.new(width, DECK, length),
		Position = world(mid, x, TOP - DECK / 2),
		Material = Enum.Material.SmoothPlastic,
		Color = color,
		Parent = decoFolder,
	})
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "Edge",
			Size = Vector3.new(0.4, 0.3, length),
			Position = world(mid, x + s * (width / 2 - 0.2), TOP + 0.15),
			Material = Enum.Material.Neon,
			Color = COLORS.Edge,
			CanCollide = false,
			CastShadow = false,
			Parent = decoFolder,
		})
	end
	local count = math.max(1, math.floor(length / 20 + 0.5))
	for i = 1, count do
		local d = d0 + length * (i - 0.5) / count
		local offsets = if width >= 6 then { -(width / 2 - 1), width / 2 - 1 } else { 0 }
		for _, ox in ipairs(offsets) do
			part({
				Name = "Pillar",
				Size = Vector3.new(1.2, TOP - DECK, 1.2),
				Position = world(d, x + ox, (TOP - DECK) / 2),
				Material = Enum.Material.Metal,
				Color = COLORS.Pillar,
				CastShadow = false,
				Parent = decoFolder,
			})
		end
	end
end

-- Lava-Feld auf der Lauffläche (x0..x1 relativ zur Mitte). Ohne Kollision: man steht auf dem Deck,
-- die Prüfung macht der Server (Position).
local function lava(d0: number, d1: number, x0: number, x1: number)
	part({
		Name = "Lava",
		Size = Vector3.new(x1 - x0, 0.2, d1 - d0),
		Position = world((d0 + d1) / 2, (x0 + x1) / 2, TOP + 0.1),
		Material = Enum.Material.Neon,
		Color = COLORS.Lava,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = lavaFolder,
	})
	table.insert(lavaBoxes, {
		MinX = X0 + x0 - FOOT,
		MaxX = X0 + x1 + FOOT,
		MinZ = Z0 + d0 - FOOT,
		MaxZ = Z0 + d1 + FOOT,
		Top = TOP,
	})
end

-- Rotierender Balken: der Client dreht ihn um "pivot" (Achse im Pivot-Raum), der Server nie
local function spinner(
	name: string,
	pivot: CFrame,
	offset: CFrame,
	size: Vector3,
	axis: Vector3,
	speed: number,
	t0: number
)
	local bar = part({
		Name = name,
		Size = size,
		CFrame = pivot * offset,
		Material = Enum.Material.Neon,
		Color = COLORS.Spinner,
		CastShadow = false,
		Parent = spinnerFolder,
	})
	bar:SetAttribute("SpinPivot", pivot)
	bar:SetAttribute("SpinAxis", axis)
	bar:SetAttribute("SpinSpeed", speed) -- Bogenmaß pro Sekunde
	bar:SetAttribute("SpinT0", t0) -- Serverzeit, zu der der Balken so steht wie auf dem Server
end

local function gate(d: number, color: Color3, height: number)
	local half = WIDTH / 2
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "GatePillar",
			Size = Vector3.new(1.6, height, 1.6),
			Position = world(d, s * (half + 0.8), TOP + height / 2),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(50, 50, 62),
			Parent = decoFolder,
		})
		part({
			Name = "GateGlow",
			Size = Vector3.new(0.5, height - 1, 0.5),
			Position = world(d, s * (half - 0.1), TOP + height / 2),
			Material = Enum.Material.Neon,
			Color = color,
			CanCollide = false,
			CastShadow = false,
			Parent = decoFolder,
		})
	end
	part({
		Name = "GateBeam",
		Size = Vector3.new(WIDTH + 3.2, 1.6, 1.6),
		Position = world(d, 0, TOP + height + 0.8),
		Material = Enum.Material.Neon,
		Color = color,
		CastShadow = false,
		Parent = decoFolder,
	})
end

-- Linie quer über die Strecke (Start/Ziel: kariert)
local function line(d: number, checkered: boolean)
	local tiles = math.max(2, math.floor(WIDTH / 2))
	local tile = WIDTH / tiles
	for row = 0, 1 do
		for i = 0, tiles - 1 do
			local white = (i + row) % 2 == 0
			if checkered or white then
				part({
					Name = "Line",
					Size = Vector3.new(tile, 0.06, 1),
					Position = world(d - 0.5 + row, -WIDTH / 2 + tile * (i + 0.5), TOP + 0.03),
					Material = Enum.Material.SmoothPlastic,
					Color = if white then WHITE else Color3.fromRGB(20, 20, 24),
					CanCollide = false,
					CanQuery = false,
					CastShadow = false,
					Parent = decoFolder,
				})
			end
		end
	end
end

local function sectionSign(d: number, title: string, hint: string, color: Color3)
	local anchor = anchorPart("SectionSign", world(d, WIDTH / 2 + 2.5, TOP + 7), decoFolder)
	worldSign(anchor, 14, 4.4, {
		{ Name = "Title", Text = title, Color = color, Height = 0.6 },
		{ Name = "Hint", Text = hint, Color = WHITE, Height = 0.4 },
	})
end

local function checkpointPad(index: number, d: number)
	local pad = part({
		Name = "Checkpoint" .. index,
		Size = Vector3.new(WIDTH, 0.12, CHECKPOINT_DEPTH),
		Position = world(d, 0, TOP + 0.06),
		Material = Enum.Material.Neon,
		Color = COLORS.Checkpoint,
		Transparency = 0.25,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = checkpointFolder,
	})
	pad:SetAttribute("CheckpointIndex", index)
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "Flag",
			Size = Vector3.new(0.5, 6, 0.5),
			Position = world(d, s * (WIDTH / 2 + 0.6), TOP + 3),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(220, 220, 230),
			Parent = decoFolder,
		})
		part({
			Name = "FlagCloth",
			Size = Vector3.new(0.2, 1.6, 2.4),
			Position = world(d + 1.2, s * (WIDTH / 2 + 0.6), TOP + 5.2),
			Material = Enum.Material.Neon,
			Color = COLORS.Checkpoint,
			CanCollide = false,
			CastShadow = false,
			Parent = decoFolder,
		})
	end
	local anchor = anchorPart("CheckpointSign", world(d, 0, TOP + 7.5), decoFolder)
	worldSign(anchor, 8, 2.4, {
		{
			Name = "Title",
			Text = "🚩 Checkpoint " .. index .. "/" .. #CHECKPOINT_D,
			Color = Color3.fromRGB(140, 230, 255),
			Height = 1,
		},
	})
	checkpointZ[index] = Z0 + d
	respawnCF[index + 1] = CFrame.lookAt(world(d + 1.5, 0, TOP + 3.5), world(d + 10, 0, TOP + 3.5))
end

local function build(map: Instance): Folder
	local half = WIDTH / 2
	table.clear(lavaBoxes)
	table.clear(checkpointZ)
	table.clear(respawnCF)

	local root = Instance.new("Folder")
	root.Name = "MeteorRun"
	decoFolder = folder("Deco", root)
	lavaFolder = folder("Lava", root)
	spinnerFolder = folder("Spinners", root)
	checkpointFolder = folder("Checkpoints", root)

	-- RAMPE von der Wiese hoch zum Start (Oberkante genau auf der Lauffläche)
	local rampTop = world(0, 0, TOP)
	local rampBottom = world(-RAMP_LENGTH, 0, 0)
	part({
		Name = "Ramp",
		Size = Vector3.new(WIDTH, 1, (rampTop - rampBottom).Magnitude),
		CFrame = CFrame.lookAt((rampTop + rampBottom) / 2, rampTop) * CFrame.new(0, -0.5, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = COLORS.DeckAlt,
		Parent = decoFolder,
	})
	local rampSign = anchorPart("RampSign", world(-RAMP_LENGTH + 2, 0, 9), decoFolder)
	worldSign(rampSign, 20, 5, {
		{ Name = "Title", Text = "☄️ METEOR-RUN ⬆️", Color = COLORS.Gate, Height = 0.62 },
		{ Name = "Hint", Text = "Schnell sein = Gratis-Ei! 🥚", Color = WHITE, Height = 0.38 },
	})

	-- START: Plattform, Tor, Startlinie
	deck(0, 108, 0, WIDTH, COLORS.Deck)
	gate(GATE_D, COLORS.Gate, 13)
	line(START_LINE_D, true)
	local startSign = anchorPart("StartSign", world(GATE_D, 0, TOP + 21), decoFolder)
	local labels = worldSign(startSign, 30, 9, {
		{ Name = "Title", Text = "☄️ METEOR-RUN", Color = COLORS.Gate, Height = 0.5 },
		{ Name = "Record", Text = "🏆 Rekord: noch keiner!", Color = Color3.fromRGB(255, 230, 90), Height = 0.27 },
		{ Name = "Hint", Text = "Über die Linie = Timer läuft!", Color = WHITE, Height = 0.23 },
	})
	recordLabel = labels.Record

	-- 1) LAVA-FELDER (quer, dann Slalom)
	sectionSign(22, "1/5 🔥 LAVA", "Nicht berühren – drüberspringen!", COLORS.Lava)
	lava(28, 32, -half, half)
	lava(40, 44, -half, half)
	lava(50, 62, -half, half * 0.15)
	lava(64, 76, -half * 0.15, half)
	lava(82, 87, -half, half)
	lava(92, 96, -half, half)

	-- 2) SPRÜNGE über Lücken: alle Lücken 4 Studs (mit Tempo 16 gut zu schaffen), Plattformen
	-- werden schmaler und versetzt, überlappen sich aber immer um mindestens 4 Studs (gerade springen geht)
	sectionSign(110, "2/5 🦘 SPRÜNGE", "Anlauf nehmen!", Color3.fromRGB(120, 255, 120))
	deck(112, 124, 0, WIDTH, COLORS.DeckAlt)
	deck(128, 138, 0, math.max(8, WIDTH * 0.7), COLORS.Deck)
	local jumpWidth = math.max(6, WIDTH * 0.55)
	local jumpShift = math.max(0, (jumpWidth - 4) / 2) -- Versatz: beide Plattformen überlappen um 4 Studs
	deck(142, 151, jumpShift, jumpWidth, COLORS.DeckAlt)
	deck(155, 164, -jumpShift, jumpWidth, COLORS.Deck)
	deck(168, 284, 0, WIDTH, COLORS.DeckAlt)

	-- 3) ROTIERENDE BALKEN (der Client dreht sie)
	local t0 = now()
	sectionSign(198, "3/5 🌀 BALKEN", "Timing ist alles!", COLORS.Spinner)
	local barLength = WIDTH - 1
	local function post(d: number)
		part({
			Name = "SpinnerPost",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 1.4, 1.4),
			CFrame = CFrame.new(world(d, 0, TOP + 1.5)) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(60, 60, 72),
			Parent = decoFolder,
		})
	end
	-- a) Fegebalken knapp über dem Boden (drüberspringen)
	post(210)
	spinner(
		"SweeperA",
		CFrame.new(world(210, 0, TOP + 1.2)),
		CFrame.new(),
		Vector3.new(barLength, 1.2, 1.2),
		Vector3.yAxis,
		1.8,
		t0
	)
	-- b) Windmühle: ein Balken dreht sich quer über die Strecke (unten durchlaufen, wenn er oben ist)
	local millPivot = CFrame.new(world(234, 0, TOP + 7.5))
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "MillPost",
			Size = Vector3.new(1.2, 10, 1.2),
			Position = world(235.6, s * (half + 0.8), TOP + 5),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(60, 60, 72),
			Parent = decoFolder,
		})
	end
	part({
		Name = "MillBeam",
		Size = Vector3.new(WIDTH + 2.8, 1, 1),
		Position = world(235.6, 0, TOP + 10.5),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(60, 60, 72),
		Parent = decoFolder,
	})
	part({
		Name = "MillAxle",
		Size = Vector3.new(0.8, 0.8, 1.6),
		Position = world(234.8, 0, TOP + 7.5),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 220, 60),
		CanCollide = false,
		CastShadow = false,
		Parent = decoFolder,
	})
	part({
		Name = "MillHanger",
		Size = Vector3.new(0.6, 3, 0.6),
		Position = world(235.6, 0, TOP + 9),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(60, 60, 72),
		CanCollide = false,
		Parent = decoFolder,
	})
	spinner("Windmill", millPivot, CFrame.new(), Vector3.new(barLength, 1.2, 1.2), Vector3.zAxis, 1.4, t0)
	-- c) Kreuz aus zwei Fegebalken, andersherum
	post(258)
	local crossPivot = CFrame.new(world(258, 0, TOP + 1.2))
	spinner("SweeperC1", crossPivot, CFrame.new(), Vector3.new(barLength, 1.2, 1.2), Vector3.yAxis, -1.5, t0)
	spinner(
		"SweeperC2",
		crossPivot,
		CFrame.Angles(0, math.rad(90), 0),
		Vector3.new(barLength, 1.2, 1.2),
		Vector3.yAxis,
		-1.5,
		t0
	)

	-- 4) METEOR-EINSCHLÄGE (Server bestimmt sie, Client zeigt Warnkreis + Einschlag)
	deck(284, 372, 0, WIDTH, COLORS.Deck)
	sectionSign(286, "4/5 ☄️ EINSCHLÄGE", "Raus aus den roten Kreisen!", Color3.fromRGB(255, 120, 120))
	local craterRng = Random.new(4242)
	for _ = 1, 7 do
		local d = craterRng:NextNumber(IMPACT_FROM_D + 4, IMPACT_TO_D - 4)
		local x = craterRng:NextNumber(-half + 2.5, half - 2.5)
		local size = craterRng:NextNumber(3, 4.5)
		part({
			Name = "Crater",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, size, size),
			CFrame = CFrame.new(world(d, x, TOP + 0.03)) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Slate,
			Color = COLORS.Crater,
			CanCollide = false,
			CanQuery = false,
			CastShadow = false,
			Parent = decoFolder,
		})
	end

	-- 5) LAVA-STEINE: alles Lava, nur auf den Steinen ist man sicher
	deck(372, END_D, 0, WIDTH, COLORS.DeckAlt)
	sectionSign(374, "5/5 🔥 LAVA-STEINE", "Von Stein zu Stein!", COLORS.Lava)
	lava(376, 428, -half, half)
	local stoneFolder = folder("Stones", root)
	for i, x in ipairs({ -0.4, 0.45, -0.3, 0.5, -0.5, 0.1, -0.35, 0.3 }) do
		part({
			Name = "Stone",
			Size = Vector3.new(4, 1.4, 4),
			Position = world(374 + i * 6.5, half * x, TOP + 0.7),
			Material = Enum.Material.Slate,
			Color = COLORS.Stone,
			Parent = stoneFolder,
		})
	end
	stoneParams.FilterDescendantsInstances = { stoneFolder }

	-- CHECKPOINTS
	respawnCF[1] = CFrame.lookAt(world(START_RESPAWN_D, 0, TOP + 3.5), world(START_RESPAWN_D + 10, 0, TOP + 3.5))
	for index, d in ipairs(CHECKPOINT_D) do
		checkpointPad(index, d)
	end

	-- ZIEL: Tor, Linie, Podest mit Belohnungs-Ei, Rampe runter (Richtung Basen)
	gate(FINISH_D, COLORS.Finish, 12)
	line(FINISH_D, true)
	local finishSign = anchorPart("FinishSign", world(FINISH_D, 0, TOP + 18), decoFolder)
	worldSign(finishSign, 20, 5, {
		{ Name = "Title", Text = "🏁 ZIEL 🏁", Color = COLORS.Finish, Height = 0.62 },
		{ Name = "Hint", Text = "Gratis-Ei – dann schnell heimtragen!", Color = WHITE, Height = 0.38 },
	})
	local podiumD = 444
	part({
		Name = "Podium",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 7, 7),
		CFrame = CFrame.new(world(podiumD, 0, TOP + 1)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(255, 205, 60),
		Parent = decoFolder,
	})
	part({
		Name = "PodiumRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 7.6, 7.6),
		CFrame = CFrame.new(world(podiumD, 0, TOP + 2)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 120, 200),
		CanCollide = false,
		CastShadow = false,
		Parent = decoFolder,
	})
	local egg = part({
		Name = "RewardEgg",
		Size = Vector3.new(3, 3, 3),
		Position = world(podiumD, 0, TOP + 4.6),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(180, 80, 255),
		CanCollide = false,
		CanQuery = false,
		Parent = decoFolder,
	})
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.35, 1)
	mesh.Parent = egg
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(220, 140, 255)
	light.Range = 16
	light.Brightness = 2
	light.Shadows = false
	light.Parent = egg
	egg:SetAttribute("Bob", true) -- Client lässt es schweben und drehen
	local eggSign = anchorPart("EggSign", world(podiumD, 0, TOP + 8.5), decoFolder)
	worldSign(eggSign, 9, 2.2, {
		{ Name = "Title", Text = "🥚 Belohnungs-Ei", Color = Color3.fromRGB(230, 180, 255), Height = 1 },
	})
	-- Rampe vom Podest runter auf die Wiese (zur Seite der Basen)
	local exitTop = world(podiumD, -half, TOP)
	local exitBottom = world(podiumD, -half - RAMP_LENGTH, 0)
	part({
		Name = "ExitRamp",
		Size = Vector3.new(8, 1, (exitTop - exitBottom).Magnitude),
		CFrame = CFrame.lookAt((exitTop + exitBottom) / 2, exitTop) * CFrame.new(0, -0.5, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = COLORS.DeckAlt,
		Parent = decoFolder,
	})

	-- Werte für die Prüfung
	startSpawnCF = CFrame.lookAt(world(2.5, 0, TOP + 3.5), world(12, 0, TOP + 3.5))
	readyMinZ = Z0 + READY_FROM_D
	readyMaxZ = Z0 + START_LINE_D
	finishZ = Z0 + FINISH_D
	exitMinZ = Z0 + podiumD - 6
	exitMaxZ = Z0 + podiumD + 6
	lineMinX = X0 - half - 3
	lineMaxX = X0 + half + 3
	areaMinX = X0 - AREA_SIDE
	areaMaxX = X0 + AREA_SIDE
	areaMinZ = Z0 - RAMP_LENGTH - AREA_END
	areaMaxZ = Z0 + END_D + AREA_END
	exitMinX = X0 - half - RAMP_LENGTH - 6
	local length = FINISH_D - START_LINE_D
	local fastest = (tonumber(Config.MaxWalkSpeed) or 80) * SPEED_TOLERANCE
	minRunTime = length / fastest

	root:SetAttribute("CheckpointCount", #CHECKPOINT_D)
	root:SetAttribute("Length", length)
	root:SetAttribute("MinTime", minRunTime)
	root:SetAttribute("StartCFrame", startSpawnCF)
	root.Parent = map
	return root
end

-- -------------------------------------------------------------------
-- LAUF-LOGIK
-- -------------------------------------------------------------------
local function publish(player: Player, run: RunState?)
	if run then
		player:SetAttribute("RunActive", true)
		player:SetAttribute("RunStart", if run.Phase == "Running" then run.Start else 0)
		player:SetAttribute("RunCP", run.CP)
	else
		player:SetAttribute("RunActive", false)
		player:SetAttribute("RunStart", 0)
		player:SetAttribute("RunCP", 0)
	end
end

local function teleport(player: Player, cf: CFrame)
	local character = player.Character
	if not character then
		return
	end
	character:PivotTo(cf)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.AssemblyLinearVelocity = Vector3.zero
	end
	Services.CarryService.NoteTeleport(player, cf.Position)
	lastPos[player] = cf.Position
	lavaAir[player] = nil
	graceUntil[player] = os.clock() + TELEPORT_GRACE
end

local function inGrace(player: Player): boolean
	return os.clock() < (graceUntil[player] or 0)
end

local function cancelRun(player: Player, text: string?)
	if not runs[player] then
		return
	end
	runs[player] = nil
	lavaAir[player] = nil
	publish(player, nil)
	if text then
		Services.EconomyService.Notify(player, text, "Info")
	end
end

local function resetToCheckpoint(player: Player, run: RunState, reason: string)
	local cf = respawnCF[run.CP + 1] or respawnCF[1]
	teleport(player, cf)
	Services.EconomyService.Effect(player, "RunReset", 0, { Reason = reason })
	notifyLimited(player, RESET_TEXT[reason] or "↩️ Zurück zum Checkpoint!", "Error")
end

-- Steht/läuft der Spieler zwischen a und b auf einem Lava-Feld? (beide Messungen am Boden)
local function touchedLava(a: Vector3, b: Vector3, stand: number): boolean
	for _, box in ipairs(lavaBoxes) do
		local ha, hb = a.Y - box.Top, b.Y - box.Top
		if ha > 0.5 and hb > 0.5 and ha <= stand + 0.6 and hb <= stand + 0.6 and segmentHitsBox(a, b, box) then
			return true
		end
	end
	return false
end

-- Über einem Lava-Feld (waagrecht)?
local function overLava(p: Vector3): boolean
	for _, box in ipairs(lavaBoxes) do
		if p.X >= box.MinX and p.X <= box.MaxX and p.Z >= box.MinZ and p.Z <= box.MaxZ then
			return true
		end
	end
	return false
end

-- Steht der Spieler auf einem Lava-Stein? (kurzer Strahl nach unten, trifft nur die Steine)
local function onStone(p: Vector3, stand: number): boolean
	return workspace:Raycast(p, Vector3.new(0, -(stand + 1.5), 0), stoneParams) ~= nil
end

-- Schwebt der Spieler über Lava? (zu lange "in der Luft" über einem Lava-Feld = Schwebe-/Flug-Cheat;
-- wer tief über der Lava steht, fängt touchedLava, wer auf einem Stein steht, ist sicher)
local function hoveringOverLava(player: Player, p: Vector3, stand: number, dt: number): boolean
	if not overLava(p) or onStone(p, stand) then
		lavaAir[player] = nil
		return false
	end
	local air = (lavaAir[player] or 0) + dt
	lavaAir[player] = air
	return air > LAVA_AIR_MAX
end

-- War der Schritt a -> b in dt Sekunden zu Fuß möglich? (sonst zählen Linien nicht)
local function plausibleStep(humanoid: Humanoid, a: Vector3, b: Vector3, dt: number): boolean
	local dx, dz = b.X - a.X, b.Z - a.Z
	local maxStep = (humanoid.WalkSpeed * STEP_FACTOR + STEP_EXTRA) * dt + STEP_SLACK
	return dx * dx + dz * dz <= maxStep * maxStep
end

local function updateRecordSign()
	local label = recordLabel
	local record = serverRecord
	if label and record then
		label.Text = "🏆 Rekord: " .. record.Name .. " – " .. formatRunTime(record.Time)
	end
end

local function rollEggRarity(luck: number, rebirths: number): string
	local pick = Util.WeightedPick(EGG_TABLE, function(item): number
		local list = Config.MeteorsByRarity[item.Rarity]
		if not Config.RaritiesByName[item.Rarity] or not list or #list == 0 then
			return 0
		end
		if rebirths < (item.MinRebirths or 0) then
			return 0
		end
		return if item.Lucky then item.Weight * luck else item.Weight
	end, rng)
	return pick.Rarity
end

-- Belohnung: Cash + Gratis-Ei zum Heimtragen (Base voll -> Verkaufswert als Cash)
local function giveReward(player: Player, data, elapsed: number, newBest: boolean): string
	local Economy = Services.EconomyService
	local cash = math.floor(
		math.max(RUN_MIN_CASH, Economy.GetIncome(player) * RUN_CASH_SECONDS)
			* (if newBest then NEW_BEST_CASH_MULT else 1)
	)
	Economy.AddCash(player, cash)
	Economy.Effect(player, "Collect", cash)
	local text = " +" .. Util.FormatCash(cash)

	local rebirths = tonumber(data.Rebirths) or 0
	local luck = 1
		+ math.clamp((PAR_TIME - elapsed) / PAR_TIME, 0, 0.6)
		+ math.min(rebirths, 10) * REBIRTH_LUCK
		+ (if newBest then 0.25 else 0)
	local Meteor = Services.MeteorService
	local def = Meteor.RandomOfRarity(rollEggRarity(luck, rebirths))
	if not def then
		return text
	end
	local entry = { Id = def.Id, Mut = Meteor.RollMutation(1), Lv = 1, Xp = 0 }
	local label = (if entry.Mut ~= "Normal" then entry.Mut .. " " else "") .. def.Name .. " (" .. def.Rarity .. ")"
	local root = aliveRoot(player)
	local canCarry = root ~= nil
		and Services.PlotService.GetPlot(player) ~= nil
		and Services.PlotService.FreeSlot(player) ~= nil
		and not Services.CarryService.IsCarrying(player)
	if root and canCarry then
		Services.CarryService.StartCarry(player, entry, {
			Source = "Ground",
			From = "Run",
			GrabPosition = root.Position,
			ScaleTimeout = true, -- langer Heimweg: Trage-Zeit wächst mit der Entfernung zur eigenen Base
		})
		if (Config.RarityIndex[def.Rarity] or 0) >= ANNOUNCE_RARITY then
			Economy.NotifyAll(
				"☄️ "
					.. player.DisplayName
					.. " hat den Meteor-Run geschafft und trägt ein "
					.. def.Rarity
					.. "-Ei heim – HAU IHN! 🔨",
				"Event"
			)
		end
		local seconds = tonumber(player:GetAttribute("CarryTimeout")) or Config.CarryTimeout
		return text .. " 🥚 " .. label .. " – TRAG ES HEIM (" .. seconds .. " s)! 🏃"
	end
	local value = math.floor(Config.MeteorValue(entry) * Config.SellRatio)
	Economy.AddCash(player, value)
	return text .. " 📦 Base voll – " .. Util.FormatCash(value) .. " statt " .. label
end

local function finishRun(player: Player, run: RunState)
	local elapsed = now() - run.Start
	runs[player] = nil
	publish(player, nil)
	local admin = Services.AdminService
	if elapsed < minRunTime and not (admin and admin.IsAdmin(player)) then
		Services.EconomyService.Notify(player, "🚫 Unmöglich schnell – dieser Run zählt nicht!", "Error")
		return
	end
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	local oldBest = tonumber(data.RunBest)
	if oldBest and (oldBest ~= oldBest or oldBest <= 0) then
		oldBest = nil
	end
	local newBest = oldBest == nil or elapsed < oldBest
	local best = elapsed
	if newBest then
		data.RunBest = math.floor(elapsed * 100 + 0.5) / 100
		player:SetAttribute("RunBest", data.RunBest)
	elseif oldBest then
		best = oldBest
	end
	if not serverRecord or elapsed < serverRecord.Time then
		serverRecord = { Name = player.DisplayName, Time = elapsed }
		updateRecordSign()
	end

	local t = now()
	local cooldownEnd = cooldownUntil[player.UserId] or 0
	local rewarded = t >= cooldownEnd
	Services.EconomyService.Effect(
		player,
		"RunFinish",
		elapsed,
		{ Time = elapsed, Best = best, NewBest = newBest, Reward = rewarded }
	)
	local timeText = "🏁 ZIEL in "
		.. formatRunTime(elapsed)
		.. "!"
		.. (if newBest then " 🏆 NEUE BESTZEIT!" else "")
	if not rewarded then
		Services.EconomyService.Notify(
			player,
			timeText .. " ⏳ Nächste Belohnung in " .. Util.FormatTime(math.ceil(cooldownEnd - t)),
			"Info"
		)
		Services.EconomyService.MarkDirty(player)
		return
	end
	cooldownUntil[player.UserId] = t + REWARD_COOLDOWN
	data.RunRewardAt = os.time() + REWARD_COOLDOWN
	player:SetAttribute("RunCooldownUntil", t + REWARD_COOLDOWN)
	local rewardText = giveReward(player, data, elapsed, newBest)
	Services.EconomyService.Notify(player, timeText .. rewardText, "Success")
	Services.EconomyService.MarkDirty(player)
end

-- Ein Prüf-Schritt für einen Spieler (alle TICK Sekunden, dt = echte Zeit seit dem letzten Schritt)
local function stepPlayer(player: Player, dt: number)
	local root, humanoid = aliveRoot(player)
	local run = runs[player]
	if not root or not humanoid then
		if run then
			cancelRun(player)
		end
		return
	end
	local pos = root.Position
	local last = lastPos[player] or pos
	lastPos[player] = pos
	if not run then
		-- Nicht im Run: Start-Tor betreten? Lava berührt? (z.B. von der Seite reingesprungen)
		if not inArea(pos) then
			return
		end
		-- Wer schnell ist, rennt in einem Takt durchs Tor UND über die Linie -> sofort "Running"
		local dashed = crossedLine(last, pos, readyMaxZ) and last.Z >= Z0 - RAMP_LENGTH
		if inReadyZone(pos) or dashed then
			if Services.CarryService.IsCarrying(player) then
				notifyLimited(player, "🎒 Mit Beute kein Run – erst nach Hause bringen!", "Error")
			elseif Services.EconomyService.IsReady(player) then
				local newRun: RunState = {
					Phase = if dashed then "Running" else "Ready",
					Start = if dashed then now() else 0,
					CP = 0,
				}
				runs[player] = newRun
				publish(player, newRun)
				Services.EconomyService.Effect(player, if dashed then "RunStart" else "RunReady", 0)
			end
		elseif
			not Services.CarryService.IsCarrying(player) -- mit Beute wird nie teleportiert
			and not inGrace(player)
			and touchedLava(last, pos, standHeight(humanoid, root))
		then
			teleport(player, startSpawnCF)
			notifyLimited(player, "🔥 Lava! Starte den Run am Tor ☄️", "Error")
		end
		return
	end

	if Services.CarryService.IsCarrying(player) then
		cancelRun(player, "🎒 Mit Beute kein Run – abgebrochen.")
		return
	end
	if not inArea(pos) then
		cancelRun(player, "☄️ Meteor-Run abgebrochen.")
		return
	end
	local move = Services.CarryService.MoveStatus(player)
	if move == "flagged" then
		cancelRun(player, "🚫 Unmöglich schnell – Run abgebrochen!")
		return
	end

	if run.Phase == "Ready" then
		if crossedLine(last, pos, readyMaxZ) then
			run.Phase = "Running"
			run.Start = now()
			publish(player, run)
			Services.EconomyService.Effect(player, "RunStart", 0)
		elseif not inReadyZone(pos) then
			cancelRun(player) -- zurück aus dem Tor gelaufen
		end
		return
	end

	-- Running
	if now() - run.Start > MAX_RUN_TIME then
		cancelRun(player, "⏰ Zu lange – Meteor-Run abgebrochen.")
		return
	end
	if inReadyZone(pos) then
		-- zurück ins Start-Tor = Neustart
		run.Phase = "Ready"
		run.Start = 0
		run.CP = 0
		publish(player, run)
		return
	end
	if inGrace(player) then
		return -- gerade zurückgesetzt: alte Positionen vor dem Teleport nicht werten
	end
	if pos.Y > TOP + MAX_HEIGHT then
		resetToCheckpoint(player, run, "fall") -- so hoch kommt man nicht (Flug-Cheat)
		return
	end
	if pos.Y < TOP - FALL_DEPTH then
		if pos.X < lineMinX and pos.Z >= exitMinZ and pos.Z <= exitMaxZ then
			cancelRun(player, "☄️ Meteor-Run abgebrochen.") -- über die Ziel-Rampe runter (ohne alle Checkpoints)
		else
			resetToCheckpoint(player, run, "fall")
		end
		return
	end
	local stand = standHeight(humanoid, root)
	if touchedLava(last, pos, stand) or hoveringOverLava(player, pos, stand, dt) then
		resetToCheckpoint(player, run, "lava")
		return
	end
	local admin = Services.AdminService
	local isAdmin = admin ~= nil and admin.IsAdmin(player) -- Admins dürfen zum Testen fliegen
	if move ~= "ok" or not (isAdmin or plausibleStep(humanoid, last, pos, dt)) then
		-- Schonzeit nach einem Teleport ("wait": Positionen werden noch nicht geprüft) oder ein
		-- unmöglich weiter Schritt -> keine Linie zählt
		return
	end
	local nextIndex = run.CP + 1
	local nextZ = checkpointZ[nextIndex]
	if nextZ and crossedLine(last, pos, nextZ) then
		run.CP = nextIndex
		publish(player, run)
		Services.EconomyService.Effect(player, "RunCheckpoint", nextIndex, {
			Position = Vector3.new(X0, TOP + 0.5, nextZ),
			Time = now() - run.Start,
		})
		return
	end
	if crossedLine(last, pos, finishZ) then
		if run.CP >= #checkpointZ then
			finishRun(player, run)
		else
			notifyLimited(player, "🚩 Du hast einen Checkpoint verpasst!", "Error")
		end
	end
end

-- -------------------------------------------------------------------
-- METEOR-EINSCHLÄGE
-- -------------------------------------------------------------------
local pendingImpacts = 0
local impactClock = 0
local runnerRoots: { BasePart } = {}

local function scheduleImpact(position: Vector3)
	pendingImpacts += 1
	Remotes.Effect:FireAllClients("RunImpact", 0, {
		Position = position,
		Radius = IMPACT_RADIUS,
		At = now() + IMPACT_WARN,
	})
	task.delay(IMPACT_WARN, function()
		pendingImpacts -= 1
		local hitRadius = IMPACT_RADIUS + 1
		for player, run in pairs(runs) do
			if run.Phase == "Running" and not inGrace(player) then
				local root = aliveRoot(player)
				if root then
					local p = root.Position
					local dx, dz = p.X - position.X, p.Z - position.Z
					if
						dx * dx + dz * dz <= hitRadius * hitRadius
						and p.Y > position.Y - 1
						and p.Y < position.Y + IMPACT_HEIGHT
					then
						resetToCheckpoint(player, run, "impact")
					end
				end
			end
		end
	end)
end

local function stepImpacts(dt: number)
	table.clear(runnerRoots)
	local zoneMin = Z0 + IMPACT_FROM_D - 10
	local zoneMax = Z0 + IMPACT_TO_D + 6
	for player, run in pairs(runs) do
		if run.Phase == "Running" and run.CP == IMPACT_AFTER_CP then
			local root = aliveRoot(player)
			if root and root.Position.Z >= zoneMin and root.Position.Z <= zoneMax then
				table.insert(runnerRoots, root)
			end
		end
	end
	if #runnerRoots == 0 then
		impactClock = 0
		return
	end
	impactClock += dt
	if impactClock < IMPACT_INTERVAL or pendingImpacts >= IMPACT_MAX then
		return
	end
	impactClock = 0
	local half = WIDTH / 2 - 1
	local x = X0 + rng:NextNumber(-half, half)
	local z = Z0 + rng:NextNumber(IMPACT_FROM_D, IMPACT_TO_D)
	if rng:NextNumber() < IMPACT_AIM_CHANCE then
		local root = runnerRoots[rng:NextInteger(1, #runnerRoots)]
		local velocity = root.AssemblyLinearVelocity
		local aim = root.Position + Vector3.new(velocity.X, 0, velocity.Z) * IMPACT_LEAD
		x = math.clamp(aim.X, X0 - half, X0 + half)
		z = math.clamp(aim.Z, Z0 + IMPACT_FROM_D, Z0 + IMPACT_TO_D)
	end
	scheduleImpact(Vector3.new(x, TOP, z))
end

-- -------------------------------------------------------------------
-- ÖFFENTLICH
-- -------------------------------------------------------------------
-- Request "GoRun": zum Start-Tor teleportieren (nicht beim Tragen)
function RunService.Teleport(player: Player): (boolean, string)
	if not runFolder then
		return false, "☄️ Der Meteor-Run ist gerade nicht da."
	end
	if Services.CarryService.IsCarrying(player) then
		return false, "Mit Beute musst du laufen! 🏃"
	end
	local root = aliveRoot(player)
	if not root then
		return false, "Kein Charakter"
	end
	if root.Anchored then
		return false, "🧊 Du bist eingefroren!"
	end
	cancelRun(player)
	teleport(player, startSpawnCF)
	return true, "☄️ Lauf durchs Tor – über der Linie startet der Timer!"
end

-- Läuft der Spieler gerade den Meteor-Run? (z.B. für andere Services)
function RunService.IsRunning(player: Player): boolean
	return runs[player] ~= nil
end

function RunService.Init(services)
	Services = services
	local map = Services.PlotService.MapFolder
	if not map then
		warn("[RunService] Keine Map – Meteor-Run wird nicht gebaut")
		return
	end
	local old = map:FindFirstChild("MeteorRun")
	if old then
		old:Destroy()
	end
	computeLayout(map)
	-- Platz schaffen: Strecke + Rampen (Bäume/Büsche weg, andere Teile melden)
	local half = WIDTH / 2
	local zMin = Z0 - RAMP_LENGTH - 2
	local zMax = Z0 + END_D + 2
	clearArea(map, Vector3.new(X0, 16, (zMin + zMax) / 2), Vector3.new(WIDTH + 8, 30, zMax - zMin))
	clearArea(map, Vector3.new(X0 - half - RAMP_LENGTH / 2 - 2, 10, Z0 + 444), Vector3.new(RAMP_LENGTH + 4, 18, 12))
	runFolder = build(map)
end

function RunService.Start()
	if not runFolder then
		return
	end
	Services.DataService.OnProfileLoaded(function(player: Player, data)
		local best = tonumber(data.RunBest)
		if best and best == best and best > 0 and best < math.huge then
			player:SetAttribute("RunBest", best)
		else
			data.RunBest = nil
		end
		-- Abklingzeit aus dem Spielstand (von einem anderen Server) übernehmen
		local rewardAt = tonumber(data.RunRewardAt)
		if rewardAt and rewardAt == rewardAt then
			local left = math.min(rewardAt - os.time(), REWARD_COOLDOWN)
			if left > 0 then
				cooldownUntil[player.UserId] = math.max(cooldownUntil[player.UserId] or 0, now() + left)
			else
				data.RunRewardAt = nil
			end
		else
			data.RunRewardAt = nil
		end
		local cooldown = cooldownUntil[player.UserId]
		if cooldown then
			player:SetAttribute("RunCooldownUntil", cooldown)
		end
	end)

	local function onPlayer(player: Player)
		publish(player, nil)
		player.CharacterAdded:Connect(function()
			cancelRun(player) -- neuer Charakter (gestorben, Reset) -> Run ist vorbei
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		runs[player] = nil
		notifyAt[player] = nil
		lastPos[player] = nil
		lavaAir[player] = nil
		graceUntil[player] = nil
	end)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(TICK)
			local clock = os.clock()
			local dt = math.clamp(clock - last, 0, 1)
			last = clock
			for _, player in ipairs(Players:GetPlayers()) do
				local ok, err = pcall(stepPlayer, player, dt)
				if not ok then
					warn("[RunService] Fehler bei " .. player.Name .. ": " .. tostring(err))
				end
			end
			local ok, err = pcall(stepImpacts, dt)
			if not ok then
				warn("[RunService] Einschlag-Fehler: " .. tostring(err))
			end
		end
	end)
end

return RunService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[-- 🤝 HANDEL zwischen Spielern (wie in Steal-Spielen)
--  * Anfrage (Spieler-Liste oder Prompt "Handeln" am Charakter) -> Ziel nimmt an/lehnt ab (20 s)
--  * Beide sehen beide Seiten: Aliens/Eier aus der eigenen Base (max. 6) + Cash
--  * Jede Änderung setzt "Bereit" bei beiden zurück. Beide bereit -> 3 s Countdown -> Tausch
--  * Der Tausch passiert in EINEM Schritt ohne Warten (kein yield): erst alles prüfen, dann
--    verschieben. Angebote werden per Referenz verglichen -> verkauft/geklaut/Rebirth/Reset = Abbruch.
--  * Ein Spieler ist immer nur in EINEM Handel. Verlassen beendet den Handel sofort.
-- Client -> Server: Remotes.Trade (RemoteFunction) mit (Aktion, Wert), Antwort { Ok, Message }
-- Server -> Client: Remotes.TradeEvent (RemoteEvent) mit (Art, Daten):
--   "Request" { From, Name, Timeout }, "RequestGone" { From }, "Update" (Ansicht), "Closed" { Text, Done }

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))

local TradeService = {}
local Services

local MIN_PLAYTIME = 120 -- Sekunden nach dem Beitritt ohne Handel (gegen Alt-Account-Spam)
local REQUEST_TIMEOUT = 20 -- so lange gilt eine Anfrage
local MAX_ITEMS = 6 -- pro Seite
local COUNTDOWN = 3 -- beide bereit -> so viele Sekunden bis zum Tausch
local CHECK_INTERVAL = 1 -- so oft werden laufende Angebote geprüft (verkauft, geklaut, geschlüpft ...)

local actionLimiter = Util.RateLimiter(12, 1) -- alle Aktionen
local requestLimiter = Util.RateLimiter(3, 15) -- Anfragen senden

type Item = { Key: string, Ref: any, Sig: string }
type Offer = { Items: { Item }, Cash: number, Ready: boolean }
type Trade = {
	Id: number,
	A: Player,
	B: Player,
	Offers: { [Player]: Offer },
	Token: number,
	EndsAt: number?,
	Active: boolean,
	InvKey: { [Player]: string },
}
type Request = { Id: number, To: Player, Expires: number }

local joinedAt: { [Player]: number } = {}
local blocked: { [Player]: boolean } = {}
local outgoing: { [Player]: Request } = {} -- eine offene Anfrage pro Absender
local tradeOf: { [Player]: Trade } = {}
local trades: { [Trade]: boolean } = {}
local leaving = setmetatable({} :: { [Player]: boolean }, { __mode = "k" })
local nextId = 0

-- -------------------------------------------------------------------
-- HILFEN
-- -------------------------------------------------------------------
local function notify(player: Player, text: string, kind: string?)
	local economy = Services.EconomyService
	if economy and economy.Notify then
		economy.Notify(player, text, kind)
	end
end

local function fire(player: Player, kind: string, data: any)
	if player.Parent then
		Remotes.TradeEvent:FireClient(player, kind, data)
	end
end

local function dataOf(player: Player): any
	return Services.DataService.Get(player)
end

-- Spieler noch da und Spielstand voll benutzbar (nicht am Speichern beim Verlassen)?
local function isPresent(player: Player): boolean
	if not player.Parent or leaving[player] then
		return false
	end
	local profiles = Services.DataService.Profiles
	local profile = profiles and profiles[player]
	if not profile or not profile.Loaded or profile.Releasing then
		return false
	end
	local economy = Services.EconomyService
	if economy and economy.IsReady and not economy.IsReady(player) then
		return false
	end
	return dataOf(player) ~= nil
end

local function isCarrying(player: Player): boolean
	local carry = Services.CarryService
	return carry ~= nil and carry.IsCarrying ~= nil and carry.IsCarrying(player) == true
end

local function slotStolen(plot, key: string): boolean
	local carry = Services.CarryService
	local slot = tonumber(key)
	if not carry or not carry.IsSlotBeingStolen or not plot or not slot then
		return false
	end
	return carry.IsSlotBeingStolen(plot, slot) == true
end

local function ownPlot(player: Player): any
	local plot = Services.PlotService.GetPlot(player)
	if plot and plot.Owner == player then
		return plot
	end
	return nil
end

-- Benutzbare Slot-Nummern in Füll-Reihenfolge (Erdgeschoss mit/ohne Pass "+6 Plätze", dann die
-- gekauften Stockwerke). Die Nummern sind NICHT lückenlos (z.B. 1-12, dann 19-24)!
local function usableSlots(player: Player): { number }
	local plots = Services.PlotService
	if plots.UsableSlots then
		return plots.UsableSlots(player)
	end
	local list = {}
	for slot = 1, Config.BaseSlots do
		table.insert(list, slot)
	end
	return list
end

-- "Fingerabdruck" eines Eintrags: ändert sich beim Schlüpfen / anderer Mutation.
-- (Level/Xp/Schlüpfzeit laufen ständig weiter und zählen nicht.)
local function entrySig(entry: any): string
	return tostring(entry.Id) .. "|" .. tostring(entry.Alien or "") .. "|" .. tostring(entry.Mut)
end

local function playedSeconds(player: Player): number
	return os.clock() - (joinedAt[player] or os.clock())
end

local function waitText(player: Player): string?
	local left = MIN_PLAYTIME - playedSeconds(player)
	if left > 0 then
		return Util.FormatTime(math.ceil(left))
	end
	return nil
end

local function cleanCash(value: any): number?
	local n = tonumber(value)
	if not n or n ~= n or n < 0 or n == math.huge then
		return nil
	end
	return math.floor(n)
end

-- -------------------------------------------------------------------
-- ANSICHT FÜR DEN CLIENT
-- -------------------------------------------------------------------
local function itemInfo(key: string, entry: any): { [string]: any }
	local def = Config.MeteorsById[entry.Id]
	return {
		Key = key,
		Name = Config.EntryName(entry),
		Rarity = def and def.Rarity or "Common",
		Mut = entry.Mut or "Normal",
		Lv = tonumber(entry.Lv) or 1,
		Income = Config.MeteorIncome(entry),
		Egg = entry.Alien == nil,
	}
end

local function sortedKeys(meteors: any): { string }
	local keys = {}
	for key in pairs(meteors) do
		table.insert(keys, key)
	end
	table.sort(keys, function(a, b)
		return (tonumber(a) or 0) < (tonumber(b) or 0)
	end)
	return keys
end

local function offerView(offer: Offer): { [string]: any }
	local items = {}
	for _, item in ipairs(offer.Items) do
		table.insert(items, itemInfo(item.Key, item.Ref))
	end
	return { Items = items, Cash = offer.Cash, Ready = offer.Ready }
end

local function inventoryView(player: Player, offer: Offer): ({ any }, string)
	local data = dataOf(player)
	local list, parts = {}, {}
	if not data then
		return list, ""
	end
	local offered: { [string]: boolean } = {}
	for _, item in ipairs(offer.Items) do
		offered[item.Key] = true
	end
	for _, key in ipairs(sortedKeys(data.Meteors)) do
		local entry = data.Meteors[key]
		local info = itemInfo(key, entry)
		info.Offered = offered[key] == true
		table.insert(list, info)
		table.insert(parts, key .. "=" .. entrySig(entry) .. (if info.Offered then "*" else ""))
	end
	return list, table.concat(parts, ",")
end

local function otherOf(trade: Trade, player: Player): Player
	return if trade.A == player then trade.B else trade.A
end

local function viewFor(trade: Trade, player: Player): { [string]: any }
	local other = otherOf(trade, player)
	local inventory, key = inventoryView(player, trade.Offers[player])
	trade.InvKey[player] = key
	local data = dataOf(player)
	return {
		Id = trade.Id,
		Other = { UserId = other.UserId, Name = other.DisplayName },
		You = offerView(trade.Offers[player]),
		Them = offerView(trade.Offers[other]),
		Inventory = inventory,
		Cash = data and data.Cash or 0,
		EndsAt = trade.EndsAt,
		MaxItems = MAX_ITEMS,
	}
end

local function push(trade: Trade)
	if not trade.Active then
		return
	end
	fire(trade.A, "Update", viewFor(trade, trade.A))
	fire(trade.B, "Update", viewFor(trade, trade.B))
end

-- -------------------------------------------------------------------
-- HANDEL STEUERN
-- -------------------------------------------------------------------
local function resetReady(trade: Trade)
	trade.Offers[trade.A].Ready = false
	trade.Offers[trade.B].Ready = false
	trade.Token += 1 -- laufender Countdown verfällt
	trade.EndsAt = nil
end

local function closeTrade(trade: Trade, textA: string?, textB: string?, done: boolean?)
	if not trade.Active then
		return
	end
	trade.Active = false
	trade.Token += 1
	trades[trade] = nil
	if tradeOf[trade.A] == trade then
		tradeOf[trade.A] = nil
	end
	if tradeOf[trade.B] == trade then
		tradeOf[trade.B] = nil
	end
	fire(trade.A, "Closed", { Text = textA, Done = done == true })
	fire(trade.B, "Closed", { Text = textB, Done = done == true })
end

-- Anfrage zurückziehen (Ziel bekommt "RequestGone")
local function dropRequest(from: Player)
	local request = outgoing[from]
	if request then
		outgoing[from] = nil
		fire(request.To, "RequestGone", { From = from.UserId })
	end
end

-- Kann dieser Spieler gerade handeln? (nil = ja, sonst Grund)
local function cannotTrade(player: Player, you: boolean): string?
	if not isPresent(player) or not ownPlot(player) then
		return if you then "Lädt noch... ⏳" else "Geht gerade nicht."
	end
	local wait = waitText(player)
	if wait then
		return if you then "⏳ Handeln geht in " .. wait else "⏳ " .. player.DisplayName .. " ist noch zu neu."
	end
	if tradeOf[player] then
		return if you then "Du handelst schon!" else player.DisplayName .. " handelt gerade."
	end
	return nil
end

local function startTrade(a: Player, b: Player)
	nextId += 1
	local trade: Trade = {
		Id = nextId,
		A = a,
		B = b,
		Offers = {
			[a] = { Items = {}, Cash = 0, Ready = false },
			[b] = { Items = {}, Cash = 0, Ready = false },
		},
		Token = 0,
		EndsAt = nil,
		Active = true,
		InvKey = {},
	}
	trades[trade] = true
	tradeOf[a] = trade
	tradeOf[b] = trade
	dropRequest(a)
	dropRequest(b)
	push(trade)
end

-- Laufende Angebote prüfen: Verschwundenes raus, Geändertes neu, zu viel Cash kürzen.
-- Gibt true zurück, wenn sich etwas geändert hat (dann sind beide nicht mehr bereit).
local function revalidate(trade: Trade): boolean
	local changed = false
	for _, player in ipairs({ trade.A, trade.B }) do
		local data = dataOf(player)
		local offer = trade.Offers[player]
		for i = #offer.Items, 1, -1 do
			local item = offer.Items[i]
			local current = data and data.Meteors[item.Key]
			if current ~= item.Ref then
				table.remove(offer.Items, i)
				changed = true
			elseif entrySig(current) ~= item.Sig then
				item.Sig = entrySig(current)
				changed = true
			end
		end
		local cash = data and data.Cash or 0
		if offer.Cash > cash then
			offer.Cash = math.max(0, math.floor(cash))
			changed = true
		end
	end
	if changed then
		resetReady(trade)
	end
	return changed
end

-- -------------------------------------------------------------------
-- DER TAUSCH (atomar: kein yield zwischen Prüfen und Verschieben)
-- -------------------------------------------------------------------
-- Gibt (true) oder (false, Grund, schließen) zurück. schließen = Handel ganz beenden.
function TradeService.Execute(trade: Trade): (boolean, string?, boolean?)
	if not trade.Active then
		return false, "Handel ist vorbei.", true
	end
	local a, b = trade.A, trade.B
	local sides = { a, b }
	local datas: { [Player]: any } = {}
	local plots: { [Player]: any } = {}
	for _, player in ipairs(sides) do
		if not isPresent(player) then
			return false, player.DisplayName .. " ist weg.", true
		end
		local plot = ownPlot(player)
		if not plot then
			return false, player.DisplayName .. " hat keine Base.", true
		end
		if tradeOf[player] ~= trade then
			return false, "Handel ist vorbei.", true
		end
		datas[player] = dataOf(player)
		plots[player] = plot
	end
	if datas[a] == datas[b] then
		return false, "Fehler.", true
	end
	for _, player in ipairs(sides) do
		if isCarrying(player) then
			return false, player.DisplayName .. " trägt gerade Beute."
		end
		local data = datas[player]
		local offer = trade.Offers[player]
		if #offer.Items > MAX_ITEMS then
			return false, "Zu viele Sachen."
		end
		local seen: { [string]: boolean } = {}
		for _, item in ipairs(offer.Items) do
			local current = data.Meteors[item.Key]
			if seen[item.Key] or current == nil or current ~= item.Ref or entrySig(current) ~= item.Sig then
				return false, "Angebot von " .. player.DisplayName .. " hat sich geändert."
			end
			if not Config.MeteorsById[current.Id] then
				return false, "Ungültiges Angebot."
			end
			if slotStolen(plots[player], item.Key) then
				return false, Config.EntryName(current) .. " wird gerade geklaut!"
			end
			seen[item.Key] = true
		end
		local cash = cleanCash(offer.Cash)
		if cash == nil or cash ~= offer.Cash or (tonumber(data.Cash) or 0) < cash then
			return false, player.DisplayName .. " hat nicht genug Cash."
		end
	end
	-- Freie Slots beim Empfänger (eigene abgegebene Slots werden frei)
	local freeSlots: { [Player]: { number } } = {}
	for _, receiver in ipairs(sides) do
		local giver = otherOf(trade, receiver)
		local incoming = #trade.Offers[giver].Items
		local leavingKeys: { [string]: boolean } = {}
		for _, item in ipairs(trade.Offers[receiver].Items) do
			leavingKeys[item.Key] = true
		end
		local free = {}
		local meteors = datas[receiver].Meteors
		for _, slot in ipairs(usableSlots(receiver)) do
			if #free >= incoming then
				break
			end
			local key = tostring(slot)
			if meteors[key] == nil or leavingKeys[key] then
				table.insert(free, slot)
			end
		end
		if #free < incoming then
			return false, "📦 Base von " .. receiver.DisplayName .. " ist zu voll."
		end
		freeSlots[receiver] = free
	end

	-- ALLES OK -> verschieben (ab hier kann nichts mehr scheitern)
	local moved: { [Player]: { Item } } = {}
	local touched: { [Player]: { [number]: boolean } } = { [a] = {}, [b] = {} }
	for _, player in ipairs(sides) do
		moved[player] = trade.Offers[player].Items
		for _, item in ipairs(moved[player]) do
			datas[player].Meteors[item.Key] = nil
			touched[player][tonumber(item.Key) :: number] = true
		end
	end
	for _, receiver in ipairs(sides) do
		local giver = otherOf(trade, receiver)
		for i, item in ipairs(moved[giver]) do
			local slot = freeSlots[receiver][i]
			datas[receiver].Meteors[tostring(slot)] = item.Ref
			touched[receiver][slot] = true
		end
	end
	local cashA, cashB = trade.Offers[a].Cash, trade.Offers[b].Cash
	datas[a].Cash = datas[a].Cash - cashA + cashB
	datas[b].Cash = datas[b].Cash - cashB + cashA
	closeTrade(trade, "🤝 Handel fertig!", "🤝 Handel fertig!", true)

	-- Anzeigen, Index, Speichern (Fehler hier dürfen den Tausch nicht mehr rückgängig machen)
	local economy = Services.EconomyService
	for _, player in ipairs(sides) do
		for slot in pairs(touched[player]) do
			local ok, err = pcall(Services.PlotService.RenderSlot, plots[player], slot)
			if not ok then
				warn("[TradeService] RenderSlot fehlgeschlagen: " .. tostring(err))
			end
		end
		local giver = otherOf(trade, player)
		for _, item in ipairs(moved[giver]) do
			if item.Ref.Alien ~= nil and economy and economy.Discover then
				pcall(economy.Discover, player, item.Ref.Alien)
			end
		end
		if economy then
			if economy.MarkDirty then
				economy.MarkDirty(player)
			end
			if economy.Effect then
				economy.Effect(player, "Confetti", 1)
			end
		end
		task.spawn(function()
			local ok, err = pcall(Services.DataService.Save, player)
			if not ok then
				warn("[TradeService] Speichern fehlgeschlagen: " .. tostring(err))
			end
		end)
	end
	print(
		("[TradeService] Handel #%d: %s (%d) gibt %d Sachen + %s, %s (%d) gibt %d Sachen + %s"):format(
			trade.Id,
			a.Name,
			a.UserId,
			#moved[a],
			Util.FormatCash(cashA),
			b.Name,
			b.UserId,
			#moved[b],
			Util.FormatCash(cashB)
		)
	)
	return true
end

-- Countdown abgelaufen -> tauschen oder mit Grund abbrechen
local function finish(trade: Trade, token: number)
	if not trade.Active or trade.Token ~= token then
		return
	end
	local ok, reason, close = TradeService.Execute(trade)
	if ok then
		return
	end
	local text = "❌ " .. tostring(reason)
	if close then
		closeTrade(trade, text, text)
	else
		resetReady(trade)
		notify(trade.A, text, "Error")
		notify(trade.B, text, "Error")
		push(trade)
	end
end

-- -------------------------------------------------------------------
-- AKTIONEN VOM CLIENT
-- -------------------------------------------------------------------
local Actions: { [string]: (Player, any) -> (boolean, string?, any?) } = {}

function Actions.Status(player: Player)
	local trade = tradeOf[player]
	return true,
		nil,
		{
			Blocked = blocked[player] == true,
			Wait = math.max(0, math.ceil(MIN_PLAYTIME - playedSeconds(player))),
			Trade = trade and trade.Active and viewFor(trade, player) or nil,
		}
end

function Actions.Block(player: Player, on: any)
	blocked[player] = on == true
	if on == true then
		-- offene Anfragen an mich ablehnen
		for from, request in pairs(outgoing) do
			if request.To == player then
				dropRequest(from)
			end
		end
	end
	return true, if on == true then "🚫 Anfragen blockiert" else "✅ Anfragen erlaubt"
end

function Actions.Send(player: Player, userId: any)
	local target = type(userId) == "number" and Players:GetPlayerByUserId(userId) or nil
	if not target or target == player then
		return false, "Spieler nicht gefunden."
	end
	if not requestLimiter.Check(player) then
		return false, "Langsam! 🐢"
	end
	local reason = cannotTrade(player, true) or cannotTrade(target, false)
	if reason then
		return false, reason
	end
	if blocked[target] then
		return false, "🚫 " .. target.DisplayName .. " blockt Anfragen."
	end
	-- Hat das Ziel MIR schon eine Anfrage geschickt? -> sofort los
	local back = outgoing[target]
	if back and back.To == player and back.Expires > os.clock() then
		startTrade(target, player)
		return true, nil
	end
	local current = outgoing[player]
	if current and current.To == target and current.Expires > os.clock() then
		return false, "Anfrage läuft schon."
	end
	dropRequest(player)
	nextId += 1
	local request: Request = { Id = nextId, To = target, Expires = os.clock() + REQUEST_TIMEOUT }
	outgoing[player] = request
	fire(target, "Request", { From = player.UserId, Name = player.DisplayName, Timeout = REQUEST_TIMEOUT })
	task.delay(REQUEST_TIMEOUT, function()
		if outgoing[player] == request then
			dropRequest(player)
			notify(player, "⌛ " .. target.DisplayName .. " hat nicht geantwortet.", "Info")
		end
	end)
	return true, "📨 Anfrage an " .. target.DisplayName .. " gesendet!"
end

function Actions.Answer(player: Player, arg: any)
	if type(arg) ~= "table" or type(arg.From) ~= "number" then
		return false, "Fehler."
	end
	local from = Players:GetPlayerByUserId(arg.From)
	local request = from and outgoing[from]
	if not from or not request or request.To ~= player or request.Expires <= os.clock() then
		return false, "Anfrage ist abgelaufen."
	end
	if arg.Accept ~= true then
		dropRequest(from)
		notify(from, "❌ " .. player.DisplayName .. " will nicht handeln.", "Error")
		return true, nil
	end
	local reason = cannotTrade(player, true) or cannotTrade(from, false)
	if reason then
		dropRequest(from)
		return false, reason
	end
	startTrade(from, player)
	return true, nil
end

local function myTrade(player: Player): Trade?
	local trade = tradeOf[player]
	if trade and trade.Active then
		return trade
	end
	return nil
end

function Actions.Add(player: Player, key: any)
	local trade = myTrade(player)
	if not trade then
		return false, "Kein Handel."
	end
	key = tostring(key)
	local data = dataOf(player)
	local entry = data and data.Meteors[key]
	local offer = trade.Offers[player]
	if not entry or not Config.MeteorsById[entry.Id] then
		return false, "Gibt es nicht mehr."
	end
	for _, item in ipairs(offer.Items) do
		if item.Key == key then
			return false, "Schon drin."
		end
	end
	if #offer.Items >= MAX_ITEMS then
		return false, "Max. " .. MAX_ITEMS .. " Sachen."
	end
	if slotStolen(ownPlot(player), key) then
		return false, "Wird gerade geklaut!"
	end
	table.insert(offer.Items, { Key = key, Ref = entry, Sig = entrySig(entry) })
	resetReady(trade)
	push(trade)
	return true, nil
end

function Actions.Remove(player: Player, key: any)
	local trade = myTrade(player)
	if not trade then
		return false, "Kein Handel."
	end
	key = tostring(key)
	local offer = trade.Offers[player]
	for i, item in ipairs(offer.Items) do
		if item.Key == key then
			table.remove(offer.Items, i)
			resetReady(trade)
			push(trade)
			return true, nil
		end
	end
	return false, "Nicht im Angebot."
end

function Actions.Cash(player: Player, amount: any)
	local trade = myTrade(player)
	if not trade then
		return false, "Kein Handel."
	end
	local cash = cleanCash(amount)
	local data = dataOf(player)
	if not cash or not data then
		return false, "Ungültiger Betrag."
	end
	if cash > (tonumber(data.Cash) or 0) then
		return false, "Nicht genug Cash."
	end
	local offer = trade.Offers[player]
	if offer.Cash ~= cash then
		offer.Cash = cash
		resetReady(trade)
		push(trade)
	end
	return true, nil
end

function Actions.Ready(player: Player, on: any)
	local trade = myTrade(player)
	if not trade then
		return false, "Kein Handel."
	end
	if on ~= true then
		if trade.Offers[player].Ready then
			resetReady(trade)
			push(trade)
		end
		return true, nil
	end
	if revalidate(trade) then
		push(trade)
		return false, "Angebot hat sich geändert – nochmal prüfen!"
	end
	local offers = trade.Offers
	if
		#offers[trade.A].Items == 0
		and #offers[trade.B].Items == 0
		and offers[trade.A].Cash == 0
		and offers[trade.B].Cash == 0
	then
		return false, "Biete erst etwas an!"
	end
	offers[player].Ready = true
	if offers[trade.A].Ready and offers[trade.B].Ready and not trade.EndsAt then
		trade.Token += 1
		local token = trade.Token
		trade.EndsAt = workspace:GetServerTimeNow() + COUNTDOWN
		task.delay(COUNTDOWN, finish, trade, token)
	end
	push(trade)
	return true, nil
end

function Actions.Cancel(player: Player)
	local trade = myTrade(player)
	if not trade then
		return true, nil
	end
	closeTrade(
		trade,
		if trade.A == player then "Handel abgebrochen." else "❌ " .. player.DisplayName .. " hat abgebrochen.",
		if trade.B == player then "Handel abgebrochen." else "❌ " .. player.DisplayName .. " hat abgebrochen."
	)
	return true, nil
end

function TradeService.Handle(player: Player, action: any, arg: any): { [string]: any }
	if not actionLimiter.Check(player) then
		return { Ok = false, Message = "Langsam! 🐢" }
	end
	local fn = type(action) == "string" and Actions[action] or nil
	if not fn then
		return { Ok = false, Message = "Unbekannt" }
	end
	local ok, message, extra = fn(player, arg)
	local response: { [string]: any } = { Ok = ok, Message = message or "" }
	if type(extra) == "table" then
		for key, value in pairs(extra) do
			response[key] = value
		end
	end
	return response
end

-- -------------------------------------------------------------------
-- VERLASSEN / RESET
-- -------------------------------------------------------------------
-- Handel eines Spielers sofort beenden (Verlassen, Spielstand wird gespeichert)
function TradeService.CancelFor(player: Player, text: string?)
	local trade = tradeOf[player]
	if trade then
		local other = otherOf(trade, player)
		local otherText = text or ("❌ " .. player.DisplayName .. " ist weg.")
		if trade.A == other then
			closeTrade(trade, otherText, nil)
		else
			closeTrade(trade, nil, otherText)
		end
	end
	dropRequest(player)
	for from, request in pairs(outgoing) do
		if request.To == player then
			outgoing[from] = nil
		end
	end
end

local function onLeave(player: Player)
	leaving[player] = true
	TradeService.CancelFor(player)
	joinedAt[player] = nil
	blocked[player] = nil
	actionLimiter.Clear(player)
	requestLimiter.Clear(player)
end

function TradeService.Init(services)
	Services = services
end

function TradeService.Start()
	for _, player in ipairs(Players:GetPlayers()) do
		joinedAt[player] = joinedAt[player] or os.clock()
	end
	Players.PlayerAdded:Connect(function(player)
		joinedAt[player] = os.clock()
	end)
	Players.PlayerRemoving:Connect(onLeave)
	local data = Services.DataService
	if data and data.OnProfileReleasing then
		data.OnProfileReleasing(function(player)
			leaving[player] = true
			TradeService.CancelFor(player)
		end)
	end

	Remotes.Trade.OnServerInvoke = function(player: Player, action: any, arg: any)
		local ok, result = pcall(TradeService.Handle, player, action, arg)
		if ok then
			return result
		end
		warn("[TradeService] Fehler: " .. tostring(result))
		return { Ok = false, Message = "Fehler – nochmal versuchen" }
	end

	-- Laufende Handel prüfen (verkauft, geklaut, geschlüpft, Rebirth, Spieler weg ...)
	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)
			for trade in pairs(trades) do
				local ok, err = pcall(function()
					for _, player in ipairs({ trade.A, trade.B }) do
						if not isPresent(player) then
							TradeService.CancelFor(player)
							return
						end
					end
					if revalidate(trade) then
						notify(trade.A, "Angebot geändert – nochmal bereit drücken!", "Info")
						notify(trade.B, "Angebot geändert – nochmal bereit drücken!", "Info")
						push(trade)
						return
					end
					-- Base hat sich geändert (geschlüpft, neues Ei ...) -> Liste neu schicken
					for _, player in ipairs({ trade.A, trade.B }) do
						local _, key = inventoryView(player, trade.Offers[player])
						if key ~= trade.InvKey[player] then
							push(trade)
							break
						end
					end
				end)
				if not ok then
					warn("[TradeService] Prüf-Fehler: " .. tostring(err))
				end
			end
		end
	end)
end

-- Für Tests
TradeService._internal = { tradeOf = tradeOf, joinedAt = joinedAt, outgoing = outgoing, blocked = blocked }

return TradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">TreadmillService</string>
            <string name="Source"><![CDATA[-- SPEED FARM: Laufbänder (Treadmills) in der Laufband-Zone am Spawn-Platz.
-- Wer auf einem GEKAUFTEN Laufband läuft, bekommt alle Config.TreadmillTick Sekunden
-- Schritte 👟 (+ fliegende Zahl beim Client). Mehr Schritte = schneller laufen (Config.StepsSpeed).
-- Laufbänder kauft man mit Cash (Config.Treadmills -> Price, Request "BuyTreadmill"), der Reihe nach.
-- Besitz: data.Treadmills = { [Id] = true } – bleibt bei Rebirth. Gratis-Laufbänder (Holz) hat jeder.
--
-- Erkennung "läuft auf dem Band" (bewusst großzügig – lieber etwas AFK tolerieren als dass es nicht geht):
--   1. HumanoidRootPart über der Lauffläche (mit etwas Spielraum, egal ob R6/R15/skaliert)
--   2. Humanoid.MoveDirection zeigt Laufen an  ODER  die Physik zeigt es: der Spieler ist deutlich anders
--      schnell als das Band (wer stillsteht, fährt mit dem Band mit; wer läuft, nicht).
-- Steht man auf einem Band und bekommt KEINE Schritte, gibt es einen kurzen Hinweis mit dem Grund (gedrosselt).
-- Schritte gibt es nur hier im Server-Tick – kein Remote kann Schritte auslösen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))

local TreadmillService = {}
local Services

type Treadmill = {
	Def: any,
	Belt: BasePart,
	CFrame: CFrame,
	HalfX: number,
	HalfZ: number,
	TopY: number,
	Velocity: Vector3, -- so schnell soll das Band schieben (Welt)
}

-- aufsteigend nach Preis
local treadmills: { Treadmill } = {}
local zoneCenter = Vector3.zero
local zoneRadius = 0
local lastHint: { [Player]: number } = {}
local idleSince: { [Player]: number } = {}

local MAX_HEIGHT = 10 -- HumanoidRootPart höchstens so hoch über der Lauffläche (Springen, große Avatare)
local MIN_HEIGHT = -0.5
-- Spielraum um die Lauffläche (Füße ragen über die Hüfte hinaus; Seitenrahmen innen beginnt direkt am Band)
local MARGIN_X = 0.5
local MARGIN_Z = 1
local MIN_MOVE = 0.05 -- Humanoid.MoveDirection mindestens so lang = Spieler drückt eine Lauf-Taste
-- Physik-Prüfung: so viel anders schnell als das Band (Studs/s) = läuft. Wer stillsteht, fährt mit (≈ 0).
local MIN_RELATIVE_SPEED = 3
local HINT_COOLDOWN = 5 -- Hinweise ("Lauf los", "gehört dir nicht", "lädt") höchstens so oft
local IDLE_HINT_AFTER = 1.5 -- erst nach so langem Stillstehen auf dem Band "Lauf los!" zeigen
local RESCAN_INTERVAL = 5

local function treadmillsFolder(): Instance?
	local plotService = Services and Services.PlotService
	local folder = plotService and plotService.TreadmillsFolder
	if folder and folder.Parent then
		return folder
	end
	-- Ersatz: direkt in der Map suchen (z.B. wenn PlotService den Ordner nicht weitergereicht hat)
	local map = workspace:FindFirstChild("MeteorHeistMap")
	return map and map:FindFirstChild("Treadmills")
end

-- Soll-Geschwindigkeit des Bandes (Attribute von MapBuilder, sonst Config)
local function beltVelocity(belt: BasePart): Vector3
	local dir = belt:GetAttribute("BeltDir")
	local speed = tonumber(belt:GetAttribute("BeltSpeed")) or tonumber(Config.TreadmillPush) or 6
	local worldDir: Vector3 = if typeof(dir) == "Vector3" and dir.Magnitude > 0.001
		then dir.Unit
		else -belt.CFrame.LookVector
	return worldDir * speed
end

-- Laufbänder aus der Map einlesen (MapBuilder baut je Eintrag in Config.Treadmills ein Model)
local function collect()
	table.clear(treadmills)
	local folder = treadmillsFolder()
	if not folder then
		return
	end
	local sum = Vector3.zero
	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") then
			local id = model:GetAttribute("TreadmillId") or model.Name
			local def = type(id) == "string" and Config.TreadmillsById[id] or nil
			local belt = model.PrimaryPart or model:FindFirstChild("Belt")
			if def and belt and belt:IsA("BasePart") then
				table.insert(treadmills, {
					Def = def,
					Belt = belt,
					CFrame = belt.CFrame,
					HalfX = belt.Size.X / 2,
					HalfZ = belt.Size.Z / 2,
					TopY = belt.Size.Y / 2,
					Velocity = beltVelocity(belt),
				})
				sum += belt.Position
			end
		end
	end
	table.sort(treadmills, function(a, b)
		return a.Def.Price < b.Def.Price
	end)
	if #treadmills > 0 then
		-- grobe Vorab-Prüfung: Kreis um alle Laufbänder (spart Rechnen, wenn niemand dort ist)
		zoneCenter = sum / #treadmills
		zoneRadius = 0
		for _, treadmill in ipairs(treadmills) do
			local reach = (treadmill.CFrame.Position - zoneCenter).Magnitude
				+ math.sqrt((treadmill.HalfX + MARGIN_X) ^ 2 + (treadmill.HalfZ + MARGIN_Z) ^ 2)
			zoneRadius = math.max(zoneRadius, reach + MAX_HEIGHT)
		end
	end
end

-- Auf welchem Laufband steht diese Position (HumanoidRootPart)?
function TreadmillService.FindTreadmill(position: Vector3): Treadmill?
	if #treadmills == 0 or (position - zoneCenter).Magnitude > zoneRadius then
		return nil
	end
	for _, treadmill in ipairs(treadmills) do
		local localPos = treadmill.CFrame:PointToObjectSpace(position)
		local height = localPos.Y - treadmill.TopY
		if
			math.abs(localPos.X) <= treadmill.HalfX + MARGIN_X
			and math.abs(localPos.Z) <= treadmill.HalfZ + MARGIN_Z
			and height > MIN_HEIGHT
			and height < MAX_HEIGHT
		then
			return treadmill
		end
	end
	return nil
end

-- Steht der Spieler wirklich AUF der Lauffläche? Strahl von der Hüfte nach unten muss das Band treffen
-- (nicht Seitenrahmen, Rampe oder Konsole). Unabhängig von R6/R15, HipHeight und Avatar-Größe.
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
local function standsOnBelt(treadmill: Treadmill, root: BasePart, character: Model): boolean
	rayParams.FilterDescendantsInstances = { character }
	local result = workspace:Raycast(root.Position, Vector3.new(0, -(MAX_HEIGHT + 2), 0), rayParams)
	return result ~= nil and result.Instance == treadmill.Belt
end

-- Physik: ist der Spieler (waagerecht) deutlich anders schnell als das Band? Stillstehen = mitfahren = nein.
-- Funktioniert auch, wenn Humanoid.MoveDirection beim Server nicht ankommt.
local function walkingByPhysics(treadmill: Treadmill, root: BasePart, character: Model): boolean
	local relative = root.AssemblyLinearVelocity - treadmill.Velocity
	relative -= Vector3.yAxis * relative.Y
	return relative.Magnitude > MIN_RELATIVE_SPEED and standsOnBelt(treadmill, root, character)
end

local function hint(player: Player, text: string, kind: string?)
	local t = os.clock()
	if t - (lastHint[player] or -math.huge) >= HINT_COOLDOWN then
		lastHint[player] = t
		Services.EconomyService.Notify(player, text, kind or "Info")
	end
end

-- Ein Tick für einen Spieler. Gibt den Grund zurück (für Tests/Fehlersuche):
-- "steps", "none" (nicht auf einem Band), "dead", "loading", "idle", "locked"
function TreadmillService.TickPlayer(player: Player): string
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		idleSince[player] = nil
		return "none"
	end
	local treadmill = TreadmillService.FindTreadmill(root.Position)
	if not treadmill then
		idleSince[player] = nil
		return "none"
	end
	if humanoid.Health <= 0 then
		return "dead"
	end
	-- Nur der Spielstand muss da sein (nicht die ganze Einrichtung) – Schritte gehen so ab der ersten Sekunde
	local data = Services.DataService.Get(player)
	if not data then
		hint(player, "⏳ Dein Spielstand lädt noch – gleich gibt's Schritte!")
		return "loading"
	end
	local walking = humanoid.MoveDirection.Magnitude > MIN_MOVE or walkingByPhysics(treadmill, root, character :: Model)
	if not walking then
		local now = os.clock()
		local since = idleSince[player]
		if not since then
			idleSince[player] = now
		elseif now - since >= IDLE_HINT_AFTER then
			hint(player, "👟 Lauf los! Halte W gedrückt (nach vorne zur Konsole) – nur Laufen gibt Schritte.")
		end
		return "idle"
	end
	idleSince[player] = nil
	local def = treadmill.Def
	if not Config.OwnsTreadmill(data.Treadmills, def.Id) then
		hint(player, "🔒 Kaufe dieses Laufband im Laufbänder-Menü (" .. Util.FormatCash(def.Price) .. ")", "Error")
		return "locked"
	end
	local gain = def.Rate * Services.EconomyService.GetStepsMult(player)
	Services.EconomyService.AddSteps(player, gain) -- passt die Laufgeschwindigkeit an + MarkDirty
	Remotes.Effect:FireClient(player, "Steps", gain)
	-- Tagesaufgabe "Lauf X Schritte" (ein Fehler dort darf das Schritte-Sammeln nicht stoppen)
	local rewards = Services.RewardService
	if rewards and rewards.Track then
		local ok, err = pcall(rewards.Track, player, "Steps", gain)
		if not ok then
			warn("[TreadmillService] RewardService.Track fehlgeschlagen: " .. tostring(err))
		end
	end
	return "steps"
end

-- Band-Geschwindigkeit sicherstellen: verankerte Teile schieben nur mit gesetzter AssemblyLinearVelocity.
-- Falls sie irgendwo zurückgesetzt wurde (oder nie ankam), hier wieder setzen.
local function keepBeltsMoving()
	for _, treadmill in ipairs(treadmills) do
		local belt = treadmill.Belt
		if belt.Parent and (belt.AssemblyLinearVelocity - treadmill.Velocity).Magnitude > 0.05 then
			belt.AssemblyLinearVelocity = treadmill.Velocity
		end
	end
end

-- Laufband mit Cash kaufen (Request "BuyTreadmill"). Gibt (Erfolg, Nachricht) zurück.
-- Regeln: gibt es, noch nicht gekauft, das vorige Laufband schon gekauft, genug Cash.
function TreadmillService.Buy(player: Player, id: any): (boolean, string)
	if type(id) ~= "string" or #id > 40 then
		return false, "Unbekanntes Laufband"
	end
	local def = Config.TreadmillsById[id]
	local data = Services.DataService.Get(player)
	if not def then
		return false, "Unbekanntes Laufband"
	end
	if not data or not Services.EconomyService.IsReady(player) then
		return false, "Lädt noch..."
	end
	if type(data.Treadmills) ~= "table" then
		data.Treadmills = {}
	end
	if Config.OwnsTreadmill(data.Treadmills, def.Id) then
		return false, def.Name .. " hast du schon"
	end
	local index = table.find(Config.Treadmills, def)
	local previous = index and index > 1 and Config.Treadmills[index - 1] or nil
	if previous and not Config.OwnsTreadmill(data.Treadmills, previous.Id) then
		return false, "Kaufe zuerst das " .. previous.Name
	end
	local cash = tonumber(data.Cash) or 0
	if cash ~= cash or cash < def.Price then
		return false, "Du brauchst " .. Util.FormatCash(def.Price) .. " für das " .. def.Name
	end
	data.Cash = cash - def.Price
	data.Treadmills[def.Id] = true
	Services.EconomyService.MarkDirty(player)
	task.spawn(Services.DataService.Save, player) -- teurer Kauf -> gleich sichern
	Services.EconomyService.Effect(player, "Confetti", 1)
	return true, def.Name .. " gekauft! Lauf drauf los."
end

function TreadmillService.Init(services)
	Services = services
end

-- Ein Durchlauf der Schleife (für Tests einzeln aufrufbar)
local lastScan = -math.huge
function TreadmillService.Step()
	if #treadmills == 0 and os.clock() - lastScan >= RESCAN_INTERVAL then
		lastScan = os.clock()
		collect()
	end
	if #treadmills == 0 then
		return
	end
	keepBeltsMoving()
	for _, player in ipairs(Players:GetPlayers()) do
		local ok, err = pcall(TreadmillService.TickPlayer, player)
		if not ok then
			warn("[TreadmillService] Fehler bei " .. player.Name .. ": " .. tostring(err))
		end
	end
end

function TreadmillService.Start()
	lastScan = os.clock()
	collect()
	if #treadmills == 0 then
		warn("[TreadmillService] Keine Laufbänder gefunden – suche weiter...")
	end

	Players.PlayerRemoving:Connect(function(player)
		lastHint[player] = nil
		idleSince[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(Config.TreadmillTick)
			local ok, err = pcall(TreadmillService.Step)
			if not ok then
				warn("[TreadmillService] Tick-Fehler: " .. tostring(err))
			end
		end
	end)
end

return TreadmillService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="32">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="33">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="34">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="35">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  METEOR HEIST – Client (alles, was der Spieler sieht)
--  Dieses Skript startet nur die Module im Ordner "Modules" und verbindet sie mit dem Server:
--    UI         Baukasten (Knöpfe, Fenster, Toasts, zählende Zahlen)
--    Hud        Knöpfe links/rechts (mit Badges), Schritte + Geld, Banner (Schauer, Egg Rush, Rennen),
--               Wegweiser (Base beim Tragen, nächstes Ei, Gold-Ei im Rennen), Prompt-Hinweis an den Nestern
--    Windows    Shop (Gamepässe / Boosts / Gadgets), Laufbänder, Rebirth, Tagesbonus, Alien-Index
--    Rewards    🎁 Geschenke, 🎡 Glücksrad, 📜 Tagesaufgaben
--    Effects    fliegende Zahlen, Lieferflug, Schlüpf-Explosion, Hatch-Karte, Wackeln, Konfetti
--    WorldFX    Laufband-Streifen + Fußstaub + Schritt-Zahl, wippende Aliens, Regenbogen, Schlüpf-Countdown,
--               krasse Eier
--    NestField  Ei-Rennen: wilde Kreaturen (lokal gebaut + animiert), Ei-Pop, Nest-Glitzer, Speed-Pads,
--               Gold-Ei-Fanfare + Leuchtpfeil
--    Prompts    Klauen/Kaufen/Verkaufen-Prompts passend ein-/ausblenden
--    Bat        Schläger: Ausholen/Zuschlagen (lokal), kurzes Taumeln nach einem Treffer
--    Night      Nacht/Blutmond-Banner, Glücks-Zähler-Leiste, Sternschnuppen + leuchtende Kisten
--    Trade      🤝 Handel mit anderen Spielern (Fenster, Anfrage-Popup, Prompt am Charakter, Tausch-Animation)
--    Base       🏗️ Stockwerke + Base-Look kaufen, Bau-Animation, Laser-Sperre + Lock-Knopf
--    Fly, PhotoMode, AdminPanel (nur für Admins)
--  Die gesamte Oberfläche wird per Code gebaut – du musst nichts in Studio zusammenklicken.
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util"))
local Aliens = require(Shared:WaitForChild("Aliens")) :: any

local Modules = script.Parent:WaitForChild("Modules")
local UI = require(Modules:WaitForChild("UI"))
local Hud = require(Modules:WaitForChild("Hud"))
local Windows = require(Modules:WaitForChild("Windows"))
local Rewards = require(Modules:WaitForChild("Rewards"))
local Effects = require(Modules:WaitForChild("Effects"))
local WorldFX = require(Modules:WaitForChild("WorldFX"))
local NestField = require(Modules:WaitForChild("NestField"))
local Prompts = require(Modules:WaitForChild("Prompts"))
local Fly = require(Modules:WaitForChild("Fly"))
local PhotoMode = require(Modules:WaitForChild("PhotoMode"))
local AdminPanel = require(Modules:WaitForChild("AdminPanel"))
local MeteorRun = require(Modules:WaitForChild("MeteorRun"))
local Night = require(Modules:WaitForChild("Night"))
local Bat = require(Modules:WaitForChild("Bat"))
local Trade = require(Modules:WaitForChild("Trade"))
local Base = require(Modules:WaitForChild("Base"))

local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local Remotes = {
	Notify = RemotesFolder:WaitForChild("Notify") :: RemoteEvent,
	State = RemotesFolder:WaitForChild("State") :: RemoteEvent,
	Effect = RemotesFolder:WaitForChild("Effect") :: RemoteEvent,
	Request = RemotesFolder:WaitForChild("Request") :: RemoteFunction,
	Admin = RemotesFolder:WaitForChild("Admin") :: RemoteFunction,
}

-- ---------------------------------------------------------------------
-- GRUNDGERÜST
-- ---------------------------------------------------------------------
local gui = UI.Create("ScreenGui", {
	Name = "MeteorHeistUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = false,
	Parent = player:WaitForChild("PlayerGui"),
}) :: ScreenGui
UI.Init(gui)

-- Gemeinsamer "Rucksack" für alle Module
local ctx = {
	Player = player,
	Config = Config,
	Util = Util,
	Aliens = Aliens,
	Remotes = Remotes,
	Gui = gui,
	State = nil :: any, -- letzte Daten vom Server
	StateTime = os.clock(), -- wann der letzte State ankam (Countdowns darin gelten ab dann)
	Toast = UI.Toast,
	Request = nil :: any,
	RequestFull = nil :: any,
	Hooks = {} :: { [string]: (number) -> () },
	Hud = Hud,
	Windows = Windows,
	Rewards = Rewards,
	Effects = Effects,
	Prompts = Prompts,
	Fly = Fly,
	PhotoMode = PhotoMode,
	NestField = NestField,
	Bat = Bat,
}

-- Anfrage an den Server mit ganzer Antwort: (Erfolg, Antwort-Tabelle oder nil).
-- silent = true: keinen Toast zeigen (z.B. Glücksrad – Gewinn erst nach dem Drehen anzeigen).
function ctx.RequestFull(action: string, arg: any?, silent: boolean?): (boolean, { [string]: any }?)
	local ok, result = pcall(function()
		return Remotes.Request:InvokeServer(action, arg)
	end)
	if ok and type(result) == "table" then
		if not silent and type(result.Message) == "string" and result.Message ~= "" then
			UI.Toast(result.Message, if result.Ok then "Success" else "Error")
		end
		return result.Ok == true, result
	end
	if not silent then
		UI.Toast("📡 Keine Antwort vom Server – nochmal versuchen!", "Error")
	end
	return false, nil
end

-- Anfrage an den Server (Rebirth, Daily, Collect, Home, Treadmills, ClaimGift, ClaimQuest,
-- BuyGadget, BuyTreadmill ...). Gibt true bei Erfolg zurück.
function ctx.Request(action: string, arg: any?): boolean
	local ok = ctx.RequestFull(action, arg)
	return ok
end

ctx.Hooks.OnSteps = function(amount: number)
	Hud.PulseSteps()
	WorldFX.OnSteps(amount) -- Konsole des Laufbands zeigt "+X 👟"
end
ctx.Hooks.OnCash = function(_amount: number)
	Hud.PulseCash()
end

-- ---------------------------------------------------------------------
-- MODULE STARTEN
-- ---------------------------------------------------------------------
Effects.Init(ctx)
Windows.Init(ctx)
Rewards.Init(ctx)
Hud.Init(ctx)
Fly.Init(UI.Toast)
PhotoMode.Init(ctx)
MeteorRun.Start(ctx) -- ☄️ Meteor-Run: HUD, Balken, Einschläge, Knopf "☄️ Run"
Night.Init(ctx) -- 🌙 Nacht-Banner, Glücks-Zähler, Sternschnuppen + Kisten
task.spawn(Bat.Init, ctx) -- Schläger-Schwung + Taumeln (wartet kurz auf den Rucksack)
Trade.Init(ctx) -- 🤝 Handel: Fenster, Anfrage-Popup, Prompt "Handeln" an anderen Spielern
Base.Init(ctx) -- 🏠 Base-Fenster (Stockwerke, Look) + Knopf rechts
task.spawn(function()
	local map = workspace:WaitForChild("MeteorHeistMap", 120)
	if map then
		Base.SetMap(map) -- Laser-Sperren an den Basen (fahren beim Sperren zu)
	end
end)

-- Schilder an den Laufbändern: Preis, "Gekauft" oder "Dein bestes" (nur bei Änderung neu schreiben)
local treadmillMap: Instance? = nil
local treadmillSignKey = ""
local function updateTreadmillSigns()
	local state = ctx.State
	local folder = treadmillMap and treadmillMap:FindFirstChild("Treadmills")
	if not state or not folder then
		return
	end
	local owned = if type(state.Treadmills) == "table" then state.Treadmills else {}
	local key = table.concat(owned, ",") .. "|" .. tostring(state.BestTreadmill) .. "|" .. #folder:GetChildren()
	if key == treadmillSignKey then
		return
	end
	treadmillSignKey = key
	for _, model in ipairs(folder:GetChildren()) do
		local id = model:GetAttribute("TreadmillId")
		local def = type(id) == "string" and Config.TreadmillsById[id] or nil
		local sign = model:FindFirstChild("Sign", true)
		local frame = sign and sign:FindFirstChild("Frame")
		local label = frame and frame:FindFirstChild("PriceLabel")
		if def and label and label:IsA("TextLabel") then
			local isOwned = Config.OwnsTreadmill(owned, def.Id)
			if state.BestTreadmill == def.Id then
				label.Text = "Dein bestes Laufband"
				label.TextColor3 = Color3.fromRGB(255, 220, 60)
			elseif isOwned then
				label.Text = "Gekauft"
				label.TextColor3 = Color3.fromRGB(120, 255, 120)
			else
				label.Text = Util.FormatCash(def.Price) .. " – im Menü kaufen"
				label.TextColor3 = Color3.fromRGB(255, 220, 90)
			end
		end
	end
end

-- Welt-Sachen brauchen die Map (wird vom Server gebaut) -> im Hintergrund warten
task.spawn(function()
	local map = workspace:WaitForChild("MeteorHeistMap", 120)
	if not map then
		warn("[Client] MeteorHeistMap nicht gefunden – Welt-Animationen aus")
		return
	end
	Hud.SetMap(map)
	Prompts.Init(map, ctx)
	NestField.Init(ctx, map) -- Ei-Rennen: Kreaturen, Ei-Pop, Speed-Pads
	WorldFX.Init(ctx, map)
	treadmillMap = map
	-- Laufband-Models kommen evtl. erst nach und nach an -> Schilder dann neu schreiben
	local folder = map:WaitForChild("Treadmills", 60)
	if folder then
		folder.ChildAdded:Connect(function()
			task.defer(updateTreadmillSigns)
		end)
	end
	updateTreadmillSigns()
end)

-- ---------------------------------------------------------------------
-- DATEN VOM SERVER
-- ---------------------------------------------------------------------
local function refreshAll()
	local state = ctx.State
	if not state then
		return
	end
	Hud.Refresh(state)
	Windows.Refresh(state)
	Prompts.OnState(state)
	Base.OnState(state)
	updateTreadmillSigns()
end

-- Selten geänderte Teile (Index, Pässe, Statistik, Geschenke + GiftsAt, Aufgaben) schickt der Server
-- nur bei Änderung mit. Fehlen sie in einem Paket, gelten die zuletzt bekommenen weiter.
local STICKY_KEYS = { "Index", "Passes", "Stats", "Gifts", "GiftsAt", "Quests" }

Remotes.State.OnClientEvent:Connect(function(newState)
	if type(newState) ~= "table" then
		return
	end
	local old = ctx.State
	if old then
		for _, key in ipairs(STICKY_KEYS) do
			if newState[key] == nil then
				newState[key] = old[key]
			end
		end
	end
	ctx.State = newState
	ctx.StateTime = os.clock()
	refreshAll()
end)
Remotes.Notify.OnClientEvent:Connect(function(text, kind)
	UI.Toast(tostring(text), if type(kind) == "string" then kind else "Info")
end)
Remotes.Effect.OnClientEvent:Connect(function(name, strength, data)
	Effects.Play(name, strength, data)
end)

-- Jede Sekunde: Banner, Badges, Countdowns (Tagesbonus, Geschenke, Gratis-Dreh, Aufgaben)
local function tick()
	Hud.Tick()
	Rewards.Tick()
	local state = ctx.State
	if state and state.DailyReady == false then
		state.DailyIn = math.max(0, (tonumber(state.DailyIn) or 0) - 1)
		if state.DailyIn == 0 then
			state.DailyReady = true
			Hud.Refresh(state)
		end
		Windows.RefreshDaily(state)
	end
end
task.spawn(function()
	while true do
		-- Ein Fehler darf die Schleife nicht für immer anhalten
		local ok, err = pcall(tick)
		if not ok then
			warn("[Client] Tick-Fehler: " .. tostring(err))
		end
		task.wait(1)
	end
end)

-- ---------------------------------------------------------------------
-- ADMIN-PANEL (nur wenn der Server dich als Admin markiert)
-- ---------------------------------------------------------------------
local function checkAdmin()
	if player:GetAttribute("IsAdmin") == true then
		AdminPanel.Build(ctx)
	end
end
player:GetAttributeChangedSignal("IsAdmin"):Connect(checkAdmin)
checkAdmin()

-- Willkommen – mit den Tasten des Geräts (Handy: halten/tippen, Controller: [X]/[Y], PC: [E]/[F])
local inputStyle = Hud.InputStyle()
local grabKey = if inputStyle == "Touch" then "halten" elseif inputStyle == "Gamepad" then "[X] halten" else "[E] halten"
local buyKey = if inputStyle == "Touch" then "tippen" elseif inputStyle == "Gamepad" then "[Y]" else "[F]"
UI.Toast(
	"🥚 Willkommen bei " .. tostring(Config.GameName) .. "! Schnapp dir Eier aus den Nestern (" .. grabKey .. ")!",
	"Event"
)
task.delay(4, function()
	UI.Toast("🏃 Dann schnell heimtragen – Achtung, Monster! Kaufen (" .. buyKey .. ") liefert direkt.", "Info")
end)
task.delay(8, function()
	UI.Toast("🐣 In deiner Base schlüpfen Aliens – die bringen dir Geld! 💰", "Info")
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="36">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">AdminPanel</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  ADMIN-PANEL (wird nur gebaut, wenn der Server dich als Admin markiert;
--  JEDE Aktion wird zusätzlich auf dem Server geprüft – Exploiter haben keine Chance)
--  Öffnen: Knopf "Admin" rechts oder Taste P
--  Reiter: Spawnen / Events / Spieler / Kräfte / Server
--  Das Ziel-Feld oben (me / all / others / Name / UserId) gilt für alle Reiter.
--  Gefährliche Aktionen brauchen einen zweiten Klick.
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))

local AdminPanel = {}

local Theme = UI.Theme
local built = false
local player = Players.LocalPlayer
local STATUS_POP_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TAB_POP_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local CONFIRM_TIME = 5 -- Sekunden: so lange gilt der erste Klick einer gefährlichen Aktion
local SPECTATE_KEY = Enum.KeyCode.X

local TABS = {
	{ Id = "Spawn", Text = "Spawnen", Color = Theme.Orange },
	{ Id = "Events", Text = "Events", Color = Theme.Purple },
	{ Id = "Players", Text = "Spieler", Color = Theme.Blue },
	{ Id = "Powers", Text = "Kräfte", Color = Theme.Green },
	{ Id = "Server", Text = "Server", Color = Theme.Red },
}

local function darker(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

local function rainbowSequence(): ColorSequence
	local keys = {}
	for k = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(k / 6, Color3.fromHSV(k / 6, 0.8, 1)))
	end
	return ColorSequence.new(keys)
end

local function clearChildren(parent: Instance, className: string)
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA(className) then
			child:Destroy()
		end
	end
end

-- Einfache Liste (Frame, wächst mit dem Inhalt)
local function listFrame(parent: Instance, order: number): Frame
	return UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
	})
end

type Slider = { Set: (value: number) -> (), Get: () -> number }

-- Schieberegler: Wert wird beim Loslassen geschickt (spart Anfragen)
local function slider(
	parent: Instance,
	order: number,
	title: string,
	min: number,
	max: number,
	default: number,
	onRelease: (number) -> ()
): Slider
	local row = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	UI.Label({
		Size = UDim2.new(0.24, 0, 1, 0),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 18,
		Outline = 2,
		Parent = row,
	})
	local track: TextButton = UI.Create("TextButton", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.26, 0, 0.5, 0),
		Size = UDim2.new(0.56, 0, 0, 18),
		BackgroundColor3 = Theme.PanelDark,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	}, { UI.Corner(9), UI.Stroke(Color3.new(0, 0, 0), 2) })
	local fill: Frame = UI.Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Green,
		Parent = track,
	}, { UI.Corner(9) })
	local knob: Frame = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
		Parent = track,
	}, { UI.Corner(13), UI.Stroke(Color3.new(0, 0, 0), 3) })
	local valueLabel = UI.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0.16, 0, 1, 0),
		Text = "",
		MaxText = 20,
		Outline = 2,
		Parent = row,
	})
	local value = default
	local function show()
		local ratio = math.clamp((value - min) / math.max(1, max - min), 0, 1)
		fill.Size = UDim2.fromScale(ratio, 1)
		knob.Position = UDim2.fromScale(ratio, 0.5)
		valueLabel.Text = tostring(value)
	end
	local function setFromX(x: number)
		local width = math.max(1, track.AbsoluteSize.X)
		local ratio = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		value = math.floor(min + ratio * (max - min) + 0.5)
		show()
	end
	local dragging = false
	track.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		local kind = input.UserInputType
		if dragging and (kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local kind = input.UserInputType
		if dragging and (kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch) then
			dragging = false
			task.spawn(onRelease, value)
		end
	end)
	show()
	return {
		Set = function(newValue: number)
			value = math.clamp(math.floor(newValue + 0.5), min, max)
			show()
		end,
		Get = function(): number
			return value
		end,
	}
end

function AdminPanel.Build(ctx: any)
	if built then
		return
	end
	built = true
	local Config = ctx.Config
	local Util = ctx.Util
	local Aliens = ctx.Aliens
	local Remotes = ctx.Remotes
	local powers = Config.AdminPowers or {}

	local win = UI.Window("ADMIN-PANEL", 720, 600, Theme.Red)

	-- -----------------------------------------------------------------
	-- Kopfzeile: Reiter + Ziel-Feld + Statuszeile (scrollen nicht mit)
	-- -----------------------------------------------------------------
	local tabBar = UI.Create("Frame", {
		Name = "Tabs",
		Position = UDim2.fromOffset(12, 68),
		Size = UDim2.new(1, -24, 0, 42),
		BackgroundTransparency = 1,
		Parent = win.Panel,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		}),
	})
	local topRow = UI.Create("Frame", {
		Name = "TargetRow",
		Position = UDim2.fromOffset(12, 116),
		Size = UDim2.new(1, -24, 0, 34),
		BackgroundTransparency = 1,
		Parent = win.Panel,
	})
	local targetBox = UI.TextBox({
		Size = UDim2.new(0.3, 0, 1, 0),
		Text = "me",
		PlaceholderText = "Ziel: me / all / Name",
		Parent = topRow,
	})
	local status = UI.Label({
		Position = UDim2.new(0.31, 0, 0, 0),
		Size = UDim2.new(0.69, 0, 1, 0),
		Text = "Bereit. Ziel links: me / all / others / Name / UserId",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.SubText,
		Font = Enum.Font.GothamBold,
		MaxText = 16,
		Parent = topRow,
	})
	win.Content.Position = UDim2.fromOffset(12, 158)
	win.Content.Size = UDim2.new(1, -24, 1, -170)

	local statusScale: UIScale = UI.Create("UIScale", { Scale = 1, Parent = status })
	local function setStatus(text: string, color: Color3)
		status.Text = text
		status.TextColor3 = color
		statusScale.Scale = 1.1
		TweenService:Create(statusScale, STATUS_POP_INFO, { Scale = 1 }):Play()
	end

	local function admin(action: string, args: { [string]: any }?): any
		local ok, result = pcall(function()
			return Remotes.Admin:InvokeServer(action, args or {})
		end)
		if ok and type(result) == "table" then
			setStatus(
				(if result.Ok then "OK: " else "Fehler: ") .. tostring(result.Message),
				if result.Ok then Theme.Cash else Theme.Red
			)
			return result
		end
		setStatus("Keine Antwort vom Server", Theme.Red)
		return nil
	end

	-- Gefährliche Aktion: erst beim zweiten Klick (innerhalb von CONFIRM_TIME Sekunden) ausführen
	local confirmKey: string? = nil
	local confirmAt = 0
	local function needsConfirm(key: string, label: string): boolean
		local now = os.clock()
		if confirmKey ~= key or now - confirmAt > CONFIRM_TIME then
			confirmKey = key
			confirmAt = now
			setStatus("Nochmal klicken zum Bestätigen: " .. label, Theme.Orange)
			return true
		end
		confirmKey = nil
		return false
	end

	local function target(): string
		return targetBox.Text
	end

	-- Reiter-Seiten
	local pages: { [string]: Frame } = {}
	local tabButtons: { [string]: UI.Button } = {}
	local currentTab = "Spawn"
	local onTabOpen: { [string]: () -> () } = {}
	local function selectTab(id: string)
		currentTab = id
		for pageId, page in pairs(pages) do
			page.Visible = pageId == id
			local scale = page:FindFirstChildOfClass("UIScale")
			if pageId == id and scale then
				scale.Scale = 0.95
				TweenService:Create(scale, TAB_POP_INFO, { Scale = 1 }):Play()
			end
		end
		for _, tab in ipairs(TABS) do
			local button = tabButtons[tab.Id]
			if button then
				button.SetColor(if tab.Id == id then tab.Color else Theme.Gray)
			end
		end
		win.Content.CanvasPosition = Vector2.zero
		local hook = onTabOpen[id]
		if hook then
			task.spawn(hook)
		end
	end
	for i, tab in ipairs(TABS) do
		pages[tab.Id] = UI.Create("Frame", {
			Name = tab.Id,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = i,
			Visible = false,
			Parent = win.Content,
		}, {
			UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
			UI.Create("UIScale", { Scale = 1 }),
		})
		tabButtons[tab.Id] = UI.Button({
			Size = UDim2.new(1 / #TABS, -5, 1, 0),
			Text = tab.Text,
			Color = Theme.Gray,
			LayoutOrder = i,
			MaxText = 18,
			Parent = tabBar,
		}, function()
			selectTab(tab.Id)
		end)
	end

	-- Kleiner Knopf-Helfer für Raster
	local function gridButtons(parent: Instance, order: number, cellX: number, list: { { any } })
		local grid = UI.Grid(parent, order, cellX, 40)
		for i, info in ipairs(list) do
			UI.Button({
				Text = info[1],
				Color = info[2],
				LayoutOrder = i,
				MaxText = 14,
				Wrap = true,
				StrokeSize = 2,
				Parent = grid,
			}, info[3])
		end
		return grid
	end

	-- Ein/Aus-Knopf (Text + Farbe wechseln)
	local function toggleButton(
		parent: Instance,
		order: number,
		size: UDim2,
		offText: string,
		onText: string,
		onColor: Color3,
		onChange: (boolean) -> ()
	): (UI.Button, (boolean) -> ())
		local state = false
		local button: UI.Button
		local function show(value: boolean)
			state = value
			button.SetText(if value then onText else offText)
			button.SetColor(if value then onColor else Theme.Gray)
		end
		button = UI.Button({
			Size = size,
			Text = offText,
			Color = Theme.Gray,
			LayoutOrder = order,
			MaxText = 16,
			Parent = parent,
		}, function()
			show(not state)
			onChange(state)
		end)
		return button, show
	end

	-- =================================================================
	-- REITER: SPAWNEN
	-- =================================================================
	local spawnPage = pages.Spawn
	UI.Section(spawnPage, "Meteor / Alien spawnen", 10)
	local selectedMeteor = Config.Meteors[1] and Config.Meteors[1].Id or ""
	local selectedMutation = "Normal"
	local selectedAlien: string? = nil
	local selectedLabel = UI.Label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = "",
		LayoutOrder = 11,
		MaxText = 18,
		Outline = 2,
		Parent = spawnPage,
	})
	local alienGrid: Frame
	local function updateSelected()
		local def = Config.MeteorsById[selectedMeteor]
		if not def then
			selectedLabel.Text = "Kein Meteor ausgewählt"
			return
		end
		local rarity = Config.RaritiesByName[def.Rarity]
		local alien = selectedAlien and Aliens.ById[selectedAlien]
		selectedLabel.Text = ("%s %s (%s)%s"):format(
			selectedMutation,
			def.Name,
			def.Rarity,
			if alien then ("  ->  " .. alien.Name .. " [" .. alien.Tier .. "]") else ""
		)
		selectedLabel.TextColor3 = if rarity then rarity.Color else Theme.Text
	end
	-- Alien-Varianten des gewählten Meteors (Aliens.ByMeteor)
	local function rebuildAliens()
		clearChildren(alienGrid, "Frame")
		local options = Aliens.ByMeteor[selectedMeteor] or {}
		selectedAlien = options[1] and options[1].Id or nil
		for i, option in ipairs(options) do
			local def = Aliens.ById[option.Id]
			if def then
				UI.Button({
					Text = def.Name .. " (" .. def.Tier .. ")",
					Color = if def.Tier == "Ultra"
						then Theme.Pink
						elseif def.Tier == "Selten" then Theme.Blue
						else Theme.PanelLight,
					LayoutOrder = i,
					MaxText = 13,
					Wrap = true,
					StrokeSize = 2,
					Parent = alienGrid,
				}, function()
					selectedAlien = def.Id
					updateSelected()
				end)
			end
		end
		updateSelected()
	end
	local meteorGrid = UI.Grid(spawnPage, 12, 124, 40)
	for i, def in ipairs(Config.Meteors) do
		local rarity = Config.RaritiesByName[def.Rarity]
		local rarityColor: Color3 = if rarity then rarity.Color else Theme.Gray
		UI.Button({
			Text = def.Name,
			Color = darker(rarityColor, 0.35),
			LayoutOrder = i,
			MaxText = 13,
			Wrap = true,
			StrokeSize = 2,
			Parent = meteorGrid,
		}, function()
			selectedMeteor = def.Id
			rebuildAliens()
		end)
	end
	UI.Label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = "Alien-Variante:",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.SubText,
		LayoutOrder = 13,
		MaxText = 16,
		Parent = spawnPage,
	})
	alienGrid = UI.Grid(spawnPage, 14, 200, 40)
	local mutGrid = UI.Grid(spawnPage, 15, 124, 38)
	for i, mut in ipairs(Config.Mutations) do
		local mutButton = UI.Button({
			Text = mut.Name .. " x" .. mut.Mult,
			Color = darker(mut.Color or Theme.Gray, 0.25),
			LayoutOrder = i,
			MaxText = 15,
			Parent = mutGrid,
		}, function()
			selectedMutation = mut.Name
			updateSelected()
		end)
		if mut.Rainbow == true then
			mutButton.Label.TextColor3 = Color3.new(1, 1, 1)
			UI.Create("UIGradient", { Color = rainbowSequence(), Parent = mutButton.Label })
		end
	end
	rebuildAliens()
	local countRow = UI.Row(spawnPage, 16, 38)
	local countBox = UI.TextBox({
		Size = UDim2.new(0.5, -3, 1, 0),
		PlaceholderText = "Anzahl Eier (1-25)",
		Text = "1",
		LayoutOrder = 1,
		Parent = countRow,
	})
	local levelBox = UI.TextBox({
		Size = UDim2.new(0.5, -3, 1, 0),
		PlaceholderText = "Level (1-" .. tostring(Config.MaxLevel) .. ")",
		Text = "1",
		LayoutOrder = 2,
		Parent = countRow,
	})
	gridButtons(spawnPage, 17, 214, {
		{
			"Alien in Ziel-Base (geschlüpft)",
			Theme.Purple,
			function()
				admin("SpawnAlien", {
					MeteorId = selectedMeteor,
					AlienId = selectedAlien,
					Mutation = selectedMutation,
					Level = levelBox.Text,
					Where = "Base",
					Target = target(),
				})
			end,
		},
		{
			"Alien als Ei vor mir",
			Theme.Green,
			function()
				admin("SpawnAlien", {
					MeteorId = selectedMeteor,
					AlienId = selectedAlien,
					Mutation = selectedMutation,
					Level = levelBox.Text,
					Where = "Ground",
				})
			end,
		},
		{
			"Ei in Ziel-Base",
			Theme.Purple,
			function()
				admin("GiveMeteor", {
					MeteorId = selectedMeteor,
					Mutation = selectedMutation,
					Level = levelBox.Text,
					Target = target(),
				})
			end,
		},
		{
			"Zum Nester-Feld",
			Theme.Orange,
			function()
				admin(
					"SpawnMeteor",
					{ MeteorId = selectedMeteor, Mutation = selectedMutation, Count = countBox.Text, Where = "Nest" }
				)
			end,
		},
		{
			"Ei vor mir",
			Theme.Orange,
			function()
				admin(
					"SpawnMeteor",
					{ MeteorId = selectedMeteor, Mutation = selectedMutation, Count = countBox.Text, Where = "Me" }
				)
			end,
		},
		{
			"Gratis-Ei in Gratis-Zone",
			Theme.Green,
			function()
				admin("SpawnMeteor", {
					MeteorId = selectedMeteor,
					Mutation = selectedMutation,
					Count = countBox.Text,
					Where = "Free",
					Free = true,
				})
			end,
		},
	})

	-- Admin-Meteore
	UI.Section(spawnPage, "Admin-Meteore", 30, Color3.fromRGB(255, 80, 80))
	local adminMeteors = {}
	for _, def in ipairs(Config.Meteors) do
		if def.Rarity == "Admin" then
			table.insert(adminMeteors, def)
		end
	end
	for i, def in ipairs(adminMeteors) do
		local card = UI.Card({ Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 30 + i, Parent = spawnPage })
		local nameColor: Color3 = if typeof(def.Color) == "Color3" then def.Color else Color3.fromRGB(255, 40, 40)
		local nameLabel = UI.Label({
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(0.38, -12, 1, -12),
			Text = tostring(def.Name),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = nameColor:Lerp(Color3.new(1, 1, 1), 0.3),
			MaxText = 20,
			Outline = 2,
			Parent = card,
		})
		if def.Effects and def.Effects.Rainbow then
			nameLabel.TextColor3 = Color3.new(1, 1, 1)
			UI.Create("UIGradient", { Color = rainbowSequence(), Parent = nameLabel })
		end
		UI.Button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(0.69, -4, 0.5, 0),
			Size = UDim2.new(0.31, -6, 0, 38),
			Text = "In die Gratis-Zone",
			Color = Theme.Green,
			MaxText = 16,
			Parent = card,
		}, function()
			admin("SpawnAdminMeteor", { MeteorId = def.Id, Where = "Free" })
		end)
		UI.Button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.new(0.31, -6, 0, 38),
			Text = "In meine Base",
			Color = Theme.Purple,
			MaxText = 16,
			Parent = card,
		}, function()
			admin("SpawnAdminMeteor", { MeteorId = def.Id, Where = "Base" })
		end)
	end
	local adminRainRow = UI.Row(spawnPage, 50, 44)
	local adminRainBox = UI.TextBox({
		Size = UDim2.new(0.3, -3, 1, 0),
		PlaceholderText = "Anzahl (1-8)",
		Text = "4",
		LayoutOrder = 1,
		Parent = adminRainRow,
	})
	UI.Button({
		Size = UDim2.new(0.7, -3, 1, 0),
		Text = "Admin-Meteor-Regen",
		Color = Color3.fromRGB(220, 40, 60),
		LayoutOrder = 2,
		MaxText = 20,
		Parent = adminRainRow,
	}, function()
		local count = math.clamp(math.floor(tonumber(adminRainBox.Text) or 4), 1, 8)
		adminRainBox.Text = tostring(count)
		admin("AdminRain", { Count = count })
	end)

	-- Eierregen in den Nestern
	UI.Section(spawnPage, "Eierregen in den Nestern", 60)
	local rainGrid = UI.Grid(spawnPage, 61, 100, 38)
	UI.Button({ Text = "Zufall", Color = Theme.Gray, LayoutOrder = 0, MaxText = 15, Parent = rainGrid }, function()
		admin("MeteorRain", { Count = if countBox.Text ~= "1" then countBox.Text else 15 })
	end)
	for i, rarity in ipairs(Config.Rarities) do
		if not rarity.AdminOnly then
			UI.Button({
				Text = rarity.Name,
				Color = darker(rarity.Color, 0.3),
				LayoutOrder = i,
				MaxText = 14,
				Parent = rainGrid,
			}, function()
				admin(
					"MeteorRain",
					{ Rarity = rarity.Name, Count = if countBox.Text ~= "1" then countBox.Text else 10 }
				)
			end)
		end
	end

	-- =================================================================
	-- REITER: EVENTS
	-- =================================================================
	local eventPage = pages.Events
	local globalToggle = false
	local globalRow = UI.Row(eventPage, 1, 40)
	toggleButton(
		globalRow,
		1,
		UDim2.new(1, 0, 1, 0),
		"Nur dieser Server (klicken für ALLE Server)",
		"ALLE Server",
		Theme.Purple,
		function(value)
			globalToggle = value
		end
	)
	UI.Section(eventPage, "Nacht", 10)
	gridButtons(eventPage, 11, 214, {
		{
			"Nacht starten",
			Color3.fromRGB(60, 70, 160),
			function()
				admin("Night", { Mode = "Night", Global = globalToggle })
			end,
		},
		{
			"Blutmond starten",
			Color3.fromRGB(190, 30, 40),
			function()
				admin("Night", { Mode = "BloodMoon", Global = globalToggle })
			end,
		},
		{
			"Nacht beenden",
			Theme.Gray,
			function()
				admin("Night", { Mode = "End", Global = globalToggle })
			end,
		},
	})
	UI.Section(eventPage, "Nester & Eier", 20)
	local eventRow = UI.Row(eventPage, 21, 38)
	local multBox = UI.TextBox({
		Size = UDim2.new(0.33, -4, 1, 0),
		PlaceholderText = "Glück x",
		Text = "2",
		LayoutOrder = 1,
		Parent = eventRow,
	})
	local minutesBox = UI.TextBox({
		Size = UDim2.new(0.33, -4, 1, 0),
		PlaceholderText = "Minuten",
		Text = "10",
		LayoutOrder = 2,
		Parent = eventRow,
	})
	local rareBox = UI.TextBox({
		Size = UDim2.new(0.33, -4, 1, 0),
		PlaceholderText = "Seltene Eier (1-10)",
		Text = tostring(powers.RareNestCount or 4),
		LayoutOrder = 3,
		Parent = eventRow,
	})
	gridButtons(eventPage, 22, 214, {
		{
			"Glück starten",
			Theme.Green,
			function()
				admin("ServerLuck", { Mult = multBox.Text, Minutes = minutesBox.Text, Global = globalToggle })
			end,
		},
		{
			"Meteoritenschauer",
			Theme.Orange,
			function()
				admin("StartShower", { Seconds = (tonumber(minutesBox.Text) or 1) * 60, Global = globalToggle })
			end,
		},
		{
			"Egg Rush",
			Color3.fromRGB(230, 170, 20),
			function()
				admin("EggRush", { Global = globalToggle })
			end,
		},
		{
			"Große Nester",
			Theme.Pink,
			function()
				admin("RareNests", { Count = rareBox.Text, Global = globalToggle })
			end,
		},
		{
			"Ei-Rennen",
			Color3.fromRGB(255, 190, 30),
			function()
				admin("RaceEvent", { Global = globalToggle })
			end,
		},
	})
	UI.Section(eventPage, "Ansage", 30)
	local announceRow = UI.Row(eventPage, 31, 42)
	local announceBox = UI.TextBox({
		Size = UDim2.new(0.7, -3, 1, 0),
		PlaceholderText = "Nachricht an alle...",
		LayoutOrder = 1,
		Parent = announceRow,
	})
	UI.Button({
		Size = UDim2.new(0.3, -3, 1, 0),
		Text = "Senden",
		Color = Theme.Blue,
		LayoutOrder = 2,
		MaxText = 18,
		Parent = announceRow,
	}, function()
		admin("Announce", { Text = announceBox.Text, Global = globalToggle })
	end)
	UI.Section(eventPage, "Spaß", 40)
	gridButtons(eventPage, 41, 214, {
		{
			"Alle Eier sofort schlüpfen",
			Theme.Green,
			function()
				admin("HatchAllServer")
