-- ---------------------------------------------------------------------
-- PROMPT-HINWEIS (Prompts meldet, welche Art Prompt gerade sichtbar ist)
-- ---------------------------------------------------------------------
-- "Touch" (Handy/Tablet), "Gamepad" (Controller) oder "Keyboard" (PC) – nach der letzten Eingabe,
-- vor der ersten Eingabe nach dem Gerät geraten
local function inputStyle(): string
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "Touch"
	elseif last.Name:sub(1, 7) == "Gamepad" then
		return "Gamepad"
	elseif last == Enum.UserInputType.Keyboard or last.Name:sub(1, 5) == "Mouse" then
		return "Keyboard"
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "Touch"
	elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		return "Gamepad"
	end
	return "Keyboard"
end
Hud.InputStyle = inputStyle

local function hintText(kind: string, state: any): string
	local style = inputStyle()
	local grabKey = if style == "Gamepad" then "[X] halten" elseif style == "Touch" then "Halten" else "[E] halten"
	local buyKey = if style == "Gamepad" then "[Y]" elseif style == "Touch" then "Tippen" else "[F]"
	local full = state ~= nil
		and (tonumber(state.UsedSlots) or 0) >= (tonumber(state.Slots) or math.huge)
		and state.HasPlot ~= false
	if full then
		return "📦 Deine Base ist voll – verkauf erst etwas!"
	end
	if kind == "Belt" then
		if carrying then
			return "🏃 Erst heimbringen!   💵 " .. buyKey .. " = KAUFEN geht trotzdem"
		end
		return "🦹 " .. grabKey .. " = KLAUEN (gratis, selbst heimtragen!)   💵 " .. buyKey .. " = KAUFEN"
	elseif kind == "Ground" then
		if carrying then
			return "🏃 Du trägst schon etwas – erst heimbringen!"
		end
		return "🥚 " .. grabKey .. " = SCHNAPPEN – dann schnell in deine Base!"
	elseif kind == "Free" then
		return "🎁 "
			.. (if style == "Keyboard" then "[E]" else grabKey)
			.. " = HOLEN – fliegt direkt in deine Base!"
	end
	return ""
end

local function updateHint()
	local kind = promptHintKind
	local text = if kind then hintText(kind, ctx.State) else ""
	local show = text ~= ""
	if hintFrame.Visible ~= show then
		hintFrame.Visible = show
	end
	if show and hintLabel.Text ~= text then
		hintLabel.Text = text
	end
end

-- kind: "Belt" (Förderband), "Ground" (Ei am Boden), "Free" (Gratis-Zone) oder nil
function Hud.SetPromptHint(kind: string?)
	if kind ~= promptHintKind then
		promptHintKind = kind
		updateHint()
	end
end

-- ---------------------------------------------------------------------
-- WEGWEISER
-- ---------------------------------------------------------------------
local function findMyPlot(): Model?
	local plot = myPlot
	if plot and plot.Parent and plot:GetAttribute("OwnerUserId") == player.UserId then
		return plot
	end
	myPlot = nil
	local map = mapFolder
	local plots = map and map:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, child in ipairs(plots:GetChildren()) do
		if child:IsA("Model") and child:GetAttribute("OwnerUserId") == player.UserId then
			myPlot = child
			return child
		end
	end
	return nil
end

local function eggRushActive(): boolean
	local untilTime = tonumber(ReplicatedStorage:GetAttribute("EggRushUntil")) or 0
	return untilTime > workspace:GetServerTimeNow()
end

-- Nächstes Ei am Boden, das man schnappen kann (GrabPrompt an)
local function scanEggs(rootPos: Vector3)
	nearestEgg = nil
	local folder = groundFolder
	if not folder then
		return
	end
	local best = math.huge
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BasePart") then
			local prompt = child:FindFirstChild("GrabPrompt")
			if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
				local dist = (child.Position - rootPos).Magnitude
				if dist < best then
					best = dist
					nearestEgg = child
				end
			end
		end
	end
end

local function setNavVisible(show: boolean)
	if navFrame.Visible ~= show then
		navFrame.Visible = show
	end
end

local navClock = 0
local eggClock = EGG_SCAN_INTERVAL
local homeClock = HOME_SCAN_INTERVAL
local function stepNav(dt: number)
	navClock += dt
	eggClock += dt
	homeClock += dt
	if navClock < NAV_INTERVAL then
		return
	end
	navClock = 0
	local camera = workspace.CurrentCamera
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not camera or not root or not root:IsA("BasePart") then
		setNavVisible(false)
		return
	end
	local rootPos = root.Position
	local target: Vector3? = nil
	local home = false
	if carrying then
		-- Basen bewegen sich nicht: Position nur ab und zu neu holen (kein CFrame pro Frame)
		if homeClock >= HOME_SCAN_INTERVAL then
			homeClock = 0
			local plot = findMyPlot()
			homePos = if plot then plot:GetPivot().Position else nil
		end
		target = homePos
		home = true
	elseif eggRushActive() then
		if eggClock >= EGG_SCAN_INTERVAL then
			eggClock = 0
			scanEggs(rootPos)
		end
		local egg = nearestEgg
		if egg and egg.Parent then
			target = egg.Position
		end
	end
	if not target then
		setNavVisible(false)
		return
	end
	local rel = Vector3.new(target.X - rootPos.X, 0, target.Z - rootPos.Z)
	local distance = math.floor(rel.Magnitude)
	-- Pfeil relativ zur Blickrichtung der Kamera (oben = geradeaus)
	local _, yaw = camera.CFrame:ToEulerAnglesYXZ()
	navArrow.Rotation = (180 - math.deg(math.atan2(-rel.X, -rel.Z) - yaw)) % 360 - 180 -- -180..180
	-- Text nur neu schreiben, wenn sich Meter oder Sekunden geändert haben
	local left = 0
	local key
	if home then
		local timeout = tonumber(ctx.Config.CarryTimeout) or 60
		left = math.clamp(math.ceil(timeout - (os.clock() - carryStartedAt)), 0, 999)
		key = distance * 1000 + left
	else
		key = -1 - distance
	end
	if key ~= lastNavKey then
		lastNavKey = key
		if home then
			navLabel.Text = ("🏠 Base: %d m   ⏱️ %d s"):format(distance, left)
			navLabel.TextColor3 = if left <= CARRY_WARN then Color3.fromRGB(255, 120, 120) else WHITE
		else
			navLabel.Text = ("🥚 Nächstes Ei: %d m – schnell!"):format(distance)
			navLabel.TextColor3 = Theme.Yellow
		end
	end
	setNavVisible(true)
end

-- ---------------------------------------------------------------------
-- BADGES (rechte Knöpfe)
-- ---------------------------------------------------------------------
local function updateBadges(state: any)
	local Util = ctx.Util
	local summary = ctx.Rewards.Summary(state)
	if summary.GiftsReady > 0 then
		UI.SetBadge(giftBadge, tostring(summary.GiftsReady), Theme.Red, true)
	elseif summary.NextGiftIn then
		UI.SetBadge(giftBadge, Util.FormatTime(math.ceil(summary.NextGiftIn)), Theme.PanelLight, false)
	else
		UI.SetBadge(giftBadge, nil)
	end
	local spins = summary.Spins + (if summary.FreeReady then 1 else 0)
	if spins > 0 then
		UI.SetBadge(
			wheelBadge,
			if spins > 99 then "99+" else tostring(spins),
			if summary.FreeReady then Theme.Green else Theme.Red,
			summary.FreeReady
		)
	else
		UI.SetBadge(wheelBadge, nil)
	end
	if summary.QuestsReady > 0 then
		UI.SetBadge(questBadge, tostring(summary.QuestsReady), Theme.Red, true)
	else
		UI.SetBadge(questBadge, nil)
	end
end

-- ---------------------------------------------------------------------
-- AKTUALISIEREN
-- ---------------------------------------------------------------------
local function setCarrying(now: boolean)
	if now == carrying then
		return
	end
	carrying = now
	if now then
		carryStartedAt = os.clock()
	end
	carryHolder.Visible = now
	if carryTween then
		carryTween:Cancel()
		carryTween = nil
	end
	carryScale.Scale = 1
	if now then
		local tween = TweenService:Create(carryScale, CARRY_PULSE_INFO, { Scale = 1.08 })
		tween:Play()
		carryTween = tween
	end
end

-- ⭐ Starter-Paket-Knopf: zeigen, solange nicht gekauft und eingerichtet. Läuft gerade ein Kauf,
-- steht "⏳" darauf (ein zweiter Klick wäre ein zweiter Kauf – Windows.BuyStarter ignoriert ihn).
local function updateStarter(state: any)
	local starter = starterButton
	if not starter or not state then
		return
	end
	local product = ctx.Config.ProductsByKey.StarterPack
	local show = product ~= nil and product.Id ~= 0 and state.StarterBought == false
	if starter.Frame.Visible ~= show then
		starter.Frame.Visible = show
	end
	starter.SetSub(if ctx.Windows.StarterPending() then "⏳ Kauf läuft..." else starterSubText)
end

function Hud.Refresh(state: any)
	if not state then
		return
	end
	local Util = ctx.Util
	local mult = UI.FormatMult(state.StepsMult)
	if mult ~= stepsMultText then
		stepsMultText = mult
		UI.RedrawCounter(stepsCounter)
	end
	-- Beim Glücksrad bleiben die Zähler kurz stehen (zählen hoch, wenn das Rad steht)
	if holdCount == 0 or firstState then
		UI.SetCounter(stepsCounter, tonumber(state.Steps) or 0, firstState)
		UI.SetCounter(cashCounter, tonumber(state.Cash) or 0, firstState)
	end
	firstState = false

	-- 🔥 Rebirth geschafft? -> Bildschirm-Blitz (nur wenn die Zahl steigt, nicht beim ersten Laden)
	local rebirths = tonumber(state.Rebirths) or 0
	if lastRebirths ~= nil and rebirths > lastRebirths and ctx.Effects and ctx.Effects.RebirthFlash then
		ctx.Effects.RebirthFlash()
	end
	lastRebirths = rebirths

	local income = "+" .. Util.FormatCash(tonumber(state.Income) or 0) .. "/s"
	local pending = tonumber(state.Pending) or 0
	local autoCollect = state.Passes and state.Passes.AutoCollect == true
	if pending >= 1 and not autoCollect then
		income ..= "   🏦 " .. Util.FormatCash(pending) .. " abholen!"
	end
	if incomeLabel.Text ~= income then
		incomeLabel.Text = income
	end
	local info = ("☄️ %d/%d    🏃 %d    🔥 %d"):format(
		math.floor(tonumber(state.UsedSlots) or 0),
		math.floor(tonumber(state.Slots) or 0),
		math.floor(tonumber(state.Speed) or 16),
		math.floor(tonumber(state.Rebirths) or 0)
	)
	if infoLabel.Text ~= info then
		infoLabel.Text = info
	end

	local offer = offerButton
	if offer then
		local boots = ctx.Config.GamePassesByKey.SpeedBoots
		local owned = state.Passes and state.Passes.SpeedBoots == true
		offer.Frame.Visible = boots ~= nil and boots.Id ~= 0 and not owned
	end
	updateStarter(state)
	dailyBadge.Visible = state.DailyReady == true
	updateBadges(state)

	setCarrying(state.Carrying == true)
	updateHint()
end

-- Zähler anhalten (true) / weiterlaufen lassen (false). Verschachtelbar, mit Sicherheits-Zeit.
function Hud.HoldCounters(on: boolean)
	if on then
		holdCount += 1
		holdToken += 1
		local token = holdToken
		task.delay(HOLD_SAFETY, function()
			if holdToken == token and holdCount > 0 then
				holdCount = 0
				if ctx.State then
					Hud.Refresh(ctx.State)
				end
			end
		end)
	elseif holdCount > 0 then
		holdCount -= 1
		if holdCount == 0 and ctx.State then
			Hud.Refresh(ctx.State)
		end
	end
end

-- Jede Sekunde: Banner + Countdowns + Badges
function Hud.Tick()
	local Util = ctx.Util
	local now = workspace:GetServerTimeNow()
	local showerUntil = tonumber(ReplicatedStorage:GetAttribute("ShowerUntil")) or 0
	local luckUntil = tonumber(ReplicatedStorage:GetAttribute("LuckUntil")) or 0
	local luckMult = tonumber(ReplicatedStorage:GetAttribute("LuckMult")) or 1
	local nextShower = tonumber(ReplicatedStorage:GetAttribute("NextShowerAt")) or 0
	local rushUntil = tonumber(ReplicatedStorage:GetAttribute("EggRushUntil")) or 0
	local nextRush = tonumber(ReplicatedStorage:GetAttribute("NextEggRushAt")) or 0

	local parts = {}
	if showerUntil > now then
		table.insert(parts, "🌠 SCHAUER " .. Util.FormatTime(showerUntil - now) .. " • KEINE LOCKS")
	end
	if luckUntil > now and luckMult > 1 then
		table.insert(parts, "🍀 " .. UI.FormatMult(luckMult) .. "x GLÜCK " .. Util.FormatTime(luckUntil - now))
	end
	local eventShown = #parts > 0
	if eventShown then
		setPillText(eventPill, table.concat(parts, "   "))
	end
	showPill(eventPill, eventShown)

	local rush = rushUntil > now
	if rush then
		setPillText(eggPill, "🥚 EGG RUSH " .. Util.FormatTime(rushUntil - now) .. " • schnapp dir die Eier!")
	end
	showPill(eggPill, rush)

	local showShowerNext = showerUntil <= now and nextShower > now
	if showShowerNext then
		setPillText(showerNextPill, "🌠 Schauer in " .. Util.FormatTime(nextShower - now))
	end
	showPill(showerNextPill, showShowerNext)
	local showRushNext = not rush and nextRush > now
	if showRushNext then
		setPillText(eggNextPill, "🥚 Egg Rush in " .. Util.FormatTime(nextRush - now))
	end
	showPill(eggNextPill, showRushNext)
	showerTint.Enabled = showerUntil > now

	-- 👻 Umhang aktiv?
	local cloakUntil = tonumber(player:GetAttribute("CloakedUntil")) or 0
	local cloaked = cloakUntil > now
	if cloaked then
		local text = "👻 Unsichtbar – noch " .. math.ceil(cloakUntil - now) .. " s"
		if statusLabel.Text ~= text then
			statusLabel.Text = text
		end
	end
	if statusPill.Visible ~= cloaked then
		statusPill.Visible = cloaked
	end

	local state = ctx.State
	if state then
		updateBadges(state)
		updateStarter(state)
	end
	-- Eingabegerät gewechselt (Tastatur <-> Handy/Controller)? Hinweis neu schreiben
	updateHint()
end

-- Die Map ist da (vom Server gebaut): Wegweiser kann Basen und Eier finden
function Hud.SetMap(map: Instance)
	mapFolder = map
	task.spawn(function()
		groundFolder = map:WaitForChild("GroundMeteors", 60)
	end)
end

-- Kleines Aufploppen, wenn Schritte oder Geld reinkommen
function Hud.PulseSteps()
	UI.Pulse(stepsScale, 0.08)
end

function Hud.PulseCash(amount: number?)
	UI.Pulse(cashScale, amount or 0.14)
end

-- Bildschirm-Punkt des 💵-Symbols am Geld-Zähler (Ziel der fliegenden Münzen), nil = nicht sichtbar
function Hud.CashAnchor(): Vector2?
	local label = cashLabelRef
	if not label or not label.Visible or not ctx.Gui.Enabled then
		return nil
	end
	local size = label.AbsoluteSize
	return label.AbsolutePosition + Vector2.new(size.Y * 0.5, size.Y * 0.5)
end

function Hud.Init(context: any)
	ctx = context
	buildLeft()
	buildRight()
	buildStats()
	buildTop()
	buildBottom()
	RunService.RenderStepped:Connect(stepNav)
	player.CharacterAdded:Connect(function()
		nearestEgg = nil
		homeClock = HOME_SCAN_INTERVAL
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">MeteorRun</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  ☄️ METEOR-RUN (Client)
--   • Run-HUD oben: ⏱️ Timer, 🚩 Checkpoint x/y, 🏆 Bestzeit (nur während eines Runs)
--   • rotierende Balken: jeder Client dreht sie selbst (Attribute vom Server, Winkel aus der
--     Serverzeit -> alle sehen dieselbe Stellung), mit lokaler Kollision
--   • Warnkreise + fallender Meteor + Einschlag für "RunImpact"
--   • Checkpoint-Funken + Ton, Ziel-Konfetti, roter Blitz beim Zurücksetzen
--   • Knopf "☄️ Run" in der rechten Leiste -> Request "GoRun"
--  Der Server schickt den Zustand als Spieler-Attribute (RunActive, RunStart, RunCP, RunBest,
--  RunCooldownUntil) und Effekte über Remotes.Effect ("RunImpact", "RunCheckpoint", ...).
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local MeteorRun = {}

local player = Players.LocalPlayer
local ctx: any = nil
local Theme = UI.Theme
local BLACK = Color3.new(0, 0, 0)

local TAU = 2 * math.pi
local ANIM_RANGE = 420 -- weiter weg dreht sich nichts (spart Rechenzeit)
local IMPACT_POOL = 8 -- so viele Warnkreise gleichzeitig
local IMPACT_FALL_HEIGHT = 70 -- von hier fällt der Meteor in den Warnkreis
local IMPACT_WARN = 1 -- Sekunden (wie beim Server)
local FINISH_SHOW_TIME = 5 -- so lange bleibt die Zielzeit im HUD stehen
local PING_SOUND = "rbxasset://sounds/electronicpingshort.wav"

local HUD_POP_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local HUD_HIDE_INFO = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local FLASH_INFO = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local CHECKPOINT_COLOR = Color3.fromRGB(80, 200, 255)
local CHECKPOINT_DONE_COLOR = Color3.fromRGB(90, 255, 120)
local WARN_COLOR = Color3.fromRGB(255, 40, 40)

-- 41.27 -> "0:41.3"
local function formatRunTime(seconds: number): string
	local tenths = math.floor(math.max(0, seconds) * 10 + 0.5)
	return string.format("%d:%04.1f", tenths // 600, (tenths % 600) / 10)
end

local function localPart(props: { [string]: any }): Part
	local base: { [string]: any } = {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	}
	for key, value in pairs(props) do
		base[key] = value
	end
	return UI.Create("Part", base)
end

-- ---------------------------------------------------------------------
-- HUD
-- ---------------------------------------------------------------------
local hudFrame: Frame
local hudScale: UIScale
local timerLabel: TextLabel
local cpLabel: TextLabel
local bestLabel: TextLabel
local subLabel: TextLabel
local flashFrame: Frame
local flashTween: Tween
local hudShown = false
local hudToken = 0
local lastTimerKey = -1
local checkpointCount = 4
local finishedText: string? = nil
local finishedUntil = 0

local function buildHud()
	hudFrame = UI.Create("Frame", {
		Name = "MeteorRunHud",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 54), -- unter den Bannern (Schauer, Egg Rush)
		Size = UDim2.fromOffset(420, 66),
		BackgroundColor3 = Theme.PanelDark,
		BackgroundTransparency = 0.1,
		Visible = false,
		ZIndex = 6,
		Parent = ctx.Gui,
	}, {
		UI.Corner(16),
		UI.Stroke(BLACK, 3),
		UI.Create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.fromRGB(255, 170, 120), Color3.fromRGB(150, 110, 255)),
			Transparency = NumberSequence.new(0.55),
		}),
	})
	hudScale = UI.Create("UIScale", { Scale = 0, Parent = hudFrame })
	timerLabel = UI.Label({
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(0.44, -12, 0, 38),
		Text = "⏱️ 0:00.0",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Yellow,
		MaxText = 32,
		Outline = 3,
		ZIndex = 7,
		Parent = hudFrame,
	})
	cpLabel = UI.Label({
		Position = UDim2.new(0.44, 0, 0, 8),
		Size = UDim2.new(0.24, 0, 0, 30),
		Text = "🚩 0/4",
		TextColor3 = Color3.fromRGB(140, 230, 255),
		MaxText = 24,
		Outline = 2,
		ZIndex = 7,
		Parent = hudFrame,
	})
	bestLabel = UI.Label({
		Position = UDim2.new(0.68, 0, 0, 8),
		Size = UDim2.new(0.32, -12, 0, 30),
		Text = "🏆 –",
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Color3.fromRGB(255, 230, 120),
		MaxText = 24,
		Outline = 2,
		ZIndex = 7,
		Parent = hudFrame,
	})
	subLabel = UI.Label({
		Position = UDim2.fromOffset(12, 42),
		Size = UDim2.new(1, -24, 0, 20),
		Text = "",
		TextColor3 = Theme.SubText,
		MaxText = 16,
		Outline = 2,
		ZIndex = 7,
		Parent = hudFrame,
	})
	-- roter Blitz beim Zurücksetzen (Lava, Runterfallen, Einschlag)
	flashFrame = UI.Create("Frame", {
		Name = "MeteorRunFlash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 60, 30),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = ctx.Gui,
	})
	flashTween = TweenService:Create(flashFrame, FLASH_INFO, { BackgroundTransparency = 1 })
end

local function showHud(show: boolean)
	if hudShown == show then
		return
	end
	hudShown = show
	hudToken += 1
	local token = hudToken
	if show then
		hudFrame.Visible = true
		hudScale.Scale = 0.5
		TweenService:Create(hudScale, HUD_POP_INFO, { Scale = 1 }):Play()
	else
		local tween = TweenService:Create(hudScale, HUD_HIDE_INFO, { Scale = 0 })
		tween.Completed:Connect(function()
			if hudToken == token then
				hudFrame.Visible = false
			end
		end)
		tween:Play()
	end
end

local function setText(label: TextLabel, text: string)
	if label.Text ~= text then
		label.Text = text
	end
end

-- Attribute -> HUD (Checkpoint, Bestzeit, Abklingzeit); der Timer läuft in stepHud
local function refreshHud()
	local active = player:GetAttribute("RunActive") == true
	local cp = tonumber(player:GetAttribute("RunCP")) or 0
	local best = tonumber(player:GetAttribute("RunBest")) or 0
	setText(cpLabel, ("🚩 %d/%d"):format(cp, checkpointCount))
	setText(bestLabel, if best > 0 then "🏆 " .. formatRunTime(best) else "🏆 –")
	lastTimerKey = -1
	showHud(active or os.clock() < finishedUntil)
end

local function subText(now: number): string
	local cooldown = tonumber(player:GetAttribute("RunCooldownUntil")) or 0
	if cooldown > now then
		return "⏳ Nächste Belohnung in " .. ctx.Util.FormatTime(math.ceil(cooldown - now))
	end
	return "🥚 Im Ziel wartet ein Gratis-Ei!"
end

local function stepHud()
	if not hudShown then
		return
	end
	local now = workspace:GetServerTimeNow()
	local active = player:GetAttribute("RunActive") == true
	local start = tonumber(player:GetAttribute("RunStart")) or 0
	local key: number
	if active and start > 0 then
		key = math.floor((now - start) * 10)
	elseif active then
		key = -2
	else
		key = -3
	end
	if key == lastTimerKey then
		return
	end
	lastTimerKey = key
	if key >= 0 then
		timerLabel.Text = "⏱️ " .. formatRunTime(now - start)
		timerLabel.TextColor3 = Theme.Yellow
	elseif key == -2 then
		timerLabel.Text = "☄️ BEREIT – los!"
		timerLabel.TextColor3 = Theme.Green
	else
		timerLabel.Text = finishedText or "🏁"
		timerLabel.TextColor3 = Theme.Gold
		if os.clock() >= finishedUntil then
			showHud(false)
		end
	end
	setText(subLabel, subText(now))
end

-- ---------------------------------------------------------------------
-- ROTIERENDE BALKEN + SCHWEBENDES BELOHNUNGS-EI
-- ---------------------------------------------------------------------
type Spinner = { Pivot: CFrame, Offset: CFrame, Axis: Vector3, Speed: number, T0: number }

local animParts: { BasePart } = {} -- für workspace:BulkMoveTo (Tabellen werden wiederverwendet)
local animCFrames: { CFrame } = {}
local spinners: { Spinner } = {}
local eggPart: BasePart? = nil
local eggBase = CFrame.new()
local animCenter = Vector3.zero
local animRadius = 0

local function addSpinner(bar: BasePart)
	local pivot = bar:GetAttribute("SpinPivot")
	local axis = bar:GetAttribute("SpinAxis")
	local speed = tonumber(bar:GetAttribute("SpinSpeed"))
	local t0 = tonumber(bar:GetAttribute("SpinT0"))
	if typeof(pivot) ~= "CFrame" or typeof(axis) ~= "Vector3" or not speed or not t0 then
		return
	end
	local unitAxis = if axis.Magnitude > 0 then axis.Unit else Vector3.yAxis
	table.insert(spinners, {
		Pivot = pivot,
		Offset = pivot:ToObjectSpace(bar.CFrame), -- Stellung zur Zeit T0 (so steht er auf dem Server)
		Axis = unitAxis,
		Speed = speed,
		T0 = t0,
	})
	table.insert(animParts, bar)
	table.insert(animCFrames, bar.CFrame)
	-- Drehung auch für die Physik: wer getroffen wird, wird mitgeschoben (nur lokal)
	bar.AssemblyAngularVelocity = pivot:VectorToWorldSpace(unitAxis) * speed
end

local function setupWorld(runFolder: Instance)
	checkpointCount = tonumber(runFolder:GetAttribute("CheckpointCount")) or checkpointCount
	local spinnerFolder = runFolder:WaitForChild("Spinners", 30)
	if spinnerFolder then
		for _, child in ipairs(spinnerFolder:GetChildren()) do
			if child:IsA("BasePart") then
				addSpinner(child)
			end
		end
	end
	local deco = runFolder:WaitForChild("Deco", 30)
	local egg = deco and deco:FindFirstChild("RewardEgg")
	if egg and egg:IsA("BasePart") then
		eggPart = egg
		eggBase = egg.CFrame
		table.insert(animParts, egg)
		table.insert(animCFrames, egg.CFrame)
	end
	-- grobe Vorab-Prüfung: Kreis um alles, was sich bewegt
	if #animParts > 0 then
		local sum = Vector3.zero
		for _, p in ipairs(animParts) do
			sum += p.Position
		end
		animCenter = sum / #animParts
		for _, p in ipairs(animParts) do
			animRadius = math.max(animRadius, (p.Position - animCenter).Magnitude)
		end
	end
	refreshHud()
end

local function stepSpinners()
	local count = #animParts
	if count == 0 then
		return
	end
	local camera = workspace.CurrentCamera
	if not camera or (camera.CFrame.Position - animCenter).Magnitude > animRadius + ANIM_RANGE then
		return
	end
	local now = workspace:GetServerTimeNow()
	for i, spin in ipairs(spinners) do
		animCFrames[i] = spin.Pivot
			* CFrame.fromAxisAngle(spin.Axis, ((now - spin.T0) * spin.Speed) % TAU)
			* spin.Offset
	end
	if eggPart then
		animCFrames[count] = eggBase * CFrame.new(0, math.sin(now * 2) * 0.4, 0) * CFrame.Angles(0, now * 1.2, 0)
	end
	workspace:BulkMoveTo(animParts, animCFrames, Enum.BulkMoveMode.FireCFrameChanged)
end

-- ---------------------------------------------------------------------
-- WARNKREISE + EINSCHLÄGE
-- ---------------------------------------------------------------------
type Impact = {
	Disc: Part,
	Ring: Part,
	Rock: Part,
	Active: boolean,
	At: number,
	Position: Vector3,
	Radius: number,
}

local fxFolder: Folder
local impacts: { Impact } = {}
local activeImpacts = 0
local DISC_ROTATION = CFrame.Angles(0, 0, math.rad(90))
local HIDDEN = CFrame.new(0, -500, 0)

local function buildImpactPool()
	for _ = 1, IMPACT_POOL do
		local disc = localPart({
			Name = "RunWarn",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.12, 2, 2),
			Material = Enum.Material.Neon,
			Color = WARN_COLOR,
			Transparency = 1,
			CFrame = HIDDEN,
			Parent = fxFolder,
		})
		local ring = localPart({
			Name = "RunWarnRing",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.08, 2, 2),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 220, 60),
			Transparency = 1,
			CFrame = HIDDEN,
			Parent = fxFolder,
		})
		local rock = localPart({
			Name = "RunMeteor",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(3.4, 3.4, 3.4),
			Material = Enum.Material.CrackedLava,
			Color = Color3.fromRGB(255, 110, 40),
			Transparency = 1,
			CFrame = HIDDEN,
			Parent = fxFolder,
		})
		UI.Create("Trail", {
			Attachment0 = UI.Create("Attachment", { Position = Vector3.new(0, 1.2, 0), Parent = rock }),
			Attachment1 = UI.Create("Attachment", { Position = Vector3.new(0, -1.2, 0), Parent = rock }),
			Color = ColorSequence.new(Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 60, 20)),
			Transparency = NumberSequence.new(0.1, 1),
			Lifetime = 0.25,
			LightEmission = 1,
			Parent = rock,
		})
		table.insert(impacts, {
			Disc = disc,
			Ring = ring,
			Rock = rock,
			Active = false,
			At = 0,
			Position = Vector3.zero,
			Radius = 6,
		})
	end
end

local function hideImpact(impact: Impact)
	impact.Active = false
	activeImpacts -= 1
	impact.Disc.Transparency = 1
	impact.Ring.Transparency = 1
	impact.Rock.Transparency = 1
	impact.Disc.CFrame = HIDDEN
	impact.Ring.CFrame = HIDDEN
	impact.Rock.CFrame = HIDDEN
end

local function startImpact(data: any)
	if type(data) ~= "table" or typeof(data.Position) ~= "Vector3" then
		return
	end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - data.Position).Magnitude > ANIM_RANGE + 100 then
		return -- viel zu weit weg
	end
	-- freien Platz im Pool nehmen, sonst den ältesten
	local slot: Impact? = nil
	for _, impact in ipairs(impacts) do
		if not impact.Active then
			slot = impact
			break
		end
		if not slot or impact.At < slot.At then
			slot = impact
		end
	end
	if not slot then
		return
	end
	if slot.Active then
		hideImpact(slot)
	end
	slot.Active = true
	activeImpacts += 1
	slot.At = tonumber(data.At) or (workspace:GetServerTimeNow() + IMPACT_WARN)
	slot.Position = data.Position
	slot.Radius = tonumber(data.Radius) or 6
	local diameter = slot.Radius * 2
	slot.Ring.Size = Vector3.new(0.08, diameter, diameter)
	slot.Ring.CFrame = CFrame.new(data.Position + Vector3.new(0, 0.06, 0)) * DISC_ROTATION
	slot.Ring.Transparency = 0.2
	slot.Rock.Transparency = 0
end

local function stepImpacts()
	if activeImpacts <= 0 then
		return
	end
	local now = workspace:GetServerTimeNow()
	for _, impact in ipairs(impacts) do
		if impact.Active then
			local left = impact.At - now
			if left <= 0 then
				hideImpact(impact)
				local position = impact.Position
				ctx.Effects.Play("Hatch", 0, { Position = position + Vector3.new(0, 1, 0), Rarity = "Mythic" })
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") and (root.Position - position).Magnitude < impact.Radius * 3 then
					ctx.Effects.Play("Shake", 0.7)
				end
			else
				local progress = math.clamp(1 - left / IMPACT_WARN, 0, 1)
				local diameter = impact.Radius * 2 * (0.25 + 0.75 * progress)
				impact.Disc.Size = Vector3.new(0.12, diameter, diameter)
				impact.Disc.CFrame = CFrame.new(impact.Position + Vector3.new(0, 0.08, 0)) * DISC_ROTATION
				impact.Disc.Transparency = 0.25 + 0.25 * math.abs(math.sin(progress * math.pi * 4))
				local fall = (1 - progress) * (1 - progress)
				impact.Rock.CFrame =
					CFrame.new(impact.Position + Vector3.new(fall * 18, 1.7 + fall * IMPACT_FALL_HEIGHT, 0))
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- CHECKPOINT-, START-, ZIEL- UND RESET-EFFEKTE
-- ---------------------------------------------------------------------
local sparkHolder: Part
local sparkEmitter: ParticleEmitter
local pingSound: Sound
local checkpointPads: { [number]: BasePart } = {}

local function buildEffects()
	sparkHolder = localPart({
		Name = "RunSparks",
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
		CFrame = HIDDEN,
		Parent = fxFolder,
	})
	sparkEmitter = UI.Create("ParticleEmitter", {
		Color = ColorSequence.new(CHECKPOINT_COLOR, CHECKPOINT_DONE_COLOR),
		LightEmission = 1,
		LightInfluence = 0,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new(0, 1),
		Lifetime = NumberRange.new(0.6, 1.1),
		Speed = NumberRange.new(14, 28),
		SpreadAngle = Vector2.new(60, 60),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -30, 0),
		Drag = 1.5,
		Rate = 0,
		Parent = sparkHolder,
	})
	-- Sound direkt im Ordner (nicht in einem Part) = überall gleich laut
	pingSound = UI.Create("Sound", { SoundId = PING_SOUND, Volume = 0.6, Parent = fxFolder })
end

local function ping(pitch: number)
	pingSound.PlaybackSpeed = pitch
	pingSound.TimePosition = 0
	pingSound:Play()
end

local function sparks(position: Vector3, amount: number)
	sparkHolder.CFrame = CFrame.new(position)
	sparkEmitter:Emit(amount)
end

-- Erreichte Checkpoints leuchten lokal grün
local function colorPads()
	local active = player:GetAttribute("RunActive") == true
	local cp = if active then tonumber(player:GetAttribute("RunCP")) or 0 else 0
	for index, pad in pairs(checkpointPads) do
		local color = if index <= cp then CHECKPOINT_DONE_COLOR else CHECKPOINT_COLOR
		if pad.Color ~= color then
			pad.Color = color
		end
	end
end

local function onEffect(name: any, strength: any, data: any)
	if name == "RunImpact" then
		startImpact(data)
	elseif name == "RunCheckpoint" then
		local position = type(data) == "table" and typeof(data.Position) == "Vector3" and data.Position or nil
		if position then
			sparks(position, 60)
		end
		ping(1.2)
		UI.Pulse(hudScale, 0.12)
		local time = type(data) == "table" and tonumber(data.Time)
		ctx.Toast(
			"🚩 Checkpoint "
				.. tostring(tonumber(strength) or 0)
				.. "/"
				.. checkpointCount
				.. (if time then "  ⏱️ " .. formatRunTime(time) else ""),
			"Success"
		)
	elseif name == "RunStart" then
		ping(1.5)
		UI.Pulse(hudScale, 0.15)
	elseif name == "RunReset" then
		ping(0.6)
		flashFrame.BackgroundTransparency = 0.55
		flashTween:Play()
		ctx.Effects.Play("Shake", 0.5)
	elseif name == "RunFinish" then
		local info = if type(data) == "table" then data else {}
		local time = tonumber(info.Time) or tonumber(strength) or 0
		finishedText = "🏁 " .. formatRunTime(time) .. (if info.NewBest == true then "  🏆 NEU!" else "")
		finishedUntil = os.clock() + FINISH_SHOW_TIME
		ping(1.8)
		task.delay(0.15, ping, 2.2)
		ctx.Effects.Play("Confetti", if info.Reward == true then 2.5 else 1.2)
		local egg = eggPart
		if egg then
			ctx.Effects.Play("Hatch", 0, { Position = egg.Position, Rarity = "Legendary" })
			sparks(egg.Position, 80)
		end
		refreshHud()
		task.delay(FINISH_SHOW_TIME + 0.1, refreshHud)
	end
end

-- ---------------------------------------------------------------------
-- START
-- ---------------------------------------------------------------------
function MeteorRun.Start(context: any)
	ctx = context
	buildHud()
	fxFolder = UI.Create("Folder", { Name = "MeteorRunClientFX", Parent = workspace })
	buildImpactPool()
	buildEffects()

	-- Knopf rechts (gleicher Stil wie die anderen): zum Start-Tor
	ctx.Hud.AddRightButton("☄️", "Run", Theme.Orange, 7, function()
		ctx.Request("GoRun")
	end)

	for _, attribute in ipairs({ "RunActive", "RunStart", "RunCP", "RunBest", "RunCooldownUntil" }) do
		player:GetAttributeChangedSignal(attribute):Connect(function()
			refreshHud()
			colorPads()
		end)
	end
	ctx.Remotes.Effect.OnClientEvent:Connect(onEffect)

	RunService.RenderStepped:Connect(function()
		stepSpinners()
		stepImpacts()
		stepHud()
	end)

	-- Welt-Teile kommen vom Server (Map wird beim Serverstart gebaut)
	task.spawn(function()
		local map = workspace:WaitForChild("MeteorHeistMap", 120)
		local runFolder = map and map:WaitForChild("MeteorRun", 60)
		if not runFolder then
			warn("[MeteorRun] Strecke nicht gefunden – Run-Animationen aus")
			return
		end
		local pads = runFolder:WaitForChild("Checkpoints", 30)
		if pads then
			for _, pad in ipairs(pads:GetChildren()) do
				local index = pad:GetAttribute("CheckpointIndex")
				if pad:IsA("BasePart") and type(index) == "number" then
					checkpointPads[index] = pad
				end
			end
		end
		setupWorld(runFolder)
		colorPads()
	end)
	refreshHud()
end

return MeteorRun
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">PhotoMode</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  FOTO-MODUS (Taste H, nur Admins) – für schöne Thumbnail-Screenshots.
--  Rein clientseitig: blendet die eigene UI, die Roblox-Oberfläche, fliegende Zahlen
--  und alle Prompts aus. Nochmal H = alles wieder an.
-- =====================================================================

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))

local PhotoMode = {}

local player = Players.LocalPlayer
local ctx: any = nil

local photoMode = false
local photoPending = false -- Toast wird gezeigt, gleich wird ausgeblendet
local photoToken = 0
local photoHidden: { [ProximityPrompt]: boolean } = {} -- Prompts, die der Foto-Modus ausgeschaltet hat
local photoConnections: { RBXScriptConnection } = {}
local savedCoreGui: { [Enum.CoreGuiType]: boolean } = {}

local function hidePrompt(prompt: ProximityPrompt)
	local function off()
		if photoMode and prompt.Enabled then
			photoHidden[prompt] = true
			prompt.Enabled = false
		end
	end
	off()
	-- Der Server schaltet Prompts evtl. wieder ein -> sofort wieder aus
	table.insert(photoConnections, prompt:GetPropertyChangedSignal("Enabled"):Connect(off))
end

local function startPhotoMode()
	photoMode = true
	UI.CloseAll() -- offene Fenster zu, damit sie nach dem Foto nicht im Weg sind
	ctx.Gui.Enabled = false
	ctx.Prompts.SetPhotoMode(true)
	ctx.Effects.SetHidden(true)
	-- Roblox-Oberfläche (Chat, Spielerliste, Rucksack ...) merken und ausblenden
	savedCoreGui = {}
	for _, item in ipairs(Enum.CoreGuiType:GetEnumItems()) do
		if item ~= Enum.CoreGuiType.All then
			local ok, enabled = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, item)
			-- Nicht lesbar -> beim Beenden trotzdem wieder einschalten (sonst bliebe es für immer aus)
			savedCoreGui[item] = not ok or enabled == true
		end
	end
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.All, false)
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("ProximityPrompt") then
			hidePrompt(inst)
		end
	end
	table.insert(
		photoConnections,
		workspace.DescendantAdded:Connect(function(inst)
			if inst:IsA("ProximityPrompt") then
				hidePrompt(inst)
			end
		end)
	)
end

local function stopPhotoMode()
	photoMode = false
	for _, connection in ipairs(photoConnections) do
		connection:Disconnect()
	end
	photoConnections = {}
	ctx.Gui.Enabled = true
	ctx.Effects.SetHidden(false)
	for item, enabled in pairs(savedCoreGui) do
		pcall(StarterGui.SetCoreGuiEnabled, StarterGui, item, enabled)
	end
	-- Kaufen-Prompts wieder an (der Server prüft beim Kaufen ohnehin alles),
	-- Klauen/Verkaufen stellt das Prompts-Modul wieder richtig ein.
	for prompt in pairs(photoHidden) do
		if prompt.Parent and not ctx.Prompts.IsTracked(prompt) then
			prompt.Enabled = true
		end
	end
	photoHidden = {}
	ctx.Prompts.SetPhotoMode(false)
end

function PhotoMode.Toggle()
	if photoMode or photoPending then
		photoToken += 1
		photoPending = false
		if photoMode then
			stopPhotoMode()
			ctx.Toast("📸 Foto-Modus aus", "Info")
		end
		return
	end
	if player:GetAttribute("IsAdmin") ~= true then
		return
	end
	photoPending = true
	photoToken += 1
	local token = photoToken
	ctx.Toast("📸 Foto-Modus: H drücken zum Beenden", "Info")
	task.delay(1.5, function()
		if photoPending and photoToken == token then
			photoPending = false
			startPhotoMode()
		end
	end)
end

function PhotoMode.Init(context: any)
	ctx = context
	-- Funktioniert auch bei versteckter UI, aber nicht beim Tippen in einer TextBox
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.KeyCode ~= Enum.KeyCode.H or UserInputService:GetFocusedTextBox() then
			return
		end
		PhotoMode.Toggle()
	end)
end

return PhotoMode
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Prompts</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  PROMPTS passend ein-/ausblenden:
--   in den Basen:
--     "Klauen" (StealPrompt)     nur bei FREMDEN Basen, die nicht gesperrt sind
--     "Verkaufen" (SellPrompt)   nur in deiner EIGENEN Base
--   am Förderband / am Boden (Ordner BeltMeteors, GroundMeteors):
--     "Klauen"/"Schnappen" (GrabPrompt)  aus, solange du schon etwas trägst
--     "Kaufen" (BuyPrompt)               immer an (wird automatisch geliefert)
--  Dazu: Hinweis unten im HUD, solange ein Förderband-/Boden-Prompt sichtbar ist
--  (E = Klauen gratis, F = Kaufen). Der Server prüft beim Auslösen trotzdem alles.
--  Halte-Sperre: Wer E an einem Band-Meteor hält, dem springt der Prompt nicht zum nächsten Meteor.
--  Eingefroren (Falle / Admin): Klauen und Schnappen sind aus.
-- =====================================================================

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Prompts = {}

local player = Players.LocalPlayer
local UPDATE_INTERVAL = 0.3

local ctx: any = nil

-- Prompt -> Base-Model (oder false, wenn keine Base gefunden wurde)
local tracked: { [ProximityPrompt]: Instance | false } = {}
-- GrabPrompts an Förderband-Meteoren und Eiern am Boden -> true = von UNS ausgeschaltet
-- (nur die schalten wir später wieder ein; sonst gilt, was der Server eingestellt hat)
local grabPrompts: { [ProximityPrompt]: boolean } = {}
-- Gerade sichtbare Förderband-/Boden-Prompts -> Art ("Belt", "Ground", "Free")
local shownPrompts: { [ProximityPrompt]: string } = {}
local photoMode = false
local carrying = false
local frozen = false -- eigener HumanoidRootPart verankert (Falle / Admin-Freeze)
local tipShown = false

-- Klauen am Förderband: Während E gehalten wird (Config.BeltGrabHold), fährt das Band weiter.
-- Roblox könnte dann zum nächsten Meteor wechseln und das Halten abbrechen -> solange die
-- ANDEREN GrabPrompts lokal aus. Spätestens nach HOLD_SAFETY Sekunden ist alles wieder normal.
local HOLD_SAFETY = 3
local HOLD_RELEASE_AFTER_TRIGGER = 0.8 -- bis der Server "trägt" meldet (dann bleiben sie sowieso aus)
local HOLD_RELEASE_AFTER_CANCEL = 0.1
local holdPrompt: ProximityPrompt? = nil
local holdTriggered = false
local holdDisabled: { [ProximityPrompt]: boolean } = {}
local holdToken = 0

-- Base finden: das Base-Model hat die Attribute PlotIndex, OwnerUserId und LockedUntil.
-- (Meteore/Aliens im Slot tragen auch PlotIndex + OwnerUserId, aber NICHT LockedUntil –
--  deshalb zuerst nach LockedUntil suchen, sonst wüssten wir nicht, ob die Base gesperrt ist.)
local function findPlot(inst: Instance): Instance?
	local fallback: Instance? = nil
	local current = inst.Parent
	while current and current ~= workspace do
		if current:GetAttribute("LockedUntil") ~= nil then
			return current
		end
		if not fallback and current:GetAttribute("PlotIndex") ~= nil then
			fallback = current
		end
		current = current.Parent
	end
	return fallback
end

local function setEnabled(prompt: ProximityPrompt, enabled: boolean)
	if prompt.Enabled ~= enabled then
		prompt.Enabled = enabled
	end
end

-- Pro Durchlauf merken wir uns je Base "gehört mir?" und "gesperrt?" (statt pro Prompt neu zu fragen)
local mineCache: { [Instance]: boolean } = {}
local lockedCache: { [Instance]: boolean } = {}

local function plotStatus(plot: Instance): (boolean, boolean)
	local isMine = mineCache[plot]
	local locked = lockedCache[plot]
	if isMine == nil or locked == nil then
		isMine = plot:GetAttribute("OwnerUserId") == player.UserId
		local lockedUntil = tonumber(plot:GetAttribute("LockedUntil")) or 0
		locked = lockedUntil > workspace:GetServerTimeNow()
		mineCache[plot] = isMine
		lockedCache[plot] = locked
	end
	return isMine == true, locked == true
end

local function updatePrompt(prompt: ProximityPrompt, plot: Instance | false)
	if photoMode then
		setEnabled(prompt, false)
		return
	end
	if not plot then
		return
	end
	local isMine, locked = plotStatus(plot)
	if prompt.Name == "SellPrompt" then
		setEnabled(prompt, isMine)
	elseif prompt.Name == "StealPrompt" then
		setEnabled(prompt, not isMine and not locked and not carrying and not frozen)
	end
end

local function isFrozen(): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root ~= nil and root:IsA("BasePart") and root.Anchored
end

local function track(inst: Instance)
	if inst:IsA("ProximityPrompt") and (inst.Name == "SellPrompt" or inst.Name == "StealPrompt") then
		if tracked[inst] ~= nil then
			return
		end
		local plot = findPlot(inst) or false
		tracked[inst] = plot
		-- frisch nachsehen (der Zwischenspeicher könnte vom letzten Durchlauf sein)
		table.clear(mineCache)
		table.clear(lockedCache)
		updatePrompt(inst, plot)
	end
end

-- Liegt der Prompt an einem Meteor auf dem Förderband / am Boden? -> "Belt" / "Ground" / nil
local function meteorFolderKind(prompt: Instance): string?
	local part = prompt.Parent
	local folder = part and part.Parent
	if not folder then
		return nil
	end
	if folder.Name == "BeltMeteors" then
		return "Belt"
	elseif folder.Name == "GroundMeteors" then
		return "Ground"
	end
	return nil
end

-- Art des Hinweises: Förderband, Ei am Boden (tragen) oder Gratis-Zone (automatische Lieferung)
local function hintKind(prompt: ProximityPrompt): string?
	local kind = meteorFolderKind(prompt)
	if kind == "Ground" and prompt.Name == "BuyPrompt" then
		return "Free"
	end
	if kind and (prompt.Name == "GrabPrompt" or prompt.Name == "BuyPrompt") then
		return kind
	end
	return nil
end

local function updateGrab(prompt: ProximityPrompt)
	if photoMode or carrying or frozen then
		-- auch merken, wenn er schon aus war (z.B. vom Foto-Modus) -> später sicher wieder an
		grabPrompts[prompt] = true
		setEnabled(prompt, false)
	elseif grabPrompts[prompt] then
		grabPrompts[prompt] = false
		if not holdDisabled[prompt] then
			setEnabled(prompt, true)
		end
	end
end

-- Halte-Sperre aufheben: nur wieder einschalten, was WIR wegen des Haltens ausgeschaltet haben
-- (und was nicht inzwischen wegen Tragen/Foto-Modus aus sein soll)
local function releaseHold()
	holdPrompt = nil
	holdTriggered = false
	holdToken += 1
	for prompt in pairs(holdDisabled) do
		holdDisabled[prompt] = nil
		if
			prompt:IsDescendantOf(workspace)
			and not photoMode
			and not carrying
			and not frozen
			and grabPrompts[prompt] == false
		then
			setEnabled(prompt, true)
		end
	end
end

local function scheduleRelease(delay: number)
	holdToken += 1
	local token = holdToken
	task.delay(delay, function()
		if holdToken == token then
			releaseHold()
		end
	end)
end

-- Einen GrabPrompt wegen des Haltens ausschalten (nur wenn er gerade an ist)
local function holdOff(prompt: ProximityPrompt)
	if prompt ~= holdPrompt and prompt.Enabled then
		holdDisabled[prompt] = true
		prompt.Enabled = false
	end
end

-- Förderband-Meteore werden lokal bewegt (der Server lässt sie am Bandstart stehen) ->
-- echte Reichweite steht im Attribut "ClientMaxDistance" und wird hier lokal eingestellt.
-- Der Server setzt das Attribut schon, bevor der Meteor in die Map kommt -> einmal lesen reicht
-- (keine Verbindung pro Meteor = kein Speicherleck).
local function watchReach(inst: Instance)
	if not inst:IsA("ProximityPrompt") or inst.Name == "SellPrompt" or inst.Name == "StealPrompt" then
		return
	end
	local reach = tonumber(inst:GetAttribute("ClientMaxDistance"))
	if reach and reach > 0 and inst.MaxActivationDistance ~= reach then
		inst.MaxActivationDistance = reach
	end
	if inst.Name == "GrabPrompt" and grabPrompts[inst] == nil and meteorFolderKind(inst) then
		grabPrompts[inst] = false
		updateGrab(inst)
		if holdPrompt then
			holdOff(inst) -- neuer Meteor während des Haltens -> auch aus
		end
	end
end

-- Welcher Hinweis gilt gerade? Förderband vor Boden vor Gratis-Zone
local HINT_PRIORITY: { [string]: number } = { Belt = 3, Ground = 2, Free = 1 }

local function refreshHint()
	if not ctx then
		return
	end
	local best: string? = nil
	for prompt, kind in pairs(shownPrompts) do
		if not prompt.Enabled or not prompt:IsDescendantOf(workspace) then
			shownPrompts[prompt] = nil
		elseif not best or HINT_PRIORITY[kind] > HINT_PRIORITY[best] then
			best = kind
		end
	end
	ctx.Hud.SetPromptHint(if photoMode then nil else best)
end

function Prompts.UpdateAll()
	table.clear(mineCache)
	table.clear(lockedCache)
	frozen = isFrozen()
	-- Sicherheitsnetz für die Halte-Sperre: der gehaltene Meteor ist weg (geklaut, gekauft, Bandende)
	-- und Roblox hat kein "losgelassen" mehr gemeldet -> sofort freigeben statt erst nach HOLD_SAFETY
	local held = holdPrompt
	if held and not holdTriggered and not held:IsDescendantOf(workspace) then
		releaseHold()
	end
	for prompt, plot in pairs(tracked) do
		-- IsDescendantOf statt Parent: wird nur das Alien-Model zerstört, behält der Prompt
		-- (je nach Destroy-Replikation) seinen Parent – er hängt dann aber nicht mehr in der Welt.
		if prompt:IsDescendantOf(workspace) then
			-- Base noch unbekannt (Prompt kam vor der Base an)? Nochmal suchen
			if not plot then
				plot = findPlot(prompt) or false
				tracked[prompt] = plot
			end
			updatePrompt(prompt, plot)
		else
			tracked[prompt] = nil
		end
	end
	for prompt in pairs(grabPrompts) do
		if prompt:IsDescendantOf(workspace) then
			-- Der Server schaltet Prompts beim Landen ein -> beim Tragen hier wieder aus
			updateGrab(prompt)
		else
			grabPrompts[prompt] = nil
		end
	end
	refreshHint()
end

-- Gehört dieser Prompt zu den Prompts, die dieses Modul ein-/ausschaltet? (für den Foto-Modus)
function Prompts.IsTracked(prompt: ProximityPrompt): boolean
	return tracked[prompt] ~= nil or grabPrompts[prompt] ~= nil
end

function Prompts.SetPhotoMode(enabled: boolean)
	photoMode = enabled
	Prompts.UpdateAll()
end

function Prompts.OnState(state: any)
	local now = state ~= nil and state.Carrying == true
	if now ~= carrying then
		carrying = now
		Prompts.UpdateAll()
	end
end

function Prompts.Init(map: Instance, context: any)
	ctx = context
	for _, inst in ipairs(map:GetDescendants()) do
		watchReach(inst)
	end
	map.DescendantAdded:Connect(watchReach)

	-- Hinweis im HUD, solange ein Förderband-/Boden-Prompt in Reichweite angezeigt wird
	ProximityPromptService.PromptShown:Connect(function(prompt)
		local kind = hintKind(prompt)
		if kind then
			shownPrompts[prompt] = kind
			refreshHint()
			if kind == "Belt" and not tipShown and ctx then
				tipShown = true
				ctx.Toast(
					"💡 Klauen ist GRATIS – aber du musst das Ei selbst heimtragen! Kaufen = Lieferung.",
					"Info"
				)
			end
		end
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt)
		if shownPrompts[prompt] then
			shownPrompts[prompt] = nil
			refreshHint()
		end
		-- Der gehaltene Prompt verschwindet (Meteor geklaut/gekauft/am Bandende, außer Reichweite):
		-- Halte-Sperre gleich aufheben, sonst kann man bis zu HOLD_SAFETY Sekunden nichts schnappen
		if prompt == holdPrompt and not holdTriggered then
			scheduleRelease(HOLD_RELEASE_AFTER_CANCEL)
		end
	end)

	-- Halte-Sperre am Förderband (siehe oben): E auf einem Band-Meteor halten -> andere GrabPrompts aus
	ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
		if prompt.Name ~= "GrabPrompt" or meteorFolderKind(prompt) ~= "Belt" or photoMode or carrying or frozen then
			return
		end
		releaseHold()
		holdPrompt = prompt
		for other in pairs(grabPrompts) do
			holdOff(other)
		end
		scheduleRelease(HOLD_SAFETY)
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt == holdPrompt then
			holdTriggered = true
			scheduleRelease(HOLD_RELEASE_AFTER_TRIGGER)
		end
	end)
	ProximityPromptService.PromptButtonHoldEnded:Connect(function(prompt)
		-- losgelassen (oder fertig): kurz warten – kommt gleich noch "Triggered", gilt dessen Zeit
		if prompt == holdPrompt and not holdTriggered then
			scheduleRelease(HOLD_RELEASE_AFTER_CANCEL)
		end
	end)

	task.spawn(function()
		-- Basen liegen im Ordner "Plots"; falls es ihn nicht gibt, die ganze Map beobachten
		local container: Instance = map:WaitForChild("Plots", 15) or map
		for _, inst in ipairs(container:GetDescendants()) do
			track(inst)
		end
		container.DescendantAdded:Connect(track)
		while true do
			task.wait(UPDATE_INTERVAL)
			local ok, err = pcall(Prompts.UpdateAll)
			if not ok then
				warn("[Prompts] " .. tostring(err))
			end
		end
	end)
end

return Prompts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">Rewards</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  BELOHNUNGS-FENSTER: 🎁 Geschenke, 🎡 Glücksrad, 📜 Tagesaufgaben
--  Gewürfelt und gutgeschrieben wird NUR auf dem Server. Hier wird angezeigt und angefragt
--  ("ClaimGift", "Spin", "ClaimQuest", "RerollQuest"). Countdowns laufen lokal weiter – ohne dass
--  der Server jede Sekunde senden muss: FreeSpinIn gilt ab der Ankunft des States (ctx.StateTime),
--  die Geschenke kommen nur bei Änderung und zählen ab GiftsAt (Serverzeit).
--  Das Glücksrad holt kurz Schwung (dreht ein Stück zurück), läuft realistisch aus, rollt einen
--  Hauch über das Ziel hinaus und pendelt zurück – genau auf das Feld, das der Server gewürfelt hat.
--  Der Zeiger schnippt an jedem Feld und wackelt gedämpft nach (Feder), die Lämpchen blinken
--  passend zum Tempo.
-- =====================================================================

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local Rewards = {}

local player = Players.LocalPlayer
local ctx: any = nil
local Theme = UI.Theme
local GRAY = Theme.Gray
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local giftWin: UI.Window
local wheelWin: UI.Window
local questWin: UI.Window

-- Sekunden seit der Ankunft des letzten States (dessen Countdowns gelten ab dann)
local function sinceState(): number
	local t = ctx and ctx.StateTime
	if type(t) ~= "number" then
		return 0
	end
	return math.max(0, os.clock() - t)
end

-- Sekunden, seit die Geschenk-Countdowns (ReadyIn) gelten. Der Server schickt die Geschenke nur bei
-- Änderung – deshalb zählen sie ab GiftsAt (Serverzeit), nicht ab dem letzten State.
local function sinceGifts(state: any): number
	local at = type(state) == "table" and tonumber(state.GiftsAt)
	if at then
		return math.max(0, workspace:GetServerTimeNow() - at)
	end
	return sinceState()
end

-- "👟 2x Schritte" + Icon "👟" -> Icon nicht doppelt
local function displayName(item: any): string
	local name = tostring(item.Name or item.Key or "?")
	local icon = item.Icon
	if type(icon) == "string" and icon ~= "" and not name:find(icon, 1, true) then
		return icon .. " " .. name
	end
	return name
end

local function percentText(value: number): string
	if math.abs(value - math.floor(value + 0.5)) < 0.05 then
		return tostring(math.floor(value + 0.5))
	end
	return string.format("%.1f", value)
end

-- ---------------------------------------------------------------------
-- ZUSAMMENFASSUNG (für die Badges im HUD und die Fenster)
-- ---------------------------------------------------------------------
export type Summary = {
	GiftsReady: number, -- abholbereite Geschenke
	NextGiftIn: number?, -- Sekunden bis zum nächsten (nil = keins mehr)
	Spins: number, -- gekaufte/gewonnene Drehs
	HasWheel: boolean, -- liefert der Server Glücksrad-Daten?
	FreeReady: boolean, -- Gratis-Dreh bereit
	FreeIn: number, -- Sekunden bis zum Gratis-Dreh
	QuestsReady: number, -- geschafft, aber nicht abgeholt
}

function Rewards.Summary(state: any): Summary
	local elapsed = sinceState()
	local giftElapsed = sinceGifts(state)
	local giftsReady = 0
	local nextGift: number? = nil
	local quests = 0
	if type(state) == "table" then
		if type(state.Gifts) == "table" then
			for _, gift in ipairs(state.Gifts) do
				if type(gift) == "table" and gift.Claimed ~= true then
					local left = (tonumber(gift.ReadyIn) or 0) - giftElapsed
					if left <= 0 then
						giftsReady += 1
					elseif nextGift == nil or left < nextGift then
						nextGift = left
					end
				end
			end
		end
		if type(state.Quests) == "table" then
			for _, quest in ipairs(state.Quests) do
				if
					type(quest) == "table"
					and quest.Claimed ~= true
					and (tonumber(quest.Progress) or 0) >= (tonumber(quest.Goal) or math.huge)
				then
					quests += 1
				end
			end
		end
	end
	local hasWheel = type(state) == "table" and state.FreeSpinIn ~= nil
	local freeIn = if hasWheel then math.max(0, (tonumber(state.FreeSpinIn) or 0) - elapsed) else 0
	return {
		GiftsReady = giftsReady,
		NextGiftIn = nextGift,
		Spins = math.max(0, math.floor(if type(state) == "table" then tonumber(state.Spins) or 0 else 0)),
		HasWheel = hasWheel,
		FreeReady = hasWheel and freeIn <= 0,
		FreeIn = freeIn,
		QuestsReady = quests,
	}
end

-- ---------------------------------------------------------------------
-- 🎁 SPIELZEIT-GESCHENKE
-- ---------------------------------------------------------------------
type GiftCard = {
	Card: Frame,
	Stroke: UIStroke,
	Title: TextLabel,
	Sub: TextLabel,
	Button: UI.Button,
}

local giftCards: { GiftCard } = {}
local giftInfo: TextLabel

local function buildGifts()
	giftWin = UI.Window("🎁 GESCHENKE", 540, 560, Theme.Purple)
	local content = giftWin.Content
	giftInfo = UI.Label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = "🎁 Spiel weiter – alle paar Minuten gibt's ein Geschenk!",
		TextColor3 = Theme.Yellow,
		LayoutOrder = 1,
		MaxText = 20,
		Outline = 2,
		Parent = content,
	})
	local gifts = ctx.Config.PlaytimeGifts
	if type(gifts) ~= "table" then
		gifts = {}
	end
	for i, gift in ipairs(gifts) do
		local card = UI.Card({ Size = UDim2.new(1, 0, 0, 66), LayoutOrder = 10 + i, Parent = content })
		local stroke = card:FindFirstChildOfClass("UIStroke") :: UIStroke
		local minutesBox = UI.Create("Frame", {
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.fromOffset(50, 50),
			BackgroundColor3 = Theme.PanelDark,
			Parent = card,
		}, { UI.Corner(10), UI.Stroke(BLACK, 2) })
		UI.Label({
			Position = UDim2.fromOffset(2, 4),
			Size = UDim2.new(1, -4, 0, 26),
			Text = tostring(gift.Icon or "🎁"),
			MaxText = 24,
			Parent = minutesBox,
		})
		UI.Label({
			Position = UDim2.new(0, 2, 1, -20),
			Size = UDim2.new(1, -4, 0, 16),
			Text = tostring(gift.Minutes or "?") .. " Min",
			TextColor3 = Theme.Yellow,
			MaxText = 13,
			Outline = 1,
			Parent = minutesBox,
		})
		local title = UI.Label({
			Position = UDim2.fromOffset(68, 7),
			Size = UDim2.new(1, -228, 0, 30),
			Text = displayName(gift),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 22,
			Outline = 2,
			Parent = card,
		})
		local sub = UI.Label({
			Position = UDim2.fromOffset(68, 38),
			Size = UDim2.new(1, -228, 0, 20),
			Text = "",
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.SubText,
			MaxText = 14,
			Parent = card,
		})
		local button = UI.Button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(140, 46),
			Text = "...",
			Color = GRAY,
			MaxText = 20,
			Parent = card,
		}, function()
			ctx.Request("ClaimGift", i)
		end)
		giftCards[i] = { Card = card, Stroke = stroke, Title = title, Sub = sub, Button = button }
	end
end

function Rewards.RefreshGifts(state: any)
	if not state then
		return
	end
	local list = if type(state.Gifts) == "table" then state.Gifts else {}
	local elapsed = sinceGifts(state)
	local playSeconds: number? = nil
	for i, card in ipairs(giftCards) do
		local gift = list[i]
		card.Card.Visible = type(gift) == "table"
		if type(gift) == "table" then
			local text = if type(gift.Text) == "string" and gift.Text ~= "" then gift.Text else card.Title.Text
			if card.Title.Text ~= text then
				card.Title.Text = text
			end
			local minutes = tonumber(gift.Minutes) or 0
			local left = math.max(0, (tonumber(gift.ReadyIn) or 0) - elapsed)
			if left > 0 and playSeconds == nil then
				playSeconds = minutes * 60 - left
			end
			local subText, buttonText, color, gold
			if gift.Claimed == true then
				subText, buttonText, color, gold = "✅ Abgeholt", "✅", GRAY, false
			elseif left <= 0 then
				subText, buttonText, color, gold = "🎁 Bereit – hol es dir!", "🎁 Abholen", Theme.Green, true
			else
				subText = "nach " .. minutes .. " Min. Spielzeit heute"
				buttonText, color, gold = "⏳ " .. ctx.Util.FormatTime(math.ceil(left)), GRAY, false
			end
			if card.Sub.Text ~= subText then
				card.Sub.Text = subText
			end
			card.Button.SetText(buttonText)
			card.Button.SetColor(color)
			local strokeColor = if gold then Theme.Gold else BLACK
			if card.Stroke.Color ~= strokeColor then
				card.Stroke.Color = strokeColor
				card.Stroke.Thickness = if gold then 4 else 2
			end
			card.Card.BackgroundTransparency = if gift.Claimed == true then 0.4 else 0
		end
	end
	local info
	if #list == 0 then
		info = "🎁 Geschenke werden geladen..."
	elseif playSeconds then
		info = "⏱️ Spielzeit heute: "
			.. ctx.Util.FormatTime(math.max(0, playSeconds))
			.. "  •  bleib dran für mehr! 🎁"
	else
		info = "🏆 Alle Geschenke von heute freigeschaltet – morgen gibt's neue!"
	end
	if giftInfo.Text ~= info then
		giftInfo.Text = info
	end
end

-- ---------------------------------------------------------------------
-- 🎡 GLÜCKSRAD
-- Das Rad besteht aus schmalen, gedrehten Streifen ("Speichen") pro Feld – nur normale Frames,
-- keine Bilder, keine CanvasGroup. Beim Drehen wird nur die Rotation des Rotors getweent.
-- ---------------------------------------------------------------------
local WHEEL_RADIUS = 140
local SPOKES_PER_SEGMENT = 12
local SPIN_TIME = 4.4
local SPIN_TURNS = 5
local SPIN_INFO = TweenInfo.new(SPIN_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local WINDUP_INFO = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SETTLE_INFO = TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
local WIN_POP_INFO = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 2, true)
local WINDUP_ANGLE = 9 -- so weit holt das Rad vor dem Drehen Schwung (Grad zurück)
local OVERSHOOT = 0.14 -- rollt so viel (Anteil eines Felds) übers Ziel und pendelt zurück
local POINTER_KICK = 26 -- so weit schnippt der Zeiger höchstens, wenn ein Feld vorbeisaust
local POINTER_STIFFNESS = 700 -- Feder des Zeigers (höher = schneller zurück)
local POINTER_DAMPING = 13 -- Dämpfung (niedriger = wackelt länger nach)
local POINTER_STEP = 1 / 240 -- Rechenschritt der Zeiger-Feder (stabil bei jeder Bildrate)
local LIGHT_COUNT = 16
local LIGHT_ON = Color3.fromRGB(255, 245, 160)
local LIGHT_OFF = Color3.fromRGB(255, 120, 40)

local wheelRotor: Frame
local wheelPointer: TextLabel
local segmentIconScales: { UIScale } = {}
local segmentTexts: { TextLabel } = {}
local rimLights: { Frame } = {}
local spinInfo: TextLabel
local spinButton: UI.Button
local productRow: Frame
local spinning = false
local lightsFlipped = false

local function wheelPrizes(): { any }
	local list = ctx.Config.WheelPrizes
	return if type(list) == "table" then list else {}
end

local function segmentCount(): number
	return math.max(1, #wheelPrizes())
end

local function circle(props: { [string]: any }): Frame
	local frame: Frame = UI.Create("Frame", props)
	UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = frame })
	return frame
end

-- Eine Speiche: Halter (2r hoch, um die Radmitte gedreht), obere Hälfte farbig:
-- innen schmal, außen breit (so bleiben die Feldgrenzen auch zur Mitte hin sauber)
local function addSpoke(parent: Frame, angle: number, color: Color3, inner: number, outer: number, z: number)
	local r = WHEEL_RADIUS
	local holder = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(outer, r * 2),
		BackgroundTransparency = 1,
		Rotation = angle,
		ZIndex = z,
		Parent = parent,
	})
	UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(outer, math.floor(r / 2) + 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = holder,
	})
	UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, math.floor(r / 2)),
		Size = UDim2.fromOffset(inner, math.ceil(r / 2)),
		BackgroundColor3 = color:Lerp(BLACK, 0.12),
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = holder,
	})
end

local function setLights(flip: boolean)
	lightsFlipped = flip
	for i, dot in ipairs(rimLights) do
		local on = (i % 2 == 0) ~= flip
		dot.BackgroundColor3 = if on then LIGHT_ON else LIGHT_OFF
	end
end

-- Text auf dem Feld (Beträge wachsen mit deinem Einkommen – gleiche Rechnung wie der Server)
local function prizeAmountText(prize: any, state: any): string
	local Util = ctx.Util
	local kind = tostring(prize.Type or "Cash")
	if kind == "Cash" then
		local income = state and tonumber(state.Income) or 0
		return Util.FormatCash(math.max(tonumber(prize.Min) or 0, income * (tonumber(prize.Seconds) or 60)))
	elseif kind == "Steps" then
		local steps = state and tonumber(state.Steps) or 0
		local mult = state and tonumber(state.StepsMult) or 1
		local best = ctx.Config.BestTreadmill and ctx.Config.BestTreadmill(steps)
		local rate = best and tonumber(best.Rate) or 1
		local perSecond = rate / (tonumber(ctx.Config.TreadmillTick) or 0.5) * mult
		return Util.FormatNumber(math.max(tonumber(prize.Min) or 0, perSecond * (tonumber(prize.Seconds) or 60)))
	elseif kind == "Spins" then
		local amount = math.max(1, math.floor(tonumber(prize.Amount) or 1))
		return amount .. (if amount == 1 then " Dreh" else " Drehs")
	elseif kind == "Egg" then
		return tostring(prize.Name or (tostring(prize.Rarity) .. "-Ei"))
	end
	return tostring(prize.Name or "?")
end

local function buildOddsText(): string
	local prizes = wheelPrizes()
	local total = 0
	for _, prize in ipairs(prizes) do
		total += math.max(0, tonumber(prize.Weight) or 0)
	end
	local parts = {}
	for _, prize in ipairs(prizes) do
		local pct = if total > 0 then math.max(0, tonumber(prize.Weight) or 0) / total * 100 else 0
		table.insert(parts, displayName(prize) .. " " .. percentText(pct) .. "%")
	end
	return "🎲 Chancen: "
		.. table.concat(parts, " • ")
		.. "\n🥚 Ei = zufälliger Meteor dieser Seltenheit (fliegt in deine Base)"
end

local function buildWheel()
	local r = WHEEL_RADIUS
	local wheelHeight = r * 2 + 44
	wheelWin = UI.Window("🎡 GLÜCKSRAD", 560, wheelHeight + 330, Color3.fromRGB(255, 120, 200))
	local content = wheelWin.Content
	local prizes = wheelPrizes()
	local count = segmentCount()
	local segAngle = 360 / count

	-- Das Rad sitzt FEST über dem scrollbaren Inhalt: gedrehte Teile würden von einem
	-- ScrollingFrame nicht abgeschnitten und beim Scrollen über die Kopfzeile ragen.
	local holder = UI.Create("Frame", {
		Name = "WheelHolder",
		Position = UDim2.fromOffset(12, 66),
		Size = UDim2.new(1, -24, 0, wheelHeight),
		BackgroundTransparency = 1,
		Parent = wheelWin.Panel,
	})
	content.Position = UDim2.fromOffset(12, 66 + wheelHeight + 6)
	content.Size = UDim2.new(1, -24, 1, -(66 + wheelHeight + 6 + 12))
	-- Rand: schwarz außen, goldener Ring mit Lämpchen
	circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, r + 26),
		Size = UDim2.fromOffset(r * 2 + 30, r * 2 + 30),
		BackgroundColor3 = BLACK,
		ZIndex = 1,
		Parent = holder,
	})
	local gold = circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, r + 26),
		Size = UDim2.fromOffset(r * 2 + 22, r * 2 + 22),
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = holder,
	})
	UI.Create("UIGradient", {
		Rotation = 45,
		Color = ColorSequence.new(Color3.fromRGB(255, 230, 110), Color3.fromRGB(220, 140, 20)),
		Parent = gold,
	})
	for i = 1, LIGHT_COUNT do
		local angle = math.rad((i - 1) * 360 / LIGHT_COUNT)
		local dot = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(angle) * (r + 5.5), 0.5, -math.cos(angle) * (r + 5.5)),
			Size = UDim2.fromOffset(8, 8),
			BackgroundColor3 = LIGHT_ON,
			ZIndex = 3,
			Parent = gold,
		})
		table.insert(rimLights, dot)
	end
	setLights(false)

	-- Rotor: dreht sich, alles darin dreht mit
	wheelRotor = circle({
		Name = "Rotor",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, r + 26),
		Size = UDim2.fromOffset(r * 2, r * 2),
		BackgroundColor3 = Theme.PanelDark,
		ZIndex = 4,
		Parent = holder,
	})
	local spokeStep = segAngle / SPOKES_PER_SEGMENT
	-- Speichenbreite: deckt außen den Abstand zur nächsten Speiche (+1 px Überlappung)
	local outerWidth = math.ceil(2 * r * math.sin(math.rad(spokeStep / 2))) + 2
	local innerWidth = math.ceil(r * math.sin(math.rad(spokeStep / 2))) + 2
	for i = 1, count do
		local prize = prizes[i] or {}
		local color: Color3 = if typeof(prize.Color) == "Color3" then prize.Color else Color3.fromHSV(i / count, 0.7, 1)
		local first = (i - 1) * segAngle - segAngle / 2
		for k = 0, SPOKES_PER_SEGMENT - 1 do
			addSpoke(wheelRotor, first + (k + 0.5) * spokeStep, color, innerWidth, outerWidth, 5)
		end
	end
	-- Trennlinien zwischen den Feldern
	for i = 1, count do
		addSpoke(wheelRotor, (i - 1) * segAngle - segAngle / 2, BLACK, 3, 4, 6)
	end
	-- Beschriftung: Icon außen, Betrag in der Mitte des Felds (entlang des Radius)
	for i = 1, count do
		local prize = prizes[i] or {}
		local mid = (i - 1) * segAngle
		local rad = math.rad(mid)
		local textRotation = if mid > 180 then mid + 90 else mid - 90
		local iconScale: UIScale = UI.Create("UIScale")
		local icon = UI.Label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(rad) * r * 0.79, 0.5, -math.cos(rad) * r * 0.79),
			Size = UDim2.fromOffset(40, 40),
			Text = tostring(prize.Icon or "🎁"),
			Rotation = mid,
			MaxText = 32,
			ZIndex = 8,
			Parent = wheelRotor,
		})
		iconScale.Parent = icon
		local text = UI.Label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(rad) * r * 0.45, 0.5, -math.cos(rad) * r * 0.45),
			Size = UDim2.fromOffset(math.floor(r * 0.42), 22),
			Text = tostring(prize.Name or "?"),
			Rotation = textRotation,
			MaxText = 16,
			Outline = 2,
			ZIndex = 8,
			Parent = wheelRotor,
		})
		segmentIconScales[i] = iconScale
		segmentTexts[i] = text
	end
	-- dünner schwarzer Rand über den Speichen-Enden
	local rim = circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, r + 26),
		Size = UDim2.fromOffset(r * 2, r * 2),
		BackgroundTransparency = 1,
		ZIndex = 9,
		Parent = holder,
	})
	UI.Stroke(BLACK, 3).Parent = rim
	-- Nabe (dreht nicht mit – sie ist rund)
	local hub = circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, r + 26),
		Size = UDim2.fromOffset(62, 62),
		BackgroundColor3 = WHITE,
		ZIndex = 10,
		Parent = holder,
	})
	UI.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(255, 235, 120), Color3.fromRGB(230, 150, 20)),
		Parent = hub,
	})
	UI.Stroke(BLACK, 3).Parent = hub
	UI.Label({ Size = UDim2.fromScale(1, 1), Text = "🎡", MaxText = 34, ZIndex = 11, Parent = hub })
	-- Zeiger oben
	wheelPointer = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(46, 46),
		Text = "🔻",
		MaxText = 44,
		ZIndex = 12,
		Parent = holder,
	})

	spinInfo = UI.Label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = "",
		TextColor3 = Theme.Yellow,
		LayoutOrder = 2,
		MaxText = 20,
		Outline = 2,
		Parent = content,
	})
	spinButton = UI.Button({
		Size = UDim2.new(1, 0, 0, 60),
		Text = "🎡 DREHEN!",
		Color = Theme.Orange,
		LayoutOrder = 3,
		MaxText = 30,
		Parent = content,
	}, function()
		Rewards.Spin()
	end)

	-- Drehs kaufen (Zufalls-Käufe: nur wo erlaubt, Chancen stehen darunter)
	productRow = UI.Row(content, 4, 48)
	productRow.Visible = false
	local Config = ctx.Config
	for order, key in ipairs({ "Spin1", "Spin10" }) do
		local product = Config.ProductsByKey and Config.ProductsByKey[key]
		if product then
			local button = UI.Button({
				Size = UDim2.new(0.5, -3, 1, 0),
				Text = displayName(product),
				Color = Theme.Purple,
				LayoutOrder = order,
				MaxText = 17,
				Parent = productRow,
			}, function()
				if product.Id ~= 0 then
					MarketplaceService:PromptProductPurchase(player, product.Id)
				end
			end)
			UI.FetchPrice(product.Id, Enum.InfoType.Product, function(price)
				if product.Id == 0 then
					button.SetText(displayName(product) .. " (bald)")
					button.SetColor(GRAY)
				elseif price then
					button.SetText(displayName(product) .. "  R$ " .. price)
				end
			end)
		end
	end
	UI.WhenRandomItemsKnown(function(allowed)
		productRow.Visible = allowed
	end)

	UI.Label({
		Size = UDim2.new(1, 0, 0, 58),
		Text = buildOddsText(),
		Font = Enum.Font.GothamBold,
		TextColor3 = Theme.SubText,
		TextWrapped = true,
		LayoutOrder = 5,
		MaxText = 13,
		Parent = content,
	})
end

function Rewards.RefreshWheel(state: any)
	if not state then
		return
	end
	for i, prize in ipairs(wheelPrizes()) do
		local label = segmentTexts[i]
		if label then
			local text = prizeAmountText(prize, state)
			if label.Text ~= text then
				label.Text = text
			end
		end
	end
	local summary = Rewards.Summary(state)
	local info
	if not summary.HasWheel then
		info = "🎡 Glücksrad wird geladen..."
	elseif summary.FreeReady then
		info = "🎡 Drehs: " .. summary.Spins .. "   •   🆓 Gratis-Dreh BEREIT!"
	else
		info = "🎡 Drehs: " .. summary.Spins .. "   •   🆓 Gratis-Dreh in " .. ctx.Util.FormatTime(summary.FreeIn)
	end
	if spinInfo.Text ~= info then
		spinInfo.Text = info
	end
	if spinning then
		spinButton.SetText("🎡 Dreht...")
		spinButton.SetColor(GRAY)
	elseif summary.FreeReady then
		spinButton.SetText("🆓 GRATIS DREHEN!")
		spinButton.SetColor(Theme.Green)
	elseif summary.Spins > 0 then
		spinButton.SetText("🎡 DREHEN!  (" .. summary.Spins .. ")")
		spinButton.SetColor(Theme.Orange)
	else
		spinButton.SetText("⏳ Keine Drehs")
		spinButton.SetColor(GRAY)
	end
end

-- Dreht den Rotor auf das Feld "segment" (1 = oben, im Uhrzeigersinn): Schwung holen, auslaufen,
-- leicht drüberrollen, zurückpendeln. Wartet, bis das Rad steht.
local function spinTo(segment: number)
	local count = segmentCount()
	local segAngle = 360 / count
	local start = wheelRotor.Rotation % 360
	wheelRotor.Rotation = start
	-- Der Zeiger oben zeigt auf den Rad-Winkel -Rotation -> Feld i steht oben bei -(i-1)*segAngle
	local target = (360 - (segment - 1) * segAngle) % 360 + (math.random() - 0.5) * segAngle * 0.5
	local final = start + 360 * SPIN_TURNS + (target - start) % 360
	local lastIndex = math.floor((start + segAngle / 2) / segAngle)
	local lastRotation = start
	local pointerAngle, pointerVelocity = 0, 0
	local pointerClock = 0
	local lightClock = 0
	local connection = RunService.RenderStepped:Connect(function(dt: number)
		local rotation = wheelRotor.Rotation
		local speed = if dt > 0 then math.abs(rotation - lastRotation) / dt else 0 -- Grad/s
		lastRotation = rotation
		-- Zeiger schnippt bei jedem vorbeisausenden Feld (je schneller, desto weiter)
		local index = math.floor((rotation + segAngle / 2) / segAngle)
		if index ~= lastIndex then
			lastIndex = index
			local kick = POINTER_KICK * math.clamp(speed / 500, 0.35, 1)
			pointerAngle = math.min(pointerAngle, -kick)
			pointerVelocity = math.min(pointerVelocity, 0)
		end
		-- Feder zurück in die Mitte (gedämpftes Nachwackeln), in kleinen festen Schritten
		pointerClock += math.min(dt, 0.1)
		while pointerClock >= POINTER_STEP do
			pointerClock -= POINTER_STEP
			local accel = -POINTER_STIFFNESS * pointerAngle - POINTER_DAMPING * pointerVelocity
			pointerVelocity += accel * POINTER_STEP
			pointerAngle += pointerVelocity * POINTER_STEP
		end
		wheelPointer.Rotation = math.clamp(pointerAngle, -POINTER_KICK - 6, 10)
		-- Lämpchen blinken schnell, solange das Rad schnell ist, und werden mit ihm langsamer
		lightClock += dt
		local interval = math.clamp(18 / math.max(speed, 1), 0.06, 0.35)
		if lightClock >= interval then
			lightClock = 0
			setLights(not lightsFlipped)
		end
	end)
	-- 1) Schwung holen
	local windup = TweenService:Create(wheelRotor, WINDUP_INFO, { Rotation = start - WINDUP_ANGLE })
	windup:Play()
	windup.Completed:Wait()
	-- 2) auslaufen (etwas über das Ziel hinaus) 3) zurückpendeln
	local over = final + segAngle * OVERSHOOT
	local tween = TweenService:Create(wheelRotor, SPIN_INFO, { Rotation = over })
	tween:Play()
	tween.Completed:Wait()
	local settle = TweenService:Create(wheelRotor, SETTLE_INFO, { Rotation = final })
	settle:Play()
	settle.Completed:Wait()
	-- Zeiger noch kurz auspendeln lassen
	task.wait(0.25)
	connection:Disconnect()
	wheelRotor.Rotation = final % 360
	wheelPointer.Rotation = 0
	setLights(false)
end

local function celebrate(segment: number)
	local scale = segmentIconScales[segment]
	if scale then
		scale.Scale = 1
		TweenService:Create(scale, WIN_POP_INFO, { Scale = 1.7 }):Play()
	end
	-- Lämpchen blinken zur Feier ein paar Mal schnell
	task.spawn(function()
		for _ = 1, 8 do
			setLights(not lightsFlipped)
			task.wait(0.09)
		end
		setLights(false)
	end)
end

function Rewards.Spin()
	if spinning then
		return
	end
	spinning = true
	Rewards.RefreshWheel(ctx.State)
	-- Geld/Schritte erst nach dem Drehen hochzählen lassen (sonst verrät die Anzeige den Gewinn)
	ctx.Hud.HoldCounters(true)
	local ok, result = ctx.RequestFull("Spin", nil, true)
	local message = if type(result) == "table" and type(result.Message) == "string" then result.Message else ""
	local segment = if type(result) == "table" then tonumber(result.Segment) else nil
	if ok and segment then
		local index = math.clamp(math.floor(segment), 1, segmentCount())
		local done, err = pcall(spinTo, index)
		if not done then
			warn("[Rewards] Glücksrad: " .. tostring(err))
		end
		celebrate(index)
	end
	ctx.Hud.HoldCounters(false)
	spinning = false
	if ok then
		ctx.Toast(if message ~= "" then message else "🎡 Gewonnen!", "Success")
		ctx.Effects.Play("Confetti", 1.5)
	else
		ctx.Toast(if message ~= "" then message else "🎡 Drehen hat nicht geklappt – nochmal!", "Error")
	end
	Rewards.RefreshWheel(ctx.State)
end

-- ---------------------------------------------------------------------
-- 📜 TAGESAUFGABEN
-- ---------------------------------------------------------------------
type QuestCard = {
	Card: Frame,
	Stroke: UIStroke,
	Title: TextLabel,
	Bar: UI.Bar,
	Reward: TextLabel,
	Button: UI.Button,
	Reroll: UI.Button, -- 🔄 einmal am Tag tauschen
}

local questCards: { QuestCard } = {}
local questHeader: TextLabel
local questEmpty: TextLabel

local function ensureQuestCard(i: number): QuestCard
	local existing = questCards[i]
	if existing then
		return existing
	end
	local card = UI.Card({ Size = UDim2.new(1, 0, 0, 128), LayoutOrder = 10 + i, Parent = questWin.Content })
	local stroke = card:FindFirstChildOfClass("UIStroke") :: UIStroke
	local title = UI.Label({
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -24, 0, 30),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 22,
		Outline = 2,
		Parent = card,
	})
	local bar = UI.Bar({
		Position = UDim2.fromOffset(12, 44),
		Size = UDim2.new(1, -24, 0, 28),
		Color = Theme.Cyan,
		MaxText = 16,
		Parent = card,
	})
	local reward = UI.Label({
		Position = UDim2.new(0, 12, 1, -46),
		Size = UDim2.new(1, -246, 0, 36),
		Text = "",
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Cash,
		TextWrapped = true,
		MaxText = 15,
		Parent = card,
	})
	local button = UI.Button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -8),
		Size = UDim2.fromOffset(160, 42),
		Text = "...",
		Color = GRAY,
		MaxText = 18,
		Parent = card,
	}, function()
		ctx.Request("ClaimQuest", i)
	end)
	-- 🔄 Tauschen (einmal am Tag, z.B. wenn keine anderen Spieler zum Bonken da sind)
	local reroll = UI.Button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -178, 1, -8),
		Size = UDim2.fromOffset(50, 42),
		Text = "🔄",
		Color = Theme.Purple,
		MaxText = 22,
		Visible = false,
		Parent = card,
	}, function()
		ctx.Request("RerollQuest", i)
	end)
	local entry: QuestCard = {
		Card = card,
		Stroke = stroke,
		Title = title,
		Bar = bar,
		Reward = reward,
		Button = button,
		Reroll = reroll,
	}
	questCards[i] = entry
	return entry
end

local function buildQuests()
	questWin = UI.Window("📜 TAGESAUFGABEN", 540, 540, Theme.Cyan)
	local content = questWin.Content
	questHeader = UI.Label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = "",
		TextColor3 = Theme.Yellow,
		LayoutOrder = 1,
		MaxText = 20,
		Outline = 2,
		Parent = content,
	})
	questEmpty = UI.Label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = "📜 Aufgaben werden geladen...",
		Font = Enum.Font.GothamBold,
		TextColor3 = Theme.SubText,
		LayoutOrder = 2,
		MaxText = 16,
		Parent = content,
	})
	for i = 1, 3 do
		ensureQuestCard(i).Card.Visible = false
	end
end

-- Sekunden bis Mitternacht UTC (dann gibt es neue Aufgaben)
local function secondsToNewDay(): number
	return 86400 - os.time() % 86400
end

function Rewards.RefreshQuests(state: any)
	if not state then
		return
	end
	local Util = ctx.Util
	local list = if type(state.Quests) == "table" then state.Quests else {}
	local canReroll = state.QuestReroll == true
	local header = "⏰ Neue Aufgaben in "
		.. Util.FormatTime(secondsToNewDay())
		.. "  •  Belohnung: 💵 + 🎡"
		.. (if canReroll then "  •  🔄 1x tauschen" else "")
	if questHeader.Text ~= header then
		questHeader.Text = header
	end
	questEmpty.Visible = #list == 0
	for i, quest in ipairs(list) do
		local card = ensureQuestCard(i)
		card.Card.Visible = type(quest) == "table"
		if type(quest) == "table" then
			local goal = math.max(1, tonumber(quest.Goal) or 1)
			local progress = math.clamp(tonumber(quest.Progress) or 0, 0, goal)
			local done = progress >= goal
			local claimed = quest.Claimed == true
			local title = (if claimed then "✅ " else "") .. tostring(quest.Text or "???")
			if card.Title.Text ~= title then
				card.Title.Text = title
			end
			-- "Sammle $X ein" mit $, alles andere als Zahl
			local format = if quest.Kind == "Collect" then Util.FormatCash else Util.FormatNumber
			UI.SetBar(card.Bar, progress / goal, format(progress) .. " / " .. format(goal))
			local reward = "🎁 " .. tostring(quest.RewardText or "")
			if card.Reward.Text ~= reward then
				card.Reward.Text = reward
			end
			if claimed then
				card.Button.SetText("✅ Abgeholt")
				card.Button.SetColor(GRAY)
			elseif done then
				card.Button.SetText("🎁 Abholen!")
				card.Button.SetColor(Theme.Green)
			else
				card.Button.SetText("⏳ " .. math.floor(progress / goal * 100) .. "%")
				card.Button.SetColor(GRAY)
			end
			local showReroll = canReroll and not done and not claimed
			if card.Reroll.Frame.Visible ~= showReroll then
				card.Reroll.Frame.Visible = showReroll
			end
			local gold = done and not claimed
			local strokeColor = if gold then Theme.Gold else BLACK
			if card.Stroke.Color ~= strokeColor then
				card.Stroke.Color = strokeColor
				card.Stroke.Thickness = if gold then 4 else 2
			end
			card.Card.BackgroundTransparency = if claimed then 0.4 else 0
		end
	end
	for i = #list + 1, #questCards do
		questCards[i].Card.Visible = false
	end
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH
-- ---------------------------------------------------------------------
-- Jede Sekunde (Countdowns in offenen Fenstern)
function Rewards.Tick()
	local state = ctx and ctx.State
	if not state then
		return
	end
	if giftWin.IsOpen then
		Rewards.RefreshGifts(state)
	end
	if wheelWin.IsOpen then
		Rewards.RefreshWheel(state)
	end
	if questWin.IsOpen then
		Rewards.RefreshQuests(state)
	end
end

function Rewards.Init(context: any)
	ctx = context
	buildGifts()
	buildWheel()
	buildQuests()
	ctx.Windows.Register("Gifts", giftWin, Rewards.RefreshGifts)
	ctx.Windows.Register("Wheel", wheelWin, Rewards.RefreshWheel)
	ctx.Windows.Register("Quests", questWin, Rewards.RefreshQuests)
end

return Rewards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  UI-BAUKASTEN im knalligen Simulator-Stil
--  Knöpfe mit Farbverlauf, dicker schwarzer Kontur und Feder-Effekt (Hover-Glühen,
--  Stauchen beim Drücken, Klick-Welle), Fenster, die federnd aufgehen und die Welt dahinter
--  weichzeichnen (BlurEffect, beim Schließen wieder weg), Toasts, die mit Feder hereingleiten,
--  flüssig hochzählende Zahlen (kurzes Aufploppen + Farbblitz bei Zuwachs) und getweente Balken.
--  Alle anderen Client-Module bauen ihre Oberfläche hiermit.
-- =====================================================================

local MarketplaceService = game:GetService("MarketplaceService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local UI = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

UI.Theme = {
	Panel = Color3.fromRGB(34, 38, 70),
	PanelDark = Color3.fromRGB(20, 22, 44),
	PanelLight = Color3.fromRGB(52, 58, 100),
	Text = WHITE,
	SubText = Color3.fromRGB(205, 210, 235),
	Black = BLACK,
	Yellow = Color3.fromRGB(255, 220, 50),
	Cash = Color3.fromRGB(110, 255, 100),
	Red = Color3.fromRGB(255, 65, 75),
	Blue = Color3.fromRGB(50, 150, 255),
	Green = Color3.fromRGB(70, 210, 80),
	Orange = Color3.fromRGB(255, 145, 35),
	Purple = Color3.fromRGB(175, 85, 255),
	Pink = Color3.fromRGB(255, 85, 195),
	Gray = Color3.fromRGB(120, 125, 145),
	Gold = Color3.fromRGB(255, 200, 40),
	Cyan = Color3.fromRGB(60, 220, 255),
}

-- Tween-Einstellungen (einmal angelegt und immer wiederverwendet)
local HOVER_INFO = TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local PRESS_INFO = TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local RELEASE_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local SQUASH_RELEASE_INFO = TweenInfo.new(0.45, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
local GLOW_INFO = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local RIPPLE_INFO = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local OPEN_FADE_INFO = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local OPEN_POP_INFO = TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local CLOSE_INFO = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local BLUR_IN_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local BLUR_OUT_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local COUNTER_FLASH_INFO = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true)
local BAR_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PULSE_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TOAST_GROW_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TOAST_SLIDE_INFO = TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TOAST_POP_INFO = TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
local TOAST_FADE_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TOAST_OUT_INFO = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local COUNTER_INTERVAL = 1 / 30 -- Zahlen höchstens 30x pro Sekunde neu schreiben
local COUNTER_POP_GAP = 0.15 -- so oft höchstens ein Aufploppen pro Zähler
local BUTTON_SQUASH = UDim2.fromScale(1.07, 0.86) -- gedrückter Knopf: breiter + flacher
local BUTTON_NORMAL = UDim2.fromScale(1, 1)
local BLUR_SIZE = 14 -- Weichzeichner hinter offenen Fenstern
local WINDOW_SLIDE = 36 -- Fenster gleiten aus so vielen Pixeln von unten herein
local TOAST_HEIGHT = 40
local MAX_TOASTS = 5
local MAX_TOAST_POOL = 8 -- so viele fertige Toasts werden zum Wiederverwenden aufgehoben

local root: ScreenGui? = nil
UI.Root = nil :: ScreenGui? -- die ScreenGui der Oberfläche (nach UI.Init gesetzt)

-- ---------------------------------------------------------------------
-- GRUNDBAUSTEINE
-- ---------------------------------------------------------------------
function UI.Create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	inst.Parent = parent
	return inst
end

function UI.Corner(radius: number?): UICorner
	return UI.Create("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

-- Dicke Kontur um einen Rahmen/Knopf
function UI.Stroke(color: Color3?, thickness: number?): UIStroke
	return UI.Create("UIStroke", {
		Color = color or BLACK,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

-- Schwarzer Rand um Schrift (gut lesbar auf jedem Hintergrund)
function UI.TextStroke(thickness: number?): UIStroke
	return UI.Create("UIStroke", { Thickness = thickness or 2, Color = BLACK })
end

-- Farbverlauf von oben nach unten
function UI.Gradient(top: Color3, bottom: Color3, rotation: number?): UIGradient
	return UI.Create("UIGradient", { Rotation = rotation or 90, Color = ColorSequence.new(top, bottom) })
end

-- Knallige Verlaufsfarbe für einen Knopf: oben heller, unten dunkler
function UI.ButtonSequence(color: Color3): ColorSequence
	return ColorSequence.new(color:Lerp(WHITE, 0.28), color:Lerp(BLACK, 0.18))
end

-- 1.25 -> "1.25", 2 -> "2", 2.5 -> "2.5"
function UI.FormatMult(value: number?): string
	local n = tonumber(value) or 1
	if n ~= n or n <= 0 then
		return "1"
	end
	local text = string.format("%.2f", n)
	text = text:gsub("0+$", "")
	text = text:gsub("%.$", "")
	return text
end

-- Kleine Schritte-Mengen mit einer Nachkommastelle (2.5 statt 2), große wie gewohnt (3.1M)
function UI.FormatSteps(value: number, formatNumber: (number) -> string): string
	local n = tonumber(value) or 0
	if n ~= n then
		return "0"
	end
	if math.abs(n) < 100 and math.floor(n) ~= n then
		local text = string.format("%.1f", n)
		text = text:gsub("%.0$", "")
		return text
	end
	return formatNumber(n)
end

function UI.Label(props: { [string]: any }): TextLabel
	local base: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextColor3 = WHITE,
		TextScaled = true,
		Text = "",
	}
	for key, value in pairs(props) do
		if key ~= "MaxText" and key ~= "Outline" then
			base[key] = value
		end
	end
	local children: { Instance } = { UI.Create("UITextSizeConstraint", { MaxTextSize = props.MaxText or 28 }) }
	if props.Outline then
		table.insert(children, UI.TextStroke(props.Outline))
	end
	return UI.Create("TextLabel", base, children)
end

function UI.TextBox(props: { [string]: any }): TextBox
	local base: { [string]: any } = {
		BackgroundColor3 = UI.Theme.PanelDark,
		Font = Enum.Font.GothamBold,
		TextColor3 = WHITE,
		PlaceholderColor3 = UI.Theme.SubText,
		TextScaled = true,
		ClearTextOnFocus = false,
		Text = "",
	}
	for key, value in pairs(props) do
		base[key] = value
	end
	return UI.Create("TextBox", base, {
		UI.Corner(8),
		UI.Stroke(BLACK, 2),
		UI.Create("UITextSizeConstraint", { MaxTextSize = 18 }),
		UI.Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
	})
end

-- ---------------------------------------------------------------------
-- KNÖPFE (Halter-Rahmen für das Layout + federnder Knopf in der Mitte)
-- props: Size, Position, AnchorPoint, LayoutOrder, Parent, Visible, ZIndex,
--        Text, Sub (kleine zweite Zeile), Color, MaxText, SubMax, Corner, StrokeSize, Wrap
-- ---------------------------------------------------------------------
export type Button = {
	Frame: Frame,
	Button: TextButton,
	Label: TextLabel,
	Sub: TextLabel?,
	Stroke: UIStroke,
	SetText: (text: string) -> (),
	SetSub: (text: string) -> (),
	SetColor: (color: Color3) -> (),
}

function UI.Button(props: { [string]: any }, onClick: (() -> ())?): Button
	local cornerRadius: number = props.Corner or 12
	local z: number = props.ZIndex or 1
	local holder: Frame = UI.Create("Frame", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(120, 40),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = props.Parent,
	})
	local currentColor: Color3 = props.Color or UI.Theme.Orange
	local gradient: UIGradient = UI.Create("UIGradient", {
		Rotation = 90,
		Color = UI.ButtonSequence(currentColor),
	})
	local scale: UIScale = UI.Create("UIScale")
	local outline = UI.Stroke(BLACK, props.StrokeSize or 3)
	local btn: TextButton = UI.Create("TextButton", {
		Name = "Button",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		AutoButtonColor = false,
		Text = "",
		ZIndex = z,
		Parent = holder,
	}, { UI.Corner(cornerRadius), gradient, outline, scale })

	-- Glanz-Streifen oben (macht den "Bonbon"-Look der Simulator-Knöpfe)
	UI.Create("Frame", {
		Name = "Shine",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 3),
		Size = UDim2.new(1, -8, 0.4, -2),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.8,
		ZIndex = z,
		Parent = btn,
	}, { UI.Corner(math.max(2, cornerRadius - 3)) })

	-- Hover-Glühen: weiße Fläche über dem Knopf, beim Drüberfahren leicht sichtbar
	local glow: Frame = UI.Create("Frame", {
		Name = "Glow",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = btn,
	}, { UI.Corner(cornerRadius) })
	-- Klick-Wellen (abgeschnitten auf die Knopffläche)
	local rippleBox: Frame = UI.Create("Frame", {
		Name = "Ripples",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = z,
		Parent = btn,
	})

	local hasSub = props.Sub ~= nil
	local main = UI.Label({
		Name = "Label",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, hasSub and 0.06 or 0.12, 0),
		Size = UDim2.new(1, -12, hasSub and 0.58 or 0.76, 0),
		Text = props.Text or "",
		TextWrapped = props.Wrap == true,
		MaxText = props.MaxText or 24,
		Outline = 2,
		ZIndex = z + 1,
		Parent = btn,
	})
	local sub: TextLabel? = nil
	if hasSub then
		sub = UI.Label({
			Name = "Sub",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0.62, 0),
			Size = UDim2.new(1, -12, 0.32, 0),
			Text = props.Sub,
			MaxText = props.SubMax or 16,
			Outline = 2,
			ZIndex = z + 1,
			Parent = btn,
		})
	end

	-- Feder-Effekt: Maus drüber = etwas größer + Glühen, drücken = kleiner + gestaucht (breit/flach)
	-- + Welle ab dem Klickpunkt, loslassen = federt elastisch zurück
	local hovering = false
	local function spring(target: number, info: TweenInfo)
		TweenService:Create(scale, info, { Scale = target }):Play()
	end
	local function setGlow(transparency: number)
		TweenService:Create(glow, GLOW_INFO, { BackgroundTransparency = transparency }):Play()
	end
	local function ripple(position: Vector3)
		local absPos, absSize = btn.AbsolutePosition, btn.AbsoluteSize
		if absSize.X < 1 or absSize.Y < 1 then
			return
		end
		local x = math.clamp((position.X - absPos.X) / absSize.X, 0, 1)
		local y = math.clamp((position.Y - absPos.Y) / absSize.Y, 0, 1)
		local wave: Frame = UI.Create("Frame", {
			Name = "Ripple",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, y),
			Size = UDim2.fromScale(0, 0),
			SizeConstraint = Enum.SizeConstraint.RelativeXX, -- rund bleiben (Höhe = Breite)
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.55,
			ZIndex = z,
			Parent = rippleBox,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
		local grow =
			TweenService:Create(wave, RIPPLE_INFO, { Size = UDim2.fromScale(2.4, 2.4), BackgroundTransparency = 1 })
		grow.Completed:Once(function()
			wave:Destroy()
		end)
		grow:Play()
	end
	btn.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement then
			hovering = true
			spring(1.06, HOVER_INFO)
			setGlow(0.82)
		elseif kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			spring(0.93, PRESS_INFO)
			TweenService:Create(btn, PRESS_INFO, { Size = BUTTON_SQUASH }):Play()
			setGlow(0.7)
			ripple(input.Position)
		end
	end)
	btn.InputEnded:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			TweenService:Create(btn, SQUASH_RELEASE_INFO, { Size = BUTTON_NORMAL }):Play()
		end
		if kind == Enum.UserInputType.MouseButton1 then
			spring(if hovering then 1.06 else 1, RELEASE_INFO)
			setGlow(if hovering then 0.82 else 1)
		elseif kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch then
			-- Maus raus bzw. Finger weg: zurück auf normale Größe
			hovering = false
			spring(1, RELEASE_INFO)
			setGlow(1)
		end
	end)

	-- Klick: Fehler im Callback brechen die Oberfläche nicht, Doppelklicks werden ignoriert
	local busy = false
	btn.Activated:Connect(function()
		if busy or not onClick then
			return
		end
		busy = true
		local callback = onClick :: () -> ()
		task.spawn(function()
			local ok, err = pcall(callback)
			if not ok then
				warn("[UI] " .. tostring(err))
			end
			busy = false
		end)
	end)

	local result: Button = {
		Frame = holder,
		Button = btn,
		Label = main,
		Sub = sub,
		Stroke = outline,
		SetText = function(text: string)
			if main.Text ~= text then
				main.Text = text
			end
		end,
		SetSub = function(text: string)
			if sub and sub.Text ~= text then
				sub.Text = text
			end
		end,
		SetColor = function(color: Color3)
			if color ~= currentColor then
				currentColor = color
				gradient.Color = UI.ButtonSequence(color)
			end
		end,
	}
	return result
end

-- Roter Kreis mit "!" oben rechts an einem Knopf (z.B. Tagesbonus bereit)
-- (rechts verankert: längere Texte wie "4:59" wachsen als Pille nach links, nicht aus dem Bild)
function UI.Badge(target: Button, text: string?): Frame
	local badge: Frame = UI.Create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 8, 0, 6),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = UI.Theme.Red,
		Visible = false,
		ZIndex = target.Button.ZIndex + 2,
		Parent = target.Button,
	}, { UI.Corner(14), UI.Stroke(BLACK, 2), UI.Create("UIScale", { Name = "Pulse" }) })
	UI.Label({
		Name = "Text",
		Position = UDim2.fromOffset(3, 2),
		Size = UDim2.new(1, -6, 1, -4),
		Text = text or "!",
		MaxText = 20,
		Outline = 2,
		ZIndex = target.Button.ZIndex + 3,
		Parent = badge,
	})
	return badge
end

local BADGE_PULSE_INFO = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local badgePulses: { [Frame]: Tween } = {}

-- Badge setzen: text nil/"" = ausblenden. pulse = sanft pulsieren (z.B. "abholbereit").
-- Schreibt nur bei Änderungen (wird jede Sekunde aufgerufen).
function UI.SetBadge(badge: Frame, text: string?, color: Color3?, pulse: boolean?)
	local show = text ~= nil and text ~= ""
	if badge.Visible ~= show then
		badge.Visible = show
	end
	local label = badge:FindFirstChild("Text")
	if show and label and label:IsA("TextLabel") and label.Text ~= text then
		local value = text :: string
		label.Text = value
		local chars = utf8.len(value) or #value
		local width = if chars <= 1 then 28 else math.min(76, 12 + chars * 10)
		badge.Size = UDim2.fromOffset(width, 28)
	end
	local wanted = color or UI.Theme.Red
	if badge.BackgroundColor3 ~= wanted then
		badge.BackgroundColor3 = wanted
	end
	local scale = badge:FindFirstChild("Pulse")
	if not scale or not scale:IsA("UIScale") then
		return
	end
	local tween = badgePulses[badge]
	local wantPulse = show and pulse == true
	if wantPulse and not tween then
		scale.Scale = 1
		local newTween = TweenService:Create(scale, BADGE_PULSE_INFO, { Scale = 1.22 })
		badgePulses[badge] = newTween
		newTween:Play()
	elseif not wantPulse and tween then
		tween:Cancel()
		badgePulses[badge] = nil
		scale.Scale = 1
	end
end

-- ---------------------------------------------------------------------
-- LAYOUT-HELFER (für Fenster-Inhalte)
-- ---------------------------------------------------------------------
function UI.Section(parent: Instance, text: string, order: number, color: Color3?): TextLabel
	return UI.Label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color or UI.Theme.Yellow,
		LayoutOrder = order,
		MaxText = 24,
		Outline = 2,
		Parent = parent,
	})
end

function UI.Row(parent: Instance, order: number, height: number?): Frame
	return UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, height or 40),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})
end

function UI.Grid(parent: Instance, order: number, cellX: number, cellY: number): Frame
	return UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.Create("UIGridLayout", {
			CellSize = UDim2.fromOffset(cellX, cellY),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		UI.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 3),
			PaddingTop = UDim.new(0, 3),
			PaddingBottom = UDim.new(0, 3),
		}),
	})
end

-- Karte mit hellerem Hintergrund und schwarzer Kontur
function UI.Card(props: { [string]: any }): Frame
	local base: { [string]: any } = { BackgroundColor3 = UI.Theme.PanelLight }
	for key, value in pairs(props) do
		base[key] = value
	end
	return UI.Create("Frame", base, { UI.Corner(12), UI.Stroke(BLACK, 2) })
end

-- ---------------------------------------------------------------------
-- FORTSCHRITTSBALKEN (Füllung gleitet weich)
-- ---------------------------------------------------------------------
export type Bar = { Frame: Frame, Fill: Frame, Text: TextLabel, Ratio: number }

function UI.Bar(props: { [string]: any }): Bar
	local color: Color3 = props.Color or UI.Theme.Orange
	local back: Frame = UI.Create("Frame", {
		Size = props.Size or UDim2.new(1, 0, 0, 30),
		Position = props.Position or UDim2.new(),
		BackgroundColor3 = UI.Theme.PanelDark,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	}, { UI.Corner(10), UI.Stroke(BLACK, 3) })
	local fill: Frame = UI.Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		Parent = back,
	}, { UI.Corner(10), UI.Create("UIGradient", { Rotation = 90, Color = UI.ButtonSequence(color) }) })
	local text = UI.Label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		MaxText = props.MaxText or 18,
		Outline = 2,
		ZIndex = 2,
		Parent = back,
	})
	return { Frame = back, Fill = fill, Text = text, Ratio = 0 }
end

function UI.SetBar(bar: Bar, ratio: number, text: string?)
	if ratio ~= ratio then
		ratio = 0
	end
	ratio = math.clamp(ratio, 0, 1)
	if text and bar.Text.Text ~= text then
		bar.Text.Text = text
	end
	if math.abs(ratio - bar.Ratio) > 0.001 then
		bar.Ratio = ratio
		TweenService:Create(bar.Fill, BAR_INFO, { Size = UDim2.fromScale(ratio, 1) }):Play()
	end
end

-- Kurzes "Aufploppen" (z.B. wenn Geld reinkommt)
function UI.Pulse(scale: UIScale, amount: number?)
	scale.Scale = 1 + (amount or 0.12)
	TweenService:Create(scale, PULSE_INFO, { Scale = 1 }):Play()
end

-- ---------------------------------------------------------------------
-- FLÜSSIG ZÄHLENDE ZAHLEN (Geld, Schritte)
-- ---------------------------------------------------------------------
export type Counter = {
	Label: TextLabel,
	Format: (number) -> string,
	Target: number,
	Shown: number,
	Text: string,
	Scale: UIScale?, -- UIScale am Label (falls vorhanden): ploppt bei Zuwachs kurz auf
	Color: Color3, -- eigentliche Schriftfarbe (Farbblitz kehrt dahin zurück)
	PopAt: number,
}

local counters: { Counter } = {}
local counterClock = 0
local COUNTER_UP_COLOR = Color3.fromRGB(255, 255, 255)
local COUNTER_DOWN_COLOR = Color3.fromRGB(255, 110, 110)

function UI.Counter(target: TextLabel, format: (number) -> string): Counter
	local counter: Counter = {
		Label = target,
		Format = format,
		Target = 0,
		Shown = 0,
		Text = format(0),
		Scale = target:FindFirstChildOfClass("UIScale"),
		Color = target.TextColor3,
		PopAt = 0,
	}
	target.Text = counter.Text
	table.insert(counters, counter)
	return counter
end

-- Kurzer Farbblitz (weiß bei Zuwachs, rot bei Abnahme) + Aufploppen bei Zuwachs
local function popCounter(counter: Counter, up: boolean)
	local now = os.clock()
	if now - counter.PopAt < COUNTER_POP_GAP then
		return
	end
	counter.PopAt = now
	local label = counter.Label
	label.TextColor3 = counter.Color
	TweenService:Create(label, COUNTER_FLASH_INFO, { TextColor3 = if up then COUNTER_UP_COLOR else COUNTER_DOWN_COLOR })
		:Play()
	local scale = counter.Scale
	if up and scale then
		UI.Pulse(scale, 0.1)
	end
end

-- instant = true: sofort anzeigen (z.B. beim ersten Laden)
function UI.SetCounter(counter: Counter, value: number, instant: boolean?)
	if type(value) ~= "number" or value ~= value then
		return
	end
	if not instant and value ~= counter.Target then
		popCounter(counter, value > counter.Target)
	end
	counter.Target = value
	if instant then
		counter.Shown = value
		UI.RedrawCounter(counter)
	end
end

-- Schreibt den Text sofort neu (z.B. wenn sich der Multiplikator in der Anzeige geändert hat)
function UI.RedrawCounter(counter: Counter)
	local text = counter.Format(counter.Shown)
	counter.Text = text
	counter.Label.Text = text
end

local function stepCounters(dt: number)
	counterClock += dt
	if counterClock < COUNTER_INTERVAL then
		return
	end
	local alpha = 1 - math.exp(-counterClock * 7)
	counterClock = 0
	for _, counter in ipairs(counters) do
		local target = counter.Target
		if counter.Shown ~= target then
			local diff = target - counter.Shown
			if math.abs(diff) <= math.max(0.5, math.abs(target) * 0.0002) then
				counter.Shown = target
			else
				counter.Shown += diff * alpha
			end
			local text = counter.Format(counter.Shown)
			if text ~= counter.Text then
				counter.Text = text
				counter.Label.Text = text
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- FENSTER (immer nur eins offen; öffnen = Ploppen + Einblenden)
-- Der Inhalt steckt nur WÄHREND des Auf-/Zugehens in einer CanvasGroup (für das weiche Einblenden).
-- Danach hängt er in einem normalen Frame: Eine CanvasGroup malt bei jeder kleinen Änderung
-- (Text, Balken, Scrollen) ihren ganzen Inhalt neu und macht Schrift auf Handys unscharf.
-- ---------------------------------------------------------------------
export type Window = {
	Group: Frame, -- Halter (Position, Größe, sichtbar ja/nein)
	Fader: CanvasGroup, -- nur während der Animation benutzt
	Panel: Frame, -- der eigentliche Fensterinhalt
	Scale: UIScale,
	Content: ScrollingFrame,
	IsOpen: boolean,
	Token: number,
	OnOpen: (() -> ())?,
}

local windows: { Window } = {}
local blur: BlurEffect? = nil

local function anyWindowOpen(): boolean
	for _, win in ipairs(windows) do
		if win.IsOpen then
			return true
		end
	end
	return false
end

-- Welt hinter offenen Fenstern weichzeichnen (lokaler BlurEffect, nach dem Schließen wieder weg)
local function updateBlur()
	if anyWindowOpen() then
		local effect = blur
		if not effect or effect.Parent == nil then
			effect = UI.Create("BlurEffect", { Name = "MeteorHeistWindowBlur", Size = 0, Parent = Lighting })
			blur = effect
		end
		if effect then
			TweenService:Create(effect, BLUR_IN_INFO, { Size = BLUR_SIZE }):Play()
		end
	else
		local effect = blur
		if not effect then
			return
		end
		local fade = TweenService:Create(effect, BLUR_OUT_INFO, { Size = 0 })
		fade.Completed:Once(function()
			-- inzwischen wieder ein Fenster offen? Dann bleibt er
			if blur == effect and not anyWindowOpen() then
				blur = nil
				effect:Destroy()
			end
		end)
		fade:Play()
	end
end

-- Inhalt für die Animation in die CanvasGroup hängen
local function beginFade(win: Window)
	if win.Panel.Parent ~= win.Fader then
		win.Panel.Parent = win.Fader
	end
	win.Fader.Visible = true
end

-- Animation fertig: Inhalt zurück in den normalen Frame, CanvasGroup aus
local function endFade(win: Window)
	win.Panel.Parent = win.Group
	win.Fader.Visible = false
end

function UI.CloseWindow(win: Window)
	if not win.IsOpen then
		return
	end
	win.IsOpen = false
	win.Token += 1
	local token = win.Token
	beginFade(win)
	TweenService:Create(win.Scale, CLOSE_INFO, { Scale = 0.86 }):Play()
	TweenService:Create(win.Group, CLOSE_INFO, { Position = UDim2.new(0.5, 0, 0.5, WINDOW_SLIDE * 0.6) }):Play()
	local fade = TweenService:Create(win.Fader, CLOSE_INFO, { GroupTransparency = 1 })
	fade.Completed:Connect(function()
		if win.Token == token then
			win.Group.Visible = false
			endFade(win)
		end
	end)
	fade:Play()
	updateBlur()
end

function UI.OpenWindow(win: Window)
	for _, other in ipairs(windows) do
		if other ~= win then
			UI.CloseWindow(other)
		end
	end
	if win.IsOpen then
		return
	end
	win.IsOpen = true
	win.Token += 1
	local token = win.Token
	beginFade(win)
	if not win.Group.Visible then
		win.Fader.GroupTransparency = 1
		win.Scale.Scale = 0.7
		win.Group.Position = UDim2.new(0.5, 0, 0.5, WINDOW_SLIDE)
		win.Group.Visible = true
	end
	local fade = TweenService:Create(win.Fader, OPEN_FADE_INFO, { GroupTransparency = 0 })
	fade.Completed:Connect(function()
		if win.Token == token and win.IsOpen then
			endFade(win)
		end
	end)
	fade:Play()
	-- federnd aufgehen (Back-Easing schießt etwas über 1 hinaus) und von unten hereingleiten
	TweenService:Create(win.Scale, OPEN_POP_INFO, { Scale = 1 }):Play()
	TweenService:Create(win.Group, OPEN_POP_INFO, { Position = UDim2.fromScale(0.5, 0.5) }):Play()
	updateBlur()
	if win.OnOpen then
		task.spawn(win.OnOpen)
	end
end

function UI.ToggleWindow(win: Window)
	if win.IsOpen then
		UI.CloseWindow(win)
	else
		UI.OpenWindow(win)
	end
end

function UI.CloseAll()
	for _, win in ipairs(windows) do
		UI.CloseWindow(win)
	end
end

function UI.Window(title: string, width: number, height: number, color: Color3?): Window
	assert(root, "UI.Init zuerst aufrufen")
	local accent = color or UI.Theme.Orange
	local group: Frame = UI.Create("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 10,
		Parent = root,
	})
	local scale: UIScale = UI.Create("UIScale", { Scale = 0.86, Parent = group })
	local fader: CanvasGroup = UI.Create("CanvasGroup", {
		Name = "Fader",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		Parent = group,
	})
	local panel = UI.Create("Frame", {
		Name = "Panel",
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 1, -8),
		BackgroundColor3 = WHITE,
		Parent = group,
	}, {
		UI.Corner(20),
		UI.Stroke(BLACK, 4),
		UI.Gradient(UI.Theme.Panel:Lerp(WHITE, 0.06), UI.Theme.PanelDark),
	})
	local header = UI.Create("Frame", {
		Name = "Header",
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(1, -20, 0, 50),
		BackgroundColor3 = WHITE,
		Parent = panel,
	}, {
		UI.Corner(14),
		UI.Stroke(BLACK, 3),
		UI.Create("UIGradient", { Rotation = 90, Color = UI.ButtonSequence(accent) }),
	})
	UI.Label({
		Position = UDim2.fromOffset(14, 5),
		Size = UDim2.new(1, -76, 1, -10),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 32,
		Outline = 3,
		Parent = header,
	})
	local content: ScrollingFrame = UI.Create("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(12, 70),
		Size = UDim2.new(1, -24, 1, -82),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
		UI.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 3),
			PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 3),
			PaddingBottom = UDim.new(0, 10),
		}),
	})
	local win: Window = {
		Group = group,
		Fader = fader,
		Panel = panel,
		Scale = scale,
		Content = content,
		IsOpen = false,
		Token = 0,
		OnOpen = nil,
	}
	UI.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(40, 40),
		Text = "✖",
		Color = UI.Theme.Red,
		MaxText = 22,
		Corner = 10,
		Parent = header,
	}, function()
		UI.CloseWindow(win)
	end)
	table.insert(windows, win)
	return win
end

-- ---------------------------------------------------------------------
-- TOASTS (gleiten von rechts herein, rutschen nach oben weg)
-- Normale Frames (keine CanvasGroup) + ein kleiner Vorrat, der wiederverwendet wird.
-- ---------------------------------------------------------------------
type ToastEntry = {
	Container: Frame,
	Inner: Frame,
	Scale: UIScale,
	Panel: Frame,
	PanelStroke: UIStroke,
	Gradient: UIGradient,
	Label: TextLabel,
	LabelStroke: UIStroke?,
	Leaving: boolean,
	Token: number,
	Kind: string,
}

local TOAST_COLORS: { [string]: Color3 } = {
	Info = Color3.fromRGB(60, 66, 120),
	Success = Color3.fromRGB(40, 160, 70),
	Error = Color3.fromRGB(200, 45, 55),
	Event = Color3.fromRGB(235, 120, 20),
	Alarm = Color3.fromRGB(230, 20, 30),
	Announce = Color3.fromRGB(60, 95, 230),
}

-- Zu viele Toasts: zuerst fliegt der älteste mit der KLEINSTEN Wichtigkeit raus.
-- So verdrängen Ansagen an alle ("Event") nie den eigenen Diebstahl-Alarm oder eine Fehlermeldung.
local TOAST_PRIORITY: { [string]: number } = {
	Info = 1,
	Event = 1,
	Success = 2,
	Error = 2,
	Announce = 2,
	Alarm = 3,
}

local toastHolder: Frame? = nil
local toastCount = 0
local activeToasts: { ToastEntry } = {}
local toastPool: { ToastEntry } = {}

local function newToastEntry(): ToastEntry
	local container: Frame = UI.Create("Frame", {
		Name = "Toast",
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
	})
	local toastScale: UIScale = UI.Create("UIScale", { Scale = 1 })
	local inner: Frame = UI.Create("Frame", {
		Name = "Inner",
		Size = UDim2.new(1, 0, 0, TOAST_HEIGHT),
		BackgroundTransparency = 1,
		Parent = container,
	}, { toastScale })
	local panelStroke = UI.Stroke(BLACK, 3)
	local gradient: UIGradient = UI.Create("UIGradient", { Rotation = 90 })
	local panel: Frame = UI.Create("Frame", {
		Name = "Panel",
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		BackgroundColor3 = WHITE,
		Parent = inner,
	}, { UI.Corner(12), panelStroke, gradient })
	local label = UI.Label({
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.new(1, -28, 1, -12),
		MaxText = 19,
		Outline = 2,
		Parent = inner,
	})
	return {
		Container = container,
		Inner = inner,
		Scale = toastScale,
		Panel = panel,
		PanelStroke = panelStroke,
		Gradient = gradient,
		Label = label,
		LabelStroke = label:FindFirstChildOfClass("UIStroke"),
		Leaving = false,
		Token = 0,
		Kind = "Info",
	}
end

-- Welcher Toast soll weichen? Der älteste mit der kleinsten Wichtigkeit.
local function toastToDrop(): ToastEntry
	local drop = activeToasts[1]
	local lowest = math.huge
	for _, entry in ipairs(activeToasts) do
		local priority = TOAST_PRIORITY[entry.Kind] or 1
		if priority < lowest then
			drop, lowest = entry, priority
		end
	end
	return drop
end

-- Ein-/Ausblenden über die Transparenz der einzelnen Teile. Gibt den Tween der Fläche zurück.
local function fadeToast(entry: ToastEntry, info: TweenInfo, transparency: number): Tween
	local panelTween = TweenService:Create(entry.Panel, info, { BackgroundTransparency = transparency })
	TweenService:Create(entry.PanelStroke, info, { Transparency = transparency }):Play()
	TweenService:Create(entry.Label, info, { TextTransparency = transparency }):Play()
	if entry.LabelStroke then
		TweenService:Create(entry.LabelStroke, info, { Transparency = transparency }):Play()
	end
	panelTween:Play()
	return panelTween
end

local function setToastTransparency(entry: ToastEntry, transparency: number)
	entry.Panel.BackgroundTransparency = transparency
	entry.PanelStroke.Transparency = transparency
	entry.Label.TextTransparency = transparency
	if entry.LabelStroke then
		entry.LabelStroke.Transparency = transparency
	end
end

local function removeToast(entry: ToastEntry)
	if entry.Leaving then
		return
	end
	entry.Leaving = true
	local token = entry.Token
	local index = table.find(activeToasts, entry)
	if index then
		table.remove(activeToasts, index)
	end
	TweenService:Create(entry.Inner, TOAST_OUT_INFO, { Position = UDim2.fromOffset(-50, 0) }):Play()
	local fade = fadeToast(entry, TOAST_OUT_INFO, 1)
	fade.Completed:Connect(function()
		if entry.Token ~= token then
			return
		end
		local shrink = TweenService:Create(entry.Container, TOAST_GROW_INFO, { Size = UDim2.new(1, 0, 0, 0) })
		shrink.Completed:Connect(function()
			if entry.Token ~= token then
				return
			end
			-- fertig -> aufheben und später wiederverwenden
			entry.Container.Parent = nil
			if #toastPool < MAX_TOAST_POOL then
				table.insert(toastPool, entry)
			else
				entry.Container:Destroy()
			end
		end)
		shrink:Play()
	end)
end

function UI.Toast(text: string, kind: string?)
	local holder = toastHolder
	if not holder or type(text) ~= "string" or text == "" then
		return
	end
	toastCount += 1
	local color = TOAST_COLORS[kind or "Info"] or TOAST_COLORS.Info
	local entry = table.remove(toastPool) or newToastEntry()
	entry.Token += 1
	entry.Leaving = false
	entry.Kind = if kind and TOAST_COLORS[kind] then kind else "Info"
	local token = entry.Token
	entry.Gradient.Color = UI.ButtonSequence(color)
	entry.Label.Text = text
	entry.Container.Size = UDim2.new(1, 0, 0, 0)
	entry.Container.LayoutOrder = toastCount
	entry.Inner.Position = UDim2.fromOffset(170, 0)
	entry.Scale.Scale = 0.8
	setToastTransparency(entry, 1)
	entry.Container.Parent = holder
	table.insert(activeToasts, entry)
	TweenService:Create(entry.Container, TOAST_GROW_INFO, { Size = UDim2.new(1, 0, 0, TOAST_HEIGHT + 4) }):Play()
	-- gleitet mit Feder herein (schießt etwas über die Mitte und federt zurück) + ploppt elastisch auf
	TweenService:Create(entry.Inner, TOAST_SLIDE_INFO, { Position = UDim2.fromOffset(0, 0) }):Play()
	TweenService:Create(entry.Scale, TOAST_POP_INFO, { Scale = 1 }):Play()
	fadeToast(entry, TOAST_FADE_INFO, 0)
	while #activeToasts > MAX_TOASTS do
		removeToast(toastToDrop())
	end
	task.delay((kind == "Announce" or kind == "Event") and 7 or 4, function()
		if entry.Token == token then
			removeToast(entry)
		end
	end)
end

-- ---------------------------------------------------------------------
-- PREISE (Robux) aus dem Marktplatz – einmal laden, dann merken
-- ---------------------------------------------------------------------
local priceCache: { [number]: number } = {}
local priceWaiting: { [number]: { (number?) -> () } } = {}

function UI.FetchPrice(id: number, infoType: Enum.InfoType, callback: (number?) -> ())
	if type(id) ~= "number" or id == 0 then
		task.spawn(callback, nil)
		return
	end
	local cached = priceCache[id]
	if cached then
		task.spawn(callback, cached)
		return
	end
	local waiting = priceWaiting[id]
	if waiting then
		table.insert(waiting, callback)
		return
	end
	priceWaiting[id] = { callback }
	task.spawn(function()
		local ok, info = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, id, infoType)
		local price = if ok and type(info) == "table" then tonumber(info.PriceInRobux) else nil
		if price then
			priceCache[id] = price
		end
		local list = priceWaiting[id] or {}
		priceWaiting[id] = nil
		for _, cb in ipairs(list) do
			task.spawn(cb, price)
		end
	end)
end

-- ---------------------------------------------------------------------
-- LÄNDER-REGEL "Paid Random Items": Dürfen wir Zufalls-Käufe (Zufalls-Ei, Glücksrad-Drehs) zeigen?
-- Einmal fragen, dann merken. Im Zweifel/bei Fehler: NICHT zeigen.
-- ---------------------------------------------------------------------
local randomAllowed: boolean? = nil
local randomWaiting: { (boolean) -> () } = {}
local randomStarted = false

function UI.WhenRandomItemsKnown(callback: (allowed: boolean) -> ())
	if randomAllowed ~= nil then
		task.spawn(callback, randomAllowed)
		return
	end
	table.insert(randomWaiting, callback)
	if randomStarted then
		return
	end
	randomStarted = true
	task.spawn(function()
		local ok, info = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, Players.LocalPlayer)
		local allowed = ok and type(info) == "table" and info.ArePaidRandomItemsRestricted == false
		randomAllowed = allowed
		local waiting = randomWaiting
		randomWaiting = {}
		for _, cb in ipairs(waiting) do
			task.spawn(cb, allowed)
		end
	end)
end

-- true/false, oder nil solange die Antwort noch nicht da ist
function UI.RandomItemsAllowed(): boolean?
	return randomAllowed
end

-- ---------------------------------------------------------------------
-- START
-- ---------------------------------------------------------------------
function UI.Init(screenGui: ScreenGui)
	root = screenGui
	UI.Root = screenGui

	-- Alles passend zur Bildschirmgröße skalieren (Handy bis großer Monitor)
	local rootScale: UIScale = UI.Create("UIScale", { Parent = screenGui })
	local cameraConnection: RBXScriptConnection? = nil
	local function updateScale()
		local camera = workspace.CurrentCamera
		if camera then
			local size = camera.ViewportSize
			rootScale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 760), 0.55, 1.15)
		end
	end
	local function bindCamera()
		if cameraConnection then
			cameraConnection:Disconnect()
			cameraConnection = nil
		end
		local camera = workspace.CurrentCamera
		if camera then
			cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		end
		updateScale()
	end
	bindCamera()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)

	toastHolder = UI.Create("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 56),
		Size = UDim2.fromOffset(480, 320),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = screenGui,
	}, {
		UI.Create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})

	RunService.RenderStepped:Connect(stepCounters)
end

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Windows</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  FENSTER: Shop (Reiter Gamepässe / Boosts / Gadgets), Laufbänder, Rebirth, Tagesbonus, Alien-Index
--  Jedes Fenster wird EINMAL gebaut; Refresh(state) schreibt nur die Werte neu.
--  Andere Module (z.B. Rewards) melden ihre Fenster mit Windows.Register an.
-- =====================================================================

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local UI = require(script.Parent:WaitForChild("UI"))

local Windows = {}

local player = Players.LocalPlayer
local ctx: any = nil
local Theme = UI.Theme

local list: { [string]: UI.Window } = {}
local refreshers: { [string]: (state: any) -> () } = {}

local GRAY = Theme.Gray
local TIER_COLORS: { [string]: Color3 } = {
	Normal = Color3.fromRGB(235, 235, 235),
	Selten = Color3.fromRGB(80, 200, 255),
	Ultra = Color3.fromRGB(255, 80, 230),
}

-- "👟 2x Schritte" + Icon "👟" -> nicht doppelt anzeigen
local function displayName(item: any): string
	local name = tostring(item.Name or item.Key or "?")
	local icon = item.Icon
	if type(icon) == "string" and icon ~= "" and not name:find(icon, 1, true) then
		return icon .. " " .. name
	end
	return name
end

local function percentText(value: number): string
	if math.abs(value - math.floor(value + 0.5)) < 0.05 then
		return tostring(math.floor(value + 0.5))
	end
	return string.format("%.1f", value)
end

-- Alle kaufbaren (spawnbaren) Meteore einer Seltenheit
local function meteorsOfRarity(rarityName: string): { any }
	local result = {}
	for _, def in ipairs(ctx.Config.Meteors) do
		if def.Rarity == rarityName and def.Spawnable ~= false then
			table.insert(result, def)
		end
	end
	return result
end

-- Bestes freigeschaltetes Laufband (für Schritte-Paket-Anzeige)
local function bestTreadmill(steps: number): any
	local best = nil
	local treadmills = ctx.Config.Treadmills
	if type(treadmills) == "table" then
		for _, def in ipairs(treadmills) do
			if steps >= (tonumber(def.Required) or 0) then
				best = def
			end
		end
	end
	return best
end

-- ---------------------------------------------------------------------
-- SHOP (Reiter: ⭐ Gamepässe / 💎 Boosts / 🛠️ Gadgets)
-- ---------------------------------------------------------------------
type PassCard = { Pass: any, Button: UI.Button, Price: number? }
type ProductCard = { Product: any, Info: TextLabel?, Button: UI.Button, Price: number? }
type GadgetCard = { Gadget: any, Button: UI.Button, Stroke: UIStroke, Card: Frame }

local passCards: { PassCard } = {}
local productCards: { ProductCard } = {}
local gadgetCards: { GadgetCard } = {}
local shopPages: { [string]: Frame } = {}
local shopTabButtons: { [string]: UI.Button } = {}
local shopTab = "Passes"

local SHOP_TABS = {
	{ Id = "Passes", Text = "⭐ Gamepässe", Color = Theme.Gold },
	{ Id = "Boosts", Text = "💎 Boosts", Color = Theme.Blue },
	{ Id = "Gadgets", Text = "🛠️ Gadgets", Color = Theme.Orange },
}

-- Starter-Paket: Werte aus Config.StarterPack (der MonetizationService liest dieselben).
-- Wo Zufalls-Käufe verboten sind, gibt es statt Drehs + Zufalls-Ei mehr Cash + ein festes Ei.
local function starterValues(): (number, number, number, number, string, string)
	local starter = ctx.Config.StarterPack or {}
	return tonumber(starter.MinCash) or 100000,
		tonumber(starter.IncomeSeconds) or 900,
		tonumber(starter.Spins) or 3,
		tonumber(starter.RestrictedCashMult) or 1.5,
		tostring(starter.EggRarity or "Legendary"),
		tostring(starter.Gadget or "SpeedCoil")
end

-- Zufalls-Käufe (Chancen werden angezeigt, nur wo erlaubt)
local function isRandomProduct(product: any): boolean
	return product.Type == "Meteor" or product.Type == "Spins"
end

local function hatchOddsText(meteorId: string): string
	local Aliens = ctx.Aliens
	local options = Aliens.ByMeteor[meteorId]
	if type(options) ~= "table" or #options == 0 then
		return ""
	end
	local total = 0
	for _, option in ipairs(options) do
		total += option.Weight
	end
	local parts = {}
	for _, option in ipairs(options) do
		local def = Aliens.ById[option.Id]
		local pct = if total > 0 then option.Weight / total * 100 else 0
		table.insert(parts, percentText(pct) .. "% " .. (def and def.Tier or "?"))
	end
	return "🐣 Schlüpft: " .. table.concat(parts, " • ") .. " (Glück & 🍀-Pass: besser)"
end

-- "Je 33%: Solar Flare, Aurora Crystal, Titan Boulder"
local function meteorOddsShort(rarityName: string): string
	local defs = meteorsOfRarity(rarityName)
	if #defs == 0 then
		return ""
	end
	local names = {}
	for _, def in ipairs(defs) do
		table.insert(names, def.Name)
	end
	return ("Je %s%%: %s"):format(percentText(100 / #defs), table.concat(names, ", "))
end

-- Roblox-Regel "Paid Random Items": Chancen VOR dem Kauf anzeigen
local function oddsText(rarityName: string): string
	local defs = meteorsOfRarity(rarityName)
	if #defs == 0 then
		return ""
	end
	return "🎲 " .. meteorOddsShort(rarityName) .. "\n" .. hatchOddsText(defs[1].Id)
end

-- Glücksrad-Chancen kurz: "🎲 💵26% 👟18% ..."
local function wheelOddsShort(): string
	local prizes = ctx.Config.WheelPrizes
	if type(prizes) ~= "table" or #prizes == 0 then
		return ""
	end
	local total = 0
	for _, prize in ipairs(prizes) do
		total += math.max(0, tonumber(prize.Weight) or 0)
	end
	local parts = {}
	for _, prize in ipairs(prizes) do
		local pct = if total > 0 then math.max(0, tonumber(prize.Weight) or 0) / total * 100 else 0
		table.insert(parts, tostring(prize.Icon or "?") .. percentText(pct) .. "%")
	end
	return "🎲 Chancen: " .. table.concat(parts, " ")
end

local function productInfoText(product: any, state: any): string
	local Util = ctx.Util
	local kind = product.Type
	local income = state and tonumber(state.Income) or 0
	if kind == "Cash" then
		local amount = math.max(tonumber(product.Min) or 0, income * 60 * (tonumber(product.Minutes) or 0))
		return ("%s Min. Einkommen  ≈ %s"):format(tostring(product.Minutes or 0), Util.FormatCash(amount))
	elseif kind == "Steps" then
		local steps = state and tonumber(state.Steps) or 0
		local mult = state and tonumber(state.StepsMult) or 1
		local best = bestTreadmill(steps)
		local rate = best and tonumber(best.Rate) or 1
		local minutes = tonumber(product.Minutes) or 10
		local amount = math.max(tonumber(product.Min) or 0, rate * 2 * 60 * minutes * mult)
		return ("%s Min. bestes Laufband  ≈ +%s 👟"):format(tostring(minutes), Util.FormatNumber(amount))
	elseif kind == "ServerLuck" then
		return ("🍀 %sx Glück für ALLE, %s Min."):format(
			tostring(product.Mult or 2),
			tostring(product.Minutes or 15)
		)
	elseif kind == "Shower" then
		return "🌠 Sofort für alle: zwei Spuren voller Meteore, 3x Glück, keine Locks!"
	elseif kind == "Meteor" then
		return oddsText(product.Rarity)
	elseif kind == "StarterPack" then
		local minCash, incomeSeconds, spins, restrictedMult, eggRarity, gadgetId = starterValues()
		local cash = math.max(minCash, income * incomeSeconds)
		local coil = ctx.Config.GadgetsById and ctx.Config.GadgetsById[gadgetId]
		local coilText = if coil then (tostring(coil.Icon) .. " " .. tostring(coil.Name)) else "🌀 Speed Coil"
		if UI.RandomItemsAllowed() == true then
			return ("NUR 1x: 💰 ≈%s + 🎡 %d Drehs + 🌟 %s-Ei + %s\n🎲 Ei: %s"):format(
				Util.FormatCash(cash),
				spins,
				eggRarity,
				coilText,
				meteorOddsShort(eggRarity)
			)
		end
		local eggs = ctx.Config.MeteorsByRarity and ctx.Config.MeteorsByRarity[eggRarity]
		local egg = eggs and eggs[1]
		return ("NUR 1x: 💰 ≈%s + 🌟 %s + %s"):format(
			Util.FormatCash(cash * restrictedMult),
			if egg then tostring(egg.Name) else eggRarity .. "-Ei",
			coilText
		)
	elseif kind == "Spins" then
		local amount = math.max(1, math.floor(tonumber(product.Amount) or 1))
		return ("🎡 +%d %s fürs Glücksrad\n%s"):format(
			amount,
			if amount == 1 then "Dreh" else "Drehs",
			wheelOddsShort()
		)
	elseif kind == "InstantHatch" then
		return "🐣 Alle Eier in deiner Base schlüpfen SOFORT!"
	elseif kind == "Shield" then
		return ("🛡️ %s Min. kann niemand bei dir klauen – sogar im Schauer!"):format(
			tostring(product.Minutes or 10)
		)
	elseif kind == "EggRush" then
		return ("🥚 %s Gratis-Eier regnen für ALLE auf die Map!"):format(tostring(ctx.Config.EggRushCount or 25))
	end
	return ""
end

local function ownsGadget(state: any, id: string): boolean
	local owned = state and state.Gadgets
	return type(owned) == "table" and table.find(owned, id) ~= nil
end

-- ⭐ STARTER-PAKET: nur einmal! Ein Developer Product kann der Server nicht auf einen Kauf begrenzen
-- (bezahlt ist bezahlt, er muss liefern). Deshalb bleibt der Kauf-Knopf nach dem Klick gesperrt,
-- bis Roblox "abgebrochen" meldet oder der Server "gekauft" (State StarterBought).
local STARTER_LOCK_SAFETY = 30 -- Sekunden: spätestens dann ist der Knopf wieder frei (z.B. ohne Antwort)
local starterPendingUntil = 0

function Windows.StarterPending(): boolean
	return os.clock() < starterPendingUntil
end

function Windows.BuyStarter()
	local product = ctx.Config.ProductsByKey and ctx.Config.ProductsByKey.StarterPack
	local state = ctx.State
	if not product or product.Id == 0 or (state and state.StarterBought == true) or Windows.StarterPending() then
		return
	end
	starterPendingUntil = os.clock() + STARTER_LOCK_SAFETY
	Windows.RefreshShop(state)
	ctx.Hud.Refresh(state)
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

function Windows.RefreshShop(state: any)
	for _, entry in ipairs(passCards) do
		local pass = entry.Pass
		local owned = state and state.Passes and state.Passes[pass.Key] == true
		if owned then
			entry.Button.SetText("✅ Besitzt du")
			entry.Button.SetColor(GRAY)
		elseif pass.Id == 0 then
			entry.Button.SetText("Bald verfügbar")
			entry.Button.SetColor(GRAY)
		else
			entry.Button.SetText(if entry.Price then ("R$ " .. entry.Price) else "Kaufen")
			entry.Button.SetColor(Theme.Green)
		end
	end
	for _, entry in ipairs(productCards) do
		local product = entry.Product
		if entry.Info then
			local text = productInfoText(product, state)
			if entry.Info.Text ~= text then
				entry.Info.Text = text
			end
		end
		if product.Id == 0 then
			entry.Button.SetText("Bald verfügbar")
			entry.Button.SetColor(GRAY)
		elseif product.Type == "StarterPack" and state and state.StarterBought == true then
			entry.Button.SetText("✅ Gekauft")
			entry.Button.SetColor(GRAY)
		elseif product.Type == "StarterPack" and Windows.StarterPending() then
			entry.Button.SetText("⏳ Kauf läuft...")
			entry.Button.SetColor(GRAY)
		else
			entry.Button.SetText(if entry.Price then ("R$ " .. entry.Price) else "Kaufen")
			entry.Button.SetColor(if product.Type == "StarterPack" then Theme.Gold else Theme.Blue)
		end
	end
	local cash = state and tonumber(state.Cash) or 0
	for _, entry in ipairs(gadgetCards) do
		local gadget = entry.Gadget
		local price = tonumber(gadget.Price) or 0
		local owned = ownsGadget(state, gadget.Id)
		if owned then
			entry.Button.SetText("✅ Besitzt du")
			entry.Button.SetColor(GRAY)
		else
			entry.Button.SetText("💵 " .. ctx.Util.FormatCash(price))
			entry.Button.SetColor(if cash >= price then Theme.Green else GRAY)
		end
		local strokeColor = if owned then Theme.Gold else Color3.new(0, 0, 0)
		if entry.Stroke.Color ~= strokeColor then
			entry.Stroke.Color = strokeColor
			entry.Stroke.Thickness = if owned then 4 else 2
		end
	end
end

local function selectShopTab(id: string)
	if not shopPages[id] then
		id = "Passes"
	end
	shopTab = id
	for pageId, page in pairs(shopPages) do
		page.Visible = pageId == id
	end
	for _, tab in ipairs(SHOP_TABS) do
		local button = shopTabButtons[tab.Id]
		if button then
			button.SetColor(if tab.Id == id then tab.Color else GRAY)
		end
	end
	local win = list.Shop
	if win then
		win.Content.CanvasPosition = Vector2.zero
	end
end

local function newShopPage(id: string, order: number, parent: Instance): Frame
	local page = UI.Create("Frame", {
		Name = id,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Visible = false,
		Parent = parent,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
	})
	shopPages[id] = page
	return page
end

local function buildPassPage(page: Frame)
	UI.Section(page, "⭐ Gamepässe (gehören dir für immer)", 1)
	local passGrid = UI.Grid(page, 2, 280, 136)
	for i, pass in ipairs(ctx.Config.GamePasses) do
		local card = UI.Card({ LayoutOrder = i, Parent = passGrid })
		UI.Label({
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.new(1, -20, 0, 30),
			Text = displayName(pass),
			MaxText = 22,
			Outline = 2,
			Parent = card,
		})
		UI.Label({
			Position = UDim2.fromOffset(10, 38),
			Size = UDim2.new(1, -20, 0, 40),
			Text = tostring(pass.Description or ""),
			Font = Enum.Font.GothamBold,
			TextColor3 = Theme.SubText,
			TextWrapped = true,
			MaxText = 14,
			Parent = card,
		})
		local buy = UI.Button({
			Position = UDim2.new(0, 10, 1, -48),
			Size = UDim2.new(1, -20, 0, 38),
			Text = "...",
			Color = Theme.Green,
			MaxText = 20,
			Parent = card,
		}, function()
			local state = ctx.State
			if pass.Id ~= 0 and not (state and state.Passes and state.Passes[pass.Key]) then
				MarketplaceService:PromptGamePassPurchase(player, pass.Id)
			end
		end)
		local entry: PassCard = { Pass = pass, Button = buy, Price = nil }
		table.insert(passCards, entry)
		UI.FetchPrice(pass.Id, Enum.InfoType.GamePass, function(price)
			entry.Price = price
			Windows.RefreshShop(ctx.State)
		end)
	end
end

local function buildBoostPage(page: Frame)
	UI.Section(page, "💎 Boosts & Pakete", 1)
	local productGrid = UI.Grid(page, 2, 280, 156)
	local randomCards: { Frame } = {}
	for i, product in ipairs(ctx.Config.Products) do
		local isRandom = isRandomProduct(product)
		local starter = product.Type == "StarterPack"
		local card = UI.Card({
			-- Starter-Paket ganz vorne
			LayoutOrder = if starter then 0 else i,
			Visible = not isRandom, -- erst zeigen, wenn die Länder-Regel geprüft ist
			Parent = productGrid,
		})
		if starter then
			local stroke = card:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = Theme.Gold
				stroke.Thickness = 4
			end
		end
		UI.Label({
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.new(1, -20, 0, 30),
			Text = displayName(product),
			TextWrapped = true,
			MaxText = 19,
			Outline = 2,
			Parent = card,
		})
		local info = UI.Label({
			Position = UDim2.fromOffset(10, 38),
			Size = UDim2.new(1, -20, 0, 62),
			Text = productInfoText(product, nil),
			Font = Enum.Font.GothamBold,
			TextColor3 = Theme.SubText,
			TextWrapped = true,
			MaxText = if isRandom or starter then 12 else 14,
			Parent = card,
		})
		if isRandom then
			table.insert(randomCards, card)
		end
		local buy = UI.Button({
			Position = UDim2.new(0, 10, 1, -46),
			Size = UDim2.new(1, -20, 0, 36),
			Text = "...",
			Color = if starter then Theme.Gold else Theme.Blue,
			MaxText = 20,
			Parent = card,
		}, function()
			if starter then
				Windows.BuyStarter() -- nur einmal kaufbar (mit Sperre gegen Doppelkauf)
				return
			end
			if product.Id ~= 0 then
				MarketplaceService:PromptProductPurchase(player, product.Id)
			end
		end)
		local entry: ProductCard = { Product = product, Info = info, Button = buy, Price = nil }
		table.insert(productCards, entry)
		UI.FetchPrice(product.Id, Enum.InfoType.Product, function(price)
			entry.Price = price
			Windows.RefreshShop(ctx.State)
		end)
	end
	-- Zufalls-Käufe nur zeigen, wo sie erlaubt sind (im Zweifel/bei Fehler: nicht zeigen)
	UI.WhenRandomItemsKnown(function(allowed)
		for _, card in ipairs(randomCards) do
			card.Visible = allowed
		end
		Windows.RefreshShop(ctx.State) -- Starter-Paket-Text hängt davon ab
	end)
end

local function buildGadgetPage(page: Frame)
	UI.Section(page, "🛠️ Gadgets – mit 💵 Cash, gehören dir für immer!", 1)
	UI.Label({
		Size = UDim2.new(1, 0, 0, 36),
		Text = "Liegen nach jedem Spawn in deinem Rucksack – auch nach Rebirth. Super-Bonk ersetzt den normalen Bonk.",
		Font = Enum.Font.GothamBold,
		TextColor3 = Theme.SubText,
		TextWrapped = true,
		LayoutOrder = 2,
		MaxText = 14,
		Parent = page,
	})
	local grid = UI.Grid(page, 3, 280, 176)
	local gadgets = ctx.Config.Gadgets
	if type(gadgets) ~= "table" then
		gadgets = {}
	end
	for i, gadget in ipairs(gadgets) do
		local card = UI.Card({ LayoutOrder = i, Parent = grid })
		local stroke = card:FindFirstChildOfClass("UIStroke") :: UIStroke
		UI.Label({
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.new(1, -20, 0, 32),
			Text = displayName(gadget),
			MaxText = 22,
			Outline = 2,
			Parent = card,
		})
		UI.Label({
			Position = UDim2.fromOffset(10, 40),
			Size = UDim2.new(1, -20, 0, 76),
			Text = tostring(gadget.Description or ""),
			Font = Enum.Font.GothamBold,
			TextColor3 = Theme.SubText,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			MaxText = 14,
			Parent = card,
		})
		local button = UI.Button({
			Position = UDim2.new(0, 10, 1, -48),
			Size = UDim2.new(1, -20, 0, 38),
			Text = "...",
			Color = Theme.Green,
			MaxText = 20,
			Parent = card,
		}, function()
			if ownsGadget(ctx.State, gadget.Id) then
				return
			end
			ctx.Request("BuyGadget", gadget.Id)
		end)
		table.insert(gadgetCards, { Gadget = gadget, Button = button, Stroke = stroke, Card = card })
	end
end

local function buildShop()
	local win = UI.Window("🛒 SHOP", 620, 560, Theme.Red)
	list.Shop = win
	-- Reiter fest über dem Inhalt (scrollen nicht mit weg)
	local tabBar = UI.Create("Frame", {
		Name = "Tabs",
		Position = UDim2.fromOffset(12, 68),
		Size = UDim2.new(1, -24, 0, 46),
		BackgroundTransparency = 1,
		Parent = win.Panel,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		}),
	})
	win.Content.Position = UDim2.fromOffset(12, 122)
	win.Content.Size = UDim2.new(1, -24, 1, -134)
	for i, tab in ipairs(SHOP_TABS) do
		shopTabButtons[tab.Id] = UI.Button({
			Size = UDim2.new(1 / #SHOP_TABS, -4, 1, 0),
			Text = tab.Text,
			Color = GRAY,
			LayoutOrder = i,
			MaxText = 20,
			Parent = tabBar,
		}, function()
			selectShopTab(tab.Id)
		end)
	end
	buildPassPage(newShopPage("Passes", 1, win.Content))
	buildBoostPage(newShopPage("Boosts", 2, win.Content))
	buildGadgetPage(newShopPage("Gadgets", 3, win.Content))
	selectShopTab(shopTab)
end

-- ---------------------------------------------------------------------
-- LAUFBÄNDER
-- ---------------------------------------------------------------------
type TreadmillRow = {
	Def: any,
	Card: Frame,
	Stroke: UIStroke,
	Rate: TextLabel,
	Status: TextLabel,
}

local treadmillRows: { TreadmillRow } = {}
local treadmillInfo: TextLabel
local treadmillSpeed: TextLabel
local treadmillBar: UI.Bar
local bootsButton: UI.Button? = nil

local function rainbowGradient(): UIGradient
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.85, 1)))
	end
	return UI.Create("UIGradient", { Rotation = 45, Color = ColorSequence.new(keys) })
end

local function buildTreadmills()
	local win = UI.Window("🏃 LAUFBÄNDER", 580, 540, Theme.Blue)
	list.Treadmills = win
	local content = win.Content

	treadmillInfo = UI.Label({
		Size = UDim2.new(1, 0, 0, 34),
		Text = "👟 0 Schritte  •  🏃 Tempo 16",
		TextColor3 = Theme.Yellow,
		LayoutOrder = 1,
		MaxText = 26,
		Outline = 2,
		Parent = content,
	})
	treadmillSpeed = UI.Label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = "",
		Font = Enum.Font.GothamBold,
		TextColor3 = Theme.SubText,
		LayoutOrder = 2,
		MaxText = 16,
		Parent = content,
	})
	treadmillBar = UI.Bar({ LayoutOrder = 3, Color = Theme.Cyan, MaxText = 16, Parent = content })
	UI.Button({
		Size = UDim2.new(1, 0, 0, 54),
		Text = "🏃 Zu den Laufbändern!",
		Color = Theme.Green,
		LayoutOrder = 4,
		MaxText = 26,
		Parent = content,
	}, function()
		if ctx.Request("Treadmills") then
			UI.CloseWindow(win)
		end
	end)
	UI.Label({
		Size = UDim2.new(1, 0, 0, 36),
		Text = "Drauf laufen = Schritte 👟 sammeln = schneller rennen! Mehr Schritte schalten bessere Laufbänder frei.",
		Font = Enum.Font.GothamBold,
		TextColor3 = Theme.SubText,
		TextWrapped = true,
		LayoutOrder = 5,
		MaxText = 14,
		Parent = content,
	})

	local defs = ctx.Config.Treadmills
	if type(defs) ~= "table" then
		defs = {}
	end
	for i, def in ipairs(defs) do
		local color: Color3 = if typeof(def.Color) == "Color3" then def.Color else Theme.Gray
		local card = UI.Card({ Size = UDim2.new(1, 0, 0, 66), LayoutOrder = 10 + i, Parent = content })
		local stroke = card:FindFirstChildOfClass("UIStroke") :: UIStroke
		local swatch = UI.Create("Frame", {
			Position = UDim2.fromOffset(10, 9),
			Size = UDim2.fromOffset(48, 48),
			BackgroundColor3 = if def.Id == "Regenbogen" then Color3.new(1, 1, 1) else color,
			Parent = card,
		}, { UI.Corner(10), UI.Stroke(Color3.new(0, 0, 0), 3) })
		if def.Id == "Regenbogen" or def.Rainbow == true then
			rainbowGradient().Parent = swatch
		end
		UI.Label({
			Position = UDim2.fromOffset(70, 6),
			Size = UDim2.new(1, -230, 0, 30),
			Text = tostring(def.Name or def.Id),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.45),
			MaxText = 22,
			Outline = 2,
			Parent = card,
		})
		local rate = UI.Label({
			Position = UDim2.fromOffset(70, 36),
			Size = UDim2.new(1, -230, 0, 22),
			Text = "",
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.Yellow,
			MaxText = 15,
			Parent = card,
		})
		local status = UI.Label({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(150, 40),
			Text = "",
			TextXAlignment = Enum.TextXAlignment.Right,
			MaxText = 18,
			Outline = 2,
			Parent = card,
		})
		table.insert(treadmillRows, { Def = def, Card = card, Stroke = stroke, Rate = rate, Status = status })
	end

	UI.Section(content, "💎 Schneller farmen", 100)
	local robuxRow = UI.Row(content, 101, 50)
	local boots = ctx.Config.GamePassesByKey and ctx.Config.GamePassesByKey.SpeedBoots
	local stepsProduct = ctx.Config.ProductsByKey and ctx.Config.ProductsByKey.Speed10
	if boots then
		local b = UI.Button({
			Size = UDim2.new(0.5, -3, 1, 0),
			Text = displayName(boots),
			Color = Theme.Purple,
			LayoutOrder = 1,
			MaxText = 18,
			Parent = robuxRow,
		}, function()
			if boots.Id ~= 0 then
				MarketplaceService:PromptGamePassPurchase(player, boots.Id)
			end
		end)
		bootsButton = b
		UI.FetchPrice(boots.Id, Enum.InfoType.GamePass, function(price)
			if boots.Id == 0 then
				b.SetText(displayName(boots) .. " (bald)")
				b.SetColor(GRAY)
			elseif price then
				b.SetText(displayName(boots) .. "  R$ " .. price)
			end
		end)
	end
	if stepsProduct then
		local b = UI.Button({
			Size = UDim2.new(0.5, -3, 1, 0),
			Text = displayName(stepsProduct),
			Color = Theme.Blue,
			LayoutOrder = 2,
			MaxText = 18,
			Parent = robuxRow,
		}, function()
			if stepsProduct.Id ~= 0 then
				MarketplaceService:PromptProductPurchase(player, stepsProduct.Id)
			end
		end)
		UI.FetchPrice(stepsProduct.Id, Enum.InfoType.Product, function(price)
			if stepsProduct.Id == 0 then
				b.SetText(displayName(stepsProduct) .. " (bald)")
				b.SetColor(GRAY)
			elseif price then
				b.SetText(displayName(stepsProduct) .. "  R$ " .. price)
			end
		end)
	end
end

-- Kleinste Schrittzahl, ab der das Tempo um 1 steigt (nil = schon maximal)
local function nextSpeedSteps(steps: number): number?
	local Config = ctx.Config
	if type(Config.StepsSpeed) ~= "function" then
		return nil
	end
	local current = Config.StepsSpeed(steps)
	local maxSpeed = tonumber(Config.MaxWalkSpeed) or 80
	if current >= maxSpeed then
		return nil
	end
	-- Erst verdoppeln, bis das Tempo steigt, dann eingrenzen (klappt für jede steigende Formel)
	local low = steps
	local high = math.max(steps * 2, steps + 10)
	local guard = 0
	while Config.StepsSpeed(high) <= current and guard < 200 do
		high *= 2
		guard += 1
	end
	if Config.StepsSpeed(high) <= current then
		return nil
	end
	for _ = 1, 60 do
		local mid = math.floor((low + high) / 2)
		if mid <= low then
			break
		end
		if Config.StepsSpeed(mid) > current then
			high = mid
		else
			low = mid
		end
	end
	return high
end

function Windows.RefreshTreadmills(state: any)
	if not state then
		return
	end
	local Util = ctx.Util
	local steps = tonumber(state.Steps) or 0
	local mult = tonumber(state.StepsMult) or 1
	local maxSpeed = tonumber(ctx.Config.MaxWalkSpeed) or 80
	treadmillInfo.Text = ("👟 %s Schritte  •  🏃 Tempo %s/%s"):format(
		Util.FormatNumber(steps),
		tostring(math.floor(tonumber(state.Speed) or 16)),
		tostring(maxSpeed)
	)
	local nextSteps = nextSpeedSteps(steps)
	treadmillSpeed.Text = if nextSteps
		then ("Nächstes +1 Tempo bei %s 👟  •  Bonus x%s"):format(
			Util.FormatNumber(nextSteps),
			UI.FormatMult(mult)
		)
		else ("🚀 Maximales Tempo erreicht!  •  Bonus x%s"):format(UI.FormatMult(mult))

	-- Fortschritt bis zum nächsten Laufband
	local previous = 0
	local nextDef = nil
	for _, row in ipairs(treadmillRows) do
		local required = tonumber(row.Def.Required) or 0
		if steps >= required then
			previous = required
		elseif not nextDef then
			nextDef = row.Def
		end
	end
	if nextDef then
		local required = tonumber(nextDef.Required) or 1
		UI.SetBar(
			treadmillBar,
			(steps - previous) / math.max(1, required - previous),
			("🔓 %s: %s / %s 👟"):format(
				tostring(nextDef.Name),
				Util.FormatNumber(steps),
				Util.FormatNumber(required)
			)
		)
	else
		UI.SetBar(treadmillBar, 1, "🌈 Alle Laufbänder freigeschaltet!")
	end

	for _, row in ipairs(treadmillRows) do
		local def = row.Def
		local required = tonumber(def.Required) or 0
		local rateText = ("+%s 👟 alle 0,5 s"):format(
			UI.FormatSteps((tonumber(def.Rate) or 0) * mult, Util.FormatNumber)
		)
		if row.Rate.Text ~= rateText then
			row.Rate.Text = rateText
		end
		local statusText, statusColor, strokeColor
		if state.BestTreadmill == def.Id then
			statusText, statusColor, strokeColor = "⭐ Dein bestes", Theme.Yellow, Theme.Gold
		elseif steps >= required then
			statusText, statusColor, strokeColor = "✅ Frei", Theme.Cash, Color3.new(0, 0, 0)
		else
			statusText = "🔒 " .. Util.FormatNumber(required) .. " 👟"
			statusColor, strokeColor = Color3.fromRGB(255, 130, 130), Color3.new(0, 0, 0)
		end
		if row.Status.Text ~= statusText then
			row.Status.Text = statusText
			row.Status.TextColor3 = statusColor
			row.Stroke.Color = strokeColor
			row.Stroke.Thickness = if strokeColor == Theme.Gold then 4 else 2
			row.Card.BackgroundTransparency = if steps >= required then 0 else 0.35
		end
	end

	if bootsButton then
		local owned = state.Passes and state.Passes.SpeedBoots == true
		bootsButton.Frame.Visible = not owned
	end
end

-- ---------------------------------------------------------------------
-- REBIRTH
-- ---------------------------------------------------------------------
local rebirthInfo: TextLabel
local rebirthBar: UI.Bar
local rebirthDetail: TextLabel

local function buildRebirth()
	local win = UI.Window("🔥 REBIRTH", 500, 450, Theme.Orange)
	list.Rebirth = win
	local content = win.Content
	rebirthInfo = UI.Label({
		Size = UDim2.new(1, 0, 0, 32),
		Text = "",
		LayoutOrder = 1,
		MaxText = 24,
		Outline = 2,
		Parent = content,
	})
	rebirthBar = UI.Bar({ Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 2, Color = Theme.Orange, Parent = content })
	rebirthDetail = UI.Label({
		Size = UDim2.new(1, 0, 0, 150),
		Text = "",
		Font = Enum.Font.GothamBold,
		TextColor3 = Theme.SubText,
		TextWrapped = true,
		LayoutOrder = 3,
		MaxText = 16,
		Parent = content,
	})
	UI.Button({
		Size = UDim2.new(1, 0, 0, 58),
		Text = "🔥 REBIRTH!",
		Color = Theme.Red,
		LayoutOrder = 4,
		MaxText = 30,
		Parent = content,
	}, function()
		ctx.Request("Rebirth")
	end)
end

local function nextUnlock(rebirths: number): string?
	for _, rarity in ipairs(ctx.Config.Rarities) do
		if not rarity.AdminOnly and (rarity.RequiredRebirths or 0) == rebirths + 1 then
			return rarity.Name
		end
	end
	return nil
end

function Windows.RefreshRebirth(state: any)
	if not state then
		return
	end
	local Util = ctx.Util
	local Config = ctx.Config
	local cash = tonumber(state.Cash) or 0
	local cost = math.max(1, tonumber(state.RebirthCost) or 1)
	local rebirths = tonumber(state.Rebirths) or 0
	rebirthInfo.Text = "🔥 Rebirths: " .. rebirths
	UI.SetBar(rebirthBar, cash / cost, Util.FormatCash(cash) .. " / " .. Util.FormatCash(cost))
	local unlock = nextUnlock(rebirths)
	local detail = (
		"Belohnung:\n• +%d%% Einkommen für immer\n• +%d%% Schritte auf jedem Laufband%s\n\n"
		.. "Du verlierst: Cash, Meteore + Aliens.\nDu behältst: Schritte 👟, Index, Gamepasses."
	):format(
		math.floor((tonumber(Config.RebirthMultPerLevel) or 0) * 100 + 0.5),
		math.floor((tonumber(Config.StepsPerRebirth) or 0.25) * 100 + 0.5),
		if unlock then ("\n• 🔓 " .. unlock .. "-Meteore kaufbar!") else ""
	)
	if rebirthDetail.Text ~= detail then
		rebirthDetail.Text = detail
	end
end

-- ---------------------------------------------------------------------
-- TAGESBONUS
-- ---------------------------------------------------------------------
local dailyInfo: TextLabel
local dailyButton: UI.Button

local function buildDaily()
	local win = UI.Window("🎁 TAGESBONUS", 440, 300, Theme.Purple)
	list.Daily = win
	local content = win.Content
	dailyInfo = UI.Label({
		Size = UDim2.new(1, 0, 0, 70),
		Text = "",
		LayoutOrder = 1,
		TextWrapped = true,
		MaxText = 22,
		Outline = 2,
		Parent = content,
	})
	dailyButton = UI.Button({
		Size = UDim2.new(1, 0, 0, 62),
		Text = "🎁 ABHOLEN",
		Color = Theme.Green,
		LayoutOrder = 2,
		MaxText = 30,
		Parent = content,
	}, function()
		ctx.Request("Daily")
	end)
end

function Windows.RefreshDaily(state: any)
	if not state then
		return
	end
	local streak = tonumber(state.Streak) or 0
	if state.DailyReady then
		dailyInfo.Text = "Dein Bonus ist bereit! 🔥 Streak: " .. streak .. " Tag(e)"
		dailyButton.SetText("🎁 ABHOLEN")
		dailyButton.SetColor(Theme.Green)
	else
		dailyInfo.Text = "Komm morgen wieder! 🔥 Streak: " .. streak .. " Tag(e)"
		dailyButton.SetText("⏳ " .. ctx.Util.FormatTime(tonumber(state.DailyIn) or 0))
		dailyButton.SetColor(GRAY)
	end
end

-- ---------------------------------------------------------------------
-- ALIEN-INDEX
-- ---------------------------------------------------------------------
type IndexCard = {
	Def: any,
	Card: Frame,
	Dot: Frame,
	DotStroke: UIStroke,
	Question: TextLabel,
	Name: TextLabel,
}
type IndexGroup = { Title: string, Header: TextLabel, Cards: { IndexCard }, Color: Color3 }

local indexHeader: TextLabel
local indexBar: UI.Bar
local indexGroups: { IndexGroup } = {}
local indexSignature = ""
local SPECIAL_TITLE = "👑 Admin & Spezial (Bonus)"

-- Aliens, die normale Spieler nie selbst ausbrüten können: aus Admin-Meteoren oder aus Meteoren,
-- die nie aufs Förderband kommen (z.B. Omega). Zählen als Bonus, nicht zum "X/Y"-Ziel.
local function isSpecialAlien(def: any): boolean
	local Config = ctx.Config
	local rarity = Config.RaritiesByName and Config.RaritiesByName[def.Rarity]
	if rarity and rarity.AdminOnly then
		return true
	end
	local meteor = Config.MeteorsById and Config.MeteorsById[def.Meteor]
	return meteor ~= nil and meteor.Spawnable == false
end

local function buildIndex()
	local win = UI.Window("👽 ALIEN-INDEX", 680, 560, Theme.Green)
	list.Index = win
	local content = win.Content
	indexHeader = UI.Label({
		Size = UDim2.new(1, 0, 0, 32),
		Text = "",
		LayoutOrder = 1,
		MaxText = 22,
		Outline = 2,
		Parent = content,
	})
	indexBar = UI.Bar({ LayoutOrder = 2, Color = Theme.Green, MaxText = 16, Parent = content })

	-- Aliens nach Seltenheit sortieren (Reihenfolge wie Config.Rarities),
	-- Admin- und Spezial-Aliens zum Schluss in einer eigenen Bonus-Gruppe
	local byRarity: { [string]: { any } } = {}
	local special: { any } = {}
	for _, def in ipairs(ctx.Aliens.List) do
		if isSpecialAlien(def) then
			table.insert(special, def)
		else
			local group = byRarity[def.Rarity]
			if not group then
				group = {}
				byRarity[def.Rarity] = group
			end
			table.insert(group, def)
		end
	end
	local sections: { { Title: string, Color: Color3, Defs: { any } } } = {}
	for _, rarity in ipairs(ctx.Config.Rarities) do
		local defs = byRarity[rarity.Name]
		if defs and #defs > 0 then
			table.insert(sections, { Title = rarity.Name, Color = rarity.Color, Defs = defs })
		end
	end
	if #special > 0 then
		local adminRarity = ctx.Config.RaritiesByName and ctx.Config.RaritiesByName.Admin
		local color: Color3 = if adminRarity then adminRarity.Color else Theme.Red
		table.insert(sections, { Title = SPECIAL_TITLE, Color = color, Defs = special })
	end
	local order = 10
	for _, section in ipairs(sections) do
		local defs = section.Defs
		order += 1
		local header = UI.Section(content, section.Title, order, section.Color)
		order += 1
		local gridFrame = UI.Grid(content, order, 148, 74)
		local group: IndexGroup = { Title = section.Title, Header = header, Cards = {}, Color = section.Color }
		for i, def in ipairs(defs) do
			local look = def.Look or {}
			local card = UI.Card({ LayoutOrder = i, Parent = gridFrame })
			local dotStroke = UI.Stroke(look.Accent or Color3.new(1, 1, 1), 3)
			local dot = UI.Create("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 8, 0.5, 0),
				Size = UDim2.fromOffset(38, 38),
				BackgroundColor3 = look.Color or section.Color,
				Parent = card,
			}, { UI.Corner(19), dotStroke })
			local question = UI.Label({
				Size = UDim2.fromScale(1, 1),
				Text = "?",
				MaxText = 24,
				Outline = 2,
				Visible = false,
				Parent = dot,
			})
			local nameLabel = UI.Label({
				Position = UDim2.fromOffset(52, 6),
				Size = UDim2.new(1, -58, 0, 40),
				Text = "???",
				TextWrapped = true,
				MaxText = 15,
				Outline = 2,
				Parent = card,
			})
			UI.Label({
				Position = UDim2.fromOffset(52, 48),
				Size = UDim2.new(1, -58, 0, 18),
				Text = tostring(def.Tier),
				TextColor3 = TIER_COLORS[def.Tier] or Theme.SubText,
				MaxText = 13,
				Outline = 1,
				Parent = card,
			})
			table.insert(group.Cards, {
				Def = def,
				Card = card,
				Dot = dot,
				DotStroke = dotStroke,
				Question = question,
				Name = nameLabel,
			})
		end
		table.insert(indexGroups, group)
	end
end

function Windows.RefreshIndex(state: any)
	if not state then
		return
	end
	local index = if type(state.Index) == "table" then state.Index else {}
	-- Nur neu zeichnen, wenn sich etwas geändert hat
	local signature = #index .. ":" .. tostring(index[#index])
	if signature == indexSignature then
		return
	end
	indexSignature = signature
	local found: { [string]: boolean } = {}
	local count = 0 -- alle entdeckten (jedes gibt Einkommens-Bonus)
	local normalFound, normalTotal, specialFound = 0, 0, 0
	for _, id in ipairs(index) do
		local def = ctx.Aliens.ById[id]
		if def and not found[id] then
			found[id] = true
			count += 1
			if isSpecialAlien(def) then
				specialFound += 1
			else
				normalFound += 1
			end
		end
	end
	for _, def in ipairs(ctx.Aliens.List) do
		if not isSpecialAlien(def) then
			normalTotal += 1
		end
	end
	local bonusPer = tonumber(ctx.Config.IndexBonusPerAlien) or 0.01
	local headerText = ("👽 Entdeckt: %d/%d  •  +%s%% Einkommen"):format(
		normalFound,
		normalTotal,
		percentText(count * bonusPer * 100)
	)
	if specialFound > 0 then
		headerText ..= ("  •  👑 +%d Spezial"):format(specialFound)
	end
	indexHeader.Text = headerText
	UI.SetBar(
		indexBar,
		if normalTotal > 0 then normalFound / normalTotal else 0,
		("%d / %d Aliens"):format(normalFound, normalTotal)
	)
	for _, group in ipairs(indexGroups) do
		local groupFound = 0
		for _, card in ipairs(group.Cards) do
			local def = card.Def
			local look = def.Look or {}
			if found[def.Id] then
				groupFound += 1
				card.Name.Text = tostring(def.Name)
				card.Dot.BackgroundColor3 = look.Color or group.Color
				card.DotStroke.Color = look.Accent or Color3.new(1, 1, 1)
				card.Question.Visible = false
				card.Card.BackgroundTransparency = 0
			else
				card.Name.Text = "???"
				card.Dot.BackgroundColor3 = Color3.new(0, 0, 0)
				card.DotStroke.Color = Color3.fromRGB(70, 70, 80)
				card.Question.Visible = true
				card.Card.BackgroundTransparency = 0.45
			end
		end
		group.Header.Text = ("%s  (%d/%d)"):format(group.Title, groupFound, #group.Cards)
	end
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH
-- ---------------------------------------------------------------------
function Windows.Get(name: string): UI.Window?
	return list[name]
end

function Windows.Toggle(name: string)
	local win = list[name]
	if win then
		UI.ToggleWindow(win)
	end
end

function Windows.Open(name: string)
	local win = list[name]
	if win then
		UI.OpenWindow(win)
	end
end

-- Shop auf einem bestimmten Reiter öffnen ("Passes", "Boosts", "Gadgets")
function Windows.OpenShop(tab: string?)
	if tab then
		selectShopTab(tab)
	end
	Windows.Open("Shop")
end

-- Fenster aus anderen Modulen anmelden (z.B. Geschenke, Glücksrad, Aufgaben):
-- Toggle/Open per Name, beim Öffnen und bei neuen Daten wird refresh(state) aufgerufen.
function Windows.Register(name: string, win: UI.Window, refresh: ((state: any) -> ())?)
	list[name] = win
	if refresh then
		refreshers[name] = refresh
		win.OnOpen = function()
			if ctx.State then
				refresh(ctx.State)
			end
		end
	end
end

-- Neue Daten vom Server: nur OFFENE Fenster neu beschreiben (geschlossene beim Öffnen)
function Windows.Refresh(state: any)
	if not state then
		return
	end
	for name, win in pairs(list) do
		local refresh = refreshers[name]
		if refresh and win.IsOpen then
			refresh(state)
		end
	end
end

function Windows.Init(context: any)
	ctx = context
	buildShop()
	buildTreadmills()
	buildRebirth()
	buildDaily()
	buildIndex()
	-- Fenstername -> Aktualisieren (beim Öffnen einmal mit den neuesten Daten füllen)
	local own: { [string]: (state: any) -> () } = {
		Shop = Windows.RefreshShop,
		Treadmills = Windows.RefreshTreadmills,
		Rebirth = Windows.RefreshRebirth,
		Daily = Windows.RefreshDaily,
		Index = Windows.RefreshIndex,
	}
	for name, refresh in pairs(own) do
		local win = list[name]
		if win then
			Windows.Register(name, win, refresh)
		end
	end
	Windows.RefreshShop(nil)

	-- ⭐ Starter-Paket: abgebrochen -> Knopf wieder frei. Gekauft -> bleibt gesperrt, bis der Server
	-- "gekauft" meldet (danach verschwindet der Knopf ganz)
	local starter = ctx.Config.ProductsByKey and ctx.Config.ProductsByKey.StarterPack
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
		if userId ~= player.UserId or not starter or productId ~= starter.Id then
			return
		end
		if not purchased then
			starterPendingUntil = 0
		end
		Windows.RefreshShop(ctx.State)
		if ctx.State then
			ctx.Hud.Refresh(ctx.State)
		end
	end)
end

return Windows
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">WorldFX</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  WELT-ANIMATIONEN (alles lokal auf deinem Gerät -> butterweich, kein Server-Lag)
--   • Meteore auf dem großen Laufband: Position = Start + Richtung * Tempo * (Zeit seit Start),
--     dazu sanftes Wippen + Taumeln + Drehen, leuchtende Meteore pulsieren
--     (sichtbare in der Nähe jedes Frame, weit weg seltener, außerhalb des Sichtfelds noch seltener)
--   • Streifen auf dem Laufband und auf den Treadmills laufen gleichmäßig durch und tauchen an den
--     Enden unter die Lauffläche (kein Aufploppen)
--   • Aliens leben: Atmen mit Squash & Stretch, kleine Hüpfer, Blinzeln, drehen sich zu Spielern
--   • Eier wackeln die letzten Sekunden immer stärker, Risse leuchten auf; frisch geschlüpfte
--     Aliens ploppen mit Overshoot herein
--   • Regenbogen-Teile färben sich durch
--   • Umrisse (Highlights): nur die nächsten paar sind an (Roblox zeigt max. 31, jeder kostet Leistung)
--   • Lava-Feuer an Band-Meteoren (Attribut "LavaFire"): nur die nächsten paar brennen
--   • Meteore in der Base zeigen "🐣 Schlüpft in m:ss"
--   • Laufband-Schilder zeigen, welche Laufbänder DU schon freigeschaltet hast
--  Arbeit pro Frame ist begrenzt: höchstens MAX_ANIM Aliens in ANIM_RANGE Studs werden animiert
--  (jedes ca. 30x pro Sekunde), weit entfernte Dinge werden seltener oder gar nicht bewegt.
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local UI = require(script.Parent:WaitForChild("UI"))

local WorldFX = {}

local ctx: any = nil
local fxFolder: Folder? = nil

local NEAR_DISTANCE = 120 -- sichtbar und näher dran: jedes Frame bewegen (weiter weg fällt der 4er-Takt nicht auf)
local FAR_FRAME_SKIP = 4 -- weiter weg: nur jedes 4. Frame
local BEHIND_FRAME_SKIP = 8 -- außerhalb des Sichtfelds (nicht zu sehen): nur jedes 8. Frame
local CLOSE_DISTANCE = 40 -- so nah immer jedes Frame (auch knapp hinter/neben der Kamera sichtbar)
local VIEW_MARGIN = math.rad(12) -- Sichtfeld etwas größer rechnen (große Meteore am Bildrand)
local MAX_NEAR_BELT = 60 -- mehr nahe Band-Meteore pro Frame -> der Rest nur jedes 2. Frame
local STRIPE_NEAR = 140 -- Hauptband-Streifen weiter weg nur jedes 4. Frame (dünn, fällt nicht auf)
local STRIPE_RANGE = 320 -- Streifen auf Treadmills nur in der Nähe bewegen
local STRIPE_SINK = 0.14 -- so tief tauchen die Streifen an den Enden unter die Lauffläche
local SLOW_INTERVAL = 1 / 30 -- Alien-Animation + Regenbogen höchstens 30x pro Sekunde
local SCAN_INTERVAL = 0.5 -- so oft wird neu gewählt, welche Aliens leben / welche Umrisse an sind
local CLEANUP_INTERVAL = 1 -- so oft fliegen zerstörte Objekte aus den Listen
local MAX_HIGHLIGHTS = 12 -- so viele Umrisse höchstens gleichzeitig (die nächsten)
local HIGHLIGHT_RANGE = 150
local MAX_LAVA_FIRES = 6 -- so viele Lava-Feuer am Förderband brennen höchstens gleichzeitig (die nächsten)
local LAVA_FIRE_RANGE = 60
local HATCH_INTERVAL = 0.2 -- Schlüpf-Countdown 5x pro Sekunde
local HATCH_RANGE = 170
local RAINBOW_RANGE = 400
local BELT_SPIN = 0.6 -- sanfte Drehung der Meteore auf dem Band (rad/s)
local BELT_BOB_SPEED = 2.2 -- Wippen der Band-Meteore (rad/s)
local BELT_TILT = 0.12 -- Taumeln der Band-Meteore (rad)

-- Aliens
local ANIM_RANGE = 120 -- nur Aliens in Kameranähe animieren
local MAX_ANIM = 60 -- höchstens so viele (die nächsten) gleichzeitig
local MAX_SQUASH = 20 -- so viele (die nächsten) werden zusätzlich gestaucht/gestreckt
local SQUASH_RANGE = 70
local LOOK_RANGE = 35 -- Spieler so nah -> Alien dreht sich zu ihm
local MAX_TURN = math.rad(65) -- höchstens so weit aus der Ruhe-Richtung drehen
local TURN_SPEED = 3.5 -- wie schnell es sich dreht (1/s)
local HOP_TIME = 0.62 -- Dauer eines Hüpfers
local HOP_MIN = 3 -- Pause zwischen zwei Hüpfern: HOP_MIN + 0..HOP_RANGE Sekunden
local HOP_RANGE = 6
local BLINK_TIME = 0.14

-- Schlüpfen
local WOBBLE_TIME = 3 -- so viele Sekunden vor dem Schlüpfen wackelt das Ei
local WOBBLE_GRACE = 4 -- so lange nach HatchAt weiterwackeln (bis der Server schlüpfen lässt)
local MAX_WOBBLE = 8 -- höchstens so viele Eier wackeln gleichzeitig
local CRACKS_PER_EGG = 3
local EGG_DUE_WINDOW = 2.5 -- Ei verschwindet so kurz vor/nach HatchAt -> zählt als geschlüpft
local POP_TIME = 0.5 -- Dauer des Reinploppens
local POP_DELAY = 0.06 -- kurz klein bleiben (Lichtblitz)
local POP_OVERSHOOT = 2.4 -- wie weit es über die Endgröße hinaus federt
local POP_MIN = 0.02
local POP_MATCH_DISTANCE = 6 -- Ei/Effekt und neues Alien höchstens so weit auseinander
local RECENT_TIME = 1.5 -- so lange werden neue Aliens / verschwundene Eier gemerkt

local HATCH_COLOR = Color3.fromRGB(255, 225, 120)

-- Wiederverwendete Listen für workspace:BulkMoveTo (keine neuen Tabellen pro Frame)
local moveParts: { BasePart } = {}
local moveCFrames: { CFrame } = {}
local frameNumber = 0

-- ---------------------------------------------------------------------
-- METEORE AUF DEM LAUFBAND
-- ---------------------------------------------------------------------
type BeltRecord = {
	Part: BasePart,
	Start: Vector3,
	Dir: Vector3,
	Speed: number,
	T0: number,
	MaxDist: number,
	Phase: number,
	Slot: number,
	Fresh: boolean, -- gerade angekommen -> sofort an die richtige Stelle (steht sonst am Bandstart)
	Bob: number, -- Wipp-Höhe (nach Größe)
	Light: PointLight?, -- leuchtende Meteore pulsieren
	LightBase: number,
}

local beltRecords: { BeltRecord } = {}
local beltByPart: { [Instance]: BeltRecord } = {}
local beltLength = 440

local function removeBeltRecord(record: BeltRecord)
	beltByPart[record.Part] = nil
	local index = table.find(beltRecords, record)
	if index then
		beltRecords[index] = beltRecords[#beltRecords]
		beltRecords[#beltRecords] = nil
	end
end

-- true = aufgenommen (oder kein Meteor), false = Attribute fehlen noch
local function addBeltMeteor(inst: Instance): boolean
	if not inst:IsA("BasePart") then
		return true
	end
	if beltByPart[inst] then
		return true
	end
	local t0 = inst:GetAttribute("BeltT0")
	local start = inst:GetAttribute("BeltStart")
	local dir = inst:GetAttribute("BeltDir")
	local speed = inst:GetAttribute("BeltSpeed")
	if type(t0) ~= "number" or typeof(start) ~= "Vector3" or typeof(dir) ~= "Vector3" or type(speed) ~= "number" then
		return false
	end
	local direction: Vector3 = if dir.Magnitude > 0.001 then dir.Unit else Vector3.zAxis
	local record: BeltRecord = {
		Part = inst,
		Start = start,
		Dir = direction,
		Speed = speed,
		T0 = t0,
		MaxDist = beltLength + 6,
		Phase = math.random() * math.pi * 2,
		Slot = math.random(0, BEHIND_FRAME_SKIP - 1),
		Fresh = true,
		Bob = math.clamp(inst.Size.Y * 0.07, 0.08, 0.4),
		Light = nil,
		LightBase = 0,
	}
	local light = inst:FindFirstChildOfClass("PointLight")
	if light then
		record.Light = light
		record.LightBase = light.Brightness
	end
	beltByPart[inst] = record
	table.insert(beltRecords, record)
	return true
end

local function watchBeltMeteor(inst: Instance)
	if addBeltMeteor(inst) then
		return
	end
	-- Attribute kommen evtl. erst nach dem Einfügen -> warten
	local connection: RBXScriptConnection? = nil
	connection = inst.AttributeChanged:Connect(function()
		if addBeltMeteor(inst) or not inst.Parent then
			if connection then
				connection:Disconnect()
			end
		end
	end)
end

-- Kosinus des halben Sichtfelds (Bild-Diagonale + Rand): rel:Dot(look) < Abstand * viewCos = nicht im Bild
local function viewCos(camera: Camera): number
	local size = camera.ViewportSize
	local aspect = if size.Y > 0 then size.X / size.Y else 16 / 9
	local halfVertical = math.rad(camera.FieldOfView) / 2
	local halfDiagonal = math.atan(math.tan(halfVertical) * math.sqrt(1 + aspect * aspect))
	return math.cos(math.min(halfDiagonal + VIEW_MARGIN, math.pi / 2))
end

-- Gibt die Anzahl der eingetragenen Teile zurück.
-- Viele Meteore (bis ~160 im Schauer): ganz nahe immer, sichtbare in der Nähe jedes Frame, sichtbare
-- weit weg jedes 4., außerhalb des Sichtfelds nur jedes 8. Frame (dreht man sich, sind sie
-- spätestens nach 8 Frames richtig).
local function stepBelt(now: number, camPos: Vector3, look: Vector3, cosLimit: number, count: number): number
	local near = 0
	for i = #beltRecords, 1, -1 do
		local record = beltRecords[i]
		local part = record.Part
		if part.Parent == nil then
			removeBeltRecord(record)
		else
			local elapsed = now - record.T0
			local dist = math.clamp(record.Speed * elapsed, 0, record.MaxDist)
			local pos = record.Start + record.Dir * dist
			local rel = pos - camPos
			local distance = rel.Magnitude
			local slot = frameNumber + record.Slot
			-- ganz nah (Prompts!), sichtbar in der Nähe und neu angekommen: jedes Frame
			local due = true
			if record.Fresh then
				record.Fresh = false
			elseif distance >= CLOSE_DISTANCE then
				if rel:Dot(look) < distance * cosLimit then
					due = slot % BEHIND_FRAME_SKIP == 0 -- außerhalb des Sichtfelds
				elseif distance >= NEAR_DISTANCE then
					due = slot % FAR_FRAME_SKIP == 0 -- sichtbar, aber weit weg
				else
					near += 1
					if near > MAX_NEAR_BELT then
						due = slot % 2 == 0 -- sehr viele nahe (Schauer): Rest jedes 2. Frame
					end
				end
			end
			if due then
				local phase = record.Phase
				local angle = elapsed * BELT_SPIN + phase
				local c, s = math.cos(angle), math.sin(angle)
				-- sanftes Taumeln (Kippen um die eigene X-Achse) + Wippen
				local tilt = math.sin(elapsed * 1.3 + phase) * BELT_TILT
				local ct, st = math.cos(tilt), math.sin(tilt)
				local bob = math.sin(elapsed * BELT_BOB_SPEED + phase) * record.Bob
				count += 1
				moveParts[count] = part
				-- Drehung um die Hochachse * Kippen, direkt als Matrix (nur EIN neues CFrame)
				moveCFrames[count] =
					CFrame.new(pos.X, pos.Y + bob, pos.Z, c, s * st, s * ct, 0, ct, -st, -s, c * st, c * ct)
				local light = record.Light
				if light and distance < NEAR_DISTANCE then
					-- Glühen pulsiert leicht
					light.Brightness = record.LightBase * (0.8 + 0.3 * math.sin(elapsed * 3.1 + phase))
				end
			end
		end
	end
	return count
end

-- ---------------------------------------------------------------------
-- STREIFEN (lokale Teile, die über Band und Treadmills laufen)
-- ---------------------------------------------------------------------
type StripeSet = {
	Parts: { BasePart },
	Origin: Vector3, -- Startpunkt auf der Oberfläche
	Dir: Vector3, -- Laufrichtung
	Rot: { number }, -- Drehmatrix (9 Zahlen)
	Length: number,
	Spacing: number,
	Speed: number,
	Center: Vector3,
	Always: boolean, -- true = immer bewegen (Hauptband)
}

local stripeSets: { StripeSet } = {}

-- Rainbow-Liste (weiter unten) wird auch von den Streifen benutzt
local addRainbow: (inst: Instance) -> ()

local function makeStripeSet(
	surfaceCFrame: CFrame,
	length: number,
	width: number,
	speed: number,
	spacing: number,
	colors: { normal: Color3, accent: Color3, rainbow: boolean, accentEvery: number },
	always: boolean
): StripeSet?
	local folder = fxFolder
	if not folder or length <= 1 or width <= 0.5 then
		return nil
	end
	local count = math.max(1, math.floor(length / spacing))
	spacing = length / count
	local dir = surfaceCFrame.LookVector
	local origin = surfaceCFrame.Position - dir * (length / 2)
	local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = surfaceCFrame:GetComponents()
	local set: StripeSet = {
		Parts = {},
		Origin = origin,
		Dir = dir,
		Rot = { r00, r01, r02, r10, r11, r12, r20, r21, r22 },
		Length = length,
		Spacing = spacing,
		Speed = speed,
		Center = surfaceCFrame.Position,
		Always = always,
	}
	for i = 1, count do
		local accent = colors.accentEvery > 0 and i % colors.accentEvery == 0
		-- gleich an die richtige Stelle setzen (Regenbogen-Welle hängt von der Position ab)
		local startPos = origin + dir * ((i - 0.5) * spacing)
		local stripe = UI.Create("Part", {
			Name = "Stripe",
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Size = Vector3.new(math.max(0.4, width - 0.8), 0.06, if accent then 0.5 else 0.7),
			Material = if accent then Enum.Material.Neon else Enum.Material.SmoothPlastic,
			Color = if accent then colors.accent else colors.normal,
			CFrame = surfaceCFrame.Rotation + startPos,
			Parent = folder,
		})
		if accent and colors.rainbow then
			stripe:SetAttribute("Rainbow", true)
			addRainbow(stripe)
		end
		table.insert(set.Parts, stripe)
	end
	table.insert(stripeSets, set)
	return set
end

local function stepStripes(now: number, camPos: Vector3, look: Vector3, cosLimit: number, count: number): number
	for _, set in ipairs(stripeSets) do
		if set.Always or (set.Center - camPos).Magnitude < STRIPE_RANGE then
			local rot = set.Rot
			local r00, r01, r02, r10, r11, r12, r20, r21, r22 =
				rot[1], rot[2], rot[3], rot[4], rot[5], rot[6], rot[7], rot[8], rot[9]
			local shift = (now * set.Speed) % set.Length
			local thin = set.Always -- langes Hauptband: weit entfernte Streifen seltener bewegen
			-- Hochachse der Streifen (2. Spalte der Drehmatrix): an den Enden darunter wegtauchen,
			-- statt am Ende zu verschwinden und am Anfang aufzuploppen
			local up = Vector3.new(r01, r11, r21)
			local length, edge = set.Length, set.Spacing * 0.6
			for i, stripe in ipairs(set.Parts) do
				local s = ((i - 0.5) * set.Spacing + shift) % length
				local pos = set.Origin + set.Dir * s
				local toEnd = math.min(s, length - s)
				if toEnd < edge then
					local k = 1 - toEnd / edge
					pos -= up * (k * k * STRIPE_SINK)
				end
				local rel = pos - camPos
				local distance = rel.Magnitude
				local due = true
				if distance >= CLOSE_DISTANCE and rel:Dot(look) < distance * cosLimit then
					due = (frameNumber + i) % BEHIND_FRAME_SKIP == 0 -- nicht im Bild
				elseif thin and distance >= STRIPE_NEAR then
					due = (frameNumber + i) % FAR_FRAME_SKIP == 0
				end
				if due then
					count += 1
					moveParts[count] = stripe
					moveCFrames[count] = CFrame.new(pos.X, pos.Y, pos.Z, r00, r01, r02, r10, r11, r12, r20, r21, r22)
				end
			end
		end
	end
	return count
end

-- Hauptband: Streifen quer über die ganze Länge
local function setupMainBelt(belt: Instance)
	if not belt:IsA("BasePart") then
		return
	end
	local start = belt:GetAttribute("BeltStart")
	local dir = belt:GetAttribute("BeltDir")
	local length = tonumber(belt:GetAttribute("BeltLength")) or belt.Size.Z
	local width = tonumber(belt:GetAttribute("BeltWidth")) or belt.Size.X
	local speed = tonumber(belt:GetAttribute("BeltSpeed")) or tonumber(ctx.Config.BeltSpeed) or 9
	if typeof(start) ~= "Vector3" then
		start = belt.Position + Vector3.new(0, belt.Size.Y / 2, -belt.Size.Z / 2)
	end
	if typeof(dir) ~= "Vector3" or dir.Magnitude < 0.001 then
		dir = Vector3.zAxis
	end
	local direction: Vector3 = (dir :: Vector3).Unit
	beltLength = length
	for _, record in ipairs(beltRecords) do
		record.MaxDist = beltLength + 6
	end
	local startPos: Vector3 = start :: Vector3
	local center = startPos + direction * (length / 2) + Vector3.new(0, 0.04, 0)
	makeStripeSet(CFrame.lookAt(center, center + direction), length, width, speed, 5, {
		normal = Color3.fromRGB(72, 72, 86),
		accent = Color3.fromRGB(30, 150, 230),
		rainbow = false,
		accentEvery = 4,
	}, true)
end

-- ---------------------------------------------------------------------
-- TREADMILLS (Laufbänder auf dem Spawn-Platz)
-- ---------------------------------------------------------------------
type TreadmillInfo = { Model: Model, Id: string }
local treadmills: { TreadmillInfo } = {}
local treadmillSeen: { [Instance]: boolean } = {}
local lastSteps = 0
local lastBest: string? = nil
local signKey = ""
local updateSigns: () -> ()

local function treadmillDef(id: string): any
	local list = ctx.Config.Treadmills
	if type(list) ~= "table" then
		return nil
	end
	for _, def in ipairs(list) do
		if def.Id == id then
			return def
		end
	end
	return nil
end

local function setupTreadmill(model: Instance)
	if not model:IsA("Model") or treadmillSeen[model] then
		return
	end
	local id = model:GetAttribute("TreadmillId")
	local belt = model.PrimaryPart or model:FindFirstChild("Belt")
	if type(id) ~= "string" or not belt or not belt:IsA("BasePart") then
		return
	end
	treadmillSeen[model] = true
	table.insert(treadmills, { Model = model, Id = id })

	local def = treadmillDef(id)
	local color: Color3 = if def and typeof(def.Color) == "Color3" then def.Color else Color3.new(1, 1, 1)
	local dir = belt:GetAttribute("BeltDir")
	local speed = tonumber(belt:GetAttribute("BeltSpeed")) or 14
	local cf = belt.CFrame
	local worldDir: Vector3 = if typeof(dir) == "Vector3" and dir.Magnitude > 0.001 then dir.Unit else -cf.LookVector
	-- Richtung auf die nächste Achse der Lauffläche legen (Länge/Breite der Fläche bestimmen)
	local localDir = cf:VectorToObjectSpace(worldDir)
	local alongZ = math.abs(localDir.Z) >= math.abs(localDir.X)
	local length = if alongZ then belt.Size.Z else belt.Size.X
	local width = if alongZ then belt.Size.X else belt.Size.Z
	local axis = if alongZ
		then Vector3.new(0, 0, if localDir.Z >= 0 then 1 else -1)
		else Vector3.new(if localDir.X >= 0 then 1 else -1, 0, 0)
	local direction = cf:VectorToWorldSpace(axis)
	local top = cf:PointToWorldSpace(Vector3.new(0, belt.Size.Y / 2 + 0.035, 0))
	makeStripeSet(CFrame.lookAt(top, top + direction, cf.UpVector), length, width, speed, 2.5, {
		normal = Color3.fromRGB(48, 48, 58),
		accent = color,
		rainbow = id == "Regenbogen" or (def ~= nil and def.Rainbow == true),
		accentEvery = 3,
	}, false)
	signKey = "" -- Schilder beim nächsten Mal neu schreiben
	updateSigns()
end

local function findSignLabel(model: Model, name: string): TextLabel?
	local sign = model:FindFirstChild("Sign", true)
	local frame = sign and sign:FindFirstChild("Frame")
	local labelObj = frame and frame:FindFirstChild(name)
	if labelObj and labelObj:IsA("TextLabel") then
		return labelObj
	end
	return nil
end

-- Schilder an den Laufbändern: freigeschaltet / gesperrt / dein bestes (nur bei Änderung)
updateSigns = function()
	if not ctx then
		return
	end
	local best = lastBest
	local unlocked = 0
	for _, info in ipairs(treadmills) do
		local def = treadmillDef(info.Id)
		local required = def and tonumber(def.Required) or tonumber(info.Model:GetAttribute("Required")) or 0
		if lastSteps >= required then
			unlocked += 1
		end
	end
	local key = unlocked .. "|" .. tostring(best) .. "|" .. #treadmills
	if key == signKey then
		return
	end
	signKey = key
	local Util = ctx.Util
	for _, info in ipairs(treadmills) do
		local def = treadmillDef(info.Id)
		local required = def and tonumber(def.Required) or tonumber(info.Model:GetAttribute("Required")) or 0
		local lockLabel = findSignLabel(info.Model, "LockLabel")
		if lockLabel then
			if best == info.Id then
				lockLabel.Text = "⭐ Dein bestes Laufband!"
				lockLabel.TextColor3 = Color3.fromRGB(255, 220, 60)
			elseif lastSteps >= required then
				lockLabel.Text = "✅ Freigeschaltet"
				lockLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
			else
				lockLabel.Text = "🔒 ab " .. Util.FormatNumber(required) .. " 👟"
				lockLabel.TextColor3 = Color3.fromRGB(255, 130, 130)
			end
		end
	end
end

function WorldFX.UpdateTreadmills(steps: number, best: string?)
	lastSteps = tonumber(steps) or 0
	lastBest = best
	updateSigns()
end

-- ---------------------------------------------------------------------
-- LEBENDIGE ALIENS (Idle-Animation, alles lokal)
--  • Atmen mit Squash & Stretch (Body wird lokal gestaucht/gestreckt, Volumen bleibt gleich)
--  • ab und zu ein kleiner Hüpfer: Anlauf (stauchen) -> Sprung (strecken) -> Landung (federn)
--  • Augen blinzeln (Teile mit Attribut "Eye" sinken kurz in den Kopf)
--  • drehen sich sanft zum nächsten Spieler in der Nähe (Ziel nur alle SCAN_INTERVAL s neu)
--  • Geister/Kristalle schweben statt zu hüpfen, Roboter hüpfen steif (ohne Stauchen)
-- Pro Alien werden die Teile + ihre Lage zum Ruhe-Pivot EINMAL gemerkt (Position + Drehmatrix als
-- Zahlen). Jedes Frame kommt nur ein Teil der Aliens dran (jedes ca. 30x pro Sekunde), alle Teile
-- werden mit EINEM workspace:BulkMoveTo bewegt – pro Teil entsteht genau ein neues CFrame.
-- ---------------------------------------------------------------------
type AnimRecord = {
	Model: Model,
	Primary: BasePart?,
	PrimaryIndex: number,
	Base: CFrame?, -- Ruhe-Pivot (wie vom Server gesetzt)
	Parts: { BasePart },
	Pos: { Vector3 }, -- Teil-Position relativ zum Ruhe-Pivot
	Rot: { number }, -- Teil-Drehung relativ zum Ruhe-Pivot (9 Zahlen je Teil)
	EyeIn: { Vector3 }, -- Augen: Richtung + Weg ins Gesicht beim Blinzeln (sonst 0)
	HasEyes: boolean,
	LastPrimary: CFrame?, -- zuletzt von uns gesetzte Lage des PrimaryPart
	Rev: any, -- Attribut "Rev" (ändert der Server nach dem Wachsen)
	BodySize: Vector3?, -- echte Body-Größe (Attribut "BaseSize" vom Server)
	CanSquash: boolean,
	Style: string, -- "Hop" | "Float" | "Stiff"
	Phase: number,
	Height: number,
	HopHeight: number,
	Slot: number,
	Dist: number,
	Moved: boolean,
	Squash: boolean, -- darf gerade gestaucht werden (nur die nächsten MAX_SQUASH)
	Resized: boolean, -- Body-Größe gerade lokal verändert
	Yaw: number,
	YawTarget: number,
	HopAt: number,
	HopStart: number,
	BlinkAt: number,
	BlinkStart: number,
	Last: number,
}

local ANIM_STYLES: { [string]: string } = { Ghost = "Float", Crystal = "Float", Robot = "Stiff" }
local NO_SQUASH: { [string]: boolean } = { Crystal = true, Robot = true }
local EYE_NAMES: { [string]: boolean } = { Eye = true, Pupil = true, Iris = true }

local animRecords: { AnimRecord } = {}
local animSeen: { [Instance]: AnimRecord } = {}
local animCandidates: { AnimRecord } = {} -- wiederverwendet (keine neuen Tabellen pro Durchlauf)
local activeAnims: { AnimRecord } = {}
local animParts: { BasePart } = {}
local animCFrames: { CFrame } = {}
local resetParts: { BasePart } = {}
local resetCFrames: { CFrame } = {}
local playerRoots: { Vector3 } = {}
local popping: { [Instance]: boolean } = {} -- Aliens, die gerade "reinploppen" (nicht wippen)

local function addAnim(inst: Instance): AnimRecord?
	if not inst:IsA("Model") or inst:GetAttribute("Bob") ~= true then
		return nil
	end
	local existing = animSeen[inst]
	if existing then
		return existing
	end
	local top = tonumber(inst:GetAttribute("TopHeight")) or 3
	local archetype = inst:GetAttribute("Archetype")
	local style = if type(archetype) == "string" then ANIM_STYLES[archetype] or "Hop" else "Hop"
	local record: AnimRecord = {
		Model = inst,
		Primary = nil,
		PrimaryIndex = 0,
		Base = nil,
		Parts = {},
		Pos = {},
		Rot = {},
		EyeIn = {},
		HasEyes = false,
		LastPrimary = nil,
		Rev = nil,
		BodySize = nil,
		CanSquash = not (type(archetype) == "string" and NO_SQUASH[archetype] == true),
		Style = style,
		Phase = math.random() * math.pi * 2,
		Height = top,
		HopHeight = math.clamp(top * (if style == "Stiff" then 0.06 else 0.12), 0.25, 1.1),
		Slot = math.random(0, 7),
		Dist = math.huge,
		Moved = false,
		Squash = false,
		Resized = false,
		Yaw = 0,
		YawTarget = 0,
		HopAt = 0,
		HopStart = -1,
		BlinkAt = 0,
		BlinkStart = -1,
		Last = 0,
	}
	animSeen[inst] = record
	table.insert(animRecords, record)
	return record
end

-- Echte Body-Größe (der Server schreibt sie als Attribut "BaseSize", auch nach dem Wachsen)
local function realBodySize(record: AnimRecord, primary: BasePart): Vector3?
	local size = primary:GetAttribute("BaseSize")
	if typeof(size) == "Vector3" then
		return size
	end
	if not record.Resized then
		return primary.Size
	end
	return record.BodySize
end

-- Ruhe-Lage neu merken (erstes Mal, oder der Server hat das Alien verschoben/vergrößert)
local function rebaseAnim(record: AnimRecord): boolean
	local model = record.Model
	local primary = model.PrimaryPart
	if not primary then
		return false
	end
	-- Body zuerst auf seine echte Größe (falls wir ihn gerade gestaucht hatten)
	local bodySize = realBodySize(record, primary)
	if bodySize and record.Resized and primary.Size ~= bodySize then
		primary.Size = bodySize
	end
	record.Resized = false
	record.BodySize = bodySize
	local base = model:GetPivot()
	local inverse = base:Inverse()
	table.clear(record.Parts)
	table.clear(record.Pos)
	table.clear(record.Rot)
	table.clear(record.EyeIn)
	record.PrimaryIndex = 0
	record.HasEyes = false
	local rot = record.Rot
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local rel = inverse * d.CFrame
			local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = rel:GetComponents()
			table.insert(record.Parts, d)
			table.insert(record.Pos, rel.Position)
			local k = #rot
			rot[k + 1], rot[k + 2], rot[k + 3] = r00, r01, r02
			rot[k + 4], rot[k + 5], rot[k + 6] = r10, r11, r12
			rot[k + 7], rot[k + 8], rot[k + 9] = r20, r21, r22
			local eyeIn = Vector3.zero
			if d:GetAttribute("Eye") == true or EYE_NAMES[d.Name] then
				-- lokale +Z-Achse des Auges = nach innen (Augen schauen nach -Z)
				local depth = math.max(d.Size.X, d.Size.Y) * 0.6
				eyeIn = Vector3.new(r02, r12, r22) * depth
				record.HasEyes = true
			end
			table.insert(record.EyeIn, eyeIn)
			if d == primary then
				record.PrimaryIndex = #record.Parts
			end
		end
	end
	-- Stauchen nur bei aufrechtem Body, der kein Ball ist (Bälle lassen sich nicht verzerren)
	local relPrimary = inverse * primary.CFrame
	local upright = relPrimary.UpVector.Y > 0.995
	local isBall = primary:IsA("Part") and primary.Shape == Enum.PartType.Ball
	if not upright or isBall or bodySize == nil then
		record.CanSquash = false
	end
	record.Primary = primary
	record.Base = base
	record.LastPrimary = primary.CFrame
	record.Rev = model:GetAttribute("Rev")
	record.Moved = false
	return record.PrimaryIndex > 0
end

-- Pose eines Aliens in die Listen eintragen (Gibt die neue Anzahl zurück).
-- yaw = Drehung um die Hochachse, lift = Anheben, sy = Stauchung (1 = normal), blink = 0..1
local function poseAnim(
	record: AnimRecord,
	base: CFrame,
	yaw: number,
	lift: number,
	sy: number,
	blink: number,
	parts: { BasePart },
	cframes: { CFrame },
	count: number
): number
	local px, py, pz, b00, b01, b02, b10, b11, b12, b20, b21, b22 = base:GetComponents()
	local c, s = math.cos(yaw), math.sin(yaw)
	-- M = Basis-Drehung * Drehung um Y (Spalten 0 und 2 ändern sich, Spalte 1 bleibt)
	local m00, m10, m20 = b00 * c - b02 * s, b10 * c - b12 * s, b20 * c - b22 * s
	local m01, m11, m21 = b01, b11, b21
	local m02, m12, m22 = b00 * s + b02 * c, b10 * s + b12 * c, b20 * s + b22 * c
	local sx = 1 / math.sqrt(sy)
	local pos, rot, eyeIn = record.Pos, record.Rot, record.EyeIn
	local primaryIndex = record.PrimaryIndex
	for i, part in ipairs(record.Parts) do
		local p = pos[i]
		local vx, vy, vz = p.X * sx, p.Y * sy + lift, p.Z * sx
		if blink > 0 then
			local e = eyeIn[i]
			vx += e.X * blink
			vy += e.Y * blink
			vz += e.Z * blink
		end
		local k = (i - 1) * 9
		local r00, r01, r02 = rot[k + 1], rot[k + 2], rot[k + 3]
		local r10, r11, r12 = rot[k + 4], rot[k + 5], rot[k + 6]
		local r20, r21, r22 = rot[k + 7], rot[k + 8], rot[k + 9]
		local cf = CFrame.new(
			px + m00 * vx + m01 * vy + m02 * vz,
			py + m10 * vx + m11 * vy + m12 * vz,
			pz + m20 * vx + m21 * vy + m22 * vz,
			m00 * r00 + m01 * r10 + m02 * r20,
			m00 * r01 + m01 * r11 + m02 * r21,
			m00 * r02 + m01 * r12 + m02 * r22,
			m10 * r00 + m11 * r10 + m12 * r20,
			m10 * r01 + m11 * r11 + m12 * r21,
			m10 * r02 + m11 * r12 + m12 * r22,
			m20 * r00 + m21 * r10 + m22 * r20,
			m20 * r01 + m21 * r11 + m22 * r21,
			m20 * r02 + m21 * r12 + m22 * r22
		)
		count += 1
		parts[count] = part
		cframes[count] = cf
		if i == primaryIndex then
			record.LastPrimary = cf
		end
	end
	return count
end

-- Einmal zurück auf die Ruhe-Lage (z.B. zu weit weg): Teile exakt an ihren Platz, Body-Größe zurück
local function resetAnim(record: AnimRecord)
	local base = record.Base
	local primary = record.Primary
	if record.Resized and primary and record.BodySize and primary.Parent then
		primary.Size = record.BodySize
	end
	record.Resized = false
	if base and primary and record.Moved and primary:IsDescendantOf(workspace) and not popping[record.Model] then
		table.clear(resetParts)
		table.clear(resetCFrames)
		local count = poseAnim(record, base, 0, 0, 1, 0, resetParts, resetCFrames, 0)
		if count > 0 then
			workspace:BulkMoveTo(resetParts, resetCFrames, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end
	record.Moved = false
	record.Yaw = 0
	record.HopStart = -1
	record.BlinkStart = -1
end

local function byDistance(a: AnimRecord, b: AnimRecord): boolean
	return a.Dist < b.Dist
end

-- Positionen aller Spieler-Charaktere (für "zum Spieler drehen"), nur alle SCAN_INTERVAL s
local function gatherPlayerRoots()
	table.clear(playerRoots)
	for _, plr in ipairs(Players:GetPlayers()) do
		local character = plr.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			table.insert(playerRoots, root.Position)
		end
	end
end

-- Blickrichtung: zum nächsten Spieler in LOOK_RANGE (begrenzt), sonst ab und zu umschauen
local function chooseYaw(record: AnimRecord, base: CFrame)
	local basePos = base.Position
	local best = LOOK_RANGE
	local target: Vector3? = nil
	for _, rootPos in ipairs(playerRoots) do
		local d = (rootPos - basePos).Magnitude
		if d < best and d > 1 then
			best = d
			target = rootPos
		end
	end
	if target then
		local rel = base:PointToObjectSpace(target)
		record.YawTarget = math.clamp(math.atan2(-rel.X, -rel.Z), -MAX_TURN, MAX_TURN)
	elseif math.random() < 0.12 then
		record.YawTarget = (math.random() - 0.5) * 0.7
	end
end

-- Alle SCAN_INTERVAL Sekunden: die nächsten MAX_ANIM Aliens in Reichweite animieren
local function scanAnim(camPos: Vector3)
	gatherPlayerRoots()
	local count = 0
	for i = #animRecords, 1, -1 do
		local record = animRecords[i]
		local model = record.Model
		if model.Parent == nil or not model:IsDescendantOf(workspace) then
			-- zerstört (auch wenn nur der Ordner darüber weg ist, z.B. Foto-Deko)
			animSeen[model] = nil
			popping[model] = nil
			animRecords[i] = animRecords[#animRecords]
			animRecords[#animRecords] = nil
		else
			local pivot = record.Base or model:GetPivot()
			record.Dist = (pivot.Position - camPos).Magnitude
			if record.Dist <= ANIM_RANGE then
				count += 1
				animCandidates[count] = record
			else
				resetAnim(record)
			end
		end
	end
	for i = #animCandidates, count + 1, -1 do
		animCandidates[i] = nil
	end
	table.sort(animCandidates, byDistance)
	for i = MAX_ANIM + 1, count do
		resetAnim(animCandidates[i])
	end
	table.clear(activeAnims)
	for i = 1, math.min(count, MAX_ANIM) do
		local record = animCandidates[i]
		activeAnims[i] = record
		local squash = i <= MAX_SQUASH and record.Dist <= SQUASH_RANGE
		if not squash and record.Resized and record.Primary and record.BodySize then
			record.Primary.Size = record.BodySize
			record.Resized = false
		end
		record.Squash = squash
		local base = record.Base
		if base then
			chooseYaw(record, base)
		end
	end
end

-- Hüpfer: u = 0..1 -> (Anheben, Stauchung)
local function hopShape(u: number, height: number): (number, number)
	if u < 0.18 then -- Anlauf: in die Knie gehen
		local k = u / 0.18
		return 0, 1 - 0.17 * math.sin(k * math.pi * 0.5)
	elseif u < 0.7 then -- Flug: gestreckt hoch, leicht gestaucht runter
		local k = (u - 0.18) / 0.52
		return height * 4 * k * (1 - k), 1 + 0.13 * (1 - 2 * k)
	end
	-- Landung: federt gedämpft aus
	local k = (u - 0.7) / 0.3
	return 0, 1 - 0.15 * (1 - k) * math.cos(k * math.pi * 2.5)
end

local function animateRecord(record: AnimRecord, base: CFrame, now: number, count: number): number
	local dt = math.clamp(now - record.Last, 0, 0.25)
	record.Last = now
	record.Yaw += (record.YawTarget - record.Yaw) * (1 - math.exp(-dt * TURN_SPEED))
	local t = now + record.Phase
	local lift, sy = 0, 1
	if record.Style == "Float" then
		lift = record.Height * 0.07 * (0.5 + 0.5 * math.sin(t * 1.7))
		sy = 1 + 0.03 * math.sin(t * 1.7 + 1.2)
	else
		sy = 1 + 0.035 * math.sin(t * 2.3)
		if record.HopStart >= 0 then
			local u = (now - record.HopStart) / HOP_TIME
			if u >= 1 then
				record.HopStart = -1
				record.HopAt = now + HOP_MIN + math.random() * HOP_RANGE
			else
				local hopLift, hopSquash = hopShape(u, record.HopHeight)
				lift = hopLift
				sy *= hopSquash
			end
		elseif record.HopAt == 0 then
			record.HopAt = now + math.random() * HOP_RANGE
		elseif now >= record.HopAt then
			record.HopStart = now
		end
	end
	local squash = record.Squash and record.CanSquash
	if not squash then
		sy = 1
	end
	local blink = 0
	if record.HasEyes then
		if record.BlinkStart >= 0 then
			local u = (now - record.BlinkStart) / BLINK_TIME
			if u >= 1 then
				record.BlinkStart = -1
				-- manchmal doppelt blinzeln
				record.BlinkAt = now + (if math.random() < 0.2 then 0.12 else 1.8 + math.random() * 3.5)
			else
				blink = math.sin(u * math.pi)
			end
		elseif record.BlinkAt == 0 then
			record.BlinkAt = now + math.random() * 4
		elseif now >= record.BlinkAt then
			record.BlinkStart = now
		end
	end
	local primary = record.Primary
	local bodySize = record.BodySize
	if squash and primary and bodySize then
		local sx = 1 / math.sqrt(sy)
		primary.Size = Vector3.new(bodySize.X * sx, bodySize.Y * sy, bodySize.Z * sx)
		record.Resized = true
	end
	record.Moved = true
	return poseAnim(record, base, record.Yaw, lift, sy, blink, animParts, animCFrames, count)
end

-- stride = jedes wievielte Frame ein Alien drankommt (60 FPS -> 2 = 30x pro Sekunde)
local function stepAnim(now: number, stride: number): number
	local count = 0
	for _, record in ipairs(activeAnims) do
		local model = record.Model
		if (frameNumber + record.Slot) % stride == 0 and not popping[model] then
			local primary = model.PrimaryPart
			-- Getragene Aliens (nicht verankert, am Spieler) nie bewegen; gelöschte (auch wenn nur der
			-- Ordner darüber weg ist) ebenfalls nicht – die fliegen beim nächsten scanAnim raus
			if
				primary
				and primary.Anchored
				and model:GetAttribute("Bob") == true
				and primary:IsDescendantOf(workspace)
			then
				local last = record.LastPrimary
				local ready = record.Base ~= nil and record.Primary == primary
				if
					not ready
					or not last
					or (primary.Position - last.Position).Magnitude > 0.02
					or model:GetAttribute("Rev") ~= record.Rev
				then
					ready = rebaseAnim(record)
					local newBase = record.Base
					if ready and newBase then
						chooseYaw(record, newBase)
					end
				end
				local base = record.Base
				if ready and base then
					count = animateRecord(record, base, now, count)
				end
			end
		end
	end
	return count
end

-- ---------------------------------------------------------------------
-- SCHLÜPFEN: Alien "ploppt" mit Overshoot rein (Model:ScaleTo lokal, danach exakt zurück)
-- Erkannt wird ein Schlüpfen, wenn ein neues Alien dort auftaucht, wo gerade ein fälliges Ei
-- verschwunden ist – oder wenn der Server-Effekt "Hatch" in der Nähe eines neuen Aliens kommt.
-- ---------------------------------------------------------------------
type PopRecord = { Model: Model, Start: number, Scale: number }
type RecentAlien = { Model: Model, Time: number, Pos: Vector3? }
type RecentEgg = { Pos: Vector3, Time: number }

local pops: { PopRecord } = {}
local recentAliens: { RecentAlien } = {} -- neu aufgetauchte Aliens (kurz gemerkt)
local recentEggs: { RecentEgg } = {} -- gerade verschwundene, fällige Eier (kurz gemerkt)
local animClockNow = 0 -- aktuelle Animations-Uhr (für Ereignisse außerhalb der Frame-Schleife)

local function backOut(t: number): number
	local s = POP_OVERSHOOT
	local u = t - 1
	return 1 + (s + 1) * u * u * u + s * u * u
end

local function startPop(model: Model)
	if popping[model] or not model.PrimaryPart then
		return
	end
	local ok, scale = pcall(model.GetScale, model)
	if not ok or type(scale) ~= "number" or scale <= 0 then
		return
	end
	local record = animSeen[model]
	if record then
		resetAnim(record)
		record.Base = nil -- nach dem Ploppen neu einmessen
	end
	popping[model] = true
	pcall(model.ScaleTo, model, scale * POP_MIN)
	table.insert(pops, { Model = model, Start = animClockNow, Scale = scale })
end

local function stepPops(now: number)
	for i = #pops, 1, -1 do
		local pop = pops[i]
		local model = pop.Model
		local u = (now - pop.Start - POP_DELAY) / POP_TIME
		local alive = model.Parent ~= nil and model.PrimaryPart ~= nil
		if not alive or u >= 1 then
			if alive then
				pcall(model.ScaleTo, model, pop.Scale)
			end
			popping[model] = nil
			pops[i] = pops[#pops]
			pops[#pops] = nil
		elseif u > 0 then
			pcall(model.ScaleTo, model, pop.Scale * math.max(POP_MIN, backOut(u)))
		end
	end
end

local function flatDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- ---------------------------------------------------------------------
-- REGENBOGEN (Teile + Highlights mit Attribut Rainbow)
-- ---------------------------------------------------------------------
type RainbowRecord = { Inst: Instance, Offset: number, IsPart: boolean }

local PALETTE_SIZE = 96
local palette: { Color3 } = {}
for i = 1, PALETTE_SIZE do
	palette[i] = Color3.fromHSV((i - 1) / PALETTE_SIZE, 0.85, 1)
end

local rainbowRecords: { RainbowRecord } = {}
local rainbowSeen: { [Instance]: boolean } = {}

addRainbow = function(inst: Instance)
	if rainbowSeen[inst] then
		return
	end
	if inst:IsA("BasePart") then
		rainbowSeen[inst] = true
		local pos = inst.Position
		table.insert(rainbowRecords, { Inst = inst, Offset = ((pos.X + pos.Z) * 0.008) % 1, IsPart = true })
	elseif inst:IsA("Highlight") then
		rainbowSeen[inst] = true
		table.insert(rainbowRecords, { Inst = inst, Offset = math.random(), IsPart = false })
	end
end

local function considerRainbow(inst: Instance)
	if inst:GetAttribute("Rainbow") == true then
		addRainbow(inst)
	end
end

local function stepRainbow(now: number, camPos: Vector3)
	local hue = (now * 0.22) % 1
	for i = #rainbowRecords, 1, -1 do
		local record = rainbowRecords[i]
		local inst = record.Inst
		if inst.Parent == nil then
			rainbowSeen[inst] = nil
			rainbowRecords[i] = rainbowRecords[#rainbowRecords]
			rainbowRecords[#rainbowRecords] = nil
		else
			local index = math.floor(((hue + record.Offset) % 1) * PALETTE_SIZE) + 1
			local color = palette[index] or palette[1]
			if record.IsPart then
				local part = inst :: BasePart
				if (part.Position - camPos).Magnitude < RAINBOW_RANGE then
					part.Color = color
				end
			else
				local highlight = inst :: Highlight
				if highlight.Enabled then -- ausgeschaltete Umrisse nicht umfärben
					highlight.FillColor = color
					highlight.OutlineColor = color
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- NUR DIE NÄCHSTEN EINSCHALTEN: Umrisse (Highlights, Roblox zeigt max. 31) und Lava-Feuer an
-- Förderband-Meteoren (sonst brennen bei Glück-Events Dutzende gleichzeitig).
-- Der Server legt beide ausgeschaltet an; hier werden alle SCAN_INTERVAL Sekunden die nächsten
-- "Max" in Reichweite eingeschaltet, alle anderen aus.
-- ---------------------------------------------------------------------
type NearestSet = {
	Items: { Instance },
	Seen: { [Instance]: boolean },
	Candidates: { Instance },
	Dist: { [Instance]: number },
	Max: number,
	Range: number,
	ByDistance: (a: Instance, b: Instance) -> boolean,
}

local function newNearestSet(maxOn: number, range: number): NearestSet
	local dist: { [Instance]: number } = {}
	return {
		Items = {},
		Seen = {},
		Candidates = {},
		Dist = dist,
		Max = maxOn,
		Range = range,
		ByDistance = function(a: Instance, b: Instance): boolean
			return (dist[a] or math.huge) < (dist[b] or math.huge)
		end,
	}
end

local highlightSet = newNearestSet(MAX_HIGHLIGHTS, HIGHLIGHT_RANGE)
local lavaSet = newNearestSet(MAX_LAVA_FIRES, LAVA_FIRE_RANGE)

-- Highlight oder Fire (beide haben "Enabled")
local function setOn(inst: Instance, on: boolean)
	local item = inst :: any
	if item.Enabled ~= on then
		item.Enabled = on
	end
end

local function nearestAdd(set: NearestSet, inst: Instance)
	if not set.Seen[inst] then
		set.Seen[inst] = true
		setOn(inst, false) -- bis zum nächsten Durchlauf aus
		table.insert(set.Items, inst)
	end
end

local function addHighlight(inst: Instance)
	if inst:IsA("Highlight") then
		nearestAdd(highlightSet, inst)
	elseif inst:IsA("Fire") and inst:GetAttribute("LavaFire") == true then
		nearestAdd(lavaSet, inst)
	end
end

-- Highlight: sein Adornee (oder Parent); Feuer: sein Meteor
local function effectPosition(inst: Instance): Vector3?
	local target = inst.Parent
	if inst:IsA("Highlight") and inst.Adornee then
		target = inst.Adornee
	end
	if target and target:IsA("BasePart") then
		return target.Position
	elseif target and target:IsA("Model") then
		return target:GetPivot().Position
	end
	return nil
end

local function scanNearest(set: NearestSet, camPos: Vector3)
	local items, candidates, dist = set.Items, set.Candidates, set.Dist
	table.clear(dist)
	local count = 0
	for i = #items, 1, -1 do
		local inst = items[i]
		if inst.Parent == nil or not inst:IsDescendantOf(workspace) then
			set.Seen[inst] = nil
			items[i] = items[#items]
			items[#items] = nil
		else
			local pos = effectPosition(inst)
			local d = if pos then (pos - camPos).Magnitude else math.huge
			if d <= set.Range then
				count += 1
				candidates[count] = inst
				dist[inst] = d
			else
				setOn(inst, false)
			end
		end
	end
	for i = #candidates, count + 1, -1 do
		candidates[i] = nil
	end
	if count > set.Max then
		table.sort(candidates, set.ByDistance)
	end
	for i = 1, count do
		setOn(candidates[i], i <= set.Max)
	end
end

local function scanHighlights(camPos: Vector3)
	scanNearest(highlightSet, camPos)
	scanNearest(lavaSet, camPos)
end

-- ---------------------------------------------------------------------
-- SCHLÜPF-COUNTDOWN an unschlüpften Meteoren in den Basen
-- + die letzten WOBBLE_TIME Sekunden: Ei wackelt immer stärker, leuchtende Risse brechen auf
--   (alles lokal anhand von HatchAt; die Risse sind lokale Neon-Teilchen, die mitwackeln)
-- ---------------------------------------------------------------------
type HatchRecord = {
	Part: BasePart,
	Label: TextLabel?,
	HatchAt: number?,
	Wobble: boolean,
	BaseCF: CFrame?, -- Lage vom Server
	LastCF: CFrame?, -- zuletzt von uns gesetzt
	Cracks: { BasePart },
	CrackOffsets: { CFrame },
	Light: PointLight?,
	Progress: number, -- 0..1 (wie weit das Schlüpfen ist)
}

local hatchRecords: { HatchRecord } = {}
local hatchSeen: { [Instance]: boolean } = {}
local wobbling: { HatchRecord } = {}

local function addHatchCandidate(inst: Instance)
	if not inst:IsA("BasePart") or hatchSeen[inst] then
		return
	end
	if inst:GetAttribute("HatchAt") == nil and inst.Name ~= "Meteor" then
		return
	end
	hatchSeen[inst] = true
	table.insert(hatchRecords, {
		Part = inst,
		Label = nil,
		HatchAt = nil,
		Wobble = false,
		BaseCF = nil,
		LastCF = nil,
		Cracks = {},
		CrackOffsets = {},
		Light = nil,
		Progress = 0,
	})
end

local function findValueLabel(part: BasePart): TextLabel?
	local info = part:FindFirstChild("Info")
	local frame = info and info:FindFirstChild("Frame")
	local labelObj = frame and frame:FindFirstChild("ValueLabel")
	if labelObj and labelObj:IsA("TextLabel") then
		return labelObj
	end
	return nil
end

-- Farbe der Risse: Seltenheits-Farbe des Eis, aufgehellt
local function crackColor(part: BasePart): Color3
	local rarityName = part:GetAttribute("Rarity")
	local rarities = ctx and ctx.Config.RaritiesByName
	local rarity = rarities and type(rarityName) == "string" and rarities[rarityName]
	local color: Color3 = if rarity and typeof(rarity.Color) == "Color3" then rarity.Color else HATCH_COLOR
	return color:Lerp(Color3.new(1, 1, 1), 0.35)
end

-- Ei fängt an zu wackeln: Risse anlegen (3 Zickzack-Risse aus je 2 Stücken) + Licht im Inneren
local function startWobble(record: HatchRecord)
	local folder = fxFolder
	local part = record.Part
	if not folder then
		return
	end
	record.Wobble = true
	record.BaseCF = part.CFrame
	record.LastCF = part.CFrame
	local radius = part.Size.Y / 2
	local color = crackColor(part)
	local width = math.clamp(radius * 0.09, 0.06, 0.3)
	for _ = 1, CRACKS_PER_EGG do
		-- zufällige Stelle in der oberen 3/4-Kugel, Riss liegt tangential auf der Schale
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.9 - 0.25, math.random() - 0.5)
		dir = if dir.Magnitude > 0.05 then dir.Unit else Vector3.yAxis
		local surface = CFrame.lookAt(dir * radius * 0.97, dir * (radius + 1))
			* CFrame.Angles(0, 0, math.random() * math.pi * 2)
		local length = radius * (0.35 + math.random() * 0.3)
		for segment = 0, 1 do
			local bend = if segment == 0 then 0.5 else -0.6
			local offset = surface * CFrame.new(0, length * (segment - 0.5) * 0.9, 0) * CFrame.Angles(0, 0, bend)
			local crack = UI.Create("Part", {
				Name = "EggCrack",
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.Neon,
				Color = color,
				Transparency = 1,
				Size = Vector3.new(width, length * 0.6, width * 0.6),
				CFrame = record.BaseCF * offset,
				Parent = folder,
			})
			table.insert(record.Cracks, crack)
			table.insert(record.CrackOffsets, offset)
		end
	end
	local first = record.Cracks[1]
	if first then
		record.Light = UI.Create("PointLight", {
			Color = color,
			Brightness = 0,
			Range = math.clamp(radius * 5, 6, 20),
			Shadows = false,
			Parent = first,
		})
	end
end

-- Wackeln aus: Risse weg, Ei (falls noch da und nicht vom Server bewegt) zurück an seinen Platz
local function stopWobble(record: HatchRecord)
	record.Wobble = false
	for _, crack in ipairs(record.Cracks) do
		crack:Destroy()
	end
	table.clear(record.Cracks)
	table.clear(record.CrackOffsets)
	record.Light = nil
	local part = record.Part
	local base, last = record.BaseCF, record.LastCF
	if base and last and part.Parent and (part.Position - last.Position).Magnitude < 0.01 then
		part.CFrame = base
	end
	record.BaseCF = nil
	record.LastCF = nil
end

-- Ei ist verschwunden: war es fällig, kurz merken (das neue Alien an dieser Stelle ploppt dann rein)
local function eggGone(record: HatchRecord, now: number)
	local hatchAt = record.HatchAt
	if hatchAt and hatchAt - now < EGG_DUE_WINDOW then
		table.insert(recentEggs, { Pos = record.Part.Position, Time = animClockNow })
	end
	if record.Wobble then
		stopWobble(record)
	end
end

local function removeHatchRecord(i: number, now: number)
	local record = hatchRecords[i]
	hatchSeen[record.Part] = nil
	eggGone(record, now)
	hatchRecords[i] = hatchRecords[#hatchRecords]
	hatchRecords[#hatchRecords] = nil
end

local function stepHatch(now: number, camPos: Vector3)
	local Util = ctx.Util
	table.clear(wobbling)
	for i = #hatchRecords, 1, -1 do
		local record = hatchRecords[i]
		local part = record.Part
		if part.Parent == nil then
			removeHatchRecord(i, now)
		else
			local hatchAt = part:GetAttribute("HatchAt")
			record.HatchAt = if type(hatchAt) == "number" then hatchAt else nil
			local distance = (part.Position - camPos).Magnitude
			local wantWobble = false
			if type(hatchAt) == "number" and distance < HATCH_RANGE then
				local left = hatchAt - now
				local labelObj = record.Label
				if not labelObj or labelObj.Parent == nil then
					labelObj = findValueLabel(part)
					record.Label = labelObj
				end
				if labelObj then
					local text = if left > 0.5
						then "🐣 Schlüpft in " .. Util.FormatTime(math.ceil(left))
						else "🐣 Schlüpft..."
					-- letzte Sekunden: Schrift blinkt zwischen Gold und Weiß
					local color = HATCH_COLOR
					if left < WOBBLE_TIME and math.floor(now * 5) % 2 == 0 then
						color = Color3.new(1, 1, 1)
					end
					if labelObj.Text ~= text then
						labelObj.Text = text
					end
					if labelObj.TextColor3 ~= color then
						labelObj.TextColor3 = color
					end
				end
				wantWobble = left < WOBBLE_TIME
					and left > -WOBBLE_GRACE
					and distance < ANIM_RANGE
					and part.Anchored
					and #wobbling < MAX_WOBBLE
			end
			if wantWobble then
				if not record.Wobble then
					startWobble(record)
				end
				if record.Wobble then
					table.insert(wobbling, record)
				end
			elseif record.Wobble then
				stopWobble(record)
			end
		end
	end
end

-- Jedes Frame: wackelnde Eier + ihre Risse bewegen (in die gemeinsame BulkMoveTo-Liste)
local function stepEggs(now: number, count: number): number
	for _, record in ipairs(wobbling) do
		local part = record.Part
		local hatchAt = record.HatchAt
		if record.Wobble and hatchAt and part.Parent then
			-- Der Server hat das Ei bewegt/vergrößert? -> neue Ruhe-Lage
			local last = record.LastCF
			if not last or (part.Position - last.Position).Magnitude > 0.01 then
				record.BaseCF = part.CFrame
			end
			local base = record.BaseCF
			if base then
				local left = hatchAt - now
				local u = math.clamp(1 - left / WOBBLE_TIME, 0, 1)
				record.Progress = u
				local amp = math.rad(3 + 17 * u * u)
				local speed = 9 + 24 * u
				local a = math.sin(now * speed) * amp
				local b = math.sin(now * speed * 0.77 + 1.3) * amp * 0.55
				local radius = part.Size.Y / 2
				-- kurz vor dem Schlüpfen hüpft das Ei
				local hop = if u > 0.75 then math.abs(math.sin(now * speed * 0.5)) * radius * 0.25 * (u - 0.75) else 0
				local cf = base * CFrame.new(0, hop - radius, 0) * CFrame.Angles(b, 0, a) * CFrame.new(0, radius, 0)
				count += 1
				moveParts[count] = part
				moveCFrames[count] = cf
				record.LastCF = cf
				local glow = math.clamp(u * 1.25, 0, 1)
				local transparency = 1 - glow * 0.95
				for j, crack in ipairs(record.Cracks) do
					count += 1
					moveParts[count] = crack
					moveCFrames[count] = cf * record.CrackOffsets[j]
					-- Risse brechen nacheinander auf
					local own = math.clamp(glow * 1.6 - (j - 1) * 0.12, 0, 1)
					local wanted = 1 - own * (1 - transparency)
					if math.abs(crack.Transparency - wanted) > 0.02 then
						crack.Transparency = wanted
					end
				end
				local light = record.Light
				if light then
					light.Brightness = glow * glow * (4 + math.sin(now * 23) * 1.2)
				end
			end
		end
	end
	return count
end

-- Zerstörte Objekte aus den Listen werfen. Je nach Destroy-Replikation behalten Teile in einem
-- zerstörten Model ihren Parent – deshalb (selten) prüfen, ob sie noch in der Welt hängen.
local function cleanupDead(now: number)
	for i = #rainbowRecords, 1, -1 do
		local inst = rainbowRecords[i].Inst
		if not inst:IsDescendantOf(workspace) then
			rainbowSeen[inst] = nil
			rainbowRecords[i] = rainbowRecords[#rainbowRecords]
			rainbowRecords[#rainbowRecords] = nil
		end
	end
	for i = #hatchRecords, 1, -1 do
		if not hatchRecords[i].Part:IsDescendantOf(workspace) then
			removeHatchRecord(i, now)
		end
	end
end

-- ---------------------------------------------------------------------
-- NEUE ALIENS: kurz merken und prüfen, ob sie gerade geschlüpft sind (-> reinploppen)
-- ---------------------------------------------------------------------
local pendingAliens: { RecentAlien } = {}
local initDone = false

local function onAlienAdded(inst: Instance)
	if initDone and inst:IsA("Model") and inst:GetAttribute("Bob") == true then
		table.insert(pendingAliens, { Model = inst, Time = animClockNow, Pos = nil })
	end
end

-- Passendes verschwundenes Ei (oder "Hatch"-Effekt) an dieser Stelle? -> verbrauchen
local function matchEgg(pos: Vector3): boolean
	for i = #recentEggs, 1, -1 do
		if flatDistance(recentEggs[i].Pos, pos) < POP_MATCH_DISTANCE then
			table.remove(recentEggs, i)
			return true
		end
	end
	return false
end

local function stepPendingAliens(now: number)
	local clock = animClockNow
	for i = #recentEggs, 1, -1 do
		if clock - recentEggs[i].Time > RECENT_TIME then
			table.remove(recentEggs, i)
		end
	end
	for i = #recentAliens, 1, -1 do
		if clock - recentAliens[i].Time > RECENT_TIME or recentAliens[i].Model.Parent == nil then
			table.remove(recentAliens, i)
		end
	end
	if #pendingAliens == 0 then
		return
	end
	-- Eier, die gerade verschwunden sind, sofort einsammeln (nicht erst beim nächsten Countdown-Takt)
	for i = #hatchRecords, 1, -1 do
		if hatchRecords[i].Part.Parent == nil then
			removeHatchRecord(i, now)
		end
	end
	for i = #pendingAliens, 1, -1 do
		local entry = pendingAliens[i]
		local model = entry.Model
		if model.Parent == nil or clock - entry.Time > RECENT_TIME then
			table.remove(pendingAliens, i)
		elseif model.PrimaryPart then
			table.remove(pendingAliens, i)
			local pos = model:GetPivot().Position
			entry.Pos = pos
			if matchEgg(pos) then
				startPop(model)
			else
				table.insert(recentAliens, entry)
			end
		end
	end
end

-- Der Server meldet ein Schlüpfen (Effekt "Hatch"): neues Alien dort -> reinploppen lassen
function WorldFX.NoteHatch(position: Vector3)
	if typeof(position) ~= "Vector3" then
		return
	end
	for i = #recentAliens, 1, -1 do
		local entry = recentAliens[i]
		local pos = entry.Pos
		if pos and flatDistance(pos, position) < POP_MATCH_DISTANCE then
			table.remove(recentAliens, i)
			startPop(entry.Model)
			return
		end
	end
	-- Alien ist evtl. noch unterwegs -> wie ein verschwundenes Ei merken
	table.insert(recentEggs, { Pos = position, Time = animClockNow })
end

-- ---------------------------------------------------------------------
-- START
-- ---------------------------------------------------------------------
local function watchFolder(parent: Instance, name: string, onChild: (Instance) -> ())
	task.spawn(function()
		local folder = parent:WaitForChild(name, 60)
		if not folder then
			warn("[WorldFX] '" .. name .. "' nicht gefunden – Animation dafür aus")
			return
		end
		for _, child in ipairs(folder:GetChildren()) do
			onChild(child)
		end
		folder.ChildAdded:Connect(onChild)
	end)
end

function WorldFX.Init(context: any, map: Instance)
	ctx = context
	fxFolder = UI.Create("Folder", { Name = "MeteorHeistStripes", Parent = workspace })

	-- Hauptband (Streifen) + Meteore darauf
	task.spawn(function()
		local belt = map:WaitForChild("Belt", 60)
		if belt then
			setupMainBelt(belt)
		end
	end)
	watchFolder(map, "BeltMeteors", watchBeltMeteor)
	watchFolder(map, "Treadmills", setupTreadmill)

	-- Aliens, Regenbogen und Schlüpf-Meteore: einmal alles durchsehen, danach nur Neues
	for _, inst in ipairs(map:GetDescendants()) do
		addAnim(inst)
		local parent = inst.Parent
		if parent and parent.Name ~= "BeltMeteors" and parent.Name ~= "GroundMeteors" then
			addHatchCandidate(inst)
		end
	end
	initDone = true
	map.DescendantAdded:Connect(function(inst)
		if addAnim(inst) then
			onAlienAdded(inst)
		end
		local parent = inst.Parent
		-- Meteore auf dem Band / am Boden schlüpfen nie -> gar nicht erst beobachten
		if parent and parent.Name ~= "BeltMeteors" and parent.Name ~= "GroundMeteors" then
			addHatchCandidate(inst)
		end
	end)
	-- Regenbogen + Umrisse (+ Lava-Feuer) überall – auch an getragenen Aliens (hängen am Charakter, nicht in der Map)
	local function onWorldDescendant(inst: Instance)
		considerRainbow(inst)
		addHighlight(inst)
	end
	for _, inst in ipairs(workspace:GetDescendants()) do
		onWorldDescendant(inst)
	end
	workspace.DescendantAdded:Connect(onWorldDescendant)

	local slowClock = 0
	local hatchClock = HATCH_INTERVAL
	local scanClock = SCAN_INTERVAL -- gleich im ersten Frame auswählen
	local cleanupClock = 0
	local animClock = 0 -- eigene Animations-Uhr (läuft mit dt, auch bei Rucklern gleichmäßig)
	local stripeClock = 0 -- eigene Uhr für die Streifen (Serverzeit wird nachgeregelt -> ruckelt)
	RunService.RenderStepped:Connect(function(dt: number)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		frameNumber += 1
		local camCFrame = camera.CFrame
		local camPos = camCFrame.Position
		local now = workspace:GetServerTimeNow()
		animClock += dt
		stripeClock += dt
		animClockNow = animClock

		-- Schlüpf-Countdown zuerst (wählt die wackelnden Eier für dieses Frame)
		hatchClock += dt
		if hatchClock >= HATCH_INTERVAL then
			hatchClock = math.min(hatchClock - HATCH_INTERVAL, HATCH_INTERVAL)
			stepHatch(now, camPos)
		end

		table.clear(moveParts)
		table.clear(moveCFrames)
		local look = camCFrame.LookVector
		local cosLimit = viewCos(camera)
		local count = stepBelt(now, camPos, look, cosLimit, 0)
		count = stepStripes(stripeClock, camPos, look, cosLimit, count)
		if #wobbling > 0 then
			count = stepEggs(now, count)
		end
		if count > 0 then
			workspace:BulkMoveTo(moveParts, moveCFrames, Enum.BulkMoveMode.FireCFrameChanged)
		end

		scanClock += dt
		if scanClock >= SCAN_INTERVAL then
			scanClock = 0
			scanAnim(camPos)
			scanHighlights(camPos)
		end
		cleanupClock += dt
		if cleanupClock >= CLEANUP_INTERVAL then
			cleanupClock = 0
			cleanupDead(now)
		end

		-- Neue Aliens: geschlüpft? -> reinploppen (Overshoot)
		if #pendingAliens > 0 or #recentEggs > 0 or #recentAliens > 0 then
			stepPendingAliens(now)
		end
		if #pops > 0 then
			stepPops(animClock)
		end

		-- Aliens: jedes Frame ein Teil, jedes einzelne ca. 30x pro Sekunde
		local stride = math.max(1, math.floor(SLOW_INTERVAL / math.max(dt, 1 / 240) + 0.5))
		table.clear(animParts)
		table.clear(animCFrames)
		local animCount = stepAnim(animClock, stride)
		if animCount > 0 then
			workspace:BulkMoveTo(animParts, animCFrames, Enum.BulkMoveMode.FireCFrameChanged)
		end

		slowClock += dt
		if slowClock >= SLOW_INTERVAL then
			-- abziehen statt auf 0 setzen -> gleichmäßiger Takt (nach Rucklern nicht nachholen)
			slowClock = math.min(slowClock - SLOW_INTERVAL, SLOW_INTERVAL)
			stepRainbow(animClock, camPos)
		end
	end)
end

return WorldFX
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="44">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <token name="ReplicateInstanceDestroySetting">2</token>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>