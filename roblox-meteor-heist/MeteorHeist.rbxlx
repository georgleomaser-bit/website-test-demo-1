  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- =====================================================================
--  METEOR HEIST – Server-Start
--  Lädt alle Services in der richtigen Reihenfolge. Hier musst du nichts ändern.
-- =====================================================================

local Players = game:GetService("Players")
local ServicesFolder = script.Parent:WaitForChild("Services")

local order = {
	"DataService",
	"MonetizationService",
	"GraphicsService", -- Licht & Himmel (vor der Map)
	"PlotService", -- baut die Map (MapBuilder) + Basen
	"MeteorService", -- Förderband mit Meteoren, Gratis-Zone, Eier am Boden, Schauer, Egg Rush
	"CarryService", -- Klauen & Tragen, Bonk
	"GadgetService", -- Speed Coil, Falle, Super-Bonk, Umhang
	"EconomyService",
	"RewardService", -- Spielzeit-Geschenke, Glücksrad, Tagesaufgaben
	"TreadmillService", -- Laufbänder: Schritte farmen
	"RunService", -- ☄️ Meteor-Run: Lauf-Parcours mit Gratis-Ei als Belohnung
	"AdminService",
	"LeaderboardService",
}

local Services = {}
local loaded = {}
for _, name in ipairs(order) do
	local module = ServicesFolder:WaitForChild(name, 10)
	if not module or not module:IsA("ModuleScript") then
		warn("[Meteor Heist] Service fehlt: " .. name)
		continue
	end
	local ok, result = xpcall(require, debug.traceback, module)
	if ok and type(result) == "table" then
		Services[name] = result
		table.insert(loaded, name)
	else
		warn("[Meteor Heist] Fehler beim Laden von " .. name .. ": " .. tostring(result))
	end
end

-- Fehler in einem Service sollen nicht das ganze Spiel stoppen -> klar im Output melden
local function run(name: string, phase: string, fn: (...any) -> ...any, ...: any)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[Meteor Heist] Fehler in " .. name .. "." .. phase .. ": " .. tostring(err))
	end
end

-- Phase 1: Init (Map bauen, Verweise setzen)
for _, name in ipairs(loaded) do
	local service = Services[name]
	if service.Init then
		run(name, "Init", service.Init, Services)
	end
end

-- Phase 2: Start (Schleifen + Events). DataService zuletzt, damit alle
-- "Spielstand geladen"-Callbacks schon registriert sind.
for _, name in ipairs(loaded) do
	local service = Services[name]
	if name ~= "DataService" and service.Start then
		run(name, "Start", service.Start)
	end
end
if Services.DataService then
	run("DataService", "Start", Services.DataService.Start)
end

Players.CharacterAutoLoads = true
print("[Meteor Heist] Server gestartet ✅")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[-- Admin-Panel (Server-Seite). JEDE Aktion prüft hier auf dem Server, ob der Spieler
-- der Besitzer des Spiels ist oder in Config.AdminUserIds steht. Exploiter können das Panel also nicht benutzen,
-- selbst wenn sie es sich im Client anzeigen lassen.

local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Aliens = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Aliens"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))

local AdminService = {}
local Services
local limiter = Util.RateLimiter(12, 1)

local adminCache: { [Player]: boolean } = {}
local warnedDenied: { [Player]: boolean } = {} -- "Unerlaubter Zugriff" nur einmal pro Spieler ins Log

-- Gehört das Spiel diesem Spieler? (Spiel unter dem eigenen Account veröffentlicht)
-- Bei Gruppen-Spielen: Admins per UserId in Config.AdminUserIds eintragen.
local function isGameOwner(player: Player): boolean
	return Config.OwnerIsAdmin
		and game.CreatorType == Enum.CreatorType.User
		and game.CreatorId ~= 0
		and player.UserId == game.CreatorId
end

local function computeAdmin(player: Player): boolean
	if table.find(Config.AdminUserIds, player.UserId) then
		return true
	end
	if isGameOwner(player) then
		return true
	end
	return RunService:IsStudio() and Config.StudioIsAdmin
end

function AdminService.IsAdmin(player: Player): boolean
	local cached = adminCache[player]
	if cached == nil then
		cached = computeAdmin(player)
		if player.Parent then
			adminCache[player] = cached
		end
	end
	return cached
end

-- "me", "all", "others" oder (Teil vom) Namen
local function resolveTargets(admin: Player, text: any): { Player }
	if type(text) ~= "string" or text == "" or text:lower() == "me" then
		return { admin }
	end
	local lower = text:lower()
	if lower == "all" then
		return Players:GetPlayers()
	end
	if lower == "others" then
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= admin then
				table.insert(list, p)
			end
		end
		return list
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower() == lower or p.DisplayName:lower() == lower then
			return { p }
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #lower) == lower or p.DisplayName:lower():sub(1, #lower) == lower then
			return { p }
		end
	end
	return {}
end

local function num(value: any, default: number, min: number, max: number): number
	local n = tonumber(value)
	if not n or n ~= n then
		return default
	end
	return math.clamp(n, min, max)
end

local function names(list: { Player }): string
	local out = {}
	for _, p in ipairs(list) do
		table.insert(out, p.DisplayName)
	end
	return table.concat(out, ", ")
end

local function filterBroadcast(text: string, fromUserId: number): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, fromUserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	return ok and result or nil
end

-- -------------------------------------------------------------------
-- SERVERÜBERGREIFEND (alle Server gleichzeitig)
-- -------------------------------------------------------------------
-- -------------------------------------------------------------------
-- ADMIN ABUSE (Spaß-Befehle)
-- -------------------------------------------------------------------
local DEFAULT_GRAVITY = 196.2
local MOON_GRAVITY = 45
local gravityToken = 0

local function setGravity(value: number, seconds: number?)
	gravityToken += 1
	local token = gravityToken
	workspace.Gravity = value
	if seconds then
		task.delay(seconds, function()
			if gravityToken == token then
				workspace.Gravity = DEFAULT_GRAVITY
			end
		end)
	end
end

local function runAdminAbuse()
	Services.EconomyService.NotifyAll(
		"😈 ADMIN ABUSE! 10x Glück, Meteoritenschauer, Geld für alle, Gratis-Secrets, ein Admin-Meteor & Mond-Schwerkraft!",
		"Event"
	)
	Services.MeteorService.SetServerLuck(10, workspace:GetServerTimeNow() + 600)
	Services.MeteorService.StartShower(120)
	setGravity(MOON_GRAVITY, 90)
	for _, p in ipairs(Players:GetPlayers()) do
		local gift = math.floor(math.max(10000, Services.EconomyService.GetIncome(p) * 600))
		Services.EconomyService.AddCash(p, gift)
		Services.EconomyService.Notify(p, "🎁 Admin-Geschenk: " .. Util.FormatCash(gift), "Success")
		Services.EconomyService.Effect(p, "Confetti", 3)
	end
	task.spawn(function()
		-- Gratis-Meteore regnen in die Gratis-Zone, zum Schluss ein Admin-Meteor
		for i = 1, 6 do
			Services.MeteorService.SpawnStatic({
				Rarity = i <= 2 and "Secret" or "Mythic",
				Free = true,
				Announce = false,
			})
			task.wait(1.5)
		end
		local def = Services.MeteorService.RandomAdminMeteor()
		if def then
			Services.MeteorService.SpawnStatic({ Id = def.Id, Mut = "Normal", Free = true, Announce = false })
			Services.EconomyService.NotifyAll(
				"👑 Ein ADMIN-METEOR (" .. def.Name .. ") ist in der Gratis-Zone gelandet! SCHNELL! 🏃",
				"Event"
			)
		end
	end)
end

local function getRoot(p: Player): BasePart?
	local character = p.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Bodenhöhe unter einer Position (ignoriert Spieler und Meteore)
local function groundBelow(position: Vector3): Vector3
	local ignore: { Instance } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	local map = Services.PlotService.MapFolder
	if map then
		for _, name in ipairs({ "BeltMeteors", "GroundMeteors" }) do
			local folder = map:FindFirstChild(name)
			if folder then
				table.insert(ignore, folder)
			end
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local result = workspace:Raycast(position + Vector3.new(0, 4, 0), Vector3.new(0, -60, 0), params)
	if result then
		return result.Position
	end
	return Vector3.new(position.X, 0.2, position.Z)
end

local function setInvisible(p: Player, invisible: boolean)
	local character = p.Character
	if not character then
		return
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			if invisible then
				if d:GetAttribute("AdminOrigT") == nil then
					d:SetAttribute("AdminOrigT", d.Transparency)
				end
				d.Transparency = 1
			else
				local orig = d:GetAttribute("AdminOrigT")
				if orig ~= nil then
					d.Transparency = orig
					d:SetAttribute("AdminOrigT", nil)
				end
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = invisible and Enum.HumanoidDisplayDistanceType.None
			or Enum.HumanoidDisplayDistanceType.Viewer
	end
	local head = character:FindFirstChild("Head")
	local overhead = head and head:FindFirstChild("OverheadTag")
	if overhead and overhead:IsA("BillboardGui") then
		overhead.Enabled = not invisible
	end
end

local function setScale(p: Player, scale: number): boolean
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid then
		return false
	end
	local found = false
	for _, name in ipairs({ "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale" }) do
		local value = humanoid:FindFirstChild(name)
		if value and value:IsA("NumberValue") then
			value.Value = scale
			found = true
		end
	end
	if not found then
		-- Fallback (z.B. R6-Avatare)
		local ok = pcall(function()
			character:ScaleTo(scale)
		end)
		found = ok
	end
	return found
end

-- Schild über dem Kopf: 🛠️ ADMIN (Besitzer/Admins) oder 👑 VIP (VIP-Gamepass)
local function updateTag(p: Player)
	local character = p.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("OverheadTag")
	if old then
		old:Destroy()
	end
	local text, color
	if p:GetAttribute("IsAdmin") == true and not RunService:IsStudio() then
		text, color = "🛠️ ADMIN", Color3.fromRGB(255, 80, 80)
	elseif p:GetAttribute("VIP") == true then
		text, color = "👑 VIP", Color3.fromRGB(255, 205, 60)
	end
	if not text then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "OverheadTag"
	gui.Size = UDim2.new(0, 120, 0, 28)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Enabled = head.Transparency < 1
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = head
end

local function handleGlobal(message)
	if type(message) ~= "table" then
		return
	end
	if message.Type == "Announce" and type(message.Text) == "string" then
		Services.EconomyService.NotifyAll("📢 " .. message.Text, "Announce")
	elseif message.Type == "Luck" then
		Services.MeteorService.SetServerLuck(num(message.Mult, 1, 1, 100), num(message.Until, 0, 0, math.huge))
		Services.EconomyService.NotifyAll(
			"🍀 ADMIN-EVENT: " .. message.Mult .. "x Glück auf ALLEN Servern!",
			"Event"
		)
	elseif message.Type == "Shower" then
		Services.MeteorService.StartShower(num(message.Seconds, Config.ShowerDuration, 10, 3600))
	elseif message.Type == "AdminAbuse" then
		runAdminAbuse()
	elseif message.Type == "Gravity" then
		setGravity(num(message.Value, DEFAULT_GRAVITY, 5, 500))
	end
end

local function publishGlobal(message): boolean
	local ok, err = pcall(MessagingService.PublishAsync, MessagingService, Config.MessagingTopic, message)
	if not ok then
		warn("[Admin] Global senden fehlgeschlagen: " .. tostring(err))
		handleGlobal(message) -- wenigstens auf diesem Server
	end
	return ok
end

-- -------------------------------------------------------------------
-- FOTO-MODUS (schöne Thumbnail-Screenshots)
-- -------------------------------------------------------------------
local photoRng = Random.new()
local SHOWCASE_DISTANCE = 14 -- Studs vor dem Admin
local SHOWCASE_GAP = 2.5 -- Lücke zwischen zwei Meteoren
local SHOWCASE_LIFETIME = 300 -- Sekunden
local PHOTO_RARITIES = { "Legendary", "Mythic", "Celestial", "Divine", "Secret" }
local PHOTO_LUCK = 8
local ADMIN_METEOR_LIFETIME = 300 -- Sekunden in der Gratis-Zone
-- Admin-Meteore haben Umriss, starkes Licht und Aura -> per "Spawnen" höchstens so viele auf einmal
local MAX_ADMIN_METEOR_SPAWN = 5
-- Öfter Gold/Diamond/Cosmic als Normal – glänzt schöner auf dem Foto
local PHOTO_MUTATIONS = {
	{ Name = "Normal", Weight = 12 },
	{ Name = "Gold", Weight = 24 },
	{ Name = "Diamond", Weight = 20 },
	{ Name = "Cosmic", Weight = 16 },
	{ Name = "Frost", Weight = 10 },
	{ Name = "Lava", Weight = 10 },
	{ Name = "Rainbow", Weight = 8 },
}

-- Zufälliges Deko-Alien für die Foto-Base (wird NICHT gespeichert)
local function photoEntry()
	local rarity = PHOTO_RARITIES[photoRng:NextInteger(1, #PHOTO_RARITIES)]
	local def = Services.MeteorService.RandomOfRarity(rarity)
	if not def then
		return nil
	end
	local mut = Util.WeightedPick(PHOTO_MUTATIONS, nil, photoRng)
	local level = math.min(photoRng:NextInteger(10, 20), Config.MaxLevel)
	-- viel Glück -> öfter Selten/Ultra-Aliens (sieht auf dem Foto besser aus)
	local alien = Aliens.Roll(def.Id, PHOTO_LUCK, photoRng)
	return { Id = def.Id, Alien = alien, Mut = mut.Name, Lv = level, Xp = 0, Hatch = 0 }
end

-- Je der teuerste Meteor jeder Seltenheit (Common zuerst, Admin zuletzt)
local function showcaseDefs()
	local list = {}
	for _, rarity in ipairs(Config.Rarities) do
		local best = nil
		for _, def in ipairs(Config.MeteorsByRarityAll[rarity.Name]) do
			if not best or def.Price > best.Price then
				best = def
			end
		end
		if best then
			table.insert(list, best)
		end
	end
	return list
end

-- Admin-Meteor aus der Anfrage (nur Rarity "Admin")
local function adminMeteorDef(id: any)
	local def = type(id) == "string" and Config.MeteorsById[id]
	if def and Config.RaritiesByName[def.Rarity].AdminOnly then
		return def
	end
	return nil
end

-- Admin-Meteor in die Gratis-Zone: großer Einschlag + Ansage an alle
local function dropAdminMeteor(def, mutation: string?)
	local record = Services.MeteorService.SpawnStatic({
		Id = def.Id,
		Mut = Config.MutationsByName[mutation] and mutation or "Normal",
		Free = true,
		Announce = false,
		Lifetime = ADMIN_METEOR_LIFETIME,
	})
	return record ~= nil
end

-- -------------------------------------------------------------------
-- AKTIONEN
-- -------------------------------------------------------------------
local Actions = {}

function Actions.GetPlayers(_admin)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local data = Services.DataService.Get(p)
		table.insert(list, {
			Name = p.Name,
			DisplayName = p.DisplayName,
			UserId = p.UserId,
			Cash = data and data.Cash or 0,
			Rebirths = data and data.Rebirths or 0,
			Steps = data and data.Steps or 0,
		})
	end
	return true, "OK", list
end

-- Where: "Belt" (Standard, aufs Laufband), "Free" (Gratis-Zone) oder "Me" (vor dem Admin)
function Actions.SpawnMeteor(admin, args)
	local id = args.MeteorId
	if type(id) ~= "string" or not Config.MeteorsById[id] then
		return false, "Unbekannter Meteor"
	end
	local count = math.floor(num(args.Count, 1, 1, 25))
	if Config.RaritiesByName[Config.MeteorsById[id].Rarity].AdminOnly then
		count = math.min(count, MAX_ADMIN_METEOR_SPAWN)
	end
	local mutation = Config.MutationsByName[args.Mutation] and args.Mutation or "Normal"
	local where = args.Where
	local origin, right, forward = nil, nil, nil
	if where == "Me" then
		local root = getRoot(admin)
		if not root then
			return false, "Kein Charakter"
		end
		local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
		forward = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
		right = forward:Cross(Vector3.yAxis)
		origin = groundBelow(root.Position + forward * 10)
	end
	local spacing = MeteorFactory.GetSize({ Id = id, Lv = 1 }) + 2
	for i = 1, count do
		local opts: { [string]: any } = {
			Id = id,
			Mut = mutation,
			Free = args.Free == true or where == "Free",
			Announce = i == 1,
			Instant = where == "Me",
		}
		if origin and right and forward then
			-- Raster aus 5er-Reihen vor dem Admin
			local column = (i - 1) % 5 - 2
			local row = math.floor((i - 1) / 5)
			opts.Position = origin + right * column * spacing + forward * row * spacing
			Services.MeteorService.SpawnStatic(opts)
		elseif where == "Free" then
			Services.MeteorService.SpawnStatic(opts)
		else
			Services.MeteorService.QueueBelt(opts)
		end
	end
	local target = where == "Me" and "vor dir" or (where == "Free" and "in der Gratis-Zone" or "aufs Förderband")
	return true, count .. "x " .. Config.MeteorsById[id].Name .. " " .. target
end

function Actions.MeteorRain(_admin, args)
	local rarity = Config.RaritiesByName[args.Rarity] and args.Rarity or nil
	local count = math.floor(num(args.Count, 10, 1, 40))
	for _ = 1, count do
		Services.MeteorService.QueueBelt({ Rarity = rarity, Announce = false })
	end
	Services.EconomyService.NotifyAll(
		"☄️ ADMIN-METEORREGEN aufs Förderband" .. (rarity and (" (" .. rarity .. ")") or "") .. "! 🏃",
		"Event"
	)
	return true, count .. " Meteore kommen aufs Förderband"
end

function Actions.GiveMeteor(admin, args)
	if not Config.MeteorsById[args.MeteorId] then
		return false, "Unbekannter Meteor"
	end
	local targets = resolveTargets(admin, args.Target)
	local given = 0
	for _, p in ipairs(targets) do
		-- Hatched = true -> sofort ein Alien (AlienId wählbar, sonst gewürfelt)
		local alien = nil
		if args.Hatched == true or args.AlienId ~= nil then
			local wanted = Aliens.ById[args.AlienId]
			alien = (wanted and wanted.Meteor == args.MeteorId) and wanted.Id or Aliens.Roll(args.MeteorId)
		end
		local ok = Services.EconomyService.GiveMeteor(p, {
			Id = args.MeteorId,
			Mut = args.Mutation,
			Lv = num(args.Level, 1, 1, Config.MaxLevel),
			Alien = alien,
		})
		if ok then
			given += 1
			Services.EconomyService.Notify(
				p,
				"🎁 Ein Admin hat dir " .. Config.MeteorsById[args.MeteorId].Name .. " geschenkt!",
				"Success"
			)
		end
	end
	return given > 0, "An " .. given .. " Spieler gegeben" .. (given < #targets and " (manche Basen voll)" or "")
end

function Actions.GiveCash(admin, args)
	local amount = num(args.Amount, 0, -1e18, 1e18)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		Services.EconomyService.AddCash(p, amount)
	end
	return #targets > 0, Util.FormatCash(amount) .. " an " .. names(targets)
end

function Actions.SetCash(admin, args)
	local amount = num(args.Amount, 0, 0, 1e18)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		if data then
			data.Cash = amount
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "Cash = " .. Util.FormatCash(amount) .. " für " .. names(targets)
end

function Actions.SetRebirths(admin, args)
	local amount = math.floor(num(args.Amount, 0, 0, 1000))
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		if data then
			data.Rebirths = amount
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "Rebirths = " .. amount .. " für " .. names(targets)
end

function Actions.SetSteps(admin, args)
	local amount = math.floor(num(args.Amount, 0, 0, 1e18))
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		if data then
			data.Steps = amount
			Services.EconomyService.ApplySpeed(p)
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "👟 Schritte = " .. Util.FormatNumber(amount) .. " für " .. names(targets)
end

-- 👑 Admin-Meteor: Where = "Free" (gratis in die Mitte/Gratis-Zone) oder "Base" (eigene Base)
function Actions.SpawnAdminMeteor(admin, args)
	local def = adminMeteorDef(args.MeteorId)
	if not def then
		return false, "Kein Admin-Meteor"
	end
	if args.Where == "Base" then
		local ok = Services.EconomyService.GiveMeteor(admin, {
			Id = def.Id,
			Mut = Config.MutationsByName[args.Mutation] and args.Mutation or "Normal",
			Lv = 1,
		}, true)
		if not ok then
			return false, "Deine Base ist voll (oder du hast keine)"
		end
		return true, "👑 " .. def.Name .. " fliegt in deine Base!"
	end
	if not dropAdminMeteor(def, args.Mutation) then
		return false, "Spawnen fehlgeschlagen"
	end
	Services.EconomyService.NotifyAll(
		"👑 ADMIN-METEOR: " .. def.Name .. " landet in der Gratis-Zone! GRATIS – SCHNELL HIN! 🏃",
		"Event"
	)
	return true, "👑 " .. def.Name .. " in der Gratis-Zone"
end

-- 👑 Admin-Meteor-Regen: 1-8 zufällige Admin-Meteore gratis in die Gratis-Zone
function Actions.AdminRain(_admin, args)
	local count = math.floor(num(args.Count, 3, 1, 8))
	if #Config.AdminMeteors == 0 then
		return false, "Keine Admin-Meteore in Config"
	end
	Services.EconomyService.NotifyAll(
		"👑 ADMIN-METEOR-REGEN! " .. count .. "x GRATIS in der Gratis-Zone! 🏃",
		"Event"
	)
	task.spawn(function()
		for _ = 1, count do
			local def = Services.MeteorService.RandomAdminMeteor()
			if def then
				dropAdminMeteor(def, "Normal")
			end
			task.wait(0.8)
		end
	end)
	return true, "👑 " .. count .. " Admin-Meteore regnen herab"
end

function Actions.GivePass(admin, args)
	if not Config.GamePassesByKey[args.PassKey] then
		return false, "Unbekannter Pass"
	end
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		Services.MonetizationService.GrantPassSession(p, args.PassKey)
	end
	return #targets > 0, args.PassKey .. " (bis Server-Wechsel) für " .. names(targets)
end

function Actions.StartShower(_admin, args)
	local seconds = num(args.Seconds, Config.ShowerDuration, 10, 3600)
	if args.Global then
		publishGlobal({ Type = "Shower", Seconds = seconds })
		return true, "Schauer auf ALLEN Servern"
	end
	Services.MeteorService.StartShower(seconds)
	return true, "Meteoritenschauer gestartet (" .. seconds .. "s)"
end

function Actions.ServerLuck(_admin, args)
	local mult = num(args.Mult, 2, 1, 100)
	local minutes = num(args.Minutes, 10, 1, 24 * 60)
	local untilTime = workspace:GetServerTimeNow() + minutes * 60
	if args.Global then
		publishGlobal({ Type = "Luck", Mult = mult, Until = untilTime })
		return true, mult .. "x Glück auf ALLEN Servern für " .. minutes .. " Min"
	end
	Services.MeteorService.SetServerLuck(mult, untilTime)
	Services.EconomyService.NotifyAll(
		"🍀 ADMIN-EVENT: " .. mult .. "x Glück für " .. minutes .. " Minuten!",
		"Event"
	)
	return true, mult .. "x Glück für " .. minutes .. " Min"
end

function Actions.Announce(admin, args)
	if type(args.Text) ~= "string" or #args.Text == 0 or #args.Text > 200 then
		return false, "Text 1-200 Zeichen"
	end
	local filtered = filterBroadcast(args.Text, admin.UserId)
	if not filtered then
		return false, "Text-Filter nicht erreichbar"
	end
	if args.Global then
		publishGlobal({ Type = "Announce", Text = filtered })
		return true, "An ALLE Server gesendet"
	end
	Services.EconomyService.NotifyAll("📢 " .. filtered, "Announce")
	return true, "Gesendet"
end

function Actions.Kick(admin, args)
	local targets = resolveTargets(admin, args.Target)
	local reason = type(args.Reason) == "string" and args.Reason ~= "" and args.Reason or "Vom Admin gekickt"
	local kicked = {}
	for _, p in ipairs(targets) do
		if p ~= admin then
			table.insert(kicked, p.DisplayName)
			p:Kick(reason)
		end
	end
	return #kicked > 0, "Gekickt: " .. table.concat(kicked, ", ")
end

function Actions.Ban(admin, args)
	local userId = tonumber(args.Target)
	local display = tostring(args.Target)
	if not userId then
		local targets = resolveTargets(admin, args.Target)
		if #targets ~= 1 or targets[1] == admin then
			return false, "Genau EINEN Spieler (Name oder UserId) angeben"
		end
		userId = targets[1].UserId
		display = targets[1].DisplayName
	end
	local isOwner = game.CreatorType == Enum.CreatorType.User and userId == game.CreatorId
	if userId == admin.UserId or isOwner or table.find(Config.AdminUserIds, userId) then
		return false, "Admins können nicht gebannt werden"
	end
	local days = num(args.Days, 0, 0, 3650)
	local reason = type(args.Reason) == "string" and args.Reason ~= "" and args.Reason or "Regelverstoß"
	local ok, err = pcall(function()
		Players:BanAsync({
			UserIds = { userId },
			ApplyToUniverse = true,
			Duration = days > 0 and math.floor(days * 86400) or -1,
			DisplayReason = reason,
			PrivateReason = "Gebannt von " .. admin.Name .. " (" .. admin.UserId .. ")",
			ExcludeAltAccounts = false,
		})
	end)
	if not ok then
		return false, "Bann fehlgeschlagen: " .. tostring(err)
	end
	return true, display .. " gebannt (" .. (days > 0 and (days .. " Tage") or "für immer") .. ")"
end

function Actions.Unban(_admin, args)
	local userId = tonumber(args.Target)
	if not userId then
		return false, "UserId (Zahl) angeben"
	end
	local ok, err = pcall(function()
		Players:UnbanAsync({ UserIds = { userId }, ApplyToUniverse = true })
	end)
	if not ok then
		return false, "Entbannen fehlgeschlagen: " .. tostring(err)
	end
	return true, userId .. " entbannt"
end

function Actions.ClearBase(admin, args)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		local plot = Services.PlotService.GetPlot(p)
		if data then
			if plot then
				Services.CarryService.CancelStealsFromPlot(plot, "cancelled")
			end
			data.Meteors = {}
			if plot then
				Services.PlotService.RenderAll(plot)
			end
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "Base geleert: " .. names(targets)
end

function Actions.ResetData(admin, args)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local plot = Services.PlotService.GetPlot(p)
		if Services.CarryService.IsCarrying(p) then
			Services.CarryService.Fail(p, "cancelled")
		end
		if plot then
			Services.CarryService.CancelStealsFromPlot(plot, "cancelled")
		end
		Services.DataService.Reset(p)
		if plot then
			Services.PlotService.RenderAll(plot)
		end
		Services.EconomyService.ApplySpeed(p)
		Services.EconomyService.MarkDirty(p)
	end
	return #targets > 0, "Spielstand zurückgesetzt: " .. names(targets)
end

function Actions.TeleportTo(admin, args)
	local target = resolveTargets(admin, args.Target)[1]
	local root = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if not root or not admin.Character then
		return false, "Spieler nicht gefunden"
	end
	admin.Character:PivotTo((root :: BasePart).CFrame * CFrame.new(0, 0, 4))
	return true, "Zu " .. target.DisplayName .. " teleportiert"
end

function Actions.Bring(admin, args)
	local targets = resolveTargets(admin, args.Target)
	local root = admin.Character and admin.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false, "Kein Charakter"
	end
	for i, p in ipairs(targets) do
		if p ~= admin and p.Character then
			local target = (root :: BasePart).CFrame * CFrame.new(i * 3, 0, -4)
			p.Character:PivotTo(target)
			Services.CarryService.NoteTeleport(p, target.Position)
		end
	end
	return #targets > 0, "Geholt: " .. names(targets)
end

function Actions.ClearGround(_admin)
	Services.MeteorService.ClearGround()
	return true, "🧹 Förderband, Gratis-Zone & Eier am Boden geleert"
end

-- 🥚 Egg Rush sofort starten (läuft schon einer: wird verlängert, mehr Eier)
function Actions.EggRush(_admin)
	local count = Services.MeteorService.StartEggRush()
	if count <= 0 then
		return false, "Egg Rush fehlgeschlagen (kein Wiesenboden gefunden)"
	end
	return true, "🥚 Egg Rush gestartet: " .. count .. " Eier!"
end

-- 🛠️ Gadget schenken (gehört dem Spieler danach für immer)
function Actions.GiveGadget(admin, args)
	local gadget = type(args.GadgetId) == "string" and Config.GadgetsById[args.GadgetId] or nil
	if not gadget then
		return false, "Unbekanntes Gadget"
	end
	local targets = resolveTargets(admin, args.Target)
	local given = {}
	for _, p in ipairs(targets) do
		if Services.GadgetService.Give(p, gadget.Id) then
			table.insert(given, p.DisplayName)
			Services.EconomyService.Notify(
				p,
				"🎁 Ein Admin hat dir " .. gadget.Icon .. " " .. gadget.Name .. " geschenkt!",
				"Success"
			)
		end
	end
	return #given > 0, gadget.Icon .. " " .. gadget.Name .. " für " .. table.concat(given, ", ")
end

-- 🎡 Glücksrad-Drehs schenken
function Actions.GiveSpins(admin, args)
	local amount = math.floor(num(args.Amount, 1, 1, 1000))
	local rewards = Services.RewardService
	if not rewards or not rewards.AddSpins then
		return false, "Glücksrad nicht verfügbar"
	end
	local targets = resolveTargets(admin, args.Target)
	local given = {}
	for _, p in ipairs(targets) do
		if Services.DataService.Get(p) then
			rewards.AddSpins(p, amount)
			table.insert(given, p.DisplayName)
			Services.EconomyService.Notify(
				p,
				"🎁 Ein Admin hat dir " .. amount .. " 🎡 Drehs geschenkt!",
				"Success"
			)
		end
	end
	return #given > 0, "🎡 " .. amount .. " Drehs für " .. table.concat(given, ", ")
end

function Actions.AdminAbuse(_admin, args)
	if args.Global then
		publishGlobal({ Type = "AdminAbuse" })
		return true, "😈 ADMIN ABUSE auf ALLEN Servern!"
	end
	runAdminAbuse()
	return true, "😈 ADMIN ABUSE gestartet!"
end

function Actions.Gravity(_admin, args)
	local value = args.Moon and MOON_GRAVITY or DEFAULT_GRAVITY
	if args.Global then
		publishGlobal({ Type = "Gravity", Value = value })
	else
		setGravity(value)
	end
	if args.Moon then
		Services.EconomyService.NotifyAll("🌙 Mond-Schwerkraft! Spring mal hoch!", "Event")
	end
	return true, args.Moon and "🌙 Mond-Schwerkraft an" or "Normale Schwerkraft"
end

function Actions.Freeze(admin, args)
	local targets = resolveTargets(admin, args.Target)
	local done = {}
	for _, p in ipairs(targets) do
		local root = getRoot(p)
		if root then
			root:SetAttribute("TrapFreeze", nil) -- Fallen tauen einen Admin-Freeze nicht auf
			root.Anchored = args.Enabled == true
			table.insert(done, p.DisplayName)
			if args.Enabled == true and p ~= admin then
				Services.EconomyService.Notify(p, "🧊 Ein Admin hat dich eingefroren!", "Error")
			end
		end
	end
	return #done > 0, (args.Enabled and "🧊 Eingefroren: " or "Aufgetaut: ") .. table.concat(done, ", ")
end

function Actions.Size(admin, args)
	local scale = num(args.Scale, 1, 0.3, 4)
	local targets = resolveTargets(admin, args.Target)
	local done = {}
	for _, p in ipairs(targets) do
		if setScale(p, scale) then
			table.insert(done, p.DisplayName)
		end
	end
	return #done > 0, "📏 Größe x" .. scale .. ": " .. table.concat(done, ", ")
end

function Actions.Invisible(admin, args)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		-- Erst einen laufenden Umhang (Gadget) beenden: beide ändern dieselben Transparenzen,
		-- sonst merkt sich setInvisible die Umhang-Werte bzw. der Umhang stellt später alte Werte her
		local gadgets = Services.GadgetService
		if gadgets and gadgets.EndCloak then
			gadgets.EndCloak(p, true)
		end
		setInvisible(p, args.Enabled == true)
	end
	return #targets > 0, (args.Enabled and "👻 Unsichtbar: " or "Sichtbar: ") .. names(targets)
end

-- Foto-Modus: Reihe aller Seltenheiten vor dem Admin (links Common, rechts Admin)
function Actions.Showcase(admin)
	local root = getRoot(admin)
	if not root then
		return false, "Kein Charakter"
	end
	local defs = showcaseDefs()
	if #defs == 0 then
		return false, "Keine Meteore gefunden"
	end
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	local right = look:Cross(Vector3.yAxis) -- quer zur Blickrichtung
	local sizes = {}
	local width = SHOWCASE_GAP * (#defs - 1)
	for i, def in ipairs(defs) do
		sizes[i] = MeteorFactory.GetSize({ Id = def.Id, Lv = 1 })
		width += sizes[i]
	end
	local center = groundBelow(root.Position + look * SHOWCASE_DISTANCE)
	local offset = -width / 2
	for i, def in ipairs(defs) do
		Services.MeteorService.SpawnStatic({
			Id = def.Id,
			Mut = "Normal",
			Position = center + right * (offset + sizes[i] / 2),
			Instant = true,
			Announce = false,
			Lifetime = SHOWCASE_LIFETIME,
		})
		offset += sizes[i] + SHOWCASE_GAP
	end
	return true, "✨ Showcase: " .. #defs .. " Meteore (5 Min)"
end

-- Foto-Modus: leere Slots der eigenen Base mit Deko-Aliens füllen (nur Optik, nichts gespeichert)
function Actions.PhotoBase(admin)
	local plot = Services.PlotService.GetPlot(admin)
	if not plot then
		return false, "Du hast keine Base"
	end
	local count = Services.PlotService.FillPhotoShowcase(plot, photoEntry)
	return true, count > 0 and ("🏠 Foto-Base: " .. count .. " Deko-Aliens") or "🏠 Base ist schon voll"
end

-- Foto-Modus: Deko weg, Slot-Farben zurück, Laufband + Gratis-Zone leer
function Actions.PhotoClear(admin)
	local plot = Services.PlotService.GetPlot(admin)
	if plot then
		Services.PlotService.ClearPhotoShowcase(plot)
		Services.PlotService.UpdateSlotColors(plot)
	end
	Services.MeteorService.ClearGround()
	return true, "🧹 Foto-Deko entfernt, Förderband, Gratis-Zone & Eier geleert"
end

-- -------------------------------------------------------------------
function AdminService.Init(services)
	Services = services
end

function AdminService.Start()
	local function onPlayer(player: Player)
		if AdminService.IsAdmin(player) then
			player:SetAttribute("IsAdmin", true)
			player:SetAttribute("CanFly", true)
		end
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Head", 10)
			updateTag(player)
		end)
		player:GetAttributeChangedSignal("VIP"):Connect(function()
			updateTag(player)
		end)
		if player.Character then
			updateTag(player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		limiter.Clear(player)
		adminCache[player] = nil
		warnedDenied[player] = nil
	end)

	Remotes.Admin.OnServerInvoke = function(player: Player, action: any, args: any)
		-- Spam-Bremse ZUERST (auch für Nicht-Admins, sonst fluten Exploiter das Server-Log)
		if not limiter.Check(player) then
			return { Ok = false, Message = "Zu schnell" }
		end
		if not AdminService.IsAdmin(player) then
			if not warnedDenied[player] then
				warnedDenied[player] = true
				warn("[Admin] Unerlaubter Zugriff von " .. player.Name .. " (" .. player.UserId .. ")")
			end
			return { Ok = false, Message = "Kein Zugriff" }
		end
		if type(action) ~= "string" or not Actions[action] then
			return { Ok = false, Message = "Unbekannte Aktion" }
		end
		if type(args) ~= "table" then
			args = {}
		end
		local ok, success, message, payload = pcall(Actions[action], player, args)
		if not ok then
			warn("[Admin] Fehler bei " .. action .. ": " .. tostring(success))
			return { Ok = false, Message = "Fehler: " .. tostring(success) }
		end
		print(("[Admin] %s -> %s: %s"):format(player.Name, action, tostring(message)))
		return { Ok = success, Message = message, Data = payload }
	end

	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(Config.MessagingTopic, function(packet)
				handleGlobal(packet.Data)
			end)
		end)
		if not ok then
			warn("[Admin] MessagingService nicht verfügbar (in Studio normal): " .. tostring(err))
		end
	end)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">AlienFactory</string>
            <string name="Source"><![CDATA[--!strict
-- Baut das Aussehen eines Aliens (schlüpft aus einem Meteor) aus wenigen einfachen Teilen:
-- Körperform nach "Archetype" (Aliens.luau), Farben, Material/Farbe nach Mutation,
-- Effekte (Regenbogen, Aura, Umriss, Licht) und Namensschild darüber.
--
--  * Mutationen: Gold (Folie), Diamond (Glas), Cosmic (Neon + Funken), Frost (Eis-Körper,
--    Schnee-Füße, Schneeflocken), Lava (glühender Körper, Vulkangestein, kleines Feuer),
--    Rainbow (alle farbigen Teile mit Attribut "Rainbow" -> der Client färbt sie durch).
--  * Umriss (Highlight) nur noch bei Tier "Ultra" + Rarity "Admin" (Roblox zeigt nur ~31 gleichzeitig).
--  * Pivot (model:GetPivot()) = Bodenmitte -> model:PivotTo(Pad-Oberseite) stellt das Alien aufs Pad.
--  * Das Gesicht zeigt in Blickrichtung des Pivots (LookVector / lokales -Z).
--  * Alle Teile sind verankert, ohne Kollision. Nur "Body" (PrimaryPart) ist abfragbar (für Prompts).
--  * Höchstens 12 Teile pro Alien (Admin: 16), damit auch volle Basen nicht laggen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")) :: any
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Aliens = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Aliens"))

type AlienDef = Aliens.AlienDef
type Entry = { Id: string, Alien: string?, Mut: string?, Lv: number? }

-- Aussehen einer Mutation an "Main" (Körper) und "Shade" (Füße, Käfer-Kopf, Arme, Antennen).
-- Die Farbe kommt aus Config.Mutations; ohne Eintrag hier wird nur umgefärbt.
type MutStyle = {
	Material: Enum.Material,
	Transparency: number?, -- mindestens so durchsichtig
	Reflectance: number?, -- Standard 0
	ShadeMaterial: Enum.Material?, -- Standard: wie Material
	ShadeTint: Color3?, -- Shade = Körperfarbe in Richtung dieser Farbe (Standard: dunkler)
	ShadeAlpha: number?,
}

type Ctx = {
	model: Model,
	s: number, -- Gesamt-Skalierung (Seltenheit * Stufe * Modus * Level)
	color: Color3,
	accent: Color3,
	eyes: number,
	antennas: number,
	mutStyle: MutStyle?,
	mutColor: Color3?, -- nil = eigene Farbe (Normal, Regenbogen)
	rainbow: boolean, -- Körper + Leucht-Teile färben sich durch
	rainbowShade: boolean, -- auch die Shade-Teile (Regenbogen-Mutation)
	carry: boolean,
	darkFace: boolean, -- sehr dunkles Gesicht -> leuchtende statt schwarze Knopfaugen
	mainMaterial: Enum.Material,
	mainTransparency: number,
	mainReflectance: number,
	count: number,
	max: number,
	top: number, -- höchster Punkt (unskaliert)
}

type Builder = (ctx: Ctx) -> (Part, number)

local AlienFactory = {}

local MAX_PARTS = 12
local MAX_PARTS_ADMIN = 16
local ADMIN_RANK = 10
local LEVEL_GROWTH = 0.012 -- +1,2% Größe pro Level (Level 20 = +23%)
local LABEL_GAP = 1.6
local SHADOW_MIN_VOLUME = 15 -- nur große Teile werfen Schatten (bewegte Schattenwerfer kosten viel)
local MODE_SCALE: { [string]: number } = { Base = 1, Photo = 1, Carry = 0.55 }

local DARK = Color3.fromRGB(25, 22, 30)
local WHITE = Color3.fromRGB(250, 250, 255)
local GOLD = Color3.fromRGB(255, 200, 40)
local STALK = Color3.fromRGB(245, 235, 215)
local METAL = Color3.fromRGB(70, 72, 82)
local ROCK = Color3.fromRGB(70, 65, 75)
local BLACK = Color3.new(0, 0, 0)
local FROST_LIGHT = Color3.fromRGB(190, 235, 255)
local LAVA_ORANGE = Color3.fromRGB(255, 110, 30)
local LAVA_DARK = Color3.fromRGB(120, 20, 0)
local FALLBACK_RARITY_COLORS: { [string]: Color3 } = { Admin = Color3.fromRGB(255, 40, 40) }

-- Umriss (Highlight) nur für diese Kombination – Roblox zeigt höchstens ~31 Highlights gleichzeitig
local HIGHLIGHT_TIER = "Ultra"
local HIGHLIGHT_RARITY = "Admin"

local SHADE_ALPHA = 0.35 -- Shade-Teile: so viel dunkler als der Körper

-- Teile, die der Client als Augen erkennt (Attribut "Eye" -> lokales Blinzeln)
local EYE_PARTS: { [string]: boolean } = { Eye = true, Pupil = true, Iris = true }

local MUT_STYLES: { [string]: MutStyle } = {
	Gold = { Material = Enum.Material.Foil },
	Diamond = { Material = Enum.Material.Glass, Transparency = 0.15 },
	Cosmic = { Material = Enum.Material.Neon },
	-- Eis-Körper, Füße/Antennen wie aus Schnee (+ Schneeflocken, siehe addEffects)
	Frost = {
		Material = Enum.Material.Ice,
		Reflectance = 0.05,
		ShadeMaterial = Enum.Material.Snow,
		ShadeTint = WHITE,
		ShadeAlpha = 0.55,
	},
	-- glühender Körper, Füße/Antennen aus dunklem Vulkangestein (+ kleines Feuer, siehe addEffects)
	Lava = {
		Material = Enum.Material.Neon,
		ShadeMaterial = Enum.Material.Basalt,
		ShadeTint = BLACK,
		ShadeAlpha = 0.7,
	},
}

-- Symbol vor dem Mutationsnamen im Namensschild (Config.Mutations -> Icon hat Vorrang; das hier ist der Ersatz)
local MUT_ICONS: { [string]: string } = {
	Gold = "🪙",
	Diamond = "💎",
	Cosmic = "🌌",
	Frost = "❄️",
	Lava = "🔥",
	Rainbow = "🌈",
}

local RAINBOW_SEQUENCE = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(80, 255, 80)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 220, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(90, 90, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 220)),
})

local warned: { [string]: boolean } = {}
local function warnOnce(key: string, message: string)
	if not warned[key] then
		warned[key] = true
		warn(message)
	end
end

-- -------------------------------------------------------------------
-- Nachschlagen (robust, falls Config gerade etwas nicht kennt)
-- -------------------------------------------------------------------
local function resolveAlien(entry: Entry): AlienDef
	local alien = entry.Alien and Aliens.ById[entry.Alien]
	if alien then
		return alien
	end
	local options = Aliens.ByMeteor[entry.Id]
	local fallback = options and options[1] and Aliens.ById[options[1].Id] or Aliens.List[1]
	warnOnce(
		"alien:" .. tostring(entry.Alien) .. ":" .. tostring(entry.Id),
		"[AlienFactory] Unbekanntes Alien '" .. tostring(entry.Alien) .. "' -> zeige " .. fallback.Id
	)
	return fallback
end

local function rarityRank(rarityName: string): number
	local index = Config.RarityIndex and Config.RarityIndex[rarityName]
	return index or Aliens.RarityRank[rarityName] or 1
end

local function rarityColor(rarityName: string): Color3
	local rarity = Config.RaritiesByName and Config.RaritiesByName[rarityName]
	return rarity and rarity.Color or FALLBACK_RARITY_COLORS[rarityName] or WHITE
end

local function getMutation(name: string?): any
	local byName = Config.MutationsByName or {}
	return byName[name or "Normal"] or (Config.Mutations and Config.Mutations[1]) or { Name = "Normal", Mult = 1 }
end

local function maxLevel(): number
	return tonumber(Config.MaxLevel) or 20
end

local function levelOf(entry: Entry): number
	local lv = tonumber(entry.Lv) or 1
	if lv ~= lv then
		return 1
	end
	return math.clamp(math.floor(lv), 1, math.max(1, maxLevel()))
end

local function levelScale(lv: number): number
	return 1 + LEVEL_GROWTH * (lv - 1)
end

-- Symbol + Name einer Mutation fürs Schild, z.B. "🔥 Lava"
local function mutationText(mut: any): string
	local name = tostring(mut.Name)
	local configIcon = if type(mut.Icon) == "string" and mut.Icon ~= "" then mut.Icon else nil
	local icon = configIcon or MUT_ICONS[name] or (mut.Rainbow == true and MUT_ICONS.Rainbow) or nil
	return icon and (icon .. " " .. name) or name
end

-- Farbe der Shade-Teile (Füße, Käfer-Kopf, Arme, Antennen) aus der Körperfarbe
local function shadeColorOf(ctx: Ctx, base: Color3): Color3
	local style = ctx.mutStyle
	local tint = style and style.ShadeTint or BLACK
	local alpha = style and style.ShadeAlpha or SHADE_ALPHA
	return base:Lerp(tint, alpha)
end

-- Farbe der Fläche, auf der das Gesicht sitzt (für die Wahl der Augenfarbe).
-- Regenbogen-Teile färbt der Client in hellen, satten Farben -> zählen als hell.
local function faceColorOf(look: Aliens.AlienLook, ctx: Ctx): Color3
	if look.Archetype == "Mushroom" then
		return STALK
	end
	local base = ctx.mutColor or look.Color
	if look.Archetype == "Bug" then
		-- Käfer: Gesicht sitzt am Kopf (Rolle "Shade")
		return ctx.rainbowShade and WHITE or shadeColorOf(ctx, base)
	end
	return ctx.rainbow and WHITE or base
end

local function luminance(color: Color3): number
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- -------------------------------------------------------------------
-- Geometrie-Helfer (alle Maße unskaliert, Ursprung = Bodenmitte, vorne = -Z)
-- -------------------------------------------------------------------
local function room(ctx: Ctx, amount: number): boolean
	return ctx.count + amount <= ctx.max
end

-- Halbe Höhe eines gedrehten Quaders (für den höchsten Punkt)
local function halfHeight(cf: CFrame, size: Vector3): number
	return (math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z)
		/ 2
end

-- CFrame, dessen X-Achse in Richtung "axis" zeigt (für Zylinder, Stäbe, Tentakel)
local function axisCFrame(center: Vector3, axis: Vector3): CFrame
	local x = axis.Magnitude > 1e-4 and axis.Unit or Vector3.xAxis
	local ref = math.abs(x.Y) < 0.9 and Vector3.yAxis or Vector3.zAxis
	local z = x:Cross(ref).Unit
	local y = z:Cross(x).Unit
	return CFrame.fromMatrix(center, x, y, z)
end

-- CFrame an "pos", dessen Vorderseite (-Z) in Richtung "normal" zeigt
local function facing(pos: Vector3, normal: Vector3): CFrame
	local n = normal.Magnitude > 1e-4 and normal.Unit or -Vector3.zAxis
	local up = math.abs(n.Y) < 0.95 and Vector3.yAxis or Vector3.zAxis
	return CFrame.lookAt(pos, pos + n, up)
end

-- Punkt + Normale auf der Vorderseite (-Z) eines Ellipsoids bei Höhe y und seitlich x
local function frontPoint(center: Vector3, radii: Vector3, x: number, y: number): (Vector3, Vector3)
	local dx = (x - center.X) / radii.X
	local dy = (y - center.Y) / radii.Y
	local depth = math.sqrt(math.max(0, 1 - dx * dx - dy * dy))
	local point = Vector3.new(x, y, center.Z - radii.Z * depth)
	local rel = point - center
	local normal = Vector3.new(rel.X / radii.X ^ 2, rel.Y / radii.Y ^ 2, rel.Z / radii.Z ^ 2)
	return point, normal.Magnitude > 1e-4 and normal.Unit or -Vector3.zAxis
end

-- Höhe der Oberseite eines Ellipsoids bei (x, z)
local function topY(center: Vector3, radii: Vector3, x: number, z: number): number
	local dx = (x - center.X) / radii.X
	local dz = (z - center.Z) / radii.Z
	return center.Y + radii.Y * math.sqrt(math.max(0, 1 - dx * dx - dz * dz))
end

local function styleRole(ctx: Ctx, part: Part, role: string)
	local material = Enum.Material.SmoothPlastic
	local color = ctx.color
	local transparency = 0
	local reflectance = 0
	if role == "Main" or role == "Shade" then
		material = ctx.mainMaterial
		transparency = ctx.mainTransparency
		reflectance = ctx.mainReflectance
		color = ctx.mutColor or ctx.color
		local style = ctx.mutStyle
		if style then
			material = style.Material
			transparency = math.max(transparency, style.Transparency or 0)
			reflectance = style.Reflectance or 0
		end
		if role == "Shade" then
			if style and style.ShadeMaterial then
				material = style.ShadeMaterial
			end
			color = shadeColorOf(ctx, color)
			if ctx.rainbowShade then
				part:SetAttribute("Rainbow", true)
			end
		elseif ctx.rainbow then
			part:SetAttribute("Rainbow", true)
		end
	elseif role == "Accent" then
		color = ctx.accent
	elseif role == "Glow" then
		color = ctx.accent
		material = Enum.Material.Neon
		if ctx.rainbow then
			part:SetAttribute("Rainbow", true)
		end
	elseif role == "Dark" then
		color = DARK
		reflectance = 0.25
	elseif role == "White" then
		color = WHITE
	elseif role == "Gold" then
		color = GOLD
		material = Enum.Material.Foil
	elseif role == "Stalk" then
		color = STALK
	elseif role == "Metal" then
		color = METAL
		reflectance = 0.2
	elseif role == "Rock" then
		color = ctx.color:Lerp(ROCK, 0.65)
		material = Enum.Material.Slate
	elseif role == "Cape" then
		color = ctx.accent
		material = Enum.Material.Fabric
	end
	part.Material = material
	part.Color = color
	part.Transparency = transparency
	part.Reflectance = reflectance
end

-- shape: "Block" (Standard), "Ball", "Cylinder" (Achse = X) oder "Ellipsoid"
local function makePart(ctx: Ctx, name: string, role: string, size: Vector3, cf: CFrame, shape: string?): Part
	ctx.count += 1
	local s = ctx.s
	local part = Instance.new("Part")
	part.Name = name
	if shape == "Ball" then
		part.Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		part.Shape = Enum.PartType.Cylinder
	elseif shape == "Ellipsoid" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
	part.Size = size * s
	part.CFrame = CFrame.new(cf.Position * s) * cf.Rotation
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	local scaled = part.Size
	part.CastShadow = not ctx.carry and scaled.X * scaled.Y * scaled.Z >= SHADOW_MIN_VOLUME
	if ctx.carry then
		part.Massless = true
	end
	styleRole(ctx, part, role)
	if EYE_PARTS[name] then
		part:SetAttribute("Eye", true) -- Client: Augen blinzeln lokal (rein optisch)
	end
	ctx.top = math.max(ctx.top, cf.Position.Y + halfHeight(cf, size))
	part.Parent = ctx.model
	return part
end

-- Wie makePart, aber nur wenn noch Platz im Teile-Budget ist
local function tryPart(ctx: Ctx, name: string, role: string, size: Vector3, cf: CFrame, shape: string?): Part?
	if not room(ctx, 1) then
		return nil
	end
	return makePart(ctx, name, role, size, cf, shape)
end

-- Länglicher Teil von "from" nach "to" (Arme, Beine, Tentakel, Antennen)
local function stick(
	ctx: Ctx,
	name: string,
	role: string,
	from: Vector3,
	to: Vector3,
	thickness: number,
	shape: string
): Part?
	local axis = to - from
	return tryPart(
		ctx,
		name,
		role,
		Vector3.new(axis.Magnitude, thickness, thickness),
		axisCFrame((from + to) / 2, axis),
		shape
	)
end

-- -------------------------------------------------------------------
-- Gesicht: Augen, Mund, Antennen
-- -------------------------------------------------------------------
-- style: "Big" (weiß + Pupille), "Beady" (glänzend schwarz), "Oval" (Geist), "Glow" (Roboter)
local function eyeParts(style: string): number
	return style == "Big" and 2 or 1
end

local function addEye(ctx: Ctx, pos: Vector3, normal: Vector3, size: number, style: string)
	local cf = facing(pos, normal)
	if style == "Big" then
		makePart(ctx, "Eye", "White", Vector3.one * size, cf, "Ball")
		makePart(ctx, "Pupil", "Dark", Vector3.one * size * 0.5, cf * CFrame.new(0, 0, -size * 0.32), "Ball")
	elseif style == "Oval" then
		local role = ctx.darkFace and "Glow" or "Dark"
		makePart(ctx, "Eye", role, Vector3.new(size * 0.6, size, size * 0.35), cf, "Ellipsoid")
	elseif style == "Glow" then
		makePart(ctx, "Eye", "Glow", Vector3.new(size, size * 0.7, size * 0.4), cf, "Block")
	else
		makePart(ctx, "Eye", ctx.darkFace and "Glow" or "Dark", Vector3.one * size, cf, "Ball")
	end
end

-- Seitliche Versätze (x, Höhe) für n Augen
local function eyeLayout(n: number, spread: number): { Vector2 }
	if n <= 1 then
		return { Vector2.zero }
	elseif n == 2 then
		return { Vector2.new(-spread, 0), Vector2.new(spread, 0) }
	elseif n == 3 then
		return { Vector2.new(-spread * 1.15, -0.05), Vector2.new(0, 0.2), Vector2.new(spread * 1.15, -0.05) }
	end
	return {
		Vector2.new(-spread * 1.5, -0.12),
		Vector2.new(-spread * 0.5, 0.05),
		Vector2.new(spread * 0.5, 0.05),
		Vector2.new(spread * 1.5, -0.12),
	}
end

-- Passt den Augen-Stil ans Budget an (Big -> Beady), damit immer alle Augen da sind
local function fitEyeStyle(ctx: Ctx, n: number, style: string): string
	if not room(ctx, n * eyeParts(style)) then
		return style == "Big" and "Beady" or style
	end
	return style
end

local function addEyesOnEllipsoid(
	ctx: Ctx,
	center: Vector3,
	radii: Vector3,
	y: number,
	spread: number,
	size: number,
	style: string
)
	local n = ctx.eyes
	if n >= 3 and style == "Big" then
		style = "Beady"
		size *= 0.75
	end
	style = fitEyeStyle(ctx, n, style)
	local embed = style == "Big" and 0.15 or 0.08
	for _, offset in ipairs(eyeLayout(n, spread)) do
		local point, normal = frontPoint(center, radii, offset.X, y + offset.Y)
		addEye(ctx, point + normal * (size * embed), normal, size, style)
	end
end

local function addMouthOnEllipsoid(ctx: Ctx, center: Vector3, radii: Vector3, y: number, width: number)
	if not room(ctx, 1) then
		return
	end
	local point, normal = frontPoint(center, radii, 0, y)
	makePart(ctx, "Mouth", "Dark", Vector3.new(width, 0.24, 0.3), facing(point, normal), "Ellipsoid")
end

-- Antennen mit leuchtender Kugel. Weniger Platz im Budget -> erst ohne Kugel, dann weniger Antennen.
-- baseYAt(x) liefert die Höhe der Kopf-Oberseite an der Stelle x.
local function addAntennas(
	ctx: Ctx,
	baseYAt: (x: number) -> number,
	z: number,
	spread: number,
	length: number,
	lean: number,
	tilt: number
)
	local n = ctx.antennas
	local perAntenna = 2
	while n > 0 and not room(ctx, n * perAntenna) do
		if perAntenna == 2 then
			perAntenna = 1
		else
			perAntenna = 2
			n -= 1
		end
	end
	if n <= 0 then
		return
	end
	local xs = n == 1 and { 0 } or (n == 2 and { -spread, spread } or { -spread, 0, spread })
	for _, x in ipairs(xs) do
		local side = x > 0 and 1 or (x < 0 and -1 or 0)
		local dir = Vector3.new(side * math.sin(lean), math.cos(lean), -math.sin(tilt)).Unit
		local base = Vector3.new(x, baseYAt(x) - 0.05, z)
		local tip = base + dir * length
		stick(ctx, "Antenna", "Shade", base, tip, 0.14, "Cylinder")
		if perAntenna == 2 then
			tryPart(ctx, "AntennaTip", "Glow", Vector3.one * 0.38, CFrame.new(tip), "Ball")
		end
	end
end

-- -------------------------------------------------------------------
-- KÖRPERFORMEN – jede gibt (Body, Höhe der Body-Mitte) zurück
-- -------------------------------------------------------------------
local Builders: { [string]: Builder } = {}

-- Schleim-Tropfen mit Bäckchen
Builders.Blob = function(ctx: Ctx): (Part, number)
	local c = Vector3.new(0, 1.2, 0)
	local r = Vector3.new(1.5, 1.2, 1.5)
	local body = makePart(ctx, "Body", "Main", r * 2, CFrame.new(c), "Ellipsoid")
	local topC = Vector3.new(0, 2.15, 0.1)
	local topR = Vector3.new(0.85, 0.65, 0.85)
	makePart(ctx, "Top", "Main", topR * 2, CFrame.new(topC), "Ellipsoid")
	addEyesOnEllipsoid(ctx, c, r, 1.55, 0.55, 0.75, "Big")
	addAntennas(ctx, function(x)
		return topY(topC, topR, x, topC.Z)
	end, topC.Z, 0.4, 0.9, math.rad(20), 0)
	addMouthOnEllipsoid(ctx, c, r, 0.8, 0.7)
	if room(ctx, 2) then
		for _, side in ipairs({ -1, 1 }) do
			local point, normal = frontPoint(c, r, side * 0.95, 0.95)
			makePart(ctx, "Cheek", "Accent", Vector3.new(0.45, 0.28, 0.15), facing(point, normal), "Ellipsoid")
		end
	end
	return body, c.Y
end

-- Einäugiger Riese mit Füßen und Armen
Builders.Cyclops = function(ctx: Ctx): (Part, number)
	local c = Vector3.new(0, 1.95, 0)
	local r = Vector3.new(1.3, 1.5, 1.2)
	local body = makePart(ctx, "Body", "Main", r * 2, CFrame.new(c), "Ellipsoid")
	for _, side in ipairs({ -1, 1 }) do
		makePart(ctx, "Foot", "Shade", Vector3.new(0.9, 0.5, 1.1), CFrame.new(side * 0.55, 0.25, -0.1), "Ellipsoid")
	end
	if ctx.eyes == 1 then
		local point, normal = frontPoint(c, r, 0, 2.35)
		local eyeCenter = point + normal * 0.2
		local cf = facing(eyeCenter, normal)
		makePart(ctx, "Eye", "White", Vector3.one * 1.35, cf, "Ball")
		makePart(ctx, "Iris", "Accent", Vector3.one * 0.8, cf * CFrame.new(0, 0, -0.42), "Ball")
		makePart(ctx, "Pupil", "Dark", Vector3.one * 0.42, cf * CFrame.new(0, 0, -0.68), "Ball")
	else
		addEyesOnEllipsoid(ctx, c, r, 2.35, 0.5, 0.7, "Big")
	end
	addAntennas(ctx, function(x)
		return topY(c, r, x, 0)
	end, 0, 0.45, 0.85, math.rad(25), 0)
	addMouthOnEllipsoid(ctx, c, r, 1.35, 0.9)
	if room(ctx, 2) then
		for _, side in ipairs({ -1, 1 }) do
			stick(
				ctx,
				"Arm",
				"Main",
				Vector3.new(side * 1.1, 2.0, 0),
				Vector3.new(side * 1.5, 1.3, -0.15),
				0.5,
				"Ellipsoid"
			)
		end
	end
	return body, c.Y
end

-- Tintenfisch mit Tentakeln
Builders.Squid = function(ctx: Ctx): (Part, number)
	local c = Vector3.new(0, 2.6, 0)
	local r = Vector3.new(1.3, 1.5, 1.3)
	local body = makePart(ctx, "Body", "Main", r * 2, CFrame.new(c), "Ellipsoid")
	local function tentacle(angle: number, reach: number)
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		stick(
			ctx,
			"Tentacle",
			"Main",
			dir * 0.6 + Vector3.new(0, 1.4, 0),
			dir * reach + Vector3.new(0, 0.2, 0),
			0.5,
			"Ellipsoid"
		)
	end
	for i = 0, 3 do
		tentacle(math.rad(45 + 90 * i), 1.35)
	end
	addEyesOnEllipsoid(ctx, c, r, 2.45, 0.55, 0.75, "Big")
	addAntennas(ctx, function(x)
		return topY(c, r, x, 0)
	end, 0, 0.45, 0.85, math.rad(20), 0)
	if room(ctx, 2) then
		tentacle(0, 1.45)
		tentacle(math.pi, 1.45)
	end
	if room(ctx, 2) then
		tentacle(math.rad(90), 1.35)
		tentacle(math.rad(-90), 1.2)
	end
	return body, c.Y
end

-- Käfer mit Panzer, Kopf, Beinen und Fühlern
Builders.Bug = function(ctx: Ctx): (Part, number)
	local c = Vector3.new(0, 1.25, 0.25)
	local r = Vector3.new(1.3, 0.85, 1.4)
	local body = makePart(ctx, "Body", "Main", r * 2, CFrame.new(c), "Ellipsoid")
	local headC = Vector3.new(0, 1.2, -1.25)
	local headR = Vector3.new(0.8, 0.65, 0.6)
	makePart(ctx, "Head", "Shade", headR * 2, CFrame.new(headC), "Ellipsoid")
	for _, side in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -0.35, 0.75 }) do
			stick(
				ctx,
				"Leg",
				"Dark",
				Vector3.new(side * 0.9, 0.8, z),
				Vector3.new(side * 1.5, 0.05, z + 0.15),
				0.2,
				"Cylinder"
			)
		end
	end
	addEyesOnEllipsoid(ctx, headC, headR, 1.35, 0.32, 0.45, "Beady")
	addAntennas(ctx, function(x)
		return topY(headC, headR, x, headC.Z)
	end, headC.Z, 0.25, 0.9, math.rad(25), math.rad(30))
	if room(ctx, 2) then
		for _, side in ipairs({ -1, 1 }) do
			local x, z = side * 0.55, 0.6
			makePart(ctx, "Spot", "Accent", Vector3.one * 0.55, CFrame.new(x, topY(c, r, x, z) - 0.08, z), "Ball")
		end
	end
	return body, c.Y
end

-- Roboter auf Ketten mit Visier
Builders.Robot = function(ctx: Ctx): (Part, number)
	makePart(ctx, "Treads", "Metal", Vector3.new(2.2, 0.6, 1.8), CFrame.new(0, 0.3, 0))
	local bodyY = 1.55
	local body = makePart(ctx, "Body", "Main", Vector3.new(2.4, 1.9, 1.8), CFrame.new(0, bodyY, 0))
	makePart(ctx, "Head", "Main", Vector3.new(1.8, 1.3, 1.5), CFrame.new(0, 3.15, 0))
	makePart(ctx, "Visor", "Dark", Vector3.new(1.5, 0.6, 0.12), CFrame.new(0, 3.2, -0.76))
	local style = fitEyeStyle(ctx, ctx.eyes, "Glow")
	for _, offset in ipairs(eyeLayout(ctx.eyes, 0.42)) do
		addEye(ctx, Vector3.new(offset.X, 3.2 + offset.Y * 0.5, -0.84), -Vector3.zAxis, 0.32, style)
	end
	if room(ctx, 2) then
		for _, side in ipairs({ -1, 1 }) do
			makePart(
				ctx,
				"Arm",
				"Shade",
				Vector3.new(0.45, 1.4, 0.45),
				CFrame.new(side * 1.42, 1.5, 0) * CFrame.Angles(0, 0, math.rad(side * 8))
			)
		end
	end
	addAntennas(ctx, function()
		return 3.8
	end, 0, 0.5, 0.8, math.rad(15), 0)
	tryPart(ctx, "ChestLight", "Glow", Vector3.one * 0.5, CFrame.new(0, 1.75, -0.88), "Ball")
	tryPart(ctx, "Grill", "Dark", Vector3.new(0.8, 0.14, 0.1), CFrame.new(0, 2.75, -0.76))
	return body, bodyY
end

-- Schwebendes Gespenst
Builders.Ghost = function(ctx: Ctx): (Part, number)
	ctx.mainTransparency = math.max(ctx.mainTransparency, 0.1)
	local c = Vector3.new(0, 2.55, 0)
	local r = Vector3.new(1.3, 1.45, 1.25)
	local body = makePart(ctx, "Body", "Main", r * 2, CFrame.new(c), "Ellipsoid")
	makePart(ctx, "Tail", "Main", Vector3.new(1.9, 1.6, 1.9), CFrame.new(0, 1.35, 0.15), "Ellipsoid")
	addEyesOnEllipsoid(ctx, c, r, 2.8, 0.48, 0.75, "Oval")
	addAntennas(ctx, function(x)
		return topY(c, r, x, 0)
	end, 0, 0.45, 0.8, math.rad(20), 0)
	if room(ctx, 1) then
		local point, normal = frontPoint(c, r, 0, 2.05)
		makePart(ctx, "Mouth", "Dark", Vector3.new(0.5, 0.6, 0.25), facing(point, normal), "Ellipsoid")
	end
	if room(ctx, 2) then
		for _, side in ipairs({ -1, 1 }) do
			stick(
				ctx,
				"Arm",
				"Main",
				Vector3.new(side * 1.05, 2.5, 0),
				Vector3.new(side * 1.45, 1.95, -0.25),
				0.55,
				"Ellipsoid"
			)
		end
	end
	if room(ctx, 3) then
		for i = 0, 2 do
			local angle = math.rad(90 + 120 * i)
			makePart(
				ctx,
				"Wisp",
				"Main",
				Vector3.one * 0.7,
				CFrame.new(math.cos(angle) * 0.6, 0.55, math.sin(angle) * 0.6),
				"Ball"
			)
		end
	end
	return body, c.Y
end

-- Lebender Edelstein (Würfel auf der Spitze) auf einem Felsen, mit leuchtenden Splittern
Builders.Crystal = function(ctx: Ctx): (Part, number)
	ctx.mainReflectance = math.max(ctx.mainReflectance, 0.2)
	makePart(ctx, "Rock", "Rock", Vector3.new(3.0, 0.8, 3.0), CFrame.new(0, 0.4, 0), "Ellipsoid")
	-- Die 3 oberen Würfelflächen zeigen schräg nach oben, eine davon genau nach vorne (-Z)
	local a, b = 1 / math.sqrt(3), math.sqrt(2 / 3)
	local h = math.sqrt(3) / 2
	local front = Vector3.new(0, a, -b)
	local backLeft = Vector3.new(-h * b, a, 0.5 * b)
	local backRight = Vector3.new(h * b, a, 0.5 * b)
	local side = 2.0
	local bodyY = 0.45 + side * h
	local c = Vector3.new(0, bodyY, 0)
	local body = makePart(ctx, "Body", "Main", Vector3.one * side, CFrame.fromMatrix(c, front, backLeft, backRight))
	-- Gesicht auf der vorderen Fläche (von vorne gesehen eine Raute)
	local faceCenter = c + front * (side / 2)
	local faceUp = Vector3.new(0, b, a)
	local style = fitEyeStyle(ctx, ctx.eyes, ctx.eyes >= 3 and "Beady" or "Big")
	local size = style == "Big" and 0.6 or 0.42
	for _, offset in ipairs(eyeLayout(ctx.eyes, 0.38)) do
		local pos = faceCenter + Vector3.xAxis * offset.X + faceUp * (0.2 + offset.Y) + front * (size * 0.2)
		addEye(ctx, pos, front, size, style)
	end
	if room(ctx, 1) then
		makePart(ctx, "Mouth", "Dark", Vector3.new(0.5, 0.14, 0.1), facing(faceCenter - faceUp * 0.45, front))
	end
	addAntennas(ctx, function()
		return bodyY + side * h - 0.2
	end, 0, 0.3, 0.8, math.rad(20), 0)
	if room(ctx, 2) then
		for _, sideSign in ipairs({ -1, 1 }) do
			makePart(
				ctx,
				"Shard",
				"Glow",
				Vector3.new(0.6, 1.7, 0.6),
				CFrame.new(sideSign * 0.95, 1.25, 0.4) * CFrame.Angles(0, math.rad(45), math.rad(-sideSign * 25))
			)
		end
	end
	tryPart(
		ctx,
		"Shard",
		"Glow",
		Vector3.new(0.6, 1.5, 0.6),
		CFrame.new(0, 1.2, 1.0) * CFrame.Angles(math.rad(25), math.rad(45), 0)
	)
	return body, bodyY
end

-- Stachelkugel
Builders.Spiky = function(ctx: Ctx): (Part, number)
	local radius = 1.4
	local c = Vector3.new(0, radius, 0)
	local r = Vector3.one * radius
	local body = makePart(ctx, "Body", "Main", r * 2, CFrame.new(c), "Ball")
	addEyesOnEllipsoid(ctx, c, r, 1.65, 0.5, 0.7, "Big")
	addMouthOnEllipsoid(ctx, c, r, 1.0, 0.6)
	addAntennas(ctx, function(x)
		return topY(c, r, x, 0)
	end, 0, 0.45, 0.8, math.rad(25), 0)
	local function spike(dir: Vector3)
		local d = dir.Unit
		tryPart(ctx, "Spike", "Accent", Vector3.new(1.4, 0.5, 0.5), axisCFrame(c + d * (radius + 0.3), d), "Ellipsoid")
	end
	spike(Vector3.new(0, 1, 0.15))
	local pairsList = {
		Vector3.new(0.6, 0.75, 0.2),
		Vector3.new(0.55, 0.45, 0.7),
		Vector3.new(0.3, 0.9, -0.35),
	}
	for i, dir in ipairs(pairsList) do
		if room(ctx, 2) then
			spike(dir)
			spike(Vector3.new(-dir.X, dir.Y, dir.Z))
		end
		if i == 2 and room(ctx, 1) then
			spike(Vector3.new(0, 0.6, 0.8))
		end
	end
	return body, c.Y
end

-- König mit Krone, Umhang und Schnurrbart
Builders.King = function(ctx: Ctx): (Part, number)
	local c = Vector3.new(0, 1.4, 0)
	local r = Vector3.new(1.35, 1.35, 1.25)
	local body = makePart(ctx, "Body", "Main", r * 2, CFrame.new(c), "Ellipsoid")
	local crownY = 2.85
	makePart(
		ctx,
		"Crown",
		"Gold",
		Vector3.new(0.6, 1.7, 1.7),
		CFrame.new(0, crownY, 0) * CFrame.Angles(0, 0, math.rad(90)),
		"Cylinder"
	)
	for _, pos in ipairs({ Vector3.new(-0.7, 3.3, 0), Vector3.new(0.7, 3.3, 0), Vector3.new(0, 3.35, -0.7) }) do
		makePart(
			ctx,
			"CrownPoint",
			"Gold",
			Vector3.one * 0.45,
			CFrame.new(pos) * CFrame.Angles(0, math.rad(45), 0) * CFrame.Angles(math.rad(45), 0, 0)
		)
	end
	addEyesOnEllipsoid(ctx, c, r, 1.8, 0.5, 0.7, "Big")
	addAntennas(ctx, function()
		return 3.15
	end, 0.3, 0.45, 0.8, math.rad(25), 0)
	if room(ctx, 1) then
		local point, normal = frontPoint(c, r, 0, 1.3)
		makePart(ctx, "Mustache", "Dark", Vector3.new(1.0, 0.28, 0.3), facing(point, normal), "Ellipsoid")
	end
	tryPart(ctx, "Cape", "Cape", Vector3.new(2.4, 2.3, 0.35), CFrame.new(0, 1.35, 1.2), "Ellipsoid")
	tryPart(ctx, "Gem", "Glow", Vector3.one * 0.32, CFrame.new(0, crownY, -0.88), "Ball")
	if room(ctx, 2) then
		for _, side in ipairs({ -1, 1 }) do
			makePart(
				ctx,
				"Foot",
				"Shade",
				Vector3.new(0.85, 0.45, 1.0),
				CFrame.new(side * 0.55, 0.22, -0.3),
				"Ellipsoid"
			)
		end
	end
	return body, c.Y
end

-- Pilz-Alien: Gesicht im Stiel, gepunkteter Hut
Builders.Mushroom = function(ctx: Ctx): (Part, number)
	local c = Vector3.new(0, 1.25, 0)
	local r = Vector3.new(1.0, 1.25, 1.0)
	local body = makePart(ctx, "Body", "Stalk", r * 2, CFrame.new(c), "Ellipsoid")
	local capC = Vector3.new(0, 2.65, 0.05)
	local capR = Vector3.new(1.7, 0.85, 1.7)
	makePart(ctx, "Cap", "Main", capR * 2, CFrame.new(capC), "Ellipsoid")
	addEyesOnEllipsoid(ctx, c, r, 1.35, 0.38, 0.62, "Big")
	addMouthOnEllipsoid(ctx, c, r, 0.75, 0.5)
	addAntennas(ctx, function(x)
		return topY(capC, capR, x, capC.Z)
	end, capC.Z, 0.5, 0.8, math.rad(20), 0)
	local function spot(x: number, z: number)
		tryPart(ctx, "Spot", "Accent", Vector3.one * 0.55, CFrame.new(x, topY(capC, capR, x, z) - 0.12, z), "Ball")
	end
	spot(0, capC.Z)
	if room(ctx, 2) then
		spot(-0.95, -0.6)
		spot(0.95, -0.6)
	end
	if room(ctx, 2) then
		spot(-1.0, 0.75)
		spot(1.0, 0.75)
	end
	return body, c.Y
end

-- Admin-Extra: leuchtende Kugeln rund ums Alien
local function addOrbs(ctx: Ctx, height: number)
	for i = 0, 3 do
		if not room(ctx, 1) then
			return
		end
		local angle = math.rad(45 + 90 * i)
		makePart(
			ctx,
			"Orb",
			"Glow",
			Vector3.one * 0.55,
			CFrame.new(math.cos(angle) * 1.75, height + (i % 2) * 0.5, math.sin(angle) * 1.75),
			"Ball"
		)
	end
end

-- -------------------------------------------------------------------
-- Effekte + Namensschild
-- -------------------------------------------------------------------
-- Glitzer-Partikel rund ums Alien (Aura der seltenen Aliens, Regenbogen-Mutation)
local function addAura(body: Part, color: ColorSequence, s: number, rate: number)
	local aura = Instance.new("ParticleEmitter")
	aura.Name = "Aura"
	aura.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	aura.Color = color
	aura.LightEmission = 1
	aura.LightInfluence = 0
	aura.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35 * s),
		NumberSequenceKeypoint.new(0.6, 0.25 * s),
		NumberSequenceKeypoint.new(1, 0),
	})
	aura.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	aura.Lifetime = NumberRange.new(1, 1.8)
	aura.Speed = NumberRange.new(0.4, 1.2)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Acceleration = Vector3.new(0, 1.2 * s, 0)
	aura.RotSpeed = NumberRange.new(-90, 90)
	aura.Rate = rate
	aura.Parent = body
end

-- Frost-Mutation: ein paar Schneeflocken rieseln vom Alien herab
local function addSnow(body: Part, s: number, carry: boolean)
	local snow = Instance.new("ParticleEmitter")
	snow.Name = "FrostSnow"
	snow.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	snow.Color = ColorSequence.new(WHITE, FROST_LIGHT)
	snow.LightEmission = 0.5
	snow.LightInfluence = 0.2
	snow.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.22 * s),
		NumberSequenceKeypoint.new(1, 0),
	})
	snow.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	snow.Lifetime = NumberRange.new(1.2, 2)
	snow.Speed = NumberRange.new(0.2, 0.6)
	snow.SpreadAngle = Vector2.new(180, 180)
	snow.Acceleration = Vector3.new(0, -1.5 * s, 0)
	snow.Drag = 1
	snow.RotSpeed = NumberRange.new(-60, 60)
	snow.Rate = carry and 2 or 4
	snow.Parent = body
end

local function addEffects(model: Model, body: Part, alien: AlienDef, mut: any, s: number, carry: boolean)
	local fx = alien.Effects
	local rank = rarityRank(alien.Rarity)
	local color = rarityColor(alien.Rarity)
	local accent = alien.Look.Accent
	local rainbowMut = mut.Rainbow == true
	local mutName = tostring(mut.Name)

	-- Umriss: nur Ultra-Admin-Aliens, getragen keiner. Startet AUS – der Client schaltet nur die
	-- nächsten paar ein (Roblox zeigt höchstens 31 Highlights gleichzeitig, jedes kostet einen Render-Durchgang).
	if fx.Highlight and not carry and alien.Tier == HIGHLIGHT_TIER and alien.Rarity == HIGHLIGHT_RARITY then
		local highlight = Instance.new("Highlight")
		highlight.Name = "Glow"
		highlight.Enabled = false
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.FillColor = color
		highlight.FillTransparency = 0.85
		highlight.OutlineColor = accent
		highlight.OutlineTransparency = 0.1
		if fx.Rainbow or rainbowMut then
			highlight:SetAttribute("Rainbow", true)
		end
		highlight.Parent = model
	end

	if fx.Aura then
		local rate = rank >= ADMIN_RANK and 18 or (rank >= 8 and 10 or 6)
		local auraColor = (fx.Rainbow or rainbowMut) and RAINBOW_SEQUENCE or ColorSequence.new(color, accent)
		addAura(body, auraColor, s, carry and math.ceil(rate / 2) or rate)
	elseif rainbowMut then
		-- Regenbogen-Mutation: bunte Glitzer-Aura auch ohne eigene Aura
		addAura(body, RAINBOW_SEQUENCE, s, carry and 3 or 6)
	end

	if fx.BigLight then
		local light = Instance.new("PointLight")
		light.Name = "BigLight"
		light.Range = 30
		light.Brightness = 2.5
		light.Color = accent:Lerp(color, 0.5)
		light.Shadows = false
		light.Parent = body
	elseif rank >= 8 or (rank >= 5 and alien.Tier ~= "Normal") then
		-- kleines Licht erst ab Legendary (sparsam)
		local light = Instance.new("PointLight")
		light.Name = "Light"
		light.Range = 8 + (rank - 5) * 1.5
		light.Brightness = 1.2
		light.Color = color
		light.Shadows = false
		light.Parent = body
	end

	if fx.Fire then
		local fire = Instance.new("Fire")
		fire.Color = color
		fire.SecondaryColor = accent
		fire.Size = 3 * s
		fire.Heat = 6
		fire.Parent = body
	elseif mutName == "Lava" then
		-- Lava-Mutation: kleines Feuer (nur eins pro Alien)
		local fire = Instance.new("Fire")
		fire.Name = "LavaFire"
		fire.Color = typeof(mut.Color) == "Color3" and mut.Color or LAVA_ORANGE
		fire.SecondaryColor = LAVA_DARK
		fire.Size = math.clamp(2.2 * s, 2, 6)
		fire.Heat = 4
		fire.Parent = body
	end

	if mutName == "Frost" then
		addSnow(body, s, carry)
	end

	if mutName == "Cosmic" then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = mut.Color or color
		sparkles.Parent = body
	elseif rainbowMut and not carry then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = WHITE
		sparkles.Parent = body
	end
end

local function makeLabel(parent: Instance, name: string, order: number, textSize: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, textSize + 4)
	label.LayoutOrder = order
	label.Font = Enum.Font.FredokaOne
	label.TextSize = textSize
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = ""
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function getBody(model: Model): BasePart?
	local primary = model.PrimaryPart
	if primary then
		return primary
	end
	local body = model:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		return body
	end
	return nil
end

-- Abstand Schild <-> Body-Mitte passend zur aktuellen Größe
local function updateLabelOffset(model: Model, body: BasePart)
	local gui = body:FindFirstChild("Info")
	if not gui or not gui:IsA("BillboardGui") then
		return
	end
	local scale = model:GetScale()
	local top = tonumber(model:GetAttribute("TopHeight")) or body.Size.Y
	local pivot = tonumber(model:GetAttribute("PivotHeight")) or body.Size.Y / 2
	gui.StudsOffsetWorldSpace = Vector3.new(0, (top - pivot) * scale + LABEL_GAP, 0)
end

-- -------------------------------------------------------------------
-- ÖFFENTLICH
-- -------------------------------------------------------------------

-- Schild aktualisieren: Name, "Stufe • Seltenheit [• 🔥 Mutation]", "$X/s ⚡Lv n"
function AlienFactory.UpdateLabel(model: Model, entry: Entry)
	local body = getBody(model)
	local gui = body and body:FindFirstChild("Info")
	local frame = gui and gui:FindFirstChild("Frame")
	if not frame then
		return
	end
	local nameLabel = frame:FindFirstChild("NameLabel") :: TextLabel?
	local rarityLabel = frame:FindFirstChild("RarityLabel") :: TextLabel?
	local valueLabel = frame:FindFirstChild("ValueLabel") :: TextLabel?
	local alien = resolveAlien(entry)
	local mut = getMutation(entry.Mut)
	local color = rarityColor(alien.Rarity)

	if nameLabel then
		nameLabel.Text = alien.Name
		nameLabel.TextColor3 = color
	end
	if rarityLabel then
		local tag = alien.Tier .. " • " .. alien.Rarity
		if mut.Name ~= "Normal" then
			tag ..= " • " .. mutationText(mut)
		end
		rarityLabel.Text = tag
		rarityLabel.TextColor3 = mut.Color
			or (alien.Tier == "Normal" and color or Aliens.TierColors[alien.Tier] or color)
	end
	if valueLabel then
		-- Unbekannte Alien-Id -> mit dem Ersatz-Alien rechnen, damit Config nicht stolpert
		local incomeEntry = (entry.Alien == alien.Id) and entry
			or { Id = entry.Id, Alien = alien.Id, Mut = entry.Mut, Lv = entry.Lv }
		local income = tonumber(Config.MeteorIncome(incomeEntry)) or 0
		local lv = levelOf(entry)
		local lvText = lv >= maxLevel() and "MAX" or tostring(lv)
		valueLabel.Text = Util.FormatCash(income) .. "/s  ⚡Lv " .. lvText
		valueLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
	end
end

-- entry = { Id = meteorId, Alien = alienId, Mut, Lv }, mode = "Base" | "Carry" | "Photo"
function AlienFactory.Create(entry: Entry, mode: string?): Model
	local alien = resolveAlien(entry)
	local look = alien.Look
	local fx = alien.Effects
	local rank = rarityRank(alien.Rarity)
	local mut = getMutation(entry.Mut)
	local modeName = (mode == "Carry" or mode == "Photo") and mode or "Base"
	local carry = modeName == "Carry"
	local lvScale = levelScale(levelOf(entry))
	local s = look.Scale * MODE_SCALE[modeName] * lvScale

	local model = Instance.new("Model")
	model.Name = "Alien"

	-- Mutation: Regenbogen färbt der Client durch (eigene Farbe bleibt als Grundfarbe),
	-- alle anderen färben den Körper in der Mutationsfarbe (+ Material aus MUT_STYLES)
	local mutName = tostring(mut.Name)
	local rainbowMut = mut.Rainbow == true
	local mutColor: Color3? = nil
	if not rainbowMut and mutName ~= "Normal" and typeof(mut.Color) == "Color3" then
		mutColor = mut.Color
	end

	local ctx: Ctx = {
		model = model,
		s = s,
		color = look.Color,
		accent = look.Accent,
		eyes = look.Eyes,
		antennas = look.Antennas,
		mutStyle = if rainbowMut then nil else MUT_STYLES[mutName],
		mutColor = mutColor,
		rainbow = fx.Rainbow == true or rainbowMut,
		rainbowShade = rainbowMut,
		carry = carry,
		darkFace = false,
		mainMaterial = Enum.Material.SmoothPlastic,
		mainTransparency = 0,
		mainReflectance = look.Archetype == "Robot" and 0.12 or 0,
		count = 0,
		max = rank >= ADMIN_RANK and MAX_PARTS_ADMIN or MAX_PARTS,
		top = 0,
	}
	-- Wie hell ist die Fläche, auf der die Augen sitzen? (Pilz: heller Stiel, Käfer: Kopf)
	-- Sehr dunkel -> leuchtende statt schwarze Augen
	ctx.darkFace = luminance(faceColorOf(look, ctx)) < 0.2

	local builder = Builders[look.Archetype] or Builders.Blob
	local body, bodyY = builder(ctx)
	if rank >= ADMIN_RANK then
		addOrbs(ctx, bodyY)
	end
	body.CanQuery = not carry -- für Prompts/Klicks; getragen stört es nur die Kamera

	-- Pivot = Bodenmitte, aufrecht, Blick nach -Z (beim Bauen = Welt-Ursprung).
	-- Bei gesetztem PrimaryPart zählt dessen PivotOffset (relativ zum gedrehten Body!).
	body.PivotOffset = body.CFrame:Inverse()
	model.WorldPivot = CFrame.new()
	model.PrimaryPart = body

	model:SetAttribute("AlienId", alien.Id)
	model:SetAttribute("MeteorId", entry.Id)
	model:SetAttribute("Rarity", alien.Rarity)
	model:SetAttribute("Tier", alien.Tier)
	model:SetAttribute("Mutation", mutName)
	model:SetAttribute("Bob", not carry) -- getragene Aliens nicht wippen (würde den Spieler mitbewegen)
	if ctx.rainbow then
		model:SetAttribute("Rainbow", true)
	end
	-- für Refresh: Höhen beim Bauen (inkl. Skalierung) + Level-Faktor beim Bauen
	model:SetAttribute("PivotHeight", bodyY * s)
	model:SetAttribute("TopHeight", ctx.top * s)
	model:SetAttribute("BuiltLevelScale", lvScale)
	-- nur für Client-Animationen (Squash & Stretch, Bewegungsstil): Body-Größe beim Bauen, Körperform
	model:SetAttribute("Archetype", look.Archetype)
	body:SetAttribute("BaseSize", body.Size)

	addEffects(model, body, alien, mut, s, carry)

	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.new(0, 240, 0, 70)
	gui.StudsOffsetWorldSpace = Vector3.new(0, (ctx.top - bodyY) * s + LABEL_GAP, 0)
	gui.MaxDistance = carry and 60 or (70 + rank * 15)
	gui.LightInfluence = 0
	gui.Parent = body

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Parent = frame

	makeLabel(frame, "NameLabel", 1, 20)
	makeLabel(frame, "RarityLabel", 2, 15)
	makeLabel(frame, "ValueLabel", 3, 17)

	AlienFactory.UpdateLabel(model, entry)
	return model
end

-- Nach einem Level-Up: Größe leicht anpassen (Boden bleibt, wo er ist) + Schild aktualisieren
function AlienFactory.Refresh(model: Model, entry: Entry)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return
	end
	local body = getBody(model)
	if not body then
		return
	end
	local built = tonumber(model:GetAttribute("BuiltLevelScale")) or 1
	local target = levelScale(levelOf(entry)) / (built > 0 and built or 1)
	local current = model:GetScale()
	if math.abs(current - target) > 0.001 then
		-- Lage des Body relativ zum Boden-Pivot merken, skalieren, Pivot neu setzen, zurückstellen
		local pivot = model:GetPivot()
		local rel = pivot:ToObjectSpace(body.CFrame)
		model:ScaleTo(target)
		local scaledRel = CFrame.new(rel.Position * (target / current)) * rel.Rotation
		body.PivotOffset = scaledRel:Inverse()
		model:PivotTo(pivot)
		body:SetAttribute("BaseSize", body.Size) -- Client-Squash rechnet mit der neuen Größe
		-- Zähler: der Client (Wippen) merkt daran, dass sich die Teile verändert haben
		model:SetAttribute("Rev", (tonumber(model:GetAttribute("Rev")) or 0) + 1)
	end
	updateLabelOffset(model, body)
	AlienFactory.UpdateLabel(model, entry)
end

return AlienFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">CarryService</string>
            <string name="Source"><![CDATA[-- Klauen & Tragen:
--  * Fremde Meteore UND Aliens kann man klauen (E halten), wenn die Base nicht gesperrt ist,
--    und muss sie dann in die eigene Base tragen (Source = "Plot").
--    Wer gebonkt wird, stirbt, in eine Falle tritt, zu langsam ist oder das Spiel verlässt,
--    verliert die Beute: sie fliegt zurück zum Besitzer.
--  * Eier vom FÖRDERBAND (E = Klauen) und Eier am Boden (fallen gelassen / Egg Rush) sind gratis,
--    müssen aber auch nach Hause getragen werden (Source = "Ground"). Klappt das nicht,
--    fällt das Ei an Ort und Stelle auf den Boden – und JEDER kann es schnappen.
--  * Gekaufte Meteore (F) muss man NICHT tragen – sie fliegen automatisch in die Base.
--  * Bonk-Schläger (bzw. Super-Bonk-Gadget) zum Verteidigen.
--  * Seltene Beute ist schwer (Config.HeavyCarry, Tempo rechnet EconomyService), wer klaut, verliert
--    den Umhang (sonst wäre jeder Diebstahl unbonkbar), Eingefrorene können nicht klauen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))
local AlienFactory = require(script.Parent:WaitForChild("AlienFactory"))

local CarryService = {}
local Services

local carrying: { [Player]: any } = {}
local stealing: { [any]: { [number]: Player } } = {} -- [plot][slot] = Dieb
local lastBonk: { [Player]: number } = {}
-- Klau-Versuche aus Basen pro Spieler höchstens so oft pro Sekunde (gegen Massen-Auslösen per Cheat)
local stealLimiter = Util.RateLimiter(6, 1)

local CARRY_HEIGHT = 2.6 -- Abstand über dem HumanoidRootPart (Unterkante der Beute)
-- Mindest-Tragezeit: kürzester möglicher Weg (raus aus der fremden Base, rein in die eigene)
-- geteilt durch Trage-Tempo * diesen Faktor. Schneller geht es nur mit Teleport/Durch-Wände-Laufen.
local MIN_CARRY_SPEED_FACTOR = 1.5
-- Förderband und Laufbänder schieben mit (wer mit Beute auf dem Band mitfährt, ist schneller)
local CONVEYOR_EXTRA_SPEED = math.max(Config.BeltSpeed, 14)
local SUPER_BONK_NAME = "Super-Bonk" -- Werkzeug-Name im Rucksack (normaler Schläger: "Bonk")

-- Fortschritt für die Tagesaufgaben (RewardService) – ein Fehler dort darf das Klauen nie stören
local function trackReward(player: Player, kind: string, amount: number)
	local rewards = Services.RewardService
	if rewards and rewards.Track then
		local ok, err = pcall(rewards.Track, player, kind, amount)
		if not ok then
			warn("[CarryService] RewardService.Track(" .. kind .. ") fehlgeschlagen: " .. tostring(err))
		end
	end
end

local function ownsGadget(player: Player, id: string): boolean
	local gadgets = Services.GadgetService
	return gadgets ~= nil and gadgets.Owns(player, id) == true
end

-- Höchstes mögliches Trage-Tempo (für die Mindest-Tragezeit): Schritte-Tempo * Trage-Faktor
-- (Gamepass "Volle Speed beim Tragen" = kein Abzug), Speed Coil obendrauf, plus Förderband-Schub
local function maxCarrySpeed(player: Player): number
	local factor = Services.MonetizationService.HasPass(player, "CarryFast") and 1 or Config.CarrySpeedFactor
	local speed = math.max(8, Services.EconomyService.GetSpeed(player) * factor)
	if ownsGadget(player, "SpeedCoil") then
		speed *= 1 + Config.SpeedCoilBonus
	end
	return speed + CONVEYOR_EXTRA_SPEED
end

function CarryService.IsCarrying(player: Player): boolean
	return carrying[player] ~= nil
end

-- Was trägt der Spieler gerade? (Eintrag { Id, Mut, ... } oder nil) – z.B. für "schwere Beute"
function CarryService.CarriedEntry(player: Player): any
	local info = carrying[player]
	return info and info.Entry
end

-- -------------------------------------------------------------------
-- BEWEGUNGS-PRÜFUNG (gegen Teleport- und Speed-Exploits)
-- -------------------------------------------------------------------
-- Die Position des Charakters bestimmt der Client. Deshalb hat jeder Spieler ein "Weg-Budget":
-- Es füllt sich mit dem erlaubten Tempo wieder auf, jede Bewegung verbraucht es (nur waagrecht,
-- Fallen zählt nicht). Ist es leer, war der Spieler unmöglich schnell -> kurz keine Käufe/Diebstähle,
-- getragene Beute fliegt zurück. Der Vorrat reicht für kurze Ping-Hänger (Position kommt gesammelt an).
local MOVE_RATE_FACTOR = 1.5 -- erlaubtes Tempo = WalkSpeed * 1.5 + MOVE_RATE_EXTRA
local MOVE_RATE_EXTRA = 16 -- Laufbänder schieben, Bonk-Rückstoß, kleine Physik-Sprünge
local MOVE_BUDGET_SECONDS = 0.75 -- Vorrat = so viele Sekunden erlaubtes Tempo
local MOVE_FLAG_TIME = 1.5 -- nach einem Verstoß so lange gesperrt
-- Nach einem Server-Teleport kurz warten: alte Positionen (vor dem Teleport) können noch ankommen.
-- In der Zeit zählen nur Positionen nahe am Teleport-Ziel, Kaufen/Klauen geht erst danach.
local TELEPORT_GRACE = 1
local TELEPORT_ANCHOR_RADIUS = 30

type MoveTrack = {
	Pos: Vector3?, -- letzte anerkannte Position
	Time: number,
	Budget: number,
	FlaggedUntil: number,
	GraceUntil: number,
	Anchor: Vector3?, -- Ziel des letzten Server-Teleports
}
local moveTrack: { [Player]: MoveTrack } = {}

-- Server-Teleports (Home, Laufbänder, Lock-Rauswurf, Admin, Respawn) sind erlaubt.
-- destination = Ziel des Teleports (nil = unbekannt, z.B. neuer Charakter)
function CarryService.NoteTeleport(player: Player, destination: Vector3?)
	local now = os.clock()
	local old = moveTrack[player]
	moveTrack[player] = {
		Pos = destination,
		Time = now,
		Budget = 0,
		FlaggedUntil = old and old.FlaggedUntil or 0,
		GraceUntil = now + TELEPORT_GRACE,
		Anchor = destination,
	}
	local info = carrying[player]
	if info then
		info.MinTime = 0 -- vom Server versetzt -> Mindest-Tragezeit gilt nicht mehr
	end
end

-- Misst die Bewegung seit der letzten Messung:
--   "ok"      = alles plausibel (darf kaufen/klauen)
--   "wait"    = gerade vom Server teleportiert (kurz warten, Beute bleibt)
--   "flagged" = unmöglich schnell oder noch gesperrt (Beute fliegt zurück)
function CarryService.MoveStatus(player: Player): string
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return "ok"
	end
	local admin = Services.AdminService
	if admin and admin.IsAdmin(player) then
		return "ok" -- Admins dürfen fliegen und teleportieren
	end
	local now = os.clock()
	local rate = humanoid.WalkSpeed * MOVE_RATE_FACTOR + MOVE_RATE_EXTRA
	local cap = rate * MOVE_BUDGET_SECONDS
	local pos = root.Position
	local track = moveTrack[player]
	if not track then
		track = { Pos = nil, Time = now, Budget = cap, FlaggedUntil = 0, GraceUntil = 0, Anchor = nil }
		moveTrack[player] = track
	end
	if now < track.GraceUntil then
		local anchor = track.Anchor
		local dx, dz = 0, 0
		if anchor then
			dx, dz = pos.X - anchor.X, pos.Z - anchor.Z
		end
		if dx * dx + dz * dz <= TELEPORT_ANCHOR_RADIUS * TELEPORT_ANCHOR_RADIUS then
			track.Pos = pos
		end
		track.Time = now
		track.Budget = cap
		return "wait"
	end
	local last = track.Pos
	if not last then
		-- erste Messung: nur merken (Kaufen/Klauen erst ab der nächsten Messung)
		track.Pos = pos
		track.Time = now
		track.Budget = cap
		return if now >= track.FlaggedUntil then "wait" else "flagged"
	end
	local dx, dz = pos.X - last.X, pos.Z - last.Z
	local distance = math.sqrt(dx * dx + dz * dz)
	local budget = math.min(cap, track.Budget + rate * math.max(0, now - track.Time)) - distance
	track.Pos = pos
	track.Time = now
	if budget < 0 then
		track.Budget = cap
		track.FlaggedUntil = now + MOVE_FLAG_TIME
		return "flagged"
	end
	track.Budget = budget
	return if now >= track.FlaggedUntil then "ok" else "flagged"
end

-- Kürzester möglicher Weg (Studs) von "from" in der fremden Base bis in die eigene Base:
-- Basen haben nur vorne (lokales -Z) einen Eingang, die Wände sind zu hoch zum Drüberspringen.
-- Gerechnet wird großzügig (ganze Eingangsbreite, Luftlinie) -> echte Spieler sind immer langsamer.
local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function pointSegmentDistance(p: Vector3, a: Vector3, b: Vector3): number
	local ab = b - a
	local lengthSq = ab:Dot(ab)
	local t = lengthSq > 0 and math.clamp((p - a):Dot(ab) / lengthSq, 0, 1) or 0
	return (p - (a + ab * t)).Magnitude
end

local function entranceSegment(plot): (Vector3, Vector3)
	local half = plot.HalfSize or 36
	local a = plot.CFrame:PointToWorldSpace(Vector3.new(-half, 0, -half))
	local b = plot.CFrame:PointToWorldSpace(Vector3.new(half, 0, -half))
	return flat(a), flat(b)
end

local function minCarryDistance(victimPlot, ownPlot, from: Vector3): number
	if victimPlot == ownPlot then
		return 0
	end
	local va, vb = entranceSegment(victimPlot)
	local oa, ob = entranceSegment(ownPlot)
	local toExit = pointSegmentDistance(flat(from), va, vb)
	local between = math.min(
		pointSegmentDistance(va, oa, ob),
		pointSegmentDistance(vb, oa, ob),
		pointSegmentDistance(oa, va, vb),
		pointSegmentDistance(ob, va, vb)
	)
	return toExit + between
end

-- Mindest-Tragezeit für ein Ei vom Band/Boden: Luftlinie bis zum Eingang der eigenen Base
local function minGroundCarryTime(player: Player, from: Vector3?): number
	local plot = Services.PlotService.GetPlot(player)
	if not plot or not from or Services.PlotService.IsInside(plot, from) then
		return 0
	end
	local a, b = entranceSegment(plot)
	return pointSegmentDistance(flat(from), a, b) / (maxCarrySpeed(player) * MIN_CARRY_SPEED_FACTOR)
end

function CarryService.IsSlotBeingStolen(plot, slot: number): boolean
	local map = stealing[plot]
	return map ~= nil and map[slot] ~= nil
end

local function clearStealMark(info)
	if info.Source == "Plot" and stealing[info.VictimPlot] then
		stealing[info.VictimPlot][info.Slot] = nil
	end
end

local function cleanup(player: Player, info)
	carrying[player] = nil
	if info.Visual then
		info.Visual:Destroy()
		info.Visual = nil
	end
	Services.EconomyService.ApplySpeed(player)
	Services.EconomyService.MarkDirty(player)
end

-- Getragene Beute: alle Teile lose, gewichtslos, ohne Kollision, an den Spieler geschweißt
local function prepareCarryPart(p: BasePart)
	p.Anchored = false
	p.Massless = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
end

local function weldTo(part0: BasePart, part1: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = part0
	w.Part1 = part1
	w.Parent = part1
end

-- Alien-Kopie über dem Kopf (Model: alle Teile an den Body, Body an den HumanoidRootPart)
local function createAlienVisual(entry, root: BasePart): Instance?
	local ok, result = pcall(AlienFactory.Create, entry, "Carry")
	if not ok or typeof(result) ~= "Instance" or not result:IsA("Model") then
		warn("[CarryService] Alien-Optik fehlgeschlagen: " .. tostring(result))
		return nil
	end
	local model = result :: Model
	local body = model.PrimaryPart or model:FindFirstChild("Body")
	if not body or not body:IsA("BasePart") then
		model:Destroy()
		return nil
	end
	model.Name = "CarriedAlien"
	model:SetAttribute("Bob", false) -- nicht wippen (würde den Spieler mitbewegen)
	model:PivotTo(root.CFrame * CFrame.new(0, CARRY_HEIGHT, 0))
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			prepareCarryPart(d)
			if d ~= body then
				weldTo(body, d)
			end
		end
	end
	weldTo(root, body)
	return model
end

local function createVisual(player: Player, entry): Instance?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not root then
		return nil
	end
	local visual: Instance? = nil
	if entry.Alien ~= nil then
		visual = createAlienVisual(entry, root)
	end
	if not visual then
		local meteor = MeteorFactory.Create(entry, "Carry")
		meteor.Name = "CarriedMeteor"
		prepareCarryPart(meteor)
		meteor.CFrame = root.CFrame * CFrame.new(0, CARRY_HEIGHT + meteor.Size.Y / 2, 0)
		weldTo(root, meteor)
		visual = meteor
	end
	if visual then
		visual.Parent = character
	end
	return visual
end

-- info (Plot):   { Source = "Plot", VictimPlot, VictimPlayer, Slot, EntryRef, MinTime? }
-- info (Ground): { Source = "Ground", From = "Belt"|"Drop"?, GrabPosition?, MinTime? }
-- Dazu kommen hier: Entry, Started, Character, StartPos, LastPos (laufend), Visual
function CarryService.StartCarry(player: Player, entry, info)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	info.Entry = entry
	info.Started = os.clock()
	info.Character = character
	info.StartPos = root and root.Position or info.GrabPosition
	info.LastPos = info.StartPos
	if info.MinTime == nil then
		info.MinTime = info.Source == "Ground" and minGroundCarryTime(player, info.StartPos) or 0
	end
	-- Wer klaut, wird sichtbar: sonst wäre jeder Diebstahl mit Umhang unbonkbar
	local gadgets = Services.GadgetService
	local uncloaked = false
	if gadgets and gadgets.IsCloaked(player) then
		gadgets.EndCloak(player, true)
		uncloaked = true
	end
	info.Visual = createVisual(player, entry)
	carrying[player] = info
	Services.EconomyService.ApplySpeed(player)
	Services.EconomyService.MarkDirty(player)
	local extra = ""
	if Config.HeavyFactor(entry) and not Services.MonetizationService.HasPass(player, "CarryFast") then
		extra ..= " 🐢 Schwer – du bist langsamer!"
	end
	if uncloaked then
		extra ..= " 👻 Du bist wieder sichtbar!"
	end
	if info.Source == "Ground" then
		Services.EconomyService.Notify(
			player,
			"😈 Geschnappt: " .. Config.EntryName(entry) .. "! Schnell in deine Base 🏃" .. extra,
			"Info"
		)
	else
		Services.EconomyService.Notify(
			player,
			"🏃 Bring " .. Config.EntryName(entry) .. " in deine Base!" .. extra,
			"Info"
		)
	end
end

-- Weltposition der getragenen Beute (für den Fall-Effekt beim Fallenlassen)
local function visualPosition(info): Vector3?
	local visual = info.Visual
	if not visual or not visual.Parent then
		return nil
	end
	if visual:IsA("BasePart") then
		return visual.Position
	elseif visual:IsA("Model") then
		return visual:GetPivot().Position
	end
	return nil
end

-- Ei vom Band/Boden sicher zu Hause -> in einen freien Slot, Schlüpf-Countdown startet
local function succeedGround(player: Player, info)
	local data = Services.DataService.Get(player)
	local plot = Services.PlotService.GetPlot(player)
	local slot = Services.PlotService.FreeSlot(player)
	if not data or not plot or not slot then
		CarryService.Fail(player, "full")
		return
	end
	local from = visualPosition(info)
	cleanup(player, info)
	local placed = Services.EconomyService.DeliverMeteor(player, plot, slot, info.Entry, from)
	if not placed then
		-- (sollte nie passieren) Ei nicht verlieren: an Ort und Stelle fallen lassen
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local spot = root and root.Position or info.LastPos
		if spot then
			Services.MeteorService.DropMeteor(info.Entry, spot, from)
		end
		return
	end
	data.Stats.Grabbed = (tonumber(data.Stats.Grabbed) or 0) + 1
	trackReward(player, "Grab", 1)
	Services.EconomyService.Notify(
		player,
		"🏠 Zuhause! " .. Config.EntryName(info.Entry) .. " schlüpft bald 🐣",
		"Success"
	)
	Services.EconomyService.Effect(player, "Confetti", 1)
end

local function succeed(player: Player)
	local info = carrying[player]
	if not info then
		return
	end
	if info.Source == "Ground" then
		succeedGround(player, info)
		return
	end
	local data = Services.DataService.Get(player)
	local plot = Services.PlotService.GetPlot(player)
	local slot = Services.PlotService.FreeSlot(player)
	local name = Config.EntryName(info.Entry)

	local victim = info.VictimPlayer
	local victimData = victim and victim.Parent and Services.DataService.Get(victim)
	local key = tostring(info.Slot)
	if not data or not plot or not slot or not victimData or victimData.Meteors[key] ~= info.EntryRef then
		CarryService.Fail(player, slot and "invalid" or "full")
		return
	end
	victimData.Meteors[key] = nil
	data.Meteors[tostring(slot)] = info.EntryRef
	data.Stats.Stolen += 1
	victimData.Stats.Robbed += 1
	clearStealMark(info)
	cleanup(player, info)
	if info.EntryRef.Alien ~= nil then
		Services.EconomyService.Discover(player, info.EntryRef.Alien)
	end
	Services.PlotService.RenderSlot(plot, slot)
	Services.PlotService.RenderSlot(info.VictimPlot, info.Slot)
	Services.EconomyService.MarkDirty(victim)
	trackReward(player, "Steal", 1)
	Services.EconomyService.Notify(player, "😈 Geklaut: " .. name .. "!", "Success")
	Services.EconomyService.Notify(
		victim,
		"💔 " .. player.DisplayName .. " hat dein " .. name .. " geklaut!",
		"Error"
	)
	Services.EconomyService.Effect(player, "Confetti", 1)
end

-- Hinweise beim Verlieren: Beute aus einer Base fliegt zurück, ein Ei vom Band fällt herunter
local PLOT_FAIL_TEXT = {
	bonked = "💥 Gebonkt! Die Beute fliegt zurück.",
	timeout = "⏰ Zu langsam! Die Beute fliegt zurück.",
	full = "📦 Deine Base ist voll – die Beute fliegt zurück!",
	teleport = "🚫 Mit Beute kann man nicht teleportieren!",
	locked = "🔒 Die Base wurde gesperrt – deine Beute fliegt zurück!",
	trap = "🪤 FALLE! Die Beute fliegt zurück.",
}
local GROUND_FAIL_TEXT = {
	bonked = "💥 Gebonkt! Das Ei ist runtergefallen – schnapp es dir zurück!",
	timeout = "⏰ Zu langsam! Das Ei ist runtergefallen.",
	full = "📦 Deine Base ist voll – das Ei liegt jetzt am Boden!",
	teleport = "🚫 Mit Beute kann man nicht teleportieren!",
	locked = "🔒 Gesperrte Base – das Ei ist runtergefallen!",
	trap = "🪤 FALLE! Das Ei ist runtergefallen.",
	died = "💀 Das Ei ist runtergefallen – jemand anderes kann es jetzt schnappen!",
}

-- Ei vom Band/Boden verloren -> fällt als GRATIS-Ei auf den Boden (jeder darf es schnappen)
local function dropGroundLoot(player: Player, info, reason: string, from: Vector3?)
	local spot: Vector3? = nil
	if reason == "teleport" or reason == "invalid" then
		-- Verdacht auf Teleport-Trick: dort ablegen, wo das Tragen angefangen hat
		spot = info.StartPos
	else
		-- nur der Charakter, der das Ei getragen hat (nach einem Respawn steht der neue woanders)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if character == info.Character and root and humanoid and humanoid.Health > 0 then
			spot = root.Position
		else
			spot = info.LastPos or info.StartPos
		end
	end
	if not spot then
		return
	end
	local ok, err = pcall(Services.MeteorService.DropMeteor, info.Entry, spot, from)
	if not ok then
		warn("[CarryService] Ei fallen lassen fehlgeschlagen: " .. tostring(err))
	end
end

function CarryService.Fail(player: Player, reason: string)
	local info = carrying[player]
	if not info then
		return
	end
	local from = visualPosition(info)
	clearStealMark(info)
	cleanup(player, info)
	local name = Config.EntryName(info.Entry)

	if info.Source == "Ground" then
		dropGroundLoot(player, info, reason, from)
		local text = GROUND_FAIL_TEXT[reason]
		if text then
			Services.EconomyService.Notify(player, text, "Error")
		end
		return
	end

	-- zurück zum Besitzer
	if info.VictimPlot and info.VictimPlot.Owner == info.VictimPlayer then
		Services.PlotService.RenderSlot(info.VictimPlot, info.Slot)
		Services.EconomyService.MarkDirty(info.VictimPlayer)
		if reason ~= "victimLeft" then
			Services.EconomyService.Notify(info.VictimPlayer, "🛡️ Dein " .. name .. " ist zurück!", "Success")
		end
	end
	local text = PLOT_FAIL_TEXT[reason]
	if text then
		Services.EconomyService.Notify(player, text, "Error")
	end
end

function CarryService.TrySteal(thief: Player, plot, slot: number)
	local owner = plot.Owner
	if not owner or owner == thief then
		return
	end
	if not stealLimiter.Check(thief) then
		return -- zu viele Versuche auf einmal (Cheat) -> still ignorieren
	end
	local thiefData = Services.DataService.Get(thief)
	local ownerData = Services.DataService.Get(owner)
	local Economy = Services.EconomyService
	if not thiefData or not ownerData or not Economy.IsReady(thief) or not Economy.IsReady(owner) then
		return
	end
	if Services.PlotService.IsLocked(plot) then
		Services.EconomyService.Notify(thief, "🔒 Diese Base ist gesperrt!", "Error")
		return
	end
	if CarryService.IsSlotBeingStolen(plot, slot) or carrying[thief] then
		return
	end
	local entry = ownerData.Meteors[tostring(slot)]
	if not entry then
		return
	end
	local thiefPlot = Services.PlotService.GetPlot(thief)
	if not thiefPlot then
		Services.EconomyService.Notify(thief, "Du hast keine Base auf diesem Server.", "Error")
		return
	end
	if not Services.PlotService.FreeSlot(thief) then
		Services.EconomyService.Notify(thief, "📦 Deine Base ist voll! Verkaufe erst etwas.", "Error")
		return
	end
	local character = thief.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local object = plot.MeteorParts[slot]
	local objectPos = Services.PlotService.ObjectPosition(object)
	if not root or not humanoid or humanoid.Health <= 0 or not objectPos then
		return
	end
	if root.Anchored then
		-- eingefroren (Falle / Admin): erst auftauen, dann klauen
		Services.EconomyService.Notify(thief, "🧊 Du bist eingefroren!", "Error")
		return
	end
	if (root.Position - objectPos).Magnitude > Services.PlotService.ObjectRadius(object) + 16 then
		return -- zu weit weg
	end
	if not Services.PlotService.IsInside(plot, root.Position) then
		return -- klauen nur, wer IN der fremden Base steht (nicht durch die Wand aus der Nachbar-Base)
	end
	if CarryService.MoveStatus(thief) ~= "ok" then
		Services.EconomyService.Notify(thief, "⏳ Kurz warten und nochmal versuchen!", "Error")
		return
	end
	local minTime = minCarryDistance(plot, thiefPlot, root.Position) / (maxCarrySpeed(thief) * MIN_CARRY_SPEED_FACTOR)

	stealing[plot] = stealing[plot] or {}
	stealing[plot][slot] = thief
	Services.PlotService.RenderSlot(plot, slot) -- macht das Objekt in der Base unsichtbar
	CarryService.StartCarry(thief, entry, {
		Source = "Plot",
		VictimPlot = plot,
		VictimPlayer = owner,
		Slot = slot,
		EntryRef = entry,
		MinTime = minTime,
	})
	Services.EconomyService.MarkDirty(owner)
	Services.EconomyService.Notify(
		owner,
		"🚨 " .. thief.DisplayName .. " klaut dein " .. Config.EntryName(entry) .. "! BONK IHN!",
		"Alarm"
	)
	Services.EconomyService.Effect(owner, "Alarm", 1)
end

-- Alle laufenden Diebstähle aus einer Base abbrechen (Rebirth, Reset, Verlassen)
function CarryService.CancelStealsFromPlot(plot, reason: string?)
	for thief, info in pairs(carrying) do
		if info.Source == "Plot" and info.VictimPlot == plot then
			CarryService.Fail(thief, reason or "cancelled")
		end
	end
end

-- -------------------------------------------------------------------
-- BONK-SCHLÄGER (normal bzw. Super-Bonk-Gadget: doppelte Reichweite + Wucht, schneller)
-- -------------------------------------------------------------------
local function bonk(player: Player, tool: Tool, super: boolean)
	local t = os.clock()
	local cooldown = super and Config.SuperBonkCooldown or Config.BonkCooldown
	if t - (lastBonk[player] or 0) < cooldown then
		return
	end
	lastBonk[player] = t

	-- Schlag-Animation über das Standard-Animate-Skript
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	Debris:AddItem(anim, 1)

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or tool.Parent ~= character then
		return -- nur mit dem Schläger in der Hand
	end
	local range = super and Config.BonkRange * Config.SuperBonkRangeMult or Config.BonkRange
	local force = super and Config.BonkForce * Config.SuperBonkForceMult or Config.BonkForce
	local gadgets = Services.GadgetService
	local best, bestDist = nil, range
	for _, other in ipairs(Players:GetPlayers()) do
		-- Unsichtbare (Umhang) kann man nicht bonken – wer Beute trägt, aber schon
		-- (Klauen beendet den Umhang sowieso, das hier ist nur das Sicherheitsnetz)
		local cloaked = gadgets ~= nil and gadgets.IsCloaked(other) and not carrying[other]
		if other ~= player and not cloaked then
			local otherRoot = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local otherHum = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
			if otherRoot and otherHum and otherHum.Health > 0 then
				local offset = otherRoot.Position - root.Position
				local dist = offset.Magnitude
				local facing = dist < 3 or root.CFrame.LookVector:Dot(offset.Unit) > 0.1
				if dist <= bestDist and facing then
					best, bestDist = other, dist
				end
			end
		end
	end
	if not best then
		return
	end
	local targetRoot = best.Character and best.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not targetRoot then
		return
	end
	local direction = targetRoot.Position - root.Position
	direction = Vector3.new(direction.X, 0, direction.Z)
	direction = direction.Magnitude > 0.01 and direction.Unit or root.CFrame.LookVector

	-- Rückstoß (läuft beim getroffenen Spieler, weil der seine Physik besitzt)
	if not targetRoot.Anchored then
		local attachment = Instance.new("Attachment")
		attachment.Parent = targetRoot
		local velocity = Instance.new("LinearVelocity")
		velocity.Attachment0 = attachment
		velocity.MaxForce = 1e6
		velocity.RelativeTo = Enum.ActuatorRelativeTo.World
		velocity.VectorVelocity = direction * force + Vector3.new(0, super and 45 or 30, 0)
		velocity.Parent = targetRoot
		Debris:AddItem(velocity, 0.18)
		Debris:AddItem(attachment, 0.18)
	end

	Services.EconomyService.Effect(best, "Shake", super and 1 or 0.6)
	if carrying[best] then
		CarryService.Fail(best, "bonked")
		trackReward(player, "Bonk", 1)
		Services.EconomyService.Notify(
			player,
			"💥 Treffer! " .. best.DisplayName .. " hat die Beute verloren!",
			"Success"
		)
	end
end

local function createBonkTool(super: boolean): Tool
	local tool = Instance.new("Tool")
	tool.Name = super and SUPER_BONK_NAME or "Bonk"
	tool.ToolTip = super and "Klick = SUPER-BONK! Doppelte Reichweite und Wucht."
		or "Klick = Bonk! Diebe verlieren ihre Beute."
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	local length = super and 5.2 or 4.2
	tool.Grip = CFrame.new(0, 0, -length * 0.38) * CFrame.Angles(math.rad(-90), 0, 0)
	tool:SetAttribute("Gadget", super and "SuperBonk" or nil)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.6, 0.6, length)
	handle.Color = super and Color3.fromRGB(60, 60, 70) or Color3.fromRGB(255, 170, 60)
	handle.Material = super and Enum.Material.Metal or Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local head = Instance.new("Part")
	head.Name = "Head"
	head.CanCollide = false
	head.Massless = true
	if super then
		-- großer goldener Hammerkopf mit Leuchtring
		head.Size = Vector3.new(2.4, 2.4, 3.4)
		head.Color = Color3.fromRGB(255, 200, 40)
		head.Material = Enum.Material.Foil
		head.CFrame = handle.CFrame * CFrame.new(0, 0, -length / 2 - 0.4) * CFrame.Angles(0, math.rad(90), 0)
		local glow = Instance.new("Part")
		glow.Name = "Glow"
		glow.Shape = Enum.PartType.Cylinder
		glow.Size = Vector3.new(0.5, 2.8, 2.8)
		glow.Color = Color3.fromRGB(255, 90, 40)
		glow.Material = Enum.Material.Neon
		glow.CanCollide = false
		glow.Massless = true
		glow.CFrame = head.CFrame
		local glowWeld = Instance.new("WeldConstraint")
		glowWeld.Part0 = head
		glowWeld.Part1 = glow
		glowWeld.Parent = glow
		glow.Parent = tool
	else
		head.Shape = Enum.PartType.Ball
		head.Size = Vector3.new(1.6, 1.6, 1.6)
		head.Color = Color3.fromRGB(255, 90, 60)
		head.Material = Enum.Material.SmoothPlastic
		head.CFrame = handle.CFrame * CFrame.new(0, 0, -2.2)
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = head
	weld.Parent = head
	head.Parent = tool
	return tool
end

local bonkTemplate: Tool
local superBonkTemplate: Tool

local function findTool(container: Instance?, name: string): Tool?
	local found = container and container:FindFirstChild(name)
	if found and found:IsA("Tool") then
		return found
	end
	return nil
end

-- Gibt den passenden Schläger (Bonk oder Super-Bonk) – ohne Doppelte, alter Schläger fliegt raus.
-- Wird beim Spawnen und nach dem Kauf/Geschenk des Super-Bonks aufgerufen.
function CarryService.GiveBonk(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack or not bonkTemplate then
		return
	end
	local character = player.Character
	local super = ownsGadget(player, "SuperBonk")
	local wanted = super and SUPER_BONK_NAME or "Bonk"
	local unwanted = super and "Bonk" or SUPER_BONK_NAME
	for _, container in ipairs({ backpack, character }) do
		local old = findTool(container, unwanted)
		if old then
			old:Destroy()
		end
	end
	if findTool(backpack, wanted) or findTool(character, wanted) then
		return
	end
	local tool = (super and superBonkTemplate or bonkTemplate):Clone()
	tool.Activated:Connect(function()
		bonk(player, tool, super)
	end)
	tool.Parent = backpack
end

local function giveTool(player: Player)
	if player:WaitForChild("Backpack", 10) then
		CarryService.GiveBonk(player)
	end
end

function CarryService.Init(services)
	Services = services
	bonkTemplate = createBonkTool(false)
	superBonkTemplate = createBonkTool(true)
end

function CarryService.Start()
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			-- neuer Charakter -> alte Beute ist weg (fliegt zurück bzw. das Ei fällt herunter)
			if carrying[player] then
				CarryService.Fail(player, "died")
			end
			CarryService.NoteTeleport(player) -- neuer Charakter steht woanders
			local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
			if humanoid then
				humanoid.Died:Connect(function()
					CarryService.Fail(player, "died")
				end)
			end
			giveTool(player)
			Services.EconomyService.ApplySpeed(player)
		end)
		if player.Character then
			task.spawn(giveTool, player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end

	-- Beim Verlassen (vor dem Speichern): Diebstähle sauber beenden (Beute geht zurück).
	-- Kann zweimal aufgerufen werden (PlayerRemoving + Speichern) – ist harmlos.
	local function onLeaving(player: Player)
		lastBonk[player] = nil
		moveTrack[player] = nil
		stealLimiter.Clear(player)
		if carrying[player] then
			CarryService.Fail(player, "left")
		end
	end
	Services.DataService.OnProfileReleasing(onLeaving)
	Players.PlayerRemoving:Connect(onLeaving)

	-- Prüfen: angekommen? gestorben? zu langsam? teleportiert?
	task.spawn(function()
		while true do
			task.wait(0.15)
			-- Bewegung ALLER Spieler messen (Anti-Teleport fürs Tragen, Kaufen und Klauen)
			for _, player in ipairs(Players:GetPlayers()) do
				if CarryService.MoveStatus(player) == "flagged" and carrying[player] then
					CarryService.Fail(player, "teleport")
				end
			end
			for player, info in pairs(carrying) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local plot = Services.PlotService.GetPlot(player)
				local elapsed = os.clock() - info.Started
				if root and character == info.Character then
					info.LastPos = root.Position -- falls das Ei gleich herunterfällt (Tod, Verlassen)
				end
				if not root or not humanoid or humanoid.Health <= 0 or not info.Visual or not info.Visual.Parent then
					-- (Visual weg = Charakter neu gespawnt oder Beute zerstört)
					CarryService.Fail(player, "died")
				elseif elapsed > Config.CarryTimeout then
					CarryService.Fail(player, "timeout")
				elseif plot and Services.PlotService.IsInside(plot, root.Position) then
					local admin = Services.AdminService
					if elapsed < (info.MinTime or 0) and not (admin and admin.IsAdmin(player)) then
						-- schneller als der kürzeste mögliche Weg -> Teleport oder durch die Wand
						CarryService.Fail(player, "teleport")
					else
						succeed(player)
					end
				end
			end
		end
	end)
end

return CarryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Speichert Spielstände sicher:
--  * Session-Lock: ein Spielstand ist immer nur in EINEM Server offen (keine Duplikate)
--  * Wiederholungen bei DataStore-Fehlern, Auto-Save, Speichern beim Server-Ende
--  * Wenn Laden fehlschlägt, wird der Spieler gekickt statt mit leerem Stand zu spielen
--  * Alte Spielstände (v1: Meteore ohne Aliens, Speed-Level) werden automatisch umgebaut

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Aliens = require(Shared:WaitForChild("Aliens"))

local DataService = {}
DataService.Profiles = {} :: { [Player]: any }

local DATA_VERSION = 2

local DEFAULT_DATA = {
	Version = DATA_VERSION,
	Cash = Config.StartCash,
	Pending = 0,
	-- ["1"] = { Id = "Pebble", Mut = "Normal", Lv = 1, Xp = 0, Hatch = 0, Alien = "PebbleBlob" }
	--   Hatch = Restsekunden bis zum Schlüpfen (0 = geschlüpft), Alien = nil solange noch Meteor
	Meteors = {},
	Rebirths = 0,
	Steps = 0, -- 👟 Schritte von den Laufbändern (bleiben bei Rebirth)
	TotalEarned = 0,
	Index = {}, -- ["PebbleBlob"] = true -> Alien schon entdeckt (bleibt bei Rebirth)
	Stats = { Stolen = 0, Robbed = 0, Bought = 0, RobuxSpent = 0, Grabbed = 0 }, -- Grabbed = Eier vom Band/Boden
	Daily = { Last = 0, Streak = 0 },
	Receipts = {}, -- zuletzt verarbeitete Käufe (gegen doppelte Gutschrift)
	LastOnline = 0,
	-- v2.1 (alte Spielstände bekommen die Felder automatisch über Reconcile):
	Spins = 1, -- 🎡 Glücksrad-Drehs (gekauft/gewonnen; der Gratis-Dreh zählt extra)
	LastFreeSpin = 0, -- os.time() des letzten Gratis-Drehs
	-- 📜 Tagesaufgaben: Day = UTC-Tag "YYYY-MM-DD", List = { { Id, Kind, Goal, Progress, Claimed } }
	--    (dazu Rerolled = true, wenn heute schon eine Aufgabe getauscht wurde)
	Quests = { Day = "", List = {} },
	-- 🎁 Spielzeit-Geschenke: Spielzeit von heute (UTC, über alle Besuche), abgeholte als ["1"] = true
	Gifts = { Day = "", Seconds = 0, Claimed = {} },
	Gadgets = {}, -- ["SpeedCoil"] = true -> besessen (bleibt bei Rebirth)
	StarterBought = false, -- ⭐ Starter-Paket schon gekauft (nur einmal im Shop)
}

local LOCK_EXPIRE = 30 * 60 -- ein Lock älter als 30 Min gilt als verwaist
local LOAD_ATTEMPTS = 6
local LOCK_WAIT = 5

local store = nil
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)

local loadedCallbacks = {}
local releasingCallbacks = {}

local function keyFor(userId: number): string
	return "Player_" .. userId
end

local function jobId(): string
	return game.JobId ~= "" and game.JobId or "studio"
end

function DataService.OnProfileLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

-- Wird VOR dem finalen Speichern aufgerufen (z.B. um laufende Diebstähle abzubrechen)
function DataService.OnProfileReleasing(callback)
	table.insert(releasingCallbacks, callback)
end

function DataService.Get(player: Player)
	local profile = DataService.Profiles[player]
	if profile and profile.Loaded then
		return profile.Data
	end
	return nil
end

function DataService.IsLoaded(player: Player): boolean
	local profile = DataService.Profiles[player]
	return profile ~= nil and profile.Loaded == true
end

-- -------------------------------------------------------------------
-- MIGRATION: alte Spielstände auf das neue Format bringen
-- -------------------------------------------------------------------
-- Ein Slot-Eintrag reparieren (fehlende Felder, unbekannte Aliens)
local function migrateEntry(entry)
	local hatch = tonumber(entry.Hatch)
	if entry.Alien ~= nil and not Aliens.ById[entry.Alien] then
		-- Alien gibt es nicht mehr (Aliens.luau geändert) -> neu würfeln
		entry.Alien = Aliens.Roll(entry.Id)
	end
	if entry.Alien == nil and hatch == nil then
		-- Meteor aus v1 (vor den Aliens): sofort geschlüpft
		entry.Alien = Aliens.Roll(entry.Id)
		entry.Hatch = 0
	elseif entry.Alien ~= nil then
		entry.Hatch = 0
	else
		entry.Hatch = math.max(0, hatch or 0)
		if entry.Hatch ~= entry.Hatch then
			entry.Hatch = 0
		end
	end
end

-- v2.1-Felder prüfen: kaputte Werte auf nil setzen -> Reconcile trägt danach den Standard ein
local function sanitizeRewards(data)
	local spins = data.Spins
	if type(spins) ~= "number" or spins ~= spins then
		data.Spins = nil
	else
		data.Spins = math.clamp(math.floor(spins), 0, 1e6)
	end
	local lastFree = data.LastFreeSpin
	if type(lastFree) ~= "number" or lastFree ~= lastFree or math.abs(lastFree) == math.huge then
		data.LastFreeSpin = nil
	end
	local quests = data.Quests
	if type(quests) ~= "table" or type(quests.Day) ~= "string" or type(quests.List) ~= "table" then
		data.Quests = nil -- der RewardService würfelt dann neue Aufgaben
	elseif quests.Rerolled ~= nil and type(quests.Rerolled) ~= "boolean" then
		quests.Rerolled = nil
	end
	local gifts = data.Gifts
	if type(gifts) ~= "table" or type(gifts.Day) ~= "string" or type(gifts.Claimed) ~= "table" then
		data.Gifts = nil -- Reconcile trägt den Standard ein, der RewardService fängt neu an
	else
		local seconds = gifts.Seconds
		if type(seconds) ~= "number" or seconds ~= seconds or seconds < 0 or seconds == math.huge then
			gifts.Seconds = 0
		end
		for key, claimed in pairs(gifts.Claimed) do
			if type(key) ~= "string" or claimed ~= true then
				gifts.Claimed[key] = nil
			end
		end
	end
	if type(data.Gadgets) ~= "table" then
		data.Gadgets = nil
	else
		for id, owned in pairs(data.Gadgets) do
			if type(id) ~= "string" or owned ~= true then
				data.Gadgets[id] = nil
			end
		end
	end
	if type(data.StarterBought) ~= "boolean" then
		data.StarterBought = nil
	end
end

function DataService.Migrate(data)
	local version = tonumber(data.Version) or 1
	if version < 2 then
		-- Speed-Level (v1, mit Cash gekauft) -> Schritte, damit niemand langsamer wird
		local speedLevel = tonumber(data.SpeedLevel) or 0
		if speedLevel > 0 then
			data.Steps = math.max(tonumber(data.Steps) or 0, math.floor(10 ^ (speedLevel / 6)))
		end
		-- Index (v1 = Meteor-Ids) -> das Normal-Alien jedes entdeckten Meteors
		local newIndex = {}
		if type(data.Index) == "table" then
			for id in pairs(data.Index) do
				if Aliens.ById[id] then
					newIndex[id] = true
				elseif Config.MeteorsById[id] then
					local options = Aliens.ByMeteor[id]
					if options and options[1] then
						newIndex[options[1].Id] = true
					end
				end
			end
		end
		data.Index = newIndex
	end
	data.SpeedLevel = nil
	data.Version = DATA_VERSION

	if type(data.Meteors) ~= "table" then
		data.Meteors = {}
	end
	for key, entry in pairs(data.Meteors) do
		if type(entry) ~= "table" or type(entry.Id) ~= "string" then
			data.Meteors[key] = nil
		else
			migrateEntry(entry)
		end
	end
	if type(data.Index) == "table" then
		-- Index zählt nur Alien-Ids
		for id in pairs(data.Index) do
			if not Aliens.ById[id] then
				data.Index[id] = nil
			end
		end
	end
	local steps = tonumber(data.Steps) or 0
	data.Steps = (steps == steps and steps >= 0) and steps or 0
	sanitizeRewards(data)
end

local function loadData(userId: number): (boolean, any)
	if not storeOk or not store then
		return false, "DataStore nicht verfügbar"
	end
	for attempt = 1, LOAD_ATTEMPTS do
		local lockedByOther = false
		local forceTake = attempt == LOAD_ATTEMPTS
		local ok, result = pcall(function()
			return store:UpdateAsync(keyFor(userId), function(old)
				old = old or {}
				local lock = old.Lock
				if lock and lock.JobId ~= jobId() and os.time() - (lock.Time or 0) < LOCK_EXPIRE and not forceTake then
					lockedByOther = true
					return nil -- nichts schreiben
				end
				old.Lock = { JobId = jobId(), Time = os.time() }
				return old
			end)
		end)
		if ok and not lockedByOther then
			local data = (result and result.Data) or Util.DeepCopy(DEFAULT_DATA)
			-- erst migrieren (Version prüfen), DANN fehlende Felder ergänzen
			local migrated, err = pcall(DataService.Migrate, data)
			if not migrated then
				warn("[DataService] Migration fehlgeschlagen: " .. tostring(err))
				data.Version = data.Version or 1 -- beim nächsten Laden nochmal versuchen
			end
			Util.Reconcile(data, DEFAULT_DATA)
			return true, data
		end
		if not ok then
			warn("[DataService] Laden fehlgeschlagen (Versuch " .. attempt .. "): " .. tostring(result))
		end
		task.wait(lockedByOther and LOCK_WAIT or (attempt * 1.5))
	end
	return false, "Konnte Spielstand nicht laden"
end

local function saveData(userId: number, data, release: boolean): boolean
	if not storeOk or not store then
		return false
	end
	for attempt = 1, 4 do
		local lostLock = false
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(userId), function(old)
				old = old or {}
				if old.Lock and old.Lock.JobId ~= jobId() then
					-- Ein anderer Server hat den Spielstand übernommen -> NICHT überschreiben
					lostLock = true
					return nil
				end
				return {
					Data = data,
					Lock = (not release) and { JobId = jobId(), Time = os.time() } or nil,
				}
			end)
		end)
		if ok then
			return not lostLock
		end
		warn("[DataService] Speichern fehlgeschlagen (Versuch " .. attempt .. "): " .. tostring(err))
		task.wait(attempt * 1.5)
	end
	return false
end

function DataService.Save(player: Player): boolean
	local profile = DataService.Profiles[player]
	if not profile or not profile.Loaded or profile.NoSave or profile.Releasing then
		return profile ~= nil and profile.NoSave == true
	end
	profile.Data.LastOnline = os.time()
	return saveData(player.UserId, profile.Data, false)
end

local function onPlayerAdded(player: Player)
	local profile = { Loaded = false, Data = nil, NoSave = false }
	DataService.Profiles[player] = profile

	local ok, data = loadData(player.UserId)
	if not ok then
		if RunService:IsStudio() then
			warn(
				"[DataService] Studio: Speichern ist AUS. Aktiviere in Game Settings > Security 'Enable Studio Access to API Services'."
			)
			data = Util.DeepCopy(DEFAULT_DATA)
			profile.NoSave = true
		else
			DataService.Profiles[player] = nil
			if player.Parent then
				player:Kick(
					"Dein Spielstand konnte nicht geladen werden. Bitte tritt erneut bei. (Roblox-Server ausgelastet)"
				)
			end
			return
		end
	end

	if not player.Parent then
		-- Spieler hat das Spiel während des Ladens verlassen -> Lock freigeben
		if not profile.NoSave then
			saveData(player.UserId, data, true)
		end
		DataService.Profiles[player] = nil
		return
	end

	profile.Data = data
	profile.Loaded = true
	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(callback, player, data)
	end
end

local function releaseProfile(player: Player)
	local profile = DataService.Profiles[player]
	if not profile then
		return
	end
	if profile.Releasing then
		-- wird bereits gespeichert (PlayerRemoving + BindToClose gleichzeitig)
		while DataService.Profiles[player] == profile do
			task.wait(0.1)
		end
		return
	end
	profile.Releasing = true
	if profile.Loaded then
		for _, callback in ipairs(releasingCallbacks) do
			local ok, err = pcall(callback, player, profile.Data)
			if not ok then
				warn("[DataService] Releasing-Callback Fehler: " .. tostring(err))
			end
		end
		if not profile.NoSave then
			profile.Data.LastOnline = os.time()
			saveData(player.UserId, profile.Data, true)
		end
	end
	DataService.Profiles[player] = nil
end

-- Spielstand komplett zurücksetzen (Admin)
function DataService.Reset(player: Player)
	local profile = DataService.Profiles[player]
	if profile and profile.Loaded then
		local fresh = Util.DeepCopy(DEFAULT_DATA)
		fresh.Receipts = profile.Data.Receipts -- Käufe bleiben verbucht
		fresh.StarterBought = profile.Data.StarterBought == true -- Starter-Paket gibt es nur einmal
		for k in pairs(profile.Data) do
			profile.Data[k] = nil
		end
		for k, v in pairs(fresh) do
			profile.Data[k] = v
		end
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(releaseProfile)

	-- Auto-Save
	task.spawn(function()
		while true do
			task.wait(Config.AutoSaveInterval)
			for player in pairs(DataService.Profiles) do
				if player.Parent then
					task.spawn(DataService.Save, player)
					task.wait(0.5) -- verteilen, um Limits zu schonen
				end
			end
		end
	end)

	-- Server fährt herunter: alles speichern (Roblox gibt max. 30 Sekunden)
	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				releaseProfile(player)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[-- Geld & Fortschritt: Einkommen, Schlüpfen (Meteor -> Alien), Aufladen (Level), Einsammeln,
-- Verkaufen, Schritte/Speed, Rebirth, Tagesbonus, Index, Leaderstats und Daten an den Client.
-- Verteilt außerdem die Anfragen vom Client (Remotes.Request) – auch für Geschenke, Glücksrad,
-- Tagesaufgaben (RewardService) und Gadgets (GadgetService) – und zählt Fortschritt für die Aufgaben.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Aliens = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Aliens"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))

local EconomyService = {}
local Services

local dirty: { [Player]: boolean } = {}
-- true = Spielstand fertig eingerichtet (Pässe geprüft, Offline-Zeit verrechnet, Base angezeigt).
-- Vorher laufen weder Einkommen/Schlüpfen noch Käufe/Diebstähle.
local readyPlayers: { [Player]: boolean } = {}
local requestLimiter = Util.RateLimiter(8, 1)

-- Selten geänderte Teile des States (Index, Pässe, Statistik) nur bei Änderung mitschicken.
-- Der Client behält die alten Werte, wenn ein Feld fehlt. Ab und zu trotzdem alles (Sicherheitsnetz).
local FULL_STATE_INTERVAL = 20
local sentIndexCount: { [Player]: number } = {}
local sentPasses: { [Player]: string } = {}
local sentStats: { [Player]: string } = {}
local fullStateAt: { [Player]: number } = {}

local DELIVER_TIME = 0.9 -- so lange fliegt ein gekaufter Meteor in die Base (Client-Effekt)
local ULTRA_ANNOUNCE_RARITY = 5 -- ab Legendary wird ein Ultra-Alien allen angesagt
local REVEAL_RARITY = Config.RarityIndex.Epic or 4 -- ab Epic: große Schlüpf-Karte beim Besitzer
local LUCKY_PASS_MULT = 2 -- Gamepass "2x Glück": Selten/Ultra beim Schlüpfen doppelt so wahrscheinlich
local MAX_COIL_BONUS = 1 + (Config.SpeedCoilBonus or 0.3) -- Speed Coil: +30% (auch über MaxWalkSpeed)
local TIER_RANK = { Normal = 1, Selten = 2, Ultra = 3 }
-- "Alle Eier sofort schlüpfen": höchstens so viele Schlüpf-Explosionen an alle (sonst ruckelt es bei allen)
local HATCH_ALL_BURSTS = 3

-- -------------------------------------------------------------------
-- NACHRICHTEN & EFFEKTE
-- -------------------------------------------------------------------
function EconomyService.Notify(player: Player?, text: string, kind: string?)
	if player and player.Parent then
		Remotes.Notify:FireClient(player, text, kind or "Info")
	end
end

function EconomyService.NotifyAll(text: string, kind: string?)
	Remotes.Notify:FireAllClients(text, kind or "Info")
end

-- Effekt für einen Spieler: name, strength, data (optional, z.B. Positionen)
function EconomyService.Effect(player: Player?, name: string, strength: number?, data: any?)
	if player and player.Parent then
		Remotes.Effect:FireClient(player, name, strength or 1, data)
	end
end

-- Effekt für alle Spieler (z.B. "Deliver", "Hatch")
function EconomyService.EffectAll(name: string, strength: number?, data: any?)
	Remotes.Effect:FireAllClients(name, strength or 1, data)
end

-- Fortschritt für die Tagesaufgaben (RewardService) – ein Fehler dort darf Geld/Schlüpfen nie stoppen
local function track(player: Player, kind: string, amount: number)
	local rewards = Services.RewardService
	if rewards then
		local ok, err = pcall(rewards.Track, player, kind, amount)
		if not ok then
			warn("[EconomyService] RewardService.Track(" .. kind .. ") fehlgeschlagen: " .. tostring(err))
		end
	end
end

function EconomyService.MarkDirty(player: Player?)
	if player then
		dirty[player] = true
	end
end

-- Ist der Spielstand fertig geladen und eingerichtet? (für Käufe, Diebstähle, Einkommen)
function EconomyService.IsReady(player: Player): boolean
	return readyPlayers[player] == true
end

-- -------------------------------------------------------------------
-- RECHNEN
-- -------------------------------------------------------------------
-- Anzahl entdeckter Aliens (nur gültige Alien-Ids zählen)
function EconomyService.IndexCount(data): number
	local count = 0
	for id in pairs(data.Index) do
		if Aliens.ById[id] then
			count += 1
		end
	end
	return count
end

function EconomyService.GetMultiplier(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 1
	end
	local Monetization = Services.MonetizationService
	local mult = 1 + data.Rebirths * Config.RebirthMultPerLevel
	if Monetization.HasPass(player, "DoubleCash") then
		mult *= 2
	end
	local bonus = 1 + EconomyService.IndexCount(data) * Config.IndexBonusPerAlien
	if Monetization.HasPass(player, "VIP") then
		bonus += Config.VIPBonus
	end
	if player.MembershipType == Enum.MembershipType.Premium then
		bonus += Config.PremiumBonus
	end
	return mult * bonus
end

function EconomyService.GetIncome(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 0
	end
	local plot = Services.PlotService.GetPlot(player)
	local base = 0
	for key, entry in pairs(data.Meteors) do
		local slot = tonumber(key)
		if not (plot and slot and Services.CarryService.IsSlotBeingStolen(plot, slot)) then
			base += Config.MeteorIncome(entry)
		end
	end
	return base * EconomyService.GetMultiplier(player)
end

-- Schritte-Multiplikator: 2x mit Gamepass "2x Schritte", +25% pro Rebirth
function EconomyService.GetStepsMult(player: Player): number
	local data = Services.DataService.Get(player)
	local rebirths = data and data.Rebirths or 0
	local pass = Services.MonetizationService.HasPass(player, "SpeedBoots") and 2 or 1
	return pass * (1 + Config.StepsPerRebirth * rebirths)
end

-- Tempo aus den Schritten (ohne Gadgets, ohne Tragen) – wird im HUD angezeigt
function EconomyService.GetSpeed(player: Player): number
	local data = Services.DataService.Get(player)
	local steps = data and data.Steps or 0
	return math.min(Config.MaxWalkSpeed, Config.StepsSpeed(steps))
end

-- Speed Coil (GadgetService): Faktor 1 .. 1.3, solange sie ausgerüstet ist
local function gadgetSpeedBonus(player: Player): number
	local gadgets = Services.GadgetService
	if not gadgets or type(gadgets.SpeedBonus) ~= "function" then
		return 1
	end
	local ok, bonus = pcall(gadgets.SpeedBonus, player)
	local factor = ok and tonumber(bonus) or 1
	if factor ~= factor then
		return 1
	end
	return math.clamp(factor, 1, MAX_COIL_BONUS)
end

-- Beim Tragen: Config.CarrySpeedFactor, seltene (schwere) Beute noch langsamer (Config.HeavyCarry),
-- mit Gamepass "Volle Speed beim Tragen" gar kein Abzug
local function carryFactor(player: Player): number
	if Services.MonetizationService.HasPass(player, "CarryFast") then
		return 1
	end
	local factor = Config.CarrySpeedFactor
	local heavy = Config.HeavyFactor(Services.CarryService.CarriedEntry(player))
	if heavy then
		factor = math.min(factor, heavy)
	end
	return factor
end

-- Echte Laufgeschwindigkeit: Schritte-Tempo x Speed Coil (Deckel MaxWalkSpeed * 1.3), beim Tragen langsamer
function EconomyService.GetWalkSpeed(player: Player, carrying: boolean): number
	local speed = EconomyService.GetSpeed(player)
	local bonus = gadgetSpeedBonus(player)
	if bonus > 1 then
		speed = math.min(speed * bonus, Config.MaxWalkSpeed * MAX_COIL_BONUS)
	end
	if carrying then
		speed = math.max(8, speed * carryFactor(player))
	end
	return speed
end

function EconomyService.ApplySpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local speed = EconomyService.GetWalkSpeed(player, Services.CarryService.IsCarrying(player))
	if humanoid.WalkSpeed ~= speed then
		humanoid.WalkSpeed = speed
	end
end

-- Schritte gutschreiben (Laufband, Produkte, Belohnungen). Passt die Laufgeschwindigkeit an.
-- (Die Tagesaufgabe "Lauf X Schritte" zählt der TreadmillService – gekaufte Schritte zählen nicht.)
function EconomyService.AddSteps(player: Player, amount: number)
	local data = Services.DataService.Get(player)
	if not data or amount ~= amount or amount == math.huge then
		return
	end
	local before = Config.StepsSpeed(data.Steps)
	data.Steps = math.clamp(data.Steps + amount, 0, 1e30)
	if Config.StepsSpeed(data.Steps) ~= before then
		EconomyService.ApplySpeed(player)
	end
	dirty[player] = true
end

-- -------------------------------------------------------------------
-- GELD
-- -------------------------------------------------------------------
function EconomyService.AddCash(player: Player, amount: number)
	local data = Services.DataService.Get(player)
	if not data or amount ~= amount then
		return
	end
	data.Cash = math.max(0, data.Cash + amount)
	if amount > 0 then
		data.TotalEarned += amount
	end
	dirty[player] = true
end

function EconomyService.Collect(player: Player)
	local data = Services.DataService.Get(player)
	if not data or data.Pending < 1 then
		return
	end
	local amount = math.floor(data.Pending)
	data.Pending -= amount
	EconomyService.AddCash(player, amount)
	EconomyService.Effect(player, "Collect", amount)
	track(player, "Collect", amount)
	local plot = Services.PlotService.GetPlot(player)
	if plot then
		Services.PlotService.SetCollectText(plot, data.Pending)
	end
end

-- Neues Alien im Index? (silent = keine Einzel-Nachricht, z.B. beim Laden)
function EconomyService.Discover(player: Player, alienId: string?, silent: boolean?): boolean
	local data = Services.DataService.Get(player)
	local alien = alienId and Aliens.ById[alienId]
	if not data or not alien or data.Index[alien.Id] then
		return false
	end
	data.Index[alien.Id] = true
	if not silent then
		EconomyService.Notify(
			player,
			"📖 NEU im Index: "
				.. alien.Name
				.. "! (+"
				.. math.floor(Config.IndexBonusPerAlien * 100 + 0.5)
				.. "% Einkommen)",
			"Success"
		)
	end
	dirty[player] = true
	return true
end

-- Legt einen Meteor in einen Slot. Mit fromPosition fliegt er sichtbar dorthin (Client-Effekt)
-- und erscheint erst nach der Flugzeit. entry.Alien gesetzt + gültig -> schon geschlüpft.
function EconomyService.DeliverMeteor(player: Player, plot, slot: number, entry, fromPosition: Vector3?)
	local data = Services.DataService.Get(player)
	if not data or not Config.MeteorsById[entry.Id] then
		return nil
	end
	local key = tostring(slot)
	local newEntry = {
		Id = entry.Id,
		Mut = Config.MutationsByName[entry.Mut] and entry.Mut or "Normal",
		Lv = math.clamp(math.floor(tonumber(entry.Lv) or 1), 1, Config.MaxLevel),
		Xp = 0,
		Hatch = Config.HatchTime(entry.Id),
		Alien = nil :: string?,
	}
	if entry.Alien ~= nil and Aliens.ById[entry.Alien] then
		newEntry.Alien = entry.Alien
		newEntry.Hatch = 0
	end
	data.Meteors[key] = newEntry
	dirty[player] = true
	if newEntry.Alien then
		EconomyService.Discover(player, newEntry.Alien)
	end

	if fromPosition then
		local top = Services.PlotService.SlotTopCFrame(plot, slot).Position
		local to = top + Vector3.new(0, MeteorFactory.GetSize(newEntry) / 2, 0)
		EconomyService.EffectAll("Deliver", 0, {
			From = fromPosition,
			To = to,
			MeteorId = newEntry.Id,
			Mut = newEntry.Mut,
		})
		task.delay(DELIVER_TIME, function()
			-- nur anzeigen, wenn der Eintrag noch derselbe ist (nicht verkauft, Rebirth, verlassen ...)
			local current = Services.DataService.Get(player)
			if plot.Owner == player and current and current.Meteors[key] == newEntry then
				Services.PlotService.RenderSlot(plot, slot)
			end
		end)
	else
		Services.PlotService.RenderSlot(plot, slot)
	end
	return newEntry
end

-- Meteor direkt in die Base legen (Admin, Produkte). Gibt true zurück, wenn Platz war.
-- fly = true -> fliegt vom Himmel in den Slot
function EconomyService.GiveMeteor(player: Player, entry, fly: boolean?): boolean
	local plot = Services.PlotService.GetPlot(player)
	local slot = Services.PlotService.FreeSlot(player)
	if not plot or not slot or not Config.MeteorsById[entry.Id] then
		return false
	end
	local from = nil
	if fly then
		local top = Services.PlotService.SlotTopCFrame(plot, slot).Position
		from = top + Vector3.new(math.random(-40, 40), 180, math.random(-40, 40))
	end
	return EconomyService.DeliverMeteor(player, plot, slot, entry, from) ~= nil
end

function EconomyService.Sell(player: Player, plot, slot: number)
	if plot.Owner ~= player then
		return
	end
	local data = Services.DataService.Get(player)
	local key = tostring(slot)
	local entry = data and data.Meteors[key]
	if not entry or Services.CarryService.IsSlotBeingStolen(plot, slot) then
		return
	end
	local value = math.floor(Config.MeteorValue(entry) * Config.SellRatio)
	data.Meteors[key] = nil
	EconomyService.AddCash(player, value)
	Services.PlotService.RenderSlot(plot, slot)
	EconomyService.Notify(player, "💰 Verkauft für " .. Util.FormatCash(value), "Success")
end

-- -------------------------------------------------------------------
-- SCHLÜPFEN
-- -------------------------------------------------------------------
-- Glück beim Schlüpfen: Server-Glück/Schauer (baseLuck) x2 mit Gamepass "2x Glück"
function EconomyService.HatchLuck(player: Player, baseLuck: number?): number
	local luck = baseLuck or Services.MeteorService.GetLuck()
	if Services.MonetizationService.HasPass(player, "Lucky") then
		luck *= LUCKY_PASS_MULT
	end
	return luck
end

-- Wertung fürs "beste" Alien (Seltenheit vor Stufe)
local function alienScore(def, tier: string): number
	return (def and Config.RarityIndex[def.Rarity] or 0) * 10 + (TIER_RANK[tier] or 1)
end

-- Stelle der Schlüpf-Explosion über einem Slot
local function hatchPosition(plot, slot: number): Vector3
	return Services.PlotService.SlotTopCFrame(plot, slot).Position + Vector3.new(0, 2, 0)
end

-- Meteor in Slot schlüpft jetzt -> Alien würfeln, Index, Effekt, neu anzeigen. Gibt die Alien-Id zurück.
-- quiet = keine Einzel-Nachrichten/-Karten/-Explosionen (z.B. "Alle Eier sofort schlüpfen" meldet gesammelt)
function EconomyService.Hatch(player: Player, plot, slot: number, entry, luck: number?, quiet: boolean?): string
	local alienId = Aliens.Roll(entry.Id, EconomyService.HatchLuck(player, luck))
	entry.Alien = alienId
	entry.Hatch = 0
	entry.Lv = math.max(1, tonumber(entry.Lv) or 1)
	entry.Xp = 0
	dirty[player] = true

	local alien = Aliens.ById[alienId]
	local def = Config.MeteorsById[entry.Id]
	Services.PlotService.RenderSlot(plot, slot)
	if not quiet then
		EconomyService.EffectAll(
			"Hatch",
			0,
			{ Position = hatchPosition(plot, slot), Rarity = def and def.Rarity or "Common" }
		)
	end

	local name = alien and alien.Name or alienId
	local tier = alien and alien.Tier or "Normal"
	if not quiet then
		local tierText = tier == "Ultra" and "🌟 ULTRA " or (tier == "Selten" and "✨ Selten: " or "")
		EconomyService.Notify(player, "🐣 Geschlüpft: " .. tierText .. name .. "!", "Success")
		-- Große Karte in der Bildschirmmitte (mit Konfetti) ab Epic oder bei Selten/Ultra
		if tier ~= "Normal" or (def and (Config.RarityIndex[def.Rarity] or 0) >= REVEAL_RARITY) then
			EconomyService.Effect(player, "HatchReveal", 0, { AlienId = alienId, Mut = entry.Mut })
		end
	end
	if tier == "Ultra" and def and Config.RarityIndex[def.Rarity] >= ULTRA_ANNOUNCE_RARITY then
		EconomyService.NotifyAll(
			"🌟 " .. player.DisplayName .. " hat ein ULTRA " .. name .. " ausgebrütet!",
			"Event"
		)
	end
	EconomyService.Discover(player, alienId, quiet)
	track(player, "Hatch", 1)
	return alienId
end

-- Alle Eier in der Base schlüpfen sofort (Produkt "🐣 Alle Eier sofort schlüpfen").
-- Eine Sammel-Nachricht + große Karte fürs beste Alien statt vieler Einzel-Nachrichten.
-- Gibt die Anzahl der geschlüpften Aliens zurück (0 = keine Eier in der Base).
function EconomyService.HatchAll(player: Player): number
	local data = Services.DataService.Get(player)
	local plot = Services.PlotService.GetPlot(player)
	if not data or not plot then
		return 0
	end
	local luck = Services.MeteorService.GetLuck()
	local indexBefore = EconomyService.IndexCount(data)
	local count = 0
	local bestId, bestMut, bestScore = nil, nil, -1
	local bursts: { { Position: Vector3, Rarity: string, Score: number } } = {}
	for key, entry in pairs(data.Meteors) do
		local slot = tonumber(key)
		if slot and entry.Alien == nil and not Services.CarryService.IsSlotBeingStolen(plot, slot) then
			local alienId = EconomyService.Hatch(player, plot, slot, entry, luck, true)
			count += 1
			local alien = Aliens.ById[alienId]
			local def = Config.MeteorsById[entry.Id]
			local score = alienScore(def, alien and alien.Tier or "Normal")
			if score > bestScore then
				bestId, bestMut, bestScore = alienId, entry.Mut, score
			end
			table.insert(bursts, {
				Position = hatchPosition(plot, slot),
				Rarity = def and def.Rarity or "Common",
				Score = score,
			})
		end
	end
	-- Nur die besten paar Explosionen an alle schicken (18 auf einmal = Ruckeln bei jedem Spieler)
	table.sort(bursts, function(a, b)
		return a.Score > b.Score
	end)
	for i = 1, math.min(HATCH_ALL_BURSTS, #bursts) do
		EconomyService.EffectAll("Hatch", 0, { Position = bursts[i].Position, Rarity = bursts[i].Rarity })
	end
	if count > 0 then
		local discovered = EconomyService.IndexCount(data) - indexBefore
		EconomyService.Notify(
			player,
			"🐣 "
				.. (count == 1 and "1 Alien ist" or (count .. " Aliens sind"))
				.. " geschlüpft!"
				.. (discovered > 0 and (" 📖 " .. discovered .. " neu im Index!") or ""),
			"Success"
		)
		if bestId then
			EconomyService.Effect(player, "HatchReveal", 0, { AlienId = bestId, Mut = bestMut })
		end
	end
	return count
end

-- -------------------------------------------------------------------
-- REBIRTH / DAILY
-- -------------------------------------------------------------------
function EconomyService.Rebirth(player: Player): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch..."
	end
	if Services.CarryService.IsCarrying(player) then
		return false, "Bring erst deine Beute nach Hause! 🏃"
	end
	local cost = Config.RebirthCost(data.Rebirths)
	if data.Cash < cost then
		return false, "Du brauchst " .. Util.FormatCash(cost) .. " für den Rebirth!"
	end
	local plot = Services.PlotService.GetPlot(player)
	if plot then
		Services.CarryService.CancelStealsFromPlot(plot, "cancelled")
	end
	data.Rebirths += 1
	data.Cash = Config.StartCash
	data.Pending = 0
	data.Meteors = {}
	if plot then
		Services.PlotService.RenderAll(plot)
		Services.PlotService.SetCollectText(plot, 0)
	end
	dirty[player] = true
	EconomyService.NotifyAll("🔥 " .. player.DisplayName .. " hat Rebirth " .. data.Rebirths .. " erreicht!", "Event")
	EconomyService.Effect(player, "Confetti", 2)
	return true,
		"🔥 Rebirth! Jetzt "
			.. Util.FormatNumber(EconomyService.GetMultiplier(player) * 100)
			.. "% Einkommen und x"
			.. Util.FormatNumber(EconomyService.GetStepsMult(player))
			.. " Schritte"
end

local DAY = 24 * 3600

function EconomyService.DailyStatus(data): (boolean, number)
	local elapsed = os.time() - data.Daily.Last
	return elapsed >= DAY, math.max(0, DAY - elapsed)
end

function EconomyService.ClaimDaily(player: Player): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch..."
	end
	local ready, remaining = EconomyService.DailyStatus(data)
	if not ready then
		return false, "⏰ Nächster Bonus in " .. Util.FormatTime(remaining)
	end
	local elapsed = os.time() - data.Daily.Last
	if data.Daily.Last > 0 and elapsed < DAY * 2 then
		data.Daily.Streak += 1
	else
		data.Daily.Streak = 1
	end
	data.Daily.Last = os.time()
	local reward = math.max(
		Config.DailyRewardMinCash,
		EconomyService.GetIncome(player) * Config.DailyRewardIncomeSeconds
	) * math.min(data.Daily.Streak, 7)
	reward = math.floor(reward)
	EconomyService.AddCash(player, reward)
	EconomyService.Effect(player, "Confetti", 1)
	return true, "🎁 Tag " .. data.Daily.Streak .. ": +" .. Util.FormatCash(reward)
end

-- -------------------------------------------------------------------
-- DATEN AN DEN CLIENT
-- -------------------------------------------------------------------
-- Besessene Gadgets als Liste von Ids (Reihenfolge wie in Config.Gadgets)
local function ownedGadgets(data): { string }
	local list = {}
	local gadgets = data.Gadgets
	if type(gadgets) == "table" then
		for _, def in ipairs(Config.Gadgets) do
			if gadgets[def.Id] == true then
				table.insert(list, def.Id)
			end
		end
	end
	return list
end

local function buildState(player: Player)
	local data = Services.DataService.Get(player)
	if not data then
		return nil
	end
	local plot = Services.PlotService.GetPlot(player)
	local dailyReady, dailyIn = EconomyService.DailyStatus(data)
	local indexCount = EconomyService.IndexCount(data)
	local best = Config.BestTreadmill(data.Steps)
	local state = {
		Cash = data.Cash,
		Pending = data.Pending,
		Income = EconomyService.GetIncome(player),
		Multiplier = EconomyService.GetMultiplier(player),
		Rebirths = data.Rebirths,
		RebirthCost = Config.RebirthCost(data.Rebirths),
		Steps = data.Steps,
		StepsMult = EconomyService.GetStepsMult(player),
		Speed = EconomyService.GetSpeed(player),
		BestTreadmill = best and best.Id or nil,
		Slots = Services.PlotService.SlotCount(player),
		UsedSlots = Services.PlotService.UsedSlots(player),
		DailyReady = dailyReady,
		DailyIn = dailyIn,
		Streak = data.Daily.Streak,
		IndexBonus = indexCount * Config.IndexBonusPerAlien,
		Carrying = Services.CarryService.IsCarrying(player),
		HasPlot = plot ~= nil,
		TotalEarned = data.TotalEarned,
		Gadgets = ownedGadgets(data),
		StarterBought = data.StarterBought == true,
	}
	-- Selten geänderte Teile nur bei Änderung (oder alle FULL_STATE_INTERVAL Sekunden alles)
	local clock = os.clock()
	local full = clock - (fullStateAt[player] or -math.huge) >= FULL_STATE_INTERVAL
	if full then
		fullStateAt[player] = clock
	end

	-- 🎁 Geschenke, 🎡 Glücksrad (Spins, FreeSpinIn), 📜 Aufgaben – ein Fehler dort darf den State nie stoppen.
	-- (Geschenke/Aufgaben schickt der RewardService auch nur bei Änderung bzw. wenn full = true.)
	local rewards = Services.RewardService
	if rewards then
		local ok, err = pcall(rewards.FillState, player, data, state, full)
		if not ok then
			warn("[EconomyService] Belohnungs-Daten fehlgeschlagen: " .. tostring(err))
		end
	end

	-- Index, Pässe und Statistik nur bei Änderung (oder wenn full = true)
	if full or sentIndexCount[player] ~= indexCount then
		-- Der Index wächst nur (Reset leert ihn) -> die Anzahl reicht als Änderungs-Merkmal
		sentIndexCount[player] = indexCount
		local index = {}
		for id in pairs(data.Index) do
			if Aliens.ById[id] then
				table.insert(index, id)
			end
		end
		state.Index = index
	end
	local passKey = ""
	for _, pass in ipairs(Config.GamePasses) do
		passKey ..= Services.MonetizationService.HasPass(player, pass.Key) and "1" or "0"
	end
	if full or sentPasses[player] ~= passKey then
		sentPasses[player] = passKey
		local passes = {}
		for _, pass in ipairs(Config.GamePasses) do
			passes[pass.Key] = Services.MonetizationService.HasPass(player, pass.Key)
		end
		state.Passes = passes
	end
	local stats = data.Stats
	local statsKey = ("%s|%s|%s|%s"):format(
		tostring(stats.Stolen),
		tostring(stats.Robbed),
		tostring(stats.Bought),
		tostring(stats.RobuxSpent)
	)
	if full or sentStats[player] ~= statsKey then
		sentStats[player] = statsKey
		state.Stats = stats
	end
	return state
end

local function updateLeaderstats(player: Player)
	local data = Services.DataService.Get(player)
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	local cash = stats:FindFirstChild("Cash") :: StringValue?
	local rebirths = stats:FindFirstChild("Rebirths") :: IntValue?
	if cash then
		local text = Util.FormatCash(data.Cash)
		if cash.Value ~= text then
			cash.Value = text
		end
	end
	if rebirths and rebirths.Value ~= data.Rebirths then
		rebirths.Value = data.Rebirths
	end
end

local function flush(player: Player)
	local state = buildState(player)
	if state then
		Remotes.State:FireClient(player, state)
		updateLeaderstats(player)
	end
end

local function onProfileLoaded(player: Player, data)
	-- Leaderboard in der Spielerliste
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player

	-- Spielstand reparieren (gelöschte Meteor-Typen entfernen, Slots kappen, Felder prüfen)
	local maxSlots = Services.PlotService.MaxSlots
	for key, entry in pairs(data.Meteors) do
		local slot = tonumber(key)
		if not slot or not Config.MeteorsById[entry.Id] or slot < 1 or slot > maxSlots or slot % 1 ~= 0 then
			data.Meteors[key] = nil
		else
			entry.Lv = math.clamp(math.floor(tonumber(entry.Lv) or 1), 1, Config.MaxLevel)
			entry.Xp = tonumber(entry.Xp) or 0
			entry.Mut = Config.MutationsByName[entry.Mut] and entry.Mut or "Normal"
			entry.Hatch = math.max(0, tonumber(entry.Hatch) or 0)
			if entry.Alien ~= nil then
				data.Index[entry.Alien] = true
			end
		end
	end

	-- Zeitpunkt des letzten Besuchs VOR dem Warten merken (ein Auto-Save setzt LastOnline neu)
	local lastOnline = data.LastOnline

	-- Warten bis die Gamepasses geprüft sind (für Slots / Multiplikator / Schlüpf-Tempo).
	-- Bis "ready" gesetzt ist, laufen weder Einkommen noch Schlüpfen, Käufe oder Diebstähle.
	Services.MonetizationService.LoadPasses(player)
	if not player.Parent then
		return
	end

	-- Offline: Schlüpfzeit vergeht auch ohne dich
	local offline = lastOnline > 0 and math.max(0, os.time() - lastOnline) or 0
	local hatchedOffline = 0
	if offline > 0 then
		local speed = Services.PlotService.HatchSpeed(player)
		local luck = EconomyService.HatchLuck(player, 1) -- ohne Server-Glück, aber mit "2x Glück"-Pass
		for _, entry in pairs(data.Meteors) do
			if entry.Alien == nil then
				entry.Hatch = math.max(0, entry.Hatch - offline * speed)
				if entry.Hatch <= 0 then
					entry.Alien = Aliens.Roll(entry.Id, luck)
					entry.Hatch = 0
					entry.Xp = 0
					EconomyService.Discover(player, entry.Alien, true)
					hatchedOffline += 1
				end
			end
		end
	end

	-- Offline-Einkommen
	if lastOnline > 0 then
		local seconds = math.clamp(offline, 0, Config.OfflineMaxSeconds)
		local earned = math.floor(EconomyService.GetIncome(player) * seconds * Config.OfflineIncomeRate)
		if earned > 0 then
			data.Pending += earned
			task.delay(3, function()
				EconomyService.Notify(
					player,
					"🌙 Offline verdient: " .. Util.FormatCash(earned) .. " – hol es am Collect-Pad!",
					"Success"
				)
			end)
		end
	end
	if hatchedOffline > 0 then
		track(player, "Hatch", hatchedOffline)
		task.delay(4, function()
			EconomyService.Notify(
				player,
				"🐣 Während du weg warst, "
					.. (hatchedOffline == 1 and "ist 1 Alien" or ("sind " .. hatchedOffline .. " Aliens"))
					.. " geschlüpft!",
				"Success"
			)
		end)
	end
	data.LastOnline = os.time()

	local plot = Services.PlotService.GetPlot(player)
	if plot then
		Services.PlotService.RenderAll(plot)
		Services.PlotService.SetCollectText(plot, data.Pending)
	end
	readyPlayers[player] = true
	EconomyService.ApplySpeed(player)
	flush(player)

	local dailyReady = EconomyService.DailyStatus(data)
	if dailyReady then
		task.delay(5, function()
			EconomyService.Notify(player, "🎁 Dein Tagesbonus wartet! Klick auf 'Daily'.", "Info")
		end)
	end
end

-- Etwa jede Sekunde: Schlüpfen, Aufladen (Level) und Einkommen für einen Spieler.
-- dt = echte vergangene Zeit -> der Schlüpf-Countdown beim Client (HatchAt) bleibt genau.
local function tickPlayer(player: Player, data, plot, dt: number)
	local Monetization = Services.MonetizationService
	local speed = (Monetization.HasPass(player, "FastCharge") and 2 or 1) * dt
	local luck = nil
	for key, entry in pairs(data.Meteors) do
		local slot = tonumber(key)
		if slot and not Services.CarryService.IsSlotBeingStolen(plot, slot) then
			if entry.Alien == nil then
				entry.Hatch -= speed
				if entry.Hatch <= 0 then
					luck = luck or Services.MeteorService.GetLuck()
					EconomyService.Hatch(player, plot, slot, entry, luck)
				end
			elseif entry.Lv < Config.MaxLevel then
				entry.Xp += speed
				if entry.Xp >= Config.ChargeTime(entry.Lv) then
					entry.Xp = 0
					entry.Lv += 1
					Services.PlotService.RefreshSlot(plot, slot)
				end
			end
		end
	end
	data.Pending += EconomyService.GetIncome(player) * dt
	if Monetization.HasPass(player, "AutoCollect") then
		local amount = math.floor(data.Pending)
		data.Pending -= amount
		EconomyService.AddCash(player, amount)
		if amount > 0 then
			track(player, "Collect", amount) -- Auto Collect zählt fürs "Sammle $X ein"
		end
	end
	Services.PlotService.SetCollectText(plot, data.Pending)
	dirty[player] = true
end

-- Eingefroren (Falle / Admin-Freeze = HumanoidRootPart verankert)? Dann kein Teleport (Home, Laufbänder)
local function isFrozen(player: Player): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root ~= nil and root:IsA("BasePart") and root.Anchored
end

-- Gadget mit Cash kaufen (GadgetService prüft Cash, zieht ab, gibt das Tool)
local function buyGadget(player: Player, id: any): (boolean, string)
	local gadgets = Services.GadgetService
	if type(id) ~= "string" or #id > 40 then
		return false, "Unbekanntes Gadget"
	end
	if not gadgets or type(gadgets.Buy) ~= "function" then
		return false, "🛠️ Gadgets kommen bald!"
	end
	local ok, success, message = pcall(gadgets.Buy, player, id)
	if not ok then
		warn("[EconomyService] Gadget-Kauf fehlgeschlagen: " .. tostring(success))
		return false, "Kauf fehlgeschlagen – versuch es nochmal"
	end
	return success == true, type(message) == "string" and message or ""
end

function EconomyService.Init(services)
	Services = services
end

function EconomyService.Start()
	Services.DataService.OnProfileLoaded(onProfileLoaded)

	-- Anfragen vom Client. Antwort: { Ok, Message, ...Extras } (z.B. Segment beim Glücksrad)
	Remotes.Request.OnServerInvoke = function(player: Player, action: any, arg: any)
		if not requestLimiter.Check(player) then
			return { Ok = false, Message = "Langsam! 🐢" }
		end
		if type(action) ~= "string" then
			return { Ok = false, Message = "Unbekannt" }
		end
		if not readyPlayers[player] then
			return { Ok = false, Message = "Lädt noch... ⏳" }
		end
		local ok, message = false, "Unbekannt"
		local extra: { [string]: any }? = nil
		local rewards = Services.RewardService
		local rewardAction = action == "ClaimGift"
			or action == "Spin"
			or action == "ClaimQuest"
			or action == "RerollQuest"
		if rewardAction and not rewards then
			ok, message = false, "🎁 Belohnungen kommen bald!"
		elseif action == "ClaimGift" then
			ok, message = rewards.ClaimGift(player, arg)
		elseif action == "Spin" then
			ok, message, extra = rewards.Spin(player)
		elseif action == "ClaimQuest" then
			ok, message = rewards.ClaimQuest(player, arg)
		elseif action == "RerollQuest" then
			ok, message = rewards.RerollQuest(player, arg)
		elseif action == "BuyGadget" then
			ok, message = buyGadget(player, arg)
		elseif action == "Rebirth" then
			ok, message = EconomyService.Rebirth(player)
		elseif action == "Daily" then
			ok, message = EconomyService.ClaimDaily(player)
		elseif action == "Collect" then
			-- nur in der eigenen Base (sonst wäre es ein Gratis-"Auto Collect" von überall)
			local plot = Services.PlotService.GetPlot(player)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if plot and root and Services.PlotService.IsInside(plot, root.Position) then
				EconomyService.Collect(player)
				ok, message = true, ""
			else
				ok, message = false, "🏠 Einsammeln geht nur in deiner Base!"
			end
		elseif action == "Home" then
			if Services.CarryService.IsCarrying(player) then
				ok, message = false, "Mit Beute musst du laufen! 🏃"
			elseif isFrozen(player) then
				ok, message = false, "🧊 Du bist eingefroren!"
			else
				Services.PlotService.TeleportHome(player)
				ok, message = true, ""
			end
		elseif action == "Treadmills" then
			if Services.CarryService.IsCarrying(player) then
				ok, message = false, "Mit Beute musst du laufen! 🏃"
			elseif isFrozen(player) then
				ok, message = false, "🧊 Du bist eingefroren!"
			elseif Services.PlotService.TeleportToTreadmills(player) then
				ok, message = true, "🏃 Ab aufs Laufband!"
			else
				ok, message = false, "Kein Charakter"
			end
		elseif action == "GoRun" then
			-- ☄️ Meteor-Run: zum Start-Tor (RunService prüft Tragen, Einfrieren, Charakter)
			local run = Services.RunService
			if run then
				ok, message = run.Teleport(player)
			else
				ok, message = false, "☄️ Der Meteor-Run kommt bald!"
			end
		end
		dirty[player] = true
		local response: { [string]: any } = { Ok = ok, Message = message }
		if extra then
			for key, value in pairs(extra) do
				if response[key] == nil then
					response[key] = value
				end
			end
		end
		return response
	end

	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
		readyPlayers[player] = nil
		sentIndexCount[player] = nil
		sentPasses[player] = nil
		sentStats[player] = nil
		fullStateAt[player] = nil
		requestLimiter.Clear(player)
	end)

	-- Schlüpfen + Einkommen + Aufladen jede Sekunde
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local clock = os.clock()
			local dt = math.clamp(clock - last, 0, 5) -- nach einem Hänger nicht zu viel auf einmal
			last = clock
			for _, player in ipairs(Players:GetPlayers()) do
				local data = Services.DataService.Get(player)
				local plot = Services.PlotService.GetPlot(player)
				if data and plot and readyPlayers[player] then
					local ok, err = pcall(tickPlayer, player, data, plot, dt)
					if not ok then
						warn("[EconomyService] Tick-Fehler bei " .. player.Name .. ": " .. tostring(err))
					end
				end
			end
		end
	end)

	-- Gesammelte Änderungen max. 5x pro Sekunde an die Clients schicken
	task.spawn(function()
		while true do
			task.wait(0.2)
			for player in pairs(dirty) do
				dirty[player] = nil
				if player.Parent then
					flush(player)
				end
			end
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">GadgetService</string>
            <string name="Source"><![CDATA[-- GADGETS: mit Cash im Shop kaufen (Config.Gadgets). Sie gehören einem für immer (data.Gadgets,
-- bleibt bei Rebirth) und liegen nach jedem Spawn als Werkzeug im Rucksack:
--   🌀 Speed Coil – solange in der Hand: +30% Tempo (EconomyService.ApplySpeed fragt SpeedBonus)
--   🪤 Falle      – Klick in der EIGENEN Base: Falle am Boden (max. Config.MaxTrapsPerBase).
--                   Fremde frieren Config.TrapFreezeTime Sekunden ein, getragene Beute ist weg.
--   🔨 Super-Bonk – ersetzt den normalen Bonk (Schlag-Logik in CarryService)
--   👻 Umhang     – Klick: Config.CloakDuration Sekunden unsichtbar und nicht bonkbar,
--                   danach Config.CloakCooldown Sekunden Abklingzeit (ab dem Sichtbarwerden).
--                   Wer klaut, wird sofort sichtbar (CarryService), mit Beute geht er nicht an.
-- Alles wird hier auf dem Server geprüft und gebremst (Klicks kommen vom Client).
-- Fallen lösen über Touched UND über eine eigene Server-Prüfung aus (Touched meldet der Client –
-- wer das lokal abschaltet, läuft trotzdem nicht einfach drüber).

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local GadgetService = {}
local Services

local useLimiter = Util.RateLimiter(4, 1) -- Werkzeug-Klicks pro Sekunde (Falle, Umhang)
local SYNC_INTERVAL = 2 -- so oft wird geprüft, ob jeder seine Werkzeuge hat
local TRAP_PLACE_COOLDOWN = 1 -- Sekunden zwischen zwei Fallen
local TRAP_SIZE = 4.5
local TRAP_HEIGHT = 0.6 -- so hoch, dass Füße beim Drüberlaufen sicher die Falle berühren
local TRAP_EDGE_MARGIN = TRAP_SIZE / 2 + 1 -- Fallen-Mitte so weit innerhalb der Base (nichts ragt raus)
local TRAP_IMMUNE_EXTRA = 5 -- nach dem Auftauen so viele Sekunden immun (keine Endlos-Falle)
local TRAP_CHECK_INTERVAL = 0.2 -- so oft prüft der Server selbst, ob jemand auf einer Falle steht
local TRAP_REACH = TRAP_SIZE / 2 + 1 -- waagrechter Abstand Fallen-Mitte <-> HumanoidRootPart
local TRAP_MAX_HEIGHT = 5 -- so hoch über der Falle zählt der HumanoidRootPart noch als "draufgetreten"

-- Werkzeug-Namen im Rucksack (Super-Bonk heißt in CarryService "Super-Bonk")
local TOOL_NAMES = {
	SpeedCoil = "Speed Coil",
	Trap = "Falle",
	Cloak = "Umhang",
}

-- Fallen pro Besitzer (eine Base pro Spieler): [player] = { Falle, ... }
local trapsByOwner: { [Player]: { BasePart } } = {}
local trapPlacedAt: { [Player]: number } = {}
local trapImmuneUntil: { [Player]: number } = {} -- gerade aus einer Falle aufgetaut -> kurz immun
-- Umhang: [player] = { Character, Changed = { [Instance] = alte Transparenz }, Conn, ... }
type CloakState = {
	Character: Model,
	Changed: { [Instance]: number },
	Conn: RBXScriptConnection,
	Humanoid: Humanoid?,
	DisplayType: Enum.HumanoidDisplayDistanceType?,
}
local cloaks: { [Player]: CloakState } = {}
local cloakReadyAt: { [Player]: number } = {}
local freezeToken = 0
local templates: { [string]: Tool } = {}

-- -------------------------------------------------------------------
-- BESITZ
-- -------------------------------------------------------------------
local function gadgetTable(data): { [string]: boolean }
	if type(data.Gadgets) ~= "table" then
		data.Gadgets = {} -- alter Spielstand ohne Gadgets
	end
	return data.Gadgets
end

function GadgetService.Owns(player: Player, id: string): boolean
	local data = Services.DataService.Get(player)
	if not data or type(data.Gadgets) ~= "table" then
		return false
	end
	return data.Gadgets[id] == true
end

-- Alle Gadget-Ids, die der Spieler besitzt (Reihenfolge wie in Config.Gadgets)
function GadgetService.OwnedList(player: Player): { string }
	local list = {}
	for _, gadget in ipairs(Config.Gadgets) do
		if GadgetService.Owns(player, gadget.Id) then
			table.insert(list, gadget.Id)
		end
	end
	return list
end

local function aliveCharacter(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not humanoid or humanoid.Health <= 0 or not root then
		return nil, nil, nil
	end
	return character, humanoid, root
end

-- Gadget-Werkzeug (Attribut "Gadget") im Rucksack oder in der Hand?
local function findGadgetTool(container: Instance?, id: string): Tool?
	if not container then
		return nil
	end
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Tool") and child:GetAttribute("Gadget") == id then
			return child
		end
	end
	return nil
end

-- -------------------------------------------------------------------
-- 🌀 SPEED COIL
-- -------------------------------------------------------------------
-- Faktor für die Laufgeschwindigkeit: 1.3 solange die Speed Coil in der Hand ist, sonst 1
function GadgetService.SpeedBonus(player: Player): number
	local character = player.Character
	if character and findGadgetTool(character, "SpeedCoil") and GadgetService.Owns(player, "SpeedCoil") then
		return 1 + Config.SpeedCoilBonus
	end
	return 1
end

-- -------------------------------------------------------------------
-- 🪤 FALLE
-- -------------------------------------------------------------------
local function trapList(player: Player): { BasePart }
	local list = trapsByOwner[player]
	if not list then
		list = {}
		trapsByOwner[player] = list
	end
	for i = #list, 1, -1 do
		if not list[i].Parent then
			table.remove(list, i) -- schon ausgelöst oder mit der Base weg
		end
	end
	return list
end

-- Boden unter den Füßen (nur begehbare Teile, Spieler ignorieren)
local function floorBelow(position: Vector3): Vector3?
	local ignore: { Instance } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	local result = workspace:Raycast(position, Vector3.new(0, -12, 0), params)
	return result and result.Position or nil
end

-- Kurzer Eisblock um den Eingefrorenen (nur Optik)
local function iceEffect(root: BasePart, seconds: number)
	local ice = Instance.new("Part")
	ice.Name = "TrapIce"
	ice.Size = Vector3.new(4.5, 6.5, 4.5)
	ice.CFrame = root.CFrame * CFrame.new(0, -0.4, 0)
	ice.Anchored = true
	ice.CanCollide = false
	ice.CanQuery = false
	ice.CanTouch = false
	ice.CastShadow = false
	ice.Material = Enum.Material.Glass
	ice.Color = Color3.fromRGB(160, 225, 255)
	ice.Transparency = 0.45
	ice.Parent = workspace
	Debris:AddItem(ice, seconds)
end

-- Friert einen Spieler ein (HumanoidRootPart verankert) und taut ihn danach wieder auf.
-- Ein Admin-Freeze in der Zwischenzeit löscht das Attribut -> wird dann nicht aufgetaut.
local function freeze(root: BasePart, seconds: number)
	freezeToken += 1
	local token = freezeToken
	root:SetAttribute("TrapFreeze", token)
	root.Anchored = true
	iceEffect(root, seconds)
	task.delay(seconds, function()
		if root.Parent and root:GetAttribute("TrapFreeze") == token then
			root:SetAttribute("TrapFreeze", nil)
			root.Anchored = false
		end
	end)
end

-- Falle schnappt zu (über Touched oder die Server-Prüfung). Nur für Fremde, die IN der Base des
-- Besitzers stehen (wer am Eingang vorbeiläuft, wird nicht erwischt) und nicht gerade erst aufgetaut sind.
local function springTrap(owner: Player, trap: BasePart, victim: Player)
	if trap:GetAttribute("Sprung") == true or not trap.Parent or victim == owner then
		return
	end
	if os.clock() < (trapImmuneUntil[victim] or 0) then
		return
	end
	local _, humanoid, root = aliveCharacter(victim)
	local plot = Services.PlotService.GetPlot(owner)
	if not humanoid or not root or not plot or not Services.PlotService.IsInside(plot, root.Position) then
		return
	end
	trap:SetAttribute("Sprung", true)
	trap:Destroy()
	trapImmuneUntil[victim] = os.clock() + Config.TrapFreezeTime + TRAP_IMMUNE_EXTRA
	if not root.Anchored then
		freeze(root, Config.TrapFreezeTime) -- (schon vom Admin eingefroren -> so lassen)
	end
	if Services.CarryService.IsCarrying(victim) then
		Services.CarryService.Fail(victim, "trap") -- Beute aus der Base fliegt zurück, Eier fallen runter
	end
	Services.EconomyService.Effect(victim, "Shake", 0.8)
	Services.EconomyService.Notify(
		victim,
		"🪤 FALLE! Du bist " .. Config.TrapFreezeTime .. " Sekunden eingefroren!",
		"Error"
	)
	Services.EconomyService.Notify(owner, "🪤 " .. victim.DisplayName .. " ist in deine Falle getappt!", "Success")
end

local function onTrapTouched(owner: Player, trap: BasePart, hit: BasePart)
	local character = hit:FindFirstAncestorOfClass("Model")
	local victim = character and Players:GetPlayerFromCharacter(character)
	if victim and victim.Character == character then
		springTrap(owner, trap, victim)
	end
end

-- Server-Prüfung (alle TRAP_CHECK_INTERVAL Sekunden): steht ein Fremder auf einer Falle?
local function checkTraps()
	for owner, list in pairs(trapsByOwner) do
		for _, trap in ipairs(list) do
			if trap.Parent and trap:GetAttribute("Sprung") ~= true then
				local center = trap.Position
				for _, victim in ipairs(Players:GetPlayers()) do
					local character = victim.Character
					local root = character and character:FindFirstChild("HumanoidRootPart")
					if victim ~= owner and root and root:IsA("BasePart") then
						local offset = root.Position - center
						local flatSq = offset.X * offset.X + offset.Z * offset.Z
						if flatSq <= TRAP_REACH * TRAP_REACH and offset.Y > -1 and offset.Y < TRAP_MAX_HEIGHT then
							springTrap(owner, trap, victim)
							if trap:GetAttribute("Sprung") == true then
								break
							end
						end
					end
				end
			end
		end
	end
end

local function buildTrap(position: Vector3): BasePart
	local trap = Instance.new("Part")
	trap.Name = "Trap"
	trap.Shape = Enum.PartType.Cylinder
	trap.Size = Vector3.new(TRAP_HEIGHT, TRAP_SIZE, TRAP_SIZE)
	trap.CFrame = CFrame.new(position + Vector3.new(0, TRAP_HEIGHT / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	trap.Anchored = true
	trap.CanCollide = false
	trap.CanQuery = false
	trap.CanTouch = true
	trap.CastShadow = false
	trap.Material = Enum.Material.DiamondPlate
	trap.Color = Color3.fromRGB(70, 70, 80)

	-- Leuchtring + Zähne (nur Optik)
	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(TRAP_HEIGHT + 0.05, TRAP_SIZE * 0.7, TRAP_SIZE * 0.7)
	ring.CFrame = trap.CFrame
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 60, 60)
	ring.Parent = trap
	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2
		local tooth = Instance.new("Part")
		tooth.Name = "Tooth"
		tooth.Size = Vector3.new(0.3, 0.7, 0.3)
		tooth.CFrame = CFrame.new(
			position
				+ Vector3.new(math.cos(angle) * TRAP_SIZE * 0.42, TRAP_HEIGHT + 0.3, math.sin(angle) * TRAP_SIZE * 0.42)
		)
		tooth.Anchored = true
		tooth.CanCollide = false
		tooth.CanQuery = false
		tooth.CanTouch = false
		tooth.CastShadow = false
		tooth.Material = Enum.Material.Metal
		tooth.Color = Color3.fromRGB(210, 210, 220)
		tooth.Parent = trap
	end
	return trap
end

local function placeTrap(player: Player)
	if not useLimiter.Check(player) or not GadgetService.Owns(player, "Trap") then
		return
	end
	local t = os.clock()
	if t - (trapPlacedAt[player] or -math.huge) < TRAP_PLACE_COOLDOWN then
		return
	end
	local _, _, root = aliveCharacter(player)
	local plot = Services.PlotService.GetPlot(player)
	if not root or not plot then
		return
	end
	if not Services.PlotService.IsInside(plot, root.Position) then
		Services.EconomyService.Notify(player, "🪤 Fallen kannst du nur in deiner eigenen Base aufstellen!", "Error")
		return
	end
	local list = trapList(player)
	if #list >= Config.MaxTrapsPerBase then
		Services.EconomyService.Notify(
			player,
			"🪤 Schon " .. Config.MaxTrapsPerBase .. " Fallen aufgestellt – mehr gehen nicht!",
			"Error"
		)
		return
	end
	local floor = floorBelow(root.Position)
	if not floor or not Services.PlotService.IsInside(plot, floor) then
		return
	end
	-- Die ganze Falle muss in der Base liegen (am Rand würde sie vor den Eingang ragen)
	local localFloor = plot.CFrame:PointToObjectSpace(floor)
	local limit = (plot.HalfSize or 36) - TRAP_EDGE_MARGIN
	if math.abs(localFloor.X) > limit or math.abs(localFloor.Z) > limit then
		Services.EconomyService.Notify(player, "🪤 Zu nah am Rand – stell die Falle weiter innen auf!", "Error")
		return
	end
	trapPlacedAt[player] = t
	local folder = plot.Model:FindFirstChild("Traps")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Traps"
		folder.Parent = plot.Model
	end
	local trap = buildTrap(floor)
	trap:SetAttribute("OwnerUserId", player.UserId)
	trap.Touched:Connect(function(hit)
		onTrapTouched(player, trap, hit)
	end)
	trap.Parent = folder
	table.insert(list, trap)
	Services.EconomyService.Notify(
		player,
		"🪤 Falle aufgestellt! (" .. #list .. "/" .. Config.MaxTrapsPerBase .. ")",
		"Success"
	)
end

local function clearTraps(player: Player)
	local list = trapsByOwner[player]
	if list then
		for _, trap in ipairs(list) do
			trap:Destroy()
		end
	end
	trapsByOwner[player] = nil
end

-- -------------------------------------------------------------------
-- 👻 UMHANG
-- -------------------------------------------------------------------
function GadgetService.IsCloaked(player: Player): boolean
	return cloaks[player] ~= nil
end

-- Die getragene Beute bleibt sichtbar (man sieht ein schwebendes Ei – bonken geht trotzdem nicht)
local function isCarriedLoot(inst: Instance): boolean
	return inst:FindFirstAncestor("CarriedMeteor") ~= nil
		or inst:FindFirstAncestor("CarriedAlien") ~= nil
		or inst.Name == "CarriedMeteor"
end

local function hide(state: CloakState, inst: Instance)
	if state.Changed[inst] ~= nil or isCarriedLoot(inst) then
		return
	end
	if inst:IsA("BasePart") or inst:IsA("Decal") then
		local item = inst :: any -- beide haben Transparency
		state.Changed[inst] = item.Transparency
		item.Transparency = 1
	end
end

local function setOverheadTag(character: Model)
	local head = character:FindFirstChild("Head")
	local tag = head and head:FindFirstChild("OverheadTag")
	if head and head:IsA("BasePart") and tag and tag:IsA("BillboardGui") then
		tag.Enabled = head.Transparency < 1
	end
end

-- Umhang beenden (Zeit um, Klauen, Respawn, Admin-Unsichtbar). Die Abklingzeit zählt ab JETZT.
-- silent = keine Nachricht
local function endCloak(player: Player, silent: boolean?)
	local state = cloaks[player]
	if not state then
		return
	end
	cloaks[player] = nil
	cloakReadyAt[player] = os.clock() + Config.CloakCooldown
	state.Conn:Disconnect()
	for inst, transparency in pairs(state.Changed) do
		if inst.Parent then
			(inst :: any).Transparency = transparency
		end
	end
	local humanoid = state.Humanoid
	if humanoid and humanoid.Parent and state.DisplayType then
		humanoid.DisplayDistanceType = state.DisplayType
	end
	setOverheadTag(state.Character)
	if player.Parent then
		player:SetAttribute("CloakedUntil", nil)
	end
	if not silent then
		Services.EconomyService.Notify(
			player,
			"👻 Du bist wieder sichtbar! (Umhang lädt " .. Config.CloakCooldown .. " s)",
			"Info"
		)
	end
end
GadgetService.EndCloak = endCloak

local function activateCloak(player: Player)
	if not useLimiter.Check(player) or not GadgetService.Owns(player, "Cloak") then
		return
	end
	if cloaks[player] then
		return -- schon unsichtbar
	end
	local t = os.clock()
	local readyAt = cloakReadyAt[player] or 0
	if t < readyAt then
		Services.EconomyService.Notify(player, "👻 Umhang lädt noch " .. math.ceil(readyAt - t) .. " s", "Error")
		return
	end
	if Services.CarryService.IsCarrying(player) then
		Services.EconomyService.Notify(player, "👻 Mit Beute geht der Umhang nicht – erst heimbringen!", "Error")
		return
	end
	local character, humanoid = aliveCharacter(player)
	if not character or not humanoid then
		return
	end
	-- (falls endCloak nie kommt, z.B. Fehler: spätestens dann wieder bereit)
	cloakReadyAt[player] = t + Config.CloakDuration + Config.CloakCooldown
	local state: CloakState = {
		Character = character,
		Changed = {},
		Conn = (nil :: any) :: RBXScriptConnection,
		Humanoid = humanoid,
		DisplayType = humanoid.DisplayDistanceType,
	}
	for _, inst in ipairs(character:GetDescendants()) do
		hide(state, inst)
	end
	-- Neu dazukommende Teile (Werkzeug in die Hand genommen ...) auch verstecken
	state.Conn = character.DescendantAdded:Connect(function(inst)
		hide(state, inst)
	end)
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	setOverheadTag(character)
	cloaks[player] = state
	player:SetAttribute("CloakedUntil", workspace:GetServerTimeNow() + Config.CloakDuration)
	Services.EconomyService.Notify(
		player,
		"👻 " .. Config.CloakDuration .. " s unsichtbar – niemand kann dich bonken! (Klauen macht sichtbar)",
		"Success"
	)
	task.delay(Config.CloakDuration, function()
		if cloaks[player] == state then
			endCloak(player)
		end
	end)
end

-- -------------------------------------------------------------------
-- WERKZEUGE
-- -------------------------------------------------------------------
local function weld(part0: BasePart, part1: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = part0
	w.Part1 = part1
	w.Parent = part1
end

local function toolPart(tool: Tool, name: string, size: Vector3, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.Massless = true
	p.CastShadow = false
	p.Parent = tool
	return p
end

local function newTool(id: string, tip: string): Tool
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAMES[id] or id
	tool.ToolTip = tip
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("Gadget", id)
	return tool
end

local function buildTemplates()
	-- 🌀 Speed Coil: Griff mit leuchtenden Spiralringen
	local coil = newTool("SpeedCoil", "🌀 +30% Tempo, solange du sie hältst")
	local coilHandle =
		toolPart(coil, "Handle", Vector3.new(0.5, 2.2, 0.5), Color3.fromRGB(60, 60, 75), Enum.Material.Metal)
	for i = 1, 4 do
		local ring =
			toolPart(coil, "Ring", Vector3.new(0.25, 1.1, 1.1), Color3.fromRGB(0, 230, 255), Enum.Material.Neon)
		ring.Shape = Enum.PartType.Cylinder
		ring.CFrame = coilHandle.CFrame * CFrame.new(0, -0.8 + i * 0.4, 0) * CFrame.Angles(0, 0, math.rad(90))
		weld(coilHandle, ring)
	end
	coil.Grip = CFrame.new(0, -0.4, 0)
	templates.SpeedCoil = coil

	-- 🪤 Falle: kleine Falle in der Hand
	local trapTool = newTool("Trap", "🪤 Klick in deiner Base = Falle aufstellen")
	local trapHandle =
		toolPart(trapTool, "Handle", Vector3.new(0.4, 1.6, 1.6), Color3.fromRGB(70, 70, 80), Enum.Material.DiamondPlate)
	trapHandle.Shape = Enum.PartType.Cylinder
	local trapRing =
		toolPart(trapTool, "Ring", Vector3.new(0.45, 1.1, 1.1), Color3.fromRGB(255, 60, 60), Enum.Material.Neon)
	trapRing.Shape = Enum.PartType.Cylinder
	trapRing.CFrame = trapHandle.CFrame
	weld(trapHandle, trapRing)
	trapTool.Grip = CFrame.new(0, 0, -0.6) * CFrame.Angles(0, 0, math.rad(90))
	templates.Trap = trapTool

	-- 👻 Umhang: lila Stoffbündel
	local cloak = newTool("Cloak", "👻 Klick = unsichtbar (Abklingzeit beachten)")
	local cloakHandle =
		toolPart(cloak, "Handle", Vector3.new(1.2, 1.4, 0.5), Color3.fromRGB(120, 60, 200), Enum.Material.Fabric)
	local cloakGlow =
		toolPart(cloak, "Glow", Vector3.new(1.3, 0.2, 0.6), Color3.fromRGB(200, 150, 255), Enum.Material.Neon)
	cloakGlow.CFrame = cloakHandle.CFrame * CFrame.new(0, 0.6, 0)
	weld(cloakHandle, cloakGlow)
	templates.Cloak = cloak
end

-- Gibt das Werkzeug eines Gadgets (ohne Doppelte). Super-Bonk tauscht den normalen Bonk aus.
local function giveGadgetTool(player: Player, id: string)
	if id == "SuperBonk" then
		Services.CarryService.GiveBonk(player)
		return
	end
	local template = templates[id]
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not template or not backpack then
		return
	end
	if findGadgetTool(backpack, id) or findGadgetTool(player.Character, id) then
		return
	end
	local tool = template:Clone()
	if id == "Trap" then
		tool.Activated:Connect(function()
			placeTrap(player)
		end)
	elseif id == "Cloak" then
		tool.Activated:Connect(function()
			activateCloak(player)
		end)
	elseif id == "SpeedCoil" then
		-- In die Hand nehmen / weglegen -> Tempo neu berechnen
		tool.AncestryChanged:Connect(function()
			Services.EconomyService.ApplySpeed(player)
		end)
	end
	tool.Parent = backpack
end

-- Alle besessenen Gadgets als Werkzeug geben, nicht (mehr) besessene wegnehmen (z.B. nach Reset)
function GadgetService.GiveTools(player: Player)
	local character, humanoid = aliveCharacter(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not character or not humanoid or not backpack or not Services.DataService.Get(player) then
		return
	end
	for _, gadget in ipairs(Config.Gadgets) do
		if GadgetService.Owns(player, gadget.Id) then
			giveGadgetTool(player, gadget.Id)
		else
			for _, container in ipairs({ backpack, character }) do
				local tool = findGadgetTool(container, gadget.Id)
				if tool and gadget.Id ~= "SuperBonk" then
					tool:Destroy()
				end
			end
		end
	end
	Services.CarryService.GiveBonk(player) -- richtiger Schläger (Bonk / Super-Bonk)
end

-- -------------------------------------------------------------------
-- KAUFEN / SCHENKEN
-- -------------------------------------------------------------------
-- Kauf mit Cash (Shop -> Request "BuyGadget"). Gibt (Erfolg, Nachricht) zurück.
function GadgetService.Buy(player: Player, id: any): (boolean, string)
	local gadget = type(id) == "string" and Config.GadgetsById[id] or nil
	if not gadget then
		return false, "Unbekanntes Gadget"
	end
	local data = Services.DataService.Get(player)
	if not data or not Services.EconomyService.IsReady(player) then
		return false, "Lädt noch... ⏳"
	end
	local owned = gadgetTable(data)
	if owned[gadget.Id] then
		return false, "✅ " .. gadget.Name .. " hast du schon!"
	end
	if data.Cash < gadget.Price then
		return false, "💸 Du brauchst " .. Util.FormatCash(gadget.Price) .. " für " .. gadget.Name .. "!"
	end
	data.Cash -= gadget.Price
	owned[gadget.Id] = true
	Services.EconomyService.MarkDirty(player)
	task.spawn(Services.DataService.Save, player) -- teurer Kauf -> gleich sichern
	giveGadgetTool(player, gadget.Id)
	Services.EconomyService.Effect(player, "Confetti", 1)
	return true, gadget.Icon .. " " .. gadget.Name .. " gekauft! Liegt in deinem Rucksack."
end

-- Geschenk (Admin, Starter-Paket): gehört dem Spieler danach für immer. true = hat geklappt
function GadgetService.Give(player: Player, id: any): boolean
	local gadget = type(id) == "string" and Config.GadgetsById[id] or nil
	local data = Services.DataService.Get(player)
	if not gadget or not data then
		return false
	end
	gadgetTable(data)[gadget.Id] = true
	Services.EconomyService.MarkDirty(player)
	giveGadgetTool(player, gadget.Id)
	return true
end
GadgetService.Grant = GadgetService.Give

-- -------------------------------------------------------------------
function GadgetService.Init(services)
	Services = services
	buildTemplates()
end

function GadgetService.Start()
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function()
			endCloak(player, true) -- neuer Charakter ist sowieso sichtbar
			if player:WaitForChild("Backpack", 10) then
				GadgetService.GiveTools(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end
	-- Spielstand geladen -> gekaufte Gadgets sofort geben (nicht erst nach dem nächsten Spawn)
	Services.DataService.OnProfileLoaded(function(player: Player)
		GadgetService.GiveTools(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		endCloak(player, true)
		clearTraps(player)
		cloakReadyAt[player] = nil
		trapPlacedAt[player] = nil
		trapImmuneUntil[player] = nil
		useLimiter.Clear(player)
	end)

	-- Fallen selbst prüfen (Touched allein reicht nicht – das meldet der Client)
	task.spawn(function()
		while true do
			task.wait(TRAP_CHECK_INTERVAL)
			local ok, err = pcall(checkTraps)
			if not ok then
				warn("[GadgetService] Fallen-Prüfung: " .. tostring(err))
			end
		end
	end)

	-- Sicherheitsnetz: fehlende Werkzeuge nachreichen (z.B. Gadget per Spielstand geschenkt)
	task.spawn(function()
		while true do
			task.wait(SYNC_INTERVAL)
			for _, player in ipairs(Players:GetPlayers()) do
				local ok, err = pcall(GadgetService.GiveTools, player)
				if not ok then
					warn("[GadgetService] Werkzeuge für " .. player.Name .. ": " .. tostring(err))
				end
			end
		end
	end)
end

return GadgetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">GraphicsService</string>
            <string name="Source"><![CDATA[-- Grafik: helles, sattes Sonnenlicht wie in Simulator-Spielen.
-- Licht, Atmosphäre, Bloom (dezent), Sonnenstrahlen, Farbkorrektur, Himmel und Wolken.
-- Hinweis: Lighting.Technology = "Future" und Workspace.StreamingEnabled = false stehen in
-- default.project.json – Technology kann ein Script im laufenden Spiel nicht umstellen.
-- Wird in Main.server.luau VOR PlotService geladen.

local Lighting = game:GetService("Lighting")

local GraphicsService = {}

-- Diese Effekte bauen wir selbst -> alte/doppelte Versionen vorher entfernen (sonst addieren sie sich)
local OWN_CLASSES = { "Atmosphere", "Sky", "BloomEffect", "SunRaysEffect", "ColorCorrectionEffect" }

local function clearOld()
	for _, child in ipairs(Lighting:GetChildren()) do
		if table.find(OWN_CLASSES, child.ClassName) then
			child:Destroy()
		end
	end
end

local function applyLighting()
	Lighting.ClockTime = 14 -- Nachmittag: Sonne hoch, kurze Schatten
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 2.5
	Lighting.ExposureCompensation = 0
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.Ambient = Color3.fromRGB(45, 45, 55)
	Lighting.OutdoorAmbient = Color3.fromRGB(135, 135, 150)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 248, 235) -- leicht warmes Sonnenlicht
	Lighting.ColorShift_Bottom = Color3.new(0, 0, 0)
end

local function buildEffects()
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "MH_Atmosphere"
	atmosphere.Density = 0.27
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(200, 225, 255)
	atmosphere.Decay = Color3.fromRGB(120, 160, 220)
	atmosphere.Glare = 0.15
	atmosphere.Haze = 0.8
	atmosphere.Parent = Lighting

	local sky = Instance.new("Sky") -- Standard-Himmel von Roblox (blau mit Wolken)
	sky.Name = "MH_Sky"
	sky.SunAngularSize = 16
	sky.MoonAngularSize = 11
	sky.StarCount = 3000
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting

	local bloom = Instance.new("BloomEffect") -- dezent: nur Neon leuchtet etwas über
	bloom.Name = "MH_Bloom"
	bloom.Intensity = 0.6
	bloom.Size = 24
	bloom.Threshold = 1.8
	bloom.Parent = Lighting

	local sunRays = Instance.new("SunRaysEffect")
	sunRays.Name = "MH_SunRays"
	sunRays.Intensity = 0.05
	sunRays.Spread = 0.7
	sunRays.Parent = Lighting

	local colorCorrection = Instance.new("ColorCorrectionEffect") -- knalligere Farben
	colorCorrection.Name = "MH_ColorCorrection"
	colorCorrection.Brightness = 0.03
	colorCorrection.Contrast = 0.08
	colorCorrection.Saturation = 0.2
	colorCorrection.TintColor = Color3.new(1, 1, 1)
	colorCorrection.Parent = Lighting
end

local function buildClouds()
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return
	end
	local clouds = terrain:FindFirstChildOfClass("Clouds")
	if not clouds then
		clouds = Instance.new("Clouds")
		clouds.Name = "MH_Clouds"
		clouds.Parent = terrain
	end
	clouds.Cover = 0.55
	clouds.Density = 0.7
	clouds.Color = Color3.new(1, 1, 1)
	clouds.Enabled = true
end

function GraphicsService.Init(_services)
	clearOld()
	applyLighting()
	buildEffects()
	buildClouds()
end

return GraphicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- Globale Bestenliste (alle Server): Top 10 "Meistes Geld verdient" am Spawn-Platz.
-- Die Tafel steht an PlotService.LeaderboardCFrame (Vorderseite zeigt zur Platzmitte).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local LeaderboardService = {}
local Services

local UPDATE_INTERVAL = 300 -- alle 5 Minuten (schont DataStore-Limits)
local MAX_VALUE = 9e18

local store: OrderedDataStore? = nil
local rowsFrame: Frame

local function buildBoard()
	local board = Instance.new("Part")
	board.Name = "Leaderboard"
	board.Anchored = true
	board.Size = Vector3.new(36, 24, 1)
	board.CFrame = Services.PlotService.LeaderboardCFrame
	board.Color = Color3.fromRGB(25, 20, 35)
	board.Material = Enum.Material.SmoothPlastic
	board.CanTouch = false
	board.Parent = Services.PlotService.MapFolder or workspace

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front -- LookVector der CFrame zeigt zur Platzmitte
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = board

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0.14, 0)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 190, 60)
	title.Text = "🏆 TOP 10 – MEISTES GELD 🏆"
	title.Parent = gui

	rowsFrame = Instance.new("Frame")
	rowsFrame.BackgroundTransparency = 1
	rowsFrame.Position = UDim2.new(0.05, 0, 0.16, 0)
	rowsFrame.Size = UDim2.new(0.9, 0, 0.82, 0)
	rowsFrame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = rowsFrame
end

local function setRows(rows: { { Name: string, Value: number } })
	for _, child in ipairs(rowsFrame:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	if #rows == 0 then
		rows = { { Name = "Noch keine Einträge – sei der Erste!", Value = -1 } }
	end
	for i, row in ipairs(rows) do
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 0.1, 0)
		label.LayoutOrder = i
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = i == 1 and Color3.fromRGB(255, 215, 0)
			or i == 2 and Color3.fromRGB(220, 220, 230)
			or i == 3 and Color3.fromRGB(230, 150, 90)
			or Color3.new(1, 1, 1)
		label.Text = row.Value >= 0 and (("#%d  %s  –  %s"):format(i, row.Name, Util.FormatCash(row.Value)))
			or row.Name
		label.Parent = rowsFrame
	end
end

local function savePlayer(player: Player)
	local data = Services.DataService.Get(player)
	if not store or not data then
		return
	end
	local value = math.floor(math.clamp(data.TotalEarned, 0, MAX_VALUE))
	pcall(function()
		(store :: OrderedDataStore):SetAsync(tostring(player.UserId), value)
	end)
end

local nameCache: { [number]: string } = {}
local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	nameCache[userId] = ok and name or ("User " .. userId)
	return nameCache[userId]
end

local function refresh()
	if not store then
		return
	end
	local ok, pages = pcall(function()
		return (store :: OrderedDataStore):GetSortedAsync(false, 10)
	end)
	if not ok then
		return
	end
	local rows = {}
	for _, item in ipairs(pages:GetCurrentPage()) do
		local userId = tonumber(item.key)
		if userId then
			table.insert(rows, { Name = nameFor(userId), Value = item.value })
		end
	end
	setRows(rows)
end

function LeaderboardService.Init(services)
	Services = services
	pcall(function()
		store = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	buildBoard()
	setRows({})
end

function LeaderboardService.Start()
	Services.DataService.OnProfileReleasing(function(player)
		task.spawn(savePlayer, player)
	end)
	task.spawn(function()
		task.wait(10)
		while true do
			for _, player in ipairs(Players:GetPlayers()) do
				savePlayer(player)
				task.wait(0.5)
			end
			refresh()
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[-- Baut die komplette Map per Code (wird von PlotService.Init EINMAL aufgerufen):
--   • knallgrüner Roblox-Rasterboden mit Bäumen, Büschen, Zaun und unsichtbaren Randwänden
--   • langes LAUFBAND (Förderband) durch die Map-Mitte, Meteore kommen aus dem Portal am Spawn-Platz
--   • 8 Basen (je 4 pro Seite, Eingang zum Band) mit 18 Slot-Pads, Collect-Pad, Lock-Pad und Schild
--   • großer Spawn-Platz mit SpawnLocation, Gratis-Zone, Bestenliste und der LAUFBAND-ZONE (Treadmills)
-- Rückgabe von MapBuilder.Build(): siehe Typ "MapResult" unten.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local MapBuilder = {}

export type BeltInfo = {
	Part: BasePart,
	Start: Vector3, -- Mittellinie auf der Bandoberfläche am Startende
	Dir: Vector3, -- Einheitsvektor (Laufrichtung der Meteore)
	Length: number,
	Width: number,
	TopY: number, -- Höhe der Bandoberfläche
}

export type FreeZone = {
	Center: Vector3, -- Mitte der Gratis-Zone, Y = Oberkante des Bodens dort
	Radius: number,
}

export type MapResult = {
	MapFolder: Folder,
	Plots: { any },
	Belt: BeltInfo,
	LobbySpawn: CFrame,
	LeaderboardCFrame: CFrame,
	FreeZone: FreeZone,
	TreadmillsFolder: Folder,
	TreadmillSpawn: CFrame, -- Zusatz: Teleport-Ziel für den Knopf "🏃 Laufbänder"
}

type TreadmillDef = {
	Id: string,
	Name: string,
	Required: number,
	Rate: number,
	Color: Color3,
	Rainbow: boolean?,
}

type SignLine = { Name: string, Text: string, Color: Color3, Height: number }

-- -------------------------------------------------------------------
-- MASSE & FARBEN (alle Angaben in Studs)
-- -------------------------------------------------------------------
-- Boden
local GROUND_SIZE = 1024
local GROUND_CENTER_Z = -80
local GROUND_COLOR = Color3.fromRGB(90, 200, 70)
local GRID_TEXTURE = "rbxassetid://6372755229" -- Standard-Raster (lädt sie nicht, bleibt der Boden einfach grün)

-- Map-Rand (Zaun + unsichtbare Wände)
local EDGE_X = 150
local EDGE_MIN_Z = -406
local EDGE_MAX_Z = 256

-- Laufband (Förderband) entlang +Z durch die Map-Mitte
local BELT_LENGTH = 440
local BELT_WIDTH = 14
local BELT_FRAME_TOP = 0.8 -- Oberkante des Unterbaus
local BELT_TOP = 1.2 -- Oberkante der Lauffläche (hier liegen die Meteore auf)
local BELT_DEFAULT_SPEED = 9 -- falls Config.BeltSpeed fehlt
local CROSSINGS = { -80, 0, 80 } -- Lücken im Geländer zum Überqueren (genau zwischen den Basen)
local CROSSING_WIDTH = 10
local PORTAL_LENGTH = 16
local PORTAL_HEIGHT = 14

-- Basen
local PLOT_SIZE = 72
local HALF = PLOT_SIZE / 2
local PLOT_X = 70 -- Abstand Basis-Mitte <-> Bandmitte
local PLOT_Z = { -120, -40, 40, 120 }
local PLOT_FLOOR_TOP = 1
local WALL_HEIGHT = 12
local POST_HEIGHT = 14
local PLOT_COLORS = {
	Color3.fromRGB(255, 99, 99),
	Color3.fromRGB(255, 170, 60),
	Color3.fromRGB(255, 230, 80),
	Color3.fromRGB(110, 220, 110),
	Color3.fromRGB(80, 200, 255),
	Color3.fromRGB(110, 120, 255),
	Color3.fromRGB(200, 110, 255),
	Color3.fromRGB(255, 120, 200),
}
local FLOOR_DARK = Color3.fromRGB(38, 40, 54)
local SLOT_SIZE = 8
local SLOT_COLS = { -26.25, -15.75, -5.25, 5.25, 15.75, 26.25 } -- 6 Spalten
local SLOT_ROWS = { 0, 11.5, 23 } -- 3 Reihen: Reihe 1 nahe Eingang (Slot 1-6), Reihe 3 hinten (Slot 13-18)

-- Spawn-Platz (hinter dem Bandstart, -Z)
local PLAZA_MIN_Z = -398
local PLAZA_MAX_Z = -226
local PLAZA_HALF_X = 120
local PLAZA_TOP = 0.2
local PLAZA_CENTER = Vector3.new(0, PLAZA_TOP, (PLAZA_MIN_Z + PLAZA_MAX_Z) / 2)
local SPAWN_Z = -318
local FREE_ZONE_Z = -264
local FREE_ZONE_RADIUS = 22
local LEADERBOARD_POS = Vector3.new(-80, 13.4, -300) -- Mitte der Tafel (36 x 24)
local MONUMENT_POS = Vector3.new(80, PLAZA_TOP, -300)

-- Laufband-Zone (Treadmills) am hinteren Platzrand
local TREADMILL_SPACING = 14
local TREADMILL_BELT_Z = -366 -- Mitte der Laufflächen
local TREADMILL_DECK_TOP = 0.7
local TREADMILL_DECK_MIN_Z = -384
local TREADMILL_DECK_MAX_Z = -342
local TREADMILL_PUSH = 14 -- so schnell schiebt das Band den Spieler zurück
local TREADMILL_MATERIALS: { [string]: Enum.Material } = {
	Holz = Enum.Material.Wood,
	Stein = Enum.Material.Slate,
	Eisen = Enum.Material.DiamondPlate,
	Gold = Enum.Material.Foil,
	Diamant = Enum.Material.Glass,
	Galaxie = Enum.Material.Glass,
	Regenbogen = Enum.Material.SmoothPlastic,
}

local TREE_COLORS = {
	Color3.fromRGB(60, 170, 60),
	Color3.fromRGB(80, 190, 70),
	Color3.fromRGB(45, 150, 55),
	Color3.fromRGB(100, 200, 80),
}
local BUSH_COLOR = Color3.fromRGB(55, 160, 60)

local WHITE = Color3.new(1, 1, 1)

-- -------------------------------------------------------------------
-- BAU-HELFER
-- -------------------------------------------------------------------
-- Alle Teile werden gebaut, solange die Map noch NICHT im Workspace hängt (kein Nachrutschen,
-- ein einziger Replikations-Schub). Geschwindigkeiten der Bänder werden erst danach gesetzt.
local pendingVelocities: { { Part: BasePart, Velocity: Vector3 } } = {}

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false -- nur Pads brauchen Touched (spart Physik-Arbeit)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Flache Scheibe (Zylinder mit senkrechter Achse), Unterkante auf bottomY
local function disc(name: string, center: Vector3, bottomY: number, height: number, diameter: number, props)
	local p = part(props)
	p.Name = name
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = CFrame.new(center.X, bottomY + height / 2, center.Z) * CFrame.Angles(0, 0, math.rad(90))
	return p
end

-- Unsichtbarer Ankerpunkt für Schilder
local function anchorPart(name: string, cframe: CFrame, parent: Instance): Part
	return part({
		Name = name,
		Size = Vector3.new(1, 1, 1),
		CFrame = cframe,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = parent,
	})
end

-- Standard-Rastertextur (wie im Roblox-Baseplate) auf die Oberseite legen
local function addGrid(target: BasePart, transparency: number)
	local texture = Instance.new("Texture")
	texture.Name = "Grid"
	texture.Texture = GRID_TEXTURE
	texture.Face = Enum.NormalId.Top
	texture.StudsPerTileU = 8
	texture.StudsPerTileV = 8
	texture.Transparency = transparency
	texture.Parent = target
end

local function addLight(parent: Instance, color: Color3, range: number, brightness: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = parent
end

-- Einzeiliges Schild in Pixelgröße (wie bisher bei Collect/Lock/Basis-Namen)
local function billboard(parent: Instance, size: UDim2, offset: Vector3, maxDistance: number): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	gui.Parent = parent
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = WHITE
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = gui
	return gui, label
end

-- Mehrzeiliges Schild in Studs-Größe (wirkt wie ein echtes Schild in der Welt).
-- Aufbau wie bei MeteorFactory: BillboardGui > Frame "Frame" > TextLabels (UIListLayout)
local function worldSign(
	parent: Instance,
	guiName: string,
	widthStuds: number,
	heightStuds: number,
	offset: Vector3,
	maxDistance: number,
	lines: { SignLine }
): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = guiName
	gui.Size = UDim2.fromScale(widthStuds, heightStuds)
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	gui.Parent = parent

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = frame

	for order, line in ipairs(lines) do
		local label = Instance.new("TextLabel")
		label.Name = line.Name
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, line.Height)
		label.LayoutOrder = order
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = line.Color
		label.Text = line.Text
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.new(0, 0, 0)
		stroke.Parent = label
		label.Parent = frame
	end
	return gui
end

-- Liest Config.Treadmills zur LAUFZEIT und filtert kaputte Einträge raus
local function treadmillDefs(): { TreadmillDef }
	local list = (Config :: any).Treadmills
	local result: { TreadmillDef } = {}
	if type(list) ~= "table" then
		warn("[MapBuilder] Config.Treadmills fehlt – keine Laufbänder gebaut")
		return result
	end
	for _, def in ipairs(list) do
		if type(def) == "table" and type(def.Id) == "string" then
			table.insert(result, {
				Id = def.Id,
				Name = type(def.Name) == "string" and def.Name or def.Id,
				Required = tonumber(def.Required) or 0,
				Rate = tonumber(def.Rate) or 1,
				Color = typeof(def.Color) == "Color3" and def.Color or WHITE,
				Rainbow = def.Rainbow == true or def.Id == "Regenbogen",
			})
		end
	end
	return result
end

-- -------------------------------------------------------------------
-- ALTES ZEUG WEG
-- -------------------------------------------------------------------
local function clearOld()
	for _, child in ipairs(workspace:GetChildren()) do
		if child.Name == "Baseplate" or child.Name == "MeteorHeistMap" or child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end
end

-- -------------------------------------------------------------------
-- BODEN + RAND
-- -------------------------------------------------------------------
local function buildGround(map: Folder)
	local ground = part({
		Name = "Ground",
		Size = Vector3.new(GROUND_SIZE, 1, GROUND_SIZE),
		Position = Vector3.new(0, -0.5, GROUND_CENTER_Z),
		Material = Enum.Material.Plastic,
		Color = GROUND_COLOR,
		Parent = map,
	})
	addGrid(ground, 0.7)

	-- Unsichtbare Randwände (durchsichtige Teile verdecken die Kamera nicht)
	local lengthZ = EDGE_MAX_Z - EDGE_MIN_Z
	local centerZ = (EDGE_MAX_Z + EDGE_MIN_Z) / 2
	for _, data in ipairs({
		{ Vector3.new(-EDGE_X - 2, 60, centerZ), Vector3.new(4, 120, lengthZ + 8) },
		{ Vector3.new(EDGE_X + 2, 60, centerZ), Vector3.new(4, 120, lengthZ + 8) },
		{ Vector3.new(0, 60, EDGE_MIN_Z - 2), Vector3.new(EDGE_X * 2 + 8, 120, 4) },
		{ Vector3.new(0, 60, EDGE_MAX_Z + 2), Vector3.new(EDGE_X * 2 + 8, 120, 4) },
	}) do
		part({
			Name = "Boundary",
			Position = data[1],
			Size = data[2],
			Transparency = 1,
			CastShadow = false,
			Parent = map,
		})
	end
end

-- -------------------------------------------------------------------
-- LAUFBAND (Förderband) + PORTALE
-- -------------------------------------------------------------------
-- Gehäuse über einem Bandende. inward = +1: Öffnung zeigt nach +Z (Start), -1: nach -Z (Ende).
-- Die leuchtende Portal-Fläche sitzt direkt am Bandende: dort tauchen die Meteore auf bzw. verschwinden.
local function buildPortal(parent: Instance, name: string, bandEndZ: number, inward: number, color: Color3)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent

	local outerZ = bandEndZ - inward * 2 -- Ende des Unterbaus
	local openZ = bandEndZ + inward * PORTAL_LENGTH
	local centerZ = (outerZ + openZ) / 2
	local length = math.abs(openZ - outerZ)
	local housing = Color3.fromRGB(52, 54, 66)

	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "Wall",
			Size = Vector3.new(2.4, PORTAL_HEIGHT, length),
			Position = Vector3.new(s * 10.2, PORTAL_HEIGHT / 2, centerZ),
			Material = Enum.Material.Metal,
			Color = housing,
			Parent = model,
		})
		part({
			Name = "SideGlow",
			Size = Vector3.new(0.6, PORTAL_HEIGHT - BELT_FRAME_TOP, 0.6),
			Position = Vector3.new(s * 9.2, (PORTAL_HEIGHT + BELT_FRAME_TOP) / 2, openZ),
			Material = Enum.Material.Neon,
			Color = color,
			CanCollide = false,
			CastShadow = false,
			Parent = model,
		})
	end
	part({
		Name = "Roof",
		Size = Vector3.new(22.8, 2, length),
		Position = Vector3.new(0, PORTAL_HEIGHT + 1, centerZ),
		Material = Enum.Material.Metal,
		Color = housing,
		Parent = model,
	})
	part({
		Name = "TopGlow",
		Size = Vector3.new(18, 0.8, 0.6),
		Position = Vector3.new(0, PORTAL_HEIGHT - 0.4, openZ),
		Material = Enum.Material.Neon,
		Color = color,
		CanCollide = false,
		CastShadow = false,
		Parent = model,
	})
	local plane = part({
		Name = "PortalPlane",
		Size = Vector3.new(18, PORTAL_HEIGHT - BELT_FRAME_TOP, 0.4),
		Position = Vector3.new(0, (PORTAL_HEIGHT + BELT_FRAME_TOP) / 2, bandEndZ - inward * 0.3),
		Material = Enum.Material.Neon,
		Color = color,
		CanCollide = false, -- wer auf dem Band mitfährt, fällt hinten raus statt festzuklemmen
		CanQuery = false,
		CastShadow = false,
		Parent = model,
	})
	addLight(plane, color, 22, 2)
	return model
end

local function buildBelt(map: Folder): BeltInfo
	local deco = folder("BeltDeco", map)
	local startZ = -BELT_LENGTH / 2
	local endZ = BELT_LENGTH / 2
	local halfW = BELT_WIDTH / 2

	-- Unterbau
	part({
		Name = "Frame",
		Size = Vector3.new(BELT_WIDTH + 4, BELT_FRAME_TOP, BELT_LENGTH + 4),
		Position = Vector3.new(0, BELT_FRAME_TOP / 2, 0),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(58, 60, 70),
		Parent = deco,
	})

	-- Lauffläche (dunkel; die Streifen-Animation macht der Client)
	local beltHeight = BELT_TOP - BELT_FRAME_TOP + 0.2
	local belt = part({
		Name = "Belt",
		Size = Vector3.new(BELT_WIDTH, beltHeight, BELT_LENGTH),
		Position = Vector3.new(0, BELT_TOP - beltHeight / 2, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(36, 36, 42),
		Parent = map,
	})
	local start = Vector3.new(0, BELT_TOP, startZ)
	local dir = Vector3.new(0, 0, 1)
	belt:SetAttribute("BeltStart", start)
	belt:SetAttribute("BeltDir", dir)
	belt:SetAttribute("BeltLength", BELT_LENGTH)
	belt:SetAttribute("BeltWidth", BELT_WIDTH)
	local speed = tonumber((Config :: any).BeltSpeed) or BELT_DEFAULT_SPEED
	belt:SetAttribute("BeltSpeed", speed)
	-- Wer aufs Band springt, fährt mit den Meteoren mit
	table.insert(pendingVelocities, { Part = belt, Velocity = dir * speed })

	-- Abschnitte zwischen den Überquerungs-Lücken
	local segments: { { number } } = {}
	local z = startZ
	for _, crossing in ipairs(CROSSINGS) do
		table.insert(segments, { z, crossing - CROSSING_WIDTH / 2 })
		z = crossing + CROSSING_WIDTH / 2
	end
	table.insert(segments, { z, endZ })

	local yellow = Color3.fromRGB(255, 205, 40)
	local black = Color3.fromRGB(28, 28, 32)
	local lipTop = BELT_TOP + 0.3
	local lipHeight = lipTop - BELT_FRAME_TOP
	local railBottom = lipTop
	local railTop = railBottom + 2.4
	for _, segment in ipairs(segments) do
		local z0, z1 = segment[1], segment[2]
		for _, s in ipairs({ -1, 1 }) do
			-- gelb-schwarze Kanten
			part({
				Name = "EdgeYellow",
				Size = Vector3.new(1, lipHeight, z1 - z0),
				Position = Vector3.new(s * (halfW + 0.5), BELT_FRAME_TOP + lipHeight / 2, (z0 + z1) / 2),
				Material = Enum.Material.SmoothPlastic,
				Color = yellow,
				CastShadow = false,
				Parent = deco,
			})
			part({
				Name = "EdgeBlack",
				Size = Vector3.new(1, lipHeight, z1 - z0),
				Position = Vector3.new(s * (halfW + 1.5), BELT_FRAME_TOP + lipHeight / 2, (z0 + z1) / 2),
				Material = Enum.Material.SmoothPlastic,
				Color = black,
				CastShadow = false,
				Parent = deco,
			})
			-- Geländer aus Glas (in den Portalen übernehmen die Wände)
			local r0 = math.max(z0, startZ + PORTAL_LENGTH)
			local r1 = math.min(z1, endZ - PORTAL_LENGTH)
			if r1 - r0 > 1 then
				part({
					Name = "RailGlass",
					Size = Vector3.new(0.3, railTop - railBottom, r1 - r0),
					Position = Vector3.new(s * (halfW + 1.5), (railBottom + railTop) / 2, (r0 + r1) / 2),
					Material = Enum.Material.Glass,
					Color = Color3.fromRGB(170, 220, 255),
					Transparency = 0.6,
					CastShadow = false,
					Parent = deco,
				})
				part({
					Name = "RailTop",
					Size = Vector3.new(0.7, 0.4, r1 - r0),
					Position = Vector3.new(s * (halfW + 1.5), railTop + 0.2, (r0 + r1) / 2),
					Material = Enum.Material.Metal,
					Color = Color3.fromRGB(200, 205, 215),
					CastShadow = false,
					Parent = deco,
				})
			end
		end
	end

	-- Leuchtende Pfosten an den Überquerungs-Lücken
	for _, crossing in ipairs(CROSSINGS) do
		for _, s in ipairs({ -1, 1 }) do
			for _, e in ipairs({ -1, 1 }) do
				part({
					Name = "CrossingPost",
					Size = Vector3.new(0.8, railTop + 0.4 - BELT_FRAME_TOP, 0.8),
					Position = Vector3.new(
						s * (halfW + 1.5),
						(BELT_FRAME_TOP + railTop + 0.4) / 2,
						crossing + e * (CROSSING_WIDTH / 2 + 0.4)
					),
					Material = Enum.Material.Neon,
					Color = yellow,
					CastShadow = false,
					Parent = deco,
				})
			end
		end
	end

	-- Leuchtende Akzente unten am Unterbau
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "Glow",
			Size = Vector3.new(0.25, 0.25, BELT_LENGTH + 4),
			Position = Vector3.new(s * (halfW + 2.12), 0.45, 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(0, 210, 255),
			CanCollide = false,
			CastShadow = false,
			Parent = deco,
		})
	end

	-- Portale: Start (am Spawn-Platz) und Ende
	buildPortal(deco, "StartPortal", startZ, 1, Color3.fromRGB(150, 70, 255))
	buildPortal(deco, "EndPortal", endZ, -1, Color3.fromRGB(255, 70, 50))

	local titleAnchor = anchorPart("TitleSign", CFrame.new(0, PORTAL_HEIGHT + 9, startZ + PORTAL_LENGTH / 2), deco)
	worldSign(titleAnchor, "Sign", 46, 11, Vector3.zero, 700, {
		{ Name = "Title", Text = "☄️ METEOR HEIST ☄️", Color = Color3.fromRGB(255, 170, 60), Height = 0.62 },
		-- geräteneutral (am Handy gibt es keine E/F-Tasten): halten = klauen, kurz = kaufen
		{
			Name = "Hint",
			Text = "😈 Halten = Klauen (gratis) • 🛒 Kaufen = Lieferung",
			Color = WHITE,
			Height = 0.38,
		},
	})

	return {
		Part = belt,
		Start = start,
		Dir = dir,
		Length = BELT_LENGTH,
		Width = BELT_WIDTH,
		TopY = BELT_TOP,
	}
end

-- -------------------------------------------------------------------
-- BASEN
-- -------------------------------------------------------------------
local function buildPlot(index: number, cf: CFrame, color: Color3, parent: Instance)
	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model:SetAttribute("PlotIndex", index)
	model:SetAttribute("OwnerUserId", 0)
	model:SetAttribute("LockedUntil", 0)

	local top = PLOT_FLOOR_TOP
	local floorPart = part({
		Name = "Floor",
		Size = Vector3.new(PLOT_SIZE, top, PLOT_SIZE),
		CFrame = cf * CFrame.new(0, top / 2, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = color:Lerp(FLOOR_DARK, 0.55),
		Parent = model,
	})
	addGrid(floorPart, 0.85)
	model.PrimaryPart = floorPart

	-- Leuchtstreifen an der Eingangskante
	part({
		Name = "EntranceStripe",
		Size = Vector3.new(PLOT_SIZE, 0.2, 1),
		CFrame = cf * CFrame.new(0, top + 0.05, -HALF + 0.5),
		Material = Enum.Material.Neon,
		Color = color,
		CanCollide = false,
		CastShadow = false,
		Parent = model,
	})

	-- Wände hinten + seitlich, oben mit Leuchtkante
	local trimColor = color:Lerp(WHITE, 0.35)
	part({
		Name = "BackWall",
		Size = Vector3.new(PLOT_SIZE, WALL_HEIGHT, 1.5),
		CFrame = cf * CFrame.new(0, top + WALL_HEIGHT / 2, HALF - 0.75),
		Material = Enum.Material.SmoothPlastic,
		Color = color,
		Parent = model,
	})
	part({
		Name = "BackTrim",
		Size = Vector3.new(PLOT_SIZE, 0.6, 1.9),
		CFrame = cf * CFrame.new(0, top + WALL_HEIGHT + 0.3, HALF - 0.75),
		Material = Enum.Material.Neon,
		Color = trimColor,
		CastShadow = false,
		Parent = model,
	})
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "SideWall",
			Size = Vector3.new(1.5, WALL_HEIGHT, PLOT_SIZE),
			CFrame = cf * CFrame.new(s * (HALF - 0.75), top + WALL_HEIGHT / 2, 0),
			Material = Enum.Material.SmoothPlastic,
			Color = color,
			Parent = model,
		})
		part({
			Name = "SideTrim",
			Size = Vector3.new(1.9, 0.6, PLOT_SIZE),
			CFrame = cf * CFrame.new(s * (HALF - 0.75), top + WALL_HEIGHT + 0.3, 0),
			Material = Enum.Material.Neon,
			Color = trimColor,
			CastShadow = false,
			Parent = model,
		})
		part({
			Name = "Post",
			Size = Vector3.new(3, POST_HEIGHT, 3),
			CFrame = cf * CFrame.new(s * (HALF - 1.5), top + POST_HEIGHT / 2, -HALF + 1.5),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(60, 60, 70),
			Parent = model,
		})
	end

	-- Eingangstor (Balken über den Pfosten + Leuchtleiste nach vorne)
	part({
		Name = "GateBeam",
		Size = Vector3.new(PLOT_SIZE, 2.4, 3),
		CFrame = cf * CFrame.new(0, top + POST_HEIGHT + 1.2, -HALF + 1.5),
		Material = Enum.Material.SmoothPlastic,
		Color = color,
		Parent = model,
	})
	part({
		Name = "GateGlow",
		Size = Vector3.new(PLOT_SIZE - 6, 0.6, 0.4),
		CFrame = cf * CFrame.new(0, top + POST_HEIGHT + 1.2, -HALF - 0.2),
		Material = Enum.Material.Neon,
		Color = trimColor,
		CanCollide = false,
		CastShadow = false,
		Parent = model,
	})

	-- Laser-Sperre (PlotService macht sie sichtbar, solange die Base gesperrt ist)
	local barrier = part({
		Name = "Barrier",
		Size = Vector3.new(PLOT_SIZE - 6, POST_HEIGHT, 0.4),
		CFrame = cf * CFrame.new(0, top + POST_HEIGHT / 2, -HALF + 1.5),
		Material = Enum.Material.ForceField,
		Color = Color3.fromRGB(255, 40, 40),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = model,
	})

	-- 18 Slot-Pads (6 x 3), Reihenfolge = Slot-Nummer
	local slots: { BasePart } = {}
	for _, row in ipairs(SLOT_ROWS) do
		for _, col in ipairs(SLOT_COLS) do
			local slotNumber = #slots + 1
			slots[slotNumber] = part({
				Name = "Slot" .. slotNumber,
				Size = Vector3.new(SLOT_SIZE, 0.3, SLOT_SIZE),
				CFrame = cf * CFrame.new(col, top + 0.15, row),
				Material = Enum.Material.SmoothPlastic,
				Color = Color3.fromRGB(35, 35, 45),
				Transparency = 0.5,
				CanCollide = false,
				CanTouch = true, -- Betreten = Geld einsammeln
				CastShadow = false,
				Parent = model,
			})
		end
	end

	local collectPad = part({
		Name = "CollectPad",
		Size = Vector3.new(12, 0.3, 7),
		CFrame = cf * CFrame.new(-20, top + 0.15, -24),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(60, 220, 90),
		CanCollide = false,
		CanTouch = true,
		CastShadow = false,
		Parent = model,
	})
	local _, collectLabel = billboard(collectPad, UDim2.new(0, 200, 0, 50), Vector3.new(0, 4, 0), 80)
	collectLabel.Text = "💰 $0"

	local lockPad = part({
		Name = "LockPad",
		Size = Vector3.new(10, 0.3, 7),
		CFrame = cf * CFrame.new(20, top + 0.15, -24),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(230, 60, 60),
		CanCollide = false,
		CanTouch = true,
		CastShadow = false,
		Parent = model,
	})
	local _, lockLabel = billboard(lockPad, UDim2.new(0, 200, 0, 50), Vector3.new(0, 4, 0), 80)
	lockLabel.Text = "🔒 LOCK"

	local signPart = anchorPart("Sign", cf * CFrame.new(0, top + POST_HEIGHT + 7, -HALF + 1.5), model)
	local _, signLabel = billboard(signPart, UDim2.new(0, 340, 0, 64), Vector3.zero, 320)
	signLabel.Text = "Freie Base"
	signLabel.TextColor3 = color

	local meteorFolder = folder("Meteors", model)
	model.Parent = parent

	return {
		Index = index,
		Model = model,
		CFrame = cf,
		HalfSize = HALF,
		Color = color,
		Owner = nil :: Player?,
		Slots = slots,
		MeteorParts = {} :: { [number]: Instance },
		MeteorFolder = meteorFolder,
		CollectPad = collectPad,
		CollectLabel = collectLabel,
		LockPad = lockPad,
		LockLabel = lockLabel,
		Barrier = barrier,
		SignLabel = signLabel,
		LockedUntil = 0,
		SpawnCFrame = cf * CFrame.new(0, top + 3, -12),
		EntranceCFrame = cf * CFrame.new(0, 4, -HALF - 8),
	}
end

local function buildPlots(map: Folder): { any }
	local plotsFolder = folder("Plots", map) -- Name wird vom Client gesucht!
	local maxPlots = math.clamp(math.floor(tonumber((Config :: any).MaxPlots) or 8), 1, 2 * #PLOT_Z)
	local plots = {}
	for _, side in ipairs({ -1, 1 }) do
		for _, z in ipairs(PLOT_Z) do
			local index = #plots + 1
			if index > maxPlots then
				break
			end
			local center = Vector3.new(side * PLOT_X, 0, z)
			-- Eingang (lokales -Z) zeigt zum Band in der Mitte
			local cf = CFrame.lookAt(center, center + Vector3.new(-side, 0, 0))
			table.insert(plots, buildPlot(index, cf, PLOT_COLORS[(index - 1) % #PLOT_COLORS + 1], plotsFolder))
		end
	end
	return plots
end

-- -------------------------------------------------------------------
-- SPAWN-PLATZ (SpawnLocation, Gratis-Zone, Bestenliste, Denkmal)
-- -------------------------------------------------------------------
local function buildPlaza(map: Folder): (CFrame, CFrame, FreeZone)
	local plaza = folder("Plaza", map)

	local floorPart = part({
		Name = "Floor",
		Size = Vector3.new(PLAZA_HALF_X * 2, PLAZA_TOP, PLAZA_MAX_Z - PLAZA_MIN_Z),
		Position = Vector3.new(0, PLAZA_TOP / 2, PLAZA_CENTER.Z),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(205, 212, 225),
		Parent = plaza,
	})
	addGrid(floorPart, 0.8)

	-- Große SpawnLocation mit Leuchtrand
	part({
		Name = "SpawnRim",
		Size = Vector3.new(30, 0.6, 30),
		Position = Vector3.new(0, PLAZA_TOP + 0.3, SPAWN_Z),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(0, 200, 255),
		CastShadow = false,
		Parent = plaza,
	})
	local spawnTop = PLAZA_TOP + 0.8
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(26, 0.8, 26)
	spawn.Position = Vector3.new(0, spawnTop - 0.4, SPAWN_Z)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Color = Color3.fromRGB(255, 200, 60)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.AllowTeamChangeOnTouch = false
	spawn.Parent = plaza
	local lobbySpawn = CFrame.lookAt(
		Vector3.new(0, spawnTop + 3.5, SPAWN_Z),
		Vector3.new(0, spawnTop + 3.5, -BELT_LENGTH / 2) -- Blick zum Laufband
	)

	-- Gratis-Zone: Landeplatz mit gelb-schwarzem Ring (hier landen Gratis- und Admin-Meteore)
	local zoneCenter = Vector3.new(0, 0, FREE_ZONE_Z)
	disc("FreeZoneRing", zoneCenter, PLAZA_TOP, 0.2, FREE_ZONE_RADIUS * 2 + 6, {
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(255, 205, 40),
		CastShadow = false,
		Parent = plaza,
	})
	disc("FreeZoneEdge", zoneCenter, PLAZA_TOP, 0.25, FREE_ZONE_RADIUS * 2 + 2, {
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(28, 28, 32),
		CastShadow = false,
		Parent = plaza,
	})
	local zoneTop = PLAZA_TOP + 0.3
	local zonePad = disc("FreeZone", zoneCenter, PLAZA_TOP, 0.3, FREE_ZONE_RADIUS * 2, {
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(80, 50, 150),
		CastShadow = false,
		Parent = plaza,
	})
	zonePad:SetAttribute("Radius", FREE_ZONE_RADIUS)
	local zoneSign = anchorPart("FreeZoneSign", CFrame.new(0, 15, FREE_ZONE_Z), plaza)
	worldSign(zoneSign, "Sign", 30, 7, Vector3.zero, 400, {
		{ Name = "Title", Text = "🎁 GRATIS-ZONE 🎁", Color = Color3.fromRGB(120, 255, 120), Height = 0.6 },
		{ Name = "Hint", Text = "👑 Hier landen Admin-Meteore!", Color = WHITE, Height = 0.4 },
	})

	-- Ständer für die Bestenliste (die Tafel selbst baut LeaderboardService an LeaderboardCFrame)
	local boardCF = CFrame.lookAt(LEADERBOARD_POS, Vector3.new(PLAZA_CENTER.X, LEADERBOARD_POS.Y, PLAZA_CENTER.Z))
	local boardBottom = LEADERBOARD_POS.Y - 12
	local standColor = Color3.fromRGB(45, 40, 60)
	part({
		Name = "LeaderboardBase",
		Size = Vector3.new(42, boardBottom - PLAZA_TOP, 6),
		CFrame = boardCF * CFrame.new(0, -12 - (boardBottom - PLAZA_TOP) / 2, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = standColor,
		Parent = plaza,
	})
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "LeaderboardPillar",
			Size = Vector3.new(2, 26, 2),
			CFrame = boardCF * CFrame.new(s * 19.5, 1, 0),
			Material = Enum.Material.SmoothPlastic,
			Color = standColor,
			Parent = plaza,
		})
	end
	part({
		Name = "LeaderboardCap",
		Size = Vector3.new(42, 1.2, 3),
		CFrame = boardCF * CFrame.new(0, 14.6, 0),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 190, 40),
		CastShadow = false,
		Parent = plaza,
	})

	-- Meteor-Denkmal (Gegenstück zur Bestenliste)
	disc("MonumentBase", MONUMENT_POS, PLAZA_TOP, 3, 14, {
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(90, 90, 105),
		Parent = plaza,
	})
	local rockCenter = MONUMENT_POS + Vector3.new(0, 3 + 5, 0)
	part({
		Name = "MonumentRock",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(10, 10, 10),
		Position = rockCenter,
		Material = Enum.Material.CrackedLava,
		Color = Color3.fromRGB(110, 70, 60),
		Parent = plaza,
	})
	part({
		Name = "MonumentRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 17, 17),
		CFrame = CFrame.new(rockCenter) * CFrame.Angles(math.rad(20), 0, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 140, 40),
		CanCollide = false,
		CastShadow = false,
		Parent = plaza,
	})

	return lobbySpawn, boardCF, { Center = Vector3.new(0, zoneTop, FREE_ZONE_Z), Radius = FREE_ZONE_RADIUS }
end

-- -------------------------------------------------------------------
-- LAUFBAND-ZONE (Treadmills zum Schritte-Farmen)
-- -------------------------------------------------------------------
-- Ein Laufband: lokales -Z = Laufrichtung des Spielers, vorne Konsole + Bogen mit Schild.
-- Das Band schiebt den Spieler nach hinten (+Z lokal) -> man muss laufen, um draufzubleiben.
local function buildTreadmill(def: TreadmillDef, order: number, total: number, base: CFrame, parent: Instance)
	local model = Instance.new("Model")
	model.Name = def.Id
	model:SetAttribute("TreadmillId", def.Id)
	model:SetAttribute("Order", order)
	model:SetAttribute("Required", def.Required)
	model:SetAttribute("Rate", def.Rate)

	local color = def.Color
	local material = TREADMILL_MATERIALS[def.Id] or Enum.Material.Metal
	local topTier = order > total - 3 -- die obersten 3 Stufen leuchten extra

	local function glowPart(props): Part
		props.Material = Enum.Material.Neon
		props.Color = color
		props.CastShadow = false
		props.Parent = model
		local p = part(props)
		if def.Rainbow then
			p:SetAttribute("Rainbow", true) -- Client färbt durch
		end
		return p
	end

	part({
		Name = "Chassis",
		Size = Vector3.new(10.4, 0.6, 22),
		CFrame = base * CFrame.new(0, 0.3, 0),
		Material = material,
		Color = color:Lerp(Color3.new(0, 0, 0), 0.35),
		Parent = model,
	})
	local belt = part({
		Name = "Belt",
		Size = Vector3.new(8, 0.3, 20),
		CFrame = base * CFrame.new(0, 0.65, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(32, 32, 38),
		Parent = model,
	})
	local backward = -base.LookVector
	belt:SetAttribute("BeltDir", backward)
	belt:SetAttribute("BeltSpeed", TREADMILL_PUSH)
	table.insert(pendingVelocities, { Part = belt, Velocity = backward * TREADMILL_PUSH })
	model.PrimaryPart = belt

	-- Leuchtende Seitenrahmen
	for _, s in ipairs({ -1, 1 }) do
		glowPart({
			Name = "SideFrame",
			Size = Vector3.new(1.2, 0.9, 21),
			CFrame = base * CFrame.new(s * 4.6, 1.05, 0),
		})
	end

	-- Konsole vorne (man läuft dagegen) + unsichtbare Stoppwand gegen Drüberspringen
	part({
		Name = "Console",
		Size = Vector3.new(8, 3.6, 1.2),
		CFrame = base * CFrame.new(0, 2.4, -10.6),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(40, 40, 48),
		Parent = model,
	})
	local screen = glowPart({
		Name = "Screen",
		Size = Vector3.new(5, 1.4, 0.15),
		CFrame = base * CFrame.new(0, 3.2, -9.925),
		CanCollide = false,
	})
	screen.CanQuery = false
	part({
		Name = "FrontStop",
		Size = Vector3.new(8.4, 12, 0.6),
		CFrame = base * CFrame.new(0, 6, -10.5),
		Transparency = 1,
		CastShadow = false,
		Parent = model,
	})

	-- Bogen: jede Stufe etwas höher (sieht aus wie eine Treppe von Holz bis Regenbogen)
	local archHeight = 8 + (order - 1) * 1.2
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "Pillar",
			Size = Vector3.new(1.2, archHeight, 1.2),
			CFrame = base * CFrame.new(s * 5.6, archHeight / 2, -11.6),
			Material = material,
			Color = color,
			Parent = model,
		})
	end
	local beam = glowPart({
		Name = "Arch",
		Size = Vector3.new(12.4, 1.2, 1.2),
		CFrame = base * CFrame.new(0, archHeight + 0.6, -11.6),
	})
	if topTier then
		addLight(beam, color, 18, 1.6)
	end

	local unlocked = def.Required <= 0
	worldSign(beam, "Sign", 14, 5.2, Vector3.new(0, 3.4, 0), 160, {
		{ Name = "NameLabel", Text = def.Name, Color = color:Lerp(WHITE, 0.45), Height = 0.42 },
		{
			Name = "RateLabel",
			Text = "+" .. Util.FormatNumber(def.Rate) .. " 👟",
			Color = Color3.fromRGB(255, 230, 90),
			Height = 0.3,
		},
		{
			Name = "LockLabel",
			Text = unlocked and "✅ Für alle frei" or ("🔒 ab " .. Util.FormatNumber(def.Required) .. " 👟"),
			Color = unlocked and Color3.fromRGB(120, 255, 120) or Color3.fromRGB(255, 130, 130),
			Height = 0.28,
		},
	})

	model.Parent = parent
	return model
end

local function buildTreadmills(map: Folder): (Folder, CFrame)
	local zone = folder("TreadmillZone", map) -- Deko (Boden, Schild)
	local treadmills = folder("Treadmills", map) -- NUR die Laufband-Models
	local defs = treadmillDefs()
	local count = #defs

	local deckWidth = math.max(1, count - 1) * TREADMILL_SPACING + 10.4 + 16
	local deckDepth = TREADMILL_DECK_MAX_Z - TREADMILL_DECK_MIN_Z
	local deckCenterZ = (TREADMILL_DECK_MAX_Z + TREADMILL_DECK_MIN_Z) / 2
	local deck = part({
		Name = "Deck",
		Size = Vector3.new(deckWidth, TREADMILL_DECK_TOP - PLAZA_TOP, deckDepth),
		Position = Vector3.new(0, (TREADMILL_DECK_TOP + PLAZA_TOP) / 2, deckCenterZ),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(55, 65, 95),
		Parent = zone,
	})
	addGrid(deck, 0.85)
	part({
		Name = "DeckGlow",
		Size = Vector3.new(deckWidth, 0.2, 0.6),
		Position = Vector3.new(0, TREADMILL_DECK_TOP - 0.05, TREADMILL_DECK_MAX_Z - 0.3),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(0, 200, 255),
		CanCollide = false,
		CastShadow = false,
		Parent = zone,
	})
	local zoneSign = anchorPart("ZoneSign", CFrame.new(0, 30, TREADMILL_DECK_MIN_Z + 4), zone)
	worldSign(zoneSign, "Sign", 56, 11, Vector3.zero, 500, {
		{ Name = "Title", Text = "🏃 LAUFBÄNDER 👟", Color = Color3.fromRGB(255, 220, 60), Height = 0.6 },
		{ Name = "Hint", Text = "Drauf laufen = Schritte = schneller!", Color = WHITE, Height = 0.4 },
	})

	for order, def in ipairs(defs) do
		local x = (order - (count + 1) / 2) * TREADMILL_SPACING
		local origin = Vector3.new(x, TREADMILL_DECK_TOP, TREADMILL_BELT_Z)
		-- Laufrichtung des Spielers = -Z (weg vom Platz), Einstieg von der Platzseite
		local base = CFrame.lookAt(origin, origin - Vector3.zAxis)
		buildTreadmill(def, order, count, base, treadmills)
	end

	local spawnY = TREADMILL_DECK_TOP + 3.5
	local spawnCF =
		CFrame.lookAt(Vector3.new(0, spawnY, TREADMILL_DECK_MAX_Z - 5), Vector3.new(0, spawnY, TREADMILL_BELT_Z))
	treadmills:SetAttribute("SpawnCFrame", spawnCF)
	return treadmills, spawnCF
end

-- -------------------------------------------------------------------
-- DEKO (Bäume, Büsche, Zaun) – bewusst sparsam
-- -------------------------------------------------------------------
local function tree(parent: Instance, x: number, z: number, scale: number, color: Color3)
	local trunkHeight = 7 * scale
	local trunkWidth = 1.6 * scale
	part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkHeight, trunkWidth, trunkWidth),
		CFrame = CFrame.new(x, trunkHeight / 2, z) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(125, 85, 55),
		Parent = parent,
	})
	local leaves = 9 * scale
	part({
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(leaves, leaves, leaves),
		Position = Vector3.new(x, trunkHeight + leaves * 0.3, z),
		Material = Enum.Material.Plastic,
		Color = color,
		CanCollide = false,
		Parent = parent,
	})
end

local function bush(parent: Instance, x: number, z: number, size: number)
	part({
		Name = "Bush",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size, size, size),
		Position = Vector3.new(x, size * 0.25, z),
		Material = Enum.Material.Plastic,
		Color = BUSH_COLOR,
		CanCollide = false,
		CastShadow = false,
		Parent = parent,
	})
end

local function buildFence(parent: Instance)
	local color = Color3.fromRGB(245, 240, 228)
	-- Ecken im Kreis, damit jeder Eckpfosten nur einmal gebaut wird
	local corners = {
		Vector3.new(-EDGE_X, 0, EDGE_MIN_Z),
		Vector3.new(EDGE_X, 0, EDGE_MIN_Z),
		Vector3.new(EDGE_X, 0, EDGE_MAX_Z),
		Vector3.new(-EDGE_X, 0, EDGE_MAX_Z),
	}
	for i, a in ipairs(corners) do
		local b = corners[i % #corners + 1]
		local length = (b - a).Magnitude
		local sideCF = CFrame.lookAt((a + b) / 2, b)
		for _, height in ipairs({ 1.4, 2.8 }) do
			part({
				Name = "FenceRail",
				Size = Vector3.new(0.5, 0.5, length),
				CFrame = sideCF + Vector3.new(0, height, 0),
				Material = Enum.Material.Wood,
				Color = color,
				CastShadow = false,
				Parent = parent,
			})
		end
		local posts = math.max(1, math.floor(length / 55 + 0.5))
		for p = 0, posts - 1 do
			local pos = a:Lerp(b, p / posts)
			part({
				Name = "FencePost",
				Size = Vector3.new(1, 3.8, 1),
				Position = pos + Vector3.new(0, 1.9, 0),
				Material = Enum.Material.Wood,
				Color = color,
				CastShadow = false,
				Parent = parent,
			})
		end
	end
end

local function buildDeco(map: Folder)
	local deco = folder("Deco", map)
	local rng = Random.new(20261003) -- fester Seed: jeder Server sieht gleich aus
	local function treeColor(): Color3
		return TREE_COLORS[rng:NextInteger(1, #TREE_COLORS)]
	end

	buildFence(deco)

	-- Bäume AUSSERHALB des Zauns (Horizont), gleichmäßig verteilt
	local strips = {
		{ -195, -160, EDGE_MIN_Z, EDGE_MAX_Z, 7, true },
		{ 160, 195, EDGE_MIN_Z, EDGE_MAX_Z, 7, true },
		{ -140, 140, EDGE_MAX_Z + 10, EDGE_MAX_Z + 40, 5, false },
		{ -140, 140, EDGE_MIN_Z - 40, EDGE_MIN_Z - 10, 5, false },
	}
	for _, strip in ipairs(strips) do
		local x0, x1, z0, z1, count, alongZ = strip[1], strip[2], strip[3], strip[4], strip[5], strip[6]
		for i = 1, count do
			local t = (i - 1 + rng:NextNumber(0.2, 0.8)) / count
			local x, z
			if alongZ then
				x = rng:NextNumber(x0, x1)
				z = z0 + (z1 - z0) * t
			else
				x = x0 + (x1 - x0) * t
				z = rng:NextNumber(z0, z1)
			end
			tree(deco, x, z, rng:NextNumber(1.1, 1.6), treeColor())
		end
	end

	-- Hinter den Basen (zwischen Rückwand und Zaun)
	for _, s in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -130, 0, 130 }) do
			tree(deco, s * rng:NextNumber(120, 138), z + rng:NextNumber(-12, 12), rng:NextNumber(0.9, 1.2), treeColor())
		end
		for _, z in ipairs({ -65, 65, 180 }) do
			bush(deco, s * rng:NextNumber(115, 140), z, rng:NextNumber(4, 6))
		end
	end

	-- Am Bandende (+Z)
	for _, s in ipairs({ -1, 1 }) do
		tree(deco, s * 60, 240, 1.1, treeColor())
		tree(deco, s * 120, 236, 1, treeColor())
		bush(deco, s * 35, 242, 5)
		bush(deco, s * 90, 246, 4.5)
	end

	-- Spawn-Platz: Ecken + Ränder
	for _, s in ipairs({ -1, 1 }) do
		tree(deco, s * 108, PLAZA_MIN_Z + 10, 1.2, treeColor())
		tree(deco, s * 108, PLAZA_MAX_Z - 12, 1.1, treeColor())
		bush(deco, s * 112, -335, 5)
		bush(deco, s * 112, -275, 5.5)
		bush(deco, s * 70, PLAZA_MIN_Z + 6, 4.5)
	end

	-- Zwischen Platz und Basen
	for _, s in ipairs({ -1, 1 }) do
		bush(deco, s * 60, -195, 4.5)
		bush(deco, s * 98, -210, 5)
	end
end

-- -------------------------------------------------------------------
-- ÖFFENTLICH
-- -------------------------------------------------------------------
-- Baut die komplette Map in workspace.MeteorHeistMap (alte Map/Baseplate/SpawnLocations werden entfernt).
function MapBuilder.Build(): MapResult
	clearOld()
	table.clear(pendingVelocities)

	local map = Instance.new("Folder")
	map.Name = "MeteorHeistMap"

	buildGround(map)
	local belt = buildBelt(map)
	local plots = buildPlots(map)
	local lobbySpawn, leaderboardCF, freeZone = buildPlaza(map)
	local treadmillsFolder, treadmillSpawn = buildTreadmills(map)
	buildDeco(map)

	map.Parent = workspace

	-- Erst im Workspace: Förderband-Geschwindigkeiten setzen (verankerte Teile schieben Spieler)
	for _, item in ipairs(pendingVelocities) do
		item.Part.AssemblyLinearVelocity = item.Velocity
	end
	table.clear(pendingVelocities)

	return {
		MapFolder = map,
		Plots = plots,
		Belt = belt,
		LobbySpawn = lobbySpawn,
		LeaderboardCFrame = leaderboardCF,
		FreeZone = freeZone,
		TreadmillsFolder = treadmillsFolder,
		TreadmillSpawn = treadmillSpawn,
	}
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">MeteorFactory</string>
            <string name="Source"><![CDATA[-- Baut das Aussehen eines Meteors: Größe nach Seltenheit, Licht/Feuer/Funken für seltene,
-- Material/Farbe nach Mutation, Spezial-Effekte der Admin-Meteore, Namensschild darüber.
-- Lichter und Feuer gibt es bewusst sparsam (viele Meteore gleichzeitig = sonst Lag).
-- Dazu: Prompts anlegen (AddPrompt) und serverseitig prüfen, ob lange genug gehalten wurde (OnHeldTrigger).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local MeteorFactory = {}

-- Ab welcher Seltenheit (Index in Config.Rarities) gibt es welchen Effekt?
-- Laufband: es liegen sehr viele Meteore gleichzeitig darauf -> noch sparsamer.
local LIGHT_FROM = { Base = 5, Ground = 5, Belt = 6, Carry = 7 }
local FIRE_FROM = { Base = 7, Ground = 7, Belt = 99, Carry = 99 }
local SPARKLES_FROM = { Base = 6, Ground = 6, Belt = 7, Carry = 99 }
local SHADOW_MIN_SIZE = 3.5 -- nur große Meteore werfen Schatten
local FROST_WHITEN = 0.4 -- Frost-Meteore etwas weißer als die Mutationsfarbe (sonst fast wie Diamond)

local GREEN = Color3.fromRGB(120, 255, 120)
local YELLOW = Color3.fromRGB(255, 230, 90)
local HATCH_COLOR = Color3.fromRGB(255, 220, 120)

function MeteorFactory.GetSize(entry): number
	local def = Config.MeteorsById[entry.Id]
	local rarity = def and Config.RaritiesByName[def.Rarity] or Config.Rarities[1]
	return rarity.Size * (1 + 0.025 * ((entry.Lv or 1) - 1))
end

local function makeLabel(parent: Instance, name: string, order: number, textSize: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, textSize + 4)
	label.LayoutOrder = order
	label.Font = Enum.Font.FredokaOne
	label.TextSize = textSize
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = ""
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label
	label.Parent = parent
	return label
end

-- mode: "Ground"/"Belt" (zeigt Preis), "Base" (Schlüpf-Countdown bzw. Einkommen + Level),
--       "Carry" (getragen: Schlüpfen pausiert)
function MeteorFactory.UpdateLabel(part: BasePart, entry, mode: string, price: number?)
	local gui = part:FindFirstChild("Info")
	if not gui then
		return
	end
	local frame = gui:FindFirstChild("Frame")
	local def = Config.MeteorsById[entry.Id]
	if not frame or not def then
		return
	end
	local nameLabel = frame:FindFirstChild("NameLabel") :: TextLabel?
	local rarityLabel = frame:FindFirstChild("RarityLabel") :: TextLabel?
	local valueLabel = frame:FindFirstChild("ValueLabel") :: TextLabel?
	if not nameLabel or not rarityLabel or not valueLabel then
		return
	end
	local rarity = Config.RaritiesByName[def.Rarity]
	local mut = Config.MutationsByName[entry.Mut] or Config.Mutations[1]

	nameLabel.Text = def.Name
	nameLabel.TextColor3 = rarity.Color
	local tag = def.Rarity == "Admin" and "👑 ADMIN" or def.Rarity
	if mut.Name ~= "Normal" then
		-- gleiche Symbole wie an den Aliens und auf der Schlüpf-Karte (Config.Mutations -> Icon)
		tag = (if type(mut.Icon) == "string" then mut.Icon .. " " else "") .. mut.Name .. " • " .. tag
	end
	rarityLabel.Text = tag
	rarityLabel.TextColor3 = mut.Color or rarity.Color
	if mode == "Ground" or mode == "Belt" then
		if price and price <= 0 then
			valueLabel.Text = "🎁 GRATIS!"
			valueLabel.TextColor3 = GREEN
		else
			valueLabel.Text = Util.FormatCash(price or Config.MeteorValue(entry))
			valueLabel.TextColor3 = YELLOW
		end
	elseif entry.Alien == nil then
		-- Noch nicht geschlüpft: der Client zählt über das Attribut "HatchAt" live herunter
		local hatch = math.max(0, tonumber(entry.Hatch) or 0)
		if mode == "Carry" and entry.Hatch == nil then
			-- frisch vom Förderband/Boden geklaut: Countdown startet erst in der Base
			valueLabel.Text = "🏠 Heimbringen! 🐣 " .. Util.FormatTime(Config.HatchTime(entry.Id))
		elseif mode == "Carry" then
			valueLabel.Text = "🐣 ⏸ " .. Util.FormatTime(hatch)
		elseif hatch <= 0 then
			valueLabel.Text = "🐣 Schlüpft..."
		else
			valueLabel.Text = "🐣 Schlüpft in " .. Util.FormatTime(hatch)
		end
		valueLabel.TextColor3 = HATCH_COLOR
	else
		local lv = entry.Lv or 1
		local lvText = lv >= Config.MaxLevel and "MAX" or tostring(lv)
		valueLabel.Text = Util.FormatCash(Config.MeteorIncome(entry)) .. "/s  ⚡Lv " .. lvText
		valueLabel.TextColor3 = GREEN
	end
end

-- Spezial-Effekte (Admin-Meteore): Regenbogen, Umriss, Aura, starkes Licht
local function addSpecialEffects(part: BasePart, def, color: Color3, size: number, mode: string)
	local fx = def.Effects
	if type(fx) ~= "table" then
		return
	end
	if fx.Rainbow then
		part:SetAttribute("Rainbow", true) -- Client färbt lokal durch alle Farben
	end
	if fx.Highlight and mode ~= "Carry" then
		-- startet AUS: der Client schaltet nur die nächsten paar Highlights ein (Roblox-Limit 31)
		local highlight = Instance.new("Highlight")
		highlight.Name = "AdminHighlight"
		highlight.Enabled = false
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.FillColor = color
		highlight.FillTransparency = 0.75
		highlight.OutlineColor = color:Lerp(Color3.new(1, 1, 1), 0.4)
		highlight.OutlineTransparency = 0
		if fx.Rainbow then
			highlight:SetAttribute("Rainbow", true)
		end
		highlight.Adornee = part
		highlight.Parent = part
	end
	if fx.Aura then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Aura"
		emitter.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.6))
		emitter.LightEmission = 1
		emitter.LightInfluence = 0
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, size * 0.12),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(0.8, 1.6)
		emitter.Speed = NumberRange.new(size * 0.4, size * 0.9)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Rate = mode == "Belt" and 12 or 25
		emitter.Parent = part
		if fx.Rainbow then
			emitter:SetAttribute("Rainbow", true)
		end
	end
	if fx.BigLight then
		local light = part:FindFirstChildOfClass("PointLight") or Instance.new("PointLight")
		light.Color = color
		light.Range = 30
		light.Brightness = 3
		light.Shadows = false
		light.Parent = part
		if fx.Rainbow then
			light:SetAttribute("Rainbow", true)
		end
	end
end

-- mode: "Belt" (Laufband), "Ground" (Gratis-Zone/Showcase), "Base" (in der Base), "Carry" (getragen)
function MeteorFactory.Create(entry, mode: string, price: number?): BasePart
	local def = Config.MeteorsById[entry.Id]
	assert(def, "Unbekannter Meteor: " .. tostring(entry.Id))
	local rarity = Config.RaritiesByName[def.Rarity]
	local rarityIndex = Config.RarityIndex[def.Rarity]
	local mut = Config.MutationsByName[entry.Mut] or Config.Mutations[1]
	local size = MeteorFactory.GetSize(entry)
	local isAdmin = rarity.AdminOnly == true

	local part = Instance.new("Part")
	part.Name = "Meteor"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(size, size, size)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = size >= SHADOW_MIN_SIZE and mode ~= "Belt"
	part.Material = isAdmin and Enum.Material.Neon or Enum.Material.Slate
	part.Color = def.Color
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth

	if mut.Name == "Gold" then
		part.Material = Enum.Material.Foil
		part.Color = mut.Color
	elseif mut.Name == "Diamond" then
		-- türkises Glas + Glitzern (unten bei den Effekten) – so sieht man den Unterschied zu Frost
		part.Material = Enum.Material.Glass
		part.Transparency = 0.15
		part.Color = mut.Color
	elseif mut.Name == "Cosmic" or mut.Name == "Lava" then
		-- Cosmic leuchtet lila, Lava glühend orange (+ kleines Feuer, unten bei den Effekten)
		part.Material = Enum.Material.Neon
		part.Color = mut.Color
	elseif mut.Name == "Frost" then
		-- hellblaues Eis: heller und weißlicher als Diamond, dazu fallen Schneeflocken (unten)
		part.Material = Enum.Material.Glass
		part.Transparency = 0.1
		part.Reflectance = 0.15
		part.Color = mut.Color:Lerp(Color3.new(1, 1, 1), FROST_WHITEN)
	elseif mut.Rainbow == true then
		-- Regenbogen: der Client färbt alle Teile mit dem Attribut "Rainbow" lokal durch
		part.Material = Enum.Material.Neon
		part.Color = mut.Color or Color3.new(1, 1, 1)
		part:SetAttribute("Rainbow", true)
	end

	part:SetAttribute("MeteorId", entry.Id)
	part:SetAttribute("Mutation", mut.Name)
	part:SetAttribute("Rarity", def.Rarity)

	-- Leuchten / Feuer / Funken nur für seltene Meteore (siehe Tabellen oben)
	local lightFrom = LIGHT_FROM[mode] or 5
	if rarityIndex >= lightFrom and not isAdmin then
		local light = Instance.new("PointLight")
		light.Color = rarity.Color
		light.Range = 6 + rarityIndex * 1.5
		light.Brightness = 1 + rarityIndex * 0.2
		light.Shadows = false
		light.Parent = part
	end
	if rarityIndex >= (FIRE_FROM[mode] or 99) and not isAdmin then
		local fire = Instance.new("Fire")
		fire.Color = rarity.Color
		fire.SecondaryColor = def.Color
		fire.Size = size * 0.9
		fire.Heat = 4
		fire.Parent = part
	end
	if mut.Name == "Lava" and not part:FindFirstChildOfClass("Fire") then
		-- Lava-Mutation: kleines Feuer. Am Förderband startet es AUS (mit Glück-Events liegen dort
		-- viele Lava-Meteore): der Client schaltet nur die nächsten paar ein (Attribut "LavaFire", WorldFX).
		local fire = Instance.new("Fire")
		fire.Color = mut.Color
		fire.SecondaryColor = Color3.fromRGB(120, 20, 0)
		fire.Size = math.max(1.5, size * 0.45)
		fire.Heat = 3
		if mode == "Belt" then
			fire.Enabled = false
			fire:SetAttribute("LavaFire", true)
		end
		fire.Parent = part
	end
	if mut.Name == "Frost" then
		-- Frost-Mutation: ein paar Schneeflocken rieseln herunter
		local snow = Instance.new("ParticleEmitter")
		snow.Name = "FrostSnow"
		snow.Color = ColorSequence.new(Color3.new(1, 1, 1))
		snow.LightEmission = 0.5
		snow.LightInfluence = 0
		snow.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, math.clamp(size * 0.07, 0.15, 0.45)),
			NumberSequenceKeypoint.new(1, 0),
		})
		snow.Lifetime = NumberRange.new(1, 1.6)
		snow.Speed = NumberRange.new(0.5, 1.5)
		snow.SpreadAngle = Vector2.new(180, 180)
		snow.Acceleration = Vector3.new(0, -4, 0)
		snow.Rate = if mode == "Belt" then 3 else 6
		snow.Parent = part
	end
	local specialMut = mut.Name == "Cosmic" or mut.Name == "Diamond" or mut.Rainbow == true
	if (rarityIndex >= (SPARKLES_FROM[mode] or 99) or (specialMut and mode ~= "Carry")) and not isAdmin then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = mut.Color or rarity.Color
		sparkles.Parent = part
	end
	addSpecialEffects(part, def, part.Color, size, mode)

	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.new(0, 220, 0, 70)
	gui.StudsOffset = Vector3.new(0, size / 2 + 1.8, 0)
	if mode == "Belt" then
		gui.MaxDistance = 45 + rarityIndex * 8 -- viele Schilder am Band: nur in der Nähe zeigen
	elseif mode == "Carry" then
		gui.MaxDistance = 60
	else
		gui.MaxDistance = 70 + rarityIndex * 15
	end
	gui.LightInfluence = 0
	gui.Parent = part

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Parent = frame

	makeLabel(frame, "NameLabel", 1, 20)
	makeLabel(frame, "RarityLabel", 2, 15)
	makeLabel(frame, "ValueLabel", 3, 17)

	MeteorFactory.UpdateLabel(part, entry, mode, price)
	return part
end

-- Passt Größe + Schild an (z.B. nach Level-Änderung durch den Admin)
function MeteorFactory.Refresh(part: BasePart, entry, mode: string)
	local size = MeteorFactory.GetSize(entry)
	local bottom = part.Position.Y - part.Size.Y / 2
	part.Size = Vector3.new(size, size, size)
	part.Position = Vector3.new(part.Position.X, bottom + size / 2, part.Position.Z)
	local gui = part:FindFirstChild("Info")
	if gui and gui:IsA("BillboardGui") then
		gui.StudsOffset = Vector3.new(0, size / 2 + 1.8, 0)
	end
	local fire = part:FindFirstChildOfClass("Fire")
	if fire then
		local mut = Config.MutationsByName[entry.Mut]
		-- Lava-Feuer bleibt klein, Seltenheits-Feuer wächst mit
		local onlyLava = mut ~= nil and mut.Name == "Lava" and fire.Color == mut.Color
		fire.Size = onlyLava and math.max(1.5, size * 0.45) or size * 0.9
	end
	MeteorFactory.UpdateLabel(part, entry, mode)
end

-- distance = optionale Aktivierungs-Reichweite (sonst aus der Größe des Teils)
-- Hinweis: Zwei Prompts am selben Teil (z.B. Klauen + Kaufen am Förderband) bekommen über
-- prompt.UIOffset (Pixel) verschiedene Plätze, sonst liegen sie übereinander.
function MeteorFactory.AddPrompt(
	part: BasePart,
	name: string,
	action: string,
	objectText: string,
	hold: number,
	key: Enum.KeyCode?,
	distance: number?
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = distance or math.max(10, part.Size.X / 2 + 7)
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = key or Enum.KeyCode.E
	prompt.Parent = part
	return prompt
end

-- -------------------------------------------------------------------
-- HALTEN PRÜFEN (gegen "sofort auslösen"-Cheats)
-- "Triggered" schickt der Client. Ein Cheater kann einen Prompt auch ohne Halten auslösen
-- (z.B. HoldDuration lokal auf 0). Deshalb merkt sich der Server, wann der Spieler angefangen
-- hat zu halten (PromptButtonHoldBegan kommt auch auf dem Server an), und ruft callback nur auf,
-- wenn wirklich so lange gehalten wurde, wie die HoldDuration HIER auf dem Server sagt.
-- -------------------------------------------------------------------
local HOLD_TOLERANCE = 0.15 -- Sekunden Spielraum für Netzwerk-Schwankungen
local HOLD_MAX_EXTRA = 3 -- ein Halten zählt höchstens so lange über die HoldDuration hinaus

function MeteorFactory.OnHeldTrigger(prompt: ProximityPrompt, callback: (player: Player) -> ())
	local started: { [Player]: number } = {}
	local ended: { [Player]: number } = {}
	prompt.PromptButtonHoldBegan:Connect(function(player: Player)
		started[player] = os.clock()
		ended[player] = nil
	end)
	prompt.PromptButtonHoldEnded:Connect(function(player: Player)
		-- (kommt evtl. kurz VOR Triggered an -> Zeitpunkt merken statt löschen)
		if started[player] then
			ended[player] = os.clock()
		end
	end)
	prompt.Triggered:Connect(function(player: Player)
		local hold = prompt.HoldDuration
		if hold > 0 then
			local t = os.clock()
			local begin = started[player]
			local release = ended[player]
			started[player] = nil
			ended[player] = nil
			if not begin then
				return -- nie angefangen zu halten
			end
			local heldUntil = if release then math.min(release, t) else t
			if heldUntil - begin < hold - HOLD_TOLERANCE or t - begin > hold + HOLD_MAX_EXTRA then
				return -- zu kurz gehalten (oder ein uraltes Halten)
			end
		end
		callback(player)
	end)
end

return MeteorFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">MeteorService</string>
            <string name="Source"><![CDATA[-- Meteore: das FÖRDERBAND in der Map-Mitte, die Gratis-Zone am Spawn-Platz, Eier am Boden,
-- Meteoritenschauer, EGG RUSH und Server-Glück.
--
-- FÖRDERBAND: jeder Meteor hat ZWEI Knöpfe
--   E halten = KLAUEN (GrabPrompt): gratis, aber man muss ihn selbst nach Hause TRAGEN
--              (CarryService, Source = "Ground"). Klappt das nicht (Bonk, Tod, Falle, zu langsam),
--              fällt er als GRATIS-Ei auf den Boden und jeder kann ihn schnappen.
--   F        = KAUFEN (BuyPrompt): kostet Cash, fliegt automatisch in die eigene Base.
-- EIER AM BODEN ("Drop"): fallen gelassen oder vom Egg Rush – nur E = Schnappen und Tragen.
--
-- PERFORMANCE: Förderband-Meteore werden vom Server EINMAL am Bandstart erzeugt und NIE bewegt.
-- Jeder Client rechnet die Position selbst aus (Attribute BeltT0, BeltSpeed, BeltStart, BeltDir):
--   Position = BeltStart + BeltDir * BeltSpeed * (Serverzeit - BeltT0)
-- Der Server prüft beim Kaufen/Klauen mit genau dieser Formel.
-- METEORITENSCHAUER: Meteore fahren auf zwei Spuren (BeltStart seitlich versetzt), damit wirklich
-- viel mehr aufs Band passen. Jede Spur hat ihren eigenen Mindestabstand.
-- ANTI-CHEAT: Halten wird serverseitig geprüft (MeteorFactory.OnHeldTrigger), Klauen/Kaufen ist
-- pro Spieler gebremst, Eingefrorene (Falle/Admin) können nichts nehmen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))

local MeteorService = {}
local Services

local rng = Random.new()

-- Förderband-Meteore: { Kind = "Belt", Entry, Part, Price, T0, Start, Dir, Speed, Expires, Claimed, ClientReach }
local beltRecords = {}
-- Gratis-Zone/Showcase (Kaufen/Schnappen = fliegt automatisch in die Base):
--   { Kind = "Ground", Entry, Part, Price, Position, Expires, Claimed, Landed, ClientReach }
local groundRecords = {}
-- Eier am Boden zum Schnappen + Tragen (fallen gelassen / Egg Rush):
--   { Kind = "Drop", Entry, Part, Price = 0, Position, Expires, Claimed, Landed, ClientReach, EggRush }
local dropRecords = {}
local beltFolder: Folder
local groundFolder: Folder

-- Warteschlange für Förderband-Meteore (Admin-Regen etc.), damit sie sich nicht überlappen
local beltQueue = {}
-- Letzter Meteor je Spur (für den Mindestabstand). Spur 0 = Bandmitte,
-- -1 / 1 = links / rechts davon (nur im Meteoritenschauer)
local laneLast: { [number]: { T0: number, Radius: number } } = {}
local nextSideLane = 1
local pendingNatural = nil -- schon gewürfelter nächster Meteor, wartet auf Platz
local nextNaturalAt = 0

local BELT_GAP = 0.6 -- Mindestabstand (Studs) zwischen zwei Meteoren auf dem Band
local LANE_MAX_RADIUS = 2.5 -- größere Meteore fahren auch im Schauer in der Bandmitte
-- Toleranz beim Kaufen/Klauen am Band: ENTLANG des Bands großzügig (Ping, der Meteor fährt weiter),
-- QUER zum Band nur wenig mehr als beim Client (sonst klaut man vom eigenen Base-Eingang aus)
local BELT_PROMPT_REACH_EXTRA = 8
local BELT_ACROSS_EXTRA = 4
-- Eier am Boden liegen still: Spielraum nur für die Bewegung des Spielers während der Ping-Zeit
local STATIC_REACH_BASE = 2
local STATIC_REACH_PER_SPEED = 0.1 -- pro Laufgeschwindigkeit
local STATIC_REACH_MIN = 3
local STATIC_REACH_MAX = 10
-- Reichweite am Förderband: wer am Geländer steht, ist ca. 10 Studs von der Bandmitte weg
local BELT_CLIENT_REACH = 15
local FALL_TIME = 0.9 -- so lange fliegt ein Meteor vom Himmel bzw. in die Base (Client-Effekt)
-- Zwei Knöpfe am selben Meteor: Klauen oben, Kaufen darunter (Pixel), sonst liegen sie übereinander
local GRAB_UI_OFFSET = Vector2.new(0, -40)
local BUY_UI_OFFSET = Vector2.new(0, 40)
local RARE_GRAB_ANNOUNCE = Config.RarityIndex.Mythic or 6 -- ab Mythic: allen sagen, wer gerade vom Band klaut
local RARE_SPAWN_ANNOUNCE = Config.RarityIndex.Celestial or 7 -- ab Celestial: "fährt aufs Förderband"
local ADMIN_SPAWN_ANNOUNCE = Config.RarityIndex.Mythic or 6 -- vom Admin bestellte Meteore: schon ab Mythic
local RARE_ANNOUNCE_GAP = 4 -- solche Ansagen höchstens alle 4 Sekunden (sonst ist der Bildschirm voll)
-- Kaufen/Klauen/Schnappen pro Spieler höchstens so oft pro Sekunde (gegen Massen-Auslösen per Cheat)
local actionLimiter = Util.RateLimiter(6, 1)

-- Egg Rush: Eier fallen nacheinander (sieht nach Regen aus) aus dieser Höhe
local EGG_RUSH_SKY = 120
local EGG_RUSH_SPAWN_GAP = 0.08
local EGG_SPOT_TRIES = 30 -- Versuche pro Ei, einen freien Wiesen-Platz zu finden
local EGG_EDGE_MARGIN = 8 -- Abstand zum Map-Rand
local EGG_BELT_CLEARANCE = 12 -- Abstand zur Bandmitte (Geländer, Rahmen)
local EGG_PLOT_MARGIN = 3 -- Abstand zu Basen
local EGG_SPACING = 3 -- Abstand zwischen zwei Eiern
local EGG_RUSH_SHOWER_GAP = 60 -- Egg Rush nicht direkt vor/nach dem Meteoritenschauer
local SHOWER_AFTER_RUSH = 20 -- Schauer wartet, bis der Egg Rush vorbei ist (+ so viele Sekunden)
-- Ersatz-Grenzen, falls die Map keine "Boundary"-Wände hat
local FALLBACK_AREA = { MinX = -150, MaxX = 150, MinZ = -406, MaxZ = 256 }

local serverLuckMult = 1
local serverLuckUntil = 0
local showerUntil = 0
local nextShowerAt = 0
local eggRushUntil = 0
local nextEggRushAt = 0
local lastRareAnnounce = -math.huge

-- -------------------------------------------------------------------
-- GLÜCK & EVENTS
-- -------------------------------------------------------------------
local function now(): number
	return workspace:GetServerTimeNow()
end

local function publishAttributes()
	ReplicatedStorage:SetAttribute("LuckMult", serverLuckMult)
	ReplicatedStorage:SetAttribute("LuckUntil", serverLuckUntil)
	ReplicatedStorage:SetAttribute("ShowerUntil", showerUntil)
	ReplicatedStorage:SetAttribute("NextShowerAt", nextShowerAt)
	ReplicatedStorage:SetAttribute("EggRushUntil", eggRushUntil)
	ReplicatedStorage:SetAttribute("NextEggRushAt", nextEggRushAt)
end

-- Ansage an alle für seltene Eier (Förderband, Klauen) – höchstens alle RARE_ANNOUNCE_GAP Sekunden,
-- überzählige fallen weg (sonst verdrängen sie wichtige eigene Meldungen wie den Diebstahl-Alarm)
local function rareAnnounce(text: string)
	local t = os.clock()
	if t - lastRareAnnounce < RARE_ANNOUNCE_GAP then
		return
	end
	lastRareAnnounce = t
	Services.EconomyService.NotifyAll(text, "Event")
end

function MeteorService.IsShowerActive(): boolean
	return showerUntil > now()
end

function MeteorService.IsEggRushActive(): boolean
	return eggRushUntil > now()
end

function MeteorService.GetLuck(): number
	local luck = 1
	if serverLuckUntil > now() then
		luck *= serverLuckMult
	end
	if MeteorService.IsShowerActive() then
		luck *= Config.ShowerLuck
	end
	return luck
end

-- Verlängert laufendes Glück, statt es zu überschreiben
function MeteorService.AddServerLuck(mult: number, seconds: number)
	local t = now()
	if serverLuckUntil > t and mult <= serverLuckMult then
		serverLuckUntil += seconds
	else
		serverLuckMult = mult
		serverLuckUntil = math.max(serverLuckUntil, t) + seconds
	end
	publishAttributes()
end

function MeteorService.SetServerLuck(mult: number, untilTime: number)
	serverLuckMult = mult
	serverLuckUntil = untilTime
	publishAttributes()
end

function MeteorService.StartShower(duration: number?)
	local t = now()
	showerUntil = math.max(showerUntil, t) + (duration or Config.ShowerDuration)
	nextShowerAt = showerUntil + Config.ShowerInterval
	publishAttributes()
	-- Im Schauer gibt es keine Locks! (Ein gekauftes Base-Schild bleibt aber an.)
	for _, plot in ipairs(Services.PlotService.Plots) do
		if not Services.PlotService.IsShielded(plot) then
			Services.PlotService.SetLocked(plot, 0)
		end
	end
	Services.EconomyService.NotifyAll(
		"🌠 METEORITENSCHAUER! Viel mehr Meteore, keine Locks, " .. Config.ShowerLuck .. "x Glück!",
		"Event"
	)
end

-- -------------------------------------------------------------------
-- ZUFALL
-- -------------------------------------------------------------------
function MeteorService.RollRarity(luck: number)
	return Util.WeightedPick(Config.Rarities, function(rarity)
		if rarity.AdminOnly or #Config.MeteorsByRarity[rarity.Name] == 0 then
			return 0
		end
		local index = Config.RarityIndex[rarity.Name]
		return index >= 3 and rarity.Weight * luck or rarity.Weight
	end, rng)
end

function MeteorService.RollMutation(luck: number): string
	local mut = Util.WeightedPick(Config.Mutations, function(m)
		return m.Name == "Normal" and m.Weight or m.Weight * luck
	end, rng)
	return mut.Name
end

-- Zufälliger Meteor einer Seltenheit (nur Förderband-Meteore; includeAll = auch Admin/nicht spawnbare)
function MeteorService.RandomOfRarity(rarityName: string, includeAll: boolean?)
	local list = Config.MeteorsByRarity[rarityName]
	if (not list or #list == 0) and includeAll then
		list = Config.MeteorsByRarityAll[rarityName]
	end
	if not list or #list == 0 then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

function MeteorService.RandomAdminMeteor()
	local list = Config.AdminMeteors
	if #list == 0 then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

-- Neuer (noch nicht gekaufter) Eintrag – Hatch/Alien kommen erst in der Base dazu
function MeteorService.RollEntry(luck: number?)
	local l = luck or MeteorService.GetLuck()
	local rarity = MeteorService.RollRarity(l)
	local def = MeteorService.RandomOfRarity(rarity.Name) or Config.Meteors[1]
	return { Id = def.Id, Mut = MeteorService.RollMutation(l), Lv = 1, Xp = 0 }
end

-- opts: { Id?, Mut?, Rarity? } -> Eintrag (oder nil, wenn es die Seltenheit nicht gibt)
local function makeEntry(opts)
	local entry
	local luck = MeteorService.GetLuck()
	if opts.Id and Config.MeteorsById[opts.Id] then
		entry = { Id = opts.Id, Mut = opts.Mut or MeteorService.RollMutation(luck), Lv = 1, Xp = 0 }
	elseif opts.Rarity and Config.RaritiesByName[opts.Rarity] then
		local def = MeteorService.RandomOfRarity(opts.Rarity, true)
		if not def then
			return nil
		end
		entry = { Id = def.Id, Mut = opts.Mut or MeteorService.RollMutation(luck), Lv = 1, Xp = 0 }
	else
		entry = MeteorService.RollEntry(luck)
	end
	if not Config.MutationsByName[entry.Mut] then
		entry.Mut = "Normal"
	end
	return entry
end

-- -------------------------------------------------------------------
-- FÖRDERBAND – Grundlagen
-- -------------------------------------------------------------------
local beltWarned = false

-- Förderband-Daten (von MapBuilder über PlotService, sonst aus den Attributen des Belt-Parts)
local function getBelt()
	local belt = Services.PlotService.Belt
	if belt and belt.Start and belt.Dir and belt.Length then
		return belt
	end
	local map = Services.PlotService.MapFolder
	local part = map and map:FindFirstChild("Belt")
	if part and part:IsA("BasePart") then
		local start = part:GetAttribute("BeltStart")
		local dir = part:GetAttribute("BeltDir")
		local length = part:GetAttribute("BeltLength")
		if typeof(start) == "Vector3" and typeof(dir) == "Vector3" and type(length) == "number" then
			belt = { Part = part, Start = start, Dir = dir.Unit, Length = length, Width = part.Size.X }
			Services.PlotService.Belt = belt
			return belt
		end
	end
	if not beltWarned then
		beltWarned = true
		warn("[MeteorService] Kein Förderband gefunden – Meteore können nicht spawnen!")
	end
	return nil
end

function MeteorService.BeltPosition(record): Vector3
	return record.Start + record.Dir * record.Speed * (now() - record.T0)
end

local function listFor(kind: string)
	if kind == "Belt" then
		return beltRecords
	elseif kind == "Drop" then
		return dropRecords
	end
	return groundRecords
end

local function removeRecord(record)
	local list = listFor(record.Kind)
	local index = table.find(list, record)
	if index then
		table.remove(list, index)
	end
	if record.Part then
		record.Part:Destroy()
		record.Part = nil
	end
end

local function currentPosition(record): Vector3?
	if not record.Part then
		return nil
	end
	if record.Kind == "Belt" then
		return MeteorService.BeltPosition(record)
	end
	return record.Position
end

-- -------------------------------------------------------------------
-- KAUFEN / KLAUEN / SCHNAPPEN (alles serverseitig geprüft)
-- -------------------------------------------------------------------
local function aliveRoot(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return root
end

-- Eingefroren (Falle / Admin-Freeze = HumanoidRootPart verankert)? Dann wird nichts genommen.
local function isFrozen(player: Player, root: BasePart): boolean
	if root.Anchored then
		Services.EconomyService.Notify(player, "🧊 Du bist eingefroren!", "Error")
		return true
	end
	return false
end

-- Liegt diese Stelle in einer gesperrten Base (Lock oder Base-Schild)? -> diese Base, sonst nil
local function lockedPlotAt(position: Vector3)
	local Plot = Services.PlotService
	for _, plot in ipairs(Plot.Plots) do
		if plot.Owner and Plot.IsInside(plot, position) and Plot.IsLocked(plot) then
			return plot
		end
	end
	return nil
end

-- Steht der Spieler nah genug dran (analytisch, mit Toleranz) und hat sich nicht unmöglich schnell
-- bewegt? Gibt die aktuelle Meteor-Position zurück, sonst nil (Hinweis wurde dann schon geschickt).
local function checkReach(player: Player, record, root: BasePart): Vector3?
	local position = currentPosition(record)
	if not position then
		return nil
	end
	-- Grundlage: gleiche Reichweite wie beim Client (ClientMaxDistance)
	local clientReach = record.ClientReach or 10
	local offset = root.Position - position
	local tooFar
	if record.Kind == "Belt" then
		-- entlang des Bands großzügig (der Meteor fährt während der Ping-Zeit weiter),
		-- quer zum Band nur wenig mehr als beim Client
		local along = offset:Dot(record.Dir)
		local across = (offset - record.Dir * along).Magnitude
		tooFar = math.abs(along) > clientReach + BELT_PROMPT_REACH_EXTRA + record.Speed * 0.5
			or across > clientReach + BELT_ACROSS_EXTRA
	else
		-- liegt still: nur Spielraum für die eigene Bewegung (schnelle Spieler etwas mehr)
		local character = root.Parent
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local walkSpeed = if humanoid then humanoid.WalkSpeed else Config.NormalWalkSpeed
		local extra =
			math.clamp(STATIC_REACH_BASE + walkSpeed * STATIC_REACH_PER_SPEED, STATIC_REACH_MIN, STATIC_REACH_MAX)
		tooFar = offset.Magnitude > clientReach + extra
	end
	if tooFar then
		Services.EconomyService.Notify(player, "🏃 Zu weit weg – lauf näher ran!", "Error")
		return nil
	end
	-- Die Position kommt vom Client: wer gerade unmöglich weit "gesprungen" ist (Teleport-Exploit),
	-- darf nicht kaufen/klauen. (Server-Teleports wie Home sind erlaubt, danach kurz warten.)
	if Services.CarryService.MoveStatus(player) ~= "ok" then
		Services.EconomyService.Notify(player, "⏳ Kurz warten und nochmal versuchen!", "Error")
		return nil
	end
	return position
end

-- KAUFEN (Förderband, F) / Schnappen in der Gratis-Zone: fliegt AUTOMATISCH in einen freien Slot
local function tryClaim(player: Player, record)
	if record.Claimed or not record.Part or record.Landed == false then
		return
	end
	if not actionLimiter.Check(player) then
		return -- zu viele Versuche auf einmal (Cheat) -> still ignorieren
	end
	local data = Services.DataService.Get(player)
	if not data or not Services.EconomyService.IsReady(player) then
		return
	end
	local root = aliveRoot(player)
	if not root or isFrozen(player, root) then
		return
	end
	local position = checkReach(player, record, root)
	if not position then
		return
	end
	local plot = Services.PlotService.GetPlot(player)
	if not plot then
		Services.EconomyService.Notify(player, "Du hast keine Base auf diesem Server.", "Error")
		return
	end
	local slot = Services.PlotService.FreeSlot(player)
	if not slot then
		Services.EconomyService.Notify(player, "📦 Deine Base ist voll! Verkaufe erst etwas.", "Error")
		return
	end
	local def = Config.MeteorsById[record.Entry.Id]
	if record.Price > 0 then
		-- Rebirth-Anforderung gilt nur fürs KAUFEN – klauen geht immer
		local rarity = Config.RaritiesByName[def.Rarity]
		local required = rarity.RequiredRebirths or 0
		if data.Rebirths < required then
			Services.EconomyService.Notify(
				player,
				"🔥 " .. def.Rarity .. " braucht " .. required .. " Rebirth(s) zum Kaufen – aber klauen geht! 😈",
				"Error"
			)
			return
		end
		if data.Cash < record.Price then
			Services.EconomyService.Notify(
				player,
				"💸 Nicht genug Cash! Du brauchst "
					.. Util.FormatCash(record.Price)
					.. " – oder klau ihn gratis! 😈",
				"Error"
			)
			return
		end
		data.Cash -= record.Price
		data.Stats.Bought += 1
	end
	record.Claimed = true
	local entry = record.Entry
	removeRecord(record)
	Services.EconomyService.DeliverMeteor(player, plot, slot, entry, position)
	Services.EconomyService.Notify(
		player,
		(record.Price > 0 and "✅ Gekauft: " or "🎁 Geschnappt: ") .. def.Name .. "! Gleich schlüpft ein Alien 🐣",
		"Success"
	)
end

-- KLAUEN vom Förderband (E) / Schnappen eines Eis am Boden: gratis, aber selbst nach Hause tragen
local function tryGrab(player: Player, record)
	if record.Claimed or not record.Part or record.Landed == false then
		return
	end
	if not actionLimiter.Check(player) then
		return -- zu viele Versuche auf einmal (Cheat) -> still ignorieren
	end
	local data = Services.DataService.Get(player)
	if not data or not Services.EconomyService.IsReady(player) then
		return
	end
	local root = aliveRoot(player)
	if not root or isFrozen(player, root) then
		return
	end
	if Services.CarryService.IsCarrying(player) then
		Services.EconomyService.Notify(player, "🎒 Du trägst schon etwas – erst nach Hause bringen!", "Error")
		return
	end
	local plot = Services.PlotService.GetPlot(player)
	if not plot then
		Services.EconomyService.Notify(player, "Du hast keine Base auf diesem Server.", "Error")
		return
	end
	if not Services.PlotService.FreeSlot(player) then
		Services.EconomyService.Notify(player, "📦 Deine Base ist voll! Verkaufe erst etwas.", "Error")
		return
	end
	if record.Kind == "Drop" then
		-- Ei liegt in einer gesperrten Base (Lock / Base-Schild): nur der Besitzer darf es nehmen
		local lockedPlot = lockedPlotAt(record.Position)
		if lockedPlot and lockedPlot.Owner ~= player then
			Services.EconomyService.Notify(player, "🔒 Das Ei liegt in einer gesperrten Base!", "Error")
			return
		end
	end
	local position = checkReach(player, record, root)
	if not position then
		return
	end
	record.Claimed = true
	local entry = record.Entry
	local fromBelt = record.Kind == "Belt"
	removeRecord(record)
	Services.CarryService.StartCarry(player, entry, {
		Source = "Ground",
		From = fromBelt and "Belt" or "Drop",
		GrabPosition = position,
	})
	local def = Config.MeteorsById[entry.Id]
	if fromBelt and def and Config.RarityIndex[def.Rarity] >= RARE_GRAB_ANNOUNCE then
		local mut = entry.Mut ~= "Normal" and (entry.Mut .. " ") or ""
		rareAnnounce(
			"😈 "
				.. player.DisplayName
				.. " klaut "
				.. def.Rarity
				.. " "
				.. mut
				.. def.Name
				.. " vom Band – BONK IHN! 🔨"
		)
	end
end

-- -------------------------------------------------------------------
-- PROMPTS
-- -------------------------------------------------------------------
-- Förderband: E = Klauen (gratis, tragen), F = Kaufen (automatische Lieferung)
local function attachBeltPrompts(record, serverReach: number)
	local part: BasePart = record.Part
	local def = Config.MeteorsById[record.Entry.Id]
	local radius = part.Size.X / 2
	-- man steht hinter dem Geländer -> größere Reichweite als am Boden
	local clientReach = math.max(BELT_CLIENT_REACH, radius + 10)
	record.ClientReach = clientReach

	local grab = MeteorFactory.AddPrompt(
		part,
		"GrabPrompt",
		"Klauen",
		def.Name,
		Config.BeltGrabHold,
		Enum.KeyCode.E,
		serverReach
	)
	grab.GamepadKeyCode = Enum.KeyCode.ButtonX
	grab.UIOffset = GRAB_UI_OFFSET
	-- Der Client stellt die echte Reichweite lokal ein (die Server-Reichweite ist absichtlich riesig,
	-- weil der Meteor auf dem Server am Bandstart bleibt).
	grab:SetAttribute("ClientMaxDistance", clientReach)
	-- gratis -> der Server prüft, ob wirklich so lange gehalten wurde
	MeteorFactory.OnHeldTrigger(grab, function(player)
		tryGrab(player, record)
	end)

	local action = record.Price > 0 and ("Kaufen " .. Util.FormatCash(record.Price)) or "🎁 Gratis holen"
	local buy = MeteorFactory.AddPrompt(
		part,
		"BuyPrompt",
		action,
		def.Name .. " (" .. def.Rarity .. ")",
		Config.BeltBuyHold,
		Enum.KeyCode.F,
		serverReach
	)
	buy.GamepadKeyCode = Enum.KeyCode.ButtonY
	buy.UIOffset = BUY_UI_OFFSET
	buy:SetAttribute("ClientMaxDistance", clientReach)
	buy.Triggered:Connect(function(player)
		tryClaim(player, record)
	end)
end

-- Gratis-Zone / Showcase: E = Kaufen bzw. Schnappen (automatische Lieferung)
local function attachClaimPrompt(record)
	local def = Config.MeteorsById[record.Entry.Id]
	local action = record.Price > 0 and ("Kaufen " .. Util.FormatCash(record.Price)) or "🎁 Schnappen (GRATIS)"
	local reach = math.max(10, record.Part.Size.X / 2 + 7)
	record.ClientReach = reach
	local prompt = MeteorFactory.AddPrompt(
		record.Part,
		"BuyPrompt",
		action,
		def.Name .. " (" .. def.Rarity .. ")",
		Config.GrabHoldDuration,
		Enum.KeyCode.E,
		reach
	)
	prompt:SetAttribute("ClientMaxDistance", reach)
	prompt.Enabled = record.Landed ~= false
	local function onClaim(player: Player)
		tryClaim(player, record)
	end
	if record.Price > 0 then
		prompt.Triggered:Connect(onClaim) -- wer bezahlt, braucht keine Halte-Prüfung
	else
		MeteorFactory.OnHeldTrigger(prompt, onClaim) -- gratis -> wirklich halten
	end
	return prompt
end

-- Ei am Boden: nur E = Schnappen (dann selbst nach Hause tragen)
local function attachDropPrompt(record)
	local def = Config.MeteorsById[record.Entry.Id]
	local reach = math.max(10, record.Part.Size.X / 2 + 7)
	record.ClientReach = reach
	local prompt = MeteorFactory.AddPrompt(
		record.Part,
		"GrabPrompt",
		"Schnappen",
		def.Name,
		Config.GroundGrabHold,
		Enum.KeyCode.E,
		reach
	)
	prompt:SetAttribute("ClientMaxDistance", reach)
	prompt.Enabled = record.Landed ~= false
	MeteorFactory.OnHeldTrigger(prompt, function(player)
		tryGrab(player, record)
	end)
	return prompt
end

local function enablePrompts(part: BasePart)
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("ProximityPrompt") then
			child.Enabled = true
		end
	end
end

local function announce(entry, text: string)
	local def = Config.MeteorsById[entry.Id]
	local mut = entry.Mut ~= "Normal" and (entry.Mut .. " ") or ""
	Services.EconomyService.NotifyAll(text:format(def.Rarity .. " " .. mut .. def.Name), "Event")
end

-- -------------------------------------------------------------------
-- FÖRDERBAND – Spawnen
-- -------------------------------------------------------------------
-- Legt einen Meteor sofort an den Bandstart der Spur "lane" (ohne Platzprüfung – dafür sorgt die Schleife).
-- lane: 0 = Bandmitte, -1 / 1 = Schauer-Spuren links / rechts
-- shouldAnnounce: nil = natürlicher Meteor (Ansage ab Celestial, gebremst), true = vom Admin bestellt
local function spawnOnBelt(entry, price: number, lane: number, shouldAnnounce: boolean?)
	local belt = getBelt()
	if not belt then
		return nil
	end
	local speed = Config.BeltSpeed
	local size = MeteorFactory.GetSize(entry)
	local radius = size / 2
	local t0 = now()
	local side = belt.Dir:Cross(Vector3.yAxis) -- waagrecht quer zum Band
	local start = belt.Start + Vector3.new(0, radius, 0) + side * (lane * Config.BeltLaneOffset)

	local part = MeteorFactory.Create(entry, "Belt", price)
	part.CFrame = CFrame.new(start)
	-- Attribute VOR dem Parenten setzen -> kommen gleichzeitig beim Client an
	part:SetAttribute("BeltT0", t0)
	part:SetAttribute("BeltSpeed", speed)
	part:SetAttribute("BeltStart", start)
	part:SetAttribute("BeltDir", belt.Dir)

	local record = {
		Kind = "Belt",
		Entry = entry,
		Part = part,
		Price = price,
		T0 = t0,
		Start = start,
		Dir = belt.Dir,
		Speed = speed,
		Expires = t0 + belt.Length / speed,
		Claimed = false,
	}
	table.insert(beltRecords, record)
	-- Server-Reichweite = ganzes Band (siehe attachBeltPrompts), echte Prüfung in checkReach
	attachBeltPrompts(record, belt.Length + 60)
	part.Parent = beltFolder

	laneLast[lane] = { T0 = t0, Radius = radius }

	local def = Config.MeteorsById[entry.Id]
	local index = Config.RarityIndex[def.Rarity]
	if shouldAnnounce == true and index >= ADMIN_SPAWN_ANNOUNCE then
		announce(entry, "☄️ Ein %s fährt aufs Förderband!")
	elseif shouldAnnounce == nil and index >= RARE_SPAWN_ANNOUNCE then
		local mut = entry.Mut ~= "Normal" and (entry.Mut .. " ") or ""
		rareAnnounce("☄️ Ein " .. def.Rarity .. " " .. mut .. def.Name .. " fährt aufs Förderband!")
	end
	return record
end

-- Ist am Bandstart der Spur "lane" genug Platz für einen Meteor mit diesem Radius?
-- Geprüft wird gegen den letzten Meteor JEDER Spur: Kugeln auf Nachbarspuren berühren sich nur,
-- wenn sie seitlich näher sind als ihre Radien zusammen.
local function laneHasRoom(lane: number, radius: number): boolean
	local t = now()
	for otherLane, last in pairs(laneLast) do
		local apart = math.abs(otherLane - lane) * Config.BeltLaneOffset
		local needed = last.Radius + radius + BELT_GAP
		if apart < needed then
			local alongNeeded = math.sqrt(needed * needed - apart * apart)
			if (t - last.T0) * Config.BeltSpeed < alongNeeded then
				return false
			end
		end
	end
	return true
end

-- Freie Spur für einen Meteor mit diesem Radius (nil = gerade kein Platz, kurz warten).
-- Normal: Bandmitte. Im Meteoritenschauer: kleine Meteore abwechselnd links/rechts, große in die Mitte.
local function pickLane(radius: number): number?
	if not MeteorService.IsShowerActive() or radius > LANE_MAX_RADIUS then
		return if laneHasRoom(0, radius) then 0 else nil
	end
	for _ = 1, 2 do
		local lane = nextSideLane
		nextSideLane = -nextSideLane
		if laneHasRoom(lane, radius) then
			return lane
		end
	end
	return nil
end

-- opts: { Id?, Mut?, Rarity?, Free?, Announce? } -> kommt so bald wie möglich aufs Band
-- (Announce = true: allen ansagen, ab Mythic)
function MeteorService.QueueBelt(opts)
	table.insert(beltQueue, opts or {})
end

-- Ein Schritt der Förderband-Schleife: Warteschlange zuerst, dann natürliche Meteore
local function beltStep()
	local t = now()
	-- abgelaufene Meteore (über das Bandende) entfernen. Die Liste ist nach Startzeit sortiert
	-- (gleiches Tempo, gleiche Länge) -> die ältesten stehen vorne, mehr muss man nicht prüfen.
	while beltRecords[1] and t >= beltRecords[1].Expires do
		removeRecord(beltRecords[1])
	end
	local shower = MeteorService.IsShowerActive()
	local cap = if shower then math.max(Config.MaxBeltMeteors, Config.ShowerMaxBeltMeteors) else Config.MaxBeltMeteors
	if #beltRecords >= cap then
		return
	end
	local queued = beltQueue[1]
	if queued then
		if not queued.Entry then
			queued.Entry = makeEntry(queued)
			if not queued.Entry then
				table.remove(beltQueue, 1)
				return
			end
		end
		local lane = pickLane(MeteorFactory.GetSize(queued.Entry) / 2)
		if lane then
			table.remove(beltQueue, 1)
			local price = queued.Free and 0 or math.floor(Config.MeteorValue(queued.Entry))
			-- vom Admin bestellt: Announce true/false, sonst (z.B. Meteorregen) keine Ansage
			spawnOnBelt(queued.Entry, price, lane, queued.Announce == true)
		end
		return
	end
	if #Players:GetPlayers() == 0 then
		return
	end
	if not pendingNatural and t >= nextNaturalAt then
		pendingNatural = MeteorService.RollEntry()
		local interval = if shower then Config.ShowerBeltInterval else Config.BeltSpawnInterval
		nextNaturalAt = t + interval
	end
	if pendingNatural then
		local lane = pickLane(MeteorFactory.GetSize(pendingNatural) / 2)
		if lane then
			local entry = pendingNatural
			pendingNatural = nil
			spawnOnBelt(entry, math.floor(Config.MeteorValue(entry)), lane, nil)
		end
	end
end

-- -------------------------------------------------------------------
-- BODEN: Raycasts
-- -------------------------------------------------------------------
-- Spieler und Meteore ignorieren (die Liste wird bei jedem Aufruf neu gefüllt)
local function rayParams(respectCanCollide: boolean): RaycastParams
	local ignore: { Instance } = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	if beltFolder then
		table.insert(ignore, beltFolder)
	end
	if groundFolder then
		table.insert(ignore, groundFolder)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = respectCanCollide
	return params
end

-- Boden unter einer Position (nur begehbare Teile). Nichts gefunden -> Höhe 0 (Wiese)
local function groundBelow(position: Vector3): Vector3
	local result = workspace:Raycast(position + Vector3.new(0, 3, 0), Vector3.new(0, -80, 0), rayParams(true))
	if result then
		return result.Position
	end
	return Vector3.new(position.X, 0, position.Z)
end

-- -------------------------------------------------------------------
-- EIER AM BODEN (fallen gelassen / Egg Rush)
-- -------------------------------------------------------------------
-- Legt ein Ei auf den Boden. groundPos = Punkt AUF dem Boden.
-- opts: { From: Vector3?, SkyHeight: number?, Lifetime: number?, EggRush: boolean? }
--   From/SkyHeight -> fällt sichtbar dorthin (Client-Effekt "Deliver"), sonst liegt es sofort da
local function spawnDrop(entry, groundPos: Vector3, opts)
	while #dropRecords >= Config.MaxDroppedMeteors do
		removeRecord(dropRecords[1]) -- älteste weg
	end
	local size = MeteorFactory.GetSize(entry)
	local position = Vector3.new(groundPos.X, groundPos.Y + size / 2 + 0.1, groundPos.Z)
	local part = MeteorFactory.Create(entry, "Ground", 0)
	part.CFrame = CFrame.new(position)

	local record = {
		Kind = "Drop",
		Entry = entry,
		Part = part,
		Price = 0,
		Position = position,
		Expires = os.clock() + math.max(1, tonumber(opts.Lifetime) or Config.DroppedLifetime),
		Claimed = false,
		Landed = false,
		EggRush = opts.EggRush == true,
	}
	table.insert(dropRecords, record)
	attachDropPrompt(record)

	local from: Vector3? = opts.From
	if not from and opts.SkyHeight then
		from = position + Vector3.new(0, opts.SkyHeight, 0)
	end
	local function land()
		if record.Part ~= part or record.Claimed then
			return -- schon weg (abgelaufen, Admin hat aufgeräumt ...)
		end
		part.Parent = groundFolder
		record.Landed = true
		enablePrompts(part)
	end
	if from then
		Remotes.Effect:FireAllClients("Deliver", 0, {
			From = from,
			To = position,
			MeteorId = entry.Id,
			Mut = entry.Mut,
		})
		task.delay(FALL_TIME, land)
	else
		land()
	end
	return record
end

-- Stelle über dem Förderband (oder im Geländer)? -> seitlich daneben auf die Wiese schieben.
-- Sonst läge das Ei still auf dem Band, während die anderen Meteore hindurchfahren.
local DROP_BELT_MARGIN = 3 -- so weit neben der Lauffläche zählt noch als "auf dem Band"
local DROP_BELT_GAP = 5 -- so weit neben der Lauffläche landet das Ei (plus sein Radius)
local function offBelt(position: Vector3, radius: number): Vector3
	local belt = getBelt()
	if not belt then
		return position
	end
	local halfWidth = (tonumber(belt.Width) or 14) / 2
	local rel = Vector3.new(position.X - belt.Start.X, 0, position.Z - belt.Start.Z)
	local along = rel:Dot(belt.Dir)
	local sideVec = rel - belt.Dir * along
	local side = sideVec.Magnitude
	if along < -2 or along > belt.Length + 2 or side >= halfWidth + DROP_BELT_MARGIN then
		return position
	end
	local outward = if side > 0.05 then sideVec.Unit else belt.Dir:Cross(Vector3.yAxis).Unit
	local target = belt.Start + belt.Dir * along + outward * (halfWidth + DROP_BELT_GAP + radius)
	return Vector3.new(target.X, position.Y, target.Z)
end

-- Getragenes Ei fällt zu Boden (gebonkt, gestorben, Falle, zu langsam ...). Es liegt dann GRATIS da
-- und JEDER kann es schnappen. position = ungefähre Stelle (der Boden darunter wird gesucht),
-- from = optional: von hier fällt es sichtbar herunter (z.B. über dem Kopf des Trägers).
function MeteorService.DropMeteor(entry, position: Vector3, from: Vector3?)
	if type(entry) ~= "table" or not Config.MeteorsById[entry.Id] or typeof(position) ~= "Vector3" then
		return nil
	end
	local clean = {
		Id = entry.Id,
		Mut = Config.MutationsByName[entry.Mut] and entry.Mut or "Normal",
		Lv = math.clamp(math.floor(tonumber(entry.Lv) or 1), 1, Config.MaxLevel),
		Xp = 0,
		Alien = entry.Alien,
	}
	local spot = offBelt(position, MeteorFactory.GetSize(clean) / 2)
	return spawnDrop(clean, groundBelow(spot), { From = from, Lifetime = Config.DroppedLifetime })
end

-- Spielfläche aus den unsichtbaren Randwänden der Map (sonst Ersatz-Grenzen).
-- Wände links/rechts sind in X dünn, vorne/hinten in Z dünn; gerechnet wird mit den Innenkanten.
local areaCache = nil
local function mapArea()
	if areaCache then
		return areaCache
	end
	local map = Services.PlotService.MapFolder
	local xWalls: { BasePart } = {}
	local zWalls: { BasePart } = {}
	if map then
		for _, child in ipairs(map:GetChildren()) do
			if child.Name == "Boundary" and child:IsA("BasePart") then
				table.insert(child.Size.X < child.Size.Z and xWalls or zWalls, child)
			end
		end
	end
	local area = table.clone(FALLBACK_AREA)
	if #xWalls >= 2 and #zWalls >= 2 then
		table.sort(xWalls, function(a, b)
			return a.Position.X < b.Position.X
		end)
		table.sort(zWalls, function(a, b)
			return a.Position.Z < b.Position.Z
		end)
		local low, high = xWalls[1], xWalls[#xWalls]
		local back, front = zWalls[1], zWalls[#zWalls]
		local candidate = {
			MinX = low.Position.X + low.Size.X / 2,
			MaxX = high.Position.X - high.Size.X / 2,
			MinZ = back.Position.Z + back.Size.Z / 2,
			MaxZ = front.Position.Z - front.Size.Z / 2,
		}
		if candidate.MinX < candidate.MaxX and candidate.MinZ < candidate.MaxZ then
			area = candidate
		end
	end
	areaCache = area
	return area
end

-- Freier Platz auf der Wiese: innerhalb der Map, nicht in/an Basen, nicht am Förderband,
-- nicht auf dem Spawn-Platz/Bäumen (der Strahl muss genau den Wiesenboden "Ground" treffen).
local function findEggSpot(radius: number, groundPart: BasePart, params: RaycastParams): Vector3?
	local area = mapArea()
	local margin = EGG_EDGE_MARGIN + radius
	if area.MaxX - area.MinX <= margin * 2 or area.MaxZ - area.MinZ <= margin * 2 then
		return nil
	end
	local belt = getBelt()
	for _ = 1, EGG_SPOT_TRIES do
		local x = rng:NextNumber(area.MinX + margin, area.MaxX - margin)
		local z = rng:NextNumber(area.MinZ + margin, area.MaxZ - margin)
		local flatPos = Vector3.new(x, 0, z)
		local ok = true
		if belt then
			local rel = flatPos - Vector3.new(belt.Start.X, 0, belt.Start.Z)
			local along = rel:Dot(belt.Dir)
			local side = (rel - belt.Dir * along).Magnitude
			if along > -20 and along < belt.Length + 20 and side < EGG_BELT_CLEARANCE + radius then
				ok = false
			end
		end
		if ok then
			for _, plot in ipairs(Services.PlotService.Plots) do
				local half = (plot.HalfSize or 36) + radius + EGG_PLOT_MARGIN
				local localPos = plot.CFrame:PointToObjectSpace(flatPos)
				if math.abs(localPos.X) <= half and math.abs(localPos.Z) <= half then
					ok = false
					break
				end
			end
		end
		if ok then
			for _, record in ipairs(dropRecords) do
				local other = record.Position
				local otherRadius = record.Part and record.Part.Size.X / 2 or 2
				local dx, dz = other.X - x, other.Z - z
				local minDist = radius + otherRadius + EGG_SPACING
				if dx * dx + dz * dz < minDist * minDist then
					ok = false
					break
				end
			end
		end
		if ok then
			local result = workspace:Raycast(Vector3.new(x, 80, z), Vector3.new(0, -120, 0), params)
			if result and result.Instance == groundPart then
				return result.Position
			end
		end
	end
	return nil
end

-- 🥚 EGG RUSH: Config.EggRushCount Gratis-Eier (3x Glück) regnen auf die ganze Wiese.
-- Läuft schon einer, wird er verlängert und es kommen noch mehr Eier dazu.
-- duration/count optional (Standard aus Config). Gibt die Anzahl der geplanten Eier zurück.
function MeteorService.StartEggRush(duration: number?, count: number?): number
	local t = now()
	local map = Services.PlotService.MapFolder
	local groundPart = map and map:FindFirstChild("Ground")
	if not groundPart or not groundPart:IsA("BasePart") then
		warn("[MeteorService] Egg Rush: Wiesenboden 'Ground' nicht gefunden – keine Eier")
		nextEggRushAt = t + Config.EggRushInterval
		publishAttributes()
		return 0
	end
	local length = math.clamp(tonumber(duration) or Config.EggRushDuration, 5, 600)
	local amount = math.clamp(math.floor(tonumber(count) or Config.EggRushCount), 1, Config.MaxDroppedMeteors)
	eggRushUntil = math.max(eggRushUntil, t + length)
	nextEggRushAt = eggRushUntil + Config.EggRushInterval
	publishAttributes()
	-- Eier eines laufenden Rush bleiben so lange liegen wie der verlängerte Rush
	local clock = os.clock()
	for _, record in ipairs(dropRecords) do
		if record.EggRush then
			record.Expires = math.max(record.Expires, clock + (eggRushUntil - t))
		end
	end
	Services.EconomyService.NotifyAll("🥚 EGG RUSH! Überall liegen Eier – der Schnellste gewinnt!", "Event")

	task.spawn(function()
		-- Bäume/Büsche sollen auch treffen (dann ist dort kein Platz) -> CanCollide nicht beachten
		local params = rayParams(false)
		for _ = 1, amount do
			local remaining = eggRushUntil - now()
			if remaining <= 1 then
				break
			end
			local entry = MeteorService.RollEntry(MeteorService.GetLuck() * Config.EggRushLuck)
			local spot = findEggSpot(MeteorFactory.GetSize(entry) / 2, groundPart, params)
			if spot then
				spawnDrop(entry, spot, { SkyHeight = EGG_RUSH_SKY, Lifetime = remaining, EggRush = true })
			end
			task.wait(EGG_RUSH_SPAWN_GAP)
		end
	end)
	return amount
end

-- -------------------------------------------------------------------
-- GRATIS-ZONE & STATISCHE METEORE (Admin, Showcase)
-- -------------------------------------------------------------------
local function freeZone()
	local zone = Services.PlotService.FreeZone
	local center = zone and zone.Center or Vector3.new(0, 0.2, -264)
	local radius = zone and zone.Radius or 20
	return center, radius
end

local function randomFreeSpot(size: number): Vector3
	local center, radius = freeZone()
	local usable = math.max(1, radius - size / 2 - 1)
	local best = center
	for _ = 1, 12 do
		local angle = rng:NextNumber() * math.pi * 2
		local dist = math.sqrt(rng:NextNumber()) * usable
		local pos = center + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
		local free = true
		for _, record in ipairs(groundRecords) do
			if record.Part and (record.Position - pos).Magnitude < (record.Part.Size.X + size) / 2 + 1 then
				free = false
				break
			end
		end
		best = pos
		if free then
			break
		end
	end
	return best
end

-- Shake + Funken für alle in der Nähe eines Einschlags
local function impactEffect(position: Vector3, size: number, rarityName: string)
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = 0
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Visible = true
	explosion.Parent = workspace
	Remotes.Effect:FireAllClients("Hatch", 0, { Position = position, Rarity = rarityName })
	for _, player in ipairs(Players:GetPlayers()) do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - position).Magnitude < 60 + size * 12 then
			Services.EconomyService.Effect(player, "Shake", math.clamp(size / 6, 0.4, 1.6))
		end
	end
end

-- Statischer Meteor am Boden (Gratis-Zone, vor dem Admin, Showcase).
-- opts: { Id?, Mut?, Rarity?, Position?, Free?, Announce?, Lifetime?, Instant? }
--   Position fehlt -> zufällig in der Gratis-Zone
--   Instant = true -> liegt sofort da; sonst fällt er vom Himmel (Client-Effekt) und schlägt ein
function MeteorService.SpawnStatic(opts)
	opts = opts or {}
	local entry = makeEntry(opts)
	if not entry then
		return nil
	end
	-- Platz schaffen: älteste entfernen, wenn zu viele daliegen
	while #groundRecords >= Config.MaxFreeMeteors do
		removeRecord(groundRecords[1])
	end

	local price = opts.Free and 0 or math.floor(Config.MeteorValue(entry))
	local size = MeteorFactory.GetSize(entry)
	local spot = opts.Position or randomFreeSpot(size)
	local center = freeZone()
	local groundY = opts.Position and opts.Position.Y or center.Y
	local position = Vector3.new(spot.X, groundY + size / 2 + 0.1, spot.Z)
	local part = MeteorFactory.Create(entry, "Ground", price)
	part.CFrame = CFrame.new(position)

	local def = Config.MeteorsById[entry.Id]
	local record = {
		Kind = "Ground",
		Entry = entry,
		Part = part,
		Price = price,
		Position = position,
		Expires = os.clock() + (tonumber(opts.Lifetime) or Config.FreeMeteorLifetime),
		Claimed = false,
		Landed = opts.Instant == true,
	}
	table.insert(groundRecords, record)
	attachClaimPrompt(record)

	if opts.Announce ~= false and Config.RarityIndex[def.Rarity] >= 5 then
		announce(entry, price > 0 and "☄️ Ein %s ist gelandet!" or "🎁 Ein GRATIS %s liegt in der Gratis-Zone!")
	end

	if opts.Instant then
		part.Parent = groundFolder
		return record
	end
	-- Fall-Animation macht der Client ("Deliver" vom Himmel), danach erscheint der echte Meteor
	local sky = position + Vector3.new(rng:NextNumber(-50, 50), 220, rng:NextNumber(-50, 50))
	Remotes.Effect:FireAllClients("Deliver", 0, { From = sky, To = position, MeteorId = entry.Id, Mut = entry.Mut })
	task.delay(FALL_TIME, function()
		if record.Part ~= part or record.Claimed then
			return
		end
		part.Parent = groundFolder
		record.Landed = true
		enablePrompts(part)
		impactEffect(position, size, def.Rarity)
	end)
	return record
end

-- Allgemeiner Spawn (Admin-Panel): opts.Where = "Belt" (Standard), "Free" (Gratis-Zone) oder Position
function MeteorService.SpawnMeteor(opts)
	opts = opts or {}
	if opts.Position or opts.Where == "Free" then
		return MeteorService.SpawnStatic(opts)
	end
	MeteorService.QueueBelt(opts)
	return nil
end

-- Förderband, Gratis-Zone und alle Eier am Boden leeren
function MeteorService.ClearGround()
	for i = #groundRecords, 1, -1 do
		removeRecord(groundRecords[i])
	end
	for i = #dropRecords, 1, -1 do
		removeRecord(dropRecords[i])
	end
	for i = #beltRecords, 1, -1 do
		removeRecord(beltRecords[i])
	end
	table.clear(beltQueue)
	table.clear(laneLast)
	pendingNatural = nil
end

-- -------------------------------------------------------------------
-- EVENT-TIMER (Schauer + Egg Rush, zeitlich versetzt)
-- -------------------------------------------------------------------
local function eventStep()
	local t = now()
	-- Meteoritenschauer: wartet, bis ein laufender Egg Rush vorbei ist
	if not MeteorService.IsShowerActive() and t >= nextShowerAt then
		if MeteorService.IsEggRushActive() then
			nextShowerAt = eggRushUntil + SHOWER_AFTER_RUSH
			publishAttributes()
		else
			MeteorService.StartShower()
		end
	end
	-- Egg Rush: nicht im Schauer und nicht kurz davor (sonst gehen beide Events unter)
	if not MeteorService.IsEggRushActive() and t >= nextEggRushAt then
		local showerSoon = nextShowerAt - t < Config.EggRushDuration + SHOWER_AFTER_RUSH
		if #Players:GetPlayers() == 0 then
			nextEggRushAt = t + 30
			publishAttributes()
		elseif MeteorService.IsShowerActive() or showerSoon then
			local showerEnd = MeteorService.IsShowerActive() and showerUntil or (nextShowerAt + Config.ShowerDuration)
			nextEggRushAt = showerEnd + EGG_RUSH_SHOWER_GAP
			publishAttributes()
		else
			MeteorService.StartEggRush()
		end
	end
end

function MeteorService.Init(services)
	Services = services
	local map = Services.PlotService.MapFolder or workspace
	local function getFolder(name: string): Folder
		local existing = map:FindFirstChild(name)
		if existing and existing:IsA("Folder") then
			existing:ClearAllChildren()
			return existing
		end
		local created = Instance.new("Folder")
		created.Name = name
		created.Parent = map
		return created
	end
	beltFolder = getFolder("BeltMeteors")
	groundFolder = getFolder("GroundMeteors")
	local belt = getBelt()
	if belt and belt.Part then
		belt.Part:SetAttribute("BeltSpeed", Config.BeltSpeed)
	end
end

function MeteorService.Start()
	local t = now()
	nextShowerAt = t + Config.ShowerInterval
	nextEggRushAt = t + Config.EggRushInterval / 2 -- versetzt: erster Egg Rush lange vor dem ersten Schauer
	publishAttributes()
	Players.PlayerRemoving:Connect(function(player)
		actionLimiter.Clear(player)
	end)

	-- Förderband-Schleife (nur Rechnen + gelegentlich ein neues Part – kein Bewegen!)
	task.spawn(function()
		while true do
			task.wait(0.05)
			local ok, err = pcall(beltStep)
			if not ok then
				warn("[MeteorService] Förderband-Fehler: " .. tostring(err))
				pendingNatural = nil
				task.wait(1)
			end
		end
	end)

	-- Meteore am Boden verschwinden lassen + Event-Timer
	task.spawn(function()
		local wasShower = false
		local wasRush = false
		while true do
			task.wait(1)
			local clock = os.clock()
			for i = #groundRecords, 1, -1 do
				local record = groundRecords[i]
				if not record.Claimed and clock > record.Expires then
					removeRecord(record)
				end
			end
			for i = #dropRecords, 1, -1 do
				local record = dropRecords[i]
				if record and not record.Claimed and clock > record.Expires then
					removeRecord(record)
				end
			end
			local ok, err = pcall(eventStep)
			if not ok then
				warn("[MeteorService] Event-Fehler: " .. tostring(err))
			end
			local shower = MeteorService.IsShowerActive()
			if wasShower and not shower then
				Services.EconomyService.NotifyAll("Der Meteoritenschauer ist vorbei. Locks gehen wieder! 🔒", "Info")
			end
			wasShower = shower
			local rush = MeteorService.IsEggRushActive()
			if wasRush and not rush then
				Services.EconomyService.NotifyAll("🥚 Der Egg Rush ist vorbei!", "Info")
			end
			wasRush = rush
		end
	end)
end

return MeteorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[-- Robux-Einnahmen: Gamepasses + Developer Products.
-- ProcessReceipt ist doppelt abgesichert: jeder Kauf wird im Spielstand vermerkt,
-- damit niemand etwas doppelt bekommt und niemand leer ausgeht.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local MonetizationService = {}
local Services

local owned: { [Player]: { [string]: boolean } } = {}
local loading: { [Player]: boolean } = {}
local adminGranted: { [Player]: { [string]: boolean } } = {} -- vom Admin geschenkte Pässe (nur diese Sitzung)
local randomRestricted: { [Player]: boolean } = {} -- Länder-Regel: keine bezahlten Zufalls-Gegenstände
local processing: { [string]: boolean } = {} -- Käufe, die gerade gutgeschrieben werden (gegen Doppel-Aufrufe)

local MAX_RECEIPTS = 60

-- ⭐ Starter-Paket: Werte in Config.StarterPack (der Shop-Text liest dieselben Werte)
-- Cash max(100K, 15 Min Einkommen), 3 Drehs, zufälliges Legendary-Ei, Speed Coil
local STARTER = Config.StarterPack or {}
local STARTER_MIN_CASH = tonumber(STARTER.MinCash) or 100000
local STARTER_INCOME_SECONDS = tonumber(STARTER.IncomeSeconds) or 900
local STARTER_SPINS = tonumber(STARTER.Spins) or 3
local STARTER_EGG_RARITY = tostring(STARTER.EggRarity or "Legendary")
local STARTER_GADGET = tostring(STARTER.Gadget or "SpeedCoil")
local STARTER_GADGET_FALLBACK_PRICE = 25000 -- Coil schon besessen -> ihr Preis als Cash (falls nicht in Config.Gadgets)
-- Länder ohne bezahlte Zufalls-Gegenstände: statt der Drehs +50% Cash, festes statt zufälliges Ei
local STARTER_RESTRICTED_CASH_MULT = tonumber(STARTER.RestrictedCashMult) or 1.5
-- 🐣 Sofort schlüpfen ohne Eier in der Base: Ersatz-Cash, damit der Kauf nicht verpufft
local INSTANT_HATCH_FALLBACK_SECONDS = 300
local INSTANT_HATCH_FALLBACK_MIN = 5000

function MonetizationService.HasPass(player: Player, key: string): boolean
	local passes = owned[player]
	local gifts = adminGranted[player]
	return (passes ~= nil and passes[key] == true) or (gifts ~= nil and gifts[key] == true)
end

function MonetizationService.LoadPasses(player: Player)
	if owned[player] then
		return
	end
	if loading[player] then
		while loading[player] and player.Parent do
			task.wait(0.1)
		end
		return
	end
	loading[player] = true
	local result = {}
	for _, pass in ipairs(Config.GamePasses) do
		if pass.Id ~= 0 then
			for attempt = 1, 3 do
				local ok, has =
					pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
				if ok then
					result[pass.Key] = has
					break
				end
				task.wait(attempt)
			end
		end
	end
	loading[player] = nil
	if not player.Parent then
		return
	end
	owned[player] = result
	if result.VIP then
		player:SetAttribute("VIP", true)
	end
end

-- Admin kann Pässe für Tests verschenken (nicht gespeichert)
function MonetizationService.GrantPassSession(player: Player, key: string)
	adminGranted[player] = adminGranted[player] or {}
	adminGranted[player][key] = true
	if key == "VIP" then
		player:SetAttribute("VIP", true)
	end
	MonetizationService.OnPassChanged(player)
end

function MonetizationService.OnPassChanged(player: Player)
	Services.EconomyService.ApplySpeed(player)
	local plot = Services.PlotService.GetPlot(player)
	if plot then
		Services.PlotService.UpdateSlotColors(plot)
		Services.PlotService.UpdateHatchTimes(plot) -- "2x Schlüpfen" -> Countdown neu berechnen
	end
	Services.EconomyService.MarkDirty(player)
end

-- Darf dieser Spieler KEINE bezahlten Zufalls-Gegenstände bekommen? (Roblox-Länder-Regel)
-- Im Zweifel (Abfrage klappt nicht) = ja, eingeschränkt. Ergebnis wird pro Sitzung gemerkt.
local function paidRandomRestricted(player: Player): boolean
	local cached = randomRestricted[player]
	if cached ~= nil then
		return cached
	end
	local ok, info = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, player)
	local restricted = not (ok and type(info) == "table" and info.ArePaidRandomItemsRestricted == false)
	if ok and player.Parent then
		randomRestricted[player] = restricted
	end
	return restricted
end

-- -------------------------------------------------------------------
-- PRODUKTE GUTSCHREIBEN
-- -------------------------------------------------------------------
-- Gadget schenken (ohne Cash). Gibt false zurück, wenn der Spieler es schon besitzt.
local function grantGadget(player: Player, data, id: string): boolean
	if type(data.Gadgets) ~= "table" then
		data.Gadgets = {}
	end
	if data.Gadgets[id] == true then
		return false
	end
	local gadgets = Services.GadgetService
	if gadgets then
		-- speichert + gibt das Werkzeug sofort in den Rucksack
		local ok, err = pcall(gadgets.Give, player, id)
		if not ok then
			warn("[Monetization] Gadget schenken fehlgeschlagen: " .. tostring(err))
		end
	end
	data.Gadgets[id] = true -- sicher gespeichert (Tool kommt spätestens beim nächsten Spawn)
	return true
end

local function grantStarterPack(player: Player): boolean
	local Economy = Services.EconomyService
	local data = Services.DataService.Get(player)
	if not data then
		return false
	end
	local restricted = paidRandomRestricted(player) -- kann kurz warten (meist schon gemerkt)
	if Services.DataService.Get(player) ~= data then
		return false -- während des Wartens gegangen -> Roblox versucht es beim nächsten Beitritt erneut
	end
	if data.StarterBought then
		warn(
			"[Monetization] Starter-Paket doppelt gekauft von " .. player.Name .. " – Inhalt trotzdem gutgeschrieben"
		)
	end
	local parts = {}
	local cash = math.max(STARTER_MIN_CASH, Economy.GetIncome(player) * STARTER_INCOME_SECONDS)
	if restricted then
		cash *= STARTER_RESTRICTED_CASH_MULT
	else
		Services.RewardService.AddSpins(player, STARTER_SPINS)
	end
	-- 🌀 Speed Coil (schon besessen -> ihr Preis als Cash)
	local def = Config.GadgetsById[STARTER_GADGET]
	local gadgetName = def and (tostring(def.Icon or "🌀") .. " " .. tostring(def.Name)) or "🌀 Speed Coil"
	if grantGadget(player, data, STARTER_GADGET) then
		table.insert(parts, gadgetName)
	else
		cash += def and def.Price or STARTER_GADGET_FALLBACK_PRICE
	end
	cash = math.floor(cash)
	Economy.AddCash(player, cash)
	table.insert(parts, 1, "💰 " .. Util.FormatCash(cash))
	if not restricted then
		table.insert(parts, 2, "🎡 " .. STARTER_SPINS .. " Drehs")
	end
	local _, eggText =
		Services.RewardService.GiveEgg(player, STARTER_EGG_RARITY, { Fixed = restricted, FullValue = true })
	data.StarterBought = true

	Economy.Notify(player, "⭐ STARTER-PAKET: " .. table.concat(parts, ", ") .. " – danke!", "Success")
	Economy.Notify(player, eggText, "Success")
	Economy.Effect(player, "Confetti", 3)
	Economy.NotifyAll("⭐ " .. player.DisplayName .. " hat sich das Starter-Paket geholt!", "Event")
	return true
end

-- 🛡️ Base-Schild: sperrt die eigene Base, auch im Meteoritenschauer (läuft schon eins -> länger).
-- Beim Verlassen setzt der PlotService das Schild zurück.
local function grantShield(player: Player, product): boolean
	local plot = Services.PlotService.GetPlot(player)
	if not plot then
		return false -- keine Base auf diesem Server -> Roblox versucht es später erneut
	end
	local minutes = math.max(1, tonumber(product.Minutes) or 10)
	Services.PlotService.AddShield(plot, minutes * 60)
	local Economy = Services.EconomyService
	Economy.Notify(
		player,
		"🛡️ Base-Schild aktiv: " .. minutes .. " Min sicher – sogar im Meteoritenschauer!",
		"Success"
	)
	Economy.Effect(player, "Confetti", 1.5)
	return true
end

local function grantProduct(player: Player, product): boolean
	local Economy = Services.EconomyService
	if product.Type == "Cash" then
		local amount = math.max(product.Min, Economy.GetIncome(player) * 60 * product.Minutes)
		amount = math.floor(amount)
		Economy.AddCash(player, amount)
		Economy.Notify(player, "💰 +" .. Util.FormatCash(amount) .. " – danke für deinen Kauf!", "Success")
		Economy.Effect(player, "Confetti", 1.5)
		return true
	elseif product.Type == "ServerLuck" then
		Services.MeteorService.AddServerLuck(product.Mult, product.Minutes * 60)
		Economy.NotifyAll(
			"🍀 "
				.. player.DisplayName
				.. " hat "
				.. product.Mult
				.. "x Glück für ALLE gekauft! ("
				.. product.Minutes
				.. " Min)",
			"Event"
		)
		return true
	elseif product.Type == "Shower" then
		Services.MeteorService.StartShower()
		Economy.NotifyAll("🌠 " .. player.DisplayName .. " hat einen Meteoritenschauer gestartet!", "Event")
		return true
	elseif product.Type == "Steps" then
		local data = Services.DataService.Get(player)
		if not data then
			return false
		end
		-- so viele Schritte wie "Minutes" Minuten auf dem besten freigeschalteten Laufband
		local best = Config.BestTreadmill(data.Steps)
		local ticksPerMinute = 60 / Config.TreadmillTick
		local amount = (best and best.Rate or 1) * ticksPerMinute * product.Minutes * Economy.GetStepsMult(player)
		amount = math.floor(math.max(product.Min, amount))
		Economy.AddSteps(player, amount)
		Economy.Effect(player, "Steps", amount)
		Economy.Notify(
			player,
			"👟 +" .. Util.FormatNumber(amount) .. " Schritte – danke für deinen Kauf!",
			"Success"
		)
		Economy.Effect(player, "Confetti", 1.5)
		return true
	elseif product.Type == "Meteor" then
		-- Base voll -> voller Wert als Cash, damit der Kauf nie verloren geht (macht GiveEgg)
		local ok, text = Services.RewardService.GiveEgg(player, product.Rarity, { FullValue = true })
		if not ok then
			return false
		end
		Economy.Notify(player, text .. " 🐣", "Success")
		Economy.Effect(player, "Confetti", 2)
		return true
	elseif product.Type == "StarterPack" then
		return grantStarterPack(player)
	elseif product.Type == "Spins" then
		local amount = math.max(1, math.floor(tonumber(product.Amount) or 1))
		if not Services.RewardService.AddSpins(player, amount) then
			return false
		end
		Economy.Notify(player, "🎡 +" .. amount .. " Glücksrad-Drehs – viel Glück!", "Success")
		Economy.Effect(player, "Confetti", 1.5)
		return true
	elseif product.Type == "InstantHatch" then
		if Economy.HatchAll(player) == 0 then
			-- keine Eier in der Base -> Ersatz-Cash statt eines verpufften Kaufs
			local amount = math.floor(
				math.max(INSTANT_HATCH_FALLBACK_MIN, Economy.GetIncome(player) * INSTANT_HATCH_FALLBACK_SECONDS)
			)
			Economy.AddCash(player, amount)
			Economy.Notify(
				player,
				"🐣 Keine Eier in deiner Base – du bekommst " .. Util.FormatCash(amount) .. " als Ersatz!",
				"Info"
			)
		end
		Economy.Effect(player, "Confetti", 2)
		return true
	elseif product.Type == "Shield" then
		return grantShield(player, product)
	elseif product.Type == "EggRush" then
		local meteors = Services.MeteorService
		if type(meteors.StartEggRush) ~= "function" then
			warn("[Monetization] MeteorService.StartEggRush fehlt – Egg Rush kann nicht starten")
			return false
		end
		meteors.StartEggRush()
		Economy.NotifyAll(
			"🥚 " .. player.DisplayName .. " hat einen EGG RUSH gestartet! Schnell sammeln! 🏃",
			"Event"
		)
		return true
	end
	warn("[Monetization] Unbekannter Produkt-Typ: " .. tostring(product.Type))
	return false
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Roblox versucht es später erneut
	end
	local data = Services.DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local product = Config.ProductsById[receipt.ProductId]
	if not product then
		warn(
			"[Monetization] Unbekannte ProductId "
				.. tostring(receipt.ProductId)
				.. " – in Config.Products eintragen!"
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Schon gutgeschrieben? (z.B. nach Server-Absturz)
	if table.find(data.Receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- Wird gerade gutgeschrieben (Gutschrift kann kurz warten, z.B. Länder-Regel beim Starter-Paket)
	if processing[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	processing[receipt.PurchaseId] = true
	local ok, granted = pcall(grantProduct, player, product)
	processing[receipt.PurchaseId] = nil
	if Services.DataService.Get(player) ~= data then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Spieler ist inzwischen gegangen
	end
	if not ok or not granted then
		warn("[Monetization] Gutschrift fehlgeschlagen: " .. tostring(granted))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	data.Stats.RobuxSpent += receipt.CurrencySpent or 0

	-- Sofort speichern, damit der Kauf sicher verbucht ist
	if Services.DataService.Save(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- Speichern ging nicht: Kauf ist im Spielstand vermerkt, beim nächsten Versuch wird
	-- er als "schon gutgeschrieben" erkannt und nicht doppelt vergeben.
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.Init(services)
	Services = services
end

function MonetizationService.Start()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, purchased)
		if not purchased then
			return
		end
		for _, pass in ipairs(Config.GamePasses) do
			if pass.Id == gamePassId then
				owned[player] = owned[player] or {}
				owned[player][pass.Key] = true
				if pass.Key == "VIP" then
					player:SetAttribute("VIP", true)
				end
				MonetizationService.OnPassChanged(player)
				Services.EconomyService.Notify(player, "🎉 " .. pass.Name .. " freigeschaltet! Danke!", "Success")
				Services.EconomyService.NotifyAll(
					"⭐ " .. player.DisplayName .. " hat " .. pass.Name .. " gekauft!",
					"Event"
				)
				Services.EconomyService.Effect(player, "Confetti", 2)
			end
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		task.spawn(MonetizationService.LoadPasses, player)
		task.spawn(paidRandomRestricted, player) -- vorab merken, damit das Starter-Paket nicht warten muss
	end)
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
		loading[player] = nil
		adminGranted[player] = nil
		randomRestricted[player] = nil
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[-- Lässt die Map bauen (MapBuilder) und verwaltet die Basen:
-- Zuweisung, Meteore/Aliens anzeigen, Collect-Pad + Slot-Pads, Lock-Pad, Schutz gegen Eindringlinge.
-- BASE-SCHILD (Produkt): plot.ShieldUntil (Serverzeit) sperrt die Base zusätzlich zum Lock –
-- auch während des Meteoritenschauers. Setzen über PlotService.AddShield/SetShield
-- (wer plot.ShieldUntil direkt ändert: wird innerhalb von 0,25 s übernommen).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))
local AlienFactory = require(script.Parent:WaitForChild("AlienFactory"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))

local PlotService = {}
PlotService.Plots = {} :: { any } -- Liste aller Basen (Felder siehe MapBuilder)
PlotService.ByPlayer = {} :: { [Player]: any }
PlotService.MapFolder = nil :: Folder?
-- Laufband: { Part, Start, Dir, Length, Width, TopY }
PlotService.Belt = nil :: any
PlotService.FreeZone = { Center = Vector3.new(0, 0.2, -264), Radius = 20 }
PlotService.LobbySpawn = CFrame.new(0, 4, -300)
PlotService.LeaderboardCFrame = CFrame.new(0, 13, -190)
PlotService.TreadmillsFolder = nil :: Folder?
PlotService.TreadmillSpawn = CFrame.new(0, 4, -330)
PlotService.MaxSlots = Config.BaseSlots + Config.ExtraSlotsAmount

local Services

local EMPTY_SLOT_COLOR = Color3.fromRGB(35, 35, 45)
local LOCK_NOTIFY_COOLDOWN = 2 -- Lock-Pad im Schauer: Hinweis höchstens alle 2 s (Touched feuert sehr oft)

local lockNotifyAt: { [Player]: number } = {}

-- -------------------------------------------------------------------
-- ABFRAGEN
-- -------------------------------------------------------------------
function PlotService.GetPlot(player: Player)
	return PlotService.ByPlayer[player]
end

function PlotService.IsInside(plot, position: Vector3): boolean
	local half = plot.HalfSize or 36
	local localPos = plot.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) <= half and math.abs(localPos.Z) <= half and localPos.Y > -6 and localPos.Y < 40
end

-- Gesperrt = Lock (Lock-Pad) ODER Base-Schild aktiv
function PlotService.IsLocked(plot): boolean
	local now = workspace:GetServerTimeNow()
	return plot.LockedUntil > now or (tonumber(plot.ShieldUntil) or 0) > now
end

-- Läuft ein gekauftes Base-Schild?
function PlotService.IsShielded(plot): boolean
	return (tonumber(plot.ShieldUntil) or 0) > workspace:GetServerTimeNow()
end

function PlotService.SlotCount(player: Player): number
	local extra = Services.MonetizationService.HasPass(player, "ExtraSlots") and Config.ExtraSlotsAmount or 0
	return math.min(Config.BaseSlots + extra, PlotService.MaxSlots)
end

function PlotService.FreeSlot(player: Player): number?
	local data = Services.DataService.Get(player)
	if not data then
		return nil
	end
	for slot = 1, PlotService.SlotCount(player) do
		if data.Meteors[tostring(slot)] == nil then
			return slot
		end
	end
	return nil
end

function PlotService.UsedSlots(player: Player): number
	local data = Services.DataService.Get(player)
	local count = 0
	if data then
		for _ in pairs(data.Meteors) do
			count += 1
		end
	end
	return count
end

-- Schlüpf-Tempo (Sekunden pro Sekunde): 2 mit dem Gamepass "2x Schlüpfen & Wachsen"
function PlotService.HatchSpeed(player: Player?): number
	if player and Services.MonetizationService.HasPass(player, "FastCharge") then
		return 2
	end
	return 1
end

-- Oberseite (Mitte) eines Slot-Pads – hier steht der Meteor bzw. das Alien
function PlotService.SlotTopCFrame(plot, slot: number): CFrame
	local slotPart = plot.Slots[slot]
	if not slotPart then
		return plot.CFrame
	end
	return slotPart.CFrame * CFrame.new(0, slotPart.Size.Y / 2, 0)
end

-- Weltposition eines angezeigten Meteors (Part) oder Aliens (Model)
function PlotService.ObjectPosition(object: Instance?): Vector3?
	if not object then
		return nil
	end
	if object:IsA("BasePart") then
		return object.Position
	elseif object:IsA("Model") then
		return object:GetPivot().Position
	end
	return nil
end

-- Halbe Breite eines angezeigten Objekts (für Reichweiten)
function PlotService.ObjectRadius(object: Instance?): number
	if not object then
		return 2
	end
	if object:IsA("BasePart") then
		return object.Size.X / 2
	elseif object:IsA("Model") then
		local size = object:GetExtentsSize()
		return math.max(size.X, size.Z) / 2
	end
	return 2
end

-- -------------------------------------------------------------------
-- METEORE / ALIENS IN DER BASE ANZEIGEN
-- -------------------------------------------------------------------
-- Foto-Deko (Admin-Panel → 📸 Foto-Modus): Ordner im Plot-Model, Teile heißen "Slot<n>"
local PHOTO_FOLDER = "PhotoShowcase"

local function removePhotoDeco(plot, slot: number)
	local folder = plot.Model:FindFirstChild(PHOTO_FOLDER)
	local deco = folder and folder:FindFirstChild("Slot" .. slot)
	if deco then
		deco:Destroy()
	end
end

-- Baut die Optik für einen Eintrag: Alien (geschlüpft) oder Meteor (schlüpft noch).
-- Gibt (Objekt, Teil für Prompts) zurück. Klappt das Alien nicht, wird ein Meteor gezeigt.
local function buildVisual(plot, slot: number, entry, mode: string): (Instance, BasePart)
	local top = PlotService.SlotTopCFrame(plot, slot)
	if entry.Alien ~= nil then
		local ok, result = pcall(AlienFactory.Create, entry, mode)
		if ok and typeof(result) == "Instance" and result:IsA("Model") then
			local model = result :: Model
			model:PivotTo(top)
			local body = model.PrimaryPart or model:FindFirstChild("Body")
			if body and body:IsA("BasePart") then
				return model, body
			end
			model:Destroy()
		else
			warn("[PlotService] Alien konnte nicht gebaut werden: " .. tostring(result))
		end
	end
	local meteor = MeteorFactory.Create(entry, "Base")
	meteor.CFrame = top * CFrame.new(0, meteor.Size.Y / 2, 0)
	return meteor, meteor
end

-- Setzt das Attribut HatchAt (Serverzeit, wann der Meteor schlüpft) – der Client zählt damit herunter
local function setHatchAt(plot, object: Instance, entry)
	if entry.Alien == nil and object:IsA("BasePart") then
		local remaining = math.max(0, tonumber(entry.Hatch) or 0)
		object:SetAttribute("HatchAt", workspace:GetServerTimeNow() + remaining / PlotService.HatchSpeed(plot.Owner))
	else
		object:SetAttribute("HatchAt", nil)
	end
end

local function sellText(entry): string
	return "Verkaufen " .. Util.FormatCash(Config.MeteorValue(entry) * Config.SellRatio)
end

function PlotService.RenderSlot(plot, slot: number)
	local existing = plot.MeteorParts[slot]
	if existing then
		existing:Destroy()
		plot.MeteorParts[slot] = nil
	end
	if not plot.Owner or not plot.Slots[slot] then
		return
	end
	local data = Services.DataService.Get(plot.Owner)
	local entry = data and data.Meteors[tostring(slot)]
	if not entry or not Config.MeteorsById[entry.Id] then
		return
	end
	if Services.CarryService.IsSlotBeingStolen(plot, slot) then
		return -- wird gerade geklaut -> unsichtbar in der Base
	end
	removePhotoDeco(plot, slot) -- echter Meteor/Alien ersetzt die Foto-Deko

	local object, promptPart = buildVisual(plot, slot, entry, "Base")
	object:SetAttribute("PlotIndex", plot.Index)
	object:SetAttribute("Slot", slot)
	object:SetAttribute("OwnerUserId", plot.Owner.UserId)
	setHatchAt(plot, object, entry)

	local reach = math.max(10, PlotService.ObjectRadius(object) + 7)
	local name = Config.EntryName(entry)
	local stealPrompt = MeteorFactory.AddPrompt(
		promptPart,
		"StealPrompt",
		"Klauen",
		name,
		Config.StealHoldDuration,
		Enum.KeyCode.E,
		reach
	)
	local sellPrompt =
		MeteorFactory.AddPrompt(promptPart, "SellPrompt", sellText(entry), name, 1, Enum.KeyCode.F, reach)
	-- Klauen: der Server prüft, ob wirklich Config.StealHoldDuration lang gehalten wurde
	MeteorFactory.OnHeldTrigger(stealPrompt, function(player)
		Services.CarryService.TrySteal(player, plot, slot)
	end)
	sellPrompt.Triggered:Connect(function(player)
		Services.EconomyService.Sell(player, plot, slot)
	end)
	object.Parent = plot.MeteorFolder
	plot.MeteorParts[slot] = object
end

-- Nach Level-Up nur Größe/Schild anpassen statt neu bauen
function PlotService.RefreshSlot(plot, slot: number)
	local object = plot.MeteorParts[slot]
	local data = plot.Owner and Services.DataService.Get(plot.Owner)
	local entry = data and data.Meteors[tostring(slot)]
	if not object or not entry then
		return
	end
	local isAlienModel = object:IsA("Model")
	if (entry.Alien ~= nil) ~= isAlienModel then
		-- z.B. gerade geschlüpft -> komplett neu bauen
		PlotService.RenderSlot(plot, slot)
		return
	end
	local promptPart: BasePart? = nil
	if isAlienModel then
		local model = object :: Model
		local ok, err = pcall(AlienFactory.Refresh, model, entry)
		if not ok then
			warn("[PlotService] Alien-Refresh fehlgeschlagen: " .. tostring(err))
		end
		local body = model.PrimaryPart or model:FindFirstChild("Body")
		promptPart = body and body:IsA("BasePart") and body or nil
	elseif object:IsA("BasePart") then
		MeteorFactory.Refresh(object, entry, "Base")
		setHatchAt(plot, object, entry)
		promptPart = object
	end
	local sellPrompt = promptPart and promptPart:FindFirstChild("SellPrompt")
	if sellPrompt and sellPrompt:IsA("ProximityPrompt") then
		sellPrompt.ActionText = sellText(entry)
	end
end

-- Schlüpf-Zeitpunkte neu berechnen (z.B. nach Kauf von "2x Schlüpfen")
function PlotService.UpdateHatchTimes(plot)
	local data = plot.Owner and Services.DataService.Get(plot.Owner)
	if not data then
		return
	end
	for slot, object in pairs(plot.MeteorParts) do
		local entry = data.Meteors[tostring(slot)]
		if entry and object.Parent then
			setHatchAt(plot, object, entry)
		end
	end
end

function PlotService.RenderAll(plot)
	for slot = 1, #plot.Slots do
		PlotService.RenderSlot(plot, slot)
	end
	PlotService.UpdateSlotColors(plot)
end

function PlotService.UpdateSlotColors(plot)
	local count = plot.Owner and PlotService.SlotCount(plot.Owner) or 0
	-- Foto-Deko aktiv -> alle Pads in der Plot-Farbe (volle Base sieht auf dem Foto besser aus)
	local photo = plot.Model:FindFirstChild(PHOTO_FOLDER) ~= nil
	for slot, slotPart in ipairs(plot.Slots) do
		if slot <= count or photo then
			slotPart.Color = plot.Color:Lerp(Color3.new(1, 1, 1), 0.3)
			slotPart.Transparency = 0
		else
			slotPart.Color = EMPTY_SLOT_COLOR
			slotPart.Transparency = 0.5
		end
	end
end

-- -------------------------------------------------------------------
-- FOTO-DEKO (nur Optik für Thumbnails: keine Spieldaten, keine Prompts)
-- -------------------------------------------------------------------
-- Füllt ALLE Slots ohne echten Meteor (auch die gesperrten) mit Deko-Aliens.
-- makeEntry() liefert { Id, Alien, Mut, Lv }. Gibt die Anzahl der Deko-Objekte zurück.
function PlotService.FillPhotoShowcase(plot, makeEntry: () -> any): number
	local folder = plot.Model:FindFirstChild(PHOTO_FOLDER)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = PHOTO_FOLDER
		folder.Parent = plot.Model
	end
	local count = 0
	for slot = 1, #plot.Slots do
		removePhotoDeco(plot, slot) -- nochmal drücken = neu würfeln
		local entry = plot.MeteorParts[slot] == nil and makeEntry() or nil
		if entry and Config.MeteorsById[entry.Id] then
			local object = buildVisual(plot, slot, entry, "Photo")
			object.Name = "Slot" .. slot
			object.Parent = folder
			count += 1
		end
	end
	PlotService.UpdateSlotColors(plot)
	return count
end

-- Entfernt nur die Deko (Slot-Farben danach mit UpdateSlotColors zurücksetzen)
function PlotService.ClearPhotoShowcase(plot)
	local folder = plot.Model:FindFirstChild(PHOTO_FOLDER)
	if folder then
		folder:Destroy()
	end
end

-- -------------------------------------------------------------------
-- LOCK
-- -------------------------------------------------------------------
local function setText(label: TextLabel, text: string)
	if label.Text ~= text then
		label.Text = text
	end
end

local LOCK_BARRIER_COLOR = Color3.fromRGB(255, 40, 40)
local SHIELD_BARRIER_COLOR = Color3.fromRGB(60, 170, 255)

local function setColor(part: BasePart, color: Color3)
	if part.Color ~= color then
		part.Color = color
	end
end

function PlotService.UpdateLockVisual(plot)
	local now = workspace:GetServerTimeNow()
	local showerActive = Services.MeteorService and Services.MeteorService.IsShowerActive()
	local shieldUntil = tonumber(plot.ShieldUntil) or 0
	if shieldUntil > now then
		plot.Barrier.Transparency = 0.25
		setColor(plot.Barrier, SHIELD_BARRIER_COLOR)
		setText(plot.LockLabel, "🛡️ SCHILD " .. Util.FormatTime(math.ceil(shieldUntil - now)))
		setColor(plot.LockPad, Color3.fromRGB(70, 130, 200))
	elseif plot.LockedUntil > now then
		plot.Barrier.Transparency = 0.35
		setColor(plot.Barrier, LOCK_BARRIER_COLOR)
		setText(plot.LockLabel, "🔒 " .. math.ceil(plot.LockedUntil - now) .. "s")
		setColor(plot.LockPad, Color3.fromRGB(90, 90, 90))
	else
		plot.Barrier.Transparency = 1
		setColor(plot.Barrier, LOCK_BARRIER_COLOR)
		setText(plot.LockLabel, showerActive and "🌠 KEIN LOCK IM SCHAUER" or "🔒 LOCK")
		setColor(plot.LockPad, Color3.fromRGB(230, 60, 60))
	end
end

-- Attribute fürs Model (der Client liest sie): LockedUntil = Ende der Sperre (Lock ODER Schild),
-- ShieldUntil = Ende des Base-Schilds
local function publishLock(plot)
	local shieldUntil = tonumber(plot.ShieldUntil) or 0
	plot.PublishedShield = shieldUntil
	local effective = math.max(plot.LockedUntil, shieldUntil)
	if plot.Model:GetAttribute("LockedUntil") ~= effective then
		plot.Model:SetAttribute("LockedUntil", effective)
	end
	if plot.Model:GetAttribute("ShieldUntil") ~= shieldUntil then
		plot.Model:SetAttribute("ShieldUntil", shieldUntil)
	end
	PlotService.UpdateLockVisual(plot)
end

function PlotService.SetLocked(plot, untilTime: number)
	plot.LockedUntil = untilTime
	publishLock(plot)
end

-- Base-Schild bis zu dieser Serverzeit (0 = aus)
function PlotService.SetShield(plot, untilTime: number)
	plot.ShieldUntil = math.max(0, tonumber(untilTime) or 0)
	publishLock(plot)
end

-- Base-Schild um "seconds" verlängern (läuft schon eins, wird es länger)
function PlotService.AddShield(plot, seconds: number)
	local now = workspace:GetServerTimeNow()
	PlotService.SetShield(plot, math.max(tonumber(plot.ShieldUntil) or 0, now) + math.max(0, seconds))
end

local function tryLock(player: Player, plot)
	if plot.Owner ~= player or PlotService.IsLocked(plot) then
		return -- schon gesperrt (Lock oder Base-Schild)
	end
	if Services.MeteorService.IsShowerActive() then
		local t = os.clock()
		if t - (lockNotifyAt[player] or -math.huge) >= LOCK_NOTIFY_COOLDOWN then
			lockNotifyAt[player] = t
			Services.EconomyService.Notify(player, "🌠 Während des Meteoritenschauers gibt es keine Locks!", "Error")
		end
		return
	end
	local duration = Services.MonetizationService.HasPass(player, "VIP") and Config.LockDurationVIP
		or Config.LockDuration
	PlotService.SetLocked(plot, workspace:GetServerTimeNow() + duration)
	Services.EconomyService.Notify(player, "🔒 Base für " .. duration .. " Sekunden gesperrt!", "Success")
end

-- Geld-Anzeige über dem Collect-Pad (nur schreiben, wenn sich etwas ändert)
function PlotService.SetCollectText(plot, pending: number)
	setText(plot.CollectLabel, "💰 " .. Util.FormatCash(pending))
end

-- -------------------------------------------------------------------
-- ZUWEISUNG & TELEPORT
-- -------------------------------------------------------------------
local function teleportToPlot(player: Player)
	local character = player.Character
	local plot = PlotService.ByPlayer[player]
	if not character then
		return
	end
	local target = plot and plot.SpawnCFrame or PlotService.LobbySpawn
	character:PivotTo(target)
	Services.CarryService.NoteTeleport(player, target.Position)
end

function PlotService.AssignPlot(player: Player)
	if PlotService.ByPlayer[player] then
		return PlotService.ByPlayer[player]
	end
	for _, plot in ipairs(PlotService.Plots) do
		if plot.Owner == nil then
			plot.Owner = player
			plot.Model:SetAttribute("OwnerUserId", player.UserId)
			plot.SignLabel.Text = player.DisplayName .. "s Base"
			PlotService.ByPlayer[player] = plot
			plot.ShieldUntil = 0
			PlotService.SetLocked(plot, 0)
			PlotService.UpdateSlotColors(plot)
			return plot
		end
	end
	return nil
end

function PlotService.ReleasePlot(player: Player)
	local plot = PlotService.ByPlayer[player]
	if not plot then
		return
	end
	PlotService.ByPlayer[player] = nil
	plot.Owner = nil
	plot.Model:SetAttribute("OwnerUserId", 0)
	plot.SignLabel.Text = "Freie Base"
	PlotService.SetCollectText(plot, 0)
	plot.ShieldUntil = 0
	PlotService.SetLocked(plot, 0)
	-- Fallen (Gadget) gehören dem alten Besitzer -> weg
	local traps = plot.Model:FindFirstChild("Traps")
	if traps then
		traps:Destroy()
	end
	for slot, object in pairs(plot.MeteorParts) do
		object:Destroy()
		plot.MeteorParts[slot] = nil
	end
	PlotService.ClearPhotoShowcase(plot)
	PlotService.UpdateSlotColors(plot)
end

function PlotService.TeleportHome(player: Player)
	teleportToPlot(player)
end

-- Hinter das beste freigeschaltete Laufband (Neulinge landen so am Holz-Laufband, nicht vor Gold)
local function treadmillTarget(player: Player): CFrame
	local data = Services.DataService.Get(player)
	local best = Config.BestTreadmill(data and data.Steps or 0)
	local folder = PlotService.TreadmillsFolder
	if best and folder then
		for _, model in ipairs(folder:GetChildren()) do
			local belt = model:IsA("Model") and model:GetAttribute("TreadmillId") == best.Id and model.PrimaryPart
			if belt then
				-- Lauffläche: lokales -Z (LookVector) = Laufrichtung -> Einstieg von hinten
				local spot = belt.Position - belt.CFrame.LookVector * (belt.Size.Z / 2 + 4) + Vector3.new(0, 3.5, 0)
				return CFrame.lookAt(spot, Vector3.new(belt.Position.X, spot.Y, belt.Position.Z))
			end
		end
	end
	return PlotService.TreadmillSpawn
end

function PlotService.TeleportToTreadmills(player: Player): boolean
	local character = player.Character
	if not character then
		return false
	end
	local target = treadmillTarget(player)
	character:PivotTo(target)
	Services.CarryService.NoteTeleport(player, target.Position)
	return true
end

-- Teleport-Ziel der Laufband-Zone: von MapBuilder, sonst aus den Laufbändern berechnet
local function findTreadmillSpawn(map: any): CFrame
	if typeof(map.TreadmillSpawn) == "CFrame" then
		return map.TreadmillSpawn
	end
	local folder = map.TreadmillsFolder
	if not folder then
		return PlotService.LobbySpawn
	end
	local fromAttribute = folder:GetAttribute("SpawnCFrame")
	if typeof(fromAttribute) == "CFrame" then
		return fromAttribute
	end
	local sum, count = Vector3.zero, 0
	local look, halfLength = Vector3.new(0, 0, -1), 10
	for _, model in ipairs(folder:GetChildren()) do
		local belt = model:IsA("Model") and model.PrimaryPart
		if belt then
			sum += belt.Position
			count += 1
			look = belt.CFrame.LookVector
			halfLength = belt.Size.Z / 2
		end
	end
	if count == 0 then
		return PlotService.LobbySpawn
	end
	local center = sum / count + Vector3.new(0, 3.5, 0)
	-- Einstieg von hinten (gegen die Laufrichtung), Blick auf die Laufbänder
	local spot = center - look * (halfLength + 7)
	return CFrame.lookAt(spot, center)
end

function PlotService.Init(services)
	Services = services
	local map = MapBuilder.Build() :: any
	PlotService.MapFolder = map.MapFolder
	PlotService.Plots = map.Plots or {}
	PlotService.Belt = map.Belt
	if map.FreeZone then
		PlotService.FreeZone = map.FreeZone
	end
	if typeof(map.LobbySpawn) == "CFrame" then
		PlotService.LobbySpawn = map.LobbySpawn
	end
	if typeof(map.LeaderboardCFrame) == "CFrame" then
		PlotService.LeaderboardCFrame = map.LeaderboardCFrame
	end
	PlotService.TreadmillsFolder = map.TreadmillsFolder
	PlotService.TreadmillSpawn = findTreadmillSpawn(map)

	local maxSlots = Config.BaseSlots + Config.ExtraSlotsAmount
	for _, plot in ipairs(PlotService.Plots) do
		plot.MeteorParts = plot.MeteorParts or {}
		plot.LockedUntil = plot.LockedUntil or 0
		plot.ShieldUntil = plot.ShieldUntil or 0
		plot.PublishedShield = plot.ShieldUntil
		maxSlots = math.min(maxSlots, #plot.Slots)
	end
	PlotService.MaxSlots = maxSlots
end

function PlotService.Start()
	local function onCharacter(player: Player, character: Model)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.1)
		if character.Parent and player.Character == character then
			teleportToPlot(player)
		end
	end

	local function onPlayer(player: Player)
		local plot = PlotService.AssignPlot(player)
		if not plot then
			task.delay(3, function()
				if player.Parent then
					Services.EconomyService.Notify(
						player,
						"😢 Server voll – keine Base frei. Wechsle den Server!",
						"Error"
					)
				end
			end)
		end
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end

	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end

	-- Pads: Collect-Pad + ALLE eigenen Slot-Pads sammeln Geld ein, Lock-Pad sperrt (Touched mit Entprellung)
	local debounce: { [Player]: number } = {}
	local function onCollectTouch(plot, hit: BasePart)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player and player == plot.Owner and os.clock() - (debounce[player] or 0) > 0.5 then
			debounce[player] = os.clock()
			Services.EconomyService.Collect(player)
		end
	end
	for _, plot in ipairs(PlotService.Plots) do
		plot.CollectPad.CanTouch = true
		plot.LockPad.CanTouch = true
		plot.CollectPad.Touched:Connect(function(hit)
			onCollectTouch(plot, hit)
		end)
		for _, slotPart in ipairs(plot.Slots) do
			slotPart.CanTouch = true
			slotPart.Touched:Connect(function(hit)
				onCollectTouch(plot, hit)
			end)
		end
		plot.LockPad.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player and player == plot.Owner then
				tryLock(player, plot)
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		debounce[player] = nil
		lockNotifyAt[player] = nil
		local plot = PlotService.ByPlayer[player]
		if plot then
			-- laufende Diebstähle aus dieser Base abbrechen, dann Base freigeben
			Services.CarryService.CancelStealsFromPlot(plot, "victimLeft")
		end
		PlotService.ReleasePlot(player)
	end)

	-- Eindringlinge aus gesperrten Basen werfen + Lock-Anzeige aktualisieren
	task.spawn(function()
		local tick = 0
		while true do
			task.wait(0.25)
			tick += 1
			for _, plot in ipairs(PlotService.Plots) do
				-- plot.ShieldUntil direkt geändert (z.B. vom Produkt)? -> Attribute + Anzeige nachziehen
				if (tonumber(plot.ShieldUntil) or 0) ~= plot.PublishedShield then
					publishLock(plot)
				end
				if plot.Owner and PlotService.IsLocked(plot) then
					for _, other in ipairs(Players:GetPlayers()) do
						local character = other.Character
						local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
						if other ~= plot.Owner and character and root and PlotService.IsInside(plot, root.Position) then
							if Services.CarryService.IsCarrying(other) then
								-- Dieb noch drin, als gesperrt wurde -> Beute zurück (eigener Hinweis statt "Teleport")
								Services.CarryService.Fail(other, "locked")
							end
							character:PivotTo(plot.EntranceCFrame)
							Services.CarryService.NoteTeleport(other, plot.EntranceCFrame.Position)
							Services.EconomyService.Notify(other, "🔒 Diese Base ist gesperrt!", "Error")
						end
					end
				end
				if tick % 4 == 0 then
					PlotService.UpdateLockVisual(plot)
				end
			end
		end
	end)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[-- Erstellt alle RemoteEvents/RemoteFunctions in ReplicatedStorage.Remotes
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
end

local function make(className: string, name: string)
	local existing = folder:FindFirstChild(name)
	if existing then
		return existing
	end
	local remote = Instance.new(className)
	remote.Name = name
	remote.Parent = folder
	return remote
end

return {
	Notify = make("RemoteEvent", "Notify") :: RemoteEvent, -- Server -> Client: Toast-Nachricht
	State = make("RemoteEvent", "State") :: RemoteEvent, -- Server -> Client: Cash, Einkommen, ...
	-- Server -> Client: Effekte (name, strength, data) – z.B. "Shake", "Steps", "Deliver", "Hatch"
	Effect = make("RemoteEvent", "Effect") :: RemoteEvent,
	-- Client -> Server: "Rebirth", "Daily", "Collect", "Home", "Treadmills"
	Request = make("RemoteFunction", "Request") :: RemoteFunction,
	Admin = make("RemoteFunction", "Admin") :: RemoteFunction, -- Client -> Server: Admin-Aktionen (geprüft!)
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[-- Belohnungen, die zum Wiederkommen locken (v2.1):
--  * 🎁 SPIELZEIT-GESCHENKE: nach 2, 5, 10 ... 60 Minuten Spielzeit ein Geschenk. Die Spielzeit zählt
--    pro UTC-Tag über ALLE Besuche und steht im Spielstand (data.Gifts) – neu beitreten setzt sie
--    nicht zurück (sonst könnte man alle 10 Minuten neu beitreten und dieselben Geschenke abholen).
--  * 🎡 GLÜCKSRAD: Drehs (data.Spins) + alle Config.FreeSpinHours Stunden ein Gratis-Dreh
--  * 📜 TAGESAUFGABEN: pro UTC-Tag 3 Aufgaben (Klauen, Schlüpfen, Laufen ...) -> Cash + 1 Dreh,
--    eine davon darf man einmal am Tag tauschen (z.B. "Bonk 3 Diebe" auf einem leeren Server)
-- Gewürfelt und gutgeschrieben wird NUR hier auf dem Server. Der Client zeigt nur an (State)
-- und schickt Anfragen ("ClaimGift", "Spin", "ClaimQuest", "RerollQuest" über den EconomyService).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local RewardService = {}
local Services

local rng = Random.new()

-- -------------------------------------------------------------------
-- EINSTELLUNGEN
-- Geschenke und Glücksrad-Felder stehen in Config (PlaytimeGifts, WheelPrizes, FreeSpinHours):
--   Type "Cash"  -> max(Min, Einkommen pro Sekunde * Seconds)
--   Type "Steps" -> so viele Schritte wie Seconds Sekunden auf dem besten Laufband (mind. Min)
--   Type "Spins" -> Amount Glücksrad-Drehs
--   Type "Egg"   -> zufälliges Ei (Meteor) der Seltenheit Rarity in die Base (Base voll -> Wert als Cash)
-- -------------------------------------------------------------------
local MAX_SPINS = 100000
local SPIN_COOLDOWN = 2 -- Sekunden zwischen zwei Drehs (der Client dreht das Rad in der Zeit)
local SPIN_REVEAL_DELAY = 5 -- große Gewinne erst ansagen, wenn das Rad beim Gewinner stehen geblieben ist
local SPIN_ANNOUNCE_RARITY = "Legendary" -- ab dieser Seltenheit wird ein Ei-Gewinn allen angesagt
local FIRST_NOTIFY_DELAY = 8 -- "Gratis-Dreh bereit" erst nach den Willkommens-Nachrichten
local MAX_TICK = 5 -- Spielzeit: nach einem Server-Hänger höchstens so viele Sekunden auf einmal
local MAX_GIFT_SECONDS = 86400 -- mehr als ein Tag Spielzeit geht an einem Tag nicht

-- Tagesaufgaben: Goals = feste Auswahl, Scale = wächst mit dem Fortschritt des Spielers.
-- Social = braucht andere Spieler (Klauen aus Basen, Bonken) -> höchstens eine davon pro Tag.
local QUEST_POOL = {
	{ Id = "Grab", Kind = "Grab", Text = "🥚 Klau %s Eier vom Band", Goals = { 5, 6, 8, 10 } },
	{ Id = "Steal", Kind = "Steal", Text = "😈 Klau %s Aliens/Eier aus Basen", Goals = { 2, 3 }, Social = true },
	{ Id = "Hatch", Kind = "Hatch", Text = "🐣 Lass %s Aliens schlüpfen", Goals = { 5, 6, 8 } },
	{ Id = "Steps", Kind = "Steps", Text = "👟 Lauf %s Schritte", Scale = "Steps" },
	{ Id = "Collect", Kind = "Collect", Text = "💰 Sammle %s ein", Scale = "Collect" },
	{ Id = "Bonk", Kind = "Bonk", Text = "🔨 Bonk %s Diebe", Goals = { 2, 3 }, Social = true },
}
local QUESTS_PER_DAY = 3
local QUEST_STEPS_SECONDS = 240 -- "Lauf X Schritte" = 4 Minuten auf dem besten Laufband
local QUEST_STEPS_MIN = 200
local QUEST_COLLECT_SECONDS = 300 -- "Sammle $X ein" = 5 Minuten Einkommen
local QUEST_COLLECT_MIN = 500
local QUEST_REWARD_SECONDS = 240 -- Belohnung = 4 Minuten Einkommen ...
local QUEST_REWARD_MIN = 2000 -- ... mindestens so viel
local QUEST_REWARD_SPINS = 1

local QUEST_BY_ID = {}
for _, def in ipairs(QUEST_POOL) do
	QUEST_BY_ID[def.Id] = def
end

local TRACK_KINDS = { Grab = true, Steal = true, Hatch = true, Steps = true, Collect = true, Bonk = true }

-- Sitzungs-Daten (nicht gespeichert – die Spielzeit für Geschenke steht in data.Gifts)
local joinedAt: { [Player]: number } = {}
local lastTick: { [Player]: number } = {}
local notifiedGifts: { [Player]: { [number]: boolean } } = {}
local notifiedDay: { [Player]: string } = {}
local freeSpinNotified: { [Player]: boolean } = {}
local lastSpin: { [Player]: number } = {}
-- Zuletzt geschickte Geschenke/Aufgaben (nur bei Änderung neu schicken, spart Netzwerk)
local sentGiftKey: { [Player]: string } = {}
local sentQuestKey: { [Player]: string } = {}

-- -------------------------------------------------------------------
-- HELFER
-- -------------------------------------------------------------------
local function giftList(): { any }
	return Config.PlaytimeGifts or {}
end

local function wheelList(): { any }
	return Config.WheelPrizes or {}
end

local function freeSpinPeriod(): number
	local hours = tonumber(Config.FreeSpinHours) or 4
	if hours ~= hours or hours <= 0 then
		hours = 4
	end
	return hours * 3600
end

local function finite(n: number): number
	if n ~= n or n < 0 then
		return 0
	end
	return math.min(n, 1e30)
end

-- 1234 -> 1200, 56789 -> 57000 (2 gültige Stellen – Ziele sehen so schöner aus)
local function roundNice(n: number): number
	n = finite(n)
	if n < 100 then
		return math.max(1, math.floor(n + 0.5))
	end
	local magnitude = 10 ^ (math.floor(math.log10(n)) - 1)
	return math.floor(n / magnitude + 0.5) * magnitude
end

local function today(): string
	return tostring(os.date("!%Y-%m-%d"))
end

local function notify(player: Player, text: string, kind: string?)
	Services.EconomyService.Notify(player, text, kind)
end

local function markDirty(player: Player)
	Services.EconomyService.MarkDirty(player)
end

-- Sekunden seit dem Beitritt (nur für den ersten Hinweis, NICHT für die Geschenke)
local function sessionSeconds(player: Player): number
	local t = joinedAt[player]
	if not t then
		t = os.clock()
		joinedAt[player] = t
	end
	return os.clock() - t
end

-- 🎁 Spielzeit von heute (UTC) aus dem Spielstand: { Day, Seconds, Claimed = { ["1"] = true } }.
-- Neuer Tag oder kaputte Daten -> wieder bei 0, alle Geschenke neu.
type GiftData = { Day: string, Seconds: number, Claimed: { [string]: boolean } }

local function giftData(data): GiftData
	local gifts = data.Gifts
	local day = today()
	if
		type(gifts) ~= "table"
		or gifts.Day ~= day
		or type(gifts.Claimed) ~= "table"
		or type(gifts.Seconds) ~= "number"
		or gifts.Seconds ~= gifts.Seconds
	then
		gifts = { Day = day, Seconds = 0, Claimed = {} }
		data.Gifts = gifts
	end
	return gifts
end

local function prizeType(prize): string
	return tostring(prize.Type or prize.Kind or "Cash")
end

-- Einkommen + Schritte-Tempo einmal ausrechnen (für mehrere Belohnungstexte auf einmal).
-- state (optional) = schon gebauter State: dann werden Income/StepsMult daraus genommen statt neu gerechnet.
type Rates = { Income: number, StepsPerSecond: number }

local function rates(player: Player, data, state: { [string]: any }?): Rates
	local best = Config.BestTreadmill(data.Steps)
	local rate = best and best.Rate or 1
	local income = state and tonumber(state.Income)
	local stepsMult = state and tonumber(state.StepsMult)
	return {
		Income = finite(income or Services.EconomyService.GetIncome(player)),
		StepsPerSecond = finite(
			rate / Config.TreadmillTick * (stepsMult or Services.EconomyService.GetStepsMult(player))
		),
	}
end

local function cashAmount(prize, r: Rates): number
	return math.floor(math.max(tonumber(prize.Min) or 0, r.Income * (tonumber(prize.Seconds) or 60)))
end

local function stepsAmount(prize, r: Rates): number
	return math.floor(math.max(tonumber(prize.Min) or 0, r.StepsPerSecond * (tonumber(prize.Seconds) or 60)))
end

local function spinsAmount(prize): number
	return math.clamp(math.floor(tonumber(prize.Amount) or 1), 1, 100)
end

local function spinsWord(n: number): string
	return n .. (n == 1 and " Dreh" or " Drehs")
end

-- Feld-Name fürs Glücksrad, z.B. "🌟 Legendary-Ei"
local function prizeLabel(prize): string
	local name = prize.Name or (prizeType(prize) == "Egg" and (tostring(prize.Rarity) .. "-Ei")) or prizeType(prize)
	return (prize.Icon and (tostring(prize.Icon) .. " ") or "") .. tostring(name)
end

-- Was gibt es? (Anzeige im Client, mit den aktuellen Beträgen)
local function prizeText(prize, r: Rates): string
	local kind = prizeType(prize)
	if kind == "Steps" then
		return tostring(prize.Icon or "👟") .. " " .. Util.FormatNumber(stepsAmount(prize, r)) .. " Schritte"
	elseif kind == "Spins" then
		return tostring(prize.Icon or "🎡") .. " " .. spinsWord(spinsAmount(prize))
	elseif kind == "Egg" then
		return tostring(prize.Icon or "🥚") .. " " .. tostring(prize.Name or (tostring(prize.Rarity) .. "-Ei"))
	end
	return tostring(prize.Icon or "💵") .. " " .. Util.FormatCash(cashAmount(prize, r))
end

-- -------------------------------------------------------------------
-- EIER & PREISE GUTSCHREIBEN
-- -------------------------------------------------------------------
-- Ei (Meteor) einer Seltenheit in die Base. Base voll / keine Base -> Geld statt Ei:
--   Gratis-Belohnung (Geschenk, Glücksrad): der Verkaufswert (Wert * Config.SellRatio) – sonst lohnt
--   es sich, die Base absichtlich voll zu lassen. opts.FullValue (Robux-Käufe): der volle Wert.
-- opts.Fixed = immer der günstigste Meteor der Seltenheit (z.B. Länder ohne Zufalls-Käufe)
-- opts.RandomMutation = Mutation würfeln (Gold, Frost ...), sonst "Normal"
-- Gibt (true, Text) zurück – false nur, wenn es die Seltenheit nicht gibt.
function RewardService.GiveEgg(
	player: Player,
	rarityName: string,
	opts: { Fixed: boolean?, RandomMutation: boolean?, FullValue: boolean? }?
): (boolean, string)
	local Meteor = Services.MeteorService
	local def = nil
	if opts and opts.Fixed then
		local list = Config.MeteorsByRarity[rarityName]
		if not list or #list == 0 then
			list = Config.MeteorsByRarityAll[rarityName]
		end
		def = list and list[1]
	else
		def = Meteor.RandomOfRarity(rarityName, true)
	end
	if not def then
		warn("[RewardService] Keine Meteore der Seltenheit " .. tostring(rarityName))
		return false, "???"
	end
	local mut = "Normal"
	if opts and opts.RandomMutation then
		mut = Meteor.RollMutation(1)
	end
	local entry = { Id = def.Id, Mut = Config.MutationsByName[mut] and mut or "Normal", Lv = 1 }
	local label = (entry.Mut ~= "Normal" and (entry.Mut .. " ") or "") .. def.Name .. " (" .. def.Rarity .. ")"
	if Services.EconomyService.GiveMeteor(player, entry, true) then
		return true, "🥚 " .. label .. " fliegt in deine Base!"
	end
	local ratio = if opts and opts.FullValue then 1 else Config.SellRatio
	local value = math.floor(Config.MeteorValue(entry) * ratio)
	Services.EconomyService.AddCash(player, value)
	return true, "📦 Base voll – du bekommst " .. Util.FormatCash(value) .. " statt " .. label
end

-- Schreibt einen Preis (Geschenk / Glücksrad) gut und gibt den Text zurück.
-- effects = fliegende Zahlen sofort zeigen (beim Glücksrad macht das der Client nach dem Drehen)
local function grantPrize(player: Player, data, prize, effects: boolean): string
	local Economy = Services.EconomyService
	local kind = prizeType(prize)
	local r = rates(player, data)
	if kind == "Steps" then
		local amount = stepsAmount(prize, r)
		Economy.AddSteps(player, amount) -- geschenkt, nicht gelaufen -> zählt nicht für "Lauf X Schritte"
		if effects then
			Economy.Effect(player, "Steps", amount)
		end
		return "+" .. Util.FormatNumber(amount) .. " Schritte 👟"
	elseif kind == "Spins" then
		local amount = spinsAmount(prize)
		RewardService.AddSpins(player, amount)
		return "+" .. spinsWord(amount) .. " 🎡"
	elseif kind == "Egg" then
		local ok, text = RewardService.GiveEgg(player, tostring(prize.Rarity), { RandomMutation = true })
		if ok then
			return text
		end
		-- Seltenheit gibt es nicht (Config geändert) -> kleines Cash-Geschenk statt nichts
	end
	local amount = cashAmount(prize, r)
	Economy.AddCash(player, amount)
	if effects then
		Economy.Effect(player, "Collect", amount)
	end
	return "+" .. Util.FormatCash(amount) .. " 💵"
end

function RewardService.AddSpins(player: Player, n: number): boolean
	local data = Services.DataService.Get(player)
	local amount = math.floor(tonumber(n) or 0)
	if not data or amount ~= amount or amount == 0 then
		return false
	end
	data.Spins = math.clamp((tonumber(data.Spins) or 0) + amount, 0, MAX_SPINS)
	markDirty(player)
	return true
end

-- -------------------------------------------------------------------
-- 📜 TAGESAUFGABEN
-- -------------------------------------------------------------------
local function questGoal(def, r: Rates): number
	if def.Scale == "Steps" then
		return math.max(QUEST_STEPS_MIN, roundNice(r.StepsPerSecond * QUEST_STEPS_SECONDS))
	elseif def.Scale == "Collect" then
		return math.max(QUEST_COLLECT_MIN, roundNice(r.Income * QUEST_COLLECT_SECONDS))
	end
	return def.Goals[rng:NextInteger(1, #def.Goals)]
end

local function questText(quest): string
	local def = QUEST_BY_ID[quest.Id]
	if not def then
		return "???"
	end
	local goal = def.Scale == "Collect" and Util.FormatCash(quest.Goal) or Util.FormatNumber(quest.Goal)
	return def.Text:format(goal)
end

local function questRewardCash(r: Rates): number
	return math.floor(math.max(QUEST_REWARD_MIN, r.Income * QUEST_REWARD_SECONDS))
end

local function questsValid(quests, day: string): boolean
	if type(quests) ~= "table" or quests.Day ~= day or type(quests.List) ~= "table" or #quests.List == 0 then
		return false
	end
	for _, quest in ipairs(quests.List) do
		local def = type(quest) == "table" and QUEST_BY_ID[quest.Id]
		if
			not def
			or quest.Kind ~= def.Kind
			or type(quest.Goal) ~= "number"
			or type(quest.Progress) ~= "number"
			or quest.Goal ~= quest.Goal
			or quest.Progress ~= quest.Progress
		then
			return false
		end
	end
	return true
end

-- 3 zufällige Aufgaben (verschiedene Arten, höchstens eine "mit anderen Spielern")
local function rollQuests(player: Player, data)
	local pool = table.clone(QUEST_POOL)
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local r = rates(player, data)
	local list = {}
	local hasSocial = false
	for _, def in ipairs(pool) do
		if #list >= QUESTS_PER_DAY then
			break
		end
		if not (def.Social and hasSocial) then
			hasSocial = hasSocial or def.Social == true
			table.insert(list, {
				Id = def.Id,
				Kind = def.Kind,
				Goal = questGoal(def, r),
				Progress = 0,
				Claimed = false,
			})
		end
	end
	data.Quests = { Day = today(), List = list }
end

-- Neuer UTC-Tag (oder kaputte Daten) -> neue Aufgaben. Gibt true zurück, wenn neu gewürfelt wurde.
local function ensureQuests(player: Player, data): boolean
	local day = today()
	local quests = data.Quests
	if questsValid(quests, day) then
		return false
	end
	local hadOld = type(quests) == "table" and type(quests.Day) == "string" and quests.Day ~= ""
	rollQuests(player, data)
	if hadOld then
		notify(player, "📜 Neue Tagesaufgaben sind da!", "Info")
	end
	markDirty(player)
	return true
end

-- Fortschritt zählen: kind = "Grab" | "Steal" | "Hatch" | "Steps" | "Collect" | "Bonk"
function RewardService.Track(player: Player, kind: string, amount: number?)
	if not TRACK_KINDS[kind] then
		return
	end
	local n = tonumber(amount) or 1
	if n ~= n or n <= 0 or n == math.huge then
		return
	end
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	ensureQuests(player, data)
	for _, quest in ipairs(data.Quests.List) do
		if quest.Kind == kind and not quest.Claimed and quest.Progress < quest.Goal then
			quest.Progress = math.min(quest.Goal, quest.Progress + n)
			if quest.Progress >= quest.Goal then
				notify(
					player,
					"📜 Aufgabe geschafft: " .. questText(quest) .. " – hol dir die Belohnung! 🎁",
					"Success"
				)
			end
			markDirty(player)
		end
	end
end

function RewardService.ClaimQuest(player: Player, index: any): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch... ⏳"
	end
	if ensureQuests(player, data) then
		return false, "📜 Neuer Tag – neue Aufgaben!"
	end
	local i = tonumber(index)
	local quest = i and data.Quests.List[i]
	if type(quest) ~= "table" then
		return false, "Unbekannte Aufgabe"
	end
	if quest.Claimed then
		return false, "✅ Schon abgeholt!"
	end
	if quest.Progress < quest.Goal then
		return false,
			"📜 Noch nicht geschafft ("
				.. Util.FormatNumber(quest.Progress)
				.. "/"
				.. Util.FormatNumber(quest.Goal)
				.. ")"
	end
	quest.Claimed = true
	local cash = questRewardCash(rates(player, data))
	Services.EconomyService.AddCash(player, cash)
	RewardService.AddSpins(player, QUEST_REWARD_SPINS)
	Services.EconomyService.Effect(player, "Collect", cash)
	Services.EconomyService.Effect(player, "Confetti", 1)
	markDirty(player)
	return true, "📜 Belohnung: +" .. Util.FormatCash(cash) .. " und +" .. spinsWord(QUEST_REWARD_SPINS) .. " 🎡!"
end

-- 🔄 Einmal pro Tag eine (noch nicht geschaffte) Aufgabe tauschen – z.B. "Bonk 3 Diebe" auf einem
-- leeren Server. Die neue Aufgabe braucht nie andere Spieler und ist von einer Art, die heute noch fehlt.
function RewardService.RerollQuest(player: Player, index: any): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch... ⏳"
	end
	if ensureQuests(player, data) then
		return false, "📜 Neuer Tag – neue Aufgaben!"
	end
	local quests = data.Quests
	if quests.Rerolled == true then
		return false, "🔄 Heute schon getauscht – morgen wieder!"
	end
	local i = tonumber(index)
	local quest = i and quests.List[i]
	if type(quest) ~= "table" then
		return false, "Unbekannte Aufgabe"
	end
	if quest.Claimed or quest.Progress >= quest.Goal then
		return false, "✅ Die hast du schon geschafft!"
	end
	local used = {}
	for _, other in ipairs(quests.List) do
		used[other.Id] = true
	end
	local options = {}
	for _, def in ipairs(QUEST_POOL) do
		if not def.Social and not used[def.Id] then
			table.insert(options, def)
		end
	end
	if #options == 0 then
		return false, "🔄 Gerade keine andere Aufgabe frei"
	end
	local def = options[rng:NextInteger(1, #options)]
	local fresh = {
		Id = def.Id,
		Kind = def.Kind,
		Goal = questGoal(def, rates(player, data)),
		Progress = 0,
		Claimed = false,
	}
	quests.List[i] = fresh
	quests.Rerolled = true
	markDirty(player)
	return true, "🔄 Neue Aufgabe: " .. questText(fresh)
end

-- -------------------------------------------------------------------
-- 🎁 SPIELZEIT-GESCHENKE (Spielzeit von heute, siehe giftData)
-- -------------------------------------------------------------------
local function giftReadyIn(gifts: GiftData, gift): number
	return math.max(0, math.ceil((tonumber(gift.Minutes) or 0) * 60 - gifts.Seconds))
end

function RewardService.ClaimGift(player: Player, index: any): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch... ⏳"
	end
	local i = tonumber(index)
	local gift = i and giftList()[i]
	if type(gift) ~= "table" or not i then
		return false, "Unbekanntes Geschenk"
	end
	local gifts = giftData(data)
	local key = tostring(i)
	if gifts.Claimed[key] then
		return false, "✅ Schon abgeholt!"
	end
	local remaining = giftReadyIn(gifts, gift)
	if remaining > 0 then
		return false, "⏳ Noch " .. Util.FormatTime(remaining) .. " spielen!"
	end
	gifts.Claimed[key] = true
	local text = grantPrize(player, data, gift, true)
	Services.EconomyService.Effect(player, "Confetti", 1)
	markDirty(player)
	return true, "🎁 Geschenk: " .. text
end

-- -------------------------------------------------------------------
-- 🎡 GLÜCKSRAD
-- -------------------------------------------------------------------
-- Sekunden bis zum nächsten Gratis-Dreh (0 = bereit)
function RewardService.FreeSpinIn(data): number
	local elapsed = math.max(0, os.time() - (tonumber(data.LastFreeSpin) or 0))
	return math.max(0, math.ceil(freeSpinPeriod() - elapsed))
end

-- Dreht das Rad: erst den Gratis-Dreh, sonst einen aus data.Spins.
-- Antwort-Extras für den Client: Segment = Feld (Index in Config.WheelPrizes), Prize = Feld-Text
function RewardService.Spin(player: Player): (boolean, string, { [string]: any }?)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch... ⏳", nil
	end
	local t = os.clock()
	if t - (lastSpin[player] or -math.huge) < SPIN_COOLDOWN then
		return false, "🎡 Das Rad dreht sich noch!", nil
	end
	local freeIn = RewardService.FreeSpinIn(data)
	local free = freeIn <= 0
	if not free and (tonumber(data.Spins) or 0) < 1 then
		return false, "🎡 Keine Drehs mehr! Gratis-Dreh in " .. Util.FormatTime(freeIn), nil
	end
	local prizes = wheelList()
	if #prizes == 0 then
		return false, "🎡 Das Glücksrad ist noch nicht eingerichtet", nil
	end
	local index = table.find(prizes, Util.WeightedPick(prizes, nil, rng)) or 1
	local prize = prizes[index]

	lastSpin[player] = t
	if free then
		data.LastFreeSpin = os.time()
		freeSpinNotified[player] = nil
	else
		data.Spins -= 1
	end
	local text = grantPrize(player, data, prize, false)
	markDirty(player)

	-- Großer Ei-Gewinn: allen ansagen, sobald das Rad beim Gewinner stehen geblieben ist
	local rarity = prizeType(prize) == "Egg" and Config.RarityIndex[prize.Rarity] or nil
	if rarity and rarity >= (Config.RarityIndex[SPIN_ANNOUNCE_RARITY] or math.huge) then
		local name = player.DisplayName
		task.delay(SPIN_REVEAL_DELAY, function()
			Services.EconomyService.NotifyAll(
				"🎡 " .. name .. " hat ein " .. tostring(prize.Rarity) .. "-Ei am Glücksrad gewonnen!",
				"Event"
			)
		end)
	end
	return true, "🎡 Gewonnen: " .. text, {
		Segment = index,
		Prize = prizeLabel(prize),
		Free = free,
	}
end

-- -------------------------------------------------------------------
-- DATEN AN DEN CLIENT (EconomyService ruft das bei jedem State auf)
--   Spins, FreeSpinIn, QuestReroll: klein -> immer
--   Gifts (+ GiftsAt), Quests: nur bei Änderung oder wenn full = true (alle ~20 s). Der Client behält
--   sonst die alten. ReadyIn gilt ab GiftsAt (Serverzeit) – so zählt der Client auch mit einem
--   älteren Paket richtig herunter.
-- -------------------------------------------------------------------
function RewardService.FillState(player: Player, data, state, full: boolean?)
	ensureQuests(player, data)
	local r = rates(player, data, state)
	local gifts = giftData(data)

	state.Spins = tonumber(data.Spins) or 0
	state.FreeSpinIn = RewardService.FreeSpinIn(data)
	state.QuestReroll = data.Quests.Rerolled ~= true -- heute noch eine Aufgabe tauschbar?

	local giftRows = {}
	local giftKey = { gifts.Day }
	for i, gift in ipairs(giftList()) do
		local claimed = gifts.Claimed[tostring(i)] == true
		local text = prizeText(gift, r)
		giftRows[i] = {
			Minutes = tonumber(gift.Minutes) or 0,
			Claimed = claimed,
			ReadyIn = giftReadyIn(gifts, gift),
			Text = text,
		}
		table.insert(giftKey, (if claimed then "1" else "0") .. text)
	end
	local giftSignature = table.concat(giftKey, "|")
	if full or sentGiftKey[player] ~= giftSignature then
		sentGiftKey[player] = giftSignature
		state.Gifts = giftRows
		state.GiftsAt = workspace:GetServerTimeNow()
	end

	local quests = {}
	local questKey = { data.Quests.Day }
	local rewardText = "💵 " .. Util.FormatCash(questRewardCash(r)) .. " + 🎡 " .. spinsWord(QUEST_REWARD_SPINS)
	for i, quest in ipairs(data.Quests.List) do
		local text = questText(quest)
		local claimed = quest.Claimed == true
		quests[i] = {
			Text = text,
			Kind = quest.Kind, -- z.B. "Collect" -> der Client zeigt den Fortschritt mit $
			Goal = quest.Goal,
			Progress = quest.Progress,
			Claimed = claimed,
			RewardText = rewardText,
		}
		table.insert(questKey, text .. "#" .. tostring(quest.Progress) .. (if claimed then "1" else "0"))
	end
	table.insert(questKey, rewardText)
	local questSignature = table.concat(questKey, "|")
	if full or sentQuestKey[player] ~= questSignature then
		sentQuestKey[player] = questSignature
		state.Quests = quests
	end
end

-- Jede Sekunde: Spielzeit hochzählen, "Geschenk bereit" / "Gratis-Dreh bereit" melden (je einmal)
local function tickPlayer(player: Player, dt: number)
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	local gifts = giftData(data)
	gifts.Seconds = math.min(MAX_GIFT_SECONDS, gifts.Seconds + dt)
	if sessionSeconds(player) < FIRST_NOTIFY_DELAY then
		return
	end
	local notified = notifiedGifts[player]
	if not notified or notifiedDay[player] ~= gifts.Day then
		notified = {} -- neuer Tag -> alle Geschenke wieder neu melden
		notifiedGifts[player] = notified
		notifiedDay[player] = gifts.Day
	end
	local ready = 0
	for i, gift in ipairs(giftList()) do
		if not notified[i] and not gifts.Claimed[tostring(i)] and giftReadyIn(gifts, gift) <= 0 then
			notified[i] = true
			ready += 1
		end
	end
	if ready > 0 then
		notify(player, "🎁 Ein Geschenk wartet auf dich! Klick auf 🎁 Geschenke.", "Success")
		markDirty(player)
	end
	if not freeSpinNotified[player] and RewardService.FreeSpinIn(data) <= 0 then
		freeSpinNotified[player] = true
		notify(player, "🎡 Gratis-Dreh bereit! Dreh am Glücksrad!", "Success")
		markDirty(player)
	end
end

function RewardService.Init(services)
	Services = services
end

function RewardService.Start()
	local function onPlayer(player: Player)
		joinedAt[player] = joinedAt[player] or os.clock()
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		joinedAt[player] = nil
		lastTick[player] = nil
		notifiedGifts[player] = nil
		notifiedDay[player] = nil
		freeSpinNotified[player] = nil
		lastSpin[player] = nil
		sentGiftKey[player] = nil
		sentQuestKey[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				if Services.EconomyService.IsReady(player) then
					-- echte vergangene Zeit (task.wait ist nie genau 1 s), nach Hängern gedeckelt
					local clock = os.clock()
					local dt = math.clamp(clock - (lastTick[player] or clock), 0, MAX_TICK)
					lastTick[player] = clock
					local ok, err = pcall(tickPlayer, player, dt)
					if not ok then
						warn("[RewardService] Fehler bei " .. player.Name .. ": " .. tostring(err))
					end
				end
			end
		end
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">RunService</string>
            <string name="Source"><![CDATA[-- ☄️ METEOR-RUN: langer Lauf-Parcours (Obby) – wer schnell ist, gewinnt ein Gratis-Ei!
--
-- LAGE: rechts neben dem Spawn-Platz, dann hinter den rechten Basen entlang bis zum Map-Ende
-- (zwischen den Rückwänden der Basen und der rechten Randwand). X-Mitte, Breite und Start werden
-- aus der Map abgeleitet (Basen, Randwände, Spawn-Platz). Deko (Bäume/Büsche) im Weg wird entfernt.
-- Die Strecke liegt erhöht (TOP Studs): wer runterfällt, muss zurück zum letzten Checkpoint.
--
-- ABLAUF: Rampe hoch -> durchs Start-Tor ("Bereit") -> über die Startlinie = Timer läuft
--   1 🔥 Lava-Felder   2 🦘 Sprünge über Lücken   3 🌀 rotierende Balken
--   4 ☄️ Meteor-Einschläge   5 🔥 Lava-Steine   -> 🏁 Ziel-Podest mit Belohnungs-Ei
-- Checkpoints (Pads) speichern den Fortschritt im Run. Lava, Runterfallen und Einschläge = zurück
-- zum letzten Checkpoint (niemand stirbt). Im Ziel: Cash + ein Gratis-Ei (Epic..Mythic, selten höher),
-- das man wie ein geklautes Ei nach Hause TRAGEN muss (CarryService, Source = "Ground").
-- Abklingzeit pro Spieler zwischen zwei Belohnungen, Bestzeit in data.RunBest.
--
-- PERFORMANCE: Der Server bewegt NICHTS. Die rotierenden Balken dreht jeder Client selbst
-- (Attribute SpinPivot/SpinAxis/SpinSpeed/SpinT0, Winkel aus der Serverzeit -> alle sehen dasselbe).
-- Der Server prüft nur alle 0,2 s die Positionen (Lava, Checkpoints, Ziel, Runterfallen).
-- Einschläge bestimmt der Server: Effekt "RunImpact" an alle (Warnkreis 1 s vorher), dann Treffer-Prüfung.
--
-- ANTI-CHEAT: Checkpoints nur in der richtigen Reihenfolge, Ziel nur mit allen Checkpoints und
-- frühestens nach Streckenlänge / (MaxWalkSpeed * 1.3). Teleport-/Speed-Verstoß (CarryService.MoveStatus)
-- bricht den Run ab. Wer etwas trägt, kann nicht starten.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))

local RunService = {}
local Services

local rng = Random.new()

-- -------------------------------------------------------------------
-- EINSTELLUNGEN
-- -------------------------------------------------------------------
local TOP = 8 -- Höhe der Lauffläche über der Wiese
local DECK = 1 -- Dicke der Lauffläche
local RAMP_LENGTH = 32 -- Rampe von der Wiese hoch zum Start
local PLAZA_GAP = 6 -- Abstand Rampen-Oberkante <-> Rand des Spawn-Platzes (Z)
local MAX_WIDTH = 14
local MIN_WIDTH = 8
-- Ersatzwerte, falls die Map anders aussieht (Werte aus MapBuilder)
local FALLBACK_PLOT_EDGE = 106
local FALLBACK_WALL_X = 150
local FALLBACK_WALL_MAX_Z = 256
local FALLBACK_PLAZA_MAX_Z = -226

local TICK = 0.2 -- so oft prüft der Server die Läufer
local REWARD_COOLDOWN = 180 -- Sekunden zwischen zwei Belohnungen pro Spieler
local MAX_RUN_TIME = 600 -- länger = Run abgebrochen
local AREA_SIDE = 20 -- so weit seitlich neben der Streckenmitte = Run abgebrochen (z.B. Home-Teleport)
local AREA_END = 12 -- so weit vor der Rampe / hinter dem Ziel = Run abgebrochen
local FALL_DEPTH = 1 -- Hüfte tiefer als Lauffläche + FALL_DEPTH = runtergefallen
local FOOT = 0.4 -- Lava-Felder zählen so viel breiter (Füße ragen über die Hüfte hinaus)
local NOTIFY_GAP = 1.5 -- Hinweise (Lava, Checkpoint fehlt ...) höchstens so oft pro Spieler
local SPEED_TOLERANCE = 1.3 -- Mindestzeit = Streckenlänge / (MaxWalkSpeed * SPEED_TOLERANCE)

local IMPACT_WARN = 1 -- Sekunden Warnkreis vor dem Einschlag
local IMPACT_RADIUS = 6
local IMPACT_INTERVAL = 0.7 -- so oft schlägt es ein, solange jemand im Einschlag-Abschnitt ist
local IMPACT_MAX = 6 -- höchstens so viele Einschläge gleichzeitig angekündigt
local IMPACT_AIM_CHANCE = 0.6 -- so oft wird auf einen Läufer gezielt (mit Vorhalt)
local IMPACT_LEAD = 0.6 -- Vorhalt in Sekunden

-- Belohnung
local PAR_TIME = 40 -- schneller als das = mehr Glück beim Ei
local RUN_MIN_CASH = 2500
local RUN_CASH_SECONDS = 90 -- Cash = max(RUN_MIN_CASH, Einkommen pro Sekunde * das)
local NEW_BEST_CASH_MULT = 1.5
local REBIRTH_LUCK = 0.1 -- pro Rebirth (max. 10) mehr Glück
local ANNOUNCE_RARITY = Config.RarityIndex.Mythic or 6 -- ab Mythic: allen ansagen
-- Gratis-Ei: Lucky = Gewicht wächst mit dem Glück, MinRebirths = erst ab so vielen Rebirths
local EGG_TABLE = {
	{ Rarity = "Epic", Weight = 60 },
	{ Rarity = "Legendary", Weight = 28, Lucky = true },
	{ Rarity = "Mythic", Weight = 10, Lucky = true },
	{ Rarity = "Celestial", Weight = 1.5, Lucky = true },
	{ Rarity = "Divine", Weight = 0.25, Lucky = true, MinRebirths = 3 },
}

-- Strecke: Abstände (Studs) ab der Rampen-Oberkante entlang +Z
local GATE_D = 6 -- Start-Tor
local READY_FROM_D = 7 -- ab hier "Bereit"
local START_LINE_D = 16 -- Startlinie: hier startet der Timer
local START_RESPAWN_D = 19 -- zurückgesetzt ohne Checkpoint -> hierhin (Timer läuft weiter)
local CHECKPOINT_D = { 104, 192, 280, 368 } -- Mitte der Checkpoint-Pads
local CHECKPOINT_DEPTH = 8
local IMPACT_AFTER_CP = 3 -- Einschlag-Abschnitt liegt hinter Checkpoint 3
local IMPACT_FROM_D = 288
local IMPACT_TO_D = 360
local FINISH_D = 434 -- Ziellinie
local END_D = 452 -- Ende des Ziel-Podests

local COLORS = {
	Deck = Color3.fromRGB(46, 40, 78),
	DeckAlt = Color3.fromRGB(60, 44, 96),
	Edge = Color3.fromRGB(0, 220, 255),
	Pillar = Color3.fromRGB(70, 70, 86),
	Lava = Color3.fromRGB(255, 90, 20),
	Stone = Color3.fromRGB(110, 100, 95),
	Gate = Color3.fromRGB(255, 140, 40),
	Finish = Color3.fromRGB(255, 205, 40),
	Checkpoint = Color3.fromRGB(80, 200, 255),
	Spinner = Color3.fromRGB(255, 60, 90),
	Crater = Color3.fromRGB(40, 30, 30),
}
local WHITE = Color3.new(1, 1, 1)

local RESET_TEXT: { [string]: string } = {
	lava = "🔥 Lava! Zurück zum Checkpoint!",
	fall = "🕳️ Runtergefallen! Zurück zum Checkpoint!",
	impact = "☄️ Getroffen! Zurück zum Checkpoint!",
}

-- -------------------------------------------------------------------
-- ZUSTAND
-- -------------------------------------------------------------------
type Box = { MinX: number, MaxX: number, MinZ: number, MaxZ: number, Top: number }
-- Phase "Ready" = im Start-Tor (Timer steht), "Running" = Timer läuft
type RunState = { Phase: string, Start: number, CP: number }

local runs: { [Player]: RunState } = {}
local cooldownUntil: { [number]: number } = {} -- UserId -> Serverzeit (überlebt Neu-Beitreten auf dem Server)
local notifyAt: { [Player]: number } = {}
local lastPos: { [Player]: Vector3 } = {} -- letzte gemessene Position (für Linien und Lava dazwischen)
local runFolder: Folder? = nil
local recordLabel: TextLabel? = nil
local serverRecord: { Name: string, Time: number }? = nil

-- Geometrie (wird beim Bauen gesetzt)
local X0 = 128
local Z0 = -232
local WIDTH = MAX_WIDTH
local lavaBoxes: { Box } = {}
local checkpointZ: { number } = {}
local respawnCF: { CFrame } = {} -- [1] = Start, [i + 1] = Checkpoint i
local startSpawnCF = CFrame.new()
local readyMinZ, readyMaxZ = 0, 0
local finishZ = 0
local exitMinZ, exitMaxZ = 0, 0 -- Rampe vom Ziel-Podest runter
local lineMinX, lineMaxX = 0, 0 -- so breit zählen Startlinie, Checkpoints, Ziel
local areaMinX, areaMaxX, areaMinZ, areaMaxZ = 0, 0, 0, 0 -- Strecke mit Rand
local exitMinX = 0 -- Ziel-Rampe zählt auch noch zur Strecke (bis hier)
local minRunTime = 0

-- -------------------------------------------------------------------
-- KLEINE HELFER
-- -------------------------------------------------------------------
local function now(): number
	return workspace:GetServerTimeNow()
end

-- 41.27 -> "0:41.3"
local function formatRunTime(seconds: number): string
	local tenths = math.floor(math.max(0, seconds) * 10 + 0.5)
	return string.format("%d:%04.1f", tenths // 600, (tenths % 600) / 10)
end

local function world(d: number, x: number, y: number): Vector3
	return Vector3.new(X0 + x, y, Z0 + d)
end

local function aliveRoot(player: Player): (BasePart?, Humanoid?)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return root, humanoid
end

-- Normale Höhe des HumanoidRootPart über dem Boden, wenn man steht (R15 bzw. R6)
local function standHeight(humanoid: Humanoid, root: BasePart): number
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	return root.Size.Y / 2 + 2
end

local function notifyLimited(player: Player, text: string, kind: string)
	local t = os.clock()
	if t - (notifyAt[player] or 0) < NOTIFY_GAP then
		return
	end
	notifyAt[player] = t
	Services.EconomyService.Notify(player, text, kind)
end

-- Schneidet die Strecke a -> b (waagrecht) das Rechteck? (schnelle Läufer überspringen sonst Felder)
local function segmentHitsBox(a: Vector3, b: Vector3, box: Box): boolean
	local t0, t1 = 0, 1
	for axis = 1, 2 do
		local origin = if axis == 1 then a.X else a.Z
		local delta = if axis == 1 then b.X - a.X else b.Z - a.Z
		local lo = if axis == 1 then box.MinX else box.MinZ
		local hi = if axis == 1 then box.MaxX else box.MaxZ
		if math.abs(delta) < 1e-6 then
			if origin < lo or origin > hi then
				return false
			end
		else
			local u0 = (lo - origin) / delta
			local u1 = (hi - origin) / delta
			if u0 > u1 then
				u0, u1 = u1, u0
			end
			t0 = math.max(t0, u0)
			t1 = math.min(t1, u1)
			if t0 > t1 then
				return false
			end
		end
	end
	return true
end

-- Ist die Linie bei z (quer über die Strecke) von a nach b vorwärts überquert worden?
local function crossedLine(a: Vector3, b: Vector3, z: number): boolean
	if not (a.Z < z and b.Z >= z) then
		return false
	end
	local t = (z - a.Z) / (b.Z - a.Z)
	local x = a.X + (b.X - a.X) * t
	local y = a.Y + (b.Y - a.Y) * t
	return x >= lineMinX and x <= lineMaxX and y > TOP - FALL_DEPTH and y < TOP + 20
end

-- Auf/an der Strecke (inkl. Rampe vom Ziel-Podest)? Weiter weg = Run abgebrochen
local function inArea(p: Vector3): boolean
	if p.X >= areaMinX and p.X <= areaMaxX and p.Z >= areaMinZ and p.Z <= areaMaxZ then
		return true
	end
	return p.X >= exitMinX and p.X < areaMinX and p.Z >= exitMinZ - 4 and p.Z <= exitMaxZ + 4
end

local function inReadyZone(p: Vector3): boolean
	return p.X >= lineMinX and p.X <= lineMaxX and p.Z >= readyMinZ and p.Z < readyMaxZ and p.Y > TOP and p.Y < TOP + 12
end

-- -------------------------------------------------------------------
-- BAU-HELFER (wie im MapBuilder)
-- -------------------------------------------------------------------
local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false -- alles wird per Position geprüft (spart Physik-Arbeit)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Unsichtbarer Ankerpunkt für Schilder
local function anchorPart(name: string, position: Vector3, parent: Instance): Part
	return part({
		Name = name,
		Size = Vector3.new(1, 1, 1),
		Position = position,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = parent,
	})
end

type SignLine = { Name: string, Text: string, Color: Color3, Height: number }

-- Mehrzeiliges Schild in Studs-Größe (Aufbau wie MapBuilder: BillboardGui > Frame > TextLabels)
local function worldSign(parent: Instance, width: number, height: number, lines: { SignLine }): { [string]: TextLabel }
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.fromScale(width, height)
	gui.MaxDistance = 400
	gui.LightInfluence = 0
	gui.Parent = parent
	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = frame
	local labels: { [string]: TextLabel } = {}
	for order, line in ipairs(lines) do
		local label = Instance.new("TextLabel")
		label.Name = line.Name
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, line.Height)
		label.LayoutOrder = order
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = line.Color
		label.Text = line.Text
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.new(0, 0, 0)
		stroke.Parent = label
		label.Parent = frame
		labels[line.Name] = label
	end
	return labels
end

-- -------------------------------------------------------------------
-- LAGE AUS DER MAP ABLEITEN
-- -------------------------------------------------------------------
-- X-Mitte zwischen Außenkante der rechten Basen und rechter Randwand, Start neben dem Spawn-Platz
local function computeLayout(map: Instance?)
	local plotEdge = -math.huge
	for _, plot in ipairs(Services.PlotService.Plots) do
		local cf = plot.CFrame
		if typeof(cf) == "CFrame" and cf.Position.X > 0 then
			plotEdge = math.max(plotEdge, cf.Position.X + (plot.HalfSize or 36))
		end
	end
	if plotEdge == -math.huge then
		plotEdge = FALLBACK_PLOT_EDGE
	end
	local wallX, wallMaxZ = FALLBACK_WALL_X, FALLBACK_WALL_MAX_Z
	local plazaMaxZ = FALLBACK_PLAZA_MAX_Z
	if map then
		local foundX, foundZ = math.huge, -math.huge
		for _, child in ipairs(map:GetChildren()) do
			if child.Name == "Boundary" and child:IsA("BasePart") then
				if child.Size.X < child.Size.Z and child.Position.X > 0 then
					foundX = math.min(foundX, child.Position.X - child.Size.X / 2)
				elseif child.Size.Z < child.Size.X and child.Position.Z > 0 then
					foundZ = math.max(foundZ, child.Position.Z - child.Size.Z / 2)
				end
			end
		end
		if foundX < math.huge then
			wallX = foundX
		end
		if foundZ > -math.huge then
			wallMaxZ = foundZ
		end
		local plaza = map:FindFirstChild("Plaza")
		local floorPart = plaza and plaza:FindFirstChild("Floor")
		if floorPart and floorPart:IsA("BasePart") then
			plazaMaxZ = floorPart.Position.Z + floorPart.Size.Z / 2
		end
	end
	local gap = wallX - plotEdge
	WIDTH = math.clamp(gap - 10, MIN_WIDTH, MAX_WIDTH)
	X0 = (plotEdge + wallX) / 2
	Z0 = plazaMaxZ - PLAZA_GAP
	if gap - WIDTH < 4 then
		warn("[RunService] Wenig Platz zwischen Basen und Randwand – der Meteor-Run wird eng")
	end
	if Z0 + END_D + 4 > wallMaxZ then
		warn("[RunService] Der Meteor-Run ist länger als die Map – das Ziel liegt hinter der Randwand!")
	end
end

-- Deko (Bäume/Büsche) im Weg entfernen, andere Kollisionen melden
local function clearArea(map: Instance, center: Vector3, size: Vector3)
	local deco = map:FindFirstChild("Deco")
	-- ohne Filter (alles im Kasten), nur Teile der Map zählen
	local hits = workspace:GetPartBoundsInBox(CFrame.new(center), size)
	local conflicts: { string } = {}
	for _, hit in ipairs(hits) do
		if not hit.Parent or not hit:IsDescendantOf(map) then
			continue -- schon entfernt (Teil eines Baums) oder gehört nicht zur Map
		end
		if deco and hit:IsDescendantOf(deco) then
			-- ganzen Baum entfernen (Stamm + Krone stehen an derselben Stelle)
			local spot = hit.Position
			for _, other in ipairs(deco:GetChildren()) do
				if other ~= hit and other:IsA("BasePart") then
					local dx, dz = other.Position.X - spot.X, other.Position.Z - spot.Z
					if dx * dx + dz * dz < 1 then
						other:Destroy()
					end
				end
			end
			hit:Destroy()
		elseif hit.Name ~= "Ground" and #conflicts < 5 then
			table.insert(conflicts, hit:GetFullName())
		end
	end
	if #conflicts > 0 then
		warn("[RunService] Meteor-Run überschneidet sich mit: " .. table.concat(conflicts, ", "))
	end
end

-- -------------------------------------------------------------------
-- STRECKE BAUEN
-- -------------------------------------------------------------------
local decoFolder: Folder
local lavaFolder: Folder
local spinnerFolder: Folder
local checkpointFolder: Folder

-- Lauffläche von d0 bis d1 (x = Versatz zur Mitte), mit Leuchtkanten und Stützen
local function deck(d0: number, d1: number, x: number, width: number, color: Color3)
	local length = d1 - d0
	local mid = (d0 + d1) / 2
	part({
		Name = "Deck",
		Size = Vector3.new(width, DECK, length),
		Position = world(mid, x, TOP - DECK / 2),
		Material = Enum.Material.SmoothPlastic,
		Color = color,
		Parent = decoFolder,
	})
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "Edge",
			Size = Vector3.new(0.4, 0.3, length),
			Position = world(mid, x + s * (width / 2 - 0.2), TOP + 0.15),
			Material = Enum.Material.Neon,
			Color = COLORS.Edge,
			CanCollide = false,
			CastShadow = false,
			Parent = decoFolder,
		})
	end
	local count = math.max(1, math.floor(length / 20 + 0.5))
	for i = 1, count do
		local d = d0 + length * (i - 0.5) / count
		local offsets = if width >= 6 then { -(width / 2 - 1), width / 2 - 1 } else { 0 }
		for _, ox in ipairs(offsets) do
			part({
				Name = "Pillar",
				Size = Vector3.new(1.2, TOP - DECK, 1.2),
				Position = world(d, x + ox, (TOP - DECK) / 2),
				Material = Enum.Material.Metal,
				Color = COLORS.Pillar,
				CastShadow = false,
				Parent = decoFolder,
			})
		end
	end
end

-- Lava-Feld auf der Lauffläche (x0..x1 relativ zur Mitte). Ohne Kollision: man steht auf dem Deck,
-- die Prüfung macht der Server (Position).
local function lava(d0: number, d1: number, x0: number, x1: number)
	part({
		Name = "Lava",
		Size = Vector3.new(x1 - x0, 0.2, d1 - d0),
		Position = world((d0 + d1) / 2, (x0 + x1) / 2, TOP + 0.1),
		Material = Enum.Material.Neon,
		Color = COLORS.Lava,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = lavaFolder,
	})
	table.insert(lavaBoxes, {
		MinX = X0 + x0 - FOOT,
		MaxX = X0 + x1 + FOOT,
		MinZ = Z0 + d0 - FOOT,
		MaxZ = Z0 + d1 + FOOT,
		Top = TOP,
	})
end

-- Rotierender Balken: der Client dreht ihn um "pivot" (Achse im Pivot-Raum), der Server nie
local function spinner(
	name: string,
	pivot: CFrame,
	offset: CFrame,
	size: Vector3,
	axis: Vector3,
	speed: number,
	t0: number
)
	local bar = part({
		Name = name,
		Size = size,
		CFrame = pivot * offset,
		Material = Enum.Material.Neon,
		Color = COLORS.Spinner,
		CastShadow = false,
		Parent = spinnerFolder,
	})
	bar:SetAttribute("SpinPivot", pivot)
	bar:SetAttribute("SpinAxis", axis)
	bar:SetAttribute("SpinSpeed", speed) -- Bogenmaß pro Sekunde
	bar:SetAttribute("SpinT0", t0) -- Serverzeit, zu der der Balken so steht wie auf dem Server
end

local function gate(d: number, color: Color3, height: number)
	local half = WIDTH / 2
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "GatePillar",
			Size = Vector3.new(1.6, height, 1.6),
			Position = world(d, s * (half + 0.8), TOP + height / 2),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(50, 50, 62),
			Parent = decoFolder,
		})
		part({
			Name = "GateGlow",
			Size = Vector3.new(0.5, height - 1, 0.5),
			Position = world(d, s * (half - 0.1), TOP + height / 2),
			Material = Enum.Material.Neon,
			Color = color,
			CanCollide = false,
			CastShadow = false,
			Parent = decoFolder,
		})
	end
	part({
		Name = "GateBeam",
		Size = Vector3.new(WIDTH + 3.2, 1.6, 1.6),
		Position = world(d, 0, TOP + height + 0.8),
		Material = Enum.Material.Neon,
		Color = color,
		CastShadow = false,
		Parent = decoFolder,
	})
end

-- Linie quer über die Strecke (Start/Ziel: kariert)
local function line(d: number, checkered: boolean)
	local tiles = math.max(2, math.floor(WIDTH / 2))
	local tile = WIDTH / tiles
	for row = 0, 1 do
		for i = 0, tiles - 1 do
			local white = (i + row) % 2 == 0
			if checkered or white then
				part({
					Name = "Line",
					Size = Vector3.new(tile, 0.06, 1),
					Position = world(d - 0.5 + row, -WIDTH / 2 + tile * (i + 0.5), TOP + 0.03),
					Material = Enum.Material.SmoothPlastic,
					Color = if white then WHITE else Color3.fromRGB(20, 20, 24),
					CanCollide = false,
					CanQuery = false,
					CastShadow = false,
					Parent = decoFolder,
				})
			end
		end
	end
end

local function sectionSign(d: number, title: string, hint: string, color: Color3)
	local anchor = anchorPart("SectionSign", world(d, WIDTH / 2 + 2.5, TOP + 7), decoFolder)
	worldSign(anchor, 14, 4.4, {
		{ Name = "Title", Text = title, Color = color, Height = 0.6 },
		{ Name = "Hint", Text = hint, Color = WHITE, Height = 0.4 },
	})
end

local function checkpointPad(index: number, d: number)
	local pad = part({
		Name = "Checkpoint" .. index,
		Size = Vector3.new(WIDTH, 0.12, CHECKPOINT_DEPTH),
		Position = world(d, 0, TOP + 0.06),
		Material = Enum.Material.Neon,
		Color = COLORS.Checkpoint,
		Transparency = 0.25,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = checkpointFolder,
	})
	pad:SetAttribute("CheckpointIndex", index)
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "Flag",
			Size = Vector3.new(0.5, 6, 0.5),
			Position = world(d, s * (WIDTH / 2 + 0.6), TOP + 3),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(220, 220, 230),
			Parent = decoFolder,
		})
		part({
			Name = "FlagCloth",
			Size = Vector3.new(0.2, 1.6, 2.4),
			Position = world(d + 1.2, s * (WIDTH / 2 + 0.6), TOP + 5.2),
			Material = Enum.Material.Neon,
			Color = COLORS.Checkpoint,
			CanCollide = false,
			CastShadow = false,
			Parent = decoFolder,
		})
	end
	local anchor = anchorPart("CheckpointSign", world(d, 0, TOP + 7.5), decoFolder)
	worldSign(anchor, 8, 2.4, {
		{
			Name = "Title",
			Text = "🚩 Checkpoint " .. index .. "/" .. #CHECKPOINT_D,
			Color = Color3.fromRGB(140, 230, 255),
			Height = 1,
		},
	})
	checkpointZ[index] = Z0 + d
	respawnCF[index + 1] = CFrame.lookAt(world(d + 1.5, 0, TOP + 3.5), world(d + 10, 0, TOP + 3.5))
end

local function build(map: Instance): Folder
	local half = WIDTH / 2
	table.clear(lavaBoxes)
	table.clear(checkpointZ)
	table.clear(respawnCF)

	local root = Instance.new("Folder")
	root.Name = "MeteorRun"
	decoFolder = folder("Deco", root)
	lavaFolder = folder("Lava", root)
	spinnerFolder = folder("Spinners", root)
	checkpointFolder = folder("Checkpoints", root)

	-- RAMPE von der Wiese hoch zum Start (Oberkante genau auf der Lauffläche)
	local rampTop = world(0, 0, TOP)
	local rampBottom = world(-RAMP_LENGTH, 0, 0)
	part({
		Name = "Ramp",
		Size = Vector3.new(WIDTH, 1, (rampTop - rampBottom).Magnitude),
		CFrame = CFrame.lookAt((rampTop + rampBottom) / 2, rampTop) * CFrame.new(0, -0.5, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = COLORS.DeckAlt,
		Parent = decoFolder,
	})
	local rampSign = anchorPart("RampSign", world(-RAMP_LENGTH + 2, 0, 9), decoFolder)
	worldSign(rampSign, 20, 5, {
		{ Name = "Title", Text = "☄️ METEOR-RUN ⬆️", Color = COLORS.Gate, Height = 0.62 },
		{ Name = "Hint", Text = "Schnell sein = Gratis-Ei! 🥚", Color = WHITE, Height = 0.38 },
	})

	-- START: Plattform, Tor, Startlinie
	deck(0, 108, 0, WIDTH, COLORS.Deck)
	gate(GATE_D, COLORS.Gate, 13)
	line(START_LINE_D, true)
	local startSign = anchorPart("StartSign", world(GATE_D, 0, TOP + 21), decoFolder)
	local labels = worldSign(startSign, 30, 9, {
		{ Name = "Title", Text = "☄️ METEOR-RUN", Color = COLORS.Gate, Height = 0.5 },
		{ Name = "Record", Text = "🏆 Rekord: noch keiner!", Color = Color3.fromRGB(255, 230, 90), Height = 0.27 },
		{ Name = "Hint", Text = "Über die Linie = Timer läuft!", Color = WHITE, Height = 0.23 },
	})
	recordLabel = labels.Record

	-- 1) LAVA-FELDER (quer, dann Slalom)
	sectionSign(22, "1/5 🔥 LAVA", "Nicht berühren – drüberspringen!", COLORS.Lava)
	lava(28, 32, -half, half)
	lava(40, 44, -half, half)
	lava(50, 62, -half, half * 0.15)
	lava(64, 76, -half * 0.15, half)
	lava(82, 87, -half, half)
	lava(92, 96, -half, half)

	-- 2) SPRÜNGE über Lücken (Plattformen werden schmaler)
	sectionSign(110, "2/5 🦘 SPRÜNGE", "Anlauf nehmen!", Color3.fromRGB(120, 255, 120))
	deck(112, 124, 0, WIDTH, COLORS.DeckAlt)
	deck(129, 137, 0, math.max(6, WIDTH * 0.6), COLORS.Deck)
	deck(142, 150, half * 0.4, 6, COLORS.DeckAlt)
	deck(156, 164, -half * 0.4, 6, COLORS.Deck)
	deck(169, 284, 0, WIDTH, COLORS.DeckAlt)

	-- 3) ROTIERENDE BALKEN (der Client dreht sie)
	local t0 = now()
	sectionSign(198, "3/5 🌀 BALKEN", "Timing ist alles!", COLORS.Spinner)
	local barLength = WIDTH - 1
	local function post(d: number)
		part({
			Name = "SpinnerPost",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 1.4, 1.4),
			CFrame = CFrame.new(world(d, 0, TOP + 1.5)) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(60, 60, 72),
			Parent = decoFolder,
		})
	end
	-- a) Fegebalken knapp über dem Boden (drüberspringen)
	post(210)
	spinner(
		"SweeperA",
		CFrame.new(world(210, 0, TOP + 1.2)),
		CFrame.new(),
		Vector3.new(barLength, 1.2, 1.2),
		Vector3.yAxis,
		1.8,
		t0
	)
	-- b) Windmühle: ein Balken dreht sich quer über die Strecke (unten durchlaufen, wenn er oben ist)
	local millPivot = CFrame.new(world(234, 0, TOP + 7.5))
	for _, s in ipairs({ -1, 1 }) do
		part({
			Name = "MillPost",
			Size = Vector3.new(1.2, 10, 1.2),
			Position = world(235.6, s * (half + 0.8), TOP + 5),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(60, 60, 72),
			Parent = decoFolder,
		})
	end
	part({
		Name = "MillBeam",
		Size = Vector3.new(WIDTH + 2.8, 1, 1),
		Position = world(235.6, 0, TOP + 10.5),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(60, 60, 72),
		Parent = decoFolder,
	})
	part({
		Name = "MillAxle",
		Size = Vector3.new(0.8, 0.8, 1.6),
		Position = world(234.8, 0, TOP + 7.5),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 220, 60),
		CanCollide = false,
		CastShadow = false,
		Parent = decoFolder,
	})
	part({
		Name = "MillHanger",
		Size = Vector3.new(0.6, 3, 0.6),
		Position = world(235.6, 0, TOP + 9),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(60, 60, 72),
		CanCollide = false,
		Parent = decoFolder,
	})
	spinner("Windmill", millPivot, CFrame.new(), Vector3.new(barLength, 1.2, 1.2), Vector3.zAxis, 1.4, t0)
	-- c) Kreuz aus zwei Fegebalken, andersherum
	post(258)
	local crossPivot = CFrame.new(world(258, 0, TOP + 1.2))
	spinner("SweeperC1", crossPivot, CFrame.new(), Vector3.new(barLength, 1.2, 1.2), Vector3.yAxis, -1.5, t0)
	spinner(
		"SweeperC2",
		crossPivot,
		CFrame.Angles(0, math.rad(90), 0),
		Vector3.new(barLength, 1.2, 1.2),
		Vector3.yAxis,
		-1.5,
		t0
	)

	-- 4) METEOR-EINSCHLÄGE (Server bestimmt sie, Client zeigt Warnkreis + Einschlag)
	deck(284, 372, 0, WIDTH, COLORS.Deck)
	sectionSign(286, "4/5 ☄️ EINSCHLÄGE", "Raus aus den roten Kreisen!", Color3.fromRGB(255, 120, 120))
	local craterRng = Random.new(4242)
	for _ = 1, 7 do
		local d = craterRng:NextNumber(IMPACT_FROM_D + 4, IMPACT_TO_D - 4)
		local x = craterRng:NextNumber(-half + 2.5, half - 2.5)
		local size = craterRng:NextNumber(3, 4.5)
		part({
			Name = "Crater",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, size, size),
			CFrame = CFrame.new(world(d, x, TOP + 0.03)) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Slate,
			Color = COLORS.Crater,
			CanCollide = false,
			CanQuery = false,
			CastShadow = false,
			Parent = decoFolder,
		})
	end

	-- 5) LAVA-STEINE: alles Lava, nur auf den Steinen ist man sicher
	deck(372, END_D, 0, WIDTH, COLORS.DeckAlt)
	sectionSign(374, "5/5 🔥 LAVA-STEINE", "Von Stein zu Stein!", COLORS.Lava)
	lava(376, 428, -half, half)
	for i, x in ipairs({ -0.4, 0.45, -0.3, 0.5, -0.5, 0.1, -0.35, 0.3 }) do
		part({
			Name = "Stone",
			Size = Vector3.new(4, 1.4, 4),
			Position = world(374 + i * 6.5, half * x, TOP + 0.7),
			Material = Enum.Material.Slate,
			Color = COLORS.Stone,
			Parent = decoFolder,
		})
	end

	-- CHECKPOINTS
	respawnCF[1] = CFrame.lookAt(world(START_RESPAWN_D, 0, TOP + 3.5), world(START_RESPAWN_D + 10, 0, TOP + 3.5))
	for index, d in ipairs(CHECKPOINT_D) do
		checkpointPad(index, d)
	end

	-- ZIEL: Tor, Linie, Podest mit Belohnungs-Ei, Rampe runter (Richtung Basen)
	gate(FINISH_D, COLORS.Finish, 12)
	line(FINISH_D, true)
	local finishSign = anchorPart("FinishSign", world(FINISH_D, 0, TOP + 18), decoFolder)
	worldSign(finishSign, 20, 5, {
		{ Name = "Title", Text = "🏁 ZIEL 🏁", Color = COLORS.Finish, Height = 0.62 },
		{ Name = "Hint", Text = "Gratis-Ei – dann schnell heimtragen!", Color = WHITE, Height = 0.38 },
	})
	local podiumD = 444
	part({
		Name = "Podium",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 7, 7),
		CFrame = CFrame.new(world(podiumD, 0, TOP + 1)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(255, 205, 60),
		Parent = decoFolder,
	})
	part({
		Name = "PodiumRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 7.6, 7.6),
		CFrame = CFrame.new(world(podiumD, 0, TOP + 2)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 120, 200),
		CanCollide = false,
		CastShadow = false,
		Parent = decoFolder,
	})
	local egg = part({
		Name = "RewardEgg",
		Size = Vector3.new(3, 3, 3),
		Position = world(podiumD, 0, TOP + 4.6),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(180, 80, 255),
		CanCollide = false,
		CanQuery = false,
		Parent = decoFolder,
	})
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.35, 1)
	mesh.Parent = egg
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(220, 140, 255)
	light.Range = 16
	light.Brightness = 2
	light.Shadows = false
	light.Parent = egg
	egg:SetAttribute("Bob", true) -- Client lässt es schweben und drehen
	local eggSign = anchorPart("EggSign", world(podiumD, 0, TOP + 8.5), decoFolder)
	worldSign(eggSign, 9, 2.2, {
		{ Name = "Title", Text = "🥚 Belohnungs-Ei", Color = Color3.fromRGB(230, 180, 255), Height = 1 },
	})
	-- Rampe vom Podest runter auf die Wiese (zur Seite der Basen)
	local exitTop = world(podiumD, -half, TOP)
	local exitBottom = world(podiumD, -half - RAMP_LENGTH, 0)
	part({
		Name = "ExitRamp",
		Size = Vector3.new(8, 1, (exitTop - exitBottom).Magnitude),
		CFrame = CFrame.lookAt((exitTop + exitBottom) / 2, exitTop) * CFrame.new(0, -0.5, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = COLORS.DeckAlt,
		Parent = decoFolder,
	})

	-- Werte für die Prüfung
	startSpawnCF = CFrame.lookAt(world(2.5, 0, TOP + 3.5), world(12, 0, TOP + 3.5))
	readyMinZ = Z0 + READY_FROM_D
	readyMaxZ = Z0 + START_LINE_D
	finishZ = Z0 + FINISH_D
	exitMinZ = Z0 + podiumD - 6
	exitMaxZ = Z0 + podiumD + 6
	lineMinX = X0 - half - 3
	lineMaxX = X0 + half + 3
	areaMinX = X0 - AREA_SIDE
	areaMaxX = X0 + AREA_SIDE
	areaMinZ = Z0 - RAMP_LENGTH - AREA_END
	areaMaxZ = Z0 + END_D + AREA_END
	exitMinX = X0 - half - RAMP_LENGTH - 6
	local length = FINISH_D - START_LINE_D
	local fastest = (tonumber(Config.MaxWalkSpeed) or 80) * SPEED_TOLERANCE
	minRunTime = length / fastest

	root:SetAttribute("CheckpointCount", #CHECKPOINT_D)
	root:SetAttribute("Length", length)
	root:SetAttribute("MinTime", minRunTime)
	root:SetAttribute("StartCFrame", startSpawnCF)
	root.Parent = map
	return root
end

-- -------------------------------------------------------------------
-- LAUF-LOGIK
-- -------------------------------------------------------------------
local function publish(player: Player, run: RunState?)
	if run then
		player:SetAttribute("RunActive", true)
		player:SetAttribute("RunStart", if run.Phase == "Running" then run.Start else 0)
		player:SetAttribute("RunCP", run.CP)
	else
		player:SetAttribute("RunActive", false)
		player:SetAttribute("RunStart", 0)
		player:SetAttribute("RunCP", 0)
	end
end

local function teleport(player: Player, cf: CFrame)
	local character = player.Character
	if not character then
		return
	end
	character:PivotTo(cf)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.AssemblyLinearVelocity = Vector3.zero
	end
	Services.CarryService.NoteTeleport(player, cf.Position)
	lastPos[player] = cf.Position
end

local function cancelRun(player: Player, text: string?)
	if not runs[player] then
		return
	end
	runs[player] = nil
	publish(player, nil)
	if text then
		Services.EconomyService.Notify(player, text, "Info")
	end
end

local function resetToCheckpoint(player: Player, run: RunState, reason: string)
	local cf = respawnCF[run.CP + 1] or respawnCF[1]
	teleport(player, cf)
	Services.EconomyService.Effect(player, "RunReset", 0, { Reason = reason })
	notifyLimited(player, RESET_TEXT[reason] or "↩️ Zurück zum Checkpoint!", "Error")
end

-- Steht/läuft der Spieler zwischen a und b auf einem Lava-Feld? (beide Messungen am Boden)
local function touchedLava(a: Vector3, b: Vector3, stand: number): boolean
	for _, box in ipairs(lavaBoxes) do
		local ha, hb = a.Y - box.Top, b.Y - box.Top
		if ha > 0.5 and hb > 0.5 and ha <= stand + 0.6 and hb <= stand + 0.6 and segmentHitsBox(a, b, box) then
			return true
		end
	end
	return false
end

local function updateRecordSign()
	local label = recordLabel
	local record = serverRecord
	if label and record then
		label.Text = "🏆 Rekord: " .. record.Name .. " – " .. formatRunTime(record.Time)
	end
end

local function rollEggRarity(luck: number, rebirths: number): string
	local pick = Util.WeightedPick(EGG_TABLE, function(item): number
		local list = Config.MeteorsByRarity[item.Rarity]
		if not Config.RaritiesByName[item.Rarity] or not list or #list == 0 then
			return 0
		end
		if rebirths < (item.MinRebirths or 0) then
			return 0
		end
		return if item.Lucky then item.Weight * luck else item.Weight
	end, rng)
	return pick.Rarity
end

-- Belohnung: Cash + Gratis-Ei zum Heimtragen (Base voll -> Verkaufswert als Cash)
local function giveReward(player: Player, data, elapsed: number, newBest: boolean): string
	local Economy = Services.EconomyService
	local cash = math.floor(
		math.max(RUN_MIN_CASH, Economy.GetIncome(player) * RUN_CASH_SECONDS)
			* (if newBest then NEW_BEST_CASH_MULT else 1)
	)
	Economy.AddCash(player, cash)
	Economy.Effect(player, "Collect", cash)
	local text = " +" .. Util.FormatCash(cash)

	local rebirths = tonumber(data.Rebirths) or 0
	local luck = 1
		+ math.clamp((PAR_TIME - elapsed) / PAR_TIME, 0, 0.6)
		+ math.min(rebirths, 10) * REBIRTH_LUCK
		+ (if newBest then 0.25 else 0)
	local Meteor = Services.MeteorService
	local def = Meteor.RandomOfRarity(rollEggRarity(luck, rebirths))
	if not def then
		return text
	end
	local entry = { Id = def.Id, Mut = Meteor.RollMutation(1), Lv = 1, Xp = 0 }
	local label = (if entry.Mut ~= "Normal" then entry.Mut .. " " else "") .. def.Name .. " (" .. def.Rarity .. ")"
	local root = aliveRoot(player)
	local canCarry = root ~= nil
		and Services.PlotService.GetPlot(player) ~= nil
		and Services.PlotService.FreeSlot(player) ~= nil
		and not Services.CarryService.IsCarrying(player)
	if root and canCarry then
		Services.CarryService.StartCarry(player, entry, {
			Source = "Ground",
			From = "Run",
			GrabPosition = root.Position,
		})
		if (Config.RarityIndex[def.Rarity] or 0) >= ANNOUNCE_RARITY then
			Economy.NotifyAll(
				"☄️ "
					.. player.DisplayName
					.. " hat den Meteor-Run geschafft und trägt ein "
					.. def.Rarity
					.. "-Ei heim – BONK IHN! 🔨",
				"Event"
			)
		end
		return text .. " 🥚 " .. label .. " – TRAG ES HEIM! 🏃"
	end
	local value = math.floor(Config.MeteorValue(entry) * Config.SellRatio)
	Economy.AddCash(player, value)
	return text .. " 📦 Base voll – " .. Util.FormatCash(value) .. " statt " .. label
end

local function finishRun(player: Player, run: RunState)
	local elapsed = now() - run.Start
	runs[player] = nil
	publish(player, nil)
	local admin = Services.AdminService
	if elapsed < minRunTime and not (admin and admin.IsAdmin(player)) then
		Services.EconomyService.Notify(player, "🚫 Unmöglich schnell – dieser Run zählt nicht!", "Error")
		return
	end
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	local oldBest = tonumber(data.RunBest)
	if oldBest and (oldBest ~= oldBest or oldBest <= 0) then
		oldBest = nil
	end
	local newBest = oldBest == nil or elapsed < oldBest
	local best = elapsed
	if newBest then
		data.RunBest = math.floor(elapsed * 100 + 0.5) / 100
		player:SetAttribute("RunBest", data.RunBest)
	elseif oldBest then
		best = oldBest
	end
	if not serverRecord or elapsed < serverRecord.Time then
		serverRecord = { Name = player.DisplayName, Time = elapsed }
		updateRecordSign()
	end

	local t = now()
	local cooldownEnd = cooldownUntil[player.UserId] or 0
	local rewarded = t >= cooldownEnd
	Services.EconomyService.Effect(
		player,
		"RunFinish",
		elapsed,
		{ Time = elapsed, Best = best, NewBest = newBest, Reward = rewarded }
	)
	local timeText = "🏁 ZIEL in "
		.. formatRunTime(elapsed)
		.. "!"
		.. (if newBest then " 🏆 NEUE BESTZEIT!" else "")
	if not rewarded then
		Services.EconomyService.Notify(
			player,
			timeText .. " ⏳ Nächste Belohnung in " .. Util.FormatTime(math.ceil(cooldownEnd - t)),
			"Info"
		)
		Services.EconomyService.MarkDirty(player)
		return
	end
	cooldownUntil[player.UserId] = t + REWARD_COOLDOWN
	player:SetAttribute("RunCooldownUntil", t + REWARD_COOLDOWN)
	local rewardText = giveReward(player, data, elapsed, newBest)
	Services.EconomyService.Notify(player, timeText .. rewardText, "Success")
	Services.EconomyService.MarkDirty(player)
end

-- Ein Prüf-Schritt für einen Spieler (alle TICK Sekunden)
local function stepPlayer(player: Player)
	local root, humanoid = aliveRoot(player)
	local run = runs[player]
	if not root or not humanoid then
		if run then
			cancelRun(player)
		end
		return
	end
	local pos = root.Position
	local last = lastPos[player] or pos
	lastPos[player] = pos
	if not run then
		-- Nicht im Run: Start-Tor betreten? Lava berührt? (z.B. von der Seite reingesprungen)
		if not inArea(pos) then
			return
		end
		-- Wer schnell ist, rennt in einem Takt durchs Tor UND über die Linie -> sofort "Running"
		local dashed = crossedLine(last, pos, readyMaxZ) and last.Z >= Z0 - RAMP_LENGTH
		if inReadyZone(pos) or dashed then
			if Services.CarryService.IsCarrying(player) then
				notifyLimited(player, "🎒 Mit Beute kein Run – erst nach Hause bringen!", "Error")
			elseif Services.EconomyService.IsReady(player) then
				local newRun: RunState = {
					Phase = if dashed then "Running" else "Ready",
					Start = if dashed then now() else 0,
					CP = 0,
				}
				runs[player] = newRun
				publish(player, newRun)
				Services.EconomyService.Effect(player, if dashed then "RunStart" else "RunReady", 0)
			end
		elseif
			not Services.CarryService.IsCarrying(player) -- mit Beute wird nie teleportiert
			and touchedLava(last, pos, standHeight(humanoid, root))
		then
			teleport(player, startSpawnCF)
			notifyLimited(player, "🔥 Lava! Starte den Run am Tor ☄️", "Error")
		end
		return
	end

	if Services.CarryService.IsCarrying(player) then
		cancelRun(player, "🎒 Mit Beute kein Run – abgebrochen.")
		return
	end
	if not inArea(pos) then
		cancelRun(player, "☄️ Meteor-Run abgebrochen.")
		return
	end
	if Services.CarryService.MoveStatus(player) == "flagged" then
		cancelRun(player, "🚫 Unmöglich schnell – Run abgebrochen!")
		return
	end

	if run.Phase == "Ready" then
		if crossedLine(last, pos, readyMaxZ) then
			run.Phase = "Running"
			run.Start = now()
			publish(player, run)
			Services.EconomyService.Effect(player, "RunStart", 0)
		elseif not inReadyZone(pos) then
			cancelRun(player) -- zurück aus dem Tor gelaufen
		end
		return
	end

	-- Running
	if now() - run.Start > MAX_RUN_TIME then
		cancelRun(player, "⏰ Zu lange – Meteor-Run abgebrochen.")
		return
	end
	if inReadyZone(pos) then
		-- zurück ins Start-Tor = Neustart
		run.Phase = "Ready"
		run.Start = 0
		run.CP = 0
		publish(player, run)
		return
	end
	if pos.Y < TOP - FALL_DEPTH then
		if pos.X < lineMinX and pos.Z >= exitMinZ and pos.Z <= exitMaxZ then
			cancelRun(player, "☄️ Meteor-Run abgebrochen.") -- über die Ziel-Rampe runter (ohne alle Checkpoints)
		else
			resetToCheckpoint(player, run, "fall")
		end
		return
	end
	if touchedLava(last, pos, standHeight(humanoid, root)) then
		resetToCheckpoint(player, run, "lava")
		return
	end
	local nextIndex = run.CP + 1
	local nextZ = checkpointZ[nextIndex]
	if nextZ and crossedLine(last, pos, nextZ) then
		run.CP = nextIndex
		publish(player, run)
		Services.EconomyService.Effect(player, "RunCheckpoint", nextIndex, {
			Position = Vector3.new(X0, TOP + 0.5, nextZ),
			Time = now() - run.Start,
		})
		return
	end
	if crossedLine(last, pos, finishZ) then
		if run.CP >= #checkpointZ then
			finishRun(player, run)
		else
			notifyLimited(player, "🚩 Du hast einen Checkpoint verpasst!", "Error")
		end
	end
end

-- -------------------------------------------------------------------
-- METEOR-EINSCHLÄGE
-- -------------------------------------------------------------------
local pendingImpacts = 0
local impactClock = 0
local runnerRoots: { BasePart } = {}

local function scheduleImpact(position: Vector3)
	pendingImpacts += 1
	Remotes.Effect:FireAllClients("RunImpact", 0, {
		Position = position,
		Radius = IMPACT_RADIUS,
		At = now() + IMPACT_WARN,
	})
	task.delay(IMPACT_WARN, function()
		pendingImpacts -= 1
		local hitRadius = IMPACT_RADIUS + 1
		for player, run in pairs(runs) do
			if run.Phase == "Running" then
				local root = aliveRoot(player)
				if root then
					local p = root.Position
					local dx, dz = p.X - position.X, p.Z - position.Z
					if dx * dx + dz * dz <= hitRadius * hitRadius and p.Y > position.Y - 1 and p.Y < position.Y + 9 then
						resetToCheckpoint(player, run, "impact")
					end
				end
			end
		end
	end)
end

local function stepImpacts(dt: number)
	table.clear(runnerRoots)
	local zoneMin = Z0 + IMPACT_FROM_D - 10
	local zoneMax = Z0 + IMPACT_TO_D + 6
	for player, run in pairs(runs) do
		if run.Phase == "Running" and run.CP == IMPACT_AFTER_CP then
			local root = aliveRoot(player)
			if root and root.Position.Z >= zoneMin and root.Position.Z <= zoneMax then
				table.insert(runnerRoots, root)
			end
		end
	end
	if #runnerRoots == 0 then
		impactClock = 0
		return
	end
	impactClock += dt
	if impactClock < IMPACT_INTERVAL or pendingImpacts >= IMPACT_MAX then
		return
	end
	impactClock = 0
	local half = WIDTH / 2 - 1
	local x = X0 + rng:NextNumber(-half, half)
	local z = Z0 + rng:NextNumber(IMPACT_FROM_D, IMPACT_TO_D)
	if rng:NextNumber() < IMPACT_AIM_CHANCE then
		local root = runnerRoots[rng:NextInteger(1, #runnerRoots)]
		local velocity = root.AssemblyLinearVelocity
		local aim = root.Position + Vector3.new(velocity.X, 0, velocity.Z) * IMPACT_LEAD
		x = math.clamp(aim.X, X0 - half, X0 + half)
		z = math.clamp(aim.Z, Z0 + IMPACT_FROM_D, Z0 + IMPACT_TO_D)
	end
	scheduleImpact(Vector3.new(x, TOP, z))
end

-- -------------------------------------------------------------------
-- ÖFFENTLICH
-- -------------------------------------------------------------------
-- Request "GoRun": zum Start-Tor teleportieren (nicht beim Tragen)
function RunService.Teleport(player: Player): (boolean, string)
	if not runFolder then
		return false, "☄️ Der Meteor-Run ist gerade nicht da."
	end
	if Services.CarryService.IsCarrying(player) then
		return false, "Mit Beute musst du laufen! 🏃"
	end
	local root = aliveRoot(player)
	if not root then
		return false, "Kein Charakter"
	end
	if root.Anchored then
		return false, "🧊 Du bist eingefroren!"
	end
	cancelRun(player)
	teleport(player, startSpawnCF)
	return true, "☄️ Lauf durchs Tor – über der Linie startet der Timer!"
end

-- Läuft der Spieler gerade den Meteor-Run? (z.B. für andere Services)
function RunService.IsRunning(player: Player): boolean
	return runs[player] ~= nil
end

function RunService.Init(services)
	Services = services
	local map = Services.PlotService.MapFolder
	if not map then
		warn("[RunService] Keine Map – Meteor-Run wird nicht gebaut")
		return
	end
	local old = map:FindFirstChild("MeteorRun")
	if old then
		old:Destroy()
	end
	computeLayout(map)
	-- Platz schaffen: Strecke + Rampen (Bäume/Büsche weg, andere Teile melden)
	local half = WIDTH / 2
	local zMin = Z0 - RAMP_LENGTH - 2
	local zMax = Z0 + END_D + 2
	clearArea(map, Vector3.new(X0, 16, (zMin + zMax) / 2), Vector3.new(WIDTH + 8, 30, zMax - zMin))
	clearArea(map, Vector3.new(X0 - half - RAMP_LENGTH / 2 - 2, 10, Z0 + 444), Vector3.new(RAMP_LENGTH + 4, 18, 12))
	runFolder = build(map)
end

function RunService.Start()
	if not runFolder then
		return
	end
	Services.DataService.OnProfileLoaded(function(player: Player, data)
		local best = tonumber(data.RunBest)
		if best and best == best and best > 0 and best < math.huge then
			player:SetAttribute("RunBest", best)
		else
			data.RunBest = nil
		end
		local cooldown = cooldownUntil[player.UserId]
		if cooldown then
			player:SetAttribute("RunCooldownUntil", cooldown)
		end
	end)

	local function onPlayer(player: Player)
		publish(player, nil)
		player.CharacterAdded:Connect(function()
			cancelRun(player) -- neuer Charakter (gestorben, Reset) -> Run ist vorbei
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		runs[player] = nil
		notifyAt[player] = nil
		lastPos[player] = nil
	end)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(TICK)
			local clock = os.clock()
			local dt = math.clamp(clock - last, 0, 1)
			last = clock
			for _, player in ipairs(Players:GetPlayers()) do
				local ok, err = pcall(stepPlayer, player)
				if not ok then
					warn("[RunService] Fehler bei " .. player.Name .. ": " .. tostring(err))
				end
			end
			local ok, err = pcall(stepImpacts, dt)
			if not ok then
				warn("[RunService] Einschlag-Fehler: " .. tostring(err))
			end
		end
	end)
end

return RunService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">TreadmillService</string>
            <string name="Source"><![CDATA[-- SPEED FARM: Laufbänder (Treadmills) in der Laufband-Zone am Spawn-Platz.
-- Wer auf einem freigeschalteten Laufband läuft, bekommt alle Config.TreadmillTick Sekunden
-- Schritte 👟 (+ fliegende Zahl beim Client). Mehr Schritte = schneller laufen (Config.StepsSpeed).
-- Höhere Laufbänder werden durch genug Schritte freigeschaltet (Config.Treadmills -> Required).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))

local TreadmillService = {}
local Services

-- { Def, Belt, CFrame, HalfX, HalfZ, TopY } – aufsteigend nach Required
local treadmills = {}
local zoneCenter = Vector3.zero
local zoneRadius = 0
local lastLockedNotify: { [Player]: number } = {}
-- true = beim Server kommt Humanoid.MoveDirection an (schon einmal gesehen) -> keine Ersatz-Prüfung nötig
local moveDirectionWorks: { [Player]: boolean } = {}

local MAX_HEIGHT = 8 -- HumanoidRootPart höchstens so hoch über der Lauffläche (Springen zählt mit)
local LOCKED_NOTIFY_COOLDOWN = 3
local MIN_MOVE = 0.1 -- Humanoid.MoveDirection muss mindestens so lang sein (= Spieler läuft)
-- Ersatz-Prüfung über die Physik (nur falls MoveDirection beim Server nie ankommt):
-- Wer stillsteht, fährt mit dem Band mit (gleiches Tempo wie das Band). Wer läuft (oder vorne gegen
-- die Konsole läuft), ist entlang der Bandrichtung deutlich langsamer/schneller als das Band.
local MIN_RELATIVE_SPEED = 4
-- ...und nur, wenn man wirklich AUF dem Band steht: Hüfte in normaler Stehhöhe über der Lauffläche.
-- Auf dem Seitenrahmen (0,7 höher) oder der Konsole steht man höher -> zählt nicht.
local STAND_TOLERANCE = 0.45
local RESCAN_INTERVAL = 5

-- Laufbänder aus der Map einlesen (MapBuilder baut je Eintrag in Config.Treadmills ein Model)
local function collect()
	table.clear(treadmills)
	local folder = Services.PlotService.TreadmillsFolder
	if not folder then
		return
	end
	local sum = Vector3.zero
	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") then
			local id = model:GetAttribute("TreadmillId") or model.Name
			local def = type(id) == "string" and Config.TreadmillsById[id] or nil
			local belt = model.PrimaryPart or model:FindFirstChild("Belt")
			if def and belt and belt:IsA("BasePart") then
				table.insert(treadmills, {
					Def = def,
					Belt = belt,
					CFrame = belt.CFrame,
					-- Lauffläche OHNE Spielraum: direkt daneben stehen Seitenrahmen, Konsole und Chassis.
					-- Wer dort stillsteht, darf nicht als "läuft auf dem Band" zählen.
					HalfX = belt.Size.X / 2,
					HalfZ = belt.Size.Z / 2,
					TopY = belt.Size.Y / 2,
				})
				sum += belt.Position
			end
		end
	end
	table.sort(treadmills, function(a, b)
		return a.Def.Required < b.Def.Required
	end)
	if #treadmills > 0 then
		-- grobe Vorab-Prüfung: Kreis um alle Laufbänder (spart Rechnen, wenn niemand dort ist)
		zoneCenter = sum / #treadmills
		zoneRadius = 0
		for _, treadmill in ipairs(treadmills) do
			local reach = (treadmill.CFrame.Position - zoneCenter).Magnitude
				+ math.sqrt(treadmill.HalfX ^ 2 + treadmill.HalfZ ^ 2)
			zoneRadius = math.max(zoneRadius, reach + MAX_HEIGHT)
		end
	end
end

-- Auf welchem Laufband steht diese Position? (lokale Koordinaten zur Lauffläche)
function TreadmillService.FindTreadmill(position: Vector3)
	if #treadmills == 0 or (position - zoneCenter).Magnitude > zoneRadius then
		return nil
	end
	for _, treadmill in ipairs(treadmills) do
		local localPos = treadmill.CFrame:PointToObjectSpace(position)
		local height = localPos.Y - treadmill.TopY
		if
			math.abs(localPos.X) <= treadmill.HalfX
			and math.abs(localPos.Z) <= treadmill.HalfZ
			and height > -0.5
			and height < MAX_HEIGHT
		then
			return treadmill
		end
	end
	return nil
end

-- Normale Höhe des HumanoidRootPart über dem Boden, wenn man steht (R15 bzw. R6)
local function standHeight(humanoid: Humanoid, root: BasePart): number
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	return root.Size.Y / 2 + 2 -- R6: Beine sind 2 Studs lang
end

-- Ersatz-Prüfung über die Physik: steht der Spieler auf DIESEM Band und ist er entlang der
-- Bandrichtung deutlich anders schnell als das Band (= er läuft dagegen an)?
local function walkingByPhysics(treadmill, humanoid: Humanoid, root: BasePart): boolean
	local belt: BasePart = treadmill.Belt
	local localPos = treadmill.CFrame:PointToObjectSpace(root.Position)
	local height = localPos.Y - treadmill.TopY
	if math.abs(height - standHeight(humanoid, root)) > STAND_TOLERANCE then
		return false -- springt, oder steht auf Seitenrahmen/Konsole statt auf dem Band
	end
	local beltVelocity = belt.AssemblyLinearVelocity
	local beltSpeed = beltVelocity.Magnitude
	if beltSpeed < 0.01 then
		return false
	end
	local along = beltVelocity / beltSpeed
	local relative = beltSpeed - root.AssemblyLinearVelocity:Dot(along)
	return math.abs(relative) > MIN_RELATIVE_SPEED
end

local function tickPlayer(player: Player)
	local data = Services.DataService.Get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not data or not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	-- nur wer läuft, sammelt Schritte
	local walking = humanoid.MoveDirection.Magnitude > MIN_MOVE
	if walking then
		moveDirectionWorks[player] = true
	end
	local treadmill = TreadmillService.FindTreadmill(root.Position)
	if not treadmill then
		return
	end
	if not walking and not moveDirectionWorks[player] then
		walking = walkingByPhysics(treadmill, humanoid, root)
	end
	if not walking then
		return
	end
	local def = treadmill.Def
	if data.Steps < def.Required then
		local t = os.clock()
		if t - (lastLockedNotify[player] or 0) >= LOCKED_NOTIFY_COOLDOWN then
			lastLockedNotify[player] = t
			Services.EconomyService.Notify(
				player,
				"🔒 " .. def.Name .. " braucht " .. Util.FormatNumber(def.Required) .. " 👟",
				"Error"
			)
		end
		return
	end
	local gain = def.Rate * Services.EconomyService.GetStepsMult(player)
	Services.EconomyService.AddSteps(player, gain) -- passt die Laufgeschwindigkeit an + MarkDirty
	Remotes.Effect:FireClient(player, "Steps", gain)
	-- Tagesaufgabe "Lauf X Schritte" (ein Fehler dort darf das Schritte-Sammeln nicht stoppen)
	local rewards = Services.RewardService
	if rewards and rewards.Track then
		local ok, err = pcall(rewards.Track, player, "Steps", gain)
		if not ok then
			warn("[TreadmillService] RewardService.Track fehlgeschlagen: " .. tostring(err))
		end
	end
end

function TreadmillService.Init(services)
	Services = services
end

function TreadmillService.Start()
	collect()
	if #treadmills == 0 then
		warn("[TreadmillService] Keine Laufbänder gefunden – suche weiter...")
	end

	Players.PlayerRemoving:Connect(function(player)
		lastLockedNotify[player] = nil
		moveDirectionWorks[player] = nil
	end)

	task.spawn(function()
		local lastScan = os.clock()
		while true do
			task.wait(Config.TreadmillTick)
			if #treadmills == 0 and os.clock() - lastScan >= RESCAN_INTERVAL then
				lastScan = os.clock()
				collect()
			end
			if #treadmills > 0 then
				for _, player in ipairs(Players:GetPlayers()) do
					local ok, err = pcall(tickPlayer, player)
					if not ok then
						warn("[TreadmillService] Fehler bei " .. player.Name .. ": " .. tostring(err))
					end
				end
			end
		end
	end)
end

return TreadmillService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="28">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="29">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="31">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  METEOR HEIST – Client (alles, was der Spieler sieht)
--  Dieses Skript startet nur die Module im Ordner "Modules" und verbindet sie mit dem Server:
--    UI         Baukasten (Knöpfe, Fenster, Toasts, zählende Zahlen)
--    Hud        Knöpfe links/rechts (mit Badges), Schritte + Geld, Banner (Schauer, Egg Rush),
--               Wegweiser (Base beim Tragen, nächstes Ei), Prompt-Hinweis am Förderband
--    Windows    Shop (Gamepässe / Boosts / Gadgets), Laufbänder, Rebirth, Tagesbonus, Alien-Index
--    Rewards    🎁 Geschenke, 🎡 Glücksrad, 📜 Tagesaufgaben
--    Effects    fliegende Zahlen, Lieferflug, Schlüpf-Explosion, Hatch-Karte, Wackeln, Konfetti
--    WorldFX    Laufband-Meteore, Streifen, wippende Aliens, Regenbogen, Schlüpf-Countdown
--    Prompts    Klauen/Kaufen/Verkaufen-Prompts passend ein-/ausblenden
--    Fly, PhotoMode, AdminPanel (nur für Admins)
--  Die gesamte Oberfläche wird per Code gebaut – du musst nichts in Studio zusammenklicken.
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util"))
local Aliens = require(Shared:WaitForChild("Aliens")) :: any

local Modules = script.Parent:WaitForChild("Modules")
local UI = require(Modules:WaitForChild("UI"))
local Hud = require(Modules:WaitForChild("Hud"))
local Windows = require(Modules:WaitForChild("Windows"))
local Rewards = require(Modules:WaitForChild("Rewards"))
local Effects = require(Modules:WaitForChild("Effects"))
local WorldFX = require(Modules:WaitForChild("WorldFX"))
local Prompts = require(Modules:WaitForChild("Prompts"))
local Fly = require(Modules:WaitForChild("Fly"))
local PhotoMode = require(Modules:WaitForChild("PhotoMode"))
local AdminPanel = require(Modules:WaitForChild("AdminPanel"))
local MeteorRun = require(Modules:WaitForChild("MeteorRun"))

local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local Remotes = {
	Notify = RemotesFolder:WaitForChild("Notify") :: RemoteEvent,
	State = RemotesFolder:WaitForChild("State") :: RemoteEvent,
	Effect = RemotesFolder:WaitForChild("Effect") :: RemoteEvent,
	Request = RemotesFolder:WaitForChild("Request") :: RemoteFunction,
	Admin = RemotesFolder:WaitForChild("Admin") :: RemoteFunction,
}

-- ---------------------------------------------------------------------
-- GRUNDGERÜST
-- ---------------------------------------------------------------------
local gui = UI.Create("ScreenGui", {
	Name = "MeteorHeistUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = false,
	Parent = player:WaitForChild("PlayerGui"),
}) :: ScreenGui
UI.Init(gui)

-- Gemeinsamer "Rucksack" für alle Module
local ctx = {
	Player = player,
	Config = Config,
	Util = Util,
	Aliens = Aliens,
	Remotes = Remotes,
	Gui = gui,
	State = nil :: any, -- letzte Daten vom Server
	StateTime = os.clock(), -- wann der letzte State ankam (Countdowns darin gelten ab dann)
	Toast = UI.Toast,
	Request = nil :: any,
	RequestFull = nil :: any,
	Hooks = {} :: { [string]: (number) -> () },
	Hud = Hud,
	Windows = Windows,
	Rewards = Rewards,
	Effects = Effects,
	Prompts = Prompts,
	Fly = Fly,
	PhotoMode = PhotoMode,
}

-- Anfrage an den Server mit ganzer Antwort: (Erfolg, Antwort-Tabelle oder nil).
-- silent = true: keinen Toast zeigen (z.B. Glücksrad – Gewinn erst nach dem Drehen anzeigen).
function ctx.RequestFull(action: string, arg: any?, silent: boolean?): (boolean, { [string]: any }?)
	local ok, result = pcall(function()
		return Remotes.Request:InvokeServer(action, arg)
	end)
	if ok and type(result) == "table" then
		if not silent and type(result.Message) == "string" and result.Message ~= "" then
			UI.Toast(result.Message, if result.Ok then "Success" else "Error")
		end
		return result.Ok == true, result
	end
	if not silent then
		UI.Toast("📡 Keine Antwort vom Server – nochmal versuchen!", "Error")
	end
	return false, nil
end

-- Anfrage an den Server (Rebirth, Daily, Collect, Home, Treadmills, ClaimGift, ClaimQuest,
-- BuyGadget ...). Gibt true bei Erfolg zurück.
function ctx.Request(action: string, arg: any?): boolean
	local ok = ctx.RequestFull(action, arg)
	return ok
end

ctx.Hooks.OnSteps = function(_amount: number)
	Hud.PulseSteps()
end
ctx.Hooks.OnCash = function(_amount: number)
	Hud.PulseCash()
end

-- ---------------------------------------------------------------------
-- MODULE STARTEN
-- ---------------------------------------------------------------------
Effects.Init(ctx)
Windows.Init(ctx)
Rewards.Init(ctx)
Hud.Init(ctx)
Fly.Init(UI.Toast)
PhotoMode.Init(ctx)
MeteorRun.Start(ctx) -- ☄️ Meteor-Run: HUD, Balken, Einschläge, Knopf "☄️ Run"

-- Welt-Sachen brauchen die Map (wird vom Server gebaut) -> im Hintergrund warten
task.spawn(function()
	local map = workspace:WaitForChild("MeteorHeistMap", 120)
	if not map then
		warn("[Client] MeteorHeistMap nicht gefunden – Welt-Animationen aus")
		return
	end
	Hud.SetMap(map)
	Prompts.Init(map, ctx)
	WorldFX.Init(ctx, map)
	if ctx.State then
		WorldFX.UpdateTreadmills(tonumber(ctx.State.Steps) or 0, ctx.State.BestTreadmill)
	end
end)

-- ---------------------------------------------------------------------
-- DATEN VOM SERVER
-- ---------------------------------------------------------------------
local function refreshAll()
	local state = ctx.State
	if not state then
		return
	end
	Hud.Refresh(state)
	Windows.Refresh(state)
	Prompts.OnState(state)
	WorldFX.UpdateTreadmills(tonumber(state.Steps) or 0, state.BestTreadmill)
end

-- Selten geänderte Teile (Index, Pässe, Statistik, Geschenke + GiftsAt, Aufgaben) schickt der Server
-- nur bei Änderung mit. Fehlen sie in einem Paket, gelten die zuletzt bekommenen weiter.
local STICKY_KEYS = { "Index", "Passes", "Stats", "Gifts", "GiftsAt", "Quests" }

Remotes.State.OnClientEvent:Connect(function(newState)
	if type(newState) ~= "table" then
		return
	end
	local old = ctx.State
	if old then
		for _, key in ipairs(STICKY_KEYS) do
			if newState[key] == nil then
				newState[key] = old[key]
			end
		end
	end
	ctx.State = newState
	ctx.StateTime = os.clock()
	refreshAll()
end)
Remotes.Notify.OnClientEvent:Connect(function(text, kind)
	UI.Toast(tostring(text), if type(kind) == "string" then kind else "Info")
end)
Remotes.Effect.OnClientEvent:Connect(function(name, strength, data)
	Effects.Play(name, strength, data)
end)

-- Jede Sekunde: Banner, Badges, Countdowns (Tagesbonus, Geschenke, Gratis-Dreh, Aufgaben)
local function tick()
	Hud.Tick()
	Rewards.Tick()
	local state = ctx.State
	if state and state.DailyReady == false then
		state.DailyIn = math.max(0, (tonumber(state.DailyIn) or 0) - 1)
		if state.DailyIn == 0 then
			state.DailyReady = true
			Hud.Refresh(state)
		end
		Windows.RefreshDaily(state)
	end
end
task.spawn(function()
	while true do
		-- Ein Fehler darf die Schleife nicht für immer anhalten
		local ok, err = pcall(tick)
		if not ok then
			warn("[Client] Tick-Fehler: " .. tostring(err))
		end
		task.wait(1)
	end
end)

-- ---------------------------------------------------------------------
-- ADMIN-PANEL (nur wenn der Server dich als Admin markiert)
-- ---------------------------------------------------------------------
local function checkAdmin()
	if player:GetAttribute("IsAdmin") == true then
		AdminPanel.Build(ctx)
	end
end
player:GetAttributeChangedSignal("IsAdmin"):Connect(checkAdmin)
checkAdmin()

-- Willkommen – mit den Tasten des Geräts (Handy: halten/tippen, Controller: [X]/[Y], PC: [E]/[F])
local inputStyle = Hud.InputStyle()
local grabKey = if inputStyle == "Touch" then "halten" elseif inputStyle == "Gamepad" then "[X] halten" else "[E] halten"
local buyKey = if inputStyle == "Touch" then "tippen" elseif inputStyle == "Gamepad" then "[Y]" else "[F]"
UI.Toast(
	"☄️ Willkommen bei "
		.. tostring(Config.GameName)
		.. "! Klau Eier am Förderband ("
		.. grabKey
		.. ") – gratis!",
	"Event"
)
task.delay(4, function()
	UI.Toast("🏃 Schnell heimtragen – oder kaufen (" .. buyKey .. "), dann werden sie geliefert!", "Info")
end)
task.delay(8, function()
	UI.Toast("🐣 In deiner Base schlüpfen Aliens – die bringen dir Geld!", "Info")
end)
]]></string>
