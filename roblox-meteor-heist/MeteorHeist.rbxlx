      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- =====================================================================
--  METEOR HEIST – Server-Start
--  Lädt alle Services in der richtigen Reihenfolge. Hier musst du nichts ändern.
-- =====================================================================

local Players = game:GetService("Players")
local ServicesFolder = script.Parent:WaitForChild("Services")

local order = {
	"DataService",
	"MonetizationService",
	"PlotService",
	"MeteorService",
	"CarryService",
	"EconomyService",
	"AdminService",
	"LeaderboardService",
}

local Services = {}
for _, name in ipairs(order) do
	Services[name] = require(ServicesFolder:WaitForChild(name))
end

-- Phase 1: Init (Map bauen, Verweise setzen)
for _, name in ipairs(order) do
	local service = Services[name]
	if service.Init then
		service.Init(Services)
	end
end

-- Phase 2: Start (Schleifen + Events). DataService zuletzt, damit alle
-- "Spielstand geladen"-Callbacks schon registriert sind.
for _, name in ipairs(order) do
	local service = Services[name]
	if name ~= "DataService" and service.Start then
		service.Start()
	end
end
Services.DataService.Start()

Players.CharacterAutoLoads = true
print("[Meteor Heist] Server gestartet ✅")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="8">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[-- Admin-Panel (Server-Seite). JEDE Aktion prüft hier auf dem Server, ob der Spieler
-- in Config.AdminUserIds steht. Exploiter können das Panel also nicht benutzen,
-- selbst wenn sie es sich im Client anzeigen lassen.

local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))

local AdminService = {}
local Services
local limiter = Util.RateLimiter(12, 1)

function AdminService.IsAdmin(player: Player): boolean
	if table.find(Config.AdminUserIds, player.UserId) then
		return true
	end
	return RunService:IsStudio() and Config.StudioIsAdmin
end

-- "me", "all", "others" oder (Teil vom) Namen
local function resolveTargets(admin: Player, text: any): { Player }
	if type(text) ~= "string" or text == "" or text:lower() == "me" then
		return { admin }
	end
	local lower = text:lower()
	if lower == "all" then
		return Players:GetPlayers()
	end
	if lower == "others" then
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= admin then
				table.insert(list, p)
			end
		end
		return list
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower() == lower or p.DisplayName:lower() == lower then
			return { p }
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #lower) == lower or p.DisplayName:lower():sub(1, #lower) == lower then
			return { p }
		end
	end
	return {}
end

local function num(value: any, default: number, min: number, max: number): number
	local n = tonumber(value)
	if not n or n ~= n then
		return default
	end
	return math.clamp(n, min, max)
end

local function names(list: { Player }): string
	local out = {}
	for _, p in ipairs(list) do
		table.insert(out, p.DisplayName)
	end
	return table.concat(out, ", ")
end

local function filterBroadcast(text: string, fromUserId: number): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, fromUserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	return ok and result or nil
end

-- -------------------------------------------------------------------
-- SERVERÜBERGREIFEND (alle Server gleichzeitig)
-- -------------------------------------------------------------------
local function handleGlobal(message)
	if type(message) ~= "table" then
		return
	end
	if message.Type == "Announce" and type(message.Text) == "string" then
		Services.EconomyService.NotifyAll("📢 " .. message.Text, "Announce")
	elseif message.Type == "Luck" then
		Services.MeteorService.SetServerLuck(num(message.Mult, 1, 1, 100), num(message.Until, 0, 0, math.huge))
		Services.EconomyService.NotifyAll(
			"🍀 ADMIN-EVENT: " .. message.Mult .. "x Glück auf ALLEN Servern!",
			"Event"
		)
	elseif message.Type == "Shower" then
		Services.MeteorService.StartShower(num(message.Seconds, Config.ShowerDuration, 10, 3600))
	end
end

local function publishGlobal(message): boolean
	local ok, err = pcall(MessagingService.PublishAsync, MessagingService, Config.MessagingTopic, message)
	if not ok then
		warn("[Admin] Global senden fehlgeschlagen: " .. tostring(err))
		handleGlobal(message) -- wenigstens auf diesem Server
	end
	return ok
end

-- -------------------------------------------------------------------
-- AKTIONEN
-- -------------------------------------------------------------------
local Actions = {}

function Actions.GetPlayers(_admin)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local data = Services.DataService.Get(p)
		table.insert(list, {
			Name = p.Name,
			DisplayName = p.DisplayName,
			UserId = p.UserId,
			Cash = data and data.Cash or 0,
			Rebirths = data and data.Rebirths or 0,
		})
	end
	return true, "OK", list
end

function Actions.SpawnMeteor(admin, args)
	local id = args.MeteorId
	if not Config.MeteorsById[id] then
		return false, "Unbekannter Meteor"
	end
	local count = num(args.Count, 1, 1, 25)
	local position = nil
	if args.Where == "Me" then
		local root = admin.Character and admin.Character:FindFirstChild("HumanoidRootPart")
		if root then
			position = (root :: BasePart).Position + (root :: BasePart).CFrame.LookVector * 8
		end
	end
	for i = 1, count do
		local pos = position and (position + Vector3.new((i - 1) % 5 * 6, 0, math.floor((i - 1) / 5) * 6)) or nil
		Services.MeteorService.SpawnMeteor({
			Id = id,
			Mut = Config.MutationsByName[args.Mutation] and args.Mutation or "Normal",
			Position = pos,
			Free = args.Free == true,
			Announce = i == 1,
		})
	end
	return true, count .. "x " .. Config.MeteorsById[id].Name .. " gespawnt"
end

function Actions.MeteorRain(_admin, args)
	local rarity = Config.RaritiesByName[args.Rarity] and args.Rarity or nil
	local count = num(args.Count, 10, 1, 40)
	task.spawn(function()
		for _ = 1, count do
			Services.MeteorService.SpawnMeteor({ Rarity = rarity, Announce = false })
			task.wait(0.25)
		end
	end)
	Services.EconomyService.NotifyAll(
		"☄️ ADMIN-METEORREGEN" .. (rarity and (" (" .. rarity .. ")") or "") .. "!",
		"Event"
	)
	return true, count .. " Meteore regnen herab"
end

function Actions.GiveMeteor(admin, args)
	if not Config.MeteorsById[args.MeteorId] then
		return false, "Unbekannter Meteor"
	end
	local targets = resolveTargets(admin, args.Target)
	local given = 0
	for _, p in ipairs(targets) do
		local ok = Services.EconomyService.GiveMeteor(p, {
			Id = args.MeteorId,
			Mut = args.Mutation,
			Lv = num(args.Level, 1, 1, Config.MaxLevel),
		})
		if ok then
			given += 1
			Services.EconomyService.Notify(
				p,
				"🎁 Ein Admin hat dir " .. Config.MeteorsById[args.MeteorId].Name .. " geschenkt!",
				"Success"
			)
		end
	end
	return given > 0, "An " .. given .. " Spieler gegeben" .. (given < #targets and " (manche Basen voll)" or "")
end

function Actions.GiveCash(admin, args)
	local amount = num(args.Amount, 0, -1e18, 1e18)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		Services.EconomyService.AddCash(p, amount)
	end
	return #targets > 0, Util.FormatCash(amount) .. " an " .. names(targets)
end

function Actions.SetCash(admin, args)
	local amount = num(args.Amount, 0, 0, 1e18)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		if data then
			data.Cash = amount
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "Cash = " .. Util.FormatCash(amount) .. " für " .. names(targets)
end

function Actions.SetRebirths(admin, args)
	local amount = math.floor(num(args.Amount, 0, 0, 1000))
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		if data then
			data.Rebirths = amount
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "Rebirths = " .. amount .. " für " .. names(targets)
end

function Actions.SetSpeed(admin, args)
	local amount = math.floor(num(args.Amount, 0, 0, Config.MaxSpeedLevel))
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		if data then
			data.SpeedLevel = amount
			Services.EconomyService.ApplySpeed(p)
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "Speed-Level = " .. amount .. " für " .. names(targets)
end

function Actions.GivePass(admin, args)
	if not Config.GamePassesByKey[args.PassKey] then
		return false, "Unbekannter Pass"
	end
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		Services.MonetizationService.GrantPassSession(p, args.PassKey)
	end
	return #targets > 0, args.PassKey .. " (bis Server-Wechsel) für " .. names(targets)
end

function Actions.StartShower(_admin, args)
	local seconds = num(args.Seconds, Config.ShowerDuration, 10, 3600)
	if args.Global then
		publishGlobal({ Type = "Shower", Seconds = seconds })
		return true, "Schauer auf ALLEN Servern"
	end
	Services.MeteorService.StartShower(seconds)
	return true, "Meteoritenschauer gestartet (" .. seconds .. "s)"
end

function Actions.ServerLuck(_admin, args)
	local mult = num(args.Mult, 2, 1, 100)
	local minutes = num(args.Minutes, 10, 1, 24 * 60)
	local untilTime = workspace:GetServerTimeNow() + minutes * 60
	if args.Global then
		publishGlobal({ Type = "Luck", Mult = mult, Until = untilTime })
		return true, mult .. "x Glück auf ALLEN Servern für " .. minutes .. " Min"
	end
	Services.MeteorService.SetServerLuck(mult, untilTime)
	Services.EconomyService.NotifyAll(
		"🍀 ADMIN-EVENT: " .. mult .. "x Glück für " .. minutes .. " Minuten!",
		"Event"
	)
	return true, mult .. "x Glück für " .. minutes .. " Min"
end

function Actions.Announce(admin, args)
	if type(args.Text) ~= "string" or #args.Text == 0 or #args.Text > 200 then
		return false, "Text 1-200 Zeichen"
	end
	local filtered = filterBroadcast(args.Text, admin.UserId)
	if not filtered then
		return false, "Text-Filter nicht erreichbar"
	end
	if args.Global then
		publishGlobal({ Type = "Announce", Text = filtered })
		return true, "An ALLE Server gesendet"
	end
	Services.EconomyService.NotifyAll("📢 " .. filtered, "Announce")
	return true, "Gesendet"
end

function Actions.Kick(admin, args)
	local targets = resolveTargets(admin, args.Target)
	local reason = type(args.Reason) == "string" and args.Reason ~= "" and args.Reason or "Vom Admin gekickt"
	local kicked = {}
	for _, p in ipairs(targets) do
		if p ~= admin then
			table.insert(kicked, p.DisplayName)
			p:Kick(reason)
		end
	end
	return #kicked > 0, "Gekickt: " .. table.concat(kicked, ", ")
end

function Actions.Ban(admin, args)
	local userId = tonumber(args.Target)
	local display = tostring(args.Target)
	if not userId then
		local targets = resolveTargets(admin, args.Target)
		if #targets ~= 1 or targets[1] == admin then
			return false, "Genau EINEN Spieler (Name oder UserId) angeben"
		end
		userId = targets[1].UserId
		display = targets[1].DisplayName
	end
	if userId == admin.UserId or table.find(Config.AdminUserIds, userId) then
		return false, "Admins können nicht gebannt werden"
	end
	local days = num(args.Days, 0, 0, 3650)
	local reason = type(args.Reason) == "string" and args.Reason ~= "" and args.Reason or "Regelverstoß"
	local ok, err = pcall(function()
		Players:BanAsync({
			UserIds = { userId },
			ApplyToUniverse = true,
			Duration = days > 0 and math.floor(days * 86400) or -1,
			DisplayReason = reason,
			PrivateReason = "Gebannt von " .. admin.Name .. " (" .. admin.UserId .. ")",
			ExcludeAltAccounts = false,
		})
	end)
	if not ok then
		return false, "Bann fehlgeschlagen: " .. tostring(err)
	end
	return true, display .. " gebannt (" .. (days > 0 and (days .. " Tage") or "für immer") .. ")"
end

function Actions.Unban(_admin, args)
	local userId = tonumber(args.Target)
	if not userId then
		return false, "UserId (Zahl) angeben"
	end
	local ok, err = pcall(function()
		Players:UnbanAsync({ UserIds = { userId }, ApplyToUniverse = true })
	end)
	if not ok then
		return false, "Entbannen fehlgeschlagen: " .. tostring(err)
	end
	return true, userId .. " entbannt"
end

function Actions.ClearBase(admin, args)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local data = Services.DataService.Get(p)
		local plot = Services.PlotService.GetPlot(p)
		if data then
			if plot then
				Services.CarryService.CancelStealsFromPlot(plot, "cancelled")
			end
			data.Meteors = {}
			if plot then
				Services.PlotService.RenderAll(plot)
			end
			Services.EconomyService.MarkDirty(p)
		end
	end
	return #targets > 0, "Base geleert: " .. names(targets)
end

function Actions.ResetData(admin, args)
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		local plot = Services.PlotService.GetPlot(p)
		if Services.CarryService.IsCarrying(p) then
			Services.CarryService.Fail(p, "cancelled")
		end
		if plot then
			Services.CarryService.CancelStealsFromPlot(plot, "cancelled")
		end
		Services.DataService.Reset(p)
		if plot then
			Services.PlotService.RenderAll(plot)
		end
		Services.EconomyService.ApplySpeed(p)
		Services.EconomyService.MarkDirty(p)
	end
	return #targets > 0, "Spielstand zurückgesetzt: " .. names(targets)
end

function Actions.TeleportTo(admin, args)
	local target = resolveTargets(admin, args.Target)[1]
	local root = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if not root or not admin.Character then
		return false, "Spieler nicht gefunden"
	end
	admin.Character:PivotTo((root :: BasePart).CFrame * CFrame.new(0, 0, 4))
	return true, "Zu " .. target.DisplayName .. " teleportiert"
end

function Actions.Bring(admin, args)
	local targets = resolveTargets(admin, args.Target)
	local root = admin.Character and admin.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false, "Kein Charakter"
	end
	for i, p in ipairs(targets) do
		if p ~= admin and p.Character then
			p.Character:PivotTo((root :: BasePart).CFrame * CFrame.new(i * 3, 0, -4))
		end
	end
	return #targets > 0, "Geholt: " .. names(targets)
end

function Actions.ClearGround(_admin)
	Services.MeteorService.ClearGround()
	return true, "Krater geleert"
end

-- -------------------------------------------------------------------
function AdminService.Init(services)
	Services = services
end

function AdminService.Start()
	local function onPlayer(player: Player)
		if AdminService.IsAdmin(player) then
			player:SetAttribute("IsAdmin", true)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		limiter.Clear(player)
	end)

	Remotes.Admin.OnServerInvoke = function(player: Player, action: any, args: any)
		if not AdminService.IsAdmin(player) then
			warn("[Admin] Unerlaubter Zugriff von " .. player.Name .. " (" .. player.UserId .. ")")
			return { Ok = false, Message = "Kein Zugriff" }
		end
		if not limiter.Check(player) then
			return { Ok = false, Message = "Zu schnell" }
		end
		if type(action) ~= "string" or not Actions[action] then
			return { Ok = false, Message = "Unbekannte Aktion" }
		end
		if type(args) ~= "table" then
			args = {}
		end
		local ok, success, message, payload = pcall(Actions[action], player, args)
		if not ok then
			warn("[Admin] Fehler bei " .. action .. ": " .. tostring(success))
			return { Ok = false, Message = "Fehler: " .. tostring(success) }
		end
		print(("[Admin] %s -> %s: %s"):format(player.Name, action, tostring(message)))
		return { Ok = success, Message = message, Data = payload }
	end

	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(Config.MessagingTopic, function(packet)
				handleGlobal(packet.Data)
			end)
		end)
		if not ok then
			warn("[Admin] MessagingService nicht verfügbar (in Studio normal): " .. tostring(err))
		end
	end)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">CarryService</string>
            <string name="Source"><![CDATA[-- Tragen & Klauen:
--  * Gekaufte Meteore muss man in die eigene Base tragen.
--  * Fremde Meteore kann man klauen (wenn die Base nicht gesperrt ist).
--  * Wer gebonkt wird oder stirbt, verliert den Meteor:
--      geklaut   -> fliegt zurück zum Besitzer
--      gekauft   -> fällt auf den Boden und ist GRATIS für alle
--  * Bonk-Schläger zum Verteidigen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))

local CarryService = {}
local Services

local carrying: { [Player]: any } = {}
local stealing: { [any]: { [number]: Player } } = {} -- [plot][slot] = Dieb
local lastBonk: { [Player]: number } = {}

function CarryService.IsCarrying(player: Player): boolean
	return carrying[player] ~= nil
end

function CarryService.IsSlotBeingStolen(plot, slot: number): boolean
	local map = stealing[plot]
	return map ~= nil and map[slot] ~= nil
end

local function clearStealMark(info)
	if info.Source == "Plot" and stealing[info.VictimPlot] then
		stealing[info.VictimPlot][info.Slot] = nil
	end
end

local function cleanup(player: Player, info)
	carrying[player] = nil
	if info.Visual then
		info.Visual:Destroy()
		info.Visual = nil
	end
	Services.EconomyService.ApplySpeed(player)
	Services.EconomyService.MarkDirty(player)
end

local function createVisual(player: Player, entry): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not root then
		return nil
	end
	local visual = MeteorFactory.Create(entry, "Base")
	visual.Name = "CarriedMeteor"
	visual.Anchored = false
	visual.Massless = true
	visual.CanCollide = false
	visual.CanQuery = false
	visual.CFrame = root.CFrame * CFrame.new(0, 2.5 + visual.Size.Y / 2, 0)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = visual
	weld.Parent = visual
	visual.Parent = character
	return visual
end

-- info: { Source = "Ground" } oder { Source = "Plot", VictimPlot, VictimPlayer, Slot, EntryRef }
function CarryService.StartCarry(player: Player, entry, info)
	info.Entry = entry
	info.Started = os.clock()
	info.Visual = createVisual(player, entry)
	carrying[player] = info
	Services.EconomyService.ApplySpeed(player)
	Services.EconomyService.MarkDirty(player)
	Services.EconomyService.Notify(player, "🏃 Bring den Meteor in deine Base!", "Info")
end

local function succeed(player: Player)
	local info = carrying[player]
	if not info then
		return
	end
	local data = Services.DataService.Get(player)
	local plot = Services.PlotService.GetPlot(player)
	local slot = Services.PlotService.FreeSlot(player)
	local def = Config.MeteorsById[info.Entry.Id]

	if info.Source == "Plot" then
		local victim = info.VictimPlayer
		local victimData = victim and victim.Parent and Services.DataService.Get(victim)
		local key = tostring(info.Slot)
		if not data or not plot or not slot or not victimData or victimData.Meteors[key] ~= info.EntryRef then
			CarryService.Fail(player, "invalid")
			return
		end
		victimData.Meteors[key] = nil
		data.Meteors[tostring(slot)] = info.EntryRef
		data.Stats.Stolen += 1
		victimData.Stats.Robbed += 1
		clearStealMark(info)
		cleanup(player, info)
		Services.EconomyService.Discover(player, info.Entry.Id)
		Services.PlotService.RenderSlot(plot, slot)
		Services.PlotService.RenderSlot(info.VictimPlot, info.Slot)
		Services.EconomyService.MarkDirty(victim)
		Services.EconomyService.Notify(player, "😈 Geklaut: " .. def.Name .. "!", "Success")
		Services.EconomyService.Notify(
			victim,
			"💔 " .. player.DisplayName .. " hat deinen " .. def.Name .. " geklaut!",
			"Error"
		)
		Services.EconomyService.Effect(player, "Confetti", 1)
		return
	end

	-- Gekaufter / geschnappter Meteor
	if not data or not plot or not slot then
		CarryService.Fail(player, "full")
		return
	end
	data.Meteors[tostring(slot)] = info.Entry
	cleanup(player, info)
	Services.EconomyService.Discover(player, info.Entry.Id)
	Services.PlotService.RenderSlot(plot, slot)
	Services.EconomyService.Notify(player, "✅ " .. def.Name .. " ist in deiner Base!", "Success")
	Services.EconomyService.Effect(player, "Confetti", 0.5)
end

function CarryService.Fail(player: Player, reason: string)
	local info = carrying[player]
	if not info then
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local position = (info.Visual and info.Visual.Position) or (root and root.Position) or Vector3.zero
	clearStealMark(info)
	cleanup(player, info)
	local def = Config.MeteorsById[info.Entry.Id]

	if info.Source == "Plot" then
		-- zurück zum Besitzer
		if info.VictimPlot.Owner == info.VictimPlayer then
			Services.PlotService.RenderSlot(info.VictimPlot, info.Slot)
			if reason ~= "victimLeft" then
				Services.EconomyService.Notify(
					info.VictimPlayer,
					"🛡️ Dein " .. def.Name .. " ist zurück!",
					"Success"
				)
			end
		end
		if reason == "bonked" then
			Services.EconomyService.Notify(player, "💥 Gebonkt! Der Meteor fliegt zurück.", "Error")
		elseif reason == "timeout" then
			Services.EconomyService.Notify(player, "⏰ Zu langsam! Der Meteor fliegt zurück.", "Error")
		end
	else
		-- gekaufter Meteor fällt auf den Boden -> gratis für alle
		Services.MeteorService.DropMeteor(info.Entry, position)
		if reason == "bonked" then
			Services.EconomyService.Notify(player, "💥 Gebonkt! Du hast den Meteor fallen lassen!", "Error")
		elseif reason == "timeout" then
			Services.EconomyService.Notify(player, "⏰ Zu langsam! Der Meteor ist runtergefallen.", "Error")
		elseif reason == "full" then
			Services.EconomyService.Notify(player, "Deine Base ist voll – Meteor fallen gelassen!", "Error")
		end
	end
end

function CarryService.TrySteal(thief: Player, plot, slot: number)
	local owner = plot.Owner
	if not owner or owner == thief then
		return
	end
	local thiefData = Services.DataService.Get(thief)
	local ownerData = Services.DataService.Get(owner)
	if not thiefData or not ownerData then
		return
	end
	if Services.PlotService.IsLocked(plot) then
		Services.EconomyService.Notify(thief, "🔒 Diese Base ist gesperrt!", "Error")
		return
	end
	if CarryService.IsSlotBeingStolen(plot, slot) or carrying[thief] then
		return
	end
	local entry = ownerData.Meteors[tostring(slot)]
	if not entry then
		return
	end
	if not Services.PlotService.GetPlot(thief) then
		Services.EconomyService.Notify(thief, "Du hast keine Base auf diesem Server.", "Error")
		return
	end
	if not Services.PlotService.FreeSlot(thief) then
		Services.EconomyService.Notify(thief, "Deine Base ist voll! Verkaufe erst einen Meteor.", "Error")
		return
	end
	local character = thief.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local meteor = plot.MeteorParts[slot]
	if not root or not humanoid or humanoid.Health <= 0 or not meteor then
		return
	end
	if (root.Position - meteor.Position).Magnitude > meteor.Size.X / 2 + 14 then
		return -- zu weit weg
	end

	stealing[plot] = stealing[plot] or {}
	stealing[plot][slot] = thief
	Services.PlotService.RenderSlot(plot, slot) -- macht den Meteor in der Base unsichtbar
	CarryService.StartCarry(thief, entry, {
		Source = "Plot",
		VictimPlot = plot,
		VictimPlayer = owner,
		Slot = slot,
		EntryRef = entry,
	})
	local def = Config.MeteorsById[entry.Id]
	Services.EconomyService.Notify(
		owner,
		"🚨 " .. thief.DisplayName .. " klaut deinen " .. def.Name .. "! BONK IHN!",
		"Alarm"
	)
	Services.EconomyService.Effect(owner, "Alarm", 1)
end

-- Alle laufenden Diebstähle aus einer Base abbrechen (Rebirth, Reset, Verlassen)
function CarryService.CancelStealsFromPlot(plot, reason: string?)
	for thief, info in pairs(carrying) do
		if info.Source == "Plot" and info.VictimPlot == plot then
			CarryService.Fail(thief, reason or "cancelled")
		end
	end
end

-- -------------------------------------------------------------------
-- BONK-SCHLÄGER
-- -------------------------------------------------------------------
local function bonk(player: Player, tool: Tool)
	local t = os.clock()
	if t - (lastBonk[player] or 0) < Config.BonkCooldown then
		return
	end
	lastBonk[player] = t

	-- Schlag-Animation über das Standard-Animate-Skript
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	Debris:AddItem(anim, 1)

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local best, bestDist = nil, Config.BonkRange
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local otherRoot = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local otherHum = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
			if otherRoot and otherHum and otherHum.Health > 0 then
				local offset = otherRoot.Position - root.Position
				local dist = offset.Magnitude
				local facing = dist < 3 or root.CFrame.LookVector:Dot(offset.Unit) > 0.1
				if dist <= bestDist and facing then
					best, bestDist = other, dist
				end
			end
		end
	end
	if not best then
		return
	end
	local targetRoot = best.Character and best.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not targetRoot then
		return
	end
	local direction = targetRoot.Position - root.Position
	direction = Vector3.new(direction.X, 0, direction.Z)
	direction = direction.Magnitude > 0.01 and direction.Unit or root.CFrame.LookVector

	-- Rückstoß (läuft beim getroffenen Spieler, weil der seine Physik besitzt)
	local attachment = Instance.new("Attachment")
	attachment.Parent = targetRoot
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = 1e6
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VectorVelocity = direction * Config.BonkForce + Vector3.new(0, 30, 0)
	velocity.Parent = targetRoot
	Debris:AddItem(velocity, 0.18)
	Debris:AddItem(attachment, 0.18)

	Services.EconomyService.Effect(best, "Shake", 0.6)
	if carrying[best] then
		CarryService.Fail(best, "bonked")
		Services.EconomyService.Notify(
			player,
			"💥 Treffer! " .. best.DisplayName .. " hat den Meteor verloren!",
			"Success"
		)
	end
end

local function createBonkTool(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Bonk"
	tool.ToolTip = "Klick = Bonk! Diebe verlieren ihren Meteor."
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = CFrame.new(0, 0, -1.6) * CFrame.Angles(math.rad(-90), 0, 0)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.6, 0.6, 4.2)
	handle.Color = Color3.fromRGB(255, 170, 60)
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(1.6, 1.6, 1.6)
	head.Color = Color3.fromRGB(255, 90, 60)
	head.Material = Enum.Material.SmoothPlastic
	head.CanCollide = false
	head.Massless = true
	head.CFrame = handle.CFrame * CFrame.new(0, 0, -2.2)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = head
	weld.Parent = head
	head.Parent = tool
	return tool
end

local bonkTemplate: Tool

local function giveTool(player: Player)
	local backpack = player:WaitForChild("Backpack", 10)
	if not backpack or backpack:FindFirstChild("Bonk") then
		return
	end
	local tool = bonkTemplate:Clone()
	tool.Activated:Connect(function()
		bonk(player, tool)
	end)
	tool.Parent = backpack
end

function CarryService.Init(services)
	Services = services
	bonkTemplate = createBonkTool()
end

function CarryService.Start()
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			-- neuer Charakter -> alter Meteor ist weg
			if carrying[player] then
				CarryService.Fail(player, "died")
			end
			local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
			if humanoid then
				humanoid.Died:Connect(function()
					CarryService.Fail(player, "died")
				end)
			end
			giveTool(player)
			Services.EconomyService.ApplySpeed(player)
		end)
		if player.Character then
			task.spawn(giveTool, player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end

	-- Beim Verlassen (vor dem Speichern): Diebstähle sauber beenden.
	-- Kann zweimal aufgerufen werden (PlayerRemoving + Speichern) – ist harmlos.
	local function onLeaving(player: Player)
		lastBonk[player] = nil
		local info = carrying[player]
		local data = Services.DataService.Get(player)
		if info and info.Source == "Ground" and data then
			-- gekaufter Meteor geht beim Verlassen nicht verloren
			local slot = Services.PlotService.FreeSlot(player)
			if slot then
				data.Meteors[tostring(slot)] = info.Entry
				cleanup(player, info)
			end
		end
		if carrying[player] then
			CarryService.Fail(player, "left")
		end
	end
	Services.DataService.OnProfileReleasing(onLeaving)
	Players.PlayerRemoving:Connect(onLeaving)

	-- Prüfen: angekommen? gestorben? zu langsam?
	task.spawn(function()
		while true do
			task.wait(0.15)
			for player, info in pairs(carrying) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local plot = Services.PlotService.GetPlot(player)
				local teleported = false
				if root then
					-- Anti-Teleport: wer mit Beute unmöglich schnell vorankommt, verliert sie
					local now = os.clock()
					if info.LastPos then
						local dist = (root.Position - info.LastPos).Magnitude
						local dt = math.max(now - info.LastTime, 0.05)
						local limit = math.max(humanoid and humanoid.WalkSpeed * 2.5 or 0, 70)
						teleported = dist > 25 and dist / dt > limit
					end
					info.LastPos = root.Position
					info.LastTime = now
				end
				if not root or not humanoid or humanoid.Health <= 0 or not info.Visual or not info.Visual.Parent then
					CarryService.Fail(player, "died")
				elseif teleported then
					CarryService.Fail(player, "teleport")
				elseif os.clock() - info.Started > Config.CarryTimeout then
					CarryService.Fail(player, "timeout")
				elseif plot and Services.PlotService.IsInside(plot, root.Position) then
					succeed(player)
				end
			end
		end
	end)
end

return CarryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Speichert Spielstände sicher:
--  * Session-Lock: ein Spielstand ist immer nur in EINEM Server offen (keine Duplikate)
--  * Wiederholungen bei DataStore-Fehlern, Auto-Save, Speichern beim Server-Ende
--  * Wenn Laden fehlschlägt, wird der Spieler gekickt statt mit leerem Stand zu spielen

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = {}
DataService.Profiles = {} :: { [Player]: any }

local DEFAULT_DATA = {
	Cash = Config.StartCash,
	Pending = 0,
	Meteors = {}, -- ["1"] = { Id = "Pebble", Mut = "Normal", Lv = 1, Xp = 0 }
	Rebirths = 0,
	SpeedLevel = 0,
	TotalEarned = 0,
	Index = {}, -- ["Pebble"] = true -> schon entdeckt (bleibt bei Rebirth)
	Stats = { Stolen = 0, Robbed = 0, Bought = 0, RobuxSpent = 0 },
	Daily = { Last = 0, Streak = 0 },
	Receipts = {}, -- zuletzt verarbeitete Käufe (gegen doppelte Gutschrift)
	LastOnline = 0,
}

local LOCK_EXPIRE = 30 * 60 -- ein Lock älter als 30 Min gilt als verwaist
local LOAD_ATTEMPTS = 6
local LOCK_WAIT = 5

local store = nil
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)

local loadedCallbacks = {}
local releasingCallbacks = {}

local function keyFor(userId: number): string
	return "Player_" .. userId
end

local function jobId(): string
	return game.JobId ~= "" and game.JobId or "studio"
end

function DataService.OnProfileLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

-- Wird VOR dem finalen Speichern aufgerufen (z.B. um laufende Diebstähle abzubrechen)
function DataService.OnProfileReleasing(callback)
	table.insert(releasingCallbacks, callback)
end

function DataService.Get(player: Player)
	local profile = DataService.Profiles[player]
	if profile and profile.Loaded then
		return profile.Data
	end
	return nil
end

function DataService.IsLoaded(player: Player): boolean
	local profile = DataService.Profiles[player]
	return profile ~= nil and profile.Loaded == true
end

local function loadData(userId: number): (boolean, any)
	if not storeOk or not store then
		return false, "DataStore nicht verfügbar"
	end
	for attempt = 1, LOAD_ATTEMPTS do
		local lockedByOther = false
		local forceTake = attempt == LOAD_ATTEMPTS
		local ok, result = pcall(function()
			return store:UpdateAsync(keyFor(userId), function(old)
				old = old or {}
				local lock = old.Lock
				if lock and lock.JobId ~= jobId() and os.time() - (lock.Time or 0) < LOCK_EXPIRE and not forceTake then
					lockedByOther = true
					return nil -- nichts schreiben
				end
				old.Lock = { JobId = jobId(), Time = os.time() }
				return old
			end)
		end)
		if ok and not lockedByOther then
			local data = (result and result.Data) or Util.DeepCopy(DEFAULT_DATA)
			Util.Reconcile(data, DEFAULT_DATA)
			return true, data
		end
		if not ok then
			warn("[DataService] Laden fehlgeschlagen (Versuch " .. attempt .. "): " .. tostring(result))
		end
		task.wait(lockedByOther and LOCK_WAIT or (attempt * 1.5))
	end
	return false, "Konnte Spielstand nicht laden"
end

local function saveData(userId: number, data, release: boolean): boolean
	if not storeOk or not store then
		return false
	end
	for attempt = 1, 4 do
		local lostLock = false
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(userId), function(old)
				old = old or {}
				if old.Lock and old.Lock.JobId ~= jobId() then
					-- Ein anderer Server hat den Spielstand übernommen -> NICHT überschreiben
					lostLock = true
					return nil
				end
				return {
					Data = data,
					Lock = (not release) and { JobId = jobId(), Time = os.time() } or nil,
				}
			end)
		end)
		if ok then
			return not lostLock
		end
		warn("[DataService] Speichern fehlgeschlagen (Versuch " .. attempt .. "): " .. tostring(err))
		task.wait(attempt * 1.5)
	end
	return false
end

function DataService.Save(player: Player): boolean
	local profile = DataService.Profiles[player]
	if not profile or not profile.Loaded or profile.NoSave or profile.Releasing then
		return profile ~= nil and profile.NoSave == true
	end
	profile.Data.LastOnline = os.time()
	return saveData(player.UserId, profile.Data, false)
end

local function onPlayerAdded(player: Player)
	local profile = { Loaded = false, Data = nil, NoSave = false }
	DataService.Profiles[player] = profile

	local ok, data = loadData(player.UserId)
	if not ok then
		if RunService:IsStudio() then
			warn(
				"[DataService] Studio: Speichern ist AUS. Aktiviere in Game Settings > Security 'Enable Studio Access to API Services'."
			)
			data = Util.DeepCopy(DEFAULT_DATA)
			profile.NoSave = true
		else
			DataService.Profiles[player] = nil
			if player.Parent then
				player:Kick(
					"Dein Spielstand konnte nicht geladen werden. Bitte tritt erneut bei. (Roblox-Server ausgelastet)"
				)
			end
			return
		end
	end

	if not player.Parent then
		-- Spieler hat das Spiel während des Ladens verlassen -> Lock freigeben
		if not profile.NoSave then
			saveData(player.UserId, data, true)
		end
		DataService.Profiles[player] = nil
		return
	end

	profile.Data = data
	profile.Loaded = true
	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(callback, player, data)
	end
end

local function releaseProfile(player: Player)
	local profile = DataService.Profiles[player]
	if not profile then
		return
	end
	if profile.Releasing then
		-- wird bereits gespeichert (PlayerRemoving + BindToClose gleichzeitig)
		while DataService.Profiles[player] == profile do
			task.wait(0.1)
		end
		return
	end
	profile.Releasing = true
	if profile.Loaded then
		for _, callback in ipairs(releasingCallbacks) do
			local ok, err = pcall(callback, player, profile.Data)
			if not ok then
				warn("[DataService] Releasing-Callback Fehler: " .. tostring(err))
			end
		end
		if not profile.NoSave then
			profile.Data.LastOnline = os.time()
			saveData(player.UserId, profile.Data, true)
		end
	end
	DataService.Profiles[player] = nil
end

-- Spielstand komplett zurücksetzen (Admin)
function DataService.Reset(player: Player)
	local profile = DataService.Profiles[player]
	if profile and profile.Loaded then
		local fresh = Util.DeepCopy(DEFAULT_DATA)
		fresh.Receipts = profile.Data.Receipts -- Käufe bleiben verbucht
		for k in pairs(profile.Data) do
			profile.Data[k] = nil
		end
		for k, v in pairs(fresh) do
			profile.Data[k] = v
		end
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(releaseProfile)

	-- Auto-Save
	task.spawn(function()
		while true do
			task.wait(Config.AutoSaveInterval)
			for player in pairs(DataService.Profiles) do
				if player.Parent then
					task.spawn(DataService.Save, player)
					task.wait(0.5) -- verteilen, um Limits zu schonen
				end
			end
		end
	end)

	-- Server fährt herunter: alles speichern (Roblox gibt max. 30 Sekunden)
	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				releaseProfile(player)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[-- Geld & Fortschritt: Einkommen, Aufladen (Level), Einsammeln, Verkaufen,
-- Speed Farm, Rebirth, Tagesbonus, Index, Leaderstats und Daten an den Client.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))

local EconomyService = {}
local Services

local dirty: { [Player]: boolean } = {}
local requestLimiter = Util.RateLimiter(8, 1)

-- -------------------------------------------------------------------
-- NACHRICHTEN
-- -------------------------------------------------------------------
function EconomyService.Notify(player: Player?, text: string, kind: string?)
	if player and player.Parent then
		Remotes.Notify:FireClient(player, text, kind or "Info")
	end
end

function EconomyService.NotifyAll(text: string, kind: string?)
	Remotes.Notify:FireAllClients(text, kind or "Info")
end

function EconomyService.Effect(player: Player?, name: string, strength: number?)
	if player and player.Parent then
		Remotes.Effect:FireClient(player, name, strength or 1)
	end
end

function EconomyService.MarkDirty(player: Player?)
	if player then
		dirty[player] = true
	end
end

-- -------------------------------------------------------------------
-- RECHNEN
-- -------------------------------------------------------------------
function EconomyService.IndexCount(data): number
	local count = 0
	for id in pairs(data.Index) do
		if Config.MeteorsById[id] then
			count += 1
		end
	end
	return count
end

function EconomyService.GetMultiplier(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 1
	end
	local Monetization = Services.MonetizationService
	local mult = 1 + data.Rebirths * Config.RebirthMultPerLevel
	if Monetization.HasPass(player, "DoubleCash") then
		mult *= 2
	end
	local bonus = 1 + EconomyService.IndexCount(data) * Config.IndexBonusPerMeteor
	if Monetization.HasPass(player, "VIP") then
		bonus += Config.VIPBonus
	end
	if player.MembershipType == Enum.MembershipType.Premium then
		bonus += Config.PremiumBonus
	end
	return mult * bonus
end

function EconomyService.GetIncome(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 0
	end
	local plot = Services.PlotService.GetPlot(player)
	local base = 0
	for key, entry in pairs(data.Meteors) do
		local slot = tonumber(key)
		if not (plot and slot and Services.CarryService.IsSlotBeingStolen(plot, slot)) then
			base += Config.MeteorIncome(entry)
		end
	end
	return base * EconomyService.GetMultiplier(player)
end

function EconomyService.GetSpeed(player: Player): number
	local data = Services.DataService.Get(player)
	local speed = Config.NormalWalkSpeed
	if data then
		speed += data.SpeedLevel * Config.SpeedPerLevel
	end
	if Services.MonetizationService.HasPass(player, "SpeedBoots") then
		speed += Config.SpeedBootsBonus
	end
	return speed
end

function EconomyService.ApplySpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local speed = EconomyService.GetSpeed(player)
	if Services.CarryService.IsCarrying(player) then
		speed = math.max(8, speed * Config.CarrySpeedFactor)
	end
	humanoid.WalkSpeed = speed
end

-- -------------------------------------------------------------------
-- GELD
-- -------------------------------------------------------------------
function EconomyService.AddCash(player: Player, amount: number)
	local data = Services.DataService.Get(player)
	if not data or amount ~= amount then
		return
	end
	data.Cash = math.max(0, data.Cash + amount)
	if amount > 0 then
		data.TotalEarned += amount
	end
	dirty[player] = true
end

function EconomyService.Collect(player: Player)
	local data = Services.DataService.Get(player)
	if not data or data.Pending < 1 then
		return
	end
	local amount = math.floor(data.Pending)
	data.Pending -= amount
	EconomyService.AddCash(player, amount)
	EconomyService.Effect(player, "Collect", amount)
	local plot = Services.PlotService.GetPlot(player)
	if plot then
		plot.CollectLabel.Text = "💰 " .. Util.FormatCash(data.Pending)
	end
end

function EconomyService.Discover(player: Player, meteorId: string)
	local data = Services.DataService.Get(player)
	if data and Config.MeteorsById[meteorId] and not data.Index[meteorId] then
		data.Index[meteorId] = true
		local def = Config.MeteorsById[meteorId]
		EconomyService.Notify(
			player,
			"📖 NEU im Index: "
				.. def.Name
				.. "! (+"
				.. math.floor(Config.IndexBonusPerMeteor * 100)
				.. "% Einkommen)",
			"Success"
		)
		dirty[player] = true
	end
end

-- Meteor direkt in die Base legen (Admin, Produkte). Gibt true zurück, wenn Platz war.
function EconomyService.GiveMeteor(player: Player, entry): boolean
	local data = Services.DataService.Get(player)
	local plot = Services.PlotService.GetPlot(player)
	local slot = Services.PlotService.FreeSlot(player)
	if not data or not plot or not slot or not Config.MeteorsById[entry.Id] then
		return false
	end
	data.Meteors[tostring(slot)] = {
		Id = entry.Id,
		Mut = Config.MutationsByName[entry.Mut] and entry.Mut or "Normal",
		Lv = math.clamp(math.floor(entry.Lv or 1), 1, Config.MaxLevel),
		Xp = 0,
	}
	EconomyService.Discover(player, entry.Id)
	Services.PlotService.RenderSlot(plot, slot)
	dirty[player] = true
	return true
end

function EconomyService.Sell(player: Player, plot, slot: number)
	if plot.Owner ~= player then
		return
	end
	local data = Services.DataService.Get(player)
	local key = tostring(slot)
	local entry = data and data.Meteors[key]
	if not entry or Services.CarryService.IsSlotBeingStolen(plot, slot) then
		return
	end
	local value = math.floor(Config.MeteorValue(entry) * Config.SellRatio)
	data.Meteors[key] = nil
	EconomyService.AddCash(player, value)
	Services.PlotService.RenderSlot(plot, slot)
	EconomyService.Notify(player, "Verkauft für " .. Util.FormatCash(value), "Success")
end

-- -------------------------------------------------------------------
-- SPEED FARM / REBIRTH / DAILY
-- -------------------------------------------------------------------
function EconomyService.BuySpeed(player: Player, amount: number): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch..."
	end
	amount = math.clamp(math.floor(amount), 1, Config.MaxSpeedLevel)
	local bought = 0
	while bought < amount and data.SpeedLevel < Config.MaxSpeedLevel do
		local cost = Config.SpeedCost(data.SpeedLevel)
		if data.Cash < cost then
			break
		end
		data.Cash -= cost
		data.SpeedLevel += 1
		bought += 1
	end
	dirty[player] = true
	if bought == 0 then
		if data.SpeedLevel >= Config.MaxSpeedLevel then
			return false, "Maximales Speed-Level erreicht!"
		end
		return false, "Nicht genug Cash! (" .. Util.FormatCash(Config.SpeedCost(data.SpeedLevel)) .. ")"
	end
	EconomyService.ApplySpeed(player)
	return true, "🏃 +" .. bought .. " Speed! (Level " .. data.SpeedLevel .. ")"
end

function EconomyService.Rebirth(player: Player): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch..."
	end
	if Services.CarryService.IsCarrying(player) then
		return false, "Bring erst deinen Meteor nach Hause!"
	end
	local cost = Config.RebirthCost(data.Rebirths)
	if data.Cash < cost then
		return false, "Du brauchst " .. Util.FormatCash(cost) .. " für den Rebirth!"
	end
	local plot = Services.PlotService.GetPlot(player)
	if plot then
		Services.CarryService.CancelStealsFromPlot(plot, "cancelled")
	end
	data.Rebirths += 1
	data.Cash = Config.StartCash
	data.Pending = 0
	data.Meteors = {}
	if plot then
		Services.PlotService.RenderAll(plot)
	end
	dirty[player] = true
	EconomyService.NotifyAll("🔥 " .. player.DisplayName .. " hat Rebirth " .. data.Rebirths .. " erreicht!", "Event")
	EconomyService.Effect(player, "Confetti", 2)
	return true, "Rebirth! Jetzt " .. Util.FormatNumber(EconomyService.GetMultiplier(player) * 100) .. "% Einkommen"
end

local DAY = 24 * 3600

function EconomyService.DailyStatus(data): (boolean, number)
	local elapsed = os.time() - data.Daily.Last
	return elapsed >= DAY, math.max(0, DAY - elapsed)
end

function EconomyService.ClaimDaily(player: Player): (boolean, string)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Lädt noch..."
	end
	local ready, remaining = EconomyService.DailyStatus(data)
	if not ready then
		return false, "Nächster Bonus in " .. Util.FormatTime(remaining)
	end
	local elapsed = os.time() - data.Daily.Last
	if data.Daily.Last > 0 and elapsed < DAY * 2 then
		data.Daily.Streak += 1
	else
		data.Daily.Streak = 1
	end
	data.Daily.Last = os.time()
	local reward = math.max(
		Config.DailyRewardMinCash,
		EconomyService.GetIncome(player) * Config.DailyRewardIncomeSeconds
	) * math.min(data.Daily.Streak, 7)
	reward = math.floor(reward)
	EconomyService.AddCash(player, reward)
	EconomyService.Effect(player, "Confetti", 1)
	return true, "🎁 Tag " .. data.Daily.Streak .. ": +" .. Util.FormatCash(reward)
end

-- -------------------------------------------------------------------
-- DATEN AN DEN CLIENT
-- -------------------------------------------------------------------
local function buildState(player: Player)
	local data = Services.DataService.Get(player)
	if not data then
		return nil
	end
	local plot = Services.PlotService.GetPlot(player)
	local dailyReady, dailyIn = EconomyService.DailyStatus(data)
	local passes = {}
	for _, pass in ipairs(Config.GamePasses) do
		passes[pass.Key] = Services.MonetizationService.HasPass(player, pass.Key)
	end
	local index = {}
	for id in pairs(data.Index) do
		table.insert(index, id)
	end
	return {
		Cash = data.Cash,
		Pending = data.Pending,
		Income = EconomyService.GetIncome(player),
		Multiplier = EconomyService.GetMultiplier(player),
		Rebirths = data.Rebirths,
		RebirthCost = Config.RebirthCost(data.Rebirths),
		SpeedLevel = data.SpeedLevel,
		Speed = EconomyService.GetSpeed(player),
		Slots = Services.PlotService.SlotCount(player),
		UsedSlots = Services.PlotService.UsedSlots(player),
		DailyReady = dailyReady,
		DailyIn = dailyIn,
		Streak = data.Daily.Streak,
		Index = index,
		Passes = passes,
		Carrying = Services.CarryService.IsCarrying(player),
		HasPlot = plot ~= nil,
		Stats = data.Stats,
		TotalEarned = data.TotalEarned,
	}
end

local function updateLeaderstats(player: Player)
	local data = Services.DataService.Get(player)
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	local cash = stats:FindFirstChild("Cash") :: StringValue?
	local rebirths = stats:FindFirstChild("Rebirths") :: IntValue?
	if cash then
		cash.Value = Util.FormatCash(data.Cash)
	end
	if rebirths then
		rebirths.Value = data.Rebirths
	end
end

local function flush(player: Player)
	local state = buildState(player)
	if state then
		Remotes.State:FireClient(player, state)
		updateLeaderstats(player)
	end
end

local function onProfileLoaded(player: Player, data)
	-- Leaderboard in der Spielerliste
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player

	-- alte Spielstände reparieren (gelöschte Meteor-Typen entfernen, Slots kappen)
	for key, entry in pairs(data.Meteors) do
		local slot = tonumber(key)
		if not slot or not Config.MeteorsById[entry.Id] or slot < 1 or slot > 15 then
			data.Meteors[key] = nil
		else
			entry.Lv = math.clamp(math.floor(entry.Lv or 1), 1, Config.MaxLevel)
			entry.Xp = entry.Xp or 0
			entry.Mut = Config.MutationsByName[entry.Mut] and entry.Mut or "Normal"
			data.Index[entry.Id] = true
		end
	end

	-- Warten bis die Gamepasses geprüft sind (für Slots / Multiplikator)
	Services.MonetizationService.LoadPasses(player)

	-- Offline-Einkommen
	if data.LastOnline > 0 then
		local offline = math.clamp(os.time() - data.LastOnline, 0, Config.OfflineMaxSeconds)
		local earned = math.floor(EconomyService.GetIncome(player) * offline * Config.OfflineIncomeRate)
		if earned > 0 then
			data.Pending += earned
			task.delay(3, function()
				EconomyService.Notify(
					player,
					"🌙 Offline verdient: " .. Util.FormatCash(earned) .. " – hol es am Collect-Pad!",
					"Success"
				)
			end)
		end
	end
	data.LastOnline = os.time()

	local plot = Services.PlotService.GetPlot(player)
	if plot then
		Services.PlotService.RenderAll(plot)
	end
	EconomyService.ApplySpeed(player)
	flush(player)

	local dailyReady = EconomyService.DailyStatus(data)
	if dailyReady then
		task.delay(5, function()
			EconomyService.Notify(player, "🎁 Dein Tagesbonus wartet! Klick auf 'Daily'.", "Info")
		end)
	end
end

function EconomyService.Init(services)
	Services = services
end

function EconomyService.Start()
	Services.DataService.OnProfileLoaded(onProfileLoaded)

	Remotes.Request.OnServerInvoke = function(player: Player, action: any, arg: any)
		if not requestLimiter.Check(player) then
			return { Ok = false, Message = "Langsam!" }
		end
		if type(action) ~= "string" then
			return { Ok = false }
		end
		local ok, message = false, "Unbekannt"
		if action == "Rebirth" then
			ok, message = EconomyService.Rebirth(player)
		elseif action == "BuySpeed" then
			local amount = type(arg) == "number" and arg or 1
			ok, message = EconomyService.BuySpeed(player, amount)
		elseif action == "Daily" then
			ok, message = EconomyService.ClaimDaily(player)
		elseif action == "Collect" then
			EconomyService.Collect(player)
			ok, message = true, ""
		elseif action == "Home" then
			if Services.CarryService.IsCarrying(player) then
				ok, message = false, "Mit einem Meteor musst du laufen! 🏃"
			else
				Services.PlotService.TeleportHome(player)
				ok, message = true, ""
			end
		end
		dirty[player] = true
		return { Ok = ok, Message = message }
	end

	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
		requestLimiter.Clear(player)
	end)

	-- Einkommen + Aufladen jede Sekunde
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = Services.DataService.Get(player)
				local plot = Services.PlotService.GetPlot(player)
				if data and plot then
					local chargeSpeed = Services.MonetizationService.HasPass(player, "FastCharge") and 2 or 1
					for key, entry in pairs(data.Meteors) do
						local slot = tonumber(key)
						if
							slot
							and entry.Lv < Config.MaxLevel
							and not Services.CarryService.IsSlotBeingStolen(plot, slot)
						then
							entry.Xp += chargeSpeed
							if entry.Xp >= Config.ChargeTime(entry.Lv) then
								entry.Xp = 0
								entry.Lv += 1
								Services.PlotService.RefreshSlot(plot, slot)
							end
						end
					end
					data.Pending += EconomyService.GetIncome(player)
					if Services.MonetizationService.HasPass(player, "AutoCollect") then
						local amount = math.floor(data.Pending)
						data.Pending -= amount
						EconomyService.AddCash(player, amount)
					end
					plot.CollectLabel.Text = "💰 " .. Util.FormatCash(data.Pending)
					dirty[player] = true
				end
			end
		end
	end)

	-- Gesammelte Änderungen max. 5x pro Sekunde an die Clients schicken
	task.spawn(function()
		while true do
			task.wait(0.2)
			for player in pairs(dirty) do
				dirty[player] = nil
				if player.Parent then
					flush(player)
				end
			end
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- Globale Bestenliste (alle Server): Top 10 "Meistes Geld verdient" in der Lobby.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local LeaderboardService = {}
local Services

local UPDATE_INTERVAL = 300 -- alle 5 Minuten (schont DataStore-Limits)
local MAX_VALUE = 9e18

local store: OrderedDataStore? = nil
local rowsFrame: Frame

local function buildBoard()
	local board = Instance.new("Part")
	board.Name = "Leaderboard"
	board.Anchored = true
	board.Size = Vector3.new(36, 24, 1)
	board.Position = Vector3.new(0, 13, -190)
	board.Color = Color3.fromRGB(25, 20, 35)
	board.Material = Enum.Material.SmoothPlastic
	board.Parent = Services.PlotService.MapFolder

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back -- zeigt zur Map-Mitte
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = board

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0.14, 0)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 190, 60)
	title.Text = "🏆 TOP 10 – MEISTES GELD 🏆"
	title.Parent = gui

	rowsFrame = Instance.new("Frame")
	rowsFrame.BackgroundTransparency = 1
	rowsFrame.Position = UDim2.new(0.05, 0, 0.16, 0)
	rowsFrame.Size = UDim2.new(0.9, 0, 0.82, 0)
	rowsFrame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = rowsFrame
end

local function setRows(rows: { { Name: string, Value: number } })
	for _, child in ipairs(rowsFrame:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	if #rows == 0 then
		rows = { { Name = "Noch keine Einträge – sei der Erste!", Value = -1 } }
	end
	for i, row in ipairs(rows) do
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 0.1, 0)
		label.LayoutOrder = i
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = i == 1 and Color3.fromRGB(255, 215, 0)
			or i == 2 and Color3.fromRGB(220, 220, 230)
			or i == 3 and Color3.fromRGB(230, 150, 90)
			or Color3.new(1, 1, 1)
		label.Text = row.Value >= 0 and (("#%d  %s  –  %s"):format(i, row.Name, Util.FormatCash(row.Value)))
			or row.Name
		label.Parent = rowsFrame
	end
end

local function savePlayer(player: Player)
	local data = Services.DataService.Get(player)
	if not store or not data then
		return
	end
	local value = math.floor(math.clamp(data.TotalEarned, 0, MAX_VALUE))
	pcall(function()
		(store :: OrderedDataStore):SetAsync(tostring(player.UserId), value)
	end)
end

local nameCache: { [number]: string } = {}
local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	nameCache[userId] = ok and name or ("User " .. userId)
	return nameCache[userId]
end

local function refresh()
	if not store then
		return
	end
	local ok, pages = pcall(function()
		return (store :: OrderedDataStore):GetSortedAsync(false, 10)
	end)
	if not ok then
		return
	end
	local rows = {}
	for _, item in ipairs(pages:GetCurrentPage()) do
		local userId = tonumber(item.key)
		if userId then
			table.insert(rows, { Name = nameFor(userId), Value = item.value })
		end
	end
	setRows(rows)
end

function LeaderboardService.Init(services)
	Services = services
	pcall(function()
		store = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	buildBoard()
	setRows({})
end

function LeaderboardService.Start()
	Services.DataService.OnProfileReleasing(function(player)
		task.spawn(savePlayer, player)
	end)
	task.spawn(function()
		task.wait(10)
		while true do
			for _, player in ipairs(Players:GetPlayers()) do
				savePlayer(player)
				task.wait(0.5)
			end
			refresh()
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">MeteorFactory</string>
            <string name="Source"><![CDATA[-- Baut das Aussehen eines Meteors: Größe nach Seltenheit, Licht/Feuer/Funken für seltene,
-- Material/Farbe nach Mutation, Namensschild darüber.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local MeteorFactory = {}

function MeteorFactory.GetSize(entry): number
	local def = Config.MeteorsById[entry.Id]
	local rarity = def and Config.RaritiesByName[def.Rarity] or Config.Rarities[1]
	return rarity.Size * (1 + 0.025 * ((entry.Lv or 1) - 1))
end

local function makeLabel(parent: Instance, name: string, order: number, textSize: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, textSize + 4)
	label.LayoutOrder = order
	label.Font = Enum.Font.FredokaOne
	label.TextSize = textSize
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = ""
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label
	label.Parent = parent
	return label
end

-- mode: "Ground" (zeigt Preis) oder "Base" (zeigt Einkommen + Level)
function MeteorFactory.UpdateLabel(part: BasePart, entry, mode: string, price: number?)
	local gui = part:FindFirstChild("Info")
	if not gui then
		return
	end
	local frame = gui:FindFirstChild("Frame")
	local def = Config.MeteorsById[entry.Id]
	if not frame or not def then
		return
	end
	local rarity = Config.RaritiesByName[def.Rarity]
	local mut = Config.MutationsByName[entry.Mut] or Config.Mutations[1]

	frame.NameLabel.Text = def.Name
	frame.NameLabel.TextColor3 = rarity.Color
	local tag = def.Rarity
	if mut.Name ~= "Normal" then
		tag = mut.Name .. " • " .. tag
	end
	frame.RarityLabel.Text = tag
	frame.RarityLabel.TextColor3 = mut.Color or rarity.Color
	if mode == "Ground" then
		if price and price <= 0 then
			frame.ValueLabel.Text = "GRATIS!"
			frame.ValueLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
		else
			frame.ValueLabel.Text = Util.FormatCash(price or Config.MeteorValue(entry))
			frame.ValueLabel.TextColor3 = Color3.fromRGB(255, 230, 90)
		end
	else
		local lv = entry.Lv or 1
		local lvText = lv >= Config.MaxLevel and "MAX" or tostring(lv)
		frame.ValueLabel.Text = Util.FormatCash(Config.MeteorIncome(entry)) .. "/s  ⚡Lv " .. lvText
		frame.ValueLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
	end
end

function MeteorFactory.Create(entry, mode: string, price: number?): BasePart
	local def = Config.MeteorsById[entry.Id]
	assert(def, "Unbekannter Meteor: " .. tostring(entry.Id))
	local rarity = Config.RaritiesByName[def.Rarity]
	local rarityIndex = Config.RarityIndex[def.Rarity]
	local mut = Config.MutationsByName[entry.Mut] or Config.Mutations[1]
	local size = MeteorFactory.GetSize(entry)

	local part = Instance.new("Part")
	part.Name = "Meteor"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(size, size, size)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = true
	part.Material = Enum.Material.Slate
	part.Color = def.Color
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth

	if mut.Name == "Gold" then
		part.Material = Enum.Material.Foil
		part.Color = mut.Color
	elseif mut.Name == "Diamond" then
		part.Material = Enum.Material.Glass
		part.Transparency = 0.15
		part.Color = mut.Color
	elseif mut.Name == "Cosmic" then
		part.Material = Enum.Material.Neon
		part.Color = mut.Color
	end

	part:SetAttribute("MeteorId", entry.Id)
	part:SetAttribute("Mutation", mut.Name)

	-- Leuchten ab Rare, Feuer ab Legendary, Funken ab Mythic
	if rarityIndex >= 3 then
		local light = Instance.new("PointLight")
		light.Color = rarity.Color
		light.Range = 6 + rarityIndex * 2
		light.Brightness = 1 + rarityIndex * 0.3
		light.Parent = part
	end
	if rarityIndex >= 5 then
		local fire = Instance.new("Fire")
		fire.Color = rarity.Color
		fire.SecondaryColor = def.Color
		fire.Size = size * 0.9
		fire.Heat = 4
		fire.Parent = part
	end
	if rarityIndex >= 6 or mut.Name == "Cosmic" then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = mut.Color or rarity.Color
		sparkles.Parent = part
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.new(0, 220, 0, 70)
	gui.StudsOffset = Vector3.new(0, size / 2 + 1.8, 0)
	gui.MaxDistance = 70 + rarityIndex * 15
	gui.LightInfluence = 0
	gui.Parent = part

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Parent = frame

	makeLabel(frame, "NameLabel", 1, 20)
	makeLabel(frame, "RarityLabel", 2, 15)
	makeLabel(frame, "ValueLabel", 3, 17)

	MeteorFactory.UpdateLabel(part, entry, mode, price)
	return part
end

-- Passt Größe + Schild nach einem Level-Up an
function MeteorFactory.Refresh(part: BasePart, entry, mode: string)
	local size = MeteorFactory.GetSize(entry)
	local bottom = part.Position.Y - part.Size.Y / 2
	part.Size = Vector3.new(size, size, size)
	part.Position = Vector3.new(part.Position.X, bottom + size / 2, part.Position.Z)
	local gui = part:FindFirstChild("Info")
	if gui then
		gui.StudsOffset = Vector3.new(0, size / 2 + 1.8, 0)
	end
	local fire = part:FindFirstChildOfClass("Fire")
	if fire then
		fire.Size = size * 0.9
	end
	MeteorFactory.UpdateLabel(part, entry, mode)
end

function MeteorFactory.AddPrompt(
	part: BasePart,
	name: string,
	action: string,
	objectText: string,
	hold: number,
	key: Enum.KeyCode?
)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = math.max(10, part.Size.X / 2 + 7)
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = key or Enum.KeyCode.E
	prompt.Parent = part
	return prompt
end

return MeteorFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">MeteorService</string>
            <string name="Source"><![CDATA[-- Meteor-Regen im Krater: Einschläge, Kaufen/Schnappen, fallengelassene Gratis-Meteore,
-- Meteoritenschauer-Event und Server-Glück.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local MeteorFactory = require(script.Parent:WaitForChild("MeteorFactory"))

local MeteorService = {}
local Services

local rng = Random.new()
local groundMeteors = {} -- Liste von Records
local folder: Folder

local serverLuckMult = 1
local serverLuckUntil = 0
local showerUntil = 0
local nextShowerAt = 0

-- -------------------------------------------------------------------
-- GLÜCK & EVENTS
-- -------------------------------------------------------------------
local function now(): number
	return workspace:GetServerTimeNow()
end

local function publishAttributes()
	ReplicatedStorage:SetAttribute("LuckMult", serverLuckMult)
	ReplicatedStorage:SetAttribute("LuckUntil", serverLuckUntil)
	ReplicatedStorage:SetAttribute("ShowerUntil", showerUntil)
	ReplicatedStorage:SetAttribute("NextShowerAt", nextShowerAt)
end

function MeteorService.IsShowerActive(): boolean
	return showerUntil > now()
end

function MeteorService.GetLuck(): number
	local luck = 1
	if serverLuckUntil > now() then
		luck *= serverLuckMult
	end
	if MeteorService.IsShowerActive() then
		luck *= Config.ShowerLuck
	end
	return luck
end

-- Verlängert laufendes Glück, statt es zu überschreiben
function MeteorService.AddServerLuck(mult: number, seconds: number)
	local t = now()
	if serverLuckUntil > t and mult <= serverLuckMult then
		serverLuckUntil += seconds
	else
		serverLuckMult = mult
		serverLuckUntil = math.max(serverLuckUntil, t) + seconds
	end
	publishAttributes()
end

function MeteorService.SetServerLuck(mult: number, untilTime: number)
	serverLuckMult = mult
	serverLuckUntil = untilTime
	publishAttributes()
end

function MeteorService.StartShower(duration: number?)
	local t = now()
	showerUntil = math.max(showerUntil, t) + (duration or Config.ShowerDuration)
	nextShowerAt = showerUntil + Config.ShowerInterval
	publishAttributes()
	-- Im Schauer gibt es keine Locks!
	for _, plot in ipairs(Services.PlotService.Plots) do
		Services.PlotService.SetLocked(plot, 0)
	end
	Services.EconomyService.NotifyAll(
		"🌠 METEORITENSCHAUER! Keine Locks, " .. Config.ShowerLuck .. "x Glück!",
		"Event"
	)
end

-- -------------------------------------------------------------------
-- ZUFALL
-- -------------------------------------------------------------------
function MeteorService.RollRarity(luck: number)
	return Util.WeightedPick(Config.Rarities, function(rarity)
		local index = Config.RarityIndex[rarity.Name]
		if #Config.MeteorsByRarity[rarity.Name] == 0 then
			return 0
		end
		return index >= 3 and rarity.Weight * luck or rarity.Weight
	end, rng)
end

function MeteorService.RollMutation(luck: number): string
	local mut = Util.WeightedPick(Config.Mutations, function(m)
		return m.Name == "Normal" and m.Weight or m.Weight * luck
	end, rng)
	return mut.Name
end

function MeteorService.RandomOfRarity(rarityName: string)
	local list = Config.MeteorsByRarity[rarityName]
	if not list or #list == 0 then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

function MeteorService.RollEntry(luck: number?)
	luck = luck or MeteorService.GetLuck()
	local rarity = MeteorService.RollRarity(luck :: number)
	local def = MeteorService.RandomOfRarity(rarity.Name) or Config.Meteors[1]
	return { Id = def.Id, Mut = MeteorService.RollMutation(luck :: number), Lv = 1, Xp = 0 }
end

-- -------------------------------------------------------------------
-- METEORE AM BODEN
-- -------------------------------------------------------------------
local function removeRecord(record)
	local index = table.find(groundMeteors, record)
	if index then
		table.remove(groundMeteors, index)
	end
	if record.Part then
		record.Part:Destroy()
		record.Part = nil
	end
end

local function randomLandingSpot(): Vector3
	local center = Services.PlotService.CraterCenter
	local radius = Services.PlotService.CraterRadius - 7
	local best = center
	for _ = 1, 10 do
		local angle = rng:NextNumber() * math.pi * 2
		local dist = math.sqrt(rng:NextNumber()) * radius
		local pos = center + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
		local free = true
		for _, record in ipairs(groundMeteors) do
			if record.Part and (record.Part.Position - pos).Magnitude < 7 then
				free = false
				break
			end
		end
		best = pos
		if free then
			break
		end
	end
	return best
end

local function tryClaim(player: Player, record)
	if record.Claimed or not record.Landed then
		return
	end
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 or not record.Part then
		return
	end
	if (root.Position - record.Part.Position).Magnitude > record.Part.Size.X / 2 + 14 then
		return -- zu weit weg (Schutz gegen Exploits)
	end
	if not Services.PlotService.GetPlot(player) then
		Services.EconomyService.Notify(player, "Du hast keine Base auf diesem Server.", "Error")
		return
	end
	if Services.CarryService.IsCarrying(player) then
		Services.EconomyService.Notify(player, "Du trägst schon einen Meteor!", "Error")
		return
	end
	if not Services.PlotService.FreeSlot(player) then
		Services.EconomyService.Notify(player, "Deine Base ist voll! Verkaufe einen Meteor (F).", "Error")
		return
	end
	local def = Config.MeteorsById[record.Entry.Id]
	if record.Price > 0 then
		local rarity = Config.RaritiesByName[def.Rarity]
		local required = rarity.RequiredRebirths or 0
		if data.Rebirths < required then
			Services.EconomyService.Notify(
				player,
				def.Rarity .. " braucht " .. required .. " Rebirth(s) zum Kaufen – aber klauen geht! 😈",
				"Error"
			)
			return
		end
		if data.Cash < record.Price then
			Services.EconomyService.Notify(
				player,
				"Nicht genug Cash! Du brauchst " .. Util.FormatCash(record.Price),
				"Error"
			)
			return
		end
		data.Cash -= record.Price
		data.Stats.Bought += 1
	end
	record.Claimed = true
	local entry = record.Entry
	removeRecord(record)
	Services.EconomyService.MarkDirty(player)
	Services.CarryService.StartCarry(player, entry, { Source = "Ground" })
end

local function attachClaimPrompt(record)
	local def = Config.MeteorsById[record.Entry.Id]
	local action = record.Price > 0 and ("Kaufen " .. Util.FormatCash(record.Price)) or "Schnappen (GRATIS)"
	local prompt = MeteorFactory.AddPrompt(record.Part, "BuyPrompt", action, def.Name, Config.GrabHoldDuration)
	prompt.Enabled = record.Landed
	prompt.Triggered:Connect(function(player)
		tryClaim(player, record)
	end)
	return prompt
end

local function impactEffect(position: Vector3, size: number)
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = 0
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Visible = true
	explosion.Parent = workspace
	if size >= 4 then
		for _, player in ipairs(Players:GetPlayers()) do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root and (root.Position - position).Magnitude < 80 then
				Services.EconomyService.Effect(player, "Shake", size / 8)
			end
		end
	end
end

-- opts: { Id?, Mut?, Rarity?, Position?, Free?, Instant?, Announce? }
function MeteorService.SpawnMeteor(opts)
	opts = opts or {}
	local entry
	if opts.Id and Config.MeteorsById[opts.Id] then
		entry = { Id = opts.Id, Mut = opts.Mut or MeteorService.RollMutation(MeteorService.GetLuck()), Lv = 1, Xp = 0 }
	elseif opts.Rarity and Config.RaritiesByName[opts.Rarity] then
		local def = MeteorService.RandomOfRarity(opts.Rarity)
		if not def then
			return nil
		end
		entry = { Id = def.Id, Mut = opts.Mut or MeteorService.RollMutation(MeteorService.GetLuck()), Lv = 1, Xp = 0 }
	else
		entry = MeteorService.RollEntry()
	end
	if not Config.MutationsByName[entry.Mut] then
		entry.Mut = "Normal"
	end

	-- Platz schaffen: ältesten entfernen, wenn zu viele daliegen
	while #groundMeteors >= Config.MaxGroundMeteors + 10 do
		removeRecord(groundMeteors[1])
	end

	local price = opts.Free and 0 or math.floor(Config.MeteorValue(entry))
	local part = MeteorFactory.Create(entry, "Ground", price)
	local size = part.Size.Y
	local landing = opts.Position or randomLandingSpot()
	local landCF = CFrame.new(landing.X, 0.4 + size / 2, landing.Z)

	local record = {
		Entry = entry,
		Part = part,
		Price = price,
		Landed = false,
		Claimed = false,
		Expires = os.clock() + (opts.Free and Config.DroppedLifetime or Config.GroundLifetime),
	}
	table.insert(groundMeteors, record)
	attachClaimPrompt(record)

	local def = Config.MeteorsById[entry.Id]
	local rarityIndex = Config.RarityIndex[def.Rarity]
	if opts.Announce ~= false and rarityIndex >= 5 then
		local mut = entry.Mut ~= "Normal" and (entry.Mut .. " ") or ""
		Services.EconomyService.NotifyAll(
			"☄️ Ein " .. def.Rarity .. " " .. mut .. def.Name .. " schlägt ein!",
			"Event"
		)
	end

	if opts.Instant then
		part.CFrame = landCF
		part.Parent = folder
		record.Landed = true
		local prompt = part:FindFirstChild("BuyPrompt") :: ProximityPrompt?
		if prompt then
			prompt.Enabled = true
		end
		return record
	end

	-- Fall-Animation: schräg vom Himmel mit Feuerschweif
	local trail = Instance.new("Fire")
	trail.Name = "FallFire"
	trail.Size = size * 1.5
	trail.Heat = 20
	trail.Color = Color3.fromRGB(255, 140, 40)
	trail.SecondaryColor = Color3.fromRGB(255, 60, 20)
	trail.Parent = part
	part.CFrame = landCF + Vector3.new(rng:NextNumber(-60, 60), 260, rng:NextNumber(-60, 60))
	part.Parent = folder
	local tween = TweenService:Create(
		part,
		TweenInfo.new(1.4 + size * 0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ CFrame = landCF }
	)
	tween:Play()
	tween.Completed:Connect(function()
		if record.Part ~= part then
			return
		end
		trail:Destroy()
		record.Landed = true
		local prompt = part:FindFirstChild("BuyPrompt") :: ProximityPrompt?
		if prompt then
			prompt.Enabled = true
		end
		impactEffect(landCF.Position, size)
	end)
	return record
end

-- Ein Spieler lässt einen gekauften Meteor fallen (gebonkt/gestorben) -> gratis für alle!
function MeteorService.DropMeteor(entry, position: Vector3)
	local map = Services.PlotService
	local pos = Vector3.new(position.X, 0, position.Z)
	if pos.Magnitude > 200 then
		pos = map.CraterCenter
	end
	-- Nicht in einer fremden Base ablegen
	for _, plot in ipairs(map.Plots) do
		if map.IsInside(plot, pos) then
			pos = plot.EntranceCFrame.Position * Vector3.new(1, 0, 1)
			break
		end
	end
	return MeteorService.SpawnMeteor({
		Id = entry.Id,
		Mut = entry.Mut,
		Position = pos,
		Free = true,
		Instant = true,
		Announce = false,
	})
end

function MeteorService.ClearGround()
	for i = #groundMeteors, 1, -1 do
		removeRecord(groundMeteors[i])
	end
end

function MeteorService.Init(services)
	Services = services
	folder = Instance.new("Folder")
	folder.Name = "GroundMeteors"
	folder.Parent = Services.PlotService.MapFolder
end

function MeteorService.Start()
	nextShowerAt = now() + Config.ShowerInterval
	publishAttributes()

	-- Spawn-Schleife
	task.spawn(function()
		while true do
			local interval = MeteorService.IsShowerActive() and Config.ShowerSpawnInterval or Config.SpawnInterval
			task.wait(interval)
			local landedCount = 0
			for _, record in ipairs(groundMeteors) do
				if record.Price > 0 then
					landedCount += 1
				end
			end
			local limit = MeteorService.IsShowerActive() and Config.MaxGroundMeteors * 2 or Config.MaxGroundMeteors
			if #Players:GetPlayers() > 0 and landedCount < limit then
				local ok, err = pcall(MeteorService.SpawnMeteor, {})
				if not ok then
					warn("[MeteorService] Spawn-Fehler: " .. tostring(err))
				end
			end
		end
	end)

	-- Zerbröseln + Event-Timer
	task.spawn(function()
		local wasShower = false
		while true do
			task.wait(1)
			local clock = os.clock()
			for i = #groundMeteors, 1, -1 do
				local record = groundMeteors[i]
				if not record.Claimed and clock > record.Expires then
					removeRecord(record)
				end
			end
			local t = now()
			if not MeteorService.IsShowerActive() and t >= nextShowerAt then
				MeteorService.StartShower()
			end
			local active = MeteorService.IsShowerActive()
			if wasShower and not active then
				Services.EconomyService.NotifyAll("Der Meteoritenschauer ist vorbei. Locks gehen wieder!", "Info")
			end
			wasShower = active
		end
	end)
end

return MeteorService
]]></string>
          </Properties>
