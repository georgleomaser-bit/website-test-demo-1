	{ "PebbleBug", "Steinkäfer Kurt", "Bug", rgb(128, 136, 156), rgb(255, 170, 60), 2, 2 },
	{ "PebbleKing", "König Kieselstein", "King", rgb(196, 198, 210), rgb(220, 50, 75), 2, 0 },
})
