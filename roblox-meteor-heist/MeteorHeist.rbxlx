	local serverPage = pages.Server
	UI.Section(serverPage, "Server-Info", 10)
	local infoCard = UI.Card({ Size = UDim2.new(1, 0, 0, 104), LayoutOrder = 11, Parent = serverPage })
	local infoLabel = UI.Label({
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -24, 1, -16),
		Text = "...",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Font = Enum.Font.GothamBold,
		MaxText = 17,
		Parent = infoCard,
	})
	local showLocked: (boolean) -> ()
	local function refreshInfo()
		local result = admin("ServerInfo")
		local data = result and result.Data
		if type(data) ~= "table" then
			return
		end
		local events = if type(data.Events) == "table" and #data.Events > 0
			then table.concat(data.Events, ", ")
			else "keine"
		infoLabel.Text = ("Spieler: %d / %d\nLaufzeit: %s\nEvents: %s\nPing (Schnitt): %s   •   Server: %s"):format(
			tonumber(data.Players) or 0,
			tonumber(data.MaxPlayers) or 0,
			Util.FormatTime(tonumber(data.Uptime) or 0),
			events,
			if tonumber(data.Ping) then (tostring(data.Ping) .. " ms") else "?",
			if data.Locked then "GESPERRT" else "offen"
		)
		showLocked(data.Locked == true)
	end
	UI.Button({
		Size = UDim2.new(1, 0, 0, 40),
		Text = "Aktualisieren",
		Color = Theme.Blue,
		LayoutOrder = 12,
		MaxText = 16,
		Parent = serverPage,
	}, refreshInfo)
	onTabOpen.Server = refreshInfo

	UI.Section(serverPage, "Zugang", 20)
	local accessRow = UI.Row(serverPage, 21, 44)
	local lockButton: UI.Button
	local locked = false
	showLocked = function(value: boolean)
		locked = value
		lockButton.SetText(if value then "Server entsperren" else "Server sperren")
		lockButton.SetColor(if value then Theme.Green else Theme.Orange)
	end
	lockButton = UI.Button({
		Size = UDim2.new(0.5, -3, 1, 0),
		Text = "Server sperren",
		Color = Theme.Orange,
		LayoutOrder = 1,
		MaxText = 16,
		Parent = accessRow,
	}, function()
		if not locked and needsConfirm("LockServer", "Server sperren") then
			return
		end
		local result = admin("LockServer", { Enabled = not locked })
		if result and result.Ok then
			showLocked(not locked)
		end
	end)
	UI.Button({
		Size = UDim2.new(0.5, -3, 1, 0),
		Text = "Alle kicken (außer Admins)",
		Color = Theme.Red,
		LayoutOrder = 2,
		MaxText = 16,
		Parent = accessRow,
	}, function()
		if needsConfirm("KickAll", "Alle kicken") then
			return
		end
		admin("KickAll", { Reason = reasonBox.Text })
	end)

	UI.Section(serverPage, "Banns", 30)
	local banList = listFrame(serverPage, 33)
	local function showBans(result: any)
		clearChildren(banList, "Frame")
		if not result or type(result.Data) ~= "table" then
			return
		end
		for i, info in ipairs(result.Data) do
			local card = UI.Card({ Size = UDim2.new(1, 0, 0, 48), LayoutOrder = i, Parent = banList })
			local days = tonumber(info.Days) or 0
			UI.Label({
				Position = UDim2.fromOffset(10, 4),
				Size = UDim2.new(0.72, -10, 1, -8),
				Text = ("%s (%s) – %s\n%s  •  %s"):format(
					tostring(info.Name),
					tostring(info.UserId),
					if info.Active then "gebannt" else "nicht (mehr) gebannt",
					if days > 0 then (("%.1f Tage"):format(days)) else "für immer",
					tostring(info.Reason or "")
				),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true,
				Font = Enum.Font.GothamBold,
				MaxText = 14,
				Parent = card,
			})
			if info.Active then
				UI.Button({
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -8, 0.5, 0),
					Size = UDim2.new(0.25, -8, 0, 36),
					Text = "Entbannen",
					Color = Theme.Green,
					MaxText = 15,
					Parent = card,
				}, function()
					local unban = admin("Unban", { Target = tostring(info.UserId) })
					if unban and unban.Ok then
						showBans(admin("BanList"))
					end
				end)
			end
		end
	end
	local banRow = UI.Row(serverPage, 31, 42)
	UI.Button({
		Size = UDim2.new(0.5, -3, 1, 0),
		Text = "Banns dieser Sitzung",
		Color = Theme.Blue,
		LayoutOrder = 1,
		MaxText = 16,
		Parent = banRow,
	}, function()
		showBans(admin("BanList"))
	end)
	UI.Button({
		Size = UDim2.new(0.5, -3, 1, 0),
		Text = "Bann-Verlauf vom Ziel (UserId)",
		Color = Theme.Purple,
		LayoutOrder = 2,
		MaxText = 16,
		Parent = banRow,
	}, function()
		showBans(admin("BanHistory", { Target = target() }))
	end)

	-- =================================================================
	-- NOCLIP (lokal, nur solange der Server AdminNoclip gesetzt hat)
	-- Der Humanoid steht weiter auf dem Boden (er sucht ihn per Strahl), läuft aber durch Wände.
	-- =================================================================
	local noclipParts: { [BasePart]: boolean } = {}
	local noclipConn: RBXScriptConnection? = nil
	local function restoreCollisions()
		for part in pairs(noclipParts) do
			if part.Parent then
				part.CanCollide = true
			end
		end
		table.clear(noclipParts)
	end
	local function updateNoclip()
		local enabled = player:GetAttribute("AdminNoclip") == true
		if enabled and not noclipConn then
			noclipConn = RunService.Stepped:Connect(function()
				local character = player.Character
				if not character then
					return
				end
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						noclipParts[part] = true
						part.CanCollide = false
					end
				end
			end)
		elseif not enabled and noclipConn then
			noclipConn:Disconnect()
			noclipConn = nil
			restoreCollisions()
		end
	end
	player:GetAttributeChangedSignal("AdminNoclip"):Connect(updateNoclip)
	updateNoclip()

	-- Öffnen: Knopf rechts + Taste P, Zuschauen beenden: Taste X
	ctx.Hud.AddRightButton("🛠️", "Admin", Theme.Red, 99, function()
		UI.ToggleWindow(win)
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == Enum.KeyCode.P then
			UI.ToggleWindow(win)
		elseif input.KeyCode == SPECTATE_KEY and spectating then
			stopSpectate()
		end
	end)
	selectTab(currentTab)
	ctx.Toast("Admin-Panel: Taste P  •  Fliegen: G  •  Foto: H", "Info")
end

return AdminPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Base</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  🏠 BASE: Fenster zum Kaufen von Stockwerken + Base-Look (Knopf rechts),
--  dazu die Laser-Sperre am Eingang jeder Base (Streifen fahren beim Sperren zu, flimmern, Funken).
--  Kaufen fragt den Server ("BuyFloor" / "BuyBaseLook"), der prüft Geld + Reihenfolge.
--  Animationen (alles lokal, rein optisch, nur in Kameranähe):
--    • Effekt "FloorBuilt": das neue Stockwerk baut sich auf – Stufen und Pfeiler wachsen von unten,
--      Platte und Rand fallen von oben rein und federn, am Ende Staub + Funken
--    • Effekt "LookUpgrade": neue Deko ploppt nacheinander auf, Funkeln an Zaun und Laternen
--    • Lock-Knopf der eigenen Base: pulsierender Leuchtring, solange nicht gesperrt;
--      beim Sperren Druckwelle am Knopf + Funken an den Laser-Pfosten
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local Base = {}

local ctx: any = nil
local Theme = UI.Theme
local GRAY = Theme.Gray

type Row = { Index: number, Button: UI.Button, Card: Frame, Stroke: UIStroke }

local player = Players.LocalPlayer
local floorRows: { Row } = {}
local lookRows: { Row } = {}
local slotLabel: TextLabel
local badge: Frame? = nil

-- ---------------------------------------------------------------------
-- FENSTER
-- ---------------------------------------------------------------------
local function row(parent: Instance, order: number, title: string, info: string, onBuy: () -> ()): (Frame, UI.Button)
	local card = UI.Card({ Size = UDim2.new(1, 0, 0, 62), LayoutOrder = order, Parent = parent })
	UI.Label({
		Position = UDim2.fromOffset(12, 5),
		Size = UDim2.new(1, -190, 0, 30),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 22,
		Outline = 2,
		Parent = card,
	})
	UI.Label({
		Position = UDim2.fromOffset(12, 35),
		Size = UDim2.new(1, -190, 0, 20),
		Text = info,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.SubText,
		MaxText = 14,
		Parent = card,
	})
	local button = UI.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(160, 44),
		Text = "...",
		Color = GRAY,
		MaxText = 18,
		Parent = card,
	}, onBuy)
	return card, button
end

local function build()
	local win = UI.Window("🏠 BASE", 520, 560, Theme.Gold)
	local content = win.Content
	local Config = ctx.Config

	UI.Section(content, "🏢 Stockwerke", 1)
	slotLabel = UI.Label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = "",
		Font = Enum.Font.GothamBold,
		TextColor3 = Theme.SubText,
		LayoutOrder = 2,
		MaxText = 16,
		Parent = content,
	})
	local floors = if type(Config.BaseFloors) == "table" then Config.BaseFloors else {}
	for i, def in ipairs(floors) do
		local need = math.floor(tonumber(def.RequiredRebirths) or 0)
		local info = ("+%d Plätze"):format(math.floor(tonumber(def.Slots) or 0))
		if need > 0 then
			info ..= ("  •  ab %d Rebirth"):format(need)
		end
		local card, button = row(content, 10 + i, tostring(def.Name or ("Stockwerk " .. (i + 1))), info, function()
			ctx.Request("BuyFloor")
		end)
		table.insert(floorRows, {
			Index = i,
			Button = button,
			Card = card,
			Stroke = card:FindFirstChildOfClass("UIStroke") :: UIStroke,
		})
	end

	UI.Section(content, "✨ Base-Look", 50)
	local looks = if type(Config.BaseLooks) == "table" then Config.BaseLooks else {}
	for i, def in ipairs(looks) do
		local title = ("%s %s"):format(tostring(def.Icon or ""), tostring(def.Name or i))
		local card, button = row(content, 50 + i, title, tostring(def.Info or ""), function()
			ctx.Request("BuyBaseLook")
		end)
		table.insert(lookRows, {
			Index = i,
			Button = button,
			Card = card,
			Stroke = card:FindFirstChildOfClass("UIStroke") :: UIStroke,
		})
	end
	UI.Label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = "Bleibt auch nach Rebirth!",
		Font = Enum.Font.GothamBold,
		TextColor3 = Theme.SubText,
		LayoutOrder = 99,
		MaxText = 14,
		Parent = content,
	})
	ctx.Windows.Register("Base", win, Base.Refresh)
	local button = ctx.Hud.AddRightButton("🏗️", "Base", Theme.Gold, 8, function()
		ctx.Windows.Toggle("Base")
	end)
	badge = UI.Badge(button, "!")
end

local function setRow(r: Row, text: string, color: Color3, highlight: boolean)
	r.Button.SetText(text)
	r.Button.SetColor(color)
	local strokeColor = if highlight then Theme.Gold else Color3.new(0, 0, 0)
	if r.Stroke and r.Stroke.Color ~= strokeColor then
		r.Stroke.Color = strokeColor
		r.Stroke.Thickness = if highlight then 4 else 2
	end
end

-- Nächstes Stockwerk, das man kaufen kann (nil = alle gebaut)
local function nextFloorDef(state: any): any
	local defs = ctx.Config.BaseFloors
	return if type(defs) == "table" then defs[tonumber(state.BaseFloors) or 1] else nil
end

function Base.Refresh(state: any)
	if not state then
		return
	end
	local Util = ctx.Util
	local cash = tonumber(state.Cash) or 0
	local rebirths = tonumber(state.Rebirths) or 0
	local floors = tonumber(state.BaseFloors) or 1
	local look = tonumber(state.BaseLook) or 1
	local text = ("Plätze: %d / %d  •  Stockwerk %d"):format(
		math.floor(tonumber(state.UsedSlots) or 0),
		math.floor(tonumber(state.Slots) or 0),
		floors
	)
	if slotLabel.Text ~= text then
		slotLabel.Text = text
	end
	for _, r in ipairs(floorRows) do
		local def = ctx.Config.BaseFloors[r.Index]
		local price = tonumber(def.Price) or 0
		local need = math.floor(tonumber(def.RequiredRebirths) or 0)
		if r.Index + 1 <= floors then
			setRow(r, "✅ Gebaut", GRAY, true)
		elseif r.Index == floors then
			if rebirths < need then
				setRow(r, "🔥 Rebirth " .. need, GRAY, false)
			else
				setRow(r, "💵 " .. Util.FormatCash(price), if cash >= price then Theme.Green else GRAY, false)
			end
		else
			setRow(r, "🔒 " .. Util.FormatCash(price), GRAY, false)
		end
	end
	for _, r in ipairs(lookRows) do
		local def = ctx.Config.BaseLooks[r.Index]
		local price = tonumber(def.Price) or 0
		if r.Index == look then
			setRow(r, "✅ Aktiv", Theme.Gold, true)
		elseif r.Index < look then
			setRow(r, "✅ Gekauft", GRAY, false)
		elseif r.Index == look + 1 then
			setRow(r, "💵 " .. Util.FormatCash(price), if cash >= price then Theme.Green else GRAY, false)
		else
			setRow(r, "🔒 " .. Util.FormatCash(price), GRAY, false)
		end
	end
end

-- Badge jede neue State-Meldung: "!" wenn das nächste Stockwerk bezahlbar ist
function Base.OnState(state: any)
	if not badge or not state then
		return
	end
	local cash = tonumber(state.Cash) or 0
	local nextFloor = nextFloorDef(state)
	local need = nextFloor and math.floor(tonumber(nextFloor.RequiredRebirths) or 0) or 0
	local show = nextFloor ~= nil
		and cash >= (tonumber(nextFloor.Price) or math.huge)
		and (tonumber(state.Rebirths) or 0) >= need
	UI.SetBadge(badge, if show then "!" else nil, nil, show)
end

-- ---------------------------------------------------------------------
-- LASER-SPERRE (lokal): Streifen fahren von beiden Pfosten zur Mitte
-- ---------------------------------------------------------------------
type Gate = {
	Barrier: BasePart,
	Beams: { { Part: BasePart, Closed: CFrame, Open: CFrame, Size: Vector3 } },
	State: string, -- "open" / "lock" / "shield"
}

local SPARK_RANGE = 220 -- Funken + Flimmern nur so nah an der Kamera
local SHIMMER_RANGE = 200
local LOCK_COLOR = Color3.fromRGB(255, 50, 50)
local SHIELD_COLOR = Color3.fromRGB(70, 170, 255)
local BEAM_THICK = 0.3
local CLOSE_TIME = 0.7
local OPEN_TIME = 0.4
local STAGGER = 0.06

local gates: { [Instance]: Gate } = {}
local laserFolder: Folder? = nil

local function makeGate(model: Instance, barrier: BasePart): Gate
	local folder = laserFolder :: Folder
	local count = math.clamp(math.floor(tonumber(barrier:GetAttribute("Beams")) or 5), 1, 8)
	local width, height = barrier.Size.X, barrier.Size.Y
	local half = width / 2
	local beams = {}
	for k = 1, count do
		local y = -height / 2 + height * (k - 0.5) / count
		for _, s in ipairs({ -1, 1 }) do
			local closedCf = barrier.CFrame * CFrame.new(s * half / 2, y, 0)
			local openCf = barrier.CFrame * CFrame.new(s * half, y, 0)
			local p = Instance.new("Part")
			p.Name = "Laser"
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Color = LOCK_COLOR
			p.Transparency = 1
			p.Size = Vector3.new(0.05, BEAM_THICK, BEAM_THICK)
			p.CFrame = openCf
			p.Parent = folder
			table.insert(
				beams,
				{ Part = p, Closed = closedCf, Open = openCf, Size = Vector3.new(half, BEAM_THICK, BEAM_THICK) }
			)
		end
	end
	local gate: Gate = { Barrier = barrier, Beams = beams, State = "open" }
	gates[model] = gate
	return gate
end

-- Funken an beiden Laser-Pfosten + Druckwelle am Lock-Knopf (nur in Kameranähe, macht Effects)
local function gateSparks(model: Instance, gate: Gate, color: Color3)
	local effects = ctx and ctx.Effects
	local camera = workspace.CurrentCamera
	local barrier = gate.Barrier
	if not effects or not effects.Burst or not camera then
		return
	end
	if (barrier.Position - camera.CFrame.Position).Magnitude > SPARK_RANGE then
		return
	end
	local half = barrier.Size.X / 2
	for _, s in ipairs({ -1, 1 }) do
		effects.Burst((barrier.CFrame * CFrame.new(s * half, 0, 0)).Position, color, 8, false)
	end
	local pad = model:FindFirstChild("LockPad")
	if pad and pad:IsA("BasePart") then
		effects.Ring(pad.Position - Vector3.new(0, pad.Size.Y / 2, 0), color, 14, 0.5)
	end
end

local function setGate(gate: Gate, state: string, model: Instance?)
	if gate.State == state then
		return
	end
	local wasOpen = gate.State == "open"
	gate.State = state
	if wasOpen and model then
		gateSparks(model, gate, if state == "shield" then SHIELD_COLOR else LOCK_COLOR)
	end
	for i, beam in ipairs(gate.Beams) do
		local p = beam.Part
		local delayTime = math.floor((i - 1) / 2) * STAGGER
		if state == "open" then
			local tween = TweenService:Create(
				p,
				TweenInfo.new(OPEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, delayTime),
				{ Size = Vector3.new(0.05, BEAM_THICK, BEAM_THICK), CFrame = beam.Open }
			)
			tween.Completed:Connect(function(status)
				if status == Enum.PlaybackState.Completed and gate.State == "open" then
					p.Transparency = 1
				end
			end)
			tween:Play()
		else
			p.Color = if state == "shield" then SHIELD_COLOR else LOCK_COLOR
			p.Transparency = 0.15
			if wasOpen then
				TweenService:Create(
					p,
					TweenInfo.new(CLOSE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delayTime),
					{ Size = beam.Size, CFrame = beam.Closed }
				):Play()
			end
		end
	end
end

local function updateGates()
	local now = workspace:GetServerTimeNow()
	for model, gate in pairs(gates) do
		if not model.Parent or not gate.Barrier.Parent then
			for _, beam in ipairs(gate.Beams) do
				beam.Part:Destroy()
			end
			gates[model] = nil
		else
			local shield = tonumber(model:GetAttribute("ShieldUntil")) or 0
			local locked = tonumber(model:GetAttribute("LockedUntil")) or 0
			local state = if shield > now then "shield" elseif locked > now then "lock" else "open"
			setGate(gate, state, model)
		end
	end
end

local function scanPlots(plots: Instance)
	for _, model in ipairs(plots:GetChildren()) do
		if not gates[model] and model:GetAttribute("LockedUntil") ~= nil then
			local barrier = model:FindFirstChild("Barrier")
			if barrier and barrier:IsA("BasePart") then
				makeGate(model, barrier)
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- LASER-FLIMMERN + LEUCHTRING AM EIGENEN LOCK-KNOPF (jedes Frame, nur in Kameranähe)
-- ---------------------------------------------------------------------
local plotsFolder: Instance? = nil
local lockRing: BasePart? = nil
local ringShown = false
local fxClock = 0

local function myPlot(): Instance?
	local plots = plotsFolder
	if not plots then
		return nil
	end
	for model in pairs(gates) do
		if model:GetAttribute("OwnerUserId") == player.UserId then
			return model
		end
	end
	return nil
end

local function buildLockRing()
	local ring = Instance.new("Part")
	ring.Name = "LockRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 90, 90)
	ring.Transparency = 1
	ring.Size = Vector3.new(0.12, 8, 8)
	ring.CFrame = CFrame.new(0, -5000, 0)
	ring.Parent = laserFolder
	lockRing = ring
end

local myGateModel: Instance? = nil
local myGateClock = 0

local function stepGateFx(dt: number)
	fxClock += dt
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local camPos = camera.CFrame.Position
	for _, gate in pairs(gates) do
		if gate.State ~= "open" and (gate.Barrier.Position - camPos).Magnitude < SHIMMER_RANGE then
			for i, beam in ipairs(gate.Beams) do
				beam.Part.Transparency = 0.08 + 0.3 * (math.sin(fxClock * 17 + i * 1.7) + 1) / 2
			end
		end
	end
	-- eigener Lock-Knopf: Ring pulsiert, solange die Base offen ist ("tritt drauf!")
	myGateClock += dt
	if myGateClock > 1 or not myGateModel then
		myGateClock = 0
		myGateModel = myPlot()
	end
	local ring = lockRing
	local model = myGateModel
	local gate = model and gates[model]
	local pad = model and model:FindFirstChild("LockPad")
	local show = ring ~= nil
		and gate ~= nil
		and gate.State == "open"
		and pad ~= nil
		and pad:IsA("BasePart")
		and (pad.Position - camPos).Magnitude < 150
		and (tonumber(ReplicatedStorage:GetAttribute("ShowerUntil")) or 0) <= workspace:GetServerTimeNow()
		and not (ctx.Effects.IsHidden and ctx.Effects.IsHidden())
	if ring and show ~= ringShown then
		ringShown = show
		if not show then
			ring.Transparency = 1
			ring.CFrame = CFrame.new(0, -5000, 0)
		end
	end
	if ring and show and pad and pad:IsA("BasePart") then
		local u = (fxClock * 0.8) % 1
		local size = 6 + u * 5
		ring.Size = Vector3.new(0.12, size, size)
		ring.Transparency = 0.2 + 0.8 * u
		local bottom = pad.Position - Vector3.new(0, pad.Size.Y / 2 - 0.05, 0)
		ring.CFrame = CFrame.new(bottom) * CFrame.Angles(0, 0, math.pi / 2)
	end
end

-- ---------------------------------------------------------------------
-- BAU-ANIMATION (Stockwerk gekauft) + LOOK-FUNKELN
-- ---------------------------------------------------------------------
local BUILD_RANGE = 320
local BUILD_STAGGER = 0.035
local BUILD_MAX_DELAY = 1.1
local GROW_TIME = 0.4
local DROP_TIME = 0.55
local DROP_HEIGHT = 16
local LOOK_STAGGER = 0.05
local LOOK_TIME = 0.45
local SPARKLE = Color3.fromRGB(255, 225, 110)

local function findPlotModel(index: any): Instance?
	local plots = plotsFolder
	if not plots or type(index) ~= "number" then
		return nil
	end
	for _, model in ipairs(plots:GetChildren()) do
		if model:GetAttribute("PlotIndex") == index then
			return model
		end
	end
	return nil
end

local function inRange(model: Instance): boolean
	local camera = workspace.CurrentCamera
	if not camera or not model:IsA("Model") then
		return false
	end
	return (model:GetPivot().Position - camera.CFrame.Position).Magnitude < BUILD_RANGE
end

-- Ein Teil von unten wachsen lassen (Stufen, Pfeiler) bzw. von oben reinfallen lassen (Platte, Rand)
local function buildPart(part: BasePart, delayTime: number, drop: boolean)
	local finalCf, finalSize, collide = part.CFrame, part.Size, part.CanCollide
	part.CanCollide = false
	part.LocalTransparencyModifier = 1
	local info
	if drop then
		part.CFrame = finalCf
			+ Vector3.new(0, DROP_HEIGHT, 0)
			+ Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1)
		info = TweenInfo.new(DROP_TIME, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out, 0, false, delayTime)
	else
		local flat = Vector3.new(finalSize.X, math.min(0.2, finalSize.Y), finalSize.Z)
		part.Size = flat
		part.CFrame = finalCf * CFrame.new(0, -(finalSize.Y - flat.Y) / 2, 0)
		info = TweenInfo.new(GROW_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, delayTime)
	end
	TweenService:Create(part, info, { CFrame = finalCf, Size = finalSize }):Play()
	task.delay(delayTime, function()
		part.LocalTransparencyModifier = 0
	end)
	task.delay(delayTime + math.max(GROW_TIME, DROP_TIME) + 0.1, function()
		-- genau zurück auf die echten Werte (der Server hat sie nie geändert)
		part.CFrame = finalCf
		part.Size = finalSize
		part.CanCollide = collide
		part.LocalTransparencyModifier = 0
	end)
end

local function animateFloor(floorModel: Instance)
	local grow: { BasePart } = {}
	local drop: { BasePart } = {}
	for _, d in ipairs(floorModel:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Name == "Step" or d.Name == "Pillar" then
				table.insert(grow, d)
			else
				table.insert(drop, d)
			end
		end
	end
	-- Treppe von unten nach oben, dann die Pfeiler, danach fällt die Platte drauf
	table.sort(grow, function(a, b)
		return a.Position.Y + a.Size.Y / 2 < b.Position.Y + b.Size.Y / 2
	end)
	local stagger = math.min(BUILD_STAGGER, BUILD_MAX_DELAY / math.max(1, #grow + #drop))
	local delayTime = 0
	for _, part in ipairs(grow) do
		buildPart(part, delayTime, false)
		delayTime += stagger
	end
	local plateAt = delayTime
	for i, part in ipairs(drop) do
		buildPart(part, plateAt + (i - 1) * stagger * 0.5, true)
	end
	local total = plateAt + #drop * stagger * 0.5 + DROP_TIME
	local effects = ctx.Effects
	task.delay(total, function()
		if not floorModel.Parent or not effects.Burst then
			return
		end
		local plate = floorModel:FindFirstChild("Floor")
		if plate and plate:IsA("BasePart") then
			local top = plate.Position + Vector3.new(0, plate.Size.Y / 2, 0)
			effects.Puff(top, Color3.fromRGB(230, 220, 200), 18)
			effects.Burst(top + Vector3.new(0, 3, 0), SPARKLE, 26, true)
			effects.Ring(top, SPARKLE, 40, 0.7)
		end
	end)
end

local function onFloorBuilt(data: any)
	if type(data) ~= "table" then
		return
	end
	local model = findPlotModel(data.Plot)
	if not model or not inRange(model) then
		return
	end
	local floors = model:FindFirstChild("Floors")
	local floorModel = floors and floors:WaitForChild("Floor" .. tostring(data.Floor), 3)
	if floorModel then
		animateFloor(floorModel)
	end
end

local function onLookUpgrade(data: any)
	if type(data) ~= "table" then
		return
	end
	local model = findPlotModel(data.Plot)
	if not model or not inRange(model) then
		return
	end
	local look = model:FindFirstChild("Look")
	local parts: { BasePart } = {}
	if look then
		for _, d in ipairs(look:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(parts, d)
			end
		end
	end
	local effects = ctx.Effects
	for i, part in ipairs(parts) do
		local finalSize = part.Size
		local delayTime = math.min(1.2, (i - 1) * LOOK_STAGGER)
		part.Size = finalSize * 0.05
		TweenService:Create(
			part,
			TweenInfo.new(LOOK_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, delayTime),
			{ Size = finalSize }
		):Play()
		task.delay(delayTime + LOOK_TIME + 0.05, function()
			part.Size = finalSize
		end)
		-- Funkeln an Laternen, Fahnen und Bogen (jedes dritte Teil, das reicht)
		if effects.Burst and i % 3 == 1 then
			task.delay(delayTime + LOOK_TIME * 0.6, function()
				if part.Parent then
					effects.Burst(part.Position, SPARKLE, 6, false)
				end
			end)
		end
	end
	-- Glanz über den Zaun
	if effects.Burst then
		for _, child in ipairs(model:GetChildren()) do
			if child:IsA("BasePart") and (child.Name == "BackFence" or child.Name == "SideFence") then
				effects.Burst(child.Position + Vector3.new(0, 1.5, 0), SPARKLE, 12, false)
			end
		end
		local floorPart = model:FindFirstChild("Floor")
		if floorPart and floorPart:IsA("BasePart") then
			effects.Ring(floorPart.Position + Vector3.new(0, floorPart.Size.Y / 2, 0), SPARKLE, 70, 0.8)
		end
	end
end

function Base.SetMap(map: Instance)
	local plots = map:WaitForChild("Plots", 60)
	if not plots then
		return
	end
	plotsFolder = plots
	local folder = Instance.new("Folder")
	folder.Name = "BaseLasers" -- nur lokal
	folder.Parent = workspace
	laserFolder = folder
	buildLockRing()
	RunService.RenderStepped:Connect(function(dt: number)
		local ok, err = pcall(stepGateFx, dt)
		if not ok then
			warn("[Base] Effekte: " .. tostring(err))
		end
	end)
	task.spawn(function()
		local clock = 0
		while true do
			if clock % 10 == 0 then
				scanPlots(plots) -- neue Basen (Replikation) nachholen
			end
			clock += 1
			local ok, err = pcall(updateGates)
			if not ok then
				warn("[Base] Laser: " .. tostring(err))
			end
			task.wait(0.2)
		end
	end)
end

function Base.Init(context: any)
	ctx = context
	build()
	ctx.Remotes.Effect.OnClientEvent:Connect(function(name, _strength, data)
		if name == "FloorBuilt" then
			task.spawn(onFloorBuilt, data)
		elseif name == "LookUpgrade" then
			task.spawn(onLookUpgrade, data)
		end
	end)
end

return Base
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Bat</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  SCHLÄGER (lokal): Ausholen und Zuschlagen über Tool.Grip, kurzes Taumeln nach einem Treffer
--   • Schwung: Grip wird lokal getweent (ausholen -> zuschlagen -> zurück). Andere Spieler sehen die
--     "Slash"-Animation, die der Server über das Standard-Animate-Skript startet.
--   • Getroffen (Effekt "Bonked" vom Server): kurz umfallen (PlatformStand) und wieder aufstehen.
--     Niemand stirbt davon. Den Rückstoß selbst macht der Server.
--  Ob ein Schlag trifft, entscheidet NUR der Server (Reichweite, Abklingzeit, Blickrichtung ...).
-- =====================================================================

local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Bat = {}

local player = Players.LocalPlayer
local ctx: any = nil

-- Gleiche Ruhe-Haltung wie beim Server (CarryService BAT_REST_GRIP); positive Winkel = nach vorne
local GRIP_POS = CFrame.new(0, -0.4, 0)
local REST = GRIP_POS * CFrame.Angles(math.rad(-15), 0, 0)
local WINDUP = GRIP_POS * CFrame.Angles(math.rad(-70), 0, 0)
local STRIKE = GRIP_POS * CFrame.Angles(math.rad(85), 0, 0)
local WINDUP_INFO = TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local STRIKE_INFO = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local RETURN_INFO = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local SWING_SOUND = "rbxasset://sounds/swordslash.wav"
local TUMBLE_SPIN = 7 -- Drehung beim Umfallen (rad/s)

local swinging = false
local lastSwing = 0
local swingSound: Sound? = nil
local stunToken = 0
local hooked: { [Tool]: boolean } = {}

-- Abklingzeit wie beim Server (Super-Bonk-Boost macht schneller)
local function cooldownFor(tool: Tool): number
	local Config = ctx.Config
	local bat = Config.BatsById and Config.BatsById[tool:GetAttribute("Bat")]
	local cooldown = bat and tonumber(bat.Cooldown) or 0.8
	local gadgets = ctx.State and ctx.State.Gadgets
	if type(gadgets) == "table" and table.find(gadgets, "SuperBonk") then
		cooldown *= tonumber(Config.SuperBonkCooldownMult) or 1
	end
	return cooldown
end

local function swing(tool: Tool)
	local now = os.clock()
	if swinging or now - lastSwing < cooldownFor(tool) then
		return
	end
	lastSwing = now
	swinging = true
	local sound = swingSound
	if sound then
		sound.PlaybackSpeed = 0.9 + math.random() * 0.2
		sound:Play()
	end
	local windup = TweenService:Create(tool, WINDUP_INFO, { Grip = WINDUP })
	windup:Play()
	windup.Completed:Wait()
	local strike = TweenService:Create(tool, STRIKE_INFO, { Grip = STRIKE })
	strike:Play()
	strike.Completed:Wait()
	local back = TweenService:Create(tool, RETURN_INFO, { Grip = REST })
	back:Play()
	back.Completed:Wait()
	swinging = false
end

local function hookTool(tool: Instance)
	if not tool:IsA("Tool") or tool:GetAttribute("Bat") == nil or hooked[tool] then
		return
	end
	hooked[tool] = true
	tool.Activated:Connect(function()
		task.spawn(swing, tool)
	end)
	tool.Destroying:Connect(function()
		hooked[tool] = nil
	end)
end

local function watchContainer(container: Instance)
	for _, child in ipairs(container:GetChildren()) do
		hookTool(child)
	end
	container.ChildAdded:Connect(hookTool)
end

-- Getroffen: kurz umfallen und in Flugrichtung kippen, danach wieder aufstehen
function Bat.Bonked(data: any)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return
	end
	if humanoid.PlatformStand and stunToken == 0 then
		return -- schon PlatformStand von etwas anderem (z.B. Fliegen) -> nicht stören
	end
	local seconds = math.clamp(tonumber(type(data) == "table" and data.Time) or 0.9, 0.2, 2)
	local dir = if type(data) == "table" and typeof(data.Dir) == "Vector3" then data.Dir else -root.CFrame.LookVector
	stunToken += 1
	local token = stunToken
	humanoid.PlatformStand = true
	root.AssemblyAngularVelocity = Vector3.yAxis:Cross(dir) * TUMBLE_SPIN
	task.delay(seconds, function()
		if token ~= stunToken then
			return
		end
		stunToken = 0
		if humanoid.Parent and humanoid.Health > 0 then
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

function Bat.Init(context: any)
	ctx = context
	local sound = Instance.new("Sound")
	sound.Name = "BatSwing"
	sound.SoundId = SWING_SOUND
	sound.Volume = 0.6
	sound.Parent = SoundService
	swingSound = sound
	local backpack = player:WaitForChild("Backpack", 10)
	if backpack then
		watchContainer(backpack)
	end
	local function onCharacter(character: Model)
		stunToken = 0
		watchContainer(character)
		local newBackpack = player:FindFirstChildOfClass("Backpack")
		if newBackpack and newBackpack ~= backpack then
			backpack = newBackpack
			watchContainer(newBackpack)
		end
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end
end

return Bat
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  EFFEKTE vom Server (Remote "Effect": name, strength, data)
--   "Steps"    -> fliegende "+X 👟"-Zahl über deinem Charakter (federt, Farbverlauf, kippelt)
--   "Collect"  -> großes "+$X" in der Bildschirmmitte + Münzen fliegen von dir zum Geld-Zähler
--   "Deliver"  -> Geister-Meteor fliegt im Bogen vom Nest in die Base, mit Funkenschweif
--                 (kommt er fast senkrecht von oben, z.B. Egg Rush: fällt er beschleunigt herunter),
--                 beim Aufprall: Staub-Puff + Druckwelle
--   "Hatch"    -> Funken-Explosion + Lichtblitz + Schalen-Splitter + Druckwelle, wenn ein Alien schlüpft
--                 (ab Legendary größer: Lichtsäule + zweite Druckwelle, Mythic+ Funkenwelle,
--                  Secret/Admin Regenbogen-Explosion)
--                 (das Alien selbst ploppt in WorldFX mit Overshoot herein)
--   "HatchReveal" -> große Karte in der Bildschirmmitte (Ultra / ab Epic) mit Strahlenkranz + Konfetti,
--                    sonst bzw. beim Tragen kleine Karte oben rechts
--   "Shake" (weich und dezent), "Confetti" (fliegt aus zwei Kanonen hoch, fällt mit Schwerkraft,
--   dreht und flattert), "Alarm" wie bisher
--   "BigNest"  -> Legendary+ im großen Nest: bunte Konfetti-Bursts + Druckwelle am Nest
--   "RaceStart" -> Ei-Rennen startet: Konfetti am Renn-Nest + drei Trommelschläge
--   "NestPop"  -> (lokal vom Modul NestField) neues Ei im Nest: kleines Aufleuchten
--   "Announce" -> große Admin-Ansage oben in der Mitte: Kopfbild, Name in Blau + Haken, Text in Weiß
--                 (ohne Box, federt rein, ~8 s, blendet aus; mehrere nacheinander)
--   "Warn"     -> großer roter Hinweis vom Admin in der Bildschirmmitte
--   "Bonked"   -> vom Schläger getroffen: kurz taumeln (macht das Modul Bat)
--  Dazu: Rebirth-Bildschirmblitz (Effects.RebirthFlash, vom HUD aufgerufen).
--  Bausteine für andere Module: Effects.Burst / Ring / Puff / Shake / IsHidden (Base, NestField, Trade).
--  ("FloorBuilt", "LookUpgrade" macht das Modul Base, "RaceStart"-Fanfare zusätzlich NestField.)
--  Dazu: 🧊 Eingefroren-Anzeige, solange der eigene HumanoidRootPart verankert ist (Falle/Admin).
--  Alles läuft lokal (nichts davon wird an andere Spieler geschickt).
-- =====================================================================

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))
local WorldFX = require(script.Parent:WaitForChild("WorldFX"))

local Effects = {}

local player = Players.LocalPlayer
local ctx: any = nil
local fxFolder: Folder? = nil
local overlay: ScreenGui? = nil -- eigene Ebene für Münzen, Konfetti, Blitze (ohne UI-Skalierung)
local hidden = false -- Foto-Modus: fliegende Zahlen aus

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

-- ---------------------------------------------------------------------
-- FLIEGENDE SCHRITTE-ZAHLEN (fester Vorrat von 12, wird wiederverwendet)
-- ---------------------------------------------------------------------
type FlyNumber = {
	Gui: BillboardGui,
	Label: TextLabel,
	Stroke: UIStroke,
	Scale: UIScale,
	Gradient: UIGradient,
	Active: boolean,
	Age: number,
	X: number,
	Y: number,
	Tilt: number,
}

local FLY_COUNT = 12
local FLY_LIFE = 1.15
local FLY_RISE = 3.6
-- Farbverläufe (oben hell -> unten kräftig), abwechselnd Gold und Himmelblau
local FLY_COLORS = {
	ColorSequence.new(Color3.fromRGB(255, 250, 170), Color3.fromRGB(255, 150, 20)),
	ColorSequence.new(Color3.fromRGB(190, 245, 255), Color3.fromRGB(40, 120, 255)),
}
local flyPool: { FlyNumber } = {}
local flyNext = 1
local flyColor = 1

local function buildFlyPool()
	local playerGui = player:WaitForChild("PlayerGui")
	for _ = 1, FLY_COUNT do
		local gui: BillboardGui = UI.Create("BillboardGui", {
			Name = "StepsPopup",
			Size = UDim2.fromOffset(260, 64),
			AlwaysOnTop = true,
			LightInfluence = 0,
			MaxDistance = 300,
			ResetOnSpawn = false,
			Enabled = false,
			Parent = playerGui,
		})
		local stroke: UIStroke = UI.Create("UIStroke", { Thickness = 3, Color = BLACK })
		local scale: UIScale = UI.Create("UIScale", { Scale = 1 })
		local gradient: UIGradient = UI.Create("UIGradient", { Rotation = 90, Color = FLY_COLORS[1] })
		local labelObj: TextLabel = UI.Create("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			Text = "",
			TextColor3 = WHITE, -- Farbe kommt aus dem Verlauf
			Parent = gui,
		}, { stroke, scale, gradient })
		table.insert(flyPool, {
			Gui = gui,
			Label = labelObj,
			Stroke = stroke,
			Scale = scale,
			Gradient = gradient,
			Active = false,
			Age = 0,
			X = 0,
			Y = 0,
			Tilt = 0,
		})
	end
end

local function showSteps(amount: number)
	if hidden or #flyPool == 0 then
		return
	end
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return
	end
	-- freien Platz suchen, sonst die älteste Zahl wiederverwenden
	local item: FlyNumber? = nil
	for _ = 1, FLY_COUNT do
		local candidate = flyPool[flyNext]
		flyNext = flyNext % FLY_COUNT + 1
		if not candidate.Active then
			item = candidate
			break
		end
	end
	if not item then
		local oldest = flyPool[1]
		for _, candidate in ipairs(flyPool) do
			if candidate.Age > oldest.Age then
				oldest = candidate
			end
		end
		item = oldest
	end
	local fly = item :: FlyNumber
	flyColor = flyColor % #FLY_COLORS + 1
	fly.Active = true
	fly.Age = 0
	fly.X = (math.random() - 0.5) * 5
	fly.Y = 1.2 + math.random() * 1.6
	fly.Tilt = (math.random() - 0.5) * 30
	fly.Label.Text = "+" .. UI.FormatSteps(amount, ctx.Util.FormatNumber) .. " 👟"
	fly.Gradient.Color = FLY_COLORS[flyColor]
	fly.Label.Rotation = fly.Tilt
	fly.Label.TextTransparency = 0
	fly.Stroke.Transparency = 0
	fly.Scale.Scale = 0.3
	fly.Gui.Adornee = rootPart
	fly.Gui.StudsOffset = Vector3.new(fly.X, fly.Y, 0)
	fly.Gui.Enabled = true
end

local function stepFlyNumbers(dt: number)
	for _, fly in ipairs(flyPool) do
		if fly.Active then
			fly.Age += dt
			local t = fly.Age / FLY_LIFE
			if t >= 1 or not fly.Gui.Adornee or not fly.Gui.Adornee.Parent then
				fly.Active = false
				fly.Gui.Enabled = false
			else
				local rise = 1 - (1 - t) * (1 - t) -- schnell hoch, dann langsamer
				fly.Gui.StudsOffset = Vector3.new(fly.X, fly.Y + rise * FLY_RISE, 0)
				-- federnder Bounce: aus 0.3 schnell über die Endgröße hinaus, gedämpft zurück
				local age = fly.Age
				local decay = math.exp(-age * 9)
				fly.Scale.Scale = 1 - 0.7 * decay * math.cos(age * 26)
				-- kippelt am Anfang hin und her und richtet sich dann auf
				fly.Label.Rotation = fly.Tilt * math.exp(-age * 5) * math.cos(age * 18)
				local fade = if t > 0.6 then (t - 0.6) / 0.4 else 0
				fly.Label.TextTransparency = fade
				fly.Stroke.Transparency = fade
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- GELD-POPUP "+$X"
-- ---------------------------------------------------------------------
local POPUP_POP_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local POPUP_RISE_INFO = TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local POPUP_FADE_INFO = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.75)
local MAX_POPUPS = 3
local popupCount = 0

local function cashPopup(amount: number)
	local gui = UI.Root
	if not gui or popupCount >= MAX_POPUPS then
		return
	end
	popupCount += 1
	local scale: UIScale = UI.Create("UIScale", { Scale = 0.4 })
	local stroke: UIStroke = UI.Create("UIStroke", { Thickness = 4, Color = BLACK })
	local popup: TextLabel = UI.Create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, (math.random() - 0.5) * 120, 0.44, 0),
		Size = UDim2.fromOffset(460, 70),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		Text = "+" .. ctx.Util.FormatCash(amount),
		TextColor3 = UI.Theme.Cash,
		ZIndex = 15,
		Parent = gui,
	}, { scale, stroke })
	TweenService:Create(scale, POPUP_POP_INFO, { Scale = 1 }):Play()
	TweenService:Create(popup, POPUP_RISE_INFO, { Position = popup.Position - UDim2.fromScale(0, 0.14) }):Play()
	TweenService:Create(popup, POPUP_FADE_INFO, { TextTransparency = 1 }):Play()
	TweenService:Create(stroke, POPUP_FADE_INFO, { Transparency = 1 }):Play()
	task.delay(1.3, function()
		popupCount -= 1
		popup:Destroy()
	end)
end

-- ---------------------------------------------------------------------
-- MÜNZEN fliegen von dir zum Geld-Zähler (fester Vorrat, nur Tweens)
-- ---------------------------------------------------------------------
type Coin = { Label: TextLabel, Busy: boolean }

local COIN_COUNT = 16
local COIN_OUT_INFO = TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local coinPool: { Coin } = {}

local function buildCoins()
	local gui = overlay
	if not gui then
		return
	end
	for _ = 1, COIN_COUNT do
		local coinLabel: TextLabel = UI.Create("TextLabel", {
			Name = "Coin",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(34, 34),
			BackgroundTransparency = 1,
			Text = "🪙",
			TextScaled = true,
			Font = Enum.Font.FredokaOne,
			Visible = false,
			ZIndex = 30,
			Parent = gui,
		})
		table.insert(coinPool, { Label = coinLabel, Busy = false })
	end
end

local function flyCoins(amount: number)
	local gui = overlay
	local camera = workspace.CurrentCamera
	local hud = ctx.Hud
	if not gui or hidden or not camera or #coinPool == 0 or not hud or not hud.CashAnchor then
		return
	end
	local target: Vector2? = hud.CashAnchor()
	if not target then
		return
	end
	local goal = UDim2.fromOffset(target.X, target.Y)
	local size = gui.AbsoluteSize
	local start = Vector2.new(size.X / 2, size.Y * 0.55)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local point, onScreen = camera:WorldToScreenPoint(root.Position)
		if onScreen then
			start = Vector2.new(point.X, point.Y)
		end
	end
	local count = math.clamp(math.floor(3 + math.log10(math.max(amount, 1)) * 1.5), 4, 12)
	local launched = 0
	for _, coin in ipairs(coinPool) do
		if launched >= count then
			break
		end
		if not coin.Busy then
			launched += 1
			coin.Busy = true
			local coinLabel = coin.Label
			-- erst in alle Richtungen aufspritzen, dann im Bogen zum Zähler saugen
			local angle = math.random() * math.pi * 2
			local spread = 40 + math.random() * 70
			local midX = start.X + math.cos(angle) * spread
			local midY = start.Y + math.sin(angle) * spread * 0.7 - 30
			coinLabel.Position = UDim2.fromOffset(start.X, start.Y)
			coinLabel.Size = UDim2.fromOffset(14, 14)
			coinLabel.Rotation = math.random(-40, 40)
			coinLabel.Visible = true
			local out = TweenService:Create(coinLabel, COIN_OUT_INFO, {
				Position = UDim2.fromOffset(midX, midY),
				Size = UDim2.fromOffset(34, 34),
				Rotation = coinLabel.Rotation + math.random(-120, 120),
			})
			local delay = launched * 0.04
			out.Completed:Once(function()
				local flyInfo = TweenInfo.new(
					0.4 + math.random() * 0.15,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In,
					0,
					false,
					delay
				)
				local fly = TweenService:Create(coinLabel, flyInfo, {
					Position = goal,
					Size = UDim2.fromOffset(20, 20),
					Rotation = 0,
				})
				fly.Completed:Once(function()
					coinLabel.Visible = false
					coin.Busy = false
					if not hidden then
						hud.PulseCash(0.06) -- jede Münze lässt den Zähler kurz zucken
					end
				end)
				fly:Play()
			end)
			out:Play()
		end
	end
end

-- ---------------------------------------------------------------------
-- FUNKEN-EXPLOSION (Schlüpfen, Landung eines Lieferflugs)
-- ---------------------------------------------------------------------
local BURST_RANGE = 450 -- weiter weg sieht man es eh nicht -> nichts tun
local FLASH_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SHELL_INFO = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
-- Viele Explosionen auf einmal (z.B. mehrere Eier schlüpfen gleichzeitig): höchstens MAX_FLASHES
-- Lichtblitze pro FLASH_WINDOW Sekunden, darüber nur noch halb so viele Funken
local FLASH_WINDOW = 0.25
local MAX_FLASHES = 3
local flashWindowStart = 0
local flashCount = 0

local function localPart(props: { [string]: any }): Part
	local base: { [string]: any } = {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	}
	for key, value in pairs(props) do
		base[key] = value
	end
	return UI.Create("Part", base)
end

local function makeEmitter(color: Color3, parent: Instance, big: boolean): ParticleEmitter
	return UI.Create("ParticleEmitter", {
		Color = ColorSequence.new(color, WHITE),
		LightEmission = 1,
		LightInfluence = 0,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, big and 1.4 or 0.8),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.7, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.5, big and 1.2 or 0.7),
		Speed = NumberRange.new(big and 16 or 8, big and 34 or 16),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -28, 0),
		Drag = 2,
		RotSpeed = NumberRange.new(-220, 220),
		Rate = 0,
		Parent = parent,
	})
end

local function burst(position: Vector3, color: Color3, amount: number, flash: boolean)
	local folder = fxFolder
	local camera = workspace.CurrentCamera
	if not folder or (camera and (camera.CFrame.Position - position).Magnitude > BURST_RANGE) then
		return
	end
	if flash then
		local t = os.clock()
		if t - flashWindowStart > FLASH_WINDOW then
			flashWindowStart = t
			flashCount = 0
		end
		flashCount += 1
		if flashCount > MAX_FLASHES then
			flash = false
			amount *= 0.5
		end
	end
	local holder = localPart({
		Name = "Burst",
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
		CFrame = CFrame.new(position),
		Parent = folder,
	})
	local emitter = makeEmitter(color, holder, flash)
	emitter:Emit(math.clamp(math.floor(amount), 1, 120))
	if flash then
		local light: PointLight = UI.Create("PointLight", {
			Color = color,
			Range = 26,
			Brightness = 8,
			Shadows = false,
			Parent = holder,
		})
		TweenService:Create(light, FLASH_INFO, { Brightness = 0, Range = 6 }):Play()
		-- Leuchtende Kugel, die sich ausdehnt und verblasst (Lichtblitz)
		local shell = localPart({
			Name = "Flash",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1),
			Material = Enum.Material.Neon,
			Color = color,
			Transparency = 0.2,
			CFrame = CFrame.new(position),
			Parent = folder,
		})
		TweenService:Create(shell, SHELL_INFO, { Size = Vector3.new(13, 13, 13), Transparency = 1 }):Play()
		Debris:AddItem(shell, 0.5)
	end
	Debris:AddItem(holder, 2)
end

-- Druckwelle: flacher leuchtender Ring am Boden, wächst und verblasst
local function ring(position: Vector3, color: Color3, size: number, time: number)
	local folder = fxFolder
	local camera = workspace.CurrentCamera
	if not folder or (camera and (camera.CFrame.Position - position).Magnitude > BURST_RANGE) then
		return
	end
	local cf = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2) -- Zylinder-Achse senkrecht
	local wave = localPart({
		Name = "Shockwave",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.15, 1, 1),
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.25,
		CFrame = cf,
		Parent = folder,
	})
	local info = TweenInfo.new(time, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	TweenService:Create(wave, info, { Size = Vector3.new(0.05, size, size), Transparency = 1 }):Play()
	Debris:AddItem(wave, time + 0.05)
end

-- Staub-Puff (weiche graue Wolke) beim Aufprall
local function puff(position: Vector3, color: Color3, amount: number)
	local folder = fxFolder
	local camera = workspace.CurrentCamera
	if not folder or (camera and (camera.CFrame.Position - position).Magnitude > BURST_RANGE) then
		return
	end
	local holder = localPart({
		Name = "Puff",
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
		CFrame = CFrame.new(position),
		Parent = folder,
	})
	local smoke: ParticleEmitter = UI.Create("ParticleEmitter", {
		Color = ColorSequence.new(color:Lerp(WHITE, 0.6), Color3.fromRGB(150, 145, 140)),
		LightEmission = 0.2,
		LightInfluence = 0.6,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8),
			NumberSequenceKeypoint.new(0.4, 2.2),
			NumberSequenceKeypoint.new(1, 3),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.5, 0.9),
		Speed = NumberRange.new(6, 12),
		SpreadAngle = Vector2.new(80, 10),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, 3, 0),
		Drag = 5,
		RotSpeed = NumberRange.new(-60, 60),
		Rotation = NumberRange.new(0, 360),
		Rate = 0,
		Parent = holder,
	})
	smoke:Emit(math.clamp(math.floor(amount), 1, 30))
	Debris:AddItem(holder, 1.2)
end

-- Schalen-Splitter: kleine Stücke fliegen mit Schwerkraft und Drehung weg (fester Vorrat,
-- eine Schleife, eine BulkMoveTo-Liste – keine neuen Teile pro Schlüpfen)
type Shard = {
	Part: BasePart,
	Active: boolean,
	Pos: Vector3,
	Vel: Vector3,
	Spin: Vector3,
	Age: number,
	Life: number,
}

local SHARD_COUNT = 40
local SHARD_GRAVITY = Vector3.new(0, -60, 0)
local shards: { Shard } = {}
local shardNext = 1
local shardsAlive = 0
local shardParts: { BasePart } = {}
local shardCFrames: { CFrame } = {}
local HIDDEN_CF = CFrame.new(0, -5000, 0)

local function buildShards()
	local folder = fxFolder
	if not folder then
		return
	end
	for _ = 1, SHARD_COUNT do
		local part: BasePart = localPart({
			Name = "Shard",
			Size = Vector3.new(0.5, 0.15, 0.4),
			Material = Enum.Material.Slate,
			CFrame = HIDDEN_CF,
			Parent = folder,
		})
		table.insert(shards, {
			Part = part,
			Active = false,
			Pos = Vector3.zero,
			Vel = Vector3.zero,
			Spin = Vector3.zero,
			Age = 0,
			Life = 1,
		})
	end
end

local function spawnShards(position: Vector3, color: Color3, amount: number, scale: number)
	if #shards == 0 then
		return
	end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - position).Magnitude > BURST_RANGE * 0.5 then
		return -- weit weg sieht man die kleinen Splitter nicht
	end
	for _ = 1, amount do
		local shard = shards[shardNext]
		shardNext = shardNext % SHARD_COUNT + 1
		if not shard.Active then
			shardsAlive += 1
		end
		shard.Active = true
		shard.Age = 0
		shard.Life = 0.8 + math.random() * 0.6
		local angle = math.random() * math.pi * 2
		local out = 8 + math.random() * 14
		shard.Pos = position + Vector3.new(0, 0.5 * scale, 0)
		shard.Vel = Vector3.new(math.cos(angle) * out, 14 + math.random() * 16, math.sin(angle) * out)
		shard.Spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 22
		local part = shard.Part
		local size = (0.3 + math.random() * 0.4) * scale
		part.Size = Vector3.new(size, size * 0.3, size * 0.8)
		part.Color = color:Lerp(Color3.fromRGB(120, 110, 100), math.random() * 0.5)
		part.Transparency = 0
	end
end

local function stepShards(dt: number)
	table.clear(shardParts)
	table.clear(shardCFrames)
	local count = 0
	for _, shard in ipairs(shards) do
		if shard.Active then
			shard.Age += dt
			count += 1
			shardParts[count] = shard.Part
			if shard.Age >= shard.Life then
				shard.Active = false
				shardsAlive -= 1
				shardCFrames[count] = HIDDEN_CF
			else
				shard.Vel += SHARD_GRAVITY * dt
				local pos = shard.Pos + shard.Vel * dt
				shard.Pos = pos
				local a = shard.Age
				local spin = shard.Spin
				shardCFrames[count] = CFrame.new(pos) * CFrame.fromEulerAnglesXYZ(spin.X * a, spin.Y * a, spin.Z * a)
				local fade = shard.Age / shard.Life
				if fade > 0.6 then
					shard.Part.Transparency = (fade - 0.6) / 0.4
				end
			end
		end
	end
	if count > 0 then
		workspace:BulkMoveTo(shardParts, shardCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- ---------------------------------------------------------------------
-- WACKELN (eine gemeinsame Stärke, nimmt weich ab). Bewusst dezent: weiches Rauschen statt
-- Zufallssprüngen, gedämpfte Stärke und eine Obergrenze (niemandem soll schlecht werden).
-- ---------------------------------------------------------------------
local SHAKE_TIME = 0.4
local SHAKE_SCALE = 0.55 -- Server-Stärke -> Studs Kamera-Versatz
local SHAKE_MAX = 1.2
local SHAKE_FREQ = 18 -- wie schnell das Rauschen läuft
local shakeStrength = 0
local shakeClock = 0
local shakeLeft = 0
local shakeHumanoid: Humanoid? = nil

local function shake(strength: number)
	if type(strength) ~= "number" or strength ~= strength or strength <= 0 then
		return
	end
	strength = math.min(strength * SHAKE_SCALE, SHAKE_MAX)
	local current = if shakeLeft > 0 then shakeStrength * (shakeLeft / SHAKE_TIME) else 0
	if strength >= current then
		shakeStrength = strength
		shakeLeft = SHAKE_TIME
	end
end

local function stepShake(dt: number)
	if shakeLeft <= 0 then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid ~= shakeHumanoid and shakeHumanoid and shakeHumanoid.Parent then
		shakeHumanoid.CameraOffset = Vector3.zero
	end
	shakeHumanoid = humanoid
	shakeLeft -= dt
	if not humanoid then
		return
	end
	if shakeLeft <= 0 then
		humanoid.CameraOffset = Vector3.zero
		return
	end
	local fade = shakeLeft / SHAKE_TIME
	local power = shakeStrength * fade * fade
	shakeClock += dt * SHAKE_FREQ
	humanoid.CameraOffset = Vector3.new(math.noise(shakeClock, 0.5), math.noise(0.5, shakeClock), 0) * power
end

-- ---------------------------------------------------------------------
-- LIEFERFLUG: Geister-Meteor fliegt im Bogen vom Nest in den Slot
-- ---------------------------------------------------------------------
type Flight = {
	Part: BasePart,
	From: Vector3,
	To: Vector3,
	Height: number,
	Age: number,
	Color: Color3,
	Fall: boolean, -- fast senkrecht von oben: beschleunigt fallen statt Bogen
	Size: number,
}

local DELIVER_TIME = 0.9 -- gleich lang wie die Fall-Zeit auf dem Server
local MAX_FLIGHTS = 32 -- Egg Rush: viele Eier fallen fast gleichzeitig
local flights: { Flight } = {}

local function addSparks(part: BasePart, size: number, color: Color3)
	UI.Create("ParticleEmitter", {
		Name = "Sparks",
		Color = ColorSequence.new(WHITE, color),
		LightEmission = 1,
		LightInfluence = 0,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, math.clamp(size * 0.14, 0.15, 0.6)),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new(0, 1),
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(1, 4),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -18, 0),
		Drag = 1.5,
		Rate = 70,
		Parent = part,
	})
end

local function addTrail(part: BasePart, size: number, color: Color3, tail: Color3)
	local a0: Attachment = UI.Create("Attachment", { Position = Vector3.new(0, size * 0.35, 0), Parent = part })
	local a1: Attachment = UI.Create("Attachment", { Position = Vector3.new(0, -size * 0.35, 0), Parent = part })
	UI.Create("Trail", {
		Attachment0 = a0,
		Attachment1 = a1,
		Color = ColorSequence.new(color, tail),
		Transparency = NumberSequence.new(0.15, 1),
		Lifetime = 0.35,
		LightEmission = 1,
		FaceCamera = true,
		Parent = part,
	})
end

local function deliver(data: any)
	local folder = fxFolder
	if not folder or type(data) ~= "table" or #flights >= MAX_FLIGHTS then
		return
	end
	local from, to = data.From, data.To
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then
		return
	end
	local camera = workspace.CurrentCamera
	if camera then
		local camPos = camera.CFrame.Position
		if (camPos - from).Magnitude > BURST_RANGE and (camPos - to).Magnitude > BURST_RANGE then
			return
		end
	end
	local Config = ctx.Config
	local def = Config.MeteorsById[data.MeteorId]
	local rarity = def and Config.RaritiesByName[def.Rarity]
	local mut = Config.MutationsByName[data.Mut]
	local size = math.clamp(rarity and rarity.Size or 2.5, 1, 10)
	local color: Color3 = def and def.Color or WHITE
	if mut and mut.Color then
		color = mut.Color
	end
	local tail: Color3 = rarity and rarity.Color or WHITE
	local part = localPart({
		Name = "DeliverGhost",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size, size, size),
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.3,
		CFrame = CFrame.new(from),
		Parent = folder,
	})
	addTrail(part, size, color, tail)
	addSparks(part, size, tail)
	local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z).Magnitude
	local fall = from.Y - to.Y > flat * 2
	table.insert(flights, {
		Part = part,
		From = from,
		To = to,
		Height = if fall then 0 else math.clamp((to - from).Magnitude * 0.35, 8, 45),
		Age = 0,
		Color = tail,
		Fall = fall,
		Size = size,
	})
end

local function stepFlights(dt: number)
	for i = #flights, 1, -1 do
		local flight = flights[i]
		flight.Age += dt
		local t = math.min(1, flight.Age / DELIVER_TIME)
		-- Bogen: weich anfahren und abbremsen. Fall: immer schneller (wie Schwerkraft)
		local e = if flight.Fall then t * t else t * t * (3 - 2 * t)
		local pos = flight.From:Lerp(flight.To, e) + Vector3.new(0, flight.Height * 4 * e * (1 - e), 0)
		flight.Part.CFrame = CFrame.Angles(flight.Age * 6, flight.Age * 4, 0) + pos
		if t >= 1 then
			-- Geist unsichtbar machen, Schweif + Funken noch ausklingen lassen, dann weg
			local part = flight.Part
			part.Transparency = 1
			local sparks = part:FindFirstChild("Sparks")
			if sparks and sparks:IsA("ParticleEmitter") then
				sparks.Enabled = false
			end
			Debris:AddItem(part, 0.7)
			flights[i] = flights[#flights]
			flights[#flights] = nil
			local ground = flight.To - Vector3.new(0, flight.Size * 0.45, 0)
			burst(flight.To, flight.Color, if flight.Fall then 22 else 14, false)
			puff(ground, flight.Color, 10 + flight.Size * 2)
			ring(ground, flight.Color, 6 + flight.Size * 3, 0.45)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and (root.Position - flight.To).Magnitude < 25 then
				shake(0.2) -- ganz nah: kurzes, leichtes Rumpeln
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- SCHLÜPFEN
-- ---------------------------------------------------------------------
local HATCH_BIG_FROM = 5 -- ab Legendary: größere Explosion (Lichtsäule, zweite Druckwelle)
local HATCH_HUGE_FROM = 6 -- ab Mythic: noch eine Funkenwelle
local HATCH_RAINBOW_FROM = 9 -- Secret/Admin: Regenbogen-Explosion

-- Lichtsäule beim Schlüpfen seltener Aliens: leuchtender Zylinder schießt hoch und verblasst
local function hatchPillar(position: Vector3, color: Color3, index: number)
	local folder = fxFolder
	local camera = workspace.CurrentCamera
	if not folder or (camera and (camera.CFrame.Position - position).Magnitude > BURST_RANGE) then
		return
	end
	local width = 3 + index * 0.6
	local height = 30 + index * 6
	local pillar = localPart({
		Name = "HatchPillar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, width, width),
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.15,
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2),
		Parent = folder,
	})
	local info = TweenInfo.new(0.9, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	TweenService:Create(pillar, info, {
		Size = Vector3.new(height, width * 0.3, width * 0.3),
		CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(pillar, 1)
end

local function hatch(data: any)
	if type(data) ~= "table" or typeof(data.Position) ~= "Vector3" then
		return
	end
	local Config = ctx.Config
	local rarity = Config.RaritiesByName[data.Rarity]
	local index = Config.RarityIndex[data.Rarity] or 1
	local color: Color3 = rarity and rarity.Color or WHITE
	burst(data.Position, color, 24 + index * 7, true)
	-- Schale platzt: Splitter fliegen weg, Druckwelle am Boden
	spawnShards(data.Position, color, 6 + math.min(index, 8), math.clamp(0.8 + index * 0.08, 0.8, 1.6))
	ring(data.Position - Vector3.new(0, 1, 0), color, 12 + index * 1.5, 0.55)
	-- Seltene Aliens: größere Explosion (nach Seltenheit skaliert)
	if index >= HATCH_BIG_FROM then
		local big = index - HATCH_BIG_FROM + 1 -- 1 = Legendary, 2 = Mythic, ...
		hatchPillar(data.Position, color, index)
		ring(data.Position - Vector3.new(0, 0.6, 0), WHITE, 20 + big * 6, 0.8)
		if index >= HATCH_RAINBOW_FROM then
			-- Regenbogen: Funken in mehreren Farben + bunte Druckwellen
			for i = 0, 4 do
				local hue = Color3.fromHSV(i / 5, 0.85, 1)
				burst(data.Position + Vector3.new(0, 1 + i * 0.6, 0), hue, 20, false)
				ring(data.Position - Vector3.new(0, 0.8 - i * 0.1, 0), hue, 16 + i * 6, 0.6 + i * 0.12)
			end
		elseif index >= HATCH_HUGE_FROM then
			task.delay(0.15, function()
				burst(data.Position + Vector3.new(0, 2, 0), color:Lerp(WHITE, 0.4), 20 + big * 10, false)
			end)
		end
	end
	-- Alien ploppt in WorldFX mit Overshoot herein
	WorldFX.NoteHatch(data.Position)
	-- Ganz nah dran? Kurz wackeln (seltene stärker und weiter)
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local shakeRange = if index >= HATCH_BIG_FROM then 70 else 40
	if rootPart and (rootPart.Position - data.Position).Magnitude < shakeRange then
		shake(0.25 + index * 0.04 + (if index >= HATCH_BIG_FROM then 0.3 else 0))
	end
end

-- ---------------------------------------------------------------------
-- KONFETTI + ALARM
-- ---------------------------------------------------------------------
local MAX_CONFETTI = 140
local CONFETTI_GRAVITY = 1500 -- Pixel/s² (Konfetti ist leicht: fällt danach langsamer, siehe unten)
local confettiAlive = 0

-- Ein Stück Konfetti: der Halter fliegt gleichmäßig zur Seite, das Stück darin steigt (Quad Out)
-- und fällt (Quad In) – zusammen eine echte Wurfparabel. Dazu Drehen und Flattern (Breite pendelt).
local function confettiPiece(gui: ScreenGui, x: number, y: number, vx: number, vy: number, color: Color3)
	local screen = gui.AbsoluteSize
	local tUp = vy / CONFETTI_GRAVITY
	local peak = y - vy * vy / (2 * CONFETTI_GRAVITY)
	local fallDistance = screen.Y + 30 - peak
	local tDown = math.sqrt(2 * fallDistance / CONFETTI_GRAVITY) * 1.9 -- Luftwiderstand: langsamer fallen
	local life = tUp + tDown
	local width, height = math.random(8, 14), math.random(10, 16)
	local holder: Frame = UI.Create("Frame", {
		Size = UDim2.fromOffset(0, 0),
		Position = UDim2.fromOffset(x, y),
		BackgroundTransparency = 1,
		ZIndex = 25,
		Parent = gui,
	})
	local piece: Frame = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Rotation = math.random(0, 360),
		ZIndex = 25,
		Parent = holder,
	})
	if math.random() < 0.35 then
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = piece }) -- runde Plättchen
	end
	-- seitlich: am Anfang schnell, dann vom Luftwiderstand gebremst
	TweenService:Create(
		holder,
		TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(x + vx * 0.9, y) }
	):Play()
	TweenService
		:Create(
			piece,
			TweenInfo.new(life, Enum.EasingStyle.Linear),
			{ Rotation = piece.Rotation + math.random(-720, 720) }
		)
		:Play()
	-- Flattern: Breite pendelt (sieht aus wie ein Blättchen, das sich dreht)
	TweenService:Create(
		piece,
		TweenInfo.new(0.18 + math.random() * 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Size = UDim2.fromOffset(math.max(2, width * 0.15), height) }
	):Play()
	local up = TweenService:Create(
		piece,
		TweenInfo.new(tUp, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(0, peak - y) }
	)
	up.Completed:Once(function()
		local down = TweenService:Create(
			piece,
			TweenInfo.new(tDown, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Position = UDim2.fromOffset(0, screen.Y + 30 - y) }
		)
		down.Completed:Once(function()
			confettiAlive -= 1
			holder:Destroy()
		end)
		down:Play()
	end)
	up:Play()
end

-- Konfetti-Kanonen links und rechts unten schießen schräg nach oben zur Mitte
local function confetti(amount: number)
	local gui = overlay
	if not gui or hidden then
		return
	end
	local colors = { UI.Theme.Yellow, UI.Theme.Green, UI.Theme.Blue, UI.Theme.Purple, UI.Theme.Red, UI.Theme.Pink }
	local count = math.floor(32 * math.clamp(tonumber(amount) or 1, 0.3, 3))
	count = math.min(count, MAX_CONFETTI - confettiAlive)
	local screen = gui.AbsoluteSize
	if screen.Y < 10 then
		return
	end
	for i = 1, count do
		confettiAlive += 1
		local left = i % 2 == 0
		local x = if left then screen.X * 0.04 else screen.X * 0.96
		local y = screen.Y + 10
		-- Gipfel zwischen 35 % und 85 % der Bildschirmhöhe
		local rise = screen.Y * (0.35 + math.random() * 0.5)
		local vy = math.sqrt(2 * CONFETTI_GRAVITY * rise)
		local vx = (screen.X * (0.12 + math.random() * 0.4)) * (if left then 1 else -1)
		confettiPiece(gui, x, y, vx, vy, colors[math.random(1, #colors)])
	end
end

local alarmFrame: Frame? = nil
local ALARM_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local alarmRunning = false

local function alarm()
	local frame = alarmFrame
	if not frame or alarmRunning then
		return
	end
	alarmRunning = true
	for _ = 1, 3 do
		frame.BackgroundTransparency = 0.55
		TweenService:Create(frame, ALARM_INFO, { BackgroundTransparency = 1 }):Play()
		task.wait(0.35)
	end
	alarmRunning = false
end

-- ---------------------------------------------------------------------
-- HATCH REVEAL: große Karte in der Mitte (Name in Seltenheits-Farbe, Stufe, Mutation)
-- Eine Karte wird einmal gebaut und wiederverwendet; mehrere hintereinander warten kurz.
-- Groß + Konfetti nur für Besonderes (Ultra oder ab Epic). "Selten"-Aliens aus kleinen Eiern und
-- alles, während du Beute trägst, kommt als kleine Karte oben rechts (verdeckt nicht die Mitte).
-- ---------------------------------------------------------------------
local REVEAL_POP_INFO = TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local REVEAL_OUT_INFO = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.In)
local REVEAL_SPIN_INFO = TweenInfo.new(6, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)
local REVEAL_SPIN2_INFO = TweenInfo.new(9, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)
local REVEAL_PULSE_INFO = TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local REVEAL_TILT_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
local RAY_COUNT = 12 -- Strahlen im äußeren Kranz (der innere hat halb so viele, dreht andersrum)
local REVEAL_TIME = 3.2
local MINI_REVEAL_TIME = 1.8
local MINI_REVEAL_SCALE = 0.45
local MAX_REVEAL_QUEUE = 4
-- Ersatz-Symbole (Config.Mutations -> Icon hat Vorrang; gleiche Symbole wie an Aliens und Meteoren)
local MUTATION_ICONS: { [string]: string } = {
	Gold = "🪙",
	Diamond = "💎",
	Galaxy = "🌌",
	Frost = "❄️",
	Lava = "🔥",
	Rainbow = "🌈",
}

type RevealUI = {
	Holder: Frame,
	Scale: UIScale,
	Rays: Frame,
	Rays2: Frame,
	RayScale: UIScale,
	Glow: Frame,
	RayTweens: { Tween },
	Card: Frame,
	CardGradient: UIGradient,
	Title: TextLabel,
	Face: Frame,
	FaceStroke: UIStroke,
	Eyes: { Frame },
	Name: TextLabel,
	Info: TextLabel,
	Mutation: TextLabel,
	MutationGradient: UIGradient,
	Income: TextLabel,
}

local reveal: RevealUI? = nil
local revealQueue: { any } = {}
local revealBusy = false
local revealSkip = false

local function rainbowSequence(): ColorSequence
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.85, 1)))
	end
	return ColorSequence.new(keys)
end

local function buildReveal(): RevealUI?
	local gui = UI.Root
	if not gui then
		return nil
	end
	local holder: Frame = UI.Create("Frame", {
		Name = "HatchReveal",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(440, 290),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	local scale: UIScale = UI.Create("UIScale", { Scale = 0, Parent = holder })
	-- Strahlenkranz hinter der Karte: zwei Kränze drehen gegeneinander und pulsieren,
	-- jeder Strahl läuft zu den Spitzen hin weich aus (Verlauf), dazu ein weicher Schein in der Mitte
	local rayScale: UIScale = UI.Create("UIScale", { Scale = 1 })
	local glow: Frame = UI.Create("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(470, 470),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.55,
		ZIndex = 30,
		Parent = holder,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.Create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	local rays: Frame = UI.Create("Frame", {
		Name = "Rays",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(620, 620),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = holder,
	}, { rayScale })
	local rays2: Frame = UI.Create("Frame", {
		Name = "Rays2",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(500, 500),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = holder,
	})
	local rayFade = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.55),
		NumberSequenceKeypoint.new(0.5, 0.35),
		NumberSequenceKeypoint.new(0.7, 0.55),
		NumberSequenceKeypoint.new(1, 1),
	})
	local function addRay(parent: Frame, rotation: number, width: number, transparency: number)
		UI.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, width, 1, 0),
			Rotation = rotation,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = transparency,
			BorderSizePixel = 0,
			ZIndex = 30,
			Parent = parent,
		}, { UI.Create("UIGradient", { Rotation = 90, Transparency = rayFade }) })
	end
	-- Ein Strahl geht durch die Mitte (= 2 Strahlen) -> RAY_COUNT / 2 Frames je Kranz
	for i = 0, RAY_COUNT / 2 - 1 do
		addRay(rays, i * (360 / RAY_COUNT), if i % 2 == 0 then 54 else 30, 0.45)
	end
	for i = 0, RAY_COUNT / 4 - 1 do
		addRay(rays2, i * (720 / RAY_COUNT) + 15, 22, 0.55)
	end
	local cardGradient: UIGradient = UI.Create("UIGradient", { Rotation = 90 })
	local card: Frame = UI.Create("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		ZIndex = 31,
		Parent = holder,
	}, { UI.Corner(22), UI.Stroke(BLACK, 4), cardGradient })
	local closeButton: TextButton = UI.Create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 40,
		Parent = card,
	})
	closeButton.Activated:Connect(function()
		revealSkip = true
	end)
	local title = UI.Label({
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.new(1, -28, 0, 40),
		Text = "🐣 GESCHLÜPFT!",
		TextColor3 = UI.Theme.Yellow,
		MaxText = 34,
		Outline = 3,
		ZIndex = 32,
		Parent = card,
	})
	-- Gesicht des Aliens (Kreis in seiner Farbe + Augen)
	local faceStroke = UI.Stroke(BLACK, 4)
	local face: Frame = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 56),
		Size = UDim2.fromOffset(92, 92),
		BackgroundColor3 = WHITE,
		ZIndex = 32,
		Parent = card,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }), faceStroke })
	local eyes: { Frame } = {}
	for _ = 1, 4 do
		local eye: Frame = UI.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(22, 22),
			BackgroundColor3 = WHITE,
			Visible = false,
			ZIndex = 33,
			Parent = face,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.Stroke(BLACK, 2) })
		UI.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.58, 0.58),
			Size = UDim2.fromScale(0.45, 0.45),
			BackgroundColor3 = BLACK,
			ZIndex = 34,
			Parent = eye,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
		table.insert(eyes, eye)
	end
	local nameLabel = UI.Label({
		Position = UDim2.fromOffset(14, 152),
		Size = UDim2.new(1, -28, 0, 44),
		Text = "",
		MaxText = 38,
		Outline = 3,
		ZIndex = 32,
		Parent = card,
	})
	local info = UI.Label({
		Position = UDim2.fromOffset(14, 196),
		Size = UDim2.new(1, -28, 0, 26),
		Text = "",
		MaxText = 22,
		Outline = 2,
		ZIndex = 32,
		Parent = card,
	})
	local mutationGradient: UIGradient = UI.Create("UIGradient", { Color = rainbowSequence(), Enabled = false })
	local mutation = UI.Label({
		Position = UDim2.fromOffset(14, 222),
		Size = UDim2.new(0.5, -18, 0, 26),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxText = 20,
		Outline = 2,
		ZIndex = 32,
		Parent = card,
	})
	mutationGradient.Parent = mutation
	local income = UI.Label({
		Position = UDim2.new(0.5, 4, 0, 222),
		Size = UDim2.new(0.5, -18, 0, 26),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = UI.Theme.Cash,
		MaxText = 20,
		Outline = 2,
		ZIndex = 32,
		Parent = card,
	})
	UI.Label({
		Position = UDim2.new(0, 14, 1, -30),
		Size = UDim2.new(1, -28, 0, 20),
		Text = "Klick zum Schließen",
		Font = Enum.Font.GothamBold,
		TextColor3 = UI.Theme.SubText,
		MaxText = 13,
		ZIndex = 32,
		Parent = card,
	})
	return {
		Holder = holder,
		Scale = scale,
		Rays = rays,
		Rays2 = rays2,
		RayScale = rayScale,
		Glow = glow,
		RayTweens = {},
		Card = card,
		CardGradient = cardGradient,
		Title = title,
		Face = face,
		FaceStroke = faceStroke,
		Eyes = eyes,
		Name = nameLabel,
		Info = info,
		Mutation = mutation,
		MutationGradient = mutationGradient,
		Income = income,
	}
end

-- Augen gleichmäßig nebeneinander (1-4)
local function placeEyes(ui: RevealUI, count: number)
	count = math.clamp(math.floor(count), 1, 4)
	for i, eye in ipairs(ui.Eyes) do
		eye.Visible = i <= count
		if i <= count then
			local x = if count == 1 then 0.5 else 0.22 + (i - 1) * (0.56 / (count - 1))
			eye.Position = UDim2.fromScale(x, 0.42)
			local size = if count == 1 then 34 elseif count == 2 then 24 else 18
			eye.Size = UDim2.fromOffset(size, size)
		end
	end
end

local function fillReveal(ui: RevealUI, data: any): boolean
	local Config = ctx.Config
	local def = ctx.Aliens.ById[data.AlienId]
	if not def then
		return false
	end
	local rarity = Config.RaritiesByName[def.Rarity]
	local rarityColor: Color3 = if rarity then rarity.Color else WHITE
	local tierColors = ctx.Aliens.TierColors or {}
	local tierColor: Color3 = tierColors[def.Tier] or WHITE
	local look = def.Look or {}
	local mut = Config.MutationsByName[data.Mut]
	local ultra = def.Tier == "Ultra"
	ui.Title.Text = if ultra
		then "🌟 ULTRA GESCHLÜPFT! 🌟"
		elseif def.Tier == "Selten" then "✨ SELTEN GESCHLÜPFT!"
		else "🐣 GESCHLÜPFT!"
	ui.CardGradient.Color = ColorSequence.new(rarityColor:Lerp(BLACK, 0.35), UI.Theme.PanelDark)
	ui.Face.BackgroundColor3 = if typeof(look.Color) == "Color3" then look.Color else rarityColor
	ui.FaceStroke.Color = if typeof(look.Accent) == "Color3" then look.Accent else BLACK
	placeEyes(ui, tonumber(look.Eyes) or 2)
	ui.Name.Text = tostring(def.Name)
	ui.Name.TextColor3 = rarityColor
	ui.Info.Text = tostring(def.Tier) .. "  •  " .. tostring(def.Rarity)
	ui.Info.TextColor3 = tierColor
	local mutName = if mut and mut.Name ~= "Normal" then mut.Name else nil
	if mutName and mut then
		local icon = if type(mut.Icon) == "string" and mut.Icon ~= "" then mut.Icon else MUTATION_ICONS[mutName]
		ui.Mutation.Text = (icon or "✨") .. " " .. mutName .. " x" .. UI.FormatMult(mut.Mult)
		ui.Mutation.TextColor3 = if mut.Rainbow == true then WHITE else (mut.Color or WHITE)
		ui.MutationGradient.Enabled = mut.Rainbow == true
	else
		ui.Mutation.Text = "Normal"
		ui.Mutation.TextColor3 = UI.Theme.SubText
		ui.MutationGradient.Enabled = false
	end
	-- Einkommen auf Level 1 (gleiche Rechnung wie Config.MeteorIncome)
	local meteor = Config.MeteorsById[def.Meteor]
	local perSecond = (if meteor then tonumber(meteor.Income) or 0 else 0)
		* (tonumber(def.IncomeMult) or 1)
		* (if mut then tonumber(mut.Mult) or 1 else 1)
	ui.Income.Text = "💵 +" .. ctx.Util.FormatCash(perSecond) .. "/s"
	local rayColor = if ultra then UI.Theme.Yellow else rarityColor:Lerp(WHITE, 0.4)
	for _, layer in ipairs({ ui.Rays, ui.Rays2 }) do
		for _, ray in ipairs(layer:GetChildren()) do
			if ray:IsA("Frame") then
				ray.BackgroundColor3 = rayColor
			end
		end
	end
	ui.Glow.BackgroundColor3 = rayColor
	return true
end

-- Große Karte (Mitte, Konfetti) oder kleine (oben rechts)?
local function revealIsBig(data: any): boolean
	local state = ctx.State
	if state and state.Carrying == true then
		return false -- beim Wegrennen mit Beute nicht die Bildschirmmitte zudecken
	end
	local def = ctx.Aliens.ById[data.AlienId]
	if not def then
		return false
	end
	if def.Tier == "Ultra" then
		return true
	end
	local Config = ctx.Config
	return (Config.RarityIndex[def.Rarity] or 0) >= (Config.RarityIndex.Epic or 4)
end

local function showNextReveal()
	if revealBusy then
		return
	end
	revealBusy = true
	while #revealQueue > 0 do
		local data = table.remove(revealQueue, 1)
		local ui = reveal or buildReveal()
		reveal = ui
		if ui and not hidden and fillReveal(ui, data) then
			local big = revealIsBig(data)
			revealSkip = false
			ui.Holder.AnchorPoint = if big then Vector2.new(0.5, 0.5) else Vector2.new(1, 0)
			ui.Holder.Position = if big then UDim2.fromScale(0.5, 0.45) else UDim2.new(1, -14, 0, 56)
			ui.Rays.Visible = big
			ui.Rays2.Visible = big
			ui.Glow.Visible = big
			ui.Holder.Visible = true
			ui.Scale.Scale = 0.2
			ui.Rays.Rotation = 0
			ui.Rays2.Rotation = 0
			ui.RayScale.Scale = 1
			ui.Holder.Rotation = if big then -8 else 0
			if big then
				-- Strahlen nur bei der großen Karte (die kleine oben rechts bleibt ruhig)
				local tweens = {
					TweenService:Create(ui.Rays, REVEAL_SPIN_INFO, { Rotation = 360 }),
					TweenService:Create(ui.Rays2, REVEAL_SPIN2_INFO, { Rotation = -360 }),
					TweenService:Create(ui.RayScale, REVEAL_PULSE_INFO, { Scale = 1.12 }),
				}
				for _, tween in ipairs(tweens) do
					tween:Play()
				end
				ui.RayTweens = tweens
				TweenService:Create(ui.Holder, REVEAL_TILT_INFO, { Rotation = 0 }):Play()
			end
			TweenService:Create(ui.Scale, REVEAL_POP_INFO, { Scale = if big then 1 else MINI_REVEAL_SCALE }):Play()
			if big then
				confetti(1.6)
				shake(0.35)
			end
			local showTime = if big then REVEAL_TIME else MINI_REVEAL_TIME
			local shown = 0
			while shown < showTime and not revealSkip and not hidden do
				shown += task.wait(0.1)
			end
			local out = TweenService:Create(ui.Scale, REVEAL_OUT_INFO, { Scale = 0 })
			out:Play()
			out.Completed:Wait()
			for _, tween in ipairs(ui.RayTweens) do
				tween:Cancel()
			end
			ui.RayTweens = {}
			ui.Holder.Visible = false
		end
	end
	revealBusy = false
end

local function hatchReveal(data: any)
	if type(data) ~= "table" or type(data.AlienId) ~= "string" then
		return
	end
	if #revealQueue >= MAX_REVEAL_QUEUE then
		table.remove(revealQueue, 1) -- die älteste wartende Karte fällt weg
	end
	table.insert(revealQueue, data)
	task.spawn(showNextReveal)
end

-- ---------------------------------------------------------------------
-- 🧊 EINGEFROREN (Falle / Admin-Freeze): HumanoidRootPart ist verankert
-- ---------------------------------------------------------------------
local FROZEN_FADE_INFO = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local frozenFrame: Frame? = nil
local frozenLabel: TextLabel? = nil
local frozenConnection: RBXScriptConnection? = nil
local frozenShown = false

local function setFrozen(on: boolean)
	local frame = frozenFrame
	local label = frozenLabel
	if not frame or not label or on == frozenShown then
		return
	end
	frozenShown = on
	if on then
		frame.Visible = true
		frame.BackgroundTransparency = 1
		label.TextTransparency = 1
		TweenService:Create(frame, FROZEN_FADE_INFO, { BackgroundTransparency = 0.72 }):Play()
		TweenService:Create(label, FROZEN_FADE_INFO, { TextTransparency = 0 }):Play()
	else
		local fade = TweenService:Create(frame, FROZEN_FADE_INFO, { BackgroundTransparency = 1 })
		TweenService:Create(label, FROZEN_FADE_INFO, { TextTransparency = 1 }):Play()
		fade.Completed:Connect(function()
			if not frozenShown then
				frame.Visible = false
			end
		end)
		fade:Play()
	end
end

local function watchFrozen(character: Model)
	if frozenConnection then
		frozenConnection:Disconnect()
		frozenConnection = nil
	end
	setFrozen(false)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root or not root:IsA("BasePart") or player.Character ~= character then
		return
	end
	frozenConnection = root:GetPropertyChangedSignal("Anchored"):Connect(function()
		setFrozen(root.Anchored)
	end)
	setFrozen(root.Anchored)
end

local function buildFrozen()
	local gui = UI.Root
	if not gui then
		return
	end
	local frame: Frame = UI.Create("Frame", {
		Name = "Frozen",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(150, 220, 255),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 1,
		Parent = gui,
	})
	-- Eis-Rand: innen durchsichtig, außen hellblau
	UI.Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.25, 0.85),
			NumberSequenceKeypoint.new(0.75, 0.85),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = frame,
	})
	frozenLabel = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(520, 60),
		Text = "🧊 EINGEFROREN! 🧊",
		TextColor3 = Color3.fromRGB(200, 240, 255),
		TextTransparency = 1,
		MaxText = 46,
		Outline = 3,
		ZIndex = 2,
		Parent = frame,
	})
	frozenFrame = frame
end

-- ---------------------------------------------------------------------
-- 🔥 REBIRTH: Bildschirm blitzt hell auf, großer Schriftzug ploppt, Konfetti
-- ---------------------------------------------------------------------
local REBIRTH_FLASH_INFO = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local REBIRTH_POP_INFO = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local REBIRTH_OUT_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 1.1)
local rebirthBusy = false

function Effects.RebirthFlash()
	local gui = overlay
	if not gui or hidden or rebirthBusy then
		return
	end
	rebirthBusy = true
	local flash: Frame = UI.Create("Frame", {
		Name = "RebirthFlash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0,
		ZIndex = 40,
		Parent = gui,
	}, {
		-- Mitte weiß, Ränder feurig orange
		UI.Create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, UI.Theme.Orange),
				ColorSequenceKeypoint.new(0.5, WHITE),
				ColorSequenceKeypoint.new(1, UI.Theme.Orange),
			}),
		}),
	})
	local textScale: UIScale = UI.Create("UIScale", { Scale = 0.3 })
	local text = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(620, 110),
		Text = "🔥 REBIRTH! 🔥",
		TextColor3 = UI.Theme.Yellow,
		MaxText = 90,
		Outline = 5,
		ZIndex = 41,
		Parent = gui,
	})
	textScale.Parent = text
	text.Rotation = -6
	TweenService:Create(flash, REBIRTH_FLASH_INFO, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(textScale, REBIRTH_POP_INFO, { Scale = 1 }):Play()
	TweenService:Create(text, REVEAL_TILT_INFO, { Rotation = 0 }):Play()
	local stroke = text:FindFirstChildOfClass("UIStroke")
	if stroke then
		TweenService:Create(stroke, REBIRTH_OUT_INFO, { Transparency = 1 }):Play()
	end
	local out = TweenService:Create(text, REBIRTH_OUT_INFO, { TextTransparency = 1 })
	out.Completed:Once(function()
		flash:Destroy()
		text:Destroy()
		rebirthBusy = false
	end)
	out:Play()
	confetti(2.5)
	shake(0.6)
end

-- ---------------------------------------------------------------------
-- GROSSES NEST / RENNEN: Konfetti am Nest (+ Trommel beim Rennen), lokal, nur in der Nähe
-- ---------------------------------------------------------------------
local DRUM_SOUND = "rbxasset://sounds/action_jump_land.mp3" -- tiefer abgespielt = dumpfe Trommel
local NEST_FX_RANGE = 260
local NEST_COLORS = {
	Color3.fromRGB(255, 205, 40),
	Color3.fromRGB(255, 80, 120),
	Color3.fromRGB(80, 200, 255),
	Color3.fromRGB(120, 255, 120),
}
local drumSound: Sound? = nil

local function nestBurst(data: any, drums: boolean)
	if type(data) ~= "table" or typeof(data.Position) ~= "Vector3" then
		return
	end
	local position: Vector3 = data.Position
	local camera = workspace.CurrentCamera
	if not camera or (camera.CFrame.Position - position).Magnitude > NEST_FX_RANGE then
		return
	end
	for i, color in ipairs(NEST_COLORS) do
		local offset = Vector3.new((i - 2.5) * 4, 2 + (i % 2) * 2, 0)
		burst(position + offset, color, 18, i == 1)
	end
	ring(position - Vector3.new(0, 1.5, 0), NEST_COLORS[1], 30, 0.7)
	local sound = drumSound
	if drums and sound and not hidden then
		task.spawn(function()
			for beat = 1, 3 do
				sound.PlaybackSpeed = if beat == 3 then 0.45 else 0.6
				sound.TimePosition = 0
				sound:Play()
				task.wait(0.28)
			end
		end)
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") and (root.Position - position).Magnitude < 60 then
		shake(0.3)
	end
end

-- Neues Ei im Nest: kleines Aufleuchten in Seltenheitsfarbe
local function nestPop(data: any)
	if type(data) ~= "table" or typeof(data.Position) ~= "Vector3" or hidden then
		return
	end
	local rarities = ctx.Config.RaritiesByName
	local rarity = type(data.Rarity) == "string" and rarities[data.Rarity] or nil
	local color: Color3 = if rarity then rarity.Color else Color3.new(1, 1, 1)
	burst(data.Position, color, 6, false)
end

-- ---------------------------------------------------------------------
-- ADMIN-ANSAGE (oben in der Mitte, ohne Box): Kopfbild, Name + blauer Haken, ":" und Text
-- Eine Anzeige wird einmal gebaut und wiederverwendet, mehrere Ansagen warten in einer Schlange.
-- ---------------------------------------------------------------------
local ANNOUNCE_BLUE = Color3.fromRGB(40, 140, 255)
local ANNOUNCE_TIME = 8
local ANNOUNCE_MAX_QUEUE = 5
local ANNOUNCE_AVATAR = 64
local ANNOUNCE_NAME_SIZE = 34
local ANNOUNCE_BADGE = 30
local ANNOUNCE_IN = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local ANNOUNCE_OUT = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

type AnnounceUI = {
	Group: CanvasGroup,
	Scale: UIScale,
	Avatar: ImageLabel,
	Name: TextLabel,
	Badge: Frame,
	Colon: TextLabel,
	Text: TextLabel,
}
local announceUI: AnnounceUI? = nil
local announceQueue: { any } = {}
local announceBusy = false
local thumbCache: { [number]: string } = {}

local function textStroke(parent: Instance, thickness: number)
	UI.Create("UIStroke", {
		Thickness = thickness,
		Color = BLACK,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

local function buildAnnounce(): AnnounceUI?
	local gui = overlay
	if not gui then
		return nil
	end
	local group: CanvasGroup = UI.Create("CanvasGroup", {
		Name = "AdminAnnounce",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -140),
		Size = UDim2.new(0.86, 0, 0, 96),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	local scale: UIScale = UI.Create("UIScale", { Scale = 1, Parent = group })
	local avatar: ImageLabel = UI.Create("ImageLabel", {
		Name = "Avatar",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 4, 0.5, 0),
		Size = UDim2.fromOffset(ANNOUNCE_AVATAR, ANNOUNCE_AVATAR),
		BackgroundColor3 = Color3.fromRGB(200, 205, 215),
		Image = "",
		ZIndex = 31,
		Parent = group,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	UI.Create("UIStroke", { Thickness = 2, Color = WHITE, Parent = avatar })
	local nameLabel: TextLabel = UI.Create("TextLabel", {
		Name = "Name",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, ANNOUNCE_AVATAR + 14, 0.5, 0),
		Size = UDim2.fromOffset(100, 44),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextSize = ANNOUNCE_NAME_SIZE,
		TextColor3 = ANNOUNCE_BLUE,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
		Parent = group,
	})
	textStroke(nameLabel, 3)
	-- Haken-Badge (selbst gezeichnet): zwei gedrehte blaue Quadrate = Zackenkreis, weißer Haken
	local badge: Frame = UI.Create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(ANNOUNCE_BADGE, ANNOUNCE_BADGE),
		BackgroundTransparency = 1,
		ZIndex = 31,
		Parent = group,
	})
	for _, rotation in ipairs({ 0, 45 }) do
		UI.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.78, 0.78),
			Rotation = rotation,
			BackgroundColor3 = ANNOUNCE_BLUE,
			BorderSizePixel = 0,
			ZIndex = 31,
			Parent = badge,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.2, 0) }) })
	end
	UI.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = "✓",
		TextScaled = true,
		TextColor3 = WHITE,
		ZIndex = 32,
		Parent = badge,
	})
	local colon: TextLabel = UI.Create("TextLabel", {
		Name = "Colon",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(14, 44),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextSize = ANNOUNCE_NAME_SIZE,
		Text = ":",
		TextColor3 = WHITE,
		ZIndex = 31,
		Parent = group,
	})
	textStroke(colon, 3)
	local text: TextLabel = UI.Create("TextLabel", {
		Name = "Text",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextWrapped = true,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
		Parent = group,
	})
	UI.Create("UITextSizeConstraint", { MaxTextSize = 44, MinTextSize = 14, Parent = text })
	textStroke(text, 3)
	return {
		Group = group,
		Scale = scale,
		Avatar = avatar,
		Name = nameLabel,
		Badge = badge,
		Colon = colon,
		Text = text,
	}
end

local function headshot(userId: number): string
	local cached = thumbCache[userId]
	if cached then
		return cached
	end
	if userId <= 0 then
		return ""
	end
	local ok, image = pcall(function()
		return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
	end)
	if ok and type(image) == "string" then
		thumbCache[userId] = image
		return image
	end
	return ""
end

-- Name, Haken, ":" nebeneinander, der Text nimmt den Rest der Breite (bricht um, wenn er lang ist)
local function layoutAnnounce(ui: AnnounceUI, name: string)
	local nameWidth = TextService:GetTextSize(name, ANNOUNCE_NAME_SIZE, Enum.Font.FredokaOne, Vector2.new(1000, 100)).X
		+ 4
	local x = ANNOUNCE_AVATAR + 14
	ui.Name.Size = UDim2.fromOffset(nameWidth, 44)
	x += nameWidth + 6
	ui.Badge.Position = UDim2.new(0, x, 0.5, 0)
	x += ANNOUNCE_BADGE + 2
	ui.Colon.Position = UDim2.new(0, x, 0.5, 0)
	x += 18
	ui.Text.Position = UDim2.new(0, x, 0.5, 0)
	ui.Text.Size = UDim2.new(1, -x - 4, 1, -4)
end

local function showNextAnnounce()
	local ui = announceUI
	if not ui then
		return
	end
	announceBusy = true
	while #announceQueue > 0 do
		local data = table.remove(announceQueue, 1)
		local name = string.sub(tostring(data.Name or "Admin"), 1, 40)
		ui.Name.Text = name
		ui.Text.Text = tostring(data.Text)
		ui.Avatar.Image = headshot(tonumber(data.UserId) or 0)
		layoutAnnounce(ui, name)
		ui.Group.Visible = true
		ui.Group.GroupTransparency = 1
		ui.Group.Position = UDim2.new(0.5, 0, 0, -140)
		ui.Scale.Scale = 0.85
		TweenService:Create(ui.Group, ANNOUNCE_IN, { Position = UDim2.new(0.5, 0, 0, 14), GroupTransparency = 0 })
			:Play()
		TweenService:Create(ui.Scale, ANNOUNCE_IN, { Scale = 1 }):Play()
		task.wait(ANNOUNCE_TIME)
		local out = TweenService:Create(ui.Group, ANNOUNCE_OUT, { GroupTransparency = 1 })
		out:Play()
		out.Completed:Wait()
		ui.Group.Visible = false
		task.wait(0.2)
	end
	announceBusy = false
end

local function announce(data: any)
	if type(data) ~= "table" or type(data.Text) ~= "string" or data.Text == "" then
		return
	end
	if not announceUI then
		announceUI = buildAnnounce()
	end
	if #announceQueue >= ANNOUNCE_MAX_QUEUE then
		table.remove(announceQueue, 1) -- die älteste wartende Ansage fällt weg
	end
	table.insert(announceQueue, data)
	if not announceBusy then
		task.spawn(showNextAnnounce)
	end
end

-- ---------------------------------------------------------------------
-- ADMIN-WARNUNG: großer roter Hinweis in der Bildschirmmitte (ca. 7 s)
-- ---------------------------------------------------------------------
local WARN_TIME = 7
local WARN_IN = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local WARN_OUT = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local warnToken = 0
local warnFrame: Frame? = nil
local warnText: TextLabel? = nil
local warnScale: UIScale? = nil

local function buildWarn()
	local gui = overlay
	if not gui or warnFrame then
		return
	end
	local frame: Frame = UI.Create("Frame", {
		Name = "AdminWarn",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.new(0.6, 0, 0, 170),
		BackgroundColor3 = Color3.fromRGB(200, 30, 40),
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0, 14) }),
		UI.Create("UIStroke", { Thickness = 4, Color = BLACK }),
		UI.Create("UISizeConstraint", { MinSize = Vector2.new(300, 0), MaxSize = Vector2.new(760, 400) }),
	})
	local scale: UIScale = UI.Create("UIScale", { Scale = 1, Parent = frame })
	UI.Label({
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 46),
		Text = "WARNUNG VOM ADMIN",
		MaxText = 40,
		Outline = 3,
		ZIndex = 41,
		Parent = frame,
	})
	local text = UI.Label({
		Position = UDim2.fromOffset(16, 62),
		Size = UDim2.new(1, -32, 1, -74),
		Text = "",
		TextWrapped = true,
		MaxText = 30,
		Outline = 2,
		ZIndex = 41,
		Parent = frame,
	})
	warnFrame, warnText, warnScale = frame, text, scale
end

local function adminWarn(data: any)
	if type(data) ~= "table" or type(data.Text) ~= "string" or data.Text == "" then
		return
	end
	buildWarn()
	local frame, text, scale = warnFrame, warnText, warnScale
	if not frame or not text or not scale then
		return
	end
	warnToken += 1
	local token = warnToken
	text.Text = data.Text
	frame.Visible = true
	scale.Scale = 0.6
	TweenService:Create(scale, WARN_IN, { Scale = 1 }):Play()
	shake(0.5)
	task.delay(WARN_TIME, function()
		if warnToken ~= token then
			return
		end
		local out = TweenService:Create(scale, WARN_OUT, { Scale = 0 })
		out.Completed:Once(function()
			if warnToken == token then
				frame.Visible = false
			end
		end)
		out:Play()
	end)
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH
-- ---------------------------------------------------------------------
function Effects.Play(name: any, strength: any, data: any)
	if type(name) ~= "string" then
		return
	end
	local amount = tonumber(strength) or 0
	if name == "Steps" then
		if amount > 0 then
			showSteps(amount)
			if ctx.Hooks.OnSteps then
				ctx.Hooks.OnSteps(amount)
			end
		end
	elseif name == "Collect" then
		if amount > 0 then
			cashPopup(amount)
			flyCoins(amount)
			if ctx.Hooks.OnCash then
				ctx.Hooks.OnCash(amount)
			end
		end
	elseif name == "Deliver" then
		deliver(data)
	elseif name == "Hatch" then
		hatch(data)
	elseif name == "HatchReveal" then
		hatchReveal(data)
	elseif name == "Shake" then
		shake(amount)
	elseif name == "Confetti" then
		confetti(amount)
	elseif name == "Alarm" then
		task.spawn(alarm)
	elseif name == "BigNest" then
		nestBurst(data, false)
	elseif name == "RaceStart" then
		nestBurst(data, true)
	elseif name == "NestPop" then
		nestPop(data)
	elseif name == "Announce" then
		announce(data)
	elseif name == "Warn" then
		adminWarn(data)
	elseif name == "Bonked" then
		if ctx.Bat then
			ctx.Bat.Bonked(data)
		end
	end
end

-- Bausteine für andere Module (NestField, Base, Trade, WorldFX): gleiche Optik, gleiche Grenzen
-- (Reichweite, höchstens MAX_FLASHES Lichtblitze auf einmal), alles räumt sich selbst auf.
function Effects.Burst(position: Vector3, color: Color3, amount: number, flash: boolean?)
	burst(position, color, amount, flash == true)
end

function Effects.Ring(position: Vector3, color: Color3, size: number, time: number?)
	ring(position, color, size, time or 0.6)
end

function Effects.Puff(position: Vector3, color: Color3, amount: number)
	puff(position, color, amount)
end

function Effects.Shake(strength: number)
	shake(strength)
end

-- Foto-Modus an? (dann keine Zusatz-Effekte auf dem Bildschirm)
function Effects.IsHidden(): boolean
	return hidden
end

-- Foto-Modus: fliegende Zahlen + große Karten ausblenden
function Effects.SetHidden(value: boolean)
	hidden = value
	if overlay then
		overlay.Enabled = not value
	end
	if value then
		for _, fly in ipairs(flyPool) do
			fly.Active = false
			fly.Gui.Enabled = false
		end
		table.clear(revealQueue)
	end
end

function Effects.Init(context: any)
	ctx = context
	fxFolder = UI.Create("Folder", { Name = "MeteorHeistClientFX", Parent = workspace })
	-- Eigene Ebene über der Oberfläche (ohne deren UIScale -> Pixel = Bildschirm-Pixel)
	overlay = UI.Create("ScreenGui", {
		Name = "MeteorHeistFX",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	alarmFrame = UI.Create("Frame", {
		Name = "Alarm",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 0,
		Parent = UI.Root,
	})
	buildFlyPool()
	buildFrozen()
	buildCoins()
	buildShards()
	-- Trommel für das Ei-Rennen (Sound direkt im Ordner = überall gleich laut)
	drumSound = UI.Create("Sound", { Name = "RaceDrum", SoundId = DRUM_SOUND, Volume = 0.8, Parent = fxFolder })
	RunService.RenderStepped:Connect(function(dt: number)
		stepFlyNumbers(dt)
		if #flights > 0 then
			stepFlights(dt)
		end
		if shardsAlive > 0 then
			stepShards(dt)
		end
		stepShake(dt)
	end)
	-- Neuer Charakter: Wackeln zurücksetzen, Eingefroren-Anzeige neu verbinden
	player.CharacterAdded:Connect(function(character)
		shakeLeft = 0
		shakeHumanoid = nil
		watchFrozen(character)
	end)
	if player.Character then
		task.spawn(watchFrozen, player.Character)
	end
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Fly</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  FLIEGEN / SCHWEBEN (Taste G) – nur wenn der Server es erlaubt (Attribut CanFly)
--  WASD/Stick = Richtung (folgt der Kamera, auch hoch/runter), Leertaste = hoch, Shift = runter
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Fly = {}

local player = Players.LocalPlayer
local FLY_SPEED = 70

local toast: (string, string?) -> () = function(_text: string, _kind: string?) end
local flying = false
local flyParts: { Instance } = {}
local flyConnection: RBXScriptConnection? = nil

local function stopFlying()
	flying = false
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	for _, inst in ipairs(flyParts) do
		inst:Destroy()
	end
	flyParts = {}
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = false
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
end

local function startFlying()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	flying = true
	local attachment = Instance.new("Attachment")
	attachment.Name = "FlyAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = 1e7
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.MaxTorque = 1e7
	align.Responsiveness = 40
	align.CFrame = root.CFrame.Rotation
	align.Parent = root
	flyParts = { attachment, velocity, align }
	humanoid.PlatformStand = true

	flyConnection = RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera or not root.Parent or humanoid.Health <= 0 then
			stopFlying()
			return
		end
		local look = camera.CFrame.LookVector
		local move = humanoid.MoveDirection -- funktioniert mit Tastatur, Gamepad und Handy-Stick
		local direction = Vector3.zero
		if move.Magnitude > 0.05 then
			local flatLook = Vector3.new(look.X, 0, look.Z)
			local forwardAmount = if flatLook.Magnitude > 0.01 then move:Dot(flatLook.Unit) else 0
			direction = move + Vector3.new(0, look.Y * math.max(forwardAmount, 0) * 1.5, 0)
		end
		if not UserInputService:GetFocusedTextBox() then
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				direction += Vector3.new(0, 1, 0)
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
				direction -= Vector3.new(0, 1, 0)
			end
		end
		velocity.VectorVelocity = if direction.Magnitude > 0.01 then direction.Unit * FLY_SPEED else Vector3.zero
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.01 then
			align.CFrame = CFrame.lookAt(Vector3.zero, flat)
		end
	end)
end

function Fly.Toggle()
	if flying then
		stopFlying()
		toast("🕊️ Fliegen aus", "Info")
	elseif player:GetAttribute("CanFly") == true then
		startFlying()
		if flying then
			toast("🕊️ Fliegen an! Leertaste = hoch, Shift = runter, G = aus", "Success")
		end
	end
end

function Fly.Init(toastFunction: (string, string?) -> ())
	toast = toastFunction
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.G then
			Fly.Toggle()
		end
	end)
	player.CharacterAdded:Connect(function()
		if flying then
			stopFlying()
		end
	end)
	player:GetAttributeChangedSignal("CanFly"):Connect(function()
		if player:GetAttribute("CanFly") ~= true and flying then
			stopFlying()
		end
	end)
end

return Fly
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  HUD (immer sichtbar), im knalligen Simulator-Stil:
--   links:        ⭐ STARTER-PAKET (bis gekauft), 🛒 Shop, 👟 Angebot, 🔥 Rebirth, 🎁 Daily
--   rechts:       Icon-Knöpfe in 2 Spalten (LayoutOrder = Platz, jede Zahl nur einmal!):
--                 1 🎁 Geschenke, 2 🎡 Glücksrad, 3 📜 Aufgaben (mit Badges), 4 👽 Index, 5 🏃 Laufbänder,
--                 6 🏠 Home, 7 ☄️ Run (MeteorRun), 8 🏗️ Base (Base), 9 🤝 Handel (Trade), 99 🛠️ Admin
--   unten links:  👟 Schritte (gelb), 💵 Geld (grün), +$/s
--   oben:         Banner (Meteoritenschauer/Glück, 🥚 Egg Rush, 🏁 Ei-Rennen) bzw. Countdowns bis zum nächsten
--   unten Mitte:  Wegweiser (🏠 Base beim Tragen / 🏁 Gold-Ei im Rennen / 🥚 nächstes Ei im Egg Rush),
--                 Trage-Hinweis, Prompt-Hinweis an den Nestern (E = Schnappen gratis, F = Kaufen)
-- =====================================================================

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
