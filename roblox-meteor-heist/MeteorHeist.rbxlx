	{ "EmberBlob", "Glut-Glibber", "Blob", rgb(220, 100, 50), rgb(255, 220, 80), 2, 0 },
	{ "EmberSpiky", "Feuer-Igel Fritz", "Spiky", rgb(200, 80, 40), rgb(255, 200, 60), 2, 0 },
