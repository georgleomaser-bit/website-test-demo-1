local Indicators = require("../src/shared/Market/Indicators")

local passed, failed = 0, 0
local failures: { string } = {}

local function check(name: string, fn: () -> ())
	local ok, err = pcall(fn)
	if ok then
		passed += 1
	else
		failed += 1
		table.insert(failures, name .. ": " .. tostring(err))
	end
end

local function eq(actual: any, expected: any, label: string?)
	if actual ~= expected then
		error(("%s erwartet %s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

-- Reihe gegen Referenz: nil muss nil sein, Zahlen relativ auf 1e-9 gleich
local function same(actual: { any }, expected: { any }, n: number, label: string)
	for i = 1, n do
		local a, e = actual[i], expected[i]
		if e == nil then
			if a ~= nil then
				error(("%s[%d]: nil erwartet (Warm-up), bekommen %s"):format(label, i, tostring(a)), 2)
			end
		else
			if type(a) ~= "number" then
				error(("%s[%d]: %s erwartet, bekommen nil"):format(label, i, tostring(e)), 2)
			end
			local tolerance = 1e-9 * math.max(1, math.abs(e))
			if math.abs(a - e) > tolerance then
				error(("%s[%d]: %.12f erwartet, bekommen %.12f"):format(label, i, e, a), 2)
			end
		end
	end
end

