check("Bollinger(10, 2)", function()
	local bb = Indicators.Bollinger(R_closes, 10, 2)
	same(bb.Mid, R_bbMid, N, "BB.Mid")
	same(bb.Upper, R_bbUp, N, "BB.Upper")
	same(bb.Lower, R_bbLow, N, "BB.Lower")
end)

check("Bollinger Standardwerte = (20, 2)", function()
	local a = Indicators.Bollinger(R_closes)
	local b = Indicators.Bollinger(R_closes, 20, 2)
	same(a.Upper, b.Upper :: any, N, "BB.Default")
	eq(a.Mid[19], nil, "Warm-up bis Index 19")
end)

