check("VWAP mit Tagesperiode 86.400 = Website", function()
	local bars2 = {}
	for i, b in ipairs(BARS) do
		bars2[i] = { T = if i <= 20 then i - 1 else 86400 + i - 1, O = b.O, H = b.H, L = b.L, C = b.C, V = b.V }
	end
	same(Indicators.VWAP(bars2, 86400), R_vwap, N, "VWAP")
end)

check("VWAP Standard: Rücksetzen je Börsentag (1200 Ticks)", function()
	local bars3 = {
		{ T = 0, O = 10, H = 12, L = 8, C = 10, V = 10 },
		{ T = 1199, O = 10, H = 14, L = 10, C = 12, V = 30 },
		{ T = 1200, O = 12, H = 21, L = 15, C = 18, V = 5 },
	}
	local v = Indicators.VWAP(bars3)
	eq(v[1], 10, "erste Kerze = typischer Preis")
	eq(v[2], (10 * 10 + 12 * 30) / 40, "gleicher Börsentag")
	eq(v[3], 18, "neuer Börsentag startet neu")
end)

check("Heikin-Ashi", function()
	local ha = Indicators.HeikinAshi(BARS)
	eq(#ha, N, "Länge")
	local o, c, h, l = {}, {}, {}, {}
	for i, b in ipairs(ha) do
		o[i], c[i], h[i], l[i] = b.O, b.C, b.H, b.L
		eq(b.T, BARS[i].T, "Zeit bleibt")
	end
	same(o, R_haO, N, "HA.O")
	same(c, R_haC, N, "HA.C")
	same(h, R_haH, N, "HA.H")
	same(l, R_haL, N, "HA.L")
end)

check("Kaputte Parameter: kein Fehler, gleiche Länge", function()
	local nan = 0 / 0
	local s = Indicators.SMA(R_closes, nan)
	same(s, R_closes, N, "SMA(n=NaN) -> n = 1")
	local e = Indicators.EMA({}, 5)
	eq(#e, 0, "leere Eingabe")
	local r = Indicators.RSI({ 100 }, 14)
	eq(r[1], nil, "eine Kerze: kein RSI")
	local m = Indicators.MACD({ 1, 2, 3 })
	eq(m.Line[3], nil, "zu kurz: nil")
	local st = Indicators.Stoch({ { T = 0, O = 1, H = 1, L = 1, C = 1, V = 0 } })
	eq(st.K[1], nil, "zu kurz: nil")
end)

check("Flache Reihe: RSI 100, Stochastik 50, Bollinger-Band = Mitte", function()
	local flat = table.create(30, 50)
	local r = Indicators.RSI(flat, 14)
	eq(r[15], 100, "keine Verluste -> 100")
	local bars = {}
	for i = 1, 20 do
		bars[i] = { T = i, O = 50, H = 50, L = 50, C = 50, V = 1 }
	end
	eq(Indicators.Stoch(bars, 14, 3).K[16], 50, "hi == lo -> 50")
	local bb = Indicators.Bollinger(flat, 20, 2)
	eq(bb.Upper[20], 50, "sd 0")
end)

