		["mkt.class.Normal"] = "Normal",
		["mkt.class.Wild"] = "Wild",
		["mkt.class.ETF"] = "ETF",
		["mkt.regime.calm"] = "Sonnig – ruhiger Markt",
		["mkt.regime.normal"] = "Wolkig – normaler Markt",
		["mkt.regime.storm"] = "Sturm – wilder Markt",
		["mkt.phase.Warn"] = "Warnung",
		["mkt.phase.Run"] = "läuft",
		["mkt.phase.End"] = "vorbei",

		-- Kalender (CalendarItem.Key)
		["mkt.cal.Earnings"] = "Quartalszahlen",
		["mkt.cal.Macro.Rates"] = "Zinsentscheid",
		["mkt.cal.Macro.Growth"] = "Konjunkturdaten",
		["mkt.cal.Macro.Energy"] = "Energiepreise",
		["mkt.cal.Dividend"] = "Dividende (Ex-Tag)",
		["mkt.cal.CrashFriday"] = "Crash-Freitag",
		["mkt.cal.RallyWednesday"] = "Rally-Mittwoch",
		["mkt.cal.AutoShow"] = "Samstags-Show-Rallye",
		["mkt.cal.Ipo"] = "IPO-Erstnotiz",

		-- Firmenprofil & Analysten
		["mkt.verdict.beat"] = "übertrifft",
		["mkt.verdict.miss"] = "verfehlt",
		["mkt.verdict.none"] = "–",
		["mkt.profile.revenue"] = "Umsatz je Quartal",
		["mkt.profile.growth"] = "Umsatzwachstum (4 Quartale)",
		["mkt.profile.eps"] = "Gewinn je Aktie",
		["mkt.profile.pe"] = "KGV",
		["mkt.profile.loss"] = "schreibt Verluste",
		["mkt.profile.divYield"] = "Dividende je Ausschüttung",
		["mkt.profile.nextEarnings"] = "Nächste Quartalszahlen",
		["mkt.profile.nextDividend"] = "Nächster Ex-Tag",
		["mkt.profile.analysts"] = "Analysten",
		["mkt.profile.hitRate"] = "Trefferquote %d/%d",
		["mkt.profile.consensus"] = "Konsens",
		["mkt.profile.weekHigh"] = "Wochen-Hoch",
		["mkt.profile.weekLow"] = "Wochen-Tief",
		["mkt.profile.prospect"] = "Prospekt",
		["mkt.profile.issuePrice"] = "Ausgabepreis",
		["mkt.profile.quality.good"] = "Starkes Wachstum, solide Zahlen",
		["mkt.profile.quality.mid"] = "Durchschnittliche Zahlen",
		["mkt.profile.quality.weak"] = "Schwache Zahlen, hohes Risiko",

		-- Admin-Markt (Antworten an den Besitzer)
		["mkt.admin.ok"] = "Markt-Event verteilt – Start in %d s",
		["mkt.admin.local"] = "Bus nicht erreichbar – nur lokal angewendet (Testmarkt)",
		["mkt.admin.notDistributed"] = "Markt-Event nicht verteilt – bitte gleich nochmal versuchen",
		["mkt.admin.denied"] = "Nur der Besitzer darf den Markt steuern",
