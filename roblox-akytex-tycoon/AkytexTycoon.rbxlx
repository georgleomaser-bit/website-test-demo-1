end

R.Trophy = function(list, r, s)
	p(list, s, { 1.8, 1.2, 1.8 }, { 0, 0.6, 0 }, r.B, "Marble", { Collide = true })
	p(list, s, { 1.4, 0.4, 1.4 }, { 0, 1.4, 0 }, r.A, r.M)
