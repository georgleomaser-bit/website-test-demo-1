	local module = Shared:FindFirstChild("Types")
	assert(module and module:IsA("ModuleScript"), "Types fehlt")
	eq(type(require(module)), "table", "Types gibt eine Tabelle zurück")
end

return Tests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">EconomyTests</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Selbsttests Monetarisierung & CR-Konto (Server/Tests/EconomyTests)
--  Besitzer: WP10 (Monetarisierung, Shop, CR-Konto). Vertrag: DESIGN.md §D WP10 "Abnahme"/"Tests", §C11.4 Punkte 5–6
--  (SelfTest "Firewall" byte-gleich, "NoPaidRandom"), §C17 (Beleg-Idempotenz: doppelt + gleichzeitig).
--  SelfTestService lädt dieses Modul und ruft jede Funktion mit Services auf; jeder Fehler = FAIL.
--  Arbeitet nur mit Test-Spielständen (Kopien von DataService.DefaultData) und Test-Attrappen – echte Spieler bleiben
--  unberührt. Einzige Ausnahme: der Live-Idempotenz-Test läuft nur mit einem geladenen Studio-Spieler im NoSave-Modus.
--
--  Prüft: Config (14 Pässe, 17 Produkte, Validate leer) · Belege (Wiederholung, gleichzeitig, Spieler weg, unbekanntes
--  Produkt, Speichern scheitert, Belegliste begrenzt) · Grant alles-oder-nichts · Sanitize · Firewall byte-gleich
--  (jedes Produkt + Wiederholung, jeder Pass, jede Saison-Stufe beider Spuren, Club-Tagesgabe, jeder Code, Admin-/
--  Event-Gutschriften) · NoPaidRandom · Paket/Pässe-Faktor (x2 + x3 = x4, echter Rabatt) · Starter einmalig ·
--  Bau-Gutschein max(Angebot, Neu) + Angebots-Ablauf · Angebots-Regeln · Geschenk-Gate fail-closed · CR-Konto
--  (Whitelist, Ganzzahl, Deckel 9e15) · Bullen-Parade-Deckel · Saison-Premium zweimal · Boutique-Rotation.
-- =====================================================================

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local SHOP: any = Config.Shop
local MAX_MONEY = 9e15

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function eq(actual: any, expected: any, label: string?)
	if actual ~= expected then
		error(("%s erwartet %s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function truthy(value: any, label: string)
	if not value then
		error(label, 2)
	end
end

-- rekursiver Vergleich (gleiche Typen, gleiche Werte, gleiche Schlüssel) -> (gleich, Pfad der Abweichung)
local function deepEqual(a: any, b: any, path: string, depth: number?): (boolean, string?)
	local level = depth or 0
	if level > 16 then
		return false, path .. " (zu tief)"
	end
	if type(a) ~= type(b) then
		return false, path
	end
	if type(a) ~= "table" then
		if a ~= b and not (a ~= a and b ~= b) then
			return false, path
		end
		return true, nil
	end
	for key, value in pairs(a) do
		local ok, where = deepEqual(value, b[key], path .. "." .. tostring(key), level + 1)
		if not ok then
			return false, where
		end
	end
	for key in pairs(b) do
		if a[key] == nil then
			return false, path .. "." .. tostring(key)
		end
	end
	return true, nil
end

local function serviceModule(services: any, name: string): any
	local svc = services and services[name]
	if svc then
		return svc
	end
	local module = script.Parent.Parent:WaitForChild("Services"):FindFirstChild(name)
	assert(module and module:IsA("ModuleScript"), name .. " fehlt")
	return require(module) :: any
end

local function cores(services: any): (any, any)
	local shop = serviceModule(services, "ShopService")
	local monetization = serviceModule(services, "MonetizationService")
	assert(shop.Core, "ShopService.Core fehlt")
	assert(monetization.Core, "MonetizationService.Core fehlt")
	return shop.Core, monetization.Core
end

-- frischer Test-Spielstand (DEFAULT_DATA aus WP1, sonst Minimal-Stand mit Depot/Prog-Attrappe)
local function newData(services: any): any
	local dataService = services and services.DataService
	local data: any
	if dataService and type(dataService.DefaultData) == "function" then
		data = dataService.DefaultData()
	else
		data = {
			Credits = 0,
			Sessions = 0,
			Depot = { V = 1, Cash = 2500000, Basis = 2500000, Pos = {}, Orders = {}, Bots = {} },
			Prog = { Xp = 0, Licence = 1, KH = {}, Ruf = 0, Titles = {} },
			Tower = { Floors = {}, Build = {}, Express = {}, Instant = 0 },
			Garage = { Cars = {} },
			Life = { Watches = {}, Accessories = {} },
			Storage = { Decor = {} },
			Season = { Id = 1, Xp = 0, Premium = false },
			Boosts = { X2 = 0, X5 = 0, Bull = 0 },
			Purchases = { Receipts = {}, RobuxSpent = 0, Starter = false, PassSeasons = {}, Quote = {} },
			Stats = { LifetimeCredits = 0 },
			Flags = {},
		}
	end
	local shopCore = cores(services)
	shopCore.Ensure(data)
	return data
end

-- alles, was Robux NIE berühren dürfen (§C11.4 #5): Depot, Depot.Bots, Prog.Licence/Xp/KnowHow/KH/Ruf
local function firewallSnapshot(data: any): any
	local prog = if type(data.Prog) == "table" then data.Prog else {}
	local depot = data.Depot
	return Util.DeepCopy({
		Depot = depot,
		Bots = if type(depot) == "table" then depot.Bots else nil,
		Licence = prog.Licence,
		Xp = prog.Xp,
		KnowHow = prog.KnowHow,
		KH = prog.KH,
		Ruf = prog.Ruf,
	})
end

local function assertFirewall(before: any, data: any, label: string)
	local ok, where = deepEqual(before, firewallSnapshot(data), "Firewall")
	truthy(ok, label .. ": Depot/Lizenz/XP/KH/Ruf verändert bei " .. tostring(where))
end

local function noForbidden(grant: any, label: string)
	for _, field in ipairs(SHOP.ForbiddenRobuxFields) do
		eq(grant[field], nil, label .. "." .. field)
	end
end

local function seasonNow(): number
	return SHOP.SeasonIdAt(Config.Season, os.time())
end

-- ---------------------------------------------------------------------
-- BELEG-ATTRAPPEN (Core.ProcessReceiptWith mit austauschbarer Umgebung)
-- ---------------------------------------------------------------------
local FAKE_PLAYER = { Name = "Testspieler", UserId = 999001, DisplayName = "Testspieler" }
local TEST_PRODUCT = {
	Key = "TestVoucher",
	Id = 4242,
	Kind = "Voucher",
	Voucher = { Minutes = 30, Min = 5000 },
	Random = false,
}

local testId = 0
local function purchaseId(): string
	testId += 1
	return ("TEST-%d-%d-%s"):format(os.time(), testId, string.sub(HttpService:GenerateGUID(false), 1, 8))
end

local function receiptEnv(
	services: any,
	data: any,
	opts: { SaveOk: boolean?, PrepareWait: number?, Counter: { n: number } }
): any
	local shopCore = cores(services)
	return {
		FindPlayer = function(userId: any): any
			return if userId == FAKE_PLAYER.UserId then FAKE_PLAYER else nil
		end,
		Product = function(productId: any): any
			return if productId == TEST_PRODUCT.Id then TEST_PRODUCT else nil
		end,
		WaitData = function(_p: any): any
			return data
		end,
		CurrentData = function(_p: any): any
			return data
		end,
		Prepare = function(_p: any, _product: any): any
			if opts.PrepareWait then
				task.wait(opts.PrepareWait)
			end
			return { SeasonId = 1, Steady = 0 }
		end,
		Grant = function(_p: any, d: any, _product: any, _prepared: any): boolean
			opts.Counter.n += 1
			local ok = shopCore.Credit(d, 5000, "Purchase")
			return ok
		end,
		Save = function(_p: any): boolean
			return opts.SaveOk ~= false
		end,
		Wait = function(seconds: number)
			task.wait(seconds)
		end,
	}
end

local function receipt(id: string, productId: number?, playerId: number?): any
	return {
		PlayerId = playerId or FAKE_PLAYER.UserId,
		ProductId = productId or TEST_PRODUCT.Id,
		PurchaseId = id,
		CurrencySpent = 49,
	}
end

local GRANTED = Enum.ProductPurchaseDecision.PurchaseGranted
local NOT_YET = Enum.ProductPurchaseDecision.NotProcessedYet

local Tests = {}

-- ---------------------------------------------------------------------
-- CONFIG
-- ---------------------------------------------------------------------
Tests["Config.Shop: 14 Pässe, 17 Produkte, Validate leer"] = function()
	eq(#SHOP.GamePasses, 14, "Gamepässe")
	eq(#SHOP.Products, 17, "Developer Products")
	local errors = SHOP.Validate(Config)
	eq(#errors, 0, "Shop-Fehler: " .. table.concat(errors, " | "))
	truthy(type(SHOP.Subscription) == "table" and type(SHOP.Subscription.Id) == "string", "Abo-Eintrag")
	for _, key in ipairs({ "CreditsS", "CreditsM", "CreditsL", "CreditsXL" }) do
		eq(SHOP.ProductsByKey[key].Kind, "Voucher", key)
	end
	eq(SHOP.QuoteSeconds, 600, "Angebot 10 min")
	eq(SHOP.MaxOffersPerSession, 1, "max. 1 Angebot je Sitzung")
end

-- ---------------------------------------------------------------------
-- BELEGE (§C11.1, Abnahme 1)
-- ---------------------------------------------------------------------
Tests["Beleg: Wiederholung gewährt genau einmal"] = function(services: any)
	local _, monCore = cores(services)
	local data = newData(services)
	local counter = { n = 0 }
	local env = receiptEnv(services, data, { Counter = counter })
	local id = purchaseId()
	eq(monCore.ProcessReceiptWith(receipt(id), env), GRANTED, "erster Aufruf")
	eq(monCore.ProcessReceiptWith(receipt(id), env), GRANTED, "Wiederholung")
	eq(monCore.ProcessReceiptWith(receipt(id), env), GRANTED, "dritter Aufruf")
	eq(counter.n, 1, "Gutschriften")
	eq(data.Credits, 5000, "CR nur einmal")
	truthy(monCore.HasReceipt(data, id), "Beleg vermerkt")
	eq(data.Purchases.RobuxSpent, 49, "RobuxSpent")
	local last = data.Purchases.Receipts[#data.Purchases.Receipts]
	truthy(type(last) == "table" and type(last.Key) == "string" and last.Key ~= "", "Beleg nennt den Artikel (Admin)")
end

Tests["Beleg: gleichzeitig mit gleicher PurchaseId genau einmal"] = function(services: any)
	local _, monCore = cores(services)
	local data = newData(services)
	local counter = { n = 0 }
	local env = receiptEnv(services, data, { Counter = counter, PrepareWait = 0.3 })
	local id = purchaseId()
	local results: { any } = {}
	for i = 1, 3 do
		task.spawn(function()
			results[i] = monCore.ProcessReceiptWith(receipt(id), env)
		end)
	end
	for _ = 1, 60 do
		if results[1] ~= nil and results[2] ~= nil and results[3] ~= nil then
			break
		end
		task.wait(0.1)
	end
	for i = 1, 3 do
		eq(results[i], GRANTED, "Aufruf " .. i)
	end
	eq(counter.n, 1, "Gutschriften")
	eq(data.Credits, 5000, "CR nur einmal")
end

Tests["Beleg: Spieler weg, unbekanntes Produkt, Speichern scheitert, Liste begrenzt"] = function(services: any)
	local _, monCore = cores(services)
	local data = newData(services)
	local counter = { n = 0 }
	local env = receiptEnv(services, data, { Counter = counter })
	eq(monCore.ProcessReceiptWith(receipt(purchaseId(), nil, 12345), env), NOT_YET, "Spieler nicht da")
	eq(monCore.ProcessReceiptWith(receipt(purchaseId(), 777), env), NOT_YET, "unbekanntes Produkt")
	eq(monCore.ProcessReceiptWith("kaputt", env), NOT_YET, "kaputter Beleg")
	eq(counter.n, 0, "nichts gutgeschrieben")
	-- Speichern scheitert: NotProcessedYet, Beleg steht -> nächster Versuch ohne Doppel-Gutschrift
	local failing = receiptEnv(services, data, { Counter = counter, SaveOk = false })
	local id = purchaseId()
	eq(monCore.ProcessReceiptWith(receipt(id), failing), NOT_YET, "Save-Fehler")
	eq(counter.n, 1, "einmal gutgeschrieben")
	eq(monCore.ProcessReceiptWith(receipt(id), env), GRANTED, "Wiederholung nach Save-Fehler")
	eq(counter.n, 1, "keine Doppel-Gutschrift")
	for _ = 1, 75 do
		monCore.AddReceipt(data, purchaseId(), os.time())
	end
	truthy(#data.Purchases.Receipts <= (Config.Tech.ReceiptKeep or 60), "Belege begrenzt (60)")
end

Tests["Beleg live: SimulatePurchase doppelt + gleichzeitig (gleiche Id) = eine Gewährung"] = function(services: any)
	-- nur mit einem geladenen Studio-Spieler im NoSave-Modus (sonst decken die Core-Tests den Fluss ab)
	local monetization = serviceModule(services, "MonetizationService")
	local shop = serviceModule(services, "ShopService")
	local dataService = services and services.DataService
	if dataService == nil or type(dataService.Get) ~= "function" then
		return
	end
	local target: Player? = nil
	for _, p in ipairs(Players:GetPlayers()) do
		if dataService.Get(p) ~= nil and type(dataService.IsNoSave) == "function" and dataService.IsNoSave(p) then
			target = p
			break
		end
	end
	if target == nil then
		return
	end
	local p = target :: Player
	local before = shop.Balance(p)
	local voucher = SHOP.ProductsByKey.CreditsS
	local tower = services.TowerService
	local steady = 0
	if tower and type(tower.Income) == "function" then
		local okIncome, info = pcall(tower.Income, p)
		if okIncome and type(info) == "table" and Util.IsFinite(info.Steady) then
			steady = info.Steady
		end
	end
	local single = SHOP.VoucherCredits(voucher, steady)
	local id = "SELFTEST-" .. HttpService:GenerateGUID(false)
	local results: { boolean } = {}
	for i = 1, 2 do
		task.spawn(function()
			results[i] = (monetization.SimulatePurchase(p, "CreditsS", id))
		end)
	end
	for _ = 1, 100 do
		if results[1] ~= nil and results[2] ~= nil then
			break
		end
		task.wait(0.1)
	end
	truthy(results[1] == true and results[2] == true, "beide Aufrufe bestätigt")
	local again = monetization.SimulatePurchase(p, "CreditsS", id)
	truthy(again == true, "dritter Aufruf bestätigt (Beleg vorhanden)")
	local gained = shop.Balance(p) - before
	truthy(gained >= voucher.Voucher.Min, "eine Gutschrift (" .. tostring(gained) .. ")")
	truthy(
		gained < 2 * single,
		("nie doppelt (%s für einen Gutschein von %s)"):format(tostring(gained), tostring(single))
	)
	local count = 0
	local data = dataService.Get(p)
	local receipts = if data and type(data.Purchases) == "table" then data.Purchases.Receipts else {}
	for _, entry in ipairs(receipts) do
		if type(entry) == "table" and entry.Id == id then
			count += 1
		end
	end
	eq(count, 1, "genau ein Beleg")
end

-- ---------------------------------------------------------------------
-- GRANT / SANITIZE
-- ---------------------------------------------------------------------
Tests["Grant alles-oder-nichts: ungültige Gewährungen ändern nichts"] = function(services: any)
	local shopCore = cores(services)
	local data = newData(services)
	data.Credits = 100
	local before = Util.DeepCopy(data)
	-- Liste mit zusätzlichem Text-Schlüssel (absichtlich kaputt, zur Laufzeit gebaut)
	local mixedList: { [any]: any } = { "ok" }
	mixedList.Extra = "x"
	for i, bad in ipairs({
		{ Credits = -5 },
		{ Credits = 1.5 },
		{ Credits = 0 / 0 },
		{ Credits = math.huge },
		{ Unbekannt = 1 },
		{ Xp = 10 },
		{ Cars = { "GibtEsNicht" } },
		{ Accessories = { "Copper" } }, -- Copper ist eine Uhr, kein Accessoire
		{ Decor = { NeonBench = 0 } },
		{ Decor = { GibtEsNicht = 1 } },
		{ Cosmetics = { 1 } },
		{ Cosmetics = mixedList },
		{ BoostX2 = 1e12 },
		{ SeasonPremium = "ja" },
		{ Credits = 10, Cars = { "GibtEsNicht" } },
	}) do
		local ok = shopCore.ValidateGrant(data, bad)
		truthy(not ok, "ungültiger Grant #" .. i .. " wurde akzeptiert")
	end
	local same, where = deepEqual(before, data, "Daten")
	truthy(same, "Prüfung hat Daten verändert bei " .. tostring(where))
	-- gültige Gewährung
	local grant = { Credits = 250, Cosmetics = { "Startup" }, BoostX2 = 600, Decor = { NeonBench = 2 } }
	local ok, err = shopCore.ValidateGrant(data, grant)
	truthy(ok, "gültiger Grant abgelehnt: " .. tostring(err))
	shopCore.ApplyGrant(data, grant)
	eq(data.Credits, 350, "CR")
	eq(data.Purchases.Cosmetics.Startup, true, "Kosmetik")
	eq(data.Boosts.X2, 600, "Boost x2")
	eq(data.Storage.Decor.NeonBench, 2, "Deko")
end

Tests["Sanitize streicht verbotene Robux-Felder"] = function(services: any)
	local shopCore, monCore = cores(services)
	local dirty = {
		Credits = 10,
		Xp = 5,
		AKY = 1,
		Depot = { Cash = 1 },
		Basis = 9,
		Licence = 2,
		KnowHow = 3,
		Ruf = 1,
		Stars = 4,
		BotSlots = 1,
		MarketInfo = true,
		ExamPass = true,
	}
	for _, clean in ipairs({ shopCore.Sanitize(dirty, true), monCore.Sanitize(dirty) }) do
		eq(clean.Credits, 10, "CR bleiben")
		noForbidden(clean, "Sanitize")
	end
	-- Nicht-Robux-Quelle: verbotene Felder werden zwar nicht gestrichen, aber die Prüfung lehnt sie ab
	local loose = shopCore.Sanitize({ Credits = 10, Xp = 5 }, false)
	local ok = shopCore.ValidateGrant(newData(services), loose)
	truthy(not ok, "XP-Feld bei Nicht-Robux-Quelle akzeptiert")
end

-- ---------------------------------------------------------------------
-- FIREWALL (§C11.4 #5, Abnahme 2) – byte-gleich für jeden Robux-Pfad
-- ---------------------------------------------------------------------
Tests["Firewall byte-gleich: Produkte, Pässe, Saison, Club, Codes, Events"] = function(services: any)
	local shopCore, monCore = cores(services)
	local season = seasonNow()
	local checked = 0
	-- 1) jedes Produkt, Erstkauf und Wiederholung
	for _, product in ipairs(SHOP.Products) do
		for _, repeatCase in ipairs({ false, true }) do
			local data = newData(services)
			data.Prog.Xp, data.Prog.Ruf = 12345, 7
			if repeatCase then
				data.Purchases.Starter = true
				data.Purchases.PassSeasons[tostring(season)] = true
			end
			local before = firewallSnapshot(data)
			local grant = monCore.BuildGrant(
				product,
				data,
				{ SeasonId = season, Steady = 123.45, Now = os.time(), RandomAllowed = false, Premium = repeatCase }
			)
			grant = shopCore.Sanitize(grant, true)
			noForbidden(grant, product.Key)
			local ok, err = shopCore.ValidateGrant(data, grant)
			truthy(ok, product.Key .. ": Gewährung ungültig: " .. tostring(err))
			shopCore.ApplyGrant(data, grant)
			assertFirewall(before, data, product.Key .. (if repeatCase then " (Wiederholung)" else ""))
			checked += 1
		end
	end
	-- 2) jeder Pass (Refresh: wirksamer Besitz + Faktoren, schreibt nie Spielstand-Werte)
	for _, pass in ipairs(SHOP.GamePasses) do
		local data = newData(services)
		local before = firewallSnapshot(data)
		local effective = monCore.EffectivePasses({ [pass.Key] = true })
		local factor = monCore.PassFactor(effective.Income2x == true, effective.Income3x == true)
		truthy(factor >= 1 and factor <= 4, pass.Key .. ": Pässe-Faktor " .. tostring(factor))
		local fixed = monCore.FixedFactor(effective.VIP == true, false, false)
		truthy(fixed >= 1 and fixed <= 1.5, pass.Key .. ": Fix-Faktor " .. tostring(fixed))
		shopCore.Ensure(data)
		assertFirewall(before, data, "Pass " .. pass.Key)
		checked += 1
	end
	-- 3) jede Saison-Stufe beider Spuren (gekauft = Robux-Pfad)
	local seasons = type(Config.Season) == "table" and Config.Season.Seasons or {}
	for _, entry in ipairs(seasons) do
		for _, track in ipairs({ entry.Free or {}, entry.Premium or {} }) do
			for _, reward in ipairs(track) do
				local data = newData(services)
				local before = firewallSnapshot(data)
				local grant = shopCore.Sanitize(shopCore.RewardToGrant(reward, 50), true)
				noForbidden(grant, "Saison-Stufe " .. tostring(reward.Tier))
				local ok, err = shopCore.ValidateGrant(data, grant)
				truthy(ok, "Saison-Stufe " .. tostring(reward.Tier) .. " ungültig: " .. tostring(err))
				shopCore.ApplyGrant(data, grant)
				assertFirewall(before, data, "Saison-Stufe " .. tostring(reward.Tier))
				checked += 1
			end
		end
	end
	-- 4) Club-Tagesgabe (Bau-Gutschein S)
	do
		local data = newData(services)
		local before = firewallSnapshot(data)
		local voucher = SHOP.ProductsByKey[SHOP.Subscription.DailyVoucher]
		local grant = shopCore.Sanitize({ Credits = SHOP.VoucherCredits(voucher, 99) }, true)
		truthy(shopCore.ValidateGrant(data, grant), "Club-Tagesgabe ungültig")
		shopCore.ApplyGrant(data, grant)
		assertFirewall(before, data, "Club-Tagesgabe")
		checked += 1
	end
	-- 5) jeder Code (Config.Rewards.Codes – nur CR/Kosmetik)
	local codes = type(Config.Rewards) == "table" and Config.Rewards.Codes or {}
	for code, entry in pairs(codes) do
		local data = newData(services)
		local before = firewallSnapshot(data)
		local grant = shopCore.Sanitize(shopCore.RewardToGrant(entry.Grant, 0), false)
		local ok, err = shopCore.ValidateGrant(data, grant)
		truthy(ok, "Code " .. tostring(code) .. " ungültig: " .. tostring(err))
		shopCore.ApplyGrant(data, grant)
		assertFirewall(before, data, "Code " .. tostring(code))
		checked += 1
	end
	-- 6) Admin-/Event-Gutschriften (Geldregen, Pickups, Admin-Abuse-Belohnungen laufen alle über Credit)
	for _, source in ipairs({ "Event", "Rain", "Pickup", "Admin", "Code", "Season", "Login", "Quest" }) do
		local data = newData(services)
		local before = firewallSnapshot(data)
		truthy(shopCore.Credit(data, 1000, source), "Credit " .. source)
		assertFirewall(before, data, "Gutschrift " .. source)
		checked += 1
	end
	truthy(checked >= #SHOP.Products * 2 + #SHOP.GamePasses + 2, "zu wenige Firewall-Fälle: " .. checked)
end

-- ---------------------------------------------------------------------
-- NO PAID RANDOM (§C11.4 #6, Abnahme 3)
-- ---------------------------------------------------------------------
Tests["NoPaidRandom: keine bezahlten Zufallsartikel, Policy fail-closed"] = function(services: any)
	local _, monCore = cores(services)
	eq(SHOP.RandomItemsEnabled, false, "RandomItemsEnabled")
	local banned = { Odds = true, Weights = true, Weight = true, Chance = true, Pity = true }
	local function scan(node: any, path: string, depth: number)
		if type(node) ~= "table" or depth > 6 then
			return
		end
		for key, value in pairs(node) do
			if banned[key] then
				error(path .. "." .. tostring(key) .. ": Zufalls-Feld im Shop", 0)
			end
			if key == "Random" and value ~= false then
				error(path .. ".Random ist nicht false", 0)
			end
			scan(value, path .. "." .. tostring(key), depth + 1)
		end
	end
	scan(SHOP.GamePasses, "GamePasses", 0)
	scan(SHOP.Products, "Products", 0)
	scan(SHOP.Subscription, "Subscription", 0)
	for _, product in ipairs(SHOP.Products) do
		eq(product.Random, false, product.Key .. ".Random")
	end
	-- PolicyService: Fehler/fehlend = eingeschränkt
	eq(monCore.ParsePolicy(nil).Random, false, "Policy unbekannt")
	eq(monCore.ParsePolicy({ ArePaidRandomItemsRestricted = true }).Random, false, "eingeschränkt")
	eq(monCore.ParsePolicy({}).Random, false, "Feld fehlt")
	eq(monCore.ParsePolicy({ ArePaidRandomItemsRestricted = false }).Random, true, "erlaubt")
	-- gedachtes Zufallsprodukt bei unbekannter Policy -> fester Ersatz, nie der Zufallsinhalt
	local fake = {
		Key = "FakeRandom",
		Kind = "Boost",
		Random = true,
		Grant = { BoostX2 = 60 },
		Repeat = { Grant = { BoostX2 = 30 } },
	}
	local grant = monCore.BuildGrant(fake, newData(services), { SeasonId = 1, Steady = 0, Now = os.time() })
	eq(grant.BoostX2, 30, "eingeschränkt -> Ersatz")
end

-- ---------------------------------------------------------------------
-- PAKET & FAKTOREN (§B14.1)
-- ---------------------------------------------------------------------
Tests["Paket: Besitz zählt für die Teile, x2 + x3 = x4, echter Rabatt"] = function(services: any)
	local _, monCore = cores(services)
	local effective = monCore.EffectivePasses({ TycoonBundle = true })
	eq(effective.Income2x, true, "Paket -> x2")
	eq(effective.AutoCollect, true, "Paket -> Auto-Kassierer")
	eq(effective.OfflineVault, true, "Paket -> Offline-Tresor")
	eq(effective.Income3x, false, "Paket gibt kein x3")
	eq(monCore.PassFactor(false, false), 1, "ohne Pässe")
	eq(monCore.PassFactor(true, false), 2, "x2")
	eq(monCore.PassFactor(false, true), 3, "x3")
	eq(monCore.PassFactor(true, true), 4, "x2 + x3 = x4")
	eq(SHOP.BundleValue("TycoonBundle"), 1097, "Einzelpreise")
	eq(SHOP.BundleDiscountPct("TycoonBundle"), 32, "Rabatt −32 %")
	truthy(SHOP.PassesByKey.TycoonBundle.Price < SHOP.BundleValue("TycoonBundle"), "Paket günstiger")
	eq(SHOP.BundleDiscountPct("TycoonBundle", 700, 749), 0, "kein Fake-Rabatt aus Live-Preisen")
	local vip = monCore.FixedFactor(true, false, false)
	local all = monCore.FixedFactor(true, true, true)
	truthy(math.abs(vip - 1.10) < 1e-9, "VIP ×1,10")
	truthy(math.abs(all - 1.10 * 1.15 * 1.10) < 1e-9, "VIP × Club × Premium")
end

-- ---------------------------------------------------------------------
-- STARTER-PAKET (einmal je Konto)
-- ---------------------------------------------------------------------
Tests["Starter einmalig, Wiederholung = 2 × Bau-Gutschein M"] = function(services: any)
	local _, monCore = cores(services)
	local data = newData(services)
	local starter = SHOP.ProductsByKey.Starter
	local voucherM = SHOP.ProductsByKey.CreditsM
	local ctx = { SeasonId = 1, Steady = 10, Now = os.time() }
	local g1, i1 = monCore.BuildGrant(starter, data, ctx)
	eq(g1.Cars and g1.Cars[1], "LamNeon", "Auto Λ Kompakt Neon")
	eq(g1.Watches and g1.Watches[1], "FirstBell", "Uhr Erste Glocke")
	eq(g1.BoostX2, 7200, "Boost x2 2 h")
	truthy(type(g1.Cosmetics) == "table" and table.find(g1.Cosmetics, "Startup") ~= nil, "Fassaden-Neon Startup")
	truthy(table.find(g1.Cosmetics, "FounderFrame") ~= nil, "Namensrahmen Gründer")
	eq(g1.Credits, SHOP.VoucherCredits(voucherM, 10), "Bau-Gutschein M")
	eq(i1.MarkStarter, true, "Starter wird vermerkt")
	data.Purchases.Starter = true
	local g2, i2 = monCore.BuildGrant(starter, data, ctx)
	eq(i2.Repeat, true, "Wiederholung")
	eq(i2.MarkStarter, false, "kein zweites Vermerken")
	eq(g2.Cars, nil, "kein zweites Auto")
	eq(g2.BoostX2, nil, "kein zweiter Boost")
	eq(g2.Credits, 2 * SHOP.VoucherCredits(voucherM, 10), "2 × Gutschein M")
end

-- ---------------------------------------------------------------------
-- BAU-GUTSCHEIN (Abnahme 5): max(Angebot, Neuberechnung), nur CR, Angebots-Ablauf
-- ---------------------------------------------------------------------
Tests["Bau-Gutschein: max(Angebot, Neu), nur CR, Angebot läuft ab"] = function(services: any)
	local _, monCore = cores(services)
	local now = os.time()
	local product = SHOP.ProductsByKey.CreditsM
	local fresh = SHOP.VoucherCredits(product, 10)
	eq(fresh, math.max(20000, 10 * 120 * 60), "Neuberechnung")
	eq(SHOP.VoucherCredits(product, 0), 20000, "Mindestbetrag")
	local data = newData(services)
	local ctx = { SeasonId = 1, Steady = 10, Now = now }
	data.Purchases.Quote.CreditsM = { Credits = 100000, Until = now + 300 }
	local grant = monCore.BuildGrant(product, data, ctx)
	eq(grant.Credits, 100000, "höheres Angebot zählt")
	for field in pairs(grant) do
		eq(field, "Credits", "Bau-Gutschein gibt nur CR")
	end
	data.Purchases.Quote.CreditsM = { Credits = 1000, Until = now + 300 }
	eq(monCore.BuildGrant(product, data, ctx).Credits, fresh, "höhere Neuberechnung zählt")
	data.Purchases.Quote.CreditsM = { Credits = 100000, Until = now - 1 }
	eq(monCore.BuildGrant(product, data, ctx).Credits, fresh, "abgelaufenes Angebot zählt nicht")
	data.Purchases.Quote.CreditsM = { Credits = 100000, Until = now + SHOP.QuoteSeconds + 120 }
	eq(monCore.BuildGrant(product, data, ctx).Credits, fresh, "unplausibles Angebot zählt nicht")
	eq(monCore.QuoteFor(data, "CreditsM", now), nil, "QuoteFor ignoriert es")
end

-- ---------------------------------------------------------------------
-- ANGEBOTS-REGELN (§B14.4, Abnahme 4)
-- ---------------------------------------------------------------------
Tests["Angebote: nie in Sitzung 1, max. 1, nie bei Warnung/Tutorial/Admin-Abuse"] = function(services: any)
	local _, monCore = cores(services)
	local function ctx(overrides: { [string]: any }): any
		local base = {
			Shown = 0,
			Max = SHOP.MaxOffersPerSession,
			Sessions = 3,
			MinSession = SHOP.OfferMinSession,
			SessionSeconds = 3600,
			MinSeconds = SHOP.OfferMinMinutes * 60,
			TutorialDone = true,
			AdminAbuse = false,
			MarketBlocked = false,
		}
		for key, value in pairs(overrides) do
			base[key] = value
		end
		return base
	end
	truthy(monCore.OfferCheck(ctx({})), "ruhiger Moment ab Sitzung 2")
	local cases = {
		{ { Sessions = 1 }, "FirstSession" },
		{ { Shown = 1 }, "MaxPerSession" },
		{ { SessionSeconds = 14 * 60 }, "TooEarly" },
		{ { TutorialDone = false }, "Tutorial" },
		{ { AdminAbuse = true }, "AdminAbuse" },
		{ { MarketBlocked = true }, "MarketWarning" },
	}
	for _, case in ipairs(cases) do
		local ok, reason = monCore.OfferCheck(ctx(case[1]))
		truthy(not ok, "Angebot trotz " .. case[2])
		eq(reason, case[2], "Grund")
	end
	truthy(SHOP.OfferMinSession >= 2, "nie in Sitzung 1 (Config)")
end

-- ---------------------------------------------------------------------
-- GESCHENK-GATE (Abnahme 6)
-- ---------------------------------------------------------------------
Tests["Geschenk gesperrt ohne IsPaidItemTradingAllowed (fail-closed)"] = function(services: any)
	local _, monCore = cores(services)
	eq(monCore.ParsePolicy({}).Trading, false, "Feld fehlt = gesperrt")
	eq(monCore.ParsePolicy(nil).Trading, false, "Fehler = gesperrt")
	eq(monCore.ParsePolicy({ IsPaidItemTradingAllowed = true }).Trading, true, "erlaubt")
	local cases = {
		{ false, true, false, true, "shop.giftBlocked" },
		{ true, false, false, true, "shop.giftBlocked" },
		{ nil, true, false, true, "shop.giftBlocked" },
		{ true, nil, false, true, "shop.giftBlocked" },
		{ true, true, true, true, "shop.giftSelfNot" },
		{ true, true, false, false, "shop.giftTargetGone" },
	}
	for i, case in ipairs(cases) do
		local ok, reason = monCore.GiftCheck(case[1], case[2], case[3], case[4])
		truthy(not ok, "Geschenk-Fall " .. i .. " durchgelassen")
		eq(reason, case[5], "Grund Fall " .. i)
	end
	truthy(monCore.GiftCheck(true, true, false, true), "beide erlaubt")
end

-- ---------------------------------------------------------------------
-- CR-KONTO (Whitelist, Ganzzahl, Deckel)
-- ---------------------------------------------------------------------
Tests["CR-Konto: Quellen/Senken-Whitelist, Ganzzahl, Deckel 9e15"] = function(services: any)
	local shopCore = cores(services)
	local data = newData(services)
	truthy(not shopCore.Credit(data, 100, "Robux"), "unbekannte Quelle")
	truthy(not shopCore.Credit(data, -5, "Income"), "negativ")
	truthy(not shopCore.Credit(data, 0 / 0, "Income"), "NaN")
	truthy(not shopCore.Credit(data, 0.5, "Income"), "unter 1")
	eq(data.Credits, 0, "nichts gebucht")
	local ok, added = shopCore.Credit(data, 1000, "Income")
	truthy(ok and added == 1000, "Credit 1000")
	eq(data.Stats.LifetimeCredits, 1000, "Lebenszeit-CR")
	truthy(not shopCore.Debit(data, 10, "Robux"), "unbekannte Senke")
	truthy(not shopCore.Debit(data, 1.5, "Floor"), "Bruchteil")
	truthy(not shopCore.Debit(data, 1001, "Floor"), "mehr als Guthaben")
	eq(data.Credits, 1000, "nichts abgezogen")
	truthy(shopCore.Debit(data, 400, "Floor"), "Debit 400")
	eq(data.Credits, 600, "Rest")
	truthy(shopCore.CanSpend(data, 600) and not shopCore.CanSpend(data, 601), "CanSpend")
	data.Credits = MAX_MONEY - 10
	local okCap, addedCap = shopCore.Credit(data, 100, "Vault")
	truthy(okCap, "Credit am Deckel")
	eq(addedCap, 10, "nur bis zum Deckel")
	eq(data.Credits, MAX_MONEY, "Deckel 9e15")
	data.Credits = 12.7
	shopCore.Ensure(data)
	eq(data.Credits, 12, "Kontostand ganzzahlig")
	for _, source in ipairs(SHOP.Sources) do
		truthy(shopCore.Credit(newData(services), 1, source), "Quelle " .. source)
	end
	eq(shopCore.SourceOf("Robux:CreditsM", true), "Purchase", "Robux -> Purchase")
	eq(shopCore.SourceOf("Season:Tier12", false), "Season", "Saison")
	eq(shopCore.SourceOf("Irgendwas", false), nil, "unbekannt")
end

-- ---------------------------------------------------------------------
-- BULLEN-PARADE, SAISON-PREMIUM, ROTATION
-- ---------------------------------------------------------------------
Tests["Bullen-Parade: 15 min je Kauf, höchstens 60 min im Voraus"] = function(services: any)
	local _, monCore = cores(services)
	local now = os.time()
	eq(monCore.ExtendParade(0, now), now + SHOP.Parade.Seconds, "erster Kauf")
	local untilT = 0
	for _ = 1, 10 do
		untilT = monCore.ExtendParade(untilT, now)
	end
	eq(untilT, now + SHOP.Parade.CapSeconds, "Deckel 60 min")
	eq(monCore.ExtendParade(now + 3000, now), now + SHOP.Parade.CapSeconds, "Verlängerung geklemmt")
end

Tests["Saison-Premium zweimal -> Bau-Gutschein L, neue Saison wieder Premium"] = function(services: any)
	local _, monCore = cores(services)
	local data = newData(services)
	local product = SHOP.ProductsByKey.SeasonPremium
	local voucherL = SHOP.ProductsByKey.CreditsL
	local season = seasonNow()
	local g1, i1 = monCore.BuildGrant(product, data, { SeasonId = season, Steady = 5, Now = os.time() })
	eq(g1.SeasonPremium, true, "erster Kauf: Premium")
	eq(i1.MarkSeason, true, "Saison vermerkt")
	data.Purchases.PassSeasons[tostring(season)] = true
	local g2, i2 = monCore.BuildGrant(product, data, { SeasonId = season, Steady = 5, Now = os.time() })
	eq(g2.SeasonPremium, nil, "kein zweites Premium")
	eq(i2.Repeat, true, "Ersatz")
	eq(g2.Credits, SHOP.VoucherCredits(voucherL, 5), "Bau-Gutschein L")
	local g3 = monCore.BuildGrant(
		product,
		newData(services),
		{ SeasonId = season, Steady = 5, Now = os.time(), Premium = true }
	)
	eq(g3.SeasonPremium, nil, "schon Premium (anders erhalten) -> Ersatz")
	local g4 = monCore.BuildGrant(product, data, { SeasonId = season + 1, Steady = 5, Now = os.time() })
	eq(g4.SeasonPremium, true, "neue Saison")
end

Tests["Saison-Id: Lücke zwischen festen Saisons = vorige (wie RewardService), danach Rolling"] = function()
	local day = 86400
	local cfg = {
		Seasons = {
			{ Id = 1, StartUtc = "2030-01-01T00:00:00Z", EndUtc = "2030-01-29T00:00:00Z" },
			{ Id = 2, StartUtc = "2030-03-01T00:00:00Z", EndUtc = "2030-03-29T00:00:00Z" },
		},
		Rolling = { Enabled = true, LengthDays = 28 },
		MaxSeasons = 999,
	}
	local s1 = SHOP.ParseUtc("2030-01-01T00:00:00Z") :: number
	local s2 = SHOP.ParseUtc("2030-03-01T00:00:00Z") :: number
	local e2 = SHOP.ParseUtc("2030-03-29T00:00:00Z") :: number
	eq(SHOP.SeasonIdAt(cfg, s1 - day), 1, "vor der ersten")
	eq(SHOP.SeasonIdAt(cfg, s1 + day), 1, "in Saison 1")
	eq(SHOP.SeasonIdAt(cfg, s2 - day), 1, "Lücke: Saison 1 gilt weiter (kein Rolling)")
	eq(SHOP.SeasonIdAt(cfg, s2 + day), 2, "in Saison 2")
	eq(SHOP.SeasonIdAt(cfg, e2 + day), 3, "nach der letzten: Rolling")
	eq(SHOP.SeasonIdAt(cfg, e2 + 29 * day), 4, "Rolling weiter")
end

Tests["CR-Senke Ipo und Quellen League/WinBack/Referral (keine Fremd-Buchung als Event/Admin)"] = function(
	services: any
)
	local shopCore = cores(services)
	local data = newData(services)
	truthy(shopCore.Credit(data, 1000, "League"), "Quelle League")
	truthy(shopCore.Credit(data, 1000, "WinBack"), "Quelle WinBack")
	eq(shopCore.SourceOf("Referral", false), "Referral", "Einladung")
	truthy(shopCore.Debit(data, 2000, "Ipo"), "Börsengang-Senke")
	eq(data.Credits, 0, "Börsengang leert das CR-Konto")
	truthy(shopCore.Credit(data, 300, "Admin"), "Admin-Geschenk")
	eq(data.Stats.AdminCredits, 300, "Admin-CR im Konto markiert (Wunsch 18)")
	truthy(SHOP.Disabled.TerminalDesigner == true, "Terminal-Designer gesperrt, solange die Themes fehlen")
end

Tests["Boutique-Rotation deterministisch, verschieden, begrenzt"] = function(services: any)
	local shopCore = cores(services)
	local pool = { "A", "B", "C", "D", "E", "F", "G", "H", "I", "J" }
	local a = shopCore.Rotation(123, 6, pool)
	local b = shopCore.Rotation(123, 6, pool)
	eq(#a, 6, "Anzahl")
	eq(table.concat(a, ","), table.concat(b, ","), "deterministisch")
	local seen: { [string]: boolean } = {}
	for _, key in ipairs(a) do
		truthy(not seen[key], "doppelt: " .. key)
		seen[key] = true
	end
	eq(#shopCore.Rotation(5, 6, { "X", "Y", "Z" }), 3, "kleiner Pool")
	eq(#shopCore.Rotation(5, 6, {}), 0, "leerer Pool")
	local shop = serviceModule(services, "ShopService")
	local live = shop.Rotation()
	truthy(#live <= SHOP.BoutiqueSlots, "Rotation höchstens BoutiqueSlots")
	eq(table.concat(live, ","), table.concat(shop.Rotation(), ","), "gleiches Fenster = gleiche Rotation")
end

return Tests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">MarketTests</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Selbsttests der Markt-Engine (Server/Tests/MarketTests)
--  Besitzer: WP3 (Markt-Engine). Vertrag: DESIGN.md §D WP3 "Tests"/"Abnahme", §C17; MARKET.md §19.
--  Läuft über SelfTestService (Studio, "[SelfTest] n/n PASS"). Jeder Test bekommt die Services-Tabelle.
--  Alle Tests bauen EIGENE, isolierte Wochen-Kontexte mit Test-Seeds (MarketService.TestContext) – der Live-Markt
--  wird nicht verändert. Lange Tests yielden zwischendurch (task.wait), damit der Server flüssig bleibt.
--  Abgedeckt: Noise-Vektoren §19.2 · Determinismus (zwei Instanzen, 10.000 Ticks, Random-Access == sequentiell,
--  Cursor == Random-Access) · Kerzen-Aggregation 1m aus 1s == Ring · Backfill/Stillstand-Ringe == live ·
--  Frame ≤ 900 B (43 = 439 B) · QuoteCodec-Rundreise/falsche Länge · Dividenden-Ex-Tick · Gerüchte-Bestätigung ·
--  News nie vor t_a · Wochenwechsel stetig · Berlin-Termine auf Tick genau · CancelAutoShow · Admin-Event (Rampe,
--  Abklingen, Pause) · Config/Lang · Live-Markt.
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Lang = require(Shared:WaitForChild("Lang"))
local QuoteCodec = require(Shared:WaitForChild("Market"):WaitForChild("QuoteCodec"))

local MarketFolder = script.Parent.Parent:WaitForChild("Market")
local Noise = require(MarketFolder:WaitForChild("Noise"))
local MarketClock = require(MarketFolder:WaitForChild("MarketClock"))
local CandleStore = require(MarketFolder:WaitForChild("CandleStore"))

local Tests = {}

type Plain = { [string]: any }

local TEST_SEED = 123456789
local TEST_WEEK = 41 -- Mo 2026-10-19 (Saison 1, Samstag = IPO 100)

local function eq(actual: any, expected: any, label: string?)
	if actual ~= expected then
		error(("%s erwartet %s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function market(services: any): any
	local svc = services and services.MarketService
	assert(svc and type(svc.TestContext) == "function", "MarketService fehlt")
	return svc
end

local function context(
	services: any,
	seed: number?,
	week: number?,
	bases: { [number]: number }?,
	cancelled: (boolean | number)?
): Plain
	return market(services).TestContext(seed or TEST_SEED, week or TEST_WEEK, bases, cancelled)
end

local function build(ctx: Plain, day: number)
	local guard = 0
	while ctx.Director:BuiltThrough() < day and guard < 200 do
		ctx.Director:EnsureBuilt(day, 16)
		guard += 1
		task.wait()
	end
end

-- ---------------------------------------------------------------------
Tests["Markt: Noise-Testvektoren MARKET §19.2"] = function()
	local vectors = {
		{ 123456, 1, 0, 0, 3076564673 },
		{ 123456, 1, 0, 1, 1222392628 },
		{ 123456, 1, 13, 7, 3917177298 },
		{ 987654321, 104, 5, 123456789, 4043101596 },
		{ 2147483647, 9, 9001, 86399, 2536699204 },
	}
	for _, v in ipairs(vectors) do
		eq(Noise.Hash4(v[1], v[2], v[3], v[4]), v[5], "hash4")
	end
	assert(math.abs(Noise.Uni(123456, 1, 0, 0) - 0.432637066114694) < 1e-12, "uni")
	eq(Noise.Mul32(0x9E3779B9, 0x846CA68B), Noise.Mul32(0x846CA68B, 0x9E3779B9), "mul32 kommutativ")
	eq(Noise.Mul32(4294967295, 4294967295), 1, "mul32((2^32 − 1)², mod 2^32) = 1")
end

Tests["Markt: Determinismus zwei Instanzen 10.000 Ticks, Random-Access == sequentiell"] = function(services)
	local a = context(services)
	local b = context(services)
	local start = MarketClock.WeekStart(TEST_WEEK) + 120 * MarketClock.DAY
	build(a, MarketClock.DayIndex(start + 10000) + 1)
	build(b, MarketClock.DayIndex(start + 10000) + 1)
	local ids = { 1, 3, 9, 13, 28, 31, 40, 41 }
	local mismatches = 0
	for t = start, start + 9999 do
		a.Engine:Step(t)
		b.Engine:Step(t)
		for _, i in ipairs(ids) do
			local _, _, m1 = a.Engine:Quote(i)
			local _, _, m2 = b.Engine:Quote(i)
			if m1 ~= m2 then
				mismatches += 1
			end
		end
		if (t - start) % 400 == 0 then
			task.wait()
		end
	end
	eq(mismatches, 0, "Abweichungen zwischen zwei Instanzen")
	-- Random-Access (dritte Instanz, rückwärts, gestreut) == sequentiell (Instanz a, letzter Stand + Stichproben)
	local c = context(services)
	build(c, MarketClock.DayIndex(start + 10000) + 1)
	for k = 0, 300 do
		local t = start + 9999 - k * 33
		for _, i in ipairs(ids) do
			if c.Engine:MidAt(i, t) ~= a.Engine:MidAt(i, t) then
				mismatches += 1
			end
		end
	end
	local _, _, live = a.Engine:Quote(9)
	eq(c.Engine:MidAt(9, start + 9999), live, "Random-Access == letzter Live-Kurs")
	eq(mismatches, 0, "Random-Access-Abweichungen")
	-- Cursor (Offline-Abgleich) == Random-Access, inklusive Seek-Sprünge
	local cursor = c.Engine:NewCursor(13, start + 500)
	for t = start + 500, start + 900 do
		local o, h, l, cl = cursor:Candle(t)
		local o2, h2, l2, c2 = a.Engine:CandleAt(13, t)
		if o ~= o2 or h ~= h2 or l ~= l2 or cl ~= c2 then
			mismatches += 1
		end
	end
	cursor:Seek(start + 5000)
	local o, h, l, cl = cursor:Candle(start + 5000)
	local o2, h2, l2, c2 = a.Engine:CandleAt(13, start + 5000)
	eq(mismatches, 0, "Cursor-Abweichungen")
	assert(o == o2 and h == h2 and l == l2 and cl == c2, "Cursor nach Seek")
end

Tests["Markt: Kerzen-Aggregation 1m aus 1s == Ring, Frame 439 B"] = function(services)
	local ctx = context(services)
	local start = MarketClock.WeekStart(TEST_WEEK) + 33 * MarketClock.DAY + 600 -- Minutengrenze
	build(ctx, MarketClock.DayIndex(start) + 1)
	local store = CandleStore.new(Config.Market)
	local i = 9
	for t = start, start + 239 do
		ctx.Engine:Step(t)
		local o, h, l, c, v = ctx.Engine:Candle(i)
		store:Push(i, t, o, h, l, c, v)
	end
	local _, _, _, s1 = QuoteCodec.DecodeCandles(store:Get(i, 1) :: buffer)
	local _, _, _, m1 = QuoteCodec.DecodeCandles(store:Get(i, 60) :: buffer)
	assert(s1 and m1, "Kerzen dekodierbar")
	local agg = QuoteCodec.Aggregate(s1 :: any, 60)
	local compared = 0
	for _, x in ipairs(agg) do
		for _, y in ipairs(m1 :: any) do
			if y.T == x.T and x.T >= (s1 :: any)[1].T and x.T + 59 <= (s1 :: any)[#(s1 :: any)].T then
				compared += 1
				eq(x.O, y.O, "Open")
				eq(x.C, y.C, "Close")
				assert(math.abs(x.H - y.H) <= x.H * 0.0001 + 1, "High (Auflösung 0,01 %)")
				assert(math.abs(x.L - y.L) <= x.L * 0.0001 + 1, "Low (Auflösung 0,01 %)")
				assert(math.abs(x.V - y.V) <= 60, "Umsatz (Rundung Ø je Sekunde)")
			end
		end
	end
	assert(compared >= 1, "mindestens eine volle Minute verglichen")
	local rows = {}
	for _, id in ipairs(ctx.Engine:Ids()) do
		local _, _, _, c, v, hiOff, loOff = ctx.Engine:Candle(id)
		if c then
			table.insert(rows, { Id = id, Flags = 0, Close = c, HiOff = hiOff, LoOff = loOff, Vol = v })
		end
	end
	eq(#rows, 43, "43 Instrumente im Frame")
	local frame = QuoteCodec.EncodeFrame(start, 0, 1, rows)
	eq(buffer.len(frame), 439, "Frame-Größe")
	local decoded = QuoteCodec.DecodeFrame(frame)
	assert(decoded and #decoded.Rows == 43, "Frame-Rundreise")
	local short = buffer.create(438)
	buffer.copy(short, 0, frame, 0, 438)
	eq(QuoteCodec.DecodeFrame(short), nil, "falsche Länge -> nil")
end

Tests["Markt: Backfill/Stillstand-Ringe == durchgehend live (1s, 5s, 1m)"] = function(services)
	local ctx = context(services)
	local i = 9
	local live = MarketClock.WeekStart(TEST_WEEK) + 6 * MarketClock.DAY + 37 -- nicht 5s-/minuten-ausgerichtet
	build(ctx, MarketClock.DayIndex(live) + 1)
	local function candleAt(id: number, t: number)
		local o, h, l, c, v = ctx.Engine:CandleAt(id, t)
		return o, h, l, c, v
	end
	local cursorFn = function(id: number, t0: number)
		return ctx.Engine:NewCursor(id, t0)
	end
	-- Referenz: 40 min durchgehend live geschoben
	local ref = CandleStore.new(Config.Market)
	local refCursor = ctx.Engine:NewCursor(i, live - 2400)
	for t = live - 2400, live + 10 do
		local o, h, l, c, v = refCursor:Full(t)
		ref:Push(i, t, o, h, l, c, v)
		if t % 600 == 0 then
			task.wait()
		end
	end
	local function same(a: any, b: any, tf: number, label: string)
		local _, _, _, ca = QuoteCodec.DecodeCandles(a:Get(i, tf) :: buffer)
		local _, _, _, cb = QuoteCodec.DecodeCandles(b:Get(i, tf) :: buffer)
		assert(ca and cb, label .. ": dekodierbar")
		local byT: { [number]: any } = {}
		for _, c in ipairs(ca :: any) do
			byT[c.T] = c
		end
		local compared = 0
		for _, c in ipairs(cb :: any) do
			local r = byT[c.T]
			if r and c.T >= live - 2400 + 60 then
				compared += 1
				assert(c.C > 0, ("%s tf=%d: Lücke bei %d"):format(label, tf, c.T - live))
				assert(
					r.O == c.O and r.H == c.H and r.L == c.L and r.C == c.C and r.V == c.V,
					("%s tf=%d: Kerze bei %d weicht ab"):format(label, tf, c.T - live)
				)
			end
		end
		assert(compared >= 30, ("%s tf=%d: zu wenig verglichen (%d)"):format(label, tf, compared))
	end
	-- Boot: laufende Buckets vorbelegen, Backfill einplanen, Live läuft parallel
	local boot = CandleStore.new(Config.Market)
	boot:SeedPartial(i, live, candleAt)
	boot:Plan(cursorFn, { i }, live)
	assert(boot:Missing(i, live - 120), "Backfill offen -> Historie gilt als unvollständig")
	boot:Prioritize(i)
	for t = live, live + 10 do
		ctx.Engine:Step(t)
		local o, h, l, c, v = ctx.Engine:Candle(i)
		boot:Push(i, t, o :: number, h :: number, l :: number, c :: number, v :: number)
		boot:Work(2)
	end
	local guard = 0
	while not boot:Work(4) and guard < 5000 do
		guard += 1
		if guard % 20 == 0 then
			task.wait()
		end
	end
	assert(not boot:Missing(i, live - 24 * 3600), "nach dem Backfill vollständig")
	for _, tf in ipairs({ 1, 5, 60 }) do
		same(ref, boot, tf, "Boot")
	end
	-- Stillstand: live bis live−400, Sprung auf live−23 (Rebuild + SeedPartial wie MarketService)
	local stall = CandleStore.new(Config.Market)
	stall:Plan(cursorFn, {}, live) -- nur Cursor-Quelle setzen (keine Aufträge)
	local stallCursor = ctx.Engine:NewCursor(i, live - 2400)
	for t = live - 2400, live - 400 do
		local o, h, l, c, v = stallCursor:Full(t)
		stall:Push(i, t, o, h, l, c, v)
	end
	local target = live - 23
	stall:Rebuild({ i }, live - 399, target - 1, target)
	stall:SeedPartial(i, target, candleAt)
	for t = target, live + 10 do
		local o, h, l, c, v = ctx.Engine:CandleAt(i, t)
		stall:Push(i, t, o, h, l, c, v)
		stall:Work(2)
	end
	guard = 0
	while not stall:Work(4) and guard < 5000 do
		guard += 1
		if guard % 20 == 0 then
			task.wait()
		end
	end
	for _, tf in ipairs({ 1, 5, 60 }) do
		same(ref, stall, tf, "Stillstand")
	end
end

Tests["Markt: Dividenden-Ex-Tick senkt den Kurs um den Betrag"] = function(services)
	local ctx = context(services)
	local ws = MarketClock.WeekStart(TEST_WEEK)
	build(ctx, MarketClock.DayIndex(ws) + 12)
	local divs = ctx.Director:Dividends(ws, ws + 12 * MarketClock.DAY)
	assert(#divs > 0, "Dividenden im Plan")
	for k = 1, math.min(#divs, 20) do
		local d = divs[k]
		local before = ctx.Engine:MidAt(d.I, d.Tick, d.Tick)
		local after = ctx.Engine:MidAt(d.I, d.Tick)
		assert(math.abs((before - after) - d.Cents) <= 1, ("Abschlag %d statt %d"):format(before - after, d.Cents))
		eq(MarketClock.Minute(d.Tick), Config.Market.Dividend.Minute, "Ex-Tick um :19")
	end
end

Tests["Markt: Gerücht wird nach 120 s bestätigt/dementiert, Kurs erst nach dem Lesefenster"] = function(services)
	local ctx = context(services)
	local ws = MarketClock.WeekStart(TEST_WEEK)
	build(ctx, MarketClock.DayIndex(ws) + 2)
	local news = ctx.Director:NewsIn(ws, ws + 2 * MarketClock.DAY)
	local rumor, fact = nil, nil
	for _, n in ipairs(news) do
		if n.Kind == "Rumor" and rumor == nil then
			rumor = n
		elseif n.Kind == "Fact" and n.Band and n.Band >= 2 and fact == nil then
			fact = n
		end
	end
	assert(rumor, "kein Gerücht gefunden")
	local resolved = nil
	for _, n in ipairs(ctx.Director:NewsIn(rumor.T, rumor.T + Config.Market.RumorResolve)) do
		if (n.Kind == "Confirm" or n.Kind == "Deny") and n.I == rumor.I then
			resolved = n
		end
	end
	assert(resolved, "keine Auflösung")
	eq(resolved.T - rumor.T, Config.Market.RumorResolve, "Auflösung nach 120 s")
	assert(fact, "keine Fakten-News")
	local o0 = ctx.Director:Offset(fact.I, fact.T)
	local oDelay = ctx.Director:Offset(fact.I, fact.T + Config.Market.Delay)
	local oAfter = ctx.Director:Offset(fact.I, fact.T + Config.Market.Delay + Config.Market.Tau)
	assert(math.abs(oDelay - o0) < 0.002, "vor Ablauf des Lesefensters keine Reaktion")
	assert((oAfter - o0) * fact.Dir > 0, "Reaktion in Richtung der Schlagzeile")
end

Tests["Markt: News kommen nie vor t_a (NewsIn je Tick)"] = function(services)
	local ctx = context(services)
	local ws = MarketClock.WeekStart(TEST_WEEK)
	build(ctx, MarketClock.DayIndex(ws) + 1)
	local count = 0
	for t = ws + 1, ws + MarketClock.DAY do
		for _, n in ipairs(ctx.Director:NewsIn(t - 1, t)) do
			eq(n.T, t, "News-Zeitpunkt")
			count += 1
		end
	end
	assert(count > 10, "zu wenige News an einem Börsentag: " .. count)
	for _, n in ipairs(ctx.Director:LatestNews(ws + 600, 50)) do
		assert(n.T <= ws + 600, "LatestNews enthält Zukunft")
	end
end

Tests["Markt: Wochenwechsel stetig (Basis = Wochenschluss)"] = function(services)
	local week = TEST_WEEK
	local a = context(services, TEST_SEED, week)
	local weekEnd = MarketClock.WeekEnd(week)
	build(a, MarketClock.DayIndex(weekEnd))
	local closes: { [number]: number } = {}
	for _, i in ipairs(a.Engine:Ids()) do
		if a.Engine:IsActive(i, weekEnd) then
			closes[i] = a.Engine:MidAt(i, weekEnd)
		end
	end
	local b = context(services, 987654321, week + 1, closes)
	build(b, MarketClock.DayIndex(weekEnd + 1))
	for _, i in ipairs({ 1, 9, 13, 28, 40 }) do
		local p0 = closes[i]
		local p1 = b.Engine:MidAt(i, weekEnd + 1)
		assert(p0 and p0 > 0, "Wochenschluss vorhanden")
		assert(math.abs(math.log(p1 / p0)) < 0.004, ("Sprung am Wochenwechsel bei %d: %d -> %d"):format(i, p0, p1))
	end
end

Tests["Markt: Berlin-Termine auf Tick genau (Sommer-/Winterzeit)"] = function(services)
	-- unabhängig mit Python zoneinfo("Europe/Berlin") berechnet
	eq(MarketClock.WeeklyTick(41, 5, 19, 0), 25203600, "Crash-Freitag 23.10.2026 19:00 MESZ")
	eq(MarketClock.WeeklyTick(42, 5, 19, 0), 25812000, "Crash-Freitag 30.10.2026 19:00 MEZ")
	eq(MarketClock.WeeklyTick(41, 3, 19, 0), 25030800, "Rally-Mittwoch 21.10.2026")
	eq(MarketClock.WeeklyTick(41, 6, 18, 15), 25287300, "Samstags-Show 24.10.2026 18:15")
	eq(MarketClock.WeeklyTick(41, 6, 17, 0), 25282800, "IPO 24.10.2026 17:00")
	-- der Plan setzt den Crash-Freitag genau dorthin (Warnung 3 min vorher)
	local ctx = context(services)
	build(ctx, MarketClock.DayIndex(25203600) + 1)
	local found = false
	for _, n in ipairs(ctx.Director:NewsIn(25203600 - 1, 25203600)) do
		if n.Kind == "Crash" and n.Key == "news.weekly.CrashFriday" then
			found = true
		end
	end
	assert(found, "Crash-Freitag-Schlagzeile genau um 19:00 Berlin")
	local warned = false
	for _, n in ipairs(ctx.Director:NewsIn(25203600 - 181, 25203600 - 180)) do
		if n.Kind == "Warn" then
			warned = true
		end
	end
	assert(warned, "Warnung 3 min vorher")
	local listing = ctx.Director:Listing(100)
	assert(listing and listing.T0 == 25282800, "IPO 100 notiert Samstag 17:00 Berlin")
end

Tests["Markt: CancelAutoShow sagt die Samstags-Rallye ab"] = function(services)
	local show = MarketClock.WeeklyTick(TEST_WEEK, 6, 18, 15) :: number
	local on = context(services, TEST_SEED, TEST_WEEK, nil, false)
	local off = context(services, TEST_SEED, TEST_WEEK, nil, true)
	build(on, MarketClock.DayIndex(show) + 1)
	build(off, MarketClock.DayIndex(show) + 1)
	local sector = Config.Companies.Sectors[(TEST_WEEK % 6) + 1].Key
	local target = 0
	for _, entry in ipairs(Config.Companies.Instruments) do
		if entry.Sector == sector and not entry.Ipo and entry.Class ~= "ETF" then
			target = entry.Id
			break
		end
	end
	assert(target > 0, "Firma im Sektor der Woche")
	local t = show + 30 + Config.Market.Delay + 120
	local up = on.Engine:MidAt(target, t)
	local base = off.Engine:MidAt(target, t)
	assert(up > base * 1.03, ("Show-Rallye wirkt (%d vs %d)"):format(up, base))
	eq(off.Engine:MidAt(target, show - 600), on.Engine:MidAt(target, show - 600), "vor der Show identisch")
	local showNews = false
	for _, n in ipairs(off.Director:NewsIn(show, show + 60)) do
		if n.Key == "news.weekly.AutoShow" then
			showNews = true
		end
	end
	assert(not showNews, "abgesagte Show schickt keine Schlagzeile")
	-- Absage mitten in der Warnphase: gilt erst ab ihrem Start-Tick (vorher wie geplant, danach wie abgesagt)
	local warnAt = show + 30 - Config.Market.CrashRally.WarnSeconds
	local cutAt = warnAt + 60
	local mid = context(services, TEST_SEED, TEST_WEEK, nil, cutAt)
	build(mid, MarketClock.DayIndex(show) + 1)
	eq(mid.Engine:MidAt(target, cutAt - 1), on.Engine:MidAt(target, cutAt - 1), "vor dem Absage-Tick wie geplant")
	eq(mid.Engine:MidAt(target, t), off.Engine:MidAt(target, t), "nach dem Ausblenden wie abgesagt")
	local worst = 0
	for k = cutAt - 5, cutAt + 70 do
		local a, b = mid.Engine:MidAt(target, k - 1), mid.Engine:MidAt(target, k)
		worst = math.max(worst, math.abs(math.log(b / a)))
	end
	assert(worst < 0.01, ("kein Kurssprung beim Ausblenden (größter 1s-Schritt %.4f)"):format(worst))
	local crash, rally = mid.Director:CrashRally(cutAt - 1)
	assert(rally and not crash, "Warnphase vor der Absage zeigt die Rallye")
	local _, rallyAfter = mid.Director:CrashRally(cutAt)
	assert(not rallyAfter, "nach der Absage keine Rallye-Flagge")
end

Tests["Markt: Admin-Crash (Rampe, Abklingen, 10-s-Pause, Admin-Fenster), Normalisieren"] = function(services)
	local ctx = context(services)
	local ws = MarketClock.WeekStart(TEST_WEEK)
	local x = ws + 90 * MarketClock.DAY + 300
	build(ctx, MarketClock.DayIndex(x) + 2)
	local before = ctx.Engine:MidAt(1, x - 1)
	local ids = ctx.Director:AddExternal({
		Id = "selftest1",
		Kind = "Crash",
		Scope = "All",
		Strength = 0.3,
		Ramp = 60,
		Decay = 600,
		StartTick = x,
		Until = x + 660,
		By = 0,
		Warn = 0,
	}, false)
	eq(#ids, 36, "alle 36 Firmen betroffen")
	local low = ctx.Engine:MidAt(1, x + 60)
	assert(low < before * 0.85, "Crash wirkt nach der Rampe")
	local back = ctx.Engine:MidAt(1, x + 700)
	assert(math.abs(math.log(back / before)) < 0.12, "klingt zum Modellkurs zurück")
	assert((ctx.Director:Halted(1, x + 5)), "10-s-Handelspause bei Aktivierung")
	assert(not (ctx.Director:Halted(1, x + 30)), "Pause vorbei")
	local windows = ctx.Director:Windows()
	assert(#windows == 1 and windows[1][2] >= x + 660 + 600, "Admin-Fenster bis +10 min nach Abklingen")
	-- Normalisieren blendet eine laufende Rallye über 60 s aus
	local y = x + 3000
	ctx.Director:AddExternal({
		Id = "selftest2",
		Kind = "Rally",
		Scope = "All",
		Strength = 0.4,
		Ramp = 60,
		Decay = 1800,
		StartTick = y,
		Until = y + 1860,
		By = 0,
		Warn = 0,
	}, false)
	local model = context(services)
	build(model, MarketClock.DayIndex(y) + 2)
	ctx.Director:AddExternal({
		Id = "selftest3",
		Kind = "Normalize",
		Scope = "All",
		Strength = 0,
		Ramp = 1,
		Decay = 1,
		StartTick = y + 100,
		Until = y + 160,
		By = 0,
	}, false)
	eq(ctx.Engine:MidAt(1, y + 200), model.Engine:MidAt(1, y + 200), "nach Normalisieren = Modellkurs")
end

Tests["Markt: Config & Lang vollständig"] = function()
	local errors = {}
	for _, name in ipairs({ "Market", "Companies", "News" }) do
		local child = (Config :: any)[name]
		for _, message in ipairs(child.Validate(Config)) do
			table.insert(errors, message)
		end
	end
	assert(#errors == 0, table.concat(errors, " | "))
	local missing = {}
	local function walk(value: any, depth: number)
		if depth > 5 then
			return
		end
		if type(value) == "string" and string.sub(value, 1, 5) == "news." then
			if not Lang.Has(value) then
				table.insert(missing, value)
			end
		elseif type(value) == "table" then
			for _, child in pairs(value) do
				walk(child, depth + 1)
			end
		end
	end
	walk(Config.News, 0)
	assert(#missing == 0, "Lang fehlt: " .. table.concat(missing, ", "))
	for _, key in ipairs({ "mkt.invalid", "mkt.unknownInst", "mkt.notReady", "mkt.admin.ok", "mkt.cal.Earnings" }) do
		assert(Lang.Has(key), "Lang fehlt: " .. key)
	end
end

Tests["Markt: Live-Markt läuft (Frame, Quote, Kalender, Request-Form)"] = function(services)
	local svc = market(services)
	local waited = 0
	while not svc.IsReady() and waited < 20 do
		task.wait(0.5)
		waited += 0.5
	end
	assert(svc.IsReady(), "Markt nach 20 s nicht bereit")
	local t0 = svc.Tick()
	task.wait(2.2)
	assert(svc.Tick() > t0, "Markt-Tick läuft")
	local bid, ask, mid = svc.Quote(1)
	assert(bid and ask and mid and bid < ask and bid <= mid and mid <= ask, "Quote plausibel")
	eq(svc.PriceAt(1, svc.Tick()), mid, "PriceAt(jetzt) == Quote-mid")
	assert(svc.PriceAt(1, svc.Tick() + 1000) == mid, "Zukunft wird auf jetzt begrenzt")
	local ids = svc.ActiveIds()
	assert(#ids >= 43, "mindestens 43 aktive Instrumente")
	assert(type(svc.Calendar(3)) == "table", "Kalender")
	assert(#svc.RecentNews(50) <= 50, "News-Liste endlich")
	local stats = svc.Stats()
	assert(type(stats.TickMs) == "number" and type(stats.BusOk) == "boolean", "Stats-Form")
	assert(svc.Instrument(250) and svc.Instrument(250).Set == "Tutorial", "ACAD bekannt")
	assert(not table.find(ids, 250), "ACAD nie im Frame")
	-- Service-Cursor hat die Form, die CandleStore (Backfill/Rebuild) und CatchUp brauchen: Full + LastMid + Candle
	local tc = svc.Tick() - 120
	local cursor = svc.NewCursor(1, tc)
	assert(type(cursor.Full) == "function" and type(cursor.LastMid) == "number", "NewCursor: Full + LastMid")
	local o, h, l, c, v = cursor:Full(tc)
	assert(type(v) == "number" and c > 0 and l <= math.min(o, c) and h >= math.max(o, c), "NewCursor:Full plausibel")
	eq(cursor.LastMid, c, "LastMid = Schluss des letzten Ticks")
	local ro, rh, rl, rc = svc.Candle1s(1, tc + 1)
	local co, ch, cl, cc = cursor:Candle(tc + 1)
	assert(ro == co and rh == ch and rl == cl and rc == cc, "Cursor-Kerze == Candle1s (Random-Access)")
end

Tests["Markt: OnTick(t) sieht Tick t (Kerze, Dividenden, Pause)"] = function(services)
	local svc = market(services)
	local waited = 0
	while not svc.IsReady() and waited < 20 do
		task.wait(0.5)
		waited += 0.5
	end
	assert(svc.IsReady(), "Markt nach 20 s nicht bereit")
	local result: Plain? = nil
	svc.OnTick(function(t: number)
		if result ~= nil then
			return -- Callback bleibt registriert; nur der erste Tick wird geprüft
		end
		local _, _, _, close = svc.Candle1s(1, t)
		local _, _, mid = svc.Quote(1)
		result = { Tick = svc.Tick(), T = t, Close = close, Mid = mid, Halted = svc.IsHalted(1, t) }
	end)
	local guard = 0
	while result == nil and guard < 40 do
		task.wait(0.1)
		guard += 1
	end
	local r = result :: Plain
	assert(r ~= nil, "OnTick feuert")
	eq(r.Tick, r.T, "Tick() == t im Callback")
	assert(r.Close ~= nil and r.Close == r.Mid, "Candle1s(i, t) im Callback = Kerze von t (Schluss == Quote-mid)")
	assert(type(r.Halted) == "boolean", "IsHalted(i, t)")
end

return Tests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">OrderTests</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Selbsttests Orders, Depot, Bots (Server/Tests/OrderTests)
--  Besitzer: WP4 (Orders, Depot, Bots). Vertrag: DESIGN.md §D WP4 "Abnahme"/"Tests", §C17 (Depot-Invarianten,
--  Offline == Online, Gewinn-Transfer-Regeln). SelfTestService lädt dieses Modul; jeder Fehler = FAIL.
--  Alle Tests laufen gegen einen künstlichen, deterministischen Markt (keine Abhängigkeit von der echten Engine,
--  keine Spieler) und schreiben NIE in echte Spielstände. Engine-Caches bleiben unberührt (CacheBefore = −∞).
--
--  Prüft: Trichter-Gründe (Whitelist), Kaufen + Sofortverkauf ≤ 0, Cash nie negativ, Reservierungen 0 nach Storno,
--  OCO storniert die Gegenseite, Trigger-Lücken, Pfad-Regel, Nachzieh-Stopp ohne Zukunftsblick, Ablauf, Dividenden-
--  Ex-Tick, Gewinn-Transfer (Schwelle 1,02, Limit 6 %, 1× je Börsentag, Starthilfe/Admin nicht abhebbar, Tutorial-
--  Ausnahme), Offline == Online (gleiche Fills, gleiche Ticks), Bot-Deckel, Tagesbremse, Seq-Fenster rückt bei
--  Ablehnung vor, Token-Bucket 6/1,5, Depot-Reparatur, Liga-Statistik, ACAD-Pfad.
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Config = require(Shared:WaitForChild("Config"))
local MarketFolder = script.Parent.Parent:WaitForChild("Market")
local Portfolio = require(MarketFolder:WaitForChild("Portfolio"))
local OrderEngine = require(MarketFolder:WaitForChild("OrderEngine"))
local BotEngine = require(MarketFolder:WaitForChild("BotEngine"))
local CatchUp = require(MarketFolder:WaitForChild("CatchUp"))
local PortfolioMath = require(Shared:WaitForChild("Market"):WaitForChild("PortfolioMath"))

local DAY = 1200

local function eq(actual: any, expected: any, label: string?)
	if actual ~= expected then
		error(("%s erwartet %s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function truthy(value: any, label: string)
	if not value then
		error(label, 2)
	end
end

local function orderService(services: any): any
	local svc = services and services.OrderService
	if svc then
		return svc
	end
	local module = script.Parent.Parent:WaitForChild("Services"):FindFirstChild("OrderService")
	assert(module and module:IsA("ModuleScript"), "OrderService fehlt")
	return require(module) :: any
end

-- ---------------------------------------------------------------------
-- Künstlicher Markt (deterministisch, ohne Zufall)
-- ---------------------------------------------------------------------
local BASE: { [number]: number } = { [1] = 24000, [2] = 18000, [5] = 8800, [7] = 6400, [40] = 10000, [41] = 9000 }

local function midAt(i: number, t: number): number
	local b = BASE[i] or 10000
	local x = b
		* (1 + 0.04 * math.sin(t / 53 + i) + 0.015 * math.sin(t / 9.7 + 2 * i) + 0.006 * math.sin(t / 2.3 + 3 * i))
	return math.floor(x + 0.5)
end

local function candleAt(i: number, t: number): (number, number, number, number)
	local o, c = midAt(i, t - 1), midAt(i, t)
	local wick = math.floor(math.abs(math.sin(t * 1.7 + i)) * 0.0008 * c + 0.5)
	return o, math.max(o, c) + wick, math.min(o, c) - wick, c
end

local function cursorFor(i: number, _t0: number): any
	return {
		Candle = function(_self: any, t: number): (number, number, number, number)
			return candleAt(i, t)
		end,
		Seek = function(_self: any, _t: number) end,
	}
end

local function fallbackLicence(idx: number): any
	local svc = orderService(nil)
	local list = Config.Trading.LicenceFallback
	return svc._Test.NormalizeLicence(list[idx], idx, 1)
end

local function newDepot(cash: number): { [string]: any }
	return {
		V = 1,
		Cash = cash,
		Basis = cash,
		Pos = {},
		Short = {},
		Orders = {},
		Alerts = {},
		Watch = { {} },
		Fills = {},
		Nav = {},
		Seq = {},
		NextId = 1,
		LastTick = 0,
		LastTransferDay = -1,
		LastRefillUtcDay = -1,
		AutoTransfer = true,
		Bots = {},
		Stats = {
			Trades = 0,
			Wins = 0,
			Losses = 0,
			GrossWin = 0,
			GrossLoss = 0,
			PeakNav = 0,
			MaxDD = 0,
			BestPct = 0,
			ReadWell = 0,
		},
		Tutorial = { T0 = 0, Q = 0, Done = false },
		Lic = 1,
		Pending = 0,
	}
end

type TestEnv = { [string]: any }

local function makeEnv(opts: { [string]: any }?): (TestEnv, { { any } })
	local o = opts or {}
	local events: { { any } } = {}
	local priceFn = o.PriceAt or midAt
	local env: TestEnv = {
		Mode = o.Mode or "Replay",
		Licence = fallbackLicence(o.Licence or 7),
		Perks = { BotSlots = 4, BotLevels = o.BotLevels or {}, Alerts = 18, Watchlists = 5 },
		PriceAt = function(i: number, t: number): number?
			return priceFn(i, t)
		end,
		Quote = o.Quote,
		Class = function(i: number): string?
			return if i >= 40 and i <= 46 then "ETF" else "Normal"
		end,
		Set = function(i: number): string?
			return if i == 41 then "Trader" else "Azubi"
		end,
		DivBps = function(i: number): number
			return if i == 2 then 40 elseif i == 5 then 30 else 0
		end,
		Listed = function(i: number): boolean
			return BASE[i] ~= nil
		end,
		Halted = function(_i: number): boolean
			return false
		end,
		FactDir = function(_i: number, _t: number): number?
			return o.FactDir
		end,
		AdminActive = function(_t: number): boolean
			return o.Admin == true
		end,
		AdminBetween = function(_t0: number, _t1: number): boolean
			return o.Admin == true
		end,
		Dividends = function(t0: number, t1: number): { any }
			local list = {}
			for _, div in ipairs(o.Divs or {}) do
				if div.Tick >= t0 and div.Tick <= t1 then
					table.insert(list, div)
				end
			end
			return list
		end,
		Emit = function(kind: string, data: any)
			table.insert(events, { kind, data })
		end,
		League = { Week = 0, Returns = {}, Trades = 0, Days = 0, Tainted = false },
		Week = function(t: number): number
			return 1 + t // 604800
		end,
		OwnerTaint = false,
		CacheBefore = -math.huge, -- Tests füllen nie die server-weiten Caches
		Watch = o.Watch or {},
		ActiveIds = function(): { number }
			return { 1, 2, 5, 7, 40, 41 }
		end,
	}
	return env, events
end

local function countKind(events: { { any } }, kind: string): number
	local n = 0
	for _, e in ipairs(events) do
		if e[1] == kind then
			n += 1
		end
	end
	return n
end

local function lastOf(events: { { any } }, kind: string): any
	for index = #events, 1, -1 do
		if events[index][1] == kind then
			return events[index][2]
		end
	end
	return nil
end

-- konstanter Kurs (für exakte Trigger-Fälle): hs = max(1, round(10000 · 8 / 10.000) // 2) = 4
local function flat(_i: number, _t: number): number
	return 10000
end

local function addPosition(d: { [string]: any }, i: number, q: number, cost: number, t: number)
	d.Pos[tostring(i)] = { Q = q, C = cost, R = 0, T = t, F = 0 }
end

local Tests = {}

-- ---------------------------------------------------------------------
-- 1) Trichter & Invarianten
-- ---------------------------------------------------------------------
function Tests.FunnelReasonsWhitelist()
	local want = {
		"Start",
		"Licence",
		"Refill",
		"Trade",
		"Fee",
		"Dividend",
		"BotWage",
		"Transfer",
		"Admin",
		"Tutorial",
		"Migration",
	}
	local count = 0
	for _ in pairs(Portfolio.REASONS) do
		count += 1
	end
	eq(count, #want, "Anzahl Gründe")
	for _, reason in ipairs(want) do
		truthy(Portfolio.REASONS[reason], "Grund fehlt: " .. reason)
	end
	local d = newDepot(1000)
	eq(Portfolio.Credit(d, 50, "Robux"), false, "unbekannter Grund abgelehnt")
	eq(Portfolio.Credit(d, 1.5, "Trade"), false, "kein Bruch-Cent")
	eq(Portfolio.Debit(d, 2000, "Trade"), false, "nie unter 0")
	eq(d.Cash, 1000, "Cash unverändert")
	Portfolio.OpenDay(d, 5, 1000, false)
	truthy(Portfolio.Credit(d, 500, "Admin"), "Admin-Gabe")
	eq(d.Basis, 1500, "Admin erhöht die Basis mit")
	truthy(Portfolio.Credit(d, 300, "Refill"), "Starthilfe")
	eq(d.Basis, 1500, "Starthilfe erhöht die Basis nicht")
	truthy(Portfolio.Debit(d, 200, "Transfer"), "Transfer")
	eq((Portfolio.CurrentDay(d) :: any)[4], 600, "Fluss F = +500 + 300 − 200")
	truthy(Portfolio.Debit(d, 99999, "Licence"), "Herabstufung (Admin)")
	eq(d.Cash, 0, "Cash höchstens bis 0")
	eq(d.Basis, 0, "Basis sinkt voll")
end

function Tests.BuySellRoundTripNeverPositive()
	local env = makeEnv()
	local t = 1200 * 50 + 30
	for n = 1, 200 do
		local d = newDepot(50000000)
		local i = ({ 1, 2, 5, 7 })[(n % 4) + 1]
		local bid, ask = OrderEngine.EngineQuote(env :: any, i, t + n)
		local qty = 1 + (n * 37) % 400
		local ok = Portfolio.Buy(d, i, qty, ask :: number, env.Licence.FeeBps, nil, { Tick = t })
		truthy(ok, "Kauf " .. n)
		local okSell = Portfolio.Sell(d, i, qty, bid :: number, env.Licence.FeeBps, nil, { Tick = t + 1 })
		truthy(okSell, "Verkauf " .. n)
		truthy(d.Cash <= 50000000, ("Fall %d: Geld aus dem Nichts (%d)"):format(n, d.Cash - 50000000))
		truthy(d.Cash >= 0, "Cash ≥ 0")
		eq(d.Pos[tostring(i)], nil, "Position leer")
	end
end

-- Nachkauf zieht den Eröffnungs-Tick mengengewichtet nach: "1 Stück lange halten, dann groß nachkaufen und sofort
-- verkaufen" zählt NICHT als ≥ 60 s gehalten (Liga/XP/"Gut gelesen")
function Tests.AddToPositionHoldTimeWeighted()
	local env = makeEnv()
	local d = newDepot(50000000)
	local t = 1200 * 60
	local _, ask = OrderEngine.EngineQuote(env :: any, 1, t)
	truthy(Portfolio.Buy(d, 1, 1, ask :: number, env.Licence.FeeBps, nil, { Tick = t }), "1 Stück")
	truthy(Portfolio.Buy(d, 1, 99, ask :: number, env.Licence.FeeBps, nil, { Tick = t + 600 }), "99 nachgekauft")
	eq(d.Pos["1"].T, t + 594, "Eröffnungs-Tick mengengewichtet (1 × t + 99 × (t + 600)) / 100")
	local bid = OrderEngine.EngineQuote(env :: any, 1, t + 601)
	local ok, info = Portfolio.Sell(d, 1, 100, bid :: number, env.Licence.FeeBps, nil, { Tick = t + 601 })
	truthy(ok, "Verkauf")
	eq(info.HeldS, 7, "Haltedauer zählt ab dem gewichteten Einstieg")
end

function Tests.ReservationsZeroAfterCancelCashNeverNegative()
	local env = makeEnv({ Licence = 4 })
	local d = newDepot(2500000)
	local t = 1200 * 80 + 100
	local placed = {}
	for k = 1, 20 do
		local mid = midAt(1, t)
		local result = OrderEngine.Place(d, env :: any, t, {
			I = 1,
			Side = "B",
			Type = "LMT",
			Qty = 10,
			Lim = math.floor(mid * (0.9 + k * 0.001)),
		})
		if result.Ok then
			table.insert(placed, result.OrderId)
		end
		truthy(Portfolio.Reserved(d) <= d.Cash, "Reservierung ≤ Cash")
	end
	truthy(#placed >= 1, "mindestens eine Order")
	truthy(#placed < 20, "Lizenz-/Geld-Grenze greift")
	for _, id in ipairs(placed) do
		truthy(OrderEngine.Cancel(d, id), "Storno")
	end
	eq(Portfolio.Reserved(d), 0, "Reservierungen nach Storno")
	eq(d.Cash, 2500000, "Cash unverändert")
	eq(#d.Orders, 0, "keine Orders")
end

-- ---------------------------------------------------------------------
-- 2) Trigger (MARKET §11.3)
-- ---------------------------------------------------------------------
function Tests.TriggerGaps()
	local env, events = makeEnv({ PriceAt = flat })
	local t = 1200 * 10 + 61
	-- Verlust-Stopp mit Kurslücke: Ausführung schlechter als der Stopp
	local d = newDepot(1000000)
	addPosition(d, 1, 10, 100000, t - 100)
	table.insert(
		d.Orders,
		{ Id = 1, I = 1, Side = "S", Type = "STP", Q = 10, Stp = 9500, Res = 0, Exp = t + 999, T0 = t - 5 }
	)
	d.NextId = 2
	OrderEngine.CheckInstrument(d, env :: any, 1, t, 9300, 9350, 9200, 9250)
	local fill = lastOf(events, "Fill")
	truthy(fill, "Stopp ausgelöst")
	eq(fill.Fill.Px, 9296, "Lücke: O − hs")
	eq(fill.Gap, true, "Lücken-Hinweis")
	eq(#d.Orders, 0, "Order weg")
	-- Kauf-Limit mit Lücke nach unten: besser als das Limit
	local d2 = newDepot(1000000)
	local res = PortfolioMath.BuyCost(10, 9800, env.Licence.FeeBps)
	table.insert(
		d2.Orders,
		{ Id = 1, I = 1, Side = "B", Type = "LMT", Q = 10, Lim = 9800, Res = res, Exp = t + 999, T0 = t - 5 }
	)
	OrderEngine.CheckInstrument(d2, env :: any, 1, t, 9500, 9550, 9400, 9450)
	local fill2 = lastOf(events, "Fill")
	eq(fill2.Fill.Px, 9504, "Lücke: min(Limit, O + hs)")
	eq(Portfolio.Reserved(d2), 0, "Reservierung frei")
	eq(d2.Cash, 1000000 - PortfolioMath.BuyCost(10, 9504, env.Licence.FeeBps), "genau die Kosten")
	-- Order aus demselben Tick löst nicht aus (gilt ab Tick nach Erstellung)
	local d3 = newDepot(1000000)
	addPosition(d3, 1, 10, 100000, t - 100)
	table.insert(
		d3.Orders,
		{ Id = 1, I = 1, Side = "S", Type = "STP", Q = 10, Stp = 9500, Res = 0, Exp = t + 999, T0 = t }
	)
	OrderEngine.CheckInstrument(d3, env :: any, 1, t, 9300, 9350, 9200, 9250)
	eq(#d3.Orders, 1, "T0 == t löst nicht aus")
end

function Tests.OcoPathRuleCancelsOtherSide()
	local env, events = makeEnv({ PriceAt = flat })
	local t = 1200 * 10 + 61
	local function setup(): { [string]: any }
		local d = newDepot(0)
		addPosition(d, 1, 10, 100000, t - 100)
		table.insert(d.Orders, {
			Id = 7,
			I = 1,
			Side = "S",
			Type = "OCO",
			Q = 10,
			Stp = 9500,
			Tp = 10500,
			Res = 0,
			Exp = t + 999,
			T0 = t - 5,
		})
		return d
	end
	-- steigende Kerze O→L→H→C: Stopp zuerst
	local up = setup()
	OrderEngine.CheckInstrument(up, env :: any, 1, t, 10000, 10600, 9400, 10100)
	local a = lastOf(events, "Fill")
	eq(a.Kind, "OcoStop", "steigend: Stopp zuerst")
	eq(a.Fill.Px, 9500, "Stopp-Preis")
	eq(#up.Orders, 0, "Gegenseite storniert (ein Datensatz)")
	eq(countKind(events, "Fill"), 1, "genau ein Fill")
	-- fallende Kerze O→H→L→C: Ziel zuerst
	local down = setup()
	OrderEngine.CheckInstrument(down, env :: any, 1, t, 10000, 10600, 9400, 9900)
	local b = lastOf(events, "Fill")
	eq(b.Kind, "OcoTarget", "fallend: Ziel zuerst")
	eq(b.Fill.Px, 10500, "Ziel-Preis")
	eq(countKind(events, "Fill"), 2, "wieder genau ein Fill")
	eq(Portfolio.PosQty(down, 1), 0, "Position verkauft")
end

function Tests.TrailingStopNoLookAhead()
	local env, events = makeEnv({ PriceAt = flat })
	local t = 1200 * 10 + 61
	local d = newDepot(0)
	addPosition(d, 1, 10, 100000, t - 100)
	table.insert(
		d.Orders,
		{ Id = 1, I = 1, Side = "S", Type = "TRL", Q = 10, Trl = 500, Peak = 10000, Res = 0, Exp = t + 999, T0 = t - 5 }
	)
	-- Kerze 1: neues Hoch 11.000, Tief 9.600. Alter Stopp 9.500 -> keine Auslösung, auch wenn der neue Stopp
	-- (10.446) im selben Tief läge (das wäre ein Blick in die Zukunft).
	OrderEngine.CheckInstrument(d, env :: any, 1, t, 10000, 11000, 9600, 10500)
	eq(countKind(events, "Fill"), 0, "keine Auslösung in Kerze 1")
	eq(d.Orders[1].Peak, 10996, "Peak = H − hs nach der Prüfung")
	OrderEngine.CheckInstrument(d, env :: any, 1, t + 1, 10500, 10600, 10400, 10450)
	local fill = lastOf(events, "Fill")
	truthy(fill, "Kerze 2 löst aus")
	eq(fill.Kind, "Trail", "Nachzieh-Stopp")
	eq(fill.Fill.Px, 10446, "Stopp = floor(10.996 · 0,95)")
end

function Tests.ExpiryDayAnd24h()
	local env, events = makeEnv()
	local t = 1200 * 30 + 500
	local d = newDepot(5000000)
	local a = OrderEngine.Place(
		d,
		env :: any,
		t,
		{ I = 1, Side = "B", Type = "LMT", Qty = 1, Lim = midAt(1, t) - 500, Exp = "DAY" }
	)
	local b = OrderEngine.Place(d, env :: any, t, { I = 1, Side = "B", Type = "LMT", Qty = 1, Lim = midAt(1, t) - 500 })
	truthy(a.Ok and b.Ok, "beide gesetzt")
	eq(d.Orders[1].Exp, 1200 * 31, "DAY = nächste Glocke")
	eq(d.Orders[2].Exp, t + 86400, "24 h")
	OrderEngine.Expire(d, env :: any, 1200 * 31)
	eq(#d.Orders, 1, "DAY abgelaufen")
	eq(countKind(events, "Expired"), 1, "Meldung")
	eq(Portfolio.Reserved(d), d.Orders[1].Res, "nur noch eine Reservierung")
end

function Tests.DividendExTick()
	local env, events = makeEnv()
	local d = newDepot(0)
	addPosition(d, 2, 40, 720000, 0)
	OrderEngine.PayDividends(
		d,
		env :: any,
		5000,
		{ { I = 2, Tick = 4999, Cents = 50 }, { I = 2, Tick = 5000, Cents = 50 } }
	)
	eq(d.Cash, 2000, "nur der Ex-Tick zählt: 40 × 50")
	eq(countKind(events, "Dividend"), 1, "eine Meldung")
	OrderEngine.PayDividends(d, env :: any, 5000, { { I = 5, Tick = 5000, Cents = 50 } })
	eq(d.Cash, 2000, "ohne Bestand keine Dividende")
end

-- ---------------------------------------------------------------------
-- 3) Gewinn-Transfer & Rettungsschirm (§B8.2, §B8.4)
-- ---------------------------------------------------------------------
function Tests.TransferRules()
	local env, events = makeEnv()
	local basis = 2500000
	local d = newDepot(basis)
	-- unter 1,02 × Basis: nichts
	eq((OrderEngine.TransferAmount(d, env :: any, 2549999)), 0, "Schwelle")
	-- 6-%-Deckel
	Portfolio.Credit(d, 1000000, "Trade")
	eq((OrderEngine.TransferAmount(d, env :: any, 3500000)), 150000, "6 % der Basis")
	-- Glocke: genau einmal je Börsentag, Betrag wartet in Pending
	local t = 1200 * 40
	Portfolio.OpenDay(d, 39, 3500000, false)
	OrderEngine.CloseDay(d, env :: any, t)
	local transfer = lastOf(events, "Transfer")
	truthy(transfer, "Auto-Transfer an der Glocke")
	eq(d.LastTransferDay, 39, "für den beendeten Tag")
	local pending = d.Pending
	truthy(pending > 0 and pending <= 150000, "Betrag im Pending")
	local before = countKind(events, "Transfer")
	OrderEngine.CloseDay(d, env :: any, t) -- gleicher Tag nochmal (z. B. doppelter Aufruf)
	eq(countKind(events, "Transfer"), before, "kein zweiter Transfer für denselben Tag")
	-- Admin-Gabe ist nie abhebbar (Basis steigt mit)
	local d2 = newDepot(basis)
	local navBefore = d2.Cash
	Portfolio.Credit(d2, 5000000, "Admin")
	eq((OrderEngine.TransferAmount(d2, env :: any, navBefore + 5000000)), 0, "Admin-AKY nicht abhebbar")
	-- Starthilfe ist nie abhebbar
	local d3 = newDepot(basis)
	Portfolio.Debit(d3, basis, "Trade")
	Portfolio.Credit(d3, basis // 2, "Refill")
	eq((OrderEngine.TransferAmount(d3, env :: any, basis // 2)), 0, "Starthilfe nicht abhebbar")
	-- Tutorial-Ausnahme: erster Transfer nach der Übung ohne 2-%-Schwelle
	local d4 = newDepot(basis)
	Portfolio.Credit(d4, 37500, "Tutorial")
	d4.Tutorial.Done = true
	eq((OrderEngine.TransferAmount(d4, env :: any, basis + 37500)), 37500, "Tutorial-Ausnahme")
	d4.LastTransferDay = 3
	eq((OrderEngine.TransferAmount(d4, env :: any, basis + 37500)), 0, "nur beim ersten Transfer")
end

function Tests.AutoTransferOffNoPending()
	local env = makeEnv()
	local d = newDepot(2500000)
	Portfolio.Credit(d, 1000000, "Trade")
	d.AutoTransfer = false
	Portfolio.OpenDay(d, 39, 3500000, false)
	OrderEngine.CloseDay(d, env :: any, 1200 * 40)
	eq(d.Pending, 0, "Auto-Transfer aus")
	eq(d.LastTransferDay, -1, "Tag bleibt frei für den Knopf")
end

-- ---------------------------------------------------------------------
-- 4) Offline == Online (gleiche Fills, gleiche Ticks) inkl. Bots, Dividenden, Glocken
-- ---------------------------------------------------------------------
local function prepareScenario(t0: number): ({ [string]: any }, { any })
	local divs = { { I = 2, Tick = t0 + 1500, Cents = 50 }, { I = 5, Tick = t0 + 4100, Cents = 30 } }
	local env = makeEnv({ Licence = 7, Divs = divs, Watch = { 1, 5, 7 } })
	local d = newDepot(40000000)
	d.Lic = 7
	d.LastTick = t0
	Portfolio.OpenDay(d, t0 // DAY, d.Cash, false)
	local function place(req: { [string]: any })
		local result = OrderEngine.Place(d, env :: any, t0, req)
		assert(result.Ok, "Szenario-Order: " .. tostring(result.Key))
	end
	local m1, m5, m7 = midAt(1, t0), midAt(5, t0), midAt(7, t0)
	place({ I = 1, Side = "B", Type = "LMT", Qty = 50, Lim = math.floor(m1 * 0.97) })
	place({ I = 5, Side = "B", Type = "LMT", Qty = 80, Lim = math.floor(m5 * 0.99), Protect = true })
	place({ I = 7, Side = "B", Type = "MKT", Qty = 200 })
	place({ I = 7, Side = "S", Type = "STP", Qty = 100, Stp = math.floor(m7 * 0.975) })
	place({ I = 7, Side = "S", Type = "TRL", Qty = 100, Trl = 150 })
	place({ I = 2, Side = "B", Type = "MKT", Qty = 100 })
	place({
		I = 2,
		Side = "S",
		Type = "OCO",
		Qty = 100,
		Stp = math.floor(midAt(2, t0) * 0.96),
		Tp = math.floor(midAt(2, t0) * 1.03),
	})
	place({ I = 1, Side = "B", Type = "STP", Qty = 20, Stp = math.floor(m1 * 1.02) })
	table.insert(d.Alerts, { Id = 900, I = 1, Px = math.floor(m1 * 1.03), Dir = "Up" })
	table.insert(d.Alerts, { Id = 901, I = 5, Px = math.floor(m5 * 0.96), Dir = "Down" })
	d.Bots[1] = BotEngine.NewSlot("Sparplan", 0.10, 40)
	d.Bots[2] = BotEngine.NewSlot("Trend", 0.10, 1)
	d.Bots[3] = BotEngine.NewSlot("Dip", 0.03, nil)
	d.Watch[1] = { 1, 5, 7 }
	return d, divs
end

function Tests.OfflineEqualsOnline()
	local t0 = 1200 * 200 + 900
	local t1 = t0 + 7200 -- 2 h, 6 Glocken
	local base, divs = prepareScenario(t0)
	local online = Util.DeepCopy(base)
	local offline = Util.DeepCopy(base)

	-- online: Tick für Tick
	-- Modus "Replay" auch online: Tests schreiben nie in die server-weiten Spread-Caches
	local envOn, eventsOn = makeEnv({ Licence = 7, Divs = divs, Watch = { 1, 5, 7 } })
	envOn.League = { Week = 0, Returns = {}, Trades = 0, Days = 0, Tainted = false }
	for t = t0 + 1, t1 do
		local divsAt = nil
		for _, div in ipairs(divs) do
			if div.Tick == t then
				divsAt = divs
			end
		end
		OrderEngine.Step(online, envOn :: any, t, {
			Candle = function(i: number): (number?, number?, number?, number?)
				return candleAt(i, t)
			end,
			Divs = divsAt,
		})
	end

	-- offline: Abgleich mit Minuten-Überspringen
	local envOff, eventsOff = makeEnv({ Licence = 7, Divs = divs, Watch = { 1, 5, 7 } })
	envOff.League = { Week = 0, Returns = {}, Trades = 0, Days = 0, Tainted = false }
	local report = CatchUp.Run(offline, envOff :: any, t1, { Cursor = cursorFor })

	local fillsOn, fillsOff = {}, {}
	for _, e in ipairs(eventsOn) do
		if e[1] == "Fill" then
			local f = e[2].Fill
			table.insert(fillsOn, ("%d:%d:%s:%d:%d:%d"):format(f.Tick, f.I, f.Side, f.Q, f.Px, f.Fee))
		end
	end
	for _, e in ipairs(eventsOff) do
		if e[1] == "Fill" then
			local f = e[2].Fill
			table.insert(fillsOff, ("%d:%d:%s:%d:%d:%d"):format(f.Tick, f.I, f.Side, f.Q, f.Px, f.Fee))
		end
	end
	truthy(#fillsOn >= 4, "Szenario erzeugt Fills (" .. #fillsOn .. ")")
	eq(#fillsOff, #fillsOn, "gleiche Anzahl Fills")
	for k = 1, #fillsOn do
		eq(fillsOff[k], fillsOn[k], "Fill " .. k)
	end
	eq(report.Fills, #fillsOn, "Bericht zählt die Fills")
	eq(offline.Cash, online.Cash, "Cash")
	eq(offline.LastTick, t1, "Offline bis zum Ziel-Tick")
	eq(online.LastTick, t1, "Online bis zum Ziel-Tick")
	eq(#offline.Orders, #online.Orders, "offene Orders")
	eq(#offline.Alerts, #online.Alerts, "Alarme")
	eq(countKind(eventsOff, "Alert"), countKind(eventsOn, "Alert"), "ausgelöste Alarme")
	eq(countKind(eventsOff, "DayResult"), countKind(eventsOn, "DayResult"), "Börsentage")
	eq(offline.Pending, online.Pending, "Auto-Transfers")
	for key, p in pairs(online.Pos) do
		local q = offline.Pos[key]
		truthy(q, "Position " .. key)
		eq(q.Q, p.Q, "Stück " .. key)
		eq(q.C, p.C, "Einstand " .. key)
	end
	for index, rec in ipairs(online.Nav) do
		for k = 1, 6 do
			eq(offline.Nav[index][k], rec[k], ("Nav[%d][%d]"):format(index, k))
		end
	end
	for index, slot in ipairs(online.Bots) do
		for key, q in pairs(slot.Q) do
			eq(offline.Bots[index].Q[key], q, ("Bot %d Bestand %s"):format(index, key))
		end
	end
	for k, order in ipairs(online.Orders) do
		eq(offline.Orders[k].Id, order.Id, "Order-Id " .. k)
		eq(offline.Orders[k].Peak, order.Peak, "Nachzieh-Peak " .. k)
	end
end

-- Gleicher Vergleich gegen die ECHTE Kurs-Engine (isolierter Test-Kontext von WP3, eigener Seed): Random-Access-
-- Kerzen (online) gegen Cursor-Kerzen (offline). Ohne MarketService (Teil-Build) wird der Test übersprungen.
function Tests.OfflineEqualsOnlineRealEngine(services: any)
	local market = services and services.MarketService
	if not (market and type(market.TestContext) == "function") then
		return
	end
	local Clock = require(Shared:WaitForChild("Clock"))
	local week = 41
	local ctx = market.TestContext(424242, week)
	local t0 = Clock.WeekStartTick(week) + 60 * DAY + 1050
	local t1 = t0 + 1800
	local guard = 0
	while ctx.Director:BuiltThrough() < t1 // DAY + 1 and guard < 400 do
		ctx.Director:EnsureBuilt(t1 // DAY + 1, 16)
		guard += 1
		task.wait()
	end
	local companies = Config.Companies
	local function def(i: number): any
		return companies.ById[i]
	end
	local function baseEnv(): (TestEnv, { { any } })
		local env, events = makeEnv({ Licence = 7, Watch = { 2, 5, 9 } })
		env.PriceAt = function(i: number, t: number): number?
			return ctx.Engine:MidAt(i, t)
		end
		env.Class = function(i: number): string?
			return def(i) and def(i).Class
		end
		env.Set = function(i: number): string?
			return def(i) and def(i).Set
		end
		env.DivBps = function(i: number): number
			return def(i) and def(i).DivBps or 0
		end
		env.Listed = function(i: number): boolean
			return def(i) ~= nil and def(i).Set ~= "Tutorial" and def(i).Ipo ~= true
		end
		env.Dividends = function(a: number, b: number): { any }
			return ctx.Director:Dividends(a, b)
		end
		env.ActiveIds = function(): { number }
			local ids = {}
			for i = 1, 46 do
				if def(i) and def(i).Ipo ~= true then
					table.insert(ids, i)
				end
			end
			return ids
		end
		return env, events
	end
	-- Szenario mit engen Marken (lösen in 30 min sicher aus)
	local envSetup = baseEnv()
	local d = newDepot(80000000)
	d.Lic = 7
	d.LastTick = t0
	Portfolio.OpenDay(d, t0 // DAY, d.Cash, false)
	local function place(req: { [string]: any })
		local result = OrderEngine.Place(d, envSetup :: any, t0, req)
		assert(result.Ok, "Szenario-Order: " .. tostring(result.Key))
	end
	local function mid(i: number): number
		return ctx.Engine:MidAt(i, t0)
	end
	place({ I = 2, Side = "B", Type = "LMT", Qty = 100, Lim = math.floor(mid(2) * 0.998) })
	place({ I = 5, Side = "B", Type = "MKT", Qty = 300 })
	place({ I = 5, Side = "S", Type = "STP", Qty = 150, Stp = math.floor(mid(5) * 0.997) })
	place({ I = 5, Side = "S", Type = "TRL", Qty = 150, Trl = 50 })
	place({ I = 9, Side = "B", Type = "MKT", Qty = 400 })
	place({
		I = 9,
		Side = "S",
		Type = "OCO",
		Qty = 400,
		Stp = math.floor(mid(9) * 0.996),
		Tp = math.ceil(mid(9) * 1.004),
	})
	local _, ask7 = OrderEngine.EngineQuote(envSetup :: any, 7, t0)
	place({ I = 7, Side = "B", Type = "STP", Qty = 50, Stp = math.max(math.ceil(mid(7) * 1.003), (ask7 :: number) + 2) })
	table.insert(d.Alerts, { Id = 950, I = 2, Px = math.ceil(mid(2) * 1.002), Dir = "Up" })
	table.insert(d.Alerts, { Id = 951, I = 40, Px = math.floor(mid(40) * 0.998), Dir = "Down" })
	d.Bots[1] = BotEngine.NewSlot("Sparplan", 0.10, 40)
	d.Bots[2] = BotEngine.NewSlot("Trend", 0.10, 7)
	d.Bots[3] = BotEngine.NewSlot("Dividend", 0.10, nil)
	local online = Util.DeepCopy(d)
	local offline = Util.DeepCopy(d)

	local envOn, eventsOn = baseEnv()
	for t = t0 + 1, t1 do
		local divs = ctx.Director:Dividends(t, t)
		OrderEngine.Step(online, envOn :: any, t, {
			Candle = function(i: number): (number?, number?, number?, number?)
				local o, h, l, c = ctx.Engine:CandleAt(i, t)
				return o, h, l, c
			end,
			Divs = if #divs > 0 then divs else nil,
		})
		if (t - t0) % 300 == 0 then
			task.wait()
		end
	end
	local envOff, eventsOff = baseEnv()
	CatchUp.Run(offline, envOff :: any, t1, {
		Cursor = function(i: number, t: number): any
			return ctx.Engine:NewCursor(i, t)
		end,
		Yield = function()
			task.wait()
		end,
		BudgetMs = 4,
	})
	local function fills(events: { { any } }): { string }
		local out = {}
		for _, e in ipairs(events) do
			if e[1] == "Fill" then
				local f = e[2].Fill
				table.insert(out, ("%d:%d:%s:%d:%d"):format(f.Tick, f.I, f.Side, f.Q, f.Px))
			end
		end
		return out
	end
	local a, b = fills(eventsOn), fills(eventsOff)
	truthy(#a >= 3, "echte Engine erzeugt Fills (" .. #a .. ")")
	eq(#b, #a, "gleiche Anzahl Fills (echte Engine)")
	for k = 1, #a do
		eq(b[k], a[k], "Fill " .. k .. " (echte Engine)")
	end
	eq(offline.Cash, online.Cash, "Cash (echte Engine)")
	eq(#offline.Orders, #online.Orders, "offene Orders (echte Engine)")
	eq(countKind(eventsOff, "Alert"), countKind(eventsOn, "Alert"), "Alarme (echte Engine)")
end

function Tests.CatchUpWindowAndJump()
	local t0 = 1200 * 300
	local d = newDepot(5000000)
	d.LastTick = t0
	local from, winEnd, botsUntil = CatchUp.Window(d, t0 + 200000)
	eq(from, t0 + 1, "ab dem Tick nach dem Verlassen")
	eq(winEnd, t0 + 86400, "Orders 24 h")
	eq(botsUntil, t0 + 43200, "Bots 12 h")
	-- Sprung: nach 24 h ist alles abgelaufen, LastTick landet auf dem Ziel
	local env = makeEnv()
	Portfolio.OpenDay(d, t0 // DAY, d.Cash, false)
	table.insert(
		d.Orders,
		{ Id = 1, I = 1, Side = "S", Type = "TP", Q = 1, Tp = 99999, Res = 0, Exp = t0 + 86400, T0 = t0 }
	)
	addPosition(d, 1, 1, 24000, t0)
	local report = CatchUp.Run(d, env :: any, t0 + 90000, { Cursor = cursorFor })
	eq(d.LastTick, t0 + 90000, "Ziel erreicht")
	eq(#d.Orders, 0, "abgelaufen")
	eq(report.Expired, 1, "Ablauf gezählt")
	eq(report.Jumped, true, "Rest übersprungen")
end

-- ---------------------------------------------------------------------
-- 5) Bots (§B8.5)
-- ---------------------------------------------------------------------
function Tests.BotCapitalCap()
	local env = makeEnv({ BotLevels = { Sparplan = 2 } })
	local slot = BotEngine.NewSlot("Sparplan", 0.20, 40)
	eq(BotEngine.Capital(env :: any, slot), 0.20, "Bot-Stufe 2 -> 20 %")
	local trend = BotEngine.NewSlot("Trend", 0.08, 1)
	eq(BotEngine.Capital(env :: any, trend), 0.08, "Capital-Preset: eingestellter Anteil ≤ Stufe 0 (10 %)")
	local big = BotEngine.NewSlot("Trend", 0.30, 1)
	eq(BotEngine.Capital(env :: any, big), 0.10, "Stufe 0 deckelt auf 10 %")
	-- Sparplan über viele Börsentage: Bot-Wert bleibt unter Kapital × Depotwert
	local d = newDepot(10000000)
	d.Bots[1] = BotEngine.NewSlot("Sparplan", 0.20, 40)
	local envCap = makeEnv({ BotLevels = {} })
	local t = 1200 * 400
	for day = 0, 15 do
		local tt = t + day * DAY
		-- Kursgewinne dürfen den Bot-Wert über den Deckel heben, KÄUFE nie (gleiche Kurse vorher/nachher)
		local before = BotEngine.Value(d, envCap :: any, tt, d.Bots[1])
		BotEngine.Decide(d, envCap :: any, tt)
		local nav = OrderEngine.NavAt(d, envCap :: any, tt)
		local after = BotEngine.Value(d, envCap :: any, tt, d.Bots[1])
		if after > before then
			truthy(
				after <= 0.10 * nav + midAt(40, tt),
				("Tag %d: Kauf über den Deckel (%d > 10 %% von %d)"):format(day, after, nav)
			)
		end
	end
	truthy(Portfolio.PosQty(d, 40) > 0, "Sparplan hat gekauft")
end

function Tests.BotDailyLossBrake()
	local env, events = makeEnv()
	local d = newDepot(10000000)
	local t = 1200 * 500 + 120
	addPosition(d, 1, 100, 2400000, t - 600)
	local slot = BotEngine.NewSlot("Trend", 0.10, 1)
	slot.Q = { ["1"] = 100 }
	slot.Day = t // DAY
	slot.DayNav = 1000000
	slot.DayVal = BotEngine.Value(d, env :: any, t, slot) + 60000 -- heute schon 6 % des Tageskapitals verloren
	slot.DayFlow = 0
	d.Bots[1] = slot
	BotEngine.Decide(d, env :: any, t)
	eq(slot.Paused, true, "Bremse pausiert den Bot")
	eq(countKind(events, "BotPaused"), 1, "Meldung")
	-- nächster Börsentag löst die Bremse
	BotEngine.Decide(d, env :: any, (t // DAY + 1) * DAY)
	eq(slot.Paused, false, "neuer Tag")
end

function Tests.BotWagesNeverFromReserved()
	local env = makeEnv()
	local d = newDepot(1000)
	addPosition(d, 40, 1000, 10000000, 0)
	local slot = BotEngine.NewSlot("Sparplan", 0.1, 40)
	slot.Q = { ["40"] = 1000 }
	d.Bots[1] = slot
	table.insert(
		d.Orders,
		{ Id = 1, I = 1, Side = "B", Type = "LMT", Q = 1, Lim = 900, Res = 1000, Exp = 99999999, T0 = 0 }
	)
	BotEngine.PayWages(d, env :: any, 1200 * 50)
	eq(d.Cash, 1000, "freies Cash 0 -> kein Lohn aus der Reservierung")
	local d2 = newDepot(10000000)
	addPosition(d2, 40, 1000, 10000000, 0)
	d2.Bots[1] = slot
	BotEngine.PayWages(d2, env :: any, 1200 * 50)
	local value = 1000 * (OrderEngine.EngineQuote(env :: any, 40, 1200 * 50) :: number)
	eq(10000000 - d2.Cash, math.ceil(value * 2 / 10000), "0,02 % des verwalteten Kapitals")
end

-- ---------------------------------------------------------------------
-- 6) Anfragen: Seq-Fenster, Bucket
-- ---------------------------------------------------------------------
function Tests.SeqWindowAdvancesOnReject(services: any)
	local seq = orderService(services)._Test.Seq
	local key = {} -- Stellvertreter für einen Spieler
	local d = newDepot(0)
	eq(seq.Duplicate(key, d, 1), nil, "neu")
	seq.Record(key, d, 1)
	seq.Store(key, 1, { Ok = false, Key = "trade.noCash" })
	local again = seq.Duplicate(key, d, 1)
	truthy(again and again.Key == "trade.noCash", "Ablehnung wird wiederholt, Fenster ist vorgerückt")
	for s = 2, 40 do
		seq.Record(key, d, s)
	end
	eq(#d.Seq, Config.Trading.SeqWindow, "Fenster begrenzt")
	eq(seq.Duplicate(key, d, 1), nil, "alte Nummer aus dem Fenster gefallen")
	seq.Clear(key)
end

function Tests.TradePlaceBucketLimitsBurst()
	local now = 0
	local bucket = Util.TokenBucket(6, 1.5, function(): number
		return now
	end)
	local ok = 0
	for _ = 1, 10 do
		if bucket.Take("p") then
			ok += 1
		end
	end
	eq(ok, 6, "10 Orders in einer Sekunde -> 6")
	now = 2
	local later = 0
	for _ = 1, 10 do
		if bucket.Take("p") then
			later += 1
		end
	end
	eq(later, 3, "nach 2 s wieder 3 (1,5/s)")
end

-- ---------------------------------------------------------------------
-- 7) Reparatur, Liga, Übung
-- ---------------------------------------------------------------------
function Tests.SanitizeRepairsWithoutMakingMoney()
	local d: { [string]: any } = newDepot(1000)
	d.Cash = 0 / 0
	d.Pos =
		{ ["1"] = { Q = 5, C = 100, R = 0 }, abc = { Q = 1 }, ["999"] = { Q = 3, C = 1, R = 0 }, ["2"] = { Q = -1 } }
	d.Orders = {
		{ Id = 1, I = 1, Side = "B", Type = "LMT", Q = 1, Lim = 100, Res = 0, Exp = 10, T0 = 1 }, -- ohne Reservierung
		{ Id = 2, I = 1, Side = "S", Type = "STP", Q = 9, Stp = 50, Res = 0, Exp = 10, T0 = 1 }, -- mehr als da
		{ Id = 3, I = 1, Side = "S", Type = "TP", Q = 2, Tp = 150, Res = 0, Exp = 10, T0 = 1 },
		{ Id = 4, I = 1, Side = "X", Type = "LMT", Q = 1 },
	}
	d.LastTick = 1e12
	local issues = Portfolio.Sanitize(d, 5000, function(i: number): boolean
		return i == 1 or i == 2
	end)
	truthy(#issues > 0, "Probleme gemeldet")
	eq(d.Cash, 0, "NaN-Cash -> 0 (nie erfunden)")
	eq(d.Pos["1"].Q, 5, "gültige Position bleibt")
	eq(d.Pos.abc, nil, "kaputter Schlüssel weg")
	eq(d.Pos["999"], nil, "unbekannter Wert weg")
	eq(d.Pos["2"], nil, "negative Menge weg")
	eq(#d.Orders, 1, "nur die gültige Verkaufs-Order bleibt")
	eq(d.Orders[1].Id, 3, "TP bleibt")
	eq(d.LastTick, 5000, "Zukunfts-Tick geklemmt")
	truthy(d.NextId > 3, "NextId über allen Ids")
end

function Tests.LeagueStatsAndRoll()
	local league: { [string]: any } = { Week = 0, Returns = {}, Trades = 0, Days = 0, Tainted = false }
	Portfolio.LeagueRoll(league, 202642)
	for _ = 1, 6 do
		Portfolio.LeagueAddDay(league, 0.01, true)
	end
	for _ = 1, 20 do
		Portfolio.LeagueAddTrade(league)
	end
	local stats = Portfolio.LeagueStats(league, false)
	eq(stats.Qualified, true, "20 Trades + 6 Tage")
	eq(stats.AvgDailyBp, 100, "Ø 1 %")
	truthy(stats.SkillScore >= 850, "konstante Woche -> Diamant-Bereich")
	eq(Portfolio.TierOf(stats.SkillScore, true), "Diamant", "Stufe")
	eq(Portfolio.LeagueStats(league, true).Qualified, false, "Besitzer/Admin ausgenommen")
	league.Tainted = true
	eq(Portfolio.LeagueStats(league, false).Qualified, false, "Taint schließt aus")
	Portfolio.LeagueRoll(league, 202643)
	eq(league.LastWeek, 202642, "Vorwoche gemerkt")
	eq(league.Trades, 0, "neue Woche leer")
	eq(league.Tainted, false, "Taint gilt nur eine Woche")
	eq(Portfolio.TierOf(500, false), "None", "ohne Teilnahme keine Stufe")
end

function Tests.CountingTradeRules()
	local env = makeEnv({ PriceAt = flat })
	local t = 1200 * 70 + 300
	local d = newDepot(1000000)
	Portfolio.OpenDay(d, t // DAY, 1000000, false)
	addPosition(d, 1, 100, 1000000, t - 120) -- 100 × 100 AKY, 120 s gehalten
	local result = OrderEngine.SellNow(d, env :: any, t, 1, 10, 9996, nil, "Market")
	truthy(result.Ok, "Verkauf")
	eq((Portfolio.CurrentDay(d) :: any)[5], 1, "≥ 2 % und ≥ 60 s zählt")
	eq(env.League.Trades, 1, "Liga zählt mit")
	local d2 = newDepot(1000000)
	Portfolio.OpenDay(d2, t // DAY, 1000000, false)
	addPosition(d2, 1, 100, 1000000, t - 10) -- nur 10 s gehalten
	OrderEngine.SellNow(d2, env :: any, t, 1, 10, 9996, nil, "Market")
	eq((Portfolio.CurrentDay(d2) :: any)[5], 0, "zu kurz gehalten zählt nicht")
	local envAdmin = makeEnv({ PriceAt = flat, Admin = true })
	local d3 = newDepot(1000000)
	Portfolio.OpenDay(d3, t // DAY, 1000000, false)
	addPosition(d3, 1, 100, 1000000, t - 120)
	OrderEngine.SellNow(d3, envAdmin :: any, t, 1, 10, 9996, nil, "Market")
	eq((Portfolio.CurrentDay(d3) :: any)[5], 0, "Admin-Fenster zählt nicht")
end

function Tests.AcadTutorialPath(services: any)
	local tutPrice = orderService(services)._Test.TutPrice
	local cfg = Config.Trading.Tutorial
	local p0, phase0 = tutPrice(0)
	truthy(math.abs(p0 - cfg.Start) <= cfg.Start * 0.003, "Start 100 AKY")
	eq(phase0, 0, "vor der News")
	local _, phase1 = tutPrice(5)
	eq(phase1, 1, "Lesefenster (News bei t0 + 2 s, 8 s)")
	local pRead = tutPrice(9)
	truthy(math.abs(pRead - cfg.Start) <= cfg.Start * 0.003, "im Lesefenster noch keine Reaktion")
	local _, phase2 = tutPrice(30)
	eq(phase2, 2, "Rampe")
	local pEnd, phase3 = tutPrice(80)
	eq(phase3, 3, "flach")
	local want = cfg.Start * (1 + cfg.Jump)
	truthy(math.abs(pEnd - want) <= want * 0.003, "+15 % nach der Rampe")
	-- Gewinn bei 10 % von 25.000 AKY ≈ +375 AKY (vor Gebühren)
	local qty = math.floor(0.10 * 2500000 / p0)
	truthy(math.abs(qty * (pEnd - p0) - 37500) <= 2000, "≈ +375 AKY")
end

return Tests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">ProgressionTests</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Selbsttests Fortschritt, Quests, Börsengang, Know-how, Lizenzen (Server/Tests/ProgressionTests)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §D WP9 "Abnahme"/"Tests":
--  Quest-Tracker-Abdeckung (jede Quest-Art hat einen Aufrufer), Börsengang-Erhalt (§B9.6), Know-how-Grenzen,
--  Admin-Lizenz taintet die Liga-Woche, Lizenz-Aufstieg ruft OrderService.SetLicence, Ruf-Deckel/Abbau/Untergrenzen,
--  Quiz-Schlüssel, Quest-Auswahl, Login-Serie, Saison-Rechnung, Vorstand nur Turm/Lifestyle.
--  SelfTestService lädt dieses Modul und ruft jede Funktion mit Services auf; jeder Fehler = FAIL.
--  Arbeitet nur mit Test-Spielständen (Kopien von DataService.DefaultData) und Attrappen – echte Spieler bleiben unberührt.
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local ProgressMath = require(Shared:WaitForChild("ProgressMath")) :: any

local PCFG: any = Config.Progression
local DAY = 86400

local Tests: { [string]: (any) -> () } = {}

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function eq(actual: any, expected: any, label: string?)
	if actual ~= expected then
		error(("%s erwartet %s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function truthy(value: any, label: string)
	if not value then
		error(label, 2)
	end
end

-- rekursiver Vergleich -> (gleich, Pfad der Abweichung)
local function deepEqual(a: any, b: any, path: string, depth: number?): (boolean, string?)
	local level = depth or 0
	if level > 16 then
		return false, path .. " (zu tief)"
	end
	if type(a) ~= type(b) then
		return false, path
	end
	if type(a) ~= "table" then
		if a ~= b and not (a ~= a and b ~= b) then
			return false, path
		end
		return true, nil
	end
	for key, value in pairs(a) do
		local ok, where = deepEqual(value, b[key], path .. "." .. tostring(key), level + 1)
		if not ok then
			return false, where
		end
	end
	for key in pairs(b) do
		if a[key] == nil then
			return false, path .. "." .. tostring(key)
		end
	end
	return true, nil
end

local function serviceModule(services: any, name: string): any
	local svc = services and services[name]
	if svc then
		return svc
	end
	local module = script.Parent.Parent:WaitForChild("Services"):FindFirstChild(name)
	assert(module and module:IsA("ModuleScript"), name .. " fehlt")
	return require(module) :: any
end

local function serviceExists(services: any, name: string): boolean
	if services and services[name] then
		return true
	end
	local folder = script.Parent.Parent:FindFirstChild("Services")
	local module = folder and folder:FindFirstChild(name)
	return module ~= nil and module:IsA("ModuleScript")
end

local function core(services: any): any
	local test = serviceModule(services, "ProgressionService")._Test
	assert(type(test) == "table" and type(test.Core) == "table", "ProgressionService._Test.Core fehlt")
	return test.Core
end

local function rewardTest(services: any): any
	local test = serviceModule(services, "RewardService")._Test
	assert(type(test) == "table" and type(test.Core) == "table", "RewardService._Test fehlt")
	return test
end

-- frischer Test-Spielstand (Kopie von DEFAULT_DATA, Prog repariert)
local function newData(services: any): any
	local data = serviceModule(services, "DataService").DefaultData()
	core(services).Repair(data)
	return data
end

local function copy(value: any): any
	return Util.DeepCopy(value)
end

-- ---------------------------------------------------------------------
-- 1) CONFIG
-- ---------------------------------------------------------------------
Tests["Config: Progression/Season/Rewards prüfen ohne Meldung"] = function()
	for _, name in ipairs({ "Progression", "Season", "Rewards" }) do
		local module = Shared:WaitForChild("Config"):FindFirstChild(name)
		assert(module and module:IsA("ModuleScript"), "Config." .. name .. " fehlt")
		local child = require(module) :: any
		local list = child.Validate(Config)
		if #list > 0 then
			error(table.concat(list, "; "))
		end
	end
	eq(#PCFG.Licences, 10, "10 Lizenzen")
	eq(#PCFG.Academy.Lessons, 16, "16 Lektionen")
	eq(#PCFG.Achievements, 60, "60 Erfolge")
	eq(#PCFG.Badges, 15, "15 Badges")
	eq(#PCFG.Album.Cards, 43, "43 Album-Karten")
	eq(#PCFG.Quests.Daily, 30, "30 Tages-Vorlagen")
	eq(#PCFG.Quests.Weekly, 12, "12 Wochen-Vorlagen")
	eq(#PCFG.Quests.StarterLine, 20, "20 Starter-Schritte")
end

-- ---------------------------------------------------------------------
-- 2) QUEST-TRACKER-ABDECKUNG (Abnahme 5)
-- ---------------------------------------------------------------------
Tests["Quest-Arten: jede Art hat einen Tracker"] = function(services: any)
	local reward = rewardTest(services)
	local internal = reward.InternalKinds
	local missing: { string } = {}
	for _, kind in ipairs(PCFG.QuestKinds) do
		local tracker = kind.Tracker
		if type(tracker) ~= "string" or tracker == "" then
			table.insert(missing, kind.Key .. " (kein Tracker eingetragen)")
		elseif not serviceExists(services, tracker) then
			table.insert(missing, kind.Key .. " (" .. tracker .. " fehlt)")
		elseif tracker == "ProgressionService" or tracker == "CommunityService" then
			-- WP9 meldet selbst: die Art muss im internen Verzeichnis stehen
			if internal[kind.Key] ~= tracker then
				table.insert(missing, kind.Key .. " (" .. tracker .. " meldet sie nicht)")
			end
		end
	end
	if #missing > 0 then
		error("ohne Tracker: " .. table.concat(missing, ", "))
	end
	-- interne Arten sind echte Quest-Arten
	for key in pairs(internal) do
		truthy(PCFG.QuestKindByKey[key] ~= nil, "interne Art ohne Quest-Art: " .. key)
	end
end

Tests["Quest-Vorlagen: nur bekannte Arten/Prüfungen, Ziele > 0"] = function()
	local checks = { Floors = true, Eff = true, Licence = true, Lessons = true, RoomKinds = true, BotOn = true }
	checks.LeagueDays = true
	checks.Wealth = true
	for _, list in ipairs({ PCFG.Quests.Daily, PCFG.Quests.Weekly }) do
		for _, def in ipairs(list) do
			truthy(PCFG.QuestKindByKey[def.Kind] ~= nil, "unbekannte Art " .. tostring(def.Kind) .. " in " .. def.Id)
			truthy(type(def.Goal) == "number" and def.Goal > 0, "Ziel > 0 in " .. def.Id)
		end
	end
	for _, def in ipairs(PCFG.Quests.StarterLine) do
		if def.Check then
			truthy(checks[def.Check] == true, "unbekannte Prüfung " .. tostring(def.Check) .. " in " .. def.Id)
		else
			truthy(PCFG.QuestKindByKey[def.Kind] ~= nil, "unbekannte Art in " .. def.Id)
		end
		truthy(def.Credits > 0 and def.Credits % 1 == 0, "Starter-CR ganzzahlig in " .. def.Id)
	end
	truthy(PCFG.QuestKindByKey[PCFG.Quests.Comeback.Kind] ~= nil, "Aufhol-Quest-Art")
	eq(PCFG.Quests.StarterLine[#PCFG.Quests.StarterLine].Title, "Founder", "Schritt 20: Titel Gründer")
end

Tests["Quest-Auswahl: deterministisch, 3 verschiedene, mind. 1 Handels-/Akademie-Quest"] = function(services: any)
	local c = rewardTest(services).Core
	for userId = 1, 40 do
		for day = 20000, 20010 do
			local a = c.PickDaily(userId * 7919, day)
			local b = c.PickDaily(userId * 7919, day)
			eq(#a, PCFG.Quests.DailyCount, "Anzahl")
			eq(table.concat(a, ","), table.concat(b, ","), "deterministisch")
			local seen: { [string]: boolean } = {}
			local trade = 0
			for _, id in ipairs(a) do
				truthy(not seen[id], "doppelt " .. id)
				seen[id] = true
				if c.IsTradeKind(PCFG.QuestById[id].Kind) then
					trade += 1
				end
			end
			truthy(trade >= PCFG.Quests.MinTradeDaily, "Handels-Garantie verletzt")
			-- Neuwählen ersetzt durch eine neue Vorlage, Garantie bleibt
			local list = {}
			for _, id in ipairs(a) do
				table.insert(list, { Id = id })
			end
			local replaced = c.RerollPick(userId, day, list, a[1])
			truthy(replaced ~= nil and not seen[replaced], "Neuwahl liefert neue Vorlage")
		end
	end
	local weekly = c.PickWeekly(42, 2900)
	eq(#weekly, PCFG.Quests.WeeklyCount, "Wochenquests")
end

Tests["Quest-Fortschritt: Mindestwerte und verschiedene Werte (Distinct)"] = function(services: any)
	local c = rewardTest(services).Core
	local def = { Id = "T", Kind = "NewSector", Goal = 2, Distinct = "Sector" }
	local q = { Id = "T", P = 0, Done = false, Claimed = false, Seen = {} }
	eq((c.Advance(q, def, 1, { Sector = "T" })), true, "erster Sektor")
	eq((c.Advance(q, def, 1, { Sector = "T" })), false, "gleicher Sektor zählt nicht")
	local moved, finished = c.Advance(q, def, 1, { Sector = "E" })
	eq(moved and finished, true, "zweiter Sektor -> fertig")
	eq((c.Advance(q, def, 1, { Sector = "M" })), false, "fertig bleibt fertig")
	local minDef = { Id = "M", Kind = "TradeProfit", Goal = 1, Min = { Pct = 0.05 } }
	local q2 = { Id = "M", P = 0, Done = false, Claimed = false }
	eq((c.Advance(q2, minDef, 1, { Pct = 0.02 })), false, "unter Mindestwert")
	eq((c.Advance(q2, minDef, 1, nil)), false, "ohne Kontext")
	eq((c.Advance(q2, minDef, 1, { Pct = 0.06 })), true, "Mindestwert erreicht")
end

-- ---------------------------------------------------------------------
-- 3) BÖRSENGANG (Abnahme 3)
-- ---------------------------------------------------------------------
local function fakeTowerEnv(balance: number): (any, { [string]: any })
	local account = { Balance = balance, Storage = {} :: { [string]: number } }
	local env = {
		Now = os.time(),
		Licence = 4,
		Ipo = 0,
		Perk = function(_key: string): number
			return 0
		end,
		HasPass = function(_key: string): boolean
			return false
		end,
		Balance = function(): number
			return account.Balance
		end,
		Debit = function(amount: number, _sink: string): boolean
			if amount > account.Balance or amount % 1 ~= 0 then
				return false
			end
			account.Balance -= amount
			return true
		end,
		Credit = function(amount: number, _source: string): boolean
			account.Balance += amount
			return true
		end,
		TakeDecor = function(key: string): boolean
			local n = account.Storage[key] or 0
			if n <= 0 then
				return false
			end
			account.Storage[key] = n - 1
			return true
		end,
		ReturnDecor = function(key: string)
			account.Storage[key] = (account.Storage[key] or 0) + 1
		end,
		Comfort = function(_key: string): number
			return 0
		end,
		Owns = function(_entry: any): boolean
			return true
		end,
		BuildEvent = 1,
		CostEvent = function(_kind: string): number
			return 1
		end,
	}
	return env, account
end

Tests["Börsengang: behält alles laut §B9.6, Sterne-Formel, Vorstand-Blitzstart"] = function(services: any)
	local c = core(services)
	local tower = serviceModule(services, "TowerService")._Test
	assert(type(tower) == "table" and type(tower.Core) == "table", "TowerService._Test.Core fehlt")
	local data = newData(services)
	local prog = data.Prog
	-- Fortschritt, der bleiben muss
	prog.Xp = 30000
	prog.Licence = 7
	prog.Exams = { ProtectPair = true, Sectors3 = true }
	prog.Lessons = { L01 = 2, L02 = 1 }
	prog.KH = { Alerts = 2 }
	prog.Ruf = 200
	prog.Album = { ["1"] = true, ["2"] = true }
	prog.Ach = { T01 = true }
	prog.Titles = { Founder = true }
	prog.Title = "Founder"
	c.Repair(data)
	-- Depot: Standard-Depot aus DataService.DefaultData (Spielstand-Kopie; nur OrderService schreibt echte Depots)
	data.Garage = { Cars = { LamCity = true, VoltaHatch = true }, Active = "VoltaHatch", Tune = {} }
	data.Life = { Watches = { WeekChrono = true }, Accessories = {}, Equipped = {} }
	data.Season = { Id = 1, Xp = 4200, Premium = true, ClaimedFree = { ["2"] = true }, ClaimedPremium = {} }
	data.Login = { LastDay = 20000, Streak = 9, Best = 9, Freeze = 1, FreezeWeek = 0, Cycle = 2, Track = 9 }
	-- Lauf: 30 Etagen, Effizienz, Tresor, Lauf-Ausgaben 1e8
	local t = data.Tower
	table.clear(t.Floors)
	for i = 1, 30 do
		t.Floors[i] = tower.Core.NewFloor()
	end
	t.Eff = 5
	t.Vault = 5000
	t.RunSpend = 1e8
	local keep = {
		ProgNoPrestige = (function()
			local p = copy(prog)
			p.Prestige = nil
			return p
		end)(),
		Depot = copy(data.Depot),
		Garage = copy(data.Garage),
		Life = copy(data.Life),
		Season = copy(data.Season),
		Login = copy(data.Login),
		Purchases = copy(data.Purchases),
	}
	-- 1) Börsengang buchen (WP9)
	local stars = c.ApplyIpo(prog, t.RunSpend, "TEST", 1000)
	eq(stars, ProgressMath.Stars(1e8), "Sterne = floor(4 × log10(1e8 / 1e6))")
	eq(stars, 8, "8 ★ bei 1e8")
	eq(prog.Prestige.Count, 1, "Börsengänge")
	eq(prog.Prestige.Firmenwert, 0.5e8, "Firmenwert += 0,5 × Lauf-Ausgaben")
	eq(prog.Prestige.Tickers[1].T, "TEST", "Ticker gemerkt")
	eq(c.CrownFor(prog.Prestige.Count), "Silver", "Krone nach 1 Börsengang")
	-- Vorstand: Blitzstart 1 kaufen (nur Turm)
	local okPerk = c.BuyPerk(prog, "Blitzstart")
	eq(okPerk, true, "Perk gekauft")
	eq(c.StarsFree(prog), stars - 1, "1 ★ ausgegeben")
	local perks = c.PerkTable(prog)
	eq(perks.Blitzstart, 1, "Perk-Tabelle")
	eq(perks.StartCredits, PCFG.Prestige.StartCredits, "Start-CR")
	-- 2) Turm-Neustart (WP6)
	local env, account = fakeTowerEnv(777777)
	eq(tower.Core.ResetForIpo(data, env, perks), true, "ResetForIpo")
	eq(account.Balance, PCFG.Prestige.StartCredits, "CR startet neu")
	eq(#t.Floors, Config.Tower.Ipo.Blitz[1], "Blitzstart 1 = 4 fertige Etagen")
	eq(t.Eff, 0, "Effizienz neu")
	eq(t.Vault, 0, "Tresor neu")
	eq(t.RunSpend, 0, "Lauf-Ausgaben neu")
	-- 3) alles andere bleibt
	local progNow = copy(prog)
	progNow.Prestige = nil
	for name, before in pairs(keep) do
		local now = if name == "ProgNoPrestige" then progNow else data[name]
		local same, where = deepEqual(before, now, name)
		truthy(same, name .. " muss bleiben (" .. tostring(where) .. ")")
	end
	eq(prog.Licence, 7, "Lizenz bleibt")
	eq(prog.Xp, 30000, "Trader-XP bleiben")
end

Tests["Börsengang: Sterne-Grenzen, Gratis-Umverteilen ab dem 3., Ticker-Liste begrenzt"] = function(services: any)
	local c = core(services)
	local prog = newData(services).Prog
	eq(c.ApplyIpo(prog, 9.99e6, "AAA", 1), 0, "unter 1e7: 0 ★")
	eq(c.ApplyIpo(prog, 1e7, "BBB", 2), 4, "1e7: 4 ★")
	eq(prog.Prestige.RespecFree, false, "noch kein Gratis-Umverteilen")
	c.ApplyIpo(prog, 1e9, "CCC", 3)
	eq(prog.Prestige.Count, 3, "3 Börsengänge")
	eq(prog.Prestige.RespecFree, true, "ab dem 3. Börsengang einmal gratis")
	eq(prog.Prestige.Stars, 16, "4 + 12 ★")
	for i = 1, PCFG.Prestige.TickerKeep + 10 do
		c.ApplyIpo(prog, 0, "T" .. i, i)
	end
	eq(#prog.Prestige.Tickers, PCFG.Prestige.TickerKeep, "Ticker-Liste begrenzt")
end

Tests["Vorstand wirkt nur auf Turm/Lifestyle, nie auf Trading-Werkzeuge"] = function(services: any)
	local c = core(services)
	local towerKeys: { [string]: boolean } = {}
	for _, value in pairs(Config.Tower.Perks) do
		towerKeys[value] = true
	end
	for _, def in ipairs(PCFG.Prestige.Perks) do
		truthy(towerKeys[def.Key] or def.Key == "Lifestyle", "Vorstand-Ast ohne Turm/Lifestyle-Wirkung: " .. def.Key)
	end
	local data = newData(services)
	local prog = data.Prog
	prog.Licence = 5
	prog.Xp = 20000
	prog.KH = { Alerts = 3, Risk = 1 }
	c.Repair(data)
	local toolsBefore = copy(c.TradingPerks(prog))
	local khBefore = c.KhTotal(prog)
	local xpBefore = prog.Xp
	prog.Prestige.Stars = 100
	for _, def in ipairs(PCFG.Prestige.Perks) do
		for _ = 1, def.Max do
			c.BuyPerk(prog, def.Key)
		end
	end
	eq(c.StarsSpent(prog), 39, "alle Äste voll = 39 ★")
	local same, where = deepEqual(toolsBefore, c.TradingPerks(prog), "TradingPerks")
	truthy(same, "Trading-Werkzeuge unverändert (" .. tostring(where) .. ")")
	eq(c.KhTotal(prog), khBefore, "Know-how unverändert")
	eq(prog.Xp, xpBefore, "XP unverändert")
	-- Umverteilen kostet 1 ★ (außer gratis)
	local stars = prog.Prestige.Stars
	eq((c.Respec(prog)), true, "Umverteilen")
	eq(prog.Prestige.Stars, stars - PCFG.Prestige.RespecCost, "kostet 1 ★")
	eq(next(prog.Prestige.Perks), nil, "Äste leer")
	eq(select(2, c.Respec(prog)), "prog.respecEmpty", "nichts zum Umverteilen")
end

-- ---------------------------------------------------------------------
-- 4) KNOW-HOW-GRENZEN
-- ---------------------------------------------------------------------
Tests["Know-how: Punkte, Lizenz-Sperren, Höchststufe, Umverteilen 1× je Woche, Deckel 130"] = function(services: any)
	local c = core(services)
	local data = newData(services)
	local prog = data.Prog
	eq(c.KhTotal(prog), 0, "Start ohne KH")
	eq(select(2, c.BuyNode(prog, "Alerts")), "prog.khNoPoints", "ohne Punkte")
	eq(select(2, c.BuyNode(prog, "Unbekannt")), "core.invalid", "unbekannter Knoten")
	prog.Xp = ProgressMath.XpForLevel(11) -- Level 11 -> 10 KH
	eq(c.KhTotal(prog), 10, "10 KH aus Level")
	local ok, key, args = c.BuyNode(prog, "Risk")
	eq(ok, false, "Risiko-Büro gesperrt")
	eq(key, "prog.khLocked", "Sperr-Text")
	eq(args and args[1], 3, "ab Azubi III")
	prog.Licence = 3
	eq(c.KhTotal(prog), 16, "+3 je Lizenz ab Azubi II")
	eq((c.BuyNode(prog, "Risk")), true, "Risiko 1")
	eq((c.BuyNode(prog, "Risk")), true, "Risiko 2")
	eq(select(2, c.BuyNode(prog, "Risk")), "prog.khMax", "Höchststufe")
	eq(c.KhFree(prog), 12, "16 − 2 × 2")
	prog.Licence = 5
	eq((c.BuyNode(prog, "Research")), true, "Research 1 ab Trader II")
	local ok2, key2, args2 = c.BuyNode(prog, "Research")
	eq(ok2, false, "Research 2 gesperrt")
	eq(key2, "prog.khLocked", "Stufen-Lizenz")
	eq(args2 and args2[1], 7, "Research 2 ab Fondsmanager I")
	-- alles ausgeben -> keine Punkte mehr
	local guard = 0
	while c.KhFree(prog) > 0 and guard < 50 do
		guard += 1
		if not c.BuyNode(prog, "Alerts") and not c.BuyNode(prog, "Watch") and not c.BuyNode(prog, "Monitors") then
			break
		end
	end
	truthy(c.KhSpent(prog) <= c.KhTotal(prog), "nie mehr ausgegeben als vorhanden")
	-- Umverteilen
	local week = 2900
	eq((c.ResetNodes(prog, week)), true, "Umverteilen")
	eq(next(prog.KH), nil, "leer")
	eq(c.KhSpent(prog), 0, "nichts ausgegeben")
	c.BuyNode(prog, "Alerts")
	eq(select(2, c.ResetNodes(prog, week)), "prog.khResetUsed", "nur 1× je Woche")
	prog.KH = {}
	eq(select(2, c.ResetNodes(prog, week + 1)), "prog.khResetEmpty", "nichts verteilt")
	-- Deckel
	prog.Xp = 1e12
	prog.Licence = #PCFG.Licences
	for _, lesson in ipairs(PCFG.Academy.Lessons) do
		prog.Lessons[lesson.Id] = 2
	end
	eq(c.Series(prog), 4, "4 Serien")
	eq(c.KhTotal(prog), PCFG.KnowHow.Max, "Deckel 130")
	-- Werkzeuge kommen nur aus Lizenz + KH
	prog.KH = { Alerts = 5, Watch = 4 }
	local tools = c.TradingPerks(prog)
	eq(tools.Alerts, 18, "3 + 5 × 3 Alarme")
	eq(tools.Watchlists, 5, "1 + 4 Watchlists")
end

-- ---------------------------------------------------------------------
-- 5) LIZENZEN: Aufstieg ruft SetLicence (Abnahme 2), Admin-Lizenz taintet (Test-Vorgabe)
-- ---------------------------------------------------------------------
Tests["Lizenz-Aufstieg: SetLicence je Stufe, +250 XP, +20 Ruf, Basis steigt"] = function(services: any)
	local c = core(services)
	local prog = newData(services).Prog
	local calls: { number } = {}
	local function record(idx: number)
		table.insert(calls, idx)
	end
	eq(#c.Promote(prog, 20000, 2900, record), 0, "ohne XP kein Aufstieg")
	prog.Xp = 300
	eq(#c.Promote(prog, 20000, 2900, record), 0, "Prüfung fehlt")
	prog.Exams.ProtectPair = true
	local promoted = c.Promote(prog, 20000, 2900, record)
	eq(#promoted, 1, "eine Stufe")
	eq(promoted[1], 2, "Azubi II")
	eq(calls[1], 2, "OrderService.SetLicence(2)")
	eq(prog.Licence, 2, "Lizenz gesetzt")
	eq(prog.Xp, 300 + PCFG.XpSources.Exam.Xp, "+250 XP Prüfung")
	eq(prog.Ruf, PCFG.Ruf.Exam, "+20 Ruf (außerhalb des Deckels)")
	truthy(PCFG.Licences[2].Basis > PCFG.Licences[1].Basis, "Basis steigt")
	-- Kette bis zur Legende: jede Stufe einzeln gemeldet
	table.clear(calls)
	prog.Xp = 1e7
	for _, task in ipairs(PCFG.ExamTasks) do
		prog.Exams[task.Key] = true
	end
	local exams = 0
	for idx = 3, #PCFG.Licences do
		if #PCFG.Licences[idx].Exam > 0 then
			exams += 1
		end
	end
	local chain = c.Promote(prog, 20000, 2900, record)
	eq(#chain, #PCFG.Licences - 2, "Stufen 3 … 10")
	for i, idx in ipairs(chain) do
		eq(idx, i + 2, "Reihenfolge")
		eq(calls[i], idx, "SetLicence je Stufe")
	end
	eq(prog.Licence, #PCFG.Licences, "Legende")
	-- Prüfungs-Bonus nur für Lizenzen mit Prüfung (Trader II / Fondsmanager II steigen nur über XP)
	eq(prog.Xp, 1e7 + exams * PCFG.XpSources.Exam.Xp, "+250 XP je bestandener Prüfung")
end

Tests["Admin-Lizenz: SetLicence + TaintWeek(AdminLicence), ungültige Stufen abgelehnt"] = function(services: any)
	local c = core(services)
	local prog = newData(services).Prog
	local calls: { { any } } = {}
	local function report(fnName: string, arg: any)
		table.insert(calls, { fnName, arg })
	end
	eq(c.AdminLicence(prog, 7, report), true, "Admin setzt Fondsmanager I")
	eq(prog.Licence, 7, "Lizenz")
	eq(prog.AchProgress.Licence, 7, "Erfolgs-Zähler")
	local tainted, licenced = false, false
	for _, entry in ipairs(calls) do
		if entry[1] == "TaintWeek" and entry[2] == "AdminLicence" then
			tainted = true
		elseif entry[1] == "SetLicence" and entry[2] == 7 then
			licenced = true
		end
	end
	truthy(licenced, "OrderService.SetLicence(7) fehlt")
	truthy(tainted, "OrderService.TaintWeek(AdminLicence) fehlt – Admin-Gaben müssen die Liga-Woche tainten")
	table.clear(calls)
	for _, bad in ipairs({ 0, 11, 2.5, -1 } :: { any }) do
		eq(c.AdminLicence(prog, bad, report), false, "ungültig: " .. tostring(bad))
	end
	eq(#calls, 0, "keine Meldung bei ungültiger Stufe")
	eq(prog.Licence, 7, "unverändert")
end

-- ---------------------------------------------------------------------
-- 6) RUF (Abnahme 4)
-- ---------------------------------------------------------------------
Tests["Ruf: Deckel 20/Tag, Abbau ohne zählenden Börsentag, Lizenz-Untergrenzen"] = function(services: any)
	local c = core(services)
	local data = newData(services)
	local prog = data.Prog
	local day = 20000
	eq(c.AddRuf(prog, 15, day, true), 15, "15 Punkte")
	eq(c.AddRuf(prog, 15, day, true), 5, "Deckel 20 je Tag")
	eq(c.AddRuf(prog, 15, day, true), 0, "Deckel erreicht")
	eq(c.AddRuf(prog, PCFG.Ruf.Exam, day, false), PCFG.Ruf.Exam, "Prüfung außerhalb des Deckels")
	eq(c.AddRuf(prog, 15, day + 1, true), 15, "neuer Tag")
	eq(prog.Ruf, 15 + 5 + PCFG.Ruf.Exam + 15, "Summe")
	-- Abbau: letzter Tag hatte einen zählenden Börsentag, danach 2 Tage ohne
	prog.Ruf = 100
	prog.RufDay = day + 1
	data.LastUtcDay = day + 1
	eq(c.DayRoll(data, day + 4), 2, "2 Tage ohne Börsentag")
	eq(prog.Ruf, math.floor(100 * (1 - PCFG.Ruf.DecayPct) ^ 2), "−8 % je Tag")
	eq(c.DayRoll(data, day + 4), 0, "gleicher Tag: nichts")
	-- Untergrenze Fondsmanager I (Stufe 4 = 100 Punkte)
	prog.Licence = 7
	prog.Ruf = 160
	prog.RufDay = 0
	data.LastUtcDay = day
	c.DayRoll(data, day + 40)
	eq(prog.Ruf, PCFG.Ruf.Thresholds[4], "nie unter die Lizenz-Untergrenze")
	eq(c.RufLevel(prog), 4, "Stufe 4")
	prog.Ruf = 0
	eq(c.RufLevel(prog), 4, "Stufe nie unter der Untergrenze")
end

-- ---------------------------------------------------------------------
-- 7) AKADEMIE: Quiz-Schlüssel nur auf dem Server, Form-Prüfung
-- ---------------------------------------------------------------------
Tests["Akademie: Quiz-Schlüssel vollständig, Antworten streng geprüft"] = function(services: any)
	local test = serviceModule(services, "ProgressionService")._Test
	local c = test.Core
	local key = test.QuizKey
	for _, lesson in ipairs(PCFG.Academy.Lessons) do
		local solution = key[lesson.Id]
		truthy(type(solution) == "table", "Schlüssel fehlt für " .. lesson.Id)
		eq(#solution, #lesson.Quiz, "Fragen in " .. lesson.Id)
		for q, answer in ipairs(solution) do
			truthy(answer >= 1 and answer <= lesson.Quiz[q], "Antwort außerhalb in " .. lesson.Id .. " Frage " .. q)
		end
		local correct, total = c.LessonResult(lesson.Id, table.clone(solution), key)
		eq(correct, total, "alles richtig in " .. lesson.Id)
	end
	eq((c.LessonResult("L01", { 1 }, key)), nil, "zu wenige Antworten")
	eq((c.LessonResult("L01", { 1, 9 }, key)), nil, "Antwort außerhalb")
	eq((c.LessonResult("L01", { 1, 1.5 }, key)), nil, "keine ganze Zahl")
	local extra: any = { 1, 3 }
	extra.X = 1
	eq((c.LessonResult("L01", extra, key)), nil, "Fremd-Schlüssel")
	eq((c.LessonResult("L99", { 1, 1 }, key)), nil, "unbekannte Lektion")
	local wrong = c.LessonResult("L01", { 2, 1 }, key)
	eq(wrong, 0, "alles falsch")
end

-- ---------------------------------------------------------------------
-- 8) LOGIN, SAISON, XP-DECKEL, ALBUM
-- ---------------------------------------------------------------------
Tests["Login: Serie, Serien-Schutz, neue Serie, 28er-Spur, einmal je Tag"] = function(services: any)
	local c = rewardTest(services).Core
	-- Woche 10 hat ihren Gratis-Schutz schon bekommen (1 vorhanden)
	local login = { LastDay = 0, Streak = 0, Best = 0, Freeze = 1, FreezeWeek = 10, Cycle = 1, Track = 0 }
	local function claim(day: number, week: number)
		local nextState = c.LoginStep(login, day, week, false)
		assert(nextState, "Tag " .. day .. " abholbar")
		nextState.DayIdx = nil
		nextState.UsedFreeze = nil
		login = nextState
	end
	claim(100, 10)
	eq(login.Streak, 1, "Tag 1")
	eq(c.LoginStep(login, 100, 10, false), nil, "heute schon abgeholt")
	claim(101, 10)
	eq(login.Streak, 2, "Serie läuft")
	claim(103, 10) -- 1 Tag Lücke, 1 Schutz vorhanden
	eq(login.Streak, 3, "Schutz überbrückt die Lücke")
	eq(login.Freeze, 0, "Schutz verbraucht")
	claim(106, 10) -- 2 Tage Lücke, kein Schutz
	eq(login.Streak, 1, "neue Serie")
	eq(login.Best, 3, "Rekord bleibt")
	eq(login.Track, 4, "28er-Spur zählt abgeholte Tage")
	claim(107, 11)
	eq(login.Freeze, 1, "neue Woche: 1 Schutz")
	local club = c.LoginStep(login, 108, 12, true)
	assert(club, "abholbar")
	eq(club.Freeze, math.min(Config.Rewards.Login.FreezeMax, 1 + 1 + 1), "Club +1, höchstens 2")
end

Tests["Saison: aktive Saison, ehrliches Ende, Rolling danach"] = function(services: any)
	local c = rewardTest(services).Core
	local def = Config.Season.Seasons[1]
	local start = DateTime.fromIsoDate(def.StartUtc).UnixTimestamp
	local stop = DateTime.fromIsoDate(def.EndUtc).UnixTimestamp
	local inside = c.SeasonAt(start + DAY)
	assert(inside, "Saison 1 aktiv")
	eq(inside.Id, def.Id, "Saison 1")
	eq(inside.EndsAt, stop, "festes Ende")
	eq(inside.Rolling, false, "fest")
	local after = c.SeasonAt(stop + DAY)
	assert(after, "Rolling nach dem Ende")
	eq(after.Rolling, true, "Rolling")
	eq(after.Id, def.Id + 1, "Folge-Saison")
	eq(after.StartsAt, stop, "beginnt am Ende der letzten")
	eq(after.EndsAt - after.StartsAt, Config.Season.Rolling.LengthDays * DAY, "Länge")
	eq(ProgressMath.SeasonTier(def.Tiers * def.TierXp + 5, def.TierXp, def.Tiers), def.Tiers, "Stufen-Deckel")
end

Tests["XP: Tagesdeckel je Quelle, Prüfung ohne Verdoppler, nie Robux-Quellen"] = function(services: any)
	local c = core(services)
	local prog = newData(services).Prog
	local source = PCFG.XpSources.ReadWell
	local gained = 0
	for _ = 1, source.Cap + 5 do
		gained += c.AddXp(prog, source.Xp, "ReadWell", 1, 20000, 2900)
	end
	eq(gained, source.Xp * source.Cap, "Deckel " .. source.Cap .. "× je Tag")
	eq(c.AddXp(prog, source.Xp, "ReadWell", 1, 20001, 2900), source.Xp, "neuer Tag")
	eq(c.AddXp(prog, 100, "Unbekannt", 1, 20001, 2900), 0, "unbekannte Quelle")
	eq(c.AddXp(prog, 100, "LessonFirst", 5, 20001, 2900), 100 * PCFG.XpMultMax, "Verdoppler höchstens ×2")
	for reason in pairs(PCFG.XpSources) do
		local lower = string.lower(reason)
		truthy(
			not string.find(lower, "robux", 1, true) and not string.find(lower, "purchase", 1, true),
			"XP-Quelle aus Käufen: " .. reason
		)
	end
end

Tests["Album: Karten, Sektor-Sätze, IPO-Seite"] = function(services: any)
	local c = core(services)
	local prog = newData(services).Prog
	local companies = Config.Companies
	local firstSector = companies.Sectors[1].Key
	local lastSector: string? = nil
	for _, inst in ipairs(companies.Instruments) do
		if inst.Sector == firstSector and inst.Class ~= "ETF" and inst.Set ~= "Tutorial" and inst.Ipo ~= true then
			local added, sector = c.AlbumAdd(prog, inst.Id)
			eq(added, true, "Karte " .. inst.Id)
			lastSector = sector or lastSector
		end
	end
	eq(c.AlbumSets(prog), 1, "1 Sektor-Satz")
	eq(lastSector, firstSector, "Satz gemeldet")
	eq((c.AlbumAdd(prog, companies.Instruments[1].Id)), false, "doppelte Karte")
	eq((c.AlbumAdd(prog, 250)), false, "Übungsaktie ist keine Karte")
	eq((c.AlbumAdd(prog, PCFG.Album.IpoFrom)), true, "IPO-Seite")
end

return Tests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">TowerTests</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Selbsttests Turm-Ökonomie (Server/Tests/TowerTests)
--  Besitzer: WP6 (Turm-Ökonomie). Vertrag: DESIGN.md §D WP6 "Abnahme"/"Tests", §C17 (TowerMath == Tabelle §B5.1,
--  alle Preise < 1e14 ganzzahlig, Multiplikator-Deckel ×10). SelfTestService lädt dieses Modul; jeder Fehler = FAIL.
--  Alle Tests laufen auf Kopien von DataService.DefaultData() mit einem künstlichen CR-Konto (Attrappen-Env) –
--  keine Spieler, keine echten Spielstände, kein ShopService nötig.
--
--  Prüft: Tabellen, Preis-Grenzen, Stufen-Tore (Lizenz + Börsengang), eine Baustelle, Bauzeit-Untergrenze,
--  Abteilungen (Mindest-Stufe, Penthouse oben, Höchstzahl, Wechselkosten), Nachbar-Effekte, Penthouse wandert mit,
--  Personal-Plätze (Personal+), Raum-Stufen, Effizienz (Deckel 20, Vorstand-Rabatt), Multiplikator-Gruppen
--  (x2 ×2, x3 ×3, beide ×4, Zeitlich ×10, Event ≤ ×3), Offline (3 h exakt, Deckel, ohne Sozial/Zeitlich),
--  Börsengang-Reset behält Depot/Lizenz/Lager, Transfer-Fluss nur AKY -> CR, Bau-Hilfe, Bau-Express, Reparatur,
--  Deko-Plätze, Privat-Etagen, Auto-Plan, Live-Felder.
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Config = require(Shared:WaitForChild("Config"))
local TowerMath = require(Shared:WaitForChild("TowerMath"))

local function eq(actual: any, expected: any, label: string?)
	if actual ~= expected then
		error(("%s erwartet %s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function near(actual: number, expected: number, tolerance: number, label: string?)
	if math.abs(actual - expected) > tolerance then
		error(("%s erwartet ≈%s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function truthy(value: any, label: string)
	if not value then
		error(label, 2)
	end
end

local function serviceModule(services: any, name: string): any
	local svc = services and services[name]
	if svc then
		return svc
	end
	local module = script.Parent.Parent:WaitForChild("Services"):FindFirstChild(name)
	assert(module and module:IsA("ModuleScript"), name .. " fehlt")
	return require(module) :: any
end

local function core(services: any): any
	return serviceModule(services, "TowerService")._Test.Core
end

local function newFactors(services: any): any
	return serviceModule(services, "TowerService")._Test.Factors()
end

-- frischer Spielstand (Kopie) mit reparierten Turm-Daten
local function newData(services: any): { [string]: any }
	local data = serviceModule(services, "DataService").DefaultData()
	core(services).Repair(data)
	return data
end

-- künstliches CR-Konto + Lager + Pässe/Perks (Attrappen-Env, gleiche Form wie TowerService._Env)
local function fakeEnv(opts: { [string]: any }?): (any, { [string]: any })
	local o = opts or {}
	local account = {
		Balance = o.Credits or 0,
		Debits = {} :: { { any } },
		Credits = {} :: { { any } },
		Storage = o.Storage or {},
		Passes = o.Passes or {},
		Perks = o.Perks or {},
		FailDebit = o.FailDebit == true,
	}
	local env = {
		Now = o.Now or 1000000,
		Licence = o.Licence or 1,
		Ipo = o.Ipo or 0,
		Perk = function(key: string): number
			return account.Perks[key] or 0
		end,
		HasPass = function(key: string): boolean
			return account.Passes[key] == true
		end,
		Balance = function(): number
			return account.Balance
		end,
		Debit = function(amount: number, sink: string): boolean
			if account.FailDebit or amount > account.Balance or amount % 1 ~= 0 then
				return false
			end
			account.Balance -= amount
			table.insert(account.Debits, { amount, sink })
			return true
		end,
		Credit = function(amount: number, source: string): boolean
			account.Balance += amount
			table.insert(account.Credits, { amount, source })
			return true
		end,
		TakeDecor = function(key: string): boolean
			local n = account.Storage[key] or 0
			if n <= 0 then
				return false
			end
			account.Storage[key] = n - 1
			return true
		end,
		ReturnDecor = function(key: string)
			account.Storage[key] = (account.Storage[key] or 0) + 1
		end,
		Comfort = function(_key: string): number
			return 2
		end,
		Owns = function(entry: any): boolean
			return entry.Unlock == "Default"
		end,
		BuildEvent = 1,
		CostEvent = function(_kind: string): number
			return o.CostEvent or 1
		end,
	}
	return env, account
end

-- n Etagen direkt bauen (Bau starten + sofort fertigstellen)
local function buildFloors(services: any, data: any, env: any, n: number)
	local c = core(services)
	for _ = 1, n do
		local ok, key = c.StartBuild(data.Tower, env)
		assert(ok, "Bau gescheitert: " .. tostring(key))
		data.Tower.Build.Until = env.Now
		local floor = c.FinishBuild(data.Tower, env)
		assert(floor, "FinishBuild ohne Etage")
	end
end

local function deepEqual(a: any, b: any, path: string): (boolean, string?)
	if type(a) ~= type(b) then
		return false, path
	end
	if type(a) ~= "table" then
		if a ~= b then
			return false, path
		end
		return true, nil
	end
	for key, value in pairs(a) do
		local ok, where = deepEqual(value, b[key], path .. "." .. tostring(key))
		if not ok then
			return false, where
		end
	end
	for key in pairs(b) do
		if a[key] == nil then
			return false, path .. "." .. tostring(key)
		end
	end
	return true, nil
end

local Tests = {}

-- ---------------------------------------------------------------------
-- 1) Tabellen & Grenzen (§C17)
-- ---------------------------------------------------------------------
Tests["TowerMath == Tabelle §B5.1"] = function()
	local rows = {
		{ 1, 0, 4.0 },
		{ 2, 1000, 5.2 },
		{ 4, 2250, 8.8 },
		{ 7, 7594, 19.3 },
		{ 10, 25629, 42.4 },
		{ 13, 89957, 93.2 },
		{ 14, 140334, 121.2 },
		{ 18, 831113, 346.0 },
		{ 21, 3155251, 760.2 },
		{ 22, 4922192, 988 },
		{ 25, 18686689, 2171 },
		{ 26, 29524969, 2823 },
		{ 30, 183999992, 8062 },
		{ 31, 290719987, 10480 },
		{ 37, 4522904446, 50585 },
		{ 40, 17839746280, 111135 },
		{ 44, 116914561223, 317413 },
		{ 50, 1961500847186, 1532090 },
	}
	for _, row in ipairs(rows) do
		eq(TowerMath.FloorCost(row[1]), row[2], "Kosten Etage " .. row[1])
		near(TowerMath.FloorIncome(row[1]), row[3], math.max(0.051, row[3] * 0.0005), "Einkommen Etage " .. row[1])
	end
	local sum = 0
	for n = 1, 50 do
		sum += TowerMath.FloorCost(n)
	end
	eq(sum, 5231695359616, "Summe 5,23e12")
	near(TowerMath.BuildTime(22) / 60, 10.2, 0.05, "Bauzeit Etage 22")
	eq(TowerMath.BuildTime(30), 5400, "Bauzeit ab 30")
end

Tests["Alle Preise < 1e14 und ganzzahlig"] = function()
	local function ok(value: number, label: string)
		truthy(Util.IsFinite(value) and value >= 0 and value % 1 == 0, label .. ": ganzzahlig ≥ 0")
		truthy(value < 1e14, label .. (": %s ≥ 1e14"):format(tostring(value)))
	end
	local worst = 0
	for n = 1, 50 do
		ok(TowerMath.FloorCost(n), "Etage " .. n)
		ok(TowerMath.RoomChangeCost(n), "Wechsel " .. n)
		for l = 1, 4 do
			ok(TowerMath.LevelCost(n, l), ("Raum-Stufe %d/%d"):format(n, l))
			worst = math.max(worst, TowerMath.LevelCost(n, l))
		end
		for _, staff in ipairs(Config.Tower.Staff) do
			ok(TowerMath.StaffCost(n, staff.Key), ("Personal %s/%d"):format(staff.Key, n))
			worst = math.max(worst, TowerMath.StaffCost(n, staff.Key))
		end
	end
	for k = 0, 19 do
		ok(TowerMath.EfficiencyCost(k), "Effizienz " .. k)
	end
	near(worst, 4.9e13, 0.01e13, "teuerster Einzelpreis (Quant Etage 50)")
	eq(TowerMath.Clamp(1e20), 9e15, "Klemmung 9e15")
end

-- ---------------------------------------------------------------------
-- 2) Bauen & Tore (§B4.2, §B4.7)
-- ---------------------------------------------------------------------
Tests["Stufen-Tore: Lizenz und Börsengang"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env = fakeEnv({ Credits = 1e13, Licence = 1 })
	buildFloors(services, data, env, 9)
	eq(#data.Tower.Floors, 9)
	local ok, key = c.StartBuild(data.Tower, env)
	eq(ok, false, "Etage 10 ohne Azubi II")
	eq(key, "tower.gateLicence")
	env.Licence = 2
	ok = c.StartBuild(data.Tower, env)
	eq(ok, true, "Etage 10 mit Azubi II")
	-- Orbit-Spire: Fondsmanager I UND ≥ 1 Börsengang
	local env2 = fakeEnv({ Credits = 1e14, Licence = 7, Ipo = 0 })
	local data2 = newData(services)
	c.SetFloors(data2.Tower, env2, 43)
	ok, key = c.StartBuild(data2.Tower, env2)
	eq(ok, false, "Etage 44 ohne Börsengang")
	eq(key, "tower.gateIpo")
	env2.Ipo = 1
	ok = c.StartBuild(data2.Tower, env2)
	eq(ok, true, "Etage 44 mit Börsengang")
	-- Robux überspringen kein Tor: Pässe ändern nichts
	local env3 =
		fakeEnv({ Credits = 1e13, Licence = 1, Passes = { Income2x = true, Income3x = true, BuildCrew = true } })
	local data3 = newData(services)
	buildFloors(services, data3, env3, 9)
	ok, key = c.StartBuild(data3.Tower, env3)
	eq(ok, false, "Pässe öffnen kein Lizenz-Tor")
	eq(key, "tower.gateLicence")
end

Tests["Bauen: eine Baustelle, Kosten, Lauf-Ausgaben"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env, account = fakeEnv({ Credits = 5000 })
	local ok, _, _, result = c.StartBuild(data.Tower, env)
	eq(ok, true, "Etage 1")
	eq(result.Cost, 0, "Etage 1 gratis")
	local busy, key = c.StartBuild(data.Tower, env)
	eq(busy, false, "zweite Baustelle")
	eq(key, "tower.craneBusy")
	data.Tower.Build.Until = env.Now
	c.FinishBuild(data.Tower, env)
	ok, _, _, result = c.StartBuild(data.Tower, env)
	eq(ok, true, "Etage 2")
	eq(result.Cost, 1000)
	eq(account.Balance, 4000, "1.000 CR abgebucht")
	eq(account.Debits[1][2], "Floor", "Senke Floor")
	eq(data.Tower.RunSpend, 1000, "Lauf-Ausgaben")
	data.Tower.Build.Until = env.Now
	c.FinishBuild(data.Tower, env)
	-- zu wenig CR
	account.Balance = 10
	ok, key = c.StartBuild(data.Tower, env)
	eq(ok, false)
	eq(key, "tower.noCredits")
	eq(data.Tower.Build.Floor, nil, "keine Baustelle ohne Bezahlung")
end

Tests["Bauzeit: Beschleuniger nie unter 25 %, Bau-Boom-Rabatt"] = function(services)
	local c = core(services)
	local env = fakeEnv({ Passes = { BuildCrew = true }, Perks = { Tempo = 5 } })
	eq(c.BuildSeconds(30, env), 5400 * 0.25, "Crew −50 % × Tempo −50 % = Untergrenze")
	env.BuildEvent = 0.1
	eq(c.BuildSeconds(30, env), 5400 * 0.25, "Admin-Bau-Boom: Untergrenze bleibt")
	local plain = fakeEnv({})
	eq(c.BuildSeconds(30, plain), 5400)
	eq(c.BuildSeconds(5, env), 3, "Szene bleibt 3 s")
	-- Kosten: Vorstand "Bau" −5 %/Stufe × Bau-Boom
	local discounted = fakeEnv({ Perks = { Build = 8 }, CostEvent = 0.75 })
	near(c.CostFactor(discounted, "Floor"), 0.6 * 0.75, 1e-12, "Etagen: Perk × Bau-Boom")
	near(c.CostFactor(discounted, nil), 0.6, 1e-12, "Personal/Effizienz: nur Perk")
end

-- ---------------------------------------------------------------------
-- 3) Abteilungen, Nachbar-Effekte, Personal, Raum-Stufen, Effizienz
-- ---------------------------------------------------------------------
Tests["Abteilungen: Mindest-Stufe, Penthouse oben, Höchstzahl, Wechselkosten"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env, account = fakeEnv({ Credits = 1e12, Licence = 10, Ipo = 1 })
	buildFloors(services, data, env, 5)
	local ok, key = c.SetRoom(data.Tower, env, 3, "Lab")
	eq(ok, false, "Labor erst ab Stufe 5")
	eq(key, "tower.roomLocked")
	buildFloors(services, data, env, 5) -- 10 Etagen = Stufe 5
	local before = account.Balance
	ok = c.SetRoom(data.Tower, env, 3, "Lab")
	eq(ok, true, "Labor auf Etage 3")
	eq(before - account.Balance, TowerMath.RoomChangeCost(3), "Wechsel = 25 % der Etagenkosten")
	ok, key = c.SetRoom(data.Tower, env, 3, "Lab")
	eq(key, "tower.roomSame")
	eq(c.SetRoom(data.Tower, env, 4, "Vault"), true)
	eq(c.SetRoom(data.Tower, env, 5, "Vault"), true)
	ok, key = c.SetRoom(data.Tower, env, 6, "Vault")
	eq(key, "tower.roomMax", "höchstens 2 Tresor-Etagen")
	ok, key = c.SetRoom(data.Tower, env, 9, "Penthouse")
	eq(key, "tower.roomLocked", "Penthouse ab Stufe 10")
	buildFloors(services, data, env, 21) -- 31 Etagen = Stufe 10
	ok, key = c.SetRoom(data.Tower, env, 30, "Penthouse")
	eq(key, "tower.roomTopOnly")
	eq(c.SetRoom(data.Tower, env, 31, "Penthouse"), true, "Penthouse oben")
	eq(c.RoomCount(data.Tower, "Vault"), 2)
end

Tests["Nachbar-Effekte im Tower (Labor, Café, Server)"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env = fakeEnv({ Credits = 1e12, Licence = 10 })
	buildFloors(services, data, env, 10)
	local floors = data.Tower.Floors
	local i2 = TowerMath.FloorIncome(2)
	near(TowerMath.FloorIncomeAt(floors, 2, nil), i2, 1e-9, "Büro ohne Nachbarn")
	assert(c.SetRoom(data.Tower, env, 3, "Lab"))
	near(TowerMath.FloorIncomeAt(floors, 2, nil), i2 * 1.15, 1e-9, "Labor darüber ×1,15")
	assert(c.SetRoom(data.Tower, env, 1, "Lab"))
	near(TowerMath.FloorIncomeAt(floors, 2, nil), i2 * 1.15 * 1.15, 1e-9, "Labor darüber und darunter")
	-- Café ±2 auf Personal-Boni
	assert(c.Hire(data.Tower, env, 6, "Analyst"))
	local i6 = TowerMath.FloorIncome(6)
	near(TowerMath.FloorIncomeAt(floors, 6, nil), i6 * 1.25, 1e-9, "Analyst +25 %")
	assert(c.SetRoom(data.Tower, env, 8, "Cafe"))
	near(TowerMath.FloorIncomeAt(floors, 6, nil), i6 * (1 + 0.25 * 1.2), 1e-9, "Café 2 Etagen weiter")
	-- Server-Raum: alle Personal-Boni ×1,1
	assert(c.SetRoom(data.Tower, env, 10, "Server"))
	near(TowerMath.FloorIncomeAt(floors, 6, nil), i6 * (1 + 0.25 * 1.2 * 1.1), 1e-9, "Server ×1,1")
end

Tests["Penthouse wandert beim Bau nach oben (mit Deko)"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env = fakeEnv({ Credits = 1e13, Licence = 10, Storage = { sofa = 4 } })
	c.SetFloors(data.Tower, env, 31)
	assert(c.SetRoom(data.Tower, env, 31, "Penthouse"))
	for slot = 1, 4 do
		assert(c.SetDecor(data.Tower, env, 31, slot, "sofa"))
	end
	eq(c.DecorSlots(data.Tower, 31), 8, "Penthouse 8 Plätze")
	buildFloors(services, data, env, 1)
	local floors = data.Tower.Floors
	eq(floors[32].R, "Penthouse", "neue oberste Etage")
	eq(#floors[32].D, 4, "Deko zieht mit")
	eq(floors[31].R, Config.Tower.DefaultRoom, "alte Etage wird Büro")
	eq(#floors[31].D, 0)
end

Tests["Personal: 2 Plätze, 3 mit Personal+, Mindest-Stufe, Lobby-Bots"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env, account = fakeEnv({ Credits = 1e12, Licence = 10 })
	buildFloors(services, data, env, 7) -- Stufe 4
	eq(c.Hire(data.Tower, env, 5, "Intern"), true)
	eq(c.Hire(data.Tower, env, 5, "Analyst"), true)
	local ok, key = c.Hire(data.Tower, env, 5, "Intern")
	eq(ok, false)
	eq(key, "tower.slotsPlus", "3. Platz nur mit Personal+")
	account.Passes.StaffPlus = true
	eq(c.Hire(data.Tower, env, 5, "Intern"), true, "3. Platz mit Personal+")
	ok, key = c.Hire(data.Tower, env, 5, "Intern")
	eq(key, "tower.slotsFull")
	ok, key = c.Hire(data.Tower, env, 6, "Quant")
	eq(key, "tower.staffLocked", "Quant ab Stufe 8")
	-- Kosten: ×1 / ×3 von max(C(n), 500)
	local balance = account.Balance
	assert(c.Hire(data.Tower, env, 6, "Analyst"))
	eq(balance - account.Balance, TowerMath.StaffCost(6, "Analyst"), "Analyst-Kosten")
	-- Lobby: Hausmeister gratis, je 1
	balance = account.Balance
	eq(c.Hire(data.Tower, env, 0, "Janitor"), true)
	eq(account.Balance, balance, "Hausmeister gratis")
	ok, key = c.Hire(data.Tower, env, 0, "Janitor")
	eq(key, "tower.uniqueOwned")
	-- Entlassen ohne Erstattung
	balance = account.Balance
	local fired, _, staffKey = c.Fire(data.Tower, 5, 1)
	eq(fired, true)
	eq(staffKey, "Intern")
	eq(account.Balance, balance, "keine Rückerstattung")
	eq(#data.Tower.Floors[5].S, 2)
	eq(c.Fire(data.Tower, 0, 1), true, "Hausmeister entlassen")
	eq(data.Tower.Janitor, false)
end

Tests["Raum-Stufen L1–L5 und Effizienz (Deckel 20)"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env, account = fakeEnv({ Credits = 1e14 })
	buildFloors(services, data, env, 4)
	for level = 1, 4 do
		local before = account.Balance
		assert(c.LevelUp(data.Tower, env, 4))
		eq(before - account.Balance, TowerMath.LevelCost(4, level), "Raum-Stufe " .. level)
	end
	local ok, key = c.LevelUp(data.Tower, env, 4)
	eq(ok, false)
	eq(key, "tower.levelMax")
	for k = 0, 19 do
		local before = account.Balance
		assert(c.Efficiency(data.Tower, env))
		eq(before - account.Balance, 10000 * 3 ^ k, "Effizienz-Stufe " .. (k + 1))
	end
	ok, key = c.Efficiency(data.Tower, env)
	eq(key, "tower.effMax", "Deckel 20")
	eq(data.Tower.Eff, 20)
	-- Vorstand "Bau" 8: −40 %
	local data2 = newData(services)
	local env2, account2 = fakeEnv({ Credits = 1e6, Perks = { Build = 8 } })
	assert(c.Efficiency(data2.Tower, env2))
	eq(1e6 - account2.Balance, 6000, "10.000 × 0,6")
end

-- ---------------------------------------------------------------------
-- 4) Multiplikatoren & Einkommen (Abnahme 3/4)
-- ---------------------------------------------------------------------
Tests["Einkommen: x2 allein ×2, x3 allein ×3, beide ×4"] = function(services)
	local c = core(services)
	local base = 1234.5
	for _, case in ipairs({ { 1, 1 }, { 2, 2 }, { 3, 3 }, { 4, 4 } }) do
		local f = newFactors(services)
		f.Pass = case[1]
		local total, steady = TowerMath.Multiplier(c.BuildParts(f, true, true))
		eq(total, case[2], "Pass-Faktor " .. case[1])
		near(base * total, base * case[2], 1e-9, "Einkommen")
		eq(steady, case[2])
	end
	-- beide Pässe: EINE ehrliche Zeile ×4 in der Aufschlüsselung (nie ×2 und ×3 nebeneinander)
	local f = newFactors(services)
	f.Pass = 4
	local passParts = {}
	for _, part in ipairs(c.BuildParts(f, true, true)) do
		if part.Group == "Pass" then
			table.insert(passParts, part)
		end
	end
	eq(#passParts, 1, "eine Pass-Zeile")
	eq(passParts[1].Key, "Passes")
	eq(passParts[1].Value, 4)
end

Tests["Multiplikator-Deckel ×10, Event ≤ ×3, Perm additiv"] = function(services)
	local c = core(services)
	local f = newFactors(services)
	f.Eff = 20
	f.Ipo = 25
	f.Growth = 10
	f.Album = 9
	f.Friends = 7
	f.Respekt = 30
	f.Marketing = 5
	f.Penthouse = true
	local g = TowerMath.Groups(c.BuildParts(f, true, true))
	near(g.Perm, 9.97, 1e-9, "Perm-Maximum 9,97 (alle Deckel)")
	f.Boost = { Key = "X5", Value = 5, Until = 0, Source = "Bought" }
	f.Server = { Key = "Parade", Value = 1.5, Until = 0 }
	f.Event = { Value = 3, Until = nil }
	local total, steady = TowerMath.Multiplier(c.BuildParts(f, true, true))
	near(total, steady * 10, 1e-9, "Zeitlich gedeckelt auf ×10")
	f.Boost = nil
	f.Server = nil
	f.Event = { Value = 9, Until = nil }
	total, steady = TowerMath.Multiplier(c.BuildParts(f, true, true))
	near(total, steady * 3, 1e-9, "Event nie über ×3")
	local parts = c.BuildParts(f, true, false)
	for _, part in ipairs(parts) do
		truthy(part.Group ~= "Timed", "ohne Zeitlich keine Timed-Teile")
	end
end

Tests["Offline: 3 h exakt Steady × Rate × 3 h, ohne Sozial/Zeitlich, Deckel"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env = fakeEnv({ Credits = 1e12, Licence = 10 })
	buildFloors(services, data, env, 12)
	local base = TowerMath.BaseIncome(data.Tower.Floors, nil)
	local f = newFactors(services)
	f.Eff = 3
	f.Friends = 4
	f.Respekt = 10
	f.Pass = 2
	f.Boost = { Key = "X2", Value = 2, Until = 0, Source = "Bought" }
	local _, offlineMult = TowerMath.Multiplier(c.BuildParts(f, false, false))
	near(offlineMult, 1.3 * 2, 1e-9, "Offline: ohne Freunde/Respekt/Boost")
	local steady = base * offlineMult
	local rate = TowerMath.OfflineRate(0, false)
	local cap = TowerMath.OfflineCap(0, 0, false, false)
	eq(TowerMath.Offline(steady, 3 * 3600, rate, cap), math.floor(steady * 0.5 * 10800), "3 h exakt")
	eq(TowerMath.Offline(steady, 30 * 3600, rate, cap), math.floor(steady * 0.5 * 8 * 3600), "Deckel 8 h")
	eq(TowerMath.Offline(steady, 30, rate, cap), math.floor(steady * 0.5 * 30), "Formel (MinAway prüft der Dienst)")
end

-- ---------------------------------------------------------------------
-- 5) Börsengang-Reset (§B9.6) & Transfer (§B8.2)
-- ---------------------------------------------------------------------
Tests["Börsengang-Reset behält Depot, Lizenz, Lager"] = function(services)
	local c = core(services)
	local data = newData(services)
	data.Prog.Licence = 6
	local dep = data.Depot -- Kopie aus DefaultData (Attrappe), nie ein echter Spielstand
	dep.Cash = 123456789
	dep.Basis = 100000000
	dep.Pos["7"] = { Q = 10, C = 50000, R = 0 }
	data.Garage.Cars.Streak = true
	data.Life.Watches.Chrono = true
	local env, account = fakeEnv({ Credits = 1e13, Licence = 6, Storage = { plant = 3, lamp = 1 } })
	buildFloors(services, data, env, 25)
	assert(c.SetDecor(data.Tower, env, 2, 1, "plant"))
	assert(c.SetDecor(data.Tower, env, 2, 2, "plant"))
	assert(c.SetDecor(data.Tower, env, 20, 3, "lamp"))
	assert(c.Efficiency(data.Tower, env))
	data.Tower.Vault = 999
	data.Tower.Janitor = true
	data.Tower.Instant = 2
	table.insert(data.Tower.Express, 600)
	data.Tower.Skin = "Obsidian"
	data.Tower.PendingCredits = 777
	local depotBefore = Util.DeepCopy(data.Depot)
	local progBefore = Util.DeepCopy(data.Prog)
	local garageBefore = Util.DeepCopy(data.Garage)
	local lifeBefore = Util.DeepCopy(data.Life)
	eq(account.Storage.plant, 1, "2 Pflanzen stehen")
	local ok = c.ResetForIpo(data, env, { Blitzstart = 2 })
	eq(ok, true)
	local same, where = deepEqual(depotBefore, data.Depot, "Depot")
	truthy(same, "Depot unverändert (" .. tostring(where) .. ")")
	same, where = deepEqual(progBefore, data.Prog, "Prog")
	truthy(same, "Prog/Lizenz unverändert (" .. tostring(where) .. ")")
	truthy(deepEqual(garageBefore, data.Garage, "Garage"), "Autos bleiben")
	truthy(deepEqual(lifeBefore, data.Life, "Life"), "Uhren bleiben")
	eq(account.Balance, 0, "CR neu (Start-CR 0)")
	eq(#data.Tower.Floors, 8, "Blitzstart 2 = 8 Etagen")
	eq(data.Tower.Eff, 0, "Effizienz neu")
	eq(data.Tower.Vault, 0, "Tresor neu")
	eq(data.Tower.RunSpend, 0, "Lauf-Ausgaben neu")
	eq(data.Tower.PendingCredits, 0, "vorgemerkte CR gehören zum alten Lauf")
	eq(data.Tower.Build.Floor, nil, "keine Baustelle")
	eq(data.Tower.Janitor, true, "Lobby-Bot bleibt")
	eq(data.Tower.Instant, 2, "Token bleiben")
	eq(#data.Tower.Express, 1, "Express bleibt")
	eq(data.Tower.Skin, "Obsidian", "Fassade bleibt")
	-- Lager: alles zurück, "Layout merken" stellt Etage 2 wieder auf, Etage 20 bleibt im Lager
	eq(data.Tower.Floors[2].D[1], "plant", "Layout gemerkt (Etage 2)")
	eq(data.Tower.Floors[2].D[2], "plant")
	eq(account.Storage.plant, 1, "Pflanzen: 3 − 2 wieder aufgestellt")
	eq(account.Storage.lamp, 1, "Lampe zurück im Lager")
	truthy(type(data.Tower.Layouts["20"]) == "table", "Layout Etage 20 gemerkt")
	-- CR nicht abbuchbar -> nichts ändert sich
	local data2 = newData(services)
	local env2 = fakeEnv({ Credits = 1e9 })
	buildFloors(services, data2, env2, 5)
	local env3 = fakeEnv({ Credits = 500, FailDebit = true })
	eq(c.ResetForIpo(data2, env3, {}), false, "Abbuchung scheitert")
	eq(#data2.Tower.Floors, 5, "Turm unverändert")
end

Tests["Transfer-Fluss nur AKY -> CR (Bau-Kurs der Lizenz)"] = function(services)
	local c = core(services)
	eq(c.ConvertTransfer(37500, 40), 15000, "375 AKY × 40 = 15.000 CR (Tutorial)")
	eq(c.ConvertTransfer(1240 * 100, 40), 49600, "Beispiel §B8.2")
	eq(c.ConvertTransfer(12345, 1500), math.floor(12345 * 1500 / 100))
	eq(c.ConvertTransfer(0, 40), 0)
	eq(c.ConvertTransfer(-5, 40), 0)
	eq(c.ConvertTransfer(0 / 0, 40), 0)
	eq(c.ConvertTransfer(6e9 * 0.06, 40000), 1.44e11, "höchster Transfer je Börsentag (Legende) = 1,44e11 CR")
	eq(c.ConvertTransfer(1e15, 40000), 9e15, "geklemmt auf 9e15")
	-- Fluss mit Attrappen: Depot verliert nur über withdraw, CR kommen nur über credit
	local wallet = { Cash = 50000, Withdrawn = 0 } -- Depot-Attrappe
	local credited, pending = 0, 0
	local cents, amount, why = c.Transfer(
		function(): (any, any)
			wallet.Cash -= 1240
			wallet.Withdrawn += 1240
			return 1240, nil
		end,
		200,
		function(value: number): boolean
			credited += value
			return true
		end,
		function(value: number)
			pending += value
		end
	)
	eq(cents, 1240)
	eq(amount, 2480, "12,40 AKY × 200")
	eq(why, nil)
	eq(credited, 2480)
	eq(pending, 0)
	eq(wallet.Cash, 48760, "AKY verlassen das Depot nur über Withdraw")
	-- Gutschrift scheitert -> vorgemerkt, nie zurück ins Depot
	cents, amount = c.Transfer(
		function(): (any, any)
			return 500, nil
		end,
		40,
		function(): boolean
			return false
		end,
		function(value: number)
			pending += value
		end
	)
	eq(pending, 200, "vorgemerkt")
	eq(wallet.Cash, 48760, "Depot unberührt")
	-- nichts abhebbar -> Grund durchreichen, keine CR
	cents, amount, why = c.Transfer(
		function(): (any, any)
			return 0, "trade.transferUsed"
		end,
		40,
		function(): boolean
			error("darf nicht gutschreiben")
		end,
		function()
			error("darf nichts vormerken")
		end
	)
	eq(cents, 0)
	eq(amount, 0)
	eq(why, "trade.transferUsed")
end

-- ---------------------------------------------------------------------
-- 6) Bau-Hilfe, Express, Reparatur, Deko, Privat, Auto-Plan, Live-Felder
-- ---------------------------------------------------------------------
Tests["Bau-Hilfe −10 %, max. 3, je Helfer 1×, Untergrenze"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env = fakeEnv({ Credits = 1e13, Licence = 10 })
	c.SetFloors(data.Tower, env, 29)
	assert(c.StartBuild(data.Tower, env))
	local build = data.Tower.Build
	eq(build.Until - build.Start, 5400, "Etage 30: 90 min")
	assert(c.ApplyHelp(data.Tower, env, 101))
	near(build.Until - env.Now, 4860, 1e-6, "−10 % der Restzeit")
	local ok, key = c.ApplyHelp(data.Tower, env, 101)
	eq(key, "tower.helpAgain")
	assert(c.ApplyHelp(data.Tower, env, 102))
	assert(c.ApplyHelp(data.Tower, env, 103))
	ok, key = c.ApplyHelp(data.Tower, env, 104)
	eq(ok, false)
	eq(key, "tower.helpFull", "höchstens 3 Helfer")
	-- Untergrenze 25 % der Grundzeit
	local data2 = newData(services)
	local env2 = fakeEnv({ Credits = 1e13, Licence = 10, Passes = { BuildCrew = true }, Perks = { Tempo = 5 } })
	c.SetFloors(data2.Tower, env2, 29)
	assert(c.StartBuild(data2.Tower, env2))
	assert(c.ApplyHelp(data2.Tower, env2, 1))
	eq(data2.Tower.Build.Until - data2.Tower.Build.Start, 1350, "nie unter 25 % der Grundzeit")
end

Tests["Bau-Express kürzt bzw. beendet die Baustelle"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env = fakeEnv({ Credits = 1e13, Licence = 10 })
	eq(c.ApplyExpress(data.Tower, env, 600), false, "ohne Baustelle -> Token (Dienst)")
	c.SetFloors(data.Tower, env, 29)
	assert(c.StartBuild(data.Tower, env))
	assert(c.ApplyExpress(data.Tower, env, 600))
	eq(data.Tower.Build.Until - env.Now, 4800, "−10 min")
	assert(c.ApplyExpress(data.Tower, env, 10800))
	eq(data.Tower.Build.Until, env.Now, "Rest ≤ 3 h -> fertig")
end

Tests["Reparatur kaputter Turm-Daten"] = function(services)
	local c = core(services)
	local data = serviceModule(services, "DataService").DefaultData()
	data.Tower.Floors = {
		{ R = "Penthouse", L = 9, S = { "Quant", "Janitor", "Nope", "Intern", "Senior", "Analyst" }, D = { 5, "a" } },
		"kaputt",
		{ R = "Desk", L = 0 / 0, S = "x", D = { "a", "b", "c", "d", "e" } },
	}
	data.Tower.Build = { Floor = 9, Until = 5, Start = 1, Cost = 777 }
	data.Tower.Eff = 99
	data.Tower.Vault = -5
	data.Tower.Skin = "Unbekannt"
	data.Tower.Private = { 1, 1, 7, 2.5 }
	data.Tower.Express = { 600, -1, "x" }
	data.Tower.Name = { A = 999, N = 0 }
	data.Boosts.X2 = 0 / 0
	local refund = c.Repair(data)
	local t = data.Tower
	eq(refund, 777, "ungültige Baustelle wird erstattet")
	eq(t.Build.Floor, nil)
	eq(#t.Floors, 3)
	eq(t.Floors[1].R, Config.Tower.DefaultRoom, "Penthouse nicht oben -> Büro")
	eq(t.Floors[1].L, 5)
	eq(#t.Floors[1].S, 3, "höchstens 3 gültige Personal-Einträge")
	eq(t.Floors[1].D[1], "", "ungültige Deko -> leerer Platz")
	eq(t.Floors[1].D[2], "a")
	eq(t.Floors[2].R, Config.Tower.DefaultRoom, "kaputte Etage -> neue Etage")
	eq(t.Floors[3].L, 1)
	eq(#t.Floors[3].D, 3, "überzählige Deko …")
	eq(data.Storage.Decor.d, 1, "… geht ins Lager")
	eq(t.Eff, Config.Tower.Efficiency.Max, "Effizienz geklemmt auf den Deckel")
	eq(t.Vault, 0)
	eq(t.Skin, Config.Tower.DefaultSkin)
	eq(#t.Private, 1, "nur gültige Privat-Etagen")
	eq(#t.Express, 1)
	eq(t.Name.A, 1)
	eq(t.Name.N, 1)
	eq(data.Boosts.X2, 0)
end

Tests["Deko: feste Plätze, Lager, Austausch"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env, account = fakeEnv({ Credits = 1e9, Storage = { sofa = 1, desk = 1 } })
	buildFloors(services, data, env, 3)
	local ok, key = c.SetDecor(data.Tower, env, 2, 4, "sofa")
	eq(key, "core.invalid", "nur 3 Plätze je Etage")
	eq(c.SetDecor(data.Tower, env, 2, 3, "sofa"), true)
	eq(account.Storage.sofa, 0)
	eq(data.Tower.Floors[2].D[3], "sofa")
	eq(data.Tower.Floors[2].D[1], "", "Lücken als leere Plätze")
	ok, key = c.SetDecor(data.Tower, env, 2, 1, "sofa")
	eq(ok, false)
	eq(key, "tower.decorNone", "nichts im Lager")
	eq(c.SetDecor(data.Tower, env, 2, 3, "desk"), true, "austauschen")
	eq(account.Storage.sofa, 1, "altes Teil zurück ins Lager")
	eq(c.SetDecor(data.Tower, env, 2, 3, nil), true, "entfernen")
	eq(account.Storage.desk, 1)
	eq(#data.Tower.Floors[2].D, 0, "leere Plätze am Ende entfernt")
end

Tests["Privat-Etagen höchstens 5"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env = fakeEnv({ Credits = 1e9 })
	buildFloors(services, data, env, 8)
	for floor = 1, 5 do
		eq(c.SetPrivate(data.Tower, floor, true), true)
	end
	local ok, key = c.SetPrivate(data.Tower, 6, true)
	eq(ok, false)
	eq(key, "tower.privateMax")
	eq(c.SetPrivate(data.Tower, 3, false), true)
	eq(c.SetPrivate(data.Tower, 6, true), true)
	ok, key = c.SetPrivate(data.Tower, 20, true)
	eq(key, "tower.noFloor")
end

Tests["Auto-Plan schlägt bessere Belegung vor (ändert nichts)"] = function(services)
	local c = core(services)
	local data = newData(services)
	local env = fakeEnv({ Credits = 1e12, Licence = 10 })
	buildFloors(services, data, env, 10)
	local plan, gain, cost = c.AutoPlan(data.Tower, c.Stage(data.Tower), 1, nil)
	eq(#plan, 10)
	truthy(gain > 0, "Gewinn > 0")
	truthy(cost > 0, "Wechsel kosten etwas")
	eq(data.Tower.Floors[1].R, Config.Tower.DefaultRoom, "Plan ändert den Tower nicht")
	local desks = 0
	for _, key in ipairs(plan) do
		if key == "Desk" then
			desks += 1
		end
	end
	truthy(desks >= 5, "Trading-Desk ist die beste Grundbelegung")
end

Tests["Config.Tower: Live-Felder und Pflicht-Schlüssel"] = function()
	local t = Config.Tower
	for _, key in ipairs({ "Bull", "Parade", "BellMoment", "EventMax", "TimedCap" }) do
		truthy(Util.IsFinite(t.Mult[key]), "Config.Tower.Mult." .. key)
	end
	truthy(t.Mult.EventMax <= 3, "Event ≤ ×3")
	truthy(t.Mult.TimedCap <= 10, "Zeitlich ≤ ×10")
	eq(#t.Stages, 12)
	eq(#t.Rooms, 11)
	eq(t.Efficiency.Max, 20)
	eq(t.CollectRange, 70)
	local errors = t.Validate(Config)
	truthy(#errors == 0, "Config.Tower.Validate: " .. table.concat(errors, " | "))
end

return Tests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">VisualTests</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Selbsttests Turm-Optik & Lifestyle (Server/Tests/VisualTests)
--  Besitzer: WP8 (Turm-Optik, Interiors, Lifestyle). Vertrag: DESIGN.md §D WP8 "Abnahme"/"Tests": Teilebudget je
--  Stufe (Hülle ≤ 8/Etage, Krone ≤ 60, Plot-Ausstattung ≤ 40, 10 Tower ≤ 4.600), Interior ≤ 150 Parts je Etage,
--  Layout-Rundreise ≤ 2 KB, Rezepte deterministisch; dazu Deko-/Lifestyle-Konfiguration, Uhren 6–10 Parts
--  (Massless, ohne Kollision), Lager-Logik (Nehmen/Zurückgeben/Rabatt), Asset-Platz 0 -> Code-Rezept.
--  SelfTestService lädt dieses Modul; jeder Fehler = FAIL. Keine Spieler, keine echten Spielstände.
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Lang = require(Shared:WaitForChild("Lang"))
local TowerModels = require(Shared:WaitForChild("TowerModels"))
local DecorModels = require(Shared:WaitForChild("DecorModels"))
local LifestyleModels = require(Shared:WaitForChild("LifestyleModels"))

local ROOMS =
	{ "Office", "Desk", "Cafe", "Garage", "Marketing", "Vault", "Lab", "Server", "Lounge", "BotLab", "Penthouse" }
local STAGE_LAST = { 1, 3, 6, 9, 13, 17, 21, 25, 30, 36, 43, 50 }

local function eq(actual: any, expected: any, label: string?)
	if actual ~= expected then
		error(("%s erwartet %s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function truthy(value: any, label: string)
	if not value then
		error(label, 2)
	end
end

local function same(a: any, b: any): boolean
	if type(a) ~= type(b) then
		return false
	end
	if type(a) ~= "table" then
		return a == b
	end
	for k, v in pairs(a) do
		if not same(v, b[k]) then
			return false
		end
	end
	for k in pairs(b) do
		if a[k] == nil then
			return false
		end
	end
	return true
end

local function serviceModule(services: any, name: string): any
	local svc = services and services[name]
	if svc then
		return svc
	end
	local module = script.Parent.Parent:WaitForChild("Services"):FindFirstChild(name)
	assert(module and module:IsA("ModuleScript"), name .. " fehlt")
	return require(module) :: any
end

-- die 8 größten Deko-Teile (schlimmster Fall für das Interior-Budget)
local function biggestDecor(): { string }
	local list = {}
	for _, entry in ipairs(Config.Decor.Items) do
		table.insert(list, { Key = entry.Key, N = #DecorModels.Specs(entry.Key) })
	end
	table.sort(list, function(a, b)
		return a.N > b.N
	end)
	local out = {}
	for i = 1, math.min(8, #list) do
		out[i] = list[i].Key
	end
	return out
end

local Tests = {}

-- 1) Hülle: ≤ 8 Parts je Etage, Krone ≤ 60, Plot-Ausstattung ≤ 40, ein Tower ≤ 460, 10 Tower ≤ 4.600 (§B3)
function Tests.ShellBudgetPerStage()
	local limits = TowerModels.LIMITS
	local worst = 0
	for stage, last in ipairs(STAGE_LAST) do
		local first = if stage == 1 then 1 else STAGE_LAST[stage - 1] + 1
		for floors = first, last do
			local total, maxFloor, _spine, crown, site = TowerModels.Count(stage, floors)
			truthy(
				maxFloor <= limits.ShellPerFloor,
				("Stufe %d/%d Etagen: %d Parts je Etage"):format(stage, floors, maxFloor)
			)
			truthy(crown <= limits.Crown, ("Stufe %d: Krone %d Parts"):format(stage, crown))
			truthy(site <= limits.Site, ("Stufe %d: Plot-Ausstattung %d Parts"):format(stage, site))
			truthy(total <= limits.TowerTotal, ("Stufe %d/%d Etagen: %d Parts gesamt"):format(stage, floors, total))
			worst = math.max(worst, total)
		end
	end
	truthy(worst * 10 <= limits.AllTowers, ("10 Tower × %d Parts > 4.600"):format(worst))
	truthy(#TowerModels.Site(1, 0, "GlassBlue", "Accent") <= limits.Site, "Bauplatz-Ausstattung zu groß")
end

-- 2) Jede Fassade/jedes Neon baut fehlerfrei und im Budget
function Tests.SkinsAndNeonBuild()
	for _, skin in ipairs(TowerModels.Skins()) do
		for _, neon in ipairs(Config.Tower.Neon) do
			for _, stage in ipairs({ 1, 4, 8, 12 }) do
				local n = #TowerModels.Shell(stage, STAGE_LAST[stage], skin, neon.Key)
				truthy(n >= 5 and n <= 8, ("Hülle %s/%s Stufe %d: %d Parts"):format(skin, neon.Key, stage, n))
			end
		end
	end
	for _, crown in ipairs(Config.Tower.Crowns) do
		truthy(#TowerModels.Crown(12, crown.Key, 50, "GlassBlue", "Accent") <= 60, "Krone " .. crown.Key .. " > 60")
	end
end

-- 3) Interior ≤ 150 Parts je Etage für alle Räume × Stufen × Grundrisse (volles Personal, größte Deko)
function Tests.InteriorBudget()
	local decor = biggestDecor()
	for _, room in ipairs(ROOMS) do
		for level = 1, 5 do
			for _, footprint in ipairs({ 40, 48, 52, 56 }) do
				for _, floor in ipairs({ 1, 2, 50 }) do
					local n =
						#TowerModels.Interior(room, level, { "Quant", "Senior", "Analyst" }, decor, footprint, floor)
					truthy(n <= TowerModels.LIMITS.Interior, ("%s L%d %d: %d Parts"):format(room, level, footprint, n))
					truthy(n >= 10, ("%s L%d: zu leer (%d)"):format(room, level, n))
				end
			end
		end
	end
end

-- 4) Rezepte deterministisch (gleiche Eingabe -> gleiche Specs auf Server und Client)
function Tests.RecipesDeterministic()
	truthy(same(TowerModels.Shell(9, 27, "HoloPrism", "Cyan"), TowerModels.Shell(9, 27, "HoloPrism", "Cyan")), "Shell")
	truthy(same(TowerModels.Spine(12, 50, "Obsidian", "Gold"), TowerModels.Spine(12, 50, "Obsidian", "Gold")), "Spine")
	truthy(
		same(TowerModels.Crown(10, "Gold", 33, "Polar", "Up"), TowerModels.Crown(10, "Gold", 33, "Polar", "Up")),
		"Crown"
	)
	local a = TowerModels.Interior("Desk", 4, { "Intern" }, { "DeskStartup", "", "AquariumSmall" }, 56, 7)
	local b = TowerModels.Interior("Desk", 4, { "Intern" }, { "DeskStartup", "", "AquariumSmall" }, 56, 7)
	truthy(same(a, b), "Interior")
	truthy(same(DecorModels.Specs("Chandelier"), DecorModels.SpecsFor(Config.Decor.ByKey.Chandelier.Recipe)), "Deko")
end

-- 5) Layout-Rundreise (§C12.3) und Obergrenze 2 KB
function Tests.LayoutRoundTrip()
	local floors = {}
	for i = 1, 50 do
		floors[i] = {
			R = if i == 50 then "Penthouse" elseif i % 3 == 0 then "Cafe" else "Desk",
			L = (i % 5) + 1,
			S = { "Quant", "Senior", "Intern" },
			D = { "TrophyDiamond", "", "KoiPond" },
		}
	end
	-- Penthouse: 8 Plätze (§B4.8)
	floors[50].D = { "TrophyDiamond", "SofaVelvet", "", "Bonsai", "GlobeBrass", "", "RugGeo", "NeonTree" }
	local text = TowerModels.EncodeLayout(floors, { 2, 4 })
	truthy(#text <= TowerModels.LIMITS.LayoutBytes, ("Layout %d Bytes"):format(#text))
	local decoded = TowerModels.DecodeLayout(text)
	eq(#decoded, 50, "Etagen")
	eq(decoded[2].Private, true, "Privat 2")
	eq(decoded[3].Private, false, "Privat 3")
	eq(decoded[3].Room, "Cafe", "Raum 3")
	eq(decoded[1].Level, 2, "Stufe 1")
	eq(decoded[1].Staff[1], "Quant", "Personal")
	eq(decoded[1].Decor[2], "", "leerer Platz")
	eq(decoded[1].Decor[3], "KoiPond", "Deko 3")
	eq(decoded[50].Room, "Penthouse", "Penthouse")
	eq(decoded[50].Decor[8], "NeonTree", "Penthouse-Platz 8")
	eq(decoded[50].Decor[1], "TrophyDiamond", "Penthouse-Platz 1")
	-- kaputte Eingaben -> nie ein Fehler
	truthy(type(TowerModels.DecodeLayout("x;;!:9:ZZ:,,,")) == "table", "kaputtes Layout")
	eq(#TowerModels.DecodeLayout(""), 0, "leeres Layout")
	-- extremer Fall: TowerVisualService kürzt notfalls die Deko (Raum/Stufe/Personal bleiben)
	local tvs = serviceModule(nil, "TowerVisualService")
	local huge = {}
	for i = 1, 50 do
		huge[i] = { R = "Penthouse", L = 5, S = { "Quant", "Quant", "Quant" }, D = table.create(16, "TrophyDiamond") }
	end
	local trimmed = tvs._Test.Layout({ Floors = huge, Private = { 1, 2, 3, 4, 5 } })
	truthy(#trimmed <= 2048, "gekürztes Layout > 2 KB")
	eq(#TowerModels.DecodeLayout(trimmed), 50, "gekürztes Layout behält alle Etagen")
end

-- 6) Deko-Konfiguration: 68 Teile, jedes Rezept existiert und bleibt klein
function Tests.DecorConfigAndRecipes()
	local errors = Config.Decor.Validate(Config)
	eq(#errors, 0, "Config.Decor.Validate: " .. (errors[1] or ""))
	eq(#Config.Decor.Items, 68, "Deko-Teile")
	for _, entry in ipairs(Config.Decor.Items) do
		truthy(DecorModels.Has(entry.Recipe.Kind), "Rezept fehlt: " .. entry.Recipe.Kind)
		local n = #DecorModels.Specs(entry.Key)
		truthy(n >= 3 and n <= 14, ("%s: %d Parts"):format(entry.Key, n))
		eq(Config.Decor[entry.Key], entry, "Config.Decor[key] (§C12.3)")
	end
end

-- 7) Asset-Platz 0 -> Code-Rezept (Model mit Teilen, Pivot im Ursprung)
function Tests.DecorBuildUsesRecipe()
	local model = DecorModels.Build("GlobeBrass")
	truthy(model:IsA("Model"), "Model erwartet")
	local parts = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			parts += 1
		end
	end
	eq(parts, #DecorModels.Specs("GlobeBrass"), "Teile im Rezept-Model")
	model:Destroy()
end

-- 8) Uhren: 6–10 Parts, unverankert, Massless, ohne Kollision/Abfrage/Berührung, Zeiger-Welds
function Tests.WatchesAndAccessories()
	local errors = Config.Lifestyle.Validate(Config)
	eq(#errors, 0, "Config.Lifestyle.Validate: " .. (errors[1] or ""))
	for _, entry in ipairs(Config.Lifestyle.Watches) do
		local model = LifestyleModels.Watch(entry.Key)
		local parts = 0
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				parts += 1
				truthy(
					not d.Anchored and d.Massless and not d.CanCollide and not d.CanQuery and not d.CanTouch,
					entry.Key .. ": Physik"
				)
			end
		end
		truthy(parts >= 6 and parts <= 10, ("%s: %d Parts"):format(entry.Key, parts))
		truthy(model.PrimaryPart ~= nil, entry.Key .. ": PrimaryPart")
		truthy(
			model:FindFirstChild("HourWeld", true) ~= nil and model:FindFirstChild("MinuteWeld", true) ~= nil,
			entry.Key .. ": Zeiger"
		)
		model:Destroy()
	end
	for _, entry in ipairs(Config.Lifestyle.Accessories) do
		local model = LifestyleModels.Accessory(entry.Key)
		truthy(model.PrimaryPart ~= nil, entry.Key .. ": PrimaryPart")
		model:Destroy()
	end
end

-- 9) Lager-Logik (TakeDecor/ReturnDecor-Kern), Komfort, Rabatt
function Tests.StorageCore()
	local core = serviceModule(nil, "LifestyleService")._Test.Core
	local data: any = { Life = {}, Storage = { Decor = { Bonsai = 2, Kaputt = 0 / 0 } }, Tower = { Floors = {} } }
	core.Repair(data)
	eq(data.Storage.Decor.Kaputt, nil, "NaN entfernt")
	eq(core.Take(data, "Bonsai"), true, "nehmen 1")
	eq(core.Take(data, "Bonsai"), true, "nehmen 2")
	eq(core.Take(data, "Bonsai"), false, "Lager leer")
	eq(data.Storage.Decor.Bonsai, nil, "Schlüssel bei 0 entfernt")
	eq(core.Give(data, "Bonsai", 3), true, "zurück")
	eq(core.Count(data, "Bonsai"), 3, "Anzahl")
	eq(core.Give(data, "Bonsai", 1.5), false, "nur ganze Stück")
	data.Tower.Floors = {
		{ R = "Office", L = 1, S = {}, D = { "Bonsai", "", "Gong" } },
		{ R = "Cafe", L = 1, S = {}, D = { "Bonsai" } },
	}
	local placed = core.Placed(data)
	eq(placed.Bonsai, 2, "platziert")
	eq(placed.Gong, 1, "platziert Gong")
	eq(core.Discount(0), 0, "kein Rabatt")
	eq(core.Discount(5), 0.25, "Vorstand 5 = −25 %")
	eq(core.Discount(99), 0.25, "Rabatt geklemmt")
	eq(core.Price(50000, 0.25), 37500, "Preis mit Rabatt")
	eq(core.Price(1, 0.9), 1, "Mindestpreis 1 CR")
	data.Life = {
		Watches = { "Copper" },
		Accessories = { TiePin = true },
		Equipped = { Watch = 7, Acc = { "A", "A", "B", "C", "D" } },
	}
	core.Repair(data)
	eq(data.Life.Watches.Copper, true, "Liste -> Menge")
	eq(data.Life.Equipped.Watch, "", "kaputte Uhr -> leer")
	eq(#data.Life.Equipped.Acc, 3, "max. 3 Accessoires, ohne Doppelte")
	local svc = serviceModule(nil, "LifestyleService")
	for _, entry in ipairs(Config.Decor.Items) do
		local comfort = svc.Comfort(entry.Key)
		truthy(comfort >= 1 and comfort <= 5, entry.Key .. ": Komfort " .. comfort)
	end
	eq(svc.Comfort("GibtEsNicht"), 0, "unbekannt = 0")
end

-- 10) PartSpec -> BasePart überträgt alle Eigenschaften
function Tests.InstantiateSpec()
	local spec = TowerModels.Shell(5, 12, "GlassBlue", "Gold")[1]
	local part = TowerModels.Instantiate(spec, CFrame.new(10, 0, 0), nil)
	truthy(part.Anchored, "verankert")
	eq(part.CanCollide, spec.Collide == true, "Kollision")
	truthy(math.abs(part.Size.X - spec.Size[1]) < 1e-3, "Größe")
	truthy(math.abs(part.Position.X - (10 + spec.Pos[1])) < 1e-3, "Position mit Ursprung")
	eq(part:GetAttribute("Tag"), spec.Tag, "Tag-Attribut")
	part:Destroy()
end

-- 11) Alle WP8-Texte in beiden Sprachen
function Tests.LangKeys()
	for _, key in ipairs({
		"tui.title",
		"tui.tab.overview",
		"tui.tab.floors",
		"tui.tab.facade",
		"tui.build",
		"tui.elevator.title",
		"tui.welcome.title",
		"tui.future.title",
		"life.title",
		"life.tab.watches",
		"life.notForSale",
		"life.noCredits",
		"life.accFull",
		"life.boughtWorn",
	}) do
		truthy(Lang.Has(key), "Lang-Schlüssel fehlt: " .. key)
		truthy(Lang.T("de", key) ~= key and Lang.T("en", key) ~= key, "Text fehlt in einer Sprache: " .. key)
	end
end

return Tests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">WorldTests</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Selbsttests Stadt, Grafik, Fahrzeuge (Server/Tests/WorldTests)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §D WP7 "Tests" (Teilezahl, Anker vorhanden, Plot-Seiten 10,
--  Kollisionsgruppen-Matrix, Routen geschlossen), §C17 (SelfTest), §B3 (Teilebudget ≤ 12.000), §C11.3, §B12.1.
--  SelfTestService lädt dieses Modul; jeder Fehler (error/assert) = FAIL. Tests warten höchstens 60 s auf den Stadtbau.
--  Keine Spieler nötig: Fahrzeug-Regeln über VehicleService._Test, Modelle über Shared/VehicleModels (ohne Workspace).
-- =====================================================================

local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Lang = require(Shared:WaitForChild("Lang")) :: any
local VehicleModels = require(Shared:WaitForChild("VehicleModels")) :: any

local READY_WAIT = 60
local ANCHORS = {
	"Bell",
	"BellZone",
	"TowerTour",
	"Showroom",
	"Boutique",
	"Helipad",
	"Marina",
	"Lookout",
	"PressScreen",
	"IpoWall",
	"HallOfFame",
	"Academy",
	"VipBalcony",
	"Rooftop",
	"Spawn",
}
local BOARDS = {
	"Wealth",
	"League",
	"Return",
	"Skyline",
	"Firm",
	"Respekt",
	"IpoWall",
	"PressScreen",
	"HallOfFame",
	"Hall1",
	"Hall2",
	"Hall3",
	"TowerTour",
}

local function eq(actual: any, expected: any, label: string?)
	if actual ~= expected then
		error(("%s erwartet %s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function near(actual: number, expected: number, tolerance: number, label: string?)
	if math.abs(actual - expected) > tolerance then
		error(("%s erwartet ≈%s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function truthy(value: any, label: string)
	if not value then
		error(label, 2)
	end
end

local function serviceModule(services: any, name: string): any
	local svc = services and services[name]
	if svc then
		return svc
	end
	local module = script.Parent.Parent:WaitForChild("Services"):FindFirstChild(name)
	assert(module and module:IsA("ModuleScript"), name .. " fehlt")
	return require(module) :: any
end

local function readyCity(services: any): any
	local city = serviceModule(services, "CityService")
	local started = os.clock()
	while not city.Ready() and os.clock() - started < READY_WAIT do
		task.wait(0.25)
	end
	truthy(city.Ready(), "Stadt nach 60 s nicht fertig gebaut")
	return city
end

local function newData(services: any): { [string]: any }
	return serviceModule(services, "DataService").DefaultData()
end

local Tests = {}

-- ---------------------------------------------------------------------
-- STADT
-- ---------------------------------------------------------------------
function Tests.CityPartBudget(services: any)
	local city = readyCity(services)
	local parts = city.PartCount()
	truthy(parts > 1000, "Stadt hat zu wenige Teile: " .. tostring(parts))
	truthy(
		parts <= Config.City.PartBudget,
		("Teilebudget überschritten: %d > %d"):format(parts, Config.City.PartBudget)
	)
	truthy(Config.City.PartBudget <= 12000, "PartBudget > 12.000 (§B3)")
	truthy(Config.City.BuildPerFrame <= 400, "BuildPerFrame > 400 (§B3)")
end

function Tests.AnchorsPresent(services: any)
	local city = readyCity(services)
	local folder = city.Folder()
	truthy(folder, "Stadt-Ordner fehlt")
	local found: { [string]: boolean } = {}
	for _, inst in ipairs(folder:GetDescendants()) do
		local name = inst:GetAttribute("Anchor")
		if type(name) == "string" then
			found[name] = true
		end
	end
	for _, name in ipairs(ANCHORS) do
		local cf = city.Anchor(name)
		truthy(typeof(cf) == "CFrame", "Anker fehlt: " .. name)
		truthy(found[name], "Anker-Teil mit Attribut fehlt: " .. name)
	end
	for _, anchorName in pairs(Config.City.Shops) do
		truthy(typeof(city.Anchor(anchorName)) == "CFrame", "Laden-Anker fehlt: " .. anchorName)
	end
	near(city.Anchor("Spawn").Position.Y, Config.City.Levels.Walk, 0.01, "Spawn-Fußpunkt")
	eq(city.Anchor("Unbekannt"), nil, "unbekannter Anker")
end

function Tests.PlotSites10(services: any)
	local city = serviceModule(services, "CityService")
	local plots = Config.City.Plots
	eq(plots.Count, 10, "Plots")
	local seen: { Vector3 } = {}
	for k = 1, plots.Count do
		local cf = city.PlotSite(k)
		truthy(typeof(cf) == "CFrame", "PlotSite " .. k)
		local pos = cf.Position
		near(Vector3.new(pos.X, 0, pos.Z).Magnitude, plots.Radius, 0.5, "Plot-Radius " .. k)
		local deg = math.deg(math.atan2(pos.Z, pos.X)) % 360
		local expected = (plots.StartAngle + (k - 1) * plots.Step) % 360
		near(((deg - expected + 180) % 360) - 180, 0, 0.5, "Plot-Winkel " .. k)
		local toCenter = (Vector3.new(0, pos.Y, 0) - pos).Unit
		truthy(cf.LookVector:Dot(toCenter) > 0.99, "Plot " .. k .. " blickt nicht zur Plaza")
		for _, other in ipairs(seen) do
			truthy((other - pos).Magnitude > plots.Size, "Plots überlappen")
		end
		table.insert(seen, pos)
		near((Config.City.PlotCFrame(k).Position - pos).Magnitude, 0, 0.01, "PlotCFrame == PlotSite " .. k)
	end
	local okPlot, plotService = pcall(serviceModule, services, "PlotService")
	if okPlot and type(plotService) == "table" and type(plotService.PlotCFrame) == "function" then
		for k = 1, plots.Count do
			near(
				(plotService.PlotCFrame(k).Position - city.PlotSite(k).Position).Magnitude,
				0,
				0.01,
				"PlotService " .. k
			)
		end
	end
end

function Tests.CollisionMatrix(services: any)
	local vehicleService = serviceModule(services, "VehicleService")
	truthy(vehicleService._Test.GroupsReady(), "Kollisionsgruppen nicht registriert")
	local function collidable(a: string, b: string): boolean
		return PhysicsService:CollisionGroupsAreCollidable(a, b)
	end
	for _, name in ipairs({ "Characters", "Cars", "World", "Pickups" }) do
		truthy(PhysicsService:IsCollisionGroupRegistered(name), "Gruppe fehlt: " .. name)
	end
	eq(collidable("Cars", "Characters"), false, "Cars×Characters")
	eq(collidable("Cars", "Cars"), false, "Cars×Cars")
	eq(collidable("Cars", "World"), true, "Cars×World")
	eq(collidable("Cars", "Default"), true, "Cars×Default")
	for _, other in ipairs({ "Default", "Characters", "Cars", "World", "Pickups" }) do
		eq(collidable("Pickups", other), false, "Pickups×" .. other)
	end
end

function Tests.RoutesClosed(services: any)
	local city = serviceModule(services, "CityService")
	for name, def in pairs(Config.City.Routes) do
		local points = city.Route(name)
		truthy(#points >= 9, "Route " .. name .. " zu kurz")
		near((points[1] - points[#points]).Magnitude, 0, 0.001, "Route " .. name .. " geschlossen")
		local maxSeg = 0
		for i = 1, #points - 1 do
			maxSeg = math.max(maxSeg, (points[i + 1] - points[i]).Magnitude)
		end
		truthy(maxSeg < def.Spacing * 2, ("Route %s: Lücke %.1f"):format(name, maxSeg))
	end
	-- Ring-Boulevard weicht dem Börsensaal aus (Mittellinie außerhalb Halle + Gehweg + halbe Fahrbahn)
	local ex = Config.City.Zones.Exchange
	local halfW = ex.Width / 2 + Config.City.Roads.Ring.Width / 2
	local back = ex.Center.Z - ex.Depth / 2 - Config.City.Roads.Ring.Width / 2
	local front = ex.Center.Z + ex.Depth / 2
	for _, p in ipairs(city.Route("Ring")) do
		local inside = math.abs(p.X) < halfW and p.Z > back and p.Z < front
		truthy(not inside, ("Ring-Punkt im Börsensaal: %.0f, %.0f"):format(p.X, p.Z))
	end
end

function Tests.BoardsShopsMonitors(services: any)
	local city = readyCity(services)
	for _, name in ipairs(BOARDS) do
		local part = city.BoardPart(name)
		truthy(part and part:IsA("BasePart"), "Board-Fläche fehlt: " .. name)
		eq(part:GetAttribute("Board"), name, "Board-Attribut " .. name)
	end
	for instId in pairs(Config.City.Shops) do
		local part = city.ShopPart(instId)
		truthy(part and part:IsA("BasePart"), "Laden-Front fehlt: " .. tostring(instId))
		eq(part:GetAttribute("Shop"), instId, "Laden-Attribut")
	end
	local kinds: { [string]: number } = {}
	local monitors = 0
	local shopTickers, windowsTagged, budgetLights = 0, 0, 0
	for _, inst in ipairs(city.Folder():GetDescendants()) do
		local monitor = inst:GetAttribute("Monitor")
		if monitor ~= nil and inst:IsA("BasePart") then
			monitors += 1
			if type(monitor) == "string" then
				kinds[monitor] = (kinds[monitor] or 0) + 1
			end
		end
		if inst:GetAttribute("ShopTicker") ~= nil then
			shopTickers += 1
		end
		if inst:GetAttribute("WindowLight") ~= nil then
			windowsTagged += 1
		end
		if inst:IsA("Light") and inst:GetAttribute("Budget") == true then
			budgetLights += 1
			eq(inst.Enabled, false, "Budget-Licht muss serverseitig aus sein")
		end
	end
	truthy(monitors >= 41, "zu wenige Monitor-Teile: " .. monitors)
	eq(kinds.Candles, 1, "Kerzentafel")
	eq(kinds.Heatmap, 1, "Heatmap-Wand")
	eq(kinds.Ticker, 4, "Ticker-Wände")
	eq(kinds.TickerRing, 16, "Tickerring")
	eq(kinds.Chart, 8, "Terminal-Pulte")
	eq(shopTickers, 6, "Laden-Ticker-Plätze")
	truthy(windowsTagged >= 36, "Fensterlicht-Teile fehlen")
	truthy(budgetLights > 50, "Laternen fehlen")
end

function Tests.ConfigValidate(_services: any)
	local cityErrors = Config.City.Validate(Config)
	eq(#cityErrors, 0, "Config.City.Validate: " .. tostring(cityErrors[1]))
	local carErrors = Config.Vehicles.Validate(Config)
	eq(#carErrors, 0, "Config.Vehicles.Validate: " .. tostring(carErrors[1]))
end

-- ---------------------------------------------------------------------
-- FAHRZEUGE
-- ---------------------------------------------------------------------
function Tests.ClassCaps(_services: any)
	local expected = { Kompakt = 60, Limousine = 75, Sport = 95, Super = 120, Hyper = 150 }
	for class, cap in pairs(expected) do
		eq(Config.Vehicles.Classes[class], cap, "Klasse " .. class)
	end
	eq(#Config.Vehicles.Cars, 16, "16 Autos")
	for _, car in ipairs(Config.Vehicles.Cars) do
		eq(Config.Vehicles.Cap(car.Key), expected[car.Class], "Deckel " .. car.Key)
		truthy(VehicleModels.Recipes[car.Recipe] ~= nil, "Bauplan fehlt: " .. car.Key)
		truthy(Lang.Pick("de", car.Name) ~= "" and Lang.Pick("en", car.Name) ~= "", "Name fehlt: " .. car.Key)
	end
	eq(Config.Vehicles.Cap("Lam1"), 150, "Λ-1 nie schneller als Hyper")
	truthy(Config.Vehicles.Boost.Mult < Config.Vehicles.SpeedCheck.Factor, "Boost unter Prüf-Grenze")
end

function Tests.VehicleModelsBuild(_services: any)
	for _, car in ipairs(Config.Vehicles.Cars) do
		local model = VehicleModels.Build(car.Key)
		truthy(model:IsA("Model"), "Build " .. car.Key)
		local chassis = model:FindFirstChild("Chassis")
		truthy(chassis and model.PrimaryPart == chassis, "Chassis " .. car.Key)
		local seat = model:FindFirstChild("Seat")
		truthy(seat and seat:IsA("VehicleSeat"), "VehicleSeat " .. car.Key)
		eq((seat :: VehicleSeat).CanTouch, false, "Sitz nur per Prompt")
		local parts = 0
		for _, inst in ipairs(model:GetDescendants()) do
			if inst:IsA("BasePart") then
				parts += 1
			end
		end
		truthy(parts <= 60, ("%s: %d Teile (> 60)"):format(car.Key, parts))
		for _, wheel in ipairs({ "FL", "FR", "RL", "RR" }) do
			truthy(model:FindFirstChild("Wheel_" .. wheel), car.Key .. " Rad " .. wheel)
		end
		-- Lack + Spoiler live umschaltbar
		local body = model:FindFirstChild("Body") :: BasePart
		VehicleModels.ApplyTune(model, car.Key, { Paint = "Red", Spoiler = true, Glow = "Blue", Rims = "NeonBlue" })
		if body:GetAttribute("Paint") == true then
			eq(body.Color, Config.Vehicles.Option("Paint", "Red").Color, car.Key .. " Lack")
		end
		eq(model:GetAttribute("Spoiler"), true, car.Key .. " Spoiler an")
		eq(model:GetAttribute("Glow"), "Blue", car.Key .. " Unterbodenlicht")
		VehicleModels.ApplyTune(model, car.Key, { Spoiler = false, Glow = "Off" })
		eq(model:GetAttribute("Spoiler"), false, car.Key .. " Spoiler aus")
		local light = (chassis :: Instance):FindFirstChild("Underglow")
		truthy(light and light:GetAttribute("Budget") == false, car.Key .. " Unterbodenlicht aus = kein Budget")
		model:Destroy()
	end
end

function Tests.VehicleRig(_services: any)
	local model = VehicleModels.Build("QuasarX")
	-- Drehpunkt = Bodenmitte: PivotTo auf den Spawnpunkt setzt die Räder auf den Boden
	truthy(math.abs(model:GetPivot().Position.Y) < 0.01, "Drehpunkt auf Bodenhöhe")
	model:PivotTo(CFrame.new(0, 500, 0))
	local rig = VehicleModels.Rig(model, "QuasarX")
	local motors, steer = 0, 0
	for _ in pairs(rig.Motors) do
		motors += 1
	end
	for _ in pairs(rig.Steer) do
		steer += 1
	end
	eq(motors, 4, "4 Rad-Motoren")
	eq(steer, 2, "Servo-Lenkung vorn")
	eq(#rig.Springs, 4, "4 Federn")
	truthy(rig.Mass > 0, "Masse")
	for _, inst in ipairs(model:GetDescendants()) do
		if inst:IsA("BasePart") then
			eq(inst.CollisionGroup, "Cars", "Kollisionsgruppe " .. inst.Name)
			eq(inst.Anchored, false, "gelöst " .. inst.Name)
		end
	end
	for _, motor in pairs(rig.Motors) do
		eq(motor.ActuatorType, Enum.ActuatorType.Motor, "Motor")
	end
	for _, servo in pairs(rig.Steer) do
		eq(servo.ActuatorType, Enum.ActuatorType.Servo, "Servo")
	end
	model:Destroy()
end

function Tests.GarageRules(services: any)
	local helpers = serviceModule(services, "VehicleService")._Test
	local data = newData(services)
	eq(helpers.SlotsFor(data, false), Config.Vehicles.GarageBase, "Grund-Plätze")
	data.Tower.Floors = {
		{ R = "Garage", L = 1, S = {}, D = {} },
		{ R = "Office", L = 1, S = {}, D = {} },
		{ R = "Garage", L = 1, S = {}, D = {} },
		{ R = "Garage", L = 1, S = {}, D = {} },
	}
	eq(helpers.GarageLevels(data), Config.Vehicles.GarageLevelsMax, "Garagen-Ebenen gedeckelt")
	local withLevels = Config.Vehicles.GarageBase + Config.Vehicles.GarageLevelsMax * Config.Vehicles.GarageLevelSlots
	eq(helpers.SlotsFor(data, false), withLevels, "Plätze mit Ebenen")
	eq(helpers.SlotsFor(data, true), withLevels + Config.Vehicles.MegaGarageSlots, "Mega-Garage")
	eq(helpers.UsedSlots(data), 1, "Gratis-Auto belegt einen Platz")
	-- Aktionärs-Rabatt nur auf Velocitra-Autos
	local velocitra = Config.Vehicles.Car("VelocitraS")
	local price, saved = helpers.PriceFor(velocitra, true)
	eq(saved, math.floor(velocitra.Price * Config.Vehicles.ShareholderDiscount.Pct), "Rabatt")
	eq(price, velocitra.Price - saved, "Endpreis")
	local stratos = Config.Vehicles.Car("Stratos")
	local p2, s2 = helpers.PriceFor(stratos, true)
	eq(s2, 0, "kein Rabatt für andere Marken")
	eq(p2, stratos.Price, "voller Preis")
	-- Tuning
	local current = helpers.TuneDefaults("Stratos")
	local ok, reason = helpers.EvaluateTune("Stratos", current, {}, false, false)
	eq(ok, false, "keine Änderung")
	eq(reason, "car.tuneNothing", "Grund keine Änderung")
	local okVip, reasonVip = helpers.EvaluateTune("Stratos", current, { Paint = "Platin" }, false, false)
	eq(okVip, false, "VIP-Lack gesperrt")
	eq(reasonVip, "car.tuneVip", "Grund VIP")
	local okClub, reasonClub = helpers.EvaluateTune("Stratos", current, { Paint = "ClubNoir" }, true, false)
	eq(okClub, false, "Club-Lack gesperrt")
	eq(reasonClub, "car.tuneClub", "Grund Club")
	local okPaint, _, result, cost =
		helpers.EvaluateTune("Stratos", current, { Paint = "BlueM", Glow = "Cyan" }, false, false)
	eq(okPaint, true, "Lack + Unterboden")
	eq(result.Paint, "BlueM", "neuer Lack")
	eq(
		cost,
		Config.Vehicles.TunePrice("Stratos", "Paint", "BlueM") + Config.Vehicles.TunePrice("Stratos", "Glow", "Cyan"),
		"Tuning-Preis"
	)
	truthy(cost % 1 == 0 and cost > 0 and cost < 1e14, "Tuning-Preis ganzzahlig")
	local okOff, _, _, costOff = helpers.EvaluateTune(
		"Stratos",
		{ Paint = current.Paint, Rims = current.Rims, Glow = "Cyan", Spoiler = true },
		{ Glow = "Off", Spoiler = false },
		false,
		false
	)
	eq(okOff, true, "ausschalten erlaubt")
	eq(costOff, 0, "ausschalten kostet nichts")
	local okBad, reasonBad = helpers.EvaluateTune("Stratos", current, { Rims = "Gibtsnicht" }, false, false)
	eq(okBad, false, "unbekannte Felge")
	eq(reasonBad, "car.tuneUnknown", "Grund unbekannt")
end

function Tests.RequestKeys(services: any)
	local exact = serviceModule(services, "VehicleService")._Test.Exact
	eq(exact({ Key = "LamCity" }, { Key = "string" }, { "Key" }), true, "gültig")
	eq(exact({ Key = "LamCity", Extra = 1 }, { Key = "string" }, { "Key" }), false, "fremder Schlüssel")
	eq(exact({ Key = 5 }, { Key = "string" }, { "Key" }), false, "falscher Typ")
	eq(exact({}, { Key = "string" }, { "Key" }), false, "Pflichtfeld fehlt")
	eq(exact({ Key = string.rep("x", 40) }, { Key = "string" }, { "Key" }), false, "zu lang")
	eq(exact("LamCity", { Key = "string" }, { "Key" }), false, "keine Tabelle")
	eq(exact({ Key = "Stratos", Spoiler = true }, { Key = "string", Spoiler = "boolean" }, { "Key" }), true, "Spoiler")
end

function Tests.LangKeys(_services: any)
	for _, key in ipairs({
		"car.spawned",
		"car.bought",
		"car.garageFull",
		"car.noCredits",
		"car.tuned",
		"car.reveal.title",
		"car.reveal.drive",
		"car.speedReset",
		"car.enter",
		"car.hyperAnnounce",
		"world.prompt.terminal",
		"world.prompt.helipadFly",
		"world.clubOnly",
	}) do
		truthy(Lang.Has(key), "Lang-Schlüssel fehlt: " .. key)
	end
	for _, source in pairs({ "Free", "Shop", "Starter", "Login", "Licence", "Season", "Pass" }) do
		truthy(Lang.Has("car.source." .. source), "Herkunft ohne Text: " .. source)
	end
end

return Tests
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="114">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">CityKit</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Stadt-Baukasten: Specs -> Instanzen (Server/World/CityKit)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §A4 (Materialien, Future-Licht, Neon-Streifen, LED-Wände
--  als SurfaceGui), §B3 (Streaming-Modi je Model), §C14.3 (Asset-Plätze: gesetzte Id ersetzt das Code-Rezept).
--  Baut genau ein Spec (aus CityLayout) zu einem Teil (+ Licht, Schild, Prompt, Partikel, Mesh) – nie yieldend, damit
--  CityService viele davon pro Frame bauen kann. Lichter werden AUS angelegt (Attribut "Budget"): WorldLook schaltet
--  clientseitig nur die nächsten N je Grafikstufe ein (Licht-Budget §C16).
--
--  Öffentliche API (nur WP7):
--    CityKit.GroupModel(group, cityFolder): Model    Model der Gruppe (Streaming-Modus, LOD) – einmal je Gruppe
--    CityKit.Build(spec, model, group): Instance?    ein Spec bauen; Rückgabe = Teil bzw. Ausstellungs-Model
--    CityKit.PlaceAssets(group, model): { [string]: boolean }   gesetzte Asset-Plätze der Gruppe platzieren
--    CityKit.CountParts(root): number                BaseParts unterhalb root (Teilebudget)
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Lang = require(Shared:WaitForChild("Lang")) :: any
local AssetSlot = require(Shared:WaitForChild("AssetSlot")) :: any
local VehicleModels = require(Shared:WaitForChild("VehicleModels")) :: any

local CityKit = {}

local FONT_DISPLAY = Font.new("rbxasset://fonts/families/BuilderExtended.json", Enum.FontWeight.Bold)
local FONT_BODY = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
local SIGN_PPS = 24 -- Pixel je Stud auf Schildern (große Schilder bleiben unter 2048 px)
local MAX_CANVAS = 2000

local subModels: { [any]: { [string]: Model } } = {} -- Gruppe -> Unter-Model-Name -> Model
local assetPlaced: { [any]: { [string]: boolean } } = {} -- Gruppe -> Asset-Platz -> gesetzt

local function modeOf(name: string): Enum.ModelStreamingMode
	if name == "Persistent" then
		return Enum.ModelStreamingMode.Persistent
	elseif name == "Atomic" then
		return Enum.ModelStreamingMode.Atomic
	end
	return Enum.ModelStreamingMode.Default
end

function CityKit.GroupModel(group: any, cityFolder: Instance): Model
	local district = cityFolder:FindFirstChild(group.District)
	if not district then
		local folder = Instance.new("Folder")
		folder.Name = group.District
		folder.Parent = cityFolder
		district = folder
	end
	local model = Instance.new("Model")
	model.Name = group.Key
	-- Streaming-Modus VOR dem Einhängen setzen (§B3)
	pcall(function()
		model.ModelStreamingMode = modeOf(group.Mode)
	end)
	if group.Lod then
		-- Skyline bleibt aus der Ferne sichtbar (in Studio verifizieren, §B3)
		pcall(function()
			(model :: any).LevelOfDetail = Enum.ModelLevelOfDetail.StreamingMesh
		end)
	end
	model:SetAttribute("District", group.District)
	model.Parent = district
	subModels[group] = {}
	assetPlaced[group] = {}
	return model
end

local function subModel(group: any, model: Model, name: string, attrs: { [string]: any }?): Model
	local subs = subModels[group]
	if not subs then
		subs = {}
		subModels[group] = subs
	end
	local existing = subs[name]
	if existing and existing.Parent then
		if attrs then
			for key, value in pairs(attrs) do
				existing:SetAttribute(key, value)
			end
		end
		return existing
	end
	local sub = Instance.new("Model")
	sub.Name = name
	if attrs then
		for key, value in pairs(attrs) do
			sub:SetAttribute(key, value)
		end
	end
	sub.Parent = model
	subs[name] = sub
	return sub
end

-- ---------------------------------------------------------------------
-- DEKORATIONEN
-- ---------------------------------------------------------------------
local function addLight(part: BasePart, spec: any)
	local light: any
	if spec.Kind == "Spot" then
		local spot = Instance.new("SpotLight")
		spot.Angle = spec.Angle or 45
		spot.Face = spec.Face or Enum.NormalId.Front
		light = spot
	elseif spec.Kind == "Surface" then
		local surface = Instance.new("SurfaceLight")
		surface.Angle = spec.Angle or 90
		surface.Face = spec.Face or Enum.NormalId.Bottom
		light = surface
	else
		light = Instance.new("PointLight")
	end
	light.Range = math.clamp(spec.Range or 16, 0, 60)
	light.Brightness = spec.Brightness or 1
	light.Color = spec.Color or Color3.new(1, 1, 1)
	light.Shadows = spec.Shadows == true
	light.Enabled = false -- WorldLook schaltet im Budget ein
	if part:GetAttribute("ShopSpot") == nil then
		light:SetAttribute("Budget", true)
		if spec.NightOnly then
			light:SetAttribute("NightOnly", true)
		end
	end
	light.Parent = part
end

local function addGui(part: BasePart, spec: any)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = spec.Face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	local size = part.Size
	local longest = math.max(size.X, size.Y, size.Z)
	gui.PixelsPerStud = math.min(SIGN_PPS, MAX_CANVAS / math.max(1, longest))
	gui.LightInfluence = 0
	gui.Brightness = 2.2
	gui.MaxDistance = spec.MaxDistance or 600
	gui.ClipsDescendants = true
	gui.ResetOnSpawn = false
	local holder = Instance.new("Frame")
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundColor3 = spec.Background or Color3.fromRGB(11, 15, 23)
	holder.BackgroundTransparency = if spec.Background then 0 else 1
	holder.BorderSizePixel = 0
	holder.Parent = gui
	local main = Instance.new("TextLabel")
	main.Name = "Text"
	main.BackgroundTransparency = 1
	main.Size = if spec.Sub then UDim2.fromScale(0.92, 0.6) else UDim2.fromScale(0.94, 0.8)
	main.Position = if spec.Sub then UDim2.fromScale(0.04, 0.06) else UDim2.fromScale(0.03, 0.1)
	main.FontFace = if spec.Display == false then FONT_BODY else FONT_DISPLAY
	main.Text = spec.Text
	main.TextColor3 = spec.Color
	main.TextScaled = true
	main.Parent = holder
	if spec.Sub then
		local sub = Instance.new("TextLabel")
		sub.Name = "Sub"
		sub.BackgroundTransparency = 1
		sub.Size = UDim2.fromScale(0.92, 0.28)
		sub.Position = UDim2.fromScale(0.04, 0.68)
		sub.FontFace = FONT_BODY
		sub.Text = spec.Sub
		sub.TextColor3 = spec.SubColor or Color3.fromRGB(230, 236, 245)
		sub.TextScaled = true
		sub.Parent = holder
	end
	gui.Parent = part
end

local function addPrompt(part: BasePart, spec: any)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Prompt"
	-- Startwert Englisch; WorldLook übersetzt clientseitig (Attribute TextKey/ObjectKey)
	prompt.ActionText = Lang.T("en", spec.TextKey)
	prompt.ObjectText = if spec.ObjectKey then Lang.T("en", spec.ObjectKey) else ""
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.HoldDuration = spec.Hold or 0
	prompt.MaxActivationDistance = spec.Distance or 10
	prompt.RequiresLineOfSight = false
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.OneGlobally
	prompt:SetAttribute("TextKey", spec.TextKey)
	if spec.ObjectKey then
		prompt:SetAttribute("ObjectKey", spec.ObjectKey)
	end
	if spec.Window then
		prompt:SetAttribute("Window", spec.Window) -- UI-Kit öffnet das registrierte Fenster (§C7.3)
	end
	if spec.Tab then
		prompt:SetAttribute("Tab", spec.Tab)
	end
	if spec.Action then
		prompt:SetAttribute("Action", spec.Action) -- serverseitige Aktion (CityService)
	end
	prompt.Parent = part
end

local function addEmitter(part: BasePart, spec: any)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = spec.Texture
	emitter.Rate = spec.Rate
	emitter.Lifetime = spec.Lifetime
	emitter.Speed = spec.Speed
	emitter.Size = spec.Size
	emitter.Color = spec.Color
	if spec.Transparency then
		emitter.Transparency = spec.Transparency
	end
	emitter.LightEmission = spec.LightEmission or 0
	emitter.SpreadAngle = spec.Spread or Vector2.zero
	emitter.Acceleration = spec.Acceleration or Vector3.zero
	emitter.EmissionDirection = spec.Face or Enum.NormalId.Top
	emitter.Parent = part
end

-- ---------------------------------------------------------------------
-- BAUEN
-- ---------------------------------------------------------------------
local function buildCar(spec: any, parent: Instance): Instance?
	local ok, model = pcall(VehicleModels.Build, spec.Car)
	if not ok or typeof(model) ~= "Instance" then
		warn("[CityKit] Ausstellungsauto " .. tostring(spec.Car) .. ": " .. tostring(model))
		return nil
	end
	local car = model :: Model
	car.Name = "Display_" .. tostring(spec.Car)
	car:PivotTo(spec.CFrame)
	for _, part in ipairs(car:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			if part:IsA("VehicleSeat") then
				part.Disabled = true -- Ausstellungsstück: niemand setzt sich hinein
			end
		end
	end
	car:SetAttribute("Display", true)
	car.Parent = parent
	return car
end

function CityKit.Build(spec: any, model: Model, group: any): Instance?
	if spec.Asset then
		local placed = assetPlaced[group]
		if placed and placed[spec.Asset] then
			return nil -- Asset-Mesh ersetzt das Rezept
		end
	end
	local parent: Instance = model
	if spec.Sub then
		parent = subModel(group, model, spec.Sub, spec.SubAttrs)
	end
	if spec.Car then
		return buildCar(spec, parent)
	end
	local part: BasePart
	if spec.Class == "WedgePart" then
		part = Instance.new("WedgePart")
	elseif spec.Class == "Seat" then
		local seat = Instance.new("Seat")
		part = seat
	elseif spec.Class == "SpawnLocation" then
		local spawn = Instance.new("SpawnLocation")
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Enabled = true
		spawn.AllowTeamChangeOnTouch = false
		part = spawn
	else
		local p = Instance.new("Part")
		p.Shape = spec.Shape or Enum.PartType.Block
		part = p
	end
	part.Name = spec.Name
	part.Size = Vector3.new(math.max(0.05, spec.Size.X), math.max(0.05, spec.Size.Y), math.max(0.05, spec.Size.Z))
	part.CFrame = spec.CFrame
	part.Color = spec.Color
	part.Material = spec.Material
	part.Transparency = spec.Transparency or 0
	part.Reflectance = spec.Reflectance or 0
	part.Anchored = true
	local collide = spec.Collide ~= false
	part.CanCollide = collide
	part.CanQuery = collide or spec.Prompt ~= nil
	part.CanTouch = spec.Class == "Seat" -- Hocker: Hinsetzen durch Berühren
	part.CastShadow = spec.Shadow ~= false and part.Transparency < 0.9
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if spec.Attrs then
		for key, value in pairs(spec.Attrs) do
			part:SetAttribute(key, value)
		end
	end
	if spec.Mesh then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = spec.Mesh.Type
		mesh.Scale = spec.Mesh.Scale
		mesh.Parent = part
	end
	if spec.Light then
		addLight(part, spec.Light)
	end
	if spec.Gui then
		addGui(part, spec.Gui)
	end
	if spec.Prompt then
		addPrompt(part, spec.Prompt)
	end
	if spec.Emitter then
		addEmitter(part, spec.Emitter)
	end
	if parent ~= model and parent:IsA("Model") and #parent:GetChildren() == 0 then
		-- Drehpunkt eines Untermodells = Mitte seines ersten Teils (Drehteller/Vitrine/Leuchtturm), nur Verschiebung
		parent.WorldPivot = CFrame.new(part.Position)
	end
	part.Parent = parent
	return part
end

-- Gesetzte Asset-Plätze (Config.City.Assets) der Gruppe als Mesh platzieren; deren Rezept-Specs entfallen dann
function CityKit.PlaceAssets(group: any, model: Model): { [string]: boolean }
	local placed = assetPlaced[group] or {}
	assetPlaced[group] = placed
	local assets = Config.City and Config.City.Assets
	if type(assets) ~= "table" then
		return placed
	end
	for key, cf in pairs(group.AssetCFrames) do
		local slot = assets[key]
		if slot and AssetSlot.IsSet(slot) and not placed[key] then
			local ok, result = pcall(AssetSlot.Mesh, AssetSlot.KeyOf("City", key), slot, function(): Instance
				local empty = Instance.new("Model")
				empty.Name = "Recipe"
				return empty
			end)
			if ok and typeof(result) == "Instance" and result.Name ~= "Recipe" then
				local inst = result :: Instance
				if inst:IsA("Model") then
					inst:PivotTo(cf * inst:GetPivot())
				elseif inst:IsA("BasePart") then
					inst.CFrame = cf * inst.CFrame
				end
				for _, part in ipairs(inst:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = true
					end
				end
				inst.Name = "Asset_" .. key
				inst.Parent = model
				placed[key] = true
			elseif ok and typeof(result) == "Instance" then
				(result :: Instance):Destroy()
			end
		end
	end
	return placed
end

function CityKit.CountParts(root: Instance): number
	local n = 0
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

return CityKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">CityLayout</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Stadtplan als Bauplan (Server/World/CityLayout)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §A4 (Materialien, Neon nur als Streifen), §A5 (alle Zonen
--  mit Maßen), §B3 (Streaming-Modi, Teilebudget), §C5.6 (Anker, Routen, Läden, Plot-Seiten, Board-Flächen),
--  §D WP7 (Monitor-/Board-Parts mit Attribut "Monitor"/"Board", Anker mit Attributen).
--  REIN: erzeugt nur Daten (Teile-Beschreibungen = Specs) und Terrain-Aufträge (Funktionen). Gebaut wird über CityKit,
--  verteilt auf viele Frames durch CityService (≤ Config.City.BuildPerFrame Teile je Frame). Gleiche Eingabe = gleiche
--  Stadt auf jedem Server (feste Saat für die Kulisse).
--
--  Öffentliche API (nur WP7):
--    CityLayout.Plan(config): Plan          Gruppen (je ein Model mit Streaming-Modus) + Anker + Terrain + Plot-Seiten
--    CityLayout.Anchors(config): { [name]: CFrame }   nur die Anker (schnell, für CityService.Anchor vor dem Bau)
--    CityLayout.HillHeight(x, z): number    Gelände-Höhe des Villenhügels (Serpentine/Villen/Tests)
--  Spec-Felder siehe Typ "Spec". Anker sind FUSSPUNKTE (Oberfläche) mit LookVector = Blickrichtung.
--  Attribute-Konventionen in der Welt (andere Pakete lesen sie, StreamingEnabled-sicher):
--    Anchor = Name · Board = Name · Monitor = Kind/Id/Kürzel (+ Inst, Face) · Plot = k · Shop = instId (Laden-Front) ·
--    ShopTicker = instId (Platz für den Mini-Ticker) · ShopSpot = instId (Spot-Licht) · WindowLight = Etage (Kaskade) ·
--    Spin = Grad/s (Drehteller/Vitrinen/Leuchtturm, Client) · LocalDoor = "Vip"/"Club" (nur lokal offen) ·
--    Bell = true (Glocke, schwingt bei der Glocke) · Budget/NightOnly an Lichtern (Licht-Budget, WorldLook)
-- =====================================================================

local CityLayout = {}

export type LightSpec = {
	Kind: string, -- "Point" | "Spot" | "Surface"
	Range: number,
	Brightness: number,
	Color: Color3,
	Face: Enum.NormalId?,
	Angle: number?,
	NightOnly: boolean?,
	Shadows: boolean?,
}
export type GuiSpec = {
	Face: Enum.NormalId?,
	Text: string,
	Color: Color3,
	Background: Color3?,
	Display: boolean?, -- BuilderExtended (sonst BuilderSans Bold)
	MaxDistance: number?,
	Sub: string?, -- zweite Zeile (klein)
	SubColor: Color3?,
}
export type PromptSpec = {
	TextKey: string,
	ObjectKey: string?,
	Window: string?,
	Action: string?,
	Tab: string?,
	Distance: number?,
	Hold: number?,
}
export type EmitterSpec = {
	Texture: string,
	Rate: number,
	Lifetime: NumberRange,
	Speed: NumberRange,
	Size: NumberSequence,
	Color: ColorSequence,
	Transparency: NumberSequence?,
	LightEmission: number?,
	Spread: Vector2?,
	Acceleration: Vector3?,
	Face: Enum.NormalId?,
}
export type Spec = {
	Class: string, -- "Part" | "WedgePart" | "Seat" | "SpawnLocation"
	Shape: Enum.PartType?,
	Name: string,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material,
	Transparency: number?,
	Reflectance: number?,
	Collide: boolean?,
	Shadow: boolean?,
	Attrs: { [string]: any }?,
	Light: LightSpec?,
	Gui: GuiSpec?,
	Prompt: PromptSpec?,
	Emitter: EmitterSpec?,
	Mesh: { Type: Enum.MeshType, Scale: Vector3 }?,
	Sub: string?, -- Unter-Model in der Gruppe (z. B. "Bell", Drehteller)
	SubAttrs: { [string]: any }?,
	Asset: string?, -- gehört zum Rezept dieses Asset-Platzes (Config.City.Assets) -> bei gesetzter Id ersetzt
	Car: string?, -- Ausstellungsauto (VehicleModels.Build) statt Part
	Priority: boolean?, -- sofort in Init bauen (Boden unter dem Spawn, Anker, Boards)
}
export type Group = {
	Key: string,
	District: string,
	Mode: string, -- "Persistent" | "Atomic" | "Default"
	Lod: boolean,
	Specs: { Spec },
	AssetCFrames: { [string]: CFrame }, -- Asset-Platz -> Pivot des Meshes
}
export type Plan = {
	Groups: { Group },
	Anchors: { [string]: CFrame },
	Terrain: { (terrain: Terrain) -> () },
	PlotSites: { CFrame },
	ShopFronts: { [number]: string }, -- instId -> Name der Laden-Front (Spec-Name)
	Count: number,
}

-- ---------------------------------------------------------------------
-- 1) PALETTE (§A4: Glas, Marmor, gebürstetes Metall; Neon nur als Akzent)
-- ---------------------------------------------------------------------
local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

type Look = { Mat: Enum.Material, Color: Color3, Refl: number?, Transp: number? }

local L: { [string]: Look } = {
	MarbleBlack = { Mat = Enum.Material.Marble, Color = rgb(21, 23, 28), Refl = 0.15 },
	MarbleWhite = { Mat = Enum.Material.Marble, Color = rgb(226, 228, 232), Refl = 0.12 },
	MarbleGrey = { Mat = Enum.Material.Marble, Color = rgb(96, 100, 110), Refl = 0.14 },
	Glass = { Mat = Enum.Material.Glass, Color = rgb(111, 143, 184), Refl = 0.2, Transp = 0.3 },
	GlassDark = { Mat = Enum.Material.Glass, Color = rgb(40, 52, 72), Refl = 0.25, Transp = 0.15 },
	GlassClear = { Mat = Enum.Material.Glass, Color = rgb(200, 214, 235), Refl = 0.15, Transp = 0.6 },
	Metal = { Mat = Enum.Material.Metal, Color = rgb(31, 41, 55), Refl = 0.08 },
	Steel = { Mat = Enum.Material.Metal, Color = rgb(138, 148, 166), Refl = 0.15 },
	Asphalt = { Mat = Enum.Material.Asphalt, Color = rgb(40, 42, 48) },
	Concrete = { Mat = Enum.Material.Concrete, Color = rgb(110, 114, 122) },
	ConcreteLight = { Mat = Enum.Material.Concrete, Color = rgb(160, 164, 171) },
	Pavement = { Mat = Enum.Material.Pavement, Color = rgb(122, 126, 134) },
	Line = { Mat = Enum.Material.SmoothPlastic, Color = rgb(226, 230, 236) },
	Grass = { Mat = Enum.Material.Grass, Color = rgb(47, 93, 58) },
	Leaf = { Mat = Enum.Material.Grass, Color = rgb(36, 82, 50) },
	LeafDark = { Mat = Enum.Material.Grass, Color = rgb(28, 64, 42) },
