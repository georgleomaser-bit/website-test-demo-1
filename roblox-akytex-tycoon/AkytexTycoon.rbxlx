-- 6) RUF (§B9.4) – Teil des Trader-Faktors. Verluste kosten NIE Ruf. Admins können Ruf nicht geben.
-- ---------------------------------------------------------------------
Progression.Ruf = {
	DayBase = 1, -- je zählendem Börsentag (≥ 3 zählende Trades)
