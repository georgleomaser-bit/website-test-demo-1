        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – CR-Konto, Gewährungen, Boutique-Rotation, Shop-Anfragen (Server/Services/ShopService)
--  Besitzer: WP10 (Monetarisierung, Shop, CR-Konto). Vertrag: DESIGN.md §C5.9, §C9 (ShopQuote, ShopPrecheck,
--  ShopClubClaim), §C10 (State Credits), §C11.4 Punkte 4–6 (Grant-Filter), §B13 (Wirtschaft), §B14.3 (Club-Tagesgabe).
--  Muster: CLUTCH-CLASH-ShopService (REUSE §3.12): Grant/Spend sind der EINZIGE Weg, nie yielden, erst alles prüfen,
--  dann in einem Rutsch buchen, Preise nur aus der Server-Config, Core.* reine Funktionen für EconomyTests.
--
--  CR-KONTO (§0.4): Credit/Debit sind der einzige CR-Gutschreiber/-Abzieher (kein Yield). Quellen/Senken-Whitelist
--  aus Config.Shop.Sources/Sinks, Beträge ganzzahlig, Kontostand 0 … 9e15 (Muss-Regel 9). Es gibt KEINE Funktion,
--  die CR in AKY verwandelt. Metriken (MetricsService.Economy) je Spieler alle 60 s gebündelt.
--  GEWÄHRUNG: Grant(p, grant, reason) – Robux-Quellen (reason "Robux:…") laufen durch Core.Sanitize (streicht
--  Config.Shop.ForbiddenRobuxFields), dann ValidateGrant (Typen, Schlüssel, Grenzen, Dienste, Kapazität) und erst
--  danach wird gebucht: Fremd-Teile über die Besitzer-APIs (Auto, Uhr, Deko, Boost, Token, Saison), eigene Teile
--  (CR, Kosmetik) direkt. Schlägt die Prüfung fehl, ändert sich NICHTS (alles-oder-nichts).
--
--  Öffentliche API (§C5.9):
--    ShopService.Credit(p, amount, source): boolean         einziger CR-Gutschreiber (kein Yield; über 9e15 geklemmt)
--    ShopService.Debit(p, amount, sink): boolean            einziger CR-Abzieher (kein Yield; nur bei Deckung)
--    ShopService.Balance(p): number
--    ShopService.Grant(p, grant, reason): boolean           alles-oder-nichts, Robux-Quellen gefiltert
--    ShopService.RefreshPlayer(p)                           Attribute Vip/Club + MarkDirty
--    ShopService.Rotation(): { string }                     Boutique-Rotation (4 h, deterministisch, alle Server gleich)
--    ShopService.Core: { Sanitize, ValidateGrant, ApplyGrant, CanSpend, Ensure, Balance, Credit, Debit, Rotation,
--                        SourceOf, IsRobux, RewardToGrant }   (rein, ohne Spieler -> EconomyTests)
--  Zusätzlich: ShopService.MissingFor(grant): string?        fehlender Besitzer-Dienst für eine Gewährung (Vorprüfung)
--  Request-Handler: ShopQuote {Key} (1/s) · ShopPrecheck {Key, UserId?} (2/s) · ShopClubClaim {} (1/s)
--  State-Schlüssel: Credits. Player-Attribute: Vip, Club, Founder (Namensrahmen „Gründer“).
--  Braucht (zur Laufzeit, optional per pcall): DataService, PlayerStateService, MonetizationService, MetricsService,
--    TowerService (AddBoost, ApplyExpress, AddExpressToken, AddInstantToken, Income), VehicleService (GrantCar),
--    LifestyleService (GrantWatch, GrantAccessory, GrantDecor), RewardService (GrantSeasonPremium, AddSeasonTiers,
--    GrantSeasonXp).
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Lang = require(Shared:WaitForChild("Lang"))
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Format"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local ShopService = {}
local Services: any = nil

type Reply = Types.Reply
type MetricEntry = { Flow: string, Tx: string, Amount: number }

local SHOP: any = Config.Shop

-- ---------------------------------------------------------------------
-- 1) KONSTANTEN
-- ---------------------------------------------------------------------
local MAX_MONEY = 9e15 -- Muss-Regel 9 (Anzeige "MAX"), < 2^53
local KEY_MAX = 40 -- Länge eines Item-Schlüssels
local LIST_MAX = math.clamp(math.floor(tonumber(SHOP.GrantListMax) or 64), 1, 256)
local NUMBER_MAX: { [string]: number } = if type(SHOP.GrantNumberMax) == "table" then SHOP.GrantNumberMax else {}
local DECOR_MAX = 999
local METRICS_EVERY = math.max(10, tonumber(SHOP.MetricsFlushSeconds) or 60)
local METRIC_ENTRIES_MAX = 32 -- je Spieler und Takt (Quellen + Senken sind ohnehin Whitelists)
local WARN_REASONS_MAX = 64
local TITLE_MAX = 200 -- Titel-Liste im Spielstand begrenzt
local COSMETICS_MAX = 512 -- Kosmetik-Besitz begrenzt
local SEASON_TIER_XP = 1000 -- Rückfall, falls Config.Season fehlt
local FOUNDER_COSMETIC = "FounderFrame" -- Namensrahmen „Gründer“ (Starter-Paket) -> Player-Attribut "Founder"

local SOURCE_SET: { [string]: boolean } = {}
for _, name in ipairs(SHOP.Sources or {}) do
	SOURCE_SET[name] = true
end
local SINK_SET: { [string]: boolean } = {}
for _, name in ipairs(SHOP.Sinks or {}) do
	SINK_SET[name] = true
end

-- ---------------------------------------------------------------------
-- 2) ZUSTAND (Pro-Spieler-Tabellen werden bei PlayerRemoving geleert)
-- ---------------------------------------------------------------------
local metricsAcc: { [Player]: { [string]: MetricEntry } } = {}
local metricsCount: { [Player]: number } = {}
local warnedReasons: { [string]: boolean } = {}
local warnedCount = 0
local rotationCache: { Window: number, Slots: number, Keys: { string } }? = nil

-- =====================================================================
-- 3) HELFER
-- =====================================================================
local function service(name: string): any
	return Services and Services[name]
end

local function call(name: string, fnName: string, ...: any): (boolean, any)
	local s = service(name)
	if s == nil or type(s[fnName]) ~= "function" then
		return false, nil
	end
	return pcall(s[fnName], ...)
end

local function has(name: string, fnName: string): boolean
	local s = service(name)
	return s ~= nil and type(s[fnName]) == "function"
end

local function present(p: any): boolean
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent == Players
end

local function isInteger(n: any): boolean
	return Util.IsFinite(n) and (n :: number) % 1 == 0
end

local function dataOf(p: Player): any
	local dataService = service("DataService")
	if dataService == nil or type(dataService.Get) ~= "function" then
		return nil
	end
	return dataService.Get(p)
end

local function langOf(p: Player): Types.Lang
	local ok, lang = call("PlayerStateService", "LangOf", p)
	return if ok and (lang == "de" or lang == "en") then lang else "en"
end

local function markDirty(p: Player, ...: string)
	local stateService = service("PlayerStateService")
	if stateService and type(stateService.MarkDirty) == "function" then
		stateService.MarkDirty(p, ...)
	end
end

local function fail(p: Player, key: string, ...: any): Reply
	return { Ok = false, Message = Lang.T(langOf(p), key, ...) }
end

local function validKey(key: any): boolean
	return type(key) == "string" and #key >= 1 and #key <= KEY_MAX and string.match(key, "^[%w_]+$") ~= nil
end

local function hasPass(p: Player, key: string): boolean
	local ok, result = call("MonetizationService", "HasPass", p, key)
	return ok and result == true
end

local function isClub(p: Player): boolean
	local ok, result = call("MonetizationService", "IsClub", p)
	return ok and result == true
end

-- Liste ODER Menge um einen Schlüssel ergänzen (Titel: WP9 entscheidet die Form; leer -> Menge)
local function addToCollection(collection: { [any]: any }, key: string, max: number)
	if #collection > 0 then
		if not table.find(collection, key) and #collection < max then
			table.insert(collection, key)
		end
	elseif collection[key] ~= true then
		local count = 0
		for _ in pairs(collection) do
			count += 1
			if count >= max then
				return
			end
		end
		collection[key] = true
	end
end

-- Exakte Schlüssel (§C9): nur erlaubte Felder, jedes vom richtigen Typ; required = Pflichtfelder
local function exact(arg: any, allowed: { [string]: string }, required: { string }): boolean
	if arg == nil then
		return #required == 0
	end
	if type(arg) ~= "table" then
		return false
	end
	for key, value in pairs(arg) do
		local kind = if type(key) == "string" then allowed[key] else nil
		if kind == nil or type(value) ~= kind then
			return false
		end
	end
	for _, key in ipairs(required) do
		if arg[key] == nil then
			return false
		end
	end
	return true
end

-- =====================================================================
-- 4) CORE – reine Daten-Funktionen (kein Spieler, kein Yield) -> EconomyTests
-- =====================================================================
local Core = {}
ShopService.Core = Core

-- fehlende/kaputte eigene Felder reparieren (DataService reconciliert schon; doppelt hält besser)
function Core.Ensure(data: any)
	local balance = data.Credits
	if not Util.IsFinite(balance) or balance < 0 then
		data.Credits = 0
	else
		data.Credits = math.clamp(math.floor(balance), 0, MAX_MONEY)
	end
	if type(data.Purchases) ~= "table" then
		data.Purchases = {}
	end
	if type(data.Purchases.Cosmetics) ~= "table" then
		data.Purchases.Cosmetics = {}
	end
	if type(data.Stats) ~= "table" then
		data.Stats = {}
	end
	if not Util.IsFinite(data.Stats.LifetimeCredits) or data.Stats.LifetimeCredits < 0 then
		data.Stats.LifetimeCredits = 0
	end
end

function Core.Balance(data: any): number
	local value = if type(data) == "table" then data.Credits else nil
	if not Util.IsFinite(value) or value < 0 then
		return 0
	end
	return math.clamp(math.floor(value), 0, MAX_MONEY)
end

-- Reicht das Guthaben? (nur positive ganze Beträge)
function Core.CanSpend(data: any, amount: number): boolean
	return isInteger(amount) and amount > 0 and Core.Balance(data) >= amount
end

-- CR gutschreiben: Quelle aus der Whitelist, Betrag ≥ 1 (abgerundet), Kontostand ≤ 9e15. (ok, tatsächlich gutgeschrieben)
function Core.Credit(data: any, amount: number, source: string): (boolean, number)
	if type(data) ~= "table" or not SOURCE_SET[source] then
		return false, 0
	end
	if not Util.IsFinite(amount) or amount < 1 then
		return false, 0
	end
	Core.Ensure(data)
	local before = data.Credits
	local after = math.min(MAX_MONEY, before + math.floor(amount))
	data.Credits = after
	local added = after - before
	data.Stats.LifetimeCredits = math.min(MAX_MONEY, data.Stats.LifetimeCredits + added)
	if source == "Admin" and added > 0 then
		-- Wunsch 18: Admin-Geld im Konto als Admin-Geschenk markiert (Bestenlisten/Admin-Tab können es ausweisen)
		local gifted = data.Stats.AdminCredits
		data.Stats.AdminCredits = math.min(MAX_MONEY, (if Util.IsFinite(gifted) then gifted else 0) + added)
	end
	return true, added
end

-- CR abziehen: Senke aus der Whitelist, ganzzahliger Betrag > 0, nur bei voller Deckung (Prüfen + Abziehen ohne Yield)
function Core.Debit(data: any, amount: number, sink: string): boolean
	if type(data) ~= "table" or not SINK_SET[sink] or not Core.CanSpend(data, amount) then
		return false
	end
	Core.Ensure(data)
	data.Credits = math.clamp(data.Credits - amount, 0, MAX_MONEY)
	return true
end

-- Robux-Quelle? (Gründe "Robux:<Key>", "Robux:ClubDaily", …)
function Core.IsRobux(reason: string): boolean
	return type(reason) == "string" and string.sub(reason, 1, 5) == "Robux"
end

-- CR-Quelle zu einem Grant-Grund: Robux -> "Purchase", sonst das erste Wort, wenn es in der Whitelist steht
function Core.SourceOf(reason: string, robux: boolean): string?
	if robux then
		return "Purchase"
	end
	local head = if type(reason) == "string" then string.match(reason, "^(%a+)") else nil
	if head and SOURCE_SET[head] then
		return head
	end
	return nil
end

-- Kopie einer Gewährung; robux = true streicht Config.Shop.ForbiddenRobuxFields (§B14.5)
function Core.Sanitize(grant: any, robux: boolean): { [string]: any }
	local clean, removed = SHOP.SanitizeGrant(grant, robux == true)
	for _, field in ipairs(removed) do
		warn("[ShopService] Verbotenes Robux-Feld gestrichen: " .. tostring(field))
	end
	return clean
end

local function seasonTierXp(): number
	local season = Config.Season
	local list = type(season) == "table" and season.Seasons or nil
	local entry = type(list) == "table" and list[#list] or nil
	local xp = if type(entry) == "table" then entry.TierXp else nil
	return if Util.IsFinite(xp) and xp > 0 then xp else SEASON_TIER_XP
end

local function knownCar(key: string): boolean
	local vehicles = Config.Vehicles
	if type(vehicles) ~= "table" or type(vehicles.Car) ~= "function" then
		return false
	end
	local ok, car = pcall(vehicles.Car, key)
	return ok and car ~= nil
end

local function lifeKind(key: string): string?
	local lifestyle = Config.Lifestyle
	local kinds = type(lifestyle) == "table" and lifestyle.KindOf or nil
	return if type(kinds) == "table" then kinds[key] else nil
end

local function knownDecor(key: string): boolean
	local decor = Config.Decor
	local byKey = type(decor) == "table" and decor.ByKey or nil
	return type(byKey) == "table" and byKey[key] ~= nil
end

-- Grant prüfen, OHNE etwas zu ändern. Gibt (ok, Fehlertext) zurück.
function Core.ValidateGrant(_data: any, grant: any): (boolean, string?)
	if type(grant) ~= "table" then
		return false, "Grant ist keine Tabelle"
	end
	local fields = SHOP.GrantFields
	for field, value in pairs(grant) do
		local kind = if type(field) == "string" then fields[field] else nil
		if kind == nil then
			return false, "unbekanntes Feld " .. tostring(field)
		end
		if kind == "number" then
			if not isInteger(value) or value < 0 then
				return false, field .. ": ganze Zahl ≥ 0 erwartet"
			end
			local max = if Util.IsFinite(NUMBER_MAX[field]) then NUMBER_MAX[field] else MAX_MONEY
			if value > max then
				return false, ("%s: höchstens %s"):format(field, tostring(max))
			end
		elseif kind == "boolean" then
			if type(value) ~= "boolean" then
				return false, field .. ": true/false erwartet"
			end
		elseif kind == "list" then
			if type(value) ~= "table" then
				return false, field .. ": Liste erwartet"
			end
			local count = 0
			for k, v in pairs(value) do
				count += 1
				if type(k) ~= "number" or not validKey(v) then
					return false, field .. ": Liste von Schlüsseln erwartet"
				end
			end
			if count ~= #value or count > LIST_MAX then
				return false, ("%s: lückenlose Liste mit höchstens %d Einträgen erwartet"):format(field, LIST_MAX)
			end
		elseif kind == "map" then
			if type(value) ~= "table" then
				return false, field .. ": { [Schlüssel] = Anzahl } erwartet"
			end
			local count = 0
			for k, v in pairs(value) do
				count += 1
				if not validKey(k) or not isInteger(v) or v < 1 or v > DECOR_MAX then
					return false, field .. ": { [Schlüssel] = Anzahl 1 … 999 } erwartet"
				end
			end
			if count > LIST_MAX then
				return false, field .. ": zu viele Einträge"
			end
		end
	end
	-- Querverweise auf die Besitzer-Configs (unbekannte Teile nie gutschreiben)
	for _, key in ipairs(if type(grant.Cars) == "table" then grant.Cars else {}) do
		if not knownCar(key) then
			return false, "unbekanntes Auto " .. tostring(key)
		end
	end
	for _, key in ipairs(if type(grant.Watches) == "table" then grant.Watches else {}) do
		if lifeKind(key) ~= "Watch" then
			return false, "unbekannte Uhr " .. tostring(key)
		end
	end
	for _, key in ipairs(if type(grant.Accessories) == "table" then grant.Accessories else {}) do
		if lifeKind(key) ~= "Accessory" then
			return false, "unbekanntes Accessoire " .. tostring(key)
		end
	end
	for key in pairs(if type(grant.Decor) == "table" then grant.Decor else {}) do
		if not knownDecor(key) then
			return false, "unbekannte Deko " .. tostring(key)
		end
	end
	return true, nil
end

local function ensureTable(parent: any, key: string): { [any]: any }
	if type(parent[key]) ~= "table" then
		parent[key] = {}
	end
	return parent[key]
end

-- Eine GEPRÜFTE Gewährung auf Daten-Ebene anwenden (rein, kein Spieler). Das ist die Daten-Abbildung jedes
-- Grant-Felds laut §C12 – für Test-Profile (SelfTest "Firewall"). Live bucht ShopService.Grant Fremd-Teile über
-- die Besitzer-APIs (die genau diese Felder schreiben) und nur CR/Kosmetik selbst.
function Core.ApplyGrant(data: any, grant: any)
	Core.Ensure(data)
	if isInteger(grant.Credits) and grant.Credits > 0 then
		data.Credits = math.min(MAX_MONEY, data.Credits + grant.Credits)
		data.Stats.LifetimeCredits = math.min(MAX_MONEY, data.Stats.LifetimeCredits + grant.Credits)
	end
	if type(grant.Cosmetics) == "table" then
		for _, key in ipairs(grant.Cosmetics) do
			addToCollection(data.Purchases.Cosmetics, key, COSMETICS_MAX)
		end
	end
	if type(grant.Titles) == "table" then
		local prog = ensureTable(data, "Prog")
		local titles = ensureTable(prog, "Titles")
		for _, key in ipairs(grant.Titles) do
			addToCollection(titles, key, TITLE_MAX)
		end
	end
	if type(grant.Cars) == "table" then
		local cars = ensureTable(ensureTable(data, "Garage"), "Cars")
		for _, key in ipairs(grant.Cars) do
			cars[key] = true
		end
	end
	if type(grant.Watches) == "table" then
		local watches = ensureTable(ensureTable(data, "Life"), "Watches")
		for _, key in ipairs(grant.Watches) do
			watches[key] = true
		end
	end
	if type(grant.Accessories) == "table" then
		local accessories = ensureTable(ensureTable(data, "Life"), "Accessories")
		for _, key in ipairs(grant.Accessories) do
			accessories[key] = true
		end
	end
	if type(grant.Decor) == "table" then
		local decor = ensureTable(ensureTable(data, "Storage"), "Decor")
		for key, n in pairs(grant.Decor) do
			decor[key] = math.clamp((if isInteger(decor[key]) then decor[key] else 0) + n, 0, DECOR_MAX)
		end
	end
	local boosts = ensureTable(data, "Boosts")
	for _, pair in ipairs({ { "BoostX2", "X2" }, { "BoostX5", "X5" } }) do
		local seconds = grant[pair[1]]
		if isInteger(seconds) and seconds > 0 then
			local before = if Util.IsFinite(boosts[pair[2]]) then boosts[pair[2]] else 0
			boosts[pair[2]] = math.min(NUMBER_MAX[pair[1]] or 2592000, before + seconds)
		end
	end
	local tower = ensureTable(data, "Tower")
	if isInteger(grant.ExpressTokens) and grant.ExpressTokens > 0 then
		table.insert(ensureTable(tower, "Express"), grant.ExpressTokens)
	end
	if isInteger(grant.InstantTokens) and grant.InstantTokens > 0 then
		local before = if isInteger(tower.Instant) then tower.Instant else 0
		tower.Instant = math.min(NUMBER_MAX.InstantTokens or 99, before + grant.InstantTokens)
	end
	local season = ensureTable(data, "Season")
	if grant.SeasonPremium == true then
		season.Premium = true
	end
	local xp = if Util.IsFinite(season.Xp) then season.Xp else 0
	if isInteger(grant.SeasonTiers) and grant.SeasonTiers > 0 then
		xp += grant.SeasonTiers * seasonTierXp()
	end
	if isInteger(grant.SeasonXp) and grant.SeasonXp > 0 then
		xp += grant.SeasonXp
	end
	season.Xp = math.min(MAX_MONEY, xp)
end

-- Saison-/Login-/Code-Belohnung (Config.Season/Rewards-Form) -> Types.Grant. Credits = { Minutes, Min } -> steady-
-- abhängig (Min als Untergrenze), Title -> Titles. Unbekannte Felder fallen weg (der Grant-Filter prüft danach).
function Core.RewardToGrant(reward: any, steadyPerSec: number?): { [string]: any }
	local grant: { [string]: any } = {}
	if type(reward) ~= "table" then
		return grant
	end
	for field, value in pairs(reward) do
		if field == "Credits" then
			if type(value) == "table" and Util.IsFinite(value.Minutes) and Util.IsFinite(value.Min) then
				local rate = if Util.IsFinite(steadyPerSec) then math.max(0, steadyPerSec :: number) else 0
				grant.Credits =
					math.clamp(math.max(math.floor(value.Min), math.floor(rate * value.Minutes * 60)), 0, MAX_MONEY)
			elseif isInteger(value) then
				grant.Credits = value
			end
		elseif field == "Title" then
			if type(value) == "string" then
				grant.Titles = { value }
			end
		elseif type(field) == "string" and SHOP.GrantFields[field] ~= nil then
			grant[field] = if type(value) == "table" then table.clone(value) else value
		end
	end
	return grant
end

-- Boutique-Rotation: `slots` verschiedene Schlüssel aus `pool`, deterministisch aus dem Zeitfenster (alle Server gleich)
function Core.Rotation(window: number, slots: number, pool: { string }): { string }
	local list: { string } = {}
	local want = math.min(math.max(0, math.floor(slots)), #pool)
	if want == 0 then
		return list
	end
	local attempts = 0
	while #list < want and attempts < want * 16 do
		attempts += 1
		local index = Util.Hash(("boutique:%d:%d"):format(window, attempts)) % #pool + 1
		local key = pool[index]
		if not table.find(list, key) then
			table.insert(list, key)
		end
	end
	-- Hash-Kollisionen: deterministisch mit den nächsten freien Teilen auffüllen
	for _, key in ipairs(pool) do
		if #list >= want then
			break
		end
		if not table.find(list, key) then
			table.insert(list, key)
		end
	end
	return list
end

-- =====================================================================
-- 5) METRIKEN (Quellen/Senken je Spieler gebündelt, alle 60 s an MetricsService.Economy)
-- =====================================================================
local function addMetric(p: Player, flow: string, tx: string, amount: number)
	if amount <= 0 or not present(p) then
		return
	end
	local acc = metricsAcc[p]
	if acc == nil then
		acc = {}
		metricsAcc[p] = acc
	end
	local key = flow .. "|" .. tx
	local entry = acc[key]
	if entry == nil then
		if (metricsCount[p] or 0) >= METRIC_ENTRIES_MAX then
			return
		end
		entry = { Flow = flow, Tx = tx, Amount = 0 }
		acc[key] = entry
		metricsCount[p] = (metricsCount[p] or 0) + 1
	end
	entry.Amount = math.min(MAX_MONEY, entry.Amount + amount)
end

local function flushMetrics(p: Player)
	local acc = metricsAcc[p]
	metricsAcc[p] = nil
	metricsCount[p] = nil
	if acc == nil then
		return
	end
	local balance = Core.Balance(dataOf(p))
	for _, entry in pairs(acc) do
		call("MetricsService", "Economy", p, entry.Flow, "CR", entry.Amount, balance, entry.Tx, nil)
	end
end

local function warnReason(reason: string)
	if warnedReasons[reason] or warnedCount >= WARN_REASONS_MAX then
		return
	end
	warnedReasons[reason] = true
	warnedCount += 1
	warn("[ShopService] Grant-Grund ohne CR-Quelle in der Whitelist: " .. reason .. " (CR werden als Event gebucht)")
end

-- =====================================================================
-- 6) CR-KONTO (einziger Gutschreiber/Abzieher, kein Yield)
-- =====================================================================
function ShopService.Credit(p: Player, amount: number, source: string): boolean
	local data = dataOf(p)
	if data == nil then
		return false
	end
	local ok, added = Core.Credit(data, amount, source)
	if not ok then
		warn(
			("[ShopService] Credit abgelehnt (%s, %s, %s)"):format(
				if typeof(p) == "Instance" then p.Name else "?",
				tostring(amount),
				tostring(source)
			)
		)
		return false
	end
	if added > 0 then
		addMetric(p, "Source", source, added)
		markDirty(p, "Credits")
	end
	return true
end

function ShopService.Debit(p: Player, amount: number, sink: string): boolean
	local data = dataOf(p)
	if data == nil then
		return false
	end
	if not Core.Debit(data, amount, sink) then
		return false -- zu wenig CR oder ungültige Senke/Menge: nichts abgezogen
	end
	addMetric(p, "Sink", sink, amount)
	markDirty(p, "Credits")
	return true
end

function ShopService.Balance(p: Player): number
	return Core.Balance(dataOf(p))
end

-- =====================================================================
-- 7) GEWÄHRUNG (alles-oder-nichts: erst prüfen, dann in einem Rutsch buchen, kein Yield)
-- =====================================================================
-- Fehlender Besitzer-Dienst für eine Gewährung (nil = alles da)
function ShopService.MissingFor(grant: any): string?
	if type(grant) ~= "table" then
		return nil
	end
	if grant.Cars ~= nil and not has("VehicleService", "GrantCar") then
		return "VehicleService.GrantCar"
	end
	if grant.Watches ~= nil and not has("LifestyleService", "GrantWatch") then
		return "LifestyleService.GrantWatch"
	end
	if grant.Accessories ~= nil and not has("LifestyleService", "GrantAccessory") then
		return "LifestyleService.GrantAccessory"
	end
	if grant.Decor ~= nil and not has("LifestyleService", "GrantDecor") then
		return "LifestyleService.GrantDecor"
	end
	if (grant.BoostX2 ~= nil or grant.BoostX5 ~= nil) and not has("TowerService", "AddBoost") then
		return "TowerService.AddBoost"
	end
	if
		grant.ExpressTokens ~= nil
		and (not has("TowerService", "AddExpressToken") or not has("TowerService", "ApplyExpress"))
	then
		return "TowerService.AddExpressToken"
	end
	if grant.InstantTokens ~= nil and not has("TowerService", "AddInstantToken") then
		return "TowerService.AddInstantToken"
	end
	if grant.SeasonPremium ~= nil and not has("RewardService", "GrantSeasonPremium") then
		return "RewardService.GrantSeasonPremium"
	end
	if grant.SeasonTiers ~= nil and not has("RewardService", "AddSeasonTiers") then
		return "RewardService.AddSeasonTiers"
	end
	if grant.SeasonXp ~= nil and not has("RewardService", "GrantSeasonXp") then
		return "RewardService.GrantSeasonXp"
	end
	return nil
end

-- Bau-Express möglich? (laufende Baustelle oder Platz im Token-Lager)
local function expressPossible(data: any): boolean
	local tower = type(data) == "table" and data.Tower or nil
	if type(tower) ~= "table" then
		return false
	end
	if type(tower.Build) == "table" and tower.Build.Floor ~= nil then
		return true
	end
	local buildCfg = type(Config.Tower) == "table" and Config.Tower.Build or nil
	local maxTokens = if type(buildCfg) == "table" and isInteger(buildCfg.ExpressMax) then buildCfg.ExpressMax else 50
	return (if type(tower.Express) == "table" then #tower.Express else 0) < maxTokens
end

local function allTrue(list: { string }, fn: (key: string) -> boolean): boolean
	local ok = true
	for _, key in ipairs(list) do
		if not fn(key) then
			ok = false
		end
	end
	return ok
end

local function resultTrue(okCall: boolean, result: any): boolean
	return okCall and result == true
end

-- Fremd-Teile in fester Reihenfolge: was am ehesten "nein" sagt, zuerst (dann ist noch nichts gebucht)
type Step = { Field: string, Run: (p: Player, value: any, reason: string) -> boolean }
local STEPS: { Step } = {
	{
		Field = "SeasonPremium",
		Run = function(p: Player, value: any, _reason: string): boolean
			if value ~= true then
				return true
			end
			return resultTrue(call("RewardService", "GrantSeasonPremium", p))
		end,
	},
	{
		Field = "ExpressTokens",
		Run = function(p: Player, seconds: any, _reason: string): boolean
			-- laufende Baustelle -> sofort verkürzen/beenden, sonst Token für den nächsten Bau
			if resultTrue(call("TowerService", "ApplyExpress", p, seconds)) then
				return true
			end
			return resultTrue(call("TowerService", "AddExpressToken", p, seconds))
		end,
	},
	{
		Field = "SeasonTiers",
		Run = function(p: Player, n: any, _reason: string): boolean
			local okCall = call("RewardService", "AddSeasonTiers", p, n)
			return okCall
		end,
	},
	{
		Field = "SeasonXp",
		Run = function(p: Player, n: any, reason: string): boolean
			local okCall = call("RewardService", "GrantSeasonXp", p, n, reason)
			return okCall
		end,
	},
	{
		Field = "Cars",
		Run = function(p: Player, list: any, _reason: string): boolean
			return allTrue(list, function(key: string): boolean
				return resultTrue(call("VehicleService", "GrantCar", p, key))
			end)
		end,
	},
	{
		Field = "Watches",
		Run = function(p: Player, list: any, _reason: string): boolean
			return allTrue(list, function(key: string): boolean
				return resultTrue(call("LifestyleService", "GrantWatch", p, key))
			end)
		end,
	},
	{
		Field = "Accessories",
		Run = function(p: Player, list: any, _reason: string): boolean
			return allTrue(list, function(key: string): boolean
				return resultTrue(call("LifestyleService", "GrantAccessory", p, key))
			end)
		end,
	},
	{
		Field = "Decor",
		Run = function(p: Player, map: any, _reason: string): boolean
			local ok = true
			for key, n in pairs(map) do
				if not resultTrue(call("LifestyleService", "GrantDecor", p, key, n)) then
					ok = false
				end
			end
			return ok
		end,
	},
	{
		Field = "BoostX2",
		Run = function(p: Player, seconds: any, _reason: string): boolean
			return resultTrue(call("TowerService", "AddBoost", p, "X2", seconds))
		end,
	},
	{
		Field = "BoostX5",
		Run = function(p: Player, seconds: any, _reason: string): boolean
			return resultTrue(call("TowerService", "AddBoost", p, "X5", seconds))
		end,
	},
	{
		Field = "InstantTokens",
		Run = function(p: Player, n: any, _reason: string): boolean
			return resultTrue(call("TowerService", "AddInstantToken", p, n))
		end,
	},
}

function ShopService.Grant(p: Player, grant: Types.Grant, reason: string): boolean
	local data = dataOf(p)
	if data == nil then
		return false
	end
	local why = if type(reason) == "string" and reason ~= "" then string.sub(reason, 1, 80) else "?"
	local robux = Core.IsRobux(why)
	local clean = Core.Sanitize(grant, robux)
	Core.Ensure(data)
	local ok, err = Core.ValidateGrant(data, clean)
	if not ok then
		warn(("[ShopService] Grant abgelehnt (%s, %s): %s"):format(p.Name, why, tostring(err)))
		return false
	end
	local missing = ShopService.MissingFor(clean)
	if missing then
		warn(("[ShopService] Grant (%s, %s) wartet: %s fehlt – später erneut"):format(p.Name, why, missing))
		return false
	end
	if isInteger(clean.ExpressTokens) and clean.ExpressTokens > 0 and not expressPossible(data) then
		warn(("[ShopService] Grant (%s, %s): Bau-Express-Lager voll"):format(p.Name, why))
		return false
	end
	-- Fremd-Teile über die Besitzer-APIs
	local applied = 0
	for _, step in ipairs(STEPS) do
		local value = clean[step.Field]
		if value ~= nil and value ~= false and value ~= 0 then
			if step.Run(p, value, why) then
				applied += 1
			elseif applied == 0 then
				warn(("[ShopService] Grant (%s, %s): %s abgelehnt – nichts gebucht"):format(p.Name, why, step.Field))
				return false
			else
				warn(
					("[ShopService] Grant (%s, %s): %s nicht gebucht (Teil-Gutschrift)"):format(p.Name, why, step.Field)
				)
			end
		end
	end
	-- eigene Teile (kein Yield)
	if isInteger(clean.Credits) and clean.Credits > 0 then
		local source = Core.SourceOf(why, robux)
		if source == nil then
			warnReason(why)
			source = "Event"
		end
		local okCredit, added = Core.Credit(data, clean.Credits, source :: string)
		if okCredit and added > 0 then
			addMetric(p, "Source", source :: string, added)
			markDirty(p, "Credits")
		end
	end
	if type(clean.Cosmetics) == "table" and #clean.Cosmetics > 0 then
		for _, key in ipairs(clean.Cosmetics) do
			addToCollection(data.Purchases.Cosmetics, key, COSMETICS_MAX)
		end
		markDirty(p, "Tower", "Garage", "Life") -- Fassaden/Neon/Lacke werden sofort wählbar
		if table.find(clean.Cosmetics, FOUNDER_COSMETIC) then
			ShopService.RefreshPlayer(p) -- Namensrahmen „Gründer“ sofort am Namensschild
		end
	end
	if type(clean.Titles) == "table" and #clean.Titles > 0 then
		local prog = ensureTable(data, "Prog")
		local titles = ensureTable(prog, "Titles")
		for _, key in ipairs(clean.Titles) do
			addToCollection(titles, key, TITLE_MAX)
		end
		markDirty(p, "Prog")
	end
	return true
end

-- Kosmetik im Besitz? (Liste oder Menge in Purchases.Cosmetics)
local function ownsCosmetic(data: any, key: string): boolean
	local purchases = if type(data) == "table" then data.Purchases else nil
	local list = if type(purchases) == "table" then purchases.Cosmetics else nil
	if type(list) ~= "table" then
		return false
	end
	return list[key] == true or table.find(list, key) ~= nil
end

-- Attribute Vip/Club/Founder (Namensschild, Chat-Tag, Lack, Balkon, Dachterrasse, Namensrahmen – Besitzer-Pakete
-- lesen sie) + State
function ShopService.RefreshPlayer(p: Player)
	if not present(p) then
		return
	end
	local vip = hasPass(p, "VIP")
	if p:GetAttribute("Vip") ~= vip then
		p:SetAttribute("Vip", vip)
	end
	local member = isClub(p)
	if p:GetAttribute("Club") ~= member then
		p:SetAttribute("Club", member)
	end
	local founder = ownsCosmetic(dataOf(p), FOUNDER_COSMETIC)
	if p:GetAttribute("Founder") ~= founder then
		p:SetAttribute("Founder", founder)
	end
	markDirty(p, "Passes", "Club", "Credits")
end

-- =====================================================================
-- 8) BOUTIQUE-ROTATION (4 h, deterministisch)
-- =====================================================================
local function rotationPool(): { string }
	local pool: { string } = {}
	local seen: { [string]: boolean } = {}
	local lifestyle = Config.Lifestyle
	local decor = Config.Decor
	local lists = {
		if type(lifestyle) == "table" then lifestyle.Watches else nil,
		if type(lifestyle) == "table" then lifestyle.Accessories else nil,
		if type(decor) == "table" then decor.Items else nil,
	}
	for i = 1, 3 do
		local list = lists[i]
		if type(list) == "table" then
			for _, entry in ipairs(list) do
				if
					type(entry) == "table"
					and entry.Source == "Shop"
					and Util.IsFinite(entry.Price)
					and entry.Price > 0
					and validKey(entry.Key)
					and not seen[entry.Key]
				then
					seen[entry.Key] = true
					table.insert(pool, entry.Key)
				end
			end
		end
	end
	table.sort(pool)
	return pool
end

function ShopService.Rotation(): { string }
	local hours = math.clamp(tonumber(SHOP.BoutiqueHours) or 4, 1, 48)
	local slots = math.clamp(math.floor(tonumber(SHOP.BoutiqueSlots) or 6), 1, 24)
	local window = math.floor(os.time() / (hours * 3600))
	local cache = rotationCache
	if cache == nil or cache.Window ~= window or cache.Slots ~= slots then
		cache = { Window = window, Slots = slots, Keys = Core.Rotation(window, slots, rotationPool()) }
		rotationCache = cache
	end
	return table.clone((cache :: any).Keys)
end

-- =====================================================================
-- 9) REQUEST-HANDLER (§C9) – Ablauf: exakte Schlüssel/Typen -> Daten -> Prüfen -> Buchen
-- =====================================================================
local function handleQuote(p: Player, arg: any): Reply
	if not exact(arg, { Key = "string" }, { "Key" }) or not validKey(arg.Key) then
		return fail(p, "core.invalid")
	end
	local product = SHOP.ProductsByKey[arg.Key]
	if product == nil or product.Kind ~= "Voucher" then
		return fail(p, "shop.unknown")
	end
	if dataOf(p) == nil then
		return fail(p, "core.loading")
	end
	local ok, creditsValue, untilT = call("MonetizationService", "Quote", p, arg.Key)
	if not ok or not isInteger(creditsValue) or not Util.IsFinite(untilT) then
		return fail(p, "core.error")
	end
	return { Ok = true, Credits = creditsValue, Until = untilT }
end

local function handlePrecheck(p: Player, arg: any): Reply
	if not exact(arg, { Key = "string", UserId = "number" }, { "Key" }) or not validKey(arg.Key) then
		return fail(p, "core.invalid")
	end
	local userId = arg.UserId
	if userId ~= nil and (not isInteger(userId) or math.abs(userId) > 2 ^ 53) then
		return fail(p, "core.invalid")
	end
	local monetization = service("MonetizationService")
	if monetization == nil or type(monetization.Precheck) ~= "function" then
		return fail(p, "shop.serviceMissing")
	end
	local ok, reply = pcall(monetization.Precheck, p, arg.Key, userId)
	if not ok or type(reply) ~= "table" then
		return fail(p, "core.error")
	end
	return reply
end

local function nextUtcMidnight(): number
	return (math.floor(os.time() / 86400) + 1) * 86400
end

local function steadyOf(p: Player): number
	local ok, info = call("TowerService", "Income", p)
	if ok and type(info) == "table" and Util.IsFinite(info.Steady) and info.Steady > 0 then
		return info.Steady
	end
	return 0
end

local function handleClubClaim(p: Player, arg: any): Reply
	if not exact(arg, {}, {}) then
		return fail(p, "core.invalid")
	end
	if not isClub(p) then
		return fail(p, "shop.club.notMember")
	end
	local data = dataOf(p)
	if data == nil then
		return fail(p, "core.loading")
	end
	Core.Ensure(data)
	local purchases = data.Purchases
	local today = Util.UtcDay()
	if purchases.ClubClaimDay == today then
		return fail(p, "shop.club.claimed", Format.Duration(nextUtcMidnight() - os.time(), langOf(p)))
	end
	local sub = SHOP.Subscription
	local voucher = SHOP.ProductsByKey[if type(sub) == "table" then sub.DailyVoucher else "CreditsS"]
	local amount = SHOP.VoucherCredits(voucher, steadyOf(p))
	if amount <= 0 or not ShopService.Grant(p, { Credits = amount }, "Robux:ClubDaily") then
		return fail(p, "core.error")
	end
	purchases.ClubClaimDay = today
	markDirty(p, "Offers")
	call("PlayerStateService", "Effect", p, "Confetti", 1, nil)
	return {
		Ok = true,
		Credits = amount,
		Message = Lang.T(langOf(p), "shop.club.claimOk", Format.Credits(amount, langOf(p))),
	}
end

-- =====================================================================
-- 10) INIT / START
-- =====================================================================
function ShopService.Init(services: any)
	Services = services
	local stateService = service("PlayerStateService")
	if stateService == nil or type(stateService.Handle) ~= "function" then
		warn("[ShopService] PlayerStateService fehlt – keine Shop-Anfragen")
		return
	end
	stateService.Provide("Credits", function(p: Player)
		return Core.Balance(dataOf(p))
	end)
	stateService.Handle("ShopQuote", handleQuote, { Rate = 1, Per = 1 })
	stateService.Handle("ShopPrecheck", handlePrecheck, { Rate = 2, Per = 1 })
	stateService.Handle("ShopClubClaim", handleClubClaim, { Rate = 1, Per = 1 })
end

function ShopService.Start()
	local stateService = service("PlayerStateService")
	if stateService and type(stateService.OnReady) == "function" then
		stateService.OnReady(function(p: Player)
			local data = dataOf(p)
			if data ~= nil then
				Core.Ensure(data)
			end
			ShopService.RefreshPlayer(p)
		end)
	end
	Players.PlayerRemoving:Connect(function(p: Player)
		local ok, err = pcall(flushMetrics, p)
		if not ok then
			warn("[ShopService] Metriken: " .. tostring(err))
		end
		metricsAcc[p] = nil
		metricsCount[p] = nil
	end)
	Scheduler.Every("ShopMetrics", 1 / METRICS_EVERY, function()
		for _, p in ipairs(Util.Snapshot(metricsAcc)) do
			flushMetrics(p)
		end
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">TowerService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Turm-Ökonomie (Server/Services/TowerService)
--  Besitzer: WP6 (Turm-Ökonomie). Vertrag: DESIGN.md §C5.5, §C9 (Tower*), §C10 (State Tower, Income), §B4, §B5,
--  §B8.2 (Gewinn-Transfer, CR-Seite), §B9.6 (Börsengang-Reset). Formeln: Shared/TowerMath (== tools/economy_sim.py).
--
--  Server ist Autorität: Etagen, Abteilungen, Personal, Raum-Stufen, Effizienz, Tresor, Offline-Einnahmen, Baustelle,
--  Boosts, Multiplikatoren. CR bucht NUR ShopService (Credit/Debit). Robux-Firewall (§0.4): Turm-Multiplikatoren wirken
--  nie auf AKY; der Gewinn-Transfer läuft nur AKY -> CR (OrderService.Withdraw liefert Cent, hier × Bau-Kurs der
--  Lizenz -> ShopService.Credit(…, "Transfer")). Es gibt KEINE Funktion, die CR in AKY verwandelt.
--
--  Ablauf:
--    * Profil geladen -> Turm-Daten reparieren, Attribute/Leaderstat, Hülle bauen (wenn der Plot steht).
--    * Bereit (Pässe geladen) -> Offline-Abrechnung (DataService.LastSavedAt) + Gratis-Sofortbau-Token des Tages.
--    * Takt "TowerIncome" 1 Hz (EIN Batch für alle): Bau fertig?, Boost-Countdown (nur online, nur der stärkste),
--      Einkommen (Teile alle 5 s neu), Tresor füllen, Hausmeister-Bot (60 s, auf dem Plot) / Auto-Kassierer (3 s).
--    * Glocke: OrderService.OnBell(p) -> Withdraw(p, "Bell") -> CR gutschreiben (Auto-Transfer, auch offline verbuchte).
--
--  Öffentliche API (§C5.5):
--    TowerService.Income(p): Types.IncomeInfo           PerSec inkl. Zeitlich, Steady ohne Zeitlich
--    TowerService.Floors(p) · Stage(p) · RunSpend(p) · TowerValue(p)   (TowerValue = 0,5 × RunSpend)
--    TowerService.AddBoost(p, "X2" | "X5" | "Bull", seconds): boolean
--    TowerService.SetServerBoost("Parade" | "Bell", mult, seconds)       setzt (überschreibt) den Server-Boost
--    TowerService.SetEventMult(mult, untilUnix)                           Golden Hour/Admin, geklemmt ≤ 3
--    TowerService.AddExpressToken(p, maxSeconds) · ApplyExpress(p, maxSeconds): boolean · AddInstantToken(p, n)
--    TowerService.ResetForIpo(p, perks): boolean       VORHER RunSpend(p) lesen (Sterne/Firmenwert rechnet WP9)
--    TowerService.AdminSetFloors(p, n): boolean
--    TowerService.CostMult("Floor" | "RoomLevel"): number    TowerService.SetCostEvent(kind, mult, untilUnix)
--    TowerService.OnFloorBuilt(cb(p, floor, stage)) · OnStageUp(cb(p, stage)) · OnTransfer(cb(p, akyCents, credits))
--  Ergänzungen (abwärtskompatibel):
--    TowerService.RoomCount(p, roomKey): number         z. B. "Garage" (Auto-Plätze), "Lounge"/"Marketing" (Respekt)
--    TowerService.SetBuildEvent(mult, untilUnix)        Admin-Bau-Boom: Bauzeit-Faktor (nie unter 25 % Grundzeit)
--    TowerService.Transfer(p, reason): (number, string?)   Gewinn-Transfer ausführen (CR, Grund-Schlüssel)
--    TowerService.Refresh(p)                            Einkommen sofort neu (nach Pass-/Abo-Kauf; kein Yield)
--  Request-Handler: TowerBuild, TowerRoom, TowerLevel, TowerHire, TowerFire, TowerEfficiency, TowerCollect,
--    TowerTransfer, TowerInstant, TowerExpress, TowerHelp, TowerName, TowerSkin, TowerNeon, TowerPrivate, TowerDecor,
--    TowerLayout, TowerAutoPlan   (TowerVisit/TowerHome/TowerElevator: PlotService)
--  State: Tower, Income. Effekte: BuildDone, StageUp, TransferTube, Collect, Crane. Attribut: TowerName ("a:n").
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))
local Lang = require(Shared:WaitForChild("Lang"))
local Format = require(Shared:WaitForChild("Format"))
local Clock = require(Shared:WaitForChild("Clock"))
local TowerMath = require(Shared:WaitForChild("TowerMath"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local TowerService = {}
local Services: any = nil

type FloorData = Types.FloorData
type MultPart = Types.MultPart
type IncomeInfo = Types.IncomeInfo
type Reply = Types.Reply
type LangCode = Types.Lang

-- Umgebung für die Kern-Operationen (echte Dienste im Spiel, Attrappen in TowerTests)
export type Env = {
	Now: number,
	Licence: number,
	Ipo: number,
	Perk: (key: string) -> number, -- Schlüssel aus Config.Tower.Perks ("Growth", "Blitz", "Build", "Tempo", "Vault")
	HasPass: (key: string) -> boolean,
	Balance: () -> number,
	Debit: (amount: number, sink: string) -> boolean,
	Credit: (amount: number, source: string) -> boolean,
	TakeDecor: (key: string) -> boolean,
	ReturnDecor: (key: string) -> (),
	Comfort: (key: string) -> number,
	Owns: (entry: any) -> boolean,
	BuildEvent: number, -- Bauzeit-Faktor aus Admin-Bau-Boom (1 = keiner)
	CostEvent: (kind: string) -> number, -- Kosten-Faktor aus Bau-Boom (1 = keiner)
}

type Runtime = {
	Base: number,
	BaseDirty: boolean,
	Info: IncomeInfo?,
	InfoAt: number,
	InfoSig: string,
	VaultCap: number,
	VaultFrac: number,
	VaultFullNotified: boolean,
	JanitorAcc: number,
	AutoAcc: number,
	SlowAcc: number,
	JoinClock: number,
	JoinUnix: number,
	Settled: boolean,
	Welcome: { [string]: any }?,
	StageToastAt: number,
	MaxMoneyAt: number,
	AutoDirtyAt: number,
	Repaired: boolean,
}

-- ---------------------------------------------------------------------
-- 1) KONSTANTEN & CONFIG
-- ---------------------------------------------------------------------
local MAX_MONEY = 9e15
local PREFIX = "[TowerService] "
local PARTS_REFRESH = 5 -- Sekunden: Multiplikator-Teile (Freunde, Respekt, Pässe, Lizenz) neu einsammeln
local WELCOME_WINDOW = 120 -- Sekunden nach dem Beitritt zählen Glocken-Transfers in den Willkommen-Bericht
local AUTO_STATE_EVERY = 15 -- Auto-Kassierer: Tower-State höchstens alle 15 s senden (Netz-Budget §C16)
local MAX_COMFORT_CACHE = 256
local MAX_DECOR_KEY = 40
local ERROR_LOG_EVERY = 10

local TCFG: { [string]: any } = if type(Config.Tower) == "table" then Config.Tower else {}

local function isNum(v: any): boolean
	return Util.IsFinite(v)
end

local function isInt(v: any): boolean
	return Util.IsFinite(v) and v % 1 == 0
end

local function num(v: any, default: number): number
	return if Util.IsFinite(v) then v else default
end

local function sub(t: any, key: string): { [string]: any }
	local v = if type(t) == "table" then t[key] else nil
	return if type(v) == "table" then v else {}
end

local FLOORS = math.clamp(math.floor(num(TCFG.Floors, 50)), 1, 50)
local BUILD = sub(TCFG, "Build")
local OFFLINE = sub(TCFG, "Offline")
local IPO = sub(TCFG, "Ipo")
local PERKS = sub(TCFG, "Perks")
local DECOR_FALLBACK = sub(TCFG, "Decor")
local DEFAULT_ROOM = if type(TCFG.DefaultRoom) == "string" then TCFG.DefaultRoom else "Office"
local DEFAULT_SKIN = if type(TCFG.DefaultSkin) == "string" then TCFG.DefaultSkin else "GlassBlue"
local DEFAULT_NEON = if type(TCFG.DefaultNeon) == "string" then TCFG.DefaultNeon else "Accent"
local STAFF_SLOTS = math.floor(num(TCFG.StaffSlots, 2))
local STAFF_SLOTS_PLUS = math.max(STAFF_SLOTS, math.floor(num(TCFG.StaffSlotsPlus, 3)))
local PRIVATE_MAX = math.floor(num(TCFG.PrivateMax, 5))
local HELP_MAX = math.floor(num(BUILD.HelpMax, 3))
local EXPRESS_MAX = math.floor(num(BUILD.ExpressMax, 50))
local EXPRESS_MAX_SECONDS = math.floor(num(BUILD.ExpressMaxSeconds, 86400))
local INSTANT_MAX = math.floor(num(BUILD.InstantMax, 99))
local function listOf(t: any, key: string): { any }
	local v = if type(t) == "table" then t[key] else nil
	return if type(v) == "table" then v else {}
end
local NAME_ADJ = #listOf(sub(TCFG, "Names"), "Adj")
local NAME_NOUN = #listOf(sub(TCFG, "Names"), "Noun")

-- Nachschlage-Tabellen (Schlüssel -> Eintrag)
local function byKey(list: any): { [string]: any }
	local out: { [string]: any } = {}
	if type(list) == "table" then
		for _, entry in ipairs(list) do
			if type(entry) == "table" and type(entry.Key) == "string" then
				out[entry.Key] = entry
			end
		end
	end
	return out
end

local ROOMS = byKey(TCFG.Rooms)
local ROOM_LIST: { any } = {}
for _, room in ipairs(if type(TCFG.Rooms) == "table" then TCFG.Rooms else {}) do
	if type(room) == "table" and type(room.Key) == "string" then
		table.insert(ROOM_LIST, room)
	end
end
local STAFF = byKey(TCFG.Staff)
local SKINS = byKey(TCFG.Skins)
local NEONS = byKey(TCFG.Neon)
local STAGES: { any } = if type(TCFG.Stages) == "table" then TCFG.Stages else {}
local CROWNS: { any } = if type(TCFG.Crowns) == "table" then TCFG.Crowns else {}

-- live änderbare Multiplikator-Werte (Config.ApplyLive schreibt in Config.Tower.Mult) – immer frisch lesen
local function mult(key: string, default: number): number
	local m = if type(Config.Tower) == "table" then Config.Tower.Mult else nil
	return if type(m) == "table" and Util.IsFinite(m[key]) then m[key] else default
end

TowerMath.Configure(TCFG)

-- ---------------------------------------------------------------------
-- 2) LAUFZEIT-ZUSTAND (pro Spieler bei PlayerRemoving geleert)
-- ---------------------------------------------------------------------
local runtime: { [Player]: Runtime } = {}
local floorBuiltCallbacks: { (Player, number, number) -> () } = {}
local stageUpCallbacks: { (Player, number) -> () } = {}
local transferCallbacks: { (Player, number, number) -> () } = {}
local comfortCache: { [string]: number } = {}
local comfortCount = 0
local errorLogAt: { [string]: number } = {}

-- serverweite Faktoren (Einheit: Unix-Sekunden)
local serverBoost: { [string]: { Mult: number, Until: number } } = {
	Parade = { Mult = 1, Until = 0 },
	Bell = { Mult = 1, Until = 0 },
}
local eventBoost = { Mult = 1, Until = 0 }
local costEvents: { [string]: { Mult: number, Until: number } } = {
	Floor = { Mult = 1, Until = 0 },
	RoomLevel = { Mult = 1, Until = 0 },
}
local buildEvent = { Mult = 1, Until = 0 }

local function logError(where: string, err: any)
	local now = os.clock()
	if now - (errorLogAt[where] or -math.huge) >= ERROR_LOG_EVERY then
		errorLogAt[where] = now
		warn(PREFIX .. where .. ": " .. tostring(err))
	end
end

-- ---------------------------------------------------------------------
-- 3) DIENSTE (nur zur Laufzeit über Services, optional per pcall)
-- ---------------------------------------------------------------------
local function has(serviceName: string, fnName: string): boolean
	local s = Services and Services[serviceName]
	return type(s) == "table" and type(s[fnName]) == "function"
end

local function call(serviceName: string, fnName: string, ...: any): (boolean, any, any, any)
	local s = Services and Services[serviceName]
	local fn = if type(s) == "table" then s[fnName] else nil
	if type(fn) ~= "function" then
		return false, nil, nil, nil
	end
	local ok, a, b, c = pcall(fn, ...)
	if not ok then
		logError(serviceName .. "." .. fnName, a)
		return false, nil, nil, nil
	end
	return true, a, b, c
end

local function now(): number
	return Clock.Now()
end

local function dataOf(p: Player): { [string]: any }?
	local ok, data = call("DataService", "Get", p)
	if ok and type(data) == "table" and type(data.Tower) == "table" then
		return data
	end
	return nil
end

local function langOf(p: Player): LangCode
	local ok, lang = call("PlayerStateService", "LangOf", p)
	if ok and (lang == "de" or lang == "en") then
		return lang
	end
	return Lang.For(p)
end

local function localize(p: Player, key: string, args: { any }?): string
	local lang = langOf(p)
	if args then
		return Lang.T(lang, key, table.unpack(args))
	end
	return Lang.T(lang, key)
end

local function notify(p: Player, key: string, args: { any }?, kind: Types.NotifyKind?)
	call("PlayerStateService", "Notify", p, key, args, kind)
end

local function markDirty(p: Player, ...: string)
	call("PlayerStateService", "MarkDirty", p, ...)
end

local function fail(p: Player, key: string, args: { any }?): Reply
	return { Ok = false, Message = localize(p, key, args) }
end

local function okReply(p: Player, key: string?, args: { any }?, extra: { [string]: any }?): Reply
	local reply: Reply = (extra or {}) :: any
	reply.Ok = true
	if key then
		reply.Message = localize(p, key, args)
	end
	return reply
end

local function fireAll(list: { any }, ...: any)
	for _, cb in ipairs(list) do
		local args = table.pack(...)
		task.spawn(function()
			local ok, err = pcall(cb, table.unpack(args, 1, args.n))
			if not ok then
				logError("Callback", err)
			end
		end)
	end
end

-- CR-Betrag in der Sprache des Empfängers ("1,25 Mio." / "1.25M")
local function credits(p: Player, n: number): string
	return Format.Credits(n, langOf(p))
end

local function plotOf(p: Player): number?
	local ok, plot = call("PlotService", "PlotOf", p)
	if ok and isInt(plot) then
		return plot
	end
	return nil
end

local function balanceOf(p: Player): number
	local ok, value = call("ShopService", "Balance", p)
	if ok and isNum(value) then
		return value
	end
	return 0
end

local function debit(p: Player, amount: number, sink: string): boolean
	if amount <= 0 then
		return true
	end
	local ok, result = call("ShopService", "Debit", p, amount, sink)
	return ok and result == true
end

local function credit(p: Player, amount: number, source: string): boolean
	if amount <= 0 then
		return true
	end
	local ok, result = call("ShopService", "Credit", p, amount, source)
	return ok and result == true
end

local function hasPass(p: Player, key: string): boolean
	local ok, result = call("MonetizationService", "HasPass", p, key)
	return ok and result == true
end

local function isClub(p: Player): boolean
	local ok, result = call("MonetizationService", "IsClub", p)
	return ok and result == true
end

local function isPremium(p: Player): boolean
	local ok, result = pcall(function()
		return p.MembershipType == Enum.MembershipType.Premium
	end)
	return ok and result == true
end

local function licenceOf(p: Player, data: { [string]: any }): number
	local ok, lic = call("ProgressionService", "Licence", p)
	if ok and isInt(lic) then
		return math.clamp(lic, 1, 10)
	end
	local prog = data.Prog
	if type(prog) == "table" and isInt(prog.Licence) then
		return math.clamp(prog.Licence, 1, 10)
	end
	return 1
end

local function ipoCountOf(p: Player, data: { [string]: any }): number
	local ok, count = call("ProgressionService", "IpoCount", p)
	if ok and isInt(count) then
		return math.max(0, count)
	end
	local prestige = sub(data.Prog, "Prestige")
	return if isInt(prestige.Count) then math.max(0, prestige.Count) else 0
end

-- Vorstand-Stufe über den Perk-Schlüssel aus Config.Tower.Perks ("Growth" -> "Wachstum")
local function perkOf(p: Player, data: { [string]: any }, key: string): number
	local branch = PERKS[key]
	if type(branch) ~= "string" then
		return 0
	end
	local ok, level = call("ProgressionService", "Perk", p, branch)
	if ok and isNum(level) then
		return math.max(0, math.floor(level))
	end
	local perks = sub(sub(data.Prog, "Prestige"), "Perks")
	return if isNum(perks[branch]) then math.max(0, math.floor(perks[branch])) else 0
end

local function licenceTable(): { any }
	local prog = Config.Progression
	if type(prog) == "table" and type(prog.Licences) == "table" and #prog.Licences > 0 then
		return prog.Licences
	end
	local trading = Config.Trading
	if type(trading) == "table" and type(trading.LicenceFallback) == "table" then
		return trading.LicenceFallback
	end
	return {}
end

local function licenceName(lang: LangCode, idx: number): string
	local def = licenceTable()[idx]
	if type(def) == "table" then
		if type(def.Name) == "table" then
			return Lang.Pick(lang, def.Name)
		elseif type(def.Key) == "string" then
			return def.Key
		end
	end
	return "#" .. tostring(idx)
end

-- Bau-Kurs hängt NUR von der Lizenz ab (§B8.3) – nie von Pässen, Boosts oder Tower-Stufe
local function bauKursOf(p: Player, data: { [string]: any }): number
	local ok, def = call("ProgressionService", "LicenceDef", p)
	if ok and type(def) == "table" and isNum(def.BauKurs) and def.BauKurs > 0 then
		return math.clamp(def.BauKurs, 1, 1e6)
	end
	local row = licenceTable()[licenceOf(p, data)]
	if type(row) == "table" and isNum(row.BauKurs) and row.BauKurs > 0 then
		return math.clamp(row.BauKurs, 1, 1e6)
	end
	return 40
end

local function comfortOf(key: string): number
	local cached = comfortCache[key]
	if cached ~= nil then
		return cached
	end
	local ok, result = call("LifestyleService", "Comfort", key)
	if not ok or not isNum(result) then
		return 0 -- nicht merken: LifestyleService kann später verfügbar sein
	end
	local value = math.clamp(result, 0, num(DECOR_FALLBACK.ComfortItemMax, 5))
	if comfortCount < MAX_COMFORT_CACHE then
		comfortCache[key] = value
		comfortCount += 1
	end
	return value
end

local function decorCfg(key: string, default: number): number
	local decor = Config.Decor
	if type(decor) == "table" and isNum(decor[key]) then
		return decor[key]
	end
	return num(DECOR_FALLBACK[key], default)
end

-- Lager-Rückfall ohne LifestyleService (nur damit nie Deko verloren geht; Schema §C12.1 Storage.Decor)
local function returnDecorRaw(data: { [string]: any }, key: string)
	if type(data.Storage) ~= "table" then
		data.Storage = { Decor = {} }
	end
	if type(data.Storage.Decor) ~= "table" then
		data.Storage.Decor = {}
	end
	local decor = data.Storage.Decor
	decor[key] = math.max(0, math.floor(num(decor[key], 0))) + 1
end

-- Kosmetik-Besitz (Fassaden/Neon): Pass, LifestyleService.Owns oder Kosmetik-Liste im Spielstand
local function ownsUnlock(p: Player, data: { [string]: any }, entry: any): boolean
	if type(entry) ~= "table" then
		return false
	end
	if entry.Unlock == "Default" then
		return true
	elseif entry.Unlock == "Pass" then
		return type(entry.Pass) == "string" and hasPass(p, entry.Pass)
	end
	local key = entry.Key
	local ok, owned = call("LifestyleService", "Owns", p, key)
	if ok and owned == true then
		return true
	end
	for _, list in ipairs({ data.Cosmetics, sub(data.Purchases, "Cosmetics") }) do
		if type(list) == "table" then
			if list[key] == true then
				return true
			end
			for _, value in ipairs(list) do
				if value == key then
					return true
				end
			end
		end
	end
	return false
end

-- ---------------------------------------------------------------------
-- 4) SERVERWEITE FAKTOREN
-- ---------------------------------------------------------------------
local function activeMult(entry: { Mult: number, Until: number }, t: number): number
	if entry.Until > t and entry.Mult > 1 then
		return entry.Mult
	end
	return 1
end

local function costEventMult(kind: string, t: number): number
	local entry = costEvents[kind]
	if entry and entry.Until > t then
		return math.clamp(entry.Mult, mult("CostEventMin", 0.1), 1)
	end
	return 1
end

local function buildEventMult(t: number): number
	if buildEvent.Until > t then
		return math.clamp(buildEvent.Mult, 0, 1)
	end
	return 1
end

-- ---------------------------------------------------------------------
-- 5) KERN (reine Daten-Operationen auf data.Tower mit einer Env – auch für TowerTests)
-- ---------------------------------------------------------------------
local Core = {}

function Core.NewFloor(): FloorData
	return { R = DEFAULT_ROOM, L = 1, S = {}, D = {} }
end

function Core.Stage(t: any): number
	return TowerMath.StageOf(if type(t.Floors) == "table" then #t.Floors else 0)
end

function Core.RoomCount(t: any, key: string): number
	local count = 0
	if type(t.Floors) == "table" then
		for _, floor in ipairs(t.Floors) do
			if type(floor) == "table" and floor.R == key then
				count += 1
			end
		end
	end
	return count
end

function Core.DecorSlots(t: any, index: number): number
	local floor = t.Floors[index]
	local room = if type(floor) == "table" then ROOMS[floor.R] else nil
	if room and isInt(room.DecorSlots) then
		return math.floor(decorCfg("PenthouseSlots", room.DecorSlots))
	end
	return math.floor(decorCfg("SlotsPerFloor", 3))
end

-- Deko-Liste auf n Plätze kürzen; überzählige Teile gehen ins Lager
local function trimDecor(floor: FloorData, slots: number, returnFn: (string) -> ())
	for i = #floor.D, slots + 1, -1 do
		local key = floor.D[i]
		if type(key) == "string" and key ~= "" then
			returnFn(key)
		end
		floor.D[i] = nil
	end
	-- leere Plätze am Ende entfernen (JSON-Liste bleibt lückenlos, "" = leerer Platz)
	for i = #floor.D, 1, -1 do
		if floor.D[i] == "" then
			floor.D[i] = nil
		else
			break
		end
	end
end

local function repairFloor(raw: any): FloorData
	if type(raw) ~= "table" then
		return Core.NewFloor()
	end
	local floor: FloorData = {
		R = if type(raw.R) == "string" and ROOMS[raw.R] then raw.R else DEFAULT_ROOM,
		L = if isNum(raw.L) then math.clamp(math.floor(raw.L), 1, 5) else 1,
		S = {},
		D = {},
	}
	if type(raw.S) == "table" then
		for _, key in ipairs(raw.S) do
			local staff = STAFF[key]
			if staff and not staff.Lobby and #floor.S < STAFF_SLOTS_PLUS then
				table.insert(floor.S, key)
			end
		end
	end
	if type(raw.D) == "table" then
		for i, key in ipairs(raw.D) do
			if i > 16 then
				break
			end
			floor.D[i] = if type(key) == "string" and #key <= MAX_DECOR_KEY then key else ""
		end
	end
	return floor
end

-- Turm-Daten reparieren (nach dem Laden). Gibt die Erstattung einer ungültigen Baustelle zurück (CR).
function Core.Repair(data: { [string]: any }): number
	local t = data.Tower
	local refund = 0
	local old = if type(t.Floors) == "table" then t.Floors else {}
	local floors: { FloorData } = {}
	for i, raw in ipairs(old) do
		if i > FLOORS then
			break
		end
		floors[i] = repairFloor(raw)
	end
	if type(t.Floors) ~= "table" then
		t.Floors = {}
	end
	table.clear(t.Floors)
	for i, floor in ipairs(floors) do
		t.Floors[i] = floor
	end
	local count = #t.Floors
	-- Penthouse nur ganz oben; Deko-Plätze passend kürzen
	for i, floor in ipairs(t.Floors) do
		local room = ROOMS[floor.R]
		if room and room.TopOnly and i ~= count then
			floor.R = DEFAULT_ROOM
		end
		trimDecor(floor, Core.DecorSlots(t, i), function(key: string)
			returnDecorRaw(data, key)
		end)
	end
	-- Baustelle
	if type(t.Build) ~= "table" then
		t.Build = {}
	end
	local build = t.Build
	if build.Floor ~= nil then
		local valid = isInt(build.Floor)
			and build.Floor == count + 1
			and build.Floor <= FLOORS
			and isNum(build.Until)
			and isNum(build.Start)
		if not valid then
			if isNum(build.Cost) and build.Cost > 0 then
				refund = TowerMath.Clamp(build.Cost)
			end
			t.Build = {}
		end
	end
	if t.Build.Floor == nil then
		t.Build = {}
		t.Helpers = {}
	end
	local effMax = math.floor(num(sub(TCFG, "Efficiency").Max, 20))
	t.Eff = if isNum(t.Eff) then math.clamp(math.floor(t.Eff), 0, effMax) else 0
	t.Vault = TowerMath.Clamp(num(t.Vault, 0))
	t.RunSpend = TowerMath.Clamp(num(t.RunSpend, 0))
	t.PendingCredits = TowerMath.Clamp(num(t.PendingCredits, 0))
	if type(t.Skin) ~= "string" or SKINS[t.Skin] == nil then
		t.Skin = DEFAULT_SKIN
	end
	if type(t.Neon) ~= "string" or NEONS[t.Neon] == nil then
		t.Neon = DEFAULT_NEON
	end
	if type(t.Crown) ~= "string" then
		t.Crown = ""
	end
	if type(t.Name) ~= "table" then
		t.Name = { A = 1, N = 1 }
	end
	t.Name.A = if isInt(t.Name.A) and t.Name.A >= 1 and t.Name.A <= NAME_ADJ then t.Name.A else 1
	t.Name.N = if isInt(t.Name.N) and t.Name.N >= 1 and t.Name.N <= NAME_NOUN then t.Name.N else 1
	local private: { number } = {}
	local seen: { [number]: boolean } = {}
	if type(t.Private) == "table" then
		for _, floor in ipairs(t.Private) do
			if isInt(floor) and floor >= 1 and floor <= count and not seen[floor] and #private < PRIVATE_MAX then
				seen[floor] = true
				table.insert(private, floor)
			end
		end
	end
	t.Private = private
	local express: { number } = {}
	if type(t.Express) == "table" then
		for _, seconds in ipairs(t.Express) do
			if isNum(seconds) and seconds >= 1 and #express < EXPRESS_MAX then
				table.insert(express, math.clamp(math.floor(seconds), 1, EXPRESS_MAX_SECONDS))
			end
		end
	end
	t.Express = express
	t.Instant = if isNum(t.Instant) then math.clamp(math.floor(t.Instant), 0, INSTANT_MAX) else 0
	t.InstantDay = if isInt(t.InstantDay) then math.max(0, t.InstantDay) else 0
	local helpers: { number } = {}
	if type(t.Helpers) == "table" then
		for _, userId in ipairs(t.Helpers) do
			if isInt(userId) and #helpers < HELP_MAX then
				table.insert(helpers, userId)
			end
		end
	end
	t.Helpers = helpers
	if type(t.Layouts) ~= "table" then
		t.Layouts = {}
	end
	if type(t.KeepLayout) ~= "boolean" then
		t.KeepLayout = true
	end
	if type(t.Janitor) ~= "boolean" then
		t.Janitor = false
	end
	if type(t.Security) ~= "boolean" then
		t.Security = false
	end
	-- Boosts (Rest-Spielsekunden)
	if type(data.Boosts) ~= "table" then
		data.Boosts = { X2 = 0, X5 = 0, Bull = 0 }
	end
	local boostMax = mult("BoostMaxSeconds", 2592000)
	for _, kind in ipairs({ "X2", "X5", "Bull" }) do
		data.Boosts[kind] = math.clamp(num(data.Boosts[kind], 0), 0, boostMax)
	end
	return refund
end

-- Kosten-Faktor: Vorstand "Bau" (−5 %/Stufe) × Bau-Boom (nur Etagen/Raum-Stufen)
function Core.CostFactor(env: Env, kind: string?): number
	local level = math.clamp(env.Perk("Build"), 0, num(IPO.BuildMax, 8))
	local factor = 1 - num(IPO.BuildPct, 0.05) * level
	if kind == "Floor" or kind == "RoomLevel" then
		factor *= env.CostEvent(kind)
	end
	return math.clamp(factor, 0, 1)
end

-- Bauzeit mit Bau-Crew Pro, Vorstand "Tempo", Admin-Bau-Boom (TowerMath klemmt auf ≥ 25 % der Grundzeit)
function Core.BuildSeconds(n: number, env: Env): number
	local speed = 1
	if env.HasPass(BUILD.CrewPass or "BuildCrew") then
		speed *= 1 - num(BUILD.CrewPct, 0.5)
	end
	local tempo = math.clamp(env.Perk("Tempo"), 0, num(BUILD.TempoMax, 5))
	speed *= 1 - num(BUILD.TempoPct, 0.10) * tempo
	speed *= env.BuildEvent
	return TowerMath.BuildSeconds(n, speed)
end

local function stageName(lang: LangCode, stage: number): string
	local entry = STAGES[stage]
	return if type(entry) == "table" then Lang.Pick(lang, entry.Name) else tostring(stage)
end

-- Nächste Etage starten (Tor, CR, Kran frei). Gibt (ok, Fehler-Schlüssel, Argumente, Ergebnis) zurück.
-- Argumente mit Lizenz-/Stufen-Index werden vom Aufrufer lokalisiert (Rückgabe "Gate").
function Core.StartBuild(t: any, env: Env): (boolean, string?, { any }?, { [string]: any }?)
	local n = #t.Floors + 1
	if n > FLOORS then
		return false, "tower.maxFloors", nil, nil
	end
	if t.Build.Floor ~= nil then
		return false, "tower.craneBusy", { math.max(0, math.ceil(num(t.Build.Until, 0) - env.Now)) }, nil
	end
	local licence, ipo = TowerMath.GateFor(n)
	if env.Licence < licence then
		return false, "tower.gateLicence", nil, { Stage = TowerMath.StageOf(n), Licence = licence }
	end
	if env.Ipo < ipo then
		return false, "tower.gateIpo", nil, { Stage = TowerMath.StageOf(n), Ipo = ipo }
	end
	local cost = TowerMath.Discount(TowerMath.FloorCost(n), Core.CostFactor(env, "Floor"))
	if cost > 0 then
		local balance = env.Balance()
		if balance < cost then
			return false, "tower.noCredits", { cost - balance }, nil
		end
		if not env.Debit(cost, "Floor") then
			return false, "tower.noCredits", { cost }, nil
		end
	end
	local seconds = math.max(0, Core.BuildSeconds(n, env))
	t.Build = { Floor = n, Start = env.Now, Until = env.Now + seconds, Total = seconds, Cost = cost }
	t.Helpers = {}
	t.RunSpend = TowerMath.Clamp(t.RunSpend + cost)
	return true, nil, nil, { Floor = n, Cost = cost, Seconds = seconds }
end

-- Fertige Baustelle übernehmen. Gibt (Etage, alte Stufe, neue Stufe) oder nil zurück.
function Core.FinishBuild(t: any, env: Env): (number?, number, number)
	local build = t.Build
	local n = build.Floor
	if not isInt(n) or n ~= #t.Floors + 1 or n > FLOORS then
		t.Build = {}
		t.Helpers = {}
		return nil, Core.Stage(t), Core.Stage(t)
	end
	local oldStage = Core.Stage(t)
	local floor = Core.NewFloor()
	-- Penthouse wandert mit nach oben (nur die oberste Etage darf es sein)
	local top = t.Floors[#t.Floors]
	local topRoom = if top then ROOMS[top.R] else nil
	if top and topRoom and topRoom.TopOnly then
		floor.R = top.R
		floor.D = top.D
		top.R = DEFAULT_ROOM
		top.D = {}
	end
	table.insert(t.Floors, floor)
	t.Build = {}
	t.Helpers = {}
	-- "Layout merken": Deko dieser Etage aus dem letzten Lauf wieder aufstellen
	local layout = if t.KeepLayout then t.Layouts[tostring(n)] else nil
	if type(layout) == "table" and #floor.D == 0 then
		local slots = Core.DecorSlots(t, n)
		for slotIndex = 1, math.min(#layout, slots) do
			local key = layout[slotIndex]
			if type(key) == "string" and key ~= "" and env.TakeDecor(key) then
				floor.D[slotIndex] = key
			elseif floor.D[slotIndex] == nil then
				floor.D[slotIndex] = ""
			end
		end
		trimDecor(floor, slots, env.ReturnDecor)
	end
	return n, oldStage, Core.Stage(t)
end

local function floorAt(t: any, index: any): FloorData?
	if not isInt(index) or index < 1 or index > #t.Floors then
		return nil
	end
	return t.Floors[index]
end

function Core.SetRoom(t: any, env: Env, index: number, key: string): (boolean, string?, { any }?)
	local floor = floorAt(t, index)
	if not floor then
		return false, "tower.noFloor", nil
	end
	local room = ROOMS[key]
	if not room then
		return false, "core.invalid", nil
	end
	if floor.R == key then
		return false, "tower.roomSame", nil
	end
	if Core.Stage(t) < num(room.MinStage, 1) then
		return false, "tower.roomLocked", { room.MinStage }
	end
	if room.TopOnly and index ~= #t.Floors then
		return false, "tower.roomTopOnly", nil
	end
	if isInt(room.Max) and Core.RoomCount(t, key) >= room.Max then
		return false, "tower.roomMax", { room.Max }
	end
	local cost = TowerMath.RoomChangeCost(index)
	if cost > 0 then
		local balance = env.Balance()
		if balance < cost then
			return false, "tower.noCredits", { cost - balance }
		end
		if not env.Debit(cost, "Room") then
			return false, "tower.noCredits", { cost }
		end
	end
	floor.R = key
	trimDecor(floor, Core.DecorSlots(t, index), env.ReturnDecor)
	t.RunSpend = TowerMath.Clamp(t.RunSpend + cost)
	return true, nil, { cost }
end

function Core.LevelUp(t: any, env: Env, index: number): (boolean, string?, { any }?)
	local floor = floorAt(t, index)
	if not floor then
		return false, "tower.noFloor", nil
	end
	if floor.L >= 5 then
		return false, "tower.levelMax", nil
	end
	local cost = TowerMath.Discount(TowerMath.LevelCost(index, floor.L), Core.CostFactor(env, "RoomLevel"))
	local balance = env.Balance()
	if balance < cost then
		return false, "tower.noCredits", { cost - balance }
	end
	if not env.Debit(cost, "RoomLevel") then
		return false, "tower.noCredits", { cost }
	end
	floor.L += 1
	t.RunSpend = TowerMath.Clamp(t.RunSpend + cost)
	return true, nil, { index, floor.L }
end

function Core.StaffSlots(env: Env): number
	return if env.HasPass(TCFG.StaffPass or "StaffPlus") then STAFF_SLOTS_PLUS else STAFF_SLOTS
end

function Core.Hire(t: any, env: Env, index: number, key: string): (boolean, string?, { any }?)
	local staff = STAFF[key]
	if not staff then
		return false, "core.invalid", nil
	end
	if Core.Stage(t) < num(staff.MinStage, 1) then
		return false, "tower.staffLocked", { staff.MinStage }
	end
	if staff.Lobby then
		if t[key] == true then
			return false, "tower.uniqueOwned", nil
		end
		local cost = TowerMath.Discount(TowerMath.StaffCost(0, key), Core.CostFactor(env, nil))
		if cost > 0 then
			local balance = env.Balance()
			if balance < cost then
				return false, "tower.noCredits", { cost - balance }
			end
			if not env.Debit(cost, "Staff") then
				return false, "tower.noCredits", { cost }
			end
		end
		t[key] = true
		t.RunSpend = TowerMath.Clamp(t.RunSpend + cost)
		return true, nil, { 0 }
	end
	local floor = floorAt(t, index)
	if not floor then
		return false, "tower.noFloor", nil
	end
	local slots = Core.StaffSlots(env)
	if #floor.S >= slots then
		return false, if slots < STAFF_SLOTS_PLUS then "tower.slotsPlus" else "tower.slotsFull", { index }
	end
	local cost = TowerMath.Discount(TowerMath.StaffCost(index, key), Core.CostFactor(env, nil))
	local balance = env.Balance()
	if balance < cost then
		return false, "tower.noCredits", { cost - balance }
	end
	if not env.Debit(cost, "Staff") then
		return false, "tower.noCredits", { cost }
	end
	table.insert(floor.S, key)
	t.RunSpend = TowerMath.Clamp(t.RunSpend + cost)
	return true, nil, { index }
end

-- Etage 0 = Lobby: Platz 1 Hausmeister-Bot, Platz 2 Sicherheits-Bot
function Core.Fire(t: any, index: number, slot: number): (boolean, string?, string?)
	if index == 0 then
		local key = if slot == 1 then "Janitor" elseif slot == 2 then "Security" else nil
		if key == nil or t[key] ~= true then
			return false, "tower.noStaff", nil
		end
		t[key] = false
		return true, nil, key
	end
	local floor = floorAt(t, index)
	if not floor then
		return false, "tower.noFloor", nil
	end
	if not isInt(slot) or slot < 1 or slot > #floor.S then
		return false, "tower.noStaff", nil
	end
	local key = table.remove(floor.S, slot)
	return true, nil, key
end

function Core.Efficiency(t: any, env: Env): (boolean, string?, { any }?)
	local max = math.floor(num(sub(TCFG, "Efficiency").Max, 20))
	if t.Eff >= max then
		return false, "tower.effMax", nil
	end
	local cost = TowerMath.Discount(TowerMath.EfficiencyCost(t.Eff), Core.CostFactor(env, nil))
	local balance = env.Balance()
	if balance < cost then
		return false, "tower.noCredits", { cost - balance }
	end
	if not env.Debit(cost, "Efficiency") then
		return false, "tower.noCredits", { cost }
	end
	t.Eff += 1
	t.RunSpend = TowerMath.Clamp(t.RunSpend + cost)
	return true, nil, { t.Eff }
end

-- Deko in einen festen Platz stellen (key) oder entfernen (key = nil/"")
function Core.SetDecor(t: any, env: Env, index: number, slot: number, key: string?): (boolean, string?)
	local floor = floorAt(t, index)
	if not floor then
		return false, "tower.noFloor"
	end
	local slots = Core.DecorSlots(t, index)
	if not isInt(slot) or slot < 1 or slot > slots then
		return false, "core.invalid"
	end
	for i = #floor.D + 1, slot do
		floor.D[i] = ""
	end
	local old = floor.D[slot]
	if key ~= nil and key ~= "" then
		if old == key then
			return false, "tower.decorSame"
		end
		if not env.TakeDecor(key) then
			return false, "tower.decorNone"
		end
		floor.D[slot] = key
	else
		floor.D[slot] = ""
	end
	if type(old) == "string" and old ~= "" then
		env.ReturnDecor(old)
	end
	trimDecor(floor, slots, env.ReturnDecor)
	return true, nil
end

function Core.SetPrivate(t: any, index: number, on: boolean): (boolean, string?, { any }?)
	if not floorAt(t, index) then
		return false, "tower.noFloor", nil
	end
	local position = table.find(t.Private, index)
	if on then
		if position then
			return true, nil, nil
		end
		if #t.Private >= PRIVATE_MAX then
			return false, "tower.privateMax", { PRIVATE_MAX }
		end
		table.insert(t.Private, index)
	elseif position then
		table.remove(t.Private, position)
	end
	return true, nil, nil
end

-- Restzeit der Baustelle um seconds kürzen (Bau-Express) – beendet sie, wenn der Rest reicht
function Core.ApplyExpress(t: any, env: Env, seconds: number): boolean
	if t.Build.Floor == nil then
		return false
	end
	local remaining = num(t.Build.Until, env.Now) - env.Now
	if remaining <= seconds then
		t.Build.Until = env.Now
	else
		t.Build.Until -= seconds
	end
	return true
end

-- Bau-Hilfe: −HelpPct der Restzeit, höchstens HelpMax Helfer je Etage, je Helfer 1×, nie unter MinFactor
function Core.ApplyHelp(t: any, env: Env, helperId: number): (boolean, string?)
	local build = t.Build
	if build.Floor == nil then
		return false, "tower.noBuild"
	end
	local remaining = num(build.Until, env.Now) - env.Now
	if remaining <= 5 then
		return false, "tower.instantNotNeeded"
	end
	if table.find(t.Helpers, helperId) then
		return false, "tower.helpAgain"
	end
	if #t.Helpers >= HELP_MAX then
		return false, "tower.helpFull"
	end
	local floorBase = TowerMath.BuildTime(build.Floor) * num(BUILD.MinFactor, 0.25)
	local earliest = num(build.Start, env.Now) + floorBase
	local target = build.Until - remaining * num(BUILD.HelpPct, 0.10)
	build.Until = math.max(earliest, math.min(build.Until, target))
	table.insert(t.Helpers, helperId)
	return true, nil
end

-- Börsengang-Reset (§B9.6): CR (Start-CR laut Perk, Standard 0), Etagen, Abteilungen, Raum-Stufen, Personal,
-- Effizienz, Baustelle, Tresor starten neu. Bleibt: Depot, Lizenz, Lager (Deko kommt zurück, Layout gemerkt),
-- Fassade/Neon/Name, Token, Boosts, Lobby-Bots. Gibt false zurück, ohne etwas zu ändern, wenn CR nicht abbuchbar.
function Core.ResetForIpo(data: { [string]: any }, env: Env, perks: { [string]: number }?): boolean
	local t = data.Tower
	local perkTable = if type(perks) == "table" then perks else {}
	local startCredits = TowerMath.Clamp(num(perkTable.StartCredits, 0))
	-- 1) CR auf Start-CR (zuerst – schlägt das fehl, bleibt alles unverändert)
	local balance = env.Balance()
	if balance > startCredits then
		local amount = balance - startCredits
		if not env.Debit(amount, "Ipo") and not env.Debit(amount, "Admin") then
			return false
		end
	elseif balance < startCredits then
		env.Credit(startCredits - balance, "Admin")
	end
	-- 2) Layout merken + Deko zurück ins Lager
	local layouts: { [string]: { string } } = {}
	for i, floor in ipairs(t.Floors) do
		local keep: { string } = {}
		local any = false
		for slotIndex, key in ipairs(floor.D) do
			keep[slotIndex] = if type(key) == "string" then key else ""
			if type(key) == "string" and key ~= "" then
				any = true
				env.ReturnDecor(key)
			end
		end
		if any then
			layouts[tostring(i)] = keep
		end
	end
	if t.KeepLayout then
		t.Layouts = layouts
	end
	-- 3) Neustart
	table.clear(t.Floors)
	t.Eff = 0
	t.Vault = 0
	t.Build = {}
	t.Helpers = {}
	t.RunSpend = 0
	t.Private = {}
	t.PendingCredits = 0 -- vorgemerkte CR gehören zum alten Lauf (sonst umgingen sie den CR-Neustart)
	if IPO.KeepLobbyBots == false then
		t.Janitor = false
		t.Security = false
	end
	-- 4) Vorstand "Blitzstart": Start mit 4 / 8 / 12 fertigen Etagen (+ gemerkte Deko)
	local blitzBranch = PERKS.Blitz or "Blitzstart"
	local level = num(perkTable[blitzBranch], num(perkTable.Blitz, env.Perk("Blitz")))
	local blitzList = if type(IPO.Blitz) == "table" then IPO.Blitz else {}
	level = math.clamp(math.floor(level), 0, #blitzList)
	local startFloors = if level > 0 then math.clamp(math.floor(num(blitzList[level], 0)), 0, FLOORS) else 0
	for i = 1, startFloors do
		t.Floors[i] = Core.NewFloor()
	end
	if t.KeepLayout then
		for i = 1, startFloors do
			local layout = t.Layouts[tostring(i)]
			if type(layout) == "table" then
				local floor = t.Floors[i]
				local slots = Core.DecorSlots(t, i)
				for slotIndex = 1, math.min(#layout, slots) do
					local key = layout[slotIndex]
					floor.D[slotIndex] = if type(key) == "string" and key ~= "" and env.TakeDecor(key) then key else ""
				end
				trimDecor(floor, slots, env.ReturnDecor)
			end
		end
	end
	return true
end

-- Admin: Etagenzahl setzen (Baustelle wird erstattet, Deko entfernter Etagen geht ins Lager)
function Core.SetFloors(t: any, env: Env, n: number)
	if t.Build.Floor ~= nil then
		local cost = TowerMath.Clamp(num(t.Build.Cost, 0))
		if cost > 0 then
			env.Credit(cost, "Refund")
		end
		t.Build = {}
		t.Helpers = {}
	end
	local target = math.clamp(math.floor(n), 0, FLOORS)
	while #t.Floors > target do
		local floor = table.remove(t.Floors)
		if floor then
			for _, key in ipairs(floor.D) do
				if type(key) == "string" and key ~= "" then
					env.ReturnDecor(key)
				end
			end
		end
	end
	while #t.Floors < target do
		table.insert(t.Floors, Core.NewFloor())
	end
	-- Penthouse nur oben
	for i, floor in ipairs(t.Floors) do
		local room = ROOMS[floor.R]
		if room and room.TopOnly and i ~= #t.Floors then
			floor.R = DEFAULT_ROOM
			trimDecor(floor, Core.DecorSlots(t, i), env.ReturnDecor)
		end
	end
	local private: { number } = {}
	for _, floor in ipairs(t.Private) do
		if floor <= #t.Floors then
			table.insert(private, floor)
		end
	end
	t.Private = private
end

function Core.ConvertTransfer(akyCents: number, bauKurs: number): number
	if not isNum(akyCents) or not isNum(bauKurs) or akyCents <= 0 or bauKurs <= 0 then
		return 0
	end
	return TowerMath.Clamp(math.floor(akyCents * bauKurs / 100))
end

-- Gewinn-Transfer-Fluss (§B8.2): AKY verlassen das Depot NUR über withdraw (OrderService.Withdraw, Cent),
-- werden zum Bau-Kurs der Lizenz in CR umgerechnet und gutgeschrieben (sonst vorgemerkt, nie zurück ins Depot).
-- Gibt (Cent, CR, Grund-Schlüssel) zurück.
function Core.Transfer(
	withdraw: () -> (any, any),
	bauKurs: number,
	creditFn: (amount: number) -> boolean,
	pend: (amount: number) -> ()
): (number, number, string?)
	local cents, why = withdraw()
	local akyCents = if isNum(cents) then math.max(0, math.floor(cents)) else 0
	if akyCents <= 0 then
		return 0, 0, if type(why) == "string" then why else "trade.transferNone"
	end
	local amount = Core.ConvertTransfer(akyCents, bauKurs)
	if amount > 0 and not creditFn(amount) then
		pend(amount)
	end
	return akyCents, amount, nil
end

-- ---------------------------------------------------------------------
-- 6) MULTIPLIKATOR-TEILE (§B5.2)
-- ---------------------------------------------------------------------
export type Factors = {
	Eff: number,
	Ipo: number,
	Growth: number,
	Album: number,
	Friends: number,
	Respekt: number,
	Marketing: number,
	Penthouse: boolean,
	Trader: { { Key: string, Value: number } },
	Pass: number,
	Fixed: { { Key: string, Value: number } },
	Boost: { Key: string, Value: number, Until: number, Source: string }?,
	Server: { Key: string, Value: number, Until: number }?,
	Event: { Value: number, Until: number? }?,
}

local function addPart(
	parts: { MultPart },
	key: string,
	value: number,
	group: "Perm" | "Trader" | "Pass" | "Fixed" | "Timed",
	source: "Earned" | "Skill" | "Bought" | "Event",
	untilT: number?
)
	if not isNum(value) then
		return
	end
	if group == "Perm" and value <= 0 then
		return
	end
	if group ~= "Perm" and value <= 1 + 1e-9 then
		return
	end
	table.insert(parts, { Key = key, Value = value, Group = group, Source = source, Until = untilT })
end

-- social = Freunde/Respekt einrechnen (nur in der Sitzung), timed = Zeitlich einrechnen
function Core.BuildParts(f: Factors, social: boolean, timed: boolean): { MultPart }
	local parts: { MultPart } = {}
	local effStep = num(sub(TCFG, "Efficiency").Step, 0.10)
	addPart(parts, "Efficiency", effStep * f.Eff, "Perm", "Earned")
	addPart(parts, "Ipo", mult("IpoStep", 0.25) * math.min(f.Ipo, mult("IpoMax", 20)), "Perm", "Earned")
	addPart(parts, "Growth", mult("GrowthStep", 0.10) * math.min(f.Growth, mult("GrowthMax", 10)), "Perm", "Earned")
	addPart(parts, "Album", mult("AlbumStep", 0.02) * math.min(f.Album, mult("AlbumMax", 6)), "Perm", "Earned")
	if social then
		addPart(
			parts,
			"Friends",
			mult("FriendStep", 0.10) * math.min(f.Friends, mult("FriendMax", 4)),
			"Perm",
			"Earned"
		)
		addPart(
			parts,
			"Respekt",
			mult("RespektStep", 0.01) * math.min(f.Respekt, mult("RespektMax", 20)),
			"Perm",
			"Earned"
		)
	end
	local marketing = ROOMS.Marketing
	if marketing then
		local count = math.min(f.Marketing, num(marketing.Max, 3))
		addPart(parts, "Marketing", num(marketing.IncomePct, 0.05) * count, "Perm", "Earned")
	end
	local penthouse = ROOMS.Penthouse
	if penthouse and f.Penthouse then
		addPart(parts, "Penthouse", num(penthouse.IncomePct, 0.10), "Perm", "Earned")
	end
	for _, entry in ipairs(f.Trader) do
		addPart(parts, entry.Key, entry.Value, "Trader", "Skill")
	end
	if f.Pass >= 4 - 1e-9 and f.Pass <= 4 + 1e-9 then
		-- beide Pässe: EINE ehrliche Zeile "Einkommens-Pässe ×4" (x2 + x3 = x4, nie ×2 und ×3 nebeneinander)
		addPart(parts, "Passes", 4, "Pass", "Bought")
	elseif f.Pass >= 3 - 1e-9 and f.Pass <= 3 + 1e-9 then
		addPart(parts, "Income3x", 3, "Pass", "Bought")
	elseif f.Pass >= 2 - 1e-9 and f.Pass <= 2 + 1e-9 then
		addPart(parts, "Income2x", 2, "Pass", "Bought")
	else
		addPart(parts, "Passes", f.Pass, "Pass", "Bought")
	end
	for _, entry in ipairs(f.Fixed) do
		addPart(parts, entry.Key, entry.Value, "Fixed", "Bought")
	end
	if timed then
		local boost = f.Boost
		if boost then
			addPart(parts, boost.Key, boost.Value, "Timed", boost.Source :: any, boost.Until)
		end
		local server = f.Server
		if server then
			addPart(parts, server.Key, server.Value, "Timed", "Event", server.Until)
		end
		local event = f.Event
		if event then
			addPart(parts, "Event", math.min(event.Value, mult("EventMax", 3)), "Timed", "Event", event.Until)
		end
	end
	return parts
end

-- Stärkster aktiver persönlicher Boost (x5 vor x2 vor Bullen-Bonus; die anderen pausieren)
local function activeBoostKind(data: { [string]: any }): (string?, number)
	local events = Config.Events
	if type(events) == "table" and events.BoostPause == true then
		return nil, 1
	end
	local boosts = data.Boosts
	if type(boosts) ~= "table" then
		return nil, 1
	end
	local best: string? = nil
	local bestValue = 1
	for _, kind in ipairs({ "X5", "X2", "Bull" }) do
		if num(boosts[kind], 0) > 0 then
			local value = mult(kind, if kind == "X5" then 5 elseif kind == "X2" then 2 else 1.5)
			if value > bestValue then
				best, bestValue = kind, value
			end
		end
	end
	return best, bestValue
end

local function traderEntries(p: Player): { { Key: string, Value: number } }
	local ok, total, licPart, rufPart = call("ProgressionService", "TraderFactor", p)
	if not ok or not isNum(total) or total < 1 then
		return {}
	end
	if isNum(licPart) and isNum(rufPart) then
		if licPart >= 1 and rufPart >= 1 and math.abs(licPart * rufPart - total) < 1e-6 then
			return { { Key = "Licence", Value = licPart }, { Key = "Ruf", Value = rufPart } }
		end
		if licPart >= 0 and rufPart >= 0 and math.abs((1 + licPart) * (1 + rufPart) - total) < 1e-6 then
			return { { Key = "Licence", Value = 1 + licPart }, { Key = "Ruf", Value = 1 + rufPart } }
		end
	end
	return { { Key = "Licence", Value = math.min(total, 10) } }
end

local function fixedEntries(p: Player): { { Key: string, Value: number } }
	local premium = isPremium(p)
	local ok, factor = call("MonetizationService", "FixedFactor", p)
	if not ok or not isNum(factor) then
		-- ohne Shop-Dienst zählt nur Roblox Premium
		return if premium then { { Key = "Premium", Value = mult("Premium", 1.10) } } else {}
	end
	local entries: { { Key: string, Value: number } } = {}
	local product = 1
	if hasPass(p, "VIP") then
		table.insert(entries, { Key = "Vip", Value = mult("Vip", 1.10) })
		product *= mult("Vip", 1.10)
	end
	if isClub(p) then
		table.insert(entries, { Key = "Club", Value = mult("Club", 1.15) })
		product *= mult("Club", 1.15)
	end
	if premium then
		table.insert(entries, { Key = "Premium", Value = mult("Premium", 1.10) })
		product *= mult("Premium", 1.10)
	end
	if math.abs(product - factor) < 1e-6 then
		return entries
	end
	-- Aufteilung passt nicht zur Wahrheit von WP10 -> eine Zeile mit dem echten Faktor
	return if factor > 1 then { { Key = "Fixed", Value = math.min(factor, 10) } } else {}
end

local function passFactorOf(p: Player): number
	local ok, factor = call("MonetizationService", "PassFactor", p)
	if ok and isNum(factor) then
		return math.clamp(factor, 1, 4)
	end
	return TowerMath.PassFactor(hasPass(p, "Income2x"), hasPass(p, "Income3x"))
end

local function gatherFactors(p: Player, data: { [string]: any }, t: number): Factors
	local tower = data.Tower
	local okAlbum, album = call("ProgressionService", "AlbumSets", p)
	local okFriends, friends = call("CommunityService", "FriendsInServer", p)
	local okRespekt, respekt = call("CommunityService", "RespektActive", p)
	local count = #tower.Floors
	local top = tower.Floors[count]
	local factors: Factors = {
		Eff = tower.Eff,
		Ipo = ipoCountOf(p, data),
		Growth = perkOf(p, data, "Growth"),
		Album = if okAlbum and isNum(album) then math.max(0, math.floor(album)) else 0,
		Friends = if okFriends and isNum(friends) then math.max(0, math.floor(friends)) else 0,
		Respekt = if okRespekt and isNum(respekt) then math.max(0, math.floor(respekt)) else 0,
		Marketing = Core.RoomCount(tower, "Marketing"),
		Penthouse = top ~= nil and ROOMS[top.R] ~= nil and ROOMS[top.R].TopOnly == true,
		Trader = traderEntries(p),
		Pass = passFactorOf(p),
		Fixed = fixedEntries(p),
		Boost = nil,
		Server = nil,
		Event = nil,
	}
	local kind, value = activeBoostKind(data)
	if kind then
		factors.Boost = {
			Key = kind,
			Value = value,
			Until = math.floor(t + num(data.Boosts[kind], 0)),
			Source = if kind == "Bull" then "Event" else "Bought",
		}
	end
	local parade = activeMult(serverBoost.Parade, t)
	local bell = activeMult(serverBoost.Bell, t)
	if parade > 1 or bell > 1 then
		if parade >= bell then
			factors.Server = { Key = "Parade", Value = parade, Until = serverBoost.Parade.Until }
		else
			factors.Server = { Key = "BellMoment", Value = bell, Until = serverBoost.Bell.Until }
		end
	end
	local eventValue = activeMult(eventBoost, t)
	local eventUntil = eventBoost.Until
	local okEvent, pulled = call("EventService", "EventMult")
	if okEvent and isNum(pulled) and pulled > eventValue then
		eventValue = pulled
		eventUntil = 0
	end
	eventValue = math.clamp(eventValue, 1, mult("EventMax", 3))
	if eventValue > 1 then
		factors.Event = { Value = eventValue, Until = if eventUntil > t then eventUntil else nil }
	end
	return factors
end

-- ---------------------------------------------------------------------
-- 7) EINKOMMEN, TRESOR
-- ---------------------------------------------------------------------
local function newRuntime(): Runtime
	return {
		Base = 0,
		BaseDirty = true,
		Info = nil,
		InfoAt = -math.huge,
		InfoSig = "",
		VaultCap = 0,
		VaultFrac = 0,
		VaultFullNotified = false,
		JanitorAcc = 0,
		AutoAcc = 0,
		SlowAcc = 0,
		JoinClock = os.clock(),
		JoinUnix = Clock.Now(),
		Settled = false,
		Welcome = nil,
		StageToastAt = -math.huge,
		MaxMoneyAt = -math.huge,
		AutoDirtyAt = -math.huge,
		Repaired = false,
	}
end

local function comfortCtx(): TowerMath.Ctx
	return {
		Comfort = comfortOf,
		ComfortPct = decorCfg("ComfortPct", 0.005),
		ComfortMax = decorCfg("ComfortMax", 0.10),
	}
end

local function baseOf(rt: Runtime, tower: any): number
	if rt.BaseDirty then
		rt.Base = TowerMath.BaseIncome(tower.Floors, comfortCtx())
		rt.BaseDirty = false
	end
	return rt.Base
end

local function emptyInfo(): IncomeInfo
	return { PerSec = 0, Steady = 0, Mult = 1, Parts = {} }
end

local function infoSignature(info: IncomeInfo): string
	local pieces = { string.format("%.6g|%.6g", info.PerSec, info.Mult) }
	for _, part in ipairs(info.Parts) do
		table.insert(pieces, part.Key .. "=" .. string.format("%.4g", part.Value) .. "@" .. tostring(part.Until or ""))
	end
	return table.concat(pieces, ",")
end

local function computeInfo(p: Player, data: { [string]: any }, rt: Runtime, t: number): IncomeInfo
	local base = baseOf(rt, data.Tower)
	local parts = Core.BuildParts(gatherFactors(p, data, t), true, true)
	local total, steady = TowerMath.Multiplier(parts :: any)
	return {
		PerSec = math.min(base * total, MAX_MONEY),
		Steady = math.min(base * steady, MAX_MONEY),
		Mult = total,
		Parts = parts,
	}
end

local function vaultCapOf(data: { [string]: any }, info: IncomeInfo): number
	return TowerMath.VaultCap(info.PerSec, Core.RoomCount(data.Tower, "Vault"))
end

-- Einkommen holen/aktualisieren; markiert Income (und Tower bei neuer Tresor-Kapazität) bei Änderung
local function refreshIncome(p: Player, data: { [string]: any }, rt: Runtime, force: boolean): IncomeInfo
	local clockNow = os.clock()
	local info = rt.Info
	if info and not force and not rt.BaseDirty and clockNow - rt.InfoAt < PARTS_REFRESH then
		return info
	end
	local fresh = computeInfo(p, data, rt, now())
	rt.Info = fresh
	rt.InfoAt = clockNow
	local sig = infoSignature(fresh)
	if sig ~= rt.InfoSig then
		rt.InfoSig = sig
		markDirty(p, "Income")
	end
	local cap = vaultCapOf(data, fresh)
	if math.abs(cap - rt.VaultCap) > math.max(1, rt.VaultCap * 0.001) then
		rt.VaultCap = cap
		markDirty(p, "Tower")
	end
	return fresh
end

local function invalidate(p: Player)
	local rt = runtime[p]
	if rt then
		rt.BaseDirty = true
		rt.InfoAt = -math.huge
	end
end

-- Dauer-Einkommen für die Offline-Abrechnung: ohne Zeitlich, ohne Freunde-/Respekt-Anteil (§B5.2)
local function offlineSteady(p: Player, data: { [string]: any }, rt: Runtime): number
	local base = baseOf(rt, data.Tower)
	local parts = Core.BuildParts(gatherFactors(p, data, now()), false, false)
	local _, steady = TowerMath.Multiplier(parts :: any)
	return math.min(base * steady, MAX_MONEY)
end

local function effect(p: Player, name: string, strength: number, payload: any)
	call("PlayerStateService", "Effect", p, name, strength, payload)
end

local function effectAll(name: string, strength: number, payload: any)
	call("PlayerStateService", "EffectAll", name, strength, payload)
end

local function track(p: Player, kind: string, amount: number, ctx: { [string]: any }?)
	call("RewardService", "Track", p, kind, amount, ctx)
end

local function funnel(p: Player, step: number, name: string)
	call("MetricsService", "Funnel", p, step, name)
end

-- CR gutschreiben; gelingt das nicht (Dienst fehlt/Deckel), wird es vorgemerkt und später nachgebucht
local function creditOrPend(p: Player, data: { [string]: any }, amount: number, source: string): boolean
	if amount <= 0 then
		return true
	end
	if credit(p, amount, source) then
		return true
	end
	local tower = data.Tower
	tower.PendingCredits = TowerMath.Clamp(num(tower.PendingCredits, 0) + amount)
	return false
end

-- Tresor leeren -> CR. Gibt den gutgeschriebenen Betrag zurück.
local function collectVault(p: Player, data: { [string]: any }, rt: Runtime, manual: boolean): number
	local tower = data.Tower
	local amount = TowerMath.Clamp(tower.Vault)
	if amount <= 0 then
		return 0
	end
	if not has("ShopService", "Credit") then
		return 0
	end
	local room = math.max(0, MAX_MONEY - balanceOf(p))
	local take = math.min(amount, math.floor(room))
	if take <= 0 then
		if os.clock() - rt.MaxMoneyAt > 60 then
			rt.MaxMoneyAt = os.clock()
			notify(p, "tower.maxMoney", nil, "Alarm")
		end
		return 0
	end
	if not credit(p, take, "Vault") then
		return 0
	end
	tower.Vault = TowerMath.Clamp(tower.Vault - take)
	rt.VaultFullNotified = false
	if type(data.Stats) == "table" then
		data.Stats.Collected = TowerMath.Clamp(num(data.Stats.Collected, 0) + take)
	end
	if take < amount and os.clock() - rt.MaxMoneyAt > 60 then
		rt.MaxMoneyAt = os.clock()
		notify(p, "tower.maxMoney", nil, "Alarm")
	end
	track(p, "Collect", 1, { Amount = take, Manual = manual })
	if manual then
		funnel(p, 5, "FirstCollect")
		markDirty(p, "Tower")
	elseif os.clock() - rt.AutoDirtyAt >= AUTO_STATE_EVERY then
		rt.AutoDirtyAt = os.clock()
		markDirty(p, "Tower")
	end
	return take
end

local function fillVault(p: Player, data: { [string]: any }, rt: Runtime, info: IncomeInfo, dt: number)
	local tower = data.Tower
	local cap = rt.VaultCap
	if cap <= 0 then
		cap = vaultCapOf(data, info)
		rt.VaultCap = cap
	end
	if tower.Vault >= cap then
		rt.VaultFrac = 0
		if not rt.VaultFullNotified and cap > 0 then
			rt.VaultFullNotified = true
			notify(p, "tower.vaultFull", nil, "Info")
			markDirty(p, "Tower")
		end
		return
	end
	rt.VaultFrac += info.PerSec * dt
	local add = math.floor(rt.VaultFrac)
	if add <= 0 then
		return
	end
	rt.VaultFrac -= add
	tower.Vault = TowerMath.Clamp(math.min(cap, tower.Vault + add))
end

-- ---------------------------------------------------------------------
-- 8) STATE (§C10)
-- ---------------------------------------------------------------------
local function crownFor(ipos: number): string
	local key = ""
	for _, crown in ipairs(CROWNS) do
		if type(crown) == "table" and isNum(crown.Ipos) and ipos >= crown.Ipos then
			key = crown.Key
		end
	end
	return key
end

-- Krone (Silber/Gold/Platin/Holo/Orbit) folgt der Zahl der Börsengänge; Data.Tower.Crown für TowerVisualService
local function syncCrown(p: Player, data: { [string]: any })
	local tower = data.Tower
	local crown = crownFor(ipoCountOf(p, data))
	if tower.Crown ~= crown then
		tower.Crown = crown
		call("TowerVisualService", "Rebuild", p)
		markDirty(p, "Tower")
	end
end

local function towerState(p: Player): { [string]: any }
	local data = dataOf(p)
	if not data then
		return {
			Floors = 0,
			Stage = 1,
			Vault = 0,
			VaultCap = 0,
			Build = {},
			Eff = 0,
			Skin = DEFAULT_SKIN,
			Neon = DEFAULT_NEON,
			Name = { A = 1, N = 1 },
			Private = {},
			Tokens = { Express = 0, Instant = 0, ExpressSeconds = {} },
			CostEvent = { Floor = 1, RoomLevel = 1, Until = 0 },
			List = {},
		}
	end
	local tower = data.Tower
	local rt = runtime[p]
	local t = now()
	local count = #tower.Floors
	local list = {}
	for i, floor in ipairs(tower.Floors) do
		list[i] = { R = floor.R, L = floor.L, S = table.clone(floor.S), D = table.clone(floor.D) }
	end
	local build = tower.Build
	local nextFloor = count + 1
	local env = TowerService._Env(p, data)
	local nextInfo: { [string]: any } = { Floor = nextFloor }
	if nextFloor <= FLOORS then
		local licence, ipo = TowerMath.GateFor(nextFloor)
		nextInfo.Cost = TowerMath.Discount(TowerMath.FloorCost(nextFloor), Core.CostFactor(env, "Floor"))
		nextInfo.Income = TowerMath.FloorIncome(nextFloor)
		nextInfo.Seconds = Core.BuildSeconds(nextFloor, env)
		nextInfo.Stage = TowerMath.StageOf(nextFloor)
		nextInfo.Licence = licence
		nextInfo.Ipo = ipo
		if env.Licence < licence then
			nextInfo.Locked = "tower.gateLicence"
		elseif env.Ipo < ipo then
			nextInfo.Locked = "tower.gateIpo"
		end
	else
		nextInfo.Locked = "tower.maxFloors"
	end
	local floorEvent = costEventMult("Floor", t)
	local levelEvent = costEventMult("RoomLevel", t)
	local eventUntil = math.max(
		if floorEvent < 1 then costEvents.Floor.Until else 0,
		if levelEvent < 1 then costEvents.RoomLevel.Until else 0
	)
	local effMax = math.floor(num(sub(TCFG, "Efficiency").Max, 20))
	return {
		Floors = count,
		Stage = Core.Stage(tower),
		Vault = tower.Vault,
		VaultCap = if rt then rt.VaultCap else 0,
		Build = if build.Floor ~= nil
			then {
				Floor = build.Floor,
				Until = build.Until,
				Start = build.Start,
				Total = build.Total,
				Helpers = #tower.Helpers,
			}
			else {},
		Eff = tower.Eff,
		EffCost = if tower.Eff < effMax
			then TowerMath.Discount(TowerMath.EfficiencyCost(tower.Eff), Core.CostFactor(env, nil))
			else 0,
		Skin = tower.Skin,
		Neon = tower.Neon,
		Crown = tower.Crown,
		Name = { A = tower.Name.A, N = tower.Name.N },
		Private = table.clone(tower.Private),
		Tokens = { Express = #tower.Express, Instant = tower.Instant, ExpressSeconds = table.clone(tower.Express) },
		CostEvent = { Floor = floorEvent, RoomLevel = levelEvent, Until = eventUntil },
		List = list,
		Next = nextInfo,
		StaffSlots = Core.StaffSlots(env),
		CostFactor = Core.CostFactor(env, nil),
		Janitor = tower.Janitor,
		Security = tower.Security,
		KeepLayout = tower.KeepLayout,
		RunSpend = tower.RunSpend,
		Pending = tower.PendingCredits,
		Offline = if rt and rt.Welcome then rt.Welcome else nil,
	}
end

local function incomeState(p: Player): IncomeInfo
	local data = dataOf(p)
	local rt = runtime[p]
	if not data or not rt then
		return emptyInfo()
	end
	local info = rt.Info
	if info then
		return info
	end
	return refreshIncome(p, data, rt, true)
end

-- ---------------------------------------------------------------------
-- 9) ENV FÜR ECHTE SPIELER
-- ---------------------------------------------------------------------
function TowerService._Env(p: Player, data: { [string]: any }): Env
	local t = now()
	local lifestyle = has("LifestyleService", "TakeDecor") and has("LifestyleService", "ReturnDecor")
	return {
		Now = t,
		Licence = licenceOf(p, data),
		Ipo = ipoCountOf(p, data),
		Perk = function(key: string): number
			return perkOf(p, data, key)
		end,
		HasPass = function(key: string): boolean
			return hasPass(p, key)
		end,
		Balance = function(): number
			return balanceOf(p)
		end,
		Debit = function(amount: number, sink: string): boolean
			return debit(p, amount, sink)
		end,
		Credit = function(amount: number, source: string): boolean
			return creditOrPend(p, data, amount, source)
		end,
		TakeDecor = function(key: string): boolean
			if not lifestyle then
				return false
			end
			local ok, result = call("LifestyleService", "TakeDecor", p, key)
			return ok and result == true
		end,
		ReturnDecor = function(key: string)
			if lifestyle then
				local ok = call("LifestyleService", "ReturnDecor", p, key)
				if ok then
					return
				end
			end
			returnDecorRaw(data, key)
		end,
		Comfort = comfortOf,
		Owns = function(entry: any): boolean
			return ownsUnlock(p, data, entry)
		end,
		BuildEvent = buildEventMult(t),
		CostEvent = function(kind: string): number
			return costEventMult(kind, t)
		end,
	}
end

-- ---------------------------------------------------------------------
-- 10) BAUEN, FERTIGSTELLEN, VISUALS
-- ---------------------------------------------------------------------
local function visual(fnName: string, ...: any)
	call("TowerVisualService", fnName, ...)
end

local function plotPayload(p: Player, extra: { [string]: any }): { [string]: any }
	extra.Plot = plotOf(p) or 0
	extra.UserId = p.UserId
	return extra
end

local function setTowerAttributes(p: Player, data: { [string]: any })
	local tower = data.Tower
	pcall(function()
		p:SetAttribute("TowerName", string.format("%d:%d", tower.Name.A, tower.Name.N))
	end)
end

local function announceStage(p: Player, stage: number, rt: Runtime)
	local cooldown = num(TCFG.StageToastCooldown, 90)
	if os.clock() - rt.StageToastAt < cooldown then
		return
	end
	rt.StageToastAt = os.clock()
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= p then
			local lang = langOf(other)
			notify(other, "tower.stageAnnounce", { p.DisplayName, stage, stageName(lang, stage) }, "Event")
		end
	end
end

local function onFloorFinished(
	p: Player,
	data: { [string]: any },
	floor: number,
	oldStage: number,
	newStage: number,
	whileAway: boolean
)
	local tower = data.Tower
	local rt = runtime[p]
	-- erster Bau des Kontos: Tresor vorgefüllt (Tutorial "Erstes Sammeln")
	if type(data.Stats) == "table" then
		if num(data.Stats.FloorsBuilt, 0) <= 0 then
			tower.Vault = math.max(tower.Vault, math.floor(num(TCFG.VaultPrefill, 300)))
		end
		data.Stats.FloorsBuilt = math.floor(num(data.Stats.FloorsBuilt, 0)) + 1
	end
	local before = if rt then rt.Base else 0
	invalidate(p)
	local gain = 0
	if rt then
		local info = refreshIncome(p, data, rt, true)
		gain = math.max(0, (rt.Base - before) * info.Mult)
	end
	visual("FloorAdded", p, floor)
	effectAll("BuildDone", 1, plotPayload(p, { Floor = floor, Stage = newStage, Amount = gain }))
	call("PlayerStateService", "SetLeaderstat", p, "Etagen", #tower.Floors)
	track(p, "BuildFloor", 1, { Floor = floor })
	if floor == 1 then
		funnel(p, 4, "Floor1")
	end
	fireAll(floorBuiltCallbacks, p, floor, newStage)
	if newStage > oldStage then
		effectAll("StageUp", 1, plotPayload(p, { Floor = floor, Stage = newStage, Amount = 0 }))
		call("MetricsService", "Progression", p, "TowerStage", "Complete", newStage)
		if newStage == 3 then
			funnel(p, 8, "Stage3")
		end
		if rt then
			announceStage(p, newStage, rt)
		end
		fireAll(stageUpCallbacks, p, newStage)
	end
	if rt and whileAway then
		-- während der Abwesenheit fertig gewordener Bau -> Willkommen-Bericht ("fertige Bauten")
		local welcome = rt.Welcome or {}
		welcome.Built = floor
		rt.Welcome = welcome
	end
	markDirty(p, "Tower", "Income")
end

local function finishBuild(p: Player, data: { [string]: any })
	local env = TowerService._Env(p, data)
	local rt = runtime[p]
	local whileAway = rt ~= nil and num(data.Tower.Build.Until, math.huge) <= rt.JoinUnix
	local floor, oldStage, newStage = Core.FinishBuild(data.Tower, env)
	if floor then
		onFloorFinished(p, data, floor, oldStage, newStage, whileAway)
	else
		markDirty(p, "Tower")
	end
end

-- ---------------------------------------------------------------------
-- 11) GEWINN-TRANSFER (§B8.2) – nur AKY -> CR
-- ---------------------------------------------------------------------
function TowerService.Transfer(p: Player, reason: "Manual" | "Bell" | "Offline"): (number, string?)
	local data = dataOf(p)
	if not data then
		return 0, "core.loading"
	end
	if not has("ShopService", "Credit") then
		return 0, "tower.shopMissing"
	end
	if not has("OrderService", "Withdraw") then
		return 0, "core.error"
	end
	local akyCents, amount, why = Core.Transfer(
		function(): (any, any)
			local ok, cents, reasonKey = call("OrderService", "Withdraw", p, reason)
			if not ok then
				return 0, "core.error"
			end
			return cents, reasonKey
		end,
		bauKursOf(p, data),
		function(value: number): boolean
			return credit(p, value, "Transfer")
		end,
		function(value: number)
			local tower = data.Tower
			tower.PendingCredits = TowerMath.Clamp(num(tower.PendingCredits, 0) + value)
		end
	)
	if akyCents <= 0 then
		return 0, why
	end
	fireAll(transferCallbacks, p, akyCents, amount)
	track(p, "Transfer", 1, { Credits = amount, Reason = reason })
	funnel(p, 7, "FirstTransfer")
	effect(p, "TransferTube", 1, plotPayload(p, { Amount = amount }))
	local rt = runtime[p]
	if rt and reason ~= "Manual" and os.clock() - rt.JoinClock < WELCOME_WINDOW then
		local welcome = rt.Welcome or {}
		welcome.Transfer = num(welcome.Transfer, 0) + amount
		rt.Welcome = welcome
	end
	markDirty(p, "Tower")
	return amount, nil
end

local function onBell(p: Player)
	if not dataOf(p) then
		return
	end
	local amount = TowerService.Transfer(p, "Bell")
	if amount > 0 then
		notify(p, "tower.transferBell", { credits(p, amount) }, "Success")
	end
end

-- ---------------------------------------------------------------------
-- 12) OFFLINE-ABRECHNUNG & TAGES-TOKEN
-- ---------------------------------------------------------------------
local function grantDailyToken(p: Player, data: { [string]: any })
	local tower = data.Tower
	local today = Util.UtcDay()
	if tower.InstantDay >= today then
		return
	end
	local daily = math.floor(num(BUILD.DailyInstant, 1))
	tower.InstantDay = today
	if daily > 0 and tower.Instant < INSTANT_MAX then
		tower.Instant = math.min(INSTANT_MAX, tower.Instant + daily)
		notify(p, "tower.dailyToken", nil, "Info")
		markDirty(p, "Tower")
	end
end

local function settleOffline(p: Player, data: { [string]: any }, rt: Runtime)
	if rt.Settled then
		return
	end
	rt.Settled = true
	local ok, savedAt = call("DataService", "LastSavedAt", p)
	if not ok or not isNum(savedAt) or savedAt <= 0 then
		return -- neues Konto
	end
	local away = os.time() - savedAt
	if away < num(OFFLINE.MinAway, 60) then
		return
	end
	local tresor = perkOf(p, data, "Vault")
	local passKey = OFFLINE.Pass or "OfflineVault"
	local vaultPass = hasPass(p, passKey)
	local rate = TowerMath.OfflineRate(tresor, vaultPass)
	local cap = TowerMath.OfflineCap(tresor, Core.RoomCount(data.Tower, "Lounge"), isClub(p), vaultPass)
	local steady = offlineSteady(p, data, rt)
	local amount = TowerMath.Offline(steady, away, rate, cap)
	local welcome = rt.Welcome or {}
	welcome.Seconds = math.min(away, cap)
	welcome.Away = away
	welcome.Rate = rate
	welcome.Cap = cap
	welcome.Amount = amount
	welcome.At = os.time()
	rt.Welcome = welcome
	if amount > 0 then
		creditOrPend(p, data, amount, "Offline")
		notify(p, "tower.offline", { credits(p, amount) }, "Success")
	end
	markDirty(p, "Tower")
end

-- ---------------------------------------------------------------------
-- 13) TAKT (1 Hz, ein Batch für alle Spieler)
-- ---------------------------------------------------------------------
local function tickBoosts(p: Player, data: { [string]: any }, dt: number)
	local kind = activeBoostKind(data)
	if not kind then
		return
	end
	local boosts = data.Boosts
	local before = num(boosts[kind], 0)
	local after = math.max(0, before - dt)
	boosts[kind] = after
	if after <= 0 then
		invalidate(p)
		markDirty(p, "Boosts", "Income")
		-- ehrliche Rückmeldung (kein Kauf-Hinweis): welcher Boost endet, läuft ein pausierter weiter?
		local lang = langOf(p)
		local function label(k: string): string
			return Format.Mult(mult(k, if k == "X5" then 5 elseif k == "X2" then 2 else 1.5), lang)
		end
		local nextKind = activeBoostKind(data)
		if nextKind then
			notify(
				p,
				"tower.boostResumed",
				{ label(kind), label(nextKind), Format.Duration(num(boosts[nextKind], 0), lang) },
				"Info"
			)
		else
			notify(p, "tower.boostEnded", { label(kind) }, "Info")
		end
	elseif math.floor(before / 30) ~= math.floor(after / 30) then
		markDirty(p, "Boosts")
	end
end

local function retryPending(p: Player, data: { [string]: any })
	local tower = data.Tower
	local pending = TowerMath.Clamp(num(tower.PendingCredits, 0))
	if pending <= 0 or not has("ShopService", "Credit") then
		return
	end
	local room = math.max(0, math.floor(MAX_MONEY - balanceOf(p)))
	local take = math.min(pending, room)
	if take > 0 and credit(p, take, "Refund") then
		tower.PendingCredits = pending - take
		markDirty(p, "Tower")
	end
end

local function incomeJob(dt: number)
	local t = now()
	local autoEvery = num(TCFG.AutoCollectSeconds, 3)
	local janitorEvery = num(TCFG.JanitorSeconds, 60)
	for p, rt in pairs(runtime) do
		if p.Parent ~= Players then
			continue
		end
		local data = dataOf(p)
		if not data then
			continue
		end
		local tower = data.Tower
		local ok, err = pcall(function()
			-- 1) Baustelle fertig?
			if tower.Build.Floor ~= nil and num(tower.Build.Until, 0) <= t then
				finishBuild(p, data)
			end
			-- 2) Boost-Countdown (nur online, nur der stärkste)
			tickBoosts(p, data, dt)
			-- 3) Einkommen + Tresor
			local info = refreshIncome(p, data, rt, false)
			fillVault(p, data, rt, info, dt)
			-- 4) Automatik: Auto-Kassierer (Pass, überall) / Hausmeister-Bot (auf dem Plot)
			rt.AutoAcc += dt
			rt.JanitorAcc += dt
			if rt.AutoAcc >= autoEvery then
				rt.AutoAcc = 0
				if tower.Vault > 0 and hasPass(p, TCFG.AutoCollectPass or "AutoCollect") then
					collectVault(p, data, rt, false)
				end
			end
			if rt.JanitorAcc >= janitorEvery then
				rt.JanitorAcc = 0
				if tower.Janitor and tower.Vault > 0 then
					local okPlot, onPlot = call("PlotService", "IsOnOwnPlot", p)
					if okPlot and onPlot == true then
						local amount = collectVault(p, data, rt, false)
						if amount > 0 then
							effect(p, "Collect", 0.5, plotPayload(p, { Amount = amount, Janitor = true }))
						end
					end
				end
			end
			-- 5) langsame Aufgaben (alle 5 s): vorgemerkte CR nachbuchen, Tages-Token, Börsengang-Krone
			rt.SlowAcc += dt
			if rt.SlowAcc >= 5 then
				rt.SlowAcc = 0
				retryPending(p, data)
				if rt.Settled then
					grantDailyToken(p, data)
				end
				syncCrown(p, data)
			end
		end)
		if not ok then
			logError("TowerIncome", err)
		end
	end
end

-- ---------------------------------------------------------------------
-- 14) REQUEST-HANDLER (§C9) – Argumente exakt prüfen
-- ---------------------------------------------------------------------
local function exact(arg: any, spec: { [string]: string }, optional: { [string]: boolean }?): boolean
	if type(arg) ~= "table" then
		return false
	end
	local count = 0
	for key, value in pairs(arg) do
		count += 1
		if count > 8 then
			return false
		end
		local want = spec[key]
		if want == nil or type(value) ~= want then
			return false
		end
		if want == "number" and not isNum(value) then
			return false
		end
	end
	for key in pairs(spec) do
		if arg[key] == nil and not (optional and optional[key]) then
			return false
		end
	end
	return true
end

local function intIn(v: any, lo: number, hi: number): boolean
	return isInt(v) and v >= lo and v <= hi
end

-- Fehler-Schlüssel + Argumente lokalisiert beantworten (Kosten als CR-Text)
local function coreFail(p: Player, key: string?, args: { any }?): Reply
	local k = key or "core.error"
	if k == "tower.noCredits" and args then
		return fail(p, k, { credits(p, args[1]) })
	elseif k == "tower.craneBusy" and args then
		return fail(p, k, { Format.Duration(args[1], langOf(p)) })
	end
	return fail(p, k, args)
end

local function after(p: Player, data: { [string]: any }, touch: boolean)
	invalidate(p)
	local rt = runtime[p]
	if rt then
		refreshIncome(p, data, rt, true)
	end
	if touch then
		visual("Touch", p)
	end
	markDirty(p, "Tower", "Income")
end

local function handleBuild(p: Player, arg: any): Reply
	if arg ~= nil and not exact(arg, {}) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local env = TowerService._Env(p, data)
	local tower = data.Tower
	local ok, key, args, result = Core.StartBuild(tower, env)
	if not ok then
		if key == "tower.gateLicence" and result then
			local lang = langOf(p)
			return fail(p, key, { stageName(lang, result.Stage), licenceName(lang, result.Licence) })
		elseif key == "tower.gateIpo" and result then
			return fail(p, key, { stageName(langOf(p), result.Stage), result.Ipo })
		end
		return coreFail(p, key, args)
	end
	local info = result :: { [string]: any }
	effectAll("Crane", 1, plotPayload(p, { Floor = info.Floor, Seconds = info.Seconds, Stage = Core.Stage(tower) }))
	if info.Seconds <= 0 then
		finishBuild(p, data)
	end
	markDirty(p, "Tower")
	return okReply(p, nil, nil, { Floor = info.Floor, Cost = info.Cost, Seconds = info.Seconds })
end

local function handleRoom(p: Player, arg: any): Reply
	if not exact(arg, { Floor = "number", Room = "string" }) or not intIn(arg.Floor, 1, FLOORS) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local ok, key, args = Core.SetRoom(data.Tower, TowerService._Env(p, data), arg.Floor, arg.Room)
	if not ok then
		if key == "tower.roomLocked" and args then
			return fail(p, key, { Lang.Pick(langOf(p), ROOMS[arg.Room].Name), args[1] })
		elseif key == "tower.roomMax" and args then
			return fail(p, key, { args[1], Lang.Pick(langOf(p), ROOMS[arg.Room].Name) })
		end
		return coreFail(p, key, args)
	end
	after(p, data, true)
	return okReply(p, "tower.roomSet", { arg.Floor, Lang.Pick(langOf(p), ROOMS[arg.Room].Name) })
end

local function handleLevel(p: Player, arg: any): Reply
	if not exact(arg, { Floor = "number" }) or not intIn(arg.Floor, 1, FLOORS) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local ok, key, args = Core.LevelUp(data.Tower, TowerService._Env(p, data), arg.Floor)
	if not ok then
		return coreFail(p, key, args)
	end
	after(p, data, true)
	track(p, "RoomLevel", 1, { Floor = arg.Floor })
	return okReply(p, "tower.levelUp", args)
end

local function handleHire(p: Player, arg: any): Reply
	if not exact(arg, { Floor = "number", Staff = "string" }) or not intIn(arg.Floor, 0, FLOORS) then
		return fail(p, "core.invalid")
	end
	local staff = STAFF[arg.Staff]
	if not staff or (arg.Floor == 0 and not staff.Lobby) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local ok, key, args = Core.Hire(data.Tower, TowerService._Env(p, data), arg.Floor, arg.Staff)
	local lang = langOf(p)
	if not ok then
		if key == "tower.staffLocked" and args then
			return fail(p, key, { Lang.Pick(lang, staff.Name), args[1] })
		end
		return coreFail(p, key, args)
	end
	after(p, data, true)
	track(p, "Hire", 1, { Staff = arg.Staff, Floor = arg.Floor })
	if arg.Staff == "Janitor" then
		funnel(p, 10, "FirstAutomation")
	elseif not staff.Lobby then
		funnel(p, 9, "FirstStaff")
	end
	if staff.Lobby then
		return okReply(p, "tower.lobbyHired", { Lang.Pick(lang, staff.Name) })
	end
	return okReply(p, "tower.hired", { Lang.Pick(lang, staff.Name), arg.Floor })
end

local function handleFire(p: Player, arg: any): Reply
	if not exact(arg, { Floor = "number", Slot = "number" }) or not intIn(arg.Floor, 0, FLOORS) then
		return fail(p, "core.invalid")
	end
	if not intIn(arg.Slot, 1, STAFF_SLOTS_PLUS) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local ok, key, staffKey = Core.Fire(data.Tower, arg.Floor, arg.Slot)
	if not ok then
		return coreFail(p, key, nil)
	end
	after(p, data, true)
	local staff = if staffKey then STAFF[staffKey] else nil
	local name = if staff then Lang.Pick(langOf(p), staff.Name) else ""
	return okReply(p, "tower.fired", { name })
end

local function handleEfficiency(p: Player, arg: any): Reply
	if arg ~= nil and not exact(arg, {}) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local ok, key, args = Core.Efficiency(data.Tower, TowerService._Env(p, data))
	if not ok then
		return coreFail(p, key, args)
	end
	after(p, data, false)
	track(p, "Efficiency", 1, { Level = data.Tower.Eff })
	funnel(p, 15, "FirstMultiplier")
	local info = incomeState(p)
	return okReply(p, "tower.effUp", { data.Tower.Eff, Format.Mult(info.Mult, langOf(p)) })
end

local function handleCollect(p: Player, arg: any): Reply
	if arg ~= nil and not exact(arg, {}) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	local rt = runtime[p]
	if not data or not rt then
		return fail(p, "core.loading")
	end
	local okPlot, onPlot = call("PlotService", "IsOnOwnPlot", p)
	if not okPlot or onPlot ~= true then
		return fail(p, "tower.tooFar", { math.floor(num(TCFG.CollectRange, 70)) })
	end
	if data.Tower.Vault <= 0 then
		return fail(p, "tower.vaultEmpty")
	end
	if not has("ShopService", "Credit") then
		return fail(p, "tower.shopMissing")
	end
	local amount = collectVault(p, data, rt, true)
	if amount <= 0 then
		return fail(p, if MAX_MONEY - balanceOf(p) < 1 then "tower.maxMoney" else "core.error")
	end
	effect(p, "Collect", 1, plotPayload(p, { Amount = amount }))
	return okReply(p, nil, nil, { Amount = amount })
end

local function handleTransfer(p: Player, arg: any): Reply
	if arg ~= nil and not exact(arg, {}) then
		return fail(p, "core.invalid")
	end
	if not dataOf(p) then
		return fail(p, "core.loading")
	end
	local amount, why = TowerService.Transfer(p, "Manual")
	if amount <= 0 then
		return fail(p, why or "trade.transferNone")
	end
	return okReply(p, "tower.transferDone", { credits(p, amount) }, { Credits = amount })
end

local function handleInstant(p: Player, arg: any): Reply
	if arg ~= nil and not exact(arg, {}) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local tower = data.Tower
	local build = tower.Build
	if build.Floor == nil then
		return fail(p, "tower.noBuild")
	end
	if build.Floor <= num(BUILD.Instant, 9) or num(build.Until, 0) - now() <= 5 then
		return fail(p, "tower.instantNotNeeded")
	end
	if tower.Instant <= 0 then
		return fail(p, "tower.noInstant")
	end
	tower.Instant -= 1
	build.Until = now()
	finishBuild(p, data)
	return okReply(p, "tower.instantUsed", { #tower.Floors })
end

-- Bau-Express-Token: der kleinste, der den Bau beendet – sonst der größte
local function pickExpress(list: { number }, remaining: number): number?
	local best: number? = nil
	for i, seconds in ipairs(list) do
		if seconds >= remaining then
			if best == nil or list[best] < remaining or seconds < list[best] then
				best = i
			end
		elseif best == nil or (list[best] < remaining and seconds > list[best]) then
			best = i
		end
	end
	return best
end

local function handleExpress(p: Player, arg: any): Reply
	if arg ~= nil and not exact(arg, {}) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local tower = data.Tower
	local build = tower.Build
	if build.Floor == nil then
		return fail(p, "tower.noBuild")
	end
	local remaining = num(build.Until, 0) - now()
	if remaining <= 5 then
		return fail(p, "tower.instantNotNeeded")
	end
	local index = pickExpress(tower.Express, remaining)
	if index == nil then
		return fail(p, "tower.noExpress")
	end
	local seconds = table.remove(tower.Express, index) :: number
	local env = TowerService._Env(p, data)
	Core.ApplyExpress(tower, env, seconds)
	if num(build.Until, 0) <= env.Now then
		finishBuild(p, data)
	end
	markDirty(p, "Tower")
	return okReply(p, "tower.expressUsed", { Format.Duration(math.min(seconds, remaining), langOf(p)) })
end

local function helperAllowed(helper: Player): boolean
	local studio = Config.Studio
	if RunService:IsStudio() and type(studio) == "table" and studio.SkipAccountAge == true then
		return true
	end
	local security = if type(Config.Security) == "table" then Config.Security else {}
	local minAge = num(security.AccountAgeMin, 3)
	local minSession = num(security.SessionMinForSocial, 600)
	local okAge, age = pcall(function()
		return helper.AccountAge
	end)
	if not okAge or not isNum(age) or age < minAge then
		return false
	end
	local rt = runtime[helper]
	return rt ~= nil and os.clock() - rt.JoinClock >= minSession
end

local function rootOf(p: Player): BasePart?
	local character = p.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function handleHelp(p: Player, arg: any): Reply
	if not exact(arg, { OwnerUserId = "number" }) or not isInt(arg.OwnerUserId) then
		return fail(p, "core.invalid")
	end
	if arg.OwnerUserId == p.UserId then
		return fail(p, "tower.helpSelf")
	end
	local owner = Players:GetPlayerByUserId(arg.OwnerUserId)
	local ownerData = if owner then dataOf(owner) else nil
	if not owner or not ownerData then
		return fail(p, "tower.ownerGone")
	end
	if not helperAllowed(p) then
		return fail(p, "tower.helpNew")
	end
	local okPlot, plot = call("PlotService", "PlotOf", owner)
	local okCf, plotCf = call("PlotService", "PlotCFrame", if okPlot then plot else 0)
	local root = rootOf(p)
	if not okPlot or not isInt(plot) or not okCf or typeof(plotCf) ~= "CFrame" or not root then
		return fail(p, "tower.helpTooFar")
	end
	local delta = root.Position - (plotCf :: CFrame).Position
	if Vector3.new(delta.X, 0, delta.Z).Magnitude > num(BUILD.HelpRange, 40) then
		return fail(p, "tower.helpTooFar")
	end
	local ok, key = Core.ApplyHelp(ownerData.Tower, TowerService._Env(owner, ownerData), p.UserId)
	if not ok then
		return coreFail(p, key, nil)
	end
	call("RewardService", "GrantSeasonXp", p, math.floor(num(BUILD.HelpSeasonXp, 25)), "HelpBuild")
	track(p, "HelpBuild", 1, { Owner = owner.UserId })
	notify(owner, "tower.helpReceived", { p.DisplayName }, "Success")
	markDirty(owner, "Tower")
	return okReply(p, "tower.helped", nil)
end

local function handleName(p: Player, arg: any): Reply
	if not exact(arg, { A = "number", N = "number" }) then
		return fail(p, "core.invalid")
	end
	if not intIn(arg.A, 1, NAME_ADJ) or not intIn(arg.N, 1, NAME_NOUN) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	data.Tower.Name = { A = arg.A, N = arg.N }
	setTowerAttributes(p, data)
	visual("Touch", p)
	markDirty(p, "Tower")
	local nameText = if type(TCFG.NameText) == "function" then TCFG.NameText(arg.A, arg.N, langOf(p)) else ""
	return okReply(p, "tower.nameSet", { nameText })
end

local function handleSkin(p: Player, arg: any): Reply
	if not exact(arg, { Skin = "string" }) then
		return fail(p, "core.invalid")
	end
	local entry = SKINS[arg.Skin]
	if not entry then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	if not ownsUnlock(p, data, entry) then
		return fail(p, "tower.locked")
	end
	data.Tower.Skin = arg.Skin
	visual("Rebuild", p)
	markDirty(p, "Tower")
	return okReply(p, "tower.skinSet", { Lang.Pick(langOf(p), entry.Name) })
end

local function handleNeon(p: Player, arg: any): Reply
	if not exact(arg, { Color = "string" }) then
		return fail(p, "core.invalid")
	end
	local entry = NEONS[arg.Color]
	if not entry then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	if not ownsUnlock(p, data, entry) then
		return fail(p, "tower.locked")
	end
	data.Tower.Neon = arg.Color
	visual("Rebuild", p)
	markDirty(p, "Tower")
	return okReply(p, "tower.neonSet", { Lang.Pick(langOf(p), entry.Name) })
end

local function handlePrivate(p: Player, arg: any): Reply
	if not exact(arg, { Floor = "number", On = "boolean" }) or not intIn(arg.Floor, 1, FLOORS) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local ok, key, args = Core.SetPrivate(data.Tower, arg.Floor, arg.On)
	if not ok then
		return coreFail(p, key, args)
	end
	visual("Touch", p)
	markDirty(p, "Tower")
	return okReply(p, if arg.On then "tower.privateOn" else "tower.privateOff", { arg.Floor })
end

local function validDecorKey(key: any): boolean
	return type(key) == "string" and #key >= 1 and #key <= MAX_DECOR_KEY and string.match(key, "^[%w_]+$") ~= nil
end

local function handleDecor(p: Player, arg: any): Reply
	if not exact(arg, { Floor = "number", Slot = "number", Key = "string" }, { Key = true }) then
		return fail(p, "core.invalid")
	end
	if not intIn(arg.Floor, 1, FLOORS) or not intIn(arg.Slot, 1, 16) then
		return fail(p, "core.invalid")
	end
	if arg.Key ~= nil and arg.Key ~= "" and not validDecorKey(arg.Key) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	if not (has("LifestyleService", "TakeDecor") and has("LifestyleService", "ReturnDecor")) then
		return fail(p, "tower.decorUnavailable")
	end
	local placing = arg.Key ~= nil and arg.Key ~= ""
	local ok, key = Core.SetDecor(data.Tower, TowerService._Env(p, data), arg.Floor, arg.Slot, arg.Key)
	if not ok then
		return coreFail(p, key, nil)
	end
	after(p, data, true)
	return okReply(p, if placing then "tower.decorPlaced" else "tower.decorRemoved", { arg.Floor })
end

local function handleLayout(p: Player, arg: any): Reply
	if not exact(arg, { On = "boolean" }) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	data.Tower.KeepLayout = arg.On
	markDirty(p, "Tower")
	return okReply(p, if arg.On then "tower.layoutOn" else "tower.layoutOff", nil)
end

-- "Auto-Plan" (Tiko, Greedy nach Einkommen): schlägt je Etage eine Abteilung vor (ändert nichts)
function Core.AutoPlan(t: any, stage: number, permBase: number, ctx: TowerMath.Ctx?): ({ string }, number, number)
	local count = #t.Floors
	local plan: { FloorData } = {}
	for i, floor in ipairs(t.Floors) do
		plan[i] = { R = floor.R, L = floor.L, S = floor.S, D = floor.D }
	end
	local marketing = ROOMS.Marketing
	local penthouse = ROOMS.Penthouse
	local function objective(floors: { FloorData }): number
		local perm = permBase
		local mkt, top = 0, floors[count]
		for _, floor in ipairs(floors) do
			if floor.R == "Marketing" then
				mkt += 1
			end
		end
		if marketing then
			perm += num(marketing.IncomePct, 0.05) * math.min(mkt, num(marketing.Max, 3))
		end
		if penthouse and top and top.R == "Penthouse" then
			perm += num(penthouse.IncomePct, 0.10)
		end
		return TowerMath.BaseIncome(floors, ctx) * perm
	end
	local before = objective(plan)
	local best = before
	-- zwei Durchgänge von oben nach unten (Nachbar-Effekte wirken in beide Richtungen)
	for _ = 1, 2 do
		local improved = false
		for i = count, 1, -1 do
			local current = plan[i].R
			local chosen = current
			for _, room in ipairs(ROOM_LIST) do
				local key = room.Key
				if key ~= current and stage >= num(room.MinStage, 1) and not (room.TopOnly and i ~= count) then
					local allowed = true
					if isInt(room.Max) then
						local used = 0
						for j, floor in ipairs(plan) do
							if j ~= i and floor.R == key then
								used += 1
							end
						end
						allowed = used < room.Max
					end
					if allowed then
						plan[i].R = key
						local value = objective(plan)
						if value > best + 1e-9 then
							best = value
							chosen = key
						end
						plan[i].R = chosen
					end
				end
			end
			if chosen ~= current then
				improved = true
			end
		end
		if not improved then
			break
		end
	end
	local result: { string } = {}
	local cost = 0
	for i, floor in ipairs(plan) do
		result[i] = floor.R
		if floor.R ~= t.Floors[i].R then
			cost += TowerMath.RoomChangeCost(i)
		end
	end
	return result, math.max(0, best - before), cost
end

local function handleAutoPlan(p: Player, arg: any): Reply
	if arg ~= nil and not exact(arg, {}) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local tower = data.Tower
	local factors = gatherFactors(p, data, now())
	-- Perm ohne Marketing/Penthouse (die bewertet der Plan selbst)
	factors.Marketing = 0
	factors.Penthouse = false
	local g = TowerMath.Groups(Core.BuildParts(factors, true, false) :: any)
	local plan, gain, cost = Core.AutoPlan(tower, Core.Stage(tower), g.Perm, comfortCtx())
	local steady = g.Trader * g.Pass * g.Fixed
	local perSecGain = gain * steady
	if perSecGain < 0.01 then
		return okReply(p, "tower.autoPlanNone", nil, { Plan = plan, Gain = 0, Cost = 0 })
	end
	return okReply(p, "tower.autoPlan", { credits(p, perSecGain) }, { Plan = plan, Gain = perSecGain, Cost = cost })
end

-- ---------------------------------------------------------------------
-- 15) ÖFFENTLICHE API (§C5.5)
-- ---------------------------------------------------------------------
function TowerService.Income(p: Player): IncomeInfo
	return incomeState(p)
end

function TowerService.Floors(p: Player): number
	local data = dataOf(p)
	return if data then #data.Tower.Floors else 0
end

function TowerService.Stage(p: Player): number
	local data = dataOf(p)
	return if data then Core.Stage(data.Tower) else 1
end

function TowerService.RunSpend(p: Player): number
	local data = dataOf(p)
	return if data then TowerMath.Clamp(num(data.Tower.RunSpend, 0)) else 0
end

function TowerService.TowerValue(p: Player): number
	return TowerMath.Clamp(math.floor(TowerService.RunSpend(p) * 0.5))
end

-- Einkommen/Multiplikatoren sofort neu rechnen (Pass-/Abo-Kauf, Premium-Wechsel) – kein Yield
function TowerService.Refresh(p: Player)
	local data = dataOf(p)
	local rt = runtime[p]
	if not data or not rt then
		return
	end
	invalidate(p)
	refreshIncome(p, data, rt, true)
	markDirty(p, "Income", "Tower")
end

function TowerService.RoomCount(p: Player, roomKey: string): number
	local data = dataOf(p)
	if not data or type(roomKey) ~= "string" then
		return 0
	end
	return Core.RoomCount(data.Tower, roomKey)
end

function TowerService.AddBoost(p: Player, kind: "X2" | "X5" | "Bull", seconds: number): boolean
	if kind ~= "X2" and kind ~= "X5" and kind ~= "Bull" then
		return false
	end
	if not isNum(seconds) or seconds <= 0 then
		return false
	end
	local data = dataOf(p)
	if not data then
		return false
	end
	local boosts = data.Boosts
	local maxSeconds = mult("BoostMaxSeconds", 2592000)
	if kind == "Bull" then
		-- Bullen-Bonus stapelt nicht (1× je Rally): höchstens auf die neue Dauer verlängern
		boosts.Bull = math.clamp(math.max(num(boosts.Bull, 0), seconds), 0, maxSeconds)
	else
		boosts[kind] = math.clamp(num(boosts[kind], 0) + seconds, 0, maxSeconds)
	end
	invalidate(p)
	local rt = runtime[p]
	if rt then
		refreshIncome(p, data, rt, true)
	end
	markDirty(p, "Boosts", "Income")
	return true
end

function TowerService.SetServerBoost(kind: "Parade" | "Bell", value: number, seconds: number)
	local entry = serverBoost[kind]
	if not entry or not isNum(value) or not isNum(seconds) then
		return
	end
	local t = now()
	if seconds <= 0 or value <= 1 then
		entry.Mult, entry.Until = 1, 0
	else
		entry.Mult = math.clamp(value, 1, mult("ServerMax", 2))
		entry.Until = t + math.min(seconds, mult("EventMaxSeconds", 3600))
	end
	for p in pairs(runtime) do
		invalidate(p)
	end
end

function TowerService.SetEventMult(value: number, untilUnix: number)
	if not isNum(value) or not isNum(untilUnix) then
		return
	end
	local t = now()
	if untilUnix <= t or value <= 1 then
		eventBoost.Mult, eventBoost.Until = 1, 0
	else
		eventBoost.Mult = math.clamp(value, 1, mult("EventMax", 3))
		eventBoost.Until = math.min(untilUnix, t + mult("EventMaxSeconds", 3600))
	end
	for p in pairs(runtime) do
		invalidate(p)
	end
end

function TowerService.CostMult(kind: "Floor" | "RoomLevel"): number
	return costEventMult(kind, now())
end

function TowerService.SetCostEvent(kind: "Floor" | "RoomLevel" | "Both", value: number, untilUnix: number)
	if not isNum(value) or not isNum(untilUnix) then
		return
	end
	local kinds = if kind == "Both" then { "Floor", "RoomLevel" } elseif costEvents[kind] then { kind } else {}
	local t = now()
	for _, k in ipairs(kinds) do
		local entry = costEvents[k]
		if untilUnix <= t or value >= 1 then
			entry.Mult, entry.Until = 1, 0
		else
			entry.Mult = math.clamp(value, mult("CostEventMin", 0.1), 1)
			entry.Until = math.min(untilUnix, t + mult("EventMaxSeconds", 3600))
		end
	end
	for p in pairs(runtime) do
		markDirty(p, "Tower")
	end
end

function TowerService.SetBuildEvent(value: number, untilUnix: number)
	if not isNum(value) or not isNum(untilUnix) then
		return
	end
	local t = now()
	if untilUnix <= t or value >= 1 then
		buildEvent.Mult, buildEvent.Until = 1, 0
	else
		buildEvent.Mult = math.clamp(value, 0, 1)
		buildEvent.Until = math.min(untilUnix, t + mult("EventMaxSeconds", 3600))
	end
end

function TowerService.AddExpressToken(p: Player, maxSeconds: number): boolean
	if not isNum(maxSeconds) or maxSeconds < 1 then
		return false
	end
	local data = dataOf(p)
	if not data then
		return false
	end
	local tower = data.Tower
	if #tower.Express >= EXPRESS_MAX then
		return false
	end
	table.insert(tower.Express, math.clamp(math.floor(maxSeconds), 1, EXPRESS_MAX_SECONDS))
	markDirty(p, "Tower")
	return true
end

function TowerService.ApplyExpress(p: Player, maxSeconds: number): boolean
	if not isNum(maxSeconds) or maxSeconds < 1 then
		return false
	end
	local data = dataOf(p)
	if not data then
		return false
	end
	local env = TowerService._Env(p, data)
	local tower = data.Tower
	if not Core.ApplyExpress(tower, env, math.min(maxSeconds, EXPRESS_MAX_SECONDS)) then
		return false
	end
	if num(tower.Build.Until, 0) <= env.Now then
		finishBuild(p, data)
	end
	markDirty(p, "Tower")
	return true
end

function TowerService.AddInstantToken(p: Player, n: number): boolean
	if not isInt(n) or n < 1 then
		return false
	end
	local data = dataOf(p)
	if not data then
		return false
	end
	local tower = data.Tower
	tower.Instant = math.min(INSTANT_MAX, tower.Instant + n)
	markDirty(p, "Tower")
	return true
end

function TowerService.ResetForIpo(p: Player, perks: { [string]: number }): boolean
	local data = dataOf(p)
	if not data then
		return false
	end
	local env = TowerService._Env(p, data)
	local ok = Core.ResetForIpo(data, env, perks)
	if not ok then
		return false
	end
	local rt = runtime[p]
	if rt then
		rt.VaultFrac = 0
		rt.VaultFullNotified = false
	end
	invalidate(p)
	visual("Rebuild", p)
	call("PlayerStateService", "SetLeaderstat", p, "Etagen", #data.Tower.Floors)
	markDirty(p, "Tower", "Income")
	return true
end

function TowerService.AdminSetFloors(p: Player, n: number): boolean
	if not isInt(n) or n < 0 or n > FLOORS then
		return false
	end
	local data = dataOf(p)
	if not data then
		return false
	end
	Core.SetFloors(data.Tower, TowerService._Env(p, data), n)
	invalidate(p)
	visual("Rebuild", p)
	call("PlayerStateService", "SetLeaderstat", p, "Etagen", #data.Tower.Floors)
	markDirty(p, "Tower", "Income")
	return true
end

function TowerService.OnFloorBuilt(cb: (p: Player, floor: number, stage: number) -> ())
	if type(cb) == "function" then
		table.insert(floorBuiltCallbacks, cb)
	end
end

function TowerService.OnStageUp(cb: (p: Player, stage: number) -> ())
	if type(cb) == "function" then
		table.insert(stageUpCallbacks, cb)
	end
end

function TowerService.OnTransfer(cb: (p: Player, akyCents: number, credits: number) -> ())
	if type(cb) == "function" then
		table.insert(transferCallbacks, cb)
	end
end

-- Interne Teile für TowerTests (keine Spieler, keine echten Spielstände)
TowerService._Test = {
	Core = Core,
	Factors = function(): Factors
		return {
			Eff = 0,
			Ipo = 0,
			Growth = 0,
			Album = 0,
			Friends = 0,
			Respekt = 0,
			Marketing = 0,
			Penthouse = false,
			Trader = {},
			Pass = 1,
			Fixed = {},
			Boost = nil,
			Server = nil,
			Event = nil,
		}
	end,
}

-- ---------------------------------------------------------------------
-- 16) LEBENSZYKLUS
-- ---------------------------------------------------------------------
-- Einmal je Sitzung: Turm-Daten reparieren, Laufzeit anlegen, Attribute/Leaderstat, Hülle (wenn der Plot steht)
local function ensureLoaded(p: Player, data: { [string]: any }): Runtime?
	if p.Parent ~= Players or type(data.Tower) ~= "table" then
		return nil
	end
	local rt = runtime[p] or newRuntime()
	runtime[p] = rt
	if rt.Repaired then
		return rt
	end
	rt.Repaired = true
	local refund = Core.Repair(data)
	rt.BaseDirty = true
	if refund > 0 then
		creditOrPend(p, data, refund, "Refund")
	end
	data.Tower.Crown = crownFor(ipoCountOf(p, data))
	setTowerAttributes(p, data)
	call("PlayerStateService", "SetLeaderstat", p, "Etagen", #data.Tower.Floors)
	refreshIncome(p, data, rt, true)
	if plotOf(p) then
		visual("Rebuild", p)
	end
	markDirty(p, "Tower", "Income")
	return rt
end

local function onProfileLoaded(p: Player, data: { [string]: any })
	ensureLoaded(p, data)
end

local function onReady(p: Player)
	local data = dataOf(p)
	local rt = if data then ensureLoaded(p, data) else nil
	if not data or not rt then
		return
	end
	invalidate(p)
	settleOffline(p, data, rt)
	grantDailyToken(p, data)
	refreshIncome(p, data, rt, true)
	markDirty(p, "Tower", "Income")
end

local function onPlayerRemoving(p: Player)
	runtime[p] = nil
end

function TowerService.Init(services: any)
	Services = services
	local pss = Services.PlayerStateService
	if type(pss) ~= "table" then
		warn(PREFIX .. "PlayerStateService fehlt – keine Anfragen/State")
		return
	end
	pss.Provide("Tower", towerState)
	pss.Provide("Income", incomeState)
	pss.Handle("TowerBuild", handleBuild, { Rate = 4, Per = 1 })
	pss.Handle("TowerRoom", handleRoom, { Rate = 8, Per = 1 })
	pss.Handle("TowerLevel", handleLevel, { Rate = 8, Per = 1 })
	pss.Handle("TowerHire", handleHire, { Rate = 8, Per = 1 })
	pss.Handle("TowerFire", handleFire, { Rate = 8, Per = 1 })
	pss.Handle("TowerEfficiency", handleEfficiency, { Rate = 4, Per = 1 })
	pss.Handle("TowerCollect", handleCollect, { Rate = 4, Per = 1 })
	pss.Handle("TowerTransfer", handleTransfer, { Rate = 1, Per = 5 })
	pss.Handle("TowerInstant", handleInstant, { Rate = 1, Per = 1 })
	pss.Handle("TowerExpress", handleExpress, { Rate = 1, Per = 1 })
	pss.Handle("TowerHelp", handleHelp, { Rate = 1, Per = 1 })
	pss.Handle("TowerName", handleName, { Rate = 2, Per = 1 })
	pss.Handle("TowerSkin", handleSkin, { Rate = 2, Per = 1 })
	pss.Handle("TowerNeon", handleNeon, { Rate = 2, Per = 1 })
	pss.Handle("TowerPrivate", handlePrivate, { Rate = 2, Per = 1 })
	pss.Handle("TowerDecor", handleDecor, { Rate = 8, Per = 1 })
	pss.Handle("TowerLayout", handleLayout, { Rate = 1, Per = 1 })
	pss.Handle("TowerAutoPlan", handleAutoPlan, { Rate = 1, Per = 1 })
end

function TowerService.Start()
	call("OrderService", "OnBell", function(p: Player)
		onBell(p)
	end)
	call("DataService", "OnProfileLoaded", onProfileLoaded)
	call("PlayerStateService", "OnReady", onReady)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	-- Roblox Premium mitten in der Sitzung gekauft/beendet -> ×1,10 sofort im Multiplikator-Chip
	Players.PlayerMembershipChanged:Connect(function(p: Player)
		TowerService.Refresh(p)
	end)
	Scheduler.Every("TowerIncome", 1, incomeJob)
end

return TowerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">TowerVisualService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Tower-Hüllen & Plot-Attribute (Server/Services/TowerVisualService)
--  Besitzer: WP8 (Turm-Optik, Interiors, Lifestyle). Vertrag: DESIGN.md §C5.7, §B3 (Server baut nur die Hülle:
--  ≤ 8 Parts je Etage, Krone ≤ 60, Plot-Ausstattung ≤ 40, 10 Tower × 50 Etagen ≤ 4.600 Parts, Aufbau über eine
--  Scheduler-Warteschlange ≤ 6 Etagen je Frame; Streaming: Hülle PersistentPerPlayer für den Besitzer, Atomic für
--  alle anderen, LevelOfDetail = StreamingMesh), §B4.2/§B4.9 (Silhouetten, Fassaden, Neon, Kronen), §C10 + §C12.3
--  (Plot-Attribute, "Layout" ≤ 2 KB).
--
--  Welt-Struktur (Ordner sind immer repliziert, auch mit StreamingEnabled):
--    Workspace.AkyTowers.Plot<n>   (Folder)  Attribute: Owner (UserId, 0 = frei), OwnerName, Stage, Floors, Layout,
--                                            Skin, Neon, Crown, Name ("a:n"), Lobby ("J"/"W"/"JW"), Pivot (CFrame),
--                                            BuildFloor, BuildStart, BuildUntil (Unix), Fx (Neon-Fassaden-Kit)
--      Tower (Model)                          Hülle: Floors/F<n>, Spine, Crown, Site (Parts aus Shared/TowerModels)
--      TowerOld (Model, kurzzeitig)           alte Hülle beim Stufen-Morph (2,5 s, Client blendet sie aus) bzw. beim
--                                             Abbau nach dem Verlassen (1,6 s, Client spielt den Kran-Abbau)
--  Interiors baut NUR der Client (TowerView) aus "Layout".
--
--  Öffentliche API (§C5.7):
--    TowerVisualService.Rebuild(p)              Hülle + Plot-Attribute aus Data.Tower (Scheduler-Warteschlange)
--    TowerVisualService.FloorAdded(p, floor)    neue Etage anhängen (bei Stufenwechsel: Morph = Neuaufbau)
--    TowerVisualService.Clear(plot)             Hülle abbauen (Kran-Abbau beim Client), Attribute zurücksetzen
--    TowerVisualService.Touch(p)                Layout-Attribut neu schreiben (Raum/Stufe/Personal/Deko/Privat/Name)
--  Ergänzungen: TowerVisualService.PartCount(): number · TowerVisualService.PlotFolder(plot): Folder?
--    TowerVisualService._Test = { Encode, Decode, Count, Layout(tower) }   (reine Helfer für VisualTests)
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local TowerModels = require(Shared:WaitForChild("TowerModels"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local TowerVisualService = {}
local Services: any = nil

local PREFIX = "[TowerVisualService] "
local FOLDER_NAME = "AkyTowers"
local FLOORS_PER_FRAME = 6 -- §B3/§C16: Hüllen-Bau ≤ 6 Etagen je Frame (über alle Tower zusammen)
local MORPH_SECONDS = 2.5 -- Stufen-Morph: alte Hülle bleibt so lange (Client blendet aus)
local TEARDOWN_SECONDS = 1.6 -- Abbau nach dem Verlassen (Client: Kran-Abbau 1,5 s)
local LAYOUT_MAX = 2048
local FX_REFRESH = 10 -- Sekunden: Neon-Fassaden-Kit-Besitz neu prüfen
local ERROR_LOG_EVERY = 10

local TCFG: { [string]: any } = if type(Config.Tower) == "table" then Config.Tower else {}

local function num(v: any, default: number): number
	return if Util.IsFinite(v) then v else default
end

local FLOOR_HEIGHT = num(TCFG.FloorHeight, 12)
local MAX_FLOORS = math.clamp(math.floor(num(TCFG.Floors, 50)), 1, 50)
local PLOTS = math.clamp(math.floor(num(type(Config.Server) == "table" and Config.Server.Plots or nil, 10)), 1, 32)
local DEFAULT_SKIN = if type(TCFG.DefaultSkin) == "string" then TCFG.DefaultSkin else "GlassBlue"
local DEFAULT_NEON = if type(TCFG.DefaultNeon) == "string" then TCFG.DefaultNeon else "Accent"
local SIGNS: { [string]: any } = if type(Config.Decor) == "table" and type(Config.Decor.Signs) == "table"
	then Config.Decor.Signs
	else {}

type Job = {
	Token: number,
	Model: Model,
	Origin: CFrame,
	Stage: number,
	Floors: number,
	Skin: string,
	Neon: string,
	Crown: string,
	Next: number,
	Morph: boolean,
}

type PlotState = {
	Plot: number,
	Folder: Folder,
	Owner: Player?,
	Model: Model?,
	Token: number,
	Stage: number,
	Floors: number,
	Skin: string,
	Neon: string,
	Crown: string,
	Job: Job?,
	FxAt: number,
}

-- ---------------------------------------------------------------------
-- 1) ZUSTAND
-- ---------------------------------------------------------------------
local root: Folder? = nil
local plots: { [number]: PlotState } = {}
local plotOfPlayer: { [Player]: number } = {} -- bei PlayerRemoving geleert
local queue: { number } = {} -- Plots mit wartendem Hüllen-Auftrag (Reihenfolge)
local errorLogAt: { [string]: number } = {}

local function logError(where: string, err: any)
	local t = os.clock()
	if t - (errorLogAt[where] or -math.huge) >= ERROR_LOG_EVERY then
		errorLogAt[where] = t
		warn(PREFIX .. where .. ": " .. tostring(err))
	end
end

local function call(serviceName: string, fnName: string, ...: any): (boolean, any)
	local s = Services and Services[serviceName]
	local fn = if type(s) == "table" then s[fnName] else nil
	if type(fn) ~= "function" then
		return false, nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		logError(serviceName .. "." .. fnName, result)
		return false, nil
	end
	return true, result
end

local function dataOf(p: Player): { [string]: any }?
	local ok, data = call("DataService", "Get", p)
	if ok and type(data) == "table" and type(data.Tower) == "table" then
		return data
	end
	return nil
end

local function plotCFrame(plot: number): CFrame
	local ok, cf = call("PlotService", "PlotCFrame", plot)
	if ok and typeof(cf) == "CFrame" and Util.IsFiniteVector(cf.Position) then
		return cf
	end
	-- Ersatz: Ring-Formel §A5 (R 420, 18° + k · 36°, Blick zur Plaza)
	local ring = if type(TCFG.Plots) == "table" then TCFG.Plots else {}
	local angle = math.rad(num(ring.StartAngle, 18) + (plot - 1) * num(ring.Step, 36))
	local r = num(ring.Radius, 420)
	local position = Vector3.new(r * math.cos(angle), 0, r * math.sin(angle))
	return CFrame.lookAt(position, Vector3.zero)
end

local function setAttr(inst: Instance, name: string, value: any)
	if inst:GetAttribute(name) ~= value then
		inst:SetAttribute(name, value)
	end
end

-- ---------------------------------------------------------------------
-- 2) WELT-ORDNER
-- ---------------------------------------------------------------------
local function ensureRoot(): Folder
	local existing = root
	if existing and existing.Parent == workspace then
		return existing
	end
	local old = workspace:FindFirstChild(FOLDER_NAME)
	if old then
		old:Destroy() -- Reste eines früheren Laufs (Studio-Neustart der Services)
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = workspace
	root = folder
	return folder
end

local function resetAttributes(folder: Folder)
	setAttr(folder, "Owner", 0)
	setAttr(folder, "OwnerName", "")
	setAttr(folder, "Stage", 1)
	setAttr(folder, "Floors", 0)
	setAttr(folder, "Layout", "")
	setAttr(folder, "Skin", DEFAULT_SKIN)
	setAttr(folder, "Neon", DEFAULT_NEON)
	setAttr(folder, "Crown", "")
	setAttr(folder, "Name", "1:1")
	setAttr(folder, "Lobby", "")
	setAttr(folder, "BuildFloor", 0)
	setAttr(folder, "BuildStart", 0)
	setAttr(folder, "BuildUntil", 0)
	setAttr(folder, "Fx", false)
end

local function stateOf(plot: number): PlotState?
	if not Util.IsFinite(plot) or plot % 1 ~= 0 or plot < 1 or plot > PLOTS then
		return nil
	end
	local state = plots[plot]
	if state and state.Folder.Parent ~= nil then
		return state
	end
	local parent = ensureRoot()
	local folder = parent:FindFirstChild("Plot" .. plot)
	if not folder or not folder:IsA("Folder") then
		folder = Instance.new("Folder")
		folder.Name = "Plot" .. plot
		folder.Parent = parent
	end
	local f = folder :: Folder
	resetAttributes(f)
	f:SetAttribute("Plot", plot)
	f:SetAttribute("Pivot", plotCFrame(plot))
	local created: PlotState = {
		Plot = plot,
		Folder = f,
		Owner = nil,
		Model = nil,
		Token = 0,
		Stage = 1,
		Floors = 0,
		Skin = DEFAULT_SKIN,
		Neon = DEFAULT_NEON,
		Crown = "",
		Job = nil,
		FxAt = 0,
	}
	plots[plot] = created
	return created
end

-- ---------------------------------------------------------------------
-- 3) TEILE BAUEN
-- ---------------------------------------------------------------------
-- Neon-Schriftzug (Marke/„STARTUP“) als Server-SurfaceGui – sprachneutral, Text aus Config.Decor.Signs
local function decorateSign(part: BasePart, neonColor: Color3)
	local key = part:GetAttribute("Sign")
	local text = if type(key) == "string" then SIGNS[key] else nil
	if type(text) ~= "string" or text == "" then
		return
	end
	local face = part:GetAttribute("Face")
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = if face == "Back" then Enum.NormalId.Back else Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.Brightness = 2
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.MaxDistance = 900
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.FontFace = Font.new("rbxasset://fonts/families/BuilderExtended.json", Enum.FontWeight.Bold)
	label.TextColor3 = neonColor
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Color = neonColor
	stroke.Thickness = 2
	stroke.Transparency = 0.4
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = part
end

local function hexColor(hex: string): Color3
	local r, g, b = TowerModels.Hex(hex)
	return Color3.fromRGB(r, g, b)
end

local function buildList(specs: { any }, origin: CFrame, parent: Instance, neon: string): number
	local neonColor = hexColor(TowerModels.NeonHex(neon))
	for _, spec in ipairs(specs) do
		local part = TowerModels.Instantiate(spec, origin, nil)
		if part:GetAttribute("Sign") ~= nil then
			decorateSign(part, neonColor)
		end
		part.Parent = parent
	end
	return #specs
end

local function folderIn(model: Instance, name: string): Folder
	local existing = model:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = model
	return folder
end

local function buildFloor(job: Job, floor: number)
	local floors = folderIn(job.Model, "Floors")
	local old = floors:FindFirstChild("F" .. floor)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "F" .. floor
	folder:SetAttribute("Floor", floor)
	buildList(TowerModels.Shell(job.Stage, floor, job.Skin, job.Neon), job.Origin, folder, job.Neon)
	folder.Parent = floors
end

-- Senkrechte Teile, Krone und Plot-Ausstattung hängen von der Etagenzahl ab -> komplett neu
local function buildTop(job: Job)
	for _, name in ipairs({ "Spine", "Crown", "Site" }) do
		local old = job.Model:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local spine = Instance.new("Folder")
	spine.Name = "Spine"
	buildList(TowerModels.Spine(job.Stage, job.Floors, job.Skin, job.Neon), job.Origin, spine, job.Neon)
	spine.Parent = job.Model
	if job.Floors > 0 then
		local crown = Instance.new("Folder")
		crown.Name = "Crown"
		local top = job.Origin * CFrame.new(0, job.Floors * FLOOR_HEIGHT, 0)
		buildList(TowerModels.Crown(job.Stage, job.Crown, job.Floors, job.Skin, job.Neon), top, crown, job.Neon)
		crown.Parent = job.Model
	end
	local site = Instance.new("Folder")
	site.Name = "Site"
	buildList(TowerModels.Site(job.Stage, job.Floors, job.Skin, job.Neon), job.Origin, site, job.Neon)
	site.Parent = job.Model
end

local function newModel(plot: number, origin: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "Tower"
	model:SetAttribute("Plot", plot)
	model.WorldPivot = origin
	-- §B3: Skyline bleibt aus der Ferne sichtbar; eigener Plot dauerhaft geladen (AddPersistentPlayer beim Einhängen)
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	end)
	pcall(function()
		model.LevelOfDetail = Enum.ModelLevelOfDetail.StreamingMesh
	end)
	return model
end

local function scheduleDestroy(model: Model, seconds: number)
	model.Name = "TowerOld"
	model:SetAttribute("Fading", true)
	model:SetAttribute("FadeSeconds", seconds)
	task.delay(seconds, function()
		if model.Parent ~= nil then
			model:Destroy()
		end
	end)
end

local function addPersistent(model: Model, owner: Player?)
	if owner and owner.Parent == Players then
		pcall(function()
			model:AddPersistentPlayer(owner)
		end)
	end
end

-- Auftrag fertig: neue Hülle einhängen, alte (Morph) kurz stehen lassen
local function finishJob(state: PlotState, job: Job)
	buildTop(job)
	local old = state.Model
	job.Model:SetAttribute("Stage", job.Stage)
	job.Model:SetAttribute("Floors", job.Floors)
	job.Model.Parent = state.Folder
	addPersistent(job.Model, state.Owner)
	if old and old ~= job.Model then
		if job.Morph then
			scheduleDestroy(old, MORPH_SECONDS)
		else
			old:Destroy()
		end
	end
	state.Model = job.Model
	state.Stage = job.Stage
	state.Floors = job.Floors
	state.Skin = job.Skin
	state.Neon = job.Neon
	state.Crown = job.Crown
	state.Job = nil
end

-- Warteschlange: höchstens FLOORS_PER_FRAME Etagen je Frame über alle Tower
local function shellJob(_dt: number)
	local budget = FLOORS_PER_FRAME
	local guard = 0
	while budget > 0 and #queue > 0 and guard < PLOTS * 2 do
		guard += 1
		local plot = queue[1]
		local state = plots[plot]
		local job = state and state.Job
		if not state or not job or job.Token ~= state.Token then
			table.remove(queue, 1)
			continue
		end
		while budget > 0 and job.Next <= job.Floors do
			local ok, err = pcall(buildFloor, job, job.Next)
			if not ok then
				logError("buildFloor", err)
			end
			job.Next += 1
			budget -= 1
		end
		if job.Next > job.Floors then
			local ok, err = pcall(finishJob, state, job)
			if not ok then
				logError("finishJob", err)
				state.Job = nil
			end
			table.remove(queue, 1)
		end
	end
end

local function enqueue(plot: number)
	if not table.find(queue, plot) then
		table.insert(queue, plot)
	end
end

-- ---------------------------------------------------------------------
-- 4) ATTRIBUTE AUS DEN DATEN
-- ---------------------------------------------------------------------
local function towerInfo(data: { [string]: any }): (number, number, string, string, string)
	local tower = data.Tower
	local floors = if type(tower.Floors) == "table" then math.min(#tower.Floors, MAX_FLOORS) else 0
	local stage = TowerModels.StageOf(floors)
	local skin = if type(tower.Skin) == "string" then tower.Skin else DEFAULT_SKIN
	local neon = if type(tower.Neon) == "string" then tower.Neon else DEFAULT_NEON
	local crown = if type(tower.Crown) == "string" then tower.Crown else ""
	return floors, stage, skin, neon, crown
end

-- Layout ≤ 2 KB: notfalls die Deko der obersten Etagen weglassen (Raum/Stufe/Personal bleiben vollständig)
local function layoutOf(tower: { [string]: any }): string
	local floors = if type(tower.Floors) == "table" then tower.Floors else {}
	local private = if type(tower.Private) == "table" then tower.Private else {}
	local text = TowerModels.EncodeLayout(floors, private)
	if #text <= LAYOUT_MAX then
		return text
	end
	local trimmed: { any } = {}
	for i, floor in ipairs(floors) do
		trimmed[i] = { R = floor.R, L = floor.L, S = floor.S, D = floor.D }
	end
	for i = #trimmed, 1, -1 do
		trimmed[i].D = {}
		text = TowerModels.EncodeLayout(trimmed, private)
		if #text <= LAYOUT_MAX then
			break
		end
	end
	return string.sub(text, 1, LAYOUT_MAX)
end

local function writeAttributes(state: PlotState, p: Player, data: { [string]: any })
	local folder = state.Folder
	local tower = data.Tower
	local floors, stage, skin, neon, crown = towerInfo(data)
	setAttr(folder, "Owner", p.UserId)
	setAttr(folder, "OwnerName", p.DisplayName)
	setAttr(folder, "Stage", stage)
	setAttr(folder, "Floors", floors)
	setAttr(folder, "Skin", skin)
	setAttr(folder, "Neon", neon)
	setAttr(folder, "Crown", crown)
	local name = if type(tower.Name) == "table" then tower.Name else {}
	setAttr(folder, "Name", string.format("%d:%d", math.floor(num(name.A, 1)), math.floor(num(name.N, 1))))
	setAttr(
		folder,
		"Lobby",
		(if tower.Janitor == true then "J" else "") .. (if tower.Security == true then "W" else "")
	)
	setAttr(folder, "Layout", layoutOf(tower))
	setAttr(folder, "Pivot", plotCFrame(state.Plot))
end

local function writeBuild(state: PlotState, data: { [string]: any })
	local build = data.Tower.Build
	local floor = if type(build) == "table" then build.Floor else nil
	local folder = state.Folder
	if Util.IsFinite(floor) then
		setAttr(folder, "BuildFloor", math.floor(floor))
		setAttr(folder, "BuildStart", math.floor(num(build.Start, 0)))
		setAttr(folder, "BuildUntil", math.floor(num(build.Until, 0)))
	else
		setAttr(folder, "BuildFloor", 0)
		setAttr(folder, "BuildStart", 0)
		setAttr(folder, "BuildUntil", 0)
	end
end

local function refreshFx(state: PlotState, p: Player, force: boolean)
	local t = os.clock()
	if not force and t - state.FxAt < FX_REFRESH then
		return
	end
	state.FxAt = t
	local ok, has = call("MonetizationService", "HasPass", p, "FacadeKit")
	setAttr(state.Folder, "Fx", ok and has == true)
end

local function plotForPlayer(p: Player): number?
	local ok, plot = call("PlotService", "PlotOf", p)
	if ok and Util.IsFinite(plot) then
		return plot
	end
	return nil
end

-- ---------------------------------------------------------------------
-- 5) ÖFFENTLICHE API (§C5.7)
-- ---------------------------------------------------------------------
function TowerVisualService.Rebuild(p: Player)
	if typeof(p) ~= "Instance" or not p:IsA("Player") or p.Parent ~= Players then
		return
	end
	local plot = plotForPlayer(p)
	local data = dataOf(p)
	if not plot or not data then
		return
	end
	local state = stateOf(plot)
	if not state then
		return
	end
	-- anderer Besitzer im selben Plot (Wechsel): alte Hülle sofort weg
	if state.Owner ~= p and state.Model then
		state.Model:Destroy()
		state.Model = nil
		state.Floors = 0
	end
	state.Owner = p
	plotOfPlayer[p] = plot
	writeAttributes(state, p, data)
	writeBuild(state, data)
	refreshFx(state, p, true)
	local floors, stage, skin, neon, crown = towerInfo(data)
	state.Token += 1
	local origin = plotCFrame(plot)
	local job: Job = {
		Token = state.Token,
		Model = newModel(plot, origin),
		Origin = origin,
		Stage = stage,
		Floors = floors,
		Skin = skin,
		Neon = neon,
		Crown = crown,
		Next = 1,
		Morph = state.Model ~= nil and stage ~= state.Stage,
	}
	if state.Job then
		state.Job.Model:Destroy() -- halb gebauter, veralteter Auftrag
	end
	state.Job = job
	enqueue(plot)
end

function TowerVisualService.FloorAdded(p: Player, floor: number)
	if typeof(p) ~= "Instance" or not p:IsA("Player") or p.Parent ~= Players then
		return
	end
	local plot = plotForPlayer(p)
	local data = dataOf(p)
	local state = if plot then stateOf(plot) else nil
	if not plot or not data or not state then
		return
	end
	local floors, stage, skin, neon, crown = towerInfo(data)
	local model = state.Model
	local incremental = model ~= nil
		and model.Parent == state.Folder
		and state.Job == nil
		and state.Owner == p
		and stage == state.Stage
		and floors == state.Floors + 1
		and floor == floors
		and skin == state.Skin
		and neon == state.Neon
		and crown == state.Crown
		and floors > 1
	if not incremental or not model then
		TowerVisualService.Rebuild(p)
		return
	end
	-- gleiche Stufe: nur die neue Etage + Spine/Krone/Site neu (≤ 8 + 13 + 60 + 40 Parts)
	local job: Job = {
		Token = state.Token,
		Model = model,
		Origin = plotCFrame(plot),
		Stage = stage,
		Floors = floors,
		Skin = skin,
		Neon = neon,
		Crown = crown,
		Next = floor,
		Morph = false,
	}
	local ok, err = pcall(function()
		buildFloor(job, floor)
		buildTop(job)
	end)
	if not ok then
		logError("FloorAdded", err)
		TowerVisualService.Rebuild(p)
		return
	end
	state.Floors = floors
	model:SetAttribute("Floors", floors)
	writeAttributes(state, p, data)
	writeBuild(state, data)
end

function TowerVisualService.Clear(plot: number)
	local state = stateOf(plot)
	if not state then
		return
	end
	state.Token += 1
	if state.Job then
		state.Job.Model:Destroy()
		state.Job = nil
	end
	local owner = state.Owner
	if owner then
		plotOfPlayer[owner] = nil
	end
	state.Owner = nil
	state.Floors = 0
	state.Stage = 1
	resetAttributes(state.Folder)
	local model = state.Model
	state.Model = nil
	if model then
		scheduleDestroy(model, TEARDOWN_SECONDS)
	end
end

function TowerVisualService.Touch(p: Player)
	if typeof(p) ~= "Instance" or not p:IsA("Player") or p.Parent ~= Players then
		return
	end
	local plot = plotOfPlayer[p] or plotForPlayer(p)
	local data = dataOf(p)
	local state = if plot then stateOf(plot) else nil
	if not state or not data then
		return
	end
	if state.Owner ~= p then
		TowerVisualService.Rebuild(p)
		return
	end
	writeAttributes(state, p, data)
end

function TowerVisualService.PlotFolder(plot: number): Folder?
	local state = stateOf(plot)
	return if state then state.Folder else nil
end

-- Server-Teile aller Hüllen (SelfTest / Admin-Statistik)
function TowerVisualService.PartCount(): number
	local count = 0
	local folder = root
	if not folder then
		return 0
	end
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("BasePart") then
			count += 1
		end
	end
	return count
end

TowerVisualService._Test = {
	Encode = TowerModels.EncodeLayout,
	Decode = TowerModels.DecodeLayout,
	Count = TowerModels.Count,
	Layout = layoutOf,
}

-- ---------------------------------------------------------------------
-- 6) TAKTE & LEBENSZYKLUS
-- ---------------------------------------------------------------------
-- 1 Hz: Baustellen-Attribute (Kran, Bau-Hilfe) + Neon-Fassaden-Kit aller Besitzer
local function siteJob(_dt: number)
	for _, state in pairs(plots) do
		local owner = state.Owner
		if owner and owner.Parent == Players then
			local data = dataOf(owner)
			if data then
				writeBuild(state, data)
				refreshFx(state, owner, false)
			end
		end
	end
end

local function onPlayerRemoving(p: Player)
	local plot = plotOfPlayer[p]
	plotOfPlayer[p] = nil
	-- PlotService ruft Clear(plot); falls nicht (Dienst fehlt), räumen wir selbst auf
	if plot then
		local state = plots[plot]
		if state and state.Owner == p then
			task.defer(function()
				local current = plots[plot]
				if current and current.Owner == p then
					TowerVisualService.Clear(plot)
				end
			end)
		end
	end
end

function TowerVisualService.Init(services: any)
	Services = services
	ensureRoot()
	for plot = 1, PLOTS do
		stateOf(plot)
	end
end

function TowerVisualService.Start()
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	Scheduler.EveryFrame("TowerShells", shellJob)
	Scheduler.Every("TowerBuildSites", 1, siteJob)
	-- Pivot nachziehen, sobald CityService die Plot-Seiten kennt (Start-Reihenfolge)
	task.defer(function()
		for plot = 1, PLOTS do
			local state = plots[plot]
			if state then
				setAttr(state.Folder, "Pivot", plotCFrame(plot))
			end
		end
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		task.defer(TowerVisualService.Rebuild, p)
	end
end

return TowerVisualService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">VehicleService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Autos: Garage, Kauf, Tuning, Spawn, Tempo-Prüfung (Server/Services/VehicleService)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §C5.6 (öffentliche API, Request-Handler), §B12.1 (16 Autos,
--  Klassen-Deckel, Server-Prüfung 5 Hz mit 1,3 × Deckel, 1 Auto je Spieler, Despawn 60 s nach dem Aussteigen, Garage 6 +4 je
--  Garagen-Ebene (max. 2) +12 Mega-Garage, Tuning, Aktionärs-Rabatt), §C11.3 (Kollisionsgruppen: VehicleService.Init
--  registriert Characters/Cars/World/Pickups VOR jedem Spawn; Charakter-Teile -> "Characters"), §C9 (CarSpawn/CarDespawn
--  1/3 s, CarBuy/CarTune 2/s, exakte Schlüssel), §C10 (State "Garage"), §0.4 (Rabatt: Fluss Depot -> Turm erlaubt, nie umgekehrt).
--
--  Physik: VehicleModels.Rig baut Federbeine/Motoren/Servo-Lenkung; Netzwerk-Besitzer = Fahrer (Client-Modul Vehicles
--  steuert Motoren, Boost, Drift). Der Server misst 5×/s das waagerechte Tempo: über 1,3 × Klassen-Deckel bei zwei Messungen
--  in Folge -> Server übernimmt kurz den Besitz, setzt das Tempo auf den Deckel und gibt AntiCheat-Punkte.
--  Einsteigen nur über den Prompt am eigenen Auto (Sitz CanTouch = false); fremde Insassen werden sofort ausgesetzt.
--
--  Öffentliche API (§C5.6):
--    VehicleService.Spawn(p, key): (boolean, string?)     string = Lang-Schlüssel des Grundes
--    VehicleService.Despawn(p)
--    VehicleService.Owns(p, key): boolean                  gespeichert ODER freigeschaltet (Gratis, Pass, Lizenz)
--    VehicleService.GrantCar(p, key): boolean              Gewährung (Starter-Paket, Login, Saison, Admin) – auch ohne Platz
--    VehicleService.Active(p): Model?
--    VehicleService.CollectionValue(p): number             Summe der CR-Preise eigener Autohaus-Autos
--  Zusätzlich: VehicleService.Slots(p): (used, total) · VehicleService._Test (reine Helfer für WorldTests)
--  Request-Handler: CarSpawn {Key, Test?}, CarDespawn {}, CarBuy {Key}, CarTune {Key, Paint?, Rims?, Glow?, Spoiler?}
--    Probefahrt (Test = true): jedes CR-Auto (Source "Shop") ohne Besitz, nur im Umkreis des Autohauses (Anker
--    "Showroom"), Start am Spawnpunkt "Motors", Serien-Lack, Ende nach Config.Vehicles.TestDrive.Seconds, Cooldown.
--  RewardService.Track-Arten: "CarBuy" (1), "CarTune" (1), "Drive" (Studs, gebündelt ab 50)
-- =====================================================================

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util"))
local Lang = require(Shared:WaitForChild("Lang")) :: any
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Format")) :: any
local VehicleModels = require(Shared:WaitForChild("VehicleModels")) :: any
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local VehicleService = {}
local Services: any = nil

type Reply = Types.Reply

local PREFIX = "[VehicleService] "
local FOLDER_NAME = "AkytexCars"
local GROUPS = { "Characters", "Cars", "World", "Pickups" }
local MAX_KEY_LEN = 32
local ENTER_DISTANCE = 16
local ERROR_LOG_EVERY = 10
local RESET_NOTIFY_GAP = 10
local DRIVE_TRACK_STUDS = 50
local PARK_ANCHOR_AFTER = 3

type CarState = {
	Key: string,
	Model: Model,
	Rig: any,
	Seat: VehicleSeat,
	Prompt: ProximityPrompt?,
	Cap: number,
	Occupied: boolean,
	ExitAt: number?,
	Strikes: number,
	OwnerBackAt: number?,
	Parked: boolean,
	LastPos: Vector3?,
	DriveAcc: number,
	TestUntil: number?, -- Probefahrt: Ende (os.clock)
	Conns: { RBXScriptConnection },
}

local VC: any = Config.Vehicles or {}
local active: { [Player]: CarState } = {}
local characterConns: { [Player]: { RBXScriptConnection } } = {}
local resetNotifyAt: { [Player]: number } = {}
local drivenOnce: { [Player]: boolean } = {}
local testAt: { [Player]: number } = {} -- letzte Probefahrt (os.clock) für den Cooldown
local carFolder: Folder? = nil
local errorLogAt: { [string]: number } = {}
local groupsReady = false

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function logError(where: string, err: any)
	local now = os.clock()
	if now - (errorLogAt[where] or -math.huge) >= ERROR_LOG_EVERY then
		errorLogAt[where] = now
		warn(PREFIX .. where .. ": " .. tostring(err))
	end
end

local function call(serviceName: string, fnName: string, ...: any): (boolean, any)
	local s = Services and Services[serviceName]
	local fn = if type(s) == "table" then s[fnName] else nil
	if type(fn) ~= "function" then
		return false, nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		logError(serviceName .. "." .. fnName, result)
		return false, nil
	end
	return true, result
end

local function langOf(p: Player): string
	local ok, lang = call("PlayerStateService", "LangOf", p)
	if ok and (lang == "de" or lang == "en") then
		return lang
	end
	return Lang.For(p)
end

local function localize(p: Player, key: string, args: { any }?): string
	if args then
		return Lang.T(langOf(p), key, table.unpack(args))
	end
	return Lang.T(langOf(p), key)
end

local function fail(p: Player, key: string, args: { any }?): Reply
	return { Ok = false, Message = localize(p, key, args) }
end

local function okReply(p: Player, key: string?, args: { any }?): Reply
	local reply: Reply = { Ok = true }
	if key then
		reply.Message = localize(p, key, args)
	end
	return reply
end

local function credits(p: Player, n: number): string
	local ok, text = pcall(Format.Credits, n, langOf(p))
	return if ok then text else tostring(n)
end

local function carName(p: Player, car: any): string
	return Lang.Pick(langOf(p), car.Name)
end

local function dataOf(p: Player): { [string]: any }?
	local ok, data = call("DataService", "Get", p)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

-- Garage-Teil des Spielstands reparieren (nie nil, Typen sauber)
local function garageOf(data: { [string]: any }): { [string]: any }
	local garage = data.Garage
	if type(garage) ~= "table" then
		garage = { Cars = { LamCity = true }, Active = "LamCity", Tune = {} }
		data.Garage = garage
	end
	if type(garage.Cars) ~= "table" then
		garage.Cars = { LamCity = true }
	end
	if type(garage.Tune) ~= "table" then
		garage.Tune = {}
	end
	if type(garage.Active) ~= "string" then
		garage.Active = "LamCity"
	end
	return garage
end

local function markDirty(p: Player)
	call("PlayerStateService", "MarkDirty", p, "Garage")
end

local function hasPass(p: Player, key: string): boolean
	local ok, result = call("MonetizationService", "HasPass", p, key)
	return ok and result == true
end

local function isClub(p: Player): boolean
	if p:GetAttribute("Club") == true then
		return true
	end
	local ok, result = call("MonetizationService", "IsClub", p)
	return ok and result == true
end

local function isVip(p: Player): boolean
	return p:GetAttribute("Vip") == true or hasPass(p, "VIP")
end

local function licenceOf(p: Player): number
	local ok, result = call("ProgressionService", "Licence", p)
	return if ok and Util.IsFinite(result) then result else 1
end

local function present(p: Player): boolean
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent == Players
end

-- Exakte Schlüssel (§C9): nur erlaubte Felder, jedes vom richtigen Typ
local function exact(arg: any, allowed: { [string]: string }, required: { string }): boolean
	if type(arg) ~= "table" then
		return false
	end
	local count = 0
	for key, value in pairs(arg) do
		count += 1
		if count > 8 or type(key) ~= "string" then
			return false
		end
		local kind = allowed[key]
		if kind == nil or type(value) ~= kind then
			return false
		end
		if kind == "string" and (#value == 0 or #value > MAX_KEY_LEN) then
			return false
		end
	end
	for _, key in ipairs(required) do
		if arg[key] == nil then
			return false
		end
	end
	return true
end

local function tuneDefaults(key: string): { [string]: any }
	local car = VC.Car(key)
	local recipe = car and VehicleModels.Recipes[car.Recipe] or nil
	return {
		Paint = if car then car.Paint else "Polar",
		Rims = VC.DefaultRims or "Stock",
		Glow = VC.GlowOff or "Off",
		Spoiler = if recipe then recipe.Spoiler == true else false,
	}
end

local function currentTune(data: { [string]: any }, key: string): { [string]: any }
	local garage = garageOf(data)
	local saved = garage.Tune[key]
	local tune = tuneDefaults(key)
	if type(saved) == "table" then
		if type(saved.Paint) == "string" and VC.Option("Paint", saved.Paint) then
			tune.Paint = saved.Paint
		end
		if type(saved.Rims) == "string" and VC.Option("Rims", saved.Rims) then
			tune.Rims = saved.Rims
		end
		if type(saved.Glow) == "string" and (saved.Glow == VC.GlowOff or VC.Option("Glow", saved.Glow)) then
			tune.Glow = saved.Glow
		end
		if type(saved.Spoiler) == "boolean" then
			tune.Spoiler = saved.Spoiler
		end
	end
	return tune
end

-- ---------------------------------------------------------------------
-- 2) REINE REGELN (auch für WorldTests)
-- ---------------------------------------------------------------------
-- Anzahl Garagen-Ebenen im Tower (Abteilung "Garage", höchstens GarageLevelsMax)
local function garageLevels(data: { [string]: any }): number
	local tower = data.Tower
	local floors = type(tower) == "table" and tower.Floors or nil
	local n = 0
	if type(floors) == "table" then
		for _, floor in ipairs(floors) do
			if type(floor) == "table" and floor.R == "Garage" then
				n += 1
			end
		end
	end
	return math.min(n, VC.GarageLevelsMax or 2)
end

local function slotsFor(data: { [string]: any }, megaGarage: boolean): number
	local base = VC.GarageBase or 6
	return base + garageLevels(data) * (VC.GarageLevelSlots or 4) + (if megaGarage then VC.MegaGarageSlots or 12 else 0)
end

local function usedSlots(data: { [string]: any }): number
	local n = 0
	for key, owned in pairs(garageOf(data).Cars) do
		if owned == true and VC.Car(key) then
			n += 1
		end
	end
	return n
end

-- Preis mit Aktionärs-Rabatt (§B12.1): (Endpreis, gesparter Betrag)
local function priceFor(car: any, discount: boolean): (number, number)
	local price = math.floor(car.Price or 0)
	local rule = VC.ShareholderDiscount
	if discount and car.Maker == "Velocitra" and type(rule) == "table" then
		local saved = math.floor(price * (rule.Pct or 0))
		return price - saved, saved
	end
	return price, 0
end

-- Tuning-Wunsch prüfen + Preis: (ok, Grund-Schlüssel?, neue Werte, Preis)
local function evaluateTune(
	carKey: string,
	current: { [string]: any },
	want: { [string]: any },
	vip: boolean,
	club: boolean
): (boolean, string?, { [string]: any }, number)
	local result = table.clone(current)
	local price = 0
	local changed = false
	if want.Paint ~= nil and want.Paint ~= current.Paint then
		local paint = VC.Option("Paint", want.Paint)
		if not paint then
			return false, "car.tuneUnknown", result, 0
		end
		if paint.Unlock == "Pass" and not vip then
			return false, "car.tuneVip", result, 0
		end
		if paint.Unlock == "Club" and not club then
			return false, "car.tuneClub", result, 0
		end
		result.Paint = want.Paint
		price += VC.TunePrice(carKey, "Paint", want.Paint)
		changed = true
	end
	if want.Rims ~= nil and want.Rims ~= current.Rims then
		if not VC.Option("Rims", want.Rims) then
			return false, "car.tuneUnknown", result, 0
		end
		result.Rims = want.Rims
		price += VC.TunePrice(carKey, "Rims", want.Rims)
		changed = true
	end
	if want.Glow ~= nil and want.Glow ~= current.Glow then
		if want.Glow ~= VC.GlowOff and not VC.Option("Glow", want.Glow) then
			return false, "car.tuneUnknown", result, 0
		end
		result.Glow = want.Glow
		price += VC.TunePrice(carKey, "Glow", want.Glow)
		changed = true
	end
	if want.Spoiler ~= nil and want.Spoiler ~= current.Spoiler then
		result.Spoiler = want.Spoiler
		if want.Spoiler then
			price += VC.TunePrice(carKey, "Spoiler", nil)
		end
		changed = true
	end
	if not changed then
		return false, "car.tuneNothing", result, 0
	end
	return true, nil, result, math.clamp(math.floor(price), 0, 9e13)
end

-- ---------------------------------------------------------------------
-- 3) BESITZ, PLÄTZE, RABATT
-- ---------------------------------------------------------------------
function VehicleService.Owns(p: Player, key: string): boolean
	local car = VC.Car(key)
	if not car or not present(p) then
		return false
	end
	if car.Source == "Free" then
		return true
	end
	local data = dataOf(p)
	if data and garageOf(data).Cars[key] == true then
		return true
	end
	if car.Source == "Pass" and type(car.Pass) == "string" then
		return hasPass(p, car.Pass)
	end
	if car.Source == "Licence" and Util.IsFinite(car.Licence) then
		return licenceOf(p) >= car.Licence
	end
	return false
end

function VehicleService.Slots(p: Player): (number, number)
	local data = dataOf(p)
	if not data then
		return 0, VC.GarageBase or 6
	end
	return usedSlots(data), slotsFor(data, hasPass(p, "MegaGarage"))
end

local function hasDiscount(p: Player): boolean
	local rule = VC.ShareholderDiscount
	if type(rule) ~= "table" then
		return false
	end
	local ok, shares = call("OrderService", "HoldsShares", p, rule.I)
	return ok and Util.IsFinite(shares) and shares >= rule.Min
end

function VehicleService.CollectionValue(p: Player): number
	local data = dataOf(p)
	if not data then
		return 0
	end
	local total = 0
	for key, owned in pairs(garageOf(data).Cars) do
		local car = VC.Car(key)
		if owned == true and car and car.Source == "Shop" and Util.IsFinite(car.Price) then
			total += car.Price
		end
	end
	return math.min(total, 9e15)
end

function VehicleService.GrantCar(p: Player, key: string): boolean
	local car = VC.Car(key)
	if not car or not present(p) then
		return false
	end
	local data = dataOf(p)
	if not data then
		return false
	end
	local garage = garageOf(data)
	if garage.Cars[key] == true then
		return true
	end
	garage.Cars[key] = true
	markDirty(p)
	call("PlayerStateService", "Effect", p, "Reveal", 1, { Key = key })
	return true
end

-- ---------------------------------------------------------------------
-- 4) KOLLISIONSGRUPPEN (§C11.3)
-- ---------------------------------------------------------------------
local function registerGroups()
	for _, name in ipairs(GROUPS) do
		local okCheck, exists = pcall(function(): boolean
			return PhysicsService:IsCollisionGroupRegistered(name)
		end)
		if not (okCheck and exists) then
			local ok, err = pcall(function()
				workspace:RegisterCollisionGroup(name)
			end)
			if not ok then
				warn(PREFIX .. "Kollisionsgruppe " .. name .. ": " .. tostring(err))
			end
		end
	end
	local ok, err = pcall(function()
		PhysicsService:CollisionGroupSetCollidable("Cars", "Characters", false) -- kein Rammen, kein Schleudern
		PhysicsService:CollisionGroupSetCollidable("Cars", "Cars", false) -- Autos fahren durcheinander hindurch
		PhysicsService:CollisionGroupSetCollidable("Cars", "World", true)
		PhysicsService:CollisionGroupSetCollidable("Cars", "Default", true) -- Welt = Standardgruppe
		for _, other in ipairs({ "Default", "Characters", "Cars", "World", "Pickups" }) do
			PhysicsService:CollisionGroupSetCollidable("Pickups", other, false)
		end
	end)
	if not ok then
		warn(PREFIX .. "Kollisionsmatrix: " .. tostring(err))
	end
	groupsReady = ok
end

local function setCharacterGroup(inst: Instance)
	if inst:IsA("BasePart") then
		inst.CollisionGroup = "Characters"
	end
end

local function clearCharacterConns(p: Player)
	local conns = characterConns[p]
	if conns then
		for _, conn in ipairs(conns) do
			conn:Disconnect()
		end
	end
	characterConns[p] = nil
end

local function onCharacter(p: Player, character: Model)
	clearCharacterConns(p)
	for _, inst in ipairs(character:GetDescendants()) do
		setCharacterGroup(inst)
	end
	characterConns[p] = {
		character.DescendantAdded:Connect(setCharacterGroup),
	}
end

-- ---------------------------------------------------------------------
-- 5) SPAWN / DESPAWN
-- ---------------------------------------------------------------------
local function folder(): Folder
	local existing = carFolder
	if existing and existing.Parent then
		return existing
	end
	local old = workspace:FindFirstChild(FOLDER_NAME)
	if old and old:IsA("Folder") then
		carFolder = old
		return old
	end
	local created = Instance.new("Folder")
	created.Name = FOLDER_NAME
	created.Parent = workspace
	carFolder = created
	return created
end

local function setOwner(state: CarState, owner: Player?)
	for _, part in ipairs(state.Model:GetDescendants()) do
		if part:IsA("BasePart") and not part.Anchored then
			pcall(function()
				if part:CanSetNetworkOwnership() then
					part:SetNetworkOwner(owner)
				end
			end)
		end
	end
end

local function setParked(state: CarState, parked: boolean)
	if state.Parked == parked then
		return
	end
	state.Parked = parked
	local chassis = state.Rig and state.Rig.Chassis
	if chassis and chassis.Parent then
		chassis.Anchored = parked
	end
end

local function allowance(p: Player, cap: number?)
	if cap then
		local security = Config.Security or {}
		local slack = (security.Allowances and security.Allowances.CarSlack) or 1.2
		local boost = (VC.Boost and VC.Boost.Mult) or 1.25
		call("AntiCheatService", "SetAllowance", p, { MaxSpeed = cap * boost * slack })
	else
		call("AntiCheatService", "SetAllowance", p, nil)
	end
end

function VehicleService.Despawn(p: Player)
	local state = active[p]
	if not state then
		return
	end
	active[p] = nil
	for _, conn in ipairs(state.Conns) do
		conn:Disconnect()
	end
	if state.Occupied and present(p) then
		allowance(p, nil)
		call("AntiCheatService", "Grace", p, "Impulse", 1.5, state.Cap * 1.3)
	end
	if state.Model.Parent then
		state.Model:Destroy()
	end
	if present(p) then
		markDirty(p)
	end
end

-- nächster Spawnpunkt: eigene Garage (Plot-Einfahrt) oder Config.Vehicles.SpawnPoints; fixed = fester Punkt (Probefahrt)
local function spawnCFrame(p: Player, root: BasePart, fixed: string?): CFrame
	if fixed then
		for _, point in ipairs(VC.SpawnPoints or {}) do
			if point.Key == fixed and typeof(point.Position) == "Vector3" and typeof(point.Facing) == "Vector3" then
				return CFrame.lookAt(point.Position, point.Position + point.Facing)
			end
		end
	end
	local candidates: { CFrame } = {}
	local okPlot, plot = call("PlotService", "PlotOf", p)
	if okPlot and Util.IsFinite(plot) then
		local okSite, site = call("CityService", "PlotSite", plot)
		local cf: CFrame = if okSite and typeof(site) == "CFrame" then site else Config.City.PlotCFrame(plot)
		local pos = (cf * CFrame.new(0, 0, -(VC.GarageSpawnOffset or 68))).Position
		local road = Config.City.Levels.Road
		local flatPos = Vector3.new(pos.X, road, pos.Z)
		table.insert(candidates, CFrame.lookAt(flatPos, flatPos + Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)))
	end
	for _, point in ipairs(VC.SpawnPoints or {}) do
		if typeof(point.Position) == "Vector3" and typeof(point.Facing) == "Vector3" then
			table.insert(candidates, CFrame.lookAt(point.Position, point.Position + point.Facing))
		end
	end
	local best = candidates[1] or CFrame.new(0, Config.City.Levels.Road, 214)
	local bestDist = math.huge
	for _, cf in ipairs(candidates) do
		local d = (cf.Position - root.Position).Magnitude
		if d < bestDist then
			best, bestDist = cf, d
		end
	end
	return best
end

local function onOccupant(p: Player, state: CarState)
	local humanoid = state.Seat.Occupant
	if humanoid then
		local rider = Players:GetPlayerFromCharacter(humanoid.Parent)
		if rider ~= p then
			-- fremder Insasse: sofort aussetzen
			humanoid.Sit = false
			local weld = state.Seat:FindFirstChild("SeatWeld")
			if weld then
				weld:Destroy()
			end
			return
		end
		state.Occupied = true
		state.ExitAt = nil
		state.Strikes = 0
		setParked(state, false)
		setOwner(state, p)
		allowance(p, state.Cap)
		if state.Prompt then
			state.Prompt.Enabled = false
		end
		if not drivenOnce[p] then
			drivenOnce[p] = true
			call("MetricsService", "Funnel", p, 12, "CarDriven")
		end
	else
		if state.Occupied then
			state.Occupied = false
			state.ExitAt = os.clock()
			if present(p) then
				allowance(p, nil)
				call("AntiCheatService", "Grace", p, "Impulse", 1.5, state.Cap * 1.3)
			end
			setOwner(state, nil)
		end
		if state.Prompt then
			state.Prompt.Enabled = true
		end
	end
end

local function addEnterPrompt(p: Player, state: CarState, car: any)
	local body = state.Model:FindFirstChild("Body")
	if not body or not body:IsA("BasePart") then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "EnterPrompt"
	prompt.ActionText = Lang.T("en", "car.enter")
	prompt.ObjectText = Lang.Pick("en", car.Name)
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("TextKey", "car.enter")
	prompt:SetAttribute("Action", "CarEnter")
	prompt:SetAttribute("Owner", p.UserId)
	prompt.Enabled = false
	prompt.Parent = body
	state.Prompt = prompt
end

local function addTrail(model: Model, rig: any)
	local chassis = rig.Chassis
	local size = chassis.Size
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailA"
	a0.Position = Vector3.new(-size.X / 2, -0.2, size.Z / 2)
	a0.Parent = chassis
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailB"
	a1.Position = Vector3.new(size.X / 2, -0.2, size.Z / 2)
	a1.Parent = chassis
	local trail = Instance.new("Trail")
	trail.Name = "NeonTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.5
	trail.MinLength = 0.2
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.fromRGB(79, 140, 255), Color3.fromRGB(179, 107, 255))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	trail.Texture = "rbxasset://textures/gradient.png"
	trail.FaceCamera = true
	trail.Parent = chassis
	model:SetAttribute("Trail", true)
end

-- Scheinwerfer (nachts, im Licht-Budget jedes Clients: WorldLook schaltet die nächsten N ein, §C16)
local function addHeadlight(model: Model)
	local head = model:FindFirstChild("HeadBar") or model:FindFirstChild("HeadL")
	if not head or not head:IsA("BasePart") then
		return
	end
	local beam = Instance.new("SpotLight")
	beam.Name = "Headlight"
	beam.Face = Enum.NormalId.Front
	beam.Angle = 70
	beam.Range = 48
	beam.Brightness = 3
	beam.Color = Color3.fromRGB(235, 242, 255)
	beam.Shadows = false
	beam.Enabled = false
	beam:SetAttribute("Budget", true)
	beam:SetAttribute("NightOnly", true)
	beam.Parent = head
end

-- Probefahrt erlaubt? (Grund-Schlüssel + Argumente bei Ablehnung)
local function testDriveCheck(p: Player, car: any, root: BasePart): (boolean, string?, { any }?)
	local rule = VC.TestDrive
	if type(rule) ~= "table" then
		return false, "car.notOwned", nil
	end
	if car.Source ~= "Shop" then
		return false, "car.testShopOnly", nil
	end
	local okAnchor, showroom = call("CityService", "Anchor", "Showroom")
	if okAnchor and typeof(showroom) == "CFrame" then
		if (root.Position - showroom.Position).Magnitude > (rule.Range or 140) then
			return false, "car.testFar", nil
		end
	end
	local wait = (testAt[p] or -math.huge) + (rule.Cooldown or 120) - os.clock()
	if wait > 0 then
		return false, "car.testCooldown", { math.ceil(wait) }
	end
	return true, nil, nil
end

function VehicleService.Spawn(p: Player, key: string, opts: { Test: boolean? }?): (boolean, string?, { any }?)
	if not present(p) then
		return false, "car.noCharacter"
	end
	local car = VC.Car(key)
	if not car then
		return false, "car.unknown"
	end
	local owned = VehicleService.Owns(p, key)
	local test = type(opts) == "table" and opts.Test == true and not owned
	if not owned and not test then
		return false, "car.notOwned"
	end
	local data = dataOf(p)
	if not data then
		return false, "core.loading"
	end
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return false, "car.noCharacter"
	end
	if test then
		local okTest, reason, args = testDriveCheck(p, car, root :: BasePart)
		if not okTest then
			return false, reason, args
		end
	end
	if not groupsReady then
		registerGroups()
	end
	call("LifestyleService", "StopJetpack", p) -- Jetpack-Erlaubnis endet vor der Auto-Erlaubnis
	VehicleService.Despawn(p)
	-- fremden Sitz (Terminal-Hocker …) verlassen
	local seatPart = humanoid.SeatPart
	if seatPart then
		local weld = seatPart:FindFirstChild("SeatWeld")
		if weld then
			weld:Destroy()
		end
		humanoid.Sit = false
	end

	local tune = if test then tuneDefaults(key) else currentTune(data, key)
	local okBuild, model = pcall(VehicleModels.Build, key, tune.Paint, tune.Rims, tune.Glow)
	if not okBuild or typeof(model) ~= "Instance" then
		logError("Build " .. key, model)
		return false, "core.error"
	end
	local carModel = model :: Model
	VehicleModels.ApplyTune(carModel, key, tune)
	local cf = spawnCFrame(p, root, if test then (VC.TestDrive and VC.TestDrive.Spawn) or "Motors" else nil)
	carModel:PivotTo(cf + Vector3.new(0, 0.35, 0))
	local okRig, rig = pcall(VehicleModels.Rig, carModel, key)
	if not okRig then
		logError("Rig " .. key, rig)
		carModel:Destroy()
		return false, "core.error"
	end
	local cap = VC.Cap(key)
	carModel.Name = "Car_" .. p.UserId
	carModel:SetAttribute("Owner", p.UserId)
	carModel:SetAttribute("Cap", cap)
	pcall(function()
		carModel.ModelStreamingMode = Enum.ModelStreamingMode.Atomic -- nie ein Auto ohne Räder auf dem Client
	end)
	local state: CarState = {
		Key = key,
		Model = carModel,
		Rig = rig,
		Seat = rig.Seat,
		Prompt = nil,
		Cap = cap,
		Occupied = false,
		ExitAt = os.clock(),
		Strikes = 0,
		OwnerBackAt = nil,
		Parked = false,
		LastPos = nil,
		DriveAcc = 0,
		TestUntil = nil,
		Conns = {},
	}
	if test then
		local seconds = (VC.TestDrive and VC.TestDrive.Seconds) or 90
		state.TestUntil = os.clock() + seconds
		testAt[p] = os.clock()
		carModel:SetAttribute("TestUntil", workspace:GetServerTimeNow() + seconds) -- Tacho zeigt die Restzeit
	end
	addEnterPrompt(p, state, car)
	if car.Trail then
		addTrail(carModel, rig)
	end
	addHeadlight(carModel)
	carModel.Parent = folder()
	active[p] = state
	table.insert(
		state.Conns,
		state.Seat:GetPropertyChangedSignal("Occupant"):Connect(function()
			local ok, err = pcall(onOccupant, p, state)
			if not ok then
				logError("Occupant", err)
			end
		end)
	)
	table.insert(
		state.Conns,
		carModel.AncestryChanged:Connect(function()
			if not carModel:IsDescendantOf(workspace) and active[p] == state then
				VehicleService.Despawn(p)
			end
		end)
	)
	if not test then
		garageOf(data).Active = key
	end
	-- einsteigen: AntiCheat vorwarnen, dann setzen
	call("AntiCheatService", "NoteTeleport", p, state.Seat.CFrame)
	local okSit, sitErr = pcall(function()
		state.Seat:Sit(humanoid)
	end)
	if not okSit then
		logError("Sit", sitErr)
	end
	markDirty(p)
	return true, nil
end

function VehicleService.Active(p: Player): Model?
	local state = active[p]
	if state and state.Model.Parent then
		return state.Model
	end
	return nil
end

-- ---------------------------------------------------------------------
-- 6) TEMPO-PRÜFUNG, DESPAWN-TIMER, STRECKE (5 Hz)
-- ---------------------------------------------------------------------
local function trackDrive(p: Player, state: CarState, studs: number)
	state.DriveAcc += studs
	if state.DriveAcc >= DRIVE_TRACK_STUDS then
		local amount = math.floor(state.DriveAcc)
		state.DriveAcc -= amount
		local data = dataOf(p)
		if data and type(data.Stats) == "table" and Util.IsFinite(data.Stats.Drive) then
			data.Stats.Drive = math.min(data.Stats.Drive + amount, 9e15)
		end
		call("RewardService", "Track", p, "Drive", amount, { Car = state.Key })
	end
end

local function checkCar(p: Player, state: CarState, now: number)
	local model = state.Model
	local chassis = state.Rig and state.Rig.Chassis
	if not model.Parent or not chassis or not chassis.Parent then
		VehicleService.Despawn(p)
		return
	end
	local check = VC.SpeedCheck or {}
	if chassis.Position.Y < (check.FallY or -60) then
		VehicleService.Despawn(p)
		return
	end
	if state.TestUntil and now >= state.TestUntil then
		local car = VC.Car(state.Key)
		VehicleService.Despawn(p)
		if car then
			call("PlayerStateService", "Notify", p, "car.testOver", { carName(p, car) }, "Info")
		end
		return
	end
	if not state.Occupied then
		local exitAt = state.ExitAt or now
		if now - exitAt >= (VC.DespawnSeconds or 60) then
			VehicleService.Despawn(p)
			return
		end
		if now - exitAt >= PARK_ANCHOR_AFTER and chassis.AssemblyLinearVelocity.Magnitude < 2 then
			setParked(state, true)
		end
		state.LastPos = nil
		return
	end
	-- Besitz nach einem Zurücksetzen zurückgeben
	if state.OwnerBackAt and now >= state.OwnerBackAt then
		state.OwnerBackAt = nil
		setOwner(state, p)
	end
	local velocity = chassis.AssemblyLinearVelocity
	local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = horizontal.Magnitude
	local limit = state.Cap * (check.Factor or 1.3)
	if speed > limit then
		state.Strikes += 1
		if state.Strikes >= (check.Strikes or 2) then
			state.Strikes = 0
			setOwner(state, nil)
			state.OwnerBackAt = now + (check.OwnerBack or 0.6)
			local clamped = horizontal.Unit * state.Cap
			pcall(function()
				chassis.AssemblyLinearVelocity = Vector3.new(clamped.X, math.min(velocity.Y, 0), clamped.Z)
				chassis.AssemblyAngularVelocity = Vector3.zero
			end)
			local weights = Config.Security and Config.Security.Weights or {}
			call("AntiCheatService", "Add", p, "Car", weights.Car or 4, {
				Speed = math.floor(speed),
				Cap = state.Cap,
				Car = state.Key,
			})
			if now - (resetNotifyAt[p] or -math.huge) >= RESET_NOTIFY_GAP then
				resetNotifyAt[p] = now
				call("PlayerStateService", "Notify", p, "car.speedReset", nil, "Error")
			end
		end
	else
		state.Strikes = 0
	end
	local pos = chassis.Position
	local last = state.LastPos
	if last then
		local moved = Vector3.new(pos.X - last.X, 0, pos.Z - last.Z).Magnitude
		if moved < state.Cap * 1.5 then -- Sprünge (Teleport, Zurücksetzen) zählen nicht
			trackDrive(p, state, moved)
		end
	end
	state.LastPos = pos
end

local function checkAll(_dt: number)
	local now = os.clock()
	for p, state in pairs(active) do
		if not present(p) then
			VehicleService.Despawn(p)
			continue
		end
		local ok, err = pcall(checkCar, p, state, now)
		if not ok then
			logError("Check", err)
		end
	end
end

-- ---------------------------------------------------------------------
-- 7) STATE "Garage" + REQUEST-HANDLER
-- ---------------------------------------------------------------------
local function garageState(p: Player): { [string]: any }
	local data = dataOf(p)
	if not data then
		return {
			Cars = { LamCity = true },
			Active = "LamCity",
			Tune = {},
			Slots = VC.GarageBase or 6,
			Used = 1,
			Spawned = "",
			Test = false,
			Discount = false,
		}
	end
	local garage = garageOf(data)
	local cars: { [string]: boolean } = {}
	for key, owned in pairs(garage.Cars) do
		if owned == true and VC.Car(key) then
			cars[key] = true
		end
	end
	for _, car in ipairs(VC.Cars or {}) do
		if not cars[car.Key] and VehicleService.Owns(p, car.Key) then
			cars[car.Key] = true
		end
	end
	local tune: { [string]: any } = {}
	for key in pairs(cars) do
		tune[key] = currentTune(data, key)
	end
	local state = active[p]
	return {
		Cars = cars,
		Active = garage.Active,
		Tune = tune,
		Slots = slotsFor(data, hasPass(p, "MegaGarage")),
		Used = usedSlots(data),
		Spawned = if state then state.Key else "",
		Test = state ~= nil and state.TestUntil ~= nil,
		Discount = hasDiscount(p),
	}
end

local function handleSpawn(p: Player, arg: any): Reply
	if not exact(arg, { Key = "string", Test = "boolean" }, { "Key" }) then
		return fail(p, "core.invalid")
	end
	local car = VC.Car(arg.Key)
	if not car then
		return fail(p, "car.unknown")
	end
	local test = arg.Test == true and not VehicleService.Owns(p, arg.Key)
	local ok, reason, args = VehicleService.Spawn(p, arg.Key, { Test = test })
	if not ok then
		return fail(p, reason or "core.error", args)
	end
	if test then
		return okReply(p, "car.testStarted", { carName(p, car), (VC.TestDrive and VC.TestDrive.Seconds) or 90 })
	end
	return okReply(p, "car.spawned", { carName(p, car) })
end

local function handleDespawn(p: Player, arg: any): Reply
	if arg ~= nil and (type(arg) ~= "table" or next(arg) ~= nil) then
		return fail(p, "core.invalid")
	end
	if not active[p] then
		return fail(p, "car.noActive")
	end
	VehicleService.Despawn(p)
	return okReply(p, "car.despawned")
end

local function sourceReason(p: Player, car: any): Reply
	if car.Source == "Pass" then
		return fail(p, "car.passOnly")
	elseif car.Source == "Licence" then
		local name = tostring(car.Licence)
		local progression = Config.Progression
		local licences = type(progression) == "table" and progression.Licences or nil
		local entry = type(licences) == "table" and licences[car.Licence] or nil
		if type(entry) == "table" and type(entry.Name) == "table" then
			name = Lang.Pick(langOf(p), entry.Name)
		end
		return fail(p, "car.licenceOnly", { name })
	elseif car.Source == "Login" then
		return fail(p, "car.loginOnly", { car.LoginDay or 0 })
	elseif car.Source == "Season" then
		return fail(p, "car.seasonOnly", { car.Tier or 0 })
	elseif car.Source == "Starter" then
		return fail(p, "car.starterOnly")
	end
	return fail(p, "car.notForSale", { carName(p, car) })
end

local function handleBuy(p: Player, arg: any): Reply
	if not exact(arg, { Key = "string" }, { "Key" }) then
		return fail(p, "core.invalid")
	end
	local car = VC.Car(arg.Key)
	if not car then
		return fail(p, "car.unknown")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local garage = garageOf(data)
	if garage.Cars[car.Key] == true or (car.Source == "Free") then
		return fail(p, "car.owned", { carName(p, car) })
	end
	if car.Source ~= "Shop" then
		return sourceReason(p, car)
	end
	local used, total = usedSlots(data), slotsFor(data, hasPass(p, "MegaGarage"))
	if used >= total then
		return fail(p, "car.garageFull", { used, total })
	end
	local price, saved = priceFor(car, hasDiscount(p))
	if price <= 0 or price >= 9e15 then
		return fail(p, "core.error")
	end
	local okDebit, debited = call("ShopService", "Debit", p, price, "Car")
	if not okDebit then
		return fail(p, "car.shopMissing")
	end
	if debited ~= true then
		local okBalance, balance = call("ShopService", "Balance", p)
		local missing = if okBalance and Util.IsFinite(balance) then math.max(0, price - balance) else price
		return fail(p, "car.noCredits", { credits(p, missing) })
	end
	garage.Cars[car.Key] = true
	-- gerade Probe gefahren und gekauft: Auto bleibt (kein Probefahrt-Ende mehr)
	local driving = active[p]
	if driving and driving.Key == car.Key and driving.TestUntil then
		driving.TestUntil = nil
		driving.Model:SetAttribute("TestUntil", nil)
		garage.Active = car.Key
	end
	markDirty(p)
	call("PlayerStateService", "Effect", p, "Reveal", 1, { Key = car.Key })
	call("RewardService", "Track", p, "CarBuy", 1, { Car = car.Key, Class = car.Class })
	if car.Class == "Hyper" then
		call("CommunityService", "Announce", "car.hyperAnnounce", { p.DisplayName, Lang.Pick("en", car.Name) })
	end
	if saved > 0 then
		return okReply(p, "car.boughtDiscount", { carName(p, car), credits(p, saved) })
	end
	return okReply(p, "car.bought", { carName(p, car) })
end

local function handleTune(p: Player, arg: any): Reply
	if
		not exact(
			arg,
			{ Key = "string", Paint = "string", Rims = "string", Glow = "string", Spoiler = "boolean" },
			{ "Key" }
		)
	then
		return fail(p, "core.invalid")
	end
	local car = VC.Car(arg.Key)
	if not car then
		return fail(p, "car.unknown")
	end
	if not VehicleService.Owns(p, car.Key) then
		return fail(p, "car.notOwned")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local current = currentTune(data, car.Key)
	local ok, reason, result, price = evaluateTune(car.Key, current, {
		Paint = arg.Paint,
		Rims = arg.Rims,
		Glow = arg.Glow,
		Spoiler = arg.Spoiler,
	}, isVip(p), isClub(p))
	if not ok then
		return fail(p, reason or "car.tuneNothing")
	end
	if price > 0 then
		local okDebit, debited = call("ShopService", "Debit", p, price, "Tune")
		if not okDebit then
			return fail(p, "car.shopMissing")
		end
		if debited ~= true then
			local okBalance, balance = call("ShopService", "Balance", p)
			local missing = if okBalance and Util.IsFinite(balance) then math.max(0, price - balance) else price
			return fail(p, "car.noCredits", { credits(p, missing) })
		end
	end
	garageOf(data).Tune[car.Key] = result
	local state = active[p]
	if state and state.Key == car.Key and state.Model.Parent then
		pcall(VehicleModels.ApplyTune, state.Model, car.Key, result)
	end
	markDirty(p)
	call("RewardService", "Track", p, "CarTune", 1, { Car = car.Key })
	if price > 0 then
		return okReply(p, "car.tuned", { carName(p, car), credits(p, price) })
	end
	return okReply(p, "car.tunedFree", { carName(p, car) })
end

-- Einsteigen über den Prompt am eigenen Auto
local function onPrompt(prompt: ProximityPrompt, p: Player)
	if prompt:GetAttribute("Action") ~= "CarEnter" or not present(p) then
		return
	end
	local state = active[p]
	if not state or prompt:GetAttribute("Owner") ~= p.UserId or not prompt:IsDescendantOf(state.Model) then
		return
	end
	if state.Seat.Occupant ~= nil then
		return
	end
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return
	end
	if (root.Position - state.Seat.Position).Magnitude > ENTER_DISTANCE then
		return
	end
	setParked(state, false)
	call("LifestyleService", "StopJetpack", p)
	call("AntiCheatService", "NoteTeleport", p, state.Seat.CFrame)
	state.Seat:Sit(humanoid)
end

-- ---------------------------------------------------------------------
-- 8) LEBENSZYKLUS
-- ---------------------------------------------------------------------
local function onPlayerAdded(p: Player)
	p.CharacterAdded:Connect(function(character: Model)
		onCharacter(p, character)
	end)
	if p.Character then
		onCharacter(p, p.Character)
	end
end

local function onPlayerRemoving(p: Player)
	VehicleService.Despawn(p)
	active[p] = nil
	clearCharacterConns(p)
	resetNotifyAt[p] = nil
	drivenOnce[p] = nil
	testAt[p] = nil
end

local function onProfileLoaded(p: Player, data: { [string]: any })
	local garage = garageOf(data)
	-- unbekannte/kaputte Einträge nicht löschen (künftige Autos), nur Typen reparieren
	for key, owned in pairs(garage.Cars) do
		if type(key) ~= "string" or type(owned) ~= "boolean" then
			garage.Cars[key] = nil
		end
	end
	garage.Cars.LamCity = true
	if VC.Car(garage.Active) == nil then
		garage.Active = "LamCity"
	end
	for key, tune in pairs(garage.Tune) do
		if type(key) ~= "string" or type(tune) ~= "table" then
			garage.Tune[key] = nil
		end
	end
	markDirty(p)
end

function VehicleService.Init(services: any)
	Services = services
	registerGroups() -- §C11.3: vor jedem Spawn
	local pss = Services.PlayerStateService
	if type(pss) ~= "table" then
		warn(PREFIX .. "PlayerStateService fehlt – keine Anfragen/State")
		return
	end
	pss.Provide("Garage", garageState)
	pss.Handle("CarSpawn", handleSpawn, { Rate = 1, Per = 3 })
	pss.Handle("CarDespawn", handleDespawn, { Rate = 1, Per = 3 })
	pss.Handle("CarBuy", handleBuy, { Rate = 2, Per = 1 })
	pss.Handle("CarTune", handleTune, { Rate = 2, Per = 1 })
end

function VehicleService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	call("DataService", "OnProfileLoaded", onProfileLoaded)
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, p: Player)
		local ok, err = pcall(onPrompt, prompt, p)
		if not ok then
			logError("Prompt", err)
		end
	end)
	Scheduler.Every("VehicleCheck", (VC.SpeedCheck and VC.SpeedCheck.Hz) or 5, checkAll)
end

-- Reine Helfer für WorldTests (keine Spieler nötig)
VehicleService._Test = {
	GarageLevels = garageLevels,
	SlotsFor = slotsFor,
	UsedSlots = usedSlots,
	PriceFor = priceFor,
	EvaluateTune = evaluateTune,
	TuneDefaults = tuneDefaults,
	CurrentTune = currentTune,
	Exact = exact,
	GroupsReady = function(): boolean
		return groupsReady
	end,
}

return VehicleService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="104">
        <Properties>
          <string name="Name">Tests</string>
        </Properties>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">AdminTests</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Selbsttests Admin, Events, Anti-Cheat (Server/Tests/AdminTests)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Vertrag: DESIGN.md §D WP11 "Tests" + §C17 (SelfTestService lädt dieses
--  Modul). Gibt { [testName]: (Services) -> () } zurück; jeder Fehler = FAIL.
--  Prüft: Owner-Regel in allen Varianten (Nutzer-/Gruppen-Spiel, Studio, Player2 nie), Klemmen ALLER Katalog-Parameter
--  (Markt + Nicht-Markt), globale Nachricht mit zu großem Until verworfen (AdminService.Core + EventService.ApplyGlobal),
--  Dedupe per Id, Besitzer-Handelssperre/Taint-Fenster ±120 s, Katalog = 21 Events mit Texten, Event-Belohnungs-Quellen
--  in der CR-Whitelist, Config.Events.Validate leer, Anti-Cheat-Guards (present) ohne Spieler.
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Lang = require(Shared:WaitForChild("Lang"))
local Clock = require(Shared:WaitForChild("Clock"))

local EV: any = Config.Events

local function eq(actual: any, expected: any, label: string?)
	if actual ~= expected then
		error(("%s erwartet %s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function truthy(value: any, label: string)
	if not value then
		error(label .. " erwartet wahr", 2)
	end
end

local function falsy(value: any, label: string)
	if value then
		error(label .. " erwartet falsch/nil", 2)
	end
end

-- Dienst aus der Services-Tabelle (SelfTestService) oder direkt aus dem Ordner
local function serviceOf(services: any, name: string): any
	local svc = services and services[name]
	if svc then
		return svc
	end
	local folder = script.Parent.Parent:FindFirstChild("Services")
	local module = folder and folder:FindFirstChild(name)
	assert(module and module:IsA("ModuleScript"), name .. " fehlt")
	return require(module) :: any
end

local Tests = {}

-- ---------------------------------------------------------------------
-- 1) OWNER-REGEL (§B15.1)
-- ---------------------------------------------------------------------
Tests["Admin: Owner-Regel (Nutzer-Spiel, Gruppen-Spiel, Studio, Player2 nie)"] = function(services: any)
	local Core = serviceOf(services, "AdminService").Core
	local cfg = { OwnerIsAdmin = true, GroupOwnerIsAdmin = true, StudioIsAdmin = true, StudioAllPlayersAdmin = false }
	local function rule(info: { [string]: any }): boolean
		info.Cfg = info.Cfg or cfg
		return Core.OwnerRule(info)
	end
	-- Nutzer-Spiel
	truthy(rule({ CreatorType = "User", CreatorId = 555, UserId = 555, Studio = false }), "Besitzer live")
	falsy(rule({ CreatorType = "User", CreatorId = 555, UserId = 556, Studio = false }), "fremder Spieler live")
	falsy(rule({ CreatorType = "User", CreatorId = 0, UserId = 0, Studio = false }), "CreatorId 0 nie Admin")
	falsy(
		rule({
			CreatorType = "User",
			CreatorId = 555,
			UserId = 555,
			Studio = false,
			Cfg = { OwnerIsAdmin = false, StudioIsAdmin = true },
		}),
		"OwnerIsAdmin = false"
	)
	-- Gruppen-Spiel (GetGroupInfoAsync-Ergebnis, Fehler = kein Admin)
	truthy(
		rule({ CreatorType = "Group", CreatorId = 99, UserId = 777, GroupOwnerId = 777, Studio = false }),
		"Gruppen-Besitzer"
	)
	falsy(
		rule({ CreatorType = "Group", CreatorId = 99, UserId = 778, GroupOwnerId = 777, Studio = false }),
		"Gruppen-Mitglied"
	)
	falsy(
		rule({ CreatorType = "Group", CreatorId = 99, UserId = 777, GroupOwnerId = nil, Studio = false }),
		"Gruppen-Info fehlt"
	)
	falsy(rule({ CreatorType = "Group", CreatorId = 99, UserId = 99, Studio = false }), "Gruppen-Id ist kein Nutzer")
	falsy(
		rule({
			CreatorType = "Group",
			CreatorId = 99,
			UserId = 777,
			GroupOwnerId = 777,
			Studio = false,
			Cfg = { GroupOwnerIsAdmin = false },
		}),
		"GroupOwnerIsAdmin = false"
	)
	-- Studio: Player1 (-1) ja, eigene Id ja, Player2 (-2) NIE
	truthy(rule({ CreatorType = "User", CreatorId = 0, UserId = -1, Studio = true }), "Studio Player1")
	truthy(rule({ CreatorType = "User", CreatorId = 0, UserId = 12345, Studio = true }), "Studio eigener Account")
	falsy(rule({ CreatorType = "User", CreatorId = 0, UserId = -2, Studio = true }), "Studio Player2")
	falsy(
		rule({
			CreatorType = "User",
			CreatorId = 0,
			UserId = -2,
			Studio = true,
			Cfg = { StudioIsAdmin = true, StudioAllPlayersAdmin = true },
		}),
		"Player2 auch mit StudioAllPlayersAdmin nie"
	)
	truthy(
		rule({
			CreatorType = "User",
			CreatorId = 0,
			UserId = -3,
			Studio = true,
			Cfg = { StudioIsAdmin = true, StudioAllPlayersAdmin = true },
		}),
		"Player3 nur mit StudioAllPlayersAdmin"
	)
	falsy(rule({ CreatorType = "User", CreatorId = 0, UserId = -3, Studio = true }), "Player3 sonst nie")
	falsy(
		rule({ CreatorType = "User", CreatorId = 0, UserId = -1, Studio = true, Cfg = { StudioIsAdmin = false } }),
		"StudioIsAdmin = false"
	)
	falsy(rule({ CreatorType = "User", CreatorId = 0, UserId = -1, Studio = false }), "-1 live nie Admin")
	falsy(rule({ CreatorType = "User", CreatorId = 555, UserId = 0 / 0, Studio = false }), "NaN-UserId")
	-- Projekt-Einstellung: Player2 bleibt testbar
	eq(Config.Admin.StudioAllPlayersAdmin, false, "Config.Admin.StudioAllPlayersAdmin")
end

-- ---------------------------------------------------------------------
-- 2) KLEMMEN ALLER PARAMETER (§B15.3)
-- ---------------------------------------------------------------------
Tests["Admin: Markt-Parameter geklemmt (Crash/Rally/Pump/Dump/News/Halt/Resume/IPO/Vol/Normalize)"] = function(
	services: any
)
	local Core = serviceOf(services, "AdminService").Core
	local limits = EV.AdminLimits
	-- Crash: alle Grenzen
	local action, args =
		Core.MarketArgs("MegaCrash", { Scope = "All", Strength = 999, Ramp = 1, Decay = 0, Warn = true })
	eq(action, "Crash", "MegaCrash -> Crash")
	eq(args.Strength, limits.MarketStrength[2], "Stärke oben")
	eq(args.Ramp, limits.Ramp[1], "Rampe unten")
	eq(args.Decay, limits.DecayMinutes[1], "Abklingen unten")
	eq(args.Warn, true, "Warnung")
	_, args = Core.MarketArgs("MegaRally", { Scope = "All", Strength = 1, Ramp = 99999, Decay = 99999, Warn = true })
	eq(args.Strength, limits.MarketStrength[1], "Stärke unten")
	eq(args.Ramp, limits.Ramp[2], "Rampe oben")
	eq(args.Decay, limits.DecayMinutes[2], "Abklingen oben")
	eq(args.Warn, nil, "Warnung nur beim Crash")
	_, args = Core.MarketArgs("MegaRally", { Scope = "Sector", Target = "E", Strength = 0 / 0 })
	eq(args.Scope, "Sector", "Sektor")
	eq(args.Strength, limits.MarketStrength[1], "NaN -> Untergrenze")
	local bad, _, errKey = Core.MarketArgs("MegaCrash", { Scope = "Sector", Target = "X" })
	eq(bad, nil, "unbekannter Sektor")
	eq(errKey, "admin.badScope", "Fehler-Schlüssel")
	bad = Core.MarketArgs("MegaCrash", { Scope = "Inst", Target = 1.5 })
	eq(bad, nil, "Instrument nicht ganzzahlig")
	-- Pump/Dump
	_, args = Core.MarketArgs("Pump", { Target = 7, Strength = 80 })
	eq(args.Target, 7, "Pump-Ziel")
	eq(args.Strength, limits.MarketStrength[2], "Pump oben")
	bad = Core.MarketArgs("Dump", { Strength = 10 })
	eq(bad, nil, "Dump ohne Ziel")
	-- News: Text ≤ 80, Band 1 … 4, Richtung ±1
	local long = string.rep("A", (limits.NewsChars or 80) + 1)
	bad = Core.MarketArgs("News", { Scope = "Inst", Target = 3, Text = { de = long, en = "x" } })
	eq(bad, nil, "Eilmeldung zu lang")
	_, args = Core.MarketArgs("News", { Scope = "Sector", Target = "T", Band = 9, Dir = -5, Text = { de = "Test" } })
	eq(args.Band, limits.NewsBand[2], "Band oben")
	eq(args.Dir, -1, "Richtung")
	eq(args.Text.en, "Test", "EN fällt auf DE zurück")
	bad = Core.MarketArgs("News", { Scope = "All", Text = { de = "x", en = "y" } })
	eq(bad, nil, "Eilmeldung nur Wert/Sektor")
	-- Halt/Resume
	_, args = Core.MarketArgs("Halt", { Seconds = 1 })
	eq(args.Seconds, limits.HaltSeconds[1], "Pause unten")
	eq(args.Scope, "All", "Pause ganzer Markt")
	_, args = Core.MarketArgs("Halt", { Scope = "Inst", Target = 5, Seconds = 99999 })
	eq(args.Seconds, limits.HaltSeconds[2], "Pause oben")
	_, args = Core.MarketArgs("Resume", {})
	eq(args.Scope, "All", "Weiter")
	-- IPO
	bad = Core.MarketArgs("Ipo", {})
	eq(bad, nil, "IPO ohne Firma")
	_, args = Core.MarketArgs("Ipo", { Target = 100 })
	eq(args.Target, 100, "IPO-Ziel")
	-- Volatilität ×0,5 … ×3, 5 … 30 min
	_, args = Core.MarketArgs("Vol", { Strength = 10, Minutes = 100 })
	eq(args.Strength, limits.Vol[2], "Vol oben")
	eq(args.Minutes, limits.VolMinutes[2], "Vol-Minuten oben")
	_, args = Core.MarketArgs("Vol", { Strength = 0.01, Minutes = 0 })
	eq(args.Strength, limits.Vol[1], "Vol unten")
	eq(args.Minutes, limits.VolMinutes[1], "Vol-Minuten unten")
	-- Normalisieren, Unbekanntes
	action = Core.MarketArgs("Normalize", { Junk = true })
	eq(action, "Normalize", "Normalisieren")
	bad, _, errKey = Core.MarketArgs("MoonShot", {})
	eq(bad, nil, "unbekannte Markt-Aktion")
	eq(errKey, "admin.evUnknown", "Fehler-Schlüssel unbekannt")
end

Tests["Admin: Nicht-Markt-Parameter geklemmt (Geldregen, Golden Hour, XP-Rausch, Boss, Show)"] = function(services: any)
	local EventService = serviceOf(services, "EventService")
	local limits = EV.AdminLimits
	local args = EventService.Clamp("MoneyRain", { Seconds = 1 })
	eq(args.Seconds, limits.MoneyRain.Seconds[1], "Geldregen unten")
	args = EventService.Clamp("MoneyRain", { Seconds = 99999 })
	eq(args.Seconds, limits.MoneyRain.Seconds[2], "Geldregen oben")
	args = EventService.Clamp("GoldenHour", { Mult = 99, Minutes = 999 })
	eq(args.Mult, 3, "Golden Hour ×3 oben")
	eq(args.Minutes, limits.GoldenHour.Minutes[2], "Golden-Hour-Minuten oben")
	args = EventService.Clamp("GoldenHour", { Mult = 1, Minutes = 0 })
	eq(args.Mult, 2, "Golden Hour ×2 unten")
	eq(args.Minutes, limits.GoldenHour.Minutes[1], "Golden-Hour-Minuten unten")
	args = EventService.Clamp("GoldenHour", { Mult = 2.4 })
	eq(args.Mult, 2, "nur ×2 oder ×3")
	args = EventService.Clamp("XpRush", { Minutes = 1 })
	eq(args.Minutes, limits.XpRush.Minutes[1], "XP-Rausch unten")
	args = EventService.Clamp("XpRush", { Minutes = 1000 })
	eq(args.Minutes, limits.XpRush.Minutes[2], "XP-Rausch oben")
	args = EventService.Clamp("Boss", { Seconds = 5 })
	eq(args.Seconds, limits.Boss.Seconds[1], "Boss unten")
	args = EventService.Clamp("Boss", { Seconds = 1e9 })
	eq(args.Seconds, limits.Boss.Seconds[2], "Boss oben")
	args = EventService.Clamp("SaturdayShow", { GoldenMult = 99 })
	eq(args.GoldenMult, limits.SaturdayShow.GoldenMult, "Show-Werte kommen nur aus der Config")
	local none, errKey = EventService.Clamp("Nuke", {})
	eq(none, nil, "unbekanntes Event")
	eq(errKey, "admin.evUnknown", "Fehler-Schlüssel")
	-- jeder Nicht-Markt-Katalog-Eintrag ist startbar, jeder Markt-Eintrag hat eine Markt-Aktion
	local Core = serviceOf(services, "AdminService").Core
	for _, entry in ipairs(EV.Catalogue) do
		if entry.Market then
			local action = Core.MarketArgs(entry.Key, {
				Scope = "Inst",
				Target = 3,
				Strength = 10,
				Text = { de = "Test", en = "Test" },
			})
			truthy(action, "Markt-Aktion für " .. entry.Key)
		else
			local kind = if entry.Key == "BuildBoom" then "AdminBuildBoom" else entry.Key
			truthy(EventService.Clamp(kind, {}), "Nicht-Markt-Event startbar: " .. entry.Key)
		end
	end
end

-- ---------------------------------------------------------------------
-- 3) GLOBALE NACHRICHTEN (obere Zeitgrenze, Dedupe)
-- ---------------------------------------------------------------------
Tests["Admin: globale Nachricht mit zu großem Until verworfen, Felder geprüft"] = function(services: any)
	local Core = serviceOf(services, "AdminService").Core
	local now = 1800000000
	local max = EV.MaxGlobalSeconds
	local base =
		{ Kind = "AdminAbuse", Id = "A123456", Event = "GoldenHour", Args = { Mult = 2, Minutes = 10 }, By = 1 }
	local function msg(startAt: number, untilT: number): { [string]: any }
		local m = table.clone(base)
		m.StartAt = startAt
		m.Until = untilT
		return m
	end
	truthy(Core.ValidateGlobal(msg(now + 5, now + 605), now, max), "gültig")
	falsy(Core.ValidateGlobal(msg(now + 5, now + max + 1), now, max), "Until > now + max")
	falsy(Core.ValidateGlobal(msg(now - 10, now - 1), now, max), "Until schon vorbei")
	falsy(Core.ValidateGlobal(msg(now + 700, now + 600), now, max), "StartAt nach Until")
	falsy(Core.ValidateGlobal(msg(0 / 0, now + 600), now, max), "StartAt NaN")
	local noId = msg(now, now + 60)
	noId.Id = nil
	falsy(Core.ValidateGlobal(noId, now, max), "ohne Id")
	local deep = msg(now, now + 60)
	deep.Args = { Mult = { Evil = true }, Minutes = 10 }
	local cleaned = Core.ValidateGlobal(deep, now, max)
	truthy(cleaned, "Tabellen in Args werden entfernt, Rest bleibt")
	eq(cleaned.Args.Mult, nil, "verschachtelte Tabelle verworfen")
	eq(cleaned.Args.Minutes, 10, "Zahl bleibt")
	truthy(
		Core.ValidateGlobal({ Kind = "Announce", Id = "N1234", Text = "Hallo", Name = "Owner", UserId = 1 }, now, max),
		"Ansage gültig"
	)
	falsy(
		Core.ValidateGlobal({ Kind = "Announce", Id = "N1234", Text = "", Name = "Owner", UserId = 1 }, now, max),
		"leere Ansage"
	)
	falsy(
		Core.ValidateGlobal({ Kind = "Announce", Id = "N1234", Text = "x", Name = "O", UserId = 1.5 }, now, max),
		"UserId ganzzahlig"
	)
	falsy(Core.ValidateGlobal({ Kind = "Unknown", Id = "X1234" }, now, max), "unbekannte Art")
	truthy(Core.ValidateGlobal({ Kind = "Live", Id = "L1234", Version = 3 }, now, max), "Live")
	falsy(Core.ValidateGlobal("Text", now, max), "kein Table")
	-- Besitzer-Ansage zu Admin-Abuse-Events (Avatar + Haken): nur Katalog-artige Namen, Name/UserId geprüft
	truthy(
		Core.ValidateGlobal(
			{ Kind = "AbuseNote", Id = "B1234", Event = "MegaCrash", UserId = 1, Name = "Owner" },
			now,
			max
		),
		"AbuseNote gültig"
	)
	falsy(
		Core.ValidateGlobal(
			{ Kind = "AbuseNote", Id = "B1234", Event = "Mega Crash!", UserId = 1, Name = "Owner" },
			now,
			max
		),
		"AbuseNote: Event nur Buchstaben/Ziffern"
	)
	falsy(
		Core.ValidateGlobal({ Kind = "AbuseNote", Id = "B1234", Event = "MegaCrash", UserId = 1 }, now, max),
		"AbuseNote ohne Name"
	)
	-- EventService prüft selbst noch einmal (auch für Werte aus dem Speicher)
	local EventService = serviceOf(services, "EventService")
	local t = Clock.Now()
	eq(
		EventService.ApplyGlobal({ Event = "Confetti", Args = {}, StartAt = t + 1, Until = t + max + 60 }),
		false,
		"EventService: Until zu groß"
	)
	eq(
		EventService.ApplyGlobal({ Event = "AllToHall", Args = {}, StartAt = t + 1, Until = t + 60 }),
		false,
		"AllToHall nie global"
	)
	eq(
		EventService.ApplyGlobal({ Event = "Nope", Args = {}, StartAt = t + 1, Until = t + 60 }),
		false,
		"unbekanntes Event"
	)
end

Tests["Admin: Dedupe per Id (letzte n)"] = function(services: any)
	local Core = serviceOf(services, "AdminService").Core
	local dedupe = Core.NewDedupe(3)
	eq(dedupe.Seen("a"), false, "erste Nachricht")
	eq(dedupe.Seen("a"), true, "Duplikat verworfen")
	dedupe.Seen("b")
	dedupe.Seen("c")
	dedupe.Seen("d") -- "a" fällt heraus
	eq(dedupe.Size(), 3, "begrenzt")
	eq(dedupe.Seen("a"), false, "alte Id nach Verdrängung wieder neu")
	eq(dedupe.Seen("d"), true, "jüngste Id bleibt")
	eq(EV.GlobalDedupe >= 200, true, "Dedupe der letzten 200 (§C13)")
end

-- ---------------------------------------------------------------------
-- 4) TAINT-FENSTER / BESITZER-HANDELSSPERRE (±120 s)
-- ---------------------------------------------------------------------
Tests["Admin: Taint-Fenster ±120 s um eigene Markt-Events"] = function(services: any)
	local Core = serviceOf(services, "AdminService").Core
	local block = Config.Security.OwnerTradeBlockSeconds
	eq(block, 120, "OwnerTradeBlockSeconds")
	local list = { { Issued = 1000, Start = 1010 } }
	falsy(Core.TradeBlocked(list, 990, block), "vor dem Auslösen frei")
	truthy(Core.TradeBlocked(list, 1000, block), "ab dem Auslösen gesperrt")
	truthy(Core.TradeBlocked(list, 1010 + block, block), "bis +120 s nach dem Start")
	falsy(Core.TradeBlocked(list, 1011 + block, block), "danach frei")
	falsy(Core.TradeBlocked({}, 1000, block), "ohne Events frei")
	truthy(Core.TradeLockBefore(1000, 1000 + block - 1, block), "Handel < 120 s vorher -> Event abgelehnt")
	falsy(Core.TradeLockBefore(1000, 1000 + block, block), "Handel ≥ 120 s vorher -> erlaubt")
	falsy(Core.TradeLockBefore(nil, 1000, block), "nie gehandelt")
	-- Admin-Fenster (Liga-Taint) laufen über den Markt: bis +10 min nach dem Abklingen
	local window = Config.Market and Config.Market.Admin and Config.Market.Admin.WindowAfter
	eq(window, 600, "Admin-Fenster +10 min (Config.Market.Admin.WindowAfter)")
end

-- ---------------------------------------------------------------------
-- 5) KATALOG, TEXTE, FIREWALL, CONFIG
-- ---------------------------------------------------------------------
Tests["Admin: Katalog 21 Events mit DE/EN-Texten, Pflicht-Schlüssel"] = function()
	eq(#EV.Catalogue, 21, "Admin-Abuse-Katalog")
	local market, other = 0, 0
	for _, entry in ipairs(EV.Catalogue) do
		if entry.Market then
			market += 1
		else
			other += 1
		end
		truthy(Lang.Has("admin.ev." .. entry.Key), "Text admin.ev." .. entry.Key)
		truthy(Lang.Has("admin.evHint." .. entry.Key), "Hinweis admin.evHint." .. entry.Key)
	end
	eq(market, 10, "Markt-Events")
	eq(other, 11, "Nicht-Markt-Events")
	for _, key in ipairs({ "evt.adminWindow", "admin.denied", "admin.acKick", "admin.acBanReason", "evt.pickupFar" }) do
		truthy(Lang.Has(key), "Pflicht-Schlüssel " .. key)
		truthy(Lang.T("de", key) ~= key and Lang.T("en", key) ~= key, "DE/EN " .. key)
	end
	for _, kind in ipairs(EV.Rotation) do
		truthy(Lang.Has("evt.worldStart." .. kind), "Welt-Event-Text " .. kind)
	end
	-- jede Katalog-Aktion hat eine Besitzer-Ansage (DE + EN), dazu Geschenke an alle
	for _, entry in ipairs(EV.Catalogue) do
		local key = "admin.note." .. entry.Key
		truthy(Lang.T("de", key) ~= key and Lang.T("en", key) ~= key, "Ansage DE/EN " .. key)
	end
	for _, key in ipairs({ "admin.note.Generic", "admin.note.SpeedGift", "admin.note.MoneyGift" }) do
		truthy(Lang.T("de", key) ~= key and Lang.T("en", key) ~= key, "Ansage DE/EN " .. key)
	end
end

Tests["Admin: Speed-Geschenk 16–200 (Wunsch 18) und Anti-Cheat-Spielraum"] = function()
	local powers = Config.Security.Powers
	eq(powers.Speed.Min, 16, "Tempo ab 16")
	truthy(powers.Speed.Max >= 200, "Tempo bis mindestens 200")
	truthy(powers.Jump.Max >= 50, "Sprungkraft-Regler")
	truthy(powers.GiftMaxMinutes >= 60, "Geschenk bis mindestens 60 min")
	-- das höchste Geschenk bleibt unter der absoluten Anti-Cheat-Obergrenze (600 Studs/s)
	local sec = Config.Security
	truthy(powers.Speed.Max * sec.SpeedTolerance + sec.SpeedSlack < 600, "Geschenk-Tempo < Anti-Cheat-Deckel")
	for _, key in ipairs({ "admin.giftGot", "admin.giftGotOpen", "admin.giftEnded", "admin.giftGiven" }) do
		truthy(Lang.T("de", key) ~= key and Lang.T("en", key) ~= key, "DE/EN " .. key)
	end
end

Tests["Events: Belohnungen nur über CR-Whitelist (Firewall), Config gültig"] = function()
	local sources: { [string]: boolean } = {}
	for _, name in ipairs(Config.Shop.Sources or {}) do
		sources[name] = true
	end
	for _, source in ipairs({ "Pickup", "Rain", "Event", "Admin" }) do
		truthy(sources[source], "CR-Quelle " .. source .. " in Config.Shop.Sources")
	end
	local errors = EV.Validate(Config)
	eq(#errors, 0, "Config.Events.Validate: " .. table.concat(errors, " | "))
	truthy(EV.RainCoinsMax <= 30, "Geldregen max. 30 je Spieler")
	truthy(EV.PickupRange <= 12, "Pickup-Abstand ≤ 12 Studs")
	truthy(EV.MaxGlobalSeconds <= 3600, "MaxGlobalSeconds ≤ 3600")
	truthy(EV.PickupMaxPerPlayer <= 60, "Pickup-Token ≤ 60 je Spieler (§C16)")
	eq(type(EV.BoostPause), "boolean", "Notschalter BoostPause vorhanden (LiveFields)")
end

Tests["Events: Rotation, nächstes Welt-Event und Wochen-Termine deterministisch"] = function(services: any)
	local EventService = serviceOf(services, "EventService")
	-- Abfragen dürfen ohne Spieler nicht scheitern und liefern nie nil
	local active = EventService.Active()
	eq(type(active), "table", "Active()")
	local mult = EventService.EventMult()
	truthy(mult >= 1 and mult <= 3, "EventMult im Bereich 1 … 3")
	eq(type(EventService.IsAdminAbuse()), "boolean", "IsAdminAbuse")
	eq(type(EventService.BearActive()), "boolean", "BearActive")
	-- Berlin-Termine liegen für alle Server gleich (Samstags-Show 18:15)
	local after = 1791892800 -- Mo 2026-10-12 12:00 UTC
	local show = Clock.NextBerlin(6, 18, 15, after)
	eq(Clock.Weekday(show + Clock.BerlinOffset(show)), 6, "Samstag (Berlin)")
	eq(((show + Clock.BerlinOffset(show)) % 86400), 18 * 3600 + 15 * 60, "18:15 Berlin")
end

-- ---------------------------------------------------------------------
-- 6) ANTI-CHEAT-GUARDS (ohne echte Spieler)
-- ---------------------------------------------------------------------
Tests["AntiCheat: Guards ohne Spieler, Gewichte"] = function(services: any)
	local AntiCheat = serviceOf(services, "AntiCheatService")
	local fake: any = { Name = "Fake" }
	AntiCheat.NoteTeleport(fake, CFrame.new())
	AntiCheat.SetAllowance(fake, { MaxSpeed = 100 })
	AntiCheat.SetAllowance(fake, nil)
	AntiCheat.Grace(fake, "Impulse", 1, 50)
	AntiCheat.Exempt(fake, 2)
	AntiCheat.Add(fake, "Speed", 5, nil)
	eq(AntiCheat.Score(fake), 0, "fremde Werte haben keinen Verdacht")
	eq(next(AntiCheat.Snapshot(fake)), nil, "Snapshot ohne Spieler leer")
	eq(type(AntiCheat.Flags()), "table", "Flags-Liste")
	local weights = Config.Security.Weights
	truthy(weights.Honeypot >= Config.Security.Kick, "Honeypot = sofort Kick")
	truthy(Config.Security.Review < Config.Security.Kick, "Prüf-Flag vor Kick")
end

return Tests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">CoreTests</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Selbsttests Kern (Server/Tests/CoreTests)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C17 + §D WP1 "Tests" (SelfTestService lädt dieses Modul).
--  Gibt { [testName]: (Services) -> () } zurück; jeder Fehler = FAIL.
--  Prüft: Config.Validate leer, Config.ApplyLive (nur LiveFields, geklemmt, Codes nur CR/Kosmetik, Rücksetzen),
--  Lang.Missing leer + Pflicht-Schlüssel, DEFAULT_DATA (String-Schlüssel, JSON, Sanitize/Migrate, Ringpuffer),
--  Scheduler-Statistik, Net-Liste vollständig = ReplicatedStorage.Remotes, AssetSlot mit 0 -> Rezept,
--  Util/Spring/Format/Clock (Sommerzeit-Grenzen), Types ladbar.
-- =====================================================================

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))
local Spring = require(Shared:WaitForChild("Spring"))
local Lang = require(Shared:WaitForChild("Lang"))
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Clock = require(Shared:WaitForChild("Clock"))
local AssetSlot = require(Shared:WaitForChild("AssetSlot"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local function eq(actual: any, expected: any, label: string?)
	if actual ~= expected then
		error(("%s erwartet %s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function near(actual: number, expected: number, tolerance: number, label: string?)
	if math.abs(actual - expected) > tolerance then
		error(("%s erwartet ≈%s, bekommen %s"):format(label or "Wert", tostring(expected), tostring(actual)), 2)
	end
end

local function listText(list: { string }): string
	local shown = {}
	for i = 1, math.min(#list, 8) do
		shown[i] = list[i]
	end
	return table.concat(shown, " | ") .. (if #list > 8 then (" … (+%d)"):format(#list - 8) else "")
end

local function dataServiceOf(services: any): any
	local dataService = services and services.DataService
	if dataService then
		return dataService
	end
	local folder = script.Parent.Parent:FindFirstChild("Services")
	local module = folder and folder:FindFirstChild("DataService")
	assert(module and module:IsA("ModuleScript"), "DataService fehlt")
	return require(module) :: any
end

local Tests = {}

-- ---------------------------------------------------------------------
-- Config
-- ---------------------------------------------------------------------
Tests["Config.Validate leer"] = function()
	local errors = Config.Validate()
	assert(#errors == 0, ("%d Problem(e): %s"):format(#errors, listText(errors)))
end

Tests["Config Kern-Werte"] = function()
	eq(Config.GameName, "AKYTEX TYCOON")
	eq(Config.Server.MaxMoney, 9e15, "MaxMoney")
	assert(Config.Server.MaxMoney < 2 ^ 53, "MaxMoney < 2^53")
	eq(Config.Tech.DataStoreName, "AT_Player_v1")
	eq(Config.Tech.KeyPrefix, "P_")
	eq(Config.Admin.StudioAllPlayersAdmin, false, "Player2 nie Admin")
	assert(Config.Tech.StateFlush >= 0.2, "State höchstens 5×/s")
	eq(Config.Tech.FullStateEvery, 20)
	assert(typeof(Config.Colors.Accent) == "Color3", "Colors.Accent")
	for _, key in ipairs({ "T", "E", "M", "K", "G", "F" }) do
		assert(typeof(Config.Colors.Sectors[key]) == "Color3", "Sektorfarbe " .. key)
	end
	for _, name in ipairs({
		"Security",
		"Client",
		"Quality",
		"Market",
		"Companies",
		"News",
		"Trading",
		"Tower",
