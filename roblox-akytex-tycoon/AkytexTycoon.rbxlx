        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Trade</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Texte "trade." (Shared/Lang/Trade)
--  Besitzer: WP4 (Orders, Depot, Bots). Nur Schlüssel mit Präfix "trade.". Vertrag: DESIGN.md §C15, §B7.3, §B7.6, §B8.
--  Platzhalter wie string.format: %s = Text, %d = ganze Zahl, %% = Prozentzeichen. Preise kommen als zwei Zahlen
--  (ganze AKY, Cent) – das Dezimalzeichen steht im Text selbst ("%d,%02d" DE / "%d.%02d" EN).
--  Sätze ≤ 12 Wörter, ruhiger Ton, keine Wett-/Glücksspiel-Wörter (Wortliste §0.7, Vertrags-Prüfer BANNED_WORDS).
--  Pflicht (§C15): trade.readingBar, trade.confirmSpread, trade.transferAvail, trade.transferLocked, trade.refill.
-- =====================================================================

return {
	de = {
		-- Pflicht / Order-Ticket
