	item("SkylineTrophy", "q8",  "Season1", "Skyline-Pokal",         "Skyline Cup",         0, 5, "Season", { Kind = "Trophy", A = "#b36bff", B = "#1a2130", C = "#7c5cff", M = "Glass", S = 1.1 }),
}
-- stylua: ignore end

-- Nachschlage-Tabellen (Schlüssel -> Eintrag, Code -> Schlüssel)
Decor.ByKey = {} :: { [string]: { [string]: any } }
Decor.ByCode = {} :: { [string]: string }
local RESERVED: { [string]: boolean } = {
	SlotsPerFloor = true,
	PenthouseSlots = true,
	ComfortPct = true,
	ComfortMax = true,
	ComfortItemMax = true,
	StorageMax = true,
	Sets = true,
	Signs = true,
	Items = true,
	ByKey = true,
	ByCode = true,
	Validate = true,
}
for _, entry in ipairs(Decor.Items) do
	assert(Decor.ByKey[entry.Key] == nil, "[Config.Decor] doppelter Schlüssel " .. entry.Key)
	assert(Decor.ByCode[entry.Code] == nil, "[Config.Decor] doppelter Code " .. entry.Code)
	assert(not RESERVED[entry.Key], "[Config.Decor] Schlüssel kollidiert mit einem Feld: " .. entry.Key)
	Decor.ByKey[entry.Key] = entry
	Decor.ByCode[entry.Code] = entry.Key;
	(Decor :: any)[entry.Key] = entry
end

-- =====================================================================
-- PRÜFUNG (Config.Validate sammelt alle Meldungen; leer = alles ok)
-- =====================================================================
local SOURCES: { [string]: boolean } = { Shop = true, Login = true, League = true, Season = true }

local function isNum(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function isPair(v: any): boolean
	return type(v) == "table" and type(v.de) == "string" and v.de ~= "" and type(v.en) == "string" and v.en ~= ""
end

local function isHex(v: any): boolean
	return type(v) == "string" and string.match(v, "^#%x%x%x%x%x%x$") ~= nil
end

function Decor.Validate(_config: any): { string }
	local errors: { string } = {}
	local function add(text: string)
		table.insert(errors, "Config.Decor." .. text)
	end
	local function int(path: string, v: any, lo: number, hi: number)
		if not isNum(v) or v % 1 ~= 0 or v < lo or v > hi then
			add(("%s: ganze Zahl %s … %s erwartet"):format(path, tostring(lo), tostring(hi)))
		end
	end
	int("SlotsPerFloor", Decor.SlotsPerFloor, 1, 16)
	int("PenthouseSlots", Decor.PenthouseSlots, 1, 16)
	int("ComfortItemMax", Decor.ComfortItemMax, 1, 20)
	int("StorageMax", Decor.StorageMax, 1, 100000)
	if not isNum(Decor.ComfortPct) or Decor.ComfortPct < 0 or Decor.ComfortPct > 0.1 then
		add("ComfortPct: Zahl 0 … 0,1 erwartet")
	end
	if not isNum(Decor.ComfortMax) or Decor.ComfortMax < 0 or Decor.ComfortMax > 1 then
		add("ComfortMax: Zahl 0 … 1 erwartet")
	end
	local sets: { [string]: string } = {}
	for i, set in ipairs(Decor.Sets) do
		local where = ("Sets[%d]"):format(i)
		if type(set.Key) ~= "string" or type(set.Code) ~= "string" or not string.match(set.Code, "^%l$") then
			add(where .. ": Key + Code (ein Kleinbuchstabe) erwartet")
		else
			assert(sets[set.Key] == nil, "[Config.Decor] doppeltes Set " .. set.Key)
			sets[set.Key] = set.Code
		end
		if not isPair(set.Name) then
			add(where .. ".Name: { de, en } erwartet")
		end
	end
	if #Decor.Items ~= 68 then
		add(("Items: genau 68 Teile erwartet (§B4.8), gefunden %d"):format(#Decor.Items))
	end
	for i, entry in ipairs(Decor.Items) do
		local where = ("Items[%d] (%s)"):format(i, tostring(entry.Key))
		if type(entry.Key) ~= "string" or not string.match(entry.Key, "^[%w_]+$") or #entry.Key > 40 then
			add(where .. ".Key: Buchstaben/Ziffern (≤ 40) erwartet")
		end
		local setCode = sets[entry.Set]
		if setCode == nil then
			add(where .. ".Set: unbekanntes Set")
		elseif type(entry.Code) ~= "string" or string.match(entry.Code, "^" .. setCode .. "%d%d?$") == nil then
			add(where .. ".Code: Set-Buchstabe + Nummer erwartet")
		end
		if not isPair(entry.Name) then
			add(where .. ".Name: { de, en } erwartet")
		end
		int(where .. ".Comfort", entry.Comfort, 1, Decor.ComfortItemMax)
		if not SOURCES[entry.Source] then
			add(where .. ".Source: Shop/Login/League/Season erwartet")
		elseif entry.Source == "Shop" then
			int(where .. ".Price", entry.Price, 1, 1e14 - 1)
		elseif entry.Price ~= 0 then
			add(where .. ".Price: 0 erwartet (nicht kaufbar)")
		end
		local recipe = entry.Recipe
		if type(recipe) ~= "table" or type(recipe.Kind) ~= "string" or recipe.Kind == "" then
			add(where .. ".Recipe.Kind: Text erwartet")
		else
			for _, field in ipairs({ "A", "B", "C" }) do
				if not isHex(recipe[field]) then
					add(where .. ".Recipe." .. field .. ": #rrggbb erwartet")
				end
			end
			if type(recipe.M) ~= "string" then
				add(where .. ".Recipe.M: Material-Name erwartet")
			end
			if recipe.S ~= nil and (not isNum(recipe.S) or recipe.S < 0.3 or recipe.S > 2) then
				add(where .. ".Recipe.S: Skala 0,3 … 2 erwartet")
			end
		end
		if type(entry.Asset) ~= "table" then
			add(where .. ".Asset: Asset-Platz erwartet")
		end
	end
	for key, text in pairs(Decor.Signs) do
		if type(text) ~= "string" or text == "" or #text > 24 then
			add("Signs." .. tostring(key) .. ": Text (1–24 Zeichen) erwartet")
		end
	end
	return errors
end

return Decor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Welt-Events, Live-Ops-Kalender, Admin-Abuse-Grenzen (Config.Events)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Vertrag: DESIGN.md §C14.2 (Events), §B10 (Welt-Events, Glocken-Moment,
--  Sky-Show, Bär/Bulle, Bullen-Parade, Feuerwerk, Geldregen, Samstags-Show), §B15.3 (Admin-Abuse-Katalog, 21 Events),
--  §C13 (globale Nachrichten: Until ≤ now + MaxGlobalSeconds), §C14.1 LiveFields ("Events.Rotation", "Events.BoostPause",
--  "Events.BellMoment.Mult", "Events.BuildBoom.Pct", "Events.Truck.Bundles", "Events.RainCoinsMax").
--  Alle Zahlen sind Startwerte und 1:1 änderbar. Wird an alle Clients repliziert -> KEINE Geheimnisse hier.
--  Spielertexte stehen in Lang/Events (evt.*) bzw. Lang/Admin (admin.*); hier nur Schlüssel und Zahlen.
--  Diese Datei lädt KEINE Roblox-Dienste (nur CFrame-Werte für Asset-Plätze).
--
--  Abschnitte:
--    1) Welt-Events :10 (Rotation Börsentag % 4)      2) Stündlich: Glocken-Moment, Sky-Show
--    3) Crash & Rally in der Welt (Bär, Bulle)         4) Robux-Shows (Parade, Feuerwerk)
--    5) Geldregen, Pickups                             6) Wochen-Kalender (Berlin-Zeit, Nicht-Markt-Teile)
--    7) Admin-Abuse-Katalog + Grenzen (§B15.3)         8) Globale Nachrichten, Notschalter
--    9) Asset-Plätze (Hybrid, Wunsch 17)               Validate(Config): { string }
-- =====================================================================

local Events = {}

local function slot(): { MeshId: number, TextureId: number, Scale: number, Offset: CFrame }
	return { MeshId = 0, TextureId = 0, Scale = 1, Offset = CFrame.identity }
end

-- ---------------------------------------------------------------------
-- 1) WELT-EVENTS (Minute :10 jedes Börsentags, Rotation = Börsentag-Index % #Rotation, auf allen Servern gleich)
--    Pickups werden PRO SPIELER instanziert (kein Wegschnappen); Server prüft Abstand, Fenster, max. 1 je Id.
-- ---------------------------------------------------------------------
Events.Rotation = { "Truck", "Drones", "BuildBoom", "Press" } -- live änderbar (Admin-Tab Live-Ops)
Events.WorldMinute = 10 -- Minute im Börsentag (Dividenden kommen um :19, Glocke um :00)

Events.Truck = {
	Bundles = 30, -- Bündel je Spieler (live 5 … 60)
	IncomeSeconds = 20, -- je Bündel so viele Sekunden Dauer-Einkommen (ohne Zeitlich)
	Seconds = 120, -- eine Runde um den Ring-Boulevard
	Route = "Ring",
	Lateral = 8, -- Bündel liegen bis zu so viele Studs neben der Fahrbahn-Mitte
	Linger = 30, -- so lange nach dem Ende bleiben liegende Bündel einsammelbar
	SeasonXpMin = 10, -- ab so vielen Bündeln gibt es die Saison-XP für die Teilnahme
}

Events.Drones = {
	Packages = 8, -- Pakete je Spieler (Positionen deterministisch aus dem Start-Tick)
	IncomeSeconds = 60,
	Seconds = 120,
	DropSeconds = 8, -- Drohnen-Anflug: so lange nach dem Start werden die Pakete einsammelbar
	Spread = 14, -- Streuung um den gewählten Ankerpunkt
}

Events.BuildBoom = {
	Pct = 0.25, -- Etagen- und Raum-Stufen-Kosten −25 % (live 0,05 … 0,5)
	Seconds = 300, -- ehrlicher Timer im HUD
}

Events.Press = {
	LeadMinutes = 13, -- zeigt die Quartalszahlen von :03 des NÄCHSTEN Börsentags
	Seconds = 90,
	QuizXp = 50, -- Trader-XP bei bestandenem Quiz (Config.Progression.XpSources.PressQuiz)
	Questions = 3,
	PassCorrect = 2, -- so viele richtige Antworten = bestanden
	PadSpacing = 7, -- Abstand der Antwort-Felder vor dem Hologramm
	MaxItems = 4, -- höchstens so viele Firmen auf dem Hologramm
	-- Fragen-Pool (Texte evt.quiz.<Id>.q / .a1 / .a2 / .a3); Auswahl deterministisch aus dem Börsentag
	Quiz = {
		{ Id = 1, Correct = 1 },
		{ Id = 2, Correct = 2 },
		{ Id = 3, Correct = 3 },
		{ Id = 4, Correct = 1 },
		{ Id = 5, Correct = 2 },
		{ Id = 6, Correct = 3 },
		{ Id = 7, Correct = 1 },
		{ Id = 8, Correct = 2 },
		{ Id = 9, Correct = 3 },
		{ Id = 10, Correct = 1 },
		{ Id = 11, Correct = 2 },
		{ Id = 12, Correct = 3 },
	},
}

-- ---------------------------------------------------------------------
-- 2) STÜNDLICH (Börsentag-Index % DayEvery == 0)
-- ---------------------------------------------------------------------
Events.BellMoment = {
	MinPlayers = 3, -- ≥ 3 Spieler in der Glocken-Zone (Studio: Config.Studio.BellZoneMinPlayers)
	Mult = 1.2, -- Server-Boost (Gruppe Zeitlich/Server; mit der Bullen-Parade gilt der größere Wert)
	Seconds = 300,
	DayEvery = 3,
	WindowSeconds = 60, -- :00 – :01
	ZoneRadius = 18, -- Rückfall, falls Config.City.Zones.Plaza.BellZoneRadius fehlt
}

Events.SkyShow = {
	RespektMult = 2, -- Respekt zählt doppelt (CommunityService liest EventService.Active())
	Seconds = 600, -- so lange zählt Respekt doppelt
