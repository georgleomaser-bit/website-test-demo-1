		"Metal",
		{ Shape = "Cylinder", Rot = { 0, 90, 0 }, Anim = "Swing", Group = "Pendulum" }
	)
	p(list, s, { 1.4, 2.6, 0.08 }, { 0, 3.2, -0.6 }, "#cfe3f7", "Glass", { Transparency = 0.5 })
end

R.Table = function(list, r, s)
