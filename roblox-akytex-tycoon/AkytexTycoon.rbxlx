-- =====================================================================
-- 14) HELFER (rein; Server-CityLayout, CityService und Client-CityLife rechnen identisch)
-- =====================================================================
local HUGE = math.huge

local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= HUGE and n ~= -HUGE
end

-- weiches Maximum (Polynom, exakt a solange b < a − k)
local function smoothMax(a: number, b: number, k: number): number
	if k <= 0 then
		return math.max(a, b)
	end
	local h = math.clamp(0.5 + 0.5 * (b - a) / k, 0, 1)
	return a + (b - a) * h + k * h * (1 - h)
end

-- Mittellinien-Radius einer Ringstraße beim Winkel (Grad); offset = radialer Spur-Versatz
function City.RoadRadius(road: string, angleDeg: number, offset: number?): number
	local def = City.Roads[road]
	local base = if type(def) == "table" and finite(def.Radius) then def.Radius else 245
	local r = base
	local avoid = if type(def) == "table" then def.Avoid else nil
	if type(avoid) == "table" then
		local a = math.rad(angleDeg)
		local c, s = math.cos(a), math.sin(a)
		if s < -1e-6 then
			local tx = if math.abs(c) > 1e-6 then avoid.HalfX / math.abs(c) else HUGE
			local tz = avoid.Depth / math.abs(s)
			local t = math.min(tx, tz)
			r = smoothMax(base, t, avoid.Smooth or 0)
		end
	end
	return r + (if finite(offset) then offset :: number else 0)
end

local routeCache: { [string]: { Vector3 } } = {}

-- Geschlossene Route: fein abgetastet, dann auf gleichmäßige Abstände (spacing) umgerechnet.
function City.RoutePoints(name: string, spacing: number?): { Vector3 }
	local def = City.Routes[name]
	if type(def) ~= "table" then
		return {}
	end
	local step = if finite(spacing) and (spacing :: number) >= 4 then spacing :: number else def.Spacing or 24
	local cacheKey = name .. ":" .. tostring(step)
	local cached = routeCache[cacheKey]
	if cached then
		return table.clone(cached)
	end
	local y = City.Levels.Road
	local fine: { Vector3 } = {}
	local samples = 1440
	for i = 0, samples - 1 do
		local deg = i * 360 / samples
		local r = City.RoadRadius(def.Road, deg, def.Offset)
		local a = math.rad(deg)
		table.insert(fine, Vector3.new(r * math.cos(a), y, r * math.sin(a)))
	end
	-- Gesamtlänge + gleichmäßige Abtastung
	local total = 0
	local cumulative: { number } = { 0 }
	for i = 1, samples do
		local p0 = fine[i]
		local p1 = fine[(i % samples) + 1]
		total += (p1 - p0).Magnitude
		cumulative[i + 1] = total
	end
	local count = math.max(8, math.floor(total / step + 0.5))
	local out: { Vector3 } = {}
	local j = 1
	for k = 0, count - 1 do
		local s = k * total / count
		while j < samples and cumulative[j + 1] < s do
			j += 1
		end
		local segLen = cumulative[j + 1] - cumulative[j]
		local f = if segLen > 0 then (s - cumulative[j]) / segLen else 0
		local p0 = fine[j]
		local p1 = fine[(j % samples) + 1]
		table.insert(out, p0:Lerp(p1, f))
	end
	table.insert(out, out[1]) -- geschlossen: letzter Punkt = erster
	routeCache[cacheKey] = out
	return table.clone(out)
end

function City.PlotCFrame(plot: number): CFrame
	local p = City.Plots
	local k = math.clamp(math.floor(if finite(plot) then plot else 1), 1, math.max(1, p.Count))
	local a = math.rad(p.StartAngle + (k - 1) * p.Step)
	local y = City.Levels.Walk
	local pos = Vector3.new(p.Radius * math.cos(a), y, p.Radius * math.sin(a))
	return CFrame.lookAt(pos, Vector3.new(0, y, 0))
end

function City.ShopCFrame(instId: number): CFrame?
	for _, site in ipairs(City.ShopSites) do
		if site.I == instId then
			local a = math.rad(site.Angle)
			local pos = Vector3.new(City.ShopRadius * math.cos(a), City.Levels.Ground, City.ShopRadius * math.sin(a))
			return CFrame.lookAt(pos, Vector3.new(0, City.Levels.Ground, 0))
		end
	end
	return nil
end

-- ---------------------------------------------------------------------
-- PRÜFUNG (Config.Validate sammelt alle Meldungen; leer = alles ok)
-- ---------------------------------------------------------------------
function City.Validate(config: any): { string }
	local errors: { string } = {}
	local function add(text: string)
		table.insert(errors, "Config.City." .. text)
	end
	local function num(path: string, v: any, lo: number, hi: number)
		if not finite(v) or v < lo or v > hi then
			add(("%s: Zahl %s … %s erwartet"):format(path, tostring(lo), tostring(hi)))
		end
	end
	local function int(path: string, v: any, lo: number, hi: number)
		if not finite(v) or v % 1 ~= 0 or v < lo or v > hi then
			add(("%s: ganze Zahl %s … %s erwartet"):format(path, tostring(lo), tostring(hi)))
		end
	end
	local function color(path: string, v: any)
		if typeof(v) ~= "Color3" then
			add(path .. ": Color3 erwartet")
		end
	end

	-- Budget & Aufbau (§B3/§C16)
	int("PartBudget", City.PartBudget, 1000, 12000)
	int("BuildPerFrame", City.BuildPerFrame, 10, 400)
	int("TerrainPerFrame", City.TerrainPerFrame, 1, 16)

	-- Ebenen
	num("Levels.Road", City.Levels.Road, 0, 2)
	num("Levels.Walk", City.Levels.Walk, City.Levels.Road, 3)
	num("Ground.MapSize", City.Ground.MapSize, 1024, 4096)

	-- Look
	for _, phase in ipairs({ "Day", "Night" }) do
		local look = (City.Look :: any)[phase]
		if type(look) ~= "table" or type(look.Atmosphere) ~= "table" then
			add("Look." .. phase .. ": Tabelle mit Atmosphere erwartet")
		else
			num("Look." .. phase .. ".Brightness", look.Brightness, 0, 10)
			num("Look." .. phase .. ".Atmosphere.Density", look.Atmosphere.Density, 0, 1)
			num("Look." .. phase .. ".Atmosphere.Haze", look.Atmosphere.Haze, 0, 10)
			color("Look." .. phase .. ".Atmosphere.Color", look.Atmosphere.Color)
			color("Look." .. phase .. ".Ambient", look.Ambient)
		end
	end
	num("Look.Bloom.Intensity", City.Look.Bloom.Intensity, 0, 2)
	num("Look.Bloom.Size", City.Look.Bloom.Size, 0, 56)
	num("Look.Bloom.Threshold", City.Look.Bloom.Threshold, 0, 4)
	num("Look.SunRays.Intensity", City.Look.SunRays.Intensity, 0, 1)
	num("Look.WindowCascade", City.Look.WindowCascade, 0, 1)
	num("Look.WindowOnAt", City.Look.WindowOnAt, 12, 24)
	num("Look.WindowOffAt", City.Look.WindowOffAt, 0, 12)

	-- Wetter
	num("Weather.ClearBelow", City.Weather.ClearBelow, 0.1, 5)
	num("Weather.StormAbove", City.Weather.StormAbove, City.Weather.ClearBelow, 5)
	for _, key in ipairs({ "Clear", "Clouds", "Storm" }) do
		num("Weather.Cover." .. key, (City.Weather.Cover :: any)[key], 0, 1)
	end
	num("Weather.Lightning.MinGap", City.Weather.Lightning.MinGap, 1, 120)
	num("Weather.Lightning.MaxGap", City.Weather.Lightning.MaxGap, City.Weather.Lightning.MinGap, 240)

	-- Plots
	local plots = City.Plots
	int("Plots.Count", plots.Count, 1, 32)
	num("Plots.Radius", plots.Radius, 100, 1000)
	num("Plots.Size", plots.Size, 40, 200)
	local server = type(config) == "table" and config.Server or nil
	if type(server) == "table" and finite(server.Plots) and server.Plots ~= plots.Count then
		add("Plots.Count: muss Config.Server.Plots entsprechen")
	end

	-- Straßen & Routen
	for _, road in ipairs({ "Ring", "Outer", "Highway" }) do
		local def = (City.Roads :: any)[road]
		if type(def) ~= "table" then
			add("Roads." .. road .. ": Tabelle erwartet")
		else
			num("Roads." .. road .. ".Radius", def.Radius, 100, 1000)
			num("Roads." .. road .. ".Width", def.Width, 8, 80)
		end
	end
	for name, def in pairs(City.Routes) do
		if type(def) ~= "table" or type(City.Roads[def.Road]) ~= "table" then
			add("Routes." .. tostring(name) .. ": Road unbekannt")
		end
	end
	for i, lane in ipairs(City.Lanes) do
		if type(City.Roads[lane.Road]) ~= "table" or (lane.Dir ~= 1 and lane.Dir ~= -1) then
			add(("Lanes[%d]: Road/Dir ungültig"):format(i))
		end
		num(("Lanes[%d].Speed"):format(i), lane.Speed, 1, 200)
	end

	-- Läden
	local shopCount = 0
	for instId, anchorName in pairs(City.Shops) do
		shopCount += 1
		if not finite(instId) or type(anchorName) ~= "string" or anchorName == "" then
			add("Shops: { [instId] = AnchorName } erwartet")
		end
	end
	local sitesSeen: { [number]: boolean } = {}
	for i, site in ipairs(City.ShopSites) do
		if City.Shops[site.I] == nil then
			add(("ShopSites[%d]: Firma %s fehlt in Shops"):format(i, tostring(site.I)))
		end
		assert(not sitesSeen[site.I], "[Config.City] doppelter Laden " .. tostring(site.I))
		sitesSeen[site.I] = true
		num(("ShopSites[%d].Angle"):format(i), site.Angle, 0, 360)
	end
	if #City.ShopSites ~= shopCount then
		add("ShopSites: je Eintrag in Shops genau ein Laden")
	end
	num("ShopNewsSeconds", City.ShopNewsSeconds, 10, 3600)

	-- Hologramme, Kulisse, Leben
	for i, board in ipairs(City.Billboards) do
		int(("Billboards[%d].I"):format(i), board.I, 1, 99)
	end
	int("Zones.Backdrop.Count", City.Zones.Backdrop.Count, 0, 64)
	for _, tier in ipairs({ "Low", "Medium", "High", "Ultra" }) do
		int("Life.Billboards." .. tier, (City.Life.Billboards :: any)[tier], 0, #City.Billboards)
	end
	num("Lights.ManageHz", City.Lights.ManageHz, 0.2, 10)
	int("Lights.MaxManaged", City.Lights.MaxManaged, 10, 2000)

	-- Schilder (eindeutige Schlüssel)
	local signs: { [string]: boolean } = {}
	for i, sign in ipairs(City.Signs) do
		if type(sign.Key) ~= "string" or type(sign.Name) ~= "string" or sign.Name == "" then
			add(("Signs[%d]: Key + Name erwartet"):format(i))
		else
			assert(not signs[sign.Key], "[Config.City] doppeltes Schild " .. sign.Key)
			signs[sign.Key] = true
		end
	end

	-- Routen müssen geschlossen sein
	for name in pairs(City.Routes) do
		local points = City.RoutePoints(name)
		if #points < 9 or (points[1] - points[#points]).Magnitude > 1e-3 then
			add("Routes." .. tostring(name) .. ": Route nicht geschlossen")
		end
	end
	return errors
end

return City
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Client</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – CLIENT-EINSTELLUNGEN (Shared/Config/Client)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §C14.2 (Config.Client), §C7.5 (Controls), §A4 (Sound).
--  Erreichbar als Config.Client (wird von Config/init automatisch geladen).
--
--  Inhalt:
--    1) Keys / Gamepad          Tastenbelegung – Namen von Enum.KeyCode bzw. Enum.UserInputType (Listen erlaubt)
--    2) DefaultSettings         Standardwerte von Data.Settings
--    3) SettingsSchema          [Key] = { Type, Min?, Max?, Step?, Integer?, Options?, Fields? } für JEDEN Standardwert
--                               (Server klemmt SaveSettings damit, Client baut das Einstellungen-Fenster damit)
--    4) Sounds                  0 = eingebautes Rezept (Sfx, nur docs/ASSETS.md §2), sonst eigene Audio-ID (Hybrid, Wunsch 17)
--    5) HUD / Touch / Bewegung  Grenzen, Größen, Takt-Werte
--    6) Ladebildschirm          Splash-Zeiten (§A4)
--  ACHTUNG: Config wird an alle Clients repliziert -> KEINE Geheimnisse hier!
-- =====================================================================

export type SchemaEntry = {
	Type: "number" | "boolean" | "enum" | "table",
	Min: number?,
	Max: number?,
	Step: number?, -- Schrittweite des Reglers im Einstellungen-Fenster
	Integer: boolean?, -- nur ganze Zahlen
	Options: { string }?, -- nur Type = "enum"
	Fields: { [string]: SchemaEntry }?, -- nur Type = "table" (fehlende Felder = Standard des Feldes)
}

local Client = {}

-- ---------------------------------------------------------------------
-- 1) TASTEN – alles läuft über ContextActionService (Modul Controls). Aktionen (§C7.5):
--    Interact, Terminal, Tower, Shop, Quests, Menu, Sprint, Boost, Handbrake, ChartTf, ChartType, React,
--    AdminPanel, Fly, Spectate, Debug, PhotoMode. Kontexte World | Vehicle | Terminal | Menu | Spectate.
--    ChartTf: die Ziffern 1–7 wählen den Zeitrahmen (1s · 5s · 1m · 5m · 15m · 1T · 1W), Taste über input.KeyCode.
-- ---------------------------------------------------------------------
Client.Keys = {
	Interact = { "E" },
	Terminal = { "T" },
	Tower = { "B" },
	Shop = { "N" },
	Quests = { "J" },
	Menu = { "M" },
	Sprint = { "LeftShift" },
	Boost = { "LeftShift" },
	Handbrake = { "Space" },
	React = { "R" },
	ChartTf = { "One", "Two", "Three", "Four", "Five", "Six", "Seven" },
	ChartType = { "C" },
	AdminPanel = { "P" },
	Fly = { "G" },
	Spectate = { "X" },
	Debug = { "F8" },
	PhotoMode = { "F7" },
}

-- Gamepad: ein Knopf oder eine Liste je Aktion. ProximityPrompts (ButtonX) bleiben frei (Interact wird durchgereicht).
-- Terminal = Y (halten/tippen), LB/RB = Zeitrahmen im Terminal, R1 = Boost im Auto, B = Handbremse im Auto.
Client.Gamepad = {
	Interact = "ButtonX",
	Terminal = "ButtonY",
	Menu = "ButtonStart",
	Tower = "DPadUp",
	Quests = "DPadRight",
	Shop = "DPadLeft",
	React = "DPadDown",
	Sprint = "ButtonL3",
	Boost = "ButtonR1",
	Handbrake = "ButtonB",
	ChartTf = { "ButtonL1", "ButtonR1" },
	ChartType = "ButtonSelect",
}

-- ---------------------------------------------------------------------
-- 2) STANDARD-EINSTELLUNGEN (§C14.2) – landen per Reconcile in Data.Settings
-- ---------------------------------------------------------------------
Client.DefaultSettings = {
	Lang = "auto", -- "auto" (LocaleId) | "de" | "en"
	Sfx = 1,
	Music = 0.5,
	Ui = 0.8,
	Quality = "auto", -- "auto" (FPS-gesteuert) | "Low" | "Medium" | "High" | "Ultra"
	ReducedFx = false, -- = Website prefers-reduced-motion
	ChartType = "Candles",
	ChartTf = "1m",
	Indicators = {}, -- [Name] = true (Terminal, WP5); fehlende Felder = aus
	NumberStyle = "short", -- "short" (1,25 Mio.) | "long" (1.250.000)
	Colorblind = false, -- Up/Down -> Accent/Orange, ▲/▼ immer sichtbar
	Shake = 1,
	ShowNet = false,
	TickerBar = true,
	NewsCards = "Normal", -- "Normal" | "Quiet" (nur Crash/Rally/Glocke) | "Off"
	AutoTransfer = true, -- Gewinn-Transfer an der Glocke (Server: Request TradeAuto)
	LeftHanded = false,
	ButtonScale = 1,
}

-- ---------------------------------------------------------------------
-- 3) SCHEMA – für jeden Standardwert genau ein Eintrag (Validate prüft das)
-- ---------------------------------------------------------------------
local INDICATOR_NAMES = {
	"SMA20",
	"SMA50",
	"SMA200",
	"EMA9",
	"EMA21",
	"BB",
	"VWAP",
	"RSI",
	"MACD",
	"Stoch",
	"ATR",
}
local indicatorFields: { [string]: SchemaEntry } = {}
for _, name in ipairs(INDICATOR_NAMES) do
	indicatorFields[name] = { Type = "boolean" }
end
Client.IndicatorNames = INDICATOR_NAMES

local schema: { [string]: SchemaEntry } = {
	Lang = { Type = "enum", Options = { "auto", "de", "en" } },
	Sfx = { Type = "number", Min = 0, Max = 1, Step = 0.05 },
	Music = { Type = "number", Min = 0, Max = 1, Step = 0.05 },
	Ui = { Type = "number", Min = 0, Max = 1, Step = 0.05 },
	Quality = { Type = "enum", Options = { "auto", "Low", "Medium", "High", "Ultra" } },
	ReducedFx = { Type = "boolean" },
	ChartType = { Type = "enum", Options = { "Candles", "Hollow", "Line", "Area", "HeikinAshi" } },
	ChartTf = { Type = "enum", Options = { "1s", "5s", "1m", "5m", "15m", "1T", "1W" } },
	Indicators = { Type = "table", Fields = indicatorFields },
	NumberStyle = { Type = "enum", Options = { "short", "long" } },
	Colorblind = { Type = "boolean" },
	Shake = { Type = "number", Min = 0, Max = 1, Step = 0.05 },
	ShowNet = { Type = "boolean" },
	TickerBar = { Type = "boolean" },
	NewsCards = { Type = "enum", Options = { "Normal", "Quiet", "Off" } },
	AutoTransfer = { Type = "boolean" },
	LeftHanded = { Type = "boolean" },
	ButtonScale = { Type = "number", Min = 0.9, Max = 1.3, Step = 0.05 },
}
Client.SettingsSchema = schema

-- ---------------------------------------------------------------------
-- 4) SOUNDS (§A4) – 0 = eingebautes Rezept aus den 9 nutzbaren Dateien (docs/ASSETS.md §2), sonst eigene Audio-ID.
--    Engine = Loop (action_falling.ogg, Tonhöhe nach Tempo), Music = ohne ID keine Musik.
-- ---------------------------------------------------------------------
Client.Sounds = {
	UIClick = 0,
	UIHover = 0,
	UIError = 0,
	Buy = 0,
	Sell = 0,
	Profit = 0,
	Loss = 0,
	CashRegister = 0,
	TickerTick = 0,
	MarketBell = 0,
	CrashAlarm = 0,
	RallyFanfare = 0,
	ElevatorDing = 0,
	Construct = 0,
	MoneyRain = 0,
	Engine = 0,
	LevelUp = 0,
	Achievement = 0,
	Pickup = 0,
	Whoosh = 0,
	Countdown = 0,
	Notify = 0,
	Music = 0,
}

-- ---------------------------------------------------------------------
-- 5) HUD, TOUCH, BEWEGUNG, EFFEKTE (Budgets §C16)
-- ---------------------------------------------------------------------
Client.TouchButtonMin = 64 -- kein Touch-Knopf kleiner als 64 px (auch bei Knopfgröße 90 %)
Client.AutoReducedFx = { Fps = 35, Seconds = 5 } -- auf "Low" noch < 35 FPS für 5 s -> Reduzierte Effekte (einmal)
Client.HighlightCap = 31 -- Roblox zeigt höchstens 31 Highlights gleichzeitig
Client.Pools = {
	Sounds = 24, -- je Hälfte 2D (Oberfläche) und 3D (Welt)
	CoinFly = 16, -- fliegende CR-Chips beim Einsammeln
	Confetti = 140, -- gleichzeitig fliegende Konfetti-Stücke
}

-- Touch-Knöpfe (unskalierte TouchGui). Größen in Pixel bei Knopfgröße 100 %.
Client.Touch = {
	ButtonSize = 76, -- SPRINT (Welt), HANDBREMSE (Auto)
	BigSize = 96, -- BOOST (Auto)
	SmallSize = 64, -- REAKTION
	Margin = 16,
	AutoSprint = 0.9, -- Stick-Auslenkung, ab der automatisch gesprintet wird
}

-- Bewegung: Sprinten setzt die Lauf-Geschwindigkeit (AntiCheat erlaubt 32 × 1,15 – Config.Security)
Client.Movement = {
	WalkSpeed = 16,
	SprintSpeed = 24,
}

-- HUD (§D WP2): Takt-Werte und Größen
Client.Hud = {
	TickerHeight = 28, -- Ticker-Leiste oben
	PillHeight = 30,
	MaxPills = 4, -- so viele Pillen gleichzeitig oben in der Mitte
	VaultRingTicks = 32, -- Segmente des Tresor-Rings
	VaultWarn = 0.85, -- ab hier Ring in Warn-Farbe
	MultPopGap = 0.6, -- Multiplikator-Chip ploppt höchstens so oft
	TickerRefresh = 1, -- Sekunden zwischen zwei Ticker-Aktualisierungen
}

-- ---------------------------------------------------------------------
-- 6) LADEBILDSCHIRM (§A4: max. 4 s, endet früher wenn geladen, tippen überspringt; harte Grenze 12 s)
-- ---------------------------------------------------------------------
Client.Splash = {
	MinSeconds = 2.4, -- Logo-Animation darf so lange laufen (Taglines bei 1,25 / 1,45 s)
	LoadedMaxSeconds = 4, -- ist das Spiel geladen, endet die Splash spätestens hier
	HardCapSeconds = 12, -- harte Obergrenze, auch wenn noch nicht alles da ist
	SkipAfter = 0.3, -- tippen/klicken überspringt erst nach so vielen Sekunden
	OutSeconds = 0.7, -- Ausblenden (Skalierung 1,12 + Fade)
	-- Hybrid-Platz (§C14.3, Wunsch 17): Ladebildschirm-Hintergrund. 0 = reine Code-Grafik, sonst Bild-Id (1920 × 1080);
	-- lädt das Bild nicht, bleibt automatisch die Code-Grafik
	ImageId = 0,
}

-- Hybrid-Plätze (§C14.3, Wunsch 17): UI-Icons der HUD-Knöpfe. 0 = Emoji/Code-Grafik, sonst Bild-Id (256 × 256 PNG,
-- weißes Strich-Icon auf transparent). Lädt ein Bild nicht, zeigt der Knopf automatisch wieder das Emoji.
Client.Icons = {
	Trade = 0,
	Tower = 0,
	Shop = 0,
	Quests = 0,
	Academy = 0,
	Garage = 0,
	Social = 0,
	Boards = 0,
	Settings = 0,
}

-- ---------------------------------------------------------------------
-- 7) PRÜFEN (Config.Validate sammelt das) – leere Liste = alles ok
-- ---------------------------------------------------------------------
local function isFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function checkValue(errors: { string }, path: string, entry: SchemaEntry, value: any, optional: boolean)
	if value == nil and optional then
		return
	end
	if entry.Type == "number" then
		if not isFinite(value) then
			table.insert(errors, path .. ": Zahl erwartet")
			return
		end
		local lo, hi = entry.Min, entry.Max
		if lo == nil or hi == nil or lo > hi then
			table.insert(errors, path .. ": Schema braucht Min ≤ Max")
		elseif value < lo or value > hi then
			table.insert(
				errors,
				("%s: Standard %s außerhalb %s..%s"):format(path, tostring(value), tostring(lo), tostring(hi))
			)
		end
		if entry.Integer and value % 1 ~= 0 then
			table.insert(errors, path .. ": ganze Zahl erwartet")
		end
	elseif entry.Type == "boolean" then
		if type(value) ~= "boolean" then
			table.insert(errors, path .. ": true/false erwartet")
		end
	elseif entry.Type == "enum" then
		local options = entry.Options
		if type(options) ~= "table" or #options == 0 then
			table.insert(errors, path .. ": Schema braucht Options")
		elseif not table.find(options, value) then
			table.insert(errors, path .. ": Standard " .. tostring(value) .. " ist keine Option")
		end
	elseif entry.Type == "table" then
		local fields = entry.Fields
		if type(fields) ~= "table" or type(value) ~= "table" then
			table.insert(errors, path .. ": Tabelle + Fields erwartet")
			return
		end
		-- Felder einer Tabellen-Einstellung sind optional (fehlend = aus/Standard)
		for key, sub in pairs(fields) do
			checkValue(errors, path .. "." .. key, sub, value[key], true)
		end
		for key in pairs(value) do
			if type(key) ~= "string" or fields[key] == nil then
				table.insert(errors, path .. "." .. tostring(key) .. ": fehlt im Schema")
			end
		end
	else
		table.insert(errors, path .. ": unbekannter Schema-Typ " .. tostring(entry.Type))
	end
end

local function keyExists(name: string): boolean
	return Enum.KeyCode:FromName(name) ~= nil or Enum.UserInputType:FromName(name) ~= nil
end

local REQUIRED_ACTIONS = {
	"Interact",
	"Terminal",
	"Tower",
	"Shop",
	"Quests",
	"Menu",
	"Sprint",
	"Boost",
	"Handbrake",
	"ChartTf",
	"ChartType",
	"React",
	"AdminPanel",
	"Fly",
	"Spectate",
	"Debug",
	"PhotoMode",
}

function Client.Validate(_config: any): { string }
	local errors: { string } = {}
	local defaults: { [string]: any } = Client.DefaultSettings
	for key, value in pairs(defaults) do
		local entry = schema[key]
		if not entry then
			table.insert(errors, "Config.Client.SettingsSchema." .. key .. ": Eintrag fehlt")
		else
			checkValue(errors, "Config.Client.DefaultSettings." .. key, entry, value, false)
		end
	end
	for key in pairs(schema) do
		if defaults[key] == nil then
			table.insert(errors, "Config.Client.SettingsSchema." .. key .. ": kein Standardwert")
		end
	end
	local keys: { [string]: { string } } = Client.Keys
	for _, action in ipairs(REQUIRED_ACTIONS) do
		if keys[action] == nil then
			table.insert(errors, "Config.Client.Keys." .. action .. ": Aktion fehlt (§C7.5)")
		end
	end
	for action, list in pairs(keys) do
		if type(list) ~= "table" or #list == 0 then
			table.insert(errors, "Config.Client.Keys." .. action .. ": Liste erwartet")
		else
			for _, name in ipairs(list) do
				if type(name) ~= "string" or not keyExists(name) then
					table.insert(errors, "Config.Client.Keys." .. action .. ": unbekannte Taste " .. tostring(name))
				end
			end
		end
	end
	local pad: { [string]: any } = Client.Gamepad
	for action, value in pairs(pad) do
		local list: { any } = if type(value) == "table" then value else { value }
		for _, name in ipairs(list) do
			if type(name) ~= "string" or Enum.KeyCode:FromName(name) == nil then
				table.insert(errors, "Config.Client.Gamepad." .. action .. ": unbekannter Knopf " .. tostring(name))
			end
		end
	end
	local sounds: { [string]: any } = Client.Sounds
	for role, id in pairs(sounds) do
		if not isFinite(id) or id < 0 or id % 1 ~= 0 then
			table.insert(errors, "Config.Client.Sounds." .. role .. ": 0 oder Audio-ID (ganze Zahl) erwartet")
		end
	end
	local pools: { [string]: any } = Client.Pools
	for name, size in pairs(pools) do
		if not isFinite(size) or size < 1 or size % 1 ~= 0 then
			table.insert(errors, "Config.Client.Pools." .. name .. ": ganze Zahl ≥ 1 erwartet")
		end
	end
	if not isFinite(Client.HighlightCap) or Client.HighlightCap < 1 or Client.HighlightCap > 31 then
		table.insert(errors, "Config.Client.HighlightCap: 1..31 erwartet (Roblox-Grenze)")
	end
	if not isFinite(Client.TouchButtonMin) or Client.TouchButtonMin < 44 then
		table.insert(errors, "Config.Client.TouchButtonMin: mindestens 44 px erwartet")
	end
	local touch: { [string]: any } = Client.Touch
	for name, value in pairs(touch) do
		if not isFinite(value) or value <= 0 then
			table.insert(errors, "Config.Client.Touch." .. name .. ": positive Zahl erwartet")
		end
	end
	local auto = Client.AutoReducedFx
	if not isFinite(auto.Fps) or not isFinite(auto.Seconds) or auto.Fps <= 0 or auto.Seconds <= 0 then
		table.insert(errors, "Config.Client.AutoReducedFx: Fps und Seconds > 0 erwartet")
	end
	local move = Client.Movement
	if not isFinite(move.WalkSpeed) or not isFinite(move.SprintSpeed) or move.SprintSpeed < move.WalkSpeed then
		table.insert(errors, "Config.Client.Movement: WalkSpeed ≤ SprintSpeed (Zahlen) erwartet")
	elseif move.SprintSpeed > 32 then
		table.insert(errors, "Config.Client.Movement.SprintSpeed: über Config.Security.BaseAllowedSpeed (32)")
	end
	local hud: { [string]: any } = Client.Hud
	for name, value in pairs(hud) do
		if not isFinite(value) or value <= 0 then
			table.insert(errors, "Config.Client.Hud." .. name .. ": positive Zahl erwartet")
		end
	end
	local splash = Client.Splash
	if
		not isFinite(splash.MinSeconds)
		or not isFinite(splash.LoadedMaxSeconds)
		or not isFinite(splash.HardCapSeconds)
		or splash.MinSeconds > splash.LoadedMaxSeconds
		or splash.LoadedMaxSeconds > 4
		or splash.HardCapSeconds > 12
	then
		table.insert(
			errors,
			"Config.Client.Splash: MinSeconds ≤ LoadedMaxSeconds ≤ 4, HardCapSeconds ≤ 12 erwartet"
		)
	end
	local function imageIdOk(value: any): boolean
		return isFinite(value) and value >= 0 and value % 1 == 0
	end
	if not imageIdOk(splash.ImageId) then
		table.insert(errors, "Config.Client.Splash.ImageId: ganze Zahl ≥ 0 erwartet (0 = Code-Grafik)")
	end
	for name, value in pairs(Client.Icons) do
		if not imageIdOk(value) then
			table.insert(errors, "Config.Client.Icons." .. tostring(name) .. ": ganze Zahl ≥ 0 erwartet (0 = Emoji)")
		end
	end
	return errors
end

return Client
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Companies</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Handelbare Instrumente: 36 Firmen, 7 ETFs, IPO-Pipeline, Übungsaktie (Config.Companies)
--  Besitzer: WP3 (Markt-Engine). Vertrag: DESIGN.md §B6.2 (Tabelle, Lizenz-Sätze, Körbe), §C14.2, §C19 Nr. 1;
--  MARKET.md §4.2. ALLE Firmen sind frei erfunden (keine echten Firmen, Kürzel, Indizes, Personen).
--
--  So änderst du etwas:
--    * Startkurs:   Start in CENT (24000 = 240,00 AKY). Gilt nur, solange es noch keinen Wochenschluss gibt.
--    * Dividende:   DivBps in Basispunkten je Ausschüttung (40 = 0,4 %), 0 = zahlt nicht. Ausschüttung am Quartalstag :19.
--    * Lizenz-Satz: Set = "Azubi" | "Trader" | "Fonds" (ab welcher Lizenz handelbar) – "Tutorial" nur für ACAD (250).
--    * IDs NIE wiederverwenden (1–36 Firmen, 40–46 ETFs, 100–139 IPO-Plätze, 250 ACAD).
--    * Neue IPO-Firma: Eintrag mit Ipo = true, Id 100–139, Season/Slot und in Config.Market.IpoPipeline.Season eintragen.
--  Logo = UI-Form (Letter + Shape in Sektorfarbe), ImageId = 0 -> Code-Grafik (optional eigenes Bild, §C14.3).
--
--  Inhalt:  Companies.Sectors { {Key, Name {de,en}, Color} }   Companies.Instruments { Types.Instrument (+ ImageId,
--           Members bei ETFs, Season/Slot bei IPOs) }   Companies.Baskets { {Key, Name {de,en}, Members {Id}} }
--           Companies.ById[id]  Companies.SectorIndex[key] = 1…6   Companies.Validate(Config): { string }
-- =====================================================================

local Companies = {}

-- ---------------------------------------------------------------------
-- 1) SEKTOREN (Reihenfolge = Sektor-Index 1…6; Farben = Config.Colors.Sectors)
-- ---------------------------------------------------------------------
Companies.Sectors = {
	{ Key = "T", Name = { de = "Tech & KI", en = "Tech & AI" }, Color = Color3.fromRGB(79, 140, 255) },
	{ Key = "E", Name = { de = "Energie & Klima", en = "Energy & Climate" }, Color = Color3.fromRGB(34, 211, 238) },
	{
		Key = "M",
		Name = { de = "Mobilität & Raumfahrt", en = "Mobility & Space" },
		Color = Color3.fromRGB(139, 92, 246),
	},
	{ Key = "K", Name = { de = "Konsum & Food", en = "Consumer & Food" }, Color = Color3.fromRGB(245, 158, 11) },
	{ Key = "G", Name = { de = "Gaming & Medien", en = "Gaming & Media" }, Color = Color3.fromRGB(236, 72, 153) },
	{
		Key = "F",
		Name = { de = "Finanzen & Immobilien", en = "Finance & Real Estate" },
		Color = Color3.fromRGB(250, 204, 21),
	},
}

local SHAPE = { T = "Hex", E = "Circle", M = "Diamond", K = "Circle", G = "Square", F = "Square" }

local function firm(
	id: number,
	ticker: string,
	name: string,
	sector: string,
	class: string,
	startAky: number,
	divPct: number,
	set: string,
	storyDe: string,
	storyEn: string
)
	return {
		Id = id,
		Ticker = ticker,
		Name = name,
		Story = { de = storyDe, en = storyEn },
		Sector = sector,
		Class = class,
		Start = math.round(startAky * 100),
		DivBps = math.round(divPct * 100),
		Set = set,
		Logo = { Letter = string.sub(ticker, 1, 1), Shape = SHAPE[sector] or "Circle" },
		ImageId = 0,
	}
end

-- ---------------------------------------------------------------------
-- 2) DIE 36 FIRMEN (§B6.2; fett geänderte Namen aus §C19: CGVO, KRWK, PFFR)
-- ---------------------------------------------------------------------
-- stylua: ignore start
Companies.Instruments = {
	firm(1, "CGVO", "Cognivo KI", "T", "Normal", 240, 0, "Trader", "Lern-Roboter mit KI", "Learning robots with AI"),
	firm(2, "KRWK", "Kernwerk Systems", "T", "Stabil", 180, 0.4, "Azubi", "Software für Fabriken", "Software for factories"),
	firm(3, "QTRX", "Quantorix Quantum", "T", "Wild", 42, 0, "Fonds", "Quantencomputer, schreibt noch Verluste", "Quantum computers, still loss-making"),
