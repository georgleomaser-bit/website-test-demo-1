        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Texte "evt." (Shared/Lang/Events)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Nur Schlüssel mit Präfix "evt.". Vertrag: DESIGN.md §C15, §B10, §B15.
--  Platzhalter wie string.format (%d Zahl, %s Text); ein Prozentzeichen steht immer als "%%" (Lang.T formatiert).
--  Kurz, ruhig, keine Wett-/Glücksspiel-Wörter (Wortliste §0.7), keine echten Firmen, keine Robux-Beträge.
--  Quiz der Pressekonferenz: evt.quiz.<Id>.q + .a1/.a2/.a3 – die richtige Antwort steht in Config.Events.Press.Quiz.
-- =====================================================================

