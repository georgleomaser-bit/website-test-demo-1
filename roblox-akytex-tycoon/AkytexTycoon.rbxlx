local function innerHalf(footprint: number): number
	return footprint / 2 - 1.4
end

function TowerModels.DecorSlots(room: string, footprint: number?, floor: number?): { Slot }
	local count = ROOM_SLOTS[room] or SLOTS_PER_FLOOR
	count = math.clamp(count, 1, #SLOT_FRACTIONS)
	local h = innerHalf(if finite(footprint) then footprint :: number else SMALL)
	local out: { Slot } = {}
	for i = 1, count do
		local f = SLOT_FRACTIONS[i]
		local x, z = f[1] * h, f[2] * h
		-- EG: Platz 4 (hinten rechts) liegt am Tresor -> etwas zur Mitte rücken
		if floor == 1 and i == 4 then
			x, z = x * 0.6, z * 0.95
		end
		local yaw = if x == 0 and z == 0 then 0 else math.deg(math.atan2(x, z))
		table.insert(out, { X = r3(x), Z = r3(z), Yaw = r3(yaw) })
	end
	return out
end

-- Deko-Lieferant (DecorModels.Specs) – registriert sich beim Laden selbst
local decorProvider: ((key: string) -> { PartSpec })? = nil

function TowerModels.SetDecorProvider(fn: (key: string) -> { PartSpec })
	if type(fn) == "function" then
		decorProvider = fn
	end
end

local function decorSpecs(key: string): { PartSpec }
	if decorProvider == nil then
		pcall(function()
			local here: any = script
			if typeof(here) == "Instance" then
				local module = here.Parent and here.Parent:FindFirstChild("DecorModels")
				if module and module:IsA("ModuleScript") then
					local loader: any = require
					loader(module) -- registriert sich über SetDecorProvider
				end
			end
		end)
	end
	local provider = decorProvider
	if provider == nil then
		return {}
	end
	local ok, result = pcall(provider, key)
	return if ok and type(result) == "table" then result else {}
end

-- Teile einer Spec-Liste an eine Stelle (x, z, yaw) verschieben/drehen
local function transformInto(list: { PartSpec }, source: { PartSpec }, g: Group, extra: Opts?)
	for _, spec in ipairs(source) do
		local o: Opts = {}
		for key, value in pairs(spec :: any) do
			if key ~= "Size" and key ~= "Pos" then
				o[key] = value
			end
		end
		if extra then
			for key, value in pairs(extra) do
				o[key] = value
			end
		end
		put(list, g, spec.Size, spec.Pos[1], spec.Pos[2], spec.Pos[3], spec.Color, spec.Material, o)
	end
end

function TowerModels.Interior(
	room: string,
	level: number,
	staff: { string },
	decor: { string },
	footprint: number?,
	floor: number?
): { PartSpec }
	local key = if ROOM_RECIPES[room] then room else "Office"
	local lv = if finite(level) then math.clamp(math.floor(level), 1, 5) else 1
	local size = if finite(footprint) then math.clamp(footprint :: number, 24, 80) else SMALL
	local floorIndex = if finite(floor) then math.floor(floor :: number) else 2
	local h = innerHalf(size)
	local c: Ctx = {
		List = {},
		H = h,
		Lv = levelLook(lv),
		Level = lv,
		Accent = ROOM_ACCENT[key] or "#4f8cff",
		Lights = 0,
		Floor = floorIndex,
	}
	-- 1) Boden, Deckenlichter, Akzentwand
	floorFinish(c)
	ceilingLights(c, if key == "Lounge" or key == "Penthouse" then "#ffe2c4" else "#e6f0ff")
	put(
		c.List,
		G(0, 0, 0),
		{ h * 2 - 2, 0.25, 0.25 },
		0,
		0.3,
		h - 0.2,
		c.Accent,
		"Neon",
		{ Shadow = false, Transparency = 0.15 }
	)
	-- Aufzugstür (vorn am Kern) – Rahmen + zwei Türflügel
	put(c.List, G(0, 0, 0), { 6.4, 8, 0.3 }, 0, 4, -CORE / 2 - 0.15, "#1f2937", "Metal", { Tag = "ElevatorFrame" })
	put(
		c.List,
		G(0, 0, 0),
		{ 2.4, 7.2, 0.2 },
		-1.2,
		3.6,
		-CORE / 2 - 0.35,
		"#c0c7d4",
		"Metal",
		{ Tag = "ElevatorDoor", Group = "DoorL" }
	)
	put(
		c.List,
		G(0, 0, 0),
		{ 2.4, 7.2, 0.2 },
		1.2,
		3.6,
		-CORE / 2 - 0.35,
		"#c0c7d4",
		"Metal",
		{ Tag = "ElevatorDoor", Group = "DoorR" }
	)
	put(
		c.List,
		G(0, 0, 0),
		{ 4.8, 0.15, 0.2 },
		0,
		7.4,
		-CORE / 2 - 0.4,
		c.Accent,
		"Neon",
		{ Shadow = false, Tag = "ElevatorLight" }
	)
	-- 2) Raum-Möbel nach Stufe (EG: Bereiche am Tresor/Empfang frei lassen)
	for _, place in ipairs(ROOM_RECIPES[key]()) do
		local fn = place[1] :: (Ctx, Group) -> ()
		local fx, fz, yaw = place[2] :: number, place[3] :: number, place[4] :: number
		local minLevel, lobbyOk = place[5] :: number, place[6] :: boolean
		if lv >= minLevel and (floorIndex ~= 1 or lobbyOk) then
			fn(c, G(fx * h, 0, fz * h, yaw))
		end
	end
	-- 3) Personal-Roboter an ihren Arbeitsplätzen
	local spots = STAFF_SPOTS[key] or STAFF_SPOTS_DEFAULT
	for i, staffKey in ipairs(staff) do
		if i > 3 then
			break
		end
		local spot = spots[i]
		if type(staffKey) == "string" and ROBOT_LOOK[staffKey] and spot then
			local robot = TowerModels.Robot(staffKey, spot[1] * h, spot[2] * h, spot[3], "Robot" .. i)
			for _, spec in ipairs(robot) do
				table.insert(c.List, spec)
			end
		end
	end
	-- 4) Deko in den festen Plätzen
	local slots = TowerModels.DecorSlots(key, size, floorIndex)
	for i, decorKey in ipairs(decor) do
		local slot = slots[i]
		if slot and type(decorKey) == "string" and decorKey ~= "" then
			local specs = decorSpecs(decorKey)
			if #specs > 0 then
				transformInto(c.List, specs, G(slot.X, 0, slot.Z, slot.Yaw), { Group = "Decor" .. i })
			end
		end
	end
	-- 5) Budget (≤ 150 Parts): Überschuss am Ende abschneiden (Deko zuletzt, Raum bleibt vollständig)
	while #c.List > MAX_INTERIOR do
		table.remove(c.List)
	end
	return c.List
end

-- ---------------------------------------------------------------------
-- 12) VORSCHAU (ViewportFrames: Willkommen-zurück Vorher/Nachher, Tower-Menü) – ≤ 220 Parts
-- ---------------------------------------------------------------------
function TowerModels.Preview(stage: number, floors: number, skin: string, neon: string, crown: string?): { PartSpec }
	local s = clampStage(stage)
	local count = if finite(floors) then math.clamp(math.floor(floors), 0, FLOORS) else 0
	local list: { PartSpec } = {}
	local pal = TowerModels.Palette(skin, nil)
	local neonHex = TowerModels.NeonHex(neon)
	add(list, { 70, 1, 70 }, { 0, -0.5, 0 }, "#1a2130", "Concrete", { Tag = "Ground" })
	if count <= 0 then
		add(list, { 16, 9, 14 }, { 0, 4.5, 0 }, "#7a4a35", "Brick", { Tag = "Garage" })
		add(list, { 15, 8, 0.4 }, { 0, 4, -7.1 }, "#8b97a8", "CorrodedMetal", { Tag = "RollerDoor" })
		return list
	end
	local look = lookOf(s)
	for _, seg in ipairs(segments(s, count)) do
		local first, last, size = seg[1], seg[2], seg[3]
		local bottom = (first - 1) * FH
		local h = (last - first + 1) * FH
		local body = if s <= 2 then "#c9d2de" elseif s == 3 then "#8a4b32" else pal.Glass
		add(list, { size, h, size }, { 0, bottom + h / 2, 0 }, body, if s <= 3 then "SmoothPlastic" else "Glass", {
			Tag = "Body",
			Transparency = if s <= 3 then 0 else 0.1,
			Reflectance = if s <= 3 then 0 else pal.GlassR,
		})
		if look.Band then
			for f = first, last do
				add(list, { size + 0.8, 0.35, size + 0.8 }, { 0, (f - 1) * FH + 0.5, 0 }, neonHex, "Neon", {
					Tag = "Neon",
					Attr = { Floor = f },
				})
			end
		end
	end
	for _, spec in ipairs(TowerModels.Crown(s, crown or "", count, skin, neon)) do
		local copy = table.clone(spec)
		copy.Pos = { spec.Pos[1], spec.Pos[2] + count * FH, spec.Pos[3] }
		copy.Light = nil
		table.insert(list, copy)
	end
	return list
end

-- ---------------------------------------------------------------------
-- 13) TEILE-BUDGET (§B3: Hülle ≤ 8/Etage, Krone ≤ 60, Plot-Ausstattung ≤ 40; 10 Tower ≤ 4.600)
-- ---------------------------------------------------------------------
function TowerModels.Count(stage: number, floors: number): (number, number, number, number, number)
	local s = clampStage(stage)
	local count = if finite(floors) then math.clamp(math.floor(floors), 0, FLOORS) else 0
	local total, maxFloor = 0, 0
	for f = 1, count do
		local n = #TowerModels.Shell(s, f, DEFAULT_SKIN, "Accent")
		maxFloor = math.max(maxFloor, n)
		total += n
	end
	local spine = #TowerModels.Spine(s, count, DEFAULT_SKIN, "Accent")
	local crown = if count > 0 then #TowerModels.Crown(s, "Orbit", count, DEFAULT_SKIN, "Accent") else 0
	local site = #TowerModels.Site(s, count, DEFAULT_SKIN, "Accent")
	return total + spine + crown + site, maxFloor, spine, crown, site
end

TowerModels.LIMITS = {
	ShellPerFloor = MAX_SHELL_FLOOR,
	Crown = MAX_CROWN,
	Site = MAX_SITE,
	Interior = MAX_INTERIOR,
	TowerTotal = 460,
	AllTowers = 4600,
	LayoutBytes = 2048,
}

-- ---------------------------------------------------------------------
-- 14) LAYOUT-ATTRIBUT (§C12.3): je Etage "Raum:Stufe:Personal:Deko", getrennt durch ";", Privat = Präfix "!"
-- ---------------------------------------------------------------------
function TowerModels.EncodeLayout(floors: { any }, private: { number }?): string
	local privateSet: { [number]: boolean } = {}
	if type(private) == "table" then
		for _, index in ipairs(private) do
			if finite(index) then
				privateSet[math.floor(index)] = true
			end
		end
	end
	local parts: { string } = {}
	for i, floor in ipairs(floors) do
		if i > FLOORS then
			break
		end
		local room = if type(floor) == "table" then floor.R else nil
		local roomCode = ROOM_CODE[room or ""] or ROOM_CODE.Office or "O"
		local level = if type(floor) == "table" and finite(floor.L) then math.clamp(math.floor(floor.L), 1, 5) else 1
		local staff: { string } = {}
		if type(floor) == "table" and type(floor.S) == "table" then
			for _, key in ipairs(floor.S) do
				local code = STAFF_CODE[key]
				if code and #staff < 3 then
					table.insert(staff, code)
				end
			end
		end
		local decor: { string } = {}
		if type(floor) == "table" and type(floor.D) == "table" then
			for slotIndex, key in ipairs(floor.D) do
				if slotIndex > 16 then
					break
				end
				decor[slotIndex] = if type(key) == "string" and DECOR_CODE[key] then DECOR_CODE[key] else ""
			end
			while #decor > 0 and decor[#decor] == "" do
				table.remove(decor)
			end
		end
		local text = ("%s:%d:%s:%s"):format(roomCode, level, table.concat(staff), table.concat(decor, ","))
		if privateSet[i] then
			text = "!" .. text
		end
		parts[i] = text
	end
	return table.concat(parts, ";")
end

function TowerModels.DecodeLayout(text: string): { FloorLayout }
	local out: { FloorLayout } = {}
	if type(text) ~= "string" or text == "" or #text > 4096 then
		return out
	end
	for chunk in string.gmatch(text .. ";", "([^;]*);") do
		if #out >= FLOORS then
			break
		end
		local private = false
		if string.sub(chunk, 1, 1) == "!" then
			private = true
			chunk = string.sub(chunk, 2)
		end
		local roomCode, levelText, staffText, decorText = string.match(chunk, "^(%u?):(%d?):(%u*):([%w,]*)$")
		local entry: FloorLayout = {
			Room = CODE_ROOM[roomCode or ""] or "Office",
			Level = math.clamp(tonumber(levelText) or 1, 1, 5),
			Staff = {},
			Decor = {},
			Private = private,
		}
		if staffText then
			for i = 1, math.min(#staffText, 3) do
				local key = CODE_STAFF[string.sub(staffText, i, i)]
				if key then
					table.insert(entry.Staff, key)
				end
			end
		end
		if decorText and decorText ~= "" then
			local index = 0
			for code in string.gmatch(decorText .. ",", "([^,]*),") do
				index += 1
				if index > 16 then
					break
				end
				entry.Decor[index] = CODE_DECOR[code] or ""
			end
		end
		table.insert(out, entry)
	end
	return out
end

-- ---------------------------------------------------------------------
-- 15) ROBLOX: PartSpec -> BasePart (nur in Roblox aufrufen; Farben/Materialien gecacht)
-- ---------------------------------------------------------------------
local colorCache: { [string]: any } = {}
local materialCache: { [string]: any } = {}

local function colorOf(hex: string): any
	local cached = colorCache[hex]
	if cached then
		return cached
	end
	local r, g, b = TowerModels.Hex(hex)
	local value = (Color3 :: any).fromRGB(r, g, b)
	colorCache[hex] = value
	return value
end

local function materialOf(name: string): any
	local cached = materialCache[name]
	if cached then
		return cached
	end
	local ok, value = pcall(function()
		return ((Enum :: any).Material :: any)[name]
	end)
	local material = if ok and value then value else (Enum :: any).Material.SmoothPlastic
	materialCache[name] = material
	return material
end

function TowerModels.KindOf(spec: PartSpec): string
	if spec.Kind == "Wedge" then
		return "WedgePart"
	elseif spec.Kind == "CornerWedge" then
		return "CornerWedgePart"
	end
	return "Part"
end

local function offsetCFrame(spec: PartSpec): any
	local cf = (CFrame :: any).new(spec.Pos[1], spec.Pos[2], spec.Pos[3])
	local rot = spec.Rot
	if rot then
		cf = cf * (CFrame :: any).fromOrientation(math.rad(rot[1] or 0), math.rad(rot[2] or 0), math.rad(rot[3] or 0))
	end
	return cf
end

TowerModels.OffsetCFrame = offsetCFrame

-- Eigenschaften auf ein (evtl. wiederverwendetes) Part schreiben; origin = CFrame des Bezugspunkts
function TowerModels.Apply(part: any, spec: PartSpec, origin: any)
	if part:IsA("Part") then
		local shape = spec.Shape
		part.Shape = if shape == "Cylinder"
			then (Enum :: any).PartType.Cylinder
			elseif shape == "Ball" then (Enum :: any).PartType.Ball
			else (Enum :: any).PartType.Block
	end
	part.Size = (Vector3 :: any).new(spec.Size[1], spec.Size[2], spec.Size[3])
	part.CFrame = origin * offsetCFrame(spec)
	part.Color = colorOf(spec.Color)
	part.Material = materialOf(spec.Material)
	part.Transparency = spec.Transparency or 0
	part.Reflectance = spec.Reflectance or 0
	part.CanCollide = spec.Collide == true
	part.CanQuery = spec.Query == true or spec.Collide == true
	part.CanTouch = false
	part.CastShadow = spec.Shadow ~= false and (spec.Transparency or 0) < 0.5
	part.Anchored = true
	part.Massless = true
	part.TopSurface = (Enum :: any).SurfaceType.Smooth
	part.BottomSurface = (Enum :: any).SurfaceType.Smooth
	part.Name = spec.Name or spec.Tag or "Part"
	local light = spec.Light
	if light then
		local className = if light.Kind == "Spot"
			then "SpotLight"
			elseif light.Kind == "Surface" then "SurfaceLight"
			else "PointLight"
		local inst = (Instance :: any).new(className)
		inst.Range = light.Range
		inst.Brightness = light.Brightness
		inst.Color = colorOf(light.Color)
		inst.Shadows = false
		if className ~= "PointLight" then
			pcall(function()
				inst.Face = ((Enum :: any).NormalId :: any)[light.Face or "Front"]
				inst.Angle = light.Angle or 60
			end)
		end
		inst.Parent = part
	end
	if spec.Tag then
		part:SetAttribute("Tag", spec.Tag)
	end
	if spec.Group then
		part:SetAttribute("Group", spec.Group)
	end
	if spec.Anim then
		part:SetAttribute("Anim", spec.Anim)
	end
	local attrs = spec.Attr
	if attrs then
		for key, value in pairs(attrs) do
			part:SetAttribute(key, value)
		end
	end
end

function TowerModels.Instantiate(spec: PartSpec, origin: any, parent: any?): any
	local part = (Instance :: any).new(TowerModels.KindOf(spec))
	TowerModels.Apply(part, spec, origin)
	if parent then
		part.Parent = parent
	end
	return part
end

-- ---------------------------------------------------------------------
-- 16) START: in Roblox Config.Tower + Config.Decor übernehmen (Luau-CLI: "script" fehlt -> Startwerte)
-- ---------------------------------------------------------------------
do
	local ok, towerCfg, decorCfg = pcall(function(): (any, any)
		local here: any = script
		if typeof(here) ~= "Instance" then
			return nil, nil
		end
		local configModule = here.Parent and here.Parent:FindFirstChild("Config")
		local function load(name: string): any
			local module = configModule and configModule:FindFirstChild(name)
			if module and module:IsA("ModuleScript") then
				local loaded, result = pcall(require, module)
				return if loaded then result else nil
			end
			return nil
		end
		return load("Tower"), load("Decor")
	end)
	if ok then
		TowerModels.Configure(towerCfg, decorCfg)
	end
end

return TowerModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Gemeinsame Typen (Shared/Types)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C4 (vollständig – alle Pakete annotieren damit).
--  Reines Typ-Modul: gibt eine leere Tabelle zurück, enthält nur "export type".
--  Benutzung:  local Types = require(Shared:WaitForChild("Types"))   ->   Types.Reply, Types.Depot, …
--
--  Abschnitte: Basis · Gewährung (nur Turm-Seite) · Markt · Fortschritt · Turm · Welt/Events
--  Geldbeträge: AKY immer in ganzzahligen Cent, CR ganzzahlig, nie ≥ 9e15 (Config.Server.MaxMoney).
-- =====================================================================

-- ---------------------------------------------------------------------
-- BASIS
-- ---------------------------------------------------------------------
export type Lang = "de" | "en"
export type NotifyKind = "Info" | "Success" | "Error" | "Event" | "Alarm" | "Announce"
export type Reply = { Ok: boolean, Message: string?, [string]: any }
export type PlayerData = { [string]: any } -- Schema §C12
export type LangPair = { de: string, en: string }
export type AssetSlot = { MeshId: number, TextureId: number, Scale: number, Offset: CFrame }

-- ---------------------------------------------------------------------
-- GEWÄHRUNG (nur Turm-Seite! Felder aus Config.Shop.ForbiddenRobuxFields werden bei Robux-Quellen entfernt)
-- ---------------------------------------------------------------------
export type Grant = {
	Credits: number?,
	Cars: { string }?,
	Watches: { string }?,
	Accessories: { string }?,
	Decor: { [string]: number }?,
	Cosmetics: { string }?,
	Titles: { string }?,
	BoostX2: number?,
	BoostX5: number?,
	ExpressTokens: number?,
	InstantTokens: number?,
	SeasonPremium: boolean?,
	SeasonTiers: number?,
	SeasonXp: number?,
}

-- ---------------------------------------------------------------------
-- MARKT
-- ---------------------------------------------------------------------
export type Side = "B" | "S"
export type OrderType = "MKT" | "LMT" | "STP" | "TP" | "OCO" | "TRL"
export type Timeframe = "1s" | "5s" | "1m" | "5m" | "15m" | "1T" | "1W"
export type RiskClass = "Stabil" | "Normal" | "Wild" | "ETF"
export type InstSet = "Azubi" | "Trader" | "Fonds" | "Tutorial"
export type Instrument = {
	Id: number,
	Ticker: string,
	Name: string,
	Story: LangPair,
	Sector: string,
	Class: RiskClass,
	Start: number, -- Cent
	DivBps: number,
	Set: InstSet,
	Logo: { Letter: string, Shape: "Circle" | "Square" | "Hex" | "Diamond" },
	Ipo: boolean?,
}
export type QuoteRow = { Id: number, Flags: number, Close: number, HiOff: number, LoOff: number, Vol: number }
export type Frame = { Version: number, Tick: number, Flags: number, Regime: number, Rows: { QuoteRow } }
export type Candle = { T: number, O: number, H: number, L: number, C: number, V: number } -- Cent, Volumen in 10er-Lots
export type Position = { Q: number, C: number, R: number }
export type Order = {
	Id: number,
	I: number,
	Side: Side,
	Type: OrderType,
	Q: number,
	Lim: number?,
	Stp: number?,
	Tp: number?,
	Trl: number?,
	Peak: number?,
	Oco: number?,
	Res: number,
	Exp: number,
	T0: number,
	Bot: number?,
}
export type Alert = { Id: number, I: number, Px: number, Dir: "Up" | "Down" }
export type BotSlot = { Preset: string, Pct: number, Target: number?, On: boolean, Paused: boolean, DayNav: number }
export type DepotStats = {
	Trades: number,
	Wins: number,
	Losses: number,
	GrossWin: number,
	GrossLoss: number,
	PeakNav: number,
	MaxDD: number,
	BestPct: number,
	ReadWell: number,
}
export type Depot = {
	V: number,
	Cash: number,
	Basis: number,
	Pos: { [string]: Position },
	Short: { [string]: any },
	Orders: { Order },
	Alerts: { Alert },
	Watch: { { number } },
	Fills: { { number } },
	Nav: { { number } },
	Seq: { number },
	NextId: number,
	LastTick: number,
	LastTransferDay: number,
	LastRefillUtcDay: number,
	AutoTransfer: boolean,
	Bots: { BotSlot },
	Stats: DepotStats,
	Tutorial: { T0: number, Q: number, Done: boolean },
}
export type NewsKind =
	"Fact"
	| "Rumor"
	| "Confirm"
	| "Deny"
	| "AsExpected"
	| "Sector"
	| "Macro"
	| "Earnings"
	| "Dividend"
	| "Warn"
	| "Crash"
	| "Rally"
	| "Ipo"
	| "Admin"
	| "Halt"
	| "Resume"
export type NewsItem = {
	Id: number,
	T: number,
	Kind: NewsKind,
	I: number?,
	Sector: string?,
	Key: string,
	Args: { [string]: any },
	Band: number?,
	Stars: number?,
	Dir: number?,
	Text: LangPair?, -- Text nur bei Admin-Eilmeldung (gefiltert)
}
export type CalendarItem = {
	T: number,
	Kind: "Earnings" | "Macro" | "Dividend" | "Crash" | "Rally" | "Ipo",
	I: number?,
	Key: string,
}
export type MarketEvent = {
	Id: string,
	Kind: "Crash"
		| "Rally"
		| "Pump"
		| "Dump"
		| "Halt"
		| "Resume"
		| "Ipo"
		| "News"
		| "Vol"
		| "Normalize"
		| "CancelAutoShow",
	Scope: "All" | "Sector" | "Inst",
	Target: (number | string)?,
	Strength: number,
	Ramp: number,
	Decay: number,
	StartTick: number,
	Until: number,
	Text: LangPair?,
	By: number,
}
export type FillInfo = {
	I: number,
	Side: Side,
	Q: number,
	Px: number,
	Fee: number,
	Pnl: number?,
	HeldS: number?,
	PctNav: number,
	Protected: boolean,
	ReadWell: boolean,
	Bot: boolean,
	Tick: number,
}
export type DayResult = { Day: number, Return: number, Trades: number, Qualifying: boolean, Tainted: boolean }
export type LeagueStats = {
	Week: number,
	SkillScore: number,
	AvgDailyBp: number,
	Trades: number,
	Days: number,
	Tainted: boolean,
	Qualified: boolean,
}

-- ---------------------------------------------------------------------
-- FORTSCHRITT
-- ---------------------------------------------------------------------
export type Licence = {
	Key: string,
	Name: LangPair,
	Xp: number,
	Exam: { string },
	Basis: number,
	BauKurs: number,
	TowerBonus: number,
	FeeBps: number,
	MaxWeight: number,
	MaxOrders: number,
	PosFactor: number,
	Layer: "Simple" | "Trader" | "Pro",
	Set: InstSet,
	MaxStage: number,
	MaxIpo: number,
	BotSlots: number,
}
export type TradingPerks = {
	Licence: number,
	Layer: string,
	BotSlots: number,
	BotLevels: { [string]: number },
	Alerts: number,
	Watchlists: number,
	Layouts: number,
	Monitors: number,
	ResearchLead: number,
	MultiChart: boolean,
	Risk: number,
	Indicators: { [string]: boolean },
}

-- ---------------------------------------------------------------------
-- TURM
-- ---------------------------------------------------------------------
export type FloorData = { R: string, L: number, S: { string }, D: { string } }
export type MultPart = {
	Key: string,
	Value: number,
	Group: "Perm" | "Trader" | "Pass" | "Fixed" | "Timed",
	Source: "Earned" | "Skill" | "Bought" | "Event",
	Until: number?,
}
export type IncomeInfo = { PerSec: number, Steady: number, Mult: number, Parts: { MultPart } }

-- ---------------------------------------------------------------------
-- WELT / EVENTS
-- ---------------------------------------------------------------------
export type PickupToken = { Id: number, Kind: string, Pos: Vector3, Until: number }
export type EventState = {
	Kind: string,
	Started: number,
	Until: number,
	Scope: "Local" | "Global",
	Data: { [string]: any }?,
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Kleine Helfer für Server UND Client (Shared/Util)
--  Besitzer: WP1 (Kern & Plattform). CC-Kopie 1:1 (REUSE §3.1, inkl. FormatNumber-Fix REUSE §7 #33).
--  Reines Modul (keine Roblox-Dienste beim Laden) -> auch mit der Luau-CLI testbar
--  (tests/util.test.luau).
--
--  Öffentliche API (DESIGN.md §C6.1):
--    Util.FormatNumber(n): string          1150 -> "1.15K", math.huge -> "MAX", -0.5 -> "0"
--    Util.FormatTime(seconds): string      "5h 12m" (ab 1 Stunde), sonst "3:07"
--    Util.DeepCopy(v), Util.Reconcile(target, template)
--    Util.WeightedPick(list, weightOf?, rng?): T?   Gewicht 0/NaN/negativ/unendlich wird nie gewählt
--    Util.RateLimiter(maxCalls, perSeconds, clock?)  -> { Check(key): boolean, Clear(key) }
--    Util.TokenBucket(capacity, refillPerSecond, clock?) -> { Take(key, n?): boolean, Clear(key) }
--    Util.IsFinite(n), Util.IsFiniteVector(v)
--    Util.UtcDay(now?), Util.IsoWeek(now?), Util.SetDayOffset(n), Util.GetDayOffset()
--    Util.Snapshot(t): { K }, Util.Hash(s): number (FNV-1a 32 Bit, 0..2^31-1)
--  "clock" ist optional (künstliche Uhr für Tests), Standard os.clock.
-- =====================================================================

local Util = {}

export type RateLimiter = {
	Check: (key: any) -> boolean,
	Clear: (key: any) -> (),
}

export type TokenBucket = {
	Take: (key: any, n: number?) -> boolean,
	Clear: (key: any) -> (),
}

local HUGE = math.huge

-- ---------------------------------------------------------------------
-- 1) ZAHLEN PRÜFEN
-- ---------------------------------------------------------------------

-- true nur für echte, endliche Zahlen (kein NaN, kein ±unendlich, kein String)
function Util.IsFinite(n: any): boolean
	return typeof(n) == "number" and n == n and n ~= HUGE and n ~= -HUGE
end

-- true nur für einen Vector3 mit drei endlichen Komponenten
function Util.IsFiniteVector(v: any): boolean
	if typeof(v) ~= "Vector3" then
		return false
	end
	return Util.IsFinite(v.X) and Util.IsFinite(v.Y) and Util.IsFinite(v.Z)
end

-- ---------------------------------------------------------------------
-- 2) ANZEIGE
-- ---------------------------------------------------------------------
local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
local EPS = 1e-9

-- 1234 -> "1.23K", 15000000 -> "15M" (abgerundet, nie "1000K")
function Util.FormatNumber(n: number): string
	if typeof(n) ~= "number" or n ~= n then
		return "0"
	elseif n == HUGE or n == -HUGE then
		return if n > 0 then "MAX" else "-MAX"
	end
	local negative = n <= -1 -- -0.5 -> "0" statt "-0"
	n = math.abs(n)
	if n < 1000 then
		local s = string.format("%d", math.floor(n + EPS))
		return if negative then "-" .. s else s
	end
	-- Stufe über Vergleiche statt wiederholtem Teilen (sonst wird 1e33 zu "999No")
	local index, scale = 1, 1
	while index < #SUFFIXES and n * (1 + EPS) >= scale * 1000 do
		scale *= 1000
		index += 1
	end
	local v = n / scale
	local text: string
	if v >= 100 then
		-- relativer Puffer (über "Dc" hinaus wird v sehr groß); %.0f: kein Überlauf bei riesigen Zahlen
		text = string.format("%.0f", math.floor(v * (1 + EPS)))
	elseif v >= 10 then
		text = string.format("%.1f", math.floor(v * 10 + EPS) / 10)
	else
		text = string.format("%.2f", math.floor(v * 100 + EPS) / 100)
	end
	if string.find(text, ".", 1, true) then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return (if negative then "-" else "") .. text .. SUFFIXES[index]
end

-- 187 -> "3:07", 18720 -> "5h 12m" (ab einer Stunde ohne Sekunden)
function Util.FormatTime(seconds: number): string
	if not Util.IsFinite(seconds) then
		seconds = 0
	end
	local total = math.clamp(math.floor(seconds), 0, 359999999) -- höchstens 99999h 59m
	local h = math.floor(total / 3600)
	local m = math.floor((total % 3600) / 60)
	local s = total % 60
	if h > 0 then
		return string.format("%dh %dm", h, m)
	end
	return string.format("%d:%02d", m, s)
end

-- ---------------------------------------------------------------------
-- 3) TABELLEN
-- ---------------------------------------------------------------------
function Util.DeepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value :: any) do
		copy[k] = Util.DeepCopy(v)
	end
	return copy :: any
end

-- Ergänzt fehlende Felder aus "template" (für Spielstände nach Updates).
function Util.Reconcile(target: { [any]: any }, template: { [any]: any })
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = Util.DeepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" then
			Util.Reconcile(target[k], v)
		end
	end
end

-- Liste der Schlüssel (zum sicheren Durchlaufen, während die Tabelle sich ändert)
function Util.Snapshot<K, V>(t: { [K]: V }): { K }
	local keys: { any } = {}
	local count = 0
	for k in pairs(t :: any) do
		count += 1
		keys[count] = k
	end
	return keys :: any
end

-- ---------------------------------------------------------------------
-- 4) ZUFALL
-- ---------------------------------------------------------------------

-- Gewichtete Zufallsauswahl: list = { {Weight = 5, ...}, ... } oder eigene weightOf-Funktion.
-- Einträge mit Gewicht 0 (oder NaN/negativ/unendlich) werden NIE gewählt.
-- Haben alle Einträge Gewicht 0 (oder ist die Liste leer) -> nil.
function Util.WeightedPick<T>(list: { T }, weightOf: ((T) -> number)?, rng: Random?): T?
	local function weight(item: T): number
		local raw: any
		if weightOf then
			local ok, result = pcall(weightOf, item)
			raw = if ok then result else 0
		elseif type(item) == "table" then
			raw = (item :: any).Weight
		end
		local w = tonumber(raw) or 0
		if not Util.IsFinite(w) or w < 0 then
			return 0
		end
		return w
	end
	local total = 0
	local lastPositive: T? = nil
	for _, item in ipairs(list) do
		local w = weight(item)
		total += w
		if w > 0 then
			lastPositive = item
		end
	end
	if total <= 0 or not Util.IsFinite(total) then
		return nil
	end
	local random: any = rng or Random.new()
	local roll = random:NextNumber() * total
	for _, item in ipairs(list) do
		local w = weight(item)
		if w > 0 then
			roll -= w
			if roll <= 0 then
				return item
			end
		end
	end
	-- Rundungsfehler: letzter Eintrag mit Gewicht > 0
	return lastPositive
end

-- ---------------------------------------------------------------------
-- 5) SPAM-BREMSEN
-- ---------------------------------------------------------------------

-- Gleitendes Fenster pro Schlüssel (meist der Player): höchstens maxCalls in perSeconds.
-- PlayerRemoving: limiter.Clear(player) (sonst hält die Tabelle den Player fest)
function Util.RateLimiter(maxCalls: number, perSeconds: number, clock: (() -> number)?): RateLimiter
	local limit = math.max(1, math.floor(if Util.IsFinite(maxCalls) then maxCalls else 1))
	local window = if Util.IsFinite(perSeconds) then math.max(0, perSeconds) else 1
	local now: () -> number = clock or os.clock
	local buckets: { [any]: { number } } = {}

	local limiter = {}
	function limiter.Check(key: any): boolean
		local t = now()
		local bucket = buckets[key]
		if not bucket then
			bucket = {}
			buckets[key] = bucket
		end
		-- alte Einträge vorne entfernen (höchstens #bucket <= limit Durchläufe)
		while bucket[1] ~= nil and t - bucket[1] >= window do
			table.remove(bucket, 1)
		end
		if #bucket >= limit then
			return false
		end
		table.insert(bucket, t)
		return true
	end
	function limiter.Clear(key: any)
		buckets[key] = nil
	end
	return limiter
end

-- Token-Eimer pro Schlüssel: startet voll (capacity), füllt refillPerSecond Marken pro Sekunde nach.
-- Take(key, n) nimmt n Marken (Standard 1), wenn genug da sind.
function Util.TokenBucket(capacity: number, refillPerSecond: number, clock: (() -> number)?): TokenBucket
	local cap = if Util.IsFinite(capacity) then math.max(0, capacity) else 1
	local rate = if Util.IsFinite(refillPerSecond) then math.max(0, refillPerSecond) else 0
	local now: () -> number = clock or os.clock
	local tokens: { [any]: number } = {}
	local stamps: { [any]: number } = {}

	local bucket = {}
	function bucket.Take(key: any, n: number?): boolean
		local amount = if n == nil then 1 else n
		if not Util.IsFinite(amount) or amount < 0 then
			return false
		end
		local t = now()
		local have = tokens[key]
		if have == nil then
			have = cap
		else
			local elapsed = math.max(0, t - (stamps[key] or t))
			have = math.min(cap, have + elapsed * rate)
		end
		stamps[key] = t
		if have >= amount then
			tokens[key] = have - amount
			return true
		end
		tokens[key] = have
		return false
	end
	function bucket.Clear(key: any)
		tokens[key] = nil
		stamps[key] = nil
	end
	return bucket
end

-- ---------------------------------------------------------------------
-- 6) DATUM (UTC) – Tages-/Wochenindex für Quests, Login, Bestenlisten
-- ---------------------------------------------------------------------
local dayOffset = 0 -- nur Debug (Studio, Admin "SkipDay")

-- Tage seit 1970-01-01 -> (Jahr, Monat, Tag) (Algorithmus von H. Hinnant, ohne os.date)
local function civilFromDays(days: number): (number, number, number)
	local z = days + 719468
	local era = math.floor(z / 146097)
	local doe = z - era * 146097
	local yoe = math.floor((doe - math.floor(doe / 1460) + math.floor(doe / 36524) - math.floor(doe / 146096)) / 365)
	local doy = doe - (365 * yoe + math.floor(yoe / 4) - math.floor(yoe / 100))
	local mp = math.floor((5 * doy + 2) / 153)
	local d = doy - math.floor((153 * mp + 2) / 5) + 1
	local m = if mp < 10 then mp + 3 else mp - 9
	local y = yoe + era * 400 + (if m <= 2 then 1 else 0)
	return y, m, d
end

-- (Jahr, Monat, Tag) -> Tage seit 1970-01-01
local function daysFromCivil(year: number, month: number, day: number): number
	local y = year - (if month <= 2 then 1 else 0)
	local era = math.floor(y / 400)
	local yoe = y - era * 400
	local mp = (month + 9) % 12
	local doy = math.floor((153 * mp + 2) / 5) + day - 1
	local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
	return era * 146097 + doe - 719468
end

-- UTC-Tagesindex: floor(os.time() / 86400) + DayOffset. UtcDay(0) == 0 (ohne Offset).
function Util.UtcDay(now: number?): number
	local t = if Util.IsFinite(now) then now :: number else os.time()
	return math.floor(t / 86400) + dayOffset
end

-- ISO-Woche als Zahl JJJJWW (Montag = Wochenstart, Woche 1 enthält den ersten Donnerstag).
-- Beispiel: 2026-10-11 -> 202641. Der Debug-Tagesversatz zählt mit.
function Util.IsoWeek(now: number?): number
	local day = Util.UtcDay(now)
	local weekday = ((day + 3) % 7) + 1 -- 1 = Montag … 7 = Sonntag (1970-01-01 war ein Donnerstag)
	local thursday = day - weekday + 4
	local year = civilFromDays(thursday)
	local week = math.floor((thursday - daysFromCivil(year, 1, 1)) / 7) + 1
	return year * 100 + week
end

-- Nur Debug (Studio): verschiebt UtcDay/IsoWeek um n Tage (geklemmt auf ±10 Jahre)
function Util.SetDayOffset(n: number)
	if Util.IsFinite(n) then
		dayOffset = math.clamp(math.floor(n), -3650, 3650)
	end
end

function Util.GetDayOffset(): number
	return dayOffset
end

-- ---------------------------------------------------------------------
-- 7) HASH – deterministisch (z. B. Shard = Util.Hash(game.JobId) % 8)
-- ---------------------------------------------------------------------

-- FNV-1a 32 Bit, auf 0..2^31-1 begrenzt
function Util.Hash(s: string): number
	local text = if type(s) == "string" then s else tostring(s)
	local h = 2166136261
	for i = 1, #text do
		h = bit32.bxor(h, string.byte(text, i))
		-- h * 16777619 mod 2^32 ohne Genauigkeitsverlust: 16777619 = 2^24 + 403
		h = (bit32.lshift(h, 24) + h * 403) % 4294967296
	end
	return bit32.band(h, 0x7FFFFFFF)
end

return Util
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">VehicleModels</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Auto-Baupläne aus Parts (Shared/VehicleModels)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §C6.2 (VehicleModels.Build/Recipes), §B12.1 (Bau:
--  VehicleSeat, 4 Räder als Zylinder mit HingeConstraint-Motor, Servo-Lenkung, SpringConstraint-Federung, Neon-
--  Unterbodenlicht im Licht-Budget), §A4 (Autos aus Wedge/Zylinder), §C14.3 (Asset-Platz der Karosserie).
--  Gleiche Baupläne auf Server (fahrbare Autos, Showroom) und Client (Garage-Vorschau, Enthüllung) – deterministisch.
--
--  Koordinaten im Modell: Ursprung = Boden-Mitte zwischen den Achsen, vorn = −Z (LookVector), rechts = +X, oben = +Y.
--  Benannte Teile: "Chassis" (PrimaryPart, unsichtbar, Masse), "Seat" (VehicleSeat), "Body" (Kollision mit der Welt),
--  "Wheel_FL/FR/RL/RR" (Zylinder, Achse = +X). Attribute an Teilen: Paint (Lack), Rim, Glow, Spoiler, Light.
--  Unterbodenlicht: PointLight "Underglow" im Chassis, Attribut "Budget" (WorldLook schaltet es im Licht-Budget ein).
--
--  Öffentliche API:
--    VehicleModels.Recipes: { [string]: Recipe }                  Baupläne (Config.Vehicles.Cars[i].Recipe)
--    VehicleModels.Build(key, paint?, rims?, glow?): Model        statisches, verankertes Modell (Pivot = Boden-Mitte)
--    VehicleModels.ApplyTune(model, key, tune?)                   Lack/Felgen/Unterbodenlicht/Spoiler live ändern
--    VehicleModels.Rig(model, key): Rig                           Server: Schweißnähte, Federbeine, Motoren, Servo-Lenkung
--    VehicleModels.WHEEL_SIGN                                     Vorzeichen: vorwärts = WHEEL_SIGN × v / r (rad/s)
--  Rig-Felder: Chassis, Seat, Wheels { FL, FR, RL, RR }, Motors { FL, FR, RL, RR } (HingeConstraint), Steer { FL, FR }
--    (HingeConstraint Servo), Springs, Downforce (VectorForce), Mass, WheelRadius
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = script.Parent
local Config = require(Shared:WaitForChild("Config")) :: any

local VehicleModels = {}

export type Recipe = {
	L: number, -- Länge
	W: number, -- Breite
	H: number, -- Karosserie-Höhe (ohne Kabine)
	Clear: number, -- Bodenfreiheit
	WheelR: number,
	WheelW: number,
	Base: number, -- Radstand
	Track: number, -- Rad-Mitte seitlich
	Nose: number, -- Länge Front-Keil
	Tail: number, -- Länge Heck-Keil
	CabinF: number, -- Kabine vorn (z, negativ = vorn)
	CabinR: number, -- Kabine hinten (z)
	CabinH: number,
	Inset: number, -- Kabine seitlich eingerückt
	Shield: number, -- Länge Frontscheibe
	Rear: number, -- Länge Heckscheibe
	Spoiler: boolean, -- Standard-Spoiler (Tuning schaltet um)
	Fins: boolean?,
	Scoops: boolean?,
	Canopy: boolean?, -- Kuppel-Kabine (Hyper)
	Lights: string, -- "Dual" | "Slim" | "Bar"
	Neon: Color3, -- Akzentlinie
	Grille: string?, -- "Chrome" | nil
}

export type Rig = {
	Chassis: BasePart,
	Seat: VehicleSeat,
	Wheels: { [string]: BasePart },
	Motors: { [string]: HingeConstraint },
	Steer: { [string]: HingeConstraint },
	Springs: { SpringConstraint },
	Downforce: VectorForce,
	Mass: number,
	WheelRadius: number,
}

VehicleModels.WHEEL_SIGN = -1 -- Drehung um +X (rechts): oben nach hinten = vorwärts -> negativ

local ACCENT = Color3.fromRGB(79, 140, 255)
local CYAN = Color3.fromRGB(34, 211, 238)
local UP = Color3.fromRGB(34, 197, 94)
local DOWN = Color3.fromRGB(239, 68, 68)
local COSMIC = Color3.fromRGB(179, 107, 255)
local VIOLET = Color3.fromRGB(124, 92, 255)
local WARN = Color3.fromRGB(234, 179, 8)

local TIRE = Color3.fromRGB(22, 23, 27)
local TRIM = Color3.fromRGB(26, 28, 33)
local GLASS = Color3.fromRGB(14, 20, 32)
local CHROME = Color3.fromRGB(214, 220, 228)
local HEAD = Color3.fromRGB(235, 242, 255)
local TAIL = Color3.fromRGB(239, 48, 56)

local WHEELS = { "FL", "FR", "RL", "RR" }

-- ---------------------------------------------------------------------
-- 1) BAUPLÄNE (16 Autos, je eigene Silhouette)
-- ---------------------------------------------------------------------
-- stylua: ignore start
VehicleModels.Recipes = {
	LamCity = { L = 12, W = 6.2, H = 2.0, Clear = 0.8, WheelR = 1.25, WheelW = 1.0, Base = 7.6, Track = 2.65, Nose = 2.0,
		Tail = 1.0, CabinF = -2.6, CabinR = 4.4, CabinH = 2.3, Inset = 0.45, Shield = 1.7, Rear = 0.8, Spoiler = false,
		Lights = "Dual", Neon = ACCENT },
	VoltaHatch = { L = 12.4, W = 6.3, H = 2.0, Clear = 0.75, WheelR = 1.28, WheelW = 1.05, Base = 7.8, Track = 2.7, Nose = 2.2,
		Tail = 1.1, CabinF = -2.4, CabinR = 4.5, CabinH = 2.2, Inset = 0.45, Shield = 1.9, Rear = 0.9, Spoiler = true,
		Lights = "Slim", Neon = CYAN },
	PixelMini = { L = 10.8, W = 6.0, H = 2.1, Clear = 0.8, WheelR = 1.2, WheelW = 1.0, Base = 7.0, Track = 2.55, Nose = 1.6,
		Tail = 0.7, CabinF = -2.0, CabinR = 4.0, CabinH = 2.45, Inset = 0.35, Shield = 1.2, Rear = 0.5, Spoiler = false,
		Lights = "Dual", Neon = COSMIC },
	LamNeon = { L = 12.2, W = 6.3, H = 1.95, Clear = 0.7, WheelR = 1.28, WheelW = 1.05, Base = 7.7, Track = 2.7, Nose = 2.2,
		Tail = 1.0, CabinF = -2.4, CabinR = 4.4, CabinH = 2.2, Inset = 0.45, Shield = 1.8, Rear = 0.9, Spoiler = true,
		Lights = "Bar", Neon = VIOLET },
	Stratos = { L = 15, W = 6.8, H = 2.1, Clear = 0.8, WheelR = 1.35, WheelW = 1.1, Base = 9.4, Track = 2.95, Nose = 3.2,
		Tail = 2.6, CabinF = -2.6, CabinR = 3.4, CabinH = 2.2, Inset = 0.5, Shield = 1.9, Rear = 1.7, Spoiler = false,
		Lights = "Slim", Neon = ACCENT },
	Nordlicht = { L = 16, W = 7.0, H = 2.3, Clear = 0.85, WheelR = 1.4, WheelW = 1.15, Base = 10.2, Track = 3.05, Nose = 3.6,
		Tail = 2.8, CabinF = -2.8, CabinR = 4.0, CabinH = 2.3, Inset = 0.5, Shield = 2.0, Rear = 1.8, Spoiler = false,
		Lights = "Slim", Neon = CYAN, Grille = "Chrome" },
	VelocitraS = { L = 14.6, W = 7.0, H = 1.7, Clear = 0.6, WheelR = 1.4, WheelW = 1.2, Base = 9.0, Track = 3.0, Nose = 4.0,
		Tail = 2.0, CabinF = -1.6, CabinR = 2.8, CabinH = 1.75, Inset = 0.6, Shield = 2.3, Rear = 2.0, Spoiler = true,
		Lights = "Slim", Neon = DOWN },
	NeonCoupe = { L = 14.8, W = 7.0, H = 1.75, Clear = 0.6, WheelR = 1.4, WheelW = 1.2, Base = 9.1, Track = 3.0, Nose = 4.0,
		Tail = 2.2, CabinF = -1.8, CabinR = 3.0, CabinH = 1.75, Inset = 0.6, Shield = 2.2, Rear = 2.2, Spoiler = false,
		Lights = "Bar", Neon = ACCENT },
	StreakGT = { L = 15, W = 7.2, H = 1.7, Clear = 0.6, WheelR = 1.42, WheelW = 1.25, Base = 9.2, Track = 3.1, Nose = 4.2,
		Tail = 2.0, CabinF = -1.4, CabinR = 2.8, CabinH = 1.7, Inset = 0.65, Shield = 2.3, Rear = 1.8, Spoiler = true,
		Lights = "Bar", Neon = WARN },
	Kometa = { L = 15.6, W = 7.4, H = 1.5, Clear = 0.5, WheelR = 1.45, WheelW = 1.3, Base = 9.4, Track = 3.15, Nose = 4.6,
		Tail = 2.2, CabinF = -0.9, CabinR = 2.8, CabinH = 1.55, Inset = 0.8, Shield = 2.4, Rear = 1.7, Spoiler = true,
		Scoops = true, Lights = "Slim", Neon = CYAN },
	AuroraGT = { L = 16, W = 7.4, H = 1.55, Clear = 0.5, WheelR = 1.45, WheelW = 1.3, Base = 9.6, Track = 3.15, Nose = 4.8,
		Tail = 2.4, CabinF = -1.0, CabinR = 3.0, CabinH = 1.55, Inset = 0.8, Shield = 2.5, Rear = 1.9, Spoiler = false,
		Scoops = true, Lights = "Bar", Neon = UP },
	QuasarX = { L = 16.4, W = 7.6, H = 1.35, Clear = 0.45, WheelR = 1.5, WheelW = 1.35, Base = 9.8, Track = 3.25, Nose = 5.0,
		Tail = 2.4, CabinF = -0.6, CabinR = 2.8, CabinH = 1.45, Inset = 1.4, Shield = 2.6, Rear = 1.6, Spoiler = true,
		Fins = true, Scoops = true, Canopy = true, Lights = "Bar", Neon = COSMIC },
	VelocitraH = { L = 16.2, W = 7.6, H = 1.4, Clear = 0.45, WheelR = 1.5, WheelW = 1.35, Base = 9.7, Track = 3.25, Nose = 5.2,
		Tail = 2.2, CabinF = -0.8, CabinR = 2.6, CabinH = 1.45, Inset = 1.0, Shield = 2.6, Rear = 1.5, Spoiler = true,
		Scoops = true, Lights = "Slim", Neon = DOWN },
	Singularity = { L = 16.6, W = 7.6, H = 1.3, Clear = 0.45, WheelR = 1.5, WheelW = 1.35, Base = 9.9, Track = 3.25, Nose = 5.4,
		Tail = 2.6, CabinF = -0.4, CabinR = 2.8, CabinH = 1.4, Inset = 1.5, Shield = 2.6, Rear = 1.6, Spoiler = true,
		Fins = true, Scoops = true, Canopy = true, Lights = "Bar", Neon = VIOLET },
	OrbitR = { L = 16.2, W = 7.5, H = 1.35, Clear = 0.45, WheelR = 1.5, WheelW = 1.35, Base = 9.7, Track = 3.2, Nose = 5.0,
		Tail = 2.4, CabinF = -0.6, CabinR = 2.6, CabinH = 1.45, Inset = 1.4, Shield = 2.5, Rear = 1.6, Spoiler = false,
		Fins = true, Scoops = true, Canopy = true, Lights = "Bar", Neon = CYAN },
	Lam1 = { L = 16.8, W = 7.6, H = 1.3, Clear = 0.42, WheelR = 1.52, WheelW = 1.38, Base = 10.0, Track = 3.25, Nose = 5.6,
		Tail = 2.4, CabinF = -0.4, CabinR = 2.6, CabinH = 1.4, Inset = 1.5, Shield = 2.7, Rear = 1.5, Spoiler = true,
		Fins = true, Scoops = true, Canopy = true, Lights = "Bar", Neon = ACCENT },
}
-- stylua: ignore end

-- ---------------------------------------------------------------------
-- 2) HELFER
-- ---------------------------------------------------------------------
local function carEntry(key: string): any?
	local vehicles = Config.Vehicles
	if type(vehicles) ~= "table" or type(vehicles.Car) ~= "function" then
		return nil
	end
	return vehicles.Car(key)
end

local function option(kind: string, key: string?): any?
	local vehicles = Config.Vehicles
	if type(vehicles) ~= "table" or type(vehicles.Option) ~= "function" or type(key) ~= "string" then
		return nil
	end
	return vehicles.Option(kind, key)
end

local function recipeOf(key: string): Recipe
	local car = carEntry(key)
	local recipeKey = if car and type(car.Recipe) == "string" then car.Recipe else key
	local recipe = (VehicleModels.Recipes :: any)[recipeKey]
	if recipe == nil then
		recipe = VehicleModels.Recipes.LamCity
	end
	return recipe :: Recipe
end

type PartOpts = {
	Shape: Enum.PartType?,
	Wedge: boolean?,
	Transparency: number?,
	Reflectance: number?,
	Collide: boolean?,
	Shadow: boolean?,
	Attr: string?,
	AttrValue: any?,
}

local function makePart(
	model: Model,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material,
	opts: PartOpts?
): BasePart
	local o: PartOpts = opts or {}
	local part: BasePart
	if o.Wedge then
		part = Instance.new("WedgePart")
	else
		local p = Instance.new("Part")
		p.Shape = o.Shape or Enum.PartType.Block
		part = p
	end
	part.Name = name
	part.Size = Vector3.new(math.max(0.05, size.X), math.max(0.05, size.Y), math.max(0.05, size.Z))
	part.CFrame = cf
	part.Color = color
	part.Material = material
	part.Transparency = o.Transparency or 0
	part.Reflectance = o.Reflectance or 0
	part.Anchored = true
	part.CanCollide = o.Collide == true
	part.CanTouch = false
	part.CanQuery = o.Collide == true
	part.CastShadow = o.Shadow ~= false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if o.Attr then
		part:SetAttribute(o.Attr, if o.AttrValue ~= nil then o.AttrValue else true)
	end
	part.Parent = model
	return part
end

local function paintColor(paintKey: string?): (Color3, boolean)
	local paint = option("Paint", paintKey)
	if paint and typeof(paint.Color) == "Color3" then
		return paint.Color, paint.Metallic == true
	end
	return Color3.fromRGB(232, 235, 240), false
end

-- ---------------------------------------------------------------------
-- 3) KAROSSERIE (Rezept) – wird durch einen gesetzten Asset-Platz ersetzt
-- ---------------------------------------------------------------------
local function buildBody(model: Model, r: Recipe)
	local paint = Color3.new(1, 1, 1) -- echte Farbe setzt ApplyTune
	local top = r.Clear + r.H
	local mainLen = r.L - r.Nose - r.Tail
	local mainZ = (r.Nose - r.Tail) / 2
	local frontZ = -r.L / 2
	local rearZ = r.L / 2

	-- Wanne (kollidiert mit der Welt)
	makePart(
		model,
		"Body",
		Vector3.new(r.W, r.H, mainLen),
		CFrame.new(0, r.Clear + r.H / 2, mainZ),
		paint,
		Enum.Material.SmoothPlastic,
		{ Collide = true, Attr = "Paint" }
	)
	-- Front: Stoßfänger-Block + Motorhaube als Keil (niedrig vorn)
	local bumperH = r.H * 0.48
	makePart(
		model,
		"Bumper",
		Vector3.new(r.W - 0.1, bumperH, r.Nose),
		CFrame.new(0, r.Clear + bumperH / 2, frontZ + r.Nose / 2),
		paint,
		Enum.Material.SmoothPlastic,
		{ Collide = true, Attr = "Paint" }
	)
	makePart(
		model,
		"Hood",
		Vector3.new(r.W - 0.1, r.H - bumperH, r.Nose),
		CFrame.new(0, r.Clear + bumperH + (r.H - bumperH) / 2, frontZ + r.Nose / 2),
		paint,
		Enum.Material.SmoothPlastic,
		{ Wedge = true, Attr = "Paint" }
	)
	-- Heck: Block + Keil (niedrig hinten)
	local tailH = r.H * 0.62
	makePart(
		model,
		"TailBlock",
		Vector3.new(r.W - 0.1, tailH, r.Tail),
		CFrame.new(0, r.Clear + tailH / 2, rearZ - r.Tail / 2),
		paint,
		Enum.Material.SmoothPlastic,
		{ Collide = true, Attr = "Paint" }
	)
	makePart(
		model,
		"Deck",
		Vector3.new(r.W - 0.1, r.H - tailH, r.Tail),
		CFrame.new(0, r.Clear + tailH + (r.H - tailH) / 2, rearZ - r.Tail / 2) * CFrame.Angles(0, math.pi, 0),
		paint,
		Enum.Material.SmoothPlastic,
		{ Wedge = true, Attr = "Paint" }
	)

	-- Kabine
	local cabinW = r.W - 2 * r.Inset
	local coreLen = math.max(0.4, (r.CabinR - r.CabinF) - r.Shield - r.Rear)
	local coreZ = r.CabinF + r.Shield + coreLen / 2
	local cabinY = top + r.CabinH / 2
	if r.Canopy then
		-- Kuppel aus Glas (SpecialMesh Sphere, ellipsoid) + Lackrücken
		local canopy = makePart(
			model,
			"Canopy",
			Vector3.new(1, 1, 1),
			CFrame.new(0, top + 0.05, (r.CabinF + r.CabinR) / 2),
			GLASS,
			Enum.Material.Glass,
			{ Transparency = 0.2, Reflectance = 0.4 }
		)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.new(cabinW, r.CabinH * 2, r.CabinR - r.CabinF)
		mesh.Parent = canopy
		makePart(
			model,
			"Spine",
			Vector3.new(cabinW * 0.5, r.CabinH * 0.6, r.Rear + 1.2),
			CFrame.new(0, top + r.CabinH * 0.3, r.CabinR + (r.Rear + 1.2) / 2 - 0.6) * CFrame.Angles(0, math.pi, 0),
			paint,
			Enum.Material.SmoothPlastic,
			{ Wedge = true, Attr = "Paint" }
		)
	else
		makePart(
			model,
			"Windshield",
			Vector3.new(cabinW, r.CabinH, r.Shield),
			CFrame.new(0, cabinY, r.CabinF + r.Shield / 2),
			GLASS,
			Enum.Material.Glass,
			{ Wedge = true, Transparency = 0.2, Reflectance = 0.35 }
		)
		makePart(
			model,
			"Cabin",
			Vector3.new(cabinW, r.CabinH, coreLen),
			CFrame.new(0, cabinY, coreZ),
			GLASS,
			Enum.Material.Glass,
			{ Transparency = 0.25, Reflectance = 0.35 }
		)
		makePart(
			model,
			"RearWindow",
			Vector3.new(cabinW, r.CabinH, r.Rear),
			CFrame.new(0, cabinY, r.CabinR - r.Rear / 2) * CFrame.Angles(0, math.pi, 0),
			GLASS,
			Enum.Material.Glass,
			{ Wedge = true, Transparency = 0.2, Reflectance = 0.35 }
		)
		makePart(
			model,
			"Roof",
			Vector3.new(cabinW + 0.08, 0.22, coreLen + 0.15),
			CFrame.new(0, top + r.CabinH + 0.11, coreZ),
			paint,
			Enum.Material.SmoothPlastic,
			{ Attr = "Paint" }
		)
		for _, side in ipairs({ -1, 1 }) do
			makePart(
				model,
				if side < 0 then "PillarL" else "PillarR",
				Vector3.new(0.12, r.CabinH, 0.45),
				CFrame.new(side * (cabinW / 2 + 0.03), cabinY, coreZ),
				paint,
				Enum.Material.SmoothPlastic,
				{ Attr = "Paint", Shadow = false }
			)
		end
	end

	-- Spiegel, Schweller, Lufteinlässe, Finnen
	for _, side in ipairs({ -1, 1 }) do
		local suffix = if side < 0 then "L" else "R"
		makePart(
			model,
			"Mirror" .. suffix,
			Vector3.new(0.5, 0.32, 0.36),
			CFrame.new(side * (r.W / 2 + 0.15), top + 0.25, r.CabinF + r.Shield * 0.55),
			paint,
			Enum.Material.SmoothPlastic,
			{ Attr = "Paint", Shadow = false }
		)
		makePart(
			model,
			"Skirt" .. suffix,
			Vector3.new(0.3, 0.32, r.Base - 2 * r.WheelR - 0.4),
			CFrame.new(side * (r.W / 2 + 0.05), r.Clear + 0.16, 0),
			TRIM,
			Enum.Material.SmoothPlastic,
			{ Shadow = false }
		)
		-- Akzentlinie (Neon nur als 0,2-Stud-Streifen)
		makePart(
			model,
			"Accent" .. suffix,
			Vector3.new(0.06, 0.12, mainLen * 0.9),
			CFrame.new(side * (r.W / 2 + 0.03), r.Clear + r.H * 0.55, mainZ),
			r.Neon,
			Enum.Material.Neon,
			{ Shadow = false }
		)
		if r.Scoops then
			makePart(
				model,
				"Scoop" .. suffix,
				Vector3.new(0.4, r.H * 0.6, 1.8),
				CFrame.new(side * (r.W / 2 + 0.05), r.Clear + r.H * 0.45, r.CabinR - 0.3) * CFrame.Angles(0, math.pi, 0),
				TRIM,
				Enum.Material.SmoothPlastic,
				{ Wedge = true, Shadow = false }
			)
		end
		if r.Fins then
			makePart(
				model,
				"Fin" .. suffix,
				Vector3.new(0.15, r.CabinH * 0.9, 1.8),
				CFrame.new(side * (r.W / 2 - 0.9), top + r.CabinH * 0.45, rearZ - 1.4) * CFrame.Angles(0, math.pi, 0),
				paint,
				Enum.Material.SmoothPlastic,
				{ Wedge = true, Attr = "Paint" }
			)
		end
	end

	-- Kühlergrill
	makePart(
		model,
		"Grille",
		Vector3.new(r.W * 0.46, bumperH * 0.55, 0.12),
		CFrame.new(0, r.Clear + bumperH * 0.42, frontZ - 0.04),
		if r.Grille == "Chrome" then CHROME else TRIM,
		if r.Grille == "Chrome" then Enum.Material.Metal else Enum.Material.SmoothPlastic,
		{ Reflectance = if r.Grille == "Chrome" then 0.4 else 0, Shadow = false }
	)
end

-- Lichter (immer aus Code – auch zu einem Mesh-Körper)
local function buildLights(model: Model, r: Recipe)
	local frontZ = -r.L / 2
	local rearZ = r.L / 2
	local headY = r.Clear + r.H * 0.42
	if r.Lights == "Bar" then
		makePart(
			model,
			"HeadBar",
			Vector3.new(r.W * 0.86, 0.14, 0.12),
			CFrame.new(0, headY, frontZ - 0.05),
			HEAD,
			Enum.Material.Neon,
			{ Attr = "Light", AttrValue = "Head", Shadow = false }
		)
	else
		local w = if r.Lights == "Slim" then r.W * 0.22 else r.W * 0.16
		local h = if r.Lights == "Slim" then 0.16 else 0.3
		for _, side in ipairs({ -1, 1 }) do
			makePart(
				model,
				if side < 0 then "HeadL" else "HeadR",
				Vector3.new(w, h, 0.14),
				CFrame.new(side * r.W * 0.33, headY, frontZ - 0.05),
				HEAD,
				Enum.Material.Neon,
				{ Attr = "Light", AttrValue = "Head", Shadow = false }
			)
		end
	end
	makePart(
		model,
		"TailLight",
		Vector3.new(r.W * 0.82, 0.16, 0.12),
		CFrame.new(0, r.Clear + r.H * 0.62 * 0.82, rearZ + 0.05),
		TAIL,
		Enum.Material.Neon,
		{ Attr = "Light", AttrValue = "Tail", Shadow = false }
	)
	-- Auspuff
	for _, side in ipairs({ -1, 1 }) do
		makePart(
			model,
			if side < 0 then "ExhaustL" else "ExhaustR",
			Vector3.new(0.6, 0.34, 0.34),
			CFrame.new(side * r.W * 0.28, r.Clear + 0.2, rearZ + 0.15) * CFrame.Angles(0, math.rad(90), 0),
			CHROME,
			Enum.Material.Metal,
			{ Shape = Enum.PartType.Cylinder, Reflectance = 0.3, Shadow = false }
		)
	end
end

local function buildSpoiler(model: Model, r: Recipe)
	local top = r.Clear + r.H
	local rearZ = r.L / 2
	local wingY = top + math.max(0.8, r.CabinH * 0.55)
	local wingZ = rearZ - r.Tail * 0.45
	makePart(
		model,
		"Wing",
		Vector3.new(r.W * 0.92, 0.14, 1.1),
		CFrame.new(0, wingY, wingZ) * CFrame.Angles(math.rad(-6), 0, 0),
		Color3.new(1, 1, 1),
		Enum.Material.SmoothPlastic,
		{ Attr = "Spoiler", Shadow = false }
	):SetAttribute("Paint", true)
	for _, side in ipairs({ -1, 1 }) do
		makePart(
			model,
			if side < 0 then "WingStrutL" else "WingStrutR",
			Vector3.new(0.14, wingY - top, 0.35),
			CFrame.new(side * r.W * 0.3, top + (wingY - top) / 2, wingZ + 0.1),
			TRIM,
			Enum.Material.SmoothPlastic,
			{ Attr = "Spoiler", Shadow = false }
		)
	end
end

local function buildWheels(model: Model, r: Recipe)
	for _, key in ipairs(WHEELS) do
		local front = string.sub(key, 1, 1) == "F"
		local side = if string.sub(key, 2, 2) == "L" then -1 else 1
		local center = CFrame.new(side * r.Track, r.WheelR, if front then -r.Base / 2 else r.Base / 2)
		local wheel = makePart(
			model,
			"Wheel_" .. key,
			Vector3.new(r.WheelW, r.WheelR * 2, r.WheelR * 2),
			center,
			TIRE,
			Enum.Material.SmoothPlastic,
			{ Shape = Enum.PartType.Cylinder, Collide = true, Attr = "Wheel", AttrValue = key }
		)
		local outer = side * (r.WheelW / 2 + 0.02)
		local rim = makePart(
			model,
			"Rim_" .. key,
			Vector3.new(0.16, r.WheelR * 1.36, r.WheelR * 1.36),
			center * CFrame.new(outer, 0, 0),
			CHROME,
			Enum.Material.Metal,
			{ Shape = Enum.PartType.Cylinder, Attr = "Rim", Shadow = false }
		)
		rim:SetAttribute("WheelOf", key)
		local spoke = makePart(
			model,
			"Spoke_" .. key,
			Vector3.new(0.1, r.WheelR * 1.25, 0.28),
			center * CFrame.new(outer + side * 0.06, 0, 0),
			TRIM,
			Enum.Material.SmoothPlastic,
			{ Attr = "Spoke", Shadow = false }
		)
		spoke:SetAttribute("WheelOf", key)
		local hub = makePart(
			model,
			"Hub_" .. key,
			Vector3.new(0.12, r.WheelR * 0.4, r.WheelR * 0.4),
			center * CFrame.new(outer + side * 0.1, 0, 0),
			TRIM,
			Enum.Material.Metal,
			{ Shape = Enum.PartType.Cylinder, Shadow = false }
		)
		hub:SetAttribute("WheelOf", key)
		wheel:SetAttribute("Radius", r.WheelR)
	end
end

local function buildGlow(model: Model, r: Recipe, chassis: BasePart)
	local mainLen = r.L - r.Nose - r.Tail
	makePart(
		model,
		"GlowStrip",
		Vector3.new(r.W * 0.7, 0.08, mainLen),
		CFrame.new(0, r.Clear - 0.06, (r.Nose - r.Tail) / 2),
		ACCENT,
		Enum.Material.Neon,
		{ Attr = "Glow", Shadow = false }
	)
	local light = Instance.new("PointLight")
	light.Name = "Underglow"
	light.Range = 12
	light.Brightness = 2
	light.Shadows = false
	light.Enabled = false -- WorldLook schaltet im Licht-Budget (Attribut "Budget")
	light:SetAttribute("Budget", true)
	light:SetAttribute("NoShadow", true) -- sitzt in der Karosserie: mit Schatten bliebe der Boden dunkel
	light.Parent = chassis
end

-- ---------------------------------------------------------------------
-- 4) ÖFFENTLICH: Build / ApplyTune
-- ---------------------------------------------------------------------
local assetSlot: any = false
local function getAssetSlot(): any?
	if assetSlot == false then
		local module = ReplicatedStorage:FindFirstChild("Shared")
		local found = module and module:FindFirstChild("AssetSlot")
		local ok, result = false, nil
		if found and found:IsA("ModuleScript") then
			ok, result = pcall(require, found)
		end
		assetSlot = if ok and type(result) == "table" then result else nil
	end
	return assetSlot
end

function VehicleModels.Build(key: string, paint: string?, rims: string?, glow: string?): Model
	local r = recipeOf(key)
	local car = carEntry(key)
	local model = Instance.new("Model")
	model.Name = if car then car.Key else tostring(key)

	-- Chassis (Masse, unsichtbar) + Sitz
	local chassis = makePart(
		model,
		"Chassis",
		Vector3.new(r.W - 1.2, 0.8, r.Base + 1.2),
		CFrame.new(0, r.WheelR, 0),
		TRIM,
		Enum.Material.SmoothPlastic,
		{ Transparency = 1, Shadow = false }
	)
	-- Drehpunkt des Modells = Bodenmitte (PrimaryPart-Pivot, sonst sinkt das Auto beim PivotTo um WheelR ein)
	chassis.PivotOffset = CFrame.new(0, -r.WheelR, 0)
	model.PrimaryPart = chassis
	local seat = Instance.new("VehicleSeat")
	seat.Name = "Seat"
	seat.Size = Vector3.new(1.8, 0.4, 1.8)
	seat.CFrame = CFrame.new(-r.W * 0.2, r.Clear + 0.75, (r.CabinF + r.CabinR) / 2 + 0.3)
	seat.Transparency = 1
	seat.Anchored = true
	seat.CanCollide = false
	seat.CanQuery = false
	seat.CanTouch = false -- Einsteigen nur über den Server (Prompt), nie durch Berühren
	seat.HeadsUpDisplay = false
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.Parent = model

	-- Karosserie: Asset-Platz (Mesh) oder Rezept
	local slot = if car then car.Asset else nil
	local built = false
	local AssetSlot = getAssetSlot()
	if AssetSlot and slot and AssetSlot.IsSet(slot) then
		local ok, result = pcall(AssetSlot.Mesh, "Vehicles." .. model.Name, slot, function(): Instance
			local recipeModel = Instance.new("Model")
			recipeModel.Name = "Recipe"
			return recipeModel
		end)
		if ok and typeof(result) == "Instance" and result.Name ~= "Recipe" then
			for _, child in ipairs(result:GetDescendants()) do
				if child:IsA("BasePart") then
					child.Anchored = true
					child.CanCollide = false
					child.CanTouch = false
					child:SetAttribute("Paint", true)
					child.Parent = model
				end
			end
			result:Destroy()
			-- Kollisionswanne bleibt Rezept-Form (unsichtbar)
			local hull = makePart(
				model,
				"Body",
				Vector3.new(r.W, r.H, r.L - r.Nose - r.Tail),
				CFrame.new(0, r.Clear + r.H / 2, (r.Nose - r.Tail) / 2),
				TRIM,
				Enum.Material.SmoothPlastic,
				{ Collide = true, Transparency = 1, Shadow = false }
			)
			hull:SetAttribute("Hull", true)
			built = true
		elseif ok and typeof(result) == "Instance" then
			result:Destroy()
		end
	end
	if not built then
		buildBody(model, r)
	end
	buildLights(model, r)
	buildSpoiler(model, r)
	buildWheels(model, r)
	buildGlow(model, r, chassis)

	model:SetAttribute("Car", model.Name)
	model:SetAttribute("Class", if car then car.Class else "Kompakt")
	model:SetAttribute("WheelR", r.WheelR)
	model.WorldPivot = CFrame.identity
	VehicleModels.ApplyTune(model, model.Name, {
		Paint = paint,
		Rims = rims,
		Glow = glow,
		Spoiler = nil,
	})
	return model
end

-- tune = { Paint?, Rims?, Glow?, Spoiler? } – fehlende Felder: Standard des Autos
function VehicleModels.ApplyTune(model: Model, key: string, tune: { [string]: any }?)
	if typeof(model) ~= "Instance" then
		return
	end
	local t: { [string]: any } = tune or {}
	local car = carEntry(key)
	local r = recipeOf(key)
	local paintKey = if type(t.Paint) == "string" and option("Paint", t.Paint)
		then t.Paint
		elseif car then car.Paint
		else "Polar"
	local color, metallic = paintColor(paintKey)
	local rim = option("Rims", t.Rims) or option("Rims", "Stock")
	local glowEntry = option("Glow", t.Glow)
	local glowOn = glowEntry ~= nil
	local spoilerOn = if type(t.Spoiler) == "boolean" then t.Spoiler else r.Spoiler

	for _, part in ipairs(model:GetDescendants()) do
		if not part:IsA("BasePart") then
			continue
		end
		if part:GetAttribute("Paint") == true and part:GetAttribute("Hull") ~= true then
			part.Color = color
			part.Material = Enum.Material.SmoothPlastic -- Lack: glatt, Metallic = stärkere Spiegelung (Future-Licht)
			part.Reflectance = if metallic then 0.32 else 0.12
		end
		if part:GetAttribute("Rim") == true and rim then
			part.Color = rim.Color
			part.Material = if rim.Style == "Neon" then Enum.Material.Neon else Enum.Material.Metal
			part.Reflectance = if rim.Style == "Neon" then 0 else 0.3
		end
		if part:GetAttribute("Spoke") == true and rim then
			part.Transparency = if rim.Style == "Disc" then 1 else 0
			part.Color = if rim.Style == "Neon" then rim.Color else TRIM
			part.Material = if rim.Style == "Neon" then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
		if part:GetAttribute("Glow") == true then
			part.Transparency = if glowOn then 0 else 1
			if glowEntry then
				part.Color = glowEntry.Color
			end
		end
		if part:GetAttribute("Spoiler") == true then
			part.Transparency = if spoilerOn then 0 else 1
		end
	end
	local chassis = model:FindFirstChild("Chassis")
	local light = chassis and chassis:FindFirstChild("Underglow")
	if light and light:IsA("PointLight") then
		light:SetAttribute("Budget", glowOn)
		if glowEntry then
			light.Color = glowEntry.Color
		end
		if not glowOn then
			light.Enabled = false
		end
	end
	model:SetAttribute("Paint", paintKey)
	model:SetAttribute("Rims", if rim then rim.Key else "Stock")
	model:SetAttribute("Glow", if glowEntry then glowEntry.Key else "Off")
	model:SetAttribute("Spoiler", spoilerOn)
end

-- ---------------------------------------------------------------------
-- 5) RIG (Server): Schweißen, Federbeine (Prismatic + Spring), Servo-Lenkung, Rad-Motoren
-- ---------------------------------------------------------------------
local function axisAttachment(
	parent: BasePart,
	worldCf: CFrame,
	axis: Vector3,
	secondary: Vector3,
	name: string
): Attachment
	local att = Instance.new("Attachment")
	att.Name = name
	att.Parent = parent -- erst einhängen, dann Welt-Lage setzen (WorldCFrame braucht den Träger)
	local x = axis.Unit
	local y = secondary.Unit
	local z = x:Cross(y)
	att.WorldCFrame = CFrame.fromMatrix(worldCf.Position, x, y, z)
	return att
end

local function physical(density: number, friction: number, weight: number): PhysicalProperties
	return PhysicalProperties.new(density, friction, 0, weight, 1)
end

function VehicleModels.Rig(model: Model, key: string): Rig
	local r = recipeOf(key)
	local vehicles = Config.Vehicles or {}
	local phys = vehicles.Physics or {}
	local chassis = model:FindFirstChild("Chassis") :: BasePart
	local seat = model:FindFirstChild("Seat") :: VehicleSeat
	assert(chassis and seat, "VehicleModels.Rig: Chassis/Seat fehlt")
	local right = chassis.CFrame.RightVector
	local up = chassis.CFrame.UpVector
	local forward = chassis.CFrame.LookVector

	chassis.CustomPhysicalProperties = physical(phys.ChassisDensity or 2.2, 0.3, 1)

	-- Räder + Rad-Anbauteile sammeln
	local wheels: { [string]: BasePart } = {}
	for _, key2 in ipairs(WHEELS) do
		local wheel = model:FindFirstChild("Wheel_" .. key2)
		if wheel and wheel:IsA("BasePart") then
			wheels[key2] = wheel
		end
	end
	for _, part in ipairs(model:GetDescendants()) do
		if not part:IsA("BasePart") or part == chassis then
			continue
		end
		local wheelOf = part:GetAttribute("WheelOf")
		local isWheel = part:GetAttribute("Wheel") ~= nil
		if isWheel then
			continue
		end
		local target: BasePart = chassis
		if type(wheelOf) == "string" and wheels[wheelOf] then
			target = wheels[wheelOf]
		end
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = target
		weld.Part1 = part
		weld.Parent = part
		part.Massless = true
	end

	-- Masse: Chassis-Baugruppe + Räder
	local mass = chassis:GetMass()
	for _, wheel in pairs(wheels) do
		wheel.CustomPhysicalProperties =
			physical(phys.WheelDensity or 0.9, phys.FrontFriction or 1.7, phys.FrictionWeight or 4)
		mass += wheel:GetMass()
	end
	local gravity = workspace.Gravity
	local corner = mass / 4
	local compression = phys.SpringCompression or 0.45
	local stiffness = corner * gravity / math.max(0.05, compression)
	local damping = 2 * (phys.SpringDampingRatio or 0.55) * math.sqrt(stiffness * corner)
	local travel = phys.SpringTravel or 0.9
	local springTop = 2.2

	local motors: { [string]: HingeConstraint } = {}
	local steer: { [string]: HingeConstraint } = {}
	local springs: { SpringConstraint } = {}
	local baseTorque = (phys.TorqueFactor or 1.4) * corner * gravity * r.WheelR

	for wheelKey, wheel in pairs(wheels) do
		local front = string.sub(wheelKey, 1, 1) == "F"
		local center = wheel.CFrame
		-- Federbein
		local strut = Instance.new("Part")
		strut.Name = "Strut_" .. wheelKey
		strut.Size = Vector3.new(0.4, 0.4, 0.4)
		strut.CFrame = CFrame.fromMatrix(center.Position, right, up)
		strut.Transparency = 1
		strut.CanCollide = false
		strut.CanQuery = false
		strut.CanTouch = false
		strut.CastShadow = false
		strut.CustomPhysicalProperties = physical(phys.PartDensity or 0.05, 0.3, 1)
		strut.Parent = model

		local slideA = axisAttachment(chassis, center, up, -right, "SlideA_" .. wheelKey)
		local slideB = axisAttachment(strut, center, up, -right, "SlideB_" .. wheelKey)
		local slider = Instance.new("PrismaticConstraint")
		slider.Name = "Slide_" .. wheelKey
		slider.Attachment0 = slideA
		slider.Attachment1 = slideB
		slider.LimitsEnabled = true
		slider.LowerLimit = -travel
		slider.UpperLimit = travel
		slider.Restitution = 0
		slider.Parent = strut

		local springA =
			axisAttachment(chassis, center * CFrame.new(0, springTop, 0), up, -right, "SpringA_" .. wheelKey)
		local springB = axisAttachment(strut, center, up, -right, "SpringB_" .. wheelKey)
		local spring = Instance.new("SpringConstraint")
		spring.Name = "Spring_" .. wheelKey
		spring.Attachment0 = springA
		spring.Attachment1 = springB
		spring.Stiffness = stiffness
		spring.Damping = damping
		spring.FreeLength = springTop + compression -- Vorspannung: kein Durchhängen in Ruhelage
		spring.Visible = false
		spring.Parent = strut
		table.insert(springs, spring)

		-- Lenkung (vorn): Achsschenkel per Servo um die Hochachse
		local hub: BasePart = strut
		if front then
			local knuckle = Instance.new("Part")
			knuckle.Name = "Knuckle_" .. wheelKey
			knuckle.Size = Vector3.new(0.4, 0.4, 0.4)
			knuckle.CFrame = CFrame.fromMatrix(center.Position, right, up)
			knuckle.Transparency = 1
			knuckle.CanCollide = false
			knuckle.CanQuery = false
			knuckle.CanTouch = false
			knuckle.CastShadow = false
			knuckle.CustomPhysicalProperties = physical(phys.PartDensity or 0.05, 0.3, 1)
			knuckle.Parent = model
			local steerA = axisAttachment(strut, center, up, forward, "SteerA_" .. wheelKey)
			local steerB = axisAttachment(knuckle, center, up, forward, "SteerB_" .. wheelKey)
			local servo = Instance.new("HingeConstraint")
			servo.Name = "Steer_" .. wheelKey
			servo.Attachment0 = steerA
			servo.Attachment1 = steerB
			servo.ActuatorType = Enum.ActuatorType.Servo
			servo.ServoMaxTorque = mass * gravity * 40
			servo.AngularSpeed = phys.SteerSpeed or 7
			servo.AngularResponsiveness = 60
			servo.TargetAngle = 0
			servo.LimitsEnabled = true
			servo.LowerAngle = -(phys.SteerMax or 34) - 2
			servo.UpperAngle = (phys.SteerMax or 34) + 2
			servo.Parent = knuckle
			steer[wheelKey] = servo
			hub = knuckle
		end

		-- Rad-Motor um die Querachse (+X = rechts)
		local driveA = axisAttachment(hub, center, right, up, "DriveA_" .. wheelKey)
		local driveB = axisAttachment(wheel, center, right, up, "DriveB_" .. wheelKey)
		local motor = Instance.new("HingeConstraint")
		motor.Name = "Motor_" .. wheelKey
		motor.Attachment0 = driveA
		motor.Attachment1 = driveB
		motor.ActuatorType = Enum.ActuatorType.Motor
		motor.MotorMaxTorque = baseTorque * (phys.CoastTorque or 0.08)
		motor.MotorMaxAcceleration = 400
		motor.AngularVelocity = 0
		motor.Parent = wheel
		motors[wheelKey] = motor
		if not front then
			wheel.CustomPhysicalProperties =
				physical(phys.WheelDensity or 0.9, phys.RearFriction or 1.5, phys.FrictionWeight or 4)
		end
	end

	-- Anpressdruck (Client setzt die Kraft je nach Tempo)
	local forceAttachment = Instance.new("Attachment")
	forceAttachment.Name = "ForceAttachment"
	forceAttachment.Parent = chassis
	local downforce = Instance.new("VectorForce")
	downforce.Name = "Downforce"
	downforce.Attachment0 = forceAttachment
	downforce.RelativeTo = Enum.ActuatorRelativeTo.World
	downforce.ApplyAtCenterOfMass = true
	downforce.Force = Vector3.zero
	downforce.Parent = chassis

	-- alles ins Kollisionsgruppen-System, dann lösen
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CollisionGroup = "Cars"
			part.Anchored = false
		end
	end
	model:SetAttribute("Mass", mass)
	model:SetAttribute("BaseTorque", baseTorque)
	return {
		Chassis = chassis,
		Seat = seat,
		Wheels = wheels,
		Motors = motors,
		Steer = steer,
		Springs = springs,
		Downforce = downforce,
		Mass = mass,
		WheelRadius = r.WheelR,
	}
end

return VehicleModels
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="59">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="60">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="61">
        <Properties>
          <string name="Name">Lib</string>
        </Properties>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Scheduler</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Der EINE Server-Takt (Server/Lib/Scheduler)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C5.1 (CC-Kopie 1:1, normales Modul, per require).
--  Muss-Regel 11: keine while-Schleife pro Spieler – alle Takte laufen hier über EINEN
--  RunService.Heartbeat-Anschluss.
--
--  Öffentliche API:
--    Scheduler.Every(name, hz, fn(dt))                       fn hz-mal pro Sekunde
--    Scheduler.EveryFrame(name, fn(dt))                      fn jeden Frame
--    Scheduler.Staggered(name, hz, items(), fn(item, dt))    verteilt die Items über die Frames,
--                                                            jedes Item hz-mal pro Sekunde
--    Scheduler.Stats(): { [name]: { AvgMs, MaxMs } }         Kosten pro Aufruf-Frame (Fenster 5 s),
--                                                            dazu "_Total" = ganzer Heartbeat-Schritt
--  Jede Funktion gibt zusätzlich eine Stopp-Funktion zurück (optional zu benutzen).
--
--  Regeln:
--    * jeder Callback läuft in pcall; Fehler höchstens alle 10 s pro Name im Output
--    * Frame-dt wird auf 0..0.25 s geklemmt (Hänger erzeugen keine Riesen-Sprünge).
--      Every/Staggered bekommen die (geklemmte) Zeit seit ihrem letzten Lauf, höchstens
--      max(0.25, 2 / hz) – ein 1-Hz-Takt bekommt also ~1.0 s.
--    * Callbacks dürfen NICHT yielden (task.wait usw.). Tut einer es doch, wird er bis zur
--      Rückkehr übersprungen und es gibt eine Warnung – die anderen Takte laufen weiter.
--    * Doppelter Name -> eindeutiger Name mit "#2", "#3" … (Warnung)
-- =====================================================================

local RunService = game:GetService("RunService")

local Scheduler = {}

export type Stat = { AvgMs: number, MaxMs: number }

type Job = {
	Name: string,
	Kind: "Every" | "Frame" | "Staggered",
	Interval: number, -- Sekunden zwischen zwei Läufen (Every) bzw. Ziel-Periode pro Item (Staggered)
	MaxDt: number,
	Acc: number,
	Since: number, -- Zeit seit dem letzten Lauf (Every)
	Fn: (...any) -> (),
	-- Staggered
	Items: (() -> { any })?,
	List: { any },
	Cursor: number,
	Budget: number,
	LastT: { [any]: number },
	-- Zustand
	Busy: boolean,
	Stopped: boolean,
	LastError: number,
	LastYieldWarn: number,
	-- Statistik (laufendes Fenster + zuletzt abgeschlossenes Fenster)
	SumMs: number,
	Count: number,
	MaxMs: number,
	Published: Stat?,
}

local MAX_FRAME_DT = 0.25
local ERROR_LOG_EVERY = 10
local STATS_WINDOW = 5
local MAX_JOBS = 200 -- Obergrenze (Schutz vor Endlos-Registrierung)

local jobs: { Job } = {}
local usedNames: { [string]: number } = {}
local connection: RBXScriptConnection? = nil
local frameId = 0
local needsCompact = false

local total = { SumMs = 0, Count = 0, MaxMs = 0, Published = nil :: Stat? }
local windowStart = os.clock()

local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function logError(job: Job, err: any)
	local now = os.clock()
	if now - job.LastError >= ERROR_LOG_EVERY then
		job.LastError = now
		warn(("[Scheduler] Fehler in %s: %s"):format(job.Name, tostring(err)))
	end
end

local function warnYield(job: Job)
	local now = os.clock()
	if now - job.LastYieldWarn >= ERROR_LOG_EVERY then
		job.LastYieldWarn = now
		warn(
			("[Scheduler] %s hat geyieldet (task.wait o. ä.) – wird bis zur Rückkehr übersprungen"):format(
				job.Name
			)
		)
	end
end

-- Einen Callback sicher aufrufen. Gibt false zurück, wenn er (noch) nicht fertig ist (yield).
local function call(job: Job, ...: any): boolean
	job.Busy = true
	local myFrame = frameId
	local ok, err = pcall(job.Fn, ...)
	job.Busy = false
	if not ok then
		logError(job, err)
	end
	-- Hat der Callback geyieldet, ist inzwischen ein neuer Frame gelaufen
	return myFrame == frameId
end

-- Staggered: eine Runde neu beginnen (frische Item-Liste, Zeitstempel nur für aktuelle Items behalten)
local function refreshList(job: Job)
	local getter = job.Items
	local list: { any } = {}
	if getter then
		local ok, result = pcall(getter)
		if ok and type(result) == "table" then
			list = result
		elseif not ok then
			logError(job, result)
		end
	end
	local snapshot = table.create(#list)
	local lastT: { [any]: number } = {}
	for i, item in ipairs(list) do
		snapshot[i] = item
		if item ~= nil then
			lastT[item] = job.LastT[item]
		end
	end
	job.List = snapshot
	job.LastT = lastT
	job.Cursor = 1
end

local function runStaggered(job: Job, dt: number, now: number): boolean
	if job.Cursor > #job.List then
		refreshList(job)
	end
	local count = #job.List
	if count == 0 then
		job.Budget = 0
		return true
	end
	-- n Items × hz pro Sekunde -> Anteil dieses Frames; nie mehr als die ganze Liste pro Frame
	job.Budget = math.min(job.Budget + count * dt / job.Interval, count)
	local steps = math.floor(job.Budget)
	job.Budget -= steps
	for _ = 1, steps do
		if job.Cursor > #job.List then
			refreshList(job)
			if #job.List == 0 then
				break
			end
		end
		local item = job.List[job.Cursor]
		job.Cursor += 1
		if item ~= nil then
			local last = job.LastT[item]
			local itemDt = if last then math.clamp(now - last, 0, job.MaxDt) else job.Interval
			job.LastT[item] = now
			if not call(job, item, itemDt) then
				return false
			end
		end
	end
	return true
end

local function compact()
	needsCompact = false
	local kept: { Job } = {}
	for _, job in ipairs(jobs) do
		if not job.Stopped then
			table.insert(kept, job)
		end
	end
	jobs = kept
end

local function record(target: { SumMs: number, Count: number, MaxMs: number }, ms: number)
	target.SumMs += ms
	target.Count += 1
	if ms > target.MaxMs then
		target.MaxMs = ms
	end
end

local function publishWindow()
	for _, job in ipairs(jobs) do
		if job.Count > 0 then
			job.Published = { AvgMs = job.SumMs / job.Count, MaxMs = job.MaxMs }
		end
		job.SumMs, job.Count, job.MaxMs = 0, 0, 0
	end
	if total.Count > 0 then
		total.Published = { AvgMs = total.SumMs / total.Count, MaxMs = total.MaxMs }
	end
	total.SumMs, total.Count, total.MaxMs = 0, 0, 0
end

local function onHeartbeat(rawDt: number)
	frameId += 1
	local myFrame = frameId
	local dt = math.clamp(if finite(rawDt) then rawDt else 0, 0, MAX_FRAME_DT)
	local frameStart = os.clock()
	local count = #jobs
	for i = 1, count do
		if frameId ~= myFrame then
			return -- dieser Frame hat geyieldet und wurde von neueren Frames überholt
		end
		local job = jobs[i]
		if job == nil or job.Stopped then
			continue
		end
		if job.Busy then
			warnYield(job)
			continue
		end
		local started = os.clock()
		local ran = false
		local finished = true
		if job.Kind == "Frame" then
			ran = true
			finished = call(job, dt)
		elseif job.Kind == "Every" then
			job.Acc += dt
			job.Since += dt
			if job.Acc >= job.Interval then
				local jobDt = math.min(job.Since, job.MaxDt)
				job.Since = 0
				-- Rest behalten (gleichmäßiger Takt), aber nie mehr als eine Periode Rückstand
				job.Acc = math.min(job.Acc - job.Interval, job.Interval)
				ran = true
				finished = call(job, jobDt)
			end
		else
			ran = true
			finished = runStaggered(job, dt, started)
		end
		if not finished then
			return
		end
		if ran then
			record(job, (os.clock() - started) * 1000)
		end
	end
	record(total, (os.clock() - frameStart) * 1000)
	if needsCompact then
		compact()
	end
	if frameStart - windowStart >= STATS_WINDOW then
		windowStart = frameStart
		publishWindow()
	end
end

local function uniqueName(name: string): string
	local base = if type(name) == "string" and name ~= "" then name else "Unbenannt"
	local used = usedNames[base]
	if used == nil then
		usedNames[base] = 1
		return base
	end
	used += 1
	usedNames[base] = used
	local result = base .. "#" .. used
	warn(("[Scheduler] Name %s doppelt registriert -> %s"):format(base, result))
	return result
end

local function ensureConnected()
	if connection == nil then
		connection = RunService.Heartbeat:Connect(onHeartbeat)
	end
end

local function add(job: Job): () -> ()
	if #jobs >= MAX_JOBS then
		warn("[Scheduler] Zu viele Takte – " .. job.Name .. " wird ignoriert")
		return function() end
	end
	table.insert(jobs, job)
	ensureConnected()
	return function()
		if not job.Stopped then
			job.Stopped = true
			needsCompact = true
		end
	end
end

local function newJob(name: string, kind: "Every" | "Frame" | "Staggered", hz: number, fn: (...any) -> ()): Job
	local rate = if finite(hz) and hz > 0 then hz else 1
	local interval = 1 / rate
	return {
		Name = uniqueName(name),
		Kind = kind,
		Interval = interval,
		MaxDt = math.max(MAX_FRAME_DT, 2 * interval),
		Acc = 0,
		Since = 0,
		Fn = fn,
		Items = nil,
		List = {},
		Cursor = 1,
		Budget = 0,
		LastT = {},
		Busy = false,
		Stopped = false,
		LastError = -math.huge,
		LastYieldWarn = -math.huge,
		SumMs = 0,
		Count = 0,
		MaxMs = 0,
		Published = nil,
	}
end

-- fn(dt) hz-mal pro Sekunde (z. B. Markt 1 Hz, StateFlush 5 Hz, Auto-Save 1/90 Hz)
function Scheduler.Every(name: string, hz: number, fn: (dt: number) -> ()): () -> ()
	assert(type(fn) == "function", "Scheduler.Every: fn fehlt")
	return add(newJob(name, "Every", hz, fn :: any))
end

-- fn(dt) jeden Frame (z. B. Hüllen-Bau, Backfill mit ms-Budget)
function Scheduler.EveryFrame(name: string, fn: (dt: number) -> ()): () -> ()
	assert(type(fn) == "function", "Scheduler.EveryFrame: fn fehlt")
	return add(newJob(name, "Frame", 60, fn :: any))
end

-- Verteilt die Items über die Frames: jedes Item wird hz-mal pro Sekunde mit fn(item, dt) bearbeitet.
-- items() wird zu Beginn jeder Runde neu gefragt (Schnappschuss – Änderungen während der Runde sind egal).
function Scheduler.Staggered<T>(name: string, hz: number, items: () -> { T }, fn: (item: T, dt: number) -> ()): () -> ()
	assert(type(items) == "function", "Scheduler.Staggered: items fehlt")
	assert(type(fn) == "function", "Scheduler.Staggered: fn fehlt")
	local job = newJob(name, "Staggered", hz, fn :: any)
	job.Items = items :: any
	return add(job)
end

-- Kosten pro Takt (Millisekunden pro Frame, in dem er lief). "_Total" = gesamter Heartbeat-Schritt.
function Scheduler.Stats(): { [string]: Stat }
	local result: { [string]: Stat } = {}
	for _, job in ipairs(jobs) do
		if not job.Stopped then
			local published = job.Published
			if published then
				result[job.Name] = { AvgMs = published.AvgMs, MaxMs = published.MaxMs }
			elseif job.Count > 0 then
				result[job.Name] = { AvgMs = job.SumMs / job.Count, MaxMs = job.MaxMs }
			else
				result[job.Name] = { AvgMs = 0, MaxMs = 0 }
			end
		end
	end
	local published = total.Published
	if published then
		result._Total = { AvgMs = published.AvgMs, MaxMs = published.MaxMs }
	elseif total.Count > 0 then
		result._Total = { AvgMs = total.SumMs / total.Count, MaxMs = total.MaxMs }
	else
		result._Total = { AvgMs = 0, MaxMs = 0 }
	end
	return result
end

return Scheduler
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="63">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Server-Start (Server/Main)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C3 (CC-Lader 1:1, Präfix "[AKYTEX Tycoon] ").
--  Lädt alle Services in der richtigen Reihenfolge. Hier musst du nichts ändern.
--    Remotes zuerst (Clients warten darauf)
--    Phase 1: alle require (xpcall, FindFirstChild – kein Warten)
--    Vorladen: gesetzte Mesh-Asset-Plätze (§C14.3) nach ReplicatedStorage.AssetCache (nur wenn Ids ≠ 0, ≤ 12 s)
--    Phase 2: Init(Services) in Reihenfolge (Welt bauen, Provide/Handle registrieren)
--    Phase 3: Start() für alle außer DataService (Events, Scheduler-Jobs)
--    Phase 4: DataService.Start() ZULETZT (alle "Spielstand geladen"-Callbacks sind dann registriert)
--    danach Config.Validate()-Warnungen (max. 25) und "Server gestartet ✅"
--  Ein Fehler in einem Service -> warn("[AKYTEX Tycoon] …"), der Rest läuft weiter.
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ServicesFolder = script.Parent:WaitForChild("Services")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local PREFIX = "[AKYTEX Tycoon] "
local MAX_CONFIG_WARNINGS = 25

local order = {
	"DataService", -- Spielstände (Session-Lock); Start läuft zuletzt
	"MonetizationService", -- Gamepässe, Käufe, PolicyService
	"PlayerStateService", -- Request-Verteiler, State an die Clients, Ready-Gate, Leaderstats
	"ShopService", -- einziger CR-Gutschreiber/-Abzieher, Gewährungen
	"GraphicsService", -- Future-Licht-Objekte (einmal)
	"CityService", -- Stadt, Bezirke, Anker
	"PlotService", -- 10 Plots am Skyline-Ring
	"MarketService", -- Markt-Engine, GlobalBus, Kerzen, Frames
	"OrderService", -- Orders, Depot, Bots (einziger Depot-Schreiber)
	"TowerService", -- Turm-Ökonomie, Tresor, Offline
	"TowerVisualService", -- Hüllen, Interiors, Plot-Attribute
	"VehicleService", -- Kollisionsgruppen, Autos
	"LifestyleService", -- Uhren, Accessoires, Deko-Lager
	"EventService", -- Welt-Events, Live-Ops-Kalender
	"ProgressionService", -- XP, Lizenzen, Know-how, Ruf, Börsengang
	"RewardService", -- Quests, Login, Saison, Codes
	"CommunityService", -- Ansagen, Freunde, Respekt
	"AntiCheatService", -- Bewegung, Verdachtspunkte, Honeypot
	"AdminService", -- nur der Besitzer
	"LeaderboardService", -- Bestenlisten, Hall of Fame
	"MetricsService", -- Analytics
	"SelfTestService", -- Studio: "[SelfTest] n/n PASS"
}

-- Remotes zuerst anlegen (Clients warten darauf), auch wenn ein Service fehlt
do
	local remotesModule = ServicesFolder:FindFirstChild("Remotes")
	if remotesModule and remotesModule:IsA("ModuleScript") then
		local ok, err = xpcall(require, debug.traceback, remotesModule)
		if not ok then
			warn(PREFIX .. "Fehler beim Anlegen der Remotes: " .. tostring(err))
		end
	else
		warn(PREFIX .. "Services/Remotes fehlt")
	end
end

-- Phase 1: alle Module laden
local Services: { [string]: any } = {}
local loaded: { string } = {}
for _, name in ipairs(order) do
	-- Auf dem Server sind alle Skripte des Orts beim Start schon da -> kein Warten
	local module = ServicesFolder:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		warn(PREFIX .. "Service fehlt: " .. name)
		continue
	end
	local ok, result = xpcall(require, debug.traceback, module)
	if ok and type(result) == "table" then
		Services[name] = result
		table.insert(loaded, name)
	else
		warn(PREFIX .. "Fehler beim Laden von " .. name .. ": " .. tostring(result))
	end
end

-- Fehler in einem Service sollen nicht das ganze Spiel stoppen -> klar im Output melden
local function run(name: string, phase: string, fn: (...any) -> ...any, ...: any)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn(PREFIX .. "Fehler in " .. name .. "." .. phase .. ": " .. tostring(err))
	end
end

-- Vorladen der Hybrid-Assets (§C14.3): nur gesetzte Mesh-Plätze (Id ≠ 0), damit Init-Bauer schon Vorlagen klonen.
-- Ohne gesetzte Ids (Standard) kehrt das sofort zurück.
do
	local okConfig, Config = pcall(require, Shared:WaitForChild("Config"))
	local assetModule = Shared:FindFirstChild("AssetSlot")
	if okConfig and type(Config) == "table" and assetModule and assetModule:IsA("ModuleScript") then
		local okAsset, AssetSlot = pcall(require, assetModule)
		if okAsset and type(AssetSlot) == "table" then
			run("AssetSlot", "PreloadServer", function()
				AssetSlot.PreloadServer(AssetSlot.CollectFromConfig(Config))
			end)
		end
	end
end

-- Phase 2: Init (Welt bauen, Verweise setzen – keine Spieler-Logik)
for _, name in ipairs(loaded) do
	local service = Services[name]
	if type(service.Init) == "function" then
		run(name, "Init", service.Init, Services)
	end
end

-- Phase 3: Start (Events, Remote-Handler, Takte). DataService NICHT hier ...
for _, name in ipairs(loaded) do
	local service = Services[name]
	if name ~= "DataService" and type(service.Start) == "function" then
		run(name, "Start", service.Start)
	end
end

-- Phase 4: ... sondern zuletzt, damit alle "Spielstand geladen"-Callbacks schon registriert sind
if Services.DataService and type(Services.DataService.Start) == "function" then
	run("DataService", "Start", Services.DataService.Start)
end

-- Boot-Prüfung der Einstellungen (dieselbe Liste wie im SelfTest)
do
	local okConfig, Config = pcall(require, Shared:WaitForChild("Config"))
	if okConfig and type(Config) == "table" and type(Config.Validate) == "function" then
		local okValidate, errors = pcall(Config.Validate)
		if not okValidate then
			warn(PREFIX .. "Config.Validate fehlgeschlagen: " .. tostring(errors))
		elseif type(errors) == "table" and #errors > 0 then
			warn(PREFIX .. ("Config hat %d Problem(e):"):format(#errors))
			for i = 1, math.min(#errors, MAX_CONFIG_WARNINGS) do
				warn("  - " .. tostring(errors[i]))
			end
			if #errors > MAX_CONFIG_WARNINGS then
				warn(("  … und %d weitere"):format(#errors - MAX_CONFIG_WARNINGS))
			end
		end
		print(PREFIX .. "Server gestartet ✅ (Version " .. tostring(Config.Version) .. ", " .. #loaded .. " Services)")
	else
		warn(PREFIX .. "Config konnte nicht geladen werden: " .. tostring(Config))
		print(PREFIX .. "Server gestartet (ohne Config?)")
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="64">
        <Properties>
          <string name="Name">Market</string>
        </Properties>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">BotEngine</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Strategie-Bots: Sparplan, Trend, Dividende, Dip-Käufer (Server/Market/BotEngine)
--  Besitzer: WP4 (Orders, Depot, Bots). Vertrag: DESIGN.md §B8.5, §0.4 (nur Lizenz + Know-how, nie Robux),
--  MARKET.md §15. Reines Daten-Modul: entscheidet 1× je Minute (t % 60 == 0) auf 1m-Schlusskursen
--  (Schluss der Minute M = PriceAt(i, 60·M + 59)) und handelt über DIESELBE OrderEngine mit Flag "Bot"
--  -> online = offline (Offline-Abgleich höchstens 12 h, env.BotsUntil).
--
--  Regeln:
--    * Plätze: TradingPerks.BotSlots (Lizenz) · Presets ab Lizenz (Config.Trading.Bots[*].Licence)
--    * Kapital je Bot: Bot-Stufe (Know-how BotLvl.<Preset>, 0 … 4) -> 10/15/20/25/30 % des Depotwerts
--      (Capital-Presets: höchstens der eingestellte Anteil); alle Bots zusammen ≤ 30 % (prüft OrderService bei BotSet)
--    * Tagesverlust-Bremse −5 % des Tageskapitals -> pausiert bis zur nächsten Glocke; Not-Aus = BotToggle
--    * Lohn 0,02 % des verwalteten Kapitals je Börsentag (AKY-Senke, OrderEngine.CloseDay ruft PayWages)
--  Bot-Platz (Types.BotSlot + Zusatzfelder): { Preset, Pct, Target?, On, Paused, DayNav, DayVal, DayFlow, Day, Last,
--  Q = { [instId-String] = Stück des Bots } }.
--
--  Öffentliche API:
--    BotEngine.Decide(d, env, t)                  alle Bots eines Depots (von OrderEngine.Step aufgerufen)
--    BotEngine.PayWages(d, env, t)                Lohn am Börsentag-Schluss
--    BotEngine.Value(d, env, t, slot): number     Wert der Bot-Bestände (Bid)
--    BotEngine.Capital(env, slot): number         Kapitalanteil (Bruch) des Bots
--    BotEngine.Preset(key) · BotEngine.Unlocked(env, key): boolean · BotEngine.NewSlot(preset, pct, target)
--    BotEngine.DividendTargets(env): { number }   die 6 Zahler mit der höchsten Dividende (Lizenz-gefiltert)
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Clock = require(Shared:WaitForChild("Clock"))
local MarketShared = Shared:WaitForChild("Market")
local PortfolioMath = require(MarketShared:WaitForChild("PortfolioMath"))
local Indicators = require(MarketShared:WaitForChild("Indicators"))
local Portfolio = require(script.Parent:WaitForChild("Portfolio"))
local OrderEngine = require(script.Parent:WaitForChild("OrderEngine"))

local BotEngine = {}

type Depot = { [string]: any }
type Slot = { [string]: any }
type Env = OrderEngine.Env

local DAY = Clock.DAY_TICKS
local CLOSE_CACHE_MAX = 30000
local INST_IDS_FALLBACK = 46

local closeCache: { [number]: { [number]: number } } = {}
local closeCount = 0

local function trading(): { [string]: any }
	local t = Config.Trading
	return if type(t) == "table" then t else {}
end

local function num(v: any, fallback: number): number
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return fallback
end

function BotEngine.Preset(key: string): { [string]: any }?
	local presets = trading().Bots
	local preset = type(presets) == "table" and presets[key] or nil
	return if type(preset) == "table" then preset else nil
end

function BotEngine.Unlocked(env: Env, key: string): boolean
	local preset = BotEngine.Preset(key)
	return preset ~= nil and env.Licence.Index >= num(preset.Licence, 99)
end

function BotEngine.NewSlot(preset: string, pct: number, target: number?): Slot
	return {
		Preset = preset,
		Pct = pct,
		Target = target,
		On = true,
		Paused = false,
		DayNav = 0,
		DayVal = 0,
		DayFlow = 0,
		Day = -1,
		Last = -1,
		Q = {},
	}
end

-- Kapitalanteil (Bruch des Depotwerts): Bot-Stufe aus Know-how, Capital-Presets höchstens der eingestellte Anteil
function BotEngine.Capital(env: Env, slot: Slot): number
	local cfg = trading()
	local levels = env.Perks and env.Perks.BotLevels
	local level = math.clamp(math.floor(num(type(levels) == "table" and levels[slot.Preset], 0)), 0, 4)
	local caps = cfg.BotCapital
	local cap = num(type(caps) == "table" and caps[level + 1], 0.10)
	local preset = BotEngine.Preset(slot.Preset)
	if preset and preset.Param == "Capital" then
		cap = math.min(cap, num(slot.Pct, cap))
	end
	return math.clamp(cap, 0, num(cfg.BotTotalPct, 0.30))
end

-- 1m-Schlusskurs der Minute "minute" (gecacht für Minuten, die sicher abgeschlossen sind)
local function closeOf(env: Env, i: number, minute: number): number?
	local perInst = closeCache[i]
	local cached = perInst and perInst[minute]
	if cached then
		return cached
	end
	local px = env.PriceAt(i, minute * 60 + 59)
	if type(px) ~= "number" or px <= 0 then
		return nil
	end
	if minute * 60 + 59 < env.CacheBefore then
		if closeCount >= CLOSE_CACHE_MAX then
			table.clear(closeCache)
			closeCount = 0
		end
		perInst = closeCache[i]
		if not perInst then
			perInst = {}
			closeCache[i] = perInst
		end
		perInst[minute] = px
		closeCount += 1
	end
	return px
end

-- Bot-Bestände nie größer als die echte Position (Spieler kann von Hand verkaufen)
local function syncHoldings(d: Depot, slot: Slot)
	if type(slot.Q) ~= "table" then
		slot.Q = {}
		return
	end
	for key, qty in pairs(slot.Q) do
		local id = tonumber(key)
		local have = if id then Portfolio.PosQty(d, id) else 0
		if have <= 0 then
			slot.Q[key] = nil
		elseif qty > have then
			slot.Q[key] = have
		end
	end
end

function BotEngine.Value(_d: Depot, env: Env, t: number, slot: Slot): number
	local value = 0
	if type(slot.Q) ~= "table" then
		return 0
	end
	for key, qty in pairs(slot.Q) do
		local id = tonumber(key)
		if id and qty > 0 then
			local bid = OrderEngine.EngineQuote(env, id, t)
			value += qty * (if type(bid) == "number" then bid else 0)
		end
	end
	return value
end

local function held(slot: Slot, i: number): number
	return if type(slot.Q) == "table" then math.floor(num(slot.Q[tostring(i)], 0)) else 0
end

local function heldCount(slot: Slot): number
	local n = 0
	if type(slot.Q) == "table" then
		for _, qty in pairs(slot.Q) do
			if qty > 0 then
				n += 1
			end
		end
	end
	return n
end

-- Kauf für höchstens "budget" Cent (Bot-Kapital und freies Geld), nie unter der Mindest-Ordergröße
local function botBuy(d: Depot, env: Env, t: number, slotIndex: number, i: number, budget: number, protect: boolean)
	local cfg = trading()
	if not OrderEngine.InstAllowed(env, i) or env.Halted(i, t) then
		return nil
	end
	local amount = math.min(math.floor(budget), Portfolio.Free(d))
	if amount < num(cfg.BotMinOrderCents, 10000) then
		return nil
	end
	local bid, ask = OrderEngine.EngineQuote(env, i, t)
	if type(bid) ~= "number" or type(ask) ~= "number" then
		return nil
	end
	local capLeft = OrderEngine.PosCap(env, i) - Portfolio.PosQty(d, i) * ask
	local qty = math.min(
		PortfolioMath.AffordableQty(amount, ask, env.Licence.FeeBps, num(cfg.MinFeeCents, 100)),
		PortfolioMath.MaxQty(ask, capLeft)
	)
	if qty < 1 then
		return nil
	end
	local result = OrderEngine.BuyNow(d, env, t, i, qty, ask, bid, protect, slotIndex, "Bot")
	return if result.Ok then result else nil
end

local function botSell(d: Depot, env: Env, t: number, slotIndex: number, slot: Slot, i: number, qty: number)
	local q = math.min(qty, held(slot, i))
	if q < 1 then
		return nil
	end
	-- eigene Schutz-Orders reservieren die Stück -> zuerst streichen
	OrderEngine.CancelBotOrders(d, slotIndex, i)
	local available = Portfolio.PosQty(d, i) - Portfolio.ReservedQty(d, i)
	q = math.min(q, available)
	if q < 1 then
		return nil
	end
	local bid = OrderEngine.EngineQuote(env, i, t)
	if type(bid) ~= "number" or env.Halted(i, t) then
		return nil
	end
	local result = OrderEngine.SellNow(d, env, t, i, q, bid, slotIndex, "Bot")
	return if result.Ok then result else nil
end

-- ---------------------------------------------------------------------
-- PRESETS
-- ---------------------------------------------------------------------
local function runSparplan(d: Depot, env: Env, t: number, slotIndex: number, slot: Slot, preset: any, headroom: number)
	local day = t // DAY
	if slot.Last == day then
		return
	end
	slot.Last = day -- einmal je Börsentag (auch wenn gerade nichts gekauft werden kann)
	local target = slot.Target
	if
		type(target) ~= "number"
		or OrderEngine.ClassOf(env, target) ~= "ETF"
		or not OrderEngine.InstAllowed(env, target)
	then
		target = math.floor(num(preset.DefaultTarget, 40))
	end
	local pct = math.clamp(num(slot.Pct, num(preset.Default, 0.10)), num(preset.Min, 0.05), num(preset.Max, 0.20))
	local budget = math.min(math.floor(pct * Portfolio.Free(d)), headroom)
	botBuy(d, env, t, slotIndex, target :: number, budget, false)
end

local function smaPair(
	env: Env,
	i: number,
	minute: number,
	fast: number,
	slow: number
): (number?, number?, number?, number?)
	-- Schlusskurse der Minuten minute − slow … minute − 1 (slow + 1 Werte: jetzt und eine Minute vorher)
	local closes: { number } = table.create(slow + 1)
	for k = slow, 0, -1 do
		local px = closeOf(env, i, minute - 1 - k)
		if not px then
			return nil, nil, nil, nil
		end
		table.insert(closes, px)
	end
	local f = Indicators.SMA(closes, fast)
	local s = Indicators.SMA(closes, slow)
	local n = #closes
	return f[n], s[n], f[n - 1], s[n - 1]
end

local function runTrend(d: Depot, env: Env, t: number, slotIndex: number, slot: Slot, preset: any, headroom: number)
	local target = slot.Target
	if type(target) ~= "number" or not OrderEngine.InstAllowed(env, target) then
		return
	end
	local fast = math.floor(num(preset.Fast, 20))
	local slow = math.floor(num(preset.Slow, 50))
	local fNow, sNow, fPrev, sPrev = smaPair(env, target, t // 60, fast, slow)
	if not (fNow and sNow and fPrev and sPrev) then
		return
	end
	local have = held(slot, target)
	if have > 0 then
		if fNow < sNow then
			botSell(d, env, t, slotIndex, slot, target, have) -- Rückkreuzen -> raus
		end
	elseif fPrev <= sPrev and fNow > sNow then
		botBuy(d, env, t, slotIndex, target, headroom, true) -- frisches Aufwärts-Kreuzen -> rein + Schutz-Paar
	end
end

function BotEngine.DividendTargets(env: Env): { number }
	local ids: { number } = {}
	if env.ActiveIds then
		local ok, list = pcall(env.ActiveIds)
		if ok and type(list) == "table" then
			ids = list
		end
	end
	if #ids == 0 then
		for i = 1, INST_IDS_FALLBACK do
			table.insert(ids, i)
		end
	end
	local candidates: { { Id: number, Bps: number } } = {}
	for _, i in ipairs(ids) do
		local bps = env.DivBps(i)
		if bps > 0 and OrderEngine.InstAllowed(env, i) and OrderEngine.ClassOf(env, i) ~= "ETF" then
			table.insert(candidates, { Id = i, Bps = bps })
		end
	end
	table.sort(candidates, function(a, b)
		if a.Bps ~= b.Bps then
			return a.Bps > b.Bps
		end
		return a.Id < b.Id
	end)
	local divPreset = BotEngine.Preset("Dividend")
	local count = math.floor(num(divPreset and divPreset.Count, 6))
	local out: { number } = {}
	for k = 1, math.min(count, #candidates) do
		table.insert(out, candidates[k].Id)
	end
	return out
end

local function runDividend(
	d: Depot,
	env: Env,
	t: number,
	slotIndex: number,
	slot: Slot,
	preset: any,
	capitalCents: number
)
	local day = t // DAY
	if slot.Last == day then
		return
	end
	slot.Last = day
	local targets = BotEngine.DividendTargets(env)
	if #targets == 0 then
		return
	end
	local inSet: { [number]: boolean } = {}
	for _, i in ipairs(targets) do
		inSet[i] = true
	end
	-- 1) Werte außerhalb der Zielliste verkaufen
	for key, qty in pairs(table.clone(slot.Q)) do
		local id = tonumber(key)
		if id and not inSet[id] and qty > 0 then
			botSell(d, env, t, slotIndex, slot, id, qty)
		end
	end
	-- 2) auf gleiche Gewichte ausgleichen (erst ab Rebalance-Abweichung)
	local per = math.floor(capitalCents / #targets)
	local band = num(preset.Rebalance, 0.10)
	local minOrder = num(trading().BotMinOrderCents, 10000)
	for _, i in ipairs(targets) do
		local bid, ask = OrderEngine.EngineQuote(env, i, t)
		if type(bid) == "number" and type(ask) == "number" then
			local value = held(slot, i) * bid
			local diff = per - value
			if math.abs(diff) > band * per and math.abs(diff) >= minOrder then
				if diff > 0 then
					botBuy(d, env, t, slotIndex, i, diff, false)
				else
					botSell(d, env, t, slotIndex, slot, i, math.floor(-diff / bid))
				end
			end
		end
	end
end

local function runDip(
	d: Depot,
	env: Env,
	t: number,
	slotIndex: number,
	slot: Slot,
	preset: any,
	capitalCents: number,
	headroom: number
)
	local watch = env.Watch
	if type(watch) ~= "table" or #watch == 0 then
		return
	end
	local slots = math.floor(num(preset.Slots, 3))
	if heldCount(slot) >= slots then
		return
	end
	local drop = math.clamp(num(slot.Pct, num(preset.Default, 0.05)), num(preset.Min, 0.03), num(preset.Max, 0.08))
	local dayStart = (t // DAY) * DAY
	for _, i in ipairs(watch) do
		if heldCount(slot) >= slots then
			break
		end
		if held(slot, i) == 0 and OrderEngine.InstAllowed(env, i) then
			local open = env.PriceAt(i, dayStart - 1)
			local now = closeOf(env, i, t // 60 - 1)
			local before = if t - 61 >= dayStart then closeOf(env, i, t // 60 - 2) else open
			if type(open) == "number" and open > 0 and now and before then
				local changeNow = now / open - 1
				local changeBefore = before / open - 1
				-- nur beim Unterschreiten der Schwelle (kein Nachkaufen nach einem Stopp ohne neue Erholung)
				if changeNow <= -drop and changeBefore > -drop then
					local budget = math.min(math.floor(capitalCents / slots), headroom)
					local result = botBuy(d, env, t, slotIndex, i, budget, false)
					if result and result.Fill then
						local stopPct = num(preset.Stop, 0.08)
						local stp = math.max(1, math.floor(result.Fill.Px * (1 - stopPct)))
						OrderEngine.AttachStop(d, t, i, result.Fill.Q, stp, slotIndex)
						headroom -= result.Fill.Q * result.Fill.Px
					end
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- ENTSCHEIDUNG (1× je Minute)
-- ---------------------------------------------------------------------
function BotEngine.Decide(d: Depot, env: Env, t: number)
	if type(d.Bots) ~= "table" or #d.Bots == 0 then
		return
	end
	if env.BotsUntil ~= nil and t > env.BotsUntil and t <= (env.BotsFrom or math.huge) then
		return -- Offline-Abgleich: Bots handeln höchstens 12 h nach dem Verlassen
	end
	local cfg = trading()
	local day = t // DAY
	local nav: number? = nil
	local slotsAllowed = math.floor(num(env.Perks and env.Perks.BotSlots, env.Licence.BotSlots))
	for slotIndex, slot in ipairs(d.Bots) do
		local preset = BotEngine.Preset(slot.Preset)
		if not preset then
			continue
		end
		syncHoldings(d, slot)
		nav = nav or OrderEngine.NavAt(d, env, t)
		local capital = BotEngine.Capital(env, slot)
		local value = BotEngine.Value(d, env, t, slot)
		if slot.Day ~= day then
			-- neuer Börsentag: Tageskapital festhalten, Bremse lösen
			slot.Day = day
			slot.DayVal = value
			slot.DayFlow = 0
			slot.DayNav = math.floor(capital * (nav :: number))
			slot.Paused = false
		end
		if slot.On ~= true or slot.Paused == true then
			continue
		end
		if slotIndex > slotsAllowed or env.Licence.Index < num(preset.Licence, 99) then
			continue -- Platz/Preset (noch) nicht freigeschaltet: ruht, behält Bestände
		end
		-- Tagesverlust-Bremse (−5 % des Tageskapitals)
		local pnl = value + math.floor(num(slot.DayFlow, 0)) - math.floor(num(slot.DayVal, 0))
		local dayNav = math.floor(num(slot.DayNav, 0))
		if dayNav > 0 and pnl <= num(cfg.BotDayStop, -0.05) * dayNav then
			slot.Paused = true
			env.Emit("BotPaused", { Slot = slotIndex, Preset = slot.Preset })
			continue
		end
		local capitalCents = math.floor(capital * (nav :: number))
		local headroom = math.max(0, capitalCents - value)
		local key = slot.Preset
		if key == "Sparplan" then
			runSparplan(d, env, t, slotIndex, slot, preset, headroom)
		elseif key == "Trend" then
			runTrend(d, env, t, slotIndex, slot, preset, headroom)
		elseif key == "Dividend" then
			runDividend(d, env, t, slotIndex, slot, preset, capitalCents)
		elseif key == "Dip" then
			runDip(d, env, t, slotIndex, slot, preset, capitalCents, headroom)
		end
		nav = nil -- nach Trades neu bewerten (Gebühren)
	end
end

-- Lohn: 0,02 % des verwalteten Kapitals (Bot-Bestände zum Bid) je Börsentag, nie aus reserviertem Geld
function BotEngine.PayWages(d: Depot, env: Env, t: number)
	if type(d.Bots) ~= "table" then
		return
	end
	local bps = num(trading().BotWageBps, 2)
	for _, slot in ipairs(d.Bots) do
		if BotEngine.Preset(slot.Preset) then
			syncHoldings(d, slot)
			local value = BotEngine.Value(d, env, t, slot)
			if value > 0 then
				local wage = math.ceil(value * bps / 10000)
				local take = math.min(wage, Portfolio.Free(d))
				if take > 0 then
					Portfolio.Debit(d, take, "BotWage")
				end
			end
		end
	end
end

OrderEngine.UseBots(BotEngine)

return BotEngine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">CandleStore</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Kerzen-Ringe & Historie (Server/Market/CandleStore)
--  Besitzer: WP3 (Markt-Engine). Vertrag: MARKET.md §9.1–§9.3, §10.3; DESIGN.md §C16 (Backfill ≤ 2 ms/Frame).
--  Je Instrument drei buffer-Ringe (10 Byte je Kerze, QuoteCodec-Datensatz): 1s × 300 · 5s × 360 · 1m × 1440.
--  Die laufende 5s-/1m-Kerze steht immer schon im Ring (wird jede Sekunde überschrieben).
--  5m/15m/1T/1W werden aus dem 1m-Ring aggregiert (QuoteCodec.Aggregate). Antworten werden je
--  (Instrument, Zeitrahmen, letzte Kerze) EINMAL kodiert und für alle Spieler wiederverwendet.
--  Backfill beim Start: letzte 6 h exakt mit 1 Hz, 6–24 h aus 10-s-Stichproben (nur Anzeige, Orders nutzen sie nie);
--  Aufträge laufen über einen Frame-Takt mit Zeitbudget. Rebuild(…) rechnet Fenster nach verspäteten Events neu.
--
--  Öffentliche API (nur WP3)
--    CandleStore.new(config): Store
--    s:Push(i, t, o, h, l, c, v)                 1s-Kerze (live) in alle Ringe
--    s:Get(i, tf): buffer?                       Kerzen-Antwort (QuoteCodec 8 + 10·n), gecacht
--    s:Plan(cursorFn, ids, liveStart)            Backfill-Aufträge anlegen (cursorFn(i, t0) -> Cursor)
--    s:SeedPartial(i, liveStart, candleAt)       laufende 5s-/1m-Kerze exakt vorbelegen (vor dem ersten Push)
--    s:Rebuild(ids, from, to, liveStart?)        Fenster neu rechnen (vorne in die Warteschlange)
--    s:Work(budgetMs): boolean                   Aufträge abarbeiten; true = nichts mehr zu tun
--    s:Pending(): number · s:WeekHigh(i): number · s:Range(i): (lo, hi) · s:Clear()
--    s:Missing(i, from): boolean (Historie ab from noch unvollständig) · s:Prioritize(i) (Aufträge von i zuerst)
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local QuoteCodec = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Market"):WaitForChild("QuoteCodec"))

local CandleStore = {}
CandleStore.__index = CandleStore

type Plain = { [string]: any }
type Partial = { B: number, O: number, H: number, L: number, C: number, V: number }
type Ring = { Buf: buffer, Cap: number, Tf: number, Head: number, P: Partial? }
type Rings = { S1: Ring, S5: Ring, M1: Ring, Cache: { [number]: { Key: number, Buf: buffer } }, WH: { number } }
type Task = {
	I: number,
	From: number,
	To: number, -- einschließlich
	Exact: boolean,
	T: number,
	Cursor: any,
	Agg5: Partial?,
	AggM: Partial?,
	Live: number,
}

local TF_S1, TF_S5, TF_M1 = 1, 5, 60
local MAX_TASKS = 4000

local function newRing(cap: number, tf: number): Ring
	return { Buf = buffer.create(cap * QuoteCodec.RECORD), Cap = cap, Tf = tf, Head = -1, P = nil }
end

function CandleStore.new(config: Plain)
	local self = setmetatable({}, CandleStore) :: any
	self.Cfg = config
	self.Rings = {} :: { [number]: Rings }
	self.Tasks = {} :: { Task }
	self.CursorFn = nil :: ((number, number) -> any)?
	self.History = config.History.Candles
	return self
end

function CandleStore.Ensure(self: any, i: number): Rings
	local r = self.Rings[i]
	if r == nil then
		local rings = self.Cfg.Rings
		r = {
			S1 = newRing(rings.S1, TF_S1),
			S5 = newRing(rings.S5, TF_S5),
			M1 = newRing(rings.M1, TF_M1),
			Cache = {},
			WH = { -1, 0 },
		}
		self.Rings[i] = r
	end
	return r :: Rings
end

function CandleStore.Clear(self: any)
	table.clear(self.Rings)
	table.clear(self.Tasks)
end

-- Datensatz eines Buckets schreiben (O = Schluss des Vorgängers, im Datensatz implizit)
local function writeBucket(ring: Ring, bucket: number, p: Partial)
	local hiOff = QuoteCodec.HiOff(p.O, p.C, p.H)
	local loOff = QuoteCodec.LoOff(p.O, p.C, p.L)
	QuoteCodec.WriteRecord(ring.Buf, bucket % ring.Cap, p.C, hiOff, loOff, p.V / ring.Tf)
end

local function zeroBuckets(ring: Ring, fromBucket: number, toBucket: number)
	if toBucket < fromBucket then
		return
	end
	local first = math.max(fromBucket, toBucket - ring.Cap + 1)
	for b = first, toBucket do
		QuoteCodec.WriteRecord(ring.Buf, b % ring.Cap, 0, 0, 0, 0)
	end
end

-- Live-Aggregation in einen Ring (laufender Bucket wird überschrieben)
local function feed(ring: Ring, t: number, o: number, h: number, l: number, c: number, v: number)
	local bucket = t // ring.Tf
	local p = ring.P
	if p and p.B == bucket then
		if h > p.H then
			p.H = h
		end
		if l < p.L then
			p.L = l
		end
		p.C = c
		p.V += v
	else
		if ring.Head >= 0 and bucket > ring.Head + 1 then
			zeroBuckets(ring, ring.Head + 1, bucket - 1)
		end
		p = { B = bucket, O = o, H = h, L = l, C = c, V = v }
		ring.P = p
	end
	writeBucket(ring, bucket, p :: Partial)
	if bucket > ring.Head then
		ring.Head = bucket
	end
end

function CandleStore.Push(self: any, i: number, t: number, o: number, h: number, l: number, c: number, v: number)
	local r = self:Ensure(i)
	feed(r.S1, t, o, h, l, c, v)
	feed(r.S5, t, o, h, l, c, v)
	feed(r.M1, t, o, h, l, c, v)
end

-- laufende 5s-/1m-Kerze vor dem ersten Live-Push exakt aus den Sekunden davor vorbelegen
function CandleStore.SeedPartial(
	self: any,
	i: number,
	liveStart: number,
	candleAt: (number, number) -> (number, number, number, number, number)
)
	local r = self:Ensure(i)
	if r.S1.Head >= 0 and liveStart - 1 > r.S1.Head then
		zeroBuckets(r.S1, r.S1.Head + 1, liveStart - 1) -- Stillstand: alte Ring-Inhalte nicht als neue Kerzen zeigen
	end
	for _, ring in ipairs({ r.S5, r.M1 }) do
		local liveBucket = liveStart // ring.Tf
		local bucketStart = liveBucket * ring.Tf
		if ring.Head >= 0 and liveBucket - 1 > ring.Head then
			zeroBuckets(ring, ring.Head + 1, liveBucket - 1)
		end
		ring.P = nil
		if bucketStart < liveStart then
			local p: Partial? = nil
			for t = bucketStart, liveStart - 1 do
				local o, h, l, c, v = candleAt(i, t)
				if p == nil then
					p = { B = liveBucket, O = o, H = h, L = l, C = c, V = v }
				else
					local q = p :: Partial
					q.H = math.max(q.H, h)
					q.L = math.min(q.L, l)
					q.C = c
					q.V += v
				end
			end
			ring.P = p
			if p then
				writeBucket(ring, p.B, p)
				ring.Head = math.max(ring.Head, p.B)
			end
		end
	end
	r.Cache = {}
end

-- ---------------------------------------------------------------------
-- ANTWORTEN (gecacht je Instrument/Zeitrahmen/letzter Kerze)
-- ---------------------------------------------------------------------
local function ringAnswer(self: any, i: number, ring: Ring): buffer?
	if ring.Head < 0 then
		return nil
	end
	local n = math.min(self.History, ring.Cap - 1) + 1
	local firstBucket = ring.Head - n + 1
	return QuoteCodec.EncodeCandles(i, ring.Tf, firstBucket * ring.Tf, ring.Buf, firstBucket % ring.Cap, n)
end

-- 1m-Ring als Kerzenliste (Lücken = nil-frei übersprungen), älteste zuerst
local function minuteCandles(ring: Ring, minutes: number): { QuoteCodec.Candle }
	local out: { QuoteCodec.Candle } = {}
	if ring.Head < 0 then
		return out
	end
	local n = math.min(minutes, ring.Cap - 1)
	local first = ring.Head - n + 1
	local prev = select(1, QuoteCodec.ReadRecord(ring.Buf, (first - 1) % ring.Cap))
	for b = first, ring.Head do
		local close, hiOff, loOff, vol = QuoteCodec.ReadRecord(ring.Buf, b % ring.Cap)
		if close > 0 and prev > 0 then
			table.insert(out, {
				T = b * ring.Tf,
				O = prev,
				H = QuoteCodec.HiFrom(prev, close, hiOff),
				L = QuoteCodec.LoFrom(prev, close, loOff),
				C = close,
				V = vol * ring.Tf,
			})
		end
		prev = close
	end
	return out
end

function CandleStore.Get(self: any, i: number, tf: number): buffer?
	local r = self.Rings[i]
	if r == nil then
		return nil
	end
	local ring: Ring = if tf == TF_S1 then r.S1 elseif tf == TF_S5 then r.S5 else r.M1
	local head = ring.Head
	local key = head
	local cached = r.Cache[tf]
	if cached and cached.Key == key and head >= 0 then
		return cached.Buf
	end
	local buf: buffer?
	if tf == TF_S1 or tf == TF_S5 or tf == TF_M1 then
		buf = ringAnswer(self, i, ring)
	else
		local per = math.max(1, tf // TF_M1)
		local minutes = math.min(r.M1.Cap - 1, per * (self.History + 1))
		local agg = QuoteCodec.Aggregate(minuteCandles(r.M1, minutes), tf)
		while #agg > self.History do
			table.remove(agg, 1)
		end
		if #agg == 0 then
			buf = nil
		else
			-- dicht machen: fehlende Buckets als Lücke (Close 0), damit Zeit = Start + k · tf stimmt
			local dense: { QuoteCodec.Candle } = {}
			local firstT = agg[1].T
			local index = 1
			local t = firstT
			local guard = 0
			while index <= #agg and guard < 2000 do -- gebunden
				guard += 1
				local c = agg[index]
				if c.T == t then
					table.insert(dense, c)
					index += 1
				else
					table.insert(dense, { T = t, O = 0, H = 0, L = 0, C = 0, V = 0 })
				end
				t += tf
			end
			buf = QuoteCodec.EncodeRecords(i, tf, firstT - tf, dense, agg[1].O)
		end
	end
	if buf then
		r.Cache[tf] = { Key = key, Buf = buf }
	end
	return buf
end

-- Hoch/Tief der letzten 1W-Kerze (140 × 1m) – Frame-Flag "Wochen-Hoch" und Firmenprofil
function CandleStore.Range(self: any, i: number): (number, number)
	local r = self.Rings[i]
	if r == nil then
		return 0, 0
	end
	local candles = minuteCandles(r.M1, self.Cfg.WeekHighCandles)
	local hi, lo = 0, math.huge
	for _, c in ipairs(candles) do
		if c.H > hi then
			hi = c.H
		end
		if c.L < lo then
			lo = c.L
		end
	end
	return hi, if lo == math.huge then 0 else lo
end

function CandleStore.WeekHigh(self: any, i: number): number
	local r = self.Rings[i]
	if r == nil then
		return 0
	end
	local minute = r.M1.Head
	if r.WH[1] ~= minute then
		local hi = self:Range(i)
		r.WH = { minute, hi }
	end
	return r.WH[2]
end

-- ---------------------------------------------------------------------
-- BACKFILL / REBUILD (Aufträge mit Zeitbudget)
-- ---------------------------------------------------------------------
function CandleStore.Pending(self: any): number
	return #self.Tasks
end

-- Fehlt für Instrument i noch Historie ab Tick "from"? (ein offener Auftrag reicht bis in dieses Fenster – ein Auftrag
-- läuft von alt nach neu, sein Rest ist [T, To]). Dann wäre eine Antwort lückenhaft.
function CandleStore.Missing(self: any, i: number, from: number): boolean
	for _, task in ipairs(self.Tasks) do
		if task.I == i and task.To >= from then
			return true
		end
	end
	return false
end

-- Aufträge eines Instruments nach vorne ziehen (jemand öffnet gerade diesen Chart); Reihenfolge bleibt erhalten
function CandleStore.Prioritize(self: any, i: number)
	local mine: { Task } = {}
	local rest: { Task } = {}
	for _, task in ipairs(self.Tasks) do
		table.insert(if task.I == i then mine else rest, task)
	end
	if #mine == 0 or self.Tasks[1].I == i and #mine == 1 then
		return
	end
	for _, task in ipairs(rest) do
		table.insert(mine, task)
	end
	self.Tasks = mine
end

local function addTask(self: any, task: Task, front: boolean)
	if #self.Tasks >= MAX_TASKS then
		table.remove(self.Tasks)
	end
	if front then
		table.insert(self.Tasks, 1, task)
	else
		table.insert(self.Tasks, task)
	end
end

local function newTask(i: number, from: number, to: number, exact: boolean, live: number): Task
	return { I = i, From = from, To = to, Exact = exact, T = from, Cursor = nil, Agg5 = nil, AggM = nil, Live = live }
end

-- Aufteilung: zuerst die letzten 30 min exakt (Charts sofort brauchbar), dann bis 6 h exakt, dann 6–24 h Stichproben.
-- Der exakte Teil reicht bis liveStart − 1 (1s-Ring); die laufenden 5s-/1m-Buckets gehören SeedPartial/Live.
function CandleStore.Plan(self: any, cursorFn: (number, number) -> any, ids: { number }, liveStart: number)
	self.CursorFn = cursorFn
	local cfg = self.Cfg.Backfill
	local liveMinute = (liveStart // TF_M1) * TF_M1
	local exactFrom = liveMinute - math.floor(cfg.ExactHours * 3600 / TF_M1) * TF_M1
	local sampleFrom = liveMinute - math.floor(cfg.SampleHours * 3600 / TF_M1) * TF_M1
	local quick = math.max(exactFrom, liveMinute - 1800)
	for _, i in ipairs(ids) do
		self:Ensure(i)
		if liveStart - 1 >= quick then
			addTask(self, newTask(i, quick, liveStart - 1, true, liveStart), false)
		end
	end
	for _, i in ipairs(ids) do
		if quick - 1 >= exactFrom then
			addTask(self, newTask(i, exactFrom, quick - 1, true, liveStart), false)
		end
	end
	for _, i in ipairs(ids) do
		if exactFrom - 1 >= sampleFrom then
			addTask(self, newTask(i, sampleFrom, exactFrom - 1, false, liveStart), false)
		end
	end
end

-- Fenster neu rechnen (verspätetes Event, Stillstand): ganze Minuten, vorne in die Warteschlange
function CandleStore.Rebuild(self: any, ids: { number }, from: number, to: number, liveStart: number?)
	if self.CursorFn == nil then
		return
	end
	local live = liveStart or (to + 1)
	local liveMinute = (live // TF_M1) * TF_M1
	local ringStart = liveMinute - (self.Cfg.Rings.M1 - 1) * TF_M1
	local a = math.max((from // TF_M1) * TF_M1, ringStart)
	local b = math.min(to, live - 1) -- laufende 5s-/1m-Buckets überspringt stepTask (SeedPartial/Live)
	if b < a then
		return
	end
	local exactLimit = liveMinute - math.floor(self.Cfg.Backfill.ExactHours * 3600 / TF_M1) * TF_M1
	for _, i in ipairs(ids) do
		if self.Rings[i] then
			if a < exactLimit then
				addTask(self, newTask(i, a, math.min(b, exactLimit - 1), false, live), true)
			end
			if b >= math.max(a, exactLimit) then
				addTask(self, newTask(i, math.max(a, exactLimit), b, true, live), true)
			end
		end
	end
end

local function finishBucket(ring: Ring, p: Partial)
	writeBucket(ring, p.B, p)
	if p.B > ring.Head and ring.P == nil then
		ring.Head = p.B
	end
end

local function aggregate(agg: Partial?, bucket: number, o: number, h: number, l: number, c: number, v: number): Partial
	if agg and agg.B == bucket then
		if h > agg.H then
			agg.H = h
		end
		if l < agg.L then
			agg.L = l
		end
		agg.C = c
		agg.V += v
		return agg
	end
	return { B = bucket, O = o, H = h, L = l, C = c, V = v }
end

-- einen Auftrag um ein Stück weiterführen; true = fertig
local function stepTask(self: any, task: Task, deadline: number): boolean
	local r = self.Rings[task.I]
	if r == nil then
		return true
	end
	local cursorFn = self.CursorFn
	if cursorFn == nil then
		return true
	end
	if task.Cursor == nil then
		task.Cursor = cursorFn(task.I, task.T)
	end
	local cursor = task.Cursor
	-- Schreibgrenzen: nie über neuere Live-Kerzen (Ring läuft weiter, während der Auftrag über Frames verteilt läuft),
	-- nie in die laufenden 5s-/1m-Buckets (die gehören SeedPartial und dem Live-Takt)
	local s1From = math.max(task.Live, r.S1.Head + 1) - r.S1.Cap
	local s5From = math.max(task.Live // TF_S5, r.S5.Head + 1) - r.S5.Cap
	local mFrom = math.max(task.Live // TF_M1, r.M1.Head + 1) - r.M1.Cap
	local s5Live = task.Live // TF_S5
	local mLive = task.Live // TF_M1
	local count = 0
	if task.Exact then
		while task.T <= task.To do
			local t = task.T
			local o, h, l, c, v = cursor:Full(t)
			if t >= s1From then
				QuoteCodec.WriteRecord(
					r.S1.Buf,
					t % r.S1.Cap,
					c,
					QuoteCodec.HiOff(o, c, h),
					QuoteCodec.LoOff(o, c, l),
					v
				)
				if t > r.S1.Head and r.S1.P == nil then
					r.S1.Head = t
				end
			end
			local b5 = t // TF_S5
			if b5 >= s5From and b5 < s5Live then
				local prev5 = task.Agg5
				if prev5 and prev5.B ~= b5 then
					finishBucket(r.S5, prev5)
				end
				task.Agg5 = aggregate(task.Agg5, b5, o, h, l, c, v)
			end
			local bm = t // TF_M1
			if bm >= mFrom and bm < mLive then
				local prevM = task.AggM
				if prevM and prevM.B ~= bm then
					finishBucket(r.M1, prevM)
				end
				task.AggM = aggregate(task.AggM, bm, o, h, l, c, v)
			end
			task.T = t + 1
			count += 1
			if count % 32 == 0 and os.clock() >= deadline then
				break
			end
		end
		if task.T > task.To then
			if task.Agg5 then
				finishBucket(r.S5, task.Agg5 :: Partial)
			end
			if task.AggM then
				finishBucket(r.M1, task.AggM :: Partial)
			end
			r.Cache = {}
			return true
		end
		return false
	end
	-- Stichproben: je Minute alle SampleStep s eine 1s-Kerze; Eröffnung = exakter Schluss vor der Minute,
	-- Schluss = exakter Schluss der Minute (letzte Stichprobe liegt auf Sekunde 59)
	local step = math.max(1, self.Cfg.Backfill.SampleStep)
	while task.T <= task.To do
		local minuteStart = (task.T // TF_M1) * TF_M1
		cursor:Seek(minuteStart)
		local open = cursor.LastMid
		local minuteIndex = minuteStart // TF_M1
		local p: Partial = { B = minuteIndex, O = open, H = open, L = open, C = open, V = 0 }
		local s = minuteStart + step - 1
		while s <= minuteStart + TF_M1 - 1 do
			local _, h, l, c, v = cursor:Full(s)
			if h > p.H then
				p.H = h
			end
			if l < p.L then
				p.L = l
			end
			p.C = c
			p.V += v * step
			s += step
		end
		if minuteIndex >= math.max(mLive, r.M1.Head + 1) - r.M1.Cap and minuteIndex < mLive then
			finishBucket(r.M1, p)
		end
		task.T = minuteStart + TF_M1
		count += 1
		if count % 4 == 0 and os.clock() >= deadline then
			break
		end
	end
	if task.T > task.To then
		r.Cache = {}
		return true
	end
	return false
end

function CandleStore.Work(self: any, budgetMs: number): boolean
	local deadline = os.clock() + math.max(0.0002, budgetMs / 1000)
	local guard = 0
	while #self.Tasks > 0 and os.clock() < deadline and guard < 64 do -- gebunden
		guard += 1
		local task = self.Tasks[1]
		local ok, done = pcall(stepTask, self, task, deadline)
		if not ok or done then
			if not ok then
				warn("[CandleStore] Backfill-Fehler: " .. tostring(done))
			end
			table.remove(self.Tasks, 1)
		end
	end
	return #self.Tasks == 0
end

return CandleStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">CatchUp</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Offline-Abgleich: Orders 24 h, Bots 12 h, Dividenden, Alarme, Auto-Transfers
--  (Server/Market/CatchUp)
--  Besitzer: WP4 (Orders, Depot, Bots). Vertrag: DESIGN.md §B8.2 (Auto-Transfer je verpasstem Börsentag, max. 72),
--  §B8.5 (Bots offline 12 h), §C16 (Offline-Abgleich im Hintergrund), MARKET.md §11.5.
--
--  Prinzip: dieselbe Funktion wie online (OrderEngine.Step je Tick) über den verpassten Zeitraum, chronologisch.
--  Ganze Minuten, in denen keine Order und kein Alarm eines Werts auslösen KANN (OrderEngine.CanTrigger mit dem
--  exakten Minuten-Hoch/-Tief und dem halben Spread der Minute), werden übersprungen – Nachzieh-Stopps werden dann
--  mit dem Minuten-Hoch nachgeführt (identisch zu 60 Einzel-Kerzen ohne Auslösung). Bots, Börsentag-Schluss und
--  Dividenden laufen an ihren exakten Ticks. Ergebnis: dieselben Fills wie online (Abnahme WP4 #4).
--  Kerzen kommen sequentiell aus Cursors (MarketService.NewCursor); Minuten-Hoch/-Tief sicher abgeschlossener
--  Minuten werden server-weit gecacht (für alle Spieler gemeinsam).
--
--  Öffentliche API:
--    CatchUp.Run(d, env, toTick, opts): Report        yieldet über opts.Yield (Budget opts.BudgetMs je Scheibe)
--      opts = { Cursor = (i, t0) -> cursor?, Candle = ((i, t) -> (o, h, l, c)?)?, Yield = (() -> ())?,
--               BudgetMs = number?, Now = (() -> number)?, Target = (() -> number)?, Abort = (() -> boolean)? }
--      Target (optional) liefert während des Abgleichs immer wieder den aktuellen Markt-Tick: der Abgleich läuft,
--      bis d.LastTick == Target() ist (ohne Yield zwischen letzter Prüfung und Rückkehr).
--    Report = { Fills, Dividends, Alerts, Expired, Transfers, Days, Bots = { { Preset, Pct } }, Jumped: boolean,
--               Ticks: number, Aborted: boolean }
--    CatchUp.Window(d, toTick): (from, winEnd, botsUntil)   Zeitfenster laut Config.Trading (24 h / 12 h)
--    CatchUp.ClearCache()
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Clock = require(Shared:WaitForChild("Clock"))
local Portfolio = require(script.Parent:WaitForChild("Portfolio"))
local OrderEngine = require(script.Parent:WaitForChild("OrderEngine"))
local BotEngine = require(script.Parent:WaitForChild("BotEngine"))

local CatchUp = {}

type Depot = { [string]: any }
type Env = OrderEngine.Env
type Candle = { number } -- { o, h, l, c }
export type Report = {
	Fills: number,
	Dividends: number,
	Alerts: number,
	Expired: number,
	Transfers: number,
	Days: number,
	Bots: { { Preset: string, Pct: number } },
	Jumped: boolean,
	Ticks: number,
	Aborted: boolean,
}

local DAY = Clock.DAY_TICKS
local MINUTE_CACHE_MAX = 60000
local MAX_ROUNDS = 50 -- Target-Nachlauf: höchstens so oft neu ansetzen (danach läuft der Rest live nach)
local ABORT = "CatchUpAbort" -- Abbruch-Kennung (Spieler hat das Spiel verlassen)

local minuteCache: { [number]: { [number]: { number } } } = {} -- [inst][minute] = { hMax, lMin }
local minuteCount = 0

local function trading(): { [string]: any }
	local t = Config.Trading
	return if type(t) == "table" then t else {}
end

local function num(v: any, fallback: number): number
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return fallback
end

function CatchUp.ClearCache()
	table.clear(minuteCache)
	minuteCount = 0
end

function CatchUp.Window(d: Depot, toTick: number): (number, number, number)
	local cfg = trading()
	local last = math.floor(num(d.LastTick, 0))
	local from = last + 1
	local winEnd = math.min(toTick, last + math.floor(num(cfg.OfflineOrderHours, 24) * 3600))
	local botsUntil = math.min(toTick, last + math.floor(num(cfg.OfflineBotHours, 12) * 3600))
	return from, winEnd, botsUntil
end

-- ---------------------------------------------------------------------
-- Kerzen-Quelle: je Wert ein Cursor (sequentiell billig), Seek nur bei Sprüngen
-- ---------------------------------------------------------------------
type Source = {
	Cursors: { [number]: any },
	Pos: { [number]: number },
	Opts: { [string]: any },
}

local function candleAt(src: Source, i: number, t: number): (number?, number?, number?, number?)
	local cur = src.Cursors[i]
	if cur == nil and src.Opts.Cursor then
		local ok, made = pcall(src.Opts.Cursor, i, t)
		if ok and made then
			cur = made
			src.Cursors[i] = made
			src.Pos[i] = t
		else
			src.Cursors[i] = false
			cur = false
		end
	end
	if cur then
		if src.Pos[i] ~= t then
			local okSeek = pcall(function()
				cur:Seek(t)
			end)
			if not okSeek then
				return nil, nil, nil, nil
			end
		end
		local ok, o, h, l, c = pcall(function()
			return cur:Candle(t)
		end)
		src.Pos[i] = t + 1
		if ok and type(o) == "number" then
			return o, h, l, c
		end
		return nil, nil, nil, nil
	end
	if src.Opts.Candle then
		local ok, o, h, l, c = pcall(src.Opts.Candle, i, t)
		if ok and type(o) == "number" then
			return o, h, l, c
		end
	end
	return nil, nil, nil, nil
end

-- Kerzen der Ticks a … b (eine Minute oder ein Teil davon) + Hoch/Tief
local function loadCandles(src: Source, i: number, a: number, b: number): ({ Candle? }, number, number)
	local list: { Candle? } = {}
	local hMax, lMin = -math.huge, math.huge
	for t = a, b do
		local o, h, l, c = candleAt(src, i, t)
		if type(o) == "number" and type(h) == "number" and type(l) == "number" and type(c) == "number" then
			list[t - a + 1] = { o, h, l, c }
			if h > hMax then
				hMax = h
			end
			if l < lMin then
				lMin = l
			end
		end
	end
	return list, hMax, lMin
end

local function cacheMinute(i: number, minute: number, hMax: number, lMin: number)
	if minuteCount >= MINUTE_CACHE_MAX then
		CatchUp.ClearCache()
	end
	local perInst = minuteCache[i]
	if not perInst then
		perInst = {}
		minuteCache[i] = perInst
	end
	if perInst[minute] == nil then
		perInst[minute] = { hMax, lMin }
		minuteCount += 1
	end
end

-- ---------------------------------------------------------------------
-- Ein Zeitraum [from, to] chronologisch
-- ---------------------------------------------------------------------
local function runRange(d: Depot, env: Env, from: number, to: number, src: Source, slice: () -> ())
	local divCache: { [number]: { { [string]: number } } } = {}
	local function divsAt(t: number): { { [string]: number } }?
		local day = t // DAY
		local list = divCache[day]
		if list == nil then
			local ok, result = pcall(env.Dividends, day * DAY, day * DAY + DAY - 1)
			list = if ok and type(result) == "table" then result else {}
			divCache[day] = list
		end
		for _, div in ipairs(list :: any) do
			if div.Tick == t then
				return list
			end
		end
		return nil
	end

	local t = from
	while t <= to do
		local minute = t // 60
		local mStart = minute * 60
		local mEnd = math.min(to, mStart + 59)
		local complete = mEnd == mStart + 59 and mEnd < env.CacheBefore

		-- 1) Welche Werte müssen in dieser Minute Tick für Tick laufen?
		local arrays: { [number]: { Candle? } } = {}
		local summary: { [number]: { number } } = {}
		local need: { [number]: boolean } = {}
		local hsOf: { [number]: number } = {}
		local function prepare(i: number)
			if summary[i] then
				return
			end
			hsOf[i] = OrderEngine.HalfSpread(env, i, mStart)
			local cached = complete and minuteCache[i] and minuteCache[i][minute]
			if cached then
				summary[i] = cached
			else
				local list, hMax, lMin = loadCandles(src, i, mStart, mEnd)
				arrays[i] = list
				summary[i] = { hMax, lMin }
				if complete and hMax > -math.huge then
					cacheMinute(i, minute, hMax, lMin)
				end
			end
		end
		local function ensureArray(i: number)
			if arrays[i] == nil then
				arrays[i] = (loadCandles(src, i, mStart, mEnd))
			end
		end
		for _, i in ipairs(OrderEngine.ActiveInstruments(d)) do
			prepare(i)
			local s = summary[i]
			if s[1] > -math.huge and OrderEngine.CanTrigger(d, i, s[1], s[2], hsOf[i]) then
				need[i] = true
				ensureArray(i)
			end
		end

		-- 2) Ticks der Minute
		local stepCtx = {
			Candle = function(_i: number): (number?, number?, number?, number?)
				return nil, nil, nil, nil
			end,
			Divs = nil :: any,
		}
		for tt = t, mEnd do
			local divs = divsAt(tt)
			local anyNeed = next(need) ~= nil
			if tt % 60 == 0 or tt % DAY == 0 or anyNeed or divs ~= nil then
				stepCtx.Candle = function(i: number): (number?, number?, number?, number?)
					if not need[i] then
						return nil, nil, nil, nil
					end
					local list = arrays[i]
					local candle = list and list[tt - mStart + 1]
					if candle then
						return candle[1], candle[2], candle[3], candle[4]
					end
					return nil, nil, nil, nil
				end
				stepCtx.Divs = divs
				OrderEngine.Step(d, env, tt, stepCtx)
				-- neue Orders mitten in der Minute (Bots, Klammern): ab dem nächsten Tick einzeln prüfen
				for _, i in ipairs(OrderEngine.ActiveInstruments(d)) do
					if not need[i] then
						prepare(i)
						ensureArray(i)
						-- bisherige Ticks dieser Minute (bis einschließlich tt) als "ohne Auslösung" nachführen
						local list = arrays[i]
						local hMax = -math.huge
						for k = mStart, tt do
							local candle = list and list[k - mStart + 1]
							if candle and candle[2] > hMax then
								hMax = candle[2]
							end
						end
						if hMax > -math.huge then
							OrderEngine.SkipMinute(d, i, hMax, hsOf[i])
						end
						need[i] = true
					end
				end
			else
				d.LastTick = tt
			end
		end

		-- 3) Werte ohne Einzelprüfung: Nachzieh-Stopps mit dem Minuten-Hoch nachführen
		for i, s in pairs(summary) do
			if not need[i] and s[1] > -math.huge then
				OrderEngine.SkipMinute(d, i, s[1], hsOf[i])
			end
		end
		d.LastTick = mEnd
		t = mEnd + 1
		slice()
	end
end

-- Abwesenheit länger als das Order-Fenster: Rest überspringen (alle Orders sind dann abgelaufen)
local function jump(d: Depot, env: Env, winEnd: number, toTick: number)
	OrderEngine.Expire(d, env, toTick)
	local rec = Portfolio.CurrentDay(d)
	if rec then
		rec[3] = OrderEngine.NavAt(d, env, winEnd)
		rec[6] = 0 -- unvollständiger Zeitraum zählt nie für die Liga
	end
	d.LastTick = toTick
	Portfolio.OpenDay(d, toTick // DAY, OrderEngine.NavAt(d, env, toTick), next(d.Pos) ~= nil)
end

function CatchUp.Run(d: Depot, env: Env, toTick: number, opts: { [string]: any }): Report
	local report: Report = {
		Fills = 0,
		Dividends = 0,
		Alerts = 0,
		Expired = 0,
		Transfers = 0,
		Days = 0,
		Bots = {},
		Jumped = false,
		Ticks = 0,
		Aborted = false,
	}
	local budget = num(opts.BudgetMs, 2) / 1000
	local clock: () -> number = if type(opts.Now) == "function" then opts.Now else os.clock
	local sliceStart = clock()
	local function slice()
		if opts.Yield and clock() - sliceStart >= budget then
			opts.Yield()
			sliceStart = clock()
			-- Spieler weg? Abbrechen – der Stand ist an jeder Minutengrenze vollständig (LastTick = Minutenende),
			-- der nächste Beitritt rechnet genau dort weiter.
			if type(opts.Abort) == "function" and opts.Abort() then
				error(ABORT, 0)
			end
		end
	end

	local src: Source = { Cursors = {}, Pos = {}, Opts = opts }
	local startLast = math.floor(num(d.LastTick, 0))
	local _, firstWinEnd, firstBotsUntil = CatchUp.Window(d, toTick)
	-- Bot-Bilanz: Wert am Anfang merken, Geldflüsse der Bot-Fills über den ganzen Zeitraum mitschreiben
	local botStart: { [number]: number } = {}
	local botCash: { [number]: number } = {}
	if type(d.Bots) == "table" then
		for index, slot in ipairs(d.Bots) do
			if BotEngine.Preset(slot.Preset) then
				botStart[index] = BotEngine.Value(d, env, startLast, slot)
				botCash[index] = 0
			end
		end
	end

	-- Ereignisse zählen, dann an die eigentliche Env weiterreichen
	local transfers = 0
	local transferCfg = trading().Transfer
	local maxTransfers = math.floor(num(type(transferCfg) == "table" and transferCfg.MaxOfflineDays, 72))
	env.NoAutoTransfer = if maxTransfers <= 0 then true else nil
	local innerEmit = env.Emit
	env.Emit = function(kind: string, data: any)
		if kind == "Fill" then
			report.Fills += 1
			local f = data.Fill
			local slotIndex = data.BotSlot
			if f and type(slotIndex) == "number" and botCash[slotIndex] ~= nil then
				local cash = f.Q * f.Px
				botCash[slotIndex] += if f.Side == "B" then -(cash + f.Fee) else cash - f.Fee
			end
		elseif kind == "Dividend" then
			report.Dividends += math.floor(num(data.Cents, 0))
		elseif kind == "Alert" then
			report.Alerts += 1
		elseif kind == "Expired" then
			report.Expired += 1
		elseif kind == "Transfer" then
			report.Transfers += math.floor(num(data.Cents, 0))
			transfers += 1
			if transfers >= maxTransfers then
				env.NoAutoTransfer = true -- höchstens 72 verpasste Börsentage (§B8.2)
			end
		elseif kind == "DayResult" then
			report.Days += 1
		end
		innerEmit(kind, data)
	end

	-- Bots offline höchstens 12 h; Ticks NACH dem Beitritt (toTick) sind Online-Zeit -> Bots entscheiden wieder
	env.BotsUntil = firstBotsUntil
	env.BotsFrom = toTick
	local ok, err = pcall(function()
		local rounds = 0
		local target = toTick
		while rounds < MAX_ROUNDS do
			rounds += 1
			local last = math.floor(num(d.LastTick, 0))
			if last >= target then
				break
			end
			local winEnd = math.min(target, firstWinEnd)
			if last + 1 <= winEnd then
				runRange(d, env, last + 1, winEnd, src, slice)
			end
			if math.floor(num(d.LastTick, 0)) < target then
				if winEnd < target then
					jump(d, env, winEnd, target)
					report.Jumped = true
				end
			end
			-- Markt ist inzwischen weitergelaufen? -> Rest ebenfalls nachholen (wieder mit denselben Fenstern)
			if type(opts.Target) == "function" then
				local okTarget, now = pcall(opts.Target)
				if okTarget and type(now) == "number" and now > target then
					target = now
					if report.Jumped then
						firstWinEnd = target -- nach einem Sprung ist das Fenster der Rest bis jetzt
					end
				end
			end
		end
	end)
	env.Emit = innerEmit
	env.BotsUntil = nil
	env.BotsFrom = nil
	env.NoAutoTransfer = nil
	if not ok and err ~= ABORT then
		warn("[CatchUp] Abgleich abgebrochen: " .. tostring(err))
	end
	report.Aborted = not ok and err == ABORT
	report.Ticks = math.max(0, math.floor(num(d.LastTick, 0)) - startLast)

	-- Bot-Bilanz in Prozent des Startkapitals (Wert am Anfang bzw. Tageskapital)
	if type(d.Bots) == "table" then
		local endTick = math.floor(num(d.LastTick, 0))
		for index, slot in ipairs(d.Bots) do
			local startValue = botStart[index]
			if startValue ~= nil and (slot.On == true or startValue > 0) then
				local endValue = BotEngine.Value(d, env, endTick, slot)
				local base = math.max(startValue, math.floor(num(slot.DayNav, 0)), 1)
				local pct = (endValue + (botCash[index] or 0) - startValue) / base
				table.insert(report.Bots, { Preset = slot.Preset, Pct = math.floor(pct * 10000 + 0.5) / 10000 })
			end
		end
	end
	return report
end

return CatchUp
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Dividends</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Dividenden-Regeln (Server/Market/Dividends)
--  Besitzer: WP3 (Markt-Engine). Vertrag: MARKET.md §6.3, §13 Nr. 7, §18.1; DESIGN.md §B6.1.
--  Zahler (DivBps > 0) schütten an ihrem Quartalstag ((Börsentag + Id) % 3 == 0) um :19 aus.
--  Betrag je Aktie = round(mid · DivBps / 10000) (mid OHNE diese Dividende, im Ex-Tick); im selben Tick fällt
--  der Kurs um genau diesen Betrag: E_i += ln(1 − div / mid) -> Dividenden-Mitnahme bringt nichts.
--  Anspruch = Bestand im Ex-Tick. Die Gutschrift ins Depot macht WP4 (Portfolio.Credit, Grund "Dividend",
--  Depot-Schreibtrichter §C11.4 Nr. 3) über MarketService.Dividends(t0, t1) – auch offline nachgerechnet.
--
--  Öffentliche API (rein, ohne Zustand)
--    Dividends.IsPayDay(id, day, everyDays): boolean
--    Dividends.ExTick(id, day, divBps, config): number?      Ex-Tick an diesem Börsentag oder nil
--    Dividends.PerShare(mid, bps): number                     Cent je Aktie (0 … mid − 1)
--    Dividends.LogDrop(mid, cents): number                    ln(1 − cents / mid) (≤ 0)
--    Dividends.Payout(perShare, qty): number                  Cent für einen Bestand (ganzzahlig)
-- =====================================================================

local Dividends = {}

function Dividends.IsPayDay(id: number, day: number, everyDays: number): boolean
	return (day + id) % math.max(1, everyDays) == 0
end

function Dividends.ExTick(id: number, day: number, divBps: number, config: { [string]: any }): number?
	if divBps <= 0 or not Dividends.IsPayDay(id, day, config.Earnings.EveryDays) then
		return nil
	end
	return day * config.DayTicks + config.Dividend.Minute * 60
end

function Dividends.PerShare(mid: number, bps: number): number
	if mid <= 1 or bps <= 0 then
		return 0
	end
	return math.clamp(math.round(mid * bps / 10000), 0, mid - 1)
end

function Dividends.LogDrop(mid: number, cents: number): number
	if mid <= 0 or cents <= 0 then
		return 0
	end
	return math.log(1 - math.min(cents, mid - 1) / mid)
end

function Dividends.Payout(perShare: number, qty: number): number
	if perShare <= 0 or qty <= 0 then
		return 0
	end
	return math.floor(perShare) * math.floor(qty)
end

return Dividends
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">EventDirector</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Deterministischer Tagesplan & Event-Beiträge (Server/Market/EventDirector)
--  Besitzer: WP3 (Markt-Engine). Vertrag: MARKET.md §5.4, §6.1–§6.6, §8.4, §17; DESIGN.md §B6.1, §B6.3, §B10.4, §B15.3.
--  Eine Instanz je Woche ("Wochen-Kontext"). Der Plan entsteht zustandslos aus Seed + Börsentag (kein Random-Objekt);
--  wegen der Bewertungs-Bremse werden die Tage ab Wochenstart SEQUENTIELL gebaut und gecacht.
--  Der Server kennt den Plan, schickt aber nie Zukünftiges: News gehen erst bei t_a hinaus (MarketService).
--
--  Kursbeitrag E_i(t) = Σ abgeschlossene, dauerhafte Anteile (Präfix-Summen) + Σ aktive Beiträge (Rampe/Rückbildung)
--                     + Dividenden-Abschläge (Ex-Tick) + bedingte Beiträge (Samstags-Show) + externe Admin-Events.
--  Formen: 1 News mit Übertreibung · 2 Rampe auf Dauerwert · 3 Crash/Rallye (Fall + Teil-Erholung) ·
--          4 Admin-Beule (Rampe, Abklingen auf 0, Normalisieren blendet aus)
--
--  Öffentliche API (nur Server, nur innerhalb WP3)
--    EventDirector.new(params): Director
--    d:EnsureBuilt(day, maxDays?): boolean        baut sequentiell bis zum Börsentag (globaler Index), höchstens maxDays
--    d:BuiltThrough(): number                       d:SetPriceHook(fn(i, t, divFrom) -> midCents)
--    d:Offset(i, t, divFrom?): (number, boolean)    Log-Beitrag, News aktiv?
--    d:VolMul(t): number                            Volatilitäts-Faktor (Crash/Rallye/Admin), Produkt, geklemmt
--    d:Halted(i, t): (boolean, number)              Handelspause? (+ Ende)
--    d:CrashRally(t): (boolean, boolean)            Crash/Rallye aktiv (Frame-Flags)
--    d:NewsIn(t0, t1): { NewsItem }                 veröffentlichte News mit t0 < T ≤ t1 (Plan + extern, gefiltert)
--    d:MessagesAt(t): { {Kind, Data} }              Market-Remote-Nachrichten dieses Ticks (Event/Halt/Ipo)
--    d:Dividends(t0, t1): { {I, Tick, Cents} }      Ex-Ticks im Bereich (nur Vergangenheit sinnvoll)
--    d:ExDay(i, t): boolean                         Ex-Tag-Flag (Börsentag mit Dividende, bis einschließlich Ex-Tick)
--    d:Calendar(t0, t1): { CalendarItem }           Termine im Bereich (nur geplante Arten, nie zufällige News)
--    d:Profile(i, now, leadSeconds): { … }          Fundamentaldaten + Analysten (Trefferquote live gemessen)
--    d:FactNewsFor(i, t, window): NewsItem?         letzte Fakten-News (Fakt/Bestätigung/Dementi/Zahlen) zu i
--    d:AddExternal(ev, carry?): { number }          Admin-Event (GlobalBus) anwenden -> betroffene Ids
--    d:AddLocalHalt(ids?, from, untilTick)          serverlokale Pause (verspätetes Bus-Event, §8.4)
--    d:AddListing(i, rec) · d:Listing(i) · d:IsListed(i, t) · d:Drift(i) · d:Quality(i) · d:Slots()
--    d:CondOk(cond, t?) · d:AutoShowCut(): number?   Samstags-Show-Absage gilt ab dem Start-Tick des Bus-Events
--    d:Windows(): { {From, To} }                    Admin-Fenster aus externen Events
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Noise = require(script.Parent:WaitForChild("Noise"))
local MarketClock = require(script.Parent:WaitForChild("MarketClock"))
local Dividends = require(script.Parent:WaitForChild("Dividends"))

local EventDirector = {}
EventDirector.__index = EventDirector

type NewsItem = Types.NewsItem
type CalendarItem = Types.CalendarItem

-- Formen
local SHAPE_NEWS = 1
local SHAPE_RAMP = 2
local SHAPE_CRASH = 3
local SHAPE_BUMP = 4

-- Hash-Kanäle (fest, nie ändern – sonst ändert sich jeder Plan)
local CH_DAY = 0xDA7 -- globaler Tages-Strom
local CH_INST = 0x1000 -- + Id: Firmen-Strom
local CH_Q = 0x51A -- Qualität q
local CH_EARN = 0xEA1 -- Quartals-Überraschung z
local CH_EARN_PRE = 0xEA2 -- synthetische Vor-Quartale
local CH_ANALYST = 0xA7A
local CH_MACRO = 0xAC0
local CH_SENS = 0x5E5
local CH_IPO = 0x1F0
local CH_FUND = 0xF00D

local TWO32 = 4294967296

export type Effect = {
	S0: number, -- Sortier-Tick (Veröffentlichung)
	T1: number, -- Beginn der Kursreaktion
	Shape: number,
	J: number,
	O: number, -- Übertreibung
	A: number, -- Rampe bzw. Fall
	B: number, -- Rückbildung/Erholung/Abklingen
	R: number, -- Erholungs-Anteil (Crash)
	F: number, -- Dauerwert nach End
	End: number,
	News: boolean,
	Val: boolean,
	Cond: string?,
	Kill: number?,
	SubAt: number?, -- Übertrag aus der Vorwoche: Beitrag relativ zu diesem Tick (Wochenschluss)
	Start0: number, -- ursprünglicher Start (für Normalisieren über den Wochenwechsel)
}

export type VolShape = {
	S0: number,
	T1: number,
	End: number,
	Kind: number, -- 1 Warn (linear) · 2 Crash (Fall -> Spitze -> 1) · 3 Admin-Vol (Rampe/Halten/Rampe) · 4 Admin-Beule
	A: number,
	B: number,
	V0: number,
	V1: number,
	Peak: number,
	Cond: string?,
	Kill: number?,
}

export type Halt = { All: boolean, I: number?, From: number, Until: number, Cond: string?, Ext: boolean }

export type Slot = {
	Id: number,
	Name: string,
	Class: string,
	Sector: string,
	SectorIdx: number,
	Start: number,
	DivBps: number,
	Base: number, -- Wochenbasis in Cent (Wochenschluss der Vorwoche bzw. Eröffnungskurs)
	ValBase: number, -- Basis für die Bewertungs-Bremse (beim Anlegen der Woche fest, nie durch Admin-IPOs verändert)
	Ipo: boolean,
	Origin: number, -- ab diesem Tick zählt das Instrument (Wochenstart oder Erstnotiz)
	ValOrigin: number, -- ab diesem Tick zählen Sprünge für die Bewertungs-Bremse (unabhängig von Admin-IPOs)
}

export type Listing = { T0: number, Issue: number, Open: number, Pop: number, Q: number, By: number }

type Msg = { T: number, Kind: string, Data: { [string]: any }, Cond: string? }
type Plain = { [string]: any }

local function smooth(x: number): number
	if x <= 0 then
		return 0
	elseif x >= 1 then
		return 1
	end
	return x * x * (3 - 2 * x)
end

local function sign(x: number): number
	return if x < 0 then -1 else 1
end

-- erster Index k mit list[k] > value (0, wenn keiner ≤ value); list aufsteigend
local function upperBound(list: { number }, value: number, lo: number?): number
	local a, b = lo or 1, #list
	if b == 0 or list[b] <= value then
		return b
	end
	while a <= b do
		local m = (a + b) // 2
		if list[m] <= value then
			a = m + 1
		else
			b = m - 1
		end
	end
	return a - 1
end

-- ---------------------------------------------------------------------
-- KONSTRUKTOR
-- params = { Seed, Week, Config (Config.Market), Companies (Config.Companies), News (Config.News),
--            Slots { Slot }, NewsMeanGap, Listings { [id] = Listing }, IsCancelled: (week) -> boolean }
-- ---------------------------------------------------------------------
function EventDirector.new(params: Plain)
	local cfg = params.Config
	local self = setmetatable({}, EventDirector) :: any
	self.Seed = math.floor(params.Seed) % 2147483648
	self.Week = params.Week
	self.WeekStart = MarketClock.WeekStart(params.Week)
	self.WeekEnd = MarketClock.WeekEnd(params.Week)
	self.FirstDay = MarketClock.DayIndex(self.WeekStart)
	self.LastDay = MarketClock.DayIndex(self.WeekEnd)
	self.Cfg = cfg
	self.Companies = params.Companies
	self.NewsCfg = params.News
	self.Gap = math.clamp(tonumber(params.NewsMeanGap) or cfg.NewsMeanGap or 1500, 300, 6000)
	self.IsCancelled = params.IsCancelled
	self.Delay = cfg.Delay
	self.Tau = cfg.Tau
	self.OverDecay = cfg.Overshoot.Decay
	self.OverSpan = cfg.Overshoot.Span
	self.MaxSpan = 0 -- längste gemessene Plan-Wirkung (End − S0), wächst beim Einsortieren
	self.MaxVolSpan = math.max(3700, (cfg.Admin.MaxSpan or 3600) + 600)
	self.PriceHook = nil :: ((number, number, number) -> number)?

	self.SlotList = {} :: { Slot }
	self.SlotById = {} :: { [number]: Slot }
	self.Q = {} :: { [number]: number }
	self.DriftT = {} :: { [number]: number }
	self.Rate = {} :: { [number]: { [number]: number } } -- Drift je Tick, je Börsentag der Woche (0…503)
	self.Cum = {} :: { [number]: { [number]: number } } -- aufgelaufene Drift (log) zum Tagesbeginn
	self.CumAll = {} :: { [number]: number }
	self.DriftSum = {} :: { [number]: number } -- Drift seit ValOrigin (für die Bewertung)
	self.OriginDrift = {} :: { [number]: number }
	self.Val = {} :: { [number]: number }
	self.Eff = {} :: { [number]: { Effect } }
	self.EffS0 = {} :: { [number]: { number } }
	self.Pre = {} :: { [number]: { number } }
	self.Pend = {} :: { [number]: { Effect } }
	self.CondEff = {} :: { [number]: { Effect } }
	self.Div = {} :: { [number]: { Plain } }
	self.DivT = {} :: { [number]: { number } }
	self.DivCum = {} :: { [number]: { [number]: number } }
	self.DivDone = {} :: { [number]: number }
	self.Ext = {} :: { [number]: { Effect } }
	self.OriginK = {} :: { [number]: number }
	for _, slot in ipairs(params.Slots :: { Slot }) do
		table.insert(self.SlotList, slot)
		self.SlotById[slot.Id] = slot
		local q = Noise.Uni(self.Seed, CH_Q, slot.Id, 0)
		self.Q[slot.Id] = q
		self.DriftT[slot.Id] = (cfg.Drift.Base + cfg.Drift.Quality * q) / MarketClock.DAY
		self.Rate[slot.Id] = {}
		self.Cum[slot.Id] = {}
		self.CumAll[slot.Id] = 0
		self.DriftSum[slot.Id] = 0
		self.Val[slot.Id] = 0
		self.Eff[slot.Id] = {}
		self.EffS0[slot.Id] = {}
		self.Pre[slot.Id] = { [0] = 0 } :: any
		self.Pend[slot.Id] = {}
		self.CondEff[slot.Id] = {}
		self.Div[slot.Id] = {}
		self.DivT[slot.Id] = {}
		self.DivCum[slot.Id] = { [0] = 0 } :: any
		self.DivDone[slot.Id] = 0
		self.Ext[slot.Id] = {}
		self.OriginK[slot.Id] = 0
	end
	self.Listings = {} :: { [number]: Listing }
	for id, rec in pairs((params.Listings or {}) :: { [number]: Listing }) do
		self.Listings[id] = rec
	end

	self.News = {} :: { Plain } -- Plan-News (sortiert nach T), Einträge { Item, Cond?, DivOf? }
	self.NewsT = {} :: { number }
	self.PendNews = {} :: { Plain }
	self.ExtNews = {} :: { Plain }
	self.Vol = {} :: { VolShape }
	self.VolS0 = {} :: { number }
	self.Halts = {} :: { Halt }
	self.Msgs = {} :: { Msg }
	self.MsgT = {} :: { number }
	self.ExtMsgs = {} :: { Msg }
	self.CrashSpans = {} :: { { number } } -- { von, bis, 1 = Crash / 2 = Rallye, Cond? }
	self.DayData = {} :: { [number]: Plain }
	self.Built = self.FirstDay - 1
	self.LastCrashT = -math.huge
	self.WindowList = {} :: { { number } }
	self.NewsSeq = {} :: { [number]: number }
	return self
end

function EventDirector.SetPriceHook(self: any, fn: (number, number, number) -> number)
	self.PriceHook = fn
end

function EventDirector.BuiltThrough(self: any): number
	return self.Built
end

function EventDirector.Slots(self: any): { Slot }
	return self.SlotList
end

function EventDirector.Quality(self: any, i: number): number
	return self.Q[i] or 0
end

-- Drift steckt im Beitrag (Offset); die PriceEngine bekommt Drift = 0. Hier nur zur Anzeige: Grund-Drift je Tick.
function EventDirector.Drift(self: any, i: number): number
	return self.DriftT[i] or 0
end

-- aufgelaufene Fundament-Drift (log) bei Tick t relativ zum Wochenstart; nil, wenn der Tag noch nicht gebaut ist
local function driftAt(self: any, i: number, t: number): number?
	local d = MarketClock.DayIndex(t) - self.FirstDay
	local rates = self.Rate[i]
	local rate = rates and rates[d]
	if rate == nil then
		return nil
	end
	return self.Cum[i][d] + rate * (t - (self.FirstDay + d) * MarketClock.DAY)
end

function EventDirector.DriftOffset(self: any, i: number, t: number): number
	local slot = self.SlotById[i]
	if slot == nil then
		return 0
	end
	local now = driftAt(self, i, t)
	if now == nil then
		return 0
	end
	local origin = slot.Origin
	if origin <= self.WeekStart then
		return now
	end
	local base = self.OriginDrift[i]
	if base == nil then
		base = driftAt(self, i, origin)
		if base == nil then
			return 0
		end
		self.OriginDrift[i] = base
	end
	return now - base
end

function EventDirector.Listing(self: any, i: number): Listing?
	return self.Listings[i]
end

function EventDirector.IsListed(self: any, i: number, t: number): boolean
	local slot = self.SlotById[i]
	if not slot then
		return false
	end
	if not slot.Ipo then
		return true
	end
	local rec = self.Listings[i]
	return rec ~= nil and t >= rec.T0
end

function EventDirector.AddListing(self: any, i: number, rec: Listing)
	self.Listings[i] = rec
	local slot = self.SlotById[i]
	if slot then
		slot.Origin = rec.T0
		slot.Base = rec.Open
		self.OriginK[i] = upperBound(self.EffS0[i], rec.T0 - 1)
		self.OriginDrift[i] = nil
	end
	local hook = self.ListingHook
	if type(hook) == "function" then
		hook(i, rec)
	end
end

-- MarketService meldet sich hier an, um neue Erstnotizen in die PriceEngine zu übernehmen
function EventDirector.SetListingHook(self: any, fn: (number, Listing) -> ())
	self.ListingHook = fn
end

-- ---------------------------------------------------------------------
-- ZUFALL (zustandslos aus Seed): globaler Tages-Strom und Firmen-Ströme mit festen Blöcken
-- ---------------------------------------------------------------------
function EventDirector.R(self: any, day: number, k: number): number
	return Noise.Hash4(self.Seed, CH_DAY, day, k) / TWO32
end

function EventDirector.RI(self: any, i: number, day: number, k: number): number
	return Noise.Hash4(self.Seed, CH_INST + i, day, k) / TWO32
end

-- Klasse für den PLAN (News-Faktor, Crash-Beta): immer die eigene Klasse, damit der Plan nie davon abhängt, ob/wann
-- ein Admin-IPO bekannt wurde (Determinismus). Die Wild-Volatilität am ersten Börsentag macht die PriceEngine.
local function classOf(self: any, slot: Slot, _t: number): Plain
	local classes = self.Cfg.Classes
	return classes[slot.Class] or classes.Normal
end

local function bandOf(self: any, u: number): number
	local acc = 0
	for index, band in ipairs(self.Cfg.Bands) do
		acc += band.P
		if u <= acc then
			return index
		end
	end
	return #self.Cfg.Bands
end

-- Stärke-Band aus einem Log-Sprung (für Crash, Zahlen, Admin): Grenzen der Bänder der Klasse Normal
local function bandFromMove(self: any, move: number): number
	local a = math.abs(move)
	local bands = self.Cfg.Bands
	for index = #bands, 1, -1 do
		if a >= bands[index].Lo then
			return index
		end
	end
	return 1
end

-- Bewertung C = ln(Wochenbasis / Startkurs) + Drift seit Wochenstart + dauerhafte Sprünge der Woche (Plan)
local function valuation(self: any, slot: Slot): number
	local base = math.max(1, slot.ValBase)
	local start = math.max(1, slot.Start)
	return math.log(base / start) + self.DriftSum[slot.Id] + self.Val[slot.Id]
end

local function posProb(self: any, slot: Slot, _dayStart: number): number
	local brake = self.Cfg.Brake
	local c = valuation(self, slot)
	local p = brake.PosBase
	for _, step in ipairs(brake.Steps) do
		if c > step.Above then
			p = step.PosP
		elseif c < -step.Above then
			p = 1 - step.PosP
		end
	end
	return p
end

-- ---------------------------------------------------------------------
-- PLAN-BAUSTEINE
-- ---------------------------------------------------------------------
local function newEffect(s0: number, t1: number, shape: number, j: number, a: number, b: number): Effect
	return {
		S0 = s0,
		T1 = t1,
		Shape = shape,
		J = j,
		O = 0,
		A = a,
		B = b,
		R = 0,
		F = j,
		End = t1 + a + b,
		News = true,
		Val = true,
		Cond = nil,
		Kill = nil,
		SubAt = nil,
		Start0 = s0,
	}
end

local function pushNews(list: { Plain }, t: number, kind: string, key: string, args: Plain, extra: Plain?): Plain
	local item: Plain = { T = t, Kind = kind, Key = key, Args = args }
	if extra then
		for k, v in pairs(extra) do
			item[k] = v
		end
	end
	local wrap: Plain = { Item = item }
	table.insert(list, wrap)
	return wrap
end

function EventDirector.NewsArgsName(self: any, i: number): string
	local slot = self.SlotById[i]
	return if slot then slot.Name else tostring(i)
end

local function pick(list: { string }, u: number): string
	return list[math.clamp(1 + math.floor(u * #list), 1, #list)]
end

-- Quartalszahlen eines Börsentags (rein aus den Regeln + Hash, unabhängig von der Bremse)
function EventDirector.EarningsFor(self: any, day: number): { Plain }
	local cache = self.EarnCache
	if cache == nil then
		cache = {}
		self.EarnCache = cache
	end
	local hit = cache[day]
	if hit then
		return hit
	end
	local cfg = self.Cfg
	local earn = cfg.Earnings
	local dayStart = MarketClock.DayStart(day)
	local list: { Plain } = {}
	local ids: { number } = {}
	for _, slot in ipairs(self.SlotList) do
		if (day + slot.Id) % earn.EveryDays == 0 then
			table.insert(ids, slot.Id)
		end
	end
	table.sort(ids)
	local analysts = cfg.Analysts
	for index, id in ipairs(ids) do
		local slot = self.SlotById[id]
		local minute = earn.Slots[((index - 1) // 3) % #earn.Slots + 1]
		local t = dayStart + minute * 60
		local q = self.Q[id] or 0
		local s = earn.SurpriseQ * q + earn.SurpriseZ * Noise.Gauss(self.Seed, CH_EARN, id, day)
		local cls = classOf(self, slot, t)
		local j = math.clamp(earn.JumpPerS * s * cls.NewsFactor, -earn.JumpMax, earn.JumpMax)
		local verdicts: { { number } } = {}
		local used: { [number]: boolean } = {}
		local n = math.min(earn.Covering, #analysts)
		local k = 0
		while #verdicts < n and k < 64 do -- gebunden: höchstens 64 Versuche
			k += 1
			local a = 1 + Noise.Hash4(self.Seed, CH_ANALYST, id * 4096 + day % 4096, k) % #analysts
			if not used[a] then
				used[a] = true
				local right = Noise.Rnd(self.Seed, CH_ANALYST + 1, id * 64 + a, day) < analysts[a].Accuracy
				table.insert(verdicts, { a, if right then sign(s) else -sign(s) })
			end
		end
		local growth = cfg.Fundamentals.GrowthBase + cfg.Fundamentals.GrowthQ * q
		table.insert(list, {
			I = id,
			T = t,
			Minute = minute,
			S = s,
			J = j,
			Verdicts = verdicts,
			Cons = if growth > 0.005 then "Up" elseif growth < -0.005 then "Down" else "Flat",
		})
	end
	cache[day] = list
	return list
end

function EventDirector.MacroKind(self: any, day: number): string
	local kinds = self.Cfg.Macro.Kinds
	return pick(kinds, self:R(day, 1))
end

-- ---------------------------------------------------------------------
-- BUILD DAY (sequentiell; nur aus Seed, Woche, Basis, Config, eingefrorenem News-Takt)
-- ---------------------------------------------------------------------
function EventDirector.BuildDay(self: any, day: number)
	local cfg = self.Cfg
	local newsCfg = self.NewsCfg
	local delay, tau = self.Delay, self.Tau
	local dayStart = MarketClock.DayStart(day)
	local nextStart = dayStart + MarketClock.DAY
	local dayInWeek = day - self.FirstDay
	local created: { [number]: { Effect } } = {}
	local news: { Plain } = {}
	local msgs: { Msg } = {}
	local data: Plain = { Earnings = {}, Macro = nil, Dividends = {} }
	self.DayData[day] = data

	-- 0) Fundament-Drift dieses Börsentags mit Bewertungsanker (Ornstein-Uhlenbeck je Tag):
	--    Rate = Base + Quality · q − Revert · C  (je Börsentag), C = Bewertung zum Tagesbeginn. Ohne Anker würde die
	--    Drift über 504 Börsentage je Woche exponentiell wachsen; so bleibt der Kurs um Start · e^((Base+Quality·q)/Revert).
	local driftCfg = cfg.Drift
	for _, slot in ipairs(self.SlotList) do
		local i = slot.Id
		local c = valuation(self, slot)
		local rate = driftCfg.Base + driftCfg.Quality * (self.Q[i] or 0) - (driftCfg.Revert or 0) * c
		rate = math.clamp(rate, -(driftCfg.MaxRate or 0.02), driftCfg.MaxRate or 0.02)
		self.Rate[i][dayInWeek] = rate / MarketClock.DAY
		self.Cum[i][dayInWeek] = self.CumAll[i]
		self.CumAll[i] += rate
		if dayStart >= slot.ValOrigin then
			self.DriftSum[i] += rate
		elseif nextStart > slot.ValOrigin then
			self.DriftSum[i] += rate * (nextStart - slot.ValOrigin) / MarketClock.DAY
		end
	end

	local function addEffect(i: number, e: Effect)
		local list = created[i]
		if list == nil then
			list = {}
			created[i] = list
		end
		table.insert(list, e)
	end

	local function addVol(v: VolShape)
		table.insert(self.Vol, v)
		table.insert(self.VolS0, v.S0)
	end

	-- 1) Quartalszahlen (+ Vorschau für Termine, deren Vorschau in diesen Tag fällt) und Dividenden
	local earn = cfg.Earnings
	local previewLead = earn.PreviewMinutes * 60
	for _, e in ipairs(self:EarningsFor(day)) do
		table.insert(data.Earnings, e)
		local slot = self.SlotById[e.I]
		local name = slot.Name
		if math.abs(e.J) > 1e-9 then
			local eff = newEffect(e.T, e.T + delay, SHAPE_RAMP, e.J, tau, 0)
			addEffect(e.I, eff)
		end
		local key = if math.abs(e.J) < earn.InlineBelow
			then newsCfg.Earnings.Inline
			elseif e.J > 0 then newsCfg.Earnings.Beat
			else newsCfg.Earnings.Miss
		local band = bandFromMove(self, e.J)
		pushNews(news, e.T, "Earnings", key, { name = name, band = newsCfg.Bands[band] }, {
			I = e.I,
			Band = band,
			-- "im Rahmen der Erwartungen": keine Richtung (Tiko-Ampel neutral, kein "Gut gelesen")
			Dir = if math.abs(e.J) < earn.InlineBelow then 0 else sign(e.J),
		})
		if e.T - previewLead >= dayStart then
			pushNews(news, e.T - previewLead, "Earnings", newsCfg.Earnings.Preview, {
				name = name,
				min = string.format("%02d", e.Minute),
				cons = newsCfg.Cons[e.Cons],
			}, { I = e.I })
		end
		local exTick = Dividends.ExTick(e.I, day, slot.DivBps, cfg)
		if exTick then
			local divList = self.Div[e.I]
			table.insert(divList, { Tick = exTick, Bps = slot.DivBps, Cents = nil, LogF = nil, K = #divList + 1 })
			table.insert(self.DivT[e.I], exTick)
			if exTick >= slot.ValOrigin then
				-- Bewertung sieht den Dividenden-Abschlag (Nennrendite, preisunabhängig -> deterministisch)
				self.Val[e.I] += math.log(1 - slot.DivBps / 10000)
			end
			table.insert(data.Dividends, { I = e.I, Tick = exTick })
			local wrap = pushNews(news, exTick, "Dividend", newsCfg.Dividend, { name = name }, { I = e.I })
			wrap.DivOf = e.I
		end
	end
	if day + 1 <= self.LastDay then
		for _, e in ipairs(self:EarningsFor(day + 1)) do
			if e.T - previewLead < nextStart then
				pushNews(news, e.T - previewLead, "Earnings", newsCfg.Earnings.Preview, {
					name = self.SlotById[e.I].Name,
					min = string.format("%02d", e.Minute),
					cons = newsCfg.Cons[e.Cons],
				}, { I = e.I })
			end
		end
	end

	-- 2) Makro (:02 Konsens, :10 Ergebnis über die Matrix)
	do
		local macro = cfg.Macro
		local kind = self:MacroKind(day)
		local consU = self:R(day, 2)
		local cons = if consU < 0.4 then "Up" elseif consU < 0.8 then "Down" else "Flat"
		local s = math.clamp(Noise.Gauss(self.Seed, CH_MACRO, day, 0), -macro.SurpriseMax, macro.SurpriseMax)
		local tMacro = dayStart + macro.Minute * 60
		local keys = newsCfg.Macro[kind]
		pushNews(news, dayStart + macro.PreviewMinute * 60, "Macro", keys.Preview, { cons = newsCfg.Cons[cons] })
		data.Macro = { Kind = kind, T = tMacro, S = s }
		if math.abs(s) < macro.FlatBelow then
			pushNews(news, tMacro, "Macro", keys.AsExpected, {}, { Dir = 1 })
		else
			local factors = cfg.Matrix[kind]
			for _, slot in ipairs(self.SlotList) do
				local f = factors[slot.Sector] or 0
				if f ~= 0 then
					local j = macro.BaseJump * f * s * classOf(self, slot, tMacro).NewsFactor
					addEffect(slot.Id, newEffect(tMacro, tMacro + delay, SHAPE_RAMP, j, tau, 0))
				end
			end
			local band = math.clamp(math.floor((math.abs(s) - macro.FlatBelow) * 2) + 1, 1, 4)
			pushNews(
				news,
				tMacro,
				"Macro",
				if s > 0 then keys.Higher else keys.Lower,
				{ band = newsCfg.Bands[band] },
				{ Band = band, Dir = sign(s) }
			)
		end
	end

	-- 3) Firmen-News (Poisson je Firma, eigener Hash-Strom je Id, feste Zufalls-Blöcke je News)
	local kinds = cfg.Kinds
	local rumorCfg = cfg.Rumor
	local quietFrom = self.WeekEnd - cfg.QuietEnd
	for _, slot in ipairs(self.SlotList) do
		local i = slot.Id
		local p = posProb(self, slot, dayStart)
		local n = 0
		local t = -self.Gap * math.log(1 - self:RI(i, day, 1))
		while t < MarketClock.DAY and n < 64 do -- gebunden: höchstens 64 News je Firma und Tag
			local ta = dayStart + math.floor(t)
			local base = 16 * (n + 1)
			n += 1
			local function u(k: number): number
				return self:RI(i, day, base + k)
			end
			if ta <= quietFrom then
				local cls = classOf(self, slot, ta)
				local b = bandOf(self, u(2))
				local bandCfg = cfg.Bands[b]
				local mag = bandCfg.Lo + (bandCfg.Hi - bandCfg.Lo) * u(3)
				local dir = if u(4) < p then 1 else -1
				local j0 = dir * mag * cls.NewsFactor
				local kindU = u(1)
				local kind = if kindU < kinds.Fact
					then "Fact"
					elseif kindU < kinds.Fact + kinds.Rumor then "Rumor"
					else "AsExpected"
				local resolveAt = ta + cfg.RumorResolve
				if kind == "Rumor" and resolveAt + delay + tau > self.WeekEnd then
					kind = "Fact"
				end
				local sectorProducts = newsCfg.Products[slot.Sector] or newsCfg.Products.T
				local buyerId = 1 + math.floor(u(9) * 36) % 36
				if buyerId == i then
					buyerId = buyerId % 36 + 1
				end
				local args: Plain = {
					name = slot.Name,
					band = newsCfg.Bands[b],
					product = pick(sectorProducts, u(8)),
					buyer = self:NewsArgsName(buyerId),
					amt = math.max(1, math.round((0.5 + u(10)) * b * b * 2)),
				}
				local dirKey = if dir > 0 then "Up" else "Down"
				if kind == "Fact" then
					local e = newEffect(ta, ta + delay, SHAPE_NEWS, j0, tau, self.OverDecay)
					e.O = cfg.Overshoot.Max * u(5)
					e.End = ta + delay + tau + self.OverSpan
					addEffect(i, e)
					pushNews(news, ta, "Fact", pick(newsCfg.Fact[dirKey], u(7)), args, { I = i, Band = b, Dir = dir })
				elseif kind == "Rumor" then
					local mix = rumorCfg.StarsMix
					local su = u(6)
					local stars = if su < mix[1] then 1 elseif su < mix[1] + mix[2] then 2 else 3
					local confirmed = u(11) < rumorCfg.Confirm[stars]
					addEffect(i, newEffect(ta, ta + delay, SHAPE_RAMP, 0.5 * j0, tau, 0))
					local second =
						newEffect(resolveAt, resolveAt + delay, SHAPE_RAMP, if confirmed then 0.5 * j0 else -j0, tau, 0)
					addEffect(i, second)
					args.stars = newsCfg.Stars[stars]
					pushNews(news, ta, "Rumor", pick(newsCfg.Rumor[dirKey], u(7)), args, {
						I = i,
						Band = b,
						Stars = stars,
						Dir = dir,
					})
					pushNews(
						news,
						resolveAt,
						if confirmed then "Confirm" else "Deny",
						if confirmed then newsCfg.Confirm else newsCfg.Deny,
						{ name = slot.Name },
						{ I = i, Band = b, Stars = stars, Dir = if confirmed then dir else -dir }
					)
				else
					addEffect(i, newEffect(ta, ta + delay, SHAPE_RAMP, -j0, tau, 0))
					pushNews(news, ta, "AsExpected", pick(newsCfg.AsExpected[dirKey], u(7)), args, {
						I = i,
						Band = b,
						Dir = dir,
					})
				end
			end
			t += -self.Gap * math.log(1 - u(12))
		end
	end

	-- 4) Sektor-News & Themen (globaler Strom, Ø alle 10 min)
	do
		local sec = cfg.Sector
		local k = 100
		local t = -sec.MeanGap * math.log(1 - self:R(day, k))
		local count = 0
		local sectors = self.Companies.Sectors
		while t < MarketClock.DAY and count < 32 do -- gebunden
			count += 1
			local ta = dayStart + math.floor(t)
			local base = 100 + 16 * count
			local function g(j: number): number
				return self:R(day, base + j)
			end
			if ta <= quietFrom then
				if g(1) < sec.ThemeShare then
					local theme = pick(cfg.Themes, g(2))
					local lu = g(3)
					local level = if lu < 0.5 then 1 elseif lu < 0.85 then 2 else 3
					local mult = sec.ThemeMult[level]
					local factors = cfg.Matrix[theme]
					local tone = 0
					for _, factor in pairs(factors) do
						tone += factor
					end
					for _, slot in ipairs(self.SlotList) do
						local f = factors[slot.Sector] or 0
						if f ~= 0 then
							local sens = sec.Sensitivity[1]
								+ (sec.Sensitivity[2] - sec.Sensitivity[1])
									* Noise.Rnd(self.Seed, CH_SENS, slot.Id, day * 64 + count)
							local j = cfg.Macro.BaseJump * f * mult * classOf(self, slot, ta).NewsFactor * sens
							addEffect(slot.Id, newEffect(ta, ta + delay, SHAPE_RAMP, j, tau, 0))
						end
					end
					pushNews(news, ta, "Sector", newsCfg.Theme[theme], { band = newsCfg.Bands[level] }, {
						Band = level,
						Dir = sign(tone),
					})
				else
					local sIndex = math.clamp(1 + math.floor(g(2) * #sectors), 1, #sectors)
					local sectorKey = sectors[sIndex].Key
					local b = bandOf(self, g(3))
					local bandCfg = cfg.Bands[b]
					local mag = bandCfg.Lo + (bandCfg.Hi - bandCfg.Lo) * g(4)
					local dir = if g(5) < cfg.Brake.PosBase then 1 else -1
					for _, slot in ipairs(self.SlotList) do
						if slot.Sector == sectorKey then
							local sens = sec.Sensitivity[1]
								+ (sec.Sensitivity[2] - sec.Sensitivity[1])
									* Noise.Rnd(self.Seed, CH_SENS, slot.Id, day * 64 + count)
							local j = dir * mag * classOf(self, slot, ta).NewsFactor * sens
							addEffect(slot.Id, newEffect(ta, ta + delay, SHAPE_RAMP, j, tau, 0))
						end
					end
					pushNews(
						news,
						ta,
						"Sector",
						if dir > 0 then newsCfg.Sector.Up else newsCfg.Sector.Down,
						{ sector = newsCfg.Sectors[sectorKey], band = newsCfg.Bands[b] },
						{ Sector = sectorKey, Band = b, Dir = dir }
					)
				end
			end
			t += -sec.MeanGap * math.log(1 - g(15))
		end
	end

	-- gemeinsamer Baustein: Crash/Rallye mit Warnphase (Plan, Wochen-Termin oder bedingte Samstags-Show)
	local function crashRally(spec: Plain)
		local cr = cfg.CrashRally
		local tw, tc = spec.Warn, spec.Main
		local t1 = tc + delay
		local fall, recover, share = spec.Fall, spec.Recover, spec.Share
		local isCrash = spec.Crash
		local maxBand = 1
		for _, slot in ipairs(self.SlotList) do
			if spec.Sector == nil or slot.Sector == spec.Sector then
				local cls = classOf(self, slot, tc)
				local move = math.min(cr.MaxMove, spec.Strength * cls.CrashBeta)
				local j = if isCrash then math.log(1 - move) else math.log(1 + move)
				local e = newEffect(tw, t1, SHAPE_CRASH, j, fall, recover)
				e.R = share
				e.F = j * (1 - share)
				e.End = t1 + fall + recover
				e.Val = spec.Val
				e.Cond = spec.Cond
				if spec.Cond then
					table.insert(self.CondEff[slot.Id], e)
				else
					addEffect(slot.Id, e)
				end
				maxBand = math.max(maxBand, bandFromMove(self, move * 0.5))
			end
		end
		local warnShape: VolShape = {
			S0 = tw,
			T1 = tw,
			End = t1,
			Kind = 1,
			A = math.max(1, t1 - tw),
			B = 0,
			V0 = cr.WarnRegime[1],
			V1 = cr.WarnRegime[2],
			Peak = cr.WarnRegime[2],
			Cond = spec.Cond,
			Kill = nil,
		}
		local runShape: VolShape = {
			S0 = tw,
			T1 = t1,
			End = t1 + fall + recover,
			Kind = 2,
			A = fall,
			B = recover,
			V0 = cr.WarnRegime[2],
			V1 = 1,
			Peak = cr.PeakRegime,
			Cond = spec.Cond,
			Kill = nil,
		}
		if tw < t1 then
			addVol(warnShape)
		end
		addVol(runShape)
		table.insert(self.CrashSpans, { tw, t1 + fall + recover, if isCrash then 1 else 2, spec.Cond })
		local warnKeys = if spec.Sector
			then { newsCfg.Warn.Sector }
			elseif isCrash then newsCfg.Warn.Crash
			else newsCfg.Warn.Rally
		local warnCount = if tw < tc then math.min(#warnKeys, math.max(1, (tc - tw) // 60)) else 0
		for index = 1, warnCount do
			local wrap = pushNews(news, tw + (index - 1) * 60, "Warn", warnKeys[index], {
				sector = if spec.Sector then newsCfg.Sectors[spec.Sector] else nil,
			}, { Sector = spec.Sector, Dir = if isCrash then -1 else 1 })
			wrap.Cond = spec.Cond
		end
		local mainWrap = pushNews(
			news,
			tc,
			if isCrash then "Crash" else "Rally",
			spec.Key,
			{ band = newsCfg.Bands[maxBand], sector = if spec.Sector then newsCfg.Sectors[spec.Sector] else nil },
			{ Sector = spec.Sector, Band = maxBand, Dir = if isCrash then -1 else 1 }
		)
		mainWrap.Cond = spec.Cond
		local kindName = if isCrash then "Crash" else "Rally"
		local untilTick = t1 + fall + recover
		local base: Plain =
			{ Kind = kindName, StartTick = tw, Until = untilTick, Scope = spec.Sector and "Sector" or "All" }
		if spec.Sector then
			base.Target = spec.Sector
		end
		local function msg(t: number, phase: string)
			local d: Plain = { Phase = phase }
			for k, v in pairs(base) do
				d[k] = v
			end
			table.insert(msgs, { T = t, Kind = "Event", Data = d, Cond = spec.Cond })
		end
		msg(tw, "Warn")
		msg(t1, "Run")
		msg(untilTick, "End")
	end

	-- 5) unangekündigte Crashs/Rallyes (Ø alle 3,5 h, mit Warnphase; nie in den letzten Tagen der Woche)
	do
		local cr = cfg.CrashRally
		local k = 900
		local t = -(1 / cr.Rate) * math.log(1 - self:R(day, k))
		local count = 0
		while t < MarketClock.DAY and count < 4 do -- gebunden
			count += 1
			local base = 900 + 16 * count
			local function g(j: number): number
				return self:R(day, base + j)
			end
			local tw = dayStart + math.floor(t)
			local blocked = dayInWeek >= MarketClock.DAYS_PER_WEEK - cr.QuietEndDays or tw - self.LastCrashT < cr.MinGap
			if not blocked then
				for _, entry in ipairs(cfg.Weekly) do
					if entry.Kind ~= "Ipo" then
						local wt = MarketClock.WeeklyTick(self.Week, entry.Dow, entry.HH, entry.MM)
						if wt and math.abs(wt - tw) < cr.MinGap then
							blocked = true
						end
					end
				end
			end
			if not blocked then
				local isCrash = g(1) < cr.CrashShare
				local range = if isCrash then cr.CrashDrop else cr.RallyRise
				crashRally({
					Warn = tw,
					Main = tw + cr.WarnSeconds,
					Crash = isCrash,
					Strength = range[1] + (range[2] - range[1]) * g(2),
					Fall = math.floor(cr.FallSeconds[1] + (cr.FallSeconds[2] - cr.FallSeconds[1]) * g(3)),
					Recover = math.floor(cr.RecoverSeconds[1] + (cr.RecoverSeconds[2] - cr.RecoverSeconds[1]) * g(4)),
					Share = cr.RecoverShare[1] + (cr.RecoverShare[2] - cr.RecoverShare[1]) * g(5),
					Key = if isCrash then newsCfg.Crash.All else newsCfg.Rally.All,
					Val = true,
				})
				self.LastCrashT = tw
			end
			t += -(1 / cr.Rate) * math.log(1 - g(15))
		end
	end

	-- 6) Wochen-Termine (Berlin-Zeit): Crash-Freitag, Rally-Mittwoch, Samstags-Show (bedingt), IPO-Erstnotiz
	local sectorOfWeek = self.Companies.Sectors[(self.Week % 6) + 1].Key
	for _, entry in ipairs(cfg.Weekly) do
		local wt = MarketClock.WeeklyTick(self.Week, entry.Dow, entry.HH, entry.MM)
		if wt == nil then
			continue
		end
		if entry.Kind == "Ipo" then
			local id = self:ScheduledIpo()
			if id then
				local prospectAt = wt - cfg.IpoPipeline.ProspectLead
				if prospectAt >= dayStart and prospectAt < nextStart and prospectAt >= self.WeekStart then
					self:IpoProspectNews(news, id, prospectAt, "IpoSched:" .. id .. ":" .. wt)
				end
				if wt >= dayStart and wt < nextStart then
					self:IpoListingPlan(news, msgs, id, wt, "IpoSched:" .. id .. ":" .. wt)
				end
			end
		else
			local main = wt + (entry.Offset or 0)
			local warn = main - cfg.CrashRally.WarnSeconds
			if warn >= dayStart and warn < nextStart and main + 1800 < self.WeekEnd then
				local isCrash = entry.Kind == "Crash"
				crashRally({
					Warn = warn,
					Main = main,
					Crash = isCrash,
					Strength = entry.Strength,
					Fall = 90,
					Recover = 900,
					Share = entry.Recover or 0.5,
					Sector = if entry.Scope == "Sector" then sectorOfWeek else nil,
					Key = newsCfg.Weekly[entry.Key] or (if isCrash then newsCfg.Crash.All else newsCfg.Rally.All),
					Val = false,
					Cond = if entry.Cancelable then "AutoShow" else nil,
				})
			end
		end
	end

	-- 7) einsortieren: Wirkungen (mit Überhang aus dem Vortag) nach S0, News nach T
	for _, slot in ipairs(self.SlotList) do
		local i = slot.Id
		local list: { Effect } = created[i] or {}
		for _, e in ipairs(self.Pend[i]) do
			table.insert(list, e)
		end
		table.sort(list, function(a: Effect, b: Effect)
			if a.S0 ~= b.S0 then
				return a.S0 < b.S0
			end
			return a.T1 < b.T1
		end)
		local keep: { Effect } = {}
		local eff, s0s, pre = self.Eff[i], self.EffS0[i], self.Pre[i]
		for _, e in ipairs(list) do
			if e.S0 < nextStart then
				table.insert(eff, e)
				table.insert(s0s, e.S0)
				pre[#eff] = (pre[#eff - 1] or 0) + e.F
				if e.End - e.S0 > self.MaxSpan then
					self.MaxSpan = e.End - e.S0
				end
			else
				table.insert(keep, e)
			end
		end
		self.Pend[i] = keep
		local createdHere = created[i]
		if createdHere then
			for _, e in ipairs(createdHere) do
				if e.Val and e.S0 >= slot.ValOrigin then
					self.Val[i] += e.F
				end
			end
		end
		if slot.Ipo then
			local rec = self.Listings[i]
			if rec then
				self.OriginK[i] = upperBound(s0s, rec.T0 - 1)
			end
		end
	end
	for _, wrap in ipairs(self.PendNews) do
		table.insert(news, wrap)
	end
	table.sort(news, function(a: Plain, b: Plain)
		return a.Item.T < b.Item.T
	end)
	local keepNews: { Plain } = {}
	for _, wrap in ipairs(news) do
		if wrap.Item.T < nextStart then
			local seq = (self.NewsSeq[day] or 0) + 1
			self.NewsSeq[day] = seq
			wrap.Item.Id = day * 512 + seq
			table.insert(self.News, wrap)
			table.insert(self.NewsT, wrap.Item.T)
		else
			table.insert(keepNews, wrap)
		end
	end
	self.PendNews = keepNews
	table.sort(msgs, function(a: Msg, b: Msg)
		return a.T < b.T
	end)
	for _, m in ipairs(msgs) do
		self:InsertMsg(m, false)
	end
	self.Built = day
end

function EventDirector.InsertMsg(self: any, m: Msg, external: boolean)
	local list = if external then self.ExtMsgs else self.Msgs
	if external then
		local index = #list + 1
		while index > 1 and list[index - 1].T > m.T do
			index -= 1
		end
		table.insert(list, index, m)
		return
	end
	local times = self.MsgT
	local index = upperBound(times, m.T) + 1
	table.insert(list, index, m)
	table.insert(times, index, m.T)
end

-- Saison/Woche -> geplantes IPO dieser Woche (oder nil)
function EventDirector.ScheduledIpo(self: any): number?
	local pipeline = self.Cfg.IpoPipeline
	local offset = self.Week - pipeline.FirstWeek
	if offset < 0 then
		return nil
	end
	local season = offset // pipeline.SeasonWeeks + 1
	local slotInSeason = offset % pipeline.SeasonWeeks + 1
	local ids = pipeline.Season[season]
	local id = if type(ids) == "table" then ids[slotInSeason] else nil
	if id and self.SlotById[id] then
		return id
	end
	return nil
end

function EventDirector.IpoQuality(self: any, id: number): (number, number)
	local pipeline = self.Cfg.IpoPipeline
	local q = Noise.Uni(self.Seed, CH_IPO, id, 0)
	local z = Noise.Gauss(self.Seed, CH_IPO + 1, id, 0)
	local pop =
		math.clamp(pipeline.PopBase + pipeline.PopQuality * q + pipeline.PopNoise * z, pipeline.Pop[1], pipeline.Pop[2])
	return q, pop
end

function EventDirector.IpoProspectNews(self: any, news: { Plain }, id: number, t: number, cond: string?)
	local slot = self.SlotById[id]
	local wrap = pushNews(news, t, "Ipo", self.NewsCfg.Ipo.Prospect, {
		name = slot.Name,
		sector = self.NewsCfg.Sectors[slot.Sector],
	}, { I = id, Sector = slot.Sector })
	wrap.Cond = cond
	wrap.Always = true -- Prospekt erscheint vor der Erstnotiz
end

-- Erstnotiz: 60-s-Auktion (Handelspause), danach Eröffnung = Ausgabepreis · (1 + pop)
function EventDirector.IpoListingPlan(self: any, news: { Plain }, msgs: { Msg }, id: number, t0: number, cond: string?)
	local slot = self.SlotById[id]
	local q, pop = self:IpoQuality(id)
	local issue = slot.Start
	local open = math.clamp(math.round(issue * (1 + pop)), self.Cfg.Price.MinCents, self.Cfg.Price.MaxCents)
	if self.Listings[id] == nil then
		self:AddListing(id, { T0 = t0, Issue = issue, Open = open, Pop = pop, Q = q, By = 0 })
	end
	local secs = self.Cfg.Halts.IpoSeconds
	table.insert(self.Halts, { All = false, I = id, From = t0, Until = t0 + secs, Cond = cond, Ext = false })
	local listingWrap = pushNews(news, t0, "Ipo", self.NewsCfg.Ipo.Listing, { name = slot.Name, secs = secs }, {
		I = id,
	})
	listingWrap.Cond = cond
	local band = bandFromMove(self, pop)
	local openWrap = pushNews(
		news,
		t0 + secs,
		"Ipo",
		if pop >= 0 then self.NewsCfg.Ipo.OpenUp else self.NewsCfg.Ipo.OpenDown,
		{ name = slot.Name, band = self.NewsCfg.Bands[band] },
		{ I = id, Band = band, Dir = sign(pop) }
	)
	openWrap.Cond = cond
	table.insert(msgs, { T = t0, Kind = "Ipo", Data = { I = id, Phase = "Listing", T0 = t0 }, Cond = cond })
	table.insert(msgs, { T = t0 + secs, Kind = "Ipo", Data = { I = id, Phase = "Open", T0 = t0 }, Cond = cond })
	table.insert(msgs, {
		T = t0,
		Kind = "Halt",
		Data = { I = id, Until = t0 + secs },
		Cond = cond,
	})
end

function EventDirector.EnsureBuilt(self: any, day: number, maxDays: number?): boolean
	local target = math.min(day, self.LastDay)
	local budget = maxDays or math.huge
	while self.Built < target and budget > 0 do
		self:BuildDay(self.Built + 1)
		budget -= 1
	end
	return self.Built >= target
end

-- ---------------------------------------------------------------------
-- BEDINGUNGEN (Samstags-Show abgesagt? geplantes IPO schon per Admin gelistet?)
-- ---------------------------------------------------------------------
-- Samstags-Show abgesagt? -> Tick, ab dem die Absage gilt (Start-Tick des CancelAutoShow-Bus-Events, auf allen Servern
-- gleich), −∞ = immer abgesagt (Selbsttest/IsCancelled), nil = findet statt.
function EventDirector.AutoShowCut(self: any): number?
	local fn = self.CancelAt
	if type(fn) == "function" then
		local ok, at = pcall(fn, self.Week)
		if ok and type(at) == "number" then
			return at
		end
		return nil
	end
	local legacy = self.IsCancelled
	if type(legacy) == "function" then
		local ok, cancelled = pcall(legacy, self.Week)
		if ok and cancelled == true then
			return -math.huge
		end
	end
	return nil
end

-- t (optional): Bedingung zu diesem Tick. Eine Show-Absage gilt erst ab ihrem Start-Tick (Warnphase davor bleibt
-- Geschichte: gleiche Kurse/Kerzen auf allen Servern, kein Rückwirken auf schon gesendete Ticks).
function EventDirector.CondOk(self: any, cond: string?, t: number?): boolean
	if cond == nil then
		return true
	end
	if cond == "AutoShow" then
		local cut = self:AutoShowCut()
		if cut == nil then
			return true
		end
		return t ~= nil and t < cut
	end
	local id, t0 = string.match(cond, "^IpoSched:(%d+):(%d+)$")
	if id and t0 then
		local rec = self.Listings[tonumber(id) :: number]
		return rec == nil or rec.T0 == tonumber(t0)
	end
	return true
end

-- ---------------------------------------------------------------------
-- AUSWERTUNG EINER WIRKUNG
-- ---------------------------------------------------------------------
local function rawEffect(self: any, e: Effect, t: number): number
	local value: number
	if t >= e.End then
		value = e.F
	else
		local x = t - e.T1
		if x < 0 then
			value = 0
		elseif e.Shape == SHAPE_NEWS then
			local tau = e.A
			if x <= tau then
				value = e.J * (1 + e.O) * smooth(x / tau)
			else
				value = e.J * (1 + e.O) - e.J * e.O * (1 - math.exp(-(x - tau) / e.B))
			end
		elseif e.Shape == SHAPE_RAMP then
			value = e.J * smooth(x / e.A)
		elseif e.Shape == SHAPE_CRASH then
			if x < e.A then
				value = e.J * smooth(x / e.A)
			else
				value = e.J - e.R * e.J * smooth((x - e.A) / e.B)
			end
		else -- SHAPE_BUMP
			if x < e.A then
				value = e.J * smooth(x / e.A)
			else
				value = e.J * (1 - smooth((x - e.A) / e.B))
			end
		end
	end
	local kill = e.Kill
	if kill and t >= kill then
		local fade = 1 - smooth((t - kill) / self.Cfg.Admin.NormalizeSeconds)
		value *= fade
	end
	return value
end

-- Beitrag einer Wirkung; Überträge aus der Vorwoche zählen relativ zum Wochenschluss (der steckt schon in der Basis)
local function evalEffect(self: any, e: Effect, t: number): number
	local value = rawEffect(self, e, t)
	local subAt = e.SubAt
	if subAt then
		value -= rawEffect(self, e, subAt)
	end
	return value
end

-- Summe aller Plan-Wirkungen + bedingte + Dividenden + externe; zweiter Wert: News-Rampe aktiv
function EventDirector.Offset(self: any, i: number, t: number, divFrom: number?): (number, boolean)
	local eff = self.Eff[i]
	if eff == nil then
		return 0, false
	end
	local s0s = self.EffS0[i]
	local pre = self.Pre[i]
	local n = upperBound(s0s, t)
	local k0 = upperBound(s0s, t - self.MaxSpan)
	local kOrigin = self.OriginK[i] or 0
	if k0 < kOrigin then
		k0 = kOrigin
	end
	local sum = (pre[k0] or 0) - (pre[kOrigin] or 0)
	local active = false
	for k = k0 + 1, n do
		local e = eff[k]
		if t >= e.End then
			sum += e.F -- abgeschlossen (Plan-Wirkungen haben weder Kill noch Sub)
		else
			sum += evalEffect(self, e, t)
			if e.News and t <= e.T1 + e.A then
				active = true
			end
		end
	end
	local slot = self.SlotById[i]
	local origin = if slot then slot.Origin else -math.huge
	sum += EventDirector.DriftOffset(self, i, t)
	local cond = self.CondEff[i]
	if #cond > 0 then
		for _, e in ipairs(cond) do
			if e.S0 <= t and e.S0 >= origin and self:CondOk(e.Cond, t) then
				sum += evalEffect(self, e, t)
				if t <= e.T1 + e.A then
					active = true
				end
			end
		end
	end
	local ext = self.Ext[i]
	if #ext > 0 then
		for _, e in ipairs(ext) do
			if e.S0 <= t and e.S0 >= origin then
				sum += evalEffect(self, e, t)
				if e.News and t <= e.T1 + e.A then
					active = true
				end
			end
		end
	end
	local divTicks = self.DivT[i]
	if #divTicks > 0 then
		local limit = if divFrom then math.min(t, divFrom - 1) else t
		local k = upperBound(divTicks, limit)
		if k > 0 then
			if k > self.DivDone[i] then
				EventDirector.ResolveDividends(self, i, k)
			end
			sum += self.DivCum[i][k]
		end
	end
	return sum, active
end

-- Dividenden-Beträge lazy und der Reihe nach: mid im Ex-Tick OHNE diese (und spätere) Dividende (keine Rekursion,
-- weil frühere Dividenden schon aufgelöst sind). Präfix-Summen der Log-Abschläge für schnelle Abfragen.
function EventDirector.ResolveDividends(self: any, i: number, upTo: number)
	local hook = self.PriceHook
	local list = self.Div[i]
	local cum = self.DivCum[i]
	local done = self.DivDone[i]
	for k = done + 1, math.min(upTo, #list) do
		local d = list[k]
		local mid = if hook then hook(i, d.Tick, d.Tick) else 0
		local cents = Dividends.PerShare(mid, d.Bps)
		d.LogF = Dividends.LogDrop(mid, cents)
		d.Cents = cents
		cum[k] = cum[k - 1] + d.LogF
		self.DivDone[i] = k
	end
end

function EventDirector.ResolveDividend(self: any, i: number, target: Plain): number
	local k = target.K or 0
	if k > self.DivDone[i] then
		EventDirector.ResolveDividends(self, i, k)
	end
	return target.LogF or 0
end

-- nach verspäteten Admin-Events: Dividenden-Beträge ab einem Tick neu rechnen
function EventDirector.InvalidateDividends(self: any, ids: { number }, fromTick: number)
	for _, i in ipairs(ids) do
		local ticks = self.DivT[i]
		if ticks then
			local keep = upperBound(ticks, fromTick - 1)
			if self.DivDone[i] > keep then
				self.DivDone[i] = keep
			end
			for k = keep + 1, #self.Div[i] do
				local d = self.Div[i][k]
				d.LogF = nil
				d.Cents = nil
			end
		end
	end
end

function EventDirector.Dividends(self: any, t0: number, t1: number): { Plain }
	local out: { Plain } = {}
	for _, slot in ipairs(self.SlotList) do
		local ticks = self.DivT[slot.Id]
		if ticks and #ticks > 0 then
			local first = upperBound(ticks, t0 - 1) + 1
			local last = upperBound(ticks, t1)
			if last >= first then
				if last > self.DivDone[slot.Id] then
					EventDirector.ResolveDividends(self, slot.Id, last)
				end
				for k = first, last do
					local d = self.Div[slot.Id][k]
					if (d.Cents or 0) > 0 and self:IsListed(slot.Id, d.Tick) then
						table.insert(out, { I = slot.Id, Tick = d.Tick, Cents = d.Cents })
					end
				end
			end
		end
	end
	table.sort(out, function(a: Plain, b: Plain)
		if a.Tick ~= b.Tick then
			return a.Tick < b.Tick
		end
		return a.I < b.I
	end)
	return out
end

-- Ex-Tag-Flag: an einem Börsentag mit Dividende, bis einschließlich Ex-Tick
function EventDirector.ExDay(self: any, i: number, t: number): boolean
	local ticks = self.DivT[i]
	if ticks == nil or #ticks == 0 then
		return false
	end
	local tick = ticks[upperBound(ticks, t - 1) + 1]
	return tick ~= nil and MarketClock.DayIndex(tick) == MarketClock.DayIndex(t)
end

-- ---------------------------------------------------------------------
-- VOLATILITÄT, PAUSEN, CRASH-FLAGS
-- ---------------------------------------------------------------------
local function evalVol(self: any, v: VolShape, t: number): number
	if t < v.S0 or t >= v.End then
		return 1
	end
	local value: number
	if v.Kind == 1 then
		value = v.V0 + (v.V1 - v.V0) * math.clamp((t - v.S0) / v.A, 0, 1)
	elseif v.Kind == 2 then
		local x = t - v.T1
		if x < 0 then
			value = v.V0
		elseif x < v.A then
			value = v.V0 + (v.Peak - v.V0) * smooth(x / v.A)
		else
			value = v.Peak + (v.V1 - v.Peak) * smooth((x - v.A) / v.B)
		end
	elseif v.Kind == 3 then
		local up = smooth((t - v.T1) / v.A)
		local down = 1 - smooth((t - (v.End - v.A)) / v.A)
		value = 1 + (v.Peak - 1) * math.min(up, down)
	else
		local x = t - v.T1
		if x < 0 then
			value = 1
		elseif x < v.A then
			value = 1 + (v.Peak - 1) * smooth(x / v.A)
		else
			value = v.Peak + (1 - v.Peak) * smooth((x - v.A) / v.B)
		end
	end
	local kill = v.Kill
	if kill and t >= kill then
		local fade = 1 - smooth((t - kill) / self.Cfg.Admin.NormalizeSeconds)
		value = 1 + (value - 1) * fade
	end
	return value
end

function EventDirector.VolMul(self: any, t: number): number
	local s0s = self.VolS0
	local n = upperBound(s0s, t)
	local k = upperBound(s0s, t - self.MaxVolSpan)
	local mul = 1
	for index = k + 1, n do
		local v = self.Vol[index]
		if t < v.End then
			local cut = if v.Cond == "AutoShow" then self:AutoShowCut() else nil
			if cut ~= nil and t >= cut then
				-- abgesagte Show: Warn-Volatilität über NormalizeSeconds ausblenden (kein Kurssprung)
				local fade = 1 - smooth((t - cut) / self.Cfg.Admin.NormalizeSeconds)
				if fade > 0 then
					mul *= 1 + (evalVol(self, v, t) - 1) * fade
				end
			elseif self:CondOk(v.Cond, t) then
				mul *= evalVol(self, v, t)
			end
		end
	end
	return mul
end

function EventDirector.Halted(self: any, i: number, t: number): (boolean, number)
	local halted, untilTick = false, 0
	for _, h in ipairs(self.Halts) do
		if t >= h.From and t < h.Until and (h.All or h.I == i) and self:CondOk(h.Cond, t) then
			halted = true
			if h.Until > untilTick then
				untilTick = h.Until
			end
		end
	end
	return halted, untilTick
end

function EventDirector.AnyHalt(self: any, t: number): { [string]: number }
	local out: { [string]: number } = {}
	for _, h in ipairs(self.Halts) do
		if t >= h.From and t < h.Until and self:CondOk(h.Cond, t) then
			local key = if h.All then "0" else tostring(h.I)
			if (out[key] or 0) < h.Until then
				out[key] = h.Until
			end
		end
	end
	return out
end

function EventDirector.AddLocalHalt(self: any, ids: { number }?, from: number, untilTick: number)
	if ids == nil then
		table.insert(self.Halts, { All = true, I = nil, From = from, Until = untilTick, Cond = nil, Ext = true })
		return
	end
	for _, i in ipairs(ids) do
		table.insert(self.Halts, { All = false, I = i, From = from, Until = untilTick, Cond = nil, Ext = true })
	end
end

function EventDirector.CrashRally(self: any, t: number): (boolean, boolean)
	local crash, rally = false, false
	for _, span in ipairs(self.CrashSpans) do
		if t >= span[1] and t < span[2] and self:CondOk(span[4] :: any, t) then
			if span[3] == 1 then
				crash = true
			else
				rally = true
			end
		end
	end
	return crash, rally
end

-- ---------------------------------------------------------------------
-- NEWS & NACHRICHTEN (nur Veröffentlichtes; nie Zukünftiges)
-- ---------------------------------------------------------------------
local function copyItem(item: Plain): Plain
	local out: Plain = table.clone(item)
	out.Args = table.clone(item.Args)
	return out
end

function EventDirector.Visible(self: any, wrap: Plain): boolean
	if not self:CondOk(wrap.Cond, wrap.Item.T) then
		return false
	end
	local item = wrap.Item
	if item.I and not wrap.Always and not self:IsListed(item.I, item.T) then
		return false
	end
	return true
end

function EventDirector.Finish(self: any, wrap: Plain): Plain
	local item = copyItem(wrap.Item)
	local divOf = wrap.DivOf
	if divOf then
		local cents = 0
		for _, d in ipairs(self.Div[divOf] or {}) do
			if d.Tick == item.T then
				if d.LogF == nil then
					self:ResolveDividend(divOf, d)
				end
				cents = d.Cents or 0
				break
			end
		end
		item.Args.amt = cents / 100
	end
	return item
end

function EventDirector.NewsIn(self: any, t0: number, t1: number): { NewsItem }
	local out: { NewsItem } = {}
	local times = self.NewsT
	local first = upperBound(times, t0) + 1
	for index = first, #times do
		local wrap = self.News[index]
		if wrap.Item.T > t1 then
			break
		end
		if self:Visible(wrap) then
			local finished = self:Finish(wrap)
			if not (finished.Kind == "Dividend" and (finished.Args.amt or 0) <= 0) then
				table.insert(out, finished :: any)
			end
		end
	end
	for _, wrap in ipairs(self.ExtNews) do
		local t = wrap.Item.T
		if t > t0 and t <= t1 then
			table.insert(out, copyItem(wrap.Item) :: any)
		end
	end
	table.sort(out, function(a: any, b: any)
		if a.T ~= b.T then
			return a.T < b.T
		end
		return a.Id < b.Id
	end)
	return out
end

function EventDirector.LatestNews(self: any, t: number, n: number): { NewsItem }
	local out: { NewsItem } = {}
	local times = self.NewsT
	local index = upperBound(times, t)
	local scanned = 0
	while index >= 1 and #out < n and scanned < 2000 do -- gebunden
		scanned += 1
		local wrap = self.News[index]
		if self:Visible(wrap) then
			local finished = self:Finish(wrap)
			if not (finished.Kind == "Dividend" and (finished.Args.amt or 0) <= 0) then
				table.insert(out, finished :: any)
			end
		end
		index -= 1
	end
	for _, wrap in ipairs(self.ExtNews) do
		if wrap.Item.T <= t then
			table.insert(out, copyItem(wrap.Item) :: any)
		end
	end
	table.sort(out, function(a: any, b: any)
		if a.T ~= b.T then
			return a.T > b.T
		end
		return a.Id > b.Id
	end)
	while #out > n do
		table.remove(out)
	end
	return out
end

local FACT_KINDS = { Fact = true, Confirm = true, Deny = true, Earnings = true }

function EventDirector.FactNewsFor(self: any, i: number, t: number, window: number): NewsItem?
	local times = self.NewsT
	local index = upperBound(times, t)
	local scanned = 0
	while index >= 1 and scanned < 4000 do -- gebunden
		scanned += 1
		local wrap = self.News[index]
		local item = wrap.Item
		if item.T < t - window then
			break
		end
		if item.I == i and FACT_KINDS[item.Kind] and item.Dir ~= nil and item.Dir ~= 0 and self:Visible(wrap) then
			return self:Finish(wrap) :: any
		end
		index -= 1
	end
	return nil
end

function EventDirector.MessagesAt(self: any, t: number): { Plain }
	local out: { Plain } = {}
	local times = self.MsgT
	local index = upperBound(times, t - 1) + 1
	while index <= #times and times[index] == t do
		local m = self.Msgs[index]
		if self:CondOk(m.Cond, t) then
			table.insert(out, { Kind = m.Kind, Data = m.Data })
		end
		index += 1
	end
	for _, m in ipairs(self.ExtMsgs) do
		if m.T == t then
			table.insert(out, { Kind = m.Kind, Data = m.Data })
		elseif m.T > t then
			break
		end
	end
	return out
end

-- ---------------------------------------------------------------------
-- KALENDER (nur geplante Arten; Firmen-News/Gerüchte/Crashs ohne Termin erscheinen NIE vorab)
-- ---------------------------------------------------------------------
function EventDirector.Calendar(self: any, t0: number, t1: number): { CalendarItem }
	local out: { CalendarItem } = {}
	local first = math.max(MarketClock.DayIndex(t0), self.FirstDay)
	local last = math.min(MarketClock.DayIndex(t1), self.LastDay)
	for day = first, last do
		for _, e in ipairs(self:EarningsFor(day)) do
			if e.T >= t0 and e.T <= t1 and self:IsListed(e.I, e.T) then
				table.insert(out, { T = e.T, Kind = "Earnings", I = e.I, Key = "mkt.cal.Earnings" })
				local slot = self.SlotById[e.I]
				local exTick = Dividends.ExTick(e.I, day, slot.DivBps, self.Cfg)
				if exTick and exTick >= t0 and exTick <= t1 then
					table.insert(out, { T = exTick, Kind = "Dividend", I = e.I, Key = "mkt.cal.Dividend" })
				end
			end
		end
		local tMacro = MarketClock.DayStart(day) + self.Cfg.Macro.Minute * 60
		if tMacro >= t0 and tMacro <= t1 then
			table.insert(out, { T = tMacro, Kind = "Macro", Key = "mkt.cal.Macro." .. self:MacroKind(day) })
		end
	end
	table.sort(out, function(a: CalendarItem, b: CalendarItem)
		if a.T ~= b.T then
			return a.T < b.T
		end
		return (a.I or 0) < (b.I or 0)
	end)
	return out
end

-- ---------------------------------------------------------------------
-- FIRMENPROFIL (Fundamentaldaten aus q + Quartalen dieser Woche; Analysten-Trefferquote live gemessen)
-- ---------------------------------------------------------------------
function EventDirector.AnalystStats(self: any, now: number): { { number } }
	local window = self.Cfg.AnalystWindow
	local count = #self.Cfg.Analysts
	local hits: { { number } } = {}
	for a = 1, count do
		hits[a] = { 0, 0 }
	end
	local day = math.min(MarketClock.DayIndex(now), self.Built)
	local remaining = count
	local scanned = 0
	while day >= self.FirstDay and remaining > 0 and scanned < MarketClock.DAYS_PER_WEEK do
		scanned += 1
		local list = self:EarningsFor(day)
		for index = #list, 1, -1 do
			local e = list[index]
			if e.T <= now then
				local actual = sign(e.J)
				for _, v in ipairs(e.Verdicts) do
					local h = hits[v[1]]
					if h[2] < window then
						h[2] += 1
						if v[2] == actual then
							h[1] += 1
						end
						if h[2] == window then
							remaining -= 1
						end
					end
				end
			end
		end
		day -= 1
	end
	return hits
end

function EventDirector.Profile(self: any, i: number, now: number, leadSeconds: number): Plain?
	local slot = self.SlotById[i]
	if not slot then
		return nil
	end
	local cfg = self.Cfg
	local fund = cfg.Fundamentals
	local q = self.Q[i] or 0
	local revenue0 = fund.Revenue[1] + (fund.Revenue[2] - fund.Revenue[1]) * Noise.Rnd(CH_FUND, i, 0, 0)
	local pe0 = fund.Pe[slot.Class] or fund.Pe.Normal
	local eps = slot.Start / pe0 -- Cent je Aktie (negativ = Verlust)
	local growth: { number } = {}
	-- vier synthetische Vor-Quartale (aus dem Seed) + die Quartale dieser Woche bis jetzt
	for m = 4, 1, -1 do
		local s = cfg.Earnings.SurpriseQ * q + cfg.Earnings.SurpriseZ * Noise.Gauss(self.Seed, CH_EARN_PRE, i, m)
		table.insert(growth, fund.GrowthBase + fund.GrowthQ * q + fund.GrowthS * s)
		eps += math.abs(eps) * fund.EpsS * s
	end
	local nextEarnings: Plain? = nil
	local day = self.FirstDay
	local lastDay = math.min(MarketClock.DayIndex(now) + 3, self.LastDay)
	while day <= lastDay do
		for _, e in ipairs(self:EarningsFor(day)) do
			if e.I == i then
				if e.T <= now then
					table.insert(growth, fund.GrowthBase + fund.GrowthQ * q + fund.GrowthS * e.S)
					eps += math.abs(eps) * fund.EpsS * e.S
				elseif nextEarnings == nil then
					nextEarnings = e
				end
			end
		end
		day += 1
	end
	while #growth > 4 do
		table.remove(growth, 1)
	end
	local revenue = revenue0
	for _, g in ipairs(growth) do
		revenue *= 1 + g
	end
	local stats = self:AnalystStats(now)
	local analysts: { Plain } = {}
	local verdictOf: { [number]: number } = {}
	local consensus: string? = nil
	if nextEarnings then
		if now >= nextEarnings.T - leadSeconds then
			for _, v in ipairs(nextEarnings.Verdicts) do
				verdictOf[v[1]] = v[2]
			end
		end
		if now >= nextEarnings.T - cfg.Earnings.PreviewMinutes * 60 then
			consensus = nextEarnings.Cons
		end
	end
	for index, analyst in ipairs(cfg.Analysts) do
		table.insert(analysts, {
			Name = analyst.Name,
			Hits = stats[index][1],
			N = stats[index][2],
			Verdict = verdictOf[index] or 0,
		})
	end
	local nextDividend = 0
	if slot.DivBps > 0 and nextEarnings then
		nextDividend = MarketClock.DayStart(MarketClock.DayIndex(nextEarnings.T)) + cfg.Dividend.Minute * 60
	end
	local profile: Plain = {
		I = i,
		Revenue = math.round(revenue * 10) / 10,
		Growth = growth,
		Eps = math.round(eps),
		DivBps = slot.DivBps,
		NextEarnings = if nextEarnings then { T = nextEarnings.T, Minute = nextEarnings.Minute } else nil,
		NextDividend = nextDividend,
		Consensus = consensus,
		Analysts = analysts,
	}
	if slot.Ipo then
		local rec = self.Listings[i]
		local ipoQ = self:IpoQuality(i) -- Prospekt-Qualität aus dem Wochen-Seed (Skill: korreliert mit dem pop)
		profile.Issue = slot.Start
		profile.Listing = if rec then rec.T0 else nil
		profile.Quality = if ipoQ > 0.33
			then "mkt.profile.quality.good"
			elseif ipoQ < -0.33 then "mkt.profile.quality.weak"
			else "mkt.profile.quality.mid"
	end
	return profile
end

-- ---------------------------------------------------------------------
-- EXTERNE EVENTS (GlobalBus; Felder sind bereits validiert und geklemmt)
-- ev: { Id, Kind, Scope, Target, Strength, Ramp, Decay, StartTick, Until, Text, By, Warn?, Band?, Dir? }
-- carry = true: Event aus der Vorwoche, das in diese Woche hineinreicht (Beitrag relativ zum Wochenschluss)
-- ---------------------------------------------------------------------
function EventDirector.Targets(self: any, ev: Plain, at: number): { number }
	local out: { number } = {}
	for _, slot in ipairs(self.SlotList) do
		local hit = false
		if ev.Scope == "All" then
			hit = true
		elseif ev.Scope == "Sector" then
			hit = slot.Sector == ev.Target
		elseif ev.Scope == "Inst" then
			hit = slot.Id == ev.Target
		end
		if hit and self:IsListed(slot.Id, at) then
			table.insert(out, slot.Id)
		end
	end
	return out
end

local function insertSorted(list: { Effect }, e: Effect)
	local index = #list + 1
	while index > 1 and list[index - 1].S0 > e.S0 do
		index -= 1
	end
	table.insert(list, index, e)
end

function EventDirector.InsertVol(self: any, v: VolShape)
	local index = upperBound(self.VolS0, v.S0) + 1
	table.insert(self.Vol, index, v)
	table.insert(self.VolS0, index, v.S0)
end

function EventDirector.AddExtNews(
	self: any,
	t: number,
	kind: string,
	key: string,
	args: Plain,
	extra: Plain?,
	idSalt: number
)
	local item: Plain = { Id = 2 ^ 40 + t * 16 + (idSalt % 16), T = t, Kind = kind, Key = key, Args = args }
	if extra then
		for k, v in pairs(extra) do
			item[k] = v
		end
	end
	local index = #self.ExtNews + 1
	while index > 1 and self.ExtNews[index - 1].Item.T > t do
		index -= 1
	end
	table.insert(self.ExtNews, index, { Item = item })
end

function EventDirector.AddExternal(self: any, ev: Plain, carry: boolean?): { number }
	local cfg = self.Cfg
	local admin = cfg.Admin
	local newsCfg = self.NewsCfg
	local kind = ev.Kind
	local start = ev.StartTick
	local salt = (self.ExtSalt or 0) + 1
	self.ExtSalt = salt
	local affected: { number } = {}
	local untilTick = ev.Until

	local function window(to: number)
		table.insert(self.WindowList, { start - admin.Lead, to + admin.WindowAfter })
	end

	local function haltAll(ids: { number }, secs: number)
		if ev.Scope == "All" then
			table.insert(
				self.Halts,
				{ All = true, I = nil, From = start, Until = start + secs, Cond = nil, Ext = true }
			)
		else
			for _, i in ipairs(ids) do
				table.insert(
					self.Halts,
					{ All = false, I = i, From = start, Until = start + secs, Cond = nil, Ext = true }
				)
			end
		end
	end

	if kind == "Crash" or kind == "Rally" or kind == "Pump" or kind == "Dump" then
		local down = kind == "Crash" or kind == "Dump"
		local strength = math.clamp(ev.Strength, admin.Strength[1], admin.Strength[2])
		local j = if down then math.log(1 - strength) else math.log(1 + strength)
		local warn = math.max(0, ev.Warn or 0)
		local t1 = start + warn
		affected = self:Targets(ev, start)
		for _, i in ipairs(affected) do
			local e = newEffect(start, t1, SHAPE_BUMP, j, ev.Ramp, ev.Decay)
			e.F = 0
			e.News = true
			e.Val = false
			if carry then
				e.SubAt = self.WeekStart - 1
				e.S0 = self.WeekStart
			end
			insertSorted(self.Ext[i], e)
		end
		if not carry then
			self:InsertVol({
				S0 = start,
				T1 = t1,
				End = t1 + ev.Ramp + ev.Decay,
				Kind = 4,
				A = ev.Ramp,
				B = ev.Decay,
				V0 = 1,
				V1 = 1,
				Peak = admin.PeakRegime,
				Cond = nil,
				Kill = nil,
			})
			table.insert(self.CrashSpans, { start, t1 + ev.Ramp + ev.Decay, if down then 1 else 2 })
			haltAll(affected, cfg.Halts.AdminSeconds)
			local key = newsCfg.AdminMove[kind]
			local name = if ev.Scope == "Inst" then self:NewsArgsName(ev.Target) else nil
			self:AddExtNews(start, "Admin", key, { name = name }, {
				I = if ev.Scope == "Inst" then ev.Target else nil,
				Sector = if ev.Scope == "Sector" then ev.Target else nil,
				Dir = if down then -1 else 1,
			}, salt)
			local base: Plain = {
				Kind = kind,
				StartTick = start,
				Until = untilTick,
				Scope = ev.Scope,
				Target = ev.Target,
				Admin = true,
			}
			local function msg(t: number, phase: string)
				local d: Plain = { Phase = phase }
				for k, v in pairs(base) do
					d[k] = v
				end
				self:InsertMsg({ T = t, Kind = "Event", Data = d }, true)
			end
			msg(t1, "Run")
			msg(t1 + ev.Ramp + ev.Decay, "End")
			window(t1 + ev.Ramp + ev.Decay)
		end
	elseif kind == "News" then
		affected = self:Targets(ev, start)
		local band = math.clamp(math.floor(ev.Band or 2), 1, 4)
		local dir = if (ev.Dir or 1) < 0 then -1 else 1
		local bandCfg = cfg.Bands[band]
		local mid = (bandCfg.Lo + bandCfg.Hi) / 2
		local t1 = start + self.Delay
		for _, i in ipairs(affected) do
			local slot = self.SlotById[i]
			local j = dir * mid * classOf(self, slot, start).NewsFactor
			local e = newEffect(start, t1, SHAPE_BUMP, j, self.Tau, admin.NewsDecay)
			e.F = 0
			e.Val = false
			if carry then
				e.SubAt = self.WeekStart - 1
				e.S0 = self.WeekStart
			end
			insertSorted(self.Ext[i], e)
		end
		if not carry then
			haltAll(affected, cfg.Halts.AdminSeconds)
			self:AddExtNews(start, "Admin", newsCfg.Admin, {}, {
				I = if ev.Scope == "Inst" then ev.Target else nil,
				Sector = if ev.Scope == "Sector" then ev.Target else nil,
				Band = band,
				Dir = dir,
				Text = ev.Text,
			}, salt)
			window(t1 + self.Tau + admin.NewsDecay)
		end
	elseif kind == "Vol" then
		if not carry then
			local mult = math.clamp(ev.Strength, admin.Vol[1], admin.Vol[2])
			self:InsertVol({
				S0 = start,
				T1 = start,
				End = untilTick,
				Kind = 3,
				A = admin.VolRamp,
				B = 0,
				V0 = 1,
				V1 = 1,
				Peak = mult,
				Cond = nil,
				Kill = nil,
			})
			self:AddExtNews(start, "Admin", newsCfg.AdminMove.Vol, {}, { Dir = if mult >= 1 then -1 else 1 }, salt)
			self:InsertMsg({
				T = start,
				Kind = "Event",
				Data = { Kind = "Vol", Phase = "Run", StartTick = start, Until = untilTick, Admin = true },
			}, true)
			self:InsertMsg({
				T = untilTick,
				Kind = "Event",
				Data = { Kind = "Vol", Phase = "End", StartTick = start, Until = untilTick, Admin = true },
			}, true)
			window(untilTick)
		end
	elseif kind == "Halt" then
		-- Pause gilt auch über den Wochenwechsel weiter (Übertrag ohne neue Schlagzeile)
		if ev.Scope == "Inst" then
			affected = { ev.Target }
			table.insert(self.Halts, { All = false, I = ev.Target, From = start, Until = untilTick, Ext = true })
		else
			table.insert(self.Halts, { All = true, I = nil, From = start, Until = untilTick, Ext = true })
		end
		if not carry then
			local secs = untilTick - start
			if ev.Scope == "Inst" then
				self:AddExtNews(start, "Halt", newsCfg.Halt.Inst, {
					name = self:NewsArgsName(ev.Target),
					secs = secs,
				}, { I = ev.Target }, salt)
			else
				self:AddExtNews(start, "Halt", newsCfg.Halt.All, { secs = secs }, nil, salt)
			end
			self:InsertMsg({
				T = start,
				Kind = "Halt",
				Data = { I = if ev.Scope == "Inst" then ev.Target else nil, Until = untilTick },
			}, true)
			window(untilTick)
		end
	elseif kind == "Resume" then
		if not carry then
			for _, h in ipairs(self.Halts) do
				if h.Ext and h.From <= start and h.Until > start then
					if ev.Scope ~= "Inst" or h.I == ev.Target then
						h.Until = start
					end
				end
			end
			if ev.Scope == "Inst" then
				self:AddExtNews(start, "Resume", newsCfg.Resume.Inst, {
					name = self:NewsArgsName(ev.Target),
				}, { I = ev.Target }, salt)
			else
				self:AddExtNews(start, "Resume", newsCfg.Resume.All, {}, nil, salt)
			end
			self:InsertMsg({
				T = start,
				Kind = "Halt",
				Data = { I = if ev.Scope == "Inst" then ev.Target else nil, Until = start },
			}, true)
		end
	elseif kind == "Normalize" then
		for _, slot in ipairs(self.SlotList) do
			for _, e in ipairs(self.Ext[slot.Id]) do
				if e.Start0 < start and e.End > start and (e.Kill == nil or e.Kill > start) then
					e.Kill = start
					table.insert(affected, slot.Id)
				end
			end
		end
		for _, v in ipairs(self.Vol) do
			if v.Kind >= 3 and v.S0 < start and v.End > start and (v.Kill == nil or v.Kill > start) then
				v.Kill = start
			end
		end
		if not carry then
			self:AddExtNews(start, "Admin", newsCfg.AdminMove.Normalize, {}, { Dir = 1 }, salt)
			self:InsertMsg({
				T = start,
				Kind = "Event",
				Data = {
					Kind = "Normalize",
					Phase = "Run",
					StartTick = start,
					Until = start + admin.NormalizeSeconds,
					Admin = true,
				},
			}, true)
			window(start + admin.NormalizeSeconds)
		end
	elseif kind == "Ipo" then
		local id = ev.Target
		if type(id) == "number" and self.SlotById[id] and self.Listings[id] == nil and not carry then
			local t0 = untilTick
			local news: { Plain } = {}
			local msgs: { Msg } = {}
			self:IpoProspectNews(news, id, start, nil)
			self:IpoListingPlan(news, msgs, id, t0, nil)
			local rec = self.Listings[id]
			if rec then
				rec.By = ev.By or 0
			end
			for _, wrap in ipairs(news) do
				local item = wrap.Item
				self:AddExtNews(item.T, item.Kind, item.Key, item.Args, {
					I = item.I,
					Band = item.Band,
					Dir = item.Dir,
					Sector = item.Sector,
				}, salt)
			end
			for _, m in ipairs(msgs) do
				self:InsertMsg(m, true)
			end
			self:InsertMsg({ T = start, Kind = "Ipo", Data = { I = id, Phase = "Prospect", T0 = t0 } }, true)
			affected = { id }
			window(t0 + cfg.Halts.IpoSeconds)
		end
	end
	return affected
end

function EventDirector.Windows(self: any): { { number } }
	return self.WindowList
end

return EventDirector
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">GlobalBus</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Globaler Event-Bus für Markt-Admin-Events (Server/Market/GlobalBus)
--  Besitzer: WP3 (Markt-Engine). Vertrag: MARKET.md §8.2–§8.4, DESIGN.md §C13, §B15.3, §C19 Nr. 10.
--  Wahrheit:   MemoryStore SortedMap "AT_Bus_W<w>" (Config.Tech.BusMapPrefix), Schlüssel "%012d_<guid>" (Aktivierungs-
--              Tick), Ablauf 26 h. Ein Event gilt nur, wenn es dort steht (Schreiben scheitert -> Event abgebrochen).
--  Schnellweg: MessagingService-Thema Config.Tech.BusTopic ("AT_EV"), Nachricht = nur der Schlüssel.
--  Poll:       jeder Server liest alle 5 s GetRangeAsync(aufsteigend, 50, ab min(letzter Schlüssel, jetzt − 30 s)) –
--              verlorene Nachrichten werden so nachgeholt. Vorlauf 10 s -> alle Server wenden das Event im SELBEN Tick an.
--  Audit:      DataStore Config.Tech.GlobalStore ("AT_Global"), Schlüssel AdminLog_W<w> (letzte 200 Einträge).
--  Jedes Feld wird validiert und geklemmt (auch Werte aus dem Speicher), obere Zeitgrenze, Dedupe per Id (200).
--  Studio ohne API / lokaler Testmarkt: Publish wendet lokal an (Bus nur lokal, §C17).
--  Alle MemoryStore/Messaging/DataStore-Aufrufe in pcall; Publish/Poll/Start YIELDEN (eigene Threads).
--
--  Öffentliche API (nur WP3)
--    GlobalBus.Start(onEvent: (ev, late) -> (), opts: { Local: boolean, Now: () -> number })
--    GlobalBus.Publish(ev): (boolean, string?)        "ok" | "local" | Fehlertext
--    GlobalBus.Poll()                                   (MarketService ruft es alle 5 s in einem eigenen Thread)
--    GlobalBus.Validate(raw, nowTick): BusEvent?        GlobalBus.NewId(): string
--    GlobalBus.Ok(): boolean                            letzter Bus-Zugriff erfolgreich (Admin-Dashboard)
--    GlobalBus.LoadLog(w): { BusEvent }                 Admin-Log der Woche (Admin-Fenster älter als 26 h)
--    GlobalBus.Seen(id): boolean · GlobalBus.Stop()
-- =====================================================================

local HttpService = game:GetService("HttpService")
local MemoryStoreService = game:GetService("MemoryStoreService")
local MessagingService = game:GetService("MessagingService")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local MarketClock = require(script.Parent:WaitForChild("MarketClock"))

local GlobalBus = {}

export type BusEvent = {
	Id: string,
	Kind: string,
	Scope: string,
	Target: (number | string)?,
	Strength: number,
	Ramp: number,
	Decay: number,
	StartTick: number,
	Until: number,
	Text: { de: string, en: string }?,
	By: number,
	Warn: number?,
	Band: number?,
	Dir: number?,
}

local KINDS = {
	Crash = true,
	Rally = true,
	Pump = true,
	Dump = true,
	Halt = true,
	Resume = true,
	Ipo = true,
	News = true,
	Vol = true,
	Normalize = true,
	CancelAutoShow = true,
}
local SECTORS = { T = true, E = true, M = true, K = true, G = true, F = true }
local MAX_TEXT = 200 -- Bytes je Sprache (80 Zeichen UTF-8)

local handler: ((BusEvent, boolean) -> ())? = nil
local nowFn: () -> number = MarketClock.Tick
local localOnly = false
local busOk = true
local started = false
local polling = false
local lastKeys: { [number]: string } = {} -- je Woche der zuletzt gesehene Schlüssel
local seenIds: { [string]: boolean } = {}
local seenOrder: { string } = {}
local subscription: RBXScriptConnection? = nil

local function cfg(): { [string]: any }
	return (Config.Market :: any).Bus
end

local function tech(): { [string]: any }
	return Config.Tech :: any
end

function GlobalBus.Ok(): boolean
	return busOk
end

function GlobalBus.NewId(): string
	local ok, guid = pcall(function()
		return HttpService:GenerateGUID(false)
	end)
	local text = if ok and type(guid) == "string" then guid else tostring(os.clock()) .. tostring(math.random())
	return (string.gsub(text, "[^%w]", ""))
end

function GlobalBus.Seen(id: string): boolean
	return seenIds[id] == true
end

local function remember(id: string)
	if seenIds[id] then
		return
	end
	seenIds[id] = true
	table.insert(seenOrder, id)
	local limit = cfg().Dedupe or 200
	while #seenOrder > limit do
		local old = table.remove(seenOrder, 1)
		if old then
			seenIds[old] = nil
		end
	end
end

local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function cleanText(text: any): string?
	if type(text) ~= "string" or text == "" then
		return nil
	end
	local cut = string.sub(text, 1, MAX_TEXT)
	-- abgeschnittene UTF-8-Folgen entfernen
	while #cut > 0 and utf8.len(cut) == nil do
		cut = string.sub(cut, 1, #cut - 1)
	end
	return if cut ~= "" then cut else nil
end

-- jedes Feld prüfen + klemmen; obere Zeitgrenze (Until ≤ jetzt + MaxSpan + Vorlauf + Puffer)
function GlobalBus.Validate(raw: any, nowTick: number): BusEvent?
	if type(raw) ~= "table" then
		return nil
	end
	local market: any = Config.Market
	local admin = market.Admin
	local bus = cfg()
	if type(raw.Id) ~= "string" or #raw.Id < 4 or #raw.Id > 64 or not string.match(raw.Id, "^[%w]+$") then
		return nil
	end
	if not KINDS[raw.Kind] then
		return nil
	end
	if not finite(raw.StartTick) or not finite(raw.Until) then
		return nil
	end
	local start = math.floor(raw.StartTick)
	local untilTick = math.floor(raw.Until)
	if start > nowTick + (bus.MaxFuture or 60) or start < nowTick - (bus.ExpirySeconds or 93600) then
		return nil
	end
	if untilTick < start or untilTick > start + admin.MaxSpan + admin.Lead + 5 then
		return nil
	end
	local scope = raw.Scope
	if scope ~= "All" and scope ~= "Sector" and scope ~= "Inst" then
		return nil
	end
	local target: (number | string)? = nil
	if scope == "Sector" then
		if type(raw.Target) ~= "string" or not SECTORS[raw.Target] then
			return nil
		end
		target = raw.Target
	elseif raw.Kind == "CancelAutoShow" then
		-- Ziel = Woche, deren Samstags-Show abgesagt wird
		if not finite(raw.Target) or raw.Target % 1 ~= 0 or raw.Target < 0 or raw.Target > 100000 then
			return nil
		end
		target = raw.Target
	elseif scope == "Inst" or raw.Kind == "Ipo" then
		if not finite(raw.Target) or raw.Target % 1 ~= 0 or raw.Target < 1 or raw.Target > 255 then
			return nil
		end
		target = raw.Target
	end
	local ev: BusEvent = {
		Id = raw.Id,
		Kind = raw.Kind,
		Scope = scope,
		Target = target,
		Strength = if finite(raw.Strength) then math.clamp(raw.Strength, 0, 5) else 0,
		Ramp = if finite(raw.Ramp) then math.clamp(math.floor(raw.Ramp), 1, admin.Ramp[2]) else admin.Ramp[1],
		Decay = if finite(raw.Decay) then math.clamp(math.floor(raw.Decay), 1, admin.Decay[2]) else admin.Decay[1],
		StartTick = start,
		Until = untilTick,
		Text = nil,
		By = if finite(raw.By) then math.floor(raw.By) else 0,
		Warn = if finite(raw.Warn) then math.clamp(math.floor(raw.Warn), 0, admin.WarnSeconds) else 0,
		Band = if finite(raw.Band) then math.clamp(math.floor(raw.Band), 1, 4) else nil,
		Dir = if finite(raw.Dir) then (if raw.Dir < 0 then -1 else 1) else nil,
	}
	if type(raw.Text) == "table" then
		local de, en = cleanText(raw.Text.de), cleanText(raw.Text.en)
		if de or en then
			ev.Text = { de = de or en or "", en = en or de or "" }
		end
	end
	-- Gesamtdauer (Warnung + Rampe + Abklingen) nie über MaxSpan
	if ev.Kind == "Crash" or ev.Kind == "Rally" or ev.Kind == "Pump" or ev.Kind == "Dump" then
		local span = (ev.Warn or 0) + ev.Ramp + ev.Decay
		if span > admin.MaxSpan then
			ev.Decay = math.max(1, admin.MaxSpan - (ev.Warn or 0) - ev.Ramp)
		end
	end
	return ev
end

local function mapName(week: number): string
	return (tech().BusMapPrefix or "AT_Bus_W") .. week
end

local function keyOf(ev: BusEvent): string
	return string.format("%012d_%s", ev.StartTick, ev.Id)
end

local function deliver(raw: any, source: string)
	local now = nowFn()
	local ev = GlobalBus.Validate(raw, now)
	if ev == nil or seenIds[ev.Id] then
		return
	end
	remember(ev.Id)
	local late = ev.StartTick <= now
	local fn = handler
	if fn then
		local ok, err = pcall(function(): any
			fn(ev, late)
			return nil
		end)
		if not ok then
			warn("[GlobalBus] Fehler beim Anwenden (" .. source .. "): " .. tostring(err))
		end
	end
end

-- ---------------------------------------------------------------------
-- LESEN (Poll + gezielt per Schlüssel)
-- ---------------------------------------------------------------------
local function readRange(week: number, fromKey: string?): (boolean, { any })
	local ok, result = pcall(function()
		local map = MemoryStoreService:GetSortedMap(mapName(week))
		return map:GetRangeAsync(Enum.SortDirection.Ascending, cfg().PageSize or 50, fromKey, nil)
	end)
	if not ok or type(result) ~= "table" then
		return false, {}
	end
	return true, result
end

-- Start: beim ersten Poll ab Horizont (26 h), danach ab min(letzter Schlüssel, jetzt − PollLookback). So werden auch
-- Events gefunden, deren Schlüssel kleiner ist als der zuletzt gesehene (zwei Server veröffentlichen fast gleichzeitig,
-- der frühere Start-Tick wird später geschrieben); Doppelte fängt die Id-Dedupe ab.
local function pollWeek(week: number, startKey: string, trailKey: string)
	local last = lastKeys[week]
	local key = if last == nil then startKey elseif last < trailKey then last else trailKey
	local pages = 0
	local allOk = true
	while pages < (cfg().MaxPages or 20) do
		pages += 1
		local ok, items = readRange(week, key)
		if not ok then
			allOk = false
			break
		end
		for _, entry in ipairs(items) do
			if type(entry) == "table" and type(entry.key) == "string" then
				key = entry.key
				deliver(entry.value, "poll")
			end
		end
		if #items < (cfg().PageSize or 50) then
			break
		end
	end
	if key then
		lastKeys[week] = key
	end
	busOk = allOk
end

function GlobalBus.Poll()
	if localOnly or polling then
		return
	end
	polling = true
	local now = nowFn()
	local week = MarketClock.WeekIndex(now)
	local horizon = now - (cfg().ExpirySeconds or 93600)
	local startKey = string.format("%012d", math.max(0, horizon))
	local trailKey = string.format("%012d", math.max(0, now - (cfg().PollLookback or 30)))
	local ok, err = pcall(function()
		if MarketClock.WeekIndex(horizon) < week then
			pollWeek(week - 1, startKey, trailKey)
		end
		pollWeek(week, startKey, trailKey)
	end)
	if not ok then
		busOk = false
		warn("[GlobalBus] Poll-Fehler: " .. tostring(err))
	end
	polling = false
end

local function fetchKey(key: string)
	local startTick = tonumber(string.sub(key, 1, 12))
	if startTick == nil then
		return
	end
	local ok, value = pcall(function()
		local map = MemoryStoreService:GetSortedMap(mapName(MarketClock.WeekIndex(startTick)))
		return map:GetAsync(key)
	end)
	if ok and value ~= nil then
		deliver(value, "messaging")
	end
end

-- ---------------------------------------------------------------------
-- START / VERÖFFENTLICHEN
-- ---------------------------------------------------------------------
function GlobalBus.Start(onEvent: (BusEvent, boolean) -> (), opts: { Local: boolean, Now: (() -> number)? })
	handler = onEvent
	localOnly = opts.Local == true
	if opts.Now then
		nowFn = opts.Now
	end
	if started then
		return
	end
	started = true
	if localOnly then
		return
	end
	local ok, conn = pcall(function()
		return MessagingService:SubscribeAsync(tech().BusTopic or "AT_EV", function(message: any)
			local data = if type(message) == "table" then message.Data else nil
			if type(data) == "string" and #data <= 100 and string.match(data, "^%d+_[%w]+$") then
				task.spawn(fetchKey, data)
			end
		end)
	end)
	if ok and conn then
		subscription = conn
	else
		busOk = false
		warn("[GlobalBus] Messaging-Abo fehlgeschlagen – nur Poll (" .. tostring(conn) .. ")")
	end
	GlobalBus.Poll()
end

function GlobalBus.Stop()
	if subscription then
		subscription:Disconnect()
		subscription = nil
	end
	started = false
end

local function appendLog(ev: BusEvent)
	pcall(function()
		local ds = DataStoreService:GetDataStore(tech().GlobalStore or "AT_Global")
		local week = MarketClock.WeekIndex(ev.StartTick)
		ds:UpdateAsync("AdminLog_W" .. week, function(old: any)
			local list = if type(old) == "table" then old else {}
			table.insert(list, ev)
			while #list > (cfg().LogMax or 200) do
				table.remove(list, 1)
			end
			return list
		end)
	end)
end

-- yieldet; Rückgabe (true, "ok") verteilt · (true, "local") nur lokal · (false, Grund) abgebrochen
function GlobalBus.Publish(ev: BusEvent): (boolean, string?)
	local now = nowFn()
	local clean = GlobalBus.Validate(ev, now)
	if clean == nil then
		return false, "invalid"
	end
	if localOnly then
		deliver(clean, "local")
		return true, "local"
	end
	local key = keyOf(clean)
	local okSet, errSet = pcall(function()
		local map = MemoryStoreService:GetSortedMap(mapName(MarketClock.WeekIndex(clean.StartTick)))
		map:SetAsync(key, clean, cfg().ExpirySeconds or 93600)
	end)
	if not okSet then
		busOk = false
		warn("[GlobalBus] Markt-Event nicht verteilt: " .. tostring(errSet))
		return false, "store"
	end
	busOk = true
	pcall(function()
		MessagingService:PublishAsync(tech().BusTopic or "AT_EV", key)
	end)
	deliver(clean, "publish") -- der eigene Server wendet sofort an (Poll/Messaging deduplizieren)
	task.spawn(appendLog, clean)
	return true, "ok"
end

function GlobalBus.LoadLog(week: number): { BusEvent }
	local out: { BusEvent } = {}
	if localOnly then
		return out
	end
	local ok, list = pcall(function()
		local ds = DataStoreService:GetDataStore(tech().GlobalStore or "AT_Global")
		return (ds:GetAsync("AdminLog_W" .. week))
	end)
	if not ok or type(list) ~= "table" then
		return out
	end
	local count = 0
	for _, raw in ipairs(list) do
		count += 1
		if count > (cfg().LogMax or 200) then
			break
		end
		-- Log-Einträge sind älter als der Bus: nur Form prüfen (Zeitgrenze relativ zum eigenen Start)
		if type(raw) == "table" and finite(raw.StartTick) then
			local ev = GlobalBus.Validate(raw, math.floor(raw.StartTick))
			if ev then
				table.insert(out, ev)
			end
		end
	end
	return out
end

return GlobalBus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">MarketAdmin</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Admin-Markt-Aktionen prüfen & klemmen (Server/Market/MarketAdmin)
--  Besitzer: WP3 (Markt-Engine). Vertrag: DESIGN.md §B15.3 (Admin-Abuse-Katalog), §B10.4 (CancelAutoShow),
--  MARKET.md §17. Aufruf nur über MarketService.Admin (dort: Besitzer-Prüfung, 3-s-Abklingzeit, Textfilter, Bus).
--  Markt-Events wirken IMMER global (GlobalBus), klingen IMMER ab und öffnen ein Admin-Fenster (Liga-Taint).
--
--  Aktionen (action = Types.MarketEvent.Kind) und Argumente (alles geklemmt; Prozent 5…50 werden als 0,05…0,5 gelesen,
--  Abklingen ≤ 60 als Minuten):
--    "Crash" / "Rally"   { Scope = "All"|"Sector"|"Inst", Target?, Strength 0,05…0,5, Ramp 30…300 s, Decay 5…60 min,
--                          Warn = true (nur Crash: 3-min-Warnung) }
--    "Pump" / "Dump"     { Target = Firmen-Id, Strength, Ramp?, Decay? }
--    "News"              { Scope = "Inst"|"Sector", Target, Band 1…4, Dir +1/−1, Text = { de, en } oder Text (≤ 80) }
--    "Halt"              { Scope = "All"|"Inst", Target?, Seconds 10…600 }      "Resume" { Scope?, Target? }
--    "Ipo"               { Target = IPO-Id aus der aktuellen Pipeline }  -> Erstnotiz in 10 min
--    "Vol"               { Strength = ×0,5…×3, Seconds 300…1800 (oder Minutes 5…30) }
--    "Normalize"         {}                     "CancelAutoShow" { Target? = Woche }
--  Alias-Schlüssel: I = Target, Sector = Target (bei Scope Sector), Pct = Strength.
--
--  Öffentliche API (nur WP3)
--    MarketAdmin.Build(action, args, ctx): (BusEvent?, string?)   Fehler = Lang-Schlüssel "mkt.admin.*"
--      ctx = { Now: number, ById: { [id]: Instrument }, Listed: (id) -> boolean (handelt jetzt),
--              Taken: (id) -> boolean (IPO gelistet oder angesetzt), InPipeline: (id) -> boolean,
--              Week: number, By: number, NewId: () -> string }
--    MarketAdmin.PRICE_KINDS   Kinds, die Kurse bewegen (sagen die Samstags-Show ab)
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MarketAdmin = {}

type Plain = { [string]: any }

MarketAdmin.PRICE_KINDS = { Crash = true, Rally = true, Pump = true, Dump = true, News = true, Vol = true, Ipo = true }

local SECTORS = { T = true, E = true, M = true, K = true, G = true, F = true }
local MAX_ARG_KEYS = 12

local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function numberArg(args: Plain, ...: string): number?
	for index = 1, select("#", ...) do
		local value = args[select(index, ...)]
		if finite(value) then
			return value
		end
	end
	return nil
end

local function strength(args: Plain, lo: number, hi: number, default: number): number
	local v = numberArg(args, "Strength", "Pct") or default
	if v > 1 then
		v /= 100 -- 5 … 50 (Prozent) -> 0,05 … 0,5
	end
	return math.clamp(v, lo, hi)
end

local function seconds(value: number?, lo: number, hi: number, default: number, minutesBelow: number?): number
	local v = value or default
	if minutesBelow and v <= minutesBelow then
		v *= 60
	end
	return math.clamp(math.floor(v), lo, hi)
end

local function isStock(ctx: Plain, id: any): boolean
	if not finite(id) or id % 1 ~= 0 then
		return false
	end
	local inst = ctx.ById[id]
	return type(inst) == "table" and inst.Class ~= "ETF" and inst.Set ~= "Tutorial" and ctx.Listed(id)
end

-- Ziel bestimmen: { Scope, Target } oder nil
local function scopeOf(args: Plain, ctx: Plain, allowAll: boolean): (string?, (number | string)?)
	local scope = args.Scope
	local target = if args.Target ~= nil then args.Target elseif args.I ~= nil then args.I else args.Sector
	if scope == nil then
		if type(target) == "string" then
			scope = "Sector"
		elseif target ~= nil then
			scope = "Inst"
		else
			scope = "All"
		end
	end
	if scope == "All" then
		return if allowAll then "All" else nil, nil
	elseif scope == "Sector" then
		if type(target) == "string" and SECTORS[target] then
			return "Sector", target
		end
		return nil, nil
	elseif scope == "Inst" then
		if isStock(ctx, target) then
			return "Inst", target
		end
		return nil, nil
	end
	return nil, nil
end

local function textPair(raw: any): { de: string, en: string }?
	local maxChars = ((Config.Market :: any).Admin.NewsMaxChars or 80) :: number
	local function cut(text: any): string?
		if type(text) ~= "string" then
			return nil
		end
		local clean = string.gsub(text, "[%c]", " ")
		clean = string.gsub(clean, "^%s+", "")
		clean = string.gsub(clean, "%s+$", "")
		if clean == "" then
			return nil
		end
		local len = utf8.len(clean)
		if len == nil then
			return nil -- kaputtes UTF-8
		end
		if len > maxChars then
			local stop = utf8.offset(clean, maxChars + 1)
			clean = string.sub(clean, 1, (stop or (#clean + 1)) - 1)
		end
		return clean
	end
	if type(raw) == "string" then
		local text = cut(raw)
		return if text then { de = text, en = text } else nil
	elseif type(raw) == "table" then
		local de, en = cut(raw.de), cut(raw.en)
		if de or en then
			return { de = de or en or "", en = en or de or "" }
		end
	end
	return nil
end

function MarketAdmin.Build(action: string, args: any, ctx: Plain): (Plain?, string?)
	local market: any = Config.Market
	local admin = market.Admin
	local a: Plain = if type(args) == "table" then args else {}
	local keys = 0
	for _ in pairs(a) do
		keys += 1
		if keys > MAX_ARG_KEYS then
			return nil, "mkt.admin.badArgs"
		end
	end
	local now = ctx.Now
	local start = now + admin.Lead
	local ev: Plain = {
		Id = ctx.NewId(),
		Kind = action,
		Scope = "All",
		Target = nil,
		Strength = 0,
		Ramp = admin.Ramp[1],
		Decay = admin.Decay[1],
		StartTick = start,
		Until = start,
		Text = nil,
		By = ctx.By,
		Warn = 0,
	}
	if action == "Crash" or action == "Rally" or action == "Pump" or action == "Dump" then
		local isMove = action == "Pump" or action == "Dump"
		local scope, target = scopeOf(a, ctx, not isMove)
		if scope == nil or (isMove and scope ~= "Inst") then
			return nil, "mkt.admin.badArgs"
		end
		ev.Scope, ev.Target = scope, target
		ev.Strength = strength(a, admin.Strength[1], admin.Strength[2], 0.2)
		ev.Ramp = seconds(numberArg(a, "Ramp"), admin.Ramp[1], admin.Ramp[2], 60)
		ev.Decay = seconds(numberArg(a, "Decay"), admin.Decay[1], admin.Decay[2], 900, 60)
		ev.Warn = if action == "Crash" and a.Warn == true then admin.WarnSeconds else 0
		local span = ev.Warn + ev.Ramp + ev.Decay
		if span > admin.MaxSpan then
			ev.Decay = math.max(admin.Decay[1] // 2, admin.MaxSpan - ev.Warn - ev.Ramp)
		end
		ev.Until = start + ev.Warn + ev.Ramp + ev.Decay
	elseif action == "News" then
		local scope, target = scopeOf(a, ctx, false)
		if scope == nil then
			return nil, "mkt.admin.badArgs"
		end
		local text = textPair(a.Text)
		if text == nil then
			return nil, "mkt.admin.badArgs"
		end
		ev.Scope, ev.Target = scope, target
		ev.Band = math.clamp(math.floor(numberArg(a, "Band") or 2), 1, 4)
		ev.Dir = if (numberArg(a, "Dir") or 1) < 0 then -1 else 1
		ev.Text = text
		ev.Until = start + market.Delay + market.Tau + admin.NewsDecay
	elseif action == "Halt" then
		local scope, target = scopeOf(a, ctx, true)
		if scope == nil or scope == "Sector" then
			return nil, "mkt.admin.badArgs"
		end
		ev.Scope, ev.Target = scope, target
		local secs = numberArg(a, "Seconds")
		local minutes = numberArg(a, "Minutes")
		if secs == nil and minutes then
			secs = minutes * 60
		end
		ev.Until = start + seconds(secs, admin.HaltSeconds[1], admin.HaltSeconds[2], 60)
	elseif action == "Resume" then
		local scope, target = scopeOf(a, ctx, true)
		if scope == nil or scope == "Sector" then
			return nil, "mkt.admin.badArgs"
		end
		ev.Scope, ev.Target = scope, target
		ev.Until = start
	elseif action == "Ipo" then
		local id = if a.Target ~= nil then a.Target else a.I
		if not finite(id) or id % 1 ~= 0 then
			return nil, "mkt.admin.ipoUnknown"
		end
		if not ctx.InPipeline(id) then
			return nil, "mkt.admin.ipoUnknown"
		end
		if ctx.Listed(id) or (type(ctx.Taken) == "function" and ctx.Taken(id)) then
			return nil, "mkt.admin.ipoListed"
		end
		ev.Scope, ev.Target = "Inst", id
		ev.Until = now + market.IpoPipeline.AdminLead
	elseif action == "Vol" then
		local mult = numberArg(a, "Strength", "Mult") or 2
		ev.Strength = math.clamp(mult, admin.Vol[1], admin.Vol[2])
		local secs = numberArg(a, "Seconds")
		local minutes = numberArg(a, "Minutes")
		if secs == nil and minutes then
			secs = minutes * 60
		end
		ev.Until = start + seconds(secs, admin.VolSeconds[1], admin.VolSeconds[2], 600)
	elseif action == "Normalize" then
		ev.Until = start + admin.NormalizeSeconds
	elseif action == "CancelAutoShow" then
		local week = numberArg(a, "Target", "Week") or ctx.Week
		ev.Target = math.floor(week)
		ev.Until = start
	else
		return nil, "mkt.admin.unknown"
	end
	return ev, nil
end

return MarketAdmin
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">MarketAudit</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Fill-Audit & Ausreißer (Server/Market/MarketAudit)
--  Besitzer: WP3 (Markt-Engine). Vertrag: MARKET.md §13 Nr. 17, DESIGN.md §C11.2 ("Engine-Fehler"), §B15.2 (Statistik).
--  Jeder Fill wird gegen den deterministischen Kurs nachgerechnet:
--    Sofort-Order (Type "MKT", wenn bekannt): Kauf == Brief(t), Verkauf == Geld(t) – exakt.
--    sonst (Limit/Stopp/Ziel/OCO/Nachzieh-Stopp/Bots): Px liegt in [L − hs, H + hs] der 1s-Kerze von t
--    (jede regelkonforme Ausführung inkl. Kurslücke liegt in diesem Band, MARKET §11.3).
--  Tages-G/V-Ausreißer: z > 6 gegenüber den eigenen letzten Börsentagen (≥ 6 Werte) -> "verdächtig" im
--  Admin-Panel. KEINE automatische Strafe. Alles nur im Speicher, je Spieler bei PlayerRemoving geleert.
--
--  Öffentliche API (nur WP3)
--    MarketAudit.VerifyFill(fill, ctx): boolean    fill = { I, Side, Px, Tick, Q?, Type? }
--                                                  ctx = { CandleAt(i, t) -> (O, H, L, C), Quote(i, t) -> (bid, ask) }
--    MarketAudit.NoteDay(userId, day, ret)         MarketAudit.Clear(userId)
--    MarketAudit.Stats(): { Checked, Failed, Recent = { … }, Suspicious = { … } }
-- =====================================================================

local MarketAudit = {}

local MAX_RECENT = 20
local MAX_SUSPICIOUS = 50
local MAX_DAYS = 30
local MIN_DAYS = 6
local Z_LIMIT = 6
local MIN_STD = 0.005

type Plain = { [string]: any }

local checked = 0
local failed = 0
local recent: { Plain } = {}
local suspicious: { Plain } = {}
local days: { [number]: { number } } = {}

local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function push(list: { Plain }, entry: Plain, limit: number)
	table.insert(list, entry)
	while #list > limit do
		table.remove(list, 1)
	end
end

function MarketAudit.VerifyFill(fill: Plain, ctx: Plain): boolean
	if type(fill) ~= "table" then
		return false
	end
	local i, px, t, side = fill.I, fill.Px, fill.Tick, fill.Side
	if not finite(i) or not finite(px) or not finite(t) or (side ~= "B" and side ~= "S") then
		return true -- unvollständige Meldung: nichts zu prüfen (kein Fehlalarm)
	end
	checked += 1
	local ok = true
	local reason = ""
	local okCandle, _open, h, l = pcall(ctx.CandleAt, i, t)
	local okQuote, bid, ask = pcall(ctx.Quote, i, t)
	if not okCandle or not okQuote or not finite(h) or not finite(l) or not finite(bid) or not finite(ask) then
		return true -- Kurs nicht berechenbar (z. B. Instrument noch nicht gelistet): kein Urteil
	end
	local hs = math.max((ask :: number) - (bid :: number), 0)
	if fill.Type == "MKT" then
		local expected = if side == "B" then ask else bid
		if px ~= expected then
			ok = false
			reason = ("MKT %s erwartet %s, bekommen %s"):format(side, tostring(expected), tostring(px))
		end
	else
		local lo = (l :: number) - hs - 1
		local hi = (h :: number) + hs + 1
		if px < lo or px > hi then
			ok = false
			reason = ("Px %s außerhalb [%s, %s]"):format(tostring(px), tostring(lo), tostring(hi))
		end
	end
	if not ok then
		failed += 1
		push(recent, {
			I = i,
			Tick = t,
			Side = side,
			Px = px,
			Q = fill.Q,
			Reason = reason,
			At = os.time(),
		}, MAX_RECENT)
		warn("[MarketAudit] Abweichung: " .. reason .. " (Inst " .. tostring(i) .. ", Tick " .. tostring(t) .. ")")
	end
	return ok
end

function MarketAudit.NoteDay(userId: number, day: number, ret: number)
	if not finite(userId) or not finite(ret) then
		return
	end
	local list = days[userId]
	if list == nil then
		list = {}
		days[userId] = list
	end
	local n = #list
	if n >= MIN_DAYS then
		local sum, sq = 0, 0
		for _, r in ipairs(list) do
			sum += r
			sq += r * r
		end
		local mean = sum / n
		local std = math.max(MIN_STD, math.sqrt(math.max(0, sq / n - mean * mean)))
		local z = (ret - mean) / std
		if z > Z_LIMIT then
			push(suspicious, {
				UserId = userId,
				Day = day,
				Return = ret,
				Z = math.round(z * 10) / 10,
				At = os.time(),
			}, MAX_SUSPICIOUS)
		end
	end
	table.insert(list, ret)
	while #list > MAX_DAYS do
		table.remove(list, 1)
	end
end

function MarketAudit.Clear(userId: number)
	days[userId] = nil
end

function MarketAudit.Stats(): Plain
	local recentCopy: { Plain } = table.clone(recent)
	local suspiciousCopy: { Plain } = table.clone(suspicious)
	return { Checked = checked, Failed = failed, Recent = recentCopy, Suspicious = suspiciousCopy }
end

return MarketAudit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">MarketClock</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Markt-Uhr: Tick, Börsentag, Woche, Berlin-Termine (Server/Market/MarketClock)
--  Besitzer: WP3 (Markt-Engine). Vertrag: MARKET.md §3, §18.1; DESIGN.md §B10.4 (Berlin-Zeit über Shared/Clock).
--  Dünne Schicht über Shared/Clock (WP1): Tick = floor(unixMs/1000) − EPOCH, Börsentag = 1200 Ticks, Woche = 604.800.
--
--  Öffentliche API
--    MarketClock.Tick(): number                     aktueller Server-Tick
--    MarketClock.DayIndex(t) · DayStart(d) · Minute(t) (0…19, ganzzahlig) · Second(t) (0…1199 im Börsentag)
--    MarketClock.WeekIndex(t) · WeekStart(w) · WeekEnd(w) (letzter Tick der Woche) · DayInWeek(t) (0…503)
--    MarketClock.Unix(t) · MarketClock.TickOf(unix)
--    MarketClock.WeeklyTick(w, dow, hh, mm): number?   Tick des Berlin-Termins (dow 1 = Mo … 7 = So) in Woche w, sonst nil
--    MarketClock.DAY · MarketClock.WEEK · MarketClock.DAYS_PER_WEEK (504)
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Clock"))

local MarketClock = {}

local DAY = Clock.DAY_TICKS
local WEEK = Clock.WEEK_TICKS

MarketClock.DAY = DAY
MarketClock.WEEK = WEEK
MarketClock.DAYS_PER_WEEK = WEEK // DAY

function MarketClock.Tick(): number
	return Clock.Tick()
end

function MarketClock.DayIndex(t: number): number
	return t // DAY
end

function MarketClock.DayStart(d: number): number
	return d * DAY
end

function MarketClock.Second(t: number): number
	return t - (t // DAY) * DAY
end

function MarketClock.Minute(t: number): number
	return MarketClock.Second(t) // 60
end

function MarketClock.WeekIndex(t: number): number
	return t // WEEK
end

function MarketClock.WeekStart(w: number): number
	return w * WEEK
end

function MarketClock.WeekEnd(w: number): number
	return (w + 1) * WEEK - 1
end

function MarketClock.DayInWeek(t: number): number
	return (t - (t // WEEK) * WEEK) // DAY
end

function MarketClock.Unix(t: number): number
	return Clock.UnixOf(t)
end

function MarketClock.TickOf(unix: number): number
	return Clock.TickOf(unix)
end

-- Berlin-Termin (Ortszeit, Sommerzeit automatisch) innerhalb der Woche w; alle Server rechnen denselben Tick
function MarketClock.WeeklyTick(w: number, dow: number, hh: number, mm: number): number?
	local startUnix = Clock.UnixOf(MarketClock.WeekStart(w))
	local unix = Clock.NextBerlin(dow, hh, mm, startUnix - 1)
	local t = Clock.TickOf(unix)
	if t < MarketClock.WeekStart(w) or t > MarketClock.WeekEnd(w) then
		return nil
	end
	return t
end

return MarketClock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">MarketSeed</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Wochen-Seeds, Wochenschluss, IPO-Liste (Server/Market/MarketSeed)
--  Besitzer: WP3 (Markt-Engine). Vertrag: MARKET.md §5.6, DESIGN.md §C13, §C17, §C19 Nr. 10.
--  DataStore Config.Tech.MarketStore ("AT_Market_v1"):
--    Seed_W<w>  zufällige 31-Bit-Zahl, UpdateAsync "nur setzen, wenn leer"; der erste Server legt auch Seed_W<w+1> an
--    Close_W<w> { [tostring(id)] = Cent } Wochenschlusskurse (Aktien, ETFs, gelistete IPOs) = Basis der Woche w+1
--    Ipo_S<s>   { [tostring(id)] = { Tick, Issue, Open, By } } gelistete IPOs der Saison s
--    Tune_W<w>  { NewsMeanGap } – Live-Stellschraube, beim Anlegen der Woche eingefroren (alle Server gleich)
--  Der Seed ist NIE im Place-File/Config und erreicht NIE einen Client.
--  Studio (Config.Studio.LocalMarket) oder DataStore nicht erreichbar -> Fallback-Seed (lokaler Testmarkt):
--    hash4(Config.Market.StudioSalt, w, PEPPER, 0) – PEPPER liegt nur hier (ServerScriptService, nicht repliziert),
--    damit ein Client aus der replizierten Config den Fallback-Markt nicht vorausrechnen kann.
--  Live: zuerst Wiederholen mit Backoff (Config.Market.Seed.RetrySeconds), dann Fallback.
--  Alle DataStore-Aufrufe in pcall; alle Funktionen außer Fallback() YIELDEN (nur aus eigenen Threads aufrufen).
--
--  Öffentliche API (nur WP3)
--    MarketSeed.Load(w): (seed: number, local: boolean)
--    MarketSeed.Peek(w): number?  (nur lesen)   MarketSeed.EnsureNext(w)   MarketSeed.Fallback(w): number
--    MarketSeed.LoadClose(w): { [number]: number }?      MarketSeed.SaveClose(w, closes)
--    MarketSeed.LoadIpos(s): { [number]: { Tick, Issue, Open, By } }      MarketSeed.SaveIpo(s, id, rec)
--    MarketSeed.LoadTune(w, default): number (NewsMeanGap)
--    MarketSeed.IsLocal(): boolean            MarketSeed.Ok(): boolean (letzter DataStore-Zugriff erfolgreich)
-- =====================================================================

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Noise = require(script.Parent:WaitForChild("Noise"))

local MarketSeed = {}

local PEPPER = 0x6B1D3A57 -- Server-Geheimnis für den Fallback-Seed (nur ServerScriptService)
local MAX_ENTRIES = 300 -- so viele Einträge darf ein Close-/Ipo-Datensatz höchstens haben

local store: DataStore? = nil
local localMode = false
local lastOk = true

local function marketCfg(): { [string]: any }
	return Config.Market :: any
end

local function studioLocal(): boolean
	local studio: any = Config.Studio
	return RunService:IsStudio() and type(studio) == "table" and studio.LocalMarket == true
end

local function isAccessError(err: any): boolean
	local text = string.lower(tostring(err))
	return string.find(text, "studio", 1, true) ~= nil
		or string.find(text, "api services", 1, true) ~= nil
		or string.find(text, "403", 1, true) ~= nil
		or string.find(text, "publish", 1, true) ~= nil
end

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore((Config.Tech :: any).MarketStore or "AT_Market_v1")
	end)
	if ok and result then
		store = result
		return result
	end
	return nil
end

function MarketSeed.Fallback(w: number): number
	local salt = tonumber(marketCfg().StudioSalt) or 1
	return Noise.Hash4(salt, w, PEPPER, 0) % 2147483647 + 1
end

function MarketSeed.IsLocal(): boolean
	return localMode
end

function MarketSeed.Ok(): boolean
	return lastOk
end

-- ein DataStore-Aufruf mit pcall; Rückgabe ok, Ergebnis, ist Zugriffsfehler (Studio ohne API)
local function call(fn: (DataStore) -> any): (boolean, any, boolean)
	local ds = getStore()
	if ds == nil then
		lastOk = false
		return false, nil, true
	end
	local ok, result = pcall(fn, ds)
	lastOk = ok
	if not ok then
		return false, result, isAccessError(result)
	end
	return true, result, false
end

local function newSeed(): number
	local rng = Random.new()
	return rng:NextInteger(1, 2147483646)
end

local function validSeed(v: any): boolean
	return type(v) == "number" and v == v and v % 1 == 0 and v >= 1 and v < 2147483648
end

-- Seed_W<w> lesen bzw. anlegen ("nur setzen, wenn leer")
local function fetchSeed(w: number): (boolean, number?, boolean)
	local candidate = newSeed()
	local ok, result, access = call(function(ds: DataStore)
		return ds:UpdateAsync("Seed_W" .. w, function(old: any)
			if validSeed(old) then
				return nil -- nichts schreiben, vorhandenen behalten
			end
			return candidate
		end)
	end)
	if ok then
		if validSeed(result) then
			return true, result, false
		end
		-- UpdateAsync gibt bei "nil zurück" (nichts geschrieben) den alten Wert zurück; sicherheitshalber lesen
		local okGet, value = call(function(ds: DataStore)
			return (ds:GetAsync("Seed_W" .. w))
		end)
		if okGet and validSeed(value) then
			return true, value, false
		end
		return false, nil, false
	end
	return false, nil, access
end

function MarketSeed.Load(w: number): (number, boolean)
	if studioLocal() then
		localMode = true
		return MarketSeed.Fallback(w), true
	end
	local cfg = marketCfg().Seed or {}
	local backoff: { number } = cfg.Backoff or { 2, 4, 8, 15, 30 }
	local budget = tonumber(cfg.RetrySeconds) or 60
	local waited = 0
	local attempt = 0
	while true do
		attempt += 1
		local ok, seed, access = fetchSeed(w)
		if ok and seed then
			localMode = false
			return seed, false
		end
		if access and RunService:IsStudio() then
			break -- Studio ohne API-Zugriff: sofort lokaler Testmarkt
		end
		local pause = backoff[math.min(attempt, #backoff)] or 5
		if waited + pause > budget then
			break
		end
		task.wait(pause)
		waited += pause
	end
	warn("[MarketSeed] Seed nicht erreichbar – lokaler Fallback-Markt für Woche " .. w)
	localMode = true
	return MarketSeed.Fallback(w), true
end

-- nur lesen (Vorwoche für Historie/Offline-Abgleich): nil = gab es nicht oder nicht erreichbar
function MarketSeed.Peek(w: number): number?
	if studioLocal() or localMode then
		return MarketSeed.Fallback(w)
	end
	local ok, value = call(function(ds: DataStore)
		return (ds:GetAsync("Seed_W" .. w))
	end)
	if ok and validSeed(value) then
		return value
	end
	return nil
end

function MarketSeed.EnsureNext(w: number)
	if localMode or studioLocal() then
		return
	end
	fetchSeed(w + 1)
end

-- ---------------------------------------------------------------------
-- WOCHENSCHLUSS
-- ---------------------------------------------------------------------
local function cleanCloses(raw: any): { [number]: number }?
	if type(raw) ~= "table" then
		return nil
	end
	local out: { [number]: number } = {}
	local count = 0
	for key, value in pairs(raw) do
		count += 1
		if count > MAX_ENTRIES then
			break
		end
		local id = tonumber(key)
		if
			id
			and id % 1 == 0
			and id >= 1
			and id <= 255
			and type(value) == "number"
			and value == value
			and value % 1 == 0
			and value >= 1
			and value <= 9999999
		then
			out[id] = value
		end
	end
	return out
end

function MarketSeed.LoadClose(w: number): { [number]: number }?
	if localMode or studioLocal() then
		return nil
	end
	local ok, result = call(function(ds: DataStore)
		return (ds:GetAsync("Close_W" .. w))
	end)
	if not ok then
		return nil
	end
	return cleanCloses(result)
end

function MarketSeed.SaveClose(w: number, closes: { [number]: number })
	if localMode or studioLocal() then
		return
	end
	local payload: { [string]: number } = {}
	for id, cents in pairs(closes) do
		payload[tostring(id)] = math.clamp(math.round(cents), 1, 9999999)
	end
	call(function(ds: DataStore)
		return ds:UpdateAsync("Close_W" .. w, function(old: any)
			if type(old) == "table" and next(old) ~= nil then
				return nil -- erster Schreiber gewinnt (alle Server rechnen dieselben Werte)
			end
			return payload
		end)
	end)
end

-- ---------------------------------------------------------------------
-- IPO-LISTE JE SAISON
-- ---------------------------------------------------------------------
function MarketSeed.LoadIpos(s: number): { [number]: { [string]: number } }
	local out: { [number]: { [string]: number } } = {}
	if localMode or studioLocal() then
		return out
	end
	local ok, result = call(function(ds: DataStore)
		return (ds:GetAsync("Ipo_S" .. s))
	end)
	if not ok or type(result) ~= "table" then
		return out
	end
	local count = 0
	for key, rec in pairs(result) do
		count += 1
		if count > MAX_ENTRIES then
			break
		end
		local id = tonumber(key)
		if id and id >= 100 and id <= 139 and type(rec) == "table" then
			local tick, issue, open = tonumber(rec.Tick), tonumber(rec.Issue), tonumber(rec.Open)
			if tick and issue and open and tick >= 0 and issue >= 1 and open >= 1 and open <= 9999999 then
				out[id] = {
					Tick = math.floor(tick),
					Issue = math.floor(issue),
					Open = math.floor(open),
					By = tonumber(rec.By) or 0,
				}
			end
		end
	end
	return out
end

function MarketSeed.SaveIpo(s: number, id: number, rec: { [string]: number })
	if localMode or studioLocal() then
		return
	end
	call(function(ds: DataStore)
		return ds:UpdateAsync("Ipo_S" .. s, function(old: any)
			local data = if type(old) == "table" then old else {}
			local key = tostring(id)
			if data[key] ~= nil then
				return nil -- schon gelistet: nie überschreiben
			end
			data[key] = { Tick = rec.Tick, Issue = rec.Issue, Open = rec.Open, By = rec.By or 0 }
			return data
		end)
	end)
end

-- ---------------------------------------------------------------------
-- EINGEFRORENE LIVE-STELLSCHRAUBE (News-Takt) JE WOCHE
-- ---------------------------------------------------------------------
function MarketSeed.LoadTune(w: number, default: number): number
	local fallback = math.clamp(tonumber(default) or 1500, 300, 6000)
	if localMode or studioLocal() then
		return fallback
	end
	local ok, result = call(function(ds: DataStore)
		return ds:UpdateAsync("Tune_W" .. w, function(old: any)
			if type(old) == "table" and type(old.NewsMeanGap) == "number" then
				return nil
			end
			return { NewsMeanGap = fallback }
		end)
	end)
	if ok and type(result) == "table" and type(result.NewsMeanGap) == "number" then
		return math.clamp(result.NewsMeanGap, 300, 6000)
	end
	local okGet, value = call(function(ds: DataStore)
		return (ds:GetAsync("Tune_W" .. w))
	end)
	if okGet and type(value) == "table" and type(value.NewsMeanGap) == "number" then
		return math.clamp(value.NewsMeanGap, 300, 6000)
	end
	return fallback
end

return MarketSeed
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Noise</string>
            <string name="Source"><![CDATA[--!strict
--!native
-- =====================================================================
--  AKYTEX TYCOON – Deterministisches Hashing & Value-Noise (Server/Market/Noise)
--  Besitzer: WP3 (Markt-Engine). Vertrag: MARKET.md §5.2 (1:1), §19.2 (Testvektoren), DESIGN.md §D WP3.
--  Kein Random, kein math.random: identisch auf allen Servern und Roblox-Versionen, zustandslos (Random-Access).
--  Luau-Zahlen sind Doubles (exakt bis 2^53) -> 32-Bit-Multiplikation per 16-Bit-Split.
--  Rein: lädt keine Roblox-Dienste -> mit der Luau-CLI testbar (tests/noise.test.luau). Liegt NUR im Server.
--
--  Öffentliche API
--    Noise.Mul32(a, b): number            (a · b) mod 2^32
--    Noise.H32(x): number                 "lowbias32" (Wellons)
--    Noise.Hash4(a, b, c, d): number      h32-Kette ab 0x9E3779B9 (= Python-Referenz hcomb)
--    Noise.Uni(seed, fid, k, n): number   gleichverteilt in [−1, 1)
--    Noise.Rnd(seed, a, b, c): number     gleichverteilt in [0, 1)
--    Noise.Gauss(seed, a, b, c): number   ≈ N(0, 1): Summe von 3 Uniforms (Var = 1)
--    Noise.White(seed, fid, t): number    MARKET §5.2 whiteAt (Kanäle 9001/9002/9003)
--    Noise.NewField(seed, fid, kMin?, kMax?): Field     Oktaven kMin…kMax (Standard 1…14), Varianz 1
--    Noise.FieldAt(f, t): number          sequentiell billig (14 Lerps), Hashes nur beim Gitterwechsel
--    Noise.K, Noise.P0, Noise.PERIOD, Noise.AMP
--  Live-Felder und Random-Access-Felder sind GETRENNTE Field-Objekte (Caches stören sich nicht).
-- =====================================================================

local Noise = {}

local band = bit32.band
local bxor = bit32.bxor
local rshift = bit32.rshift

local TWO16 = 65536
local TWO32 = 4294967296

-- ---------------------------------------------------------------------
-- 1) HASH
-- ---------------------------------------------------------------------
local function mul32(a: number, b: number): number
	local aHi, aLo = rshift(a, 16), band(a, 0xFFFF)
	local bHi, bLo = rshift(b, 16), band(b, 0xFFFF)
	local mid = (aHi * bLo + aLo * bHi) % TWO16
	return (mid * TWO16 + aLo * bLo) % TWO32
end

-- Multiplikation mit den festen lowbias32-Konstanten (gleiche Mathematik wie mul32, vorgerechnete Hälften)
local C1_HI, C1_LO = rshift(0x7FEB352D, 16), band(0x7FEB352D, 0xFFFF)
local C2_HI, C2_LO = rshift(0x846CA68B, 16), band(0x846CA68B, 0xFFFF)

local function h32(input: number): number
	local x = bxor(input, rshift(input, 16))
	local hi, lo = rshift(x, 16), band(x, 0xFFFF)
	x = (((hi * C1_LO + lo * C1_HI) % TWO16) * TWO16 + lo * C1_LO) % TWO32
	x = bxor(x, rshift(x, 15))
	hi, lo = rshift(x, 16), band(x, 0xFFFF)
	x = (((hi * C2_LO + lo * C2_HI) % TWO16) * TWO16 + lo * C2_LO) % TWO32
	return bxor(x, rshift(x, 16))
end

local function hash4(a: number, b: number, c: number, d: number): number
	local h = h32(bxor(0x9E3779B9, a))
	h = h32(bxor(h, b))
	h = h32(bxor(h, c))
	return h32(bxor(h, d))
end

local function uni(seed: number, fid: number, k: number, n: number): number
	return hash4(seed, fid, k, n) / 2147483648 - 1
end

Noise.Mul32 = mul32
Noise.H32 = h32
Noise.Hash4 = hash4
Noise.Uni = uni

function Noise.Rnd(seed: number, a: number, b: number, c: number): number
	return hash4(seed, a, b, c) / TWO32
end

function Noise.Gauss(seed: number, a: number, b: number, c: number): number
	-- Summe von 3 Uniforms in [−1, 1): Varianz 3 · 1/3 = 1, Bereich (−3, 3)
	return uni(seed, a, b, c) + uni(seed, a, b + 7919, c) + uni(seed, a, b + 15887, c)
end

function Noise.White(seed: number, fid: number, t: number): number
	return uni(seed, fid, 9001, t) + uni(seed, fid, 9002, t) + uni(seed, fid, 9003, t)
end

-- ---------------------------------------------------------------------
-- 2) VALUE-NOISE (14 Oktaven, Perioden 2 s … 16.384 s, Amplitude √Periode, oberste zwei ×0,6)
-- ---------------------------------------------------------------------
local K, P0 = 14, 2
local PERIOD: { number } = table.create(K)
local AMP: { number } = table.create(K)
for k = 1, K do
	PERIOD[k] = P0 * 2 ^ (k - 1)
	AMP[k] = math.sqrt(PERIOD[k]) * (if k == K then 0.6 elseif k == K - 1 then 0.6 else 1)
end

Noise.K = K
Noise.P0 = P0
Noise.PERIOD = PERIOD
Noise.AMP = AMP

export type Field = {
	Seed: number,
	Id: number,
	KMin: number,
	KMax: number,
	Norm: number,
	Ph: { number },
	N: { number },
	V0: { number },
	V1: { number },
}

-- Var(uni) = 1/3, Mittel der Lerp-Varianz = 2/3 -> INV_NORM wie MARKET §5.2 (für Teil-Oktaven entsprechend)
local function invNorm(kMin: number, kMax: number): number
	local sumSq = 0
	for k = kMin, kMax do
		sumSq += AMP[k] ^ 2
	end
	return 1 / math.sqrt(sumSq * (2 / 3) * (1 / 3))
end

function Noise.NewField(seed: number, fid: number, kMin: number?, kMax: number?): Field
	local lo = math.clamp(math.floor(kMin or 1), 1, K)
	local hi = math.clamp(math.floor(kMax or K), lo, K)
	local f: Field = {
		Seed = seed,
		Id = fid,
		KMin = lo,
		KMax = hi,
		Norm = invNorm(lo, hi),
		Ph = table.create(K, 0),
		N = table.create(K, -1),
		V0 = table.create(K, 0),
		V1 = table.create(K, 0),
	}
	for k = lo, hi do
		f.Ph[k] = hash4(seed, fid, k - 1, 777) % PERIOD[k] -- Phasenversatz; Oktaven-Index im Hash 0-basiert
		f.N[k] = -1
	end
	return f
end

-- Sequentiell (Live, Offline-Abgleich) praktisch nur Lerps; Random-Access rechnet beim Sprung 2 Hashes je Oktave
function Noise.FieldAt(f: Field, t: number): number
	local sum = 0
	local seed, id = f.Seed, f.Id
	local ph, nn, v0, v1 = f.Ph, f.N, f.V0, f.V1
	for k = f.KMin, f.KMax do
		local u = (t + ph[k]) / PERIOD[k]
		local n = u // 1
		if n ~= nn[k] then
			v0[k] = if n == nn[k] + 1 then v1[k] else uni(seed, id, k - 1, n)
			v1[k] = uni(seed, id, k - 1, n + 1)
			nn[k] = n
		end
		sum += AMP[k] * (v0[k] + (v1[k] - v0[k]) * (u - n))
	end
	return sum * f.Norm
end

return Noise
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">OrderEngine</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Order-Logik: Platzieren, Trigger je 1s-Kerze, Ablauf, Dividenden, Börsentag-Schluss
--  (Server/Market/OrderEngine)
--  Besitzer: WP4 (Orders, Depot, Bots). Vertrag: DESIGN.md §B7.3, §B8.2, §C9 (TradePlace/Cancel/Modify), §C11;
--  MARKET.md §11.1–§11.6, §12.3, §12.6, §13.
--  Reines Daten-Modul ohne Remotes/Services/Yield: alle Kurse kommen über eine "Env"-Tabelle (OrderService baut sie
--  aus MarketService; Tests bauen einen künstlichen Markt). Online und Offline (CatchUp) rufen DIESELBE Funktion
--  Step(d, env, t, ctx) je Tick auf -> gleiche Fills, gleiche Ticks (Abnahme WP4 #4).
--
--  Ablauf je Tick (Step):  Börsentag-Schluss (t % 1200 == 0) -> abgelaufene Orders -> Trigger je Wert (1s-Kerze t,
--  nur Orders mit T0 < t, Pfad-Regel) -> Alarme -> Dividenden (Bestand nach den Triggern) -> Bots (t % 60 == 0)
--  -> d.LastTick = t.
--
--  Kurse der Engine (Trigger, Bots, Depotwert-Grenzen): mid = PriceAt(i, t), halber Spread hs je Minute aus dem
--  Schlusskurs der Vorminute × Klassen-Spread (Config.Market.Classes) – deterministisch, damit Offline == Online.
--  "Sofort"-Orders der Spieler laufen zum zuletzt gesendeten Quote (env.Quote, MARKET §11.1).
--
--  Öffentliche API:
--    OrderEngine.HalfSpread(env, i, t): number         OrderEngine.EngineQuote(env, i, t): (bid?, ask?, mid?)
--    OrderEngine.NavAt(d, env, t): number              OrderEngine.TransferAmount(d, env, nav): (cents, reasonKey?)
--    OrderEngine.Place(d, env, t, req): Result         req = { I, Side, Type, Qty?, Pct?, Lim?, Stp?, Tp?, Trl?,
--                                                      Protect?, Exp?, MaxPx?, MinPx?, Bot?, Live? }
--    OrderEngine.Cancel(d, id): boolean                OrderEngine.Modify(d, env, t, id, changes): Result
--    OrderEngine.CancelBotOrders(d, slot, inst?) · BuyNow/SellNow · AttachProtection/AttachStop (Bots)
--    OrderEngine.CheckInstrument(d, env, i, t, o, h, l, c)   OrderEngine.CheckAlerts(d, env, i, t, h, l)
--    OrderEngine.Expire(d, env, t) · OrderEngine.PayDividends(d, env, t, list) · OrderEngine.CloseDay(d, env, t)
--    OrderEngine.Step(d, env, t, ctx)                  ctx = { Candle = (i) -> (o, h, l, c)?, Divs = { … }? }
--    OrderEngine.ActiveInstruments(d): { number }      Werte mit offenen Orders oder Alarmen (sortiert)
--    OrderEngine.CanTrigger(d, i, hMax, lMin, hs): boolean   Minuten-Überspringen im Offline-Abgleich (exakt)
--    OrderEngine.InstAllowed(env, i) · ClassOf(env, i) · PosCap(env, i) · MaxWeightFor(env, i)
--    OrderEngine.UseBots(botEngine)                    BotEngine meldet sich selbst an (keine Ring-Abhängigkeit)
--  Result = { Ok: boolean, Key: string?, Args: { any }?, Fill: Types.FillInfo?, OrderId: number?, Qty: number? }
--  Env-Ereignisse (env.Emit(kind, data)): Fill, Expired, Cancelled, Cut, Alert, Dividend, DayResult, Transfer, Bell,
--  BotPaused.
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Clock = require(Shared:WaitForChild("Clock"))
local PortfolioMath = require(Shared:WaitForChild("Market"):WaitForChild("PortfolioMath"))
local Portfolio = require(script.Parent:WaitForChild("Portfolio"))

local OrderEngine = {}

type Depot = { [string]: any }
type Order = { [string]: any }
export type Result = {
	Ok: boolean,
	Key: string?,
	Args: { any }?,
	Fill: Types.FillInfo?,
	OrderId: number?,
	Qty: number?,
}
export type Lic = {
	Index: number,
	Basis: number,
	BauKurs: number,
	FeeBps: number,
	MaxWeight: number,
	MaxOrders: number,
	PosFactor: number,
	Set: string,
	SetRank: number,
	BotSlots: number,
	Layer: string,
}
export type Env = {
	Mode: string, -- "Live" | "Replay"
	Licence: Lic,
	Perks: { [string]: any },
	PriceAt: (number, number) -> number?,
	Quote: ((number) -> (number?, number?, number?))?,
	Class: (number) -> string?,
	Set: (number) -> string?,
	DivBps: (number) -> number,
	Listed: (number) -> boolean,
	Halted: (number, number?) -> boolean, -- (Wert, Tick?) – mit Tick: Pause zu genau diesem Tick (offline == online)
	FactDir: (number, number) -> number?,
	AdminActive: (number) -> boolean,
	AdminBetween: (number, number) -> boolean,
	Dividends: (number, number) -> { { [string]: number } },
	Emit: (string, any) -> (),
	League: { [string]: any }?,
	Week: (number) -> number,
	OwnerTaint: boolean,
	CacheBefore: number, -- Minuten-Caches nur für Ticks davor (späte Bus-Events ändern nie Gecachtes)
	Watch: { number }?,
	ActiveIds: (() -> { number })?,
	BotsUntil: number?, -- Offline-Abgleich: Bots ruhen für Ticks in (BotsUntil, BotsFrom] (12-h-Grenze)
	BotsFrom: number?,
	NoAutoTransfer: boolean?, -- Offline-Abgleich: Höchstzahl verpasster Auto-Transfers erreicht
}

local DAY = Clock.DAY_TICKS
local SET_RANK = { Azubi = 1, Trader = 2, Fonds = 3 }
local HS_CACHE_MAX = 20000
local MAX_PRICE = 9999999 -- Kurs-Obergrenze (Cent) wie die Engine

local bots: any = nil -- BotEngine (meldet sich über UseBots an)

-- ---------------------------------------------------------------------
-- 0) KONFIG-HELFER
-- ---------------------------------------------------------------------
local function trading(): { [string]: any }
	local t = Config.Trading
	return if type(t) == "table" then t else {}
end

local function num(v: any, fallback: number): number
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return fallback
end

local function isInt(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge and v % 1 == 0
end

local function minFee(): number
	return num(trading().MinFeeCents, PortfolioMath.MIN_FEE)
end

local function protectCfg(): (number, number)
	local p = trading().Protect
	return num(type(p) == "table" and p.Sl, 0.08), num(type(p) == "table" and p.Tp, 0.15)
end

function OrderEngine.UseBots(botEngine: any)
	bots = botEngine
end

-- ---------------------------------------------------------------------
-- 1) INSTRUMENTE & GRENZEN
-- ---------------------------------------------------------------------
function OrderEngine.ClassOf(env: Env, i: number): string
	local class = env.Class(i)
	return if type(class) == "string" then class else "Normal"
end

function OrderEngine.InstAllowed(env: Env, i: number): boolean
	if not isInt(i) or not env.Listed(i) then
		return false
	end
	local rank = SET_RANK[env.Set(i) or ""]
	return rank ~= nil and rank <= env.Licence.SetRank
end

function OrderEngine.PosCap(env: Env, i: number): number
	local bases = trading().LiquidityBase
	local base = num(type(bases) == "table" and bases[OrderEngine.ClassOf(env, i)], 200000000)
	return math.floor(base * env.Licence.PosFactor)
end

-- ETFs sind von der Klumpen-Grenze ausgenommen (Diversifikation lernen, MARKET §11.6)
function OrderEngine.MaxWeightFor(env: Env, i: number): number?
	if OrderEngine.ClassOf(env, i) == "ETF" then
		return nil
	end
	return env.Licence.MaxWeight
end

-- ---------------------------------------------------------------------
-- 2) ENGINE-KURSE (deterministisch je Minute)
-- ---------------------------------------------------------------------
local hsCache: { [number]: { [number]: number } } = {}
local hsCount = 0

local function spreadBps(env: Env, i: number): number
	local classes = Config.Market and Config.Market.Classes
	local entry = type(classes) == "table" and classes[OrderEngine.ClassOf(env, i)] or nil
	return num(type(entry) == "table" and entry.SpreadBps, 8)
end

-- Junge Minuten (noch nicht "sicher", späte Bus-Events möglich) landen in einem kleinen Extra-Cache: der Live-Takt
-- fragt jede Sekunde für jeden Wert mit Orders – ohne Cache wäre das ein Random-Access-Kurs je Abfrage.
local hsRecent: { [number]: { [number]: number } } = {}
local hsRecentCount = 0
local HS_RECENT_MAX = 2000

function OrderEngine.HalfSpread(env: Env, i: number, t: number): number
	local minute = t // 60
	local perInst = hsCache[i]
	local cached = perInst and perInst[minute]
	if cached then
		return cached
	end
	local safe = minute * 60 + 59 < env.CacheBefore
	local recent = hsRecent[i]
	if not safe and env.Mode == "Live" then
		local value = recent and recent[minute]
		if value then
			return value
		end
	end
	local ref = env.PriceAt(i, minute * 60 - 1) or env.PriceAt(i, t)
	if type(ref) ~= "number" or ref <= 0 then
		return 1
	end
	local spread = math.max(1, math.floor(ref * spreadBps(env, i) / 10000 + 0.5))
	local hs = math.max(1, spread // 2)
	if safe then
		if hsCount >= HS_CACHE_MAX then
			table.clear(hsCache)
			hsCount = 0
		end
		perInst = hsCache[i]
		if not perInst then
			perInst = {}
			hsCache[i] = perInst
		end
		perInst[minute] = hs
		hsCount += 1
	elseif env.Mode == "Live" then
		if hsRecentCount >= HS_RECENT_MAX then
			table.clear(hsRecent)
			hsRecentCount = 0
		end
		recent = hsRecent[i]
		if not recent then
			recent = {}
			hsRecent[i] = recent
		end
		recent[minute] = hs
		hsRecentCount += 1
	end
	return hs
end

function OrderEngine.EngineQuote(env: Env, i: number, t: number): (number?, number?, number?)
	local mid = env.PriceAt(i, t)
	if type(mid) ~= "number" or mid <= 0 then
		return nil, nil, nil
	end
	mid = math.floor(mid)
	local hs = OrderEngine.HalfSpread(env, i, t)
	return math.max(1, mid - hs), mid + hs, mid
end

function OrderEngine.NavAt(d: Depot, env: Env, t: number): number
	return Portfolio.Nav(d, function(i: number): number?
		local bid = OrderEngine.EngineQuote(env, i, t)
		return bid
	end)
end

-- Gewinn-Transfer-Betrag (§B8.2). Ausnahme: der erste Transfer nach dem ACAD-Tutorial ignoriert die 2-%-Schwelle.
function OrderEngine.TransferAmount(d: Depot, _env: Env, nav: number): (number, string?)
	local cfg = trading().Transfer or {}
	local tut = d.Tutorial
	local tutorialException = type(tut) == "table" and tut.Done == true and num(d.LastTransferDay, -1) < 0
	local threshold = if tutorialException then 0 else num(cfg.Threshold, 1.02)
	local basis = num(d.Basis, 0)
	local amount = PortfolioMath.Withdrawable(nav, Portfolio.Free(d), basis, num(cfg.DayCapPct, 0.06), threshold)
	if amount > 0 then
		return amount, nil
	end
	if nav < math.ceil(basis * threshold - 1e-6) then
		return 0, "trade.transferBelow"
	end
	return 0, "trade.transferNone"
end

-- ---------------------------------------------------------------------
-- 3) HILFEN FÜR ORDER-LISTEN
-- ---------------------------------------------------------------------
local function findOrder(d: Depot, id: number): (Order?, number?)
	for index, o in ipairs(d.Orders) do
		if o.Id == id then
			return o, index
		end
	end
	return nil, nil
end

local function removeOrder(d: Depot, o: Order): boolean
	for index, other in ipairs(d.Orders) do
		if other == o then
			table.remove(d.Orders, index)
			return true
		end
	end
	return false
end

local function nextId(d: Depot): number
	local id = math.max(1, math.floor(num(d.NextId, 1)))
	d.NextId = id + 1
	return id
end

local function manualOrderCount(d: Depot): number
	local n = 0
	for _, o in ipairs(d.Orders) do
		if o.Bot == nil then
			n += 1
		end
	end
	return n
end

local function expiryFor(t: number, exp: string?): number
	if exp == "DAY" then
		return (t // DAY + 1) * DAY
	end
	local life = trading().OrderLife
	return t + math.floor(num(type(life) == "table" and life.H24, 86400))
end

function OrderEngine.ActiveInstruments(d: Depot): { number }
	local set: { [number]: boolean } = {}
	local list: { number } = {}
	for _, o in ipairs(d.Orders) do
		if not set[o.I] then
			set[o.I] = true
			table.insert(list, o.I)
		end
	end
	for _, a in ipairs(d.Alerts) do
		if not set[a.I] then
			set[a.I] = true
			table.insert(list, a.I)
		end
	end
	table.sort(list)
	return list
end

-- ---------------------------------------------------------------------
-- 4) FILLS BUCHEN + MELDEN (gemeinsam für Sofort-Orders, Trigger und Bots)
-- ---------------------------------------------------------------------
local function noteBotFill(d: Depot, botSlot: number?, i: number, side: string, qty: number, cash: number)
	if not botSlot then
		return
	end
	local slot = d.Bots[botSlot]
	if type(slot) ~= "table" then
		return
	end
	if type(slot.Q) ~= "table" then
		slot.Q = {}
	end
	local key = tostring(i)
	local have = math.floor(num(slot.Q[key], 0))
	if side == "B" then
		slot.Q[key] = have + qty
		slot.DayFlow = math.floor(num(slot.DayFlow, 0)) - cash
	else
		local left = math.max(0, have - qty)
		slot.Q[key] = if left > 0 then left else nil
		slot.DayFlow = math.floor(num(slot.DayFlow, 0)) + cash
	end
end

-- Liga-Woche des Ticks sicherstellen (Wochenwechsel = Montag 00:00 UTC)
local function leagueFor(env: Env, t: number): { [string]: any }?
	local league = env.League
	if type(league) == "table" then
		Portfolio.LeagueRoll(league, env.Week(t))
	end
	return league
end

local function emitFill(
	d: Depot,
	env: Env,
	t: number,
	i: number,
	side: string,
	info: any,
	navBefore: number,
	botSlot: number?,
	kind: string,
	order: Order?,
	gap: boolean
): Types.FillInfo
	local cfg = trading()
	local pctNav = if navBefore > 0 then info.Gross / navBefore else 0
	local isBot = botSlot ~= nil
	local fill: Types.FillInfo
	if side == "B" then
		fill = {
			I = i,
			Side = "B",
			Q = info.Q,
			Px = info.Px,
			Fee = info.Fee,
			Pnl = nil,
			HeldS = nil,
			PctNav = pctNav,
			Protected = info.Protected == true,
			ReadWell = false,
			Bot = isBot,
			Tick = t,
		}
		Portfolio.PushFill(d, t, i, "B", info.Q, info.Px, info.Fee, 0, isBot)
		noteBotFill(d, botSlot, i, "B", info.Q, info.Total)
	else
		local held = math.floor(num(info.HeldS, 0))
		local flags = math.floor(num(info.Flags, 0))
		local minHold = num(cfg.MinHoldSeconds, 60)
		local readWell = not isBot and bit32.band(flags, Portfolio.FLAG_READWELL) ~= 0 and held >= minHold
		fill = {
			I = i,
			Side = "S",
			Q = info.Q,
			Px = info.Px,
			Fee = info.Fee,
			Pnl = info.Pnl,
			HeldS = held,
			PctNav = pctNav,
			Protected = bit32.band(flags, Portfolio.FLAG_PROTECTED) ~= 0,
			ReadWell = readWell,
			Bot = isBot,
			Tick = t,
		}
		Portfolio.PushFill(d, t, i, "S", info.Q, info.Px, info.Fee, info.Pnl, isBot)
		Portfolio.NoteSell(d, info.Pnl, info.Basis)
		noteBotFill(d, botSlot, i, "S", info.Q, info.Net)
		if readWell and type(d.Stats) == "table" then
			d.Stats.ReadWell = math.floor(num(d.Stats.ReadWell, 0)) + 1
		end
		-- zählender Trade (Liga, Börsentag): ≥ 2 % Depotwert, ≥ 60 s gehalten, kein Bot, kein Admin-Fenster
		if not isBot and pctNav >= num(cfg.MinTradePct, 0.02) and held >= minHold and not env.AdminActive(t) then
			Portfolio.AddCountingTrade(d)
			local league = leagueFor(env, t)
			if league then
				Portfolio.LeagueAddTrade(league)
			end
		end
	end
	if kind == "Market" and not isBot then
		(fill :: any).Type = "MKT" -- Sofort-Order: Fill-Audit (WP3) prüft exakt gegen Geld/Brief des Ticks
	end
	env.Emit("Fill", {
		Fill = fill,
		Kind = kind,
		OrderId = if order then order.Id else nil,
		Gap = gap,
		BotSlot = botSlot,
	})
	return fill
end

-- ---------------------------------------------------------------------
-- 5) INTERNE ORDER-ANLAGE (Schutz-Paare nach Käufen, Bots)
-- ---------------------------------------------------------------------
local function hardCap(): number
	return math.floor(num(trading().MaxOrdersHard, 50))
end

-- Schutz-Paar (OCO) für frisch gekaufte Stück; gibt die Order oder nil (Grenze erreicht) zurück
local function attachProtection(
	d: Depot,
	t: number,
	i: number,
	qty: number,
	stp: number,
	tp: number,
	botSlot: number?
): Order?
	if #d.Orders >= hardCap() or qty <= 0 then
		return nil
	end
	if stp < 1 or tp <= stp then
		return nil
	end
	local o: Order = {
		Id = nextId(d),
		I = i,
		Side = "S",
		Type = "OCO",
		Q = qty,
		Stp = stp,
		Tp = math.min(tp, MAX_PRICE),
		Res = 0,
		Exp = expiryFor(t, "24H"),
		T0 = t,
		Bot = botSlot,
	}
	table.insert(d.Orders, o)
	return o
end

-- Einfacher Verlust-Stopp (Dip-Käufer-Bot) für frisch gekaufte Stück
local function attachStop(d: Depot, t: number, i: number, qty: number, stp: number, botSlot: number?): Order?
	if #d.Orders >= hardCap() or qty <= 0 or stp < 1 then
		return nil
	end
	local o: Order = {
		Id = nextId(d),
		I = i,
		Side = "S",
		Type = "STP",
		Q = qty,
		Stp = stp,
		Res = 0,
		Exp = expiryFor(t, "24H"),
		T0 = t,
		Bot = botSlot,
	}
	table.insert(d.Orders, o)
	return o
end
OrderEngine.AttachStop = attachStop

local function protectLevels(px: number): (number, number)
	local sl, tp = protectCfg()
	return math.max(1, math.floor(px * (1 - sl))), math.ceil(px * (1 + tp))
end

-- ---------------------------------------------------------------------
-- 6) SOFORT-AUSFÜHRUNG (Spieler-"Sofort" zum gesendeten Quote, Bots zum Engine-Kurs)
-- ---------------------------------------------------------------------
local function buyNow(
	d: Depot,
	env: Env,
	t: number,
	i: number,
	qty: number,
	ask: number,
	bid: number,
	protect: boolean,
	botSlot: number?,
	kind: string
): Result
	local nav = OrderEngine.NavAt(d, env, t)
	local flags = 0
	if protect then
		flags = bit32.bor(flags, Portfolio.FLAG_PROTECTED)
	end
	local cfg = trading()
	if botSlot == nil and qty * ask >= num(cfg.MinTradePct, 0.02) * nav then
		local dir = env.FactDir(i, t)
		if type(dir) == "number" and dir > 0 then
			flags = bit32.bor(flags, Portfolio.FLAG_READWELL)
		end
	end
	local ok, info = Portfolio.Buy(d, i, qty, ask, env.Licence.FeeBps, nil, {
		Tick = t,
		Flags = flags,
		Nav = nav,
		MaxWeight = OrderEngine.MaxWeightFor(env, i),
		PosCap = OrderEngine.PosCap(env, i),
		Bid = bid,
	})
	if not ok then
		local args = if info == "trade.concentration" then { math.floor(env.Licence.MaxWeight * 100 + 0.5) } else nil
		return { Ok = false, Key = info, Args = args }
	end
	info.Protected = protect
	local fill = emitFill(d, env, t, i, "B", info, nav, botSlot, kind, nil, false)
	if protect then
		local stp, tp = protectLevels(info.Px)
		attachProtection(d, t, i, info.Q, stp, tp, botSlot)
	end
	return { Ok = true, Fill = fill, Qty = info.Q }
end

local function sellNow(
	d: Depot,
	env: Env,
	t: number,
	i: number,
	qty: number,
	bid: number,
	botSlot: number?,
	kind: string
): Result
	local nav = OrderEngine.NavAt(d, env, t)
	local ok, info = Portfolio.Sell(d, i, qty, bid, env.Licence.FeeBps, nil, { Tick = t })
	if not ok then
		return { Ok = false, Key = info }
	end
	local fill = emitFill(d, env, t, i, "S", info, nav, botSlot, kind, nil, false)
	return { Ok = true, Fill = fill, Qty = info.Q }
end

OrderEngine.BuyNow = buyNow
OrderEngine.SellNow = sellNow
OrderEngine.AttachProtection = attachProtection
OrderEngine.ProtectLevels = protectLevels

-- ---------------------------------------------------------------------
-- 7) PLATZIEREN (§C9 TradePlace; Struktur/Typen prüft OrderService, hier die Markt-Regeln)
-- ---------------------------------------------------------------------
local function fail(key: string, args: { any }?): Result
	return { Ok = false, Key = key, Args = args }
end

local function inBand(px: number, mid: number): boolean
	local band = num(trading().FatFinger, 0.5)
	return px >= mid * (1 - band) and px <= mid * (1 + band)
end

function OrderEngine.Place(d: Depot, env: Env, t: number, req: { [string]: any }): Result
	local i = req.I
	if not isInt(i) or not env.Listed(i) then
		return fail("trade.unknownInst")
	end
	if not OrderEngine.InstAllowed(env, i) then
		return fail("trade.notLicensed")
	end
	local side: string = req.Side
	local isBuy = side == "B"
	local otype: string = req.Type
	local lic = env.Licence
	local cfg = trading()
	local traderFrom = math.floor(num(cfg.TraderFrom, 4))
	-- Ordertyp nach Lizenz und Seite (§B7.3)
	if otype == "TRL" or (otype == "STP" and isBuy) then
		if lic.Index < traderFrom then
			return fail("trade.typeLocked")
		end
	end
	if (otype == "TP" or otype == "OCO" or otype == "TRL") and isBuy then
		return fail("trade.invalid")
	end

	-- Kurs: Spieler-"Sofort" zum gesendeten Quote, sonst Engine-Kurs
	local bid, ask, mid
	if req.Live == true and env.Quote then
		bid, ask, mid = env.Quote(i)
	end
	if type(mid) ~= "number" or type(bid) ~= "number" or type(ask) ~= "number" then
		bid, ask, mid = OrderEngine.EngineQuote(env, i, t)
	end
	if type(mid) ~= "number" or type(bid) ~= "number" or type(ask) ~= "number" or mid <= 0 then
		return fail("trade.marketClosed")
	end
	bid, ask, mid = math.floor(bid :: number), math.floor(ask :: number), math.floor(mid :: number)

	-- Preise: gerundet, im Fehleingabe-Band, sinnvolle Seite
	local lim = if req.Lim ~= nil then math.floor(req.Lim + 0.5) else nil
	local stp = if req.Stp ~= nil then math.floor(req.Stp + 0.5) else nil
	local tp = if req.Tp ~= nil then math.floor(req.Tp + 0.5) else nil
	for _, px in ipairs({ lim or mid, stp or mid, tp or mid }) do
		if px < 1 or not inBand(px, mid) then
			return fail("trade.fatFinger")
		end
	end
	if otype == "LMT" and lim == nil then
		return fail("trade.invalid")
	elseif otype == "STP" and stp == nil then
		return fail("trade.invalid")
	elseif otype == "TP" and tp == nil then
		return fail("trade.invalid")
	elseif otype == "OCO" and (stp == nil or tp == nil) then
		return fail("trade.invalid")
	end
	if otype == "STP" and not isBuy and (stp :: number) >= bid then
		return fail("trade.stopAbove")
	elseif otype == "STP" and isBuy and (stp :: number) <= ask then
		return fail("trade.buyStopBelow")
	elseif otype == "TP" and (tp :: number) <= bid then
		return fail("trade.targetBelow")
	elseif otype == "OCO" and ((stp :: number) >= bid or (tp :: number) <= bid) then
		return fail(if (stp :: number) >= bid then "trade.stopAbove" else "trade.targetBelow")
	end
	local trl: number? = nil
	if otype == "TRL" then
		local bounds = cfg.TrailBps or {}
		trl = req.Trl
		if not isInt(trl) or (trl :: number) < num(bounds.Min, 50) or (trl :: number) > num(bounds.Max, 2000) then
			return fail("trade.invalid")
		end
	end

	-- Menge (Stück oder Chip 10 % · 25 % · Max)
	local nav = OrderEngine.NavAt(d, env, t)
	local bps = lic.FeeBps
	local qty: number
	if isBuy then
		local refPx = if otype == "LMT"
			then lim :: number
			elseif otype == "STP" then math.ceil((stp :: number) * num(cfg.BuyStopReserve, 1.05))
			else ask
		local posValue = Portfolio.PosValue(d, i, bid)
		local capLeft = OrderEngine.PosCap(env, i) - Portfolio.PosQty(d, i) * refPx
		local maxQty = PortfolioMath.MaxQty(refPx, capLeft)
		if req.Pct ~= nil then
			local free = Portfolio.Free(d)
			local notional: number
			if req.Pct == "Max" then
				notional = free
				local maxWeight = OrderEngine.MaxWeightFor(env, i)
				if maxWeight then
					notional = math.min(notional, math.floor(maxWeight * nav) - posValue)
					if notional <= 0 then
						return fail("trade.concentration", { math.floor(maxWeight * 100 + 0.5) })
					end
				end
			else
				notional = math.floor((req.Pct :: number) * nav)
			end
			qty = math.min(PortfolioMath.AffordableQty(math.min(notional, free), refPx, bps, minFee()), maxQty)
		else
			qty = req.Qty
			if qty > maxQty then
				return fail("trade.posLimit")
			end
		end
	else
		local available = Portfolio.PosQty(d, i) - Portfolio.ReservedQty(d, i)
		if req.Pct ~= nil then
			if req.Pct == "Max" then
				qty = available
			else
				qty = math.min(available, math.ceil((req.Pct :: number) * nav / bid))
			end
		else
			qty = req.Qty
			if qty > available then
				return fail("trade.noShares")
			end
		end
	end
	if not isInt(qty) or qty < 1 then
		return fail(if isBuy then "trade.qtyZero" else "trade.noShares")
	end

	local botSlot = req.Bot
	-- SOFORT
	if otype == "MKT" then
		if env.Halted(i) then
			return fail("trade.halted")
		end
		if isBuy then
			if req.MaxPx ~= nil and ask > req.MaxPx then
				return fail("trade.priceMoved")
			end
			return buyNow(d, env, t, i, qty, ask, bid, req.Protect == true, botSlot, "Market")
		end
		if req.MinPx ~= nil and bid < req.MinPx then
			return fail("trade.priceMoved")
		end
		return sellNow(d, env, t, i, qty, bid, botSlot, "Market")
	end

	-- WARTENDE ORDER
	if #d.Orders >= hardCap() then
		return fail("trade.maxOrders", { hardCap() })
	end
	if botSlot == nil and manualOrderCount(d) >= math.min(lic.MaxOrders, hardCap()) then
		return fail("trade.maxOrders", { math.min(lic.MaxOrders, hardCap()) })
	end
	local o: Order = {
		Id = 0,
		I = i,
		Side = side,
		Type = otype,
		Q = qty,
		Res = 0,
		Exp = expiryFor(t, req.Exp),
		T0 = t,
		Bot = botSlot,
	}
	if isBuy then
		local refPx = if otype == "LMT"
			then lim :: number
			else math.ceil((stp :: number) * num(cfg.BuyStopReserve, 1.05))
		local res = PortfolioMath.BuyCost(qty, refPx, bps, minFee())
		if Portfolio.Free(d) < res then
			return fail("trade.noCash")
		end
		local maxWeight = OrderEngine.MaxWeightFor(env, i)
		if maxWeight and PortfolioMath.Weight(Portfolio.PosValue(d, i, bid), qty * refPx, nav) > maxWeight + 1e-9 then
			return fail("trade.concentration", { math.floor(maxWeight * 100 + 0.5) })
		end
		if (Portfolio.PosQty(d, i) + qty) * refPx > OrderEngine.PosCap(env, i) then
			return fail("trade.posLimit")
		end
		o.Res = res
		if otype == "LMT" then
			o.Lim = lim
			if req.Protect == true then
				-- Klammer: nach dem Kauf entsteht ein Schutz-Paar mit genau diesen Marken (relativ zum Wunschpreis)
				o.Stp, o.Tp = protectLevels(lim :: number)
			end
		else
			o.Stp = stp
		end
	else
		if otype == "LMT" then
			o.Lim = lim
		elseif otype == "STP" then
			o.Stp = stp
		elseif otype == "TP" then
			o.Tp = tp
		elseif otype == "OCO" then
			o.Stp, o.Tp = stp, tp
		elseif otype == "TRL" then
			o.Trl = trl
			o.Peak = bid
		end
	end
	o.Id = nextId(d)
	table.insert(d.Orders, o)
	return { Ok = true, OrderId = o.Id, Qty = qty }
end

-- ---------------------------------------------------------------------
-- 8) STORNO & ÄNDERN
-- ---------------------------------------------------------------------
function OrderEngine.Cancel(d: Depot, id: number): boolean
	local o = findOrder(d, id)
	if not o then
		return false
	end
	return removeOrder(d, o)
end

-- Alle offenen Orders eines Bots (optional nur eines Werts) streichen; gibt die Anzahl zurück
function OrderEngine.CancelBotOrders(d: Depot, botSlot: number, inst: number?): number
	local removed = 0
	for index = #d.Orders, 1, -1 do
		local o = d.Orders[index]
		if o.Bot == botSlot and (inst == nil or o.I == inst) then
			table.remove(d.Orders, index)
			removed += 1
		end
	end
	return removed
end

function OrderEngine.Modify(d: Depot, env: Env, t: number, id: number, changes: { [string]: any }): Result
	local o = findOrder(d, id)
	if not o then
		return fail("trade.orderNotFound")
	end
	if o.Bot ~= nil then
		return fail("trade.botOrder")
	end
	local bid, ask, mid = OrderEngine.EngineQuote(env, o.I, t)
	if type(mid) ~= "number" or type(bid) ~= "number" or type(ask) ~= "number" then
		return fail("trade.marketClosed")
	end
	local allowed = {
		LMT = { Lim = true },
		STP = { Stp = true },
		TP = { Tp = true },
		OCO = { Stp = true, Tp = true },
		TRL = { Trl = true },
	}
	local fields = allowed[o.Type] or {}
	local new: { [string]: number } = {}
	local any = false
	for key, value in pairs(changes) do
		if not fields[key] then
			return fail("trade.invalid")
		end
		if key == "Trl" then
			local bounds = trading().TrailBps or {}
			if not isInt(value) or value < num(bounds.Min, 50) or value > num(bounds.Max, 2000) then
				return fail("trade.invalid")
			end
			new.Trl = value
		else
			local px = math.floor(value + 0.5)
			if px < 1 or not inBand(px, mid) then
				return fail("trade.fatFinger")
			end
			new[key] = px
		end
		any = true
	end
	if not any then
		return fail("trade.invalid")
	end
	local stp = new.Stp or o.Stp
	local tp = new.Tp or o.Tp
	if o.Side == "S" then
		if (o.Type == "STP" or o.Type == "OCO") and stp >= bid then
			return fail("trade.stopAbove")
		end
		if (o.Type == "TP" or o.Type == "OCO") and tp <= bid then
			return fail("trade.targetBelow")
		end
	elseif o.Type == "STP" and stp <= ask then
		return fail("trade.buyStopBelow")
	end
	if o.Side == "B" then
		local cfg = trading()
		local refPx = if o.Type == "LMT"
			then new.Lim or o.Lim
			else math.ceil((new.Stp or o.Stp) * num(cfg.BuyStopReserve, 1.05))
		local res = PortfolioMath.BuyCost(o.Q, refPx, env.Licence.FeeBps, minFee())
		-- freies Geld zählt die alte Reservierung dieser Order schon mit
		if math.floor(num(d.Cash, 0)) - Portfolio.Reserved(d, o) < res then
			return fail("trade.noCash")
		end
		o.Res = res
		if o.Type == "LMT" then
			o.Lim = new.Lim or o.Lim
			if o.Stp and o.Tp then
				o.Stp, o.Tp = protectLevels(o.Lim)
			end
		else
			o.Stp = new.Stp or o.Stp
		end
	else
		for key, value in pairs(new) do
			o[key] = value
		end
		if o.Type == "TRL" then
			o.Peak = math.max(o.Peak or bid, bid)
		end
	end
	o.T0 = t -- geänderte Orders gelten ab dem nächsten Tick (kein Blick zurück)
	return { Ok = true, OrderId = o.Id }
end

-- ---------------------------------------------------------------------
-- 9) TRIGGER JE 1s-KERZE (MARKET §11.3) inkl. Pfad-Regel und Nachzieh-Stopp ohne Zukunftsblick
-- ---------------------------------------------------------------------
local function trailStop(o: Order): number
	return math.floor(num(o.Peak, 0) * (1 - num(o.Trl, 0) / 10000))
end

-- Gibt (ausgelöst, Preis, Art, Lücke) für eine Order in der Kerze (o, h, l, c) zurück
local function evaluate(
	ord: Order,
	op: number,
	h: number,
	l: number,
	c: number,
	hs: number
): (boolean, number, string, boolean)
	local t = ord.Type
	if ord.Side == "B" then
		if t == "LMT" then
			if l + hs <= ord.Lim then
				return true, math.min(ord.Lim, op + hs), "Limit", false
			end
		elseif t == "STP" then
			if h + hs >= ord.Stp then
				local px = math.max(ord.Stp, op + hs)
				return true, px, "BuyStop", px > ord.Stp
			end
		end
		return false, 0, "", false
	end
	if t == "LMT" then
		if h - hs >= ord.Lim then
			return true, math.max(ord.Lim, op - hs), "Limit", false
		end
	elseif t == "TP" then
		if h - hs >= ord.Tp then
			return true, math.max(ord.Tp, op - hs), "Target", false
		end
	elseif t == "STP" then
		if l - hs <= ord.Stp then
			local px = math.min(ord.Stp, op - hs)
			return true, px, "Stop", px < ord.Stp
		end
	elseif t == "TRL" then
		local stop = trailStop(ord)
		if stop > 0 and l - hs <= stop then
			local px = math.min(stop, op - hs)
			return true, px, "Trail", px < stop
		end
	elseif t == "OCO" then
		local slHit = l - hs <= ord.Stp
		local tpHit = h - hs >= ord.Tp
		local stopFirst: boolean
		if op - hs <= ord.Stp then
			stopFirst = true -- Lücke unter den Stopp schon zur Eröffnung
		elseif op - hs >= ord.Tp then
			stopFirst = false -- Lücke über das Ziel zur Eröffnung
		elseif slHit and tpHit then
			stopFirst = c >= op -- steigend O→L→H→C (Tief zuerst), fallend O→H→L→C (Hoch zuerst)
		else
			stopFirst = slHit
		end
		if slHit and stopFirst then
			local px = math.min(ord.Stp, op - hs)
			return true, px, "OcoStop", px < ord.Stp
		elseif tpHit then
			return true, math.max(ord.Tp, op - hs), "OcoTarget", false
		end
	end
	return false, 0, "", false
end

local function executeOrder(d: Depot, env: Env, t: number, ord: Order, px: number, kind: string, gap: boolean)
	local i = ord.I
	local bps = env.Licence.FeeBps
	px = math.clamp(math.floor(px), 1, MAX_PRICE)
	if ord.Side == "B" then
		local nav = OrderEngine.NavAt(d, env, t)
		local bid = OrderEngine.EngineQuote(env, i, t)
		local qty = ord.Q
		local flags = if ord.Stp and ord.Tp and ord.Type == "LMT" then Portfolio.FLAG_PROTECTED else 0
		-- "Gut gelesen"-Kandidat auch für Wunschpreis-/Kauf-Stopp-Käufe des Spielers (nie für Bots)
		if ord.Bot == nil and qty * px >= num(trading().MinTradePct, 0.02) * nav then
			local dir = env.FactDir(i, t)
			if type(dir) == "number" and dir > 0 then
				flags = bit32.bor(flags, Portfolio.FLAG_READWELL)
			end
		end
		local opts = {
			Tick = t,
			Flags = flags,
			Nav = nav,
			MaxWeight = OrderEngine.MaxWeightFor(env, i),
			PosCap = OrderEngine.PosCap(env, i),
			Bid = bid,
		}
		local ok, info = Portfolio.Buy(d, i, qty, px, bps, ord, opts)
		if not ok and info == "trade.noCash" then
			-- Kurslücke beim Kauf-Stopp: auf das Bezahlbare kürzen und melden (MARKET §12.3)
			local free = math.floor(num(d.Cash, 0)) - Portfolio.Reserved(d, ord)
			local cut = PortfolioMath.AffordableQty(free, px, bps, minFee())
			if cut >= 1 then
				ok, info = Portfolio.Buy(d, i, cut, px, bps, ord, opts)
				if ok then
					env.Emit("Cut", { OrderId = ord.Id, I = i, Q = cut, Bot = ord.Bot })
				end
			end
		end
		removeOrder(d, ord)
		if not ok then
			env.Emit("Cancelled", { OrderId = ord.Id, I = i, Reason = info, Bot = ord.Bot })
			return
		end
		info.Protected = bit32.band(flags, Portfolio.FLAG_PROTECTED) ~= 0
		emitFill(d, env, t, i, "B", info, nav, ord.Bot, kind, ord, gap)
		if ord.Type == "LMT" and ord.Stp and ord.Tp then
			attachProtection(d, t, i, info.Q, ord.Stp, ord.Tp, ord.Bot)
		end
		return
	end
	local nav = OrderEngine.NavAt(d, env, t)
	local ok, info = Portfolio.Sell(d, i, ord.Q, px, bps, ord, { Tick = t })
	removeOrder(d, ord)
	if not ok then
		env.Emit("Cancelled", { OrderId = ord.Id, I = i, Reason = info, Bot = ord.Bot })
		return
	end
	emitFill(d, env, t, i, "S", info, nav, ord.Bot, kind, ord, gap)
end

-- Alle Orders eines Werts gegen die Kerze von Tick t (nur Orders mit T0 < t)
function OrderEngine.CheckInstrument(
	d: Depot,
	env: Env,
	i: number,
	t: number,
	o: number,
	h: number,
	l: number,
	c: number
)
	if #d.Orders == 0 then
		return
	end
	local hs = OrderEngine.HalfSpread(env, i, t)
	-- Schnappschuss (Ausführungen ändern die Liste)
	local list: { Order } = {}
	for _, ord in ipairs(d.Orders) do
		if ord.I == i and ord.T0 < t then
			table.insert(list, ord)
		end
	end
	for _, ord in ipairs(list) do
		if not findOrder(d, ord.Id) then
			continue -- inzwischen ausgeführt/storniert
		end
		local hit, px, kind, gap = evaluate(ord, o, h, l, c, hs)
		if hit then
			executeOrder(d, env, t, ord, px, kind, gap)
		elseif ord.Type == "TRL" then
			-- Nachführung NACH der Prüfung mit dem Hoch dieser Kerze (kein Blick in die Zukunft)
			ord.Peak = math.max(num(ord.Peak, 0), h - hs)
		end
	end
end

-- Kann in einer Minute (Hoch hMax, Tief lMin, ein hs je Minute) irgendeine Order/ein Alarm des Werts auslösen?
-- Exakte Bedingung: Trigger sind monoton in H bzw. L -> nein heißt sicher kein Trigger (Minute überspringbar).
function OrderEngine.CanTrigger(d: Depot, i: number, hMax: number, lMin: number, hs: number): boolean
	for _, ord in ipairs(d.Orders) do
		if ord.I == i then
			local t = ord.Type
			if ord.Side == "B" then
				if t == "LMT" and lMin + hs <= ord.Lim then
					return true
				elseif t == "STP" and hMax + hs >= ord.Stp then
					return true
				end
			elseif (t == "LMT" and hMax - hs >= ord.Lim) or (t == "TP" and hMax - hs >= ord.Tp) then
				return true
			elseif t == "STP" and lMin - hs <= ord.Stp then
				return true
			elseif t == "OCO" and (lMin - hs <= ord.Stp or hMax - hs >= ord.Tp) then
				return true
			elseif t == "TRL" then
				-- der Stopp kann innerhalb der Minute höchstens bis zum Minuten-Hoch nachziehen
				local peak = math.max(num(ord.Peak, 0), hMax - hs)
				local stop = math.floor(peak * (1 - num(ord.Trl, 0) / 10000))
				if lMin - hs <= stop then
					return true
				end
			end
		end
	end
	for _, a in ipairs(d.Alerts) do
		if a.I == i and ((a.Dir == "Up" and hMax >= a.Px) or (a.Dir == "Down" and lMin <= a.Px)) then
			return true
		end
	end
	return false
end

-- Nachzieh-Stopps einer übersprungenen Minute nachführen (identisch zu 60 Einzel-Kerzen ohne Auslösung)
function OrderEngine.SkipMinute(d: Depot, i: number, hMax: number, hs: number)
	for _, ord in ipairs(d.Orders) do
		if ord.I == i and ord.Type == "TRL" then
			ord.Peak = math.max(num(ord.Peak, 0), hMax - hs)
		end
	end
end

-- ---------------------------------------------------------------------
-- 10) ALARME, ABLAUF, DIVIDENDEN
-- ---------------------------------------------------------------------
function OrderEngine.CheckAlerts(d: Depot, env: Env, i: number, t: number, h: number, l: number)
	for index = #d.Alerts, 1, -1 do
		local a = d.Alerts[index]
		if a.I == i and ((a.Dir == "Up" and h >= a.Px) or (a.Dir == "Down" and l <= a.Px)) then
			table.remove(d.Alerts, index)
			env.Emit("Alert", { Id = a.Id, I = i, Px = a.Px, Dir = a.Dir, Tick = t })
		end
	end
end

function OrderEngine.Expire(d: Depot, env: Env, t: number)
	for index = #d.Orders, 1, -1 do
		local o = d.Orders[index]
		if o.Exp <= t then
			table.remove(d.Orders, index)
			env.Emit("Expired", { OrderId = o.Id, I = o.I, Bot = o.Bot })
		end
	end
end

-- Dividenden: Anspruch = Bestand im Ex-Tick (nach den Triggern dieses Ticks); Betrag je Aktie in Cent
function OrderEngine.PayDividends(d: Depot, env: Env, t: number, list: { { [string]: number } }?)
	if type(list) ~= "table" then
		return
	end
	for _, div in ipairs(list) do
		if type(div) == "table" and div.Tick == t and isInt(div.I) and isInt(div.Cents) and div.Cents > 0 then
			local qty = Portfolio.PosQty(d, div.I)
			if qty > 0 then
				local amount = qty * div.Cents
				if Portfolio.Credit(d, amount, "Dividend") then
					Portfolio.MarkActive(d)
					env.Emit("Dividend", { I = div.I, Cents = amount, Tick = t })
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- 11) BÖRSENTAG-SCHLUSS (Glocke bei t % 1200 == 0): Bot-Lohn, Tagesrendite, Liga, neuer Tag, Auto-Transfer
-- ---------------------------------------------------------------------
local function hasExposure(d: Depot): boolean
	if next(d.Pos) ~= nil then
		return true
	end
	local tut = d.Tutorial
	return type(tut) == "table" and num(tut.Q, 0) > 0
end

function OrderEngine.CloseDay(d: Depot, env: Env, t: number)
	local cfg = trading()
	local closedDay = t // DAY - 1
	local dayStart, dayEnd = closedDay * DAY, t - 1
	-- 1) Bot-Lohn gehört zum abgelaufenen Tag
	if bots and type(bots.PayWages) == "function" then
		bots.PayWages(d, env, dayEnd)
	end
	-- 2) Tagesrendite (Modified Dietz) des abgelaufenen Tags
	local navEnd = OrderEngine.NavAt(d, env, dayEnd)
	local rec = Portfolio.CurrentDay(d)
	local result: Types.DayResult = { Day = closedDay, Return = 0, Trades = 0, Qualifying = false, Tainted = false }
	local complete = false
	if rec then
		rec[3] = navEnd
		complete = rec[1] == closedDay
		local tainted = env.AdminBetween(dayStart, dayEnd) or env.OwnerTaint
		local counted = complete and rec[6] == 1 and rec[2] >= num(cfg.MinNavStart, 100000)
		local r = if counted then PortfolioMath.DayReturn(rec[2], navEnd, rec[4]) else 0
		local qualifying = counted and rec[5] >= num(cfg.QualifyingTrades, 3)
		result = {
			Day = closedDay,
			Return = math.floor(r * 1e6 + 0.5) / 1e6,
			Trades = rec[5],
			Qualifying = qualifying and not tainted,
			Tainted = tainted,
		}
		local league = leagueFor(env, dayEnd)
		if league and counted and not tainted then
			Portfolio.LeagueAddDay(league, r, qualifying)
		end
		local stats = d.Stats
		if type(stats) == "table" then
			local peak = math.max(math.floor(num(stats.PeakNav, 0)), navEnd)
			stats.PeakNav = peak
			if peak > 0 then
				stats.MaxDD = math.max(num(stats.MaxDD, 0), math.floor((peak - navEnd) / peak * 10000 + 0.5) / 10000)
			end
		end
	end
	-- 3) neuer Börsentag startet mit dem Schluss-Depotwert
	Portfolio.OpenDay(d, closedDay + 1, navEnd, hasExposure(d))
	-- 4) Auto-Transfer an der Glocke für den gerade beendeten Tag (nur ohne Transfer in diesem Tag).
	--    Der Betrag verlässt das Depot sofort (Fluss F des neuen Tags) und wartet in d.Pending, bis der Turm ihn
	--    über OrderService.Withdraw abholt – der Markt-Code bucht nie Turm-Geld.
	if
		d.AutoTransfer ~= false
		and env.NoAutoTransfer ~= true
		and math.floor(num(d.LastTransferDay, -1)) < closedDay
	then
		local amount = OrderEngine.TransferAmount(d, env, navEnd)
		if amount > 0 and Portfolio.Debit(d, amount, "Transfer") then
			d.Pending = math.floor(num(d.Pending, 0)) + amount
			d.LastTransferDay = closedDay
			env.Emit("Transfer", { Cents = amount, Day = closedDay })
			-- Tagesbilanz zeigt "Auto-Transfer: … in den Tower" (DayClose.Transfer, AKY-Cent)
			local withTransfer: any = result
			withTransfer.Transfer = amount
		end
	end
	if complete then
		env.Emit("DayResult", result)
	end
	env.Emit("Bell", { Day = closedDay + 1 })
end

-- ---------------------------------------------------------------------
-- 12) EIN TICK (gemeinsam online/offline)
-- ---------------------------------------------------------------------
function OrderEngine.Step(d: Depot, env: Env, t: number, ctx: { [string]: any })
	if t % DAY == 0 then
		OrderEngine.CloseDay(d, env, t)
	end
	if #d.Orders > 0 then
		OrderEngine.Expire(d, env, t)
	end
	if #d.Orders > 0 or #d.Alerts > 0 then
		local candleOf = ctx.Candle
		for _, i in ipairs(OrderEngine.ActiveInstruments(d)) do
			local o, h, l, c = candleOf(i)
			if type(o) == "number" and type(h) == "number" and type(l) == "number" and type(c) == "number" then
				if #d.Orders > 0 and not env.Halted(i, t) then
					OrderEngine.CheckInstrument(d, env, i, t, o, h, l, c)
				end
				if #d.Alerts > 0 then
					OrderEngine.CheckAlerts(d, env, i, t, h, l)
				end
			end
		end
	end
	if ctx.Divs ~= nil and next(d.Pos) ~= nil then
		OrderEngine.PayDividends(d, env, t, ctx.Divs)
	end
	if t % 60 == 0 and bots and type(bots.Decide) == "function" and type(d.Bots) == "table" and #d.Bots > 0 then
		if ctx.NoBots ~= true then
			bots.Decide(d, env, t)
		end
	end
	d.LastTick = t
end

return OrderEngine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">Portfolio</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Depot-Buchhaltung: der EINZIGE Schreibtrichter für Cash und Basis (Server/Market/Portfolio)
--  Besitzer: WP4 (Orders, Depot, Bots). Vertrag: DESIGN.md §C11.4 #3 (Depot-Schreibtrichter), §B8.1, §C12.1,
--  MARKET.md §12.1–§12.6. Reines Daten-Modul (keine Remotes, keine Services, kein Yield) – wird von OrderService,
--  OrderEngine, BotEngine und CatchUp benutzt.
--
--  Firewall: Depot.Cash und Depot.Basis ändern sich NUR über Portfolio.Credit/Debit mit einem Grund aus der
--  Whitelist (Start, Licence, Refill, Trade, Fee, Dividend, BotWage, Transfer, Admin, Tutorial, Migration).
--  Es gibt keine Funktion, die Turm-Geld in das Depot bringt.
--
--  Öffentliche API:
--    Portfolio.Credit(d, cents, reason): boolean       Gutschrift (Licence/Admin/Start erhöhen auch die Basis)
--    Portfolio.Debit(d, cents, reason): boolean        Abbuchung, nie unter 0 (Licence-Herabstufung: Cash höchstens bis 0)
--    Portfolio.Reserved(d, except?): number            Summe Res offener Kauf-Orders (ohne except)
--    Portfolio.ReservedQty(d, inst, except?): number   reservierte Stück offener Verkaufs-Orders eines Werts
--    Portfolio.Free(d): number                         Cash − Reserved
--    Portfolio.Buy(d, inst, qty, ask, bps, fromOrder?, opts?): (boolean, info | reasonKey)
--    Portfolio.Sell(d, inst, qty, bid, bps, fromOrder?, opts?): (boolean, info | reasonKey)
--    Portfolio.Nav(d, bidOf): number                   Cash + Σ Q · bidOf(inst) (fehlt ein Kurs: Einstand)
--    Portfolio.PosQty(d, inst) · PosValue(d, inst, bid)
--    Portfolio.OpenDay(d, day, nav, active) · CurrentDay(d) · MarkActive(d) · AddCountingTrade(d)
--    Portfolio.PushFill(d, tick, inst, side, qty, px, fee, pnl, bot)
--    Portfolio.NoteSell(d, pnl, basis)                 Depot-Statistik (Trades, Wins, Losses, BestPct …)
--    Portfolio.Sanitize(d, nowTick, isValidInst): { string }   Spielstand reparieren (nach DataService-Reconcile)
--    Portfolio.LeagueRoll(league, week) · LeagueAddDay(league, r, qualifying) · LeagueAddTrade(league)
--    Portfolio.LeagueStats(league, extraTaint): Types.LeagueStats · Portfolio.TierOf(score, qualified): string
--    Portfolio.SetObserver(fn(d, signedCents, reason))  Metriken (OrderService) – wird nie im Trichter selbst ausgewertet
--    Portfolio.REASONS · Portfolio.FLOW_REASONS
--  Positionen tragen zusätzlich T (Eröffnungs-Tick) und F (Bits: 1 = mit Schutz eröffnet, 2 = "Gut gelesen"-Kandidat).
--  Nav-Ring je Börsentag: { day, navStart, navEnd, flow, zählendeTrades, aktiv(0/1) }; Fills: { tick, inst, side
--  (1 = Kauf, 2 = Verkauf), qty, px, fee, pnl, bot(0/1) }.
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local PortfolioMath = require(Shared:WaitForChild("Market"):WaitForChild("PortfolioMath"))

local Portfolio = {}

type Depot = { [string]: any }

local MAX_MONEY = 9e15
local FILLS_MAX = 100
local NAV_MAX = 72
local SEQ_MAX = 64
local ORDERS_MAX = 50
local ALERTS_MAX = 18
local BOTS_MAX = 5
local WATCH_LISTS_MAX = 5
local WATCH_IDS_MAX = 12
local INST_MAX = 255

Portfolio.FLAG_PROTECTED = 1
Portfolio.FLAG_READWELL = 2

Portfolio.REASONS = {
	Start = true,
	Licence = true,
	Refill = true,
	Trade = true,
	Fee = true,
	Dividend = true,
	BotWage = true,
	Transfer = true,
	Admin = true,
	Tutorial = true,
	Migration = true,
}
-- Gründe, die auch die Basis (Hochwassermarke) bewegen: Lizenz-Aufstieg, Admin-Gabe (nie abhebbar), Neustart
local BASIS_REASONS = { Start = true, Licence = true, Admin = true }
-- Gründe, die in der Börsentag-Rendite als Fluss F zählen (keine Handelsleistung)
Portfolio.FLOW_REASONS = {
	Start = true,
	Licence = true,
	Refill = true,
	Transfer = true,
	Admin = true,
	Tutorial = true,
	Migration = true,
}

local observer: ((Depot, number, string) -> ())? = nil

local function trading(): { [string]: any }
	local t = Config.Trading
	return if type(t) == "table" then t else {}
end

local function minFee(): number
	local v = trading().MinFeeCents
	return if type(v) == "number" and v >= 0 then v else PortfolioMath.MIN_FEE
end

local function isInt(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge and v % 1 == 0
end

local function int(v: any, fallback: number): number
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return math.floor(v)
	end
	return fallback
end

function Portfolio.SetObserver(fn: ((Depot, number, string) -> ())?)
	observer = fn
end

local function notify(d: Depot, signed: number, reason: string)
	local fn = observer
	if fn then
		local ok, err = pcall(fn, d, signed, reason)
		if not ok then
			warn("[Portfolio] Beobachter-Fehler: " .. tostring(err))
		end
	end
end

-- ---------------------------------------------------------------------
-- 1) BÖRSENTAG-AUFZEICHNUNG (Nav-Ring; Fluss F für Modified Dietz)
-- ---------------------------------------------------------------------
function Portfolio.CurrentDay(d: Depot): { number }?
	local nav = d.Nav
	if type(nav) ~= "table" then
		return nil
	end
	local rec = nav[#nav]
	return if type(rec) == "table" then rec else nil
end

local function addFlow(d: Depot, signed: number)
	local rec = Portfolio.CurrentDay(d)
	if rec then
		rec[4] = (rec[4] or 0) + signed
	end
end

-- Öffnet (oder liefert) den Datensatz des Börsentags "day". navStart = nav.
function Portfolio.OpenDay(d: Depot, day: number, nav: number, active: boolean?): { number }
	if type(d.Nav) ~= "table" then
		d.Nav = {}
	end
	local current = Portfolio.CurrentDay(d)
	if current and current[1] == day then
		return current
	end
	local rec = { day, nav, nav, 0, 0, if active then 1 else 0 }
	table.insert(d.Nav, rec)
	while #d.Nav > NAV_MAX do
		table.remove(d.Nav, 1)
	end
	return rec
end

function Portfolio.MarkActive(d: Depot)
	local rec = Portfolio.CurrentDay(d)
	if rec then
		rec[6] = 1
	end
end

function Portfolio.AddCountingTrade(d: Depot)
	local rec = Portfolio.CurrentDay(d)
	if rec then
		rec[5] = (rec[5] or 0) + 1
	end
end

-- ---------------------------------------------------------------------
-- 2) DER TRICHTER: Credit / Debit
-- ---------------------------------------------------------------------
function Portfolio.Credit(d: Depot, cents: number, reason: string): boolean
	if type(d) ~= "table" or not Portfolio.REASONS[reason] or not isInt(cents) or cents < 0 then
		return false
	end
	if cents == 0 then
		return true
	end
	local cash = int(d.Cash, 0)
	local amount = math.min(cents, math.max(0, MAX_MONEY - cash)) -- nie über MAX (9e15 < 2^53)
	d.Cash = cash + amount
	if BASIS_REASONS[reason] then
		d.Basis = math.min(MAX_MONEY, int(d.Basis, 0) + amount)
	end
	if Portfolio.FLOW_REASONS[reason] then
		addFlow(d, amount)
	end
	notify(d, amount, reason)
	return true
end

function Portfolio.Debit(d: Depot, cents: number, reason: string): boolean
	if type(d) ~= "table" or not Portfolio.REASONS[reason] or not isInt(cents) or cents < 0 then
		return false
	end
	if cents == 0 then
		return true
	end
	local cash = int(d.Cash, 0)
	if reason == "Licence" then
		-- Lizenz-Herabstufung (nur Admin): Basis sinkt voll, Cash höchstens bis 0 (nie negativ)
		local take = math.min(cash, cents)
		d.Cash = cash - take
		d.Basis = math.max(0, int(d.Basis, 0) - cents)
		addFlow(d, -take)
		notify(d, -take, reason)
		return true
	end
	if cash < cents then
		return false
	end
	d.Cash = cash - cents
	if BASIS_REASONS[reason] then
		d.Basis = math.max(0, int(d.Basis, 0) - cents)
	end
	if Portfolio.FLOW_REASONS[reason] then
		addFlow(d, -cents)
	end
	notify(d, -cents, reason)
	return true
end

-- ---------------------------------------------------------------------
-- 3) RESERVIERUNGEN (MARKET §12.3; Schutz-Paar = ein Datensatz, zählt einmal)
-- ---------------------------------------------------------------------
local function isExcept(o: any, except: any): boolean
	if except == nil then
		return false
	end
	if o == except then
		return true
	end
	return type(except) == "number" and o.Id == except
end

function Portfolio.Reserved(d: Depot, except: any?): number
	local sum = 0
	if type(d.Orders) == "table" then
		for _, o in ipairs(d.Orders) do
			if o.Side == "B" and not isExcept(o, except) then
				sum += int(o.Res, 0)
			end
		end
	end
	return sum
end

function Portfolio.ReservedQty(d: Depot, inst: number, except: any?): number
	local sum = 0
	if type(d.Orders) == "table" then
		for _, o in ipairs(d.Orders) do
			if o.Side == "S" and o.I == inst and not isExcept(o, except) then
				sum += int(o.Q, 0)
			end
		end
	end
	return sum
end

function Portfolio.Free(d: Depot): number
	return math.max(0, int(d.Cash, 0) - Portfolio.Reserved(d))
end

function Portfolio.PosQty(d: Depot, inst: number): number
	local p = type(d.Pos) == "table" and d.Pos[tostring(inst)] or nil
	return if type(p) == "table" then int(p.Q, 0) else 0
end

function Portfolio.PosValue(d: Depot, inst: number, bid: number?): number
	local p = type(d.Pos) == "table" and d.Pos[tostring(inst)] or nil
	if type(p) ~= "table" then
		return 0
	end
	if type(bid) == "number" and bid > 0 then
		return int(p.Q, 0) * math.floor(bid)
	end
	return math.max(0, int(p.C, 0))
end

-- ---------------------------------------------------------------------
-- 4) KAUFEN / VERKAUFEN (ohne Yield zwischen Prüfung und Buchung)
--    opts: { Tick, Flags, Nav, MaxWeight?, PosCap?, Bid? }  (MaxWeight nil = ETF, von der Klumpen-Grenze ausgenommen)
-- ---------------------------------------------------------------------
function Portfolio.Buy(
	d: Depot,
	inst: number,
	qty: number,
	ask: number,
	bps: number,
	fromOrder: any?,
	opts: { [string]: any }?
): (boolean, any)
	if not isInt(qty) or qty <= 0 or not isInt(ask) or ask <= 0 then
		return false, "trade.invalid"
	end
	local gross = qty * ask
	if gross >= PortfolioMath.MAX_SAFE / 2 then
		return false, "trade.posLimit"
	end
	local fee = PortfolioMath.Fee(gross, bps, minFee())
	local total = gross + fee
	local available = int(d.Cash, 0) - Portfolio.Reserved(d, fromOrder)
	if available < total then
		return false, "trade.noCash"
	end
	local o = opts or {}
	local key = tostring(inst)
	local p = d.Pos[key]
	if o.MaxWeight ~= nil and type(o.Nav) == "number" then
		local posValue = Portfolio.PosValue(d, inst, o.Bid)
		if PortfolioMath.Weight(posValue, gross, o.Nav) > o.MaxWeight + 1e-9 then
			return false, "trade.concentration"
		end
	end
	if type(o.PosCap) == "number" then
		local have = if type(p) == "table" then int(p.Q, 0) else 0
		if (have + qty) * ask > o.PosCap then
			return false, "trade.posLimit"
		end
	end
	-- Buchung: Brutto + Gebühr über den Trichter
	Portfolio.Debit(d, gross, "Trade")
	Portfolio.Debit(d, fee, "Fee")
	local tick = int(o.Tick, 0)
	local flags = int(o.Flags, 0)
	if type(p) ~= "table" or int(p.Q, 0) <= 0 then
		p = { Q = 0, C = 0, R = if type(p) == "table" then int(p.R, 0) else 0, T = tick, F = flags }
	else
		p.F = bit32.bor(int(p.F, 0), flags)
		if not isInt(p.T) then
			p.T = tick
		elseif tick > p.T then
			-- Nachkauf: Eröffnungs-Tick mengengewichtet nachziehen. Sonst zählt "1 Stück 60 s halten, dann groß
			-- nachkaufen und sofort verkaufen" als ≥ 60 s gehalten (Liga-/XP-Trade, "Gut gelesen").
			local have = int(p.Q, 0)
			p.T = p.T + math.floor((tick - p.T) * qty / (have + qty))
		end
	end
	p.Q += qty
	p.C += total -- Einstand inkl. Gebühr
	d.Pos[key] = p
	Portfolio.MarkActive(d)
	return true, { Px = ask, Q = qty, Fee = fee, Gross = gross, Total = total }
end

function Portfolio.Sell(
	d: Depot,
	inst: number,
	qty: number,
	bid: number,
	bps: number,
	fromOrder: any?,
	opts: { [string]: any }?
): (boolean, any)
	if not isInt(qty) or qty <= 0 or not isInt(bid) or bid <= 0 then
		return false, "trade.invalid"
	end
	local key = tostring(inst)
	local p = d.Pos[key]
	if type(p) ~= "table" or int(p.Q, 0) - Portfolio.ReservedQty(d, inst, fromOrder) < qty then
		return false, "trade.noShares"
	end
	local gross = qty * bid
	local fee = math.min(gross, PortfolioMath.Fee(gross, bps, minFee()))
	local net = gross - fee
	local basis = PortfolioMath.Basis(p, qty)
	local tick = int(opts and opts.Tick, 0)
	local held = if isInt(p.T) then math.max(0, tick - p.T) else 0
	local flags = int(p.F, 0)
	p.Q -= qty
	p.C -= basis
	p.R = int(p.R, 0) + (net - basis)
	Portfolio.Credit(d, gross, "Trade")
	Portfolio.Debit(d, fee, "Fee")
	if p.Q <= 0 then
		d.Pos[key] = nil
	end
	Portfolio.MarkActive(d)
	return true,
		{
			Px = bid,
			Q = qty,
			Fee = fee,
			Gross = gross,
			Net = net,
			Basis = basis,
			Pnl = net - basis,
			HeldS = held,
			Flags = flags,
		}
end

-- ---------------------------------------------------------------------
-- 5) DEPOTWERT
-- ---------------------------------------------------------------------
function Portfolio.Nav(d: Depot, bidOf: (number) -> number?): number
	local nav = int(d.Cash, 0)
	if type(d.Pos) ~= "table" then
		return nav
	end
	for key, p in pairs(d.Pos) do
		local qty = if type(p) == "table" then int(p.Q, 0) else 0
		if qty > 0 then
			local id = tonumber(key)
			local bid = if id then bidOf(id) else nil
			if type(bid) == "number" and bid > 0 then
				nav += qty * math.floor(bid)
			else
				nav += math.max(0, int(p.C, 0))
			end
		end
	end
	return math.min(nav, MAX_MONEY)
end

-- ---------------------------------------------------------------------
-- 6) VERLAUF & STATISTIK
-- ---------------------------------------------------------------------
function Portfolio.PushFill(
	d: Depot,
	tick: number,
	inst: number,
	side: string,
	qty: number,
	px: number,
	fee: number,
	pnl: number,
	bot: boolean
)
	if type(d.Fills) ~= "table" then
		d.Fills = {}
	end
	table.insert(d.Fills, { tick, inst, if side == "B" then 1 else 2, qty, px, fee, pnl, if bot then 1 else 0 })
	while #d.Fills > FILLS_MAX do
		table.remove(d.Fills, 1)
	end
end

function Portfolio.NoteSell(d: Depot, pnl: number, basis: number)
	local s = d.Stats
	if type(s) ~= "table" then
		return
	end
	s.Trades = int(s.Trades, 0) + 1
	if pnl > 0 then
		s.Wins = int(s.Wins, 0) + 1
		s.GrossWin = int(s.GrossWin, 0) + pnl
	elseif pnl < 0 then
		s.Losses = int(s.Losses, 0) + 1
		s.GrossLoss = int(s.GrossLoss, 0) - pnl
	end
	if basis > 0 then
		local pct = pnl / basis
		if pct > (tonumber(s.BestPct) or 0) then
			s.BestPct = math.floor(pct * 10000 + 0.5) / 10000
		end
	end
end

-- ---------------------------------------------------------------------
-- 7) LIGA (Wochen-Daten in PlayerData.League; MARKET §12.6 mit §C19 Nr. 7)
-- ---------------------------------------------------------------------
local function leagueCfg(): { [string]: any }
	local l = trading().League
	return if type(l) == "table" then l else {}
end

function Portfolio.TierOf(score: number, qualified: boolean): string
	if not qualified then
		return "None"
	end
	local tier = "None"
	local tiers = leagueCfg().Tiers
	if type(tiers) == "table" then
		for _, entry in ipairs(tiers) do
			if type(entry) == "table" and type(entry.Min) == "number" and score >= entry.Min then
				tier = entry.Key
			end
		end
	end
	return tier
end

-- Woche wechseln: alte Woche als "Last*" merken (für die Liga-Belohnung der Folgewoche, WP9), dann leeren
function Portfolio.LeagueRoll(league: { [string]: any }, week: number)
	if type(league) ~= "table" or not isInt(week) then
		return
	end
	if league.Week == week then
		return
	end
	if isInt(league.Week) and league.Week > 0 then
		local stats = Portfolio.LeagueStats(league, false)
		league.LastWeek = league.Week
		league.LastScore = stats.SkillScore
		league.LastAvgBp = stats.AvgDailyBp
		league.LastQualified = stats.Qualified
		league.LastTier = Portfolio.TierOf(stats.SkillScore, stats.Qualified)
	end
	league.Week = week
	league.Returns = {}
	league.Trades = 0
	league.Days = 0
	league.Tainted = false
end

function Portfolio.LeagueAddDay(league: { [string]: any }, r: number, qualifying: boolean)
	if type(league) ~= "table" or type(r) ~= "number" or r ~= r then
		return
	end
	if type(league.Returns) ~= "table" then
		league.Returns = {}
	end
	table.insert(league.Returns, math.floor(r * 1e8 + 0.5) / 1e8)
	local maxReturns = int(leagueCfg().MaxReturns, 504)
	while #league.Returns > maxReturns do
		table.remove(league.Returns, 1)
	end
	if qualifying then
		league.Days = int(league.Days, 0) + 1
	end
end

function Portfolio.LeagueAddTrade(league: { [string]: any })
	if type(league) == "table" then
		league.Trades = int(league.Trades, 0) + 1
	end
end

function Portfolio.LeagueStats(league: { [string]: any }, extraTaint: boolean): Types.LeagueStats
	local returns = if type(league) == "table" and type(league.Returns) == "table" then league.Returns else {}
	local trades = int(type(league) == "table" and league.Trades, 0)
	local days = int(type(league) == "table" and league.Days, 0)
	local tainted = (type(league) == "table" and league.Tainted == true) or extraTaint == true
	local maxDD = PortfolioMath.MaxDrawdown(returns)
	local score = PortfolioMath.SkillScore(returns, maxDD)
	local avg = PortfolioMath.AvgDaily(PortfolioMath.Twr(returns), #returns)
	local cfg = leagueCfg()
	local qualified = not tainted and trades >= int(cfg.MinTrades, 20) and days >= int(cfg.MinDays, 6) and #returns > 0
	return {
		Week = int(type(league) == "table" and league.Week, 0),
		SkillScore = score,
		AvgDailyBp = math.floor(avg * 10000 + 0.5),
		Trades = trades,
		Days = days,
		Tainted = tainted,
		Qualified = qualified,
	}
end

-- ---------------------------------------------------------------------
-- 8) SPIELSTAND REPARIEREN (nach DataService Migrate/Reconcile; nie Geld erfinden)
-- ---------------------------------------------------------------------
local SIDES = { B = true, S = true }
local TYPES = { MKT = true, LMT = true, STP = true, TP = true, OCO = true, TRL = true }

local function cleanPrice(v: any): number?
	if isInt(v) and v > 0 and v < 1e10 then
		return v
	end
	return nil
end

local function cleanOrder(o: any, isValidInst: (number) -> boolean): any?
	if type(o) ~= "table" then
		return nil
	end
	if not isInt(o.Id) or o.Id < 1 or not isInt(o.I) or not isValidInst(o.I) then
		return nil
	end
	if not SIDES[o.Side] or not TYPES[o.Type] or o.Type == "MKT" then
		return nil
	end
	if not isInt(o.Q) or o.Q < 1 or not isInt(o.Exp) or not isInt(o.T0) then
		return nil
	end
	local clean: { [string]: any } = {
		Id = o.Id,
		I = o.I,
		Side = o.Side,
		Type = o.Type,
		Q = o.Q,
		Lim = cleanPrice(o.Lim),
		Stp = cleanPrice(o.Stp),
		Tp = cleanPrice(o.Tp),
		Trl = if isInt(o.Trl) and o.Trl > 0 and o.Trl < 10000 then o.Trl else nil,
		Peak = cleanPrice(o.Peak),
		Oco = if isInt(o.Oco) then o.Oco else nil,
		Res = if o.Side == "B" and isInt(o.Res) and o.Res > 0 then o.Res else 0,
		Exp = o.Exp,
		T0 = o.T0,
		Bot = if isInt(o.Bot) and o.Bot >= 1 and o.Bot <= BOTS_MAX then o.Bot else nil,
	}
	-- Pflichtfelder je Typ
	local t = clean.Type
	if t == "LMT" and clean.Lim == nil then
		return nil
	elseif t == "STP" and clean.Stp == nil then
		return nil
	elseif t == "TP" and clean.Tp == nil then
		return nil
	elseif t == "OCO" and (clean.Stp == nil or clean.Tp == nil or clean.Side ~= "S") then
		return nil
	elseif t == "TRL" and (clean.Trl == nil or clean.Side ~= "S") then
		return nil
	end
	if o.Side == "B" and clean.Res <= 0 then
		return nil -- Kauf-Order ohne Reservierung wäre Geld aus dem Nichts
	end
	return clean
end

function Portfolio.Sanitize(d: Depot, nowTick: number, isValidInst: (number) -> boolean): { string }
	local issues: { string } = {}
	local function note(text: string)
		if #issues < 20 then
			table.insert(issues, text)
		end
	end
	local defaultCash = 2500000
	local cash = int(d.Cash, -1)
	if cash < 0 then
		note("Cash ungültig")
		cash = 0
	end
	d.Cash = math.min(cash, MAX_MONEY)
	local basis = int(d.Basis, -1)
	if basis <= 0 then
		note("Basis ungültig")
		basis = defaultCash
	end
	d.Basis = math.min(basis, MAX_MONEY)
	d.Lic = if isInt(d.Lic) and d.Lic >= 1 and d.Lic <= 10 then d.Lic else 1
	d.Pending = math.max(0, int(d.Pending, 0))

	-- Positionen: Schlüssel = tostring(gültige Id), Q > 0 ganzzahlig
	local pos: { [string]: any } = {}
	if type(d.Pos) == "table" then
		for key, p in pairs(d.Pos) do
			local id = tonumber(key)
			if
				id
				and isInt(id)
				and id >= 1
				and id <= INST_MAX
				and isValidInst(id)
				and type(p) == "table"
				and isInt(p.Q)
				and p.Q > 0
			then
				pos[tostring(id)] = {
					Q = p.Q,
					C = math.max(0, int(p.C, 0)),
					R = int(p.R, 0),
					T = if isInt(p.T) then math.min(p.T, nowTick) else nowTick,
					F = if isInt(p.F) and p.F >= 0 then p.F else 0,
				}
			else
				note("Position " .. tostring(key) .. " entfernt")
			end
		end
	end
	d.Pos = pos
	if type(d.Short) ~= "table" then
		d.Short = {}
	end

	-- Orders
	local orders = {}
	local maxId = 0
	if type(d.Orders) == "table" then
		for _, o in ipairs(d.Orders) do
			local clean = cleanOrder(o, isValidInst)
			if clean and #orders < ORDERS_MAX then
				table.insert(orders, clean)
				maxId = math.max(maxId, clean.Id)
			else
				note("Order entfernt")
			end
		end
	end
	d.Orders = orders

	-- Alarme
	local alerts = {}
	if type(d.Alerts) == "table" then
		for _, a in ipairs(d.Alerts) do
			if
				type(a) == "table"
				and isInt(a.Id)
				and isInt(a.I)
				and isValidInst(a.I)
				and cleanPrice(a.Px)
				and (a.Dir == "Up" or a.Dir == "Down")
				and #alerts < ALERTS_MAX
			then
				table.insert(alerts, { Id = a.Id, I = a.I, Px = a.Px, Dir = a.Dir })
				maxId = math.max(maxId, a.Id)
			end
		end
	end
	d.Alerts = alerts
	d.NextId = math.max(int(d.NextId, 1), maxId + 1)

	-- Watchlisten: 1 … 5 Listen je ≤ 12 gültige, eindeutige Ids
	local watch = {}
	if type(d.Watch) == "table" then
		for _, list in ipairs(d.Watch) do
			if #watch >= WATCH_LISTS_MAX then
				break
			end
			local clean, seen = {}, {}
			if type(list) == "table" then
				for _, id in ipairs(list) do
					if isInt(id) and isValidInst(id) and not seen[id] and #clean < WATCH_IDS_MAX then
						seen[id] = true
						table.insert(clean, id)
					end
				end
			end
			table.insert(watch, clean)
		end
	end
	if #watch == 0 then
		watch = { {} }
	end
	d.Watch = watch

	-- Ringe
	if type(d.Fills) ~= "table" then
		d.Fills = {}
	end
	while #d.Fills > FILLS_MAX do
		table.remove(d.Fills, 1)
	end
	local navs = {}
	if type(d.Nav) == "table" then
		for _, rec in ipairs(d.Nav) do
			if type(rec) == "table" and isInt(rec[1]) and type(rec[2]) == "number" and type(rec[3]) == "number" then
				table.insert(navs, {
					rec[1],
					int(rec[2], 0),
					int(rec[3], 0),
					int(rec[4], 0),
					math.max(0, int(rec[5], 0)),
					if rec[6] == 1 then 1 else 0,
				})
			end
		end
	end
	while #navs > NAV_MAX do
		table.remove(navs, 1)
	end
	d.Nav = navs
	local seq = {}
	if type(d.Seq) == "table" then
		for _, s in ipairs(d.Seq) do
			if isInt(s) then
				table.insert(seq, s)
			end
		end
	end
	while #seq > SEQ_MAX do
		table.remove(seq, 1)
	end
	d.Seq = seq

	-- Bots (Presets prüft BotEngine beim Entscheiden; hier nur Form)
	local bots = {}
	if type(d.Bots) == "table" then
		for _, slot in ipairs(d.Bots) do
			if #bots >= BOTS_MAX then
				break
			end
			if type(slot) == "table" and type(slot.Preset) == "string" then
				local q: { [string]: number } = {}
				if type(slot.Q) == "table" then
					for key, n in pairs(slot.Q) do
						local id = tonumber(key)
						if id and isInt(n) and n > 0 then
							q[tostring(id)] = n
						end
					end
				end
				table.insert(bots, {
					Preset = slot.Preset,
					Pct = if type(slot.Pct) == "number" and slot.Pct == slot.Pct then slot.Pct else 0,
					Target = if isInt(slot.Target) then slot.Target else nil,
					On = slot.On == true,
					Paused = slot.Paused == true,
					DayNav = math.max(0, int(slot.DayNav, 0)),
					DayVal = math.max(0, int(slot.DayVal, 0)),
					DayFlow = int(slot.DayFlow, 0),
					Day = int(slot.Day, -1),
					Last = int(slot.Last, -1),
					Q = q,
				})
			else
				-- leerer Platz (Liste bleibt lückenlos)
				table.insert(bots, {
					Preset = "",
					Pct = 0,
					On = false,
					Paused = false,
					DayNav = 0,
					DayVal = 0,
					DayFlow = 0,
					Day = -1,
					Last = -1,
					Q = {},
				})
			end
		end
	end
	d.Bots = bots

	local stats = if type(d.Stats) == "table" then d.Stats else {}
	for _, key in ipairs({ "Trades", "Wins", "Losses", "GrossWin", "GrossLoss", "PeakNav", "ReadWell" }) do
		stats[key] = math.max(0, int(stats[key], 0))
	end
	stats.MaxDD = if type(stats.MaxDD) == "number" and stats.MaxDD == stats.MaxDD
		then math.clamp(stats.MaxDD, 0, 1)
		else 0
	stats.BestPct = if type(stats.BestPct) == "number" and stats.BestPct == stats.BestPct
		then math.max(0, stats.BestPct)
		else 0
	d.Stats = stats
	local tut = if type(d.Tutorial) == "table" then d.Tutorial else {}
	tut.T0 = math.max(0, int(tut.T0, 0))
	tut.Q = math.max(0, int(tut.Q, 0))
	tut.Done = tut.Done == true
	d.Tutorial = tut
	d.LastTick = math.clamp(int(d.LastTick, 0), 0, math.max(0, nowTick))
	d.LastTransferDay = int(d.LastTransferDay, -1)
	d.LastRefillUtcDay = int(d.LastRefillUtcDay, -1)
	d.AutoTransfer = d.AutoTransfer ~= false
	d.NextId = math.max(1, int(d.NextId, 1))

	-- Invariante Cash ≥ Reservierungen: notfalls jüngste Kauf-Orders streichen (nie Geld erfinden)
	local guard = 0
	while Portfolio.Reserved(d) > d.Cash and guard < ORDERS_MAX do
		guard += 1
		for i = #d.Orders, 1, -1 do
			if d.Orders[i].Side == "B" then
				table.remove(d.Orders, i)
				note("Kauf-Order ohne Deckung entfernt")
				break
			end
		end
	end
	-- Verkaufs-Orders dürfen nie mehr Stück reservieren, als da sind (älteste behalten, Überhang streichen)
	local used: { [number]: number } = {}
	local kept = {}
	for _, o in ipairs(d.Orders) do
		if o.Side == "S" then
			local sum = (used[o.I] or 0) + o.Q
			if sum <= Portfolio.PosQty(d, o.I) then
				used[o.I] = sum
				table.insert(kept, o)
			else
				note("Verkaufs-Order ohne Anteile entfernt")
			end
		else
			table.insert(kept, o)
		end
	end
	d.Orders = kept
	return issues
end

return Portfolio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">PriceEngine</string>
            <string name="Source"><![CDATA[--!strict
--!native
-- =====================================================================
--  AKYTEX TYCOON – Kurs, Quote und 1s-Kerze (Server/Market/PriceEngine)
--  Besitzer: WP3 (Markt-Engine). Vertrag: MARKET.md §5.1, §5.3, §5.4, §19.1; DESIGN.md §B6.1, §B6.3 (IPO-Klasse).
--  Eine Instanz je Woche (Wochen-Seed). Alle Geldwerte in ganzzahligen Cent.
--
--  ln P_i(t) = ln B_i + d_i·(t − t0) + E_i(t) + σ_i·( R(t)·(β·M + γ·S + ε·I − N0_i) + μ·W_i(t) )
--  ETF:  P(t) = B_ETF · exp( Mittel_k( ln P_k(t) − ln P_k(t0) ) )   (kein eigenes Rauschen)
--  1s-Kerze: O = Schluss der Vorsekunde, C = mid(t), H/L deterministisch aus dem Hash. H/L sind KANONISCH:
--  schon auf die Frame-Auflösung (0,01-%-Schritte, max. 255) gerundet – Order-Trigger (WP4), Frame und 1s-Ring
--  sehen damit exakt dieselbe Kerze ("was der Chart zeigt, hat die Order gesehen").
--  Live-Felder und Random-Access-Felder sind getrennt; ein Cursor hat eigene Felder (Offline-Abgleich).
--
--  Öffentliche API (nur WP3)
--    PriceEngine.new({ Seed, Week, Config, Specs = { Spec }, Env = { Offset(i, t, divFrom?), VolMul(t) } }): Engine
--    e:Step(t)                          alle Instrumente auf Tick t (Aktien zuerst, ETFs zuletzt)
--    e:Quote(i): (bid?, ask?, mid?)     e:Candle(i): (O, H, L, C, V, hiOff, loOff)?   e:HalfSpread(i): number
--    e:Regime(): number                 e:LiveTick(): number             e:NewsActive(i): boolean
--    e:MidAt(i, t, divFrom?): number    e:CandleAt(i, t): (O, H, L, C, V, hiOff, loOff)   e:RegimeAt(t): number
--    e:QuoteAt(i, t): (bid, ask, mid)   Quote zu einem beliebigen Tick (IPO-Klasse/Übergang wie live; Fill-Audit)
--    e:NewCursor(i, t0): Cursor         Cursor:Candle(t) -> (O, H, L, C) · Cursor:Seek(t)
--    e:AddInstrument(spec) · e:Has(i) · e:IsActive(i, t) · e:Ids(): { number }
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Noise = require(script.Parent:WaitForChild("Noise"))
local QuoteCodec = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Market"):WaitForChild("QuoteCodec"))

local PriceEngine = {}
PriceEngine.__index = PriceEngine

local FieldAt = Noise.FieldAt
local White = Noise.White

export type Spec = {
	Id: number,
	Etf: boolean,
	Base: number, -- Cent (Wochenbasis bzw. Eröffnungskurs)
	Origin: number, -- erster Tick des Instruments in dieser Woche
	Sigma: number,
	Sigma1s: number,
	SpreadBps: number,
	VolBase: number,
	Drift: number, -- je Tick
	SectorIdx: number,
	Members: { number }?,
	WildUntil: number?, -- IPO: bis hierhin Klasse Wild, danach Übergang über Blend Sekunden
	WildSigma: number?,
	WildSigma1s: number?,
	WildSpread: number?,
	Blend: number?,
}

type Field = Noise.Field
type Plain = { [string]: any }

type FieldSet = {
	M: Field,
	S: { Field },
	V: Field,
	I: { [number]: Field },
	MemoT: number,
	MemoM: number,
	MemoS: { number },
	MemoR: number,
}

type Inst = {
	Spec: Spec,
	LnBase: number,
	N0: number?,
	L0: { number }?, -- ETF: ln P der Mitglieder zum Wochenstart
	-- Live-Zustand (letzter Step)
	T: number,
	Mid: number,
	Log: number,
	O: number,
	H: number,
	L: number,
	C: number,
	V: number,
	HiOff: number,
	LoOff: number,
	Bid: number,
	Ask: number,
	News: boolean,
}

export type Env = {
	Offset: (i: number, t: number, divFrom: number?) -> (number, boolean),
	VolMul: (t: number) -> number,
}

local function newFieldSet(seed: number, octLo: number, octHi: number): FieldSet
	local s: { Field } = {}
	for index = 1, 6 do
		s[index] = Noise.NewField(seed, 10 + index)
	end
	return {
		M = Noise.NewField(seed, 1),
		S = s,
		V = Noise.NewField(seed, 2, octLo, octHi),
		I = {},
		MemoT = -math.huge,
		MemoM = 0,
		MemoS = table.create(6, 0),
		MemoR = 1,
	}
end

function PriceEngine.new(params: Plain)
	local cfg = params.Config
	local self = setmetatable({}, PriceEngine) :: any
	self.Seed = math.floor(params.Seed) % 2147483648
	self.Week = params.Week
	self.Cfg = cfg
	self.Env = params.Env :: Env
	local noise = cfg.Noise
	self.Beta = noise.Beta
	self.Gamma = noise.Gamma
	self.Eps = noise.Eps
	self.Micro = noise.Micro
	self.RegK = noise.RegimeK
	self.RegLo = noise.RegimeRange[1]
	self.RegHi = noise.RegimeRange[2]
	self.MinCents = cfg.Price.MinCents
	self.MaxCents = cfg.Price.MaxCents
	self.EdgeTicks = cfg.Activity.EdgeMinutes * 60
	self.EdgeMult = cfg.Activity.EdgeMult
	self.DayTicks = cfg.DayTicks
	local oct = noise.RegimeOctaves
	self.OctLo, self.OctHi = oct[1], oct[2]
	self.Live = newFieldSet(self.Seed, oct[1], oct[2])
	self.RA = newFieldSet(self.Seed, oct[1], oct[2])
	self.Insts = {} :: { [number]: Inst }
	self.Stocks = {} :: { number }
	self.Etfs = {} :: { number }
	self.LiveT = -math.huge
	self.LiveR = 1
	for _, spec in ipairs(params.Specs :: { Spec }) do
		self:AddInstrument(spec)
	end
	return self
end

function PriceEngine.AddInstrument(self: any, spec: Spec)
	local i = spec.Id
	local fresh = self.Insts[i] == nil
	self.Insts[i] = {
		Spec = spec,
		LnBase = math.log(math.max(1, spec.Base) / 100),
		N0 = nil,
		L0 = nil,
		T = -math.huge,
		Mid = 0,
		Log = 0,
		O = 0,
		H = 0,
		L = 0,
		C = 0,
		V = 0,
		HiOff = 0,
		LoOff = 0,
		Bid = 0,
		Ask = 0,
		News = false,
	}
	if fresh then
		if spec.Etf then
			table.insert(self.Etfs, i)
		else
			table.insert(self.Stocks, i)
			table.sort(self.Stocks)
		end
	end
end

function PriceEngine.Has(self: any, i: number): boolean
	return self.Insts[i] ~= nil
end

function PriceEngine.IsActive(self: any, i: number, t: number): boolean
	local inst = self.Insts[i]
	return inst ~= nil and t >= inst.Spec.Origin
end

function PriceEngine.Ids(self: any): { number }
	local out: { number } = {}
	for _, i in ipairs(self.Stocks) do
		table.insert(out, i)
	end
	for _, i in ipairs(self.Etfs) do
		table.insert(out, i)
	end
	return out
end

function PriceEngine.LiveTick(self: any): number
	return self.LiveT
end

-- ---------------------------------------------------------------------
-- FELDER & REGIME (gemeinsame Felder je Tick einmal; Memo je Feldsatz)
-- ---------------------------------------------------------------------
local function shared(self: any, fs: FieldSet, t: number)
	if fs.MemoT ~= t then
		fs.MemoT = t
		fs.MemoM = FieldAt(fs.M, t)
		for index = 1, 6 do
			fs.MemoS[index] = FieldAt(fs.S[index], t)
		end
		local r = math.exp(self.RegK * FieldAt(fs.V, t)) * self.Env.VolMul(t)
		fs.MemoR = math.clamp(r, self.RegLo, self.RegHi)
	end
end

local function firmField(self: any, fs: FieldSet, i: number): Field
	local f = fs.I[i]
	if f == nil then
		f = Noise.NewField(self.Seed, 100 + i)
		fs.I[i] = f
	end
	return f
end

-- Klasse am Tick t (IPO: Wild am ersten Börsentag, danach linearer Übergang -> kein Kurssprung)
local function classAt(spec: Spec, t: number): (number, number, number)
	local wildUntil = spec.WildUntil
	if wildUntil == nil then
		return spec.Sigma, spec.Sigma1s, spec.SpreadBps
	end
	local blend = spec.Blend or 300
	local w = if t < wildUntil then 1 else math.clamp(1 - (t - wildUntil) / blend, 0, 1)
	if w <= 0 then
		return spec.Sigma, spec.Sigma1s, spec.SpreadBps
	end
	local ws = spec.WildSigma or spec.Sigma
	local ws1 = spec.WildSigma1s or spec.Sigma1s
	local wsp = spec.WildSpread or spec.SpreadBps
	return spec.Sigma + (ws - spec.Sigma) * w,
		spec.Sigma1s + (ws1 - spec.Sigma1s) * w,
		spec.SpreadBps + (wsp - spec.SpreadBps) * w
end

local function noiseLevel(self: any, fs: FieldSet, i: number, sector: number, t: number): number
	return self.Beta * fs.MemoM + self.Gamma * fs.MemoS[sector] + self.Eps * FieldAt(firmField(self, fs, i), t)
end

-- N0 = Rauschwert beim Ursprung (eigener Feldsatz, damit Live/RA-Caches unberührt bleiben)
local function n0Of(self: any, inst: Inst): number
	local n0 = inst.N0
	if n0 ~= nil then
		return n0
	end
	local spec = inst.Spec
	local t = spec.Origin
	local fs = newFieldSet(self.Seed, self.OctLo, self.OctHi)
	fs.MemoT = t
	fs.MemoM = FieldAt(fs.M, t)
	for index = 1, 6 do
		fs.MemoS[index] = FieldAt(fs.S[index], t)
	end
	local value = noiseLevel(self, fs, spec.Id, spec.SectorIdx, t)
	inst.N0 = value
	return value
end

-- Log-Mid einer Aktie (unrundet) + News-aktiv-Flag
local function stockLog(self: any, fs: FieldSet, inst: Inst, t: number, divFrom: number?): (number, boolean)
	local spec = inst.Spec
	shared(self, fs, t)
	local sigma = classAt(spec, t)
	local level = noiseLevel(self, fs, spec.Id, spec.SectorIdx, t) - n0Of(self, inst)
	local offset, news = self.Env.Offset(spec.Id, t, divFrom)
	local micro = self.Micro * White(self.Seed, 200 + spec.Id, t)
	return inst.LnBase + spec.Drift * (t - spec.Origin) + offset + sigma * (fs.MemoR * level + micro), news
end

local function etfL0(self: any, inst: Inst): { number }
	local l0 = inst.L0
	if l0 then
		return l0
	end
	local members = inst.Spec.Members or {}
	local list: { number } = table.create(#members, 0)
	local fs = newFieldSet(self.Seed, self.OctLo, self.OctHi)
	for index, member in ipairs(members) do
		local m = self.Insts[member]
		if m then
			list[index] = (stockLog(self, fs, m, inst.Spec.Origin))
		end
	end
	inst.L0 = list
	return list
end

local function etfLog(self: any, fs: FieldSet, inst: Inst, t: number, memberLog: { [number]: number }?): number
	local members = inst.Spec.Members or {}
	local l0 = etfL0(self, inst)
	local sum, n = 0, 0
	for index, member in ipairs(members) do
		local m = self.Insts[member]
		if m then
			local value = if memberLog then memberLog[member] else nil
			if value == nil then
				value = (stockLog(self, fs, m, t))
			end
			sum += (value :: number) - l0[index]
			n += 1
		end
	end
	return inst.LnBase + (if n > 0 then sum / n else 0)
end

local function toCents(self: any, logMid: number): number
	local v = math.exp(logMid) * 100
	if v ~= v then
		return self.MinCents
	end
	return math.clamp(math.round(v), self.MinCents, self.MaxCents)
end

-- kanonische 1s-Kerze aus O (Vorsekunde) und C
local function candle(
	self: any,
	i: number,
	t: number,
	o: number,
	c: number,
	r: number,
	sigma1s: number,
	volBase: number,
	news: boolean
): (number, number, number, number, number, number, number)
	local s = math.max(1e-5, sigma1s)
	local rawH = math.max(o, c) * (1 + math.abs(White(self.Seed, 300 + i, t)) * s * 0.6)
	local rawL = math.min(o, c) * (1 - math.abs(White(self.Seed, 400 + i, t)) * s * 0.6)
	local hiOff = math.min(255, QuoteCodec.HiOff(o, c, rawH))
	local loOff = math.min(255, QuoteCodec.LoOff(o, c, rawL))
	local h = QuoteCodec.HiFrom(o, c, hiOff)
	local l = QuoteCodec.LoFrom(o, c, loOff)
	local second = t % self.DayTicks
	local edge = if second < self.EdgeTicks or second >= self.DayTicks - self.EdgeTicks then self.EdgeMult else 1
	local move = if o > 0 and c > 0 then math.abs(math.log(c / o)) else 0
	local v = volBase
		* r
		* (0.5 + (Noise.Uni(self.Seed, 500 + i, 0, t) + 1) / 2)
		* (1 + 6 * move / s)
		* (if news then 3 else 1)
		* edge
	return o, h, l, c, math.clamp(math.round(v / 10), 0, 65535), hiOff, loOff
end

-- ---------------------------------------------------------------------
-- LIVE
-- ---------------------------------------------------------------------
function PriceEngine.Step(self: any, t: number)
	local fs: FieldSet = self.Live
	shared(self, fs, t)
	local r = fs.MemoR
	local logs: { [number]: number } = {}
	local cont = self.LiveT == t - 1
	for _, i in ipairs(self.Stocks) do
		local inst: Inst = self.Insts[i]
		local spec = inst.Spec
		if t < spec.Origin then
			continue
		end
		local lm, news = stockLog(self, fs, inst, t)
		logs[i] = lm
		local mid = toCents(self, lm)
		local prev = if cont and inst.T == t - 1 then inst.Mid else self:MidAt(i, t - 1)
		local _, sigma1s, spreadBps = classAt(spec, t)
		local o, h, l, c, v, hiOff, loOff = candle(self, i, t, prev, mid, r, sigma1s, spec.VolBase, news)
		local bid, ask = QuoteCodec.Spread(mid, spreadBps, r)
		inst.T, inst.Mid, inst.Log = t, mid, lm
		inst.O, inst.H, inst.L, inst.C, inst.V, inst.HiOff, inst.LoOff = o, h, l, c, v, hiOff, loOff
		inst.Bid, inst.Ask = bid, ask
		inst.News = news
	end
	for _, i in ipairs(self.Etfs) do
		local inst: Inst = self.Insts[i]
		local spec = inst.Spec
		if t < spec.Origin then
			continue
		end
		local lm = etfLog(self, fs, inst, t, logs)
		local mid = toCents(self, lm)
		local prev = if cont and inst.T == t - 1 then inst.Mid else self:MidAt(i, t - 1)
		local o, h, l, c, v, hiOff, loOff = candle(self, i, t, prev, mid, r, spec.Sigma1s, spec.VolBase, false)
		local bid, ask = QuoteCodec.Spread(mid, spec.SpreadBps, r)
		inst.T, inst.Mid, inst.Log = t, mid, lm
		inst.O, inst.H, inst.L, inst.C, inst.V, inst.HiOff, inst.LoOff = o, h, l, c, v, hiOff, loOff
		inst.Bid, inst.Ask = bid, ask
	end
	self.LiveT = t
	self.LiveR = r
end

function PriceEngine.Quote(self: any, i: number): (number?, number?, number?)
	local inst = self.Insts[i]
	if inst == nil or inst.T ~= self.LiveT then
		return nil, nil, nil
	end
	return inst.Bid, inst.Ask, inst.Mid
end

function PriceEngine.HalfSpread(self: any, i: number): number
	local inst = self.Insts[i]
	if inst == nil or inst.T ~= self.LiveT then
		return 0
	end
	return inst.Ask - inst.Mid
end

function PriceEngine.Candle(self: any, i: number): (number?, number?, number?, number?, number?, number?, number?)
	local inst = self.Insts[i]
	if inst == nil or inst.T ~= self.LiveT then
		return nil, nil, nil, nil, nil, nil, nil
	end
	return inst.O, inst.H, inst.L, inst.C, inst.V, inst.HiOff, inst.LoOff
end

function PriceEngine.Regime(self: any): number
	return self.LiveR
end

function PriceEngine.NewsActive(self: any, i: number): boolean
	local inst = self.Insts[i]
	return inst ~= nil and inst.T == self.LiveT and inst.News
end

-- ---------------------------------------------------------------------
-- RANDOM-ACCESS (Historie, Offline-Abgleich, Fill-Audit) – rechnet exakt dasselbe wie Step
-- ---------------------------------------------------------------------
function PriceEngine.RegimeAt(self: any, t: number): number
	local fs: FieldSet = self.RA
	shared(self, fs, t)
	return fs.MemoR
end

function PriceEngine.LogAt(self: any, i: number, t: number, divFrom: number?): (number, boolean)
	local inst: Inst? = self.Insts[i]
	if inst == nil then
		return 0, false
	end
	local spec = inst.Spec
	if t < spec.Origin then
		return inst.LnBase, false
	end
	if divFrom == nil and inst.T == t and self.LiveT == t then
		return inst.Log, false
	end
	local fs: FieldSet = self.RA
	if spec.Etf then
		return etfLog(self, fs, inst, t, nil), false
	end
	return stockLog(self, fs, inst, t, divFrom)
end

function PriceEngine.MidAt(self: any, i: number, t: number, divFrom: number?): number
	local inst: Inst? = self.Insts[i]
	if inst == nil then
		return 0
	end
	if divFrom == nil and inst.T == t and self.LiveT == t then
		return inst.Mid
	end
	local lm = self:LogAt(i, t, divFrom)
	return toCents(self, lm)
end

function PriceEngine.QuoteAt(self: any, i: number, t: number): (number, number, number)
	local inst: Inst? = self.Insts[i]
	if inst == nil then
		return 0, 0, 0
	end
	if inst.T == t and self.LiveT == t then
		return inst.Bid, inst.Ask, inst.Mid
	end
	local spec = inst.Spec
	local mid = self:MidAt(i, t)
	local _, _, spreadBps = classAt(spec, t)
	local bid, ask = QuoteCodec.Spread(mid, if spec.Etf then spec.SpreadBps else spreadBps, self:RegimeAt(t))
	return bid, ask, mid
end

function PriceEngine.CandleAt(self: any, i: number, t: number): (number, number, number, number, number, number, number)
	local inst: Inst? = self.Insts[i]
	if inst == nil then
		return 0, 0, 0, 0, 0, 0, 0
	end
	if inst.T == t and self.LiveT == t then
		return inst.O, inst.H, inst.L, inst.C, inst.V, inst.HiOff, inst.LoOff
	end
	local spec = inst.Spec
	local prev = self:MidAt(i, t - 1)
	local lm, news = self:LogAt(i, t)
	local mid = toCents(self, lm)
	local r = self:RegimeAt(t)
	local _, sigma1s = classAt(spec, t)
	return candle(self, i, t, prev, mid, r, if spec.Etf then spec.Sigma1s else sigma1s, spec.VolBase, news)
end

-- ---------------------------------------------------------------------
-- CURSOR (sequentiell billig, eigene Felder; Offline-Abgleich WP4, Backfill)
-- ---------------------------------------------------------------------
function PriceEngine.NewCursor(self: any, i: number, t0: number)
	local engine = self
	local fs = newFieldSet(self.Seed, self.OctLo, self.OctHi)
	local cursor = { LastT = -math.huge, LastMid = 0, Id = i }

	local function mid(t: number): (number, boolean)
		local inst: Inst? = engine.Insts[i]
		if inst == nil then
			return 0, false
		end
		local spec = inst.Spec
		if t < spec.Origin then
			return toCents(engine, inst.LnBase), false
		end
		if spec.Etf then
			return toCents(engine, etfLog(engine, fs, inst, t, nil)), false
		end
		local lm, news = stockLog(engine, fs, inst, t)
		return toCents(engine, lm), news
	end

	function cursor.Seek(selfCursor: any, t: number)
		selfCursor.LastT = t - 1
		selfCursor.LastMid = (mid(t - 1))
	end

	-- volle Kerze (mit Umsatz und Dochtabständen) – für den Backfill
	function cursor.Full(selfCursor: any, t: number): (number, number, number, number, number, number, number)
		if selfCursor.LastT ~= t - 1 then
			selfCursor:Seek(t)
		end
		local o = selfCursor.LastMid
		local c, news = mid(t)
		local inst: Inst? = engine.Insts[i]
		selfCursor.LastT = t
		selfCursor.LastMid = c
		if inst == nil then
			return o, o, o, o, 0, 0, 0
		end
		local spec = inst.Spec
		shared(engine, fs, t)
		local _, sigma1s = classAt(spec, t)
		return candle(engine, i, t, o, c, fs.MemoR, if spec.Etf then spec.Sigma1s else sigma1s, spec.VolBase, news)
	end

	function cursor.Candle(selfCursor: any, t: number): (number, number, number, number)
		local o, h, l, c = selfCursor:Full(t)
		return o, h, l, c
	end

	cursor:Seek(t0)
	return cursor
end

return PriceEngine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">QuoteStream</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Ein Frame für alle (Server/Market/QuoteStream)
--  Besitzer: WP3 (Markt-Engine). Vertrag: MARKET.md §10.2/§10.3, DESIGN.md §C8 (MarketFrame), §C16 (0,44 KB/s).
--  Je Markt-Takt genau EIN FireAllClients(buffer) mit dem neuesten Tick: 9 + 10·n Byte (43 Instrumente = 439 B,
--  mit 4 IPOs 479 B). Absolute Kurse (keine Deltas) -> ein verlorener Frame zerstört nichts.
--  Angst-&-Gier-Index, Heatmap, Ticker-Wände rechnet jeder Client selbst aus dem Frame.
--
--  Öffentliche API (nur WP3)
--    QuoteStream.Build(tick, src): (buffer, number)    src = { Ids, Candle(i), Halted(i), News(i), ExDay(i),
--                                                       WeekHigh(i), Regime, AnyHalt, Admin, Crash, Rally }
--    QuoteStream.Broadcast(remote, tick, src): number   kodiert einmal, feuert einmal; Rückgabe: Byte
--    QuoteStream.LastSize(): number
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local QuoteCodec = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Market"):WaitForChild("QuoteCodec"))

local QuoteStream = {}

local FRAME = QuoteCodec.FRAME_FLAGS
local ROW = QuoteCodec.ROW_FLAGS

local lastSize = 0

export type Source = {
	Ids: { number },
	Candle: (i: number) -> (number?, number?, number?, number?, number?, number?, number?),
	Halted: (i: number) -> boolean,
	News: (i: number) -> boolean,
	ExDay: (i: number) -> boolean,
	WeekHigh: (i: number) -> number,
	Regime: number,
	AnyHalt: boolean,
	Admin: boolean,
	Crash: boolean,
	Rally: boolean,
}

function QuoteStream.Build(tick: number, src: Source): (buffer, number)
	local rows: { QuoteCodec.QuoteRow } = {}
	for _, i in ipairs(src.Ids) do
		local _, _, _, c, v, hiOff, loOff = src.Candle(i)
		if c and c > 0 then
			local flags = 0
			if src.Halted(i) then
				flags += ROW.Halt
			end
			if src.News(i) then
				flags += ROW.News
			end
			if src.ExDay(i) then
				flags += ROW.ExDay
			end
			local high = src.WeekHigh(i)
			if high > 0 and c >= high then
				flags += ROW.WeekHigh
			end
			table.insert(rows, {
				Id = i,
				Flags = flags,
				Close = c,
				HiOff = hiOff or 0,
				LoOff = loOff or 0,
				Vol = v or 0,
			})
		end
	end
	local frameFlags = 0
	if src.AnyHalt then
		frameFlags += FRAME.Halt
	end
	if src.Admin then
		frameFlags += FRAME.Admin
	end
	if src.Crash then
		frameFlags += FRAME.Crash
	end
	if src.Rally then
		frameFlags += FRAME.Rally
	end
	local buf = QuoteCodec.EncodeFrame(tick, frameFlags, src.Regime, rows)
	return buf, #rows
end

function QuoteStream.Broadcast(remote: RemoteEvent?, tick: number, src: Source): number
	local buf = QuoteStream.Build(tick, src)
	lastSize = buffer.len(buf)
	if remote then
		remote:FireAllClients(buf)
	end
	return lastSize
end

function QuoteStream.LastSize(): number
	return lastSize
end

return QuoteStream
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="80">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Admin-Panel, Server-Seite (Server/Services/AdminService)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Vertrag: DESIGN.md §B15 (Zugriff, 11 Tabs, Admin-Abuse-Katalog),
--  §C5.10, §C8 (Remote "Admin"), §C11.2 (Admin-Insider: Besitzer-Trades ±120 s), §C13 (AT_Mod_v1, AT_Global, AT_Live_v1,
--  AT_Stats_v1, AT_Heartbeat, Messaging "AT_Global"). Basis: CLUTCH-CLASH-AdminService (REUSE §3.13 ADAPT): Owner-Regel,
--  Cache + Attribut IsAdmin, Rate-Limit VOR der Prüfung, Ablehnung 1× geloggt, dispatch mit p.Parent-Guard, Ziele
--  (me/all/others/Name/Präfix/UserId), Bann-Regeln, Ansage (gefiltert), publishGlobal/handleGlobal mit oberer Zeitgrenze
--  und Dedupe. Shooter-Teile sind entfernt; Markt-Aktionen laufen NUR über MarketService.Admin (GlobalBus, Admin-Fenster).
--
--  NUR DER BESITZER IST ADMIN (§B15.1, exakt):
--    Live, Nutzer-Spiel:   game.CreatorType == User and p.UserId == game.CreatorId and game.CreatorId ~= 0
--    Live, Gruppen-Spiel:  GroupService:GetGroupInfoAsync(game.CreatorId).Owner.Id == p.UserId (pcall, 10 min Cache,
--                          Fehler = kein Admin)
--    Studio:               Config.Admin.StudioIsAdmin and (UserId > 0 or UserId == -1); Player2 (-2) NIE.
--  Niemand kann Admin kaufen. JEDE Aktion prüft den Besitzer erneut (Attribut IsAdmin ist nur Anzeige/Client-Start).
--
--  Remote "Admin": (action, args) -> { Ok, Message, Data }  – Reihenfolge: p.Parent -> Rate 12/s -> Besitzer -> Aktion.
--  Jede Aktion -> Admin-Log (AT_Mod_v1 "AdminLog", letzte 500, Kopie AT_Global "AdminLog_W<w>").
--  Markt-Aktionen: MarketService.Admin (3 s Abklingzeit dort), Besitzer hat in den letzten 120 s gehandelt -> abgelehnt;
--  danach sind Besitzer-Trades bis 120 s nach dem Event-Start gesperrt (OwnerTradeBlocked, OrderService fragt).
--  Globale Nachrichten (MessagingService Config.Tech.MessagingTopic, Sender empfängt selbst): Announce {Text, UserId,
--  Name, Id}, AdminAbuse {Event, Args, StartAt, Until, Id, By}, Live {Version, Id}. Jedes Feld geprüft,
--  Until ≤ now + Config.Events.MaxGlobalSeconds, Dedupe per Id (letzte 200). Fehler beim Senden -> nur dieser Server.
--
--  Öffentliche API (§C5.10):
--    AdminService.IsAdmin(p): boolean                 AdminService.Power(p, name): any   (nil, wenn kein Admin)
--    AdminService.IsServerLocked(): boolean           AdminService.OwnerTradeBlocked(p): boolean   (±120 s)
--  Ergänzungen (WP11-intern):
--    AdminService.PublishAbuse(kind, args, by): (boolean, "global" | "local")   globales Nicht-Markt-Event senden
--    AdminService.Core: { OwnerRule, MarketArgs, ValidateGlobal, NewDedupe, TradeBlocked, TradeLockBefore }  (rein)
-- =====================================================================

local DataStoreService = game:GetService("DataStoreService")
local GroupService = game:GetService("GroupService")
local MemoryStoreService = game:GetService("MemoryStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Lang = require(Shared:WaitForChild("Lang"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))
local Clock = require(Shared:WaitForChild("Clock"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local AdminService = {}
local Services: any = nil

type Plain = { [string]: any }
type Action = (admin: Player, args: Plain) -> (boolean, string, any?)

local SEC: any = Config.Security
local EV: any = Config.Events
local MAX_NAME = 40
local MAX_REASON = 200
local MAX_LIST = 100
local MAX_TARGET_TEXT = 60
local MAX_ACTION_LEN = 40
local MAX_GIVE_CREDITS = 1e12
local MAX_GIVE_AKY = 1e9 -- ganze AKY je Gabe (× 100 = Cent)
local LOG_FLUSH_SECONDS = 60
local LOG_MSG_MAX = 140
local HEARTBEAT_SECONDS = 30
local HEARTBEAT_TTL = 60
local HEARTBEAT_CACHE = 30
local STATS_SAMPLE_SECONDS = 30
local LIVE_KEY = "Live"
local LIVE_RELOAD_GAP = 2
local MARKET_TRADE_WINDOW = 60 -- Sekunden, über die "Fills/min" gezählt wird
local MAX_TRADED_KEYS = 64
local MAX_OWNER_EVENTS = 16
local BANNER_MAX = 120
local MAINTENANCE_ATTR = "AT_Maintenance"
-- Speed-Geschenk (Wunsch 18): Spieler-Attribute, die NUR der Server setzt (AntiCheatService liest sie mit)
local GIFT_SPEED = "GiftSpeed"
local GIFT_JUMP = "GiftJump"
local GIFT_UNTIL = "GiftUntil"
local DEFAULT_JUMP = 7.2

-- Kräfte (§B15.2 "Kräfte"): "bool" = an/aus, sonst { Min, Max } aus Config.Security.Powers
local POWERS: { [string]: string } = {
	CanFly = "bool",
	AdminNoclip = "bool",
	AdminSpeed = "Speed",
	AdminJump = "Jump",
	AdminInvisible = "bool",
	AdminESP = "bool",
}

-- Aktionen, die nicht ins Output geloggt werden (Abfragen; F8-Anzeige pollt jede Sekunde)
local QUIET: { [string]: boolean } = {
	GetPlayers = true,
	ServerInfo = true,
	Dashboard = true,
	Stats = true,
	Flags = true,
	Reports = true,
	BanList = true,
	BanHistory = true,
	PlayerData = true,
	Receipts = true,
	AdminLog = true,
	LiveGet = true,
	MarketLog = true,
}

-- Katalog-Schlüssel -> MarketService.Admin-Aktion (Types.MarketEvent.Kind)
local MARKET_ACTIONS: { [string]: string } = {
	MegaRally = "Rally",
	MegaCrash = "Crash",
	Pump = "Pump",
	Dump = "Dump",
	News = "News",
	Halt = "Halt",
	Resume = "Resume",
	Ipo = "Ipo",
	Vol = "Vol",
	Normalize = "Normalize",
}
local SECTOR_KEYS: { [string]: boolean } = { T = true, E = true, M = true, K = true, G = true, F = true }

-- ---------------------------------------------------------------------
-- ZUSTAND (Pro-Spieler-Tabellen werden bei PlayerRemoving geleert)
-- ---------------------------------------------------------------------
local rate = SEC.Rates and SEC.Rates.Admin or { 12, 1 }
local limiter = Util.RateLimiter(rate[1] or 12, rate[2] or 1)
local adminCache: { [Player]: boolean } = {}
local warnedDenied: { [Player]: boolean } = {}
local joinedAt: { [Player]: number } = {}
local invisConn: { [Player]: RBXScriptConnection } = {}
local ownerEvents: { [Player]: { { Issued: number, Start: number } } } = {}
local ownerLastTrade: { [Player]: number } = {}
local purchaseSeen: { [Player]: { Robux: number, Receipts: number } } = {}

local serverLocked = false
local startedAt = os.clock()
local groupOwner: { Id: number, At: number }? = nil
local groupLoading = false
local heartbeatOff = false
local heartbeatCache: { At: number, Players: number, Servers: number }? = nil
local liveDoc: Plain = { Fields = {}, Version = 0 }
local liveReloadAt = -math.huge
local announceAt = -math.huge

local adminLog: { Plain } = {}
local logPending: { Plain } = {}
local storedLog: { List: { Plain }, At: number }? = nil
local tradeTimes: { number } = {}
local tradedCount: { [string]: number } = {}
local tradedKeys = 0
local statsPending = { Robux = 0, Count = 0 }
local statsCache: { At: number, Data: Plain }? = nil
local storeOff: { [string]: boolean } = {}

local Actions: { [string]: Action } = {}

-- =====================================================================
-- REINE KERN-FUNKTIONEN (AdminTests)
-- =====================================================================
local Core = {}

-- Besitzer-Regel (§B15.1). info = { CreatorType = "User" | "Group", CreatorId, UserId, Studio, GroupOwnerId?, Cfg }
function Core.OwnerRule(info: Plain): boolean
	local cfg: Plain = if type(info.Cfg) == "table" then info.Cfg else {}
	local userId = info.UserId
	if not Util.IsFinite(userId) or userId % 1 ~= 0 then
		return false
	end
	if userId == -2 then
		return false -- Player2 im Studio-Test: NIE Admin (Ablehnungspfad testbar)
	end
	local creatorId = info.CreatorId
	if Util.IsFinite(creatorId) and creatorId ~= 0 then
		if info.CreatorType == "User" and cfg.OwnerIsAdmin ~= false and userId == creatorId then
			return true
		end
		if info.CreatorType == "Group" and cfg.GroupOwnerIsAdmin ~= false then
			local owner = info.GroupOwnerId
			if Util.IsFinite(owner) and owner ~= 0 and owner == userId then
				return true
			end
		end
	end
	if info.Studio == true and cfg.StudioIsAdmin == true then
		if userId > 0 or userId == -1 then
			return true
		end
		return cfg.StudioAllPlayersAdmin == true and userId ~= -2
	end
	return false
end

local function clampNum(value: any, lo: number, hi: number, default: number): number
	local n = tonumber(value)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		n = default
	end
	return math.clamp(n :: number, lo, hi)
end

local function cleanText(value: any, max: number): string?
	if type(value) ~= "string" then
		return nil
	end
	local text = string.gsub(value, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	local len = utf8.len(text)
	if not len or len < 1 or len > max then
		return nil
	end
	return text
end

local function isInt(n: any): boolean
	return Util.IsFinite(n) and n % 1 == 0
end

-- Markt-Parameter klemmen (§B15.3). Gibt (Aktion für MarketService.Admin, Argumente) oder (nil, nil, Fehler-Schlüssel).
function Core.MarketArgs(kind: string, args: any, limits: Plain?): (string?, Plain?, string?)
	local action = MARKET_ACTIONS[kind]
	if not action then
		return nil, nil, "admin.evUnknown"
	end
	local raw: Plain = if type(args) == "table" then args else {}
	local lim: Plain = limits or EV.AdminLimits
	local out: Plain = {}
	local function scope(allowAll: boolean): boolean
		local s = raw.Scope
		if (s == "All" or s == nil) and allowAll then
			out.Scope = "All"
			return true
		elseif s == "Sector" then
			if type(raw.Target) ~= "string" or not SECTOR_KEYS[raw.Target] then
				return false
			end
			out.Scope = "Sector"
			out.Target = raw.Target
			return true
		elseif s == "Inst" then
			if not isInt(raw.Target) or raw.Target < 1 or raw.Target > 999 then
				return false
			end
			out.Scope = "Inst"
			out.Target = raw.Target
			return true
		end
		return false
	end
	local strength = lim.MarketStrength
	local ramp = lim.Ramp
	local decay = lim.DecayMinutes
	if action == "Crash" or action == "Rally" then
		if not scope(true) then
			return nil, nil, "admin.badScope"
		end
		out.Strength = math.floor(clampNum(raw.Strength, strength[1], strength[2], strength[1]) + 0.5)
		out.Ramp = math.floor(clampNum(raw.Ramp, ramp[1], ramp[2], ramp[1]))
		out.Decay = math.floor(clampNum(raw.Decay, decay[1], decay[2], decay[1]))
		if action == "Crash" and raw.Warn == true then
			out.Warn = true
		end
	elseif action == "Pump" or action == "Dump" then
		if not isInt(raw.Target) or raw.Target < 1 or raw.Target > 999 then
			return nil, nil, "admin.badTarget"
		end
		out.Target = raw.Target
		out.Strength = math.floor(clampNum(raw.Strength, strength[1], strength[2], strength[1]) + 0.5)
		out.Ramp = math.floor(clampNum(raw.Ramp, ramp[1], ramp[2], ramp[1]))
		out.Decay = math.floor(clampNum(raw.Decay, decay[1], decay[2], decay[1]))
	elseif action == "News" then
		if raw.Scope ~= "Inst" and raw.Scope ~= "Sector" then
			return nil, nil, "admin.badScope"
		end
		if not scope(false) then
			return nil, nil, "admin.badScope"
		end
		local band = lim.NewsBand
		out.Band = math.floor(clampNum(raw.Band, band[1], band[2], 2))
		out.Dir = if tonumber(raw.Dir) and (tonumber(raw.Dir) :: number) < 0 then -1 else 1
		local maxChars = math.floor(tonumber(lim.NewsChars) or 80)
		local text = raw.Text
		if type(text) ~= "table" then
			return nil, nil, "admin.newsText"
		end
		local de = cleanText(text.de, maxChars)
		local en = cleanText(text.en, maxChars) or de
		if not de or not en then
			return nil, nil, "admin.newsText"
		end
		out.Text = { de = de, en = en }
	elseif action == "Halt" then
		if raw.Scope == "Inst" then
			if not scope(false) then
				return nil, nil, "admin.badTarget"
			end
		else
			out.Scope = "All"
		end
		local r = lim.HaltSeconds
		out.Seconds = math.floor(clampNum(raw.Seconds, r[1], r[2], 60))
	elseif action == "Resume" then
		if raw.Scope == "Inst" and isInt(raw.Target) then
			out.Scope = "Inst"
			out.Target = raw.Target
		else
			out.Scope = "All"
		end
	elseif action == "Ipo" then
		if not isInt(raw.Target) or raw.Target < 1 or raw.Target > 999 then
			return nil, nil, "admin.badTarget"
		end
		out.Target = raw.Target
	elseif action == "Vol" then
		local v, m = lim.Vol, lim.VolMinutes
		out.Strength = math.floor(clampNum(raw.Strength, v[1], v[2], 1.5) * 10 + 0.5) / 10
		out.Minutes = math.floor(clampNum(raw.Minutes, m[1], m[2], m[1]))
	end
	return action, out, nil
end

-- Globale Nachricht feldweise prüfen (obere Zeitgrenze!). Gibt eine saubere Kopie oder nil.
function Core.ValidateGlobal(msg: any, now: number, maxSeconds: number): Plain?
	if type(msg) ~= "table" then
		return nil
	end
	local id = msg.Id
	if type(id) ~= "string" or #id < 4 or #id > 64 then
		return nil
	end
	local kind = msg.Kind
	if kind == "Announce" then
		local text = cleanText(msg.Text, ((tonumber(SEC.AnnounceMax) or 200) * 3))
		local name = cleanText(msg.Name, MAX_NAME)
		local userId = msg.UserId
		if not text or not name or not isInt(userId) then
			return nil
		end
		return { Kind = "Announce", Id = id, Text = text, Name = name, UserId = userId }
	elseif kind == "AdminAbuse" then
		if type(msg.Event) ~= "string" or #msg.Event > 40 then
			return nil
		end
		local startAt, untilT = msg.StartAt, msg.Until
		if not Util.IsFinite(startAt) or not Util.IsFinite(untilT) then
			return nil
		end
		if untilT <= now or untilT > now + maxSeconds or startAt > untilT or startAt > now + maxSeconds then
			return nil
		end
		local by = if isInt(msg.By) then msg.By else 0
		local args: Plain = {}
		if type(msg.Args) == "table" then
			local count = 0
			for key, value in pairs(msg.Args) do
				count += 1
				if count > 12 then
					break
				end
				if type(key) == "string" and #key <= 24 and (Util.IsFinite(value) or type(value) == "boolean") then
					args[key] = value
				end
			end
		end
		return {
			Kind = "AdminAbuse",
			Id = id,
			Event = msg.Event,
			Args = args,
			StartAt = startAt,
			Until = untilT,
			By = by,
		}
	elseif kind == "Live" then
		if not isInt(msg.Version) or msg.Version < 0 then
			return nil
		end
		return { Kind = "Live", Id = id, Version = msg.Version }
	elseif kind == "AbuseNote" then
		-- Besitzer-Ansage zu einem Admin-Abuse-Event (Avatar + Haken, Text je Empfänger lokalisiert)
		local event = msg.Event
		local name = cleanText(msg.Name, MAX_NAME)
		if type(event) ~= "string" or #event < 1 or #event > 40 or not string.match(event, "^%w+$") then
			return nil
		end
		if not name or not isInt(msg.UserId) then
			return nil
		end
		return { Kind = "AbuseNote", Id = id, Event = event, UserId = msg.UserId, Name = name }
	end
	return nil
end

-- Dedupe der letzten n Ids (Ring). Seen(id) = true, wenn die Id schon da war (dann verwerfen).
function Core.NewDedupe(n: number): { Seen: (id: string) -> boolean, Size: () -> number }
	local limit = math.max(1, math.floor(n))
	local set: { [string]: boolean } = {}
	local order: { string } = {}
	return {
		Seen = function(id: string): boolean
			if set[id] then
				return true
			end
			set[id] = true
			table.insert(order, id)
			while #order > limit do
				local old = table.remove(order, 1)
				if old then
					set[old] = nil
				end
			end
			return false
		end,
		Size = function(): number
			return #order
		end,
	}
end

-- Besitzer-Handelssperre: ab dem Auslösen bis seconds nach dem Event-Start
function Core.TradeBlocked(list: { { Issued: number, Start: number } }, now: number, seconds: number): boolean
	for _, entry in ipairs(list) do
		if now >= entry.Issued - 1 and now <= entry.Start + seconds then
			return true
		end
	end
	return false
end

-- Markt-Event ablehnen, wenn der Besitzer in den letzten "seconds" gehandelt hat (die "−120 s"-Hälfte)
function Core.TradeLockBefore(lastTrade: number?, now: number, seconds: number): boolean
	return lastTrade ~= nil and now - lastTrade < seconds
end

AdminService.Core = Core

-- =====================================================================
-- HELFER
-- =====================================================================
local function service(name: string): any
	return if Services then Services[name] else nil
end

local function has(name: string, fnName: string): boolean
	local svc = service(name)
	return type(svc) == "table" and type(svc[fnName]) == "function"
end

-- Services.<name>.<fn>(...) in pcall. (ok, Ergebnis …); fehlt der Dienst -> false
local function call(name: string, fnName: string, ...: any): (boolean, ...any)
	local svc = service(name)
	local fn = if type(svc) == "table" then svc[fnName] else nil
	if type(fn) ~= "function" then
		return false
	end
	local result = table.pack(pcall(fn, ...))
	if not result[1] then
		warn(("[Admin] %s.%s fehlgeschlagen: %s"):format(name, fnName, tostring(result[2])))
	end
	return table.unpack(result, 1, result.n)
end

local function langOf(p: Player): Types.Lang
	local ok, lang = call("PlayerStateService", "LangOf", p)
	if ok and (lang == "de" or lang == "en") then
		return lang
	end
	return Lang.For(p)
end

local function L(p: Player, key: string, ...: any): string
	return Lang.T(langOf(p), key, ...)
end

local function now(): number
	return Clock.Now()
end

local function truncate(text: string, maxBytes: number): string
	if #text <= maxBytes then
		return text
	end
	local cut = maxBytes
	for _ = 1, 4 do
		if cut <= 0 or utf8.len(string.sub(text, 1, cut)) ~= nil then
			break
		end
		cut -= 1
	end
	return string.sub(text, 1, math.max(0, cut))
end

local function names(list: { Player }): string
	local out: { string } = {}
	for i, p in ipairs(list) do
		if i > 8 then
			table.insert(out, ("+%d"):format(#list - 8))
			break
		end
		table.insert(out, p.DisplayName)
	end
	return table.concat(out, ", ")
end

local function rootOf(p: Player): BasePart?
	local character = p.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function footOf(p: Player): CFrame?
	local root = rootOf(p)
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return nil
	end
	local offset = if humanoid.RigType == Enum.HumanoidRigType.R6
		then root.Size.Y * 0.5 + 2
		else humanoid.HipHeight + root.Size.Y * 0.5
	return root.CFrame - Vector3.new(0, offset, 0)
end

local function effect(p: Player, name: string, strength: number, data: any?)
	call("PlayerStateService", "Effect", p, name, strength, data)
end

local function effectAll(name: string, strength: number, data: any?)
	call("PlayerStateService", "EffectAll", name, strength, data)
end

local function filterBroadcast(text: string, fromUserId: number): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, fromUserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(result) == "string" then
		return result
	end
	return nil
end

local function utcDay(): number
	return math.floor(os.time() / 86400)
end

local function dateKey(day: number): string
	return os.date("!%Y%m%d", day * 86400) :: string
end

local function shard(): number
	local count = math.max(1, math.floor(tonumber(Config.Tech.Shards) or 8))
	return Util.Hash(game.JobId) % count
end

local guidCounter = 0
local function newId(prefix: string): string
	guidCounter += 1
	return ("%s%x_%x_%x"):format(prefix, os.time(), Util.Hash(game.JobId .. tostring(guidCounter)), guidCounter)
end

local function noApi(err: any): boolean
	local text = string.lower(tostring(err))
	return RunService:IsStudio()
		and (
			string.find(text, "studio", 1, true) ~= nil
			or string.find(text, "publish", 1, true) ~= nil
			or string.find(text, "api services", 1, true) ~= nil
			or string.find(text, "403", 1, true) ~= nil
		)
end

-- DataStore-Zugriff mit "aus"-Schalter je Speicher (Studio ohne API: leise lokal)
local function storeCall(storeName: string, fn: (DataStore) -> any): (boolean, any)
	if storeOff[storeName] then
		return false, "off"
	end
	local ok, result = pcall(function()
		return fn(DataStoreService:GetDataStore(storeName))
	end)
	if not ok then
		if noApi(result) then
			storeOff[storeName] = true
		else
			warn(("[Admin] DataStore %s: %s"):format(storeName, tostring(result)))
		end
	end
	return ok, result
end

-- =====================================================================
-- BESITZER-PRÜFUNG (§B15.1)
-- =====================================================================
local function creatorTypeName(): string
	if game.CreatorType == Enum.CreatorType.Group then
		return "Group"
	end
	return "User"
end

-- Gruppen-Besitzer im Hintergrund laden (yieldet; Ergebnis 10 min gecacht, Fehler = kein Admin)
local function refreshGroupOwner()
	if groupLoading or creatorTypeName() ~= "Group" or game.CreatorId == 0 then
		return
	end
	local cacheSeconds = tonumber(SEC.GroupOwnerCacheSeconds) or 600
	local cached = groupOwner
	if cached and os.clock() - cached.At < cacheSeconds then
		return
	end
	groupLoading = true
	task.spawn(function()
		local ok, info = pcall(function()
			return GroupService:GetGroupInfoAsync(game.CreatorId)
		end)
		groupLoading = false
		local ownerId = 0
		if ok and type(info) == "table" and type(info.Owner) == "table" and isInt(info.Owner.Id) then
			ownerId = info.Owner.Id
		elseif not ok then
			warn("[Admin] GetGroupInfoAsync fehlgeschlagen (kein Admin bis zum nächsten Versuch): " .. tostring(info))
		end
		groupOwner = { Id = ownerId, At = os.clock() }
		-- Spieler neu bewerten (Attribut IsAdmin nachziehen)
		for _, p in ipairs(Players:GetPlayers()) do
			adminCache[p] = nil
			local isAdmin = AdminService.IsAdmin(p)
			p:SetAttribute("IsAdmin", if isAdmin then true else nil)
			if isAdmin and p:GetAttribute("CanFly") == nil then
				p:SetAttribute("CanFly", true)
			end
		end
	end)
end

local function computeAdmin(p: Player): boolean
	local owner = groupOwner
	return Core.OwnerRule({
		CreatorType = creatorTypeName(),
		CreatorId = game.CreatorId,
		UserId = p.UserId,
		Studio = RunService:IsStudio(),
		GroupOwnerId = if owner then owner.Id else nil,
		Cfg = Config.Admin,
	})
end

-- Nie yielden (AntiCheat/PlotService fragen aus Takten): nur Cache + nicht-yieldende Regel
function AdminService.IsAdmin(p: Player): boolean
	if typeof(p) ~= "Instance" or not p:IsA("Player") then
		return false
	end
	local cached = adminCache[p]
	if cached == nil then
		cached = computeAdmin(p)
		if p.Parent == Players then
			adminCache[p] = cached
		end
	end
	return cached == true
end

function AdminService.Power(p: Player, name: string): any
	if type(name) ~= "string" or not AdminService.IsAdmin(p) then
		return nil
	end
	return p:GetAttribute(name)
end

function AdminService.IsServerLocked(): boolean
	return serverLocked
end

function AdminService.OwnerTradeBlocked(p: Player): boolean
	if typeof(p) ~= "Instance" or not AdminService.IsAdmin(p) then
		return false
	end
	local list = ownerEvents[p]
	if not list or #list == 0 then
		return false
	end
	return Core.TradeBlocked(list, now(), tonumber(SEC.OwnerTradeBlockSeconds) or 120)
end

-- =====================================================================
-- ZIELE ("me", "all", "others", Name, Präfix, UserId)
-- =====================================================================
local function resolveTargets(admin: Player, text: any): { Player }
	if type(text) == "number" then
		text = tostring(text)
	end
	if type(text) ~= "string" then
		return { admin }
	end
	text = string.sub(text, 1, MAX_TARGET_TEXT)
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	local lower = string.lower(text)
	if lower == "" or lower == "me" then
		return { admin }
	end
	if lower == "all" then
		return Players:GetPlayers()
	end
	if lower == "others" then
		local list: { Player } = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= admin then
				table.insert(list, p)
			end
		end
		return list
	end
	local userId = tonumber(text)
	if userId and userId % 1 == 0 then
		local byId = Players:GetPlayerByUserId(userId)
		if byId then
			return { byId }
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == lower or string.lower(p.DisplayName) == lower then
			return { p }
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if
			string.sub(string.lower(p.Name), 1, #lower) == lower
			or string.sub(string.lower(p.DisplayName), 1, #lower) == lower
		then
			return { p }
		end
	end
	return {}
end

local function resolveOne(admin: Player, text: any): (Player?, string?)
	local list = resolveTargets(admin, text)
	if #list == 0 then
		return nil, L(admin, "admin.noTarget")
	elseif #list > 1 then
		return nil, L(admin, "admin.oneTarget")
	end
	return list[1], nil
end

local function isOwnerId(userId: number): boolean
	if creatorTypeName() == "User" then
		return game.CreatorId ~= 0 and userId == game.CreatorId
	end
	local owner = groupOwner
	return owner ~= nil and owner.Id ~= 0 and owner.Id == userId
end

-- Andere Admins/Besitzer sind vor Kick/Bann geschützt
local function protectedPlayer(p: Player): boolean
	return isOwnerId(p.UserId) or AdminService.IsAdmin(p)
end

-- =====================================================================
-- ADMIN-LOG (AT_Mod_v1 "AdminLog", letzte 500 + Wochen-Kopie AT_Global "AdminLog_W<w>")
-- =====================================================================
local function logAction(p: Player, action: string, ok: boolean, message: string?)
	local entry = {
		T = os.time(),
		By = p.UserId,
		Name = string.sub(p.Name, 1, MAX_NAME),
		Action = string.sub(action, 1, MAX_ACTION_LEN),
		Ok = ok,
		Msg = truncate(tostring(message or ""), LOG_MSG_MAX),
		Job = string.sub(if game.JobId ~= "" then game.JobId else "Studio", 1, 12),
	}
	table.insert(adminLog, entry)
	local max = math.floor(tonumber(SEC.AdminLogMax) or 500)
	while #adminLog > max do
		table.remove(adminLog, 1)
	end
	table.insert(logPending, entry)
	while #logPending > max do
		table.remove(logPending, 1)
	end
end

local function flushLog()
	if #logPending == 0 then
		return
	end
	local batch = table.clone(logPending)
	table.clear(logPending)
	task.spawn(function()
		local max = math.floor(tonumber(SEC.AdminLogMax) or 500)
		local function merge(old: any): { Plain }
			local list: { Plain } = if type(old) == "table" then old else {}
			for _, entry in ipairs(batch) do
				table.insert(list, entry)
			end
			while #list > max do
				table.remove(list, 1)
			end
			return list
		end
		local okMod = storeCall(Config.Tech.ModStore, function(store)
			return store:UpdateAsync("AdminLog", merge)
		end)
		local week = Clock.WeekIndex(Clock.Tick())
		storeCall(Config.Tech.GlobalStore or "AT_Global", function(store)
			return store:UpdateAsync(("AdminLog_W%d"):format(week), merge)
		end)
		if okMod then
			storedLog = nil
		end
	end)
end

local function readLog(): { Plain }
	local cached = storedLog
	local list: { Plain } = {}
	if cached and os.clock() - cached.At < 30 then
		list = cached.List
	else
		local ok, stored = storeCall(Config.Tech.ModStore, function(store)
			return store:GetAsync("AdminLog")
		end)
		if ok and type(stored) == "table" then
			for _, entry in ipairs(stored) do
				if type(entry) == "table" and Util.IsFinite(entry.T) then
					table.insert(list, entry)
				end
			end
		end
		storedLog = { List = list, At = os.clock() }
	end
	local merged: { Plain } = {}
	local seen: { [string]: boolean } = {}
	local function add(entry: Plain)
		local key = ("%s_%s_%s_%s"):format(
			tostring(entry.T),
			tostring(entry.By),
			tostring(entry.Action),
			tostring(entry.Job)
		)
		if not seen[key] then
			seen[key] = true
			table.insert(merged, entry)
		end
	end
	for _, entry in ipairs(list) do
		add(entry)
	end
	for _, entry in ipairs(adminLog) do
		add(entry)
	end
	table.sort(merged, function(a, b)
		return (tonumber(a.T) or 0) > (tonumber(b.T) or 0)
	end)
	local max = math.floor(tonumber(SEC.AdminLogMax) or 500)
	while #merged > max do
		table.remove(merged)
	end
	return merged
end

-- =====================================================================
-- GLOBALE NACHRICHTEN (MessagingService, jedes Feld geprüft, Dedupe)
-- =====================================================================
local dedupe = Core.NewDedupe(tonumber(EV.GlobalDedupe) or tonumber(SEC.GlobalDedupe) or 200)

local applyLiveDoc: (doc: any) -> number
local loadLive: () -> ()

local function showAnnouncement(text: string, userId: number, name: string)
	effectAll("Announce", 0, { Text = text, UserId = userId, Name = name })
end

-- Admin-Abuse-Ansage im Besitzer-Stil (Avatar + blauer Haken, ohne Kasten), je Empfänger in seiner Sprache
local function showAbuseNote(event: string, userId: number, name: string)
	local key = "admin.note." .. event
	local known = Lang.Has(key)
	for _, p in ipairs(Players:GetPlayers()) do
		local lang = langOf(p)
		local text = if known
			then Lang.T(lang, key)
			else Lang.T(lang, "admin.note.Generic", Lang.T(lang, "admin.ev." .. event))
		effect(p, "Announce", 0, { Text = text, UserId = userId, Name = name })
	end
end

local function handleGlobal(message: any)
	local clean = Core.ValidateGlobal(message, now(), tonumber(EV.MaxGlobalSeconds) or 3600)
	if not clean then
		return
	end
	if dedupe.Seen(clean.Id) then
		return
	end
	if clean.Kind == "Announce" then
		showAnnouncement(clean.Text, clean.UserId, clean.Name)
	elseif clean.Kind == "AbuseNote" then
		showAbuseNote(clean.Event, clean.UserId, clean.Name)
	elseif clean.Kind == "AdminAbuse" then
		call("EventService", "ApplyGlobal", clean)
	elseif clean.Kind == "Live" then
		if clean.Version > (tonumber(liveDoc.Version) or 0) and os.clock() - liveReloadAt >= LIVE_RELOAD_GAP then
			liveReloadAt = os.clock()
			task.spawn(loadLive)
		end
	end
end

-- Global senden; Fehler -> wenigstens auf diesem Server. Auch bei Erfolg sofort lokal ausführen: MessagingService
-- liefert nur "best effort" (das Echo an den Sender kann fehlen, im Studio scheitert oft schon SubscribeAsync) –
-- das Dedupe per Id verwirft das spätere Echo, nichts läuft doppelt.
local function publishGlobal(message: Plain): boolean
	local ok, err = pcall(function()
		MessagingService:PublishAsync(Config.Tech.MessagingTopic, message)
	end)
	if not ok then
		warn("[Admin] Global senden fehlgeschlagen (nur dieser Server): " .. tostring(err))
	end
	handleGlobal(message)
	return ok
end

-- Ansage zu einem Admin-Abuse-Event: global (alle Server) oder nur dieser Server
local function announceAbuse(admin: Player, event: string, global: boolean)
	local message = {
		Kind = "AbuseNote",
		Id = newId("B"),
		Event = event,
		UserId = admin.UserId,
		Name = string.sub(admin.DisplayName, 1, MAX_NAME),
	}
	if global then
		publishGlobal(message)
	else
		handleGlobal(message)
	end
end

local function abuseSeconds(kind: string, args: Plain): number
	local limits = EV.AdminLimits
	if kind == "GoldenHour" or kind == "XpRush" then
		return (tonumber(args.Minutes) or 5) * 60
	elseif kind == "MoneyRain" or kind == "Boss" then
		return tonumber(args.Seconds) or 120
	elseif kind == "AdminBuildBoom" then
		return (tonumber(limits.BuildBoom.Minutes) or 10) * 60
	elseif kind == "SaturdayShow" then
		local show = limits.SaturdayShow
		return math.max(
			(tonumber(show.RainDelay) or 75) + (tonumber(show.RainSeconds) or 180),
			(tonumber(show.FireworksDelay) or 260) + 20
		)
	end
	return 120
end

function AdminService.PublishAbuse(kind: string, args: Plain, by: Player): (boolean, string)
	if typeof(by) ~= "Instance" or not AdminService.IsAdmin(by) or type(kind) ~= "string" then
		return false, "denied"
	end
	local t = now()
	local lead = tonumber(EV.GlobalLead) or 5
	local seconds = math.clamp(abuseSeconds(kind, if type(args) == "table" then args else {}), 1, 3600 - lead - 1)
	local message = {
		Kind = "AdminAbuse",
		Id = newId("A"),
		Event = kind,
		Args = if type(args) == "table" then args else {},
		StartAt = t + lead,
		Until = t + lead + seconds,
		By = by.UserId,
	}
	if publishGlobal(message) then
		return true, "global"
	end
	return true, "local"
end

-- =====================================================================
-- LIVE-CONFIG (AT_Live_v1, Admin-Tab Live-Ops)
-- =====================================================================
applyLiveDoc = function(doc: any): number
	if type(doc) ~= "table" then
		return 0
	end
	local fields = if type(doc.Fields) == "table" then doc.Fields else {}
	local applied, issues = Config.ApplyLive({ Fields = fields })
	for i = 1, math.min(#issues, 5) do
		warn("[Admin] LiveConfig: " .. tostring(issues[i]))
	end
	local banner = if type(doc.Banner) == "string" then truncate(doc.Banner, BANNER_MAX * 3) else ""
	workspace:SetAttribute(MAINTENANCE_ATTR, if banner ~= "" then banner else nil)
	liveDoc = {
		Fields = fields,
		Banner = banner,
		Version = if isInt(doc.Version) then doc.Version else 0,
		At = if Util.IsFinite(doc.At) then doc.At else 0,
		By = if isInt(doc.By) then doc.By else 0,
	}
	return applied
end

loadLive = function()
	local ok, doc = storeCall(Config.Tech.LiveStore, function(store)
		return store:GetAsync(LIVE_KEY)
	end)
	if ok and type(doc) == "table" then
		applyLiveDoc(doc)
	end
end

-- Neues Live-Dokument prüfen (ApplyLive auf die Kandidaten-Felder), speichern, verteilen
local function saveLive(admin: Player, fields: Plain, banner: string): (boolean, string)
	local applied, issues = Config.ApplyLive({ Fields = fields })
	local candidateCount = 0
	for _ in pairs(fields) do
		candidateCount += 1
	end
	if #issues > 0 or applied ~= candidateCount then
		Config.ApplyLive({ Fields = liveDoc.Fields or {} }) -- zurück auf den gültigen Stand
		return false, L(admin, "admin.liveInvalid", tostring(issues[1] or "?"))
	end
	local version = (tonumber(liveDoc.Version) or 0) + 1
	local doc = { Fields = fields, Banner = banner, Version = version, At = os.time(), By = admin.UserId }
	local okStore = storeCall(Config.Tech.LiveStore, function(store)
		return store:UpdateAsync(LIVE_KEY, function(old)
			if type(old) == "table" and isInt(old.Version) and old.Version >= version then
				doc.Version = old.Version + 1
			end
			return doc
		end)
	end)
	applyLiveDoc(doc)
	if okStore then
		publishGlobal({ Kind = "Live", Id = newId("L"), Version = doc.Version })
		return true, L(admin, "admin.liveSaved", doc.Version)
	end
	return true, L(admin, "admin.liveLocal", doc.Version)
end

-- =====================================================================
-- UNSICHTBAR, EINFRIEREN, TELEPORT
-- =====================================================================
local function setPartInvisible(d: Instance, invisible: boolean)
	if d:IsA("BasePart") or d:IsA("Decal") then
		if invisible then
			if d:GetAttribute("AdminOrigT") == nil then
				d:SetAttribute("AdminOrigT", (d :: any).Transparency)
			end
			(d :: any).Transparency = 1
		else
			local orig = d:GetAttribute("AdminOrigT")
			if orig ~= nil then
				(d :: any).Transparency = orig
				d:SetAttribute("AdminOrigT", nil)
			end
		end
	elseif d:IsA("BillboardGui") then
		if invisible then
			if d:GetAttribute("AdminOrigE") == nil then
				d:SetAttribute("AdminOrigE", d.Enabled)
			end
			d.Enabled = false
		else
			local orig = d:GetAttribute("AdminOrigE")
			if orig ~= nil then
				d.Enabled = orig == true
				d:SetAttribute("AdminOrigE", nil)
			end
		end
	end
end

local function setInvisible(p: Player, invisible: boolean)
	local old = invisConn[p]
	if old then
		old:Disconnect()
		invisConn[p] = nil
	end
	local character = p.Character
	if not character then
		return
	end
	for _, d in ipairs(character:GetDescendants()) do
		setPartInvisible(d, invisible)
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = if invisible
			then Enum.HumanoidDisplayDistanceType.None
			else Enum.HumanoidDisplayDistanceType.Viewer
	end
	if invisible then
		-- später angehängte Teile (Uhr, Accessoires, Namensschild) ebenfalls verstecken
		invisConn[p] = character.DescendantAdded:Connect(function(d)
			setPartInvisible(d, true)
		end)
	end
end

local function freeze(p: Player, on: boolean)
	local root = rootOf(p)
	if not root then
		return
	end
	root.Anchored = on
	if not on then
		pcall(function()
			root:SetNetworkOwner(p)
		end)
	end
end

-- Erst aussteigen lassen: wer im Auto sitzt, würde sonst samt Auto versetzt (Sitz-Schweißung). VehicleService merkt
-- das Aussteigen über den Sitz selbst (Erlaubnis zurück, Ausroll-Gnade). Yieldet höchstens ~0,5 s (Admin-Aktion).
local function unseat(p: Player): boolean
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if not humanoid or not seat then
		return true
	end
	local weld = seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
	humanoid.Sit = false
	for _ = 1, 10 do
		if humanoid.SeatPart == nil then
			break
		end
		task.wait(0.05)
	end
	return humanoid.SeatPart == nil
end

local function teleport(p: Player, cf: CFrame): boolean
	if not unseat(p) then
		return false
	end
	local ok, moved = call("PlotService", "Teleport", p, cf)
	if ok and moved == true then
		return true
	end
	local character = p.Character
	if character then
		local okPivot = pcall(function()
			character:PivotTo(cf + Vector3.new(0, 3, 0))
		end)
		call("AntiCheatService", "NoteTeleport", p, cf + Vector3.new(0, 3, 0))
		return okPivot
	end
	return false
end

-- =====================================================================
-- SPEED-GESCHENK (Wunsch 18): Tempo/Sprungkraft für beliebige Spieler, befristet oder bis zum Zurücksetzen.
-- Der Server setzt Humanoid.WalkSpeed/JumpHeight (repliziert zum Client des Spielers) und die Attribute
-- GiftSpeed/GiftJump/GiftUntil (AntiCheatService erlaubt das Tempo/die Höhe; ein Respawn übernimmt das Geschenk).
-- =====================================================================
local function defaultWalk(): number
	local client: any = Config.Client
	local move = if type(client) == "table" then client.Movement else nil
	return if type(move) == "table" and Util.IsFinite(move.WalkSpeed) then move.WalkSpeed else 16
end

local function giftActive(p: Player): boolean
	return p:GetAttribute(GIFT_SPEED) ~= nil or p:GetAttribute(GIFT_JUMP) ~= nil
end

local function applyGift(p: Player)
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local speed = p:GetAttribute(GIFT_SPEED)
	local jump = p:GetAttribute(GIFT_JUMP)
	humanoid.WalkSpeed = if type(speed) == "number" then speed else defaultWalk()
	humanoid.UseJumpPower = false
	humanoid.JumpHeight = if type(jump) == "number" then jump else DEFAULT_JUMP
end

-- Geschenk beenden: Standardwerte zurück, laufender Schwung/Sprung zählt bis zur Landung nicht als Verstoß
local function clearGift(p: Player, tell: boolean): boolean
	if not giftActive(p) then
		return false
	end
	local oldSpeed = tonumber(p:GetAttribute(GIFT_SPEED)) or defaultWalk()
	call("AntiCheatService", "Grace", p, "Impulse", 2, oldSpeed * 1.25)
	p:SetAttribute(GIFT_SPEED, nil)
	p:SetAttribute(GIFT_JUMP, nil)
	p:SetAttribute(GIFT_UNTIL, nil)
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = defaultWalk()
		humanoid.JumpHeight = DEFAULT_JUMP
	end
	if tell then
		call("PlayerStateService", "Notify", p, "admin.giftEnded", nil, "Info")
	end
	return true
end

-- Abgelaufene Geschenke beenden (1 Hz, kein Yield)
local function expireGifts()
	local t = now()
	for _, p in ipairs(Players:GetPlayers()) do
		local untilT = p:GetAttribute(GIFT_UNTIL)
		if type(untilT) == "number" and t >= untilT then
			clearGift(p, true)
		end
	end
end

-- =====================================================================
-- GABEN (nur Turm-Seite über ShopService.Grant; AKY/Lizenz taint die Liga-Woche)
-- =====================================================================
local function keysOf(list: any): { string }
	local out: { string } = {}
	if type(list) == "table" then
		for _, entry in ipairs(list) do
			if type(entry) == "table" and type(entry.Key) == "string" then
				table.insert(out, entry.Key)
			end
		end
	end
	return out
end

local function cleanKeyList(raw: any, max: number): { string }?
	if type(raw) ~= "table" then
		return nil
	end
	local list: { string } = {}
	for i, key in ipairs(raw) do
		if i > max then
			break
		end
		if type(key) == "string" and #key >= 1 and #key <= 40 and string.match(key, "^[%w_]+$") then
			table.insert(list, key)
		end
	end
	return if #list > 0 then list else nil
end

local function sanitizeGrant(raw: any): Types.Grant?
	if type(raw) ~= "table" then
		return nil
	end
	local grant: Plain = {}
	if Util.IsFinite(raw.Credits) and raw.Credits >= 1 then
		grant.Credits = math.floor(math.min(raw.Credits, MAX_GIVE_CREDITS))
	end
	for _, field in ipairs({ "Cars", "Watches", "Accessories", "Cosmetics", "Titles" }) do
		local list = cleanKeyList(raw[field], 64)
		if list then
			grant[field] = list
		end
	end
	if type(raw.Decor) == "table" then
		local decor: { [string]: number } = {}
		local count = 0
		for key, n in pairs(raw.Decor) do
			count += 1
			if count > 64 then
				break
			end
			if type(key) == "string" and #key <= 40 and Util.IsFinite(n) and n >= 1 then
				decor[key] = math.floor(math.min(n, 99))
			end
		end
		if next(decor) ~= nil then
			grant.Decor = decor
		end
	end
	local numberMax = Config.Shop and Config.Shop.GrantNumberMax or {}
	for _, field in ipairs({ "BoostX2", "BoostX5", "ExpressTokens", "InstantTokens", "SeasonTiers", "SeasonXp" }) do
		local v = raw[field]
		if Util.IsFinite(v) and v >= 1 then
			local cap = tonumber(numberMax[field]) or 100000
			grant[field] = math.floor(math.min(v, cap))
		end
	end
	if raw.SeasonPremium == true then
		grant.SeasonPremium = true
	end
	if next(grant) == nil then
		return nil
	end
	return grant :: any
end

local function grantTo(targets: { Player }, grant: Types.Grant): { Player }
	local done: { Player } = {}
	for _, p in ipairs(targets) do
		local ok, result = call("ShopService", "Grant", p, grant, "Admin")
		if ok and result == true then
			table.insert(done, p)
		end
	end
	return done
end

-- =====================================================================
-- STATISTIK (Fills/min, meistgehandelt, Käufe über AT_Stats_v1-Shards, globale Spieler über Herzschlag)
-- =====================================================================
local function onTrade(p: Player, fill: any)
	if typeof(p) ~= "Instance" or type(fill) ~= "table" then
		return
	end
	local t = now()
	if AdminService.IsAdmin(p) then
		ownerLastTrade[p] = t
	end
	table.insert(tradeTimes, t)
	while #tradeTimes > 2000 or (tradeTimes[1] ~= nil and t - tradeTimes[1] > MARKET_TRADE_WINDOW) do
		table.remove(tradeTimes, 1)
	end
	if isInt(fill.I) then
		local key = tostring(fill.I)
		if tradedCount[key] == nil then
			if tradedKeys >= MAX_TRADED_KEYS then
				return
			end
			tradedKeys += 1
		end
		tradedCount[key] = (tradedCount[key] or 0) + 1
	end
end

-- Käufe erkennen: RobuxSpent/Belege im Spielstand steigen (unabhängig vom Kaufweg; kein Eingriff in WP10)
local function samplePurchases()
	for _, p in ipairs(Players:GetPlayers()) do
		local ok, data = call("DataService", "Get", p)
		if ok and type(data) == "table" and type(data.Purchases) == "table" then
			local robux = tonumber(data.Purchases.RobuxSpent) or 0
			local receipts = if type(data.Purchases.Receipts) == "table" then #data.Purchases.Receipts else 0
			local seen = purchaseSeen[p]
			if seen then
				if robux > seen.Robux then
					statsPending.Robux += robux - seen.Robux
					statsPending.Count += math.max(1, receipts - seen.Receipts)
				end
			end
			purchaseSeen[p] = { Robux = robux, Receipts = receipts }
		end
	end
end

local function flushPurchaseStats()
	if statsPending.Robux <= 0 and statsPending.Count <= 0 then
		return
	end
	local batch = { Robux = statsPending.Robux, Count = statsPending.Count }
	statsPending.Robux, statsPending.Count = 0, 0
	task.spawn(function()
		local key = ("D_%s_%d"):format(dateKey(utcDay()), shard())
		local ok = storeCall(Config.Tech.StatsStore, function(store)
			return store:UpdateAsync(key, function(old)
				local entry: Plain = if type(old) == "table" then old else {}
				entry.Robux = (tonumber(entry.Robux) or 0) + batch.Robux
				entry.Count = (tonumber(entry.Count) or 0) + batch.Count
				return entry
			end)
		end)
		if not ok and not storeOff[Config.Tech.StatsStore] then
			statsPending.Robux += batch.Robux -- später erneut
			statsPending.Count += batch.Count
		end
	end)
end

local function readPurchaseDay(day: number): Plain
	local total = { Robux = 0, Count = 0 }
	local shards = math.max(1, math.floor(tonumber(Config.Tech.Shards) or 8))
	for s = 0, shards - 1 do
		local ok, entry = storeCall(Config.Tech.StatsStore, function(store)
			return store:GetAsync(("D_%s_%d"):format(dateKey(day), s))
		end)
		if ok and type(entry) == "table" then
			total.Robux += tonumber(entry.Robux) or 0
			total.Count += tonumber(entry.Count) or 0
		end
		if storeOff[Config.Tech.StatsStore] then
			break
		end
	end
	return total
end

local function writeHeartbeat()
	if heartbeatOff then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			local map = MemoryStoreService:GetHashMap(Config.Tech.HeartbeatMap)
			map:SetAsync(if game.JobId ~= "" then game.JobId else "Studio", #Players:GetPlayers(), HEARTBEAT_TTL)
		end)
		if not ok then
			if noApi(err) then
				heartbeatOff = true
			else
				warn("[Admin] Herzschlag: " .. tostring(err))
			end
		end
	end)
end

local function readHeartbeat(): (number, number)
	local cached = heartbeatCache
	if cached and os.clock() - cached.At < HEARTBEAT_CACHE then
		return cached.Players, cached.Servers
	end
	local playersSum, servers = #Players:GetPlayers(), 1
	if not heartbeatOff then
		local ok, page = pcall(function()
			local map = MemoryStoreService:GetHashMap(Config.Tech.HeartbeatMap)
			return map:ListItemsAsync(200):GetCurrentPage()
		end)
		if ok and type(page) == "table" then
			playersSum, servers = 0, 0
			for _, item in ipairs(page) do
				if type(item) == "table" and Util.IsFinite(item.value) then
					playersSum += item.value
					servers += 1
				end
			end
			if servers == 0 then
				playersSum, servers = #Players:GetPlayers(), 1
			end
		end
	end
	heartbeatCache = { At = os.clock(), Players = playersSum, Servers = servers }
	return playersSum, servers
end

local function schedulerTop(n: number): ({ Plain }, number, number)
	local schedulerStats = Scheduler.Stats()
	local total = schedulerStats._Total
	local jobs: { Plain } = {}
	for name, stat in pairs(schedulerStats) do
		if name ~= "_Total" then
			table.insert(jobs, { Name = name, AvgMs = stat.AvgMs, MaxMs = stat.MaxMs })
		end
	end
	table.sort(jobs, function(a, b)
		return a.AvgMs > b.AvgMs
	end)
	while #jobs > n do
		table.remove(jobs)
	end
	return jobs, if total then total.AvgMs else 0, if total then total.MaxMs else 0
end

local function memoryMb(): number
	local ok, memory = pcall(function()
		return Stats:GetTotalMemoryUsageMb()
	end)
	return if ok and Util.IsFinite(memory) then math.floor(memory) else 0
end

-- =====================================================================
-- AKTIONEN – DASHBOARD & F8
-- =====================================================================
Actions.Dashboard = function(admin, _args)
	local jobs, avg, max = schedulerTop(6)
	local globalPlayers, servers = readHeartbeat()
	local okMarket, market = call("MarketService", "Stats")
	local okLocal, localMarket = call("MarketService", "IsLocalMarket")
	local okEvents, active = call("EventService", "Active")
	local kinds: { string } = {}
	if okEvents and type(active) == "table" then
		for _, ev in ipairs(active) do
			if type(ev) == "table" and type(ev.Kind) == "string" then
				table.insert(kinds, ev.Kind)
			end
		end
	end
	local okAbuse, abuse = call("EventService", "IsAdminAbuse")
	local data = {
		Players = #Players:GetPlayers(),
		MaxPlayers = Players.MaxPlayers,
		GlobalPlayers = globalPlayers,
		Servers = servers,
		Events = kinds,
		AdminAbuse = okAbuse and abuse == true,
		Market = if okMarket and type(market) == "table" then market else nil,
		LocalMarket = okLocal and localMarket == true,
		HeartbeatMs = avg,
		HeartbeatMaxMs = max,
		Jobs = jobs,
		MemoryMb = memoryMb(),
		Uptime = math.floor(os.clock() - startedAt),
		Version = Config.Version,
		JobId = if game.JobId ~= "" then game.JobId else "Studio",
		Locked = serverLocked,
		Studio = RunService:IsStudio(),
		LiveVersion = tonumber(liveDoc.Version) or 0,
		Maintenance = liveDoc.Banner or "",
	}
	return true, L(admin, "admin.dashboardLoaded"), data
end

Actions.ServerInfo = function(admin, _args)
	local jobs, avg, max = schedulerTop(5)
	local okMarket, market = call("MarketService", "Stats")
	local okCity, cityParts = call("CityService", "PartCount")
	local okTower, towerParts = call("TowerVisualService", "PartCount")
	local towers = 0
	local plots = math.floor(tonumber(Config.Server.Plots) or 10)
	for k = 1, plots do
		local ok, owner = call("PlotService", "OwnerOf", k)
		if ok and owner ~= nil then
			towers += 1
		end
	end
	local okEv, evStats = call("EventService", "Stats")
	local data = {
		Players = #Players:GetPlayers(),
		HeartbeatMs = avg,
		HeartbeatMaxMs = max,
		Jobs = jobs,
		MarketTickMs = if okMarket and type(market) == "table" then market.TickMs else 0,
		Instruments = if okMarket and type(market) == "table" then market.Instruments else 0,
		FrameBytes = if okMarket and type(market) == "table" then market.FrameBytes else 0,
		BusOk = okMarket and type(market) == "table" and market.BusOk == true,
		Towers = towers,
		Parts = (if okCity and Util.IsFinite(cityParts) then cityParts else 0)
			+ (if okTower and Util.IsFinite(towerParts) then towerParts else 0),
		Pickups = if okEv and type(evStats) == "table" then evStats.OpenTokens else 0,
		MemoryMb = memoryMb(),
		Uptime = math.floor(os.clock() - startedAt),
	}
	return true, L(admin, "admin.serverInfo"), data
end

-- =====================================================================
-- AKTIONEN – SPIELER
-- =====================================================================
Actions.GetPlayers = function(_admin, _args)
	local list: { Plain } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local okScore, score = call("AntiCheatService", "Score", p)
		local okLic, licence = call("ProgressionService", "Licence", p)
		local okFloors, floors = call("TowerService", "Floors", p)
		table.insert(list, {
			UserId = p.UserId,
			Name = p.Name,
			DisplayName = p.DisplayName,
			Licence = if okLic and Util.IsFinite(licence) then licence else 1,
			Floors = if okFloors and Util.IsFinite(floors) then floors else 0,
			PingMs = p:GetAttribute("PingMs") or 0,
			Suspicion = if okScore and Util.IsFinite(score) then score else 0,
			IsAdmin = AdminService.IsAdmin(p),
			Frozen = p:GetAttribute("AdminFrozen") == true,
			Minutes = math.floor((os.clock() - (joinedAt[p] or os.clock())) / 60),
		})
	end
	return true, "OK", list
end

Actions.Kick = function(admin, args)
	local targets = resolveTargets(admin, args.Target)
	local raw = cleanText(args.Reason, MAX_REASON)
	local filtered = if raw then filterBroadcast(raw, admin.UserId) else nil
	local kicked: { Player } = {}
	for _, p in ipairs(targets) do
		if p ~= admin and not protectedPlayer(p) then
			table.insert(kicked, p)
			p:Kick(filtered or L(p, "admin.kickDefault"))
		end
	end
	if #kicked == 0 then
		return false, L(admin, if #targets > 0 then "admin.notSelf" else "admin.noTarget")
	end
	return true, L(admin, "admin.kicked", names(kicked))
end

Actions.Ban = function(admin, args)
	local presets = SEC.BanPresets or {}
	local seconds = if type(args.Duration) == "string" then presets[args.Duration] else nil
	if not Util.IsFinite(seconds) then
		return false, L(admin, "admin.banDuration")
	end
	local ids: { number } = {}
	local namesById: { [number]: string } = {}
	local onlineById: { [number]: Player } = {}
	if args.UserId ~= nil then
		local id = tonumber(args.UserId)
		if not id or id % 1 ~= 0 then
			return false, L(admin, "core.invalid")
		end
		table.insert(ids, id)
		local online = Players:GetPlayerByUserId(id)
		namesById[id] = if online then online.Name else tostring(id)
		if online then
			onlineById[id] = online
		end
	else
		for _, p in ipairs(resolveTargets(admin, args.Target)) do
			table.insert(ids, p.UserId)
			namesById[p.UserId] = p.Name
			onlineById[p.UserId] = p
		end
	end
	local valid: { number } = {}
	local lastError = L(admin, "admin.noTarget")
	for _, id in ipairs(ids) do
		local online = onlineById[id]
		if id == admin.UserId then
			lastError = L(admin, "admin.notSelf")
		elseif isOwnerId(id) or (online and AdminService.IsAdmin(online)) then
			lastError = L(admin, "admin.notOwner")
		elseif id <= 0 then
			lastError = L(admin, "admin.studioUser")
		elseif #valid < 50 then
			table.insert(valid, id)
		end
	end
	if #valid == 0 then
		return false, lastError
	end
	local reason = cleanText(args.Reason, SEC.BanDisplayMax or 400) or L(admin, "admin.banDefault")
	local evidence: { string } =
		{ ("Gebannt von %s (%d), %s"):format(admin.Name, admin.UserId, tostring(args.Duration)) }
	local privateNote = cleanText(args.Private, SEC.BanPrivateMax or 1000)
	if privateNote then
		table.insert(evidence, privateNote)
	end
	for _, id in ipairs(valid) do
		local online = onlineById[id]
		if online then
			local okSnap, snap = call("AntiCheatService", "Snapshot", online)
			if okSnap and type(snap) == "table" then
				local violations: { string } = {}
				if type(snap.Violations) == "table" then
					for key, n in pairs(snap.Violations) do
						table.insert(violations, ("%s×%s"):format(tostring(key), tostring(n)))
					end
				end
				table.insert(
					evidence,
					("%s: Punkte %s, Verstöße %s, Tempo %s, Minuten %s"):format(
						online.Name,
						tostring(snap.Score),
						if #violations > 0 then table.concat(violations, " ") else "-",
						tostring(snap.Speed),
						tostring(snap.Minutes)
					)
				)
			end
		end
	end
	local duration = if seconds == -1 then -1 else math.max(60, math.floor(seconds))
	local ok, err = pcall(function()
		Players:BanAsync({
			UserIds = valid,
			Duration = duration,
			DisplayReason = truncate(reason, SEC.BanDisplayMax or 400),
			PrivateReason = truncate(table.concat(evidence, " | "), SEC.BanPrivateMax or 1000),
			ApplyToUniverse = true,
			ExcludeAltAccounts = false,
		})
	end)
	if not ok then
		return false, L(admin, "admin.banFailed", tostring(err))
	end
	local bannedNames: { string } = {}
	for _, id in ipairs(valid) do
		table.insert(bannedNames, namesById[id] or tostring(id))
		call("AntiCheatService", "LogBan", {
			UserId = id,
			Name = namesById[id] or tostring(id),
			Reason = reason,
			Duration = duration,
			By = admin.UserId,
			ByName = admin.Name,
			T = os.time(),
			Active = true,
			Auto = false,
		})
	end
	return true, L(admin, "admin.banned", tostring(args.Duration), table.concat(bannedNames, ", "))
end

Actions.Unban = function(admin, args)
	local id = tonumber(args.UserId)
	if not id or id % 1 ~= 0 then
		return false, L(admin, "core.invalid")
	end
	if id <= 0 then
		return false, L(admin, "admin.studioUser")
	end
	local ok, err = pcall(function()
		Players:UnbanAsync({ UserIds = { id }, ApplyToUniverse = true })
	end)
	if not ok then
		return false, L(admin, "admin.unbanFailed", tostring(err))
	end
	call("AntiCheatService", "MarkUnbanned", id)
	return true, L(admin, "admin.unbanned", id)
end

Actions.BanList = function(admin, _args)
	local ok, list = call("AntiCheatService", "BanLog")
	local out: { any } = {}
	if ok and type(list) == "table" then
		for i, entry in ipairs(list) do
			if i > MAX_LIST then
				break
			end
			table.insert(out, entry)
		end
	end
	return true, L(admin, "admin.banList", #out), out
end

Actions.BanHistory = function(admin, args)
	if RunService:IsStudio() then
		return false, L(admin, "admin.liveOnly")
	end
	local id = tonumber(args.UserId)
	if not id or id % 1 ~= 0 or id <= 0 then
		return false, L(admin, "core.invalid")
	end
	local ok, page = pcall(function()
		local pages = Players:GetBanHistoryAsync(id)
		return pages:GetCurrentPage()
	end)
	if not ok or type(page) ~= "table" then
		return false, L(admin, "admin.banFailed", tostring(page))
	end
	local out: { any } = {}
	for i = #page, 1, -1 do -- neueste zuerst
		local entry = page[i]
		if type(entry) == "table" then
			table.insert(out, {
				Ban = entry.Ban == true,
				DisplayReason = tostring(entry.DisplayReason or ""),
				PrivateReason = tostring(entry.PrivateReason or ""),
				Duration = tonumber(entry.Duration) or 0,
				StartTime = tostring(entry.StartTime or ""),
			})
		end
		if #out >= 10 then
			break
		end
	end
	return true, L(admin, "admin.banHistory", #out), out
end

Actions.Warn = function(admin, args)
	local max = SEC.WarnMax or 150
	local text = cleanText(args.Text, max)
	if not text then
		return false, L(admin, "admin.textLen", max)
	end
	local filtered = filterBroadcast(text, admin.UserId)
	if not filtered then
		return false, L(admin, "admin.filterDown")
	end
	local warned: { Player } = {}
	local targets = resolveTargets(admin, args.Target)
	for _, p in ipairs(targets) do
		if p ~= admin or #targets == 1 then
			effect(p, "AdminWarn", 1, { Text = filtered })
			table.insert(warned, p)
			local okData, data = call("DataService", "Get", p)
			if okData and type(data) == "table" then
				if type(data.Mod) ~= "table" then
					data.Mod = {}
				end
				data.Mod.Warnings = (tonumber(data.Mod.Warnings) or 0) + 1
			end
		end
	end
	if #warned == 0 then
		return false, L(admin, "admin.noTarget")
	end
	return true, L(admin, "admin.warned", names(warned))
end

Actions.Freeze = function(admin, args)
	local on = args.On ~= false
	local done: { Player } = {}
	for _, p in ipairs(resolveTargets(admin, args.Target)) do
		if not (on and p == admin) then
			freeze(p, on)
			p:SetAttribute("AdminFrozen", if on then true else nil)
			table.insert(done, p)
		end
	end
	if #done == 0 then
		return false, L(admin, "admin.noTarget")
	end
	return true, L(admin, if on then "admin.frozen" else "admin.unfrozen", names(done))
end

Actions.Bring = function(admin, args)
	local base = footOf(admin)
	if not base then
		return false, L(admin, "admin.noCharacter")
	end
	local done: { Player } = {}
	for _, p in ipairs(resolveTargets(admin, args.Target)) do
		if p ~= admin and p.Character then
			local i = #done
			local offset = CFrame.new(((i % 5) - 2) * 3, 0, -5 - math.floor(i / 5) * 3)
			if teleport(p, base * offset) then
				table.insert(done, p)
			end
		end
	end
	if #done == 0 then
		return false, L(admin, "admin.noTarget")
	end
	return true, L(admin, "admin.brought", names(done))
end

Actions.Goto = function(admin, args)
	local target, err = resolveOne(admin, args.Target)
	if not target then
		return false, err or ""
	end
	local base = footOf(target)
	if not base or target == admin then
		return false, L(admin, "admin.noTarget")
	end
	teleport(admin, base * CFrame.new(0, 0, 4))
	return true, L(admin, "admin.went", target.DisplayName)
end

Actions.Visit = function(admin, args)
	local target, err = resolveOne(admin, args.Target)
	if not target then
		return false, err or ""
	end
	local okPlot, plot = call("PlotService", "PlotOf", target)
	if not okPlot or not isInt(plot) then
		return false, L(admin, "admin.noPlot")
	end
	local okCf, cf = call("PlotService", "LobbyCFrame", plot)
	if not okCf or typeof(cf) ~= "CFrame" then
		return false, L(admin, "admin.noPlot")
	end
	if not teleport(admin, cf) then
		return false, L(admin, "admin.noCharacter")
	end
	return true, L(admin, "admin.visited", target.DisplayName)
end

Actions.PlayerData = function(admin, args)
	local target, err = resolveOne(admin, args.Target)
	if not target then
		return false, err or ""
	end
	local ok, data = call("DataService", "Get", target)
	if not ok or type(data) ~= "table" then
		return false, L(admin, "core.loading")
	end
	local function count(t: any): number
		local n = 0
		if type(t) == "table" then
			for _ in pairs(t) do
				n += 1
			end
		end
		return n
	end
	local depot = if type(data.Depot) == "table" then data.Depot else {}
	local prog = if type(data.Prog) == "table" then data.Prog else {}
	local tower = if type(data.Tower) == "table" then data.Tower else {}
	local purchases = if type(data.Purchases) == "table" then data.Purchases else {}
	local mod = if type(data.Mod) == "table" then data.Mod else {}
	local league = if type(data.League) == "table" then data.League else {}
	local summary = {
		UserId = target.UserId,
		Name = target.Name,
		Credits = data.Credits,
		AkyCash = math.floor((tonumber(depot.Cash) or 0) / 100),
		AkyBasis = math.floor((tonumber(depot.Basis) or 0) / 100),
		Floors = count(tower.Floors),
		Licence = prog.Licence,
		Xp = prog.Xp,
		Stars = type(prog.Prestige) == "table" and prog.Prestige.Stars or 0,
		Ipos = type(prog.Prestige) == "table" and prog.Prestige.Count or 0,
		LeagueTainted = league.Tainted == true,
		AdminGiftCredits = type(data.Stats) == "table" and tonumber(data.Stats.AdminCredits) or 0,
		GiftSpeed = target:GetAttribute(GIFT_SPEED) or "-",
		Cars = count(type(data.Garage) == "table" and data.Garage.Cars),
		Watches = count(type(data.Life) == "table" and data.Life.Watches),
		Playtime = math.floor((tonumber(data.Playtime) or 0) / 60),
		Sessions = data.Sessions,
		RobuxSpent = purchases.RobuxSpent or 0,
		Receipts = count(purchases.Receipts),
		Warnings = mod.Warnings or 0,
		HardKicks = count(mod.HardKicks),
		NoSave = select(2, call("DataService", "IsNoSave", target)) == true,
	}
	return true, L(admin, "admin.dataShown", target.DisplayName), summary
end

Actions.Receipts = function(admin, args)
	local target, err = resolveOne(admin, args.Target)
	if not target then
		return false, err or ""
	end
	local ok, data = call("DataService", "Get", target)
	if not ok or type(data) ~= "table" then
		return false, L(admin, "core.loading")
	end
	local out: { any } = {}
	local receipts = type(data.Purchases) == "table" and data.Purchases.Receipts
	if type(receipts) == "table" then
		for i = #receipts, 1, -1 do
			local r = receipts[i]
			if type(r) == "table" then
				table.insert(
					out,
					{ Id = tostring(r.Id), T = tonumber(r.T) or 0, Key = tostring(r.Key or r.Product or "") }
				)
			elseif type(r) == "string" then
				table.insert(out, { Id = r, T = 0, Key = "" })
			end
			if #out >= MAX_LIST then
				break
			end
		end
	end
	return true, L(admin, "admin.receipts", #out, target.DisplayName), out
end

local function productExists(key: any): boolean
	local shop = Config.Shop
	if type(key) ~= "string" or type(shop) ~= "table" then
		return false
	end
	local byKey = shop.ProductsByKey
	if type(byKey) == "table" and byKey[key] ~= nil then
		return true
	end
	local passes = shop.PassesByKey
	return type(passes) == "table" and passes[key] ~= nil
end

Actions.Regrant = function(admin, args)
	local target, err = resolveOne(admin, args.Target)
	if not target then
		return false, err or ""
	end
	if not productExists(args.ProductKey) then
		return false, L(admin, "admin.badProduct")
	end
	local ok, granted, message = call("MonetizationService", "SimulatePurchase", target, args.ProductKey)
	if not ok then
		return false, L(admin, "admin.unavailable", "MonetizationService")
	end
	if granted ~= true then
		return false, tostring(message or L(admin, "core.error"))
	end
	return true, L(admin, "admin.regranted", tostring(args.ProductKey) .. " → " .. target.DisplayName)
end

Actions.ResetData = function(admin, args)
	local target, err = resolveOne(admin, args.Target)
	if not target then
		return false, err or ""
	end
	if args.Confirm ~= true then
		return false, L(admin, "admin.confirmNeeded")
	end
	local ok, result = call("DataService", "Reset", target)
	if not ok or result ~= true then
		return false, L(admin, "admin.resetFailed")
	end
	call("PlayerStateService", "Notify", target, "core.dataReset", nil, "Alarm")
	call("PlayerStateService", "MarkDirty", target)
	return true, L(admin, "admin.reset", target.DisplayName)
end

-- =====================================================================
-- AKTIONEN – KRÄFTE (eigene Attribute; Server ehrt sie nur bei IsAdmin)
-- =====================================================================
Actions.SetPower = function(admin, args)
	local name = args.Name
	local kind = if type(name) == "string" then POWERS[name] else nil
	if not kind then
		return false, L(admin, "admin.powerUnknown")
	end
	local value: any = nil
	if kind == "bool" then
		value = if args.Value == true then true else nil
		if name == "CanFly" then
			value = args.Value ~= false -- Fliegen ist Standard (an); aus = false
		end
	else
		local limits = SEC.Powers and SEC.Powers[kind]
		local lo = if type(limits) == "table" then tonumber(limits.Min) or 0 else 0
		local hi = if type(limits) == "table" then tonumber(limits.Max) or 100 else 100
		if Util.IsFinite(args.Value) then
			local v = math.clamp(args.Value, lo, hi)
			if v > lo + 0.001 then
				value = if kind == "Jump" then math.floor(v * 10 + 0.5) / 10 else math.floor(v + 0.5)
			end
		end
	end
	admin:SetAttribute(name, value)
	if name == "AdminInvisible" then
		setInvisible(admin, value == true)
	end
	local shown = if value == nil or value == false
		then L(admin, "admin.off")
		elseif value == true then L(admin, "admin.on")
		else tostring(value)
	return true, L(admin, "admin.powerSet", name, shown), { Name = name, Value = value }
end

-- Speed/Sprung schenken (Ziel-Feld me/all/others/Name): { Target, Speed?, Jump?, Minutes? (0 = bis Reset), Reset? }
Actions.GiveSpeed = function(admin, args)
	local targets = resolveTargets(admin, args.Target)
	if #targets == 0 then
		return false, L(admin, "admin.noTarget")
	end
	if args.Reset == true then
		local cleared: { Player } = {}
		for _, p in ipairs(targets) do
			if clearGift(p, p ~= admin) then
				table.insert(cleared, p)
			end
		end
		if #cleared == 0 then
			return false, L(admin, "admin.giftNone")
		end
		return true, L(admin, "admin.giftReset", names(cleared))
	end
	local powers: Plain = SEC.Powers or {}
	local speedRange: Plain = powers.Speed or { Min = 16, Max = 200 }
	local jumpRange: Plain = powers.Jump or { Min = DEFAULT_JUMP, Max = 100 }
	local speedMin = tonumber(speedRange.Min) or 16
	local jumpMin = tonumber(jumpRange.Min) or DEFAULT_JUMP
	local speed: number? = nil
	if Util.IsFinite(args.Speed) then
		speed = math.floor(math.clamp(args.Speed, speedMin, tonumber(speedRange.Max) or 200) + 0.5)
		if (speed :: number) <= speedMin then
			speed = nil -- Standard-Tempo = kein Geschenk
		end
	end
	local jump: number? = nil
	if Util.IsFinite(args.Jump) then
		jump = math.floor(math.clamp(args.Jump, jumpMin, tonumber(jumpRange.Max) or 100) * 10 + 0.5) / 10
		if (jump :: number) <= jumpMin + 0.05 then
			jump = nil
		end
	end
	if speed == nil and jump == nil then
		return false, L(admin, "admin.giftEmpty")
	end
	local maxMinutes = math.max(1, math.floor(tonumber(powers.GiftMaxMinutes) or 120))
	local minutes = if Util.IsFinite(args.Minutes) then math.clamp(math.floor(args.Minutes), 0, maxMinutes) else 0
	local untilT: number? = if minutes > 0 then now() + minutes * 60 else nil
	local shownSpeed = speed or defaultWalk()
	local shownJump = jump or DEFAULT_JUMP
	for _, p in ipairs(targets) do
		local old = tonumber(p:GetAttribute(GIFT_SPEED))
		if old and old > shownSpeed then
			call("AntiCheatService", "Grace", p, "Impulse", 2, old * 1.25) -- langsamer werden ist nie ein Verstoß
		end
		p:SetAttribute(GIFT_SPEED, speed)
		p:SetAttribute(GIFT_JUMP, jump)
		p:SetAttribute(GIFT_UNTIL, untilT)
		applyGift(p)
		if p ~= admin then
			call(
				"PlayerStateService",
				"Notify",
				p,
				if minutes > 0 then "admin.giftGot" else "admin.giftGotOpen",
				{ shownSpeed, shownJump, minutes },
				"Success"
			)
		end
	end
	local lower = if type(args.Target) == "string" then string.lower(args.Target) else ""
	if lower == "all" or lower == "others" then
		announceAbuse(admin, "SpeedGift", false) -- Geschenk gilt auf diesem Server
	end
	local duration = if minutes > 0 then L(admin, "admin.giftMinutes", minutes) else L(admin, "admin.giftOpen")
	return true, L(admin, "admin.giftGiven", shownSpeed, shownJump, duration, names(targets))
end

-- Zuschauen auch bei fernen Spielern (StreamingEnabled): Replikation um das Ziel, Client folgt mit der Kamera
Actions.Spectate = function(admin, args)
	if args.On == false then
		admin.ReplicationFocus = nil
		return true, L(admin, "admin.spectateStop")
	end
	local target, err = resolveOne(admin, args.Target)
	if not target then
		return false, err or ""
	end
	local root = rootOf(target)
	if target == admin or not root then
		return false, L(admin, "admin.noTarget")
	end
	admin.ReplicationFocus = root
	return true, L(admin, "admin.spectating", target.DisplayName)
end

-- =====================================================================
-- AKTIONEN – GELD & ITEMS (Turm-Seite über ShopService.Grant, AKY/Lizenz taint die Liga-Woche)
-- =====================================================================
Actions.Give = function(admin, args)
	-- negative CR = abziehen (Besitzer-Wunsch 18 "geben oder abziehen"): höchstens das Guthaben, Senke "Admin"
	local raw = if type(args.Grant) == "table" then args.Grant else nil
	if raw and Util.IsFinite(raw.Credits) and raw.Credits <= -1 then
		if not has("ShopService", "Debit") then
			return false, L(admin, "admin.unavailable", "ShopService")
		end
		local want = math.floor(math.min(-raw.Credits, MAX_GIVE_CREDITS))
		local taken: { Player } = {}
		local total = 0 -- tatsächlich abgezogen (höchstens das jeweilige Guthaben)
		for _, p in ipairs(resolveTargets(admin, args.Target)) do
			local okBal, balance = call("ShopService", "Balance", p)
			local amount = math.min(want, if okBal and Util.IsFinite(balance) then math.floor(balance) else 0)
			if amount >= 1 then
				local okDebit, debited = call("ShopService", "Debit", p, amount, "Admin")
				if okDebit and debited == true then
					table.insert(taken, p)
					total += amount
				end
			end
		end
		if #taken == 0 then
			return false, L(admin, "admin.giveFailed")
		end
		return true, L(admin, "admin.taken", total, names(taken))
	end
	local grant = sanitizeGrant(args.Grant)
	if not grant then
		return false, L(admin, "admin.giveEmpty")
	end
	if not has("ShopService", "Grant") then
		return false, L(admin, "admin.unavailable", "ShopService")
	end
	local targets = resolveTargets(admin, args.Target)
	local done = grantTo(targets, grant)
	if #done == 0 then
		return false, L(admin, if #targets > 0 then "admin.giveFailed" else "admin.noTarget")
	end
	local lower = if type(args.Target) == "string" then string.lower(args.Target) else ""
	if grant.Credits and (lower == "all" or lower == "others") then
		announceAbuse(admin, "MoneyGift", false) -- Admin-Geschenk an alle auf diesem Server (im Konto markiert)
	end
	return true, L(admin, "admin.given", names(done))
end

Actions.GiveAllItems = function(admin, args)
	local kind = args.Kind
	local grant: Plain = {}
	if kind == "Cars" then
		grant.Cars = keysOf(Config.Vehicles and Config.Vehicles.Cars)
	elseif kind == "Watches" then
		grant.Watches = keysOf(Config.Lifestyle and Config.Lifestyle.Watches)
	elseif kind == "Accessories" then
		grant.Accessories = keysOf(Config.Lifestyle and Config.Lifestyle.Accessories)
	elseif kind == "Decor" then
		local decor: { [string]: number } = {}
		for _, key in ipairs(keysOf(Config.Decor and Config.Decor.Items)) do
			decor[key] = 1
		end
		grant.Decor = decor
	else
		return false, L(admin, "core.invalid")
	end
	local clean = sanitizeGrant(grant)
	if not clean then
		return false, L(admin, "admin.giveEmpty")
	end
	local targets = resolveTargets(admin, args.Target)
	local done = grantTo(targets, clean)
	if #done == 0 then
		return false, L(admin, if #targets > 0 then "admin.giveFailed" else "admin.noTarget")
	end
	return true, L(admin, "admin.given", names(done))
end

Actions.GiveAky = function(admin, args)
	local aky = tonumber(args.Aky)
	if not aky or aky ~= aky or math.abs(aky) < 1 then
		return false, L(admin, "core.invalid")
	end
	-- negativ = abziehen (Besitzer-Wunsch "geben oder abziehen"; OrderService.AdminCredit zieht höchstens freies AKY ab)
	local cents = math.sign(aky) * math.floor(math.min(math.abs(aky), MAX_GIVE_AKY)) * 100
	local done: { Player } = {}
	local targets = resolveTargets(admin, args.Target)
	local taken = 0 -- beim Abziehen tatsächlich gebucht (Cent; höchstens das jeweils freie AKY)
	for _, p in ipairs(targets) do
		local okDepot, depot = call("OrderService", "Depot", p)
		local before = if okDepot and type(depot) == "table" and Util.IsFinite(depot.Cash) then depot.Cash else nil
		local ok, result = call("OrderService", "AdminCredit", p, cents)
		if ok and result == true then
			table.insert(done, p)
			if before and Util.IsFinite(depot.Cash) then
				taken += math.max(0, before - depot.Cash)
			end
			-- Wunsch 18: Admin-AKY im Konto markiert (Netto-Vermögen-Bestenliste zeigt die Marke, wie bei Admin-CR)
			local okData, data = call("DataService", "Get", p)
			local stats = if cents > 0 and okData and type(data) == "table" then data.Stats else nil
			if type(stats) == "table" then
				local gifted = stats.AdminAky
				stats.AdminAky = math.min(9e15, (if Util.IsFinite(gifted) then gifted else 0) + cents)
			end
		end
	end
	if #done == 0 then
		if #targets == 0 then
			return false, L(admin, "admin.noTarget")
		end
		return false, L(admin, if cents < 0 then "admin.akyNoneFree" else "admin.giveFailed")
	end
	if cents < 0 then
		return true, L(admin, "admin.akyTaken", Format.Aky(taken, langOf(admin)), names(done))
	end
	return true, L(admin, "admin.akyGiven", math.floor(cents / 100), names(done))
end

Actions.SetLicence = function(admin, args)
	local licences = Config.Progression and Config.Progression.Licences or {}
	local idx = tonumber(args.Licence)
	if not idx or idx % 1 ~= 0 or idx < 1 or idx > #licences then
		return false, L(admin, "core.invalid")
	end
	local done: { Player } = {}
	for _, p in ipairs(resolveTargets(admin, args.Target)) do
		local ok, result = call("ProgressionService", "AdminSetLicence", p, idx)
		if ok and result == true then
			table.insert(done, p)
		end
	end
	if #done == 0 then
		return false, L(admin, "admin.noTarget")
	end
	return true, L(admin, "admin.licenceSet", idx, names(done))
end

Actions.SetFloors = function(admin, args)
	local maxFloors = math.floor(tonumber(Config.Tower and Config.Tower.Floors) or 50)
	local n = tonumber(args.Floors)
	if not n or n % 1 ~= 0 or n < 0 or n > maxFloors then
		return false, L(admin, "core.invalid")
	end
	local done: { Player } = {}
	for _, p in ipairs(resolveTargets(admin, args.Target)) do
		local ok, result = call("TowerService", "AdminSetFloors", p, n)
		if ok and result == true then
			table.insert(done, p)
		end
	end
	if #done == 0 then
		return false, L(admin, "admin.noTarget")
	end
	return true, L(admin, "admin.floorsSet", n, names(done))
end

-- =====================================================================
-- AKTIONEN – SERVER
-- =====================================================================
Actions.LockServer = function(admin, args)
	serverLocked = args.On == true
	workspace:SetAttribute("ServerLocked", if serverLocked then true else nil)
	return true, L(admin, if serverLocked then "admin.locked" else "admin.unlockedServer")
end

Actions.KickAll = function(admin, args)
	local raw = cleanText(args.Reason, MAX_REASON)
	local filtered = if raw then filterBroadcast(raw, admin.UserId) else nil
	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= admin and not protectedPlayer(p) then
			count += 1
			p:Kick(filtered or L(p, "admin.kickAllDefault"))
		end
	end
	return true, L(admin, "admin.kickedAll", count)
end

-- =====================================================================
-- AKTIONEN – MARKT (nur MarketService.Admin; Besitzer-Handelssperre ±120 s)
-- =====================================================================
local function noteOwnerEvent(admin: Player)
	local t = now()
	local lead = tonumber(Config.Market and Config.Market.Admin and Config.Market.Admin.Lead) or 10
	local list = ownerEvents[admin]
	if not list then
		list = {}
		ownerEvents[admin] = list
	end
	table.insert(list, { Issued = t, Start = t + lead })
	local block = tonumber(SEC.OwnerTradeBlockSeconds) or 120
	while #list > MAX_OWNER_EVENTS or (list[1] ~= nil and t > list[1].Start + block) do
		table.remove(list, 1)
	end
end

local function marketAction(admin: Player, kind: string, args: Plain, quiet: boolean?): (boolean, string)
	local action, clean, errKey = Core.MarketArgs(kind, args, nil)
	if not action or not clean then
		return false, L(admin, errKey or "core.invalid")
	end
	local block = tonumber(SEC.OwnerTradeBlockSeconds) or 120
	if action ~= "Resume" and Core.TradeLockBefore(ownerLastTrade[admin], now(), block) then
		return false, L(admin, "admin.tradeLock", block)
	end
	if not has("MarketService", "Admin") then
		return false, L(admin, "admin.unavailable", "MarketService")
	end
	local ok, success, message = call("MarketService", "Admin", action, clean, admin)
	if not ok then
		return false, L(admin, "admin.unavailable", "MarketService")
	end
	if success == true and action ~= "Resume" and action ~= "Normalize" and action ~= "Halt" then
		noteOwnerEvent(admin)
	end
	if success == true and not quiet then
		-- Markt-Events laufen immer global (GlobalBus) -> Besitzer-Ansage ebenfalls auf allen Servern
		announceAbuse(admin, kind, true)
	end
	return success == true, tostring(message or "")
end

Actions.Market = function(admin, args)
	local kind = args.Kind
	if type(kind) ~= "string" or not MARKET_ACTIONS[kind] then
		return false, L(admin, "admin.evUnknown")
	end
	return marketAction(admin, kind, args)
end

Actions.MarketLog = function(admin, _args)
	local tickNow = Clock.Tick()
	local okWin, windows = call("MarketService", "AdminWindowsBetween", tickNow - 6 * 3600, tickNow + 3600)
	local okNews, news = call("MarketService", "RecentNews", 50)
	local okStats, market = call("MarketService", "Stats")
	local okLocal, localMarket = call("MarketService", "IsLocalMarket")
	local items: { Plain } = {}
	if okNews and type(news) == "table" then
		for _, n in ipairs(news) do
			if
				type(n) == "table"
				and (
					n.Kind == "Admin"
					or n.Kind == "Halt"
					or n.Kind == "Resume"
					or n.Kind == "Ipo"
					or n.Kind == "Crash"
					or n.Kind == "Rally"
				)
			then
				table.insert(
					items,
					{ T = n.T, Kind = n.Kind, Key = n.Key, I = n.I, Sector = n.Sector, Dir = n.Dir, Text = n.Text }
				)
			end
			if #items >= 30 then
				break
			end
		end
	end
	return true,
		L(admin, "admin.marketLog"),
		{
			Windows = if okWin and type(windows) == "table" then windows else {},
			News = items,
			Market = if okStats then market else nil,
			LocalMarket = okLocal and localMarket == true,
			Tick = tickNow,
			Blocked = AdminService.OwnerTradeBlocked(admin),
		}
end

-- =====================================================================
-- AKTIONEN – EVENTS (Ansage, Admin-Abuse-Katalog, Samstags-Show)
-- =====================================================================
Actions.Announce = function(admin, args)
	local max = SEC.AnnounceMax or 200
	local text = cleanText(args.Text, max)
	if not text then
		return false, L(admin, "admin.textLen", max)
	end
	if os.clock() - announceAt < (tonumber(EV.AnnounceGap) or 1) then
		return false, L(admin, "core.tooFast")
	end
	announceAt = os.clock()
	local filtered = filterBroadcast(text, admin.UserId)
	if not filtered then
		return false, L(admin, "admin.filterDown")
	end
	local message = {
		Kind = "Announce",
		Id = newId("N"),
		Text = filtered,
		UserId = admin.UserId,
		Name = string.sub(admin.DisplayName, 1, MAX_NAME),
	}
	if args.Global == true then
		if publishGlobal(message) then
			return true, L(admin, "admin.announcedGlobal")
		end
		return true, L(admin, "admin.globalFailed")
	end
	handleGlobal(message)
	return true, L(admin, "admin.announced")
end

-- Samstags-Show (1 Klick): CancelAutoShow (GlobalBus) -> Show auf allen Servern -> Rally +15 % Sektor der Woche
local function saturdayShow(admin: Player, global: boolean): (boolean, string)
	local market: any = Config.Market
	local week = Clock.WeekIndex(Clock.Tick())
	local okCancelled, cancelled = call("MarketService", "AutoShowCancelled", week)
	local block = tonumber(SEC.OwnerTradeBlockSeconds) or 120
	if Core.TradeLockBefore(ownerLastTrade[admin], now(), block) then
		return false, L(admin, "admin.tradeLock", block)
	end
	if not (okCancelled and cancelled == true) then
		call("MarketService", "Admin", "CancelAutoShow", { Target = week }, admin)
	end
	local okStart, started, key =
		call("EventService", "Start", "SaturdayShow", {}, if global then "Global" else "Local", admin)
	if not okStart or started ~= true then
		return false, L(admin, if type(key) == "string" then key else "admin.evBusy")
	end
	-- Rally nach der Markt-Abklingzeit (3 s) – Plan-Rally der Auto-Show ist abgesagt
	local sectors = Config.Companies and Config.Companies.Sectors
	local sector = "T"
	if type(sectors) == "table" and #sectors > 0 then
		local entry = sectors[(week % #sectors) + 1]
		if type(entry) == "table" and type(entry.Key) == "string" then
			sector = entry.Key
		end
	end
	local cooldown = tonumber(market and market.Admin and market.Admin.Cooldown) or 3
	local pct = tonumber(EV.AdminLimits.SaturdayShow.RallyPct) or 15
	task.delay(cooldown + 0.25, function()
		if admin.Parent ~= Players then
			return
		end
		local okRally, rallied, message = pcall(marketAction, admin, "MegaRally", {
			Scope = "Sector",
			Target = sector,
			Strength = pct,
			Ramp = 60,
			Decay = 30,
		}, true)
		if not okRally or rallied ~= true then
			call(
				"PlayerStateService",
				"NotifyRaw",
				admin,
				tostring(message or L(admin, "admin.showRallyFailed")),
				"Error"
			)
		end
	end)
	announceAbuse(admin, "SaturdayShow", global)
	return true, L(admin, "admin.showStarted")
end

Actions.Abuse = function(admin, args)
	local kind = args.Event
	if type(kind) ~= "string" then
		return false, L(admin, "admin.evUnknown")
	end
	if MARKET_ACTIONS[kind] then
		return marketAction(admin, kind, if type(args.Args) == "table" then args.Args else {})
	end
	if kind == "SaturdayShow" then
		-- die Auto-Show wird im GlobalBus für ALLE Server abgesagt -> die Show läuft auch auf allen Servern (§B15.3)
		return saturdayShow(admin, true)
	end
	local eventKind = if kind == "BuildBoom" then "AdminBuildBoom" else kind
	local ok, started, key = call(
		"EventService",
		"Start",
		eventKind,
		if type(args.Args) == "table" then args.Args else {},
		if args.Global == true then "Global" else "Local",
		admin
	)
	if not ok then
		return false, L(admin, "admin.unavailable", "EventService")
	end
	if started == true then
		announceAbuse(admin, kind, args.Global == true and kind ~= "AllToHall")
	end
	return started == true, L(admin, if type(key) == "string" then key else "core.error")
end

Actions.AbuseStop = function(admin, args)
	local kind = args.Event
	if type(kind) ~= "string" or #kind > 40 then
		return false, L(admin, "core.invalid")
	end
	local ok, count = call("EventService", "Stop", kind)
	if not ok then
		return false, L(admin, "admin.unavailable", "EventService")
	end
	return true, L(admin, "admin.evStopped", tonumber(count) or 0)
end

-- Welt-Event jetzt starten (nur dieser Server) – Admin-Tab Welt + Crash-Freitag-Probe (Debug)
Actions.WorldEvent = function(admin, args)
	local kind = args.Event
	local allowed = {
		Truck = true,
		Drones = true,
		BuildBoom = true,
		Press = true,
		BellMoment = true,
		SkyShow = true,
		Bear = true,
		GoldenBull = true,
	}
	if type(kind) ~= "string" or not allowed[kind] then
		return false, L(admin, "admin.evUnknown")
	end
	local ok, started, key = call("EventService", "Start", kind, { Probe = args.Probe == true }, "Local", admin)
	if not ok then
		return false, L(admin, "admin.unavailable", "EventService")
	end
	return started == true, L(admin, if type(key) == "string" then key else "core.error")
end

-- =====================================================================
-- AKTIONEN – LIVE-OPS (AT_Live_v1, Notschalter)
-- =====================================================================
Actions.LiveGet = function(admin, _args)
	local specs: { Plain } = {}
	for path, spec in pairs(Config.LiveFields) do
		if type(path) == "string" and type(spec) == "table" then
			local kindName = spec.Type or "number"
			local entry: Plain = { Path = path, Type = kindName }
			if kindName == "number" then
				entry.Min = spec.Min or spec[1]
				entry.Max = spec.Max or spec[2]
				entry.Integer = spec.Integer == true
			elseif kindName == "list" then
				entry.Options = spec.Options
			elseif kindName == "code" then
				entry.MaxCredits = spec.MaxCredits
			end
			if type(spec[1]) == "number" then
				entry.Min, entry.Max, entry.Type = spec[1], spec[2], "number"
			end
			table.insert(specs, entry)
		end
	end
	table.sort(specs, function(a, b)
		return a.Path < b.Path
	end)
	local products: { string } = {}
	local shop = Config.Shop
	if type(shop) == "table" then
		for _, list in ipairs({ shop.Products, shop.GamePasses }) do
			for _, key in ipairs(keysOf(list)) do
				table.insert(products, key)
			end
		end
	end
	return true,
		L(admin, "admin.liveLoaded", tonumber(liveDoc.Version) or 0),
		{
			Specs = specs,
			Current = Config.CurrentLive(),
			Banner = liveDoc.Banner or "",
			Version = liveDoc.Version or 0,
			At = liveDoc.At or 0,
			By = liveDoc.By or 0,
			Products = products,
			Local = storeOff[Config.Tech.LiveStore] == true,
		}
end

Actions.LiveSet = function(admin, args)
	local path = args.Path
	if type(path) ~= "string" or #path > 80 or not string.find(path, ".", 1, true) then
		return false, L(admin, "core.invalid")
	end
	local fields: Plain = Util.DeepCopy(liveDoc.Fields or {})
	if args.Clear == true then
		fields[path] = nil
	else
		local value = args.Value
		local t = type(value)
		if t ~= "number" and t ~= "boolean" and t ~= "table" then
			return false, L(admin, "core.invalid")
		end
		fields[path] = value
	end
	return saveLive(admin, fields, liveDoc.Banner or "")
end

Actions.LiveBanner = function(admin, args)
	local text = args.Text
	local banner = ""
	if type(text) == "string" and text ~= "" then
		local clean = cleanText(text, BANNER_MAX)
		if not clean then
			return false, L(admin, "admin.textLen", BANNER_MAX)
		end
		local filtered = filterBroadcast(clean, admin.UserId)
		if not filtered then
			return false, L(admin, "admin.filterDown")
		end
		banner = filtered
	end
	return saveLive(admin, Util.DeepCopy(liveDoc.Fields or {}), banner)
end

-- =====================================================================
-- AKTIONEN – STATISTIK & MODERATION
-- =====================================================================
Actions.Stats = function(admin, _args)
	local cached = statsCache
	if cached and os.clock() - cached.At < (tonumber(SEC.StatsCacheSeconds) or 60) then
		return true, L(admin, "admin.statsLoaded"), cached.Data
	end
	local credits, aky = 0, 0
	local suspicious: { Plain } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local okBal, balance = call("ShopService", "Balance", p)
		if okBal and Util.IsFinite(balance) then
			credits += balance
		end
		local okNav, nav = call("OrderService", "Nav", p)
		if okNav and Util.IsFinite(nav) then
			aky += nav
		end
		local okScore, score = call("AntiCheatService", "Score", p)
		if okScore and Util.IsFinite(score) and score >= (tonumber(SEC.Review) or 25) then
			table.insert(suspicious, { Name = p.Name, UserId = p.UserId, Score = score })
		end
	end
	local traded: { Plain } = {}
	for key, n in pairs(tradedCount) do
		table.insert(traded, { I = tonumber(key), N = n })
	end
	table.sort(traded, function(a, b)
		return a.N > b.N
	end)
	while #traded > 5 do
		table.remove(traded)
	end
	local okAudit, audit = call("MarketService", "AuditStats")
	local globalPlayers, servers = readHeartbeat()
	local today, yesterday = readPurchaseDay(utcDay()), readPurchaseDay(utcDay() - 1)
	local okAc, acStats = call("AntiCheatService", "Stats")
	local okEv, evStats = call("EventService", "Stats")
	local data = {
		Online = #Players:GetPlayers(),
		GlobalPlayers = globalPlayers,
		Servers = servers,
		Credits = credits,
		AkyCents = aky,
		Traded = traded,
		FillsPerMin = #tradeTimes,
		Audit = if okAudit and type(audit) == "table" then audit else {},
		Today = today,
		Yesterday = yesterday,
		Suspicious = suspicious,
		AntiCheat = if okAc and type(acStats) == "table" then acStats else {},
		Events = if okEv and type(evStats) == "table" then evStats else {},
		Local = storeOff[Config.Tech.StatsStore] == true,
	}
	statsCache = { At = os.clock(), Data = data }
	return true, L(admin, "admin.statsLoaded"), data
end

Actions.Flags = function(admin, _args)
	local ok, list = call("AntiCheatService", "AllFlags", 2)
	if not ok or type(list) ~= "table" then
		return false, L(admin, "admin.unavailable", "AntiCheatService")
	end
	return true, L(admin, "admin.flags", #list), list
end

Actions.DismissFlag = function(admin, args)
	if type(args.Id) ~= "string" or #args.Id > 80 then
		return false, L(admin, "core.invalid")
	end
	local ok, done = call("AntiCheatService", "Dismiss", args.Id)
	if not ok or done ~= true then
		return false, L(admin, "core.error")
	end
	return true, L(admin, "admin.dismissed")
end

Actions.Reports = function(admin, _args)
	local ok, list = call("AntiCheatService", "AllReports", 2)
	if not ok or type(list) ~= "table" then
		return false, L(admin, "admin.unavailable", "AntiCheatService")
	end
	return true, L(admin, "admin.reports", #list), list
end

Actions.AdminLog = function(admin, _args)
	-- Panel zeigt die letzten 100 Admin-Aktionen (Wunsch 18); gespeichert bleiben bis zu AdminLogMax
	local list = readLog()
	local shown: { Plain } = table.move(list, 1, math.min(#list, MAX_LIST), 1, {})
	return true, L(admin, "admin.logLoaded", #shown), shown
end

-- =====================================================================
-- AKTIONEN – DEBUG
-- =====================================================================
Actions.SimulatePurchase = function(admin, args)
	if not productExists(args.ProductKey) then
		return false, L(admin, "admin.badProduct")
	end
	local ok, granted, message = call("MonetizationService", "SimulatePurchase", admin, args.ProductKey)
	if not ok then
		return false, L(admin, "admin.unavailable", "MonetizationService")
	end
	if granted ~= true then
		return false, tostring(message or L(admin, "core.error"))
	end
	return true, L(admin, "admin.simulated", tostring(args.ProductKey))
end

Actions.SimulatePolicy = function(admin, args)
	local field = if args.Field == "Trading" or args.Field == "Subscription" then args.Field else "Random"
	local allowed: boolean? = nil
	if args.Allowed == true then
		allowed = true
	elseif args.Allowed == false then
		allowed = false
	end
	if not call("MonetizationService", "SetPolicyOverride", admin, field, allowed) then
		return false, L(admin, "admin.unavailable", "MonetizationService")
	end
	local label = if allowed == true
		then L(admin, "admin.policyAllowed")
		elseif allowed == false then L(admin, "admin.policyRestricted")
		else L(admin, "admin.policyAuto")
	return true, L(admin, "admin.policy", field, label)
end

Actions.SkipDay = function(admin, _args)
	if not RunService:IsStudio() then
		return false, L(admin, "admin.studioOnly")
	end
	local offset = Util.GetDayOffset() + 1
	Util.SetDayOffset(offset)
	return true, L(admin, "admin.daySkipped", offset)
end

Actions.SetDebug = function(admin, args)
	local debug: any = Config.Debug
	for _, key in ipairs({ "LogRejects", "ForceRestricted", "ShowTriggers" }) do
		local v = args[key]
		if type(v) == "boolean" then
			debug[key] = v
			workspace:SetAttribute("Debug" .. key, if v then true else nil)
		end
	end
	local function onOff(v: any): string
		return L(admin, if v == true then "admin.on" else "admin.off")
	end
	return true,
		L(admin, "admin.debugSet", onOff(debug.LogRejects), onOff(debug.ForceRestricted), onOff(debug.ShowTriggers)),
		{
			LogRejects = debug.LogRejects == true,
			ForceRestricted = debug.ForceRestricted == true,
			ShowTriggers = debug.ShowTriggers == true,
		}
end

Actions.RunSelfTest = function(admin, _args)
	local ok, passed, total = call("SelfTestService", "Run")
	-- CoreTests setzen die Live-Werte auf den Code-Stand zurück -> gültigen Live-Stand wieder anwenden
	applyLiveDoc(liveDoc)
	if not ok then
		return false, L(admin, "admin.unavailable", "SelfTestService")
	end
	return (tonumber(passed) or 0) == (tonumber(total) or -1),
		L(admin, "admin.selfTest", tonumber(passed) or 0, tonumber(total) or 0)
end

-- =====================================================================
-- LEBENSZYKLUS
-- =====================================================================
local function dispatch(p: Player, action: any, args: any): { Ok: boolean, Message: string?, Data: any? }
	if p.Parent ~= Players then
		return { Ok = false } -- schon gegangen (sonst bliebe ein Limiter-Eintrag nach PlayerRemoving liegen)
	end
	-- Spam-Bremse ZUERST (auch für Nicht-Admins, sonst fluten Exploiter das Server-Log)
	if not limiter.Check(p) then
		return { Ok = false, Message = L(p, "core.tooFast") }
	end
	if not AdminService.IsAdmin(p) then
		if not warnedDenied[p] then
			warnedDenied[p] = true
			warn(("[Admin] Unerlaubter Zugriff von %s (%d)"):format(p.Name, p.UserId))
			logAction(
				p,
				"Denied",
				false,
				if type(action) == "string" then string.sub(action, 1, MAX_ACTION_LEN) else "?"
			)
		end
		return { Ok = false, Message = L(p, "admin.denied") }
	end
	if type(action) ~= "string" or #action > MAX_ACTION_LEN or not Actions[action] then
		return { Ok = false, Message = L(p, "core.unknownAction") }
	end
	local cleanArgs: Plain = if type(args) == "table" then args else {}
	local ok, success, message, data = pcall(Actions[action], p, cleanArgs)
	if not ok then
		warn(("[Admin] Fehler bei %s: %s"):format(action, tostring(success)))
		logAction(p, action, false, tostring(success))
		return { Ok = false, Message = L(p, "admin.error", tostring(success)) }
	end
	if not QUIET[action] then
		print(("[Admin] %s -> %s: %s"):format(p.Name, action, tostring(message)))
		logAction(p, action, success == true, if type(message) == "string" then message else nil)
	end
	return { Ok = success == true, Message = if type(message) == "string" then message else nil, Data = data }
end

local function onPlayer(p: Player)
	joinedAt[p] = joinedAt[p] or os.clock()
	refreshGroupOwner()
	if AdminService.IsAdmin(p) then
		p:SetAttribute("IsAdmin", true)
		p:SetAttribute("CanFly", true)
	else
		p:SetAttribute("IsAdmin", nil)
		if serverLocked then
			p:Kick(L(p, "admin.lockedKick"))
			return
		end
	end
	p.CharacterAdded:Connect(function(character)
		if AdminService.IsAdmin(p) and p:GetAttribute("AdminInvisible") == true then
			task.defer(setInvisible, p, true)
		end
		if p:GetAttribute("AdminFrozen") == true or giftActive(p) then
			-- Einfrieren übersteht den Respawn (kein Entkommen per Reset), das Speed-Geschenk ebenso
			task.spawn(function()
				local root = character:WaitForChild("HumanoidRootPart", 10)
				character:WaitForChild("Humanoid", 10)
				if p.Character ~= character or p.Parent ~= Players then
					return
				end
				if p:GetAttribute("AdminFrozen") == true and root and root:IsA("BasePart") then
					root.Anchored = true
				end
				if giftActive(p) then
					applyGift(p)
				end
			end)
		end
	end)
end

function AdminService.Init(services: any)
	Services = services
end

function AdminService.Start()
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		limiter.Clear(p)
		adminCache[p] = nil
		warnedDenied[p] = nil
		joinedAt[p] = nil
		ownerEvents[p] = nil
		ownerLastTrade[p] = nil
		purchaseSeen[p] = nil
		local conn = invisConn[p]
		if conn then
			conn:Disconnect()
		end
		invisConn[p] = nil
		-- Zuschauer, deren Replikation um diesen Spieler lief, wieder um die eigene Figur streamen
		local character = p.Character
		if character then
			for _, other in ipairs(Players:GetPlayers()) do
				local focus = other.ReplicationFocus
				if other ~= p and focus and focus:IsDescendantOf(character) then
					other.ReplicationFocus = nil
				end
			end
		end
	end)

	Remotes.Admin.OnServerInvoke = dispatch
	call("OrderService", "OnTrade", onTrade)

	Scheduler.Every("AdminLog", 1 / LOG_FLUSH_SECONDS, flushLog)
	Scheduler.Every("AdminHeartbeat", 1 / HEARTBEAT_SECONDS, writeHeartbeat)
	Scheduler.Every("AdminPurchases", 1 / STATS_SAMPLE_SECONDS, samplePurchases)
	Scheduler.Every(
		"AdminStatsFlush",
		1 / math.max(60, tonumber(Config.Tech.StatsFlushSeconds) or 600),
		flushPurchaseStats
	)
	Scheduler.Every("AdminGroupOwner", 1 / 120, refreshGroupOwner)
	Scheduler.Every("AdminGifts", 1, expireGifts)

	-- Global: Ansagen, Admin-Abuse, Live-Config (Sender empfängt auch selbst)
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(Config.Tech.MessagingTopic, function(packet)
				handleGlobal(if type(packet) == "table" then packet.Data else nil)
			end)
		end)
		if not ok then
			warn("[Admin] MessagingService nicht verfügbar (in Studio normal): " .. tostring(err))
		end
	end)
	-- Live-Config beim Start laden (geprüft und geklemmt über Config.ApplyLive)
	task.spawn(loadLive)
	writeHeartbeat()
	game:BindToClose(function()
		if #logPending > 0 then
			local batch = table.clone(logPending)
			table.clear(logPending)
			pcall(function()
				storeCall(Config.Tech.ModStore, function(store)
					return store:UpdateAsync("AdminLog", function(old)
						local list: { Plain } = if type(old) == "table" then old else {}
						for _, entry in ipairs(batch) do
							table.insert(list, entry)
						end
						while #list > (tonumber(SEC.AdminLogMax) or 500) do
							table.remove(list, 1)
						end
						return list
					end)
				end)
			end)
		end
	end)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">AntiCheatService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Anti-Cheat, schlank (Server/Services/AntiCheatService)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Vertrag: DESIGN.md §C5.10, §C11 (Sicherheit), §C11.3 (Bewegung &
--  Erlaubnisse), §C9 ("Report"), §C8 (Honeypot "GrantCash"), §C13 (AT_Mod_v1). Basis: CLUTCH-CLASH-AntiCheatService
--  (REUSE §3.14 ADAPT): Verdachts-Modell, Flags/Meldungen/Bann-Log, Honeypot, present(p)-Guard und das gestaffelte
--  5-Hz-Bewegungsbudget bleiben; Schuss-Statistik, Sichtlinien und Kampf-Kontexte sind entfernt.
--
--  Grundsätze (§C11.1): Wirtschafts-Schummeln verhindert die Server-Autorität (Kurse, Fills, Einkommen, Pickups liegen
--  alle auf dem Server) – NICHT dieser Dienst. Hier geht es nur um Bewegung (Privatsphäre der Tower, verschlossene
--  Türen, Pickup-Reichweite) und gefälschte Remotes. Schaden zuerst verhindern (Zurücksetzen auf die letzte gültige
--  Position), Verdacht aus mehreren Signalen, nur harte Signale eskalieren (3 harte Kicks in 7 Tagen = 1-Tages-Bann).
--
--  Bewegung (§C11.3, 5 Hz gestaffelt über Lib/Scheduler):
--    Weg-Budget (32 × SpeedMult × 1,15 + 6 Studs/s, Vorrat 1 s) · Teleport > 40 Studs ohne Gnade (bei Autos mit dem
--    Tempo skaliert) · Höhe über letztem Bodenkontakt · Fliegen (> 3 s Luft ohne Fallen) · Noclip (Strahl zwischen zwei
--    Messungen, nur echtes Durchqueren einer Wand; lokal geöffnete/versteckte Teile werden ignoriert).
--    Erlaubnisse: Auto (VehicleService: SetAllowance{ MaxSpeed = Klassen-Deckel × Boost × 1,2 }), Aufzug/Teleport
--    (NoteTeleport: 1 s Gnade + Ziel-Anker), Jetpack (SetAllowance{ SpeedMult, VerticalMult } nur aktiv), Admin-Fly/
--    Noclip (Admins sind ausgenommen), Impulse (Grace "Impulse"/"Launch" mit Tempo bis zur Landung).
--  Verdacht: Gewichte aus Config.Security.Weights, Abbau 1 Punkt je 30 s, ≥ 25 Prüf-Flag (AT_Mod_v1 F_<yyyymmdd>_<shard>),
--    ≥ 60 Kick. Honeypot-Remote "GrantCash" = +100, Kick, Flag (unser Code feuert ihn NIE).
--  Meldungen (Request "Report" {UserId, Reason}, 3 pro 10 min): Server hängt einen Schnappschuss an (R_<yyyymmdd>_<shard>).
--
--  Öffentliche API (§C5.10):
--    AntiCheatService.NoteTeleport(p, cf)                              1 s Gnade nach einem Server-Teleport
--    AntiCheatService.Grace(p, "Impulse" | "Launch" | "Teleport", seconds, maxSpeed?)
--    AntiCheatService.SetAllowance(p, { SpeedMult?, VerticalMult?, MaxSpeed? }?)   ersetzt die alte Erlaubnis (nil = Standard)
--    AntiCheatService.Exempt(p, seconds)                               0 = Ausnahme beenden
--    AntiCheatService.Add(p, reason, points, evidence?)
--    AntiCheatService.Score(p): number      AntiCheatService.Flags(): { Flag }      AntiCheatService.Snapshot(p)
--  Zusatz (AdminService, gleiche Namen wie CC):
--    AntiCheatService.Reports() · AllFlags(days?) · AllReports(days?) · Dismiss(id) · LogBan(entry) · BanLog() ·
--    MarkUnbanned(userId) · Stats(): { Tracked, Flags, Reports, Kicks }       (AllFlags/AllReports/Dismiss/Bann-Log yielden)
-- =====================================================================

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Lang = require(Shared:WaitForChild("Lang"))
local Types = require(Shared:WaitForChild("Types"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local AntiCheatService = {}
local Services: any = nil

local SEC: any = Config.Security
local HARD_REASONS: { [string]: boolean } = { Honeypot = true, RateBurst = true, Teleport = true }
local HARD_WINDOW = 600 -- ein hartes Signal zählt so lange für "Kick wegen harter Signale"
local DEFAULT_GRAVITY = 196.2
local DEFAULT_JUMP_HEIGHT = 7.2
local MAX_EVIDENCE_KEYS = 12
local RECENT_MAX = 64 -- Zeitstempel pro Grund für die Minuten-Zählung
local STORE_CACHE_SECONDS = 60
local BANLOG_CACHE_SECONDS = 15
local MAX_ALLOWED_SPEED = 600 -- absolute Obergrenze jeder Erlaubnis (Studs/s)
local TELEPORT_SLACK = 1.5 -- Teleport-Schwelle mindestens 1,5 × erlaubter Weg seit der letzten Messung

-- Grund-Texte (auch Ablehnungs-Codes anderer WPs, egal ob groß/klein) -> Schlüssel in Weights
local REASON_KEYS: { [string]: string } = {
	honeypot = "Honeypot",
	type = "Type",
	rate = "Rate",
	rateburst = "RateBurst",
	speed = "Speed",
	teleport = "Teleport",
	fly = "Fly",
	noclip = "Noclip",
	car = "Car",
	tradespam = "Rate",
	pickup = "Type",
}

local REPORT_REASONS: { [string]: boolean } = { Speed = true, Fly = true, Exploit = true, Toxic = true, Other = true }

-- ---------------------------------------------------------------------
-- TYPEN
-- ---------------------------------------------------------------------
type Allowance = { SpeedMult: number, VerticalMult: number, MaxSpeed: number }

type Track = {
	Character: Model?,
	Pos: Vector3?, -- letzte anerkannte Position
	ValidCF: CFrame?, -- letzte gültige CFrame (Zurücksetzen bei waagrechten Verstößen)
	GroundCF: CFrame?, -- letzte CFrame mit Bodenkontakt (Zurücksetzen bei Höhe/Fliegen)
	Time: number,
	Budget: number,
	GraceUntil: number,
	Anchor: Vector3?, -- Ziel des letzten Server-Teleports
	ImpulseUntil: number,
	ImpulseSpeed: number,
	ImpulseAirUntil: number, -- Impuls-Schwung in der Luft: Tempo-Erlaubnis bis zur Landung (höchstens bis hier)
	ExemptUntil: number,
	GroundY: number?,
	AirSince: number?,
	LastY: number?,
	StillSince: number, -- seit wann sich die Position nicht mehr bewegt hat (Lag-Erkennung)
	LastRaw: Vector3?,
	LastSpeed: number, -- waagrechte Geschwindigkeit bei der letzten Messung (eingefroren = Lag)
	Allowance: Allowance,
	GiftSpeed: number, -- Speed-Geschenk des Besitzers (Spieler-Attribut GiftSpeed, nur der Server setzt es), 0 = keins
	GiftJump: number, -- Sprung-Geschenk (Attribut GiftJump), 0 = keins
	Probe: RaycastParams,
	Violations: { [string]: number },
}

type Suspicion = {
	Score: number,
	Review: number,
	T: number,
	Counts: { [string]: number },
	Recent: { [string]: { number } },
	BurstAt: { [string]: number },
	HardAt: number?,
	FlagAt: number,
	Evidence: { [string]: any },
	Kicking: boolean,
	JoinedAt: number,
}

export type Flag = {
	Id: string,
	UserId: number,
	Name: string,
	Score: number,
	Reasons: { string },
	Evidence: { [string]: any },
	T: number,
}

export type Report = {
	Id: string,
	From: number,
	FromName: string,
	UserId: number,
	Name: string,
	Reason: string,
	Snapshot: { [string]: any },
	T: number,
}

export type BanEntry = {
	UserId: number,
	Name: string,
	Reason: string,
	Duration: number,
	By: number,
	ByName: string,
	T: number,
	Active: boolean,
	Auto: boolean,
}

-- ---------------------------------------------------------------------
-- ZUSTAND (alle Pro-Spieler-Tabellen werden bei PlayerRemoving geleert)
-- ---------------------------------------------------------------------
local tracks: { [Player]: Track } = {}
local trackedList: { Player } = {}
local suspicions: { [Player]: Suspicion } = {}
local honeypotHit: { [Player]: boolean } = {}

local localFlags: { Flag } = {}
local localReports: { Report } = {}
local pendingFlags: { Flag } = {}
local pendingReports: { Report } = {}
local dismissed: { [string]: boolean } = {}
local idCounter = 0
local kickCount = 0

local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude
wallParams.RespectCanCollide = true
wallParams.IgnoreWater = true
local excludesDirty = true

local modStore: DataStore? = nil
local storeDisabled = false
local storeWarned = false
local flushing = false
local storedCache: { [string]: { T: number, List: { any } } } = {}
local sessionBans: { BanEntry } = {}
local banLogCache: { BanEntry }? = nil
local banLogAt = -math.huge

-- ---------------------------------------------------------------------
-- KLEINE HELFER
-- ---------------------------------------------------------------------
local function service(name: string): any
	return if Services then Services[name] else nil
end

-- Ruft Services.<name>.<fn>(...) in pcall auf. Gibt (ok, Ergebnis …) zurück; fehlt der Dienst -> false.
local function call(name: string, fnName: string, ...: any): (boolean, ...any)
	local svc = service(name)
	local fn = if type(svc) == "table" then svc[fnName] else nil
	if type(fn) ~= "function" then
		return false
	end
	return pcall(fn, ...)
end

local function langOf(p: Player): Types.Lang
	local ok, lang = call("PlayerStateService", "LangOf", p)
	if ok and (lang == "de" or lang == "en") then
		return lang
	end
	return Lang.For(p)
end

local function L(p: Player, key: string, ...: any): string
	return Lang.T(langOf(p), key, ...)
end

local function isAdmin(p: Player): boolean
	local ok, result = call("AdminService", "IsAdmin", p)
	return ok and result == true
end

local function round(n: number, digits: number?): number
	local m = 10 ^ (digits or 0)
	return math.floor(n * m + 0.5) / m
end

local function utcDay(): number
	return math.floor(os.time() / 86400)
end

local function dateKey(day: number): string
	return os.date("!%Y%m%d", day * 86400) :: string
end

local function shard(): number
	local count = math.max(1, math.floor(tonumber(Config.Tech.Shards) or 8))
	return Util.Hash(game.JobId) % count
end

local function newId(prefix: string): string
	idCounter += 1
	local key = ("%s_%s_%d"):format(prefix, dateKey(utcDay()), shard())
	return ("%s:%x%04x"):format(key, os.time() % 0xFFFFFF, idCounter % 0xFFFF)
end

-- Beweise klein und JSON-tauglich halten (keine Instanzen, keine riesigen Texte)
local function sanitizeValue(value: any): any
	local kind = typeof(value)
	if kind == "number" then
		return if Util.IsFinite(value) then round(value, 2) else 0
	elseif kind == "boolean" then
		return value
	elseif kind == "string" then
		return string.sub(value, 1, 80)
	elseif kind == "Vector3" then
		return ("%.1f,%.1f,%.1f"):format(value.X, value.Y, value.Z)
	elseif kind == "Instance" then
		return string.sub(value.Name, 1, 40)
	end
	return string.sub(tostring(value), 1, 40)
end

local function sanitizeEvidence(evidence: any): { [string]: any }
	local clean: { [string]: any } = {}
	if type(evidence) ~= "table" then
		return clean
	end
	local count = 0
	for key, value in pairs(evidence) do
		if count >= MAX_EVIDENCE_KEYS then
			break
		end
		if type(key) == "string" and type(value) ~= "table" and type(value) ~= "function" then
			clean[string.sub(key, 1, 24)] = sanitizeValue(value)
			count += 1
		end
	end
	return clean
end

-- Auf höchstens maxBytes kürzen, ohne ein UTF-8-Zeichen zu zerschneiden (Bann-Gründe zählen Bytes)
local function truncate(text: string, maxBytes: number): string
	if #text <= maxBytes then
		return text
	end
	local cut = maxBytes
	for _ = 1, 4 do
		if cut <= 0 or utf8.len(string.sub(text, 1, cut)) ~= nil then
			break
		end
		cut -= 1
	end
	return string.sub(text, 1, math.max(0, cut))
end

local function normalizeReason(reason: any): string
	local text = if type(reason) == "string" then reason else tostring(reason)
	text = string.sub(text, 1, 32)
	local key = REASON_KEYS[string.lower(text)]
	if key then
		return key
	end
	return text
end

-- Nur Spieler, die noch im Spiel sind (PlayerRemoving-Handler anderer Services rufen NoteTeleport/SetAllowance
-- evtl. NACH unserem Aufräumen auf -> sonst bliebe ein Track für immer liegen; REUSE §7 #2)
local function present(p: any): boolean
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent == Players
end

-- ---------------------------------------------------------------------
-- SPEICHER (AT_Mod_v1) – alles in pcall; Studio ohne API-Zugriff -> leise aus
-- ---------------------------------------------------------------------
local function noteStoreError(err: any)
	local text = string.lower(tostring(err))
	local studioError = string.find(text, "studio", 1, true)
		or string.find(text, "publish", 1, true)
		or string.find(text, "api services", 1, true)
		or string.find(text, "403", 1, true)
	if RunService:IsStudio() and studioError then
		storeDisabled = true
		if not storeWarned then
			storeWarned = true
			warn("[AntiCheat] Kein DataStore-Zugriff im Studio – Flags/Meldungen/Bann-Log nur im Speicher.")
		end
	else
		warn("[AntiCheat] DataStore-Fehler: " .. tostring(err))
	end
end

local function getStore(): DataStore?
	if storeDisabled then
		return nil
	end
	if modStore then
		return modStore
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Tech.ModStore)
	end)
	if ok and result then
		modStore = result
		return result
	end
	noteStoreError(result)
	return nil
end

local function storeGet(key: string): (boolean, any)
	local store = getStore()
	if not store then
		return false, nil
	end
	local ok, result = pcall(function()
		return (store :: DataStore):GetAsync(key)
	end)
	if not ok then
		noteStoreError(result)
		return false, nil
	end
	return true, result
end

local function storeUpdate(key: string, transform: (old: any) -> any): (boolean, any)
	local store = getStore()
	if not store then
		return false, nil
	end
	local ok, result = pcall(function()
		return (store :: DataStore):UpdateAsync(key, function(old)
			return transform(old)
		end)
	end)
	if not ok then
		noteStoreError(result)
		return false, nil
	end
	return true, result
end

-- Liste mit Ids zusammenführen (ohne Doppelte), auf "max" neueste kürzen
local function mergeList(old: any, additions: { any }, max: number): { any }
	local list: { any } = {}
	local seen: { [string]: boolean } = {}
	if type(old) == "table" then
		for _, entry in ipairs(old) do
			if type(entry) == "table" and type(entry.Id) == "string" and not seen[entry.Id] then
				seen[entry.Id] = true
				table.insert(list, entry)
			end
		end
	end
	for _, entry in ipairs(additions) do
		if not seen[entry.Id] then
			seen[entry.Id] = true
			table.insert(list, entry)
		end
	end
	while #list > max do
		table.remove(list, 1)
	end
	return list
end

-- Wartende Flags/Meldungen in den Tages-Shard schreiben (höchstens StoreWritesPerMinute je Art)
local function flushPending(pending: { any }, prefix: string)
	if #pending == 0 then
		return
	end
	local batch = table.clone(pending)
	local key = ("%s_%s_%d"):format(prefix, dateKey(utcDay()), shard())
	local maxPerKey = math.floor(SEC.StoreMaxPerKey or 50)
	local ok = storeUpdate(key, function(old)
		return mergeList(old, batch, maxPerKey)
	end)
	if ok or storeDisabled then
		-- geschrieben (oder kein Speicher vorhanden): aus der Warteschlange nehmen
		for _, entry in ipairs(batch) do
			local index = table.find(pending, entry)
			if index then
				table.remove(pending, index)
			end
		end
		table.clear(storedCache)
	end
	while #pending > maxPerKey do
		table.remove(pending, 1)
	end
end

local function flushStores()
	if flushing or (#pendingFlags == 0 and #pendingReports == 0) then
		return
	end
	flushing = true
	task.spawn(function()
		local ok, err = pcall(function()
			flushPending(pendingFlags, "F")
			flushPending(pendingReports, "R")
		end)
		if not ok then
			warn("[AntiCheat] Speichern der Flags fehlgeschlagen: " .. tostring(err))
		end
		flushing = false
	end)
end

-- ---------------------------------------------------------------------
-- VERDACHT
-- ---------------------------------------------------------------------
local function suspicionOf(p: Player): Suspicion
	local s = suspicions[p]
	if not s then
		s = {
			Score = 0,
			Review = 0,
			T = os.clock(),
			Counts = {},
			Recent = {},
			BurstAt = {},
			HardAt = nil,
			FlagAt = -math.huge,
			Evidence = {},
			Kicking = false,
			JoinedAt = os.clock(),
		}
		suspicions[p] = s
	end
	return s
end

-- Abbau 1 Punkt je DecayEvery Sekunden (stetig, ohne Schleife)
local function decay(s: Suspicion)
	local now = os.clock()
	local every = math.max(1, tonumber(SEC.DecayEvery) or 30)
	local amount = (now - s.T) / every
	s.T = now
	if amount > 0 then
		s.Score = math.max(0, s.Score - amount)
		s.Review = math.max(0, s.Review - amount)
	end
end

-- Wie oft kam dieser Grund in den letzten 60 s? (Zeitstempel-Liste begrenzt)
local function countRecent(s: Suspicion, key: string, now: number): number
	local list = s.Recent[key]
	if not list then
		list = {}
		s.Recent[key] = list
	end
	table.insert(list, now)
	while #list > RECENT_MAX or (list[1] ~= nil and now - list[1] > 60) do
		table.remove(list, 1)
	end
	return #list
end

local function reasonList(s: Suspicion): { string }
	local keys = Util.Snapshot(s.Counts)
	table.sort(keys, function(a, b)
		return s.Counts[a] > s.Counts[b]
	end)
	local out: { string } = {}
	for i, key in ipairs(keys) do
		if i > 8 then
			break
		end
		table.insert(out, ("%s ×%d"):format(key, s.Counts[key]))
	end
	return out
end

-- Schnappschuss für Admin-Liste, Bann-Beweis und Meldungen (nur Bewegung/Verdacht – keine Kampf-Statistik)
local function snapshotOf(p: Player): { [string]: any }
	local s = suspicionOf(p)
	decay(s)
	local track = tracks[p]
	local minutes = math.max(1 / 60, (os.clock() - s.JoinedAt) / 60)
	local violations: { [string]: number } = if track then table.clone(track.Violations) else {}
	local allowance = if track then track.Allowance else nil
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	local speed = 0
	if root and root:IsA("BasePart") then
		local v = root.AssemblyLinearVelocity
		speed = round(math.sqrt(v.X * v.X + v.Z * v.Z), 1)
	end
	return {
		Score = round(s.Score),
		Review = round(s.Review),
		Rejects = table.clone(s.Counts),
		Violations = violations,
		Minutes = round(minutes, 1),
		Speed = speed,
		Allowance = if allowance
			then ("x%.2f/x%.1f/%d"):format(allowance.SpeedMult, allowance.VerticalMult, math.floor(allowance.MaxSpeed))
			else "-",
		AccountAge = p.AccountAge,
	}
end

-- Neues Prüf-Flag (lokal + Warteschlange zum Speichern)
local function raiseFlag(p: Player, s: Suspicion, why: string, force: boolean?)
	local now = os.clock()
	if not force and now - s.FlagAt < (tonumber(SEC.FlagCooldown) or 300) then
		return
	end
	s.FlagAt = now
	local evidence = sanitizeEvidence(s.Evidence)
	evidence.Why = why
	local flag: Flag = {
		Id = newId("F"),
		UserId = p.UserId,
		Name = p.Name,
		Score = round(s.Score + s.Review),
		Reasons = reasonList(s),
		Evidence = evidence,
		T = os.time(),
	}
	table.insert(localFlags, flag)
	while #localFlags > (SEC.FlagsLocalMax or 200) do
		table.remove(localFlags, 1)
	end
	table.insert(pendingFlags, flag)
	while #pendingFlags > (SEC.FlagsLocalMax or 200) do
		table.remove(pendingFlags, 1)
	end
	warn(("[AntiCheat] Prüf-Flag: %s (%d) – %s, Punkte %d"):format(p.Name, p.UserId, why, flag.Score))
end

local function playerData(p: Player): any
	local ok, data = call("DataService", "Get", p)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

-- Bann-Log (AT_Mod_v1 "BanLog", letzte 100) – yieldet
function AntiCheatService.LogBan(entry: BanEntry): boolean
	if type(entry) ~= "table" then
		return false
	end
	local clean: BanEntry = {
		UserId = math.floor(tonumber(entry.UserId) or 0),
		Name = string.sub(tostring(entry.Name or ""), 1, 40),
		Reason = string.sub(tostring(entry.Reason or ""), 1, 200),
		Duration = math.floor(tonumber(entry.Duration) or -1),
		By = math.floor(tonumber(entry.By) or 0),
		ByName = string.sub(tostring(entry.ByName or ""), 1, 40),
		T = math.floor(tonumber(entry.T) or os.time()),
		Active = entry.Active ~= false,
		Auto = entry.Auto == true,
	}
	table.insert(sessionBans, clean)
	while #sessionBans > (SEC.BanLogMax or 100) do
		table.remove(sessionBans, 1)
	end
	local max = math.floor(SEC.BanLogMax or 100)
	local ok = storeUpdate("BanLog", function(old)
		local list: { any } = if type(old) == "table" then old else {}
		table.insert(list, clean)
		while #list > max do
			table.remove(list, 1)
		end
		return list
	end)
	banLogCache = nil
	return ok
end

-- Bann-Log: gespeichert + diese Sitzung, neueste zuerst – yieldet (15 s Cache)
function AntiCheatService.BanLog(): { BanEntry }
	if not banLogCache or os.clock() - banLogAt > BANLOG_CACHE_SECONDS then
		local ok, stored = storeGet("BanLog")
		local list: { BanEntry } = {}
		if ok and type(stored) == "table" then
			for _, entry in ipairs(stored) do
				if type(entry) == "table" and Util.IsFinite(entry.UserId) then
					table.insert(list, entry)
				end
			end
		end
		banLogCache = list
		banLogAt = os.clock()
	end
	local merged: { BanEntry } = {}
	local seen: { [string]: boolean } = {}
	local function add(entry: BanEntry)
		local key = ("%d_%d"):format(entry.UserId, entry.T)
		if not seen[key] then
			seen[key] = true
			table.insert(merged, entry)
		end
	end
	for _, entry in ipairs(banLogCache or {}) do
		add(entry)
	end
	for _, entry in ipairs(sessionBans) do
		add(entry)
	end
	table.sort(merged, function(a, b)
		return a.T > b.T
	end)
	return merged
end

-- Nach dem Entbannen: Einträge dieses Spielers als "nicht mehr aktiv" markieren – yieldet
function AntiCheatService.MarkUnbanned(userId: number)
	if not Util.IsFinite(userId) then
		return
	end
	for _, entry in ipairs(sessionBans) do
		if entry.UserId == userId then
			entry.Active = false
		end
	end
	storeUpdate("BanLog", function(old)
		if type(old) ~= "table" then
			return nil -- nichts zu ändern (UpdateAsync bricht ab)
		end
		for _, entry in ipairs(old) do
			if type(entry) == "table" and entry.UserId == userId then
				entry.Active = false
			end
		end
		return old
	end)
	banLogCache = nil
end

-- Automatischer 1-Tages-Bann (nur nach 3 harten Kicks in 7 Tagen) – yieldet
local function autoBan(p: Player, evidence: string): boolean
	if p.UserId <= 0 then
		warn("[AntiCheat] Auto-Bann im Studio-Test übersprungen: " .. p.Name)
		return false
	end
	local auto = SEC.AutoBan
	local seconds = math.max(60, math.floor((tonumber(auto.Days) or 1) * 86400))
	local display = truncate(L(p, "admin.acBanReason"), SEC.BanDisplayMax or 400)
	local ok, err = pcall(function()
		Players:BanAsync({
			UserIds = { p.UserId },
			Duration = seconds,
			DisplayReason = display,
			PrivateReason = truncate(evidence, SEC.BanPrivateMax or 1000),
			ApplyToUniverse = true,
			ExcludeAltAccounts = false,
		})
	end)
	if not ok then
		warn("[AntiCheat] Auto-Bann fehlgeschlagen: " .. tostring(err))
		return false
	end
	AntiCheatService.LogBan({
		UserId = p.UserId,
		Name = p.Name,
		Reason = display,
		Duration = seconds,
		By = 0,
		ByName = "AntiCheat",
		T = os.time(),
		Active = true,
		Auto = true,
	})
	return true
end

local function evidenceText(p: Player, s: Suspicion, why: string): string
	local snap = snapshotOf(p)
	local parts = {
		("AntiCheat %s (%d): %s"):format(p.Name, p.UserId, why),
		("Punkte %d"):format(round(s.Score)),
		"Gründe " .. table.concat(reasonList(s), ", "),
		("Tempo %s, Erlaubnis %s, Minuten %s"):format(
			tostring(snap.Speed),
			tostring(snap.Allowance),
			tostring(snap.Minutes)
		),
	}
	for key, value in pairs(sanitizeEvidence(s.Evidence)) do
		table.insert(parts, ("%s=%s"):format(key, tostring(value)))
	end
	return table.concat(parts, " | ")
end

-- Kick (≥ Kick-Punkte oder Honeypot). Harte Signale zählen für den Auto-Bann.
local function kick(p: Player, s: Suspicion, why: string)
	if s.Kicking or not p.Parent then
		return
	end
	s.Kicking = true
	kickCount += 1
	local now = os.clock()
	local hard = s.HardAt ~= nil and now - (s.HardAt :: number) <= HARD_WINDOW
	s.Evidence.Kicked = true
	s.Evidence.Hard = hard
	raiseFlag(p, s, why, true)
	local shouldBan = false
	if hard then
		local data = playerData(p)
		if data then
			if type(data.Mod) ~= "table" then
				data.Mod = {}
			end
			local mod = data.Mod
			local auto = SEC.AutoBan
			local window = (tonumber(auto.WindowDays) or 7) * 86400
			local nowUtc = os.time()
			local kicks: { number } = {}
			if type(mod.HardKicks) == "table" then
				for _, stamp in ipairs(mod.HardKicks) do
					if Util.IsFinite(stamp) and nowUtc - stamp <= window then
						table.insert(kicks, stamp)
					end
				end
			end
			table.insert(kicks, nowUtc)
			while #kicks > (tonumber(auto.Keep) or 10) do
				table.remove(kicks, 1)
			end
			mod.HardKicks = kicks -- wird beim Verlassen mit dem Profil gespeichert
			shouldBan = auto.Enabled == true and #kicks >= (tonumber(auto.HardKicks) or 3)
		end
	end
	local message = L(p, "admin.acKick")
	local evidence = evidenceText(p, s, why)
	warn(("[AntiCheat] Kick %s (%d): %s%s"):format(p.Name, p.UserId, why, if shouldBan then " + 1-Tages-Bann" else ""))
	task.spawn(function()
		if shouldBan then
			autoBan(p, evidence)
		end
		if p.Parent then
			p:Kick(message)
		end
	end)
end

-- Kern: Punkte vergeben (Abbau, Minuten-Bursts, Flags, Kick)
local function addPoints(p: Player, reason: string, points: number, evidence: any)
	local key = normalizeReason(reason)
	local s = suspicionOf(p)
	decay(s)
	local now = os.clock()
	local weights = SEC.Weights
	s.Counts[key] = (s.Counts[key] or 0) + 1
	for k, v in pairs(sanitizeEvidence(evidence)) do
		s.Evidence[k] = v
	end
	s.Evidence.Last = key

	local extra = 0
	local hard = HARD_REASONS[key] == true
	if key == "Rate" then
		local n = countRecent(s, "Rate", now)
		if n > (SEC.RateBurstPerMinute or 20) and now - (s.BurstAt.Rate or -math.huge) >= 60 then
			s.BurstAt.Rate = now
			extra += tonumber(weights.RateBurst) or 15
			s.Counts.RateBurst = (s.Counts.RateBurst or 0) + 1
			hard = true
		end
	end
	if hard then
		s.HardAt = now
	end
	s.Score += points + extra

	if key == "Honeypot" then
		kick(p, s, "Honeypot")
		return
	end
	if s.Score >= (tonumber(SEC.Kick) or 60) then
		kick(p, s, key)
	elseif s.Score >= (tonumber(SEC.Review) or 25) then
		raiseFlag(p, s, key, false)
	end
end

-- ---------------------------------------------------------------------
-- BEWEGUNG (§C11.3)
-- ---------------------------------------------------------------------
local function capacityFor(track: Track, now: number): (number, number)
	local a = track.Allowance
	local rate = SEC.BaseAllowedSpeed * a.SpeedMult * SEC.SpeedTolerance + SEC.SpeedSlack
	if a.MaxSpeed > 0 then
		rate = math.max(rate, a.MaxSpeed) -- im Auto: Klassen-Deckel × Boost × Puffer (VehicleService)
	end
	if track.GiftSpeed > 0 then
		-- vom Besitzer geschenktes Lauf-Tempo (AdminService.GiveSpeed) – nie ein Fehlalarm für Beschenkte
		rate = math.max(rate, track.GiftSpeed * SEC.SpeedTolerance + SEC.SpeedSlack)
	end
	-- Impuls-Gnade, danach noch bis zur ersten Landung (der Client behält den Schwung in der Luft)
	if now < math.max(track.ImpulseUntil, track.ImpulseAirUntil) then
		rate = math.max(rate, track.ImpulseSpeed)
	end
	rate = math.min(rate, MAX_ALLOWED_SPEED)
	return rate, rate * SEC.BucketSeconds
end

-- Weniger Schwerkraft (workspace.Gravity) = höhere/längere Sprünge erlaubt
local function gravityFactor(): number
	local g = workspace.Gravity
	return math.max(1, DEFAULT_GRAVITY / math.max(10, g))
end

local function newTrack(): Track
	local probe = RaycastParams.new()
	probe.FilterType = Enum.RaycastFilterType.Exclude
	probe.RespectCanCollide = true
	probe.IgnoreWater = true
	return {
		Character = nil,
		Pos = nil,
		ValidCF = nil,
		GroundCF = nil,
		Time = os.clock(),
		Budget = 0,
		GraceUntil = 0,
		Anchor = nil,
		ImpulseUntil = 0,
		ImpulseSpeed = 0,
		ImpulseAirUntil = 0,
		ExemptUntil = 0,
		GroundY = nil,
		AirSince = nil,
		LastY = nil,
		StillSince = os.clock(),
		LastRaw = nil,
		LastSpeed = 0,
		Allowance = { SpeedMult = 1, VerticalMult = 1, MaxSpeed = 0 },
		GiftSpeed = 0,
		GiftJump = 0,
		Probe = probe,
		Violations = {},
	}
end

local function trackOf(p: Player): Track
	local track = tracks[p]
	if not track then
		track = newTrack()
		tracks[p] = track
		if not table.find(trackedList, p) then
			table.insert(trackedList, p)
		end
	end
	return track
end

-- Messung übernehmen; full = auch Boden/Luftzeit zurücksetzen (Gnade, Ausnahme, neuer Character)
local function accept(track: Track, root: BasePart, now: number, full: boolean)
	local pos = root.Position
	local _, capacity = capacityFor(track, now)
	track.Pos = pos
	track.ValidCF = root.CFrame
	track.Time = now
	track.Budget = capacity
	track.LastY = pos.Y
	if full then
		track.GroundY = pos.Y
		track.GroundCF = root.CFrame
		track.AirSince = nil
	end
end

local function setCharacter(track: Track, character: Model)
	track.Character = character
	track.Probe.ExcludeInstances = { character }
	track.Pos = nil
	track.ValidCF = nil
	track.GroundCF = nil
	track.GroundY = nil
	track.AirSince = nil
	track.LastRaw = nil
	track.LastSpeed = 0
	track.GraceUntil = os.clock() + (SEC.TeleportGrace or 1)
	track.Anchor = nil
	excludesDirty = true
end

local function refreshExcludes()
	if not excludesDirty then
		return
	end
	excludesDirty = false
	local list: { Instance } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	wallParams.ExcludeInstances = list
end

-- Treffer, die kein Noclip sind: lokal geöffnete Türen (VIP/Club), ausdrücklich markierte Teile, Fahrzeuge
local function ignorableHit(p: Player, inst: Instance): boolean
	local door = inst:GetAttribute("LocalDoor")
	if door ~= nil then
		-- WorldLook öffnet diese Türen nur lokal für Berechtigte (Spieler-Attribut Vip/Club)
		if type(door) == "string" and p:GetAttribute(door) == true then
			return true
		end
	end
	if inst:GetAttribute("NoclipIgnore") == true then
		return true
	end
	local model = inst:FindFirstAncestorOfClass("Model")
	if model and (model:GetAttribute("NoclipIgnore") == true or model:GetAttribute("Vehicle") ~= nil) then
		return true
	end
	return false
end

-- Echtes Durchqueren: Start und Ende liegen auf GEGENÜBERLIEGENDEN Seiten des Teils und auf den anderen
-- Achsen innerhalb seiner Ausdehnung (Ecken schneiden und Kanten hochziehen zählen nicht).
local function crossesThrough(part: BasePart, from: Vector3, to: Vector3): boolean
	local a = part.CFrame:PointToObjectSpace(from)
	local b = part.CFrame:PointToObjectSpace(to)
	local half = part.Size * 0.5
	local axes = { { a.X, b.X, half.X }, { a.Y, b.Y, half.Y }, { a.Z, b.Z, half.Z } }
	for i, axis in ipairs(axes) do
		local opposite = (axis[1] > axis[3] and axis[2] < -axis[3]) or (axis[1] < -axis[3] and axis[2] > axis[3])
		if opposite then
			local inside = true
			for j, other in ipairs(axes) do
				if j ~= i then
					local margin = other[3] + 1
					if math.abs(other[1]) > margin or math.abs(other[2]) > margin then
						inside = false
					end
				end
			end
			if inside then
				return true
			end
		end
	end
	return false
end

local function throughWall(p: Player, root: BasePart, from: Vector3, to: Vector3): (boolean, string?)
	refreshExcludes()
	wallParams.CollisionGroup = root.CollisionGroup
	local origin = from
	local direction = to - from
	for _ = 1, 3 do
		local length = direction.Magnitude
		if length < 0.05 then
			return false, nil
		end
		local result = workspace:Raycast(origin, direction, wallParams)
		if not result then
			return false, nil
		end
		local inst = result.Instance
		if not ignorableHit(p, inst) and inst:IsA("BasePart") and crossesThrough(inst, from, to) then
			return true, inst.Name
		end
		-- hinter dem Treffer weitersuchen
		local travelled = (result.Position - origin).Magnitude + 0.05
		local remaining = length - travelled
		if remaining <= 0.05 then
			return false, nil
		end
		local unit = direction.Unit
		origin += unit * travelled
		direction = unit * remaining
	end
	return false, nil
end

-- Steckt die Wurzel in Terrain-Wasser (Marina)? Schwimmen ist kein Fliegen (eine 4er-Voxel-Säule, billig)
local function inWater(pos: Vector3): boolean
	local terrain = workspace.Terrain
	local ok, inside = pcall(function()
		local region = Region3.new(pos - Vector3.new(1, 5, 1), pos + Vector3.new(1, 1, 1)):ExpandToGrid(4)
		local materials = terrain:ReadVoxels(region, 4)
		for x = 1, #materials do
			local column = materials[x]
			for y = 1, #column do
				local row = column[y]
				for z = 1, #row do
					if row[z] == Enum.Material.Water then
						return true
					end
				end
			end
		end
		return false
	end)
	return ok and inside == true
end

local function isGrounded(track: Track, root: BasePart, humanoid: Humanoid): boolean
	if humanoid.FloorMaterial ~= Enum.Material.Air or humanoid.SeatPart ~= nil then
		return true
	end
	if humanoid:GetState() == Enum.HumanoidStateType.Swimming or inWater(root.Position) then
		return true -- schwimmt (Marina): Höhe/Luftzeit messen erst wieder an Land
	end
	local probe = math.max(humanoid.HipHeight + root.Size.Y * 0.5, 3) + 2
	track.Probe.CollisionGroup = root.CollisionGroup
	local result = workspace:Spherecast(root.Position, 1, Vector3.new(0, -(probe - 1), 0), track.Probe)
	return result ~= nil
end

-- Auf eine sichere CFrame zurücksetzen (Verstoß) – mit Teleport-Gnade
local function resetTo(p: Player, track: Track, cf: CFrame?)
	local character = p.Character
	if not character or not cf then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.SeatPart ~= nil then
		return -- im Fahrzeug nie versetzen (Sitz-Schweißung würde das Auto mitreißen)
	end
	local target: CFrame = cf
	local root = character:FindFirstChild("HumanoidRootPart")
	pcall(function()
		character:PivotTo(target)
		if root and root:IsA("BasePart") then
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end)
	AntiCheatService.NoteTeleport(p, target)
	track.Budget = 0
end

local function violation(p: Player, track: Track, key: string, evidence: { [string]: any }, vertical: boolean)
	track.Violations[key] = (track.Violations[key] or 0) + 1
	local target = if vertical then (track.GroundCF or track.ValidCF) else track.ValidCF
	resetTo(p, track, target)
	local weight = tonumber(SEC.Weights[key]) or 1
	-- Fahrzeug-Verstoß (schneller als der Klassen-Deckel) hat ein eigenes Gewicht
	if key == "Speed" and track.Allowance.MaxSpeed > 0 then
		weight = tonumber(SEC.Weights.Car) or weight
	end
	addPoints(p, key, weight, evidence)
end

local function horizontalSpeed(root: BasePart): number
	local v = root.AssemblyLinearVelocity
	return math.sqrt(v.X * v.X + v.Z * v.Z)
end

local function checkPlayer(p: Player, _dt: number)
	local track = tracks[p]
	if not track or not p.Parent then
		return
	end
	local character = p.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid then
		return
	end
	local now = os.clock()
	local pos = root.Position
	if track.Character ~= character then
		setCharacter(track, character)
	end

	-- Lag-Erkennung: Stand die gemeldete Position still, während der Spieler sich bewegte? Dann ist der Sprung
	-- danach Nachholen von Paketen, kein harter Teleport.
	local stalledFor = 0
	local raw = track.LastRaw
	if raw == nil or (pos - raw).Magnitude > 0.01 then
		if raw ~= nil then
			stalledFor = now - track.StillSince
		end
		track.LastRaw = pos
		track.StillSince = now
	end
	local stalled = stalledFor >= (tonumber(SEC.StallSeconds) or 0.6) and track.LastSpeed > 2
	track.LastSpeed = horizontalSpeed(root)

	-- Ausnahmen: tot, verankert (Einfrieren/Zeremonie), Ausnahme-Zeit, Admin
	if humanoid.Health <= 0 or root.Anchored or now < track.ExemptUntil or isAdmin(p) then
		accept(track, root, now, true)
		return
	end
	-- Teleport-Gnade: nur Positionen nahe am Ziel zählen (alte Pakete werden ignoriert)
	if now < track.GraceUntil then
		local anchor = track.Anchor
		local near = true
		if anchor then
			local ax, az = pos.X - anchor.X, pos.Z - anchor.Z
			near = ax * ax + az * az <= (SEC.AnchorRadius or 30) ^ 2
		end
		if near then
			accept(track, root, now, true)
		else
			track.Time = now
		end
		return
	end
	local last = track.Pos
	if not last then
		accept(track, root, now, true)
		return
	end

	local giftSpeed = p:GetAttribute("GiftSpeed")
	local giftJump = p:GetAttribute("GiftJump")
	track.GiftSpeed = if Util.IsFinite(giftSpeed) then math.clamp(giftSpeed, 0, MAX_ALLOWED_SPEED) else 0
	track.GiftJump = if Util.IsFinite(giftJump) then math.clamp(giftJump, 0, 200) else 0

	local impulse = now < track.ImpulseUntil
	local grounded = isGrounded(track, root, humanoid)
	if not impulse and track.ImpulseAirUntil > 0 and (grounded or now >= track.ImpulseAirUntil) then
		track.ImpulseAirUntil = 0 -- gelandet (oder Obergrenze erreicht): ab jetzt normales Budget
	end
	local rate, capacity = capacityFor(track, now)
	local elapsed = math.clamp(now - track.Time, 0, 2)
	local dx, dz = pos.X - last.X, pos.Z - last.Z
	local dist = math.sqrt(dx * dx + dz * dz)

	-- 1) Teleport (> 40 Studs ohne Gnade; schnelle Erlaubnisse wie Autos heben die Schwelle) – hart, außer nach Lag
	local teleportLimit = math.max(SEC.TeleportMaxDist, rate * math.max(elapsed, 0.2) * TELEPORT_SLACK)
	if dist > teleportLimit and not impulse and not stalled then
		violation(p, track, "Teleport", { Dist = dist, Limit = teleportLimit, From = last, To = pos }, false)
		return
	end
	-- 2) Weg-Budget (nach einem Hänger zählt die Zeit ohne Pakete, höchstens StallCredit Sekunden)
	local refill = rate * elapsed
	local cap = capacity
	if stalled then
		local credit = rate * math.min(stalledFor, tonumber(SEC.StallCredit) or 1.5)
		refill = math.max(refill, credit)
		cap = math.max(cap, credit)
	end
	local budget = math.min(cap, track.Budget + refill) - dist
	if budget < 0 then
		violation(p, track, "Speed", { Dist = dist, Rate = rate, Dt = elapsed, Stall = stalledFor }, false)
		return
	end
	budget = math.min(budget, capacity)
	-- 3) Noclip (Strahl zwischen den Messungen gegen feste Geometrie; nicht im Fahrzeug)
	if dist > 0.5 and humanoid.SeatPart == nil then
		local through, partName = throughWall(p, root, last, pos)
		if through then
			violation(p, track, "Noclip", { From = last, To = pos, Part = partName }, false)
			return
		end
	end
	-- 4) Höhe und Fliegen (Jetpack: VerticalMult hebt Höhe und Luftzeit)
	local vertical = track.Allowance.VerticalMult
	if impulse then
		track.GroundY = math.max(track.GroundY or pos.Y, pos.Y)
		track.AirSince = if grounded then nil else now
		if grounded then
			track.GroundCF = root.CFrame
		end
	elseif grounded then
		track.GroundY = pos.Y
		track.GroundCF = root.CFrame
		track.AirSince = nil
	else
		local factor = gravityFactor()
		local airSince: number = track.AirSince or now
		track.AirSince = airSince
		local jumpHeight = humanoid.JumpHeight
		if not Util.IsFinite(jumpHeight) or jumpHeight <= 0 then
			jumpHeight = DEFAULT_JUMP_HEIGHT
		end
		jumpHeight = math.min(jumpHeight, math.max(DEFAULT_JUMP_HEIGHT * 2, track.GiftJump)) -- Sprung-Geschenk zählt
		local maxHeight = jumpHeight * (SEC.SkillAirJumps + 1) * vertical * factor + SEC.VerticalSlack
		local height = pos.Y - (track.GroundY or pos.Y)
		if height > maxHeight then
			violation(p, track, "Fly", { Height = height, Max = maxHeight }, true)
			return
		end
		local airLimit = SEC.FlyAirSeconds * factor * math.max(1, vertical / 2)
		local lastY = track.LastY
		local falling = lastY ~= nil and pos.Y < lastY - 0.25
		if now - airSince > airLimit and not falling then
			violation(p, track, "Fly", { Air = now - airSince, Limit = airLimit }, true)
			return
		end
	end
	track.Pos = pos
	track.ValidCF = root.CFrame
	track.Time = now
	track.Budget = budget
	track.LastY = pos.Y
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API (§C5.10)
-- ---------------------------------------------------------------------
function AntiCheatService.NoteTeleport(p: Player, cf: CFrame)
	if not present(p) or typeof(cf) ~= "CFrame" or not Util.IsFiniteVector(cf.Position) then
		return
	end
	local track = trackOf(p)
	local now = os.clock()
	local _, capacity = capacityFor(track, now)
	track.GraceUntil = now + (SEC.TeleportGrace or 1)
	track.Anchor = cf.Position
	track.Pos = cf.Position
	track.ValidCF = cf
	track.GroundCF = cf
	track.GroundY = cf.Position.Y
	track.AirSince = nil
	track.LastY = cf.Position.Y
	track.Time = now
	track.Budget = capacity
end

function AntiCheatService.Grace(p: Player, kind: "Impulse" | "Launch" | "Teleport", seconds: number, maxSpeed: number?)
	if not present(p) then
		return
	end
	local track = trackOf(p)
	local now = os.clock()
	local duration = if Util.IsFinite(seconds) then math.clamp(seconds, 0, 30) else (SEC.ImpulseGrace or 1.5)
	if kind == "Teleport" then
		track.GraceUntil = math.max(track.GraceUntil, now + duration)
		track.Anchor = nil -- Ziel unbekannt: jede Position gilt
		return
	end
	if kind ~= "Impulse" and kind ~= "Launch" then
		return
	end
	local speed: number = if Util.IsFinite(maxSpeed)
		then math.clamp(maxSpeed :: number, 0, MAX_ALLOWED_SPEED)
		else (tonumber(SEC.ImpulseMaxSpeed) or 95)
	if now < track.ImpulseUntil then
		track.ImpulseSpeed = math.max(track.ImpulseSpeed, speed)
	else
		track.ImpulseSpeed = speed
	end
	track.ImpulseUntil = math.max(track.ImpulseUntil, now + duration)
	track.ImpulseAirUntil = math.max(track.ImpulseAirUntil, track.ImpulseUntil + (tonumber(SEC.ImpulseAirSeconds) or 3))
	track.Budget = math.max(track.Budget, track.ImpulseSpeed * SEC.BucketSeconds)
end

function AntiCheatService.SetAllowance(p: Player, a: { SpeedMult: number?, VerticalMult: number?, MaxSpeed: number? }?)
	if not present(p) then
		return
	end
	local raw: any = if type(a) == "table" then a else {}
	local track = trackOf(p)
	local old = track.Allowance
	track.Allowance = {
		SpeedMult = if Util.IsFinite(raw.SpeedMult) then math.clamp(raw.SpeedMult, 0.5, 5) else 1,
		VerticalMult = if Util.IsFinite(raw.VerticalMult) then math.clamp(raw.VerticalMult, 0.5, 20) else 1,
		MaxSpeed = if Util.IsFinite(raw.MaxSpeed) then math.clamp(raw.MaxSpeed, 0, MAX_ALLOWED_SPEED) else 0,
	}
	-- Erlaubnis sinkt (Aussteigen, Jetpack aus): Schwung bis zur Landung behalten (kein Fehlalarm beim Ausrollen)
	local oldRate = SEC.BaseAllowedSpeed * old.SpeedMult * SEC.SpeedTolerance + SEC.SpeedSlack
	oldRate = math.max(oldRate, old.MaxSpeed)
	local _, newCapacity = capacityFor(track, os.clock())
	if oldRate > newCapacity / math.max(0.1, SEC.BucketSeconds) + 1 then
		AntiCheatService.Grace(p, "Impulse", tonumber(SEC.ImpulseGrace) or 1.5, oldRate)
	end
end

function AntiCheatService.Exempt(p: Player, seconds: number)
	if not present(p) then
		return
	end
	local track = trackOf(p)
	local duration = if Util.IsFinite(seconds) then math.clamp(seconds, 0, 86400) else 0
	track.ExemptUntil = os.clock() + duration -- letzter Aufruf gewinnt (0 = Ausnahme beenden)
end

function AntiCheatService.Add(p: Player, reason: string, points: number, evidence: { [string]: any }?)
	if not present(p) then
		return
	end
	local amount = if Util.IsFinite(points) then math.clamp(points, 0, 1000) else 0
	local key = normalizeReason(reason)
	if isAdmin(p) then
		-- Admins sind ausgenommen (Honeypot wird trotzdem protokolliert, aber ohne Kick)
		if key == "Honeypot" then
			warn(("[AntiCheat] Honeypot von Admin %s ausgelöst – kein Kick (Admin)."):format(p.Name))
		end
		return
	end
	addPoints(p, key, amount, evidence)
end

function AntiCheatService.Score(p: Player): number
	local s = suspicions[p]
	if not s then
		return 0
	end
	decay(s)
	return round(s.Score, 1)
end

-- Prüf-Flags dieses Servers (Kopie, neueste zuerst)
function AntiCheatService.Flags(): { Flag }
	local list: { Flag } = {}
	for i = #localFlags, 1, -1 do
		local flag = localFlags[i]
		if not dismissed[flag.Id] then
			table.insert(list, flag)
		end
	end
	return list
end

function AntiCheatService.Snapshot(p: Player): { [string]: any }
	if not present(p) then
		return {}
	end
	return snapshotOf(p)
end

-- ---------------------------------------------------------------------
-- ZUSATZ-API (AdminService)
-- ---------------------------------------------------------------------
function AntiCheatService.Reports(): { Report }
	local list: { Report } = {}
	for i = #localReports, 1, -1 do
		local report = localReports[i]
		if not dismissed[report.Id] then
			table.insert(list, report)
		end
	end
	return list
end

function AntiCheatService.Stats(): { [string]: number }
	return {
		Tracked = #trackedList,
		Flags = #localFlags,
		Reports = #localReports,
		Kicks = kickCount,
		Pending = #pendingFlags + #pendingReports,
	}
end

-- Gespeicherte Einträge (Prefix "F" oder "R") der letzten "days" Tage aller Shards – yieldet
local function storedEntries(prefix: string, days: number): { any }
	local cacheKey = prefix .. tostring(days)
	local cached = storedCache[cacheKey]
	if cached and os.clock() - cached.T < STORE_CACHE_SECONDS then
		return cached.List
	end
	local list: { any } = {}
	if getStore() then
		local shards = math.max(1, math.floor(tonumber(Config.Tech.Shards) or 8))
		local today = utcDay()
		local gap = tonumber(SEC.StoreReadGap) or 0.25
		local first = true
		for d = 0, days - 1 do
			for s = 0, shards - 1 do
				if storeDisabled then
					break
				end
				if not first then
					task.wait(gap)
				end
				first = false
				local ok, value = storeGet(("%s_%s_%d"):format(prefix, dateKey(today - d), s))
				if ok and type(value) == "table" then
					for _, entry in ipairs(value) do
						if type(entry) == "table" and type(entry.Id) == "string" then
							table.insert(list, entry)
						end
					end
				end
			end
		end
	end
	storedCache[cacheKey] = { T = os.clock(), List = list }
	return list
end

local function mergeWithLocal(localList: { any }, stored: { any }): { any }
	local out: { any } = {}
	local seen: { [string]: boolean } = {}
	for _, entry in ipairs(localList) do
		if not seen[entry.Id] and not dismissed[entry.Id] then
			seen[entry.Id] = true
			table.insert(out, entry)
		end
	end
	for _, entry in ipairs(stored) do
		if not seen[entry.Id] and not dismissed[entry.Id] and entry.Dismissed ~= true then
			seen[entry.Id] = true
			table.insert(out, entry)
		end
	end
	table.sort(out, function(a, b)
		return (tonumber(a.T) or 0) > (tonumber(b.T) or 0)
	end)
	while #out > (SEC.FlagsLocalMax or 200) do
		table.remove(out)
	end
	return out
end

function AntiCheatService.AllFlags(days: number?): { Flag }
	local count = math.clamp(math.floor(tonumber(days) or 2), 1, 7)
	return mergeWithLocal(AntiCheatService.Flags(), storedEntries("F", count))
end

function AntiCheatService.AllReports(days: number?): { Report }
	local count = math.clamp(math.floor(tonumber(days) or 2), 1, 7)
	return mergeWithLocal(AntiCheatService.Reports(), storedEntries("R", count))
end

-- Flag oder Meldung abweisen (lokal + im gespeicherten Shard) – yieldet
function AntiCheatService.Dismiss(id: string): boolean
	if type(id) ~= "string" or #id > 80 then
		return false
	end
	dismissed[id] = true
	for _, list in ipairs({ localFlags, localReports, pendingFlags, pendingReports } :: { { any } }) do
		for i = #list, 1, -1 do
			if list[i].Id == id then
				table.remove(list, i)
			end
		end
	end
	local colon = string.find(id, ":", 1, true)
	local key = if colon then string.sub(id, 1, colon - 1) else nil
	if key and string.match(key, "^[FR]_%d+_%d+$") then
		storeUpdate(key, function(old)
			if type(old) ~= "table" then
				return nil
			end
			local kept: { any } = {}
			for _, entry in ipairs(old) do
				if type(entry) == "table" and entry.Id ~= id then
					table.insert(kept, entry)
				end
			end
			return kept
		end)
	end
	table.clear(storedCache)
	return true
end

-- ---------------------------------------------------------------------
-- HONEYPOT & MELDEN
-- ---------------------------------------------------------------------
local function onHoneypot(p: Player, ...: any)
	if not present(p) or honeypotHit[p] then
		return
	end
	local args = table.pack(...)
	if not isAdmin(p) then
		honeypotHit[p] = true
	end
	AntiCheatService.Add(p, "Honeypot", tonumber(SEC.Weights.Honeypot) or 100, {
		Remote = "GrantCash",
		Args = args.n,
		First = if args.n > 0 then sanitizeValue(args[1]) else "-",
	})
end

local function onReport(p: Player, arg: any): Types.Reply
	if type(arg) ~= "table" then
		return { Ok = false, Message = L(p, "core.invalid") }
	end
	for key in pairs(arg) do
		if key ~= "UserId" and key ~= "Reason" then
			return { Ok = false, Message = L(p, "core.invalid") }
		end
	end
	local userId = arg.UserId
	local reason = arg.Reason
	if not Util.IsFinite(userId) or userId % 1 ~= 0 or type(reason) ~= "string" or not REPORT_REASONS[reason] then
		return { Ok = false, Message = L(p, "core.invalid") }
	end
	if userId == p.UserId then
		return { Ok = false, Message = L(p, "admin.reportSelf") }
	end
	local target = Players:GetPlayerByUserId(userId)
	if not target then
		return { Ok = false, Message = L(p, "admin.reportGone") }
	end
	local report: Report = {
		Id = newId("R"),
		From = p.UserId,
		FromName = p.Name,
		UserId = target.UserId,
		Name = target.Name,
		Reason = reason,
		Snapshot = snapshotOf(target),
		T = os.time(),
	}
	table.insert(localReports, report)
	while #localReports > (SEC.FlagsLocalMax or 200) do
		table.remove(localReports, 1)
	end
	table.insert(pendingReports, report)
	while #pendingReports > (SEC.FlagsLocalMax or 200) do
		table.remove(pendingReports, 1)
	end
	return { Ok = true, Message = L(p, "admin.reportThanks") }
end

-- ---------------------------------------------------------------------
-- LEBENSZYKLUS
-- ---------------------------------------------------------------------
function AntiCheatService.Init(services: any)
	Services = services
	-- Request "Report" (3 pro 10 Minuten) – Registrierung in Init (§C3 Phase 2)
	local limit = SEC.ReportLimit or { 3, 600 }
	local pss = services and services.PlayerStateService
	if pss and type(pss.Handle) == "function" then
		pss.Handle("Report", onReport, { Rate = tonumber(limit[1]) or 3, Per = tonumber(limit[2]) or 600 })
	else
		warn("[AntiCheat] Request 'Report' konnte nicht registriert werden (PlayerStateService fehlt)")
	end
end

function AntiCheatService.Start()
	local function onPlayer(p: Player)
		local track = trackOf(p)
		suspicionOf(p)
		p.CharacterAdded:Connect(function(character)
			if present(p) then
				setCharacter(track, character)
			end
		end)
		p.CharacterRemoving:Connect(function()
			excludesDirty = true
		end)
		if p.Character then
			setCharacter(track, p.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		tracks[p] = nil
		suspicions[p] = nil
		honeypotHit[p] = nil
		local index = table.find(trackedList, p)
		if index then
			table.remove(trackedList, index)
		end
		excludesDirty = true
	end)

	-- Honeypot: unser Code feuert "GrantCash" NIE – jeder Aufruf ist ein Exploit
	local honeypot: any = Remotes.GrantCash
	if typeof(honeypot) == "Instance" and honeypot:IsA("RemoteEvent") then
		honeypot.OnServerEvent:Connect(onHoneypot)
	else
		warn("[AntiCheat] Remote GrantCash fehlt – Honeypot inaktiv")
	end

	-- Bewegung 5 Hz gestaffelt; Speichern der Flags/Meldungen höchstens StoreWritesPerMinute pro Minute
	Scheduler.Staggered("AntiCheatMove", SEC.MoveHz or 5, function()
		return trackedList
	end, checkPlayer)
	Scheduler.Every("AntiCheatStore", (SEC.StoreWritesPerMinute or 6) / 60, flushStores)
	game:BindToClose(function()
		if #pendingFlags > 0 or #pendingReports > 0 then
			pcall(flushPending, pendingFlags, "F")
			pcall(flushPending, pendingReports, "R")
		end
	end)
end

return AntiCheatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">CityService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Die Stadt (Server/Services/CityService)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §C5.6 (öffentliche API), §A5 (2-km-Stadt mit allen Zonen),
--  §B3 (Plots, Streaming-Modi, Teilebudget ≤ 12.000, Aufbau ≤ 400 Parts je Frame), §D WP7 (Anker mit Attributen,
--  Monitor-/Board-Parts), §C16 (Budgets).
--
--  Ablauf: Init plant die Stadt (World/CityLayout, rein) und baut sofort nur das Nötigste (Plaza-Boden, Spawn, Plot-Flächen,
--  Anker, Board-Flächen). Der Rest entsteht über Scheduler.EveryFrame verteilt: je Frame ≤ Config.City.BuildPerFrame Teile
--  (World/CityKit) + Config.City.TerrainPerFrame Terrain-Aufträge (Boden, Grüngürtel, Marina-Wasser, Villenhügel mit
--  Serpentine und Autobahn-Tunnel). Danach Ready() = true und die Teilezahl steht fest (SelfTest WorldTests).
--  Schnellreise-Prompts (Helipad hoch/zur Plaza, Club-Lift) handelt der Server selbst (ProximityPrompt.Triggered,
--  Teleport über PlotService.Teleport + AntiCheatService.NoteTeleport).
--
--  Öffentliche API (§C5.6):
--    CityService.Anchor(name): CFrame?        "Bell","BellZone","TowerTour","Showroom","Boutique","Helipad","Marina",
--                                             "Lookout","PressScreen","IpoWall","HallOfFame","Academy","VipBalcony",
--                                             "Rooftop","Spawn" (+ Läden "ShopBurger" …) – Fußpunkte, LookVector = Blick
--    CityService.Route(name): { Vector3 }     "Ring" | "Outer" | "Highway" | "Parade" – geschlossen (letzter = erster)
--    CityService.ShopPart(instId): BasePart?  Laden-Front (6 Firmen-Läden), sonst Leuchtschild des Kulissen-Turms
--    CityService.PlotSite(plot): CFrame       Plot-Mitte auf der Plot-Oberkante, LookVector zur Plaza
--    CityService.BoardPart(name): BasePart?   "Wealth","League","Return","Skyline","Firm","Respekt","IpoWall",
--                                             "PressScreen","HallOfFame","Hall1","Hall2","Hall3","TowerTour"
--    CityService.Ready(): boolean
--  Zusätzlich: CityService.PartCount(): number · CityService.Folder(): Folder? · CityService.AnchorNames(): { string } ·
--    CityService.Stats(): { Parts, Specs, Built, Terrain, TerrainDone, Seconds, Ready }
-- =====================================================================

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))
local World = script.Parent.Parent:WaitForChild("World")
local CityLayout = require(World:WaitForChild("CityLayout")) :: any
local CityKit = require(World:WaitForChild("CityKit")) :: any

local CityService = {}
local Services: any = nil

local PREFIX = "[CityService] "
local FOLDER_NAME = "AkytexCity"
local CAR_COST = 46 -- ein Ausstellungsauto zählt so viele Teile im Frame-Budget
local TRAVEL_COOLDOWN = 2
local ERROR_LOG_EVERY = 10
local MAX_PROMPT_DISTANCE = 16

type BuildItem = { Group: any, Spec: any }

local plan: any = nil
local anchors: { [string]: CFrame } = {}
local plotSites: { CFrame } = {}
local cityFolder: Folder? = nil
local groupModels: { [any]: Model } = {}
local queue: { BuildItem } = {}
local queueIndex = 1
local terrainIndex = 1
local ready = false
local partCount = 0
local builtSpecs = 0
local startedAt = 0
local finishedAt = 0
local stopBuild: (() -> ())? = nil
local boardParts: { [string]: BasePart } = {}
local shopParts: { [number]: BasePart } = {}
local signParts: { [number]: BasePart } = {}
local travelAt: { [Player]: number } = {}
local errorLogAt: { [string]: number } = {}

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function logError(where: string, err: any)
	local now = os.clock()
	if now - (errorLogAt[where] or -math.huge) >= ERROR_LOG_EVERY then
		errorLogAt[where] = now
		warn(PREFIX .. where .. ": " .. tostring(err))
	end
end

local function call(serviceName: string, fnName: string, ...: any): (boolean, any)
	local s = Services and Services[serviceName]
	local fn = if type(s) == "table" then s[fnName] else nil
	if type(fn) ~= "function" then
		return false, nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		logError(serviceName .. "." .. fnName, result)
		return false, nil
	end
	return true, result
end

local function ensurePlan(): any
	if plan == nil then
		plan = CityLayout.Plan(Config)
		anchors = plan.Anchors
		plotSites = plan.PlotSites
	end
	return plan
end

-- Fertiges Teil registrieren (Boards, Läden, Kulissen-Schilder)
local function register(inst: Instance?)
	if not inst then
		return
	end
	local function one(part: Instance)
		if not part:IsA("BasePart") then
			return
		end
		partCount += 1
		local board = part:GetAttribute("Board")
		if type(board) == "string" then
			boardParts[board] = part
		end
		local shop = part:GetAttribute("Shop")
		if type(shop) == "number" then
			shopParts[shop] = part
		end
		local company = part:GetAttribute("Company")
		if type(company) == "number" and company > 0 then
			signParts[company] = part
		end
	end
	one(inst)
	for _, child in ipairs(inst:GetDescendants()) do
		one(child)
	end
end

local function modelFor(group: any): Model
	local model = groupModels[group]
	if model and model.Parent then
		return model
	end
	local folder = cityFolder :: Folder
	model = CityKit.GroupModel(group, folder)
	groupModels[group] = model
	local ok, err = pcall(CityKit.PlaceAssets, group, model)
	if not ok then
		logError("PlaceAssets " .. tostring(group.Key), err)
	end
	return model
end

local function buildOne(item: BuildItem): number
	local model = modelFor(item.Group)
	local ok, result = pcall(CityKit.Build, item.Spec, model, item.Group)
	builtSpecs += 1
	if not ok then
		logError("Build " .. tostring(item.Spec.Name), result)
		return 1
	end
	register(result)
	return if item.Spec.Car then CAR_COST else 1
end

local function setupTerrain()
	local terrain = workspace.Terrain
	local ground = Config.City.Ground
	for name, color in pairs(ground.Colors) do
		local material = (Enum.Material :: any)[name]
		if typeof(material) == "EnumItem" and typeof(color) == "Color3" then
			pcall(function()
				terrain:SetMaterialColor(material, color)
			end)
		end
	end
	local water = ground.Water
	pcall(function()
		terrain.WaterColor = water.Color
		terrain.WaterTransparency = water.Transparency
		terrain.WaterReflectance = water.Reflectance
		terrain.WaterWaveSize = water.WaveSize
		terrain.WaterWaveSpeed = water.WaveSpeed
		terrain.Decoration = false -- kein Gras-Teppich (Leistung Handy)
	end)
end

local function finish()
	ready = true
	finishedAt = os.clock()
	local folder = cityFolder
	if folder then
		partCount = CityKit.CountParts(folder)
	end
	local budget = Config.City.PartBudget or 12000
	print(("%sStadt gebaut: %d Teile (Budget %d) in %.1f s"):format(PREFIX, partCount, budget, finishedAt - startedAt))
	if partCount > budget then
		warn(PREFIX .. ("Teilebudget überschritten: %d > %d"):format(partCount, budget))
	end
	local stop = stopBuild
	stopBuild = nil
	if stop then
		stop()
	end
end

-- Ein Frame Aufbau (yieldet nie)
local function buildStep(_dt: number)
	if ready then
		return
	end
	local p = plan
	if not p then
		return
	end
	local terrainJobs = p.Terrain
	local terrainBudget = math.max(1, Config.City.TerrainPerFrame or 3)
	local terrain = workspace.Terrain
	while terrainBudget > 0 and terrainIndex <= #terrainJobs do
		local job = terrainJobs[terrainIndex]
		terrainIndex += 1
		terrainBudget -= 1
		local ok, err = pcall(job, terrain)
		if not ok then
			logError("Terrain", err)
		end
	end
	local budget = math.max(10, Config.City.BuildPerFrame or 400)
	while budget > 0 and queueIndex <= #queue do
		local item = queue[queueIndex]
		queueIndex += 1
		budget -= buildOne(item)
	end
	if queueIndex > #queue and terrainIndex > #terrainJobs then
		finish()
	end
end

-- ---------------------------------------------------------------------
-- SCHNELLREISE (Helipad, Club-Lift)
-- ---------------------------------------------------------------------
local function notify(p: Player, key: string, kind: string?)
	call("PlayerStateService", "Notify", p, key, nil, kind or "Info")
end

local function teleport(p: Player, cf: CFrame): boolean
	local ok, result = call("PlotService", "Teleport", p, cf)
	if ok then
		return result == true
	end
	-- Ersatz ohne PlotService: Fußpunkt + Wurzel-Höhe, NoteTeleport vorher
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or not root or not root:IsA("BasePart") or humanoid.SeatPart ~= nil then
		return false
	end
	local target = cf + Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2, 0)
	call("AntiCheatService", "NoteTeleport", p, target)
	local moved = pcall(function()
		character:PivotTo(target)
		root.AssemblyLinearVelocity = Vector3.zero
	end)
	return moved
end

local function isClub(p: Player): boolean
	if p:GetAttribute("Club") == true then
		return true
	end
	local ok, result = call("MonetizationService", "IsClub", p)
	return ok and result == true
end

local function onPrompt(prompt: ProximityPrompt, p: Player)
	local folder = cityFolder
	if not folder or not prompt:IsDescendantOf(folder) or p.Parent ~= Players then
		return
	end
	local action = prompt:GetAttribute("Action")
	if type(action) ~= "string" then
		return -- Fenster-Prompts öffnet der Client (UI-Kit)
	end
	-- Abstand selbst prüfen (Prompt-Distanz ist nur Client-UX)
	local character = p.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local holder = prompt.Parent
	if not root or not root:IsA("BasePart") or not holder or not holder:IsA("BasePart") then
		return
	end
	if (root.Position - holder.Position).Magnitude > MAX_PROMPT_DISTANCE then
		return
	end
	local now = os.clock()
	if now - (travelAt[p] or -math.huge) < TRAVEL_COOLDOWN then
		notify(p, "world.travelBusy")
		return
	end
	travelAt[p] = now
	local target: CFrame? = nil
	local message: string? = nil
	if action == "HelipadUp" then
		target, message = anchors.Helipad, "world.travelHelipad"
	elseif action == "HelipadFly" then
		target, message = anchors.Spawn, "world.travelPlaza"
	elseif action == "ClubUp" then
		if not isClub(p) then
			notify(p, "world.clubOnly", "Error")
			return
		end
		target, message = anchors.Rooftop, "world.travelRoof"
	elseif action == "ClubDown" then
		target = anchors.IpoWall
	end
	if target and teleport(p, target) and message then
		notify(p, message, "Success")
	end
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API (§C5.6)
-- ---------------------------------------------------------------------
function CityService.Anchor(name: string): CFrame?
	if type(name) ~= "string" then
		return nil
	end
	if next(anchors) == nil then
		local ok, result = pcall(CityLayout.Anchors, Config)
		if ok and type(result) == "table" then
			anchors = result
		end
	end
	return anchors[name]
end

function CityService.AnchorNames(): { string }
	local names = {}
	for name in pairs(anchors) do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

function CityService.Route(name: string): { Vector3 }
	if type(name) ~= "string" then
		return {}
	end
	local ok, points = pcall(Config.City.RoutePoints, name)
	if ok and type(points) == "table" then
		return points
	end
	return {}
end

function CityService.ShopPart(instId: number): BasePart?
	if not Util.IsFinite(instId) then
		return nil
	end
	local shop = shopParts[instId]
	if shop and shop.Parent then
		return shop
	end
	local sign = signParts[instId]
	if sign and sign.Parent then
		return sign
	end
	return nil
end

function CityService.PlotSite(plot: number): CFrame
	local k = if Util.IsFinite(plot) then math.floor(plot) else 1
	local site = plotSites[k]
	if site then
		return site
	end
	return Config.City.PlotCFrame(k)
end

function CityService.BoardPart(name: string): BasePart?
	if type(name) ~= "string" then
		return nil
	end
	local part = boardParts[name]
	if part and part.Parent then
		return part
	end
	return nil
end

function CityService.Ready(): boolean
	return ready
end

function CityService.PartCount(): number
	local folder = cityFolder
	if ready or not folder then
		return partCount
	end
	return CityKit.CountParts(folder)
end

function CityService.Folder(): Folder?
	return cityFolder
end

function CityService.Stats(): { [string]: any }
	local p = plan
	return {
		Parts = CityService.PartCount(),
		Specs = if p then p.Count else 0,
		Built = builtSpecs,
		Terrain = if p then #p.Terrain else 0,
		TerrainDone = terrainIndex - 1,
		Seconds = (if ready then finishedAt else os.clock()) - startedAt,
		Ready = ready,
	}
end

-- ---------------------------------------------------------------------
-- LEBENSZYKLUS
-- ---------------------------------------------------------------------
function CityService.Init(services: any)
	Services = services
	startedAt = os.clock()
	local okPlan, err = pcall(ensurePlan)
	if not okPlan then
		warn(PREFIX .. "Stadtplan fehlgeschlagen: " .. tostring(err))
		ready = true
		return
	end
	-- alter Bau (z. B. Studio-Neustart im selben Ort) weg, dann neu
	local old = workspace:FindFirstChild(FOLDER_NAME)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = workspace
	cityFolder = folder
	setupTerrain()
	-- Priorität sofort (Spawn, Plot-Flächen, Anker, Boards), Rest in die Warteschlange
	local priority = 0
	for _, group in ipairs(plan.Groups) do
		for _, spec in ipairs(group.Specs) do
			local item = { Group = group, Spec = spec }
			if spec.Priority then
				buildOne(item)
				priority += 1
			else
				table.insert(queue, item)
			end
		end
	end
	stopBuild = Scheduler.EveryFrame("CityBuild", buildStep)
	print(
		("%sAufbau gestartet: %d sofort, %d in der Warteschlange, %d Terrain-Aufträge"):format(
			PREFIX,
			priority,
			#queue,
			#plan.Terrain
		)
	)
end

function CityService.Start()
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, p: Player)
		local ok, err = pcall(onPrompt, prompt, p)
		if not ok then
			logError("Prompt", err)
		end
	end)
	Players.PlayerRemoving:Connect(function(p: Player)
		travelAt[p] = nil
	end)
end

return CityService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">CommunityService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Sozial ohne Chat: Ansagen, Freunde-Bonus, Respekt, Reaktionen, Zeigen-Karte, Einladen,
--  Gruppe, Benachrichtigungs-Opt-in (Server/Services/CommunityService)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §C5.8, §C9 (Social*, NotifyOptIn),
--  §C10 (State "Social"), §B11.3–§B11.5, §B11.9, §C11.2 (Alt-Farming: AccountAge ≥ 3 Tage + 10 min Sitzung,
--  Einladungs-Belohnungen max. 10/Woche), REUSE §1.3 (CC-CommunityService PATTERN: Announce, Freunde).
--
--  Öffentliche API (§C5.8):
--    CommunityService.Announce(key, args?, filter?)   System-Ansage, je Empfänger lokalisiert (Effekt "Announce" ohne
--                                                     UserId -> Toast, REUSE §7 #6). args-Elemente dürfen {de, en} sein.
--    CommunityService.FriendsInServer(p): number      Freunde im Server (IsFriendsWithAsync 1× je Paar/Sitzung, gecacht)
--    CommunityService.RespektActive(p): number        aktive Respekt-Boni (je +0,01 Perm, max. 20; TowerService)
--  Request-Handler: SocialRespekt, SocialReact, SocialShow, SocialInvited, NotifyOptIn.   State: "Social".
--  Teilen-Links mit Launch-Daten (Wunsch 11): Einladung mit ExperienceInviteOptions.LaunchData bzw. Deep-Link
--    "…/games/start?placeId=<id>&launchData=visit:<UserId>" -> State Social.LaunchVisit (UserId, 0 = keiner) und
--    Social.LaunchVisitHere; der Client besucht den Tower dann einmal über "TowerVisit" (nach dem Tutorial).
--  Gruppe: Beitritt im Spiel (GroupService:PromptJoinAsync, Client) wird alle 2 min für Nicht-Mitglieder nachgeprüft.
--  Player-Attribute: "React" ("Art:n", Client zeigt die Blase), "ShowCard" (Zeigen-Karte, Client zeigt 6 s),
--    "Group" (Namensschild-Rahmen).
--  Einladungs-Gutschriften für Einlader, die gerade nicht im Server sind: DataStore Config.Tech.GlobalStore,
--  Schlüssel "Ref_<UserId>" { Week, N, Pending } (Abholung beim nächsten Beitritt, keine HTTP-Prüfung).
-- =====================================================================

local DataStoreService = game:GetService("DataStoreService")
local GroupService = game:GetService("GroupService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))
local Lang = require(Shared:WaitForChild("Lang"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local CommunityService = {}
local Services: any = nil

type Reply = Types.Reply
type Data = { [string]: any }

local PCFG: any = Config.Progression
local SOCIAL: any = PCFG.Social
local SECURITY: any = Config.Security or {}
local MAX_ARGS = 8
local LOG_GAP = 10
local REFERRAL_EVERY = 30
local REFERRAL_CLAIM_EVERY = 600
local MAX_TEXT = 500
local LAUNCH_MAX = 200 -- Launch-Daten länger als das werden ignoriert
local GROUP_RECHECK = 120 -- Nicht-Mitglieder: Gruppe so oft nachprüfen (Beitritt über den Knopf im Spiel)

-- Pro-Spieler-Tabellen (alle bei PlayerRemoving geleert)
local sessionStart: { [Player]: number } = {}
local friendCache: { [Player]: { [number]: boolean } } = {}
local friendBusy: { [Player]: { [number]: boolean } } = {}
local respektActive: { [Player]: { number } } = {}
local reactCounter: { [Player]: number } = {}
local showCounter: { [Player]: number } = {}
local refClaimAt: { [Player]: number } = {}
local playBase: { [Player]: number } = {} -- Data.Playtime beim Beitritt (DataService schreibt sie erst vor dem Speichern fort)
local launchVisit: { [Player]: number } = {} -- Tower-Besuch aus Launch-Daten (UserId des Besitzers, nur diese Sitzung)
local groupCheckAt: { [Player]: number } = {}
local groupBusy: { [Player]: boolean } = {}
local lastLogAt: { [string]: number } = {}
local refStore: DataStore? = nil
local refStoreFailed = false

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function logError(where: string, err: any)
	local now = os.clock()
	if (lastLogAt[where] or -math.huge) + LOG_GAP <= now then
		lastLogAt[where] = now
		warn("[CommunityService] " .. where .. ": " .. tostring(err))
	end
end

local function finite(n: any): boolean
	return Util.IsFinite(n)
end

local function num(v: any, default: number): number
	return if Util.IsFinite(v) then v else default
end

local function isInt(v: any): boolean
	return Util.IsFinite(v) and v % 1 == 0
end

local function call(name: string, fnName: string, ...: any): (boolean, ...any)
	local svc = Services and Services[name]
	local fn = svc and svc[fnName]
	if type(fn) ~= "function" then
		return false
	end
	local results = table.pack(pcall(fn, ...))
	if not results[1] then
		logError(name .. "." .. fnName, results[2])
		return false
	end
	return true, table.unpack(results, 2, results.n)
end

local function dataOf(p: Player): Data?
	local ok, data = call("DataService", "Get", p)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

local function langOf(p: Player): Types.Lang
	local ok, lang = call("PlayerStateService", "LangOf", p)
	if ok and (lang == "de" or lang == "en") then
		return lang
	end
	return "en"
end

local function T(p: Player, key: string, ...: any): string
	return Lang.T(langOf(p), key, ...)
end

local function fail(p: Player, key: string, ...: any): Reply
	return { Ok = false, Message = T(p, key, ...) }
end

local function notify(p: Player, key: string, args: { any }?, kind: Types.NotifyKind?)
	call("PlayerStateService", "Notify", p, key, args, kind)
end

local function markDirty(p: Player, ...: string)
	call("PlayerStateService", "MarkDirty", p, ...)
end

local function emptyArg(arg: any): boolean
	return arg == nil or (type(arg) == "table" and next(arg) == nil)
end

local function exactKeys(arg: any, keys: { string }): boolean
	if type(arg) ~= "table" then
		return false
	end
	local allowed: { [string]: boolean } = {}
	for _, key in ipairs(keys) do
		allowed[key] = true
		if arg[key] == nil then
			return false
		end
	end
	for key in pairs(arg) do
		if type(key) ~= "string" or not allowed[key] then
			return false
		end
	end
	return true
end

local function socialOf(data: Data): Data
	local social = data.Social
	if type(social) ~= "table" then
		social = {}
		data.Social = social
	end
	if type(social.RespektGiven) ~= "table" then
		social.RespektGiven = {}
	end
	social.RespektDay = math.floor(num(social.RespektDay, 0))
	social.ReferredBy = math.floor(num(social.ReferredBy, 0))
	social.ReferralDone = social.ReferralDone == true
	social.ReferralWeek = math.floor(num(social.ReferralWeek, 0))
	social.ReferralCount = math.max(0, math.floor(num(social.ReferralCount, 0)))
	social.Group = social.Group == true
	return social
end

-- Studio: AccountAge-Prüfung übersprungen (§C17), Mindest-Sitzung verkürzt (Test → 2 Players)
local function studioSkip(): boolean
	return RunService:IsStudio() and Config.Studio and Config.Studio.SkipAccountAge == true
end

local function accountAgeOk(p: Player): boolean
	if studioSkip() then
		return true
	end
	return p.AccountAge >= num(SECURITY.AccountAgeMin, 3)
end

local function sessionOk(p: Player): boolean
	local need = if studioSkip() then num(SOCIAL.SessionMinStudio, 30) else num(SECURITY.SessionMinForSocial, 600)
	local start = sessionStart[p]
	return start ~= nil and os.clock() - start >= need
end

-- ---------------------------------------------------------------------
-- 2) ANSAGEN
-- ---------------------------------------------------------------------
function CommunityService.Announce(key: string, args: { any }?, filter: ((Player) -> boolean)?)
	if type(key) ~= "string" or key == "" then
		return
	end
	for _, p in ipairs(Players:GetPlayers()) do
		local pass = true
		if filter then
			local ok, result = pcall(filter, p)
			pass = ok and result == true
		end
		if pass then
			local lang = langOf(p)
			local resolved = {}
			if type(args) == "table" then
				for i = 1, math.min(#args, MAX_ARGS) do
					local value = args[i]
					if type(value) == "table" then
						resolved[i] = Lang.Pick(lang, value)
					elseif type(value) == "number" or type(value) == "string" then
						resolved[i] = value
					else
						resolved[i] = tostring(value)
					end
				end
			end
			local text = Lang.T(lang, key, table.unpack(resolved, 1, #resolved))
			-- ohne UserId/Name = System-Ansage (Toast), kein Besitzer-Haken (REUSE §7 #6)
			call("PlayerStateService", "Effect", p, "Announce", 1, { Text = string.sub(text, 1, MAX_TEXT) })
		end
	end
end

-- ---------------------------------------------------------------------
-- 3) FREUNDE (IsFriendsWithAsync 1× je Paar und Sitzung, im Hintergrund)
-- ---------------------------------------------------------------------
local function isFriends(p: Player, userId: number): boolean?
	local ok, result = pcall(function()
		local subject: any = p
		local method = subject.IsFriendsWithAsync
		if type(method) == "function" then
			return method(subject, userId)
		end
		return subject:IsFriendsWith(userId)
	end)
	if not ok then
		-- Methode fehlt in dieser Engine-Version -> ältere Variante versuchen
		local okOld, old = pcall(function()
			local subject: any = p
			return subject:IsFriendsWith(userId)
		end)
		if okOld then
			return old == true
		end
		logError("IsFriendsWithAsync", result)
		return nil
	end
	return result == true
end

local function checkPair(a: Player, b: Player)
	if a == b or a.UserId <= 0 or b.UserId <= 0 then
		return -- Studio-Testspieler sind keine Freunde
	end
	local cacheA = friendCache[a]
	local busyA = friendBusy[a]
	if not cacheA or not busyA or cacheA[b.UserId] ~= nil or busyA[b.UserId] then
		return
	end
	busyA[b.UserId] = true
	task.spawn(function()
		local result = isFriends(a, b.UserId)
		busyA[b.UserId] = nil
		if result ~= nil and friendCache[a] == cacheA then
			cacheA[b.UserId] = result
			local cacheB = friendCache[b]
			if cacheB then
				cacheB[a.UserId] = result -- Freundschaft ist gegenseitig: ein Aufruf je Paar
			end
			if result then
				markDirty(a, "Social")
				markDirty(b, "Social")
			end
		end
	end)
end

function CommunityService.FriendsInServer(p: Player): number
	local cache = friendCache[p]
	if not cache then
		return 0
	end
	local n = 0
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= p and cache[other.UserId] == true then
			n += 1
		end
	end
	return n
end

-- ---------------------------------------------------------------------
-- 4) RESPEKT (§B11.3)
-- ---------------------------------------------------------------------
local function pruneRespekt(p: Player): { number }
	local list = respektActive[p]
	if not list then
		list = {}
		respektActive[p] = list
	end
	local now = os.clock()
	for i = #list, 1, -1 do
		if list[i] <= now then
			table.remove(list, i)
		end
	end
	return list
end

function CommunityService.RespektActive(p: Player): number
	if typeof(p) ~= "Instance" or not respektActive[p] then
		return 0
	end
	return math.min(#pruneRespekt(p), SOCIAL.RespektMax)
end

local function eventActive(kind: string): boolean
	local ok, list = call("EventService", "Active")
	if not ok or type(list) ~= "table" then
		return false
	end
	local now = os.time()
	for _, ev in ipairs(list) do
		if type(ev) == "table" and ev.Kind == kind and num(ev.Until, 0) > now then
			return true
		end
	end
	return false
end

local function roomCount(p: Player, room: string): number
	local ok, n = call("TowerService", "RoomCount", p, room)
	return if ok and finite(n) then n else 0
end

local function nearTower(giver: Player, owner: Player): boolean
	local okVisit, visiting = call("PlotService", "VisitingOf", giver)
	if okVisit and visiting == owner.UserId then
		return true
	end
	local okPlot, plot = call("PlotService", "PlotOf", owner)
	if not okPlot or not isInt(plot) then
		return false
	end
	local okCf, cf = call("PlotService", "PlotCFrame", plot)
	local character = giver.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not okCf or typeof(cf) ~= "CFrame" or not root or not root:IsA("BasePart") then
		return false
	end
	local offset = root.Position - cf.Position
	return Vector2.new(offset.X, offset.Z).Magnitude <= SOCIAL.RespektRange
end

local function weekRespekt(social: Data): number
	if social.RespektWeek ~= Util.IsoWeek() then
		return 0
	end
	return math.max(0, math.floor(num(social.RespektGot, 0)))
end

-- Saison-XP für den Besucher (Config.Season.XpSources.Respekt.Xp, Standard 25)
local function respektSeasonXp(): number
	local season = Config.Season
	local sources = if type(season) == "table" then season.XpSources else nil
	local entry = if type(sources) == "table" then sources.Respekt else nil
	return if type(entry) == "table" then num(entry.Xp, 25) else 25
end

local function handleRespekt(p: Player, arg: any): Reply
	if not exactKeys(arg, { "UserId" }) or not isInt(arg.UserId) then
		return fail(p, "core.invalid")
	end
	local owner = Players:GetPlayerByUserId(arg.UserId)
	if not owner or owner == p then
		return fail(p, "soc.respektNoOwner")
	end
	if not accountAgeOk(p) then
		return fail(p, "soc.respektAge", num(SECURITY.AccountAgeMin, 3))
	end
	if not sessionOk(p) then
		return fail(p, "soc.respektSession")
	end
	local data, ownerData = dataOf(p), dataOf(owner)
	if not data or not ownerData then
		return fail(p, "core.loading")
	end
	if not nearTower(p, owner) then
		return fail(p, "soc.respektFar")
	end
	local social = socialOf(data)
	local day = Util.UtcDay()
	if social.RespektDay ~= day then
		social.RespektDay = day
		social.RespektGiven = {}
	end
	local key = tostring(owner.UserId)
	if social.RespektGiven[key] == day then
		return fail(p, "soc.respektAlready")
	end
	social.RespektGiven[key] = day
	-- Besitzer: +0,01 Perm je Respekt für 1 h (Lounge 2 h); Marketing-Studio und Sky-Show zählen doppelt
	local weight = 1
	if roomCount(owner, "Marketing") > 0 then
		weight = 2
	end
	if eventActive(SOCIAL.SkyShowKind) then
		weight *= 2
	end
	local hours = if roomCount(owner, "Lounge") > 0 then SOCIAL.LoungeHours else SOCIAL.RespektHours
	local list = pruneRespekt(owner)
	for _ = 1, weight do
		table.insert(list, os.clock() + hours * 3600)
	end
	table.sort(list)
	while #list > SOCIAL.RespektMax do
		table.remove(list, 1) -- die ältesten laufen zuerst ab
	end
	local ownerSocial = socialOf(ownerData)
	local week = Util.IsoWeek()
	if ownerSocial.RespektWeek ~= week then
		ownerSocial.RespektWeek = week
		ownerSocial.RespektGot = 0
	end
	ownerSocial.RespektGot = math.floor(num(ownerSocial.RespektGot, 0)) + weight
	call("ProgressionService", "NoteStat", owner, "RespektGot", 1, nil)
	call("LeaderboardService", "Submit", owner)
	notify(owner, "soc.respektGot", { p.DisplayName }, "Success")
	-- Besucher: +25 Saison-XP (max. 5/Tag) + Quest/Erfolg
	call("RewardService", "GrantSeasonXp", p, respektSeasonXp(), "Respekt")
	call("RewardService", "Track", p, "GiveRespekt", 1, { Owner = owner.UserId })
	markDirty(p, "Social")
	markDirty(owner, "Social")
	return { Ok = true, Message = T(p, "soc.respektSent", owner.DisplayName) }
end

-- ---------------------------------------------------------------------
-- 5) REAKTIONEN & ZEIGEN-KARTE (ohne Chat; Attribute replizieren an alle Clients)
-- ---------------------------------------------------------------------
local reactionKeys: { [string]: boolean } = {}
for _, entry in ipairs(SOCIAL.Reactions) do
	reactionKeys[entry.Key] = true
end

local function handleReact(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Kind" }) or type(arg.Kind) ~= "string" or not reactionKeys[arg.Kind] then
		return fail(p, "core.invalid")
	end
	local n = (reactCounter[p] or 0) % 1000 + 1
	reactCounter[p] = n
	p:SetAttribute("React", arg.Kind .. ":" .. tostring(n))
	return { Ok = true }
end

local TIER_ORDER = { "Bronze", "Silber", "Gold", "Diamant" }

local function leagueTier(stats: any): string
	if type(stats) ~= "table" or stats.Qualified ~= true then
		return "None"
	end
	local tier = "None"
	local trading = Config.Trading
	local tiers = if type(trading) == "table" and type(trading.League) == "table" then trading.League.Tiers else nil
	if type(tiers) == "table" then
		for _, entry in ipairs(tiers) do
			if type(entry) == "table" and num(stats.SkillScore, 0) >= num(entry.Min, math.huge) then
				tier = entry.Key
			end
		end
	end
	return tier
end

local function handleShow(p: Player, arg: any): Reply
	if not emptyArg(arg) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local okStage, stage = call("TowerService", "Stage", p)
	local okLic, licence = call("ProgressionService", "Licence", p)
	local okStats, stats = call("OrderService", "LeagueStats", p)
	local okTitle, title = call("ProgressionService", "Title", p)
	local garage = data.Garage
	local car = if type(garage) == "table" and type(garage.Active) == "string" then garage.Active else ""
	local skill = if okStats and type(stats) == "table" then math.floor(num(stats.SkillScore, 0)) else 0
	local tier = leagueTier(if okStats then stats else nil)
	if tier == "None" then
		local league = data.League
		local last = if type(league) == "table" then league.LastTier else nil
		if type(last) == "string" and table.find(TIER_ORDER, last) then
			tier = last
		end
	end
	local n = (showCounter[p] or 0) % 1000 + 1
	showCounter[p] = n
	-- kompakt: Stufe|Lizenz|Skill-Score|Liga-Stufe|Titel|Auto|Zähler – KEIN Trade-G/V (§B11.5)
	local card = table.concat({
		tostring(if okStage and finite(stage) then math.floor(stage) else 1),
		tostring(if okLic and finite(licence) then math.floor(licence) else 1),
		tostring(skill),
		tier,
		if okTitle and type(title) == "string" then title else "",
		car,
		tostring(n),
	}, "|")
	p:SetAttribute("ShowCard", card)
	return { Ok = true, Message = T(p, "soc.showSent") }
end

local function handleInvited(p: Player, arg: any): Reply
	if not emptyArg(arg) then
		return fail(p, "core.invalid")
	end
	call("MetricsService", "Custom", p, "InvitePrompted", 1, nil)
	return { Ok = true }
end

local function handleOptIn(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Result" }) or type(arg.Result) ~= "boolean" then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local notif = data.Notif
	if type(notif) ~= "table" then
		notif = {}
		data.Notif = notif
	end
	notif.LastPrompt = os.time()
	notif.OptIn = arg.Result
	call("MetricsService", "Custom", p, "NotifyOptIn", if arg.Result then 1 else 0, nil)
	markDirty(p, "Social")
	return { Ok = true }
end

-- ---------------------------------------------------------------------
-- 6) EINLADEN (§B11.4): Neuling erreicht Etage 10 + 10 min -> beide Boost x2 30 min + Neon "Partner"
-- ---------------------------------------------------------------------
local function store(): DataStore?
	if refStore or refStoreFailed then
		return refStore
	end
	local name = (Config.Tech or {}).GlobalStore or "AT_Global"
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(name)
	end)
	if ok then
		refStore = result
	else
		refStoreFailed = true
		logError("GetDataStore", result)
	end
	return refStore
end

local function referralReward(): Types.Grant
	local cfg = SOCIAL.Referral
	return { BoostX2 = cfg.BoostSeconds, Cosmetics = { cfg.Neon } }
end

-- Einlader im Server: Wochen-Deckel aus seinem Spielstand
local function rewardInviter(inviter: Player, n: number): number
	local data = dataOf(inviter)
	if not data then
		return 0
	end
	local social = socialOf(data)
	local week = Util.IsoWeek()
	if social.ReferralWeek ~= week then
		social.ReferralWeek = week
		social.ReferralCount = 0
	end
	local room = math.max(0, SOCIAL.Referral.WeeklyMax - social.ReferralCount)
	local count = math.min(n, room)
	if count <= 0 then
		return 0
	end
	local grant = referralReward()
	grant.BoostX2 = (grant.BoostX2 :: number) * count
	local ok, granted = call("ShopService", "Grant", inviter, grant, "Referral")
	if not ok or granted ~= true then
		return 0
	end
	social.ReferralCount += count
	call("ProgressionService", "NoteStat", inviter, "Invites", count, nil)
	notify(inviter, "soc.inviteReward", { count }, "Success")
	markDirty(inviter, "Social")
	return count
end

-- Einlader nicht im Server: Gutschrift im DataStore vormerken (Wochen-Deckel beim Schreiben)
local function queueInviter(inviterId: number)
	local ds = store()
	if not ds then
		return
	end
	local key = (PCFG.Boards.ReferralKeyPrefix or "Ref_") .. tostring(inviterId)
	local week = Util.IsoWeek()
	task.spawn(function()
		local ok, err = pcall(function()
			ds:UpdateAsync(key, function(old: any)
				local entry = if type(old) == "table" then old else {}
				if entry.Week ~= week then
					entry.Week = week
					entry.N = 0
				end
				if num(entry.N, 0) >= SOCIAL.Referral.WeeklyMax then
					return nil -- Deckel erreicht: nichts ändern
				end
				entry.N = num(entry.N, 0) + 1
				entry.Pending = math.clamp(num(entry.Pending, 0) + 1, 0, SOCIAL.Referral.WeeklyMax * 4)
				return entry
			end)
		end)
		if not ok then
			logError("Referral UpdateAsync", err)
		end
	end)
end

-- Grant fehlgeschlagen: Gutschrift zurücklegen (kein Verlust)
local function queueInviterBack(userId: number, n: number)
	local ds = store()
	if not ds then
		return
	end
	local key = (PCFG.Boards.ReferralKeyPrefix or "Ref_") .. tostring(userId)
	task.spawn(function()
		local ok, err = pcall(function()
			ds:UpdateAsync(key, function(old: any)
				local entry = if type(old) == "table" then old else {}
				entry.Pending = math.clamp(num(entry.Pending, 0) + n, 0, SOCIAL.Referral.WeeklyMax * 4)
				return entry
			end)
		end)
		if not ok then
			logError("Referral zurücklegen", err)
		end
	end)
end

-- beim Beitritt (und alle 10 min): vorgemerkte Gutschriften abholen
local function claimQueued(p: Player)
	if p.UserId <= 0 then
		return
	end
	local ds = store()
	if not ds then
		return
	end
	local key = (PCFG.Boards.ReferralKeyPrefix or "Ref_") .. tostring(p.UserId)
	task.spawn(function()
		local pending = 0
		local ok, err = pcall(function()
			ds:UpdateAsync(key, function(old: any)
				if type(old) ~= "table" or num(old.Pending, 0) <= 0 then
					pending = 0
					return nil
				end
				pending = math.floor(num(old.Pending, 0))
				old.Pending = 0
				return old
			end)
		end)
		if not ok then
			logError("Referral claim", err)
			return
		end
		if pending > 0 and p.Parent == Players then
			local data = dataOf(p)
			if not data then
				return
			end
			-- der Wochen-Deckel wurde schon beim Vormerken geprüft
			local grant = referralReward()
			grant.BoostX2 = (grant.BoostX2 :: number) * pending
			local okGrant, granted = call("ShopService", "Grant", p, grant, "Referral")
			if okGrant and granted == true then
				call("ProgressionService", "NoteStat", p, "Invites", pending, nil)
				notify(p, "soc.inviteReward", { pending }, "Success")
				markDirty(p, "Social")
			else
				queueInviterBack(p.UserId, pending)
			end
		end
	end)
end

local function checkReferral(p: Player)
	local data = dataOf(p)
	if not data then
		return
	end
	local social = socialOf(data)
	if social.ReferralDone or social.ReferredBy <= 0 then
		return
	end
	local okFloors, floors = call("TowerService", "Floors", p)
	if not okFloors or not finite(floors) or floors < SOCIAL.Referral.Floor then
		return
	end
	-- Gesamtspielzeit = Stand beim Beitritt + diese Sitzung (Data.Playtime enthält die Sitzung nach jedem Auto-Save
	-- schon teilweise -> nicht doppelt zählen)
	local base = playBase[p] or num(data.Playtime, 0)
	local played = base + (os.clock() - (sessionStart[p] or os.clock()))
	if played < SOCIAL.Referral.PlayMinutes * 60 then
		return
	end
	local ok, granted = call("ShopService", "Grant", p, referralReward(), "Referral")
	if not ok or granted ~= true then
		return
	end
	social.ReferralDone = true
	notify(p, "soc.inviteNewbie", nil, "Success")
	markDirty(p, "Social")
	local inviter = Players:GetPlayerByUserId(social.ReferredBy)
	if inviter then
		rewardInviter(inviter, 1)
	else
		queueInviter(social.ReferredBy)
	end
end

-- Beitritts-Daten (pcall; Studio/Fehler -> leere Tabelle)
local function joinDataOf(p: Player): { [string]: any }
	local ok, joinData = pcall(function()
		return p:GetJoinData()
	end)
	return if ok and type(joinData) == "table" then joinData :: any else {}
end

-- Launch-Daten -> UserId des Towers, den man besuchen soll: "visit:<UserId>" / "visit=<UserId>" / JSON {"visit": id}
local function parseLaunch(raw: any): number?
	if type(raw) ~= "string" or #raw == 0 or #raw > LAUNCH_MAX then
		return nil
	end
	local id: number? = tonumber(string.match(raw, "^%s*[Vv]isit%s*[:=]%s*(%d+)%s*$"))
	if not id then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if ok and type(decoded) == "table" then
			local value = decoded.visit or decoded.Visit
			id = if isInt(value) then value elseif type(value) == "string" then tonumber(value) else nil
		end
	end
	if id and isInt(id) and id > 0 then
		return id
	end
	return nil
end

local function readLaunch(p: Player, joinData: { [string]: any })
	local target = parseLaunch(joinData.LaunchData)
	if target and target ~= p.UserId then
		launchVisit[p] = target
		call("MetricsService", "Custom", p, "LaunchVisit", 1, nil)
		markDirty(p, "Social")
	end
end

local function readReferral(p: Player, data: Data, joinData: { [string]: any })
	local social = socialOf(data)
	if social.ReferredBy > 0 or num(data.Sessions, 0) > 1 then
		return
	end
	local inviterId = joinData.ReferredByPlayerId
	if isInt(inviterId) and inviterId > 0 and inviterId ~= p.UserId then
		social.ReferredBy = inviterId
		call("MetricsService", "Custom", p, "Referred", 1, nil)
		markDirty(p, "Social")
	end
end

-- ---------------------------------------------------------------------
-- 7) GRUPPE (IsInGroupAsync, pcall): Community-Krone + Namensschild-Rahmen, kein Einkommen
-- ---------------------------------------------------------------------
local function checkGroup(p: Player, recheck: boolean?)
	local groupId = SOCIAL.GroupId
	if not isInt(groupId) or groupId <= 0 or p.UserId <= 0 or groupBusy[p] then
		return
	end
	groupBusy[p] = true
	groupCheckAt[p] = os.clock()
	task.spawn(function()
		local ok, result = pcall(function()
			if recheck then
				-- Nachprüfung: aktuelle Gruppenliste (IsInGroup* kann den Stand vom Beitritt zwischenspeichern)
				for _, entry in ipairs(GroupService:GetGroupsAsync(p.UserId)) do
					if type(entry) == "table" and entry.Id == groupId then
						return true
					end
				end
				return false
			end
			local subject: any = p
			local method = subject.IsInGroupAsync
			if type(method) == "function" then
				return method(subject, groupId)
			end
			return subject:IsInGroup(groupId)
		end)
		groupBusy[p] = nil
		if not ok then
			logError("IsInGroupAsync", result)
			return
		end
		if p.Parent ~= Players then
			return
		end
		local data = dataOf(p)
		if data then
			local social = socialOf(data)
			if recheck and result == true and social.Group ~= true then
				notify(p, "soc.groupJoined", nil, "Success")
			end
			social.Group = result == true
			p:SetAttribute("Group", social.Group)
			markDirty(p, "Social", "Life")
		end
	end)
end

-- ---------------------------------------------------------------------
-- 8) STATE "Social" (§C10)
-- ---------------------------------------------------------------------
local function socialState(p: Player): { [string]: any }
	local data = dataOf(p)
	if not data then
		return { RespektActive = 0, Friends = 0 }
	end
	local social = socialOf(data)
	local day = Util.UtcDay()
	local givenToday = 0
	if social.RespektDay == day then
		for _, value in pairs(social.RespektGiven) do
			if value == day then
				givenToday += 1
			end
		end
	end
	local given: { [string]: boolean } = {}
	if social.RespektDay == day then
		for key, value in pairs(social.RespektGiven) do
			if value == day then
				given[key] = true
			end
		end
	end
	local notif = if type(data.Notif) == "table" then data.Notif else {}
	local flags = if type(data.Flags) == "table" then data.Flags else {}
	local okStage, stage = call("TowerService", "Stage", p)
	local stageNow = if okStage and finite(stage) then stage else 1
	local lastPrompt = num(notif.LastPrompt, 0)
	local tutStep = math.floor(num(flags.TutStep, 0))
	local tutorialDone = flags.Done == true or flags.Skipped == true
	return {
		RespektGivenToday = givenToday,
		RespektGiven = given,
		RespektActive = CommunityService.RespektActive(p),
		RespektWeek = weekRespekt(social),
		Friends = CommunityService.FriendsInServer(p),
		ReferredBy = social.ReferredBy,
		ReferralDone = social.ReferralDone,
		ReferralCount = if social.ReferralWeek == Util.IsoWeek() then social.ReferralCount else 0,
		ReferralMax = SOCIAL.Referral.WeeklyMax,
		LaunchVisit = launchVisit[p] or 0,
		LaunchVisitHere = launchVisit[p] ~= nil and Players:GetPlayerByUserId(launchVisit[p] :: number) ~= nil,
		Group = social.Group,
		GroupId = SOCIAL.GroupId,
		InviteAllowed = stageNow >= SOCIAL.InviteFromStage,
		SocialReady = accountAgeOk(p) and sessionOk(p),
		NotifLastPrompt = lastPrompt,
		NotifOptIn = notif.OptIn == true,
		CanPromptNotify = (tutorialDone or tutStep >= num(Config.Notifications.PromptAfterStep, 17))
			and os.time() - lastPrompt >= SOCIAL.NotifyRepromptDays * 86400,
	}
end

-- ---------------------------------------------------------------------
-- 9) LEBENSZYKLUS
-- ---------------------------------------------------------------------
local function onPlayerAdded(p: Player)
	sessionStart[p] = os.clock()
	friendCache[p] = friendCache[p] or {}
	friendBusy[p] = friendBusy[p] or {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= p and friendCache[other] then
			checkPair(p, other)
		end
		if launchVisit[other] == p.UserId then
			markDirty(other, "Social") -- der eingeladene Spieler wartet auf diesen Tower-Besitzer
		end
	end
end

local function onReady(p: Player)
	local data = dataOf(p)
	if not data then
		return
	end
	local social = socialOf(data)
	playBase[p] = math.max(0, num(data.Playtime, 0))
	p:SetAttribute("Group", social.Group)
	local joinData = joinDataOf(p)
	readReferral(p, data, joinData)
	readLaunch(p, joinData)
	checkGroup(p, false)
	refClaimAt[p] = os.clock()
	claimQueued(p)
	markDirty(p, "Social")
end

local function onPlayerRemoving(p: Player)
	sessionStart[p] = nil
	friendCache[p] = nil
	friendBusy[p] = nil
	respektActive[p] = nil
	reactCounter[p] = nil
	showCounter[p] = nil
	refClaimAt[p] = nil
	playBase[p] = nil
	launchVisit[p] = nil
	groupCheckAt[p] = nil
	groupBusy[p] = nil
	for _, cache in pairs(friendCache) do
		cache[p.UserId] = nil
	end
	-- Freunde-Bonus der anderen ändert sich
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= p then
			markDirty(other, "Social")
		end
	end
end

local function referralTick()
	for _, p in ipairs(Players:GetPlayers()) do
		local ok, ready = call("PlayerStateService", "IsReady", p)
		if ok and ready == true then
			checkReferral(p)
			-- Gruppe nachprüfen (nur Nicht-Mitglieder; Beitritt über den Knopf im Sozial-Fenster)
			local data = dataOf(p)
			local social = data and data.Social
			if
				type(social) == "table"
				and social.Group ~= true
				and os.clock() - (groupCheckAt[p] or 0) >= GROUP_RECHECK
			then
				checkGroup(p, true)
			end
			if os.clock() - (refClaimAt[p] or 0) >= REFERRAL_CLAIM_EVERY then
				refClaimAt[p] = os.clock()
				claimQueued(p)
			end
		end
	end
end

function CommunityService.Init(services: any)
	Services = services
	local pss = services.PlayerStateService
	if not pss then
		warn("[CommunityService] PlayerStateService fehlt – keine Anfragen/State")
		return
	end
	pss.Provide("Social", socialState)
	pss.Handle("SocialRespekt", handleRespekt, { Rate = 1, Per = 1 })
	pss.Handle("SocialReact", handleReact, { Rate = 2, Per = 1 })
	pss.Handle("SocialShow", handleShow, { Rate = 1, Per = 60 })
	pss.Handle("SocialInvited", handleInvited, { Rate = 1, Per = 10 })
	pss.Handle("NotifyOptIn", handleOptIn, { Rate = 1, Per = 10 })
end

function CommunityService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end
	call("PlayerStateService", "OnReady", onReady)
	Scheduler.Every("CommunityReferral", 1 / REFERRAL_EVERY, referralTick)
end

return CommunityService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Spielstände (Server/Services/DataService)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C5.2 + §C12 (CC-Kopie 1:1 mit allen Fixes, REUSE §3.9/§7):
--    * DataStore "AT_Player_v1", Schlüssel "P_<UserId>", Datensatz { Data, Lock = { JobId, Time } }
--    * Session-Lock: ein Spielstand ist immer nur in EINEM Server offen (keine Duplikate)
--    * 6 Lade-Versuche, fremdes Lock (< 30 Min) -> 5 s warten, letzter Versuch übernimmt (mit warn beider JobIds)
--    * Speichern: 4 Versuche, nie über ein fremdes Lock schreiben, Saves pro Profil SERIALISIERT
--      (ein Auto-Save kann den Release nicht überholen, während des Release wird nie ein Lock gesetzt)
--    * Auto-Save alle 90 s aus einer Schnappschuss-Liste, 0,5 s versetzt, jedes Save in pcall (eigener Thread)
--    * Studio: NoSave (Config.Studio.NoSave, Test-Spieler mit UserId <= 0, oder kein API-Zugriff)
--    * Live: Laden fehlgeschlagen -> Kick mit Meldung (nie mit leerem Stand spielen)
--    * Laden: Migrate (Version) -> Reconcile -> Sanitize (falsche Typen/NaN -> Standard) -> Reconcile ->
--      String-Schlüssel (auch in Listen) -> Ringpuffer kürzen. SavedAt = Server-os.time() bei JEDEM Speichern
--      (auch im finalen Release-Save); LastSavedAt(p) liefert den Wert vom Laden (Offline-Abrechnung).
--
--  Öffentliche API:
--    DataService.Get(p): PlayerData?                 nil, solange nicht geladen
--    DataService.IsLoaded(p): boolean
--    DataService.IsNoSave(p): boolean
--    DataService.NoSaveReason(p): ("Config" | "TestPlayer" | "NoApi")?
--    DataService.OnProfileLoaded(cb(p, data))        jeder Callback per task.spawn nach dem Laden (später registriert -> nachgereicht)
--    DataService.OnProfileReleasing(cb(p, data))     pcall, VOR dem letzten Speichern
--    DataService.Save(p): boolean                    yieldet; NoSave -> true; während Release -> false
--    DataService.Reset(p): boolean                   frischer Stand, behält Purchases.Receipts/Starter/PassSeasons/RobuxSpent
--    DataService.Migrate(data)                       Versions-Schritte + Reparatur (idempotent, siehe oben)
--    DataService.DefaultData(): PlayerData           Kopie von DEFAULT_DATA (SelfTest)
--    DataService.LastSavedAt(p): number              SavedAt beim Laden (für Offline), 0 = neu
--    DataService.Profiles                            { [Player]: Profile } (nur lesen)
--  WP1 pflegt V, Created, SavedAt, Playtime, Sessions; jedes andere Feld (auch LastUtcDay, Tages-Logik WP9) schreibt
--  sein Besitzer-WP (§C12).
-- =====================================================================

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Lang = require(Shared:WaitForChild("Lang"))
local Types = require(Shared:WaitForChild("Types"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local DataService = {}
local Services: any = nil

type PlayerData = Types.PlayerData
type NoSaveReason = "Config" | "TestPlayer" | "NoApi"
type Profile = {
	Loaded: boolean,
	Data: PlayerData?,
	NoSave: boolean,
	NoSaveReason: NoSaveReason?,
	Releasing: boolean,
	Saving: boolean,
	PlayBase: number, -- Playtime beim Laden
	SessionStart: number, -- os.clock() beim Laden
	LoadedSavedAt: number, -- SavedAt beim Laden (Offline-Abrechnung), 0 = neu
}

DataService.Profiles = {} :: { [Player]: Profile }
local Profiles = DataService.Profiles

local TECH = Config.Tech
local DATA_VERSION = math.max(1, math.floor(tonumber(TECH.DataVersion) or 1))
local KEY_PREFIX = if type(TECH.KeyPrefix) == "string" and TECH.KeyPrefix ~= "" then TECH.KeyPrefix else "P_"
local LOAD_ATTEMPTS = math.max(1, math.floor(tonumber(TECH.LoadAttempts) or 6))
local SAVE_ATTEMPTS = math.max(1, math.floor(tonumber(TECH.SaveAttempts) or 4))
local LOCK_STALE = tonumber(TECH.LockStaleSeconds) or 1800 -- ein Lock älter als 30 Min gilt als verwaist
local LOCK_WAIT = 5 -- Sekunden warten, wenn ein anderer Server den Stand noch offen hat
local RECEIPT_KEEP = math.max(1, math.floor(tonumber(TECH.ReceiptKeep) or 60))
local SAVE_QUEUE_TIMEOUT = 60 -- so lange wartet ein Save höchstens auf ein laufendes
local RELEASE_WAIT_TIMEOUT = 35 -- zweiter Release-Aufrufer wartet höchstens so lange
local SANITIZE_DEPTH = 6
local MAX_ARRAY_CHECK = 128
local KEYS_DEPTH = 12 -- String-Schlüssel-Reparatur: so tief
local KEYS_MAX_NODES = 20000 -- … und höchstens so viele Tabellen je Durchlauf

-- Ringpuffer (§C12.1): Pfad -> höchstens so viele Einträge (älteste zuerst raus). Orders/Alerts NICHT kürzen
-- (Reservierungen gehören WP4 – die Grenzen 50/18 setzt OrderService beim Anlegen durch).
local RINGS: { { Path: { string }, Max: number } } = {
	{ Path = { "Purchases", "Receipts" }, Max = RECEIPT_KEEP },
	{ Path = { "Depot", "Fills" }, Max = 100 },
	{ Path = { "Depot", "Nav" }, Max = 72 },
	{ Path = { "League", "Returns" }, Max = 504 },
}

-- ---------------------------------------------------------------------
-- 1) STANDARD-SPIELSTAND (§C12.1) – nur String-Schlüssel in Dictionaries, nie nil (leere Tabellen/false/0)
-- ---------------------------------------------------------------------
local DEFAULT_DATA: PlayerData = {
	V = DATA_VERSION,
	Created = 0,
	SavedAt = 0,
	LastUtcDay = 0,
	Playtime = 0,
	Sessions = 0,
	Credits = 0, -- CR, ganzzahlig, ≤ 9e15 (WP10 ShopService)
	Depot = { -- Cent; einziger Schreiber OrderService/Portfolio (WP4)
		V = 1,
		Cash = 2500000,
		Basis = 2500000, -- 25.000 AKY
		Pos = {},
		Short = {},
		Orders = {},
		Alerts = {},
		Watch = { {} },
		Fills = {},
		Nav = {},
		Seq = {},
		NextId = 1,
		LastTick = 0,
		LastTransferDay = -1,
		LastRefillUtcDay = -1,
		AutoTransfer = true,
		Bots = {},
		Stats = {
			Trades = 0,
			Wins = 0,
			Losses = 0,
			GrossWin = 0,
			GrossLoss = 0,
			PeakNav = 0,
			MaxDD = 0,
			BestPct = 0,
			ReadWell = 0,
		},
		Tutorial = { T0 = 0, Q = 0, Done = false },
	},
	League = { Week = 0, Returns = {}, Trades = 0, Days = 0, Tainted = false, LastGrantedWeek = 0, Trophies = {} }, -- WP4/WP9
	Tower = { -- WP6
		Floors = {},
		Vault = 0,
		Build = {},
		Eff = 0,
		Skin = "GlassBlue",
		Neon = "Accent",
		Crown = "",
		Name = { A = 1, N = 1 },
		Private = {},
		RunSpend = 0,
		KeepLayout = true,
		Layouts = {},
		Express = {},
		Instant = 0,
		InstantDay = 0,
		Helpers = {},
	},
	Garage = { Cars = { LamCity = true }, Active = "LamCity", Tune = {} }, -- WP7
	Life = { Watches = {}, Accessories = {}, Equipped = { Watch = "", Acc = {} } }, -- WP8
	Storage = { Decor = {} }, -- [key] = Anzahl (WP8)
	Prog = { -- WP9
		Xp = 0,
		Licence = 1,
		Exams = {},
		ExamProgress = {},
		Lessons = {},
		KH = {},
		KHSpent = 0,
		KHResetWeek = 0,
		Ruf = 0,
		RufDay = 0,
		RufToday = 0,
		Title = "",
		Titles = {},
		Album = {},
		Ach = {},
		AchProgress = {},
		Badges = {},
		XpDay = 0,
		XpCounts = {},
		Prestige = { Count = 0, Stars = 0, Perks = {}, Firmenwert = 0, Tickers = {}, RespecFree = false },
	},
	Quests = { Day = 0, Daily = {}, Rerolled = false, Week = 0, Weekly = {}, Starter = 1, StarterDone = {} }, -- WP9
	Login = { LastDay = 0, Streak = 0, Best = 0, Freeze = 1, FreezeWeek = 0, Cycle = 1, Track = 0 }, -- WP9
	Season = { Id = 1, Xp = 0, Premium = false, ClaimedFree = {}, ClaimedPremium = {}, PlayToday = 0, PlayDay = 0 }, -- WP9
	Social = { -- WP9
		RespektGiven = {},
		RespektDay = 0,
		ReferredBy = 0,
		ReferralDone = false,
		ReferralWeek = 0,
		ReferralCount = 0,
		Group = false,
	},
	Boosts = { X2 = 0, X5 = 0, Bull = 0 }, -- Rest-Spielsekunden (WP6/WP10)
	Notif = { LastPrompt = 0, OptIn = false }, -- WP9
	Purchases = {
		Receipts = {},
		RobuxSpent = 0,
		Starter = false,
		PassSeasons = {},
		Quote = {},
		ClubClaimDay = 0,
		Gifts = 0,
	}, -- WP10
	Stats = { -- AdminCredits/AdminAky = Admin-Geschenke in CR / AKY-Cent (Wunsch 18; zählen nie für die Liga)
		LifetimeCredits = 0,
		Collected = 0,
		FloorsBuilt = 0,
		Ipos = 0,
		Drive = 0,
		Pickups = 0,
		AdminCredits = 0,
		AdminAky = 0,
	},
	Settings = {}, -- WP1 (Schema Config.Client.SettingsSchema, Standardwerte beim Laden ergänzt)
	Flags = {}, -- WP1 (TutorialFlag) + Besitzer-WPs (z. B. Flags.TutorialTrade WP4)
	Mod = {}, -- WP11 (Verwarnungen, harte Kicks)
}

local function freshData(): PlayerData
	return Util.DeepCopy(DEFAULT_DATA)
end

-- ---------------------------------------------------------------------
-- 2) MIGRATION + BEREINIGUNG
-- ---------------------------------------------------------------------
local function isArray(t: { [any]: any }): boolean
	return t[1] ~= nil
end

-- Felder mit falschem Typ / kaputten Zahlen auf nil setzen -> Reconcile trägt danach den Standard ein.
-- Geht in "Datensätze" (Tabellen mit festen Feldern) und in Listen von Datensätzen (erstes Element = Muster).
local function sanitize(target: { [any]: any }, template: { [any]: any }, depth: number)
	if depth > SANITIZE_DEPTH then
		return
	end
	for key, default in pairs(template) do
		local value = target[key]
		if value == nil then
			continue
		end
		local kind = type(value)
		if kind ~= type(default) or (kind == "number" and not Util.IsFinite(value)) then
			-- falscher Typ oder NaN/unendlich -> Standard (Reconcile)
			target[key] = nil
		elseif kind == "table" and next(default) ~= nil then
			if isArray(default) and type(default[1]) == "table" then
				-- Liste von Datensätzen: jedes Element gegen das erste Muster prüfen
				local pattern = default[1]
				local count = 0
				for index, element in ipairs(value) do
					count += 1
					if count > MAX_ARRAY_CHECK then
						break
					end
					if type(element) ~= "table" then
						value[index] = Util.DeepCopy(default[index] or pattern)
					else
						sanitize(element, default[index] or pattern, depth + 1)
						Util.Reconcile(element, default[index] or pattern)
					end
				end
			elseif not isArray(default) then
				sanitize(value, default, depth + 1)
			end
		end
	end
end

-- Ist t eine lückenlose Liste 1..n (JSON-Array)?
local function isProperArray(t: { [any]: any }): boolean
	local count = 0
	for key in pairs(t) do
		if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then
			return false
		end
		count += 1
	end
	return count == #t
end

-- DataStore-sicher machen (auch tief in Listen): Dictionaries nur mit String-Schlüsseln (Zahl-Schlüssel ->
-- tostring, andere Schlüssel weg), NaN/±unendlich -> 0, nicht speicherbare Werte (Instanzen, Funktionen,
-- Vector3 …) weg. Tabellen-Identität bleibt erhalten (andere Services halten Verweise).
local function ensureStringKeys(root: { [any]: any })
	local nodes = 0
	local visited: { [any]: boolean } = {}
	local function fix(t: { [any]: any }, depth: number)
		if depth > KEYS_DEPTH or visited[t] or nodes >= KEYS_MAX_NODES then
			return
		end
		visited[t] = true
		nodes += 1
		local array = isProperArray(t)
		for _, key in ipairs(Util.Snapshot(t)) do
			local value = t[key]
			local kind = type(value)
			if kind == "number" and not Util.IsFinite(value) then
				t[key] = 0
			elseif kind ~= "number" and kind ~= "string" and kind ~= "boolean" and kind ~= "table" then
				t[key] = nil -- nicht speicherbar
				continue
			end
			if not array and type(key) ~= "string" then
				t[key] = nil
				if type(key) == "number" and Util.IsFinite(key) then
					local text = if key % 1 == 0 then string.format("%d", key) else tostring(key)
					if t[text] == nil then
						t[text] = value
					end
				end
			end
			if kind == "table" then
				fix(value, depth + 1)
			end
		end
	end
	fix(root, 1)
end

local function trimRings(data: PlayerData)
	for _, ring in ipairs(RINGS) do
		local node: any = data
		for _, part in ipairs(ring.Path) do
			node = if type(node) == "table" then node[part] else nil
		end
		if type(node) == "table" and #node > ring.Max then
			local excess = #node - ring.Max
			table.move(node, excess + 1, #node, 1)
			for i = #node, ring.Max + 1, -1 do
				node[i] = nil
			end
		end
	end
end

function DataService.Migrate(data: PlayerData)
	if type(data) ~= "table" then
		return
	end
	-- 1) Versions-Schritte (§C12.2): nie Felder löschen, nur umbenennen/umrechnen
	local version = data.V
	if not Util.IsFinite(version) then
		data.V = 1
		version = 1
	end
	if version > DATA_VERSION then
		warn(("[DataService] Spielstand-Version %d ist neuer als dieser Server (%d)"):format(version, DATA_VERSION))
	end
	-- künftige Schritte hier anhängen:  if data.V < 2 then … data.V = 2 end
	-- 2) Reconcile -> 3) Sanitize -> Reconcile (Reparaturen wieder auffüllen)
	Util.Reconcile(data, DEFAULT_DATA)
	sanitize(data, DEFAULT_DATA, 1)
	Util.Reconcile(data, DEFAULT_DATA)
	-- 4) String-Schlüssel + speicherbare Werte, 5) Ringpuffer
	ensureStringKeys(data)
	trimRings(data)
	data.V = math.max(data.V, DATA_VERSION) -- nie herunterstufen
end

function DataService.DefaultData(): PlayerData
	return freshData()
end

-- ---------------------------------------------------------------------
-- 3) DATASTORE
-- ---------------------------------------------------------------------
local store: DataStore? = nil
local storeError: string? = nil

local function getStore(): DataStore?
	if store or storeError then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(TECH.DataStoreName)
	end)
	if ok then
		store = result
	else
		local message = tostring(result)
		storeError = message
		warn("[DataService] DataStore nicht verfügbar: " .. message)
	end
	return store
end

local function keyFor(userId: number): string
	return KEY_PREFIX .. string.format("%d", userId)
end

local function jobId(): string
	return if game.JobId ~= "" then game.JobId else "studio"
end

-- Fehlermeldungen, die im Studio bedeuten: DataStores sind hier gar nicht erreichbar
local function isStudioAccessError(err: any): boolean
	local text = string.lower(tostring(err))
	return string.find(text, "studio", 1, true) ~= nil
		or string.find(text, "publish", 1, true) ~= nil
		or string.find(text, "api services", 1, true) ~= nil
		or string.find(text, "403", 1, true) ~= nil
end

local function lockOf(record: any): { JobId: any, Time: any }?
	if type(record) == "table" and type(record.Lock) == "table" then
		return record.Lock
	end
	return nil
end

-- Lädt + sperrt den Spielstand. Gibt (true, data) oder (false, grund) zurück.
local function loadData(userId: number): (boolean, any)
	local ds = getStore()
	if not ds then
		return false, storeError or "DataStore nicht verfügbar"
	end
	for attempt = 1, LOAD_ATTEMPTS do
		local lockedByOther = false
		local tookOverFrom: string? = nil
		local forceTake = attempt == LOAD_ATTEMPTS
		local ok, result = pcall(function()
			return ds:UpdateAsync(keyFor(userId), function(old)
				-- kann mehrfach aufgerufen werden -> Merker jedes Mal neu setzen; KEIN yield hier
				lockedByOther = false
				tookOverFrom = nil
				local record = if type(old) == "table" then old else {}
				local lock = lockOf(record)
				if lock and lock.JobId ~= jobId() then
					local age = os.time() - (tonumber(lock.Time) or 0)
					if age < LOCK_STALE then
						if not forceTake then
							lockedByOther = true
							return nil -- nichts schreiben
						end
						tookOverFrom = tostring(lock.JobId)
					end
				end
				record.Lock = { JobId = jobId(), Time = os.time() }
				return record
			end)
		end)
		if ok and not lockedByOther then
			if tookOverFrom then
				-- REUSE §7 #24: Übernahme eines (noch nicht verwaisten) Locks sichtbar machen
				warn(
					("[DataService] Lock von Server %s übernommen (dieser Server %s) für UserId %d"):format(
						tookOverFrom,
						jobId(),
						userId
					)
				)
			end
			local data = if type(result) == "table" and type(result.Data) == "table" then result.Data else freshData()
			-- erst migrieren (Version prüfen), dabei Reconcile + Sanitize + String-Schlüssel
			local migrated, err = pcall(DataService.Migrate, data)
			if not migrated then
				warn("[DataService] Migration fehlgeschlagen: " .. tostring(err))
				Util.Reconcile(data, DEFAULT_DATA)
			end
			return true, data
		end
		if not ok then
			warn(("[DataService] Laden fehlgeschlagen (Versuch %d): %s"):format(attempt, tostring(result)))
			-- Studio ohne API-Zugriff / unveröffentlichter Ort: sofort aufgeben (Studio-Test startet gleich)
			if RunService:IsStudio() and isStudioAccessError(result) then
				return false, "studio"
			end
		end
		if attempt < LOAD_ATTEMPTS then
			task.wait(if lockedByOther then LOCK_WAIT else attempt * 1.5)
		end
	end
	return false, "Konnte Spielstand nicht laden"
end

-- Schreibt den Spielstand. release = true gibt das Lock frei.
local function saveData(userId: number, data: PlayerData, release: boolean, profile: Profile?): boolean
	local ds = getStore()
	if not ds then
		return false
	end
	for attempt = 1, SAVE_ATTEMPTS do
		local lostLock = false
		local ok, err = pcall(function()
			ds:UpdateAsync(keyFor(userId), function(old)
				lostLock = false
				local lock = lockOf(old)
				if lock and lock.JobId ~= jobId() then
					-- Ein anderer Server hat den Spielstand übernommen -> NICHT überschreiben
					lostLock = true
					return nil
				end
				-- REUSE §7 #22: läuft schon der Release, nie wieder ein Lock setzen
				local keepLock = not release and not (profile and profile.Releasing)
				return {
					Data = data,
					Lock = if keepLock then { JobId = jobId(), Time = os.time() } else nil,
				}
			end)
		end)
		if ok then
			if lostLock then
				warn(
					("[DataService] Speichern abgelehnt: Spielstand %d gehört jetzt einem anderen Server"):format(
						userId
					)
				)
			end
			return not lostLock
		end
		warn(("[DataService] Speichern fehlgeschlagen (Versuch %d): %s"):format(attempt, tostring(err)))
		if attempt < SAVE_ATTEMPTS then
			task.wait(attempt * 1.5)
		end
	end
	return false
end

-- ---------------------------------------------------------------------
-- 4) PROFILE
-- ---------------------------------------------------------------------
local loadedCallbacks: { (Player, PlayerData) -> () } = {}
local releasingCallbacks: { (Player, PlayerData) -> () } = {}
local started = false

local function runLoaded(callback: (Player, PlayerData) -> (), player: Player, data: PlayerData)
	local ok, err = xpcall(callback, debug.traceback, player, data)
	if not ok then
		warn("[DataService] OnProfileLoaded-Callback Fehler: " .. tostring(err))
	end
end

function DataService.OnProfileLoaded(callback: (p: Player, data: PlayerData) -> ())
	table.insert(loadedCallbacks, callback)
	if started then
		-- später registriert: schon geladene Profile nachreichen
		for _, player in ipairs(Util.Snapshot(Profiles)) do
			local profile = Profiles[player]
			if profile and profile.Loaded and not profile.Releasing and profile.Data then
				task.spawn(runLoaded, callback, player, profile.Data)
			end
		end
	end
end

-- Wird VOR dem finalen Speichern aufgerufen (laufende Aktionen abbrechen, Bestenliste schreiben …)
function DataService.OnProfileReleasing(callback: (p: Player, data: PlayerData) -> ())
	table.insert(releasingCallbacks, callback)
end

function DataService.Get(player: Player): PlayerData?
	local profile = Profiles[player]
	if profile and profile.Loaded then
		return profile.Data
	end
	return nil
end

function DataService.IsLoaded(player: Player): boolean
	local profile = Profiles[player]
	return profile ~= nil and profile.Loaded == true
end

function DataService.IsNoSave(player: Player): boolean
	local profile = Profiles[player]
	return profile ~= nil and profile.NoSave == true
end

function DataService.NoSaveReason(player: Player): NoSaveReason?
	local profile = Profiles[player]
	return if profile and profile.NoSave then profile.NoSaveReason else nil
end

function DataService.LastSavedAt(player: Player): number
	local profile = Profiles[player]
	return if profile and profile.Loaded then profile.LoadedSavedAt else 0
end

-- WP1-Felder vor jedem Speichern fortschreiben: Spielzeit + Server-Zeitstempel (Offline-Abrechnung beim nächsten
-- Laden; auch bei Absturz ohne Release liegt SavedAt so höchstens ein Auto-Save-Intervall zurück).
-- LastUtcDay schreibt WP1 bewusst NICHT: der Tageswechsel gehört dem Besitzer der Tages-Logik (WP9) – ein
-- automatischer Stempel um Mitternacht würde dessen Tages-Reset für die laufende Sitzung verschlucken.
local function stampSession(profile: Profile)
	local data = profile.Data
	if data then
		data.Playtime = profile.PlayBase + math.max(0, math.floor(os.clock() - profile.SessionStart))
		data.SavedAt = os.time()
	end
end

-- Vor dem Schreiben DataStore-sicher machen (kein yield)
local function prepareForSave(data: PlayerData)
	local ok, err = pcall(ensureStringKeys, data)
	if not ok then
		warn("[DataService] Bereinigung vor dem Speichern fehlgeschlagen: " .. tostring(err))
	end
end

-- Saves pro Profil hintereinander (REUSE §7 #22). fn darf yielden.
local function serialized(profile: Profile, fn: () -> boolean): boolean
	local waited = os.clock()
	while profile.Saving do
		if os.clock() - waited > SAVE_QUEUE_TIMEOUT then
			warn("[DataService] Warten auf laufendes Speichern abgebrochen")
			return false
		end
		task.wait(0.1)
	end
	profile.Saving = true
	local ok, result = pcall(fn)
	profile.Saving = false
	if not ok then
		warn("[DataService] Speicherfehler: " .. tostring(result))
		return false
	end
	return result == true
end

function DataService.Save(player: Player): boolean
	local profile = Profiles[player]
	if not profile or not profile.Loaded then
		return false
	end
	if profile.NoSave then
		return true
	end
	if profile.Releasing then
		return false -- der Release speichert gleich ohnehin
	end
	return serialized(profile, function()
		if profile.Releasing or Profiles[player] ~= profile then
			return false
		end
		local data = profile.Data
		if not data then
			return false
		end
		stampSession(profile)
		prepareForSave(data)
		return saveData(player.UserId, data, false, profile)
	end)
end

local function newProfile(): Profile
	return {
		Loaded = false,
		Data = nil,
		NoSave = false,
		NoSaveReason = nil,
		Releasing = false,
		Saving = false,
		PlayBase = 0,
		SessionStart = os.clock(),
		LoadedSavedAt = 0,
	}
end

local function onPlayerAdded(player: Player)
	if Profiles[player] then
		return -- schon in Arbeit (Start-Schleife + PlayerAdded)
	end
	local profile = newProfile()
	Profiles[player] = profile

	local data: PlayerData
	local noSaveReason: NoSaveReason? = nil
	if RunService:IsStudio() and (Config.Studio.NoSave == true or player.UserId <= 0) then
		-- Studio-Test: nie den Live-Speicher anfassen (REUSE §7 #23)
		data = freshData()
		noSaveReason = if Config.Studio.NoSave == true then "Config" else "TestPlayer"
	else
		local ok, result = loadData(player.UserId)
		if ok then
			data = result
		elseif RunService:IsStudio() then
			warn(
				"[DataService] Studio: Speichern ist AUS. Aktiviere in Game Settings > Security "
					.. "'Enable Studio Access to API Services'."
			)
			data = freshData()
			noSaveReason = "NoApi"
		else
			if Profiles[player] == profile then
				Profiles[player] = nil
			end
			if player.Parent then
				player:Kick(Lang.T(Lang.For(player), "core.loadFailed"))
			end
			return
		end
	end

	if not player.Parent or Profiles[player] ~= profile or profile.Releasing then
		-- Spieler hat das Spiel während des Ladens verlassen -> Lock sofort freigeben (Daten unverändert)
		if noSaveReason == nil then
			saveData(player.UserId, data, true, nil)
		end
		if Profiles[player] == profile then
			Profiles[player] = nil
		end
		return
	end

	-- WP1-Felder
	local now = os.time()
	if not Util.IsFinite(data.Created) or data.Created <= 0 then
		data.Created = now
	end
	profile.LoadedSavedAt = if Util.IsFinite(data.SavedAt) and data.SavedAt > 0 then math.min(data.SavedAt, now) else 0
	data.Sessions = (if Util.IsFinite(data.Sessions) then math.max(0, data.Sessions) else 0) + 1
	profile.PlayBase = if Util.IsFinite(data.Playtime) then math.max(0, data.Playtime) else 0
	profile.SessionStart = os.clock()

	profile.Data = data
	profile.NoSave = noSaveReason ~= nil
	profile.NoSaveReason = noSaveReason
	profile.Loaded = true
	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(runLoaded, callback, player, data)
	end
end

local function releaseProfile(player: Player)
	local profile = Profiles[player]
	if not profile then
		return
	end
	if profile.Releasing then
		-- wird bereits gespeichert (PlayerRemoving + BindToClose gleichzeitig) -> warten bis fertig
		local start = os.clock()
		while Profiles[player] == profile and os.clock() - start < RELEASE_WAIT_TIMEOUT do
			task.wait(0.1)
		end
		return
	end
	profile.Releasing = true
	local data = profile.Data
	if profile.Loaded and data then
		for _, callback in ipairs(releasingCallbacks) do
			local ok, err = pcall(callback, player, data)
			if not ok then
				warn("[DataService] OnProfileReleasing-Callback Fehler: " .. tostring(err))
			end
		end
		if not profile.NoSave then
			-- wartet auf ein laufendes Auto-Save, dann letzter Save mit Lock = nil (SavedAt = jetzt)
			serialized(profile, function()
				stampSession(profile)
				prepareForSave(data)
				return saveData(player.UserId, data, true, profile)
			end)
		end
	end
	if Profiles[player] == profile then
		Profiles[player] = nil
	end
end

-- Spielstand komplett zurücksetzen (Admin). Käufe bleiben verbucht.
function DataService.Reset(player: Player): boolean
	local profile = Profiles[player]
	if not profile or not profile.Loaded or profile.Releasing or not profile.Data then
		return false
	end
	local data = profile.Data :: PlayerData
	local fresh = freshData()
	local oldPurchases = data.Purchases
	if type(oldPurchases) == "table" then
		if type(oldPurchases.Receipts) == "table" then
			fresh.Purchases.Receipts = oldPurchases.Receipts -- Käufe bleiben verbucht (nie doppelt)
		end
		fresh.Purchases.Starter = oldPurchases.Starter == true -- Starter-Paket gibt es nur einmal
		if type(oldPurchases.PassSeasons) == "table" then
			fresh.Purchases.PassSeasons = oldPurchases.PassSeasons
		end
		if Util.IsFinite(oldPurchases.RobuxSpent) then
			fresh.Purchases.RobuxSpent = math.max(0, oldPurchases.RobuxSpent)
		end
	end
	fresh.Created = if Util.IsFinite(data.Created) then data.Created else os.time()
	fresh.Sessions = if Util.IsFinite(data.Sessions) then data.Sessions else 1
	-- dieselbe Tabelle behalten (andere Services halten Verweise darauf)
	table.clear(data)
	for key, value in pairs(fresh) do
		data[key] = value
	end
	profile.PlayBase = 0
	profile.SessionStart = os.clock()
	-- Client + Spielerliste sofort auffrischen
	local state = Services and Services.PlayerStateService
	if state then
		pcall(state.MarkDirty, player)
		pcall(state.SetLeaderstat, player, "Vermögen", 0)
		pcall(state.SetLeaderstat, player, "Etagen", 0)
		pcall(state.Notify, player, "core.dataReset", nil, "Info")
	end
	return true
end

-- ---------------------------------------------------------------------
-- 5) START
-- ---------------------------------------------------------------------
local autoSaveRunning = false

-- REUSE §7 #21: Schnappschuss-Liste statt pairs(Profiles) mit yield, jedes Save in pcall
local function autoSaveRound()
	if autoSaveRunning then
		return
	end
	autoSaveRunning = true
	local stagger = math.max(0, tonumber(TECH.AutoSaveStagger) or 0.5)
	for _, player in ipairs(Util.Snapshot(Profiles)) do
		local profile = Profiles[player]
		if profile and profile.Loaded and not profile.NoSave and not profile.Releasing and player.Parent then
			task.spawn(function()
				local ok, err = pcall(DataService.Save, player)
				if not ok then
					warn("[DataService] Auto-Save Fehler: " .. tostring(err))
				end
			end)
			task.wait(stagger) -- verteilen, um Limits zu schonen
		end
	end
	autoSaveRunning = false
end

function DataService.Init(services: any)
	Services = services
end

function DataService.Start()
	started = true
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(releaseProfile)

	local interval = math.max(10, tonumber(TECH.AutoSaveSeconds) or 90)
	Scheduler.Every("DataAutoSave", 1 / interval, function()
		task.spawn(autoSaveRound) -- Speichern yieldet -> eigener Thread (Scheduler-Callbacks yielden nie)
	end)

	-- Server fährt herunter: alles speichern (Roblox gibt max. 30 Sekunden)
	game:BindToClose(function()
		local limit = math.clamp(tonumber(TECH.BindToCloseSeconds) or 25, 1, 29)
		local pending = 0
		for _, player in ipairs(Util.Snapshot(Profiles)) do
			pending += 1
			task.spawn(function()
				local ok, err = pcall(releaseProfile, player)
				if not ok then
					warn("[DataService] Release beim Herunterfahren fehlgeschlagen: " .. tostring(err))
				end
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < limit do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Welt-Events, Live-Ops-Kalender, Admin-Abuse-Shows (Server/Services/EventService)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Vertrag: DESIGN.md §C5.10, §B10 (Welt-Events :10, Glocken-Moment,
--  Sky-Show, Bär/Bulle, Bullen-Parade, Feuerwerk, Geldregen, Samstags-Show + Automatik), §B15.3 (Nicht-Markt-Teil des
--  Admin-Abuse-Katalogs), §C8 (Remote "World"), §C9 (EventPickup), §C10 (State "Event"), §C11.2 (Pickup-Fälschung).
--
--  Ablauf (Scheduler "EventTick" 1 Hz, "EventRain" 4 Hz nur bei aktivem Geldregen):
--    * jeder Börsentag :10 -> Welt-Event Rotation[(Börsentag % #Rotation) + 1] (Clock, auf allen Servern gleich):
--      Geldtransporter (Bündel entlang des Rings, je 20 s Dauer-Einkommen) · Drohnen-Lieferung (8 Pakete an
--      deterministischen Punkten, Hash aus dem Start-Tick, je 60 s) · Bau-Boom (−25 %, TowerService.SetCostEvent) ·
--      Pressekonferenz (Quartalszahlen von :03 des nächsten Börsentags + 3-Fragen-Quiz über Antwort-Felder)
--    * Börsentag % 3 == 0: Glocken-Moment :00–:01 (≥ 3 Spieler in der Zone -> TowerService.SetServerBoost("Bell", ×1,2,
--      300 s)) und Sky-Show :15 nachts (Respekt zählt 10 min doppelt – CommunityService liest Active())
--    * Crash-News -> „Beruhige den Bären“ (Vertrauens-Kugeln je Spieler, Ziel 25 × Spieler, Erfolg = 10 min Einkommen)
--      Rally-News -> goldener Bulle auf dem Ring (Berühren = Bullen-Bonus ×1,5 für 5 min, 1× je Rally)
--    * Wochen-Kalender (Config.Events.Weekly, Berlin-Zeit): Power-Hour-Anzeige, Erinnerungen an den Besitzer,
--      automatische Samstags-Show 18:15 (nur wenn MarketService.AutoShowCancelled(Woche) == false), Bilanz-Sonntag
--  Pickups werden PRO SPIELER instanziert: Server vergibt Token {Id, Kind, Pos, Until} (Remote World "Pickups" nur an
--  den Eigentümer), Einsammeln über Request "EventPickup" {Id} (Token gehört dem Spieler, Fenster gültig, Abstand ≤ 12,
--  max. 1 je Id). Kein Event löscht oder berührt Käufe; Belohnungen nur CR (ShopService.Credit) / Turm-Boost / XP.
--
--  Öffentliche API (§C5.10):
--    EventService.Active(): { Types.EventState }       EventService.EventMult(): number   (Golden Hour, ≤ 3)
--    EventService.IsAdminAbuse(): boolean               EventService.BearActive(): boolean
--    EventService.Start(kind, args, "Local" | "Global", by?): (boolean, string)
--      (ohne Argumente = Lebenszyklus-Start durch den Loader, genau einmal – Vertrag und Loader nutzen denselben Namen)
--    EventService.StartParade(buyer, seconds)           EventService.StartFireworks(buyer)
--  Ergänzungen (WP11-intern, abwärtskompatibel):
--    EventService.Clamp(kind, args): ({ [string]: any }?, string?)   Parameter klemmen (AdminService, AdminTests)
--    EventService.ApplyGlobal(msg): boolean                           globale Admin-Abuse-Nachricht ausführen (geprüft)
--    EventService.Stop(kind): number                                  laufende Events einer Art beenden (lokal)
--    EventService.Kinds(): { string }                                 startbare Arten (Admin-Panel)
--    EventService.Stats(): { [string]: number }                       Zähler für Dashboard/F8
--  Request-Handler: EventPickup. State: Event. Effekte: MoneyRain, BullParade, Bear, GoldenBull, SkyShow, Fireworks,
--  BossAppear, AbuseBanner, BellMoment (+ Kern-Effekte CoinFly/Confetti von WP2).
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))
local Clock = require(Shared:WaitForChild("Clock"))
local Lang = require(Shared:WaitForChild("Lang"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local EventService = {}
local Services: any = nil

type Plain = { [string]: any }
type EventState = Types.EventState

type Ev = {
	Key: string,
	Kind: string,
	Started: number,
	Until: number,
	Scope: "Local" | "Global",
	Data: Plain,
	Admin: boolean,
	Run: Plain, -- nur Server (nie gesendet)
}

type Token = {
	Id: number,
	Kind: string,
	Pos: Vector3,
	Until: number,
	From: number,
	SendAt: number,
	Event: string,
	Reward: string, -- "Income" | "Orb" | "Quiz"
	Seconds: number,
	Source: string,
	Q: number,
	O: number,
	Sent: boolean,
}

type Route = { Points: { Vector3 }, Cum: { number }, Length: number }

local EV: any = Config.Events
local SEASON: any = Config.Season

local DAY = Clock.DAY_TICKS
local MAX_EVENTS = 24
local MAX_ACTIVE_STATE = 12
local MAX_CATCHUP_TICKS = 5
local MAX_PENDING = 16
local BEAR_BROADCAST_GAP = 0.5
local PICKUP_SLACK = 0.75 -- Sekunden Toleranz beim Fenster-Anfang (Laufzeit des Pakets)
local RANGE_SLACK = 1.5 -- Studs Toleranz für die Reichweite (Netz-Versatz der Wurzel)
local ERROR_LOG_GAP = 10
local SHOW_FOLDER = "AT_EventWorld"
local ROUTE_CACHE_MAX = 8

-- Startbare Arten: Welt-Events + Nicht-Markt-Katalog + Welt-Darsteller (Admin-Tab Welt/Debug lokal)
local WORLD_KINDS: { [string]: boolean } = { Truck = true, Drones = true, BuildBoom = true, Press = true }
local START_KINDS: { [string]: boolean } = {
	Truck = true,
	Drones = true,
	BuildBoom = true,
	Press = true,
	BellMoment = true,
	SkyShow = true,
	Bear = true,
	GoldenBull = true,
	MoneyRain = true,
	GoldenHour = true,
	XpRush = true,
	AdminBuildBoom = true,
	Lightshow = true,
	Fireworks = true,
	Confetti = true,
	BellShow = true,
	Boss = true,
	AllToHall = true,
	SaturdayShow = true,
	AutoShow = true,
	LeagueFinale = true,
}
-- Admin-Abuse (zählt für "ADMIN-ABUSE aktiv", sperrt Angebote)
local ADMIN_KINDS: { [string]: boolean } = {
	MoneyRain = true,
	GoldenHour = true,
	XpRush = true,
	AdminBuildBoom = true,
	Lightshow = true,
	Fireworks = true,
	Confetti = true,
	BellShow = true,
	Boss = true,
	AllToHall = true,
	SaturdayShow = true,
}

-- ---------------------------------------------------------------------
-- ZUSTAND (Pro-Spieler-Tabellen werden bei PlayerRemoving geleert)
-- ---------------------------------------------------------------------
local events: { [string]: Ev } = {}
local tokens: { [Player]: { [number]: Token } } = {}
local tokenCount: { [Player]: number } = {}
local issued: { [Player]: { [string]: boolean } } = {} -- Event-Schlüssel -> Pickups schon erzeugt
local collected: { [Player]: { [string]: number } } = {} -- Event-Schlüssel -> eingesammelte Pickups
local rewarded: { [Player]: { [string]: boolean } } = {} -- Event-Schlüssel -> Teilnahme-Belohnung schon gegeben
local quiz: { [Player]: { Event: string, Q: number, Correct: number, Done: boolean } } = {}
local bullTouched: { [Player]: string } = {}
local rainPlan: { [Player]: { Next: number, Left: number, Gap: number } } = {}
local bearPart: { [Player]: number } = {} -- Kugeln im aktuellen Bären
local pending: { { At: number, Kind: string, Args: Plain, Scope: "Local" | "Global", By: number?, Meta: Plain? } } = {}
local weeklyNext: { [string]: number } = {}

local nextTokenId = 1
local lastTick: number? = nil
local bellWindow: { Day: number, Until: number, Done: boolean }? = nil
local bear: { Key: string, Have: number, Goal: number, BroadcastAt: number, Sent: string }? = nil
local eventMultValue = 1
local eventMultUntil = 0
local stateSig = ""
local stats = { Started = 0, Pickups = 0, Rejected = 0, BearWins = 0 }
local routeCache: { [string]: Route } = {}
local routeCacheCount = 0
local errorAt: { [string]: number } = {}
local showFolder: Folder? = nil

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function logError(source: string, err: any)
	local now = os.clock()
	if now - (errorAt[source] or -math.huge) >= ERROR_LOG_GAP then
		errorAt[source] = now
		warn(("[EventService] %s: %s"):format(source, tostring(err)))
	end
end

local function service(name: string): any
	return if Services then Services[name] else nil
end

-- Services.<name>.<fn>(...) in pcall; fehlt der Dienst -> false
local function call(name: string, fnName: string, ...: any): (boolean, ...any)
	local svc = service(name)
	local fn = if type(svc) == "table" then svc[fnName] else nil
	if type(fn) ~= "function" then
		return false
	end
	local result = table.pack(pcall(fn, ...))
	if not result[1] then
		logError(name .. "." .. fnName, result[2])
	end
	return table.unpack(result, 1, result.n)
end

local function present(p: any): boolean
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent == Players
end

local function isNum(n: any): boolean
	return Util.IsFinite(n)
end

local function num(value: any, default: number): number
	return if Util.IsFinite(value) then value else default
end

local function now(): number
	return Clock.Now()
end

local function ready(p: Player): boolean
	local ok, result = call("PlayerStateService", "IsReady", p)
	return ok and result == true
end

local function notifyAll(key: string, args: { any }?, kind: Types.NotifyKind?)
	call("PlayerStateService", "NotifyAll", key, args, kind or "Event")
end

local function notify(p: Player, key: string, args: { any }?, kind: Types.NotifyKind?)
	call("PlayerStateService", "Notify", p, key, args, kind or "Event")
end

local function effectAll(name: string, strength: number, data: any?)
	call("PlayerStateService", "EffectAll", name, strength, data)
end

local function effect(p: Player, name: string, strength: number, data: any?)
	call("PlayerStateService", "Effect", p, name, strength, data)
end

local function markAll()
	for _, p in ipairs(Players:GetPlayers()) do
		call("PlayerStateService", "MarkDirty", p, "Event")
	end
end

local function rootOf(p: Player): BasePart?
	local character = p.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function isStudio(): boolean
	return RunService:IsStudio()
end

local function playerName(userId: number?): string
	if not isNum(userId) then
		return "?"
	end
	local p = Players:GetPlayerByUserId(userId :: number)
	if p then
		return string.sub(p.DisplayName, 1, 40)
	end
	return tostring(userId)
end

-- Dauer-Einkommen pro Sekunde (ohne Zeitlich) – Grundlage aller Event-Belohnungen
local function steadyIncome(p: Player): number
	local ok, info = call("TowerService", "Income", p)
	if ok and type(info) == "table" and isNum(info.Steady) and info.Steady > 0 then
		return info.Steady
	end
	return 0
end

local function creditIncome(p: Player, seconds: number, source: string): number
	local amount = math.floor(steadyIncome(p) * seconds)
	amount = math.max(amount, math.floor(num(EV.MinPickupCredits, 10)))
	amount = math.clamp(amount, 0, 1e14)
	if amount < 1 then
		return 0
	end
	local ok, credited = call("ShopService", "Credit", p, amount, source)
	if ok and credited == true then
		return amount
	end
	return 0
end

local function plazaCenter(): Vector3
	local zones = Config.City and Config.City.Zones
	local plaza = zones and zones.Plaza
	if plaza and typeof(plaza.Center) == "Vector3" then
		return plaza.Center
	end
	return Vector3.zero
end

local function anchor(name: string): CFrame?
	local ok, cf = call("CityService", "Anchor", name)
	if ok and typeof(cf) == "CFrame" then
		return cf
	end
	return nil
end

local function sectorOfWeek(): string
	local sectors = Config.Companies and Config.Companies.Sectors
	local week = Clock.WeekIndex(Clock.Tick())
	if type(sectors) == "table" and #sectors > 0 then
		local entry = sectors[(week % #sectors) + 1]
		if type(entry) == "table" and type(entry.Key) == "string" then
			return entry.Key
		end
	end
	return "T"
end

local function folder(): Folder
	local existing = showFolder
	if existing and existing.Parent then
		return existing
	end
	local created = workspace:FindFirstChild(SHOW_FOLDER)
	if not created or not created:IsA("Folder") then
		local f = Instance.new("Folder")
		f.Name = SHOW_FOLDER
		f.Parent = workspace
		created = f
	end
	showFolder = created :: Folder
	return created :: Folder
end

-- Boden unter einem Punkt (Kugeln/Münzen sollen nicht in Wänden oder in der Luft hängen)
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = false
groundParams.RespectCanCollide = true

local function groundAt(pos: Vector3, lift: number): Vector3
	local list: { Instance } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	table.insert(list, folder())
	groundParams.ExcludeInstances = list
	local result = workspace:Raycast(pos + Vector3.new(0, 80, 0), Vector3.new(0, -220, 0), groundParams)
	if result then
		return result.Position + Vector3.new(0, lift, 0)
	end
	return pos + Vector3.new(0, lift, 0)
end

-- ---------------------------------------------------------------------
-- ROUTEN (gleiche Punkte wie der Client: Config.City.RoutePoints)
-- ---------------------------------------------------------------------
local function routeOf(name: string): Route?
	local cached = routeCache[name]
	if cached then
		return cached
	end
	local points: any = nil
	local ok, result = call("CityService", "Route", name)
	if ok and type(result) == "table" and #result >= 2 then
		points = result
	else
		local city: any = Config.City
		if city and type(city.RoutePoints) == "function" then
			local okCfg, fromCfg = pcall(city.RoutePoints, name)
			if okCfg and type(fromCfg) == "table" and #fromCfg >= 2 then
				points = fromCfg
			end
		end
	end
	if type(points) ~= "table" then
		return nil
	end
	local cum: { number } = { 0 }
	local length = 0
	for i = 2, #points do
		length += (points[i] - points[i - 1]).Magnitude
		cum[i] = length
	end
	if length <= 0 then
		return nil
	end
	local route: Route = { Points = points, Cum = cum, Length = length }
	if routeCacheCount < ROUTE_CACHE_MAX then
		routeCache[name] = route
		routeCacheCount += 1
	end
	return route
end

-- Punkt bei Anteil f (0 … 1) der Route, plus Richtung
local function pointAt(route: Route, f: number): (Vector3, Vector3)
	local target = (f % 1) * route.Length
	local points, cum = route.Points, route.Cum
	local lo, hi = 1, #cum
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if cum[mid] <= target then
			lo = mid
		else
			hi = mid
		end
	end
	local a, b = points[lo], points[math.min(lo + 1, #points)]
	local seg = cum[math.min(lo + 1, #cum)] - cum[lo]
	local t = if seg > 0 then (target - cum[lo]) / seg else 0
	local dir = b - a
	return a:Lerp(b, t), if dir.Magnitude > 0.01 then dir.Unit else Vector3.new(1, 0, 0)
end

-- ---------------------------------------------------------------------
-- EVENT-VERWALTUNG
-- ---------------------------------------------------------------------
local function publicState(ev: Ev): EventState
	return {
		Kind = ev.Kind,
		Started = ev.Started,
		Until = ev.Until,
		Scope = ev.Scope,
		Data = ev.Data,
	}
end

local function countEvents(): number
	local n = 0
	for _ in pairs(events) do
		n += 1
	end
	return n
end

local function addEvent(
	key: string,
	kind: string,
	seconds: number,
	scope: "Local" | "Global",
	data: Plain,
	admin: boolean
): Ev?
	local t = now()
	local existing = events[key]
	if existing == nil and countEvents() >= MAX_EVENTS then
		logError("addEvent", "zu viele gleichzeitige Events – " .. kind .. " übersprungen")
		return nil
	end
	local ev: Ev = {
		Key = key,
		Kind = kind,
		Started = t,
		Until = t + math.max(1, seconds),
		Scope = scope,
		Data = data,
		Admin = admin,
		Run = {},
	}
	events[key] = ev
	stats.Started += 1
	Remotes.World:FireAllClients("Event", publicState(ev))
	markAll()
	return ev
end

local function endEvent(key: string)
	local ev = events[key]
	if not ev then
		return
	end
	events[key] = nil
	local t = now()
	local state = publicState(ev)
	state.Until = math.min(state.Until, t)
	Remotes.World:FireAllClients("Event", state)
	-- offene Pickups dieses Events verfallen (Clients räumen über Until/PickupGone selbst auf)
	for p, list in pairs(tokens) do
		local gone: { number } = {}
		for id, token in pairs(list) do
			if token.Event == key and token.Until <= t then
				table.insert(gone, id)
			end
		end
		for _, id in ipairs(gone) do
			list[id] = nil
			tokenCount[p] = math.max(0, (tokenCount[p] or 1) - 1)
			if present(p) then
				Remotes.World:FireClient(p, "PickupGone", { Id = id })
			end
		end
	end
	markAll()
end

-- ---------------------------------------------------------------------
-- PICKUP-TOKEN (pro Spieler)
-- ---------------------------------------------------------------------
local function addToken(
	p: Player,
	eventKey: string,
	kind: string,
	pos: Vector3,
	from: number,
	sendAt: number,
	untilT: number,
	reward: string,
	seconds: number,
	source: string,
	q: number?,
	o: number?
): Token?
	if not present(p) or not Util.IsFiniteVector(pos) then
		return nil
	end
	local maxTokens = math.floor(num(EV.PickupMaxPerPlayer, 60))
	local count = tokenCount[p] or 0
	if count >= maxTokens then
		return nil
	end
	local list = tokens[p]
	if not list then
		list = {}
		tokens[p] = list
	end
	local id = nextTokenId
	nextTokenId += 1
	if nextTokenId > 2 ^ 31 then
		nextTokenId = 1
	end
	local token: Token = {
		Id = id,
		Kind = kind,
		Pos = pos,
		Until = untilT,
		From = from,
		SendAt = sendAt,
		Event = eventKey,
		Reward = reward,
		Seconds = seconds,
		Source = source,
		Q = q or 0,
		O = o or 0,
		Sent = false,
	}
	list[id] = token
	tokenCount[p] = count + 1
	return token
end

local function removeToken(p: Player, id: number, tell: boolean)
	local list = tokens[p]
	if not list or not list[id] then
		return
	end
	list[id] = nil
	tokenCount[p] = math.max(0, (tokenCount[p] or 1) - 1)
	if tell and present(p) then
		Remotes.World:FireClient(p, "PickupGone", { Id = id })
	end
end

-- Fällige Token an ihre Eigentümer senden (ein Paket je Spieler und Takt)
local function flushTokens(t: number)
	for p, list in pairs(tokens) do
		if not present(p) then
			continue
		end
		local batch: { Plain } = {}
		local expired: { number } = {}
		for id, token in pairs(list) do
			if token.Until <= t then
				table.insert(expired, id)
			elseif not token.Sent and token.SendAt <= t then
				token.Sent = true
				table.insert(batch, { Id = token.Id, Kind = token.Kind, Pos = token.Pos, Until = token.Until })
			end
		end
		for _, id in ipairs(expired) do
			removeToken(p, id, false)
		end
		if #batch > 0 then
			Remotes.World:FireClient(p, "Pickups", batch)
		end
	end
end

local function participation(p: Player, eventKey: string)
	local per = collected[p]
	if not per then
		per = {}
		collected[p] = per
	end
	local first = (per[eventKey] or 0) == 0
	per[eventKey] = (per[eventKey] or 0) + 1
	if first then
		call("ProgressionService", "NoteStat", p, "WorldEvent", 1, nil)
	end
	return per[eventKey]
end

local function seasonXpOnce(p: Player, eventKey: string)
	local per = rewarded[p]
	if not per then
		per = {}
		rewarded[p] = per
	end
	if per[eventKey] then
		return
	end
	per[eventKey] = true
	local xp = num(SEASON and SEASON.XpSources and SEASON.XpSources.WorldEvent and SEASON.XpSources.WorldEvent.Xp, 0)
	if xp <= 0 then
		xp = num(EV.WorldSeasonXp, 50)
	end
	call("RewardService", "GrantSeasonXp", p, xp, "WorldEvent")
end

-- ---------------------------------------------------------------------
-- WELT-EVENTS (:10)
-- ---------------------------------------------------------------------
local function hashRandom(seed: number): Random
	return Random.new(seed % 2147483647)
end

-- Geldtransporter: Bündel entlang des Rings, erst sichtbar, wenn der Transporter vorbeifährt
local function issueTruck(p: Player, ev: Ev)
	local cfg = EV.Truck
	local route = routeOf(cfg.Route or "Ring")
	if not route then
		return
	end
	local count = math.clamp(math.floor(num(cfg.Bundles, 30)), 1, 60)
	local seconds = num(cfg.Seconds, 120)
	local rng = hashRandom(math.floor(ev.Started))
	local lateral = num(cfg.Lateral, 8)
	local untilT = ev.Until + num(cfg.Linger, 30)
	for i = 1, count do
		local f = (i - 0.5) / count
		local pos, dir = pointAt(route, f)
		local side = Vector3.new(-dir.Z, 0, dir.X)
		local offset = side * ((rng:NextNumber() * 2 - 1) * lateral)
		local at = ev.Started + f * seconds
		addToken(
			p,
			ev.Key,
			"Bundle",
			pos + offset + Vector3.new(0, 1.6, 0),
			at,
			at,
			untilT,
			"Income",
			num(cfg.IncomeSeconds, 20),
			"Pickup"
		)
	end
end

-- Drohnen: deterministische Punkte (Anker der Stadt + Plot-Vorplätze), Hash aus dem Start-Tick
local function droneSpots(seed: number, count: number): { Vector3 }
	local candidates: { Vector3 } = {}
	for _, name in ipairs({
		"Spawn",
		"BellZone",
		"TowerTour",
		"Showroom",
		"Boutique",
		"Marina",
		"Lookout",
		"PressScreen",
	}) do
		local cf = anchor(name)
		if cf then
			table.insert(candidates, cf.Position)
		end
	end
	local plots = math.floor(num(Config.Server and Config.Server.Plots, 10))
	for k = 1, plots do
		local ok, site = call("CityService", "PlotSite", k)
		if ok and typeof(site) == "CFrame" then
			local toPlaza = plazaCenter() - site.Position
			local flat = Vector3.new(toPlaza.X, 0, toPlaza.Z)
			if flat.Magnitude > 1 then
				table.insert(candidates, site.Position + flat.Unit * 46)
			end
		end
	end
	if #candidates == 0 then
		local c = plazaCenter()
		for k = 1, 8 do
			local a = k / 8 * math.pi * 2
			table.insert(candidates, c + Vector3.new(math.cos(a) * 60, 0, math.sin(a) * 60))
		end
	end
	local rng = hashRandom(seed)
	local spread = num(EV.Drones.Spread, 14)
	local out: { Vector3 } = {}
	for i = 1, count do
		local base = candidates[rng:NextInteger(1, #candidates)]
		local a = rng:NextNumber() * math.pi * 2
		local r = rng:NextNumber() * spread
		out[i] = base + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
	end
	return out
end

local function issueDrones(p: Player, ev: Ev)
	local cfg = EV.Drones
	local spots: { Vector3 } = ev.Run.Spots
	if type(spots) ~= "table" then
		return
	end
	local from = ev.Started + num(cfg.DropSeconds, 8)
	for _, pos in ipairs(spots) do
		addToken(p, ev.Key, "Package", pos, from, ev.Started, ev.Until, "Income", num(cfg.IncomeSeconds, 60), "Pickup")
	end
end

-- Pressekonferenz: Antwort-Felder vor dem Hologramm (eine Frage nach der anderen)
local function quizPads(): { Vector3 }
	local cf = anchor("PressScreen")
	local base: CFrame = cf or CFrame.new(plazaCenter() + Vector3.new(0, 0, 40))
	local spacing = num(EV.Press.PadSpacing, 7)
	local pads: { Vector3 } = {}
	for o = 1, 3 do
		local local_ = base * CFrame.new((o - 2) * spacing, 0, -6)
		pads[o] = local_.Position + Vector3.new(0, 1.2, 0)
	end
	return pads
end

local function issueQuestion(p: Player, ev: Ev, q: number)
	local pads: { Vector3 } = ev.Run.Pads
	if type(pads) ~= "table" then
		return
	end
	local t = now()
	local from = math.max(t, ev.Started + 4)
	for o = 1, 3 do
		addToken(p, ev.Key, ("Quiz:%d:%d"):format(q, o), pads[o], from, t, ev.Until, "Quiz", 0, "", q, o)
	end
end

local function issuePress(p: Player, ev: Ev)
	quiz[p] = { Event = ev.Key, Q = 1, Correct = 0, Done = false }
	issueQuestion(p, ev, 1)
end

-- Pickups für alle bereiten Spieler erzeugen, die für ein laufendes Event noch keine haben (auch späte Beitritte)
local ISSUERS: { [string]: (Player, Ev) -> () } = {
	Truck = issueTruck,
	Drones = issueDrones,
	Press = issuePress,
}

local function issueAll()
	for key, ev in pairs(events) do
		local issuer = ISSUERS[ev.Kind]
		if issuer and ev.Until > now() then
			for _, p in ipairs(Players:GetPlayers()) do
				local done = issued[p]
				if not done then
					done = {}
					issued[p] = done
				end
				if not done[key] and ready(p) then
					done[key] = true
					local ok, err = pcall(issuer, p, ev)
					if not ok then
						logError("issue " .. ev.Kind, err)
					end
				end
			end
		end
	end
end

local function startTruck(scope: "Local" | "Global"): Ev?
	local cfg = EV.Truck
	return addEvent(
		"Truck",
		"Truck",
		num(cfg.Seconds, 120),
		scope,
		{ Route = cfg.Route or "Ring", Count = math.floor(num(cfg.Bundles, 30)) },
		false
	)
end

local function startDrones(scope: "Local" | "Global"): Ev?
	local cfg = EV.Drones
	local count = math.clamp(math.floor(num(cfg.Packages, 8)), 1, 30)
	local seed = math.floor(Clock.Tick())
	local spots = droneSpots(seed, count)
	local ev =
		addEvent("Drones", "Drones", num(cfg.Seconds, 120), scope, { Spots = spots, Drop = cfg.DropSeconds }, false)
	if ev then
		ev.Run.Spots = spots
	end
	return ev
end

local function adminBoomActive(): boolean
	local ev = events.AdminBuildBoom
	return ev ~= nil and ev.Until > now()
end

local function startBuildBoom(scope: "Local" | "Global"): Ev?
	local cfg = EV.BuildBoom
	local seconds = num(cfg.Seconds, 300)
	local mult = math.clamp(1 - num(cfg.Pct, 0.25), 0.1, 1)
	local untilT = now() + seconds
	-- läuft schon ein Admin-Bau-Boom (−50 % Etagen), nur die Raum-Stufen verbilligen
	call("TowerService", "SetCostEvent", if adminBoomActive() then "RoomLevel" else "Both", mult, untilT)
	notifyAll("evt.buildBoomStart", { math.floor(num(cfg.Pct, 0.25) * 100 + 0.5) }, "Event")
	return addEvent("BuildBoom", "BuildBoom", seconds, scope, { Pct = num(cfg.Pct, 0.25) }, false)
end

local function pressItems(): { Plain }
	local out: { Plain } = {}
	local ok, items = call("MarketService", "Calendar", 2)
	if not ok or type(items) ~= "table" then
		return out
	end
	local tick = Clock.Tick()
	local nextStart = (Clock.DayIndex(tick) + 1) * DAY
	local maxItems = math.floor(num(EV.Press.MaxItems, 4))
	for _, item in ipairs(items) do
		if type(item) == "table" and item.Kind == "Earnings" and isNum(item.T) and isNum(item.I) then
			if item.T >= nextStart + 180 and item.T < nextStart + 240 and #out < maxItems then
				table.insert(out, { I = item.I, T = item.T })
			end
		end
	end
	return out
end

local function startPress(scope: "Local" | "Global"): Ev?
	local cfg = EV.Press
	local pool = cfg.Quiz
	local day = Clock.DayIndex(Clock.Tick())
	local count = math.clamp(math.floor(num(cfg.Questions, 3)), 1, #pool)
	local picked: { number } = {}
	local rng = hashRandom(day * 7919 + 13)
	local order: { number } = {}
	for i = 1, #pool do
		order[i] = i
	end
	for i = #order, 2, -1 do -- Fisher-Yates mit festem Seed (alle Server gleich)
		local j = rng:NextInteger(1, i)
		order[i], order[j] = order[j], order[i]
	end
	for i = 1, count do
		table.insert(picked, pool[order[i]].Id)
	end
	local screen = anchor("PressScreen") or CFrame.new(plazaCenter() + Vector3.new(0, 0, 40))
	local ev = addEvent("Press", "Press", num(cfg.Seconds, 90), scope, {
		Items = pressItems(),
		Quiz = picked,
		Lead = cfg.LeadMinutes,
		Pos = screen.Position,
		Look = screen.LookVector,
	}, false)
	if ev then
		ev.Run.Pads = quizPads()
		ev.Run.Quiz = picked
	end
	return ev
end

local WORLD_STARTERS: { [string]: ("Local" | "Global") -> Ev? } = {
	Truck = startTruck,
	Drones = startDrones,
	BuildBoom = startBuildBoom,
	Press = startPress,
}

local function startWorld(kind: string, scope: "Local" | "Global"): Ev?
	local starter = WORLD_STARTERS[kind]
	if not starter then
		return nil
	end
	if events[kind] and events[kind].Until > now() then
		return nil -- läuft schon
	end
	local ev = starter(scope)
	if ev and kind ~= "BuildBoom" then
		notifyAll("evt.worldStart." .. kind, nil, "Event")
	end
	return ev
end

local function rotationKind(day: number): string?
	local rotation = EV.Rotation
	if type(rotation) ~= "table" or #rotation == 0 then
		return nil
	end
	return rotation[(day % #rotation) + 1]
end

-- ---------------------------------------------------------------------
-- GLOCKEN-MOMENT, SKY-SHOW
-- ---------------------------------------------------------------------
local function bellZone(): (Vector3, number)
	local cf = anchor("BellZone")
	local zones = Config.City and Config.City.Zones
	local plaza = zones and zones.Plaza
	local radius = num(plaza and plaza.BellZoneRadius, num(EV.BellMoment.ZoneRadius, 18))
	if cf then
		return cf.Position, radius
	end
	return plazaCenter(), radius
end

local function playersInBellZone(): number
	local center, radius = bellZone()
	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		local root = rootOf(p)
		if root then
			local offset = root.Position - center
			if Vector2.new(offset.X, offset.Z).Magnitude <= radius + 2 and math.abs(offset.Y) < 40 then
				count += 1
			end
		end
	end
	return count
end

local function boostsPaused(): boolean
	return EV.BoostPause == true
end

local function triggerBellMoment(scope: "Local" | "Global", count: number): Ev?
	local cfg = EV.BellMoment
	local seconds = num(cfg.Seconds, 300)
	local mult = math.clamp(num(cfg.Mult, 1.2), 1, 1.5)
	if not boostsPaused() then
		call("TowerService", "SetServerBoost", "Bell", mult, seconds)
	end
	effectAll("BellMoment", 1, { Seconds = seconds, Count = count, Mult = mult })
	notifyAll("evt.bellMoment", { count, ("%.1f"):format(mult) }, "Success")
	return addEvent("BellMoment", "BellMoment", seconds, scope, { Mult = mult, Count = count }, false)
end

local function startSkyShow(scope: "Local" | "Global", admin: boolean): Ev?
	local cfg = EV.SkyShow
	local show = num(cfg.ShowSeconds, 75)
	effectAll("SkyShow", 1, { Seconds = show, Admin = admin })
	if admin then
		return addEvent("Lightshow", "Lightshow", show, scope, { Seconds = show }, true)
	end
	notifyAll("evt.skyShow", { math.floor(num(cfg.Seconds, 600) / 60) }, "Event")
	return addEvent("SkyShow", "SkyShow", num(cfg.Seconds, 600), scope, {
		Show = show,
		RespektMult = num(cfg.RespektMult, 2),
	}, false)
end

-- ---------------------------------------------------------------------
-- BÄR (Crash) & GOLDENER BULLE (Rally) – serverlokal, ohne Markteinfluss
-- ---------------------------------------------------------------------
local function bearGoal(): number
	local perPlayer = math.floor(num(EV.Bear.GoalPerPlayer, 25))
	return math.max(1, #Players:GetPlayers()) * perPlayer
end

local function orbSpot(): Vector3
	local cfg = EV.Bear
	local center = plazaCenter()
	local a = math.random() * math.pi * 2
	local r = num(cfg.RadiusMin, 20) + math.random() * (num(cfg.RadiusMax, 110) - num(cfg.RadiusMin, 20))
	return groundAt(center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), 2.5)
end

local function spawnOrb(p: Player, ev: Ev): boolean
	local maxOrbs = math.floor(num(EV.Bear.OrbsMaxPerPlayer, 60))
	local spawned = ev.Run.Spawned
	if type(spawned) ~= "table" then
		spawned = {}
		ev.Run.Spawned = spawned
	end
	if (spawned[p] or 0) >= maxOrbs then
		return false
	end
	local t = now()
	local token = addToken(p, ev.Key, "Orb", orbSpot(), t + 0.5, t, ev.Until, "Orb", 0, "")
	if token then
		spawned[p] = (spawned[p] or 0) + 1
		return true
	end
	return false
end

local function issueBear(p: Player, ev: Ev)
	for _ = 1, math.clamp(math.floor(num(EV.Bear.OrbsPerPlayer, 8)), 1, 20) do
		spawnOrb(p, ev)
	end
end
ISSUERS.Bear = issueBear

local function broadcastBear(force: boolean)
	local b = bear
	if not b then
		return
	end
	local t = os.clock()
	local sig = ("%d/%d"):format(b.Have, b.Goal)
	if not force and (sig == b.Sent or t - b.BroadcastAt < BEAR_BROADCAST_GAP) then
		return
	end
	b.Sent = sig
	b.BroadcastAt = t
	Remotes.World:FireAllClients("Bear", { Have = b.Have, Goal = b.Goal })
end

local function startBear(scope: "Local" | "Global", probe: boolean): Ev?
	if bear and events[bear.Key] then
		return events[bear.Key] -- ein Bär zur Zeit
	end
	local cfg = EV.Bear
	local key = "Bear"
	local goal = bearGoal()
	local ev = addEvent(key, "Bear", num(cfg.Seconds, 150), scope, { Goal = goal, Probe = probe }, false)
	if not ev then
		return nil
	end
	bear = { Key = key, Have = 0, Goal = goal, BroadcastAt = 0, Sent = "" }
	table.clear(bearPart)
	effectAll("Bear", 1, { Seconds = ev.Until - ev.Started, Phase = "Arrive", Goal = goal })
	notifyAll("evt.bearArrive", { goal }, "Alarm")
	broadcastBear(true)
	return ev
end

local function finishBear(success: boolean)
	local b = bear
	if not b then
		return
	end
	bear = nil
	local cfg = EV.Bear
	if success then
		stats.BearWins += 1
		local seconds = num(cfg.RewardMinutes, 10) * 60
		for p, orbs in pairs(bearPart) do
			if present(p) and orbs > 0 then
				local amount = creditIncome(p, seconds, "Event")
				if amount > 0 then
					effect(p, "CoinFly", amount, nil)
				end
				notify(p, "evt.bearRewarded", { math.floor(num(cfg.RewardMinutes, 10)) }, "Success")
				seasonXpOnce(p, b.Key .. tostring(math.floor(os.time() / 60)))
			end
		end
		effectAll("Bear", 1, { Phase = "Success" })
		notifyAll("evt.bearCalm", nil, "Success")
	else
		effectAll("Bear", 1, { Phase = "Leave" })
		notifyAll("evt.bearLeft", nil, "Info")
	end
	table.clear(bearPart)
	Remotes.World:FireAllClients("Bear", { Have = 0, Goal = 0 })
	endEvent(b.Key)
end

local function startGoldenBull(scope: "Local" | "Global"): Ev?
	local existing = events.GoldenBull
	if existing and existing.Until > now() then
		return existing
	end
	local cfg = EV.GoldenBull
	local seconds = num(cfg.Seconds, 180)
	local rally = ("Bull%d"):format(math.floor(now()))
	local ev =
		addEvent("GoldenBull", "GoldenBull", seconds, scope, { Route = cfg.Route or "Ring", Rally = rally }, false)
	if ev then
		ev.Run.Rally = rally
		effectAll("GoldenBull", 1, { Seconds = seconds, Phase = "Run" })
		notifyAll("evt.goldenBull", { math.floor(num(cfg.BonusSeconds, 300) / 60) }, "Event")
	end
	return ev
end

-- Bulle berühren: Server misst den Abstand zur berechneten Position (1×/s)
local function checkBullTouches(ev: Ev, t: number)
	local cfg = EV.GoldenBull
	local route = routeOf(ev.Data.Route or "Ring")
	if not route then
		return
	end
	local seconds = math.max(1, ev.Until - ev.Started)
	local pos = pointAt(route, math.clamp((t - ev.Started) / seconds, 0, 1))
	local range = num(cfg.TouchRange, 14)
	local rally: string = ev.Run.Rally or ev.Key
	for _, p in ipairs(Players:GetPlayers()) do
		if bullTouched[p] ~= rally then
			local root = rootOf(p)
			if root then
				local d = root.Position - pos
				if Vector2.new(d.X, d.Z).Magnitude <= range and math.abs(d.Y) < 16 then
					bullTouched[p] = rally
					local ok, granted = call("TowerService", "AddBoost", p, "Bull", num(cfg.BonusSeconds, 300))
					if ok and granted == true then
						effect(p, "GoldenBull", 1, { Phase = "Touch" })
						notify(p, "evt.bullTouched", { math.floor(num(cfg.BonusSeconds, 300) / 60) }, "Success")
					end
				end
			end
		end
	end
end

-- Markt-Nachrichten -> Bär/Bulle (Crash/Rally im Plan oder vom Besitzer). Kein Rückweg in den Markt.
local function onNews(n: any)
	if type(n) ~= "table" or type(n.Kind) ~= "string" then
		return
	end
	local adminMove = Config.News and Config.News.AdminMove
	local isCrash = n.Kind == "Crash" or (n.Kind == "Admin" and type(adminMove) == "table" and n.Key == adminMove.Crash)
	local isRally = n.Kind == "Rally" or (n.Kind == "Admin" and type(adminMove) == "table" and n.Key == adminMove.Rally)
	if isCrash then
		startBear("Local", false)
	elseif isRally then
		startGoldenBull("Local")
	end
end

-- ---------------------------------------------------------------------
-- GELDREGEN (pro Spieler instanziert, 4 Hz während er läuft)
-- ---------------------------------------------------------------------
local function rainSpot(p: Player): Vector3
	local cfg = EV.MoneyRain
	local root = rootOf(p)
	local roll = math.random()
	if root and roll < num(cfg.NearShare, 0.5) then
		local a = math.random() * math.pi * 2
		local r = num(cfg.NearMin, 10) + math.random() * (num(cfg.NearMax, 40) - num(cfg.NearMin, 10))
		return groundAt(root.Position + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), 2)
	end
	local okPlot, plot = call("PlotService", "PlotOf", p)
	if roll < 0.75 and okPlot and isNum(plot) then
		local okSite, site = call("CityService", "PlotSite", plot)
		if okSite and typeof(site) == "CFrame" then
			local toPlaza = plazaCenter() - site.Position
			local flat = Vector3.new(toPlaza.X, 0, toPlaza.Z)
			local front = if flat.Magnitude > 1 then site.Position + flat.Unit * 44 else site.Position
			local a = math.random() * math.pi * 2
			local r = math.random() * 18
			return groundAt(front + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), 2)
		end
	end
	local center = plazaCenter()
	local a = math.random() * math.pi * 2
	local r = 12 + math.random() * 95
	return groundAt(center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), 2)
end

local function startMoneyRain(seconds: number, scope: "Local" | "Global", admin: boolean, key: string?): Ev?
	local evKey = key or "MoneyRain"
	local ev = addEvent(evKey, "MoneyRain", seconds, scope, { Seconds = seconds }, admin)
	if not ev then
		return nil
	end
	table.clear(rainPlan)
	effectAll("MoneyRain", 1, { Seconds = seconds })
	notifyAll("evt.moneyRain", { math.floor(seconds) }, "Event")
	return ev
end

local function rainTick()
	local ev: Ev? = nil
	for _, candidate in pairs(events) do
		if candidate.Kind == "MoneyRain" and candidate.Until > now() then
			ev = candidate
			break
		end
	end
	if not ev then
		if next(rainPlan) ~= nil then
			table.clear(rainPlan)
		end
		return
	end
	local rain: Ev = ev
	local t = now()
	local total = math.clamp(math.floor(num(EV.RainCoinsMax, 30)), 1, 30)
	local duration = math.max(1, rain.Until - rain.Started)
	local fall = num(EV.MoneyRain.FallSeconds, 1.6)
	local linger = num(EV.MoneyRain.Linger, 25)
	local seconds = num(EV.RainCoinMinutes, 2) * 60
	for _, p in ipairs(Players:GetPlayers()) do
		if ready(p) then
			local plan = rainPlan[p]
			if not plan then
				local remaining = math.max(1, rain.Until - t)
				local left = math.max(1, math.floor(total * remaining / duration + 0.5))
				plan = { Next = t, Left = left, Gap = remaining / left }
				rainPlan[p] = plan
			end
			if plan.Left > 0 and t >= plan.Next then
				plan.Left -= 1
				plan.Next = t + plan.Gap
				addToken(p, rain.Key, "Coin", rainSpot(p), t + fall, t, rain.Until + linger, "Income", seconds, "Rain")
			end
		end
	end
	flushTokens(t)
end

-- ---------------------------------------------------------------------
-- ADMIN-SHOWS (Nicht-Markt, §B15.3)
-- ---------------------------------------------------------------------
local function startGoldenHour(mult: number, minutes: number, scope: "Local" | "Global", key: string?): Ev?
	local seconds = minutes * 60
	local untilT = now() + seconds
	if not boostsPaused() then
		eventMultValue = mult
		eventMultUntil = untilT
		call("TowerService", "SetEventMult", mult, untilT)
	end
	effectAll("AbuseBanner", 1, { Kind = "GoldenHour", Seconds = seconds, Mult = mult, Until = untilT })
	notifyAll("evt.goldenHour", { ("%g"):format(mult), math.floor(minutes) }, "Event")
	return addEvent(key or "GoldenHour", "GoldenHour", seconds, scope, { Mult = mult }, true)
end

local function startXpRush(minutes: number, scope: "Local" | "Global"): Ev?
	local seconds = minutes * 60
	local kind = (Config.Progression and Config.Progression.XpRushKind) or "XpRush"
	effectAll("AbuseBanner", 1, { Kind = "XpRush", Seconds = seconds, Mult = 2, Until = now() + seconds })
	notifyAll("evt.xpRush", { math.floor(minutes) }, "Event")
	return addEvent("XpRush", kind, seconds, scope, { Mult = 2 }, true)
end

local function startAdminBuildBoom(scope: "Local" | "Global"): Ev?
	local cfg = EV.AdminLimits.BuildBoom
	local seconds = num(cfg.Minutes, 10) * 60
	local untilT = now() + seconds
	call("TowerService", "SetCostEvent", "Floor", math.clamp(num(cfg.CostMult, 0.5), 0.1, 1), untilT)
	call("TowerService", "SetBuildEvent", math.clamp(num(cfg.BuildMult, 0.1), 0, 1), untilT)
	effectAll("AbuseBanner", 1, { Kind = "BuildBoom", Seconds = seconds, Until = untilT })
	notifyAll("evt.adminBuildBoom", { math.floor(seconds / 60) }, "Event")
	return addEvent("AdminBuildBoom", "BuildBoom", seconds, scope, {
		Pct = 1 - num(cfg.CostMult, 0.5),
		Build = 1 - num(cfg.BuildMult, 0.1),
		Admin = true,
	}, true)
end

local function startFireworks(
	seconds: number,
	plot: number?,
	userId: number?,
	scope: "Local" | "Global",
	admin: boolean
): Ev?
	local key = ("Fireworks:%s"):format(tostring(userId or "Show"))
	effectAll("Fireworks", 1, { Seconds = seconds, Plot = plot, UserId = userId })
	return addEvent(key, "Fireworks", seconds, scope, { Plot = plot, UserId = userId }, admin)
end

-- Boss-Auftritt: Besitzer-Avatar ×8 auf dem Börsensaal-Dach (CreateHumanoidModelFromDescriptionAsync, kein Upload)
local function buildBoss(ev: Ev, userId: number)
	local limits = EV.AdminLimits.Boss
	local count = math.clamp(math.floor(num(limits.Count, 8)), 1, 8)
	local spacing = num(limits.Spacing, 9)
	local desc: HumanoidDescription? = nil
	if userId > 0 then
		local ok, result = pcall(function()
			return Players:GetHumanoidDescriptionFromUserIdAsync(userId)
		end)
		if ok and typeof(result) == "Instance" and result:IsA("HumanoidDescription") then
			desc = result
		end
	end
	if not desc then
		desc = Instance.new("HumanoidDescription")
	end
	local okModel, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(desc :: HumanoidDescription, Enum.HumanoidRigType.R15)
	end)
	if not okModel or typeof(model) ~= "Instance" or not model:IsA("Model") then
		logError("Boss", model)
		return
	end
	if events[ev.Key] ~= ev then
		model:Destroy()
		return -- schon vorbei
	end
	local roof = anchor("Rooftop") or anchor("Bell") or CFrame.new(plazaCenter() + Vector3.new(0, 60, -120))
	local holder = Instance.new("Model")
	holder.Name = "AT_BossShow"
	holder.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	local template: Model = model
	local humanoid = template:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end
	-- Nur die Wurzel verankern: die Glieder hängen über Motor6D daran, damit die Winke-Pose (EffectsEvent setzt
	-- RightShoulder.C0 lokal) sie bewegen kann – zwischen zwei verankerten Teilen bewegt ein Gelenk nichts.
	local rootPart = template:FindFirstChild("HumanoidRootPart") or template.PrimaryPart
	for _, d in ipairs(template:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = rootPart == nil or d == rootPart
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
	local height = template:GetExtentsSize().Y
	for i = 1, count do
		local clone = if i == count then template else template:Clone()
		clone.Name = ("Boss%d"):format(i)
		local offset = (i - (count + 1) / 2) * spacing
		clone:PivotTo(roof * CFrame.new(offset, height * 0.5 + 0.2, 0) * CFrame.Angles(0, math.pi, 0))
		clone.Parent = holder
	end
	holder.Parent = folder()
	ev.Run.Model = holder
	effectAll("BossAppear", 1, { Seconds = ev.Until - now(), UserId = userId, Name = playerName(userId) })
end

local function startBoss(seconds: number, userId: number, scope: "Local" | "Global"): Ev?
	local old = events.Boss
	if old then
		local model = old.Run.Model
		if typeof(model) == "Instance" then
			model:Destroy()
		end
		endEvent("Boss")
	end
	local ev = addEvent("Boss", "Boss", seconds, scope, { UserId = userId }, true)
	if not ev then
		return nil
	end
	notifyAll("evt.boss", { playerName(userId) }, "Event")
	task.spawn(buildBoss, ev, userId)
	return ev
end

-- Alle in den Börsensaal (nur dieser Server): Ring-Aufstellung vor der Glocke
local function allToHall(): number
	local base = anchor("Bell")
	local center: Vector3
	local look: Vector3
	if base then
		center = base.Position + base.LookVector * 18
		look = base.Position
	else
		local zones = Config.City and Config.City.Zones
		local exchange = zones and zones.Exchange
		center = (
			if exchange and typeof(exchange.Center) == "Vector3" then exchange.Center else Vector3.new(0, 0, -190)
		) + Vector3.new(0, 0, 30)
		look = center + Vector3.new(0, 0, -10)
	end
	local limits = EV.AdminLimits.AllToHall
	local spacing = num(limits.Spacing, 5)
	local done = 0
	for i, p in ipairs(Players:GetPlayers()) do
		local ring = 1 + (i - 1) // 8
		local a = ((i - 1) % 8) / 8 * math.pi * 2
		local pos = center + Vector3.new(math.cos(a), 0, math.sin(a)) * (ring * spacing)
		local ok, moved = call("PlotService", "Teleport", p, CFrame.lookAt(pos, Vector3.new(look.X, pos.Y, look.Z)))
		if ok and moved == true then
			done += 1
		end
	end
	effectAll("AbuseBanner", 1, { Kind = "AllToHall", Seconds = 6 })
	return done
end

-- Samstags-Show (Banner -> Golden Hour ×2 30 min -> Rally (Markt, separat) -> Geldregen -> Feuerwerk)
local function startShow(kind: "AutoShow" | "SaturdayShow", args: Plain, scope: "Local" | "Global"): Ev?
	local existing = events.Show
	if existing and existing.Until > now() then
		return nil
	end
	local goldenMult = math.clamp(num(args.GoldenMult, 2), 1, 3)
	local goldenMinutes = math.clamp(num(args.GoldenMinutes, 30), 1, 60)
	local rainDelay = math.clamp(num(args.RainDelay, 75), 0, 1800)
	local rainSeconds = math.clamp(num(args.RainSeconds, 180), 60, 300)
	local fireworksDelay = math.clamp(num(args.FireworksDelay, 260), 0, 1800)
	local length = math.max(rainDelay + rainSeconds, fireworksDelay + num(EV.Fireworks.Seconds, 20)) + 5
	local sector = sectorOfWeek()
	local ev = addEvent("Show", kind, length, scope, { Sector = sector }, kind == "SaturdayShow")
	if not ev then
		return nil
	end
	local t = ev.Started
	ev.Run.Steps = {
		{ At = t + rainDelay, Kind = "Rain", Seconds = rainSeconds, Done = false },
		{ At = t + fireworksDelay, Kind = "Fireworks", Done = false },
	}
	effectAll("AbuseBanner", 1, { Kind = kind, Seconds = 8, Sector = sector })
	notifyAll(if kind == "AutoShow" then "evt.autoShow" else "evt.saturdayShow", nil, "Event")
	startGoldenHour(goldenMult, goldenMinutes, scope, "ShowGolden")
	return ev
end

local function runShowSteps(ev: Ev, t: number)
	local steps = ev.Run.Steps
	if type(steps) ~= "table" then
		return
	end
	for _, step in ipairs(steps) do
		if not step.Done and t >= step.At then
			step.Done = true
			if step.Kind == "Rain" then
				startMoneyRain(step.Seconds, ev.Scope, ev.Admin, "ShowRain")
			elseif step.Kind == "Fireworks" then
				startFireworks(num(EV.Fireworks.Seconds, 20), nil, nil, ev.Scope, ev.Admin)
			end
		end
	end
end

-- Bilanz-Sonntag: Liga-Finale-Show + Top-10-Hologramme (Namen aus LeaderboardService, ohne Werte)
local function startLeagueFinale(args: Plain, scope: "Local" | "Global"): Ev?
	local seconds = math.clamp(num(args.Seconds, 150), 30, 600)
	local top: { string } = {}
	local ok, rows =
		call("LeaderboardService", "Top", EV.LeagueBoard or "League", math.clamp(math.floor(num(args.Top, 10)), 1, 10))
	if ok and type(rows) == "table" then
		for _, row in ipairs(rows) do
			if type(row) == "table" and type(row.Name) == "string" and #top < 10 then
				table.insert(top, string.sub(row.Name, 1, 32))
			end
		end
	end
	effectAll("SkyShow", 1, { Seconds = math.min(seconds, num(EV.SkyShow.ShowSeconds, 75)), Finale = true })
	notifyAll("evt.leagueFinale", nil, "Event")
	local hall = anchor("HallOfFame")
	return addEvent(
		"LeagueFinale",
		"LeagueFinale",
		seconds,
		scope,
		{ Top = top, Pos = if hall then hall.Position else plazaCenter() + Vector3.new(30, 0, 30) },
		false
	)
end

-- ---------------------------------------------------------------------
-- KLEMMEN (§B15.3) – reine Funktion, auch für AdminTests
-- ---------------------------------------------------------------------
local function clampNum(value: any, lo: number, hi: number, default: number): number
	local n = tonumber(value)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		n = default
	end
	return math.clamp(n :: number, lo, hi)
end

function EventService.Clamp(kind: string, args: any): ({ [string]: any }?, string?)
	if type(kind) ~= "string" or not START_KINDS[kind] then
		return nil, "admin.evUnknown"
	end
	local raw: Plain = if type(args) == "table" then args else {}
	local limits = EV.AdminLimits
	local out: Plain = {}
	if kind == "MoneyRain" then
		local r = limits.MoneyRain.Seconds
		out.Seconds = math.floor(clampNum(raw.Seconds, r[1], r[2], num(EV.MoneyRain.DefaultSeconds, 120)))
	elseif kind == "GoldenHour" then
		local m, mins = limits.GoldenHour.Mult, limits.GoldenHour.Minutes
		local mult = clampNum(raw.Mult, m[1], m[2], m[1])
		out.Mult = if mult >= 2.5 then 3 else 2 -- nur ×2 oder ×3 (§B15.3)
		out.Mult = math.clamp(out.Mult, m[1], m[2])
		out.Minutes = math.floor(clampNum(raw.Minutes, mins[1], mins[2], mins[1]))
	elseif kind == "XpRush" then
		local mins = limits.XpRush.Minutes
		out.Minutes = math.floor(clampNum(raw.Minutes, mins[1], mins[2], mins[1]))
	elseif kind == "Boss" then
		local r = limits.Boss.Seconds
		out.Seconds = math.floor(clampNum(raw.Seconds, r[1], r[2], r[1]))
	elseif kind == "SaturdayShow" or kind == "AutoShow" then
		local show = limits.SaturdayShow
		out.GoldenMult = show.GoldenMult
		out.GoldenMinutes = show.GoldenMinutes
		out.RainDelay = show.RainDelay
		out.RainSeconds = show.RainSeconds
		out.FireworksDelay = show.FireworksDelay
	elseif kind == "LeagueFinale" then
		out.Seconds = math.floor(clampNum(raw.Seconds, 30, 600, 150))
		out.Top = 10
	end
	if raw.Probe == true then
		out.Probe = true
	end
	return out, nil
end

function EventService.Kinds(): { string }
	local list: { string } = {}
	for kind in pairs(START_KINDS) do
		table.insert(list, kind)
	end
	table.sort(list)
	return list
end

-- ---------------------------------------------------------------------
-- STARTEN (lokal, global über AdminService, geplant)
-- ---------------------------------------------------------------------
local function runEvent(kind: string, args: Plain, scope: "Local" | "Global", byUserId: number?): (boolean, string)
	local ev: Ev? = nil
	if WORLD_KINDS[kind] then
		ev = startWorld(kind, scope)
	elseif kind == "BellMoment" then
		ev = triggerBellMoment(scope, playersInBellZone())
	elseif kind == "SkyShow" then
		ev = startSkyShow(scope, false)
	elseif kind == "Lightshow" then
		ev = startSkyShow(scope, true)
	elseif kind == "Bear" then
		ev = startBear(scope, args.Probe == true)
	elseif kind == "GoldenBull" then
		ev = startGoldenBull(scope)
	elseif kind == "MoneyRain" then
		ev = startMoneyRain(args.Seconds, scope, true, nil)
	elseif kind == "GoldenHour" then
		ev = startGoldenHour(args.Mult, args.Minutes, scope, nil)
	elseif kind == "XpRush" then
		ev = startXpRush(args.Minutes, scope)
	elseif kind == "AdminBuildBoom" then
		ev = startAdminBuildBoom(scope)
	elseif kind == "Fireworks" then
		ev = startFireworks(num(EV.AdminLimits.Fireworks.Seconds, 20), nil, nil, scope, true)
	elseif kind == "Confetti" then
		effectAll("Confetti", 2, nil)
		ev = addEvent("Confetti", "Confetti", num(EV.AdminLimits.Confetti.Seconds, 6), scope, {}, true)
	elseif kind == "BellShow" then
		local seconds = num(EV.AdminLimits.BellShow.Seconds, 30)
		effectAll("BellMoment", 1, { Seconds = seconds, Show = true })
		ev = addEvent("BellShow", "BellShow", seconds, scope, {}, true)
	elseif kind == "Boss" then
		ev = startBoss(args.Seconds, byUserId or game.CreatorId, scope)
	elseif kind == "AllToHall" then
		local moved = allToHall()
		ev = addEvent("AllToHall", "AllToHall", 6, "Local", { Moved = moved }, true)
	elseif kind == "SaturdayShow" or kind == "AutoShow" then
		ev = startShow(kind, args, scope)
	elseif kind == "LeagueFinale" then
		ev = startLeagueFinale(args, scope)
	end
	if ev == nil then
		return false, "admin.evBusy"
	end
	return true, "admin.evStarted"
end

-- Admin-/System-Event starten (öffentlicher Teil von EventService.Start, siehe unten)
local function startEvent(
	kind: string,
	args: { [string]: any },
	scope: "Local" | "Global",
	by: Player?
): (boolean, string)
	local clean, err = EventService.Clamp(kind, args)
	if not clean then
		return false, err or "admin.evUnknown"
	end
	local scopeName: "Local" | "Global" = if scope == "Global" then "Global" else "Local"
	if scopeName == "Global" and kind == "AllToHall" then
		scopeName = "Local" -- nur dieser Server (§B15.3)
	end
	if scopeName == "Global" and by ~= nil then
		-- über AdminService an alle Server (MessagingService "AT_Global"); der Sender empfängt selbst
		local ok, sent, how = call("AdminService", "PublishAbuse", kind, clean, by)
		if ok and sent == true then
			return true, if how == "local" then "admin.globalFailed" else "admin.evGlobal"
		end
	end
	return runEvent(kind, clean, scopeName, if by then by.UserId else nil)
end

-- Globale Admin-Abuse-Nachricht (von AdminService.handleGlobal): jedes Feld prüfen, obere Zeitgrenze, dann planen
function EventService.ApplyGlobal(msg: any): boolean
	if type(msg) ~= "table" or type(msg.Event) ~= "string" then
		return false
	end
	local kind = msg.Event
	if not ADMIN_KINDS[kind] or kind == "AllToHall" then
		return false
	end
	local clean = EventService.Clamp(kind, msg.Args)
	if not clean then
		return false
	end
	local t = now()
	local maxSeconds = num(EV.MaxGlobalSeconds, 3600)
	local startAt = msg.StartAt
	if not isNum(startAt) or startAt > t + maxSeconds then
		return false
	end
	local untilT = msg.Until
	if not isNum(untilT) or untilT <= t or untilT > t + maxSeconds then
		return false
	end
	local by = if isNum(msg.By) and msg.By % 1 == 0 then msg.By else nil
	if startAt <= t + 0.05 then
		runEvent(kind, clean, "Global", by)
		return true
	end
	if #pending >= MAX_PENDING then
		return false
	end
	table.insert(pending, { At = startAt, Kind = kind, Args = clean, Scope = "Global", By = by, Meta = nil })
	return true
end

function EventService.Stop(kind: string): number
	if type(kind) ~= "string" then
		return 0
	end
	local keys: { string } = {}
	for key, ev in pairs(events) do
		if ev.Kind == kind then
			table.insert(keys, key)
		end
	end
	for _, key in ipairs(keys) do
		local ev = events[key]
		if ev and ev.Kind == "GoldenHour" then
			eventMultValue, eventMultUntil = 1, 0
			call("TowerService", "SetEventMult", 1, 0)
		elseif ev and ev.Kind == "Bear" then
			finishBear(false)
		end
		if ev and ev.Kind == "Boss" then
			local model = ev.Run.Model
			if typeof(model) == "Instance" then
				model:Destroy()
			end
		end
		endEvent(key)
	end
	return #keys
end

function EventService.StartParade(buyer: Player, seconds: number)
	if not isNum(seconds) or seconds <= 0 then
		return
	end
	local cfg = EV.Parade
	local length = math.clamp(seconds, 1, num(cfg.MaxSeconds, 3600))
	local userId = if present(buyer) then buyer.UserId else 0
	local name = if present(buyer) then string.sub(buyer.DisplayName, 1, 40) else "?"
	local existing = events.Parade
	local untilT = now() + length
	if existing then
		existing.Until = untilT
		existing.Data = { UserId = userId, Name = name, Route = cfg.Route or "Parade", Bulls = cfg.Bulls }
		Remotes.World:FireAllClients("Event", publicState(existing))
		markAll()
	else
		addEvent("Parade", "Parade", length, "Local", {
			UserId = userId,
			Name = name,
			Route = cfg.Route or "Parade",
			Bulls = cfg.Bulls,
		}, false)
	end
	Remotes.World:FireAllClients("Parade", { UserId = userId, Until = untilT })
	effectAll("BullParade", 1, { Seconds = length, UserId = userId, Name = name, Until = untilT })
	notifyAll("evt.paradeThanks", { name }, "Event")
end

function EventService.StartFireworks(buyer: Player)
	local plot: number? = nil
	local userId: number? = nil
	if present(buyer) then
		userId = buyer.UserId
		local ok, result = call("PlotService", "PlotOf", buyer)
		if ok and isNum(result) then
			plot = result
		end
	end
	startFireworks(num(EV.Fireworks.Seconds, 20), plot, userId, "Local", false)
	if userId then
		notifyAll("evt.fireworksBy", { playerName(userId) }, "Event")
	end
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE ABFRAGEN
-- ---------------------------------------------------------------------
function EventService.Active(): { EventState }
	local t = now()
	local list: { EventState } = {}
	for _, ev in pairs(events) do
		if ev.Until > t then
			table.insert(list, publicState(ev))
		end
	end
	table.sort(list, function(a, b)
		return a.Until < b.Until
	end)
	return list
end

function EventService.EventMult(): number
	if boostsPaused() or now() >= eventMultUntil then
		return 1
	end
	local cap = num(Config.Tower and Config.Tower.Mult and Config.Tower.Mult.EventMax, 3)
	return math.clamp(eventMultValue, 1, math.min(3, cap))
end

function EventService.IsAdminAbuse(): boolean
	local t = now()
	for _, ev in pairs(events) do
		if ev.Admin and ev.Until > t then
			return true
		end
	end
	local ok, window = call("MarketService", "AdminWindowActive")
	return ok and window == true
end

function EventService.BearActive(): boolean
	return bear ~= nil
end

function EventService.Stats(): { [string]: number }
	local open = 0
	for _, n in pairs(tokenCount) do
		open += n
	end
	return {
		Active = countEvents(),
		Started = stats.Started,
		Pickups = stats.Pickups,
		Rejected = stats.Rejected,
		BearWins = stats.BearWins,
		OpenTokens = open,
	}
end

-- nächstes Welt-Event (für die HUD-Pille „… in 4:12“)
local function nextWorld(t: number): Plain?
	local tick = Clock.TickOf(t)
	local day = Clock.DayIndex(tick)
	local minute = math.floor(num(EV.WorldMinute, 10))
	for offset = 0, 1 do
		local at = (day + offset) * DAY + minute * 60
		if at > tick then
			local kind = rotationKind(day + offset)
			if kind then
				return { Kind = kind, At = Clock.UnixOf(at) }
			end
		end
	end
	return nil
end

local function eventState(_p: Player): Plain
	local active = EventService.Active()
	while #active > MAX_ACTIVE_STATE do
		table.remove(active)
	end
	local b = bear
	return {
		Active = active,
		Next = nextWorld(now()) or { Kind = "", At = 0 },
		AdminAbuse = EventService.IsAdminAbuse(),
		BearHave = if b then b.Have else 0,
		BearGoal = if b then b.Goal else 0,
	}
end

-- ---------------------------------------------------------------------
-- REQUEST "EventPickup" {Id} (§C9: Token gehört dem Spieler, Fenster gültig, Abstand ≤ 12, max. 1 je Id)
-- ---------------------------------------------------------------------
local function reject(p: Player, key: string): Types.Reply
	stats.Rejected += 1
	local ok, lang = call("PlayerStateService", "LangOf", p)
	return { Ok = false, Message = Lang.T(if ok and (lang == "de" or lang == "en") then lang else Lang.For(p), key) }
end

local function rewardQuiz(p: Player, token: Token, ev: Ev?)
	local state = quiz[p]
	if not state or state.Event ~= token.Event or state.Done or token.Q ~= state.Q then
		return
	end
	-- alle Antwort-Felder dieser Frage verschwinden
	local list = tokens[p]
	if list then
		local siblings: { number } = {}
		for id, other in pairs(list) do
			if other.Event == token.Event and other.Reward == "Quiz" and other.Q == token.Q then
				table.insert(siblings, id)
			end
		end
		for _, id in ipairs(siblings) do
			removeToken(p, id, true)
		end
	end
	local ids: { number } = if ev and type(ev.Run.Quiz) == "table" then ev.Run.Quiz else {}
	local quizId = ids[token.Q]
	local correctIndex = 0
	for _, entry in ipairs(EV.Press.Quiz) do
		if entry.Id == quizId then
			correctIndex = entry.Correct
			break
		end
	end
	local right = token.O == correctIndex
	if right then
		state.Correct += 1
	end
	effect(
		p,
		"Toast",
		1,
		{ Key = if right then "evt.quizRight" else "evt.quizWrong", Kind = if right then "Success" else "Info" }
	)
	local total = #ids
	if token.Q >= total then
		state.Done = true
		if state.Correct >= math.floor(num(EV.Press.PassCorrect, 2)) then
			call("ProgressionService", "AddXp", p, num(EV.Press.QuizXp, 50), "PressQuiz", nil)
			notify(p, "evt.quizPassed", { state.Correct, total, math.floor(num(EV.Press.QuizXp, 50)) }, "Success")
			seasonXpOnce(p, token.Event)
		else
			notify(p, "evt.quizFailed", { state.Correct, total }, "Info")
		end
	elseif ev and ev.Until > now() then
		state.Q += 1
		issueQuestion(p, ev, state.Q)
		flushTokens(now())
	end
end

local function handlePickup(p: Player, arg: any): Types.Reply
	if type(arg) ~= "table" then
		return reject(p, "core.invalid")
	end
	for key in pairs(arg) do
		if key ~= "Id" then
			return reject(p, "core.invalid")
		end
	end
	local id = arg.Id
	if not isNum(id) or id % 1 ~= 0 or id < 1 or id > 2 ^ 31 then
		return reject(p, "core.invalid")
	end
	local list = tokens[p]
	local token = list and list[id]
	if not token then
		return reject(p, "evt.pickupGone") -- fremdes, abgelaufenes oder schon gesammeltes Token
	end
	local t = now()
	if t < token.From - PICKUP_SLACK or t > token.Until then
		if t > token.Until then
			removeToken(p, id, true)
		end
		return reject(p, "evt.pickupWindow")
	end
	local root = rootOf(p)
	if not root then
		return reject(p, "evt.pickupFar")
	end
	local range = num(EV.PickupRange, 12) + RANGE_SLACK
	if (root.Position - token.Pos).Magnitude > range then
		return reject(p, "evt.pickupFar") -- Fernsammeln abgelehnt (§C11.2)
	end
	removeToken(p, id, false)
	stats.Pickups += 1
	local ev = events[token.Event]
	if token.Reward == "Income" then
		local amount = creditIncome(p, token.Seconds, token.Source)
		local count = participation(p, token.Event)
		call("RewardService", "Track", p, "Pickup", 1, { Kind = token.Kind })
		local needed = if token.Kind == "Bundle"
			then math.floor(num(EV.Truck.SeasonXpMin, 10))
			elseif token.Kind == "Package" then math.max(1, math.floor(num(EV.Drones.Packages, 8) / 2))
			else math.huge
		if count >= needed then
			seasonXpOnce(p, token.Event)
		end
		return { Ok = true, Id = id, Credits = amount }
	elseif token.Reward == "Orb" then
		local b = bear
		if b and ev and ev.Key == b.Key then
			b.Have += 1
			bearPart[p] = (bearPart[p] or 0) + 1
			participation(p, token.Event)
			call("RewardService", "Track", p, "BearOrbs", 1, nil)
			spawnOrb(p, ev)
			flushTokens(t)
			broadcastBear(false)
			if b.Have >= b.Goal then
				finishBear(true)
			end
		end
		return { Ok = true, Id = id }
	elseif token.Reward == "Quiz" then
		rewardQuiz(p, token, ev)
		return { Ok = true, Id = id }
	end
	return { Ok = true, Id = id }
end

-- ---------------------------------------------------------------------
-- TAKT (1 Hz): Börsentag-Grenzen, Wochen-Kalender, Ablauf, Bulle, Glocken-Zone, Token senden, State
-- ---------------------------------------------------------------------
local function onTickBoundary(tick: number)
	local within = tick % DAY
	local day = tick // DAY
	if within == math.floor(num(EV.WorldMinute, 10)) * 60 then
		local kind = rotationKind(day)
		if kind then
			runEvent(kind, {}, "Local", nil)
		end
	end
	local bellCfg = EV.BellMoment
	if within == 0 and day % math.max(1, math.floor(num(bellCfg.DayEvery, 3))) == 0 then
		bellWindow = { Day = day, Until = Clock.UnixOf(tick) + num(bellCfg.WindowSeconds, 60), Done = false }
	end
	local skyCfg = EV.SkyShow
	if
		within == math.floor(num(skyCfg.Minute, 15)) * 60
		and day % math.max(1, math.floor(num(skyCfg.DayEvery, 3))) == 0
		and Clock.IsNight(tick)
	then
		startSkyShow("Local", false)
	end
end

local function bellCheck(t: number)
	local window = bellWindow
	if not window or window.Done then
		return
	end
	if t > window.Until then
		bellWindow = nil
		return
	end
	local needed = math.floor(num(EV.BellMoment.MinPlayers, 3))
	if isStudio() then
		needed = math.floor(num(Config.Studio and Config.Studio.BellZoneMinPlayers, 1))
	end
	local count = playersInBellZone()
	if count >= math.max(1, needed) then
		window.Done = true
		triggerBellMoment("Local", count)
	end
end

local function weeklyFire(entry: Plain, t: number)
	local args = if type(entry.Args) == "table" then entry.Args else {}
	if entry.Kind == "PowerHour" then
		local minutes = math.clamp(num(args.Minutes, 60), 1, 240)
		addEvent("PowerHour", "PowerHour", minutes * 60, "Local", { Mult = 2 }, false)
		notifyAll("evt.powerHour", { math.floor(minutes) }, "Event")
	elseif entry.Kind == "Reminder" then
		local key = if type(args.Text) == "string" then args.Text else "evt.cal.update"
		for _, p in ipairs(Players:GetPlayers()) do
			local ok, admin = call("AdminService", "IsAdmin", p)
			if ok and admin == true then
				notify(p, key, nil, "Alarm")
			end
		end
	elseif entry.Kind == "AutoShow" then
		local week = Clock.WeekIndex(Clock.TickOf(t))
		local ok, cancelled = call("MarketService", "AutoShowCancelled", week)
		if ok and cancelled == true then
			return -- der Besitzer hat eine eigene Show gestartet (CancelAutoShow im GlobalBus)
		end
		local clean = EventService.Clamp("AutoShow", args) or {}
		startShow("AutoShow", clean, "Local")
	elseif entry.Kind == "LeagueFinale" then
		task.spawn(function()
			local clean = EventService.Clamp("LeagueFinale", args) or {}
			startLeagueFinale(clean, "Local")
		end)
	end
end

-- Letzter Termin (Berlin) bis einschließlich t – für Server, die mitten in einem Termin starten
local function previousBerlin(entry: Plain, t: number): number?
	local prev = Clock.NextBerlin(entry.Dow, entry.HH, entry.MM, t - 8 * 86400)
	if prev > t then
		return nil
	end
	for _ = 1, 9 do -- täglich: höchstens 8 Schritte, wöchentlich: höchstens 2
		local nextAt = Clock.NextBerlin(entry.Dow, entry.HH, entry.MM, prev)
		if nextAt > t then
			break
		end
		prev = nextAt
	end
	return prev
end

-- Nachholen beim Server-Start: ein neuer Server (Andrang zur Samstags-Show!) zeigt die Automatik-Show noch,
-- wenn sie erst vor Kurzem begonnen hat (Sekunden je Kind)
local WEEKLY_CATCHUP: { [string]: number } = { AutoShow = 150 }
local catchupAt: { [string]: number } = {}

-- Absage-Liste (GlobalBus) erst nach dem Markt-Start verlässlich – vorher nichts nachholen
local function marketReady(): boolean
	if not service("MarketService") then
		return true
	end
	local ok, info = call("MarketService", "Stats")
	return ok and type(info) == "table" and info.Ready == true
end

local function weeklyCatchup(entry: Plain, key: string, t: number)
	local since = catchupAt[key]
	if since == nil then
		return
	end
	if t - since > (WEEKLY_CATCHUP[tostring(entry.Kind)] or 0) then
		catchupAt[key] = nil
	elseif marketReady() then
		catchupAt[key] = nil
		local ok, err = pcall(weeklyFire, entry, t)
		if not ok then
			logError("Weekly " .. key, err)
		end
	end
end

local function weeklyTick(t: number)
	for _, entry in ipairs(EV.Weekly) do
		local key = entry.Key
		if type(key) == "string" then
			local at = weeklyNext[key]
			if at == nil then
				weeklyNext[key] = Clock.NextBerlin(entry.Dow, entry.HH, entry.MM, t)
				local catchup = WEEKLY_CATCHUP[tostring(entry.Kind)]
				local okPrev, prev = pcall(previousBerlin, entry, t)
				if catchup and okPrev and type(prev) == "number" and t - prev <= catchup then
					catchupAt[key] = prev
				end
			elseif t >= at then
				weeklyNext[key] = Clock.NextBerlin(entry.Dow, entry.HH, entry.MM, at)
				catchupAt[key] = nil -- regulärer Termin feuert selbst
				if t - at <= 60 then
					local ok, err = pcall(weeklyFire, entry, t)
					if not ok then
						logError("Weekly " .. key, err)
					end
				end
			end
			weeklyCatchup(entry, key, t)
		end
	end
end

local function expireEvents(t: number)
	local ended: { string } = {}
	for key, ev in pairs(events) do
		if ev.Until <= t then
			table.insert(ended, key)
		elseif ev.Kind == "GoldenBull" then
			checkBullTouches(ev, t)
		elseif ev.Kind == "AutoShow" or ev.Kind == "SaturdayShow" then
			runShowSteps(ev, t)
		end
	end
	for _, key in ipairs(ended) do
		local ev = events[key]
		if ev then
			if ev.Kind == "Bear" then
				finishBear(false)
			else
				if ev.Kind == "Boss" then
					local model = ev.Run.Model
					if typeof(model) == "Instance" then
						model:Destroy()
					end
				elseif ev.Kind == "Press" then
					for p, state in pairs(quiz) do
						if state.Event == key then
							quiz[p] = nil
						end
					end
				end
				endEvent(key)
			end
		end
	end
	-- Bär: Ziel folgt der Spielerzahl (25 × anwesende Spieler)
	local b = bear
	if b then
		local goal = bearGoal()
		if goal ~= b.Goal then
			b.Goal = goal
			broadcastBear(true)
			if b.Have >= b.Goal then
				finishBear(true)
			end
		end
	end
end

local function runPending(t: number)
	local i = 1
	while i <= #pending do
		local entry = pending[i]
		if t >= entry.At then
			table.remove(pending, i)
			local ok, err = pcall(function()
				runEvent(entry.Kind, entry.Args, entry.Scope, entry.By)
			end)
			if not ok then
				logError("pending " .. entry.Kind, err)
			end
		else
			i += 1
		end
	end
end

local function tickSecond()
	local t = now()
	local tick = Clock.TickOf(t)
	local from = (lastTick or tick - 1) + 1
	if tick - from > MAX_CATCHUP_TICKS then
		from = tick - MAX_CATCHUP_TICKS -- nach Stillstand nur die letzten Sekunden nachholen
	end
	for boundary = from, tick do
		onTickBoundary(boundary)
	end
	lastTick = tick
	runPending(t)
	weeklyTick(t)
	expireEvents(t)
	bellCheck(t)
	issueAll()
	flushTokens(t)
	-- State nur bei Änderung neu senden (Bär-Fortschritt, Events, Admin-Fenster)
	local b = bear
	local upcoming = nextWorld(t)
	local sig = ("%d|%s|%d|%s"):format(
		countEvents(),
		if EventService.IsAdminAbuse() then "A" else "-",
		if b then b.Have * 1000 + b.Goal else 0,
		tostring(if upcoming then upcoming.At else 0)
	)
	if sig ~= stateSig then
		stateSig = sig
		markAll()
	end
end

-- ---------------------------------------------------------------------
-- LEBENSZYKLUS
-- ---------------------------------------------------------------------
local function clearPlayer(p: Player)
	tokens[p] = nil
	tokenCount[p] = nil
	issued[p] = nil
	collected[p] = nil
	rewarded[p] = nil
	quiz[p] = nil
	bullTouched[p] = nil
	rainPlan[p] = nil
	bearPart[p] = nil
	for _, ev in pairs(events) do
		local spawned = ev.Run.Spawned
		if type(spawned) == "table" then
			spawned[p] = nil
		end
	end
end

-- Anker-Positionen für die Clients (Glocken-Zone, Pressewand, Hall of Fame) als workspace-Attribute:
-- der Client kennt CityLayout nicht und darf unter StreamingEnabled nicht auf ferne Teile warten.
local function publishAnchors()
	local center, radius = bellZone()
	workspace:SetAttribute("AT_BellZone", center)
	workspace:SetAttribute("AT_BellZoneRadius", radius)
	local press = anchor("PressScreen")
	if press then
		workspace:SetAttribute("AT_PressPos", press.Position)
		workspace:SetAttribute("AT_PressLook", press.LookVector)
	end
	local hall = anchor("HallOfFame")
	if hall then
		workspace:SetAttribute("AT_HallPos", hall.Position)
	end
end

function EventService.Init(services: any)
	Services = services
	-- Request + State in Init registrieren (§C3 Phase 2); PlayerStateService ist Kern (WP1)
	local pss = services and services.PlayerStateService
	if pss and type(pss.Handle) == "function" and type(pss.Provide) == "function" then
		pss.Handle("EventPickup", handlePickup, { Rate = 10, Per = 1 })
		pss.Provide("Event", eventState)
	else
		warn("[EventService] PlayerStateService fehlt – EventPickup/State nicht registriert")
	end
end

-- Lebenszyklus-Start (Phase 3 im Loader): Verbindungen, Kalender-Nachlauf, Anker, Takte
local function boot()
	Players.PlayerRemoving:Connect(clearPlayer)
	call("MarketService", "OnNews", onNews)
	-- Power-Hour, die beim Server-Start schon läuft, sofort anzeigen
	local t = now()
	for _, entry in ipairs(EV.Weekly) do
		if entry.Kind == "PowerHour" and type(entry.Args) == "table" then
			local prev = Clock.NextBerlin(entry.Dow, entry.HH, entry.MM, t - 7 * 86400 - 1)
			local guard = 0
			while guard < 8 do -- höchstens 8 Kandidaten (täglich eine Woche zurück)
				guard += 1
				local nextAt = Clock.NextBerlin(entry.Dow, entry.HH, entry.MM, prev)
				if nextAt > t then
					break
				end
				prev = nextAt
			end
			local minutes = math.clamp(num(entry.Args.Minutes, 60), 1, 240)
			if prev <= t and t < prev + minutes * 60 then
				addEvent("PowerHour", "PowerHour", prev + minutes * 60 - t, "Local", { Mult = 2 }, false)
			end
		end
	end
	task.defer(function()
		local ok, err = pcall(publishAnchors)
		if not ok then
			logError("publishAnchors", err)
		end
	end)
	Scheduler.Every("EventTick", 1, tickSecond)
	Scheduler.Every("EventRain", 4, rainTick)
end

-- Ein Name, zwei Rollen: Der Vertrag (§C5.10) nennt die Event-API "EventService.Start(kind, args, scope, by)", der Loader
-- (Main.server, §C2) ruft "Service.Start()" ohne Argumente als Lebenszyklus. Ohne Argumente = einmaliger Boot,
-- mit Event-Art = Event starten. Ein zweiter Aufruf ohne Argumente startet nichts doppelt.
local booted = false

function EventService.Start(
	kind: string?,
	args: { [string]: any }?,
	scope: ("Local" | "Global")?,
	by: Player?
): (boolean, string)
	if kind == nil and args == nil then
		if booted then
			return false, "admin.evUnknown"
		end
		booted = true
		boot()
		return true, ""
	end
	if type(kind) ~= "string" then
		return false, "admin.evUnknown"
	end
	return startEvent(
		kind,
		if type(args) == "table" then args else {},
		if scope == "Global" then "Global" else "Local",
		by
	)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">GraphicsService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Future-Licht-Grundausstattung (Server/Services/GraphicsService)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §C5.6 (GraphicsService.Apply einmal in Init, danach nie
--  wieder serverseitig), §A4 (Licht-Werte), REUSE §1.3 PATTERN (clearOld eigener Instanzen – kein doppeltes Bloom).
--  Lighting.Technology = Future steht in default.project.json (RobloxScriptSecurity – Skripte setzen es NICHT).
--  Der Server legt den Tag-Startwert an; Tag/Nacht (= Börsentag), Markt-Wetter, Crash/Rally und Tiefenschärfe rechnet
--  jeder Client selbst (Client/Modules/WorldLook) – alle synchron über workspace:GetServerTimeNow().
--
--  Öffentliche API (§C5.6):
--    GraphicsService.Apply()      einmal in Init (weitere Aufrufe ändern nichts)
--  Instanz-Namen: "AT_Atmosphere", "AT_Sky", "AT_Bloom", "AT_SunRays", "AT_ColorCorrection", "AT_Clouds".
-- =====================================================================

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Clock = require(Shared:WaitForChild("Clock"))

local GraphicsService = {}

local PREFIX = "[GraphicsService] "
-- diese Effekte bauen wir selbst -> alte/doppelte Versionen vorher entfernen (sonst addieren sie sich)
local OWN_CLASSES = {
	"Atmosphere",
	"Sky",
	"BloomEffect",
	"SunRaysEffect",
	"ColorCorrectionEffect",
	"DepthOfFieldEffect",
}

local applied = false

-- Rückfall, falls Config.City.Look fehlt (gleiche Werte wie §A4)
local FALLBACK = {
	Day = {
		Ambient = Color3.fromRGB(92, 98, 112),
		OutdoorAmbient = Color3.fromRGB(128, 136, 152),
		Brightness = 2.4,
		ColorShiftTop = Color3.fromRGB(255, 246, 232),
		ExposureCompensation = 0,
		Atmosphere = {
			Density = 0.30,
			Haze = 1.2,
			Color = Color3.fromRGB(199, 214, 255),
			Decay = Color3.fromRGB(106, 122, 154),
			Glare = 0.2,
			Offset = 0.25,
		},
	},
	Bloom = { Intensity = 0.55, Size = 24, Threshold = 1.5 },
	SunRays = { Intensity = 0.04, Spread = 0.6 },
	ColorCorrection = { Contrast = 0.08, Saturation = 0.05, Brightness = 0, Tint = Color3.new(1, 1, 1) },
	Sky = { StarCount = 3000, SunAngularSize = 12, MoonAngularSize = 9 },
	Shadows = { Softness = 0.15, Latitude = 41 },
}

local function look(): any
	local city = Config.City
	local value = type(city) == "table" and city.Look or nil
	if type(value) ~= "table" or type(value.Day) ~= "table" then
		warn(PREFIX .. "Config.City.Look fehlt – nehme Standardwerte")
		return FALLBACK
	end
	return value
end

local function clearOld()
	for _, child in ipairs(Lighting:GetChildren()) do
		if table.find(OWN_CLASSES, child.ClassName) then
			child:Destroy()
		end
	end
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		for _, child in ipairs(terrain:GetChildren()) do
			if child:IsA("Clouds") then
				child:Destroy()
			end
		end
	end
end

local function applyLighting(values: any)
	local day = values.Day
	local shadows = values.Shadows or FALLBACK.Shadows
	Lighting.Ambient = day.Ambient
	Lighting.OutdoorAmbient = day.OutdoorAmbient
	Lighting.Brightness = day.Brightness
	Lighting.ColorShift_Top = day.ColorShiftTop
	Lighting.ColorShift_Bottom = Color3.new(0, 0, 0)
	Lighting.ExposureCompensation = day.ExposureCompensation or 0
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = shadows.Softness
	Lighting.GeographicLatitude = shadows.Latitude
	-- Startwert = aktuelle Tageszeit des Börsentags (Clients übernehmen sofort selbst)
	local ok, clockTime = pcall(function(): number
		return Clock.ClockTime(Clock.Now() - Clock.EPOCH)
	end)
	Lighting.ClockTime = if ok and type(clockTime) == "number" then clockTime else 9
end

local function buildEffects(values: any)
	local atmo = values.Day.Atmosphere
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "AT_Atmosphere"
	atmosphere.Density = atmo.Density
	atmosphere.Haze = atmo.Haze
	atmosphere.Color = atmo.Color
	atmosphere.Decay = atmo.Decay
	atmosphere.Glare = atmo.Glare
	atmosphere.Offset = atmo.Offset
	atmosphere.Parent = Lighting

	local skyDef = values.Sky or FALLBACK.Sky
	local sky = Instance.new("Sky") -- Standard-Himmel (eingebaute Texturen, ASSETS.md §6), nachts Sterne
	sky.Name = "AT_Sky"
	sky.StarCount = skyDef.StarCount
	sky.SunAngularSize = skyDef.SunAngularSize
	sky.MoonAngularSize = skyDef.MoonAngularSize
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting

	local bloomDef = values.Bloom or FALLBACK.Bloom
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "AT_Bloom"
	bloom.Intensity = bloomDef.Intensity
	bloom.Size = bloomDef.Size
	bloom.Threshold = bloomDef.Threshold
	bloom.Parent = Lighting

	local raysDef = values.SunRays or FALLBACK.SunRays
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "AT_SunRays"
	rays.Intensity = raysDef.Intensity
	rays.Spread = raysDef.Spread
	rays.Parent = Lighting

	local ccDef = values.ColorCorrection or FALLBACK.ColorCorrection
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "AT_ColorCorrection"
	cc.Contrast = ccDef.Contrast
	cc.Saturation = ccDef.Saturation
	cc.Brightness = ccDef.Brightness
	cc.TintColor = ccDef.Tint
	cc.Parent = Lighting
end

local function buildClouds()
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return
	end
	local weather = Config.City and Config.City.Weather
	local clouds = Instance.new("Clouds")
	clouds.Name = "AT_Clouds"
	clouds.Cover = if type(weather) == "table" then weather.Cover.Clear else 0.2
	clouds.Density = if type(weather) == "table" then weather.Density.Clear else 0.5
	clouds.Color = Color3.new(1, 1, 1)
	clouds.Enabled = true
	clouds.Parent = terrain
end

function GraphicsService.Apply()
	if applied then
		return -- nur einmal (§C5.6): danach ändert der Server Lighting nie wieder
	end
	applied = true
	local values = look()
	clearOld()
	local ok, err = pcall(function()
		applyLighting(values)
		buildEffects(values)
		buildClouds()
	end)
	if not ok then
		warn(PREFIX .. "Licht konnte nicht vollständig gesetzt werden: " .. tostring(err))
	end
end

function GraphicsService.Init(_services: any)
	GraphicsService.Apply()
end

function GraphicsService.Start() end

return GraphicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Bestenlisten, Wochen-Liga, Hall of Fame, IPO-Wand (Server/Services/LeaderboardService)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §C5.8, §C9 (BoardsGet), §B11.1
--  (6 Bestenlisten, Liga nach Skill-Score, absolute Stufen, Hall of Fame), §B9.6 (Ticker 24 h auf der IPO-Wand +
--  "Hall of IPOs"), §A7 #12 (goldene Statuen), REUSE §3.15 (CC-LeaderboardService ADAPT: Schreib-/Lese-Takt,
--  nur geänderte Werte, begrenzter Namens-Cache, Schreiben beim Verlassen, NoSave/TestPlayer nie).
--
--  Öffentliche API (§C5.8):
--    LeaderboardService.Submit(p)                       Werte vormerken (Schreiben ≥ 300 s Abstand, nur bei Änderung)
--    LeaderboardService.Top(board, n): { { UserId, Name, Value } }   Cache (Lesen alle 300 s)
--  Ergänzung: LeaderboardService.AddIpo(p, ticker)       IPO-Wand + Hall of IPOs (DataStore, alle Server)
--  Request-Handler: BoardsGet { Board, Scope = "Global" | "Friends" | "Server" } (1/s, aus Cache).
--  OrderedDataStores Config.Tech.BoardPrefix .. Store .. "_v1" bzw. .. "_" .. IsoWeek; Werte ganzzahlig 0 … 9e15
--  (Kodierung Shared/ProgressMath.Board*). Studio ohne API / NoSave / UserId ≤ 0: kein Schreiben (Lesen versucht).
-- =====================================================================

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))
local Lang = require(Shared:WaitForChild("Lang"))
local Format = require(Shared:WaitForChild("Format"))
local ProgressMath = require(Shared:WaitForChild("ProgressMath"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local LeaderboardService = {}
local Services: any = nil

type Reply = Types.Reply
type Row = { UserId: number, Value: number }
type Change = { Store: string, Value: number, Remove: boolean? }
type BoardDef = { Key: string, Store: string, Weekly: boolean, Kind: string, Title: string }

local PCFG: any = Config.Progression
local BCFG: any = PCFG.Boards
local TECH: any = Config.Tech
local PREFIX = if type(TECH.BoardPrefix) == "string" then TECH.BoardPrefix else "AT_LB_"
local WRITE_EVERY = math.max(60, tonumber(TECH.BoardWriteSeconds) or 300)
local READ_EVERY = WRITE_EVERY
local ROWS = math.clamp(tonumber(BCFG.Rows) or 10, 1, 10)
local CACHE_TOP = math.clamp(tonumber(BCFG.CacheTop) or 100, ROWS, 100)
local NAME_CACHE_MAX = math.max(20, tonumber(BCFG.NameCache) or 200)
local MAX_VALUE = 9e15
local FIRST_READ_DELAY = 8
local LOG_GAP = 30
local BOARD_RETRY = 10
local BOARD_RETRY_MAX = 60
local FRIENDS_TTL = 600
local FRIENDS_MAX = 200
local IPO_WALL_ROWS = 6
local IPO_HALL_ROWS = 12
local LIVE_EVERY = 15 -- Welt-Tafeln: Werte der Spieler in diesem Server alle 15 s live einmischen (ohne DataStore)
local RETURN_ZERO = 1000000 -- ProgressMath.BoardReturn: 0 bp Ø-Tagesrendite
local NO_API_HINTS = { "studio", "publish", "api services", "403" }

-- AKYTEX-Farben (Server hat kein UI.Theme -> Config.Colors, Spiegel von UI.Theme)
local C = Config.Colors
local GOLD = C.Gold
local RANK_COLORS = { C.Gold, C.Text2, Color3.fromRGB(205, 127, 50) }
local FACE_DISPLAY = Font.new("rbxasset://fonts/families/BuilderExtended.json", Enum.FontWeight.Bold)
local FACE_MONO = Font.new("rbxasset://fonts/families/BuilderMono.json", Enum.FontWeight.Regular)
local FACE_BODY = Font.fromEnum(Enum.Font.BuilderSansBold)

local BOARDS: { BoardDef } = BCFG.List
local boardByKey: { [string]: BoardDef } = {}
for _, def in ipairs(BOARDS) do
	boardByKey[def.Key] = def
end

-- Pro-Spieler-Tabellen (alle bei PlayerRemoving geleert, Schreib-Threads laufen zu Ende)
local lastWritten: { [Player]: { [string]: number } } = {}
local lastValues: { [Player]: { [string]: number } } = {}
local lastWriteAt: { [Player]: number } = {}
local pending: { [Player]: boolean } = {}
local writing: { [Player]: boolean } = {}
local friendsOf: { [Player]: { At: number, Ids: { [number]: string } } } = {}

local stores: { [string]: OrderedDataStore } = {}
local cache: { [string]: { Row } } = {}
local boardUis: { [string]: any } = {}
local topUser: { [string]: number } = {}
local lastRows: { [string]: string } = {}
local nameCache: { [number]: string } = {}
local nameOrder: { number } = {}
local lastLogAt: { [string]: number } = {}
local readRunning = false
local readDisabled = false
local hallWeek = -1
local hallBusy = false
local hallFolder: Folder? = nil
local ipoHall: { { T: string, N: string, U: number, At: number } } = {}
local ipoUi: any = nil
local hallUi: any = nil
local globalStore: DataStore? = nil
local globalFailed = false
-- Wunsch 18: Netto-Vermögen zeigt Admin-Geld markiert – auch für Spieler in anderen Servern (Liste im GlobalStore)
local ADMIN_MARK_KEY = "AdminMarks_v1"
local ADMIN_MARK_MAX = 500
local adminMarks: { [number]: boolean } = {} -- gelesen (alle Server) + selbst gemeldet
local adminMarkSent: { [number]: boolean } = {} -- in diesem Server schon gemeldet (bei PlayerRemoving geleert)

-- ---------------------------------------------------------------------
-- 0) HELFER
-- ---------------------------------------------------------------------
local function logError(where: string, err: any)
	local now = os.clock()
	if (lastLogAt[where] or -math.huge) + LOG_GAP <= now then
		lastLogAt[where] = now
		warn("[LeaderboardService] " .. where .. ": " .. tostring(err))
	end
end

local function finite(n: any): boolean
	return Util.IsFinite(n)
end

local function num(v: any, default: number): number
	return if Util.IsFinite(v) then v else default
end

local function call(name: string, fnName: string, ...: any): (boolean, ...any)
	local svc = Services and Services[name]
	local fn = svc and svc[fnName]
	if type(fn) ~= "function" then
		return false
	end
	local results = table.pack(pcall(fn, ...))
	if not results[1] then
		logError(name .. "." .. fnName, results[2])
		return false
	end
	return true, table.unpack(results, 2, results.n)
end

local function dataOf(p: Player): { [string]: any }?
	local ok, data = call("DataService", "Get", p)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

local function langOf(p: Player): Types.Lang
	local ok, lang = call("PlayerStateService", "LangOf", p)
	if ok and (lang == "de" or lang == "en") then
		return lang
	end
	return "en"
end

local function fail(p: Player, key: string): Reply
	return { Ok = false, Message = Lang.T(langOf(p), key) }
end

local function storeName(def: BoardDef, week: number?): string
	if def.Weekly then
		return PREFIX .. def.Store .. "_" .. tostring(week or Util.IsoWeek())
	end
	return PREFIX .. def.Store .. "_v1"
end

local function storeFor(name: string): OrderedDataStore?
	local store = stores[name]
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	if not ok then
		logError("GetOrderedDataStore", result)
		return nil
	end
	-- alte Wochen-Stores vergessen (Speicher bleibt klein)
	local count = 0
	for _ in pairs(stores) do
		count += 1
	end
	if count > 24 then
		table.clear(stores)
	end
	stores[name] = result
	return result
end

local function noApi(err: any): boolean
	local message = string.lower(tostring(err))
	for _, hint in ipairs(NO_API_HINTS) do
		if string.find(message, hint, 1, true) then
			return true
		end
	end
	return false
end

-- ---------------------------------------------------------------------
-- 1) WERTE (§B11.1) – ganzzahlig, 0 = nicht schreiben, REMOVE = vorhandenen Eintrag löschen
-- ---------------------------------------------------------------------
local REMOVE = -1
local function leagueStats(p: Player): any
	local ok, stats = call("OrderService", "LeagueStats", p)
	return if ok and type(stats) == "table" then stats else nil
end

local function valueOf(p: Player, data: { [string]: any }, def: BoardDef): number
	local key = def.Key
	local value = 0
	if key == "Wealth" then
		local ok, wealth = call("ProgressionService", "Wealth", p)
		value = if ok and finite(wealth) and wealth > 0 then ProgressMath.BoardLog(wealth) else 0
	elseif key == "League" or key == "Return" then
		local stats = leagueStats(p)
		-- nur qualifiziert (≥ 20 zählende Trades, ≥ 6 Tage), nie getaintet (Admin-Gaben, Besitzer): wird ein schon
		-- eingetragener Spieler in der Woche getaintet, verschwindet sein Eintrag wieder (§B11.1)
		if stats and stats.Tainted == true then
			return REMOVE
		elseif stats and stats.Qualified == true then
			value = if key == "League"
				then ProgressMath.BoardLeague(stats.SkillScore, stats.AvgDailyBp)
				else ProgressMath.BoardReturn(stats.AvgDailyBp)
		end
	elseif key == "Skyline" then
		local okIpo, ipos = call("ProgressionService", "IpoCount", p)
		local okFloors, floors = call("TowerService", "Floors", p)
		local ipoCount = if okIpo and finite(ipos) then ipos else 0
		local floorCount = if okFloors and finite(floors) then floors else 0
		value = if ipoCount + floorCount > 0 then ProgressMath.BoardSkyline(ipoCount, floorCount) else 0
	elseif key == "Firm" then
		local prog = data.Prog
		local prestige = if type(prog) == "table" then prog.Prestige else nil
		local firm = if type(prestige) == "table" then num(prestige.Firmenwert, 0) else 0
		value = if firm > 0 then ProgressMath.BoardLog(firm) else 0
	elseif key == "Respekt" then
		local social = data.Social
		if type(social) == "table" and social.RespektWeek == Util.IsoWeek() then
			value = math.max(0, math.floor(num(social.RespektGot, 0)))
		end
	end
	return math.floor(math.clamp(value, 0, MAX_VALUE))
end

local function canWrite(p: Player): boolean
	-- nie in Studio (Abnahme 6), nie für Test-Spieler (UserId ≤ 0) und NoSave-Profile
	if p.UserId <= 0 or RunService:IsStudio() then
		return false
	end
	local ok, noSave = call("DataService", "IsNoSave", p)
	return not (ok and noSave == true)
end

-- Kein öffentliches Verlust-Zeigen (§B11.5/§B11.8): negative Ø-Tagesrenditen anderer Spieler nie anzeigen
-- (der eigene Wert bleibt für den Spieler selbst sichtbar)
local function hiddenLoss(def: BoardDef, row: Row, viewerId: number?): boolean
	return def.Kind == "Return" and row.Value < RETURN_ZERO and row.UserId ~= viewerId
end

-- Gelesene Top-Liste + Live-Werte der Spieler in DIESEM Server (frischer als der 300-s-Cache; in Studio ohne
-- DataStore die einzige Quelle) -> sortiert. Getaintete/leere Live-Werte verdrängen den alten Cache-Eintrag.
local function mergeLive(def: BoardDef, rows: { Row }?, viewerId: number?): { Row }
	local live: { [number]: number } = {}
	for _, other in ipairs(Players:GetPlayers()) do
		local data = dataOf(other)
		if data then
			local value = valueOf(other, data, def)
			live[other.UserId] = if value > 0 then value else 0
		end
	end
	local merged: { Row } = {}
	for _, row in ipairs(rows or {}) do
		if live[row.UserId] == nil and not hiddenLoss(def, row, viewerId) then
			table.insert(merged, row)
		end
	end
	for userId, value in pairs(live) do
		local row = { UserId = userId, Value = value }
		if value > 0 and not hiddenLoss(def, row, viewerId) then
			table.insert(merged, row)
		end
	end
	table.sort(merged, function(a, b)
		if a.Value ~= b.Value then
			return a.Value > b.Value
		end
		return a.UserId < b.UserId
	end)
	return merged
end

-- ---------------------------------------------------------------------
-- 2) SCHREIBEN (nur geänderte Werte)
-- ---------------------------------------------------------------------
local function collect(p: Player, data: { [string]: any }): { Change }
	local changes: { Change } = {}
	local written = lastWritten[p] or {}
	local values = lastValues[p] or {}
	lastValues[p] = values
	for _, def in ipairs(BOARDS) do
		local name = storeName(def)
		local value = valueOf(p, data, def)
		if value == REMOVE then
			values[name] = nil
			if written[name] ~= nil then
				table.insert(changes, { Store = name, Value = 0, Remove = true })
			end
		else
			if value > 0 then
				values[name] = value
			end
			local final = values[name] or 0
			if final > 0 and written[name] ~= final then
				table.insert(changes, { Store = name, Value = final })
			end
		end
	end
	return changes
end

-- yieldet (SetAsync/RemoveAsync); immer im eigenen Thread
local function writeChanges(p: Player, userId: number, changes: { Change })
	for _, change in ipairs(changes) do
		local store = storeFor(change.Store)
		if store then
			local ok, err = pcall(function()
				if change.Remove then
					store:RemoveAsync(tostring(userId))
				else
					store:SetAsync(tostring(userId), change.Value)
				end
			end)
			if ok then
				local written = lastWritten[p]
				if written then
					written[change.Store] = if change.Remove then nil else change.Value
				end
			else
				logError((if change.Remove then "RemoveAsync " else "SetAsync ") .. change.Store, err)
			end
		end
	end
end

local markAdmin: (p: Player, data: { [string]: any }) -> ()

local function writePlayer(p: Player, force: boolean)
	if writing[p] or not canWrite(p) then
		return
	end
	local now = os.clock()
	if not force and now - (lastWriteAt[p] or -math.huge) < WRITE_EVERY then
		return
	end
	local data = dataOf(p)
	if not data then
		return
	end
	markAdmin(p, data)
	lastWritten[p] = lastWritten[p] or {}
	local changes = collect(p, data)
	pending[p] = nil
	if #changes == 0 then
		return
	end
	lastWriteAt[p] = now
	writing[p] = true
	local userId = p.UserId
	task.spawn(function()
		writeChanges(p, userId, changes)
		writing[p] = nil
	end)
end

function LeaderboardService.Submit(p: Player)
	if typeof(p) ~= "Instance" or not p:IsA("Player") or p.Parent ~= Players then
		return
	end
	pending[p] = true
	writePlayer(p, false)
end

local function writeTick()
	for _, p in ipairs(Players:GetPlayers()) do
		if pending[p] or os.clock() - (lastWriteAt[p] or 0) >= WRITE_EVERY then
			writePlayer(p, false)
		end
	end
end

-- Beim Verlassen: letzter Stand (eigener Thread; Werte aus dem Cache, falls andere Dienste schon aufgeräumt haben)
local function onReleasing(p: Player, data: { [string]: any })
	if not canWrite(p) or type(data) ~= "table" then
		return
	end
	lastWritten[p] = lastWritten[p] or {}
	local changes = collect(p, data)
	if #changes > 0 then
		task.spawn(writeChanges, p, p.UserId, changes)
	end
end

-- ---------------------------------------------------------------------
-- 3) NAMEN (Cache ≤ 200)
-- ---------------------------------------------------------------------
local function cachedName(userId: number): string?
	local inServer = Players:GetPlayerByUserId(userId)
	if inServer then
		return inServer.DisplayName
	end
	return nameCache[userId]
end

local function rememberName(userId: number, name: string)
	if nameCache[userId] == nil then
		table.insert(nameOrder, userId)
	end
	nameCache[userId] = name
	while #nameOrder > NAME_CACHE_MAX do
		local oldest = table.remove(nameOrder, 1)
		if oldest then
			nameCache[oldest] = nil
		end
	end
end

-- yieldet
local function fetchName(userId: number): string
	local known = cachedName(userId)
	if known then
		return known
	end
	if userId <= 0 then
		return "Player" .. tostring(-userId)
	end
	local ok, result = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(result) == "string" then
		rememberName(userId, result)
		return result
	end
	return "#" .. tostring(userId)
end

-- ---------------------------------------------------------------------
-- 4) ANZEIGE-FORMAT (eine Sprache auf Welt-Tafeln: neutrale Kurzform)
-- ---------------------------------------------------------------------
local function display(def: BoardDef, value: number, lang: Types.Lang): string
	if def.Kind == "Log" then
		local ok, text = pcall(Format.Compact, ProgressMath.BoardLogDecode(value), lang)
		return "≈ " .. (if ok then text else tostring(math.floor(ProgressMath.BoardLogDecode(value))))
	elseif def.Kind == "League" then
		return Lang.T(lang, "soc.board.skill", math.floor(value / 10000))
	elseif def.Kind == "Return" then
		local bp = value - 1000000
		local ok, text = pcall(Format.Pct, bp / 10000, lang, 2, true)
		return if ok then text else string.format("%+.2f %%", bp / 100)
	end
	local ok, text = pcall(Format.Int, value, lang)
	return if ok then text else tostring(value)
end

-- ---------------------------------------------------------------------
-- 5) WELT-TAFELN (SurfaceGui im AKYTEX-Look auf CityService.BoardPart)
-- ---------------------------------------------------------------------
local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for key, value in pairs(props) do
		(inst :: any)[key] = value
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function border(parent: Instance, color: Color3, transparency: number?)
	make("UIStroke", {
		Thickness = 1.5,
		Color = color,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function panel(part: BasePart, name: string): (SurfaceGui, Frame)
	local old = part:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local gui: SurfaceGui = make("SurfaceGui", {
		Name = name,
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 30,
		LightInfluence = 0,
		Brightness = 1.6,
		MaxDistance = 300,
		ResetOnSpawn = false,
		Adornee = part,
	})
	local root: Frame = make("Frame", {
		Name = "Panel",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Bg,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
	}, gui)
	make("UICorner", { CornerRadius = UDim.new(0, 16) }, root)
	border(root, C.Border)
	make("UIPadding", {
		PaddingLeft = UDim.new(0.04, 0),
		PaddingRight = UDim.new(0.04, 0),
		PaddingTop = UDim.new(0.03, 0),
		PaddingBottom = UDim.new(0.03, 0),
	}, root)
	return gui, root
end

local function title(root: Frame, text: string, heightScale: number, color: Color3?)
	make("TextLabel", {
		Name = "Title",
		Size = UDim2.fromScale(1, heightScale),
		BackgroundTransparency = 1,
		FontFace = FACE_DISPLAY,
		Text = text,
		TextColor3 = C.Text,
		TextScaled = true,
	}, root)
	local underline: Frame = make("Frame", {
		Name = "TitleLine",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, heightScale + 0.012),
		Size = UDim2.fromScale(0.22, 0.008),
		BackgroundColor3 = color or C.Accent,
		BorderSizePixel = 0,
	}, root)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, underline)
end

local function buildBoard(def: BoardDef, part: BasePart)
	local gui, root = panel(part, "AT_Board")
	title(root, def.Title, 0.1)
	local list: Frame = make("Frame", {
		Position = UDim2.fromScale(0, 0.15),
		Size = UDim2.fromScale(1, 0.85),
		BackgroundTransparency = 1,
	}, root)
	make("UIListLayout", { Padding = UDim.new(0.008, 0), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	local rows = {}
	for i = 1, ROWS do
		local accent = RANK_COLORS[i]
		local frame: Frame = make("Frame", {
			Name = "Row" .. i,
			LayoutOrder = i,
			Size = UDim2.fromScale(1, 1 / ROWS - 0.009),
			BackgroundColor3 = if i % 2 == 0 then C.Bg else C.Surface2,
			BackgroundTransparency = 0.1,
			BorderSizePixel = 0,
			Visible = false,
		}, list)
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, frame)
		if accent then
			local stripe: Frame = make("Frame", {
				Name = "Stripe",
				Position = UDim2.new(0, 0, 0.18, 0),
				Size = UDim2.new(0, 4, 0.64, 0),
				BackgroundColor3 = accent,
				BorderSizePixel = 0,
			}, frame)
			make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, stripe)
			border(frame, accent, 0.55)
		end
		local rank: TextLabel = make("TextLabel", {
			Position = UDim2.fromScale(0.02, 0.1),
			Size = UDim2.fromScale(0.09, 0.8),
			BackgroundTransparency = 1,
			FontFace = FACE_MONO,
			Text = "#" .. i,
			TextScaled = true,
			TextColor3 = accent or C.Muted,
		}, frame)
		local avatar: ImageLabel = make("ImageLabel", {
			Position = UDim2.fromScale(0.12, 0.1),
			Size = UDim2.fromScale(0.08, 0.8),
			BackgroundColor3 = C.Surface2,
			ScaleType = Enum.ScaleType.Fit,
			Image = "",
		}, frame)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, avatar)
		make("UIAspectRatioConstraint", { AspectRatio = 1 }, avatar)
		local name: TextLabel = make("TextLabel", {
			Position = UDim2.fromScale(0.22, 0.12),
			Size = UDim2.fromScale(0.46, 0.76),
			BackgroundTransparency = 1,
			FontFace = FACE_BODY,
			Text = "",
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = C.Text,
		}, frame)
		local value: TextLabel = make("TextLabel", {
			Position = UDim2.fromScale(0.69, 0.1),
			Size = UDim2.fromScale(0.29, 0.8),
			BackgroundTransparency = 1,
			FontFace = FACE_MONO,
			Text = "",
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = C.Up,
		}, frame)
		rows[i] = { Frame = frame, Rank = rank, Avatar = avatar, Name = name, Value = value }
	end
	local empty: TextLabel = make("TextLabel", {
		Position = UDim2.fromScale(0.05, 0.42),
		Size = UDim2.fromScale(0.9, 0.18),
		BackgroundTransparency = 1,
		FontFace = FACE_BODY,
		Text = Lang.T("de", "soc.board.empty") .. "\n" .. Lang.T("en", "soc.board.empty"),
		TextScaled = true,
		TextColor3 = C.Text2,
	}, root)
	gui.Parent = part
	boardUis[def.Key] = { Gui = gui, Rows = rows, Empty = empty }
end

local function showBoard(def: BoardDef, rows: { Row })
	local ui = boardUis[def.Key]
	if not ui then
		return
	end
	local parts = {}
	for i = 1, math.min(#rows, ROWS) do
		table.insert(parts, rows[i].UserId .. ":" .. rows[i].Value)
	end
	local signature = table.concat(parts, ",")
	if lastRows[def.Key] == signature then
		return
	end
	lastRows[def.Key] = signature
	ui.Empty.Visible = #rows == 0
	for i, rowUi in ipairs(ui.Rows) do
		local row = rows[i]
		if row then
			rowUi.Name.Text = cachedName(row.UserId) or ("#" .. tostring(row.UserId))
			rowUi.Value.Text = display(def, row.Value, "en")
			rowUi.Avatar.Image = if row.UserId > 0
				then ("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48"):format(row.UserId)
				else ""
			rowUi.Frame.Visible = true
		else
			rowUi.Frame.Visible = false
		end
	end
end

local function boardName(def: BoardDef): { de: string, en: string }
	return { de = Lang.T("de", "soc.board." .. def.Key), en = Lang.T("en", "soc.board." .. def.Key) }
end

-- neue #1 (Spieler in diesem Server) -> Ansage
local function announceTop(def: BoardDef, rows: { Row })
	local first = rows[1]
	if not first then
		return
	end
	local before = topUser[def.Key]
	topUser[def.Key] = first.UserId
	if before ~= nil and before ~= first.UserId then
		local holder = Players:GetPlayerByUserId(first.UserId)
		if holder then
			call("CommunityService", "Announce", "soc.newTop", { holder.DisplayName, boardName(def) })
		end
	end
end

-- ---------------------------------------------------------------------
-- 6) LESEN (Top 100 je Tafel alle 300 s, 0,5 s versetzt)
-- ---------------------------------------------------------------------
local function readStore(name: string, n: number): { Row }?
	local store = storeFor(name)
	if not store then
		return nil
	end
	local ok, result = pcall(function()
		local pages = store:GetSortedAsync(false, n)
		return pages:GetCurrentPage()
	end)
	if not ok or type(result) ~= "table" then
		if noApi(result) then
			readDisabled = true
			warn("[LeaderboardService] Kein DataStore-Zugriff (Studio?) – Bestenlisten bleiben leer")
			return nil
		end
		logError("GetSortedAsync " .. name, result)
		return nil
	end
	local rows: { Row } = {}
	for _, entry in ipairs(result) do
		local userId = tonumber(entry.key)
		if userId and finite(entry.value) and #rows < n then
			table.insert(rows, { UserId = userId, Value = entry.value })
		end
	end
	return rows
end

local refreshHall: () -> ()
local refreshIpoHall: () -> ()
local refreshAdminMarks: () -> ()
local buildHall: (def: BoardDef, week: number) -> ()

local function readAll()
	if readRunning then
		return
	end
	readRunning = true
	task.spawn(function()
		if not readDisabled then
			for _, def in ipairs(BOARDS) do
				local rows = if readDisabled then nil else readStore(storeName(def), CACHE_TOP)
				if rows then
					cache[def.Key] = rows
					for i = 1, math.min(#rows, ROWS) do
						fetchName(rows[i].UserId)
					end
					local ok, err = pcall(function()
						local merged = mergeLive(def, rows, nil)
						showBoard(def, merged)
						announceTop(def, merged)
					end)
					if not ok then
						logError("Tafel " .. def.Key, err)
					end
				end
				task.wait(BCFG.ReadStagger or 0.5)
			end
		end
		local okHall, errHall = pcall(refreshHall)
		if not okHall then
			logError("Hall of Fame", errHall)
		end
		local okIpo, errIpo = pcall(refreshIpoHall)
		if not okIpo then
			logError("IPO-Wand", errIpo)
		end
		local okMarks, errMarks = pcall(refreshAdminMarks)
		if not okMarks then
			logError("Admin-Marken", errMarks)
		end
		readRunning = false
	end)
end

function LeaderboardService.Top(board: string, n: number): { { UserId: number, Name: string, Value: number } }
	local rows = cache[board]
	local out = {}
	if type(rows) ~= "table" then
		return out
	end
	local count = math.clamp(math.floor(num(n, ROWS)), 0, #rows)
	for i = 1, count do
		local row = rows[i]
		table.insert(out, {
			UserId = row.UserId,
			Name = cachedName(row.UserId) or ("#" .. tostring(row.UserId)),
			Value = row.Value,
		})
	end
	return out
end

-- ---------------------------------------------------------------------
-- 7) HALL OF FAME (Liga-Top-3 der Vorwoche als goldene Statuen, §B11.1/§A7 #12)
-- ---------------------------------------------------------------------
local function goldify(model: Model)
	for _, inst in ipairs(model:GetDescendants()) do
		if inst:IsA("BasePart") then
			inst.Material = Enum.Material.Metal
			inst.Color = GOLD
			inst.Anchored = true
			inst.CanCollide = false
			inst.CanQuery = false
			inst.CanTouch = false
			inst.CastShadow = true
			if inst:IsA("MeshPart") then
				pcall(function()
					(inst :: MeshPart).TextureID = ""
				end)
			end
		elseif inst:IsA("SpecialMesh") then
			inst.TextureId = ""
		elseif
			inst:IsA("Clothing")
			or inst:IsA("ShirtGraphic")
			or inst:IsA("SurfaceAppearance")
			or inst:IsA("BaseScript")
			or inst:IsA("Sound")
		then
			inst:Destroy()
		elseif inst:IsA("Humanoid") then
			inst.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			inst.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end
	end
end

-- Part-Puppe (Studio/negative UserId/Fehler): schlichte Figur aus Blöcken
local function puppet(): Model
	local model = Instance.new("Model")
	model.Name = "Statue"
	local function block(name: string, size: Vector3, offset: Vector3, shape: Enum.PartType?)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.CFrame = CFrame.new(offset)
		if shape then
			part.Shape = shape
		end
		part.Parent = model
		return part
	end
	local torso = block("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0))
	block("Head", Vector3.new(1.3, 1.3, 1.3), Vector3.new(0, 4.7, 0), Enum.PartType.Ball)
	block("LeftArm", Vector3.new(0.9, 2, 0.9), Vector3.new(-1.5, 3, 0))
	block("RightArm", Vector3.new(0.9, 2, 0.9), Vector3.new(1.5, 3.4, 0))
	block("LeftLeg", Vector3.new(0.95, 2, 0.95), Vector3.new(-0.5, 1, 0))
	block("RightLeg", Vector3.new(0.95, 2, 0.95), Vector3.new(0.5, 1, 0))
	model.PrimaryPart = torso
	return model
end

-- yieldet (CreateHumanoidModelFromUserIdAsync)
local function statueFor(userId: number): Model
	if userId > 0 then
		local ok, result = pcall(function()
			local players: any = Players
			local method = players.CreateHumanoidModelFromUserIdAsync
			if type(method) == "function" then
				return method(players, userId)
			end
			return players:CreateHumanoidModelFromUserId(userId)
		end)
		if ok and typeof(result) == "Instance" and result:IsA("Model") then
			return result
		end
		logError("CreateHumanoidModelFromUserIdAsync", result)
	end
	return puppet()
end

local function placeOn(model: Model, top: BasePart)
	pcall(function()
		model:ScaleTo(1.15)
	end)
	local bbox, size = model:GetBoundingBox()
	local pivot = model:GetPivot()
	local offsetY = pivot.Position.Y - (bbox.Position.Y - size.Y / 2)
	local surface = top.Position + Vector3.new(0, top.Size.Y / 2, 0)
	local look = top.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	local at = surface + Vector3.new(0, offsetY, 0)
	model:PivotTo(CFrame.lookAt(at, at + flat.Unit))
end

local function buildHallPlaque(part: BasePart)
	local gui, root = panel(part, "AT_HallOfFame")
	title(root, "HALL OF FAME", 0.2, GOLD)
	local list: Frame = make("Frame", {
		Position = UDim2.fromScale(0, 0.3),
		Size = UDim2.fromScale(1, 0.7),
		BackgroundTransparency = 1,
	}, root)
	make("UIListLayout", { Padding = UDim.new(0.02, 0), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	local lines = {}
	for i = 1, 3 do
		lines[i] = make("TextLabel", {
			LayoutOrder = i,
			Size = UDim2.fromScale(1, 0.3),
			BackgroundTransparency = 1,
			FontFace = FACE_BODY,
			Text = "",
			TextScaled = true,
			TextColor3 = RANK_COLORS[i],
		}, list)
	end
	gui.Parent = part
	hallUi = { Lines = lines }
end

refreshHall = function()
	local week = Util.IsoWeek(os.time() - 7 * 86400)
	if week == hallWeek or hallBusy then
		return
	end
	local def = boardByKey[BCFG.HallOfFame.Board or "League"]
	if not def then
		return
	end
	hallBusy = true
	local ok, err = pcall(buildHall, def, week)
	hallBusy = false
	if not ok then
		logError("Hall of Fame bauen", err)
	end
end

-- yieldet (Lesen, Namen, Avatar-Modelle); läuft nur im Lese-Thread
buildHall = function(def: BoardDef, week: number)
	local rows = if readDisabled then {} else (readStore(storeName(def, week), BCFG.HallOfFame.Count) or {})
	local complete = true -- fehlt eine Statuen-Fläche (Stadt noch im Aufbau), beim nächsten Lesen erneut versuchen
	local okPlaque, plaque = call("CityService", "BoardPart", "HallOfFame")
	if okPlaque and typeof(plaque) == "Instance" and plaque:IsA("BasePart") and not hallUi then
		buildHallPlaque(plaque)
	end
	local folder = hallFolder
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "AT_HallOfFame"
		folder.Parent = workspace
		hallFolder = folder
	end
	for _, child in ipairs((folder :: Folder):GetChildren()) do
		child:Destroy()
	end
	for i = 1, BCFG.HallOfFame.Count do
		local okTop, top = call("CityService", "BoardPart", "Hall" .. i)
		local row = rows[i]
		local line = hallUi and hallUi.Lines[i]
		if row then
			local name = fetchName(row.UserId)
			if line then
				line.Text = ("%d. %s · %s"):format(i, name, display(def, row.Value, "en"))
			end
			if okTop and typeof(top) == "Instance" and top:IsA("BasePart") then
				local model = statueFor(row.UserId)
				goldify(model)
				model.Name = "Statue" .. i
				pcall(function()
					model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
				end)
				placeOn(model, top)
				model.Parent = folder
			else
				complete = false
			end
		elseif line then
			line.Text = ("%d. —"):format(i)
		end
	end
	if complete and (hallUi ~= nil or #rows == 0) then
		hallWeek = week
	end
end

-- ---------------------------------------------------------------------
-- 8) IPO-WAND + HALL OF IPOs (DataStore Config.Tech.GlobalStore, alle Server)
-- ---------------------------------------------------------------------
local function gStore(): DataStore?
	if globalStore or globalFailed then
		return globalStore
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(TECH.GlobalStore or "AT_Global")
	end)
	if ok then
		globalStore = result
	else
		globalFailed = true
		logError("GetDataStore", result)
	end
	return globalStore
end

local function buildIpoWall(part: BasePart)
	local gui, root = panel(part, "AT_IpoWall")
	root.BackgroundColor3 = C.Bg2
	title(root, "IPO-WAND · IPO WALL", 0.14, C.Cosmic2)
	local fresh: Frame = make("Frame", {
		Name = "Fresh",
		Position = UDim2.fromScale(0, 0.2),
		Size = UDim2.fromScale(0.58, 0.8),
		BackgroundTransparency = 1,
	}, root)
	make("UIGridLayout", {
		CellSize = UDim2.fromScale(0.48, 0.3),
		CellPadding = UDim2.fromScale(0.03, 0.03),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, fresh)
	local tiles = {}
	for i = 1, IPO_WALL_ROWS do
		local tile: Frame = make("Frame", {
			LayoutOrder = i,
			BackgroundColor3 = C.Surface2,
			BackgroundTransparency = 0.1,
			Visible = false,
		}, fresh)
		make("UICorner", { CornerRadius = UDim.new(0, 12) }, tile)
		border(tile, C.Cosmic2, 0.3)
		local ticker: TextLabel = make("TextLabel", {
			Size = UDim2.fromScale(1, 0.62),
			BackgroundTransparency = 1,
			FontFace = FACE_DISPLAY,
			Text = "",
			TextScaled = true,
			TextColor3 = GOLD,
		}, tile)
		local owner: TextLabel = make("TextLabel", {
			Position = UDim2.fromScale(0, 0.62),
			Size = UDim2.fromScale(1, 0.34),
			BackgroundTransparency = 1,
			FontFace = FACE_BODY,
			Text = "",
			TextScaled = true,
			TextColor3 = C.Text2,
		}, tile)
		tiles[i] = { Frame = tile, Ticker = ticker, Owner = owner }
	end
	local hall: Frame = make("Frame", {
		Name = "Hall",
		Position = UDim2.fromScale(0.62, 0.2),
		Size = UDim2.fromScale(0.38, 0.8),
		BackgroundTransparency = 1,
	}, root)
	make("TextLabel", {
		Size = UDim2.fromScale(1, 0.1),
		BackgroundTransparency = 1,
		FontFace = FACE_DISPLAY,
		Text = "HALL OF IPOs",
		TextScaled = true,
		TextColor3 = C.Text,
	}, hall)
	local list: Frame = make("Frame", {
		Position = UDim2.fromScale(0, 0.12),
		Size = UDim2.fromScale(1, 0.88),
		BackgroundTransparency = 1,
	}, hall)
	make("UIListLayout", { Padding = UDim.new(0.005, 0), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	local lines = {}
	for i = 1, IPO_HALL_ROWS do
		lines[i] = make("TextLabel", {
			LayoutOrder = i,
			Size = UDim2.fromScale(1, 1 / IPO_HALL_ROWS - 0.006),
			BackgroundTransparency = 1,
			FontFace = FACE_MONO,
			Text = "",
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = C.Text2,
		}, list)
	end
	gui.Parent = part
	ipoUi = { Tiles = tiles, Lines = lines }
end

local function showIpoHall()
	if not ipoUi then
		return
	end
	local now = os.time()
	local wallSeconds = (PCFG.Prestige.WallHours or 24) * 3600
	local slot = 0
	for _, entry in ipairs(ipoHall) do
		if now - entry.At <= wallSeconds and slot < IPO_WALL_ROWS then
			slot += 1
			local tile = ipoUi.Tiles[slot]
			tile.Ticker.Text = entry.T
			tile.Owner.Text = entry.N
			tile.Frame.Visible = true
		end
	end
	for i = slot + 1, IPO_WALL_ROWS do
		ipoUi.Tiles[i].Frame.Visible = false
	end
	for i, line in ipairs(ipoUi.Lines) do
		local entry = ipoHall[i]
		line.Text = if entry then ("%s  %s"):format(entry.T, entry.N) else ""
	end
end

local function cleanHall(list: any): { { T: string, N: string, U: number, At: number } }
	local out = {}
	if type(list) ~= "table" then
		return out
	end
	for _, entry in ipairs(list) do
		if
			type(entry) == "table"
			and type(entry.T) == "string"
			and string.match(entry.T, "^%u%u%u%u?$")
			and type(entry.N) == "string"
			and finite(entry.At)
			and #out < PCFG.Prestige.HallKeep
		then
			table.insert(
				out,
				{ T = entry.T, N = string.sub(entry.N, 1, 30), U = math.floor(num(entry.U, 0)), At = entry.At }
			)
		end
	end
	return out
end

refreshIpoHall = function()
	local ds = gStore()
	if ds and not readDisabled then
		local ok, result = pcall(function()
			return ds:GetAsync(BCFG.IpoStoreKey)
		end)
		if ok then
			local remote = cleanHall(result)
			-- lokale (noch nicht gelesene) Einträge behalten
			local seen: { [string]: boolean } = {}
			for _, entry in ipairs(remote) do
				seen[entry.T .. ":" .. entry.At] = true
			end
			for _, entry in ipairs(ipoHall) do
				if not seen[entry.T .. ":" .. entry.At] then
					table.insert(remote, entry)
				end
			end
			table.sort(remote, function(a, b)
				return a.At > b.At
			end)
			while #remote > PCFG.Prestige.HallKeep do
				table.remove(remote)
			end
			ipoHall = remote
		elseif noApi(result) then
			readDisabled = true
		else
			logError("GetAsync IpoHall", result)
		end
	end
	showIpoHall()
end

function LeaderboardService.AddIpo(p: Player, ticker: string)
	if typeof(p) ~= "Instance" or not p:IsA("Player") or type(ticker) ~= "string" then
		return
	end
	if not string.match(ticker, "^%u%u%u%u?$") then
		return
	end
	local entry = { T = ticker, N = string.sub(p.DisplayName, 1, 30), U = p.UserId, At = os.time() }
	table.insert(ipoHall, 1, entry)
	while #ipoHall > PCFG.Prestige.HallKeep do
		table.remove(ipoHall)
	end
	showIpoHall()
	if p.UserId <= 0 then
		return -- Studio-Testspieler: nur lokal
	end
	local ds = gStore()
	if not ds then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			ds:UpdateAsync(BCFG.IpoStoreKey, function(old: any)
				local list = cleanHall(old)
				table.insert(list, 1, entry)
				while #list > PCFG.Prestige.HallKeep do
					table.remove(list)
				end
				return list
			end)
		end)
		if not ok then
			logError("UpdateAsync IpoHall", err)
		end
	end)
end

-- Admin-Marken (Wunsch 18): UserIds mit Admin-Geschenken, neueste zuerst, höchstens ADMIN_MARK_MAX
local function cleanMarks(list: any): { number }
	local out: { number } = {}
	if type(list) ~= "table" then
		return out
	end
	for _, id in ipairs(list) do
		if finite(id) and id > 0 and id % 1 == 0 and #out < ADMIN_MARK_MAX then
			table.insert(out, id)
		end
	end
	return out
end

refreshAdminMarks = function()
	local ds = gStore()
	if not ds or readDisabled then
		return
	end
	local ok, result = pcall(function()
		return ds:GetAsync(ADMIN_MARK_KEY)
	end)
	if ok then
		local fresh: { [number]: boolean } = {}
		for _, id in ipairs(cleanMarks(result)) do
			fresh[id] = true
		end
		for id in pairs(adminMarkSent) do
			fresh[id] = true
		end
		adminMarks = fresh
	elseif noApi(result) then
		readDisabled = true
	else
		logError("GetAsync AdminMarks", result)
	end
end

-- einmal je Sitzung melden, sobald das Konto Admin-CR enthält (nur schreibberechtigte Spieler, eigener Thread)
markAdmin = function(p: Player, data: { [string]: any })
	local userId = p.UserId
	local stats = data.Stats
	if userId <= 0 or adminMarkSent[userId] or type(stats) ~= "table" then
		return
	end
	if num(stats.AdminCredits, 0) <= 0 and num(stats.AdminAky, 0) <= 0 then
		return
	end
	adminMarkSent[userId] = true
	adminMarks[userId] = true
	local ds = gStore()
	if not ds then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			ds:UpdateAsync(ADMIN_MARK_KEY, function(old: any)
				local list = cleanMarks(old)
				if table.find(list, userId) then
					return nil -- schon markiert: nichts schreiben
				end
				table.insert(list, 1, userId)
				while #list > ADMIN_MARK_MAX do
					table.remove(list)
				end
				return list
			end)
		end)
		if not ok then
			adminMarkSent[userId] = nil -- beim nächsten Schreib-Takt erneut versuchen
			logError("UpdateAsync AdminMarks", err)
		end
	end)
end

-- ---------------------------------------------------------------------
-- 9) BoardsGet (§C9: aus Cache; "Freunde" = Freunde im Top-100-Cache + Freunde im Server)
-- ---------------------------------------------------------------------
-- yieldet (GetFriendsAsync), 10 min je Spieler gecacht, höchstens 200 Freunde
local function friendIds(p: Player): { [number]: string }
	local cached = friendsOf[p]
	if cached and os.clock() - cached.At < FRIENDS_TTL then
		return cached.Ids
	end
	local ids: { [number]: string } = {}
	if p.UserId > 0 then
		local ok, err = pcall(function()
			local pages = Players:GetFriendsAsync(p.UserId)
			local count = 0
			local guard = 0
			while guard < 8 do
				guard += 1
				for _, friend in ipairs(pages:GetCurrentPage()) do
					if count < FRIENDS_MAX and type(friend.Id) == "number" then
						ids[friend.Id] = friend.DisplayName or friend.Username or ("#" .. friend.Id)
						count += 1
					end
				end
				if pages.IsFinished or count >= FRIENDS_MAX then
					break
				end
				pages:AdvanceToNextPageAsync()
			end
		end)
		if not ok then
			logError("GetFriendsAsync", err)
		end
	end
	if p.Parent == Players then
		friendsOf[p] = { At = os.clock(), Ids = ids }
	end
	return ids
end

local function liveRow(other: Player, def: BoardDef): Row?
	local data = dataOf(other)
	if not data then
		return nil
	end
	local value = valueOf(other, data, def)
	if value <= 0 then
		return nil -- 0 = kein Wert, REMOVE = getaintet
	end
	return { UserId = other.UserId, Value = value }
end

-- Wunsch 18: Admin-Geld zählt im Vermögen mit, wird aber markiert (Spieler hier: Konto; sonst Admin-Marken aller Server)
local function adminGifted(def: BoardDef, userId: number): boolean
	if def.Key ~= "Wealth" then
		return false
	end
	if adminMarks[userId] then
		return true
	end
	local other = Players:GetPlayerByUserId(userId)
	local data = if other then dataOf(other) else nil
	local stats = data and data.Stats
	return type(stats) == "table" and (num(stats.AdminCredits, 0) > 0 or num(stats.AdminAky, 0) > 0)
end

local function handleBoards(p: Player, arg: any): Reply
	if type(arg) ~= "table" or type(arg.Board) ~= "string" or type(arg.Scope) ~= "string" then
		return fail(p, "core.invalid")
	end
	for key in pairs(arg) do
		if key ~= "Board" and key ~= "Scope" then
			return fail(p, "core.invalid")
		end
	end
	local def = boardByKey[arg.Board]
	if not def or (arg.Scope ~= "Global" and arg.Scope ~= "Friends" and arg.Scope ~= "Server") then
		return fail(p, "core.invalid")
	end
	local rows: { Row } = {}
	local names: { [number]: string } = {}
	if arg.Scope == "Global" then
		for _, row in ipairs(mergeLive(def, cache[def.Key], p.UserId)) do
			if #rows >= CACHE_TOP then
				break
			end
			table.insert(rows, row)
		end
	elseif arg.Scope == "Server" then
		for _, other in ipairs(Players:GetPlayers()) do
			local row = liveRow(other, def)
			if row then
				table.insert(rows, row)
			end
		end
	else
		local friends = friendIds(p)
		local seen: { [number]: boolean } = {}
		for _, row in ipairs(cache[def.Key] or {}) do
			if friends[row.UserId] or row.UserId == p.UserId then
				table.insert(rows, row)
				seen[row.UserId] = true
				names[row.UserId] = friends[row.UserId]
			end
		end
		for _, other in ipairs(Players:GetPlayers()) do
			if (friends[other.UserId] or other == p) and not seen[other.UserId] then
				local row = liveRow(other, def)
				if row then
					table.insert(rows, row)
				end
			end
		end
	end
	table.sort(rows, function(a, b)
		return a.Value > b.Value
	end)
	for i = #rows, 1, -1 do
		if hiddenLoss(def, rows[i], p.UserId) then
			table.remove(rows, i)
		end
	end
	local lang = langOf(p)
	local out = {}
	local myRank: number? = nil
	for i, row in ipairs(rows) do
		if row.UserId == p.UserId then
			myRank = i
		end
		if i <= ROWS then
			table.insert(out, {
				Rank = i,
				UserId = row.UserId,
				Name = names[row.UserId] or cachedName(row.UserId) or ("#" .. tostring(row.UserId)),
				Value = row.Value,
				Text = display(def, row.Value, lang),
				AdminGift = adminGifted(def, row.UserId),
			})
		end
	end
	local data = dataOf(p)
	local mine = if data then math.max(0, valueOf(p, data, def)) else 0
	if not myRank and arg.Scope == "Global" then
		local rank = 0
		for _, row in ipairs(cache[def.Key] or {}) do
			if not hiddenLoss(def, row, p.UserId) then
				rank += 1
				if row.UserId == p.UserId then
					myRank = rank
					break
				end
			end
		end
	end
	return {
		Ok = true,
		Board = def.Key,
		Scope = arg.Scope,
		Kind = def.Kind,
		Rows = out,
		Me = { Rank = myRank or false, Value = mine, Text = if mine > 0 then display(def, mine, lang) else "—" },
	}
end

-- ---------------------------------------------------------------------
-- 10) INIT / START
-- ---------------------------------------------------------------------
local function buildWorld(): boolean
	local missing = false
	for _, def in ipairs(BOARDS) do
		if not boardUis[def.Key] then
			local ok, part = call("CityService", "BoardPart", def.Key)
			if ok and typeof(part) == "Instance" and part:IsA("BasePart") then
				local built, err = pcall(buildBoard, def, part)
				if not built then
					logError("Tafel bauen " .. def.Key, err)
				else
					lastRows[def.Key] = nil
					if cache[def.Key] then
						showBoard(def, cache[def.Key])
					end
				end
			else
				missing = true
			end
		end
	end
	if not ipoUi then
		local ok, part = call("CityService", "BoardPart", "IpoWall")
		if ok and typeof(part) == "Instance" and part:IsA("BasePart") then
			local built, err = pcall(buildIpoWall, part)
			if built then
				showIpoHall()
			else
				logError("IPO-Wand bauen", err)
			end
		else
			missing = true
		end
	end
	return not missing
end

local function onPlayerRemoving(p: Player)
	pending[p] = nil
	adminMarkSent[p.UserId] = nil
	lastWriteAt[p] = nil
	friendsOf[p] = nil
	-- lastWritten/lastValues/writing bleiben, bis ein laufender Schreib-Thread fertig ist
	task.delay(30, function()
		if p.Parent ~= Players then
			lastWritten[p] = nil
			lastValues[p] = nil
			writing[p] = nil
		end
	end)
end

function LeaderboardService.Init(services: any)
	Services = services
	local pss = services.PlayerStateService
	if pss then
		pss.Handle("BoardsGet", handleBoards, { Rate = 1, Per = 1 })
	else
		warn("[LeaderboardService] PlayerStateService fehlt – BoardsGet nicht registriert")
	end
end

function LeaderboardService.Start()
	call("DataService", "OnProfileReleasing", onReleasing)
	call("DataService", "OnProfileLoaded", function(p: Player, _data: any)
		lastWritten[p] = lastWritten[p] or {}
		lastWriteAt[p] = os.clock() - WRITE_EVERY + 15 -- erster Abgleich nach ~15 s
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	Scheduler.Every("LeaderboardWrite", 0.2, writeTick)
	Scheduler.Every("LeaderboardRead", 1 / READ_EVERY, readAll)
	-- Welt-Tafeln live: Cache + Werte der Spieler hier (kein DataStore-Aufruf, kein Yield; showBoard zeichnet nur
	-- bei Änderung neu). Damit zeigt der Börsensaal auch in Studio-Solo sofort echte Zeilen.
	Scheduler.Every("LeaderboardLive", 1 / LIVE_EVERY, function()
		for _, def in ipairs(BOARDS) do
			if boardUis[def.Key] then
				local ok, err = pcall(function()
					showBoard(def, mergeLive(def, cache[def.Key], nil))
				end)
				if not ok then
					logError("Live-Tafel " .. def.Key, err)
				end
			end
		end
	end)
	-- Tafeln bauen, sobald die Stadt die Board-Flächen hat (Priority-Teile; begrenzte Wiederholungen über den Scheduler)
	local attempts = 0
	local stopBuild: (() -> ())? = nil
	stopBuild = Scheduler.Every("LeaderboardBuild", 1 / BOARD_RETRY, function()
		attempts += 1
		local ok, done = pcall(buildWorld)
		if not ok then
			logError("Tafeln bauen", done)
		end
		if (ok and done) or attempts >= BOARD_RETRY_MAX then
			local stop = stopBuild
			stopBuild = nil
			if stop then
				stop()
			end
		end
	end)
	task.delay(FIRST_READ_DELAY, readAll)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">LifestyleService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Uhren, Accessoires, Deko-Lager (Server/Services/LifestyleService)
--  Besitzer: WP8 (Turm-Optik, Interiors, Lifestyle). Vertrag: DESIGN.md §C5.7, §C9 (LifeBuy {Key}, LifeEquip
--  {Slot, Key?}, je 2/s), §C10 (State Life, Storage), §B12.2 (Uhren am Handgelenk für alle sichtbar: an LeftLowerArm
--  bzw. R6 "Left Arm" geschweißt, Massless, ohne Kollision/Abfrage/Berührung), §B12.3 (Accessoires, max. 3),
--  §B4.8 (Deko: Kauf ins Lager, Platzieren/Entfernen gratis über TowerService), §B9.6 (Vorstand „Lifestyle“ −5 %/Stufe
--  auf Uhren-/Deko-Preise), §B1 (Willkommen-zurück-Bericht aus OrderService.CatchUpReport).
--
--  Server ist Autorität: CR bucht nur ShopService.Debit (Senken "Watch", "Accessory", "Decor"). Robux-Firewall:
--  dieser Dienst berührt nie AKY, Depot, Lizenz, XP oder Marktinformation.
--
--  Öffentliche API (§C5.7):
--    LifestyleService.Owns(p, key): boolean          Uhr/Accessoire (gekauft, geschenkt oder freigeschaltet über Pass/
--                                                     Lizenz/Vorstand/Gruppe), Deko (Lager oder platziert), Kosmetik
--                                                     (Fassaden/Neon aus Data.Cosmetics bzw. Data.Purchases.Cosmetics)
--    LifestyleService.GrantWatch(p, key) · GrantAccessory(p, key) · GrantDecor(p, key, n): boolean
--    LifestyleService.TakeDecor(p, key): boolean     1 Stück aus dem Lager (für TowerService.SetDecor, kein Yield)
--    LifestyleService.ReturnDecor(p, key)            1 Stück zurück ins Lager (kein Yield)
--    LifestyleService.Comfort(key): number           Komfort-Punkte 1–5 (0 = unbekannt)
--    LifestyleService.CollectionValue(p): number     Sammlungswert (Vermögen, ganzzahlig, ≤ 9e15)
--  Request-Handler: LifeBuy {Key} (2/s), LifeEquip {Slot = "Watch" | "Acc" | "Jetpack", Key?} (2/s)
--    Neon-Jetpack (Pass, §B12.4): LifeEquip {Slot = "Jetpack", Key = "On"} zündet, ohne Key = aus. Server prüft Pass,
--    Treibstoff (8 s, lädt in 12 s), Sitz, fremden Tower; Anti-Cheat-Erlaubnis nur solange aktiv; Abschaltung spätestens
--    bei leerem Tank. Effekt (Neon-Düsen + Spur) hängt am Charakter -> für alle sichtbar.
--  Ergänzung: LifestyleService.StopJetpack(p)   (VehicleService vor dem Einsteigen)
--  State: Life = { Watches, Accessories, Equipped = { Watch, Acc }, Unlocked, Rotation, RotationEnds, Discount,
--                  Welcome? }   ·   Storage = { Decor = { [key] = n }, Placed = { [key] = n } }
--  Ergänzung: LifestyleService.Rotation(): ({ string }, number)   Boutique-Auslage + Ende (Unix)
--             LifestyleService._Test = { Core }  (reine Lager-/Besitz-Logik für VisualTests)
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))
local Lang = require(Shared:WaitForChild("Lang"))
local Format = require(Shared:WaitForChild("Format"))
local LifestyleModels = require(Shared:WaitForChild("LifestyleModels"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local LifestyleService = {}
local Services: any = nil

type Reply = Types.Reply

local PREFIX = "[LifestyleService] "
local MAX_MONEY = 9e15
local MAX_KEY = 40
local WELCOME_TIMEOUT = 180 -- Sekunden: so lange auf OrderService.CatchUpReport warten
local CHAR_WAIT = 8 -- Sekunden auf Arm/Kopf/Torso warten
local ERROR_LOG_EVERY = 10

local LCFG: { [string]: any } = if type(Config.Lifestyle) == "table" then Config.Lifestyle else {}
local DCFG: { [string]: any } = if type(Config.Decor) == "table" then Config.Decor else {}

local function num(v: any, default: number): number
	return if Util.IsFinite(v) then v else default
end

local MAX_ACC = math.clamp(math.floor(num(LCFG.MaxAccessories, 3)), 1, 6)
local STORAGE_MAX = math.clamp(math.floor(num(DCFG.StorageMax, 999)), 1, 100000)
local COMFORT_MAX = math.clamp(math.floor(num(DCFG.ComfortItemMax, 5)), 1, 20)

local function byKey(t: any): { [string]: any }
	return if type(t) == "table" then t else {}
end

local LIFE_BY_KEY = byKey(LCFG.ByKey)
local LIFE_KIND = byKey(LCFG.KindOf)
local DECOR_BY_KEY = byKey(DCFG.ByKey)

-- ---------------------------------------------------------------------
-- 1) ZUSTAND (pro Spieler bei PlayerRemoving geleert)
-- ---------------------------------------------------------------------
local characterConns: { [Player]: RBXScriptConnection } = {}
local welcomePending: { [Player]: number } = {} -- Spieler -> os.clock() des Beitritts
local welcomeReport: { [Player]: { [string]: any } } = {}
local errorLogAt: { [string]: number } = {}
local rotationKeys: { string } = {}
local rotationWindow = -1
local rotationEnds = 0

local function logError(where: string, err: any)
	local t = os.clock()
	if t - (errorLogAt[where] or -math.huge) >= ERROR_LOG_EVERY then
		errorLogAt[where] = t
		warn(PREFIX .. where .. ": " .. tostring(err))
	end
end

local function has(serviceName: string, fnName: string): boolean
	local s = Services and Services[serviceName]
	return type(s) == "table" and type(s[fnName]) == "function"
end

local function call(serviceName: string, fnName: string, ...: any): (boolean, any)
	local s = Services and Services[serviceName]
	local fn = if type(s) == "table" then s[fnName] else nil
	if type(fn) ~= "function" then
		return false, nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		logError(serviceName .. "." .. fnName, result)
		return false, nil
	end
	return true, result
end

local function dataOf(p: Player): { [string]: any }?
	local ok, data = call("DataService", "Get", p)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

local function langOf(p: Player): Types.Lang
	local ok, lang = call("PlayerStateService", "LangOf", p)
	if ok and (lang == "de" or lang == "en") then
		return lang
	end
	return Lang.For(p)
end

local function fail(p: Player, key: string, args: { any }?): Reply
	local lang = langOf(p)
	return { Ok = false, Message = if args then Lang.T(lang, key, table.unpack(args)) else Lang.T(lang, key) }
end

local function markDirty(p: Player, ...: string)
	call("PlayerStateService", "MarkDirty", p, ...)
end

local function validKey(key: any): boolean
	return type(key) == "string" and #key >= 1 and #key <= MAX_KEY and string.match(key, "^[%w_]+$") ~= nil
end

local function exact(arg: any, spec: { [string]: string }, optional: { [string]: boolean }?): boolean
	if type(arg) ~= "table" then
		return false
	end
	local count = 0
	for key, value in pairs(arg) do
		count += 1
		if count > 4 or type(key) ~= "string" or spec[key] == nil or type(value) ~= spec[key] then
			return false
		end
	end
	for key in pairs(spec) do
		if arg[key] == nil and not (optional and optional[key]) then
			return false
		end
	end
	return true
end

-- ---------------------------------------------------------------------
-- 2) KERN (reine Daten-Logik; VisualTests prüft sie mit Attrappen-Daten)
-- ---------------------------------------------------------------------
local Core = {}

-- Liste oder Menge -> Menge { [key] = true }
function Core.Set(t: any): { [string]: boolean }
	local set: { [string]: boolean } = {}
	if type(t) ~= "table" then
		return set
	end
	for k, v in pairs(t) do
		if type(k) == "string" and v == true then
			set[k] = true
		elseif type(k) == "number" and type(v) == "string" then
			set[v] = true
		end
	end
	return set
end

-- Spielstand-Teile reparieren (Typen, Grenzen); unbekannte Schlüssel bleiben erhalten (nie Daten löschen)
function Core.Repair(data: { [string]: any })
	if type(data.Life) ~= "table" then
		data.Life = { Watches = {}, Accessories = {}, Equipped = { Watch = "", Acc = {} } }
	end
	local life = data.Life
	life.Watches = Core.Set(life.Watches)
	life.Accessories = Core.Set(life.Accessories)
	if type(life.Equipped) ~= "table" then
		life.Equipped = { Watch = "", Acc = {} }
	end
	local eq = life.Equipped
	if type(eq.Watch) ~= "string" or (eq.Watch ~= "" and not validKey(eq.Watch)) then
		eq.Watch = ""
	end
	local acc: { string } = {}
	if type(eq.Acc) == "table" then
		for _, key in ipairs(eq.Acc) do
			if validKey(key) and not table.find(acc, key) and #acc < MAX_ACC then
				table.insert(acc, key)
			end
		end
	end
	eq.Acc = acc
	if type(data.Storage) ~= "table" then
		data.Storage = { Decor = {} }
	end
	if type(data.Storage.Decor) ~= "table" then
		data.Storage.Decor = {}
	end
	local decor = data.Storage.Decor
	for key, n in pairs(decor) do
		if type(key) ~= "string" or not Util.IsFinite(n) or n <= 0 then
			decor[key] = nil
		else
			decor[key] = math.clamp(math.floor(n), 0, STORAGE_MAX)
			if decor[key] == 0 then
				decor[key] = nil
			end
		end
	end
end

function Core.Count(data: { [string]: any }, key: string): number
	local storage = data.Storage
	local decor = if type(storage) == "table" and type(storage.Decor) == "table" then storage.Decor else nil
	return if decor then math.floor(num(decor[key], 0)) else 0
end

function Core.Take(data: { [string]: any }, key: string): boolean
	Core.Repair(data)
	local decor = data.Storage.Decor
	local n = math.floor(num(decor[key], 0))
	if n <= 0 then
		return false
	end
	decor[key] = if n - 1 > 0 then n - 1 else nil
	return true
end

function Core.Give(data: { [string]: any }, key: string, n: number): boolean
	if not validKey(key) or not Util.IsFinite(n) or n < 1 or n % 1 ~= 0 then
		return false
	end
	Core.Repair(data)
	local decor = data.Storage.Decor
	decor[key] = math.clamp(math.floor(num(decor[key], 0)) + n, 0, STORAGE_MAX)
	return true
end

-- Wie oft steht ein Deko-Teil gerade im Tower?
function Core.Placed(data: { [string]: any }): { [string]: number }
	local placed: { [string]: number } = {}
	local tower = data.Tower
	local floors = if type(tower) == "table" and type(tower.Floors) == "table" then tower.Floors else {}
	for _, floor in ipairs(floors) do
		if type(floor) == "table" and type(floor.D) == "table" then
			for _, key in ipairs(floor.D) do
				if type(key) == "string" and key ~= "" then
					placed[key] = (placed[key] or 0) + 1
				end
			end
		end
	end
	return placed
end

-- Rabatt aus dem Vorstand-Ast „Lifestyle“ (nur Uhren und Deko, §B9.6)
function Core.Discount(perkLevel: number): number
	local perk = byKey(LCFG.Perk)
	local level = math.clamp(math.floor(num(perkLevel, 0)), 0, math.floor(num(perk.Max, 5)))
	return math.clamp(level * num(perk.Pct, 0.05), 0, 0.9)
end

function Core.Price(base: number, discount: number): number
	if not Util.IsFinite(base) or base <= 0 then
		return 0
	end
	return math.max(1, math.min(MAX_MONEY, math.floor(base * (1 - discount) + 0.5)))
end

LifestyleService._Test = { Core = Core }

-- ---------------------------------------------------------------------
-- 3) BESITZ & FREISCHALTUNGEN
-- ---------------------------------------------------------------------
local function licenceOf(p: Player, data: { [string]: any }): number
	local ok, licence = call("ProgressionService", "Licence", p)
	if ok and Util.IsFinite(licence) then
		return licence
	end
	local prog = data.Prog
	return if type(prog) == "table" then math.floor(num(prog.Licence, 1)) else 1
end

local function perkOf(p: Player, data: { [string]: any }, branch: string): number
	local ok, level = call("ProgressionService", "Perk", p, branch)
	if ok and Util.IsFinite(level) then
		return level
	end
	local prog = data.Prog
	local prestige = if type(prog) == "table" then prog.Prestige else nil
	local perks = if type(prestige) == "table" then prestige.Perks else nil
	return if type(perks) == "table" then math.floor(num(perks[branch], 0)) else 0
end

local function hasPass(p: Player, key: string): boolean
	local ok, result = call("MonetizationService", "HasPass", p, key)
	return ok and result == true
end

-- Uhr/Accessoire ohne Kauf freigeschaltet (Pass, Lizenz, Vorstand, Gruppe)?
local function unlocked(p: Player, data: { [string]: any }, entry: any): boolean
	local source = entry.Source
	if source == "Pass" then
		return type(entry.Pass) == "string" and hasPass(p, entry.Pass)
	elseif source == "Licence" then
		return licenceOf(p, data) >= num(entry.Licence, 99)
	elseif source == "Perk" then
		local perk = entry.Perk
		return type(perk) == "table" and perkOf(p, data, tostring(perk.Branch)) >= num(perk.Level, 99)
	elseif source == "Group" then
		return type(data.Social) == "table" and data.Social.Group == true
	end
	return false
end

local function inCosmetics(data: { [string]: any }, key: string): boolean
	for _, list in ipairs({ data.Cosmetics, if type(data.Purchases) == "table" then data.Purchases.Cosmetics else nil }) do
		if type(list) == "table" then
			if list[key] == true then
				return true
			end
			for _, value in ipairs(list) do
				if value == key then
					return true
				end
			end
		end
	end
	return false
end

local function ownsIn(p: Player, data: { [string]: any }, key: string): boolean
	local kind = LIFE_KIND[key]
	if kind == "Watch" or kind == "Accessory" then
		local life = data.Life
		local list = if type(life) == "table" then (if kind == "Watch" then life.Watches else life.Accessories) else nil
		if Core.Set(list)[key] then
			return true
		end
		return unlocked(p, data, LIFE_BY_KEY[key])
	end
	if DECOR_BY_KEY[key] then
		return Core.Count(data, key) > 0 or (Core.Placed(data)[key] or 0) > 0
	end
	return inCosmetics(data, key)
end

function LifestyleService.Owns(p: Player, key: string): boolean
	if typeof(p) ~= "Instance" or not p:IsA("Player") or not validKey(key) then
		return false
	end
	local data = dataOf(p)
	return data ~= nil and ownsIn(p, data, key)
end

-- ---------------------------------------------------------------------
-- 4) AM KÖRPER: Uhr am linken Handgelenk, Accessoires an Kopf/Brust/Hand/Wurzel (für alle sichtbar)
-- ---------------------------------------------------------------------
local function clearAttachments(character: Model)
	for _, child in ipairs(character:GetChildren()) do
		if
			child:IsA("Model") and (child:GetAttribute("AkyWatch") ~= nil or child:GetAttribute("AkyAccessory") ~= nil)
		then
			child:Destroy()
		end
	end
end

local function weldTo(model: Model, part: BasePart, offset: CFrame, character: Model): boolean
	local primary = model.PrimaryPart
	if not primary then
		model:Destroy()
		return false
	end
	model:PivotTo(part.CFrame * offset)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = part
	weld.Part1 = primary
	weld.Parent = primary
	model.Parent = character
	return true
end

-- Dial zeigt nach außen (−X des Arms), Uhr-+Y zeigt zur Hand (−Y des Arms)
local function wristOffset(arm: BasePart): CFrame
	local s = arm.Size
	return CFrame.fromMatrix(
		Vector3.new(-s.X / 2 - 0.02, -s.Y / 2 + 0.3, 0),
		Vector3.new(0, 0, 1),
		Vector3.new(0, -1, 0),
		Vector3.new(1, 0, 0)
	)
end

local function accessoryMount(character: Model, entry: any): (BasePart?, CFrame)
	local kind = if type(entry.Recipe) == "table" then entry.Recipe.Kind else nil
	local attach = entry.Attach
	if attach == "Head" then
		local head = character:FindFirstChild("Head")
		if not head or not head:IsA("BasePart") then
			return nil, CFrame.identity
		end
		if kind == "Crown" then
			return head, CFrame.new(0, head.Size.Y / 2 + 0.02, 0)
		end
		return head, CFrame.new(0, head.Size.Y * 0.12, -head.Size.Z / 2 - 0.04)
	elseif attach == "Torso" then
		local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
		if not torso or not torso:IsA("BasePart") then
			return nil, CFrame.identity
		end
		local s = torso.Size
		local front = -s.Z / 2 - 0.04
		if kind == "Lapel" then
			return torso, CFrame.new(-s.X * 0.28, s.Y * 0.18, front)
		elseif kind == "Badge" then
			return torso, CFrame.new(s.X * 0.28, s.Y * 0.22, front)
		end
		return torso, CFrame.new(0, s.Y * 0.05, front)
	elseif attach == "RightHand" then
		local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
		if not hand or not hand:IsA("BasePart") then
			return nil, CFrame.identity
		end
		return hand, CFrame.new(0, -hand.Size.Y / 2 - 0.02, 0)
	elseif attach == "Root" then
		local root = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") then
			return nil, CFrame.identity
		end
		local legs = if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then humanoid.HipHeight else 2
		return root, CFrame.new(0, -(root.Size.Y / 2 + legs) + 0.05, 0)
	end
	return nil, CFrame.identity
end

local function applyAttachments(p: Player)
	local character = p.Character
	local data = dataOf(p)
	if not character or not data or character.Parent == nil then
		return
	end
	local ok, err = pcall(function()
		clearAttachments(character)
		local life = data.Life
		local eq = if type(life) == "table" and type(life.Equipped) == "table" then life.Equipped else {}
		local watchKey = eq.Watch
		if
			type(watchKey) == "string"
			and watchKey ~= ""
			and LIFE_KIND[watchKey] == "Watch"
			and ownsIn(p, data, watchKey)
		then
			local arm = character:FindFirstChild("LeftLowerArm") or character:FindFirstChild("Left Arm")
			if arm and arm:IsA("BasePart") then
				weldTo(LifestyleModels.Watch(watchKey), arm, wristOffset(arm), character)
			end
		end
		if type(eq.Acc) == "table" then
			for i, key in ipairs(eq.Acc) do
				if i > MAX_ACC then
					break
				end
				local entry = LIFE_BY_KEY[key]
				if entry and LIFE_KIND[key] == "Accessory" and ownsIn(p, data, key) then
					local part, offset = accessoryMount(character, entry)
					if part then
						weldTo(LifestyleModels.Accessory(key), part, offset, character)
					end
				end
			end
		end
	end)
	if not ok then
		logError("applyAttachments", err)
	end
end

-- ---------------------------------------------------------------------
-- 4b) NEON-JETPACK (Pass „Jetpack“, §B12.4): Treibstoff serverseitig, Erlaubnis nur während des Flugs
-- ---------------------------------------------------------------------
type Jet = { Active: boolean, Fuel: number, At: number, Token: number, Fx: { Instance } }

local JET: { [string]: any } = byKey(LCFG.Jetpack)
local JET_FUEL = math.clamp(num(JET.Fuel, 8), 1, 60)
local JET_RECHARGE = math.clamp(num(JET.Recharge, 12), 1, 120)
local JET_SLACK = 0.75 -- Sekunden Puffer (Ping) über dem Tank hinaus
local jets: { [Player]: Jet } = {}

local function jetAllowance(): (number, number)
	local security = if type(Config.Security) == "table" then Config.Security else {}
	local allow = byKey((security :: any).Allowances)
	local height = math.clamp(num(JET.MaxHeight, 120), 10, 400)
	local vertical = math.max(num(JET.VerticalMult, 3), num(allow.JetpackVerticalMult, 0), (height + 8) / 7.2)
	local speed = math.max(num(JET.SpeedMult, 1.6), num(allow.JetpackSpeedMult, 1))
	return math.clamp(speed, 1, 5), math.clamp(vertical, 1, 20)
end

local function jetOf(p: Player): Jet
	local jet = jets[p]
	if not jet then
		jet = { Active = false, Fuel = JET_FUEL, At = os.clock(), Token = 0, Fx = {} }
		jets[p] = jet
	end
	return jet
end

-- Tank aktualisieren (verbraucht im Flug, lädt am Boden nach)
local function jetRefresh(jet: Jet, now: number)
	local dt = math.max(0, now - jet.At)
	jet.At = now
	if jet.Active then
		jet.Fuel = math.max(0, jet.Fuel - dt)
	else
		jet.Fuel = math.min(JET_FUEL, jet.Fuel + dt * JET_FUEL / JET_RECHARGE)
	end
end

local function jetClearFx(jet: Jet)
	for _, inst in ipairs(jet.Fx) do
		inst:Destroy()
	end
	table.clear(jet.Fx)
end

-- Neon-Rucksack + Düsen-Funken + Spur am Rücken (repliziert, alle sehen den Flug)
local function jetAddFx(jet: Jet, character: Model)
	jetClearFx(jet)
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso or not torso:IsA("BasePart") then
		return
	end
	local back = torso.Size.Z / 2 + 0.35
	local pack = Instance.new("Part")
	pack.Name = "AkyJetpack"
	pack.Size = Vector3.new(1.3, 1.6, 0.6)
	pack.Color = Color3.fromRGB(26, 33, 48)
	pack.Material = Enum.Material.Metal
	pack.Reflectance = 0.2
	pack.Anchored = false
	pack.Massless = true
	pack.CanCollide = false
	pack.CanQuery = false
	pack.CanTouch = false
	pack.CFrame = torso.CFrame * CFrame.new(0, 0, back)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = torso
	weld.Part1 = pack
	weld.Parent = pack
	local nozzle = Instance.new("Attachment")
	nozzle.Name = "Nozzle"
	nozzle.Position = Vector3.new(0, -0.85, 0)
	nozzle.Parent = pack
	local trailTop = Instance.new("Attachment")
	trailTop.Name = "TrailTop"
	trailTop.Position = Vector3.new(0, -0.4, 0.1)
	trailTop.Parent = pack
	local accent = Color3.fromRGB(79, 140, 255)
	local cosmic = Color3.fromRGB(179, 107, 255)
	local flame = Instance.new("ParticleEmitter")
	flame.Name = "Flame"
	flame.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	flame.Color = ColorSequence.new(accent, cosmic)
	flame.LightEmission = 1
	flame.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0.1) })
	flame.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	flame.Lifetime = NumberRange.new(0.2, 0.4)
	flame.Speed = NumberRange.new(12, 18)
	flame.SpreadAngle = Vector2.new(10, 10)
	flame.EmissionDirection = Enum.NormalId.Bottom
	flame.Rate = 45
	flame.Parent = nozzle
	local trail = Instance.new("Trail")
	trail.Name = "NeonTrail"
	trail.Attachment0 = trailTop
	trail.Attachment1 = nozzle
	trail.Lifetime = 0.6
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(accent, cosmic)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	trail.Parent = pack
	local glow = Instance.new("PointLight")
	glow.Name = "JetGlow"
	glow.Color = accent
	glow.Range = 10
	glow.Brightness = 1.6
	glow.Shadows = false
	glow.Parent = nozzle
	pack.Parent = character
	table.insert(jet.Fx, pack)
end

local function jetStop(p: Player, reason: string?)
	local jet = jets[p]
	if not jet or not jet.Active then
		return
	end
	jetRefresh(jet, os.clock())
	jet.Active = false
	jet.Token += 1
	jetClearFx(jet)
	local character = p.Character
	if character then
		character:SetAttribute("AkyJetpack", nil)
	end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	-- im Auto gilt die Auto-Erlaubnis (VehicleService) – nicht überschreiben
	if p.Parent == Players and not (humanoid and humanoid.SeatPart ~= nil) then
		call("AntiCheatService", "SetAllowance", p, nil) -- senkt die Erlaubnis -> Anti-Cheat gibt Ausroll-/Fall-Gnade
	end
	if reason == "Empty" then
		call("PlayerStateService", "Notify", p, "life.jet.empty", nil, "Info")
	end
end

function LifestyleService.StopJetpack(p: Player)
	if typeof(p) == "Instance" and p:IsA("Player") then
		jetStop(p, nil)
	end
end

local function foreignTower(p: Player, position: Vector3): boolean
	local ok, plot = call("PlotService", "TowerAt", position)
	if not ok or not Util.IsFinite(plot) then
		return false
	end
	local okOwner, owner = call("PlotService", "OwnerOf", plot)
	return okOwner and owner ~= nil and owner ~= p
end

local function jetStart(p: Player): Reply
	local key = JET.Pass or "Jetpack"
	if not hasPass(p, key) then
		return fail(p, "life.jet.noPass")
	end
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return fail(p, "core.invalid")
	end
	if humanoid.SeatPart ~= nil then
		return fail(p, "life.jet.seated")
	end
	if foreignTower(p, root.Position) then
		return fail(p, "life.jet.foreign")
	end
	local jet = jetOf(p)
	local now = os.clock()
	jetRefresh(jet, now)
	if jet.Active then
		return { Ok = true, Fuel = jet.Fuel }
	end
	if jet.Fuel < 1 then
		return fail(p, "life.jet.recharge", { math.ceil((1 - jet.Fuel) * JET_RECHARGE / JET_FUEL) })
	end
	jet.Active = true
	jet.Token += 1
	local token = jet.Token
	local speed, vertical = jetAllowance()
	call("AntiCheatService", "SetAllowance", p, { SpeedMult = speed, VerticalMult = vertical })
	character:SetAttribute("AkyJetpack", true)
	local okFx, errFx = pcall(jetAddFx, jet, character)
	if not okFx then
		logError("jetAddFx", errFx)
	end
	-- spätestens mit leerem Tank aus (Client meldet sich normalerweise vorher)
	task.delay(jet.Fuel + JET_SLACK, function()
		local current = jets[p]
		if current and current.Active and current.Token == token then
			jetStop(p, "Empty")
		end
	end)
	return { Ok = true, Fuel = jet.Fuel }
end

local function onCharacterAdded(p: Player, character: Model)
	local jet = jets[p]
	if jet and jet.Active then
		-- Respawn: Flug endet (Effekt-Teile hingen an der alten Figur)
		jetRefresh(jet, os.clock())
		jet.Active = false
		jet.Token += 1
		jetClearFx(jet)
		call("AntiCheatService", "SetAllowance", p, nil)
	end
	task.spawn(function()
		-- Arm/Kopf/Torso müssen da sein (Avatar lädt asynchron)
		local started = os.clock()
		while os.clock() - started < CHAR_WAIT do
			if p.Parent ~= Players or p.Character ~= character then
				return
			end
			if
				character:FindFirstChild("Head")
				and (character:FindFirstChild("LeftLowerArm") or character:FindFirstChild("Left Arm"))
				and character:FindFirstChild("HumanoidRootPart")
			then
				break
			end
			task.wait(0.25)
		end
		if p.Parent == Players and p.Character == character then
			applyAttachments(p)
		end
	end)
end

-- ---------------------------------------------------------------------
-- 5) BOUTIQUE-ROTATION (ShopService.Rotation, sonst deterministischer Ersatz – auf allen Servern gleich)
-- ---------------------------------------------------------------------
local function rotationParams(): (number, number)
	local shop = if type(Config.Shop) == "table" then Config.Shop else {}
	local fallback = byKey(LCFG.Boutique)
	local hours = math.clamp(num(shop.BoutiqueHours, num(fallback.Hours, 4)), 1, 48)
	local slots = math.clamp(math.floor(num(shop.BoutiqueSlots, num(fallback.Slots, 6))), 1, 24)
	return hours, slots
end

local function purchasable(): { string }
	local pool: { string } = {}
	for _, list in ipairs({ LCFG.Watches, LCFG.Accessories, DCFG.Items }) do
		if type(list) == "table" then
			for _, entry in ipairs(list) do
				if type(entry) == "table" and entry.Source == "Shop" and num(entry.Price, 0) > 0 then
					table.insert(pool, entry.Key)
				end
			end
		end
	end
	return pool
end

local function knownKey(key: any): boolean
	return type(key) == "string" and (LIFE_BY_KEY[key] ~= nil or DECOR_BY_KEY[key] ~= nil)
end

local function computeRotation(window: number, slots: number): { string }
	local ok, fromShop = call("ShopService", "Rotation")
	local list: { string } = {}
	if ok and type(fromShop) == "table" then
		for _, key in ipairs(fromShop) do
			if knownKey(key) and not table.find(list, key) and #list < 24 then
				table.insert(list, key)
			end
		end
		if #list > 0 then
			return list
		end
	end
	local pool = purchasable()
	local attempts = 0
	while #list < math.min(slots, #pool) and attempts < slots * 8 do
		attempts += 1
		local index = Util.Hash(("boutique:%d:%d"):format(window, attempts)) % #pool + 1
		local key = pool[index]
		if not table.find(list, key) then
			table.insert(list, key)
		end
	end
	return list
end

local function refreshRotation(): boolean
	local hours, slots = rotationParams()
	local span = math.floor(hours * 3600)
	local window = os.time() // span
	if window == rotationWindow and #rotationKeys > 0 then
		return false
	end
	rotationWindow = window
	rotationEnds = (window + 1) * span
	rotationKeys = computeRotation(window, slots)
	return true
end

function LifestyleService.Rotation(): ({ string }, number)
	refreshRotation()
	return table.clone(rotationKeys), rotationEnds
end

-- ---------------------------------------------------------------------
-- 6) ÖFFENTLICHE API (§C5.7)
-- ---------------------------------------------------------------------
local function grantLife(p: Player, key: string, kind: string): boolean
	if typeof(p) ~= "Instance" or not p:IsA("Player") or not validKey(key) or LIFE_KIND[key] ~= kind then
		return false
	end
	local data = dataOf(p)
	if not data then
		return false
	end
	Core.Repair(data)
	local life = data.Life
	local eq = life.Equipped
	if kind == "Watch" then
		life.Watches[key] = true
		if eq.Watch == "" then
			eq.Watch = key -- sofort sichtbare Wirkung (§0.8 Punkt 3)
		end
	else
		life.Accessories[key] = true
		if #eq.Acc < MAX_ACC and not table.find(eq.Acc, key) then
			table.insert(eq.Acc, key)
		end
	end
	markDirty(p, "Life")
	task.defer(applyAttachments, p)
	return true
end

function LifestyleService.GrantWatch(p: Player, key: string): boolean
	return grantLife(p, key, "Watch")
end

function LifestyleService.GrantAccessory(p: Player, key: string): boolean
	return grantLife(p, key, "Accessory")
end

function LifestyleService.GrantDecor(p: Player, key: string, n: number): boolean
	if typeof(p) ~= "Instance" or not p:IsA("Player") or not DECOR_BY_KEY[key] then
		return false
	end
	local data = dataOf(p)
	if not data or not Core.Give(data, key, n) then
		return false
	end
	markDirty(p, "Storage")
	return true
end

function LifestyleService.TakeDecor(p: Player, key: string): boolean
	if typeof(p) ~= "Instance" or not p:IsA("Player") or not validKey(key) or not DECOR_BY_KEY[key] then
		return false
	end
	local data = dataOf(p)
	if not data or not Core.Take(data, key) then
		return false
	end
	markDirty(p, "Storage")
	return true
end

function LifestyleService.ReturnDecor(p: Player, key: string)
	if typeof(p) ~= "Instance" or not p:IsA("Player") or not validKey(key) then
		return
	end
	local data = dataOf(p)
	if data and Core.Give(data, key, 1) then
		markDirty(p, "Storage")
	end
end

function LifestyleService.Comfort(key: string): number
	local entry = if type(key) == "string" then DECOR_BY_KEY[key] else nil
	if not entry then
		return 0
	end
	return math.clamp(math.floor(num(entry.Comfort, 0)), 0, COMFORT_MAX)
end

function LifestyleService.CollectionValue(p: Player): number
	local data = dataOf(p)
	if not data then
		return 0
	end
	local total = 0
	for key, entry in pairs(LIFE_BY_KEY) do
		if ownsIn(p, data, key) then
			total += math.max(0, num(entry.Value, num(entry.Price, 0)))
		end
	end
	local placed = Core.Placed(data)
	local storage = if type(data.Storage) == "table" and type(data.Storage.Decor) == "table"
		then data.Storage.Decor
		else {}
	for key, entry in pairs(DECOR_BY_KEY) do
		local count = math.floor(num(storage[key], 0)) + (placed[key] or 0)
		if count > 0 then
			local value = num(entry.Price, 0)
			if value <= 0 then
				value = num(entry.Comfort, 1) * 50000 -- Sammlerwert nicht kaufbarer Teile (Pokale, Saison)
			end
			total += value * count
		end
	end
	return math.clamp(math.floor(total), 0, MAX_MONEY)
end

-- ---------------------------------------------------------------------
-- 7) REQUEST-HANDLER (§C9)
-- ---------------------------------------------------------------------
local function credits(p: Player, n: number): string
	return Format.Credits(n, langOf(p))
end

local function nameOf(p: Player, entry: any): string
	return if type(entry) == "table" and type(entry.Name) == "table" then Lang.Pick(langOf(p), entry.Name) else "?"
end

local function handleBuy(p: Player, arg: any): Reply
	if not exact(arg, { Key = "string" }) or not validKey(arg.Key) then
		return fail(p, "core.invalid")
	end
	local key = arg.Key
	local lifeKind = LIFE_KIND[key]
	local entry = LIFE_BY_KEY[key] or DECOR_BY_KEY[key]
	if not entry then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	if entry.Source ~= "Shop" or num(entry.Price, 0) <= 0 then
		return fail(p, "life.notForSale")
	end
	Core.Repair(data)
	if lifeKind and ownsIn(p, data, key) then
		return fail(p, "life.owned")
	end
	if not lifeKind and Core.Count(data, key) >= STORAGE_MAX then
		return fail(p, "life.storageFull", { STORAGE_MAX })
	end
	if not has("ShopService", "Debit") then
		return fail(p, "life.shopMissing")
	end
	-- Vorstand „Lifestyle“: −5 % je Stufe auf Uhren und Deko (nicht auf Accessoires, §B9.6)
	local branch = tostring(byKey(LCFG.Perk).Branch or "Lifestyle")
	local discount = if lifeKind == "Accessory" then 0 else Core.Discount(perkOf(p, data, branch))
	local price = Core.Price(entry.Price, discount)
	local sink = if lifeKind == "Watch" then "Watch" elseif lifeKind == "Accessory" then "Accessory" else "Decor"
	local ok, paid = call("ShopService", "Debit", p, price, sink)
	if not ok or paid ~= true then
		local okBalance, balance = call("ShopService", "Balance", p)
		local missing = if okBalance and Util.IsFinite(balance) then math.max(0, price - balance) else price
		return fail(p, "life.noCredits", { credits(p, missing) })
	end
	local granted = if lifeKind == "Watch"
		then LifestyleService.GrantWatch(p, key)
		elseif lifeKind == "Accessory" then LifestyleService.GrantAccessory(p, key)
		else LifestyleService.GrantDecor(p, key, 1)
	if not granted then
		-- sollte nie passieren (alles oben geprüft) – Betrag zurückbuchen
		call("ShopService", "Credit", p, price, "Refund")
		return fail(p, "core.error")
	end
	call("MetricsService", "Custom", p, "LifeBuy", price, { Key = key, Kind = sink })
	local lang = langOf(p)
	local message = if lifeKind
		then Lang.T(lang, "life.boughtWorn", nameOf(p, entry))
		else Lang.T(lang, "life.boughtDecor", nameOf(p, entry))
	return { Ok = true, Message = message, Key = key, Price = price }
end

local function handleEquip(p: Player, arg: any): Reply
	if not exact(arg, { Slot = "string", Key = "string" }, { Key = true }) then
		return fail(p, "core.invalid")
	end
	local slot = arg.Slot
	local key = arg.Key
	if slot == "Jetpack" then
		if key == "On" then
			return jetStart(p)
		elseif key == nil or key == "" then
			jetStop(p, nil)
			return { Ok = true }
		end
		return fail(p, "core.invalid")
	end
	if slot ~= "Watch" and slot ~= "Acc" then
		return fail(p, "core.invalid")
	end
	if key ~= nil and key ~= "" and not validKey(key) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	Core.Repair(data)
	local eq = data.Life.Equipped
	local lang = langOf(p)
	local message: string
	if slot == "Watch" then
		if key == nil or key == "" then
			eq.Watch = ""
			message = Lang.T(lang, "life.watchOff")
		else
			if LIFE_KIND[key] ~= "Watch" then
				return fail(p, "core.invalid")
			end
			if not ownsIn(p, data, key) then
				return fail(p, "life.notOwned")
			end
			eq.Watch = key
			message = Lang.T(lang, "life.watchOn", nameOf(p, LIFE_BY_KEY[key]))
		end
	else
		if key == nil or key == "" then
			table.clear(eq.Acc)
			message = Lang.T(lang, "life.accCleared")
		else
			if LIFE_KIND[key] ~= "Accessory" then
				return fail(p, "core.invalid")
			end
			if not ownsIn(p, data, key) then
				return fail(p, "life.notOwned")
			end
			local index = table.find(eq.Acc, key)
			if index then
				table.remove(eq.Acc, index)
				message = Lang.T(lang, "life.accOff", nameOf(p, LIFE_BY_KEY[key]))
			elseif #eq.Acc >= MAX_ACC then
				return fail(p, "life.accFull", { MAX_ACC })
			else
				table.insert(eq.Acc, key)
				message = Lang.T(lang, "life.accOn", nameOf(p, LIFE_BY_KEY[key]))
			end
		end
	end
	markDirty(p, "Life")
	task.defer(applyAttachments, p)
	return { Ok = true, Message = message }
end

-- ---------------------------------------------------------------------
-- 8) STATE (§C10)
-- ---------------------------------------------------------------------
local function sortedKeys(set: { [string]: boolean }): { string }
	local list: { string } = {}
	for key in pairs(set) do
		table.insert(list, key)
	end
	table.sort(list)
	return list
end

local function lifeState(p: Player): { [string]: any }
	refreshRotation()
	local data = dataOf(p)
	local base: { [string]: any } = {
		Watches = {},
		Accessories = {},
		Equipped = { Watch = "", Acc = {} },
		Unlocked = {},
		Rotation = table.clone(rotationKeys),
		RotationEnds = rotationEnds,
		Discount = 0,
	}
	if not data then
		return base
	end
	Core.Repair(data)
	local life = data.Life
	base.Watches = sortedKeys(life.Watches)
	base.Accessories = sortedKeys(life.Accessories)
	base.Equipped = { Watch = life.Equipped.Watch, Acc = table.clone(life.Equipped.Acc) }
	local unlockedList: { string } = {}
	for key, entry in pairs(LIFE_BY_KEY) do
		if unlocked(p, data, entry) then
			table.insert(unlockedList, key)
		end
	end
	table.sort(unlockedList)
	base.Unlocked = unlockedList
	base.Discount = Core.Discount(perkOf(p, data, tostring(byKey(LCFG.Perk).Branch or "Lifestyle")))
	local report = welcomeReport[p]
	if report then
		base.Welcome = report
	end
	return base
end

local function storageState(p: Player): { [string]: any }
	local data = dataOf(p)
	if not data then
		return { Decor = {}, Placed = {} }
	end
	Core.Repair(data)
	return { Decor = table.clone(data.Storage.Decor), Placed = Core.Placed(data) }
end

-- ---------------------------------------------------------------------
-- 9) TAKTE & LEBENSZYKLUS
-- ---------------------------------------------------------------------
-- Willkommen-Bericht: OrderService.CatchUpReport, sobald der Offline-Abgleich fertig ist (§B1)
local function sanitizeReport(raw: any): { [string]: any }
	local out: { [string]: any } = {
		Fills = math.clamp(math.floor(num(raw.Fills, 0)), 0, 100000),
		Dividends = math.clamp(math.floor(num(raw.Dividends, 0)), 0, MAX_MONEY),
		Alerts = math.clamp(math.floor(num(raw.Alerts, 0)), 0, 1000),
		Bots = {},
	}
	if type(raw.Bots) == "table" then
		for i, bot in ipairs(raw.Bots) do
			if i > 8 then
				break
			end
			if type(bot) == "table" and type(bot.Preset) == "string" and #bot.Preset <= 24 then
				table.insert(out.Bots, { Preset = bot.Preset, Pct = math.clamp(num(bot.Pct, 0), -10, 10) })
			end
		end
	end
	return out
end

local function welcomeJob(_dt: number)
	local t = os.clock()
	for p, since in pairs(welcomePending) do
		if p.Parent ~= Players or t - since > WELCOME_TIMEOUT then
			welcomePending[p] = nil
			continue
		end
		local ok, report = call("OrderService", "CatchUpReport", p)
		if ok and type(report) == "table" then
			welcomeReport[p] = sanitizeReport(report)
			welcomePending[p] = nil
			markDirty(p, "Life")
		elseif not has("OrderService", "CatchUpReport") then
			welcomePending[p] = nil
		end
	end
end

local function rotationJob(_dt: number)
	if refreshRotation() then
		for _, p in ipairs(Players:GetPlayers()) do
			markDirty(p, "Life")
		end
	end
end

local function onProfileLoaded(p: Player, data: { [string]: any })
	if p.Parent ~= Players or type(data) ~= "table" then
		return
	end
	Core.Repair(data)
	markDirty(p, "Life", "Storage")
	if p.Character then
		task.defer(applyAttachments, p)
	end
end

local function onPlayerAdded(p: Player)
	welcomePending[p] = os.clock()
	if characterConns[p] == nil then
		characterConns[p] = p.CharacterAdded:Connect(function(character: Model)
			onCharacterAdded(p, character)
		end)
	end
	if p.Character then
		onCharacterAdded(p, p.Character)
	end
end

local function onPlayerRemoving(p: Player)
	local conn = characterConns[p]
	if conn then
		conn:Disconnect()
	end
	characterConns[p] = nil
	welcomePending[p] = nil
	welcomeReport[p] = nil
	local jet = jets[p]
	if jet then
		jet.Token += 1
		jetClearFx(jet)
	end
	jets[p] = nil
end

function LifestyleService.Init(services: any)
	Services = services
	refreshRotation()
	local pss = Services.PlayerStateService
	if type(pss) ~= "table" then
		warn(PREFIX .. "PlayerStateService fehlt – keine Anfragen/State")
		return
	end
	pss.Provide("Life", lifeState)
	pss.Provide("Storage", storageState)
	pss.Handle("LifeBuy", handleBuy, { Rate = 2, Per = 1 })
	pss.Handle("LifeEquip", handleEquip, { Rate = 2, Per = 1 })
end

function LifestyleService.Start()
	call("DataService", "OnProfileLoaded", onProfileLoaded)
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end
	Scheduler.Every("LifeWelcome", 1, welcomeJob)
	Scheduler.Every("BoutiqueRotation", 1, rotationJob)
end

return LifestyleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">MarketService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Markt-Service: globaler deterministischer Markt (Server/Services/MarketService)
--  Besitzer: WP3 (Markt-Engine). Vertrag: DESIGN.md §C5.3, §C8 (MarketFrame/Market), §C9 (MktCandles, MktProfile,
--  MktCalendar, MktNews), §C10 (State "Market"), §C11.4 (Firewall), §B6, §B10.4, §B15.3; MARKET.md §3–§10, §17, §18.
--
--  Kurs = f(Wochen-Seed, 1-Hz-Tick, Event-Liste): jeder Server rechnet selbst -> alle Server zeigen dieselben Kurse.
--  Ablauf je Tick (Scheduler "Market", 1 Hz, ≤ 10 Nachhol-Ticks, Sprung bei > 60 s Stillstand):
--    1) News mit t_a == t + Market-Nachrichten (Event/Halt/Ipo) senden   2) PriceEngine.Step(t)
--    3) OnTick-Callbacks (Orders, WP4)   4) Kerzen-Ringe   5) Glocke/Kalender/Tagesschluss bei t % 1200 == 0
--    danach EIN Frame (neuester Tick) per FireAllClients(buffer).
--  Wochen-Kontext = { Seed, EventDirector, PriceEngine }; aktuelle Woche + Vorwoche (Historie/Offline ≤ 26 h).
--  Firewall (§C11.4): kennt keine Turm-/Shop-/Pass-Begriffe; zur Laufzeit nur PlayerStateService, OrderService,
--  ProgressionService (TradingPerks), MetricsService. Besitzer-Prüfung über das serverseitige Player-Attribut
--  "IsAdmin" (setzt AdminService, WP11) – AdminService selbst ist für Markt-Code tabu (nur OwnerTradeBlocked).
--
--  Öffentliche API (§C5.3)
--    Tick() · Quote(i) · Candle1s(i, t) · PriceAt(i, t) · NewCursor(i, t0) · Instrument(i) · ActiveIds() · IsHalted(i, t?)
--    Regime() · DayIndex() · HalfSpread(i) · Dividends(t0, t1) · Calendar(days) · RecentNews(n) · FactNewsFor(i, t, w)
--    AdminWindowActive(t?) · AdminWindowsBetween(t0, t1) · AutoShowCancelled(week) · IsLocalMarket()
--    OnTick(cb) · OnNews(cb) · OnDayClose(cb) · Admin(action, args, by) · Stats()
--    zusätzlich: IsReady(): boolean (Seed geladen, Plan gebaut) · AuditStats() (Admin-Statistik Fill-Audit) ·
--    TestContext(seed, week, bases?, cancelled?) (nur SelfTests: isolierter Wochen-Kontext; cancelled = true | Tick)
--  Hinweise für WP4: vor IsReady() liefern Quote/Candle1s nil und PriceAt den Startkurs – den Offline-Abgleich erst
--  starten, wenn IsReady() true ist. Zeitpunkte > Tick() werden auf Tick() begrenzt (nie Zukunft). Nach einem
--  Server-Stillstand > 60 s springt der Markt auf jetzt (OnTick feuert für die übersprungenen Ticks NICHT, nur die
--  verpassten OnDayClose) – Orders dieser Lücke gleicht WP4 wie offline über PriceAt/NewCursor ab.
--  State "Market" = { Week, Day, Regime, Halts = { ["<Id>"] = Until, ["0"] = ganzer Markt }, AdminWindow,
--  AutoShowCancelled } (String-Schlüssel wegen Remote-Serialisierung; nie der Seed).
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))
local Clock = require(Shared:WaitForChild("Clock"))
local Lang = require(Shared:WaitForChild("Lang"))
local QuoteCodec = require(Shared:WaitForChild("Market"):WaitForChild("QuoteCodec"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local MarketFolder = script.Parent.Parent:WaitForChild("Market")
local MarketClock = require(MarketFolder:WaitForChild("MarketClock"))
local MarketSeed = require(MarketFolder:WaitForChild("MarketSeed"))
local EventDirector = require(MarketFolder:WaitForChild("EventDirector"))
local PriceEngine = require(MarketFolder:WaitForChild("PriceEngine"))
local GlobalBus = require(MarketFolder:WaitForChild("GlobalBus"))
local CandleStore = require(MarketFolder:WaitForChild("CandleStore"))
local QuoteStream = require(MarketFolder:WaitForChild("QuoteStream"))
local MarketAudit = require(MarketFolder:WaitForChild("MarketAudit"))
local MarketAdmin = require(MarketFolder:WaitForChild("MarketAdmin"))

local MarketService = {}
local Services: any = nil

type Plain = { [string]: any }
type Ctx = {
	Week: number,
	Seed: number,
	Director: any,
	Engine: any,
	Bases: { [number]: number },
}

local cfg: any = Config.Market
local companies: any = Config.Companies
local newsCfg: any = Config.News

local DAY = MarketClock.DAY
local MAX_CALLBACKS = 64
local DAYCLOSE_WAIT = 3 -- s: so lange wartet der Tagesschluss auf die Tagesrendite (OrderService.OnDayResult)
local MAX_SKIPPED_DAYS = 72 -- nach einem Stillstand höchstens so viele Tagesschlüsse nachholen
local ERROR_LOG_EVERY = 10

-- Zustand -------------------------------------------------------------
local ready = false
local booting = false
local lastTick = 0
local ctxCur: Ctx? = nil
local ctxPrev: Ctx? = nil
local nextSeed: { Week: number, Seed: number, Tune: number }? = nil
local prefetching = false
local localMarket = false
local listings: { [number]: Plain } = {} -- alle bekannten Erstnotizen (Ipo_S + Plan + Admin)
local store = CandleStore.new(cfg)
local recent: { Types.NewsItem } = {}
local tickCallbacks: { (number) -> () } = {}
local newsCallbacks: { (Types.NewsItem) -> () } = {}
local dayCallbacks: { (number, number) -> () } = {}
local busEvents: { [string]: Plain } = {}
local busOrder: { string } = {}
local windows: { { number } } = {}
local cancelledWeeks: { [number]: number } = {} -- Woche -> Start-Tick des CancelAutoShow (ab dann gilt die Absage)
local adminCooldown: { [number]: number } = {}
local pendingDay: { Day: number, Deadline: number, Sent: { [Player]: boolean } }? = nil
local tickMs = 0
local busPolling = false
local stateSig = ""
local errorAt: { [string]: number } = {}

-- ---------------------------------------------------------------------
-- HILFEN
-- ---------------------------------------------------------------------
local function logError(source: string, err: any)
	local now = os.clock()
	if now - (errorAt[source] or -math.huge) >= ERROR_LOG_EVERY then
		errorAt[source] = now
		warn(("[MarketService] %s: %s"):format(source, tostring(err)))
	end
end

local function service(name: string): any
	return if Services then Services[name] else nil
end

local function call(name: string, fn: string, ...: any): (boolean, any)
	local svc = service(name)
	local f = svc and svc[fn]
	if type(f) ~= "function" then
		return false, nil
	end
	return pcall(f, ...)
end

local function langOf(p: Player?): Types.Lang
	if p then
		local ok, lang = call("PlayerStateService", "LangOf", p)
		if ok and (lang == "de" or lang == "en") then
			return lang
		end
	end
	return "en"
end

local function reply(p: Player?, ok: boolean, key: string?, extra: Plain?, ...: any): Types.Reply
	local result: Types.Reply = { Ok = ok }
	if key then
		result.Message = Lang.T(langOf(p), key, ...)
	end
	if extra then
		for k, v in pairs(extra) do
			result[k] = v
		end
	end
	return result
end

local function fire(list: { any }, ...: any)
	for _, cb in ipairs(list) do
		task.spawn(function(...)
			local ok, err = pcall(cb, ...)
			if not ok then
				logError("Callback", err)
			end
		end, ...)
	end
end

local function register(list: { any }, cb: any)
	if type(cb) ~= "function" then
		return
	end
	if #list >= MAX_CALLBACKS then
		warn("[MarketService] zu viele Callbacks – ignoriert")
		return
	end
	table.insert(list, cb)
end

local function isInt(n: any): boolean
	return Util.IsFinite(n) and n % 1 == 0
end

-- exakte Schlüssel (§C9): nur erlaubte, Pflicht-Schlüssel vorhanden
local function exactKeys(arg: any, required: { string }, optional: { string }?): boolean
	if arg == nil then
		return #required == 0
	end
	if type(arg) ~= "table" then
		return false
	end
	local allowed: { [string]: boolean } = {}
	for _, key in ipairs(required) do
		if arg[key] == nil then
			return false
		end
		allowed[key] = true
	end
	for _, key in ipairs(optional or {}) do
		allowed[key] = true
	end
	local count = 0
	for key in pairs(arg) do
		count += 1
		if type(key) ~= "string" or not allowed[key] or count > 8 then
			return false
		end
	end
	return true
end

local function inst(i: number): Plain?
	return companies.ById and companies.ById[i] or nil
end

local function contextFor(t: number): Ctx?
	local week = MarketClock.WeekIndex(t)
	local cur = ctxCur
	if cur and cur.Week == week then
		return cur
	end
	local prev = ctxPrev
	if prev and prev.Week == week then
		return prev
	end
	return nil
end

local function ensureBuilt(ctx: Ctx, t: number)
	local day = MarketClock.DayIndex(t)
	if ctx.Director:BuiltThrough() < day then
		ctx.Director:EnsureBuilt(day)
	end
end

local function clampTick(t: number): number
	if not Util.IsFinite(t) then
		return lastTick
	end
	return math.min(math.floor(t), lastTick)
end

-- ---------------------------------------------------------------------
-- WOCHEN-KONTEXT
-- ---------------------------------------------------------------------
local function seasonOfWeek(week: number): number
	local pipeline = cfg.IpoPipeline
	return math.max(1, (week - pipeline.FirstWeek) // pipeline.SeasonWeeks + 1)
end

local function scheduledListing(id: number): number?
	local pipeline = cfg.IpoPipeline
	local entry: Plain? = nil
	for _, e in ipairs(cfg.Weekly) do
		if e.Kind == "Ipo" then
			entry = e
		end
	end
	if entry == nil then
		return nil
	end
	for season, ids in pairs(pipeline.Season) do
		for slot, pid in ipairs(ids) do
			if pid == id then
				local week = pipeline.FirstWeek + (season - 1) * pipeline.SeasonWeeks + (slot - 1)
				return MarketClock.WeeklyTick(week, entry.Dow, entry.HH, entry.MM)
			end
		end
	end
	return nil
end

local function inPipeline(id: number, week: number): boolean
	local ids = cfg.IpoPipeline.Season[seasonOfWeek(week)]
	if type(ids) ~= "table" then
		return false
	end
	return table.find(ids, id) ~= nil
end

local function specFor(ctx: Ctx, slot: Plain, base: number, origin: number, wildFrom: number?): Plain
	local cls = cfg.Classes[slot.Class] or cfg.Classes.Normal
	local wild = cfg.Classes[cfg.IpoPipeline.FirstDayClass] or cfg.Classes.Wild
	local spec: Plain = {
		Id = slot.Id,
		Etf = false,
		Base = base,
		Origin = origin,
		Sigma = cls.Sigma,
		Sigma1s = cls.Sigma1s,
		SpreadBps = cls.SpreadBps,
		VolBase = cls.VolBase,
		Drift = 0, -- die Fundament-Drift (mit Bewertungsanker) steckt im EventDirector-Beitrag
		SectorIdx = companies.SectorIndex[slot.Sector] or 1,
	}
	if wildFrom and wildFrom + DAY > MarketClock.WeekStart(ctx.Week) then
		spec.WildUntil = wildFrom + DAY
		spec.WildSigma = wild.Sigma
		spec.WildSigma1s = wild.Sigma1s
		spec.WildSpread = wild.SpreadBps
		spec.Blend = cfg.IpoPipeline.ClassBlend
	end
	return spec
end

local function autoShowCancelled(week: number): boolean
	return cancelledWeeks[week] ~= nil
end

-- Baut einen Wochen-Kontext (Plan noch NICHT gebaut – siehe buildDays)
local function newContext(
	week: number,
	seed: number,
	bases: { [number]: number },
	tune: number,
	isolated: boolean?
): Ctx
	local weekStart = MarketClock.WeekStart(week)
	local season = seasonOfWeek(week)
	local slots: { Plain } = {}
	local weekListings: { [number]: Plain } = {}
	for _, entry in ipairs(companies.Instruments) do
		if entry.Class == "ETF" or entry.Set == "Tutorial" then
			continue
		end
		local base = bases[entry.Id] or entry.Start
		local origin, valOrigin = weekStart, weekStart
		if entry.Ipo then
			if (entry.Season or 1) > season then
				continue -- spätere Saison: noch nicht im Plan
			end
			local rec = listings[entry.Id]
			local sched = scheduledListing(entry.Id)
			if rec and rec.Tick < weekStart then
				base = bases[entry.Id] or rec.Open
			else
				base = entry.Start
				origin = math.huge
				valOrigin = if sched
						and sched >= weekStart
						and sched <= MarketClock.WeekEnd(week)
					then sched
					else math.huge
				if rec and rec.Tick >= weekStart and rec.Tick <= MarketClock.WeekEnd(week) then
					weekListings[entry.Id] = {
						T0 = rec.Tick,
						Issue = rec.Issue,
						Open = rec.Open,
						Pop = rec.Open / math.max(1, rec.Issue) - 1,
						Q = 0,
						By = rec.By or 0,
					}
				end
			end
		end
		table.insert(slots, {
			Id = entry.Id,
			Name = entry.Name,
			Class = entry.Class,
			Sector = entry.Sector,
			SectorIdx = companies.SectorIndex[entry.Sector] or 1,
			Start = entry.Start,
			DivBps = entry.DivBps,
			Base = base,
			ValBase = base,
			Ipo = entry.Ipo == true,
			Origin = origin,
			ValOrigin = valOrigin,
		})
	end
	local director = EventDirector.new({
		Seed = seed,
		Week = week,
		Config = cfg,
		Companies = companies,
		News = newsCfg,
		Slots = slots,
		NewsMeanGap = tune,
		Listings = {},
		IsCancelled = autoShowCancelled,
		CancelAt = function(w: number): number?
			return cancelledWeeks[w]
		end,
	})
	local ctx: Ctx = { Week = week, Seed = seed, Director = director, Engine = nil :: any, Bases = bases }
	local specs: { Plain } = {}
	for _, slot in ipairs(slots) do
		if slot.Origin ~= math.huge then
			local rec = listings[slot.Id]
			table.insert(specs, specFor(ctx, slot, slot.Base, slot.Origin, if rec then rec.Tick else nil))
		end
	end
	for _, entry in ipairs(companies.Instruments) do
		if entry.Class == "ETF" then
			local etfCls = cfg.Classes.ETF
			table.insert(specs, {
				Id = entry.Id,
				Etf = true,
				Base = bases[entry.Id] or entry.Start,
				Origin = weekStart,
				Sigma = 0,
				Sigma1s = etfCls.Sigma1s,
				SpreadBps = etfCls.SpreadBps,
				VolBase = etfCls.VolBase,
				Drift = 0,
				SectorIdx = 1,
				Members = entry.Members,
			})
		end
	end
	local engine = PriceEngine.new({
		Seed = seed,
		Week = week,
		Config = cfg,
		Specs = specs,
		Env = {
			Offset = function(i: number, t: number, divFrom: number?)
				return director:Offset(i, t, divFrom)
			end,
			VolMul = function(t: number)
				return director:VolMul(t)
			end,
		},
	})
	ctx.Engine = engine
	director:SetPriceHook(function(i: number, t: number, divFrom: number)
		return engine:MidAt(i, t, divFrom)
	end)
	director:SetListingHook(function(i: number, rec: Plain)
		local slot: Plain? = nil
		for _, s in ipairs(director:Slots()) do
			if s.Id == i then
				slot = s
			end
		end
		if slot then
			engine:AddInstrument(specFor(ctx, slot, rec.Open, rec.T0, rec.T0))
			if not isolated then
				store:Ensure(i)
			end
		end
		if not isolated and listings[i] == nil then
			listings[i] = { Tick = rec.T0, Issue = rec.Issue, Open = rec.Open, By = rec.By or 0 }
			local s = seasonOfWeek(MarketClock.WeekIndex(rec.T0))
			task.spawn(
				MarketSeed.SaveIpo,
				s,
				i,
				{ Tick = rec.T0, Issue = rec.Issue, Open = rec.Open, By = rec.By or 0 }
			)
		end
	end)
	for id, rec in pairs(weekListings) do
		director:AddListing(id, rec)
	end
	return ctx
end

-- Plan sequentiell bauen (Thread darf yielden): bis zum Börsentag `day`, je Häppchen ein task.wait()
local function buildDays(ctx: Ctx, day: number, yielding: boolean)
	local guard = 0
	while ctx.Director:BuiltThrough() < math.min(day, MarketClock.DayIndex(MarketClock.WeekEnd(ctx.Week))) do
		ctx.Director:EnsureBuilt(day, 8)
		guard += 1
		if yielding and guard % 2 == 0 then
			task.wait()
		end
		if guard > 200 then
			break
		end
	end
end

-- externe Events (Bus/Log) in einen Kontext übernehmen; carry = Event der Vorwoche, das hineinreicht
local function applyToContext(ctx: Ctx, ev: Plain): { number }
	local weekStart = MarketClock.WeekStart(ctx.Week)
	if ev.StartTick >= weekStart and ev.StartTick <= MarketClock.WeekEnd(ctx.Week) then
		return ctx.Director:AddExternal(ev, false)
	elseif ev.StartTick < weekStart and ev.Until >= weekStart then
		return ctx.Director:AddExternal(ev, true)
	end
	return {}
end

-- Wochenschluss einer Woche aus ihrem Kontext (alle Instrumente, Cent)
local function closesOf(ctx: Ctx): { [number]: number }
	local endTick = MarketClock.WeekEnd(ctx.Week)
	ensureBuilt(ctx, endTick)
	local closes: { [number]: number } = {}
	for _, i in ipairs(ctx.Engine:Ids()) do
		if ctx.Engine:IsActive(i, endTick) then
			closes[i] = ctx.Engine:MidAt(i, endTick)
		end
	end
	return closes
end

-- ---------------------------------------------------------------------
-- ADMIN-FENSTER, BUS-EVENTS
-- ---------------------------------------------------------------------
local function windowOf(ev: Plain): { number }?
	local kind = ev.Kind
	if kind == "CancelAutoShow" or kind == "Resume" then
		return nil
	end
	local admin = cfg.Admin
	local finish = ev.Until
	if kind == "Ipo" then
		finish = ev.Until + cfg.Halts.IpoSeconds
	end
	return { ev.StartTick - admin.Lead, finish + admin.WindowAfter }
end

local function addWindow(ev: Plain)
	local w = windowOf(ev)
	if w == nil then
		return
	end
	for _, existing in ipairs(windows) do
		if existing[1] == w[1] and existing[2] == w[2] then
			return
		end
	end
	table.insert(windows, w)
	table.sort(windows, function(a, b)
		return a[1] < b[1]
	end)
	while #windows > 400 do
		table.remove(windows, 1)
	end
end

local function autoShowTick(week: number): number?
	for _, entry in ipairs(cfg.Weekly) do
		if entry.Key == "AutoShow" then
			return MarketClock.WeeklyTick(week, entry.Dow, entry.HH, entry.MM)
		end
	end
	return nil
end

local function autoShowIndex(): number
	for index, entry in ipairs(cfg.Weekly) do
		if entry.Key == "AutoShow" then
			return index
		end
	end
	return 1
end

local function cancelLead(): number
	for _, entry in ipairs(cfg.Weekly) do
		if entry.Key == "AutoShow" then
			return entry.CancelLead or 10
		end
	end
	return 10
end

local function markAllDirty()
	for _, p in ipairs(Players:GetPlayers()) do
		call("PlayerStateService", "MarkDirty", p, "Market")
	end
end

local function allIds(): { number }
	local cur = ctxCur
	return if cur then cur.Engine:Ids() else {}
end

-- laufende 5s-/1m-Buckets ab liveStart exakt neu vorbelegen (nach verspätetem Event oder Stillstand-Sprung)
local function seedLive(ids: { number }, liveStart: number)
	local candleAt = function(id: number, t: number)
		local c = contextFor(t)
		if c then
			ensureBuilt(c, t)
			local o, h, l, cl, v = c.Engine:CandleAt(id, t)
			return o, h, l, cl, v
		end
		return 0, 0, 0, 0, 0
	end
	for _, i in ipairs(ids) do
		store:SeedPartial(i, liveStart, candleAt)
	end
end

local function onBusEvent(ev: Plain, late: boolean)
	if busEvents[ev.Id] then
		return
	end
	busEvents[ev.Id] = ev
	table.insert(busOrder, ev.Id)
	while #busOrder > (cfg.Bus.MaxEvents or 200) do
		local old = table.remove(busOrder, 1)
		if old then
			busEvents[old] = nil
		end
	end
	addWindow(ev)
	if ev.Kind == "CancelAutoShow" then
		local week = tonumber(ev.Target) or MarketClock.WeekIndex(ev.StartTick)
		local show = autoShowTick(week)
		local existing = cancelledWeeks[week]
		if show and ev.StartTick <= show - cancelLead() and (existing == nil or ev.StartTick < existing) then
			-- gilt ab dem Start-Tick (alle Server gleich); die Warn-Volatilität blendet der EventDirector aus
			cancelledWeeks[week] = ev.StartTick
			markAllDirty()
			local now = lastTick
			local warnAt = show + (cfg.Weekly[autoShowIndex()].Offset or 0) - cfg.CrashRally.WarnSeconds
			if ready and now >= warnAt then
				-- die Show-Warnung lief schon: Clients beenden Rallye-Wetter/Banner
				local sectors = companies.Sectors
				Remotes.Market:FireAllClients("Event", {
					Kind = "Rally",
					Phase = "End",
					StartTick = warnAt,
					Until = ev.StartTick,
					Scope = "Sector",
					Target = sectors[(week % #sectors) + 1].Key,
					Cancelled = true,
				})
			end
			if ready and late and ev.StartTick <= now then
				-- verspätet angekommen: Kerzen ab der Absage neu rechnen (Kurse folgen ab jetzt der Absage)
				local ids = allIds()
				store:Rebuild(ids, ev.StartTick, now, now + 1)
				seedLive(ids, now + 1)
			end
		end
		return
	end
	local affected: { number } = {}
	local prev, cur = ctxPrev, ctxCur
	if prev then
		for _, i in ipairs(applyToContext(prev, ev)) do
			table.insert(affected, i)
		end
	end
	if cur then
		for _, i in ipairs(applyToContext(cur, ev)) do
			if not table.find(affected, i) then
				table.insert(affected, i)
			end
		end
	end
	if not ready then
		return
	end
	local now = lastTick
	if late and ev.StartTick <= now then
		-- verspätet: mit dem Original-Tick anwenden, betroffene Werte 10 s pausieren, Kerzen-Fenster neu rechnen (§8.4)
		local ids = table.clone(affected)
		if #ids > 0 then
			for _, entry in ipairs(companies.Instruments) do
				if entry.Class == "ETF" then
					table.insert(ids, entry.Id)
				end
			end
		end
		local ctx = contextFor(ev.StartTick)
		if ctx then
			ctx.Director:InvalidateDividends(affected, ev.StartTick)
		end
		if cur and #affected > 0 then
			local untilTick = now + 1 + cfg.Halts.LateSeconds
			cur.Director:AddLocalHalt(affected, now + 1, untilTick)
			if #affected >= #cur.Director:Slots() then
				Remotes.Market:FireAllClients("Halt", { Until = untilTick })
			else
				for _, i in ipairs(affected) do
					Remotes.Market:FireAllClients("Halt", { I = i, Until = untilTick })
				end
			end
		end
		if #ids > 0 then
			store:Rebuild(ids, ev.StartTick, now, now + 1)
			seedLive(ids, now + 1)
		end
	elseif ev.Kind ~= "Halt" and ev.Kind ~= "Resume" then
		-- Ankündigung (10 s Vorlauf): Countdown für alle
		Remotes.Market:FireAllClients("Event", {
			Kind = ev.Kind,
			Phase = "Warn",
			StartTick = ev.StartTick,
			Until = ev.Until,
			Scope = ev.Scope,
			Target = ev.Target,
			Admin = true,
		})
	end
	markAllDirty()
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API (§C5.3)
-- ---------------------------------------------------------------------
function MarketService.IsReady(): boolean
	return ready
end

function MarketService.Tick(): number
	return lastTick
end

function MarketService.Quote(i: number): (number?, number?, number?)
	local cur = ctxCur
	if not ready or cur == nil then
		return nil, nil, nil
	end
	return cur.Engine:Quote(i)
end

function MarketService.Candle1s(i: number, t: number): (number?, number?, number?, number?, number?)
	if not ready or not isInt(i) then
		return nil, nil, nil, nil, nil
	end
	local tick = clampTick(t)
	local ctx = contextFor(tick)
	if ctx == nil or not ctx.Engine:IsActive(i, tick) then
		return nil, nil, nil, nil, nil
	end
	ensureBuilt(ctx, tick)
	local o, h, l, c, v = ctx.Engine:CandleAt(i, tick)
	return o, h, l, c, v
end

function MarketService.PriceAt(i: number, t: number): number
	local entry = inst(i)
	local fallback = if entry then entry.Start else 0
	if not ready or not isInt(i) then
		return fallback
	end
	local tick = clampTick(t)
	local ctx = contextFor(tick)
	if ctx == nil then
		-- älter als die Vorwoche: Wochenbasis der ältesten bekannten Woche
		local oldest = ctxPrev or ctxCur
		if oldest then
			return oldest.Bases[i] or fallback
		end
		return fallback
	end
	ensureBuilt(ctx, tick)
	return ctx.Engine:MidAt(i, tick)
end

-- Wochenübergreifender Cursor (Offline-Abgleich WP4, Kerzen-Backfill/Rebuild). Gleiche Form wie der Engine-Cursor:
-- Seek(t) · Candle(t) -> (O, H, L, C) · Full(t) -> (O, H, L, C, V, hiOff, loOff) · LastMid (Schluss vor dem nächsten Tick).
-- Innerhalb einer Woche bleibt der Engine-Cursor (eigene Felder) erhalten – Seek setzt ihn nur neu auf.
function MarketService.NewCursor(i: number, t0: number)
	local cursor = { Week = -1, Inner = nil :: any, LastMid = 0 }
	function cursor.Seek(self: any, t: number)
		local tick = clampTick(t)
		local ctx = contextFor(tick)
		if ctx == nil then
			ctx = ctxCur
		end
		if ctx then
			ensureBuilt(ctx, tick)
			if self.Inner ~= nil and self.Week == ctx.Week then
				self.Inner:Seek(tick)
			else
				self.Inner = ctx.Engine:NewCursor(i, tick)
				self.Week = ctx.Week
			end
			self.LastMid = self.Inner.LastMid
		end
	end
	local function prepare(self: any, t: number): (number, any)
		local tick = clampTick(t)
		if self.Inner == nil or MarketClock.WeekIndex(tick) ~= self.Week then
			self:Seek(tick)
		end
		local ctx = contextFor(tick)
		if ctx then
			ensureBuilt(ctx, tick)
		end
		return tick, self.Inner
	end
	function cursor.Full(self: any, t: number): (number, number, number, number, number, number, number)
		local tick, inner = prepare(self, t)
		if inner == nil then
			local p = MarketService.PriceAt(i, tick)
			self.LastMid = p
			return p, p, p, p, 0, 0, 0
		end
		local o, h, l, c, v, hiOff, loOff = inner:Full(tick)
		self.LastMid = inner.LastMid
		return o, h, l, c, v, hiOff, loOff
	end
	function cursor.Candle(self: any, t: number): (number, number, number, number)
		local o, h, l, c = self:Full(t)
		return o, h, l, c
	end
	cursor:Seek(t0)
	return cursor
end

function MarketService.Instrument(i: number): Types.Instrument?
	local entry = inst(i)
	return entry :: any
end

function MarketService.ActiveIds(): { number }
	local out: { number } = {}
	local cur = ctxCur
	if cur == nil then
		return out
	end
	for _, i in ipairs(cur.Engine:Ids()) do
		if cur.Engine:IsActive(i, lastTick) then
			table.insert(out, i)
		end
	end
	table.sort(out)
	return out
end

-- t (optional): Pause zu genau diesem Tick (Offline-Abgleich WP4); ohne t = jetzt
function MarketService.IsHalted(i: number, t: number?): boolean
	local cur = ctxCur
	if cur == nil then
		return true
	end
	if t ~= nil and Util.IsFinite(t) then
		local tick = clampTick(t)
		local ctx = contextFor(tick)
		if ctx == nil then
			return false -- älter als die Vorwoche: keine Pausen bekannt
		end
		local haltedAt = ctx.Director:Halted(i, tick)
		return haltedAt
	end
	local halted = cur.Director:Halted(i, lastTick)
	return halted
end

function MarketService.Regime(): number
	local cur = ctxCur
	return if cur and ready then cur.Engine:Regime() else 1
end

function MarketService.DayIndex(): number
	return MarketClock.DayIndex(lastTick)
end

function MarketService.HalfSpread(i: number): number
	local cur = ctxCur
	return if cur and ready then cur.Engine:HalfSpread(i) else 0
end

function MarketService.Dividends(t0: number, t1: number): { { I: number, Tick: number, Cents: number } }
	local out: { { I: number, Tick: number, Cents: number } } = {}
	if not ready or not Util.IsFinite(t0) or not Util.IsFinite(t1) then
		return out
	end
	local a, b = math.floor(t0), clampTick(t1)
	for _, ctx in ipairs({ ctxPrev, ctxCur } :: { Ctx? }) do
		if ctx then
			local ws, we = MarketClock.WeekStart(ctx.Week), MarketClock.WeekEnd(ctx.Week)
			local lo, hi = math.max(a, ws), math.min(b, we)
			if lo <= hi then
				ensureBuilt(ctx, hi)
				for _, d in ipairs(ctx.Director:Dividends(lo, hi)) do
					table.insert(out, { I = d.I, Tick = d.Tick, Cents = d.Cents })
				end
			end
		end
	end
	return out
end

local function weeklyItems(fromTick: number, toTick: number): { Types.CalendarItem }
	local out: { Types.CalendarItem } = {}
	local firstWeek = MarketClock.WeekIndex(fromTick)
	for week = firstWeek, firstWeek + 1 do
		for _, entry in ipairs(cfg.Weekly) do
			local t = MarketClock.WeeklyTick(week, entry.Dow, entry.HH, entry.MM)
			if t and t >= fromTick and t <= toTick then
				if entry.Kind == "Ipo" then
					local pipeline = cfg.IpoPipeline
					local offset = week - pipeline.FirstWeek
					if offset >= 0 then
						local ids = pipeline.Season[offset // pipeline.SeasonWeeks + 1]
						local id = if type(ids) == "table" then ids[offset % pipeline.SeasonWeeks + 1] else nil
						local rec = if id then listings[id] else nil
						-- geplant (oder schon vorausgebaut, aber noch nicht notiert): im Kalender zeigen
						if id and (rec == nil or rec.Tick > lastTick) then
							table.insert(
								out,
								{ T = if rec then rec.Tick else t, Kind = "Ipo", I = id, Key = "mkt.cal.Ipo" }
							)
						end
					end
				elseif entry.Key == "AutoShow" then
					if not autoShowCancelled(week) then
						table.insert(out, { T = t + (entry.Offset or 0), Kind = "Rally", Key = "mkt.cal.AutoShow" })
					end
				elseif entry.Key == "CrashFriday" then
					table.insert(out, { T = t, Kind = "Crash", Key = "mkt.cal.CrashFriday" })
				elseif entry.Key == "RallyWednesday" then
					table.insert(out, { T = t, Kind = "Rally", Key = "mkt.cal.RallyWednesday" })
				end
			end
		end
	end
	return out
end

function MarketService.Calendar(days: number): { Types.CalendarItem }
	local out: { Types.CalendarItem } = {}
	local cur = ctxCur
	if not ready or cur == nil then
		return out
	end
	local n = math.clamp(math.floor(tonumber(days) or 1), 1, 3)
	local fromTick = lastTick
	local toTick = (MarketClock.DayIndex(lastTick) + n) * DAY - 1
	for _, item in ipairs(cur.Director:Calendar(fromTick, toTick)) do
		table.insert(out, item)
	end
	for _, item in ipairs(weeklyItems(fromTick, fromTick + cfg.CalendarWeeklyDays * 86400)) do
		table.insert(out, item)
	end
	table.sort(out, function(a, b)
		if a.T ~= b.T then
			return a.T < b.T
		end
		return (a.I or 0) < (b.I or 0)
	end)
	return out
end

function MarketService.RecentNews(n: number): { Types.NewsItem }
	local count = math.clamp(math.floor(tonumber(n) or cfg.NewsKeep), 0, cfg.NewsKeep)
	local out: { Types.NewsItem } = {}
	for index = #recent, math.max(1, #recent - count + 1), -1 do
		table.insert(out, recent[index])
	end
	return out
end

function MarketService.FactNewsFor(i: number, t: number, window: number): Types.NewsItem?
	if not ready or not isInt(i) or not Util.IsFinite(window) then
		return nil
	end
	local tick = clampTick(t)
	local ctx = contextFor(tick)
	if ctx == nil then
		return nil
	end
	return ctx.Director:FactNewsFor(i, tick, math.clamp(window, 0, 3600))
end

function MarketService.AdminWindowActive(t: number?): boolean
	local tick = if t ~= nil and Util.IsFinite(t) then t else lastTick
	for _, w in ipairs(windows) do
		if tick >= w[1] and tick <= w[2] then
			return true
		elseif w[1] > tick then
			break
		end
	end
	return false
end

function MarketService.AdminWindowsBetween(t0: number, t1: number): { { number } }
	local out: { { number } } = {}
	if not Util.IsFinite(t0) or not Util.IsFinite(t1) then
		return out
	end
	for _, w in ipairs(windows) do
		if w[2] >= t0 and w[1] <= t1 then
			table.insert(out, { w[1], w[2] })
		end
	end
	return out
end

function MarketService.AutoShowCancelled(week: number): boolean
	return autoShowCancelled(week)
end

function MarketService.IsLocalMarket(): boolean
	return localMarket
end

function MarketService.OnTick(cb: (t: number) -> ())
	register(tickCallbacks, cb)
end

function MarketService.OnNews(cb: (n: Types.NewsItem) -> ())
	register(newsCallbacks, cb)
end

function MarketService.OnDayClose(cb: (day: number, t: number) -> ())
	register(dayCallbacks, cb)
end

function MarketService.AuditStats(): Plain
	return MarketAudit.Stats()
end

-- nur SelfTests/Debug: eigener, isolierter Wochen-Kontext (eigener Seed, keine globalen Nebenwirkungen)
-- cancelled: true = Samstags-Show immer abgesagt, Zahl = abgesagt ab diesem Tick, false/nil = findet statt
function MarketService.TestContext(
	seed: number,
	week: number,
	bases: { [number]: number }?,
	cancelled: (boolean | number)?
): Plain
	local ctx = newContext(week, seed, bases or {}, cfg.NewsMeanGap, true)
	if cancelled ~= nil then
		ctx.Director.CancelAt = function(_week: number): number?
			if type(cancelled) == "number" then
				return cancelled
			end
			return if cancelled == true then -math.huge else nil
		end
	end
	return ctx :: any
end

function MarketService.Stats(): {
	TickMs: number,
	BusOk: boolean,
	Events: number,
	Instruments: number,
	Ready: boolean,
	Local: boolean,
	Week: number,
	Day: number,
	Regime: number,
	BackfillPending: number,
	FrameBytes: number,
	AuditChecked: number,
	AuditFailed: number,
}
	local audit = MarketAudit.Stats()
	return {
		TickMs = math.round(tickMs * 1000) / 1000,
		BusOk = GlobalBus.Ok() and MarketSeed.Ok(),
		Events = #busOrder,
		Instruments = #MarketService.ActiveIds(),
		Ready = ready,
		Local = localMarket,
		Week = MarketClock.WeekIndex(lastTick),
		Day = MarketClock.DayIndex(lastTick),
		Regime = MarketService.Regime(),
		BackfillPending = store:Pending(),
		FrameBytes = QuoteStream.LastSize(),
		AuditChecked = audit.Checked,
		AuditFailed = audit.Failed,
	}
end

-- ---------------------------------------------------------------------
-- ADMIN (nur AdminService/EventService; Besitzer-Prüfung über Attribut IsAdmin)
-- ---------------------------------------------------------------------
local function filterText(text: string, userId: number): string?
	local okFilter, result = pcall(function()
		return TextService:FilterStringAsync(text, userId, Enum.TextFilterContext.PublicChat)
	end)
	if not okFilter or result == nil then
		return nil
	end
	local okText, clean = pcall(function()
		return (result :: TextFilterResult):GetNonChatStringForBroadcastAsync()
	end)
	if okText and type(clean) == "string" then
		return clean
	end
	return nil
end

local function inShowWindow(now: number): boolean
	local week = MarketClock.WeekIndex(now)
	local window = cfg.ShowWindow
	local from = MarketClock.WeeklyTick(week, window.Dow, window.HH, window.MM)
	local show = autoShowTick(week)
	return from ~= nil and show ~= nil and now >= from and now < show - cancelLead()
end

function MarketService.Admin(action: string, args: { [string]: any }, by: Player): (boolean, string)
	local lang = langOf(by)
	if typeof(by) ~= "Instance" or not by:IsA("Player") or by.Parent ~= Players then
		return false, Lang.T(lang, "mkt.admin.denied")
	end
	if by:GetAttribute("IsAdmin") ~= true then
		return false, Lang.T(lang, "mkt.admin.denied")
	end
	if not ready then
		return false, Lang.T(lang, "mkt.admin.notReady")
	end
	if type(action) ~= "string" then
		return false, Lang.T(lang, "mkt.admin.unknown")
	end
	local nowClock = os.clock()
	if nowClock - (adminCooldown[by.UserId] or -math.huge) < cfg.Admin.Cooldown then
		return false, Lang.T(lang, "mkt.admin.cooldown")
	end
	local week = MarketClock.WeekIndex(lastTick)
	local ev, errKey = MarketAdmin.Build(action, args, {
		Now = lastTick,
		ById = companies.ById,
		Listed = function(id: number)
			local rec = listings[id]
			if rec then
				return rec.Tick <= lastTick
			end
			local cur = ctxCur
			return cur ~= nil and inst(id) ~= nil and cur.Director:IsListed(id, lastTick)
		end,
		Taken = function(id: number)
			-- IPO schon gelistet ODER Erstnotiz bereits angesetzt (geplant/vorausgebaut)
			local cur = ctxCur
			return listings[id] ~= nil or (cur ~= nil and cur.Director:Listing(id) ~= nil)
		end,
		InPipeline = function(id: number)
			return inPipeline(id, week)
		end,
		Week = week,
		By = by.UserId,
		NewId = GlobalBus.NewId,
	})
	if ev == nil then
		return false, Lang.T(lang, errKey or "mkt.admin.badArgs")
	end
	adminCooldown[by.UserId] = nowClock
	if ev.Kind == "News" and ev.Text then
		local de = filterText(ev.Text.de, by.UserId)
		local en = filterText(ev.Text.en, by.UserId)
		if de == nil or en == nil then
			return false, Lang.T(lang, "mkt.admin.notFiltered")
		end
		ev.Text = { de = de, en = en }
	end
	-- Admin-Abuse vor 18:14:50 am Samstag sagt die automatische Samstags-Show ab (GlobalBus, §B10.4)
	if MarketAdmin.PRICE_KINDS[ev.Kind] and inShowWindow(lastTick) and not autoShowCancelled(week) then
		local cancel = MarketAdmin.Build("CancelAutoShow", { Target = week }, {
			Now = lastTick,
			ById = companies.ById,
			Listed = function()
				return false
			end,
			Taken = function()
				return false
			end,
			InPipeline = function()
				return false
			end,
			Week = week,
			By = by.UserId,
			NewId = GlobalBus.NewId,
		})
		if cancel then
			GlobalBus.Publish(cancel :: any)
		end
	end
	local ok, how = GlobalBus.Publish(ev :: any)
	if not ok then
		return false, Lang.T(lang, "mkt.admin.notDistributed")
	end
	call("MetricsService", "Custom", by, "MarketAdmin", nil, { Kind = ev.Kind })
	if how == "local" then
		return true, Lang.T(lang, "mkt.admin.local")
	end
	if ev.Kind == "CancelAutoShow" then
		return true, Lang.T(lang, "mkt.admin.cancelled")
	end
	return true, Lang.T(lang, "mkt.admin.ok", math.max(0, ev.StartTick - lastTick))
end

-- ---------------------------------------------------------------------
-- STATE "Market" (§C10) + Tagesschluss je Spieler
-- ---------------------------------------------------------------------
local function regimeRounded(): number
	return math.round(MarketService.Regime() * 100) / 100
end

local function weatherBucket(r: number): number
	local weather = cfg.Noise.Weather
	return if r < weather.Calm then 0 elseif r > weather.Storm then 2 else 1
end

local function marketState(): Plain
	local cur = ctxCur
	local halts: { [string]: number } = {}
	if cur and ready then
		halts = cur.Director:AnyHalt(lastTick)
	end
	local week = MarketClock.WeekIndex(lastTick)
	return {
		Week = week,
		Day = MarketClock.DayIndex(lastTick),
		Regime = regimeRounded(),
		Halts = halts,
		AdminWindow = MarketService.AdminWindowActive(),
		AutoShowCancelled = autoShowCancelled(week),
		Ready = ready,
	}
end

local function checkStateChange()
	local s = marketState()
	local parts: { string } = {
		tostring(s.Day),
		tostring(weatherBucket(s.Regime)),
		tostring(s.AdminWindow),
		tostring(s.AutoShowCancelled),
	}
	local keys: { string } = {}
	for key, untilTick in pairs(s.Halts) do
		table.insert(keys, key .. ":" .. tostring(untilTick))
	end
	table.sort(keys)
	table.insert(parts, table.concat(keys, ","))
	local sig = table.concat(parts, "|")
	if sig ~= stateSig then
		stateSig = sig
		markAllDirty()
	end
end

local function onDayResult(p: Player, r: Plain)
	if type(r) ~= "table" or typeof(p) ~= "Instance" or p.Parent ~= Players then
		return
	end
	if Util.IsFinite(r.Return) and Util.IsFinite(r.Day) then
		MarketAudit.NoteDay(p.UserId, r.Day, r.Return)
	end
	local pending = pendingDay
	if pending and r.Day == pending.Day and not pending.Sent[p] then
		pending.Sent[p] = true
		Remotes.Market:FireClient(p, "DayClose", {
			Day = pending.Day,
			Return = if Util.IsFinite(r.Return) then r.Return else nil,
			Transfer = if Util.IsFinite(r.Transfer) and r.Transfer > 0 then math.floor(r.Transfer) else nil,
		})
	end
end

local function flushDayClose(force: boolean)
	local pending = pendingDay
	if pending == nil then
		return
	end
	if not force and os.clock() < pending.Deadline then
		return
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if not pending.Sent[p] then
			pending.Sent[p] = true
			Remotes.Market:FireClient(p, "DayClose", { Day = pending.Day })
		end
	end
	pendingDay = nil
end

-- ---------------------------------------------------------------------
-- TICK-SCHLEIFE (nie yielden)
-- ---------------------------------------------------------------------
local function pushRecent(item: Types.NewsItem)
	table.insert(recent, item)
	while #recent > cfg.NewsKeep do
		table.remove(recent, 1)
	end
end

local function prefetchNext(week: number)
	if prefetching then
		return
	end
	prefetching = true
	task.spawn(function()
		local ok, err = pcall(function()
			local seed = MarketSeed.Load(week)
			local tune = MarketSeed.LoadTune(week, cfg.NewsMeanGap)
			for id, rec in pairs(MarketSeed.LoadIpos(seasonOfWeek(week))) do
				if listings[id] == nil then
					listings[id] = rec
				end
			end
			nextSeed = { Week = week, Seed = seed, Tune = tune }
		end)
		if not ok then
			logError("Prefetch", err)
		end
		prefetching = false
	end)
end

-- Wochenwechsel: false = noch nicht bereit (Tick wird später nachgeholt)
local function rollover(t: number): boolean
	local cur = ctxCur
	if cur == nil then
		return false
	end
	local week = MarketClock.WeekIndex(t)
	if week == cur.Week then
		return true
	end
	local pre = nextSeed
	if pre == nil or pre.Week ~= week then
		prefetchNext(week)
		return false
	end
	local closes = closesOf(cur)
	task.spawn(MarketSeed.SaveClose, cur.Week, closes)
	local fresh = newContext(week, pre.Seed, closes, pre.Tune)
	fresh.Director:EnsureBuilt(MarketClock.DayIndex(t))
	for _, id in ipairs(busOrder) do
		local ev = busEvents[id]
		if ev and ev.Kind ~= "CancelAutoShow" then
			applyToContext(fresh, ev)
		end
	end
	ctxPrev = cur
	ctxCur = fresh
	nextSeed = nil
	if not localMarket then
		task.spawn(MarketSeed.EnsureNext, week)
	end
	return true
end

local function advance(t: number): boolean
	if not rollover(t) then
		return false
	end
	local cur = ctxCur :: Ctx
	ensureBuilt(cur, t)
	local director = cur.Director
	-- 1) News mit t_a == t (nie früher) und Nachrichten dieses Ticks
	for _, item in ipairs(director:NewsIn(t - 1, t)) do
		pushRecent(item)
		Remotes.Market:FireAllClients("News", item)
		fire(newsCallbacks, item)
	end
	for _, m in ipairs(director:MessagesAt(t)) do
		Remotes.Market:FireAllClients(m.Kind, m.Data)
	end
	-- 2) Kurse
	cur.Engine:Step(t)
	-- ab hier gilt Tick t als verarbeitet: Tick()/Candle1s/PriceAt/Dividends/IsHalted sehen t (nicht t − 1).
	-- Sonst prüfen die Orders in OnTick(t) die Kerze t − 1 (Blick zurück auf schon gesendete Dochte) und
	-- Dividends(t, t) wäre leer (Live-Dividenden würden nie gutgeschrieben).
	lastTick = t
	-- 3) Orders & Co. (WP4) – nach Step, vor Kerzen/Frame
	fire(tickCallbacks, t)
	-- 4) Kerzen-Ringe
	for _, i in ipairs(cur.Engine:Ids()) do
		local o, h, l, c, v = cur.Engine:Candle(i)
		if o and h and l and c and v then
			store:Push(i, t, o, h, l, c, v)
		end
	end
	-- 5) Glocke, Kalender-Delta, Tagesschluss
	if t % DAY == 0 then
		local day = MarketClock.DayIndex(t)
		flushDayClose(true)
		Remotes.Market:FireAllClients("Bell", { Day = day })
		local fromDay = (day + 2) * DAY
		local delta = director:Calendar(fromDay, fromDay + DAY - 1)
		if #delta > 0 then
			Remotes.Market:FireAllClients("Calendar", delta)
		end
		pendingDay = { Day = day - 1, Deadline = os.clock() + DAYCLOSE_WAIT, Sent = {} }
		fire(dayCallbacks, day - 1, t)
	end
	-- Vorwoche frühzeitig holen (Seed der nächsten Woche, eingefrorener News-Takt)
	if MarketClock.WeekEnd(cur.Week) - t <= (cfg.Seed.PrefetchBefore or 3600) and nextSeed == nil then
		prefetchNext(cur.Week + 1)
	end
	return true
end

local function frameSource(cur: Ctx): QuoteStream.Source
	local engine, director = cur.Engine, cur.Director
	local t = lastTick
	local anyHalt = next(director:AnyHalt(t)) ~= nil
	local crash, rally = director:CrashRally(t)
	local ids: { number } = {}
	for _, i in ipairs(engine:Ids()) do
		if engine:IsActive(i, t) then
			table.insert(ids, i)
		end
	end
	table.sort(ids)
	return {
		Ids = ids,
		Candle = function(i: number)
			return engine:Candle(i)
		end,
		Halted = function(i: number): boolean
			local halted = director:Halted(i, t)
			return halted
		end,
		News = function(i: number): boolean
			return engine:NewsActive(i)
		end,
		ExDay = function(i: number): boolean
			return director:ExDay(i, t)
		end,
		WeekHigh = function(i: number): number
			return store:WeekHigh(i)
		end,
		Regime = engine:Regime(),
		AnyHalt = anyHalt,
		Admin = MarketService.AdminWindowActive(t),
		Crash = crash,
		Rally = rally,
	}
end

local function marketJob()
	if not ready then
		return
	end
	local started = os.clock()
	local target = Clock.Tick()
	local catch = cfg.CatchUp
	if target - lastTick > catch.JumpAfter then
		-- Stillstand: auf jetzt springen, Kerzen-Fenster neu rechnen, verpasste Tagesschlüsse nachholen
		local from = lastTick + 1
		local firstDay = MarketClock.DayIndex(from - 1) + 1
		local lastDay = MarketClock.DayIndex(target - 1)
		local cur = ctxCur
		if cur and MarketClock.WeekIndex(target - 1) == cur.Week then
			ensureBuilt(cur, target - 1)
			lastTick = target - 1
			store:Rebuild(allIds(), from, target - 1, target)
			seedLive(allIds(), target)
			for day = math.max(firstDay, lastDay - MAX_SKIPPED_DAYS + 1), lastDay do
				fire(dayCallbacks, day - 1, day * DAY)
			end
		elseif cur then
			lastTick = math.max(lastTick, MarketClock.WeekEnd(cur.Week))
		end
	end
	local steps = 0
	while lastTick < target and steps < catch.MaxTicksPerRun do
		local t = lastTick + 1
		local ok, result = pcall(advance, t)
		if not ok then
			logError("Tick " .. t, result)
			lastTick = t -- defekten Tick nicht endlos wiederholen
		elseif result == false then
			break -- Wochenwechsel wartet auf den Seed
		else
			lastTick = t
		end
		steps += 1
	end
	local cur = ctxCur
	if steps > 0 and cur then
		local okFrame, err = pcall(function()
			QuoteStream.Broadcast(Remotes.MarketFrame, lastTick, frameSource(cur))
		end)
		if not okFrame then
			logError("Frame", err)
		end
		checkStateChange()
	end
	flushDayClose(false)
	local spent = os.clock() - started
	tickMs = tickMs * 0.9 + spent * 1000 * 0.1
end

local function frameJob()
	if not ready then
		return
	end
	local cur = ctxCur
	if cur then
		-- Plan vorausbauen (mindestens 2 Börsentage), höchstens 1 Tag je Frame
		local wanted = MarketClock.DayIndex(lastTick) + 2
		if cur.Director:BuiltThrough() < wanted then
			cur.Director:EnsureBuilt(wanted, 1)
		end
	end
	if store:Pending() > 0 then
		store:Work(cfg.Backfill.FrameMs)
	end
end

local function busJob()
	if not ready or busPolling then
		return
	end
	busPolling = true
	task.spawn(function()
		local ok, err = pcall(GlobalBus.Poll)
		if not ok then
			logError("Bus-Poll", err)
		end
		busPolling = false
	end)
end

-- ---------------------------------------------------------------------
-- START (Hintergrund-Thread): Seed, Wochenbasis, Plan, Bus, Backfill
-- ---------------------------------------------------------------------
local function loadListings(week: number)
	local season = seasonOfWeek(week)
	for s = 1, season do
		for id, rec in pairs(MarketSeed.LoadIpos(s)) do
			listings[id] = rec
		end
	end
end

local function boot()
	booting = true
	local now = Clock.Tick()
	local week = MarketClock.WeekIndex(now)
	local seed, isLocal = MarketSeed.Load(week)
	localMarket = isLocal
	if not isLocal then
		task.spawn(MarketSeed.EnsureNext, week)
		loadListings(week)
	end
	local tune = MarketSeed.LoadTune(week, cfg.NewsMeanGap)
	local weekStart = MarketClock.WeekStart(week)
	local bases = MarketSeed.LoadClose(week - 1)
	local needPrev = not isLocal and (bases == nil or now - weekStart < cfg.Bus.ExpirySeconds)
	if needPrev then
		local prevSeed = MarketSeed.Peek(week - 1)
		if prevSeed then
			local prevBases = MarketSeed.LoadClose(week - 2) or {}
			local prevTune = MarketSeed.LoadTune(week - 1, cfg.NewsMeanGap)
			local prev = newContext(week - 1, prevSeed, prevBases, prevTune)
			buildDays(prev, MarketClock.DayIndex(MarketClock.WeekEnd(week - 1)), true)
			ctxPrev = prev
			if bases == nil then
				bases = closesOf(prev)
				task.spawn(MarketSeed.SaveClose, week - 1, bases :: { [number]: number })
			end
		end
	end
	local cur = newContext(week, seed, bases or {}, tune)
	ctxCur = cur
	-- Admin-Log der Woche (Admin-Fenster älter als der Bus) + Bus starten (liefert Events der letzten 26 h)
	if not isLocal then
		for _, ev in ipairs(GlobalBus.LoadLog(week)) do
			addWindow(ev)
			if ev.Kind == "CancelAutoShow" then
				onBusEvent(ev, false)
			end
		end
	end
	buildDays(cur, MarketClock.DayIndex(Clock.Tick()) + 1, true)
	GlobalBus.Start(onBusEvent, { Local = isLocal, Now = Clock.Tick })
	-- Live-Start: laufende 5s/1m-Kerzen exakt vorbelegen, Backfill einplanen, Schleife starten
	local liveStart = Clock.Tick()
	if MarketClock.WeekIndex(liveStart) ~= cur.Week then
		liveStart = MarketClock.WeekEnd(cur.Week) -- extrem langer Start über den Wochenwechsel: ab Wochenende nachholen
	end
	buildDays(cur, MarketClock.DayIndex(liveStart) + 1, true)
	local ids = cur.Engine:Ids()
	local candleAt = function(id: number, t: number)
		local c = contextFor(t)
		if c then
			ensureBuilt(c, t)
			local o, h, l, cl, v = c.Engine:CandleAt(id, t)
			return o, h, l, cl, v
		end
		local p = MarketService.PriceAt(id, t)
		return p, p, p, p, 0
	end
	lastTick = liveStart - 1
	-- vor "ready": die Schleife darf die laufenden Buckets noch nicht anfassen (sie holt die Zwischenzeit danach nach)
	for index, id in ipairs(ids) do
		store:SeedPartial(id, liveStart, candleAt)
		if index % 8 == 0 then
			task.wait()
		end
	end
	for _, item in ipairs(cur.Director:LatestNews(lastTick, cfg.NewsKeep)) do
		table.insert(recent, 1, item)
	end
	store:Plan(function(id: number, t0: number)
		return MarketService.NewCursor(id, t0)
	end, ids, liveStart)
	ready = true
	booting = false
	markAllDirty()
	print(
		("[MarketService] Markt läuft – Woche %d, %d Instrumente%s"):format(
			week,
			#ids,
			if isLocal then " (Lokaler Testmarkt)" else ""
		)
	)
end

-- ---------------------------------------------------------------------
-- ANFRAGEN (§C9)
-- ---------------------------------------------------------------------
local function validInst(i: any): boolean
	if not isInt(i) then
		return false
	end
	local cur = ctxCur
	return cur ~= nil and cur.Engine:Has(i) and cur.Engine:IsActive(i, lastTick)
end

local function handleCandles(p: Player, arg: any): Types.Reply
	if not exactKeys(arg, { "I", "Tf" }) or not isInt(arg.I) or type(arg.Tf) ~= "string" then
		return reply(p, false, "mkt.invalid")
	end
	local tf = QuoteCodec.TF[arg.Tf]
	if tf == nil then
		return reply(p, false, "mkt.invalid")
	end
	if not ready then
		return reply(p, false, "mkt.notReady")
	end
	if not validInst(arg.I) then
		return reply(p, false, "mkt.unknownInst")
	end
	-- Backfill (Serverstart, verspätetes Event) für dieses Fenster noch offen: Instrument vorziehen, Client fragt gleich
	-- nochmal (MarketClient wiederholt nach 2,5 s) – sonst bliebe sein Chart bis zum Verwerfen lückenhaft
	if store:Missing(arg.I, lastTick - (cfg.History.Candles + 1) * tf) then
		store:Prioritize(arg.I)
		return reply(p, false, "mkt.historyLoading")
	end
	local buf = store:Get(arg.I, tf)
	if buf == nil then
		return reply(p, false, "mkt.historyLoading")
	end
	return { Ok = true, Buf = buf }
end

local function researchLead(p: Player): number
	local research = cfg.Research
	local minutes = research.BaseLeadMinutes
	local ok, perks = call("ProgressionService", "TradingPerks", p)
	if ok and type(perks) == "table" and Util.IsFinite(perks.ResearchLead) then
		local lead = perks.ResearchLead
		minutes = if lead > 10 then lead / 60 else lead -- Minuten (2/3/5) oder Sekunden
	end
	return math.clamp(minutes, research.BaseLeadMinutes, research.MaxLeadMinutes) * 60
end

local function handleProfile(p: Player, arg: any): Types.Reply
	if not exactKeys(arg, { "I" }) or not isInt(arg.I) then
		return reply(p, false, "mkt.invalid")
	end
	if not ready then
		return reply(p, false, "mkt.notReady")
	end
	local i = arg.I
	local entry = inst(i)
	local cur = ctxCur
	if entry == nil or cur == nil or entry.Set == "Tutorial" then
		return reply(p, false, "mkt.unknownInst")
	end
	local profile: Plain
	if entry.Class == "ETF" then
		profile = { I = i, Etf = true, Members = entry.Members }
	else
		local isPipeline = entry.Ipo == true and inPipeline(i, cur.Week)
		if not validInst(i) and not isPipeline then
			return reply(p, false, "mkt.unknownInst")
		end
		local built = cur.Director:Profile(i, lastTick, researchLead(p))
		if built == nil then
			return reply(p, false, "mkt.unknownInst")
		end
		profile = built
	end
	local _, _, mid = cur.Engine:Quote(i)
	local hi, lo = store:Range(i)
	profile.Ticker = entry.Ticker
	profile.Class = entry.Class
	profile.Mid = mid
	profile.WeekHigh = hi
	profile.WeekLow = lo
	if mid and profile.Eps and profile.Eps > 0 then
		profile.Pe = math.round(mid / profile.Eps * 10) / 10
	end
	return { Ok = true, Profile = profile }
end

local function handleCalendar(p: Player, arg: any): Types.Reply
	if not exactKeys(arg, { "Days" }) or not isInt(arg.Days) or arg.Days < 1 or arg.Days > 3 then
		return reply(p, false, "mkt.invalid")
	end
	if not ready then
		return reply(p, false, "mkt.notReady")
	end
	return { Ok = true, Items = MarketService.Calendar(arg.Days) }
end

local function handleNews(p: Player, arg: any): Types.Reply
	if not exactKeys(arg, {}) then
		return reply(p, false, "mkt.invalid")
	end
	return { Ok = true, Items = MarketService.RecentNews(cfg.NewsKeep) }
end

-- ---------------------------------------------------------------------
-- INIT / START
-- ---------------------------------------------------------------------
function MarketService.Init(services: any)
	Services = services
	local pss = service("PlayerStateService")
	if pss then
		pss.Provide("Market", function(_p: Player)
			return marketState()
		end)
		local buckets = cfg.Buckets
		pss.Handle("MktCandles", handleCandles, { Bucket = buckets.MktCandles })
		pss.Handle("MktProfile", handleProfile, { Bucket = buckets.MktProfile })
		pss.Handle("MktCalendar", handleCalendar, { Bucket = buckets.MktCalendar })
		pss.Handle("MktNews", handleNews, { Rate = cfg.NewsRate[1], Per = cfg.NewsRate[2] })
	else
		warn("[MarketService] PlayerStateService fehlt – keine Markt-Anfragen")
	end
end

function MarketService.Start()
	-- Tagesrendite (für DayClose je Spieler + Ausreißer-Statistik) und Fill-Audit über die Signale von WP4
	call("OrderService", "OnDayResult", onDayResult)
	call("OrderService", "OnTrade", function(p: Player, f: Plain)
		if type(f) ~= "table" then
			return
		end
		MarketAudit.VerifyFill(f, {
			CandleAt = function(i: number, t: number)
				local o, h, l, c = MarketService.Candle1s(i, t)
				return o, h, l, c
			end,
			Quote = function(i: number, t: number)
				local tick = clampTick(t)
				local ctx = contextFor(tick)
				if ctx == nil or not ctx.Engine:IsActive(i, tick) then
					return nil, nil
				end
				local bid, ask = ctx.Engine:QuoteAt(i, tick)
				return bid, ask
			end,
		})
		local _ = p
	end)
	Players.PlayerRemoving:Connect(function(p: Player)
		adminCooldown[p.UserId] = nil
		MarketAudit.Clear(p.UserId)
		local pending = pendingDay
		if pending then
			pending.Sent[p] = nil
		end
	end)
	Scheduler.Every("Market", 1, marketJob)
	Scheduler.EveryFrame("MarketBackfill", frameJob)
	Scheduler.Every("MarketBus", 1 / math.max(1, cfg.Bus.PollSeconds), busJob)
	if not booting and not ready then
		task.spawn(function()
			local ok, err = xpcall(boot, debug.traceback)
			if not ok then
				booting = false
				warn("[MarketService] Start fehlgeschlagen: " .. tostring(err))
			end
		end)
	end
	local _ = RunService
end

return MarketService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">MetricsService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Analytics (Server/Services/MetricsService)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C5.2 + §B2 (FTUE-Funnel) + §E3 (KPI). CC-Kopie 1:1.
--  Dünne Hülle um AnalyticsService: jeder Aufruf in pcall, Eingaben geprüft, pro Spieler gedrosselt
--  (Token-Eimer 30 + 0,5/s; Roblox-Grenze ≈ 120 + 20 × Spieler Ereignisse pro Minute und Server).
--
--  Öffentliche API (§C5.2):
--    MetricsService.Funnel(p, step, name)                     FTUE-Schritte 1–18 (§B2, je Schritt 1× pro Sitzung)
--    MetricsService.Economy(p, flow, currency, amount, balance, txType, sku?)   "Source" | "Sink", "CR" | "AKY"
--    MetricsService.Progression(p, path, status, level)       "Start" | "Complete" | "Fail"
--    MetricsService.Custom(p, name, value?, fields?)          fields -> bis zu 3 Custom-Fields ("Schlüssel=Wert")
--  Schritt 1 "Joined" loggt dieser Dienst selbst beim Beitritt.
-- =====================================================================

local AnalyticsService = game:GetService("AnalyticsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))

local MetricsService = {}
local _Services: any = nil

local MAX_NAME = 50
local MAX_FIELD = 50
local MAX_FIELDS = 3
local MAX_STEP = 50
local BUCKET_SIZE = 30 -- Ereignisse sofort …
local BUCKET_REFILL = 0.5 -- … danach 30 pro Minute pro Spieler
local LOG_GAP = 30

local FIELD_KEYS = {
	Enum.AnalyticsCustomFieldKeys.CustomField01.Name,
	Enum.AnalyticsCustomFieldKeys.CustomField02.Name,
	Enum.AnalyticsCustomFieldKeys.CustomField03.Name,
}
local PROGRESSION_STATUS: { [string]: Enum.AnalyticsProgressionType } = {
	Start = Enum.AnalyticsProgressionType.Start,
	Complete = Enum.AnalyticsProgressionType.Complete,
	Fail = Enum.AnalyticsProgressionType.Fail,
}
local FLOW: { [string]: Enum.AnalyticsEconomyFlowType } = {
	Source = Enum.AnalyticsEconomyFlowType.Source,
	Sink = Enum.AnalyticsEconomyFlowType.Sink,
}

local bucket = Util.TokenBucket(BUCKET_SIZE, BUCKET_REFILL)
-- Pro-Spieler-Tabellen (bei PlayerRemoving geleert)
local funnelDone: { [Player]: { [number]: boolean } } = {}
local lastLogAt: { [string]: number } = {}

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function logError(where: string, err: any)
	local now = os.clock()
	if (lastLogAt[where] or -math.huge) + LOG_GAP <= now then
		lastLogAt[where] = now
		warn("[MetricsService] " .. where .. ": " .. tostring(err))
	end
end

local function valid(p: any): boolean
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent == Players
end

local function text(v: any, maxLen: number): string
	local s = if type(v) == "string" then v else tostring(v)
	return string.sub(s, 1, maxLen)
end

local function allow(p: Player): boolean
	return bucket.Take(p, 1)
end

-- { a = 1, b = "x" } -> { CustomField01 = "a=1", CustomField02 = "b=x" } (sortiert, max. 3)
local function customFields(fields: { [string]: any }?): { [string]: string }?
	if type(fields) ~= "table" then
		return nil
	end
	local keys: { string } = {}
	for key in pairs(fields) do
		if type(key) == "string" and #keys < 16 then
			table.insert(keys, key)
		end
	end
	if #keys == 0 then
		return nil
	end
	table.sort(keys)
	local out: { [string]: string } = {}
	for i = 1, math.min(#keys, MAX_FIELDS) do
		local key = keys[i]
		out[FIELD_KEYS[i]] = text(key .. "=" .. tostring(fields[key]), MAX_FIELD)
	end
	return out
end

local function call(where: string, fn: () -> ())
	local ok, err = pcall(fn)
	if not ok then
		logError(where, err)
	end
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function MetricsService.Funnel(p: Player, step: number, name: string)
	if not valid(p) or not Util.IsFinite(step) or step < 1 or step > MAX_STEP or step % 1 ~= 0 then
		return
	end
	local done = funnelDone[p]
	if not done then
		done = {}
		funnelDone[p] = done
	end
	if done[step] then
		return
	end
	done[step] = true
	if not allow(p) then
		return
	end
	local stepName = text(name, MAX_NAME)
	call("Funnel", function()
		AnalyticsService:LogOnboardingFunnelStepEvent(p, step, stepName)
	end)
end

function MetricsService.Economy(
	p: Player,
	flow: "Source" | "Sink",
	currency: "CR" | "AKY",
	amount: number,
	balance: number,
	txType: string,
	sku: string?
)
	local flowType = FLOW[flow]
	if not valid(p) or not flowType or (currency ~= "CR" and currency ~= "AKY") then
		return
	end
	if not Util.IsFinite(amount) or amount <= 0 or not Util.IsFinite(balance) then
		return
	end
	if not allow(p) then
		return
	end
	-- Transaktions-Art: Enum-Name (z. B. "Shop", "Gameplay") oder eigener Text
	local tx = text(txType, MAX_NAME)
	if tx == "" then
		tx = Enum.AnalyticsEconomyTransactionType.Gameplay.Name
	end
	local item = if type(sku) == "string" and sku ~= "" then text(sku, MAX_NAME) else nil
	local whole = math.floor(amount + 0.5)
	local ending = math.max(0, math.floor(balance + 0.5))
	call("Economy", function()
		AnalyticsService:LogEconomyEvent(p, flowType, currency, whole, ending, tx, item)
	end)
end

function MetricsService.Progression(p: Player, path: string, status: "Start" | "Complete" | "Fail", level: number)
	local progressionType = PROGRESSION_STATUS[status]
	if not valid(p) or not progressionType or type(path) ~= "string" or path == "" then
		return
	end
	if not allow(p) then
		return
	end
	local pathName = text(path, MAX_NAME)
	local lvl = if Util.IsFinite(level) then math.max(1, math.floor(level)) else 1
	call("Progression", function()
		AnalyticsService:LogProgressionEvent(p, pathName, progressionType, lvl)
	end)
end

function MetricsService.Custom(p: Player, name: string, value: number?, fields: { [string]: any }?)
	if not valid(p) or type(name) ~= "string" or name == "" then
		return
	end
	if not allow(p) then
		return
	end
	local eventName = text(name, MAX_NAME)
	local v = if Util.IsFinite(value) then value :: number else 1
	local extra = customFields(fields)
	call("Custom", function()
		AnalyticsService:LogCustomEvent(p, eventName, v, extra)
	end)
end

-- ---------------------------------------------------------------------
-- INIT / START
-- ---------------------------------------------------------------------
local function onPlayerAdded(p: Player)
	MetricsService.Funnel(p, 1, "Joined")
end

function MetricsService.Init(services: any)
	_Services = services
end

function MetricsService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end
	Players.PlayerRemoving:Connect(function(p: Player)
		funnelDone[p] = nil
		bucket.Clear(p)
	end)
end

return MetricsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Robux: Gamepässe, Developer Products, Abo, PolicyService, Angebote (Server/Services/MonetizationService)
--  Besitzer: WP10 (Monetarisierung, Shop, CR-Konto). Vertrag: DESIGN.md §C5.9, §B14 (Pässe, Produkte, Abo, Angebots-
--  Regeln, Firewall & Policy), §B10.3 (Bullen-Parade/Feuerwerk), §C11.1 (idempotente Belege), §C11.4 (Firewall).
--  Basis: CLUTCH-CLASH-MonetizationService (REUSE §3.11, Kern 1:1 inkl. aller Runde-2-Fixes REUSE §7 #25/#26/#30).
--
--  ROBUX-FIREWALL (§0.4): Robux geben NUR Turm-Seite. Jede Gewährung läuft über ShopService.Grant (Grund "Robux:<Key>"),
--  dort streicht Core.Sanitize die ForbiddenRobuxFields; Types.Grant hat ohnehin keine AKY-/XP-/Lizenz-Felder. Keine
--  Funktion hier berührt Depot, Orders, Lizenz, XP, Know-how, Ruf oder Marktinfos.
--
--  ProcessReceipt (§C11.1, CC-Fluss exakt):
--    1. Callback früh in Start. Unbekanntes Produkt -> NotProcessedYet (+ warn "in Config eintragen").
--    2. Bis zu 60 s auf den Spielstand warten (Roblox ruft beim Beitritt oft VOR dem Laden auf).
--    3. Läuft dieselbe PurchaseId schon -> bis 60 s warten, dann Belege erneut prüfen. Beleg vorhanden -> Granted.
--    4. Alles Yieldende zuerst (prepare: Policy, Einkommen, Saison), dann OHNE Yield gutschreiben + Beleg (letzte 60)
--       + RobuxSpent in einem Rutsch.
--    5. PurchaseGranted erst nach erfolgreichem DataService.Save (Beleg steht im Stand -> nie doppelt).
--
--  Öffentliche API (§C5.9):
--    MonetizationService.HasPass(p, key): boolean          TycoonBundle zählt für Income2x/AutoCollect/OfflineVault
--    MonetizationService.PassFactor(p): number              1 / 2 / 3 / 4 (x2 + x3 = x4, nie x6)
--    MonetizationService.FixedFactor(p): number             VIP 1,10 × Club 1,15 × Roblox Premium 1,10
--    MonetizationService.IsClub(p): boolean
--    MonetizationService.LoadPasses(p)                      3 Versuche je Pass + Abo-Status, loading-Guard
--    MonetizationService.RandomAllowed(p): boolean?         nil = unbekannt = eingeschränkt behandeln
--    MonetizationService.TradingAllowed(p): boolean         IsPaidItemTradingAllowed == true (sonst false)
--    MonetizationService.SetPolicyOverride(p, field, value?)   Admin "Policy simulieren"; field = "Random" | "Trading" |
--                                                           "Subscription" | "All" (oder PolicyService-Feldname); nil = aus
--    MonetizationService.SimulatePurchase(p, productKey, purchaseId?): (boolean, string)   gleicher Weg wie ein echter
--                                                           Kauf (Id 0 ok); purchaseId fest = Idempotenz-Test
--    MonetizationService.TryOffer(p, offerKey): boolean    max. 1 Angebot je Sitzung + alle Regeln §B14.4
--    MonetizationService.Quote(p, productKey): (number?, number?)   CR-Angebot eines Bau-Gutscheins (+ gültig bis, Unix)
--  Zusätzlich (für ShopService/Admin/Tests): MonetizationService.Precheck(p, key, userId?): Reply ·
--    MonetizationService.ParadeUntil(): number · MonetizationService.Core (reine Entscheidungen für EconomyTests)
--  State-Schlüssel: Passes, Club, Boosts, Offers, RandomAllowed, TradingAllowed, Starter.
--  Braucht (zur Laufzeit, optional per pcall): DataService, PlayerStateService, ShopService, TowerService
--    (Income, SetServerBoost, OnStageUp), RewardService (SeasonPremium), EventService (StartParade, StartFireworks,
--    IsAdminAbuse), MarketService (OnNews), PlotService (PlotOf), MetricsService (Custom).
-- =====================================================================

local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Lang = require(Shared:WaitForChild("Lang"))
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Format"))

local MonetizationService = {}
local Services: any = nil

type Reply = Types.Reply
type Policy = { Random: boolean, Trading: boolean, Subscription: boolean }
type OfferCtx = {
	Shown: number,
	Max: number,
	Sessions: number,
	MinSession: number,
	SessionSeconds: number,
	MinSeconds: number,
	TutorialDone: boolean,
	AdminAbuse: boolean,
	MarketBlocked: boolean,
}

local SHOP: any = Config.Shop
local TECH: any = Config.Tech or {}

-- ---------------------------------------------------------------------
-- 1) KONSTANTEN
-- ---------------------------------------------------------------------
local MAX_MONEY = 9e15
local RECEIPT_KEEP = math.max(1, math.floor(tonumber(TECH.ReceiptKeep) or 60))
local PROFILE_WAIT = 60 -- Sekunden auf den Spielstand warten (Roblox ruft ProcessReceipt oft vor dem Laden)
local PROFILE_POLL = 0.25
local PROCESSING_WAIT = 60 -- Sekunden auf einen parallel laufenden gleichen Kauf warten
local PROCESSING_POLL = 0.2
local POLICY_WAIT = 10 -- prepare: so lange höchstens auf eine Policy-Antwort warten (danach: eingeschränkt)
local READY_WAIT = 20 -- prepare (Bau-Gutschein): so lange höchstens auf Pässe + Turm-Einkommen nach dem Beitritt warten
local POLICY_ATTEMPTS = 2
local POLICY_RETRY = 2
local PASS_ATTEMPTS = 3
local CLUB_ATTEMPTS = 2
local LOAD_WAIT_STEPS = 600 -- zweiter LoadPasses-Aufrufer wartet höchstens 60 s
local MAX_OFFERS = math.clamp(math.floor(tonumber(SHOP.MaxOffersPerSession) or 1), 0, 1)
local OFFER_MIN_SECONDS = math.max(0, (tonumber(SHOP.OfferMinMinutes) or 15) * 60)
local OFFER_MIN_SESSION = math.max(2, math.floor(tonumber(SHOP.OfferMinSession) or 2))
local OFFER_DELAY = math.max(0, tonumber(SHOP.OfferDelaySeconds) or 4)
local MARKET_BLOCK = math.max(0, tonumber(SHOP.OfferMarketBlockSeconds) or 900)
local QUOTE_SECONDS = math.max(60, math.floor(tonumber(SHOP.QuoteSeconds) or 600))
local GIFT_HOLD = math.max(10, tonumber(SHOP.GiftHoldSeconds) or 180)
local PRECHECK_POLICY_WAIT = math.max(1, tonumber(SHOP.PolicyWaitSeconds) or 5)
local PARADE: any = SHOP.Parade or {}
local PARADE_SECONDS = math.max(1, math.floor(tonumber(PARADE.Seconds) or 900))
local PARADE_CAP = math.max(PARADE_SECONDS, math.floor(tonumber(PARADE.CapSeconds) or 3600))
local FIREWORK_SECONDS = math.max(1, tonumber(SHOP.Fireworks and SHOP.Fireworks.Seconds) or 20)
local SUB: any = SHOP.Subscription or {}
local CLUB_KEY: string = if type(SUB.Key) == "string" then SUB.Key else "Club"
local MARKET_BLOCK_KINDS: { [string]: boolean } = { Warn = true, Crash = true, Rally = true }

-- Paket-Teil -> Pakete, die ihn enthalten (HasPass zählt Paket-Besitz wie Besitz der Teile)
local BUNDLES_FOR: { [string]: { string } } = {}
for _, pass in ipairs(SHOP.GamePasses or {}) do
	if type(pass.Includes) == "table" then
		for _, part in ipairs(pass.Includes) do
			BUNDLES_FOR[part] = BUNDLES_FOR[part] or {}
			table.insert(BUNDLES_FOR[part], pass.Key)
		end
	end
end

-- ---------------------------------------------------------------------
-- 2) ZUSTAND (jede Pro-Spieler-Tabelle wird bei PlayerRemoving geleert)
-- ---------------------------------------------------------------------
local owned: { [Player]: { [string]: boolean } } = {} -- Marktplatz-Besitz (geladen)
local loading: { [Player]: boolean } = {}
local passesLoaded: { [Player]: boolean } = {} -- Marktplatz-Besitz einmal vollständig geladen
local sessionPasses: { [Player]: { [string]: boolean } } = {} -- Admin-Simulation, nicht gespeichert
local club: { [Player]: boolean } = {} -- Abo-Status vom Marktplatz
local sessionClub: { [Player]: boolean } = {} -- Admin-Simulation
local policy: { [Player]: Policy } = {}
local policyStarted: { [Player]: boolean } = {}
local policyOverride: { [Player]: { [string]: boolean } } = {}
local offersShown: { [Player]: number } = {}
local offerState: { [Player]: { Key: string, Id: number, At: number } } = {}
local sessionStart: { [Player]: number } = {}
local giftTarget: { [Player]: { UserId: number, Until: number } } = {}
local processing: { [string]: boolean } = {} -- PurchaseIds, die gerade gutgeschrieben werden
local paradeUntil = 0 -- os.time(), serverweit (nicht gespeichert)
local marketBlockUntil = 0 -- os.time(): bis dahin kein Angebot (Warnung/Crash/Rally)
local offerSerial = 0

-- =====================================================================
-- 3) HELFER
-- =====================================================================
local function service(name: string): any
	return Services and Services[name]
end

-- optionaler Dienst über pcall: (ok, ergebnis …)
local function call(name: string, fnName: string, ...: any): (boolean, any)
	local s = service(name)
	if s == nil or type(s[fnName]) ~= "function" then
		return false, nil
	end
	return pcall(s[fnName], ...)
end

local function has(name: string, fnName: string): boolean
	local s = service(name)
	return s ~= nil and type(s[fnName]) == "function"
end

local function present(p: any): boolean
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent == Players
end

local function isInteger(n: any): boolean
	return Util.IsFinite(n) and (n :: number) % 1 == 0
end

local function dataOf(p: Player): any
	local dataService = service("DataService")
	if dataService == nil or type(dataService.Get) ~= "function" then
		return nil
	end
	return dataService.Get(p)
end

local function langOf(p: Player): Types.Lang
	local ok, lang = call("PlayerStateService", "LangOf", p)
	return if ok and (lang == "de" or lang == "en") then lang else "en"
end

local function markDirty(p: Player, ...: string)
	local stateService = service("PlayerStateService")
	if stateService and type(stateService.MarkDirty) == "function" then
		stateService.MarkDirty(p, ...)
	end
end

local function notify(p: Player, key: string, args: { any }?, kind: Types.NotifyKind?)
	call("PlayerStateService", "Notify", p, key, args, kind)
end

local function fail(p: Player, key: string, ...: any): Reply
	return { Ok = false, Message = Lang.T(langOf(p), key, ...) }
end

local function itemName(p: Player, entry: any): string
	return if type(entry) == "table" and type(entry.Name) == "table" then Lang.Pick(langOf(p), entry.Name) else "?"
end

local function credits(p: Player, n: number): string
	return Format.Credits(n, langOf(p))
end

local function isDisabled(key: string): boolean
	local disabled = SHOP.Disabled
	return type(disabled) == "table" and disabled[key] == true
end

local function currentSeasonId(): number
	return SHOP.SeasonIdAt(Config.Season, os.time())
end

local function purchasesOf(data: any): any
	if type(data.Purchases) ~= "table" then
		data.Purchases = {}
	end
	local purchases = data.Purchases
	if type(purchases.Receipts) ~= "table" then
		purchases.Receipts = {}
	end
	if type(purchases.PassSeasons) ~= "table" then
		purchases.PassSeasons = {}
	end
	if type(purchases.Quote) ~= "table" then
		purchases.Quote = {}
	end
	if not Util.IsFinite(purchases.RobuxSpent) or purchases.RobuxSpent < 0 then
		purchases.RobuxSpent = 0
	end
	if type(purchases.Starter) ~= "boolean" then
		purchases.Starter = false
	end
	if not isInteger(purchases.ClubClaimDay) then
		purchases.ClubClaimDay = 0
	end
	if not isInteger(purchases.Gifts) or purchases.Gifts < 0 then
		purchases.Gifts = 0
	end
	if not Util.IsFinite(purchases.StarterOfferedAt) then
		purchases.StarterOfferedAt = 0
	end
	return purchases
end

-- Dauer-Einkommen pro Sekunde ohne Zeitlich (TowerService.Income(p).Steady), 0 wenn unbekannt
local function steadyOf(p: Player): number
	local ok, info = call("TowerService", "Income", p)
	if ok and type(info) == "table" and Util.IsFinite(info.Steady) and info.Steady > 0 then
		return info.Steady
	end
	return 0
end

local function seasonPremiumOf(p: Player): boolean
	local ok, premium = call("RewardService", "SeasonPremium", p)
	return ok and premium == true
end

local function isPremiumMember(p: Player): boolean
	local ok, result = pcall(function(): boolean
		return p.MembershipType == Enum.MembershipType.Premium
	end)
	return ok and result == true
end

local function fixedMult(key: string): number
	local mult = type(Config.Tower) == "table" and Config.Tower.Mult or nil
	local value = type(mult) == "table" and mult[key] or nil
	if Util.IsFinite(value) and value >= 1 then
		return value
	end
	local fixed = SHOP.Fixed
	local fallback = type(fixed) == "table" and fixed[key] or nil
	return if Util.IsFinite(fallback) and fallback >= 1 then fallback else 1
end

local function paradeMult(): number
	local mult = type(Config.Tower) == "table" and Config.Tower.Mult or nil
	local value = type(mult) == "table" and mult.Parade or nil
	return if Util.IsFinite(value) and value > 1 then value else 1.5
end

local function itemOf(key: string): (any, string?)
	local pass = SHOP.PassesByKey[key]
	if pass then
		return pass, "Pass"
	end
	local product = SHOP.ProductsByKey[key]
	if product then
		return product, "Product"
	end
	if key == CLUB_KEY then
		return SUB, "Subscription"
	end
	return nil, nil
end

-- =====================================================================
-- 4) CORE – Entscheidungen ohne Roblox-Aufrufe (EconomyTests)
-- =====================================================================
local Core = {}
MonetizationService.Core = Core

function Core.HasReceipt(data: any, purchaseId: string): boolean
	local purchases = purchasesOf(data)
	for _, entry in ipairs(purchases.Receipts) do
		local id = if type(entry) == "table" then entry.Id else entry
		if tostring(id) == purchaseId then
			return true
		end
	end
	return false
end

-- key (optional) = Produkt-Schlüssel -> Admin-Tab "Belege" zeigt, WAS gekauft wurde
function Core.AddReceipt(data: any, purchaseId: string, now: number, key: string?)
	local receipts = purchasesOf(data).Receipts
	table.insert(receipts, { Id = purchaseId, T = now, Key = if type(key) == "string" then key else nil })
	while #receipts > RECEIPT_KEEP do
		table.remove(receipts, 1)
	end
end

-- Robux dürfen nie die ForbiddenRobuxFields geben -> Kopie ohne sie (Firewall §0.4)
function Core.Sanitize(grant: any): { [string]: any }
	local clean, removed = SHOP.SanitizeGrant(grant, true)
	for _, field in ipairs(removed) do
		warn("[MonetizationService] Verbotenes Robux-Feld gestrichen: " .. tostring(field))
	end
	return clean
end

-- Gültiges Angebot (Quote) eines Bau-Gutscheins oder nil
function Core.QuoteFor(data: any, key: string, now: number): number?
	local quotes = type(data) == "table" and type(data.Purchases) == "table" and data.Purchases.Quote or nil
	local entry = type(quotes) == "table" and quotes[key] or nil
	if type(entry) ~= "table" or not isInteger(entry.Credits) or not Util.IsFinite(entry.Until) then
		return nil
	end
	-- abgelaufen oder unplausibel weit in der Zukunft (Uhr-/Datenfehler) -> zählt nicht
	if entry.Until <= now or entry.Until > now + QUOTE_SECONDS then
		return nil
	end
	return math.clamp(entry.Credits, 0, MAX_MONEY)
end

-- CR eines Bau-Gutscheins beim Kauf: max(gültiges Angebot, Neuberechnung) – nie weniger als angezeigt (§B14.2)
function Core.VoucherCredits(product: any, steady: number, data: any, now: number): number
	local fresh = SHOP.VoucherCredits(product, steady)
	local quote = if type(product) == "table" then Core.QuoteFor(data, product.Key, now) else nil
	return math.clamp(math.max(fresh, quote or 0), 0, MAX_MONEY)
end

-- Was gibt dieser Kauf JETZT? ctx = { SeasonId, Steady, Now, RandomAllowed, Premium }
-- Rückgabe (grant, info); info = { Repeat, MarkStarter, MarkSeason, Vouchers = { { Key, Credits } } }
function Core.BuildGrant(product: any, data: any, ctx: { [string]: any }): ({ [string]: any }, { [string]: any })
	local purchases = purchasesOf(data)
	local now = if Util.IsFinite(ctx.Now) then ctx.Now else os.time()
	local seasonId = if isInteger(ctx.SeasonId) then ctx.SeasonId else 1
	local steady = if Util.IsFinite(ctx.Steady) then ctx.Steady else 0
	local info: { [string]: any } = { Repeat = false, MarkStarter = false, MarkSeason = false, Vouchers = {} }
	-- Ersatz statt Inhalt: Starter-Paket schon gekauft, Saison-Premium schon da, oder ein (nie vorhandenes)
	-- Zufallsprodukt bei eingeschränktem/unbekanntem Spieler
	local repeatCase = (product.Once == true and purchases.Starter == true)
		or (product.PerSeason == true and (purchases.PassSeasons[tostring(seasonId)] == true or ctx.Premium == true))
		or (product.Random == true and ctx.RandomAllowed ~= true)
	local base: any = product
	if repeatCase then
		base = if type(product.Repeat) == "table" then product.Repeat else {}
		info.Repeat = true
	end
	local grant = Core.Sanitize(base.Grant or {})
	local voucherKeys: { string } = {}
	if not repeatCase and product.Kind == "Voucher" then
		table.insert(voucherKeys, product.Key)
	end
	if type(base.Vouchers) == "table" then
		for _, key in ipairs(base.Vouchers) do
			table.insert(voucherKeys, key)
		end
	end
	local total = if isInteger(grant.Credits) then grant.Credits else 0
	for _, key in ipairs(voucherKeys) do
		local voucher = SHOP.ProductsByKey[key]
		if voucher and voucher.Kind == "Voucher" then
			local amount = Core.VoucherCredits(voucher, steady, data, now)
			table.insert(info.Vouchers, { Key = key, Credits = amount })
			total += amount
		end
	end
	if total > 0 then
		grant.Credits = math.clamp(math.floor(total), 0, MAX_MONEY)
	end
	if not repeatCase and product.Kind == "Express" and isInteger(product.Express) then
		grant.ExpressTokens = product.Express
	end
	info.MarkStarter = product.Once == true and not repeatCase
	info.MarkSeason = product.PerSeason == true and not repeatCase
	return grant, info
end

-- Bullen-Parade verlängern: +15 min, höchstens 60 min ab jetzt (§B10.3)
function Core.ExtendParade(currentUntil: number, now: number): number
	local base = math.max(now, if Util.IsFinite(currentUntil) then currentUntil else 0)
	return math.min(base + PARADE_SECONDS, now + PARADE_CAP)
end

-- Pässe-Faktor: x2 +1, x3 +2 -> 1 / 2 / 3 / 4 (ehrlich "x2 + x3 = x4", nie x6)
function Core.PassFactor(has2x: boolean, has3x: boolean): number
	return 1 + (if has2x then 1 else 0) + (if has3x then 2 else 0)
end

-- Fixe Faktoren: VIP × Club × Roblox Premium (Werte aus Config.Tower.Mult, Rückfall Config.Shop.Fixed)
function Core.FixedFactor(vip: boolean, isClub: boolean, premium: boolean): number
	local factor = 1
	if vip then
		factor *= fixedMult("Vip")
	end
	if isClub then
		factor *= fixedMult("Club")
	end
	if premium then
		factor *= fixedMult("Premium")
	end
	return factor
end

-- Roher Besitz -> wirksamer Besitz (Paket zählt für seine Teile)
function Core.EffectivePasses(raw: { [string]: boolean }): { [string]: boolean }
	local result: { [string]: boolean } = {}
	for _, pass in ipairs(SHOP.GamePasses) do
		result[pass.Key] = raw[pass.Key] == true
	end
	for part, bundles in pairs(BUNDLES_FOR) do
		for _, bundle in ipairs(bundles) do
			if raw[bundle] == true then
				result[part] = true
			end
		end
	end
	return result
end

-- PolicyService-Antwort -> Erlaubnisse (fail-closed: Fehler/fehlendes Feld = NICHT erlaubt)
function Core.ParsePolicy(info: any): Policy
	if type(info) ~= "table" then
		return { Random = false, Trading = false, Subscription = false }
	end
	return {
		Random = info.ArePaidRandomItemsRestricted == false,
		Trading = info.IsPaidItemTradingAllowed == true,
		Subscription = info.IsEligibleToPurchaseSubscription == true,
	}
end

-- Angebots-Regeln §B14.4 (ohne Artikel-Prüfung). Rückgabe (erlaubt, Grund)
function Core.OfferCheck(ctx: OfferCtx): (boolean, string)
	if ctx.Shown >= ctx.Max then
		return false, "MaxPerSession"
	end
	if ctx.Sessions < ctx.MinSession then
		return false, "FirstSession"
	end
	if ctx.SessionSeconds < ctx.MinSeconds then
		return false, "TooEarly"
	end
	if not ctx.TutorialDone then
		return false, "Tutorial"
	end
	if ctx.AdminAbuse then
		return false, "AdminAbuse"
	end
	if ctx.MarketBlocked then
		return false, "MarketWarning"
	end
	return true, "Ok"
end

-- Geschenk-Gate: beide Seiten IsPaidItemTradingAllowed == true (unbekannt = gesperrt), nie an sich selbst
function Core.GiftCheck(
	buyerAllowed: boolean?,
	targetAllowed: boolean?,
	isSelf: boolean,
	targetPresent: boolean
): (boolean, string)
	if isSelf then
		return false, "shop.giftSelfNot"
	end
	if not targetPresent then
		return false, "shop.giftTargetGone"
	end
	if buyerAllowed ~= true or targetAllowed ~= true then
		return false, "shop.giftBlocked"
	end
	return true, "Ok"
end

-- Der eigentliche Beleg-Ablauf mit austauschbarer Umgebung (echte Dienste oder Test-Attrappen).
-- env: FindPlayer(userId), Product(productId), WaitData(p), CurrentData(p), Prepare(p, product),
--      Grant(p, data, product, prepared) -> boolean (darf NICHT yielden), Save(p) -> boolean, Wait(s)
function Core.ProcessReceiptWith(receipt: any, env: any): Enum.ProductPurchaseDecision
	local NOT_YET = Enum.ProductPurchaseDecision.NotProcessedYet
	if type(receipt) ~= "table" then
		return NOT_YET
	end
	local player = env.FindPlayer(receipt.PlayerId)
	if player == nil then
		return NOT_YET -- Roblox versucht es beim nächsten Beitritt erneut
	end
	local product = env.Product(receipt.ProductId)
	if product == nil then
		warn(
			("[MonetizationService] Unbekannte ProductId %s – in Config.Shop.Products eintragen!"):format(
				tostring(receipt.ProductId)
			)
		)
		return NOT_YET -- nie einen Kauf "verschlucken"
	end
	local data = env.WaitData(player)
	if data == nil then
		return NOT_YET
	end
	local purchaseId = tostring(receipt.PurchaseId)
	-- gleicher Kauf läuft schon: warten statt NotProcessedYet (REUSE §7 #25)
	local polls = math.ceil(PROCESSING_WAIT / PROCESSING_POLL)
	for _ = 1, polls do
		if not processing[purchaseId] then
			break
		end
		env.Wait(PROCESSING_POLL)
	end
	if processing[purchaseId] then
		return NOT_YET
	end
	if Core.HasReceipt(data, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	processing[purchaseId] = true
	local okPrepare, prepared = pcall(env.Prepare, player, product)
	local granted = false
	if okPrepare and env.CurrentData(player) == data and not Core.HasReceipt(data, purchaseId) then
		-- ab hier KEIN Yield: gutschreiben + Beleg + RobuxSpent in einem Rutsch (REUSE §7 #26)
		local okGrant, result = pcall(env.Grant, player, data, product, prepared)
		granted = okGrant and result == true
		if not okGrant then
			warn("[MonetizationService] Gutschrift fehlgeschlagen: " .. tostring(result))
		end
		if granted then
			Core.AddReceipt(data, purchaseId, os.time(), if type(product) == "table" then product.Key else nil)
			local purchases = purchasesOf(data)
			local spent = tonumber(receipt.CurrencySpent)
			if spent and Util.IsFinite(spent) and spent > 0 then
				purchases.RobuxSpent += spent
			end
		end
	elseif not okPrepare then
		warn("[MonetizationService] Vorbereitung fehlgeschlagen: " .. tostring(prepared))
	end
	processing[purchaseId] = nil
	if not granted then
		return NOT_YET
	end
	if env.Save(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- Speichern ging nicht: Beleg steht im Spielstand -> nächster Versuch erkennt ihn, nie doppelt
	return NOT_YET
end

-- =====================================================================
-- 5) GAMEPÄSSE & ABO
-- =====================================================================
local function rawHas(p: Player, key: string): boolean
	local passes = owned[p]
	local session = sessionPasses[p]
	return (passes ~= nil and passes[key] == true) or (session ~= nil and session[key] == true)
end

function MonetizationService.HasPass(p: Player, key: string): boolean
	if type(key) ~= "string" then
		return false
	end
	if rawHas(p, key) then
		return true
	end
	local bundles = BUNDLES_FOR[key]
	if bundles then
		for _, bundle in ipairs(bundles) do
			if rawHas(p, bundle) then
				return true -- Tycoon-Paket = Besitz aller drei Teile (§B14.1)
			end
		end
	end
	return false
end

function MonetizationService.PassFactor(p: Player): number
	return Core.PassFactor(MonetizationService.HasPass(p, "Income2x"), MonetizationService.HasPass(p, "Income3x"))
end

function MonetizationService.IsClub(p: Player): boolean
	return club[p] == true or sessionClub[p] == true
end

function MonetizationService.FixedFactor(p: Player): number
	return Core.FixedFactor(MonetizationService.HasPass(p, "VIP"), MonetizationService.IsClub(p), isPremiumMember(p))
end

local function refresh(p: Player)
	if not present(p) then
		return
	end
	call("ShopService", "RefreshPlayer", p) -- Attribute Vip/Club + MarkDirty
	call("TowerService", "Refresh", p) -- Multiplikator-Chip sofort neu (§0.8 Punkt 3: sofort sichtbare Wirkung)
	markDirty(p, "Passes", "Club", "Offers", "Starter")
end

-- Abo-Status vom Marktplatz (pcall, 2 Versuche; Fehler = kein Club, nächster Statuswechsel prüft erneut)
local function fetchClub(p: Player): boolean
	local id = SUB.Id
	if type(id) ~= "string" or id == "" then
		return false
	end
	for attempt = 1, CLUB_ATTEMPTS do
		local ok, info = pcall(MarketplaceService.GetUserSubscriptionStatusAsync, MarketplaceService, p, id)
		if ok then
			return type(info) == "table" and info.IsSubscribed == true
		end
		if attempt < CLUB_ATTEMPTS and p.Parent == Players then
			task.wait(attempt)
		end
	end
	return false
end

function MonetizationService.LoadPasses(p: Player)
	if passesLoaded[p] then
		return
	end
	if loading[p] then
		-- zweiter Aufruf wartet auf den ersten (REUSE §7 #30: kein doppeltes Laden)
		for _ = 1, LOAD_WAIT_STEPS do
			if not loading[p] or p.Parent ~= Players then
				break
			end
			task.wait(0.1)
		end
		return
	end
	loading[p] = true
	local result: { [string]: boolean } = {}
	for _, pass in ipairs(SHOP.GamePasses) do
		if isInteger(pass.Id) and pass.Id > 0 then
			for attempt = 1, PASS_ATTEMPTS do
				local ok, hasPass =
					pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, p.UserId, pass.Id)
				if ok then
					result[pass.Key] = hasPass == true
					break
				end
				if attempt < PASS_ATTEMPTS and p.Parent == Players then
					task.wait(attempt)
				end
			end
		end
	end
	local member = if p.Parent == Players then fetchClub(p) else false
	loading[p] = nil
	if p.Parent ~= Players then
		return
	end
	-- während des Ladens gekaufte Pässe (PromptGamePassPurchaseFinished) nie wieder verlieren
	local early = owned[p]
	if early then
		for key, value in pairs(early) do
			if value == true then
				result[key] = true
			end
		end
	end
	owned[p] = result
	passesLoaded[p] = true
	club[p] = member
	refresh(p)
end

local function onPassPurchased(p: Player, passId: number, purchased: boolean)
	if not purchased or not isInteger(passId) or not present(p) then
		return
	end
	local pass = SHOP.PassesById[passId]
	if pass == nil then
		return
	end
	local passes = owned[p]
	if passes == nil then
		passes = {}
		owned[p] = passes
	end
	passes[pass.Key] = true
	refresh(p)
	notify(p, "shop.passThanks", { itemName(p, pass) }, "Success")
	call("PlayerStateService", "Effect", p, "Confetti", 2, nil)
	call("MetricsService", "Custom", p, "PassBought", pass.Price, { Key = pass.Key })
end

local function onSubscriptionChanged(p: Player, subscriptionId: string)
	if not present(p) or subscriptionId ~= SUB.Id then
		return
	end
	task.spawn(function()
		local before = club[p] == true
		local member = fetchClub(p)
		if not present(p) then
			return
		end
		club[p] = member
		refresh(p)
		if member and not before then
			notify(p, "shop.club.welcome", nil, "Success")
			call("PlayerStateService", "Effect", p, "Confetti", 2, nil)
			call("MetricsService", "Custom", p, "ClubJoined", 1, nil)
		end
	end)
end

-- =====================================================================
-- 6) POLICYSERVICE (einmal je Spieler, pcall, unbekannt/Fehler = eingeschränkt)
-- =====================================================================
local function fetchPolicy(p: Player)
	local info: any = nil
	for attempt = 1, POLICY_ATTEMPTS do
		local ok, result = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, p)
		if ok and type(result) == "table" then
			info = result
			break
		end
		if p.Parent ~= Players then
			return
		end
		if attempt < POLICY_ATTEMPTS then
			task.wait(POLICY_RETRY)
		end
	end
	if p.Parent ~= Players then
		return
	end
	policy[p] = Core.ParsePolicy(info)
	markDirty(p, "RandomAllowed", "TradingAllowed", "Offers")
end

local function ensurePolicy(p: Player)
	if not policyStarted[p] and present(p) then
		policyStarted[p] = true
		task.spawn(fetchPolicy, p) -- nie im Aufrufer yielden
	end
end

-- Wert eines Policy-Felds: Debug-Zwang -> Admin-Override -> bekannt -> nil (Anfrage läuft)
local function policyValue(p: Player, field: string): boolean?
	local debugConfig = Config.Debug
	if type(debugConfig) == "table" and debugConfig.ForceRestricted == true then
		return false
	end
	local override = policyOverride[p]
	if override ~= nil and override[field] ~= nil then
		return override[field]
	end
	local known = policy[p]
	if known ~= nil then
		return (known :: any)[field] == true
	end
	ensurePolicy(p)
	return nil
end

-- höchstens `seconds` auf eine Policy-Antwort warten (yieldet; nur in prepare/Anfrage-Handlern)
local function waitPolicy(p: Player, field: string, seconds: number): boolean?
	local value = policyValue(p, field)
	local steps = math.ceil(seconds / 0.25)
	for _ = 1, steps do
		if value ~= nil or p.Parent ~= Players then
			break
		end
		task.wait(0.25)
		value = policyValue(p, field)
	end
	return value
end

function MonetizationService.RandomAllowed(p: Player): boolean?
	if not present(p) then
		return nil
	end
	return policyValue(p, "Random")
end

function MonetizationService.TradingAllowed(p: Player): boolean
	if not present(p) then
		return false
	end
	return policyValue(p, "Trading") == true
end

local OVERRIDE_FIELDS: { [string]: { Field: string, Invert: boolean } } = {
	Random = { Field = "Random", Invert = false },
	RandomAllowed = { Field = "Random", Invert = false },
	ArePaidRandomItemsRestricted = { Field = "Random", Invert = true },
	Trading = { Field = "Trading", Invert = false },
	TradingAllowed = { Field = "Trading", Invert = false },
	IsPaidItemTradingAllowed = { Field = "Trading", Invert = false },
	Subscription = { Field = "Subscription", Invert = false },
	IsEligibleToPurchaseSubscription = { Field = "Subscription", Invert = false },
}

function MonetizationService.SetPolicyOverride(p: Player, field: string, value: boolean?)
	if typeof(p) ~= "Instance" or not p:IsA("Player") then
		return
	end
	local rawField: any = field
	local rawValue: any = value
	-- CC-Form SetPolicyOverride(p, allowed?) = Zufallsitems
	if type(rawField) == "boolean" or rawField == nil then
		rawValue = rawField
		rawField = "Random"
	end
	if rawValue ~= nil and type(rawValue) ~= "boolean" then
		return
	end
	local targets: { { Field: string, Invert: boolean } } = {}
	if rawField == "All" then
		targets = {
			{ Field = "Random", Invert = false },
			{ Field = "Trading", Invert = false },
			{ Field = "Subscription", Invert = false },
		}
	elseif type(rawField) == "string" and OVERRIDE_FIELDS[rawField] then
		targets = { OVERRIDE_FIELDS[rawField] }
	else
		warn("[MonetizationService] SetPolicyOverride: unbekanntes Feld " .. tostring(rawField))
		return
	end
	local entry = policyOverride[p] or {}
	for _, target in ipairs(targets) do
		if rawValue == nil then
			entry[target.Field] = nil
		elseif target.Invert then
			entry[target.Field] = not rawValue
		else
			entry[target.Field] = rawValue
		end
	end
	policyOverride[p] = if next(entry) ~= nil then entry else nil
	markDirty(p, "RandomAllowed", "TradingAllowed", "Offers")
end

-- =====================================================================
-- 7) PRODUKTE GUTSCHREIBEN (alles Yieldende in prepare, Gutschrift ohne Yield)
-- =====================================================================
-- Bau-Gutscheine rechnen mit dem Dauer-Einkommen: kommt der Beleg direkt beim Beitritt (offener Kauf aus der
-- letzten Sitzung), erst Pässe/Turm-Einkommen abwarten (höchstens READY_WAIT s) – sonst gäbe es nur den Mindestwert.
local function waitSteady(p: Player): number
	local steady = steadyOf(p)
	for _ = 1, math.ceil(READY_WAIT / 0.25) do
		if p.Parent ~= Players then
			break
		end
		local okReady, ready = call("PlayerStateService", "IsReady", p)
		if steady > 0 and (not okReady or ready == true) then
			break
		end
		task.wait(0.25)
		steady = steadyOf(p)
	end
	return steady
end

local function usesVouchers(product: any): boolean
	local again = product.Repeat
	return product.Kind == "Voucher"
		or type(product.Vouchers) == "table"
		or (type(again) == "table" and type(again.Vouchers) == "table")
end

local function prepare(p: Player, product: any): { [string]: any }
	local prepared: { [string]: any } = {
		SeasonId = currentSeasonId(),
		Steady = if usesVouchers(product) then waitSteady(p) else steadyOf(p),
		Premium = if product.Kind == "Season" then seasonPremiumOf(p) else false,
		RandomAllowed = nil,
		Gift = nil,
	}
	if product.Random == true then
		-- Policy-Antwort abwarten (höchstens 10 s), danach gilt: unbekannt = eingeschränkt
		prepared.RandomAllowed = waitPolicy(p, "Random", POLICY_WAIT)
	end
	if product.Gift == true then
		local hold = giftTarget[p]
		local target = if hold and hold.Until >= os.time() then Players:GetPlayerByUserId(hold.UserId) else nil
		if target and target ~= p then
			local buyerOk = waitPolicy(p, "Trading", POLICY_WAIT)
			local targetOk = waitPolicy(target, "Trading", POLICY_WAIT)
			local ok = Core.GiftCheck(buyerOk, targetOk, false, target.Parent == Players)
			if ok then
				prepared.Gift = target
			end
		end
	end
	return prepared
end

local function plotOf(p: Player): number?
	local ok, plot = call("PlotService", "PlotOf", p)
	return if ok and isInteger(plot) then plot else nil
end

local function markAllDirty(...: string)
	for _, other in ipairs(Players:GetPlayers()) do
		markDirty(other, ...)
	end
end

-- Bullen-Parade: ×1,5 für alle (TowerService), Show + Dank-Banner (EventService, sonst Effekt direkt) – EIN Weg
local function grantParade(p: Player): boolean
	local tower = service("TowerService")
	if tower == nil or type(tower.SetServerBoost) ~= "function" then
		return false -- später erneut (Kauf bleibt offen)
	end
	local t = os.time()
	local untilT = Core.ExtendParade(paradeUntil, t)
	local seconds = untilT - t
	local okBoost, err = pcall(tower.SetServerBoost, "Parade", paradeMult(), seconds)
	if not okBoost then
		warn("[MonetizationService] Bullen-Parade: " .. tostring(err))
		return false
	end
	paradeUntil = untilT
	local okEvent = call("EventService", "StartParade", p, seconds)
	if not okEvent then
		call(
			"PlayerStateService",
			"EffectAll",
			"BullParade",
			1,
			{ Seconds = seconds, UserId = p.UserId, Until = untilT },
			nil
		)
	end
	markAllDirty("Offers")
	return true
end

local function grantFireworks(p: Player): boolean
	local okEvent = call("EventService", "StartFireworks", p)
	if not okEvent then
		call(
			"PlayerStateService",
			"EffectAll",
			"Fireworks",
			1,
			{ Seconds = FIREWORK_SECONDS, UserId = p.UserId, Plot = plotOf(p) },
			nil
		)
	end
	return true
end

-- Rückmeldung nach einer Gewährung (kein Yield, eine Meldung je Ereignis)
local function feedback(p: Player, product: any, grant: { [string]: any }, info: { [string]: any }, receiver: Player)
	local credited = if isInteger(grant.Credits) then grant.Credits else 0
	if product.Kind == "Gift" then
		if receiver ~= p then
			notify(p, "shop.giftSent", { receiver.DisplayName }, "Success")
			notify(receiver, "shop.giftReceived", { p.DisplayName }, "Success")
			call("PlayerStateService", "Effect", receiver, "Confetti", 1, nil)
		else
			notify(p, "shop.giftSelf", nil, "Info")
		end
	elseif info.Repeat and product.Kind == "Starter" then
		notify(p, "shop.starterRepeat", { credits(p, credited) }, "Info")
	elseif info.Repeat and product.Kind == "Season" then
		notify(p, "shop.seasonRepeat", { credits(p, credited) }, "Info")
	elseif product.Kind == "Voucher" then
		notify(p, "shop.voucherGranted", { credits(p, credited), itemName(p, product) }, "Success")
	else
		notify(p, "shop.thanks", { itemName(p, product) }, "Success")
	end
	call("PlayerStateService", "Effect", p, "Confetti", 1, nil)
end

-- Gutschrift eines Produkts – yieldet NIE (§C11.1). true = komplett gutgeschrieben.
local function grantProduct(p: Player, data: any, product: any, prepared: any): boolean
	local shopService = service("ShopService")
	if shopService == nil or type(shopService.Grant) ~= "function" then
		return false -- später erneut (Kauf bleibt offen)
	end
	local kind = product.Kind
	if kind == "Parade" then
		if not grantParade(p) then
			return false
		end
		notify(p, "shop.thanks", { itemName(p, product) }, "Success")
		return true
	elseif kind == "Fireworks" then
		grantFireworks(p)
		notify(p, "shop.thanks", { itemName(p, product) }, "Success")
		return true
	end
	local ctx = {
		SeasonId = if type(prepared) == "table" then prepared.SeasonId else currentSeasonId(),
		Steady = if type(prepared) == "table" then prepared.Steady else 0,
		Now = os.time(),
		RandomAllowed = if type(prepared) == "table" then prepared.RandomAllowed else nil,
		Premium = type(prepared) == "table" and prepared.Premium == true,
	}
	local grant, info = Core.BuildGrant(product, data, ctx)
	local receiver = p
	if kind == "Gift" and type(prepared) == "table" then
		local target = prepared.Gift
		if
			typeof(target) == "Instance"
			and target ~= p
			and target.Parent == Players
			and dataOf(target :: Player) ~= nil
		then
			receiver = target :: Player
		end
	end
	if next(grant) ~= nil and not shopService.Grant(receiver, grant, "Robux:" .. tostring(product.Key)) then
		return false
	end
	local purchases = purchasesOf(data)
	if info.MarkStarter then
		purchases.Starter = true
	end
	if info.MarkSeason then
		purchases.PassSeasons[tostring(ctx.SeasonId)] = true
	end
	if kind == "Gift" then
		giftTarget[p] = nil
		if receiver ~= p then
			purchases.Gifts += 1
		end
	end
	feedback(p, product, grant, info, receiver)
	call("MetricsService", "Custom", p, "ProductBought", product.Price, { Key = product.Key })
	markDirty(p, "Offers", "Starter")
	return true
end

local function waitForData(p: Player): any
	local dataService = service("DataService")
	if dataService == nil then
		return nil
	end
	for _ = 1, math.ceil(PROFILE_WAIT / PROFILE_POLL) do
		if p.Parent ~= Players then
			return nil
		end
		local data = dataService.Get(p)
		if data ~= nil then
			return data
		end
		task.wait(PROFILE_POLL)
	end
	return nil
end

local function realEnv(productLookup: (id: any) -> any): any
	return {
		FindPlayer = function(userId: any): Player?
			return if isInteger(userId) then Players:GetPlayerByUserId(userId) else nil
		end,
		Product = productLookup,
		WaitData = waitForData,
		CurrentData = dataOf,
		Prepare = prepare,
		Grant = grantProduct,
		Save = function(p: Player): boolean
			local dataService = service("DataService")
			if dataService == nil then
				return false
			end
			local ok, saved = pcall(dataService.Save, p)
			return ok and saved == true
		end,
		Wait = function(seconds: number)
			task.wait(seconds)
		end,
	}
end

local RECEIPT_ENV = realEnv(function(id: any): any
	return if isInteger(id) and id > 0 then SHOP.ProductsById[id] else nil
end)

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local ok, decision = pcall(Core.ProcessReceiptWith, receipt, RECEIPT_ENV)
	if ok then
		return decision
	end
	warn("[MonetizationService] ProcessReceipt Fehler: " .. tostring(decision))
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- =====================================================================
-- 8) ADMIN-SIMULATION (gleiche Gutschrift wie ein echter Kauf, auch mit Id = 0)
-- =====================================================================
-- purchaseId (optional, nur SelfTest/Admin): feste Beleg-Id, um die Idempotenz live zu prüfen (gleiche Id = eine Gewährung)
function MonetizationService.SimulatePurchase(p: Player, productKey: string, purchaseId: string?): (boolean, string)
	if not present(p) then
		return false, "Spieler nicht im Spiel"
	end
	if type(productKey) ~= "string" then
		return false, "Produkt-Key fehlt"
	end
	local pass = SHOP.PassesByKey[productKey]
	if pass then
		local session = sessionPasses[p]
		if session == nil then
			session = {}
			sessionPasses[p] = session
		end
		session[pass.Key] = true
		refresh(p)
		notify(p, "shop.simulated", { itemName(p, pass) }, "Info")
		return true, "Pass " .. pass.Key .. " für diese Sitzung aktiv"
	end
	if productKey == CLUB_KEY then
		sessionClub[p] = true
		refresh(p)
		notify(p, "shop.simulated", { itemName(p, SUB) }, "Info")
		return true, "Vorstands-Club für diese Sitzung aktiv"
	end
	local product = SHOP.ProductsByKey[productKey]
	if product == nil then
		return false, "Unbekanntes Produkt " .. productKey
	end
	local env = realEnv(function(_id: any): any
		return product
	end)
	local receipt = {
		PlayerId = p.UserId,
		ProductId = product.Id,
		PurchaseId = if type(purchaseId) == "string"
				and purchaseId ~= ""
				and #purchaseId <= 64
			then purchaseId
			else "SIM-" .. HttpService:GenerateGUID(false),
		CurrencySpent = 0,
	}
	local ok, decision = pcall(Core.ProcessReceiptWith, receipt, env)
	if ok and decision == Enum.ProductPurchaseDecision.PurchaseGranted then
		return true, "Kauf simuliert: " .. productKey
	end
	return false, "Simulation nicht gutgeschrieben (" .. tostring(decision) .. ")"
end

function MonetizationService.ParadeUntil(): number
	return paradeUntil
end

-- =====================================================================
-- 9) BAU-GUTSCHEIN-ANGEBOT (10 min gültig, fester Ablauf; Gewährung max(Angebot, Neuberechnung))
-- =====================================================================
local function pruneQuotes(purchases: any, now: number)
	for key, entry in pairs(purchases.Quote) do
		local product = SHOP.ProductsByKey[key]
		if
			type(entry) ~= "table"
			or product == nil
			or product.Kind ~= "Voucher"
			or not Util.IsFinite(entry.Until)
			or entry.Until <= now
		then
			purchases.Quote[key] = nil
		end
	end
end

function MonetizationService.Quote(p: Player, productKey: string): (number?, number?)
	local product = if type(productKey) == "string" then SHOP.ProductsByKey[productKey] else nil
	if product == nil or product.Kind ~= "Voucher" then
		return nil, nil
	end
	local data = dataOf(p)
	if data == nil then
		return nil, nil
	end
	local t = os.time()
	local purchases = purchasesOf(data)
	pruneQuotes(purchases, t)
	local fresh = SHOP.VoucherCredits(product, steadyOf(p))
	local existing = Core.QuoteFor(data, productKey, t)
	if existing ~= nil then
		-- Ablauf bleibt fest (kein Neustart); die Zahl steigt mit, sinkt aber nie
		local entry = purchases.Quote[productKey]
		entry.Credits = math.max(existing, fresh)
		markDirty(p, "Offers")
		return entry.Credits, entry.Until
	end
	local untilT = t + QUOTE_SECONDS
	purchases.Quote[productKey] = { Credits = fresh, Until = untilT }
	markDirty(p, "Offers")
	return fresh, untilT
end

-- =====================================================================
-- 10) KAUF-VORPRÜFUNG (ShopPrecheck): Policy, Empfänger, Besitz – vor Prompt…Purchase (darf yielden)
-- =====================================================================
local function seasonTierInfo(data: any): (number, number)
	local seasonCfg = Config.Season
	local seasons = type(seasonCfg) == "table" and seasonCfg.Seasons or nil
	local id = currentSeasonId()
	local entry: any = nil
	if type(seasons) == "table" then
		for _, s in ipairs(seasons) do
			if type(s) == "table" and s.Id == id then
				entry = s
			end
		end
		entry = entry or seasons[#seasons]
	end
	local tiers = if entry and isInteger(entry.Tiers) then entry.Tiers else 50
	local tierXp = if entry and Util.IsFinite(entry.TierXp) and entry.TierXp > 0 then entry.TierXp else 1000
	local season = type(data) == "table" and data.Season or nil
	if type(season) ~= "table" or season.Id ~= id or not Util.IsFinite(season.Xp) then
		return 0, tiers -- neue Saison: Stufe 0
	end
	return math.clamp(math.floor(season.Xp / tierXp), 0, tiers), tiers
end

local function expressRoom(data: any): boolean
	local tower = type(data) == "table" and data.Tower or nil
	if type(tower) ~= "table" then
		return false
	end
	local build = tower.Build
	if type(build) == "table" and build.Floor ~= nil then
		return true -- laufende Baustelle: wird direkt verkürzt
	end
	local buildCfg = type(Config.Tower) == "table" and Config.Tower.Build or nil
	local maxTokens = if type(buildCfg) == "table" and isInteger(buildCfg.ExpressMax) then buildCfg.ExpressMax else 50
	local tokens = if type(tower.Express) == "table" then #tower.Express else 0
	return tokens < maxTokens
end

function MonetizationService.Precheck(p: Player, key: string, userId: number?): Reply
	if not present(p) then
		return { Ok = false }
	end
	local item, kind = itemOf(key)
	if item == nil or kind == nil then
		return fail(p, "shop.unknown")
	end
	if isDisabled(key) then
		return fail(p, "shop.disabled")
	end
	local studio = RunService:IsStudio()
	local data = dataOf(p)
	if data == nil then
		return fail(p, "core.loading")
	end
	if kind == "Pass" then
		if not (isInteger(item.Id) and item.Id > 0) then
			return fail(p, "shop.notSetUp")
		end
		if MonetizationService.HasPass(p, key) then
			return fail(p, if rawHas(p, key) then "shop.owned" else "shop.passInBundle")
		end
		if type(item.Includes) == "table" then
			local missing = 0
			for _, part in ipairs(item.Includes) do
				if not MonetizationService.HasPass(p, part) then
					missing += 1
				end
			end
			if missing == 0 then
				return fail(p, "shop.bundleAllOwned")
			end
		end
		return { Ok = true, Kind = "Pass", Id = item.Id }
	elseif kind == "Subscription" then
		if type(SUB.Id) ~= "string" or SUB.Id == "" then
			return fail(p, "shop.notSetUp")
		end
		if MonetizationService.IsClub(p) then
			return fail(p, "shop.club.already")
		end
		if waitPolicy(p, "Subscription", PRECHECK_POLICY_WAIT) ~= true then
			return fail(p, "shop.restricted")
		end
		return { Ok = true, Kind = "Subscription", Id = SUB.Id }
	end
	-- Developer Product. Id 0 wird erst NACH allen anderen Prüfungen gemeldet, damit Studio-Tests (Policy simulieren,
	-- Geschenk-Gate, Lager voll …) den echten Weg sehen; danach Hinweis auf Admin "Kauf simulieren".
	local configuredId = isInteger(item.Id) and item.Id > 0
	local function notConfigured(): Reply
		return fail(p, if studio then "shop.studioSim" else "shop.notSetUp")
	end
	if not configuredId and not studio then
		return notConfigured()
	end
	if item.Random == true and waitPolicy(p, "Random", PRECHECK_POLICY_WAIT) ~= true then
		return fail(p, "shop.restricted")
	end
	local purchases = purchasesOf(data)
	local productKind = item.Kind
	-- fehlt ein Besitzer-Dienst für die Gewährung, würde der Kauf bis zum nächsten Beitritt offen bleiben
	local provisional = Core.BuildGrant(item, data, {
		SeasonId = currentSeasonId(),
		Steady = 0,
		Now = os.time(),
		RandomAllowed = false,
		Premium = false,
	})
	local okMissing, missing = call("ShopService", "MissingFor", provisional)
	if not okMissing or missing ~= nil then
		return fail(
			p,
			if productKind == "Season" or productKind == "Tiers" then "shop.seasonOffline" else "shop.serviceMissing"
		)
	end
	if productKind == "Season" then
		if seasonPremiumOf(p) then
			return fail(p, "shop.seasonOwned")
		end
	elseif productKind == "Tiers" then
		local tier, tiers = seasonTierInfo(data)
		if tier >= tiers then
			return fail(p, "shop.tiersFull")
		end
		-- nie Stufen verkaufen, die es nicht mehr gibt (ehrlich: lieber das kleinere Paket empfehlen)
		local wanted = if type(item.Grant) == "table" and isInteger(item.Grant.SeasonTiers)
			then item.Grant.SeasonTiers
			else 1
		if tier + wanted > tiers then
			return fail(p, "shop.tiersTooMany", tiers - tier)
		end
	elseif productKind == "Express" then
		if not expressRoom(data) then
			return fail(p, "shop.expressFull")
		end
	elseif productKind == "Parade" then
		if not has("TowerService", "SetServerBoost") then
			return fail(p, "shop.serviceMissing")
		end
	elseif productKind == "Gift" then
		if not isInteger(userId) then
			return fail(p, "shop.giftPick")
		end
		local target = Players:GetPlayerByUserId(userId :: number)
		local isSelf = userId == p.UserId
		local targetPresent = target ~= nil and target.Parent == Players and dataOf(target :: Player) ~= nil
		local buyerOk = waitPolicy(p, "Trading", PRECHECK_POLICY_WAIT)
		local targetOk = if target and not isSelf
			then waitPolicy(target :: Player, "Trading", PRECHECK_POLICY_WAIT)
			else false
		local ok, reason = Core.GiftCheck(buyerOk, targetOk, isSelf, targetPresent)
		if not ok then
			return fail(p, reason)
		end
		giftTarget[p] = { UserId = userId :: number, Until = os.time() + GIFT_HOLD }
		if not configuredId then
			return notConfigured()
		end
		return {
			Ok = true,
			Kind = "Product",
			Id = item.Id,
			Gift = { UserId = userId, Name = (target :: Player).DisplayName },
		}
	end
	if not configuredId then
		return notConfigured()
	end
	return { Ok = true, Kind = "Product", Id = item.Id, Repeat = item.Once == true and purchases.Starter == true }
end

-- =====================================================================
-- 11) ANGEBOTE (§B14.4, Muss-Regel 17)
-- =====================================================================
local function offerContext(p: Player, data: any): OfferCtx
	local flags = type(data.Flags) == "table" and data.Flags or {}
	local okAbuse, abuse = call("EventService", "IsAdminAbuse")
	local started = sessionStart[p]
	return {
		Shown = offersShown[p] or 0,
		Max = MAX_OFFERS,
		Sessions = if isInteger(data.Sessions) then data.Sessions else 0,
		MinSession = OFFER_MIN_SESSION,
		SessionSeconds = if started then os.clock() - started else 0,
		MinSeconds = OFFER_MIN_SECONDS,
		TutorialDone = flags.Done == true,
		AdminAbuse = okAbuse and abuse == true,
		MarketBlocked = os.time() < marketBlockUntil,
	}
end

-- Lohnt sich das Angebot für diesen Spieler überhaupt? (nichts Besessenes, nichts Gesperrtes, eingerichtet)
local function offerItemOk(p: Player, key: string, data: any): boolean
	local item, kind = itemOf(key)
	if item == nil or kind == nil or isDisabled(key) then
		return false
	end
	local configured = if kind == "Subscription"
		then type(SUB.Id) == "string" and SUB.Id ~= ""
		else isInteger(item.Id) and item.Id > 0
	if not configured and not RunService:IsStudio() then
		return false
	end
	local purchases = purchasesOf(data)
	if kind == "Pass" then
		if MonetizationService.HasPass(p, key) then
			return false
		end
		if type(item.Includes) == "table" then
			for _, part in ipairs(item.Includes) do
				if MonetizationService.HasPass(p, part) then
					return false -- Teil schon da: die Karte empfiehlt Einzelkäufe, kein Popup
				end
			end
		end
		return true
	elseif kind == "Subscription" then
		return not MonetizationService.IsClub(p) and policyValue(p, "Subscription") == true
	end
	if item.Once == true then
		return purchases.Starter ~= true and purchases.StarterOfferedAt <= 0
	end
	if item.PerSeason == true then
		return purchases.PassSeasons[tostring(currentSeasonId())] ~= true and not seasonPremiumOf(p)
	end
	return item.Random ~= true
end

function MonetizationService.TryOffer(p: Player, offerKey: string): boolean
	if not present(p) or type(offerKey) ~= "string" then
		return false
	end
	local data = dataOf(p)
	if data == nil then
		return false
	end
	local ok = Core.OfferCheck(offerContext(p, data))
	if not ok or not offerItemOk(p, offerKey, data) then
		return false
	end
	local item = itemOf(offerKey)
	if type(item) == "table" and item.Once == true then
		purchasesOf(data).StarterOfferedAt = os.time() -- Starter-Angebot genau einmal je Konto
	end
	offersShown[p] = (offersShown[p] or 0) + 1
	offerSerial += 1
	offerState[p] = { Key = offerKey, Id = offerSerial, At = os.time() }
	markDirty(p, "Offers", "Starter")
	call("MetricsService", "Custom", p, "OfferShown", 1, { Key = offerKey })
	return true
end

-- automatisches Angebot nach einem positiven Moment: erstes passendes aus Config.Shop.OfferOrder
local function autoOffer(p: Player)
	if not present(p) or (offersShown[p] or 0) >= MAX_OFFERS then
		return
	end
	for _, key in ipairs(SHOP.OfferOrder or {}) do
		if MonetizationService.TryOffer(p, key) then
			return
		end
	end
end

-- =====================================================================
-- 12) STATE-SCHLÜSSEL (§C10; nie nil für "leer")
-- =====================================================================
local function voucherPreview(p: Player): { [string]: number }
	local steady = steadyOf(p)
	local preview: { [string]: number } = {}
	for _, product in ipairs(SHOP.Products) do
		if product.Kind == "Voucher" then
			preview[product.Key] = SHOP.VoucherCredits(product, steady)
		end
	end
	return preview
end

local function offersState(p: Player): { [string]: any }
	local data = dataOf(p)
	local t = os.time()
	local quotes: { [string]: any } = {}
	local claimDay, gifts = 0, 0
	local passSeasons: { [string]: boolean } = {}
	if data ~= nil then
		local purchases = purchasesOf(data)
		for _, product in ipairs(SHOP.Products) do
			if product.Kind == "Voucher" then
				local quoted = Core.QuoteFor(data, product.Key, t)
				if quoted ~= nil then
					quotes[product.Key] = { Credits = quoted, Until = purchases.Quote[product.Key].Until }
				end
			end
		end
		claimDay = purchases.ClubClaimDay
		gifts = purchases.Gifts
		passSeasons = purchases.PassSeasons
	end
	local offer = offerState[p]
	local hold = giftTarget[p]
	return {
		Pending = if offer then offer.Key else "",
		Id = if offer then offer.Id else 0,
		Shown = offersShown[p] or 0,
		Max = MAX_OFFERS,
		Quotes = quotes,
		Preview = voucherPreview(p),
		QuoteSeconds = QUOTE_SECONDS,
		ClubEligible = policyValue(p, "Subscription") == true,
		ClubClaimDay = claimDay,
		Today = Util.UtcDay(),
		Gifts = gifts,
		Gift = if hold and hold.Until >= t then { UserId = hold.UserId, Until = hold.Until } else false,
		Parade = paradeUntil,
		Season = currentSeasonId(),
		PassSeasons = passSeasons,
		SeasonPremium = seasonPremiumOf(p),
		Disabled = if type(SHOP.Disabled) == "table" then SHOP.Disabled else {},
	}
end

local function registerState()
	local stateService = service("PlayerStateService")
	if stateService == nil or type(stateService.Provide) ~= "function" then
		warn("[MonetizationService] PlayerStateService fehlt – kein Shop-State")
		return
	end
	stateService.Provide("Passes", function(p: Player)
		local result: { [string]: boolean } = {}
		for _, pass in ipairs(SHOP.GamePasses) do
			result[pass.Key] = MonetizationService.HasPass(p, pass.Key)
		end
		return result
	end)
	stateService.Provide("Club", function(p: Player)
		return MonetizationService.IsClub(p)
	end)
	stateService.Provide("Boosts", function(p: Player)
		local data = dataOf(p)
		local boosts = data and data.Boosts
		local function seconds(key: string): number
			local value = if type(boosts) == "table" then boosts[key] else nil
			return if Util.IsFinite(value) and value > 0 then value else 0
		end
		return { X2 = seconds("X2"), X5 = seconds("X5"), Bull = seconds("Bull") }
	end)
	stateService.Provide("Offers", offersState)
	stateService.Provide("RandomAllowed", function(p: Player)
		return MonetizationService.RandomAllowed(p) == true -- unbekannt = eingeschränkt (false), nie nil
	end)
	stateService.Provide("TradingAllowed", function(p: Player)
		return MonetizationService.TradingAllowed(p)
	end)
	stateService.Provide("Starter", function(p: Player)
		local data = dataOf(p)
		if data == nil then
			return { Bought = false, Offered = false, Eligible = false }
		end
		local purchases = purchasesOf(data)
		local sessions = if isInteger(data.Sessions) then data.Sessions else 0
		return {
			Bought = purchases.Starter == true,
			Offered = purchases.StarterOfferedAt > 0,
			Eligible = sessions >= OFFER_MIN_SESSION,
		}
	end)
end

-- =====================================================================
-- 13) INIT / START
-- =====================================================================
local function onPlayerRemoving(p: Player)
	owned[p] = nil
	loading[p] = nil
	passesLoaded[p] = nil
	sessionPasses[p] = nil
	club[p] = nil
	sessionClub[p] = nil
	policy[p] = nil
	policyStarted[p] = nil
	policyOverride[p] = nil
	offersShown[p] = nil
	offerState[p] = nil
	sessionStart[p] = nil
	giftTarget[p] = nil
end

local function onPlayerAdded(p: Player)
	sessionStart[p] = os.clock()
	ensurePolicy(p) -- Policy schon beim Beitritt anfragen (PlayerStateService ruft RandomAllowed zusätzlich)
end

function MonetizationService.Init(services: any)
	Services = services
	registerState()
end

function MonetizationService.Start()
	-- §C11.1 #1: früh setzen (ohne Callback quittiert Roblox Käufe automatisch -> verloren)
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(onPassPurchased)
	Players.UserSubscriptionStatusChanged:Connect(onSubscriptionChanged)
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end
	-- Crash/Rally-Warnung -> eine Weile kein Angebot (Muss-Regel 17)
	call("MarketService", "OnNews", function(news: any)
		if type(news) == "table" and MARKET_BLOCK_KINDS[tostring(news.Kind)] then
			marketBlockUntil = math.max(marketBlockUntil, os.time() + MARKET_BLOCK)
		end
	end)
	-- positiver Moment (Stufen-Morph) -> kurz danach höchstens ein Angebot (Callback yieldet nie)
	call("TowerService", "OnStageUp", function(p: Player, _stage: number)
		if present(p) and (offersShown[p] or 0) < MAX_OFFERS then
			task.delay(OFFER_DELAY, autoOffer, p)
		end
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">OrderService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Orders, Depot, Strategie-Bots, Gewinn-Transfer-Regeln, Liga-Statistik (Server/Services/OrderService)
--  Besitzer: WP4 (Orders, Depot, Bots – EINZIGER Depot-Schreiber). Vertrag: DESIGN.md §C5.4, §C9 (Trade*, Alert*,
--  Bot*, DepotHistory, TutorialTrade), §C10 (State Depot, League), §B7.3, §B8, §B11.1, §C11.4; MARKET.md §11–§13.
--
--  Firewall (§C11.4): dieses Modul kennt kein Turm-Geld. Gewinn-Transfers verlassen das Depot als AKY-Cent
--  (Withdraw); umrechnen und gutschreiben macht der Turm (WP6). Zur Laufzeit nur erlaubte Dienste:
--  DataService, PlayerStateService, MarketService, ProgressionService (TradingPerks/LicenceDef/Licence),
--  AdminService (OwnerTradeBlocked), MetricsService, AntiCheatService – alle per pcall, alle optional.
--
--  Ablauf:
--    * Beitritt: Depot reparieren (Portfolio.Sanitize) -> Lizenz-Basis abgleichen -> Offline-Abgleich im Hintergrund
--      (CatchUp, Orders 24 h, Bots 12 h, Dividenden, Auto-Transfers) -> "live". Während des Abgleichs sind
--      Handels-Anfragen gesperrt (trade.syncing), danach laufen alle Ticks über OrderEngine.Step (wie offline).
--    * Live: MarketService.OnTick(t) -> je bereitem Spieler Step(t) direkt nach PriceEngine.Step (Dividenden des
--      Ex-Ticks vor jeder Anfrage zum neuen Quote; Sofort-Orders laufen zum Quote des verarbeiteten Ticks).
--    * Glocke (t % 1200 == 0, in Step): Tagesrendite, Liga, Bot-Lohn, Auto-Transfer in Depot.Pending, dann OnBell(p)
--      -> der Turm holt Pending über Withdraw(p, "Bell") ab.
--
--  Öffentliche API (§C5.4):
--    OrderService.Depot(p): Types.Depot?                 nur lesen
--    OrderService.Nav(p): number                         Cent
--    OrderService.Withdrawable(p): (number, boolean, string?)   Cent, jetzt erlaubt, Grund-Schlüssel wenn nicht
--    OrderService.Withdraw(p, reason): (number, string?) "Manual" | "Bell" | "Offline" – bucht ab, gibt Cent zurück
--    OrderService.SetLicence(p, idx)                     Cash/Basis um die Basis-Differenz anpassen (Fluss)
--    OrderService.AdminCredit(p, cents): boolean         Cash + Basis (nie abhebbar); negativ = Admin-Abzug; taintet
--    OrderService.TaintWeek(p, reason)
--    OrderService.HoldsShares(p, i): number
--    OrderService.LeagueStats(p): Types.LeagueStats
--    OrderService.CatchUpReport(p): { Fills, Dividends, Bots = { { Preset, Pct } }, Alerts }?
--    OrderService.OnTrade(cb(p, FillInfo)) · OnDayResult(cb(p, DayResult)) · OnBell(cb(p))
--    OrderService.TutorialState(p): "None" | "Running" | "Done"
--  Request-Handler: TradePlace, TradeCancel, TradeModify, TradeBasket, TradeRefill, TradeAuto, TradeWatch,
--    AlertSet, AlertRemove, BotSet, BotToggle, DepotHistory, TutorialTrade
--  State: Depot, League. Effekt: ReadWell. Remotes: Replay (ACAD-Übung), Market "DayClose" (FireClient).
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))
local Clock = require(Shared:WaitForChild("Clock"))
local MarketShared = Shared:WaitForChild("Market")
local PortfolioMath = require(MarketShared:WaitForChild("PortfolioMath"))
local MarketFolder = script.Parent.Parent:WaitForChild("Market")
local Portfolio = require(MarketFolder:WaitForChild("Portfolio"))
local OrderEngine = require(MarketFolder:WaitForChild("OrderEngine"))
local BotEngine = require(MarketFolder:WaitForChild("BotEngine"))
local CatchUp = require(MarketFolder:WaitForChild("CatchUp"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

-- Replay-Kodierung (WP3, Shared/Market/QuoteCodec) – optional; ohne Modul kodieren wir die 9 Byte selbst
local QuoteCodec: any = nil
do
	local module = MarketShared:FindFirstChild("QuoteCodec")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			QuoteCodec = result
		end
	end
end

local OrderService = {}
local Services: any = nil

type Reply = Types.Reply
type Depot = { [string]: any }
type Env = OrderEngine.Env
type Lic = OrderEngine.Lic

local DAY = Clock.DAY_TICKS
local LIVE_LAG = 0 -- Tick t wird direkt in OnTick(t) verarbeitet (nach PriceEngine.Step, vor jeder Anfrage zum Quote t)
local LIVE_GAP_MAX = 120 -- größere Lücke (Hänger) -> Abgleich im Hintergrund statt synchron
local CACHE_SAFETY = 120 -- Minuten-Caches nur für Ticks, die mindestens so alt sind (späte Bus-Events)
local PERKS_SECONDS = 5
local IDS_SECONDS = 10
local MAX_PENDING_EVENTS = 100
local MAX_PENDING_DAYS = 72
local MAX_NUMBER_ARG = 1e12
local MAX_PRICE_ARG = 1e9
local INVALID_LOG_EVERY = 10
local MARKET_WAIT = 90 -- s: so lange wartet der Offline-Abgleich beim Beitritt auf den bootenden Markt
local MAX_MONEY = 9e15

-- Pro-Spieler-Zustand (alles wird bei PlayerRemoving geleert)
local live: { [Player]: boolean } = {}
local syncing: { [Player]: boolean } = {}
local replies: { [Player]: { [number]: Reply } } = {}
local reports: { [Player]: { [string]: any } } = {}
local tutorials: { [Player]: { [string]: any } } = {}
local lossTimes: { [Player]: { number } } = {}
local spam: { [Player]: { Window: number, Count: number, Flagged: boolean } } = {}
local perksCache: { [Player]: { At: number, Lic: Lic, Perks: { [string]: any } } } = {}
local pendingLicence: { [Player]: number } = {}
local dirty: { [Player]: { [string]: boolean } } = {}
local ownerOf: { [any]: Player } = {} -- Depot-Tabelle -> Spieler (Metriken)

local tradeCallbacks: { (Player, Types.FillInfo) -> () } = {}
local dayCallbacks: { (Player, Types.DayResult) -> () } = {}
local bellCallbacks: { (Player) -> () } = {}
local errorAt: { [string]: number } = {}

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function logError(source: string, err: any)
	local now = os.clock()
	if now - (errorAt[source] or -math.huge) >= INVALID_LOG_EVERY then
		errorAt[source] = now
		warn(("[OrderService] %s: %s"):format(source, tostring(err)))
	end
end

local function trading(): { [string]: any }
	local t = Config.Trading
	return if type(t) == "table" then t else {}
end

local function num(v: any, fallback: number): number
	if Util.IsFinite(v) then
		return v
	end
	return fallback
end

local function isInt(v: any): boolean
	return Util.IsFinite(v) and v % 1 == 0
end

-- Optionaler Dienst-Aufruf: (ok, ...) – nie ein Fehler nach außen
local function call(serviceName: string, fnName: string, ...: any): (boolean, ...any)
	local s = Services and Services[serviceName]
	local fn = s and s[fnName]
	if type(fn) ~= "function" then
		return false
	end
	return pcall(fn, ...)
end

local function dataOf(p: Player): { [string]: any }?
	local ok, data = call("DataService", "Get", p)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

local function depotOf(p: Player): Depot?
	local data = dataOf(p)
	local d = data and data.Depot
	return if type(d) == "table" then d else nil
end

local function present(p: any): boolean
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent == Players
end

local function marketTick(): number?
	local ok, t = call("MarketService", "Tick")
	if ok and isInt(t) and t > 0 then
		return t
	end
	return nil
end

-- Markt fertig gebootet? (Tick() ist schon kurz VOR "ready" gesetzt; PriceAt/Dividends liefern bis dahin nur
-- Startkurse bzw. nichts – der Offline-Abgleich darf erst danach rechnen). Fehlt die Funktion: als bereit werten.
local function marketReady(): boolean
	local ok, ready = call("MarketService", "IsReady")
	return not ok or ready == true
end

-- "Jetzt" der Engine: der zuletzt verarbeitete Markt-Tick; ohne Markt die Weltzeit
local function engineNow(): number
	local t = marketTick()
	if t then
		return t - LIVE_LAG
	end
	return Clock.Tick()
end

local function markDirty(p: Player, ...: string)
	local set = dirty[p]
	if not set then
		set = {}
		dirty[p] = set
	end
	for i = 1, select("#", ...) do
		set[select(i, ...)] = true
	end
end

local function flushDirty(p: Player)
	local set = dirty[p]
	if not set then
		return
	end
	dirty[p] = nil
	local keys: { string } = {}
	for key in pairs(set) do
		table.insert(keys, key)
	end
	if #keys > 0 then
		call("PlayerStateService", "MarkDirty", p, table.unpack(keys))
	end
end

local function notify(p: Player, key: string, args: { any }?, kind: Types.NotifyKind?)
	if present(p) then
		call("PlayerStateService", "Notify", p, key, args, kind)
	end
end

local function fire(list: { any }, ...: any)
	for _, cb in ipairs(list) do
		task.spawn(function(...)
			local ok, err = pcall(cb, ...)
			if not ok then
				logError("Callback", err)
			end
		end, ...)
	end
end

-- wie fire, aber erst nach dem laufenden Markt-Tick (MarketService öffnet den Tagesschluss nach den Tick-Callbacks)
local function fireDeferred(list: { any }, ...: any)
	for _, cb in ipairs(list) do
		task.defer(function(...)
			local ok, err = pcall(cb, ...)
			if not ok then
				logError("Callback", err)
			end
		end, ...)
	end
end

local function tickerOf(i: number): string
	local companies = Config.Companies
	local inst = type(companies) == "table" and type(companies.ById) == "table" and companies.ById[i] or nil
	return if type(inst) == "table" and type(inst.Ticker) == "string" then inst.Ticker else ("#" .. tostring(i))
end

-- Preis als zwei Ganzzahlen (Lang-Text setzt das Dezimalzeichen je Sprache: "%d,%02d" / "%d.%02d")
local function priceArgs(cents: number): (number, number)
	local c = math.max(0, math.floor(cents))
	return c // 100, c % 100
end

-- ---------------------------------------------------------------------
-- 2) INSTRUMENTE (Config.Companies + MarketService)
-- ---------------------------------------------------------------------
local activeSet: { [number]: boolean } = {}
local activeList: { number } = {}
local activeAt = -math.huge

local function instDef(i: number): { [string]: any }?
	local companies = Config.Companies
	local inst = type(companies) == "table" and type(companies.ById) == "table" and companies.ById[i] or nil
	return if type(inst) == "table" then inst else nil
end

local function refreshActive()
	local now = os.clock()
	if now - activeAt < IDS_SECONDS then
		return
	end
	activeAt = now
	local ok, list = call("MarketService", "ActiveIds")
	table.clear(activeSet)
	table.clear(activeList)
	if ok and type(list) == "table" then
		for _, i in ipairs(list) do
			if isInt(i) then
				activeSet[i] = true
				table.insert(activeList, i)
			end
		end
	end
	if #activeList == 0 then
		-- ohne Markt-Liste: alle festen Werte (Firmen + ETFs), keine IPO-Plätze
		local companies = Config.Companies
		if type(companies) == "table" and type(companies.Instruments) == "table" then
			for _, inst in ipairs(companies.Instruments) do
				if type(inst) == "table" and isInt(inst.Id) and inst.Ipo ~= true and inst.Set ~= "Tutorial" then
					activeSet[inst.Id] = true
					table.insert(activeList, inst.Id)
				end
			end
		end
	end
	table.sort(activeList)
end

local function isListed(i: number): boolean
	local def = instDef(i)
	if not def or def.Set == "Tutorial" then
		return false
	end
	refreshActive()
	return activeSet[i] == true
end

-- gültig für gespeicherte Daten (auch gerade nicht gelistete IPOs bleiben erhalten)
local function isKnownInst(i: number): boolean
	local def = instDef(i)
	return def ~= nil and def.Set ~= "Tutorial"
end

local function classOf(i: number): string?
	local ok, inst = call("MarketService", "Instrument", i)
	if ok and type(inst) == "table" and type(inst.Class) == "string" then
		return inst.Class
	end
	local def = instDef(i)
	return def and def.Class
end

local function setOf(i: number): string?
	local def = instDef(i)
	return def and def.Set
end

local function divBpsOf(i: number): number
	local def = instDef(i)
	return if def and isInt(def.DivBps) then def.DivBps else 0
end

-- ---------------------------------------------------------------------
-- 3) LIZENZ & KNOW-HOW (nur Prog.* – Robux-frei)
-- ---------------------------------------------------------------------
local SET_RANK = { Azubi = 1, Trader = 2, Fonds = 3 }

local function licenceTable(): ({ any }, number)
	local prog = Config.Progression
	local list = type(prog) == "table" and prog.Licences or nil
	if type(list) == "table" and #list >= 1 and type(list[1]) == "table" then
		-- Basis in AKY (25.000) oder in Cent (2.500.000)? Am ersten Eintrag erkennen.
		local first = num(list[1].Basis, 0)
		return list, if first > 0 and first < 1e6 then 100 else 1
	end
	return trading().LicenceFallback or {}, 1
end

local function normalizeLicence(def: any, idx: number, factor: number): Lic
	local fallback = (trading().LicenceFallback or {})[idx] or {}
	local function pick(key: string, default: any): any
		local v = if type(def) == "table" then def[key] else nil
		if v == nil then
			v = fallback[key]
		end
		if v == nil then
			v = default
		end
		return v
	end
	local fee = num(pick("FeeBps", 10), 10)
	if fee > 0 and fee < 1 then
		fee *= 10000 -- als Bruch angegeben
	end
	local weight = num(pick("MaxWeight", 0.3), 0.3)
	if weight > 1 then
		weight /= 100 -- als Prozent angegeben
	end
	local basisRaw = if type(def) == "table" and Util.IsFinite(def.Basis)
		then def.Basis * factor
		else num(fallback.Basis, 2500000)
	local set = pick("Set", if idx >= 7 then "Fonds" elseif idx >= 4 then "Trader" else "Azubi")
	return {
		Index = idx,
		Basis = math.floor(math.max(1, basisRaw)),
		BauKurs = num(pick("BauKurs", 40), 40),
		FeeBps = math.clamp(fee, 0, 100),
		MaxWeight = math.clamp(weight, 0.05, 1),
		MaxOrders = math.clamp(math.floor(num(pick("MaxOrders", 5), 5)), 1, 50),
		PosFactor = math.max(0, num(pick("PosFactor", 0.01), 0.01)),
		Set = if SET_RANK[set] then set else "Azubi",
		SetRank = SET_RANK[set] or 1,
		BotSlots = math.clamp(math.floor(num(pick("BotSlots", 0), 0)), 0, 5),
		Layer = tostring(pick("Layer", "Simple")),
	}
end

local function licenceIndex(p: Player): number
	local data = dataOf(p)
	local prog = data and data.Prog
	if type(prog) == "table" and isInt(prog.Licence) and prog.Licence >= 1 and prog.Licence <= 10 then
		return prog.Licence
	end
	local ok, idx = call("ProgressionService", "Licence", p)
	if ok and isInt(idx) and idx >= 1 and idx <= 10 then
		return idx
	end
	return 1
end

local function basisFor(idx: number): number
	local list, factor = licenceTable()
	return normalizeLicence(list[idx], idx, factor).Basis
end

local function licenceOf(p: Player?): Lic
	local idx = if p then licenceIndex(p) else 1
	local list, factor = licenceTable()
	local def = list[idx]
	if p then
		local ok, liveDef = call("ProgressionService", "LicenceDef", p)
		if ok and type(liveDef) == "table" then
			def = liveDef
		end
	end
	return normalizeLicence(def, idx, factor)
end

local function perksFor(p: Player?, lic: Lic): { [string]: any }
	local perks: { [string]: any } = {
		Licence = lic.Index,
		Layer = lic.Layer,
		BotSlots = lic.BotSlots,
		BotLevels = {},
		Alerts = 3,
		Watchlists = 1,
	}
	if p then
		local ok, result = call("ProgressionService", "TradingPerks", p)
		if ok and type(result) == "table" then
			perks.BotSlots = math.clamp(math.floor(num(result.BotSlots, lic.BotSlots)), 0, 5)
			perks.BotLevels = if type(result.BotLevels) == "table" then result.BotLevels else {}
			perks.Alerts = math.clamp(math.floor(num(result.Alerts, 3)), 0, num(trading().MaxAlertsHard, 18))
			perks.Watchlists = math.clamp(math.floor(num(result.Watchlists, 1)), 1, 5)
			perks.Risk = num(result.Risk, 0)
		end
	end
	return perks
end

local function licAndPerks(p: Player): (Lic, { [string]: any })
	local now = os.clock()
	local cached = perksCache[p]
	if cached and now - cached.At < PERKS_SECONDS then
		return cached.Lic, cached.Perks
	end
	local lic = licenceOf(p)
	local perks = perksFor(p, lic)
	perksCache[p] = { At = now, Lic = lic, Perks = perks }
	return lic, perks
end

-- ---------------------------------------------------------------------
-- 4) MARKT-ZUGRIFF (pcall) + Tick-Caches
-- ---------------------------------------------------------------------
local tickPx: { [number]: number } = {}
local tickPxAt = -1

local function priceAt(i: number, t: number): number?
	local now = marketTick()
	if now and t == now - LIVE_LAG then
		if tickPxAt ~= t then
			table.clear(tickPx)
			tickPxAt = t
		end
		local cached = tickPx[i]
		if cached then
			return cached
		end
	end
	local ok, px = call("MarketService", "PriceAt", i, t)
	if ok and Util.IsFinite(px) and px > 0 then
		local value = math.floor(px)
		if tickPxAt == t then
			tickPx[i] = value
		end
		return value
	end
	return nil
end

local function liveQuote(i: number): (number?, number?, number?)
	local ok, bid, ask, mid = call("MarketService", "Quote", i)
	if ok and Util.IsFinite(bid) and Util.IsFinite(ask) and Util.IsFinite(mid) and bid > 0 and ask >= bid then
		return math.floor(bid), math.floor(ask), math.floor(mid)
	end
	return nil, nil, nil
end

local candleTick = -1
local candleCache: { [number]: { number } | false } = {}

local function liveCandle(i: number, t: number): (number?, number?, number?, number?)
	if candleTick ~= t then
		candleTick = t
		table.clear(candleCache)
	end
	local cached = candleCache[i]
	if cached == nil then
		local ok, o, h, l, c = call("MarketService", "Candle1s", i, t)
		if ok and Util.IsFinite(o) and Util.IsFinite(h) and Util.IsFinite(l) and Util.IsFinite(c) then
			cached = { o, h, l, c }
		else
			cached = false
		end
		candleCache[i] = cached
	end
	if cached then
		return cached[1], cached[2], cached[3], cached[4]
	end
	return nil, nil, nil, nil
end

local divTick = -1
local divList: { any }? = nil

local function dividendsRange(t0: number, t1: number): { { [string]: number } }
	local ok, list = call("MarketService", "Dividends", t0, t1)
	if ok and type(list) == "table" then
		return list
	end
	return {}
end

local function liveDivs(t: number): { any }?
	if divTick ~= t then
		divTick = t
		local list = dividendsRange(t, t)
		divList = if #list > 0 then list else nil
	end
	return divList
end

-- Handelspause; mit Tick t die Pause GENAU zu diesem Tick (Offline-Abgleich rechnet dieselben Pausen wie online)
local function halted(i: number, t: number?): boolean
	local ok, result = call("MarketService", "IsHalted", i, t)
	return ok and result == true
end

local function factDir(i: number, t: number): number?
	local window = math.floor(num(trading().ReadWellSeconds, 60))
	local ok, item = call("MarketService", "FactNewsFor", i, t, window)
	if ok and type(item) == "table" and Util.IsFinite(item.Dir) then
		return item.Dir
	end
	return nil
end

local function adminActive(t: number): boolean
	local ok, result = call("MarketService", "AdminWindowActive", t)
	return ok and result == true
end

local function adminBetween(t0: number, t1: number): boolean
	local ok, list = call("MarketService", "AdminWindowsBetween", t0, t1)
	return ok and type(list) == "table" and #list > 0
end

local function weekOf(t: number): number
	return Util.IsoWeek(Clock.UnixOf(t))
end

local function activeIds(): { number }
	refreshActive()
	return table.clone(activeList)
end

-- ---------------------------------------------------------------------
-- 5) ENV (Markt-Sicht für die Engine) + Ereignisse
-- ---------------------------------------------------------------------
local handleEvent: (Player, Depot, string, string, any, { [string]: any }?) -> ()

local function makeEnv(p: Player, d: Depot, mode: string, buffer: { [string]: any }?): Env
	local lic, perks = licAndPerks(p)
	local data = dataOf(p)
	local watch = if type(d.Watch) == "table" and type(d.Watch[1]) == "table" then d.Watch[1] else {}
	local env: Env = {
		Mode = mode,
		Licence = lic,
		Perks = perks,
		PriceAt = priceAt,
		Quote = if mode == "Live" then liveQuote else nil,
		Class = classOf,
		Set = setOf,
		DivBps = divBpsOf,
		Listed = isListed,
		Halted = halted,
		FactDir = factDir,
		AdminActive = adminActive,
		AdminBetween = adminBetween,
		Dividends = dividendsRange,
		Emit = function(kind: string, payload: any)
			handleEvent(p, d, mode, kind, payload, buffer)
		end,
		League = if data and type(data.League) == "table" then data.League else nil,
		Week = weekOf,
		OwnerTaint = p:GetAttribute("IsAdmin") == true,
		CacheBefore = (marketTick() or 0) - CACHE_SAFETY,
		Watch = watch,
		ActiveIds = activeIds,
	}
	return env
end

local function noteLoss(p: Player)
	local cfg = trading().LossStreakWarn or {}
	local limit = math.floor(num(cfg.Trades, 10))
	local window = num(cfg.Seconds, 120)
	local list = lossTimes[p]
	if not list then
		list = {}
		lossTimes[p] = list
	end
	local now = os.clock()
	table.insert(list, now)
	while list[1] ~= nil and now - list[1] > window do
		table.remove(list, 1)
	end
	if #list >= limit then
		table.clear(list)
		notify(p, "trade.lossStreak", nil, "Info")
	end
end

local FILL_KEYS = {
	Limit = { B = "trade.fillLimitBuy", S = "trade.fillLimitSell" },
	Stop = { S = "trade.fillStop" },
	Target = { S = "trade.fillTarget" },
	Trail = { S = "trade.fillTrail" },
	OcoStop = { S = "trade.fillStop" },
	OcoTarget = { S = "trade.fillTarget" },
	BuyStop = { B = "trade.fillBuyStop" },
}

handleEvent = function(p: Player, _d: Depot, mode: string, kind: string, data: any, buffer: { [string]: any }?)
	markDirty(p, "Depot")
	if mode ~= "Live" then
		-- Offline-Abgleich: Signale sammeln und nach dem Abgleich der Reihe nach auslösen
		if buffer then
			if kind == "Fill" and #buffer.Fills < MAX_PENDING_EVENTS then
				table.insert(buffer.Fills, data.Fill)
			elseif kind == "DayResult" and #buffer.Days < MAX_PENDING_DAYS then
				table.insert(buffer.Days, data)
			elseif kind == "Bell" then
				buffer.Bell = true
			end
		end
		if kind == "DayResult" or kind == "Fill" then
			markDirty(p, "League")
		end
		return
	end
	if kind == "Fill" then
		local fill = data.Fill
		fire(tradeCallbacks, p, fill)
		markDirty(p, "League")
		if fill.Bot then
			return -- Bots handeln still (Depot-Ansicht zeigt es)
		end
		local keys = FILL_KEYS[data.Kind]
		local key = keys and keys[fill.Side]
		if key then
			local whole, cents = priceArgs(fill.Px)
			if data.Kind == "Stop" or data.Kind == "OcoStop" then
				key = if data.Gap then "trade.fillStopGap" else "trade.fillStop"
				notify(p, key, { tickerOf(fill.I), whole, cents }, "Alarm")
			elseif data.Kind == "Limit" then
				notify(p, key, { fill.Q, tickerOf(fill.I), whole, cents }, "Success")
			else
				notify(p, key, { tickerOf(fill.I), whole, cents }, "Success")
			end
		end
		if fill.Side == "S" and Util.IsFinite(fill.Pnl) and fill.Pnl < 0 then
			noteLoss(p)
		end
		if fill.ReadWell then
			call("PlayerStateService", "Effect", p, "ReadWell", 1, { I = fill.I, Ticker = tickerOf(fill.I) })
		end
	elseif kind == "Expired" then
		if data.Bot == nil then
			notify(p, "trade.expired", { tickerOf(data.I) }, "Info")
		end
	elseif kind == "Cancelled" then
		if data.Bot == nil then -- Bot-Orders laufen still (Depot-Ansicht zeigt es)
			local key = if data.Reason == "trade.noCash" then "trade.cancelNoCash" else "trade.cancelLimit"
			notify(p, key, { tickerOf(data.I) }, "Info")
		end
	elseif kind == "Cut" then
		if data.Bot == nil then
			notify(p, "trade.cut", { data.Q, tickerOf(data.I) }, "Info")
		end
	elseif kind == "Alert" then
		local whole, cents = priceArgs(data.Px)
		notify(p, "trade.alertHit", { tickerOf(data.I), whole, cents }, "Alarm")
	elseif kind == "Dividend" then
		local whole, cents = priceArgs(data.Cents)
		notify(p, "trade.dividend", { tickerOf(data.I), whole, cents }, "Success")
	elseif kind == "DayResult" then
		-- MarketService schickt die "DayClose"-Nachricht mit dieser Rendite (eine Meldung, ein Weg)
		fireDeferred(dayCallbacks, p, data)
		markDirty(p, "League")
	elseif kind == "Bell" then
		fire(bellCallbacks, p)
	elseif kind == "BotPaused" then
		notify(p, "trade.botPaused", { data.Slot }, "Alarm")
	end
end

-- Metriken der AKY-Flüsse (nur seltene Gründe – kein Eintrag je Trade/Gebühr)
local METRIC_REASONS = {
	Licence = "Source",
	Refill = "Source",
	Admin = "Source",
	Tutorial = "Source",
	Transfer = "Sink",
	BotWage = "Sink",
}

local function onFlow(d: Depot, signed: number, reason: string)
	local p = ownerOf[d]
	local flow = METRIC_REASONS[reason]
	if not p or not flow or signed == 0 then
		return
	end
	if reason == "Tutorial" or reason == "Admin" then
		flow = if signed > 0 then "Source" else "Sink" -- Übung (Kauf/Verkauf) · Admin-Gabe/-Abzug
	end
	call("MetricsService", "Economy", p, flow, "AKY", math.abs(signed), math.floor(num(d.Cash, 0)), reason)
end

-- ---------------------------------------------------------------------
-- 6) LIVE-VERARBEITUNG & OFFLINE-ABGLEICH
-- ---------------------------------------------------------------------
local startCatchUp: (Player) -> ()

local function ensureDayRecord(d: Depot, env: Env, t: number)
	local day = t // DAY
	local rec = Portfolio.CurrentDay(d)
	if rec == nil or rec[1] ~= day then
		Portfolio.OpenDay(d, day, OrderEngine.NavAt(d, env, t), next(d.Pos) ~= nil)
	end
end

local function processLive(p: Player, d: Depot, target: number)
	local last = math.floor(num(d.LastTick, 0))
	if last >= target then
		return
	end
	if target - last > LIVE_GAP_MAX then
		live[p] = false
		startCatchUp(p)
		return
	end
	local env = makeEnv(p, d, "Live")
	for tt = last + 1, target do
		local ctx = {
			Candle = function(i: number): (number?, number?, number?, number?)
				return liveCandle(i, tt)
			end,
			Divs = liveDivs(tt),
		}
		local ok, err = pcall(OrderEngine.Step, d, env, tt, ctx)
		if not ok then
			d.LastTick = tt -- nie an einem kaputten Tick hängen bleiben
			logError("Step " .. p.Name, err)
		end
	end
end

local function onMarketTick(t: number)
	if not isInt(t) then
		return
	end
	local target = t - LIVE_LAG
	for _, p in ipairs(Players:GetPlayers()) do
		if live[p] then
			local d = depotOf(p)
			if d then
				processLive(p, d, target)
			end
			flushDirty(p)
		end
	end
end

local function newCursor(i: number, t0: number): any
	local ok, cursor = call("MarketService", "NewCursor", i, t0)
	if ok and type(cursor) == "table" then
		return cursor
	end
	return nil
end

local function randomCandle(i: number, t: number): (number?, number?, number?, number?)
	local ok, o, h, l, c = call("MarketService", "Candle1s", i, t)
	if ok and Util.IsFinite(o) then
		return o, h, l, c
	end
	return nil, nil, nil, nil
end

local function applyLicence(p: Player, d: Depot, idx: number)
	local current = if isInt(d.Lic) then d.Lic else 1
	if current == idx then
		return
	end
	local delta = basisFor(idx) - basisFor(current)
	if delta > 0 then
		Portfolio.Credit(d, delta, "Licence")
	elseif delta < 0 then
		Portfolio.Debit(d, -delta, "Licence")
		-- Herabstufung (nur Admin): Kauf-Orders ohne Deckung streichen (jüngste zuerst)
		local guard = 0
		while Portfolio.Reserved(d) > d.Cash and guard < 50 do
			guard += 1
			for i = #d.Orders, 1, -1 do
				if d.Orders[i].Side == "B" then
					table.remove(d.Orders, i)
					break
				end
			end
		end
	end
	d.Lic = idx
	perksCache[p] = nil
	markDirty(p, "Depot")
end

-- Übung: liegengebliebene ACAD-Stück verkaufen (Abschnitt 9; vorab deklariert, goLive braucht sie)
local finishTutorial: (Player, Depot, boolean) -> number?

local function goLive(p: Player, d: Depot, buffer: { [string]: any }?, report: { [string]: any }?)
	local env = makeEnv(p, d, "Live")
	ensureDayRecord(d, env, math.floor(num(d.LastTick, engineNow())))
	live[p] = true
	syncing[p] = nil
	local queued = pendingLicence[p]
	if queued then
		pendingLicence[p] = nil
		applyLicence(p, d, queued)
	end
	-- mitten in der Übung gegangen: liegengebliebene ACAD-Stück zum Automatik-Kurs verkaufen
	if num(d.Tutorial.Q, 0) > 0 and not tutorials[p] then
		finishTutorial(p, d, true)
	end
	if report and (report.Fills > 0 or report.Dividends > 0 or report.Alerts > 0 or #report.Bots > 0) then
		reports[p] = {
			Fills = report.Fills,
			Dividends = report.Dividends,
			Bots = report.Bots,
			Alerts = report.Alerts,
		}
	end
	if buffer then
		for _, fill in ipairs(buffer.Fills) do
			fire(tradeCallbacks, p, fill)
		end
		for _, day in ipairs(buffer.Days) do
			fire(dayCallbacks, p, day)
		end
	end
	if math.floor(num(d.Pending, 0)) > 0 then
		fire(bellCallbacks, p) -- Turm holt offline verbuchte Auto-Transfers ab (Withdraw "Bell"/"Offline")
	end
	markDirty(p, "Depot", "League")
	flushDirty(p)
end

startCatchUp = function(p: Player)
	if syncing[p] then
		return
	end
	syncing[p] = true
	live[p] = false
	markDirty(p, "Depot")
	flushDirty(p)
	task.spawn(function()
		local d = depotOf(p)
		if not d or not present(p) then
			syncing[p] = nil
			return
		end
		local now = if marketReady() then marketTick() else nil
		-- Markt bootet noch (Seed aus dem DataStore): warten statt die Offline-Zeit zu überspringen
		local waited = 0
		while not now and Services and Services.MarketService ~= nil and present(p) and waited < MARKET_WAIT do
			task.wait(1)
			waited += 1
			now = if marketReady() then marketTick() else nil
		end
		if not present(p) or depotOf(p) ~= d then
			syncing[p] = nil
			return
		end
		if not now then
			-- kein Markt (Dienst fehlt/ausgefallen): nichts nachzurechnen, Depot trotzdem nutzbar
			d.LastTick = math.max(math.floor(num(d.LastTick, 0)), Clock.Tick())
			goLive(p, d, nil, nil)
			return
		end
		local target = now - LIVE_LAG
		if math.floor(num(d.LastTick, 0)) <= 0 then
			d.LastTick = target -- neues Depot: nichts nachzuholen
			goLive(p, d, nil, nil)
			return
		end
		local buffer = { Fills = {}, Days = {}, Bell = false }
		local env = makeEnv(p, d, "Replay", buffer)
		local report = CatchUp.Run(d, env, target, {
			Cursor = newCursor,
			Candle = randomCandle,
			Yield = function()
				task.wait()
			end,
			BudgetMs = 2,
			Abort = function(): boolean
				return not present(p) or depotOf(p) ~= d
			end,
			Target = function(): number?
				local t = marketTick()
				return if t then t - LIVE_LAG else nil
			end,
		})
		-- ab hier kein Yield mehr bis "live" (kein Tick darf verloren gehen)
		if not present(p) or depotOf(p) ~= d then
			syncing[p] = nil
			return
		end
		local nowAfter = marketTick()
		if nowAfter and math.floor(num(d.LastTick, 0)) < nowAfter - LIVE_LAG - LIVE_GAP_MAX then
			-- Abgleich kam nicht hinterher (Fehler/Ausfall): Rest überspringen statt endlos neu anzusetzen
			warn(("[OrderService] Abgleich für %s unvollständig – springe auf den Markt-Tick"):format(p.Name))
			d.LastTick = nowAfter - LIVE_LAG
		end
		goLive(p, d, buffer, report)
	end)
end

local function onProfileLoaded(p: Player, data: { [string]: any })
	if not present(p) or type(data) ~= "table" or type(data.Depot) ~= "table" then
		return
	end
	local d = data.Depot
	ownerOf[d] = p
	if not isInt(d.Lic) then
		-- Depot ohne gespeicherte Lizenz-Basis: höchste Lizenz, deren Basis schon im Depot steckt
		local lic = 1
		for idx = 2, 10 do
			if basisFor(idx) <= math.floor(num(d.Basis, 0)) then
				lic = idx
			end
		end
		d.Lic = lic
	end
	local issues = Portfolio.Sanitize(d, engineNow(), isKnownInst)
	if #issues > 0 then
		warn(("[OrderService] Depot von %s repariert: %s"):format(p.Name, table.concat(issues, "; ")))
	end
	local window = math.floor(num(trading().SeqWindow, 32))
	while #d.Seq > window do
		table.remove(d.Seq, 1)
	end
	if type(data.League) ~= "table" then
		data.League = { Week = 0, Returns = {}, Trades = 0, Days = 0, Tainted = false }
	end
	Portfolio.LeagueRoll(data.League, weekOf(engineNow()))
	-- Lizenz-Basis abgleichen (Lizenz-Aufstieg, während das Depot nicht geladen war) – erst NACH dem
	-- Offline-Abgleich, damit der Abgleich mit dem Stand beim Verlassen rechnet
	pendingLicence[p] = licenceIndex(p)
	startCatchUp(p)
end

local function onPlayerRemoving(p: Player)
	local d = depotOf(p)
	if d then
		ownerOf[d] = nil
	end
	live[p] = nil
	syncing[p] = nil
	replies[p] = nil
	reports[p] = nil
	tutorials[p] = nil
	lossTimes[p] = nil
	spam[p] = nil
	perksCache[p] = nil
	pendingLicence[p] = nil
	dirty[p] = nil
end

-- ---------------------------------------------------------------------
-- 7) GEWINN-TRANSFER, RETTUNGSSCHIRM
-- ---------------------------------------------------------------------
local function navNow(p: Player, d: Depot): number
	local env = makeEnv(p, d, "Live")
	return OrderEngine.NavAt(d, env, engineNow())
end

local function currentDay(): number
	return engineNow() // DAY
end

-- (Betrag, jetzt erlaubt, Grund) – inkl. offline verbuchter Auto-Transfers (Pending)
local function transferInfo(p: Player, d: Depot): (number, boolean, string?)
	local pending = math.floor(num(d.Pending, 0))
	if not live[p] then
		return pending, false, "trade.syncing"
	end
	if math.floor(num(d.LastTransferDay, -1)) >= currentDay() then
		return pending, pending > 0, if pending > 0 then nil else "trade.transferUsed"
	end
	local amount, reason = OrderEngine.TransferAmount(d, makeEnv(p, d, "Live"), navNow(p, d))
	local total = pending + amount
	return total, total > 0, if total > 0 then nil else reason
end

local function refillInfo(p: Player, d: Depot): (number, string?)
	local cfg = trading().Refill or {}
	if math.floor(num(d.LastRefillUtcDay, -1)) >= Util.UtcDay() then
		return 0, "trade.refillUsed"
	end
	if next(d.Pos) ~= nil or #d.Orders > 0 or num(d.Tutorial.Q, 0) > 0 then
		return 0, "trade.refillNotNeeded"
	end
	local basis = math.floor(num(d.Basis, 0))
	local nav = navNow(p, d)
	if nav >= math.floor(num(cfg.Below, 0.5) * basis) then
		return 0, "trade.refillNotNeeded"
	end
	local amount = math.floor(num(cfg.To, 0.5) * basis) - nav
	if amount <= 0 then
		return 0, "trade.refillNotNeeded"
	end
	return amount, nil
end

-- ---------------------------------------------------------------------
-- 8) ÖFFENTLICHE API (§C5.4)
-- ---------------------------------------------------------------------
function OrderService.Depot(p: Player): Types.Depot?
	return depotOf(p) :: any
end

function OrderService.Nav(p: Player): number
	local d = depotOf(p)
	if not d then
		return 0
	end
	return navNow(p, d)
end

function OrderService.Withdrawable(p: Player): (number, boolean, string?)
	local d = depotOf(p)
	if not d then
		return 0, false, "core.loading"
	end
	return transferInfo(p, d)
end

function OrderService.Withdraw(p: Player, reason: "Manual" | "Bell" | "Offline"): (number, string?)
	local d = depotOf(p)
	if not d or not present(p) then
		return 0, "core.loading"
	end
	if not live[p] then
		return 0, "trade.syncing"
	end
	local total = 0
	local why: string? = nil
	-- 1) schon abgebuchte Auto-Transfers (Glocke / Offline-Abgleich) abholen
	local pending = math.floor(num(d.Pending, 0))
	if pending > 0 then
		d.Pending = 0
		total += pending
	end
	-- 2) Knopf "Gewinn in den Tower": 1× je Börsentag nach den Regeln §B8.2
	if reason == "Manual" then
		local day = currentDay()
		if math.floor(num(d.LastTransferDay, -1)) >= day then
			why = "trade.transferUsed"
		else
			local amount, key = OrderEngine.TransferAmount(d, makeEnv(p, d, "Live"), navNow(p, d))
			if amount > 0 and Portfolio.Debit(d, amount, "Transfer") then
				d.LastTransferDay = day
				total += amount
			else
				why = key or "trade.transferNone"
			end
		end
	elseif total == 0 then
		why = if d.AutoTransfer == false then "trade.autoOff" else "trade.transferNone"
	end
	markDirty(p, "Depot")
	flushDirty(p)
	if total > 0 then
		return total, nil
	end
	return 0, why
end

function OrderService.SetLicence(p: Player, idx: number)
	if not isInt(idx) or idx < 1 or idx > 10 then
		return
	end
	local d = depotOf(p)
	if not d then
		return
	end
	if not live[p] then
		pendingLicence[p] = idx -- nach dem Offline-Abgleich anwenden (Abgleich rechnet mit festem Stand)
		return
	end
	applyLicence(p, d, idx)
	flushDirty(p)
end

function OrderService.TaintWeek(p: Player, reason: string)
	local data = dataOf(p)
	if not data or type(data.League) ~= "table" then
		return
	end
	Portfolio.LeagueRoll(data.League, weekOf(engineNow()))
	data.League.Tainted = true
	call("MetricsService", "Custom", p, "LeagueTaint", 1, { Reason = tostring(reason) })
	markDirty(p, "League")
	flushDirty(p)
end

-- cents > 0: Admin-Gabe (Cash + Basis, nie abhebbar). cents < 0: Admin-Abzug (Besitzer-Wunsch "geben oder abziehen")
-- höchstens bis zum freien Geld – Positionen und Reservierungen bleiben unberührt, die Basis sinkt um denselben Betrag
-- (der abhebbare Gewinn NAV − Basis bleibt gleich). Beides taintet die Liga-Woche.
function OrderService.AdminCredit(p: Player, cents: number): boolean
	if not isInt(cents) or cents == 0 or math.abs(cents) >= MAX_MONEY then
		return false
	end
	local d = depotOf(p)
	if not d then
		return false
	end
	if cents > 0 then
		if not Portfolio.Credit(d, cents, "Admin") then
			return false
		end
	else
		local take = math.min(-cents, Portfolio.Free(d))
		if take <= 0 or not Portfolio.Debit(d, take, "Admin") then
			return false
		end
	end
	OrderService.TaintWeek(p, "AdminCredit")
	markDirty(p, "Depot")
	flushDirty(p)
	return true
end

function OrderService.HoldsShares(p: Player, i: number): number
	local d = depotOf(p)
	if not d or not isInt(i) then
		return 0
	end
	return Portfolio.PosQty(d, i)
end

function OrderService.LeagueStats(p: Player): Types.LeagueStats
	local data = dataOf(p)
	local league = data and data.League
	if type(league) ~= "table" then
		return {
			Week = weekOf(engineNow()),
			SkillScore = 0,
			AvgDailyBp = 0,
			Trades = 0,
			Days = 0,
			Tainted = false,
			Qualified = false,
		}
	end
	Portfolio.LeagueRoll(league, weekOf(engineNow()))
	return Portfolio.LeagueStats(league, p:GetAttribute("IsAdmin") == true)
end

function OrderService.CatchUpReport(p: Player): { [string]: any }?
	return reports[p]
end

function OrderService.OnTrade(cb: (p: Player, f: Types.FillInfo) -> ())
	if type(cb) == "function" then
		table.insert(tradeCallbacks, cb)
	end
end

function OrderService.OnDayResult(cb: (p: Player, r: Types.DayResult) -> ())
	if type(cb) == "function" then
		table.insert(dayCallbacks, cb)
	end
end

function OrderService.OnBell(cb: (p: Player) -> ())
	if type(cb) == "function" then
		table.insert(bellCallbacks, cb)
	end
end

function OrderService.TutorialState(p: Player): "None" | "Running" | "Done"
	local data = dataOf(p)
	local d = data and data.Depot
	if type(d) == "table" and type(d.Tutorial) == "table" and d.Tutorial.Done == true then
		return "Done"
	end
	if data and type(data.Flags) == "table" and data.Flags.TutorialTrade == true then
		return "Done"
	end
	if tutorials[p] then
		return "Running"
	end
	return "None"
end

-- ---------------------------------------------------------------------
-- 9) ACAD-ÜBUNG (§B8.6): Kurs pro Spieler, Replay-Remote 1 Hz
-- ---------------------------------------------------------------------
local function tutCfg(): { [string]: any }
	local t = trading().Tutorial
	return if type(t) == "table" then t else {}
end

local function smoothstep(x: number): number
	local c = math.clamp(x, 0, 1)
	return c * c * (3 - 2 * c)
end

-- Kurs (Cent) und Phase (0 vor der News · 1 Lesefenster · 2 Rampe · 3 flach) dt Sekunden nach dem Start
local function tutPrice(dt: number): (number, number)
	local cfg = tutCfg()
	local start = num(cfg.Start, 10000)
	local newsAt = num(cfg.NewsAt, 2)
	local rampFrom = newsAt + num(cfg.ReadSeconds, 8)
	local ramp = math.max(1, num(cfg.Ramp, 45))
	local progress = smoothstep((dt - rampFrom) / ramp)
	local wiggle = num(cfg.Wiggle, 0.0015) * (math.sin(dt * 0.9) + 0.6 * math.sin(dt * 2.3)) / 1.6
	local px = math.floor(start * (1 + num(cfg.Jump, 0.15) * progress) * (1 + wiggle) + 0.5)
	local phase = if dt < newsAt then 0 elseif dt < rampFrom then 1 elseif dt < rampFrom + ramp then 2 else 3
	return math.max(1, px), phase
end

local function tutHalfSpread(px: number): number
	local classes = Config.Market and Config.Market.Classes
	local normal = type(classes) == "table" and classes.Normal or nil
	local bps = num(type(normal) == "table" and normal.SpreadBps, 8)
	return math.max(1, math.max(1, math.floor(px * bps / 10000 + 0.5)) // 2)
end

local function encodeReplay(tick: number, close: number, phase: number): buffer
	if QuoteCodec and type(QuoteCodec.EncodeReplay) == "function" then
		local ok, b = pcall(QuoteCodec.EncodeReplay, tick, close, phase)
		if ok and typeof(b) == "buffer" then
			return b
		end
	end
	local b = buffer.create(9)
	buffer.writeu32(b, 0, math.clamp(math.floor(tick), 0, 4294967295))
	buffer.writeu32(b, 4, math.clamp(math.floor(close), 0, 4294967295))
	buffer.writeu8(b, 8, math.clamp(math.floor(phase), 0, 255))
	return b
end

-- Verkauf der Übungsstück (Knopf, Automatik bei 90 s, oder beim nächsten Beitritt). auto = Preis +12 %.
finishTutorial = function(p: Player, d: Depot, auto: boolean): number?
	local tut = d.Tutorial
	local qty = math.floor(num(tut.Q, 0))
	if qty <= 0 then
		return nil
	end
	local cfg = tutCfg()
	local session = tutorials[p]
	local px: number
	if auto or not session then
		px = math.floor(num(cfg.Start, 10000) * (1 + num(cfg.AutoSellAt, 0.12)) + 0.5)
	else
		px = tutPrice(Clock.Tick() - session.T0)
	end
	local bid = math.max(1, px - tutHalfSpread(px))
	local lic = licenceOf(p)
	local proceeds = PortfolioMath.SellProceeds(qty, bid, lic.FeeBps, num(trading().MinFeeCents, 100))
	Portfolio.Credit(d, proceeds, "Tutorial")
	tut.Q = 0
	tut.Done = true
	local data = dataOf(p)
	if data then
		if type(data.Flags) ~= "table" then
			data.Flags = {}
		end
		data.Flags.TutorialTrade = true
		call("PlayerStateService", "MarkDirty", p, "Flags")
	end
	local cost = if session then math.floor(num(session.Cost, 0)) else 0
	local pnl = proceeds - cost
	if session then
		session.Ended = true
	end
	markDirty(p, "Depot")
	if cost > 0 then
		local sign = if pnl >= 0 then "+" else "-"
		notify(p, "trade.tutSold", { sign .. tostring(math.abs(pnl) // 100) }, "Success")
	end
	return pnl
end

local function tutorialStep()
	local now = Clock.Tick()
	for p, session in pairs(tutorials) do
		if not present(p) then
			tutorials[p] = nil
			continue
		end
		local d = depotOf(p)
		if not d then
			tutorials[p] = nil
			continue
		end
		local cfg = tutCfg()
		local dt = now - session.T0
		if session.Bought and not session.Ended and num(d.Tutorial.Q, 0) > 0 and dt >= num(cfg.AutoSellAfter, 90) then
			finishTutorial(p, d, true)
			flushDirty(p)
		end
		if session.Ended or dt > num(cfg.Timeout, 240) then
			if num(d.Tutorial.Q, 0) > 0 then
				finishTutorial(p, d, true)
				flushDirty(p)
			end
			tutorials[p] = nil
			continue
		end
		local px, phase = tutPrice(dt)
		pcall(function()
			Remotes.Replay:FireClient(p, encodeReplay(now, px, phase))
		end)
	end
end

-- ---------------------------------------------------------------------
-- 10) REQUEST-HYGIENE: exakte Schlüssel, Typen, Seq-Fenster (rückt auch bei Ablehnung vor)
-- ---------------------------------------------------------------------
local function exactKeys(arg: any, allowed: { [string]: boolean }): boolean
	if type(arg) ~= "table" then
		return false
	end
	local n = 0
	for key in pairs(arg) do
		n += 1
		if n > 24 or type(key) ~= "string" or not allowed[key] then
			return false
		end
	end
	return true
end

local function isId(v: any): boolean
	return isInt(v) and v >= 1 and v <= MAX_NUMBER_ARG
end

local function isPrice(v: any): boolean
	return Util.IsFinite(v) and v > 0 and v <= MAX_PRICE_ARG
end

local function reject(p: Player, key: string, args: { any }?): Reply
	notify(p, key, args, "Error")
	return { Ok = false, Key = key, Args = args }
end

local function seqDuplicate(p: Player, d: Depot, seq: number): Reply?
	if table.find(d.Seq, seq) then
		local cache = replies[p]
		local cached = cache and cache[seq]
		return cached or { Ok = false, Key = "trade.duplicate" }
	end
	return nil
end

local function recordSeq(p: Player, d: Depot, seq: number)
	table.insert(d.Seq, seq)
	local window = math.floor(num(trading().SeqWindow, 32))
	while #d.Seq > window do
		local old = table.remove(d.Seq, 1)
		local cache = replies[p]
		if cache and old ~= nil then
			cache[old] = nil
		end
	end
end

local function storeReply(p: Player, seq: number, reply: Reply)
	local cache = replies[p]
	if not cache then
		cache = {}
		replies[p] = cache
	end
	cache[seq] = reply
end

-- Gemeinsamer Rahmen für Seq-Aktionen: Depot da? live? Seq gültig/neu? -> Fenster vorrücken -> Handler
local function withSeq(p: Player, arg: any, fn: (Depot) -> Reply): Reply
	if type(arg) ~= "table" or not isInt(arg.Seq) or arg.Seq < 0 or arg.Seq > 2 ^ 31 then
		return reject(p, "trade.invalid")
	end
	local d = depotOf(p)
	if not d then
		return { Ok = false, Key = "core.loading" }
	end
	local duplicate = seqDuplicate(p, d, arg.Seq)
	if duplicate then
		return duplicate -- gleiche Antwort wie beim ersten Mal (Doppelklick/Retry), ohne neue Meldung
	end
	recordSeq(p, d, arg.Seq) -- Fenster rückt AUCH bei Ablehnung vor (CC Runde-2, kritisch)
	local ok, result = pcall(fn, d)
	local reply: Reply = if ok and type(result) == "table" then result else { Ok = false, Key = "core.error" }
	if not ok then
		logError("Seq-Aktion", result)
	end
	storeReply(p, arg.Seq, reply)
	markDirty(p, "Depot")
	flushDirty(p)
	return reply
end

local function tradingOpen(p: Player): string?
	if not live[p] then
		return "trade.syncing"
	end
	if not marketTick() or not marketReady() then
		return "trade.marketClosed"
	end
	local ok, blocked = call("AdminService", "OwnerTradeBlocked", p)
	if ok and blocked == true then
		return "trade.ownerBlocked"
	end
	return nil
end

local function noteSpam(p: Player)
	local now = os.clock()
	local entry = spam[p]
	if not entry or now - entry.Window >= 60 then
		entry = { Window = now, Count = 0, Flagged = false }
		spam[p] = entry
	end
	entry.Count += 1
	if not entry.Flagged and entry.Count > math.floor(num(trading().SpamPerMinute, 50)) then
		entry.Flagged = true
		local weights = Config.Security and Config.Security.Weights
		local points = num(type(weights) == "table" and weights.Rate, 1)
		call("AntiCheatService", "Add", p, "TradeSpam", points, { PerMin = entry.Count })
	end
end

-- ---------------------------------------------------------------------
-- 11) HANDLER
-- ---------------------------------------------------------------------
local PLACE_KEYS = {
	I = true,
	Side = true,
	Type = true,
	Qty = true,
	Pct = true,
	Lim = true,
	Stp = true,
	Tp = true,
	Trl = true,
	Protect = true,
	Exp = true,
	MaxPx = true,
	MinPx = true,
	Seq = true,
}
local TYPE_FIELDS = { -- erlaubte Preis-Felder je Ordertyp
	MKT = {},
	LMT = { Lim = true },
	STP = { Stp = true },
	TP = { Tp = true },
	OCO = { Stp = true, Tp = true },
	TRL = { Trl = true },
}

local function fillReply(p: Player, result: OrderEngine.Result): Reply
	if not result.Ok then
		return reject(p, result.Key or "trade.invalid", result.Args)
	end
	local fill = result.Fill
	if fill then
		local whole, cents = priceArgs(fill.Px)
		local key = if fill.Side == "B" then "trade.boughtNow" else "trade.soldNow"
		notify(p, key, { fill.Q, tickerOf(fill.I), whole, cents }, "Success")
		return { Ok = true, Key = key, Fill = fill, Qty = result.Qty }
	end
	return { Ok = true, OrderId = result.OrderId, Qty = result.Qty }
end

local function handlePlace(p: Player, arg: any): Reply
	noteSpam(p)
	if not exactKeys(arg, PLACE_KEYS) then
		return reject(p, "trade.invalid")
	end
	return withSeq(p, arg, function(d: Depot): Reply
		local closed = tradingOpen(p)
		if closed then
			return reject(p, closed)
		end
		-- Typen & Wertebereiche
		if not isId(arg.I) or (arg.Side ~= "B" and arg.Side ~= "S") or TYPE_FIELDS[arg.Type] == nil then
			return reject(p, "trade.invalid")
		end
		local hasQty, hasPct = arg.Qty ~= nil, arg.Pct ~= nil
		if hasQty == hasPct then
			return reject(p, "trade.invalid") -- genau eins von Stück oder Chip
		end
		if hasQty and (not isId(arg.Qty)) then
			return reject(p, "trade.invalid")
		end
		local pct: any = nil
		if hasPct then
			local chips = trading().Chips or { 0.10, 0.25, "Max" }
			if arg.Pct == "Max" then
				pct = "Max"
			elseif arg.Pct == 10 then
				pct = num(chips[1], 0.10)
			elseif arg.Pct == 25 then
				pct = num(chips[2], 0.25)
			else
				return reject(p, "trade.invalid")
			end
		end
		local fields = TYPE_FIELDS[arg.Type]
		for _, key in ipairs({ "Lim", "Stp", "Tp", "Trl" }) do
			if arg[key] ~= nil and not fields[key] then
				return reject(p, "trade.invalid")
			end
		end
		for _, key in ipairs({ "Lim", "Stp", "Tp", "MaxPx", "MinPx" }) do
			if arg[key] ~= nil and not isPrice(arg[key]) then
				return reject(p, "trade.invalid")
			end
		end
		if arg.Trl ~= nil and not isInt(arg.Trl) then
			return reject(p, "trade.invalid")
		end
		if arg.Protect ~= nil and type(arg.Protect) ~= "boolean" then
			return reject(p, "trade.invalid")
		end
		if arg.Protect == true and (arg.Side ~= "B" or (arg.Type ~= "MKT" and arg.Type ~= "LMT")) then
			return reject(p, "trade.invalid")
		end
		if arg.Exp ~= nil and arg.Exp ~= "DAY" and arg.Exp ~= "24H" then
			return reject(p, "trade.invalid")
		end
		local isMarket = arg.Type == "MKT"
		local isBuy = arg.Side == "B"
		if (arg.MaxPx ~= nil and not (isMarket and isBuy)) or (arg.MinPx ~= nil and not (isMarket and not isBuy)) then
			return reject(p, "trade.invalid")
		end
		local env = makeEnv(p, d, "Live")
		local result = OrderEngine.Place(d, env, engineNow(), {
			I = arg.I,
			Side = arg.Side,
			Type = arg.Type,
			Qty = arg.Qty,
			Pct = pct,
			Lim = arg.Lim,
			Stp = arg.Stp,
			Tp = arg.Tp,
			Trl = arg.Trl,
			Protect = arg.Protect == true,
			Exp = arg.Exp,
			MaxPx = arg.MaxPx,
			MinPx = arg.MinPx,
			Live = true,
		})
		if result.Ok and result.Fill == nil and result.OrderId then
			notify(p, "trade.orderPlaced", { tickerOf(arg.I) }, "Info")
			return { Ok = true, Key = "trade.orderPlaced", OrderId = result.OrderId, Qty = result.Qty }
		end
		return fillReply(p, result)
	end)
end

local function handleCancel(p: Player, arg: any): Reply
	if not exactKeys(arg, { OrderId = true, Seq = true }) then
		return reject(p, "trade.invalid")
	end
	return withSeq(p, arg, function(d: Depot): Reply
		if not live[p] then
			return reject(p, "trade.syncing")
		end
		if not isId(arg.OrderId) then
			return reject(p, "trade.invalid")
		end
		if not OrderEngine.Cancel(d, arg.OrderId) then
			return reject(p, "trade.orderNotFound")
		end
		notify(p, "trade.cancelled", nil, "Info")
		return { Ok = true, Key = "trade.cancelled" }
	end)
end

local function handleModify(p: Player, arg: any): Reply
	if not exactKeys(arg, { OrderId = true, Lim = true, Stp = true, Tp = true, Trl = true, Seq = true }) then
		return reject(p, "trade.invalid")
	end
	return withSeq(p, arg, function(d: Depot): Reply
		local closed = tradingOpen(p)
		if closed then
			return reject(p, closed)
		end
		if not isId(arg.OrderId) then
			return reject(p, "trade.invalid")
		end
		local changes: { [string]: number } = {}
		for _, key in ipairs({ "Lim", "Stp", "Tp" }) do
			if arg[key] ~= nil then
				if not isPrice(arg[key]) then
					return reject(p, "trade.invalid")
				end
				changes[key] = arg[key]
			end
		end
		if arg.Trl ~= nil then
			if not isInt(arg.Trl) then
				return reject(p, "trade.invalid")
			end
			changes.Trl = arg.Trl
		end
		local result = OrderEngine.Modify(d, makeEnv(p, d, "Live"), engineNow(), arg.OrderId, changes)
		if not result.Ok then
			return reject(p, result.Key or "trade.invalid", result.Args)
		end
		notify(p, "trade.modified", nil, "Info")
		return { Ok = true, Key = "trade.modified", OrderId = result.OrderId }
	end)
end

local function basketMembers(key: string): { number }?
	local companies = Config.Companies
	local baskets = type(companies) == "table" and companies.Baskets or nil
	if type(baskets) ~= "table" then
		return nil
	end
	for _, basket in ipairs(baskets) do
		if type(basket) == "table" and basket.Key == key and type(basket.Members) == "table" then
			return basket.Members
		end
	end
	return nil
end

local function handleBasket(p: Player, arg: any): Reply
	if not exactKeys(arg, { Basket = true, Pct = true, Seq = true }) then
		return reject(p, "trade.invalid")
	end
	return withSeq(p, arg, function(d: Depot): Reply
		local closed = tradingOpen(p)
		if closed then
			return reject(p, closed)
		end
		if type(arg.Basket) ~= "string" or #arg.Basket > 32 or (arg.Pct ~= 10 and arg.Pct ~= 25) then
			return reject(p, "trade.invalid")
		end
		local env = makeEnv(p, d, "Live")
		if env.Licence.Index < math.floor(num(trading().TraderFrom, 4)) then
			return reject(p, "trade.basketLocked")
		end
		local members = basketMembers(arg.Basket)
		if not members or #members == 0 then
			return reject(p, "trade.basketUnknown")
		end
		local chips = trading().Chips or { 0.10, 0.25 }
		local pct = if arg.Pct == 10 then num(chips[1], 0.10) else num(chips[2], 0.25)
		local t = engineNow()
		local nav = OrderEngine.NavAt(d, env, t)
		local per = math.floor(pct * nav / #members)
		local done = 0
		local minFee = num(trading().MinFeeCents, 100)
		for _, i in ipairs(members) do
			if isInt(i) and OrderEngine.InstAllowed(env, i) then
				local _, ask = liveQuote(i)
				if ask then
					local qty =
						PortfolioMath.AffordableQty(math.min(per, Portfolio.Free(d)), ask, env.Licence.FeeBps, minFee)
					if qty >= 1 then
						local result =
							OrderEngine.Place(d, env, t, { I = i, Side = "B", Type = "MKT", Qty = qty, Live = true })
						if result.Ok then
							done += 1
						end
					end
				end
			end
		end
		if done == 0 then
			return reject(p, "trade.basketNone")
		end
		notify(p, "trade.basketDone", { done, #members }, "Success")
		return { Ok = true, Key = "trade.basketDone", Fills = done }
	end)
end

local function handleRefill(p: Player, arg: any): Reply
	if arg ~= nil and not exactKeys(arg, {}) then
		return reject(p, "trade.invalid")
	end
	local d = depotOf(p)
	if not d then
		return { Ok = false, Key = "core.loading" }
	end
	if not live[p] then
		return reject(p, "trade.syncing")
	end
	local amount, why = refillInfo(p, d)
	if amount <= 0 then
		return reject(p, why or "trade.refillNotNeeded")
	end
	if not Portfolio.Credit(d, amount, "Refill") then
		return reject(p, "trade.invalid")
	end
	d.LastRefillUtcDay = Util.UtcDay()
	notify(p, "trade.refill", { amount // 100 }, "Success")
	markDirty(p, "Depot")
	flushDirty(p)
	return { Ok = true, Key = "trade.refill", Amount = amount }
end

local function handleAuto(p: Player, arg: any): Reply
	if not exactKeys(arg, { On = true }) or type(arg.On) ~= "boolean" then
		return reject(p, "trade.invalid")
	end
	local d = depotOf(p)
	if not d then
		return { Ok = false, Key = "core.loading" }
	end
	d.AutoTransfer = arg.On
	notify(p, if arg.On then "trade.autoOn" else "trade.autoOff", nil, "Info")
	markDirty(p, "Depot")
	flushDirty(p)
	return { Ok = true }
end

local function handleWatch(p: Player, arg: any): Reply
	if not exactKeys(arg, { List = true, Ids = true }) or not isInt(arg.List) or type(arg.Ids) ~= "table" then
		return reject(p, "trade.invalid")
	end
	local d = depotOf(p)
	if not d then
		return { Ok = false, Key = "core.loading" }
	end
	local cfg = trading().Watch or {}
	local maxIds = math.floor(num(cfg.MaxIds, 12))
	local _, perks = licAndPerks(p)
	local lists = math.min(math.floor(num(perks.Watchlists, 1)), math.floor(num(cfg.MaxLists, 5)))
	if arg.List < 1 or arg.List > lists or arg.List > #d.Watch + 1 then
		return reject(p, "trade.watchLocked")
	end
	local clean, seen = {}, {}
	local count = 0
	for key, id in pairs(arg.Ids) do
		count += 1
		if count > maxIds or type(key) ~= "number" or not isId(id) or not isListed(id) then
			return reject(p, "trade.invalid")
		end
		if not seen[id] then
			seen[id] = true
			table.insert(clean, id)
		end
	end
	if count ~= #arg.Ids then
		return reject(p, "trade.invalid") -- nur lückenlose Listen
	end
	d.Watch[arg.List] = clean
	markDirty(p, "Depot")
	flushDirty(p)
	return { Ok = true }
end

local function handleAlertSet(p: Player, arg: any): Reply
	if not exactKeys(arg, { I = true, Px = true, Dir = true }) then
		return reject(p, "trade.invalid")
	end
	if not isId(arg.I) or not isPrice(arg.Px) or (arg.Dir ~= "Up" and arg.Dir ~= "Down") then
		return reject(p, "trade.invalid")
	end
	local d = depotOf(p)
	if not d then
		return { Ok = false, Key = "core.loading" }
	end
	if not isListed(arg.I) then
		return reject(p, "trade.unknownInst")
	end
	local _, perks = licAndPerks(p)
	local limit = math.min(math.floor(num(perks.Alerts, 3)), math.floor(num(trading().MaxAlertsHard, 18)))
	if #d.Alerts >= limit then
		return reject(p, "trade.alertLimit", { limit })
	end
	local mid = priceAt(arg.I, engineNow())
	local px = math.floor(arg.Px + 0.5)
	local band = num(trading().AlertBand, 0.5)
	if not mid or px < mid * (1 - band) or px > mid * (1 + band) then
		return reject(p, "trade.fatFinger")
	end
	local id = math.max(1, math.floor(num(d.NextId, 1)))
	d.NextId = id + 1
	table.insert(d.Alerts, { Id = id, I = arg.I, Px = px, Dir = arg.Dir })
	notify(p, "trade.alertSet", { tickerOf(arg.I) }, "Info")
	markDirty(p, "Depot")
	flushDirty(p)
	return { Ok = true, Id = id }
end

local function handleAlertRemove(p: Player, arg: any): Reply
	if not exactKeys(arg, { Id = true }) or not isId(arg.Id) then
		return reject(p, "trade.invalid")
	end
	local d = depotOf(p)
	if not d then
		return { Ok = false, Key = "core.loading" }
	end
	for index, a in ipairs(d.Alerts) do
		if a.Id == arg.Id then
			table.remove(d.Alerts, index)
			markDirty(p, "Depot")
			flushDirty(p)
			return { Ok = true }
		end
	end
	return reject(p, "trade.alertNotFound")
end

-- Summe der Kapitalanteile aller laufenden Bots (ohne Platz "except")
local function botCapitalSum(env: Env, d: Depot, except: number?): number
	local sum = 0
	for index, slot in ipairs(d.Bots) do
		if index ~= except and slot.On == true and BotEngine.Preset(slot.Preset) then
			sum += BotEngine.Capital(env, slot)
		end
	end
	return sum
end

local function handleBotSet(p: Player, arg: any): Reply
	if not exactKeys(arg, { Slot = true, Preset = true, Pct = true, Target = true }) then
		return reject(p, "trade.invalid")
	end
	if not isInt(arg.Slot) or type(arg.Preset) ~= "string" or not Util.IsFinite(arg.Pct) then
		return reject(p, "trade.invalid")
	end
	if arg.Target ~= nil and not isId(arg.Target) then
		return reject(p, "trade.invalid")
	end
	local d = depotOf(p)
	if not d then
		return { Ok = false, Key = "core.loading" }
	end
	if not live[p] then
		return reject(p, "trade.syncing")
	end
	local env = makeEnv(p, d, "Live")
	local slots = math.floor(num(env.Perks.BotSlots, env.Licence.BotSlots))
	if arg.Slot < 1 or arg.Slot > slots or arg.Slot > #d.Bots + 1 then
		return reject(p, "trade.botSlots")
	end
	local preset = BotEngine.Preset(arg.Preset)
	if not preset or not BotEngine.Unlocked(env, arg.Preset) then
		return reject(p, "trade.botLocked")
	end
	local pct = arg.Pct
	if pct < num(preset.Min, 0) - 1e-9 or pct > num(preset.Max, 1) + 1e-9 then
		return reject(p, "trade.invalid")
	end
	local target: number? = nil
	if preset.Target == "ETF" then
		target = arg.Target or math.floor(num(preset.DefaultTarget, 40))
		if
			OrderEngine.ClassOf(env, target :: number) ~= "ETF" or not OrderEngine.InstAllowed(env, target :: number)
		then
			return reject(p, "trade.botTarget")
		end
	elseif preset.Target == "Inst" then
		target = arg.Target
		if target == nil or not OrderEngine.InstAllowed(env, target) then
			return reject(p, "trade.botTarget")
		end
	elseif arg.Target ~= nil then
		return reject(p, "trade.botTarget")
	end
	local existing = d.Bots[arg.Slot]
	local slot = BotEngine.NewSlot(arg.Preset, pct, target)
	if type(existing) == "table" then
		if existing.Preset == arg.Preset then
			slot.Q = existing.Q or {} -- gleiche Strategie: Bestände bleiben beim Bot
			slot.On = existing.On == true
			slot.Day, slot.DayVal, slot.DayFlow, slot.DayNav, slot.Last =
				existing.Day, existing.DayVal, existing.DayFlow, existing.DayNav, existing.Last
		else
			OrderEngine.CancelBotOrders(d, arg.Slot) -- neue Strategie: Bestände gehören wieder dir
		end
	end
	if
		slot.On
		and botCapitalSum(env, d, arg.Slot) + BotEngine.Capital(env, slot) > num(trading().BotTotalPct, 0.30) + 1e-9
	then
		return reject(p, "trade.botTotal")
	end
	d.Bots[arg.Slot] = slot
	notify(p, "trade.botSaved", nil, "Success")
	markDirty(p, "Depot")
	flushDirty(p)
	return { Ok = true }
end

local function handleBotToggle(p: Player, arg: any): Reply
	if not exactKeys(arg, { Slot = true, On = true }) or not isInt(arg.Slot) or type(arg.On) ~= "boolean" then
		return reject(p, "trade.invalid")
	end
	local d = depotOf(p)
	if not d then
		return { Ok = false, Key = "core.loading" }
	end
	if not live[p] then
		return reject(p, "trade.syncing")
	end
	local slot = d.Bots[arg.Slot]
	if type(slot) ~= "table" or not BotEngine.Preset(slot.Preset) then
		return reject(p, "trade.botSlots")
	end
	local env = makeEnv(p, d, "Live")
	if arg.On then
		if not BotEngine.Unlocked(env, slot.Preset) then
			return reject(p, "trade.botLocked")
		end
		if botCapitalSum(env, d, arg.Slot) + BotEngine.Capital(env, slot) > num(trading().BotTotalPct, 0.30) + 1e-9 then
			return reject(p, "trade.botTotal")
		end
		slot.On = true
		slot.Paused = false
		notify(p, "trade.botOn", nil, "Success")
	else
		slot.On = false -- Not-Aus: keine neuen Trades, offene Bot-Orders weg, Bestände bleiben
		OrderEngine.CancelBotOrders(d, arg.Slot)
		notify(p, "trade.botOff", nil, "Info")
	end
	markDirty(p, "Depot")
	flushDirty(p)
	return { Ok = true }
end

local function handleHistory(p: Player, arg: any): Reply
	if arg ~= nil and not exactKeys(arg, {}) then
		return reject(p, "trade.invalid")
	end
	local d = depotOf(p)
	if not d then
		return { Ok = false, Key = "core.loading" }
	end
	return { Ok = true, Fills = d.Fills, Nav = d.Nav }
end

local function handleTutorial(p: Player, arg: any): Reply
	if not exactKeys(arg, { Action = true }) then
		return reject(p, "trade.invalid")
	end
	local action = arg.Action
	if action ~= "Start" and action ~= "Buy" and action ~= "Sell" then
		return reject(p, "trade.invalid")
	end
	local data = dataOf(p)
	local d = data and data.Depot
	if type(d) ~= "table" then
		return { Ok = false, Key = "core.loading" }
	end
	if not live[p] then
		return reject(p, "trade.syncing")
	end
	local cfg = tutCfg()
	local done = d.Tutorial.Done == true or (type(data.Flags) == "table" and data.Flags.TutorialTrade == true)
	local now = Clock.Tick()
	local session = tutorials[p]
	if action == "Start" then
		if done then
			return reject(p, "trade.tutDone")
		end
		if session and session.Bought and not session.Ended then
			return { Ok = true, T0 = session.T0 } -- läuft schon (z. B. zweiter Klick)
		end
		tutorials[p] = { T0 = now, Bought = false, Ended = false, Cost = 0 }
		d.Tutorial.T0 = now
		d.Tutorial.Q = 0
		local px = tutPrice(0)
		return { Ok = true, T0 = now, Px = px, I = math.floor(num(cfg.InstId, 250)) }
	end
	if not session or session.Ended then
		return reject(p, "trade.tutNotRunning")
	end
	local dt = now - session.T0
	local px = tutPrice(dt)
	local hs = tutHalfSpread(px)
	local lic = licenceOf(p)
	local minFee = num(trading().MinFeeCents, 100)
	if action == "Buy" then
		if session.Bought then
			return reject(p, "trade.duplicate")
		end
		local ask = px + hs
		local nav = navNow(p, d)
		local budget = math.min(math.floor(num(cfg.Chip, 0.10) * nav), Portfolio.Free(d))
		local qty = PortfolioMath.AffordableQty(budget, ask, lic.FeeBps, minFee)
		if qty < 1 then
			return reject(p, "trade.qtyZero")
		end
		local cost = PortfolioMath.BuyCost(qty, ask, lic.FeeBps, minFee)
		if not Portfolio.Debit(d, cost, "Tutorial") then
			return reject(p, "trade.noCash")
		end
		d.Tutorial.Q = qty
		session.Bought = true
		session.Cost = cost
		call("MetricsService", "Funnel", p, 6, "TutorialTrade")
		markDirty(p, "Depot")
		flushDirty(p)
		notify(p, "trade.tutBought", { qty }, "Success")
		return { Ok = true, Q = qty, Px = ask }
	end
	-- Sell
	if not session.Bought or num(d.Tutorial.Q, 0) <= 0 then
		return reject(p, "trade.noShares")
	end
	local pnl = finishTutorial(p, d, false)
	flushDirty(p)
	return { Ok = true, Pnl = pnl or 0 }
end

-- ---------------------------------------------------------------------
-- 12) STATE (§C10) – nie yielden, nie nil
-- ---------------------------------------------------------------------
local function depotState(p: Player): { [string]: any }
	local d = depotOf(p)
	if not d then
		return {
			Cash = 0,
			Basis = 0,
			Nav = 0,
			Pos = {},
			Orders = {},
			Alerts = {},
			Watch = { {} },
			Bots = {},
			AutoTransfer = true,
			Withdrawable = 0,
			TransferReady = false,
			RefillReady = false,
			Stats = {},
			Pending = 0,
			Syncing = true,
			Tutorial = "None",
		}
	end
	local withdrawable, ready = transferInfo(p, d)
	local refill = if live[p] then refillInfo(p, d) else 0
	return {
		Cash = d.Cash,
		Basis = d.Basis,
		Nav = navNow(p, d),
		Pos = d.Pos,
		Orders = d.Orders,
		Alerts = d.Alerts,
		Watch = d.Watch,
		Bots = d.Bots,
		AutoTransfer = d.AutoTransfer ~= false,
		Withdrawable = withdrawable,
		TransferReady = ready,
		RefillReady = refill > 0,
		Stats = d.Stats,
		Pending = math.floor(num(d.Pending, 0)),
		Syncing = live[p] ~= true,
		Tutorial = OrderService.TutorialState(p),
	}
end

local function leagueState(p: Player): { [string]: any }
	local stats = OrderService.LeagueStats(p)
	local data = dataOf(p)
	local league = data and data.League
	local state: { [string]: any } = table.clone(stats :: any)
	state.Tier = Portfolio.TierOf(stats.SkillScore, stats.Qualified)
	state.LastTier = if type(league) == "table" and type(league.LastTier) == "string" then league.LastTier else "None"
	state.LastWeek = if type(league) == "table" and isInt(league.LastWeek) then league.LastWeek else 0
	return state
end

-- ---------------------------------------------------------------------
-- 13) INIT / START
-- ---------------------------------------------------------------------
function OrderService.Init(services: any)
	Services = services
	Portfolio.SetObserver(onFlow)

	call("PlayerStateService", "Provide", "Depot", depotState)
	call("PlayerStateService", "Provide", "League", leagueState)

	local function Handle(action: string, fn: (Player, any) -> Reply, opts: { [string]: any })
		local ok, err = call("PlayerStateService", "Handle", action, fn, opts)
		if not ok then
			logError("Handle " .. action, err)
		end
	end
	-- Raten laut §C9 (B = Token-Bucket {Kapazität, Nachfüllen/s})
	Handle("TradePlace", handlePlace, { Bucket = { 6, 1.5 } })
	Handle("TradeCancel", handleCancel, { Bucket = { 10, 3 } })
	Handle("TradeModify", handleModify, { Bucket = { 10, 3 } })
	Handle("TradeBasket", handleBasket, { Rate = 1, Per = 2 })
	Handle("TradeRefill", handleRefill, { Rate = 1, Per = 5 })
	Handle("TradeAuto", handleAuto, { Rate = 1, Per = 1 })
	Handle("TradeWatch", handleWatch, { Rate = 1, Per = 1 })
	Handle("AlertSet", handleAlertSet, { Rate = 2, Per = 1 })
	Handle("AlertRemove", handleAlertRemove, { Rate = 2, Per = 1 })
	Handle("BotSet", handleBotSet, { Rate = 2, Per = 1 })
	Handle("BotToggle", handleBotToggle, { Rate = 2, Per = 1 })
	Handle("DepotHistory", handleHistory, { Rate = 1, Per = 1 })
	Handle("TutorialTrade", handleTutorial, { Rate = 2, Per = 1 })
end

function OrderService.Start()
	local okLoaded, errLoaded = call("DataService", "OnProfileLoaded", onProfileLoaded)
	if not okLoaded then
		warn("[OrderService] DataService fehlt – Depots werden nicht geladen: " .. tostring(errLoaded))
	end
	local okTick = call("MarketService", "OnTick", onMarketTick)
	if not okTick then
		warn("[OrderService] MarketService.OnTick fehlt – Orders werden nicht ausgelöst")
	end
	call("MarketService", "OnDayClose", function(_day: number, _t: number)
		-- Tagesabschluss rechnet Step selbst (gleiche Reihenfolge wie offline); hier nur State auffrischen
		for _, p in ipairs(Players:GetPlayers()) do
			if live[p] then
				markDirty(p, "Depot", "League")
			end
		end
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	Scheduler.Every("AcadReplay", 1, function()
		tutorialStep()
	end)
end

-- Nur für Selbsttests (OrderTests): Engine-Module und Hilfen ohne Spieler
OrderService._Test = {
	Portfolio = Portfolio,
	OrderEngine = OrderEngine,
	BotEngine = BotEngine,
	CatchUp = CatchUp,
	TutPrice = tutPrice,
	NormalizeLicence = normalizeLicence,
	BasisFor = basisFor,
	Seq = {
		Duplicate = seqDuplicate,
		Record = recordSeq,
		Store = storeReply,
		Clear = function(key: any)
			replies[key] = nil
		end,
	},
}

return OrderService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">PlayerStateService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Spieler-Zustand, Anfragen, Nachrichten (Server/Services/PlayerStateService)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C5.2 + §C8 + §C9 + §C10 (CC-Kopie 1:1, REUSE §3.10):
--  Request-Verteiler mit Remote-Hygiene, Ready-Gate, State-Flush über eine Schnappschuss-Liste, "Sticky"-Schlüssel
--  + voller State alle 20 s, Leaderstats "Vermögen" (StringValue) + "Etagen" (IntValue).
--
--  Öffentliche API:
--    PlayerStateService.Handle(action, fn(p, arg) -> Reply, opts?)
--        opts { Rate?, Per?, Bucket = { Kapazität, Nachfüllen/s }?, NeedsReady? } – Std: 8 Aufrufe / 1 s, NeedsReady = true.
--        Ablauf je Aufruf (Muss-Regel 10): p.Parent == Players -> globales Limit (Config.Security.Rates.Request)
--        -> Aktionsname -> Aktions-Limit (RateLimiter bzw. Token-Bucket) -> Ready-Gate -> pcall(fn) -> {Ok, Message?, …}.
--        Typ-/Schlüssel-/IsFinite-/Klemm-Prüfung der Argumente macht der Handler des Besitzer-WPs.
--    PlayerStateService.Provide(key, fn(p) -> any)    State-Schlüssel (§C10; nie yielden, nie nil für "leer")
--    PlayerStateService.MarkDirty(p, ...keys)         ohne keys = voller State; Flush alle 0,2 s, voll alle 20 s
--    PlayerStateService.Notify(p, langKey, args?, kind?)          lokalisiert pro Empfänger
--    PlayerStateService.NotifyAll(langKey, args?, kind?, filter?)
--    PlayerStateService.NotifyRaw(p, text, kind?)                 Text ist schon lokalisiert/gefiltert (≤ 500 Zeichen)
--    PlayerStateService.Effect(p, name, strength, data?)          Name aus §C7.4
--    PlayerStateService.EffectAll(name, strength, data?, filter?)
--    PlayerStateService.IsReady(p): boolean
--    PlayerStateService.OnReady(cb(p))                nach Profil + LoadPasses + gestarteter Policy-Anfrage
--    PlayerStateService.LangOf(p): "de" | "en"        Einstellung Settings.Lang, sonst LocaleId
--    PlayerStateService.SetLeaderstat(p, "Vermögen" | "Etagen", value: number | string)
--  Eigene Request-Aktionen: "GetFull" (1/5 s), "SaveSettings" (2/s), "TutorialFlag" { Flag } (2/s).
--  Eigene State-Schlüssel: Settings, Flags, Server = { Version, Studio, NoSave, LocalMarket }.
--  Player-Attribut "PingMs" alle Config.Tech.PingAttrEvery (2) Sekunden.
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Lang = require(Shared:WaitForChild("Lang"))
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local PlayerStateService = {}
local Services: any = nil

type Reply = Types.Reply
type Limit = { Check: (key: any) -> boolean, Clear: (key: any) -> () }
type Handler = {
	Fn: (Player, any) -> Reply,
	Limiter: Limit,
	NeedsReady: boolean,
}

local MAX_ACTION_LEN = 40
local MAX_ARGS = 16
local MAX_SETTINGS_KEYS = 64
local MAX_TEXT = 500
local MAX_LEADER_TEXT = 40
local MAX_MONEY = 9e15
local ERROR_LOG_EVERY = 10
local NOTIFY_DELAY = 2 -- Studio-Hinweis kurz nach dem Beitritt (Client-UI steht dann)

local TECH = Config.Tech
local FLUSH_EVERY = math.max(0.2, tonumber(TECH.StateFlush) or 0.2) -- nie öfter als 5×/s
local FULL_EVERY = math.max(1, tonumber(TECH.FullStateEvery) or 20)
local PING_EVERY = math.max(0.5, tonumber(TECH.PingAttrEvery) or 2)

local function rateFromConfig(name: string, fallbackCalls: number, fallbackPer: number): (number, number)
	local security = Config.Security
	local rates = type(security) == "table" and security.Rates or nil
	local entry = type(rates) == "table" and rates[name] or nil
	if type(entry) == "table" and Util.IsFinite(entry[1]) and Util.IsFinite(entry[2]) and entry[1] >= 1 then
		return entry[1], math.max(0.05, entry[2])
	end
	return fallbackCalls, fallbackPer
end

local requestCalls, requestPer = rateFromConfig("Request", 8, 1)
local requestLimiter = Util.RateLimiter(requestCalls, requestPer)

local handlers: { [string]: Handler } = {}
local providers: { [string]: (Player) -> any } = {}
local providerOrder: { string } = {}

-- Pro-Spieler-Tabellen (alle werden bei PlayerRemoving geleert)
local readyPlayers: { [Player]: boolean } = {}
local setupStarted: { [Player]: boolean } = {}
local dirtyKeys: { [Player]: { [string]: boolean } } = {}
local dirtyFull: { [Player]: boolean } = {}
local fullAt: { [Player]: number } = {}
local pingSent: { [Player]: number } = {}
local funnelLogged: { [Player]: { [string]: boolean } } = {}

local readyCallbacks: { (Player) -> () } = {}
local errorAt: { [string]: number } = {}

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function isPlayer(p: any): boolean
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent == Players
end

-- Fehler höchstens alle 10 s pro Quelle loggen (Exploiter dürfen den Output nicht fluten)
local function logError(source: string, err: any)
	local now = os.clock()
	if now - (errorAt[source] or -math.huge) >= ERROR_LOG_EVERY then
		errorAt[source] = now
		warn(("[PlayerStateService] %s: %s"):format(source, tostring(err)))
	end
end

-- Optionaler Dienst (zur Laufzeit, nil-sicher)
local function service(name: string): any
	return if Services then Services[name] else nil
end

local function dataOf(p: Player): Types.PlayerData?
	local dataService = service("DataService")
	if not dataService then
		return nil
	end
	return dataService.Get(p)
end

local function validKind(kind: any): Types.NotifyKind
	if
		kind == "Info"
		or kind == "Success"
		or kind == "Error"
		or kind == "Event"
		or kind == "Alarm"
		or kind == "Announce"
	then
		return kind
	end
	return "Info"
end

function PlayerStateService.LangOf(p: Player): Types.Lang
	local data = dataOf(p)
	local settings = data and data.Settings
	local override = if type(settings) == "table" and type(settings.Lang) == "string" then settings.Lang else nil
	return Lang.For(p, override)
end

local function localize(p: Player, key: string, args: { any }?): string
	local lang = PlayerStateService.LangOf(p)
	if type(args) == "table" then
		local count = math.min(#args, MAX_ARGS)
		return Lang.T(lang, key, table.unpack(args, 1, count))
	end
	return Lang.T(lang, key)
end

local function fail(p: Player, key: string): Reply
	return { Ok = false, Message = localize(p, key) }
end

local function metrics(fnName: string, ...: any)
	local metricsService = service("MetricsService")
	local fn = metricsService and metricsService[fnName]
	if type(fn) == "function" then
		local ok, err = pcall(fn, ...)
		if not ok then
			logError("MetricsService." .. fnName, err)
		end
	end
end

-- ---------------------------------------------------------------------
-- 2) NACHRICHTEN & EFFEKTE
-- ---------------------------------------------------------------------
function PlayerStateService.NotifyRaw(p: Player, text: string, kind: Types.NotifyKind?)
	if not isPlayer(p) or type(text) ~= "string" or text == "" then
		return
	end
	Remotes.Notify:FireClient(p, string.sub(text, 1, MAX_TEXT), validKind(kind))
end

function PlayerStateService.Notify(p: Player, key: string, args: { any }?, kind: Types.NotifyKind?)
	if not isPlayer(p) or type(key) ~= "string" then
		return
	end
	PlayerStateService.NotifyRaw(p, localize(p, key, args), kind)
end

local function passes(filter: ((Player) -> boolean)?, p: Player): boolean
	if filter == nil then
		return true
	end
	local ok, result = pcall(filter, p)
	if not ok then
		logError("Filter", result)
		return false
	end
	return result == true
end

function PlayerStateService.NotifyAll(
	key: string,
	args: { any }?,
	kind: Types.NotifyKind?,
	filter: ((Player) -> boolean)?
)
	for _, p in ipairs(Players:GetPlayers()) do
		if passes(filter, p) then
			PlayerStateService.Notify(p, key, args, kind)
		end
	end
end

function PlayerStateService.Effect(p: Player, name: string, strength: number, data: any?)
	if not isPlayer(p) or type(name) ~= "string" or name == "" then
		return
	end
	Remotes.Effect:FireClient(p, name, if Util.IsFinite(strength) then strength else 1, data)
end

function PlayerStateService.EffectAll(name: string, strength: number, data: any?, filter: ((Player) -> boolean)?)
	if type(name) ~= "string" or name == "" then
		return
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if passes(filter, p) then
			PlayerStateService.Effect(p, name, strength, data)
		end
	end
end

-- ---------------------------------------------------------------------
-- 3) LEADERSTATS (Spielerliste): "Vermögen" als Text (Zahlen bis 9e15 lesbar), "Etagen" als Ganzzahl
-- ---------------------------------------------------------------------
local LEADERSTATS: { { Name: string, Class: string } } = {
	{ Name = "Vermögen", Class = "StringValue" },
	{ Name = "Etagen", Class = "IntValue" },
}

local function ensureStat(folder: Instance, name: string, className: string): Instance
	local stat = folder:FindFirstChild(name)
	if stat and stat.ClassName == className then
		return stat
	elseif stat then
		stat:Destroy()
	end
	local created = Instance.new(className)
	created.Name = name
	if created:IsA("StringValue") then
		created.Value = "0"
	end
	created.Parent = folder
	return created
end

local function ensureLeaderstats(p: Player): Instance
	local folder = p:FindFirstChild("leaderstats")
	if not (folder and folder:IsA("Folder")) then
		if folder then
			folder:Destroy()
		end
		local created = Instance.new("Folder")
		created.Name = "leaderstats"
		folder = created
	end
	for _, spec in ipairs(LEADERSTATS) do
		ensureStat(folder :: Instance, spec.Name, spec.Class)
	end
	if (folder :: Instance).Parent ~= p then
		(folder :: Instance).Parent = p
	end
	return folder :: Instance
end

function PlayerStateService.SetLeaderstat(p: Player, name: "Vermögen" | "Etagen", value: number | string)
	if not isPlayer(p) then
		return
	end
	local folder = ensureLeaderstats(p)
	if name == "Vermögen" then
		local text: string
		if type(value) == "string" then
			text = string.sub(value, 1, MAX_LEADER_TEXT)
		elseif Util.IsFinite(value) then
			-- eine Anzeige für alle Betrachter -> neutrale Kurzform (1.25M, MAX ab 9e15)
			text = Format.Credits(math.clamp(value :: number, 0, MAX_MONEY), "en")
		else
			return
		end
		local stat = ensureStat(folder, name, "StringValue") :: StringValue
		if stat.Value ~= text then
			stat.Value = text
		end
	elseif name == "Etagen" then
		local number = if type(value) == "string" then tonumber(value) else value
		if not Util.IsFinite(number) then
			return
		end
		local stat = ensureStat(folder, name, "IntValue") :: IntValue
		local clean = math.clamp(math.floor(number :: number), 0, 2 ^ 52)
		if stat.Value ~= clean then
			stat.Value = clean
		end
	end
end

-- ---------------------------------------------------------------------
-- 4) STATE (Provide / MarkDirty / Flush)
-- ---------------------------------------------------------------------
function PlayerStateService.Provide(key: string, fn: (p: Player) -> any)
	if type(key) ~= "string" or key == "" or type(fn) ~= "function" then
		warn("[PlayerStateService] Provide: Schlüssel (string) und Funktion erwartet")
		return
	end
	if providers[key] == nil then
		table.insert(providerOrder, key)
	else
		warn("[PlayerStateService] State-Schlüssel " .. key .. " wird ersetzt")
	end
	providers[key] = fn
end

function PlayerStateService.MarkDirty(p: Player, ...: string)
	if not isPlayer(p) then
		return
	end
	local count = select("#", ...)
	if count == 0 then
		dirtyFull[p] = true
		return
	end
	local set = dirtyKeys[p]
	if not set then
		set = {}
		dirtyKeys[p] = set
	end
	for i = 1, count do
		local key = select(i, ...)
		if type(key) == "string" then
			set[key] = true
		end
	end
end

local function compute(p: Player, key: string): (boolean, any)
	local provider = providers[key]
	if not provider then
		return false, nil
	end
	local ok, value = pcall(provider, p)
	if not ok then
		logError("State-Schlüssel " .. key, value)
		return false, nil
	end
	return true, value
end

local function buildFull(p: Player): { [string]: any }
	local state: { [string]: any } = {}
	for _, key in ipairs(providerOrder) do
		local ok, value = compute(p, key)
		if ok and value ~= nil then
			state[key] = value
		end
	end
	return state
end

local function flushPlayer(p: Player, now: number)
	local full = dirtyFull[p] == true or now - (fullAt[p] or -math.huge) >= FULL_EVERY
	if full then
		fullAt[p] = now
		dirtyFull[p] = nil
		dirtyKeys[p] = nil
		Remotes.State:FireClient(p, buildFull(p), true)
		return
	end
	local keys = dirtyKeys[p]
	if not keys then
		return
	end
	dirtyKeys[p] = nil
	local partial: { [string]: any } = {}
	local any = false
	for key in pairs(keys) do
		local ok, value = compute(p, key)
		if ok and value ~= nil then
			partial[key] = value
			any = true
		end
	end
	if any then
		Remotes.State:FireClient(p, partial, false)
	end
end

-- Schnappschuss-Liste: Provider dürfen MarkDirty aufrufen, ohne die Iteration zu stören
local flushList: { Player } = {}
local function flushAll()
	local now = os.clock()
	table.clear(flushList)
	for p in pairs(readyPlayers) do
		table.insert(flushList, p)
	end
	for _, p in ipairs(flushList) do
		if readyPlayers[p] and p.Parent == Players then
			local ok, err = pcall(flushPlayer, p, now)
			if not ok then
				logError("State an " .. p.Name, err)
			end
		end
	end
	-- Reste von Spielern, die schon weg sind (z. B. MarkDirty nach PlayerRemoving), aufräumen
	for p in pairs(dirtyKeys) do
		if p.Parent ~= Players then
			dirtyKeys[p] = nil
		end
	end
	for p in pairs(dirtyFull) do
		if p.Parent ~= Players then
			dirtyFull[p] = nil
		end
	end
end

local function updatePings()
	for _, p in ipairs(Players:GetPlayers()) do
		local ok, ping = pcall(function()
			return p:GetNetworkPing()
		end)
		if ok and Util.IsFinite(ping) then
			local ms = math.clamp(math.floor(ping * 1000 + 0.5), 0, 99999)
			if pingSent[p] ~= ms then
				pingSent[p] = ms
				p:SetAttribute("PingMs", ms)
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- 5) EINSTELLUNGEN (Schema Config.Client.SettingsSchema)
-- ---------------------------------------------------------------------
local function settingsSpec(): ({ [string]: any }, { [string]: any })
	local client = Config.Client
	local defaults = if type(client) == "table" and type(client.DefaultSettings) == "table"
		then client.DefaultSettings
		else {}
	local schema = if type(client) == "table" and type(client.SettingsSchema) == "table"
		then client.SettingsSchema
		else {}
	return defaults, schema
end

-- Schema-Eintrag zu einem Schlüssel. Verschachtelte Einstellungen (z. B. Indicators) dürfen als
-- { Type = "table", Fields = {…} }, als Tabelle von Einträgen oder als "Key.Feld"-Schlüssel stehen.
local function entryFor(schema: { [string]: any }, key: string): any
	local entry = schema[key]
	if type(entry) == "table" then
		if entry.Type ~= nil or type(entry.Fields) == "table" then
			return entry
		end
		-- Tabelle aus Feld-Einträgen ohne eigenen Typ
		local fields: { [string]: any } = {}
		local found = false
		for field, sub in pairs(entry) do
			if type(field) == "string" and type(sub) == "table" and sub.Type ~= nil then
				fields[field] = sub
				found = true
			end
		end
		return if found then { Type = "table", Fields = fields } else nil
	end
	-- "Key.Feld"-Schreibweise
	local prefix = key .. "."
	local fields: { [string]: any } = {}
	local found = false
	for name, sub in pairs(schema) do
		if type(name) == "string" and string.sub(name, 1, #prefix) == prefix and type(sub) == "table" then
			fields[string.sub(name, #prefix + 1)] = sub
			found = true
		end
	end
	return if found then { Type = "table", Fields = fields } else nil
end

-- Prüft/klemmt einen Wert. base = bisheriger Wert (für verschachtelte Tabellen: nur geänderte Felder).
local function checkValue(entry: any, value: any, base: any, depth: number): (boolean, any)
	if type(entry) ~= "table" or depth > 3 then
		return false, nil
	end
	local kind = entry.Type
	if kind == "number" then
		if not Util.IsFinite(value) then
			return false, nil
		end
		local v = value
		local step = entry.Step
		if Util.IsFinite(step) and step > 0 then
			v = math.floor(v / step + 0.5) * step
		end
		if entry.Integer == true then
			v = math.floor(v + 0.5)
		end
		if Util.IsFinite(entry.Min) then
			v = math.max(v, entry.Min)
		end
		if Util.IsFinite(entry.Max) then
			v = math.min(v, entry.Max)
		end
		return true, v
	elseif kind == "boolean" then
		return type(value) == "boolean", value
	elseif kind == "enum" then
		local options = entry.Options
		if type(options) ~= "table" then
			return false, nil
		end
		for _, option in ipairs(options) do
			if option == value then
				return true, value
			end
		end
		return false, nil
	elseif kind == "string" then
		if type(value) ~= "string" then
			return false, nil
		end
		local maxLen = if Util.IsFinite(entry.MaxLen) then math.max(0, entry.MaxLen) else 32
		return true, string.sub(value, 1, maxLen)
	elseif kind == "table" or type(entry.Fields) == "table" then
		local fields = entry.Fields
		if type(value) ~= "table" or type(fields) ~= "table" then
			return false, nil
		end
		local clean: { [string]: any } = if type(base) == "table" then Util.DeepCopy(base) else {}
		local any = false
		for field, fieldEntry in pairs(fields) do
			local fieldValue = value[field]
			if fieldValue ~= nil then
				local ok, cleanValue = checkValue(fieldEntry, fieldValue, clean[field], depth + 1)
				if ok then
					clean[field] = cleanValue
					any = true
				end
			end
		end
		return any, clean
	end
	return false, nil
end

-- Beim Laden: kaputte Werte auf Standard, unbekannte Schlüssel weg (nur wenn ein Schema existiert)
local function sanitizeSettings(data: Types.PlayerData)
	local defaults, schema = settingsSpec()
	if next(defaults) == nil then
		return
	end
	if type(data.Settings) ~= "table" then
		data.Settings = Util.DeepCopy(defaults)
		return
	end
	local settings = data.Settings
	for _, key in ipairs(Util.Snapshot(settings)) do
		local default = defaults[key]
		local value = settings[key]
		if type(key) ~= "string" or (default == nil and schema[key] == nil) then
			settings[key] = nil
		else
			local entry = entryFor(schema, key)
			if entry then
				local ok, clean = checkValue(entry, value, default, 1)
				if ok then
					settings[key] = clean
				else
					settings[key] = Util.DeepCopy(default)
				end
			elseif default ~= nil and type(value) ~= type(default) then
				settings[key] = Util.DeepCopy(default)
			end
		end
	end
	Util.Reconcile(settings, defaults)
end

-- ---------------------------------------------------------------------
-- 6) ANFRAGEN (Request.OnServerInvoke)
-- ---------------------------------------------------------------------
function PlayerStateService.Handle(
	action: string,
	fn: (p: Player, arg: any) -> Types.Reply,
	opts: { Rate: number?, Per: number?, Bucket: { number }?, NeedsReady: boolean? }?
)
	if type(action) ~= "string" or action == "" or #action > MAX_ACTION_LEN or type(fn) ~= "function" then
		warn("[PlayerStateService] Handle: Aktionsname (1–40 Zeichen) und Funktion erwartet")
		return
	end
	if not string.match(action, "^%a+$") then
		warn("[PlayerStateService] Handle: Aktionsnamen nur aus Buchstaben (§C9): " .. action)
	end
	local options = opts or {}
	local limiter: Limit
	local bucket = options.Bucket
	if type(bucket) == "table" and Util.IsFinite(bucket[1]) and Util.IsFinite(bucket[2]) and bucket[1] >= 1 then
		-- Token-Bucket { Kapazität, Nachfüllen/s } (z. B. TradePlace B 6/1,5)
		local tokens = Util.TokenBucket(bucket[1], math.max(0, bucket[2]))
		limiter = {
			Check = function(key: any): boolean
				return tokens.Take(key, 1)
			end,
			Clear = tokens.Clear,
		}
	else
		local rate = if Util.IsFinite(options.Rate) and (options.Rate :: number) >= 1 then options.Rate :: number else 8
		local per = if Util.IsFinite(options.Per) and (options.Per :: number) > 0 then options.Per :: number else 1
		local window = Util.RateLimiter(rate, per)
		limiter = { Check = window.Check, Clear = window.Clear }
	end
	if handlers[action] then
		warn("[PlayerStateService] Aktion " .. action .. " wird ersetzt")
	end
	handlers[action] = {
		Fn = fn,
		Limiter = limiter,
		NeedsReady = options.NeedsReady ~= false,
	}
end

local function normalize(result: any): Reply
	if type(result) ~= "table" then
		return { Ok = result == true }
	end
	result.Ok = result.Ok == true
	if result.Message ~= nil and type(result.Message) ~= "string" then
		result.Message = tostring(result.Message)
	end
	return result
end

-- Reihenfolge (Muss-Regel 10): p.Parent -> globales Limit -> Aktion -> Aktions-Limit -> Ready -> pcall -> Tabelle
local function dispatch(p: Player, action: any, arg: any): Reply
	if p.Parent ~= Players then
		return { Ok = false } -- schon gegangen: keine Limiter-Einträge mehr anlegen (PlayerRemoving hat aufgeräumt)
	end
	if not requestLimiter.Check(p) then
		return fail(p, "core.tooFast")
	end
	if type(action) ~= "string" or #action == 0 or #action > MAX_ACTION_LEN then
		return fail(p, "core.unknownAction")
	end
	local handler = handlers[action]
	if not handler then
		return fail(p, "core.unknownAction")
	end
	if not handler.Limiter.Check(p) then
		return fail(p, "core.tooFast")
	end
	if handler.NeedsReady and not readyPlayers[p] then
		return fail(p, "core.loading")
	end
	local ok, result = pcall(handler.Fn, p, arg)
	if not ok then
		logError("Aktion " .. action, result)
		return fail(p, "core.error")
	end
	return normalize(result)
end

-- Eigene Aktionen ------------------------------------------------------
-- Tutorial-/Hinweis-Flags, die NUR der Client kennt (Ladebildschirm, Kamera-Anflug, gesehene Fenster).
-- Funnel: Schritte, die nur der Client erlebt (§B2), werden hier geloggt (MetricsService dedupliziert je Sitzung).
local TUTORIAL_FLAGS: { [string]: any } = { -- true = nur Flag, { Step, Name } = Flag + Funnel-Schritt
	SplashDone = { Step = 2, Name = "SplashDone" },
	FlyInDone = { Step = 3, Name = "Spawned" },
	Welcome = true,
	Done = true,
	Skipped = true,
	DisclaimerSeen = true,
	TerminalSeen = true,
	TowerSeen = true,
	ShopSeen = true,
	SettingsSeen = true,
	CalendarSeen = true,
	FavoritePrompted = { Step = 16, Name = "FavoritePrompted" },
}

local function handleGetFull(p: Player, _arg: any): Reply
	return { Ok = true, State = buildFull(p) }
end

local function handleSaveSettings(p: Player, arg: any): Reply
	if type(arg) ~= "table" then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	if type(data.Settings) ~= "table" then
		data.Settings = {}
	end
	local settings = data.Settings
	local _, schema = settingsSpec()
	local changed = 0
	local seen = 0
	for key, value in pairs(arg) do
		seen += 1
		if seen > MAX_SETTINGS_KEYS then
			break
		end
		if type(key) == "string" and #key <= MAX_ACTION_LEN then
			local entry = entryFor(schema, key)
			if entry then
				local ok, clean = checkValue(entry, value, settings[key], 1)
				if ok then
					settings[key] = clean
					changed += 1
				end
			end
		end
	end
	if changed == 0 then
		return fail(p, "core.invalid")
	end
	PlayerStateService.MarkDirty(p, "Settings")
	return { Ok = true }
end

local function handleTutorialFlag(p: Player, arg: any): Reply
	-- exakte Schlüssel: { Flag = string }
	if type(arg) ~= "table" or type(arg.Flag) ~= "string" or #arg.Flag > MAX_ACTION_LEN then
		return fail(p, "core.invalid")
	end
	for key in pairs(arg) do
		if key ~= "Flag" then
			return fail(p, "core.invalid")
		end
	end
	local flag = arg.Flag
	local spec = TUTORIAL_FLAGS[flag]
	if spec == nil then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	if type(data.Flags) ~= "table" then
		data.Flags = {}
	end
	local flags = data.Flags
	local first = flags[flag] ~= true
	flags[flag] = true
	if flag == "Done" or flag == "Skipped" then
		flags.Done = true
		flags.Tutorial = true -- CC-Kompatibilität: "Tutorial abgeschlossen"
	end
	if type(spec) == "table" then
		local logged = funnelLogged[p]
		if not logged then
			logged = {}
			funnelLogged[p] = logged
		end
		if not logged[flag] then
			logged[flag] = true
			metrics("Funnel", p, spec.Step, spec.Name)
		end
	end
	if first and flag == "Skipped" then
		metrics("Custom", p, "TutorialSkipped", 1, nil)
	end
	PlayerStateService.MarkDirty(p, "Flags")
	return { Ok = true }
end

-- ---------------------------------------------------------------------
-- 7) READY-GATE: Profil geladen -> Pässe geprüft -> Policy-Anfrage gestartet -> bereit
-- ---------------------------------------------------------------------
function PlayerStateService.IsReady(p: Player): boolean
	return readyPlayers[p] == true
end

local function runReady(callback: (Player) -> (), p: Player)
	local ok, err = xpcall(callback, debug.traceback, p)
	if not ok then
		warn("[PlayerStateService] OnReady-Callback Fehler: " .. tostring(err))
	end
end

function PlayerStateService.OnReady(callback: (p: Player) -> ())
	if type(callback) ~= "function" then
		return
	end
	table.insert(readyCallbacks, callback)
	-- später registriert: schon bereite Spieler nachreichen
	for p in pairs(readyPlayers) do
		task.spawn(runReady, callback, p)
	end
end

-- Startwerte der Spielerliste (Vermögen kommt danach laufend von ProgressionService, WP9)
local function initialLeaderstats(p: Player, data: Types.PlayerData)
	local tower = data.Tower
	local floors = if type(tower) == "table" and type(tower.Floors) == "table" then #tower.Floors else 0
	PlayerStateService.SetLeaderstat(p, "Etagen", floors)
	local wealth = if Util.IsFinite(data.Credits) then data.Credits else 0
	local progression = service("ProgressionService")
	if progression and type(progression.Wealth) == "function" then
		local ok, value = pcall(progression.Wealth, p)
		if ok and Util.IsFinite(value) then
			wealth = value
		end
	end
	PlayerStateService.SetLeaderstat(p, "Vermögen", wealth)
end

local function onProfileLoaded(p: Player, data: Types.PlayerData)
	if setupStarted[p] or p.Parent ~= Players then
		return
	end
	setupStarted[p] = true

	-- Spielerliste
	ensureLeaderstats(p)
	local okStats, errStats = pcall(initialLeaderstats, p, data)
	if not okStats then
		logError("Leaderstats", errStats)
	end

	-- Einstellungen reparieren (Schema kann sich seit dem letzten Besuch geändert haben)
	local okSettings, errSettings = pcall(sanitizeSettings, data)
	if not okSettings then
		logError("Einstellungen", errSettings)
	end

	-- Gamepässe prüfen (yieldet, 3 Versuche) und Policy-Anfrage starten (MonetizationService, WP10)
	local monetization = service("MonetizationService")
	if monetization then
		if type(monetization.LoadPasses) == "function" then
			local ok, err = pcall(monetization.LoadPasses, p)
			if not ok then
				logError("MonetizationService.LoadPasses", err)
			end
		end
		if type(monetization.RandomAllowed) == "function" then
			task.spawn(function()
				local ok, err = pcall(monetization.RandomAllowed, p)
				if not ok then
					logError("MonetizationService.RandomAllowed", err)
				end
			end)
		end
	end

	local dataService = service("DataService")
	if p.Parent ~= Players or not dataService or dataService.Get(p) ~= data then
		return -- inzwischen gegangen
	end
	readyPlayers[p] = true
	dirtyFull[p] = true -- voller State beim nächsten Flush (≤ 0,2 s)
	for _, callback in ipairs(readyCallbacks) do
		task.spawn(runReady, callback, p)
	end

	-- Studio: "Fortschritt wird nicht gespeichert"
	if dataService.IsNoSave(p) then
		local reason = if type(dataService.NoSaveReason) == "function" then dataService.NoSaveReason(p) else nil
		task.delay(NOTIFY_DELAY, function()
			if p.Parent == Players then
				PlayerStateService.Notify(p, "core.studioNoSave", nil, "Info")
				if reason == "NoApi" then
					PlayerStateService.Notify(p, "core.studioNoApi", nil, "Alarm")
				end
			end
		end)
	end
end

local function onPlayerRemoving(p: Player)
	readyPlayers[p] = nil
	setupStarted[p] = nil
	dirtyKeys[p] = nil
	dirtyFull[p] = nil
	fullAt[p] = nil
	pingSent[p] = nil
	funnelLogged[p] = nil
	requestLimiter.Clear(p)
	for _, handler in pairs(handlers) do
		handler.Limiter.Clear(p)
	end
end

-- ---------------------------------------------------------------------
-- 8) INIT / START
-- ---------------------------------------------------------------------
local function localMarket(): boolean
	local market = service("MarketService")
	if market and type(market.IsLocalMarket) == "function" then
		local ok, result = pcall(market.IsLocalMarket)
		return ok and result == true
	end
	return false
end

function PlayerStateService.Init(services: any)
	Services = services

	-- eigene State-Schlüssel (§C10)
	PlayerStateService.Provide("Settings", function(p: Player)
		local data = dataOf(p)
		return if data and type(data.Settings) == "table" then data.Settings else {}
	end)
	PlayerStateService.Provide("Flags", function(p: Player)
		local data = dataOf(p)
		return if data and type(data.Flags) == "table" then data.Flags else {}
	end)
	PlayerStateService.Provide("Server", function(p: Player)
		local dataService = service("DataService")
		return {
			Version = Config.Version,
			Studio = RunService:IsStudio(),
			NoSave = dataService ~= nil and dataService.IsNoSave(p) == true,
			LocalMarket = localMarket(),
		}
	end)

	-- eigene Aktionen (§C9)
	PlayerStateService.Handle("GetFull", handleGetFull, { Rate = 1, Per = 5 })
	PlayerStateService.Handle("SaveSettings", handleSaveSettings, { Rate = 2, Per = 1 })
	PlayerStateService.Handle("TutorialFlag", handleTutorialFlag, { Rate = 2, Per = 1 })
end

function PlayerStateService.Start()
	Remotes.Request.OnServerInvoke = function(p: Player, action: any, arg: any)
		local ok, result = pcall(dispatch, p, action, arg)
		if ok then
			return result
		end
		logError("Request", result)
		return { Ok = false, Message = Lang.T("en", "core.error") }
	end

	local dataService = service("DataService")
	if dataService then
		dataService.OnProfileLoaded(onProfileLoaded)
	else
		warn("[PlayerStateService] DataService fehlt – niemand wird bereit")
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	Scheduler.Every("StateFlush", 1 / FLUSH_EVERY, function()
		flushAll()
	end)
	Scheduler.Every("PingAttr", 1 / PING_EVERY, function()
		updatePings()
	end)
end

return PlayerStateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Bauplätze, Besuche, Aufzug (Server/Services/PlotService)
--  Besitzer: WP6 (Turm-Ökonomie). Vertrag: DESIGN.md §C5.5 (PlotService), §C9 (TowerVisit/TowerHome/TowerElevator),
--  §C10 (State Plot), §B3 (Plot-Zuweisung mit Freunde-Nachbarschaft), §B4.10 (Aufzug, Besuche, Privat-Etagen).
--
--  * 10 Plots am Skyline-Ring (Config.Server.Plots). Beim Beitritt: freier Plot neben einem Freund im Server
--    (IsFriendsWithAsync, pcall, je Paar gecacht), sonst der nächste freie im Uhrzeigersinn ab Plot 1.
--  * Beim Verlassen: Plot frei, Besucher höflich zur Plaza teleportiert (AntiCheatService.NoteTeleport), Kran-Abbau
--    über TowerVisualService.Clear.
--  * Teleports immer serverseitig: erst Player:RequestStreamAroundAsync (StreamingEnabled), dann NoteTeleport +
--    PivotTo. Ziel-CFrames sind FUSSPUNKTE (Boden-Oberfläche); die Wurzel-Höhe rechnet Teleport selbst dazu.
--  * Geometrie (Config.Tower.Geometry): Plot-LookVector zeigt nach vorn (zur Plaza); Etage n beginnt auf Höhe
--    (n − 1) × FloorHeight; Aufzugs-Ankunft = Plot-Mitte + vorn × ElevatorLanding, Höhe + Slab. Etage 1 = Lobby.
--
--  Öffentliche API (§C5.5):
--    PlotService.PlotOf(p): number?            PlotService.OwnerOf(plot): Player?
--    PlotService.PlotCFrame(plot): CFrame      Plot-Mitte am Boden (CityService.PlotSite, sonst Ring-Formel §A5)
--    PlotService.LobbyCFrame(plot): CFrame     Fußpunkt vor der Aufzugstür im Erdgeschoss
--    PlotService.IsOnOwnPlot(p): boolean       waagerecht ≤ Config.Tower.CollectRange (70) zur Plot-Mitte
--    PlotService.Teleport(p, cf, sync?): boolean   + AntiCheatService.NoteTeleport (sync = erst nach dem Versetzen zurück)
--  Ergänzungen: PlotService.FloorCFrame(plot, floor): CFrame · PlotService.TowerAt(position): number?
--    PlotService.VisitingOf(p): number?   (UserId des besuchten Towers)
--  Request-Handler: TowerVisit {UserId} (1/2 s), TowerHome {} (1/2 s), TowerElevator {Floor} (2/s)
--  State: Plot = { Id, Visiting? }. Attribut am Player: "Plot" (Nummer, 0 = keiner).
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))
local Lang = require(Shared:WaitForChild("Lang"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local PlotService = {}
local Services: any = nil

type Reply = Types.Reply

local PREFIX = "[PlotService] "
local FRIEND_BUDGET = 4 -- Sekunden: so lange darf die Freundes-Suche beim Beitritt höchstens dauern
local FRIEND_CACHE_MAX = 400
local SPAWN_WAIT = 10 -- Sekunden auf HumanoidRootPart warten
local ERROR_LOG_EVERY = 10

local TCFG: { [string]: any } = if type(Config.Tower) == "table" then Config.Tower else {}

local function num(v: any, default: number): number
	return if Util.IsFinite(v) then v else default
end

local function sub(t: any, key: string): { [string]: any }
	local v = if type(t) == "table" then t[key] else nil
	return if type(v) == "table" then v else {}
end

local function plotCount(): number
	local server = Config.Server
	local n = if type(server) == "table" then server.Plots else nil
	return math.clamp(math.floor(num(n, 10)), 1, 32)
end

local PLOTS = plotCount()
local FLOORS = math.clamp(math.floor(num(TCFG.Floors, 50)), 1, 50)
local GEOMETRY = sub(TCFG, "Geometry")
local VISIT = sub(TCFG, "Visit")
local FLOOR_HEIGHT = num(TCFG.FloorHeight, 12)
local SLAB = num(GEOMETRY.Slab, 1)
local LANDING = num(GEOMETRY.ElevatorLanding, 8)
local TOWER_RADIUS = num(VISIT.TowerRadius, 55)

-- ---------------------------------------------------------------------
-- 1) ZUSTAND (pro Spieler bei PlayerRemoving geleert)
-- ---------------------------------------------------------------------
local owners: { [number]: Player } = {} -- Plot -> Besitzer
local plots: { [Player]: number } = {} -- Besitzer -> Plot
local visiting: { [Player]: number } = {} -- Besucher -> UserId des besuchten Towers
local visitedSession: { [Player]: { [number]: boolean } } = {} -- für Quest "VisitTower" (1× je Tower/Sitzung)
local assigning: { [Player]: boolean } = {}
local friendCache: { [string]: boolean } = {}
local friendCacheCount = 0
local errorLogAt: { [string]: number } = {}
local characterConnections: { [Player]: RBXScriptConnection } = {}

local function logError(where: string, err: any)
	local t = os.clock()
	if t - (errorLogAt[where] or -math.huge) >= ERROR_LOG_EVERY then
		errorLogAt[where] = t
		warn(PREFIX .. where .. ": " .. tostring(err))
	end
end

local function call(serviceName: string, fnName: string, ...: any): (boolean, any, any)
	local s = Services and Services[serviceName]
	local fn = if type(s) == "table" then s[fnName] else nil
	if type(fn) ~= "function" then
		return false, nil, nil
	end
	local ok, a, b = pcall(fn, ...)
	if not ok then
		logError(serviceName .. "." .. fnName, a)
		return false, nil, nil
	end
	return true, a, b
end

local function langOf(p: Player): Types.Lang
	local ok, lang = call("PlayerStateService", "LangOf", p)
	if ok and (lang == "de" or lang == "en") then
		return lang
	end
	return Lang.For(p)
end

local function fail(p: Player, key: string, args: { any }?): Reply
	local lang = langOf(p)
	return { Ok = false, Message = if args then Lang.T(lang, key, table.unpack(args)) else Lang.T(lang, key) }
end

local function okReply(p: Player, key: string?, args: { any }?): Reply
	if not key then
		return { Ok = true }
	end
	local lang = langOf(p)
	return { Ok = true, Message = if args then Lang.T(lang, key, table.unpack(args)) else Lang.T(lang, key) }
end

local function markDirty(p: Player, ...: string)
	call("PlayerStateService", "MarkDirty", p, ...)
end

local function dataOf(p: Player): { [string]: any }?
	local ok, data = call("DataService", "Get", p)
	if ok and type(data) == "table" and type(data.Tower) == "table" then
		return data
	end
	return nil
end

local function isAdmin(p: Player): boolean
	local ok, result = call("AdminService", "IsAdmin", p)
	return ok and result == true
end

local function rootOf(p: Player): BasePart?
	local character = p.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function validPlot(plot: any): boolean
	return Util.IsFinite(plot) and plot % 1 == 0 and plot >= 1 and plot <= PLOTS
end

-- ---------------------------------------------------------------------
-- 2) GEOMETRIE
-- ---------------------------------------------------------------------
-- Ring-Formel (§A5): R 420, Winkel 18° + (k − 1) · 36°, LookVector zur Plaza-Mitte
local function ringCFrame(plot: number): CFrame
	local city = Config.City
	local ring = if type(city) == "table" and type(city.Plots) == "table" then city.Plots else sub(TCFG, "Plots")
	local fallback = sub(TCFG, "Plots")
	local radius = num(ring.Radius, num(fallback.Radius, 420))
	local start = num(ring.StartAngle, num(fallback.StartAngle, 18))
	local step = num(ring.Step, num(fallback.Step, 360 / PLOTS))
	local angle = math.rad(start + (plot - 1) * step)
	local position = Vector3.new(radius * math.cos(angle), 0, radius * math.sin(angle))
	return CFrame.lookAt(position, Vector3.new(0, 0, 0))
end

-- Plot-Mitten von CityService werden gemerkt (statisch); ohne CityService gilt die Ring-Formel
local siteCache: { [number]: CFrame } = {}

function PlotService.PlotCFrame(plot: number): CFrame
	if not validPlot(plot) then
		return CFrame.identity
	end
	local cached = siteCache[plot]
	if cached then
		return cached
	end
	local ok, cf = call("CityService", "PlotSite", plot)
	if ok and typeof(cf) == "CFrame" and Util.IsFiniteVector(cf.Position) then
		siteCache[plot] = cf
		return cf
	end
	return ringCFrame(plot)
end

-- Fußpunkt vor der Aufzugstür auf Etage floor (1 = Erdgeschoss/Lobby)
function PlotService.FloorCFrame(plot: number, floor: number): CFrame
	local base = PlotService.PlotCFrame(plot)
	local level = math.clamp(math.floor(num(floor, 1)), 1, FLOORS)
	return base * CFrame.new(0, (level - 1) * FLOOR_HEIGHT + SLAB, -LANDING)
end

function PlotService.LobbyCFrame(plot: number): CFrame
	return PlotService.FloorCFrame(plot, 1)
end

local function horizontalDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- In welchem Plot steht diese Position (waagerecht ≤ Config.Tower.Visit.TowerRadius)?
function PlotService.TowerAt(position: Vector3): number?
	if typeof(position) ~= "Vector3" then
		return nil
	end
	for plot = 1, PLOTS do
		if horizontalDistance(position, PlotService.PlotCFrame(plot).Position) <= TOWER_RADIUS then
			return plot
		end
	end
	return nil
end

local function plazaCFrame(): CFrame
	local ok, cf = call("CityService", "Anchor", "Spawn")
	if ok and typeof(cf) == "CFrame" then
		return cf
	end
	local fallback = VISIT.PlazaFallback
	if type(fallback) == "table" then
		return CFrame.new(num(fallback[1], 0), num(fallback[2], 4), num(fallback[3], 60))
	end
	return CFrame.new(0, 4, 60)
end

-- ---------------------------------------------------------------------
-- 3) ÖFFENTLICHE ABFRAGEN
-- ---------------------------------------------------------------------
function PlotService.PlotOf(p: Player): number?
	return plots[p]
end

function PlotService.OwnerOf(plot: number): Player?
	local owner = owners[plot]
	if owner and owner.Parent == Players then
		return owner
	end
	return nil
end

function PlotService.VisitingOf(p: Player): number?
	return visiting[p]
end

function PlotService.IsOnOwnPlot(p: Player): boolean
	local plot = plots[p]
	local root = rootOf(p)
	if not plot or not root then
		return false
	end
	local range = num(TCFG.CollectRange, 70)
	return horizontalDistance(root.Position, PlotService.PlotCFrame(plot).Position) <= range
end

-- ---------------------------------------------------------------------
-- 4) TELEPORT (Fußpunkt -> Wurzel-Höhe; Streaming zuerst; AntiCheat-Gnade direkt vor dem Versetzen)
-- ---------------------------------------------------------------------
local function rootOffset(humanoid: Humanoid, root: BasePart): number
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		return root.Size.Y * 0.5 + 2
	end
	return humanoid.HipHeight + root.Size.Y * 0.5
end

-- sync = true: erst nach dem Versetzen zurückkehren (yieldet bis Visit.StreamTimeout; nur aus Anfragen/Threads) –
-- z. B. der Aufzug: seine Antwort heißt "angekommen", die Kinoszene gibt die Kamera erst danach zurück
function PlotService.Teleport(p: Player, cf: CFrame, sync: boolean?): boolean
	if typeof(p) ~= "Instance" or not p:IsA("Player") or p.Parent ~= Players or typeof(cf) ~= "CFrame" then
		return false
	end
	if not Util.IsFiniteVector(cf.Position) then
		return false
	end
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = rootOf(p)
	if not character or not humanoid or not root or humanoid.Health <= 0 then
		return false
	end
	if humanoid.SeatPart ~= nil then
		return false -- erst aussteigen (Sitz-Schweißung würde das Auto mitziehen)
	end
	local target = cf + Vector3.new(0, rootOffset(humanoid, root), 0)
	local function move(): boolean
		local timeout = num(VISIT.StreamTimeout, 2)
		if timeout > 0 then
			pcall(function()
				p:RequestStreamAroundAsync(target.Position, timeout)
			end)
		end
		if p.Parent ~= Players or p.Character ~= character or humanoid.Health <= 0 or humanoid.SeatPart ~= nil then
			return false
		end
		call("AntiCheatService", "NoteTeleport", p, target)
		local ok, err = pcall(function()
			character:PivotTo(target)
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end)
		if not ok then
			logError("Teleport", err)
		end
		return ok
	end
	if sync == true then
		return move()
	end
	task.spawn(move)
	return true
end

-- Vorplatz vor dem eigenen Tower (Blick zum Tower)
local function spawnCFrame(plot: number): CFrame
	local base = PlotService.PlotCFrame(plot)
	local position = (base * CFrame.new(0, 0.5, -num(VISIT.SpawnOffset, 40))).Position
	local center = base.Position
	return CFrame.lookAt(position, Vector3.new(center.X, position.Y, center.Z))
end

local function placeAtPlot(p: Player)
	local plot = plots[p]
	if not plot or VISIT.SpawnAtPlot == false then
		return
	end
	PlotService.Teleport(p, spawnCFrame(plot))
end

-- ---------------------------------------------------------------------
-- 5) ZUWEISUNG MIT FREUNDE-NACHBARSCHAFT (§B3)
-- ---------------------------------------------------------------------
local function pairKey(a: number, b: number): string
	return if a < b then a .. ":" .. b else b .. ":" .. a
end

local function areFriends(a: Player, b: Player): boolean
	if a.UserId <= 0 or b.UserId <= 0 then
		return false -- Studio-Testspieler: IsFriendsWithAsync scheitert ohnehin
	end
	local key = pairKey(a.UserId, b.UserId)
	local cached = friendCache[key]
	if cached ~= nil then
		return cached
	end
	local ok, result = pcall(function()
		return a:IsFriendsWithAsync(b.UserId)
	end)
	local value = ok and result == true
	if ok and friendCacheCount < FRIEND_CACHE_MAX then
		friendCache[key] = value
		friendCacheCount += 1
	end
	return value
end

local function isFree(plot: number): boolean
	local owner = owners[plot]
	return owner == nil or owner.Parent ~= Players
end

local function neighbours(plot: number): { number }
	local left = if plot == 1 then PLOTS else plot - 1
	local right = if plot == PLOTS then 1 else plot + 1
	return { right, left }
end

local function pickPlot(friendPlots: { number }): number?
	for _, plot in ipairs(friendPlots) do
		for _, candidate in ipairs(neighbours(plot)) do
			if isFree(candidate) then
				return candidate
			end
		end
	end
	for plot = 1, PLOTS do
		if isFree(plot) then
			return plot
		end
	end
	return nil
end

local function assign(p: Player)
	if plots[p] or assigning[p] then
		return
	end
	assigning[p] = true
	-- 1) Freunde im Server mit Plot suchen (yieldet – darum vor der eigentlichen Wahl)
	local friendPlots: { number } = {}
	local started = os.clock()
	for _, other in ipairs(Players:GetPlayers()) do
		if os.clock() - started > FRIEND_BUDGET then
			break
		end
		if other ~= p and plots[other] and areFriends(p, other) then
			table.insert(friendPlots, plots[other])
		end
	end
	assigning[p] = nil
	if p.Parent ~= Players or plots[p] then
		return
	end
	-- 2) Wahl + Eintrag ohne Yield dazwischen (keine Doppelvergabe)
	local plot = pickPlot(friendPlots)
	if not plot then
		warn(PREFIX .. "kein freier Plot für " .. p.Name)
		pcall(function()
			p:SetAttribute("Plot", 0)
		end)
		markDirty(p, "Plot")
		return
	end
	owners[plot] = p
	plots[p] = plot
	pcall(function()
		p:SetAttribute("Plot", plot)
	end)
	markDirty(p, "Plot", "Tower")
	local okLoaded, loaded = call("DataService", "IsLoaded", p)
	if okLoaded and loaded == true then
		call("TowerVisualService", "Rebuild", p)
	end
	if p.Character then
		placeAtPlot(p)
	end
end

local function onCharacterAdded(p: Player, character: Model)
	if VISIT.SpawnAtPlot == false then
		return
	end
	task.spawn(function()
		local root = character:WaitForChild("HumanoidRootPart", SPAWN_WAIT)
		if root and p.Parent == Players and p.Character == character and plots[p] then
			placeAtPlot(p)
		end
	end)
end

local function onPlayerAdded(p: Player)
	visitedSession[p] = {}
	if characterConnections[p] == nil then
		characterConnections[p] = p.CharacterAdded:Connect(function(character: Model)
			onCharacterAdded(p, character)
		end)
	end
	task.spawn(assign, p)
end

-- Besucher eines Plots (in der Fläche oder als Besuch gemerkt) höflich zur Plaza bringen
local function sendVisitorsHome(plot: number, ownerUserId: number, leaving: Player?)
	local center = PlotService.PlotCFrame(plot).Position
	local plaza = plazaCFrame()
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= leaving and plots[other] ~= plot then
			local root = rootOf(other)
			local inside = root ~= nil and horizontalDistance(root.Position, center) <= TOWER_RADIUS
			if inside or visiting[other] == ownerUserId then
				if visiting[other] == ownerUserId then
					visiting[other] = nil
					markDirty(other, "Plot")
				end
				if inside then
					PlotService.Teleport(other, plaza)
				end
			end
		end
	end
end

local function onPlayerRemoving(p: Player)
	local plot = plots[p]
	if plot then
		sendVisitorsHome(plot, p.UserId, p)
		call("TowerVisualService", "Clear", plot)
		if owners[plot] == p then
			owners[plot] = nil
		end
	end
	plots[p] = nil
	visiting[p] = nil
	visitedSession[p] = nil
	assigning[p] = nil
	local connection = characterConnections[p]
	if connection then
		connection:Disconnect()
		characterConnections[p] = nil
	end
	-- Freundes-Cache: Paare dieses Spielers entfernen
	local id = tostring(p.UserId)
	for key in pairs(friendCache) do
		local a, b = string.match(key, "^(%-?%d+):(%-?%d+)$")
		if a == id or b == id then
			friendCache[key] = nil
			friendCacheCount -= 1
		end
	end
	friendCacheCount = math.max(0, friendCacheCount)
end

-- ---------------------------------------------------------------------
-- 6) BESUCHE ERKENNEN (1 Hz): wer steht in welchem fremden Tower?
-- ---------------------------------------------------------------------
local function visitJob(_dt: number)
	for _, p in ipairs(Players:GetPlayers()) do
		local root = rootOf(p)
		local current = visiting[p]
		local nextVisit: number? = nil
		if root then
			local plot = PlotService.TowerAt(root.Position)
			local owner = if plot then PlotService.OwnerOf(plot) else nil
			if owner and owner ~= p then
				nextVisit = owner.UserId
			end
		end
		if nextVisit ~= current then
			local visitId = nextVisit
			if visitId then
				visiting[p] = visitId
			else
				visiting[p] = nil
			end
			markDirty(p, "Plot")
			if visitId then
				local seen = visitedSession[p]
				if seen and not seen[visitId] then
					seen[visitId] = true
					call("RewardService", "Track", p, "VisitTower", 1, { Owner = visitId })
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- 7) REQUEST-HANDLER (§C9)
-- ---------------------------------------------------------------------
local function exact(arg: any, spec: { [string]: string }): boolean
	if type(arg) ~= "table" then
		return false
	end
	local count = 0
	for key, value in pairs(arg) do
		count += 1
		if count > 4 or spec[key] == nil or type(value) ~= spec[key] then
			return false
		end
		if spec[key] == "number" and not Util.IsFinite(value) then
			return false
		end
	end
	for key in pairs(spec) do
		if arg[key] == nil then
			return false
		end
	end
	return true
end

local function teleportReply(p: Player, cf: CFrame, key: string?, args: { any }?, sync: boolean?): Reply
	local character = p.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.SeatPart ~= nil then
		return fail(p, "tower.inCar")
	end
	if not PlotService.Teleport(p, cf, sync) then
		return fail(p, "tower.noCharacter")
	end
	return okReply(p, key, args)
end

local function handleVisit(p: Player, arg: any): Reply
	if not exact(arg, { UserId = "number" }) or arg.UserId % 1 ~= 0 then
		return fail(p, "core.invalid")
	end
	if arg.UserId == p.UserId then
		local own = plots[p]
		if not own then
			return fail(p, "tower.noPlot")
		end
		return teleportReply(p, PlotService.LobbyCFrame(own), "tower.home", nil)
	end
	local owner = Players:GetPlayerByUserId(arg.UserId)
	local plot = if owner then plots[owner] else nil
	if not owner or not plot then
		return fail(p, "tower.ownerGone")
	end
	local reply = teleportReply(p, PlotService.LobbyCFrame(plot), "tower.visiting", { owner.DisplayName })
	if reply.Ok then
		visiting[p] = owner.UserId
		markDirty(p, "Plot")
		local seen = visitedSession[p]
		if seen and not seen[owner.UserId] then
			seen[owner.UserId] = true
			call("RewardService", "Track", p, "VisitTower", 1, { Owner = owner.UserId })
		end
	end
	return reply
end

local function handleHome(p: Player, arg: any): Reply
	if arg ~= nil and not exact(arg, {}) then
		return fail(p, "core.invalid")
	end
	local plot = plots[p]
	if not plot then
		return fail(p, "tower.noPlot")
	end
	local reply = teleportReply(p, PlotService.LobbyCFrame(plot), "tower.home", nil)
	if reply.Ok and visiting[p] ~= nil then
		visiting[p] = nil
		markDirty(p, "Plot")
	end
	return reply
end

local function handleElevator(p: Player, arg: any): Reply
	if not exact(arg, { Floor = "number" }) or arg.Floor % 1 ~= 0 or arg.Floor < 0 or arg.Floor > FLOORS then
		return fail(p, "core.invalid")
	end
	local root = rootOf(p)
	if not root then
		return fail(p, "tower.noCharacter")
	end
	-- nur im eigenen oder gerade besuchten Tower (dort, wo man steht)
	local plot = PlotService.TowerAt(root.Position)
	local owner = if plot then PlotService.OwnerOf(plot) else nil
	if not plot or not owner then
		return fail(p, "tower.notInTower")
	end
	local data = dataOf(owner)
	if not data then
		return fail(p, "core.loading")
	end
	local tower = data.Tower
	local floors = if type(tower.Floors) == "table" then #tower.Floors else 0
	local floor = math.max(1, arg.Floor) -- 0 = Lobby = Erdgeschoss
	if floor > math.max(1, floors) then
		return fail(p, "tower.noFloor")
	end
	if owner ~= p and type(tower.Private) == "table" and table.find(tower.Private, floor) and not isAdmin(p) then
		return fail(p, "tower.privateFloor")
	end
	-- erst nach dem Versetzen antworten: die Aufzug-Kinoszene wertet Ok als "angekommen" (fremde Tower streamen erst)
	return teleportReply(p, PlotService.FloorCFrame(plot, floor), nil, nil, true)
end

-- ---------------------------------------------------------------------
-- 8) STATE & LEBENSZYKLUS
-- ---------------------------------------------------------------------
local function plotState(p: Player): { [string]: any }
	return { Id = plots[p] or 0, Visiting = visiting[p] }
end

function PlotService.Init(services: any)
	Services = services
	local pss = Services.PlayerStateService
	if type(pss) ~= "table" then
		warn(PREFIX .. "PlayerStateService fehlt – keine Anfragen/State")
		return
	end
	pss.Provide("Plot", plotState)
	pss.Handle("TowerVisit", handleVisit, { Rate = 1, Per = 2 })
	pss.Handle("TowerHome", handleHome, { Rate = 1, Per = 2 })
	pss.Handle("TowerElevator", handleElevator, { Rate = 2, Per = 1 })
end

function PlotService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
		if p.Character then
			task.spawn(onCharacterAdded, p, p.Character)
		end
	end
	Scheduler.Every("PlotVisits", 1, visitJob)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Fortschritt: Trader-XP, Lizenzen + Prüfungen, Know-how, Ruf, Vermögen & Titel, Börsengang +
--  Vorstand, Akademie, Erfolge, Badges, Firmen-Album (Server/Services/ProgressionService)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §C5.8, §C9 (Prog*), §C10 (State
--  "Prog"), §B9.1–§B9.6, §B9.8, §B2 (Funnel 11/13/14), §A7 #8/#9/#11, §C11.4 (Firewall).
--
--  Robux-Firewall (§0.4): XP, Lizenz, Know-how, Ruf entstehen NUR aus eigenen Fills (OrderService.OnTrade),
--  Börsentagen (OnDayResult), Akademie und Prüfungen. TradingPerks/LicenceDef/Licence lesen NUR Prog.* (Robux-frei).
--  Aktien-Sterne (aus CR-Ausgaben) kaufen NUR Turm-/Lifestyle-Perks. Admins können Ruf nicht geben.
--
--  Öffentliche API (§C5.8):
--    ProgressionService.AddXp(p, base, reason, opts?): number    reason ∈ Config.Progression.XpSources (sonst 0)
--    ProgressionService.Licence(p): number                        ProgressionService.LicenceDef(p): Types.Licence
--    ProgressionService.TradingPerks(p): Types.TradingPerks       nur Lizenz + Know-how
--    ProgressionService.TraderFactor(p): (gesamt, Lizenz-Teil, Ruf-Teil)   Teile multiplikativ (1 + x)
--    ProgressionService.Level(p) · Ruf(p) (Stufe 0–10) · Stars(p) (freie ★) · Perk(p, branch) · IpoCount(p)
--    ProgressionService.Wealth(p) · Title(p) (Titel-Schlüssel) · AlbumSets(p) · Unlock(p, achId)
--    ProgressionService.AdminSetLicence(p, idx): boolean          ohne Prüfung, ruft OrderService.TaintWeek
--  Ergänzungen (abwärtskompatibel): NoteStat(p, stat, amount, mode?) (Erfolgs-Zähler; RewardService/CommunityService),
--    GrantTitle(p, key): boolean · ExamDone(p, task) · _Test = { Core, QuizKey }
--  Request-Handler: ProgLesson, ProgExam, ProgKnowHow, ProgKnowHowReset, ProgIpoPreview, ProgIpo, ProgPerk,
--    ProgRespec, ProgTitle.   State: "Prog". Effekte: IpoCeremony, LicenceUp, TitleUp, Achievement.
--  Player-Attribute: "Licence" (1–10), "Title" (Titel-Schlüssel, Client lokalisiert).
--  Signale: OrderService.OnTrade/OnDayResult/OnBell, MarketService.OnNews, TowerService.OnFloorBuilt/OnStageUp.
-- =====================================================================

local BadgeService = game:GetService("BadgeService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))
local Lang = require(Shared:WaitForChild("Lang"))
local Clock = require(Shared:WaitForChild("Clock"))
local Format = require(Shared:WaitForChild("Format"))
local ProgressMath = require(Shared:WaitForChild("ProgressMath"))
local TowerMath = require(Shared:WaitForChild("TowerMath")) :: any
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local ProgressionService = {}
local Services: any = nil

type Reply = Types.Reply
type Data = { [string]: any }

local PCFG: any = Config.Progression
ProgressMath.Configure(PCFG)

local MAX_MONEY = 9e15
local LOG_GAP = 10
local WEALTH_HZ = 0.2 -- je Spieler alle 5 s: Vermögen, Höchstwerte, Erfolge, Badges
local CRASH_HZ = 1
local TICKER_PATTERN = "^%u%u%u%u?$"
local MAX_RECENT_BUYS = 64
local SECTOR_ETF = "ETF"

-- ---------------------------------------------------------------------
-- 0) QUIZ-LÖSUNGEN (nur Server – Config wird repliziert). Reihenfolge = Fragen der Lektion, Wert = richtige
--    Antwort (1-basiert). Texte: Lang/Progress "prog.les.<Id>.qN.aM" – beim Ändern beides anpassen!
-- ---------------------------------------------------------------------
local QUIZ_KEY: { [string]: { number } } = {
	L01 = { 1, 3 },
	L02 = { 1, 2, 1 },
	L03 = { 2, 1, 3 },
	L04 = { 1, 2, 1 },
	L05 = { 2, 3, 1 },
	L06 = { 1, 3, 1 },
	L07 = { 2, 1, 2 },
	L08 = { 1, 2, 1 },
	L09 = { 2, 1, 1 },
	L10 = { 1, 2, 1 },
	L11 = { 2, 1, 1 },
	L12 = { 2, 1, 2 },
	L13 = { 1, 1, 2 },
	L14 = { 1, 2, 1 },
	L15 = { 1, 1, 2 },
	L16 = { 1, 2, 2 },
}

-- Erfolgs-Zähler, die RewardService.Track/CommunityService weiterreichen (Art/Stat -> Stat)
local STAT_FROM: { [string]: string } = {
	Collect = "Collect",
	RoomLevel = "RoomLevels",
	Hire = "Hired",
	Transfer = "Transfers",
	Drive = "Drive",
	VisitTower = "Visits",
	GiveRespekt = "Respekt",
	HelpBuild = "HelpBuild",
	Pickup = "Pickups",
	BearOrbs = "BearOrbs",
	Bell = "Bell",
	RespektGot = "RespektGot",
	Invites = "Invites",
	WorldEvent = "WorldEvents",
	LoginStreak = "LoginStreak",
}

local TIER_LEVEL: { [string]: number } = { Bronze = 1, Silber = 2, Gold = 3, Diamant = 4 }

-- Pro-Spieler-Tabellen (alle bei PlayerRemoving geleert)
local wealthOf: { [Player]: number } = {}
local ipoTokens: { [Player]: { Token: string, Until: number } } = {}
local recentBuys: { [Player]: { [number]: number } } = {} -- Instrument -> Tick des letzten Kaufs
local sectorsToday: { [Player]: { Day: number, Set: { [string]: boolean } } } = {}
local crashWatch: { [Player]: { Nav0: number, Basis0: number, Until: number } } = {}
local lessonAt: { [Player]: { [string]: number } } = {}
local badgeBusy: { [Player]: { [string]: boolean } } = {}
local ipoBusy: { [Player]: boolean } = {}
local readyAt: { [Player]: number } = {}
local lastLogAt: { [string]: number } = {}

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function logError(where: string, err: any)
	local now = os.clock()
	if (lastLogAt[where] or -math.huge) + LOG_GAP <= now then
		lastLogAt[where] = now
		warn("[ProgressionService] " .. where .. ": " .. tostring(err))
	end
end

local function finite(n: any): boolean
	return Util.IsFinite(n)
end

local function num(v: any, default: number): number
	return if Util.IsFinite(v) then v else default
end

local function isInt(v: any): boolean
	return Util.IsFinite(v) and v % 1 == 0
end

-- optionaler Dienst über pcall: (ok, Ergebnisse …)
local function call(name: string, fnName: string, ...: any): (boolean, ...any)
	local svc = Services and Services[name]
	local fn = svc and svc[fnName]
	if type(fn) ~= "function" then
		return false
	end
	local results = table.pack(pcall(fn, ...))
	if not results[1] then
		logError(name .. "." .. fnName, results[2])
		return false
	end
	return true, table.unpack(results, 2, results.n)
end

local function isPlayer(p: any): boolean
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent == Players
end

local function dataOf(p: Player): Data?
	local ok, data = call("DataService", "Get", p)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

local function langOf(p: Player): Types.Lang
	local ok, lang = call("PlayerStateService", "LangOf", p)
	if ok and (lang == "de" or lang == "en") then
		return lang
	end
	return "en"
end

local function T(p: Player, key: string, ...: any): string
	return Lang.T(langOf(p), key, ...)
end

local function fail(p: Player, key: string, ...: any): Reply
	return { Ok = false, Message = T(p, key, ...) }
end

local function notify(p: Player, key: string, args: { any }?, kind: Types.NotifyKind?)
	call("PlayerStateService", "Notify", p, key, args, kind)
end

local function markDirty(p: Player, ...: string)
	call("PlayerStateService", "MarkDirty", p, ...)
end

local function effect(p: Player, name: string, strength: number, data: any)
	call("PlayerStateService", "Effect", p, name, strength, data)
end

local function funnel(p: Player, step: number)
	local names = PCFG.Tutorial.FunnelNames
	call("MetricsService", "Funnel", p, step, names[step] or ("Step" .. step))
end

local function track(p: Player, kind: string, amount: number, ctx: { [string]: any }?)
	call("RewardService", "Track", p, kind, amount, ctx)
end

local function today(): number
	return Util.UtcDay()
end

local function exactKeys(arg: any, keys: { string }): boolean
	if type(arg) ~= "table" then
		return false
	end
	local allowed: { [string]: boolean } = {}
	for _, key in ipairs(keys) do
		allowed[key] = true
	end
	for key in pairs(arg) do
		if type(key) ~= "string" or not allowed[key] then
			return false
		end
	end
	for _, key in ipairs(keys) do
		if arg[key] == nil then
			return false
		end
	end
	return true
end

local function licenceDefAt(idx: number): any
	local list = PCFG.Licences
	return list[math.clamp(math.floor(num(idx, 1)), 1, #list)]
end

local function companies(): any
	local c = Config.Companies
	return if type(c) == "table" then c else {}
end

local function instDef(i: number): any
	local byId = companies().ById
	return if type(byId) == "table" then byId[i] else nil
end

-- ---------------------------------------------------------------------
-- 2) KERN (rein, auf dem Spielstand; SelfTests nutzen dieselben Funktionen)
-- ---------------------------------------------------------------------
local Core = {}

local function asSet(t: any): { [string]: boolean }
	local out: { [string]: boolean } = {}
	if type(t) ~= "table" then
		return out
	end
	for k, v in pairs(t) do
		if type(k) == "string" and v == true then
			out[k] = true
		elseif type(k) == "number" and type(v) == "string" then
			out[v] = true -- alte Liste {"A","B"} -> Menge
		end
	end
	return out
end

-- Spielstand-Teil Prog reparieren (nach DataService Migrate/Reconcile/Sanitize; nie Fortschritt erfinden)
function Core.Repair(data: Data)
	if type(data.Prog) ~= "table" then
		data.Prog = {}
	end
	local prog = data.Prog
	prog.Xp = ProgressMath.Clamp(num(prog.Xp, 0))
	prog.Licence = if isInt(prog.Licence) then math.clamp(prog.Licence, 1, #PCFG.Licences) else 1
	prog.Exams = asSet(prog.Exams)
	if type(prog.ExamProgress) ~= "table" then
		prog.ExamProgress = {}
	end
	local lessons: { [string]: number } = {}
	if type(prog.Lessons) == "table" then
		for id, value in pairs(prog.Lessons) do
			if type(id) == "string" and PCFG.LessonById[id] and isInt(value) then
				lessons[id] = math.clamp(value, 1, 2)
			end
		end
	end
	prog.Lessons = lessons
	local kh: { [string]: number } = {}
	if type(prog.KH) == "table" then
		for key, level in pairs(prog.KH) do
			local node = PCFG.NodeByKey[key]
			if node and isInt(level) and level > 0 then
				kh[key] = math.clamp(level, 0, node.Max)
			end
		end
	end
	prog.KH = kh
	prog.KHResetWeek = math.floor(num(prog.KHResetWeek, 0))
	prog.Ruf = math.max(0, math.floor(num(prog.Ruf, 0)))
	prog.RufDay = math.floor(num(prog.RufDay, 0))
	prog.RufToday = math.max(0, math.floor(num(prog.RufToday, 0)))
	prog.Title = if type(prog.Title) == "string" then prog.Title else ""
	prog.TitleOff = prog.TitleOff == true -- Spieler hat „Kein Titel“ gewählt (Vermögens-Titel nicht automatisch setzen)
	prog.Titles = asSet(prog.Titles)
	if prog.Title ~= "" and not prog.Titles[prog.Title] then
		prog.Title = ""
	end
	prog.Album = asSet(prog.Album)
	prog.Ach = asSet(prog.Ach)
	local stats: { [string]: number } = {}
	if type(prog.AchProgress) == "table" then
		for key, value in pairs(prog.AchProgress) do
			if type(key) == "string" and finite(value) and value >= 0 then
				stats[key] = math.min(value, MAX_MONEY)
			end
		end
	end
	prog.AchProgress = stats
	prog.Badges = asSet(prog.Badges)
	prog.XpDay = math.floor(num(prog.XpDay, 0))
	if type(prog.XpCounts) ~= "table" then
		prog.XpCounts = {}
	end
	if type(prog.AchPending) ~= "table" then
		prog.AchPending = {}
	end
	if type(prog.Prestige) ~= "table" then
		prog.Prestige = {}
	end
	local pr = prog.Prestige
	pr.Count = math.max(0, math.floor(num(pr.Count, 0)))
	pr.Stars = math.max(0, math.floor(num(pr.Stars, 0)))
	pr.Firmenwert = ProgressMath.Clamp(num(pr.Firmenwert, 0))
	pr.RespecFree = pr.RespecFree == true
	local perks: { [string]: number } = {}
	if type(pr.Perks) == "table" then
		for key, level in pairs(pr.Perks) do
			local def = PCFG.PerkByKey[key]
			if def and isInt(level) and level > 0 then
				perks[key] = math.clamp(level, 0, def.Max)
			end
		end
	end
	pr.Perks = perks
	if Core.StarsSpent(prog) > pr.Stars then
		pr.Perks = {} -- Config geändert: Sterne zurück (nie Sterne erfinden)
	end
	local tickers = {}
	if type(pr.Tickers) == "table" then
		for _, entry in ipairs(pr.Tickers) do
			if type(entry) == "table" and type(entry.T) == "string" and #tickers < PCFG.Prestige.TickerKeep then
				table.insert(tickers, { T = entry.T, At = math.floor(num(entry.At, 0)) })
			end
		end
	end
	pr.Tickers = tickers
	prog.KHSpent = Core.KhSpent(prog)
end

function Core.KhSpent(prog: Data): number
	local spent = 0
	for key, level in pairs(prog.KH or {}) do
		local node = PCFG.NodeByKey[key]
		if node then
			spent += node.Cost * level
		end
	end
	return spent
end

-- abgeschlossene Akademie-Serien (je 4 Lektionen)
function Core.Series(prog: Data): number
	local perSeries: { [number]: number } = {}
	for id in pairs(prog.Lessons or {}) do
		local lesson = PCFG.LessonById[id]
		if lesson then
			perSeries[lesson.Series] = (perSeries[lesson.Series] or 0) + 1
		end
	end
	local size = PCFG.KnowHow.SeriesSize
	local done = 0
	for _, n in pairs(perSeries) do
		if n >= size then
			done += 1
		end
	end
	return done
end

function Core.Level(prog: Data): number
	local level = ProgressMath.LevelFromXp(num(prog.Xp, 0))
	return level
end

function Core.KhTotal(prog: Data): number
	local total = ProgressMath.KnowHowTotal(Core.Level(prog), prog.Licence, Core.Series(prog))
	return math.min(total, PCFG.KnowHow.Max)
end

function Core.KhFree(prog: Data): number
	return math.max(0, Core.KhTotal(prog) - Core.KhSpent(prog))
end

function Core.StarsSpent(prog: Data): number
	local spent = 0
	local pr = prog.Prestige
	if type(pr) == "table" and type(pr.Perks) == "table" then
		for _, level in pairs(pr.Perks) do
			spent += math.max(0, math.floor(num(level, 0)))
		end
	end
	return spent
end

function Core.StarsFree(prog: Data): number
	local pr = prog.Prestige
	return math.max(0, (if type(pr) == "table" then num(pr.Stars, 0) else 0) - Core.StarsSpent(prog))
end

-- Ruf-Stufe inkl. Lizenz-Untergrenze
function Core.RufLevel(prog: Data): number
	return math.max(ProgressMath.RufLevel(prog.Ruf), ProgressMath.RufFloor(prog.Licence))
end

-- Werkzeuge NUR aus Lizenz + Know-how (Robux-frei, §0.4 c)
function Core.TradingPerks(prog: Data): Types.TradingPerks
	local licence = math.clamp(math.floor(num(prog.Licence, 1)), 1, #PCFG.Licences)
	local def = licenceDefAt(licence)
	local kh = prog.KH or {}
	local function level(key: string): number
		return math.max(0, math.floor(num(kh[key], 0)))
	end
	local function valueOf(key: string): number
		local node = PCFG.NodeByKey[key]
		local v = num(node.Base, 0) + num(node.Step, 1) * level(key)
		return math.min(v, num(node.Cap, v))
	end
	local botLevels: { [string]: number } = {}
	for _, node in ipairs(PCFG.KnowHow.Nodes) do
		if node.Preset then
			botLevels[node.Preset] = level(node.Key)
		end
	end
	local indicators: { [string]: boolean } = {}
	for name, from in pairs(PCFG.Indicators) do
		indicators[name] = licence >= from
	end
	local leads = PCFG.KnowHow.ResearchLead
	local research = math.clamp(level("Research"), 0, #leads - 1)
	return {
		Licence = licence,
		Layer = def.Layer,
		BotSlots = def.BotSlots,
		BotLevels = botLevels,
		Alerts = valueOf("Alerts"),
		Watchlists = valueOf("Watch"),
		Layouts = valueOf("Layouts"),
		Monitors = valueOf("Monitors"),
		ResearchLead = leads[research + 1],
		MultiChart = level("MultiChart") >= 1 and licence >= PCFG.NodeByKey.MultiChart.Licence,
		Risk = level("Risk"),
		Indicators = indicators,
	}
end

-- Tages-/Wochen-Zähler der XP-Deckel
local function capKey(reason: string, source: any): string
	return if source.Weekly then "wk:" .. reason else reason
end

function Core.XpRoom(prog: Data, reason: string, day: number, week: number): number
	local source = PCFG.XpSources[reason]
	if type(source) ~= "table" then
		return 0
	end
	if prog.XpDay ~= day then
		-- neuer UTC-Tag: Tages-Zähler leeren, Wochen-Zähler behalten
		local counts = prog.XpCounts or {}
		local keep: { [string]: any } = {}
		for key, value in pairs(counts) do
			if type(key) == "string" and string.sub(key, 1, 3) == "wk:" then
				keep[key] = value
			end
		end
		keep.wk = counts.wk
		prog.XpCounts = keep
		prog.XpDay = day
	end
	local counts = prog.XpCounts
	if counts.wk ~= week then
		for key in pairs(counts) do
			if type(key) == "string" and string.sub(key, 1, 3) == "wk:" then
				counts[key] = nil
			end
		end
		counts.wk = week
	end
	if source.Cap == nil then
		return math.huge
	end
	return math.max(0, source.Cap - num(counts[capKey(reason, source)], 0))
end

-- XP buchen (Deckel zählt Gutschriften, nicht Punkte). Rückgabe: gebuchte XP
function Core.AddXp(prog: Data, base: number, reason: string, mult: number, day: number, week: number): number
	local source = PCFG.XpSources[reason]
	if type(source) ~= "table" or not finite(base) or base <= 0 then
		return 0
	end
	if Core.XpRoom(prog, reason, day, week) < 1 then
		return 0
	end
	local amount = math.floor(math.min(base, PCFG.MaxXpGrant) * math.clamp(num(mult, 1), 1, PCFG.XpMultMax) + 0.5)
	if amount <= 0 then
		return 0
	end
	if source.Cap ~= nil then
		local key = capKey(reason, source)
		prog.XpCounts[key] = num(prog.XpCounts[key], 0) + 1
	end
	prog.Xp = ProgressMath.Clamp(num(prog.Xp, 0) + amount)
	return amount
end

-- Ruf-Punkte: capped = Börsentag-Punkte (Tagesdeckel), sonst Akademie/Prüfung (außerhalb des Deckels)
function Core.AddRuf(prog: Data, points: number, day: number, capped: boolean): number
	local pts = math.max(0, math.floor(num(points, 0)))
	if capped then
		if prog.RufDay ~= day then
			prog.RufDay = day
			prog.RufToday = 0
		end
		pts = math.min(pts, math.max(0, PCFG.Ruf.DailyCap - prog.RufToday))
		prog.RufToday += pts
	end
	prog.Ruf = math.max(0, math.floor(num(prog.Ruf, 0))) + pts
	return pts
end

-- Tageswechsel: Ruf-Abbau für Tage ohne zählenden Börsentag (max. 30), Rückgabe: Anzahl abgebauter Tage
function Core.DayRoll(data: Data, day: number): number
	local prog = data.Prog
	local last = math.floor(num(data.LastUtcDay, 0))
	if last <= 0 then
		data.LastUtcDay = day
		return 0
	end
	if day <= last then
		return 0
	end
	local missed = day - last
	if prog.RufDay == last then
		missed -= 1 -- der letzte bekannte Tag hatte einen zählenden Börsentag
	end
	missed = math.max(0, missed)
	if missed > 0 then
		prog.Ruf = ProgressMath.RufDecay(prog.Ruf, missed, ProgressMath.RufFloor(prog.Licence))
	end
	data.LastUtcDay = day
	return missed
end

function Core.BuyNode(prog: Data, key: string): (boolean, string, { any }?)
	local node = PCFG.NodeByKey[key]
	if not node then
		return false, "core.invalid", nil
	end
	local level = math.floor(num(prog.KH[key], 0))
	if level >= node.Max then
		return false, "prog.khMax", nil
	end
	local needLicence = node.Licence
	if type(node.LevelLicence) == "table" and node.LevelLicence[level + 1] then
		needLicence = node.LevelLicence[level + 1]
	end
	if prog.Licence < needLicence then
		return false, "prog.khLocked", { needLicence }
	end
	if Core.KhFree(prog) < node.Cost then
		return false, "prog.khNoPoints", nil
	end
	prog.KH[key] = level + 1
	prog.KHSpent = Core.KhSpent(prog)
	return true, "prog.khBought", { level + 1 }
end

function Core.ResetNodes(prog: Data, week: number): (boolean, string)
	if prog.KHResetWeek == week then
		return false, "prog.khResetUsed"
	end
	if next(prog.KH) == nil then
		return false, "prog.khResetEmpty"
	end
	prog.KH = {}
	prog.KHSpent = 0
	prog.KHResetWeek = week
	return true, "prog.khReset"
end

function Core.BuyPerk(prog: Data, key: string): (boolean, string, { any }?)
	local def = PCFG.PerkByKey[key]
	if not def then
		return false, "core.invalid", nil
	end
	local perks = prog.Prestige.Perks
	local level = math.floor(num(perks[key], 0))
	if level >= def.Max then
		return false, "prog.perkMax", nil
	end
	if Core.StarsFree(prog) < 1 then
		return false, "prog.perkNoStars", nil
	end
	perks[key] = level + 1
	return true, "prog.perkBought", { level + 1 }
end

function Core.Respec(prog: Data): (boolean, string)
	local pr = prog.Prestige
	if next(pr.Perks) == nil then
		return false, "prog.respecEmpty"
	end
	if pr.RespecFree then
		pr.RespecFree = false
	elseif pr.Stars >= PCFG.Prestige.RespecCost then
		pr.Stars -= PCFG.Prestige.RespecCost
	else
		return false, "prog.respecNoStars"
	end
	pr.Perks = {}
	return true, "prog.respecDone"
end

-- Perk-Tabelle für TowerService.ResetForIpo ({ [Ast] = Stufe, StartCredits = n })
function Core.PerkTable(prog: Data): { [string]: number }
	local out: { [string]: number } = {}
	for _, def in ipairs(PCFG.Prestige.Perks) do
		out[def.Key] = math.floor(num(prog.Prestige.Perks[def.Key], 0))
	end
	out.StartCredits = math.floor(num(PCFG.Prestige.StartCredits, 0))
	return out
end

-- Börsengang buchen (vor TowerService.ResetForIpo; Rückgabe: Sterne)
function Core.ApplyIpo(prog: Data, runSpend: number, ticker: string, now: number): number
	local pr = prog.Prestige
	local stars = ProgressMath.Stars(runSpend)
	pr.Count += 1
	pr.Stars = math.floor(num(pr.Stars, 0) + stars)
	pr.Firmenwert = ProgressMath.Clamp(num(pr.Firmenwert, 0) + PCFG.Prestige.FirmPct * math.max(0, num(runSpend, 0)))
	if pr.Count == PCFG.Prestige.RespecFreeAt then
		pr.RespecFree = true
	end
	table.insert(pr.Tickers, 1, { T = ticker, At = math.floor(now) })
	while #pr.Tickers > PCFG.Prestige.TickerKeep do
		table.remove(pr.Tickers)
	end
	return stars
end

function Core.CrownFor(count: number): string
	local key = ""
	for _, crown in ipairs(PCFG.Prestige.Crowns) do
		if count >= crown.Ipos then
			key = crown.Key
		end
	end
	return key
end

-- Album-Karte (true, Sektor-Satz-Sektor? wenn neu)
function Core.AlbumAdd(prog: Data, instId: number): (boolean, string?)
	local album = PCFG.Album
	local isCard = (instId >= album.IpoFrom and instId <= album.IpoTo) or table.find(album.Cards, instId) ~= nil
	if not isCard then
		return false, nil
	end
	local key = tostring(instId)
	if prog.Album[key] then
		return false, nil
	end
	local before = Core.AlbumSets(prog)
	prog.Album[key] = true
	if Core.AlbumSets(prog) > before then
		local def = instDef(instId)
		return true, if def then def.Sector else nil
	end
	return true, nil
end

-- vollständige Sektor-Sätze (alle Firmen eines Sektors, ohne ETFs/IPOs), höchstens MaxSets
function Core.AlbumSets(prog: Data): number
	local perSector: { [string]: { have: number, total: number } } = {}
	local list = companies().Instruments
	if type(list) ~= "table" then
		return 0
	end
	for _, inst in ipairs(list) do
		if type(inst) == "table" and inst.Class ~= SECTOR_ETF and inst.Ipo ~= true and inst.Set ~= "Tutorial" then
			local entry = perSector[inst.Sector]
			if not entry then
				entry = { have = 0, total = 0 }
				perSector[inst.Sector] = entry
			end
			entry.total += 1
			if prog.Album[tostring(inst.Id)] then
				entry.have += 1
			end
		end
	end
	local sets = 0
	for _, entry in pairs(perSector) do
		if entry.total > 0 and entry.have >= entry.total then
			sets += 1
		end
	end
	return math.min(sets, PCFG.Album.MaxSets)
end

function Core.AlbumCards(prog: Data): number
	local n = 0
	for _, id in ipairs(PCFG.Album.Cards) do
		if prog.Album[tostring(id)] then
			n += 1
		end
	end
	return n
end

-- Quiz prüfen: (richtig, gesamt) oder nil bei falscher Form
function Core.LessonResult(id: string, answers: any, key: { [string]: { number } }): (number?, number?)
	local lesson = PCFG.LessonById[id]
	local solution = key[id]
	if not lesson or not solution or type(answers) ~= "table" then
		return nil, nil
	end
	local total = #lesson.Quiz
	if #answers ~= total or #solution ~= total then
		return nil, nil
	end
	local correct = 0
	for q = 1, total do
		local a = answers[q]
		if not isInt(a) or a < 1 or a > lesson.Quiz[q] then
			return nil, nil
		end
		if a == solution[q] then
			correct += 1
		end
	end
	for k in pairs(answers) do
		if type(k) ~= "number" then
			return nil, nil
		end
	end
	return correct, total
end

-- Aufgaben der Lizenz idx: { {Key, Done} }
function Core.ExamTasks(prog: Data, idx: number): { { Key: string, Done: boolean } }
	local def = PCFG.Licences[idx]
	local out = {}
	if def then
		for _, task in ipairs(def.Exam) do
			table.insert(out, { Key = task, Done = prog.Exams[task] == true })
		end
	end
	return out
end

-- Lizenz-Aufstieg, Stufe für Stufe. Hat die neue Lizenz eine Prüfung (§B9.2), gilt sie damit als bestanden:
-- +250 XP ohne Verdoppler und +20 Ruf außerhalb des Deckels (§B9.1/§B9.4). Lizenzen ohne Prüfung (Trader II,
-- Fondsmanager II) steigen nur über die XP – ohne Prüfungs-Bonus.
-- setLicence(idx) meldet jede neue Stufe an OrderService.SetLicence (dort steigt die Basis). Rückgabe: neue Stufen
function Core.Promote(prog: Data, day: number, week: number, setLicence: (number) -> ()): { number }
	local promoted: { number } = {}
	local guard = 0
	while guard < #PCFG.Licences do
		guard += 1
		local target = ProgressMath.LicenceFor(prog.Xp, prog.Exams, PCFG.Licences)
		if target <= prog.Licence then
			break
		end
		local idx = prog.Licence + 1
		prog.Licence = idx
		setLicence(idx)
		local def = PCFG.Licences[idx]
		if type(def.Exam) == "table" and #def.Exam > 0 then
			Core.AddXp(prog, PCFG.XpSources.Exam.Xp, "Exam", 1, day, week)
			Core.AddRuf(prog, PCFG.Ruf.Exam, day, false)
		end
		Core.Stat(prog, "Licence", idx, "max")
		table.insert(promoted, idx)
	end
	return promoted
end

-- Admin-Lizenz (Admin-Panel): setzt die Stufe und meldet SetLicence + TaintWeek("AdminLicence") –
-- die Liga-Woche des Empfängers zählt danach nicht (§B11.1). report(fnName, arg) = OrderService-Aufruf
function Core.AdminLicence(prog: Data, idx: number, report: (string, any) -> ()): boolean
	if not isInt(idx) or idx < 1 or idx > #PCFG.Licences then
		return false
	end
	prog.Licence = idx
	Core.Stat(prog, "Licence", idx, "max")
	report("SetLicence", idx)
	report("TaintWeek", "AdminLicence")
	return true
end

-- Stat setzen: "add" (Summe) oder "max" (Höchstwert). Rückgabe: geändert?
function Core.Stat(prog: Data, stat: string, value: number, mode: string?): boolean
	if type(stat) ~= "string" or not finite(value) then
		return false
	end
	local stats = prog.AchProgress
	local old = num(stats[stat], 0)
	local new = if mode == "max" then math.max(old, value) else old + math.max(0, value)
	new = math.min(new, MAX_MONEY)
	if new ~= old then
		stats[stat] = new
		return true
	end
	return false
end

-- neu erreichte Erfolge (noch nicht in Ach)
function Core.NewAchievements(prog: Data): { any }
	local out = {}
	local stats = prog.AchProgress
	for _, entry in ipairs(PCFG.Achievements) do
		if not prog.Ach[entry.Id] and num(stats[entry.Stat], 0) >= entry.Goal then
			table.insert(out, entry)
		end
	end
	return out
end

-- Titel hinzufügen: true = neu
function Core.AddTitle(prog: Data, key: string): boolean
	if not PCFG.TitleByKey[key] or prog.Titles[key] then
		return false
	end
	prog.Titles[key] = true
	return true
end

-- Vermögen (§B9.5)
function Core.Wealth(parts: { [string]: number }, bauKurs: number): number
	local v = num(parts.Credits, 0)
		+ num(parts.TowerValue, 0)
		+ num(parts.Firm, 0)
		+ num(parts.Collection, 0)
		+ math.max(0, num(parts.NavCents, 0)) / 100 * math.max(0, num(bauKurs, 0))
	return ProgressMath.Clamp(v)
end

ProgressionService._Test = { Core = Core, QuizKey = QUIZ_KEY }

-- ---------------------------------------------------------------------
-- 3) ZUGRIFF
-- ---------------------------------------------------------------------
local function progOf(p: Player): (Data?, Data?)
	local data = dataOf(p)
	if not data then
		return nil, nil
	end
	if type(data.Prog) ~= "table" or type(data.Prog.Prestige) ~= "table" or type(data.Prog.KH) ~= "table" then
		Core.Repair(data)
	end
	return data.Prog, data
end

local function setAttributes(p: Player, prog: Data)
	if not isPlayer(p) then
		return
	end
	if p:GetAttribute("Licence") ~= prog.Licence then
		p:SetAttribute("Licence", prog.Licence)
	end
	if p:GetAttribute("Title") ~= prog.Title then
		p:SetAttribute("Title", prog.Title)
	end
end

-- XP-Verdoppler (gratis für alle): Power-Hour täglich 19:00 Berlin (60 min) oder Admin-XP-Rausch
local function powerHourInfo(): (boolean, number)
	local now = os.time()
	local ph = PCFG.PowerHour
	local offset = 3600
	local ok, value = pcall(Clock.BerlinOffset, now)
	if ok and finite(value) then
		offset = value
	end
	local localSeconds = (now + offset) % 86400
	local start = ph.Hour * 3600 + ph.Minute * 60
	local stop = start + ph.Minutes * 60
	if localSeconds >= start and localSeconds < stop then
		return true, now + (stop - localSeconds)
	end
	return false, 0
end

local function xpRushActive(): boolean
	local ok, list = call("EventService", "Active")
	if not ok or type(list) ~= "table" then
		return false
	end
	local now = os.time()
	for _, ev in ipairs(list) do
		if type(ev) == "table" and ev.Kind == PCFG.XpRushKind and num(ev.Until, 0) > now then
			return true
		end
	end
	return false
end

local function xpMult(): number
	local mult = 1
	if powerHourInfo() then
		mult = math.max(mult, PCFG.PowerHour.Mult)
	end
	if xpRushActive() then
		mult = math.max(mult, 2)
	end
	return math.min(mult, PCFG.XpMultMax)
end

-- ---------------------------------------------------------------------
-- 4) ERFOLGE, BADGES, TITEL
-- ---------------------------------------------------------------------
local function steadyIncome(p: Player): number
	local ok, info = call("TowerService", "Income", p)
	if ok and type(info) == "table" and finite(info.Steady) then
		return math.max(0, info.Steady)
	end
	return 0
end

-- einkommens-skalierte CR-Belohnung (Minuten Dauer-Einkommen ohne Zeitlich, mindestens min)
local function incomeCredits(p: Player, minutes: number, min: number): number
	return ProgressMath.Clamp(math.max(num(min, 0), steadyIncome(p) * num(minutes, 0) * 60))
end

local function grantTitle(p: Player, prog: Data, key: string, announce: boolean): boolean
	if not Core.AddTitle(prog, key) then
		return false
	end
	local def = PCFG.TitleByKey[key]
	effect(p, "TitleUp", 1, { Title = key, Fanfare = def.Fanfare == true })
	if announce then
		call("CommunityService", "Announce", "prog.titleAnnounce", { p.DisplayName, def.Name })
	end
	markDirty(p, "Prog")
	return true
end

local function grantAchievementReward(p: Player, prog: Data, entry: any): boolean
	local reward = entry.Reward or {}
	local okAll = true
	if reward.Minutes then
		local amount = incomeCredits(p, reward.Minutes, reward.Min or 0)
		if amount > 0 then
			local ok, credited = call("ShopService", "Credit", p, amount, "Achievement")
			okAll = okAll and ok and credited == true
		end
	end
	if reward.Decor then
		local ok, granted = call("ShopService", "Grant", p, { Decor = { [reward.Decor] = 1 } }, "Achievement")
		okAll = okAll and ok and granted == true
	end
	if reward.Cosmetic then
		local ok, granted = call("ShopService", "Grant", p, { Cosmetics = { reward.Cosmetic } }, "Achievement")
		okAll = okAll and ok and granted == true
	end
	if reward.Title then
		grantTitle(p, prog, reward.Title, false)
	end
	return okAll
end

local function unlockAchievement(p: Player, prog: Data, entry: any)
	if prog.Ach[entry.Id] then
		return
	end
	prog.Ach[entry.Id] = true
	if not grantAchievementReward(p, prog, entry) then
		prog.AchPending[entry.Id] = true -- Shop (noch) nicht erreichbar: später nachbuchen
	end
	effect(p, "Achievement", 1, { Id = entry.Id })
	call("MetricsService", "Custom", p, "Achievement", 1, { Id = entry.Id })
	markDirty(p, "Prog")
end

local function retryPendingRewards(p: Player, prog: Data)
	for id in pairs(prog.AchPending) do
		local entry = PCFG.AchievementById[id]
		if entry and not grantAchievementReward(p, prog, entry) then
			return -- Shop weiter nicht erreichbar
		end
		prog.AchPending[id] = nil
	end
end

local function checkAchievements(p: Player, prog: Data)
	for _, entry in ipairs(Core.NewAchievements(prog)) do
		unlockAchievement(p, prog, entry)
	end
end

local function badgeStat(prog: Data, stat: string): number
	if stat == "Joined" then
		return 1
	end
	return num(prog.AchProgress[stat], 0)
end

local function awardBadges(p: Player, prog: Data)
	if p.UserId <= 0 then
		return -- Studio-Testspieler: keine Badges
	end
	local busy = badgeBusy[p]
	if not busy then
		busy = {}
		badgeBusy[p] = busy
	end
	for _, badge in ipairs(PCFG.Badges) do
		if badge.Id > 0 and not prog.Badges[badge.Key] and not busy[badge.Key] then
			if badgeStat(prog, badge.Stat) >= badge.Min then
				busy[badge.Key] = true
				local userId, badgeId, key = p.UserId, badge.Id, badge.Key
				task.spawn(function()
					local ok, err = pcall(function()
						return BadgeService:AwardBadgeAsync(userId, badgeId)
					end)
					local current = busy
					if ok then
						local live = if p.Parent == Players then progOf(p) else nil
						if live then
							live.Badges[key] = true
							markDirty(p, "Prog")
						end
					else
						logError("AwardBadgeAsync " .. key, err)
					end
					current[key] = nil
				end)
			end
		end
	end
end

local function updateWealthTitle(p: Player, prog: Data, wealth: number)
	local key = ProgressMath.WealthTitle(wealth)
	local isNew = false
	-- alle erreichten Vermögens-Titel besitzen (Sprung über mehrere Stufen -> nur der höchste wird gefeiert)
	for _, entry in ipairs(PCFG.Titles.Wealth) do
		if wealth >= entry.Min and not prog.Titles[entry.Key] then
			prog.Titles[entry.Key] = true
			if entry.Key == key and entry.Key ~= "Starter" then
				isNew = true
			end
		end
	end
	if isNew then
		local def = PCFG.TitleByKey[key]
		effect(p, "TitleUp", 1, { Title = key, Fanfare = def.Fanfare == true })
		call("CommunityService", "Announce", "prog.titleAnnounce", { p.DisplayName, def.Name })
	end
	-- Anzeige folgt automatisch dem höchsten Vermögens-Titel, solange kein Sonder-Titel und nicht „Kein Titel“ gewählt ist
	local current = prog.Title
	local isWealthTitle = prog.TitleOff ~= true
		and (current == "" or (PCFG.TitleByKey[current] and PCFG.TitleByKey[current].Min ~= nil))
	if isWealthTitle and current ~= key then
		prog.Title = key
		isNew = true
	end
	if isNew then
		setAttributes(p, prog)
		markDirty(p, "Prog")
	end
end

-- ---------------------------------------------------------------------
-- 5) LIZENZ-AUFSTIEG (Zeremonie §A7 #9)
-- ---------------------------------------------------------------------
local function checkLicence(p: Player, prog: Data)
	local promoted = Core.Promote(prog, today(), Util.IsoWeek(), function(idx: number)
		call("OrderService", "SetLicence", p, idx)
	end)
	for _, idx in ipairs(promoted) do
		local def = licenceDefAt(idx)
		effect(p, "LicenceUp", 1, { Licence = idx, Key = def.Key, Basis = def.Basis, BauKurs = def.BauKurs })
		call("CommunityService", "Announce", "prog.licenceAnnounce", { p.DisplayName, def.Name })
		call("MetricsService", "Progression", p, "Licence", "Complete", idx)
		if idx >= 2 then
			funnel(p, 14)
		end
		if idx >= PCFG.LicenceLegend then
			grantTitle(p, prog, "Legend", false)
			-- goldenes Terminal-Theme bucht refreshMaxStats (auch nach, falls der Shop gerade fehlt); das Auto
			-- „Singularity“ schaltet VehicleService über die Lizenz frei
		end
	end
	setAttributes(p, prog)
end

-- ---------------------------------------------------------------------
-- 6) ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function ProgressionService.AddXp(p: Player, base: number, reason: string, opts: { NoMult: boolean? }?): number
	if not isPlayer(p) or type(reason) ~= "string" then
		return 0
	end
	local source = PCFG.XpSources[reason]
	if type(source) ~= "table" then
		logError("AddXp", "unbekannter Grund " .. reason .. " (nur Config.Progression.XpSources)")
		return 0
	end
	local prog = progOf(p)
	if not prog then
		return 0
	end
	local noMult = source.NoMult == true or (type(opts) == "table" and opts.NoMult == true)
	local before = Core.Level(prog)
	local gained = Core.AddXp(prog, base, reason, if noMult then 1 else xpMult(), today(), Util.IsoWeek())
	if gained <= 0 then
		return 0
	end
	local after = Core.Level(prog)
	if after > before then
		notify(p, "prog.levelUp", { after }, "Success")
		call("MetricsService", "Progression", p, "TraderLevel", "Complete", after)
	end
	checkLicence(p, prog)
	markDirty(p, "Prog")
	return gained
end

function ProgressionService.Licence(p: Player): number
	local prog = progOf(p)
	return if prog then prog.Licence else 1
end

function ProgressionService.LicenceDef(p: Player): Types.Licence
	return licenceDefAt(ProgressionService.Licence(p))
end

function ProgressionService.TradingPerks(p: Player): Types.TradingPerks
	local prog = progOf(p)
	if not prog then
		return Core.TradingPerks({ Licence = 1, KH = {} })
	end
	return Core.TradingPerks(prog)
end

function ProgressionService.TraderFactor(p: Player): (number, number, number)
	local prog = progOf(p)
	if not prog then
		return 1, 1, 1
	end
	return ProgressMath.TraderFactor(licenceDefAt(prog.Licence).TowerBonus, Core.RufLevel(prog))
end

function ProgressionService.Level(p: Player): number
	local prog = progOf(p)
	return if prog then Core.Level(prog) else 1
end

function ProgressionService.Ruf(p: Player): number
	local prog = progOf(p)
	return if prog then Core.RufLevel(prog) else 0
end

function ProgressionService.Stars(p: Player): number
	local prog = progOf(p)
	return if prog then Core.StarsFree(prog) else 0
end

function ProgressionService.Perk(p: Player, branch: string): number
	local prog = progOf(p)
	if not prog or type(branch) ~= "string" then
		return 0
	end
	return math.floor(num(prog.Prestige.Perks[branch], 0))
end

function ProgressionService.IpoCount(p: Player): number
	local prog = progOf(p)
	return if prog then prog.Prestige.Count else 0
end

function ProgressionService.Wealth(p: Player): number
	return wealthOf[p] or 0
end

function ProgressionService.Title(p: Player): string
	local prog = progOf(p)
	return if prog then prog.Title else ""
end

function ProgressionService.AlbumSets(p: Player): number
	local prog = progOf(p)
	return if prog then Core.AlbumSets(prog) else 0
end

function ProgressionService.Unlock(p: Player, achId: string)
	if not isPlayer(p) or type(achId) ~= "string" then
		return
	end
	local entry = PCFG.AchievementById[achId]
	local prog = progOf(p)
	if entry and prog then
		unlockAchievement(p, prog, entry)
	end
end

function ProgressionService.GrantTitle(p: Player, key: string): boolean
	if not isPlayer(p) or type(key) ~= "string" then
		return false
	end
	local prog = progOf(p)
	if not prog then
		return false
	end
	return grantTitle(p, prog, key, false)
end

-- Erfolgs-Zähler (andere WPs über RewardService.Track bzw. direkt): mode "add" (Standard) oder "max"
function ProgressionService.NoteStat(p: Player, stat: string, amount: number, mode: string?)
	if not isPlayer(p) or type(stat) ~= "string" or not finite(amount) then
		return
	end
	local mapped = STAT_FROM[stat]
	if not mapped then
		return
	end
	local prog = progOf(p)
	if not prog then
		return
	end
	if Core.Stat(prog, mapped, math.clamp(amount, 0, 1e9), mode) then
		checkAchievements(p, prog)
		markDirty(p, "Prog")
	end
end

-- Prüfungs-Aufgabe erfüllt (nur Server-Signale; Rückgabe: neu erfüllt?)
local function examDone(p: Player, prog: Data, task: string): boolean
	if not PCFG.ExamByKey[task] or prog.Exams[task] then
		return false
	end
	prog.Exams[task] = true
	notify(p, "prog.examTaskDone", { T(p, "prog.exam." .. task) }, "Success")
	checkLicence(p, prog)
	markDirty(p, "Prog")
	return true
end

function ProgressionService.ExamDone(p: Player, task: string): boolean
	if not isPlayer(p) or type(task) ~= "string" then
		return false
	end
	local prog = progOf(p)
	return prog ~= nil and examDone(p, prog, task)
end

function ProgressionService.AdminSetLicence(p: Player, idx: number): boolean
	if not isPlayer(p) then
		return false
	end
	local prog = progOf(p)
	if not prog then
		return false
	end
	local ok = Core.AdminLicence(prog, idx, function(fnName: string, arg: any)
		if fnName == "SetLicence" then
			call("OrderService", "SetLicence", p, arg)
		elseif fnName == "TaintWeek" then
			call("OrderService", "TaintWeek", p, arg) -- Admin-Gabe: Liga-Woche des Empfängers zählt nicht
		end
	end)
	if not ok then
		return false
	end
	local def = licenceDefAt(idx)
	effect(p, "LicenceUp", 1, { Licence = idx, Key = def.Key, Basis = def.Basis, BauKurs = def.BauKurs, Admin = true })
	setAttributes(p, prog)
	markDirty(p, "Prog")
	return true
end

-- ---------------------------------------------------------------------
-- 7) SIGNALE: TRADES, BÖRSENTAGE, GLOCKE, NEWS, TURM
-- ---------------------------------------------------------------------
local function ensureDay(p: Player, data: Data)
	local day = today()
	if data.LastUtcDay ~= day then
		Core.DayRoll(data, day)
		markDirty(p, "Prog")
	end
end

local function sectorOf(i: number): string?
	local def = instDef(i)
	if not def or def.Class == SECTOR_ETF or def.Set == "Tutorial" then
		return nil
	end
	return def.Sector
end

local function heldSectors(data: Data): number
	local depot = data.Depot
	local pos = if type(depot) == "table" then depot.Pos else nil
	local seen: { [string]: boolean } = {}
	local n = 0
	if type(pos) == "table" then
		for key, position in pairs(pos) do
			local i = tonumber(key)
			if i and type(position) == "table" and num(position.Q, 0) > 0 then
				local sector = sectorOf(i)
				if sector and not seen[sector] then
					seen[sector] = true
					n += 1
				end
			end
		end
	end
	return n
end

local function holdsAny(data: Data): boolean
	local depot = data.Depot
	if type(depot) ~= "table" or type(depot.Pos) ~= "table" then
		return false
	end
	for _, position in pairs(depot.Pos) do
		if type(position) == "table" and num(position.Q, 0) > 0 then
			return true
		end
	end
	return false
end

local function holds(data: Data, i: number): boolean
	local depot = data.Depot
	local pos = if type(depot) == "table" and type(depot.Pos) == "table" then depot.Pos[tostring(i)] else nil
	return type(pos) == "table" and num(pos.Q, 0) > 0
end

local function watches(data: Data, i: number): boolean
	local depot = data.Depot
	if type(depot) ~= "table" or type(depot.Watch) ~= "table" then
		return false
	end
	for _, list in ipairs(depot.Watch) do
		if type(list) == "table" and table.find(list, i) then
			return true
		end
	end
	return false
end

local function albumAdd(p: Player, prog: Data, i: number)
	local isNew, setSector = Core.AlbumAdd(prog, i)
	if not isNew then
		return
	end
	Core.Stat(prog, "AlbumCards", Core.AlbumCards(prog), "max")
	Core.Stat(prog, "AlbumSets", Core.AlbumSets(prog), "max")
	local def = instDef(i)
	if setSector then
		local sectorName = setSector
		for _, sector in ipairs(companies().Sectors or {}) do
			if sector.Key == setSector and type(sector.Name) == "table" then
				sectorName = Lang.Pick(langOf(p), sector.Name)
			end
		end
		notify(p, "prog.albumSet", { sectorName }, "Success")
	elseif def then
		notify(p, "prog.albumCard", { def.Ticker }, "Info")
	end
end

local function onTrade(p: Player, fill: Types.FillInfo)
	if not isPlayer(p) or type(fill) ~= "table" then
		return
	end
	local prog, data = progOf(p)
	if not prog or not data then
		return
	end
	ensureDay(p, data)
	local i = fill.I
	if fill.Side == "B" then
		albumAdd(p, prog, i)
		if fill.Bot then
			markDirty(p, "Prog")
			return -- Bots handeln still: keine XP, keine Quests, keine Prüfungen
		end
		-- jüngste Käufe (für "★★★-Analyst" und Quartalszahlen-Quests), begrenzt
		local buys = recentBuys[p]
		if not buys then
			buys = {}
			recentBuys[p] = buys
		end
		buys[i] = fill.Tick
		local count = 0
		for _ in pairs(buys) do
			count += 1
		end
		if count > MAX_RECENT_BUYS then
			local oldestI, oldestT = nil, math.huge
			for inst, t in pairs(buys) do
				if t < oldestT then
					oldestI, oldestT = inst, t
				end
			end
			if oldestI then
				buys[oldestI] = nil
			end
		end
		if fill.Protected then
			examDone(p, prog, "ProtectPair")
		end
		local held = heldSectors(data)
		Core.Stat(prog, "Sectors", held, "max")
		if held >= PCFG.Exam.Sectors then
			examDone(p, prog, "Sectors3")
		end
		-- "Kaufe in einem neuen Sektor": erster Kauf je Sektor und UTC-Tag
		local sector = sectorOf(i)
		if sector then
			local day = today()
			local entry = sectorsToday[p]
			if not entry or entry.Day ~= day then
				entry = { Day = day, Set = {} }
				sectorsToday[p] = entry
			end
			if not entry.Set[sector] then
				entry.Set[sector] = true
				track(p, "NewSector", 1, { Sector = sector })
			end
		end
		-- "Kaufe nach einer guten Nachricht": Fakten-Nachricht in Kaufrichtung ≤ 60 s vorher
		local okNews, news = call("MarketService", "FactNewsFor", i, fill.Tick, PCFG.Exam.GoodNewsSeconds)
		if okNews and type(news) == "table" and num(news.Dir, 0) > 0 then
			examDone(p, prog, "BuyAfterGood")
		end
		local flags = data.Flags
		if type(flags) == "table" and flags.FirstLiveTrade ~= true then
			flags.FirstLiveTrade = true
			funnel(p, 11)
			markDirty(p, "Flags")
		end
	elseif fill.Side == "S" and not fill.Bot then
		local trading = Config.Trading or {}
		local counting = num(fill.PctNav, 0) >= num(trading.MinTradePct, 0.02)
			and num(fill.HeldS, 0) >= num(trading.MinHoldSeconds, 60)
		if counting then
			ProgressionService.AddXp(p, PCFG.XpSources.Trade.Xp, "Trade")
			Core.Stat(prog, "Trades", 1)
			if num(fill.Pnl, 0) > 0 then
				ProgressionService.AddXp(p, PCFG.XpSources.TradeProfit.Xp, "TradeProfit")
				Core.Stat(prog, "ProfitTrades", 1)
				track(p, "TradeProfit", 1, { I = i })
				if fill.Protected then
					examDone(p, prog, "ProtectedProfit")
				end
			end
			if fill.Protected then
				ProgressionService.AddXp(p, PCFG.XpSources.TradeProtected.Xp, "TradeProtected")
				Core.Stat(prog, "ProtectedTrades", 1)
				track(p, "TradeProtected", 1, { I = i })
			end
		end
		if fill.ReadWell then
			ProgressionService.AddXp(p, PCFG.XpSources.ReadWell.Xp, "ReadWell")
			Core.Stat(prog, "ReadWell", 1)
			examDone(p, prog, "BuyAfterGood")
		end
	end
	checkAchievements(p, prog)
	markDirty(p, "Prog")
end

local function checkLeagueExams(p: Player, prog: Data, data: Data)
	local ok, stats = call("OrderService", "LeagueStats", p)
	local league = data.League
	local exam = PCFG.Exam
	local tierLevel = 0
	if ok and type(stats) == "table" then
		if
			not stats.Tainted
			and num(stats.SkillScore, 0) >= exam.SkillMin
			and num(stats.Days, 0) >= exam.SkillMinDays
		then
			examDone(p, prog, "Skill500")
		end
		if stats.Qualified then
			local score = num(stats.SkillScore, 0)
			for _, tier in ipairs((Config.Trading or {}).League and Config.Trading.League.Tiers or {}) do
				if score >= num(tier.Min, math.huge) then
					tierLevel = math.max(tierLevel, TIER_LEVEL[tier.Key] or 0)
				end
			end
		end
	end
	if type(league) == "table" then
		if league.LastQualified == true and num(league.LastScore, 0) >= exam.SkillMin then
			examDone(p, prog, "Skill500")
		end
		tierLevel = math.max(tierLevel, TIER_LEVEL[league.LastTier] or 0)
		-- Drawdown-Aufgabe aus der laufenden Woche: mindestens DrawdownMinDays zählende Börsentage, nicht getaintet
		local returns = league.Returns
		if
			type(returns) == "table"
			and #returns >= exam.DrawdownMinDays
			and num(league.Days, 0) >= exam.DrawdownMinDays
			and league.Tainted ~= true
		then
			if
				ProgressMath.MaxDrawdown(returns) < exam.DrawdownMax
				and ProgressMath.AvgDaily(returns) >= exam.AvgDailyMin
			then
				examDone(p, prog, "LowDrawdown")
			end
		end
	end
	if tierLevel >= 3 then
		examDone(p, prog, "LeagueGold")
	end
	if tierLevel >= 4 then
		examDone(p, prog, "LeagueDiamond")
	end
	Core.Stat(prog, "LeagueTier", tierLevel, "max")
end

-- Saison-XP je zählendem Börsentag (Config.Season.XpSources.CountingDay.Xp, Standard 25)
local function countingDaySeasonXp(): number
	local season = Config.Season
	local sources = if type(season) == "table" then season.XpSources else nil
	local entry = if type(sources) == "table" then sources.CountingDay else nil
	return if type(entry) == "table" then num(entry.Xp, 25) else 25
end

local function onDayResult(p: Player, result: Types.DayResult)
	if not isPlayer(p) or type(result) ~= "table" then
		return
	end
	local prog, data = progOf(p)
	if not prog or not data then
		return
	end
	ensureDay(p, data)
	if result.Qualifying then
		local r = num(result.Return, 0)
		local ruf = PCFG.Ruf
		local points = ruf.DayBase
			+ (if r > 0 then ruf.DayPositive else 0)
			+ (if r >= ruf.StrongReturn then ruf.DayStrong else 0)
		Core.AddRuf(prog, points, today(), true)
		call("RewardService", "GrantSeasonXp", p, countingDaySeasonXp(), "CountingDay")
		if r > 0 then
			ProgressionService.AddXp(p, PCFG.XpSources.PositiveDay.Xp, "PositiveDay")
			Core.Stat(prog, "PositiveDays", 1)
			local run = num(prog.AchProgress.PosRun, 0) + 1
			prog.AchProgress.PosRun = run
			Core.Stat(prog, "PosStreak", run, "max")
			track(p, "PositiveDay", 1, { Return = r })
		else
			prog.AchProgress.PosRun = 0
		end
	end
	checkLeagueExams(p, prog, data)
	checkAchievements(p, prog)
	markDirty(p, "Prog")
end

local function inBellZone(p: Player): boolean
	local character = p.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false
	end
	local ok, cf = call("CityService", "Anchor", "BellZone")
	local center: Vector3
	if ok and typeof(cf) == "CFrame" then
		center = cf.Position
	else
		local zones = (Config.City or {}).Zones
		local plaza = zones and zones.Plaza
		if not plaza then
			return false
		end
		center = plaza.Center
	end
	local radius = 18
	local zones = (Config.City or {}).Zones
	if zones and zones.Plaza and finite(zones.Plaza.BellZoneRadius) then
		radius = zones.Plaza.BellZoneRadius
	end
	local offset = root.Position - center
	return Vector2.new(offset.X, offset.Z).Magnitude <= radius + 2 and math.abs(offset.Y) < 40
end

local function onBell(p: Player)
	if not isPlayer(p) then
		return
	end
	local data = dataOf(p)
	if not data then
		return
	end
	if holdsAny(data) then
		track(p, "HoldThroughBell", 1, nil)
	end
	if inBellZone(p) then
		track(p, "Bell", 1, nil) -- RewardService zählt Quest + Erfolg (NoteStat "Bell")
	end
end

local READ_NEWS_KINDS: { [string]: boolean } = { Macro = true, Sector = true, Crash = true, Rally = true, Ipo = true }

local function onNews(n: Types.NewsItem)
	if type(n) ~= "table" or type(n.Kind) ~= "string" then
		return
	end
	local isCrash = n.Kind == "Crash"
	local isEarnings = n.Kind == "Earnings" and n.I ~= nil and finite(n.Dir) and n.Dir ~= 0
	local exam = PCFG.Exam
	for _, p in ipairs(Players:GetPlayers()) do
		local ok, ready = call("PlayerStateService", "IsReady", p)
		if not ok or ready ~= true then
			continue
		end
		local data = dataOf(p)
		if not data then
			continue
		end
		-- "Lies Eilmeldungen": Nachrichten, die auch die News-Karte zeigen würde (§B7.4)
		local relevant = READ_NEWS_KINDS[n.Kind] == true
		if not relevant and n.I ~= nil and num(n.Band, 0) >= 2 then
			relevant = holds(data, n.I) or watches(data, n.I)
		end
		if relevant then
			track(p, "ReadNews", 1, { Kind = n.Kind })
		end
		-- Crash-Prüfung: investiert in den Crash (≥ 10 % des Depotwerts), Ergebnis nach dem Fenster
		if isCrash and not crashWatch[p] then
			local okNav, nav = call("OrderService", "Nav", p)
			local depot = data.Depot
			local cash = if type(depot) == "table" then num(depot.Cash, 0) else 0
			if okNav and finite(nav) and nav > 0 and (nav - cash) / nav >= exam.CrashMinExposure then
				local prog = progOf(p)
				local failTick = if prog then num(prog.ExamProgress.CrashFail, -math.huge) else -math.huge
				local okTick, tick = call("MarketService", "Tick")
				local nowTick = if okTick and finite(tick) then tick else 0
				if nowTick - failTick >= exam.RetryTicks then
					crashWatch[p] = {
						Nav0 = nav,
						Basis0 = if type(depot) == "table" then num(depot.Basis, 0) else 0,
						Until = os.clock() + exam.CrashSeconds,
					}
				end
			end
		end
		-- "★★★-Analyst bei Quartalszahlen": Kauf ≤ 5 min vor den Zahlen, Zahlen in Kaufrichtung, noch gehalten
		if isEarnings then
			local buys = recentBuys[p]
			local t = buys and buys[n.I :: number]
			if
				t
				and finite(n.T)
				and t <= n.T
				and n.T - t <= exam.EarningsLeadSeconds
				and holds(data, n.I :: number)
			then
				buys[n.I :: number] = nil
				local prog = progOf(p)
				if prog then
					Core.Stat(prog, "EarningsTrades", 1)
					track(p, "EarningsTrade", 1, { I = n.I })
					if (n.Dir :: number) > 0 then
						examDone(p, prog, "Analyst3")
					end
					checkAchievements(p, prog)
					markDirty(p, "Prog")
				end
			end
		end
	end
end

local function crashTick()
	local now = os.clock()
	for p, watch in pairs(crashWatch) do
		if p.Parent ~= Players then
			crashWatch[p] = nil
		elseif now >= watch.Until then
			crashWatch[p] = nil
			local prog, data = progOf(p)
			local okNav, nav = call("OrderService", "Nav", p)
			if prog and data and okNav and finite(nav) and watch.Nav0 > 0 then
				-- Basis-Erhöhung (Lizenz-Aufstieg) ist ein Fluss, kein Gewinn -> herausrechnen
				local depot = data.Depot
				local basisNow = if type(depot) == "table" then num(depot.Basis, watch.Basis0) else watch.Basis0
				local adjusted = nav - math.max(0, basisNow - watch.Basis0)
				local loss = 1 - adjusted / watch.Nav0
				if loss < PCFG.Exam.CrashMaxLoss then
					Core.Stat(prog, "CrashSurvived", 1)
					examDone(p, prog, "CrashSurvive")
					notify(p, "prog.crashSurvived", nil, "Success")
				elseif not prog.Exams.CrashSurvive then
					local okTick, tick = call("MarketService", "Tick")
					prog.ExamProgress.CrashFail = if okTick and finite(tick) then tick else 0
					notify(p, "prog.examCrashFailed", nil, "Info")
				end
				checkAchievements(p, prog)
				markDirty(p, "Prog")
			end
		end
	end
end

local function onStage(p: Player, stage: number)
	if not isPlayer(p) or not finite(stage) then
		return
	end
	local prog = progOf(p)
	if prog then
		Core.Stat(prog, "Stage", stage, "max")
		checkAchievements(p, prog)
		awardBadges(p, prog)
		markDirty(p, "Prog")
	end
end

local function onFloor(p: Player, floor: number, stage: number)
	if not isPlayer(p) or not finite(floor) then
		return
	end
	local prog = progOf(p)
	if prog then
		Core.Stat(prog, "Floors", floor, "max")
		if finite(stage) then
			Core.Stat(prog, "Stage", stage, "max")
		end
		checkAchievements(p, prog)
		awardBadges(p, prog)
		markDirty(p, "Prog")
	end
end

-- ---------------------------------------------------------------------
-- 8) PERIODISCH JE SPIELER (alle 5 s, gestaffelt): Vermögen, Höchstwerte, Erfolge, Badges, Anzeige
-- ---------------------------------------------------------------------
local function countKeys(t: any): number
	local n = 0
	if type(t) == "table" then
		for _, v in pairs(t) do
			if v == true or (finite(v) and v > 0) then
				n += 1
			end
		end
	end
	return n
end

local function computeWealth(p: Player, prog: Data, data: Data): number
	local okCr, balance = call("ShopService", "Balance", p)
	local cr = if okCr and finite(balance) then balance else num(data.Credits, 0)
	local okTv, towerValue = call("TowerService", "TowerValue", p)
	local okCars, cars = call("VehicleService", "CollectionValue", p)
	local okLife, life = call("LifestyleService", "CollectionValue", p)
	local okNav, nav = call("OrderService", "Nav", p)
	-- Vehicle-/LifestyleService liefern die Summe der Kaufpreise; zum Vermögen zählen davon 50 % (§B9.5)
	local prices = (if okCars and finite(cars) then cars else 0) + (if okLife and finite(life) then life else 0)
	return Core.Wealth({
		Credits = cr,
		TowerValue = if okTv and finite(towerValue) then towerValue else 0,
		Firm = prog.Prestige.Firmenwert,
		Collection = math.max(0, prices) * num(PCFG.WealthCollectionPct, 0.5),
		NavCents = if okNav and finite(nav) then nav else 0,
	}, licenceDefAt(prog.Licence).BauKurs)
end

local function refreshMaxStats(p: Player, prog: Data, data: Data)
	local okFloors, floors = call("TowerService", "Floors", p)
	if okFloors and finite(floors) then
		Core.Stat(prog, "Floors", floors, "max")
	end
	local okStage, stage = call("TowerService", "Stage", p)
	if okStage and finite(stage) then
		Core.Stat(prog, "Stage", stage, "max")
	end
	local tower = data.Tower
	if type(tower) == "table" then
		Core.Stat(prog, "Eff", num(tower.Eff, 0), "max")
	end
	Core.Stat(prog, "Ipos", prog.Prestige.Count, "max")
	Core.Stat(prog, "Licence", prog.Licence, "max")
	local lessons, perfect = 0, 0
	for _, value in pairs(prog.Lessons) do
		lessons += 1
		if value >= 2 then
			perfect += 1
		end
	end
	Core.Stat(prog, "Lessons", lessons, "max")
	Core.Stat(prog, "Perfect", perfect, "max")
	Core.Stat(prog, "KHSpent", Core.KhSpent(prog), "max")
	Core.Stat(prog, "AlbumCards", Core.AlbumCards(prog), "max")
	Core.Stat(prog, "AlbumSets", Core.AlbumSets(prog), "max")
	local garage = data.Garage
	Core.Stat(prog, "Cars", countKeys(if type(garage) == "table" then garage.Cars else nil), "max")
	local life = data.Life
	Core.Stat(prog, "Watches", countKeys(if type(life) == "table" then life.Watches else nil), "max")
	local storage = data.Storage
	Core.Stat(prog, "DecorKinds", countKeys(if type(storage) == "table" then storage.Decor else nil), "max")
	local login = data.Login
	if type(login) == "table" then
		Core.Stat(prog, "LoginStreak", num(login.Best, 0), "max")
	end
	-- Börsen-Legende: goldenes Terminal-Theme nachbuchen, falls der Shop beim Aufstieg nicht erreichbar war
	local cosmetic = PCFG.LegendCosmetic
	if prog.Licence >= PCFG.LicenceLegend and type(cosmetic) == "string" then
		local purchases = data.Purchases
		local owned = if type(purchases) == "table" then purchases.Cosmetics else nil
		local has = type(owned) == "table" and (owned[cosmetic] == true or table.find(owned, cosmetic) ~= nil)
		if not has then
			call("ShopService", "Grant", p, { Cosmetics = { cosmetic } }, "Achievement")
		end
	end
	-- Tutorial-Übung (ACAD) lief mit "Schutz an" -> Aufgabe "Setze ein Schutz-Paar" erfüllt (§B2 ~7:00)
	if not prog.Exams.ProtectPair then
		local okTut, state = call("OrderService", "TutorialState", p)
		if okTut and state == "Done" then
			examDone(p, prog, "ProtectPair")
		end
	end
end

local function playerTick(p: Player)
	if not isPlayer(p) then
		return
	end
	local okReady, ready = call("PlayerStateService", "IsReady", p)
	if not okReady or ready ~= true then
		return
	end
	local prog, data = progOf(p)
	if not prog or not data then
		return
	end
	ensureDay(p, data)
	local before = table.clone(prog.AchProgress)
	refreshMaxStats(p, prog, data)
	local wealth = computeWealth(p, prog, data)
	local old = wealthOf[p]
	wealthOf[p] = wealth
	Core.Stat(prog, "Wealth", wealth, "max")
	if old ~= wealth then
		call("PlayerStateService", "SetLeaderstat", p, "Vermögen", wealth)
		call("LeaderboardService", "Submit", p)
	end
	updateWealthTitle(p, prog, wealth)
	checkLeagueExams(p, prog, data)
	checkAchievements(p, prog)
	awardBadges(p, prog)
	retryPendingRewards(p, prog)
	local changed = old ~= wealth
	if not changed then
		for key, value in pairs(prog.AchProgress) do
			if before[key] ~= value then
				changed = true
				break
			end
		end
	end
	if changed then
		markDirty(p, "Prog")
	end
end

-- ---------------------------------------------------------------------
-- 9) STATE "Prog" (§C10)
-- ---------------------------------------------------------------------
local function progState(p: Player): { [string]: any }
	local prog, data = progOf(p)
	if not prog or not data then
		return {
			Xp = 0,
			Level = 1,
			Licence = 1,
			Exams = {},
			KnowHow = {},
			KH = 0,
			Ruf = 0,
			RufPts = 0,
			Title = "",
			Titles = {},
			Album = {},
			Ach = {},
			Stars = 0,
			Perks = {},
			Ipos = 0,
		}
	end
	local level, progress = ProgressMath.LevelFromXp(prog.Xp)
	local nextIdx = math.min(prog.Licence + 1, #PCFG.Licences)
	local titles = {}
	for key in pairs(prog.Titles) do
		table.insert(titles, key)
	end
	table.sort(titles)
	local total, licPart, rufPart =
		ProgressMath.TraderFactor(licenceDefAt(prog.Licence).TowerBonus, Core.RufLevel(prog))
	local ph, phUntil = powerHourInfo()
	local tickers = {}
	for i = 1, math.min(5, #prog.Prestige.Tickers) do
		table.insert(tickers, prog.Prestige.Tickers[i].T)
	end
	local rufLevel = Core.RufLevel(prog)
	local thresholds = PCFG.Ruf.Thresholds
	return {
		Xp = prog.Xp,
		Level = level,
		LevelProgress = progress,
		NextLevelXp = ProgressMath.XpForLevel(math.min(level + 1, PCFG.MaxLevel)),
		Licence = prog.Licence,
		Exams = prog.Exams,
		ExamTasks = if prog.Licence < #PCFG.Licences then Core.ExamTasks(prog, nextIdx) else {},
		NextLicenceXp = if prog.Licence < #PCFG.Licences then PCFG.Licences[nextIdx].Xp else 0,
		CrashFail = num(prog.ExamProgress.CrashFail, 0),
		Lessons = prog.Lessons,
		KnowHow = prog.KH,
		KH = Core.KhFree(prog),
		KHTotal = Core.KhTotal(prog),
		KHSpent = Core.KhSpent(prog),
		KHResetFree = prog.KHResetWeek ~= Util.IsoWeek(),
		Ruf = rufLevel,
		RufPts = prog.Ruf,
		RufToday = if prog.RufDay == today() then prog.RufToday else 0,
		RufNext = thresholds[math.min(ProgressMath.RufLevel(prog.Ruf) + 1, #thresholds)],
		Factor = { Total = total, Licence = licPart, Ruf = rufPart },
		Title = prog.Title,
		Titles = titles,
		Album = prog.Album,
		AlbumSets = Core.AlbumSets(prog),
		Ach = prog.Ach,
		AchProgress = prog.AchProgress,
		Badges = prog.Badges,
		Stars = Core.StarsFree(prog),
		StarsTotal = prog.Prestige.Stars,
		Perks = prog.Prestige.Perks,
		Ipos = prog.Prestige.Count,
		Firm = prog.Prestige.Firmenwert,
		Tickers = tickers,
		RespecFree = prog.Prestige.RespecFree,
		Wealth = wealthOf[p] or 0,
		Tools = Core.TradingPerks(prog),
		PowerHour = ph,
		PowerHourUntil = phUntil,
		XpMult = xpMult(),
	}
end

-- ---------------------------------------------------------------------
-- 10) ANFRAGEN (§C9)
-- ---------------------------------------------------------------------
local function handleLesson(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Id", "Answers" }) or type(arg.Id) ~= "string" or type(arg.Answers) ~= "table" then
		return fail(p, "core.invalid")
	end
	local lesson = PCFG.LessonById[arg.Id]
	if not lesson then
		return fail(p, "prog.lessonUnknown")
	end
	local prog, data = progOf(p)
	if not prog or not data then
		return fail(p, "core.loading")
	end
	-- Mindest-Lesezeit zwischen zwei Abgaben derselben Lektion (gegen Durchklicken)
	local stamps = lessonAt[p]
	if not stamps then
		stamps = {}
		lessonAt[p] = stamps
	end
	local now = os.clock()
	local gap = lesson.Cards * PCFG.Academy.MinCardSeconds
	if stamps[lesson.Id] and now - stamps[lesson.Id] < gap then
		return fail(p, "prog.lessonTooFast")
	end
	local correct, total = Core.LessonResult(lesson.Id, arg.Answers, QUIZ_KEY)
	if not correct or not total then
		return fail(p, "core.invalid")
	end
	stamps[lesson.Id] = now
	local pass = correct >= math.ceil(total * PCFG.Academy.PassRatio)
	if not pass then
		return { Ok = false, Message = T(p, "prog.lessonFail", correct, total), Correct = correct, Total = total }
	end
	ensureDay(p, data)
	local perfect = correct == total
	local before = prog.Lessons[lesson.Id]
	local firstEver = next(prog.Lessons) == nil
	local gained = 0
	if before == nil then
		gained += ProgressionService.AddXp(p, PCFG.XpSources.LessonFirst.Xp, "LessonFirst")
	else
		gained += ProgressionService.AddXp(p, PCFG.XpSources.LessonRepeat.Xp, "LessonRepeat")
	end
	if perfect and before ~= 2 then
		gained += ProgressionService.AddXp(p, PCFG.XpSources.LessonPerfect.Xp, "LessonPerfect")
	end
	prog.Lessons[lesson.Id] = math.max(num(before, 0), if perfect then 2 else 1)
	if firstEver then
		Core.AddRuf(prog, PCFG.Ruf.FirstLesson, today(), false)
	end
	if lesson.Id == "L01" and before == nil then
		funnel(p, 13)
	end
	for _, task in ipairs(PCFG.ExamTasks) do
		if task.Source == "Lesson" and task.Lesson == lesson.Id and perfect then
			examDone(p, prog, task.Key)
		end
	end
	track(p, "Lesson", 1, { Id = lesson.Id })
	refreshMaxStats(p, prog, data)
	checkLicence(p, prog)
	checkAchievements(p, prog)
	markDirty(p, "Prog")
	local key = if perfect then "prog.lessonPerfect" else "prog.lessonDone"
	return {
		Ok = true,
		Message = T(p, key, correct, total, gained),
		Correct = correct,
		Total = total,
		Xp = gained,
		Perfect = perfect,
	}
end

local function handleExam(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Licence" }) or not isInt(arg.Licence) then
		return fail(p, "core.invalid")
	end
	local prog = progOf(p)
	if not prog then
		return fail(p, "core.loading")
	end
	if prog.Licence >= #PCFG.Licences then
		return fail(p, "prog.examMax")
	end
	local idx = arg.Licence
	if idx ~= prog.Licence + 1 then
		return fail(p, "prog.examWrongLicence")
	end
	local def = PCFG.Licences[idx]
	local tasks = Core.ExamTasks(prog, idx)
	local lang = langOf(p)
	if prog.Xp < def.Xp then
		local reply = fail(p, "prog.examNeedXp", Format.Int(def.Xp - prog.Xp, lang), Lang.Pick(lang, def.Name))
		reply.Tasks = tasks
		return reply
	end
	for _, task in ipairs(tasks) do
		if not task.Done then
			local reply = fail(p, "prog.examTasks")
			reply.Tasks = tasks
			return reply
		end
	end
	checkLicence(p, prog)
	markDirty(p, "Prog")
	return { Ok = true, Message = T(p, "prog.examPassed", Lang.Pick(lang, def.Name)), Passed = true, Tasks = tasks }
end

local function handleKnowHow(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Node" }) or type(arg.Node) ~= "string" or #arg.Node > 40 then
		return fail(p, "core.invalid")
	end
	local prog = progOf(p)
	if not prog then
		return fail(p, "core.loading")
	end
	local ok, key, args = Core.BuyNode(prog, arg.Node)
	if not ok then
		if key == "prog.khLocked" and args then
			local lang = langOf(p)
			return fail(p, key, Lang.Pick(lang, licenceDefAt(args[1]).Name))
		end
		return fail(p, key)
	end
	markDirty(p, "Prog")
	return {
		Ok = true,
		Message = T(p, key, T(p, "prog.kh." .. arg.Node), (args :: { any })[1]),
		Level = prog.KH[arg.Node],
	}
end

local function handleKnowHowReset(p: Player, arg: any): Reply
	if arg ~= nil and (type(arg) ~= "table" or next(arg) ~= nil) then
		return fail(p, "core.invalid")
	end
	local prog = progOf(p)
	if not prog then
		return fail(p, "core.loading")
	end
	local ok, key = Core.ResetNodes(prog, Util.IsoWeek())
	if not ok then
		return fail(p, key)
	end
	markDirty(p, "Prog")
	return { Ok = true, Message = T(p, key) }
end

-- Initialen des Tower-Namens (Wortbausteine) als Ticker-Rückfall
local function fallbackTicker(p: Player, data: Data, blocked: (string) -> boolean): string
	local tower = data.Tower
	local names = (Config.Tower or {}).Names
	local letters = ""
	if type(tower) == "table" and type(tower.Name) == "table" and type(names) == "table" then
		local adj = names.Adj and names.Adj[tower.Name.A]
		local noun = names.Noun and names.Noun[tower.Name.N]
		for _, part in ipairs({ adj, noun }) do
			local text = if type(part) == "table" then (part.de or part.en) else part
			if type(text) == "string" then
				local first = string.match(text, "%a")
				if first then
					letters ..= string.upper(first)
				end
			end
		end
	end
	if #letters < 2 then
		local name = string.gsub(string.upper(p.Name), "[^A-Z]", "")
		letters = string.sub(name .. "TW", 1, 2)
	end
	local candidate = letters .. "T"
	if not blocked(candidate) then
		return candidate
	end
	for code = string.byte("A"), string.byte("Z") do
		local guess = letters .. "T" .. string.char(code)
		if not blocked(guess) then
			return guess
		end
	end
	return "TWR" .. string.char(string.byte("A") + (p.UserId % 26 + 26) % 26)
end

local tickerBlockSet: { [string]: boolean } = {}
for _, word in ipairs(PCFG.TickerBlock) do
	tickerBlockSet[word] = true
end

local function tickerBlocked(ticker: string): boolean
	if tickerBlockSet[ticker] then
		return true
	end
	for _, inst in ipairs(companies().Instruments or {}) do
		if type(inst) == "table" and inst.Ticker == ticker then
			return true
		end
	end
	return false
end

-- Börsengang erlaubt? (ok, Grund-Schlüssel, Argumente)
local function ipoEligible(p: Player, prog: Data): (boolean, string?, { any }?)
	local okFloors, floors = call("TowerService", "Floors", p)
	local floorCount = if okFloors and finite(floors) then floors else 0
	if floorCount < PCFG.Prestige.MinFloor then
		return false, "prog.ipoNotYet", { PCFG.Prestige.MinFloor }
	end
	local nextIpo = prog.Prestige.Count + 1
	if licenceDefAt(prog.Licence).MaxIpo < nextIpo then
		-- kleinste Lizenz, die diesen Börsengang erlaubt
		for i, def in ipairs(PCFG.Licences) do
			if def.MaxIpo >= nextIpo then
				return false, "prog.ipoLicence", { nextIpo, i }
			end
		end
		return false, "prog.ipoLicence", { nextIpo, #PCFG.Licences }
	end
	return true, nil, nil
end

local function estimateSeconds(prog: Data): number
	local blitz = math.floor(num(prog.Prestige.Perks.Blitzstart, 0))
	local blitzFloors = 0
	local blitzDef = PCFG.PerkByKey.Blitzstart
	if blitz > 0 and blitzDef and blitzDef.Floors then
		blitzFloors = blitzDef.Floors[math.min(blitz, #blitzDef.Floors)] or 0
	end
	local tempo = math.floor(num(prog.Prestige.Perks.Tempo, 0))
	local tempoDef = PCFG.PerkByKey.Tempo
	local speed = math.max(0.25, 1 - num(tempoDef and tempoDef.Step, 0.10) * tempo)
	-- Ziel: erste Etage der Vorschau-Stufe (Stufe 7 = Etage 18) aus Config.Tower.Stages, sonst der Config-Rückfall
	local target = math.floor(num(PCFG.Prestige.EstimateFloors, 18))
	local stages = (Config.Tower or {}).Stages
	local stageDef = if type(stages) == "table" then stages[PCFG.Prestige.EstimateStage or 7] else nil
	if type(stageDef) == "table" and isInt(stageDef.First) then
		target = stageDef.First
	end
	local total = 0
	for n = blitzFloors + 1, target do
		local ok, seconds = pcall(TowerMath.BuildSeconds, n, speed)
		if ok and finite(seconds) then
			total += seconds
		end
	end
	return math.floor(total * PCFG.Prestige.EstimateFactor)
end

local function handleIpoPreview(p: Player, arg: any): Reply
	if arg ~= nil and (type(arg) ~= "table" or next(arg) ~= nil) then
		return fail(p, "core.invalid")
	end
	local prog, data = progOf(p)
	if not prog or not data then
		return fail(p, "core.loading")
	end
	local okStage, stage = call("TowerService", "Stage", p)
	if not okStage or not finite(stage) or stage < PCFG.Prestige.PreviewStage then
		return fail(p, "prog.ipoPreviewStage", PCFG.Prestige.PreviewStage)
	end
	local okSpend, spend = call("TowerService", "RunSpend", p)
	local runSpend = if okSpend and finite(spend) then spend else 0
	local eligible, reason, args = ipoEligible(p, prog)
	local lang = langOf(p)
	local reasonText: string? = nil
	if reason == "prog.ipoLicence" and args then
		reasonText = T(p, reason, args[1], Lang.Pick(lang, licenceDefAt(args[2]).Name))
	elseif reason then
		reasonText = T(p, reason, table.unpack(args or {}))
	end
	local token = HttpService:GenerateGUID(false)
	ipoTokens[p] = { Token = token, Until = os.clock() + PCFG.Prestige.TokenSeconds }
	local nextCount = prog.Prestige.Count + 1
	return {
		Ok = true,
		Token = token,
		Stars = ProgressMath.Stars(runSpend),
		RunSpend = runSpend,
		Firm = ProgressMath.Clamp(PCFG.Prestige.FirmPct * runSpend),
		Count = prog.Prestige.Count,
		Next = nextCount,
		Crown = Core.CrownFor(nextCount),
		Perm = PCFG.Prestige.PermStep,
		Eligible = eligible,
		Reason = reasonText,
		EstimateSeconds = estimateSeconds(prog),
		Suggest = fallbackTicker(p, data, tickerBlocked),
	}
end

-- TextService-Filter: true = Text darf öffentlich gezeigt werden (Fehler = nein)
local function filterOk(p: Player, text: string): boolean
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, p.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	return ok and result == text
end

local function handleIpo(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Ticker", "Token" }) or type(arg.Ticker) ~= "string" or type(arg.Token) ~= "string" then
		return fail(p, "core.invalid")
	end
	if #arg.Ticker > 8 or #arg.Token > 64 then
		return fail(p, "core.invalid")
	end
	if ipoBusy[p] then
		return fail(p, "core.tooFast")
	end
	local token = ipoTokens[p]
	if not token or token.Token ~= arg.Token or os.clock() > token.Until then
		return fail(p, "prog.ipoToken")
	end
	local prog, data = progOf(p)
	if not prog or not data then
		return fail(p, "core.loading")
	end
	local eligible, reason, args = ipoEligible(p, prog)
	if not eligible then
		if reason == "prog.ipoLicence" and args then
			return fail(p, reason, args[1], Lang.Pick(langOf(p), licenceDefAt(args[2]).Name))
		end
		return fail(p, reason or "prog.ipoFailed", table.unpack(args or {}))
	end
	local wanted = string.upper(arg.Ticker)
	if not string.match(wanted, TICKER_PATTERN) then
		return fail(p, "prog.ipoTicker")
	end
	ipoBusy[p] = true
	local ticker = wanted
	local replaced = false
	if tickerBlocked(wanted) or not filterOk(p, wanted) then
		ticker = fallbackTicker(p, data, tickerBlocked)
		replaced = true
	end
	ipoBusy[p] = nil
	-- nach dem Filter (yield): Zustand neu prüfen, Token verbrauchen
	if p.Parent ~= Players then
		return { Ok = false }
	end
	local again = ipoTokens[p]
	if not again or again.Token ~= arg.Token then
		return fail(p, "prog.ipoToken")
	end
	ipoTokens[p] = nil
	prog, data = progOf(p)
	if not prog or not data then
		return fail(p, "core.loading")
	end
	if not ipoEligible(p, prog) then
		return fail(p, "prog.ipoFailed")
	end
	local okSpend, spend = call("TowerService", "RunSpend", p)
	local runSpend = if okSpend and finite(spend) then spend else 0
	local snapshot = Util.DeepCopy(prog.Prestige)
	local stars = Core.ApplyIpo(prog, runSpend, ticker, os.time())
	local okReset, reset = call("TowerService", "ResetForIpo", p, Core.PerkTable(prog))
	if not okReset or reset ~= true then
		prog.Prestige = snapshot -- alles oder nichts
		return fail(p, "prog.ipoFailed")
	end
	local count = prog.Prestige.Count
	if type(data.Stats) == "table" then
		data.Stats.Ipos = math.floor(num(data.Stats.Ipos, 0)) + 1
	end
	Core.Stat(prog, "Ipos", count, "max")
	for _, step in ipairs(PCFG.Prestige.TitleSteps) do
		if count >= step.Ipos then
			grantTitle(p, prog, step.Title, false)
		end
	end
	call("LeaderboardService", "AddIpo", p, ticker)
	call("LeaderboardService", "Submit", p)
	call("MetricsService", "Progression", p, "Ipo", "Complete", count)
	-- eine Meldung, ein Weg: der Effekt zeigt dem Spieler die Zeremonie und allen anderen das Server-Banner
	call("PlayerStateService", "EffectAll", "IpoCeremony", 1, {
		Ticker = ticker,
		UserId = p.UserId,
		Name = p.DisplayName,
		Count = count,
		Stars = stars,
		Crown = Core.CrownFor(count),
	})
	checkAchievements(p, prog)
	awardBadges(p, prog)
	markDirty(p, "Prog")
	local message = T(p, "prog.ipoDone", ticker, stars)
	if replaced then
		message = T(p, "prog.ipoBlocked", ticker) .. " " .. message
	end
	return { Ok = true, Message = message, Ticker = ticker, Stars = stars, Count = count }
end

local function handlePerk(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Branch" }) or type(arg.Branch) ~= "string" or #arg.Branch > 40 then
		return fail(p, "core.invalid")
	end
	local prog = progOf(p)
	if not prog then
		return fail(p, "core.loading")
	end
	local ok, key, args = Core.BuyPerk(prog, arg.Branch)
	if not ok then
		return fail(p, key)
	end
	local def = PCFG.PerkByKey[arg.Branch]
	local level = (args :: { any })[1]
	if def.Title and level >= def.Max then
		grantTitle(p, prog, def.Title, false) -- Vorstand Lifestyle 5: Titel "CEO" (Uhr schaltet LifestyleService frei)
	end
	markDirty(p, "Prog")
	return { Ok = true, Message = T(p, key, T(p, "prog.perk." .. arg.Branch), level), Level = level }
end

local function handleRespec(p: Player, arg: any): Reply
	if arg ~= nil and (type(arg) ~= "table" or next(arg) ~= nil) then
		return fail(p, "core.invalid")
	end
	local prog = progOf(p)
	if not prog then
		return fail(p, "core.loading")
	end
	local ok, key = Core.Respec(prog)
	if not ok then
		return fail(p, key)
	end
	markDirty(p, "Prog")
	return { Ok = true, Message = T(p, key) }
end

local function handleTitle(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Id" }) or type(arg.Id) ~= "string" or #arg.Id > 40 then
		return fail(p, "core.invalid")
	end
	local prog = progOf(p)
	if not prog then
		return fail(p, "core.loading")
	end
	if arg.Id ~= "" and not prog.Titles[arg.Id] then
		return fail(p, "prog.titleUnknown")
	end
	prog.Title = arg.Id
	prog.TitleOff = arg.Id == "" -- „Kein Titel“ bleibt stehen (sonst setzte der 5-s-Takt den Vermögens-Titel zurück)
	setAttributes(p, prog)
	markDirty(p, "Prog")
	local def = PCFG.TitleByKey[arg.Id]
	local name = if def then Lang.Pick(langOf(p), def.Name) else T(p, "prog.titleNone")
	return { Ok = true, Message = T(p, "prog.titleSet", name) }
end

-- ---------------------------------------------------------------------
-- 11) LEBENSZYKLUS
-- ---------------------------------------------------------------------
local function onReady(p: Player)
	local prog, data = progOf(p)
	if not prog or not data then
		return
	end
	Core.Repair(data)
	prog = data.Prog
	readyAt[p] = os.clock()
	ensureDay(p, data)
	Core.Stat(prog, "Licence", prog.Licence, "max")
	setAttributes(p, prog)
	-- Die Depot-Basis gleicht OrderService beim Beitritt selbst aus Prog.Licence ab (kein Doppel-Aufruf hier)
	checkLicence(p, prog)
	task.defer(playerTick, p)
	markDirty(p, "Prog")
end

local function onPlayerRemoving(p: Player)
	wealthOf[p] = nil
	ipoTokens[p] = nil
	recentBuys[p] = nil
	sectorsToday[p] = nil
	crashWatch[p] = nil
	lessonAt[p] = nil
	badgeBusy[p] = nil
	ipoBusy[p] = nil
	readyAt[p] = nil
end

function ProgressionService.Init(services: any)
	Services = services
	local pss = services.PlayerStateService
	if not pss then
		warn("[ProgressionService] PlayerStateService fehlt – keine Anfragen/State")
		return
	end
	pss.Provide("Prog", progState)
	pss.Handle("ProgLesson", handleLesson, { Rate = 1, Per = 1 })
	pss.Handle("ProgExam", handleExam, { Rate = 1, Per = 1 })
	pss.Handle("ProgKnowHow", handleKnowHow, { Rate = 2, Per = 1 })
	pss.Handle("ProgKnowHowReset", handleKnowHowReset, { Rate = 1, Per = 60 })
	pss.Handle("ProgIpoPreview", handleIpoPreview, { Rate = 1, Per = 1 })
	pss.Handle("ProgIpo", handleIpo, { Rate = 1, Per = 10 })
	pss.Handle("ProgPerk", handlePerk, { Rate = 2, Per = 1 })
	pss.Handle("ProgRespec", handleRespec, { Rate = 2, Per = 1 })
	pss.Handle("ProgTitle", handleTitle, { Rate = 2, Per = 1 })
end

function ProgressionService.Start()
	call("PlayerStateService", "OnReady", onReady)
	call("OrderService", "OnTrade", onTrade)
	call("OrderService", "OnDayResult", onDayResult)
	call("OrderService", "OnBell", onBell)
	call("MarketService", "OnNews", onNews)
	call("TowerService", "OnFloorBuilt", onFloor)
	call("TowerService", "OnStageUp", onStage)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	Scheduler.Staggered("ProgressionPlayers", WEALTH_HZ, function()
		return Players:GetPlayers()
	end, function(p: Player)
		playerTick(p)
	end)
	Scheduler.Every("ProgressionCrash", CRASH_HZ, crashTick)
	if RunService:IsStudio() then
		local problems = PCFG.Validate and PCFG.Validate(Config) or {}
		for i = 1, math.min(#problems, 10) do
			warn("[ProgressionService] " .. tostring(problems[i]))
		end
	end
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Alle Remotes (Server/Services/Remotes)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C5.2 + §C8 (CC-Kopie 1:1, neue Felderliste).
--  Erstellt idempotent jedes Remote aus Net.RemoteList unter ReplicatedStorage.Remotes. Kein Service
--  (steht nicht in der Lader-Reihenfolge; Main.server lädt es ZUERST, Clients warten darauf):
--    local Remotes = require(script.Parent:WaitForChild("Remotes"))
--    Remotes.Market:FireAllClients(kind, data)     -- getypte Felder je Remote
--    Remotes[name]                                  -- dynamisch
--  "GrantCash" ist ein Honeypot: hier nur erzeugt, den Handler setzt WP11 (AntiCheatService). Unser Code feuert ihn NIE.
--  Falsche Klasse unter dem Namen -> warn + ersetzen; falsches Objekt "Remotes" -> in "Remotes_Alt" umbenennen.
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

export type Remotes = {
	Notify: RemoteEvent,
	State: RemoteEvent,
	Effect: RemoteEvent,
	Request: RemoteFunction,
	Admin: RemoteFunction,
	MarketFrame: RemoteEvent,
	Market: RemoteEvent,
	World: RemoteEvent,
	Replay: RemoteEvent,
	GrantCash: RemoteEvent,
	[string]: any,
}

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if folder and not folder:IsA("Folder") then
	-- falsches Objekt mit dem Namen (z. B. von Hand angelegt) -> umbenennen statt Fehler
	folder.Name = "Remotes_Alt"
	folder = nil
end
if not folder then
	local created = Instance.new("Folder")
	created.Name = "Remotes"
	created.Parent = ReplicatedStorage
	folder = created
end

local function make(className: string, name: string): Instance
	local existing = (folder :: Instance):FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	elseif existing then
		warn(
			("[Remotes] %s hat die falsche Klasse (%s statt %s) – wird ersetzt"):format(
				name,
				existing.ClassName,
				className
			)
		)
		existing:Destroy()
	end
	local remote = Instance.new(className)
	remote.Name = name
	remote.Parent = folder
	return remote
end

local remotes: { [string]: any } = {}
for _, spec in ipairs(Net.RemoteList) do
	remotes[spec.Name] = make(spec.Class, spec.Name)
end

return (remotes :: any) :: Remotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Belohnungen: Quests (Tages/Wochen/Starter-Linie/Aufhol-Quest), Login-Kalender, Skyline-Pass,
--  Codes, Tutorial-Belohnungen, Rückkehr, Liga-Belohnung der Vorwoche (Server/Services/RewardService)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §C5.8, §C9 (Reward*), §C10 (State
--  "Quests", "Login", "Season"), §B9.7, §B9.9, §B11.1 (Liga-Belohnung beim ersten Join der Woche), §B2 (Funnel 17/18).
--  Muster: CC-RewardService (REUSE §1.3 PATTERN) – OHNE Glücksrad. Freie Zufälle (Quest-Auswahl) sind deterministisch
--  je Spieler/Tag und nie mit Robux/CR verknüpft. Kein bezahlter Serien-Retter.
--
--  Öffentliche API (§C5.8):
--    RewardService.Track(p, kind, amount, ctx?)          Quest-Fortschritt (nur Server, andere WPs per pcall)
--    RewardService.GrantSeasonXp(p, amount, reason)      Saison-XP (Deckel je Grund laut Config.Season)
--    RewardService.SeasonPremium(p): boolean             RewardService.GrantSeasonPremium(p): boolean
--    RewardService.AddSeasonTiers(p, n): number          gekaufte Stufen (zahlen nur Kosmetik, REUSE §7 #8)
--  Ergänzungen: RewardService.CurrentSeason(): { Id, Key, StartsAt, EndsAt, Tiers, TierXp, Rolling } ·
--    RewardService._Test = { Core, Forward, InternalKinds }
--  Track-Arten (Config.Progression.QuestKinds) und ihre Aufrufer: Collect/BuildFloor/RoomLevel/Hire/Efficiency/
--    Transfer/HelpBuild (TowerService) · Drive (VehicleService) · VisitTower (PlotService) · Pickup/BearOrbs
--    (EventService) · GiveRespekt (CommunityService) · TradeProtected/TradeProfit/PositiveDay/ReadNews/NewSector/
--    HoldThroughBell/EarningsTrade/Lesson/Bell (ProgressionService).
--  Request-Handler: RewardLogin, RewardQuest, RewardReroll, RewardSeason, RewardCode, RewardTutorial.
--  Effekt: QuestDone. Alle CR-Belohnungen über ShopService (Credit/Grant), alles oder nichts.
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Types = require(Shared:WaitForChild("Types"))
local Lang = require(Shared:WaitForChild("Lang"))
local Format = require(Shared:WaitForChild("Format"))
local ProgressMath = require(Shared:WaitForChild("ProgressMath"))
local Scheduler = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Scheduler"))

local RewardService = {}
local Services: any = nil

type Reply = Types.Reply
type Data = { [string]: any }

local PCFG: any = Config.Progression
local SCFG: any = Config.Season
local RCFG: any = Config.Rewards
local QCFG: any = PCFG.Quests

local LOG_GAP = 10
local MAX_TRACK = 1000000
local MAX_SEEN = 32
local DAY_SECONDS = 86400
local LEAGUE_CHECK_EVERY = 60
local PLAY_TICK = math.max(10, math.floor(tonumber(RCFG.PlaytimeTick) or 60))

-- Arten, deren Erfolgs-Zähler ProgressionService.NoteStat führt (weitergereicht aus Track)
local FORWARD: { [string]: boolean } = {
	Collect = true,
	RoomLevel = true,
	Hire = true,
	Transfer = true,
	Drive = true,
	VisitTower = true,
	GiveRespekt = true,
	HelpBuild = true,
	Pickup = true,
	BearOrbs = true,
	Bell = true,
}
-- Arten, die WP9 selbst meldet (SelfTest "jede Quest-Art hat einen Tracker")
local INTERNAL_KINDS: { [string]: string } = {
	TradeProtected = "ProgressionService",
	TradeProfit = "ProgressionService",
	PositiveDay = "ProgressionService",
	ReadNews = "ProgressionService",
	NewSector = "ProgressionService",
	HoldThroughBell = "ProgressionService",
	EarningsTrade = "ProgressionService",
	Lesson = "ProgressionService",
	Bell = "ProgressionService",
	GiveRespekt = "CommunityService",
}

-- Pro-Spieler-Tabellen (alle bei PlayerRemoving geleert)
local readyClock: { [Player]: number } = {}
local playAcc: { [Player]: number } = {}
local leagueCheckedAt: { [Player]: number } = {}
local lastLogAt: { [string]: number } = {}

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function logError(where: string, err: any)
	local now = os.clock()
	if (lastLogAt[where] or -math.huge) + LOG_GAP <= now then
		lastLogAt[where] = now
		warn("[RewardService] " .. where .. ": " .. tostring(err))
	end
end

local function finite(n: any): boolean
	return Util.IsFinite(n)
end

local function num(v: any, default: number): number
	return if Util.IsFinite(v) then v else default
end

local function isInt(v: any): boolean
	return Util.IsFinite(v) and v % 1 == 0
end

local function call(name: string, fnName: string, ...: any): (boolean, ...any)
	local svc = Services and Services[name]
	local fn = svc and svc[fnName]
	if type(fn) ~= "function" then
		return false
	end
	local results = table.pack(pcall(fn, ...))
	if not results[1] then
		logError(name .. "." .. fnName, results[2])
		return false
	end
	return true, table.unpack(results, 2, results.n)
end

local function isPlayer(p: any): boolean
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent == Players
end

local function dataOf(p: Player): Data?
	local ok, data = call("DataService", "Get", p)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

local function langOf(p: Player): Types.Lang
	local ok, lang = call("PlayerStateService", "LangOf", p)
	if ok and (lang == "de" or lang == "en") then
		return lang
	end
	return "en"
end

local function T(p: Player, key: string, ...: any): string
	return Lang.T(langOf(p), key, ...)
end

local function fail(p: Player, key: string, ...: any): Reply
	return { Ok = false, Message = T(p, key, ...) }
end

local function notify(p: Player, key: string, args: { any }?, kind: Types.NotifyKind?)
	call("PlayerStateService", "Notify", p, key, args, kind)
end

local function markDirty(p: Player, ...: string)
	call("PlayerStateService", "MarkDirty", p, ...)
end

local function funnel(p: Player, step: number)
	call("MetricsService", "Funnel", p, step, PCFG.Tutorial.FunnelNames[step] or ("Step" .. step))
end

local function credits(n: number, lang: Types.Lang): string
	local ok, text = pcall(Format.Credits, n, lang)
	return if ok then text else tostring(math.floor(n))
end

local function emptyArg(arg: any): boolean
	return arg == nil or (type(arg) == "table" and next(arg) == nil)
end

local function exactKeys(arg: any, keys: { string }): boolean
	if type(arg) ~= "table" then
		return false
	end
	local allowed: { [string]: boolean } = {}
	for _, key in ipairs(keys) do
		allowed[key] = true
		if arg[key] == nil then
			return false
		end
	end
	for key in pairs(arg) do
		if type(key) ~= "string" or not allowed[key] then
			return false
		end
	end
	return true
end

local function today(): number
	return Util.UtcDay()
end

local function tableField(parent: Data, key: string): Data
	local t = parent[key]
	if type(t) ~= "table" then
		t = {}
		parent[key] = t
	end
	return t
end

-- ISO-UTC -> Unix-Sekunden (nil bei Fehler)
local isoCache: { [string]: number } = {}
local function isoToUnix(iso: any): number?
	if type(iso) ~= "string" then
		return nil
	end
	local cached = isoCache[iso]
	if cached then
		return cached
	end
	local ok, value = pcall(function()
		return DateTime.fromIsoDate(iso).UnixTimestamp
	end)
	if ok and finite(value) then
		isoCache[iso] = value
		return value
	end
	return nil
end

local function steadyIncome(p: Player): number
	local ok, info = call("TowerService", "Income", p)
	if ok and type(info) == "table" and finite(info.Steady) then
		return math.max(0, info.Steady)
	end
	return 0
end

-- einkommens-skalierte CR (Minuten Dauer-Einkommen ohne Zeitlich, mindestens min)
local function incomeCredits(p: Player, minutes: number, min: number): number
	return ProgressMath.Clamp(math.max(num(min, 0), steadyIncome(p) * num(minutes, 0) * 60))
end

-- Anzeigename eines Belohnungs-Teils aus den Config-Tabellen der Besitzer-WPs
local function itemName(kind: string, key: string, lang: Types.Lang): string
	local function pick(entry: any): string?
		if type(entry) == "table" and type(entry.Name) == "table" then
			return Lang.Pick(lang, entry.Name)
		end
		return nil
	end
	local function find(list: any): any
		if type(list) == "table" then
			for _, entry in ipairs(list) do
				if type(entry) == "table" and entry.Key == key then
					return entry
				end
			end
		end
		return nil
	end
	if kind == "Decor" then
		local decor = Config.Decor
		return pick(decor and decor.ByKey and decor.ByKey[key]) or key
	elseif kind == "Car" then
		return pick(find(Config.Vehicles and Config.Vehicles.Cars)) or key
	elseif kind == "Watch" then
		local life = Config.Lifestyle
		return pick(find(life and life.Watches)) or key
	elseif kind == "Accessory" then
		local life = Config.Lifestyle
		return pick(find(life and life.Accessories)) or key
	elseif kind == "Title" then
		return pick(PCFG.TitleByKey[key]) or key
	end
	-- Kosmetik: Fassaden, Neon, Lacke
	local tower = Config.Tower
	return pick(find(tower and tower.Skins))
		or pick(find(tower and tower.Neon))
		or pick(find(Config.Vehicles and Config.Vehicles.Paints))
		or key
end

-- Belohnung -> Grant (Turm-Seite), Saison-XP, Titel, Text
local function buildReward(p: Player, reward: any, earnedOnly: boolean?): (Types.Grant, number, string?, { string })
	local grant: Types.Grant = {}
	local parts: { string } = {}
	local lang = langOf(p)
	local seasonXp = 0
	local title: string? = nil
	if type(reward) ~= "table" then
		return grant, 0, nil, parts
	end
	local allowIncome = earnedOnly ~= false
	if allowIncome and type(reward.Credits) == "table" then
		local amount = incomeCredits(p, reward.Credits.Minutes, reward.Credits.Min)
		if amount > 0 then
			grant.Credits = amount
			table.insert(parts, Lang.T(lang, "prog.rw.credits", credits(amount, lang)))
		end
	end
	if type(reward.Decor) == "table" then
		local decor: { [string]: number } = {}
		for key, n in pairs(reward.Decor) do
			if type(key) == "string" and isInt(n) and n > 0 then
				decor[key] = n
				table.insert(parts, Lang.T(lang, "prog.rw.decor", itemName("Decor", key, lang)))
			end
		end
		if next(decor) then
			grant.Decor = decor
		end
	end
	for field, kind in pairs({ Cosmetics = "Cosmetic", Watches = "Watch", Cars = "Car", Accessories = "Accessory" }) do
		local list = reward[field]
		if type(list) == "table" and #list > 0 then
			local copy: { string } = {}
			for _, key in ipairs(list) do
				if type(key) == "string" then
					table.insert(copy, key)
					table.insert(parts, Lang.T(lang, "prog.rw." .. string.lower(kind), itemName(kind, key, lang)))
				end
			end
			(grant :: any)[field] = copy
		end
	end
	if allowIncome and isInt(reward.BoostX2) and reward.BoostX2 > 0 then
		grant.BoostX2 = reward.BoostX2
		local ok, text = pcall(Format.Duration, reward.BoostX2, lang)
		table.insert(parts, Lang.T(lang, "prog.rw.boost", if ok then text else tostring(reward.BoostX2)))
	end
	if allowIncome and isInt(reward.InstantTokens) and reward.InstantTokens > 0 then
		grant.InstantTokens = reward.InstantTokens
		table.insert(parts, Lang.T(lang, "prog.rw.instant", reward.InstantTokens))
	end
	if isInt(reward.SeasonXp) and reward.SeasonXp > 0 then
		seasonXp = reward.SeasonXp
		table.insert(parts, Lang.T(lang, "prog.rw.seasonXp", seasonXp))
	end
	if type(reward.Title) == "string" and reward.Title ~= "" then
		title = reward.Title
		table.insert(parts, Lang.T(lang, "prog.rw.title", itemName("Title", reward.Title, lang)))
	end
	return grant, seasonXp, title, parts
end

local function grantEmpty(grant: Types.Grant): boolean
	return next(grant :: any) == nil
end

-- alles oder nichts über ShopService.Grant (nur Turm-Seite)
local function applyGrant(p: Player, grant: Types.Grant, reason: string): boolean
	if grantEmpty(grant) then
		return true
	end
	local ok, granted = call("ShopService", "Grant", p, grant, reason)
	return ok and granted == true
end

-- ---------------------------------------------------------------------
-- 2) KERN (rein; SelfTests nutzen dieselben Funktionen)
-- ---------------------------------------------------------------------
local Core = {}

local function isTradeKind(kind: string?): boolean
	local def = kind and PCFG.QuestKindByKey[kind]
	return def ~= nil and (def.Cat == "Trade" or def.Cat == "Academy")
end
Core.IsTradeKind = isTradeKind

local function newQuest(def: any): Data
	return { Id = def.Id, P = 0, Done = false, Claimed = false, Seen = {} }
end

-- 3 Tagesquests deterministisch je Spieler/Tag (mindestens MinTradeDaily Handels-/Akademie-Quests)
function Core.PickDaily(userId: number, day: number): { string }
	local seed = Util.Hash(tostring(userId) .. ":" .. tostring(day))
	local picks = ProgressMath.QuestPick(seed, QCFG.Daily, QCFG.DailyCount)
	local trade = 0
	for _, def in ipairs(picks) do
		if isTradeKind(def.Kind) then
			trade += 1
		end
	end
	if trade < QCFG.MinTradeDaily and #picks > 0 then
		local pool = {}
		for _, def in ipairs(QCFG.Daily) do
			if isTradeKind(def.Kind) and not table.find(picks, def) then
				table.insert(pool, def)
			end
		end
		-- die letzte Nicht-Handels-Quest ersetzen
		for index = #picks, 1, -1 do
			if not isTradeKind(picks[index].Kind) then
				local extra = ProgressMath.QuestPick(seed + 7, pool, 1)[1]
				if extra then
					picks[index] = extra
				end
				break
			end
		end
	end
	local ids = {}
	for _, def in ipairs(picks) do
		table.insert(ids, def.Id)
	end
	return ids
end

function Core.PickWeekly(userId: number, week: number): { string }
	local seed = Util.Hash(tostring(userId) .. ":w" .. tostring(week))
	local ids = {}
	for _, def in ipairs(ProgressMath.QuestPick(seed, QCFG.Weekly, QCFG.WeeklyCount)) do
		table.insert(ids, def.Id)
	end
	return ids
end

-- Ersatz beim Neuwählen (deterministisch, nicht schon in der Liste, Handels-Garantie bleibt)
function Core.RerollPick(userId: number, day: number, list: { Data }, replaceId: string): string?
	local current: { [string]: boolean } = {}
	local tradeOthers = 0
	for _, q in ipairs(list) do
		current[q.Id] = true
		if q.Id ~= replaceId then
			local def = PCFG.QuestById[q.Id]
			if def and isTradeKind(def.Kind) then
				tradeOthers += 1
			end
		end
	end
	local needTrade = tradeOthers < QCFG.MinTradeDaily
	local pool = {}
	for _, def in ipairs(QCFG.Daily) do
		if not current[def.Id] and (not needTrade or isTradeKind(def.Kind)) then
			table.insert(pool, def)
		end
	end
	local seed = Util.Hash(tostring(userId) .. ":" .. tostring(day) .. ":r")
	local pick = ProgressMath.QuestPick(seed, pool, 1)[1]
	return if pick then pick.Id else nil
end

-- Track-Kontext gegen die Vorlage prüfen (Min-Werte)
function Core.FilterOk(def: any, ctx: { [string]: any }?): boolean
	if type(def.Min) == "table" then
		if type(ctx) ~= "table" then
			return false
		end
		for field, min in pairs(def.Min) do
			if not finite(ctx[field]) or ctx[field] < min then
				return false
			end
		end
	end
	return true
end

-- Fortschritt; Rückgabe: (geändert, gerade fertig)
function Core.Advance(q: Data, def: any, amount: number, ctx: { [string]: any }?): (boolean, boolean)
	if q.Done or q.Claimed then
		return false, false
	end
	if not Core.FilterOk(def, ctx) then
		return false, false
	end
	if def.Distinct then
		local value = if type(ctx) == "table" then ctx[def.Distinct] else nil
		if value == nil then
			return false, false
		end
		local key = tostring(value)
		if type(q.Seen) ~= "table" then
			q.Seen = {}
		end
		if q.Seen[key] then
			return false, false
		end
		local count = 0
		for _ in pairs(q.Seen) do
			count += 1
		end
		if count < MAX_SEEN then
			q.Seen[key] = true
		end
		q.P = num(q.P, 0) + 1
	else
		q.P = math.min(num(q.P, 0) + amount, MAX_TRACK)
	end
	if q.P >= def.Goal then
		q.P = def.Goal
		q.Done = true
		return true, true
	end
	return true, false
end

-- Login-Serie für heute berechnen (ohne zu buchen): neue Felder oder nil, wenn heute schon abgeholt
function Core.LoginStep(login: Data, day: number, week: number, club: boolean): Data?
	if login.LastDay == day then
		return nil
	end
	local cfg = RCFG.Login
	local nextState = table.clone(login)
	-- Wochen-Schutz auffüllen (1 je ISO-Woche, Club +1, höchstens FreezeMax gespeichert)
	if nextState.FreezeWeek ~= week then
		local add = cfg.FreezePerWeek + (if club then cfg.FreezeClubBonus else 0)
		nextState.Freeze = math.min(cfg.FreezeMax, num(nextState.Freeze, 0) + add)
		nextState.FreezeWeek = week
	end
	local last = num(nextState.LastDay, 0)
	local gap = day - last
	nextState.UsedFreeze = 0
	-- Serie geht weiter: gestern abgeholt oder die Lücke mit Serien-Schutz überbrückt (sonst neue Serie)
	local continues = last > 0 and gap == 1
	if last > 0 and gap > 1 and gap - 1 <= num(nextState.Freeze, 0) then
		nextState.Freeze -= gap - 1
		nextState.UsedFreeze = gap - 1
		continues = true
	end
	nextState.Streak = if continues then num(nextState.Streak, 0) + 1 else 1
	nextState.Best = math.max(num(nextState.Best, 0), nextState.Streak)
	nextState.Track = math.min(cfg.TrackMax, num(nextState.Track, 0) + 1)
	nextState.LastDay = day
	local dayIdx, cycle = ProgressMath.LoginDay(nextState.Streak)
	nextState.Cycle = cycle
	nextState.DayIdx = dayIdx
	return nextState
end

-- aktive Saison (inkl. Rolling-Folgesaisons)
function Core.SeasonAt(now: number): Data?
	local list = SCFG.Seasons
	if type(list) ~= "table" or #list == 0 then
		return nil
	end
	local first = list[1]
	local firstStart = isoToUnix(first.StartUtc)
	if firstStart and now < firstStart then
		return {
			Id = first.Id,
			Key = first.Key,
			Name = first.Name,
			StartsAt = firstStart,
			EndsAt = isoToUnix(first.EndUtc) or firstStart,
			Def = first,
			Rolling = false,
		}
	end
	-- dieselbe Regel wie Config.Shop.SeasonIdAt (WP10): laufende Saison, sonst die zuletzt begonnene
	local lastIndex = 1
	for i, s in ipairs(list) do
		local start, stop = isoToUnix(s.StartUtc), isoToUnix(s.EndUtc)
		if start and stop and now >= start and now < stop then
			return { Id = s.Id, Key = s.Key, Name = s.Name, StartsAt = start, EndsAt = stop, Def = s, Rolling = false }
		end
		if start and now >= start then
			lastIndex = i
		end
	end
	local last = list[lastIndex]
	local lastEnd = isoToUnix(last.EndUtc)
	if lastIndex < #list then
		-- Lücke bis zur nächsten festen Saison: die vorige gilt weiter, ehrliches Ende = Start der nächsten
		local nextStart = isoToUnix(list[lastIndex + 1].StartUtc)
		return {
			Id = last.Id,
			Key = last.Key,
			Name = last.Name,
			StartsAt = isoToUnix(last.StartUtc) or now,
			EndsAt = nextStart or lastEnd or now,
			Def = last,
			Rolling = false,
		}
	end
	local rolling = SCFG.Rolling
	if not lastEnd or type(rolling) ~= "table" or rolling.Enabled ~= true then
		return nil
	end
	local length = math.max(1, num(rolling.LengthDays, 28)) * DAY_SECONDS
	local k = math.clamp(math.floor((now - lastEnd) / length), 0, SCFG.MaxSeasons)
	local start = lastEnd + k * length
	local id = math.min(last.Id + 1 + k, math.max(last.Id, num(SCFG.MaxSeasons, 999)))
	return {
		Id = id,
		Key = "S" .. tostring(id),
		Name = nil,
		StartsAt = start,
		EndsAt = start + length,
		Def = last,
		Rolling = true,
	}
end

RewardService._Test = { Core = Core, Forward = FORWARD, InternalKinds = INTERNAL_KINDS }

-- ---------------------------------------------------------------------
-- 3) QUEST-ZUSTAND
-- ---------------------------------------------------------------------
local function questsOf(data: Data): Data
	return tableField(data, "Quests")
end

local function sanitizeList(list: any, valid: (string) -> boolean): { Data }
	local out = {}
	if type(list) ~= "table" then
		return out
	end
	for _, q in ipairs(list) do
		if type(q) == "table" and type(q.Id) == "string" and valid(q.Id) then
			q.P = math.max(0, num(q.P, 0))
			q.Done = q.Done == true
			q.Claimed = q.Claimed == true
			if type(q.Seen) ~= "table" then
				q.Seen = {}
			end
			table.insert(out, q)
		end
	end
	return out
end

local dailyIds: { [string]: boolean } = {}
for _, def in ipairs(QCFG.Daily) do
	dailyIds[def.Id] = true
end
local weeklyIds: { [string]: boolean } = {}
for _, def in ipairs(QCFG.Weekly) do
	weeklyIds[def.Id] = true
end

-- Tages-/Wochenwechsel (true = geändert)
local function ensureQuests(p: Player, data: Data): boolean
	local quests = questsOf(data)
	local changed = false
	local day = today()
	if quests.Day ~= day then
		quests.Day = day
		quests.Daily = {}
		for _, id in ipairs(Core.PickDaily(p.UserId, day)) do
			table.insert(quests.Daily, newQuest(PCFG.QuestById[id]))
		end
		quests.Rerolled = false
		changed = true
	else
		quests.Daily = sanitizeList(quests.Daily, function(id)
			return dailyIds[id] == true
		end)
	end
	local week = Util.IsoWeek()
	if quests.Week ~= week then
		quests.Week = week
		quests.Weekly = {}
		for _, id in ipairs(Core.PickWeekly(p.UserId, week)) do
			table.insert(quests.Weekly, newQuest(PCFG.QuestById[id]))
		end
		changed = true
	else
		quests.Weekly = sanitizeList(quests.Weekly, function(id)
			return weeklyIds[id] == true
		end)
	end
	if not isInt(quests.Starter) or quests.Starter < 1 then
		quests.Starter = 1
	end
	quests.Starter = math.min(quests.Starter, #QCFG.StarterLine + 1)
	if type(quests.StarterDone) ~= "table" then
		quests.StarterDone = {}
	end
	quests.StarterP = math.max(0, num(quests.StarterP, 0))
	if type(quests.StarterSeen) ~= "table" then
		quests.StarterSeen = {}
	end
	if quests.Comeback ~= nil and (type(quests.Comeback) ~= "table" or quests.Comeback.Claimed == true) then
		quests.Comeback = nil
	end
	return changed
end

local function questText(p: Player, def: any): string
	local lang = langOf(p)
	local goal = def.Goal
	local goalText = if def.Kind == "Drive"
		then Format.Int(math.floor(goal / 1000 + 0.5), lang)
		else Format.Int(goal, lang)
	if type(def.Text) == "string" then
		return Lang.T(lang, def.Text, goalText)
	end
	return Lang.T(lang, "prog.qk." .. tostring(def.Kind), goalText)
end

local function questDone(p: Player, def: any)
	call("PlayerStateService", "Effect", p, "QuestDone", 1, { Id = def.Id })
	notify(p, "prog.questDone", { questText(p, def) }, "Success")
end

local function starterDef(quests: Data): any
	return QCFG.StarterLine[quests.Starter]
end

-- ---------------------------------------------------------------------
-- 4) ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function RewardService.Track(p: Player, kind: string, amount: number, ctx: { [string]: any }?)
	if not isPlayer(p) or type(kind) ~= "string" or #kind > 40 then
		return
	end
	local value = if finite(amount) then math.clamp(amount, 0, MAX_TRACK) else 1
	if value <= 0 then
		return
	end
	if FORWARD[kind] then
		call("ProgressionService", "NoteStat", p, kind, value, nil)
	end
	if not PCFG.QuestKindByKey[kind] then
		return -- nur Erfolgs-/Protokoll-Art (z. B. CarBuy)
	end
	local data = dataOf(p)
	if not data then
		return
	end
	local changed = ensureQuests(p, data)
	local quests = questsOf(data)
	for _, list in ipairs({ quests.Daily, quests.Weekly }) do
		for _, q in ipairs(list) do
			local def = PCFG.QuestById[q.Id]
			if def and def.Kind == kind then
				local moved, finished = Core.Advance(q, def, value, ctx)
				changed = changed or moved
				if finished then
					questDone(p, def)
				end
			end
		end
	end
	local comeback = quests.Comeback
	if type(comeback) == "table" then
		local def = QCFG.Comeback
		if def.Kind == kind then
			local moved, finished = Core.Advance(comeback, def, value, ctx)
			changed = changed or moved
			if finished then
				questDone(p, def)
			end
		end
	end
	local sdef = starterDef(quests)
	if sdef and sdef.Kind == kind and sdef.Check == nil then
		local state =
			{ P = quests.StarterP, Done = quests.StarterP >= sdef.Goal, Claimed = false, Seen = quests.StarterSeen }
		local moved, finished = Core.Advance(state, sdef, value, ctx)
		if moved then
			quests.StarterP = state.P
			quests.StarterSeen = state.Seen
			changed = true
		end
		if finished then
			questDone(p, sdef)
		end
	end
	if changed then
		markDirty(p, "Quests")
	end
end

function RewardService.CurrentSeason(): { [string]: any }?
	local s = Core.SeasonAt(os.time())
	if not s then
		return nil
	end
	return {
		Id = s.Id,
		Key = s.Key,
		StartsAt = s.StartsAt,
		EndsAt = s.EndsAt,
		Tiers = s.Def.Tiers,
		TierXp = s.Def.TierXp,
		Rolling = s.Rolling,
	}
end

-- Saison-Daten auf die aktive Saison bringen (Wechsel = neuer Pass)
local function seasonOf(data: Data): (Data, Data?)
	local season = tableField(data, "Season")
	local current = Core.SeasonAt(os.time())
	if not current then
		return season, nil
	end
	if season.Id ~= current.Id then
		season.Id = current.Id
		season.Xp = 0
		season.BoughtXp = 0
		season.ClaimedFree = {}
		season.ClaimedPremium = {}
		season.Counts = {}
		local passSeasons = type(data.Purchases) == "table" and data.Purchases.PassSeasons or nil
		season.Premium = type(passSeasons) == "table"
			and (passSeasons[tostring(current.Id)] == true or passSeasons[current.Id] == true)
	end
	season.Xp = math.max(0, num(season.Xp, 0))
	season.BoughtXp = math.clamp(num(season.BoughtXp, 0), 0, season.Xp)
	season.Premium = season.Premium == true
	if type(season.ClaimedFree) ~= "table" then
		season.ClaimedFree = {}
	end
	if type(season.ClaimedPremium) ~= "table" then
		season.ClaimedPremium = {}
	end
	if type(season.Counts) ~= "table" then
		season.Counts = {}
	end
	return season, current
end

local CAPS: { [string]: number } = {
	CountingDay = (SCFG.XpSources.CountingDay or {}).Cap or 12,
	Respekt = (SCFG.XpSources.Respekt or {}).Cap or 5,
}

function RewardService.GrantSeasonXp(p: Player, amount: number, reason: string)
	if not isPlayer(p) or not finite(amount) or amount <= 0 or type(reason) ~= "string" then
		return
	end
	local data = dataOf(p)
	if not data then
		return
	end
	local season, current = seasonOf(data)
	if not current then
		return
	end
	local counts = season.Counts
	local day = today()
	if counts.Day ~= day then
		table.clear(counts)
		counts.Day = day
	end
	local cap = CAPS[reason]
	if cap then
		if num(counts[reason], 0) >= cap then
			return
		end
		counts[reason] = num(counts[reason], 0) + 1
	end
	local maxXp = current.Def.Tiers * current.Def.TierXp
	local before = season.Xp
	local add = math.floor(math.min(amount, SCFG.MaxGrant))
	season.Xp = math.min(maxXp, season.Xp + add)
	-- Saison-XP aus einem Robux-Kauf (ShopService-Grund "Robux…") zählt wie gekaufte Stufen: nur Kosmetik (REUSE §7 #8)
	if string.sub(reason, 1, 5) == "Robux" then
		season.BoughtXp = math.min(season.Xp, num(season.BoughtXp, 0) + (season.Xp - before))
	elseif before + add > maxXp and num(season.BoughtXp, 0) > 0 then
		-- Pass voll, aber weiter verdient: verdiente XP ersetzt gekaufte (sonst blieben Stufen 41–50 nach +10 gekauften
		-- Stufen für immer „nur gekauft“ und zahlten nie CR/Boost/Token – Käufer dürfen nicht schlechter stehen)
		season.BoughtXp = math.max(0, num(season.BoughtXp, 0) - (before + add - maxXp))
	end
	markDirty(p, "Season")
end

function RewardService.SeasonPremium(p: Player): boolean
	local data = isPlayer(p) and dataOf(p) or nil
	if not data then
		return false
	end
	local season = seasonOf(data)
	return season.Premium == true
end

function RewardService.GrantSeasonPremium(p: Player): boolean
	if not isPlayer(p) then
		return false
	end
	local data = dataOf(p)
	if not data then
		return false
	end
	local season, current = seasonOf(data)
	if not current then
		return false
	end
	season.Premium = true
	notify(p, "prog.season.premiumOn", nil, "Success")
	markDirty(p, "Season")
	return true
end

-- gekaufte Stufen: Saison-XP + Merker (zahlen nur Kosmetik, bis die Stufe mit verdienter XP erreicht ist)
function RewardService.AddSeasonTiers(p: Player, n: number): number
	if not isPlayer(p) or not isInt(n) or n < 1 or n > 50 then
		return 0
	end
	local data = dataOf(p)
	if not data then
		return 0
	end
	local season, current = seasonOf(data)
	if not current then
		return 0
	end
	local def = current.Def
	local maxXp = def.Tiers * def.TierXp
	local before = season.Xp
	season.Xp = math.min(maxXp, season.Xp + n * def.TierXp)
	season.BoughtXp = math.min(season.Xp, num(season.BoughtXp, 0) + (season.Xp - before))
	markDirty(p, "Season")
	return ProgressMath.SeasonTier(season.Xp, def.TierXp, def.Tiers)
end

-- ---------------------------------------------------------------------
-- 5) ANFRAGEN
-- ---------------------------------------------------------------------
local function findQuest(list: { Data }, id: string): Data?
	for _, q in ipairs(list) do
		if q.Id == id then
			return q
		end
	end
	return nil
end

local function dailyCredits(p: Player, def: any): number
	local minutes = QCFG.TierMinutes[def.Tier] or QCFG.TierMinutes[1]
	return incomeCredits(p, minutes, QCFG.DailyMinCredits)
end

local function weeklyCredits(p: Player): number
	return incomeCredits(p, QCFG.WeeklyHours * 60, QCFG.WeeklyMinCredits)
end

local function handleQuest(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Id" }) or type(arg.Id) ~= "string" or #arg.Id > 8 then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	ensureQuests(p, data)
	local quests = questsOf(data)
	local lang = langOf(p)
	-- Starter-Linie
	local sdef = starterDef(quests)
	if sdef and sdef.Id == arg.Id then
		if quests.StarterP < sdef.Goal then
			return fail(p, "prog.questNotDone")
		end
		local ok, credited = call("ShopService", "Credit", p, sdef.Credits, "Quest")
		if not ok or credited ~= true then
			return fail(p, "prog.grantFailed")
		end
		if sdef.Title then
			call("ProgressionService", "GrantTitle", p, sdef.Title)
		end
		quests.StarterDone[sdef.Id] = true
		quests.Starter += 1
		quests.StarterP = 0
		quests.StarterSeen = {}
		markDirty(p, "Quests")
		local message = T(p, "prog.starterDone", quests.Starter - 1, credits(sdef.Credits, lang))
		if quests.Starter > #QCFG.StarterLine then
			message ..= " " .. T(p, "prog.starterAll")
		end
		return { Ok = true, Message = message }
	end
	-- Aufhol-Quest
	local comeback = quests.Comeback
	if type(comeback) == "table" and comeback.Id == arg.Id then
		if not comeback.Done then
			return fail(p, "prog.questNotDone")
		end
		local def = QCFG.Comeback
		local amount = incomeCredits(p, def.Minutes, def.MinCredits)
		local ok, credited = call("ShopService", "Credit", p, amount, "Quest")
		if not ok or credited ~= true then
			return fail(p, "prog.grantFailed")
		end
		comeback.Claimed = true
		quests.Comeback = nil
		markDirty(p, "Quests")
		return { Ok = true, Message = T(p, "prog.questClaimed", credits(amount, lang), 0) }
	end
	-- Tages-/Wochenquests
	local weekly = false
	local q = findQuest(quests.Daily, arg.Id)
	if not q then
		q = findQuest(quests.Weekly, arg.Id)
		weekly = q ~= nil
	end
	if not q then
		return fail(p, "prog.questUnknown")
	end
	if q.Claimed then
		return fail(p, "prog.questClaimedAlready")
	end
	if not q.Done then
		return fail(p, "prog.questNotDone")
	end
	local def = PCFG.QuestById[q.Id]
	local amount = if weekly then weeklyCredits(p) else dailyCredits(p, def)
	local ok, credited = call("ShopService", "Credit", p, amount, "Quest")
	if not ok or credited ~= true then
		return fail(p, "prog.grantFailed")
	end
	q.Claimed = true
	local seasonXp = if weekly then QCFG.WeeklySeasonXp else QCFG.DailySeasonXp
	RewardService.GrantSeasonXp(p, seasonXp, if weekly then "WeeklyQuest" else "DailyQuest")
	local kind = PCFG.QuestKindByKey[def.Kind]
	if weekly then
		if kind and kind.Cat == "Trade" then
			call("ProgressionService", "AddXp", p, PCFG.XpSources.WeeklyQuest.Xp, "WeeklyQuest", nil)
		end
	elseif isTradeKind(def.Kind) then
		call("ProgressionService", "AddXp", p, PCFG.XpSources.DailyQuest.Xp, "DailyQuest", nil)
	end
	markDirty(p, "Quests")
	return { Ok = true, Message = T(p, "prog.questClaimed", credits(amount, lang), seasonXp) }
end

local function handleReroll(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Id" }) or type(arg.Id) ~= "string" or #arg.Id > 8 then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	ensureQuests(p, data)
	local quests = questsOf(data)
	if quests.Rerolled == true then
		return fail(p, "prog.rerollUsed")
	end
	local q = findQuest(quests.Daily, arg.Id)
	if not q then
		return fail(p, "prog.questUnknown")
	end
	if q.Done or q.Claimed then
		return fail(p, "prog.rerollClaimed")
	end
	local newId = Core.RerollPick(p.UserId, quests.Day, quests.Daily, q.Id)
	if not newId then
		return fail(p, "prog.rerollNone")
	end
	local def = PCFG.QuestById[newId]
	for index, entry in ipairs(quests.Daily) do
		if entry == q then
			quests.Daily[index] = newQuest(def)
		end
	end
	quests.Rerolled = true
	markDirty(p, "Quests")
	return { Ok = true, Message = T(p, "prog.rerollDone", questText(p, def)), Id = newId }
end

local function handleLogin(p: Player, arg: any): Reply
	if not emptyArg(arg) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local login = tableField(data, "Login")
	local day = today()
	local okClub, club = call("MonetizationService", "IsClub", p)
	local nextState = Core.LoginStep(login, day, Util.IsoWeek(), okClub and club == true)
	if not nextState then
		return fail(p, "prog.loginAlready")
	end
	local cfg = RCFG.Login
	local reward = cfg.Cycle[nextState.DayIdx]
	if nextState.DayIdx == #cfg.Cycle and nextState.Cycle >= 2 and reward.Repeat then
		reward = reward.Repeat
	end
	local grant, seasonXp, _title, parts = buildReward(p, reward, true)
	-- 28er-Spur (einmalig je Meilenstein)
	local trackParts: { string } = {}
	local trackGrant: Types.Grant? = nil
	if nextState.Track ~= num(login.Track, 0) then
		for _, milestone in ipairs(cfg.Track) do
			if milestone.Day == nextState.Track then
				local g, _, _, tp = buildReward(p, milestone, true)
				trackGrant = g
				trackParts = tp
			end
		end
	end
	if not applyGrant(p, grant, "Login") then
		return fail(p, "prog.grantFailed")
	end
	if trackGrant and not applyGrant(p, trackGrant, "Login") then
		trackParts = {}
		nextState.Track = num(login.Track, 0) -- Meilenstein bleibt offen, Tag zählt erneut beim nächsten Login
	end
	-- buchen
	local usedFreeze = num(nextState.UsedFreeze, 0)
	nextState.UsedFreeze = nil
	nextState.DayIdx = nil
	for key, value in pairs(nextState) do
		login[key] = value
	end
	if seasonXp > 0 then
		RewardService.GrantSeasonXp(p, seasonXp, "Login")
	end
	call("ProgressionService", "NoteStat", p, "LoginStreak", login.Best, "max")
	markDirty(p, "Login")
	local dayIdx = ProgressMath.LoginDay(login.Streak)
	local lang = langOf(p)
	local message = T(p, "prog.loginClaimed", dayIdx, table.concat(parts, Lang.T(lang, "prog.rw.sep")))
	if usedFreeze > 0 then
		message ..= " " .. T(p, "prog.loginFreeze", login.Freeze)
	end
	if #trackParts > 0 then
		message ..= " " .. T(p, "prog.loginTrack", login.Track, table.concat(trackParts, Lang.T(lang, "prog.rw.sep")))
	end
	return { Ok = true, Message = message, Streak = login.Streak, Day = dayIdx }
end

local function rewardFor(def: any, track: string, tier: number): any
	local list = if track == "Premium" then def.Premium else def.Free
	if type(list) ~= "table" then
		return nil
	end
	for _, reward in ipairs(list) do
		if reward.Tier == tier then
			return reward
		end
	end
	return nil
end

local function handleSeason(p: Player, arg: any): Reply
	if
		not exactKeys(arg, { "Tier", "Track" })
		or not isInt(arg.Tier)
		or (arg.Track ~= "Free" and arg.Track ~= "Premium")
	then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local season, current = seasonOf(data)
	if not current then
		return fail(p, "prog.season.ended")
	end
	local def = current.Def
	local tier = arg.Tier
	if tier < 1 or tier > def.Tiers then
		return fail(p, "core.invalid")
	end
	local reward = rewardFor(def, arg.Track, tier)
	if not reward then
		return fail(p, "prog.season.none")
	end
	if ProgressMath.SeasonTier(season.Xp, def.TierXp, def.Tiers) < tier then
		return fail(p, "prog.season.locked")
	end
	if arg.Track == "Premium" and not season.Premium then
		return fail(p, "prog.season.premiumNeeded")
	end
	local claimed = if arg.Track == "Premium" then season.ClaimedPremium else season.ClaimedFree
	local key = tostring(tier)
	if claimed[key] then
		return fail(p, "prog.season.already")
	end
	-- Stufe nur gekauft (nicht mit verdienter XP erreicht): einkommenswirksame Teile zahlen erst später (REUSE §7 #8)
	local earnedTier = ProgressMath.SeasonTier(season.Xp - num(season.BoughtXp, 0), def.TierXp, def.Tiers)
	local earned = tier <= earnedTier
	if not earned then
		for field in pairs(SCFG.EarnedOnlyFields) do
			if reward[field] ~= nil then
				return fail(p, "prog.season.boughtOnly")
			end
		end
	end
	local grant, _seasonXp, title, parts = buildReward(p, reward, earned)
	if not applyGrant(p, grant, "Season") then
		return fail(p, "prog.grantFailed")
	end
	if title then
		call("ProgressionService", "GrantTitle", p, title)
	end
	claimed[key] = true
	markDirty(p, "Season")
	return {
		Ok = true,
		Message = T(p, "prog.season.claimed", tier, table.concat(parts, Lang.T(langOf(p), "prog.rw.sep"))),
	}
end

local function handleCode(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Code" }) or type(arg.Code) ~= "string" or #arg.Code > RCFG.CodeMaxLength * 3 then
		return fail(p, "core.invalid")
	end
	local raw = string.gsub(arg.Code, "%s+", "")
	if #raw < 1 or #raw > RCFG.CodeMaxLength then
		return fail(p, "prog.code.bad")
	end
	local code = string.upper(raw)
	if not string.match(code, "^[%w_]+$") then
		return fail(p, "prog.code.bad")
	end
	local entry = (RCFG.Codes or {})[code]
	if type(entry) ~= "table" or type(entry.Grant) ~= "table" then
		return fail(p, "prog.code.bad")
	end
	if entry.Expires ~= nil then
		local expires = isoToUnix(entry.Expires)
		if not expires or os.time() >= expires then
			return fail(p, "prog.code.expired")
		end
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local login = tableField(data, "Login")
	local used = tableField(login, "Codes")
	if used[code] then
		return fail(p, "prog.code.used")
	end
	-- Firewall: Codes geben NUR CR oder Kosmetik
	local grant: Types.Grant = {}
	local lang = langOf(p)
	local parts: { string } = {}
	if isInt(entry.Grant.Credits) and entry.Grant.Credits > 0 then
		grant.Credits = math.min(entry.Grant.Credits, 1e14 - 1)
		table.insert(parts, Lang.T(lang, "prog.rw.credits", credits(grant.Credits :: number, lang)))
	end
	if type(entry.Grant.Cosmetics) == "table" and #entry.Grant.Cosmetics > 0 then
		local list: { string } = {}
		for _, key in ipairs(entry.Grant.Cosmetics) do
			if type(key) == "string" then
				table.insert(list, key)
				table.insert(parts, Lang.T(lang, "prog.rw.cosmetic", itemName("Cosmetic", key, lang)))
			end
		end
		if #list > 0 then
			grant.Cosmetics = list
		end
	end
	if grantEmpty(grant) then
		return fail(p, "prog.code.bad")
	end
	if not applyGrant(p, grant, "Code") then
		return fail(p, "prog.grantFailed")
	end
	-- Liste begrenzt: nur Einträge entfernen, die nie wieder einlösbar sind (Code gestrichen oder abgelaufen) –
	-- ein noch gültiger Code bleibt immer vermerkt (kein zweites Einlösen)
	local count = 0
	for _ in pairs(used) do
		count += 1
	end
	if count >= RCFG.CodesKeep then
		local now = os.time()
		local stale: { string } = {}
		for key in pairs(used) do
			local known = type(key) == "string" and (RCFG.Codes or {})[key] or nil
			local expires = if type(known) == "table" then isoToUnix(known.Expires) else nil
			if type(known) ~= "table" or (expires ~= nil and now >= expires) then
				table.insert(stale, key)
			end
		end
		for _, key in ipairs(stale) do
			used[key] = nil
		end
	end
	used[code] = true
	call("MetricsService", "Custom", p, "CodeRedeemed", 1, { Code = code })
	return { Ok = true, Message = T(p, "prog.code.ok", table.concat(parts, Lang.T(lang, "prog.rw.sep"))) }
end

local function handleTutorial(p: Player, arg: any): Reply
	if not exactKeys(arg, { "Step" }) or not isInt(arg.Step) then
		return fail(p, "core.invalid")
	end
	local step = arg.Step
	local cfg = PCFG.Tutorial
	if step ~= cfg.SkipStep and (step < 1 or step > cfg.Steps) then
		return fail(p, "core.invalid")
	end
	local data = dataOf(p)
	if not data then
		return fail(p, "core.loading")
	end
	local flags = tableField(data, "Flags")
	local claimed = tableField(flags, "TutClaim")
	local gained = 0
	local function claim(s: number)
		local key = tostring(s)
		local xp = cfg.Xp[s]
		if xp and not claimed[key] then
			claimed[key] = true
			local ok, value = call("ProgressionService", "AddXp", p, xp, "Tutorial", { NoMult = true })
			if ok and finite(value) then
				gained += value
			end
		end
	end
	local before = math.floor(num(flags.TutStep, 0))
	if step == cfg.SkipStep then
		-- "Tutorial überspringen" gibt dieselben Belohnungen: alle Schritt-XP und die Mini-Prüfung
		-- „Setze ein Schutz-Paar“, die sonst die Übungs-Order mit „Schutz an“ erfüllt (§B2 ~7:00)
		for s = 1, cfg.Steps do
			claim(s)
		end
		flags.TutStep = math.max(before, cfg.Steps)
		call("ProgressionService", "ExamDone", p, "ProtectPair")
	else
		flags.TutStep = math.max(before, step)
		for s = 1, step do
			claim(s)
		end
		if step >= cfg.Steps and before < cfg.Steps then
			funnel(p, 17)
		end
	end
	markDirty(p, "Flags", "Social") -- Social.CanPromptNotify hängt am Tutorial-Fortschritt
	if gained > 0 then
		return { Ok = true, Message = Lang.T(langOf(p), "tut.reward", gained), Xp = gained }
	end
	return { Ok = true, Xp = 0 }
end

-- ---------------------------------------------------------------------
-- 6) STARTER-CHECKS, LIGA-BELOHNUNG, SPIELZEIT, RÜCKKEHR
-- ---------------------------------------------------------------------
local function checkValue(p: Player, data: Data, check: string): number
	if check == "Floors" then
		local ok, floors = call("TowerService", "Floors", p)
		if ok and finite(floors) then
			return floors
		end
		local tower = data.Tower
		return if type(tower) == "table" and type(tower.Floors) == "table" then #tower.Floors else 0
	elseif check == "Eff" then
		local tower = data.Tower
		return if type(tower) == "table" then num(tower.Eff, 0) else 0
	elseif check == "Licence" then
		local ok, licence = call("ProgressionService", "Licence", p)
		return if ok and finite(licence) then licence else 1
	elseif check == "Lessons" then
		local prog = data.Prog
		local n = 0
		if type(prog) == "table" and type(prog.Lessons) == "table" then
			for _ in pairs(prog.Lessons) do
				n += 1
			end
		end
		return n
	elseif check == "RoomKinds" then
		local tower = data.Tower
		local seen: { [string]: boolean } = {}
		local n = 0
		if type(tower) == "table" and type(tower.Floors) == "table" then
			for _, floor in ipairs(tower.Floors) do
				local room = if type(floor) == "table" then floor.R else nil
				if type(room) == "string" and room ~= "" and not seen[room] then
					seen[room] = true
					n += 1
				end
			end
		end
		return n
	elseif check == "BotOn" then
		local depot = data.Depot
		if type(depot) == "table" and type(depot.Bots) == "table" then
			for _, bot in pairs(depot.Bots) do
				if type(bot) == "table" and bot.On == true then
					return 1
				end
			end
		end
		return 0
	elseif check == "LeagueDays" then
		local ok, stats = call("OrderService", "LeagueStats", p)
		local days = if ok and type(stats) == "table" then num(stats.Days, 0) else 0
		local league = data.League
		return math.max(days, if type(league) == "table" then num(league.Days, 0) else 0)
	elseif check == "Wealth" then
		local ok, wealth = call("ProgressionService", "Wealth", p)
		return if ok and finite(wealth) then wealth else 0
	end
	return 0
end

local function refreshStarter(p: Player, data: Data): boolean
	local quests = questsOf(data)
	local def = starterDef(quests)
	if not def or def.Check == nil then
		return false
	end
	local value = math.clamp(checkValue(p, data, def.Check), 0, def.Goal)
	if value ~= quests.StarterP then
		local wasDone = quests.StarterP >= def.Goal
		quests.StarterP = value
		if value >= def.Goal and not wasDone then
			questDone(p, def)
		end
		return true
	end
	return false
end

local TIER_DECOR: { [string]: string } =
	{ Bronze = "TrophyBronze", Silber = "TrophySilver", Gold = "TrophyGold", Diamant = "TrophyDiamond" }

-- Liga-Belohnung der Vorwoche beim ersten Join der Folgewoche (§B11.1)
local function checkLeagueReward(p: Player, data: Data)
	call("OrderService", "LeagueStats", p) -- rollt die Woche (Last* der Vorwoche)
	local league = data.League
	if type(league) ~= "table" then
		return
	end
	local lastWeek = num(league.LastWeek, 0)
	local tier = league.LastTier
	if lastWeek <= 0 or num(league.LastGrantedWeek, 0) >= lastWeek then
		return
	end
	if type(tier) ~= "string" or not TIER_DECOR[tier] then
		league.LastGrantedWeek = lastWeek -- keine Stufe erreicht: nichts zu vergeben
		return
	end
	local grant: Types.Grant = { Decor = { [TIER_DECOR[tier]] = 1 } }
	if not applyGrant(p, grant, "League") then
		return -- später erneut (Shop nicht erreichbar)
	end
	league.LastGrantedWeek = lastWeek
	if type(league.Trophies) ~= "table" then
		league.Trophies = {}
	end
	table.insert(league.Trophies, { W = lastWeek, T = tier })
	while #league.Trophies > 52 do
		table.remove(league.Trophies, 1)
	end
	call("ProgressionService", "GrantTitle", p, "League" .. tier)
	call("ProgressionService", "AddXp", p, PCFG.LeagueXp[tier] or 0, "League", { NoMult = true })
	RewardService.GrantSeasonXp(p, (SCFG.XpSources.League or {})[tier] or 0, "League")
	local tierName = { de = Lang.T("de", "prog.tier." .. tier), en = Lang.T("en", "prog.tier." .. tier) }
	notify(p, "prog.league.reward", { T(p, "prog.tier." .. tier), PCFG.LeagueXp[tier] or 0 }, "Success")
	call("CommunityService", "Announce", "prog.league.announce", { p.DisplayName, tierName })
	markDirty(p, "League")
end

local function playtimeTick()
	local season = SCFG.XpSources.Playtime
	local day = today()
	for _, p in ipairs(Players:GetPlayers()) do
		local okReady, ready = call("PlayerStateService", "IsReady", p)
		if not okReady or ready ~= true then
			continue
		end
		local data = dataOf(p)
		if not data then
			continue
		end
		local acc = (playAcc[p] or 0) + PLAY_TICK
		local minutes = 0
		while acc >= 60 and minutes < 10 do
			acc -= 60
			minutes += 1
		end
		playAcc[p] = acc
		local seasonData = seasonOf(data)
		if seasonData.PlayDay ~= day then
			seasonData.PlayDay = day
			seasonData.PlayToday = 0
		end
		for _ = 1, minutes do
			if num(seasonData.PlayToday, 0) < season.MaxMinutes then
				seasonData.PlayToday = num(seasonData.PlayToday, 0) + 1
				if seasonData.PlayToday % season.Minutes == 0 then
					RewardService.GrantSeasonXp(p, season.Xp, "Playtime")
				end
			end
		end
		-- Funnel 17 "TenMinutes": erste Sitzung ≥ 9:30 min
		local since = readyClock[p]
		if since and num(data.Sessions, 0) <= 1 and os.clock() - since >= PCFG.Tutorial.TenMinutesSeconds then
			funnel(p, 17)
		end
		-- Liga-Wochenwechsel während der Sitzung
		local checked = leagueCheckedAt[p] or 0
		if os.clock() - checked >= LEAGUE_CHECK_EVERY then
			leagueCheckedAt[p] = os.clock()
			checkLeagueReward(p, data)
		end
		if ensureQuests(p, data) then
			markDirty(p, "Quests")
		end
	end
end

-- Starter-Schritte mit Zustands-Prüfung (Etagen, Lizenz, …) alle 5 s je Spieler, gestaffelt
local function starterTick(p: Player)
	if not isPlayer(p) then
		return
	end
	local okReady, ready = call("PlayerStateService", "IsReady", p)
	if not okReady or ready ~= true then
		return
	end
	local data = dataOf(p)
	if data and refreshStarter(p, data) then
		markDirty(p, "Quests")
	end
end

local function winBack(p: Player, data: Data)
	local ok, savedAt = call("DataService", "LastSavedAt", p)
	if not ok or not finite(savedAt) or savedAt <= 0 then
		return
	end
	local away = os.time() - savedAt
	local cfg = RCFG.WinBack
	if away < cfg.Days * DAY_SECONDS then
		return
	end
	local grant: Types.Grant = { BoostX2 = cfg.BoostX2 }
	local long = away >= cfg.LongDays * DAY_SECONDS
	if long then
		grant.Cosmetics = table.clone(cfg.LongCosmetics)
	end
	if not applyGrant(p, grant, "WinBack") then
		return
	end
	local quests = questsOf(data)
	quests.Comeback = newQuest(QCFG.Comeback)
	notify(p, if long then "prog.winbackLong" else "prog.winback", nil, "Success")
	markDirty(p, "Quests")
end

local function onReady(p: Player)
	local data = dataOf(p)
	if not data then
		return
	end
	readyClock[p] = os.clock()
	ensureQuests(p, data)
	seasonOf(data)
	-- Funnel 18: Rückkehr an einem späteren Tag
	local flags = tableField(data, "Flags")
	local created = num(data.Created, 0)
	if flags.Day2 ~= true and num(data.Sessions, 0) >= 2 and created > 0 and today() > Util.UtcDay(created) then
		flags.Day2 = true
		funnel(p, 18)
		markDirty(p, "Flags")
	end
	winBack(p, data)
	leagueCheckedAt[p] = os.clock()
	checkLeagueReward(p, data)
	refreshStarter(p, data)
	markDirty(p, "Quests", "Login", "Season")
end

local function onPlayerRemoving(p: Player)
	readyClock[p] = nil
	playAcc[p] = nil
	leagueCheckedAt[p] = nil
end

-- ---------------------------------------------------------------------
-- 7) STATE (§C10)
-- ---------------------------------------------------------------------
local function questView(p: Player, q: Data, def: any, credit: number, seasonXp: number, xp: number): { [string]: any }
	local kind = PCFG.QuestKindByKey[def.Kind]
	return {
		Id = q.Id,
		Kind = def.Kind,
		Cat = if kind then kind.Cat else "Tower",
		Goal = def.Goal,
		P = math.min(num(q.P, 0), def.Goal),
		Done = q.Done == true,
		Claimed = q.Claimed == true,
		Text = questText(p, def),
		Tier = def.Tier,
		Credits = credit,
		SeasonXp = seasonXp,
		Xp = xp,
	}
end

local function questsState(p: Player): { [string]: any }
	local data = dataOf(p)
	if not data then
		return { Daily = {}, Weekly = {}, Starter = false, Comeback = false }
	end
	ensureQuests(p, data)
	local quests = questsOf(data)
	local daily, weekly = {}, {}
	for _, q in ipairs(quests.Daily) do
		local def = PCFG.QuestById[q.Id]
		if def then
			local xp = if isTradeKind(def.Kind) then PCFG.XpSources.DailyQuest.Xp else 0
			local view = questView(p, q, def, dailyCredits(p, def), QCFG.DailySeasonXp, xp)
			-- Neu wählen offen: der Ersatz steht vorher fest und wird angezeigt (kein Zufall, kein Kauf, §B9.7)
			if quests.Rerolled ~= true and not q.Done and not q.Claimed then
				local swapId = Core.RerollPick(p.UserId, quests.Day, quests.Daily, q.Id)
				local swapDef = swapId and PCFG.QuestById[swapId]
				view.Swap = if swapDef then questText(p, swapDef) else false
			else
				view.Swap = false
			end
			table.insert(daily, view)
		end
	end
	local weekCredits = weeklyCredits(p)
	for _, q in ipairs(quests.Weekly) do
		local def = PCFG.QuestById[q.Id]
		if def then
			local kind = PCFG.QuestKindByKey[def.Kind]
			local xp = if kind and kind.Cat == "Trade" then PCFG.XpSources.WeeklyQuest.Xp else 0
			table.insert(weekly, questView(p, q, def, weekCredits, QCFG.WeeklySeasonXp, xp))
		end
	end
	local starter: any = false
	local sdef = starterDef(quests)
	if sdef then
		starter = {
			Index = quests.Starter,
			Total = #QCFG.StarterLine,
			Id = sdef.Id,
			Goal = sdef.Goal,
			P = math.min(quests.StarterP, sdef.Goal),
			Done = quests.StarterP >= sdef.Goal,
			Credits = sdef.Credits,
			Title = sdef.Title,
			Check = sdef.Check,
			Kind = sdef.Kind,
		}
	end
	local comeback: any = false
	if type(quests.Comeback) == "table" then
		local def = QCFG.Comeback
		comeback = questView(p, quests.Comeback, def, incomeCredits(p, def.Minutes, def.MinCredits), 0, 0)
	end
	local now = os.time()
	return {
		Day = quests.Day,
		Daily = daily,
		Rerolled = quests.Rerolled == true,
		Week = quests.Week,
		Weekly = weekly,
		Starter = starter,
		Comeback = comeback,
		DayEndsAt = (math.floor(now / DAY_SECONDS) + 1) * DAY_SECONDS,
		WeekEndsAt = (math.floor((now / DAY_SECONDS + 3) / 7) + 1) * 7 * DAY_SECONDS - 3 * DAY_SECONDS,
	}
end

local function loginState(p: Player): { [string]: any }
	local data = dataOf(p)
	if not data then
		return { Claimable = false, Streak = 0 }
	end
	local login = tableField(data, "Login")
	local day = today()
	local preview = Core.LoginStep(login, day, Util.IsoWeek(), false)
	local now = os.time()
	return {
		LastDay = num(login.LastDay, 0),
		Today = day,
		Claimable = preview ~= nil,
		Streak = num(login.Streak, 0),
		Best = num(login.Best, 0),
		Freeze = num(login.Freeze, 0),
		Track = num(login.Track, 0),
		NextDay = if preview then preview.DayIdx else ProgressMath.LoginDay(math.max(1, num(login.Streak, 1))),
		NextCycle = if preview then preview.Cycle else num(login.Cycle, 1),
		WillReset = preview ~= nil and preview.Streak == 1 and num(login.Streak, 0) > 1,
		NextAt = (math.floor(now / DAY_SECONDS) + 1) * DAY_SECONDS,
	}
end

local function seasonState(p: Player): { [string]: any }
	local data = dataOf(p)
	if not data then
		return { Id = 0, Xp = 0, Tier = 0, Premium = false }
	end
	local season, current = seasonOf(data)
	if not current then
		return { Id = 0, Xp = 0, Tier = 0, Premium = false, Ended = true }
	end
	local def = current.Def
	local index = table.find(SCFG.Seasons, def) or #SCFG.Seasons
	return {
		Id = current.Id,
		Key = current.Key,
		Name = current.Name or false,
		Rolling = current.Rolling,
		StartsAt = current.StartsAt,
		EndsAt = current.EndsAt,
		Xp = season.Xp,
		Tier = ProgressMath.SeasonTier(season.Xp, def.TierXp, def.Tiers),
		EarnedTier = ProgressMath.SeasonTier(season.Xp - num(season.BoughtXp, 0), def.TierXp, def.Tiers),
		Tiers = def.Tiers,
		TierXp = def.TierXp,
		Premium = season.Premium,
		ClaimedFree = season.ClaimedFree,
		ClaimedPremium = season.ClaimedPremium,
		PlayToday = num(season.PlayToday, 0),
		SeasonIndex = index, -- Index in Config.Season.Seasons (Rolling nutzt die Spuren der letzten Saison)
	}
end

-- ---------------------------------------------------------------------
-- 8) INIT / START
-- ---------------------------------------------------------------------
function RewardService.Init(services: any)
	Services = services
	local pss = services.PlayerStateService
	if not pss then
		warn("[RewardService] PlayerStateService fehlt – keine Anfragen/State")
		return
	end
	pss.Provide("Quests", questsState)
	pss.Provide("Login", loginState)
	pss.Provide("Season", seasonState)
	pss.Handle("RewardLogin", handleLogin, { Rate = 2, Per = 1 })
	pss.Handle("RewardQuest", handleQuest, { Rate = 2, Per = 1 })
	pss.Handle("RewardReroll", handleReroll, { Rate = 2, Per = 1 })
	pss.Handle("RewardSeason", handleSeason, { Rate = 2, Per = 1 })
	pss.Handle("RewardCode", handleCode, { Rate = 3, Per = 60 })
	pss.Handle("RewardTutorial", handleTutorial, { Rate = 2, Per = 1 })
end

function RewardService.Start()
	call("PlayerStateService", "OnReady", onReady)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	Scheduler.Every("RewardPlaytime", 1 / PLAY_TICK, playtimeTick)
	Scheduler.Staggered("RewardStarter", 0.2, function()
		return Players:GetPlayers()
	end, function(p: Player)
		starterTick(p)
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">SelfTestService</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Selbsttest (Server/Services/SelfTestService)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C5.2 + §C17 (CC-Kopie 1:1).
--  Lädt alle ModuleScripts in Server.Tests (CoreTests WP1, MarketTests WP3, OrderTests WP4, … AdminTests WP11).
--  Jedes gibt { [testName]: () -> () } zurück; ein Fehler (error/assert) = FAIL. Ausgabe im Output: "[SelfTest] n/n PASS".
--  Jeder Test bekommt die Services-Tabelle als (optionales) erstes Argument – wer sie
--  nicht braucht, ignoriert sie einfach.
--  Automatisch nur in Studio und nur wenn Config.Studio.SelfTest = true (kurz nach dem Start);
--  Run() kann jederzeit aufgerufen werden (Admin-Debug "RunSelfTest").
--
--  Öffentliche API:
--    SelfTestService.Run(): (number, number)     (bestanden, gesamt) – yieldet nicht selbst,
--                                                Tests dürfen aber yielden
--    SelfTestService.LastReport(): { Passed, Total, Failures = { string }, At }?
-- =====================================================================

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local SelfTestService = {}
local Services: any = nil

export type Report = { Passed: number, Total: number, Failures: { string }, At: number }

local START_DELAY = 3 -- Sekunden nach dem Start (Welt gebaut, Takte laufen)
local MAX_TESTS = 2000 -- Obergrenze (Schutz vor kaputten Test-Tabellen)

local running = false
local lastReport: Report? = nil

local function testsFolder(): Instance?
	return script.Parent.Parent:FindFirstChild("Tests")
end

-- Liste der Test-Module, nach Namen sortiert (gleiche Reihenfolge bei jedem Lauf)
local function testModules(): { ModuleScript }
	local folder = testsFolder()
	local modules: { ModuleScript } = {}
	if not folder then
		return modules
	end
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("ModuleScript") then
			table.insert(modules, child)
		end
	end
	table.sort(modules, function(a, b)
		return a.Name < b.Name
	end)
	return modules
end

local function shortError(err: any): string
	local text = tostring(err)
	-- erste Zeile reicht im Output
	local newline = string.find(text, "\n", 1, true)
	if newline then
		text = string.sub(text, 1, newline - 1)
	end
	return text
end

function SelfTestService.Run(): (number, number)
	if running then
		warn("[SelfTest] läuft schon")
		local report = lastReport
		return if report then report.Passed else 0, if report then report.Total else 0
	end
	running = true
	local passed, total = 0, 0
	local failures: { string } = {}

	for _, module in ipairs(testModules()) do
		local okRequire, suite = pcall(require, module)
		if not okRequire or type(suite) ~= "table" then
			total += 1
			local message = ("%s (laden): %s"):format(
				module.Name,
				if okRequire then "gibt keine Tabelle zurück" else shortError(suite)
			)
			table.insert(failures, message)
			continue
		end
		local names: { string } = {}
		for name, fn in pairs(suite) do
			if type(name) == "string" and type(fn) == "function" then
				table.insert(names, name)
			end
		end
		table.sort(names)
		for _, name in ipairs(names) do
			if total >= MAX_TESTS then
				break
			end
			total += 1
			local ok, err = xpcall(suite[name], debug.traceback, Services)
			if ok then
				passed += 1
			else
				table.insert(failures, ("%s.%s: %s"):format(module.Name, name, shortError(err)))
			end
		end
	end

	for _, failure in ipairs(failures) do
		warn("[SelfTest] FAIL " .. failure)
	end
	local summary = ("[SelfTest] %d/%d PASS"):format(passed, total)
	if passed == total then
		print(summary)
	else
		warn(summary .. (" – %d FAIL"):format(total - passed))
	end

	lastReport = { Passed = passed, Total = total, Failures = failures, At = os.time() }
	running = false
	return passed, total
end

function SelfTestService.LastReport(): Report?
	return lastReport
end

function SelfTestService.Init(services: any)
	Services = services
end

function SelfTestService.Start()
	local studio = Config.Studio
	if RunService:IsStudio() and type(studio) == "table" and studio.SelfTest == true then
		task.delay(START_DELAY, function()
			local ok, err = pcall(SelfTestService.Run)
			if not ok then
				running = false
				warn("[SelfTest] Abbruch: " .. tostring(err))
			end
		end)
	end
end

return SelfTestService
]]></string>
          </Properties>
