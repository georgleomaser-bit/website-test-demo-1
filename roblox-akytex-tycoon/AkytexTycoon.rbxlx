		Parent = frame,
	})
	billboard.Parent = gui
	actor.Extra.Board = billboard
	actor.Extra.Body = body
	actor.Extra.QuestionLabel = question
end

local function companyName(i: number): string
	local companies = ctx and ctx.Config and ctx.Config.Companies
	local byId = companies and companies.ById
	local entry = byId and byId[i]
	if type(entry) == "table" then
		local name = entry.Name
		local text = if type(name) == "table" then (name[lang()] or name.de or "") else tostring(name or "")
		return ("%s · %s"):format(tostring(entry.Ticker or i), text)
	end
	return tostring(i)
end

local function consensusText(profile: any): string
	if type(profile) ~= "table" then
		return T("evt.press.consPending")
	end
	local cons = profile.Consensus
	local text = if cons == "Up"
		then T("evt.press.consUp")
		elseif cons == "Down" then T("evt.press.consDown")
		elseif cons == "Flat" then T("evt.press.consFlat")
		else T("evt.press.consPending")
	local beat, miss = 0, 0
	if type(profile.Analysts) == "table" then
		for _, a in ipairs(profile.Analysts) do
			if type(a) == "table" then
				if a.Verdict == 1 then
					beat += 1
				elseif a.Verdict == -1 then
					miss += 1
				end
			end
		end
	end
	if beat + miss > 0 then
		text ..= " · " .. T("evt.press.verdicts", beat, miss)
	end
	return text
end

local function refreshPressBoard(actor: Actor)
	local body: TextLabel? = actor.Extra.Body
	if not body then
		return
	end
	local items = actor.Data.Items
	local rows: { string } = {}
	if type(items) == "table" and #items > 0 then
		for _, item in ipairs(items) do
			if type(item) == "table" and type(item.I) == "number" then
				local cached = profileCache[item.I]
				table.insert(
					rows,
					("<b>%s</b>\n%s"):format(companyName(item.I), consensusText(if cached then cached.Profile else nil))
				)
			end
		end
	else
		table.insert(rows, T("evt.press.noItems"))
	end
	body.Text = table.concat(rows, "\n")
	local question: TextLabel? = actor.Extra.QuestionLabel
	if question then
		local ids = actor.Data.Quiz
		local q = actor.Extra.Question
		local id = if type(ids) == "table" and type(q) == "number" then ids[q] else nil
		question.Text = if id
			then T("evt.press.question", q, #ids, T(("evt.quiz.%d.q"):format(id)))
			else T("evt.press.quizHint")
	end
end

-- Profile der berichtenden Firmen einmal je Pressekonferenz holen (MktProfile, Konsens/Urteile soweit freigegeben)
local function fetchPressProfiles(actor: Actor)
	if pressRequested[actor.Key] then
		return
	end
	pressRequested[actor.Key] = true
	local items = actor.Data.Items
	if type(items) ~= "table" then
		return
	end
	task.spawn(function()
		for index, item in ipairs(items) do
			if index > 4 or not actors[actor.Key] then
				break
			end
			if type(item) == "table" and type(item.I) == "number" and ctx and type(ctx.RequestFull) == "function" then
				local reply = ctx.RequestFull("MktProfile", { I = item.I }, true)
				if reply.Ok and type(reply.Profile) == "table" then
					profileCache[item.I] = { At = os.clock(), Profile = reply.Profile }
				end
				refreshPressBoard(actor)
				task.wait(0.4)
			end
		end
	end)
end

-- Top-10-Hologramm (Bilanz-Sonntag): nur Rang + Name, keine Werte
local function finaleBoard(actor: Actor, anchorPart: BasePart)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "AT_FinaleBoard"
	billboard.Size = UDim2.fromOffset(320, 360)
	billboard.StudsOffset = Vector3.new(0, 18, 0)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 260
	billboard.Adornee = anchorPart
	local frame = UI.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Parent = billboard,
	}, {
		UI.Corner(16),
		UI.Stroke(GOLD, 1),
		UI.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 14),
			PaddingRight = UDim.new(0, 14),
			PaddingTop = UDim.new(0, 10),
		}),
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }),
	})
	UI.Create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Display,
		TextSize = 18,
		TextColor3 = GOLD,
		Text = T("evt.finale.title"),
		LayoutOrder = 0,
		Parent = frame,
	})
	local top = actor.Data.Top
	if type(top) == "table" then
		for i, name in ipairs(top) do
			if i > 10 then
				break
			end
			UI.Create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				FontFace = if i <= 3 then UI.Faces.BodyBold else UI.Faces.Body,
				TextSize = if i <= 3 then 19 else 16,
				TextColor3 = if i == 1 then GOLD elseif i <= 3 then Theme.Text else Theme.Text2,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = ("%d.  %s"):format(i, tostring(name)),
				LayoutOrder = i,
				Parent = frame,
			})
		end
	end
	billboard.Parent = gui
	actor.Extra.Board = billboard
end

local function spawnActor(state: any): Actor?
	local key = actorKey(state)
	if not key or countActors() >= MAX_ACTORS then
		return nil
	end
	local data = if type(state.Data) == "table" then state.Data else {}
	local actor: Actor = {
		Key = key,
		Kind = state.Kind,
		Started = state.Started,
		Until = num(state.Until, state.Started),
		Data = data,
		Visuals = {},
		Extra = {},
		Leaving = nil,
	}
	local kind = state.Kind
	if kind == "Truck" then
		table.insert(actor.Visuals, toVisual(build("Truck", RECIPES.Truck)))
	elseif kind == "Drones" then
		local spots = data.Spots
		if type(spots) == "table" then
			for i, spot in ipairs(spots) do
				if i > 12 then
					break
				end
				if typeof(spot) == "Vector3" then
					table.insert(actor.Visuals, toVisual(build("Drone", RECIPES.Drone)))
				end
			end
		end
	elseif kind == "BuildBoom" then
		for _ in ipairs(plotSites()) do
			table.insert(actor.Visuals, toVisual(build("Crane", RECIPES.Crane)))
		end
	elseif kind == "Press" then
		local visual = toVisual(build("Hologram", RECIPES.Hologram))
		table.insert(actor.Visuals, visual)
		if visual.Parts[1] then
			pressBoard(actor, visual.Parts[1])
		end
		fetchPressProfiles(actor)
	elseif kind == "Bear" then
		table.insert(actor.Visuals, toVisual(build("Bear", RECIPES.Bear)))
	elseif kind == "GoldenBull" then
		table.insert(actor.Visuals, toVisual(build("Bull", RECIPES.Bull)))
	elseif kind == "Parade" then
		local count = math.clamp(math.floor(num(data.Bulls, 5)), 1, 8)
		for _ = 1, count do
			table.insert(actor.Visuals, toVisual(build("Bull", RECIPES.Bull)))
		end
		local lead = actor.Visuals[1]
		if lead and lead.Parts[1] then
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "AT_ParadeThanks"
			billboard.Size = UDim2.fromOffset(280, 46)
			billboard.StudsOffset = Vector3.new(0, 11, 0)
			billboard.LightInfluence = 0
			billboard.MaxDistance = 300
			billboard.Adornee = lead.Parts[1]
			local label = UI.Create("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Theme.Surface,
				BackgroundTransparency = 0.15,
				FontFace = UI.Faces.Display,
				TextSize = 20,
				TextColor3 = GOLD,
				Text = T("evt.paradeBanner", tostring(data.Name or "?")),
				Parent = billboard,
			}, { UI.Corner(12), UI.Stroke(GOLD, 1) })
			billboard.Parent = gui
			actor.Extra.Board = billboard
			actor.Extra.Label = label
		end
	elseif kind == "LeagueFinale" then
		local anchorPart = part({ Name = "AT_FinaleAnchor", Size = Vector3.new(1, 1, 1), Transparency = 1 })
		local ring = part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 18, 18),
			Color = GOLD,
			Material = Enum.Material.Neon,
			Transparency = 0.4,
		})
		local m = newModel("AT_Finale", { anchorPart, ring })
		ring.CFrame = CFrame.Angles(0, 0, math.pi / 2)
		local visual = toVisual(m)
		table.insert(actor.Visuals, visual)
		finaleBoard(actor, anchorPart)
	else
		return nil -- Events ohne Darsteller (Golden Hour, XP-Rausch, Power-Hour …)
	end
	actors[key] = actor
	return actor
end

local function removeActor(key: string)
	local actor = actors[key]
	if not actor then
		return
	end
	actors[key] = nil
	for _, v in ipairs(actor.Visuals) do
		destroyVisual(v)
	end
	local board = actor.Extra.Board
	if typeof(board) == "Instance" then
		board:Destroy()
	end
	pressRequested[key] = nil
end

local function updateActor(actor: Actor, t: number, dt: number)
	local kind = actor.Kind
	local data = actor.Data
	local duration = math.max(1, actor.Until - actor.Started)
	local f = math.clamp((t - actor.Started) / duration, 0, 1)
	if kind == "Truck" then
		local route = routeOf(data.Route or "Ring")
		local v = actor.Visuals[1]
		if route and v then
			queueMove(v, routeFrame(route, f, 0))
		end
	elseif kind == "Drones" then
		local spots = data.Spots
		local drop = num(data.Drop, 8)
		local elapsed = t - actor.Started
		for i, v in ipairs(actor.Visuals) do
			local spot = if type(spots) == "table" then spots[i] else nil
			if typeof(spot) == "Vector3" then
				local height: number
				if elapsed < drop then
					local g = elapsed / drop
					height = DRONE_HEIGHT * (1 - (1 - (1 - g) ^ 3)) + 5
				elseif elapsed < drop + 1.5 then
					height = 5
				else
					height = 5 + (elapsed - drop - 1.5) * 18
				end
				local spin = os.clock() * 0.8 + i
				queueMove(v, CFrame.new(spot + Vector3.new(0, height, 0)) * CFrame.Angles(0, spin, 0))
				local cargo = v.Model:FindFirstChild("Cargo")
				if cargo and cargo:IsA("BasePart") then
					local want = if elapsed < drop then 0 else 1
					if cargo.Transparency ~= want then
						cargo.Transparency = want
					end
				end
			end
		end
	elseif kind == "BuildBoom" then
		local sites = plotSites()
		for i, v in ipairs(actor.Visuals) do
			local site = sites[i]
			if site then
				local toCenter = plazaCenter() - site.Position
				local flat = Vector3.new(toCenter.X, 0, toCenter.Z)
				local side = if flat.Magnitude > 1
					then Vector3.new(-flat.Unit.Z, 0, flat.Unit.X)
					else Vector3.new(1, 0, 0)
				local base = site.Position + side * 34
				queueMove(v, CFrame.new(base) * CFrame.Angles(0, os.clock() * 0.15 + i, 0))
			end
		end
	elseif kind == "Press" then
		local v = actor.Visuals[1]
		local pos = if typeof(data.Pos) == "Vector3" then data.Pos else attrVector("AT_PressPos")
		local look = if typeof(data.Look) == "Vector3" then data.Look else attrVector("AT_PressLook")
		if v and pos then
			local dir = if look and look.Magnitude > 0.01 then look else Vector3.new(0, 0, 1)
			local front = pos + dir * 12
			local bob = math.sin(os.clock() * 1.6) * 0.3
			queueMove(v, CFrame.lookAt(front + Vector3.new(0, bob, 0), front + Vector3.new(0, bob, 0) + dir))
		end
		actor.Extra.RefreshAcc = num(actor.Extra.RefreshAcc, 0) + dt
		if actor.Extra.RefreshAcc >= 1 then
			actor.Extra.RefreshAcc = 0
			refreshPressBoard(actor)
		end
	elseif kind == "Bear" then
		local v = actor.Visuals[1]
		if v then
			local center = plazaCenter()
			local elapsed = t - actor.Started
			local walk = math.clamp(elapsed / BEAR_WALK, 0, 1)
			local from = center + Vector3.new(0, 0, 120)
			local pos = from:Lerp(center + Vector3.new(0, 0, 12), 1 - (1 - walk) ^ 2)
			local stomp = math.abs(math.sin(os.clock() * (if walk < 1 then 5 else 2.2)))
				* (if walk < 1 then 0.8 else 0.35)
			local sway = math.sin(os.clock() * 2.2) * 0.06
			local cf = CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1))
				* CFrame.new(0, stomp, 0)
				* CFrame.Angles(0, 0, sway)
			local leaving = actor.Leaving
			if leaving then
				local g = math.clamp((os.clock() - leaving) / 6, 0, 1)
				if actor.Extra.Success then
					-- verbeugen (1,5 s), dann gemächlich davon
					local bow = math.clamp((os.clock() - leaving) / 1.5, 0, 1)
					cf = CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1))
						* CFrame.Angles(-0.45 * math.sin(bow * math.pi), 0, 0)
					if g > 0.25 then
						local away = (g - 0.25) / 0.75
						cf = CFrame.lookAt(pos, pos - Vector3.new(0, 0, 1)) + Vector3.new(0, 0, -away * 110)
					end
				else
					cf = CFrame.lookAt(pos, pos - Vector3.new(0, 0, 1)) + Vector3.new(0, 0, -g * 110)
				end
			end
			queueMove(v, cf)
		end
	elseif kind == "GoldenBull" then
		local route = routeOf(data.Route or "Ring")
		local v = actor.Visuals[1]
		if route and v then
			local bob = math.abs(math.sin(os.clock() * 7)) * 0.6
			queueMove(v, routeFrame(route, f, bob))
		end
	elseif kind == "Parade" then
		local route = routeOf(data.Route or "Parade")
		if route then
			local cfg = eventsCfg()
			local lap = num(cfg.Parade and cfg.Parade.LapSeconds, 150)
			local base = ((t - actor.Started) / lap) % 1
			for i, v in ipairs(actor.Visuals) do
				local offset = (i - 1) * PARADE_GAP / route.Length
				local bob = math.abs(math.sin(os.clock() * 6 + i)) * 0.5
				queueMove(v, routeFrame(route, base - offset, bob))
			end
		end
	elseif kind == "LeagueFinale" then
		local v = actor.Visuals[1]
		local pos = if typeof(data.Pos) == "Vector3" then data.Pos else attrVector("AT_HallPos")
		if v and pos then
			queueMove(v, CFrame.new(pos + Vector3.new(0, 0.3, 0)))
		end
	end
end

-- Darsteller mit dem State abgleichen (neue anlegen, beendete entfernen, Verlängerungen übernehmen)
local function syncActors(list: any)
	local t = now()
	local seen: { [string]: boolean } = {}
	if type(list) == "table" then
		for _, state in ipairs(list) do
			local key = actorKey(state)
			if key and num(state.Until, 0) > t then
				seen[key] = true
				local actor = actors[key]
				if actor then
					actor.Until = num(state.Until, actor.Until)
					if type(state.Data) == "table" then
						actor.Data = state.Data
					end
				else
					spawnActor(state)
				end
			end
		end
	end
	for key, actor in pairs(actors) do
		if not seen[key] and not actor.Leaving then
			if actor.Kind == "Bear" then
				actor.Leaving = os.clock()
				actor.Until = t + 7
			else
				removeActor(key)
			end
		end
	end
end

local function onWorldEvent(state: any)
	local key = actorKey(state)
	if not key then
		return
	end
	local t = now()
	if num(state.Until, 0) <= t then
		local actor = actors[key]
		if actor then
			if actor.Kind == "Bear" and not actor.Leaving then
				actor.Leaving = os.clock()
				actor.Until = t + 7
			elseif actor.Kind ~= "Bear" then
				removeActor(key)
			end
		end
	else
		local actor = actors[key]
		if actor then
			actor.Until = num(state.Until, actor.Until)
			if type(state.Data) == "table" then
				actor.Data = state.Data
			end
		else
			spawnActor(state)
		end
	end
end

-- ---------------------------------------------------------------------
-- GOLDEN HOUR (Welt-Tönung), GLOCKEN-ZONE, BÄR-LEISTE, WARTUNGS-BANNER
-- ---------------------------------------------------------------------
local function updateGolden(t: number)
	local active = false
	for _, state in ipairs(EventsClient.Active()) do
		if state.Kind == "GoldenHour" and num(state.Until, 0) > t then
			active = true
			break
		end
	end
	if active and not goldenSet then
		local ok = tryModule("WorldLook", "SetOverride", "Golden")
		goldenSet = ok
	elseif not active and goldenSet then
		goldenSet = false
		tryModule("WorldLook", "SetOverride", nil)
	end
end

local function bellWindowOpen(t: number): boolean
	local clock = ctx and ctx.Clock
	if not clock then
		return false
	end
	local cfg = eventsCfg().BellMoment or {}
	local tick = math.floor(t) - num(clock.EPOCH, 0)
	local dayTicks = num(clock.DAY_TICKS, 1200)
	local day = tick // dayTicks
	local within = tick % dayTicks
	return day % math.max(1, math.floor(num(cfg.DayEvery, 3))) == 0 and within < num(cfg.WindowSeconds, 60)
end

local function updateBellZone(t: number)
	local center = attrVector("AT_BellZone")
	local radius = num(workspace:GetAttribute("AT_BellZoneRadius"), 18)
	local momentLive = false
	for _, state in ipairs(EventsClient.Active()) do
		if state.Kind == "BellMoment" and num(state.Until, 0) > t then
			momentLive = true
			break
		end
	end
	local show = center ~= nil and (bellWindowOpen(t) or momentLive)
	local glow = bellRing and bellRing:FindFirstChild("AT_EventLight")
	if glow and glow:IsA("Light") and glow.Enabled ~= show then
		glow.Enabled = show -- goldener Bodenschein nur, solange die Zone offen ist
	end
	if not show then
		if bellRing then
			bellRing.Transparency = 1
		end
		if bellGui then
			bellGui.Enabled = false
		end
		return
	end
	if not bellRing then
		local ring = part({
			Name = "AT_BellZone",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, radius * 2, radius * 2),
			Color = GOLD,
			Material = Enum.Material.Neon,
			Transparency = 0.6,
		})
		addLight(ring, "PointLight", 16, { Range = math.min(radius + 6, 60), Brightness = 1.1, Color = GOLD })
		ring.Parent = folder
		bellRing = ring
		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromOffset(260, 40)
		billboard.StudsOffset = Vector3.new(0, 8, 0)
		billboard.LightInfluence = 0
		billboard.MaxDistance = 250
		billboard.Adornee = ring
		local label = UI.Create("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Surface,
			BackgroundTransparency = 0.15,
			FontFace = UI.Faces.BodyBold,
			TextSize = 18,
			TextColor3 = GOLD,
			Text = "",
			Parent = billboard,
		}, { UI.Corner(12), UI.Stroke(GOLD, 1) })
		billboard.Parent = gui
		bellGui = billboard
		bellLabel = label
	end
	local ring = bellRing :: Part
	local pulse = 0.55 + math.sin(os.clock() * 4) * 0.12
	ring.Transparency = pulse
	ring.CFrame = CFrame.new((center :: Vector3) + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	-- Spieler in der Zone (Anzeige; der Server zählt verbindlich)
	local inside = 0
	for _, p in ipairs(Players:GetPlayers()) do
		local character = p.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local d = root.Position - (center :: Vector3)
			if Vector2.new(d.X, d.Z).Magnitude <= radius + 2 and math.abs(d.Y) < 40 then
				inside += 1
			end
		end
	end
	local needed = math.floor(num(eventsCfg().BellMoment and eventsCfg().BellMoment.MinPlayers, 3))
	local studio = ctx and ctx.State and ctx.State.Server and ctx.State.Server.Studio == true
	if studio then
		needed = math.floor(num(ctx.Config.Studio and ctx.Config.Studio.BellZoneMinPlayers, 1))
	end
	if bellGui and bellLabel then
		bellGui.Enabled = not photoHidden
		bellLabel.Text = if momentLive then T("evt.bellZoneLive") else T("evt.bellZone", inside, math.max(1, needed))
	end
end

local function updateBearBar()
	local bar, fill, label = bearBar, bearFill, bearLabel
	if not bar or not fill or not label then
		return
	end
	local show = bearGoal > 0 and not photoHidden
	bar.Visible = show
	if show then
		local ratio = math.clamp(bearHave / math.max(1, bearGoal), 0, 1)
		TweenService:Create(fill, TweenInfo.new(0.25, Enum.EasingStyle.Quint), { Size = UDim2.fromScale(ratio, 1) })
			:Play()
		label.Text = T("evt.bearProgress", bearHave, bearGoal)
	end
end

local function updateBanner()
	local frame, label = banner, bannerLabel
	if not frame or not label then
		return
	end
	local text = workspace:GetAttribute("AT_Maintenance")
	local show = type(text) == "string" and text ~= "" and not photoHidden
	frame.Visible = show
	if show then
		label.Text = T("evt.maintenance", text :: string)
	end
end

local function buildUi()
	local screen = UI.Create("ScreenGui", {
		Name = "AkytexTycoonEvents",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 2,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	gui = screen
	-- Bär-Fortschritt (oben Mitte, unter den HUD-Pillen)
	local bar = UI.Create("Frame", {
		Name = "BearBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Size = UDim2.fromOffset(300, 34),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
		Visible = false,
		Parent = screen,
	}, { UI.Corner(17), UI.Stroke(nil, 1) })
	local track = UI.Create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -6),
		Size = UDim2.new(1, -28, 0, 4),
		BackgroundColor3 = Theme.Bg2,
		BorderSizePixel = 0,
		Parent = bar,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local fill = UI.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = COSMIC,
		BorderSizePixel = 0,
		Parent = track,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local label = UI.Create("TextLabel", {
		Position = UDim2.fromOffset(14, 2),
		Size = UDim2.new(1, -28, 0, 20),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.BodyBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		Text = "",
		Parent = bar,
	})
	bearBar, bearFill, bearLabel = bar, fill, label
	-- Wartungs-Banner (Live-Ops-Notschalter)
	local strip = UI.Create("Frame", {
		Name = "Maintenance",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.new(0.6, 0, 0, 30),
		BackgroundColor3 = Theme.Warn,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 5,
		Parent = screen,
	}, { UI.Corner(10) })
	local stripLabel = UI.Create("TextLabel", {
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.BodyBold,
		TextSize = 15,
		TextColor3 = DARK,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "",
		ZIndex = 6,
		Parent = strip,
	})
	banner, bannerLabel = strip, stripLabel
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API + LEBENSZYKLUS
-- ---------------------------------------------------------------------
function EventsClient.Active(): { any }
	local state = ctx and ctx.State and ctx.State.Event
	local list = if type(state) == "table" and type(state.Active) == "table" then state.Active else {}
	local t = now()
	local out: { any } = {}
	for _, entry in ipairs(list) do
		if type(entry) == "table" and num(entry.Until, 0) > t then
			table.insert(out, entry)
		end
	end
	return out
end

function EventsClient.Frame(dt: number)
	local t = now()
	stepTokens(dt, t)
	local finished: { string } = {}
	for key, actor in pairs(actors) do
		if t > actor.Until + (if actor.Leaving then 0 else 2) then
			table.insert(finished, key)
		else
			updateActor(actor, t, dt)
		end
	end
	for _, key in ipairs(finished) do
		removeActor(key)
	end
	-- schwebende CR-Schilder ausblenden, wenn abgelaufen
	local clock = os.clock()
	for _, entry in ipairs(floatPool) do
		if entry.Until <= clock and entry.Gui.Enabled then
			entry.Gui.Enabled = false
		end
	end
	flushMoves()
	bellAcc += dt
	if bellAcc >= BELL_CHECK then
		bellAcc = 0
		updateBellZone(t)
		updateGolden(t)
	end
	local effectsEvent = module("EffectsEvent")
	if effectsEvent and type(effectsEvent.Step) == "function" then
		local ok, err = pcall(effectsEvent.Step, dt)
		if not ok then
			warn("[EventsClient] EffectsEvent.Step: " .. tostring(err))
		end
	end
end

function EventsClient.Init(context: any)
	ctx = context
	local ok, slotModule = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AssetSlot")) :: any
	end)
	AssetSlot = if ok then slotModule else nil
	local f = Instance.new("Folder")
	f.Name = "AT_EventLocal"
	f.Parent = workspace
	folder = f
	buildUi()
end

function EventsClient.Start()
	local hooks = ctx.Hooks
	hooks.On("World:Pickups", function(list: any)
		if type(list) ~= "table" then
			return
		end
		for i, raw in ipairs(list) do
			if i > 60 then
				break
			end
			addToken(raw)
		end
		flushMoves()
	end)
	hooks.On("World:PickupGone", function(data: any)
		if type(data) == "table" and type(data.Id) == "number" then
			removeToken(data.Id)
		end
	end)
	hooks.On("World:Event", onWorldEvent)
	hooks.On("World:Bear", function(data: any)
		if type(data) == "table" then
			bearHave = math.max(0, math.floor(num(data.Have, 0)))
			bearGoal = math.max(0, math.floor(num(data.Goal, 0)))
			updateBearBar()
		end
	end)
	hooks.On("World:Parade", function(data: any)
		-- Parade kommt zusätzlich als World:Event (Darsteller); hier nur die Verlängerung übernehmen
		if type(data) ~= "table" then
			return
		end
		for _, actor in pairs(actors) do
			if actor.Kind == "Parade" then
				actor.Until = math.max(actor.Until, num(data.Until, actor.Until))
			end
		end
	end)
	hooks.On("Effect:Bear", function(_strength: any, data: any)
		if type(data) ~= "table" then
			return
		end
		if data.Phase == "Success" or data.Phase == "Leave" then
			for _, actor in pairs(actors) do
				if actor.Kind == "Bear" and not actor.Leaving then
					actor.Leaving = os.clock()
					actor.Extra.Success = data.Phase == "Success"
					actor.Until = now() + 7
				end
			end
			bearHave, bearGoal = 0, 0
			updateBearBar()
		end
	end)
	hooks.On("State", function(state: any, changed: any)
		if type(changed) == "table" and changed.Event and type(state) == "table" then
			local event = state.Event
			if type(event) == "table" then
				syncActors(event.Active)
				bearHave = math.max(0, math.floor(num(event.BearHave, bearHave)))
				bearGoal = math.max(0, math.floor(num(event.BearGoal, 0)))
				updateBearBar()
			end
		end
	end)
	hooks.On("PhotoMode", function(on: any)
		photoHidden = on == true
		updateBearBar()
		updateBanner()
		for _, token in pairs(tokens) do
			if token.Gui then
				token.Gui.Enabled = not photoHidden
			end
		end
		for _, actor in pairs(actors) do
			local board = actor.Extra.Board
			if typeof(board) == "Instance" and board:IsA("BillboardGui") then
				board.Enabled = not photoHidden
			end
		end
	end)
	workspace:GetAttributeChangedSignal("AT_Maintenance"):Connect(updateBanner)
	player.CharacterAdded:Connect(function()
		collectAcc = 0
	end)
	updateBanner()
	-- erster Stand (State kann schon vor Start angekommen sein)
	local event = ctx.State and ctx.State.Event
	if type(event) == "table" then
		syncActors(event.Active)
	end
end

return EventsClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">Fly</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Fliegen / Schweben (Client/Modules/Fly)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Basis: CLUTCH-CLASH-Fly (REUSE §1.4 COPY), nur Namen/Präfixe angepasst.
--  Nur wenn der Server es erlaubt (Attribut CanFly, nur der Besitzer hat es; Modul lädt nur bei IsAdmin).
--  Taste G (Config.Client.Keys.Fly, Controls-Aktion "Fly"). WASD/Stick = Richtung (folgt der Kamera, auch hoch/runter),
--  Leertaste = hoch, Strg/C = runter, Shift = schneller (×2). Der Anti-Cheat nimmt Admins aus (AntiCheatService).
--  Beim Losfliegen meldet der Client SetPower{CanFly} an den Server (Admin-Log; Antwort egal).
--  Physik über LinearVelocity + AlignOrientation (kein BodyVelocity, Muss-Regel 12). Eigene PreRender-Verbindung nur
--  während des Flugs (Admin-Modul, nicht in FRAME_MODULES).
--
--  Öffentliche API (§C7.5):
--    Fly.Toggle()          Fly.IsFlying(): boolean          Fly.Init(ctx) / Fly.Start()
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Fly = {}

local player = Players.LocalPlayer
local ctx: any = nil

local DEFAULT_SPEED = 70
local BOOST = 2 -- Shift = doppelt so schnell

local flying = false
local flyParts: { Instance } = {}
local flyConnection: RBXScriptConnection? = nil

local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function toast(text: string, kind: string)
	if ctx and type(ctx.Toast) == "function" then
		ctx.Toast(text, kind)
	end
end

local function flySpeed(): number
	local security = ctx and ctx.Config and ctx.Config.Security
	local powers = security and security.Powers
	local speed = powers and tonumber(powers.FlySpeed)
	return if speed and speed > 0 then speed else DEFAULT_SPEED
end

local function keyDown(...: Enum.KeyCode): boolean
	for _, key in ipairs({ ... }) do
		if UserInputService:IsKeyDown(key) then
			return true
		end
	end
	return false
end

local function stopFlying()
	flying = false
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	for _, inst in ipairs(flyParts) do
		inst:Destroy()
	end
	flyParts = {}
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = false
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
end

local function startFlying()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart or not rootPart:IsA("BasePart") or humanoid.Health <= 0 then
		return
	end
	if rootPart.Anchored or humanoid.SeatPart ~= nil then
		return -- eingefroren oder im Auto
	end
	local root: BasePart = rootPart
	flying = true
	local attachment = Instance.new("Attachment")
	attachment.Name = "AT_FlyAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "AT_FlyVelocity"
	velocity.Attachment0 = attachment
	velocity.MaxForce = 1e7
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Name = "AT_FlyAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.MaxTorque = 1e7
	align.Responsiveness = 40
	align.CFrame = root.CFrame.Rotation
	align.Parent = root
	flyParts = { attachment, velocity, align }
	humanoid.PlatformStand = true

	local speed = flySpeed()
	flyConnection = RunService.PreRender:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera or not root.Parent or humanoid.Health <= 0 or root.Anchored then
			stopFlying()
			return
		end
		local look = camera.CFrame.LookVector
		local move = humanoid.MoveDirection -- Tastatur, Gamepad und Handy-Stick
		local direction = Vector3.zero
		if move.Magnitude > 0.05 then
			local flatLook = Vector3.new(look.X, 0, look.Z)
			local forwardAmount = if flatLook.Magnitude > 0.01 then move:Dot(flatLook.Unit) else 0
			direction = move + Vector3.new(0, look.Y * math.max(forwardAmount, 0) * 1.5, 0)
		end
		local boost = 1
		if not UserInputService:GetFocusedTextBox() then
			if keyDown(Enum.KeyCode.Space, Enum.KeyCode.ButtonA) then
				direction += Vector3.new(0, 1, 0)
			end
			if keyDown(Enum.KeyCode.LeftControl, Enum.KeyCode.C, Enum.KeyCode.ButtonB) then
				direction -= Vector3.new(0, 1, 0)
			end
			if keyDown(Enum.KeyCode.LeftShift) then
				boost = BOOST
			end
		end
		velocity.VectorVelocity = if direction.Magnitude > 0.01 then direction.Unit * speed * boost else Vector3.zero
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.01 then
			align.CFrame = CFrame.lookAt(Vector3.zero, flat)
		end
	end)

	-- Server erfährt es (Admin-Log); Antwort egal
	local remotes = ctx and ctx.Remotes
	local admin = remotes and remotes.Admin
	if admin and admin:IsA("RemoteFunction") then
		task.spawn(function()
			pcall(function()
				admin:InvokeServer("SetPower", { Name = "CanFly", Value = true })
			end)
		end)
	end
end

function Fly.IsFlying(): boolean
	return flying
end

function Fly.Toggle()
	if flying then
		stopFlying()
		toast(T("admin.flyOff"), "Info")
	elseif player:GetAttribute("CanFly") == true and player:GetAttribute("IsAdmin") == true then
		startFlying()
		if flying then
			toast(T("admin.flyOn"), "Success")
		end
	end
end

local function keyCodes(): { Enum.KeyCode }
	local out: { Enum.KeyCode } = {}
	local keys = ctx and ctx.Config and ctx.Config.Client and ctx.Config.Client.Keys
	local names = if keys and type(keys.Fly) == "table" then keys.Fly else { "G" }
	for _, name in ipairs(names) do
		local ok, code = pcall(function()
			return (Enum.KeyCode :: any)[name]
		end)
		if ok and typeof(code) == "EnumItem" then
			table.insert(out, code :: any)
		end
	end
	return out
end

function Fly.Init(context: any)
	ctx = context
end

function Fly.Start()
	local controls = ctx and ctx.Modules and ctx.Modules.Controls
	local bound = false
	if controls and type(controls.Bind) == "function" then
		bound = pcall(controls.Bind, "Fly", function(state: string)
			if state == "Begin" then
				Fly.Toggle()
			end
		end)
	end
	if not bound then
		local codes = keyCodes()
		UserInputService.InputBegan:Connect(function(input, processed)
			if processed or UserInputService:GetFocusedTextBox() then
				return
			end
			if table.find(codes, input.KeyCode) then
				Fly.Toggle()
			end
		end)
	end
	player.CharacterAdded:Connect(function()
		if flying then
			stopFlying()
		end
	end)
	player:GetAttributeChangedSignal("CanFly"):Connect(function()
		if player:GetAttribute("CanFly") ~= true and flying then
			stopFlying()
		end
	end)
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		-- ins Auto gestiegen: Flug beenden (Sitz-Schweißung + LinearVelocity vertragen sich nicht)
		hooks.On("Vehicle:Enter", function()
			if flying then
				stopFlying()
			end
		end)
	end
end

return Fly
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="140">
            <Properties>
              <string name="Name">Garage</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Garage, Autohaus, Tuning, Enthüllung (Client/Modules/Garage)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §B12.1 (16 Autos, Garage-Plätze, Tuning 24 Lacke · 8 Felgen
--  · 6 Unterboden-Farben · Spoiler, Aktionärs-Rabatt), §A7 #10 (Drehteller-Enthüllung, Fahrt direkt auf den Autobahnring),
--  §C7.3 (Fenster "Garage"), §C7.4 (Effekt "Reveal" {Key} – Besitzer dieses Modul), §C7.5 (Garage.Open), §C9 (CarSpawn,
--  CarDespawn, CarBuy, CarTune), §C10 (State "Garage"), §0 Regel 17 (keine Kauf-Druck-Texte; Pass-Auto nur "Ansehen").
--
--  Fenster: oben eine 3D-Vorschau (ViewportFrame, Kamera kreist über verkettete Tweens – kein eigener Frame-Loop) mit
--  Name, Klasse, Spitze, Preis/Herkunft und Aktionen; darunter Reiter "Meine Autos" / "Autohaus" / "Tuning".
--  Tuning zeigt den Preis vorab (gleiche Formel wie der Server: Config.Vehicles.TunePrice) und färbt die Vorschau live.
--  Enthüllung: Glas-Overlay mit Drehteller-Bühne, "Losfahren" holt das Auto (CarSpawn); Hypercars bekommen danach einen
--  Navi-Strahl zur nächsten Autobahn-Auffahrt (Vehicles.Waypoint).
--
--  Öffentliche API (§C7.5):
--    Garage.Open()            öffnet das Fenster "Garage"
--  Zusätzlich: Garage.Select(key) · Garage.Tick() · Garage.Init(ctx) · Garage.Start()
-- =====================================================================

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))
local VehicleModels = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("VehicleModels")) :: any

local Garage = {}

local player = Players.LocalPlayer
local Theme = UI.Theme

type Preview = {
	Viewport: ViewportFrame,
	Camera: Camera,
	Model: Model?,
	Key: string?,
	Token: number,
	Radius: number,
}

local ctx: any = nil
local VC: any = {}
local window: any = nil
local builtLang: string? = nil
local tab = "Mine"
local pendingTab: string? = nil
local selected: string? = nil
local draft: { [string]: any }? = nil
local draftKey: string? = nil
local lastStateSig = ""

local preview: Preview? = nil
local infoName: TextLabel? = nil
local infoMeta: TextLabel? = nil
local infoPrice: TextLabel? = nil
local infoHint: TextLabel? = nil
local classChipHolder: Frame? = nil
local actionRow: Frame? = nil
local slotsLabel: TextLabel? = nil
local segmented: any = nil
local body: Frame? = nil

local ORBIT_STEPS = 12
local ORBIT_SECONDS = 14
local WINDOW_W, WINDOW_H = 780, 600
local CARD_W, CARD_H = 168, 104

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function reducedFx(): boolean
	local ok, settings = call("Settings", "Get")
	return ok and type(settings) == "table" and settings.ReducedFx == true
end

local function garageState(): { [string]: any }
	local state = ctx.State and ctx.State.Garage
	if type(state) == "table" then
		return state
	end
	return {
		Cars = { LamCity = true },
		Active = "LamCity",
		Tune = {},
		Slots = VC.GarageBase or 6,
		Used = 1,
		Spawned = "",
		Discount = false,
	}
end

local function credits(): number
	local value = ctx.State and ctx.State.Credits
	return if type(value) == "number" then value else 0
end

local function formatCredits(n: number): string
	local ok, text = pcall(ctx.Format.Credits, n, ctx.Lang_())
	return if ok then text .. " " .. T("core.cr") else tostring(n)
end

local function pick(pair: any): string
	if type(pair) ~= "table" then
		return tostring(pair)
	end
	return ctx.Lang.Pick(ctx.Lang_(), pair)
end

local function owns(key: string): boolean
	local cars = garageState().Cars
	return type(cars) == "table" and cars[key] == true
end

local function classColor(class: string): Color3
	local info = VC.ClassInfo and VC.ClassInfo[class]
	return if info and typeof(info.Color) == "Color3" then info.Color else Theme.Accent
end

local function className(class: string): string
	local info = VC.ClassInfo and VC.ClassInfo[class]
	return if info then pick(info.Name) else class
end

local function tuneOf(key: string): { [string]: any }
	local tune = garageState().Tune
	local entry = type(tune) == "table" and tune[key] or nil
	if type(entry) == "table" then
		return table.clone(entry)
	end
	local car = VC.Car(key)
	local recipe = car and VehicleModels.Recipes[car.Recipe] or nil
	return {
		Paint = if car then car.Paint else "Polar",
		Rims = VC.DefaultRims or "Stock",
		Glow = VC.GlowOff or "Off",
		Spoiler = if recipe then recipe.Spoiler == true else false,
	}
end

local function sourceText(car: any): string
	local source = car.Source
	if source == "Login" then
		return T("car.source.Login", car.LoginDay or 0)
	elseif source == "Season" then
		return T("car.source.Season", car.Tier or 0)
	elseif source == "Licence" then
		local progression = ctx.Config.Progression
		local licences = type(progression) == "table" and progression.Licences or nil
		local entry = type(licences) == "table" and licences[car.Licence] or nil
		local name = if type(entry) == "table" and type(entry.Name) == "table"
			then pick(entry.Name)
			else tostring(car.Licence)
		return T("car.source.Licence", name)
	end
	return T("car.source." .. tostring(source))
end

local function priceOf(car: any): (number, number)
	local price = math.floor(car.Price or 0)
	local rule = VC.ShareholderDiscount
	if garageState().Discount == true and car.Maker == "Velocitra" and type(rule) == "table" then
		local saved = math.floor(price * (rule.Pct or 0))
		return price - saved, saved
	end
	return price, 0
end

-- ---------------------------------------------------------------------
-- 1) 3D-VORSCHAU (ViewportFrame + kreisende Kamera aus verketteten Tweens)
-- ---------------------------------------------------------------------
local function orbitCFrame(radius: number, step: number, height: number): CFrame
	local a = (step / ORBIT_STEPS) * 2 * math.pi + math.rad(35)
	local pos = Vector3.new(radius * math.cos(a), height, radius * math.sin(a))
	return CFrame.lookAt(pos, Vector3.new(0, 1.6, 0))
end

local function startOrbit(p: Preview, height: number)
	p.Token += 1
	local token = p.Token
	if reducedFx() then
		p.Camera.CFrame = orbitCFrame(p.Radius, 0, height)
		return
	end
	local step = 0
	p.Camera.CFrame = orbitCFrame(p.Radius, step, height)
	local info = TweenInfo.new(ORBIT_SECONDS / ORBIT_STEPS, Enum.EasingStyle.Linear)
	local function nextStep()
		if p.Token ~= token or not p.Viewport.Parent then
			return
		end
		step = (step + 1) % ORBIT_STEPS
		local tween = TweenService:Create(p.Camera, info, { CFrame = orbitCFrame(p.Radius, step, height) })
		tween.Completed:Once(nextStep)
		tween:Play()
	end
	nextStep()
end

local function stage(viewport: ViewportFrame)
	-- Drehteller-Bühne: dunkler Marmor + Neon-Ring
	local disc = Instance.new("Part")
	disc.Name = "Stage"
	disc.Shape = Enum.PartType.Cylinder
	disc.Anchored = true
	disc.Size = Vector3.new(0.6, 22, 22)
	disc.CFrame = CFrame.new(0, -0.3, 0) * CFrame.Angles(0, 0, math.pi / 2)
	disc.Color = Color3.fromRGB(21, 23, 28)
	disc.Material = Enum.Material.Marble
	disc.Parent = viewport
	local ring = Instance.new("Part")
	ring.Name = "StageRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.Size = Vector3.new(0.1, 22.4, 22.4)
	ring.CFrame = CFrame.new(0, -0.32, 0) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Color = Theme.Cosmic2
	ring.Material = Enum.Material.Neon
	ring.Parent = viewport
end

local function newPreview(parent: Instance, size: UDim2, position: UDim2?): Preview
	local viewport: ViewportFrame = UI.Create("ViewportFrame", {
		Name = "Preview",
		Size = size,
		Position = position or UDim2.new(),
		BackgroundColor3 = Theme.Bg2,
		BackgroundTransparency = 0,
		Ambient = Color3.fromRGB(150, 160, 185),
		LightColor = Color3.fromRGB(255, 248, 236),
		LightDirection = Vector3.new(-0.5, -1, -0.4),
		Parent = parent,
	}, { UI.Corner(12) })
	local camera = Instance.new("Camera")
	camera.FieldOfView = 34
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	stage(viewport)
	return { Viewport = viewport, Camera = camera, Model = nil, Key = nil, Token = 0, Radius = 28 }
end

local function showCar(p: Preview, key: string?, tune: { [string]: any }?)
	if p.Key ~= key then
		if p.Model then
			p.Model:Destroy()
			p.Model = nil
		end
		p.Key = key
		if key and VC.Car(key) then
			local ok, model = pcall(VehicleModels.Build, key)
			if ok and typeof(model) == "Instance" then
				local m = model :: Model
				m:PivotTo(CFrame.identity)
				m.Parent = p.Viewport
				p.Model = m
				local recipe = VehicleModels.Recipes[(VC.Car(key) :: any).Recipe]
				p.Radius = if recipe then math.max(20, recipe.L * 1.75) else 26
				startOrbit(p, if recipe then recipe.L * 0.42 else 6)
			end
		end
	end
	local model = p.Model
	if model and key then
		pcall(VehicleModels.ApplyTune, model, key, tune)
	end
end

-- ---------------------------------------------------------------------
-- 2) FENSTER-INHALT
-- ---------------------------------------------------------------------
local refresh: () -> () = function() end

-- Antwort als Toast zeigen (Server-Texte sind schon lokalisiert)
local function toast(reply: any): { [string]: any }
	if type(reply) ~= "table" then
		return { Ok = false }
	end
	if type(reply.Message) == "string" and reply.Message ~= "" then
		ctx.Toast(reply.Message, if reply.Ok then "Success" else "Error")
	end
	return reply
end

local function clear(frame: Instance)
	for _, child in ipairs(frame:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function setDraft(key: string?)
	draftKey = key
	draft = if key then tuneOf(key) else nil
end

local function selectCar(key: string)
	if not VC.Car(key) then
		return
	end
	selected = key
	setDraft(key)
	refresh()
end

local function buildActions(car: any)
	local row = actionRow
	if not row then
		return
	end
	clear(row)
	local key = car.Key
	local state = garageState()
	if owns(key) then
		if state.Spawned == key then
			UI.Button({
				Text = T("car.despawn"),
				Size = UDim2.fromOffset(150, 38),
				Variant = "Secondary",
				LayoutOrder = 1,
				Parent = row,
			}, function()
				toast(ctx.RequestFull("CarDespawn", {}, true))
			end)
		else
			UI.Button({
				Text = T("car.spawn"),
				Size = UDim2.fromOffset(150, 38),
				Variant = "Primary",
				LayoutOrder = 1,
				Parent = row,
			}, function()
				local reply = toast(ctx.RequestFull("CarSpawn", { Key = key }, true))
				if reply.Ok and window then
					ctx.Windows.Close("Garage")
				end
			end)
		end
		UI.Button({
			Text = T("car.tab.tune"),
			Size = UDim2.fromOffset(120, 38),
			Variant = "Secondary",
			LayoutOrder = 2,
			Parent = row,
		}, function()
			tab = "Tune"
			if segmented then
				segmented.Set("Tune", true)
			end
			refresh()
		end)
	elseif car.Source == "Shop" then
		local price = priceOf(car)
		local full = (state.Used or 0) >= (state.Slots or 6)
		local affordable = credits() >= price
		UI.Button({
			Text = T("car.buy") .. " · " .. formatCredits(price),
			Size = UDim2.fromOffset(196, 38),
			Variant = if affordable and not full then "Primary" else "Muted",
			LayoutOrder = 1,
			Parent = row,
		}, function()
			toast(ctx.RequestFull("CarBuy", { Key = key }, true))
		end)
		if state.Spawned == key and state.Test == true then
			UI.Button({
				Text = T("car.despawn"),
				Size = UDim2.fromOffset(132, 38),
				Variant = "Secondary",
				LayoutOrder = 2,
				Parent = row,
			}, function()
				toast(ctx.RequestFull("CarDespawn", {}, true))
			end)
		else
			-- Probefahrt (nur am Autohaus; der Server prüft Ort und Cooldown)
			UI.Button({
				Text = T("car.testDrive"),
				Size = UDim2.fromOffset(132, 38),
				Variant = "Secondary",
				LayoutOrder = 2,
				Parent = row,
			}, function()
				local reply = toast(ctx.RequestFull("CarSpawn", { Key = key, Test = true }, true))
				if reply.Ok and window then
					ctx.Windows.Close("Garage")
				end
			end)
		end
	elseif car.Source == "Pass" then
		UI.Button({
			Text = T("car.view"),
			Size = UDim2.fromOffset(150, 38),
			Variant = "Secondary",
			LayoutOrder = 1,
			Parent = row,
		}, function()
			ctx.Windows.Close("Garage")
			call("Shop", "Open", if type(car.Pass) == "string" then car.Pass else "Passes") -- direkt die Pass-Details
		end)
	else
		UI.Button({
			Text = sourceText(car),
			Size = UDim2.fromOffset(220, 38),
			Variant = "Muted",
			LayoutOrder = 1,
			Parent = row,
		}, function() end)
	end
end

local function updateInfo()
	local key = selected or garageState().Active or "LamCity"
	local car = VC.Car(key)
	if not car then
		return
	end
	selected = car.Key
	if draftKey ~= car.Key then
		setDraft(car.Key)
	end
	if infoName then
		infoName.Text = pick(car.Name)
	end
	local holder = classChipHolder
	if holder then
		clear(holder)
		UI.Chip(holder, className(car.Class), classColor(car.Class), { LayoutOrder = 1 })
		if car.Maker == "Velocitra" and garageState().Discount == true then
			local pct = math.floor(((VC.ShareholderDiscount and VC.ShareholderDiscount.Pct) or 0) * 100 + 0.5)
			UI.Chip(holder, T("car.discountTag", "−" .. pct .. " %"), Theme.Up, { LayoutOrder = 2 })
		end
		if owns(car.Key) then
			UI.Chip(
				holder,
				if garageState().Spawned == car.Key then T("car.activeTag") else T("car.ownedTag"),
				Theme.Accent,
				{
					LayoutOrder = 3,
				}
			)
		end
	end
	if infoMeta then
		infoMeta.Text = T("car.topSpeed", VC.Cap(car.Key))
	end
	if infoPrice then
		if car.Source == "Shop" and not owns(car.Key) then
			local price, saved = priceOf(car)
			infoPrice.Text = formatCredits(price)
				.. (if saved > 0 then "  (" .. T("car.discountTag", formatCredits(saved)) .. ")" else "")
		else
			infoPrice.Text = sourceText(car)
		end
	end
	if infoHint then
		local rule = VC.ShareholderDiscount
		local company = ctx.Config.Companies
			and ctx.Config.Companies.ById
			and rule
			and ctx.Config.Companies.ById[rule.I]
		if car.Maker == "Velocitra" and rule and company then
			infoHint.Text = T("car.discountHint", rule.Min, company.Ticker, math.floor(rule.Pct * 100 + 0.5) .. " %")
		else
			infoHint.Text = ""
		end
	end
	if slotsLabel then
		local state = garageState()
		slotsLabel.Text = T("car.slots", state.Used or 0, state.Slots or 6)
	end
	buildActions(car)
	if preview then
		showCar(preview, car.Key, draft)
	end
end

-- Hover/Drück-Feedback für Karten-Knöpfe (wie das UI-Kit: Hover heller, Drücken Feder 0,97 in 0,08 s,
-- Loslassen 0,3 s Back Out)
local PRESS_INFO = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local RELEASE_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local HOVER_INFO = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function cardFeedback(card: Frame, hit: TextButton)
	local scale: UIScale = UI.Create("UIScale", { Scale = 1, Parent = card })
	local base = card.BackgroundColor3
	hit.MouseEnter:Connect(function()
		TweenService:Create(card, HOVER_INFO, { BackgroundColor3 = Theme.Hover }):Play()
	end)
	hit.MouseLeave:Connect(function()
		TweenService:Create(card, HOVER_INFO, { BackgroundColor3 = base }):Play()
		TweenService:Create(scale, RELEASE_INFO, { Scale = 1 }):Play()
	end)
	hit.MouseButton1Down:Connect(function()
		TweenService:Create(scale, PRESS_INFO, { Scale = 0.97 }):Play()
	end)
	hit.MouseButton1Up:Connect(function()
		TweenService:Create(scale, RELEASE_INFO, { Scale = 1 }):Play()
	end)
end

local function carCard(parent: Instance, car: any, order: number)
	local isSelected = car.Key == selected
	local card = UI.Card({ Name = car.Key, LayoutOrder = order, Parent = parent })
	local stroke = card:FindFirstChildWhichIsA("UIStroke")
	if stroke and isSelected then
		stroke.Color = Theme.Accent
		stroke.Thickness = 2
	end
	UI.Label({
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.new(1, -20, 0, 20),
		Text = pick(car.Name),
		Face = "BodyBold",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 16,
		Parent = card,
	})
	local chipRow = UI.Create("Frame", {
		Position = UDim2.fromOffset(10, 32),
		Size = UDim2.new(1, -20, 0, 22),
		BackgroundTransparency = 1,
		Parent = card,
	}, { UI.Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }) })
	UI.Chip(chipRow, className(car.Class), classColor(car.Class))
	UI.Label({
		Position = UDim2.fromOffset(10, 58),
		Size = UDim2.new(1, -20, 0, 16),
		Text = T("car.topSpeed", VC.Cap(car.Key)),
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 13,
		Parent = card,
	})
	local status: string
	local color = Theme.Muted
	if garageState().Spawned == car.Key and garageState().Test == true then
		status, color = T("car.testDrive"), Theme.Cosmic2
	elseif garageState().Spawned == car.Key then
		status, color = T("car.activeTag"), Theme.Accent
	elseif owns(car.Key) then
		status, color = T("car.ownedTag"), Theme.Up
	elseif car.Source == "Shop" then
		status, color = formatCredits((priceOf(car))), Theme.Text
	else
		status = sourceText(car)
	end
	UI.Label({
		Position = UDim2.fromOffset(10, 78),
		Size = UDim2.new(1, -20, 0, 18),
		Text = status,
		Face = "MonoBold",
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 14,
		Parent = card,
	})
	local hit: TextButton = UI.Create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 5,
		Parent = card,
	})
	cardFeedback(card, hit)
	hit.Activated:Connect(function()
		call("Sfx", "Play", "UIClick")
		selectCar(car.Key)
	end)
end

local function buildCarList(parent: Frame, mineOnly: boolean)
	local grid = UI.Grid(parent, 2, CARD_W, CARD_H)
	local order = 0
	for _, car in ipairs(VC.Cars or {}) do
		local mine = owns(car.Key)
		if (mineOnly and mine) or (not mineOnly and not mine) then
			order += 1
			carCard(grid, car, order)
		end
	end
	if order == 0 then
		UI.Label({
			Size = UDim2.new(1, 0, 0, 44),
			Text = if mineOnly then T("car.none") else T("car.allOwned"),
			TextWrapped = true,
			TextColor3 = Theme.Muted,
			MaxText = 15,
			LayoutOrder = 1,
			Parent = parent,
		})
	end
end

-- Tuning-Reiter
local function optionButton(
	parent: Instance,
	order: number,
	text: string,
	color: Color3,
	on: boolean,
	locked: string?,
	onClick: () -> ()
)
	local holder = UI.Card({ Size = UDim2.fromOffset(110, 40), LayoutOrder = order, Parent = parent })
	local stroke = holder:FindFirstChildWhichIsA("UIStroke")
	if stroke and on then
		stroke.Color = Theme.Accent
		stroke.Thickness = 2
	end
	UI.Create("Frame", {
		Position = UDim2.new(0, 8, 0.5, -9),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = holder,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.Stroke(nil, 1) })
	UI.Label({
		Position = UDim2.fromOffset(32, 4),
		Size = UDim2.new(1, -38, 1, -8),
		Text = if locked then locked .. " · " .. text else text,
		TextColor3 = if locked then Theme.Warn else Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 12,
		Parent = holder,
	})
	local hit: TextButton = UI.Create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 5,
		Parent = holder,
	})
	cardFeedback(holder, hit)
	hit.Activated:Connect(function()
		call("Sfx", "Play", "UIClick")
		onClick()
	end)
end

local function tunePrice(key: string, current: { [string]: any }, want: { [string]: any }): number
	local total = 0
	if want.Paint ~= current.Paint then
		total += VC.TunePrice(key, "Paint", want.Paint)
	end
	if want.Rims ~= current.Rims then
		total += VC.TunePrice(key, "Rims", want.Rims)
	end
	if want.Glow ~= current.Glow then
		total += VC.TunePrice(key, "Glow", want.Glow)
	end
	if want.Spoiler ~= current.Spoiler and want.Spoiler == true then
		total += VC.TunePrice(key, "Spoiler", nil)
	end
	return total
end

local function buildTune(parent: Frame)
	local key = selected
	local car = key and VC.Car(key) or nil
	if not car or not owns(car.Key) or not draft then
		UI.Label({
			Size = UDim2.new(1, 0, 0, 30),
			Text = T("car.pickCar"),
			TextColor3 = Theme.Muted,
			MaxText = 15,
			LayoutOrder = 1,
			Parent = parent,
		})
		return
	end
	local d = draft :: { [string]: any }
	local current = tuneOf(car.Key)
	local vip = player:GetAttribute("Vip") == true
	local club = player:GetAttribute("Club") == true
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	UI.Section(parent, T("car.tuneFor", pick(car.Name)), nextOrder(), Theme.Purple)
	UI.Section(parent, T("car.paint"), nextOrder(), Theme.Accent)
	local paints = UI.Grid(parent, nextOrder(), 110, 40)
	for i, paint in ipairs(VC.Paints or {}) do
		local locked: string? = nil
		if paint.Unlock == "Pass" and not vip then
			locked = T("car.vipTag")
		elseif paint.Unlock == "Club" and not club then
			locked = T("car.clubTag")
		end
		local label = pick(paint.Name) .. (if paint.Metallic then " ✦" else "")
		optionButton(paints, i, label, paint.Color, d.Paint == paint.Key, locked, function()
			if locked then
				ctx.Toast(if paint.Unlock == "Club" then T("car.tuneClub") else T("car.tuneVip"), "Info")
				return
			end
			d.Paint = paint.Key
			refresh()
		end)
	end
	UI.Section(parent, T("car.rims"), nextOrder(), Theme.Accent)
	local rims = UI.Grid(parent, nextOrder(), 110, 40)
	for i, rim in ipairs(VC.Rims or {}) do
		optionButton(rims, i, pick(rim.Name), rim.Color, d.Rims == rim.Key, nil, function()
			d.Rims = rim.Key
			refresh()
		end)
	end
	UI.Section(parent, T("car.glow"), nextOrder(), Theme.Accent)
	local glows = UI.Grid(parent, nextOrder(), 110, 40)
	optionButton(glows, 0, T("car.glowOff"), Theme.Bg2, d.Glow == (VC.GlowOff or "Off"), nil, function()
		d.Glow = VC.GlowOff or "Off"
		refresh()
	end)
	for i, glow in ipairs(VC.Glow or {}) do
		optionButton(glows, i, pick(glow.Name), glow.Color, d.Glow == glow.Key, nil, function()
			d.Glow = glow.Key
			refresh()
		end)
	end
	UI.Section(parent, T("car.spoiler"), nextOrder(), Theme.Accent)
	local spoilers = UI.Grid(parent, nextOrder(), 150, 40)
	optionButton(spoilers, 1, T("car.spoilerOn"), Theme.Text2, d.Spoiler == true, nil, function()
		d.Spoiler = true
		refresh()
	end)
	optionButton(spoilers, 2, T("car.spoilerOff"), Theme.Bg2, d.Spoiler ~= true, nil, function()
		d.Spoiler = false
		refresh()
	end)
	local price = tunePrice(car.Key, current, d)
	local changed = d.Paint ~= current.Paint
		or d.Rims ~= current.Rims
		or d.Glow ~= current.Glow
		or d.Spoiler ~= current.Spoiler
	local row = UI.Row(parent, nextOrder(), 46)
	UI.Button({
		Text = if price > 0 then T("car.apply", formatCredits(price)) else T("car.applyFree"),
		Size = UDim2.fromOffset(280, 40),
		Variant = if changed and credits() >= price then "Primary" else "Muted",
		LayoutOrder = 1,
		Parent = row,
	}, function()
		if not changed then
			ctx.Toast(T("car.tuneNothing"), "Info")
			return
		end
		local arg: { [string]: any } = { Key = car.Key }
		if d.Paint ~= current.Paint then
			arg.Paint = d.Paint
		end
		if d.Rims ~= current.Rims then
			arg.Rims = d.Rims
		end
		if d.Glow ~= current.Glow then
			arg.Glow = d.Glow
		end
		if d.Spoiler ~= current.Spoiler then
			arg.Spoiler = d.Spoiler
		end
		toast(ctx.RequestFull("CarTune", arg, true))
	end)
end

local function buildBody()
	local frame = body
	if not frame then
		return
	end
	clear(frame)
	if tab == "Tune" then
		buildTune(frame)
	else
		buildCarList(frame, tab == "Mine")
	end
end

local function buildWindow()
	local win = window
	if not win then
		return
	end
	local content = win.Content
	clear(content)
	builtLang = ctx.Lang_()
	local top = UI.Card({ Name = "Top", Size = UDim2.new(1, -4, 0, 236), LayoutOrder = 1, Parent = content })
	preview = newPreview(top, UDim2.new(0.52, -12, 1, -16), UDim2.fromOffset(8, 8))
	local info = UI.Create("Frame", {
		Name = "Info",
		Position = UDim2.new(0.52, 4, 0, 10),
		Size = UDim2.new(0.48, -16, 1, -20),
		BackgroundTransparency = 1,
		Parent = top,
	})
	infoName = UI.Label({
		Size = UDim2.new(1, 0, 0, 32),
		Face = "Display",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 26,
		Parent = info,
	})
	classChipHolder = UI.Create("Frame", {
		Position = UDim2.fromOffset(0, 38),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Parent = info,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	infoMeta = UI.Label({
		Position = UDim2.fromOffset(0, 66),
		Size = UDim2.new(1, 0, 0, 20),
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 15,
		Parent = info,
	})
	infoPrice = UI.Label({
		Position = UDim2.fromOffset(0, 90),
		Size = UDim2.new(1, 0, 0, 24),
		Face = "MonoBold",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 18,
		Parent = info,
	})
	infoHint = UI.Label({
		Position = UDim2.fromOffset(0, 118),
		Size = UDim2.new(1, 0, 0, 30),
		TextColor3 = Theme.Muted,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 12,
		Parent = info,
	})
	actionRow = UI.Create("Frame", {
		Position = UDim2.new(0, 0, 1, -66),
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Parent = info,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	slotsLabel = UI.Label({
		Position = UDim2.new(0, 0, 1, -20),
		Size = UDim2.new(1, 0, 0, 18),
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 13,
		Parent = info,
	})
	local segHolder = UI.Create(
		"Frame",
		{ Size = UDim2.new(1, -4, 0, 36), BackgroundTransparency = 1, LayoutOrder = 2, Parent = content }
	)
	segmented = UI.Segmented(segHolder, {
		{ Key = "Mine", Text = T("car.tab.mine") },
		{ Key = "Dealer", Text = T("car.tab.dealer") },
		{ Key = "Tune", Text = T("car.tab.tune") },
	}, function(key: string)
		tab = key
		refresh()
	end)
	segmented.Set(tab, true)
	body = UI.Create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, -4, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = content,
	}, { UI.Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
end

refresh = function()
	local win = window
	if not win or not win.IsOpen then
		return
	end
	if builtLang ~= ctx.Lang_() then
		buildWindow()
	end
	updateInfo()
	buildBody()
end

local function stateSignature(): string
	local state = garageState()
	local parts = {
		tostring(state.Spawned),
		tostring(state.Test),
		tostring(state.Used),
		tostring(state.Slots),
		tostring(state.Discount),
		tostring(state.Active),
	}
	local keys = {}
	for key in pairs(state.Cars or {}) do
		table.insert(keys, key)
	end
	table.sort(keys)
	table.insert(parts, table.concat(keys, ","))
	local tune = state.Tune or {}
	for _, key in ipairs(keys) do
		local entry = tune[key]
		if type(entry) == "table" then
			table.insert(
				parts,
				("%s:%s:%s:%s"):format(
					tostring(entry.Paint),
					tostring(entry.Rims),
					tostring(entry.Glow),
					tostring(entry.Spoiler)
				)
			)
		end
	end
	return table.concat(parts, "|")
end

local function openWindow()
	if not window then
		window = UI.Window(T("car.title"), WINDOW_W, WINDOW_H, Theme.Purple)
		buildWindow()
	end
	if pendingTab then
		tab = pendingTab
		pendingTab = nil
	end
	if segmented then
		segmented.Set(tab, true)
	end
	if not selected then
		selected = garageState().Active or "LamCity"
	end
	setDraft(selected)
	UI.OpenWindow(window)
	lastStateSig = stateSignature()
	refresh()
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
end

-- ---------------------------------------------------------------------
-- 3) ENTHÜLLUNG (Effekt "Reveal" {Key})
-- ---------------------------------------------------------------------
local revealGui: ScreenGui? = nil

local function nearestRamp(): Vector3?
	local city = ctx.Config.City
	local roads = city and city.Roads
	if type(roads) ~= "table" or type(roads.Highway) ~= "table" then
		return nil
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local origin = if root and root:IsA("BasePart") then root.Position else Vector3.zero
	local best: Vector3? = nil
	local bestDist = math.huge
	local r = roads.Outer.Radius + roads.Outer.Width / 2 + 20
	for _, deg in ipairs(roads.Highway.Ramps or {}) do
		local a = math.rad(deg)
		local pos = Vector3.new(r * math.cos(a), city.Levels.Road, r * math.sin(a))
		local d = (pos - origin).Magnitude
		if d < bestDist then
			best, bestDist = pos, d
		end
	end
	return best
end

local function closeReveal()
	local gui = revealGui
	revealGui = nil
	if gui then
		gui:Destroy()
	end
end

local function playReveal(_strength: number, data: any)
	local key = type(data) == "table" and data.Key or nil
	local car = if type(key) == "string" then VC.Car(key) else nil
	if not car then
		return
	end
	closeReveal()
	local gui = Instance.new("ScreenGui")
	gui.Name = "AkytexTycoonReveal"
	gui.DisplayOrder = 40
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	local shade: Frame = UI.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Space,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = gui,
	})
	local panel: Frame = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 10),
		Size = UDim2.fromScale(0.62, 0.7),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		Parent = shade,
	}, {
		UI.Corner(16),
		UI.Stroke(Theme.Cosmic2, 1),
		UI.Create("UISizeConstraint", { MinSize = Vector2.new(320, 300), MaxSize = Vector2.new(900, 640) }),
	})
	local scale: UIScale = UI.Create("UIScale", { Scale = 0.96, Parent = panel })
	UI.Label({
		Position = UDim2.fromScale(0.05, 0.04),
		Size = UDim2.fromScale(0.9, 0.07),
		Text = T("car.reveal.title"),
		Face = "Display",
		TextColor3 = Theme.Cosmic2,
		MaxText = 20,
		Parent = panel,
	})
	local p = newPreview(panel, UDim2.fromScale(0.9, 0.56), UDim2.fromScale(0.05, 0.13))
	showCar(p, car.Key, tuneOf(car.Key))
	-- Lichtschweif über die Bühne
	local sweep: Frame = UI.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = p.Viewport,
	}, { UI.Corner(12) })
	local gradient: UIGradient = UI.Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.45, 1),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(0.55, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Rotation = 20,
		Offset = Vector2.new(-1, 0),
		Parent = sweep,
	})
	UI.Label({
		Position = UDim2.fromScale(0.05, 0.71),
		Size = UDim2.fromScale(0.9, 0.08),
		Text = pick(car.Name),
		Face = "Display",
		MaxText = 34,
		Parent = panel,
	})
	UI.Label({
		Position = UDim2.fromScale(0.05, 0.79),
		Size = UDim2.fromScale(0.9, 0.05),
		Text = T("car.class", className(car.Class)) .. "  ·  " .. T("car.topSpeed", VC.Cap(car.Key)),
		TextColor3 = classColor(car.Class),
		MaxText = 16,
		Parent = panel,
	})
	local buttons = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.new(0.9, 0, 0, 42),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	UI.Button({
		Text = T("car.reveal.drive"),
		Size = UDim2.fromOffset(190, 42),
		Variant = "Primary",
		LayoutOrder = 1,
		Parent = buttons,
	}, function()
		closeReveal()
		local reply = toast(ctx.RequestFull("CarSpawn", { Key = car.Key }, true))
		if reply.Ok and car.Class == "Hyper" then
			local target = nearestRamp()
			if target then
				call("Vehicles", "Waypoint", target)
				ctx.Toast(T("car.reveal.highway"), "Event")
			end
		end
	end)
	UI.Button({
		Text = T("car.reveal.later"),
		Size = UDim2.fromOffset(150, 42),
		Variant = "Secondary",
		LayoutOrder = 2,
		Parent = buttons,
	}, function()
		closeReveal()
	end)
	gui.Parent = player:WaitForChild("PlayerGui")
	revealGui = gui
	call("Sfx", "Play", "Achievement")
	local fast = reducedFx()
	TweenService:Create(
		shade,
		TweenInfo.new(if fast then 0.05 else 0.26, Enum.EasingStyle.Quint),
		{ BackgroundTransparency = 0.35 }
	):Play()
	TweenService:Create(
		scale,
		TweenInfo.new(if fast then 0.05 else 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Scale = 1 }
	):Play()
	if not fast then
		TweenService
			:Create(gradient, TweenInfo.new(1.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, 0, false, 0.35), {
				Offset = Vector2.new(1, 0),
			})
			:Play()
	end
	task.delay(18, function()
		if revealGui == gui then
			closeReveal()
		end
	end)
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function Garage.Open()
	ctx.Windows.Open("Garage")
end

function Garage.Select(key: string)
	selectCar(key)
end

function Garage.Tick()
	local win = window
	if not win or not win.IsOpen then
		return
	end
	local sig = stateSignature()
	if sig ~= lastStateSig or builtLang ~= ctx.Lang_() then
		lastStateSig = sig
		if draftKey then
			-- gespeicherte Werte übernehmen (z. B. nach erfolgreichem Tuning)
			setDraft(draftKey)
		end
		refresh()
	end
end

function Garage.Init(context: any)
	ctx = context
	VC = ctx.Config.Vehicles or {}
	ctx.Windows.Register("Garage", openWindow, closeWindow)
	local effects = ctx.Modules.Effects
	if effects and type(effects.Register) == "function" then
		effects.Register("Reveal", playReveal)
	end
	ctx.Hooks.On("State", function(_state: any, changed: any)
		if type(changed) == "table" and (changed.Garage or changed.Credits) then
			Garage.Tick()
		end
	end)
	-- Prompts in der Welt: Autohaus öffnet den Reiter "Autohaus", die Lackier-Box "Tuning"
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if who ~= player or prompt:GetAttribute("Window") ~= "Garage" then
			return
		end
		local wanted = prompt:GetAttribute("Tab")
		local nextTab = if wanted == "Tune" then "Tune" else "Dealer"
		if window and window.IsOpen then
			tab = nextTab
			if segmented then
				segmented.Set(tab, true)
			end
			refresh()
		else
			pendingTab = nextTab
		end
	end)
end

function Garage.Start() end

return Garage
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">Highlights</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Zentraler Highlight-Verteiler (Client/Modules/Highlights)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §C7.5, §C16 (Highlights ≤ 31). CC 1:1.
--
--  Roblox zeigt höchstens 31 Highlights gleichzeitig – mehr werden einfach nicht gezeichnet.
--  Darum holt sich JEDES Modul seine Highlights hier ab (Etagen-/Möbel-Auswahl im Tower, Admin-ESP ≤ 20, …).
--  Feste Vorräte: ein Highlight wird nach Release wiederverwendet, nie neu gebaut.
--
--  Öffentliche API:
--    Highlights.Acquire(owner, adornee, props): handle?    nil, wenn das Budget (31) voll ist
--        props { Outline: Color3?, Fill: Color3?, FillTransparency: number?, Depth: Enum.HighlightDepthMode? }
--    Highlights.Update(handle, props)          Farben/Tiefe eines vorhandenen Handles ändern
--    Highlights.Release(handle)                Highlights.ReleaseOwner(owner)
--    Highlights.Count(): number                Highlights.CountOwner(owner): number
--    Highlights.Pulse(owner, seconds)          alle Handles des Owners kurz auf AlwaysOnTop (z. B. "hier klicken")
--    Highlights.Init(ctx) / Highlights.Start()
--  Owner-Grenzen: "AdminESP" ≤ 20. Verschwindet das Ziel (gestreamt/zerstört), wird automatisch freigegeben.
-- =====================================================================

local Highlights = {}

type Props = {
	Outline: Color3?,
	Fill: Color3?,
	FillTransparency: number?,
	Depth: Enum.HighlightDepthMode?,
}

export type Handle = {
	Id: number,
	Owner: string,
	Highlight: Highlight,
	Adornee: Instance,
	Depth: Enum.HighlightDepthMode,
	PulseUntil: number,
	Conn: RBXScriptConnection?,
	Alive: boolean,
}

local DEFAULT_CAP = 31
local OWNER_CAPS: { [string]: number } = { AdminESP = 20 }
local WHITE = Color3.new(1, 1, 1)

local ctx: any = nil
local cap = DEFAULT_CAP
local folder: Folder? = nil
local free: { Highlight } = {}
local created = 0
local active: { [Handle]: boolean } = {}
local activeCount = 0
local ownerCount: { [string]: number } = {}
local nextId = 0
local pulseToken: { [string]: number } = {}

local function getFolder(): Folder
	local current = folder
	if current and current.Parent then
		return current
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = "AkytexTycoonHighlights"
	newFolder.Parent = workspace
	folder = newFolder
	return newFolder
end

local function takeHighlight(): Highlight?
	local highlight = table.remove(free)
	if highlight and highlight.Parent ~= nil then
		return highlight
	end
	-- (zerstört? dann zählt es nicht mehr zum Vorrat)
	if highlight then
		created -= 1
	end
	if created >= cap then
		return nil
	end
	created += 1
	local newHighlight = Instance.new("Highlight")
	newHighlight.Name = "ATHighlight"
	newHighlight.Enabled = false
	newHighlight.Parent = getFolder()
	return newHighlight
end

local function applyProps(handle: Handle, props: Props?)
	local highlight = handle.Highlight
	local p: Props = props or {}
	highlight.OutlineColor = p.Outline or highlight.OutlineColor
	highlight.OutlineTransparency = 0
	highlight.FillColor = p.Fill or (p.Outline or WHITE)
	local fillT = p.FillTransparency
	if type(fillT) == "number" and fillT == fillT then
		highlight.FillTransparency = math.clamp(fillT, 0, 1)
	elseif props then
		highlight.FillTransparency = 1 -- Standard: nur Umriss
	end
	if p.Depth then
		handle.Depth = p.Depth
	end
	highlight.DepthMode = if os.clock() < handle.PulseUntil then Enum.HighlightDepthMode.AlwaysOnTop else handle.Depth
end

function Highlights.Release(handle: any)
	if type(handle) ~= "table" or not active[handle] then
		return
	end
	local h: Handle = handle
	active[h] = nil
	h.Alive = false
	activeCount -= 1
	ownerCount[h.Owner] = math.max(0, (ownerCount[h.Owner] or 1) - 1)
	if h.Conn then
		h.Conn:Disconnect()
		h.Conn = nil
	end
	local highlight = h.Highlight
	if highlight.Parent ~= nil then
		highlight.Enabled = false
		highlight.Adornee = nil
		table.insert(free, highlight)
	else
		created -= 1
	end
end

function Highlights.Acquire(owner: string, adornee: Instance, props: Props?): any?
	if type(owner) ~= "string" or typeof(adornee) ~= "Instance" or not adornee:IsDescendantOf(workspace) then
		return nil
	end
	-- dasselbe Ziel vom selben Owner: vorhandenes Handle wiederverwenden
	for handle in pairs(active) do
		if handle.Owner == owner and handle.Adornee == adornee then
			applyProps(handle, props)
			return handle
		end
	end
	if activeCount >= cap then
		return nil
	end
	local ownerCap = OWNER_CAPS[owner]
	if ownerCap and (ownerCount[owner] or 0) >= ownerCap then
		return nil
	end
	local highlight = takeHighlight()
	if not highlight then
		return nil
	end
	nextId += 1
	local handle: Handle = {
		Id = nextId,
		Owner = owner,
		Highlight = highlight,
		Adornee = adornee,
		Depth = Enum.HighlightDepthMode.Occluded,
		PulseUntil = 0,
		Conn = nil,
		Alive = true,
	}
	active[handle] = true
	activeCount += 1
	ownerCount[owner] = (ownerCount[owner] or 0) + 1
	highlight.Adornee = adornee
	applyProps(handle, props or {})
	highlight.Enabled = true
	-- Ziel verschwindet (Streaming, Tower-Umbau, Character weg): automatisch freigeben
	handle.Conn = adornee.AncestryChanged:Connect(function()
		if not adornee:IsDescendantOf(workspace) then
			Highlights.Release(handle)
		end
	end)
	return handle
end

function Highlights.Update(handle: any, props: Props)
	if type(handle) == "table" and active[handle] and type(props) == "table" then
		applyProps(handle, props)
	end
end

function Highlights.ReleaseOwner(owner: string)
	local list: { Handle } = {}
	for handle in pairs(active) do
		if handle.Owner == owner then
			table.insert(list, handle)
		end
	end
	for _, handle in ipairs(list) do
		Highlights.Release(handle)
	end
end

function Highlights.Count(): number
	return activeCount
end

function Highlights.CountOwner(owner: string): number
	return ownerCount[owner] or 0
end

-- Kurzer Puls: dieselben Handles kurz durch Wände sichtbar, danach zurück zur eigenen Tiefe
function Highlights.Pulse(owner: string, seconds: number)
	if type(owner) ~= "string" or type(seconds) ~= "number" or seconds ~= seconds then
		return
	end
	seconds = math.clamp(seconds, 0.05, 10)
	local untilT = os.clock() + seconds
	for handle in pairs(active) do
		if handle.Owner == owner then
			handle.PulseUntil = untilT
			handle.Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		end
	end
	pulseToken[owner] = (pulseToken[owner] or 0) + 1
	local token = pulseToken[owner]
	task.delay(seconds, function()
		if pulseToken[owner] ~= token then
			return
		end
		for handle in pairs(active) do
			if handle.Owner == owner and os.clock() >= handle.PulseUntil then
				handle.Highlight.DepthMode = handle.Depth
			end
		end
	end)
end

function Highlights.Init(context: any)
	ctx = context
	local config = ctx and ctx.Config
	local value = config and config.Client and config.Client.HighlightCap
	if type(value) == "number" and value >= 1 then
		cap = math.clamp(math.floor(value), 1, DEFAULT_CAP)
	end
	getFolder()
end

function Highlights.Start() end

return Highlights
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="142">
            <Properties>
              <string name="Name">Hooks</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Hooks: kleiner Signal-Hub für alle Client-Module (Client/Modules/Hooks)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §C7.2 (CC 1:1, REUSE §3.18).
--
--  Öffentliche API:
--    Hooks.On(name, fn): () -> ()   anmelden, gibt die Trenn-Funktion zurück
--    Hooks.Once(name, fn)           nur beim nächsten Feuern
--    Hooks.Fire(name, ...)          jeder Listener in pcall (ein Fehler stoppt die anderen nicht)
--    Hooks.Count(name?): number     Anzahl Listener (Debug)
--    Hooks.Init(ctx) / Hooks.Start() (Modul-Form §C7.1, hier ohne Aufgabe)
--
--  Eingefrorene Ereignisse (§C7.2, der Vertrags-Prüfer warnt bei unbekannten):
--    "State"(state, changedKeys) · "Notify"(text, kind) · "Effect:<Name>"(strength, data) ·
--    "WindowOpened"/"WindowClosed"(name) · "Settings"(settings) · "Input"(kind) · "PhotoMode"(on) ·
--    "Quality"(tier) · "Quotes"(frame) · "Market:<Kind>"(data) · "World:<Kind>"(data) · "Replay"(tick, close, phase) ·
--    "Plot:Enter"/"Plot:Leave"(plotId, ownerUserId) · "Tower:Built"/"Tower:Stage"(n) · "Vehicle:Enter"/"Vehicle:Exit"(model?) ·
--    "Terminal:Instrument"(instId)
--  changedKeys bei "State": Liste der Schlüssel UND Set (changed[key] == true) – beides geht.
-- =====================================================================

local Hooks = {}

type Listener = { Fn: (...any) -> (), Once: boolean, Alive: boolean }

local MAX_LISTENERS = 256 -- pro Ereignis; mehr deutet auf ein Leck hin (warn einmal)
local ERROR_LOG_GAP = 10 -- Fehler je Ereignis höchstens alle 10 s loggen

local listeners: { [string]: { Listener } } = {}
local lastErrorAt: { [string]: number } = {}
local warnedFull: { [string]: boolean } = {}

local function add(name: string, fn: (...any) -> (), once: boolean): () -> ()
	if type(name) ~= "string" or type(fn) ~= "function" then
		warn("[Hooks] On/Once: Name (string) und Funktion erwartet")
		return function() end
	end
	local list = listeners[name]
	if not list then
		list = {}
		listeners[name] = list
	end
	if #list >= MAX_LISTENERS and not warnedFull[name] then
		warnedFull[name] = true
		warn(("[Hooks] Sehr viele Listener für %s (%d) – wird irgendwo nie getrennt?"):format(name, #list))
	end
	local entry: Listener = { Fn = fn, Once = once, Alive = true }
	table.insert(list, entry)
	return function()
		if not entry.Alive then
			return
		end
		entry.Alive = false
		local current = listeners[name]
		if current then
			local index = table.find(current, entry)
			if index then
				table.remove(current, index)
			end
			if #current == 0 then
				listeners[name] = nil
			end
		end
	end
end

-- Anmelden; Rückgabe trennt wieder ab
function Hooks.On(name: string, fn: (...any) -> ()): () -> ()
	return add(name, fn, false)
end

-- Nur beim nächsten Feuern aufrufen
function Hooks.Once(name: string, fn: (...any) -> ())
	add(name, fn, true)
end

-- Alle Listener aufrufen (Schnappschuss der Liste: An-/Abmelden während Fire ist erlaubt)
function Hooks.Fire(name: string, ...: any)
	local list = listeners[name]
	if not list or #list == 0 then
		return
	end
	local snapshot = table.clone(list)
	for _, entry in ipairs(snapshot) do
		if entry.Alive then
			if entry.Once then
				entry.Alive = false
				local index = table.find(list, entry)
				if index then
					table.remove(list, index)
				end
			end
			local ok, err = pcall(entry.Fn, ...)
			if not ok then
				local now = os.clock()
				if now - (lastErrorAt[name] or -math.huge) >= ERROR_LOG_GAP then
					lastErrorAt[name] = now
					warn(("[Hooks] Fehler in einem Listener von %s: %s"):format(name, tostring(err)))
				end
			end
		end
	end
	if #list == 0 and listeners[name] == list then
		listeners[name] = nil
	end
end

function Hooks.Count(name: string?): number
	if name then
		local list = listeners[name]
		return if list then #list else 0
	end
	local total = 0
	for _, list in pairs(listeners) do
		total += #list
	end
	return total
end

function Hooks.Init(_ctx: any) end

function Hooks.Start() end

return Hooks
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="143">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – HUD (Client/Modules/Hud)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §C7.5, §D WP2 (HUD), §B4.6 (Tresor-Ring),
--  §B5.2 (Multiplikator-Chip + Aufschlüsselung), §B1/§B2 (Pillen), §B7.1 (TRADE). Basis: CC-Hud (REUSE §1.4 ADAPT).
--
--  Aufbau (AKYTEX-Glas, alles über dem einen Root unter ctx.Gui):
--    · Ticker-Leiste oben (Einstellung "TickerBar"): Laufband aller Kurse aus Hook "Quotes" (UI.Ticker)
--    · Pillen oben Mitte: Glocke (immer), Welt-Event, Termine, Boost, ADMIN-ABUSE, Tresor voll – max. 4
--    · Stats-Karte oben links: CR-Zähler (rollt), AKY-Depotwert-Chip, Vermögen; Multiplikator-Chip „x7,4“ ->
--      Aufschlüsselungs-Sheet aus State.Income.Parts (jede Quelle mit Wert, Herkunft und Restzeit)
--    · Tresor-Ring neben der Karte: Füllstand (32 Segmente, zwischen State-Updates mit Income.PerSec hochgerechnet),
--      voll = glüht rot; Tippen = Request "TowerCollect" (Server prüft Abstand ≤ 70 Studs)
--    · großer TRADE-Knopf unten Mitte (öffnet das Terminal)
--    · rechte Knöpfe Tower/Shop/Quests/Akademie/Garage/Social/Bestenlisten/Einstellungen (Admin 99 fügt AdminPanel an)
--    · FPS/Ping/Speicher oben rechts (Einstellung "ShowNet")
--  Tasten T/B/N/J (Controls-Aktionen Terminal/Tower/Shop/Quests) öffnen die Fenster, falls deren Modul die Taste
--  nicht selbst behandelt (Rückfall ohne Doppel-Umschalten).
--
--  Öffentliche API (§C7.5):
--    Hud.AddRightButton(icon, captionKey, color, order, onClick): UI.Button
--                                          Standard-Slots: Tower 10, Shop 20, Quests 30, Academy 40, Garage 50,
--                                          Social 60, Boards 70, Settings 80 – gleiche Order oder gleiches Icon
--                                          übernimmt den Slot (kein doppelter Knopf). Admin = 99 (AdminPanel).
--    Hud.SetVisible(on)
--    Hud.SetPill(key, text?, untilUnix?)   key ∈ Bell, WorldEvent, Earnings, Boost, AdminAbuse, Vault; text nil = weg.
--                                          "%s" im Text = Restzeit (sonst angehängt). Eigene Pillen haben Vorrang
--                                          vor den automatischen des HUD.
--    Hud.CreditsAnchor(): Vector2?          Bildschirmpunkt des CR-Zählers (Ziel für den CR-Flug)
--    Hud.PulseCredits(amount?)
--  Zusätzlich: Hud.RightButton(key): UI.Button? (Badges setzen), Hud.Refresh(state), Hud.Tick(), Hud.Init(ctx), Hud.Start()
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Stats = game:GetService("Stats")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))
local AssetSlot = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AssetSlot"))

local Hud = {}

local Theme = UI.Theme
local player = Players.LocalPlayer
local WHITE = Color3.new(1, 1, 1)

local SQUARE = 82 -- quadratische Menü-Knöpfe (PC/Controller)
local SQUARE_TOUCH = 74
local SQUARE_GAP = 10
local TRADE_W = 300
local TRADE_H = 88
local STATS_W = 304
local STATS_H = 118
local RING_SIZE = 104
local PILL_ORDER = { "AdminAbuse", "Vault", "Boost", "Bell", "WorldEvent", "Earnings" }
local PILL_COLORS: { [string]: Color3 } = {
	AdminAbuse = Theme.Down,
	Vault = Theme.Warn,
	Boost = Theme.Up,
	Bell = Theme.Gold,
	WorldEvent = Theme.Accent,
	Earnings = Theme.Purple,
}
local PILL_KEYS: { [string]: boolean } = {
	Bell = true,
	WorldEvent = true,
	Earnings = true,
	Boost = true,
	AdminAbuse = true,
	Vault = true,
}
-- Standard-Knöpfe rechts: Fenster (frozen Namen §C7.3)
local RIGHT_BUTTONS = {
	{ Key = "Tower", Icon = "🏙️", Caption = "ui.btn.tower", Color = Theme.Accent, Order = 10 },
	{ Key = "Shop", Icon = "🛍️", Caption = "ui.btn.shop", Color = Theme.Warn, Order = 20 },
	{ Key = "Quests", Icon = "📋", Caption = "ui.btn.quests", Color = Theme.Up, Order = 30 },
	{ Key = "Academy", Icon = "🎓", Caption = "ui.btn.academy", Color = Theme.Cyan, Order = 40 },
	{ Key = "Garage", Icon = "🚗", Caption = "ui.btn.garage", Color = Theme.Purple, Order = 50 },
	{ Key = "Social", Icon = "🤝", Caption = "ui.btn.social", Color = Theme.Pink, Order = 60 },
	{ Key = "Boards", Icon = "🏆", Caption = "ui.btn.boards", Color = Theme.Gold, Order = 70 },
	{ Key = "Settings", Icon = "⚙️", Caption = "ui.btn.settings", Color = Theme.Muted, Order = 80 },
}
-- Controls-Aktion -> Fenster (Rückfall-Tasten)
local HOTKEY_WINDOWS = { Terminal = "Terminal", Tower = "Tower", Shop = "Shop", Quests = "Quests" }
-- Multiplikator-Gruppen in Anzeigereihenfolge (Types.MultPart.Group)
local MULT_GROUPS = { "Perm", "Trader", "Pass", "Fixed", "Timed" }
local SOURCE_COLORS: { [string]: Color3 } = {
	Earned = Theme.Accent,
	Skill = Theme.Up,
	Bought = Theme.Warn,
	Event = Theme.Purple,
}
local RING_PULSE_INFO = TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)

type Pill = { Text: string, Until: number? }
type DefaultSlot = { Order: number, Icon: string, Button: UI.Button, Adopted: boolean, Handler: () -> () }
type PillUi = { Frame: Frame, Dot: Frame, Label: TextLabel }

local ctx: any = nil
local root: Frame? = nil
local tickerBar: Frame? = nil
local ticker: UI.Ticker? = nil
local pillHolder: Frame? = nil
local stats: Frame? = nil
local rightBar: Frame? = nil
local rightGrid: UIGridLayout? = nil
local tradeButton: UI.Button? = nil
local netLabel: TextLabel? = nil
local crLabel: TextLabel? = nil
local crScale: UIScale? = nil
local crCounter: UI.Counter? = nil
local akyCounter: UI.Counter? = nil
local wealthLabel: TextLabel? = nil
local multButton: TextButton? = nil
local multLabel: TextLabel? = nil
local multScale: UIScale? = nil
local vaultFrame: Frame? = nil
local vaultTicks: { Frame } = {}
local vaultCounter: UI.Counter? = nil
local vaultCaption: TextLabel? = nil
local vaultGlow: UIStroke? = nil
local vaultPulse: Tween? = nil

local forcedVisible = true
local rightButtons: { { Button: UI.Button, Key: string, Caption: string } } = {}
local rightByKey: { [string]: UI.Button } = {}
local defaultSlots: { DefaultSlot } = {}
local usedOrders: { [number]: boolean } = {}
local manualPills: { [string]: Pill? } = {}
local autoPills: { [string]: Pill? } = {}
local pillUi: { [string]: PillUi } = {}
local lastQuotes: any = nil
local tickerClock = 0
local instrumentCache: { [number]: any } = {}
local instrumentScanned = false
local lastMult = 1
local lastMultPop = 0
local firstCredits = true
local firstNav = true
local vaultBase = 0
local vaultCap = 0
local vaultClock = os.clock()
local vaultShownTicks = -1
local vaultShownColor: Color3? = nil
local vaultFull = false
local boostBase: { [string]: number } = {}
local boostClock = os.clock()
local multSheet: any = nil
local multSheetKey = ""
local multCountdowns: { { Label: TextLabel, Until: number } } = {}
local lastTopOffset = -1

-- ---------------------------------------------------------------------
-- HILFEN
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function lang(): string
	if ctx and type(ctx.Lang_) == "function" then
		local ok, value = pcall(ctx.Lang_)
		if ok and (value == "de" or value == "en") then
			return value
		end
	end
	return "en"
end

local function hasKey(key: string): boolean
	local L = ctx and ctx.Lang
	if L and type(L.Has) == "function" then
		local ok, has = pcall(L.Has, key)
		return ok and has == true
	end
	return false
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function setting(key: string): any
	local module = ctx and ctx.Modules and ctx.Modules.Settings
	if module and type(module.Get) == "function" then
		local ok, settings = pcall(module.Get)
		if ok and type(settings) == "table" then
			return settings[key]
		end
	end
	local config = ctx and ctx.Config
	local defaults = config and config.Client and config.Client.DefaultSettings
	return defaults and defaults[key]
end

local function hudCfg(key: string, fallback: number): number
	local config = ctx and ctx.Config
	local hud = config and config.Client and config.Client.Hud
	local value = hud and hud[key]
	if type(value) == "number" and value == value then
		return value
	end
	return fallback
end

local function moduleCall(name: string, fnName: string, ...: any): (boolean, any, any)
	local module = ctx and ctx.Modules and ctx.Modules[name]
	local fn = module and module[fnName]
	if type(fn) ~= "function" then
		return false, nil, nil
	end
	return pcall(fn, ...)
end

local function formatCall(fnName: string, ...: any): string?
	local format = ctx and ctx.Format
	local fn = format and format[fnName]
	if type(fn) ~= "function" then
		return nil
	end
	local ok, text = pcall(fn, ...)
	if ok and type(text) == "string" then
		return text
	end
	return nil
end

local function fallbackNumber(n: number): string
	local util = ctx and ctx.Util
	if util and type(util.FormatNumber) == "function" then
		local ok, text = pcall(util.FormatNumber, n)
		if ok and type(text) == "string" then
			return text
		end
	end
	return tostring(math.floor(n))
end

-- CR: kurz (1,25 Mio.) oder lang (1.250.000) je Einstellung "NumberStyle"
local function formatCredits(n: number): string
	if setting("NumberStyle") == "long" and math.abs(n) < 9e15 then
		return formatCall("Int", math.floor(n + 0.5), lang()) or fallbackNumber(n)
	end
	return formatCall("Credits", math.floor(n + 0.5), lang()) or fallbackNumber(n)
end

local function formatAky(cents: number): string
	return formatCall("Aky", math.floor(cents + 0.5), lang(), true) or (fallbackNumber(cents / 100) .. " AKY")
end

local function formatMult(x: number): string
	return formatCall("Mult", x, lang()) or ("x" .. UI.FormatMult(x))
end

local function formatDuration(seconds: number): string
	return formatCall("Duration", math.max(0, seconds), lang())
		or string.format("%d:%02d", math.floor(math.max(0, seconds) / 60), math.floor(math.max(0, seconds)) % 60)
end

-- additiver Anteil "+0,1" (Perm-Gruppe)
local function formatAdd(v: number): string
	local text = formatCall("Mult", math.abs(v), lang()) or UI.FormatMult(math.abs(v))
	text = string.gsub(text, "^x", "")
	return (if v < 0 then "-" else "+") .. text
end

local function inputKind(): string
	local ok, kind = moduleCall("Controls", "Input")
	if ok and type(kind) == "string" then
		return kind
	end
	return "KBM"
end

-- ---------------------------------------------------------------------
-- RECHTE KNÖPFE
-- ---------------------------------------------------------------------
-- Quadratischer Knopf (AKYTEX): Sekundär-Fläche, Emoji oben, kurzes Wort in GROSSBUCHSTABEN darunter,
-- unten ein feiner Streifen in der Farbe des Bereichs (Akzent, keine Vollfläche)
local function squareButton(
	parent: Instance,
	icon: string,
	caption: string,
	color: Color3,
	order: number,
	onClick: () -> ()
): UI.Button
	local button = UI.Button({
		Size = UDim2.fromOffset(SQUARE, SQUARE),
		Text = icon,
		Sub = UI.Upper(caption),
		Variant = "Secondary",
		LayoutOrder = order,
		MaxText = 32,
		SubMax = 12,
		Corner = 12,
		Parent = parent,
	}, onClick)
	UI.Create("Frame", {
		Name = "Accent",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -5),
		Size = UDim2.new(0, 22, 0, 3),
		BackgroundColor3 = if typeof(color) == "Color3" then color else Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = button.Button.ZIndex + 1,
		Parent = button.Button,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	return button
end

-- Hybrid-Platz (§C14.3): eigenes Bild statt Emoji, wenn Config.Client.Icons[key] ≠ 0 gesetzt ist und lädt;
-- Ladefehler -> Emoji/Text kommt automatisch zurück
local function applyIcon(button: UI.Button, key: string, beside: boolean?)
	local config = ctx and ctx.Config
	local icons = config and config.Client and config.Client.Icons
	local id = if type(icons) == "table" then icons[key] else nil
	local url = AssetSlot.Image(if type(id) == "number" then id else nil, "")
	if url == "" then
		return
	end
	local label = button.Label
	local image: ImageLabel = UI.Create("ImageLabel", {
		Name = "IconImage",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = if beside then UDim2.new(0, 34, 0.5, 0) else UDim2.fromScale(0.5, 0.36),
		Size = if beside then UDim2.fromOffset(40, 40) else UDim2.fromScale(0.46, 0.46),
		BackgroundTransparency = 1,
		Image = url,
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = label.ZIndex,
		Parent = button.Button,
	}, { UI.Create("UIAspectRatioConstraint", { AspectRatio = 1 }) })
	local oldText = label.Text
	if not beside then
		label.TextTransparency = 1 -- Emoji ausblenden, solange das Bild steht
	end
	task.spawn(AssetSlot.Verify, { url }, function()
		image:Destroy()
		label.TextTransparency = 0
		if label.Text == "" then
			label.Text = oldText
		end
	end)
end

-- Standard-Slot übernehmen: gleiche Order oder gleiches Icon wie ein Standard-Knopf -> kein zweiter Knopf
local function adoptSlot(icon: string, key: string, color: Color3, order: number, onClick: () -> ()): UI.Button?
	for _, slot in ipairs(defaultSlots) do
		if not slot.Adopted and (slot.Order == order or slot.Icon == icon) then
			slot.Adopted = true
			slot.Handler = onClick
			slot.Button.SetText(icon)
			slot.Button.SetSub(UI.Upper(T(key)))
			local accent = slot.Button.Button:FindFirstChild("Accent")
			if accent and accent:IsA("Frame") and typeof(color) == "Color3" then
				accent.BackgroundColor3 = color
			end
			for _, entry in ipairs(rightButtons) do
				if entry.Button == slot.Button then
					entry.Caption = key
					entry.Key = key
				end
			end
			return slot.Button
		end
	end
	return nil
end

function Hud.AddRightButton(
	icon: string,
	captionKey: string,
	color: Color3,
	order: number,
	onClick: () -> ()
): UI.Button
	local bar = rightBar
	assert(bar, "Hud.Init zuerst aufrufen")
	local key = if type(captionKey) == "string" then captionKey else ""
	local wanted = if type(order) == "number" then math.floor(order) else 50
	local adopted = adoptSlot(tostring(icon), key, color, wanted, onClick)
	if adopted then
		return adopted
	end
	-- eindeutige LayoutOrder (gleiche Nummer -> dahinter einsortieren)
	local layoutOrder = wanted
	local guard = 0
	while usedOrders[layoutOrder] and guard < 1000 do
		layoutOrder += 1
		guard += 1
	end
	usedOrders[layoutOrder] = true
	local button = squareButton(bar, tostring(icon), T(key), color, layoutOrder, function()
		local ok, err = pcall(onClick)
		if not ok then
			warn("[Hud] Knopf " .. key .. ": " .. tostring(err))
		end
	end)
	table.insert(rightButtons, { Button = button, Key = key, Caption = key })
	return button
end

function Hud.RightButton(key: string): UI.Button?
	return rightByKey[key]
end

local function toggleWindow(name: string)
	local windows = ctx and ctx.Windows
	if windows and type(windows.Toggle) == "function" then
		windows.Toggle(name)
	end
end

local function openTerminal()
	local windows = ctx and ctx.Windows
	if windows and type(windows.IsOpen) == "function" and windows.IsOpen("Terminal") then
		windows.Close("Terminal")
		return
	end
	local ok = moduleCall("Terminal", "Open")
	if not ok and windows then
		windows.Open("Terminal")
	end
end

