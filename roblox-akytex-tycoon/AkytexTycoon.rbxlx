		onPick(key)
	end)
	seg.Frame.Size = UDim2.fromScale(1, 1)
	seg.Set(current)
	return seg
end

local function buildPhone(root: Frame)
	local touch = touchMin()
	buildHeader(root, true)
	-- Instrument-Auswahl (Tippen = Liste, Wischen im Chart = nächster Wert)
	local top =
		frame({ Name = "Top", Position = UDim2.fromOffset(12, 52), Size = UDim2.new(1, -24, 0, 58), Parent = root })
	ui.InstHeader = buildInstHeader(top, true)
	local pick: TextButton = UI.Create("TextButton", {
		Size = UDim2.new(0.5, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = top,
	})
	pick.Activated:Connect(function()
		if ui.Picker then
			ui.Picker.Visible = true
			updateList(ui.PickerList, true)
		end
	end)
	local tabsHolder = frame({ Position = UDim2.fromOffset(12, 114), Size = UDim2.new(1, -24, 0, 40), Parent = root })
	local tabs = UI.Segmented(tabsHolder, {
		{ Key = "Chart", Text = T("term.tab.Chart") },
		{ Key = "Order", Text = T("term.tab.Order") },
		{ Key = "Depot", Text = T("term.tab.Depot") },
		{ Key = "News", Text = T("term.tab.News") },
	}, function(key: string)
		phoneTab = key
		refreshAll()
	end)
	tabs.Frame.Size = UDim2.fromScale(1, 1)
	tabs.Set(phoneTab)
	ui.PhoneTabs = tabs
	local barH = touch + 46
	local content = frame({
		Name = "Content",
		Position = UDim2.fromOffset(12, 160),
		Size = UDim2.new(1, -24, 1, -160 - barH - 8),
		Parent = root,
	})
	ui.PhoneContent = content
	-- Chart-Tab
	local chartTab = frame({ Name = "PTab_Chart", Size = UDim2.fromScale(1, 1), Parent = content })
	ui.Toolbar = buildToolbar(chartTab, true)
	local chartPanel = panel({
		Position = UDim2.fromOffset(0, 106),
		Size = UDim2.new(1, 0, 1, -106),
		Parent = chartTab,
	})
	ui.ChartHost = frame({ Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 1, -12), Parent = chartPanel })
	-- Order-Tab
	local orderTab = frame({ Name = "PTab_Order", Size = UDim2.fromScale(1, 1), Visible = false, Parent = content })
	ui.Ticket = buildTicket(orderTab, false)
	-- Depot-Tab
	local depotTab = frame({ Name = "PTab_Depot", Size = UDim2.fromScale(1, 1), Visible = false, Parent = content })
	local depotContent =
		frame({ Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 1, -40), Parent = depotTab })
	ui.DepotContent = depotContent
	local depotOptions: { any } = {
		{ Key = "Overview", Text = T("term.tab.Overview") },
		{ Key = "Positions", Text = T("term.tab.Positions") },
		{ Key = "Orders", Text = T("term.tab.Orders") },
		{ Key = "Alerts", Text = T("term.tab.Alerts") },
	}
	if num(perks().BotSlots, 0) > 0 then
		table.insert(depotOptions, { Key = "Bots", Text = T("term.tab.Bots") })
	end
	table.insert(depotOptions, { Key = "Performance", Text = T("term.tab.Performance") })
	local depotKeys: { [string]: boolean } = {}
	for _, option in ipairs(depotOptions) do
		depotKeys[option.Key] = true
	end
	if not depotKeys[phoneDepotTab] then
		phoneDepotTab = "Overview"
	end
	phoneSubTabs(depotTab, depotOptions, phoneDepotTab, function(key: string)
		phoneDepotTab = key
		showTab(depotContent, key)
	end)
	showTab(depotContent, phoneDepotTab)
	-- News-Tab (+ Kalender/Analyse)
	local newsTab = frame({ Name = "PTab_News", Size = UDim2.fromScale(1, 1), Visible = false, Parent = content })
	local newsContent = frame({ Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 1, -40), Parent = newsTab })
	ui.NewsContent = newsContent
	local newsOptions: { any } = { { Key = "News", Text = T("term.tab.News") } }
	if licence() >= traderFrom() then
		table.insert(newsOptions, { Key = "Calendar", Text = T("term.tab.Calendar") })
	end
	table.insert(newsOptions, { Key = "Analysis", Text = T("term.tab.Analysis") })
	local newsKeys: { [string]: boolean } = {}
	for _, option in ipairs(newsOptions) do
		newsKeys[option.Key] = true
	end
	if not newsKeys[phoneNewsTab] then
		phoneNewsTab = "News"
	end
	phoneSubTabs(newsTab, newsOptions, phoneNewsTab, function(key: string)
		phoneNewsTab = key
		showTab(newsContent, key)
	end)
	showTab(newsContent, phoneNewsTab)
	-- feste Kauf/Verkauf-Leiste im Daumenbereich (Knöpfe ≥ 64 echte Pixel)
	local bar = frame({
		Name = "TradeBar",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -8),
		Size = UDim2.new(1, -24, 0, barH),
		Parent = root,
	})
	ui.BottomBar = bar
	local preview = text({
		Size = UDim2.new(0.55, 0, 0, 16),
		FontFace = UI.Faces.Mono,
		TextSize = 12,
		TextColor3 = Theme.Text2,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = bar,
	})
	ui.BarPreview = preview
	local chipHolder = frame({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.45, 0, 0, 36),
		Parent = bar,
	})
	local chips = UI.Segmented(chipHolder, {
		{ Key = "10", Text = T("term.chip10") },
		{ Key = "25", Text = T("term.chip25") },
		{ Key = "Max", Text = T("trade.chipMax") },
	}, function(key: string)
		ticket.Chip = key
		ticket.Amount = "Chip"
		refreshAll()
	end)
	chips.Frame.Size = UDim2.fromScale(1, 1)
	ui.BarChips = chips
	ui.BuyButton = UI.Button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(0.5, -5, 0, touch),
		Text = T("trade.buy"),
		Variant = "Success",
		Face = "Display",
		MaxText = 22,
		Parent = bar,
	}, function()
		place("B")
	end)
	ui.SellButton = UI.Button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.new(0.5, -5, 0, touch),
		Text = T("trade.sell"),
		Variant = "Danger",
		Face = "Display",
		MaxText = 22,
		Parent = bar,
	}, function()
		place("S")
	end)
	buildPicker(root)
	local practiceHolder = frame({
		Position = UDim2.fromOffset(12, 52),
		Size = UDim2.new(1, -24, 1, -60),
		ZIndex = 50,
		Parent = root,
	})
	ui.Practice = buildPractice(practiceHolder)
	buildSheet(root)
end

local function updatePhone()
	local content: Frame? = ui.PhoneContent
	if not content then
		return
	end
	for _, child in ipairs(content:GetChildren()) do
		if child:IsA("Frame") then
			child.Visible = child.Name == "PTab_" .. phoneTab
		end
	end
	if ui.PhoneTabs then
		ui.PhoneTabs.Set(phoneTab)
	end
	if ui.BarChips then
		ui.BarChips.Set(ticket.Chip)
	end
	local otype = ticket.Type
	local side = if SELL_ONLY[otype] then "S" else "B"
	local est = estimate(side)
	if ui.BarPreview then
		setText(
			ui.BarPreview,
			if est
					and est.Qty > 0
					and side == "B"
				then T("trade.costPreview", aky(est.Cost, true), aky(est.Fee))
				elseif est and est.Qty > 0 then T("term.proceeds", aky(est.Proceeds, true), aky(est.Fee))
				else ""
		)
	end
	local blocked = sel == nil or (sel ~= nil and (halted(sel) or not allowed(sel)))
	if ui.BuyButton then
		ui.BuyButton.SetVariant(if blocked or SELL_ONLY[otype] then "Muted" else "Success")
		ui.SellButton.SetVariant(if blocked then "Muted" else "Danger")
	end
end

-- ---------------------------------------------------------------------
-- AUSWAHL, KURSE, AKTUALISIEREN
-- ---------------------------------------------------------------------
local function defaultSelection(): number?
	local held = heldIds()
	local best, bestValue = nil, -1
	for _, i in ipairs(held) do
		if allowed(i) then
			local q = position(i)
			local close = quote(i) or 0
			if q * close > bestValue then
				best, bestValue = i, q * close
			end
		end
	end
	if best then
		return best
	end
	if allowed(40) then
		return 40
	end
	local ok, ids = call("MarketClient", "AllowedIds")
	if ok and type(ids) == "table" then
		return ids[1]
	end
	return nil
end

selectInst = function(i: number)
	if type(i) ~= "number" or not instOf(i) then
		return
	end
	local changed = sel ~= i
	sel = i
	if changed then
		table.clear(tape)
		alarmMode = false
		local bid, _, mid = bidAsk(i)
		local protect = trading().Protect or { Sl = 0.08, Tp = 0.15 }
		if bid and mid then
			ticket.Lim = price(mid)
			ticket.Stp = price(math.floor(bid * (1 - num(protect.Sl, 0.08))))
			ticket.Tp = price(math.ceil(bid * (1 + num(protect.Tp, 0.15))))
		end
		ctx.Hooks.Fire("Terminal:Instrument", i)
		if isOpen then
			buildCharts()
		end
	end
	refreshAll()
end

refreshAll = function()
	if not isOpen then
		return
	end
	updateHeader()
	updateInstHeader(ui.InstHeader)
	updateToolbar(ui.Toolbar)
	updateTicket(ui.Ticket)
	updateList(ui.List, false)
	if ui.Picker and ui.Picker.Visible then
		updateList(ui.PickerList, false)
	end
	updatePhone()
	updatePractice(ui.Practice)
	chartMarks()
	if ui.BottomTabs then
		ui.BottomTabs.Set(bottomTab)
	end
end

local function onQuotes(frameData: any)
	if not isOpen then
		return
	end
	-- Kurse in die Charts (Live-Kerze gleitet in ChartView.Step)
	for _, entry in ipairs(views) do
		local okCandle, candle = call("MarketClient", "Candle1s", entry.I)
		if okCandle and type(candle) == "table" then
			entry.View:PushQuote(candle.C, candle.T, candle.H, candle.L, candle.V)
		end
	end
	-- Umsätze (simuliert) des gewählten Werts
	local i = sel
	if i then
		local okCandle, candle = call("MarketClient", "Candle1s", i)
		if okCandle and type(candle) == "table" then
			table.insert(tape, { T = candle.T, C = candle.C, V = candle.V, Up = candle.C >= candle.O })
			while #tape > 12 do
				table.remove(tape, 1)
			end
		end
	end
	local tick = if type(frameData) == "table" then frameData.Tick else 0
	updateHeader()
	updateInstHeader(ui.InstHeader)
	updateTicket(ui.Ticket)
	updateList(ui.List, tick % 5 == 0)
	if ui.Picker and ui.Picker.Visible then
		updateList(ui.PickerList, tick % 5 == 0)
	end
	updatePhone()
end

-- ---------------------------------------------------------------------
-- ÖFFNEN / SCHLIESSEN / NEUAUFBAU
-- ---------------------------------------------------------------------
local function decideLayout(): string
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local kind = inputKind()
	if kind == "Touch" or size.X < PC_MIN.X or size.Y < PC_MIN.Y then
		return "Phone"
	end
	return "PC"
end

local function buildKey(): string
	return table.concat({
		decideLayout(),
		layer(),
		tostring(licence() >= traderFrom()),
		tostring(math.floor(quality("Candles", 90))),
		tostring(areaFill()),
		tostring(num(perks().BotSlots, 0) > 0),
		tostring(perks().MultiChart == true),
		lang(),
	}, "|")
end

local function destroyUi()
	untrackAll()
	if ui.Practice and ui.Practice.View then
		ui.Practice.View:Destroy()
	end
	if ui.Mounts then
		for _, handle in ipairs(ui.Mounts) do
			pcall(handle.Destroy)
		end
	end
	if ui.Band then
		pcall(ui.Band.Destroy)
	end
	if ui.Root then
		ui.Root:Destroy()
	end
	ui = {}
end

rebuild = function()
	local wasVisible = ui.Root ~= nil and ui.Root.Visible
	destroyUi()
	layoutKind = decideLayout()
	builtKey = buildKey()
	local phone = layoutKind == "Phone"
	local root = UI.Create("Frame", {
		Name = "Terminal",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = if phone then UDim2.fromScale(1, 1) else UDim2.fromOffset(1180, 700),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		Visible = wasVisible,
		Active = true,
		ZIndex = 12,
		Parent = ctx.Gui,
	}, {
		UI.Corner(if phone then 0 else 18),
		UI.Stroke(nil, 1),
	})
	ui.Root = root
	ui.Scale = UI.Create("UIScale", { Parent = root })
	if phone then
		buildPhone(root)
	else
		buildPC(root)
	end
	if not sel or not allowed(sel) then
		local i = defaultSelection()
		if i then
			sel = i
		end
	end
	buildCharts()
end

local function bindPad()
	if padBound then
		return
	end
	padBound = true
	ContextActionService:BindActionAtPriority(
		PAD_ACTION,
		function(_, inputState, input)
			if UserInputService:GetFocusedTextBox() then
				return Enum.ContextActionResult.Pass
			end
			local key = input.KeyCode
			if key == Enum.KeyCode.Thumbstick2 then
				stickX = if math.abs(input.Position.X) > 0.5 then math.sign(input.Position.X) else 0
				return Enum.ContextActionResult.Sink
			end
			if inputState ~= Enum.UserInputState.Begin then
				return Enum.ContextActionResult.Sink
			end
			local sheetOpen = ui.Sheet and ui.Sheet.Root.Visible
			if key == Enum.KeyCode.ButtonA then
				if sheetOpen then
					confirmSheet()
				elseif practiceActive() then
					task.spawn(practiceTrade, if practiceBought then "Sell" else "Buy")
				else
					openSheet("B")
				end
			elseif key == Enum.KeyCode.ButtonX then
				if not sheetOpen then
					openSheet("S")
				end
			elseif key == Enum.KeyCode.ButtonY then
				if not sheetOpen then
					protectPosition()
				end
			elseif key == Enum.KeyCode.ButtonB then
				if sheetOpen then
					closeSheet()
				elseif ui.Picker and ui.Picker.Visible then
					ui.Picker.Visible = false
				else
					ctx.Windows.Close("Terminal")
				end
			elseif key == Enum.KeyCode.DPadUp or key == Enum.KeyCode.DPadDown then
				if not sheetOpen then
					swipe(if key == Enum.KeyCode.DPadUp then -1 else 1)
				end
			elseif key == Enum.KeyCode.DPadLeft or key == Enum.KeyCode.DPadRight then
				local dir = if key == Enum.KeyCode.DPadLeft then -1 else 1
				if sheetOpen then
					sheetChip(dir)
				elseif views[1] then
					views[1].View:MoveCrosshair(dir)
				end
			end
			return Enum.ContextActionResult.Sink
		end,
		false,
		PAD_PRIORITY,
		Enum.KeyCode.ButtonA,
		Enum.KeyCode.ButtonX,
		Enum.KeyCode.ButtonY,
		Enum.KeyCode.ButtonB,
		Enum.KeyCode.DPadUp,
		Enum.KeyCode.DPadDown,
		Enum.KeyCode.DPadLeft,
		Enum.KeyCode.DPadRight,
		Enum.KeyCode.Thumbstick2
	)
end

local function unbindPad()
	if not padBound then
		return
	end
	padBound = false
	stickX = 0
	ContextActionService:UnbindAction(PAD_ACTION)
end

local function showRoot()
	if builtKey ~= buildKey() or not ui.Root then
		rebuild()
	end
	local root: Frame = ui.Root
	isOpen = true
	openToken += 1
	root.Visible = true
	local phone = layoutKind == "Phone"
	local rest = UDim2.fromScale(0.5, 0.5)
	if reducedFx() then
		root.Position = rest
		ui.Scale.Scale = 1
	elseif phone then
		root.Position = UDim2.new(0.5, 0, 1.5, 0)
		ui.Scale.Scale = 1
		TweenService:Create(root, SHEET_INFO, { Position = rest }):Play()
	else
		root.Position = UDim2.new(0.5, 0, 0.5, 8)
		ui.Scale.Scale = 0.96
		TweenService:Create(root, OPEN_INFO, { Position = rest }):Play()
		TweenService:Create(ui.Scale, OPEN_INFO, { Scale = 1 }):Play()
	end
	bindPad()
	call("TouchControls", "Show", "Terminal")
	if not sel then
		local i = defaultSelection()
		if i then
			selectInst(i)
		end
	end
	for _, entry in ipairs(views) do
		entry.View:SetVisible(true)
		if entry.Stale then
			-- geschlossen liefen keine Kurse in den Chart: einmal aus der (weiter gepflegten) Reihe nachladen
			entry.Stale = false
			local view = entry.View
			call("MarketClient", "Candles", entry.I, entry.Tf, function(candles)
				if view.Alive and #candles > 0 then
					view:SetData(candles, entry.Tf)
				end
			end)
		end
	end
	refreshAll()
	call("DepotView", "Refresh")
end

local function hideRoot()
	isOpen = false
	for _, entry in ipairs(views) do
		entry.Stale = true -- ab jetzt laufen keine Kurse mehr in die Charts
	end
	unbindPad()
	closeSheet()
	alarmMode = false
	openToken += 1
	local token = openToken
	local root: Frame? = ui.Root
	if not root then
		return
	end
	if ui.Picker then
		ui.Picker.Visible = false
	end
	local function finish()
		if openToken == token and root.Parent then
			root.Visible = false
			for _, entry in ipairs(views) do
				entry.View:SetVisible(false)
			end
		end
	end
	if reducedFx() then
		finish()
		return
	end
	local phone = layoutKind == "Phone"
	local goal = if phone then UDim2.new(0.5, 0, 1.5, 0) else UDim2.new(0.5, 0, 0.5, 8)
	local tween = TweenService:Create(root, CLOSE_INFO, { Position = goal })
	if not phone then
		TweenService:Create(ui.Scale, CLOSE_INFO, { Scale = 0.97 }):Play()
	end
	tween.Completed:Once(finish)
	tween:Play()
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH
-- ---------------------------------------------------------------------
function Terminal.Open()
	ctx.Windows.Open("Terminal")
end

function Terminal.IsOpen(): boolean
	return ctx.Windows.IsOpen("Terminal")
end

function Terminal.OpenAt(instId: number)
	if type(instId) ~= "number" then
		Terminal.Open()
		return
	end
	if not Terminal.IsOpen() then
		Terminal.Open()
	end
	if allowed(instId) then
		selectInst(instId)
	else
		ctx.Toast(T("trade.notLicensed"), "Info")
	end
	if layoutKind == "Phone" then
		phoneTab = "Chart"
		refreshAll()
	end
end

function Terminal.OpenTicket(instId: number, side: string?)
	Terminal.OpenAt(instId)
	if side == "S" then
		ticket.Type = "MKT"
		ticket.Chip = "Max"
		ticket.Amount = "Chip"
	end
	if layoutKind == "Phone" then
		phoneTab = "Order"
	end
	refreshAll()
end

function Terminal.ShowTab(tab: string)
	if layoutKind == "Phone" then
		local depotTabs =
			{ Overview = true, Positions = true, Orders = true, Alerts = true, Bots = true, Performance = true }
		if depotTabs[tab] then
			phoneTab = "Depot"
			phoneDepotTab = tab
			showTab(ui.DepotContent, tab)
		elseif tab == "News" or tab == "Calendar" or tab == "Analysis" then
			phoneTab = "News"
			phoneNewsTab = tab
			showTab(ui.NewsContent, tab)
		elseif tab == "Chart" or tab == "Order" then
			phoneTab = tab
		end
	else
		bottomTab = tab
		showTab(ui.BottomContent, tab)
	end
	refreshAll()
end

-- Übung mit der Übungsaktie ACAD (Tutorial §B2/§B8.6)
function Terminal.OpenPractice()
	practiceWanted = true
	practiceBought = false
	Terminal.Open()
	if depot().Tutorial ~= "Running" then
		task.spawn(function()
			local reply = ctx.RequestFull("TutorialTrade", { Action = "Start" })
			if not reply.Ok then
				practiceWanted = false
			end
			refreshAll()
		end)
	end
	refreshAll()
end

function Terminal.Selected(): number?
	return sel
end

function Terminal.Frame(dt: number)
	if not isOpen then
		return
	end
	for _, entry in ipairs(views) do
		entry.View:Step(dt)
	end
	local pr = ui.Practice
	if pr and pr.View and pr.Root.Visible then
		pr.View:Step(dt)
	end
	if stickX ~= 0 then
		stickClock += dt
		if stickClock >= STICK_REPEAT then
			stickClock = 0
			if views[1] then
				views[1].View:MoveCrosshair(stickX)
			end
		end
	end
	glossClock += dt
	if glossClock >= GLOSS_EVERY then
		glossClock = 0
		glossIndex = (glossIndex % GLOSS_COUNT) + 1
		if ui.Ticket then
			setText(ui.Ticket.Gloss, T("term.gloss." .. tostring(glossIndex)))
		end
	end
	calendarClock += dt
	if calendarClock >= CALENDAR_EVERY then
		calendarClock = 0
		updateCalendar(ui.Calendar)
	end
	analysisClock += dt
	if analysisClock >= ANALYSIS_EVERY then
		analysisClock = 0
		updateAnalysis(ui.Analysis)
		updatePractice(ui.Practice)
		-- Fehlerzustand: lädt die Historie nicht (Markt öffnet gleich, Server-Limit …), die Server-Meldung zeigen
		-- statt endlos „Historie lädt …“ (MarketClient versucht es mit wachsendem Abstand weiter)
		for _, entry in ipairs(views) do
			if entry.View.Alive and entry.View:Count() == 0 then
				local okErr, err = call("MarketClient", "SeriesError", entry.I, entry.Tf)
				if okErr and type(err) == "string" and err ~= "" then
					entry.View:SetPlaceholder(err)
				end
			end
		end
	end
end

function Terminal.Init(context: any)
	ctx = context
	ctx.Windows.Register("Terminal", showRoot, hideRoot)
	local hooks = ctx.Hooks
	hooks.On("Quotes", onQuotes)
	hooks.On("Replay", function()
		if isOpen then
			updatePractice(ui.Practice)
		end
	end)
	hooks.On("State", function(_state, changed)
		if not isOpen or type(changed) ~= "table" then
			return
		end
		if changed.Prog then
			if builtKey ~= buildKey() then
				rebuild()
			end
			if sel and not allowed(sel) then
				local i = defaultSelection()
				if i then
					selectInst(i)
				end
			end
		end
		if changed.Depot or changed.Prog or changed.Market then
			refreshAll()
		end
	end)
	hooks.On("Settings", function()
		if not isOpen then
			return
		end
		if builtKey ~= buildKey() then
			rebuild()
			refreshAll()
			return
		end
		local style = currentStyle()
		local indicators = indicatorMap()
		local needReload = false
		for index, entry in ipairs(views) do
			entry.View:SetStyle(style)
			entry.View:SetIndicators(if index == 1 then indicators else {})
			entry.View:Repaint()
			if index == 1 and entry.Tf ~= currentTf() then
				needReload = true
			end
		end
		if needReload then
			-- Zeitrahmen gewechselt: dieselben gepoolten Charts behalten, nur die Reihe neu verfolgen (kein Neuaufbau
			-- von ~900 Frames je Chart -> der Wechsel bleibt flüssig, Historie kommt aus dem MarketClient-Cache)
			local tf = currentTf()
			for _, entry in ipairs(views) do
				local want = if entry.Role == "Second" then (if tf == "1T" then "15m" else "1T") else tf
				if entry.Tf ~= want then
					entry.Tf = want
					entry.Stale = false
					trackView(entry)
				end
			end
			chartMarks()
		end
		refreshAll()
	end)
	hooks.On("Quality", function()
		if isOpen and builtKey ~= buildKey() then
			rebuild()
			refreshAll()
		end
	end)
	hooks.On("Input", function()
		if isOpen and decideLayout() ~= layoutKind then
			rebuild()
			refreshAll()
		end
	end)
	hooks.On("Market:News", function()
		if isOpen then
			updateTicket(ui.Ticket)
		end
	end)
	-- Tasten: 1–7 Zeitrahmen, LB/RB Zeitrahmen weiter, C/Select Chart-Typ (Controls, Kontext "Terminal")
	local ALL_KEYS: { [Enum.KeyCode]: number } = {
		[Enum.KeyCode.One] = 1,
		[Enum.KeyCode.Two] = 2,
		[Enum.KeyCode.Three] = 3,
		[Enum.KeyCode.Four] = 4,
		[Enum.KeyCode.Five] = 5,
		[Enum.KeyCode.Six] = 6,
		[Enum.KeyCode.Seven] = 7,
	}
	call("Controls", "Bind", "ChartTf", function(inputState: string, input: InputObject?)
		if inputState ~= "Begin" or not isOpen then
			return
		end
		local list = allowedTfs()
		local current = table.find(list, currentTf()) or 1
		local target: string? = nil
		if input then
			local index = ALL_KEYS[input.KeyCode]
			if index then
				local wanted = ALL_TF[index]
				if table.find(list, wanted) then
					target = wanted
				else
					ctx.Toast(T("term.tf.locked", T("term.lic.4")), "Info")
					return
				end
			elseif input.KeyCode == Enum.KeyCode.ButtonL1 then
				target = list[math.max(1, current - 1)]
			elseif input.KeyCode == Enum.KeyCode.ButtonR1 then
				target = list[math.min(#list, current + 1)]
			end
		end
		if target and target ~= currentTf() then
			call("Settings", "Set", "ChartTf", target)
		end
	end)
	call("Controls", "Bind", "ChartType", function(inputState: string)
		if inputState ~= "Begin" or not isOpen then
			return
		end
		local list = allowedStyles()
		local index = table.find(list, currentStyle()) or 1
		call("Settings", "Set", "ChartType", list[(index % #list) + 1])
	end)
end

function Terminal.Start()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if isOpen and decideLayout() ~= layoutKind then
				rebuild()
				refreshAll()
			end
		end)
	end
end

return Terminal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="157">
            <Properties>
              <string name="Name">Ticker</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Ticker-Wände in der Stadt + Laufband-Bausteine (Client/Modules/Ticker)
--  Besitzer: WP5 (Charts, Terminal, Markt-UI). Vertrag: DESIGN.md §B7.5 (Ticker-Wände/Laufband), §A5 (4 Ticker-Wände
--  auf der Plaza je 64×8, 360°-LED-Tickerring im Börsensaal), §A7 #3 (Lichtwelle bei der Glocke), §B15.3 (Ticker-Wände
--  „HANDELSPAUSE“), §A4 (Crash: Ticker-Wände rot).
--
--  Wände: Client-SurfaceGuis (Adornee = Server-Part mit Attribut Monitor = "Ticker" | "TickerRing", optional
--  Attribut "Face" = Enum.NormalId-Name), gefunden vom Modul Monitors (ein Welt-Scan für alle Monitor-Arten) ->
--  Ticker.AddWall/RemoveWall. Je Wand gepoolte RichText-Labels in einem Container; je Frame wird nur der Container
--  verschoben, der erste Eintrag wandert ans Ende (O(1)), Geschwindigkeit = Bandbreite / 120 s (Website-Schleife).
--  Gespeist aus dem Frame (0 extra Netz), Texte 1×/s. Entfernte Wände (> Sichtweite) laufen nicht.
--  Die HUD-Ticker-Leiste oben baut Hud (WP2) mit UI.Ticker; dieses Modul liefert dafür nur die Zeilen (Ticker.Rows)
--  und ein Mini-Laufband für den Terminal-Kopf (Ticker.Attach).
--
--  Öffentliche API (WP5-intern, §C7.5-Ergänzung):
--    Ticker.Rows(): { { Ticker, Price, Change? } }     alle gelisteten Werte (ohne Übungsaktie)
--    Ticker.Attach(parent): { Frame, Destroy }          Laufband (UI.Ticker), wird 1×/s mitgefüttert
--    Ticker.AddWall(part) · Ticker.RemoveWall(part)      (Monitors)
--    Ticker.Wave(color?)                                  Lichtwelle über alle Wände (Glocke)
--    Ticker.SetTint(color?)                               feste Tönung (WorldLook); nil = automatisch (Crash/Rallye)
--    Ticker.Frame(dt), Ticker.Init(ctx), Ticker.Start()
-- =====================================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local Ticker = {}

type Wall = {
	Part: BasePart,
	Gui: SurfaceGui,
	Clip: Frame,
	Track: Frame,
	Labels: { TextLabel },
	Count: number,
	Offset: number,
	NextOrder: number,
	Head: number, -- Index des vordersten Eintrags (wandert im Kreis -> O(1) je Frame)
	TextSize: number,
	Gap: number,
	Tint: Frame,
	Halt: TextLabel,
	Wave: UIGradient,
	WaveFrame: Frame,
	Near: boolean,
	Dirty: boolean,
	Conn: RBXScriptConnection?,
}

type Band = { Frame: Frame, Band: any, Alive: boolean }

local Theme = UI.Theme
local PIXELS_PER_STUD = 40
local MAX_DISTANCE = 420
local LOOP_SECONDS = 120 -- eine Runde wie auf der Website
local MIN_SPEED = 60 -- px/s (Leinwand-Pixel)
local MAX_WALLS = 24
local MAX_ROWS = 64
local NEAR_CHECK = 0.5
local WAVE_INFO = TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

local ctx: any = nil
local walls: { [BasePart]: Wall } = {}
local wallCount = 0
local bands: { Band } = {}
local rows: { any } = {}
local texts: { string } = {}
local tintOverride: Color3? = nil
local nearClock = 0
local haltShown = false

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function lang(): string
	return if ctx then ctx.Lang_() else "en"
end

local function formatPrice(cents: number): string
	local ok, text = pcall(ctx.Format.Price, cents, lang())
	return if ok and type(text) == "string" then text else tostring(cents / 100)
end

local function formatPct(fraction: number): string
	local ok, text = pcall(ctx.Format.Pct, fraction, lang(), 2, true)
	return if ok and type(text) == "string" then text else string.format("%+.2f %%", fraction * 100)
end

local function module(name: string): any
	local modules = ctx and ctx.Modules
	return modules and modules[name]
end

local function call(name: string, fnName: string, ...: any): (boolean, any, any)
	local m = module(name)
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil, nil
	end
	return pcall(fn, ...)
end

local function rowText(row: any): string
	local parts = {
		string.format('<font color="%s"><b>%s</b></font>', UI.ColorHex(Theme.Text), tostring(row.Ticker)),
		string.format('<font color="%s">%s</font>', UI.ColorHex(Theme.Text2), formatPrice(row.Price)),
	}
	local change = row.Change
	if type(change) == "number" and change == change then
		table.insert(
			parts,
			string.format(
				'<font color="%s">%s %s</font>',
				UI.ColorHex(UI.TrendColor(change)),
				UI.TrendArrow(change),
				formatPct(change)
			)
		)
	end
	return table.concat(parts, "  ")
end

-- ---------------------------------------------------------------------
-- ZEILEN (aus dem letzten Frame)
-- ---------------------------------------------------------------------
local function rebuildRows()
	local frame = nil
	local okFrame, value = call("MarketClient", "Frame")
	if okFrame then
		frame = value
	end
	table.clear(rows)
	table.clear(texts)
	if type(frame) ~= "table" or type(frame.Rows) ~= "table" then
		return
	end
	for _, row in ipairs(frame.Rows) do
		if #rows >= MAX_ROWS then
			break
		end
		local okInst, inst = call("MarketClient", "Instrument", row.Id)
		if okInst and type(inst) == "table" and inst.Set ~= "Tutorial" then
			local _, close, change = call("MarketClient", "Quote", row.Id)
			local entry = {
				Ticker = inst.Ticker,
				Price = if type(close) == "number" then close else row.Close,
				Change = if type(change) == "number" then change else nil,
			}
			table.insert(rows, entry)
			table.insert(texts, rowText(entry))
		end
	end
end

function Ticker.Rows(): { any }
	local out = table.create(#rows)
	for index, row in ipairs(rows) do
		out[index] = { Ticker = row.Ticker, Price = row.Price, Change = row.Change }
	end
	return out
end

-- ---------------------------------------------------------------------
-- WÄNDE
-- ---------------------------------------------------------------------
local function faceOf(part: BasePart): Enum.NormalId
	local name = part:GetAttribute("Face")
	if type(name) == "string" then
		local ok, value = pcall(function()
			return (Enum.NormalId :: any)[name]
		end)
		if ok and typeof(value) == "EnumItem" then
			return value :: any
		end
	end
	return Enum.NormalId.Front
end

local function faceHeight(part: BasePart, face: Enum.NormalId): number
	local size = part.Size
	if face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then
		return size.Z
	end
	return size.Y
end

local function writeWall(wall: Wall)
	local count = math.min(#texts, MAX_ROWS)
	for index = 1, count do
		local label = wall.Labels[index]
		if not label then
			wall.NextOrder += 1
			label = UI.Create("TextLabel", {
				Name = "Item",
				Size = UDim2.fromScale(0, 1),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundTransparency = 1,
				FontFace = UI.Faces.MonoBold,
				TextSize = wall.TextSize,
				RichText = true,
				TextColor3 = Theme.Text,
				Text = "",
				LayoutOrder = wall.NextOrder,
				ZIndex = 3,
				Parent = wall.Track,
			})
			wall.Labels[index] = label
		end
		local text = texts[index]
		if label.Text ~= text then
			label.Text = text
		end
		if not label.Visible then
			label.Visible = true
		end
	end
	for index = count + 1, #wall.Labels do
		local label = wall.Labels[index]
		if label.Visible then
			label.Visible = false
		end
	end
	if count ~= wall.Count then
		-- andere Anzahl (erste Füllung, Neu-Notierung): Reihenfolge = Index, Kreis neu schließen
		for index, label in ipairs(wall.Labels) do
			label.LayoutOrder = index
		end
		wall.NextOrder = #wall.Labels
		wall.Head = 1
		wall.Offset = 0
		wall.Track.Position = UDim2.fromOffset(0, 0)
	end
	wall.Count = count
	wall.Dirty = false
end

local function applyLook(wall: Wall)
	local okFlags, flags = call("MarketClient", "Flags")
	local tint = tintOverride
	if not tint and okFlags and type(flags) == "table" then
		if flags.Crash then
			tint = UI.DownColor()
		elseif flags.Rally then
			tint = UI.UpColor()
		end
	end
	wall.Tint.BackgroundColor3 = tint or Theme.Bg
	wall.Tint.BackgroundTransparency = if tint then 0.72 else 1
	if wall.Halt.Visible ~= haltShown then
		wall.Halt.Visible = haltShown
		wall.Clip.Visible = not haltShown
	end
	wall.Halt.Text = if ctx then ctx.T("mkt.halted") else "HALT"
end

function Ticker.AddWall(part: BasePart)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") or walls[part] or wallCount >= MAX_WALLS then
		return
	end
	local player = Players.LocalPlayer
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end
	local face = faceOf(part)
	local canvasH = math.max(40, faceHeight(part, face) * PIXELS_PER_STUD)
	local textSize = math.clamp(math.floor(canvasH * 0.5), 14, 120)
	local gui: SurfaceGui = UI.Create("SurfaceGui", {
		Name = "AkytexTickerWall",
		Adornee = part,
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = PIXELS_PER_STUD,
		LightInfluence = 0,
		Brightness = 2,
		MaxDistance = MAX_DISTANCE,
		AlwaysOnTop = false,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	UI.Create("Frame", {
		Name = "Bg",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = gui,
	})
	local tint: Frame = UI.Create("Frame", {
		Name = "Tint",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = gui,
	})
	-- feine Akzent-Linien oben/unten (LED-Leiste)
	for _, y in ipairs({ 0, 1 }) do
		UI.Create("Frame", {
			AnchorPoint = Vector2.new(0, y),
			Position = UDim2.fromScale(0, y),
			Size = UDim2.new(1, 0, 0, math.max(2, math.floor(canvasH * 0.025))),
			BackgroundColor3 = Theme.Accent,
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			ZIndex = 4,
			Parent = gui,
		})
	end
	local clip: Frame = UI.Create("Frame", {
		Name = "Clip",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = gui,
	})
	local track: Frame = UI.Create("Frame", {
		Name = "Track",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = clip,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, textSize),
		}),
	})
	local halt: TextLabel = UI.Create("TextLabel", {
		Name = "Halt",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Display,
		TextSize = textSize,
		TextColor3 = UI.DownColor(),
		Text = "",
		Visible = false,
		ZIndex = 5,
		Parent = gui,
	})
	local waveFrame: Frame = UI.Create("Frame", {
		Name = "Wave",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Gold,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 6,
		Parent = gui,
	})
	local wave: UIGradient = UI.Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.42, 1),
			NumberSequenceKeypoint.new(0.5, 0.35),
			NumberSequenceKeypoint.new(0.58, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Offset = Vector2.new(-1, 0),
		Parent = waveFrame,
	})
	local wall: Wall = {
		Part = part,
		Gui = gui,
		Clip = clip,
		Track = track,
		Labels = {},
		Count = 0,
		Offset = 0,
		NextOrder = 0,
		Head = 1,
		TextSize = textSize,
		Gap = textSize,
		Tint = tint,
		Halt = halt,
		Wave = wave,
		WaveFrame = waveFrame,
		Near = true,
		Dirty = true,
		Conn = nil,
	}
	wall.Conn = part.AncestryChanged:Connect(function()
		if not part:IsDescendantOf(workspace) then
			Ticker.RemoveWall(part)
		end
	end)
	walls[part] = wall
	wallCount += 1
	writeWall(wall)
	applyLook(wall)
end

function Ticker.RemoveWall(part: BasePart)
	local wall = walls[part]
	if not wall then
		return
	end
	walls[part] = nil
	wallCount -= 1
	if wall.Conn then
		wall.Conn:Disconnect()
	end
	wall.Gui:Destroy()
end

-- Lichtwelle über alle Wände (Glocke bei Sonnenaufgang, §A7 #3)
function Ticker.Wave(color: Color3?)
	for _, wall in pairs(walls) do
		wall.WaveFrame.BackgroundColor3 = color or Theme.Gold
		wall.WaveFrame.Visible = true
		wall.Wave.Offset = Vector2.new(-1, 0)
		local tween = TweenService:Create(wall.Wave, WAVE_INFO, { Offset = Vector2.new(1, 0) })
		tween.Completed:Once(function()
			if walls[wall.Part] == wall then
				wall.WaveFrame.Visible = false
			end
		end)
		tween:Play()
	end
end

function Ticker.SetTint(color: Color3?)
	tintOverride = if typeof(color) == "Color3" then color else nil
	for _, wall in pairs(walls) do
		applyLook(wall)
	end
end

-- ---------------------------------------------------------------------
-- LAUFBÄNDER IN DER OBERFLÄCHE (Terminal-Kopf)
-- ---------------------------------------------------------------------
function Ticker.Attach(parent: Instance): { Frame: Frame, Destroy: () -> () }
	local band = UI.Ticker(parent)
	local entry: Band = { Frame = band.Frame, Band = band, Alive = true }
	table.insert(bands, entry)
	band.SetRows(rows)
	return {
		Frame = band.Frame,
		Destroy = function()
			if not entry.Alive then
				return
			end
			entry.Alive = false
			local index = table.find(bands, entry)
			if index then
				table.remove(bands, index)
			end
			band.Frame:Destroy()
		end,
	}
end

-- ---------------------------------------------------------------------
-- TAKT
-- ---------------------------------------------------------------------
local function marketHalted(): boolean
	local state = ctx and ctx.State or {}
	local market = state.Market
	local halts = type(market) == "table" and market.Halts or nil
	local okTick, tick = call("MarketClient", "Tick")
	local now = if okTick and type(tick) == "number" then tick else 0
	if type(halts) == "table" then
		local all = halts["0"]
		return type(all) == "number" and all > now
	end
	return false
end

local function onQuotes()
	rebuildRows()
	haltShown = marketHalted()
	for _, wall in pairs(walls) do
		wall.Dirty = true
		if wall.Near then
			writeWall(wall)
		end
		applyLook(wall)
	end
	for _, entry in ipairs(bands) do
		if entry.Alive then
			entry.Band.SetRows(rows)
		end
	end
end

local function updateNear()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local pos = camera.CFrame.Position
	for part, wall in pairs(walls) do
		local near = (part.Position - pos).Magnitude <= MAX_DISTANCE + 40
		if near ~= wall.Near then
			wall.Near = near
			if near and wall.Dirty then
				writeWall(wall)
			end
		end
	end
end

function Ticker.Frame(dt: number)
	nearClock += dt
	if nearClock >= NEAR_CHECK then
		nearClock = 0
		updateNear()
	end
	for _, wall in pairs(walls) do
		if wall.Near and wall.Count > 0 and not haltShown then
			local clipWidth = wall.Clip.AbsoluteSize.X
			local trackWidth = wall.Track.AbsoluteSize.X
			if clipWidth > 2 and trackWidth > clipWidth then
				local speed = math.max(MIN_SPEED, trackWidth / LOOP_SECONDS)
				wall.Offset -= speed * dt
				local head = math.clamp(wall.Head, 1, wall.Count)
				local first = wall.Labels[head]
				if first then
					local width = first.AbsoluteSize.X + wall.Gap
					if -wall.Offset >= width then
						wall.NextOrder += 1
						first.LayoutOrder = wall.NextOrder
						wall.Offset += width
						wall.Head = (head % wall.Count) + 1
					end
				end
				wall.Track.Position = UDim2.fromOffset(math.floor(wall.Offset + 0.5), 0)
			end
		end
	end
end

function Ticker.Init(context: any)
	ctx = context
	ctx.Hooks.On("Quotes", onQuotes)
	ctx.Hooks.On("Settings", function()
		onQuotes()
	end)
	ctx.Hooks.On("Market:Halt", function()
		haltShown = marketHalted()
		for _, wall in pairs(walls) do
			applyLook(wall)
		end
	end)
end

function Ticker.Start() end

return Ticker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="158">
            <Properties>
              <string name="Name">TouchControls</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Eigene Touch-Knöpfe (Client/Modules/TouchControls)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §C7.5. Muster: CC-TouchControls (REUSE §1.4 PATTERN).
--
--  Liegt in der UNSKALIERTEN ctx.TouchGui (ScreenInsets = DeviceSafeInsets): jeder Knopf ist mindestens
--  Config.Client.TouchButtonMin (64) Pixel groß – auch bei Knopfgröße 90 % – und nichts liegt unter der Notch.
--  Roblox-Stick und Roblox-Sprungknopf bleiben (Sprung = im Auto aussteigen); unsere Knöpfe sitzen über/neben dem
--  Sprungknopf:
--    Set "World":    SPRINT (halten; automatisch ab Stick-Auslenkung 0,9) · REAKTION (tippen -> Aktion "React")
--    Set "Vehicle":  BOOST (halten, groß) · HANDBREMSE (halten)
--    Set "Terminal": keine Welt-Knöpfe (das Terminal hat eigene Kauf-/Verkauf-Leiste ≥ 64 px)
--    Set "None":     alles aus
--  Linkshänder spiegelt alles, Knopfgröße 90–130 % (Einstellungen). Alle Knöpfe speisen Aktionen über
--  Controls.Emit ein (andere Module hören nur Controls). Fenster offen oder Fotomodus -> Knöpfe weg.
--  AKYTEX-Look: dunkle Glas-Scheiben (Bg2, halb durchsichtig) mit feinem Ring; gedrückt = heller + Accent-Ring + Feder 0.94.
--
--  Öffentliche API (§C7.5):
--    TouchControls.Show(set)          "World" | "Vehicle" | "Terminal" | "None"
--  Zusätzlich: TouchControls.Current(): string, TouchControls.Init(ctx), TouchControls.Start()
--  Standard-Sets kommen automatisch aus den Hooks ("Vehicle:Enter/Exit", Terminal-Fenster); Show überschreibt.
-- =====================================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))

local TouchControls = {}

local player = Players.LocalPlayer
local Theme = UI.Theme
local WHITE = Color3.new(1, 1, 1)
local GLASS = Theme.Bg2 -- Scheiben-Fläche
local GLASS_T = 0.38 -- normal halb durchsichtig (Welt bleibt sichtbar)
local GLASS_T_DOWN = 0.12 -- gedrückt / aktiv
local RING_IDLE = Theme.Text2
local RING_IDLE_T = 0.55
local PRESS_SCALE = 0.94
local SETS = { World = true, Vehicle = true, Terminal = true, None = true }

type TouchButton = {
	Name: string,
	Root: ImageButton,
	Ring: UIStroke,
	Scale: UIScale,
	Label: TextLabel,
	Base: number, -- Größe bei 100 %
	Sets: { [string]: boolean },
	Visible: boolean,
	Pressed: boolean,
	Color: Color3,
	TextKey: string,
}

local ctx: any = nil
local holder: Frame? = nil
local buttons: { [string]: TouchButton } = {}
local autoSet = "World" -- aus den Hooks
local manualSet: string? = nil -- per Show gesetzt (bis zum nächsten Hook-Wechsel)
local inVehicle = false
local photoMode = false
local sprintFromStick = false
local moveConn: RBXScriptConnection? = nil
local touchCfg = {
	ButtonSize = 76,
	BigSize = 96,
	SmallSize = 64,
	Margin = 16,
	AutoSprint = 0.9,
}
local minSize = 64

-- ---------------------------------------------------------------------
-- HILFEN
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function settings(): { [string]: any }
	local module = ctx and ctx.Modules and ctx.Modules.Settings
	if module and type(module.Get) == "function" then
		local ok, value = pcall(module.Get)
		if ok and type(value) == "table" then
			return value
		end
	end
	local config = ctx and ctx.Config
	return config and config.Client and config.Client.DefaultSettings or {}
end

local function controls(): any
	return ctx and ctx.Modules and ctx.Modules.Controls
end

local function emit(action: string, state: string, source: string?)
	local c = controls()
	if c and type(c.Emit) == "function" then
		pcall(c.Emit, action, state, source or ("touch:" .. action))
	end
end

local function tap(action: string)
	emit(action, "Begin")
	emit(action, "End")
end

local function isTouch(): boolean
	local c = controls()
	if c and type(c.Input) == "function" then
		local ok, kind = pcall(c.Input)
		if ok then
			return kind == "Touch"
		end
	end
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function scaled(base: number): number
	local scale = tonumber(settings().ButtonScale) or 1
	return math.max(minSize, math.floor(base * math.clamp(scale, 0.9, 1.3) + 0.5))
end

local function currentSet(): string
	return manualSet or autoSet
end

-- ---------------------------------------------------------------------
-- KNOPF-BAUSTEIN (runde Glas-Scheibe + feiner Ring, Text in der Mitte)
-- ---------------------------------------------------------------------
local function makeButton(name: string, base: number, color: Color3, textKey: string, sets: { string }): TouchButton
	local ring: UIStroke = UI.Create("UIStroke", {
		Name = "Ring",
		Color = RING_IDLE,
		Transparency = RING_IDLE_T,
		Thickness = 1.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	local scale: UIScale = UI.Create("UIScale")
	local root: ImageButton = UI.Create("ImageButton", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(base, base),
		BackgroundColor3 = color,
		BackgroundTransparency = GLASS_T,
		Image = "",
		AutoButtonColor = false,
		Visible = false,
		Parent = holder,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }), ring, scale })
	local label = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.36),
		Text = T(textKey),
		TextColor3 = WHITE,
		MaxText = 16,
		Outline = 1,
		Parent = root,
	})
	local setMap: { [string]: boolean } = {}
	for _, s in ipairs(sets) do
		setMap[s] = true
	end
	local button: TouchButton = {
		Name = name,
		Root = root,
		Ring = ring,
		Scale = scale,
		Label = label,
		Base = base,
		Sets = setMap,
		Visible = false,
		Pressed = false,
		Color = color,
		TextKey = textKey,
	}
	buttons[name] = button
	return button
end

local function paint(button: TouchButton)
	local lit = button.Pressed
	button.Root.BackgroundTransparency = if lit then GLASS_T_DOWN else GLASS_T
	button.Ring.Color = if lit then Theme.Accent else RING_IDLE
	button.Ring.Transparency = if lit then 0 else RING_IDLE_T
	button.Ring.Thickness = if lit then 2 else 1.5
	button.Scale.Scale = if lit then PRESS_SCALE else 1
end

local function setPressed(button: TouchButton, on: boolean)
	if button.Pressed ~= on then
		button.Pressed = on
		paint(button)
	end
end

-- Halten-Knopf: Begin beim Drücken, End beim Loslassen (auch wenn der Finger rausrutscht)
local function bindHold(button: TouchButton, action: string)
	local activeInput: InputObject? = nil
	button.Root.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType ~= Enum.UserInputType.Touch or activeInput then
			return
		end
		activeInput = input
		setPressed(button, true)
		emit(action, "Begin")
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input == activeInput then
			activeInput = nil
			setPressed(button, false)
			emit(action, "End")
		end
	end)
	-- Knopf verschwindet während des Haltens (Fenster geht auf): sauber loslassen
	button.Root:GetPropertyChangedSignal("Visible"):Connect(function()
		if not button.Root.Visible and activeInput then
			activeInput = nil
			setPressed(button, false)
			emit(action, "End")
		end
	end)
end

local function bindTap(button: TouchButton, fn: () -> ())
	button.Root.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		setPressed(button, true)
		fn()
		task.delay(0.12, function()
			setPressed(button, false)
		end)
	end)
end

-- ---------------------------------------------------------------------
-- AUFBAU
-- ---------------------------------------------------------------------
local function build()
	local cfg = touchCfg
	local sprint = makeButton("Sprint", cfg.ButtonSize, GLASS, "ui.touch.sprint", { "World" })
	bindHold(sprint, "Sprint")
	local react = makeButton("React", cfg.SmallSize, GLASS, "ui.touch.react", { "World" })
	bindTap(react, function()
		tap("React")
	end)
	local boost = makeButton("Boost", cfg.BigSize, Theme.Accent, "ui.touch.boost", { "Vehicle" })
	bindHold(boost, "Boost")
	local brake = makeButton("Handbrake", cfg.ButtonSize, GLASS, "ui.touch.handbrake", { "Vehicle" })
	bindHold(brake, "Handbrake")
end

-- ---------------------------------------------------------------------
-- LAYOUT (über dem Roblox-Sprungknopf, Linkshänder gespiegelt)
-- ---------------------------------------------------------------------
local function place(button: TouchButton?, x: number, y: number, mirror: boolean, width: number)
	if not button then
		return
	end
	local size = scaled(button.Base)
	button.Root.Size = UDim2.fromOffset(size, size)
	local px = if mirror then x else width - x
	button.Root.Position = UDim2.fromOffset(px, y)
end

local function layout()
	local frame = holder
	if not frame then
		return
	end
	local size = frame.AbsoluteSize
	local w, h = size.X, size.Y
	if w < 10 or h < 10 then
		return
	end
	local mirror = settings().LeftHanded == true
	local m = touchCfg.Margin
	-- Roblox-Sprungknopf: klein (70 px, rechts 25 / unten 20) auf kleinen Schirmen, sonst 120 px (rechts 170 / unten 210)
	local smallScreen = math.min(w, h) <= 500
	local jumpTop = if smallScreen then h - 90 else h - 210
	local jumpCenterX = if smallScreen then 60 else 110 -- Abstand vom rechten Rand
	local gap = 12
	-- x-Werte sind Abstände vom rechten Rand (Mitte des Knopfs); bei Linkshändern vom linken
	local btn = scaled(touchCfg.ButtonSize)
	local big = scaled(touchCfg.BigSize)
	local small = scaled(touchCfg.SmallSize)
	-- Welt: SPRINT direkt über dem Sprungknopf, REAKTION links daneben
	local sprintY = jumpTop - gap - btn / 2
	place(buttons.Sprint, jumpCenterX, sprintY, mirror, w)
	place(buttons.React, jumpCenterX + btn / 2 + gap + small / 2, sprintY + (btn - small) / 2, mirror, w)
	-- Auto: BOOST groß über dem Sprungknopf, HANDBREMSE links daneben auf Daumenhöhe
	local boostY = jumpTop - gap - big / 2
	place(buttons.Boost, math.max(m + big / 2, jumpCenterX), boostY, mirror, w)
	place(buttons.Handbrake, jumpCenterX + big / 2 + gap + btn / 2, boostY + (big - btn) / 2, mirror, w)
end

-- ---------------------------------------------------------------------
-- SICHTBARKEIT
-- ---------------------------------------------------------------------
local function windowOpen(): boolean
	local ui = ctx and ctx.UI
	if ui and type(ui.IsAnyWindowOpen) == "function" then
		local ok, open = pcall(ui.IsAnyWindowOpen)
		return ok and open == true
	end
	return false
end

local function applyVisibility()
	local touch = isTouch()
	local menu = windowOpen()
	local set = currentSet()
	for _, button in pairs(buttons) do
		local visible = touch and not menu and not photoMode and button.Sets[set] == true
		if button.Visible ~= visible then
			button.Visible = visible
			button.Root.Visible = visible
		end
	end
	-- Auto-Sprint endet, sobald der Sprint-Knopf nicht mehr gilt
	if sprintFromStick and (set ~= "World" or not touch or menu) then
		sprintFromStick = false
		emit("Sprint", "End", "touch:stick")
	end
end

function TouchControls.Show(set: string)
	if not SETS[set] then
		warn("[TouchControls] Unbekanntes Set: " .. tostring(set))
		return
	end
	manualSet = set
	applyVisibility()
end

function TouchControls.Current(): string
	return currentSet()
end

local function setAuto(set: string)
	autoSet = set
	manualSet = nil -- ein echter Zustandswechsel hebt eine manuelle Wahl auf
	applyVisibility()
end

local function refreshAuto()
	local windows = ctx and ctx.Windows
	local terminal = false
	if windows and type(windows.IsOpen) == "function" then
		local ok, open = pcall(windows.IsOpen, "Terminal")
		terminal = ok and open == true
	end
	if terminal then
		setAuto("Terminal")
	elseif inVehicle then
		setAuto("Vehicle")
	else
		setAuto("World")
	end
end

local function relabel()
	for _, button in pairs(buttons) do
		button.Label.Text = T(button.TextKey)
	end
end

-- Automatisch sprinten, wenn der Stick ≥ AutoSprint ausgelenkt ist (ereignisgesteuert, kein Frame-Loop)
local function watchHumanoid(character: Model)
	if moveConn then
		moveConn:Disconnect()
		moveConn = nil
	end
	sprintFromStick = false
	local hum = character:WaitForChild("Humanoid", 10)
	if not hum or not hum:IsA("Humanoid") then
		return
	end
	local humanoid = hum :: Humanoid
	moveConn = humanoid:GetPropertyChangedSignal("MoveDirection"):Connect(function()
		if not isTouch() or currentSet() ~= "World" or windowOpen() then
			if sprintFromStick then
				sprintFromStick = false
				emit("Sprint", "End", "touch:stick")
			end
			return
		end
		local want = humanoid.MoveDirection.Magnitude >= touchCfg.AutoSprint
		if want ~= sprintFromStick then
			sprintFromStick = want
			emit("Sprint", if want then "Begin" else "End", "touch:stick")
		end
	end)
end

function TouchControls.Init(context: any)
	ctx = context
	local config = ctx.Config
	local client = config and config.Client
	if client then
		if type(client.TouchButtonMin) == "number" then
			minSize = math.max(44, client.TouchButtonMin)
		end
		if type(client.Touch) == "table" then
			for key, value in pairs(client.Touch) do
				if type(value) == "number" and (touchCfg :: any)[key] ~= nil then
					(touchCfg :: any)[key] = value
				end
			end
		end
	end
	local frame: Frame = UI.Create("Frame", {
		Name = "TouchControls",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = ctx.TouchGui,
	})
	holder = frame
	build()
	frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)

	local hooks = ctx.Hooks
	hooks.On("Input", applyVisibility)
	hooks.On("Settings", function()
		relabel()
		layout()
		applyVisibility()
	end)
	hooks.On("WindowOpened", refreshAuto)
	hooks.On("WindowClosed", refreshAuto)
	hooks.On("Vehicle:Enter", function()
		inVehicle = true
		refreshAuto()
	end)
	hooks.On("Vehicle:Exit", function()
		inVehicle = false
		refreshAuto()
	end)
	hooks.On("PhotoMode", function(on)
		photoMode = on == true
		applyVisibility()
	end)
end

function TouchControls.Start()
	layout()
	relabel()
	applyVisibility()
	player.CharacterAdded:Connect(function(character)
		task.spawn(watchHumanoid, character)
	end)
	if player.Character then
		task.spawn(watchHumanoid, player.Character)
	end
end

return TouchControls
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="159">
            <Properties>
              <string name="Name">TowerUI</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Tower-Menü (Client/Modules/TowerUI)
--  Besitzer: WP8 (Turm-Optik, Interiors, Lifestyle). Vertrag: DESIGN.md §D WP8 (Tower-Menü: Etage bauen,
--  Abteilungen mit Nachbar-Pfeilen, Personal, Stufen, Effizienz, Deko-Slots, Fassade/Name/Privat, Börsengang-
--  Vorschau-Einstieg, Gewinn-Transfer-Knopf), §B4 (Regeln/Kosten aus Shared/TowerMath = Server-Rechnung),
--  §B5.3 (Effizienz), §B8.2 (Gewinn-Transfer: Verfügbar → CR zum Bau-Kurs der Lizenz), §B9.6 (Vorschau ab Stufe 7),
--  §B4.10 (Besuche, Privat-Etagen), §C7.3 (Fenster "Tower"), §C7.2 (feuert Hooks "Tower:Built"/"Tower:Stage" aus
--  dem State-Diff).
--
--  Alles Wertvolle entscheidet der Server (Requests Tower*); das Menü zeigt nur, was der State sagt, und schickt
--  Absichten. Kosten werden mit denselben Formeln angezeigt (TowerMath + State.Tower.CostFactor/CostEvent).
--
--  Öffentliche API (§C7.5):
--    TowerUI.Open(tab?)       tab ∈ "Overview" | "Floors" | "Staff" | "Facade" | "Visit"
--  Ergänzungen: TowerUI.Close() · TowerUI.SelectFloor(floor) · TowerUI.Init(ctx) · TowerUI.Start()
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent:WaitForChild("UI"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local TowerMath = require(Shared:WaitForChild("TowerMath"))

local TowerUI = {}

local Theme = UI.Theme
local player = Players.LocalPlayer

local WINDOW_W, WINDOW_H = 780, 600
local TABS = { "Overview", "Floors", "Staff", "Facade", "Visit" }
local REFRESH_GAP = 0.25
local CONFIRM_SECONDS = 3

local ctx: any = nil
local window: any = nil
local tabs: any = nil
local body: Frame? = nil
local tab = "Overview"
local pendingTab: string? = nil
local selectedFloor = 1
local decorPick: { Floor: number, Slot: number }? = nil
local confirmFire: { Key: string, Until: number }? = nil
local builtLang = ""
local lastSig = ""
local refreshQueued = false
local lastRefresh = 0
local lastFloors: number? = nil
local lastStage: number? = nil
local nameDraft: { A: number, N: number }? = nil
local autoPlan: { string }? = nil
local liveLabels: { [string]: TextLabel } = {}
local liveBars: { [string]: any } = {}

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

local function credits(n: number): string
	local ok, text = pcall(ctx.Format.Credits, n, lang())
	return if ok then text else tostring(math.floor(n))
end

local function aky(cents: number): string
	local ok, text = pcall(ctx.Format.Aky, cents, lang(), true)
	return if ok then text else tostring(math.floor(cents / 100))
end

local function duration(seconds: number): string
	local ok, text = pcall(ctx.Format.Duration, math.max(0, seconds), lang())
	return if ok then text else tostring(math.floor(seconds))
end

local function mult(x: number): string
	local ok, text = pcall(ctx.Format.Mult, x, lang())
	return if ok then text else string.format("x%.2f", x)
end

local function pick(pair: any): string
	return ctx.Lang.Pick(lang(), pair)
end

local function tower(): { [string]: any }
	local t = ctx.State.Tower
	return if type(t) == "table" then t else {}
end

local function income(): { [string]: any }
	local i = ctx.State.Income
	return if type(i) == "table" then i else {}
end

local function towerCfg(): { [string]: any }
	local cfg = ctx.Config.Tower
	return if type(cfg) == "table" then cfg else {}
end

local function decorCfg(): { [string]: any }
	local cfg = ctx.Config.Decor
	return if type(cfg) == "table" then cfg else {}
end

local function byKey(list: any, key: string): any
	if type(list) ~= "table" then
		return nil
	end
	for _, entry in ipairs(list) do
		if type(entry) == "table" and entry.Key == key then
			return entry
		end
	end
	return nil
end

local function stageName(stage: number): string
	local list = towerCfg().Stages
	local entry = if type(list) == "table" then list[stage] else nil
	return if type(entry) == "table" then pick(entry.Name) else tostring(stage)
end

local function roomName(key: string): string
	local entry = byKey(towerCfg().Rooms, key)
	return if entry then pick(entry.Name) else key
end

local function staffName(key: string): string
	local entry = byKey(towerCfg().Staff, key)
	return if entry then pick(entry.Name) else key
end

local function decorName(key: string): string
	local entry = decorCfg().ByKey and decorCfg().ByKey[key]
	return if type(entry) == "table" then pick(entry.Name) else key
end

local function licenceName(index: number): string
	local progression = ctx.Config.Progression
	local list = if type(progression) == "table" then progression.Licences else nil
	local entry = if type(list) == "table" then list[index] else nil
	if type(entry) == "table" and type(entry.Name) == "table" then
		return pick(entry.Name)
	end
	return T("tui.licenceLevel", index)
end

local function bauKurs(): number
	local prog = ctx.State.Prog
	local licence = if type(prog) == "table" then math.floor(num(prog.Licence, 1)) else 1
	local progression = ctx.Config.Progression
	local list = if type(progression) == "table" then progression.Licences else nil
	if type(list) ~= "table" then
		local trading = ctx.Config.Trading
		list = if type(trading) == "table" then trading.LicenceFallback else nil
	end
	local entry = if type(list) == "table" then list[licence] else nil
	return if type(entry) == "table" then num(entry.BauKurs, 40) else 40
end

local function hasPass(key: string): boolean
	local passes = ctx.State.Passes
	return type(passes) == "table" and passes[key] == true
end

-- Anfrage im Hintergrund (Toast bei Meldung kommt aus ctx.RequestFull)
local function Request(action: string, arg: any?)
	task.spawn(function()
		local okCall, result = pcall(ctx.RequestFull, action, arg)
		local reply = if okCall and type(result) == "table" then result else { Ok = false }
		if reply.Ok then
			call("Sfx", "Play", "UIClick")
		end
		if action == "TowerAutoPlan" and reply.Ok and type(reply.Plan) == "table" then
			autoPlan = reply.Plan
			lastSig = ""
			TowerUI.Refresh()
		end
	end)
end

local function costFactor(kind: string?): number
	local t = tower()
	local factor = num(t.CostFactor, 1)
	local event = t.CostEvent
	if kind and type(event) == "table" then
		factor *= num(event[kind], 1)
	end
	return math.clamp(factor, 0, 1)
end

local function comfortCtx(): any
	local items = decorCfg().ByKey
	return {
		Comfort = function(key: string): number
			local entry = if type(items) == "table" then items[key] else nil
			return if type(entry) == "table" then num(entry.Comfort, 0) else 0
		end,
	}
end

-- ---------------------------------------------------------------------
-- 2) BAUSTEINE
-- ---------------------------------------------------------------------
local function card(parent: Instance, order: number, color: Color3?): Frame
	local frame = UI.Card({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Parent = parent,
	})
	UI.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 12),
		Parent = frame,
	})
	UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = frame })
	if color then
		UI.Create("Frame", {
			Name = "Accent",
			Position = UDim2.new(0, -14, 0, -10),
			Size = UDim2.new(0, 3, 0, 22),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = frame,
		})
	end
	return frame
end

local function text(parent: Instance, value: string, order: number, opts: { [string]: any }?): TextLabel
	local props: { [string]: any } = {
		Size = UDim2.new(1, 0, 0, 22),
		Text = value,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Text2,
		MaxText = 16,
		LayoutOrder = order,
		Parent = parent,
	}
	if opts then
		for k, v in pairs(opts) do
			props[k] = v
		end
	end
	return UI.Label(props)
end

local function heading(parent: Instance, value: string, order: number): TextLabel
	return text(
		parent,
		value,
		order,
		{ Face = "Display", TextColor3 = Theme.Text, MaxText = 18, Size = UDim2.new(1, 0, 0, 26) }
	)
end

local function button(
	parent: Instance,
	label: string,
	variant: string,
	order: number,
	onClick: () -> (),
	width: number?
): any
	return UI.Button({
		Size = UDim2.fromOffset(width or 170, 38),
		Text = label,
		Variant = variant,
		MaxText = 16,
		LayoutOrder = order,
		Corner = 10,
		Parent = parent,
	}, onClick)
end

local function row(parent: Instance, order: number, height: number?): Frame
	return UI.Row(parent, order, height or 40)
end

-- ---------------------------------------------------------------------
-- 3) ÜBERSICHT
-- ---------------------------------------------------------------------
local function buildOverview(parent: Frame)
	local t = tower()
	local inc = income()
	local floors = math.floor(num(t.Floors, 0))
	local stage = math.floor(num(t.Stage, 1))
	-- Kennzahlen
	local tiles = UI.Grid(parent, 1, 172, 64)
	local s1 = UI.StatTile(tiles, T("tui.stat.stage"), 1)
	s1.Text = ("%d · %s"):format(stage, stageName(stage))
	local s2 = UI.StatTile(tiles, T("tui.stat.floors"), 2)
	s2.Text = ("%d / %d"):format(floors, math.floor(num(towerCfg().Floors, 50)))
	local s3 = UI.StatTile(tiles, T("tui.stat.income"), 3)
	s3.Text = T("tui.perSec", credits(num(inc.PerSec, 0)))
	liveLabels.Income = s3
	local s4 = UI.StatTile(tiles, T("tui.stat.mult"), 4)
	s4.Text = mult(num(inc.Mult, 1))
	-- Bauen
	local build = if type(t.Build) == "table" then t.Build else {}
	local nextInfo = if type(t.Next) == "table" then t.Next else {}
	local buildCard = card(parent, 2, Theme.Accent)
	heading(buildCard, T("tui.build.title"), 1)
	if build.Floor ~= nil then
		local now = workspace:GetServerTimeNow()
		local total = math.max(1, num(build.Total, 1))
		local remaining = math.max(0, num(build.Until, now) - now)
		text(buildCard, T("tui.build.running", build.Floor, duration(remaining)), 2, { TextColor3 = Theme.Text })
		local bar = UI.Bar({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 3, Parent = buildCard, Color = Theme.Warn })
		UI.SetBar(bar, 1 - remaining / total, duration(remaining))
		liveBars.Build = bar
		if num(build.Helpers, 0) > 0 then
			text(buildCard, T("tui.build.helpers", build.Helpers), 4)
		end
		local tokens = if type(t.Tokens) == "table" then t.Tokens else {}
		local actions = row(buildCard, 5)
		button(actions, T("tui.build.instant", math.floor(num(tokens.Instant, 0))), "Secondary", 1, function()
			Request("TowerInstant", {})
		end, 210)
		button(actions, T("tui.build.express", math.floor(num(tokens.Express, 0))), "Secondary", 2, function()
			Request("TowerExpress", {})
		end, 210)
	elseif nextInfo.Locked then
		local reason = nextInfo.Locked
		local message: string
		if reason == "tower.gateLicence" then
			message = T(
				reason,
				stageName(math.floor(num(nextInfo.Stage, stage))),
				licenceName(math.floor(num(nextInfo.Licence, 1)))
			)
		elseif reason == "tower.gateIpo" then
			message = T(reason, stageName(math.floor(num(nextInfo.Stage, stage))), math.floor(num(nextInfo.Ipo, 1)))
		else
			message = T(tostring(reason))
		end
		text(buildCard, message, 2, { TextColor3 = Theme.Warn })
		button(buildCard, T("tui.build.locked"), "Muted", 3, function()
			ctx.Toast(message, "Info")
		end, 240)
	else
		local floor = math.floor(num(nextInfo.Floor, floors + 1))
		text(buildCard, T("tui.build.next", floor, credits(num(nextInfo.Cost, 0))), 2, { TextColor3 = Theme.Text })
		text(buildCard, T("tui.build.gain", credits(num(nextInfo.Income, 0)), duration(num(nextInfo.Seconds, 0))), 3)
		local nextStage = math.floor(num(nextInfo.Stage, stage))
		if nextStage > stage then
			text(buildCard, T("tui.build.stageUp", stageName(nextStage)), 4, { TextColor3 = Theme.Gold })
		end
		button(buildCard, UI.Upper(T("tui.build")), "Primary", 5, function()
			Request("TowerBuild", {})
		end, 240)
	end
	-- Tresor
	local vaultCard = card(parent, 3, Theme.Gold)
	heading(vaultCard, T("tui.vault.title"), 1)
	local cap = math.max(1, num(t.VaultCap, 1))
	local vault = num(t.Vault, 0)
	local vbar = UI.Bar({
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = 2,
		Parent = vaultCard,
		Color = if vault >= cap then Theme.Down else Theme.Gold,
	})
	UI.SetBar(vbar, vault / cap, ("%s / %s"):format(credits(vault), credits(cap)))
	liveBars.Vault = vbar
	local vrow = row(vaultCard, 3)
	button(vrow, T("tui.vault.collect"), "Success", 1, function()
		Request("TowerCollect", {})
	end)
	text(vrow, T("tui.vault.hint"), 2, { Size = UDim2.new(1, -190, 1, 0), MaxText = 14 })
	-- Gewinn-Transfer (AKY -> CR zum Bau-Kurs; nie umgekehrt)
	local depot = ctx.State.Depot
	local transferCard = card(parent, 4, Theme.Up)
	heading(transferCard, T("tui.transfer.title"), 1)
	if type(depot) == "table" then
		local cents = math.floor(num(depot.Withdrawable, 0))
		local rate = bauKurs()
		local gain = math.floor(cents / 100 * rate)
		if depot.TransferReady == true and cents > 0 then
			text(
				transferCard,
				T("trade.transferAvail", aky(cents), credits(gain), credits(rate)),
				2,
				{ TextColor3 = Theme.Text }
			)
			button(transferCard, T("trade.transferButton"), "Success", 3, function()
				Request("TowerTransfer", {})
			end, 240)
		else
			text(transferCard, T("trade.transferLocked"), 2)
			text(transferCard, T("tui.transfer.hint", credits(rate)), 3, { MaxText = 14 })
		end
	else
		text(transferCard, T("tui.loading"), 2)
	end
	-- Effizienz (§B5.3)
	local eff = math.floor(num(t.Eff, 0))
	local effMax = math.floor(num(type(towerCfg().Efficiency) == "table" and towerCfg().Efficiency.Max or nil, 20))
	local effCard = card(parent, 5, Theme.Purple)
	heading(effCard, T("tui.eff.title", eff, effMax), 1)
	if eff < effMax then
		text(effCard, T("tui.eff.next", credits(num(t.EffCost, 0))), 2)
		button(effCard, T("tui.eff.buy"), "Primary", 3, function()
			Request("TowerEfficiency", {})
		end)
	else
		text(effCard, T("tui.eff.max"), 2, { TextColor3 = Theme.Up })
	end
	-- Aktionen
	local actions = card(parent, 6)
	heading(actions, T("tui.more"), 1)
	local grid = UI.Grid(actions, 2, 170, 38)
	button(grid, T("tui.autoPlan"), "Secondary", 1, function()
		Request("TowerAutoPlan", {})
	end)
	button(grid, T("tui.boutique"), "Secondary", 2, function()
		local opened = call("Boutique", "Open", "Decor")
		if not opened and ctx.Windows then
			ctx.Windows.Open("Boutique")
		end
	end)
	button(grid, T("tui.future.button"), "Secondary", 3, function()
		call("WelcomeBack", "ShowFuture")
	end)
	if stage >= 7 then
		button(grid, T("tui.ipoPreview"), "Premium", 4, function()
			local ok = call("Prestige", "OpenPreview")
			if not ok then
				ctx.Toast(T("tui.notReady"), "Info")
			end
		end)
	end
	if autoPlan then
		local planCard = card(parent, 7, Theme.Cyan)
		heading(planCard, T("tui.autoPlanTitle"), 1)
		local list = t.List
		local changes = 0
		for i, key in ipairs(autoPlan) do
			local current = if type(list) == "table" and type(list[i]) == "table" then list[i].R else nil
			if current ~= key and changes < 12 then
				changes += 1
				text(planCard, T("tui.autoPlanRow", i, roomName(tostring(current)), roomName(key)), 1 + changes)
			end
		end
		if changes == 0 then
			text(planCard, T("tower.autoPlanNone"), 2)
		end
	end
end

-- ---------------------------------------------------------------------
-- 4) ETAGEN (Abteilung, Stufe, Personal, Deko, Privat, Nachbar-Pfeile)
-- ---------------------------------------------------------------------
-- Nachbar-Wirkungen auf Etage i (§B4.3): Labor ±1 ×1,15, Café ±2 Personal ×1,2, Server-Räume Personal ×1,1 je Raum
local function neighbourChips(list: { any }, i: number): { { Text: string, Color: Color3 } }
	local chips: { { Text: string, Color: Color3 } } = {}
	local rooms = towerCfg().Rooms
	local function room(index: number): any
		local f = list[index]
		return if type(f) == "table" then byKey(rooms, f.R) else nil
	end
	for _, d in ipairs({ -1, 1 }) do
		local r = room(i + d)
		if r and type(r.NeighbourMult) == "number" then
			chips[#chips + 1] = {
				Text = ("%s %s %s"):format(if d < 0 then "▼" else "▲", roomName(r.Key), mult(r.NeighbourMult)),
				Color = Theme.Cyan,
			}
		end
	end
	local floor = list[i]
	if type(floor) == "table" and type(floor.S) == "table" and #floor.S > 0 then
		for d = -2, 2 do
			local r = room(i + d)
			if d ~= 0 and r and type(r.StaffMult) == "number" then
				chips[#chips + 1] = {
					Text = ("%s %s %s"):format(if d < 0 then "▼" else "▲", T("tui.staffBoost"), mult(r.StaffMult)),
					Color = Theme.Orange,
				}
				break
			end
		end
	end
	return chips
end

local function floorIncome(list: { any }, i: number): number
	local ok, value = pcall(TowerMath.FloorIncomeAt, list :: any, i, comfortCtx())
	return if ok and type(value) == "number" then value else 0
end

local function decorSlotsOf(roomKey: string): number
	local room = byKey(towerCfg().Rooms, roomKey)
	if room and type(room.DecorSlots) == "number" then
		return math.floor(num(decorCfg().PenthouseSlots, room.DecorSlots))
	end
	return math.floor(num(decorCfg().SlotsPerFloor, 3))
end

local function buildFloorDetail(parent: Frame, list: { any }, i: number)
	local t = tower()
	local floor = list[i]
	if type(floor) ~= "table" then
		return
	end
	local stage = math.floor(num(t.Stage, 1))
	local detail = card(parent, 1, Theme.Accent)
	heading(detail, T("tui.floor.title", i, roomName(floor.R), math.floor(num(floor.L, 1))), 1)
	text(detail, T("tui.floor.income", credits(floorIncome(list, i))), 2, { TextColor3 = Theme.Up })
	local chips = neighbourChips(list, i)
	if #chips > 0 then
		local chipRow = row(detail, 3, 26)
		for _, chip in ipairs(chips) do
			UI.Chip(chipRow, chip.Text, chip.Color)
		end
	end
	-- Aktionen: Stufe, Privat, Hinfahren
	local actions = row(detail, 4)
	local level = math.floor(num(floor.L, 1))
	if level < 5 then
		local cost = TowerMath.Discount(TowerMath.LevelCost(i, level), costFactor("RoomLevel"))
		button(actions, T("tui.floor.levelUp", level + 1, credits(cost)), "Primary", 1, function()
			Request("TowerLevel", { Floor = i })
		end, 230)
	else
		button(actions, T("tower.levelMax"), "Muted", 1, function() end, 230)
	end
	local private = type(t.Private) == "table" and table.find(t.Private, i) ~= nil
	button(actions, if private then T("tui.floor.public") else T("tui.floor.private"), "Secondary", 2, function()
		Request("TowerPrivate", { Floor = i, On = not private })
	end, 160)
	button(actions, T("tui.floor.goto"), "Ghost", 3, function()
		call("Elevator", "Go", i)
	end, 150)
	-- Abteilungen
	text(detail, T("tui.floor.rooms", credits(TowerMath.RoomChangeCost(i))), 5, { TextColor3 = Theme.Text })
	local roomGrid = UI.Grid(detail, 6, 136, 52)
	for order, room in ipairs(if type(towerCfg().Rooms) == "table" then towerCfg().Rooms else {}) do
		local locked = stage < num(room.MinStage, 1)
		local topOnly = room.TopOnly == true and i ~= #list
		local current = room.Key == floor.R
		local variant = if current then "Primary" elseif locked or topOnly then "Muted" else "Secondary"
		UI.Button({
			Size = UDim2.fromOffset(136, 52),
			Text = pick(room.Name),
			Sub = if locked
				then T("tui.fromStage", room.MinStage)
				elseif topOnly then T("tui.topOnly")
				else mult(num(room.Factor, 1)),
			Variant = variant,
			MaxText = 14,
			SubMax = 12,
			Corner = 10,
			LayoutOrder = order,
			Parent = roomGrid,
		}, function()
			if current then
				return
			end
			Request("TowerRoom", { Floor = i, Room = room.Key })
		end)
	end
	-- Personal
	local slots = math.floor(num(t.StaffSlots, 2))
	local staffList = if type(floor.S) == "table" then floor.S else {}
	text(detail, T("tui.floor.staff", #staffList, slots), 7, { TextColor3 = Theme.Text })
	local staffBox = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 8,
		Parent = detail,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }) })
	for slotIndex, key in ipairs(staffList) do
		local staffRow = row(staffBox, slotIndex, 38)
		local entry = byKey(towerCfg().Staff, key)
		text(
			staffRow,
			("🤖 %s  +%d %%"):format(staffName(key), math.floor(num(entry and entry.Bonus, 0) * 100 + 0.5)),
			1,
			{
				Size = UDim2.new(1, -170, 1, 0),
				TextColor3 = Theme.Text,
			}
		)
		local confirmKey = ("%d:%d"):format(i, slotIndex)
		local armed = confirmFire ~= nil and confirmFire.Key == confirmKey and os.clock() < confirmFire.Until
		button(
			staffRow,
			if armed then T("tui.fireConfirm") else T("tui.fire"),
			if armed then "Danger" else "Ghost",
			2,
			function()
				if armed then
					confirmFire = nil
					Request("TowerFire", { Floor = i, Slot = slotIndex })
				else
					confirmFire = { Key = confirmKey, Until = os.clock() + CONFIRM_SECONDS }
					lastSig = ""
					TowerUI.Refresh()
				end
			end,
			150
		)
	end
	if #staffList < slots then
		local hireGrid = UI.Grid(detail, 9, 172, 52)
		for order, staff in ipairs(if type(towerCfg().Staff) == "table" then towerCfg().Staff else {}) do
			if not staff.Lobby then
				local locked = stage < num(staff.MinStage, 1)
				local cost = TowerMath.Discount(TowerMath.StaffCost(i, staff.Key), costFactor(nil))
				UI.Button({
					Size = UDim2.fromOffset(172, 52),
					Text = pick(staff.Name),
					Sub = if locked
						then T("tui.fromStage", staff.MinStage)
						else ("+%d %% · %s"):format(math.floor(num(staff.Bonus, 0) * 100 + 0.5), credits(cost)),
					Variant = if locked then "Muted" else "Secondary",
					MaxText = 14,
					SubMax = 12,
					Corner = 10,
					LayoutOrder = order,
					Parent = hireGrid,
				}, function()
					Request("TowerHire", { Floor = i, Staff = staff.Key })
				end)
			end
		end
	elseif
		slots < math.floor(num(towerCfg().StaffSlotsPlus, 3))
		and not hasPass(tostring(towerCfg().StaffPass or "StaffPlus"))
	then
		local hint = row(detail, 9, 38)
		text(hint, T("tui.staffPlus"), 1, { Size = UDim2.new(1, -150, 1, 0), MaxText = 14 })
		button(hint, T("tui.view"), "Premium", 2, function()
			call("Shop", "Open", tostring(towerCfg().StaffPass or "StaffPlus")) -- direkt die Pass-Details
		end, 130)
	end
	-- Deko-Plätze
	local slotsDecor = decorSlotsOf(floor.R)
	local decorList = if type(floor.D) == "table" then floor.D else {}
	text(detail, T("tui.floor.decor", slotsDecor), 10, { TextColor3 = Theme.Text })
	local decorGrid = UI.Grid(detail, 11, 172, 52)
	for slot = 1, slotsDecor do
		local key = decorList[slot]
		local filled = type(key) == "string" and key ~= ""
		UI.Button({
			Size = UDim2.fromOffset(172, 52),
			Text = if filled then decorName(key) else T("tui.decor.empty"),
			Sub = if filled then T("tui.decor.remove") else T("tui.decor.place"),
			Variant = if filled then "Secondary" else "Muted",
			MaxText = 14,
			SubMax = 12,
			Corner = 10,
			LayoutOrder = slot,
			Parent = decorGrid,
		}, function()
			if filled then
				Request("TowerDecor", { Floor = i, Slot = slot })
			else
				decorPick = { Floor = i, Slot = slot }
				lastSig = ""
				TowerUI.Refresh()
			end
		end)
	end
	-- Auswahl aus dem Lager
	local pickInfo = decorPick
	if pickInfo and pickInfo.Floor == i then
		local storage = ctx.State.Storage
		local decor = if type(storage) == "table" and type(storage.Decor) == "table" then storage.Decor else {}
		local keys: { string } = {}
		for key, count in pairs(decor) do
			if type(count) == "number" and count > 0 then
				table.insert(keys, key)
			end
		end
		table.sort(keys, function(a, b)
			return decorName(a) < decorName(b)
		end)
		local pickCard = card(detail, 12, Theme.Warn)
		heading(pickCard, T("tui.decor.pick", pickInfo.Slot), 1)
		if #keys == 0 then
			text(pickCard, T("tui.decor.none"), 2)
			button(pickCard, T("tui.boutique"), "Primary", 3, function()
				local opened = call("Boutique", "Open", "Decor")
				if not opened and ctx.Windows then
					ctx.Windows.Open("Boutique")
				end
			end)
		else
			local pickGrid = UI.Grid(pickCard, 2, 172, 52)
			for order, key in ipairs(keys) do
				if order > 40 then
					break
				end
				local entry = decorCfg().ByKey and decorCfg().ByKey[key]
				UI.Button({
					Size = UDim2.fromOffset(172, 52),
					Text = decorName(key),
					Sub = T("tui.decor.count", decor[key], if type(entry) == "table" then num(entry.Comfort, 0) else 0),
					Variant = "Secondary",
					MaxText = 14,
					SubMax = 12,
					Corner = 10,
					LayoutOrder = order,
					Parent = pickGrid,
				}, function()
					decorPick = nil
					Request("TowerDecor", { Floor = pickInfo.Floor, Slot = pickInfo.Slot, Key = key })
				end)
			end
		end
	end
end

local function buildFloors(parent: Frame)
	local t = tower()
	local list = if type(t.List) == "table" then t.List else {}
	if #list == 0 then
		text(parent, T("tui.noFloors"), 1)
		return
	end
	selectedFloor = math.clamp(selectedFloor, 1, #list)
	buildFloorDetail(parent, list, selectedFloor)
	local listCard = card(parent, 2)
	heading(listCard, T("tui.floors.all"), 1)
	local private = if type(t.Private) == "table" then t.Private else {}
	for i = #list, 1, -1 do
		local floor = list[i]
		if type(floor) == "table" then
			local selected = i == selectedFloor
			local rowCard = UI.RowCard(listCard, 1 + (#list - i + 1), 44)
			if selected then
				rowCard.BackgroundColor3 = Theme.Hover
				UI.Create("UIStroke", { Color = Theme.Accent, Thickness = 1, Parent = rowCard })
			end
			local staff = if type(floor.S) == "table" then #floor.S else 0
			local decorCount = 0
			if type(floor.D) == "table" then
				for _, key in ipairs(floor.D) do
					if type(key) == "string" and key ~= "" then
						decorCount += 1
					end
				end
			end
			local lock = if table.find(private, i) then "🔒 " else ""
			UI.Label({
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(0.6, -12, 1, 0),
				Text = ("%s%d · %s · L%d"):format(lock, i, roomName(floor.R), math.floor(num(floor.L, 1))),
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxText = 15,
				Parent = rowCard,
			})
			UI.Label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -12, 0, 0),
				Size = UDim2.new(0.4, -12, 1, 0),
				Text = ("🤖 %d  ✦ %d  %s"):format(
					staff,
					decorCount,
					T("tui.perSec", credits(floorIncome(list, i)))
				),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = Theme.Text2,
				Face = "Mono",
				MaxText = 14,
				Parent = rowCard,
			})
			local hit: TextButton = UI.Create("TextButton", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = "",
				ZIndex = 3,
				Parent = rowCard,
			})
			hit.Activated:Connect(function()
				selectedFloor = i
				decorPick = nil
				lastSig = ""
				TowerUI.Refresh()
				local content = window and window.Content
				if content then
					content.CanvasPosition = Vector2.zero
				end
			end)
		end
	end
end

-- ---------------------------------------------------------------------
-- 5) PERSONAL (Lobby-Roboter, Übersicht, Personal+)
-- ---------------------------------------------------------------------
local function buildStaff(parent: Frame)
	local t = tower()
	local stage = math.floor(num(t.Stage, 1))
	local lobby = card(parent, 1, Theme.Warn)
	heading(lobby, T("tui.lobby.title"), 1)
	for order, key in ipairs({ "Janitor", "Security" }) do
		local entry = byKey(towerCfg().Staff, key)
		if entry then
			local hired = t[key] == true
			local r = row(lobby, 1 + order, 46)
			text(r, ("%s – %s"):format(pick(entry.Name), pick(entry.Desc)), 1, {
				Size = UDim2.new(1, -190, 1, 0),
				TextColor3 = Theme.Text,
				MaxText = 14,
				TextWrapped = true,
			})
			if hired then
				local confirmKey = "0:" .. order
				local armed = confirmFire ~= nil and confirmFire.Key == confirmKey and os.clock() < confirmFire.Until
				button(
					r,
					if armed then T("tui.fireConfirm") else T("tui.fire"),
					if armed then "Danger" else "Ghost",
					2,
					function()
						if armed then
							confirmFire = nil
							Request("TowerFire", { Floor = 0, Slot = order })
						else
							confirmFire = { Key = confirmKey, Until = os.clock() + CONFIRM_SECONDS }
							lastSig = ""
							TowerUI.Refresh()
						end
					end,
					170
				)
			elseif stage < num(entry.MinStage, 1) then
				button(r, T("tui.fromStage", entry.MinStage), "Muted", 2, function() end, 170)
			else
				local cost = TowerMath.Discount(TowerMath.StaffCost(0, key), costFactor(nil))
				button(
					r,
					if cost > 0 then T("tui.hireFor", credits(cost)) else T("tui.hireFree"),
					"Primary",
					2,
					function()
						Request("TowerHire", { Floor = 0, Staff = key })
					end,
					170
				)
			end
		end
	end
	-- Übersicht je Personal-Art
	local counts: { [string]: number } = {}
	local list = if type(t.List) == "table" then t.List else {}
	for _, floor in ipairs(list) do
		if type(floor) == "table" and type(floor.S) == "table" then
			for _, key in ipairs(floor.S) do
				counts[key] = (counts[key] or 0) + 1
			end
		end
	end
	local summary = card(parent, 2, Theme.Accent)
	heading(summary, T("tui.staff.summary"), 1)
	for order, staff in ipairs(if type(towerCfg().Staff) == "table" then towerCfg().Staff else {}) do
		if not staff.Lobby then
			text(
				summary,
				("%s: %d  ·  +%d %%"):format(
					pick(staff.Name),
					counts[staff.Key] or 0,
					math.floor(num(staff.Bonus, 0) * 100 + 0.5)
				),
				1 + order,
				{
					TextColor3 = if (counts[staff.Key] or 0) > 0 then Theme.Text else Theme.Muted,
				}
			)
		end
	end
	text(summary, T("tui.staff.hint"), 20, { MaxText = 14 })
	if math.floor(num(t.StaffSlots, 2)) < math.floor(num(towerCfg().StaffSlotsPlus, 3)) then
		local hint = row(summary, 21, 38)
		text(hint, T("tui.staffPlus"), 1, { Size = UDim2.new(1, -150, 1, 0), MaxText = 14 })
		button(hint, T("tui.view"), "Premium", 2, function()
			call("Shop", "Open", tostring(towerCfg().StaffPass or "StaffPlus")) -- direkt die Pass-Details
		end, 130)
	end
end

-- ---------------------------------------------------------------------
-- 6) FASSADE, NEON, KRONE, NAME, LAYOUT
-- ---------------------------------------------------------------------
local function buildFacade(parent: Frame)
	local t = tower()
	local skins = card(parent, 1, Theme.Accent)
	heading(skins, T("tui.facade.skins"), 1)
	local skinGrid = UI.Grid(skins, 2, 172, 52)
	for order, skin in ipairs(if type(towerCfg().Skins) == "table" then towerCfg().Skins else {}) do
		local current = t.Skin == skin.Key
		local hint = if skin.Unlock == "Pass"
			then (if hasPass(tostring(skin.Pass)) then T("tui.owned") else T("tui.facade.pass"))
			elseif skin.Unlock == "Default" then T("tui.owned")
			else T("tui.skinHint." .. skin.Key)
		UI.Button({
			Size = UDim2.fromOffset(172, 52),
			Text = pick(skin.Name),
			Sub = if current then T("tui.active") else hint,
			Variant = if current then "Primary" else "Secondary",
			MaxText = 14,
			SubMax = 11,
			Corner = 10,
			LayoutOrder = order,
			Parent = skinGrid,
		}, function()
			if current then
				return
			end
			if skin.Unlock == "Pass" and not hasPass(tostring(skin.Pass)) then
				call("Shop", "Open", if type(skin.Pass) == "string" then skin.Pass else "Passes")
				return
			end
			Request("TowerSkin", { Skin = skin.Key })
		end)
	end
	-- Neon-Farben
	local neonCard = card(parent, 2, Theme.Cyan)
	heading(neonCard, T("tui.facade.neon"), 1)
	local neonGrid = UI.Grid(neonCard, 2, 120, 40)
	for order, neon in ipairs(if type(towerCfg().Neon) == "table" then towerCfg().Neon else {}) do
		local current = t.Neon == neon.Key
		local ok, color = pcall(Color3.fromHex, neon.Hex)
		local btn = UI.Button({
			Size = UDim2.fromOffset(120, 40),
			Text = pick(neon.Name),
			Color = if ok then color else Theme.Accent,
			Variant = if current then nil else "Custom",
			MaxText = 13,
			Corner = 10,
			LayoutOrder = order,
			Parent = neonGrid,
		}, function()
			if not current then
				Request("TowerNeon", { Color = neon.Key })
			end
		end)
		if current then
			UI.Create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Parent = btn.Frame })
		end
	end
	-- Börsengang-Krone
	local crownCard = card(parent, 3, Theme.Gold)
	heading(crownCard, T("tui.facade.crown"), 1)
	local crownEntry = byKey(towerCfg().Crowns, tostring(t.Crown or ""))
	text(
		crownCard,
		if crownEntry then pick(crownEntry.Name) else T("tui.facade.noCrown"),
		2,
		{ TextColor3 = Theme.Text }
	)
	-- Tower-Name aus Wortbausteinen (§B4.9, kein Freitext)
	local names = towerCfg().Names
	if type(names) == "table" and type(names.Adj) == "table" and type(names.Noun) == "table" then
		local nameCard = card(parent, 4, Theme.Purple)
		heading(nameCard, T("tui.facade.name"), 1)
		local current = if type(t.Name) == "table" then t.Name else { A = 1, N = 1 }
		local draft = nameDraft or { A = math.floor(num(current.A, 1)), N = math.floor(num(current.N, 1)) }
		nameDraft = draft
		local adjOptions: { string } = {}
		for _, pair in ipairs(names.Adj) do
			table.insert(adjOptions, pick(pair))
		end
		local nounOptions: { string } = {}
		for _, pair in ipairs(names.Noun) do
			table.insert(nounOptions, pick(pair))
		end
		local preview = text(
			nameCard,
			"",
			2,
			{ Face = "Display", TextColor3 = Theme.Accent, MaxText = 18, Size = UDim2.new(1, 0, 0, 28) }
		)
		local function updatePreview()
			local fn = towerCfg().NameText
			if type(fn) == "function" then
				local ok, value = pcall(fn, draft.A, draft.N, lang())
				preview.Text = if ok then value else ""
			end
		end
		updatePreview()
		local cyclerRow = row(nameCard, 3, 40)
		local adj = UI.Cycler(cyclerRow, T("tui.facade.adj"), adjOptions, UDim2.fromOffset(250, 38))
		adj.Set(adjOptions[draft.A])
		adj.OnChange = function(value: string?)
			draft.A = (value and table.find(adjOptions, value)) or 1
			updatePreview()
		end
		local noun = UI.Cycler(cyclerRow, T("tui.facade.noun"), nounOptions, UDim2.fromOffset(250, 38))
		noun.Set(nounOptions[draft.N])
		noun.OnChange = function(value: string?)
			draft.N = (value and table.find(nounOptions, value)) or 1
			updatePreview()
		end
		button(nameCard, T("tui.facade.apply"), "Primary", 4, function()
			Request("TowerName", { A = draft.A, N = draft.N })
		end)
	end
	-- Layout merken (Börsengang) + Privat-Info
	local layoutCard = card(parent, 5)
	heading(layoutCard, T("tui.facade.layout"), 1)
	local keep = t.KeepLayout ~= false
	local r = row(layoutCard, 2, 40)
	text(r, T("tui.facade.layoutHint"), 1, { Size = UDim2.new(1, -150, 1, 0), MaxText = 14 })
	button(r, if keep then T("tui.on") else T("tui.off"), if keep then "Success" else "Secondary", 2, function()
		Request("TowerLayout", { On = not keep })
	end, 130)
	local privateCount = if type(t.Private) == "table" then #t.Private else 0
	text(layoutCard, T("tui.facade.private", privateCount, math.floor(num(towerCfg().PrivateMax, 5))), 3)
end

-- ---------------------------------------------------------------------
-- 7) BESUCHE (Liste nach Höhe, §B4.10)
-- ---------------------------------------------------------------------
local function buildVisit(parent: Frame)
	local listCard = card(parent, 1, Theme.Accent)
	heading(listCard, T("tui.visit.title"), 1)
	local ok, plotList = call("TowerView", "Plots")
	local entries: { { [string]: any } } = {}
	if ok and type(plotList) == "table" then
		for _, plot in ipairs(plotList) do
			local okInfo, info = call("TowerView", "PlotInfo", plot)
			if okInfo and type(info) == "table" and num(info.Owner, 0) > 0 then
				table.insert(entries, info)
			end
		end
	end
	table.sort(entries, function(a, b)
		return num(a.Floors, 0) > num(b.Floors, 0)
	end)
	if #entries == 0 then
		text(listCard, T("tui.visit.none"), 2)
	end
	for order, info in ipairs(entries) do
		local mine = info.Owner == player.UserId
		local r = UI.RowCard(listCard, 1 + order, 50)
		UI.Label({
			Position = UDim2.fromOffset(12, 4),
			Size = UDim2.new(1, -200, 0, 22),
			Text = ("%s%s"):format(tostring(info.OwnerName or "?"), if mine then T("tui.visit.you") else ""),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 16,
			Parent = r,
		})
		UI.Label({
			Position = UDim2.fromOffset(12, 26),
			Size = UDim2.new(1, -200, 0, 18),
			Text = ("%s · %s · %s"):format(
				tostring(info.TowerName or ""),
				T("tui.floorsShort", num(info.Floors, 0)),
				stageName(math.floor(num(info.Stage, 1)))
			),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.Text2,
			MaxText = 13,
			Parent = r,
		})
		local actions = UI.RowActions(r, 170)
		button(
			actions,
			if mine then T("tui.visit.home") else T("tui.visit.go"),
			if mine then "Secondary" else "Primary",
			1,
			function()
				if mine then
					Request("TowerHome", {})
				else
					Request("TowerVisit", { UserId = info.Owner })
				end
				if ctx.Windows then
					ctx.Windows.Close("Tower")
				end
			end,
			160
		)
	end
end

-- ---------------------------------------------------------------------
-- 8) FENSTER, REFRESH, HOOKS
-- ---------------------------------------------------------------------
local function signature(): string
	local t = tower()
	local parts: { string } = { tab, tostring(selectedFloor), lang() }
	for _, key in ipairs({
		"Floors",
		"Stage",
		"Eff",
		"EffCost",
		"Skin",
		"Neon",
		"Crown",
		"StaffSlots",
		"Janitor",
		"Security",
		"KeepLayout",
	}) do
		table.insert(parts, tostring(t[key]))
	end
	local build = t.Build
	table.insert(
		parts,
		if type(build) == "table"
			then tostring(build.Floor) .. "/" .. tostring(build.Until) .. "/" .. tostring(build.Helpers)
			else "-"
	)
	local nextInfo = t.Next
	table.insert(parts, if type(nextInfo) == "table" then tostring(nextInfo.Cost) .. tostring(nextInfo.Locked) else "-")
	local tokens = t.Tokens
	table.insert(
		parts,
		if type(tokens) == "table" then tostring(tokens.Instant) .. "/" .. tostring(tokens.Express) else "-"
	)
	local list = t.List
	if type(list) == "table" then
		for _, floor in ipairs(list) do
			if type(floor) == "table" then
				table.insert(
					parts,
					("%s%s%s%s"):format(
						tostring(floor.R),
						tostring(floor.L),
						table.concat(floor.S or {}, ","),
						table.concat(floor.D or {}, ",")
					)
				)
			end
		end
	end
	if type(t.Private) == "table" then
		table.insert(parts, table.concat(t.Private, ","))
	end
	if type(t.Name) == "table" then
		table.insert(parts, tostring(t.Name.A) .. ":" .. tostring(t.Name.N))
	end
	local depot = ctx.State.Depot
	if type(depot) == "table" then
		table.insert(parts, tostring(depot.Withdrawable) .. tostring(depot.TransferReady))
	end
	local storage = ctx.State.Storage
	if tab == "Floors" and type(storage) == "table" and type(storage.Decor) == "table" then
		for key, n in pairs(storage.Decor) do
			table.insert(parts, tostring(key) .. "=" .. tostring(n))
		end
	end
	if confirmFire then
		table.insert(parts, confirmFire.Key)
	end
	if decorPick then
		table.insert(parts, decorPick.Floor .. ":" .. decorPick.Slot)
	end
	if tab == "Visit" then
		local ok, plotList = call("TowerView", "Plots")
		if ok and type(plotList) == "table" then
			for _, plot in ipairs(plotList) do
				local okInfo, info = call("TowerView", "PlotInfo", plot)
				if okInfo and type(info) == "table" then
					table.insert(parts, tostring(info.Owner) .. ":" .. tostring(info.Floors))
				end
			end
		end
	end
	return table.concat(parts, "|")
end

-- Live-Werte ohne Neuaufbau (Einkommen, Tresor, Baufortschritt)
local function updateLive()
	local t = tower()
	local inc = income()
	local incomeLabel = liveLabels.Income
	if incomeLabel and incomeLabel.Parent then
		incomeLabel.Text = T("tui.perSec", credits(num(inc.PerSec, 0)))
	end
	local vaultBar = liveBars.Vault
	if vaultBar and vaultBar.Frame.Parent then
		local cap = math.max(1, num(t.VaultCap, 1))
		local vault = num(t.Vault, 0)
		UI.SetBar(vaultBar, vault / cap, ("%s / %s"):format(credits(vault), credits(cap)))
	end
	local buildBar = liveBars.Build
	local build = t.Build
	if buildBar and buildBar.Frame.Parent and type(build) == "table" and build.Floor ~= nil then
		local now = workspace:GetServerTimeNow()
		local total = math.max(1, num(build.Total, 1))
		local remaining = math.max(0, num(build.Until, now) - now)
		UI.SetBar(buildBar, 1 - remaining / total, duration(remaining))
	end
end

local function rebuild()
	local holder = body
	if not holder then
		return
	end
	for _, child in ipairs(holder:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	table.clear(liveLabels)
	table.clear(liveBars)
	local ok, err = pcall(function()
		if tab == "Overview" then
			buildOverview(holder)
		elseif tab == "Floors" then
			buildFloors(holder)
		elseif tab == "Staff" then
			buildStaff(holder)
		elseif tab == "Facade" then
			buildFacade(holder)
		else
			buildVisit(holder)
		end
	end)
	if not ok then
		warn("[TowerUI] " .. tab .. ": " .. tostring(err))
	end
end

function TowerUI.Refresh()
	if not window or not window.IsOpen then
		return
	end
	local sig = signature()
	if sig ~= lastSig then
		lastSig = sig
		rebuild()
	end
	updateLive()
end

local function queueRefresh()
	if refreshQueued then
		return
	end
	refreshQueued = true
	local wait = math.max(0, REFRESH_GAP - (os.clock() - lastRefresh))
	task.delay(wait, function()
		refreshQueued = false
		lastRefresh = os.clock()
		TowerUI.Refresh()
	end)
end

local function makeTabs()
	if not window then
		return
	end
	if tabs then
		tabs.Frame:Destroy()
	end
	local options = {}
	for _, key in ipairs(TABS) do
		table.insert(options, { Key = key, Text = T("tui.tab." .. string.lower(key)) })
	end
	tabs = UI.Segmented(window.Content, options, function(key: string)
		tab = key
		decorPick = nil
		lastSig = ""
		TowerUI.Refresh()
	end)
	tabs.Frame.LayoutOrder = 1
	builtLang = lang()
end

local function buildWindow()
	if window then
		return
	end
	window = UI.Window(T("tui.title"), WINDOW_W, WINDOW_H, Theme.Accent)
	body = UI.Create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = window.Content,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }) })
	makeTabs()
end

local function openWindow()
	buildWindow()
	if window and builtLang ~= lang() then
		window.TitleLabel.Text = UI.Upper(T("tui.title"))
		makeTabs()
	end
	if pendingTab then
		tab = pendingTab
		pendingTab = nil
	end
	if tabs then
		tabs.Set(tab, true)
	end
	UI.OpenWindow(window)
	lastSig = ""
	TowerUI.Refresh()
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
	autoPlan = nil
	decorPick = nil
	nameDraft = nil
end

function TowerUI.Open(which: string?)
	if type(which) == "string" and table.find(TABS, which) then
		pendingTab = which
	end
	if ctx.Windows then
		ctx.Windows.Open("Tower")
	end
end

function TowerUI.Close()
	if ctx.Windows then
		ctx.Windows.Close("Tower")
	end
end

function TowerUI.SelectFloor(floor: number)
	if type(floor) == "number" and floor >= 1 then
		selectedFloor = math.floor(floor)
		TowerUI.Open("Floors")
	end
end

-- Hooks "Tower:Built" / "Tower:Stage" aus dem State-Diff (§C7.2)
local function onState(state: { [string]: any }, changed: { [any]: any })
	if
		not changed.Tower
		and not changed.Income
		and not changed.Depot
		and not changed.Storage
		and not changed.Passes
	then
		return
	end
	local t = state.Tower
	if type(t) == "table" then
		local floors = math.floor(num(t.Floors, 0))
		local stage = math.floor(num(t.Stage, 1))
		if lastFloors ~= nil and floors > lastFloors then
			ctx.Hooks.Fire("Tower:Built", floors)
		end
		if lastStage ~= nil and stage > lastStage then
			ctx.Hooks.Fire("Tower:Stage", stage)
		end
		lastFloors = floors
		lastStage = stage
	end
	queueRefresh()
end

-- Live-Werte (Baufortschritt, Tresor) – TowerView.Frame ruft das 1×/s (kein eigener Loop)
function TowerUI.Tick()
	if window and window.IsOpen then
		updateLive()
	end
end

function TowerUI.Init(context: any)
	ctx = context
	ctx.Windows.Register("Tower", openWindow, closeWindow)
	ctx.Hooks.On("State", onState)
	ctx.Hooks.On("Settings", function()
		if window and builtLang ~= lang() then
			window.TitleLabel.Text = UI.Upper(T("tui.title"))
			makeTabs()
			if tabs then
				tabs.Set(tab, true)
			end
			lastSig = ""
			TowerUI.Refresh()
		end
	end)
end

function TowerUI.Start() end

return TowerUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="160">
            <Properties>
              <string name="Name">TowerView</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Tower-Ansicht: Interiors, Fensterlichter, Kräne, Plot-Schilder (Client/Modules/TowerView)
--  Besitzer: WP8 (Turm-Optik, Interiors, Lifestyle). Vertrag: DESIGN.md §B3 (Client baut Interiors aus dem Plot-
--  Attribut "Layout": nur für den Tower, in dem man ist oder < 80 Studs davor, Etagen ±k um die Kamera (k je
--  Grafikstufe 0/1/2/4 = Quality.Budget("InteriorRadius")), ≤ 150 Parts je Etage aus Pools, Aufbau ≤ 1,5 ms je Frame;
--  andere Tower zeigen beleuchtete Fenster/Neon-Streifen), §A4 (Fensterlicht-Kaskade ab ClockTime 18,5 von unten
--  nach oben, 0,05 s je Etage), §B4.4 (Roboter-Wippen/Kopfdrehen im einen PreRender-Loop, nur nahe Etagen),
--  §B4.6 (Kassen-Tor), §B4.7 (Kran + Bau-Hilfe), §B4.9 (Fassaden-LED zeigt AKX36-Farbe, nie eigenes G/V; Neon-
--  Fassaden-Kit: 8 Lichtmuster nachts), §B4.10 (Aufzugstür -> Etagen-Panel, Privat-Etagen), §B11.3 (Respekt-Säule),
--  §C16 (TowerView < 0,3 ms/Frame), Muss-Regel 16 (StreamingEnabled: alles nil-sicher, Teile kommen und gehen).
--
--  Liest: Workspace.AkyTowers.Plot<n> (Attribute von TowerVisualService), State Plot/Tower, Quality-Budgets.
--  Live-Monitore: Interior-Monitore tragen das Attribut "Monitor" (WP5-Monitors rendert die nächsten K live).
--  Hooks: feuert "Plot:Enter" / "Plot:Leave" (plotId, ownerUserId).
--  Ein PreRender-Loop: TowerView.Frame(dt) (FRAME_MODULES) treibt auch EffectsTower.Step, Elevator.Step und
--  Boutique.Step an (diese Module stehen nicht in FRAME_MODULES – so bleibt es bei EINEM Loop, Muss-Regel 2).
--
--  Öffentliche API (§C7.5):
--    TowerView.InsideTower(): number?            Plot, in dessen Tower-Grundriss die eigene Figur steht
--  Ergänzungen (für EffectsTower/Elevator/TowerUI/WelcomeBack):
--    TowerView.ActivePlot(): number?   TowerView.OwnPlot(): number?   TowerView.PlotFolder(plot): Folder?
--    TowerView.PlotInfo(plot): { Pivot, Stage, Floors, Owner, Name, Layout }?   TowerView.TowerModel(plot): Model?
--    TowerView.FloorOf(position: Vector3, plot): number    TowerView.CurrentFloor(): number?
--    TowerView.FloorCFrame(plot, floor): CFrame?  (Füße vor der Aufzugstür)   TowerView.TopCFrame(plot): CFrame?
--    TowerView.ShowCrane(plot, floor, seconds)    TowerView.CraneHook(plot): BasePart?   TowerView.NeonBands(plot)
--    TowerView.Frame(dt), TowerView.Init(ctx), TowerView.Start()
-- =====================================================================

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent:WaitForChild("UI"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local TowerModels = require(Shared:WaitForChild("TowerModels"))
require(Shared:WaitForChild("DecorModels")) -- registriert sich bei TowerModels als Deko-Lieferant

local TowerView = {}

local Theme = UI.Theme
local player = Players.LocalPlayer

local FOLDER_NAME = "AkyTowers"
local ACTIVE_RANGE = 80 -- §B3: Interiors für den Tower, in dem man ist oder < 80 Studs davor
local BUILD_BUDGET = 0.0015 -- §B3/§C16: Aufbau ≤ 1,5 ms je Frame
local POOL_MAX = 900
local ANIM_RANGE = 70 -- Roboter/Deko-Animation nur nah
local CROWN_RANGE = 650 -- Kronen-Animation (Leuchtfeuer, Holo-Ringe) nur in Sichtweite
local NIGHT_STEP = 0.05 -- §A4: Fensterlicht-Kaskade 0,05 s je Etage
local GATE_GAP = 2 -- Sekunden zwischen zwei Kassen-Tor-Anfragen
local LED_GAP = 2 -- Sekunden: Fassaden-LED (AKX36) auffrischen
local FX_PERIOD = 20 -- Sekunden je Lichtmuster (Neon-Fassaden-Kit, 8 Muster)
local AKX36 = 40
local MAX_PLOTS = 32

type AnimGroup = {
	Kind: string,
	Parts: { BasePart },
	Base: { CFrame },
	Heads: { [number]: boolean },
	HeadCenter: Vector3?,
	Center: Vector3,
	Top: number,
	Phase: number,
}

type FloorBuild = {
	Floor: number,
	Sig: string,
	Parts: { BasePart },
	Groups: { AnimGroup },
	Lights: { Light },
	Door: BasePart?,
	Doors: { { Part: BasePart, Base: CFrame, Side: number } }?,
}

type PlotInfo = {
	Plot: number,
	Folder: Folder,
	Pivot: CFrame,
	Owner: number,
	Stage: number,
	Floors: number,
	Layout: string,
	Chunks: { string },
	Model: Model?,
	Bands: { BasePart },
	Leds: { BasePart },
	Anim: { AnimGroup },
	Sign: BasePart?,
	VaultRing: BasePart?,
	Respekt: BasePart?,
	Panel: BasePart?,
	ScanDirty: boolean,
	NightLit: number, -- so viele Etagen leuchten schon (Kaskade)
	Fx: boolean,
	Crane: { BasePart }?,
	CraneHook: BasePart?,
	CraneFloor: number,
	CraneUntil: number,
	Conns: { RBXScriptConnection },
	ModelConns: { RBXScriptConnection },
	Fading: { { Model: Model, Start: number, Seconds: number, Last: number } },
}

local ctx: any = nil
local interiorFolder: Folder? = nil
local plots: { [number]: PlotInfo } = {}
local active: number? = nil
local activeOwner = 0
local built: { [number]: FloorBuild } = {}
local builtPlot: number? = nil
local builtStage = 0
local queue: { number } = {}
local pools: { [string]: { BasePart } } = { Part = {}, WedgePart = {}, CornerWedgePart = {} }
local prompt: ProximityPrompt? = nil
local respektPrompt: ProximityPrompt? = nil
local helpPrompt: ProximityPrompt? = nil
local night = false
local nightStart = 0
local gateAt = 0
local ledAt = 0
local clock = 0
local lightBudget = 0
local signLang = ""
local uiTick = 0

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function call(name: string, fnName: string, ...: any): (boolean, any, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil, nil
	end
	return pcall(fn, ...)
end

local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

-- Gemeinsame Prompts (Aufzug, Respekt, Bau-Hilfe) wandern zwischen Teilen, die gepoolt (ClearAllChildren), vom Server
-- neu gebaut oder herausgestreamt werden – dabei würde der Prompt mit zerstört (Parent gesperrt). placePrompt hängt
-- ihn sicher um und baut ihn bei Bedarf neu, damit Aufzug/Respekt/Bau-Hilfe nie dauerhaft ausfallen.
local PROMPT_DEFS: { [string]: { Name: string, Key: string, Distance: number } } = {
	Elevator = { Name = "AkyElevator", Key = "tui.elevator.prompt", Distance = 10 },
	Respekt = { Name = "AkyRespekt", Key = "tui.respekt.prompt", Distance = 12 },
	Help = { Name = "AkyHelp", Key = "tui.help.prompt", Distance = 40 },
}

local function makePrompt(name: string, actionKey: string, distance: number): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = name
	p.ActionText = T(actionKey)
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.RequiresLineOfSight = false
	p.MaxActivationDistance = distance
	p.HoldDuration = 0
	p.Style = Enum.ProximityPromptStyle.Default
	return p
end

local function promptVar(kind: string): ProximityPrompt?
	return if kind == "Elevator" then prompt elseif kind == "Respekt" then respektPrompt else helpPrompt
end

local function placePrompt(kind: string, target: Instance?): ProximityPrompt?
	local current = promptVar(kind)
	if current and current.Parent == target then
		return current
	end
	local moved = current ~= nil and pcall(function()
		(current :: ProximityPrompt).Parent = target
	end)
	if moved then
		return current
	end
	local def = PROMPT_DEFS[kind]
	if not def then
		return nil
	end
	local fresh = makePrompt(def.Name, def.Key, def.Distance)
	fresh.Parent = target
	if kind == "Elevator" then
		prompt = fresh
	elseif kind == "Respekt" then
		respektPrompt = fresh
	else
		helpPrompt = fresh
	end
	return fresh
end

local function budget(key: string, default: number): number
	local ok, value = call("Quality", "Budget", key)
	return if ok and type(value) == "number" then value else default
end

local function rootPart(): BasePart?
	local character = player.Character
	local part = character and character:FindFirstChild("HumanoidRootPart")
	return if part and part:IsA("BasePart") then part else nil
end

local function focusPosition(): Vector3?
	local part = rootPart()
	if part then
		return part.Position
	end
	local camera = workspace.CurrentCamera
	return if camera then camera.Focus.Position else nil
end

local function ownPlot(): number?
	local state = ctx and ctx.State
	local plot = state and state.Plot
	local id = if type(plot) == "table" then plot.Id else nil
	if type(id) == "number" and id >= 1 then
		return id
	end
	local attr = player:GetAttribute("Plot")
	return if type(attr) == "number" and attr >= 1 then attr else nil
end

local FH = TowerModels.FloorHeight()
local SLAB = TowerModels.SlabHeight()

local function floorCFrame(info: PlotInfo, floor: number): CFrame
	return info.Pivot * CFrame.new(0, (floor - 1) * FH + SLAB, 0)
end

local function horizontal(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- ---------------------------------------------------------------------
-- 2) POOLS (gleiche Part-Klassen werden weitergereicht – kein Instance.new beim Laufen)
-- ---------------------------------------------------------------------
local function acquire(className: string): BasePart
	local pool = pools[className]
	local part = pool and table.remove(pool)
	if part then
		return part
	end
	return Instance.new(className) :: BasePart
end

local function release(part: BasePart)
	part.Parent = nil
	part:ClearAllChildren()
	for name in pairs(part:GetAttributes()) do
		part:SetAttribute(name, nil)
	end
	part.LocalTransparencyModifier = 0
	local pool = pools[part.ClassName]
	if pool and #pool < POOL_MAX then
		table.insert(pool, part)
	else
		part:Destroy()
	end
end

-- ---------------------------------------------------------------------
-- 3) ANIMATIONS-GRUPPEN (Roboter wippen, Köpfe drehen, Globen kreisen, Fische schwimmen …)
-- ---------------------------------------------------------------------
local function makeGroups(parts: { BasePart }): { AnimGroup }
	local byKey: { [string]: AnimGroup } = {}
	local list: { AnimGroup } = {}
	for _, part in ipairs(parts) do
		local anim = part:GetAttribute("Anim")
		if type(anim) == "string" then
			local key = tostring(part:GetAttribute("Group") or anim) .. ":" .. (if anim == "Head" then "Bob" else anim)
			local group = byKey[key]
			if not group then
				group = {
					Kind = if anim == "Head" then "Bob" else anim,
					Parts = {},
					Base = {},
					Heads = {},
					HeadCenter = nil,
					Center = Vector3.zero,
					Top = -math.huge,
					Phase = (#list * 1.37) % (math.pi * 2),
				}
				byKey[key] = group
				table.insert(list, group)
			end
			table.insert(group.Parts, part)
			table.insert(group.Base, part.CFrame)
			if anim == "Head" then
				group.Heads[#group.Parts] = true
			end
		end
	end
	for _, group in ipairs(list) do
		local sum, headSum, heads = Vector3.zero, Vector3.zero, 0
		for i, part in ipairs(group.Parts) do
			sum += part.Position
			group.Top = math.max(group.Top, part.Position.Y + part.Size.Y / 2)
			if group.Heads[i] then
				headSum += part.Position
				heads += 1
			end
		end
		group.Center = sum / math.max(1, #group.Parts)
		if heads > 0 then
			group.HeadCenter = headSum / heads
		end
	end
	return list
end

local animParts: { BasePart } = {}
local animCFrames: { CFrame } = {}

local function stepGroup(group: AnimGroup, t: number)
	local kind = group.Kind
	local ph = group.Phase
	if kind == "Beacon" then
		local alpha = 0.5 + 0.5 * math.sin(t * 3 + ph)
		for _, part in ipairs(group.Parts) do
			part.Transparency = alpha * 0.7
		end
		return
	end
	local c = group.Center
	local around: CFrame? = nil
	local offset = Vector3.zero
	local headYaw = 0
	if kind == "Bob" then
		offset = Vector3.new(0, math.sin(t * 2.2 + ph) * 0.12, 0)
		headYaw = math.sin(t * 0.9 + ph) * 0.45
	elseif kind == "Spin" then
		around = CFrame.new(c) * CFrame.Angles(0, (t * 0.8 + ph) % (math.pi * 2), 0) * CFrame.new(-c)
	elseif kind == "Sweep" or kind == "Arm" then
		around = CFrame.new(c)
			* CFrame.Angles(0, math.sin(t * 0.6 + ph) * (if kind == "Arm" then 0.9 else 1.0), 0)
			* CFrame.new(-c)
	elseif kind == "Fish" then
		local a = t * 0.9 + ph
		offset = Vector3.new(math.cos(a) * 0.5, math.sin(t * 2 + ph) * 0.08, math.sin(a) * 0.3)
	elseif kind == "Swing" then
		local pivot = Vector3.new(c.X, group.Top, c.Z)
		around = CFrame.new(pivot) * CFrame.Angles(math.sin(t * 1.8 + ph) * 0.22, 0, 0) * CFrame.new(-pivot)
	elseif kind == "Lift" then
		offset = Vector3.new(0, (math.sin(t * 0.5 + ph) + 1) * 0.12, 0)
	elseif kind == "Patrol" then
		offset = Vector3.new(math.sin(t * 0.35 + ph) * 4, math.sin(t * 2.2) * 0.1, 0)
	else
		return
	end
	for i, part in ipairs(group.Parts) do
		local base = group.Base[i]
		local cf = if around then around * base else base + offset
		local hc = group.HeadCenter
		if group.Heads[i] and hc and headYaw ~= 0 then
			cf = CFrame.new(hc + offset) * CFrame.Angles(0, headYaw, 0) * CFrame.new(-hc) * base
		end
		table.insert(animParts, part)
		table.insert(animCFrames, cf)
	end
end

-- ---------------------------------------------------------------------
-- 4) INTERIORS (Etagen ±k, Pools, Zeitbudget)
-- ---------------------------------------------------------------------
local function releaseFloor(floor: number)
	local build = built[floor]
	if not build then
		return
	end
	built[floor] = nil
	-- Aufzugs-Prompt VOR dem Poolen abhängen (release räumt alle Kinder weg = würde ihn zerstören)
	if prompt and build.Door and prompt.Parent == build.Door then
		placePrompt("Elevator", nil)
	end
	for _, part in ipairs(build.Parts) do
		release(part)
	end
end

local function releaseAll()
	for floor in pairs(built) do
		releaseFloor(floor)
	end
	table.clear(queue)
	builtPlot = nil
end

local function chunkOf(info: PlotInfo, floor: number): string
	return info.Chunks[floor] or ""
end

local function lobbyRobots(info: PlotInfo): { any }
	local list: { any } = {}
	local lobby = info.Folder:GetAttribute("Lobby")
	if type(lobby) ~= "string" or lobby == "" then
		return list
	end
	local inner = TowerModels.Footprint(info.Stage, 1) / 2 - 1.4
	if string.find(lobby, "J", 1, true) then
		for _, spec in ipairs(TowerModels.Robot("Janitor", inner * 0.35, inner * 0.6, 180, "Janitor")) do
			table.insert(list, spec)
		end
	end
	if string.find(lobby, "W", 1, true) then
		for _, spec in ipairs(TowerModels.Robot("Security", inner * 0.38, -inner * 0.42, 0, "Security")) do
			local copy = table.clone(spec)
			copy.Anim = if spec.Anim == "Head" then "Head" else "Patrol"
			table.insert(list, copy)
		end
	end
	return list
end

local function buildFloor(info: PlotInfo, floor: number)
	local chunk = chunkOf(info, floor)
	local entries = TowerModels.DecodeLayout(chunk)
	local entry = entries[1]
	local folder = interiorFolder
	if not folder then
		return
	end
	local owner = info.Owner == player.UserId
	local specs: { any }
	if entry and entry.Private and not owner then
		specs = {} -- Privat-Etage: für Besucher nicht einsehbar
	else
		local room = if entry then entry.Room else "Office"
		local level = if entry then entry.Level else 1
		local staff = if entry then entry.Staff else {}
		local decor = if entry then entry.Decor else {}
		specs = TowerModels.Interior(room, level, staff, decor, TowerModels.Footprint(info.Stage, floor), floor)
	end
	if floor == 1 then
		for _, spec in ipairs(lobbyRobots(info)) do
			table.insert(specs, spec)
		end
	end
	local origin = floorCFrame(info, floor)
	local build: FloorBuild =
		{ Floor = floor, Sig = chunk .. "|" .. tostring(info.Stage), Parts = {}, Groups = {}, Lights = {}, Door = nil }
	for _, spec in ipairs(specs) do
		local part = acquire(TowerModels.KindOf(spec))
		TowerModels.Apply(part, spec, origin)
		part.CanQuery = false
		part.Parent = folder
		table.insert(build.Parts, part)
		local light = part:FindFirstChildWhichIsA("Light")
		if light then
			light.Enabled = false
			table.insert(build.Lights, light)
		end
		if spec.Tag == "ElevatorFrame" then
			build.Door = part
		elseif spec.Tag == "ElevatorDoor" then
			-- Türflügel merken: der Aufzug öffnet/schließt sie lokal mit der Kabine (Elevator.Step)
			local doors = build.Doors or {}
			build.Doors = doors
			table.insert(doors, { Part = part, Base = part.CFrame, Side = if spec.Group == "DoorL" then -1 else 1 })
		end
	end
	build.Groups = makeGroups(build.Parts)
	built[floor] = build
end

-- Welche Etagen sollen stehen? Aktueller Stock ± k (k aus der Grafikstufe)
local function wantedFloors(info: PlotInfo, current: number): { [number]: boolean }
	local k = math.clamp(math.floor(budget("InteriorRadius", 1)), 0, 6)
	local wanted: { [number]: boolean } = {}
	if info.Floors <= 0 then
		return wanted
	end
	for f = math.max(1, current - k), math.min(info.Floors, current + k) do
		wanted[f] = true
	end
	wanted[math.clamp(current, 1, info.Floors)] = true
	return wanted
end

local function currentFloor(info: PlotInfo): number
	local pos = focusPosition()
	if not pos then
		return 1
	end
	local localPos = info.Pivot:PointToObjectSpace(pos)
	return math.clamp(math.floor((localPos.Y - 0.5) / FH) + 1, 1, math.max(1, info.Floors))
end

local interiorLightsOn = 0 -- WorldLook zieht sie vom Licht-Budget der Stadt ab (Summe bleibt ≤ Budget je Stufe)

local function updateLights(current: number)
	local cap = math.max(2, math.floor(lightBudget / 2))
	local used = 0
	for floor, build in pairs(built) do
		local near = math.abs(floor - current) <= 1
		for _, light in ipairs(build.Lights) do
			local on = near and used < cap
			if on then
				used += 1
			end
			if light.Enabled ~= on then
				light.Enabled = on
			end
		end
	end
	interiorLightsOn = used
end

local function processInteriors(info: PlotInfo?)
	if not info or info.Floors <= 0 then
		if builtPlot then
			releaseAll()
		end
		interiorLightsOn = 0
		return
	end
	if builtPlot ~= info.Plot or builtStage ~= info.Stage then
		releaseAll()
		builtPlot = info.Plot
		builtStage = info.Stage
	end
	local current = currentFloor(info)
	local wanted = wantedFloors(info, current)
	-- nicht mehr gewollt oder veraltet -> zurück in den Pool
	for floor, build in pairs(built) do
		if not wanted[floor] or build.Sig ~= chunkOf(info, floor) .. "|" .. tostring(info.Stage) then
			releaseFloor(floor)
		end
	end
	-- fehlende Etagen in die Warteschlange (nächste zuerst)
	table.clear(queue)
	for floor in pairs(wanted) do
		if not built[floor] then
			table.insert(queue, floor)
		end
	end
	table.sort(queue, function(a, b)
		return math.abs(a - current) < math.abs(b - current)
	end)
	local started = os.clock()
	while #queue > 0 and os.clock() - started < BUILD_BUDGET do
		local floor = table.remove(queue, 1) :: number
		local ok, err = pcall(buildFloor, info, floor)
		if not ok then
			warn("[TowerView] Etage " .. floor .. ": " .. tostring(err))
			built[floor] = {
				Floor = floor,
				Sig = chunkOf(info, floor) .. "|" .. tostring(info.Stage),
				Parts = {},
				Groups = {},
				Lights = {},
			}
		end
	end
	updateLights(current)
	-- Aufzugs-Panel-Knopf an der Tür des aktuellen Stocks (EG zusätzlich am Lobby-Panel)
	local build = built[current]
	local target: Instance? = if build and build.Door then build.Door elseif current == 1 then info.Panel else nil
	local p = placePrompt("Elevator", target)
	if p and p.Parent then
		p.ObjectText = T("tui.floorLabel", current)
	end
end

-- ---------------------------------------------------------------------
-- 5) PLOTS: Attribute, Hülle (Server-Teile), Schild, LED, Fensterlichter
-- ---------------------------------------------------------------------
local function splitLayout(text: string): { string }
	local chunks: { string } = {}
	if text == "" then
		return chunks
	end
	for chunk in string.gmatch(text .. ";", "([^;]*);") do
		table.insert(chunks, chunk)
		if #chunks >= 50 then
			break
		end
	end
	return chunks
end

local function towerNameText(info: PlotInfo): string
	local raw = info.Folder:GetAttribute("Name")
	local a, n = 1, 1
	if type(raw) == "string" then
		local sa, sn = string.match(raw, "^(%d+):(%d+)$")
		a, n = tonumber(sa) or 1, tonumber(sn) or 1
	end
	local towerCfg = ctx.Config.Tower
	if type(towerCfg) == "table" and type(towerCfg.NameText) == "function" then
		local ok, text = pcall(towerCfg.NameText, a, n, lang())
		if ok and type(text) == "string" then
			return text
		end
	end
	return T("tui.title")
end

local function licenceName(index: number): string
	local progression = ctx.Config.Progression
	local list = if type(progression) == "table" then progression.Licences else nil
	local entry = if type(list) == "table" then list[index] else nil
	if type(entry) == "table" and type(entry.Name) == "table" then
		return ctx.Lang.Pick(lang(), entry.Name)
	end
	return T("tui.licenceLevel", index)
end

-- Plot-Schild: Besitzer, Tower-Name (Wortbausteine, lokalisiert), Lizenz, Titel
local function refreshSign(info: PlotInfo)
	local part = info.Sign
	if not part or part.Parent == nil then
		return
	end
	local gui = part:FindFirstChild("AkySign") :: SurfaceGui?
	if not gui then
		local created = Instance.new("SurfaceGui")
		created.Name = "AkySign"
		created.Face = Enum.NormalId.Front
		created.LightInfluence = 0
		created.Brightness = 1.6
		created.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		created.PixelsPerStud = 40
		created.MaxDistance = 220
		local frame = UI.Create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Bg,
			BackgroundTransparency = 0.05,
			Parent = created,
		}, { UI.Create("UIStroke", { Color = Theme.Accent, Thickness = 3, Transparency = 0.3 }) })
		UI.Label({
			Name = "Owner",
			Position = UDim2.fromScale(0.05, 0.06),
			Size = UDim2.fromScale(0.9, 0.3),
			Face = "Display",
			TextColor3 = Theme.Text,
			MaxText = 60,
			Parent = frame,
		})
		UI.Label({
			Name = "Tower",
			Position = UDim2.fromScale(0.05, 0.38),
			Size = UDim2.fromScale(0.9, 0.24),
			TextColor3 = Theme.Accent,
			MaxText = 48,
			Parent = frame,
		})
		UI.Label({
			Name = "Meta",
			Position = UDim2.fromScale(0.05, 0.66),
			Size = UDim2.fromScale(0.9, 0.26),
			TextColor3 = Theme.Text2,
			MaxText = 36,
			Parent = frame,
		})
		created.Parent = part
		gui = created
	end
	local g = gui :: SurfaceGui
	local frame = g:FindFirstChildOfClass("Frame")
	if not frame then
		return
	end
	local ownerLabel = frame:FindFirstChild("Owner") :: TextLabel?
	local towerLabel = frame:FindFirstChild("Tower") :: TextLabel?
	local metaLabel = frame:FindFirstChild("Meta") :: TextLabel?
	local ownerName = info.Folder:GetAttribute("OwnerName")
	local owner = if info.Owner > 0 then Players:GetPlayerByUserId(info.Owner) else nil
	if ownerLabel then
		ownerLabel.Text = if type(ownerName) == "string" and ownerName ~= "" then ownerName else T("tui.plotFree")
	end
	if towerLabel then
		towerLabel.Text = if info.Owner > 0 then towerNameText(info) else ""
	end
	if metaLabel then
		local parts: { string } = {}
		local licence = owner and owner:GetAttribute("Licence")
		if type(licence) == "number" then
			table.insert(parts, licenceName(licence))
		end
		local title = owner and owner:GetAttribute("Title")
		if type(title) == "string" and title ~= "" then
			table.insert(parts, title)
		end
		if info.Owner > 0 then
			table.insert(parts, T("tui.floorsShort", info.Floors))
		end
		metaLabel.Text = table.concat(parts, "  ·  ")
	end
end

-- Fassaden-LED: AKX36-Tagesfarbe (nie das eigene G/V, §B4.9)
local function refreshLeds(info: PlotInfo)
	if #info.Leds == 0 then
		return
	end
	local ok, close, change = call("MarketClient", "Quote", AKX36)
	local delta = if ok and type(change) == "number" then change else 0
	local color = if delta > 0 then UI.UpColor() elseif delta < 0 then UI.DownColor() else Theme.Accent
	local arrow = UI.TrendArrow(delta)
	local pctText = ""
	if ok and type(close) == "number" and close > 0 then
		local fraction = delta / math.max(1, close - delta)
		local okPct, text = pcall(ctx.Format.Pct, fraction, lang(), 2, true)
		pctText = if okPct then text else ""
	end
	for _, part in ipairs(info.Leds) do
		if part.Parent then
			part.Color = color
			part.Material = Enum.Material.Neon
			local gui = part:FindFirstChild("AkyLed") :: SurfaceGui?
			if not gui then
				local created = Instance.new("SurfaceGui")
				created.Name = "AkyLed"
				local face = part:GetAttribute("Face")
				created.Face = if type(face) == "string" and (Enum.NormalId :: any)[face]
					then (Enum.NormalId :: any)[face]
					else Enum.NormalId.Front
				created.LightInfluence = 0
				created.Brightness = 2
				created.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				created.PixelsPerStud = 12
				created.MaxDistance = 600
				UI.Label({
					Name = "Text",
					Size = UDim2.fromScale(1, 1),
					Face = "Display",
					TextColor3 = Color3.new(1, 1, 1),
					MaxText = 120,
					Parent = created,
				})
				created.Parent = part
				gui = created
			end
			local label = (gui :: SurfaceGui):FindFirstChild("Text") :: TextLabel?
			if label then
				label.Text = ("AKX36  %s  %s"):format(arrow, pctText)
			end
		end
	end
end

local function scanModel(info: PlotInfo)
	info.ScanDirty = false
	table.clear(info.Bands)
	table.clear(info.Leds)
	table.clear(info.Anim)
	info.Sign, info.VaultRing, info.Respekt, info.Panel = nil, nil, nil, nil
	info.NightLit = 0
	local model = info.Model
	if not model or model.Parent == nil then
		return
	end
	local animated: { BasePart } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local tag = d:GetAttribute("Tag")
			if tag == "Neon" and d:GetAttribute("Floor") ~= nil then
				table.insert(info.Bands, d)
			end
			if d:GetAttribute("Led") == true then
				table.insert(info.Leds, d)
			end
			if d:GetAttribute("PlotSign") == true then
				info.Sign = d
			elseif d:GetAttribute("VaultRing") == true then
				info.VaultRing = d
			elseif d:GetAttribute("Respekt") == true then
				info.Respekt = d
			elseif d:GetAttribute("ElevatorPanel") == true then
				info.Panel = d
			end
			if d:GetAttribute("Anim") ~= nil then
				table.insert(animated, d)
			end
		end
	end
	table.sort(info.Bands, function(a, b)
		return num(a:GetAttribute("Floor"), 0) < num(b:GetAttribute("Floor"), 0)
	end)
	info.Anim = makeGroups(animated)
	refreshSign(info)
	refreshLeds(info)
	-- neue Hülle (Neubau/Morph/Streaming): Respekt-Knopf an die neue Säule hängen
	if info.Plot == active then
		local target = if info.Owner > 0 and info.Owner ~= player.UserId then info.Respekt else nil
		placePrompt("Respekt", target)
	end
end

local function attachModel(info: PlotInfo, model: Model)
	for _, conn in ipairs(info.ModelConns) do
		conn:Disconnect()
	end
	table.clear(info.ModelConns)
	info.Model = model
	info.ScanDirty = true
	table.insert(
		info.ModelConns,
		model.DescendantAdded:Connect(function()
			info.ScanDirty = true
		end)
	)
	table.insert(
		info.ModelConns,
		model.DescendantRemoving:Connect(function()
			info.ScanDirty = true
		end)
	)
end

-- Alte Hülle blendet aus (Morph/Abbau): der Server benennt die VORHANDENE Hülle um und setzt "Fading" – das kommt
-- als Attribut-Änderung, nicht als ChildAdded an (nur hereingestreamte Hüllen tragen es schon beim Einhängen).
local function startFade(info: PlotInfo, model: Model)
	for _, entry in ipairs(info.Fading) do
		if entry.Model == model then
			return
		end
	end
	if info.Model == model then
		info.Model = nil
		info.ScanDirty = true
		for _, conn in ipairs(info.ModelConns) do
			conn:Disconnect()
		end
		table.clear(info.ModelConns)
	end
	local seconds = num(model:GetAttribute("FadeSeconds"), 2)
	table.insert(info.Fading, { Model = model, Start = os.clock(), Seconds = math.clamp(seconds, 0.3, 5), Last = 0 })
end

local function onModelAdded(info: PlotInfo, child: Instance)
	if not child:IsA("Model") then
		return
	end
	if child:GetAttribute("Fading") == true then
		startFade(info, child)
	elseif child.Name == "Tower" then
		attachModel(info, child)
		call("EffectsTower", "OnTowerModel", info.Plot, child)
		-- eigene Verbindung (nicht ModelConns: die trennt attachModel der NEUEN Hülle schon vorher)
		child:GetAttributeChangedSignal("Fading"):Once(function()
			if child.Parent ~= nil and child:GetAttribute("Fading") == true then
				startFade(info, child)
			end
		end)
	end
end

local function readAttributes(info: PlotInfo)
	local f = info.Folder
	local pivot = f:GetAttribute("Pivot")
	if typeof(pivot) == "CFrame" then
		info.Pivot = pivot
	end
	info.Owner = math.floor(num(f:GetAttribute("Owner"), 0))
	info.Stage = math.clamp(math.floor(num(f:GetAttribute("Stage"), 1)), 1, 12)
	info.Floors = math.clamp(math.floor(num(f:GetAttribute("Floors"), 0)), 0, 50)
	local layout = f:GetAttribute("Layout")
	info.Layout = if type(layout) == "string" then layout else ""
	info.Chunks = splitLayout(info.Layout)
	info.Fx = f:GetAttribute("Fx") == true
end

local function ensurePlot(folder: Instance)
	if not folder:IsA("Folder") then
		return
	end
	local plot = folder:GetAttribute("Plot")
	if type(plot) ~= "number" then
		plot = tonumber(string.match(folder.Name, "^Plot(%d+)$"))
	end
	if type(plot) ~= "number" or plot < 1 or plot > MAX_PLOTS or plots[plot] then
		return
	end
	local info: PlotInfo = {
		Plot = plot,
		Folder = folder :: Folder,
		Pivot = CFrame.identity,
		Owner = 0,
		Stage = 1,
		Floors = 0,
		Layout = "",
		Chunks = {},
		Model = nil,
		Bands = {},
		Leds = {},
		Anim = {},
		Sign = nil,
		VaultRing = nil,
		Respekt = nil,
		Panel = nil,
		ScanDirty = false,
		NightLit = 0,
		Fx = false,
		Crane = nil,
		CraneHook = nil,
		CraneFloor = 0,
		CraneUntil = 0,
		Conns = {},
		ModelConns = {},
		Fading = {},
	}
	plots[plot] = info
	readAttributes(info)
	table.insert(
		info.Conns,
		folder.AttributeChanged:Connect(function(name: string)
			local oldOwner = info.Owner
			readAttributes(info)
			if name == "Owner" and oldOwner ~= info.Owner and info.Owner == 0 then
				call("EffectsTower", "Teardown", info.Plot)
			end
			if name == "Owner" or name == "OwnerName" or name == "Name" or name == "Floors" then
				refreshSign(info)
			end
		end)
	)
	table.insert(
		info.Conns,
		folder.ChildAdded:Connect(function(child: Instance)
			onModelAdded(info, child)
		end)
	)
	table.insert(
		info.Conns,
		folder.ChildRemoved:Connect(function(child: Instance)
			if info.Model == child then
				info.Model = nil
				info.ScanDirty = true
			end
		end)
	)
	for _, child in ipairs(folder:GetChildren()) do
		onModelAdded(info, child)
	end
end

local function watchRoot()
	task.spawn(function()
		local folder = workspace:WaitForChild(FOLDER_NAME, 60)
		if not folder or not folder:IsA("Folder") then
			warn("[TowerView] " .. FOLDER_NAME .. " fehlt – keine Tower-Ansicht")
			return
		end
		for _, child in ipairs(folder:GetChildren()) do
			ensurePlot(child)
		end
		folder.ChildAdded:Connect(ensurePlot)
	end)
end

-- ---------------------------------------------------------------------
-- 6) FENSTERLICHTER (Kaskade von unten nach oben) + Neon-Fassaden-Kit-Muster
-- ---------------------------------------------------------------------
local DAY_MATERIAL = Enum.Material.Glass
local NIGHT_MATERIAL = Enum.Material.Neon

local function bandFloor(part: BasePart): number
	return num(part:GetAttribute("Floor"), 0)
end

local function fxAlpha(pattern: number, floor: number, floors: number, t: number): number
	if pattern == 1 then
		return if (floor + math.floor(t * 4)) % 4 == 0 then 0 else 0.8
	elseif pattern == 2 then
		return 0.45 + 0.45 * math.sin(t * 3 + floor * 0.4)
	elseif pattern == 3 then
		return 0.45 + 0.45 * math.sin(t * 4)
	elseif pattern == 4 then
		return if (floor + math.floor(t * 2)) % 2 == 0 then 0 else 0.75
	elseif pattern == 5 then
		return if floor <= (t * 10) % (floors + 6) then 0 else 0.85
	elseif pattern == 6 then
		return if floor >= floors - (t * 10) % (floors + 6) then 0 else 0.85
	elseif pattern == 7 then
		local h = (floor * 73856093 + math.floor(t * 6) * 19349663) % 1000
		return if h > 480 then 0 else 0.8
	end
	return 0
end

local function stepLights(info: PlotInfo, t: number, cameraPos: Vector3)
	local bands = info.Bands
	if #bands == 0 then
		return
	end
	if night then
		local lit = math.floor((t - nightStart) / NIGHT_STEP)
		if lit > info.NightLit then
			for _, part in ipairs(bands) do
				local f = bandFloor(part)
				if f > info.NightLit and f <= lit and part.Parent then
					part.Material = NIGHT_MATERIAL
					part.Transparency = 0
				end
			end
			info.NightLit = lit
		end
		-- Neon-Fassaden-Kit: 8 Lichtmuster im Wechsel (nur nachts, nur in Sichtweite)
		if info.Fx and info.NightLit >= info.Floors and horizontal(cameraPos, info.Pivot.Position) < 900 then
			local pattern = math.floor(t / FX_PERIOD) % 8 + 1
			for _, part in ipairs(bands) do
				if part.Parent then
					part.Transparency = fxAlpha(pattern, bandFloor(part), info.Floors, t)
				end
			end
		end
	elseif info.NightLit ~= -1 then
		for _, part in ipairs(bands) do
			if part.Parent then
				part.Material = DAY_MATERIAL
				part.Transparency = 0.2
			end
		end
		info.NightLit = -1
	end
end

-- Alte Hülle (Morph/Abbau) ausblenden: von oben nach unten (Abbau) bzw. gleichmäßig (Morph)
local function stepFading(info: PlotInfo, t: number)
	for i = #info.Fading, 1, -1 do
		local entry = info.Fading[i]
		local model = entry.Model
		local alpha = math.clamp((t - entry.Start) / entry.Seconds, 0, 1)
		if model.Parent == nil or alpha >= 1 then
			table.remove(info.Fading, i)
		elseif t - entry.Last >= 0.05 then -- 20 Hz reichen für das Ausblenden
			entry.Last = t
			local teardown = info.Owner == 0
			local floorsVal = math.max(1, num(model:GetAttribute("Floors"), info.Floors))
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					local fade = alpha
					if teardown then
						local f = num(d:GetAttribute("Floor"), floorsVal + 1)
						local order = 1 - (f / (floorsVal + 1))
						fade = math.clamp((alpha - order * 0.7) / 0.3, 0, 1)
					end
					d.LocalTransparencyModifier = fade
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- 7) KRAN (Baustelle sichtbar für alle; Bau-Hilfe für Besucher, §B4.7)
-- ---------------------------------------------------------------------
local function destroyCrane(info: PlotInfo)
	-- Bau-Hilfe-Prompt VOR dem Zerstören des Masts abhängen (sonst wird er mit zerstört)
	if helpPrompt and helpPrompt.Parent and helpPrompt.Parent:GetAttribute("CranePlot") == info.Plot then
		placePrompt("Help", nil)
	end
	if info.Crane then
		for _, part in ipairs(info.Crane) do
			part:Destroy()
		end
	end
	info.Crane = nil
	info.CraneHook = nil
	info.CraneFloor = 0
end

local function buildCrane(info: PlotInfo, floor: number)
	destroyCrane(info)
	local folder = interiorFolder
	if not folder then
		return
	end
	local stage = TowerModels.StageOf(math.max(1, floor))
	local size = TowerModels.Footprint(stage, math.max(1, floor))
	local half = size / 2
	local roofY = math.max(0, floor - 1) * FH
	local base = info.Pivot * CFrame.new(half - 3, roofY, half - 3)
	local parts: { BasePart } = {}
	local function part(sz: Vector3, cf: CFrame, color: Color3, material: Enum.Material, neon: boolean?): BasePart
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = not neon
		p.Size = sz
		p.CFrame = cf
		p.Color = color
		p.Material = material
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p:SetAttribute("CranePlot", info.Plot)
		p.Parent = folder
		table.insert(parts, p)
		return p
	end
	local yellow = Color3.fromRGB(250, 204, 21)
	local dark = Color3.fromRGB(31, 41, 55)
	local mastH = 26
	local mast = part(Vector3.new(2, mastH, 2), base * CFrame.new(0, mastH / 2, 0), yellow, Enum.Material.DiamondPlate)
	part(Vector3.new(3, 2, 3), base * CFrame.new(0, mastH + 1, 0), dark, Enum.Material.Metal)
	part(
		Vector3.new(30, 1.2, 1.2),
		base * CFrame.new(-11, mastH + 2.6, -11) * CFrame.Angles(0, math.rad(45), 0),
		yellow,
		Enum.Material.DiamondPlate
	)
	part(
		Vector3.new(9, 1.2, 1.2),
		base * CFrame.new(4, mastH + 2.6, 4) * CFrame.Angles(0, math.rad(45), 0),
		yellow,
		Enum.Material.DiamondPlate
	)
	part(Vector3.new(3, 2.4, 3), base * CFrame.new(6, mastH + 1.6, 6), dark, Enum.Material.Concrete)
	part(
		Vector3.new(0.6, 0.6, 0.6),
		base * CFrame.new(0, mastH + 4.2, 0),
		Color3.fromRGB(239, 68, 68),
		Enum.Material.Neon,
		true
	)
	local hookTop = base * CFrame.new(-16, mastH + 2, -16)
	local hook = part(Vector3.new(1.4, 1.2, 1.4), hookTop * CFrame.new(0, -8, 0), dark, Enum.Material.Metal)
	part(Vector3.new(0.15, 8, 0.15), hookTop * CFrame.new(0, -4, 0), Color3.fromRGB(125, 136, 154), Enum.Material.Metal)
	-- Gerüst-Ring an der Baustelle (Etage floor)
	local ring = info.Pivot * CFrame.new(0, roofY + FH / 2, 0)
	local w = size + 3
	local orange = Color3.fromRGB(245, 158, 11)
	part(Vector3.new(w, 0.4, 0.4), ring * CFrame.new(0, 0, -w / 2), orange, Enum.Material.Neon, true)
	part(Vector3.new(w, 0.4, 0.4), ring * CFrame.new(0, 0, w / 2), orange, Enum.Material.Neon, true)
	part(Vector3.new(0.4, 0.4, w), ring * CFrame.new(-w / 2, 0, 0), orange, Enum.Material.Neon, true)
	part(Vector3.new(0.4, 0.4, w), ring * CFrame.new(w / 2, 0, 0), orange, Enum.Material.Neon, true)
	-- Hologramm mit Restzeit über dem Kran
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "CraneInfo"
	billboard.Size = UDim2.fromOffset(220, 52)
	billboard.StudsOffset = Vector3.new(0, mastH / 2 + 7, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 400
	billboard.LightInfluence = 0
	local panel = UI.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.15,
		Parent = billboard,
	}, { UI.Corner(12), UI.Create("UIStroke", { Color = Theme.Warn, Thickness = 1, Transparency = 0.3 }) })
	UI.Label({
		Name = "Text",
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -20, 1, -8),
		Face = "MonoBold",
		TextColor3 = Theme.Text,
		MaxText = 22,
		Parent = panel,
	})
	billboard.Parent = mast
	info.Crane = parts
	info.CraneHook = hook
	info.CraneFloor = floor
	mast:SetAttribute("CraneMast", true)
end

local function stepCrane(info: PlotInfo, now: number, cameraPos: Vector3)
	local floor = math.floor(num(info.Folder:GetAttribute("BuildFloor"), 0))
	local untilUnix = num(info.Folder:GetAttribute("BuildUntil"), 0)
	local local_ = info.CraneUntil > now and info.CraneFloor > 0
	local wanted = if floor > 0 then floor elseif local_ then info.CraneFloor else 0
	local inRange = horizontal(cameraPos, info.Pivot.Position) < 700
	if wanted <= 0 or not inRange or info.Owner == 0 then
		if info.Crane then
			destroyCrane(info)
		end
		return
	end
	if not info.Crane or info.CraneFloor ~= wanted then
		buildCrane(info, wanted)
	end
	local crane = info.Crane
	local mast = crane and crane[1]
	local billboard = mast and mast:FindFirstChild("CraneInfo")
	local label = billboard and billboard:FindFirstChild("Text", true) :: TextLabel?
	if label then
		local remaining = math.max(0, untilUnix - now)
		local okFmt, text = pcall(ctx.Format.Duration, remaining, lang())
		label.Text = T("tui.crane", wanted, if okFmt then text else tostring(math.floor(remaining)))
	end
	-- Bau-Hilfe für Besucher (nicht der Besitzer)
	if mast and floor > 0 and info.Owner ~= player.UserId and info.Plot == active then
		local hp = placePrompt("Help", mast)
		if hp and hp:GetAttribute("Owner") ~= info.Owner then
			hp:SetAttribute("Owner", info.Owner)
		end
	end
end

-- ---------------------------------------------------------------------
-- 8) INTERAKTION: Kassen-Tor, Aufzug, Respekt, Bau-Hilfe
-- ---------------------------------------------------------------------
local function stepGate(info: PlotInfo, now: number)
	if info.Owner ~= player.UserId then
		return
	end
	local part = rootPart()
	if not part or now - gateAt < GATE_GAP then
		return
	end
	local tower = ctx.State.Tower
	local vault = if type(tower) == "table" then num(tower.Vault, 0) else 0
	if vault <= 0 then
		return
	end
	local half = TowerModels.Footprint(info.Stage, 1) / 2
	local localPos = info.Pivot:PointToObjectSpace(part.Position)
	local gateZ = -half - 10
	if math.abs(localPos.X) <= 4.6 and math.abs(localPos.Z - gateZ) <= 1.8 and localPos.Y < 11 then
		gateAt = now
		task.spawn(function()
			ctx.RequestFull("TowerCollect", {}, true)
		end)
	end
end

local function stepVaultGlow(info: PlotInfo, t: number)
	local ring = info.VaultRing
	if not ring or ring.Parent == nil then
		return
	end
	local full = false
	if info.Owner == player.UserId then
		local tower = ctx.State.Tower
		if type(tower) == "table" then
			local cap = num(tower.VaultCap, 0)
			full = cap > 0 and num(tower.Vault, 0) >= cap
		end
	end
	if full then
		ring.Color = Theme.Down
		ring.Transparency = 0.3 + 0.3 * math.sin(t * 5)
	elseif ring.Color ~= Theme.Gold or ring.Transparency ~= 0 then
		ring.Color = Theme.Gold
		ring.Transparency = 0
	end
end

local function setupPrompts()
	placePrompt("Elevator", nil)
	placePrompt("Respekt", nil)
	placePrompt("Help", nil)
	ProximityPromptService.PromptTriggered:Connect(function(p: ProximityPrompt, who: Player)
		if who ~= player then
			return
		end
		if p == prompt then
			local plot = TowerView.InsideTower() or active
			if plot then
				call("Elevator", "OpenPanel", plot)
			end
		elseif p == respektPrompt then
			local info = if active then plots[active] else nil
			if info and info.Owner > 0 and info.Owner ~= player.UserId then
				task.spawn(function()
					ctx.RequestFull("SocialRespekt", { UserId = info.Owner })
				end)
			end
		elseif p == helpPrompt then
			local owner = p:GetAttribute("Owner")
			if type(owner) == "number" and owner > 0 then
				task.spawn(function()
					ctx.RequestFull("TowerHelp", { OwnerUserId = owner })
				end)
			end
		end
	end)
end

local function refreshPromptTexts()
	if prompt then
		prompt.ActionText = T("tui.elevator.prompt")
	end
	if respektPrompt then
		respektPrompt.ActionText = T("tui.respekt.prompt")
	end
	if helpPrompt then
		helpPrompt.ActionText = T("tui.help.prompt")
	end
end

-- ---------------------------------------------------------------------
-- 9) AKTIVER TOWER (Hooks Plot:Enter/Plot:Leave)
-- ---------------------------------------------------------------------
local function pickActive(pos: Vector3): number?
	local best: number? = nil
	local bestDist = math.huge
	for plot, info in pairs(plots) do
		if info.Owner > 0 then
			local d = horizontal(pos, info.Pivot.Position)
			if d <= ACTIVE_RANGE and d < bestDist then
				best, bestDist = plot, d
			end
		end
	end
	return best
end

local function setActive(plot: number?)
	local owner = if plot and plots[plot] then plots[plot].Owner else 0
	if plot == active and owner == activeOwner then
		return
	end
	if active then
		ctx.Hooks.Fire("Plot:Leave", active, activeOwner)
	end
	active = plot
	activeOwner = owner
	if plot then
		ctx.Hooks.Fire("Plot:Enter", plot, owner)
	end
	-- Respekt-Knopf nur an fremden Säulen
	local info = if plot then plots[plot] else nil
	local target = if info and info.Owner > 0 and info.Owner ~= player.UserId then info.Respekt else nil
	placePrompt("Respekt", target)
end

-- ---------------------------------------------------------------------
-- 10) ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function TowerView.InsideTower(): number?
	local part = rootPart()
	if not part then
		return nil
	end
	for plot, info in pairs(plots) do
		if info.Owner > 0 and info.Floors > 0 then
			local localPos = info.Pivot:PointToObjectSpace(part.Position)
			local floor = math.clamp(math.floor((localPos.Y - 0.5) / FH) + 1, 1, info.Floors)
			local half = TowerModels.Footprint(info.Stage, floor) / 2 + 1
			if
				math.abs(localPos.X) <= half
				and math.abs(localPos.Z) <= half
				and localPos.Y > -2
				and localPos.Y < info.Floors * FH + 3
			then
				return plot
			end
		end
	end
	return nil
end

function TowerView.ActivePlot(): number?
	return active
end

function TowerView.OwnPlot(): number?
	return ownPlot()
end

function TowerView.PlotFolder(plot: number): Folder?
	local info = plots[plot]
	return if info then info.Folder else nil
end

function TowerView.TowerModel(plot: number): Model?
	local info = plots[plot]
	local model = info and info.Model
	return if model and model.Parent then model else nil
end

function TowerView.PlotInfo(plot: number): { [string]: any }?
	local info = plots[plot]
	if not info then
		return nil
	end
	local name = info.Folder:GetAttribute("Name")
	return {
		Pivot = info.Pivot,
		Stage = info.Stage,
		Floors = info.Floors,
		Owner = info.Owner,
		OwnerName = info.Folder:GetAttribute("OwnerName"),
		Name = if type(name) == "string" then name else "1:1",
		TowerName = if info.Owner > 0 then towerNameText(info) else "",
		Layout = info.Layout,
		Skin = info.Folder:GetAttribute("Skin"),
		Neon = info.Folder:GetAttribute("Neon"),
		Crown = info.Folder:GetAttribute("Crown"),
	}
end

function TowerView.Plots(): { number }
	local list: { number } = {}
	for plot in pairs(plots) do
		table.insert(list, plot)
	end
	table.sort(list)
	return list
end

function TowerView.FloorOf(position: Vector3, plot: number): number
	local info = plots[plot]
	if not info then
		return 1
	end
	local localPos = info.Pivot:PointToObjectSpace(position)
	return math.clamp(math.floor((localPos.Y - 0.5) / FH) + 1, 1, math.max(1, info.Floors))
end

function TowerView.CurrentFloor(): number?
	local plot = TowerView.InsideTower()
	local part = rootPart()
	if not plot or not part then
		return nil
	end
	return TowerView.FloorOf(part.Position, plot)
end

function TowerView.FloorCFrame(plot: number, floor: number): CFrame?
	local info = plots[plot]
	if not info then
		return nil
	end
	return floorCFrame(info, math.clamp(math.floor(floor), 1, math.max(1, info.Floors)))
end

function TowerView.TopCFrame(plot: number): CFrame?
	local info = plots[plot]
	if not info then
		return nil
	end
	return info.Pivot * CFrame.new(0, info.Floors * FH, 0)
end

-- Aufzugstüren einer gebauten Etage des aktiven Towers öffnen (0 = zu, 1 = offen); false = Etage nicht gebaut
function TowerView.SetDoors(plot: number, floor: number, openness: number): boolean
	if plot ~= builtPlot then
		return false
	end
	local build = built[floor]
	local doors = build and build.Doors
	if not doors then
		return false
	end
	local slide = math.clamp(num(openness, 0), 0, 1) * 2.25
	for _, door in ipairs(doors) do
		if door.Part.Parent then
			door.Part.CFrame = door.Base * CFrame.new(door.Side * slide, 0, 0)
		end
	end
	return true
end

-- eingeschaltete Interior-Lichter (für das gemeinsame Licht-Budget in WorldLook)
function TowerView.InteriorLights(): number
	return interiorLightsOn
end

function TowerView.NeonBands(plot: number): { BasePart }
	local info = plots[plot]
	return if info then table.clone(info.Bands) else {}
end

-- Kran sofort zeigen (Effekt "Crane" kommt vor dem Attribut); seconds = Szenen-/Bauzeit
function TowerView.ShowCrane(plot: number, floor: number, seconds: number)
	local info = plots[plot]
	if not info then
		return
	end
	info.CraneFloor = math.max(1, math.floor(num(floor, 1)))
	info.CraneUntil = workspace:GetServerTimeNow() + math.clamp(num(seconds, 3), 1, 6) + 1
	local pos = focusPosition()
	if pos then
		stepCrane(info, workspace:GetServerTimeNow(), pos)
	end
end

function TowerView.CraneHook(plot: number): BasePart?
	local info = plots[plot]
	return if info then info.CraneHook else nil
end

-- ---------------------------------------------------------------------
-- 11) FRAME (ein PreRender-Loop) & LEBENSZYKLUS
-- ---------------------------------------------------------------------
function TowerView.Frame(dt: number)
	clock += dt
	local t = os.clock()
	local now = workspace:GetServerTimeNow()
	local pos = focusPosition()
	local camera = workspace.CurrentCamera
	local cameraPos = if camera then camera.CFrame.Position else (pos or Vector3.zero)
	-- Tag/Nacht: dieselbe Schaltung wie die Stadt-Fenster (WorldLook: Schwellen aus Config.City.Look + Overrides
	-- wie "Night"/"Golden" in Kamerafahrten); ohne WorldLook die Server-Uhr
	local okNight, isNight = call("WorldLook", "IsNight")
	if not okNight then
		okNight, isNight = pcall(ctx.Clock.IsNight, ctx.Clock.Tick())
	end
	local nowNight = okNight and isNight == true
	if nowNight ~= night then
		night = nowNight
		nightStart = t
		for _, info in pairs(plots) do
			info.NightLit = 0 -- Nacht: Kaskade von unten; Tag: einmal zurück auf Glas
		end
	end
	if pos then
		setActive(pickActive(pos))
	end
	if signLang ~= lang() then
		signLang = lang()
		refreshPromptTexts()
		for _, info in pairs(plots) do
			refreshSign(info)
		end
	end
	-- Interiors des aktiven Towers
	processInteriors(if active then plots[active] else nil)
	-- Animationen: Interior-Gruppen nah an der Kamera + Kronen sichtbarer Tower
	table.clear(animParts)
	table.clear(animCFrames)
	if pos and active then
		local info = plots[active]
		local current = if info then currentFloor(info) else 1
		for floor, build in pairs(built) do
			if math.abs(floor - current) <= 1 then
				for _, group in ipairs(build.Groups) do
					if (group.Center - cameraPos).Magnitude <= ANIM_RANGE then
						stepGroup(group, t)
					end
				end
			end
		end
	end
	local refreshLed = t - ledAt >= LED_GAP
	if refreshLed then
		ledAt = t
	end
	for _, info in pairs(plots) do
		if info.ScanDirty then
			scanModel(info)
		end
		local distance = horizontal(cameraPos, info.Pivot.Position)
		if info.Model and distance < CROWN_RANGE then
			for _, group in ipairs(info.Anim) do
				stepGroup(group, t)
			end
		end
		if info.Model then
			stepLights(info, t, cameraPos)
			if refreshLed and distance < 700 then
				refreshLeds(info)
			end
			stepVaultGlow(info, t)
		end
		if #info.Fading > 0 then
			stepFading(info, t)
		end
		if pos then
			stepCrane(info, now, cameraPos)
		end
	end
	if #animParts > 0 then
		workspace:BulkMoveTo(animParts, animCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
	if active and plots[active] then
		stepGate(plots[active], now)
	end
	-- Schritte der anderen WP8-Module (kein zweiter Render-Loop)
	call("EffectsTower", "Step", dt)
	call("Elevator", "Step", dt)
	call("Boutique", "Step", dt)
	uiTick += dt
	if uiTick >= 1 then
		uiTick = 0
		call("TowerUI", "Tick")
		call("WelcomeBack", "Tick")
	end
end

function TowerView.Init(context: any)
	ctx = context
	local folder = Instance.new("Folder")
	folder.Name = "AkyInteriors" -- nur lokal (Client), wird nicht repliziert
	folder.Parent = workspace
	interiorFolder = folder
	lightBudget = budget("Lights", 16)
	ctx.Hooks.On("Quality", function()
		lightBudget = budget("Lights", 16)
	end)
	setupPrompts()
end

function TowerView.Start()
	watchRoot()
end

return TowerView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="161">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Die ersten 10 Minuten mit Tiko (Client/Modules/Tutorial)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §B2 (Ablauf 0:04–9:30, Funnel
--  3–17, jeder Schritt überspringbar, „Tutorial überspringen“ gibt dieselben Belohnungen, KEIN Robux-Angebot),
--  §0.5 (Tiko = geskripteter Hologramm-Roboter, keine KI, keine Anlageberatung), §B8.6 (Übungsaktie ACAD),
--  §B11.9 (Favoriten-Abfrage 1× je Konto, Benachrichtigungs-Opt-in frühestens nach Schritt 17), §C7.5.
--
--  Öffentliche API (§C7.5):
--    Tutorial.Step(): number       aktueller Schritt (0 = noch nicht entschieden, 3–17 aktiv, 18 = fertig)
--    Tutorial.IsActive(): boolean  läuft das Tutorial gerade? (WelcomeBack wartet darauf)
--  Zusätzlich: Tutorial.Init(ctx), Tutorial.Start(), Tutorial.Tick() (1 s aus Main.client)
--
--  Schritt-Nummern = Funnel-Schritte (§B2). Der Client meldet nur FlyInDone (3), FavoritePrompted (16), Done/Skipped
--  über "TutorialFlag"; die übrigen Funnel-Schritte schreiben die Server-Besitzer (Bauen, Kassieren, Trade, Lektion …).
--  Fortschritt liegt serverseitig in Flags.TutStep (RewardTutorial) -> nach einem Neustart geht es dort weiter.
--  Anfragen: TutorialFlag, RewardTutorial, TowerBuild, TowerCollect, TowerTransfer, TowerRoom, TowerHire,
--  TowerEfficiency, CarSpawn, RewardLogin.  Module: Terminal, Academy, Vehicles, WelcomeBack, Social, Sfx, Effects.
-- =====================================================================

local AvatarEditorService = game:GetService("AvatarEditorService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))

local Tutorial = {}

local Theme = UI.Theme
local player = Players.LocalPlayer

local FIRST_STEP = 3
local LAST_STEP = 17
local DONE_STEP = 18
local CARD_W, CARD_H = 384, 192
local MINI_W, MINI_H = 300, 92
local TYPE_STEP = 0.022 -- Sekunden je Schriftzeichen (Schreibmaschine)
local MAX_GRAPHEMES = 240
local CHAIN_GAP = 1.2 -- verkettetes Bauen (Etagen 2–5): Abstand zwischen zwei Aufträgen
local CLAIM_GAP = 0.6 -- RewardTutorial höchstens so oft (Server-Rate 2/s)
local WAYPOINT_RENEW = 80 -- Wegpunkt läuft nach 90 s ab -> rechtzeitig erneuern
local START_WAIT = 12 -- so lange auf den Plot warten, sonst Anflug überspringen
local ENTRANCE_RADIUS = 45
local SELL_HINT_AFTER = 20 -- Übungs-Trade: nach so vielen Sekunden „Verkaufen“-Satz
local LICENCE_HOLD = 7 -- Lizenz-Zeremonie: so lange bleibt der Glückwunsch stehen (dann automatisch weiter)
local TIKO_OFFSET = CFrame.new(3.6, 2.4, -5)
local TIKO_TWEEN = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
local CARD_IN = TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local CARD_MOVE = TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local PULSE_INFO = TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)

local ctx: any = nil
local step = 0
local active = false
local decided = false
local decideSince = 0
local phase = 1
local phaseAt = 0
local busy = false
local chain = false
local lastChainAt = 0
local vaultMax = 0
local collectedOk = false
local transferOk = false
local flyDone = false
local favoriteDone = false
local finished = false
local waypointAt = 0
local claimWanted = 0
local claimSent = 0
local lastClaimAt = 0
local renderSig = ""
local typeToken = 0

local card: { [string]: any } = {}
local tikoRoot: BasePart? = nil
local tikoModel: Model? = nil
local tikoBob = false
local hologram: Model? = nil
local flyTween: Tween? = nil
local flyConn: RBXScriptConnection? = nil
local flyHint: TextLabel? = nil
local pulseTween: Tween? = nil

-- vorwärts deklariert (gegenseitige Aufrufe)
local evaluate: () -> ()
local render: () -> ()

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

local function stateOf(key: string): { [string]: any }
	local s = ctx.State[key]
	return if type(s) == "table" then s else {}
end

local function cfg(): { [string]: any }
	local p = ctx.Config.Progression
	local t = type(p) == "table" and p.Tutorial or nil
	return if type(t) == "table" then t else {}
end

local function reducedFx(): boolean
	local ok, settings = call("Settings", "Get")
	return ok and type(settings) == "table" and settings.ReducedFx == true
end

local function sfx(role: string)
	call("Sfx", "Play", role)
end

local function floors(): number
	return math.floor(num(stateOf("Tower").Floors, 0))
end

local function rootPart(): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function seated(): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.SeatPart ~= nil
end

-- Mitte des eigenen Plots (TowerView bevorzugt, sonst Config.City.Plots: R 420, 18° + (Id − 1) · 36°)
local function plotCenter(): Vector3?
	local id = stateOf("Plot").Id
	if type(id) ~= "number" or id < 1 then
		return nil
	end
	local ok, info = call("TowerView", "PlotInfo", id)
	if ok and type(info) == "table" and typeof(info.Pivot) == "CFrame" then
		return (info.Pivot :: CFrame).Position
	end
	local city = ctx.Config.City
	local plots = type(city) == "table" and city.Plots or nil
	local radius = num(plots and plots.Radius, 420)
	local angle = math.rad(num(plots and plots.StartAngle, 18) + (id - 1) * num(plots and plots.Step, 36))
	return Vector3.new(radius * math.cos(angle), 0, radius * math.sin(angle))
end

local function exchangeCenter(): Vector3
	local city = ctx.Config.City
	local zones = type(city) == "table" and city.Zones or nil
	local exchange = type(zones) == "table" and zones.Exchange or nil
	local center = if type(exchange) == "table" and typeof(exchange.Center) == "Vector3"
		then exchange.Center
		else Vector3.new(0, 0, -190)
	return center
end

-- Eingang des Börsensaals: Vorderseite zur Plaza (+Z)
local function exchangeEntrance(): Vector3
	local city = ctx.Config.City
	local zones = type(city) == "table" and city.Zones or nil
	local exchange = type(zones) == "table" and zones.Exchange or nil
	local depth = num(type(exchange) == "table" and exchange.Depth or nil, 140)
	return exchangeCenter() + Vector3.new(0, 0, depth / 2)
end

local function nearExchange(): boolean
	local root = rootPart()
	if not root then
		return false
	end
	local pos = Vector3.new(root.Position.X, 0, root.Position.Z)
	local center = exchangeCenter()
	local entrance = exchangeEntrance()
	return (pos - Vector3.new(center.X, 0, center.Z)).Magnitude <= num(cfg().ExchangeRadius, 70)
		or (pos - Vector3.new(entrance.X, 0, entrance.Z)).Magnitude <= ENTRANCE_RADIUS
end

local function floorHasStaff(index: number): boolean
	local list = stateOf("Tower").List
	local floor = type(list) == "table" and list[index] or nil
	return type(floor) == "table" and type(floor.S) == "table" and next(floor.S) ~= nil
end

local function floorRoom(index: number): string?
	local list = stateOf("Tower").List
	local floor = type(list) == "table" and list[index] or nil
	return if type(floor) == "table" and type(floor.R) == "string" then floor.R else nil
end

local function roomName(key: string): string
	local tower = ctx.Config.Tower
	local rooms = type(tower) == "table" and tower.Rooms or nil
	if type(rooms) == "table" then
		for _, def in ipairs(rooms) do
			if type(def) == "table" and def.Key == key and type(def.Name) == "table" then
				return ctx.Lang.Pick(lang(), def.Name)
			end
		end
	end
	return key
end

-- Anfrage ohne Doppelklick; onOk läuft nur bei Erfolg, danach wird der Schritt neu bewertet
local function request(action: string, arg: any, onOk: ((any) -> ())?, onFail: ((any) -> ())?)
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		local reply = ctx.RequestFull(action, arg)
		busy = false
		if reply.Ok then
			if onOk then
				onOk(reply)
			end
		elseif onFail then
			onFail(reply)
		end
		evaluate()
	end)
end

-- Schritt-Belohnung (RewardTutorial vergibt alles ≤ Schritt einmalig; höchstens alle 0,6 s eine Anfrage)
local function flushClaim()
	if claimWanted <= claimSent or os.clock() - lastClaimAt < CLAIM_GAP then
		return
	end
	local wanted = claimWanted
	claimSent = wanted
	lastClaimAt = os.clock()
	task.spawn(function()
		local reply = ctx.RequestFull("RewardTutorial", { Step = wanted }, false)
		if not reply.Ok and claimSent == wanted then
			claimSent = wanted - 1 -- später erneut versuchen (z. B. Profil lädt noch)
		end
	end)
end

local function queueClaim(n: number)
	if n > claimWanted then
		claimWanted = n
	end
	flushClaim()
end

local function sendFlag(flag: string)
	task.spawn(function()
		ctx.RequestFull("TutorialFlag", { Flag = flag }, true)
	end)
end

-- ---------------------------------------------------------------------
-- 2) TIKO IN DER WELT (Hologramm-Roboter aus Parts, nur lokal) + Plot-Hologramm
-- ---------------------------------------------------------------------
local function worldPart(props: { [string]: any }, parent: Instance): BasePart
	local part = Instance.new("Part")
	part.Anchored = props.Anchored == true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Shape = props.Shape or Enum.PartType.Block
	part.Size = props.Size
	part.Material = props.Material or Enum.Material.SmoothPlastic
	part.Color = props.Color or Theme.Text
	part.Transparency = props.Transparency or 0
	part.Name = props.Name or "Part"
	part.CFrame = props.CFrame or CFrame.new()
	part.Parent = parent
	return part
end

local function buildTiko(at: CFrame)
	local model = Instance.new("Model")
	model.Name = "AT_Tiko"
	local root = worldPart({
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.2, 2.2, 2.2),
		Material = Enum.Material.Glass,
		Color = Theme.Cyan,
		Transparency = 0.18,
		Anchored = true,
		CFrame = at,
	}, model)
	local parts: { BasePart } = {
		worldPart({
			Name = "Visor",
			Size = Vector3.new(1.55, 0.7, 0.3),
			Material = Enum.Material.Glass,
			Color = Theme.Bg,
			CFrame = at * CFrame.new(0, 0.18, -0.98),
		}, model),
		worldPart({
			Name = "EyeL",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.28, 0.28, 0.28),
			Material = Enum.Material.Neon,
			Color = Theme.LogoLetters,
			CFrame = at * CFrame.new(-0.34, 0.2, -1.16),
		}, model),
		worldPart({
			Name = "EyeR",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.28, 0.28, 0.28),
			Material = Enum.Material.Neon,
			Color = Theme.LogoLetters,
			CFrame = at * CFrame.new(0.34, 0.2, -1.16),
		}, model),
		worldPart({
			Name = "Antenna",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.7, 0.12, 0.12),
			Material = Enum.Material.Metal,
			Color = Theme.Text2,
			CFrame = at * CFrame.new(0, 1.38, 0) * CFrame.Angles(0, 0, math.pi / 2),
		}, model),
		worldPart({
			Name = "Tip",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.34, 0.34, 0.34),
			Material = Enum.Material.Neon,
			Color = Theme.Accent,
			CFrame = at * CFrame.new(0, 1.8, 0),
		}, model),
		worldPart({
			Name = "Ring",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.12, 2.8, 2.8),
			Material = Enum.Material.Neon,
			Color = Theme.Cyan,
			Transparency = 0.55,
			CFrame = at * CFrame.new(0, -1.55, 0) * CFrame.Angles(0, 0, math.pi / 2),
		}, model),
	}
	for _, part in ipairs(parts) do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = root
	end
	local light = Instance.new("PointLight")
	light.Color = Theme.Cyan
	light.Range = 10
	light.Brightness = 1.4
	light.Parent = parts[5]
	-- Details: Augen blinzeln alle ~4 s, Hologramm-Funken am Ring (nicht bei „Reduzierte Effekte“)
	local blink = TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1, true, 3.8)
	for _, eye in ipairs({ parts[2], parts[3] }) do
		TweenService:Create(eye, blink, { Size = Vector3.new(0.28, 0.04, 0.28) }):Play()
	end
	if not reducedFx() then
		local sparks = Instance.new("ParticleEmitter")
		sparks.Name = "HoloSparks"
		sparks.Color = ColorSequence.new(Theme.Cyan, Theme.Accent)
		sparks.LightEmission = 1
		sparks.LightInfluence = 0
		sparks.Lifetime = NumberRange.new(0.6, 1.1)
		sparks.Rate = 5
		sparks.Speed = NumberRange.new(0.6, 1.4)
		sparks.SpreadAngle = Vector2.new(180, 20)
		sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0) })
		sparks.Transparency = NumberSequence.new(0.2, 1)
		sparks.Parent = parts[6]
	end
	model.PrimaryPart = root
	model.Parent = workspace
	tikoModel = model
	tikoRoot = root
end

local function removeTiko()
	local model = tikoModel
	tikoModel = nil
	tikoRoot = nil
	if model then
		model:Destroy()
	end
end

-- 1×/s: Tiko schwebt rechts vor dem Spieler und schaut ihn an (im Auto/während des Anflugs unsichtbar)
local function moveTiko()
	local root = rootPart()
	if not active or flyTween ~= nil or not root or seated() then
		removeTiko()
		return
	end
	tikoBob = not tikoBob
	local base = root.CFrame * TIKO_OFFSET
	local pos = base.Position + Vector3.new(0, if tikoBob then 0.35 else -0.15, 0)
	local target = CFrame.lookAt(pos, root.Position + Vector3.new(0, 1.5, 0))
	local body = tikoRoot
	if not body or not body.Parent then
		buildTiko(target)
		return
	end
	if (body.Position - pos).Magnitude > 60 then
		body.CFrame = target
		return
	end
	TweenService:Create(body, TIKO_TWEEN, { CFrame = target }):Play()
end

local function showHologram()
	if hologram and hologram.Parent then
		return
	end
	local center = plotCenter()
	if not center then
		return
	end
	local model = Instance.new("Model")
	model.Name = "AT_TutorialHologram"
	worldPart({
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 46, 46),
		Material = Enum.Material.Neon,
		Color = Theme.Gold,
		Transparency = 0.7,
		Anchored = true,
		CFrame = CFrame.new(center + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.pi / 2),
	}, model)
	-- Licht-Säule über dem Grundstück (aus dem Kamera-Anflug gut sichtbar), atmet langsam
	local pillar = worldPart({
		Name = "Pillar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(70, 2.4, 2.4),
		Material = Enum.Material.Neon,
		Color = Theme.Gold,
		Transparency = 0.82,
		Anchored = true,
		CFrame = CFrame.new(center + Vector3.new(0, 35, 0)) * CFrame.Angles(0, 0, math.pi / 2),
	}, model)
	if not reducedFx() then
		TweenService:Create(
			pillar,
			TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Transparency = 0.93 }
		):Play()
	end
	local anchor = worldPart({
		Name = "Label",
		Size = Vector3.new(1, 1, 1),
		Transparency = 1,
		Anchored = true,
		CFrame = CFrame.new(center + Vector3.new(0, 18, 0)),
	}, model)
	local board = Instance.new("BillboardGui")
	board.Size = UDim2.fromOffset(420, 64)
	board.AlwaysOnTop = true
	board.LightInfluence = 0
	board.MaxDistance = 900
	board.Parent = anchor
	local label = UI.Label({
		Size = UDim2.fromScale(1, 1),
		Text = UI.Upper(T("tut.hologram")),
		Face = "Display",
		TextColor3 = Theme.Gold,
		MaxText = 30,
		Outline = 1,
		Parent = board,
	})
	label.TextStrokeTransparency = 1
	model.Parent = workspace
	hologram = model
end

local function hideHologram()
	local model = hologram
	hologram = nil
	if model then
		model:Destroy()
	end
end

-- ---------------------------------------------------------------------
-- 3) KAMERA-ANFLUG (Schritt 3): Skyline -> Plaza -> eigener Plot, jede Eingabe überspringt
-- ---------------------------------------------------------------------
local function endFlyIn()
	local conn = flyConn
	flyConn = nil
	if conn then
		conn:Disconnect()
	end
	local tween = flyTween
	flyTween = nil
	if tween then
		tween:Cancel()
	end
	local hint = flyHint
	flyHint = nil
	if hint then
		hint:Destroy()
	end
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
	if not flyDone then
		flyDone = true
		sendFlag("FlyInDone")
	end
	if active then
		evaluate()
	end
end

local function startFlyIn()
	local camera = workspace.CurrentCamera
	local center = plotCenter()
	if not camera or not center then
		endFlyIn()
		return
	end
	showHologram()
	local flat = Vector3.new(center.X, 0, center.Z)
	local dir = if flat.Magnitude > 1 then flat.Unit else Vector3.new(1, 0, 0)
	local startPos = -dir * 380 + Vector3.new(0, 240, 0) -- hoch über der Plaza, gegenüber dem Plot
	local endPos = center - dir * 95 + Vector3.new(0, 46, 0) -- zwischen Plaza und Plot, Blick auf das Grundstück
	local seconds = num(cfg().FlyInSeconds, 4)
	if reducedFx() then
		seconds = math.min(seconds, 1.5)
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(startPos, Vector3.new(0, 20, 0))
	local tween = TweenService:Create(
		camera,
		TweenInfo.new(seconds, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
		{ CFrame = CFrame.lookAt(endPos, center + Vector3.new(0, 8, 0)) }
	)
	flyTween = tween
	flyHint = UI.Label({
		Name = "TutorialFlyHint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.fromOffset(360, 26),
		Text = T("tut.flyHint"),
		TextColor3 = Theme.Text2,
		MaxText = 18,
		Outline = 1,
		ZIndex = 45,
		Parent = ctx.Gui,
	})
	flyConn = UserInputService.InputBegan:Connect(function(input: InputObject)
		local kind = input.UserInputType
		if
			kind == Enum.UserInputType.Keyboard
			or kind == Enum.UserInputType.MouseButton1
			or kind == Enum.UserInputType.Touch
			or kind == Enum.UserInputType.Gamepad1
		then
			endFlyIn()
		end
	end)
	tween.Completed:Once(function(playback: Enum.PlaybackState)
		if playback == Enum.PlaybackState.Completed and flyTween == tween then
			task.delay(0.6, function()
				if flyTween == tween then
					endFlyIn()
				end
			end)
		end
	end)
	tween:Play()
end

-- ---------------------------------------------------------------------
-- 4) TIKO-KARTE (Glas-Karte links, Schreibmaschine; bei offenem Fenster kompakt)
-- ---------------------------------------------------------------------
local function compact(): boolean
	local windows = ctx.Windows
	return windows ~= nil and type(windows.IsOpen) == "function" and windows.IsOpen() == true
end

local function typeText(label: TextLabel, text: string)
	typeToken += 1
	local token = typeToken
	label.Text = text
	local count = math.min(utf8.len(text) or #text, MAX_GRAPHEMES)
	if reducedFx() or count <= 0 then
		label.MaxVisibleGraphemes = -1
		return
	end
	label.MaxVisibleGraphemes = 0
	task.spawn(function()
		for i = 1, count do
			if typeToken ~= token or not label.Parent then
				return
			end
			label.MaxVisibleGraphemes = i
			task.wait(TYPE_STEP)
		end
		if typeToken == token then
			label.MaxVisibleGraphemes = -1
		end
	end)
end

local function buildCard()
	local panel = UI.Panel({
		Name = "TikoCard",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(CARD_W, CARD_H),
		ZIndex = 40,
		Visible = false,
		Parent = ctx.Gui,
	})
	local scale = UI.Create("UIScale", { Scale = 1, Parent = panel })
	-- Avatar: runder Glas-Kopf mit Visier und zwei Augen
	local avatar = UI.Create("Frame", {
		Name = "Avatar",
		Position = UDim2.fromOffset(14, 14),
		Size = UDim2.fromOffset(48, 48),
		BackgroundColor3 = Theme.Cyan,
		BackgroundTransparency = 0.2,
		ZIndex = 41,
		Parent = panel,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.Stroke(Theme.Cyan, 2),
	})
	local visor = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(34, 16),
		BackgroundColor3 = Theme.Bg,
		ZIndex = 42,
		Parent = avatar,
	}, { UI.Corner(8) })
	for i = 1, 2 do
		UI.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, if i == 1 then -7 else 7, 0.5, 0),
			Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = Theme.LogoLetters,
			ZIndex = 43,
			Parent = visor,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	end
	local name = UI.Label({
		Name = "Name",
		Position = UDim2.fromOffset(72, 14),
		Size = UDim2.new(1, -190, 0, 24),
		Text = UI.Upper(T("tut.title")),
		Face = "Display",
		TextColor3 = Theme.Cyan,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 18,
		ZIndex = 41,
		Parent = panel,
	})
	local tag = UI.Label({
		Name = "Tag",
		Position = UDim2.fromOffset(72, 38),
		Size = UDim2.new(1, -190, 0, 18),
		Text = T("tut.tag"),
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 13,
		ZIndex = 41,
		Parent = panel,
	})
	local counter = UI.Label({
		Name = "Counter",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(60, 20),
		Text = "",
		Face = "Mono",
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxText = 14,
		ZIndex = 41,
		Parent = panel,
	})
	local skipAll = UI.Button({
		Name = "SkipAll",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 36),
		Size = UDim2.fromOffset(150, 24),
		Text = T("tut.skip"),
		Variant = "Ghost",
		MaxText = 12,
		ZIndex = 41,
		Parent = panel,
	}, function()
		Tutorial._SkipAll()
	end)
	local text = UI.Label({
		Name = "Text",
		Position = UDim2.fromOffset(14, 70),
		Size = UDim2.new(1, -28, 0, 58),
		Text = "",
		Face = "Body",
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		MaxText = 17,
		ZIndex = 41,
		Parent = panel,
	})
	local row = UI.Create("Frame", {
		Name = "Actions",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -12),
		Size = UDim2.new(1, -28, 0, 44),
		BackgroundTransparency = 1,
		ZIndex = 41,
		Parent = panel,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})
	local action = UI.Button({
		Name = "Action",
		Size = UDim2.new(1, -118, 1, 0),
		Text = "",
		Variant = "Primary",
		MaxText = 18,
		LayoutOrder = 1,
		ZIndex = 42,
		Parent = row,
	}, function()
		Tutorial._Action()
	end)
	local actionScale = UI.Create("UIScale", { Scale = 1, Parent = action.Frame })
	local skipStep = UI.Button({
		Name = "SkipStep",
		Size = UDim2.fromOffset(110, 40),
		Text = T("tut.skipStep"),
		Variant = "Secondary",
		MaxText = 15,
		LayoutOrder = 2,
		ZIndex = 42,
		Parent = row,
	}, function()
		Tutorial._SkipStep()
	end)
	-- Abteilungs-Wahl (Schritt 9): drei Karten, Trading-Desk empfohlen
	local choices = UI.Create("Frame", {
		Name = "Choices",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -62),
		Size = UDim2.new(1, -28, 0, 50),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 41,
		Parent = panel,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		}),
	})
	local choiceButtons: { [string]: any } = {}
	local list = cfg().RoomChoices
	if type(list) == "table" then
		for i, key in ipairs(list) do
			if type(key) == "string" then
				local recommended = key == cfg().Recommended
				choiceButtons[key] = UI.Button({
					Name = "Room_" .. key,
					Size = UDim2.new(1 / 3, -4, 1, 0),
					Text = roomName(key),
					Sub = if recommended then T("tut.room.recommended") else nil,
					Variant = if recommended then "Success" else "Secondary",
					MaxText = 15,
					LayoutOrder = i,
					ZIndex = 42,
					Parent = choices,
				}, function()
					Tutorial._ChooseRoom(key)
				end)
			end
		end
	end
	card = {
		Panel = panel,
		Scale = scale,
		Name = name,
		Tag = tag,
		Counter = counter,
		SkipAll = skipAll,
		Text = text,
		Row = row,
		Action = action,
		ActionScale = actionScale,
		SkipStep = skipStep,
		Choices = choices,
		ChoiceButtons = choiceButtons,
		Compact = false,
	}
end

local function setPulse(on: boolean)
	local tween = pulseTween
	if on and not tween and card.ActionScale then
		card.ActionScale.Scale = 1
		local newTween = TweenService:Create(card.ActionScale, PULSE_INFO, { Scale = 1.06 })
		pulseTween = newTween
		newTween:Play()
	elseif not on and tween then
		tween:Cancel()
		pulseTween = nil
		card.ActionScale.Scale = 1
	end
end

local function layoutCard()
	local panel: Frame? = card.Panel
	if not panel then
		return
	end
	local small = compact()
	if small == card.Compact then
		return
	end
	card.Compact = small
	TweenService:Create(panel, CARD_MOVE, {
		Size = if small then UDim2.fromOffset(MINI_W, MINI_H) else UDim2.fromOffset(CARD_W, CARD_H),
		Position = if small then UDim2.new(0, 16, 0.32, 0) else UDim2.new(0, 16, 0.5, 0),
	}):Play()
	card.Tag.Visible = not small
	card.SkipAll.Frame.Visible = not small
	card.Row.Visible = not small
	card.Text.Position = if small then UDim2.fromOffset(72, 40) else UDim2.fromOffset(14, 70)
	card.Text.Size = if small then UDim2.new(1, -86, 0, 44) else UDim2.new(1, -28, 0, 58)
	renderSig = ""
end

local function showCard(on: boolean)
	local panel: Frame? = card.Panel
	if not panel then
		return
	end
	if on and not panel.Visible then
		panel.Visible = true
		card.Scale.Scale = 0.85
		TweenService:Create(card.Scale, CARD_IN, { Scale = 1 }):Play()
	elseif not on and panel.Visible then
		panel.Visible = false
		setPulse(false)
	end
end

-- ---------------------------------------------------------------------
-- 5) SCHRITTE: Texte, Knopf, Erledigt-Prüfung
-- ---------------------------------------------------------------------
type View = { Lines: { string }, Button: string?, Choices: boolean? }

local function viewOf(n: number): View
	local tower = stateOf("Tower")
	if n == 4 then
		return { Lines = { "tut.s.welcome" }, Button = "tut.btn.build" }
	elseif n == 5 then
		return { Lines = { "tut.s.floor1", "tut.s.collect" }, Button = "tut.btn.collect" }
	elseif n == 6 then
		if stateOf("Depot").Tutorial == "Running" then
			if os.clock() - phaseAt >= SELL_HINT_AFTER then
				return { Lines = { "tut.s.sell" }, Button = "tut.btn.terminal" }
			end
			return { Lines = { "tut.s.tradeHint", "tut.s.protect" }, Button = "tut.btn.terminal" }
		end
		return { Lines = { "tut.s.trade" }, Button = "tut.btn.trade" }
	elseif n == 7 then
		return { Lines = { "tut.s.transfer" }, Button = "tut.btn.transfer" }
	elseif n == 8 then
		local lines = { if num(tower.Stage, 1) >= 3 then "tut.s.loft" else "tut.s.floors" }
		local nextInfo = type(tower.Next) == "table" and tower.Next or {}
		local cost = num(nextInfo.Cost, 0)
		if
			cost > 0
			and num(ctx.State.Credits, 0) < cost
			and type(tower.Build) == "table"
			and tower.Build.Floor == nil
		then
			table.insert(lines, "tut.waitingMoney")
		end
		return { Lines = lines, Button = "tut.btn.build" }
	elseif n == 9 then
		if phase == 1 then
			return { Lines = { "tut.s.room" }, Choices = true }
		end
		return { Lines = { "tut.s.staff" }, Button = "tut.btn.hire" }
	elseif n == 10 then
		return { Lines = { "tut.s.janitor" }, Button = "tut.btn.janitor" }
	elseif n == 11 then
		return { Lines = { "tut.s.live" }, Button = "tut.btn.terminal" }
	elseif n == 12 then
		if phase == 1 then
			return { Lines = { "tut.s.quests" }, Button = "tut.btn.quests" }
		elseif phase == 2 then
			return { Lines = { "tut.s.car" }, Button = "tut.btn.car" }
		end
		return { Lines = { "tut.s.drive" } }
	elseif n == 13 then
		return { Lines = { "tut.s.lesson" }, Button = "tut.btn.lesson" }
	elseif n == 14 then
		if phase == 2 then
			return { Lines = { "tut.s.licenceDone" }, Button = "tut.next" }
		end
		local exams = stateOf("Prog").Exams
		if type(exams) ~= "table" or not exams.ProtectPair then
			-- Übung und Live-Trade übersprungen: Prüfungs-Aufgabe „Schutz-Paar“ fehlt noch -> Weg zum Terminal zeigen
			return { Lines = { "tut.s.licencePair" }, Button = "tut.btn.terminal" }
		end
		return { Lines = { "tut.s.licence" } }
	elseif n == 15 then
		return { Lines = { "tut.s.eff" }, Button = "tut.btn.eff" }
	elseif n == 16 then
		return { Lines = { "tut.s.future" }, Button = "tut.next" }
	elseif n == 17 then
		if phase == 1 then
			return { Lines = { "tut.s.login" }, Button = "tut.btn.login" }
		end
		return { Lines = { "tut.s.done" }, Button = "tut.btn.done" }
	end
	return { Lines = {} }
end

local function isDone(n: number): boolean
	local tower = stateOf("Tower")
	local flags = stateOf("Flags")
	if n == 3 then
		return flyDone or flags.FlyInDone == true
	elseif n == 4 then
		return floors() >= 1
	elseif n == 5 then
		local vault = num(tower.Vault, 0)
		return collectedOk or (vaultMax >= 1 and vault <= vaultMax * 0.5)
	elseif n == 6 then
		return stateOf("Depot").Tutorial == "Done" or flags.TutorialTrade == true
	elseif n == 7 then
		return transferOk
	elseif n == 8 then
		return floors() >= math.floor(num(cfg().StageFloors, 5))
	elseif n == 9 then
		return floorHasStaff(2)
	elseif n == 10 then
		return tower.Janitor == true
	elseif n == 11 then
		return flags.FirstLiveTrade == true
	elseif n == 12 then
		return phase >= 3 and nearExchange()
	elseif n == 13 then
		local lessons = stateOf("Prog").Lessons
		return type(lessons) == "table" and lessons.L01 ~= nil
	elseif n == 14 then
		return phase == 2 and os.clock() - phaseAt >= LICENCE_HOLD
	elseif n == 15 then
		return num(tower.Eff, 0) >= 1
	elseif n == 16 then
		return favoriteDone or flags.FavoritePrompted == true
	end
	return false -- 17 endet nur über den Knopf
end

local function setPhase(p: number)
	phase = p
	phaseAt = os.clock()
	renderSig = ""
end

-- Betreten eines Schritts: Zähler zurücksetzen, Einstiegs-Aktionen
local function enter(n: number)
	step = n
	setPhase(1)
	chain = false
	collectedOk = false
	transferOk = false
	if n == 3 then
		showCard(false)
		startFlyIn()
		return
	end
	if n >= 5 then
		hideHologram()
	elseif n == 4 then
		showHologram()
	end
	if n == 5 then
		vaultMax = num(stateOf("Tower").Vault, 0)
	elseif n == 6 and stateOf("Depot").Tutorial == "Running" then
		setPhase(2)
	elseif n == 9 then
		-- Etage 2 hat schon eine gewählte Abteilung (nicht das Standard-Büro) -> gleich zum Personal
		local tower = ctx.Config.Tower
		local default = if type(tower) == "table" and type(tower.DefaultRoom) == "string"
			then tower.DefaultRoom
			else "Office"
		local room = floorRoom(2)
		if room and room ~= default then
			setPhase(2)
		end
	elseif n == 12 and nearExchange() then
		setPhase(3)
	elseif n == 14 then
		queueClaim(14) -- die Schritt-XP bringen die 300 XP für Azubi II
	elseif n == 16 then
		call("WelcomeBack", "ShowFuture")
	elseif n == 17 then
		if stateOf("Login").Claimable ~= true then
			setPhase(2)
		end
	end
	sfx("Notify")
	showCard(true)
end

local function cleanup()
	active = false
	setPulse(false)
	if flyTween or flyConn then
		endFlyIn()
	end
	removeTiko()
	hideHologram()
	call("Vehicles", "Waypoint", nil)
	local panel = card.Panel
	if panel then
		panel:Destroy()
	end
	card = {}
end

local function advance()
	queueClaim(step)
	if step >= LAST_STEP then
		return
	end
	enter(step + 1)
end

-- ---------------------------------------------------------------------
-- 6) AKTIONEN (Knöpfe der Karte)
-- ---------------------------------------------------------------------
local function finish()
	if finished then
		return
	end
	finished = true
	claimWanted = math.max(claimWanted, LAST_STEP)
	lastClaimAt = 0 -- letzte Belohnung sofort anfragen (nicht drosseln)
	flushClaim()
	sendFlag("Done")
	step = DONE_STEP
	cleanup()
	sfx("Achievement")
	if not reducedFx() then
		call("Effects", "Confetti", 1)
	end
	-- positiver Moment nach Schritt 17: einmal das Benachrichtigungs-Opt-in anbieten (§B11.9)
	task.delay(3, function()
		call("Social", "PromptNotify")
	end)
end

function Tutorial._Action()
	if not active or busy then
		return
	end
	local n = step
	if n == 4 then
		request("TowerBuild", {})
	elseif n == 5 then
		request("TowerCollect", {}, function()
			collectedOk = true
		end)
	elseif n == 6 then
		call("Terminal", "OpenPractice")
		if phase == 1 then
			setPhase(2)
		end
	elseif n == 7 then
		request("TowerTransfer", {}, function()
			transferOk = true
		end)
	elseif n == 8 then
		chain = true
		lastChainAt = os.clock()
		request("TowerBuild", {})
	elseif n == 9 and phase == 2 then
		request("TowerHire", { Floor = 2, Staff = tostring(cfg().FirstStaff or "Intern") })
	elseif n == 10 then
		request("TowerHire", { Floor = 0, Staff = "Janitor" })
	elseif n == 11 then
		local inst = math.floor(num(cfg().SuggestInst, 40))
		local ok = call("Terminal", "OpenAt", inst)
		if not ok then
			ctx.Windows.Open("Terminal")
		end
	elseif n == 12 then
		if phase == 1 then
			-- direkt auf den Starter-Reiter (sonst springt das Fenster bei offenem Login-Tag auf "Login")
			local ok = call("Quests", "Open", "starter")
			if not ok then
				ctx.Windows.Open("Quests")
			end
			setPhase(2)
		elseif phase == 2 then
			local entrance = exchangeEntrance()
			local function toExchange()
				setPhase(3)
				waypointAt = os.clock()
				call("Vehicles", "Waypoint", entrance)
			end
			request("CarSpawn", { Key = "LamCity" }, toExchange, toExchange)
		end
	elseif n == 13 then
		local ok = call("Academy", "OpenLesson", "L01")
		if not ok then
			ctx.Windows.Open("Academy")
		end
	elseif n == 14 then
		if phase == 2 then
			advance()
		else
			local ok = call("Terminal", "OpenAt", math.floor(num(cfg().SuggestInst, 40)))
			if not ok then
				ctx.Windows.Open("Terminal")
			end
		end
	elseif n == 15 then
		request("TowerEfficiency", {})
	elseif n == 16 then
		-- Favoriten-Abfrage genau einmal je Konto (Flags.FavoritePrompted), pcall – Studio/alte Clients dürfen scheitern
		if stateOf("Flags").FavoritePrompted ~= true then
			pcall(function()
				AvatarEditorService:PromptSetFavorite(game.PlaceId, Enum.AvatarItemType.Asset, true)
			end)
			sendFlag("FavoritePrompted")
		end
		favoriteDone = true
	elseif n == 17 then
		if phase == 1 then
			request("RewardLogin", {}, function()
				setPhase(2)
			end, function()
				setPhase(2)
			end)
		else
			finish()
			return
		end
	end
	evaluate()
end

function Tutorial._ChooseRoom(key: string)
	if not active or step ~= 9 or phase ~= 1 or busy then
		return
	end
	if floorRoom(2) == key then
		setPhase(2)
		render()
		return
	end
	request("TowerRoom", { Floor = 2, Room = key }, function()
		setPhase(2)
	end)
end

function Tutorial._SkipStep()
	if not active or busy then
		return
	end
	if step >= LAST_STEP then
		finish()
		return
	end
	-- Unterphasen gelten als ein Schritt: überspringen = ganzer Schritt
	advance()
	evaluate()
end

function Tutorial._SkipAll()
	if not active then
		return
	end
	finished = true
	step = DONE_STEP
	cleanup()
	task.spawn(function()
		ctx.RequestFull("RewardTutorial", { Step = math.floor(num(cfg().SkipStep, 99)) }, false)
		ctx.RequestFull("TutorialFlag", { Flag = "Skipped" }, true)
	end)
	UI.Toast(T("tut.skipped"), "Info")
end

-- ---------------------------------------------------------------------
-- 7) BEWERTEN + ZEICHNEN
-- ---------------------------------------------------------------------
evaluate = function()
	if not active then
		return
	end
	-- Schritt 14: Lizenz erreicht -> Glückwunsch-Phase
	if step == 14 and phase == 1 and num(stateOf("Prog").Licence, 1) >= 2 then
		setPhase(2)
	end
	-- Schritt 6: Übung läuft -> Hinweis-Phase
	if step == 6 and phase == 1 and stateOf("Depot").Tutorial == "Running" then
		setPhase(2)
	end
	local guard = 0
	while active and step >= FIRST_STEP and step < LAST_STEP and isDone(step) and guard < 20 do
		guard += 1
		advance()
	end
	if active then
		render()
	end
end

render = function()
	if not active or not card.Panel or step <= FIRST_STEP then
		return
	end
	layoutCard()
	local view = viewOf(step)
	local parts: { string } = {}
	for _, key in ipairs(view.Lines) do
		table.insert(parts, T(key))
	end
	local text = table.concat(parts, " ")
	local sig = table.concat({ tostring(step), tostring(phase), text, tostring(view.Button), lang() }, "|")
	card.Counter.Text = string.format("%d/%d", step, LAST_STEP)
	if sig == renderSig then
		return
	end
	renderSig = sig
	typeText(card.Text, text)
	card.Name.Text = UI.Upper(T("tut.title"))
	card.Tag.Text = T("tut.tag")
	card.SkipAll.SetText(T("tut.skip"))
	card.SkipStep.SetText(if step >= LAST_STEP then T("tut.btn.done") else T("tut.skipStep"))
	local button = view.Button
	card.Action.Frame.Visible = button ~= nil
	if button then
		card.Action.SetText(T(button))
	end
	card.Choices.Visible = view.Choices == true and not card.Compact
	setPulse(button ~= nil and not card.Compact)
end

-- Entscheidung beim ersten vollständigen State: läuft das Tutorial, und ab welchem Schritt?
local function decide()
	local state = ctx.State
	if decided or type(state.Flags) ~= "table" or type(state.Tower) ~= "table" then
		return
	end
	local flags = state.Flags
	if flags.Done == true or flags.Skipped == true or flags.Tutorial == true then
		decided = true
		step = DONE_STEP
		return
	end
	local plot = stateOf("Plot").Id
	if type(plot) ~= "number" and os.clock() - decideSince < START_WAIT then
		return -- Plot noch nicht zugeteilt: kurz warten (Anflug braucht ihn)
	end
	decided = true
	local resume = math.floor(num(flags.TutStep, 0)) + 1
	local first = if flags.FlyInDone == true then FIRST_STEP + 1 else FIRST_STEP
	local start = math.max(first, resume)
	if start > LAST_STEP then
		step = DONE_STEP
		sendFlag("Done")
		return
	end
	flyDone = flags.FlyInDone == true
	favoriteDone = flags.FavoritePrompted == true
	claimSent = math.floor(num(flags.TutStep, 0))
	claimWanted = claimSent
	active = true
	buildCard()
	if start == FIRST_STEP and type(plot) ~= "number" then
		flyDone = true -- ohne Plot kein Anflug
		sendFlag("FlyInDone")
		start = FIRST_STEP + 1
	end
	enter(start)
	evaluate()
end

-- ---------------------------------------------------------------------
-- 8) ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function Tutorial.Step(): number
	return step
end

function Tutorial.IsActive(): boolean
	return active and step >= FIRST_STEP and step <= LAST_STEP
end

function Tutorial.Tick()
	if not decided then
		decide()
		return
	end
	if not active then
		return
	end
	flushClaim()
	moveTiko()
	-- verkettetes Bauen der Etagen 2–5 (§B2 2:00–2:40)
	if step == 8 and chain and not busy and os.clock() - lastChainAt >= CHAIN_GAP then
		local tower = stateOf("Tower")
		local build = type(tower.Build) == "table" and tower.Build or {}
		local nextInfo = type(tower.Next) == "table" and tower.Next or {}
		local enough = num(ctx.State.Credits, 0) >= num(nextInfo.Cost, math.huge)
		if build.Floor == nil and nextInfo.Locked == nil and enough then
			lastChainAt = os.clock()
			busy = true
			task.spawn(function()
				ctx.RequestFull("TowerBuild", {}, true)
				busy = false
				evaluate()
			end)
		end
	end
	-- Fahrt zum Börsensaal: Wegpunkt erneuern, solange wir unterwegs sind
	if step == 12 and phase == 3 and os.clock() - waypointAt >= WAYPOINT_RENEW then
		waypointAt = os.clock()
		call("Vehicles", "Waypoint", exchangeEntrance())
	end
	if step == 5 then
		vaultMax = math.max(vaultMax, num(stateOf("Tower").Vault, 0))
	end
	evaluate()
end

function Tutorial.Init(context: any)
	ctx = context
end

function Tutorial.Start()
	decideSince = os.clock()
	ctx.Hooks.On("State", function(_state: any, changed: any)
		if not decided then
			decide()
			return
		end
		if not active or type(changed) ~= "table" then
			return
		end
		if changed.Tower or changed.Depot or changed.Prog or changed.Flags or changed.Login or changed.Credits then
			if step == 5 then
				vaultMax = math.max(vaultMax, num(stateOf("Tower").Vault, 0))
			end
			evaluate()
		end
	end)
	ctx.Hooks.On("WindowOpened", function()
		if active then
			render()
		end
	end)
	ctx.Hooks.On("WindowClosed", function()
		if active then
			render()
		end
	end)
	ctx.Hooks.On("Settings", function()
		renderSig = ""
		if active then
			render()
		end
	end)
	player.CharacterAdded:Connect(function()
		if active then
			removeTiko()
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="162">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – UI-BAUKASTEN im AKYTEX-Look (Client/Modules/UI)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Basis: CC-UI-Kit 1:1 (REUSE §4) + AT-Neuteile (§C7.5, REUSE §4.10/§4.11).
--  Stil: dunkles Glas wie die AKYTEX-Website – Flächen aus UI.Theme (Glas-Fenster mit 1-px-Rahmen), Schrift aus
--  UI.Fonts (Enum, Builder Sans/Michroma/Titillium) und UI.Faces (FontFace: BuilderExtended = Anzeige/Titel,
--  BuilderMono = alle Preise/Zahlen ohne Zittern, BuilderSans = Fließtext; Rückfall Michroma/TitilliumWeb/BuilderSans).
--  Bewegung iOS-artig: Öffnen 0.26 s Quint Out + 8 px Gleiten, Schließen 0.14 s Quad In, Hover 0.12 s,
--  Drücken = Feder auf 0.97 + kurzer Farbblitz, Loslassen 0.3 s Back Out, Zähler alpha = 1 − e^(−7t) ≤ 30 Hz.
--
--  Öffentliche API (REUSE §4 + §C7.3 + §C7.5):
--    UI.Font, UI.Fonts, UI.Faces { Display, Mono, Body, DisplayRegular, MonoBold, BodyBold }, UI.Theme, UI.Root
--    UI.Init(ctxOrGui), UI.Start(), UI.Frame(dt)       (Frame kommt aus dem einen PreRender-Loop von Main.client)
--    UI.Create, UI.Corner, UI.Stroke, UI.TextStroke, UI.Gradient, UI.ButtonSequence, UI.FormatMult, UI.FormatSteps,
--    UI.Upper, UI.Label, UI.TextBox, UI.Button, UI.Badge, UI.SetBadge, UI.Section, UI.Row, UI.Grid, UI.Card, UI.Panel,
--    UI.Divider, UI.Bar, UI.SetBar, UI.Pulse, UI.Counter, UI.SetCounter, UI.RedrawCounter
--    UI.Window, UI.Sheet(title, height), UI.OpenWindow, UI.CloseWindow, UI.ToggleWindow, UI.CloseAll, UI.IsAnyWindowOpen
--    UI.Windows = { Register(name, open, close?), Open(name), Close(name?), IsOpen(name?), Toggle(name) }  (= ctx.Windows)
--    UI.Toast(text, kind?), UI.SetToastTop(offset?), UI.SetToastFloor(y?) (Mindest-Höhe unter einer Karte oben)
--    UI.FetchPrice(id, infoType, cb), UI.WhenRandomItemsKnown(cb), UI.RandomItemsAllowed()
--  Neu für AT (§C7.5):
--    UI.Segmented(parent, options, onChange): { Frame, Set(key, silent?), Get() }
--    UI.PriceTag(label, cents, change?)          Preis + ▲/▼ + Prozent (Up/Down, Farbenblind-Modus)
--    UI.Sparkline(parent, n): { Frame, Set(points) }
--    UI.Ticker(parent): { Frame, SetRows(rows), SetSpeed(pxPerSecond) }     Laufband (gepoolte Labels, O(1) je Frame)
--    UI.Chip, UI.StatTile, UI.RowCard, UI.RowActions, UI.Slider, UI.Cycler, UI.NavItem   (aus CC AdminPanel gehoben)
--  Zusätzlich: UI.CurrencyIcon(parent, "CR" | "AKY", size), UI.SetColorblind(on), UI.UpColor(), UI.DownColor(),
--    UI.TrendColor(change), UI.TrendArrow(change), UI.ScaleOf(inst), UI.ColorHex(color)
--  UI.Button(props, onClick): props Name, Size, Position, AnchorPoint, LayoutOrder, Parent, Visible, ZIndex, Text, Sub,
--    Variant ("Primary" | "Secondary" | "Danger" | "Success" | "Ghost" | "Premium" | "Muted"), Color, MaxText, SubMax,
--    Corner, Wrap, Silent, Face. Rückgabe { Frame, Button, Label, Sub?, Stroke, SetText, SetSub, SetColor, SetVariant }.
--  Fenster offen -> sichtbarer Modal-Knopf (gibt die Maus frei), Hooks "WindowOpened"/"WindowClosed"(name), Blur
--  "AkytexTycoonWindowBlur". ProximityPrompt mit Attribut "Window" öffnet das registrierte Fenster.
-- =====================================================================

local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

-- ---------------------------------------------------------------------
-- SCHRIFTEN
-- Enum-Schriften (UI.Fonts) für alles, was .Font nutzt; FontFace-Familien (UI.Faces) für Titel, Zahlen, Text.
-- ---------------------------------------------------------------------
UI.Font = Enum.Font.BuilderSansBold
UI.Fonts = {
	Main = Enum.Font.BuilderSansBold, -- Knöpfe, Labels
	Body = Enum.Font.BuilderSans, -- Fließtext, Beschreibungen
	Strong = Enum.Font.BuilderSansExtraBold, -- große Zahlen/Titel in Karten
	Heading = Enum.Font.Michroma, -- Rückfall für Titel
	Number = Enum.Font.TitilliumWeb, -- Rückfall für Zahlen
	Banner = Enum.Font.Michroma, -- große Ansagen
	Pop = Enum.Font.BuilderSansExtraBold,
}

local FACE_DISPLAY = "rbxasset://fonts/families/BuilderExtended.json"
local FACE_MONO = "rbxasset://fonts/families/BuilderMono.json"
local BODY_FAMILY = Font.fromEnum(Enum.Font.BuilderSans).Family

UI.Faces = {
	Display = Font.new(FACE_DISPLAY, Enum.FontWeight.Bold), -- Logo, Fenstertitel, große Zahlen (≈ Unbounded)
	DisplayRegular = Font.new(FACE_DISPLAY, Enum.FontWeight.Regular),
	Mono = Font.new(FACE_MONO, Enum.FontWeight.Regular), -- Preise, G/V, Achsen (tabellarische Ziffern)
	MonoBold = Font.new(FACE_MONO, Enum.FontWeight.Bold),
	Body = Font.new(BODY_FAMILY, Enum.FontWeight.Regular), -- Fließtext
	BodyBold = Font.new(BODY_FAMILY, Enum.FontWeight.Bold),
}
-- Rückfall, falls BuilderExtended/BuilderMono auf einem Gerät fehlen (Prüfung in UI.Init)
local FACE_FALLBACK: { [string]: Font } = {
	Display = Font.fromEnum(Enum.Font.Michroma),
	DisplayRegular = Font.fromEnum(Enum.Font.Michroma),
	Mono = Font.fromEnum(Enum.Font.TitilliumWeb),
	MonoBold = Font.new(Font.fromEnum(Enum.Font.TitilliumWeb).Family, Enum.FontWeight.Bold),
	Body = Font.fromEnum(Enum.Font.BuilderSans),
	BodyBold = Font.fromEnum(Enum.Font.BuilderSansBold),
}
local FACE_CHECK_TEXT = "ÄÖÜß Λ 0123456789"
local FACE_CHECK_WAIT = 0.6 -- so lange darf die Prüfung den Start höchstens aufhalten

-- ---------------------------------------------------------------------
-- FARBEN (DESIGN §A4, exakt CC-UI.Theme)
-- ---------------------------------------------------------------------
local AKY = {
	Bg = Color3.fromRGB(11, 15, 23), -- #0b0f17
	Bg2 = Color3.fromRGB(15, 20, 29), -- #0f141d
	Surface = Color3.fromRGB(18, 24, 36), -- #121824 (Panel)
	Surface2 = Color3.fromRGB(26, 33, 48), -- #1a2130 (Karte)
	Hover = Color3.fromRGB(31, 40, 56), -- #1f2838
	Border = Color3.fromRGB(31, 41, 55), -- #1f2937
	Text = Color3.fromRGB(230, 236, 245), -- #e6ecf5
	Text2 = Color3.fromRGB(170, 180, 195), -- #aab4c3
	Muted = Color3.fromRGB(125, 136, 154), -- #7d889a
	Accent = Color3.fromRGB(79, 140, 255), -- #4f8cff
	AccentDeep = Color3.fromRGB(41, 98, 255), -- #2962ff
	Up = Color3.fromRGB(34, 197, 94), -- #22c55e
	Down = Color3.fromRGB(239, 68, 68), -- #ef4444
	Warn = Color3.fromRGB(234, 179, 8), -- #eab308
}
UI.Theme = {
	Bg = AKY.Bg,
	Bg2 = AKY.Bg2,
	Surface = AKY.Surface,
	Surface2 = AKY.Surface2,
	Hover = AKY.Hover,
	Border = AKY.Border,
	Text = AKY.Text,
	Text2 = AKY.Text2,
	Muted = AKY.Muted,
	Accent = AKY.Accent,
	AccentDeep = AKY.AccentDeep,
	Up = AKY.Up,
	Down = AKY.Down,
	Warn = AKY.Warn,
	-- Alias-Schlüssel (CC-Kompatibilität)
	Panel = AKY.Surface,
	PanelDark = AKY.Bg,
	PanelLight = AKY.Surface2,
	SubText = AKY.Text2,
	Black = BLACK,
	Yellow = AKY.Warn,
	Cash = AKY.Up,
	Red = AKY.Down,
	Blue = AKY.Accent,
	Green = AKY.Up,
	Gray = AKY.Muted,
	-- Akzente
	Orange = Color3.fromRGB(245, 158, 11), -- #f59e0b
	Purple = Color3.fromRGB(139, 92, 246), -- #8b5cf6
	Pink = Color3.fromRGB(236, 72, 153), -- #ec4899
	Gold = Color3.fromRGB(250, 204, 21), -- #facc15 (nur Kronen, Glocke, Hall-of-Fame)
	Cyan = Color3.fromRGB(34, 211, 238), -- #22d3ee
	-- Space-Set (Nacht/Hero-Momente) + Logo
	Space = Color3.fromRGB(3, 4, 10), -- #03040a
	SpaceAccent = Color3.fromRGB(124, 156, 255), -- #7c9cff
	Cosmic1 = Color3.fromRGB(59, 91, 219), -- #3b5bdb
	Cosmic2 = Color3.fromRGB(124, 92, 255), -- #7c5cff
	Cosmic3 = Color3.fromRGB(179, 107, 255), -- #b36bff
	SpaceGold = Color3.fromRGB(255, 207, 110), -- #ffcf6e
	LogoRing = Color3.fromRGB(110, 162, 242), -- #6ea2f2
	LogoLetters = Color3.fromRGB(234, 241, 255), -- #eaf1ff
}
local Theme = UI.Theme

-- Farbenblind-Modus (Einstellung "Colorblind"): Up/Down -> Accent/Orange, ▲/▼ bleiben immer sichtbar
local colorblind = false

-- Bewegung (iOS-artig, wie AKYTEX --ease-ios) – einmal angelegt und immer wiederverwendet
local HOVER_INFO = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PRESS_INFO = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local RELEASE_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out) -- leichte Feder
local OPEN_FADE_INFO = TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local OPEN_SCALE_INFO = TweenInfo.new(0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local SHEET_OPEN_INFO = TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local CLOSE_INFO = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local SHEET_CLOSE_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local BLUR_IN_INFO = TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local BLUR_OUT_INFO = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local COUNTER_FLASH_INFO = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true)
local BAR_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local PULSE_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local FOCUS_INFO = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SEGMENT_INFO = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local TOAST_GROW_INFO = TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local TOAST_IN_INFO = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local TOAST_OUT_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local COUNTER_INTERVAL = 1 / 30 -- Zahlen höchstens 30x pro Sekunde neu schreiben
local COUNTER_POP_GAP = 0.15 -- so oft höchstens ein Aufploppen pro Zähler
local PRESS_SCALE = 0.97 -- gedrückter Knopf (Feder)
local HOVER_LIGHTEN = 0.08 -- Hover: Fläche etwas heller
local PRESS_LIGHTEN = 0.16 -- Drücken: kurzer Farbblitz
local BLUR_SIZE = 9 -- leichter Weichzeichner hinter offenen Fenstern (AKYTEX 8–10)
local WINDOW_SLIDE = 8 -- Fenster gleiten aus so vielen Pixeln von unten herein
local WINDOW_PAD = 10 -- Rand der Animations-Fläche (Platz für den weichen Schatten)
local WINDOW_HEADER = 58 -- Höhe des Fenster-Kopfs (Titel + ✕)
local SHEET_MAX_WIDTH = 760 -- Bottom-Sheet auf großen Bildschirmen höchstens so breit
local SHEET_DRAG_CLOSE = 80 -- so weit nach unten ziehen = Sheet schließen
local TOAST_WIDTH = 640 -- Breite der Toast-Spalte (eine Pill ist höchstens so breit)
local TOAST_PAD_X = 16
local TOAST_DOT = 8
local TOAST_DOT_GAP = 10
local TOAST_MIN_HEIGHT = 36
local TOAST_GAP = 6
local TOAST_SLIDE = 8 -- Toasts gleiten aus 8 px darüber herein
local MAX_TOASTS = 5
local MAX_TOAST_POOL = 8 -- so viele fertige Toasts werden zum Wiederverwenden aufgehoben
local RANDOM_STATE_WAIT = 30 -- so lange auf den Server-Wert "RandomAllowed" warten, dann PolicyService selbst fragen
local HOVER_SOUND_GAP = 0.08 -- Hover-Ton höchstens so oft
local FINE_STROKE_T = 0.5 -- feine Text-Kontur über der 3D-Welt (AKYTEX: 1 px, Transparenz 0.35–0.5)
local TICKER_SPEED = 42 -- Laufband: Pixel pro Sekunde (vor UIScale) ≈ Website-Loop
local TICKER_GAP = 28 -- Abstand zwischen zwei Laufband-Einträgen
local TICKER_MAX_ROWS = 64 -- mehr Einträge zeigt ein Laufband nie (Pool-Grenze)
local MAX_SPARK_POINTS = 240 -- Sparkline-Pool-Grenze

-- Alte Schriften (Comic-Look) -> AKYTEX-Schriften
local LEGACY_FONTS: { [Enum.Font]: Enum.Font } = {
	[Enum.Font.FredokaOne] = UI.Fonts.Main,
	[Enum.Font.LuckiestGuy] = UI.Fonts.Heading,
	[Enum.Font.Bangers] = UI.Fonts.Banner,
	[Enum.Font.Gotham] = UI.Fonts.Body,
	[Enum.Font.GothamMedium] = UI.Fonts.Main,
	[Enum.Font.GothamBold] = UI.Fonts.Main,
	[Enum.Font.GothamBlack] = UI.Fonts.Strong,
}

local root: ScreenGui? = nil
local ctx: any = nil -- gemeinsamer Rucksack (nach UI.Init mit ctx gesetzt; für Hooks/Sfx/State/Format)
UI.Root = nil :: ScreenGui? -- die ScreenGui der Oberfläche (nach UI.Init gesetzt)

-- Optionale Sounds über Sfx (fehlt das Modul, passiert einfach nichts)
local lastHoverSound = 0
local function playUiSound(role: string)
	local modules = ctx and ctx.Modules
	local sfx = modules and modules.Sfx
	if sfx and type(sfx.Play) == "function" then
		pcall(sfx.Play, role)
	end
end

local function fireHook(name: string, ...: any)
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.Fire) == "function" then
		hooks.Fire(name, ...)
	end
end

local function sameColor(a: Color3, b: Color3): boolean
	return math.abs(a.R - b.R) < 0.004 and math.abs(a.G - b.G) < 0.004 and math.abs(a.B - b.B) < 0.004
end

local function luminance(c: Color3): number
	return 0.2126 * c.R + 0.7152 * c.G + 0.0722 * c.B
end

-- Alter Standard-Akzent (Orange) -> AKYTEX-Akzent (für Balken, Bildlaufleisten, Unterstriche)
local function accentOf(color: Color3?): Color3
	if typeof(color) ~= "Color3" or sameColor(color, Theme.Orange) then
		return Theme.Accent
	end
	return color
end

local function langNow(): string
	if ctx and type(ctx.Lang_) == "function" then
		local ok, lang = pcall(ctx.Lang_)
		if ok and (lang == "de" or lang == "en") then
			return lang
		end
	end
	return "en"
end

-- ---------------------------------------------------------------------
-- FARB-HELFER (Trend, Farbenblind-Modus)
-- ---------------------------------------------------------------------
function UI.SetColorblind(on: boolean)
	colorblind = on == true
end

function UI.UpColor(): Color3
	return if colorblind then Theme.Accent else Theme.Up
end

function UI.DownColor(): Color3
	return if colorblind then Theme.Orange else Theme.Down
end

-- Farbe zu einer Veränderung (positiv Up, negativ Down, 0 Muted)
function UI.TrendColor(change: number?): Color3
	local n = tonumber(change) or 0
	if n ~= n or n == 0 then
		return Theme.Muted
	end
	return if n > 0 then UI.UpColor() else UI.DownColor()
end

function UI.TrendArrow(change: number?): string
	local n = tonumber(change) or 0
	if n ~= n or n == 0 then
		return "–"
	end
	return if n > 0 then "▲" else "▼"
end

-- "#rrggbb" für RichText
function UI.ColorHex(color: Color3): string
	return string.format(
		"#%02x%02x%02x",
		math.clamp(math.floor(color.R * 255 + 0.5), 0, 255),
		math.clamp(math.floor(color.G * 255 + 0.5), 0, 255),
		math.clamp(math.floor(color.B * 255 + 0.5), 0, 255)
	)
end

-- Aufsummierte UIScale über einer GUI (AbsoluteSize ist nach der Skalierung, Offsets davor)
function UI.ScaleOf(inst: Instance): number
	local factor = 1
	local current: Instance? = inst
	local guard = 0
	while current and guard < 64 do
		guard += 1
		local scale = current:FindFirstChildOfClass("UIScale")
		if scale then
			factor *= scale.Scale
		end
		if current:IsA("LayerCollector") then
			break
		end
		current = current.Parent
	end
	if factor <= 0 or factor ~= factor then
		return 1
	end
	return factor
end

-- ---------------------------------------------------------------------
-- GRUNDBAUSTEINE
-- ---------------------------------------------------------------------
function UI.Create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			elseif key == "Font" and LEGACY_FONTS[value] then
				(inst :: any).Font = LEGACY_FONTS[value]
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	inst.Parent = parent
	return inst
end

function UI.Corner(radius: number?): UICorner
	return UI.Create("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

-- 1-px-Rahmen (AKYTEX). Schwarz/ohne Farbe = Border-Token; farbige Rahmen bleiben, höchstens 2 px dick.
function UI.Stroke(color: Color3?, thickness: number?): UIStroke
	local plain = color == nil or sameColor(color :: Color3, BLACK)
	return UI.Create("UIStroke", {
		Color = if plain then Theme.Border else color,
		Thickness = if plain then 1 else math.clamp(thickness or 1, 1, 2),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

-- Feine dunkle Text-Kontur (nur für Text über der 3D-Welt nötig; AKYTEX: 1–1.5 px, halb durchsichtig)
function UI.TextStroke(thickness: number?): UIStroke
	return UI.Create("UIStroke", {
		Thickness = math.clamp(thickness or 1, 1, 1.5),
		Color = BLACK,
		Transparency = FINE_STROKE_T,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

-- Farbverlauf von oben nach unten
function UI.Gradient(top: Color3, bottom: Color3, rotation: number?): UIGradient
	return UI.Create("UIGradient", { Rotation = rotation or 90, Color = ColorSequence.new(top, bottom) })
end

-- Dezenter Verlauf einer Füllfarbe (AKYTEX: kaum sichtbar, kein Bonbon-Glanz)
function UI.ButtonSequence(color: Color3): ColorSequence
	return ColorSequence.new(color:Lerp(WHITE, 0.07), color:Lerp(BLACK, 0.05))
end

-- 1.25 -> "1.25", 2 -> "2", 2.5 -> "2.5"
function UI.FormatMult(value: number?): string
	local n = tonumber(value) or 1
	if n ~= n or n <= 0 then
		return "1"
	end
	local text = string.format("%.2f", n)
	text = text:gsub("0+$", "")
	text = text:gsub("%.$", "")
	return text
end

-- Kleine Mengen mit einer Nachkommastelle (2.5 statt 2), große wie gewohnt (3.1M)
function UI.FormatSteps(value: number, formatNumber: (number) -> string): string
	local n = tonumber(value) or 0
	if n ~= n then
		return "0"
	end
	if math.abs(n) < 100 and math.floor(n) ~= n then
		local text = string.format("%.1f", n)
		text = text:gsub("%.0$", "")
		return text
	end
	return formatNumber(n)
end

-- Text in GROSSBUCHSTABEN (Titel, Knopf-Wörter). Auch ä/ö/ü -> Ä/Ö/Ü; Emojis bleiben, wie sie sind.
local UMLAUT_UPPER: { [string]: string } = { ["ä"] = "Ä", ["ö"] = "Ö", ["ü"] = "Ü" }
function UI.Upper(text: string): string
	local upper = string.gsub(string.upper(text), "\195[\164\182\188]", UMLAUT_UPPER)
	return upper
end

-- Text-Label. MaxText = größte Schriftgröße (TextScaled), Outline = feine Kontur, Face = Schlüssel aus UI.Faces.
function UI.Label(props: { [string]: any }): TextLabel
	local face = props.Face
	local base: { [string]: any } = {
		BackgroundTransparency = 1,
		TextColor3 = Theme.Text,
		TextScaled = true,
		Text = "",
	}
	if type(face) == "string" and UI.Faces[face] then
		base.FontFace = UI.Faces[face]
	elseif typeof(props.FontFace) ~= "Font" then
		base.Font = UI.Fonts.Main
	end
	for key, value in pairs(props) do
		if key ~= "MaxText" and key ~= "Outline" and key ~= "Face" and not (key == "Font" and base.FontFace) then
			base[key] = value
		end
	end
	local children: { Instance } = { UI.Create("UITextSizeConstraint", { MaxTextSize = props.MaxText or 28 }) }
	if props.Outline then
		table.insert(children, UI.TextStroke(1))
	end
	return UI.Create("TextLabel", base, children)
end

-- Eingabefeld: Surface2, 1-px-Rahmen, Fokus = Akzent-Rahmen
function UI.TextBox(props: { [string]: any }): TextBox
	local base: { [string]: any } = {
		BackgroundColor3 = Theme.Surface2,
		Font = UI.Fonts.Body,
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.Muted,
		TextScaled = true,
		ClearTextOnFocus = false,
		Text = "",
	}
	for key, value in pairs(props) do
		base[key] = value
	end
	local stroke: UIStroke = UI.Create("UIStroke", {
		Color = Theme.Border,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	local box: TextBox = UI.Create("TextBox", base, {
		UI.Corner(10),
		stroke,
		UI.Create("UITextSizeConstraint", { MaxTextSize = 18 }),
		UI.Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
	})
	box.Focused:Connect(function()
		TweenService:Create(stroke, FOCUS_INFO, { Color = Theme.Accent }):Play()
	end)
	box.FocusLost:Connect(function()
		TweenService:Create(stroke, FOCUS_INFO, { Color = Theme.Border }):Play()
	end)
	return box
end

-- ---------------------------------------------------------------------
-- KNÖPFE (Halter-Rahmen für das Layout + Knopf-Fläche darin)
-- Aufbau: Halter (unsichtbar, Name = props.Name) -> "Button" (Fläche, Ecke 10–12, 1-px-Rahmen,
--         UIScale für die Feder) -> "Label" (+ "Sub", kleine zweite Zeile)
-- ---------------------------------------------------------------------
export type Button = {
	Frame: Frame,
	Button: TextButton,
	Label: TextLabel,
	Sub: TextLabel?,
	Stroke: UIStroke,
	SetText: (text: string) -> (),
	SetSub: (text: string) -> (),
	SetColor: (color: Color3) -> (),
	SetVariant: (variant: string) -> (),
}

type Look = {
	Bg: Color3,
	BgT: number,
	Hover: Color3,
	HoverT: number,
	Text: Color3,
	Sub: Color3,
	SubT: number,
	Stroke: Color3,
	StrokeT: number,
}

local VARIANTS: { [string]: boolean } = {
	Primary = true,
	Secondary = true,
	Danger = true,
	Success = true,
	Ghost = true,
	Premium = true,
	Muted = true,
}

-- Theme-Token -> Variante
local COLOR_VARIANTS: { { Color: Color3, Variant: string } } = {
	{ Color = Theme.Accent, Variant = "Primary" },
	{ Color = Theme.AccentDeep, Variant = "Primary" },
	{ Color = Theme.Orange, Variant = "Primary" }, -- alter Standard-Knopf
	{ Color = Theme.Down, Variant = "Danger" },
	{ Color = Theme.Up, Variant = "Success" },
	{ Color = Theme.Warn, Variant = "Premium" },
	{ Color = Theme.Gold, Variant = "Premium" },
	{ Color = Theme.Muted, Variant = "Muted" },
	{ Color = Theme.Surface2, Variant = "Secondary" },
	{ Color = Theme.Surface, Variant = "Secondary" },
	{ Color = Theme.Hover, Variant = "Secondary" },
	{ Color = Theme.Bg, Variant = "Secondary" },
	{ Color = Theme.Bg2, Variant = "Secondary" },
}

local function variantFor(variant: any, color: any): (string, Color3?)
	if type(variant) == "string" and VARIANTS[variant] then
		return variant, nil
	end
	if typeof(color) ~= "Color3" then
		return "Primary", nil
	end
	for _, entry in ipairs(COLOR_VARIANTS) do
		if sameColor(color, entry.Color) then
			return entry.Variant, nil
		end
	end
	return "Custom", color
end

local function lookFor(variant: string, custom: Color3?): Look
	if variant == "Secondary" then
		return {
			Bg = Theme.Surface2,
			BgT = 0,
			Hover = Theme.Hover,
			HoverT = 0,
			Text = Theme.Text,
			Sub = Theme.Text2,
			SubT = 0,
			Stroke = Theme.Border,
			StrokeT = 0,
		}
	elseif variant == "Muted" then
		return {
			Bg = Theme.Surface2,
			BgT = 0.25,
			Hover = Theme.Hover,
			HoverT = 0,
			Text = Theme.Muted,
			Sub = Theme.Muted,
			SubT = 0.2,
			Stroke = Theme.Border,
			StrokeT = 0,
		}
	elseif variant == "Ghost" then
		return {
			Bg = Theme.Hover,
			BgT = 1,
			Hover = Theme.Hover,
			HoverT = 0,
			Text = Theme.Text2,
			Sub = Theme.Muted,
			SubT = 0,
			Stroke = Theme.Border,
			StrokeT = 1,
		}
	elseif variant == "Premium" then
		-- Fläche weiß × dezenter Verlauf Warn -> Orange (UIGradient am Knopf)
		return {
			Bg = WHITE,
			BgT = 0,
			Hover = WHITE,
			HoverT = 0,
			Text = Theme.Bg,
			Sub = Theme.Bg2,
			SubT = 0.15,
			Stroke = Theme.Warn:Lerp(WHITE, 0.35),
			StrokeT = 0.55,
		}
	end
	local fill = if variant == "Danger"
		then Theme.Down
		elseif variant == "Success" then Theme.Up
		elseif variant == "Custom" and custom then custom
		else Theme.Accent
	local dark = luminance(fill) > 0.62 -- helle Fläche -> dunkle Schrift
	local text = if dark then Theme.Bg else WHITE
	return {
		Bg = fill,
		BgT = 0,
		Hover = fill:Lerp(WHITE, HOVER_LIGHTEN),
		HoverT = 0,
		Text = text,
		Sub = text,
		SubT = 0.22,
		Stroke = fill:Lerp(WHITE, 0.25),
		StrokeT = 0.6,
	}
end

function UI.Button(props: { [string]: any }, onClick: (() -> ())?): Button
	local cornerRadius: number = math.clamp(tonumber(props.Corner) or 12, 6, 14)
	local z: number = props.ZIndex or 1
	local silent = props.Silent == true
	local holder: Frame = UI.Create("Frame", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(120, 40),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = props.Parent,
	})
	local variant, custom = variantFor(props.Variant, props.Color)
	local look = lookFor(variant, custom)

	local scale: UIScale = UI.Create("UIScale")
	local stroke: UIStroke = UI.Create("UIStroke", {
		Color = look.Stroke,
		Transparency = look.StrokeT,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	local gradient: UIGradient = UI.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Theme.Warn, Theme.Orange),
		Enabled = variant == "Premium",
	})
	local btn: TextButton = UI.Create("TextButton", {
		Name = "Button",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = look.Bg,
		BackgroundTransparency = look.BgT,
		AutoButtonColor = false,
		Text = "",
		ZIndex = z,
		Parent = holder,
	}, { UI.Corner(cornerRadius), stroke, gradient, scale })

	local hasSub = props.Sub ~= nil
	local main = UI.Label({
		Name = "Label",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, if hasSub then 0.08 else 0.16, 0),
		Size = UDim2.new(1, -14, if hasSub then 0.52 else 0.68, 0),
		Text = props.Text or "",
		TextWrapped = props.Wrap == true,
		Face = props.Face,
		TextColor3 = look.Text,
		MaxText = props.MaxText or 22,
		ZIndex = z + 1,
		Parent = btn,
	})
	local sub: TextLabel? = nil
	if hasSub then
		sub = UI.Label({
			Name = "Sub",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0.6, 0),
			Size = UDim2.new(1, -14, 0.3, 0),
			Text = props.Sub,
			TextColor3 = look.Sub,
			TextTransparency = look.SubT,
			MaxText = props.SubMax or 15,
			ZIndex = z + 1,
			Parent = btn,
		})
	end

	-- Zustände: Hover (+8 % heller), Drücken (Feder 0.97 + kurzer Farbblitz), Loslassen (federt zurück)
	local hovering = false
	local pressed = false
	local function surface(): (Color3, number)
		local filled = variant ~= "Secondary" and variant ~= "Muted" and variant ~= "Ghost"
		if pressed then
			if filled then
				return look.Bg:Lerp(WHITE, PRESS_LIGHTEN), look.BgT
			end
			return look.Hover:Lerp(WHITE, 0.05), 0
		end
		if hovering then
			return look.Hover, look.HoverT
		end
		return look.Bg, look.BgT
	end
	local function repaint(info: TweenInfo)
		local color, transparency = surface()
		TweenService:Create(btn, info, { BackgroundColor3 = color, BackgroundTransparency = transparency }):Play()
		local strokeT = if hovering or pressed then math.max(0, look.StrokeT - 0.35) else look.StrokeT
		TweenService:Create(stroke, info, { Transparency = strokeT }):Play()
	end
	local function spring(target: number, info: TweenInfo)
		TweenService:Create(scale, info, { Scale = target }):Play()
	end
	local function setHover(on: boolean)
		if hovering == on then
			return
		end
		hovering = on
		if not on then
			pressed = false
			spring(1, RELEASE_INFO)
		end
		repaint(HOVER_INFO)
	end
	local function setPressed(on: boolean)
		if pressed == on then
			return
		end
		pressed = on
		spring(if on then PRESS_SCALE else 1, if on then PRESS_INFO else RELEASE_INFO)
		repaint(if on then PRESS_INFO else HOVER_INFO)
	end
	btn.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement then
			setHover(true)
			local now = os.clock()
			if not silent and now - lastHoverSound >= HOVER_SOUND_GAP then
				lastHoverSound = now
				playUiSound("UIHover")
			end
		elseif kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			setPressed(true)
		end
	end)
	btn.InputEnded:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 then
			setPressed(false)
		elseif kind == Enum.UserInputType.Touch then
			setPressed(false)
			setHover(false)
		elseif kind == Enum.UserInputType.MouseMovement then
			setHover(false)
		end
	end)
	-- Controller-Auswahl wie Hover
	btn.SelectionGained:Connect(function()
		setHover(true)
	end)
	btn.SelectionLost:Connect(function()
		setHover(false)
	end)

	-- Klick: Fehler im Callback brechen die Oberfläche nicht, Doppelklicks werden ignoriert (nur UX – Server bleibt idempotent)
	local busy = false
	btn.Activated:Connect(function()
		if busy or not onClick then
			return
		end
		busy = true
		if not silent then
			playUiSound("UIClick")
		end
		local callback = onClick :: () -> ()
		task.spawn(function()
			local ok, err = pcall(callback)
			if not ok then
				warn("[UI] " .. tostring(err))
			end
			busy = false
		end)
	end)

	local function applyLook(newVariant: string, newCustom: Color3?)
		if newVariant == variant and newCustom == custom then
			return
		end
		variant, custom = newVariant, newCustom
		look = lookFor(variant, custom)
		gradient.Enabled = variant == "Premium"
		stroke.Color = look.Stroke
		main.TextColor3 = look.Text
		local subLabel = sub
		if subLabel then
			subLabel.TextColor3 = look.Sub
			subLabel.TextTransparency = look.SubT
		end
		repaint(HOVER_INFO)
	end

	local result: Button = {
		Frame = holder,
		Button = btn,
		Label = main,
		Sub = sub,
		Stroke = stroke,
		SetText = function(text: string)
			if main.Text ~= text then
				main.Text = text
			end
		end,
		SetSub = function(text: string)
			if sub and sub.Text ~= text then
				sub.Text = text
			end
		end,
		SetColor = function(color: Color3)
			local newVariant, newCustom = variantFor(nil, color)
			applyLook(newVariant, newCustom)
		end,
		SetVariant = function(name: string)
			local newVariant, newCustom = variantFor(name, nil)
			applyLook(newVariant, newCustom)
		end,
	}
	return result
end

-- Kleiner roter Punkt/Pille oben rechts an einem Knopf (z.B. Belohnung bereit)
function UI.Badge(target: Button, text: string?): Frame
	local badge: Frame = UI.Create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 6, 0, 4),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = Theme.Down,
		Visible = false,
		ZIndex = target.Button.ZIndex + 2,
		Parent = target.Button,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.Create("UIStroke", { Color = Theme.Bg, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
		UI.Create("UIScale", { Name = "Pulse" }),
	})
	UI.Label({
		Name = "Text",
		Position = UDim2.fromOffset(3, 2),
		Size = UDim2.new(1, -6, 1, -4),
		Text = text or "!",
		TextColor3 = WHITE,
		MaxText = 15,
		ZIndex = target.Button.ZIndex + 3,
		Parent = badge,
	})
	return badge
end

local BADGE_PULSE_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local badgePulses: { [Frame]: Tween } = {}

-- Badge setzen: text nil/"" = ausblenden. pulse = sanft pulsieren. Schreibt nur bei Änderungen.
function UI.SetBadge(badge: Frame, text: string?, color: Color3?, pulse: boolean?)
	local show = text ~= nil and text ~= ""
	if badge.Visible ~= show then
		badge.Visible = show
	end
	local label = badge:FindFirstChild("Text")
	if show and label and label:IsA("TextLabel") and label.Text ~= text then
		local value = text :: string
		label.Text = value
		local chars = utf8.len(value) or #value
		local width = if chars <= 1 then 22 else math.min(64, 10 + chars * 8)
		badge.Size = UDim2.fromOffset(width, 22)
	end
	local wanted = color or Theme.Down
	if badge.BackgroundColor3 ~= wanted then
		badge.BackgroundColor3 = wanted
	end
	local scale = badge:FindFirstChild("Pulse")
	if not scale or not scale:IsA("UIScale") then
		return
	end
	local tween = badgePulses[badge]
	local wantPulse = show and pulse == true
	if wantPulse and not tween then
		scale.Scale = 1
		local newTween = TweenService:Create(scale, BADGE_PULSE_INFO, { Scale = 1.15 })
		badgePulses[badge] = newTween
		newTween:Play()
		-- Badge zerstört: Puls-Eintrag aufräumen (starke Tabelle, kein schwacher Schlüssel – REUSE §7 #4)
		badge.Destroying:Once(function()
			local running = badgePulses[badge]
			if running then
				running:Cancel()
				badgePulses[badge] = nil
			end
		end)
	elseif not wantPulse and tween then
		tween:Cancel()
		badgePulses[badge] = nil
		scale.Scale = 1
	end
end

-- ---------------------------------------------------------------------
-- LAYOUT-HELFER (für Fenster-Inhalte)
-- ---------------------------------------------------------------------
-- Abschnitts-Titel: kleiner Akzent-Streifen links (Farbe = color oder Accent), Text in Text2
function UI.Section(parent: Instance, text: string, order: number, color: Color3?): TextLabel
	local label = UI.Label({
		Size = UDim2.new(1, 0, 0, 28),
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Text2,
		LayoutOrder = order,
		MaxText = 17,
		Parent = parent,
	})
	UI.Create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingTop = UDim.new(0, 6), Parent = label })
	UI.Create("Frame", {
		Name = "Accent",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -12, 0.5, 0),
		Size = UDim2.fromOffset(3, 14),
		BackgroundColor3 = accentOf(color),
		BorderSizePixel = 0,
		Parent = label,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	return label
end

function UI.Row(parent: Instance, order: number, height: number?): Frame
	return UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, height or 40),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})
end

function UI.Grid(parent: Instance, order: number, cellX: number, cellY: number): Frame
	return UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.Create("UIGridLayout", {
			CellSize = UDim2.fromOffset(cellX, cellY),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		UI.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 2),
			PaddingTop = UDim.new(0, 2),
			PaddingBottom = UDim.new(0, 2),
		}),
	})
end

-- Karte: Surface2, Ecke 12, 1-px-Border-Rahmen
function UI.Card(props: { [string]: any }): Frame
	local base: { [string]: any } = { BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0 }
	for key, value in pairs(props) do
		base[key] = value
	end
	return UI.Create("Frame", base, { UI.Corner(12), UI.Stroke(nil, 1) })
end

-- Glas-Fläche für HUD-Elemente über der Welt (Surface, leicht durchsichtig, 1-px-Rahmen)
function UI.Panel(props: { [string]: any }): Frame
	local base: { [string]: any } = {
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
	}
	for key, value in pairs(props) do
		base[key] = value
	end
	return UI.Create("Frame", base, { UI.Corner(12), UI.Stroke(nil, 1) })
end

-- 1-px-Trennlinie (Border)
function UI.Divider(parent: Instance, order: number?): Frame
	return UI.Create("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		LayoutOrder = order or 0,
		Parent = parent,
	})
end

-- ---------------------------------------------------------------------
-- FORTSCHRITTSBALKEN (Füllung gleitet weich; Standard = Accent)
-- ---------------------------------------------------------------------
export type Bar = { Frame: Frame, Fill: Frame, Text: TextLabel, Ratio: number }

function UI.Bar(props: { [string]: any }): Bar
	local color = accentOf(props.Color)
	local back: Frame = UI.Create("Frame", {
		Size = props.Size or UDim2.new(1, 0, 0, 24),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Theme.Bg2,
		BorderSizePixel = 0,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.Stroke(nil, 1) })
	local fill: Frame = UI.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = back,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.Create("UIGradient", { Rotation = 90, Color = UI.ButtonSequence(color) }),
	})
	local text = UI.Label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		MaxText = props.MaxText or 16,
		Outline = 1,
		ZIndex = 2,
		Parent = back,
	})
	return { Frame = back, Fill = fill, Text = text, Ratio = 0 }
end

function UI.SetBar(bar: Bar, ratio: number, text: string?)
	if ratio ~= ratio then
		ratio = 0
	end
	ratio = math.clamp(ratio, 0, 1)
	if text and bar.Text.Text ~= text then
		bar.Text.Text = text
	end
	if math.abs(ratio - bar.Ratio) > 0.001 then
		bar.Ratio = ratio
		TweenService:Create(bar.Fill, BAR_INFO, { Size = UDim2.fromScale(ratio, 1) }):Play()
	end
end

-- Kurzes "Aufploppen" (z.B. wenn CR reinkommen) – weich, ohne Überschwingen
function UI.Pulse(scale: UIScale, amount: number?)
	scale.Scale = 1 + (amount or 0.1)
	TweenService:Create(scale, PULSE_INFO, { Scale = 1 }):Play()
end

-- ---------------------------------------------------------------------
-- FLÜSSIG ZÄHLENDE ZAHLEN (CR, Depotwert, Tresor) – "Rollziffern" wie auf der Website
-- ---------------------------------------------------------------------
export type Counter = {
	Label: TextLabel,
	Format: (number) -> string,
	Target: number,
	Shown: number,
	Text: string,
	Scale: UIScale?, -- UIScale am Label (falls vorhanden): ploppt bei Zuwachs kurz auf
	Color: Color3, -- eigentliche Schriftfarbe (Farbblitz kehrt dahin zurück)
	PopAt: number,
}

local counters: { Counter } = {}
local counterClock = 0

function UI.Counter(target: TextLabel, format: (number) -> string): Counter
	local counter: Counter = {
		Label = target,
		Format = format,
		Target = 0,
		Shown = 0,
		Text = format(0),
		Scale = target:FindFirstChildOfClass("UIScale"),
		Color = target.TextColor3,
		PopAt = 0,
	}
	target.Text = counter.Text
	table.insert(counters, counter)
	-- Label zerstört: Zähler aus der Liste nehmen (sonst wächst sie mit jedem neu gebauten Fenster)
	target.Destroying:Once(function()
		local index = table.find(counters, counter)
		if index then
			table.remove(counters, index)
		end
	end)
	return counter
end

-- Kurzer Farbblitz (Up bei Zuwachs, Down bei Abnahme) + Aufploppen bei Zuwachs
local function popCounter(counter: Counter, up: boolean)
	local now = os.clock()
	if now - counter.PopAt < COUNTER_POP_GAP then
		return
	end
	counter.PopAt = now
	local label = counter.Label
	label.TextColor3 = counter.Color
	TweenService:Create(label, COUNTER_FLASH_INFO, { TextColor3 = if up then UI.UpColor() else UI.DownColor() }):Play()
	local scale = counter.Scale
	if up and scale then
		UI.Pulse(scale, 0.08)
	end
end

-- instant = true: sofort anzeigen (z.B. beim ersten Laden)
function UI.SetCounter(counter: Counter, value: number, instant: boolean?)
	if type(value) ~= "number" or value ~= value then
		return
	end
	if not instant and value ~= counter.Target then
		popCounter(counter, value > counter.Target)
	end
	counter.Target = value
	if instant then
		counter.Shown = value
		UI.RedrawCounter(counter)
	end
end

-- Schreibt den Text sofort neu (z.B. wenn sich das Format/die Sprache geändert hat)
function UI.RedrawCounter(counter: Counter)
	local text = counter.Format(counter.Shown)
	counter.Text = text
	counter.Label.Text = text
end

local function stepCounters(dt: number)
	counterClock += dt
	if counterClock < COUNTER_INTERVAL then
		return
	end
	local alpha = 1 - math.exp(-counterClock * 7)
	counterClock = 0
	for _, counter in ipairs(counters) do
		local target = counter.Target
		if counter.Shown ~= target then
			local diff = target - counter.Shown
			if math.abs(diff) <= math.max(0.5, math.abs(target) * 0.0002) then
				counter.Shown = target
			else
				counter.Shown += diff * alpha
			end
			local text = counter.Format(counter.Shown)
			if text ~= counter.Text then
				counter.Text = text
				counter.Label.Text = text
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- FENSTER + BOTTOM-SHEETS (immer nur eins offen; Glas-Panel, Titel in BuilderExtended, schlichtes ✕)
-- Der Inhalt steckt nur WÄHREND des Auf-/Zugehens in einer CanvasGroup (für das weiche Einblenden).
-- Danach hängt er in einem normalen Frame: Eine CanvasGroup malt bei jeder kleinen Änderung
-- (Text, Balken, Scrollen) ihren ganzen Inhalt neu und macht Schrift auf Handys unscharf (REUSE §7 #34).
-- ---------------------------------------------------------------------
export type Window = {
	Group: Frame, -- Halter (Position, Größe, sichtbar ja/nein)
	Fader: CanvasGroup, -- nur während der Animation benutzt
	Panel: Frame, -- der eigentliche Fensterinhalt
	Shadow: Frame, -- weicher Schatten hinter dem Panel (wandert mit in die CanvasGroup)
	Scale: UIScale,
	Content: ScrollingFrame,
	IsOpen: boolean,
	Token: number,
	OnOpen: (() -> ())?,
	OnClose: (() -> ())?,
	Title: string,
	Kind: string, -- "Window" | "Sheet"
	RestPos: UDim2, -- Position im offenen Zustand
	HiddenPos: UDim2, -- Startposition beim Öffnen / Ziel beim Schließen
	TitleLabel: TextLabel,
}

-- Registrierte Fenster (§C7.3): Name -> öffnen/schließen. Ein UI.Window, das während open() aufgeht,
-- wird automatisch mit dem Namen verknüpft (dann meldet auch das ✕ das Schließen richtig).
type WindowEntry = {
	Name: string,
	OpenFn: () -> (),
	CloseFn: (() -> ())?,
	Win: Window?,
	Flag: boolean, -- offen (für Fenster ohne verknüpftes UI.Window, z. B. das Terminal)
	Announced: boolean, -- "WindowOpened" schon gefeuert
}

local windows: { Window } = {}
local registry: { [string]: WindowEntry } = {}
local entryOfWin: { [Window]: WindowEntry } = {}
local openingName: string? = nil
local warnedUnknown: { [string]: boolean } = {}
local blur: BlurEffect? = nil
local modalButton: TextButton? = nil

local function entryIsOpen(entry: WindowEntry): boolean
	local win = entry.Win
	if win then
		return win.IsOpen
	end
	return entry.Flag
end

-- true, sobald irgendein Fenster offen ist (UI.Window/Sheet oder registriertes Fremd-Fenster)
function UI.IsAnyWindowOpen(): boolean
	for _, win in ipairs(windows) do
		if win.IsOpen then
			return true
		end
	end
	for _, entry in pairs(registry) do
		if entryIsOpen(entry) then
			return true
		end
	end
	return false
end

-- Welt hinter offenen Fenstern weichzeichnen (lokaler BlurEffect, nach dem Schließen wieder weg)
-- + Modal-Knopf: solange ein Fenster offen ist, gibt er die Maus frei (auch bei Shift-Lock)
local touchHiddenByUs = false
local function updateWindowState()
	local open = UI.IsAnyWindowOpen()
	local modal = modalButton
	if modal and modal.Visible ~= open then
		modal.Visible = open
	end
	-- Handy: Roblox-Stick + Sprungknopf liegen sonst über Fenstern (Terminal-Kauf/Verkauf-Leiste unten rechts!)
	-- und lassen die Figur weiterlaufen -> solange ein Fenster offen ist, aus; danach wieder an
	if open ~= touchHiddenByUs then
		touchHiddenByUs = open
		pcall(function()
			GuiService.TouchControlsEnabled = not open
		end)
		if open then
			playUiSound("Whoosh") -- leiser Luftzug beim ersten Fenster (Wechsel zwischen Fenstern bleibt still)
		end
	end
	if open then
		UserInputService.MouseIconEnabled = true
		local effect = blur
		if not effect or effect.Parent == nil then
			effect = UI.Create("BlurEffect", { Name = "AkytexTycoonWindowBlur", Size = 0, Parent = Lighting })
			blur = effect
		end
		if effect then
			TweenService:Create(effect, BLUR_IN_INFO, { Size = BLUR_SIZE }):Play()
		end
	else
		local effect = blur
		if not effect then
			return
		end
		local fade = TweenService:Create(effect, BLUR_OUT_INFO, { Size = 0 })
		fade.Completed:Once(function()
			-- inzwischen wieder ein Fenster offen? Dann bleibt er
			if blur == effect and not UI.IsAnyWindowOpen() then
				blur = nil
				effect:Destroy()
			end
		end)
		fade:Play()
	end
end

-- Zustand eines registrierten Fensters setzen und die Hooks genau einmal pro Wechsel feuern
local function announceEntry(entry: WindowEntry)
	local open = entryIsOpen(entry)
	if open and not entry.Announced then
		entry.Announced = true
		fireHook("WindowOpened", entry.Name)
	elseif not open and entry.Announced then
		entry.Announced = false
		fireHook("WindowClosed", entry.Name)
	end
end

-- Inhalt (+ Schatten) für die Animation in die CanvasGroup hängen
local function beginFade(win: Window)
	if win.Panel.Parent ~= win.Fader then
		win.Shadow.Parent = win.Fader
		win.Panel.Parent = win.Fader
	end
	win.Fader.Visible = true
end

-- Animation fertig: Inhalt zurück in den normalen Frame, CanvasGroup aus
local function endFade(win: Window)
	win.Shadow.Parent = win.Group
	win.Panel.Parent = win.Group
	win.Fader.Visible = false
end

function UI.CloseWindow(win: Window)
	if not win.IsOpen then
		return
	end
	win.IsOpen = false
	win.Token += 1
	local token = win.Token
	beginFade(win)
	local sheet = win.Kind == "Sheet"
	local info = if sheet then SHEET_CLOSE_INFO else CLOSE_INFO
	if not sheet then
		TweenService:Create(win.Scale, CLOSE_INFO, { Scale = 0.97 }):Play()
	end
	TweenService:Create(win.Group, info, { Position = win.HiddenPos }):Play()
	local fade = TweenService:Create(win.Fader, info, { GroupTransparency = 1 })
	fade.Completed:Connect(function()
		if win.Token == token then
			win.Group.Visible = false
			endFade(win)
		end
	end)
	fade:Play()
	local entry = entryOfWin[win]
	if entry then
		announceEntry(entry)
	else
		fireHook("WindowClosed", win.Title)
	end
	updateWindowState()
	local onClose = win.OnClose
	if onClose then
		task.spawn(onClose)
	end
end

-- Registrierte Fremd-Fenster (ohne UI.Window) schließen, wenn ein anderes Fenster aufgeht
local function closeOtherEntries(except: WindowEntry?)
	for _, entry in pairs(registry) do
		if entry ~= except and entry.Win == nil and entry.Flag then
			entry.Flag = false
			local closeFn = entry.CloseFn
			if closeFn then
				local ok, err = pcall(closeFn)
				if not ok then
					warn("[UI] Fenster " .. entry.Name .. " schließen: " .. tostring(err))
				end
			end
			announceEntry(entry)
		end
	end
end

function UI.OpenWindow(win: Window)
	-- Wird das Fenster gerade über Windows.Open(name) geöffnet? Dann mit dem Namen verknüpfen.
	local pending = openingName
	if pending and not entryOfWin[win] then
		local entry = registry[pending]
		if entry and entry.Win == nil then
			entry.Win = win
			entry.Flag = false
			entryOfWin[win] = entry
		end
	end
	for _, other in ipairs(windows) do
		if other ~= win then
			UI.CloseWindow(other)
		end
	end
	closeOtherEntries(entryOfWin[win])
	if win.IsOpen then
		return
	end
	win.IsOpen = true
	win.Token += 1
	local token = win.Token
	beginFade(win)
	local sheet = win.Kind == "Sheet"
	if not win.Group.Visible then
		win.Fader.GroupTransparency = 1
		win.Scale.Scale = if sheet then 1 else 0.96
		win.Group.Position = win.HiddenPos
		win.Group.Visible = true
	end
	local fade = TweenService:Create(win.Fader, OPEN_FADE_INFO, { GroupTransparency = 0 })
	fade.Completed:Connect(function()
		if win.Token == token and win.IsOpen then
			endFade(win)
		end
	end)
	fade:Play()
	-- weich aufgehen (Quint Out, kein Überschwingen) und ein paar Pixel von unten hereingleiten
	if sheet then
		TweenService:Create(win.Group, SHEET_OPEN_INFO, { Position = win.RestPos }):Play()
	else
		TweenService:Create(win.Scale, OPEN_SCALE_INFO, { Scale = 1 }):Play()
		TweenService:Create(win.Group, OPEN_SCALE_INFO, { Position = win.RestPos }):Play()
	end
	local entry = entryOfWin[win]
	if entry then
		announceEntry(entry)
	else
		fireHook("WindowOpened", win.Title)
	end
	updateWindowState()
	if win.OnOpen then
		task.spawn(win.OnOpen)
	end
end

function UI.ToggleWindow(win: Window)
	if win.IsOpen then
		UI.CloseWindow(win)
	else
		UI.OpenWindow(win)
	end
end

function UI.CloseAll()
	for _, win in ipairs(windows) do
		UI.CloseWindow(win)
	end
	closeOtherEntries(nil)
	updateWindowState()
end

-- Gemeinsamer Aufbau von Fenster und Sheet
local function buildWindow(title: string, width: number, height: number, color: Color3?, kind: string): Window
	assert(root, "UI.Init zuerst aufrufen")
	local accent = accentOf(color)
	local sheet = kind == "Sheet"
	local restPos = if sheet then UDim2.new(0.5, 0, 1, WINDOW_PAD) else UDim2.fromScale(0.5, 0.5)
	local hiddenPos = if sheet
		then UDim2.new(0.5, 0, 1, height + WINDOW_PAD * 2)
		else UDim2.new(0.5, 0, 0.5, WINDOW_SLIDE)
	local group: Frame = UI.Create("Frame", {
		Name = if sheet then "Sheet" else "Window",
		AnchorPoint = if sheet then Vector2.new(0.5, 1) else Vector2.new(0.5, 0.5),
		Position = hiddenPos,
		Size = if sheet then UDim2.new(1, 0, 0, height + WINDOW_PAD) else UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 10,
		Parent = root,
	})
	if sheet then
		UI.Create("UISizeConstraint", { MaxSize = Vector2.new(SHEET_MAX_WIDTH, math.huge), Parent = group })
	end
	local scale: UIScale = UI.Create("UIScale", { Scale = if sheet then 1 else 0.96, Parent = group })
	local fader: CanvasGroup = UI.Create("CanvasGroup", {
		Name = "Fader",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		Parent = group,
	})
	-- weicher Schatten: zwei dunkle Flächen hinter dem Panel (leicht versetzt nach unten)
	local shadow: Frame = UI.Create("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(WINDOW_PAD - 4, WINDOW_PAD),
		Size = UDim2.new(1, -WINDOW_PAD * 2 + 8, 1, -WINDOW_PAD * 2 + 6),
		BackgroundColor3 = BLACK,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = group,
	}, { UI.Corner(20) })
	UI.Create("Frame", {
		Name = "Soft",
		Position = UDim2.fromOffset(-4, -2),
		Size = UDim2.new(1, 8, 1, 8),
		BackgroundColor3 = BLACK,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = shadow,
	}, { UI.Corner(24) })
	local panel: Frame = UI.Create("Frame", {
		Name = "Panel",
		Position = UDim2.fromOffset(WINDOW_PAD, WINDOW_PAD),
		Size = UDim2.new(1, -WINDOW_PAD * 2, 1, -WINDOW_PAD * 2),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = group,
	}, { UI.Corner(if sheet then 20 else 16), UI.Stroke(nil, 1) })
	local headerTop = if sheet then 10 else 0
	local header: Frame = UI.Create("Frame", {
		Name = "Header",
		Position = UDim2.fromOffset(0, headerTop),
		Size = UDim2.new(1, 0, 0, WINDOW_HEADER),
		BackgroundTransparency = 1,
		Active = sheet, -- Sheet: der Kopf ist die Zieh-Fläche
		Parent = panel,
	})
	if sheet then
		-- Greifer oben in der Mitte (wie iOS-Bottom-Sheets der Website)
		UI.Create("Frame", {
			Name = "Grabber",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 7),
			Size = UDim2.fromOffset(40, 4),
			BackgroundColor3 = Theme.Muted,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			Parent = panel,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	end
	-- Titel in GROSSBUCHSTABEN (BuilderExtended, 18–22 px)
	local titleLabel = UI.Label({
		Name = "Title",
		Position = UDim2.fromOffset(20, 12),
		Size = UDim2.new(1, -84, 0, 26),
		Text = UI.Upper(title),
		Face = "Display",
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 20,
		Parent = header,
	})
	UI.Create("Frame", {
		Name = "Underline",
		Position = UDim2.fromOffset(20, 42),
		Size = UDim2.fromOffset(28, 2),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Parent = header,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	UI.Create("Frame", {
		Name = "Divider",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		Parent = header,
	})
	local contentTop = headerTop + WINDOW_HEADER + 10
	local content: ScrollingFrame = UI.Create("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(16, contentTop),
		Size = UDim2.new(1, -24, 1, -(contentTop + 10 + (if sheet then WINDOW_PAD else 0))),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Muted,
		ScrollBarImageTransparency = 0.3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
		UI.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 2),
			PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 2),
			PaddingBottom = UDim.new(0, 12),
		}),
	})
	local win: Window = {
		Group = group,
		Fader = fader,
		Panel = panel,
		Shadow = shadow,
		Scale = scale,
		Content = content,
		IsOpen = false,
		Token = 0,
		OnOpen = nil,
		OnClose = nil,
		Title = title,
		Kind = kind,
		RestPos = restPos,
		HiddenPos = hiddenPos,
		TitleLabel = titleLabel,
	}
	-- Schließen: schlichtes ✕ (Ghost-Knopf, Hover = Hover-Fläche)
	UI.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 11),
		Size = UDim2.fromOffset(36, 36),
		Text = "✕",
		Variant = "Ghost",
		MaxText = 18,
		Corner = 10,
		Parent = header,
	}, function()
		local entry = entryOfWin[win]
		if entry and ctx and ctx.Windows then
			ctx.Windows.Close(entry.Name)
		else
			UI.CloseWindow(win)
		end
	end)
	if sheet then
		-- Nach unten ziehen schließt das Sheet (Touch und Maus), sonst federt es zurück
		local dragInput: InputObject? = nil
		local dragStart = 0
		local dragConn: RBXScriptConnection? = nil
		local endConn: RBXScriptConnection? = nil
		local function stopDrag(closeIt: boolean)
			dragInput = nil
			if dragConn then
				dragConn:Disconnect()
				dragConn = nil
			end
			if endConn then
				endConn:Disconnect()
				endConn = nil
			end
			if not win.IsOpen then
				return
			end
			if closeIt then
				local entry = entryOfWin[win]
				if entry and ctx and ctx.Windows then
					ctx.Windows.Close(entry.Name)
				else
					UI.CloseWindow(win)
				end
			else
				TweenService:Create(group, SHEET_OPEN_INFO, { Position = win.RestPos }):Play()
			end
		end
		header.InputBegan:Connect(function(input: InputObject)
			local kindIn = input.UserInputType
			if dragInput or not win.IsOpen then
				return
			end
			if kindIn ~= Enum.UserInputType.Touch and kindIn ~= Enum.UserInputType.MouseButton1 then
				return
			end
			dragInput = input
			dragStart = input.Position.Y
			dragConn = UserInputService.InputChanged:Connect(function(changed: InputObject)
				local active = dragInput
				if not active then
					return
				end
				local follows = changed == active
					or (
						active.UserInputType == Enum.UserInputType.MouseButton1
						and changed.UserInputType == Enum.UserInputType.MouseMovement
					)
				if not follows then
					return
				end
				local delta = math.max(0, (changed.Position.Y - dragStart) / UI.ScaleOf(group))
				group.Position = UDim2.new(0.5, 0, 1, WINDOW_PAD + delta)
			end)
			endConn = UserInputService.InputEnded:Connect(function(ended: InputObject)
				if ended ~= dragInput then
					return
				end
				local delta = (ended.Position.Y - dragStart) / UI.ScaleOf(group)
				stopDrag(delta >= SHEET_DRAG_CLOSE)
			end)
		end)
	end
	table.insert(windows, win)
	return win
end

-- Glas-Fenster: Surface (Transparenz 0.08), Ecke 16, 1-px-Border, weicher Schatten dahinter,
-- Kopf mit Titel (BuilderExtended, GROSS) + Akzent-Unterstrich und schlichtem ✕ rechts.
function UI.Window(title: string, width: number, height: number, color: Color3?): Window
	return buildWindow(title, width, height, color, "Window")
end

-- Bottom-Sheet (Handy-Stil der Website): volle Breite (≤ 760 px), gleitet von unten herein,
-- Greifer + Ziehen nach unten schließt. Gleiche Fenster-Regeln (immer nur eins offen, Blur, Hooks).
function UI.Sheet(title: string, height: number): Window
	local h = math.clamp(tonumber(height) or 420, 160, 900)
	return buildWindow(title, SHEET_MAX_WIDTH, h, nil, "Sheet")
end

-- ---------------------------------------------------------------------
-- WINDOWS-REGISTRY (§C7.3) = ctx.Windows
-- Fensternamen (frozen): Terminal, Tower, Shop, Quests, Academy, Season, Boards, Social, Garage, Boutique,
-- Prestige, Settings, Admin, Calendar, WelcomeBack. Immer nur ein Fenster offen.
-- ---------------------------------------------------------------------
local Windows = {}
UI.Windows = Windows

function Windows.Register(name: string, open: () -> (), close: (() -> ())?)
	if type(name) ~= "string" or type(open) ~= "function" then
		warn("[UI] Windows.Register: Name (string) und open-Funktion erwartet")
		return
	end
	local old = registry[name]
	if old and old.Win then
		entryOfWin[old.Win] = nil
	end
	registry[name] = { Name = name, OpenFn = open, CloseFn = close, Win = nil, Flag = false, Announced = false }
end

function Windows.IsOpen(name: string?): boolean
	if name == nil then
		return UI.IsAnyWindowOpen()
	end
	local entry = registry[name]
	return entry ~= nil and entryIsOpen(entry)
end

function Windows.Close(name: string?)
	if name == nil then
		for _, entry in pairs(registry) do
			Windows.Close(entry.Name)
		end
		UI.CloseAll()
		return
	end
	local entry = registry[name]
	if not entry or not entryIsOpen(entry) then
		return
	end
	local closeFn = entry.CloseFn
	if closeFn then
		local ok, err = pcall(closeFn)
		if not ok then
			warn("[UI] Fenster " .. name .. " schließen: " .. tostring(err))
		end
	end
	local win = entry.Win
	if win and win.IsOpen then
		UI.CloseWindow(win)
	end
	entry.Flag = false
	announceEntry(entry)
	updateWindowState()
end

function Windows.Open(name: string)
	local entry = registry[name]
	if not entry then
		if not warnedUnknown[name] then
			warnedUnknown[name] = true
			warn("[UI] Fenster nicht registriert: " .. tostring(name))
		end
		return
	end
	-- andere registrierte Fenster zu (nur eins gleichzeitig)
	for _, other in pairs(registry) do
		if other ~= entry and entryIsOpen(other) then
			Windows.Close(other.Name)
		end
	end
	-- auch unregistrierte UI.Window/Sheets (z. B. Multiplikator-Aufschlüsselung) schließen
	for _, win in ipairs(windows) do
		if win.IsOpen and not entryOfWin[win] then
			UI.CloseWindow(win)
		end
	end
	openingName = name
	local ok, err = pcall(entry.OpenFn)
	openingName = nil
	if not ok then
		warn("[UI] Fenster " .. name .. " öffnen: " .. tostring(err))
		return
	end
	if entry.Win == nil then
		entry.Flag = true -- Fremd-Fenster ohne UI.Window: offen, bis Windows.Close(name) kommt
	end
	announceEntry(entry)
	updateWindowState()
end

function Windows.Toggle(name: string)
	if Windows.IsOpen(name) then
		Windows.Close(name)
	else
		Windows.Open(name)
	end
end

-- ---------------------------------------------------------------------
-- TOASTS: schlanke Pill oben in der Mitte (Surface + 1-px-Rahmen, farbiger Punkt je Art),
-- gleitet 8 px herein und blendet aus; gestapelt (neueste unten). Normale Frames + kleiner Vorrat.
-- ---------------------------------------------------------------------
type ToastEntry = {
	Container: Frame, -- Platzhalter in der Liste (wächst/schrumpft -> andere rutschen weich nach)
	Inner: Frame, -- die Pill; bewegt sich, ohne die Liste zu verschieben
	Corner: UICorner,
	Stroke: UIStroke,
	Dot: Frame,
	Label: TextLabel,
	Height: number,
	Leaving: boolean,
	Token: number,
	Kind: string,
}

-- Punkt-Farbe je Art (Info/Ansage = Accent, Erfolg = Up, Fehler/Alarm = Down, Event = Warn)
local TOAST_DOTS: { [string]: Color3 } = {
	Info = Theme.Accent,
	Success = Theme.Up,
	Error = Theme.Down,
	Event = Theme.Warn,
	Alarm = Theme.Down,
	Announce = Theme.Accent,
}

-- Rahmen je Art (wichtige Meldungen mit farbigem Rahmen)
local TOAST_STROKES: { [string]: Color3 } = {
	Alarm = Theme.Down,
	Announce = Theme.Accent,
}

-- Schriftgröße je Art (Alarm etwas größer)
local TOAST_TEXT_SIZE: { [string]: number } = {
	Info = 17,
	Success = 17,
	Error = 17,
	Event = 17,
	Announce = 18,
	Alarm = 19,
}

-- Zu viele Toasts: zuerst fliegt der älteste mit der KLEINSTEN Wichtigkeit raus.
local TOAST_PRIORITY: { [string]: number } = {
	Info = 1,
	Event = 1,
	Success = 2,
	Error = 2,
	Announce = 2,
	Alarm = 3,
}

local TOAST_BG_T = 0.04 -- Pill fast deckend
local toastHolder: Frame? = nil
local TOAST_TOP = 14 -- Meldungen stehen so weit unter dem oberen Rand
local toastCount = 0
local activeToasts: { ToastEntry } = {}
local toastPool: { ToastEntry } = {}

-- Position der Pill im Platzhalter (oben Mitte; offsetY < 0 = darüber)
local function toastPosition(offsetY: number): UDim2
	return UDim2.new(0.5, 0, 0, offsetY)
end

local function newToastEntry(): ToastEntry
	local container: Frame = UI.Create("Frame", {
		Name = "Toast",
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
	})
	local corner: UICorner = UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) })
	local stroke: UIStroke = UI.Create("UIStroke", {
		Color = Theme.Border,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	local inner: Frame = UI.Create("Frame", {
		Name = "Inner",
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(200, TOAST_MIN_HEIGHT),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = TOAST_BG_T,
		BorderSizePixel = 0,
		Parent = container,
	}, { corner, stroke })
	local dot: Frame = UI.Create("Frame", {
		Name = "Dot",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, TOAST_PAD_X, 0.5, 0),
		Size = UDim2.fromOffset(TOAST_DOT, TOAST_DOT),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = inner,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local label: TextLabel = UI.Create("TextLabel", {
		Name = "Text",
		Position = UDim2.fromOffset(TOAST_PAD_X + TOAST_DOT + TOAST_DOT_GAP, 0),
		Size = UDim2.new(1, -(TOAST_PAD_X * 2 + TOAST_DOT + TOAST_DOT_GAP), 1, 0),
		BackgroundTransparency = 1,
		Font = UI.Fonts.Main,
		TextColor3 = Theme.Text,
		TextSize = 17,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Parent = inner,
	})
	return {
		Container = container,
		Inner = inner,
		Corner = corner,
		Stroke = stroke,
		Dot = dot,
		Label = label,
		Height = TOAST_MIN_HEIGHT,
		Leaving = false,
		Token = 0,
		Kind = "Info",
	}
end

-- Welcher Toast soll weichen? Der älteste mit der kleinsten Wichtigkeit.
local function toastToDrop(): ToastEntry
	local drop = activeToasts[1]
	local lowest = math.huge
	for _, entry in ipairs(activeToasts) do
		local priority = TOAST_PRIORITY[entry.Kind] or 1
		if priority < lowest then
			drop, lowest = entry, priority
		end
	end
	return drop
end

-- Ein-/Ausblenden (Pill, Rahmen, Punkt, Text). shown = sichtbar. Gibt den Tween des Texts zurück.
local function fadeToast(entry: ToastEntry, info: TweenInfo, shown: boolean): Tween
	TweenService:Create(entry.Inner, info, { BackgroundTransparency = if shown then TOAST_BG_T else 1 }):Play()
	TweenService:Create(entry.Stroke, info, { Transparency = if shown then 0 else 1 }):Play()
	TweenService:Create(entry.Dot, info, { BackgroundTransparency = if shown then 0 else 1 }):Play()
	local textTween = TweenService:Create(entry.Label, info, { TextTransparency = if shown then 0 else 1 })
	textTween:Play()
	return textTween
end

local function hideToastNow(entry: ToastEntry)
	entry.Inner.BackgroundTransparency = 1
	entry.Stroke.Transparency = 1
	entry.Dot.BackgroundTransparency = 1
	entry.Label.TextTransparency = 1
end

local function removeToast(entry: ToastEntry)
	if entry.Leaving then
		return
	end
	entry.Leaving = true
	local token = entry.Token
	local index = table.find(activeToasts, entry)
	if index then
		table.remove(activeToasts, index)
	end
	-- gleitet etwas hoch und blendet aus, danach rutschen die anderen nach
	TweenService:Create(entry.Inner, TOAST_OUT_INFO, { Position = toastPosition(-TOAST_SLIDE * 0.75) }):Play()
	local fade = fadeToast(entry, TOAST_OUT_INFO, false)
	fade.Completed:Connect(function()
		if entry.Token ~= token then
			return
		end
		local shrink = TweenService:Create(entry.Container, TOAST_GROW_INFO, { Size = UDim2.new(1, 0, 0, 0) })
		shrink.Completed:Connect(function()
			if entry.Token ~= token then
				return
			end
			-- fertig -> aufheben und später wiederverwenden
			entry.Container.Parent = nil
			if #toastPool < MAX_TOAST_POOL then
				table.insert(toastPool, entry)
			else
				entry.Container:Destroy()
			end
		end)
		shrink:Play()
	end)
end

-- Meldungen tiefer setzen, solange oben etwas anderes steht (Ticker-Leiste, Pillen, Terminal-Kopf).
-- nil = wieder an die normale Stelle.
local toastBaseTop = TOAST_TOP
local toastFloor = 0
local function placeToasts()
	local holder = toastHolder
	if holder then
		local goal = UDim2.new(0.5, 0, 0, math.clamp(math.max(toastBaseTop, toastFloor), 0, 600))
		if holder.Position ~= goal then
			TweenService:Create(holder, TOAST_GROW_INFO, { Position = goal }):Play()
		end
	end
end

function UI.SetToastTop(offset: number?)
	toastBaseTop = if type(offset) == "number" and offset == offset then math.clamp(offset, 0, 600) else TOAST_TOP
	placeToasts()
end

-- Mindest-Höhe der Meldungen, solange oben in der Mitte eine Karte steht (News-Eilmeldung); nil/0 = keine.
-- Wirkt zusätzlich zu SetToastTop (das besitzt der HUD) – so verdeckt die Karte nie eine Meldung.
function UI.SetToastFloor(y: number?)
	toastFloor = if type(y) == "number" and y == y then math.clamp(y, 0, 600) else 0
	placeToasts()
end

function UI.Toast(text: string, kind: string?)
	local holder = toastHolder
	if not holder or type(text) ~= "string" or text == "" then
		return
	end
	toastCount += 1
	local key = if kind and TOAST_DOTS[kind] then kind else "Info"
	local entry = table.remove(toastPool) or newToastEntry()
	entry.Token += 1
	entry.Leaving = false
	entry.Kind = key
	local token = entry.Token
	-- Größe passend zum Text: kurze Meldungen = schmale Pill, lange brechen um (dann Ecke 14)
	local textSize = TOAST_TEXT_SIZE[key] or 17
	local chrome = TOAST_PAD_X * 2 + TOAST_DOT + TOAST_DOT_GAP
	local maxText = TOAST_WIDTH - chrome
	local bounds = TextService:GetTextSize(text, textSize, UI.Fonts.Main, Vector2.new(maxText, 1000))
	local width = math.min(TOAST_WIDTH, math.ceil(bounds.X) + chrome + 2)
	local height = math.max(TOAST_MIN_HEIGHT, math.ceil(bounds.Y) + 16)
	local multiLine = bounds.Y > textSize * 1.6
	entry.Height = height
	entry.Label.Text = text
	entry.Label.TextSize = textSize
	entry.Label.TextColor3 = Theme.Text
	entry.Dot.BackgroundColor3 = TOAST_DOTS[key]
	entry.Stroke.Color = TOAST_STROKES[key] or Theme.Border
	entry.Corner.CornerRadius = if multiLine then UDim.new(0, 14) else UDim.new(0.5, 0)
	entry.Inner.Size = UDim2.fromOffset(width, height)
	entry.Inner.Position = toastPosition(-TOAST_SLIDE)
	entry.Container.Size = UDim2.new(1, 0, 0, 0)
	entry.Container.LayoutOrder = toastCount
	hideToastNow(entry)
	entry.Container.Parent = holder
	table.insert(activeToasts, entry)
	TweenService:Create(entry.Container, TOAST_GROW_INFO, { Size = UDim2.new(1, 0, 0, height + TOAST_GAP) }):Play()
	TweenService:Create(entry.Inner, TOAST_IN_INFO, { Position = toastPosition(0) }):Play()
	fadeToast(entry, TOAST_IN_INFO, true)
	while #activeToasts > MAX_TOASTS do
		removeToast(toastToDrop())
	end
	if key == "Error" or key == "Alarm" then
		playUiSound("UIError")
	end
	task.delay((key == "Announce" or key == "Event") and 7 or 4, function()
		if entry.Token == token then
			removeToast(entry)
		end
	end)
end

-- ---------------------------------------------------------------------
-- PREISE (Robux) aus dem Marktplatz – einmal laden, dann merken (Id 0 = nicht eingerichtet -> nil)
-- ---------------------------------------------------------------------
local priceCache: { [number]: number } = {}
local priceWaiting: { [number]: { (number?) -> () } } = {}

function UI.FetchPrice(id: number, infoType: Enum.InfoType, callback: (number?) -> ())
	if type(id) ~= "number" or id == 0 then
		task.spawn(callback, nil)
		return
	end
	local cached = priceCache[id]
	if cached then
		task.spawn(callback, cached)
		return
	end
	local waiting = priceWaiting[id]
	if waiting then
		table.insert(waiting, callback)
		return
	end
	priceWaiting[id] = { callback }
	task.spawn(function()
		local ok, info = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, id, infoType)
		local price = if ok and type(info) == "table" then tonumber(info.PriceInRobux) else nil
		if price then
			priceCache[id] = price
		end
		local list = priceWaiting[id] or {}
		priceWaiting[id] = nil
		for _, cb in ipairs(list) do
			task.spawn(cb, price)
		end
	end)
end

-- ---------------------------------------------------------------------
-- LÄNDER-REGEL "Paid Random Items" (fail-closed, für spätere Produkte): Server-State "RandomAllowed",
-- nach 30 s ohne Server-Wert PolicyService selbst fragen. Im Zweifel/bei Fehler: NICHT erlaubt.
-- ---------------------------------------------------------------------
local randomAllowed: boolean? = nil
local randomWaiting: { (boolean) -> () } = {}
local randomStarted = false

local function resolveRandom(allowed: boolean)
	randomAllowed = allowed
	if #randomWaiting == 0 then
		return
	end
	local waiting = randomWaiting
	randomWaiting = {}
	for _, cb in ipairs(waiting) do
		task.spawn(cb, allowed)
	end
end

local function stateRandom(): boolean?
	local state = ctx and ctx.State
	if type(state) == "table" and type(state.RandomAllowed) == "boolean" then
		return state.RandomAllowed
	end
	return nil
end

function UI.WhenRandomItemsKnown(callback: (allowed: boolean) -> ())
	local known = stateRandom()
	if known ~= nil then
		randomAllowed = known
	end
	if randomAllowed ~= nil then
		task.spawn(callback, randomAllowed)
		return
	end
	table.insert(randomWaiting, callback)
	if randomStarted then
		return
	end
	randomStarted = true
	task.delay(RANDOM_STATE_WAIT, function()
		if randomAllowed ~= nil then
			return
		end
		local ok, info = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, Players.LocalPlayer)
		if randomAllowed == nil then
			resolveRandom(ok and type(info) == "table" and info.ArePaidRandomItemsRestricted == false)
		end
	end)
end

-- true/false, oder nil solange die Antwort noch nicht da ist
function UI.RandomItemsAllowed(): boolean?
	local known = stateRandom()
	if known ~= nil then
		return known
	end
	return randomAllowed
end

-- =====================================================================
-- AT-NEUTEILE (§C7.5, REUSE §4.10/§4.11)
-- =====================================================================

-- ---------------------------------------------------------------------
-- WÄHRUNGS-SYMBOLE (DESIGN §0.1): CR = grüner Sechskant-Chip, AKY = blaue Münze mit „Λ“ – nur Frames, keine Bilder
-- ---------------------------------------------------------------------
local function hexagon(parent: Instance, color: Color3, scale: number, z: number): Frame
	local holder: Frame = UI.Create("Frame", {
		Name = "Hex",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(scale, scale),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})
	-- drei gedrehte Rechtecke (Breite W, Höhe W·tan30°) ergeben zusammen ein regelmäßiges Sechseck
	for _, rotation in ipairs({ 0, 60, 120 }) do
		UI.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.866, 0.5),
			Rotation = rotation,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = z,
			Parent = holder,
		})
	end
	return holder
end

function UI.CurrencyIcon(parent: Instance, kind: string, size: number?): Frame
	local px = math.clamp(tonumber(size) or 20, 8, 128)
	local icon: Frame = UI.Create("Frame", {
		Name = "Currency" .. tostring(kind),
		Size = UDim2.fromOffset(px, px),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local z = 2
	if parent:IsA("GuiObject") then
		z = parent.ZIndex + 1
	end
	icon.ZIndex = z
	if kind == "AKY" then
		local coin: Frame = UI.Create("Frame", {
			Name = "Coin",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			ZIndex = z,
			Parent = icon,
		}, {
			UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
			UI.Create("UIStroke", {
				Color = Theme.Accent:Lerp(WHITE, 0.45),
				Thickness = 1,
				Transparency = 0.2,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			}),
			UI.Gradient(Theme.Accent:Lerp(WHITE, 0.12), Theme.AccentDeep, 90),
		})
		-- „Λ“ aus zwei gedrehten Strichen (keine Schrift nötig)
		local strokes = { { 0.415, 0.5, -66.97 }, { 0.585, 0.5, 66.97 } }
		for _, spec in ipairs(strokes) do
			UI.Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(spec[1], spec[2]),
				Size = UDim2.fromScale(0.44, 0.11),
				Rotation = spec[3],
				BackgroundColor3 = WHITE,
				BorderSizePixel = 0,
				ZIndex = z + 1,
				Parent = coin,
			}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
		end
	else
		hexagon(icon, Theme.Up, 1, z)
		hexagon(icon, Theme.Up:Lerp(BLACK, 0.38), 0.62, z + 1)
		hexagon(icon, Theme.Up:Lerp(WHITE, 0.15), 0.34, z + 2)
	end
	return icon
end

-- ---------------------------------------------------------------------
-- SEGMENTED CONTROL (Zeitrahmen, Chart-Typ, Tabs): Bg2-Schiene, gleitende Markierung (0.22 s Quint Out)
-- options: { string } oder { { Key = string, Text = string } }. onChange(key) nur bei Benutzer-Klick.
-- ---------------------------------------------------------------------
export type Segmented = {
	Frame: Frame,
	Set: (key: string, silent: boolean?) -> (),
	Get: () -> string?,
}

function UI.Segmented(parent: Instance, options: { any }, onChange: ((key: string) -> ())?): Segmented
	local items: { { Key: string, Text: string } } = {}
	for _, option in ipairs(options or {}) do
		if type(option) == "string" then
			table.insert(items, { Key = option, Text = option })
		elseif type(option) == "table" and type(option.Key) == "string" then
			table.insert(items, { Key = option.Key, Text = tostring(option.Text or option.Key) })
		end
	end
	local count = math.max(1, #items)
	local frame: Frame = UI.Create("Frame", {
		Name = "Segmented",
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Theme.Bg2,
		BorderSizePixel = 0,
		Parent = parent,
	}, { UI.Corner(10), UI.Stroke(nil, 1) })
	local marker: Frame = UI.Create("Frame", {
		Name = "Marker",
		Position = UDim2.new(0, 3, 0, 3),
		Size = UDim2.new(1 / count, -6, 1, -6),
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = frame,
	}, {
		UI.Corner(8),
		UI.Create("UIStroke", { Color = Theme.Accent, Thickness = 1, Transparency = 0.35 }),
	})
	local labels: { TextButton } = {}
	local selected: string? = if items[1] then items[1].Key else nil
	local function paint(instant: boolean)
		local index = 1
		for i, item in ipairs(items) do
			if item.Key == selected then
				index = i
			end
		end
		local goal = UDim2.new((index - 1) / count, 3, 0, 3)
		if instant then
			marker.Position = goal
		else
			TweenService:Create(marker, SEGMENT_INFO, { Position = goal }):Play()
		end
		for i, button in ipairs(labels) do
			local on = items[i] and items[i].Key == selected
			local label = button:FindFirstChild("Text")
			if label and label:IsA("TextLabel") then
				label.TextColor3 = if on then Theme.Text else Theme.Text2
			end
		end
	end
	for i, item in ipairs(items) do
		local button: TextButton = UI.Create("TextButton", {
			Name = item.Key,
			Position = UDim2.fromScale((i - 1) / count, 0),
			Size = UDim2.fromScale(1 / count, 1),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 2,
			Parent = frame,
		})
		UI.Label({
			Name = "Text",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, -8, 0.56, 0),
			Text = item.Text,
			Face = "MonoBold",
			TextColor3 = Theme.Text2,
			MaxText = 15,
			ZIndex = 3,
			Parent = button,
		})
		button.Activated:Connect(function()
			if selected == item.Key then
				return
			end
			selected = item.Key
			playUiSound("UIClick")
			paint(false)
			if onChange then
				task.spawn(function()
					local ok, err = pcall(onChange, item.Key)
					if not ok then
						warn("[UI] Segmented: " .. tostring(err))
					end
				end)
			end
		end)
		table.insert(labels, button)
	end
	paint(true)
	return {
		Frame = frame,
		Set = function(key: string, _silent: boolean?)
			for _, item in ipairs(items) do
				if item.Key == key then
					if selected ~= key then
						selected = key
						paint(false)
					end
					return
				end
			end
		end,
		Get = function(): string?
			return selected
		end,
	}
end

-- ---------------------------------------------------------------------
-- PREIS-ETIKETT: "123,45  ▲ +2,35 %" (Preis in Text, Veränderung in Up/Down + Pfeil). Schreibt nur bei Änderung.
-- ---------------------------------------------------------------------
local function formatPrice(cents: number): string
	local format = ctx and ctx.Format
	if format and type(format.Price) == "function" then
		local ok, text = pcall(format.Price, cents, langNow())
		if ok and type(text) == "string" then
			return text
		end
	end
	return string.format("%.2f", cents / 100)
end

local function formatPct(fraction: number): string
	local format = ctx and ctx.Format
	if format and type(format.Pct) == "function" then
		local ok, text = pcall(format.Pct, fraction, langNow(), 2, true)
		if ok and type(text) == "string" then
			return text
		end
	end
	return string.format("%+.2f %%", fraction * 100)
end

function UI.PriceTag(label: TextLabel, cents: number, change: number?)
	if typeof(label) ~= "Instance" or not label:IsA("TextLabel") then
		return
	end
	local price = tonumber(cents)
	if not price or price ~= price then
		return
	end
	local text: string
	local delta = tonumber(change)
	if delta and delta == delta then
		local color = UI.ColorHex(UI.TrendColor(delta))
		text = string.format(
			'%s  <font color="%s">%s %s</font>',
			formatPrice(price),
			color,
			UI.TrendArrow(delta),
			formatPct(delta)
		)
	else
		text = formatPrice(price)
	end
	if not label.RichText then
		label.RichText = true
	end
	if label.Text ~= text then
		label.Text = text
	end
end

-- ---------------------------------------------------------------------
-- SPARKLINE (Mini-Linie): n-1 gepoolte Segment-Frames, Koordinaten aus dem Seitenverhältnis (skalierungsfest)
-- ---------------------------------------------------------------------
export type Sparkline = { Frame: Frame, Set: (points: { number }) -> () }

function UI.Sparkline(parent: Instance, n: number): Sparkline
	local slots = math.clamp(math.floor(tonumber(n) or 30), 2, MAX_SPARK_POINTS)
	local frame: Frame = UI.Create("Frame", {
		Name = "Sparkline",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
		Parent = parent,
	})
	local segments: { Frame } = {}
	for i = 1, slots - 1 do
		segments[i] = UI.Create("Frame", {
			Name = "Seg",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.new(0, 0, 0, 1.5),
			BackgroundColor3 = Theme.Muted,
			BorderSizePixel = 0,
			Visible = false,
			Parent = frame,
		})
	end
	local points: { number } = {}
	local function render()
		local size = frame.AbsoluteSize
		local w, h = size.X, size.Y
		local m = math.min(#points, slots)
		if w < 2 or h < 2 or m < 2 then
			for _, seg in ipairs(segments) do
				if seg.Visible then
					seg.Visible = false
				end
			end
			return
		end
		local lo, hi = math.huge, -math.huge
		for i = 1, m do
			local v = points[i]
			if v < lo then
				lo = v
			end
			if v > hi then
				hi = v
			end
		end
		local range = hi - lo
		local color = if points[m] >= points[1] then UI.UpColor() else UI.DownColor()
		local function yOf(v: number): number
			if range <= 0 then
				return 0.5
			end
			return 0.92 - (v - lo) / range * 0.84
		end
		for i = 1, slots - 1 do
			local seg = segments[i]
			if i < m then
				local x1, x2 = (i - 1) / (m - 1), i / (m - 1)
				local y1, y2 = yOf(points[i]), yOf(points[i + 1])
				local dxPx, dyPx = (x2 - x1) * w, (y2 - y1) * h
				local length = math.sqrt(dxPx * dxPx + dyPx * dyPx)
				local position = UDim2.fromScale((x1 + x2) / 2, (y1 + y2) / 2)
				local sizeUdim = UDim2.new(length / w, 1, 0, 1.5)
				local rotation = math.deg(math.atan2(dyPx, dxPx))
				if seg.Position ~= position then
					seg.Position = position
				end
				if seg.Size ~= sizeUdim then
					seg.Size = sizeUdim
				end
				if math.abs(seg.Rotation - rotation) > 0.01 then
					seg.Rotation = rotation
				end
				if seg.BackgroundColor3 ~= color then
					seg.BackgroundColor3 = color
				end
				if not seg.Visible then
					seg.Visible = true
				end
			elseif seg.Visible then
				seg.Visible = false
			end
		end
	end
	frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(render)
	return {
		Frame = frame,
		Set = function(newPoints: { number })
			table.clear(points)
			if type(newPoints) == "table" then
				local start = math.max(1, #newPoints - slots + 1)
				for i = start, #newPoints do
					local v = tonumber(newPoints[i])
					if v and v == v and v ~= math.huge and v ~= -math.huge then
						table.insert(points, v)
					end
				end
			end
			render()
		end,
	}
end

-- ---------------------------------------------------------------------
-- LAUFBAND (Ticker): gepoolte RichText-Labels in einem ungedrehten Clip-Frame; je Frame wird nur der
-- Container verschoben, der erste Eintrag wandert ans Ende (O(1)). Maus darüber = Pause (wie die Website).
-- rows: { { Ticker = string, Price = number (Cent), Change = number (Anteil) } } oder { { Text = string } }
-- ---------------------------------------------------------------------
export type Ticker = {
	Frame: Frame,
	SetRows: (rows: { any }) -> (),
	SetSpeed: (pxPerSecond: number) -> (),
}

type TickerState = {
	Clip: Frame,
	Track: Frame,
	Labels: { TextLabel },
	Count: number,
	Offset: number,
	Speed: number,
	Paused: boolean,
	NextOrder: number,
	Head: number, -- Index (in Labels) des Eintrags ganz vorn – wandert im Kreis (O(1) je Frame, kein Suchen)
	ScaleAt: number,
	Scale: number,
	Alive: boolean,
}

local tickers: { TickerState } = {}

local function tickerText(row: any): string
	if type(row) ~= "table" then
		return ""
	end
	if type(row.Text) == "string" then
		return row.Text
	end
	local ticker = tostring(row.Ticker or "?")
	local price = tonumber(row.Price)
	local change = tonumber(row.Change)
	local parts = { string.format('<font color="%s">%s</font>', UI.ColorHex(Theme.Text), ticker) }
	if price and price == price then
		table.insert(parts, string.format('<font color="%s">%s</font>', UI.ColorHex(Theme.Text2), formatPrice(price)))
	end
	if change and change == change then
		table.insert(
			parts,
			string.format(
				'<font color="%s">%s %s</font>',
				UI.ColorHex(UI.TrendColor(change)),
				UI.TrendArrow(change),
				formatPct(change)
			)
		)
	end
	return table.concat(parts, "  ")
end

function UI.Ticker(parent: Instance): Ticker
	local clip: Frame = UI.Create("Frame", {
		Name = "Ticker",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = parent,
	})
	local track: Frame = UI.Create("Frame", {
		Name = "Track",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Parent = clip,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, TICKER_GAP),
		}),
	})
	local state: TickerState = {
		Clip = clip,
		Track = track,
		Labels = {},
		Count = 0,
		Offset = 0,
		Speed = TICKER_SPEED,
		Paused = false,
		NextOrder = 0,
		Head = 1,
		ScaleAt = -math.huge,
		Scale = 1,
		Alive = true,
	}
	clip.MouseEnter:Connect(function()
		state.Paused = true
	end)
	clip.MouseLeave:Connect(function()
		state.Paused = false
	end)
	table.insert(tickers, state)
	clip.Destroying:Once(function()
		state.Alive = false
		local index = table.find(tickers, state)
		if index then
			table.remove(tickers, index)
		end
	end)
	return {
		Frame = clip,
		SetRows = function(rows: { any })
			local list = if type(rows) == "table" then rows else {}
			local count = math.min(#list, TICKER_MAX_ROWS)
			for i = 1, count do
				local label = state.Labels[i]
				if not label then
					state.NextOrder += 1
					label = UI.Create("TextLabel", {
						Name = "Item",
						Size = UDim2.fromScale(0, 1),
						AutomaticSize = Enum.AutomaticSize.X,
						BackgroundTransparency = 1,
						FontFace = UI.Faces.Mono,
						TextSize = 14,
						RichText = true,
						TextColor3 = Theme.Text,
						Text = "",
						LayoutOrder = state.NextOrder,
						Parent = track,
					})
					state.Labels[i] = label
				end
				local text = tickerText(list[i])
				if label.Text ~= text then
					label.Text = text
				end
				if not label.Visible then
					label.Visible = true
				end
			end
			for i = count + 1, #state.Labels do
				local label = state.Labels[i]
				if label.Visible then
					label.Visible = false
				end
			end
			if count ~= state.Count then
				-- andere Anzahl (Start, Neu-Notierung): Reihenfolge = Index, vorn = 1 (Kreis wieder geschlossen)
				for i, label in ipairs(state.Labels) do
					label.LayoutOrder = i
				end
				state.NextOrder = #state.Labels
				state.Head = 1
				state.Offset = 0
				state.Track.Position = UDim2.fromOffset(0, 0)
			end
			state.Count = count
		end,
		SetSpeed = function(pxPerSecond: number)
			local v = tonumber(pxPerSecond)
			if v and v == v then
				state.Speed = math.clamp(v, 0, 400)
			end
		end,
	}
end

local function stepTickers(dt: number)
	local now = os.clock()
	for _, state in ipairs(tickers) do
		if state.Alive and state.Count > 0 and not state.Paused and state.Speed > 0 then
			local clip = state.Clip
			if now - state.ScaleAt > 1 then
				state.ScaleAt = now
				state.Scale = UI.ScaleOf(clip)
			end
			local scale = state.Scale
			local clipWidth = clip.AbsoluteSize.X / scale
			local trackWidth = state.Track.AbsoluteSize.X / scale
			if clip.Visible and clip.AbsoluteSize.X > 2 and trackWidth > clipWidth then
				state.Offset -= state.Speed * dt
				-- erster Eintrag ganz draußen? -> ans Ende hängen (eine Verschiebung, kein Neuaufbau, kein Suchen)
				local head = math.clamp(state.Head, 1, state.Count)
				local first = state.Labels[head]
				if first then
					local width = first.AbsoluteSize.X / scale + TICKER_GAP
					if -state.Offset >= width then
						state.NextOrder += 1
						first.LayoutOrder = state.NextOrder
						state.Offset += width
						state.Head = (head % state.Count) + 1
					end
				end
				state.Track.Position = UDim2.fromOffset(math.floor(state.Offset + 0.5), 0)
			elseif state.Offset ~= 0 then
				state.Offset = 0
				state.Track.Position = UDim2.fromOffset(0, 0)
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- AUS DEM CC-ADMINPANEL GEHOBEN (REUSE §4.10): Chip, StatTile, RowCard, RowActions, Slider, Cycler, NavItem
-- ---------------------------------------------------------------------
-- Kleine Pill (voll rund), z. B. "VERDIENT"/"GEKAUFT" im Multiplikator-Sheet oder "ADMIN" in einer Zeile
function UI.Chip(parent: Instance, text: string, color: Color3, props: { [string]: any }?): Frame
	local tint = if typeof(color) == "Color3" then color else Theme.Accent
	local frame: Frame = UI.Create("Frame", {
		Name = "Chip",
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = tint,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		Parent = parent,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.Create("UIStroke", {
			Color = tint,
			Thickness = 1,
			Transparency = 0.45,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		UI.Create("UIPadding", { PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9) }),
	})
	UI.Create("TextLabel", {
		Name = "Text",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = UI.Fonts.Main,
		TextSize = 12,
		TextColor3 = tint:Lerp(WHITE, 0.25),
		Text = text,
		Parent = frame,
	})
	if props then
		for key, value in pairs(props) do
			(frame :: any)[key] = value
		end
	end
	return frame
end

-- Kennzahl-Kachel (Dashboard): kleine Überschrift (Muted) + große Zahl (BuilderMono). Rückgabe = Wert-Label.
function UI.StatTile(parent: Instance, caption: string, order: number): TextLabel
	local card = UI.Card({ Size = UDim2.fromScale(1, 1), LayoutOrder = order, Parent = parent })
	UI.Label({
		Name = "Caption",
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -24, 0, 16),
		Text = caption,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 13,
		Parent = card,
	})
	return UI.Label({
		Name = "Value",
		Position = UDim2.fromOffset(12, 26),
		Size = UDim2.new(1, -24, 0, 28),
		Text = "–",
		Face = "MonoBold",
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 24,
		Parent = card,
	})
end

-- Zeilen-Karte (Listen): Surface2, Ecke 10, 1-px-Rahmen, Hover = Hover-Fläche
function UI.RowCard(parent: Instance, order: number, height: number): Frame
	local card: Frame = UI.Create("Frame", {
		Name = "Row",
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = parent,
	}, { UI.Corner(10), UI.Stroke(nil, 1) })
	card.MouseEnter:Connect(function()
		TweenService:Create(card, HOVER_INFO, { BackgroundColor3 = Theme.Hover }):Play()
	end)
	card.MouseLeave:Connect(function()
		TweenService:Create(card, HOVER_INFO, { BackgroundColor3 = Theme.Surface2 }):Play()
	end)
	return card
end

-- Knopf-Spalte rechts in einer Zeilen-Karte
function UI.RowActions(card: Frame, width: number): Frame
	return UI.Create("Frame", {
		Name = "Actions",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.new(0, width, 1, -12),
		BackgroundTransparency = 1,
		Parent = card,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		}),
	})
end

export type Slider = { Set: (value: number) -> (), Get: () -> number, Frame: Frame }

-- Schieberegler: Wert wird beim Loslassen geschickt (spart Anfragen). Schiene Bg2 + Rahmen, Füllung Accent,
-- weißer Knopf; die ganze Zeile ist Greif-Fläche (Handy). Globale Eingabe nur WÄHREND des Ziehens verbunden.
function UI.Slider(
	parent: Instance,
	order: number,
	title: string,
	min: number,
	max: number,
	default: number,
	onRelease: (number) -> ()
): Slider
	local row: Frame = UI.Create("Frame", {
		Name = "Slider",
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	UI.Label({
		Size = UDim2.new(0.26, 0, 1, 0),
		Text = title,
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 15,
		Parent = row,
	})
	local track: TextButton = UI.Create("TextButton", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.28, 0, 0.5, 0),
		Size = UDim2.new(0.56, 0, 0, 32),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	})
	local rail: Frame = UI.Create("Frame", {
		Name = "Rail",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = Theme.Bg2,
		BorderSizePixel = 0,
		Parent = track,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.Stroke(nil, 1) })
	local fill: Frame = UI.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = rail,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local knob: Frame = UI.Create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.Stroke(Theme.Accent, 2) })
	local valueLabel = UI.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0.14, 0, 1, 0),
		Text = "",
		Face = "Mono",
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxText = 20,
		Parent = row,
	})
	local lo = math.min(min, max)
	local hi = math.max(min, max)
	local value = math.clamp(math.floor((tonumber(default) or lo) + 0.5), lo, hi)
	local function show()
		local ratio = math.clamp((value - lo) / math.max(1, hi - lo), 0, 1)
		fill.Size = UDim2.fromScale(ratio, 1)
		knob.Position = UDim2.fromScale(ratio, 0.5)
		valueLabel.Text = tostring(value)
	end
	local function setFromX(x: number)
		local width = math.max(1, rail.AbsoluteSize.X)
		local ratio = math.clamp((x - rail.AbsolutePosition.X) / width, 0, 1)
		value = math.floor(lo + ratio * (hi - lo) + 0.5)
		show()
	end
	local dragInput: InputObject? = nil
	local moveConn: RBXScriptConnection? = nil
	local endConn: RBXScriptConnection? = nil
	local function stopDrag()
		dragInput = nil
		if moveConn then
			moveConn:Disconnect()
			moveConn = nil
		end
		if endConn then
			endConn:Disconnect()
			endConn = nil
		end
	end
	track.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if dragInput or (kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch) then
			return
		end
		dragInput = input
		setFromX(input.Position.X)
		moveConn = UserInputService.InputChanged:Connect(function(changed)
			local active = dragInput
			if not active then
				return
			end
			if
				changed == active
				or (
					active.UserInputType == Enum.UserInputType.MouseButton1
					and changed.UserInputType == Enum.UserInputType.MouseMovement
				)
			then
				setFromX(changed.Position.X)
			end
		end)
		endConn = UserInputService.InputEnded:Connect(function(ended)
			if ended ~= dragInput then
				return
			end
			stopDrag()
			task.spawn(onRelease, value)
		end)
	end)
	row.Destroying:Once(stopDrag)
	show()
	return {
		Frame = row,
		Set = function(newValue: number)
			value = math.clamp(math.floor((tonumber(newValue) or value) + 0.5), lo, hi)
			show()
		end,
		Get = function(): number
			return value
		end,
	}
end

export type Cycler = {
	Get: () -> string?,
	Set: (value: string?) -> (),
	OnChange: ((string?) -> ())?,
	Button: Button,
}

-- Knopf, der beim Klicken durch eine Liste schaltet ("Grafik: Hoch")
function UI.Cycler(parent: Instance, title: string, options: { string }, size: UDim2, emptyLabel: string?): Cycler
	local list: { string } = table.clone(options or {})
	if emptyLabel then
		table.insert(list, 1, "")
	end
	local index = 1
	local function label(): string
		local value = list[index]
		if value == nil or value == "" then
			return ("%s: %s"):format(title, emptyLabel or "-")
		end
		return ("%s: %s"):format(title, value)
	end
	local state: Cycler
	local btn = UI.Button({
		Size = size,
		Text = label(),
		Variant = "Secondary",
		MaxText = 15,
		Corner = 10,
		Parent = parent,
	}, function()
		if #list == 0 then
			return
		end
		index = (index % #list) + 1
		state.Button.SetText(label())
		if state.OnChange then
			task.spawn(state.OnChange, state.Get())
		end
	end)
	state = {
		Get = function(): string?
			local value = list[index]
			if value == nil or value == "" then
				return nil
			end
			return value
		end,
		Set = function(value: string?)
			local found = table.find(list, value or "")
			if found then
				index = found
				btn.SetText(label())
			end
		end,
		OnChange = nil,
		Button = btn,
	}
	return state
end

export type NavItem = { Button: TextButton, SetActive: (on: boolean) -> (), SetText: (text: string) -> () }

-- Reiter in der Seitenleiste: transparent, Hover-Fläche; aktiv = Surface2 + Akzent-Strich links + heller Text
function UI.NavItem(parent: Instance, text: string, order: number, onClick: () -> ()): NavItem
	local active = false
	local btn: TextButton = UI.Create("TextButton", {
		Name = "Tab",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.Hover,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = order,
		Parent = parent,
	}, { UI.Corner(10) })
	local bar: Frame = UI.Create("Frame", {
		Name = "Bar",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(3, 18),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = btn,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local label = UI.Label({
		Name = "Label",
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -20, 1, 0),
		Text = text,
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 15,
		Parent = btn,
	})
	local function paint(hover: boolean)
		local goal = if active
			then { BackgroundColor3 = Theme.Surface2, BackgroundTransparency = 0 }
			elseif hover then { BackgroundColor3 = Theme.Hover, BackgroundTransparency = 0.2 }
			else { BackgroundColor3 = Theme.Hover, BackgroundTransparency = 1 }
		TweenService:Create(btn, HOVER_INFO, goal):Play()
		TweenService:Create(bar, HOVER_INFO, { BackgroundTransparency = if active then 0 else 1 }):Play()
		label.TextColor3 = if active then Theme.Text else Theme.Text2
	end
	btn.MouseEnter:Connect(function()
		paint(true)
	end)
	btn.MouseLeave:Connect(function()
		paint(false)
	end)
	btn.Activated:Connect(function()
		playUiSound("UIClick")
		local ok, err = pcall(onClick)
		if not ok then
			warn("[UI] NavItem: " .. tostring(err))
		end
	end)
	return {
		Button = btn,
		SetActive = function(on: boolean)
			active = on == true
			paint(false)
		end,
		SetText = function(newText: string)
			if label.Text ~= newText then
				label.Text = newText
			end
		end,
	}
end

-- ---------------------------------------------------------------------
-- START
-- ---------------------------------------------------------------------
function UI.Frame(dt: number)
	stepCounters(dt)
	stepTickers(dt)
end

-- Prüft, ob BuilderExtended/BuilderMono mit Umlauten + „Λ“ messbar sind; sonst Rückfall-Schriften.
-- Läuft höchstens FACE_CHECK_WAIT Sekunden, bevor der Rest der Oberfläche gebaut wird.
local function checkFaces()
	local results: { [string]: boolean } = {}
	local pending = 0
	for key, face in pairs(UI.Faces) do
		if FACE_FALLBACK[key] then
			pending += 1
			task.spawn(function()
				local ok, bounds = pcall(function()
					local params = Instance.new("GetTextBoundsParams")
					params.Text = FACE_CHECK_TEXT
					params.Font = face
					params.Size = 20
					params.Width = 2000
					return TextService:GetTextBoundsAsync(params)
				end)
				results[key] = ok and typeof(bounds) == "Vector2" and bounds.X > 1
				pending -= 1
			end)
		end
	end
	local deadline = os.clock() + FACE_CHECK_WAIT
	local guard = 0
	while pending > 0 and os.clock() < deadline and guard < 100 do
		guard += 1
		task.wait(0.03)
	end
	for key, okFace in pairs(results) do
		if not okFace then
			UI.Faces[key] = FACE_FALLBACK[key]
			warn("[UI] Schrift " .. key .. " nicht verfügbar – Rückfall wird benutzt")
		end
	end
end

function UI.Init(ctxOrGui: any)
	local screenGui: ScreenGui? = nil
	if typeof(ctxOrGui) == "Instance" and ctxOrGui:IsA("ScreenGui") then
		screenGui = ctxOrGui
	elseif type(ctxOrGui) == "table" then
		ctx = ctxOrGui
		local gui = ctxOrGui.Gui
		if typeof(gui) == "Instance" and gui:IsA("ScreenGui") then
			screenGui = gui
		end
	end
	assert(screenGui, "UI.Init: ScreenGui oder ctx mit Gui erwartet")
	if root == screenGui then
		return -- schon initialisiert
	end
	root = screenGui
	UI.Root = screenGui
	checkFaces()

	-- Alles passend zur Bildschirmgröße skalieren (Handy bis großer Monitor)
	local rootScale: UIScale = UI.Create("UIScale", { Name = "RootScale", Parent = screenGui })
	local cameraConnection: RBXScriptConnection? = nil
	local function updateScale()
		local camera = workspace.CurrentCamera
		if camera then
			local size = camera.ViewportSize
			rootScale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 760), 0.55, 1.15)
		end
	end
	local function bindCamera()
		if cameraConnection then
			cameraConnection:Disconnect()
			cameraConnection = nil
		end
		local camera = workspace.CurrentCamera
		if camera then
			cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		end
		updateScale()
	end
	bindCamera()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)

	-- Meldungen oben in der Mitte
	toastHolder = UI.Create("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, TOAST_TOP),
		Size = UDim2.fromOffset(TOAST_WIDTH, 320),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = screenGui,
	}, {
		UI.Create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})

	-- Modal-Knopf: sichtbar, solange ein Fenster offen ist -> Roblox gibt die Maus frei (Shift-Lock)
	modalButton = UI.Create("TextButton", {
		Name = "WindowModal",
		Size = UDim2.fromOffset(1, 1),
		Position = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		Modal = true,
		Visible = false,
		Parent = screenGui,
	})

	-- Pulte/Kioske in der Welt (Attribut "Window") öffnen dasselbe Fenster wie der HUD-Knopf
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if who ~= Players.LocalPlayer then
			return
		end
		local name = prompt:GetAttribute("Window")
		if type(name) == "string" and name ~= "" then
			Windows.Open(name)
		end
	end)

	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		-- Server-Wert "RandomAllowed" kommt mit dem State -> wartende Rückfragen beantworten
		hooks.On("State", function()
			local known = stateRandom()
			if known ~= nil then
				resolveRandom(known)
			end
		end)
		-- Farbenblind-Modus aus den Einstellungen
		hooks.On("Settings", function(settings)
			if type(settings) == "table" then
				UI.SetColorblind(settings.Colorblind == true)
			end
		end)
	end
end

function UI.Start() end

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="163">
            <Properties>
              <string name="Name">Vehicles</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Fahren: Motoren, Lenkung, Boost, Drift, Tacho (Client/Modules/Vehicles)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §B12.1 (VehicleSeat + HingeConstraint-Motoren, Servo-
--  Lenkung, Federung; Netzwerk-Besitzer = Fahrer; Boost Shift/Touch +25 % für 3 s, 8 s Abklingzeit; Handbremse Leertaste
--  senkt die Hinterrad-Reibung auf 0,3 = Drift; Klassen-Höchsttempo), §C7.2 (Hooks "Vehicle:Enter"/"Vehicle:Exit"),
--  §C7.5 (Vehicles.Current), §A4 (Motor-Ton = Sfx-Loop "Engine", Tonhöhe nach Tempo), §A7 #10 (Fahrt zum Autobahnring).
--
--  Der Server hat das Auto gebaut (VehicleModels.Rig) und gibt dem Fahrer den Netzwerk-Besitz: dieses Modul setzt nur
--  lokale Constraint-Werte (Motor-Drehzahl/-Moment, Servo-Winkel, Anpressdruck, Reibung). Der Server prüft 5×/s das
--  Tempo (1,3 × Klassen-Deckel). Eingaben: VehicleSeat.ThrottleFloat/SteerFloat (Roblox-Steuerung: WASD, Stick, Touch),
--  Aktionen "Boost"/"Handbrake" über Controls (Tasten, Gamepad, Touch-Knöpfe), Aussteigen = Springen bzw. "Interact" (E).
--  Fremde Einsteige-Prompts werden lokal ausgeblendet (nur der Besitzer sieht "Einsteigen").
--
--  Öffentliche API (§C7.5):
--    Vehicles.Current(): Model?             Auto, in dem man gerade fährt
--  Zusätzlich: Vehicles.Waypoint(target?: Vector3) (Navi-Strahl, z. B. zum Autobahnring), Vehicles.BoostState(): (aktiv, Rest)
--    Vehicles.Frame(dt) · Vehicles.Init(ctx) · Vehicles.Start()
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent:WaitForChild("UI"))
local VehicleModels = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("VehicleModels")) :: any
local AssetSlot = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AssetSlot"))

local Vehicles = {}

local player = Players.LocalPlayer
local Theme = UI.Theme

type Drive = {
	Model: Model,
	Key: string,
	Seat: VehicleSeat,
	Chassis: BasePart,
	Motors: { [string]: HingeConstraint },
	Steer: { [string]: HingeConstraint },
	Wheels: { [string]: BasePart },
	Downforce: VectorForce?,
	Cap: number,
	Accel: number,
	Radius: number,
	Mass: number,
	BaseTorque: number,
	FlipTime: number,
	Engine: any?,
	Pitch: number, -- Motor-Rezept: Tonhöhen-Faktor (Config SoundId = eigener Klang -> 1)
	Tails: { BasePart },
	Smoke: { ParticleEmitter },
	Flames: { ParticleEmitter },
	Braking: boolean?,
	TestLeft: number?,
}

local ctx: any = nil
local VC: any = {}
local drive: Drive? = nil
local humanoidConn: RBXScriptConnection? = nil
local boostUntil = 0
local cooldownUntil = 0
local handbrake = false
local rearFriction = 1.5
local baseFov: number? = nil

-- Eigene Motor-Rezepte (§B14.1 Λ-1 „eigenes Motor-Rezept“): gleiche Schleife, eigene Tonhöhe/Klangfarbe.
-- Ein eingetragenes Config.Vehicles.Cars[].SoundId ersetzt die Schleife ganz (ASSET-LISTE 5.1).
local ENGINE_RECIPES: { [string]: { Pitch: number, EqLow: number, EqMid: number, EqHigh: number, Vol: number } } = {
	Lam1 = { Pitch = 1.3, EqLow = 6, EqMid = -2, EqHigh = 5, Vol = 1.25 }, -- hoher Turbinen-Ton mit Bass-Fundament
}

-- Tacho
local hud: Frame? = nil
local speedLabel: TextLabel? = nil
local boostFill: Frame? = nil
local boostLabel: TextLabel? = nil
local hintLabel: TextLabel? = nil

-- Navi
local waypointFolder: Folder? = nil
local waypointTarget: Vector3? = nil
local waypointUntil = 0
local waypointA: Attachment? = nil

local HIDDEN_PROMPTS_MAX = 64
local hiddenPrompts: { [ProximityPrompt]: RBXScriptConnection } = {}
local hiddenCount = 0

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function reducedFx(): boolean
	local ok, settings = call("Settings", "Get")
	return ok and type(settings) == "table" and settings.ReducedFx == true
end

local function physical(density: number, friction: number): PhysicalProperties
	return PhysicalProperties.new(density, friction, 0, (VC.Physics and VC.Physics.FrictionWeight) or 4, 1)
end

-- ---------------------------------------------------------------------
-- 1) TACHO (UI-Kit-Look: dunkles Glas, BuilderMono)
-- ---------------------------------------------------------------------
local function buildHud()
	local gui = ctx.Gui
	local frame: Frame = UI.Create("Frame", {
		Name = "Speedometer",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -150),
		Size = UDim2.fromOffset(220, 74),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
		Visible = false,
		Parent = gui,
	}, { UI.Corner(14), UI.Stroke(nil, 1) })
	speedLabel = UI.Label({
		Name = "Speed",
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.new(0.62, -14, 0, 40),
		Face = "MonoBold",
		Text = "0",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 38,
		Parent = frame,
	})
	UI.Label({
		Name = "Unit",
		Position = UDim2.new(0.62, 0, 0, 16),
		Size = UDim2.new(0.38, -14, 0, 22),
		Text = ctx.T("car.speedUnit"),
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxText = 16,
		Parent = frame,
	})
	local barBack: Frame = UI.Create("Frame", {
		Name = "Boost",
		Position = UDim2.new(0, 14, 1, -24),
		Size = UDim2.new(1, -28, 0, 8),
		BackgroundColor3 = Theme.Bg2,
		BorderSizePixel = 0,
		Parent = frame,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	boostFill = UI.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = barBack,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	boostLabel = UI.Label({
		Name = "BoostText",
		Position = UDim2.new(0, 14, 1, -40),
		Size = UDim2.new(0.5, -14, 0, 14),
		Text = ctx.T("car.boostReady"),
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 12,
		Parent = frame,
	})
	hintLabel = UI.Label({
		Name = "Hint",
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.new(0.5, -14, 0, 14),
		Text = "",
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxText = 12,
		Parent = frame,
	})
	hud = frame
end

local function setHudVisible(on: boolean)
	local frame = hud
	if not frame then
		return
	end
	frame.Visible = on
	if on and hintLabel then
		local okInput, kind = call("Controls", "Input")
		hintLabel.Text = if okInput and kind == "Touch" then ctx.T("car.exitHintTouch") else ctx.T("car.exitHint")
		hintLabel.TextColor3 = Theme.Muted
	end
end

-- ---------------------------------------------------------------------
-- 2) EINSTEIGEN / AUSSTEIGEN
-- ---------------------------------------------------------------------
local function carModelOf(seat: Instance?): Model?
	if not seat or not seat:IsA("VehicleSeat") then
		return nil
	end
	local model = seat.Parent
	if model and model:IsA("Model") and model:GetAttribute("Car") ~= nil then
		return model
	end
	return nil
end

local function collect(model: Model, prefix: string, class: string): { [string]: any }
	local out: { [string]: any } = {}
	for _, inst in ipairs(model:GetDescendants()) do
		if inst:IsA(class) and string.sub(inst.Name, 1, #prefix) == prefix then
			out[string.sub(inst.Name, #prefix + 1)] = inst
		end
	end
	return out
end

-- Lokale Fahr-Effekte (nur beim Fahrer, im Partikel-Budget): Drift-Rauch an den Hinterrädern, Boost-Flammen am Auspuff
local function particleBudget(): number
	local ok, value = call("Quality", "Budget", "Particles")
	return if ok and type(value) == "number" then math.clamp(value, 0, 1) else 0.6
end

local function addEmitter(parent: BasePart, offset: Vector3, kind: string): ParticleEmitter
	local attachment = Instance.new("Attachment")
	attachment.Name = "AT_Fx" .. kind
	attachment.Position = offset
	attachment.Parent = parent
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "AT_" .. kind
	emitter.Enabled = false
	emitter.LockedToPart = false
	if kind == "Smoke" then
		emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(200, 206, 216))
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 5) })
		emitter.Lifetime = NumberRange.new(0.7, 1.2)
		emitter.Speed = NumberRange.new(2, 5)
		emitter.SpreadAngle = Vector2.new(40, 40)
		emitter.Rate = 0
		emitter.EmissionDirection = Enum.NormalId.Top
	else
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Color = ColorSequence.new(Theme.Accent, Theme.Cosmic3)
		emitter.LightEmission = 1
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.1) })
		emitter.Lifetime = NumberRange.new(0.15, 0.3)
		emitter.Speed = NumberRange.new(14, 22)
		emitter.SpreadAngle = Vector2.new(8, 8)
		emitter.Rate = 0
		emitter.EmissionDirection = Enum.NormalId.Back
	end
	emitter.Parent = attachment
	return emitter
end

local function buildDriveFx(d: Drive)
	for key, wheel in pairs(d.Wheels) do
		if string.sub(key, 1, 1) == "R" then
			table.insert(d.Smoke, addEmitter(wheel, Vector3.new(0, -d.Radius * 0.8, 0), "Smoke"))
		end
	end
	for _, name in ipairs({ "ExhaustL", "ExhaustR" }) do
		local pipe = d.Model:FindFirstChild(name)
		if pipe and pipe:IsA("BasePart") then
			table.insert(d.Flames, addEmitter(pipe, Vector3.zero, "Flame"))
		end
	end
	for _, inst in ipairs(d.Model:GetDescendants()) do
		if inst:IsA("BasePart") and inst:GetAttribute("Light") == "Tail" then
			table.insert(d.Tails, inst)
		end
	end
end

local function clearDriveFx(d: Drive)
	for _, list in ipairs({ d.Smoke, d.Flames }) do
		for _, emitter in ipairs(list) do
			local holder = emitter.Parent
			if holder then
				holder:Destroy()
			end
		end
		table.clear(list)
	end
	for _, tail in ipairs(d.Tails) do
		if tail.Parent then
			tail.Color = Color3.fromRGB(239, 48, 56)
		end
	end
end

-- Bremslicht hell, Drift-Rauch, Boost-Flammen (jeden Frame; nur Werte ändern, wenn sie sich ändern)
local function stepDriveFx(d: Drive, speed: number, braking: boolean, boosting: boolean)
	if braking ~= d.Braking then
		d.Braking = braking
		local color = if braking then Color3.fromRGB(255, 72, 80) else Color3.fromRGB(176, 28, 36)
		for _, tail in ipairs(d.Tails) do
			if tail.Parent then
				tail.Color = color
			end
		end
	end
	local fx = particleBudget()
	local reduced = reducedFx()
	local smokeRate = if handbrake and speed > 14 and not reduced then 60 * fx else 0
	for _, emitter in ipairs(d.Smoke) do
		if emitter.Rate ~= smokeRate then
			emitter.Rate = smokeRate
			emitter.Enabled = smokeRate > 0
		end
	end
	local flameRate = if boosting and not reduced then 90 * fx else 0
	for _, emitter in ipairs(d.Flames) do
		if emitter.Rate ~= flameRate then
			emitter.Rate = flameRate
			emitter.Enabled = flameRate > 0
		end
	end
end

local function stopDrive()
	local d = drive
	if not d then
		return
	end
	clearDriveFx(d)
	-- Handbremse beim Aussteigen gehalten: Hinterrad-Reibung zurücksetzen (sonst driftet das Auto beim
	-- nächsten Einsteigen dauerhaft – die "End"-Eingabe kommt erst, wenn drive schon nil ist)
	if handbrake then
		for key, wheel in pairs(d.Wheels) do
			if string.sub(key, 1, 1) == "R" and wheel.Parent then
				wheel.CustomPhysicalProperties = physical((VC.Physics and VC.Physics.WheelDensity) or 0.9, rearFriction)
			end
		end
	end
	drive = nil
	handbrake = false
	if d.Engine then
		pcall(d.Engine.Stop)
	end
	-- Motoren entspannen (Besitz geht an den Server)
	for _, motor in pairs(d.Motors) do
		motor.AngularVelocity = 0
	end
	if d.Downforce then
		d.Downforce.Force = Vector3.zero
	end
	setHudVisible(false)
	local camera = workspace.CurrentCamera
	if camera and baseFov then
		camera.FieldOfView = baseFov
	end
	ctx.Hooks.Fire("Vehicle:Exit", d.Model)
end

local function startDrive(model: Model, seat: VehicleSeat)
	stopDrive()
	local key = model:GetAttribute("Car")
	local chassis = model:FindFirstChild("Chassis")
	if type(key) ~= "string" or not chassis or not chassis:IsA("BasePart") then
		return
	end
	local car = VC.Car and VC.Car(key) or nil
	local classInfo = car and VC.ClassInfo and VC.ClassInfo[car.Class] or nil
	local downforce = chassis:FindFirstChild("Downforce")
	local cap = model:GetAttribute("Cap")
	local mass = model:GetAttribute("Mass")
	local torque = model:GetAttribute("BaseTorque")
	local radius = model:GetAttribute("WheelR")
	drive = {
		Model = model,
		Key = key,
		Seat = seat,
		Chassis = chassis,
		Motors = collect(model, "Motor_", "HingeConstraint"),
		Steer = collect(model, "Steer_", "HingeConstraint"),
		Wheels = collect(model, "Wheel_", "BasePart"),
		Downforce = if downforce and downforce:IsA("VectorForce") then downforce else nil,
		Cap = if type(cap) == "number" then cap else 60,
		Accel = if classInfo then classInfo.Accel else 30,
		Radius = if type(radius) == "number" then radius else 1.3,
		Mass = if type(mass) == "number" then mass else chassis.AssemblyMass,
		BaseTorque = if type(torque) == "number" then torque else 20000,
		FlipTime = 0,
		Engine = nil,
		Pitch = 1,
		Tails = {},
		Smoke = {},
		Flames = {},
		Braking = nil,
		TestLeft = nil,
	}
	buildDriveFx(drive :: Drive)
	local ok, handle = call("Sfx", "Loop", "Engine", chassis)
	if ok and handle then
		local d = drive :: Drive
		d.Engine = handle
		local sound = if type(handle) == "table" then handle.Sound else nil
		local custom = car and AssetSlot.SoundId(car.SoundId) or nil
		local recipe = car and ENGINE_RECIPES[car.Recipe or key] or nil
		if typeof(sound) == "Instance" and sound:IsA("Sound") then
			if custom then
				-- eigener Motor-Klang aus der Config (nahtlose Schleife) in Originaltonhöhe: SetSpeed rechnet mit der
				-- Grundtonhöhe der Rezept-Schleife – die hier herausrechnen
				d.Pitch = 1 / math.max(0.1, sound.PlaybackSpeed)
				sound.SoundId = custom
				sound:Play() -- neue Quelle sicher starten (die Schleife lief schon mit dem Rezept-Klang)
				local eq = sound:FindFirstChildOfClass("EqualizerSoundEffect")
				if eq then
					eq:Destroy() -- eigener Klang bleibt unverfärbt
				end
			elseif recipe then
				d.Pitch = recipe.Pitch
				local eq = sound:FindFirstChildOfClass("EqualizerSoundEffect") or Instance.new("EqualizerSoundEffect")
				eq.LowGain = recipe.EqLow
				eq.MidGain = recipe.EqMid
				eq.HighGain = recipe.EqHigh
				eq.Parent = sound
				pcall(handle.SetVolume, recipe.Vol)
			end
		end
	end
	local camera = workspace.CurrentCamera
	if camera then
		baseFov = camera.FieldOfView
	end
	setHudVisible(true)
	ctx.Hooks.Fire("Vehicle:Enter", model)
end

local function onSeatChanged(humanoid: Humanoid)
	local seat = humanoid.SeatPart
	local model = carModelOf(seat)
	if model and model:GetAttribute("Owner") == player.UserId and seat and seat:IsA("VehicleSeat") then
		startDrive(model, seat)
	else
		stopDrive()
	end
end

local function onCharacter(character: Model)
	if humanoidConn then
		humanoidConn:Disconnect()
		humanoidConn = nil
	end
	stopDrive()
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	humanoidConn = humanoid:GetPropertyChangedSignal("SeatPart"):Connect(function()
		onSeatChanged(humanoid)
	end)
	onSeatChanged(humanoid)
end

local function exitCar()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and drive then
		humanoid.Sit = false
		humanoid.Jump = true
	end
end

-- fremde "Einsteigen"-Prompts lokal ausblenden
local function considerPrompt(inst: Instance)
	if not inst:IsA("ProximityPrompt") or inst:GetAttribute("Action") ~= "CarEnter" then
		return
	end
	if inst:GetAttribute("Owner") == player.UserId or hiddenPrompts[inst] or hiddenCount >= HIDDEN_PROMPTS_MAX then
		return
	end
	inst.Enabled = false
	hiddenCount += 1
	hiddenPrompts[inst] = inst:GetPropertyChangedSignal("Enabled"):Connect(function()
		if inst.Enabled then
			inst.Enabled = false -- Server schaltet beim Aussteigen wieder an -> lokal aus lassen
		end
	end)
end

local function forgetPrompt(inst: Instance)
	local conn = if inst:IsA("ProximityPrompt") then hiddenPrompts[inst] else nil
	if conn then
		conn:Disconnect()
		hiddenPrompts[inst :: ProximityPrompt] = nil
		hiddenCount -= 1
	end
end

-- ---------------------------------------------------------------------
-- 3) FAHREN (jeder Frame, nur mit Netzwerk-Besitz wirksam)
-- ---------------------------------------------------------------------
local function setRearFriction(friction: number)
	local d = drive
	if not d then
		return
	end
	for key, wheel in pairs(d.Wheels) do
		if string.sub(key, 1, 1) == "R" and wheel.Parent then
			local density = (VC.Physics and VC.Physics.WheelDensity) or 0.9
			wheel.CustomPhysicalProperties = physical(density, friction)
		end
	end
end

local function flipIfNeeded(d: Drive, dt: number)
	local up = d.Chassis.CFrame.UpVector
	if up.Y < 0.25 then
		d.FlipTime += dt
	else
		d.FlipTime = 0
	end
	local limit = (VC.Physics and VC.Physics.FlipSeconds) or 2
	if d.FlipTime >= limit then
		d.FlipTime = 0
		local pos = d.Chassis.Position
		local look = d.Chassis.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.1 then
			flat = Vector3.new(0, 0, -1)
		end
		local target = CFrame.lookAt(pos + Vector3.new(0, 4, 0), pos + Vector3.new(0, 4, 0) + flat)
		local okPivot = pcall(function()
			d.Model:PivotTo(target * d.Chassis.CFrame:ToObjectSpace(d.Model:GetPivot()))
			d.Chassis.AssemblyLinearVelocity = Vector3.zero
			d.Chassis.AssemblyAngularVelocity = Vector3.zero
		end)
		if okPivot then
			ctx.Toast(ctx.T("car.flipped"), "Info")
		end
	end
end

local function updateDrive(d: Drive, dt: number)
	if not d.Model.Parent or not d.Chassis.Parent then
		stopDrive()
		return
	end
	local physics = VC.Physics or {}
	local boostCfg = VC.Boost or { Mult = 1.25, Seconds = 3, Cooldown = 8 }
	local t = os.clock()
	local boosting = t < boostUntil
	local throttle = d.Seat.ThrottleFloat
	local steer = d.Seat.SteerFloat
	local velocity = d.Chassis.AssemblyLinearVelocity
	local forward = velocity:Dot(d.Chassis.CFrame.LookVector)
	local speed = math.abs(forward)
	local mult = if boosting then boostCfg.Mult else 1
	local cap = d.Cap * mult
	local sign = VehicleModels.WHEEL_SIGN
	local r = math.max(0.5, d.Radius)
	local target = 0
	local torque = d.BaseTorque * (physics.CoastTorque or 0.08)
	local accel = d.Accel * mult / r
	if throttle > 0.05 then
		if forward < -2 then
			target, torque, accel = 0, d.BaseTorque * (physics.BrakeFactor or 2.2), 400 -- Bremsen aus dem Rückwärtsgang
		else
			target = cap * throttle
			torque = d.BaseTorque * mult
		end
	elseif throttle < -0.05 then
		if forward > 2 then
			target, torque, accel = 0, d.BaseTorque * (physics.BrakeFactor or 2.2), 400 -- Bremsen
		else
			target = -d.Cap * (physics.ReverseFactor or 0.35) * -throttle
			torque = d.BaseTorque
		end
	else
		target = forward -- rollen lassen
	end
	for key, motor in pairs(d.Motors) do
		local rear = string.sub(key, 1, 1) == "R"
		if handbrake and rear then
			motor.AngularVelocity = 0
			motor.MotorMaxTorque = d.BaseTorque * (physics.BrakeFactor or 2.2)
			motor.MotorMaxAcceleration = 400
		else
			motor.AngularVelocity = sign * target / r
			motor.MotorMaxTorque = torque
			motor.MotorMaxAcceleration = accel
		end
	end
	-- Lenkung: weniger Einschlag bei hohem Tempo; positiver Winkel lenkt nach links
	local maxSteer = (physics.SteerMax or 34)
		+ ((physics.SteerMin or 9) - (physics.SteerMax or 34)) * math.clamp(speed / d.Cap, 0, 1)
	for _, servo in pairs(d.Steer) do
		servo.TargetAngle = -steer * maxSteer
	end
	-- Anpressdruck
	if d.Downforce then
		local factor = math.clamp(speed / d.Cap, 0, 1.3)
		d.Downforce.Force =
			Vector3.new(0, -(physics.Downforce or 0.6) * d.Mass * workspace.Gravity * factor * factor, 0)
	end
	flipIfNeeded(d, dt)
	local braking = handbrake or (throttle < -0.05 and forward > 2) or (throttle > 0.05 and forward < -2)
	stepDriveFx(d, speed, braking, boosting)
	-- Ton, Kamera, Tacho
	if d.Engine then
		pcall(d.Engine.SetSpeed, d.Pitch * (0.7 + 0.9 * math.clamp(speed / d.Cap, 0, 1.3)))
	end
	local camera = workspace.CurrentCamera
	if camera and baseFov and not reducedFx() then
		local goal = baseFov + 8 * math.clamp(speed / d.Cap, 0, 1) + (if boosting then 4 else 0)
		camera.FieldOfView += (goal - camera.FieldOfView) * math.clamp(dt * 4, 0, 1)
	end
	if speedLabel then
		-- km/h ≈ Studs/s (1 Stud ≈ 0,28 m)
		speedLabel.Text = tostring(math.floor(speed + 0.5))
	end
	-- Probefahrt: Restzeit statt Aussteige-Hinweis
	local testUntil = d.Model:GetAttribute("TestUntil")
	if hintLabel and type(testUntil) == "number" then
		local left = math.max(0, math.ceil(testUntil - workspace:GetServerTimeNow()))
		if left ~= d.TestLeft then
			d.TestLeft = left
			hintLabel.Text = ctx.T("car.testLeft", ("%d:%02d"):format(left // 60, left % 60))
			hintLabel.TextColor3 = if left <= 10 then Theme.Warn else Theme.Cosmic3
		end
	elseif d.TestLeft ~= nil then
		d.TestLeft = nil
		setHudVisible(true) -- gekauft während der Probefahrt: normaler Hinweis zurück
		if hintLabel then
			hintLabel.TextColor3 = Theme.Muted
		end
	end
	if boostFill and boostLabel then
		local ready = t >= cooldownUntil
		local ratio = if boosting
			then (boostUntil - t) / boostCfg.Seconds
			elseif ready then 1
			else 1 - (cooldownUntil - t) / math.max(0.1, boostCfg.Cooldown - boostCfg.Seconds)
		boostFill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
		boostFill.BackgroundColor3 = if boosting then Theme.Cosmic2 elseif ready then Theme.Accent else Theme.Muted
		boostLabel.Text = if ready then ctx.T("car.boostReady") else ctx.T("car.boost")
	end
end

-- ---------------------------------------------------------------------
-- 4) NAVI-STRAHL (z. B. nach der Enthüllung zum Autobahnring)
-- ---------------------------------------------------------------------
local function clearWaypoint()
	waypointTarget = nil
	if waypointFolder then
		waypointFolder:Destroy()
	end
	waypointFolder = nil
	waypointA = nil
end

function Vehicles.Waypoint(target: Vector3?)
	clearWaypoint()
	if typeof(target) ~= "Vector3" then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "AT_Waypoint"
	local pillar = Instance.new("Part")
	pillar.Name = "Pillar"
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.CastShadow = false
	pillar.Material = Enum.Material.Neon
	pillar.Color = Theme.Accent
	pillar.Transparency = 0.35
	pillar.Size = Vector3.new(2, 80, 2)
	pillar.CFrame = CFrame.new(target + Vector3.new(0, 40, 0))
	pillar.Parent = folder
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -38, 0)
	a1.Parent = pillar
	local holder = Instance.new("Part")
	holder.Name = "From"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.5, 0.5, 0.5)
	holder.Parent = folder
	local a0 = Instance.new("Attachment")
	a0.Parent = holder
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = 1.4
	beam.Width1 = 1.4
	beam.Texture = "rbxasset://textures/gradient.png"
	beam.TextureSpeed = 2
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Color = ColorSequence.new(Theme.Accent, Theme.Cosmic2)
	beam.Parent = holder
	folder.Parent = workspace
	waypointFolder = folder
	waypointTarget = target
	waypointUntil = os.clock() + 90
	waypointA = a0
end

local function updateWaypoint()
	local target = waypointTarget
	if not target then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") or os.clock() > waypointUntil then
		if os.clock() > waypointUntil then
			clearWaypoint()
		end
		return
	end
	local holder = waypointA and waypointA.Parent
	if holder and holder:IsA("BasePart") then
		holder.CFrame = CFrame.new(root.Position + Vector3.new(0, 2, 0))
	end
	if (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(target.X, 0, target.Z)).Magnitude < 40 then
		clearWaypoint()
	end
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function Vehicles.Current(): Model?
	local d = drive
	return if d then d.Model else nil
end

function Vehicles.BoostState(): (boolean, number)
	local t = os.clock()
	return t < boostUntil, math.max(0, cooldownUntil - t)
end

function Vehicles.Frame(dt: number)
	local d = drive
	if d then
		local ok, err = pcall(updateDrive, d, dt)
		if not ok then
			warn("[Vehicles] " .. tostring(err))
		end
	end
	updateWaypoint()
end

function Vehicles.Init(context: any)
	ctx = context
	VC = ctx.Config.Vehicles or {}
	local physics = VC.Physics or {}
	rearFriction = physics.RearFriction or 1.5
	buildHud()
	local controls = ctx.Modules.Controls
	if controls and type(controls.Bind) == "function" then
		controls.Bind("Boost", function(state: string)
			if state ~= "Begin" or not drive then
				return
			end
			local t = os.clock()
			if t < cooldownUntil then
				return
			end
			local boost = VC.Boost or { Seconds = 3, Cooldown = 8 }
			boostUntil = t + boost.Seconds
			cooldownUntil = t + boost.Cooldown
			call("Sfx", "Play", "Whoosh")
		end)
		controls.Bind("Handbrake", function(state: string)
			if not drive then
				handbrake = false
				return
			end
			if state == "Begin" then
				handbrake = true
				setRearFriction((VC.DriftFriction or 0.3))
			elseif state == "End" then
				handbrake = false
				setRearFriction(rearFriction)
			end
		end)
		controls.Bind("Interact", function(state: string)
			if state == "Begin" and drive then
				exitCar()
			end
		end)
	end
	ctx.Hooks.On("Settings", function()
		setHudVisible(drive ~= nil)
	end)
end

function Vehicles.Start()
	player.CharacterAdded:Connect(function(character: Model)
		task.spawn(onCharacter, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	workspace.DescendantAdded:Connect(considerPrompt)
	workspace.DescendantRemoving:Connect(forgetPrompt)
	task.spawn(function()
		local carFolder = workspace:FindFirstChild("AkytexCars")
		if carFolder then
			for _, inst in ipairs(carFolder:GetDescendants()) do
				considerPrompt(inst)
			end
		end
	end)
end

return Vehicles
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="164">
            <Properties>
              <string name="Name">WelcomeBack</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Willkommen-zurück-Bericht + „Zukunfts-Ich“ (Client/Modules/WelcomeBack)
--  Besitzer: WP8 (Turm-Optik, Interiors, Lifestyle). Vertrag: DESIGN.md §B1 (Rückkehrer: Glas-Sheet, 2 s Vorher/
--  Nachher-Kamera auf den eigenen Tower über zwei ViewportFrames; Tower offline +X CR, Dividenden +Y AKY, ausgeführte
--  Orders, Bots, fertige Bauten, Auto-Transfers; großer Knopf EINSAMMELN mit rollendem Zähler; vor dem Gehen das
--  „Zukunfts-Ich“-Panel: „In 8 h verdient dein Tower ≈ … · deine Orders schützen dich · Etage 21 fertig in 41 min“),
--  §B4.6 (Offline-Ertrag, Auszahlung über die Willkommen-Karte – der Server bucht schon beim Beitritt), §C7.3
--  (Fenster "WelcomeBack"), Muss-Regel 17 (kein Angebot während des Berichts – das Fenster ist dabei offen).
--
--  Quellen: State.Tower.Offline (TowerService: Seconds, Away, Rate, Cap, Amount, Built?, Transfer?) und
--  State.Life.Welcome (LifestyleService aus OrderService.CatchUpReport: Fills, Dividends, Alerts, Bots).
--  Ehrlich: Die CR sind beim Öffnen bereits gutgeschrieben – EINSAMMELN zeigt nur den Zähler-Effekt.
--  „Zukunfts-Ich“: Karte unten beim Öffnen des Roblox-Menüs (GuiService.MenuOpened = man geht gleich) und per Knopf.
--
--  Öffentliche API (§C7.5):
--    WelcomeBack.Show(report)        report = { Offline?, Catchup? } (fehlende Teile aus dem State)
--  Ergänzungen: WelcomeBack.ShowFuture() · WelcomeBack.Tick() (von TowerView 1×/s) · Init(ctx) · Start()
-- =====================================================================

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local TowerModels = require(Shared:WaitForChild("TowerModels"))
local TowerMath = require(Shared:WaitForChild("TowerMath"))

local WelcomeBack = {}

local Theme = UI.Theme

local WINDOW_W, WINDOW_H = 700, 620
local SHOW_DELAY = 3 -- Sekunden nach dem ersten State (HUD/Splash zuerst)
local WAIT_MAX = 90 -- so lange wird auf ein freies Fenster/Tutorial-Ende gewartet
local FUTURE_HOURS = 8
local FUTURE_GAP = 300 -- Zukunfts-Ich höchstens alle 5 min automatisch
local FUTURE_STAY = 9
local CAMERA_INFO = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
local PROTECTIVE: { [string]: boolean } = { STP = true, TP = true, OCO = true, TRL = true }

local ctx: any = nil
local window: any = nil
local shown = false
local pendingSince: number? = nil
local report: { [string]: any } = {}
local collectAmount = 0
local future: Frame? = nil
local futureLabel: TextLabel? = nil
local futureToken = 0
local futureAt = -math.huge
local builtLang = ""
local filledSig = "" -- Inhalt des zuletzt gebauten Berichts (nur bei echter Änderung neu bauen)

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

local function credits(n: number): string
	local ok, text = pcall(ctx.Format.Credits, n, lang())
	return if ok then text else tostring(math.floor(n))
end

local function aky(cents: number): string
	local ok, text = pcall(ctx.Format.Aky, cents, lang(), true)
	return if ok then text else tostring(math.floor(cents / 100))
end

local function duration(seconds: number): string
	local ok, text = pcall(ctx.Format.Duration, math.max(0, seconds), lang())
	return if ok then text else tostring(math.floor(seconds))
end

local function pct(fraction: number): string
	local ok, text = pcall(ctx.Format.Pct, fraction, lang(), 1, true)
	return if ok then text else string.format("%+.1f %%", fraction * 100)
end

local function tower(): { [string]: any }
	local t = ctx.State.Tower
	return if type(t) == "table" then t else {}
end

local function botName(preset: string): string
	local trading = ctx.Config.Trading
	local bots = if type(trading) == "table" then trading.Bots else nil
	local entry = if type(bots) == "table" then bots[preset] else nil
	if type(entry) == "table" and type(entry.Name) == "table" then
		return ctx.Lang.Pick(lang(), entry.Name)
	end
	return preset
end

local function reportOf(): ({ [string]: any }, { [string]: any })
	local offline = report.Offline
	if type(offline) ~= "table" then
		local t = tower()
		offline = if type(t.Offline) == "table" then t.Offline else {}
	end
	local catchup = report.Catchup
	if type(catchup) ~= "table" then
		local life = ctx.State.Life
		catchup = if type(life) == "table" and type(life.Welcome) == "table" then life.Welcome else {}
	end
	return offline :: { [string]: any }, catchup :: { [string]: any }
end

local function hasNews(): boolean
	local offline, catchup = reportOf()
	return num(offline.Amount, 0) > 0
		or num(offline.Built, 0) > 0
		or num(offline.Transfer, 0) > 0
		or num(catchup.Fills, 0) > 0
		or num(catchup.Dividends, 0) > 0
		or (type(catchup.Bots) == "table" and #catchup.Bots > 0)
end

-- Bericht-Inhalt als Text: der Tower-State ändert sich laufend (Tresor), der Bericht nur selten
local function reportSig(): string
	local offline, catchup = reportOf()
	local bots = if type(catchup.Bots) == "table" then #catchup.Bots else 0
	return table.concat({
		tostring(num(offline.Amount, 0)),
		tostring(num(offline.Built, 0)),
		tostring(num(offline.Transfer, 0)),
		tostring(num(catchup.Fills, 0)),
		tostring(num(catchup.Dividends, 0)),
		tostring(num(catchup.Alerts, 0)),
		tostring(bots),
		tostring(math.floor(num(tower().Floors, 0))),
		lang(),
	}, "|")
end

-- ---------------------------------------------------------------------
-- VORHER/NACHHER (zwei ViewportFrames mit vereinfachtem Tower, Kamera fährt 2 s)
-- ---------------------------------------------------------------------
local function viewport(parent: Instance, order: number, caption: string, floors: number, highlight: number?): Frame
	local t = tower()
	local stage = TowerModels.StageOf(floors)
	local holder = UI.Card({ Size = UDim2.fromOffset(318, 230), LayoutOrder = order, Parent = parent })
	UI.Label({
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 22),
		Text = caption,
		Face = "Display",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 15,
		Parent = holder,
	})
	local vp: ViewportFrame = UI.Create("ViewportFrame", {
		Position = UDim2.fromOffset(8, 32),
		Size = UDim2.new(1, -16, 1, -40),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0,
		Ambient = Color3.fromRGB(150, 165, 190),
		LightColor = Color3.fromRGB(255, 244, 220),
		LightDirection = Vector3.new(-0.5, -1, -0.4),
		Parent = holder,
	}, { UI.Corner(10) })
	local world = Instance.new("WorldModel")
	world.Parent = vp
	local specs = TowerModels.Preview(
		stage,
		floors,
		tostring(t.Skin or "GlassBlue"),
		tostring(t.Neon or "Accent"),
		tostring(t.Crown or "")
	)
	for _, spec in ipairs(specs) do
		local part = TowerModels.Instantiate(spec, CFrame.identity, world)
		if highlight and spec.Attr and spec.Attr.Floor == highlight then
			part.Color = Color3.new(1, 1, 1)
		end
	end
	local height = math.max(24, floors * TowerModels.FloorHeight() + 30)
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	local distance = height * 1.25 + 40
	local target = Vector3.new(0, height * 0.45, 0)
	camera.CFrame = CFrame.lookAt(Vector3.new(distance * 0.7, height * 0.55, -distance * 0.7), target)
	camera.Parent = vp
	vp.CurrentCamera = camera
	local endCF = CFrame.lookAt(Vector3.new(distance * 0.9, height * 0.6, -distance * 0.35), target)
	TweenService:Create(camera, CAMERA_INFO, { CFrame = endCF }):Play()
	return holder
end

-- ---------------------------------------------------------------------
-- ZUKUNFTS-ICH (Karte unten, nicht modal)
-- ---------------------------------------------------------------------
local function futureText(): string
	local t = tower()
	local inc = ctx.State.Income
	local steady = if type(inc) == "table" then num(inc.Steady, 0) else 0
	local towerCfg = ctx.Config.Tower
	local offlineCfg = if type(towerCfg) == "table" and type(towerCfg.Offline) == "table" then towerCfg.Offline else {}
	local last = if type(t.Offline) == "table" then t.Offline else {}
	local rate = num(last.Rate, num(offlineCfg.Rate, 0.5))
	local cap = num(last.Cap, num(offlineCfg.CapHours, 8) * 3600)
	local seconds = math.min(FUTURE_HOURS * 3600, cap)
	local amount = TowerMath.Offline(steady, seconds, rate, cap)
	local parts: { string } = { T("tui.future.income", math.floor(seconds / 3600 + 0.5), credits(amount)) }
	local depot = ctx.State.Depot
	local protective = 0
	if type(depot) == "table" and type(depot.Orders) == "table" then
		for _, order in ipairs(depot.Orders) do
			if type(order) == "table" and PROTECTIVE[order.Type] then
				protective += 1
			end
		end
	end
	table.insert(parts, if protective > 0 then T("tui.future.orders", protective) else T("tui.future.noOrders"))
	local build = t.Build
	if type(build) == "table" and build.Floor ~= nil then
		local remaining = math.max(0, num(build.Until, 0) - workspace:GetServerTimeNow())
		table.insert(parts, T("tui.future.build", build.Floor, duration(remaining)))
	end
	return table.concat(parts, "  ·  ")
end

local function buildFuture()
	local frame: Frame = UI.Panel({
		Name = "FutureSelf",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 40),
		Size = UDim2.fromOffset(640, 92),
		Visible = false,
		ZIndex = 45,
		Parent = ctx.Gui,
	})
	UI.Create("UIStroke", { Color = Theme.Purple, Thickness = 1, Transparency = 0.3, Parent = frame })
	UI.Label({
		Name = "Title",
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -70, 0, 24),
		Text = UI.Upper(T("tui.future.title")),
		Face = "Display",
		TextColor3 = Theme.Purple,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 16,
		ZIndex = 46,
		Parent = frame,
	})
	futureLabel = UI.Label({
		Position = UDim2.fromOffset(16, 36),
		Size = UDim2.new(1, -32, 0, 46),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		TextColor3 = Theme.Text,
		MaxText = 16,
		ZIndex = 46,
		Parent = frame,
	})
	UI.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 6),
		Size = UDim2.fromOffset(32, 32),
		Text = "✕",
		Variant = "Ghost",
		ZIndex = 46,
		Parent = frame,
	}, function()
		futureToken += 1
		frame.Visible = false
	end)
	future = frame
end

function WelcomeBack.ShowFuture()
	if not future then
		buildFuture()
	end
	local frame = future
	local label = futureLabel
	if not frame or not label then
		return
	end
	local title = frame:FindFirstChild("Title") :: TextLabel?
	if title then
		title.Text = UI.Upper(T("tui.future.title"))
	end
	label.Text = futureText()
	futureAt = os.clock()
	futureToken += 1
	local token = futureToken
	frame.Visible = true
	frame.Position = UDim2.new(0.5, 0, 1, 40)
	TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 1, -110),
	}):Play()
	task.delay(FUTURE_STAY, function()
		if futureToken == token and frame.Parent then
			local out =
				TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
					Position = UDim2.new(0.5, 0, 1, 40),
				})
			out.Completed:Once(function()
				if futureToken == token then
					frame.Visible = false
				end
			end)
			out:Play()
		end
	end)
end

-- ---------------------------------------------------------------------
-- FENSTER
-- ---------------------------------------------------------------------
local function line(parent: Instance, order: number, icon: string, value: string, color: Color3?)
	local row = UI.RowCard(parent, order, 40)
	UI.Label({
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Text = icon .. "  " .. value,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color or Theme.Text,
		MaxText = 16,
		Parent = row,
	})
end

local function fillWindow()
	if not window then
		return
	end
	local content = window.Content
	for _, child in ipairs(content:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	filledSig = reportSig()
	local offline, catchup = reportOf()
	local t = tower()
	local floors = math.floor(num(t.Floors, 0))
	local built = math.floor(num(offline.Built, 0))
	UI.Label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = T("tui.welcome.away", duration(num(offline.Away, num(offline.Seconds, 0)))),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Text2,
		MaxText = 16,
		LayoutOrder = 1,
		Parent = content,
	})
	-- Vorher / Nachher
	local views = UI.Row(content, 2, 232)
	local before = math.max(0, floors - (if built > 0 then 1 else 0))
	viewport(views, 1, T("tui.welcome.before"), before, nil)
	viewport(views, 2, T("tui.welcome.after"), floors, if built > 0 then built else nil)
	-- Zeilen
	local order = 3
	local amount = num(offline.Amount, 0)
	if amount > 0 then
		line(
			content,
			order,
			"🏙️",
			T(
				"tui.welcome.offline",
				credits(amount),
				math.floor(num(offline.Rate, 0.5) * 100 + 0.5),
				duration(num(offline.Seconds, 0))
			),
			UI.UpColor()
		)
		order += 1
	end
	if num(catchup.Dividends, 0) > 0 then
		line(content, order, "💠", T("tui.welcome.dividends", aky(num(catchup.Dividends, 0))), Theme.Accent)
		order += 1
	end
	if num(catchup.Fills, 0) > 0 then
		line(content, order, "📈", T("tui.welcome.fills", math.floor(num(catchup.Fills, 0))))
		order += 1
	end
	if num(catchup.Alerts, 0) > 0 then
		line(content, order, "🔔", T("tui.welcome.alerts", math.floor(num(catchup.Alerts, 0))))
		order += 1
	end
	if type(catchup.Bots) == "table" then
		for i, bot in ipairs(catchup.Bots) do
			if i > 4 then
				break
			end
			if type(bot) == "table" then
				local value = num(bot.Pct, 0)
				line(
					content,
					order,
					"🤖",
					T("tui.welcome.bot", botName(tostring(bot.Preset)), pct(value)),
					UI.TrendColor(value)
				)
				order += 1
			end
		end
	end
	if built > 0 then
		line(content, order, "🏗️", T("tui.welcome.built", built), Theme.Gold)
		order += 1
	end
	local transfer = num(offline.Transfer, 0)
	if transfer > 0 then
		line(content, order, "🔁", T("tui.welcome.transfer", credits(transfer)), UI.UpColor())
		order += 1
	end
	if order == 3 then
		line(content, order, "✨", T("tui.welcome.quiet"))
		order += 1
	end
	collectAmount = amount + transfer
	-- EINSAMMELN mit rollendem Zähler (bereits gutgeschrieben – ehrlich beschriftet)
	local collectRow = UI.Row(content, 50, 56)
	local total: TextLabel = UI.Label({
		Name = "Total",
		Size = UDim2.fromOffset(230, 52),
		Text = "",
		Face = "Mono",
		TextColor3 = UI.UpColor(),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 28,
		LayoutOrder = 1,
		Parent = collectRow,
	})
	UI.Create("UIScale", { Parent = total })
	local counter = UI.Counter(total, function(value: number): string
		return "+" .. credits(math.floor(value + 0.5))
	end)
	UI.SetCounter(counter, collectAmount) -- rollt von 0 hoch (UI.Frame bewegt den Zähler)
	UI.Button({
		Size = UDim2.fromOffset(260, 52),
		Text = UI.Upper(T("tui.welcome.collect")),
		Variant = "Success",
		MaxText = 20,
		LayoutOrder = 2,
		Parent = collectRow,
	}, function()
		if collectAmount > 0 then
			call("Effects", "Play", "CoinFly", collectAmount)
			call("Hud", "PulseCredits", collectAmount)
		end
		if ctx.Windows then
			ctx.Windows.Close("WelcomeBack")
		end
	end)
	UI.Label({
		Size = UDim2.new(1, 0, 0, 20),
		Text = T("tui.welcome.credited"),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Muted,
		MaxText = 13,
		TextWrapped = true,
		LayoutOrder = 51,
		Parent = content,
	})
	-- Zukunfts-Ich als letzte Zeile
	local futureCard = UI.Card({ Size = UDim2.new(1, 0, 0, 70), LayoutOrder = 60, Parent = content })
	UI.Label({
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 20),
		Text = UI.Upper(T("tui.future.title")),
		Face = "Display",
		TextColor3 = Theme.Purple,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 14,
		Parent = futureCard,
	})
	UI.Label({
		Position = UDim2.fromOffset(12, 28),
		Size = UDim2.new(1, -24, 0, 36),
		Text = futureText(),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		MaxText = 14,
		Parent = futureCard,
	})
end

local function openWindow()
	if not window then
		window = UI.Window(T("tui.welcome.title"), WINDOW_W, WINDOW_H, Theme.Up)
		builtLang = lang()
	elseif builtLang ~= lang() then
		window.TitleLabel.Text = UI.Upper(T("tui.welcome.title"))
		builtLang = lang()
	end
	fillWindow()
	UI.OpenWindow(window)
	call("Sfx", "Play", "Achievement")
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
end

function WelcomeBack.Show(data: any)
	if type(data) == "table" then
		if type(data.Offline) == "table" then
			report.Offline = data.Offline
		end
		if type(data.Catchup) == "table" then
			report.Catchup = data.Catchup
		end
	end
	shown = true
	pendingSince = nil
	if ctx.Windows then
		ctx.Windows.Open("WelcomeBack")
	end
end

-- 1×/s (TowerView): verzögert öffnen, wenn kein anderes Fenster/Tutorial stört
function WelcomeBack.Tick()
	if window and window.IsOpen then
		return
	end
	local since = pendingSince
	if shown or not since then
		return
	end
	local waited = os.clock() - since
	if waited < SHOW_DELAY then
		return
	end
	if waited > WAIT_MAX then
		pendingSince = nil
		return
	end
	local okTut, active = call("Tutorial", "IsActive")
	if okTut and active == true then
		return
	end
	if ctx.Windows and ctx.Windows.IsOpen() then
		return
	end
	if hasNews() then
		WelcomeBack.Show(nil)
	end
end

function WelcomeBack.Init(context: any)
	ctx = context
	ctx.Windows.Register("WelcomeBack", openWindow, closeWindow)
	ctx.Hooks.On("State", function(state: { [string]: any }, changed: { [any]: any })
		if shown then
			if window and window.IsOpen and (changed.Life or changed.Tower) and reportSig() ~= filledSig then
				fillWindow() -- Abgleich kam später an (Bots/Orders) -> Bericht ergänzen
			end
			return
		end
		if (changed.Tower or changed.Life) and pendingSince == nil then
			local t = state.Tower
			if type(t) == "table" and type(t.Offline) == "table" then
				pendingSince = os.clock()
			end
		end
	end)
end

function WelcomeBack.Start()
	-- „Zukunfts-Ich“, sobald das Roblox-Menü aufgeht (man verlässt das Spiel gleich)
	GuiService.MenuOpened:Connect(function()
		if os.clock() - futureAt >= FUTURE_GAP and type(ctx.State.Tower) == "table" then
			WelcomeBack.ShowFuture()
		end
	end)
end

return WelcomeBack
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="165">
            <Properties>
              <string name="Name">WorldLook</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Licht, Tag/Nacht, Markt-Wetter, Crash/Rally, Licht-Budget (Client/Modules/WorldLook)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §A4 (Tag/Nacht = Börsentag aus Clock, Markt-Wetter aus dem
--  Regime, Crash-/Rally-Tönung, Fensterlicht-Kaskade 0,05 s je Etage ab ClockTime 18,5, DoF nur in Menüs/Kamerafahrten),
--  §A7 #6/#7 (roter Himmel + Sirene, grüne Polarlichter + Fanfare), §B10.2, §C7.5 (WorldLook.SetOverride), §C16
--  (Lichter ≤ 6/16/32/64 je Grafikstufe), §0 Regel 16 (StreamingEnabled: alles über Attribute + DescendantAdded, nil-sicher).
--
--  Tageszeit: jeder Client rechnet aus workspace:GetServerTimeNow() (Clock) -> zwei Clients sind sekundengenau synchron.
--  Welt-Konventionen (Attribute, gesetzt von CityService/VehicleService/WP8):
--    Licht mit "Budget" = true      -> nur die nächsten N (Quality.Budget("Lights")) leuchten; "NightOnly" nur nachts
--    Teil mit "WindowLight" = Etage -> nachts warmes Fensterlicht, Kaskade von unten nach oben (0,05 s je Etage)
--    Model mit "Spin" = Grad/s      -> dreht sich lokal (Drehteller, Vitrinen, Leuchtturm), nur in der Nähe
--    Model mit "Bell" = true        -> schwingt bei der Glocke (Hook "Market:Bell")
--    Teil mit "LocalDoor" = "Vip"/"Club" -> nur für Spieler mit diesem Attribut offen (lokal)
--    ProximityPrompt mit "TextKey"/"ObjectKey" -> in die Spielersprache übersetzt
--
--  Öffentliche API (§C7.5):
--    WorldLook.SetOverride(kind?)   "Crash" | "Rally" | "Storm" | "Clouds" | "Clear" | "Day" | "Night" | "Golden" |
--                                   "Cinematic" (Tiefenschärfe für Kamerafahrten) | nil = automatisch
--  Zusätzlich: WorldLook.Weather(): string ("Clear"/"Clouds"/"Storm") · WorldLook.IsNight(): boolean ·
--    WorldLook.LightStats(): (aktiv, verwaltet) · WorldLook.Frame(dt) · WorldLook.Init(ctx) · WorldLook.Start()
-- =====================================================================

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local WorldLook = {}

local player = Players.LocalPlayer

type WindowEntry = {
	Part: BasePart,
	Level: number,
	Material: Enum.Material,
	Color: Color3,
	Transparency: number,
	Lit: boolean,
}
type Spinner = { Model: Model, Speed: number, Base: CFrame, Angle: number, Beam: Beam? }

local ctx: any = nil
local cfg: any = {}
local weatherCfg: any = {}
local lightsCfg: any = {}

local MAX_WINDOWS = 3000
local MAX_SPINNERS = 64
local MAX_PROMPTS = 400
local MAX_DOORS = 32
local WINDOW_STEP_LIMIT = 160 -- Fensteränderungen je Frame
local LOOK_HZ = 10
local SCAN_CHUNK = 2000

local override: string? = nil
local clockTime = 9
local nightFactor = 0
local isNight = false
local lookAccum = 0
local lightAccum = 0

-- Effekte (eigene, lokale Instanzen)
local atmosphere: Atmosphere? = nil
local colorCorrection: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil
local dof: DepthOfFieldEffect? = nil
local clouds: Clouds? = nil
local stormCC: ColorCorrectionEffect? = nil -- Blitz-Flash

-- Markt-Wetter + Crash/Rally
local regime = 1
local frameCrash, frameRally = false, false
local eventMode: string? = nil -- "Crash" | "Rally" aus Hook "Market:Event"
local eventUntil = 0
local mode: string? = nil -- wirksamer Modus nach Override
local blend = { Crash = 0, Rally = 0, Cover = 0.2, Density = 0.5, Storm = 0 }
local lastMode: string? = nil
local nextLightning = 0
local flashUntil = 0

-- Regen & Polarlichter (lokal)
local rainPart: Part? = nil
local rainEmitter: ParticleEmitter? = nil
local auroraFolder: Folder? = nil
local auroraBeams: { Beam } = {}

-- Welt-Register
local windows: { [BasePart]: WindowEntry } = {}
local windowCount = 0
local windowQueue: { { Entry: WindowEntry, At: number, Lit: boolean } } = {}
local windowsLit = false
local lights: { [Light]: boolean } = {}
local lightCount = 0
local activeLights = 0
local spinners: { [Model]: Spinner } = {}
local spinnerCount = 0
local prompts: { [ProximityPrompt]: boolean } = {}
local promptCount = 0
local doors: { [BasePart]: { CanCollide: boolean, Transparency: number } } = {}
local doorCount = 0
local bellModel: Model? = nil
local bellSwing = 0 -- verbleibende Schwing-Zeit
local bellRest: CFrame? = nil -- Modell-Pivot in Ruhe
local bellHinge: CFrame? = nil -- Aufhängung (oben)
local dofWanted = false
local cinematic: number? = nil -- Fokus-Distanz einer laufenden Kamerafahrt (SetCinematic), unabhängig vom Override

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function settings(): { [string]: any }
	local ok, value = call("Settings", "Get")
	if ok and type(value) == "table" then
		return value
	end
	return {}
end

local function reducedFx(): boolean
	return settings().ReducedFx == true
end

local function budget(key: string, fallback: number): number
	local ok, value = call("Quality", "Budget", key)
	if ok and type(value) == "number" then
		return value
	end
	return fallback
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function lerpColor(a: Color3, b: Color3, t: number): Color3
	return a:Lerp(b, math.clamp(t, 0, 1))
end

local function smoothstep(e0: number, e1: number, x: number): number
	local t = math.clamp((x - e0) / (e1 - e0), 0, 1)
	return t * t * (3 - 2 * t)
end

local function approach(current: number, target: number, dt: number, seconds: number): number
	if seconds <= 0 then
		return target
	end
	local alpha = 1 - math.exp(-dt * 3 / seconds)
	return current + (target - current) * alpha
end

local function now(): number
	return ctx.Clock.Now()
end

-- ---------------------------------------------------------------------
-- 1) EIGENE LIGHTING-INSTANZEN (Server-Instanzen übernehmen, sonst lokal anlegen)
-- ---------------------------------------------------------------------
local function ensureEffects()
	local found = Lighting:FindFirstChildOfClass("Atmosphere")
	if not found then
		local created = Instance.new("Atmosphere")
		created.Name = "AT_Atmosphere"
		created.Parent = Lighting
		found = created
	end
	atmosphere = found
	local cc = Lighting:FindFirstChild("AT_ColorCorrection")
	if not (cc and cc:IsA("ColorCorrectionEffect")) then
		local created = Instance.new("ColorCorrectionEffect")
		created.Name = "AT_ColorCorrection"
		created.Parent = Lighting
		cc = created
	end
	colorCorrection = cc :: ColorCorrectionEffect
	local bl = Lighting:FindFirstChildOfClass("BloomEffect")
	if bl then
		bloom = bl
	end
	local flash = Instance.new("ColorCorrectionEffect")
	flash.Name = "AT_LightningFlash"
	flash.Brightness = 0
	flash.Parent = Lighting
	stormCC = flash
	local depth = Instance.new("DepthOfFieldEffect")
	depth.Name = "AT_MenuDepth"
	depth.Enabled = false
	local d = cfg.DepthOfField or {}
	depth.FarIntensity = 0
	depth.NearIntensity = 0
	depth.FocusDistance = d.FocusDistance or 14
	depth.InFocusRadius = d.InFocusRadius or 22
	depth.Parent = Lighting
	dof = depth
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		local c = terrain:FindFirstChildOfClass("Clouds")
		if not c then
			local created = Instance.new("Clouds")
			created.Name = "AT_Clouds"
			created.Parent = terrain
			c = created
		end
		clouds = c
	end
end

-- ---------------------------------------------------------------------
-- 2) MODUS (Override > Crash/Rally > Wetter)
-- ---------------------------------------------------------------------
local function weatherOf(r: number): string
	if r > (weatherCfg.StormAbove or 1.2) then
		return "Storm"
	elseif r >= (weatherCfg.ClearBelow or 0.85) then
		return "Clouds"
	end
	return "Clear"
end

local function effectiveMode(): string
	if override == "Crash" or override == "Rally" then
		return override
	end
	if eventMode and now() < eventUntil then
		return eventMode
	end
	if frameCrash then
		return "Crash"
	elseif frameRally then
		return "Rally"
	end
	return "None"
end

local function effectiveWeather(): string
	if override == "Storm" or override == "Clouds" or override == "Clear" then
		return override
	end
	return weatherOf(regime)
end

-- ---------------------------------------------------------------------
-- 3) REGEN, BLITZE, POLARLICHTER
-- ---------------------------------------------------------------------
local function ensureRain()
	if rainPart and rainPart.Parent then
		return
	end
	local rain = weatherCfg.Rain or {}
	local part = Instance.new("Part")
	part.Name = "AT_Rain"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new((rain.Radius or 70) * 2, 1, (rain.Radius or 70) * 2)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/SquareParticle.png"
	emitter.Color = ColorSequence.new(rain.Color or Color3.fromRGB(190, 205, 230))
	emitter.Transparency = NumberSequence.new(0.35)
	emitter.Size = NumberSequence.new(0.06)
	emitter.Lifetime = NumberRange.new(0.6, 0.8)
	emitter.Speed = NumberRange.new(rain.Speed or 120)
	emitter.EmissionDirection = Enum.NormalId.Bottom
	emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
	emitter.Squash = NumberSequence.new(4) -- lange dünne Tropfen
	emitter.LightEmission = 0.2
	emitter.Rate = 0
	emitter.Parent = part
	part.Parent = workspace
	rainPart = part
	rainEmitter = emitter
end

local function setAurora(on: boolean)
	if not on then
		if auroraFolder then
			auroraFolder:Destroy()
		end
		auroraFolder = nil
		table.clear(auroraBeams)
		return
	end
	if auroraFolder and auroraFolder.Parent then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "AT_Aurora"
	local holder = Instance.new("Part")
	holder.Name = "AuroraAnchor"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(1, 1, 1)
	holder.CFrame = CFrame.new(0, 220, 0)
	holder.Parent = folder
	local colors = (cfg.Rally and cfg.Rally.Aurora) or { Color3.fromRGB(34, 197, 94), Color3.fromRGB(34, 211, 238) }
	for i = 1, 6 do
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(-420, (i - 3) * 14, -160 + i * 50)
		a0.Parent = holder
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(420, (3 - i) * 12, -120 + i * 44)
		a1.Parent = holder
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Texture = "rbxasset://textures/gradient.png"
		beam.TextureMode = Enum.TextureMode.Stretch
		beam.Width0 = 60
		beam.Width1 = 90
		beam.CurveSize0 = 120
		beam.CurveSize1 = -120
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.FaceCamera = false
		beam.Color = ColorSequence.new(colors[1], colors[2] or colors[1])
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.55),
			NumberSequenceKeypoint.new(0.7, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		})
		beam.Parent = holder
		table.insert(auroraBeams, beam)
	end
	folder.Parent = workspace
	auroraFolder = folder
end

local function updateWeatherFx(dt: number, weather: string)
	local storm = weather == "Storm"
	blend.Storm = approach(blend.Storm, if storm then 1 else 0, dt, weatherCfg.BlendSeconds or 8)
	local camera = workspace.CurrentCamera
	local rate = 0
	if blend.Storm > 0.05 then
		ensureRain()
		rate = (weatherCfg.Rain and weatherCfg.Rain.Rate or 380) * blend.Storm * budget("Particles", 1)
	end
	local part = rainPart
	if part and camera then
		local rain = weatherCfg.Rain or {}
		part.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, rain.Height or 45, 0))
	end
	if rainEmitter then
		rainEmitter.Rate = if reducedFx() then rate * 0.5 else rate
	end
	-- harmlose Blitze (nur Licht, kein Schaden); ReducedFx: aus
	local t = os.clock()
	local flash = stormCC
	if flash then
		if storm and blend.Storm > 0.6 and not reducedFx() and t >= nextLightning then
			local gap = weatherCfg.Lightning or {}
			nextLightning = t + (gap.MinGap or 6) + math.random() * ((gap.MaxGap or 14) - (gap.MinGap or 6))
			flashUntil = t + (gap.Flash or 0.12)
		end
		local target = if t < flashUntil then 0.35 else 0
		flash.Brightness = if target > 0 then target else approach(flash.Brightness, 0, dt, 0.15)
	end
end

-- ---------------------------------------------------------------------
-- 4) LICHT-LOOK (10 Hz): Tag/Nacht-Mischung + Crash/Rally + Wetter
-- ---------------------------------------------------------------------
local function applyLook(dt: number)
	local day = cfg.Day
	local night = cfg.Night
	if type(day) ~= "table" or type(night) ~= "table" then
		return
	end
	local n = nightFactor
	if override == "Day" then
		n = 0
	elseif override == "Night" then
		n = 1
	end
	Lighting.Ambient = lerpColor(day.Ambient, night.Ambient, n)
	Lighting.OutdoorAmbient = lerpColor(day.OutdoorAmbient, night.OutdoorAmbient, n)
	Lighting.Brightness = lerp(day.Brightness, night.Brightness, n)
	Lighting.ColorShift_Top = lerpColor(day.ColorShiftTop, night.ColorShiftTop, n)
	Lighting.ExposureCompensation = lerp(day.ExposureCompensation or 0, night.ExposureCompensation or 0, n)

	-- goldene Stunde (Abend-Skyline, §A4): um Sonnenuntergang/-aufgang wärmerer Dunst + Tönung
	local golden = 0
	if override ~= "Day" and override ~= "Night" then
		golden = math.max(0, 1 - math.abs(clockTime - 18.1) / 1.4, 0.6 * (1 - math.abs(clockTime - 6.4) / 1.0))
	end
	local blendSeconds = if reducedFx() then 0.3 else (cfg.BlendSeconds or 4)
	mode = effectiveMode()
	blend.Crash = approach(blend.Crash, if mode == "Crash" then 1 else 0, dt, blendSeconds)
	blend.Rally = approach(blend.Rally, if mode == "Rally" then 1 else 0, dt, blendSeconds)
	local atmo = atmosphere
	if atmo then
		local a, b = day.Atmosphere, night.Atmosphere
		atmo.Density = lerp(a.Density, b.Density, n) + 0.06 * blend.Storm
		atmo.Haze = lerp(a.Haze, b.Haze, n) + 0.8 * blend.Storm
		atmo.Glare = lerp(a.Glare, b.Glare, n)
		atmo.Offset = lerp(a.Offset, b.Offset, n)
		local color = a.Color
		if golden > 0 then
			color = lerpColor(color, Color3.fromRGB(255, 196, 160), golden * 0.55)
		end
		local crashAtmo = cfg.Crash and cfg.Crash.Atmosphere
		if typeof(crashAtmo) == "Color3" then
			color = lerpColor(color, crashAtmo, blend.Crash)
		end
		atmo.Color = color
		atmo.Decay = lerpColor(a.Decay, b.Decay, n)
	end
	local cc = colorCorrection
	if cc then
		local base = cfg.ColorCorrection or {}
		local crash = cfg.Crash or {}
		local rally = cfg.Rally or {}
		local tint = base.Tint or Color3.new(1, 1, 1)
		local goldenTint = cfg.Golden and cfg.Golden.Tint
		if golden > 0 and typeof(goldenTint) == "Color3" then
			tint = lerpColor(tint, goldenTint, golden * 0.8)
		end
		tint = lerpColor(tint, crash.Tint or tint, blend.Crash)
		tint = lerpColor(tint, rally.Tint or tint, blend.Rally)
		if override == "Golden" and cfg.Golden then
			tint = cfg.Golden.Tint
		end
		cc.TintColor = tint
		cc.Saturation = (base.Saturation or 0.05)
			+ ((crash.Saturation or -0.15) - (base.Saturation or 0.05)) * blend.Crash
			+ ((rally.Saturation or 0.12) - (base.Saturation or 0.05)) * blend.Rally
			- 0.08 * blend.Storm
		cc.Contrast = (base.Contrast or 0.08)
			+ ((crash.Contrast or 0.14) - (base.Contrast or 0.08)) * blend.Crash
			+ ((rally.Contrast or 0.1) - (base.Contrast or 0.08)) * blend.Rally
	end
	local bl = bloom
	if bl and cfg.Bloom then
		bl.Intensity = cfg.Bloom.Intensity + 0.15 * n
	end
	-- Wolken nach Markt-Wetter
	local weather = effectiveWeather()
	local c = clouds
	if c then
		local cover = weatherCfg.Cover or {}
		local density = weatherCfg.Density or {}
		local colors = weatherCfg.CloudColor or {}
		blend.Cover = approach(blend.Cover, (cover :: any)[weather] or 0.3, dt, weatherCfg.BlendSeconds or 8)
		blend.Density = approach(blend.Density, (density :: any)[weather] or 0.6, dt, weatherCfg.BlendSeconds or 8)
		c.Cover = blend.Cover
		c.Density = blend.Density
		if colors.Clear and colors.Storm then
			c.Color = lerpColor(colors.Clear, colors.Storm, blend.Storm)
		end
	end
	-- Polarlichter (Rally) ein/aus
	setAurora(blend.Rally > 0.05 and not reducedFx())
	for _, beam in ipairs(auroraBeams) do
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 1 - 0.45 * blend.Rally),
			NumberSequenceKeypoint.new(0.7, 1 - 0.45 * blend.Rally),
			NumberSequenceKeypoint.new(1, 1),
		})
	end
	-- Sirene/Fanfare einmal beim Wechsel (§B10.2)
	if mode ~= lastMode then
		if mode == "Crash" then
			call("Sfx", "Play", "CrashAlarm") -- Ticker-Wände färbt das Modul Ticker bei Crash selbst rot
		elseif mode == "Rally" then
			call("Sfx", "Play", "RallyFanfare")
		end
		lastMode = mode
	end
end

-- ---------------------------------------------------------------------
-- 5) FENSTERLICHT-KASKADE
-- ---------------------------------------------------------------------
local function setWindow(entry: WindowEntry, lit: boolean)
	local part = entry.Part
	if not part.Parent or entry.Lit == lit then
		return
	end
	entry.Lit = lit
	if lit then
		local custom = part:GetAttribute("LitColor")
		part.Material = Enum.Material.Neon
		part.Color = if typeof(custom) == "Color3" then custom else (cfg.WindowLit or Color3.fromRGB(255, 214, 150))
		part.Transparency = math.min(entry.Transparency, 0.2)
	else
		part.Material = entry.Material
		part.Color = entry.Color
		part.Transparency = entry.Transparency
	end
end

local function addWindow(part: BasePart)
	if windows[part] or windowCount >= MAX_WINDOWS then
		return
	end
	local level = part:GetAttribute("WindowLight")
	local entry: WindowEntry = {
		Part = part,
		Level = if type(level) == "number" then math.max(0, level) else 0,
		Material = part.Material,
		Color = part.Color,
		Transparency = part.Transparency,
		Lit = false,
	}
	windows[part] = entry
	windowCount += 1
	if windowsLit then
		setWindow(entry, true) -- nachts hereingestreamt: sofort an
	end
end

local function removeWindow(part: BasePart)
	if windows[part] then
		windows[part] = nil
		windowCount -= 1
	end
end

local function scheduleWindows(lit: boolean)
	windowsLit = lit
	table.clear(windowQueue)
	local t = os.clock()
	local step = if reducedFx() then 0 else (cfg.WindowCascade or 0.05)
	for _, entry in pairs(windows) do
		table.insert(windowQueue, { Entry = entry, At = t + (if lit then entry.Level * step else 0), Lit = lit })
	end
	table.sort(windowQueue, function(a, b)
		return a.At > b.At -- vom Ende abarbeiten (pop)
	end)
end

local function processWindows()
	local t = os.clock()
	local done = 0
	while #windowQueue > 0 and done < WINDOW_STEP_LIMIT do
		local item = windowQueue[#windowQueue]
		if item.At > t then
			break
		end
		windowQueue[#windowQueue] = nil
		setWindow(item.Entry, item.Lit)
		done += 1
	end
end

-- ---------------------------------------------------------------------
-- 6) LICHT-BUDGET (2 Hz): nur die nächsten N Lichter leuchten
-- ---------------------------------------------------------------------
local function lightPosition(light: Light): Vector3?
	local parent = light.Parent
	if parent and parent:IsA("BasePart") then
		return parent.Position
	elseif parent and parent:IsA("Attachment") then
		return parent.WorldPosition
	end
	return nil
end

local function manageLights()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local origin = camera.CFrame.Position
	-- gemeinsames Budget je Grafikstufe: Interior-Lichter (TowerView) zählen mit
	local okInterior, interior = call("TowerView", "InteriorLights")
	local used = if okInterior and type(interior) == "number" then interior else 0
	local n = math.max(0, math.floor(budget("Lights", 16)) - used)
	local candidates: { { Light: Light, D: number } } = {}
	for light in pairs(lights) do
		if not light.Parent then
			lights[light] = nil
			lightCount -= 1
			continue
		end
		local wanted = light:GetAttribute("Budget") == true and (light:GetAttribute("NightOnly") ~= true or isNight)
		local pos = wanted and lightPosition(light) or nil
		if pos then
			table.insert(candidates, { Light = light, D = (pos - origin).Magnitude })
		elseif light.Enabled then
			light.Enabled = false
		end
	end
	table.sort(candidates, function(a, b)
		return a.D < b.D
	end)
	-- Future-Licht: echte Schatten nur für die allernächsten Lichter (teuer) – Low 0, sonst ein Viertel des Budgets
	-- (Medium 4, High 8, Ultra 16), nur in Kameranähe; ReducedFx halbiert
	local shadowCount = if budget("Shadows", 1) >= 1 then math.floor(n / 4) else 0
	if shadowCount > 0 and reducedFx() then
		shadowCount = math.floor(shadowCount / 2)
	end
	activeLights = 0
	for index, item in ipairs(candidates) do
		local on = index <= n and item.D < 600
		local light = item.Light
		if light.Enabled ~= on then
			light.Enabled = on
		end
		local shadows = false
		if on and index <= shadowCount and item.D < 160 and light:GetAttribute("NoShadow") ~= true then
			-- nur Lichter, die nicht in einem schattenwerfenden Teil stecken (sonst wäre es innen dunkel)
			local holder = light.Parent
			shadows = light:IsA("SurfaceLight") or (holder ~= nil and holder:IsA("BasePart") and not holder.CastShadow)
		end
		if light.Shadows ~= shadows then
			light.Shadows = shadows
		end
		if on then
			activeLights += 1
		end
	end
end

local function addLight(light: Light)
	if lights[light] or lightCount >= (lightsCfg.MaxManaged or 600) then
		return
	end
	if light:GetAttribute("Budget") == nil then
		return -- nicht verwaltet (z. B. Laden-Spot: CityLife)
	end
	lights[light] = true
	lightCount += 1
	light.Enabled = false
end

-- ---------------------------------------------------------------------
-- 7) DREHENDE AUSSTELLUNGSSTÜCKE, GLOCKE
-- ---------------------------------------------------------------------
local function addSpinner(model: Model)
	if spinners[model] or spinnerCount >= MAX_SPINNERS then
		return
	end
	local speed = model:GetAttribute("Spin")
	if type(speed) ~= "number" then
		return
	end
	local okPivot, base = pcall(function(): CFrame
		local pivot = model:GetPivot()
		local center, size = model:GetBoundingBox()
		if (pivot.Position - center.Position).Magnitude > size.Magnitude then
			-- Kein sinnvoller Drehpunkt (z. B. Weltursprung): Mitte der Bounding-Box, nur Verschiebung
			return CFrame.new(center.Position)
		end
		return pivot
	end)
	if not okPivot then
		return
	end
	local spinner: Spinner = { Model = model, Speed = speed, Base = base, Angle = 0, Beam = nil }
	if model:GetAttribute("Beam") == true then
		-- Leuchtturm-Lichtkegel (lokal)
		local primary = model:FindFirstChildWhichIsA("BasePart")
		if primary then
			local a0 = Instance.new("Attachment")
			a0.Name = "AT_BeamA"
			a0.Parent = primary
			local a1 = Instance.new("Attachment")
			a1.Name = "AT_BeamB"
			a1.Position = Vector3.new(0, -4, -120)
			a1.Parent = primary
			local beam = Instance.new("Beam")
			beam.Attachment0 = a0
			beam.Attachment1 = a1
			beam.Width0 = 2
			beam.Width1 = 34
			beam.Texture = "rbxasset://textures/gradient.png"
			beam.LightEmission = 1
			beam.LightInfluence = 0
			beam.FaceCamera = true
			beam.Color = ColorSequence.new(Color3.fromRGB(255, 226, 170))
			beam.Transparency =
				NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
			beam.Enabled = false
			beam.Parent = primary
			spinner.Beam = beam
		end
	end
	spinners[model] = spinner
	spinnerCount += 1
end

local function removeSpinner(model: Model)
	if spinners[model] then
		spinners[model] = nil
		spinnerCount -= 1
	end
end

local function updateSpinners(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local origin = camera.CFrame.Position
	local radius = (ctx.Config.City and ctx.Config.City.Life and ctx.Config.City.Life.SpinRadius) or 260
	local reduced = reducedFx()
	for model, spinner in pairs(spinners) do
		if not model.Parent then
			removeSpinner(model)
			continue
		end
		local near = (spinner.Base.Position - origin).Magnitude < (if spinner.Beam then 1200 else radius)
		if spinner.Beam then
			spinner.Beam.Enabled = isNight
		end
		if near and not reduced then
			spinner.Angle = (spinner.Angle + math.rad(spinner.Speed) * dt) % (2 * math.pi)
			model:PivotTo(spinner.Base * CFrame.Angles(0, spinner.Angle, 0))
		end
	end
end

local function setBell(model: Model?)
	bellModel = model
	bellRest, bellHinge = nil, nil
	bellSwing = 0
	if not model then
		return
	end
	local ok, cf, size = pcall(function(): (CFrame, Vector3)
		return model:GetBoundingBox()
	end)
	if ok then
		bellRest = model:GetPivot()
		bellHinge = (cf :: CFrame) * CFrame.new(0, (size :: Vector3).Y / 2, 0)
	end
end

local function updateBell(dt: number)
	local model = bellModel
	local rest, hinge = bellRest, bellHinge
	if bellSwing <= 0 or not model or not model.Parent or not rest or not hinge then
		return
	end
	bellSwing = math.max(0, bellSwing - dt)
	if bellSwing <= 0 then
		model:PivotTo(rest)
		return
	end
	local amplitude = math.rad(18) * (bellSwing / 3) -- gedämpft ausschwingen
	local angle = math.sin((3 - bellSwing) * 7) * amplitude
	model:PivotTo(hinge * CFrame.Angles(angle, 0, 0) * hinge:Inverse() * rest)
end

-- ---------------------------------------------------------------------
-- 8) LOKALE TÜREN, PROMPT-TEXTE
-- ---------------------------------------------------------------------
local function doorOpenFor(kind: any): boolean
	if kind == "Vip" then
		return player:GetAttribute("Vip") == true
	elseif kind == "Club" then
		return player:GetAttribute("Club") == true
	end
	return false
end

local function applyDoor(part: BasePart)
	local original = doors[part]
	if not original then
		return
	end
	if doorOpenFor(part:GetAttribute("LocalDoor")) then
		part.CanCollide = false
		part.CanQuery = false
		part.Transparency = 0.85
	else
		part.CanCollide = original.CanCollide
		part.CanQuery = true
		part.Transparency = original.Transparency
	end
end

local function addDoor(part: BasePart)
	if doors[part] or doorCount >= MAX_DOORS then
		return
	end
	doors[part] = { CanCollide = part.CanCollide, Transparency = part.Transparency }
	doorCount += 1
	applyDoor(part)
end

local function localizePrompt(prompt: ProximityPrompt)
	local key = prompt:GetAttribute("TextKey")
	if type(key) == "string" then
		prompt.ActionText = ctx.T(key)
	end
	local objectKey = prompt:GetAttribute("ObjectKey")
	if type(objectKey) == "string" then
		prompt.ObjectText = ctx.T(objectKey)
	end
end

local function addPrompt(prompt: ProximityPrompt)
	if prompts[prompt] or promptCount >= MAX_PROMPTS then
		return
	end
	if prompt:GetAttribute("TextKey") == nil then
		return
	end
	prompts[prompt] = true
	promptCount += 1
	localizePrompt(prompt)
end

-- ---------------------------------------------------------------------
-- 9) WELT-SCAN (StreamingEnabled: kommt/geht jederzeit)
-- ---------------------------------------------------------------------
local function consider(inst: Instance)
	if inst:IsA("BasePart") then
		if inst:GetAttribute("WindowLight") ~= nil then
			addWindow(inst)
		end
		if inst:GetAttribute("LocalDoor") ~= nil then
			addDoor(inst)
		end
	elseif inst:IsA("Light") then
		addLight(inst)
	elseif inst:IsA("Model") then
		if inst:GetAttribute("Spin") ~= nil then
			addSpinner(inst)
		end
		if inst:GetAttribute("Bell") == true then
			setBell(inst)
		end
	elseif inst:IsA("ProximityPrompt") then
		addPrompt(inst)
	end
end

local function forget(inst: Instance)
	if inst:IsA("BasePart") then
		removeWindow(inst)
		if doors[inst] then
			doors[inst] = nil
			doorCount -= 1
		end
	elseif inst:IsA("Light") then
		if lights[inst] then
			lights[inst] = nil
			lightCount -= 1
		end
	elseif inst:IsA("Model") then
		removeSpinner(inst)
		if inst == bellModel then
			setBell(nil)
		end
	elseif inst:IsA("ProximityPrompt") then
		if prompts[inst] then
			prompts[inst] = nil
			promptCount -= 1
		end
	end
end

local function scan()
	local ok, list = pcall(function()
		return workspace:GetDescendants()
	end)
	if not ok or type(list) ~= "table" then
		return
	end
	for index, inst in ipairs(list) do
		consider(inst)
		if index % SCAN_CHUNK == 0 then
			task.wait()
		end
	end
end

-- ---------------------------------------------------------------------
-- 10) TIEFENSCHÄRFE (Menüs, Kamerafahrten)
-- ---------------------------------------------------------------------
local function updateDof()
	local depth = dof
	if not depth then
		return
	end
	local windowOpen = false
	local okOpen, anyOpen = call("UI", "IsAnyWindowOpen")
	if okOpen then
		windowOpen = anyOpen == true
	end
	local want = (windowOpen or override == "Cinematic" or cinematic ~= nil)
		and budget("DoF", 0) >= 1
		and not reducedFx()
	local d = cfg.DepthOfField or {}
	-- Kamerafahrt: Motiv scharf, Hintergrund weich; Menü: nahe Fokus-Ebene (Fenster vor der Welt)
	local focus = if cinematic and not windowOpen then cinematic else (d.FocusDistance or 14)
	depth.FocusDistance = focus
	depth.InFocusRadius = if cinematic and not windowOpen
		then math.max(d.InFocusRadius or 22, focus * 0.45)
		else (d.InFocusRadius or 22)
	if want == dofWanted then
		return
	end
	dofWanted = want
	if want then
		depth.Enabled = true
	end
	local tween = TweenService:Create(depth, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		FarIntensity = if want then (d.FarIntensity or 0.28) else 0,
		NearIntensity = if want then (d.NearIntensity or 0.2) else 0,
	})
	tween.Completed:Once(function()
		if not dofWanted then
			depth.Enabled = false
		end
	end)
	tween:Play()
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function WorldLook.SetOverride(kind: string?)
	local valid = {
		Crash = true,
		Rally = true,
		Storm = true,
		Clouds = true,
		Clear = true,
		Day = true,
		Night = true,
		Golden = true,
		Cinematic = true,
	}
	if kind ~= nil and not valid[kind] then
		warn("[WorldLook] unbekannter Override: " .. tostring(kind))
		return
	end
	override = kind
	if kind == "Crash" then
		call("Ticker", "SetTint", (cfg.Crash and cfg.Crash.Tint) or Color3.fromRGB(239, 68, 68))
	else
		call("Ticker", "SetTint", nil)
	end
	updateDof()
end

-- Tiefenschärfe für Kamerafahrten (Etagen-Orbit, Enthüllungen): focus = Abstand Kamera → Motiv; nil/false = aus.
-- Eigener Schalter – überschreibt keinen Licht-Override (z. B. "Golden" eines Events).
function WorldLook.SetCinematic(on: boolean, focus: number?)
	if on then
		cinematic = if type(focus) == "number" and focus == focus then math.clamp(focus, 4, 400) else 30
	else
		cinematic = nil
	end
	updateDof()
end

function WorldLook.Weather(): string
	return effectiveWeather()
end

function WorldLook.IsNight(): boolean
	return isNight
end

function WorldLook.LightStats(): (number, number)
	return activeLights, lightCount
end

function WorldLook.Frame(dt: number)
	-- Tageszeit (stetig, aus der Server-Zeit)
	local t = now() - ctx.Clock.EPOCH
	local ok, value = pcall(ctx.Clock.ClockTime, t)
	clockTime = if ok and type(value) == "number" then value else clockTime
	if override == "Golden" and cfg.Golden then
		clockTime = cfg.Golden.ClockTime
	elseif override == "Day" then
		clockTime = 12
	elseif override == "Night" then
		clockTime = 23
	end
	Lighting.ClockTime = clockTime
	-- Nacht-Anteil: Dämmerung 17 -> 20, Morgen 4,5 -> 7
	local ct = clockTime
	local evening = smoothstep(17, 20, ct)
	local morning = 1 - smoothstep(4.5, 7, ct)
	nightFactor = if ct >= 12 then evening else morning
	local onAt = cfg.WindowOnAt or 18.5
	local offAt = cfg.WindowOffAt or 6.2
	local nightNow = ct >= onAt or ct < offAt
	if override == "Night" then
		nightNow = true
	elseif override == "Day" or override == "Golden" then
		nightNow = false
	end
	if nightNow ~= isNight then
		isNight = nightNow
		scheduleWindows(nightNow)
		lightAccum = math.huge -- Laternen sofort umschalten
	end
	processWindows()

	lookAccum += dt
	if lookAccum >= 1 / LOOK_HZ then
		local step = lookAccum
		lookAccum = 0
		applyLook(step)
		updateWeatherFx(step, effectiveWeather())
	end
	lightAccum += dt
	if lightAccum >= 1 / (lightsCfg.ManageHz or 2) then
		lightAccum = 0
		manageLights()
	end
	updateSpinners(dt)
	updateBell(dt)
end

function WorldLook.Init(context: any)
	ctx = context
	local city = ctx.Config.City or {}
	cfg = city.Look or {}
	weatherCfg = city.Weather or {}
	lightsCfg = city.Lights or {}
	ensureEffects()
	local hooks = ctx.Hooks
	hooks.On("Quotes", function(frame: any)
		if type(frame) ~= "table" then
			return
		end
		if type(frame.Regime) == "number" and frame.Regime == frame.Regime then
			regime = frame.Regime
		end
		local flags = if type(frame.Flags) == "number" then frame.Flags else 0
		frameCrash = bit32.band(flags, 4) ~= 0 -- QuoteCodec.FRAME_FLAGS.Crash
		frameRally = bit32.band(flags, 8) ~= 0 -- QuoteCodec.FRAME_FLAGS.Rally
	end)
	hooks.On("Market:Event", function(data: any)
		if type(data) ~= "table" or (data.Kind ~= "Crash" and data.Kind ~= "Rally") then
			return
		end
		if data.Phase == "End" then
			if eventMode == data.Kind then
				eventMode = nil
				eventUntil = 0
			end
			return
		end
		eventMode = data.Kind
		local untilTick = if type(data.Until) == "number" then data.Until else 0
		local untilUnix = ctx.Clock.UnixOf(untilTick)
		eventUntil = if untilUnix > now() then untilUnix else now() + 300
	end)
	hooks.On("Market:Bell", function()
		if bellModel and not reducedFx() then
			bellSwing = 3
		end
	end)
	hooks.On("WindowOpened", updateDof)
	hooks.On("WindowClosed", function()
		task.defer(updateDof)
	end)
	hooks.On("Quality", function()
		lightAccum = math.huge
		updateDof()
	end)
	hooks.On("Settings", function()
		for prompt in pairs(prompts) do
			if prompt.Parent then
				localizePrompt(prompt)
			end
		end
		updateDof()
	end)
	player:GetAttributeChangedSignal("Vip"):Connect(function()
		for part in pairs(doors) do
			applyDoor(part)
		end
	end)
	player:GetAttributeChangedSignal("Club"):Connect(function()
		for part in pairs(doors) do
			applyDoor(part)
		end
	end)
end

function WorldLook.Start()
	workspace.DescendantAdded:Connect(function(inst: Instance)
		consider(inst)
	end)
	workspace.DescendantRemoving:Connect(function(inst: Instance)
		forget(inst)
	end)
	task.spawn(scan)
end

return WorldLook
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
