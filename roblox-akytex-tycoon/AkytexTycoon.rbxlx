        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Vehicle</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Texte "car." (Shared/Lang/Vehicle)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Nur Schlüssel mit Präfix "car.". Vertrag: DESIGN.md §C15, §B12.1.
--  Platzhalter wie string.format: %s = Text, %d = ganze Zahl, %% = Prozentzeichen. CR-Beträge kommen fertig
--  formatiert als %s (Format.Credits). Auto-, Klassen-, Lack- und Felgen-Namen stehen in Config.Vehicles ({ de, en }).
--  Kurz, ruhig, keine Wett-/Glücksspiel-Wörter (Wortliste §0.7). Tempo-Anzeige: km/h ≈ Studs/s (1 Stud ≈ 0,28 m).
-- =====================================================================

