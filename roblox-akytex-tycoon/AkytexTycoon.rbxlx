        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">News</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Texte "news." (Shared/Lang/News): Schlagzeilen-Vorlagen der Markt-Engine
--  Besitzer: WP3 (Markt-Engine). Vertrag: DESIGN.md §C15, §B6.1, §B7.4; MARKET.md §6.2 (Stärke-Wortschatz).
--  Platzhalter in geschweiften Klammern ({name}, {band}, …) ersetzt der CLIENT aus NewsItem.Args (siehe Config.News);
--  Werte, die selbst "news."-Schlüssel sind (Stärke-Wort, Sektor, Produkt, Konsens), werden mit übersetzt.
--  KEIN Prozentzeichen in den Texten (Lang.T nutzt string.format). Sätze kurz (≤ 12 Wörter, §14.2),
--  Wortliste §0.7 (keine Glücksspiel-/Hebel-/Krypto-Wörter, kein "garantiert") – der Vertrags-Prüfer scannt jeden Wert.
--  Stärke-Wort (fett): leicht · deutlich · massiv · historisch stark  /  slightly · strongly · massively · at a record pace
-- =====================================================================

return {
	de = {
		-- Stärke-Wörter, Sektoren, Konsens
		["news.band.1"] = "leicht",
		["news.band.2"] = "deutlich",
		["news.band.3"] = "massiv",
		["news.band.4"] = "historisch stark",
		["news.sec.T"] = "Tech & KI",
		["news.sec.E"] = "Energie & Klima",
		["news.sec.M"] = "Mobilität & Raumfahrt",
		["news.sec.K"] = "Konsum & Food",
		["news.sec.G"] = "Gaming & Medien",
		["news.sec.F"] = "Finanzen & Immobilien",
		["news.cons.up"] = "steigend",
		["news.cons.down"] = "fallend",
		["news.cons.flat"] = "unverändert",

		-- Produkte je Sektor (für {product})
		["news.product.T.1"] = "eine neue KI-App",
		["news.product.T.2"] = "einen Lern-Roboter",
		["news.product.T.3"] = "eine Cloud-Plattform",
		["news.product.E.1"] = "einen neuen Solarpark",
		["news.product.E.2"] = "eine Mega-Batterie",
		["news.product.E.3"] = "ein neues Windrad",
		["news.product.M.1"] = "ein Flugtaxi",
		["news.product.M.2"] = "einen Elektro-Sportwagen",
		["news.product.M.3"] = "eine Lieferdrohne",
		["news.product.K.1"] = "eine neue Snack-Sorte",
		["news.product.K.2"] = "eine Limo-Neuheit",
		["news.product.K.3"] = "eine Sneaker-Kollektion",
		["news.product.G.1"] = "ein neues Videospiel",
		["news.product.G.2"] = "eine VR-Brille",
		["news.product.G.3"] = "eine Streaming-Show",
		["news.product.F.1"] = "eine Bezahl-App",
		["news.product.F.2"] = "ein Hochhaus-Projekt",
		["news.product.F.3"] = "eine neue Versicherung",

		-- Fakten (positiv)
		["news.fact.up.contract"] = "{name} gewinnt Großauftrag über {amt} Mrd. AKY – Umsatz steigt {band}",
		["news.fact.up.product"] = "{name} startet {product} – Nachfrage steigt {band}",
		["news.fact.up.partner"] = "{name} und {buyer} starten Partnerschaft – Aussichten steigen {band}",
		["news.fact.up.sales"] = "{name}: Verkäufe wachsen {band}",
		["news.fact.up.expansion"] = "{name} eröffnet neue Standorte – Gewinn soll {band} steigen",
		["news.fact.up.award"] = "{name} gewinnt Innovationspreis – Interesse wächst {band}",
		["news.fact.up.record"] = "{name} meldet Rekord-Quartal – Gewinn steigt {band}",
		["news.fact.up.patent"] = "{name} erhält Patent für {product} – Aussichten steigen {band}",
