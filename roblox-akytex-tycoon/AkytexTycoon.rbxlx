}
local RING_SEGMENTS = 120
local RING_R = 228

-- ---------------------------------------------------------------------
-- TEXTE (Lang-Datentabellen direkt; Rückfall: leer – nie Literal-Text im Code)
-- ---------------------------------------------------------------------
local lang = if string.sub(string.lower(player.LocaleId or ""), 1, 2) == "de" then "de" else "en"
local texts: { [string]: string } = {}
local textsLoaded = false
local splashImageId = 0 -- Hybrid-Platz Config.Client.Splash.ImageId (0 = reine Code-Grafik)

local function tryLoadTexts(): boolean
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local langFolder = shared and shared:FindFirstChild("Lang")
	if not langFolder then
		return false
	end
	local loadedFiles: { [string]: boolean } = {}
	for _, name in ipairs({ "Core", "Ui" }) do
		local module = langFolder:FindFirstChild(name)
		if module and module:IsA("ModuleScript") then
			local ok, data = pcall(require, module)
			if ok and type(data) == "table" then
				local entries = data[lang] or data.en
				local fallback = data.en
				if type(fallback) == "table" then
					for key, value in pairs(fallback) do
						if type(key) == "string" and type(value) == "string" then
							texts[key] = value
						end
					end
				end
				if type(entries) == "table" then
					for key, value in pairs(entries) do
						if type(key) == "string" and type(value) == "string" then
							texts[key] = value
						end
					end
				end
				loadedFiles[name] = true
			end
		end
	end
	-- Ladebildschirm-Zeiten aus Config/Client (reine Datentabelle)
	local config = shared and shared:FindFirstChild("Config")
	local client = config and config:FindFirstChild("Client")
	if client and client:IsA("ModuleScript") then
		local ok, data = pcall(require, client)
		local splash = ok and type(data) == "table" and data.Splash or nil
		if type(splash) == "table" then
			for key, value in pairs(splash) do
				if type(value) == "number" and value == value and timing[key] ~= nil then
					timing[key] = value
				end
			end
			local imageId = splash.ImageId
			if type(imageId) == "number" and imageId > 0 and imageId % 1 == 0 and imageId < 2 ^ 53 then
				splashImageId = imageId
			end
		end
	end
	-- fertig, wenn die eigenen Texte da sind und Core auch (oder das Spiel geladen ist – dann fehlt Core wirklich)
	return loadedFiles.Ui == true and (loadedFiles.Core == true or game:IsLoaded())
end

local function text(key: string): string
	return texts[key] or ""
end

-- ---------------------------------------------------------------------
-- AUFBAU
-- ---------------------------------------------------------------------
local function create(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in pairs(props) do
		if key ~= "Parent" then
			(inst :: any)[key] = value
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	inst.Parent = parent
	return inst
end

local gui: ScreenGui = create("ScreenGui", {
	Name = "AkytexTycoonSplash",
	IgnoreGuiInset = true,
	ResetOnSpawn = false,
	DisplayOrder = 100,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})

local background: Frame = create("Frame", {
	Name = "Background",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = BG,
	BorderSizePixel = 0,
	Active = true, -- Eingaben gehen nicht an die Welt dahinter
	Parent = gui,
})

-- weicher Glanz hinter dem Logo (konzentrische Kreise ≈ radialer Verlauf)
local glowCircles: { Frame } = {}
local GLOW_STEPS = { { 1.55, 0.9 }, { 1.25, 0.84 }, { 1.0, 0.78 }, { 0.78, 0.72 }, { 0.58, 0.66 } }
for i, step in ipairs(GLOW_STEPS) do
	local circle: Frame = create("Frame", {
		Name = "Glow" .. i,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = GLOW_OUTER:Lerp(GLOW_INNER, (i - 1) / (#GLOW_STEPS - 1)),
		BackgroundTransparency = step[2],
		BorderSizePixel = 0,
		Parent = background,
	}, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	table.insert(glowCircles, circle)
end

-- Hybrid-Hintergrundbild (Config.Client.Splash.ImageId): erst sichtbar, wenn es wirklich geladen ist
local backdrop: ImageLabel = create("ImageLabel", {
	Name = "Backdrop",
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Image = "",
	ImageTransparency = 1,
	ScaleType = Enum.ScaleType.Crop,
	Visible = false,
	ZIndex = 0,
	Parent = background,
})
local backdropTried = false
local function tryBackdrop()
	if backdropTried or splashImageId <= 0 then
		return
	end
	backdropTried = true
	backdrop.Image = "rbxassetid://" .. string.format("%.0f", splashImageId)
	task.spawn(function()
		local okLoad = false
		pcall(function()
			ContentProvider:PreloadAsync({ backdrop }, function(_id: string, status: Enum.AssetFetchStatus)
				okLoad = status == Enum.AssetFetchStatus.Success
			end)
		end)
		if okLoad and backdrop.Parent then
			backdrop.Visible = true
			-- dezent hinter dem Logo (die Code-Grafik bleibt lesbar)
			TweenService:Create(backdrop, TweenInfo.new(0.6, Enum.EasingStyle.Quint), { ImageTransparency = 0.45 })
				:Play()
		else
			backdrop.Image = "" -- Ladefehler -> automatisch reine Code-Grafik
		end
	end)
end

-- Inhalt (beim Ausblenden wandert er in eine CanvasGroup – vorher nicht, sonst malt sie jeden Frame neu)
local content: Frame = create("Frame", {
	Name = "Content",
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Parent = background,
})

local logo: Frame = create("Frame", {
	Name = "Logo",
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	Parent = content,
})
local logoScale: UIScale = create("UIScale", { Scale = 1, Parent = logo })

-- Strich zwischen zwei Logo-Punkten (512er-Koordinaten, quadratischer Rahmen -> Scale-Werte)
type Stroke = {
	Frame: Frame,
	X1: number,
	Y1: number,
	Dx: number,
	Dy: number,
	Len: number,
	Thick: number,
}

local function makeStroke(
	x1: number,
	y1: number,
	x2: number,
	y2: number,
	thick: number,
	color: Color3,
	transparency: number,
	z: number
): Stroke
	local dx, dy = x2 - x1, y2 - y1
	local len = math.sqrt(dx * dx + dy * dy)
	local frame: Frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale((x1 + x2) / 1024, (y1 + y2) / 1024),
		Size = UDim2.fromScale(len / 512, thick / 512),
		Rotation = math.deg(math.atan2(dy, dx)),
		BackgroundColor3 = color,
		BackgroundTransparency = transparency,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = logo,
	})
	return { Frame = frame, X1 = x1, Y1 = y1, Dx = dx, Dy = dy, Len = len, Thick = thick }
end

-- Strich bis zum Anteil p gezeichnet (wächst vom Startpunkt aus; Drehung um die Mitte)
local function drawStroke(stroke: Stroke, p: number)
	local frame = stroke.Frame
	if p <= 0 then
		if frame.Visible then
			frame.Visible = false
		end
		return
	end
	if not frame.Visible then
		frame.Visible = true
	end
	local q = math.min(1, p)
	local cx = stroke.X1 + stroke.Dx * q / 2
	local cy = stroke.Y1 + stroke.Dy * q / 2
	frame.Position = UDim2.fromScale(cx / 512, cy / 512)
	frame.Size = UDim2.fromScale(stroke.Len * q / 512, stroke.Thick / 512)
end

-- innerer Glanz-Ring
local innerGlow: Frame = create("Frame", {
	Name = "InnerGlow",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromScale(456 / 512, 456 / 512),
	BackgroundTransparency = 1,
	ZIndex = 1,
	Parent = logo,
}, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
local innerStroke: UIStroke = create("UIStroke", {
	Color = INNER_GLOW,
	Thickness = 6,
	Transparency = 1,
	ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	Parent = innerGlow,
})

-- Kerzen (Docht + Körper)
type Candle = { Wick: Frame, Body: Frame, Opacity: number, WickY: number, BodyY: number, Index: number }
local candles: { Candle } = {}
for i, c in ipairs(CANDLES) do
	local x, top, bottom, bodyY, bodyH, opacity = c[1], c[2], c[3], c[4], c[5], c[6]
	local wick: Frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(x / 512, top / 512),
		Size = UDim2.new(1.2 / 512, 1, (bottom - top) / 512, 0),
		BackgroundColor3 = CANDLE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = logo,
	})
	local body: Frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(x / 512, bodyY / 512),
		Size = UDim2.fromScale(6 / 512, math.max(bodyH, 2) / 512),
		BackgroundColor3 = CANDLE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = logo,
	})
	table.insert(candles, { Wick = wick, Body = body, Opacity = opacity, WickY = top, BodyY = bodyY, Index = i - 1 })
end

-- Gleitender-Durchschnitt-Linie
local maStrokes: { Stroke } = {}
local maLengths: { number } = {}
local maTotal = 0
for i = 1, #CANDLES - 1 do
	local stroke = makeStroke(CANDLES[i][1], MA_Y[i], CANDLES[i + 1][1], MA_Y[i + 1], 1.4, MA, 0.55, 3)
	stroke.Frame.Visible = false
	table.insert(maStrokes, stroke)
	maTotal += stroke.Len
	maLengths[i] = maTotal
end

-- Ring (+ weicher Glanz-Ring darunter)
local ringSegs: { Frame } = {}
local ringGlow: { Frame } = {}
for i = 1, RING_SEGMENTS do
	local a1 = (i - 1) / RING_SEGMENTS * math.pi * 2
	local a2 = i / RING_SEGMENTS * math.pi * 2
	local x1, y1 = 256 + RING_R * math.cos(a1), 256 + RING_R * math.sin(a1)
	local x2, y2 = 256 + RING_R * math.cos(a2), 256 + RING_R * math.sin(a2)
	-- etwas länger als die Sehne, damit keine Lücken entstehen
	local mx, my = (x1 + x2) / 2, (y1 + y2) / 2
	local hx, hy = (x2 - x1) * 0.56, (y2 - y1) * 0.56
	local seg = makeStroke(mx - hx, my - hy, mx + hx, my + hy, 2.6, RING, 0, 5)
	seg.Frame.Visible = false
	table.insert(ringSegs, seg.Frame)
	if i % 2 == 1 then
		local glowSeg = makeStroke(mx - hx * 2, my - hy * 2, mx + hx * 2, my + hy * 2, 9, RING, 0.82, 4)
		glowSeg.Frame.Visible = false
		table.insert(ringGlow, glowSeg.Frame)
	end
end

-- Buchstaben (weiß) + weicher Glanz (UIStroke)
type LetterStroke = { Stroke: Stroke, Glow: UIStroke, From: number, To: number }
local letterStrokes: { { LetterStroke } } = {}
for _, letter in ipairs(LETTERS) do
	local total = 0
	for _, s in ipairs(letter) do
		local dx, dy = s[3] - s[1], s[4] - s[2]
		total += math.sqrt(dx * dx + dy * dy)
	end
	local list: { LetterStroke } = {}
	local acc = 0
	for _, s in ipairs(letter) do
		local stroke = makeStroke(s[1], s[2], s[3], s[4], 4.6, LETTER, 0, 7)
		stroke.Frame.Visible = false
		local glow: UIStroke = create("UIStroke", {
			Color = RING,
			Thickness = 2,
			Transparency = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = stroke.Frame,
		})
		local from = acc / total
		acc += stroke.Len
		table.insert(list, { Stroke = stroke, Glow = glow, From = from, To = acc / total })
	end
	table.insert(letterStrokes, list)
end

-- Ring-Taglines (logo.svg: x 118 / y 146–206 und x 330 / y 386–426, 11,5 px, 4 bzw. 3 Zeilen à 20)
local function tagLabel(name: string, x: number, firstBaseline: number, lines: number): TextLabel
	return create("TextLabel", {
		Name = name,
		Position = UDim2.fromScale(x / 512, (firstBaseline - 11.5) / 512),
		Size = UDim2.fromScale(170 / 512, (lines * 20) / 512),
		BackgroundTransparency = 1,
		FontFace = FACE_DISPLAY_LIGHT,
		TextColor3 = TAG,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LineHeight = 20 / 11.5,
		TextSize = 10,
		Text = "",
		ZIndex = 6,
		Parent = logo,
	})
end
local tag1 = tagLabel("TagMarkets", 118, 146, 4)
local tag2 = tagLabel("TagCapital", 330, 386, 3)

-- Unterzeile: TYCOON (gespreizt), Tagline, Disclaimer-Zeile, voller Disclaimer, Ladebalken
local info: Frame = create("Frame", {
	Name = "Info",
	AnchorPoint = Vector2.new(0.5, 0),
	BackgroundTransparency = 1,
	Parent = content,
}, {
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 6),
	}),
})
local wordRow: Frame = create("Frame", {
	Name = "Word",
	Size = UDim2.new(1, 0, 0, 30),
	BackgroundTransparency = 1,
	LayoutOrder = 1,
	Parent = info,
}, {
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
	}),
})
local wordLetters: { TextLabel } = {}
local function textLine(name: string, order: number, face: Font, size: number, color: Color3, height: number): TextLabel
	return create("TextLabel", {
		Name = name,
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		FontFace = face,
		TextSize = size,
		TextColor3 = color,
		TextTransparency = 1,
		TextWrapped = true,
		Text = "",
		LayoutOrder = order,
		Parent = info,
	})
end
local taglineLabel = textLine("Tagline", 2, FACE_BODY, 18, TEXT2, 24)
local disclaimerShort = textLine("DisclaimerShort", 3, FACE_MONO, 14, TEXT, 20)
local disclaimerFull = textLine("Disclaimer", 4, FACE_BODY, 12, MUTED, 34)

local statusLabel: TextLabel = create("TextLabel", {
	Name = "Status",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -18),
	Size = UDim2.new(0.8, 0, 0, 18),
	BackgroundTransparency = 1,
	FontFace = FACE_MONO,
	TextSize = 13,
	TextColor3 = MUTED,
	Text = "",
	Parent = content,
})
local progressBack: Frame = create("Frame", {
	Name = "Progress",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -42),
	Size = UDim2.new(0.36, 0, 0, 2),
	BackgroundColor3 = Color3.fromRGB(31, 41, 55),
	BorderSizePixel = 0,
	Parent = content,
}, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
local progressFill: Frame = create("Frame", {
	Name = "Fill",
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = ACCENT,
	BorderSizePixel = 0,
	Parent = progressBack,
}, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })

local function applyTexts()
	tag1.Text = text("ui.load.tagMarkets")
	tag2.Text = text("ui.load.tagCapital")
	taglineLabel.Text = text("ui.load.tagline")
	disclaimerShort.Text = text("ui.load.disclaimer")
	disclaimerFull.Text = text("core.disclaimer")
	-- gespreiztes Wort (Roblox kennt kein letter-spacing -> ein Label je Zeichen)
	for _, label in ipairs(wordLetters) do
		label:Destroy()
	end
	table.clear(wordLetters)
	local word = text("ui.load.word")
	local index = 0
	for _, code in utf8.codes(word) do
		index += 1
		if index > 24 then
			break
		end
		local label: TextLabel = create("TextLabel", {
			Size = UDim2.fromOffset(0, 30),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			FontFace = FACE_DISPLAY_LIGHT,
			TextSize = 22,
			TextColor3 = LETTER,
			TextTransparency = 1,
			Text = utf8.char(code),
			LayoutOrder = index,
			Parent = wordRow,
		})
		table.insert(wordLetters, label)
	end
end

-- Größen aus dem Bildschirm (Logo ≤ 440 px, bleibt auch auf dem Handy über der Unterzeile)
local logoPx = 300
local function layout()
	local size = gui.AbsoluteSize
	if size.X < 10 or size.Y < 10 then
		return
	end
	local minDim = math.min(size.X, size.Y)
	logoPx = math.floor(math.clamp(minDim * 0.58, 160, 440))
	local centerY = math.floor(size.Y * 0.42)
	logo.Size = UDim2.fromOffset(logoPx, logoPx)
	logo.Position = UDim2.fromOffset(math.floor(size.X / 2), centerY)
	for i, circle in ipairs(glowCircles) do
		local d = math.floor(logoPx * GLOW_STEPS[i][1])
		circle.Size = UDim2.fromOffset(d, d)
		circle.Position = UDim2.fromOffset(math.floor(size.X / 2), centerY)
	end
	innerStroke.Thickness = math.max(2, logoPx * 10 / 512)
	local tagSize = math.max(7, math.floor(logoPx * 11.5 / 512 + 0.5))
	tag1.TextSize = tagSize
	tag2.TextSize = tagSize
	local infoWidth = math.min(size.X - 32, 640)
	info.Size = UDim2.fromOffset(infoWidth, 160)
	info.Position = UDim2.fromOffset(math.floor(size.X / 2), centerY + math.floor(logoPx / 2) + 6)
	local small = size.Y < 520
	taglineLabel.TextSize = if small then 15 else 18
	disclaimerFull.Visible = size.Y >= 420
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
layout()

-- ---------------------------------------------------------------------
-- ANIMATION (ein PreRender-Loop, nur solange die Splash lebt)
-- ---------------------------------------------------------------------
local function easeOutQuint(x: number): number
	local c = math.clamp(x, 0, 1)
	return 1 - (1 - c) ^ 5
end
local function easeOutCubic(x: number): number
	local c = math.clamp(x, 0, 1)
	return 1 - (1 - c) ^ 3
end
local function phase(t: number, start: number, duration: number): number
	return math.clamp((t - start) / duration, 0, 1)
end

local startedAt = os.clock()
local finished = false
local preloadDone = false
local shownProgress = 0
local skipConn: RBXScriptConnection? = nil
local renderConn: RBXScriptConnection? = nil
local lastTextTry = -1

local function loadedNow(): (boolean, boolean)
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local remotesReady = remotes ~= nil and remotes:FindFirstChild("Request") ~= nil
	return game:IsLoaded(), remotesReady
end

local function finish()
	if finished then
		return
	end
	finished = true
	if skipConn then
		skipConn:Disconnect()
		skipConn = nil
	end
	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end
	-- Ausblenden: Inhalt in eine CanvasGroup (nur jetzt), Logo skaliert auf 1,12, alles fadet
	local group: CanvasGroup = create("CanvasGroup", {
		Name = "Fade",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 0,
		Parent = background,
	})
	content.Parent = group
	local out = timing.OutSeconds
	local info1 = TweenInfo.new(out, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	local info2 = TweenInfo.new(out * 0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(logoScale, info1, { Scale = 1.12 }):Play()
	TweenService:Create(group, info2, { GroupTransparency = 1 }):Play()
	local bgFade = TweenService:Create(background, info2, { BackgroundTransparency = 1 })
	for _, circle in ipairs(glowCircles) do
		TweenService:Create(circle, info2, { BackgroundTransparency = 1 }):Play()
	end
	if backdrop.Visible then
		TweenService:Create(backdrop, info2, { ImageTransparency = 1 }):Play()
	end
	bgFade.Completed:Once(function()
		gui:Destroy()
		player:SetAttribute("SplashDone", true)
	end)
	bgFade:Play()
end

local function step()
	local t = os.clock() - startedAt
	-- Texte nachladen, sobald ReplicatedStorage da ist (höchstens 4× pro Sekunde versuchen)
	if not textsLoaded and t - lastTextTry >= 0.25 then
		lastTextTry = t
		if tryLoadTexts() then
			textsLoaded = true
			applyTexts()
			tryBackdrop()
		end
	end
	-- Ring: zeichnet sich 0,1 s … 1,4 s (ease-ios ≈ Quint Out)
	local ringP = easeOutQuint(phase(t, 0.1, 1.3))
	local ringLit = math.floor(ringP * RING_SEGMENTS + 0.5)
	for i, seg in ipairs(ringSegs) do
		local on = i <= ringLit
		if seg.Visible ~= on then
			seg.Visible = on
		end
	end
	local glowLit = math.floor(ringP * #ringGlow + 0.5)
	-- Ring-Puls ab 1,4 s (2,4-s-Zyklus)
	local pulse = if t > 1.4 then 0.82 - 0.1 * (0.5 - 0.5 * math.cos((t - 1.4) / 2.4 * math.pi * 2)) else 0.82
	for i, seg in ipairs(ringGlow) do
		local on = i <= glowLit
		if seg.Visible ~= on then
			seg.Visible = on
		end
		if on then
			seg.BackgroundTransparency = pulse
		end
	end
	innerStroke.Transparency = 1 - 0.18 * ringP
	-- Kerzen steigen: 0,35 s + i × 18 ms, je 0,5 s (ease-out)
	for _, candle in ipairs(candles) do
		local p = easeOutCubic(phase(t, 0.35 + candle.Index * 0.018, 0.5))
		local offset = 16 * (1 - p) / 512
		local transparency = 1 - candle.Opacity * p
		candle.Wick.BackgroundTransparency = transparency
		candle.Body.BackgroundTransparency = transparency
		candle.Wick.Position = UDim2.fromScale(candle.Wick.Position.X.Scale, candle.WickY / 512 + offset)
		candle.Body.Position = UDim2.fromScale(candle.Body.Position.X.Scale, candle.BodyY / 512 + offset)
	end
	-- Durchschnitts-Linie: 0,6 s … 1,8 s nach Länge
	local maDrawn = easeOutCubic(phase(t, 0.6, 1.2)) * maTotal
	local previous = 0
	for i, stroke in ipairs(maStrokes) do
		local segStart = previous
		previous = maLengths[i]
		drawStroke(stroke, (maDrawn - segStart) / math.max(0.001, stroke.Len))
	end
	-- Buchstaben: je 0,7 s ab 0,75 s + k × 0,09 s; Glanz 0,75 s … 2,15 s
	local glowP = easeOutCubic(phase(t, 0.75, 1.4))
	for k, list in ipairs(letterStrokes) do
		local p = easeOutQuint(phase(t, 0.75 + (k - 1) * 0.09, 0.7))
		for _, entry in ipairs(list) do
			local span = math.max(0.001, entry.To - entry.From)
			drawStroke(entry.Stroke, (p - entry.From) / span)
			entry.Glow.Transparency = 1 - 0.55 * glowP
		end
	end
	-- Taglines bei 1,25 / 1,45 s (0,9 s), Unterzeile ab 1,0 s
	tag1.TextTransparency = 1 - 0.7 * easeOutCubic(phase(t, 1.25, 0.9))
	tag2.TextTransparency = 1 - 0.7 * easeOutCubic(phase(t, 1.45, 0.9))
	local infoP = easeOutCubic(phase(t, 1.0, 0.8))
	for i, label in ipairs(wordLetters) do
		label.TextTransparency = 1 - easeOutCubic(phase(t, 0.9 + (i - 1) * 0.06, 0.6))
	end
	taglineLabel.TextTransparency = 1 - infoP
	disclaimerShort.TextTransparency = 1 - infoP
	disclaimerFull.TextTransparency = 1 - 0.75 * infoP
	-- Laden: Spiel geladen + Remotes da + eigene UI vorgeladen
	local isLoaded, remotesReady = loadedNow()
	local target = 0.12
		+ (if isLoaded then 0.38 else math.min(0.3, t / timing.HardCapSeconds))
		+ (if remotesReady then 0.3 else 0)
		+ (if preloadDone then 0.2 else 0)
	shownProgress += (math.clamp(target, 0, 1) - shownProgress) * 0.12
	progressFill.Size = UDim2.fromScale(shownProgress, 1)
	local ready = isLoaded and remotesReady
	local status = if ready then text("ui.load.ready") else text("core.loading")
	if t >= timing.SkipAfter + 0.7 then
		local hint = text("ui.load.skip")
		if hint ~= "" then
			status = if status ~= "" then status .. "  ·  " .. hint else hint
		end
	end
	if statusLabel.Text ~= status then
		statusLabel.Text = status
	end
	-- Ende: geladen nach der Logo-Animation (≤ LoadedMaxSeconds), sonst harte Grenze
	local loadedDone = ready and t >= timing.MinSeconds and (preloadDone or t >= timing.LoadedMaxSeconds)
	if loadedDone or t >= timing.HardCapSeconds then
		finish()
	end
end

renderConn = RunService.PreRender:Connect(step)

-- Überspringen: tippen, klicken oder Taste (nach SkipAfter)
skipConn = UserInputService.InputBegan:Connect(function(input: InputObject)
	if os.clock() - startedAt < timing.SkipAfter then
		return
	end
	local kind = input.UserInputType
	if
		kind == Enum.UserInputType.MouseButton1
		or kind == Enum.UserInputType.Touch
		or kind == Enum.UserInputType.Keyboard
		or string.sub(kind.Name, 1, 7) == "Gamepad"
	then
		finish()
	end
end)

-- ContentProvider nur für die eigene Oberfläche (Schriften der Splash)
task.spawn(function()
	pcall(function()
		ContentProvider:PreloadAsync({ gui })
	end)
	preloadDone = true
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="4">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">AssetSlot</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Hybrid-Asset-Plätze (Shared/AssetSlot)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C6.1 + §C14.3 (Besitzer-Wunsch 17).
--  Alles funktioniert OHNE hochgeladene Assets: 0 = Code-Rezept. Ist eine Id gesetzt und lädt sie, wird das
--  echte MeshPart/Bild/Sound benutzt – fehlt sie oder schlägt das Laden fehl, automatisch das Rezept.
--
--  Öffentliche API:
--    AssetSlot.IsSet(slot?): boolean                      MeshId ist eine gültige Id (> 0, ganzzahlig)
--    AssetSlot.Mesh(key, slot?, recipe): Instance          Vorlage aus ReplicatedStorage.AssetCache[key] (oder gleicher
--        Inhalt unter anderem Schlüssel) -> Model mit dem MeshPart (Size × Scale, CFrame = Offset, WorldPivot = identity,
--        also dieselbe Pivot-Konvention wie ein Rezept-Model mit Ursprung im Pivot). Keine Vorlage / 0 / Fehler -> recipe().
--        YIELDET NIE: fehlt auf dem Server die Vorlage, startet das Laden im Hintergrund (CreateMeshPartAsync, pcall);
--        der nächste Bau nutzt sie. Normalfall: PreloadServer hat beim Start schon alles geladen.
--    AssetSlot.Image(id?, fallback?): string               "rbxassetid://<id>" oder fallback ("" = Code-Grafik)
--    AssetSlot.SoundId(id?): string?                       nil = Sfx-Rezept
--    AssetSlot.PreloadServer(slots)                        nur Server; lädt alle gesetzten Mesh-Plätze parallel nach
--        ReplicatedStorage.AssetCache/<Key> (Attribute MeshId/TextureId), wartet höchstens 12 s. Yieldet.
--    AssetSlot.Verify(ids, onFail)                         ContentProvider:PreloadAsync mit Status-Callback; Failure/
--        TimedOut -> onFail(id) (Bild/Sound dann auf Code-Grafik bzw. Rezept umschalten). Yieldet.
--    AssetSlot.KeyOf(child, entryKey): string              Schlüssel-Konvention "<Config-Kind>.<Eintrag>", z. B.
--        "Vehicles.LamCity", "Tower.Crane", "City.Blimp"
--    AssetSlot.CollectFromConfig(config): { [string]: AssetSlot }   alle gesetzten Mesh-Plätze aus den Config-Kindern
--        (Einträge mit Key + Asset und Assets = { Name = Slot }); Main.server lädt damit beim Start vor.
-- =====================================================================

local AssetService = game:GetService("AssetService")
local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Types = require(script.Parent:WaitForChild("Types"))

type Slot = Types.AssetSlot

local AssetSlot = {}

local CACHE_NAME = "AssetCache"
local PRELOAD_TIMEOUT = 12 -- Sekunden, die der Server-Start höchstens auf Mesh-Vorlagen wartet
local MAX_SLOTS = 512 -- Obergrenze je Vorlade-Runde / Suche
local MAX_VERIFY = 200
local MAX_DEPTH = 6
local LOG_GAP = 30

local loading: { [string]: boolean } = {} -- Schlüssel -> Laden läuft
local failed: { [string]: boolean } = {} -- Inhalts-Schlüssel -> Laden fehlgeschlagen (dieser Server versucht es nicht erneut)
local lastLog = -math.huge

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function validId(n: any): boolean
	return type(n) == "number" and n == n and n > 0 and n < 2 ^ 53 and n % 1 == 0
end

local function idText(n: number): string
	return string.format("%.0f", n)
end

local function logOnce(text: string)
	local now = os.clock()
	if now - lastLog >= LOG_GAP then
		lastLog = now
		warn("[AssetSlot] " .. text)
	end
end

function AssetSlot.IsSet(slot: Slot?): boolean
	return type(slot) == "table" and validId((slot :: any).MeshId)
end

local function textureOf(slot: Slot): number
	local tex = (slot :: any).TextureId
	return if validId(tex) then tex else 0
end

local function scaleOf(slot: Slot): number
	local s = (slot :: any).Scale
	if type(s) ~= "number" or s ~= s or s <= 0 or s == math.huge then
		return 1
	end
	return math.clamp(s, 0.01, 100)
end

local function offsetOf(slot: Slot): CFrame
	local o = (slot :: any).Offset
	return if typeof(o) == "CFrame" then o else CFrame.identity
end

local function contentKey(slot: Slot): string
	return "M" .. idText((slot :: any).MeshId) .. "_T" .. idText(textureOf(slot))
end

local function cacheFolder(create: boolean): Folder?
	local existing = ReplicatedStorage:FindFirstChild(CACHE_NAME)
	if existing and existing:IsA("Folder") then
		return existing
	end
	if not create then
		return nil
	end
	if existing then
		existing.Name = CACHE_NAME .. "_Alt" -- falsches Objekt mit dem Namen -> umbenennen statt Fehler
	end
	local folder = Instance.new("Folder")
	folder.Name = CACHE_NAME
	folder.Parent = ReplicatedStorage
	return folder
end

local function matches(template: Instance, slot: Slot): boolean
	return template:IsA("MeshPart")
		and template:GetAttribute("MeshId") == (slot :: any).MeshId
		and (template:GetAttribute("TextureId") or 0) == textureOf(slot)
end

-- Vorlage unter dem Schlüssel – oder (Schlüssel anders geschrieben) mit gleichem Inhalt
local function findTemplate(key: string, slot: Slot): MeshPart?
	local folder = cacheFolder(false)
	if not folder then
		return nil
	end
	local byKey = folder:FindFirstChild(key)
	if byKey and matches(byKey, slot) then
		return byKey :: MeshPart
	end
	local children = folder:GetChildren()
	for i = 1, math.min(#children, MAX_SLOTS) do
		local child = children[i]
		if matches(child, slot) then
			return child :: MeshPart
		end
	end
	return nil
end

local function buildFromTemplate(key: string, template: MeshPart, slot: Slot): Model
	local model = Instance.new("Model")
	model.Name = key
	local part = template:Clone()
	part.Size = part.Size * scaleOf(slot)
	part.CFrame = offsetOf(slot)
	part.Parent = model
	model.WorldPivot = CFrame.identity
	model:SetAttribute("AssetSlot", true)
	return model
end

-- ---------------------------------------------------------------------
-- 2) LADEN (nur Server; yieldet)
-- ---------------------------------------------------------------------
local function loadTemplate(key: string, slot: Slot): boolean
	local content = contentKey(slot)
	if failed[content] then
		return false
	end
	local meshId = (slot :: any).MeshId :: number
	local ok, result = pcall(function()
		return AssetService:CreateMeshPartAsync("rbxassetid://" .. idText(meshId))
	end)
	if not ok or typeof(result) ~= "Instance" or not result:IsA("MeshPart") then
		failed[content] = true
		logOnce(
			("Mesh %s (%s) konnte nicht geladen werden – Code-Rezept bleibt: %s"):format(
				idText(meshId),
				key,
				tostring(result)
			)
		)
		return false
	end
	local part = result :: MeshPart
	local texture = textureOf(slot)
	if texture > 0 then
		part.TextureID = "rbxassetid://" .. idText(texture)
	end
	part.Name = key
	part.Anchored = true
	part:SetAttribute("MeshId", meshId)
	part:SetAttribute("TextureId", texture)
	local folder = cacheFolder(true) :: Folder
	local old = folder:FindFirstChild(key)
	if old then
		old:Destroy() -- alte Vorlage (Config geändert) ersetzen
	end
	part.Parent = folder
	return true
end

local function startBackgroundLoad(key: string, slot: Slot)
	if loading[key] or failed[contentKey(slot)] then
		return
	end
	loading[key] = true
	task.spawn(function()
		local ok, err = pcall(loadTemplate, key, slot)
		if not ok then
			logOnce("Laden fehlgeschlagen (" .. key .. "): " .. tostring(err))
		end
		loading[key] = nil
	end)
end

-- ---------------------------------------------------------------------
-- 3) ÖFFENTLICHE API
-- ---------------------------------------------------------------------
function AssetSlot.KeyOf(child: string, entryKey: string): string
	return tostring(child) .. "." .. tostring(entryKey)
end

function AssetSlot.Mesh(key: string, slot: Slot?, recipe: () -> Instance): Instance
	if type(key) == "string" and slot ~= nil and AssetSlot.IsSet(slot) then
		local template = findTemplate(key, slot)
		if template then
			local ok, model = pcall(buildFromTemplate, key, template, slot)
			if ok then
				return model
			end
			logOnce("Vorlage " .. key .. " nicht nutzbar: " .. tostring(model))
		elseif RunService:IsServer() then
			startBackgroundLoad(key, slot)
		end
	end
	return recipe()
end

function AssetSlot.Image(id: number?, fallback: string?): string
	if validId(id) then
		return "rbxassetid://" .. idText(id :: number)
	end
	return if type(fallback) == "string" then fallback else ""
end

function AssetSlot.SoundId(id: number?): string?
	if validId(id) then
		return "rbxassetid://" .. idText(id :: number)
	end
	return nil
end

function AssetSlot.PreloadServer(slots: { [string]: Slot })
	if not RunService:IsServer() or type(slots) ~= "table" then
		return
	end
	local pending = 0
	local count = 0
	for key, slot in pairs(slots) do
		if count >= MAX_SLOTS then
			logOnce("zu viele Asset-Plätze – Rest wird bei Bedarf geladen")
			break
		end
		if type(key) == "string" and AssetSlot.IsSet(slot) and not findTemplate(key, slot) and not loading[key] then
			count += 1
			pending += 1
			loading[key] = true
			task.spawn(function()
				local ok, err = pcall(loadTemplate, key, slot)
				if not ok then
					logOnce("Vorladen fehlgeschlagen (" .. key .. "): " .. tostring(err))
				end
				loading[key] = nil
				pending -= 1
			end)
		end
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < PRELOAD_TIMEOUT do
		task.wait(0.1)
	end
	if pending > 0 then
		logOnce(
			("%d Mesh-Vorlage(n) nach %d s noch nicht fertig – werden nachgereicht"):format(pending, PRELOAD_TIMEOUT)
		)
	end
end

function AssetSlot.Verify(ids: { string }, onFail: (id: string) -> ())
	if type(ids) ~= "table" or type(onFail) ~= "function" then
		return
	end
	local list: { string } = {}
	for i, id in ipairs(ids) do
		if i > MAX_VERIFY then
			break
		end
		if type(id) == "string" and id ~= "" then
			table.insert(list, id)
		end
	end
	if #list == 0 then
		return
	end
	local reported: { [string]: boolean } = {}
	local function report(id: string)
		if reported[id] then
			return
		end
		reported[id] = true
		task.spawn(function()
			local ok, err = pcall(onFail :: (string) -> any, id)
			if not ok then
				logOnce("onFail-Fehler: " .. tostring(err))
			end
		end)
	end
	local ok = pcall(function()
		ContentProvider:PreloadAsync(list, function(contentId: string, status: Enum.AssetFetchStatus)
			if status == Enum.AssetFetchStatus.Failure or status == Enum.AssetFetchStatus.TimedOut then
				report(contentId)
			end
		end)
	end)
	if not ok then
		-- ContentProvider nicht erreichbar -> sicher auf Code-Grafik/Rezept
		for _, id in ipairs(list) do
			report(id)
		end
	end
end

-- Sammelt alle gesetzten Mesh-Plätze aus den Config-Kindern (Schlüssel siehe KeyOf).
function AssetSlot.CollectFromConfig(config: { [string]: any }): { [string]: Slot }
	local out: { [string]: Slot } = {}
	if type(config) ~= "table" then
		return out
	end
	local visited: { [any]: boolean } = {}
	local count = 0
	local function add(key: string, slot: any)
		if count < MAX_SLOTS and out[key] == nil and AssetSlot.IsSet(slot) then
			out[key] = slot
			count += 1
		end
	end
	local function walk(child: string, t: { [any]: any }, depth: number)
		if depth > MAX_DEPTH or visited[t] then
			return
		end
		visited[t] = true
		if type(t.Key) == "string" and type(t.Asset) == "table" then
			add(AssetSlot.KeyOf(child, t.Key), t.Asset)
		end
		if type(t.Assets) == "table" then
			for name, slot in pairs(t.Assets) do
				if type(name) == "string" and type(slot) == "table" then
					add(AssetSlot.KeyOf(child, name), slot)
				end
			end
		end
		for _, value in pairs(t) do
			if type(value) == "table" then
				walk(child, value, depth + 1)
			end
		end
	end
	for name, value in pairs(config) do
		if type(name) == "string" and type(value) == "table" then
			walk(name, value, 1)
		end
	end
	return out
end

return AssetSlot
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Clock</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Globale Spieluhr: Tick, Börsentag, Woche, Tageszeit, Berlin-Zeit (Shared/Clock)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C6.1, §A4 (Tag/Nacht), §B10.4 (Berlin-Kalender),
--  MARKET.md §3 (Tick = floor(unixMs/1000) − EPOCH).
--  Reines Modul: lädt keine Roblox-Dienste beim require -> mit der Luau-CLI testbar (tests/clock.test.luau).
--  Alle Server rechnen dasselbe (deterministisch aus der Weltzeit) – nie lokale Zeitzonen von os.date.
--
--  Öffentliche API:
--    Clock.EPOCH            1767571200 (Mo 2026-01-05 00:00 UTC)
--    Clock.DAY_TICKS        1200 (ein Börsentag = 20 min = ein Tag/Nacht-Zyklus)
--    Clock.WEEK_TICKS       604800 (7 echte Tage = 504 Börsentage, Wechsel Mo 00:00 UTC)
--    Clock.Now(): number    Server: DateTime.now().UnixTimestampMillis/1000 · Client: workspace:GetServerTimeNow()
--                           (ohne Roblox, z. B. Luau-CLI: os.time())
--    Clock.Tick(): number   floor(Now()) − EPOCH
--    Clock.DayIndex(tick)   Börsentag-Index (floor(tick / 1200))
--    Clock.DayMinute(tick)  Minute im Börsentag, 0 ≤ x < 20 (mit Bruchteil: Sekunde 30 -> 0,5)
--    Clock.WeekIndex(tick)  Woche seit EPOCH      Clock.WeekStartTick(week): erster Tick der Woche
--    Clock.ClockTime(tick)  Tageszeit der Welt (Lighting.ClockTime, §A4: :00 6,5 · :06 12 · :12 18,5 ·
--                           :12,5–:18,5 Nacht 21 → 4 · :19,5 Dämmerung 5,5)
--    Clock.IsNight(tick)    true ab Sonnenuntergang (ClockTime ≥ 18,5) bis kurz vor Sonnenaufgang (< 6)
--    Clock.BerlinOffset(unix): number   3600 oder 7200 (EU-Regel: +2 h vom letzten So im März 01:00 UTC
--                           bis zum letzten So im Oktober 01:00 UTC)
--    Clock.NextBerlin(dow?, hh, mm, afterUnix): number   nächster Unix-Zeitpunkt STRIKT nach afterUnix, an dem
--                           in Berlin dow hh:mm ist (dow 1 = Mo … 7 = So, nil = täglich)
--    Clock.TickOf(unix): number    floor(unix) − EPOCH        Clock.UnixOf(tick): number   tick + EPOCH
--    Clock.Weekday(unix): number   1 = Mo … 7 = So (UTC-Kalendertag)
-- =====================================================================

local Clock = {}

Clock.EPOCH = 1767571200
Clock.DAY_TICKS = 1200
Clock.WEEK_TICKS = 604800

local DAY_MINUTES = Clock.DAY_TICKS / 60 -- 20
local SECONDS_PER_DAY = 86400
local HUGE = math.huge

local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= HUGE and n ~= -HUGE
end

local function num(n: any): number
	return if finite(n) then n else 0
end

-- ---------------------------------------------------------------------
-- 1) ZEITQUELLE (einmal bestimmt, danach gecacht)
-- ---------------------------------------------------------------------
local nowFn: (() -> number)? = nil

local function resolveNow(): () -> number
	local ok, fn = pcall(function(): () -> number
		local RunService = game:GetService("RunService")
		if RunService:IsServer() then
			return function(): number
				return DateTime.now().UnixTimestampMillis / 1000
			end
		end
		return function(): number
			return workspace:GetServerTimeNow()
		end
	end)
	if ok and type(fn) == "function" then
		return fn
	end
	-- Luau-CLI / Tests: keine Roblox-Dienste
	return function(): number
		return os.time()
	end
end

function Clock.Now(): number
	local fn: () -> number = nowFn or resolveNow()
	nowFn = fn
	local value = fn()
	return if finite(value) then value else os.time()
end

function Clock.Tick(): number
	return math.floor(Clock.Now()) - Clock.EPOCH
end

function Clock.TickOf(unix: number): number
	return math.floor(num(unix)) - Clock.EPOCH
end

function Clock.UnixOf(tick: number): number
	return num(tick) + Clock.EPOCH
end

-- ---------------------------------------------------------------------
-- 2) BÖRSENTAG & WOCHE
-- ---------------------------------------------------------------------
function Clock.DayIndex(tick: number): number
	return math.floor(num(tick) / Clock.DAY_TICKS)
end

function Clock.DayMinute(tick: number): number
	local t = num(tick)
	local within = t - math.floor(t / Clock.DAY_TICKS) * Clock.DAY_TICKS
	local minute = within / 60
	if minute < 0 or minute >= DAY_MINUTES then
		return 0 -- Rundungsrest an der Tagesgrenze
	end
	return minute
end

function Clock.WeekIndex(tick: number): number
	return math.floor(num(tick) / Clock.WEEK_TICKS)
end

function Clock.WeekStartTick(week: number): number
	return math.floor(num(week)) * Clock.WEEK_TICKS
end

-- ---------------------------------------------------------------------
-- 3) TAGESZEIT DER WELT (§A4) – stückweise linear, Werte über 24 werden umgebrochen
-- ---------------------------------------------------------------------
local KNOTS: { { number } } = {
	{ 0, 6.5 }, -- Sonnenaufgang + Glocke
	{ 6, 12 }, -- Mittag
	{ 12, 18.5 }, -- Sonnenuntergang (Fensterlichter an)
	{ 12.5, 21 }, -- Nacht beginnt
	{ 18.5, 28 }, -- 04:00
	{ 19.5, 29.5 }, -- Dämmerung 05:30
	{ 20, 30.5 }, -- = 06:30 des nächsten Börsentags
}

function Clock.ClockTime(tick: number): number
	local m = Clock.DayMinute(tick)
	for i = 2, #KNOTS do
		local a, b = KNOTS[i - 1], KNOTS[i]
		if m <= b[1] then
			local f = (m - a[1]) / (b[1] - a[1])
			return (a[2] + (b[2] - a[2]) * f) % 24
		end
	end
	return KNOTS[1][2]
end

function Clock.IsNight(tick: number): boolean
	local ct = Clock.ClockTime(tick)
	return ct >= 18.5 or ct < 6
end

-- ---------------------------------------------------------------------
-- 4) KALENDER (UTC, ohne os.date) – Algorithmen von H. Hinnant
-- ---------------------------------------------------------------------
local function civilFromDays(days: number): (number, number, number)
	local z = days + 719468
	local era = math.floor(z / 146097)
	local doe = z - era * 146097
	local yoe = math.floor((doe - math.floor(doe / 1460) + math.floor(doe / 36524) - math.floor(doe / 146096)) / 365)
	local doy = doe - (365 * yoe + math.floor(yoe / 4) - math.floor(yoe / 100))
	local mp = math.floor((5 * doy + 2) / 153)
	local d = doy - math.floor((153 * mp + 2) / 5) + 1
	local m = if mp < 10 then mp + 3 else mp - 9
	local y = yoe + era * 400 + (if m <= 2 then 1 else 0)
	return y, m, d
end

local function daysFromCivil(year: number, month: number, day: number): number
	local y = year - (if month <= 2 then 1 else 0)
	local era = math.floor(y / 400)
	local yoe = y - era * 400
	local mp = (month + 9) % 12
	local doy = math.floor((153 * mp + 2) / 5) + day - 1
	local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
	return era * 146097 + doe - 719468
end

-- 1 = Montag … 7 = Sonntag (1970-01-01 war ein Donnerstag)
local function weekdayOfDay(days: number): number
	return ((days + 3) % 7) + 1
end

function Clock.Weekday(unix: number): number
	return weekdayOfDay(math.floor(num(unix) / SECONDS_PER_DAY))
end

-- Unix-Zeit "letzter Sonntag des Monats, 01:00 UTC"
local function lastSundayOneUtc(year: number, month: number): number
	local firstOfNext = if month == 12 then daysFromCivil(year + 1, 1, 1) else daysFromCivil(year, month + 1, 1)
	local lastDay = firstOfNext - 1
	local sunday = lastDay - (weekdayOfDay(lastDay) % 7)
	return sunday * SECONDS_PER_DAY + 3600
end

-- ---------------------------------------------------------------------
-- 5) BERLIN-ZEIT (§B10.4) – Sommerzeit automatisch, auf allen Servern gleich
-- ---------------------------------------------------------------------
function Clock.BerlinOffset(unix: number): number
	if not finite(unix) then
		return 3600
	end
	local year = civilFromDays(math.floor(unix / SECONDS_PER_DAY))
	local summerStart = lastSundayOneUtc(year, 3)
	local summerEnd = lastSundayOneUtc(year, 10)
	if unix >= summerStart and unix < summerEnd then
		return 7200
	end
	return 3600
end

-- Ortszeit (Berlin) in Sekunden seit 1970 -> UTC. Nicht existierende Zeiten (Sprung im März) landen
-- eine Stunde später, doppelte Zeiten (Oktober) auf der zweiten (Winterzeit-)Variante.
local function berlinLocalToUtc(localSeconds: number): number
	local offset = Clock.BerlinOffset(localSeconds - 3600)
	local utc = localSeconds - offset
	local check = Clock.BerlinOffset(utc)
	if check ~= offset then
		utc = localSeconds - check
	end
	return utc
end

function Clock.NextBerlin(dow: number?, hh: number, mm: number, afterUnix: number): number
	local after = num(afterUnix)
	local hour = math.clamp(math.floor(num(hh)), 0, 23)
	local minute = math.clamp(math.floor(num(mm)), 0, 59)
	local wanted: number? = nil
	if dow ~= nil and finite(dow) and dow % 1 == 0 and dow >= 1 and dow <= 7 then
		wanted = dow
	end
	local localNow = after + Clock.BerlinOffset(after)
	local firstDay = math.floor(localNow / SECONDS_PER_DAY) - 1 -- ein Tag Puffer (Zeitumstellung)
	for day = firstDay, firstDay + 9 do -- höchstens 10 Kandidaten-Tage (Woche + Puffer)
		if wanted == nil or weekdayOfDay(day) == wanted then
			local utc = berlinLocalToUtc(day * SECONDS_PER_DAY + hour * 3600 + minute * 60)
			if utc > after then
				return utc
			end
		end
	end
	return after + 7 * SECONDS_PER_DAY -- nicht erreichbar (Sicherheitsnetz)
end

return Clock
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – ZENTRALE EINSTELLUNGEN (Shared/Config)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C14.1 + §C6.1 (CC-Stil).
--  Hier stellst du (fast) alles ein, ohne anderen Code anzufassen. Alle Zahlen sind Startwerte aus DESIGN.md
--  und 1:1 änderbar. ACHTUNG: Config wird an alle Clients repliziert -> KEINE Geheimnisse hier!
--
--  Kindmodule (werden automatisch geladen, jedes Paket pflegt sein eigenes, jedes exportiert Validate(Config)):
--    Security (WP1) · Client, Quality (WP2) · Market, Companies, News (WP3) · Trading (WP4) · Tower (WP6) ·
--    City, Vehicles (WP7) · Decor, Lifestyle (WP8) · Progression, Season, Rewards (WP9) · Shop (WP10) · Events (WP11)
--    -> erreichbar als Config.Market, Config.Tower, … Fehlt ein Kind: leere Tabelle + Meldung in Validate().
--
--  Öffentliche Helfer:
--    Config.Validate(): { string }        Kinder-Validate + eigene Prüfungen (MaxMoney, Ganzzahligkeit, Preise < 1e14,
--                                         Asset-Plätze typ-korrekt, LiveFields wohlgeformt). Leer = alles ok (SelfTest).
--    Config.ApplyLive(data): (number, { string })   LiveConfig aus AT_Live_v1 übernehmen: NUR Pfade aus
--                                         Config.LiveFields, geklemmt/geprüft. Jeder Aufruf setzt zuerst alle früher
--                                         geänderten Pfade auf den Code-Stand zurück (Ergebnis = Code + data).
--                                         data = { ["Pfad"] = Wert } oder { Fields = { … } }. Rückgabe: übernommen, Probleme.
--    Config.CurrentLive(): { [string]: any }   Kopie der gerade aktiven Live-Werte (für Admin-Panel/Replikation)
-- =====================================================================

local RunService = game:GetService("RunService")

local Shared = script.Parent
local Util = require(Shared:WaitForChild("Util"))

local Config = {}

Config.GameName = "AKYTEX TYCOON"
Config.Version = "1.0.0"

-- ---------------------------------------------------------------------
-- 1) ADMINS – NUR DU: Wem das Spiel gehört (dein Account bzw. der Besitzer deiner Gruppe), ist Admin.
--    Du musst hier nichts eintragen! Admin kann man NICHT kaufen – der Server prüft es bei jeder Aktion.
--    Im Studio-Test bist du Admin (Player1 = -1), Player2 (-2) bewusst NIE (§B15.1).
-- ---------------------------------------------------------------------
Config.Admin = {
	OwnerIsAdmin = true,
	GroupOwnerIsAdmin = true, -- Spiel unter einer Gruppe veröffentlicht -> Gruppen-Besitzer ist Admin
	StudioIsAdmin = true,
	StudioAllPlayersAdmin = false, -- false lassen, sonst ist der "Abgelehnt"-Weg nicht testbar
}

-- ---------------------------------------------------------------------
-- 2) TECHNIK (nur ändern, wenn du weißt was du tust)
--    DataStoreName oder KeyPrefix ändern = alle Spielstände sind weg!
-- ---------------------------------------------------------------------
Config.Tech = {
	DataStoreName = "AT_Player_v1",
	DataVersion = 1,
	KeyPrefix = "P_", -- Schlüssel P_<UserId>
	MessagingTopic = "AT_Global", -- Ansagen, Admin-Abuse (Nicht-Markt)
	BusTopic = "AT_EV", -- Schnellweg für neue Markt-Bus-Events
	AutoSaveSeconds = 90, -- Auto-Save aller Spielstände
	AutoSaveStagger = 0.5, -- Abstand zwischen zwei Spielern beim Auto-Save
	LoadAttempts = 6,
	SaveAttempts = 4,
	LockStaleSeconds = 1800, -- Session-Lock älter als 30 Min gilt als verwaist
	BindToCloseSeconds = 25, -- Roblox gibt beim Herunterfahren max. 30 s
	ReceiptKeep = 60, -- so viele Kauf-Belege bleiben im Spielstand
	StateFlush = 0.2, -- State an den Client höchstens alle 0,2 s (≤ 5 Pakete/s)
	FullStateEvery = 20, -- voller State als Sicherheitsnetz
	LiveStore = "AT_Live_v1",
	StatsStore = "AT_Stats_v1",
	ModStore = "AT_Mod_v1",
	MarketStore = "AT_Market_v1", -- Seed_W<w>, Close_W<w>, Ipo_S<s> (WP3)
	GlobalStore = "AT_Global", -- DataStore: Admin-Log-Kopie je Woche, Live-Kalender-Overrides (WP11)
	GroupsStore = "AT_Groups_v1", -- v1.1 Hedgefonds-Gruppen
	BusMapPrefix = "AT_Bus_W", -- MemoryStore SortedMap AT_Bus_W<w>: Markt-Admin-Events (Wahrheit, WP3)
	HeartbeatMap = "AT_Heartbeat", -- MemoryStore HashMap: Server-Herzschlag (Admin-Dashboard)
	Shards = 8,
	BoardPrefix = "AT_LB_",
	BoardWriteSeconds = 300,
	StatsFlushSeconds = 600,
	PingAttrEvery = 2, -- Attribut "PingMs" am Player alle 2 s
}

-- ---------------------------------------------------------------------
-- 3) STUDIO – Testen ohne Speichern, lokaler Testmarkt, Selbsttest
-- ---------------------------------------------------------------------
Config.Studio = {
	NoSave = true, -- im Studio nie speichern (Toast "Studio: Fortschritt wird nicht gespeichert")
	SelfTest = true, -- "[SelfTest] n/n PASS" im Output beim Start
	LocalMarket = true, -- ohne API-Zugriff: Markt mit Fallback-Seed ("Lokaler Testmarkt")
	BellZoneMinPlayers = 1, -- Glocken-Moment schon ab 1 Spieler (live: Config.Events.BellMoment.MinPlayers)
	SkipAccountAge = true, -- Respekt/Bau-Hilfe: AccountAge-Prüfung im Studio überspringen (§C17)
}

-- ---------------------------------------------------------------------
-- 4) DEBUG – auch im Admin-Panel (Tab Debug) umschaltbar
-- ---------------------------------------------------------------------
Config.Debug = {
	LogRejects = false, -- abgelehnte Anfragen mit Grund im Output
	ForceRestricted = false, -- so tun, als wären bezahlte Zufallsitems verboten (Policy-Test)
	ShowTriggers = false, -- Auslöse-Zonen (Kassen-Tor, Glocken-Zone, Pickups) sichtbar machen
}

-- ---------------------------------------------------------------------
-- 5) SERVER – Spieler, Plots, Geld-Obergrenze (Muss-Regel 9)
-- ---------------------------------------------------------------------
Config.Server = {
	MaxPlayers = 10, -- = Plots (in Studio unter Game Settings → Places ebenfalls 10 einstellen)
	Plots = 10,
	MaxMoney = 9e15, -- kein Kontostand/Preis/Bestenlisten-Wert ≥ 9e15 (Anzeige "MAX"), < 2^53
}

-- ---------------------------------------------------------------------
-- 6) FARBEN – Spiegel von UI.Theme für Server-SurfaceGuis (Ticker-Wände, Schilder, Bestenlisten)
-- ---------------------------------------------------------------------
Config.Colors = {
	Bg = Color3.fromRGB(11, 15, 23), -- #0b0f17
	Bg2 = Color3.fromRGB(15, 20, 29), -- #0f141d
	Surface = Color3.fromRGB(18, 24, 36), -- #121824
	Surface2 = Color3.fromRGB(26, 33, 48), -- #1a2130
	Hover = Color3.fromRGB(31, 40, 56), -- #1f2838
	Border = Color3.fromRGB(31, 41, 55), -- #1f2937
	Text = Color3.fromRGB(230, 236, 245), -- #e6ecf5
	Text2 = Color3.fromRGB(170, 180, 195), -- #aab4c3
	Muted = Color3.fromRGB(125, 136, 154), -- #7d889a
	Accent = Color3.fromRGB(79, 140, 255), -- #4f8cff
	AccentDeep = Color3.fromRGB(41, 98, 255), -- #2962ff
	Up = Color3.fromRGB(34, 197, 94), -- #22c55e
	Down = Color3.fromRGB(239, 68, 68), -- #ef4444
	Warn = Color3.fromRGB(234, 179, 8), -- #eab308
	Gold = Color3.fromRGB(250, 204, 21), -- #facc15 (nur Kronen, Glocke, Hall of Fame)
	Orange = Color3.fromRGB(245, 158, 11), -- #f59e0b (Farbenblind-Modus statt Down)
	Cosmic1 = Color3.fromRGB(59, 91, 219), -- #3b5bdb (Verlauf Premium/Penthouse)
	Cosmic2 = Color3.fromRGB(124, 92, 255), -- #7c5cff
	Cosmic3 = Color3.fromRGB(179, 107, 255), -- #b36bff
	LogoRing = Color3.fromRGB(110, 162, 242), -- #6ea2f2
	LogoLetters = Color3.fromRGB(234, 241, 255), -- #eaf1ff
	Sectors = {
		T = Color3.fromRGB(79, 140, 255), -- Tech #4f8cff
		E = Color3.fromRGB(34, 211, 238), -- Energie #22d3ee
		M = Color3.fromRGB(139, 92, 246), -- Mobilität #8b5cf6
		K = Color3.fromRGB(245, 158, 11), -- Konsum #f59e0b
		G = Color3.fromRGB(236, 72, 153), -- Gaming #ec4899
		F = Color3.fromRGB(250, 204, 21), -- Finanzen #facc15
	},
}

-- ---------------------------------------------------------------------
-- 7) BENACHRICHTIGUNGEN (Experience Notifications; Senden erst v1.1, §B11.9)
-- ---------------------------------------------------------------------
Config.Notifications = {
	Enabled = false,
	MaxPerDay = 1,
	PromptAfterStep = 17, -- Opt-in-Abfrage frühestens nach Tutorial-Schritt 17 (§B2)
}

-- ---------------------------------------------------------------------
-- 8) LIVE-CONFIG (AT_Live_v1, Admin-Tab „Live-Ops“) – NUR diese Pfade dürfen live geändert werden.
--    Formen:  { min, max }  bzw. { Type = "number", Min, Max, Integer = true }   Zahl, geklemmt
--             { Type = "boolean" }                                  true/false
--             { Type = "list", Options = {…}, Min = n, Max = n }    Liste von Texten (aus Options, ohne Doppelte)
--             { Type = "code", MaxCredits = n }                     Code-Eintrag: Grant nur Credits/Cosmetics, Expires
--    Pfade mit ".*" am Ende erlauben beliebige Schlüssel (Buchstaben/Ziffern/_, ≤ 40 Zeichen) darunter.
-- ---------------------------------------------------------------------
Config.LiveFields = {
	["Market.NewsMeanGap"] = { 300, 6000 }, -- News-Takt (Ticks zwischen Schlagzeilen je Instrument)
	["Events.Rotation"] = { Type = "list", Options = { "Truck", "Drones", "BuildBoom", "Press" }, Min = 1, Max = 4 },
	["Events.BoostPause"] = { Type = "boolean" }, -- Notschalter: Boosts pausieren
	["Events.BellMoment.Mult"] = { 1, 1.5 },
	["Events.BuildBoom.Pct"] = { 0.05, 0.5 },
	["Events.Truck.Bundles"] = { Type = "number", Min = 5, Max = 60, Integer = true },
	["Events.RainCoinsMax"] = { Type = "number", Min = 5, Max = 30, Integer = true },
	["Tower.Mult.Bull"] = { 1, 2 }, -- Boost-Werte (Deckel ×10 gilt immer zusätzlich)
	["Tower.Mult.Parade"] = { 1, 2 },
	["Tower.Mult.BellMoment"] = { 1, 1.5 },
	["Tower.Mult.EventMax"] = { 1, 3 },
	["Shop.Disabled.*"] = { Type = "boolean" }, -- Notschalter: Produkt/Pass deaktivieren
	["Rewards.Codes.*"] = { Type = "code", MaxCredits = 1000000 }, -- Codes nur CR/Kosmetik (Firewall)
}

-- =====================================================================
-- 9) KINDMODULE – dynamisch geladen (fehlt eins, gibt es eine leere Tabelle
--    und Config.Validate() meldet es; der Rest läuft weiter)
-- =====================================================================
local CHILDREN = {
	"Security",
	"Client",
	"Quality",
	"Market",
	"Companies",
	"News",
	"Trading",
	"Tower",
	"City",
	"Vehicles",
	"Decor",
	"Lifestyle",
	"Progression",
	"Season",
	"Rewards",
	"Shop",
	"Events",
}

-- Client: erst warten, bis die erste Replikation fertig ist (sonst fehlen Kindmodule evtl. noch)
if RunService:IsClient() and not RunService:IsServer() and not game:IsLoaded() then
	game.Loaded:Wait()
end

local children: { [string]: { [string]: any } } = {}
local loadErrors: { [string]: string } = {}

local function loadChild(name: string): { [string]: any }
	local module = script:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		loadErrors[name] = "Modul fehlt"
		children[name] = {}
		return children[name]
	end
	local ok, result = pcall(require, module)
	if not ok then
		loadErrors[name] = "Fehler beim Laden: " .. tostring(result)
		warn("[Config] Config." .. name .. " konnte nicht geladen werden: " .. tostring(result))
		result = {}
	elseif type(result) ~= "table" then
		loadErrors[name] = "gibt keine Tabelle zurück"
		warn("[Config] Config." .. name .. " gibt keine Tabelle zurück")
		result = {}
	end
	children[name] = result
	return result
end

Config.Security = loadChild("Security")
Config.Client = loadChild("Client")
Config.Quality = loadChild("Quality")
Config.Market = loadChild("Market")
Config.Companies = loadChild("Companies")
Config.News = loadChild("News")
Config.Trading = loadChild("Trading")
Config.Tower = loadChild("Tower")
Config.City = loadChild("City")
Config.Vehicles = loadChild("Vehicles")
Config.Decor = loadChild("Decor")
Config.Lifestyle = loadChild("Lifestyle")
Config.Progression = loadChild("Progression")
Config.Season = loadChild("Season")
Config.Rewards = loadChild("Rewards")
Config.Shop = loadChild("Shop")
Config.Events = loadChild("Events")

-- =====================================================================
-- 10) LIVE-CONFIG ÜBERNEHMEN (ApplyLive)
-- =====================================================================
local MAX_LIVE_FIELDS = 256
local MAX_LIST = 16
local MAX_KEY_LEN = 40
local MAX_CODE_COSMETICS = 10
local MAX_TRACKED_PATHS = 1024 -- Obergrenze gemerkter Code-Stände (Wildcard-Schlüssel)

local liveBase: { [string]: { Value: any } } = {} -- Pfad -> Code-Wert vor der ersten Live-Änderung
local liveCurrent: { [string]: any } = {}
local trackedPaths = 0

local function splitPath(path: string): { string }
	local parts: { string } = {}
	for part in string.gmatch(path, "[^%.]+") do
		table.insert(parts, part)
		if #parts > 8 then
			break
		end
	end
	return parts
end

-- Eltern-Tabelle + Blatt-Schlüssel eines Pfads (Zwischen-Tabellen werden NIE angelegt)
local function resolveParent(path: string): ({ [string]: any }?, string?)
	local parts = splitPath(path)
	if #parts < 2 then
		return nil, nil
	end
	local node: any = Config
	for i = 1, #parts - 1 do
		node = node[parts[i]]
		if type(node) ~= "table" then
			return nil, nil
		end
	end
	return node, parts[#parts]
end

local function validKey(key: any): boolean
	return type(key) == "string" and #key >= 1 and #key <= MAX_KEY_LEN and string.match(key, "^[%w_]+$") ~= nil
end

-- Spezifikation zu einem Pfad: exakt oder über "Eltern.*"
local function specFor(path: string): (any, string?)
	local exact = Config.LiveFields[path]
	if exact ~= nil then
		return exact, nil
	end
	local parent, leaf = string.match(path, "^(.+)%.([^%.]+)$")
	if parent and leaf and validKey(leaf) then
		local wildcard = Config.LiveFields[parent .. ".*"]
		if wildcard ~= nil then
			return wildcard, leaf
		end
	end
	return nil, nil
end

local function numberBounds(spec: any): (number?, number?, boolean)
	if type(spec) ~= "table" then
		return nil, nil, false
	end
	local lo = if spec.Type == "number" then spec.Min else spec[1]
	local hi = if spec.Type == "number" then spec.Max else spec[2]
	if Util.IsFinite(lo) and Util.IsFinite(hi) and lo <= hi then
		return lo, hi, spec.Integer == true
	end
	return nil, nil, false
end

local function isIsoDate(text: any): boolean
	return type(text) == "string" and string.match(text, "^%d%d%d%d%-%d%d%-%d%dT%d%d:%d%d:%d%dZ$") ~= nil
end

-- Prüft/klemmt einen Live-Wert. Gibt (ok, sauberer Wert) zurück; Wert nil = Eintrag entfernen.
local function cleanValue(spec: any, value: any, current: any): (boolean, any)
	if type(spec) ~= "table" then
		return false, nil
	end
	local kind = spec.Type
	if kind == "boolean" then
		if type(value) ~= "boolean" then
			return false, nil
		end
		return true, value
	elseif kind == "list" then
		if type(value) ~= "table" then
			return false, nil
		end
		local minLen = if Util.IsFinite(spec.Min) then spec.Min else 1
		local maxLen = math.min(if Util.IsFinite(spec.Max) then spec.Max else MAX_LIST, MAX_LIST)
		local allowed: { [string]: boolean }? = nil
		if type(spec.Options) == "table" then
			allowed = {}
			for _, option in ipairs(spec.Options) do
				(allowed :: any)[option] = true
			end
		end
		local clean: { string } = {}
		local seen: { [string]: boolean } = {}
		for index, item in ipairs(value) do
			if index > maxLen or not validKey(item) or seen[item] then
				return false, nil
			end
			if allowed and not allowed[item] then
				return false, nil
			end
			seen[item] = true
			table.insert(clean, item)
		end
		if #clean < minLen then
			return false, nil
		end
		return true, clean
	elseif kind == "code" then
		if value == false then
			return true, nil -- Code live abschalten
		end
		if type(value) ~= "table" or type(value.Grant) ~= "table" then
			return false, nil
		end
		local maxCredits = if Util.IsFinite(spec.MaxCredits) then spec.MaxCredits else 0
		local grant: { [string]: any } = {}
		local any = false
		for field, amount in pairs(value.Grant) do
			if field == "Credits" then
				if not Util.IsFinite(amount) or amount % 1 ~= 0 or amount < 1 or amount > maxCredits then
					return false, nil
				end
				grant.Credits = amount
				any = true
			elseif field == "Cosmetics" then
				if type(amount) ~= "table" or #amount > MAX_CODE_COSMETICS then
					return false, nil
				end
				local list: { string } = {}
				for _, key in ipairs(amount) do
					if not validKey(key) then
						return false, nil
					end
					table.insert(list, key)
				end
				if #list > 0 then
					grant.Cosmetics = list
					any = true
				end
			else
				return false, nil -- Codes geben NUR CR oder Kosmetik (nie AKY/XP/Lizenz …)
			end
		end
		if not any then
			return false, nil
		end
		local entry: { [string]: any } = { Grant = grant }
		if value.Expires ~= nil then
			if not isIsoDate(value.Expires) then
				return false, nil
			end
			entry.Expires = value.Expires
		end
		return true, entry
	end
	-- Zahl
	local lo, hi, integer = numberBounds(spec)
	if lo == nil or hi == nil or not Util.IsFinite(value) then
		return false, nil
	end
	if current ~= nil and type(current) ~= "number" then
		return false, nil -- Code-Wert ist keine Zahl -> nicht überschreiben
	end
	local v = math.clamp(value, lo, hi)
	if integer then
		v = math.clamp(math.floor(v + 0.5), math.ceil(lo), math.floor(hi))
	end
	return true, v
end

function Config.ApplyLive(data: { [string]: any }): (number, { string })
	-- 1) alles früher Geänderte auf den Code-Stand zurück
	for path, base in pairs(liveBase) do
		local parent, leaf = resolveParent(path)
		if parent and leaf then
			parent[leaf] = Util.DeepCopy(base.Value)
		end
	end
	table.clear(liveCurrent)
	local issues: { string } = {}
	if type(data) ~= "table" then
		table.insert(issues, "LiveConfig: Tabelle erwartet")
		return 0, issues
	end
	local fields: { [any]: any } = if type(data.Fields) == "table" then data.Fields else data
	local applied = 0
	local seen = 0
	for path, value in pairs(fields) do
		if type(path) ~= "string" or not string.find(path, ".", 1, true) then
			continue -- Metadaten (Version, At, By …)
		end
		seen += 1
		if seen > MAX_LIVE_FIELDS then
			table.insert(issues, ("LiveConfig: mehr als %d Felder – Rest ignoriert"):format(MAX_LIVE_FIELDS))
			break
		end
		local spec = specFor(path)
		if spec == nil then
			table.insert(issues, path .. ": nicht in Config.LiveFields freigegeben")
			continue
		end
		local parent, leaf = resolveParent(path)
		if not parent or not leaf then
			table.insert(issues, path .. ": Pfad existiert nicht")
			continue
		end
		local base = liveBase[path]
		if base == nil and trackedPaths >= MAX_TRACKED_PATHS then
			table.insert(issues, path .. ": zu viele Live-Pfade")
			continue
		end
		local current = if base then base.Value else parent[leaf]
		local ok, clean = cleanValue(spec, value, current)
		if not ok then
			table.insert(issues, path .. ": ungültiger Wert")
			continue
		end
		if base == nil then
			liveBase[path] = { Value = Util.DeepCopy(parent[leaf]) }
			trackedPaths += 1
		end
		parent[leaf] = clean
		liveCurrent[path] = Util.DeepCopy(clean)
		applied += 1
	end
	return applied, issues
end

function Config.CurrentLive(): { [string]: any }
	return Util.DeepCopy(liveCurrent)
end

-- =====================================================================
-- 11) PRÜFEN – SelfTest und Boot-warn nutzen das (leere Liste = alles ok)
-- =====================================================================
local PRICE_LIMIT = 1e14 -- teuerster Einzelpreis laut Sim 4,9e13 (§C17 "alle Preise < 1e14 ganzzahlig")
local SCAN_DEPTH = 8
local SCAN_MAX_NODES = 20000
local MONEY_KEYS = { Price = true, Credits = true }
local ID_KEYS = { ImageId = true, SoundId = true }

local function checkNumber(errors: { string }, path: string, value: any, min: number?, integer: boolean?)
	if not Util.IsFinite(value) then
		table.insert(errors, path .. ": Zahl erwartet")
	elseif min ~= nil and value < min then
		table.insert(errors, ("%s: mindestens %s erwartet"):format(path, tostring(min)))
	elseif integer and value % 1 ~= 0 then
		table.insert(errors, path .. ": ganze Zahl erwartet")
	end
end

local function checkText(errors: { string }, path: string, value: any)
	if type(value) ~= "string" or value == "" or #value > 50 then
		table.insert(errors, path .. ": Text (1–50 Zeichen) erwartet")
	end
end

local function checkColors(errors: { string }, path: string, t: any)
	if type(t) ~= "table" then
		table.insert(errors, path .. ": Tabelle erwartet")
		return
	end
	for key, value in pairs(t) do
		if type(value) == "table" then
			checkColors(errors, path .. "." .. tostring(key), value)
		elseif typeof(value) ~= "Color3" then
			table.insert(errors, path .. "." .. tostring(key) .. ": Color3 erwartet")
		end
	end
end

local function isId(value: any): boolean
	return Util.IsFinite(value) and value >= 0 and value % 1 == 0 and value < 2 ^ 53
end

local function checkSlot(errors: { string }, path: string, slot: any)
	if type(slot) ~= "table" then
		table.insert(errors, path .. ": Asset-Platz { MeshId, TextureId, Scale, Offset } erwartet")
		return
	end
	if not isId(slot.MeshId) then
		table.insert(errors, path .. ".MeshId: ganze Zahl ≥ 0 erwartet (0 = Code-Rezept)")
	end
	if not isId(slot.TextureId) then
		table.insert(errors, path .. ".TextureId: ganze Zahl ≥ 0 erwartet")
	end
	if not Util.IsFinite(slot.Scale) or slot.Scale <= 0 then
		table.insert(errors, path .. ".Scale: Zahl > 0 erwartet")
	end
	if typeof(slot.Offset) ~= "CFrame" then
		table.insert(errors, path .. ".Offset: CFrame erwartet")
	end
end

-- Durchsucht alle Kinder: Preise/Credits ganzzahlig und < 1e14, Asset-/Bild-/Sound-Plätze typ-korrekt
local function scanChildren(errors: { string })
	local visited: { [any]: boolean } = {}
	local nodes = 0
	local function walk(path: string, t: { [any]: any }, depth: number)
		if depth > SCAN_DEPTH or visited[t] or nodes >= SCAN_MAX_NODES then
			return
		end
		visited[t] = true
		nodes += 1
		for key, value in pairs(t) do
			local here = path .. "." .. tostring(key)
			if type(key) == "string" and MONEY_KEYS[key] and type(value) == "number" then
				if not Util.IsFinite(value) or value < 0 or value % 1 ~= 0 then
					table.insert(errors, here .. ": ganze Zahl ≥ 0 erwartet")
				elseif value >= PRICE_LIMIT then
					table.insert(errors, here .. (": %s ≥ 1e14 (Preis-/Geld-Obergrenze)"):format(tostring(value)))
				end
			elseif type(key) == "string" and ID_KEYS[key] then
				if not isId(value) then
					table.insert(errors, here .. ": ganze Zahl ≥ 0 erwartet (0 = Code-Grafik/Rezept)")
				end
			elseif key == "Asset" then
				checkSlot(errors, here, value)
			elseif key == "Assets" and type(value) == "table" then
				for name, slot in pairs(value) do
					checkSlot(errors, here .. "." .. tostring(name), slot)
				end
			elseif type(value) == "table" then
				walk(here, value, depth + 1)
			end
		end
	end
	for _, name in ipairs(CHILDREN) do
		local child = children[name]
		if type(child) == "table" and loadErrors[name] == nil then
			walk("Config." .. name, child, 1)
		end
	end
end

local function validateLiveFields(errors: { string })
	if type(Config.LiveFields) ~= "table" then
		table.insert(errors, "Config.LiveFields: Tabelle erwartet")
		return
	end
	for path, spec in pairs(Config.LiveFields) do
		local where = "Config.LiveFields[" .. tostring(path) .. "]"
		if type(path) ~= "string" or #splitPath(path) < 2 or type(spec) ~= "table" then
			table.insert(errors, where .. ": Pfad mit Punkt und Spezifikation erwartet")
			continue
		end
		local kind = spec.Type
		if kind == "boolean" then
			continue
		elseif kind == "list" then
			if spec.Options ~= nil and type(spec.Options) ~= "table" then
				table.insert(errors, where .. ".Options: Liste erwartet")
			end
		elseif kind == "code" then
			if not Util.IsFinite(spec.MaxCredits) or spec.MaxCredits < 1 or spec.MaxCredits >= PRICE_LIMIT then
				table.insert(errors, where .. ".MaxCredits: Zahl 1 … 1e14 erwartet")
			end
		else
			local lo, hi = numberBounds(spec)
			if lo == nil or hi == nil then
				table.insert(errors, where .. ": { min, max } mit min ≤ max erwartet")
			end
		end
	end
end

local function validateCore(): { string }
	local errors: { string } = {}
	if type(Config.GameName) ~= "string" or Config.GameName == "" then
		table.insert(errors, "Config.GameName: Text erwartet")
	end
	if type(Config.Version) ~= "string" then
		table.insert(errors, "Config.Version: Text erwartet")
	end
	for key, value in pairs(Config.Admin) do
		if type(value) ~= "boolean" then
			table.insert(errors, "Config.Admin." .. key .. ": true/false erwartet")
		end
	end
	if Config.Admin.StudioAllPlayersAdmin == true then
		table.insert(errors, "Config.Admin.StudioAllPlayersAdmin: muss false sein (Player2 nie Admin, §B15.1)")
	end
	local tech = Config.Tech
	for _, name in ipairs({
		"DataStoreName",
		"KeyPrefix",
		"MessagingTopic",
		"BusTopic",
		"LiveStore",
		"StatsStore",
		"ModStore",
		"MarketStore",
		"GlobalStore",
		"GroupsStore",
		"BusMapPrefix",
		"HeartbeatMap",
		"BoardPrefix",
	}) do
		checkText(errors, "Config.Tech." .. name, (tech :: any)[name])
	end
	checkNumber(errors, "Config.Tech.DataVersion", tech.DataVersion, 1, true)
	checkNumber(errors, "Config.Tech.AutoSaveSeconds", tech.AutoSaveSeconds, 10)
	checkNumber(errors, "Config.Tech.AutoSaveStagger", tech.AutoSaveStagger, 0)
	checkNumber(errors, "Config.Tech.LoadAttempts", tech.LoadAttempts, 1, true)
	checkNumber(errors, "Config.Tech.SaveAttempts", tech.SaveAttempts, 1, true)
	checkNumber(errors, "Config.Tech.LockStaleSeconds", tech.LockStaleSeconds, 60)
	checkNumber(errors, "Config.Tech.BindToCloseSeconds", tech.BindToCloseSeconds, 1)
	checkNumber(errors, "Config.Tech.ReceiptKeep", tech.ReceiptKeep, 1, true)
	checkNumber(errors, "Config.Tech.StateFlush", tech.StateFlush, 0.05)
	checkNumber(errors, "Config.Tech.FullStateEvery", tech.FullStateEvery, 1)
	checkNumber(errors, "Config.Tech.Shards", tech.Shards, 1, true)
	checkNumber(errors, "Config.Tech.BoardWriteSeconds", tech.BoardWriteSeconds, 1)
	checkNumber(errors, "Config.Tech.StatsFlushSeconds", tech.StatsFlushSeconds, 1)
	checkNumber(errors, "Config.Tech.PingAttrEvery", tech.PingAttrEvery, 0.1)
	if Util.IsFinite(tech.BindToCloseSeconds) and tech.BindToCloseSeconds > 29 then
		table.insert(errors, "Config.Tech.BindToCloseSeconds: höchstens 29 (Roblox gibt 30 s)")
	end
	if Util.IsFinite(tech.StateFlush) and tech.StateFlush < 0.2 then
		table.insert(errors, "Config.Tech.StateFlush: mindestens 0,2 (State ≤ 5×/s)")
	end
	for key, value in pairs(Config.Studio) do
		if type(value) ~= "boolean" and not Util.IsFinite(value) then
			table.insert(errors, "Config.Studio." .. key .. ": Zahl oder true/false erwartet")
		end
	end
	for key, value in pairs(Config.Debug) do
		if type(value) ~= "boolean" then
			table.insert(errors, "Config.Debug." .. key .. ": true/false erwartet")
		end
	end
	local server = Config.Server
	checkNumber(errors, "Config.Server.MaxPlayers", server.MaxPlayers, 1, true)
	checkNumber(errors, "Config.Server.Plots", server.Plots, 1, true)
	if Util.IsFinite(server.Plots) and Util.IsFinite(server.MaxPlayers) and server.MaxPlayers > server.Plots then
		table.insert(errors, "Config.Server.MaxPlayers: höchstens so viele wie Plots (ein Plot je Spieler)")
	end
	if server.MaxMoney ~= 9e15 then
		table.insert(errors, "Config.Server.MaxMoney: muss 9e15 sein (Muss-Regel 9, < 2^53)")
	end
	checkColors(errors, "Config.Colors", Config.Colors)
	local notifications = Config.Notifications
	if type(notifications.Enabled) ~= "boolean" then
		table.insert(errors, "Config.Notifications.Enabled: true/false erwartet")
	end
	checkNumber(errors, "Config.Notifications.MaxPerDay", notifications.MaxPerDay, 0, true)
	checkNumber(errors, "Config.Notifications.PromptAfterStep", notifications.PromptAfterStep, 1, true)
	validateLiveFields(errors)
	scanChildren(errors)
	return errors
end

function Config.Validate(): { string }
	local errors: { string } = {}
	for _, name in ipairs(CHILDREN) do
		local loadError = loadErrors[name]
		if loadError then
			table.insert(errors, "Config." .. name .. ": " .. loadError)
		else
			local validate = children[name].Validate
			if type(validate) == "function" then
				local ok, result = pcall(validate, Config)
				if not ok then
					table.insert(errors, "Config." .. name .. ".Validate: Fehler " .. tostring(result))
				elseif type(result) == "table" then
					for _, message in ipairs(result) do
						table.insert(errors, tostring(message))
					end
				elseif result ~= nil then
					table.insert(errors, "Config." .. name .. ".Validate: Liste von Texten erwartet")
				end
			else
				table.insert(errors, "Config." .. name .. ": Validate(Config) fehlt (§C14)")
			end
		end
	end
	for _, message in ipairs(validateCore()) do
		table.insert(errors, message)
	end
	return errors
end

return Config
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">City</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Stadt, Licht, Wetter, Umgebungsleben (Config.City)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §C14.2 (City), §A4 (Licht, Materialien, Tag/Nacht,
--  Markt-Wetter, Crash/Rally), §A5 (Welt-Karte), §B3 (Plots, Streaming, Teilebudget), §C16 (Budgets).
--  Alle Zahlen sind Startwerte aus DESIGN.md und 1:1 änderbar. Wird an alle Clients repliziert -> KEINE Geheimnisse hier!
--
--  Koordinaten: Ursprung = Plaza-Mitte, Boden-Oberkante Y = 0. +X = Osten (Helipad), −X = Westen (Λ Motors),
--  +Z = Süden (Marina), −Z = Norden (Börsensaal, Villenhügel). Winkel in Grad, 0° = +X, 90° = +Z (Süden).
--
--  Abschnitte:
--    1) Ebenen & Boden           6) Firmen-Läden & Hologramme      11) Teilebudget & Aufbau
--    2) Licht & Look (§A4)       7) Kulisse (Finanzviertel)        12) Streaming (§B3)
--    3) Markt-Wetter (§A4)       8) Umgebungsleben (nur Client)    13) Asset-Plätze (§C14.3)
--    4) Zonen (§A5)              9) Lichter & Budget                14) Helfer (Routen, Plot-Seiten) + Prüfung
--    5) Plots, Straßen, Routen  10) Schilder (Marken, sprachneutral)
--  Helfer (rein, auf Server und Client gleich):
--    City.RoadRadius(road, angleDeg, offset?): number   Mittellinien-Radius (Ring weicht dem Börsensaal aus)
--    City.RoutePoints(name, spacing?): { Vector3 }      geschlossene Route (letzter Punkt = erster), Y = Fahrbahn
--    City.PlotCFrame(plot): CFrame                      Plot-Mitte auf der Plot-Oberkante, LookVector zur Plaza
--    City.ShopCFrame(instId): CFrame?                   Laden-Mitte am Boden, LookVector = Eingang (zur Plaza)
--    City.Validate(Config): { string }
-- =====================================================================

local City = {}

-- Leerer Asset-Platz (0 = Code-Rezept, §C14.3)
local function slot(): { [string]: any }
	return { MeshId = 0, TextureId = 0, Scale = 1, Offset = CFrame.identity }
end

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- ---------------------------------------------------------------------
-- 1) EBENEN & BODEN – Oberkanten in Studs
-- ---------------------------------------------------------------------
City.Levels = {
	Ground = 0, -- Terrain-Oberkante (Pflaster)
	Road = 0.25, -- Fahrbahn-Oberkante (Teile liegen leicht auf dem Terrain)
	Walk = 0.6, -- Gehweg, Plaza, Plot-Oberkante
	RoadThickness = 1,
	WalkThickness = 1.2,
}
City.Ground = {
	MapSize = 2048, -- 2.048 × 2.048 Studs (§A5)
	Depth = 8, -- Terrain-Dicke unter Y = 0
	CityRadius = 600, -- innerhalb: Pflaster, außerhalb: Gras
	CityMaterial = Enum.Material.Pavement,
	OuterMaterial = Enum.Material.Grass,
	Colors = { -- Terrain-Materialfarben (dunkle Premium-Stadt)
		Pavement = rgb(58, 62, 70),
		Grass = rgb(46, 78, 54),
		Rock = rgb(70, 72, 78),
		Ground = rgb(74, 66, 58),
		Sand = rgb(150, 138, 110),
		Asphalt = rgb(38, 40, 46),
	},
	Water = {
		Color = rgb(18, 52, 78),
		Transparency = 0.35,
		Reflectance = 0.6,
		WaveSize = 0.08,
		WaveSpeed = 6,
	},
}

-- ---------------------------------------------------------------------
-- 2) LICHT & LOOK (§A4) – GraphicsService setzt den Tag-Startwert, WorldLook rechnet live (Client)
--    Lighting.Technology = Future steht in default.project.json (Skripte dürfen es nicht setzen).
-- ---------------------------------------------------------------------
City.Look = {
	Day = {
		Ambient = rgb(92, 98, 112),
		OutdoorAmbient = rgb(128, 136, 152),
		Brightness = 2.4,
		ColorShiftTop = rgb(255, 246, 232),
		ExposureCompensation = 0,
