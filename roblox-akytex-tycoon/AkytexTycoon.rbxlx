-- =====================================================================
-- NACHSCHLAGE-TABELLEN (beim Laden gebaut; doppelte Schlüssel -> assert, CC-Stil)
-- =====================================================================
Progression.ExamByKey = {}
Progression.LessonById = {}
Progression.QuestKindByKey = {}
Progression.QuestById = {}
Progression.AchievementById = {}
Progression.TitleByKey = {}
Progression.PerkByKey = {}
Progression.NodeByKey = {}
Progression.BadgeByKey = {}
do
	for _, task in ipairs(Progression.ExamTasks) do
		assert(Progression.ExamByKey[task.Key] == nil, "[Config.Progression] doppelte Prüfungs-Aufgabe " .. task.Key)
		Progression.ExamByKey[task.Key] = task
	end
	for index, lesson in ipairs(Progression.Academy.Lessons) do
		assert(Progression.LessonById[lesson.Id] == nil, "[Config.Progression] doppelte Lektion " .. lesson.Id)
		lesson.Index = index
		Progression.LessonById[lesson.Id] = lesson
	end
	for _, kind in ipairs(Progression.QuestKinds) do
		assert(Progression.QuestKindByKey[kind.Key] == nil, "[Config.Progression] doppelte Quest-Art " .. kind.Key)
		Progression.QuestKindByKey[kind.Key] = kind
	end
	for _, listName in ipairs({ "Daily", "Weekly", "StarterLine" }) do
		for _, quest in ipairs((Progression.Quests :: any)[listName]) do
			assert(Progression.QuestById[quest.Id] == nil, "[Config.Progression] doppelte Quest " .. quest.Id)
			Progression.QuestById[quest.Id] = quest
		end
	end
	local comeback = Progression.Quests.Comeback
	Progression.QuestById[comeback.Id] = comeback
	for _, entry in ipairs(Progression.Achievements) do
		assert(Progression.AchievementById[entry.Id] == nil, "[Config.Progression] doppelter Erfolg " .. entry.Id)
		Progression.AchievementById[entry.Id] = entry
	end
	for _, listName in ipairs({ "Wealth", "Extra" }) do
		for _, title in ipairs((Progression.Titles :: any)[listName]) do
			assert(Progression.TitleByKey[title.Key] == nil, "[Config.Progression] doppelter Titel " .. title.Key)
			Progression.TitleByKey[title.Key] = title
		end
	end
	for _, perk in ipairs(Progression.Prestige.Perks) do
		assert(Progression.PerkByKey[perk.Key] == nil, "[Config.Progression] doppelter Vorstand-Ast " .. perk.Key)
		Progression.PerkByKey[perk.Key] = perk
	end
	for _, node in ipairs(Progression.KnowHow.Nodes) do
		assert(Progression.NodeByKey[node.Key] == nil, "[Config.Progression] doppelter Know-how-Knoten " .. node.Key)
		Progression.NodeByKey[node.Key] = node
	end
	for _, badge in ipairs(Progression.Badges) do
		assert(Progression.BadgeByKey[badge.Key] == nil, "[Config.Progression] doppeltes Badge " .. badge.Key)
		Progression.BadgeByKey[badge.Key] = badge
	end
end

-- =====================================================================
-- PRÜFUNG (Config.Validate sammelt alle Meldungen; leer = alles ok)
-- =====================================================================
local function isNum(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function isInt(v: any): boolean
	return isNum(v) and v % 1 == 0
end

local function isPair(v: any): boolean
	return type(v) == "table" and type(v.de) == "string" and v.de ~= "" and type(v.en) == "string" and v.en ~= ""
end

local LAYERS = { Simple = true, Trader = true, Pro = true }
local SETS = { Azubi = true, Trader = true, Fonds = true }
local CATS = { Trade = true, Academy = true, Tower = true, World = true, Social = true }
local CHECKS = {
	Floors = true,
	Eff = true,
	Licence = true,
	Lessons = true,
	RoomKinds = true,
	BotOn = true,
	LeagueDays = true,
	Wealth = true,
}

function Progression.Validate(_config: any): { string }
	local errors: { string } = {}
	local function add(text: string)
		table.insert(errors, "Config.Progression." .. text)
	end

	-- Lizenzen
	if #Progression.Licences ~= 10 then
		add("Licences: genau 10 Lizenzen erwartet")
	end
	local lastXp, lastBasis, lastKurs = -1, 0, 0
	for i, lic in ipairs(Progression.Licences) do
		local where = ("Licences[%d]"):format(i)
		if type(lic.Key) ~= "string" or not isPair(lic.Name) then
			add(where .. ": Key und Name {de, en} erwartet")
		end
		if not isInt(lic.Xp) or lic.Xp <= lastXp then
			add(where .. ".Xp: ganze Zahl, steigend erwartet")
		end
		if i == 1 and lic.Xp ~= 0 then
			add(where .. ".Xp: Azubi I startet bei 0")
		end
		if not isInt(lic.Basis) or lic.Basis <= lastBasis or lic.Basis >= 9e15 then
			add(where .. ".Basis: ganze Cent, steigend, < 9e15 erwartet")
		end
		if not isNum(lic.BauKurs) or lic.BauKurs <= lastKurs then
			add(where .. ".BauKurs: steigend erwartet")
		end
		if not isNum(lic.TowerBonus) or lic.TowerBonus < 0 or lic.TowerBonus > 1 then
			add(where .. ".TowerBonus: 0 … 1 erwartet")
		end
		if not isNum(lic.FeeBps) or lic.FeeBps < 0 or lic.FeeBps > 100 then
			add(where .. ".FeeBps: 0 … 100 erwartet")
		end
		if not isNum(lic.MaxWeight) or lic.MaxWeight < 0.05 or lic.MaxWeight > 1 then
			add(where .. ".MaxWeight: 0,05 … 1 erwartet")
		end
		if not isInt(lic.MaxOrders) or lic.MaxOrders < 1 or lic.MaxOrders > 50 then
			add(where .. ".MaxOrders: 1 … 50 erwartet")
		end
		if not LAYERS[lic.Layer] then
			add(where .. ".Layer: Simple/Trader/Pro erwartet")
		end
		if not SETS[lic.Set] then
			add(where .. ".Set: Azubi/Trader/Fonds erwartet")
		end
		if not isInt(lic.MaxStage) or lic.MaxStage < 1 or lic.MaxStage > 12 then
			add(where .. ".MaxStage: 1 … 12 erwartet")
		end
		if not isInt(lic.MaxIpo) or lic.MaxIpo < 0 then
			add(where .. ".MaxIpo: ganze Zahl ≥ 0 erwartet")
		end
		if not isInt(lic.BotSlots) or lic.BotSlots < 0 or lic.BotSlots > 5 then
			add(where .. ".BotSlots: 0 … 5 erwartet")
		end
		if type(lic.Exam) ~= "table" then
			add(where .. ".Exam: Liste erwartet")
		else
			for _, task in ipairs(lic.Exam) do
				if not Progression.ExamByKey[task] then
					add(where .. ".Exam: unbekannte Aufgabe " .. tostring(task))
				end
			end
		end
		lastXp = if isInt(lic.Xp) then lic.Xp else lastXp
		lastBasis = if isInt(lic.Basis) then lic.Basis else lastBasis
		lastKurs = if isNum(lic.BauKurs) then lic.BauKurs else lastKurs
	end
	for _, task in ipairs(Progression.ExamTasks) do
		if task.Source == "Lesson" and not Progression.LessonById[task.Lesson] then
			add("ExamTasks." .. task.Key .. ".Lesson: unbekannte Lektion")
		end
	end

	-- XP-Quellen
	for key, source in pairs(Progression.XpSources) do
		if type(source) ~= "table" or not isInt(source.Xp) or source.Xp < 0 then
			add("XpSources." .. tostring(key) .. ".Xp: ganze Zahl ≥ 0 erwartet")
		elseif source.Cap ~= nil and (not isInt(source.Cap) or source.Cap < 1) then
			add("XpSources." .. tostring(key) .. ".Cap: ganze Zahl ≥ 1 erwartet")
		end
	end
	local tutorialSum = 0
	for _, xp in pairs(Progression.Tutorial.Xp) do
		tutorialSum += if isInt(xp) then xp else 0
	end
	if tutorialSum ~= Progression.XpSources.Tutorial.Xp then
		add(
			("Tutorial.Xp: Summe %d, erwartet %d (XpSources.Tutorial)"):format(
				tutorialSum,
				Progression.XpSources.Tutorial.Xp
			)
		)
	end
	if not isNum(Progression.LevelCurve) or Progression.LevelCurve <= 0 then
		add("LevelCurve: Zahl > 0 erwartet")
	end

	-- Know-how
	local khMax = 0
	for _, node in ipairs(Progression.KnowHow.Nodes) do
		if not isInt(node.Max) or node.Max < 1 or not isInt(node.Cost) or node.Cost < 1 then
			add("KnowHow.Nodes." .. tostring(node.Key) .. ": Max/Cost ganze Zahlen ≥ 1 erwartet")
		else
			khMax += node.Max * node.Cost
		end
		if not isInt(node.Licence) or node.Licence < 1 or node.Licence > 10 then
			add("KnowHow.Nodes." .. tostring(node.Key) .. ".Licence: 1 … 10 erwartet")
		end
	end
	if khMax < 1 then
		add("KnowHow.Nodes: leer")
	end

	-- Ruf
	local last = 0
	for i, threshold in ipairs(Progression.Ruf.Thresholds) do
		if not isInt(threshold) or threshold <= last then
			add(("Ruf.Thresholds[%d]: steigend erwartet"):format(i))
		end
		last = if isInt(threshold) then threshold else last
	end
	if #Progression.Ruf.Thresholds ~= 10 then
		add("Ruf.Thresholds: 10 Stufen erwartet")
	end

	-- Titel
	if #Progression.Titles.Wealth ~= 12 then
		add("Titles.Wealth: 12 Vermögens-Titel erwartet")
	end
	for _, list in ipairs({ Progression.Titles.Wealth, Progression.Titles.Extra }) do
		for _, title in ipairs(list) do
			if type(title.Key) ~= "string" or not isPair(title.Name) then
				add("Titles." .. tostring(title.Key) .. ": Key und Name {de, en} erwartet")
			end
		end
	end

	-- Börsengang
	local stars = 0
	for _, perk in ipairs(Progression.Prestige.Perks) do
		if not isInt(perk.Max) or perk.Max < 1 then
			add("Prestige.Perks." .. tostring(perk.Key) .. ".Max: ganze Zahl ≥ 1 erwartet")
		else
			stars += perk.Max
		end
	end
	if stars ~= 39 then
		add(("Prestige.Perks: Summe %d ★, erwartet 39 (§B9.6)"):format(stars))
	end
	for _, step in ipairs(Progression.Prestige.TitleSteps) do
		if not Progression.TitleByKey[step.Title] then
			add("Prestige.TitleSteps: unbekannter Titel " .. tostring(step.Title))
		end
	end
	for _, word in ipairs(Progression.TickerBlock) do
		if type(word) ~= "string" or string.match(word, "^[A-Z]+$") == nil then
			add("TickerBlock: nur Großbuchstaben erwartet (" .. tostring(word) .. ")")
		end
	end

	-- Akademie
	if #Progression.Academy.Lessons ~= 16 then
		add("Academy.Lessons: 16 Lektionen erwartet")
	end
	for _, lesson in ipairs(Progression.Academy.Lessons) do
		if not isInt(lesson.Cards) or lesson.Cards < 3 or lesson.Cards > 5 then
			add("Academy.Lessons." .. lesson.Id .. ".Cards: 3 … 5 erwartet")
		end
		if type(lesson.Quiz) ~= "table" or #lesson.Quiz < 2 or #lesson.Quiz > 3 then
			add("Academy.Lessons." .. lesson.Id .. ".Quiz: 2 … 3 Fragen erwartet")
		else
			for _, options in ipairs(lesson.Quiz) do
				if not isInt(options) or options < 2 or options > 4 then
					add("Academy.Lessons." .. lesson.Id .. ".Quiz: 2 … 4 Antworten je Frage erwartet")
				end
			end
		end
		if not isInt(lesson.Series) or lesson.Series < 1 or lesson.Series > Progression.Academy.Series then
			add("Academy.Lessons." .. lesson.Id .. ".Series: 1 … " .. Progression.Academy.Series .. " erwartet")
		end
	end

	-- Quests
	if #Progression.QuestKinds ~= 21 then
		add("QuestKinds: 21 Arten erwartet (§B9.7)")
	end
	for _, kind in ipairs(Progression.QuestKinds) do
		if not CATS[kind.Cat] then
			add("QuestKinds." .. kind.Key .. ".Cat: Trade/Academy/Tower/World/Social erwartet")
		end
		if type(kind.Tracker) ~= "string" or kind.Tracker == "" then
			add("QuestKinds." .. kind.Key .. ".Tracker: Service-Name erwartet (jede Art braucht einen Tracker)")
		end
	end
	local q = Progression.Quests
	if #q.Daily ~= q.DailyPool then
		add(("Quests.Daily: %d Vorlagen erwartet"):format(q.DailyPool))
	end
	if #q.Weekly ~= q.WeeklyPool then
		add(("Quests.Weekly: %d Vorlagen erwartet"):format(q.WeeklyPool))
	end
	if #q.StarterLine ~= q.Starter then
		add(("Quests.StarterLine: %d Schritte erwartet"):format(q.Starter))
	end
	local tradeDaily = 0
	for _, listName in ipairs({ "Daily", "Weekly", "StarterLine" }) do
		for _, quest in ipairs((q :: any)[listName]) do
			local where = "Quests." .. listName .. "." .. tostring(quest.Id)
			if quest.Check ~= nil then
				if not CHECKS[quest.Check] then
					add(where .. ".Check: unbekannt")
				end
			elseif not Progression.QuestKindByKey[quest.Kind] then
				add(where .. ".Kind: unbekannte Quest-Art " .. tostring(quest.Kind))
			end
			if not isNum(quest.Goal) or quest.Goal < 1 then
				add(where .. ".Goal: Zahl ≥ 1 erwartet")
			end
			if listName == "Daily" then
				if not isInt(quest.Tier) or quest.Tier < 1 or quest.Tier > #q.TierMinutes then
					add(where .. ".Tier: 1 … " .. #q.TierMinutes .. " erwartet")
				end
				local kind = Progression.QuestKindByKey[quest.Kind]
				if kind and (kind.Cat == "Trade" or kind.Cat == "Academy") then
					tradeDaily += 1
				end
			end
			if listName == "StarterLine" then
				if not isInt(quest.Credits) or quest.Credits < 500 or quest.Credits > 50000 then
					add(where .. ".Credits: 500 … 50.000 erwartet (§B9.7)")
				end
				if quest.Title ~= nil and not Progression.TitleByKey[quest.Title] then
					add(where .. ".Title: unbekannter Titel")
				end
			end
		end
	end
	if tradeDaily < q.DailyCount then
		add("Quests.Daily: zu wenige Handels-/Akademie-Vorlagen")
	end

	-- Erfolge
	if #Progression.Achievements ~= 60 then
		add("Achievements: 60 Erfolge erwartet (§B9.8)")
	end
	local perCat: { [string]: number } = {}
	for _, entry in ipairs(Progression.Achievements) do
		perCat[entry.Cat] = (perCat[entry.Cat] or 0) + 1
		if not isPair(entry.Name) or type(entry.Stat) ~= "string" or not isNum(entry.Goal) or entry.Goal <= 0 then
			add("Achievements." .. entry.Id .. ": Name/Stat/Goal erwartet")
		end
		local reward = entry.Reward
		if reward.Title ~= nil and not Progression.TitleByKey[reward.Title] then
			add("Achievements." .. entry.Id .. ".Reward.Title: unbekannter Titel")
		end
		if reward.Minutes ~= nil and (not isNum(reward.Minutes) or reward.Minutes <= 0) then
			add("Achievements." .. entry.Id .. ".Reward.Minutes: Zahl > 0 erwartet")
		end
		if reward.Min ~= nil and (not isInt(reward.Min) or reward.Min < 0 or reward.Min >= 1e14) then
			add("Achievements." .. entry.Id .. ".Reward.Min: ganze Zahl < 1e14 erwartet")
		end
	end
	local expected = { Trading = 14, Tower = 14, Academy = 10, Collection = 10, Social = 6, Events = 6 }
	for cat, n in pairs(expected) do
		if perCat[cat] ~= n then
			add(("Achievements: Kategorie %s hat %d statt %d"):format(cat, perCat[cat] or 0, n))
		end
	end

	-- Badges
	if #Progression.Badges ~= 15 then
		add("Badges: 15 Badges erwartet (§B9.8)")
	end
	for _, badge in ipairs(Progression.Badges) do
		if not isInt(badge.Id) or badge.Id < 0 or not isPair(badge.Name) then
			add("Badges." .. tostring(badge.Key) .. ": Id (ganze Zahl ≥ 0, 0 = aus) und Name erwartet")
		end
	end

	-- Album
	if #Progression.Album.Cards ~= 43 then
		add("Album.Cards: 43 Karten erwartet (36 Firmen + 7 ETFs)")
	end

	-- Tutorial
	for step, name in pairs(Progression.Tutorial.FunnelNames) do
		if not isInt(step) or step < 1 or step > 18 or type(name) ~= "string" then
			add("Tutorial.FunnelNames: Schritte 1 … 18 mit Namen erwartet")
		end
	end

	-- Sozial
	local social = Progression.Social
	if not isInt(social.GroupId) or social.GroupId < 0 then
		add("Social.GroupId: ganze Zahl ≥ 0 erwartet (0 = aus)")
	end
	if #social.Reactions ~= 5 then
		add("Social.Reactions: 5 Reaktionen erwartet (§B11.3)")
	end

	-- Bestenlisten
	if #Progression.Boards.List ~= 6 then
		add("Boards.List: 6 Bestenlisten erwartet (§B11.1)")
	end
	return errors
end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Quality</string>
            <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – GRAFIKSTUFEN (Shared/Config/Quality)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §C14.2 (Config.Quality), §C16 (Budgets), §A5 (Umgebungsleben).
--  Erreichbar als Config.Quality. Gelesen vom Client-Modul Quality: Quality.Tier(), Quality.Budget(key).
--
--  Je Stufe:
--    Lights          echte Lichter (PointLight/SpotLight) gleichzeitig nahe der Kamera (≤ 32/64 am PC)
--    Shadows         Lighting.GlobalShadows (clientseitig vom Modul Quality gesetzt)
--    Traffic         Autos auf den Splines (CityLife, WP7)          Drones   Lieferdrohnen
--    Monitors        live gerenderte Welt-Monitore (K nächste)        Candles  Kerzen je Terminal-Chart
--    Particles       Partikel-Faktor (0–1)                             InteriorRadius  Etagen ±k um die Kamera (TowerView)
--    AreaFill        Flächen-Chart (nur High/Ultra)                    DoF      Tiefenschärfe in Menüs/Kamerafahrten
--  Automatik: runter, wenn 5 s lang < 35 FPS; rauf, wenn 30 s lang > 55 FPS (manuell überschreibbar in den Einstellungen).
-- =====================================================================

export type Tier = {
	Lights: number,
	Shadows: boolean,
	Traffic: number,
	Drones: number,
	Monitors: number,
	Candles: number,
	Particles: number,
	InteriorRadius: number,
	AreaFill: boolean,
	DoF: boolean,
}

local Quality = {}

Quality.Order = { "Low", "Medium", "High", "Ultra" }

Quality.Tiers = {
	Low = {
		Lights = 6,
		Shadows = false,
		Traffic = 0,
		Drones = 0,
		Monitors = 2,
		Candles = 60,
		Particles = 0.3,
		InteriorRadius = 0,
		AreaFill = false,
		DoF = false,
	},
	Medium = {
		Lights = 16,
		Shadows = true,
		Traffic = 10,
		Drones = 4,
		Monitors = 4,
		Candles = 90,
		Particles = 0.6,
		InteriorRadius = 1,
		AreaFill = false,
		DoF = false,
	},
	High = {
		Lights = 32,
		Shadows = true,
		Traffic = 20,
		Drones = 8,
		Monitors = 8,
		Candles = 120,
		Particles = 1,
		InteriorRadius = 2,
		AreaFill = true,
		DoF = true,
	},
	Ultra = {
		Lights = 64,
		Shadows = true,
		Traffic = 32,
		Drones = 14,
		Monitors = 12,
		Candles = 120,
		Particles = 1,
		InteriorRadius = 4,
		AreaFill = true,
		DoF = true,
	},
} :: { [string]: Tier }

-- Automatik (§D WP2): runter < AutoFpsDown für DownSeconds, rauf > AutoFpsUp für UpSeconds
Quality.AutoFpsDown = 35
Quality.AutoFpsUp = 55
Quality.DownSeconds = 5
Quality.UpSeconds = 30
Quality.StartDelay = 10 -- erste Sekunden nach dem Start (Laden, Streaming) zählen nicht
Quality.UpBlockAfterDown = 60 -- nach einem Herunterstufen so lange nicht wieder hoch
Quality.MaxDownsPerTier = 2 -- wurde eine Stufe so oft verlassen, geht die Automatik nicht mehr dorthin zurück

-- Startstufe der Automatik je Gerät (vor der ersten Messung)
Quality.DeviceStart = {
	Touch = "Medium",
	Gamepad = "High",
	KBM = "High",
}
-- Höchste Stufe, die die Automatik je Gerät wählt (manuell geht immer alles)
Quality.DeviceMax = {
	Touch = "High",
	Gamepad = "Ultra",
	KBM = "Ultra",
}

local function isFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local NUMBER_KEYS = { "Lights", "Traffic", "Drones", "Monitors", "Candles", "Particles", "InteriorRadius" }
local BOOL_KEYS = { "Shadows", "AreaFill", "DoF" }

function Quality.Validate(_config: any): { string }
	local errors: { string } = {}
	local previous: Tier? = nil
	for _, name in ipairs(Quality.Order) do
		local tier = Quality.Tiers[name]
		if type(tier) ~= "table" then
			table.insert(errors, "Config.Quality.Tiers." .. name .. ": Stufe fehlt")
			continue
		end
		for _, key in ipairs(NUMBER_KEYS) do
			local value = (tier :: any)[key]
			if not isFinite(value) or value < 0 then
				table.insert(errors, ("Config.Quality.Tiers.%s.%s: Zahl ≥ 0 erwartet"):format(name, key))
			elseif previous and value < (previous :: any)[key] then
				table.insert(errors, ("Config.Quality.Tiers.%s.%s: kleiner als die Stufe darunter"):format(name, key))
			end
		end
		for _, key in ipairs(BOOL_KEYS) do
			if type((tier :: any)[key]) ~= "boolean" then
				table.insert(errors, ("Config.Quality.Tiers.%s.%s: true/false erwartet"):format(name, key))
			end
		end
		if isFinite(tier.Particles) and tier.Particles > 1 then
			table.insert(errors, "Config.Quality.Tiers." .. name .. ".Particles: höchstens 1")
		end
		if isFinite(tier.Lights) and tier.Lights > 64 then
			table.insert(errors, "Config.Quality.Tiers." .. name .. ".Lights: höchstens 64 (§C16)")
		end
		previous = tier
	end
	for name in pairs(Quality.Tiers) do
		if not table.find(Quality.Order, name) then
			table.insert(errors, "Config.Quality.Tiers." .. name .. ": nicht in Config.Quality.Order")
		end
	end
	if
		not isFinite(Quality.AutoFpsDown)
		or not isFinite(Quality.AutoFpsUp)
		or Quality.AutoFpsDown >= Quality.AutoFpsUp
	then
		table.insert(errors, "Config.Quality: AutoFpsDown < AutoFpsUp erwartet")
	end
	for _, key in ipairs({ "DownSeconds", "UpSeconds", "StartDelay", "UpBlockAfterDown", "MaxDownsPerTier" }) do
		local value = (Quality :: any)[key]
		if not isFinite(value) or value <= 0 then
			table.insert(errors, "Config.Quality." .. key .. ": positive Zahl erwartet")
		end
	end
	for _, map in ipairs({ Quality.DeviceStart, Quality.DeviceMax }) do
		for device, tierName in pairs(map) do
			if Quality.Tiers[tierName] == nil then
				table.insert(
					errors,
					"Config.Quality (Gerät " .. tostring(device) .. "): unbekannte Stufe " .. tostring(tierName)
				)
			end
		end
	end
	return errors
end

return Quality
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Login-Kalender, Codes, Rückkehr-Belohnungen (Config.Rewards)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §C14.2 (Rewards), §B9.9
--  (Login deterministisch, nie Rad; 1 Gratis-Serien-Schutz je Woche, Club +1, max. 2; KEIN bezahlter Serien-Retter),
--  §B9.9 Rückkehr (≥ 14 Tage: 3 h Boost x2 + Aufhol-Quest · ≥ 60 Tage: + Rückkehrer-Neon), §C14.1 LiveFields
--  ("Rewards.Codes.*": Codes nur CR/Kosmetik, live änderbar und geklemmt).
--  Alle Zahlen sind Startwerte und 1:1 änderbar. Wird an alle Clients repliziert -> KEINE Geheimnisse hier
--  (Codes sind öffentlich gedacht: Social-Links/Events). Diese Datei lädt KEINE Roblox-Dienste -> Luau-CLI-ladbar.
--
--  Belohnungs-Felder wie Config.Season: Credits = { Minutes, Min } · Decor · Cosmetics · Watches · Cars · BoostX2 ·
--    InstantTokens · SeasonXp (nur Login Tag 6). Der tägliche Gratis-Sofortbau-Token kommt von TowerService.
--  Helfer: Rewards.Validate(Config): { string }
-- =====================================================================

local Rewards = {}

-- ---------------------------------------------------------------------
-- 1) LOGIN-KALENDER (§B9.9) – 7er-Zyklus + 28er-Spur (zählt abgeholte Tage, Serie egal)
-- ---------------------------------------------------------------------
Rewards.Login = {
	Cycle = {
		{ Day = 1, Credits = { Minutes = 15, Min = 1000 } },
		{ Day = 2, Cosmetics = { "Accent" } }, -- Lack „Akzentblau“
		{ Day = 3, BoostX2 = 1800 }, -- Boost x2 30 min (Spielzeit)
		{ Day = 4, Decor = { MiniBull = 1 } }, -- Deko „Mini-Bulle“
		{ Day = 5, Credits = { Minutes = 60, Min = 3000 } },
		{ Day = 6, SeasonXp = 300 },
		{ Day = 7, Watches = { "WeekChrono" }, Repeat = { Credits = { Minutes = 180, Min = 8000 } } }, -- ab Zyklus 2
	},
	Track = {
		{ Day = 14, Cosmetics = { "Obsidian" } }, -- Fassade Obsidian
		{ Day = 28, Cars = { "StreakGT" }, Cosmetics = { "Polar" } }, -- Auto Streak-GT + Fassade Polar
	},
	TrackMax = 28,
	FreezePerWeek = 1, -- Gratis-Serien-Schutz je ISO-Woche …
	FreezeClubBonus = 1, -- … Vorstands-Club +1 (Abo-Vorteil, Komfort – kein Spielvorteil)
	FreezeMax = 2, -- höchstens so viele gespeichert
}

-- ---------------------------------------------------------------------
-- 2) CODES (nur CR/Kosmetik – Firewall; Großschreibung egal; ≤ 20 Zeichen; Expires = ISO-UTC oder nil)
--    Live änderbar über Config.LiveFields "Rewards.Codes.*" (Admin-Tab Live-Ops, geprüft und geklemmt).
-- ---------------------------------------------------------------------
Rewards.Codes = {
	LAUNCH = { Grant = { Credits = 5000 }, Expires = "2027-01-31T00:00:00Z" },
}
Rewards.CodeMaxLength = 20
Rewards.CodesKeep = 200 -- eingelöste Codes je Spieler (Liste begrenzt)

-- ---------------------------------------------------------------------
-- 3) RÜCKKEHR (§B9.9) – gemessen an SavedAt (Server-Zeit) beim Beitritt
-- ---------------------------------------------------------------------
Rewards.WinBack = {
	Days = 14, -- ≥ 14 Tage weg …
	BoostX2 = 10800, -- … 3 h Boost x2 (Spielzeit) + Aufhol-Quest (Config.Progression.Quests.Comeback)
	LongDays = 60, -- ≥ 60 Tage weg: zusätzlich …
	LongCosmetics = { "Returner" }, -- … Rückkehrer-Fassaden-Neon
}

-- ---------------------------------------------------------------------
-- 4) SPIELZEIT (Saison-XP) – Takt der Zählung
-- ---------------------------------------------------------------------
Rewards.PlaytimeTick = 60 -- Sekunden je Zähl-Schritt (Saison-XP alle 10 min laut Config.Season)

-- =====================================================================
-- PRÜFUNG (Config.Validate sammelt alle Meldungen; leer = alles ok)
-- =====================================================================
local function isNum(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function isInt(v: any): boolean
	return isNum(v) and v % 1 == 0
end

local ALLOWED = {
	Day = true,
	Credits = true,
	Decor = true,
	Cosmetics = true,
	Watches = true,
	Cars = true,
	BoostX2 = true,
	InstantTokens = true,
	SeasonXp = true,
	Repeat = true,
}

local function checkReward(add: (string) -> (), where: string, reward: any)
	if type(reward) ~= "table" then
		add(where .. ": Tabelle erwartet")
		return
	end
	for field, value in pairs(reward) do
		if not ALLOWED[field] then
			add(where .. ": Feld " .. tostring(field) .. " nicht erlaubt (nur Turm-Seite, §0.4)")
		elseif field == "Credits" then
			if type(value) ~= "table" or not isNum(value.Minutes) or value.Minutes <= 0 or not isInt(value.Min) then
				add(where .. ".Credits: { Minutes > 0, Min } erwartet")
			end
		elseif field == "BoostX2" or field == "InstantTokens" or field == "SeasonXp" then
			if not isInt(value) or value < 1 then
				add(where .. "." .. field .. ": ganze Zahl ≥ 1 erwartet")
			end
		elseif field == "Repeat" then
			checkReward(add, where .. ".Repeat", value)
		elseif field == "Decor" then
			if type(value) ~= "table" then
				add(where .. ".Decor: { [Key] = Anzahl } erwartet")
			end
		elseif field ~= "Day" and (type(value) ~= "table" or #value == 0) then
			add(where .. "." .. field .. ": Liste erwartet")
		end
	end
end

local function isIso(text: any): boolean
	return type(text) == "string" and string.match(text, "^%d%d%d%d%-%d%d%-%d%dT%d%d:%d%d:%d%dZ$") ~= nil
end

function Rewards.Validate(_config: any): { string }
	local errors: { string } = {}
	local function add(text: string)
		table.insert(errors, "Config.Rewards." .. text)
	end
	local login = Rewards.Login
	if #login.Cycle ~= 7 then
		add("Login.Cycle: 7 Tage erwartet")
	end
	for i, reward in ipairs(login.Cycle) do
		if reward.Day ~= i then
			add(("Login.Cycle[%d].Day: %d erwartet"):format(i, i))
		end
		checkReward(add, ("Login.Cycle[%d]"):format(i), reward)
	end
	for i, reward in ipairs(login.Track) do
		if not isInt(reward.Day) or reward.Day < 1 or reward.Day > login.TrackMax then
			add(("Login.Track[%d].Day: 1 … %d erwartet"):format(i, login.TrackMax))
		end
		checkReward(add, ("Login.Track[%d]"):format(i), reward)
	end
	if not isInt(login.FreezeMax) or login.FreezeMax < 0 or not isInt(login.FreezePerWeek) then
		add("Login.Freeze*: ganze Zahlen erwartet")
	end
	for code, entry in pairs(Rewards.Codes) do
		local where = "Codes." .. tostring(code)
		if type(code) ~= "string" or #code > Rewards.CodeMaxLength or string.match(code, "^[%w_]+$") == nil then
			add(where .. ": Code aus Buchstaben/Ziffern, ≤ " .. Rewards.CodeMaxLength .. " Zeichen erwartet")
		end
		if code ~= string.upper(code) then
			add(where .. ": Codes in GROSSBUCHSTABEN eintragen")
		end
		if type(entry) ~= "table" or type(entry.Grant) ~= "table" then
			add(where .. ".Grant: Tabelle erwartet")
		else
			for field, value in pairs(entry.Grant) do
				if field == "Credits" then
					if not isInt(value) or value < 1 or value >= 1e14 then
						add(where .. ".Grant.Credits: ganze Zahl 1 … 1e14 erwartet")
					end
				elseif field ~= "Cosmetics" then
					add(where .. ".Grant: nur Credits/Cosmetics erlaubt (Firewall)")
				end
			end
			if entry.Expires ~= nil and not isIso(entry.Expires) then
				add(where .. ".Expires: ISO-UTC (JJJJ-MM-TTThh:mm:ssZ) erwartet")
			end
		end
	end
	local winBack = Rewards.WinBack
	if not isInt(winBack.Days) or not isInt(winBack.LongDays) or winBack.LongDays < winBack.Days then
		add("WinBack: Days ≤ LongDays (ganze Zahlen) erwartet")
	end
	return errors
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Season</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Saison & Skyline-Pass (Config.Season)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §C14.2 (Season), §B9.9
--  (Skyline-Pass: 4 Wochen, 50 Stufen à 1.000 Saison-XP), §E2 (Saison-Plan), §B14.2 (SeasonPremium/SeasonTier).
--  Alle Zahlen sind Startwerte und 1:1 änderbar. Wird an alle Clients repliziert -> KEINE Geheimnisse.
--  Diese Datei lädt KEINE Roblox-Dienste/-Typen -> Luau-CLI-ladbar.
--
--  Robux-Firewall (§0.4/§0.8): Pass-Belohnungen sind NUR Turm-Seite (CR, Deko, Kosmetik, Uhr, Auto, Boost-Token,
--  Titel) – NIE AKY, Trader-XP, Know-how, Ruf, Lizenz. Gekaufte Stufen (Produkt SeasonTier) schalten nur Kosmetik
--  frei; CR/Boost/Token zahlt eine Stufe nur, wenn sie mit verdienter Saison-XP erreicht wurde (REUSE §7 #8).
--  Premium rückwirkend; ehrlicher Countdown bis EndUtc (feste Enddaten, kein Neustart).
--
--  Belohnungs-Felder: Credits = { Minutes, Min } (Minuten Dauer-Einkommen ohne Zeitlich, mindestens Min CR) ·
--    Decor = { [Key] = Anzahl } · Cosmetics = { Key } · Watches = { Key } · Cars = { Key } · Accessories = { Key } ·
--    BoostX2 = Spielsekunden · InstantTokens = Anzahl · Title = Titel-Schlüssel (Config.Progression.Titles)
--  Helfer: Season.Validate(Config): { string }
-- =====================================================================

local Season = {}

-- ---------------------------------------------------------------------
-- 1) SAISON-QUELLEN (§B9.9) – ≈ 1.800 Saison-XP je Tag -> Stufe 50 in ≈ 28 Tagen
-- ---------------------------------------------------------------------
Season.XpSources = {
	DailyQuest = 150, -- je Tagesquest (3×)
	WeeklyQuest = 600, -- je Wochenquest (3×)
	Playtime = { Xp = 10, Minutes = 10, MaxMinutes = 60 }, -- 10 je 10 min, max. 60 min/Tag
	CountingDay = { Xp = 25, Cap = 12 }, -- zählender Börsentag, max. 12/Tag
	WorldEvent = { Xp = 50 }, -- Welt-Event-Teilnahme (EventService ruft GrantSeasonXp)
	HelpBuild = { Xp = 25 }, -- Bau-Hilfe (TowerService ruft GrantSeasonXp)
	Respekt = { Xp = 25, Cap = 5 }, -- Respekt geben, max. 5/Tag
	Login = { Xp = 300 }, -- Login-Kalender Tag 6
	League = { Bronze = 300, Silber = 600, Gold = 1200, Diamant = 2500 }, -- Liga-Stufe der Vorwoche
}
Season.MaxGrant = 5000 -- eine einzelne Saison-XP-Gutschrift höchstens (Schutz)

-- ---------------------------------------------------------------------
-- 2) BELOHNUNGEN Saison 1 „Neon-Skyline“ (Deko-Set S1, Uhr Skyline-Chrono, Auto Orbit-R, Fassade Holo-Prisma)
-- ---------------------------------------------------------------------
local function cr(tier: number, minutes: number, min: number)
	return { Tier = tier, Credits = { Minutes = minutes, Min = min } }
end

-- stylua: ignore start
local FREE_S1 = {
	cr(2, 15, 2000),
	{ Tier = 4, Decor = { NeonBench = 1 } },
	{ Tier = 6, BoostX2 = 1800 },
	cr(8, 30, 5000),
	{ Tier = 10, Decor = { SkylineRug = 1 } },
	{ Tier = 12, InstantTokens = 1 },
	cr(14, 45, 8000),
	{ Tier = 16, Decor = { OrbitLamp = 1 } },
	{ Tier = 18, BoostX2 = 1800 },
	cr(20, 60, 12000),
	{ Tier = 22, InstantTokens = 1 },
	{ Tier = 24, Decor = { NeonPalm = 1 } },
	cr(26, 60, 15000),
	{ Tier = 28, BoostX2 = 3600 },
	cr(30, 90, 20000),
	{ Tier = 32, InstantTokens = 2 },
	cr(34, 90, 25000),
	{ Tier = 36, BoostX2 = 3600 },
	cr(38, 120, 30000),
	{ Tier = 40, InstantTokens = 2 },
	cr(42, 120, 40000),
	{ Tier = 44, BoostX2 = 3600 },
	cr(46, 150, 50000),
	{ Tier = 48, InstantTokens = 3 },
	{ Tier = 50, Title = "S1Pioneer", Credits = { Minutes = 180, Min = 80000 } },
}

local PREMIUM_S1 = {
	cr(1, 20, 3000),
	{ Tier = 2, Decor = { SkylineModel = 1 } },
	{ Tier = 3, BoostX2 = 1800 },
	cr(4, 30, 5000),
	{ Tier = 5, Decor = { NeonBench = 1 } },
	{ Tier = 6, InstantTokens = 1 },
	cr(7, 30, 6000),
	{ Tier = 8, Decor = { HoloTicker = 1 } },
	{ Tier = 9, BoostX2 = 1800 },
	{ Tier = 10, Title = "S1Regular" }, -- Kopftitel „Skyline-Stammgast S1“ (sichtbar am Namensschild + Zeigen-Karte)
	cr(11, 45, 8000),
	{ Tier = 12, Decor = { SkylineRug = 1 } },
	{ Tier = 13, InstantTokens = 1 },
	cr(14, 45, 9000),
	{ Tier = 15, Decor = { BlimpModel = 1 } },
	{ Tier = 16, BoostX2 = 3600 },
	cr(17, 60, 10000),
	{ Tier = 18, Decor = { OrbitLamp = 1 } },
	{ Tier = 19, InstantTokens = 1 },
	{ Tier = 20, Cosmetics = { "HoloPrism" } }, -- Fassade Holo-Prisma
	cr(21, 60, 12000),
	{ Tier = 22, Decor = { NeonPalm = 1 } },
	{ Tier = 23, BoostX2 = 3600 },
	cr(24, 75, 14000),
	{ Tier = 25, Decor = { SkylineModel = 1 } },
	{ Tier = 26, InstantTokens = 2 },
	cr(27, 75, 16000),
	{ Tier = 28, Decor = { HoloTicker = 1 } },
	{ Tier = 29, BoostX2 = 3600 },
	{ Tier = 30, Watches = { "SkylineChrono" } }, -- Uhr Skyline-Chrono
	cr(31, 90, 18000),
	{ Tier = 32, Decor = { NeonBench = 1 } },
	{ Tier = 33, InstantTokens = 2 },
	cr(34, 90, 20000),
	{ Tier = 35, Decor = { BlimpModel = 1 } },
	{ Tier = 36, BoostX2 = 5400 },
	cr(37, 105, 24000),
	{ Tier = 38, Decor = { OrbitLamp = 1 } },
	{ Tier = 39, InstantTokens = 2 },
	{ Tier = 40, Title = "S1Magnate" }, -- Kopftitel „Skyline-Magnat S1“ (Terminal-Themes/Kronen-Effekte gibt es noch
	-- nicht im Spiel – nie eine Premium-Belohnung ohne sichtbare Wirkung, §0.8 Punkt 4)
	cr(41, 120, 28000),
	{ Tier = 42, Decor = { NeonPalm = 1 } },
	{ Tier = 43, BoostX2 = 5400 },
	cr(44, 120, 32000),
	{ Tier = 45, Decor = { SkylineTrophy = 1 } },
