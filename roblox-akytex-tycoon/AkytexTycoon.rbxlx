	p(list, s, { 2.0, 1.8, 2.0 }, { 0.9, 6.1, 0.2 }, r.A, "Grass", ball())
	p(list, s, { 1.8, 1.6, 1.8 }, { -0.8, 5.9, -0.4 }, r.A, "Grass", ball())
end

R.Globe = function(list, r, s)
