        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Market</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Texte "mkt." (Shared/Lang/Market): Markt-Engine, Kalender, Firmenprofil, Admin-Markt
--  Besitzer: WP3 (Markt-Engine). Vertrag: DESIGN.md §C15, §B6, §B15.3; MARKET.md §6, §17.
--  Platzhalter wie string.format: %s = Text, %d = ganze Zahl. Prozent als "%%" schreiben.
--  Vom Server benutzt: mkt.invalid, mkt.unknownInst, mkt.notReady, mkt.admin.*.
--  Für die Client-Anzeige (WP5): mkt.cal.* (CalendarItem.Key), mkt.class.*, mkt.regime.*, mkt.verdict.*, mkt.profile.*,
--  mkt.phase.*, mkt.halted, mkt.open, mkt.ipoAuction, mkt.historyLoading.
--  Wortliste §0.7 beachten (der Vertrags-Prüfer scannt jeden Wert).
-- =====================================================================

return {
	de = {
		-- Anfragen
		["mkt.invalid"] = "Ungültige Markt-Anfrage",
		["mkt.unknownInst"] = "Diesen Wert gibt es nicht",
		["mkt.notReady"] = "Der Markt öffnet gleich …",
		["mkt.historyLoading"] = "Historie lädt …",
		["mkt.halted"] = "HANDELSPAUSE",
		["mkt.open"] = "Markt offen",
		["mkt.ipoAuction"] = "Erstnotiz – Auktion läuft",

		-- Risikoklassen & Markt-Wetter
