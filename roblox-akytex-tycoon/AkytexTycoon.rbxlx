        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Texte "shop." und "item." (Shared/Lang/Shop)
--  Besitzer: WP10 (Monetarisierung, Shop, CR-Konto). Vertrag: DESIGN.md §C15 (Pflicht: shop.notSetUp, shop.together4,
--  shop.restricted, shop.giftBlocked), §B14 (ehrliche Wirkungstexte), Muss-Regel 17 (Knöpfe "Ansehen"/"Details"/
--  "Preis anzeigen", nie "JETZT KAUFEN"/"LETZTE CHANCE"/"Nur heute!"; Robux-Artikel nie mit "Rendite", "ROI",
--  "investieren", "Gewinn"), §0.7 (Wortliste – der Vertrags-Prüfer scannt jeden Wert).
--  Artikel-Namen und -Wirkungen stehen als { de, en } in Config.Shop (Name/Desc), hier nur die Oberfläche.
--  Platzhalter wie string.format: %s = Text, %d = ganze Zahl, %% = Prozentzeichen.
-- =====================================================================

return {
	de = {
		-- Fenster & Banner
		["shop.title"] = "Shop",
		["shop.banner"] = "Kurse kann man nicht kaufen – alles Spielgeld",
		["shop.bannerSub"] = "Robux geben nur Turm-Vorteile und Kosmetik. Nie AKY, Aktien, Orders, Lizenzen, XP oder Marktinfos.",
		["shop.tab.start"] = "Start",
		["shop.tab.passes"] = "Pässe",
		["shop.tab.boosts"] = "Boosts",
		["shop.tab.credits"] = "CR & Bau",
		["shop.tab.season"] = "Saison",
		["shop.tab.club"] = "Club",
		["shop.section.active"] = "Deine aktiven Vorteile",
		["shop.section.recommended"] = "Empfohlen für dich",
		["shop.section.income"] = "Einkommens-Pässe",
		["shop.section.passes"] = "Komfort & Kosmetik",
		["shop.section.boosts"] = "Persönliche Boosts",
		["shop.section.server"] = "Für den ganzen Server",
		["shop.section.vouchers"] = "Bau-Gutscheine (nur CR)",
		["shop.section.express"] = "Bau-Express",
		["shop.section.season"] = "Skyline-Pass",
		["shop.section.club"] = "Vorstands-Club",
		-- Knöpfe (ruhig, ohne Kaufdruck)
		["shop.details"] = "Details",
		["shop.view"] = "Ansehen",
		["shop.showPrice"] = "Preis anzeigen",
		["shop.continue"] = "Weiter zum Kauf",
		["shop.later"] = "Später",
		["shop.close"] = "Schließen",
		["shop.recalc"] = "Neu berechnen",
		["shop.busy"] = "Einen Moment …",
		-- Preise & Status
		["shop.price"] = "R$ %s",
		["shop.priceMonth"] = "%s / Monat",
		["shop.loadingPrice"] = "Preis lädt …",
		["shop.notSetUp"] = "Bald verfügbar",
		["shop.owned"] = "Besessen",
		["shop.active"] = "Aktiv",
		["shop.disabled"] = "Gerade nicht verfügbar",
		["shop.unknown"] = "Unbekannter Artikel",
		["shop.restricted"] = "In deiner Region nicht verfügbar",
		["shop.studioSim"] = "Studio: Käufe mit Id 0 laufen nur über Admin „Kauf simulieren“.",
		["shop.serviceMissing"] = "Dieser Artikel ist gleich wieder da – versuch es in einer Minute.",
		["shop.passInBundle"] = "Schon im Tycoon-Paket enthalten",
		-- Ehrliche Wirkung
		["shop.effectHeader"] = "Genaue Wirkung",
		["shop.firewall"] = "Wirkt nie auf AKY, Aktien, Orders, Lizenz, XP oder Marktinfos.",
		["shop.robuxNote"] = "Der Kauf läuft über das Roblox-Fenster. Ohne Robux ist alles erspielbar.",
		["shop.together4"] = "x2 + x3 zusammen = x4",
