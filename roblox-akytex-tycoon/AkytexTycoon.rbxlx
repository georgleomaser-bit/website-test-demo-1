-- =====================================================================
-- HELFER
-- =====================================================================
local function pick(pair: any, lang: string): string
	if type(pair) ~= "table" then
		return ""
	end
	local text = pair[lang]
	if type(text) ~= "string" then
		text = pair.en
	end
	return if type(text) == "string" then text else ""
end

-- Tower-Name aus den Bausteinen a (Adjektiv) und n (Nomen); ungültige Indizes -> 1
function Tower.NameText(a: number, n: number, lang: string): string
	local adjList = Tower.Names.Adj
	local nounList = Tower.Names.Noun
	local ai = if type(a) == "number" and adjList[a] then a else 1
	local ni = if type(n) == "number" and nounList[n] then n else 1
	local adj = pick(adjList[ai], lang)
	local noun = pick(nounList[ni], lang)
	local suffix = pick(Tower.Names.Suffix, lang)
	-- Bindestrich-Bausteine ("Kristall-") hängen direkt am Nomen
	if string.sub(adj, -1) == "-" then
		return adj .. noun .. " " .. suffix
	end
	return adj .. " " .. noun .. " " .. suffix
end

-- =====================================================================
-- PRÜFUNG (Config.Validate sammelt alle Meldungen; leer = alles ok)
-- =====================================================================
local function isNum(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function isPair(v: any): boolean
	return type(v) == "table" and type(v.de) == "string" and v.de ~= "" and type(v.en) == "string" and v.en ~= ""
end

function Tower.Validate(_config: any): { string }
	local errors: { string } = {}
	local function add(text: string)
		table.insert(errors, "Config.Tower." .. text)
	end
	local function num(path: string, v: any, lo: number, hi: number)
		if not isNum(v) or v < lo or v > hi then
			add(("%s: Zahl %s … %s erwartet"):format(path, tostring(lo), tostring(hi)))
		end
	end
	local function int(path: string, v: any, lo: number, hi: number)
		if not isNum(v) or v % 1 ~= 0 or v < lo or v > hi then
			add(("%s: ganze Zahl %s … %s erwartet"):format(path, tostring(lo), tostring(hi)))
		end
	end
	local function keyed(path: string, list: any, extra: ((entry: any, where: string) -> ())?): { [string]: any }
		local seen: { [string]: any } = {}
		if type(list) ~= "table" or #list == 0 then
			add(path .. ": Liste erwartet")
			return seen
		end
		for i, entry in ipairs(list) do
			local where = ("%s[%d]"):format(path, i)
			if type(entry) ~= "table" or type(entry.Key) ~= "string" or entry.Key == "" then
				add(where .. ".Key: Text erwartet")
				continue
			end
			assert(seen[entry.Key] == nil, "[Config.Tower] doppelter Schlüssel " .. path .. "." .. entry.Key)
			seen[entry.Key] = entry
			if not isPair(entry.Name) then
				add(where .. ".Name: { de, en } erwartet")
			end
			if extra then
				extra(entry, where)
			end
		end
		return seen
	end

	-- 1) Etagen
	num("I0", Tower.I0, 0.01, 1e6)
	num("IR", Tower.IR, 1, 3)
	int("C2", Tower.C2, 1, 1e9)
	int("Salary", Tower.Salary, 0, 1e6)
	if Tower.Floors ~= 50 then
		add("Floors: 50 erwartet (Stufen-Tabelle §B4.2 endet bei Etage 50)")
	end
	local nextFirst = 3
	for i, band in ipairs(Tower.Bands) do
		local where = ("Bands[%d]"):format(i)
		if type(band) ~= "table" or not isNum(band[1]) or not isNum(band[2]) or not isNum(band[3]) then
			add(where .. ": { erste, letzte, Faktor } erwartet")
			continue
		end
		if band[1] ~= nextFirst or band[2] < band[1] then
			add(where .. ": lückenlose Bänder ab Etage 3 erwartet")
		end
		num(where .. "[3]", band[3], 1, 3)
		nextFirst = band[2] + 1
	end
	if nextFirst ~= 51 then
		add("Bands: müssen genau bis Etage 50 reichen")
	end
	-- teuerste Etage: Kosten < 1e14 (Gate G1)
	local cost = Tower.C2
	for n = 3, 50 do
		for _, band in ipairs(Tower.Bands) do
			if type(band) == "table" and isNum(band[1]) and isNum(band[2]) and n >= band[1] and n <= band[2] then
				cost *= band[3]
			end
		end
	end
	if isNum(cost) and cost >= 1e14 then
		add(("Bands: Etage 50 kostet %.3g ≥ 1e14 (Gate G1)"):format(cost))
	end

	-- 2) Geometrie
	int("FloorHeight", Tower.FloorHeight, 4, 40)
	num("Geometry.Slab", Tower.Geometry.Slab, 0, 4)
	num("Geometry.ElevatorLanding", Tower.Geometry.ElevatorLanding, 0, 40)

	-- 3) Stufen
	keyed("Stages", Tower.Stages, function(entry: any, where: string)
		int(where .. ".First", entry.First, 1, 50)
		int(where .. ".Last", entry.Last, 1, 50)
		int(where .. ".Licence", entry.Licence, 1, 10)
		int(where .. ".Ipo", entry.Ipo, 0, 100)
		if not isPair(entry.Desc) then
			add(where .. ".Desc: { de, en } erwartet")
		end
	end)
	if #Tower.Stages ~= 12 then
		add("Stages: genau 12 Stufen erwartet (§B4.2)")
	end
	local expectFirst = 1
	local lastLicence, lastIpo = 0, 0
	for i, stage in ipairs(Tower.Stages) do
		if type(stage) == "table" and isNum(stage.First) and isNum(stage.Last) then
			if stage.First ~= expectFirst or stage.Last < stage.First then
				add(("Stages[%d]: lückenlose Etagen-Bereiche ab 1 erwartet"):format(i))
			end
			expectFirst = stage.Last + 1
			if isNum(stage.Licence) and stage.Licence < lastLicence then
				add(("Stages[%d].Licence: Tore dürfen nicht sinken"):format(i))
			end
			if isNum(stage.Ipo) and stage.Ipo < lastIpo then
				add(("Stages[%d].Ipo: Tore dürfen nicht sinken"):format(i))
			end
			lastLicence = if isNum(stage.Licence) then stage.Licence else lastLicence
			lastIpo = if isNum(stage.Ipo) then stage.Ipo else lastIpo
		end
	end
	if expectFirst ~= 51 then
		add("Stages: müssen genau bis Etage 50 reichen")
	end

	-- 4) Abteilungen
	local codes: { [string]: boolean } = {}
	local rooms = keyed("Rooms", Tower.Rooms, function(entry: any, where: string)
		num(where .. ".Factor", entry.Factor, 0, 5)
		int(where .. ".MinStage", entry.MinStage, 1, 12)
		if not isPair(entry.Desc) then
			add(where .. ".Desc: { de, en } erwartet")
		end
		if type(entry.Code) ~= "string" or not string.match(entry.Code, "^%u$") then
			add(where .. ".Code: ein Großbuchstabe erwartet")
		elseif codes[entry.Code] then
			add(where .. ".Code: doppelt")
		else
			codes[entry.Code] = true
		end
		if entry.Max ~= nil then
			int(where .. ".Max", entry.Max, 1, 50)
		end
		if entry.StaffMult ~= nil then
			num(where .. ".StaffMult", entry.StaffMult, 1, 3)
			int(where .. ".Radius", entry.Radius, 0, 10)
		end
		if entry.TowerStaffMult ~= nil then
			num(where .. ".TowerStaffMult", entry.TowerStaffMult, 1, 3)
		end
		if entry.NeighbourMult ~= nil then
			num(where .. ".NeighbourMult", entry.NeighbourMult, 1, 3)
		end
		if entry.IncomePct ~= nil then
			num(where .. ".IncomePct", entry.IncomePct, 0, 1)
		end
		if entry.VaultBonus ~= nil then
			num(where .. ".VaultBonus", entry.VaultBonus, 0, 5)
		end
		if entry.OfflineHours ~= nil then
			num(where .. ".OfflineHours", entry.OfflineHours, 0, 24)
		end
		if entry.DecorSlots ~= nil then
			int(where .. ".DecorSlots", entry.DecorSlots, 1, 16)
		end
	end)
	if type(Tower.DefaultRoom) ~= "string" or rooms[Tower.DefaultRoom] == nil then
		add("DefaultRoom: Schlüssel aus Rooms erwartet")
	end
	num("RoomChangePct", Tower.RoomChangePct, 0, 1)

	-- 5) Personal
	local staffCodes: { [string]: boolean } = {}
	keyed("Staff", Tower.Staff, function(entry: any, where: string)
		int(where .. ".MinStage", entry.MinStage, 1, 12)
		if not isPair(entry.Desc) then
			add(where .. ".Desc: { de, en } erwartet")
		end
		if type(entry.Code) ~= "string" or not string.match(entry.Code, "^%u$") then
			add(where .. ".Code: ein Großbuchstabe erwartet")
		elseif staffCodes[entry.Code] then
			add(where .. ".Code: doppelt")
		else
			staffCodes[entry.Code] = true
		end
		if entry.Lobby then
			int(where .. ".Price", entry.Price, 0, 1e13)
		else
			num(where .. ".Bonus", entry.Bonus, 0, 10)
			num(where .. ".CostMult", entry.CostMult, 0, 1000)
		end
	end)
	int("StaffSlots", Tower.StaffSlots, 1, 6)
	int("StaffSlotsPlus", Tower.StaffSlotsPlus, 1, 6)
	if isNum(Tower.StaffSlots) and isNum(Tower.StaffSlotsPlus) and Tower.StaffSlotsPlus < Tower.StaffSlots then
		add("StaffSlotsPlus: mindestens StaffSlots erwartet")
	end

	-- 6) Raum-Stufen & Effizienz
	if #Tower.LevelFactor ~= 5 then
		add("LevelFactor: 5 Stufen erwartet")
	end
	local lastFactor = 0
	for i, factor in ipairs(Tower.LevelFactor) do
		num(("LevelFactor[%d]"):format(i), factor, 0.1, 10)
		if isNum(factor) and factor < lastFactor then
			add(("LevelFactor[%d]: darf nicht sinken"):format(i))
		end
		lastFactor = if isNum(factor) then factor else lastFactor
	end
	if #Tower.LevelCost ~= 4 then
		add("LevelCost: 4 Werte erwartet (L1→L2 … L4→L5)")
	end
	for i, mult in ipairs(Tower.LevelCost) do
		num(("LevelCost[%d]"):format(i), mult, 0, 1000)
	end
	int("UpgradeMin", Tower.UpgradeMin, 0, 1e9)
	num("Efficiency.Step", Tower.Efficiency.Step, 0, 1)
	int("Efficiency.Base", Tower.Efficiency.Base, 1, 1e9)
	num("Efficiency.Ratio", Tower.Efficiency.Ratio, 1, 10)
	int("Efficiency.Max", Tower.Efficiency.Max, 1, 40)
	if
		isNum(Tower.Efficiency.Base)
		and isNum(Tower.Efficiency.Ratio)
		and isNum(Tower.Efficiency.Max)
		and Tower.Efficiency.Base * Tower.Efficiency.Ratio ^ (Tower.Efficiency.Max - 1) >= 1e14
	then
		add("Efficiency: teuerste Stufe ≥ 1e14 (Gate G1)")
	end

	-- 7) Tresor & Offline
	num("VaultMinutes", Tower.VaultMinutes, 1, 240)
	num("VaultFloorBonus", Tower.VaultFloorBonus, 0, 5)
	int("VaultPrefill", Tower.VaultPrefill, 0, 1e9)
	num("CollectRange", Tower.CollectRange, 10, 500)
	num("JanitorSeconds", Tower.JanitorSeconds, 1, 3600)
	num("AutoCollectSeconds", Tower.AutoCollectSeconds, 1, 3600)
	local off = Tower.Offline
	num("Offline.Rate", off.Rate, 0, 1)
	num("Offline.RateMax", off.RateMax, 0, 1)
	num("Offline.CapHours", off.CapHours, 0, 48)
	num("Offline.CapMax", off.CapMax, 0, 48)
	num("Offline.MinAway", off.MinAway, 0, 3600)
	num("Offline.PerkRate", off.PerkRate, 0, 0.2)
	num("Offline.PerkHours", off.PerkHours, 0, 6)
	int("Offline.PerkMax", off.PerkMax, 0, 20)
	num("Offline.PassRate", off.PassRate, 0, 1)
	num("Offline.PassMinHours", off.PassMinHours, 0, 48)
	num("Offline.LoungeHours", off.LoungeHours, 0, 6)
	int("Offline.LoungeMax", off.LoungeMax, 0, 20)
	num("Offline.ClubHours", off.ClubHours, 0, 24)
	if isNum(off.Rate) and isNum(off.RateMax) and off.Rate > off.RateMax then
		add("Offline.Rate: darf nicht über RateMax liegen")
	end
	if isNum(off.CapHours) and isNum(off.CapMax) and off.CapHours > off.CapMax then
		add("Offline.CapHours: darf nicht über CapMax liegen")
	end

	-- 8) Bauen
	local build = Tower.Build
	int("Build.Instant", build.Instant, 0, 50)
	num("Build.SceneSeconds", build.SceneSeconds, 0, 60)
	num("Build.BaseSeconds", build.BaseSeconds, 1, 3600)
	num("Build.Ratio", build.Ratio, 1, 3)
	num("Build.Cap", build.Cap, 1, 86400)
	num("Build.MinFactor", build.MinFactor, 0.01, 1)
	num("Build.HelpPct", build.HelpPct, 0, 0.5)
	int("Build.HelpMax", build.HelpMax, 0, 10)
	num("Build.HelpRange", build.HelpRange, 5, 500)
	int("Build.HelpSeasonXp", build.HelpSeasonXp, 0, 1000)
	num("Build.CrewPct", build.CrewPct, 0, 0.9)
	num("Build.TempoPct", build.TempoPct, 0, 0.2)
	int("Build.TempoMax", build.TempoMax, 0, 10)
	int("Build.DailyInstant", build.DailyInstant, 0, 5)
	int("Build.InstantMax", build.InstantMax, 1, 999)
	int("Build.ExpressMax", build.ExpressMax, 1, 200)
	int("Build.ExpressMaxSeconds", build.ExpressMaxSeconds, 60, 7 * 86400)

	-- 9) Multiplikatoren
	local mult = Tower.Mult
	for _, key in ipairs({ "IpoStep", "GrowthStep", "AlbumStep", "FriendStep", "RespektStep" }) do
		num("Mult." .. key, (mult :: any)[key], 0, 1)
	end
	for _, key in ipairs({ "IpoMax", "GrowthMax", "AlbumMax", "FriendMax", "RespektMax" }) do
		int("Mult." .. key, (mult :: any)[key], 0, 100)
	end
	for _, key in ipairs({ "Vip", "Club", "Premium", "Bull", "Parade", "BellMoment" }) do
		num("Mult." .. key, (mult :: any)[key], 1, 3)
	end
	num("Mult.X2", mult.X2, 1, 10)
	num("Mult.X5", mult.X5, 1, 10)
	num("Mult.ServerMax", mult.ServerMax, 1, 3)
	num("Mult.EventMax", mult.EventMax, 1, 3) -- Event nie > ×3 (§B5.2)
	num("Mult.TimedCap", mult.TimedCap, 1, 10) -- Zeitlich nie > ×10 (§B5.2)
	int("Mult.BoostMaxSeconds", mult.BoostMaxSeconds, 3600, 31536000)
	num("Mult.CostEventMin", mult.CostEventMin, 0.01, 1)
	int("Mult.EventMaxSeconds", mult.EventMaxSeconds, 60, 86400)

	-- 10) Börsengang
	if type(Tower.Ipo.Blitz) ~= "table" or #Tower.Ipo.Blitz ~= 3 then
		add("Ipo.Blitz: 3 Stufen erwartet (4 / 8 / 12)")
	else
		for i, floors in ipairs(Tower.Ipo.Blitz) do
			int(("Ipo.Blitz[%d]"):format(i), floors, 0, 50)
		end
	end
	num("Ipo.BuildPct", Tower.Ipo.BuildPct, 0, 0.1)
	int("Ipo.BuildMax", Tower.Ipo.BuildMax, 0, 20)
	for key, branch in pairs(Tower.Perks) do
		if type(branch) ~= "string" or branch == "" then
			add("Perks." .. tostring(key) .. ": Ast-Name erwartet")
		end
	end
	local lastIpos = 0
	keyed("Crowns", Tower.Crowns, function(entry: any, where: string)
		int(where .. ".Ipos", entry.Ipos, 1, 1000)
		if isNum(entry.Ipos) and entry.Ipos <= lastIpos then
			add(where .. ".Ipos: muss steigen")
		end
		lastIpos = if isNum(entry.Ipos) then entry.Ipos else lastIpos
		if type(entry.Hex) ~= "string" or not string.match(entry.Hex, "^#%x%x%x%x%x%x$") then
			add(where .. ".Hex: #rrggbb erwartet")
		end
	end)

	-- 11) Deko-Ersatz
	int("Decor.SlotsPerFloor", Tower.Decor.SlotsPerFloor, 1, 16)
	int("Decor.PenthouseSlots", Tower.Decor.PenthouseSlots, 1, 16)
	num("Decor.ComfortPct", Tower.Decor.ComfortPct, 0, 0.1)
	num("Decor.ComfortMax", Tower.Decor.ComfortMax, 0, 1)
	int("Decor.ComfortItemMax", Tower.Decor.ComfortItemMax, 1, 20)

	-- 12) Name, Fassaden, Neon
	for _, list in ipairs({ "Adj", "Noun" }) do
		local entries = (Tower.Names :: any)[list]
		if type(entries) ~= "table" or #entries ~= 40 then
			add("Names." .. list .. ": 40 Bausteine erwartet")
		else
			for i, entry in ipairs(entries) do
				if not isPair(entry) then
					add(("Names.%s[%d]: { de, en } erwartet"):format(list, i))
				end
			end
		end
	end
	local function unlockCheck(entry: any, where: string)
		if entry.Unlock ~= "Default" and entry.Unlock ~= "Pass" and entry.Unlock ~= "Cosmetic" then
			add(where .. ".Unlock: Default/Pass/Cosmetic erwartet")
		elseif entry.Unlock == "Pass" and (type(entry.Pass) ~= "string" or entry.Pass == "") then
			add(where .. ".Pass: Pass-Schlüssel erwartet")
		end
	end
	local skins = keyed("Skins", Tower.Skins, unlockCheck)
	if skins[Tower.DefaultSkin] == nil or skins[Tower.DefaultSkin].Unlock ~= "Default" then
		add("DefaultSkin: freie Fassade aus Skins erwartet")
	end
	local neons = keyed("Neon", Tower.Neon, function(entry: any, where: string)
		unlockCheck(entry, where)
		if type(entry.Hex) ~= "string" or not string.match(entry.Hex, "^#%x%x%x%x%x%x$") then
			add(where .. ".Hex: #rrggbb erwartet")
		end
	end)
	if neons[Tower.DefaultNeon] == nil or neons[Tower.DefaultNeon].Unlock ~= "Default" then
		add("DefaultNeon: freie Farbe aus Neon erwartet")
	end

	-- 13) Besuche & Plots
	int("PrivateMax", Tower.PrivateMax, 0, 50)
	num("Visit.TowerRadius", Tower.Visit.TowerRadius, 10, 200)
	num("Visit.SpawnOffset", Tower.Visit.SpawnOffset, 0, 80)
	num("Visit.StreamTimeout", Tower.Visit.StreamTimeout, 0, 10)
	if type(Tower.Visit.SpawnAtPlot) ~= "boolean" then
		add("Visit.SpawnAtPlot: true/false erwartet")
	end
	local fallback = Tower.Visit.PlazaFallback
	if type(fallback) ~= "table" or not isNum(fallback[1]) or not isNum(fallback[2]) or not isNum(fallback[3]) then
		add("Visit.PlazaFallback: { x, y, z } erwartet")
	end
	num("Plots.Radius", Tower.Plots.Radius, 50, 2000)
	num("Plots.StartAngle", Tower.Plots.StartAngle, -360, 360)
	num("Plots.Step", Tower.Plots.Step, 1, 360)
	num("Plots.Size", Tower.Plots.Size, 20, 400)
	num("StageToastCooldown", Tower.StageToastCooldown, 0, 3600)
	return errors
end

return Tower
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Trading</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Orders, Depot, Gewinn-Transfer, Liga, Strategie-Bots, Übungsaktie (Config.Trading)
--  Besitzer: WP4 (Orders, Depot, Bots). Vertrag: DESIGN.md §C14.2 (Trading), §B7.3, §B8, §B11.1, §C9;
--  MARKET.md §11–§13. Alle Geldwerte in CENT (100 = 1 AKY). Prozente als Bruch (0.06 = 6 %).
--  Wird an alle Clients repliziert (Order-Ticket zeigt Grenzen/Chips daraus) -> KEINE Geheimnisse hier!
--
--  Robux-Firewall (§0.4): nichts hier hängt von Pässen, Käufen oder Turm-Werten ab. Bot-Stufen und Plätze kommen
--  nur aus Lizenz + Know-how (ProgressionService.TradingPerks), der Bau-Kurs nur aus der Lizenz.
--
--  Abschnitte:
--    1) Gewinn-Transfer & Rettungsschirm      5) Strategie-Bots (4 Presets §B8.5)
--    2) Order-Ticket & Orders                  6) Tutorial-Übungsaktie ACAD (§B8.6)
--    3) Grenzen je Wert (Liquidität)           7) Feedback & Spam
--    4) Liga & Trader-XP-Regeln                8) Lizenz-Ersatztabelle (nur falls Config.Progression fehlt)
--  Validate(Config): { string }                prüft alle Zahlen (SelfTest / Boot-warn)
-- =====================================================================

local Trading = {}

-- ---------------------------------------------------------------------
-- 1) GEWINN-TRANSFER (AKY -> CR, §B8.2) & RETTUNGSSCHIRM (§B8.4)
--    Abhebbar = max(0, min(freies Cash, Depotwert − Basis, DayCapPct × Basis)), nur wenn Depotwert ≥ Threshold × Basis,
--    höchstens 1× je Börsentag. Den CR-Betrag rechnet der Turm (Bau-Kurs der Lizenz) – der Markt-Code kennt kein CR.
-- ---------------------------------------------------------------------
Trading.Transfer = {
	Threshold = 1.02, -- Depotwert muss mindestens 2 % über der Basis liegen
	DayCapPct = 0.06, -- höchstens 6 % der Basis je Börsentag
	MaxOfflineDays = 72, -- Auto-Transfer beim Offline-Abgleich: höchstens 72 verpasste Börsentage (= 24 h)
}
Trading.Refill = {
	Below = 0.5, -- Starthilfe nur, wenn Depotwert < 50 % der Basis und keine Position/Order offen
	To = 0.5, -- … füllt auf 50 % der Basis auf (1× je UTC-Tag, nie abhebbar)
}

-- ---------------------------------------------------------------------
-- 2) ORDER-TICKET & ORDERS (§B7.3, §C9 TradePlace, MARKET §11)
-- ---------------------------------------------------------------------
Trading.Protect = { Sl = 0.08, Tp = 0.15 } -- "Schutz an": Verlust-Stopp −8 % / Gewinn-Ziel +15 %
Trading.Chips = { 0.10, 0.25, "Max" } -- Betrags-Chips (Prozent vom Depotwert; Max = Klumpen-Grenze bzw. freies Geld)
Trading.ConfirmAbove = 0.20 -- Bestätigung "Sicher? Verteilen ist klüger." ab 20 % des Depotwerts in einem Wert
Trading.MinFeeCents = 100 -- Mindestgebühr 1 AKY je Ausführung
Trading.OrderLife = { DAY = true, H24 = 86400 } -- Laufzeit: bis Börsentag-Ende oder 24 h (Standard)
Trading.SeqWindow = 32 -- Doppelklick-Schutz: die letzten 32 Sequenznummern (rückt auch bei Ablehnung vor)
Trading.FatFinger = 0.5 -- Preise nur innerhalb Kurs × [0,5; 1,5]
Trading.TrailBps = { Min = 50, Max = 2000 } -- Nachzieh-Stopp-Abstand 0,5 % … 20 %
Trading.BuyStopReserve = 1.05 -- Kauf-Stopp reserviert Menge × Stopp × 1,05 + Gebühr (Kurslücken)
Trading.MaxOrdersHard = 50 -- absolute Obergrenze offener Orders je Spieler (§C16), Lizenz-Grenze darunter
Trading.MaxAlertsHard = 18 -- absolute Obergrenze Alarm-Linien (Know-how-Basis 3, +3 je Stufe)
Trading.Watch = { MaxLists = 5, MaxIds = 12 } -- Watchlists (Anzahl aus Know-how), je höchstens 12 Werte
Trading.TraderFrom = 4 -- ab Lizenz 4 (Trader I): Nachzieh-Stopp, Kauf-Stopp, Themen-Körbe
Trading.AlertBand = 0.5 -- Alarm-Linien innerhalb Kurs × [0,5; 1,5]

-- ---------------------------------------------------------------------
-- 3) GRENZEN JE WERT (MARKET §11.6): max. Positionswert = LiquidityBase × Positions-Faktor der Lizenz (×0,01 … ×100)
--    Werte in Cent: Stabil 5 Mio. AKY, Normal 2 Mio., Wild 0,5 Mio., ETF 20 Mio.
-- ---------------------------------------------------------------------
Trading.LiquidityBase = {
	Stabil = 500000000,
	Normal = 200000000,
	Wild = 50000000,
	ETF = 2000000000,
}

-- ---------------------------------------------------------------------
-- 4) LIGA & TRADER-XP-REGELN (§B8.7, §B9.1, §B11.1, MARKET §12.6)
--    Zählender Trade = Verkauf ≥ 2 % des Depotwerts nach ≥ 60 s Haltedauer (kein Bot, kein Admin-Fenster).
--    Zählender Börsentag = ≥ 3 zählende Trades. Teilnahme = ≥ 20 zählende Trades und ≥ 6 zählende Börsentage.
-- ---------------------------------------------------------------------
Trading.MinTradePct = 0.02
Trading.MinHoldSeconds = 60
Trading.ReadWellSeconds = 60 -- "Gut gelesen": Kauf ≤ 60 s nach einer Fakten-News in deren Richtung
Trading.QualifyingTrades = 3
Trading.MinNavStart = 100000 -- Börsentag zählt nur ab Start-Depotwert 1.000 AKY (MARKET §12.6)
Trading.League = {
	MinTrades = 20,
	MinDays = 6,
	MaxReturns = 504, -- höchstens so viele Börsentage je Woche (League.Returns)
	Tiers = { -- absolute Stufen nach Skill-Score (jeder kann eine erreichen)
		{ Key = "Bronze", Min = 300 },
		{ Key = "Silber", Min = 500 },
		{ Key = "Gold", Min = 700 },
		{ Key = "Diamant", Min = 850 },
	},
}

-- ---------------------------------------------------------------------
-- 5) STRATEGIE-BOTS (§B8.5) – handeln das Depot über dieselbe OrderEngine (Flag "Bot"), entscheiden 1× je Minute
--    auf 1m-Schlusskursen -> online = offline. Kapital je Bot nach Bot-Stufe (Know-how) 10/15/20/25/30 % des
--    Depotwerts, alle zusammen ≤ 30 %. Lohn 0,02 % des verwalteten Kapitals je Börsentag. Not-Aus je Bot,
--    Tagesverlust-Bremse −5 % (Bot pausiert bis zur nächsten Glocke).
--    Param: "CashPct" = Anteil des freien Geldes je Börsentag · "Capital" = Kapitalanteil (≤ Bot-Stufe) ·
--           "Drop" = Tagesrückgang, ab dem gekauft wird. Target: "ETF" = ETF-Id · "Inst" = Wert-Id · "None".
-- ---------------------------------------------------------------------
Trading.BotOrder = { "Sparplan", "Trend", "Dividend", "Dip" }
Trading.Bots = {
	Sparplan = {
		Name = { de = "Sparplan-Bot", en = "Savings plan bot" },
		Desc = {
			de = "Kauft jeden Börsentag ein ETF für einen festen Anteil deines freien Geldes.",
			en = "Buys an ETF every trading day for a fixed share of your free money.",
		},
		Licence = 3, -- ab Azubi III
		Param = "CashPct",
		Min = 0.05,
		Max = 0.20,
		Default = 0.10,
		Target = "ETF",
		DefaultTarget = 40, -- AKX36
	},
	Trend = {
		Name = { de = "Trend-Bot", en = "Trend bot" },
		Desc = {
			de = "Kauft, wenn SMA20 über SMA50 steigt (1m-Kerzen), verkauft beim Rückkreuzen, setzt ein Schutz-Paar.",
			en = "Buys when SMA20 crosses above SMA50 (1m candles), sells on the cross back, sets a safety pair.",
		},
		Licence = 4, -- ab Trader I
		Param = "Capital",
		Min = 0.05,
		Max = 0.30,
		Default = 0.10,
		Target = "Inst",
		Fast = 20,
		Slow = 50,
	},
	Dividend = {
		Name = { de = "Dividenden-Bot", en = "Dividend bot" },
		Desc = {
			de = "Hält die 6 Zahler mit der höchsten Dividende gleich gewichtet und gleicht jeden Börsentag aus.",
			en = "Holds the 6 highest-yield payers equally weighted and rebalances every trading day.",
		},
		Licence = 6, -- ab Trader III
		Param = "Capital",
		Min = 0.05,
		Max = 0.30,
		Default = 0.10,
		Target = "None",
		Count = 6,
		Rebalance = 0.10, -- erst ab 10 % Abweichung vom Zielgewicht handeln (spart Gebühren)
	},
	Dip = {
		Name = { de = "Dip-Käufer", en = "Dip buyer" },
		Desc = {
			de = "Kauft einen Wert deiner Watchlist nach einem Tagesrückgang, immer mit Verlust-Stopp.",
			en = "Buys a watchlist stock after a daily drop, always with a loss stop.",
		},
		Licence = 7, -- ab Fondsmanager I
		Param = "Drop",
		Min = 0.03,
		Max = 0.08,
		Default = 0.05,
		Target = "None",
		Slots = 3, -- höchstens 3 gleichzeitige Dip-Positionen (je ein Drittel des Bot-Kapitals)
		Stop = 0.08, -- automatischer Verlust-Stopp −8 %
	},
}
Trading.BotCapital = { 0.10, 0.15, 0.20, 0.25, 0.30 } -- Bot-Stufe 0 … 4 (Know-how-Knoten BotLvl.<Preset>)
Trading.BotTotalPct = 0.30
Trading.BotWageBps = 2 -- 0,02 % des verwalteten Kapitals je Börsentag (AKY-Senke)
Trading.BotDayStop = -0.05
Trading.BotMinOrderCents = 10000 -- Bots handeln nie unter 100 AKY je Order (Gebühren-Schutz)
Trading.OfflineBotHours = 12
Trading.OfflineOrderHours = 24

-- ---------------------------------------------------------------------
-- 6) TUTORIAL-ÜBUNGSAKTIE ACAD (Id 250, §B8.6) – Kurs pro Spieler, nie im Frame, nur per Replay-Remote (1 Hz)
--    100,00 AKY -> News bei t0 + 2 s -> 8 s Lesefenster -> +15 % über 45 s (Smoothstep) -> flach.
--    Kauf nur mit Chip 10 %. Nach 90 s automatischer Verkauf bei +12 %. Einmal je Konto (Flags.TutorialTrade).
-- ---------------------------------------------------------------------
Trading.Tutorial = {
	InstId = 250,
	Start = 10000, -- Cent
	NewsAt = 2,
	ReadSeconds = 8,
	Jump = 0.15,
	Ramp = 45,
	AutoSellAfter = 90,
	AutoSellAt = 0.12,
	Chip = 0.10,
	Timeout = 240, -- danach endet der Übungs-Stream (neu starten möglich, solange nicht abgeschlossen)
	Wiggle = 0.0015, -- kleines, festes Zittern (Sinus, kein Zufall), damit der Chart lebt
}

-- ---------------------------------------------------------------------
-- 7) FEEDBACK & SPAM (§B7.6, MARKET §13)
-- ---------------------------------------------------------------------
Trading.LossStreakWarn = { Trades = 10, Seconds = 120 } -- Tiko-Hinweis + 30-s-Abkühl-Tipp (keine Sperre)
Trading.SpamPerMinute = 50 -- mehr Order-Anfragen pro Minute -> AntiCheat-Hinweis (keine Strafe)

-- ---------------------------------------------------------------------
-- 8) LIZENZ-ERSATZTABELLE (§B9.2) – gilt NUR, wenn Config.Progression.Licences fehlt (Studio-Teiltest).
--    Die echte Tabelle (eine für WP4/WP6/WP9) steht in Config.Progression. Basis in Cent, Gebühr in Basispunkten.
-- ---------------------------------------------------------------------
-- stylua: ignore start
Trading.LicenceFallback = {
	{ Key = "Azubi1",   Basis = 2500000,    BauKurs = 40,    FeeBps = 10, MaxWeight = 0.30, MaxOrders = 5,  PosFactor = 0.01, Layer = "Simple", Set = "Azubi",  BotSlots = 0 },
	{ Key = "Azubi2",   Basis = 5000000,    BauKurs = 200,   FeeBps = 10, MaxWeight = 0.30, MaxOrders = 5,  PosFactor = 0.01, Layer = "Simple", Set = "Azubi",  BotSlots = 0 },
	{ Key = "Azubi3",   Basis = 10000000,   BauKurs = 800,   FeeBps = 10, MaxWeight = 0.30, MaxOrders = 5,  PosFactor = 0.01, Layer = "Simple", Set = "Azubi",  BotSlots = 1 },
	{ Key = "Trader1",  Basis = 25000000,   BauKurs = 1500,  FeeBps = 8,  MaxWeight = 0.40, MaxOrders = 15, PosFactor = 0.2,  Layer = "Trader", Set = "Trader", BotSlots = 2 },
	{ Key = "Trader2",  Basis = 60000000,   BauKurs = 3000,  FeeBps = 8,  MaxWeight = 0.40, MaxOrders = 15, PosFactor = 0.2,  Layer = "Trader", Set = "Trader", BotSlots = 2 },
	{ Key = "Trader3",  Basis = 150000000,  BauKurs = 6000,  FeeBps = 8,  MaxWeight = 0.40, MaxOrders = 15, PosFactor = 0.2,  Layer = "Trader", Set = "Trader", BotSlots = 3 },
	{ Key = "Fonds1",   Basis = 400000000,  BauKurs = 12000, FeeBps = 5,  MaxWeight = 0.50, MaxOrders = 30, PosFactor = 5,    Layer = "Pro",    Set = "Fonds",  BotSlots = 4 },
	{ Key = "Fonds2",   Basis = 1000000000, BauKurs = 20000, FeeBps = 5,  MaxWeight = 0.50, MaxOrders = 30, PosFactor = 5,    Layer = "Pro",    Set = "Fonds",  BotSlots = 4 },
	{ Key = "Fonds3",   Basis = 2500000000, BauKurs = 30000, FeeBps = 5,  MaxWeight = 0.50, MaxOrders = 30, PosFactor = 5,    Layer = "Pro",    Set = "Fonds",  BotSlots = 4 },
	{ Key = "Legende",  Basis = 6000000000, BauKurs = 40000, FeeBps = 3,  MaxWeight = 0.60, MaxOrders = 50, PosFactor = 100,  Layer = "Pro",    Set = "Fonds",  BotSlots = 5 },
}
-- stylua: ignore end

-- ---------------------------------------------------------------------
-- PRÜFUNG (Config.Validate sammelt alle Meldungen; leer = alles ok)
-- ---------------------------------------------------------------------
local function isNum(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

function Trading.Validate(_config: any): { string }
	local errors: { string } = {}
	local function add(text: string)
		table.insert(errors, "Config.Trading." .. text)
	end
	local function frac(path: string, v: any, lo: number, hi: number)
		if not isNum(v) or v < lo or v > hi then
			add(("%s: Zahl %s … %s erwartet"):format(path, tostring(lo), tostring(hi)))
		end
	end
	local function intMin(path: string, v: any, lo: number)
		if not isNum(v) or v % 1 ~= 0 or v < lo then
			add(("%s: ganze Zahl ≥ %s erwartet"):format(path, tostring(lo)))
		end
	end

	frac("Transfer.Threshold", Trading.Transfer.Threshold, 1, 2)
	frac("Transfer.DayCapPct", Trading.Transfer.DayCapPct, 0, 1)
	intMin("Transfer.MaxOfflineDays", Trading.Transfer.MaxOfflineDays, 0)
	frac("Refill.Below", Trading.Refill.Below, 0, 1)
	frac("Refill.To", Trading.Refill.To, 0, 1)
	if
		isNum(Trading.Refill.To)
		and isNum(Trading.Transfer.Threshold)
		and Trading.Refill.To >= Trading.Transfer.Threshold
	then
		add("Refill.To: muss unter Transfer.Threshold liegen (Starthilfe nie abhebbar)")
	end
	frac("Protect.Sl", Trading.Protect.Sl, 0.01, 0.5)
	frac("Protect.Tp", Trading.Protect.Tp, 0.01, 1)
	if type(Trading.Chips) ~= "table" or #Trading.Chips ~= 3 or Trading.Chips[3] ~= "Max" then
		add('Chips: { 0.10, 0.25, "Max" } erwartet')
	else
		frac("Chips[1]", Trading.Chips[1], 0.01, 0.5)
		frac("Chips[2]", Trading.Chips[2], 0.01, 0.5)
	end
	frac("ConfirmAbove", Trading.ConfirmAbove, 0, 1)
	intMin("MinFeeCents", Trading.MinFeeCents, 0)
	if Trading.OrderLife.DAY ~= true then
		add("OrderLife.DAY: true erwartet")
	end
	intMin("OrderLife.H24", Trading.OrderLife.H24, 60)
	if isNum(Trading.OrderLife.H24) and Trading.OrderLife.H24 > Trading.OfflineOrderHours * 3600 then
		add("OrderLife.H24: darf nicht länger als OfflineOrderHours sein (Offline-Abgleich)")
	end
	intMin("SeqWindow", Trading.SeqWindow, 4)
	frac("FatFinger", Trading.FatFinger, 0.05, 0.9)
	intMin("TrailBps.Min", Trading.TrailBps.Min, 1)
	intMin("TrailBps.Max", Trading.TrailBps.Max, 1)
	if isNum(Trading.TrailBps.Min) and isNum(Trading.TrailBps.Max) and Trading.TrailBps.Min > Trading.TrailBps.Max then
		add("TrailBps: Min ≤ Max erwartet")
	end
	frac("BuyStopReserve", Trading.BuyStopReserve, 1, 2)
	intMin("MaxOrdersHard", Trading.MaxOrdersHard, 1)
	if isNum(Trading.MaxOrdersHard) and Trading.MaxOrdersHard > 50 then
		add("MaxOrdersHard: höchstens 50 (§C16)")
	end
	intMin("MaxAlertsHard", Trading.MaxAlertsHard, 1)
	if isNum(Trading.MaxAlertsHard) and Trading.MaxAlertsHard > 18 then
		add("MaxAlertsHard: höchstens 18 (§C16)")
	end
	intMin("Watch.MaxLists", Trading.Watch.MaxLists, 1)
	intMin("Watch.MaxIds", Trading.Watch.MaxIds, 1)
	intMin("TraderFrom", Trading.TraderFrom, 1)
	frac("AlertBand", Trading.AlertBand, 0.05, 0.95)
	for _, class in ipairs({ "Stabil", "Normal", "Wild", "ETF" }) do
		intMin("LiquidityBase." .. class, (Trading.LiquidityBase :: any)[class], 1)
	end
	frac("MinTradePct", Trading.MinTradePct, 0, 1)
	intMin("MinHoldSeconds", Trading.MinHoldSeconds, 0)
	intMin("ReadWellSeconds", Trading.ReadWellSeconds, 1)
	intMin("QualifyingTrades", Trading.QualifyingTrades, 1)
	intMin("MinNavStart", Trading.MinNavStart, 0)
	intMin("League.MinTrades", Trading.League.MinTrades, 0)
	intMin("League.MinDays", Trading.League.MinDays, 0)
	intMin("League.MaxReturns", Trading.League.MaxReturns, 1)
	local lastMin = -1
	for i, tier in ipairs(Trading.League.Tiers) do
		if type(tier.Key) ~= "string" or not isNum(tier.Min) or tier.Min <= lastMin or tier.Min > 1000 then
			add(("League.Tiers[%d]: Key + aufsteigendes Min (0–1000) erwartet"):format(i))
		else
			lastMin = tier.Min
		end
	end
	local seen: { [string]: boolean } = {}
	for _, key in ipairs(Trading.BotOrder) do
		local preset = (Trading.Bots :: any)[key]
		if type(preset) ~= "table" then
			add("Bots." .. tostring(key) .. ": fehlt")
			continue
		end
		assert(not seen[key], "[Config.Trading] doppelter Bot " .. tostring(key))
		seen[key] = true
		intMin("Bots." .. key .. ".Licence", preset.Licence, 1)
		frac("Bots." .. key .. ".Min", preset.Min, 0, 1)
		frac("Bots." .. key .. ".Max", preset.Max, 0, 1)
		frac("Bots." .. key .. ".Default", preset.Default, 0, 1)
		if isNum(preset.Min) and isNum(preset.Max) and isNum(preset.Default) then
			if preset.Min > preset.Default or preset.Default > preset.Max then
				add("Bots." .. key .. ": Min ≤ Default ≤ Max erwartet")
			end
		end
		if preset.Param ~= "CashPct" and preset.Param ~= "Capital" and preset.Param ~= "Drop" then
			add("Bots." .. key .. ".Param: CashPct/Capital/Drop erwartet")
		end
		if preset.Target ~= "ETF" and preset.Target ~= "Inst" and preset.Target ~= "None" then
			add("Bots." .. key .. ".Target: ETF/Inst/None erwartet")
		end
		if type(preset.Name) ~= "table" or type(preset.Name.de) ~= "string" or type(preset.Name.en) ~= "string" then
			add("Bots." .. key .. ".Name: { de, en } erwartet")
		end
	end
	for key in pairs(Trading.Bots) do
		if not seen[key] then
			add("Bots." .. tostring(key) .. ": fehlt in BotOrder")
		end
	end
	if isNum(Trading.Bots.Trend.Fast) and isNum(Trading.Bots.Trend.Slow) then
		if Trading.Bots.Trend.Fast < 2 or Trading.Bots.Trend.Fast >= Trading.Bots.Trend.Slow then
			add("Bots.Trend: 2 ≤ Fast < Slow erwartet")
		end
	else
		add("Bots.Trend.Fast/Slow: Zahlen erwartet")
	end
	intMin("Bots.Dividend.Count", Trading.Bots.Dividend.Count, 1)
	intMin("Bots.Dip.Slots", Trading.Bots.Dip.Slots, 1)
	frac("Bots.Dip.Stop", Trading.Bots.Dip.Stop, 0.01, 0.5)
	if #Trading.BotCapital ~= 5 then
		add("BotCapital: 5 Stufen erwartet")
	end
	for i, pct in ipairs(Trading.BotCapital) do
		frac(("BotCapital[%d]"):format(i), pct, 0, 1)
		if isNum(pct) and isNum(Trading.BotTotalPct) and pct > Trading.BotTotalPct then
			add(("BotCapital[%d]: höher als BotTotalPct"):format(i))
		end
	end
	frac("BotTotalPct", Trading.BotTotalPct, 0, 1)
	frac("BotWageBps", Trading.BotWageBps, 0, 100)
	frac("BotDayStop", Trading.BotDayStop, -1, 0)
	intMin("BotMinOrderCents", Trading.BotMinOrderCents, 0)
	frac("OfflineBotHours", Trading.OfflineBotHours, 0, 24)
	frac("OfflineOrderHours", Trading.OfflineOrderHours, 1, 24)
	local tut = Trading.Tutorial
	intMin("Tutorial.InstId", tut.InstId, 1)
	intMin("Tutorial.Start", tut.Start, 100)
	intMin("Tutorial.NewsAt", tut.NewsAt, 0)
	intMin("Tutorial.ReadSeconds", tut.ReadSeconds, 0)
	frac("Tutorial.Jump", tut.Jump, 0, 1)
	intMin("Tutorial.Ramp", tut.Ramp, 1)
	intMin("Tutorial.AutoSellAfter", tut.AutoSellAfter, 1)
	frac("Tutorial.AutoSellAt", tut.AutoSellAt, 0, 1)
	frac("Tutorial.Chip", tut.Chip, 0.01, 0.3)
	intMin("Tutorial.Timeout", tut.Timeout, 30)
	frac("Tutorial.Wiggle", tut.Wiggle, 0, 0.01)
	if isNum(tut.Timeout) and isNum(tut.AutoSellAfter) and tut.Timeout <= tut.AutoSellAfter then
		add("Tutorial.Timeout: muss länger als AutoSellAfter sein")
	end
	intMin("LossStreakWarn.Trades", Trading.LossStreakWarn.Trades, 1)
	intMin("LossStreakWarn.Seconds", Trading.LossStreakWarn.Seconds, 1)
	intMin("SpamPerMinute", Trading.SpamPerMinute, 1)
	if #Trading.LicenceFallback ~= 10 then
		add("LicenceFallback: 10 Lizenzen erwartet")
	end
	local lastBasis = 0
	for i, lic in ipairs(Trading.LicenceFallback) do
		local where = ("LicenceFallback[%d]"):format(i)
		intMin(where .. ".Basis", lic.Basis, 1)
		if isNum(lic.Basis) and lic.Basis <= lastBasis then
			add(where .. ".Basis: muss mit der Lizenz steigen")
		end
		lastBasis = if isNum(lic.Basis) then lic.Basis else lastBasis
		frac(where .. ".FeeBps", lic.FeeBps, 0, 100)
		frac(where .. ".MaxWeight", lic.MaxWeight, 0.05, 1)
		intMin(where .. ".MaxOrders", lic.MaxOrders, 1)
		frac(where .. ".PosFactor", lic.PosFactor, 0, 1000)
		intMin(where .. ".BotSlots", lic.BotSlots, 0)
		if lic.Set ~= "Azubi" and lic.Set ~= "Trader" and lic.Set ~= "Fonds" then
			add(where .. ".Set: Azubi/Trader/Fonds erwartet")
		end
	end
	return errors
end

return Trading
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Vehicles</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Autos, Klassen, Tuning, Garage (Config.Vehicles)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §C14.2 (Vehicles), §B12.1 (16 Autos, Klassen-Tempo,
--  Boost, Drift, Kollisionsgruppen, Garage, Tuning, Aktionärs-Rabatt), §B14.1 (VIP-Lack „Platin“, Pass Λ-1, Mega-Garage),
--  §0.4 (Robux berühren nie AKY; Fluss Depot -> Turm beim Rabatt ist erlaubt, nie umgekehrt).
--  Alle Zahlen sind Startwerte und 1:1 änderbar. Wird an alle Clients repliziert -> KEINE Geheimnisse hier!
--
--  Abschnitte:
--    1) Klassen (Höchsttempo Studs/s, Beschleunigung)     5) Tuning (24 Lacke, 8 Felgen, 6 Unterboden-Farben, Spoiler)
--    2) Die 16 Autos (§B12.1)                             6) Garage, Spawn, Despawn, Rabatt
--    3) Boost & Drift                                     7) Fahrphysik (Constraints) + Tempo-Prüfung (Server 5 Hz)
--    4) Herkunft (Source) & Freischaltung                 8) Prüfung
--  Helfer:   Vehicles.Car(key): entry?     Vehicles.Cap(key): number     Vehicles.Option(kind, key): entry?
--            Vehicles.TunePrice(carKey, kind, optionKey): number      Vehicles.Validate(Config): { string }
--  Geld: CR ganzzahlig, jeder Preis < 1e14 (Config.Validate prüft "Price" überall).
-- =====================================================================

local Vehicles = {}

local function slot(): { [string]: any }
	return { MeshId = 0, TextureId = 0, Scale = 1, Offset = CFrame.identity }
end

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- ---------------------------------------------------------------------
-- 1) KLASSEN – Höchsttempo je Klasse (Studs/s, §B12.1); Server prüft 5 Hz mit 1,3 × Deckel
-- ---------------------------------------------------------------------
Vehicles.Classes = { Kompakt = 60, Limousine = 75, Sport = 95, Super = 120, Hyper = 150 }
Vehicles.ClassOrder = { "Kompakt", "Limousine", "Sport", "Super", "Hyper" }
Vehicles.ClassInfo = {
	Kompakt = { Accel = 30, Name = { de = "Kompakt", en = "Compact" }, Color = rgb(125, 136, 154) },
	Limousine = { Accel = 34, Name = { de = "Limousine", en = "Sedan" }, Color = rgb(79, 140, 255) },
	Sport = { Accel = 46, Name = { de = "Sport", en = "Sport" }, Color = rgb(34, 197, 94) },
	Super = { Accel = 58, Name = { de = "Super", en = "Super" }, Color = rgb(139, 92, 246) },
	Hyper = { Accel = 72, Name = { de = "Hyper", en = "Hyper" }, Color = rgb(179, 107, 255) },
}
-- Bezugswert für Tuning-Preise von Autos ohne CR-Preis (Gratis, Login, Pass, Lizenz)
Vehicles.ClassValue =
	{ Kompakt = 25000, Limousine = 750000, Sport = 60000000, Super = 6000000000, Hyper = 600000000000 }

-- ---------------------------------------------------------------------
-- 2) DIE 16 AUTOS (§B12.1) – Recipe = Bauplan in Shared/VehicleModels.Recipes, Asset = optionales Mesh der Karosserie
--    Source: Free (gratis) · Shop (CR-Preis) · Starter (Starter-Paket) · Login (Login-Tag) · Licence (Lizenz-Index) ·
--            Season (Skyline-Pass) · Pass (Gamepass)
--    Maker = "Velocitra" -> Aktionärs-Rabatt möglich. Display = steht auf einem Drehteller im Showroom von Λ Motors.
-- ---------------------------------------------------------------------
-- stylua: ignore start
Vehicles.Cars = {
	{ Key = "LamCity", Name = { de = "Λ City", en = "Λ City" }, Class = "Kompakt", Price = 0, Source = "Free",
		Recipe = "LamCity", Paint = "Polar", Asset = slot(), SoundId = 0, Display = false },
	{ Key = "VoltaHatch", Name = { de = "Volta Hatch", en = "Volta Hatch" }, Class = "Kompakt", Price = 25000, Source = "Shop",
		Recipe = "VoltaHatch", Paint = "Cyan", Asset = slot(), SoundId = 0, Display = true },
	{ Key = "PixelMini", Name = { de = "Pixel Mini", en = "Pixel Mini" }, Class = "Kompakt", Price = 120000, Source = "Shop",
		Recipe = "PixelMini", Paint = "Pink", Asset = slot(), SoundId = 0, Display = true },
	{ Key = "LamNeon", Name = { de = "Λ Kompakt Neon", en = "Λ Compact Neon" }, Class = "Kompakt", Price = 0, Source = "Starter",
		Recipe = "LamNeon", Paint = "Midnight", Asset = slot(), SoundId = 0, Display = false },
	{ Key = "Stratos", Name = { de = "Stratos Sedan", en = "Stratos Sedan" }, Class = "Limousine", Price = 750000, Source = "Shop",
		Recipe = "Stratos", Paint = "SilverM", Asset = slot(), SoundId = 0, Display = true },
	{ Key = "Nordlicht", Name = { de = "Nordlicht Executive", en = "Nordlicht Executive" }, Class = "Limousine", Price = 4000000,
		Source = "Shop", Recipe = "Nordlicht", Paint = "BlackM", Asset = slot(), SoundId = 0, Display = true },
	{ Key = "VelocitraS", Name = { de = "Velocitra S", en = "Velocitra S" }, Class = "Sport", Price = 60000000, Source = "Shop",
		Recipe = "VelocitraS", Paint = "Red", Asset = slot(), SoundId = 0, Display = true, Maker = "Velocitra" },
	{ Key = "NeonCoupe", Name = { de = "Neon Coupé", en = "Neon Coupé" }, Class = "Sport", Price = 250000000, Source = "Shop",
		Recipe = "NeonCoupe", Paint = "Accent", Asset = slot(), SoundId = 0, Display = true },
	{ Key = "StreakGT", Name = { de = "Streak-GT", en = "Streak GT" }, Class = "Sport", Price = 0, Source = "Login", LoginDay = 28,
		Recipe = "StreakGT", Paint = "Orange", Asset = slot(), SoundId = 0, Display = false },
	{ Key = "Kometa", Name = { de = "Kometa SL", en = "Kometa SL" }, Class = "Super", Price = 6000000000, Source = "Shop",
		Recipe = "Kometa", Paint = "TitanM", Asset = slot(), SoundId = 0, Display = true },
	{ Key = "AuroraGT", Name = { de = "Aurora GT", en = "Aurora GT" }, Class = "Super", Price = 40000000000, Source = "Shop",
		Recipe = "AuroraGT", Paint = "GreenM", Asset = slot(), SoundId = 0, Display = true },
	{ Key = "QuasarX", Name = { de = "Quasar X", en = "Quasar X" }, Class = "Hyper", Price = 600000000000, Source = "Shop",
		Recipe = "QuasarX", Paint = "CosmosM", Asset = slot(), SoundId = 0, Display = true },
	{ Key = "VelocitraH", Name = { de = "Velocitra Hyper", en = "Velocitra Hyper" }, Class = "Hyper", Price = 4000000000000,
		Source = "Shop", Recipe = "VelocitraH", Paint = "RedM", Asset = slot(), SoundId = 0, Display = true, Maker = "Velocitra" },
	{ Key = "Singularity", Name = { de = "Singularity", en = "Singularity" }, Class = "Hyper", Price = 0, Source = "Licence",
		Licence = 10, Recipe = "Singularity", Paint = "BlackM", Asset = slot(), SoundId = 0, Display = true },
	{ Key = "OrbitR", Name = { de = "Orbit-R", en = "Orbit-R" }, Class = "Hyper", Price = 0, Source = "Season",
		Season = 1, Tier = 50, Recipe = "OrbitR", Paint = "NebulaM", Asset = slot(), SoundId = 0, Display = false },
	{ Key = "Lam1", Name = { de = "ΛKYTEX Λ-1", en = "ΛKYTEX Λ-1" }, Class = "Hyper", Price = 0, Source = "Pass", Pass = "Lam1",
		Recipe = "Lam1", Paint = "Arctic", Asset = slot(), SoundId = 0, Display = true, Trail = true },
}
-- stylua: ignore end

-- ---------------------------------------------------------------------
-- 3) BOOST & DRIFT (§B12.1)
-- ---------------------------------------------------------------------
Vehicles.Boost = { Mult = 1.25, Seconds = 3, Cooldown = 8 } -- +25 % für 3 s, 8 s Abklingzeit
Vehicles.DriftFriction = 0.3 -- Handbremse: Hinterrad-Reibung

-- ---------------------------------------------------------------------
-- 4) HERKUNFT – Anzeige-Texte stehen in Lang ("car.source.<Source>")
-- ---------------------------------------------------------------------
Vehicles.Sources =
	{ Free = true, Shop = true, Starter = true, Login = true, Licence = true, Season = true, Pass = true }

-- ---------------------------------------------------------------------
-- 5) TUNING (CR) – Preis = max(Base, Bezugswert des Autos × Pct) (Bezugswert = CR-Preis oder ClassValue)
--    Unlock: Default (alle) · Pass (Gamepass, z. B. VIP-Lack „Platin“) · Club (Vorstands-Club, Monats-Lack)
-- ---------------------------------------------------------------------
Vehicles.TuneCost = {
	Paint = { Base = 2500, Pct = 0.004 },
	Metallic = { Base = 7500, Pct = 0.008 },
	Rims = { Base = 4000, Pct = 0.006 },
	Glow = { Base = 6000, Pct = 0.005 },
	Spoiler = { Base = 10000, Pct = 0.01 },
}
-- stylua: ignore start
Vehicles.Paints = {
	{ Key = "Polar", Name = { de = "Polarweiß", en = "Polar White" }, Color = rgb(232, 235, 240), Metallic = false, Unlock = "Default" },
	{ Key = "Graphite", Name = { de = "Graphit", en = "Graphite" }, Color = rgb(43, 47, 54), Metallic = false, Unlock = "Default" },
	{ Key = "Midnight", Name = { de = "Mitternacht", en = "Midnight" }, Color = rgb(15, 22, 38), Metallic = false, Unlock = "Default" },
	{ Key = "Accent", Name = { de = "Akzentblau", en = "Accent Blue" }, Color = rgb(79, 140, 255), Metallic = false, Unlock = "Default" },
	{ Key = "Deep", Name = { de = "Tiefblau", en = "Deep Blue" }, Color = rgb(41, 98, 255), Metallic = false, Unlock = "Default" },
	{ Key = "Red", Name = { de = "Signalrot", en = "Signal Red" }, Color = rgb(239, 68, 68), Metallic = false, Unlock = "Default" },
	{ Key = "Green", Name = { de = "Grün", en = "Green" }, Color = rgb(34, 197, 94), Metallic = false, Unlock = "Default" },
	{ Key = "Purple", Name = { de = "Violett", en = "Purple" }, Color = rgb(139, 92, 246), Metallic = false, Unlock = "Default" },
	{ Key = "Orange", Name = { de = "Orange", en = "Orange" }, Color = rgb(245, 158, 11), Metallic = false, Unlock = "Default" },
	{ Key = "Pink", Name = { de = "Pink", en = "Pink" }, Color = rgb(236, 72, 153), Metallic = false, Unlock = "Default" },
	{ Key = "Cyan", Name = { de = "Cyan", en = "Cyan" }, Color = rgb(34, 211, 238), Metallic = false, Unlock = "Default" },
	{ Key = "Sand", Name = { de = "Sand", en = "Sand" }, Color = rgb(201, 169, 110), Metallic = false, Unlock = "Default" },
	{ Key = "SilverM", Name = { de = "Silber Metallic", en = "Silver Metallic" }, Color = rgb(184, 192, 204), Metallic = true, Unlock = "Default" },
	{ Key = "BlueM", Name = { de = "Blau Metallic", en = "Blue Metallic" }, Color = rgb(59, 91, 219), Metallic = true, Unlock = "Default" },
	{ Key = "RedM", Name = { de = "Rot Metallic", en = "Red Metallic" }, Color = rgb(185, 28, 28), Metallic = true, Unlock = "Default" },
	{ Key = "GreenM", Name = { de = "Grün Metallic", en = "Green Metallic" }, Color = rgb(21, 128, 61), Metallic = true, Unlock = "Default" },
	{ Key = "CosmosM", Name = { de = "Kosmos Metallic", en = "Cosmos Metallic" }, Color = rgb(124, 92, 255), Metallic = true, Unlock = "Default" },
	{ Key = "NebulaM", Name = { de = "Nebula Metallic", en = "Nebula Metallic" }, Color = rgb(179, 107, 255), Metallic = true, Unlock = "Default" },
	{ Key = "ChampagneM", Name = { de = "Champagner Metallic", en = "Champagne Metallic" }, Color = rgb(214, 183, 106), Metallic = true, Unlock = "Default" },
	{ Key = "TitanM", Name = { de = "Titan Metallic", en = "Titanium Metallic" }, Color = rgb(107, 114, 128), Metallic = true, Unlock = "Default" },
	{ Key = "BlackM", Name = { de = "Schwarz Metallic", en = "Black Metallic" }, Color = rgb(17, 19, 24), Metallic = true, Unlock = "Default" },
	{ Key = "Arctic", Name = { de = "Arktis Perlmutt", en = "Arctic Pearl" }, Color = rgb(223, 231, 242), Metallic = true, Unlock = "Default" },
	{ Key = "Platin", Name = { de = "Platin", en = "Platinum" }, Color = rgb(229, 228, 226), Metallic = true, Unlock = "Pass", Pass = "VIP" },
	{ Key = "ClubNoir", Name = { de = "Club Noir", en = "Club Noir" }, Color = rgb(27, 21, 48), Metallic = true, Unlock = "Club" },
}
Vehicles.Rims = {
	{ Key = "Stock", Name = { de = "Serie", en = "Stock" }, Color = rgb(170, 178, 190), Style = "Disc", Unlock = "Default" },
	{ Key = "Black", Name = { de = "Schwarz", en = "Black" }, Color = rgb(22, 24, 30), Style = "Spoke", Unlock = "Default" },
	{ Key = "Chrome", Name = { de = "Chrom", en = "Chrome" }, Color = rgb(225, 230, 238), Style = "Spoke", Unlock = "Default" },
	{ Key = "Carbon", Name = { de = "Carbon", en = "Carbon" }, Color = rgb(36, 38, 44), Style = "Turbine", Unlock = "Default" },
	{ Key = "NeonBlue", Name = { de = "Neon Blau", en = "Neon Blue" }, Color = rgb(79, 140, 255), Style = "Neon", Unlock = "Default" },
	{ Key = "NeonGreen", Name = { de = "Neon Grün", en = "Neon Green" }, Color = rgb(34, 197, 94), Style = "Neon", Unlock = "Default" },
	{ Key = "White", Name = { de = "Weiß", en = "White" }, Color = rgb(240, 242, 246), Style = "Disc", Unlock = "Default" },
	{ Key = "Turbine", Name = { de = "Turbine", en = "Turbine" }, Color = rgb(124, 92, 255), Style = "Turbine", Unlock = "Default" },
}
Vehicles.Glow = { -- Neon-Unterbodenlicht (PointLight im Licht-Budget); "Off" = aus (gratis)
	{ Key = "Blue", Name = { de = "Blau", en = "Blue" }, Color = rgb(79, 140, 255), Unlock = "Default" },
	{ Key = "Green", Name = { de = "Grün", en = "Green" }, Color = rgb(34, 197, 94), Unlock = "Default" },
	{ Key = "Red", Name = { de = "Rot", en = "Red" }, Color = rgb(239, 68, 68), Unlock = "Default" },
	{ Key = "Violet", Name = { de = "Violett", en = "Violet" }, Color = rgb(139, 92, 246), Unlock = "Default" },
	{ Key = "Cyan", Name = { de = "Cyan", en = "Cyan" }, Color = rgb(34, 211, 238), Unlock = "Default" },
	{ Key = "Cosmic", Name = { de = "Kosmos", en = "Cosmic" }, Color = rgb(179, 107, 255), Unlock = "Default" },
}
-- stylua: ignore end
Vehicles.GlowOff = "Off"
Vehicles.DefaultRims = "Stock"

-- ---------------------------------------------------------------------
-- 6) GARAGE, SPAWN, DESPAWN, RABATT
-- ---------------------------------------------------------------------
Vehicles.GarageBase = 6 -- Plätze
Vehicles.GarageLevelSlots = 4 -- je Garagen-Ebene im Tower (Abteilung "Garage")
Vehicles.GarageLevelsMax = 2
Vehicles.MegaGarageSlots = 12 -- Pass "MegaGarage"
Vehicles.DespawnSeconds = 60 -- Auto verschwindet 60 s nach dem Aussteigen
Vehicles.SpawnCooldown = 3 -- = Request-Rate CarSpawn 1/3 s
Vehicles.ShareholderDiscount = { I = 15, Min = 50, Pct = 0.10 } -- ≥ 50 Anteile VLCT -> −10 % auf Velocitra-Autos
-- Spawnpunkte (Fußpunkte, Blick = Fahrtrichtung). "Garage" = vor dem eigenen Plot (CityService.PlotSite).
Vehicles.SpawnPoints = {
	{ Key = "Plaza", Position = Vector3.new(-26, 0.25, 214), Facing = Vector3.new(0, 0, 1) },
	{ Key = "Motors", Position = Vector3.new(-655, 0.25, 0), Facing = Vector3.new(1, 0, 0) },
	{ Key = "Helipad", Position = Vector3.new(705, 0.25, 26), Facing = Vector3.new(-1, 0, 0) },
}
Vehicles.GarageSpawnOffset = 68 -- Studs vor der Plot-Mitte (auf der Einfahrt)
-- Probefahrt im Autohaus Λ Motors (§A5 „Probefahrt-Startpunkt“, Besitzer-Wunsch 14): jedes CR-Auto, nur am Autohaus,
-- Start am Spawnpunkt "Motors", Serien-Lack, verschwindet nach Seconds; danach Cooldown
Vehicles.TestDrive = { Seconds = 90, Cooldown = 120, Range = 140, Spawn = "Motors" }

-- ---------------------------------------------------------------------
-- 7) FAHRPHYSIK (VehicleSeat + HingeConstraint-Motoren, Servo-Lenkung, SpringConstraint-Federung) & TEMPO-PRÜFUNG
--    Feinschliff in Studio: diese Werte ändern, nicht den Code.
-- ---------------------------------------------------------------------
Vehicles.Physics = {
	ChassisDensity = 2.2,
	WheelDensity = 0.9,
	PartDensity = 0.05, -- Federbeine/Achsschenkel
	FrontFriction = 1.7,
	RearFriction = 1.5,
	FrictionWeight = 4,
	SpringTravel = 0.9, -- Federweg ± (Studs)
	SpringCompression = 0.45, -- Einfederung im Stand
	SpringDampingRatio = 0.55,
	SteerMax = 34, -- Grad bei Schritttempo
	SteerMin = 9, -- Grad bei Höchsttempo
	SteerSpeed = 7, -- rad/s Servo
	TorqueFactor = 1.4, -- Motormoment relativ zu Gewicht × Radius
	BrakeFactor = 2.2,
	CoastTorque = 0.08,
	Downforce = 0.6, -- Zusatz-Anpressdruck bei Höchsttempo (Anteil Gewicht)
	FlipSeconds = 2, -- so lange auf dem Dach -> automatisch aufrichten
	ReverseFactor = 0.35, -- Rückwärts höchstens 35 % des Deckels
}
Vehicles.SpeedCheck = {
	Hz = 5, -- Server prüft 5×/s (§B12.1)
	Factor = 1.3, -- > 1,3 × Klassen-Deckel -> Tempo zurücksetzen + Verdachtspunkte
	Strikes = 2, -- so viele Messungen hintereinander über der Grenze
	OwnerBack = 0.6, -- Sekunden Server-Besitz nach dem Zurücksetzen
	FallY = -60, -- tiefer = Auto weg (aus der Welt gefallen)
}

-- =====================================================================
-- HELFER
-- =====================================================================
local HUGE = math.huge
local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= HUGE and n ~= -HUGE
end

local carIndex: { [string]: any } = {}
for _, car in ipairs(Vehicles.Cars) do
	assert(carIndex[car.Key] == nil, "[Config.Vehicles] doppelter Auto-Schlüssel " .. tostring(car.Key))
	carIndex[car.Key] = car
end

local optionIndex: { [string]: { [string]: any } } = { Paint = {}, Rims = {}, Glow = {} }
for kind, list in pairs({ Paint = Vehicles.Paints, Rims = Vehicles.Rims, Glow = Vehicles.Glow }) do
	for _, entry in ipairs(list) do
		assert(
			optionIndex[kind][entry.Key] == nil,
			"[Config.Vehicles] doppelter Tuning-Schlüssel " .. kind .. "." .. entry.Key
		)
		optionIndex[kind][entry.Key] = entry
	end
end

function Vehicles.Car(key: string): any?
	return if type(key) == "string" then carIndex[key] else nil
end

-- Klassen-Deckel (Studs/s) eines Autos
function Vehicles.Cap(key: string): number
	local car = Vehicles.Car(key)
	local cap = if car then Vehicles.Classes[car.Class] else nil
	return if finite(cap) then cap else 60
end

function Vehicles.Option(kind: string, key: string): any?
	local index = optionIndex[kind]
	return if index and type(key) == "string" then index[key] else nil
end

-- Bezugswert eines Autos (CR-Preis oder Klassen-Wert)
local function refValue(car: any): number
	if finite(car.Price) and car.Price > 0 then
		return car.Price
	end
	local value = Vehicles.ClassValue[car.Class]
	return if finite(value) then value else 25000
end

-- Preis einer Tuning-Option für ein Auto (ganzzahlig, < 1e14); Spoiler: optionKey egal; "Off"/Serie = 0
function Vehicles.TunePrice(carKey: string, kind: string, optionKey: string?): number
	local car = Vehicles.Car(carKey)
	if not car then
		return 0
	end
	local costKey = kind
	if kind == "Paint" then
		local paint = Vehicles.Option("Paint", optionKey or "")
		if not paint then
			return 0
		end
		costKey = if paint.Metallic then "Metallic" else "Paint"
	elseif kind == "Glow" then
		if optionKey == Vehicles.GlowOff then
			return 0
		end
	elseif kind == "Rims" then
		if optionKey == Vehicles.DefaultRims then
			return 0
		end
	end
	local cost = Vehicles.TuneCost[costKey]
	if type(cost) ~= "table" then
		return 0
	end
	local price = math.max(cost.Base, math.floor(refValue(car) * cost.Pct))
	return math.clamp(math.floor(price), 0, 9e13)
end

-- ---------------------------------------------------------------------
-- 8) PRÜFUNG
-- ---------------------------------------------------------------------
function Vehicles.Validate(_config: any): { string }
	local errors: { string } = {}
	local function add(text: string)
		table.insert(errors, "Config.Vehicles." .. text)
	end
	local function num(path: string, v: any, lo: number, hi: number)
		if not finite(v) or v < lo or v > hi then
			add(("%s: Zahl %s … %s erwartet"):format(path, tostring(lo), tostring(hi)))
		end
	end
	local function int(path: string, v: any, lo: number, hi: number)
		if not finite(v) or v % 1 ~= 0 or v < lo or v > hi then
			add(("%s: ganze Zahl %s … %s erwartet"):format(path, tostring(lo), tostring(hi)))
		end
	end
	local function pair(path: string, v: any)
		if type(v) ~= "table" or type(v.de) ~= "string" or type(v.en) ~= "string" or v.de == "" or v.en == "" then
			add(path .. ": { de, en } erwartet")
		end
	end

	-- Klassen (§B12.1: 60 / 75 / 95 / 120 / 150)
	local expected = { Kompakt = 60, Limousine = 75, Sport = 95, Super = 120, Hyper = 150 }
	for _, class in ipairs(Vehicles.ClassOrder) do
		num("Classes." .. class, Vehicles.Classes[class], 10, 400)
		if expected[class] and Vehicles.Classes[class] ~= expected[class] then
			add(("Classes.%s: Spec-Wert %d"):format(class, expected[class]))
		end
		local info = Vehicles.ClassInfo[class]
		if type(info) ~= "table" then
			add("ClassInfo." .. class .. ": fehlt")
		else
			num("ClassInfo." .. class .. ".Accel", info.Accel, 1, 400)
			pair("ClassInfo." .. class .. ".Name", info.Name)
		end
		int("ClassValue." .. class, Vehicles.ClassValue[class], 0, 9e13)
	end

	-- Probefahrt
	local test = Vehicles.TestDrive
	if type(test) ~= "table" then
		add("TestDrive: Tabelle erwartet")
	else
		int("TestDrive.Seconds", test.Seconds, 10, 600)
		int("TestDrive.Cooldown", test.Cooldown, 0, 3600)
		num("TestDrive.Range", test.Range, 10, 1000)
	end

	-- Autos
	if #Vehicles.Cars ~= 16 then
		add(("Cars: 16 Autos erwartet (§B12.1), gefunden %d"):format(#Vehicles.Cars))
	end
	local hyperBest = 0
	for i, car in ipairs(Vehicles.Cars) do
		local where = ("Cars[%d] (%s)"):format(i, tostring(car.Key))
		if type(car.Key) ~= "string" or not string.match(car.Key, "^%a[%w]*$") then
			add(where .. ".Key: Buchstaben/Ziffern erwartet")
		end
		pair(where .. ".Name", car.Name)
		if Vehicles.Classes[car.Class] == nil then
			add(where .. ".Class: unbekannt")
		end
		if not Vehicles.Sources[car.Source] then
			add(where .. ".Source: unbekannt")
		end
		int(where .. ".Price", car.Price, 0, 9e13)
		if car.Source == "Shop" and (not finite(car.Price) or car.Price <= 0) then
			add(where .. ".Price: Shop-Autos brauchen einen CR-Preis")
		end
		if car.Source ~= "Shop" and finite(car.Price) and car.Price > 0 then
			add(where .. ".Price: nur Shop-Autos haben einen CR-Preis")
		end
		if car.Source == "Pass" and (type(car.Pass) ~= "string" or car.Pass == "") then
			add(where .. ".Pass: Pass-Schlüssel erwartet")
		end
		if car.Source == "Licence" then
			int(where .. ".Licence", car.Licence, 1, 10)
		end
		if car.Source == "Login" then
			int(where .. ".LoginDay", car.LoginDay, 1, 365)
		end
		if type(car.Recipe) ~= "string" or car.Recipe == "" then
			add(where .. ".Recipe: Bauplan-Schlüssel erwartet")
		end
		if Vehicles.Option("Paint", car.Paint) == nil then
			add(where .. ".Paint: Lack aus Paints erwartet")
		end
		if car.Class == "Hyper" and car.Source ~= "Pass" then
			hyperBest = math.max(hyperBest, Vehicles.Classes.Hyper)
		end
	end
	-- Λ-1 (Pass): nie schneller als das beste erspielte Hyper (§B12.1)
	local lam1 = Vehicles.Car("Lam1")
	if lam1 and Vehicles.Cap("Lam1") > hyperBest then
		add("Cars.Lam1: darf nie schneller sein als das beste erspielte Hyper")
	end
	local freeCar = Vehicles.Car("LamCity")
	if freeCar == nil or freeCar.Source ~= "Free" then
		add("Cars.LamCity: Gratis-Auto des Tutorials fehlt")
	end

	-- Boost/Drift
	num("Boost.Mult", Vehicles.Boost.Mult, 1, 2)
	num("Boost.Seconds", Vehicles.Boost.Seconds, 0.5, 30)
	num("Boost.Cooldown", Vehicles.Boost.Cooldown, Vehicles.Boost.Seconds, 120)
	num("DriftFriction", Vehicles.DriftFriction, 0.05, 2)
	if Vehicles.Boost.Mult >= Vehicles.SpeedCheck.Factor then
		add("Boost.Mult: muss unter SpeedCheck.Factor liegen (sonst Fehlalarm beim Boost)")
	end

	-- Tuning (§B12.1: 24 Lacke, 8 Felgen, 6 Unterboden-Farben)
	local counts = { Paints = 24, Rims = 8, Glow = 6 }
	for name, n in pairs(counts) do
		local list = (Vehicles :: any)[name]
		if type(list) ~= "table" or #list ~= n then
			add(("%s: %d Einträge erwartet"):format(name, n))
		else
			for i, entry in ipairs(list) do
				local where = ("%s[%d]"):format(name, i)
				pair(where .. ".Name", entry.Name)
				if typeof(entry.Color) ~= "Color3" then
					add(where .. ".Color: Color3 erwartet")
				end
				if entry.Unlock ~= "Default" and entry.Unlock ~= "Pass" and entry.Unlock ~= "Club" then
					add(where .. ".Unlock: Default/Pass/Club erwartet")
				elseif entry.Unlock == "Pass" and (type(entry.Pass) ~= "string" or entry.Pass == "") then
					add(where .. ".Pass: Pass-Schlüssel erwartet")
				end
			end
		end
	end
	for kind, cost in pairs(Vehicles.TuneCost) do
		int("TuneCost." .. kind .. ".Base", cost.Base, 0, 9e13)
		num("TuneCost." .. kind .. ".Pct", cost.Pct, 0, 0.5)
	end
	if Vehicles.Option("Rims", Vehicles.DefaultRims) == nil then
		add("DefaultRims: Felge aus Rims erwartet")
	end

	-- Garage & Rabatt
	int("GarageBase", Vehicles.GarageBase, 1, 100)
	int("GarageLevelSlots", Vehicles.GarageLevelSlots, 0, 50)
	int("GarageLevelsMax", Vehicles.GarageLevelsMax, 0, 10)
	int("MegaGarageSlots", Vehicles.MegaGarageSlots, 0, 100)
	num("DespawnSeconds", Vehicles.DespawnSeconds, 5, 3600)
	local discount = Vehicles.ShareholderDiscount
	int("ShareholderDiscount.I", discount.I, 1, 99)
	int("ShareholderDiscount.Min", discount.Min, 1, 1e9)
	num("ShareholderDiscount.Pct", discount.Pct, 0, 0.5)
	for i, point in ipairs(Vehicles.SpawnPoints) do
		if typeof(point.Position) ~= "Vector3" or typeof(point.Facing) ~= "Vector3" then
			add(("SpawnPoints[%d]: Position/Facing (Vector3) erwartet"):format(i))
		end
	end

	-- Physik & Prüfung
	local physics = Vehicles.Physics
	num("Physics.ChassisDensity", physics.ChassisDensity, 0.01, 100)
	num("Physics.WheelDensity", physics.WheelDensity, 0.01, 100)
	num("Physics.FrontFriction", physics.FrontFriction, 0, 2)
	num("Physics.RearFriction", physics.RearFriction, 0, 2)
	num("Physics.SteerMax", physics.SteerMax, 5, 60)
	num("Physics.SteerMin", physics.SteerMin, 1, physics.SteerMax)
	num("SpeedCheck.Hz", Vehicles.SpeedCheck.Hz, 1, 30)
	num("SpeedCheck.Factor", Vehicles.SpeedCheck.Factor, 1.05, 3)
	int("SpeedCheck.Strikes", Vehicles.SpeedCheck.Strikes, 1, 10)
	return errors
end

return Vehicles
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">DecorModels</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Deko-Rezepte (Shared/DecorModels)
--  Besitzer: WP8 (Turm-Optik, Interiors, Lifestyle). Vertrag: DESIGN.md §C6.2 (DecorModels.Build(key): Model),
--  §B4.8 (60 Deko-Teile in 6 Sets + Saison-Set: Schreibtische mit Live-Mini-Monitor, Sofas, Pflanzen, Aquarium mit
--  getweenten Fischen, Skulpturen, Part-„Kunst“, Trophäen, Neon-Schilder aus ΛKYTEX-Strichen, Teppiche, Lampen mit
--  echten Lichtern im Budget), §C14.3 (Asset-Platz je Teil: MeshId ≠ 0 -> Mesh, sonst/Fehler -> Code-Rezept).
--
--  Rezepte sind deterministische PartSpec-Listen (Shared/TowerModels.PartSpec, reine Daten -> Luau-CLI-testbar):
--  Ursprung = Boden-Mitte des Teils, Vorderseite = lokal −Z, Grundfläche ≤ 5 × 5 Studs, Höhe ≤ 8,4 Studs (passt unter
--  jede Decke). Das Interior (TowerModels.Interior) dreht/verschiebt sie in die festen Deko-Plätze.
--  Gestaltung kommt aus Config.Decor[key].Recipe { Kind, A, B, C, M, S } – Kind wählt das Rezept, A/B/C die Farben,
--  M das Hauptmaterial, S die Skala.
--
--  Öffentliche API:
--    DecorModels.Build(key): Model                 Asset (falls gesetzt und geladen) oder Code-Rezept; Pivot = Ursprung
--    DecorModels.Specs(key): { PartSpec }          Rezept-Teile (gecacht – nur lesen!)
--    DecorModels.SpecsFor(recipe): { PartSpec }    Rezept aus einer Recipe-Tabelle (Boutique-Vorschau, Tests)
--    DecorModels.Kinds(): { string }               alle bekannten Rezept-Arten (Tests: jede Config-Art existiert)
--    DecorModels.Has(kind): boolean
--  Beim Laden registriert sich das Modul als Deko-Lieferant bei TowerModels (Deko im Interior).
-- =====================================================================

local DecorModels = {}

type PartSpec = { [string]: any }
type Recipe = { [string]: any }
type Opts = { [string]: any }

-- TowerModels / Config.Decor: in Roblox über script, in der Luau-CLI über relative Pfade
local function loadModule(name: string, cliPath: string): any
	local here: any = script
	if typeof(here) == "Instance" then
		local module = here.Parent and here.Parent:FindFirstChild(name)
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module :: any)
			return if ok then result else nil
		end
		return nil
	end
	local cliRequire: any = require
	local ok, result = pcall(cliRequire, cliPath)
	return if ok then result else nil
end

local function loadDecorConfig(): any
	local here: any = script
	if typeof(here) == "Instance" then
		local config = here.Parent and here.Parent:FindFirstChild("Config")
		local module = config and config:FindFirstChild("Decor")
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module :: any)
			return if ok then result else nil
		end
		return nil
	end
	local cliRequire: any = require
	local ok, result = pcall(cliRequire, "./Config/Decor")
	return if ok then result else nil
end

local TowerModels: any = loadModule("TowerModels", "./TowerModels")
local DecorConfig: any = loadDecorConfig()

local VERTICAL = { 0, 0, 90 }
local MAX_PARTS = 14 -- je Deko-Teil (3 Plätze × 14 + Raum + Personal bleibt ≤ 150)

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function r3(v: number): number
	return math.floor(v * 1000 + 0.5) / 1000
end

-- Teil mit Skala s (Größe und Position werden skaliert)
local function p(
	list: { PartSpec },
	s: number,
	size: { number },
	pos: { number },
	color: string,
	material: string,
	opts: Opts?
): PartSpec
	local spec: PartSpec = {
		Size = { r3(math.max(0.05, size[1] * s)), r3(math.max(0.05, size[2] * s)), r3(math.max(0.05, size[3] * s)) },
		Pos = { r3(pos[1] * s), r3(pos[2] * s), r3(pos[3] * s) },
		Color = color,
		Material = material,
	}
	if opts then
		for key, value in pairs(opts) do
			spec[key] = value
		end
	end
	table.insert(list, spec)
	return spec
end

local function cyl(extra: Opts?): Opts
	local o: Opts = { Shape = "Cylinder", Rot = VERTICAL }
	if extra then
		for k, v in pairs(extra) do
			o[k] = v
		end
	end
	return o
end

local function ball(extra: Opts?): Opts
	local o: Opts = { Shape = "Ball" }
	if extra then
		for k, v in pairs(extra) do
			o[k] = v
		end
	end
	return o
end

local function light(range: number, brightness: number, color: string): Opts
	return { Light = { Range = range, Brightness = brightness, Color = color }, Shadow = false }
end

-- Hex-Farben mischen (für Rechen-Linien im Sand)
local function mix(a: string, b: string, t: number): string
	local function parse(hex: string): (number, number, number)
		return tonumber(string.sub(hex, 2, 3), 16) or 0,
			tonumber(string.sub(hex, 4, 5), 16) or 0,
			tonumber(string.sub(hex, 6, 7), 16) or 0
	end
	local ar, ag, ab = parse(a)
	local br, bg, bb = parse(b)
	local function c(x: number): number
		return math.clamp(math.floor(x + 0.5), 0, 255)
	end
	return string.format("#%02x%02x%02x", c(ar + (br - ar) * t), c(ag + (bg - ag) * t), c(ab + (bb - ab) * t))
end

-- ---------------------------------------------------------------------
-- REZEPTE (je ≤ 14 Parts; A = Hauptfarbe, B = Zweitfarbe, C = Akzent, M = Material, s = Skala)
-- ---------------------------------------------------------------------
type Builder = (list: { PartSpec }, r: Recipe, s: number) -> ()
local R: { [string]: Builder } = {}

R.Desk = function(list, r, s)
	p(
		list,
		s,
		{ 4.6, 0.3, 2.4 },
		{ 0, 2.6, 0 },
		r.A,
		r.M,
		{ Collide = true, Transparency = if r.M == "Glass" then 0.3 else 0 }
	)
	p(list, s, { 0.3, 2.45, 2.2 }, { -2.1, 1.25, 0 }, r.B, "Metal")
	p(list, s, { 0.3, 2.45, 2.2 }, { 2.1, 1.25, 0 }, r.B, "Metal")
	p(list, s, { 1.8, 1.1, 0.12 }, { 0, 3.45, 0.7 }, "#0b0f17", "SmoothPlastic", {
		Tag = "Monitor",
		Attr = { Monitor = "Chart", Face = "Front" },
	})
	p(list, s, { 1.9, 0.08, 0.1 }, { 0, 2.82, 0.62 }, r.C, "Neon", { Shadow = false })
	p(list, s, { 1.4, 0.06, 0.5 }, { 0, 2.78, -0.4 }, "#1f2937", "SmoothPlastic")
end

R.BeanBag = function(list, r, s)
	p(list, s, { 3, 1.8, 3 }, { 0, 0.9, 0 }, r.A, r.M, ball({ Collide = true }))
	p(list, s, { 2.4, 1.2, 2.4 }, { 0, 1.6, 0.5 }, r.A, r.M, ball())
	p(list, s, { 0.12, 2.9, 2.9 }, { 0, 0.15, 0 }, r.B, "Fabric", cyl())
end

R.Plant = function(list, r, s)
	p(list, s, { 1.6, 1.8, 1.8 }, { 0, 0.8, 0 }, r.B, r.M, cyl({ Collide = true }))
	p(list, s, { 2.6, 2.2, 2.6 }, { 0, 2.8, 0 }, r.A, "Grass", ball())
	p(list, s, { 1.8, 1.6, 1.8 }, { 0.8, 3.8, -0.3 }, r.C, "Grass", ball())
	p(list, s, { 1.6, 1.4, 1.6 }, { -0.7, 3.6, 0.4 }, r.A, "Grass", ball())
end

R.Whiteboard = function(list, r, s)
	p(list, s, { 4.4, 2.8, 0.15 }, { 0, 3.6, 0 }, r.A, r.M)
	p(list, s, { 4.6, 0.15, 0.3 }, { 0, 2.15, -0.05 }, r.B, "Metal")
	p(list, s, { 0.15, 2.2, 0.15 }, { -1.8, 1.1, 0.4 }, r.B, "Metal")
	p(list, s, { 0.15, 2.2, 0.15 }, { 1.8, 1.1, 0.4 }, r.B, "Metal")
	-- „Ideen“-Kurve aus drei Strichen (steigender Chart)
	p(list, s, { 1.2, 0.12, 0.05 }, { -1.1, 3.0, -0.1 }, r.C, "Neon", { Rot = { 0, 0, 18 }, Shadow = false })
	p(list, s, { 1.2, 0.12, 0.05 }, { 0, 3.5, -0.1 }, r.C, "Neon", { Rot = { 0, 0, 35 }, Shadow = false })
	p(list, s, { 1.2, 0.12, 0.05 }, { 1.1, 4.1, -0.1 }, r.C, "Neon", { Rot = { 0, 0, 25 }, Shadow = false })
end

R.NeonArrow = function(list, r, s)
	p(list, s, { 0.3, 3.2, 3.2 }, { 0, 0.15, 0 }, r.B, r.M, cyl())
	p(list, s, { 0.25, 3, 0.25 }, { 0, 1.8, 0.3 }, r.B, "Metal")
	p(list, s, { 2.6, 0.35, 0.35 }, { -0.5, 3.6, 0 }, r.C, "Neon", { Rot = { 0, 0, 30 }, Shadow = false })
	p(list, s, { 1.4, 0.35, 0.35 }, { 0.9, 4.2, 0 }, r.C, "Neon", { Rot = { 0, 0, -45 }, Shadow = false })
	p(list, s, { 1.4, 0.35, 0.35 }, { 0.75, 4.75, 0 }, r.C, "Neon", { Rot = { 0, 0, 45 }, Shadow = false })
end

-- Bulle (Mini auf Sockel bis Gold-Statue): Körper, Kopf, Hörner, Beine
R.Bull = function(list, r, s)
	p(list, s, { 3.2, 0.6, 2.2 }, { 0, 0.3, 0 }, r.B, "Marble", { Collide = true })
	p(list, s, { 2.8, 1.5, 1.4 }, { 0, 1.9, 0.2 }, r.A, r.M)
	p(list, s, { 1.1, 1.1, 1.2 }, { 0, 2.3, -1.2 }, r.A, r.M)
	p(list, s, { 0.25, 0.25, 0.9 }, { -0.5, 2.9, -1.3 }, r.C, "Metal", { Rot = { 0, 35, 25 } })
	p(list, s, { 0.25, 0.25, 0.9 }, { 0.5, 2.9, -1.3 }, r.C, "Metal", { Rot = { 0, -35, -25 } })
	for _, q in ipairs({ { -0.9, -0.4 }, { 0.9, -0.4 }, { -0.9, 0.8 }, { 0.9, 0.8 } }) do
		p(list, s, { 0.4, 1.0, 0.4 }, { q[1], 1.0, q[2] }, r.A, r.M)
	end
end

R.Counter = function(list, r, s)
	p(list, s, { 4.4, 3.2, 1.8 }, { 0, 1.6, 0 }, r.A, r.M, { Collide = true })
	p(list, s, { 4.6, 0.25, 2.1 }, { 0, 3.3, 0 }, "#f4f6fa", "Marble")
	p(list, s, { 4.4, 0.15, 0.1 }, { 0, 0.5, -0.92 }, r.C, "Neon", { Shadow = false })
	p(list, s, { 1.1, 1.4, 0.8 }, { -1.2, 4.1, 0.2 }, r.B, "Glass", cyl({ Transparency = 0.25 }))
	p(list, s, { 0.9, 1.2, 0.7 }, { 0.1, 4.0, 0.3 }, r.C, "Glass", cyl({ Transparency = 0.25 }))
	p(list, s, { 0.6, 0.6, 0.6 }, { 1.4, 3.75, 0 }, "#f59e0b", "SmoothPlastic", ball())
end

R.Chair = function(list, r, s)
