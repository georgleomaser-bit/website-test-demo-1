-- ---------------------------------------------------------------------
-- LAYOUT (Ticker an/aus, Touch/PC, Pillen) – Toasts rutschen unter Ticker + Pillen
-- ---------------------------------------------------------------------
local function anyPillVisible(): boolean
	for _, ui in pairs(pillUi) do
		if ui.Frame.Visible then
			return true
		end
	end
	return false
end

local function layout()
	local tickerOn = tickerBar ~= nil and (tickerBar :: Frame).Visible
	local top = if tickerOn then hudCfg("TickerHeight", 28) else 0
	local holder = pillHolder
	if holder then
		holder.Position = UDim2.new(0.5, 0, 0, top + 6)
	end
	local statsTop = top + 8
	local frame = stats
	if frame then
		frame.Position = UDim2.fromOffset(12, statsTop)
	end
	local vault = vaultFrame
	if vault then
		vault.Position = UDim2.fromOffset(12 + STATS_W + 10, statsTop + math.floor((STATS_H - RING_SIZE) / 2))
	end
	local net = netLabel
	if net then
		net.Position = UDim2.new(1, -12, 0, top + 6)
	end
	-- rechte Knöpfe: Touch 3 Spalten oben rechts (unten rechts liegt der Sprungknopf), sonst 2 Spalten Mitte rechts
	local bar, grid = rightBar, rightGrid
	if bar and grid then
		if inputKind() == "Touch" then
			grid.CellSize = UDim2.fromOffset(SQUARE_TOUCH, SQUARE_TOUCH)
			grid.FillDirectionMaxCells = 3
			bar.Size = UDim2.fromOffset(SQUARE_TOUCH * 3 + SQUARE_GAP * 2, 0)
			bar.AnchorPoint = Vector2.new(1, 0)
			bar.Position = UDim2.new(1, -12, 0, top + 30)
		else
			grid.CellSize = UDim2.fromOffset(SQUARE, SQUARE)
			grid.FillDirectionMaxCells = 2
			bar.Size = UDim2.fromOffset(SQUARE * 2 + SQUARE_GAP, 0)
			bar.AnchorPoint = Vector2.new(1, 0.5)
			bar.Position = UDim2.new(1, -14, 0.5, 0)
		end
	end
	local toastTop = top + 6 + (if anyPillVisible() then hudCfg("PillHeight", 30) + 8 else 8)
	if toastTop ~= lastTopOffset then
		lastTopOffset = toastTop
		UI.SetToastTop(toastTop)
	end
end

local function applyVisible()
	local frame = root
	if frame and frame.Visible ~= forcedVisible then
		frame.Visible = forcedVisible
	end
end

local function relabel()
	for _, entry in ipairs(rightButtons) do
		entry.Button.SetSub(UI.Upper(T(entry.Caption)))
	end
	local trade = tradeButton
	if trade then
		trade.SetText(T("ui.trade"))
		trade.SetSub(T("ui.tradeSub"))
	end
	if vaultCaption then
		vaultCaption.Text = UI.Upper(T("ui.hud.vault"))
	end
	if crCounter then
		UI.RedrawCounter(crCounter)
	end
	if akyCounter then
		UI.RedrawCounter(akyCounter)
	end
	if vaultCounter then
		UI.RedrawCounter(vaultCounter)
	end
	multSheetKey = "" -- Sheet beim nächsten Öffnen neu bauen
end

-- ---------------------------------------------------------------------
-- PILLEN
-- ---------------------------------------------------------------------
local function pillText(pill: Pill): string
	local text = pill.Text
	local untilT = pill.Until
	if untilT then
		local left = formatDuration(untilT - serverNow())
		if string.find(text, "%s", 1, true) then
			local ok, formatted = pcall(string.format, text, left)
			return if ok then formatted else text
		end
		return text .. " · " .. left
	end
	return text
end

local function renderPills()
	local maxPills = math.clamp(math.floor(hudCfg("MaxPills", 4)), 1, 6)
	if inputKind() == "Touch" then
		maxPills = math.min(maxPills, 2) -- Handy: oben ist wenig Platz zwischen Karte und Knöpfen
	end
	local shown = 0
	local now = serverNow()
	for _, key in ipairs(PILL_ORDER) do
		local pill = manualPills[key]
		if pill and pill.Until and pill.Until <= now then
			manualPills[key] = nil -- abgelaufen
			pill = nil
		end
		pill = pill or autoPills[key]
		if pill and pill.Until and pill.Until <= now then
			pill = nil
		end
		local visible = pill ~= nil and shown < maxPills
		if visible and pill then
			shown += 1
			local ui = pillFor(key)
			local text = pillText(pill)
			if ui.Label.Text ~= text then
				ui.Label.Text = text
			end
			if not ui.Frame.Visible then
				ui.Frame.Visible = true
			end
		else
			local ui = pillUi[key]
			if ui and ui.Frame.Visible then
				ui.Frame.Visible = false
			end
		end
	end
	layout()
end

function Hud.SetPill(key: string, text: string?, untilUnix: number?)
	if type(key) ~= "string" or not PILL_KEYS[key] then
		warn("[Hud] Unbekannter Pillen-Schlüssel: " .. tostring(key))
		return
	end
	if type(text) ~= "string" or text == "" then
		manualPills[key] = nil
	else
		local untilT = if type(untilUnix) == "number" and untilUnix == untilUnix then untilUnix else nil
		manualPills[key] = { Text = string.sub(text, 1, 120), Until = untilT }
	end
	renderPills()
end

-- Anzeigename eines Welt-Events (ui.event.<Kind>, sonst allgemein)
local function eventName(kind: any): string
	if type(kind) == "string" and kind ~= "" and hasKey("ui.event." .. kind) then
		return T("ui.event." .. kind)
	end
	return T("ui.event.generic")
end

-- automatische Pillen aus dem State (Glocke, Boost, Welt-Event, ADMIN-ABUSE, Tresor voll)
local function computeAutoPills()
	local state = ctx and ctx.State or {}
	local now = serverNow()
	-- Glocke: nächster Börsentag-Beginn (alle Server gleich, Clock)
	local clock = ctx and ctx.Clock
	local dayTicks = if clock and type(clock.DAY_TICKS) == "number" then clock.DAY_TICKS else 1200
	local tick = math.floor(now)
	if clock and type(clock.Tick) == "function" then
		local ok, value = pcall(clock.Tick)
		if ok and type(value) == "number" then
			tick = value
		end
	end
	local toBell = dayTicks - (tick % dayTicks)
	local depot = state.Depot
	local transferWaiting = type(depot) == "table" and depot.TransferReady == false
	autoPills.Bell = {
		Text = if transferWaiting then T("ui.pill.bellTransfer") else T("ui.pill.bell"),
		Until = now + toBell,
	}
	-- Boost: stärkster aktiver persönlicher Boost (x5 > x2 > Bulle), Restzeit seit dem letzten State
	local elapsed = os.clock() - boostClock
	local function boostLeft(kind: string): number
		return math.max(0, (boostBase[kind] or 0) - elapsed)
	end
	local x5, x2, bull = boostLeft("X5"), boostLeft("X2"), boostLeft("Bull")
	if x5 > 0 then
		autoPills.Boost = { Text = T("ui.pill.boost", "x5"), Until = now + x5 }
	elseif x2 > 0 then
		autoPills.Boost = { Text = T("ui.pill.boost", "x2"), Until = now + x2 }
	elseif bull > 0 then
		autoPills.Boost = { Text = T("ui.pill.boostBull"), Until = now + bull }
	else
		autoPills.Boost = nil
	end
	-- ADMIN-ABUSE (Fenster zählt nicht für die Liga)
	local event = state.Event
	local market = state.Market
	local abuse = (type(event) == "table" and event.AdminAbuse == true)
		or (type(market) == "table" and market.AdminWindow == true)
	autoPills.AdminAbuse = if abuse then { Text = T("ui.pill.adminAbuse"), Until = nil } else nil
	-- Welt-Event: läuft gerade eins -> Restzeit, sonst das nächste
	local worldPill: Pill? = nil
	if type(event) == "table" then
		local active = event.Active
		if type(active) == "table" then
			for _, entry in ipairs(active) do
				if type(entry) == "table" and type(entry.Until) == "number" and entry.Until > now then
					worldPill = { Text = T("ui.pill.eventLive", eventName(entry.Kind)), Until = entry.Until }
					break
				end
			end
		end
		local nextEvent = event.Next
		if not worldPill and type(nextEvent) == "table" and type(nextEvent.At) == "number" and nextEvent.At > now then
			worldPill = { Text = T("ui.pill.eventNext", eventName(nextEvent.Kind)), Until = nextEvent.At }
		end
	end
	autoPills.WorldEvent = worldPill
	-- Tresor voll
	autoPills.Vault = if vaultFull then { Text = T("ui.pill.vaultFull"), Until = nil } else nil
end

-- ---------------------------------------------------------------------
-- TRESOR-RING
-- ---------------------------------------------------------------------
local function setVaultRing(ratio: number)
	local count = #vaultTicks
	if count == 0 then
		return
	end
	local lit = math.clamp(math.floor(ratio * count + 0.5), 0, count)
	if ratio > 0 and lit == 0 then
		lit = 1
	end
	local warnAt = hudCfg("VaultWarn", 0.85)
	local color = if ratio >= 0.999 then Theme.Down elseif ratio >= warnAt then Theme.Warn else Theme.Accent
	if lit == vaultShownTicks and color == vaultShownColor then
		return
	end
	vaultShownTicks, vaultShownColor = lit, color
	for i, tick in ipairs(vaultTicks) do
		local want = if i <= lit then color else Theme.Border
		if tick.BackgroundColor3 ~= want then
			tick.BackgroundColor3 = want
		end
	end
end

local function setVaultFull(full: boolean)
	if full == vaultFull then
		return
	end
	vaultFull = full
	local glow = vaultGlow
	if not glow then
		return
	end
	if vaultPulse then
		vaultPulse:Cancel()
		vaultPulse = nil
	end
	if full then
		glow.Color = Theme.Down
		glow.Thickness = 2
		glow.Transparency = 0
		local pulse = TweenService:Create(glow, RING_PULSE_INFO, { Transparency = 0.7 })
		vaultPulse = pulse
		pulse:Play()
	else
		glow.Color = Theme.Border
		glow.Thickness = 1
		glow.Transparency = 0
	end
end

local function updateVault()
	local income = ctx and ctx.State and ctx.State.Income
	local perSec = if type(income) == "table" and type(income.PerSec) == "number" then income.PerSec else 0
	local predicted = vaultBase
	if vaultCap > 0 and perSec > 0 then
		predicted = math.min(vaultCap, vaultBase + perSec * math.max(0, os.clock() - vaultClock))
	end
	if vaultCounter then
		UI.SetCounter(vaultCounter, predicted)
	end
	local ratio = if vaultCap > 0 then math.clamp(predicted / vaultCap, 0, 1) else 0
	setVaultRing(ratio)
	setVaultFull(vaultCap > 0 and ratio >= 0.999)
end

-- ---------------------------------------------------------------------
-- MULTIPLIKATOR-AUFSCHLÜSSELUNG (Sheet): jede Quelle mit Wert, Herkunft und Restzeit (§B5.2, Abnahme 4)
-- ---------------------------------------------------------------------
local function partName(key: string): string
	local langKey = "ui.mult.key." .. key
	if hasKey(langKey) then
		return T(langKey)
	end
	return key
end

local function buildMultSheet()
	local sheet = multSheet
	if not sheet then
		return
	end
	local content: ScrollingFrame = sheet.Content
	for _, child in ipairs(content:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	table.clear(multCountdowns)
	sheet.TitleLabel.Text = UI.Upper(T("ui.mult.title"))
	local income = ctx.State and ctx.State.Income
	local mult = if type(income) == "table" and type(income.Mult) == "number" then income.Mult else 1
	local perSec = if type(income) == "table" and type(income.PerSec) == "number" then income.PerSec else 0
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	-- Kopf: Gesamt-Multiplikator + Einkommen
	local head = UI.Card({ Size = UDim2.new(1, 0, 0, 70), LayoutOrder = nextOrder(), Parent = content })
	UI.Label({
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(0.5, 0, 0, 18),
		Text = T("ui.mult.total"),
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 14,
		Parent = head,
	})
	UI.Label({
		Position = UDim2.fromOffset(14, 26),
		Size = UDim2.new(0.5, 0, 0, 36),
		Text = formatMult(mult),
		Face = "Display",
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 32,
		Parent = head,
	})
	UI.Label({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0.5, -14, 0, 22),
		Text = T("ui.mult.income", formatCredits(perSec)),
		Face = "Mono",
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxText = 16,
		Parent = head,
	})
	-- Quellen je Gruppe
	local parts = if type(income) == "table" and type(income.Parts) == "table" then income.Parts else {}
	local any = false
	for _, group in ipairs(MULT_GROUPS) do
		local inGroup: { any } = {}
		for _, part in ipairs(parts) do
			if type(part) == "table" and part.Group == group and type(part.Value) == "number" then
				table.insert(inGroup, part)
			end
		end
		if #inGroup > 0 then
			any = true
			UI.Section(content, T("ui.mult.group." .. group), nextOrder(), Theme.Accent)
			for _, part in ipairs(inGroup) do
				local card = UI.RowCard(content, nextOrder(), 48)
				UI.Label({
					Position = UDim2.fromOffset(14, 0),
					Size = UDim2.new(0.45, -14, 1, 0),
					Text = partName(tostring(part.Key or "?")),
					TextColor3 = Theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					MaxText = 15,
					Parent = card,
				})
				local source = tostring(part.Source or "Earned")
				local chip = UI.Chip(card, UI.Upper(T("ui.mult.src." .. source)), SOURCE_COLORS[source] or Theme.Muted)
				chip.AnchorPoint = Vector2.new(0, 0.5)
				chip.Position = UDim2.new(0.45, 0, 0.5, 0)
				local value = if group == "Perm" then formatAdd(part.Value) else formatMult(part.Value)
				UI.Label({
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -14, 0, 6),
					Size = UDim2.new(0.25, 0, 0, 20),
					Text = value,
					Face = "MonoBold",
					TextColor3 = if part.Source == "Bought" then Theme.Warn else Theme.Text,
					TextXAlignment = Enum.TextXAlignment.Right,
					MaxText = 16,
					Parent = card,
				})
				local untilT = part.Until
				local left = UI.Label({
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -14, 0, 26),
					Size = UDim2.new(0.3, 0, 0, 16),
					Text = if type(untilT) == "number"
						then T("ui.mult.left", formatDuration(untilT - serverNow()))
						else "",
					Face = "Mono",
					TextColor3 = Theme.Muted,
					TextXAlignment = Enum.TextXAlignment.Right,
					MaxText = 12,
					Parent = card,
				})
				if type(untilT) == "number" then
					table.insert(multCountdowns, { Label = left, Until = untilT })
				end
			end
		end
	end
	-- pausierte persönliche Boosts: zählt nur der stärkste, die anderen laufen danach weiter (TowerService)
	local running: { [string]: boolean } = {}
	for _, part in ipairs(parts) do
		if type(part) == "table" and part.Group == "Timed" then
			running[tostring(part.Key)] = true
		end
	end
	local boosts = ctx.State and ctx.State.Boosts
	if type(boosts) == "table" then
		for _, kind in ipairs({ "X5", "X2", "Bull" }) do
			local seconds = boosts[kind]
			if not running[kind] and type(seconds) == "number" and seconds == seconds and seconds >= 1 then
				any = true
				local card = UI.RowCard(content, nextOrder(), 40)
				UI.Label({
					Position = UDim2.fromOffset(14, 0),
					Size = UDim2.new(0.45, -14, 1, 0),
					Text = partName(kind),
					TextColor3 = Theme.Text2,
					TextXAlignment = Enum.TextXAlignment.Left,
					MaxText = 15,
					Parent = card,
				})
				UI.Label({
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -14, 0, 0),
					Size = UDim2.new(0.55, 0, 1, 0),
					Text = T("ui.mult.paused", formatDuration(seconds)),
					Face = "Mono",
					TextColor3 = Theme.Muted,
					TextXAlignment = Enum.TextXAlignment.Right,
					MaxText = 12,
					Parent = card,
				})
			end
		end
	end
	if not any then
		UI.Label({
			Size = UDim2.new(1, 0, 0, 40),
			Text = T("ui.mult.empty"),
			Face = "Body",
			TextColor3 = Theme.Text2,
			TextWrapped = true,
			MaxText = 15,
			LayoutOrder = nextOrder(),
			Parent = content,
		})
	end
	-- ehrlicher Hinweis (Firewall §0.4): Multiplikatoren wirken nur auf Turm-Einkommen
	UI.Label({
		Size = UDim2.new(1, 0, 0, 44),
		Text = T("ui.mult.note"),
		Face = "Body",
		TextColor3 = Theme.Muted,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 13,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
end

local function incomeKey(): string
	local income = ctx.State and ctx.State.Income
	if type(income) ~= "table" then
		return "none|" .. lang()
	end
	local parts = {}
	if type(income.Parts) == "table" then
		for _, part in ipairs(income.Parts) do
			if type(part) == "table" then
				table.insert(
					parts,
					tostring(part.Key) .. "=" .. tostring(part.Value) .. "/" .. tostring(part.Until or "")
				)
			end
		end
	end
	-- welche persönlichen Boosts liegen bereit (pausierte Zeilen im Sheet; nur Vorhandensein, keine Sekunden)
	local boosts = ctx.State and ctx.State.Boosts
	local held = ""
	if type(boosts) == "table" then
		for _, kind in ipairs({ "X5", "X2", "Bull" }) do
			if type(boosts[kind]) == "number" and boosts[kind] >= 1 then
				held ..= kind
			end
		end
	end
	return tostring(income.Mult)
		.. "|"
		.. tostring(income.PerSec)
		.. "|"
		.. table.concat(parts, ",")
		.. "|"
		.. held
		.. "|"
		.. lang()
end

local function openMultSheet()
	if not multSheet then
		multSheet = UI.Sheet(T("ui.mult.title"), 460)
	end
	local sheet = multSheet
	if sheet.IsOpen then
		UI.CloseWindow(sheet)
		return
	end
	local key = incomeKey()
	if key ~= multSheetKey then
		multSheetKey = key
		buildMultSheet()
	end
	UI.OpenWindow(sheet)
end

-- ---------------------------------------------------------------------
-- LAUFBAND: Kurse aus dem letzten Frame (Hook "Quotes"), Firmenkürzel aus MarketClient/Config.Companies
-- ---------------------------------------------------------------------
local function scanCompanies()
	if instrumentScanned then
		return
	end
	instrumentScanned = true
	local companies = ctx.Config and ctx.Config.Companies
	if type(companies) ~= "table" then
		return
	end
	local function take(list: any)
		if type(list) ~= "table" then
			return
		end
		for _, inst in pairs(list) do
			if type(inst) == "table" and type(inst.Id) == "number" and type(inst.Ticker) == "string" then
				instrumentCache[inst.Id] = inst
			end
		end
	end
	take(companies)
	take(companies.Instruments)
	take(companies.List)
	take(companies.Etfs)
end

local function instrumentOf(id: number): any
	local cached = instrumentCache[id]
	if cached then
		return cached
	end
	local ok, inst = moduleCall("MarketClient", "Instrument", id)
	if ok and type(inst) == "table" and type(inst.Ticker) == "string" then
		instrumentCache[id] = inst
		return inst
	end
	scanCompanies()
	return instrumentCache[id]
end

-- Veränderung seit Tagesbeginn als Anteil (MarketClient.Quote; Cent-Angabe wird umgerechnet)
local function changeOf(id: number, close: number): number?
	local ok, _, change = moduleCall("MarketClient", "Quote", id)
	if not ok or type(change) ~= "number" or change ~= change then
		return nil
	end
	if math.abs(change) > 1 then
		local open = close - change
		if open <= 0 then
			return nil
		end
		return change / open
	end
	return change
end

local function refreshTicker()
	local bar, band = tickerBar, ticker
	if not bar or not band then
		return
	end
	local wanted = setting("TickerBar") ~= false
	local frame = lastQuotes
	local rows: { any } = {}
	if wanted and type(frame) == "table" and type(frame.Rows) == "table" then
		for _, row in ipairs(frame.Rows) do
			if type(row) == "table" and type(row.Id) == "number" and type(row.Close) == "number" then
				local inst = instrumentOf(row.Id)
				if inst and inst.Set ~= "Tutorial" then
					table.insert(rows, {
						Ticker = inst.Ticker,
						Price = row.Close,
						Change = changeOf(row.Id, row.Close),
					})
				end
			end
		end
	end
	local visible = wanted and #rows > 0
	if bar.Visible ~= visible then
		bar.Visible = visible
		layout()
	end
	if visible then
		band.SetRows(rows)
	end
end

-- ---------------------------------------------------------------------
-- DATEN
-- ---------------------------------------------------------------------
function Hud.Refresh(state: { [string]: any })
	if type(state) ~= "table" then
		return
	end
	if crCounter and type(state.Credits) == "number" then
		UI.SetCounter(crCounter, state.Credits, firstCredits)
		firstCredits = false
	end
	local depot = state.Depot
	if akyCounter and type(depot) == "table" and type(depot.Nav) == "number" then
		UI.SetCounter(akyCounter, depot.Nav, firstNav)
		firstNav = false
	end
	local income = state.Income
	if type(income) == "table" and type(income.Mult) == "number" and income.Mult == income.Mult then
		local text = formatMult(income.Mult)
		local label = multLabel
		if label and label.Text ~= text then
			label.Text = text
		end
		-- Chip ploppt, wenn der Multiplikator steigt (Kauf/Effizienz sofort sichtbar, §0.8 Punkt 3)
		local now = os.clock()
		if income.Mult > lastMult + 1e-6 and multScale and now - lastMultPop >= hudCfg("MultPopGap", 0.6) then
			lastMultPop = now
			UI.Pulse(multScale :: UIScale, 0.18)
		end
		lastMult = income.Mult
		if multSheet and multSheet.IsOpen then
			local key = incomeKey()
			if key ~= multSheetKey then
				multSheetKey = key
				buildMultSheet()
			end
		end
	end
end

local function onState(state: any, changed: any)
	if type(state) ~= "table" then
		return
	end
	Hud.Refresh(state)
	local all = type(changed) ~= "table"
	if all or changed.Tower or changed.Income then
		local tower = state.Tower
		if type(tower) == "table" then
			vaultBase = if type(tower.Vault) == "number" then tower.Vault else vaultBase
			vaultCap = if type(tower.VaultCap) == "number" then tower.VaultCap else vaultCap
			vaultClock = os.clock()
		end
		updateVault()
	end
	if all or changed.Boosts then
		local boosts = state.Boosts
		table.clear(boostBase)
		if type(boosts) == "table" then
			for _, kind in ipairs({ "X2", "X5", "Bull" }) do
				local value = boosts[kind]
				if type(value) == "number" and value == value and value > 0 then
					boostBase[kind] = value
				end
			end
		end
		boostClock = os.clock()
	end
	if all or changed.Boosts or changed.Event or changed.Market or changed.Depot then
		computeAutoPills()
		renderPills()
	end
end

-- Jede Sekunde: Tresor-Hochrechnung, Pillen-Countdowns, Laufband, Vermögen, FPS/Ping
function Hud.Tick()
	updateVault()
	computeAutoPills()
	renderPills()
	tickerClock += 1
	if tickerClock >= hudCfg("TickerRefresh", 1) then
		tickerClock = 0
		refreshTicker()
	end
	-- Vermögen aus dem Leaderstat des Servers (StringValue schon formatiert, IntValue/NumberValue -> Format)
	local label = wealthLabel
	if label then
		local leaderstats = player:FindFirstChild("leaderstats")
		local value = leaderstats and leaderstats:FindFirstChild("Vermögen")
		local text = ""
		-- eigene Zahl lokalisiert (DE "1,25 Mio." / EN "1.25M") aus State Prog.Wealth; das Leaderstat ist für alle
		-- Betrachter neutral auf Englisch formatiert und nur der Rückfall
		local prog = ctx.State and ctx.State.Prog
		local wealth = if type(prog) == "table" then prog.Wealth else nil
		if type(wealth) == "number" and wealth == wealth and wealth > 0 then
			text = T("ui.hud.wealth", formatCredits(wealth))
		elseif value and value:IsA("StringValue") then
			text = T("ui.hud.wealth", value.Value)
		elseif value and (value:IsA("IntValue") or value:IsA("NumberValue")) then
			text = T("ui.hud.wealth", formatCredits((value :: any).Value))
		end
		if label.Text ~= text then
			label.Text = text
		end
	end
	-- Restzeiten im offenen Multiplikator-Sheet
	if multSheet and multSheet.IsOpen then
		local now = serverNow()
		for _, entry in ipairs(multCountdowns) do
			local text = T("ui.mult.left", formatDuration(entry.Until - now))
			if entry.Label.Text ~= text then
				entry.Label.Text = text
			end
		end
	end
	-- FPS / Ping / Speicher
	local net = netLabel
	if not net then
		return
	end
	local show = setting("ShowNet") == true
	if net.Visible ~= show then
		net.Visible = show
	end
	if not show then
		return
	end
	local ping = player:GetAttribute("PingMs")
	if type(ping) ~= "number" then
		local ok, value = pcall(function()
			return player:GetNetworkPing() * 1000
		end)
		ping = if ok then value else 0
	end
	local memory = 0
	local okMem, mb = pcall(function()
		return Stats:GetTotalMemoryUsageMb()
	end)
	if okMem and type(mb) == "number" then
		memory = mb
	end
	local fps = if type(ctx.Fps) == "number" then ctx.Fps else 0
	net.Text = T("ui.netStats", math.floor(fps + 0.5), math.floor((tonumber(ping) or 0) + 0.5), math.floor(memory))
end

function Hud.SetVisible(on: boolean)
	forcedVisible = on == true
	applyVisible()
end

-- Bildschirmpunkt des CR-Zählers (für den CR-Flug; Effekt-Ebene hat dieselben Bildschirm-Pixel)
function Hud.CreditsAnchor(): Vector2?
	local label = crLabel
	local frame = root
	if not label or not frame or not frame.Visible then
		return nil
	end
	local pos = label.AbsolutePosition
	local size = label.AbsoluteSize
	return Vector2.new(pos.X + math.min(size.X, 40) * 0.5, pos.Y + size.Y * 0.5)
end

function Hud.PulseCredits(amount: number?)
	local scale = crScale
	if scale then
		-- amount = Pop-Stärke (≤ 1) ODER ein CR-Betrag (die meisten Aufrufer übergeben CR): CR -> sanfter,
		-- logarithmischer Pop (nie UIScale 1 + 5000 = Zähler über den ganzen Bildschirm)
		local a = if type(amount) == "number" and amount == amount then amount else 0.12
		local pop = if a > 1 then math.clamp(0.06 + 0.02 * math.log10(a), 0.06, 0.2) elseif a > 0 then a else 0.12
		UI.Pulse(scale, pop)
	end
end

-- Rückfall-Tasten: Fenster nur umschalten, wenn kein anderes Modul auf dieselbe Taste reagiert hat
local function bindHotkeys()
	local controls = ctx.Modules and ctx.Modules.Controls
	if not controls or type(controls.Bind) ~= "function" then
		return
	end
	for action, windowName in pairs(HOTKEY_WINDOWS) do
		controls.Bind(action, function(state)
			if state ~= "Begin" then
				return
			end
			local windows = ctx.Windows
			if not windows or type(windows.IsOpen) ~= "function" then
				return
			end
			local before = windows.IsOpen(windowName)
			task.defer(function()
				if windows.IsOpen(windowName) == before then
					if windowName == "Terminal" then
						openTerminal()
					else
						windows.Toggle(windowName)
					end
				end
			end)
		end, -50)
	end
end

function Hud.Init(context: any)
	ctx = context
	local frame: Frame = UI.Create("Frame", {
		Name = "Hud",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = ctx.Gui,
	})
	root = frame
	buildTicker(frame)
	buildPills(frame)
	buildStats(frame)
	buildVault(frame)
	buildTrade(frame)
	buildRight(frame)
	buildNet()
	local chip = multButton
	if chip then
		chip.Activated:Connect(function()
			local sfx = ctx.Modules and ctx.Modules.Sfx
			if sfx and type(sfx.Play) == "function" then
				pcall(sfx.Play, "UIClick")
			end
			openMultSheet()
		end)
	end
	layout()

	local hooks = ctx.Hooks
	hooks.On("State", onState)
	hooks.On("Input", layout)
	hooks.On("Settings", function()
		relabel()
		refreshTicker()
		layout()
	end)
	hooks.On("Quotes", function(quoteFrame)
		local first = lastQuotes == nil
		lastQuotes = quoteFrame
		if first then
			refreshTicker()
		end
	end)
	bindHotkeys()
end

function Hud.Start()
	if ctx and type(ctx.State) == "table" then
		onState(ctx.State, nil)
	end
	computeAutoPills()
	renderPills()
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">MarketClient</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Markt-Client: Frame dekodieren, Kerzen aus dem Strom, Historie, Lizenz-Filter
--  (Client/Modules/MarketClient)
--  Besitzer: WP5 (Charts, Terminal, Markt-UI). Vertrag: DESIGN.md §C7.5 (WP5-Teil), §C7.2 (Hooks "Quotes"/"Replay"),
--  §C8 (MarketFrame/Replay), §C9 (MktCandles), §B6.2 (Lizenz-Sätze), §B7.2/§B7.5 (Schichten, Indikatoren);
--  MARKET.md §9.4 (Client-Kerzen, Lücke > 2 Ticks -> Historie neu), §10.2 (Frame-Format).
--
--  Ablauf: Remote "MarketFrame" (1 Hz, buffer) -> QuoteCodec.DecodeFrame -> je Instrument die 1s-Kerze
--  (Open = Schluss des Vortick, Hoch/Tief aus HiOff/LoOff) -> in alle geladenen Kerzen-Reihen (1s/5s/1m/…)
--  einrechnen -> Hook "Quotes"(frame). Historie je (Instrument, Zeitrahmen) einmal per Request "MktCandles"
--  (eigener Token-Bucket unter dem Server-Bucket 6/2, höchstens 2 Anfragen gleichzeitig), danach live aus dem Strom.
--  Lücke im Tick-Zähler > 2: offene (verfolgte) Reihen werden neu angefordert, alle anderen verworfen.
--  Tagesbeginn je Wert: exakt aus dem Strom (Glocke miterlebt) oder aus der 1T-Historie (Hintergrund, niedrige
--  Priorität). Übungsaktie ACAD (Remote "Replay", nur Tutorial) -> Hook "Replay"(tick, close, phase).
--
--  Öffentliche API (§C7.5):
--    MarketClient.Frame(): Types.Frame?              letzter dekodierter Frame
--    MarketClient.Quote(i): (number?, number?)       Schluss (Cent), Veränderung seit Tagesbeginn als ANTEIL (0.0235)
--                                                    – nil, solange der Tagesbeginn noch unbekannt ist
--    MarketClient.Candles(i, tf, cb)                 cb(candles) einmalig: Historie + Strom, gecacht (nicht verändern!)
--    MarketClient.Instrument(i): Types.Instrument?   MarketClient.Allowed(i): boolean (Lizenz-Satz, gelistet)
--    MarketClient.Regime(): number
--  Zusätzlich: Track(i, tf, fn) -> trennen (fn bei jedem (Neu-)Laden), SeriesError(i, tf), NextSeq(), Row(i),
--    Ids(), AllowedIds(), Tick(),
--    BidAsk(i): (bid, ask, mid), Halted(i), Flags(), Candle1s(i), DayOpen(i), Spark(i), Sector(i),
--    Licence(), LicenceDef(idx?), LicenceName(idx?), Layer(), Perks(), Practice(), Init(ctx), Start()
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local QuoteCodec = require(Shared:WaitForChild("Market"):WaitForChild("QuoteCodec"))

local MarketClient = {}

type Candle = Types.Candle
type Frame = Types.Frame
type QuoteRow = Types.QuoteRow

type Series = {
	Key: string,
	I: number,
	Tf: string,
	Ticks: number,
	Candles: { Candle },
	Loaded: boolean,
	InFlight: boolean,
	Queued: boolean,
	Waiters: { (candles: { Candle }) -> () },
	Trackers: { [number]: (candles: { Candle }) -> () },
	TrackCount: number,
	AsOf: number,
	RetryAt: number,
	Fails: number,
	Error: string?,
	LastUse: number,
	Prefetch: boolean,
}

type Practice = { Tick: number, Close: number, Phase: number, At: number, Candles: { Candle } }

local DAY = 1200
local MAX_KEEP = 320 -- so viele Kerzen je Reihe (Chart ≤ 120 + Aufwärmen der Indikatoren)
local RECENT_1S = 16 -- letzte 1s-Kerzen je Wert (nach dem Laden der Historie nachrechnen)
local SPARK_STEP = 10 -- Ticks zwischen zwei Sparkline-Punkten
local SPARK_MAX = 48
local BUCKET_CAP = 5 -- eigener Anfrage-Bucket (Server: 6 Kapazität, 2/s)
local BUCKET_RATE = 1.8
local MAX_IN_FLIGHT = 2
local RETRY_BASE = 2.5 -- Sekunden bis zum nächsten Versuch (wächst bis RETRY_MAX)
local RETRY_MAX = 20
local IDLE_DROP = 180 -- nicht verfolgte Reihen nach so vielen Sekunden ohne Nutzung verwerfen
local PRACTICE_STALE = 4 -- ohne Replay-Paket so lange -> Übung nicht mehr aktiv
local PRACTICE_KEEP = 240
local REMOTE_RETRIES = 6
local REMOTE_RETRY_GAP = 5

local SET_RANK: { [string]: number } = { Azubi = 1, Trader = 2, Fonds = 3 }
-- Indikatoren ab Lizenz (§B7.5): SMA/EMA Azubi III · Bollinger Trader I · RSI Trader II · MACD/VWAP Trader III ·
-- Stochastik/ATR Fondsmanager I
local INDICATOR_FROM: { [string]: number } = {
	SMA20 = 3,
	SMA50 = 3,
	SMA200 = 3,
	EMA9 = 3,
	EMA21 = 3,
	BB = 4,
	RSI = 5,
	MACD = 6,
	VWAP = 6,
	Stoch = 7,
	ATR = 7,
}

local ctx: any = nil
local companies: any = {}
local marketCfg: any = {}
local lastFrame: Frame? = nil
local lastTick = 0
local rows: { [number]: QuoteRow } = {}
local activeIds: { number } = {}
local prevClose: { [number]: number } = {}
local live1s: { [number]: Candle } = {}
local recent: { [number]: { Candle } } = {}
local recentHead: { [number]: number } = {}
local dayOpen: { [number]: number } = {}
local dayOpenDay: { [number]: number } = {}
local spark: { [number]: { number } } = {}
local series: { [string]: Series } = {}
local seriesByInst: { [number]: { Series } } = {}
local tokens = BUCKET_CAP
local tokenClock = os.clock()
local inFlight = 0
local trackIdCounter = 0
local practice: Practice? = nil
local connected: { [string]: boolean } = {}
local errorAt: { [string]: number } = {}

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function logOnce(source: string, err: any)
	local now = os.clock()
	if now - (errorAt[source] or -math.huge) >= 10 then
		errorAt[source] = now
		warn(("[MarketClient] %s: %s"):format(source, tostring(err)))
	end
end

local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function state(): { [string]: any }
	local s = ctx and ctx.State
	return if type(s) == "table" then s else {}
end

local function tfTicks(tf: string): number?
	local ticks = (QuoteCodec.TF :: any)[tf]
	if type(ticks) == "number" and ticks >= 1 then
		return ticks
	end
	return nil
end

local function instOf(i: number): any
	local byId = companies.ById
	return if type(byId) == "table" then byId[i] else nil
end

-- ---------------------------------------------------------------------
-- LIZENZ, SCHICHT, WERKZEUGE (nur Lizenz + Know-how, nie Robux – §0.4)
-- ---------------------------------------------------------------------
function MarketClient.Licence(): number
	local prog = state().Prog
	local idx = if type(prog) == "table" then prog.Licence else nil
	if type(idx) == "number" and idx == idx then
		return math.clamp(math.floor(idx), 1, 10)
	end
	return 1
end

function MarketClient.LicenceDef(idx: number?): { [string]: any }
	local index = math.clamp(math.floor(tonumber(idx) or MarketClient.Licence()), 1, 10)
	local config = ctx and ctx.Config
	local progression = config and config.Progression
	local list = type(progression) == "table" and progression.Licences or nil
	local def = type(list) == "table" and list[index] or nil
	if type(def) == "table" and type(def.Set) == "string" and type(def.Layer) == "string" then
		return def
	end
	local trading = config and config.Trading
	local fallback = type(trading) == "table" and trading.LicenceFallback or nil
	local entry = type(fallback) == "table" and fallback[index] or nil
	if type(entry) == "table" then
		return entry
	end
	return {
		Key = "Azubi1",
		Set = "Azubi",
		Layer = "Simple",
		FeeBps = 10,
		MaxWeight = 0.30,
		MaxOrders = 5,
		PosFactor = 0.01,
		BotSlots = 0,
		BauKurs = 40,
		Basis = 2500000,
	}
end

function MarketClient.LicenceName(idx: number?): string
	local index = math.clamp(math.floor(tonumber(idx) or MarketClient.Licence()), 1, 10)
	local def = MarketClient.LicenceDef(index)
	local name = def.Name
	if type(name) == "table" and ctx and ctx.Lang then
		local text = ctx.Lang.Pick(ctx.Lang_(), name)
		if type(text) == "string" and text ~= "" then
			return text
		end
	end
	if ctx then
		return ctx.T("term.lic." .. tostring(index))
	end
	return tostring(index)
end

function MarketClient.Layer(): string
	local layer = MarketClient.LicenceDef().Layer
	if layer == "Trader" or layer == "Pro" then
		return layer
	end
	return "Simple"
end

-- TradingPerks-Ersatz: kommt der Server-Wert mit (State Prog.Tools = ProgressionService Core.TradingPerks), gilt er;
-- sonst aus Lizenz + Know-how. (Prog.Perks ist der Vorstands-Perk-Baum des Börsengangs – NICHT die Werkzeuge.)
function MarketClient.Perks(): { [string]: any }
	local prog = state().Prog
	local raw = if type(prog) == "table" then prog.Tools else nil
	if type(raw) == "table" and type(raw.Indicators) == "table" then
		return raw
	end
	local licence = MarketClient.Licence()
	local def = MarketClient.LicenceDef(licence)
	local kh: { [string]: any } = {}
	if type(prog) == "table" then
		if type(prog.KnowHow) == "table" then
			kh = prog.KnowHow
		elseif type(prog.KH) == "table" then
			kh = prog.KH
		end
	end
	local function level(key: string): number
		local v = kh[key]
		return if finite(v) then math.max(0, math.floor(v)) else 0
	end
	local indicators: { [string]: boolean } = {}
	for name, from in pairs(INDICATOR_FROM) do
		indicators[name] = licence >= from
	end
	local botLevels: { [string]: number } = {}
	for _, preset in ipairs({ "Sparplan", "Trend", "Dividend", "Dip" }) do
		botLevels[preset] = level("BotLvl." .. preset)
	end
	return {
		Licence = licence,
		Layer = MarketClient.Layer(),
		BotSlots = if finite(def.BotSlots) then def.BotSlots else 0,
		BotLevels = botLevels,
		Alerts = math.min(18, 3 + 3 * level("Alerts")),
		Watchlists = math.min(5, 1 + level("Watch")),
		Layouts = 1 + level("Layouts"),
		Monitors = level("Monitors"),
		ResearchLead = 2 + (if level("Research") >= 2 then 3 elseif level("Research") >= 1 then 1 else 0),
		MultiChart = level("MultiChart") >= 1 and licence >= 7,
		Risk = level("Risk"),
		Indicators = indicators,
	}
end

-- ---------------------------------------------------------------------
-- INSTRUMENTE
-- ---------------------------------------------------------------------
function MarketClient.Instrument(i: number): any
	if type(i) ~= "number" then
		return nil
	end
	return instOf(i)
end

function MarketClient.Allowed(i: number): boolean
	local inst = MarketClient.Instrument(i)
	if type(inst) ~= "table" or inst.Set == "Tutorial" then
		return false
	end
	if inst.Ipo == true and rows[i] == nil then
		return false -- IPO erst ab Erstnotiz (im Frame)
	end
	local rank = SET_RANK[MarketClient.LicenceDef().Set] or 1
	return (SET_RANK[inst.Set] or 3) <= rank
end

-- erlaubte Werte, sortiert: ETFs zuerst (AKX36 vorn), dann nach Id
function MarketClient.AllowedIds(): { number }
	local out: { number } = {}
	local list = companies.Instruments
	if type(list) ~= "table" then
		return out
	end
	for _, inst in ipairs(list) do
		if type(inst) == "table" and type(inst.Id) == "number" and MarketClient.Allowed(inst.Id) then
			table.insert(out, inst.Id)
		end
	end
	table.sort(out, function(a: number, b: number): boolean
		local ia, ib = instOf(a), instOf(b)
		local ca = if ia and ia.Class == "ETF" then 0 else 1
		local cb = if ib and ib.Class == "ETF" then 0 else 1
		if ca ~= cb then
			return ca < cb
		end
		return a < b
	end)
	return out
end

function MarketClient.Sector(i: number): { Key: string, Name: string, Color: Color3 }?
	local inst = MarketClient.Instrument(i)
	if type(inst) ~= "table" then
		return nil
	end
	local sectors = companies.Sectors
	if type(sectors) == "table" then
		for _, sector in ipairs(sectors) do
			if type(sector) == "table" and sector.Key == inst.Sector then
				local name = sector.Key
				if ctx and ctx.Lang and type(sector.Name) == "table" then
					name = ctx.Lang.Pick(ctx.Lang_(), sector.Name)
				end
				return { Key = sector.Key, Name = name, Color = sector.Color }
			end
		end
	end
	local etfName = if ctx then ctx.T("term.sector.etf") else "ETF"
	return { Key = "X", Name = etfName, Color = Color3.fromRGB(79, 140, 255) }
end

-- ---------------------------------------------------------------------
-- KURSE
-- ---------------------------------------------------------------------
function MarketClient.Frame(): Frame?
	return lastFrame
end

function MarketClient.Tick(): number
	return lastTick
end

function MarketClient.Row(i: number): QuoteRow?
	return rows[i]
end

function MarketClient.Ids(): { number }
	return activeIds
end

function MarketClient.Regime(): number
	local frame = lastFrame
	if frame and finite(frame.Regime) and frame.Regime > 0 then
		return frame.Regime
	end
	local market = state().Market
	if type(market) == "table" and finite(market.Regime) and market.Regime > 0 then
		return market.Regime
	end
	return 1
end

function MarketClient.DayOpen(i: number): number?
	local day = lastTick // DAY
	if dayOpenDay[i] == day then
		return dayOpen[i]
	end
	return nil
end

function MarketClient.Quote(i: number): (number?, number?)
	local row = rows[i]
	if not row then
		return nil, nil
	end
	local open = MarketClient.DayOpen(i)
	if open and open > 0 then
		return row.Close, (row.Close - open) / open
	end
	return row.Close, nil
end

-- Geld/Brief aus mid (gleiche Formel wie der Server, Spread je Klasse × Regime)
function MarketClient.BidAsk(i: number): (number?, number?, number?)
	local row = rows[i]
	local inst = MarketClient.Instrument(i)
	if not row or type(inst) ~= "table" then
		return nil, nil, nil
	end
	local classes = marketCfg.Classes
	local class = type(classes) == "table" and classes[inst.Class] or nil
	local bps = if type(class) == "table" and finite(class.SpreadBps) then class.SpreadBps else 8
	local bid, ask = QuoteCodec.Spread(row.Close, bps, MarketClient.Regime())
	return bid, ask, row.Close
end

function MarketClient.Halted(i: number): boolean
	local row = rows[i]
	if row and bit32.band(row.Flags, QuoteCodec.ROW_FLAGS.Halt) ~= 0 then
		return true
	end
	local market = state().Market
	local halts = type(market) == "table" and market.Halts or nil
	if type(halts) == "table" then
		local all = halts["0"]
		local one = halts[tostring(i)]
		if (finite(all) and all > lastTick) or (finite(one) and one > lastTick) then
			return true
		end
	end
	return false
end

function MarketClient.Flags(): { Halt: boolean, Admin: boolean, Crash: boolean, Rally: boolean }
	local flags = if lastFrame then lastFrame.Flags else 0
	local f = QuoteCodec.FRAME_FLAGS
	return {
		Halt = bit32.band(flags, f.Halt) ~= 0,
		Admin = bit32.band(flags, f.Admin) ~= 0,
		Crash = bit32.band(flags, f.Crash) ~= 0,
		Rally = bit32.band(flags, f.Rally) ~= 0,
	}
end

function MarketClient.Candle1s(i: number): Candle?
	return live1s[i]
end

-- Mini-Kurve für Watchlist/Karten: Stichproben (alle 10 Ticks) + aktueller Schluss
function MarketClient.Spark(i: number): { number }
	local samples = spark[i]
	local out: { number } = {}
	if samples then
		for _, v in ipairs(samples) do
			table.insert(out, v)
		end
	end
	local row = rows[i]
	if row then
		table.insert(out, row.Close)
	end
	return out
end

-- Sequenznummer für Trade-Anfragen (TradePlace/Cancel/Modify/Basket): monoton und über Sitzungen hinweg
-- verschieden (Server merkt sich die letzten 32 im Depot) – Basis = Server-Sekunde · 1024, höchstens 2^31
local seqLast = 0
function MarketClient.NextSeq(): number
	local now = if ctx and ctx.Clock then ctx.Clock.Now() else os.time()
	local base = (math.floor(now) % 2097152) * 1024
	seqLast = math.max(seqLast + 1, base)
	if seqLast > 2 ^ 31 then
		seqLast = base
	end
	return seqLast
end

-- ---------------------------------------------------------------------
-- KERZEN-REIHEN (Historie + Strom)
-- ---------------------------------------------------------------------
local function seriesKey(i: number, tf: string): string
	return tostring(i) .. ":" .. tf
end

local function getSeries(i: number, tf: string): Series?
	local ticks = tfTicks(tf)
	if not ticks then
		return nil
	end
	local key = seriesKey(i, tf)
	local s = series[key]
	if not s then
		local fresh: Series = {
			Key = key,
			I = i,
			Tf = tf,
			Ticks = ticks,
			Candles = {},
			Loaded = false,
			InFlight = false,
			Queued = false,
			Waiters = {},
			Trackers = {},
			TrackCount = 0,
			AsOf = 0,
			RetryAt = 0,
			Fails = 0,
			Error = nil,
			LastUse = os.clock(),
			Prefetch = false,
		}
		series[key] = fresh
		local list = seriesByInst[i]
		if not list then
			list = {}
			seriesByInst[i] = list
		end
		table.insert(list, fresh)
		s = fresh
	end
	return s
end

local function dropSeries(s: Series)
	series[s.Key] = nil
	local list = seriesByInst[s.I]
	if list then
		local index = table.find(list, s)
		if index then
			table.remove(list, index)
		end
		if #list == 0 then
			seriesByInst[s.I] = nil
		end
	end
end

-- eine 1s-Kerze in eine Reihe einrechnen (Bucket = T // tf · tf, Open = Schluss der Vorkerze)
local function applyCandle(s: Series, c: Candle)
	if c.T <= s.AsOf then
		return -- steckt schon in der Historie
	end
	local list = s.Candles
	local bucket = (c.T // s.Ticks) * s.Ticks
	local last = list[#list]
	if last and last.T == bucket then
		if c.H > last.H then
			last.H = c.H
		end
		if c.L < last.L then
			last.L = c.L
		end
		last.C = c.C
		last.V += c.V
	elseif last == nil or bucket > last.T then
		local open = if last then last.C else c.O
		table.insert(list, {
			T = bucket,
			O = open,
			H = math.max(open, c.H),
			L = math.min(open, c.L),
			C = c.C,
			V = c.V,
		})
		if #list > MAX_KEEP then
			table.remove(list, 1)
		end
	end
end

local function notifyLoaded(s: Series)
	local waiters = s.Waiters
	s.Waiters = {}
	for _, fn in ipairs(waiters) do
		local ok, err = pcall(fn, s.Candles)
		if not ok then
			logOnce("Candles-Callback", err)
		end
	end
	for _, fn in pairs(s.Trackers) do
		local ok, err = pcall(fn, s.Candles)
		if not ok then
			logOnce("Track-Callback", err)
		end
	end
end

local function onHistory(s: Series, candles: { Candle })
	-- Tagesbeginn aus der 1T-Historie (letzte Kerze = laufender Börsentag)
	if s.Tf == "1T" then
		local last = candles[#candles]
		if last and last.T // DAY == lastTick // DAY and last.O > 0 and dayOpenDay[s.I] ~= last.T // DAY then
			dayOpen[s.I] = last.O
			dayOpenDay[s.I] = last.T // DAY
		end
	end
	-- Sparkline mit echten 1m-Schlusskursen vorbelegen
	if s.Tf == "1m" then
		local samples: { number } = {}
		for index = math.max(1, #candles - SPARK_MAX + 1), #candles do
			table.insert(samples, candles[index].C)
		end
		if #samples >= 2 then
			spark[s.I] = samples
		end
	end
	while #candles > MAX_KEEP do
		table.remove(candles, 1)
	end
	s.Candles = candles
	local last = candles[#candles]
	s.AsOf = math.max(lastTick, if last then last.T else 0)
	-- 1s-Kerzen, die nach dem Stand der Antwort kamen, nachrechnen
	local ring = recent[s.I]
	if ring then
		local head = recentHead[s.I] or 0
		local ordered: { Candle } = {}
		for k = 1, #ring do
			local c = ring[((head + k - 1) % #ring) + 1]
			if c and c.T > s.AsOf then
				table.insert(ordered, c)
			end
		end
		table.sort(ordered, function(a: Candle, b: Candle): boolean
			return a.T < b.T
		end)
		local asOf = s.AsOf
		for _, c in ipairs(ordered) do
			applyCandle(s, c)
			asOf = math.max(asOf, c.T)
		end
		s.AsOf = asOf
	end
	s.Loaded = true
	s.Error = nil
	s.Fails = 0
	s.Prefetch = false -- Vorab-Ladung erledigt: darf nach IDLE_DROP wieder verworfen werden
	s.LastUse = os.clock()
	notifyLoaded(s)
end

local function refillTokens()
	local now = os.clock()
	tokens = math.min(BUCKET_CAP, tokens + (now - tokenClock) * BUCKET_RATE)
	tokenClock = now
end

local function sendRequest(s: Series)
	s.InFlight = true
	s.Queued = false
	inFlight += 1
	tokens -= 1
	task.spawn(function()
		local ok, reply = pcall(function()
			return ctx.RequestFull("MktCandles", { I = s.I, Tf = s.Tf }, true)
		end)
		inFlight = math.max(0, inFlight - 1)
		s.InFlight = false
		if series[s.Key] ~= s then
			return -- inzwischen verworfen
		end
		if ok and type(reply) == "table" and reply.Ok and typeof(reply.Buf) == "buffer" then
			local inst, tf, _, candles = QuoteCodec.DecodeCandles(reply.Buf)
			if inst == s.I and tf == s.Ticks and candles then
				onHistory(s, candles)
				return
			end
		end
		s.Fails += 1
		s.RetryAt = os.clock() + math.min(RETRY_MAX, RETRY_BASE * s.Fails)
		local message = if ok and type(reply) == "table" and type(reply.Message) == "string" then reply.Message else nil
		s.Error = message or (if ctx then ctx.T("mkt.historyLoading") else nil)
		s.Queued = true -- erneut versuchen, solange jemand wartet oder verfolgt
	end)
end

-- Anfrage-Pumpe: verfolgte Reihen zuerst, dann wartende, dann Vorab-Ladungen (Tagesbeginn) nur mit Reserve
local function pump()
	if not ctx then
		return
	end
	refillTokens()
	local now = os.clock()
	local guard = 0
	while inFlight < MAX_IN_FLIGHT and tokens >= 1 and guard < 8 do
		guard += 1
		local best: Series? = nil
		local bestScore = -math.huge
		for _, s in pairs(series) do
			if s.Queued and not s.InFlight and now >= s.RetryAt then
				local wanted = s.TrackCount > 0 or #s.Waiters > 0
				if not wanted and not s.Prefetch then
					s.Queued = false
				else
					local score = (if s.TrackCount > 0 then 1000 else 0)
						+ (if #s.Waiters > 0 then 500 else 0)
						- s.Fails * 10
						- (now - s.LastUse) * 0.01
					if s.Prefetch and not wanted then
						score -= 2000 -- nur mit Reserve
					end
					if score > bestScore then
						best, bestScore = s, score
					end
				end
			end
		end
		local chosen = best
		if not chosen then
			return
		end
		if bestScore < -1000 and tokens < BUCKET_CAP - 1 then
			return -- Vorab-Ladung nur, wenn der Bucket fast voll ist
		end
		sendRequest(chosen)
	end
end

local function queue(s: Series)
	s.LastUse = os.clock()
	if s.InFlight then
		return
	end
	s.Queued = true
	task.defer(pump)
end

function MarketClient.Candles(i: number, tf: string, cb: (candles: { Candle }) -> ())
	if type(i) ~= "number" or type(tf) ~= "string" or type(cb) ~= "function" then
		return
	end
	local s = getSeries(i, tf)
	if not s then
		return
	end
	s.LastUse = os.clock()
	s.Prefetch = false
	if s.Loaded then
		local ok, err = pcall(cb, s.Candles)
		if not ok then
			logOnce("Candles-Callback", err)
		end
		return
	end
	table.insert(s.Waiters, cb)
	queue(s)
end

-- Reihe "offen halten": fn(candles) bei jedem Laden und Neu-Laden (Lücke > 2 Ticks). Rückgabe = trennen.
function MarketClient.Track(i: number, tf: string, fn: (candles: { Candle }) -> ()): () -> ()
	local s = if type(i) == "number" and type(tf) == "string" then getSeries(i, tf) else nil
	if not s or type(fn) ~= "function" then
		return function() end
	end
	local entry = s :: Series
	trackIdCounter += 1
	local id = trackIdCounter
	entry.Trackers[id] = fn
	entry.TrackCount += 1
	entry.Prefetch = false
	entry.LastUse = os.clock()
	if entry.Loaded then
		local ok, err = pcall(fn, entry.Candles)
		if not ok then
			logOnce("Track-Callback", err)
		end
	else
		queue(entry)
	end
	return function()
		if entry.Trackers[id] then
			entry.Trackers[id] = nil
			entry.TrackCount = math.max(0, entry.TrackCount - 1)
			entry.LastUse = os.clock()
		end
	end
end

-- Fehlertext einer Reihe (für den Platzhalter im Chart) – nil, wenn alles gut ist
function MarketClient.SeriesError(i: number, tf: string): string?
	local s = series[seriesKey(i, tf)]
	return if s and not s.Loaded then s.Error else nil
end

-- ---------------------------------------------------------------------
-- FRAME-VERARBEITUNG
-- ---------------------------------------------------------------------
local function pushRecent(i: number, c: Candle)
	local ring = recent[i]
	if not ring then
		ring = {}
		recent[i] = ring
	end
	local head = ((recentHead[i] or 0) % RECENT_1S) + 1
	recentHead[i] = head
	local slot = ring[head]
	if slot then
		slot.T, slot.O, slot.H, slot.L, slot.C, slot.V = c.T, c.O, c.H, c.L, c.C, c.V
	else
		ring[head] = { T = c.T, O = c.O, H = c.H, L = c.L, C = c.C, V = c.V }
	end
end

local function needDayOpen(i: number)
	local s = getSeries(i, "1T")
	if s and not s.Loaded and not s.InFlight and not s.Queued and s.TrackCount == 0 and #s.Waiters == 0 then
		s.Prefetch = true
		s.Queued = true
	end
end

local function onGap()
	for _, s in pairs(series) do
		if s.Loaded then
			if s.TrackCount > 0 then
				s.Loaded = false
				s.Queued = true
				s.RetryAt = 0
			else
				dropSeries(s)
			end
		end
	end
	table.clear(prevClose)
end

local function onFrame(payload: any)
	if typeof(payload) ~= "buffer" then
		return
	end
	local frame = QuoteCodec.DecodeFrame(payload)
	if not frame then
		return
	end
	if frame.Tick <= lastTick then
		return -- alt oder doppelt
	end
	local gap = if lastTick > 0 then frame.Tick - lastTick else 1
	if gap > 2 then
		onGap()
	end
	local consecutive = gap == 1
	local day = frame.Tick // DAY
	local newRows: { [number]: QuoteRow } = {}
	local ids: { number } = table.create(#frame.Rows)
	for _, row in ipairs(frame.Rows) do
		local i = row.Id
		newRows[i] = row
		table.insert(ids, i)
		local c = row.Close
		local before = prevClose[i]
		local o = if consecutive and before and before > 0 then before else c
		local candle = live1s[i]
		if not candle then
			candle = { T = 0, O = 0, H = 0, L = 0, C = 0, V = 0 }
			live1s[i] = candle
		end
		candle.T = frame.Tick
		candle.O = o
		candle.C = c
		candle.H = math.max(QuoteCodec.HiFrom(o, c, row.HiOff), o, c)
		candle.L = math.min(QuoteCodec.LoFrom(o, c, row.LoOff), o, c)
		candle.V = row.Vol
		pushRecent(i, candle)
		-- Tagesbeginn: Glocke im Strom miterlebt -> exakt (Open der ersten Sekunde = Schluss des Vortags)
		if dayOpenDay[i] ~= day then
			if consecutive and before and before > 0 and (frame.Tick - 1) // DAY < day then
				dayOpen[i] = before
				dayOpenDay[i] = day
			else
				needDayOpen(i)
			end
		end
		-- in alle geladenen Reihen dieses Werts
		local list = seriesByInst[i]
		if list then
			for _, s in ipairs(list) do
				if s.Loaded then
					applyCandle(s, candle)
					s.AsOf = math.max(s.AsOf, frame.Tick)
				end
			end
		end
		-- Sparkline-Stichprobe
		if frame.Tick % SPARK_STEP == 0 then
			local samples = spark[i]
			if not samples then
				samples = {}
				spark[i] = samples
			end
			table.insert(samples, c)
			if #samples > SPARK_MAX then
				table.remove(samples, 1)
			end
		end
		prevClose[i] = c
	end
	-- nicht mehr gelistete Werte vergessen
	for i in pairs(rows) do
		if newRows[i] == nil then
			prevClose[i] = nil
			live1s[i] = nil
		end
	end
	table.sort(ids)
	rows = newRows
	activeIds = ids
	lastTick = frame.Tick
	lastFrame = frame
	-- ungenutzte Reihen aufräumen
	local now = os.clock()
	for _, s in pairs(series) do
		if s.TrackCount == 0 and #s.Waiters == 0 and not s.Prefetch and not s.InFlight then
			if now - s.LastUse > IDLE_DROP then
				dropSeries(s)
			end
		end
	end
	pump()
	ctx.Hooks.Fire("Quotes", frame)
end

-- ---------------------------------------------------------------------
-- ÜBUNGSAKTIE ACAD (Remote "Replay")
-- ---------------------------------------------------------------------
local function notePractice(tick: number, close: number, phase: number)
	if not finite(tick) or not finite(close) or close <= 0 then
		return
	end
	local p = practice
	if p == nil or tick < p.Tick - 5 or os.clock() - p.At > PRACTICE_STALE * 3 then
		p = { Tick = 0, Close = close, Phase = 0, At = 0, Candles = {} }
		practice = p
	end
	local pr = p :: Practice
	if tick <= pr.Tick then
		pr.At = os.clock()
		return
	end
	local last = pr.Candles[#pr.Candles]
	local open = if last then last.C else close
	table.insert(pr.Candles, {
		T = tick,
		O = open,
		H = math.max(open, close),
		L = math.min(open, close),
		C = close,
		V = 0,
	})
	if #pr.Candles > PRACTICE_KEEP then
		table.remove(pr.Candles, 1)
	end
	pr.Tick = tick
	pr.Close = close
	pr.Phase = phase
	pr.At = os.clock()
end

local function onReplay(payload: any)
	local tick, close, phase = QuoteCodec.DecodeReplay(payload)
	if type(tick) ~= "number" or type(close) ~= "number" then
		return
	end
	notePractice(tick, close, phase or 0)
	ctx.Hooks.Fire("Replay", tick, close, phase or 0)
end

-- laufende Übung (nil, wenn seit PRACTICE_STALE s kein Paket kam)
function MarketClient.Practice(): Practice?
	local p = practice
	if p and os.clock() - p.At <= PRACTICE_STALE then
		return p
	end
	return nil
end

-- ---------------------------------------------------------------------
-- START
-- ---------------------------------------------------------------------
local function connectRemotes(): boolean
	local remotes = ctx.Remotes or {}
	local done = true
	local frameRemote = remotes.MarketFrame
	if not connected.MarketFrame then
		if frameRemote and frameRemote:IsA("RemoteEvent") then
			connected.MarketFrame = true
			frameRemote.OnClientEvent:Connect(function(payload)
				local ok, err = pcall(onFrame, payload)
				if not ok then
					logOnce("Frame", err)
				end
			end)
		else
			done = false
		end
	end
	local replayRemote = remotes.Replay
	if not connected.Replay then
		if replayRemote and replayRemote:IsA("RemoteEvent") then
			connected.Replay = true
			replayRemote.OnClientEvent:Connect(function(payload)
				local ok, err = pcall(onReplay, payload)
				if not ok then
					logOnce("Replay", err)
				end
			end)
		else
			done = false
		end
	end
	return done
end

function MarketClient.Init(context: any)
	ctx = context
	local config = ctx.Config or {}
	companies = if type(config.Companies) == "table" then config.Companies else {}
	marketCfg = if type(config.Market) == "table" then config.Market else {}
	-- Pakete, die Main.client als Rückfall feuert (vor unserer Verbindung), ebenfalls mitschreiben
	ctx.Hooks.On("Replay", function(tick, close, phase)
		if type(tick) == "number" and type(close) == "number" then
			notePractice(tick, close, if type(phase) == "number" then phase else 0)
		end
	end)
end

function MarketClient.Start()
	-- erst NACH dem Start aller Module verbinden (Main.client verbindet seine Remotes synchron danach) –
	-- so liegen alle Hook-Listener schon bereit, wenn der erste Frame kommt
	task.defer(function()
		if connectRemotes() then
			return
		end
		for _ = 1, REMOTE_RETRIES do
			task.wait(REMOTE_RETRY_GAP)
			local ok, remotes = pcall(ctx.Net.GetRemotes)
			if ok and type(remotes) == "table" then
				for name, remote in pairs(remotes) do
					ctx.Remotes[name] = remote
				end
			end
			if connectRemotes() then
				return
			end
		end
		warn("[MarketClient] MarketFrame/Replay fehlen – keine Kurse")
	end)
end

return MarketClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="145">
            <Properties>
              <string name="Name">Monitors</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Welt-Monitore mit Live-Charts (Client/Modules/Monitors)
--  Besitzer: WP5 (Charts, Terminal, Markt-UI). Vertrag: DESIGN.md §B7.5 (Welt-Monitore: Client-SurfaceGuis mit
--  Adornee = Server-Part, die nächsten K live (K = 2/4/8/12 je Grafikstufe), Rest eingefrorene Schnappschüsse, ≤ 2 Hz,
--  30–60 Kerzen ohne Beschriftung, LightInfluence 0, Brightness 2, MaxDistance 300, PixelsPerStud 40), §A5 (Riesen-
--  Kerzentafel AKX36, 12er-Monitorwand, 6×6-Sektor-Heatmap-Wand, Ticker-Wände), §D WP5 („CityService-Monitor-Parts
--  über Attribut Monitor im Workspace“), §C16 (Budgets), §0 Regel 16 (StreamingEnabled: nil-sicher, Teile kommen/gehen).
--
--  Ein Welt-Scan (verteilt über mehrere Frames) + DescendantAdded/-Removing findet alle BaseParts mit Attribut
--  "Monitor". Bedeutung des Werts (WP7/WP8 setzen ihn):
--    Zahl                      Chart dieses Instruments (Id)
--    "Chart"                   Chart des Instruments aus Attribut "Inst" (sonst AKX36)
--    "Candles"                 große Kerzentafel AKX36 (60 Kerzen)
--    "Heatmap"                 6×6-Sektor-Heatmap (Tagesveränderung)
--    "Desk"                    eigener größter Wert (Trading-Desk im Tower), sonst AKX36
--    "Ticker" | "TickerRing"   Ticker-Wand -> Modul Ticker (AddWall/RemoveWall)
--    Kürzel (z. B. "CGVO")     Chart dieses Werts
--  Optionale Attribute: "Face" (Enum.NormalId-Name, Standard Front), "Inst" (Zahl).
--  Gepoolte Ansichten (SurfaceGui + ChartView) werden zwischen Monitoren weitergereicht – kein Neuaufbau beim Laufen.
--
--  Öffentliche API (WP5-intern):
--    Monitors.Count(): (live, mit Oberfläche, gesamt)    (DebugOverlay „Live-Monitore“)
--    Monitors.Frame(dt), Monitors.Init(ctx), Monitors.Start()
-- =====================================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local Monitors = {}

type Slot = {
	Gui: SurfaceGui,
	Kind: string,
	Root: Frame,
	Title: TextLabel,
	Price: TextLabel,
	Body: Frame,
	LiveDot: Frame,
	View: any?,
	Cells: { { Frame: Frame, Label: TextLabel, I: number } }?,
}

type Mon = {
	Part: BasePart,
	Kind: string, -- Chart | Candles | Heatmap | Desk
	Inst: number,
	Slot: Slot?,
	Live: boolean,
	Dist: number,
	Loaded: boolean,
	Conn: RBXScriptConnection?,
}

local Theme = UI.Theme
local PIXELS_PER_STUD = 40
local MAX_DISTANCE = 300
local MAX_MONITORS = 96
local UPDATE_EVERY = 0.5 -- ≤ 2 Hz
local SCAN_CHUNK = 1500
local AKX36 = 40
local LIVE_PULSE = TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)

local ctx: any = nil
local monitors: { [BasePart]: Mon } = {}
local count = 0
local pool: { [string]: { Slot } } = {}
local clock = 0
local liveCount = 0
local guiCount = 0
local playerGui: PlayerGui? = nil

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function call(name: string, fnName: string, ...: any): (boolean, any, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil, nil
	end
	return pcall(fn, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function price(cents: number): string
	local ok, text = pcall(ctx.Format.Price, cents, lang())
	return if ok then text else tostring(cents / 100)
end

local function pct(fraction: number): string
	local ok, text = pcall(ctx.Format.Pct, fraction, lang(), 2, true)
	return if ok then text else string.format("%+.2f %%", fraction * 100)
end

local function instByTicker(ticker: string): number?
	local companies = ctx.Config.Companies
	local list = type(companies) == "table" and companies.Instruments or nil
	if type(list) ~= "table" then
		return nil
	end
	for _, inst in ipairs(list) do
		if type(inst) == "table" and inst.Ticker == ticker and inst.Set ~= "Tutorial" then
			return inst.Id
		end
	end
	return nil
end

local function faceOf(part: BasePart): Enum.NormalId
	local name = part:GetAttribute("Face")
	if type(name) == "string" then
		local ok, value = pcall(function()
			return (Enum.NormalId :: any)[name]
		end)
		if ok and typeof(value) == "EnumItem" then
			return value :: any
		end
	end
	return Enum.NormalId.Front
end

-- Monitor-Art aus dem Attribut; nil = keine Chart-/Heatmap-Art (z. B. Ticker -> eigenes Modul)
local function classify(part: BasePart): (string?, number)
	local value = part:GetAttribute("Monitor")
	if type(value) == "number" then
		return "Chart", math.floor(value)
	elseif type(value) ~= "string" then
		return nil, AKX36
	end
	if value == "Chart" then
		local inst = part:GetAttribute("Inst")
		return "Chart", if type(inst) == "number" then math.floor(inst) else AKX36
	elseif value == "Candles" then
		return "Candles", AKX36
	elseif value == "Heatmap" then
		return "Heatmap", AKX36
	elseif value == "Desk" then
		return "Desk", AKX36
	elseif value == "Ticker" or value == "TickerRing" then
		return "Ticker", AKX36
	end
	local byTicker = instByTicker(value)
	if byTicker then
		return "Chart", byTicker
	end
	return "Chart", AKX36
end

-- größter eigener Wert (Trading-Desk zeigt deine Live-Positionen)
local function deskInstrument(): number
	local depot = ctx.State.Depot
	local pos = type(depot) == "table" and depot.Pos or nil
	local best, bestValue = AKX36, -1
	if type(pos) == "table" then
		for key, p in pairs(pos) do
			local i = tonumber(key)
			if i and type(p) == "table" and type(p.Q) == "number" and p.Q > 0 then
				local okQuote, close = call("MarketClient", "Quote", i)
				local value = p.Q * (if okQuote and type(close) == "number" then close else 0)
				if value > bestValue then
					best, bestValue = i, value
				end
			end
		end
	end
	return best
end

-- ---------------------------------------------------------------------
-- OBERFLÄCHEN (gepoolt je Art)
-- ---------------------------------------------------------------------
local function newSlot(kind: string): Slot?
	local gui = playerGui
	if not gui then
		return nil
	end
	local surface: SurfaceGui = UI.Create("SurfaceGui", {
		Name = "AkytexMonitor",
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = PIXELS_PER_STUD,
		LightInfluence = 0,
		Brightness = 2,
		MaxDistance = MAX_DISTANCE,
		AlwaysOnTop = false,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Enabled = false,
		Parent = gui,
	})
	local root: Frame = UI.Create("Frame", {
		Name = "Screen",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Parent = surface,
	}, {
		UI.Create("UIStroke", {
			Color = Theme.Accent,
			Thickness = 2,
			Transparency = 0.45,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
	})
	-- „LIVE“-Punkt: pulsiert grün, solange dieser Monitor live läuft (sonst eingefrorener Schnappschuss)
	local liveDot: Frame = UI.Create("Frame", {
		Name = "Live",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0.025, 0.09),
		Size = UDim2.fromScale(0.03, 0.03),
		BackgroundColor3 = Theme.Up,
		BorderSizePixel = 0,
		Visible = false,
		Parent = root,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.Create("UIAspectRatioConstraint", { AspectRatio = 1, DominantAxis = Enum.DominantAxis.Height }),
	})
	TweenService:Create(liveDot, LIVE_PULSE, { BackgroundTransparency = 0.7 }):Play()
	local title: TextLabel = UI.Create("TextLabel", {
		Name = "Title",
		Position = UDim2.fromScale(0.06, 0.02),
		Size = UDim2.fromScale(0.5, 0.14),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Display,
		TextScaled = true,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Parent = root,
	})
	local priceLabel: TextLabel = UI.Create("TextLabel", {
		Name = "Price",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.97, 0.02),
		Size = UDim2.fromScale(0.45, 0.14),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.MonoBold,
		TextScaled = true,
		RichText = true,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = root,
	})
	local body: Frame = UI.Create("Frame", {
		Name = "Body",
		Position = UDim2.fromScale(0.02, 0.18),
		Size = UDim2.fromScale(0.96, 0.79),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local slot: Slot = {
		Gui = surface,
		Kind = kind,
		Root = root,
		Title = title,
		Price = priceLabel,
		Body = body,
		LiveDot = liveDot,
		View = nil,
		Cells = nil,
	}
	if kind == "Heatmap" then
		local cells: { { Frame: Frame, Label: TextLabel, I: number } } = {}
		local companies = ctx.Config.Companies
		local sectors = type(companies) == "table" and companies.Sectors or {}
		local instruments = type(companies) == "table" and companies.Instruments or {}
		for col, sector in ipairs(sectors) do
			local row = 0
			for _, inst in ipairs(instruments) do
				if inst.Sector == sector.Key and not inst.Ipo and inst.Id <= 36 and row < 6 then
					row += 1
					local cell: Frame = UI.Create("Frame", {
						Position = UDim2.new((col - 1) / 6, 2, (row - 1) / 6, 2),
						Size = UDim2.new(1 / 6, -4, 1 / 6, -4),
						BackgroundColor3 = Theme.Surface2,
						BorderSizePixel = 0,
						Parent = body,
					})
					local label: TextLabel = UI.Create("TextLabel", {
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
						FontFace = UI.Faces.MonoBold,
						TextScaled = true,
						TextColor3 = Theme.Text,
						Text = inst.Ticker,
						Parent = cell,
					})
					table.insert(cells, { Frame = cell, Label = label, I = inst.Id })
				end
			end
		end
		slot.Cells = cells
	else
		local lib = ctx.Modules.ChartView
		if lib then
			local ok, view = pcall(lib.new, body, {
				Candles = if kind == "Candles" then 60 else 40,
				Volume = true,
				Style = "Candles",
				Labels = false,
				Smooth = false,
				AreaFill = false,
				MaxLines = 0,
			})
			if ok then
				slot.View = view
			end
		end
	end
	return slot
end

local function poolKey(kind: string): string
	return if kind == "Heatmap" then "Heatmap" elseif kind == "Candles" then "Candles" else "Chart"
end

local function takeSlot(kind: string): Slot?
	local key = poolKey(kind)
	local list = pool[key]
	if list and #list > 0 then
		return table.remove(list)
	end
	return newSlot(key)
end

local function releaseSlot(mon: Mon)
	local slot = mon.Slot
	if not slot then
		return
	end
	mon.Slot = nil
	mon.Loaded = false
	slot.LiveDot.Visible = false
	slot.Gui.Enabled = false
	slot.Gui.Adornee = nil
	local key = poolKey(mon.Kind)
	local list = pool[key]
	if not list then
		list = {}
		pool[key] = list
	end
	if #list < 6 then
		table.insert(list, slot)
	else
		if slot.View then
			slot.View:Destroy()
		end
		slot.Gui:Destroy()
	end
end

-- ---------------------------------------------------------------------
-- INHALT
-- ---------------------------------------------------------------------
local function drawTitle(slot: Slot, i: number)
	local okInst, inst = call("MarketClient", "Instrument", i)
	local ticker = if okInst and type(inst) == "table" then inst.Ticker else "?"
	if slot.Title.Text ~= ticker then
		slot.Title.Text = ticker
	end
	local okQuote, close, change = call("MarketClient", "Quote", i)
	local text = ""
	if okQuote and type(close) == "number" then
		text = price(close)
		if type(change) == "number" then
			text ..= string.format(
				'  <font color="%s">%s %s</font>',
				UI.ColorHex(UI.TrendColor(change)),
				UI.TrendArrow(change),
				pct(change)
			)
		end
	end
	if slot.Price.Text ~= text then
		slot.Price.Text = text
	end
end

local function loadHistory(mon: Mon)
	local slot = mon.Slot
	if not slot or not slot.View then
		return
	end
	mon.Loaded = true
	local view = slot.View
	call("MarketClient", "Candles", mon.Inst, "1m", function(candles)
		if mon.Slot == slot and view.Alive then
			view:SetData(candles, "1m")
		end
	end)
end

local function updateMonitor(mon: Mon)
	local slot = mon.Slot
	if not slot then
		return
	end
	if mon.Kind == "Heatmap" then
		if slot.Title.Text ~= ctx.T("term.mon.heatmap") then
			slot.Title.Text = ctx.T("term.mon.heatmap")
		end
		slot.Price.Text = ""
		for _, cell in ipairs(slot.Cells or {}) do
			local _, _, change = call("MarketClient", "Quote", cell.I)
			local value = if type(change) == "number" then change else 0
			local color = if value >= 0 then UI.UpColor() else UI.DownColor()
			local tint = Theme.Surface2:Lerp(color, math.clamp(math.abs(value) / 0.04, 0.12, 1))
			if cell.Frame.BackgroundColor3 ~= tint then
				cell.Frame.BackgroundColor3 = tint
			end
		end
		return
	end
	if mon.Kind == "Desk" then
		local wanted = deskInstrument()
		if wanted ~= mon.Inst then
			mon.Inst = wanted
			loadHistory(mon)
		end
	end
	drawTitle(slot, mon.Inst)
	local view = slot.View
	if view then
		local ok, candle = call("MarketClient", "Candle1s", mon.Inst)
		if ok and type(candle) == "table" then
			view:PushQuote(candle.C, candle.T, candle.H, candle.L, candle.V)
		end
		view:Step(1)
	end
end

local function attach(mon: Mon): boolean
	if mon.Slot then
		return true
	end
	local slot = takeSlot(mon.Kind)
	if not slot then
		return false
	end
	mon.Slot = slot
	slot.Gui.Adornee = mon.Part
	slot.Gui.Face = faceOf(mon.Part)
	slot.Gui.Enabled = true
	if mon.Kind == "Desk" then
		mon.Inst = deskInstrument()
	end
	if slot.View then
		slot.View:SetData({}, "1m")
		loadHistory(mon)
	end
	updateMonitor(mon) -- einmal zeichnen (danach bleibt der Schnappschuss stehen, wenn nicht live)
	return true
end

-- ---------------------------------------------------------------------
-- REGISTRIEREN
-- ---------------------------------------------------------------------
local function remove(part: BasePart)
	local mon = monitors[part]
	if mon then
		monitors[part] = nil
		count -= 1
		if mon.Conn then
			mon.Conn:Disconnect()
		end
		releaseSlot(mon)
		return
	end
	if part:GetAttribute("Monitor") == "Ticker" or part:GetAttribute("Monitor") == "TickerRing" then
		call("Ticker", "RemoveWall", part)
	end
end

local function add(inst: Instance)
	if not inst:IsA("BasePart") or monitors[inst] then
		return
	end
	local part = inst :: BasePart
	local kind, instId = classify(part)
	if kind == nil then
		return
	end
	if kind == "Ticker" then
		call("Ticker", "AddWall", part)
		return
	end
	if count >= MAX_MONITORS then
		return
	end
	local mon: Mon = {
		Part = part,
		Kind = kind,
		Inst = instId,
		Slot = nil,
		Live = false,
		Dist = math.huge,
		Loaded = false,
		Conn = nil,
	}
	mon.Conn = part.AncestryChanged:Connect(function()
		if not part:IsDescendantOf(workspace) then
			remove(part)
		end
	end)
	monitors[part] = mon
	count += 1
end

local function scan()
	local ok, list = pcall(function()
		return workspace:GetDescendants()
	end)
	if not ok or type(list) ~= "table" then
		return
	end
	for index, inst in ipairs(list) do
		if inst:IsA("BasePart") and inst:GetAttribute("Monitor") ~= nil then
			add(inst)
		end
		if index % SCAN_CHUNK == 0 then
			task.wait()
		end
	end
end

-- ---------------------------------------------------------------------
-- TAKT (2 Hz): nächste K live, Oberflächen nur in Sichtweite, Rest eingefroren
-- ---------------------------------------------------------------------
local function budget(): number
	local ok, value = call("Quality", "Budget", "Monitors")
	return if ok and type(value) == "number" then math.max(0, math.floor(value)) else 4
end

local function step()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local origin = camera.CFrame.Position
	local sorted: { Mon } = {}
	for part, mon in pairs(monitors) do
		if part.Parent then
			mon.Dist = (part.Position - origin).Magnitude
			table.insert(sorted, mon)
		end
	end
	table.sort(sorted, function(a: Mon, b: Mon): boolean
		return a.Dist < b.Dist
	end)
	local k = budget()
	local maxGuis = k + math.max(2, k // 2 + 2)
	liveCount, guiCount = 0, 0
	for index, mon in ipairs(sorted) do
		local inRange = mon.Dist <= MAX_DISTANCE
		if inRange and index <= maxGuis then
			if attach(mon) then
				guiCount += 1
				local live = index <= k
				if live then
					liveCount += 1
					if not mon.Live and mon.Slot and mon.Slot.View then
						loadHistory(mon) -- wieder live: Historie auffrischen (keine Lücke)
					end
					updateMonitor(mon)
				end
				mon.Live = live
				local slot = mon.Slot
				if slot and slot.LiveDot.Visible ~= live then
					slot.LiveDot.Visible = live
				end
			end
		else
			mon.Live = false
			releaseSlot(mon)
		end
	end
end

function Monitors.Count(): (number, number, number)
	return liveCount, guiCount, count
end

function Monitors.Frame(dt: number)
	clock += dt
	if clock < UPDATE_EVERY then
		return
	end
	clock = 0
	local ok, err = pcall(step)
	if not ok then
		warn("[Monitors] " .. tostring(err))
	end
end

function Monitors.Init(context: any)
	ctx = context
	playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
	ctx.Hooks.On("Settings", function()
		-- Sprache/Farbenblind: Schnappschüsse neu zeichnen
		for _, mon in pairs(monitors) do
			if mon.Slot then
				if mon.Slot.View then
					mon.Slot.View:Repaint()
				end
				updateMonitor(mon)
			end
		end
	end)
end

function Monitors.Start()
	workspace.DescendantAdded:Connect(function(inst: Instance)
		if inst:IsA("BasePart") and inst:GetAttribute("Monitor") ~= nil then
			add(inst)
		end
	end)
	workspace.DescendantRemoving:Connect(function(inst: Instance)
		if inst:IsA("BasePart") and (monitors[inst] or inst:GetAttribute("Monitor") ~= nil) then
			remove(inst)
		end
	end)
	task.spawn(scan)
end

return Monitors
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="146">
            <Properties>
              <string name="Name">NewsFeed</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Eilmeldungen: News-Karte („Dynamic Island“), News-Liste, Tiko-Ampel, Termine (Client/Modules/NewsFeed)
--  Besitzer: WP5 (Charts, Terminal, Markt-UI). Vertrag: DESIGN.md §B7.4 (Karte, Drosselung, Tiko-Ampel, Liste 50),
--  §0.3 Punkt 5 (kein Kauf-Knopf, kein Blinken, kein Countdown), §C15 (Client lokalisiert News), §C7.5 (NewsFeed.Recent),
--  §B1 (Pille „nächster Termin der Watchlist“); MARKET.md §6.1/§6.2 (8 s Lesefenster, Stärke-Wörter).
--
--  Karte gleitet oben in der Mitte ein, NUR wenn: Wert gehalten oder auf der Watchlist UND Stärke ≥ „deutlich“, oder
--  Makro/Sektor/Crash/Rallye/IPO (+ Warnstufe, Admin-Eilmeldung). Höchstens 1 Karte je 30 s (Rest nur in der Liste).
--  Einstellung „NewsCards“: Normal · Quiet (Ruhemodus: nur Crash/Rallye; die Glocke zeigt EffectsMarket) · Off.
--  Inhalt: Art-Chip, Quellen-Sterne, Sektor-Chip, Schlagzeile mit fettem Stärke-Wort, ruhiger Balken „Händler lesen …“
--  (8 s ab Veröffentlichung), danach „Markt reagiert“. Knöpfe nur „Zum Chart“ und „×“ – KEIN Kauf-Knopf.
--  Tiko-Ampel (für die Schicht „Einfach“, optional „Trader“; das Terminal entscheidet): Fakten-News -> nach 20 s
--  grün/rot (Richtung der Meldung), Gerücht/„wie erwartet“ -> „?“ mit einem Erklär-Satz.
--  Liste endlich: letzte 50 (kein endloser Feed). Seed beim Start über Request "MktNews", danach Hook "Market:News".
--  Termine: Request "MktCalendar" { Days = 1 } (Start, Glocke, Kalender-Delta) -> Hud-Pille "Earnings".
--
--  Öffentliche API (§C7.5):
--    NewsFeed.Recent(): { Types.NewsItem }            neueste zuerst, höchstens 50 (Kopie)
--  Zusätzlich: NewsFeed.Text(item, plain?): string (lokalisiert, RichText mit fettem Stärke-Wort, plain = ohne Markup)
--    NewsFeed.KindLabel(item) · NewsFeed.Ampel(item): (state, text) · NewsFeed.LatestFor(instId, factOnly?)
--    NewsFeed.Mount(parent, opts?): { Frame, Refresh, SetFilter, Destroy }   (Listen für Terminal/Handy-Tab)
--    NewsFeed.Calendar(): { Types.CalendarItem }      kommende Termine (sortiert)
--    NewsFeed.Tick(), NewsFeed.Init(ctx), NewsFeed.Start()
-- =====================================================================

local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local NewsFeed = {}

type Item = { [string]: any }
type ListRow = {
	Frame: TextButton,
	Time: TextLabel,
	Kind: TextLabel,
	Head: TextLabel,
	Dot: Frame,
	Item: Item?,
	Lang: string,
}
type ListView = {
	Frame: ScrollingFrame,
	Rows: { ListRow },
	Filter: ((Item) -> boolean)?,
	Max: number,
	Alive: boolean,
	Empty: TextLabel,
}

local Theme = UI.Theme
local MAX_ITEMS = 50
local CARD_GAP = 30 -- höchstens 1 Karte je 30 s (§B7.4)
local CARD_MAX_AGE = 20 -- ältere Meldungen (z. B. Seed beim Beitritt) bekommen keine Karte
local CARD_STAY = 7 -- nach dem Lesefenster noch so lange sichtbar
local AMPEL_AFTER = 20 -- Tiko-Ampel zeigt die Richtung 20 s nach der Meldung
local CARD_W = 540
local CARD_H = 112
local CARD_TOP = 74 -- unter Ticker-Leiste + Pillen
local CALENDAR_REFRESH = 300
local PILL_REFRESH = 5
local IN_INFO = TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local OUT_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local FACT_KINDS: { [string]: boolean } = { Fact = true, Confirm = true, Deny = true, Earnings = true }
local CARD_KINDS: { [string]: boolean } = { Macro = true, Sector = true, Ipo = true, Admin = true }
local CRASH_KINDS: { [string]: boolean } = { Crash = true, Rally = true, Warn = true }

local ctx: any = nil
local items: { Item } = {}
local seen: { [number]: boolean } = {}
local lists: { ListView } = {}
local calendar: { Item } = {}
local lastCardAt = -math.huge
local cardItem: Item? = nil
local cardToken = 0
local calendarAt = -math.huge
local pillClock = 0
local listDirty = false

-- Karten-Oberfläche
local card: Frame? = nil
local cardScale: UIScale? = nil
local cardStripe: Frame? = nil
local cardKind: TextLabel? = nil
local cardSector: TextLabel? = nil
local cardHead: TextLabel? = nil
local cardBarFill: Frame? = nil
local cardBarText: TextLabel? = nil
local cardChart: any = nil

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function lang(): string
	return ctx.Lang_()
end

local function call(name: string, fnName: string, ...: any): (boolean, any, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil, nil
	end
	return pcall(fn, ...)
end

local function escape(text: string): string
	local out = string.gsub(text, "&", "&amp;")
	out = string.gsub(out, "<", "&lt;")
	out = string.gsub(out, ">", "&gt;")
	return out
end

local function nowTick(): number
	local ok, tick = pcall(ctx.Clock.Tick)
	return if ok and type(tick) == "number" then tick else 0
end

local function settings(): { [string]: any }
	local ok, value = call("Settings", "Get")
	if ok and type(value) == "table" then
		return value
	end
	local s = ctx.State.Settings
	return if type(s) == "table" then s else {}
end

local function depot(): { [string]: any }
	local d = ctx.State.Depot
	return if type(d) == "table" then d else {}
end

local function held(i: number): boolean
	local pos = depot().Pos
	local p = type(pos) == "table" and pos[tostring(i)] or nil
	return type(p) == "table" and type(p.Q) == "number" and p.Q > 0
end

local function watched(i: number): boolean
	local watch = depot().Watch
	if type(watch) ~= "table" then
		return false
	end
	for _, list in ipairs(watch) do
		if type(list) == "table" and table.find(list, i) then
			return true
		end
	end
	return false
end

local function readDelay(): number
	local market = ctx.Config and ctx.Config.Market
	local delay = type(market) == "table" and market.Delay or nil
	return if type(delay) == "number" and delay > 0 then delay else 8
end

local function ageOf(item: Item): number
	return math.max(0, ctx.Clock.Now() - ctx.Clock.UnixOf(item.T or 0))
end

local function instName(i: number?): (string?, string?)
	if type(i) ~= "number" then
		return nil, nil
	end
	local ok, inst = call("MarketClient", "Instrument", i)
	if ok and type(inst) == "table" then
		return inst.Ticker, inst.Name
	end
	return nil, nil
end

local function formatValue(key: string, value: any): string
	local l = lang()
	if type(value) == "number" then
		if key == "amt" and value % 1 ~= 0 then
			local ok, text = pcall(ctx.Format.Price, math.round(value * 100), l)
			return if ok then text else tostring(value)
		end
		local ok, text = pcall(ctx.Format.Int, value, l)
		return if ok then text else tostring(value)
	elseif type(value) == "string" then
		if ctx.Lang.Has(value) then
			return ctx.Lang.T(l, value)
		end
		return value
	end
	return ""
end

-- ---------------------------------------------------------------------
-- TEXTE
-- ---------------------------------------------------------------------
function NewsFeed.Text(item: Item, plain: boolean?): string
	if type(item) ~= "table" then
		return ""
	end
	local l = lang()
	if type(item.Text) == "table" then
		local body = ctx.Lang.Pick(l, item.Text)
		local text = ctx.T("news.admin") .. ": " .. body
		return if plain then text else escape(text)
	end
	local template = ctx.Lang.T(l, if type(item.Key) == "string" then item.Key else "news.admin")
	local args = if type(item.Args) == "table" then item.Args else {}
	if not plain then
		template = escape(template)
	end
	local text = string.gsub(template, "{(%a+)}", function(key: string): string
		local value = formatValue(key, args[key])
		if plain then
			return value
		end
		if key == "band" then
			return "<b>" .. escape(value) .. "</b>"
		end
		return escape(value)
	end)
	return text
end

function NewsFeed.KindLabel(item: Item): string
	local kind = if type(item) == "table" and type(item.Kind) == "string" then item.Kind else "Fact"
	local label = ctx.T("term.kind." .. kind)
	if kind == "Rumor" and type(item.Stars) == "number" then
		label ..= " " .. string.rep("★", math.clamp(math.floor(item.Stars), 1, 3))
	end
	return label
end

-- Tiko-Ampel: state "wait" | "up" | "down" | "rumor" | "expected" | "none"
function NewsFeed.Ampel(item: Item?): (string, string)
	if type(item) ~= "table" then
		return "none", ctx.T("term.ampel.none")
	end
	local kind = item.Kind
	if kind == "Rumor" then
		return "rumor", ctx.T("term.ampel.rumor")
	elseif kind == "AsExpected" then
		return "expected", ctx.T("term.ampel.expected")
	elseif FACT_KINDS[kind] and type(item.Dir) == "number" and item.Dir ~= 0 then
		if ageOf(item) < AMPEL_AFTER then
			return "wait", ctx.T("term.ampel.wait")
		end
		if item.Dir > 0 then
			return "up", ctx.T("term.ampel.up")
		end
		return "down", ctx.T("term.ampel.down")
	end
	return "none", ctx.T("term.ampel.none")
end

-- neueste Meldung zu einem Wert (factOnly: nur Fakten/Gerücht/„wie erwartet“ – für die Ampel)
function NewsFeed.LatestFor(i: number, factOnly: boolean?): Item?
	for _, item in ipairs(items) do
		if item.I == i then
			if not factOnly or FACT_KINDS[item.Kind] or item.Kind == "Rumor" or item.Kind == "AsExpected" then
				return item
			end
		end
	end
	return nil
end

function NewsFeed.Recent(): { Item }
	return table.clone(items)
end

-- ---------------------------------------------------------------------
-- KARTE („Dynamic Island“)
-- ---------------------------------------------------------------------
local function buildCard()
	local root: Frame = UI.Create("Frame", {
		Name = "NewsCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -CARD_H - 20),
		Size = UDim2.fromOffset(CARD_W, CARD_H),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 40,
		Parent = ctx.Gui,
	}, {
		UI.Corner(18),
		UI.Stroke(nil, 1),
		UI.Create("UISizeConstraint", { MaxSize = Vector2.new(CARD_W, CARD_H) }),
	})
	cardScale = UI.Create("UIScale", { Parent = root })
	cardStripe = UI.Create("Frame", {
		Name = "Stripe",
		Position = UDim2.fromOffset(10, 14),
		Size = UDim2.new(0, 3, 1, -28),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 41,
		Parent = root,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	cardKind = UI.Create("TextLabel", {
		Name = "Kind",
		Position = UDim2.fromOffset(22, 10),
		Size = UDim2.new(0.5, -22, 0, 16),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.MonoBold,
		TextSize = 12,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		ZIndex = 41,
		Parent = root,
	})
	cardSector = UI.Create("TextLabel", {
		Name = "Sector",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -52, 0, 10),
		Size = UDim2.new(0.5, -60, 0, 16),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.BodyBold,
		TextSize = 12,
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		ZIndex = 41,
		Parent = root,
	})
	cardHead = UI.Create("TextLabel", {
		Name = "Headline",
		Position = UDim2.fromOffset(22, 30),
		Size = UDim2.new(1, -44, 0, 40),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Body,
		TextSize = 16,
		TextWrapped = true,
		RichText = true,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
		ZIndex = 41,
		Parent = root,
	})
	local bar: Frame = UI.Create("Frame", {
		Name = "Bar",
		Position = UDim2.new(0, 22, 1, -26),
		Size = UDim2.new(1, -178, 0, 6),
		BackgroundColor3 = Theme.Bg2,
		BorderSizePixel = 0,
		ZIndex = 41,
		Parent = root,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	cardBarFill = UI.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		ZIndex = 42,
		Parent = bar,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	cardBarText = UI.Create("TextLabel", {
		Name = "BarText",
		Position = UDim2.new(0, 22, 1, -20),
		Size = UDim2.new(1, -178, 0, 16),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Body,
		TextSize = 12,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		ZIndex = 41,
		Parent = root,
	})
	cardChart = UI.Button({
		Name = "ToChart",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -10),
		Size = UDim2.fromOffset(128, 32),
		Text = ctx.T("term.news.toChart"),
		Variant = "Secondary",
		MaxText = 14,
		Corner = 10,
		ZIndex = 43,
		Parent = root,
	}, function()
		local item = cardItem
		if item and type(item.I) == "number" then
			call("Terminal", "OpenAt", item.I)
		end
		NewsFeed.HideCard()
	end)
	UI.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 6),
		Size = UDim2.fromOffset(32, 32),
		Text = "✕",
		Variant = "Ghost",
		MaxText = 16,
		Corner = 10,
		ZIndex = 43,
		Parent = root,
	}, function()
		NewsFeed.HideCard()
	end)
	card = root
end

function NewsFeed.HideCard()
	local root = card
	if not root or not root.Visible then
		return
	end
	cardToken += 1
	local token = cardToken
	local tween = TweenService:Create(root, OUT_INFO, { Position = UDim2.new(0.5, 0, 0, -CARD_H - 20) })
	tween.Completed:Once(function()
		if cardToken == token then
			root.Visible = false
			cardItem = nil
		end
	end)
	tween:Play()
	UI.SetToastFloor(nil)
end

local function kindColor(item: Item): Color3
	local kind = item.Kind
	if kind == "Crash" or (kind == "Warn" and (item.Dir or 0) < 0) then
		return UI.DownColor()
	elseif kind == "Rally" then
		return UI.UpColor()
	elseif kind == "Admin" then
		return Theme.Warn
	elseif kind == "Rumor" then
		return Theme.Purple
	end
	return Theme.Accent
end

local function showCard(item: Item)
	if not card then
		buildCard()
	end
	local root = card :: Frame
	cardItem = item
	cardToken += 1
	local token = cardToken
	local color = kindColor(item)
	local sectorText = ""
	local sectorColor = Theme.Text2
	if type(item.I) == "number" then
		local okSector, sector = call("MarketClient", "Sector", item.I)
		local ticker = instName(item.I)
		if okSector and type(sector) == "table" then
			sectorText = (ticker or "") .. " · " .. tostring(sector.Name)
			sectorColor = sector.Color
		end
	elseif type(item.Sector) == "string" then
		local sectors = ctx.Config.Companies and ctx.Config.Companies.Sectors
		if type(sectors) == "table" then
			for _, sector in ipairs(sectors) do
				if sector.Key == item.Sector then
					sectorText = ctx.Lang.Pick(lang(), sector.Name)
					sectorColor = sector.Color
				end
			end
		end
	end
	if cardStripe then
		cardStripe.BackgroundColor3 = color
	end
	if cardKind then
		cardKind.Text = UI.Upper(ctx.T("term.news.breaking") .. " · " .. NewsFeed.KindLabel(item))
		cardKind.TextColor3 = color
	end
	if cardSector then
		cardSector.Text = sectorText
		cardSector.TextColor3 = sectorColor
	end
	if cardHead then
		cardHead.Text = NewsFeed.Text(item, false)
	end
	local allowed = false
	if type(item.I) == "number" then
		local ok, value = call("MarketClient", "Allowed", item.I)
		allowed = ok and value == true
	end
	cardChart.Frame.Visible = allowed
	cardChart.SetText(ctx.T("term.news.toChart"))
	-- ruhiger Lese-Balken (8 s ab Veröffentlichung), danach „Markt reagiert“
	local delay = readDelay()
	local age = ageOf(item)
	local fill = cardBarFill :: Frame
	local barText = cardBarText :: TextLabel
	fill.BackgroundColor3 = color
	if age < delay then
		fill.Size = UDim2.fromScale(math.clamp(age / delay, 0, 1), 1)
		barText.Text = ctx.T("trade.readingBar")
		local reading = TweenService:Create(
			fill,
			TweenInfo.new(delay - age, Enum.EasingStyle.Linear),
			{ Size = UDim2.fromScale(1, 1) }
		)
		reading.Completed:Once(function()
			if cardToken == token then
				barText.Text = ctx.T("trade.marketReacts")
			end
		end)
		reading:Play()
	else
		fill.Size = UDim2.fromScale(1, 1)
		barText.Text = ctx.T("trade.marketReacts")
	end
	-- einblenden: von oben gleiten, leichte Feder über die Skalierung (kein CanvasGroup)
	root.Visible = true
	root.Position = UDim2.new(0.5, 0, 0, -CARD_H - 20)
	if cardScale then
		cardScale.Scale = 0.96
		TweenService:Create(cardScale, IN_INFO, { Scale = 1 }):Play()
	end
	TweenService:Create(root, IN_INFO, { Position = UDim2.new(0.5, 0, 0, CARD_TOP) }):Play()
	-- Meldungen (Toasts) rutschen unter die Karte statt von ihr verdeckt zu werden
	UI.SetToastFloor(CARD_TOP + CARD_H + 8)
	call("Sfx", "Play", "Notify")
	task.delay(math.max(0, delay - age) + CARD_STAY, function()
		if cardToken == token then
			NewsFeed.HideCard()
		end
	end)
end

local function eligible(item: Item): boolean
	local mode = settings().NewsCards
	if mode == "Off" then
		return false
	end
	local kind = item.Kind
	if mode == "Quiet" then
		return CRASH_KINDS[kind] == true
	end
	if CRASH_KINDS[kind] or CARD_KINDS[kind] then
		return true
	end
	local i = item.I
	if type(i) == "number" and (held(i) or watched(i)) and type(item.Band) == "number" and item.Band >= 2 then
		return true
	end
	return false
end

-- ---------------------------------------------------------------------
-- LISTEN
-- ---------------------------------------------------------------------
local function timeAgo(item: Item): string
	local age = ageOf(item)
	if age < 60 then
		return ctx.T("term.news.now")
	elseif age < 3600 then
		return ctx.T("term.news.ago", ctx.T("term.minutes", math.floor(age / 60)))
	end
	local ok, text = pcall(ctx.Format.Duration, age, lang())
	return ctx.T("term.news.ago", if ok then text else tostring(math.floor(age)))
end

local function ampelColor(stateName: string): Color3
	if stateName == "up" then
		return UI.UpColor()
	elseif stateName == "down" then
		return UI.DownColor()
	elseif stateName == "rumor" or stateName == "expected" then
		return Theme.Warn
	end
	return Theme.Muted
end

local function newRow(view: ListView, order: number)
	local frame: TextButton = UI.Create("TextButton", {
		Name = "News",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Surface2,
		BackgroundTransparency = 0.2,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = order,
		Parent = view.Frame,
	}, {
		UI.Corner(10),
		UI.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 10),
			PaddingTop = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 8),
		}),
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
	})
	local top: Frame = UI.Create("Frame", {
		Name = "Top",
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = frame,
	})
	local dot: Frame = UI.Create("Frame", {
		Name = "Ampel",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Theme.Muted,
		BorderSizePixel = 0,
		Visible = false,
		Parent = top,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local kind: TextLabel = UI.Create("TextLabel", {
		Name = "Kind",
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(0.6, -14, 1, 0),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.MonoBold,
		TextSize = 11,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Parent = top,
	})
	local time: TextLabel = UI.Create("TextLabel", {
		Name = "Time",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.4, 0, 1, 0),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Mono,
		TextSize = 11,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = top,
	})
	local head: TextLabel = UI.Create("TextLabel", {
		Name = "Head",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Body,
		TextSize = 14,
		TextWrapped = true,
		RichText = true,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		LayoutOrder = 2,
		Parent = frame,
	})
	local row: ListRow = { Frame = frame, Time = time, Kind = kind, Head = head, Dot = dot, Item = nil, Lang = "" }
	frame.Activated:Connect(function()
		local item = row.Item
		if item and type(item.I) == "number" then
			call("Terminal", "OpenAt", item.I)
		end
	end)
	table.insert(view.Rows, row)
end

local function refreshView(view: ListView)
	if not view.Alive then
		return
	end
	local shown = 0
	for _, item in ipairs(items) do
		if shown >= view.Max then
			break
		end
		local filter = view.Filter
		local pass = true
		if filter then
			local ok, value = pcall(filter, item)
			pass = ok and value == true
		end
		if pass then
			shown += 1
			if not view.Rows[shown] then
				newRow(view, shown)
			end
			local row = view.Rows[shown]
			local l = lang()
			if row.Item ~= item or row.Lang ~= l then
				-- Texte nur bei neuem Eintrag oder Sprachwechsel neu bauen
				row.Item = item
				row.Lang = l
				row.Head.Text = NewsFeed.Text(item, false)
				local kindText = UI.Upper(NewsFeed.KindLabel(item))
				local ticker = instName(item.I)
				if ticker then
					kindText ..= " · " .. ticker
				end
				row.Kind.Text = kindText
				row.Kind.TextColor3 = kindColor(item)
			end
			local ago = timeAgo(item)
			if row.Time.Text ~= ago then
				row.Time.Text = ago
			end
			local stateName = NewsFeed.Ampel(item)
			local showDot = stateName ~= "none"
			row.Dot.Visible = showDot
			if showDot then
				row.Dot.BackgroundColor3 = ampelColor(stateName)
			end
			if not row.Frame.Visible then
				row.Frame.Visible = true
			end
		end
	end
	for index = shown + 1, #view.Rows do
		local row = view.Rows[index]
		row.Item = nil
		if row.Frame.Visible then
			row.Frame.Visible = false
		end
	end
	view.Empty.Visible = shown == 0
	view.Empty.Text = ctx.T("term.news.empty")
end

function NewsFeed.Mount(parent: Instance, opts: { [string]: any }?): { [string]: any }
	local o = opts or {}
	local frame: ScrollingFrame = UI.Create("ScrollingFrame", {
		Name = "NewsList",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Muted,
		ScrollBarImageTransparency = 0.3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
		UI.Create("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }),
	})
	local empty: TextLabel = UI.Create("TextLabel", {
		Name = "Empty",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Body,
		TextSize = 14,
		TextColor3 = Theme.Muted,
		Text = "",
		LayoutOrder = 0,
		Parent = frame,
	})
	local view: ListView = {
		Frame = frame,
		Rows = {},
		Filter = if type(o.Filter) == "function" then o.Filter else nil,
		Max = math.clamp(math.floor(tonumber(o.Max) or MAX_ITEMS), 1, MAX_ITEMS),
		Alive = true,
		Empty = empty,
	}
	table.insert(lists, view)
	refreshView(view)
	return {
		Frame = frame,
		Refresh = function()
			refreshView(view)
		end,
		SetFilter = function(fn: ((Item) -> boolean)?)
			view.Filter = fn
			refreshView(view)
		end,
		Destroy = function()
			view.Alive = false
			local index = table.find(lists, view)
			if index then
				table.remove(lists, index)
			end
			frame:Destroy()
		end,
	}
end

-- sichtbar = alle GUI-Vorfahren sichtbar (Tabs blenden ganze Container aus)
local function onScreen(inst: Instance): boolean
	local current: Instance? = inst
	local guard = 0
	while current and guard < 32 do
		guard += 1
		if current:IsA("GuiObject") then
			if not current.Visible then
				return false
			end
		elseif current:IsA("LayerCollector") then
			return current.Enabled
		end
		current = current.Parent
	end
	return false
end

local function refreshLists()
	listDirty = false
	for _, view in ipairs(lists) do
		if view.Alive and onScreen(view.Frame) then
			refreshView(view)
		else
			listDirty = true
		end
	end
end

-- ---------------------------------------------------------------------
-- NEWS EINSORTIEREN
-- ---------------------------------------------------------------------
local function valid(item: any): boolean
	return type(item) == "table"
		and type(item.Id) == "number"
		and type(item.T) == "number"
		and type(item.Key) == "string"
		and type(item.Kind) == "string"
end

local function insert(item: Item): boolean
	if not valid(item) or seen[item.Id] then
		return false
	end
	seen[item.Id] = true
	local index = #items + 1
	for k, other in ipairs(items) do
		if item.T > other.T or (item.T == other.T and item.Id > other.Id) then
			index = k
			break
		end
	end
	table.insert(items, index, item)
	while #items > MAX_ITEMS do
		local removed = table.remove(items)
		if removed then
			seen[removed.Id] = nil
		end
	end
	return true
end

local function onNews(item: any)
	if not insert(item) then
		return
	end
	local now = os.clock()
	if now - lastCardAt >= CARD_GAP and ageOf(item) <= CARD_MAX_AGE and eligible(item) then
		lastCardAt = now
		showCard(item)
	end
	refreshLists()
end

-- ---------------------------------------------------------------------
-- TERMINE (Kalender) + Hud-Pille „Earnings“
-- ---------------------------------------------------------------------
local function setCalendar(list: any, merge: boolean)
	if type(list) ~= "table" then
		return
	end
	local byKey: { [string]: Item } = {}
	local out: { Item } = {}
	local now = nowTick()
	local function add(entry: any)
		if type(entry) == "table" and type(entry.T) == "number" and type(entry.Key) == "string" and entry.T >= now then
			local key = tostring(entry.T) .. ":" .. tostring(entry.Kind) .. ":" .. tostring(entry.I or 0)
			if not byKey[key] then
				byKey[key] = entry
				table.insert(out, entry)
			end
		end
	end
	if merge then
		for _, entry in ipairs(calendar) do
			add(entry)
		end
	end
	for _, entry in ipairs(list) do
		add(entry)
	end
	table.sort(out, function(a: Item, b: Item): boolean
		if a.T ~= b.T then
			return a.T < b.T
		end
		return (a.I or 0) < (b.I or 0)
	end)
	while #out > 120 do
		table.remove(out)
	end
	calendar = out
end

local function requestCalendar()
	calendarAt = os.clock()
	task.spawn(function()
		local reply = ctx.RequestFull("MktCalendar", { Days = 1 }, true)
		if reply.Ok then
			setCalendar(reply.Items, false)
		end
	end)
end

function NewsFeed.Calendar(): { Item }
	local now = nowTick()
	local out: { Item } = {}
	for _, entry in ipairs(calendar) do
		if entry.T >= now then
			table.insert(out, entry)
		end
	end
	return out
end

local function updatePill()
	local now = nowTick()
	local nextItem: Item? = nil
	for _, entry in ipairs(calendar) do
		if entry.Kind == "Earnings" and entry.T > now and type(entry.I) == "number" then
			if held(entry.I) or watched(entry.I) then
				nextItem = entry
				break
			end
		end
	end
	if nextItem then
		local ticker = instName(nextItem.I) or "?"
		call("Hud", "SetPill", "Earnings", ctx.T("term.pill.earnings", ticker), ctx.Clock.UnixOf(nextItem.T))
	else
		call("Hud", "SetPill", "Earnings", nil, nil)
	end
end

-- ---------------------------------------------------------------------
-- TAKT
-- ---------------------------------------------------------------------
function NewsFeed.Tick()
	if listDirty then
		refreshLists()
	else
		-- „vor x min“ und Ampel-Wechsel (20 s) aktualisieren – nur sichtbare Listen
		for _, view in ipairs(lists) do
			if view.Alive and onScreen(view.Frame) then
				refreshView(view)
			end
		end
	end
	pillClock += 1
	if pillClock >= PILL_REFRESH then
		pillClock = 0
		updatePill()
	end
	if os.clock() - calendarAt >= CALENDAR_REFRESH then
		requestCalendar()
	end
end

function NewsFeed.Init(context: any)
	ctx = context
	local hooks = ctx.Hooks
	hooks.On("Market:News", function(item)
		local ok, err = pcall(onNews, item)
		if not ok then
			warn("[NewsFeed] " .. tostring(err))
		end
	end)
	hooks.On("Market:Calendar", function(delta)
		setCalendar(delta, true)
	end)
	hooks.On("Market:Bell", function()
		task.delay(2, requestCalendar)
	end)
	hooks.On("Settings", function()
		refreshLists()
		if cardChart then
			cardChart.SetText(ctx.T("term.news.toChart"))
		end
	end)
	hooks.On("State", function(_state, changed)
		if type(changed) == "table" and (changed.Depot or changed.Prog) then
			listDirty = true
		end
	end)
end

function NewsFeed.Start()
	task.delay(3, function()
		local reply = ctx.RequestFull("MktNews", {}, true)
		if reply.Ok and type(reply.Items) == "table" then
			for _, item in ipairs(reply.Items) do
				insert(item)
			end
			refreshLists()
		end
		requestCalendar()
	end)
end

return NewsFeed
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="147">
            <Properties>
              <string name="Name">PhotoMode</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Foto-Modus für alle (Client/Modules/PhotoMode)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §C7.5, §B11.3 (Fotospots), §D WP2 („Fotomodus für alle,
--  Langdruck beendet auf Touch“). Basis: CC-PhotoMode (REUSE §1.4 COPY, ohne Admin-Sperre).
--
--  Taste F7 (Controls-Aktion "PhotoMode") oder Einstellungen -> Grafik -> Fotomodus (Handy). Rein clientseitig:
--  1,5 s Hinweis-Toast, dann ausblenden: eigene UI (ctx.Gui), Touch-Knöpfe (ctx.TouchGui), Effekt-Ebene,
--  Roblox-Oberfläche (gemerkt und wiederhergestellt) und alle ProximityPrompts (auch wenn der Server sie wieder
--  einschaltet). Nochmal = alles wieder an. Hook "PhotoMode"(on) für andere Ebenen (Banner, Monitore, F8).
--  Handy/Tablet: bei ausgeblendeter UI beendet ein langes Drücken auf den Bildschirm den Modus (REUSE §7 #37).
--
--  Öffentliche API (§C7.5):
--    PhotoMode.Toggle()
--    PhotoMode.IsActive(): boolean
--  Zusätzlich: PhotoMode.Init(ctx), PhotoMode.Start()
-- =====================================================================

local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local PhotoMode = {}

local ctx: any = nil

local DELAY = 1.5 -- Sekunden Toast, bevor ausgeblendet wird
local MAX_PROMPT_SCAN = 20000 -- höchstens so viele Instanzen beim Einschalten durchsuchen (große Stadt)

local photoMode = false
local photoPending = false
local photoToken = 0
local photoHidden: { [ProximityPrompt]: boolean } = {}
local photoConnections: { RBXScriptConnection } = {}
local savedCoreGui: { [Enum.CoreGuiType]: boolean } = {}
local savedGui: { [Instance]: boolean } = {}

local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

-- Modul-Funktion sicher aufrufen (fehlende Module sind kein Fehler)
local function tryCall(name: string, fnName: string, ...: any)
	local modules = ctx and ctx.Modules
	local m = if type(modules) == "table" then modules[name] else nil
	local fn = if type(m) == "table" then m[fnName] else nil
	if type(fn) == "function" then
		pcall(fn, ...)
	end
end

local function fireHook(name: string, ...: any)
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.Fire) == "function" then
		hooks.Fire(name, ...)
	end
end

local function setGuiEnabled(gui: any, on: boolean)
	if typeof(gui) ~= "Instance" or not gui:IsA("LayerCollector") then
		return
	end
	if not on then
		savedGui[gui] = gui.Enabled
		gui.Enabled = false
	elseif savedGui[gui] ~= nil then
		gui.Enabled = savedGui[gui] == true
		savedGui[gui] = nil
	end
end

local function hidePrompt(prompt: ProximityPrompt)
	local function off()
		if photoMode and prompt.Enabled then
			photoHidden[prompt] = true
			prompt.Enabled = false
		end
	end
	off()
	-- Der Server schaltet Prompts evtl. wieder ein -> sofort wieder aus
	table.insert(photoConnections, prompt:GetPropertyChangedSignal("Enabled"):Connect(off))
end

local function startPhotoMode()
	photoMode = true
	local ui = ctx and ctx.UI
	if ui and type(ui.CloseAll) == "function" then
		pcall(ui.CloseAll) -- offene Fenster zu
	end
	setGuiEnabled(ctx and ctx.Gui, false)
	setGuiEnabled(ctx and ctx.TouchGui, false)
	tryCall("Effects", "SetHidden", true)
	fireHook("PhotoMode", true)
	-- Roblox-Oberfläche merken und ausblenden
	savedCoreGui = {}
	for _, item in ipairs(Enum.CoreGuiType:GetEnumItems()) do
		if item ~= Enum.CoreGuiType.All then
			local ok, enabled = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, item)
			-- Nicht lesbar -> beim Beenden trotzdem wieder einschalten (sonst bliebe es für immer aus)
			savedCoreGui[item] = not ok or enabled == true
		end
	end
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.All, false)
	local scanned = 0
	for _, inst in ipairs(workspace:GetDescendants()) do
		scanned += 1
		if scanned > MAX_PROMPT_SCAN then
			break
		end
		if inst:IsA("ProximityPrompt") then
			hidePrompt(inst)
		end
	end
	table.insert(
		photoConnections,
		workspace.DescendantAdded:Connect(function(inst)
			if inst:IsA("ProximityPrompt") then
				hidePrompt(inst)
			end
		end)
	)
end

local function stopPhotoMode()
	photoMode = false
	for _, connection in ipairs(photoConnections) do
		connection:Disconnect()
	end
	photoConnections = {}
	setGuiEnabled(ctx and ctx.Gui, true)
	setGuiEnabled(ctx and ctx.TouchGui, true)
	table.clear(savedGui)
	tryCall("Effects", "SetHidden", false)
	for item, enabled in pairs(savedCoreGui) do
		pcall(StarterGui.SetCoreGuiEnabled, StarterGui, item, enabled)
	end
	-- Rucksack/Lebensbalken bleiben im Tycoon immer aus (Main.client)
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false)
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Health, false)
	for prompt in pairs(photoHidden) do
		if prompt.Parent then
			prompt.Enabled = true
		end
	end
	photoHidden = {}
	fireHook("PhotoMode", false)
end

function PhotoMode.IsActive(): boolean
	return photoMode
end

local function keyName(): string
	local keys = ctx and ctx.Config and ctx.Config.Client and ctx.Config.Client.Keys
	local list = keys and keys.PhotoMode
	if type(list) == "table" and type(list[1]) == "string" then
		return list[1]
	end
	return "F7"
end

function PhotoMode.Toggle()
	if photoMode or photoPending then
		photoToken += 1
		photoPending = false
		if photoMode then
			stopPhotoMode()
			if ctx and type(ctx.Toast) == "function" then
				ctx.Toast(T("ui.photo.off"), "Info")
			end
		end
		return
	end
	photoPending = true
	photoToken += 1
	local token = photoToken
	if ctx and type(ctx.Toast) == "function" then
		local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		ctx.Toast(if touchOnly then T("ui.photo.onTouch") else T("ui.photo.on", keyName()), "Info")
	end
	task.delay(DELAY, function()
		if photoPending and photoToken == token then
			photoPending = false
			startPhotoMode()
		end
	end)
end

function PhotoMode.Init(context: any)
	ctx = context
	-- Taste über Controls (Aktion "PhotoMode", in jedem Kontext erlaubt – auch bei versteckter UI)
	local controls = ctx.Modules and ctx.Modules.Controls
	if controls and type(controls.Bind) == "function" then
		controls.Bind("PhotoMode", function(state)
			if state == "Begin" then
				PhotoMode.Toggle()
			end
		end)
	end
end

function PhotoMode.Start()
	-- Handy: die eigene UI ist im Foto-Modus aus -> lang drücken = beenden
	UserInputService.TouchLongPress:Connect(function(_positions, state: Enum.UserInputState)
		if photoMode and state == Enum.UserInputState.Begin then
			PhotoMode.Toggle()
		end
	end)
end

return PhotoMode
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="148">
            <Properties>
              <string name="Name">Prestige</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Börsengang (Vorschau + Zeremonie), Vorstand-Baum, Titel + die Fortschritts-Effekte
--  (Client/Modules/Prestige)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §B9.6 (Börsengang, Vorschau ab
--  Stufe 7, Zeremonie an der Glocke oder „Aus der Ferne läuten“ mit Kinoszene, Vorstand nur Turm/Lifestyle), §B9.5
--  (Titel), §A7 #8/#9/#11, §C7.3 (Fenster "Prestige"), §C7.4 (Effekte IpoCeremony, LicenceUp, TitleUp, QuestDone,
--  Achievement – Besitzer dieses Modul), §C7.5.
--
--  Öffentliche API (§C7.5):
--    Prestige.OpenPreview()        Fenster "Prestige" auf dem Börsengang-Tab, Vorschau wird geladen (TowerUI-Einstieg)
--  Zusätzlich: Prestige.Init(ctx), Prestige.Start(), Prestige.Tick() (1 s, Token-Ablauf)
--  Anfragen: ProgIpoPreview, ProgIpo, ProgPerk, ProgRespec, ProgTitle.   State: "Prog".
--  ReducedFx (Einstellung) kürzt jede Zeremonie (keine Kamerafahrt, kein Wackeln, weniger Konfetti).
-- =====================================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))

local Prestige = {}

local Theme = UI.Theme
local player = Players.LocalPlayer

local WINDOW_W, WINDOW_H = 660, 620
local TOKEN_SECONDS = 60
local CARD_IN = TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local CARD_OUT = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local FADE = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local CAMERA_IN = TweenInfo.new(1.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local GOLD_SEQ = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 226, 120)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(250, 204, 21)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 130, 20)),
})

local ctx: any = nil
local window: any = nil
local tab = "ipo"
local segmented: any = nil
local pages: { [string]: Frame } = {}
local fxLayer: Frame? = nil
local ui: { [string]: any } = {}
local preview: { [string]: any }? = nil
local previewAt = 0
local busy = false
local ceremonyBusy = false
local achQueue: { any } = {}
local achBusy = false

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

local function prog(): { [string]: any }
	local p = ctx.State.Prog
	return if type(p) == "table" then p else {}
end

local function pcfg(): any
	local p = ctx.Config.Progression
	return if type(p) == "table" then p else {}
end

local function reducedFx(): boolean
	local ok, settings = call("Settings", "Get")
	return ok and type(settings) == "table" and settings.ReducedFx == true
end

local function sfx(role: string)
	call("Sfx", "Play", role)
end

local function credits(n: number): string
	local ok, text = pcall(ctx.Format.Credits, n, lang())
	return if ok then text else tostring(math.floor(n))
end

local function duration(seconds: number): string
	local ok, text = pcall(ctx.Format.Duration, math.max(0, seconds), lang())
	return if ok then text else tostring(math.floor(seconds))
end

local function titleName(key: string): string
	local def = pcfg().TitleByKey and pcfg().TitleByKey[key]
	if type(def) == "table" and type(def.Name) == "table" then
		return ctx.Lang.Pick(lang(), def.Name)
	end
	return key
end

local function licenceName(idx: number): string
	local list = pcfg().Licences
	local def = type(list) == "table" and list[idx] or nil
	if type(def) == "table" and type(def.Name) == "table" then
		return ctx.Lang.Pick(lang(), def.Name)
	end
	return tostring(idx)
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	props.Parent = parent
	if props.TextXAlignment == nil then
		props.TextXAlignment = Enum.TextXAlignment.Left
	end
	return UI.Label(props)
end

-- ---------------------------------------------------------------------
-- 2) EFFEKTE (§C7.4) – eigene Ebene über der Oberfläche, gibt keine Eingaben weg
-- ---------------------------------------------------------------------
local function layer(): Frame
	local existing = fxLayer
	if existing and existing.Parent then
		return existing
	end
	local frame: Frame = UI.Create("Frame", {
		Name = "PrestigeFX",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 60,
		Active = false,
		Parent = ctx.Gui,
	})
	fxLayer = frame
	return frame
end

-- zentrierte Karte: Titel, Untertitel, Zeilen; gold = Lizenz/Titel-Look
local function showCard(params: { [string]: any })
	local root = layer()
	local width = params.Width or 420
	local height = params.Height or 190
	local card: Frame = UI.Create("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = params.Position or UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = if params.Gold then Color3.new(1, 1, 1) else Theme.Surface,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = root,
	}, { UI.Corner(18), UI.Stroke(if params.Gold then Theme.Gold else Theme.Border, 2) })
	if params.Gold then
		UI.Create("UIGradient", { Color = GOLD_SEQ, Rotation = 25, Parent = card })
	end
	local scale: UIScale = UI.Create("UIScale", { Scale = 0.82, Parent = card })
	local ink = if params.Gold then Theme.Bg else Theme.Text
	UI.Label({
		Name = "Kicker",
		Position = UDim2.fromOffset(20, 14),
		Size = UDim2.new(1, -40, 0, 20),
		Text = UI.Upper(params.Kicker or ""),
		Face = "Display",
		TextColor3 = if params.Gold then Theme.Bg2 else Theme.Accent,
		MaxText = 14,
		ZIndex = 62,
		Parent = card,
	})
	UI.Label({
		Name = "Title",
		Position = UDim2.fromOffset(20, 38),
		Size = UDim2.new(1, -40, 0, 50),
		Text = params.Title or "",
		Face = "Display",
		TextColor3 = ink,
		MaxText = 38,
		ZIndex = 62,
		Parent = card,
	})
	local lines = params.Lines or {}
	for i, line in ipairs(lines) do
		UI.Label({
			Name = "Line" .. i,
			Position = UDim2.fromOffset(20, 92 + (i - 1) * 26),
			Size = UDim2.new(1, -40, 0, 22),
			Text = line,
			Face = "BodyBold",
			TextColor3 = if params.Gold then Theme.Bg2 else Theme.Text2,
			MaxText = 18,
			ZIndex = 62,
			Parent = card,
		})
	end
	if params.Stamp then
		local stamp: TextLabel = UI.Label({
			Name = "Stamp",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -54, 0, 54),
			Size = UDim2.fromOffset(78, 78),
			Text = "✓",
			Face = "Display",
			TextColor3 = Theme.Up,
			BackgroundTransparency = 0.2,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Rotation = -40,
			MaxText = 54,
			ZIndex = 63,
			Parent = card,
		})
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = stamp })
		UI.Create("UIStroke", { Color = Theme.Up, Thickness = 3, Parent = stamp })
		local stampScale: UIScale = UI.Create("UIScale", { Scale = 2.4, Parent = stamp })
		task.delay(0.35, function()
			TweenService:Create(stampScale, CARD_IN, { Scale = 1 }):Play()
			TweenService:Create(stamp, CARD_IN, { Rotation = -12 }):Play()
		end)
	end
	TweenService:Create(scale, CARD_IN, { Scale = 1 }):Play()
	local hold = if reducedFx() then 2.2 else (params.Hold or 3.4)
	task.delay(hold, function()
		if card.Parent then
			TweenService:Create(scale, CARD_OUT, { Scale = 0.9 }):Play()
			TweenService:Create(card, CARD_OUT, { BackgroundTransparency = 1 }):Play()
			task.delay(0.24, function()
				card:Destroy()
			end)
		end
	end)
end

local function confetti(amount: number)
	if reducedFx() then
		amount = math.min(amount, 0.4)
	end
	call("Effects", "Confetti", amount)
end

-- "LicenceUp" {Licence, Key, Basis, BauKurs, Admin?} – Stempel in der Akademie-Karte, goldene Lizenzkarte
local function onLicenceUp(_strength: number, data: any)
	if type(data) ~= "table" then
		return
	end
	local idx = math.floor(num(data.Licence, 1))
	local akyOk, basisText = pcall(ctx.Format.Aky, num(data.Basis, 0), lang(), true)
	showCard({
		Gold = true,
		Stamp = true,
		Kicker = T("prog.licence"),
		Title = licenceName(idx),
		Lines = {
			T("prog.lbl.basis", if akyOk then basisText else tostring(data.Basis)),
			T("prog.lbl.bauKurs", credits(num(data.BauKurs, 0))),
		},
		Hold = 4,
	})
	sfx("RallyFanfare")
	if data.Admin ~= true then
		confetti(0.8)
		-- schöner Moment: nach der Zeremonie einmal Favoriten-Abfrage bzw. Benachrichtigungs-Opt-in (nie im Tutorial)
		task.delay(if reducedFx() then 3 else 5, function()
			call("Social", "PositiveMoment")
		end)
	end
end

-- "TitleUp" {Title, Fanfare} – goldener Kopftitel, eigene Fanfare für Meilenstein-Titel
local function onTitleUp(_strength: number, data: any)
	if type(data) ~= "table" or type(data.Title) ~= "string" then
		return
	end
	showCard({
		Gold = true,
		Kicker = T("prog.tab.titles"),
		Title = titleName(data.Title),
		Lines = {},
		Height = 110,
		Position = UDim2.fromScale(0.5, 0.24),
		Hold = 3,
	})
	if data.Fanfare then
		sfx("RallyFanfare")
		confetti(1)
	else
		sfx("LevelUp")
	end
end

-- "QuestDone" {Id} – Text kommt als Notify (eine Meldung, ein Weg); hier nur Puls am Quests-Knopf + Klang
local function onQuestDone(_strength: number, _data: any)
	sfx("Profit")
	local ok, button = call("Hud", "RightButton", "Quests")
	if ok and type(button) == "table" and button.Frame then
		local scale = button.Frame:FindFirstChildOfClass("UIScale")
		if not scale then
			scale = UI.Create("UIScale", { Parent = button.Frame })
		end
		UI.Pulse(scale :: UIScale, 0.12)
	end
end

local function playAchievement(entry: any)
	achBusy = true
	local root = layer()
	local card: Frame = UI.Create("Frame", {
		Name = "Achievement",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 360, 0, 150),
		Size = UDim2.fromOffset(330, 70),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.04,
		ZIndex = 61,
		Parent = root,
	}, { UI.Corner(14), UI.Stroke(Theme.Gold, 1.5) })
	UI.Label({
		Position = UDim2.fromOffset(12, 11),
		Size = UDim2.fromOffset(48, 48),
		Text = "🏆",
		MaxText = 34,
		ZIndex = 62,
		Parent = card,
	})
	UI.Label({
		Position = UDim2.fromOffset(70, 10),
		Size = UDim2.new(1, -82, 0, 18),
		Text = UI.Upper(T("prog.tab.ach")),
		Face = "Display",
		TextColor3 = Theme.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 12,
		ZIndex = 62,
		Parent = card,
	})
	UI.Label({
		Position = UDim2.fromOffset(70, 30),
		Size = UDim2.new(1, -82, 0, 28),
		Text = if type(entry.Name) == "table" then ctx.Lang.Pick(lang(), entry.Name) else tostring(entry.Id),
		Face = "BodyBold",
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 20,
		ZIndex = 62,
		Parent = card,
	})
	sfx("Achievement")
	TweenService:Create(card, CARD_IN, { Position = UDim2.new(1, -16, 0, 150) }):Play()
	task.delay(if reducedFx() then 2.2 else 3.6, function()
		TweenService:Create(card, CARD_OUT, { Position = UDim2.new(1, 360, 0, 150) }):Play()
		task.delay(0.25, function()
			card:Destroy()
			achBusy = false
			local nextEntry = table.remove(achQueue, 1)
			if nextEntry then
				playAchievement(nextEntry)
			end
		end)
	end)
end

-- "Achievement" {Id}
local function onAchievement(_strength: number, data: any)
	if type(data) ~= "table" or type(data.Id) ~= "string" then
		return
	end
	local byId = pcfg().AchievementById
	local entry = if type(byId) == "table" then byId[data.Id] else nil
	if not entry then
		return
	end
	if achBusy then
		if #achQueue < 8 then
			table.insert(achQueue, entry)
		end
		return
	end
	playAchievement(entry)
end

-- Position der Börsenglocke (Anker-Part der Stadt, sonst Börsensaal-Mitte aus Config.City)
local function bellPosition(): Vector3
	local anchor = workspace:FindFirstChild("Anchor_Bell", true)
	if anchor and anchor:IsA("BasePart") then
		return anchor.Position
	end
	local city = ctx.Config.City
	local zones = type(city) == "table" and city.Zones or nil
	local exchange = zones and zones.Exchange
	if exchange and typeof(exchange.Center) == "Vector3" then
		return exchange.Center + Vector3.new(0, 8, 0)
	end
	return Vector3.new(0, 8, -190)
end

local function nearBell(): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false
	end
	return (root.Position - bellPosition()).Magnitude <= 40
end

-- Kinoszene: Kamera fährt zur Glocke und zurück (überspringbar mit jeder Eingabe)
local function cinema(seconds: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local bell = bellPosition()
	local oldType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable
	local goal = CFrame.lookAt(bell + Vector3.new(14, 9, 26), bell)
	local tween = TweenService:Create(camera, CAMERA_IN, { CFrame = goal })
	tween:Play()
	local finished = false
	local connection: RBXScriptConnection? = nil
	local function restore()
		if finished then
			return
		end
		finished = true
		tween:Cancel()
		if connection then
			connection:Disconnect()
		end
		camera.CameraType = if oldType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else oldType
	end
	connection = UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		local kind = input.UserInputType
		if
			kind == Enum.UserInputType.MouseButton1
			or kind == Enum.UserInputType.Touch
			or kind == Enum.UserInputType.Keyboard
		then
			restore()
		end
	end)
	task.delay(seconds, restore)
end

-- "IpoCeremony" {Ticker, UserId, Name, Count, Stars, Crown}
local function onIpo(_strength: number, data: any)
	if type(data) ~= "table" or type(data.Ticker) ~= "string" then
		return
	end
	if data.UserId ~= player.UserId then
		-- Server-Banner für alle anderen (der Text ist das einzige Signal)
		UI.Toast(T("prog.ipoBanner", tostring(data.Name or "?"), data.Ticker), "Announce")
		return
	end
	if ceremonyBusy then
		return
	end
	ceremonyBusy = true
	local reduced = reducedFx()
	local root = layer()
	local shade: Frame = UI.Create("Frame", {
		Name = "IpoShade",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 61,
		Parent = root,
	})
	TweenService:Create(shade, FADE, { BackgroundTransparency = 0.45 }):Play()
	local bell: TextLabel = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.16),
		Size = UDim2.fromOffset(120, 120),
		Text = "🔔",
		MaxText = 96,
		ZIndex = 62,
		Parent = shade,
	})
	local tickerLabel: TextLabel = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.new(0.8, 0, 0, 120),
		Text = data.Ticker,
		Face = "Display",
		TextColor3 = Theme.Gold,
		MaxText = 110,
		MaxVisibleGraphemes = 0,
		ZIndex = 62,
		Parent = shade,
	})
	UI.TextStroke(1).Parent = tickerLabel
	UI.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.56),
		Size = UDim2.new(0.8, 0, 0, 34),
		Text = T("prog.ipoYou", data.Ticker),
		Face = "BodyBold",
		TextColor3 = Theme.Text,
		MaxText = 26,
		ZIndex = 62,
		Parent = shade,
	})
	local crown = if type(data.Crown) == "string" and data.Crown ~= "" then T("prog.crown." .. data.Crown) else ""
	UI.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.63),
		Size = UDim2.new(0.8, 0, 0, 28),
		Text = T("prog.lbl.ipoStars", math.floor(num(data.Stars, 0)))
			.. (if crown ~= "" then "  ·  " .. crown else ""),
		Face = "Mono",
		TextColor3 = Theme.Gold,
		MaxText = 22,
		ZIndex = 62,
		Parent = shade,
	})
	sfx("MarketBell")
	-- Glocke schwingt (4×), Ticker erscheint Buchstabe für Buchstabe
	local swings = if reduced then 1 else 4
	task.spawn(function()
		for i = 1, swings do
			local angle = if i % 2 == 1 then 18 else -18
			TweenService:Create(bell, TweenInfo.new(0.22, Enum.EasingStyle.Sine), { Rotation = angle }):Play()
			task.wait(0.24)
		end
		TweenService:Create(bell, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Rotation = 0 }):Play()
	end)
	task.spawn(function()
		for i = 1, #data.Ticker do
			tickerLabel.MaxVisibleGraphemes = i
			sfx("TickerTick")
			task.wait(if reduced then 0.05 else 0.22)
		end
		tickerLabel.MaxVisibleGraphemes = -1
	end)
	confetti(2)
	if not reduced and not nearBell() then
		cinema(4.5)
	end
	task.delay(if reduced then 3 else 6, function()
		TweenService:Create(shade, FADE, { BackgroundTransparency = 1 }):Play()
		for _, child in ipairs(shade:GetDescendants()) do
			if child:IsA("TextLabel") then
				TweenService:Create(child, FADE, { TextTransparency = 1 }):Play()
			end
		end
		task.delay(0.4, function()
			shade:Destroy()
			ceremonyBusy = false
		end)
	end)
end

-- ---------------------------------------------------------------------
-- 3) FENSTER "Prestige": Börsengang · Vorstand · Titel
-- ---------------------------------------------------------------------
local function newPage(key: string, order: number): Frame
	local page: Frame = UI.Create("Frame", {
		Name = "Page_" .. key,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Visible = false,
		Parent = window.Content,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
	})
	pages[key] = page
	return page
end

local function showTab(key: string)
	tab = key
	for name, page in pairs(pages) do
		page.Visible = name == key
	end
end

local function requestPreview()
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		local reply = ctx.RequestFull("ProgIpoPreview", {}, false)
		busy = false
		if reply.Ok then
			preview = reply
			previewAt = os.clock()
			if ui.Ticker and (ui.Ticker.Text == "" or ui.Ticker.Text == nil) and type(reply.Suggest) == "string" then
				ui.Ticker.Text = reply.Suggest
			end
		end
		Prestige.Refresh()
	end)
end

local function ring()
	local p = preview
	if busy or not p or not p.Eligible or os.clock() - previewAt > TOKEN_SECONDS then
		if p and os.clock() - previewAt > TOKEN_SECONDS then
			requestPreview()
		end
		return
	end
	local ticker = string.upper(ui.Ticker and ui.Ticker.Text or "")
	busy = true
	task.spawn(function()
		local reply = ctx.RequestFull("ProgIpo", { Ticker = ticker, Token = p.Token })
		busy = false
		if reply.Ok then
			preview = nil
			ui.Ticker.Text = ""
			ctx.Windows.Close("Prestige")
		end
		Prestige.Refresh()
	end)
end

local function buildIpoPage(page: Frame)
	ui.Stats = text(page, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, MaxText = 16, TextColor3 = Theme.Text2 })
	local card = UI.Card({ Size = UDim2.new(1, 0, 0, 176), LayoutOrder = 2, Parent = page })
	UI.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 10),
		Parent = card,
	})
	UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = card })
	ui.Lines = {}
	for i = 1, 5 do
		ui.Lines[i] = text(card, {
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = i,
			Face = if i == 1 then "Display" else "BodyBold",
			MaxText = if i == 1 then 20 else 16,
			TextColor3 = if i == 1 then Theme.Gold else Theme.Text,
		})
	end
	ui.Status = text(card, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 6, MaxText = 15 })
	UI.Section(page, T("prog.lbl.keeps"), 3, Theme.Up)
	text(page, {
		Size = UDim2.new(1, 0, 0, 54),
		LayoutOrder = 4,
		Text = T("prog.lbl.ipoKeeps"),
		TextWrapped = true,
		MaxText = 14,
		TextColor3 = Theme.Text2,
		Font = UI.Fonts.Body,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	UI.Section(page, T("prog.lbl.resets"), 5, Theme.Warn)
	text(page, {
		Size = UDim2.new(1, 0, 0, 36),
		LayoutOrder = 6,
		Text = T("prog.lbl.ipoResets"),
		TextWrapped = true,
		MaxText = 14,
		TextColor3 = Theme.Text2,
		Font = UI.Fonts.Body,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local row = UI.Row(page, 7, 46)
	ui.Ticker = UI.TextBox({
		Size = UDim2.new(0, 170, 1, 0),
		PlaceholderText = T("prog.lbl.ticker"),
		Text = "",
		Font = UI.Fonts.Main,
		Parent = row,
	})
	UI.Create("UITextSizeConstraint", { MaxTextSize = 22, Parent = ui.Ticker })
	ui.Ticker:GetPropertyChangedSignal("Text"):Connect(function()
		local raw = ui.Ticker.Text
		local clean = string.sub(string.gsub(string.upper(raw), "[^A-Z]", ""), 1, 4)
		if clean ~= raw then
			ui.Ticker.Text = clean
		end
	end)
	ui.PreviewButton = UI.Button({
		Size = UDim2.fromOffset(150, 44),
		Text = T("prog.btn.preview"),
		Variant = "Secondary",
		Parent = row,
	}, requestPreview)
	ui.RingButton = UI.Button({
		Size = UDim2.fromOffset(190, 44),
		Text = T("prog.btn.ring"),
		Variant = "Muted",
		Parent = row,
	}, ring)
	text(page, {
		Size = UDim2.new(1, 0, 0, 34),
		LayoutOrder = 8,
		Text = T("prog.perk.info"),
		TextWrapped = true,
		MaxText = 13,
		TextColor3 = Theme.Muted,
		Font = UI.Fonts.Body,
	})
end

local function buildBoardPage(page: Frame)
	ui.StarsLabel = text(page, { Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1, MaxText = 17, Face = "BodyBold" })
	ui.PerkRows = {}
	for i, def in ipairs(pcfg().Prestige and pcfg().Prestige.Perks or {}) do
		local card = UI.RowCard(page, 10 + i, 74)
		UI.Label({
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(1, -200, 0, 24),
			Text = T("prog.perk." .. def.Key),
			Face = "BodyBold",
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 18,
			Parent = card,
		})
		UI.Label({
			Position = UDim2.fromOffset(14, 34),
			Size = UDim2.new(1, -200, 0, 32),
			Text = T("prog.perk." .. def.Key .. ".d"),
			TextWrapped = true,
			Font = UI.Fonts.Body,
			TextColor3 = Theme.Text2,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 13,
			Parent = card,
		})
		local actions = UI.RowActions(card, 170)
		local level = UI.Label({
			Size = UDim2.fromOffset(80, 30),
			Text = "",
			Face = "Mono",
			TextColor3 = Theme.Gold,
			MaxText = 15,
			LayoutOrder = 1,
			Parent = actions,
		})
		local key = def.Key
		local button = UI.Button({
			Size = UDim2.fromOffset(76, 40),
			Text = "+ ★",
			Variant = "Premium",
			LayoutOrder = 2,
			Parent = actions,
		}, function()
			ctx.Request("ProgPerk", { Branch = key })
		end)
		ui.PerkRows[key] = { Level = level, Button = button, Max = def.Max }
	end
	local row = UI.Row(page, 50, 44)
	ui.RespecLabel = text(row, { Size = UDim2.new(1, -200, 1, 0), MaxText = 15, TextColor3 = Theme.Text2 })
	UI.Button(
		{ Size = UDim2.fromOffset(180, 42), Text = T("prog.btn.reset"), Variant = "Secondary", Parent = row },
		function()
			ctx.Request("ProgRespec", {})
		end
	)
end

local function buildTitlePage(page: Frame)
	ui.TitleList = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = page,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }) })
	ui.TitleSig = ""
end

local function rebuildTitles()
	local p = prog()
	local owned = type(p.Titles) == "table" and p.Titles or {}
	local sig = table.concat(owned, ",") .. "|" .. tostring(p.Title) .. "|" .. lang()
	if sig == ui.TitleSig then
		return
	end
	ui.TitleSig = sig
	for _, child in ipairs(ui.TitleList:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local list = { "" }
	for _, key in ipairs(owned) do
		table.insert(list, key)
	end
	for i, key in ipairs(list) do
		local card = UI.RowCard(ui.TitleList, i, 48)
		UI.Label({
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -150, 1, 0),
			Text = if key == "" then T("prog.lbl.titleNone") else titleName(key),
			Face = "BodyBold",
			TextColor3 = if key == "" then Theme.Muted else Theme.Gold,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 18,
			Parent = card,
		})
		local active = p.Title == key
		local actions = UI.RowActions(card, 130)
		UI.Button({
			Size = UDim2.fromOffset(120, 36),
			Text = if active then T("prog.btn.selected") else T("prog.btn.select"),
			Variant = if active then "Muted" else "Secondary",
			Parent = actions,
		}, function()
			if prog().Title ~= key then
				ctx.Request("ProgTitle", { Id = key })
			end
		end)
	end
end

function Prestige.Refresh()
	if not window then
		return
	end
	local p = prog()
	ui.Stats.Text = T("prog.lbl.ipos", math.floor(num(p.Ipos, 0)))
		.. "  ·  "
		.. T("prog.lbl.stars", math.floor(num(p.Stars, 0)), math.floor(num(p.StarsTotal, 0)))
		.. "  ·  "
		.. T("prog.lbl.firm", credits(num(p.Firm, 0)))
	local pv = preview
	if pv then
		ui.Lines[1].Text = T("prog.lbl.ipoStars", math.floor(num(pv.Stars, 0)))
		ui.Lines[2].Text = T("prog.lbl.ipoFirm", credits(num(pv.Firm, 0)))
		local permOk, permText = pcall(ctx.Format.Mult, num(pv.Perm, 0.25), lang())
		ui.Lines[3].Text = T(
			"prog.lbl.ipoPerm",
			if permOk then string.gsub(permText, "^x", "") else "0,25",
			math.floor(num(pv.Next, 1))
		)
		ui.Lines[4].Text = if type(pv.Crown) == "string" and pv.Crown ~= ""
			then T("prog.lbl.ipoCrown", T("prog.crown." .. pv.Crown))
			else ""
		ui.Lines[5].Text = T("prog.lbl.ipoEstimate", duration(num(pv.EstimateSeconds, 0)))
		local expired = os.clock() - previewAt > TOKEN_SECONDS
		if pv.Eligible and not expired then
			ui.Status.Text = T("prog.lbl.ipoReady")
			ui.Status.TextColor3 = Theme.Up
			ui.RingButton.SetVariant("Premium")
		else
			ui.Status.Text = if expired then T("prog.ipoToken") else tostring(pv.Reason or "")
			ui.Status.TextColor3 = if expired then Theme.Warn else Theme.Down
			ui.RingButton.SetVariant("Muted")
		end
	else
		for i, line in ipairs(ui.Lines) do
			line.Text = if i == 1 then T("prog.btn.preview") .. " …" else ""
		end
		ui.Status.Text = ""
		ui.RingButton.SetVariant("Muted")
	end
	-- Vorstand
	local free = math.floor(num(p.Stars, 0))
	ui.StarsLabel.Text = T("prog.lbl.stars", free, math.floor(num(p.StarsTotal, 0)))
	local perks = type(p.Perks) == "table" and p.Perks or {}
	for key, row in pairs(ui.PerkRows) do
		local level = math.floor(num(perks[key], 0))
		row.Level.Text = T("prog.lbl.perkLevel", level, row.Max)
		row.Button.SetVariant(if level < row.Max and free > 0 then "Premium" else "Muted")
	end
	ui.RespecLabel.Text = if p.RespecFree then T("prog.lbl.respecFree") else T("prog.lbl.respecCost")
	rebuildTitles()
end

local function buildWindow()
	window = UI.Window(T("prog.win.prestige"), WINDOW_W, WINDOW_H, Theme.Gold)
	segmented = UI.Segmented(window.Content, {
		{ Key = "ipo", Text = T("prog.tab.ipo") },
		{ Key = "board", Text = T("prog.tab.board") },
		{ Key = "titles", Text = T("prog.tab.titles") },
	}, function(key: string)
		showTab(key)
		if key == "ipo" and not preview then
			requestPreview()
		end
		Prestige.Refresh()
	end)
	segmented.Frame.LayoutOrder = 0
	buildIpoPage(newPage("ipo", 1))
	buildBoardPage(newPage("board", 2))
	buildTitlePage(newPage("titles", 3))
	showTab(tab)
end

local function openWindow()
	if not window then
		buildWindow()
	end
	segmented.Set(tab, true)
	showTab(tab)
	UI.OpenWindow(window)
	Prestige.Refresh()
	if tab == "ipo" and (not preview or os.clock() - previewAt > TOKEN_SECONDS) then
		requestPreview()
	end
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
end

function Prestige.OpenPreview()
	tab = "ipo"
	preview = nil
	ctx.Windows.Open("Prestige")
end

function Prestige.Tick()
	if window and window.IsOpen and tab == "ipo" and preview then
		Prestige.Refresh()
	end
end

function Prestige.Init(context: any)
	ctx = context
	local effects = ctx.Modules.Effects
	if effects and type(effects.Register) == "function" then
		effects.Register("IpoCeremony", onIpo)
		effects.Register("LicenceUp", onLicenceUp)
		effects.Register("TitleUp", onTitleUp)
		effects.Register("QuestDone", onQuestDone)
		effects.Register("Achievement", onAchievement)
	end
	ctx.Windows.Register("Prestige", openWindow, closeWindow)
end

function Prestige.Start()
	ctx.Hooks.On("State", function(_state: any, changed: any)
		if type(changed) == "table" and changed.Prog and window and window.IsOpen then
			Prestige.Refresh()
		end
	end)
	ctx.Hooks.On("Settings", function()
		if window then
			ui.TitleSig = ""
		end
	end)
end

return Prestige
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="149">
            <Properties>
              <string name="Name">Quality</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Grafikstufen mit Automatik (Client/Modules/Quality)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §C7.5, §C14.2 (Config.Quality), §C16 (Budgets), §D WP2.
--
--  Vier Stufen Low / Medium / High / Ultra (Config.Quality.Tiers). Einstellung "Quality":
--    "auto" -> Automatik aus der Bildrate (Main.client misst im einen PreRender-Loop -> ctx.Fps):
--              runter, wenn AutoFpsDown (35) DownSeconds (5) lang unterschritten; rauf, wenn AutoFpsUp (55)
--              UpSeconds (30) lang überschritten. Schutz gegen Pendeln: nach einem Herunterstufen 60 s kein Hochstufen,
--              eine Stufe, die schon MaxDownsPerTier-mal verlassen wurde, wählt die Automatik nicht wieder.
--              Fenster ohne Fokus und die ersten StartDelay Sekunden zählen nicht.
--    "Low" … "Ultra" -> feste Stufe (manuell).
--  Läuft man schon auf "Low" und bleibt Config.Client.AutoReducedFx (35 FPS, 5 s) unterschritten, schaltet das Modul
--  einmal "Reduzierte Effekte" ein (Hinweis-Toast, in den Einstellungen änderbar).
--  Clientseitig gesetzt: Lighting.GlobalShadows je Stufe (lokal, repliziert nicht).
--  Hook "Quality"(tier) bei jedem Wechsel (auch beim Start).
--
--  Öffentliche API (§C7.5):
--    Quality.Tier(): string                 "Low" | "Medium" | "High" | "Ultra"
--    Quality.Budget(key: string): number    Lights, Shadows (1/0), Traffic, Drones, Monitors, Candles, Particles,
--                                           InteriorRadius, AreaFill (1/0), DoF (1/0); unbekannt -> 0
--  Zusätzlich: Quality.IsAuto(): boolean, Quality.Fps(): number, Quality.Tick(), Quality.Init(ctx), Quality.Start()
-- =====================================================================

local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")

local Quality = {}

local ctx: any = nil
local cfg: any = {}
local order: { string } = { "Low", "Medium", "High", "Ultra" }
local tier = "High"
local auto = true
local startedAt = os.clock()
local focused = true
local lowFor = 0 -- Sekunden unter der Abstiegsschwelle
local highFor = 0 -- Sekunden über der Aufstiegsschwelle
local lastDownAt = -math.huge
local downsFrom: { [string]: number } = {}
local reducedFor = 0
local reducedDone = false

-- Rückfall-Budgets, falls Config.Quality fehlt (gleiche Werte wie DESIGN §C14.2)
local FALLBACK_TIERS: { [string]: { [string]: any } } = {
	Low = {
		Lights = 6,
		Shadows = false,
		Traffic = 0,
		Drones = 0,
		Monitors = 2,
		Candles = 60,
		Particles = 0.3,
		InteriorRadius = 0,
		AreaFill = false,
		DoF = false,
	},
	Medium = {
		Lights = 16,
		Shadows = true,
		Traffic = 10,
		Drones = 4,
		Monitors = 4,
		Candles = 90,
		Particles = 0.6,
		InteriorRadius = 1,
		AreaFill = false,
		DoF = false,
	},
	High = {
		Lights = 32,
		Shadows = true,
		Traffic = 20,
		Drones = 8,
		Monitors = 8,
		Candles = 120,
		Particles = 1,
		InteriorRadius = 2,
		AreaFill = true,
		DoF = true,
	},
	Ultra = {
		Lights = 64,
		Shadows = true,
		Traffic = 32,
		Drones = 14,
		Monitors = 12,
		Candles = 120,
		Particles = 1,
		InteriorRadius = 4,
		AreaFill = true,
		DoF = true,
	},
}

local function num(value: any, fallback: number): number
	if type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge then
		return value
	end
	return fallback
end

local function tiers(): { [string]: any }
	local t = cfg.Tiers
	if type(t) == "table" and next(t) ~= nil then
		return t
	end
	return FALLBACK_TIERS
end

local function indexOf(name: string): number
	return table.find(order, name) or 1
end

local function inputKind(): string
	local controls = ctx and ctx.Modules and ctx.Modules.Controls
	if controls and type(controls.Input) == "function" then
		local ok, kind = pcall(controls.Input)
		if ok and type(kind) == "string" then
			return kind
		end
	end
	return if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "Touch" else "KBM"
end

local function deviceTier(map: any, fallback: string): string
	local kind = inputKind()
	local value = type(map) == "table" and map[kind] or nil
	if type(value) == "string" and tiers()[value] then
		return value
	end
	return fallback
end

local function settings(): { [string]: any }
	local module = ctx and ctx.Modules and ctx.Modules.Settings
	if module and type(module.Get) == "function" then
		local ok, value = pcall(module.Get)
		if ok and type(value) == "table" then
			return value
		end
	end
	return {}
end

-- Lokale Engine-Einstellungen der Stufe (nur, was sonst niemand clientseitig besitzt)
local function applyEngine()
	local def = tiers()[tier]
	if type(def) ~= "table" then
		return
	end
	local shadows = def.Shadows == true
	if Lighting.GlobalShadows ~= shadows then
		Lighting.GlobalShadows = shadows
	end
end

local function setTier(name: string, force: boolean?)
	if not tiers()[name] then
		return
	end
	if name == tier and not force then
		return
	end
	if indexOf(name) < indexOf(tier) then
		lastDownAt = os.clock()
		downsFrom[tier] = (downsFrom[tier] or 0) + 1
	end
	tier = name
	lowFor, highFor = 0, 0
	applyEngine()
	if ctx and ctx.Hooks then
		ctx.Hooks.Fire("Quality", tier)
	end
end

-- Startstufe der Automatik: Roblox-Grafikregler des Spielers, sonst Gerät
local function autoStartTier(): string
	local maxTier = deviceTier(cfg.DeviceMax, "Ultra")
	local start = deviceTier(cfg.DeviceStart, "High")
	local ok, level = pcall(function()
		-- selene: allow(undefined_variable)
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel
	end)
	if ok and typeof(level) == "EnumItem" and level ~= Enum.SavedQualitySetting.Automatic then
		local value = (level :: EnumItem).Value -- 1..10
		if value <= 3 then
			start = "Low"
		elseif value <= 6 then
			start = "Medium"
		elseif value <= 8 then
			start = "High"
		else
			start = "Ultra"
		end
	end
	if indexOf(start) > indexOf(maxTier) then
		start = maxTier
	end
	return start
end

local function applySetting(force: boolean?)
	local choice = settings().Quality
	if type(choice) == "string" and choice ~= "auto" and tiers()[choice] then
		auto = false
		setTier(choice, force)
	else
		local wasAuto = auto
		auto = true
		if not wasAuto or force then
			-- zurück zur Automatik: frisch messen
			downsFrom = {}
			setTier(autoStartTier(), force)
		end
	end
end

function Quality.Tier(): string
	return tier
end

function Quality.IsAuto(): boolean
	return auto
end

function Quality.Fps(): number
	return num(ctx and ctx.Fps, 60)
end

function Quality.Budget(key: string): number
	local def = tiers()[tier]
	local value = if type(def) == "table" then def[key] else nil
	if type(value) == "boolean" then
		return if value then 1 else 0
	end
	return num(value, 0)
end

-- 1-s-Takt (TICK_MODULES): Automatik + Reduzierte Effekte
function Quality.Tick()
	if not focused or os.clock() - startedAt < num(cfg.StartDelay, 10) then
		lowFor, highFor, reducedFor = 0, 0, 0
		return
	end
	local fps = Quality.Fps()
	-- Reduzierte Effekte: schon auf der niedrigsten Stufe (oder manuell) und trotzdem zu langsam
	local client = ctx and ctx.Config and ctx.Config.Client
	local reducedCfg = client and client.AutoReducedFx or {}
	if not reducedDone then
		local atFloor = tier == order[1] or not auto
		if atFloor and fps < num(reducedCfg.Fps, 35) and settings().ReducedFx ~= true then
			reducedFor += 1
			if reducedFor >= num(reducedCfg.Seconds, 5) then
				reducedDone = true
				local module = ctx.Modules and ctx.Modules.Settings
				if module and type(module.Set) == "function" then
					pcall(module.Set, "ReducedFx", true)
				end
				if type(ctx.Toast) == "function" then
					ctx.Toast(ctx.T("ui.autoReduced"), "Info")
				end
			end
		else
			reducedFor = 0
		end
	end
	if not auto then
		return
	end
	local index = indexOf(tier)
	if fps < num(cfg.AutoFpsDown, 35) then
		lowFor += 1
		highFor = 0
		if lowFor >= num(cfg.DownSeconds, 5) and index > 1 then
			setTier(order[index - 1])
		end
	elseif fps > num(cfg.AutoFpsUp, 55) then
		highFor += 1
		lowFor = 0
		local maxIndex = indexOf(deviceTier(cfg.DeviceMax, "Ultra"))
		local nextName = order[index + 1]
		local blocked = os.clock() - lastDownAt < num(cfg.UpBlockAfterDown, 60)
			or (nextName ~= nil and (downsFrom[nextName] or 0) >= num(cfg.MaxDownsPerTier, 2))
		if highFor >= num(cfg.UpSeconds, 30) and nextName and index < maxIndex and not blocked then
			setTier(nextName)
		end
	else
		lowFor, highFor = 0, 0
	end
end

function Quality.Init(context: any)
	ctx = context
	local config = ctx.Config
	cfg = if config and type(config.Quality) == "table" then config.Quality else {}
	if type(cfg.Order) == "table" and #cfg.Order > 0 then
		order = cfg.Order
	end
	-- schon im Init eine sinnvolle Stufe (andere Module lesen Quality.Tier() evtl. vor Start); Hook erst in Start
	tier = autoStartTier()
	ctx.Hooks.On("Settings", function()
		applySetting(false)
	end)
	UserInputService.WindowFocused:Connect(function()
		focused = true
		lowFor, highFor, reducedFor = 0, 0, 0
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		focused = false
	end)
end

function Quality.Start()
	startedAt = os.clock()
	applySetting(true)
end

return Quality
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">Quests</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Quests, Starter-Linie, Login-Kalender, Codes, Erfolge, Firmen-Album (Client/Modules/Quests)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §B9.7 (3 Tages- + 3 Wochenquests,
--  1 Gratis-Neuwürfeln je Tag mit offener Anzeige, Starter-Linie „Vom Azubi zum Millionär“, Aufhol-Quest), §B9.8
--  (60 Erfolge, Firmen-Album 43 Karten + IPO-Seite), §B9.9 (Login-Kalender deterministisch – nie Rad, 28er-Spur,
--  Serien-Schutz, kein bezahlter Retter), §C7.3 (Fenster "Quests").
--
--  Öffentliche API: keine Pflicht-API. Zusätzlich: Quests.Init(ctx), Quests.Start(), Quests.Tick() (1 s: Countdowns,
--  HUD-Badge), Quests.Open(tab?), Quests.Claimable(): number (abholbare Belohnungen, für HUD/Tutorial).
--  Anfragen: RewardQuest { Id }, RewardReroll { Id }, RewardLogin {}, RewardCode { Code }.  State: Quests, Login, Prog.
--  Belohnungen sind Spielgeld/Kosmetik (CR, Deko, Lack, Saison-XP) – nie Robux, nie Zufall.
-- =====================================================================

local UI = require(script.Parent:WaitForChild("UI"))

local Quests = {}

local Theme = UI.Theme

local WINDOW_W, WINDOW_H = 680, 620
local CODE_MAX = 20

local ctx: any = nil
local window: any = nil
local segmented: any = nil
local tab = "daily"
local pages: { [string]: Frame } = {}
local ui: { [string]: any } = {}
local badge: Frame? = nil
local busy = false
local sigs: { [string]: string } = {}
local swapArmed: { Id: string, At: number }? = nil -- erster Tipp auf ↻ zeigt den Ersatz, der zweite tauscht
local SWAP_CONFIRM = 6

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

local function stateOf(key: string): { [string]: any }
	local s = ctx.State[key]
	return if type(s) == "table" then s else {}
end

local function pcfg(): any
	local p = ctx.Config.Progression
	return if type(p) == "table" then p else {}
end

local function fmt(fnName: string, ...: any): string
	local fn = ctx.Format[fnName]
	if type(fn) ~= "function" then
		return tostring((...))
	end
	local ok, value = pcall(fn, ...)
	return if ok then value else tostring((...))
end

local function now(): number
	local ok, value = pcall(ctx.Clock.Now)
	return if ok and type(value) == "number" then value else os.time()
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	props.Parent = parent
	if props.TextXAlignment == nil then
		props.TextXAlignment = Enum.TextXAlignment.Left
	end
	return UI.Label(props)
end

local function clear(frame: Instance)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function listFrame(parent: Instance, order: number): Frame
	return UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }) })
end

local function newPage(key: string, order: number): Frame
	local page: Frame = UI.Create("Frame", {
		Name = "Page_" .. key,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Visible = false,
		Parent = window.Content,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }) })
	pages[key] = page
	return page
end

local function showTab(key: string)
	tab = key
	for name, page in pairs(pages) do
		page.Visible = name == key
	end
end

-- Anzeigename eines Belohnungs-Teils aus den Config-Tabellen der Besitzer-WPs (wie RewardService)
local function itemName(kind: string, key: string): string
	local config = ctx.Config
	local function pick(entry: any): string?
		if type(entry) == "table" and type(entry.Name) == "table" then
			return ctx.Lang.Pick(lang(), entry.Name)
		end
		return nil
	end
	local function find(list: any): any
		if type(list) == "table" then
			for _, entry in ipairs(list) do
				if type(entry) == "table" and entry.Key == key then
					return entry
				end
			end
		end
		return nil
	end
	if kind == "Decor" then
		local decor = config.Decor
		return pick(decor and decor.ByKey and decor.ByKey[key]) or key
	elseif kind == "Car" then
		return pick(find(config.Vehicles and config.Vehicles.Cars)) or key
	elseif kind == "Watch" then
		return pick(find(config.Lifestyle and config.Lifestyle.Watches)) or key
	elseif kind == "Accessory" then
		return pick(find(config.Lifestyle and config.Lifestyle.Accessories)) or key
	elseif kind == "Title" then
		return pick(pcfg().TitleByKey and pcfg().TitleByKey[key]) or key
	end
	local tower = config.Tower
	return pick(find(tower and tower.Skins))
		or pick(find(tower and tower.Neon))
		or pick(find(config.Vehicles and config.Vehicles.Paints))
		or key
end

-- Belohnung (Config-Format) -> lesbarer Text; Einkommens-CR als „n min Einkommen“ (Betrag rechnet der Server)
function Quests.DescribeReward(reward: any): string
	if type(reward) ~= "table" then
		return ""
	end
	local parts: { string } = {}
	if type(reward.Credits) == "table" then
		table.insert(parts, T("prog.rw.income", math.floor(num(reward.Credits.Minutes, 0))))
	elseif type(reward.Credits) == "number" then
		table.insert(parts, T("prog.rw.credits", fmt("Credits", reward.Credits, lang())))
	end
	if type(reward.Decor) == "table" then
		for key in pairs(reward.Decor) do
			if type(key) == "string" then
				table.insert(parts, T("prog.rw.decor", itemName("Decor", key)))
			end
		end
	end
	for _, entry in ipairs({
		{ "Cosmetics", "Cosmetic", "prog.rw.cosmetic" },
		{ "Watches", "Watch", "prog.rw.watch" },
		{ "Cars", "Car", "prog.rw.car" },
		{ "Accessories", "Accessory", "prog.rw.accessory" },
	}) do
		local list = reward[entry[1]]
		if type(list) == "table" then
			for _, key in ipairs(list) do
				if type(key) == "string" then
					table.insert(parts, T(entry[3], itemName(entry[2], key)))
				end
			end
		end
	end
	if num(reward.BoostX2, 0) > 0 then
		table.insert(parts, T("prog.rw.boost", fmt("Duration", reward.BoostX2, lang())))
	end
	if num(reward.InstantTokens, 0) > 0 then
		table.insert(parts, T("prog.rw.instant", math.floor(reward.InstantTokens)))
	end
	if num(reward.SeasonXp, 0) > 0 then
		table.insert(parts, T("prog.rw.seasonXp", math.floor(reward.SeasonXp)))
	end
	if type(reward.Title) == "string" and reward.Title ~= "" then
		table.insert(parts, T("prog.rw.title", itemName("Title", reward.Title)))
	end
	return table.concat(parts, T("prog.rw.sep"))
end

-- Fortschritt lesbar: Fahr-Ziele in km, sonst ganze Zahlen
local function progressText(kind: string?, p: number, goal: number): string
	if kind == "Drive" then
		local function km(v: number): string
			local value = string.format("%.1f", math.floor(v / 100 + 0.5) / 10)
			return if lang() == "de" then (string.gsub(value, "%.", ",")) else value
		end
		return T("prog.lbl.progress", km(p), km(goal)) .. " km"
	end
	return T("prog.lbl.progress", fmt("Int", math.floor(p), lang()), fmt("Int", math.floor(goal), lang()))
end

-- Abholbare Belohnungen (HUD-Badge)
function Quests.Claimable(): number
	local quests = stateOf("Quests")
	local count = 0
	for _, listKey in ipairs({ "Daily", "Weekly" }) do
		local list = quests[listKey]
		if type(list) == "table" then
			for _, q in ipairs(list) do
				if type(q) == "table" and q.Done and not q.Claimed then
					count += 1
				end
			end
		end
	end
	if type(quests.Starter) == "table" and quests.Starter.Done then
		count += 1
	end
	if type(quests.Comeback) == "table" and quests.Comeback.Done and not quests.Comeback.Claimed then
		count += 1
	end
	if stateOf("Login").Claimable == true then
		count += 1
	end
	return count
end

-- Belohnung sofort spürbar (Toast allein ist stumm): Klang + kleines Konfetti, Wochen-/Starter-Abschluss etwas größer
local function rewardFx(big: boolean)
	call("Sfx", "Play", if big then "Achievement" else "Profit")
	call("Effects", "Confetti", if big then 0.8 else 0.3)
end

local function claim(id: string)
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		local reply = ctx.RequestFull("RewardQuest", { Id = id })
		busy = false
		if reply.Ok then
			rewardFx(string.sub(id, 1, 1) ~= "D")
		end
	end)
end

local function reroll(id: string)
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		ctx.RequestFull("RewardReroll", { Id = id })
		busy = false
	end)
end

-- ---------------------------------------------------------------------
-- 2) QUEST-KARTE (Tages-/Wochen-/Aufhol-Quest)
-- ---------------------------------------------------------------------
local function questCard(parent: Instance, order: number, q: { [string]: any }, allowReroll: boolean, kicker: string?)
	local card = UI.RowCard(parent, order, 92)
	local done = q.Done == true
	local claimed = q.Claimed == true
	if kicker then
		UI.Label({
			Position = UDim2.fromOffset(14, 4),
			Size = UDim2.new(1, -200, 0, 16),
			Text = UI.Upper(kicker),
			TextColor3 = Theme.Warn,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 12,
			Parent = card,
		})
	end
	UI.Label({
		Position = UDim2.fromOffset(14, if kicker then 20 else 8),
		Size = UDim2.new(1, -200, 0, 24),
		Text = tostring(q.Text or ""),
		Face = "BodyBold",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = if claimed then Theme.Muted else Theme.Text,
		MaxText = 16,
		Parent = card,
	})
	local goal = math.max(1, num(q.Goal, 1))
	local p = math.min(num(q.P, 0), goal)
	local bar = UI.Bar({
		Position = UDim2.fromOffset(14, 48),
		Size = UDim2.new(1, -200, 0, 16),
		Color = if done then Theme.Up else Theme.Accent,
		MaxText = 12,
		Parent = card,
	})
	UI.SetBar(bar, p / goal, progressText(q.Kind, p, goal))
	local xp = math.floor(num(q.Xp, 0))
	local credits = fmt("Credits", num(q.Credits, 0), lang())
	UI.Label({
		Position = UDim2.fromOffset(14, 68),
		Size = UDim2.new(1, -200, 0, 18),
		Text = if xp > 0
			then T("prog.lbl.rewardXp", credits, math.floor(num(q.SeasonXp, 0)), xp)
			else T("prog.lbl.reward", credits, math.floor(num(q.SeasonXp, 0))),
		Face = "Mono",
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 13,
		Parent = card,
	})
	local actions = UI.RowActions(card, 180)
	local id = tostring(q.Id)
	if allowReroll and not done and not claimed then
		local swapButton: any = nil
		swapButton = UI.Button({
			Size = UDim2.fromOffset(44, 40),
			Text = "↻",
			Variant = "Ghost",
			LayoutOrder = 1,
			Parent = actions,
		}, function()
			-- offen statt Überraschung: erst den festen Ersatz zeigen, dann bestätigen
			local armed = swapArmed
			if armed and armed.Id == id and os.clock() - armed.At <= SWAP_CONFIRM then
				swapArmed = nil
				reroll(id)
				return
			end
			if type(q.Swap) ~= "string" then
				UI.Toast(T("prog.rerollNone"), "Info")
				return
			end
			local mine = { Id = id, At = os.clock() }
			swapArmed = mine
			UI.Toast(T("prog.rerollPreview", q.Swap), "Info")
			if swapButton then
				swapButton.SetText("✓")
				swapButton.SetVariant("Success")
			end
			task.delay(SWAP_CONFIRM, function()
				if swapArmed == mine then
					swapArmed = nil
				end
				if swapButton and swapButton.Frame.Parent and swapArmed == nil then
					swapButton.SetText("↻")
					swapButton.SetVariant("Ghost")
				end
			end)
		end)
	end
	UI.Button({
		Size = UDim2.fromOffset(120, 40),
		Text = if claimed then T("prog.btn.claimed") elseif done then T("prog.btn.claim") else T("prog.btn.locked"),
		Variant = if claimed then "Muted" elseif done then "Success" else "Secondary",
		LayoutOrder = 2,
		Parent = actions,
	}, function()
		if done and not claimed then
			claim(id)
		end
	end)
end

-- ---------------------------------------------------------------------
-- 3) SEITEN: Heute · Woche · Starter
-- ---------------------------------------------------------------------
local function buildDaily(page: Frame)
	ui.DayTimer = text(page, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, Face = "Mono", MaxText = 15 })
	ui.RerollHint =
		text(page, { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 2, MaxText = 13, TextColor3 = Theme.Muted })
	ui.DailyList = listFrame(page, 3)
end

-- Signatur einer Quest-Karte (alle Teile als Text: fehlende Felder dürfen table.concat nicht abbrechen)
local function questSig(q: any): string
	if type(q) ~= "table" then
		return "?"
	end
	return table.concat({
		tostring(q.Id),
		tostring(q.P),
		tostring(q.Done),
		tostring(q.Claimed),
		tostring(q.Credits),
		tostring(q.Text),
		tostring(q.Swap),
	}, ":")
end

local function refreshDaily()
	local quests = stateOf("Quests")
	ui.DayTimer.Text = T("prog.lbl.resetIn", fmt("Duration", num(quests.DayEndsAt, 0) - now(), lang()))
	ui.RerollHint.Text = if quests.Rerolled then "" else T("prog.lbl.rerollHint")
	local parts = { lang(), tostring(quests.Rerolled) }
	local daily = type(quests.Daily) == "table" and quests.Daily or {}
	for _, q in ipairs(daily) do
		table.insert(parts, questSig(q))
	end
	local comeback = quests.Comeback
	if type(comeback) == "table" then
		table.insert(parts, "C" .. questSig(comeback))
	end
	local sig = table.concat(parts, "|")
	if sigs.Daily == sig then
		return
	end
	sigs.Daily = sig
	clear(ui.DailyList)
	local order = 0
	if type(comeback) == "table" then
		order += 1
		questCard(ui.DailyList, order, comeback, false, T("prog.lbl.comeback"))
	end
	for _, q in ipairs(daily) do
		order += 1
		questCard(ui.DailyList, order, q, not quests.Rerolled, nil)
	end
end

local function buildWeekly(page: Frame)
	ui.WeekTimer = text(page, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, Face = "Mono", MaxText = 15 })
	ui.WeeklyList = listFrame(page, 2)
end

local function refreshWeekly()
	local quests = stateOf("Quests")
	ui.WeekTimer.Text = T("prog.lbl.weekIn", fmt("Duration", num(quests.WeekEndsAt, 0) - now(), lang()))
	local weekly = type(quests.Weekly) == "table" and quests.Weekly or {}
	local parts = { lang() }
	for _, q in ipairs(weekly) do
		table.insert(parts, questSig(q))
	end
	local sig = table.concat(parts, "|")
	if sigs.Weekly == sig then
		return
	end
	sigs.Weekly = sig
	clear(ui.WeeklyList)
	for i, q in ipairs(weekly) do
		questCard(ui.WeeklyList, i, q, false, nil)
	end
end

local function buildStarter(page: Frame)
	ui.StarterTitle = text(page, {
		Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = 1,
		Face = "Display",
		MaxText = 18,
		TextColor3 = Theme.Gold,
	})
	ui.StarterStep = text(page, { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 2, Face = "Mono", MaxText = 14 })
	local card = UI.Card({ Size = UDim2.new(1, 0, 0, 170), LayoutOrder = 3, Parent = page })
	ui.StarterCard = card
	ui.StarterText = UI.Label({
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -32, 0, 28),
		Text = "",
		Face = "BodyBold",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 19,
		Parent = card,
	})
	ui.StarterTiko = UI.Label({
		Position = UDim2.fromOffset(16, 42),
		Size = UDim2.new(1, -32, 0, 22),
		Text = "",
		Face = "Body",
		TextColor3 = Theme.Cyan,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 15,
		Parent = card,
	})
	ui.StarterBar = UI.Bar({
		Position = UDim2.fromOffset(16, 74),
		Size = UDim2.new(1, -32, 0, 20),
		Color = Theme.Gold,
		Parent = card,
	})
	ui.StarterReward = UI.Label({
		Position = UDim2.fromOffset(16, 102),
		Size = UDim2.new(1, -200, 0, 22),
		Text = "",
		Face = "Mono",
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 14,
		Parent = card,
	})
	ui.StarterButton = UI.Button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -12),
		Size = UDim2.fromOffset(160, 44),
		Text = T("prog.btn.claim"),
		Variant = "Success",
		Parent = card,
	}, function()
		local quests = stateOf("Quests")
		local starter = quests.Starter
		if type(starter) == "table" and starter.Done then
			claim(tostring(starter.Id))
		end
	end)
	ui.StarterAll = text(page, {
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 4,
		MaxText = 15,
		TextColor3 = Theme.Up,
		Visible = false,
	})
end

local function refreshStarter()
	local quests = stateOf("Quests")
	local starter = quests.Starter
	ui.StarterTitle.Text = T("prog.starterTitle")
	if type(starter) ~= "table" then
		ui.StarterCard.Visible = false
		ui.StarterStep.Text = ""
		ui.StarterAll.Visible = true
		ui.StarterAll.Text = T("prog.starterAll")
		return
	end
	ui.StarterCard.Visible = true
	ui.StarterAll.Visible = false
	local id = tostring(starter.Id)
	ui.StarterStep.Text =
		T("prog.lbl.starterStep", math.floor(num(starter.Index, 1)), math.floor(num(starter.Total, 20)))
	local goal = math.max(1, num(starter.Goal, 1))
	local goalText = if starter.Kind == "Drive"
		then fmt("Int", math.floor(goal / 1000 + 0.5), lang())
		else fmt("Int", goal, lang())
	ui.StarterText.Text = T("prog.st." .. id, goalText)
	ui.StarterTiko.Text = "Tiko: " .. T("prog.st." .. id .. ".tiko")
	local p = math.min(num(starter.P, 0), goal)
	UI.SetBar(ui.StarterBar, p / goal, progressText(starter.Kind, p, goal))
	local reward = T("prog.rw.credits", fmt("Credits", num(starter.Credits, 0), lang()))
	if type(starter.Title) == "string" and starter.Title ~= "" then
		reward ..= T("prog.rw.sep") .. T("prog.rw.title", itemName("Title", starter.Title))
	end
	ui.StarterReward.Text = reward
	ui.StarterButton.SetText(if starter.Done then T("prog.btn.claim") else T("prog.btn.locked"))
	ui.StarterButton.SetVariant(if starter.Done then "Success" else "Muted")
end

-- ---------------------------------------------------------------------
-- 4) LOGIN-KALENDER + CODES
-- ---------------------------------------------------------------------
local function buildLogin(page: Frame)
	ui.LoginInfo =
		text(page, { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1, MaxText = 13, TextColor3 = Theme.Muted })
	local stats = UI.Row(page, 2, 26)
	ui.LoginStreak = text(stats, { Size = UDim2.new(0.25, -6, 1, 0), Face = "Mono", MaxText = 14, LayoutOrder = 1 })
	ui.LoginBest = text(stats, { Size = UDim2.new(0.25, -6, 1, 0), Face = "Mono", MaxText = 14, LayoutOrder = 2 })
	ui.LoginFreeze = text(stats, { Size = UDim2.new(0.25, -6, 1, 0), Face = "Mono", MaxText = 14, LayoutOrder = 3 })
	ui.LoginTrack = text(stats, { Size = UDim2.new(0.25, -6, 1, 0), Face = "Mono", MaxText = 14, LayoutOrder = 4 })
	local grid = UI.Grid(page, 3, 86, 110)
	ui.LoginTiles = {}
	local cycle = ctx.Config.Rewards and ctx.Config.Rewards.Login and ctx.Config.Rewards.Login.Cycle or {}
	for i, reward in ipairs(cycle) do
		local tile = UI.Card({ LayoutOrder = i, Parent = grid })
		local day = UI.Label({
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.new(1, -12, 0, 20),
			Text = T("prog.lbl.day", i),
			Face = "Display",
			MaxText = 14,
			Parent = tile,
		})
		local body = UI.Label({
			Position = UDim2.fromOffset(6, 30),
			Size = UDim2.new(1, -12, 1, -36),
			Text = "",
			Face = "Body",
			TextWrapped = true,
			TextColor3 = Theme.Text2,
			TextYAlignment = Enum.TextYAlignment.Top,
			MaxText = 12,
			Parent = tile,
		})
		local stroke = tile:FindFirstChildOfClass("UIStroke")
		ui.LoginTiles[i] = { Tile = tile, Day = day, Body = body, Stroke = stroke, Reward = reward }
	end
	ui.LoginTrackInfo = text(page, {
		Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = 4,
		Face = "Body",
		TextWrapped = true,
		MaxText = 13,
		TextColor3 = Theme.Text2,
	})
	ui.LoginReset =
		text(page, { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 5, MaxText = 13, TextColor3 = Theme.Warn })
	local row = UI.Row(page, 6, 46)
	ui.LoginButton = UI.Button({
		Size = UDim2.fromOffset(220, 44),
		Text = T("prog.btn.claim"),
		Variant = "Success",
		Parent = row,
	}, function()
		if busy or stateOf("Login").Claimable ~= true then
			return
		end
		busy = true
		task.spawn(function()
			local reply = ctx.RequestFull("RewardLogin", {})
			busy = false
			if reply.Ok then
				rewardFx(math.floor(num(reply.Day, 1)) >= 7)
			end
		end)
	end)
	ui.LoginNext = text(row, { Size = UDim2.new(1, -240, 1, 0), Face = "Mono", MaxText = 14, TextColor3 = Theme.Text2 })
	UI.Section(page, T("prog.btn.redeem"), 7, Theme.Purple)
	local codeRow = UI.Row(page, 8, 46)
	ui.Code = UI.TextBox({
		Size = UDim2.new(1, -170, 1, 0),
		PlaceholderText = T("prog.lbl.codePlaceholder"),
		Text = "",
		Parent = codeRow,
	})
	ui.Code:GetPropertyChangedSignal("Text"):Connect(function()
		local raw = ui.Code.Text
		local clean = string.sub(string.gsub(raw, "[^%w_]", ""), 1, CODE_MAX)
		if clean ~= raw then
			ui.Code.Text = clean
		end
	end)
	UI.Button({
		Size = UDim2.fromOffset(150, 44),
		Text = T("prog.btn.redeem"),
		Variant = "Primary",
		Parent = codeRow,
	}, function()
		local code = ui.Code.Text
		if busy or #code < 1 then
			return
		end
		busy = true
		task.spawn(function()
			local reply = ctx.RequestFull("RewardCode", { Code = code })
			busy = false
			if reply.Ok then
				ui.Code.Text = ""
				rewardFx(false)
			end
		end)
	end)
end

local function refreshLogin()
	local login = stateOf("Login")
	local rewards = ctx.Config.Rewards and ctx.Config.Rewards.Login or {}
	ui.LoginInfo.Text = T("prog.loginInfo")
	ui.LoginStreak.Text = T("prog.lbl.streak", math.floor(num(login.Streak, 0)))
	ui.LoginBest.Text = T("prog.lbl.best", math.floor(num(login.Best, 0)))
	ui.LoginFreeze.Text = T("prog.lbl.freeze", math.floor(num(login.Freeze, 0)))
	ui.LoginTrack.Text = T("prog.lbl.track", math.floor(num(login.Track, 0)))
	local nextDay = math.floor(num(login.NextDay, 1))
	local cycle = math.floor(num(login.NextCycle, 1))
	local claimable = login.Claimable == true
	for i, tile in ipairs(ui.LoginTiles) do
		local reward = tile.Reward
		if i == #ui.LoginTiles and cycle >= 2 and type(reward.Repeat) == "table" then
			reward = reward.Repeat
		end
		tile.Body.Text = Quests.DescribeReward(reward)
		local isNext = i == nextDay
		local past = i < nextDay
		tile.Day.Text = if isNext and claimable then T("prog.lbl.today") else T("prog.lbl.day", i)
		tile.Day.TextColor3 = if isNext then Theme.Up elseif past then Theme.Muted else Theme.Text
		if tile.Stroke then
			tile.Stroke.Color = if isNext then Theme.Up else Theme.Border
			tile.Stroke.Thickness = if isNext then 2 else 1
		end
		tile.Tile.BackgroundTransparency = if past then 0.4 else 0
	end
	local track = {}
	for _, milestone in ipairs(rewards.Track or {}) do
		table.insert(track, T("prog.lbl.day", milestone.Day) .. ": " .. Quests.DescribeReward(milestone))
	end
	ui.LoginTrackInfo.Text = table.concat(track, "  ·  ")
	ui.LoginReset.Text = if login.WillReset then T("prog.loginWillReset") else ""
	ui.LoginButton.SetText(if claimable then T("prog.btn.claim") else T("prog.btn.claimed"))
	ui.LoginButton.SetVariant(if claimable then "Success" else "Muted")
	ui.LoginNext.Text = if claimable
		then ""
		else T("prog.lbl.resetIn", fmt("Duration", num(login.NextAt, 0) - now(), lang()))
end

-- ---------------------------------------------------------------------
-- 5) ERFOLGE (60, 6 Kategorien) + FIRMEN-ALBUM
-- ---------------------------------------------------------------------
local function buildAchievements(page: Frame)
	ui.AchCount = text(page, { Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1, Face = "BodyBold", MaxText = 16 })
	ui.AchRows = {}
	local order = 1
	local cats = pcfg().AchievementCats or {}
	for _, cat in ipairs(cats) do
		order += 1
		UI.Section(page, T("prog.achCat." .. cat), order, Theme.Gold)
		for _, def in ipairs(pcfg().Achievements or {}) do
			if def.Cat == cat then
				order += 1
				local card = UI.RowCard(page, order, 58)
				local mark = UI.Label({
					Position = UDim2.fromOffset(10, 0),
					Size = UDim2.fromOffset(30, 58),
					Text = "○",
					TextColor3 = Theme.Muted,
					MaxText = 22,
					Parent = card,
				})
				local name = UI.Label({
					Position = UDim2.fromOffset(46, 6),
					Size = UDim2.new(1, -200, 0, 24),
					Text = ctx.Lang.Pick(lang(), def.Name),
					Face = "BodyBold",
					TextXAlignment = Enum.TextXAlignment.Left,
					MaxText = 16,
					Parent = card,
				})
				local goalText = fmt("Int", def.Goal, lang())
				local desc = UI.Label({
					Position = UDim2.fromOffset(46, 30),
					Size = UDim2.new(1, -200, 0, 20),
					Text = T("prog.ach.stat." .. def.Stat, goalText),
					Face = "Body",
					TextColor3 = Theme.Text2,
					TextXAlignment = Enum.TextXAlignment.Left,
					MaxText = 13,
					Parent = card,
				})
				local bar = UI.Bar({
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -12, 0.5, 0),
					Size = UDim2.fromOffset(140, 18),
					Color = Theme.Gold,
					MaxText = 12,
					Parent = card,
				})
				ui.AchRows[def.Id] = { Def = def, Mark = mark, Name = name, Desc = desc, Bar = bar }
			end
		end
	end
end

local function refreshAchievements()
	local p = stateOf("Prog")
	local done = type(p.Ach) == "table" and p.Ach or {}
	local stats = type(p.AchProgress) == "table" and p.AchProgress or {}
	local total, count = 0, 0
	for id, row in pairs(ui.AchRows) do
		total += 1
		local def = row.Def
		local isDone = done[id] ~= nil and done[id] ~= false
		if isDone then
			count += 1
		end
		local goal = math.max(1, num(def.Goal, 1))
		local value = math.min(num(stats[def.Stat], 0), goal)
		row.Mark.Text = if isDone then "✓" else "○"
		row.Mark.TextColor3 = if isDone then Theme.Gold else Theme.Muted
		row.Name.TextColor3 = if isDone then Theme.Gold else Theme.Text
		row.Name.Text = ctx.Lang.Pick(lang(), def.Name)
		row.Desc.Text = T("prog.ach.stat." .. def.Stat, fmt("Int", goal, lang()))
		UI.SetBar(
			row.Bar,
			if isDone then 1 else value / goal,
			if isDone then "✓" else fmt("Int", math.floor(value), lang()) .. " / " .. fmt("Int", goal, lang())
		)
	end
	ui.AchCount.Text = T("prog.lbl.achCount", count, total)
end

local function buildAlbum(page: Frame)
	ui.AlbumCount = text(page, { Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1, Face = "BodyBold", MaxText = 16 })
	ui.AlbumTiles = {}
	local companies = ctx.Config.Companies or {}
	local byId = companies.ById or {}
	local sectors = companies.Sectors or {}
	local cards = pcfg().Album and pcfg().Album.Cards or {}
	local order = 1
	local placed: { [number]: boolean } = {}
	local function addSection(title: string, color: Color3, ids: { number })
		if #ids == 0 then
			return
		end
		order += 1
		UI.Section(page, title, order, color)
		order += 1
		local grid = UI.Grid(page, order, 92, 54)
		for i, id in ipairs(ids) do
			placed[id] = true
			local inst = byId[id]
			local tile = UI.Card({ LayoutOrder = i, Parent = grid })
			local ticker = UI.Label({
				Position = UDim2.fromOffset(6, 6),
				Size = UDim2.new(1, -12, 0, 22),
				Text = if type(inst) == "table" then tostring(inst.Ticker) else tostring(id),
				Face = "MonoBold",
				MaxText = 16,
				Parent = tile,
			})
			local name = UI.Label({
				Position = UDim2.fromOffset(6, 30),
				Size = UDim2.new(1, -12, 0, 16),
				Text = if type(inst) == "table" and type(inst.Name) == "string" then inst.Name else "",
				TextColor3 = Theme.Muted,
				MaxText = 11,
				Parent = tile,
			})
			ui.AlbumTiles[id] = { Tile = tile, Ticker = ticker, Name = name, Color = color }
		end
	end
	for _, sector in ipairs(sectors) do
		local ids: { number } = {}
		for _, id in ipairs(cards) do
			local inst = byId[id]
			if type(inst) == "table" and inst.Sector == sector.Key then
				table.insert(ids, id)
			end
		end
		addSection(ctx.Lang.Pick(lang(), sector.Name), sector.Color or Theme.Accent, ids)
	end
	local rest: { number } = {}
	for _, id in ipairs(cards) do
		if not placed[id] then
			table.insert(rest, id)
		end
	end
	addSection("ETF", Theme.Cyan, rest)
	order += 1
	UI.Section(page, T("prog.lbl.albumIpo"), order, Theme.Gold)
	order += 1
	ui.AlbumIpo = text(page, {
		Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = order,
		Face = "Mono",
		TextWrapped = true,
		MaxText = 14,
		TextColor3 = Theme.Gold,
	})
end

local function refreshAlbum()
	local p = stateOf("Prog")
	local album = type(p.Album) == "table" and p.Album or {}
	local cfgAlbum = pcfg().Album or {}
	local owned = 0
	local total = 0
	for id, tile in pairs(ui.AlbumTiles) do
		total += 1
		local has = album[tostring(id)] == true
		if has then
			owned += 1
		end
		tile.Tile.BackgroundColor3 = if has then tile.Color else Theme.Surface2
		tile.Tile.BackgroundTransparency = if has then 0.55 else 0
		tile.Ticker.TextColor3 = if has then Theme.Text else Theme.Muted
	end
	ui.AlbumCount.Text = T("prog.lbl.albumCount", owned, total, math.floor(num(p.AlbumSets, 0)))
	local ipos: { string } = {}
	local byId = ctx.Config.Companies and ctx.Config.Companies.ById or {}
	for key in pairs(album) do
		local id = tonumber(key)
		if id and id >= num(cfgAlbum.IpoFrom, 100) and id <= num(cfgAlbum.IpoTo, 139) then
			local inst = byId[id]
			table.insert(ipos, if type(inst) == "table" then tostring(inst.Ticker) else tostring(id))
		end
	end
	table.sort(ipos)
	ui.AlbumIpo.Text = if #ipos > 0 then table.concat(ipos, " · ") else "—"
end

-- ---------------------------------------------------------------------
-- 6) FENSTER + HUD-BADGE
-- ---------------------------------------------------------------------
local function refreshBadge()
	if not badge then
		local ok, button = call("Hud", "RightButton", "Quests")
		if ok and type(button) == "table" and button.Button then
			badge = UI.Badge(button, "")
		end
	end
	local b = badge
	if b then
		local count = Quests.Claimable()
		UI.SetBadge(b, if count > 0 then tostring(count) else nil, Theme.Up, count > 0)
	end
end

function Quests.Refresh()
	refreshBadge()
	if not window or not window.IsOpen then
		return
	end
	if tab == "daily" then
		refreshDaily()
	elseif tab == "weekly" then
		refreshWeekly()
	elseif tab == "starter" then
		refreshStarter()
	elseif tab == "login" then
		refreshLogin()
	elseif tab == "ach" then
		refreshAchievements()
	elseif tab == "album" then
		refreshAlbum()
	end
end

local function buildWindow()
	window = UI.Window(T("prog.win.quests"), WINDOW_W, WINDOW_H, Theme.Up)
	segmented = UI.Segmented(window.Content, {
		{ Key = "daily", Text = T("prog.tab.daily") },
		{ Key = "weekly", Text = T("prog.tab.weekly") },
		{ Key = "starter", Text = T("prog.tab.starter") },
		{ Key = "login", Text = T("prog.tab.login") },
		{ Key = "ach", Text = T("prog.tab.ach") },
		{ Key = "album", Text = T("prog.tab.album") },
	}, function(key: string)
		showTab(key)
		Quests.Refresh()
	end)
	segmented.Frame.LayoutOrder = 0
	buildDaily(newPage("daily", 1))
	buildWeekly(newPage("weekly", 2))
	buildStarter(newPage("starter", 3))
	buildLogin(newPage("login", 4))
	buildAchievements(newPage("ach", 5))
	buildAlbum(newPage("album", 6))
	showTab(tab)
end

local function openWindow()
	if not window then
		buildWindow()
	end
	-- Abholbares zuerst zeigen (Login vor Quests)
	if stateOf("Login").Claimable == true and tab == "daily" then
		tab = "login"
	end
	segmented.Set(tab, true)
	showTab(tab)
	UI.OpenWindow(window)
	Quests.Refresh()
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
end

function Quests.Open(which: string?)
	if
		type(which) == "string" and (which == "daily" or which == "weekly" or which == "starter" or which == "login")
	then
		tab = which
		if window and window.IsOpen then
			-- schon offen: nur den Reiter wechseln (Windows.Open öffnet ein offenes Fenster nicht neu)
			segmented.Set(tab, true)
			showTab(tab)
			Quests.Refresh()
			return
		end
	end
	ctx.Windows.Open("Quests")
end

function Quests.Tick()
	refreshBadge()
	if window and window.IsOpen and (tab == "daily" or tab == "weekly" or tab == "login") then
		Quests.Refresh()
	end
end

function Quests.Init(context: any)
	ctx = context
	ctx.Windows.Register("Quests", openWindow, closeWindow)
end

function Quests.Start()
	ctx.Hooks.On("State", function(_state: any, changed: any)
		if type(changed) ~= "table" then
			return
		end
		if changed.Quests or changed.Login or changed.Prog then
			Quests.Refresh()
		end
	end)
	ctx.Hooks.On("Settings", function()
		table.clear(sigs)
		Quests.Refresh()
	end)
end

return Quests
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">Season</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Skyline-Pass (Client/Modules/Season)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §B9.9 (4 Wochen, 50 Stufen à
--  1.000 Saison-XP, Gratis-Spur 25 / Premium-Spur 50, Premium rückwirkend, ehrlicher Countdown bis Saisonende, nie AKY/
--  XP/KH/Ruf), §0.4 (gekaufte Stufen zahlen nur Kosmetik), §0.8/§B2 (kein Angebot im Tutorial), §C7.3 (Fenster "Season").
--
--  Öffentliche API: keine Pflicht-API. Zusätzlich: Season.Init(ctx), Season.Start(), Season.Tick() (1 s Countdown),
--  Season.Open().   Anfragen: RewardSeason { Tier, Track }.   State: "Season".
--  Premium-Kauf läuft nur über den Shop (Shop.Open("Season")); dieser Knopf ist im Tutorial ausgeblendet.
-- =====================================================================

local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local Season = {}

local Theme = UI.Theme

local WINDOW_W, WINDOW_H = 700, 620
local ROW_H = 64
local POP_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local ctx: any = nil
local window: any = nil
local ui: { [string]: any } = {}
local rows: { [number]: any } = {}
local builtFor = ""
local busy = false

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

local function season(): { [string]: any }
	local s = ctx.State.Season
	return if type(s) == "table" then s else {}
end

local function fmt(fnName: string, ...: any): string
	local fn = ctx.Format[fnName]
	if type(fn) ~= "function" then
		return tostring((...))
	end
	local ok, value = pcall(fn, ...)
	return if ok then value else tostring((...))
end

local function now(): number
	local ok, value = pcall(ctx.Clock.Now)
	return if ok and type(value) == "number" then value else os.time()
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	props.Parent = parent
	if props.TextXAlignment == nil then
		props.TextXAlignment = Enum.TextXAlignment.Left
	end
	return UI.Label(props)
end

-- Spur-Definition der aktuellen Saison (Rolling nutzt die Spuren der letzten festen Saison)
local function seasonDef(): any
	local cfg = ctx.Config.Season
	local list = type(cfg) == "table" and cfg.Seasons or nil
	if type(list) ~= "table" then
		return nil
	end
	local index = math.floor(num(season().SeasonIndex, 0))
	return list[index] or list[#list]
end

local function rewardAt(def: any, track: string, tier: number): any
	local list = if track == "Premium" then def.Premium else def.Free
	if type(list) ~= "table" then
		return nil
	end
	for _, reward in ipairs(list) do
		if type(reward) == "table" and reward.Tier == tier then
			return reward
		end
	end
	return nil
end

-- Beschreibung wie im Quest-Fenster (eine Quelle: Quests.DescribeReward), Rückfall auf die Feldnamen
local function describe(reward: any): string
	local ok, value = call("Quests", "DescribeReward", reward)
	if ok and type(value) == "string" then
		return value
	end
	local parts: { string } = {}
	for field in pairs(reward) do
		if field ~= "Tier" then
			table.insert(parts, tostring(field))
		end
	end
	table.sort(parts)
	return table.concat(parts, " · ")
end

local function earnedOnly(reward: any): boolean
	local cfg = ctx.Config.Season
	local fields = type(cfg) == "table" and cfg.EarnedOnlyFields or {}
	for field in pairs(fields) do
		if reward[field] ~= nil then
			return true
		end
	end
	return false
end

local function tutorialActive(): boolean
	local ok, active = call("Tutorial", "IsActive")
	return ok and active == true
end

local function claim(tier: number, track: string)
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		local reply = ctx.RequestFull("RewardSeason", { Tier = tier, Track = track })
		busy = false
		if type(reply) == "table" and reply.Ok then
			-- Belohnung sofort spürbar: Klang + kleines Konfetti (Stufe 50 groß), Zeile federt kurz
			call("Sfx", "Play", if tier >= 50 then "Achievement" else "Profit")
			call("Effects", "Confetti", if tier >= 50 then 1 else 0.35)
			local row = rows[tier]
			local scale = row and row.Scale
			if scale then
				scale.Scale = 0.96
				TweenService:Create(scale, POP_INFO, { Scale = 1 }):Play()
			end
		end
	end)
end

-- ---------------------------------------------------------------------
-- 2) FENSTER
-- ---------------------------------------------------------------------
local function trackCell(row: Frame, track: string, tier: number, reward: any): any
	local isPremium = track == "Premium"
	local cell = UI.Create("Frame", {
		Name = track,
		Position = if isPremium then UDim2.new(0.5, 30, 0, 6) else UDim2.new(0, 64, 0, 6),
		Size = UDim2.new(0.5, -40, 1, -12),
		BackgroundColor3 = if isPremium then Theme.Cosmic2 else Theme.Surface,
		BackgroundTransparency = if isPremium then 0.82 else 0.4,
		Parent = row,
	}, { UI.Corner(8) })
	if not reward then
		UI.Label({
			Size = UDim2.fromScale(1, 1),
			Text = "–",
			TextColor3 = Theme.Muted,
			MaxText = 14,
			Parent = cell,
		})
		return nil
	end
	local label = UI.Label({
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.new(1, -112, 1, -8),
		Text = describe(reward),
		Face = "Body",
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 13,
		Parent = cell,
	})
	local button = UI.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(96, 36),
		Text = T("prog.btn.claim"),
		Variant = "Muted",
		MaxText = 14,
		Parent = cell,
	}, function()
		claim(tier, track)
	end)
	return { Label = label, Button = button, Reward = reward, EarnedOnly = earnedOnly(reward) }
end

local function buildRows()
	local def = seasonDef()
	local key = if def then tostring(def.Id) .. ":" .. lang() else ""
	if key == builtFor then
		return
	end
	builtFor = key
	for _, row in pairs(rows) do
		row.Frame:Destroy()
	end
	table.clear(rows)
	if not def then
		return
	end
	local tiers = math.floor(num(def.Tiers, 50))
	for tier = 1, tiers do
		local frame = UI.RowCard(ui.List, tier, ROW_H)
		local number = UI.Label({
			Position = UDim2.fromOffset(8, 0),
			Size = UDim2.fromOffset(48, ROW_H),
			Text = tostring(tier),
			Face = "Display",
			MaxText = 20,
			Parent = frame,
		})
		rows[tier] = {
			Frame = frame,
			Scale = UI.Create("UIScale", { Scale = 1, Parent = frame }),
			Stroke = frame:FindFirstChildOfClass("UIStroke"),
			Number = number,
			Free = trackCell(frame, "Free", tier, rewardAt(def, "Free", tier)),
			Premium = trackCell(frame, "Premium", tier, rewardAt(def, "Premium", tier)),
		}
	end
end

local function buildWindow()
	window = UI.Window(T("prog.win.season"), WINDOW_W, WINDOW_H, Theme.Purple)
	local content = window.Content
	ui.Name = text(content, {
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 1,
		Face = "Display",
		MaxText = 22,
		TextColor3 = Theme.Purple,
	})
	ui.Ends = text(content, { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 2, Face = "Mono", MaxText = 14 })
	ui.Tier = text(content, { Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 3, Face = "BodyBold", MaxText = 16 })
	ui.Bar = UI.Bar({ Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 4, Color = Theme.Purple, Parent = content })
	ui.Play = text(content, { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 5, MaxText = 13, TextColor3 = Theme.Text2 })
	ui.Info = text(content, {
		Size = UDim2.new(1, 0, 0, 34),
		LayoutOrder = 6,
		Face = "Body",
		TextWrapped = true,
		MaxText = 13,
		TextColor3 = Theme.Muted,
	})
	local row = UI.Row(content, 7, 46)
	ui.PremiumLabel = text(row, { Size = UDim2.new(1, -230, 1, 0), MaxText = 15, Face = "BodyBold" })
	ui.PremiumButton = UI.Button({
		Size = UDim2.fromOffset(210, 44),
		Text = T("prog.btn.premium"),
		Variant = "Premium",
		Parent = row,
	}, function()
		ctx.Windows.Close("Season")
		local ok = call("Shop", "Open", "Season")
		if not ok then
			ctx.Windows.Open("Shop")
		end
	end)
	local header = UI.Row(content, 8, 24)
	text(header, {
		Size = UDim2.new(0.5, 0, 1, 0),
		Text = "   " .. T("prog.lbl.free"),
		MaxText = 14,
		TextColor3 = Theme.Text2,
		LayoutOrder = 1,
	})
	text(header, {
		Size = UDim2.new(0.5, -8, 1, 0),
		Text = T("prog.lbl.premium"),
		MaxText = 14,
		TextColor3 = Theme.Cosmic3,
		LayoutOrder = 2,
	})
	ui.List = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 9,
		Parent = content,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }) })
	ui.Empty = text(content, {
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 10,
		MaxText = 16,
		TextColor3 = Theme.Muted,
		Visible = false,
	})
end

local function refreshCell(cell: any, tier: number, reached: number, earned: number, claimed: any, locked: boolean)
	if not cell then
		return
	end
	local key = tostring(tier)
	local isClaimed = type(claimed) == "table" and claimed[key] == true
	local reachedTier = tier <= reached
	local boughtOnly = reachedTier and tier > earned and cell.EarnedOnly
	if isClaimed then
		cell.Button.SetText(T("prog.btn.claimed"))
		cell.Button.SetVariant("Muted")
	elseif boughtOnly and not locked then
		-- nur gekauft: zahlt CR/Boosts erst mit verdienter Saison-XP (ehrlich benennen statt „Gesperrt“)
		cell.Button.SetText(T("prog.btn.earn"))
		cell.Button.SetVariant("Muted")
	elseif locked or not reachedTier then
		cell.Button.SetText(T("prog.btn.locked"))
		cell.Button.SetVariant("Muted")
	else
		cell.Button.SetText(T("prog.btn.claim"))
		cell.Button.SetVariant("Success")
	end
	cell.Label.TextColor3 = if isClaimed then Theme.Muted else Theme.Text
end

function Season.Refresh()
	if not window or not window.IsOpen then
		return
	end
	local s = season()
	local def = seasonDef()
	if s.Ended == true or num(s.Id, 0) <= 0 or not def then
		ui.Name.Text = T("prog.win.season")
		ui.Ends.Text = T("prog.season.ended")
		ui.Tier.Text = ""
		ui.Play.Text = ""
		ui.Info.Text = T("prog.season.info")
		ui.PremiumButton.Frame.Visible = false
		ui.PremiumLabel.Text = ""
		ui.List.Visible = false
		return
	end
	ui.List.Visible = true
	buildRows()
	local name = if type(s.Name) == "table" then ctx.Lang.Pick(lang(), s.Name) else nil
	ui.Name.Text = name or T("prog.season.rolling", math.floor(num(s.Id, 1)))
	ui.Ends.Text = T("prog.season.endsIn", fmt("Duration", math.max(0, num(s.EndsAt, 0) - now()), lang()))
	local tiers = math.floor(num(s.Tiers, num(def.Tiers, 50)))
	local tierXp = math.max(1, num(s.TierXp, num(def.TierXp, 1000)))
	local tier = math.floor(num(s.Tier, 0))
	local earned = math.floor(num(s.EarnedTier, tier))
	local xp = num(s.Xp, 0)
	ui.Tier.Text = T("prog.lbl.seasonTier", tier, tiers)
	if tier >= tiers then
		UI.SetBar(ui.Bar, 1, T("prog.lbl.seasonXp", fmt("Int", xp, lang()), fmt("Int", tiers * tierXp, lang())))
	else
		local inTier = xp - tier * tierXp
		UI.SetBar(
			ui.Bar,
			inTier / tierXp,
			T("prog.lbl.seasonXp", fmt("Int", math.max(0, inTier), lang()), fmt("Int", tierXp, lang()))
		)
	end
	local playMinutes = math.floor(num(s.PlayToday, 0)) -- Server zählt Minuten
	ui.Play.Text = T("prog.lbl.playToday", math.min(playMinutes, 60))
	ui.Info.Text = T("prog.season.info")
	local premium = s.Premium == true
	ui.PremiumLabel.Text = if premium then T("prog.lbl.premiumActive") else ""
	ui.PremiumLabel.TextColor3 = Theme.Cosmic3
	-- kein Kauf-Knopf während des Tutorials (§B2: kein Robux-Angebot in der ersten Sitzung)
	ui.PremiumButton.Frame.Visible = not premium and not tutorialActive()
	for t, row in pairs(rows) do
		row.Number.TextColor3 = if t <= tier then Theme.Purple else Theme.Muted
		-- nächste Stufe (an der gerade gearbeitet wird) mit Saison-Lila umrandet
		local stroke = row.Stroke
		if stroke then
			local current = t == math.min(tier + 1, tiers)
			stroke.Color = if current then Theme.Purple else Theme.Border
		end
		refreshCell(row.Free, t, tier, earned, s.ClaimedFree, false)
		refreshCell(row.Premium, t, tier, earned, s.ClaimedPremium, not premium)
	end
end

local function openWindow()
	if not window then
		buildWindow()
	end
	UI.OpenWindow(window)
	Season.Refresh()
	-- zur ersten abholbaren Stufe scrollen
	local s = season()
	local target = math.max(1, math.floor(num(s.Tier, 0)) - 1)
	local row = rows[target]
	if row and row.Frame then
		task.defer(function()
			if window and window.IsOpen and row.Frame.Parent then
				local offset = row.Frame.AbsolutePosition.Y - window.Content.AbsolutePosition.Y
				window.Content.CanvasPosition =
					Vector2.new(0, math.max(0, offset + window.Content.CanvasPosition.Y - 8))
			end
		end)
	end
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
end

function Season.Open()
	ctx.Windows.Open("Season")
end

function Season.Tick()
	if window and window.IsOpen then
		local s = season()
		if num(s.EndsAt, 0) > 0 then
			ui.Ends.Text = T("prog.season.endsIn", fmt("Duration", math.max(0, num(s.EndsAt, 0) - now()), lang()))
		end
	end
end

function Season.Init(context: any)
	ctx = context
	ctx.Windows.Register("Season", openWindow, closeWindow)
end

function Season.Start()
	-- Einstieg über die rechte HUD-Leiste (der Skyline-Pass hat keinen Standard-Knopf im HUD)
	local okButton = call("Hud", "AddRightButton", "🌆", "prog.btn.pass", Theme.Purple, 75, function()
		ctx.Windows.Toggle("Season")
	end)
	if not okButton then
		warn("[Season] Hud.AddRightButton nicht verfügbar – Skyline-Pass nur über die Boutique erreichbar")
	end
	ctx.Hooks.On("State", function(_state: any, changed: any)
		if type(changed) == "table" and changed.Season then
			Season.Refresh()
		end
	end)
	ctx.Hooks.On("Settings", function()
		builtFor = ""
		Season.Refresh()
	end)
end

return Season
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="152">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Einstellungen (Client/Modules/Settings)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §C7.3 (Fenster "Settings"), §C7.5, §C14.2, §A2 (Info).
--  Basis: CC-Settings (schema-gesteuert, REUSE §1.4 ADAPT).
--
--  Ein Fenster "Settings", gebaut aus Config.Client.SettingsSchema: Regler (Zahlen), Schalter (an/aus), Auswahl
--  (Optionen). Änderungen wirken sofort (Hook "Settings"), gespeichert wird gebündelt über Request "SaveSettings"
--  (nur geänderte Schlüssel, 0,8 s nach der letzten Änderung; der Server klemmt mit demselben Schema).
--  "AutoTransfer" schickt zusätzlich Request "TradeAuto" { On } (Depot-Seite, WP4).
--  Abschnitte: Spiel · Grafik · Ton · Trading · Touch · Info (Disclaimer §A2, Regeln, Einspruch, Version, Fotomodus).
--  Taste M / Start / HUD-Knopf: offenes Fenster schließen, sonst Einstellungen öffnen.
--  AKYTEX-Look: Glas-Fenster (UI.Window), jede Einstellung eine Zeile auf Surface2 mit 1-px-Rahmen,
--  Schalter als Pill (an = Accent), Regler mit Accent-Füllung, Auswahl als Sekundär-Knopf.
--
--  Öffentliche API (§C7.5):
--    Settings.Get(): { [string]: any }      aktuelle Werte (NICHT verändern – Settings.Set benutzen)
--    Settings.Set(path, value)              "Key" oder "Key.Feld" (z. B. "Indicators.RSI"); geklemmt, gespeichert
--    Settings.Open()
--  Zusätzlich: Settings.Tick(), Settings.Init(ctx), Settings.Start()
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")) :: any

local Settings = {}

local Theme = UI.Theme
local WHITE = Color3.new(1, 1, 1)
local SWITCH_INFO = TweenInfo.new(0.14, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local SAVE_DELAY = 0.8 -- Sekunden nach der letzten Änderung speichern (Server-Limit 2/s)
local WINDOW_W = 640
local WINDOW_H = 580
local ROW_H = 48

-- Reihenfolge + Abschnitte im Fenster (Schlüssel aus dem Schema)
local SECTIONS: { { Key: string, Items: { string } } } = {
	{ Key = "game", Items = { "Lang", "NumberStyle", "AutoTransfer", "NewsCards", "TickerBar" } },
	{ Key = "graphics", Items = { "Quality", "ReducedFx", "Shake", "ShowNet" } },
	{ Key = "audio", Items = { "Sfx", "Music", "Ui" } },
	{ Key = "trading", Items = { "ChartType", "ChartTf", "Colorblind" } },
	{ Key = "touch", Items = { "LeftHanded", "ButtonScale" } },
}
-- Regler, die als Prozent angezeigt werden
local PERCENT = {
	Shake = true,
	Sfx = true,
	Music = true,
	Ui = true,
	ButtonScale = true,
}

local ctx: any = nil
local schema: { [string]: any } = Config.Client and Config.Client.SettingsSchema or {}
local defaults: { [string]: any } = Config.Client and Config.Client.DefaultSettings or {}
local current: { [string]: any } = {}
local pending: { [string]: any } = {}
local saveToken = 0
local window: any = nil
local rows: { { Refresh: () -> () } } = {}
local rowConns: { RBXScriptConnection } = {} -- Eingabe-Verbindungen der Regler (beim Neubau trennen)
local builtLang = ""
local statusLabel: TextLabel? = nil
local qualityLabel: TextLabel? = nil

-- ---------------------------------------------------------------------
-- HILFEN
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

-- Text eines Schlüssels; fehlt er (Lang gibt den Schlüssel zurück), den Ersatz nehmen
local function TOr(key: string, fallback: string): string
	local text = T(key)
	if text == key then
		return fallback
	end
	return text
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- Startwerte schon beim Laden (andere Module fragen Settings.Get evtl. vor Settings.Init)
current = deepCopy(defaults)

local function entryFor(path: string): (any, string, string?)
	local key, field = string.match(path, "^(%w+)%.(%w+)$")
	if key and field then
		local parent = schema[key]
		local fields = parent and parent.Fields
		return fields and fields[field], key, field
	end
	return schema[path], path, nil
end

-- Wert prüfen + klemmen wie der Server (Zahl: Min/Max/Step/Integer; Enum: Option; Bool; Tabelle: je Feld)
local function clean(entry: any, value: any, fallback: any): any
	if type(entry) ~= "table" then
		return fallback
	end
	if entry.Type == "number" then
		if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
			return fallback
		end
		local v = value
		local step = entry.Step
		if type(step) == "number" and step > 0 then
			v = math.floor(v / step + 0.5) * step
			v = math.floor(v * 1000 + 0.5) / 1000
		end
		if entry.Integer then
			v = math.floor(v + 0.5)
		end
		return math.clamp(v, entry.Min or v, entry.Max or v)
	elseif entry.Type == "boolean" then
		return if type(value) == "boolean" then value else fallback
	elseif entry.Type == "enum" then
		return if type(value) == "string" and table.find(entry.Options or {}, value) then value else fallback
	elseif entry.Type == "table" then
		if type(value) ~= "table" then
			return fallback
		end
		local result = {}
		local fb = if type(fallback) == "table" then fallback else {}
		for field, sub in pairs(entry.Fields or {}) do
			local cleaned = clean(sub, value[field], fb[field])
			if cleaned ~= nil then
				result[field] = cleaned
			end
		end
		return result
	end
	return fallback
end

local function fire()
	ctx.Hooks.Fire("Settings", current)
end

local function refreshRows()
	for _, row in ipairs(rows) do
		row.Refresh()
	end
end

-- ---------------------------------------------------------------------
-- SPEICHERN (gebündelt, nur geänderte Schlüssel)
-- ---------------------------------------------------------------------
local function setStatus(text: string, color: Color3?)
	local label = statusLabel
	if label then
		label.Text = text
		label.TextColor3 = color or Theme.Text2
	end
end

local function flush()
	if next(pending) == nil then
		return
	end
	local batch = pending
	pending = {}
	local reply = ctx.RequestFull("SaveSettings", batch, true)
	if reply.Ok then
		setStatus(T("ui.set.saved"), Theme.Up)
	else
		setStatus(T("ui.set.saveFailed"), Theme.Down)
		if type(reply.Message) == "string" and reply.Message ~= "" then
			UI.Toast(reply.Message, "Error")
		end
	end
	-- Gewinn-Transfer an der Glocke liegt im Depot (WP4) – dort mitschalten
	if batch.AutoTransfer ~= nil then
		ctx.RequestFull("TradeAuto", { On = batch.AutoTransfer == true }, true)
	end
end

local function scheduleSave(key: string)
	pending[key] = deepCopy(current[key])
	saveToken += 1
	local token = saveToken
	setStatus(T("ui.set.saving"), Theme.Muted)
	task.delay(SAVE_DELAY, function()
		if token == saveToken then
			flush()
		end
	end)
end

function Settings.Get(): { [string]: any }
	return current
end

-- Wert setzen ("Key" oder "Key.Feld"): geklemmt, sofort wirksam, gebündelt gespeichert
function Settings.Set(path: string, value: any)
	if type(path) ~= "string" then
		return
	end
	local entry, key, field = entryFor(path)
	if not entry then
		warn("[Settings] Unbekannte Einstellung: " .. path)
		return
	end
	if field then
		local parent = current[key]
		if type(parent) ~= "table" then
			parent = deepCopy(defaults[key]) or {}
			current[key] = parent
		end
		local cleaned = clean(entry, value, parent[field])
		if parent[field] == cleaned then
			return
		end
		parent[field] = cleaned
	else
		local cleaned = clean(entry, value, current[key])
		if current[key] == cleaned and type(cleaned) ~= "table" then
			return
		end
		current[key] = cleaned
	end
	scheduleSave(key)
	fire()
	refreshRows()
end

-- flacher Vergleich (Tabellen-Einstellungen wie Indicators haben nur einfache Werte)
local function sameValue(a: any, b: any): boolean
	if type(a) ~= "table" or type(b) ~= "table" then
		return a == b
	end
	for k, v in pairs(a) do
		if b[k] ~= v then
			return false
		end
	end
	for k, v in pairs(b) do
		if a[k] ~= v then
			return false
		end
	end
	return true
end

-- Server-Stand übernehmen (lokal noch nicht gespeicherte Änderungen bleiben). Der volle State alle 20 s
-- feuert den Hook nur, wenn sich wirklich etwas geändert hat.
local function mergeServer(serverSettings: any)
	if type(serverSettings) ~= "table" then
		return
	end
	local changed = false
	for key, entry in pairs(schema) do
		if pending[key] == nil and serverSettings[key] ~= nil then
			local cleaned = clean(entry, serverSettings[key], current[key])
			if not sameValue(cleaned, current[key]) then
				current[key] = cleaned
				changed = true
			end
		end
	end
	if changed then
		fire()
		refreshRows()
	end
end

-- ---------------------------------------------------------------------
-- FENSTER-BAUSTEINE
-- ---------------------------------------------------------------------
local function labelFor(path: string): string
	return TOr("ui.set." .. path, path)
end

local function optionText(path: string, option: any): string
	local _, key, field = entryFor(path)
	local name = field or key
	return TOr("ui.opt." .. name .. "." .. tostring(option), tostring(option))
end

local function getValue(path: string): any
	local _, key, field = entryFor(path)
	if field then
		local parent = current[key]
		return type(parent) == "table" and parent[field] or nil
	end
	return current[key]
end

local function formatNumber(path: string, entry: any, value: number): string
	local _, key = entryFor(path)
	if PERCENT[key] then
		return tostring(math.floor(value * 100 + 0.5)) .. " %"
	end
	if entry.Integer then
		return tostring(math.floor(value + 0.5))
	end
	return string.format("%.2f", value)
end

local function makeRow(parent: Instance, order: number): (Frame, Frame, TextLabel)
	-- Zeile auf Surface2 mit 1-px-Rahmen: Beschriftung links, Bedienelement rechtsbündig
	local row: Frame = UI.Card({
		Size = UDim2.new(1, 0, 0, ROW_H),
		LayoutOrder = order,
		Parent = parent,
	})
	local label = UI.Label({
		Name = "Label",
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(0.5, -18, 1, 0),
		Text = "",
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 16,
		Parent = row,
	})
	local control = UI.Create("Frame", {
		Name = "Control",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.new(0.5, -8, 1, -12),
		BackgroundTransparency = 1,
		Parent = row,
	})
	return row, control, label
end

-- Schalter als Pill (an = Accent, Knopf rechts; aus = Hover-Fläche, Knopf links) + AN/AUS-Text
local function boolRow(parent: Instance, order: number, path: string)
	local _, control, label = makeRow(parent, order)
	local track: TextButton = UI.Create("TextButton", {
		Name = "Switch",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(52, 28),
		BackgroundColor3 = Theme.Hover,
		AutoButtonColor = false,
		Text = "",
		Parent = control,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.Create("UIStroke", { Color = Theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	})
	local knob: Frame = UI.Create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 4, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = track,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local state = UI.Label({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -62, 0.5, 0),
		Size = UDim2.new(1, -66, 0, 18),
		Text = "",
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxText = 14,
		Parent = control,
	})
	track.Activated:Connect(function()
		local modules = ctx and ctx.Modules
		local sfx = modules and modules.Sfx
		if sfx and type(sfx.Play) == "function" then
			pcall(sfx.Play, "UIClick")
		end
		Settings.Set(path, not (getValue(path) == true))
	end)
	local shownOn: boolean? = nil
	table.insert(rows, {
		Refresh = function()
			label.Text = labelFor(path)
			local on = getValue(path) == true
			state.Text = if on then T("ui.on") else T("ui.off")
			state.TextColor3 = if on then Theme.Text else Theme.Muted
			if shownOn == on then
				return
			end
			local first = shownOn == nil
			shownOn = on
			local color = if on then Theme.Accent else Theme.Hover
			local pos = if on then UDim2.new(1, -24, 0.5, 0) else UDim2.new(0, 4, 0.5, 0)
			if first then
				track.BackgroundColor3 = color
				knob.Position = pos
			else
				TweenService:Create(track, SWITCH_INFO, { BackgroundColor3 = color }):Play()
				TweenService:Create(knob, SWITCH_INFO, { Position = pos }):Play()
			end
		end,
	})
end

local function enumRow(parent: Instance, order: number, path: string, entry: any)
	local _, control, label = makeRow(parent, order)
	local options: { any } = entry.Options or {}
	local button = UI.Button({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Variant = "Secondary",
		MaxText = 16,
		Corner = 10,
		Parent = control,
	}, function()
		local value = getValue(path)
		local index = table.find(options, value) or 0
		local nextValue = options[index % math.max(1, #options) + 1]
		if nextValue ~= nil then
			Settings.Set(path, nextValue)
		end
	end)
	table.insert(rows, {
		Refresh = function()
			label.Text = labelFor(path)
			button.SetText("‹  " .. optionText(path, getValue(path)) .. "  ›")
		end,
	})
end

local function numberRow(parent: Instance, order: number, path: string, entry: any)
	local _, control, label = makeRow(parent, order)
	local minV: number = entry.Min or 0
	local maxV: number = entry.Max or 1
	local step: number = entry.Step or ((maxV - minV) / 20)
	local function nudge(direction: number)
		local value = tonumber(getValue(path)) or minV
		Settings.Set(path, value + direction * step)
	end
	UI.Button({
		Size = UDim2.new(0, 34, 1, 0),
		Text = "−",
		Variant = "Ghost",
		MaxText = 22,
		Corner = 10,
		Parent = control,
	}, function()
		nudge(-1)
	end)
	UI.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 34, 1, 0),
		Text = "+",
		Variant = "Ghost",
		MaxText = 22,
		Corner = 10,
		Parent = control,
	}, function()
		nudge(1)
	end)
	-- Regler-Schiene zum Ziehen (Maus/Touch): Bg2 mit Accent-Füllung, Wert in BuilderMono
	local track: Frame = UI.Create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -84, 0, 24),
		BackgroundColor3 = Theme.Bg2,
		Active = true,
		Parent = control,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.Create("UIStroke", { Color = Theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	})
	local fill: Frame = UI.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = track,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local valueLabel = UI.Label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Face = "MonoBold",
		TextColor3 = WHITE,
		MaxText = 15,
		Outline = 1,
		ZIndex = 2,
		Parent = track,
	})
	local dragging: InputObject? = nil
	local function setFromX(x: number)
		local absPos = track.AbsolutePosition.X
		local width = math.max(1, track.AbsoluteSize.X)
		local ratio = math.clamp((x - absPos) / width, 0, 1)
		Settings.Set(path, minV + (maxV - minV) * ratio)
	end
	track.InputBegan:Connect(function(input: InputObject)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = input
			setFromX(input.Position.X)
		end
	end)
	table.insert(
		rowConns,
		UserInputService.InputChanged:Connect(function(input: InputObject)
			local active = dragging
			if not active or not track.Parent then
				return
			end
			if
				(
					active.UserInputType == Enum.UserInputType.MouseButton1
					and input.UserInputType == Enum.UserInputType.MouseMovement
				) or input == active
			then
				setFromX(input.Position.X)
			end
		end)
	)
	table.insert(
		rowConns,
		UserInputService.InputEnded:Connect(function(input: InputObject)
			if input == dragging then
				dragging = nil
			end
		end)
	)
	table.insert(rows, {
		Refresh = function()
			label.Text = labelFor(path)
			local value = tonumber(getValue(path)) or minV
			local ratio = if maxV > minV then (value - minV) / (maxV - minV) else 0
			fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
			valueLabel.Text = formatNumber(path, entry, value)
		end,
	})
end

local function clearContent(content: ScrollingFrame)
	for _, child in ipairs(content:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	table.clear(rows)
	for _, conn in ipairs(rowConns) do
		conn:Disconnect()
	end
	table.clear(rowConns)
	qualityLabel = nil
end

local function moduleCall(name: string, fnName: string, ...: any): (boolean, any)
	local module = ctx and ctx.Modules and ctx.Modules[name]
	local fn = module and module[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function qualityText(): string
	local ok, tier = moduleCall("Quality", "Tier")
	local tierName = if ok and type(tier) == "string" then tier else "?"
	return T("ui.set.qualityNow", TOr("ui.opt.Quality." .. tierName, tierName))
end

local function infoText(parent: Instance, text: string, order: number, color: Color3?, height: number?)
	UI.Label({
		Size = UDim2.new(1, 0, 0, height or 56),
		Text = text,
		Face = "Body",
		TextColor3 = color or Theme.Text2,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		MaxText = 15,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function buildContent()
	local win = window
	if not win then
		return
	end
	local content: ScrollingFrame = win.Content
	clearContent(content)
	builtLang = ctx.Lang_()
	win.TitleLabel.Text = UI.Upper(T("ui.settingsTitle"))
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	statusLabel = UI.Label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = T("ui.set.hint"),
		Face = "Body",
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 15,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
	for _, section in ipairs(SECTIONS) do
		UI.Section(content, T("ui.sec." .. section.Key), nextOrder(), Theme.Accent)
		for _, path in ipairs(section.Items) do
			local entry = entryFor(path)
			if entry then
				if entry.Type == "boolean" then
					boolRow(content, nextOrder(), path)
				elseif entry.Type == "enum" then
					enumRow(content, nextOrder(), path, entry)
				elseif entry.Type == "number" then
					numberRow(content, nextOrder(), path, entry)
				end
			end
		end
		if section.Key == "graphics" then
			qualityLabel = UI.Label({
				Size = UDim2.new(1, 0, 0, 20),
				Text = qualityText(),
				Face = "Body",
				TextColor3 = Theme.Muted,
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxText = 14,
				LayoutOrder = nextOrder(),
				Parent = content,
			})
			-- Fotomodus für alle (Taste F7; auf dem Handy nur über diesen Knopf, lang drücken beendet)
			local row = UI.Row(content, nextOrder(), 44)
			UI.Button({
				Size = UDim2.new(1, 0, 1, 0),
				Text = T("ui.set.photoMode"),
				Variant = "Secondary",
				MaxText = 16,
				Corner = 10,
				Parent = row,
			}, function()
				ctx.Windows.Close()
				task.delay(0.2, function()
					moduleCall("PhotoMode", "Toggle")
				end)
			end)
		end
	end
	-- Info: Disclaimer (§A2), Regeln + Einspruch, Version
	UI.Section(content, T("ui.sec.info"), nextOrder(), Theme.Muted)
	infoText(content, T("core.disclaimer"), nextOrder(), Theme.Text, 72)
	infoText(content, T("ui.info.rules"), nextOrder(), nil, 72)
	infoText(content, T("ui.info.appeal"), nextOrder(), nil, 56)
	local config = ctx.Config
	infoText(content, T("ui.version", tostring(config and config.Version or "?")), nextOrder(), Theme.Muted, 20)
	refreshRows()
end

local function openWindow()
	if not window then
		window = UI.Window(T("ui.settingsTitle"), WINDOW_W, WINDOW_H, Theme.Accent)
		buildContent()
	elseif builtLang ~= ctx.Lang_() then
		buildContent()
	else
		refreshRows()
		local label = qualityLabel
		if label then
			label.Text = qualityText()
		end
	end
	UI.OpenWindow(window)
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
end

function Settings.Open()
	ctx.Windows.Open("Settings")
end

-- 1-s-Takt: Sprache gewechselt / Grafikstufe geändert, während das Fenster offen ist
function Settings.Tick()
	local win = window
	if not win or not win.IsOpen then
		return
	end
	if builtLang ~= ctx.Lang_() then
		buildContent()
		return
	end
	local label = qualityLabel
	if label then
		local text = qualityText()
		if label.Text ~= text then
			label.Text = text
		end
	end
end

function Settings.Init(context: any)
	ctx = context
	local initialState = ctx.State
	if type(initialState) == "table" and type(initialState.Settings) == "table" then
		mergeServer(initialState.Settings)
	end
	ctx.Windows.Register("Settings", openWindow, closeWindow)

	local hooks = ctx.Hooks
	hooks.On("State", function(newState, changed)
		if type(changed) == "table" and changed.Settings and type(newState) == "table" then
			mergeServer(newState.Settings)
		end
	end)
	-- Menü-Taste (M / Start): offenes Fenster schließen, sonst Einstellungen öffnen
	local controls = ctx.Modules.Controls
	if controls and type(controls.Bind) == "function" then
		controls.Bind("Menu", function(state)
			if state ~= "Begin" then
				return
			end
			-- im Fotomodus ist alles ausgeblendet: Menü-Taste beendet ihn zuerst
			local ok, photo = moduleCall("PhotoMode", "IsActive")
			if ok and photo == true then
				moduleCall("PhotoMode", "Toggle")
				return
			end
			if ctx.Windows.IsOpen() then
				ctx.Windows.Close()
			else
				ctx.Windows.Open("Settings")
			end
		end)
	end
end

function Settings.Start()
	fire() -- alle Module bekommen die Startwerte
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">Sfx</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Sounds nur aus eingebauten Dateien (Client/Modules/Sfx)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §A4 (Sound-Rollen), §C7.5, §C14.3 (SoundId = 0),
--  docs/ASSETS.md §2 (CC-Rezept-Engine 1:1, neue Rollen).
--
--  Jede Rolle (z. B. "Buy", "MarketBell", "CrashAlarm") ist ein REZEPT aus den 9 nutzbaren eingebauten Roblox-Sounds:
--  Tonhöhe (PlaybackSpeed), Ausschnitt (PlaybackRegion), Effekte (Verzerrung, Equalizer, Echo) und mehrere Schichten
--  nacheinander (Jingles). Trägt der Besitzer in Config.Client.Sounds.<Rolle> eine Audio-ID ein (≠ 0), wird stattdessen
--  diese gespielt (Hybrid, Wunsch 17). Feste Stimmen-Vorräte (Pools.Sounds: halb 2D, halb 3D) im Rundlauf – kein neues
--  Sound-Objekt pro Ton. Lautstärke über SoundGroups (Einstellungen Sfx / Ui / Music). Keine Casino-Klänge, keine
--  Münz-Kaskade pro Trade (§0.2/§0.3): Gewinn = ruhiges Arpeggio, Verlust = ein tiefer Ton.
--
--  Rollen (§A4): UIClick, UIHover, UIError, Buy, Sell, Profit, Loss, CashRegister, TickerTick, MarketBell, CrashAlarm,
--    RallyFanfare, ElevatorDing, Construct, MoneyRain, Engine (Loop) + LevelUp, Achievement, Pickup, Whoosh, Countdown, Notify.
--
--  Öffentliche API (§C7.5):
--    Sfx.Play(role, pos?, opts?)        opts { Volume?, Speed? } – pos = 3D-Sound an dieser Stelle
--    Sfx.Duck(amount, seconds)          Welt-/Effekt-Sounds kurz leiser (Glocke, Ansage)
--    Sfx.SetMusic(kind?)                nil = aus; sonst Musik aus Config.Client.Sounds.Music (ohne ID keine Musik)
--  Zusätzlich: Sfx.Has(role), Sfx.Loop(role, parent?) -> { Sound, SetSpeed(x), SetVolume(v), Stop() } (z. B. Motor),
--    Sfx.ApplySettings(settings), Sfx.Init(ctx), Sfx.Start()
-- =====================================================================

local ContentProvider = game:GetService("ContentProvider")
local SoundService = game:GetService("SoundService")

local Sfx = {}

local ctx: any = nil

-- Die eingebauten Dateien (exakte Pfade aus docs/ASSETS.md §2 – nichts anderes benutzen!)
local FILES = {
	Boom = "rbxasset://sounds/impact_explosion_03.mp3",
	Land = "rbxasset://sounds/action_jump_land.mp3",
	Tick = "rbxasset://sounds/volume_slider.ogg",
	Jump = "rbxasset://sounds/action_jump.mp3",
	GetUp = "rbxasset://sounds/action_get_up.mp3",
	Wind = "rbxasset://sounds/action_falling.ogg",
	Water = "rbxasset://sounds/impact_water.mp3",
}

type Echo = { Delay: number, Feedback: number, Wet: number }
type Layer = {
	File: string,
	Speed: number,
	Vol: number,
	Region: { number }?, -- { Start, Ende } in Sekunden der Original-Datei
	Delay: number?, -- Sekunden nach der ersten Schicht
	Dist: number?, -- DistortionSoundEffect.Level
	EqLow: number?,
	EqMid: number?,
	EqHigh: number?,
	Echo: Echo?,
	Jitter: number?, -- ± Anteil zufällige Tonhöhe (0.04 = ±4 %)
	Range: number?, -- RollOffMaxDistance (3D)
}
type Recipe = { Group: string, Layers: { Layer } }

local ECHO_DING: Echo = { Delay = 0.08, Feedback = 0.2, Wet = -6 }
local ECHO_BELL: Echo = { Delay = 0.22, Feedback = 0.42, Wet = -3 }
local ECHO_JINGLE: Echo = { Delay = 0.12, Feedback = 0.3, Wet = -4 }

-- Tonfolge aus volume_slider.ogg (musikalische Verhältnisse: große Terz 1.26, Quinte 1.5, Oktave 2.0)
local function notes(file: string, speeds: { number }, gap: number, vol: number, extra: { [string]: any }?): { Layer }
	local list: { Layer } = {}
	for i, speed in ipairs(speeds) do
		local layer: Layer = { File = file, Speed = speed, Vol = vol, Delay = (i - 1) * gap }
		if extra then
			if extra.EchoLast and i == #speeds then
				layer.Echo = ECHO_JINGLE
			end
			if extra.EchoAll then
				layer.Echo = extra.Echo or ECHO_JINGLE
			end
			if extra.EqHigh then
				layer.EqHigh = extra.EqHigh
			end
			if extra.EqLow then
				layer.EqLow = extra.EqLow
			end
			if extra.Dist then
				layer.Dist = extra.Dist
			end
		end
		table.insert(list, layer)
	end
	return list
end

-- Gruppen: SFX (Welt/Effekte, wird bei Duck leiser), UI (Oberfläche), MUSIC
-- Startwerte nach ASSETS.md §2.2 / DESIGN §A4 (nach Gehör im Studio nachstellen)
local RECIPES: { [string]: Recipe } = {
	-- Oberfläche
	UIClick = { Group = "UI", Layers = { { File = FILES.Tick, Speed = 1.0, Vol = 0.5 } } },
	UIHover = { Group = "UI", Layers = { { File = FILES.Tick, Speed = 1.5, Vol = 0.2 } } },
	UIError = { Group = "UI", Layers = { { File = FILES.Land, Speed = 0.7, Vol = 0.5 } } },
	Notify = { Group = "UI", Layers = notes(FILES.Tick, { 1.5, 2.0 }, 0.07, 0.35) },
	Countdown = { Group = "UI", Layers = { { File = FILES.Tick, Speed = 1.0, Vol = 0.6 } } },
	-- Handel (ruhig, nie Slot-artig): Kauf Tick 1.26 -> 1.5, Verkauf 1.5 -> 1.26
	Buy = { Group = "UI", Layers = notes(FILES.Tick, { 1.26, 1.5 }, 0.07, 0.5) },
	Sell = { Group = "UI", Layers = notes(FILES.Tick, { 1.5, 1.26 }, 0.07, 0.5) },
	Profit = { Group = "UI", Layers = notes(FILES.Tick, { 1.0, 1.26, 1.5 }, 0.11, 0.45, { EchoLast = true }) },
	Loss = { Group = "UI", Layers = { { File = FILES.Tick, Speed = 0.667, Vol = 0.4, EqHigh = -6 } } },
	TickerTick = { Group = "UI", Layers = { { File = FILES.Tick, Speed = 2.2, Vol = 0.15 } } },
	-- Tower / Geld
	CashRegister = {
		Group = "SFX",
		Layers = {
			{ File = FILES.Land, Speed = 3.0, Vol = 0.45, EqHigh = 4 },
			{ File = FILES.Tick, Speed = 2.0, Vol = 0.45, Delay = 0.05, Echo = ECHO_DING },
		},
	},
	Construct = {
		Group = "SFX",
		Layers = {
			{ File = FILES.Land, Speed = 0.8, Vol = 0.6, EqLow = 4, Jitter = 0.05 },
			{ File = FILES.Land, Speed = 1.1, Vol = 0.35, Delay = 0.18, Jitter = 0.05 },
		},
	},
	ElevatorDing = {
		Group = "SFX",
		Layers = {
			{ File = FILES.Tick, Speed = 2.0, Vol = 0.55, Echo = ECHO_DING },
			{ File = FILES.Tick, Speed = 1.5, Vol = 0.45, Delay = 0.16, Echo = ECHO_DING },
		},
	},
	MoneyRain = { Group = "SFX", Layers = { { File = FILES.Tick, Speed = 2.0, Vol = 0.35, Jitter = 0.25 } } },
	Pickup = { Group = "SFX", Layers = notes(FILES.Tick, { 1.5, 2.0 }, 0.05, 0.45) },
	Whoosh = { Group = "SFX", Layers = { { File = FILES.Wind, Speed = 2.0, Vol = 0.35, Region = { 0, 0.45 } } } },
	-- Markt-Momente
	MarketBell = {
		Group = "SFX",
		Layers = notes(FILES.Tick, { 1.0, 1.26, 1.5 }, 0.18, 0.8, { EchoAll = true, Echo = ECHO_BELL, EqLow = 3 }),
	},
	CrashAlarm = {
		Group = "SFX",
		Layers = notes(FILES.Tick, { 0.841, 0.667, 0.841, 0.667 }, 0.32, 0.6, { Dist = 0.45, EqHigh = -3 }),
	},
	RallyFanfare = {
		Group = "SFX",
		Layers = notes(FILES.Tick, { 1.0, 1.26, 1.5, 2.0 }, 0.09, 0.75, { EchoAll = true }),
	},
	-- Meilensteine (nur Stufe, Lizenz, Titel, Börsengang, Liga – §0.3 Punkt 6)
	LevelUp = { Group = "UI", Layers = notes(FILES.Tick, { 1.0, 1.26, 1.5, 2.0 }, 0.09, 0.75, { EchoAll = true }) },
	Achievement = { Group = "UI", Layers = notes(FILES.Tick, { 1.26, 1.5, 2.0 }, 0.08, 0.6, { EchoLast = true }) },
	-- Motor-Loop (nur über Sfx.Loop; Tonhöhe nach Tempo)
	Engine = { Group = "SFX", Layers = { { File = FILES.Wind, Speed = 0.8, Vol = 0.35, EqLow = 3, Range = 120 } } },
}

-- Rollen, die nur als Loop gespielt werden (Play ignoriert sie)
local LOOP_ROLES = { Engine = true }
-- Rollen ohne eingebautes Rezept (nur mit eigener ID): Musik
local MUSIC_ROLES = { Music = true }

local DEDUPE_GAP = 0.025 -- dieselbe Rolle innerhalb so kurzer Zeit nur einmal (zwei Module melden dasselbe)
local DEFAULT_RANGE = 300
local MIN_RANGE = 10
local WARN_GAP = 30
local MAX_LOOPS = 12 -- gleichzeitige Loops (Motoren) – mehr werden abgelehnt

type Voice = {
	Sound: Sound,
	Dist: DistortionSoundEffect,
	Eq: EqualizerSoundEffect,
	Echo: EchoSoundEffect,
	Attachment: Attachment?,
	StartedAt: number,
}

export type LoopHandle = {
	Sound: Sound,
	SetSpeed: (mult: number) -> (),
	SetVolume: (volume: number) -> (),
	Stop: () -> (),
}

local voices2D: { Voice } = {}
local voices3D: { Voice } = {}
local next2D = 1
local next3D = 1
local groups: { [string]: SoundGroup } = {}
local baseVolume: { [string]: number } = { SFX = 1, UI = 0.8, MUSIC = 0.5 }
local duckFactor = 1
local duckToken = 0
local lastPlayed: { [string]: number } = {}
local warnedRole: { [string]: number } = {}
local anchorPart: Part? = nil
local musicSound: Sound? = nil
local musicKind: string? = nil
local loopCount = 0
local random = Random.new()

-- ---------------------------------------------------------------------
-- AUFBAU
-- ---------------------------------------------------------------------
local function makeVoice(parent: Instance, name: string, attachment: Attachment?): Voice
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.Volume = 0.5
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = MIN_RANGE
	sound.RollOffMaxDistance = DEFAULT_RANGE
	local dist = Instance.new("DistortionSoundEffect")
	dist.Enabled = false
	dist.Parent = sound
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Enabled = false
	eq.Parent = sound
	local echo = Instance.new("EchoSoundEffect")
	echo.Enabled = false
	echo.Parent = sound
	sound.Parent = parent
	return { Sound = sound, Dist = dist, Eq = eq, Echo = echo, Attachment = attachment, StartedAt = -math.huge }
end

local function makeGroup(name: string): SoundGroup
	local full = "AkytexTycoon" .. name
	local existing = SoundService:FindFirstChild(full)
	if existing and existing:IsA("SoundGroup") then
		return existing
	end
	local group = Instance.new("SoundGroup")
	group.Name = full
	group.Volume = 1
	group.Parent = SoundService
	return group
end

local function applyGroupVolumes()
	for name, group in pairs(groups) do
		local volume = baseVolume[name] or 1
		if name == "SFX" or name == "MUSIC" then
			volume *= duckFactor
		end
		group.Volume = math.clamp(volume, 0, 2)
	end
end

local function build()
	groups.SFX = makeGroup("Sfx")
	groups.UI = makeGroup("Ui")
	groups.MUSIC = makeGroup("Music")

	local poolSize = 24
	local config = ctx and ctx.Config
	local pools = config and config.Client and config.Client.Pools
	if pools and type(pools.Sounds) == "number" then
		poolSize = math.clamp(math.floor(pools.Sounds), 4, 64)
	end
	local half = math.max(2, math.floor(poolSize / 2))

	-- 2D-Stimmen: direkt im SoundService (überall gleich laut)
	local folder2D = Instance.new("Folder")
	folder2D.Name = "AkytexTycoonVoices"
	folder2D.Parent = SoundService
	for i = 1, half do
		table.insert(voices2D, makeVoice(folder2D, "Voice2D_" .. i, nil))
	end

	-- 3D-Stimmen: an Attachments eines unsichtbaren, lokalen Ankers (WorldPosition = Klangquelle)
	local anchor = Instance.new("Part")
	anchor.Name = "AkytexTycoonSfxAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new()
	anchor.Parent = workspace
	anchorPart = anchor
	for i = 1, half do
		local attachment = Instance.new("Attachment")
		attachment.Name = "Voice3D_" .. i
		attachment.Parent = anchor
		table.insert(voices3D, makeVoice(attachment, "Sound", attachment))
	end

	local music = Instance.new("Sound")
	music.Name = "AkytexTycoonMusic"
	music.Looped = true
	music.Volume = 0.5
	music.SoundGroup = groups.MUSIC
	music.Parent = SoundService
	musicSound = music

	applyGroupVolumes()
end

-- Eingebaute Dateien einmal vorladen (sonst kann der allererste Klick stumm sein)
local function preload()
	local list: { Instance } = {}
	for _, path in pairs(FILES) do
		local sound = Instance.new("Sound")
		sound.SoundId = path
		table.insert(list, sound)
	end
	local ok, err = pcall(function()
		ContentProvider:PreloadAsync(list)
	end)
	if not ok then
		warn("[Sfx] Vorladen fehlgeschlagen: " .. tostring(err))
	end
	for _, sound in ipairs(list) do
		sound:Destroy()
	end
end

-- ---------------------------------------------------------------------
-- ABSPIELEN
-- ---------------------------------------------------------------------
local function pickVoice(list: { Voice }, is3D: boolean): Voice?
	local count = #list
	if count == 0 then
		return nil
	end
	local start = if is3D then next3D else next2D
	local chosen: Voice? = nil
	local oldest: Voice? = nil
	for offset = 0, count - 1 do
		local index = (start + offset - 1) % count + 1
		local voice = list[index]
		if not voice.Sound.IsPlaying then
			chosen = voice
			if is3D then
				next3D = index % count + 1
			else
				next2D = index % count + 1
			end
			break
		end
		if not oldest or voice.StartedAt < oldest.StartedAt then
			oldest = voice
		end
	end
	return chosen or oldest -- alle belegt: die älteste Stimme wird übernommen
end

local function configure(voice: Voice, layer: Layer, group: SoundGroup?, volume: number, speed: number)
	local sound = voice.Sound
	if sound.SoundId ~= layer.File then
		sound.SoundId = layer.File
	end
	sound.SoundGroup = group
	local jitter = layer.Jitter or 0
	local pitch = layer.Speed * speed
	if jitter > 0 then
		pitch *= 1 + random:NextNumber(-jitter, jitter)
	end
	sound.PlaybackSpeed = math.clamp(pitch, 0.1, 8)
	sound.Volume = math.clamp(layer.Vol * volume, 0, 3)
	local region = layer.Region
	if region then
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(region[1], region[2])
	elseif sound.PlaybackRegionsEnabled then
		sound.PlaybackRegionsEnabled = false
	end
	sound.RollOffMaxDistance = layer.Range or DEFAULT_RANGE
	-- Effekte: nur einschalten, was die Schicht braucht (keine neuen Instanzen)
	local dist = layer.Dist
	voice.Dist.Enabled = dist ~= nil
	if dist then
		voice.Dist.Level = dist
	end
	local hasEq = layer.EqLow ~= nil or layer.EqMid ~= nil or layer.EqHigh ~= nil
	voice.Eq.Enabled = hasEq
	if hasEq then
		voice.Eq.LowGain = layer.EqLow or 0
		voice.Eq.MidGain = layer.EqMid or 0
		voice.Eq.HighGain = layer.EqHigh or 0
	end
	local echo = layer.Echo
	voice.Echo.Enabled = echo ~= nil
	if echo then
		voice.Echo.Delay = echo.Delay
		voice.Echo.Feedback = echo.Feedback
		voice.Echo.WetLevel = echo.Wet
		voice.Echo.DryLevel = 0
	end
end

local function playLayer(layer: Layer, groupName: string, pos: Vector3?, volume: number, speed: number)
	local is3D = pos ~= nil
	local voice = pickVoice(if is3D then voices3D else voices2D, is3D)
	if not voice then
		return
	end
	if voice.Sound.IsPlaying then
		voice.Sound:Stop()
	end
	configure(voice, layer, groups[groupName], volume, speed)
	local attachment = voice.Attachment
	if attachment and pos then
		attachment.WorldPosition = pos
	end
	voice.StartedAt = os.clock()
	voice.Sound.TimePosition = if layer.Region then layer.Region[1] else 0
	voice.Sound:Play()
end

-- Eigene Audio-ID aus der Config (0 = eingebautes Rezept)
local function customId(role: string): number
	local config = ctx and ctx.Config
	local sounds = config and config.Client and config.Client.Sounds
	local id = sounds and sounds[role]
	if type(id) == "number" and id > 0 and id % 1 == 0 then
		return id
	end
	return 0
end

local customRecipes: { [string]: Recipe } = {}
local function recipeFor(role: string): Recipe?
	local id = customId(role)
	if id > 0 then
		local cached = customRecipes[role]
		local path = "rbxassetid://" .. tostring(id)
		if not cached or cached.Layers[1].File ~= path then
			local base = RECIPES[role]
			cached = {
				Group = if base then base.Group elseif MUSIC_ROLES[role] then "MUSIC" else "SFX",
				Layers = { { File = path, Speed = 1, Vol = 0.6, Jitter = if base then base.Layers[1].Jitter else nil } },
			}
			customRecipes[role] = cached
		end
		return cached
	end
	return RECIPES[role]
end

function Sfx.Has(role: string): boolean
	return type(role) == "string" and recipeFor(role) ~= nil
end

function Sfx.Play(role: string, pos: Vector3?, opts: { Volume: number?, Speed: number? }?)
	if type(role) ~= "string" or MUSIC_ROLES[role] or LOOP_ROLES[role] then
		return
	end
	local recipe = recipeFor(role)
	if not recipe then
		local now = os.clock()
		if now - (warnedRole[role] or -math.huge) > WARN_GAP then
			warnedRole[role] = now
			warn("[Sfx] Unbekannte Sound-Rolle: " .. role)
		end
		return
	end
	local now = os.clock()
	local dedupeKey = if pos then role .. "@3d" else role
	if now - (lastPlayed[dedupeKey] or -math.huge) < DEDUPE_GAP then
		return
	end
	lastPlayed[dedupeKey] = now
	if pos ~= nil and typeof(pos) ~= "Vector3" then
		pos = nil
	end
	local volume = 1
	local speed = 1
	if type(opts) == "table" then
		if type(opts.Volume) == "number" and opts.Volume == opts.Volume then
			volume = math.clamp(opts.Volume, 0, 3)
		end
		if type(opts.Speed) == "number" and opts.Speed == opts.Speed then
			speed = math.clamp(opts.Speed, 0.25, 4)
		end
	end
	for _, layer in ipairs(recipe.Layers) do
		local delay = layer.Delay or 0
		if delay > 0 then
			task.delay(delay, playLayer, layer, recipe.Group, pos, volume, speed)
		else
			playLayer(layer, recipe.Group, pos, volume, speed)
		end
	end
end

-- Dauer-Ton (z. B. Motor): eigener Sound am parent (BasePart/Attachment = 3D, sonst 2D). Stop() räumt auf.
function Sfx.Loop(role: string, parent: Instance?): LoopHandle?
	if type(role) ~= "string" then
		return nil
	end
	local recipe = recipeFor(role)
	if not recipe or loopCount >= MAX_LOOPS then
		return nil
	end
	local layer = recipe.Layers[1]
	local host: Instance = SoundService
	if typeof(parent) == "Instance" and (parent:IsA("BasePart") or parent:IsA("Attachment")) then
		host = parent
	end
	local sound = Instance.new("Sound")
	sound.Name = "AT_Loop_" .. role
	sound.SoundId = layer.File
	sound.Looped = true
	sound.SoundGroup = groups[recipe.Group]
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = MIN_RANGE
	sound.RollOffMaxDistance = layer.Range or DEFAULT_RANGE
	sound.PlaybackSpeed = layer.Speed
	sound.Volume = layer.Vol
	if layer.EqLow or layer.EqMid or layer.EqHigh then
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = layer.EqLow or 0
		eq.MidGain = layer.EqMid or 0
		eq.HighGain = layer.EqHigh or 0
		eq.Parent = sound
	end
	sound.Parent = host
	sound:Play()
	loopCount += 1
	local stopped = false
	local baseSpeed = layer.Speed
	local baseVol = layer.Vol
	local function stop()
		if stopped then
			return
		end
		stopped = true
		loopCount = math.max(0, loopCount - 1)
		sound:Stop()
		sound:Destroy()
	end
	-- Träger verschwindet (Auto weg, gestreamt): Loop mit aufräumen
	sound.Destroying:Once(function()
		if not stopped then
			stopped = true
			loopCount = math.max(0, loopCount - 1)
		end
	end)
	return {
		Sound = sound,
		SetSpeed = function(mult: number)
			if not stopped and type(mult) == "number" and mult == mult then
				sound.PlaybackSpeed = math.clamp(baseSpeed * mult, 0.1, 4)
			end
		end,
		SetVolume = function(volume: number)
			if not stopped and type(volume) == "number" and volume == volume then
				sound.Volume = math.clamp(baseVol * volume, 0, 3)
			end
		end,
		Stop = stop,
	}
end

-- Welt-/Effekt-Sounds und Musik kurz leiser (Oberfläche bleibt) – z. B. während der Glocke oder einer Ansage
function Sfx.Duck(amount: number, seconds: number)
	if type(amount) ~= "number" or type(seconds) ~= "number" or amount ~= amount or seconds ~= seconds then
		return
	end
	duckToken += 1
	local token = duckToken
	duckFactor = 1 - math.clamp(amount, 0, 0.9)
	applyGroupVolumes()
	task.delay(math.clamp(seconds, 0.01, 10), function()
		if duckToken == token then
			duckFactor = 1
			applyGroupVolumes()
		end
	end)
end

-- Musik: nur mit eingetragener ID (Config.Client.Sounds.Music bzw. Music<kind>); nil = aus
function Sfx.SetMusic(kind: string?)
	local music = musicSound
	if not music then
		return
	end
	local id = 0
	if type(kind) == "string" and kind ~= "" then
		id = customId("Music" .. kind)
		if id == 0 then
			id = customId("Music")
		end
	end
	if id == 0 then
		musicKind = nil
		if music.IsPlaying then
			music:Stop()
		end
		return
	end
	local path = "rbxassetid://" .. tostring(id)
	if musicKind == kind and music.IsPlaying and music.SoundId == path then
		return
	end
	musicKind = kind
	music.SoundId = path
	music.TimePosition = 0
	music:Play()
end

local function settingNumber(settings: any, key: string, fallback: number): number
	local value = settings and settings[key]
	if type(value) == "number" and value == value then
		return math.clamp(value, 0, 1)
	end
	return fallback
end

function Sfx.ApplySettings(settings: { [string]: any }?)
	baseVolume.SFX = settingNumber(settings, "Sfx", 1)
	baseVolume.UI = settingNumber(settings, "Ui", 0.8)
	baseVolume.MUSIC = settingNumber(settings, "Music", 0.5)
	applyGroupVolumes()
end

function Sfx.Init(context: any)
	ctx = context
	build()
	local settingsModule = ctx.Modules and ctx.Modules.Settings
	if settingsModule and type(settingsModule.Get) == "function" then
		local ok, settings = pcall(settingsModule.Get)
		if ok then
			Sfx.ApplySettings(settings)
		end
	else
		local config = ctx.Config
		Sfx.ApplySettings(config and config.Client and config.Client.DefaultSettings or nil)
	end
	ctx.Hooks.On("Settings", function(settings)
		Sfx.ApplySettings(settings)
	end)
	-- Ansagen und Glocke: Welt kurz leiser
	ctx.Hooks.On("Effect:Announce", function()
		Sfx.Duck(0.5, 1.5)
	end)
end

function Sfx.Start()
	task.spawn(preload)
	Sfx.SetMusic("World")
	if anchorPart and anchorPart.Parent == nil then
		anchorPart.Parent = workspace
	end
end

return Sfx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="154">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Shop-Fenster, Angebots-Karte, Chat-Tags (Client/Modules/Shop)
--  Besitzer: WP10 (Monetarisierung, Shop, CR-Konto). Vertrag: DESIGN.md §C7.5 (Shop.Open, Shop.ShowOffer), §C7.3
--  (Fenster "Shop"), §B14 (Pässe, Produkte, Abo, ehrliche Wirkungstexte, "Zusammen x4", Paket-Erkennung, Live-Preise),
--  §B14.4 + Muss-Regel 17 (max. 1 Angebot je Sitzung, nie während Terminal/Order-Ticket/Tutorial/Willkommen-Bericht/
--  Crash-Rally-Warnung/Admin-Abuse; Knöpfe "Ansehen"/"Details"/"Preis anzeigen", nie Kaufdruck).
--
--  Der Server entscheidet alles (Preise, Besitz, Policy, Gewährung). Dieses Modul zeigt nur den State
--  (Passes, Club, Boosts, Offers, RandomAllowed, TradingAllowed, Starter, Credits, Tower) und schickt Absichten:
--  ShopQuote {Key} (Bau-Gutschein-Angebot, 10 min), ShopPrecheck {Key, UserId?} (vor jedem Roblox-Kaufdialog),
--  ShopClubClaim {} (Club-Tagesgabe). Live-Preise kommen IMMER aus dem Marktplatz (UI.FetchPrice), Id 0 = "Bald verfügbar".
--  Kopf-Banner: "Kurse kann man nicht kaufen – alles Spielgeld". Vor jedem Kauf: "Details" mit der exakten Wirkung.
--  Look: AKYTEX-Glas (Surface2-Karten, 1-px-Rahmen, Akzent nur als Streifen/Rahmen), Robux-Knopf = Premium-Verlauf.
--
--  Öffentliche API (§C7.5):
--    Shop.Open(tab?)        tab ∈ "Start" | "Passes" | "Boosts" | "Credits" | "Season" | "Club" (+ Aliase wie "Starter")
--                           oder ein Artikel-Schlüssel (öffnet dessen Details)
--    Shop.ShowOffer(key)    ruhige Angebots-Karte (Knöpfe "Ansehen" / "Später"); normalerweise vom State "Offers" ausgelöst
--    Shop.Init(ctx) · Shop.Start()
--  Chat-Tags [VIP]/[Club] (TextChatService.OnIncomingMessage, nur Anzeige) aus den Player-Attributen Vip/Club.
-- =====================================================================

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Lang = require(Shared:WaitForChild("Lang"))
local Format = require(Shared:WaitForChild("Format"))
local AssetSlot = require(Shared:WaitForChild("AssetSlot"))

local Shop = {}

local Theme = UI.Theme
local player = Players.LocalPlayer
local SHOP: any = Config.Shop
local SUB: any = SHOP.Subscription or {}
local WHITE = Color3.new(1, 1, 1)

-- ---------------------------------------------------------------------
-- KONSTANTEN
-- ---------------------------------------------------------------------
local WINDOW_W, WINDOW_H = 900, 640
local SHEET_H = 600
local CARD_W, CARD_H = 200, 206
local DETAIL_TEXT = 17
local TICK_MAX = 36000 -- Countdown-Schleife höchstens so viele Sekunden je Öffnung
local OFFER_AUTO_HIDE = 25 -- Angebots-Karte verschwindet von selbst
local OFFER_CHECK_GAP = 2 -- so oft prüft der Client, ob gerade ein ruhiger Moment ist
local RENDER_DELAY = 0.25 -- State-Änderungen bündeln
local MAX_GIFT_TARGETS = 9
local MARKET_EVENT_HOLD = 300 -- nach Warnung/Lauf eines Markt-Events so lange kein Angebot
local MARKET_EVENT_TAIL = 60 -- nach dem Ende eines Markt-Events noch so lange ruhig bleiben
local QUOTE_RETRY_GAP = 1.1 -- ShopQuote ist auf 1/s begrenzt (§C9)

local TABS = { "Start", "Passes", "Boosts", "Credits", "Season", "Club" }
local TAB_LANG: { [string]: string } = {
	Start = "shop.tab.start",
	Passes = "shop.tab.passes",
	Boosts = "shop.tab.boosts",
	Credits = "shop.tab.credits",
	Season = "shop.tab.season",
	Club = "shop.tab.club",
}
local TAB_ALIASES: { [string]: string } = {
	Featured = "Start",
	Home = "Start",
	Pass = "Passes",
	GamePasses = "Passes",
	Robux = "Passes",
	Boost = "Boosts",
	Vouchers = "Credits",
	CR = "Credits",
	Build = "Credits",
	SeasonPass = "Season",
	Subscription = "Club",
}
local INCOME_PASSES = { "Income2x", "Income3x", "TycoonBundle" }
local KIND_COLORS: { [string]: Color3 } = {
	Pass = Theme.Accent,
	Boost = Theme.Up,
	Parade = Theme.Gold,
	Voucher = Theme.Up,
	Express = Theme.Cyan,
	Fireworks = Theme.Pink,
	Starter = Theme.Warn,
	Season = Theme.Purple,
	Tiers = Theme.Purple,
	Gift = Theme.Pink,
	Subscription = Theme.Cosmic2,
}

-- ---------------------------------------------------------------------
-- ZUSTAND
-- ---------------------------------------------------------------------
type Dynamic = { Label: TextLabel, Fn: () -> string }
type QuoteInfo = { Key: string, Credits: number, Until: number }

local ctx: any = nil
local window: any = nil
local tabs: any = nil
local body: Frame? = nil
local builtLang = ""
local currentTab = "Start"
local pendingTab: string? = nil
local pendingDetail: string? = nil
local renderQueued = false
local tickToken = 0
local dynamics: { Dynamic } = {}
local detailDynamics: { Dynamic } = {}
local livePrices: { [string]: number } = {}
local subPrice: string? = nil
local subPriceStarted = false
local subPriceDone = false -- Anfrage beendet (ohne Anzeigepreis -> "Preis anzeigen", der Roblox-Dialog zeigt ihn)
local pending = false
local shopSeenSent = false

-- Detail-Dialog
local detailFrame: Frame? = nil
local detailTitle: TextLabel? = nil
local detailAccent: Frame? = nil
local detailList: ScrollingFrame? = nil
local detailButtons: Frame? = nil
local detailKey: string? = nil
local detailScale: UIScale? = nil -- federndes Aufklappen der Details (iOS-artig)
local giftChoice: number? = nil
local quote: QuoteInfo? = nil
local quoteLoading = false
local quoteFailed: string? = nil -- nach einer abgelehnten Angebots-Anfrage nicht automatisch erneut fragen

-- Angebote
local offerCard: Frame? = nil
local offerToken = 0
local lastOfferId = 0
local marketBusyUntil = 0

-- Neuaufbau nur bei echter Layout-Änderung (der volle State alle 20 s baut sonst jedes Mal alles neu: Flackern)
local renderedSig = ""
-- Zeitpunkt des letzten Boosts-States (die Restzeit zählt ab hier herunter, nicht ab irgendeinem State)
local boostsAt = 0

-- =====================================================================
-- 1) HELFER
-- =====================================================================
local function lang(): "de" | "en"
	local ok, value = pcall(function()
		return ctx.Lang_()
	end)
	return if ok and value == "de" then "de" else "en"
end

local function T(key: string, ...: any): string
	return Lang.T(lang(), key, ...)
end

local function pick(pair: any): string
	return if type(pair) == "table" then Lang.Pick(lang(), pair) else tostring(pair or "")
end

local function state(): { [string]: any }
	return if ctx and type(ctx.State) == "table" then ctx.State else {}
end

local function offers(): { [string]: any }
	local value = state().Offers
	return if type(value) == "table" then value else {}
end

local function num(value: any, default: number): number
	return if type(value) == "number"
			and value == value
			and value ~= math.huge
			and value ~= -math.huge
		then value
		else default
end

local function credits(n: number): string
	return Format.Credits(num(n, 0), lang())
end

local function duration(seconds: number): string
	return Format.Duration(math.max(0, num(seconds, 0)), lang())
end

local function mult(x: number): string
	return Format.Mult(num(x, 1), lang())
end

local function int(n: number): string
	return Format.Int(num(n, 0), lang())
end

local function clockNow(): number
	local clock = ctx and ctx.Clock
	if clock and type(clock.Now) == "function" then
		local ok, value = pcall(clock.Now)
		if ok and type(value) == "number" then
			return value
		end
	end
	return workspace:GetServerTimeNow()
end

local function callModule(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local module = modules and modules[name]
	local fn = module and module[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function sfx(role: string)
	callModule("Sfx", "Play", role)
end

local function toast(text: string, kind: string?)
	if ctx and type(ctx.Toast) == "function" then
		ctx.Toast(text, kind)
	end
end

local function hasPass(key: string): boolean
	local passes = state().Passes
	return type(passes) == "table" and passes[key] == true
end

local function isClub(): boolean
	return state().Club == true
end

local function tradingAllowed(): boolean
	return state().TradingAllowed == true
end

local function passFactor(): number
	return 1 + (if hasPass("Income2x") then 1 else 0) + (if hasPass("Income3x") then 2 else 0)
end

local function towerMult(key: string, default: number): number
	local tower = Config.Tower
	local values = type(tower) == "table" and tower.Mult or nil
	local value = type(values) == "table" and values[key] or nil
	if type(value) == "number" and value >= 1 then
		return value
	end
	local fixed = SHOP.Fixed
	return num(type(fixed) == "table" and fixed[key] or nil, default)
end

local function isPremiumMember(): boolean
	local ok, result = pcall(function(): boolean
		return player.MembershipType == Enum.MembershipType.Premium
	end)
	return ok and result == true
end

local function fixedFactor(): number
	local factor = 1
	if hasPass("VIP") then
		factor *= towerMult("Vip", 1.10)
	end
	if isClub() then
		factor *= towerMult("Club", 1.15)
	end
	if isPremiumMember() then
		factor *= towerMult("Premium", 1.10)
	end
	return factor
end

-- Artikel + Art ("Pass" | "Product" | "Subscription")
local function itemOf(key: string): (any, string?)
	if type(key) ~= "string" then
		return nil, nil
	end
	local pass = SHOP.PassesByKey[key]
	if pass then
		return pass, "Pass"
	end
	local product = SHOP.ProductsByKey[key]
	if product then
		return product, "Product"
	end
	if key == SUB.Key then
		return SUB, "Subscription"
	end
	return nil, nil
end

local function kindKey(entry: any, kind: string): string
	if kind == "Product" and type(entry.Kind) == "string" then
		return entry.Kind
	end
	return kind
end

local function accentFor(entry: any, kind: string): Color3
	return KIND_COLORS[kindKey(entry, kind)] or Theme.Accent
end

local function configured(entry: any, kind: string): boolean
	if kind == "Subscription" then
		return type(entry.Id) == "string" and entry.Id ~= ""
	end
	return type(entry.Id) == "number" and entry.Id > 0
end

local function isDisabled(key: string): boolean
	local live = offers().Disabled
	if type(live) == "table" and live[key] == true then
		return true
	end
	return type(SHOP.Disabled) == "table" and SHOP.Disabled[key] == true
end

local function tabOf(key: string): string
	local entry, kind = itemOf(key)
	if kind == "Pass" then
		return "Passes"
	elseif kind == "Subscription" then
		return "Club"
	elseif kind == "Product" then
		local k = entry.Kind
		if k == "Voucher" or k == "Express" then
			return "Credits"
		elseif k == "Season" or k == "Tiers" then
			return "Season"
		elseif k == "Starter" then
			return "Start"
		end
		return "Boosts"
	end
	return "Start"
end

-- erster Satz einer Beschreibung (Karten zeigen nur den Kern, die Details alles)
local function firstSentence(text: string): string
	local sentence = string.match(text, "^(.-[%.!])%s")
	return sentence or text
end

local function addDynamic(list: { Dynamic }, label: TextLabel, fn: () -> string)
	table.insert(list, { Label = label, Fn = fn })
	local ok, text = pcall(fn)
	if ok and type(text) == "string" then
		label.Text = text
	end
end

local function updateDynamics(list: { Dynamic })
	for _, entry in ipairs(list) do
		if entry.Label.Parent ~= nil then
			local ok, text = pcall(entry.Fn)
			if ok and type(text) == "string" and entry.Label.Text ~= text then
				entry.Label.Text = text
			end
		end
	end
end

local function clearChildren(frame: Instance)
	for _, child in ipairs(frame:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UIGridLayout") then
			child:Destroy()
		end
	end
end

-- Restzeit des stärksten persönlichen Boosts (Spielsekunden, seit dem letzten State heruntergezählt)
local function boostInfo(): (string?, number, number)
	local boosts = state().Boosts
	if type(boosts) ~= "table" then
		return nil, 0, 0
	end
	local since = if boostsAt > 0 then boostsAt else num(ctx and ctx.StateTime, os.clock())
	local elapsed = math.max(0, os.clock() - since)
	local x5 = math.max(0, num(boosts.X5, 0) - elapsed)
	local x2 = num(boosts.X2, 0)
	if x5 > 0 then
		return "x5", x5, x2
	end
	x2 = math.max(0, x2 - elapsed)
	if x2 > 0 then
		return "x2", x2, 0
	end
	return nil, 0, 0
end

local function paradeLeft(): number
	return math.max(0, num(offers().Parade, 0) - clockNow())
end

-- Ende der aktuellen Saison (Unix): Config.Season inkl. Rolling-Regel
local function seasonEnd(): number?
	local season = Config.Season
	local list = type(season) == "table" and season.Seasons or nil
	if type(list) ~= "table" or #list == 0 then
		return nil
	end
	local t = clockNow()
	local id = SHOP.SeasonIdAt(season, t)
	local last = list[#list]
	for index, entry in ipairs(list) do
		if type(entry) == "table" and entry.Id == id then
			local ends = SHOP.ParseUtc(entry.EndUtc)
			local following = list[index + 1]
			if ends and ends <= t and type(following) == "table" then
				-- Lücke bis zur nächsten festen Saison: die vorige gilt weiter, ehrliches Ende = Start der nächsten
				return SHOP.ParseUtc(following.StartUtc) or ends
			end
			return ends
		end
	end
	local lastEnd = SHOP.ParseUtc(last.EndUtc)
	local rolling = season.Rolling
	if lastEnd and type(rolling) == "table" and type(last.Id) == "number" then
		local length = num(rolling.LengthDays, 28) * 86400
		return lastEnd + (id - last.Id) * length
	end
	return lastEnd
end

local function nextUtcMidnight(): number
	return (math.floor(clockNow() / 86400) + 1) * 86400
end

-- =====================================================================
-- 2) LIVE-PREISE (immer vom Marktplatz, nie hart kodiert)
-- =====================================================================
local function fetchSubscriptionPrice()
	if subPriceStarted or type(SUB.Id) ~= "string" or SUB.Id == "" then
		return
	end
	subPriceStarted = true
	task.spawn(function()
		local ok, info = pcall(MarketplaceService.GetSubscriptionProductInfoAsync, MarketplaceService, SUB.Id)
		if ok and type(info) == "table" and type(info.DisplayPrice) == "string" and info.DisplayPrice ~= "" then
			subPrice = info.DisplayPrice
		end
		subPriceDone = true
	end)
end

-- Preis-Text in ein Label schreiben (asynchron); Label weg -> nichts
local function setPrice(label: TextLabel, entry: any, kind: string)
	if not configured(entry, kind) then
		label.Text = T("shop.notSetUp")
		return
	end
	if kind == "Subscription" then
		fetchSubscriptionPrice()
		if subPrice then
			label.Text = T("shop.priceMonth", subPrice)
		else
			label.Text = if subPriceDone then T("shop.showPrice") else T("shop.loadingPrice")
			if not subPriceDone then
				-- nach der Antwort einmal nachtragen (Label kann inzwischen weg sein)
				task.delay(3, function()
					if label.Parent ~= nil and (subPrice or subPriceDone) then
						label.Text = if subPrice then T("shop.priceMonth", subPrice) else T("shop.showPrice")
					end
				end)
			end
		end
		return
	end
	local cached = livePrices[entry.Key]
	if cached then
		label.Text = T("shop.price", int(cached))
		return
	end
	label.Text = T("shop.loadingPrice")
	local infoType = if kind == "Pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
	UI.FetchPrice(entry.Id, infoType, function(price: number?)
		if price then
			livePrices[entry.Key] = price
		end
		if label.Parent ~= nil then
			label.Text = if price then T("shop.price", int(price)) else T("shop.notSetUp")
		end
	end)
end

-- Einzelpreise der Paket-Teile laden (für den echten Rabatt aus Live-Preisen)
local function prefetchBundle(bundle: any)
	if type(bundle) ~= "table" or type(bundle.Includes) ~= "table" then
		return
	end
	local keys = table.clone(bundle.Includes)
	table.insert(keys, bundle.Key)
	for _, key in ipairs(keys) do
		local pass = SHOP.PassesByKey[key]
		if pass and configured(pass, "Pass") and livePrices[key] == nil then
			UI.FetchPrice(pass.Id, Enum.InfoType.GamePass, function(price: number?)
				if price then
					livePrices[key] = price
				end
			end)
		end
	end
end

local function bundleSaveText(bundle: any): string?
	local price = livePrices[bundle.Key]
	if not price then
		return nil
	end
	local single = 0
	for _, key in ipairs(bundle.Includes) do
		local part = livePrices[key]
		if not part then
			return nil
		end
		single += part
	end
	local pct = SHOP.BundleDiscountPct(bundle.Key, single, price)
	if pct <= 0 then
		return nil -- kein echter Rabatt -> keine Rabatt-Zeile (keine Fake-Rabatte)
	end
	return T("shop.bundleSave", int(single), int(price), pct)
end

local function partNames(keys: { string }): string
	local names: { string } = {}
	for _, key in ipairs(keys) do
		local part = SHOP.PassesByKey[key]
		table.insert(names, if part then pick(part.Name) else key)
	end
	return table.concat(names, ", ")
end

local function bundleParts(bundle: any): ({ string }, { string })
	local ownedParts, missing = {}, {}
	for _, key in ipairs(bundle.Includes or {}) do
		if hasPass(key) then
			table.insert(ownedParts, key)
		else
			table.insert(missing, key)
		end
	end
	return ownedParts, missing
end

-- =====================================================================
-- 3) KAUF (Vorprüfung am Server, dann der Roblox-Kaufdialog)
-- =====================================================================
local function closeDetail()
	detailKey = nil
	quote = nil
	giftChoice = nil
	table.clear(detailDynamics)
	if detailFrame then
		detailFrame.Visible = false
	end
end

local function prompt(reply: { [string]: any })
	local id = reply.Id
	local ok, err = pcall(function()
		if reply.Kind == "Pass" and type(id) == "number" then
			MarketplaceService:PromptGamePassPurchase(player, id)
		elseif reply.Kind == "Subscription" and type(id) == "string" then
			MarketplaceService:PromptSubscriptionPurchase(player, id)
		elseif type(id) == "number" then
			MarketplaceService:PromptProductPurchase(player, id)
		end
	end)
	if not ok then
		warn("[Shop] Kaufdialog: " .. tostring(err))
		toast(T("core.error"), "Error")
	end
end

local function purchase(key: string, userId: number?)
	if pending then
		return
	end
	pending = true
	task.spawn(function()
		local arg: { [string]: any } = { Key = key }
		if userId then
			arg.UserId = userId
		end
		local ok, reply = pcall(function()
			return ctx.RequestFull("ShopPrecheck", arg, true)
		end)
		pending = false
		if not ok or type(reply) ~= "table" then
			toast(T("core.noAnswer"), "Error")
			return
		end
		if not reply.Ok then
			sfx("UIError")
			toast(
				if type(reply.Message) == "string" and reply.Message ~= "" then reply.Message else T("core.error"),
				"Error"
			)
			return
		end
		sfx("UIClick")
		prompt(reply)
	end)
end

local renderDetail: () -> () -- vorwärts deklariert
local openDetail: (key: string) -> () -- vorwärts deklariert

local function requestQuote(key: string)
	if quoteLoading then
		return
	end
	quoteLoading = true
	task.spawn(function()
		local ok, reply = pcall(function()
			return ctx.RequestFull("ShopQuote", { Key = key }, true)
		end)
		quoteLoading = false
		if detailKey ~= key then
			-- inzwischen ein anderer Gutschein offen: nach der Anfrage-Grenze (1/s) dessen Angebot holen
			local current = detailKey
			if current ~= nil then
				task.delay(QUOTE_RETRY_GAP, function()
					if detailKey == current and quote == nil and not quoteLoading and quoteFailed ~= current then
						renderDetail()
					end
				end)
			end
			return
		end
		if
			ok
			and type(reply) == "table"
			and reply.Ok
			and type(reply.Credits) == "number"
			and type(reply.Until) == "number"
		then
			quote = { Key = key, Credits = reply.Credits, Until = reply.Until }
			quoteFailed = nil
		else
			quoteFailed = key
			if ok and type(reply) == "table" and type(reply.Message) == "string" and reply.Message ~= "" then
				toast(reply.Message, "Error")
			end
		end
		renderDetail()
	end)
end

local function claimClub()
	if pending then
		return
	end
	pending = true
	task.spawn(function()
		local ok, reply = pcall(function()
			return ctx.RequestFull("ShopClubClaim", {}, true)
		end)
		pending = false
		if not ok or type(reply) ~= "table" then
			toast(T("core.noAnswer"), "Error")
			return
		end
		if type(reply.Message) == "string" and reply.Message ~= "" then
			toast(reply.Message, if reply.Ok then "Success" else "Error")
		end
		if reply.Ok then
			sfx("CashRegister")
			callModule("Hud", "PulseCredits", reply.Credits)
		else
			sfx("UIError")
		end
	end)
end

-- =====================================================================
-- 4) BAUSTEINE (Karten, Abschnitte, Hinweise)
-- =====================================================================
local function section(parent: Instance, text: string, order: number, color: Color3?)
	UI.Section(parent, text, order, color)
end

local function note(parent: Instance, text: string, order: number, color: Color3?): TextLabel
	return UI.Create("TextLabel", {
		Name = "Note",
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Body,
		TextSize = 15,
		TextColor3 = color or Theme.Text2,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = text,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function grid(parent: Instance, order: number): Frame
	return UI.Grid(parent, order, CARD_W, CARD_H)
end

-- runde Plakette mit Glyphe (Code-Grafik; ImageId ≠ 0 -> Bild aus dem Asset-Platz)
local function iconBadge(parent: Instance, entry: any, color: Color3, size: number, position: UDim2): Frame
	local badge: Frame = UI.Create("Frame", {
		Name = "Icon",
		Position = position,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = WHITE, -- der Verlauf liefert die Farbe (UIGradient multipliziert)
		BorderSizePixel = 0,
		Parent = parent,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.Gradient(color:Lerp(WHITE, 0.18), color:Lerp(Theme.Bg, 0.45), 120),
		UI.Create("UIStroke", { Color = color:Lerp(WHITE, 0.35), Thickness = 1, Transparency = 0.35 }),
	})
	-- Hybrid-Asset-Platz (§C14.3): ImageId ≠ 0 -> Bild, sonst (oder bei Fehler) Code-Grafik
	local image = AssetSlot.Image(num(entry.ImageId, 0), "")
	if image ~= "" then
		UI.Create("ImageLabel", {
			Size = UDim2.fromScale(0.72, 0.72),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundTransparency = 1,
			Image = image,
			Parent = badge,
		})
	else
		UI.Label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.74, 0.5),
			Text = tostring(entry.Icon or "Λ"),
			Face = "Display",
			TextColor3 = WHITE,
			MaxText = math.floor(size * 0.45),
			Parent = badge,
		})
	end
	return badge
end

type CardOpts = {
	Lines: { { Text: string?, Fn: (() -> string)?, Color: Color3? } }?,
	Highlight: boolean?,
	Status: string?,
}

-- Artikel-Karte im Raster: Plakette, Art-Chip, Name, bis zu 2 Zeilen, Preis, Knopf "Details"
local function itemCard(parent: Instance, order: number, key: string, opts: CardOpts?): Frame?
	local entry, kind = itemOf(key)
	if entry == nil or kind == nil then
		return nil
	end
	local options: CardOpts = opts or {}
	local color = accentFor(entry, kind)
	local frame = UI.Card({ Size = UDim2.fromOffset(CARD_W, CARD_H), LayoutOrder = order, Parent = parent })
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if stroke and options.Highlight then
		stroke.Color = color
		stroke.Transparency = 0.35
	end
	UI.Create("Frame", {
		Name = "Stripe",
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -28, 0, 3),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = frame,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	iconBadge(frame, entry, color, 40, UDim2.fromOffset(12, 14))
	UI.Chip(frame, T("item.kind." .. kindKey(entry, kind)), color, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 16),
	})
	if options.Status then
		UI.Chip(frame, options.Status, Theme.Up, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 40),
		})
	end
	UI.Label({
		Name = "Title",
		Position = UDim2.fromOffset(12, 62),
		Size = UDim2.new(1, -24, 0, 36),
		Text = pick(entry.Name),
		Font = UI.Fonts.Main,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		MaxText = 17,
		Parent = frame,
	})
	local lines = options.Lines or { { Text = firstSentence(pick(entry.Desc)) } }
	for i, line in ipairs(lines) do
		if i > 2 then
			break
		end
		local label = UI.Label({
			Name = "Line" .. i,
			Position = UDim2.fromOffset(12, 98 + (i - 1) * 22),
			Size = UDim2.new(1, -24, 0, 21),
			Text = line.Text or "",
			Font = if line.Color then UI.Fonts.Main else UI.Fonts.Body,
			TextColor3 = line.Color or Theme.Text2,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			MaxText = 13,
			Parent = frame,
		})
		if line.Fn then
			addDynamic(dynamics, label, line.Fn)
		end
	end
	local price = UI.Label({
		Name = "Price",
		Position = UDim2.fromOffset(12, 142),
		Size = UDim2.new(1, -24, 0, 16),
		Text = "",
		Face = "MonoBold",
		TextColor3 = Theme.Warn,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 13,
		Parent = frame,
	})
	setPrice(price, entry, kind)
	UI.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -20, 0, 32),
		Text = T("shop.details"),
		Variant = if isDisabled(key) then "Muted" else "Secondary",
		MaxText = 15,
		Corner = 10,
		Parent = frame,
	}, function()
		openDetail(key)
	end)
	-- sanftes Anheben beim Darüberfahren (nur Rahmen, kein Layout-Sprung)
	if stroke then
		local rest = stroke.Transparency
		frame.MouseEnter:Connect(function()
			TweenService:Create(stroke, TweenInfo.new(0.12), { Color = color, Transparency = 0.25 }):Play()
		end)
		frame.MouseLeave:Connect(function()
			TweenService:Create(stroke, TweenInfo.new(0.12), {
				Color = if options.Highlight then color else Theme.Border,
				Transparency = rest,
			}):Play()
		end)
	end
	return frame
end

-- breite Info-Karte (Hinweise wie "x2 + x3 zusammen = x4", aktive Vorteile). Rückgabe: Inhalts-Frame (Liste).
local function infoCard(parent: Instance, order: number, title: string?, lines: { string }, color: Color3): Frame
	local frame = UI.Card({
		Size = UDim2.new(1, -4, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Parent = parent,
	})
	UI.Create("Frame", {
		Name = "Bar",
		Position = UDim2.fromOffset(8, 10),
		Size = UDim2.new(0, 3, 1, -20),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = frame,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local content: Frame = UI.Create("Frame", {
		Name = "Content",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = frame,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }),
		UI.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 22),
			PaddingRight = UDim.new(0, 14),
			PaddingTop = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 10),
		}),
	})
	if title and title ~= "" then
		local titleLabel = note(content, title, 1, Theme.Text)
		titleLabel.FontFace = UI.Faces.BodyBold
		titleLabel.TextSize = 16
	end
	for i, line in ipairs(lines) do
		note(content, line, i + 1, Theme.Text2)
	end
	return content
end

-- =====================================================================
-- 5) REITER
-- =====================================================================
local Builders: { [string]: (root: Frame) -> () } = {}

local function activeLines(): { string }
	local lines: { string } = {}
	-- Gesamt-Multiplikator wie im HUD-Chip (Turm-Einkommen; Aufschlüsselung mit Quelle + Restzeit im HUD)
	local income = state().Income
	local total = if type(income) == "table" then num(income.Mult, 1) else 1
	local base = 0
	if total > 1.0001 then
		table.insert(lines, T("shop.active.total", mult(total)))
		base = 1
	end
	local factor = passFactor()
	if factor > 1 then
		table.insert(lines, T("shop.active.passFactor", mult(factor)))
	end
	local fixed = fixedFactor()
	if fixed > 1.0001 then
		table.insert(lines, T("shop.active.fixed", mult(fixed)))
	end
	if isClub() then
		table.insert(lines, T("shop.active.club"))
	end
	local which, left = boostInfo()
	if which then
		table.insert(lines, T("shop.boost.active", which, duration(left)))
	end
	if paradeLeft() > 0 then
		table.insert(lines, T("shop.parade.active", duration(paradeLeft())))
	end
	if #lines == base then
		table.insert(lines, T("shop.active.none")) -- noch keine gekauften/Server-Vorteile
	end
	return lines
end

Builders.Start = function(root: Frame)
	section(root, T("shop.section.active"), 1, Theme.Up)
	local active = infoCard(root, 2, nil, {}, Theme.Up)
	local activeLabel = note(active, "", 1, Theme.Text)
	addDynamic(dynamics, activeLabel, function(): string
		return table.concat(activeLines(), "\n")
	end)
	section(root, T("shop.section.recommended"), 3, Theme.Warn)
	local cards = grid(root, 4)
	local order = 0
	local starter = state().Starter
	local bought = type(starter) == "table" and starter.Bought == true
	order += 1
	itemCard(cards, order, "Starter", {
		Highlight = not bought,
		Status = if bought then T("shop.owned") else nil,
	})
	local bundle = SHOP.PassesByKey.TycoonBundle
	if bundle then
		prefetchBundle(bundle)
		local _, missing = bundleParts(bundle)
		if #missing > 0 then
			order += 1
			itemCard(cards, order, "TycoonBundle", {
				Lines = {
					{ Text = T("shop.bundleParts", partNames(bundle.Includes)) },
					{
						Fn = function(): string
							return bundleSaveText(bundle) or T("shop.together4")
						end,
						Color = Theme.Up,
					},
				},
			})
		end
	end
	if offers().SeasonPremium ~= true then
		order += 1
		itemCard(cards, order, "SeasonPremium")
	end
	if isClub() or offers().ClubEligible == true then
		order += 1
		itemCard(cards, order, SUB.Key, { Status = if isClub() then T("shop.active") else nil })
	end
	note(root, T("shop.premiumBonus"), 5, Theme.Muted)
end

Builders.Passes = function(root: Frame)
	section(root, T("shop.section.income"), 1, Theme.Accent)
	infoCard(root, 2, T("shop.together4"), { T("shop.togetherNote") }, Theme.Accent)
	local income = grid(root, 3)
	local bundle = SHOP.PassesByKey.TycoonBundle
	prefetchBundle(bundle)
	for i, key in ipairs(INCOME_PASSES) do
		local status = if hasPass(key) then T("shop.owned") else nil
		if key == "TycoonBundle" and bundle then
			local ownedParts, missing = bundleParts(bundle)
			local lines: { { Text: string?, Fn: (() -> string)?, Color: Color3? } } = {}
			if hasPass("TycoonBundle") then
				lines = { { Text = T("shop.bundleParts", partNames(bundle.Includes)) } }
			elseif #missing == 0 then
				lines = { { Text = T("shop.bundleAllOwned"), Color = Theme.Muted } }
			elseif #ownedParts > 0 then
				lines = {
					{ Text = T("shop.bundleOwnedParts", partNames(ownedParts)) },
					{ Text = T("shop.bundleSingles", partNames(missing)), Color = Theme.Warn },
				}
			else
				lines = {
					{ Text = T("shop.bundleParts", partNames(bundle.Includes)) },
					{
						Fn = function(): string
							return bundleSaveText(bundle) or T("shop.robuxNote")
						end,
						Color = Theme.Up,
					},
				}
			end
			itemCard(income, i, key, { Lines = lines, Status = status })
		else
			itemCard(income, i, key, {
				Lines = {
					{ Text = firstSentence(pick(SHOP.PassesByKey[key].Desc)) },
					{ Text = T("shop.together4"), Color = Theme.Accent },
				},
				Status = status,
			})
		end
	end
	section(root, T("shop.section.passes"), 4, Theme.Accent)
	local others = grid(root, 5)
	local order = 0
	for _, pass in ipairs(SHOP.GamePasses) do
		if not table.find(INCOME_PASSES, pass.Key) then
			order += 1
			itemCard(others, order, pass.Key, { Status = if hasPass(pass.Key) then T("shop.owned") else nil })
		end
	end
	note(root, T("shop.firewall"), 6, Theme.Muted)
end

Builders.Boosts = function(root: Frame)
	section(root, T("shop.section.boosts"), 1, Theme.Up)
	local status = note(root, "", 2, Theme.Text2)
	addDynamic(dynamics, status, function(): string
		local which, left, stored = boostInfo()
		if which == "x5" and stored > 0 then
			return T("shop.boost.active", which, duration(left)) .. " · " .. T("shop.boost.paused", duration(stored))
		elseif which then
			return T("shop.boost.active", which, duration(left))
		end
		return T("shop.boost.none")
	end)
	local personal = grid(root, 3)
	for i, key in ipairs({ "Boost2x30", "Boost2x120", "Boost5x10", "GiftBoost" }) do
		itemCard(personal, i, key)
	end
	section(root, T("shop.section.server"), 4, Theme.Gold)
	local server = grid(root, 5)
	itemCard(server, 1, "BullParade", {
		Lines = {
			{ Text = firstSentence(pick(SHOP.ProductsByKey.BullParade.Desc)) },
			{
				Fn = function(): string
					local left = paradeLeft()
					return if left > 0 then T("shop.parade.active", duration(left)) else ""
				end,
				Color = Theme.Gold,
			},
		},
	})
	itemCard(server, 2, "Fireworks")
end

Builders.Credits = function(root: Frame)
	section(root, T("shop.section.vouchers"), 1, Theme.Up)
	note(root, T("shop.onlyCr") .. " · " .. T("shop.quoteHint"), 2, Theme.Text2)
	local vouchers = grid(root, 3)
	for i, key in ipairs({ "CreditsS", "CreditsM", "CreditsL", "CreditsXL" }) do
		itemCard(vouchers, i, key, {
			Lines = {
				{ Text = firstSentence(pick(SHOP.ProductsByKey[key].Desc)) },
				{
					Fn = function(): string
						local preview = offers().Preview
						local value = if type(preview) == "table" then preview[key] else nil
						return T("shop.voucherPreview", credits(num(value, 0)))
					end,
					Color = Theme.Up,
				},
			},
		})
	end
	section(root, T("shop.section.express"), 4, Theme.Cyan)
	local build = note(root, "", 5, Theme.Text2)
	addDynamic(dynamics, build, function(): string
		local tower = state().Tower
		local info = type(tower) == "table" and tower.Build or nil
		if type(info) == "table" and info.Floor ~= nil then
			return T("shop.express.build", duration(num(info.Until, 0) - clockNow()))
		end
		local tokens = type(tower) == "table" and type(tower.Tokens) == "table" and tower.Tokens.Express or 0
		return T("shop.express.token", num(tokens, 0))
	end)
	local express = grid(root, 6)
	for i, key in ipairs({ "ExpressS", "ExpressM", "ExpressL" }) do
		itemCard(express, i, key)
	end
end

Builders.Season = function(root: Frame)
	section(root, T("shop.section.season"), 1, Theme.Purple)
	local ends = note(root, "", 2, Theme.Text2)
	addDynamic(dynamics, ends, function(): string
		local untilT = seasonEnd()
		local prefix = if offers().SeasonPremium == true then T("shop.season.premiumActive") .. " · " else ""
		return prefix .. (if untilT then T("shop.season.ends", duration(untilT - clockNow())) else "")
	end)
	local cards = grid(root, 3)
	itemCard(cards, 1, "SeasonPremium", {
		Status = if offers().SeasonPremium == true then T("shop.season.premiumActive") else nil,
		Highlight = offers().SeasonPremium ~= true,
	})
	itemCard(cards, 2, "SeasonTier1")
	itemCard(cards, 3, "SeasonTier10")
	note(root, T("shop.firewall"), 4, Theme.Muted)
end

Builders.Club = function(root: Frame)
	section(root, T("shop.section.club"), 1, Theme.Cosmic2)
	-- Vorteile einzeln auflisten: getrennt an ", " (Dezimal-Kommas wie "×1,15" haben kein Leerzeichen dahinter)
	local benefits: { string } = {}
	local text = pick(SUB.Desc)
	local start = 1
	for _ = 1, 24 do
		local cut = string.find(text, ", ", start, true)
		local part = string.sub(text, start, if cut then cut - 1 else #text)
		if part ~= "" then
			table.insert(benefits, "• " .. part)
		end
		if not cut then
			break
		end
		start = cut + 2
	end
	infoCard(root, 2, pick(SUB.Name), benefits, Theme.Cosmic2)
	if isClub() then
		local claim = note(root, "", 3, Theme.Up)
		addDynamic(dynamics, claim, function(): string
			local o = offers()
			if num(o.ClubClaimDay, 0) == num(o.Today, -1) then
				return T("shop.club.claimed", duration(nextUtcMidnight() - clockNow()))
			end
			local preview = o.Preview
			local value = if type(preview) == "table" then preview[SUB.DailyVoucher] else nil
			return T("shop.club.claimReady", credits(num(value, 0)))
		end)
		local row = UI.Row(root, 4, 44)
		local o = offers()
		local claimed = num(o.ClubClaimDay, 0) == num(o.Today, -1)
		UI.Button({
			Size = UDim2.fromOffset(240, 40),
			Text = T("shop.club.claim"),
			Variant = if claimed then "Muted" else "Success",
			MaxText = 16,
			Parent = row,
		}, function()
			if not claimed then
				claimClub()
			end
		end)
		note(root, T("shop.club.member"), 5, Theme.Muted)
	elseif offers().ClubEligible == true then
		local cards = grid(root, 3)
		itemCard(cards, 1, SUB.Key, { Highlight = true })
	else
		note(root, T("shop.restricted"), 3, Theme.Muted)
	end
end

-- alles, was den AUFBAU eines Reiters ändert (Besitz, Abo, Starter, Saison, Policy, Notschalter, Sprache);
-- Zahlen wie Boost-Restzeit, Baustelle oder Angebote laufen über die 1-s-Aktualisierung
local function layoutSig(): string
	local s = state()
	local o = offers()
	local parts: { string } = { lang() }
	local passes = s.Passes
	for _, pass in ipairs(SHOP.GamePasses) do
		if type(passes) == "table" and passes[pass.Key] == true then
			table.insert(parts, pass.Key)
		end
	end
	local starter = s.Starter
	table.insert(parts, tostring(s.Club == true))
	table.insert(parts, tostring(type(starter) == "table" and starter.Bought == true))
	table.insert(parts, tostring(o.SeasonPremium == true))
	table.insert(parts, tostring(o.ClubEligible == true))
	table.insert(parts, tostring(s.TradingAllowed == true))
	table.insert(parts, tostring(s.RandomAllowed == true))
	table.insert(parts, tostring(num(o.ClubClaimDay, 0) == num(o.Today, -1)))
	for _, list in ipairs({ SHOP.GamePasses, SHOP.Products }) do
		for _, entry in ipairs(list) do
			if isDisabled(entry.Key) then
				table.insert(parts, "-" .. entry.Key)
			end
		end
	end
	return table.concat(parts, "|")
end

local function render()
	local root = body
	if not root or not window or not window.IsOpen then
		return
	end
	renderedSig = layoutSig()
	table.clear(dynamics)
	clearChildren(root)
	local builder = Builders[currentTab] or Builders.Start
	local ok, err = pcall(builder, root)
	if not ok then
		warn("[Shop] Reiter " .. currentTab .. ": " .. tostring(err))
	end
end

local function queueRender()
	if renderQueued then
		return
	end
	renderQueued = true
	task.delay(RENDER_DELAY, function()
		renderQueued = false
		render()
		if detailKey then
			renderDetail()
		end
	end)
end

-- =====================================================================
-- 6) DETAILS (exakte Wirkung vor jedem Kauf)
-- =====================================================================
local function detailLine(text: string, order: number, color: Color3?, bold: boolean?): TextLabel
	local list = detailList :: ScrollingFrame
	return UI.Create("TextLabel", {
		Name = "Line",
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		FontFace = if bold then UI.Faces.BodyBold else UI.Faces.Body,
		TextSize = DETAIL_TEXT,
		TextColor3 = color or Theme.Text2,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = text,
		LayoutOrder = order,
		ZIndex = 32,
		Parent = list,
	})
end

local function detailButton(
	text: string,
	variant: string,
	order: number,
	width: number,
	onClick: () -> (),
	enabled: boolean?
)
	local buttons = detailButtons :: Frame
	local on = enabled ~= false
	local button = UI.Button({
		Size = UDim2.fromOffset(width, 44),
		Text = text,
		Variant = if on then variant else "Muted",
		MaxText = 16,
		LayoutOrder = order,
		ZIndex = 32,
		Parent = buttons,
	}, function()
		if on then
			onClick()
		end
	end)
	return button
end

-- Empfänger-Auswahl für den Geschenk-Boost (nur andere Spieler im Server)
local function giftPicker(order: number): number
	local list = detailList :: ScrollingFrame
	local others: { Player } = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and #others < MAX_GIFT_TARGETS then
			table.insert(others, other)
		end
	end
	if #others == 0 then
		detailLine(T("shop.gift.none"), order, Theme.Muted)
		return order + 1
	end
	detailLine(T("shop.gift.pick"), order, Theme.Text, true)
	local holder: Frame = UI.Create("Frame", {
		Name = "Recipients",
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order + 1,
		ZIndex = 32,
		Parent = list,
	}, {
		UI.Create("UIGridLayout", {
			CellSize = UDim2.fromOffset(190, 38),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, other in ipairs(others) do
		local selected = giftChoice == other.UserId
		UI.Button({
			Text = other.DisplayName,
			Variant = if selected then "Primary" else "Secondary",
			MaxText = 15,
			LayoutOrder = i,
			ZIndex = 33,
			Parent = holder,
		}, function()
			giftChoice = other.UserId
			renderDetail()
		end)
	end
	if giftChoice then
		local target = Players:GetPlayerByUserId(giftChoice)
		if target then
			detailLine(T("shop.gift.selected", target.DisplayName), order + 2, Theme.Pink, true)
		else
			giftChoice = nil
		end
	end
	return order + 3
end

renderDetail = function()
	local key = detailKey
	local frame, list, buttons = detailFrame, detailList, detailButtons
	if not key or not frame or not list or not buttons then
		return
	end
	local entry, kind = itemOf(key)
	if entry == nil or kind == nil then
		closeDetail()
		return
	end
	table.clear(detailDynamics)
	clearChildren(list)
	clearChildren(buttons)
	local color = accentFor(entry, kind)
	if detailTitle then
		detailTitle.Text = UI.Upper(T("shop.details") .. " · " .. pick(entry.Name))
	end
	if detailAccent then
		detailAccent.BackgroundColor3 = color
	end
	local productKind = kindKey(entry, kind)
	-- Studio: auch ohne Id durch die Server-Vorprüfung (Policy-/Geschenk-Tests), danach Hinweis "Kauf simulieren"
	local purchasable = (configured(entry, kind) or RunService:IsStudio()) and not isDisabled(key)
	local owned = (kind == "Pass" and hasPass(key)) or (kind == "Subscription" and isClub())
	local order = 1
	detailLine(T("item.kind." .. productKind), order, color, true)
	order += 1
	detailLine(T("shop.effectHeader"), order, Theme.Text, true)
	order += 1
	detailLine(pick(entry.Desc), order, Theme.Text)
	order += 1

	-- besondere Zeilen je Art
	if key == "Income2x" or key == "Income3x" then
		detailLine(T("shop.together4"), order, Theme.Accent, true)
		detailLine(T("shop.togetherNote"), order + 1, Theme.Text2)
		order += 2
	end
	local extraButtons: { { Text: string, Variant: string, Fn: () -> () } } = {}
	if kind == "Pass" and type(entry.Includes) == "table" then
		local ownedParts, missing = bundleParts(entry)
		detailLine(T("shop.bundleParts", partNames(entry.Includes)), order, Theme.Text2)
		order += 1
		local saveLabel = detailLine("", order, Theme.Up, true)
		addDynamic(detailDynamics, saveLabel, function(): string
			return bundleSaveText(entry) or ""
		end)
		order += 1
		if not hasPass(key) and #missing == 0 then
			detailLine(T("shop.bundleAllOwned"), order, Theme.Muted, true)
			purchasable = false
			order += 1
		elseif not hasPass(key) and #ownedParts > 0 then
			detailLine(T("shop.bundleOwnedParts", partNames(ownedParts)), order, Theme.Warn, true)
			detailLine(T("shop.bundleSingles", partNames(missing)), order + 1, Theme.Warn)
			order += 2
			for _, part in ipairs(missing) do
				local partEntry = SHOP.PassesByKey[part]
				if partEntry then
					table.insert(extraButtons, {
						Text = pick(partEntry.Name),
						Variant = "Secondary",
						Fn = function()
							openDetail(part)
						end,
					})
				end
			end
		end
	elseif kind == "Pass" and hasPass(key) then
		local bundle = SHOP.PassesByKey.TycoonBundle
		if bundle and type(bundle.Includes) == "table" and table.find(bundle.Includes, key) and hasPass(bundle.Key) then
			detailLine(T("shop.passInBundle"), order, Theme.Up, true)
			order += 1
		end
	end
	if productKind == "Voucher" then
		if quote and quote.Key == key then
			local q = quote :: QuoteInfo
			detailLine(T("shop.quoteLine", credits(q.Credits)), order, Theme.Up, true)
			local valid = detailLine("", order + 1, Theme.Text2)
			addDynamic(detailDynamics, valid, function(): string
				local left = q.Until - clockNow()
				return if left > 0 then T("shop.quoteValid", duration(left)) else T("shop.quoteExpired")
			end)
			order += 2
			if q.Until <= clockNow() then
				table.insert(extraButtons, {
					Text = T("shop.recalc"),
					Variant = "Secondary",
					Fn = function()
						quote = nil
						requestQuote(key)
					end,
				})
			end
		elseif quoteFailed == key then
			detailLine(T("shop.quoteExpired"), order, Theme.Muted)
			order += 1
			table.insert(extraButtons, {
				Text = T("shop.recalc"),
				Variant = "Secondary",
				Fn = function()
					quoteFailed = nil
					requestQuote(key)
				end,
			})
		else
			detailLine(T("shop.quoteLoading"), order, Theme.Muted)
			order += 1
			if not quoteLoading then
				requestQuote(key)
			end
		end
		detailLine(T("shop.quoteHint"), order, Theme.Text2)
		detailLine(T("shop.onlyCr"), order + 1, Theme.Up)
		order += 2
	elseif productKind == "Express" then
		local seconds = num(entry.Express, 0)
		local info = detailLine("", order, Theme.Cyan, true)
		addDynamic(detailDynamics, info, function(): string
			local tower = state().Tower
			local build = type(tower) == "table" and tower.Build or nil
			if type(build) == "table" and build.Floor ~= nil then
				local left = num(build.Until, 0) - clockNow()
				local effect = if left <= seconds
					then T("shop.express.finish")
					else T("shop.express.shorten", duration(seconds))
				return T("shop.express.build", duration(left)) .. " " .. effect
			end
			local tokens = type(tower) == "table" and type(tower.Tokens) == "table" and tower.Tokens.Express or 0
			return T("shop.express.token", num(tokens, 0))
		end)
		order += 1
	elseif productKind == "Starter" then
		local starter = state().Starter
		if type(starter) == "table" and starter.Bought == true then
			local preview = offers().Preview
			local value = if type(preview) == "table" then num(preview.CreditsM, 0) else 0
			detailLine(T("shop.starter.bought", credits(value * 2)), order, Theme.Warn, true)
			order += 1
		end
	elseif productKind == "Season" then
		if offers().SeasonPremium == true then
			detailLine(T("shop.season.premiumActive"), order, Theme.Up, true)
			purchasable = false
			order += 1
		end
	elseif productKind == "Parade" then
		local info = detailLine("", order, Theme.Gold, true)
		addDynamic(detailDynamics, info, function(): string
			local left = paradeLeft()
			return if left > 0 then T("shop.parade.active", duration(left)) else ""
		end)
		order += 1
	elseif productKind == "Gift" then
		detailLine(T("shop.gift.rule"), order, Theme.Text2)
		order += 1
		if not tradingAllowed() then
			detailLine(T("shop.giftBlocked"), order, Theme.Down, true)
			purchasable = false
			order += 1
		else
			order = giftPicker(order)
			if giftChoice == nil then
				purchasable = false
			end
		end
	elseif kind == "Subscription" then
		if isClub() then
			detailLine(T("shop.club.member"), order, Theme.Up, true)
			order += 1
		elseif offers().ClubEligible ~= true then
			detailLine(T("shop.restricted"), order, Theme.Muted, true)
			purchasable = false
			order += 1
		end
	end

	detailLine(T("shop.firewall"), order, Theme.Muted)
	order += 1
	local priceLabel = detailLine("", order, Theme.Warn, true)
	setPrice(priceLabel, entry, kind)
	order += 1
	if not configured(entry, kind) then
		detailLine(T("shop.notSetUp"), order, Theme.Muted)
		order += 1
	elseif isDisabled(key) then
		detailLine(T("shop.disabled"), order, Theme.Muted)
		order += 1
	end
	detailLine(T("shop.robuxNote"), order, Theme.Muted)
	list.CanvasPosition = Vector2.zero

	-- Knöpfe: ruhig, ehrlich ("Weiter zum Kauf" erst nach den Details, nie "JETZT KAUFEN")
	local buttonOrder = 1
	if kind == "Subscription" and isClub() then
		detailButton(T("shop.club.claim"), "Success", buttonOrder, 220, claimClub)
		buttonOrder += 1
	elseif owned then
		detailButton(T("shop.owned"), "Muted", buttonOrder, 200, function() end, false)
		buttonOrder += 1
	else
		detailButton(T("shop.continue"), "Premium", buttonOrder, 230, function()
			purchase(key, if productKind == "Gift" then giftChoice else nil)
		end, purchasable)
		buttonOrder += 1
	end
	for _, extra in ipairs(extraButtons) do
		if buttonOrder > 4 then
			break
		end
		detailButton(extra.Text, extra.Variant, buttonOrder, 170, extra.Fn)
		buttonOrder += 1
	end
	detailButton(T("shop.close"), "Secondary", 99, 140, closeDetail)
end

openDetail = function(key: string)
	if not detailFrame then
		return
	end
	if detailKey ~= key then
		quote = nil
		quoteFailed = nil
		giftChoice = nil
	end
	detailKey = key
	local frame = detailFrame :: Frame
	local scale = detailScale
	if scale and not frame.Visible then
		-- federnd aufklappen (leichtes Überschwingen wie auf der AKYTEX-Website)
		scale.Scale = 0.94
		TweenService:Create(scale, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = 1,
		}):Play()
	end
	frame.Visible = true
	renderDetail()
end

local function buildDetail(panel: Frame)
	local frame: Frame = UI.Create("Frame", {
		Name = "Details",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.02,
		Visible = false,
		Active = true,
		ZIndex = 30,
		Parent = panel,
	}, { UI.Corner(16), UI.Stroke(nil, 1) })
	detailTitle = UI.Label({
		Position = UDim2.fromOffset(20, 14),
		Size = UDim2.new(1, -80, 0, 26),
		Text = "",
		Face = "Display",
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 19,
		ZIndex = 31,
		Parent = frame,
	})
	detailAccent = UI.Create("Frame", {
		Name = "Accent",
		Position = UDim2.fromOffset(20, 44),
		Size = UDim2.fromOffset(28, 2),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 31,
		Parent = frame,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	UI.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.fromOffset(36, 36),
		Text = "✕",
		Variant = "Ghost",
		MaxText = 18,
		Corner = 10,
		ZIndex = 32,
		Parent = frame,
	}, closeDetail)
	detailList = UI.Create("ScrollingFrame", {
		Position = UDim2.fromOffset(20, 58),
		Size = UDim2.new(1, -40, 1, -132),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Muted,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 31,
		Parent = frame,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
		UI.Create("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }),
	})
	detailButtons = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.new(1, -32, 0, 56),
		BackgroundTransparency = 1,
		ZIndex = 31,
		Parent = frame,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 10),
		}),
	})
	detailScale = UI.Create("UIScale", { Scale = 1, Parent = frame })
	detailFrame = frame
end

-- =====================================================================
-- 7) FENSTER
-- =====================================================================
local function isCompact(): boolean
	local gui = ctx and ctx.Gui
	if not gui then
		return false
	end
	local width = gui.AbsoluteSize.X / UI.ScaleOf(gui)
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	return width < WINDOW_W + 40 or (touchOnly and width < 1100)
end

local function startTicker()
	tickToken += 1
	local token = tickToken
	task.spawn(function()
		for _ = 1, TICK_MAX do
			if token ~= tickToken or not window or not window.IsOpen then
				return
			end
			updateDynamics(dynamics)
			if detailKey then
				updateDynamics(detailDynamics)
			end
			task.wait(1)
		end
	end)
end

local function makeTabs()
	if not window then
		return
	end
	if tabs and tabs.Frame then
		tabs.Frame:Destroy()
	end
	local options = {}
	for _, key in ipairs(TABS) do
		table.insert(options, { Key = key, Text = T(TAB_LANG[key]) })
	end
	tabs = UI.Segmented(window.Content, options, function(key: string)
		currentTab = key
		closeDetail()
		render()
	end)
	tabs.Frame.LayoutOrder = 2
end

local function destroyWindow()
	if window then
		if window.IsOpen then
			UI.CloseWindow(window)
		end
		window.Group:Destroy()
	end
	window = nil
	tabs = nil
	body = nil
	detailFrame = nil
	detailList = nil
	detailButtons = nil
	detailTitle = nil
	detailAccent = nil
	detailScale = nil
	table.clear(dynamics)
	table.clear(detailDynamics)
end

local function ensureWindow()
	if window and builtLang == lang() then
		return
	end
	destroyWindow()
	window = if isCompact()
		then UI.Sheet(T("shop.title"), SHEET_H)
		else UI.Window(T("shop.title"), WINDOW_W, WINDOW_H, Theme.Accent)
	builtLang = lang()
	-- Kopf-Banner: "Kurse kann man nicht kaufen – alles Spielgeld"
	local banner = UI.Card({
		Name = "Banner",
		Size = UDim2.new(1, -4, 0, 70),
		BackgroundColor3 = Theme.Bg2,
		LayoutOrder = 1,
		Parent = window.Content,
	})
	UI.Gradient(Theme.Surface2, Theme.Bg2, 0).Parent = banner
	UI.Create("Frame", {
		Name = "Bar",
		Position = UDim2.fromOffset(0, 10),
		Size = UDim2.new(0, 3, 1, -20),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = banner,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	UI.Label({
		Name = "Logo",
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.fromOffset(46, 46),
		Text = "Λ",
		Face = "Display",
		TextColor3 = Theme.LogoRing,
		MaxText = 34,
		Parent = banner,
	})
	UI.Label({
		Name = "Title",
		Position = UDim2.fromOffset(72, 10),
		Size = UDim2.new(1, -88, 0, 26),
		Text = UI.Upper(T("shop.banner")),
		Face = "Display",
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 18,
		Parent = banner,
	})
	UI.Label({
		Name = "Sub",
		Position = UDim2.fromOffset(72, 38),
		Size = UDim2.new(1, -88, 0, 22),
		Text = T("shop.bannerSub"),
		Font = UI.Fonts.Body,
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		MaxText = 14,
		Parent = banner,
	})
	makeTabs()
	body = UI.Create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = window.Content,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }) })
	buildDetail(window.Panel)
end

local function openWindow()
	ensureWindow()
	if not window then
		return
	end
	if pendingTab then
		currentTab = pendingTab
		pendingTab = nil
	end
	if tabs then
		tabs.Set(currentTab, true)
	end
	closeDetail()
	UI.OpenWindow(window)
	render()
	startTicker()
	if pendingDetail then
		local key = pendingDetail
		pendingDetail = nil
		openDetail(key)
	end
	if not shopSeenSent then
		shopSeenSent = true
		task.spawn(function()
			pcall(function()
				ctx.RequestFull("TutorialFlag", { Flag = "ShopSeen" }, true)
			end)
		end)
	end
end

local function closeWindow()
	closeDetail()
	tickToken += 1
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
end

-- Tab-Name, Alias oder Artikel-Schlüssel -> Reiter (+ Details)
function Shop.Open(tab: string?)
	if not ctx then
		return
	end
	if type(tab) == "string" then
		local alias = TAB_ALIASES[tab]
		if table.find(TABS, tab) then
			pendingTab = tab
		elseif alias then
			pendingTab = alias
		elseif itemOf(tab) ~= nil then
			pendingTab = tabOf(tab)
			pendingDetail = tab
		end
	end
	if window and window.IsOpen then
		-- schon offen: direkt umschalten
		if pendingTab then
			currentTab = pendingTab
			pendingTab = nil
			if tabs then
				tabs.Set(currentTab, true)
			end
			render()
		end
		if pendingDetail then
			local key = pendingDetail
			pendingDetail = nil
			openDetail(key)
		end
		return
	end
	ctx.Windows.Open("Shop")
end

-- =====================================================================
-- 8) ANGEBOTS-KARTE (max. 1 je Sitzung, ruhig, nie über Terminal/Tutorial/Warnung)
-- =====================================================================
local function hideOffer()
	offerToken += 1
	local card = offerCard
	offerCard = nil
	if card and card.Parent then
		local tween = TweenService:Create(card, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = card.Position + UDim2.fromOffset(0, 24),
		})
		tween.Completed:Once(function()
			card:Destroy()
		end)
		tween:Play()
	end
end

-- ein ruhiger Moment? (kein Fenster/Terminal/Order-Ticket, kein Tutorial, keine Markt-Warnung, kein Admin-Abuse)
local function calmMoment(): boolean
	if UI.IsAnyWindowOpen() then
		return false
	end
	local okTerminal, terminalOpen = callModule("Terminal", "IsOpen")
	if okTerminal and terminalOpen == true then
		return false
	end
	local okTutorial, tutorialActive = callModule("Tutorial", "IsActive")
	if okTutorial and tutorialActive == true then
		return false
	end
	local event = state().Event
	if type(event) == "table" and event.AdminAbuse == true then
		return false
	end
	local market = state().Market
	if type(market) == "table" and market.AdminWindow == true then
		return false
	end
	return os.clock() >= marketBusyUntil
end

function Shop.ShowOffer(key: string)
	if not ctx or not ctx.Gui then
		return
	end
	local entry, kind = itemOf(key)
	if entry == nil or kind == nil then
		return
	end
	hideOffer()
	offerToken += 1
	local token = offerToken
	local color = accentFor(entry, kind)
	local card = UI.Panel({
		Name = "ShopOffer",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -124),
		Size = UDim2.fromOffset(440, 150),
		ZIndex = 20,
		Parent = ctx.Gui,
	})
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
		stroke.Transparency = 0.4
	end
	iconBadge(card, entry, color, 52, UDim2.fromOffset(16, 18))
	UI.Chip(card, T("shop.offer.tip"), color, { Position = UDim2.fromOffset(82, 16) })
	UI.Label({
		Position = UDim2.fromOffset(82, 42),
		Size = UDim2.new(1, -98, 0, 26),
		Text = pick(entry.Name),
		Face = "Display",
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 18,
		ZIndex = 21,
		Parent = card,
	})
	UI.Label({
		Position = UDim2.fromOffset(82, 70),
		Size = UDim2.new(1, -98, 0, 20),
		Text = T("shop.offer.lead"),
		Font = UI.Fonts.Body,
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		MaxText = 14,
		ZIndex = 21,
		Parent = card,
	})
	local row: Frame = UI.Create("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -12),
		Size = UDim2.new(1, -96, 0, 36),
		BackgroundTransparency = 1,
		ZIndex = 21,
		Parent = card,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
	UI.Button({
		Size = UDim2.fromOffset(130, 36),
		Text = T("shop.view"),
		Variant = "Primary",
		MaxText = 15,
		LayoutOrder = 1,
		ZIndex = 22,
		Parent = row,
	}, function()
		hideOffer()
		Shop.Open(key)
	end)
	UI.Button({
		Size = UDim2.fromOffset(110, 36),
		Text = T("shop.later"),
		Variant = "Ghost",
		MaxText = 15,
		LayoutOrder = 2,
		ZIndex = 22,
		Parent = row,
	}, hideOffer)
	-- sanft von unten herein (iOS-artig), nach einer Weile von selbst weg
	local rest = card.Position
	card.Position = rest + UDim2.fromOffset(0, 24)
	TweenService
		:Create(card, TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = rest })
		:Play()
	offerCard = card
	task.delay(OFFER_AUTO_HIDE, function()
		if offerToken == token then
			hideOffer()
		end
	end)
end

-- Server hat ein Angebot freigegeben (State "Offers") -> auf einen ruhigen Moment warten, sonst entfällt es
local function maybeOffer()
	local o = offers()
	local id = num(o.Id, 0)
	local key = o.Pending
	if id <= lastOfferId or type(key) ~= "string" or key == "" then
		return
	end
	lastOfferId = id
	task.spawn(function()
		local waited = 0
		local limit = math.max(10, num(SHOP.OfferClientWait, 120))
		while waited <= limit do
			if calmMoment() then
				Shop.ShowOffer(key)
				return
			end
			task.wait(OFFER_CHECK_GAP)
			waited += OFFER_CHECK_GAP
		end
	end)
end

-- =====================================================================
-- 9) CHAT-TAGS [VIP] / [Club] (nur Anzeige auf diesem Gerät, aus den Player-Attributen)
-- =====================================================================
local function tag(text: string, color: Color3): string
	return ('<font color="%s">[%s]</font>'):format(UI.ColorHex(color), text)
end

local function installChatTags()
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		return
	end
	TextChatService.OnIncomingMessage = function(message: TextChatMessage): TextChatMessageProperties?
		local source = message.TextSource
		if not source then
			return nil -- System-/Spielnachrichten bleiben, wie sie sind
		end
		local sender = Players:GetPlayerByUserId(source.UserId)
		if not sender then
			return nil
		end
		local parts: { string } = {}
		if sender:GetAttribute("Vip") == true then
			table.insert(parts, tag(T("shop.chat.vip"), Theme.Gold))
		end
		if sender:GetAttribute("Club") == true then
			table.insert(parts, tag(T("shop.chat.club"), Theme.Cosmic3))
		end
		if #parts == 0 then
			return nil
		end
		local props = Instance.new("TextChatMessageProperties")
		props.PrefixText = table.concat(parts, " ") .. " " .. message.PrefixText
		return props
	end
end

-- =====================================================================
-- 10) INIT / START
-- =====================================================================
-- State-Schlüssel, die den Aufbau eines Reiters ändern (Zahlen wie Boost-Restzeit/Baustelle laufen über die
-- 1-s-Aktualisierung, häufige Schlüssel wie Credits/Tower lösen bewusst keinen Neuaufbau aus)
local RELEVANT: { string } = {
	"Passes",
	"Club",
	"Boosts",
	"Offers",
	"Starter",
	"TradingAllowed",
	"RandomAllowed",
}

function Shop.Init(context: any)
	ctx = context
	ctx.Windows.Register("Shop", openWindow, closeWindow)
	ctx.Hooks.On("State", function(_state: { [string]: any }, changed: { [any]: any })
		if type(changed) ~= "table" then
			return
		end
		if changed.Boosts then
			boostsAt = os.clock()
		end
		if changed.Offers then
			maybeOffer()
		end
		if window and window.IsOpen then
			for _, key in ipairs(RELEVANT) do
				if changed[key] then
					-- nur neu aufbauen, wenn sich wirklich etwas am Aufbau geändert hat (kein Flackern alle 20 s)
					if layoutSig() ~= renderedSig then
						queueRender()
					end
					break
				end
			end
		end
	end)
	ctx.Hooks.On("Settings", function()
		if builtLang ~= "" and builtLang ~= lang() then
			local wasOpen = window ~= nil and window.IsOpen
			if wasOpen then
				ctx.Windows.Close("Shop")
			end
			destroyWindow()
			builtLang = ""
			if wasOpen then
				Shop.Open(currentTab)
			end
		end
	end)
	-- Markt-Warnung/Crash/Rally: in dieser Zeit kein Angebot (Muss-Regel 17)
	ctx.Hooks.On("Market:Event", function(data: any)
		if type(data) ~= "table" then
			return
		end
		if data.Phase == "Warn" or data.Phase == "Run" then
			marketBusyUntil = math.max(marketBusyUntil, os.clock() + MARKET_EVENT_HOLD)
			hideOffer()
		elseif data.Phase == "End" then
			marketBusyUntil = os.clock() + MARKET_EVENT_TAIL
		end
	end)
	ctx.Hooks.On("WindowOpened", function(name: string)
		if name ~= "Shop" then
			hideOffer() -- Terminal/Willkommen-Bericht/… haben Vorrang
		end
	end)
end

function Shop.Start()
	-- Kauf abgeschlossen -> Details schließen (die Gutschrift meldet der Server)
	MarketplaceService.PromptProductPurchaseFinished:Connect(
		function(userId: number, _productId: number, purchased: boolean)
			if purchased and userId == player.UserId then
				closeDetail()
				sfx("Achievement") -- sofort spürbar; Gutschrift + Meldung kommen vom Server
			end
		end
	)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(who: Player, _passId: number, purchased: boolean)
		if purchased and who == player then
			closeDetail()
			sfx("Achievement")
		end
	end)
	MarketplaceService.PromptSubscriptionPurchaseFinished:Connect(
		function(who: Player, _subscriptionId: string, didTryPurchasing: boolean)
			if didTryPurchasing and who == player then
				closeDetail()
			end
		end
	)
	-- Geschenk-Empfänger kommen und gehen: offene Geschenk-Details aktualisieren
	local function refreshGiftPicker()
		local key = detailKey
		local entry = if key then SHOP.ProductsByKey[key] else nil
		if entry and entry.Kind == "Gift" then
			renderDetail()
		end
	end
	Players.PlayerAdded:Connect(refreshGiftPicker)
	Players.PlayerRemoving:Connect(function()
		task.defer(refreshGiftPicker)
	end)
	local ok, err = pcall(installChatTags)
	if not ok then
		warn("[Shop] Chat-Tags: " .. tostring(err))
	end
	-- schon vorhandener State (z. B. nach Modul-Neustart)
	maybeOffer()
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="155">
            <Properties>
              <string name="Name">Social</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Sozial ohne Chat: Spieler, Respekt, Reaktionen, Emotes, Zeigen-Karte, Einladen, Gruppe,
--  Benachrichtigungs-Opt-in, Namensschilder (Client/Modules/Social)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §B11.3 (Respekt 1 je Tower je Tag,
--  Reaktionen 👍 🚀 📈 👏 🔔 als Bubble über dem Kopf, 3 s sichtbar, Radialmenü controller-tauglich, Standard-Emotes),
--  §B11.4 (Freunde-Bonus, Einladen ab Stufe 3, Gruppe), §B11.5 (Zeigen-Karte ohne Trade-G/V), §B11.9 (Opt-in einmal
--  nach positivem Moment, nie im Tutorial), §B9.5 (Titel am Namensschild), §C7.3 (Fenster "Social").
--
--  Öffentliche API: keine Pflicht-API. Zusätzlich: Social.Init(ctx), Social.Start(), Social.Open(),
--  Social.PromptNotify(force?) (Tutorial ruft das nach Schritt 17), Social.ToggleWheel(),
--  Social.PositiveMoment() (nach Lizenz-Zeremonie: einmal Favoriten-Abfrage je Konto, sonst Benachrichtigungs-Opt-in).
--  Teilen-Links (Wunsch 11): „Freunde einladen“ hängt LaunchData "visit:<UserId>" an (ExperienceInviteOptions) – der
--  Eingeladene landet nach dem Tutorial direkt am Tower des Einladers (State Social.LaunchVisit/LaunchVisitHere).
--  Anfragen: SocialRespekt { UserId }, SocialReact { Kind }, SocialShow {}, SocialInvited {}, NotifyOptIn { Result },
--  TowerVisit { UserId }, Report { UserId, Reason } (§C9, AntiCheatService: 3 je 10 min, Liste im Admin-Panel).
--  State: "Social".  Spieler-Attribute (vom Server): Title, Licence, Group, React, ShowCard.
--  NotifyOptIn.Result = „Abfrage wurde gezeigt“ (Roblox verrät nicht, ob zugestimmt wurde).
-- =====================================================================

local AvatarEditorService = game:GetService("AvatarEditorService")
local ExperienceNotificationService = game:GetService("ExperienceNotificationService")
local GroupService = game:GetService("GroupService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local SocialService = game:GetService("SocialService")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local Social = {}

local Theme = UI.Theme
local player = Players.LocalPlayer

local WINDOW_W, WINDOW_H = 660, 600
local WHEEL_SIZE = 340
local WHEEL_RADIUS = 122
local WHEEL_BUTTON = 74
local WHEEL_AUTO_CLOSE = 8
local HEAD_WAIT = 10
local POP_INFO = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local FADE_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local MAX_TRACKED = 60 -- Schutz: so viele Spieler bekommen Namensschilder (Server-Größe ist kleiner)
local EMOTE_ICONS: { [string]: string } = { wave = "👋", cheer = "🙌", point = "👉", dance = "🕺" }
local REPORT_REASONS = { "Speed", "Fly", "Exploit", "Toxic", "Other" } -- = AntiCheatService REPORT_REASONS

type Watch = {
	Conns: { RBXScriptConnection },
	Plate: BillboardGui?,
	PlateTitle: TextLabel?,
	PlateSub: TextLabel?,
	PlateFrame: Frame?,
	Bubble: BillboardGui?,
	BubbleToken: number,
	Card: BillboardGui?,
	CardToken: number,
}

local ctx: any = nil
local window: any = nil
local segmented: any = nil
local tab = "people"
local pages: { [string]: Frame } = {}
local ui: { [string]: any } = {}
local watches: { [Player]: Watch } = {}
local wheel: Frame? = nil
local wheelToken = 0
local busy = false
local promptBusy = false
local peopleSig = ""
local billboardFolder: Folder? = nil
local launchHandled = false -- Tower-Besuch aus den Launch-Daten schon erledigt (diese Sitzung)
local launchToldLater = false
local favoriteAsked = false
local reportFor: number? = nil -- Spieler, dessen Zeile gerade die Melde-Gründe zeigt
local reportBusy = false

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

local function social(): { [string]: any }
	local s = ctx.State.Social
	return if type(s) == "table" then s else {}
end

local function scfg(): { [string]: any }
	local p = ctx.Config.Progression
	local s = type(p) == "table" and p.Social or nil
	return if type(s) == "table" then s else {}
end

local function decimal(v: number): string
	local value = string.format("%.2f", v)
	return if lang() == "de" then (string.gsub(value, "%.", ",")) else value
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	props.Parent = parent
	if props.TextXAlignment == nil then
		props.TextXAlignment = Enum.TextXAlignment.Left
	end
	return UI.Label(props)
end

local function clear(frame: Instance)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function titleName(key: any): string
	if type(key) ~= "string" or key == "" then
		return ""
	end
	local p = ctx.Config.Progression
	local def = type(p) == "table" and p.TitleByKey and p.TitleByKey[key] or nil
	if type(def) == "table" and type(def.Name) == "table" then
		return ctx.Lang.Pick(lang(), def.Name)
	end
	return key
end

local function licenceName(idx: any): string
	local p = ctx.Config.Progression
	local list = type(p) == "table" and p.Licences or nil
	local def = type(list) == "table" and type(idx) == "number" and list[idx] or nil
	if type(def) == "table" and type(def.Name) == "table" then
		return ctx.Lang.Pick(lang(), def.Name)
	end
	return ""
end

local function carName(key: string): string
	local vehicles = ctx.Config.Vehicles
	local cars = type(vehicles) == "table" and vehicles.Cars or nil
	if type(cars) == "table" then
		for _, def in ipairs(cars) do
			if type(def) == "table" and def.Key == key and type(def.Name) == "table" then
				return ctx.Lang.Pick(lang(), def.Name)
			end
		end
	end
	return key
end

local function reactionEmoji(kind: string): string?
	for _, entry in ipairs(scfg().Reactions or {}) do
		if entry.Key == kind then
			return entry.Emoji
		end
	end
	return nil
end

local function folder(): Folder
	local existing = billboardFolder
	if existing and existing.Parent then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = "AT_SocialBillboards"
	f.Parent = player:WaitForChild("PlayerGui")
	billboardFolder = f
	return f
end

local function headOf(p: Player): BasePart?
	local character = p.Character
	local head = character and character:FindFirstChild("Head")
	return if head and head:IsA("BasePart") then head else nil
end

local function billboard(name: string, size: UDim2, offset: Vector3, maxDistance: number): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = name
	gui.Size = size
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false
	gui.Parent = folder()
	return gui
end

-- ---------------------------------------------------------------------
-- 2) NAMENSSCHILD (Titel, Lizenz, Community-Krone), REAKTIONS-BUBBLE, ZEIGEN-KARTE
-- ---------------------------------------------------------------------
local function updatePlate(p: Player, watch: Watch)
	local title = titleName(p:GetAttribute("Title"))
	local licence = licenceName(p:GetAttribute("Licence"))
	local group = p:GetAttribute("Group") == true
	-- gekaufte Namensschild-Vorteile (ShopService-Attribute): VIP = goldenes Λ, Club-Tag, Rahmen „Gründer“ (Starter)
	local vip = p:GetAttribute("Vip") == true
	local club = p:GetAttribute("Club") == true
	local founder = p:GetAttribute("Founder") == true
	if p == player or (title == "" and licence == "" and not group and not vip and not club and not founder) then
		local plate = watch.Plate
		if plate then
			plate.Enabled = false
		end
		return
	end
	if not watch.Plate then
		local plate = billboard(
			"Plate_" .. p.UserId,
			UDim2.fromOffset(220, 46),
			Vector3.new(0, 2.9, 0),
			num(
				ctx.Config.Progression and ctx.Config.Progression.Titles and ctx.Config.Progression.Titles.ShowRange,
				80
			)
		)
		watch.Plate = plate
		-- dezente Glas-Pille hinter dem Text (lesbar vor heller Fassade und Himmel, AKYTEX-Glas-Look)
		UI.Create("Frame", {
			Name = "PlateBg",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.92, 0.94),
			BackgroundColor3 = Theme.Bg,
			BackgroundTransparency = 0.45,
			ZIndex = 0,
			Parent = plate,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0, 10) }) })
		watch.PlateTitle = UI.Label({
			Size = UDim2.new(1, 0, 0.55, 0),
			Text = "",
			Face = "Display",
			TextColor3 = Theme.Gold,
			MaxText = 18,
			Outline = 1,
			Parent = plate,
		})
		watch.PlateSub = UI.Label({
			Position = UDim2.fromScale(0, 0.55),
			Size = UDim2.new(1, 0, 0.45, 0),
			Text = "",
			TextColor3 = Theme.Text2,
			MaxText = 14,
			Outline = 1,
			Parent = plate,
		})
		watch.PlateFrame = UI.Create("Frame", {
			Name = "FounderFrame",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = plate,
		}, {
			UI.Create("UICorner", { CornerRadius = UDim.new(0, 10) }),
			UI.Create("UIStroke", { Color = Theme.Gold, Thickness = 1.5, Transparency = 0.15 }),
		})
	end
	local plate = watch.Plate :: BillboardGui
	plate.Adornee = headOf(p)
	plate.Enabled = true
	if watch.PlateTitle then
		local tags: { string } = {}
		if vip then
			table.insert(tags, "Λ " .. T("shop.chat.vip"))
		end
		if club then
			table.insert(tags, T("shop.chat.club"))
		end
		local head = if title ~= "" then title else table.concat(tags, " · ")
		watch.PlateTitle.Text = (if group then "👑 " else "") .. (if vip and title ~= "" then "Λ " else "") .. head
	end
	if watch.PlateSub then
		local sub = licence
		if founder then
			sub = if sub ~= "" then sub .. " · " .. T("shop.plate.founder") else T("shop.plate.founder")
		end
		watch.PlateSub.Text = sub
	end
	local frame = watch.PlateFrame
	if frame then
		-- Rahmen: Gold = „Gründer“ (Starter-Paket), Akzentblau = Gruppe „AKYTEX Games“ (Namensschild-Rahmen §B11.4)
		frame.Visible = founder or group
		local stroke = frame:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if founder then Theme.Gold else Theme.Accent
		end
	end
end

local function showBubble(p: Player, watch: Watch, kind: string)
	local emoji = reactionEmoji(kind)
	local head = headOf(p)
	if not emoji or not head then
		return
	end
	watch.BubbleToken += 1
	local mine = watch.BubbleToken
	local old = watch.Bubble
	if old then
		old:Destroy()
	end
	local gui = billboard("React_" .. p.UserId, UDim2.fromOffset(64, 64), Vector3.new(0, 5.2, 0), 120)
	gui.Adornee = head
	local bubble = UI.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.15,
		Parent = gui,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.Stroke(Theme.Accent, 2) })
	local scale = UI.Create("UIScale", { Scale = 0.2, Parent = bubble })
	UI.Label({
		Position = UDim2.fromScale(0.12, 0.12),
		Size = UDim2.fromScale(0.76, 0.76),
		Text = emoji,
		MaxText = 40,
		Parent = bubble,
	})
	watch.Bubble = gui
	TweenService:Create(scale, POP_INFO, { Scale = 1 }):Play()
	task.delay(num(scfg().ReactSeconds, 3), function()
		if watch.BubbleToken ~= mine or not gui.Parent then
			return
		end
		TweenService:Create(scale, FADE_INFO, { Scale = 0 }):Play()
		task.delay(0.3, function()
			if watch.Bubble == gui then
				watch.Bubble = nil
			end
			gui:Destroy()
		end)
	end)
end

-- "stage|licence|skill|tier|title|car|n" (vom Server, ohne Trade-G/V)
local function showCard(p: Player, watch: Watch, raw: string)
	local parts = string.split(raw, "|")
	if #parts < 7 then
		return
	end
	local head = headOf(p)
	if not head then
		return
	end
	watch.CardToken += 1
	local mine = watch.CardToken
	local old = watch.Card
	if old then
		old:Destroy()
	end
	local gui =
		billboard("Card_" .. p.UserId, UDim2.fromOffset(250, 158), Vector3.new(0, 7, 0), num(scfg().ShowRange, 60))
	gui.Adornee = head
	local card = UI.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, { UI.Corner(14), UI.Stroke(Theme.Accent, 2) })
	local scale = UI.Create("UIScale", { Scale = 0.3, Parent = card })
	UI.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		PaddingTop = UDim.new(0, 8),
		Parent = card,
	})
	UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = card })
	local tier = parts[4]
	local lines = {
		{ p.DisplayName, "Display", Theme.Text },
		{ titleName(parts[5]), "BodyBold", Theme.Gold },
		{
			T("soc.card.stage", math.floor(num(tonumber(parts[1]), 1))) .. "  ·  " .. licenceName(tonumber(parts[2])),
			"Body",
			Theme.Text2,
		},
		{
			T("soc.card.skill", math.floor(num(tonumber(parts[3]), 0)))
				.. "  ·  "
				.. T("soc.card.tier", T("prog.tier." .. (if tier ~= "" then tier else "None"))),
			"Mono",
			Theme.Cyan,
		},
		{ if parts[6] ~= "" then T("soc.card.car", carName(parts[6])) else "", "Body", Theme.Text2 },
	}
	for i, line in ipairs(lines) do
		if line[1] ~= "" then
			UI.Label({
				Size = UDim2.new(1, 0, 0, if i == 1 then 30 else 24),
				LayoutOrder = i,
				Text = line[1],
				Face = line[2],
				TextColor3 = line[3],
				MaxText = if i == 1 then 20 else 15,
				Parent = card,
			})
		end
	end
	watch.Card = gui
	TweenService:Create(scale, POP_INFO, { Scale = 1 }):Play()
	task.delay(num(scfg().ShowSeconds, 6), function()
		if watch.CardToken ~= mine or not gui.Parent then
			return
		end
		TweenService:Create(scale, FADE_INFO, { Scale = 0 }):Play()
		task.delay(0.3, function()
			if watch.Card == gui then
				watch.Card = nil
			end
			gui:Destroy()
		end)
	end)
end

local function readorn(p: Player, watch: Watch)
	local head = headOf(p)
	for _, gui in ipairs({ watch.Plate, watch.Bubble, watch.Card }) do
		if gui then
			gui.Adornee = head
		end
	end
	updatePlate(p, watch)
end

local function unwatch(p: Player)
	local watch = watches[p]
	if not watch then
		return
	end
	watches[p] = nil
	for _, conn in ipairs(watch.Conns) do
		conn:Disconnect()
	end
	for _, gui in ipairs({ watch.Plate, watch.Bubble, watch.Card }) do
		if gui then
			gui:Destroy()
		end
	end
end

local function watchPlayer(p: Player)
	if watches[p] then
		return
	end
	local count = 0
	for _ in pairs(watches) do
		count += 1
	end
	if count >= MAX_TRACKED then
		return
	end
	local watch: Watch = { Conns = {}, BubbleToken = 0, CardToken = 0 }
	watches[p] = watch
	local function onPlate()
		updatePlate(p, watch)
	end
	table.insert(watch.Conns, p:GetAttributeChangedSignal("Title"):Connect(onPlate))
	table.insert(watch.Conns, p:GetAttributeChangedSignal("Licence"):Connect(onPlate))
	table.insert(watch.Conns, p:GetAttributeChangedSignal("Group"):Connect(onPlate))
	for _, attribute in ipairs({ "Vip", "Club", "Founder" }) do
		table.insert(watch.Conns, p:GetAttributeChangedSignal(attribute):Connect(onPlate))
	end
	table.insert(
		watch.Conns,
		p:GetAttributeChangedSignal("React"):Connect(function()
			local raw = p:GetAttribute("React")
			if type(raw) == "string" then
				local kind = string.match(raw, "^(%a+):")
				if kind then
					showBubble(p, watch, kind)
				end
			end
		end)
	)
	table.insert(
		watch.Conns,
		p:GetAttributeChangedSignal("ShowCard"):Connect(function()
			local raw = p:GetAttribute("ShowCard")
			if type(raw) == "string" then
				showCard(p, watch, raw)
			end
		end)
	)
	table.insert(
		watch.Conns,
		p.CharacterAdded:Connect(function(character: Model)
			task.spawn(function()
				character:WaitForChild("Head", HEAD_WAIT)
				if watches[p] == watch then
					readorn(p, watch)
				end
			end)
		end)
	)
	if p.Character then
		readorn(p, watch)
	end
end

-- ---------------------------------------------------------------------
-- 3) AKTIONEN: Reaktion, Emote, Zeigen-Karte, Einladen, Opt-in
-- ---------------------------------------------------------------------
local function react(kind: string)
	call("Sfx", "Play", "UIClick")
	task.spawn(function()
		ctx.RequestFull("SocialReact", { Kind = kind }, true)
	end)
end

local function emote(name: string)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local ok, played = false, false
	if humanoid then
		ok, played = pcall(function()
			return humanoid:PlayEmote(name)
		end)
	end
	if not ok or played ~= true then
		UI.Toast(T("soc.emoteFail"), "Info")
	end
end

local function showMyCard()
	if busy then
		return
	end
	busy = true
	call("Sfx", "Play", "Whoosh")
	task.spawn(function()
		ctx.RequestFull("SocialShow", {})
		busy = false
	end)
end

local function invite()
	local s = social()
	if s.InviteAllowed ~= true then
		UI.Toast(T("soc.inviteLocked", math.floor(num(scfg().InviteFromStage, 3))), "Info")
		return
	end
	task.spawn(function()
		local okCan, can = pcall(function()
			return SocialService:CanSendGameInviteAsync(player)
		end)
		if not okCan or can ~= true then
			UI.Toast(T("soc.inviteFailed"), "Error")
			return
		end
		local okPrompt = pcall(function()
			-- Teilen-Link mit Launch-Daten: der Freund landet direkt an deinem Tower (CommunityService liest sie)
			local okOptions, options = pcall(function()
				local made: any = (Instance.new :: any)("ExperienceInviteOptions")
				made.LaunchData = "visit:" .. tostring(player.UserId)
				made.PromptMessage = T("soc.invitePrompt")
				return made
			end)
			if okOptions and typeof(options) == "Instance" then
				SocialService:PromptGameInvite(player, options)
			else
				SocialService:PromptGameInvite(player)
			end
		end)
		if okPrompt then
			ctx.RequestFull("SocialInvited", {}, true)
		else
			UI.Toast(T("soc.inviteFailed"), "Error")
		end
	end)
end

-- Opt-in einmal nach einem positiven Moment (Server sagt CanPromptNotify; nie während des Tutorials)
function Social.PromptNotify(force: boolean?)
	if promptBusy then
		return
	end
	local s = social()
	local okTut, tutorialActive = call("Tutorial", "IsActive")
	if okTut and tutorialActive == true then
		return
	end
	if not force and (s.CanPromptNotify ~= true or s.NotifOptIn == true) then
		return
	end
	promptBusy = true
	task.spawn(function()
		local okCan, can = pcall(function()
			return ExperienceNotificationService:CanPromptOptInAsync()
		end)
		local shown = false
		if okCan and can == true then
			shown = pcall(function()
				ExperienceNotificationService:PromptOptIn()
			end)
		elseif force then
			UI.Toast(T("soc.notifyDone"), "Info")
		end
		ctx.RequestFull("NotifyOptIn", { Result = shown }, true)
		promptBusy = false
	end)
end

-- Nach einem schönen Moment (nie im Tutorial): einmal je Konto die Favoriten-Abfrage, sonst das Opt-in (falls erlaubt)
function Social.PositiveMoment()
	local okTut, tutorialActive = call("Tutorial", "IsActive")
	if okTut and tutorialActive == true then
		return
	end
	local flags = ctx.State.Flags
	if type(flags) == "table" and flags.FavoritePrompted ~= true and not favoriteAsked then
		favoriteAsked = true
		pcall(function()
			AvatarEditorService:PromptSetFavorite(game.PlaceId, Enum.AvatarItemType.Asset, true)
		end)
		task.spawn(function()
			ctx.RequestFull("TutorialFlag", { Flag = "FavoritePrompted" }, true)
		end)
		return
	end
	Social.PromptNotify(false)
end

-- Teilen-Link / Einladung mit Launch-Daten: einmal den Tower des Einladers besuchen – erst wenn das Tutorial
-- entschieden und vorbei ist (der Anflug auf den eigenen Plot hat Vorrang)
local function checkLaunchVisit()
	if launchHandled then
		return
	end
	local s = social()
	local target = math.floor(num(s.LaunchVisit, 0))
	if target <= 0 or target == player.UserId then
		return
	end
	local okStep, tutorialStep = call("Tutorial", "Step")
	if okStep and tutorialStep == 0 then
		return -- Tutorial entscheidet noch (wartet auf den Plot)
	end
	local owner = Players:GetPlayerByUserId(target)
	local okTut, tutorialActive = call("Tutorial", "IsActive")
	if okTut and tutorialActive == true then
		if not launchToldLater and owner then
			launchToldLater = true
			UI.Toast(T("soc.launchLater", owner.DisplayName), "Info")
		end
		return
	end
	launchHandled = true
	if s.LaunchVisitHere ~= true or not owner then
		UI.Toast(T("soc.launchGone"), "Info")
		return
	end
	task.spawn(function()
		ctx.RequestFull("TowerVisit", { UserId = target })
	end)
end

-- Gruppe „AKYTEX Games“ im Spiel beitreten (Roblox-Dialog); der Server prüft die Mitgliedschaft danach selbst nach
local function joinGroup()
	local s = social()
	local groupId = math.floor(num(s.GroupId, 0))
	if groupId <= 0 or s.Group == true or busy then
		return
	end
	busy = true
	task.spawn(function()
		local ok, status = pcall(function()
			return GroupService:PromptJoinAsync(groupId)
		end)
		busy = false
		if not ok then
			UI.Toast(T("soc.groupJoinFailed"), "Error")
		elseif status == Enum.GroupMembershipStatus.Joined or status == Enum.GroupMembershipStatus.AlreadyMember then
			UI.Toast(T("soc.groupJoinWait"), "Success")
		end
	end)
end

-- ---------------------------------------------------------------------
-- 4) RADIALMENÜ (Taste R / Touch-Knopf / Controller): 5 Reaktionen + 4 Emotes im Kreis
-- ---------------------------------------------------------------------
local function closeWheel()
	local frame = wheel
	if frame and frame.Visible then
		frame.Visible = false
		if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(frame) then
			GuiService.SelectedObject = nil
		end
	end
end

local function buildWheel(): Frame
	local frame: Frame = UI.Create("Frame", {
		Name = "ReactionWheel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(WHEEL_SIZE, WHEEL_SIZE),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.25,
		Visible = false,
		ZIndex = 50,
		Parent = ctx.Gui,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.Stroke(Theme.Border, 1) })
	UI.Create("UIScale", { Name = "Pop", Scale = 1, Parent = frame })
	local items: { { Text: string, Sub: string, Fn: () -> () } } = {}
	for _, entry in ipairs(scfg().Reactions or {}) do
		local kind = entry.Key
		table.insert(items, {
			Text = entry.Emoji,
			Sub = T("soc.react." .. kind),
			Fn = function()
				react(kind)
			end,
		})
	end
	for _, name in ipairs(scfg().Emotes or {}) do
		table.insert(items, {
			Text = EMOTE_ICONS[name] or "🙂",
			Sub = T("soc.emote." .. name),
			Fn = function()
				emote(name)
			end,
		})
	end
	local first: GuiObject? = nil
	for i, item in ipairs(items) do
		local angle = math.rad(-90 + (i - 1) * 360 / #items)
		local button = UI.Button({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(
				0.5,
				math.floor(math.cos(angle) * WHEEL_RADIUS),
				0.5,
				math.floor(math.sin(angle) * WHEEL_RADIUS)
			),
			Size = UDim2.fromOffset(WHEEL_BUTTON, WHEEL_BUTTON),
			Text = item.Text,
			Sub = item.Sub,
			SubMax = 11,
			MaxText = 28,
			Variant = "Secondary",
			Corner = 14,
			ZIndex = 51,
			Parent = frame,
		}, function()
			item.Fn()
			closeWheel()
		end)
		if not first then
			first = button.Button
		end
	end
	UI.Button({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(64, 64),
		Text = "✕",
		Variant = "Ghost",
		ZIndex = 51,
		Parent = frame,
	}, closeWheel)
	ui.WheelFirst = first
	return frame
end

function Social.ToggleWheel()
	local frame = wheel or buildWheel()
	wheel = frame
	if frame.Visible then
		closeWheel()
		return
	end
	frame.Visible = true
	local pop = frame:FindFirstChild("Pop")
	if pop and pop:IsA("UIScale") then
		pop.Scale = 0.8
		TweenService:Create(pop, POP_INFO, { Scale = 1 }):Play()
	end
	local okInput, input = call("Controls", "Input")
	if okInput and input == "Gamepad" and ui.WheelFirst then
		GuiService.SelectedObject = ui.WheelFirst
	end
	wheelToken += 1
	local mine = wheelToken
	task.delay(WHEEL_AUTO_CLOSE, function()
		if wheelToken == mine then
			closeWheel()
		end
	end)
end

-- ---------------------------------------------------------------------
-- 5) FENSTER: Spieler · Reaktionen · Einladen
-- ---------------------------------------------------------------------
local function newPage(key: string, order: number): Frame
	local page: Frame = UI.Create("Frame", {
		Name = "Page_" .. key,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Visible = false,
		Parent = window.Content,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }) })
	pages[key] = page
	return page
end

local function showTab(key: string)
	tab = key
	for name, page in pairs(pages) do
		page.Visible = name == key
	end
end

local function buildPeople(page: Frame)
	ui.RespektStats = text(page, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, Face = "Mono", MaxText = 14 })
	ui.FriendStats = text(page, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 2, Face = "Mono", MaxText = 14 })
	ui.RespektHint = text(page, {
		Size = UDim2.new(1, 0, 0, 34),
		LayoutOrder = 3,
		Face = "Body",
		TextWrapped = true,
		MaxText = 13,
		TextColor3 = Theme.Muted,
	})
	ui.People = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 4,
		Parent = page,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }) })
end

local function refreshPeople()
	local s = social()
	local mult = ctx.Config.Tower and ctx.Config.Tower.Mult or {}
	local active = math.floor(num(s.RespektActive, 0))
	local friends = math.floor(num(s.Friends, 0))
	ui.RespektStats.Text = T("soc.respektActive", active, decimal(active * num(mult.RespektStep, 0.01)))
		.. "  ·  "
		.. T("soc.respektWeek", math.floor(num(s.RespektWeek, 0)))
		.. "  ·  "
		.. T("soc.respektGivenToday", math.floor(num(s.RespektGivenToday, 0)))
	ui.FriendStats.Text =
		T("soc.friends", friends, decimal(math.min(friends, num(mult.FriendMax, 4)) * num(mult.FriendStep, 0.1)))
	ui.RespektHint.Text = if s.SocialReady == false then T("soc.respektSession") else T("soc.respektInfo")
	local given = type(s.RespektGiven) == "table" and s.RespektGiven or {}
	local others: { Player } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			table.insert(others, p)
		end
	end
	table.sort(others, function(a, b)
		return a.DisplayName < b.DisplayName
	end)
	local parts = { lang(), tostring(s.SocialReady), tostring(reportFor) }
	for _, p in ipairs(others) do
		table.insert(
			parts,
			table.concat({
				p.UserId,
				tostring(given[tostring(p.UserId)]),
				tostring(p:GetAttribute("Title")),
				tostring(p:GetAttribute("Licence")),
			}, ":")
		)
	end
	local sig = table.concat(parts, "|")
	if sig == peopleSig then
		return
	end
	peopleSig = sig
	clear(ui.People)
	if #others == 0 then
		text(ui.People, {
			Size = UDim2.new(1, 0, 0, 36),
			LayoutOrder = 1,
			Text = T("soc.noPlayers"),
			MaxText = 15,
			TextColor3 = Theme.Muted,
		})
		return
	end
	for i, p in ipairs(others) do
		local reporting = reportFor == p.UserId
		local card = UI.RowCard(ui.People, i, if reporting then 104 else 60)
		local avatar = UI.Create("ImageLabel", {
			Position = UDim2.fromOffset(10, 8),
			Size = UDim2.fromOffset(44, 44),
			BackgroundColor3 = Theme.Bg2,
			Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", math.max(1, p.UserId)),
			Parent = card,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
		avatar.ScaleType = Enum.ScaleType.Crop
		UI.Label({
			Position = UDim2.fromOffset(64, 8),
			Size = UDim2.new(1, -350, 0, 24),
			Text = p.DisplayName,
			Face = "BodyBold",
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 16,
			Parent = card,
		})
		local sub = titleName(p:GetAttribute("Title"))
		local licence = licenceName(p:GetAttribute("Licence"))
		UI.Label({
			Position = UDim2.fromOffset(64, 32),
			Size = UDim2.new(1, -350, 0, 20),
			Text = if sub ~= "" and licence ~= "" then sub .. "  ·  " .. licence else sub .. licence,
			TextColor3 = Theme.Gold,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 13,
			Parent = card,
		})
		local actions = UI.RowActions(card, 276)
		actions.Position = UDim2.new(1, -8, 0, 30) -- obere Zeile (auch wenn darunter die Melde-Gründe stehen)
		actions.Size = UDim2.new(0, 276, 0, 48)
		local userId = p.UserId
		local done = given[tostring(userId)] == true
		UI.Button({
			Size = UDim2.fromOffset(110, 40),
			Text = if done then T("soc.btn.respektDone") else T("soc.btn.respekt"),
			Variant = if done or s.SocialReady == false then "Muted" else "Success",
			LayoutOrder = 1,
			Parent = actions,
		}, function()
			if done or busy then
				return
			end
			busy = true
			task.spawn(function()
				ctx.RequestFull("SocialRespekt", { UserId = userId })
				busy = false
			end)
		end)
		UI.Button({
			Size = UDim2.fromOffset(110, 40),
			Text = T("soc.btn.visit"),
			Variant = "Secondary",
			LayoutOrder = 2,
			Parent = actions,
		}, function()
			ctx.Windows.Close("Social")
			ctx.Request("TowerVisit", { UserId = userId })
		end)
		-- Melden (Speed/Fly/Exploit/Toxic/Other): Gründe klappen in der Zeile auf, der Server hängt einen Schnappschuss an
		UI.Button({
			Size = UDim2.fromOffset(40, 40),
			Text = "⚑",
			Variant = if reporting then "Secondary" else "Ghost",
			LayoutOrder = 3,
			Parent = actions,
		}, function()
			reportFor = if reportFor == userId then nil else userId
			peopleSig = ""
			refreshPeople()
		end)
		if reporting then
			local strip = UI.Create("Frame", {
				Position = UDim2.fromOffset(64, 62),
				Size = UDim2.new(1, -72, 0, 34),
				BackgroundTransparency = 1,
				Parent = card,
			}, {
				UI.Create("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 6),
				}),
			})
			text(strip, {
				Size = UDim2.fromOffset(96, 30),
				LayoutOrder = 0,
				Text = T("soc.report.title"),
				MaxText = 12,
				TextColor3 = Theme.Muted,
			})
			for order, reason in ipairs(REPORT_REASONS) do
				UI.Button({
					Size = UDim2.fromOffset(78, 30),
					Text = T("soc.report." .. reason),
					Variant = "Secondary",
					MaxText = 12,
					LayoutOrder = order,
					Parent = strip,
				}, function()
					if reportBusy then
						return
					end
					reportBusy = true
					reportFor = nil
					peopleSig = ""
					refreshPeople()
					task.spawn(function()
						ctx.RequestFull("Report", { UserId = userId, Reason = reason }) -- Antwort kommt als Toast
						reportBusy = false
					end)
				end)
			end
		end
	end
end

local function buildReact(page: Frame)
	text(page, {
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = 1,
		Text = T("soc.reactHint"),
		MaxText = 13,
		TextColor3 = Theme.Muted,
	})
	local grid = UI.Grid(page, 2, 112, 70)
	for i, entry in ipairs(scfg().Reactions or {}) do
		local kind = entry.Key
		UI.Button({
			LayoutOrder = i,
			Text = entry.Emoji,
			Sub = T("soc.react." .. kind),
			MaxText = 26,
			Variant = "Secondary",
			Parent = grid,
		}, function()
			react(kind)
		end)
	end
	local emotes = UI.Grid(page, 3, 112, 50)
	for i, name in ipairs(scfg().Emotes or {}) do
		UI.Button({
			LayoutOrder = i,
			Text = T("soc.emote." .. name),
			MaxText = 15,
			Variant = "Ghost",
			Parent = emotes,
		}, function()
			emote(name)
		end)
	end
	UI.Section(page, T("soc.btn.show"), 4, Theme.Accent)
	text(page, {
		Size = UDim2.new(1, 0, 0, 36),
		LayoutOrder = 5,
		Text = T("soc.showInfo"),
		Face = "Body",
		TextWrapped = true,
		MaxText = 13,
		TextColor3 = Theme.Text2,
	})
	local row = UI.Row(page, 6, 46)
	UI.Button(
		{ Size = UDim2.fromOffset(220, 44), Text = T("soc.btn.show"), Variant = "Primary", Parent = row },
		showMyCard
	)
end

local function buildInvite(page: Frame)
	ui.InviteInfo = text(page, {
		Size = UDim2.new(1, 0, 0, 58),
		LayoutOrder = 1,
		Face = "Body",
		TextWrapped = true,
		MaxText = 13,
		TextColor3 = Theme.Text2,
	})
	ui.InviteCount = text(page, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 2, Face = "Mono", MaxText = 14 })
	local row = UI.Row(page, 3, 46)
	ui.InviteButton = UI.Button({
		Size = UDim2.fromOffset(240, 44),
		Text = T("soc.btn.invite"),
		Variant = "Primary",
		Parent = row,
	}, invite)
	ui.InviteLocked = text(row, { Size = UDim2.new(1, -260, 1, 0), MaxText = 13, TextColor3 = Theme.Muted })
	UI.Section(page, T("soc.groupTitle"), 4, Theme.Gold)
	local groupRow = UI.Row(page, 5, 46)
	ui.Group = text(groupRow, {
		Size = UDim2.new(1, -250, 1, 0),
		LayoutOrder = 1,
		Face = "Body",
		TextWrapped = true,
		MaxText = 13,
	})
	ui.GroupButton = UI.Button({
		Size = UDim2.fromOffset(230, 44),
		Text = T("soc.btn.joinGroup"),
		Variant = "Secondary",
		LayoutOrder = 2,
		Parent = groupRow,
	}, joinGroup)
	UI.Section(page, T("soc.btn.notify"), 6, Theme.Cyan)
	text(page, {
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = 7,
		Text = T("soc.notifyInfo"),
		Face = "Body",
		TextWrapped = true,
		MaxText = 13,
		TextColor3 = Theme.Text2,
	})
	local notifyRow = UI.Row(page, 8, 46)
	ui.NotifyButton = UI.Button({
		Size = UDim2.fromOffset(260, 44),
		Text = T("soc.btn.notify"),
		Variant = "Secondary",
		Parent = notifyRow,
	}, function()
		Social.PromptNotify(true)
	end)
	ui.NotifyState = text(notifyRow, { Size = UDim2.new(1, -280, 1, 0), MaxText = 13, TextColor3 = Theme.Up })
end

local function refreshInvite()
	local s = social()
	ui.InviteInfo.Text = T("soc.inviteInfo") .. " " .. T("soc.inviteVisitInfo")
	ui.InviteCount.Text = T(
		"soc.inviteCount",
		math.floor(num(s.ReferralCount, 0)),
		math.floor(num(s.ReferralMax, num(scfg().Referral and scfg().Referral.WeeklyMax, 10)))
	)
	local allowed = s.InviteAllowed == true
	ui.InviteButton.SetVariant(if allowed then "Primary" else "Muted")
	ui.InviteLocked.Text = if allowed then "" else T("soc.inviteLocked", math.floor(num(scfg().InviteFromStage, 3)))
	if num(s.GroupId, 0) <= 0 then
		ui.Group.Text = T("soc.groupOff")
		ui.Group.TextColor3 = Theme.Muted
	elseif s.Group == true then
		ui.Group.Text = T("soc.groupMember")
		ui.Group.TextColor3 = Theme.Gold
	else
		ui.Group.Text = T("soc.groupInfo")
		ui.Group.TextColor3 = Theme.Text2
	end
	ui.GroupButton.Frame.Visible = num(s.GroupId, 0) > 0 and s.Group ~= true
	ui.NotifyState.Text = if s.NotifOptIn == true then T("soc.notifyOn") else ""
end

function Social.Refresh()
	if not window or not window.IsOpen then
		return
	end
	if tab == "people" then
		refreshPeople()
	elseif tab == "invite" then
		refreshInvite()
	end
end

local function buildWindow()
	window = UI.Window(T("soc.win"), WINDOW_W, WINDOW_H, Theme.Pink)
	segmented = UI.Segmented(window.Content, {
		{ Key = "people", Text = T("soc.tab.people") },
		{ Key = "react", Text = T("soc.tab.react") },
		{ Key = "invite", Text = T("soc.tab.invite") },
	}, function(key: string)
		showTab(key)
		Social.Refresh()
	end)
	segmented.Frame.LayoutOrder = 0
	buildPeople(newPage("people", 1))
	buildReact(newPage("react", 2))
	buildInvite(newPage("invite", 3))
	showTab(tab)
end

local function openWindow()
	if not window then
		buildWindow()
	end
	segmented.Set(tab, true)
	showTab(tab)
	peopleSig = ""
	UI.OpenWindow(window)
	Social.Refresh()
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
end

function Social.Open()
	ctx.Windows.Open("Social")
end

function Social.Init(context: any)
	ctx = context
	ctx.Windows.Register("Social", openWindow, closeWindow)
end

function Social.Start()
	for _, p in ipairs(Players:GetPlayers()) do
		watchPlayer(p)
	end
	Players.PlayerAdded:Connect(function(p: Player)
		watchPlayer(p)
		Social.Refresh()
	end)
	Players.PlayerRemoving:Connect(function(p: Player)
		unwatch(p)
		Social.Refresh()
	end)
	ctx.Hooks.On("State", function(_state: any, changed: any)
		if type(changed) ~= "table" then
			return
		end
		if changed.Social then
			Social.Refresh()
		end
		-- bis der Besuch erledigt ist, bei jedem State-Wechsel prüfen: das Tutorial entscheidet evtl. erst später
		-- (Tick, Plot-Wartezeit) – ein reiner Social/Flags-Filter verpasste den Besuch für Wiederkehrer
		if not launchHandled then
			checkLaunchVisit()
		end
	end)
	ctx.Hooks.On("Settings", function()
		peopleSig = ""
		for p, watch in pairs(watches) do
			updatePlate(p, watch)
		end
	end)
	local okBind = call("Controls", "Bind", "React", function(state: string)
		if state == "Begin" then
			Social.ToggleWheel()
		end
	end)
	if not okBind then
		warn("[Social] Controls.Bind(React) nicht verfügbar – Reaktions-Rad nur über das Fenster")
	end
end

return Social
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="156">
            <Properties>
              <string name="Name">Terminal</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – ΛKYTEX Terminal: drei Schichten, Handy/PC/Controller, Order-Ticket, Charts, Analyse
--  (Client/Modules/Terminal)
--  Besitzer: WP5 (Charts, Terminal, Markt-UI). Vertrag: DESIGN.md §B7.1–§B7.6 (komplett), §0.3 (Markt ≠ Glücksspiel:
--  Chips 10 % · 25 % · Max, Bestätigung ab 20 %, kein Hebel/keine Optionen), §B8.6 (Übungsaktie ACAD), §C7.3 (Fenster
--  "Terminal" als eigener Frame über Windows.Register), §C7.2 (Hook "Terminal:Instrument"), §C9 (TradePlace,
--  TradeBasket, TradeWatch, AlertSet, MktProfile, TutorialTrade), §C16 (≤ 900 GuiObjects je Chart, < 0,3 ms/Frame).
--
--  Schichten (Lizenz, §B7.2): Einfach (Azubi I–II: Firmen-Karten, Linien-Chart, Chips, „Schutz an“, Tiko-Ampel,
--  Glossar, Klumpen-Warnung) · ab Azubi III Kerzen + SMA/EMA · Trader (ab Trader I: alle Zeitrahmen, Indikatoren laut
--  §B7.5, Kalender, Sektor-Heatmap, Themen-Körbe, Nachzieh-Stopp, freier Betrag, Split 1×2) · Profi (ab Fondsmanager I:
--  Heikin-Ashi, Markttiefe + Umsätze „simuliert“, Fundamentaldaten, Analysten-Trefferquoten, Korrelation,
--  Performance-Analyse; Tiko-Ampel aus; Multi-Chart 2×2 über Know-how). Instrumente/Ordertypen/Indikatoren immer
--  lizenz-gefiltert (Azubi sieht nur 12 Werte + AKX36). Alles nur über Lizenz + Know-how, NIE über Robux (§0.4).
--  Layouts: PC (≥ 1100 × 680 px, Maus) = Watchlist links · Chart Mitte · Ticket + News rechts · Tabs unten;
--  Handy = Vollbild-Sheet mit 4 Tabs Chart · Order · Depot · News und fester Kauf/Verkauf-Leiste (Knöpfe ≥ 64 px echte
--  Pixel), Wischen wechselt den Wert; Controller = Steuerkreuz Watchlist/Fadenkreuz, LB/RB Zeitrahmen, A Kauf-Sheet,
--  X Verkauf-Sheet, Y Schutz-Paar, B zurück, rechter Stick Fadenkreuz (ContextActionService nur solange offen –
--  die Controls-Aktionsliste kennt diese Terminal-Knöpfe nicht, siehe Abweichungen im Bericht).
--
--  Öffentliche API (§C7.5):
--    Terminal.Open()   Terminal.OpenAt(instId)   Terminal.IsOpen()
--  Zusätzlich: Terminal.OpenTicket(instId, side) · Terminal.ShowTab(tab) · Terminal.OpenPractice() ·
--    Terminal.Selected(): number? · Terminal.Frame(dt) · Terminal.Init(ctx) · Terminal.Start()
-- =====================================================================

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PortfolioMath = require(Shared:WaitForChild("Market"):WaitForChild("PortfolioMath"))

local Terminal = {}

local Theme = UI.Theme
local WHITE = Color3.new(1, 1, 1)

local ALL_TF = { "1s", "5s", "1m", "5m", "15m", "1T", "1W" }
local SIMPLE_TF = { "5s", "1m", "15m", "1T" }
local TYPES_BASE = { "MKT", "LMT", "STP", "TP", "OCO" }
local TYPE_KEY: { [string]: string } = {
	MKT = "trade.typeMKT",
	LMT = "trade.typeLMT",
	STP = "trade.typeSTP",
	TP = "trade.typeTP",
	OCO = "trade.typeOCO",
	TRL = "trade.typeTRL",
}
local EXPLAIN_KEY: { [string]: string } = {
	LMT = "trade.explainLMT",
	STP = "trade.explainSTP",
	TP = "trade.explainTP",
	OCO = "trade.explainOCO",
	TRL = "trade.explainTRL",
	MKT = "term.explainMKT",
}
local SELL_ONLY: { [string]: boolean } = { TP = true, OCO = true, TRL = true }
local PANE_INDICATORS: { [string]: boolean } = { RSI = true, MACD = true, Stoch = true, ATR = true }
local SECTOR_ETF: { [string]: number } = { T = 41, E = 42, M = 43, K = 44, G = 45, F = 46 }
local GLOSS_COUNT = 8
local GLOSS_EVERY = 12
local PC_MIN = Vector2.new(1100, 680)
local PAD_PRIORITY = Enum.ContextActionPriority.High.Value + 100
local PAD_ACTION = "AT5_TerminalPad"
local STICK_REPEAT = 0.12
local PROFILE_TTL = 30
local CALENDAR_EVERY = 5
local ANALYSIS_EVERY = 1
local OPEN_INFO = TweenInfo.new(0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local SHEET_INFO = TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local CLOSE_INFO = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local ctx: any = nil

-- Zustand, der Neuaufbauten überlebt
local sel: number? = nil
local listMode = "All" -- All | Watch | Depot
local watchIndex = 1
local phoneTab = "Chart"
local bottomTab = "Positions"
local phoneDepotTab = "Overview"
local phoneNewsTab = "News"
local chartMode = "Single" -- Single | Split | Multi
local ampelOn = true
local alarmMode = false
local ticket = {
	Type = "MKT",
	Chip = "10", -- "10" | "25" | "Max"
	Amount = "Chip", -- Chip | Qty | Aky
	AmountText = "",
	Lim = "",
	Stp = "",
	Tp = "",
	Trl = "5",
	Protect = true,
	Exp = "24H",
	Busy = false,
}

-- Oberfläche (wird bei jedem Neuaufbau ersetzt)
local ui: { [string]: any } = {}
local views: { { View: any, I: number, Tf: string, Untrack: () -> (), Stale: boolean?, Role: string? } } = {}
local layoutKind = "PC"
local builtKey = ""
local isOpen = false
local openToken = 0
local padBound = false
local stickX = 0
local stickClock = 0
local glossIndex = 1
local glossClock = 0
local calendarClock = 0
local analysisClock = 0
local profileCache: { [number]: { At: number, Profile: any } } = {}
local profileBusy: { [number]: boolean } = {}
local tape: { { T: number, C: number, V: number, Up: boolean } } = {}
local practiceWanted = false
local practiceBought = false
local practiceDoneAt = -math.huge
local pendingConfirm: { [string]: any }? = nil
local sheetSide: string? = nil
local correlation: { I: number, Ref: number, Value: number?, At: number }? = nil

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function call(name: string, fnName: string, ...: any): (boolean, any, any, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil, nil, nil
	end
	return pcall(fn, ...)
end

local function num(v: any, fallback: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else fallback
end

local function aky(cents: number, compact: boolean?): string
	local ok, text = pcall(ctx.Format.Aky, cents, lang(), compact)
	return if ok then text else tostring(math.floor(cents / 100))
end

local function price(cents: number): string
	local ok, text = pcall(ctx.Format.Price, cents, lang())
	return if ok then text else string.format("%.2f", cents / 100)
end

local function pct(fraction: number, digits: number?): string
	local ok, text = pcall(ctx.Format.Pct, fraction, lang(), digits or 2, true)
	return if ok then text else string.format("%+.2f %%", fraction * 100)
end

-- ganze Zahl mit Tausender-Trennung (DE 12.500 · EN 12,500) – Stückzahlen
local function int(n: number): string
	local ok, text = pcall(ctx.Format.Int, math.floor(num(n, 0)), lang())
	return if ok and type(text) == "string" then text else tostring(math.floor(num(n, 0)))
end

-- Dezimalzahl in Landesschreibweise (DE mit Komma)
local function decimal(v: number, places: number): string
	local text = string.format("%." .. places .. "f", num(v, 0))
	if lang() == "de" then
		text = (string.gsub(text, "%.", ","))
	end
	return text
end

local function setText(label: TextLabel?, text: string)
	if label and label.Text ~= text then
		label.Text = text
	end
end

local function sfx(role: string)
	call("Sfx", "Play", role)
end

local function state(): { [string]: any }
	return ctx.State
end

local function depot(): { [string]: any }
	local d = state().Depot
	return if type(d) == "table" then d else {}
end

local function settings(): { [string]: any }
	local ok, value = call("Settings", "Get")
	if ok and type(value) == "table" then
		return value
	end
	local s = state().Settings
	if type(s) == "table" then
		return s
	end
	local client = ctx.Config.Client
	return if type(client) == "table" and type(client.DefaultSettings) == "table" then client.DefaultSettings else {}
end

local function reducedFx(): boolean
	return settings().ReducedFx == true
end

local function licence(): number
	local ok, value = call("MarketClient", "Licence")
	return if ok and type(value) == "number" then value else 1
end

local function licenceDef(): { [string]: any }
	local ok, def = call("MarketClient", "LicenceDef")
	return if ok and type(def) == "table" then def else {}
end

local function layer(): string
	local ok, value = call("MarketClient", "Layer")
	return if ok and type(value) == "string" then value else "Simple"
end

local function perks(): { [string]: any }
	local ok, value = call("MarketClient", "Perks")
	return if ok and type(value) == "table" then value else {}
end

local function trading(): { [string]: any }
	local t = ctx.Config.Trading
	return if type(t) == "table" then t else {}
end

local function traderFrom(): number
	return math.floor(num(trading().TraderFrom, 4))
end

local function instOf(i: number?): any
	if type(i) ~= "number" then
		return nil
	end
	local ok, inst = call("MarketClient", "Instrument", i)
	return if ok then inst else nil
end

local function tickerOf(i: number?): string
	local inst = instOf(i)
	return if type(inst) == "table" then inst.Ticker else "–"
end

local function allowed(i: number?): boolean
	if type(i) ~= "number" then
		return false
	end
	local ok, value = call("MarketClient", "Allowed", i)
	return ok and value == true
end

local function quote(i: number): (number?, number?)
	local ok, close, change = call("MarketClient", "Quote", i)
	if ok then
		return close, change
	end
	return nil, nil
end

local function bidAsk(i: number): (number?, number?, number?)
	local ok, bid, ask, mid = call("MarketClient", "BidAsk", i)
	if ok then
		return bid, ask, mid
	end
	return nil, nil, nil
end

local function halted(i: number): boolean
	local ok, value = call("MarketClient", "Halted", i)
	return ok and value == true
end

local function nav(): number
	local ok, value = call("DepotView", "Nav")
	if ok and type(value) == "number" then
		return value
	end
	return num(depot().Nav, num(depot().Cash, 0))
end

local function freeCash(): number
	local ok, value = call("DepotView", "Free")
	if ok and type(value) == "number" then
		return value
	end
	return num(depot().Cash, 0)
end

local function position(i: number): (number, number, number)
	local ok, q, avg, free = call("DepotView", "Position", i)
	if ok and type(q) == "number" then
		return q, num(avg, 0), num(free, 0)
	end
	return 0, 0, 0
end

local function nextSeq(): number
	local ok, seq = call("MarketClient", "NextSeq")
	if ok and type(seq) == "number" then
		return seq
	end
	return (math.floor(os.time()) % 2097152) * 1024
end

local function quality(key: string, fallback: number): number
	local ok, value = call("Quality", "Budget", key)
	return if ok and type(value) == "number" then value else fallback
end

local function inputKind(): string
	local ok, value = call("Controls", "Input")
	if ok and type(value) == "string" then
		return value
	end
	return if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "Touch" else "KBM"
end

local function rootScale(): number
	return UI.ScaleOf(ctx.Gui)
end

local function touchMin(): number
	local client = ctx.Config.Client
	local min = if type(client) == "table" then num(client.TouchButtonMin, 64) else 64
	return math.ceil(min / math.max(0.1, rootScale()))
end

local function watchLists(): { { number } }
	local watch = depot().Watch
	return if type(watch) == "table" then watch else { {} }
end

local function heldIds(): { number }
	local out: { number } = {}
	local pos = depot().Pos
	if type(pos) == "table" then
		for key, p in pairs(pos) do
			local i = tonumber(key)
			if i and type(p) == "table" and num(p.Q, 0) > 0 then
				table.insert(out, i)
			end
		end
	end
	table.sort(out)
	return out
end

-- ---------------------------------------------------------------------
-- FREIGABEN NACH LIZENZ (§B7.2, §B7.3, §B7.5)
-- ---------------------------------------------------------------------
local function allowedTfs(): { string }
	return if licence() >= traderFrom() then ALL_TF else SIMPLE_TF
end

local function areaFill(): boolean
	return quality("AreaFill", 0) >= 1
end

local function allowedStyles(): { string }
	local l = licence()
	local out: { string } = {}
	if l >= 3 then
		table.insert(out, "Candles")
		table.insert(out, "Hollow")
	end
	table.insert(out, "Line")
	if areaFill() then
		table.insert(out, "Area")
	end
	if layer() == "Pro" then
		table.insert(out, "HeikinAshi")
	end
	return out
end

local function allowedTypes(): { string }
	local out = table.clone(TYPES_BASE)
	if licence() >= traderFrom() then
		table.insert(out, "TRL")
	end
	return out
end

local function indicatorNames(): { string }
	local client = ctx.Config.Client
	local names = type(client) == "table" and client.IndicatorNames or nil
	return if type(names) == "table"
		then names
		else { "SMA20", "SMA50", "SMA200", "EMA9", "EMA21", "BB", "VWAP", "RSI", "MACD", "Stoch", "ATR" }
end

local function allowedIndicators(): { string }
	local map = perks().Indicators
	local out: { string } = {}
	for _, name in ipairs(indicatorNames()) do
		if type(map) == "table" and map[name] == true then
			table.insert(out, name)
		end
	end
	return out
end

local function maxLines(): number
	return if layoutKind == "Phone" then 3 else 6
end

local function currentTf(): string
	local tf = settings().ChartTf
	local list = allowedTfs()
	if type(tf) == "string" and table.find(list, tf) then
		return tf
	end
	return if table.find(list, "1m") then "1m" else list[1]
end

local function currentStyle(): string
	local style = settings().ChartType
	local list = allowedStyles()
	if type(style) == "string" and table.find(list, style) then
		return style
	end
	return list[1]
end

-- wirksame Indikatoren: Einstellung ∩ Lizenz, höchstens maxLines (Handy 3 / PC 6), nur ein Indikator-Feld
local function indicatorMap(): { [string]: boolean }
	local wanted = settings().Indicators
	local out: { [string]: boolean } = {}
	if type(wanted) ~= "table" then
		return out
	end
	local count = 0
	local paneUsed = false
	for _, name in ipairs(allowedIndicators()) do
		if wanted[name] == true and count < maxLines() then
			if PANE_INDICATORS[name] then
				if not paneUsed then
					paneUsed = true
					out[name] = true
					count += 1
				end
			else
				out[name] = true
				count += 1
			end
		end
	end
	return out
end

local function ampelVisible(): boolean
	local l = layer()
	if l == "Pro" then
		return false
	elseif l == "Trader" then
		return ampelOn
	end
	return true
end

-- ---------------------------------------------------------------------
-- TICKET-RECHNUNG (PortfolioMath – exakt wie der Server)
-- ---------------------------------------------------------------------
local function parseNumber(text: string): number?
	local raw = string.gsub(text or "", "[^%d,%.]", "")
	if raw == "" then
		return nil
	end
	-- DE: "1.234,56" -> 1234.56 · EN: "1,234.56" -> 1234.56
	local lastComma = string.find(raw, ",[^,]*$")
	local lastDot = string.find(raw, "%.[^%.]*$")
	if lastComma and (not lastDot or lastComma > lastDot) then
		raw = string.gsub(raw, "%.", "")
		raw = string.gsub(raw, ",", ".")
	else
		raw = string.gsub(raw, ",", "")
	end
	local n = tonumber(raw)
	if n and n == n and n > 0 and n < 1e12 then
		return n
	end
	return nil
end

local function priceField(text: string): number?
	local n = parseNumber(text)
	return if n then math.max(1, math.floor(n * 100 + 0.5)) else nil
end

local function maxWeight(i: number): number?
	local inst = instOf(i)
	if type(inst) == "table" and inst.Class == "ETF" then
		return nil -- ETFs sind von der Klumpen-Grenze ausgenommen
	end
	return num(licenceDef().MaxWeight, 0.30)
end

local function posCap(i: number): number
	local inst = instOf(i)
	local bases = trading().LiquidityBase
	local base = if type(bases) == "table" and type(inst) == "table" then num(bases[inst.Class], 2e8) else 2e8
	return base * num(licenceDef().PosFactor, 0.01)
end

local function refPrice(side: string, otype: string, ask: number, bid: number): number
	if side == "B" then
		if otype == "LMT" then
			return priceField(ticket.Lim) or ask
		elseif otype == "STP" then
			return math.ceil((priceField(ticket.Stp) or ask) * num(trading().BuyStopReserve, 1.05))
		end
		return ask
	end
	return bid
end

-- Anteil des gewählten Chips am Depotwert – dieselbe Quelle wie der Server (Config.Trading.Chips)
local function chipFraction(): number
	local fraction = if ticket.Chip == "25" then 0.25 else 0.10
	local chips = trading().Chips
	if type(chips) == "table" then
		fraction = num(if ticket.Chip == "25" then chips[2] else chips[1], fraction)
	end
	return fraction
end

-- geschätzte Menge, Kosten/Erlös, Gebühr, Gewicht danach
local function estimate(side: string): { [string]: any }?
	local i = sel
	if not i then
		return nil
	end
	local bid, ask, mid = bidAsk(i)
	if not bid or not ask or not mid then
		return nil
	end
	local bps = num(licenceDef().FeeBps, 10)
	local minFee = num(trading().MinFeeCents, 100)
	local otype = ticket.Type
	local total = math.max(1, nav())
	local q, _, freeQ = position(i)
	local px = refPrice(side, otype, ask, bid)
	local qty = 0
	if ticket.Amount == "Qty" then
		qty = math.floor(parseNumber(ticket.AmountText) or 0)
	elseif ticket.Amount == "Aky" then
		local cents = math.floor((parseNumber(ticket.AmountText) or 0) * 100)
		if side == "B" then
			qty = PortfolioMath.AffordableQty(math.min(cents, freeCash()), px, bps, minFee)
		else
			qty = math.min(freeQ, math.floor(cents / math.max(1, bid)))
		end
	elseif side == "B" then
		local notional: number
		if ticket.Chip == "Max" then
			notional = freeCash()
			local weight = maxWeight(i)
			if weight then
				notional = math.min(notional, math.floor(weight * total) - q * bid)
			end
		else
			notional = math.floor(chipFraction() * total)
		end
		qty = PortfolioMath.AffordableQty(math.max(0, math.min(notional, freeCash())), px, bps, minFee)
		local capLeft = posCap(i) - q * px
		qty = math.min(qty, PortfolioMath.MaxQty(px, capLeft))
	else
		if ticket.Chip == "Max" then
			qty = freeQ
		else
			qty = math.min(freeQ, math.ceil(chipFraction() * total / math.max(1, bid)))
		end
	end
	qty = math.max(0, qty)
	local gross = qty * px
	local fee = if qty > 0 then PortfolioMath.Fee(gross, bps, minFee) else 0
	local result: { [string]: any } = { Qty = qty, Px = px, Fee = fee, Bid = bid, Ask = ask, Mid = mid }
	if side == "B" then
		result.Cost = PortfolioMath.BuyCost(qty, px, bps, minFee)
		result.Spread = qty * math.max(0, ask - mid)
		result.Weight = (q * bid + gross) / total
	else
		result.Proceeds = PortfolioMath.SellProceeds(qty, bid, bps, minFee)
		result.Weight = math.max(0, (q - qty) * bid) / total
	end
	return result
end

-- ---------------------------------------------------------------------
-- BAUSTEINE
-- ---------------------------------------------------------------------
local function frame(props: { [string]: any }): Frame
	local base: { [string]: any } = { BackgroundTransparency = 1, BorderSizePixel = 0 }
	for k, v in pairs(props) do
		base[k] = v
	end
	return UI.Create("Frame", base)
end

local function text(props: { [string]: any }): TextLabel
	local base: { [string]: any } = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		FontFace = UI.Faces.Body,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return UI.Create("TextLabel", base)
end

local function panel(props: { [string]: any }): Frame
	local base: { [string]: any } = {
		BackgroundColor3 = Theme.Bg2,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return UI.Create("Frame", base, { UI.Corner(12), UI.Stroke(nil, 1) })
end

local function logo(parent: Instance, i: number, size: number, at: UDim2?): Frame
	local inst = instOf(i)
	local ok, sector = call("MarketClient", "Sector", i)
	local color = if ok and type(sector) == "table" then sector.Color else Theme.Accent
	local shape = if type(inst) == "table" and type(inst.Logo) == "table" then inst.Logo.Shape else "Circle"
	local holder = frame({
		Name = "Logo",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = at or UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(size, size),
		Parent = parent,
	})
	local body = frame({
		Name = "Shape",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(if shape == "Diamond" then 0.72 else 1, if shape == "Diamond" then 0.72 else 1),
		Rotation = if shape == "Diamond" then 45 else 0,
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		Parent = holder,
	})
	UI.Create("UICorner", {
		CornerRadius = if shape == "Circle"
			then UDim.new(0.5, 0)
			elseif shape == "Hex" then UDim.new(0.3, 0)
			else UDim.new(0.2, 0),
		Parent = body,
	})
	UI.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(color:Lerp(WHITE, 0.18), color:Lerp(Color3.new(0, 0, 0), 0.22)),
		Parent = body,
	})
	text({
		Size = UDim2.fromScale(1, 1),
		FontFace = UI.Faces.Display,
		TextSize = math.floor(size * 0.45),
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = if type(inst) == "table" and type(inst.Logo) == "table" then tostring(inst.Logo.Letter) else "?",
		ZIndex = 2,
		Parent = holder,
	})
	return holder
end

local function chip(parent: Instance, label: string, color: Color3, order: number?): Frame
	local c = UI.Chip(parent, label, color)
	if order then
		c.LayoutOrder = order
	end
	return c
end

local function rowList(parent: Instance, padding: number?, horizontal: boolean?): UIListLayout
	return UI.Create("UIListLayout", {
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, padding or 6),
		VerticalAlignment = if horizontal then Enum.VerticalAlignment.Center else Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

local function scroller(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local base: { [string]: any } = {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Muted,
		ScrollBarImageTransparency = 0.3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	}
	if props then
		for k, v in pairs(props) do
			base[k] = v
		end
	end
	return UI.Create("ScrollingFrame", base)
end

-- ---------------------------------------------------------------------
-- VORWÄRTS-DEKLARATIONEN
-- ---------------------------------------------------------------------
local selectInst: (i: number) -> ()
local refreshAll: () -> ()
local rebuild: () -> ()
local closeSheet: () -> ()

-- ---------------------------------------------------------------------
-- ORDER SENDEN (+ Bestätigung ab 20 %, Gewinn-/Verlust-Feedback §B7.6)
-- ---------------------------------------------------------------------
local function send(arg: { [string]: any })
	if ticket.Busy then
		return
	end
	ticket.Busy = true
	task.spawn(function()
		local reply = ctx.RequestFull("TradePlace", arg)
		ticket.Busy = false
		if reply.Ok then
			local fill = reply.Fill
			if type(fill) == "table" then
				sfx(if fill.Side == "B" then "Buy" else "Sell")
				if fill.Side == "S" and type(fill.Pnl) == "number" then
					call("EffectsMarket", "TradeTick", fill.Pnl, ui.SellButton and ui.SellButton.Frame or nil)
				end
			else
				sfx("UIClick")
			end
		else
			sfx("UIError")
		end
		refreshAll()
	end)
end

local function showConfirm(arg: { [string]: any }, weight: number)
	pendingConfirm = arg
	local sheet = ui.Sheet
	if not sheet then
		send(arg)
		pendingConfirm = nil
		return
	end
	sheetSide = nil
	setText(sheet.Title, T("trade.confirmSpread"))
	setText(sheet.Body, T("term.confirm.share", pct(weight, 0), tickerOf(arg.I)))
	sheet.Chips.Frame.Visible = false
	sheet.Yes.SetText(T("term.confirm.yes"))
	sheet.No.SetText(T("term.confirm.no"))
	sheet.Root.Visible = true
	sheet.Scale.Scale = 0.96
	TweenService:Create(sheet.Scale, OPEN_INFO, { Scale = 1 }):Play()
end

local function buildArg(side: string): ({ [string]: any }?, { [string]: any }?)
	local i = sel
	if not i then
		ctx.Toast(T("term.selectInst"), "Info")
		return nil, nil
	end
	if not allowed(i) then
		ctx.Toast(T("trade.notLicensed"), "Error")
		return nil, nil
	end
	if halted(i) then
		ctx.Toast(T("trade.halted"), "Info")
		return nil, nil
	end
	local otype = ticket.Type
	if side == "B" and SELL_ONLY[otype] then
		ctx.Toast(T("term.sellOnly"), "Info")
		return nil, nil
	end
	if side == "B" and otype == "STP" and licence() < traderFrom() then
		ctx.Toast(T("trade.typeLocked"), "Info")
		return nil, nil
	end
	local est = estimate(side)
	if not est then
		ctx.Toast(T("mkt.notReady"), "Info")
		return nil, nil
	end
	local arg: { [string]: any } = { I = i, Side = side, Type = otype, Seq = nextSeq() }
	if ticket.Amount == "Chip" then
		arg.Pct = if ticket.Chip == "Max" then "Max" elseif ticket.Chip == "25" then 25 else 10
	else
		if est.Qty < 1 then
			ctx.Toast(T("term.qtyInvalid"), "Error")
			return nil, nil
		end
		arg.Qty = est.Qty
	end
	if otype == "LMT" then
		arg.Lim = priceField(ticket.Lim)
	elseif otype == "STP" then
		arg.Stp = priceField(ticket.Stp)
	elseif otype == "TP" then
		arg.Tp = priceField(ticket.Tp)
	elseif otype == "OCO" then
		arg.Stp = priceField(ticket.Stp)
		arg.Tp = priceField(ticket.Tp)
	elseif otype == "TRL" then
		local trl = parseNumber(ticket.Trl)
		if trl then
			local bounds = trading().TrailBps or {}
			arg.Trl = math.clamp(math.floor(trl * 100 + 0.5), num(bounds.Min, 50), num(bounds.Max, 2000))
		end
	end
	for _, key in ipairs({ "Lim", "Stp", "Tp", "Trl" }) do
		local need = (key == "Lim" and otype == "LMT")
			or (key == "Stp" and (otype == "STP" or otype == "OCO"))
			or (key == "Tp" and (otype == "TP" or otype == "OCO"))
			or (key == "Trl" and otype == "TRL")
		if need and arg[key] == nil then
			ctx.Toast(T("term.priceInvalid"), "Error")
			return nil, nil
		end
	end
	if side == "B" and (otype == "MKT" or otype == "LMT") and ticket.Protect then
		arg.Protect = true
	end
	if otype ~= "MKT" then
		arg.Exp = if ticket.Exp == "DAY" then "DAY" else "24H"
	elseif side == "B" then
		arg.MaxPx = math.ceil(est.Ask * 1.02) -- Schutzgrenze: Kurs schlechter -> Ablehnung, nie alter Preis
	else
		arg.MinPx = math.max(1, math.floor(est.Bid * 0.98))
	end
	return arg, est
end

local function place(side: string)
	local arg, est = buildArg(side)
	if not arg or not est then
		return
	end
	local confirmAbove = num(trading().ConfirmAbove, 0.20)
	if side == "B" and num(est.Weight, 0) >= confirmAbove then
		showConfirm(arg, est.Weight)
		return
	end
	send(arg)
end

-- Schutz-Paar für die gehaltene Position (Controller Y / Knopf)
local function protectPosition()
	local i = sel
	if not i then
		return
	end
	local q, _, freeQ = position(i)
	if q <= 0 or freeQ <= 0 then
		ticket.Protect = not ticket.Protect
		ctx.Toast(T(if ticket.Protect then "term.protect" else "term.protectOff"), "Info")
		refreshAll()
		return
	end
	local bid = bidAsk(i)
	if not bid then
		return
	end
	local protect = trading().Protect or { Sl = 0.08, Tp = 0.15 }
	send({
		I = i,
		Side = "S",
		Type = "OCO",
		Pct = "Max",
		Stp = math.max(1, math.floor(bid * (1 - num(protect.Sl, 0.08)))),
		Tp = math.ceil(bid * (1 + num(protect.Tp, 0.15))),
		Exp = "24H",
		Seq = nextSeq(),
	})
end

-- ---------------------------------------------------------------------
-- SHEET (Controller-Kauf/-Verkauf und Bestätigung)
-- ---------------------------------------------------------------------
local function openSheet(side: string)
	local sheet = ui.Sheet
	if not sheet then
		return
	end
	pendingConfirm = nil
	sheetSide = side
	setText(sheet.Title, T(if side == "B" then "term.sheet.buy" else "term.sheet.sell", tickerOf(sel)))
	sheet.Chips.Frame.Visible = true
	sheet.Chips.Set(ticket.Chip)
	sheet.Yes.SetText(T("term.sheet.confirm"))
	sheet.Yes.SetVariant(if side == "B" then "Success" else "Danger")
	sheet.No.SetText(T("term.confirm.no"))
	local est = estimate(side)
	setText(sheet.Body, if est then T("term.qtyPreview", int(est.Qty), price(est.Px)) else "")
	sheet.Root.Visible = true
	sheet.Scale.Scale = 0.96
	TweenService:Create(sheet.Scale, OPEN_INFO, { Scale = 1 }):Play()
end

closeSheet = function()
	local sheet = ui.Sheet
	pendingConfirm = nil
	sheetSide = nil
	if sheet then
		sheet.Root.Visible = false
	end
end

local function confirmSheet()
	local pending = pendingConfirm
	if pending then
		closeSheet()
		send(pending)
		return
	end
	local side = sheetSide
	closeSheet()
	if side then
		local arg = buildArg(side)
		if arg then
			send(arg)
		end
	end
end

local function sheetChip(delta: number)
	local sheet = ui.Sheet
	if not sheet or not sheetSide then
		return
	end
	local order = { "10", "25", "Max" }
	local index = table.find(order, ticket.Chip) or 1
	index = math.clamp(index + delta, 1, #order)
	ticket.Chip = order[index]
	ticket.Amount = "Chip"
	sheet.Chips.Set(ticket.Chip)
	local est = estimate(sheetSide)
	setText(sheet.Body, if est then T("term.qtyPreview", int(est.Qty), price(est.Px)) else "")
end

local function buildSheet(parent: Instance)
	local root = frame({
		Name = "Sheet",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 0.45,
		BackgroundColor3 = Color3.new(0, 0, 0),
		Visible = false,
		Active = true,
		ZIndex = 60,
		Parent = parent,
	})
	local box = panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(440, 230),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.02,
		ZIndex = 61,
		Parent = root,
	})
	local scale = UI.Create("UIScale", { Parent = box })
	local title = text({
		Position = UDim2.fromOffset(20, 16),
		Size = UDim2.new(1, -40, 0, 26),
		FontFace = UI.Faces.Display,
		TextSize = 18,
		ZIndex = 62,
		Parent = box,
	})
	local body = text({
		Position = UDim2.fromOffset(20, 48),
		Size = UDim2.new(1, -40, 0, 40),
		TextWrapped = true,
		TextColor3 = Theme.Text2,
		ZIndex = 62,
		Parent = box,
	})
	local chipsHolder = frame({ Position = UDim2.fromOffset(20, 96), Size = UDim2.new(1, -40, 0, 36), Parent = box })
	local chips = UI.Segmented(chipsHolder, {
		{ Key = "10", Text = T("term.chip10") },
		{ Key = "25", Text = T("term.chip25") },
		{ Key = "Max", Text = T("trade.chipMax") },
	}, function(key: string)
		ticket.Chip = key
		ticket.Amount = "Chip"
		local side = sheetSide
		if side then
			local est = estimate(side)
			setText(body, if est then T("term.qtyPreview", int(est.Qty), price(est.Px)) else "")
		end
	end)
	local hint = text({
		Position = UDim2.new(0, 20, 1, -84),
		Size = UDim2.new(1, -40, 0, 18),
		TextSize = 12,
		TextColor3 = Theme.Muted,
		Text = T("term.sheet.padHint"),
		ZIndex = 62,
		Parent = box,
	})
	local yes = UI.Button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -16),
		Size = UDim2.new(0.5, -26, 0, 48),
		Text = T("term.sheet.confirm"),
		Variant = "Success",
		MaxText = 16,
		ZIndex = 62,
		Parent = box,
	}, confirmSheet)
	local no = UI.Button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -16),
		Size = UDim2.new(0.5, -26, 0, 48),
		Text = T("term.confirm.no"),
		Variant = "Secondary",
		MaxText = 16,
		ZIndex = 62,
		Parent = box,
	}, function()
		closeSheet()
	end)
	ui.Sheet = {
		Root = root,
		Box = box,
		Scale = scale,
		Title = title,
		Body = body,
		Chips = chips,
		Hint = hint,
		Yes = yes,
		No = no,
	}
end

-- ---------------------------------------------------------------------
-- WATCHLIST / FIRMEN-KARTEN
-- ---------------------------------------------------------------------
local function listIds(): { number }
	if listMode == "Depot" then
		local out: { number } = {}
		for _, i in ipairs(heldIds()) do
			if instOf(i) then
				table.insert(out, i)
			end
		end
		return out
	elseif listMode == "Watch" then
		local lists = watchLists()
		local list = lists[watchIndex] or {}
		local out: { number } = {}
		for _, i in ipairs(list) do
			if type(i) == "number" and allowed(i) then
				table.insert(out, i)
			end
		end
		return out
	end
	local ok, ids = call("MarketClient", "AllowedIds")
	return if ok and type(ids) == "table" then ids else {}
end

local function toggleWatch(i: number)
	local lists = watchLists()
	local count = math.max(1, math.floor(num(perks().Watchlists, 1)))
	local index = math.clamp(watchIndex, 1, count)
	local current = table.clone(lists[index] or {})
	local found = table.find(current, i)
	if found then
		table.remove(current, found)
	else
		local maxIds = num((trading().Watch or {}).MaxIds, 12)
		if #current >= maxIds then
			ctx.Toast(T("term.watch.full", maxIds), "Error")
			return
		end
		table.insert(current, i)
	end
	task.spawn(function()
		local reply = ctx.RequestFull("TradeWatch", { List = index, Ids = current })
		sfx(if reply.Ok then "UIClick" else "UIError")
	end)
end

local function isWatched(i: number): boolean
	for _, list in ipairs(watchLists()) do
		if type(list) == "table" and table.find(list, i) then
			return true
		end
	end
	return false
end

local function buildList(parent: Instance, onPick: ((i: number) -> ())?): { [string]: any }
	local simple = layer() == "Simple"
	local rowH = if simple then 64 else 52
	local holder = frame({ Name = "List", Size = UDim2.fromScale(1, 1), Parent = parent })
	local modes = UI.Segmented(holder, {
		{ Key = "All", Text = T("term.list.all") },
		{ Key = "Watch", Text = T("term.list.watchShort") },
		{ Key = "Depot", Text = T("term.list.depot") },
	}, function(key: string)
		listMode = key
		refreshAll()
	end)
	modes.Set(listMode)
	modes.Frame.Size = UDim2.new(1, 0, 0, 32)
	local watchCycler = UI.Button({
		Name = "WatchIndex",
		Position = UDim2.fromOffset(0, 38),
		Size = UDim2.new(1, 0, 0, 28),
		Text = "",
		Variant = "Ghost",
		MaxText = 13,
		Corner = 8,
		Parent = holder,
	}, function()
		local count = math.max(1, math.floor(num(perks().Watchlists, 1)))
		watchIndex = (watchIndex % count) + 1
		refreshAll()
	end)
	local list = scroller(holder, {
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 1, -40),
	})
	rowList(list, 6)
	UI.Create("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = list })
	local empty = text({
		Name = "Empty",
		Size = UDim2.new(1, 0, 0, 40),
		TextWrapped = true,
		TextSize = 13,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 0,
		Visible = false,
		Parent = list,
	})
	return {
		Holder = holder,
		Modes = modes,
		WatchCycler = watchCycler,
		List = list,
		Empty = empty,
		Rows = {},
		RowH = rowH,
		Simple = simple,
		OnPick = onPick,
		SparkClock = 0,
	}
end

local function listRow(view: { [string]: any }, index: number): { [string]: any }
	local rowH = view.RowH
	local button: TextButton = UI.Create("TextButton", {
		Name = "Row",
		Size = UDim2.new(1, 0, 0, rowH),
		BackgroundColor3 = Theme.Surface2,
		BackgroundTransparency = 0.15,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = index,
		Parent = view.List,
	}, { UI.Corner(10) })
	local stroke = UI.Create("UIStroke", {
		Color = Theme.Border,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = button,
	})
	local stripe = frame({
		Name = "Stripe",
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.new(0, 3, 1, -16),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Accent,
		Parent = button,
	})
	UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = stripe })
	local tickerLabel = text({
		Position = UDim2.fromOffset(46, if view.Simple then 8 else 6),
		Size = UDim2.new(0.45, -46, 0, 18),
		FontFace = UI.Faces.BodyBold,
		TextSize = 15,
		Parent = button,
	})
	local nameLabel = text({
		Position = UDim2.fromOffset(46, if view.Simple then 28 else 25),
		Size = UDim2.new(0.5, -46, 0, 14),
		TextSize = 11,
		TextColor3 = Theme.Muted,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = button,
	})
	local priceLabel = text({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -30, 0, if view.Simple then 8 else 6),
		Size = UDim2.new(0.4, 0, 0, 18),
		FontFace = UI.Faces.MonoBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = button,
	})
	local changeLabel = text({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -30, 0, if view.Simple then 28 else 25),
		Size = UDim2.new(0.4, 0, 0, 14),
		FontFace = UI.Faces.Mono,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		RichText = true,
		Parent = button,
	})
	local sparkHolder = frame({
		Name = "Spark",
		Position = UDim2.new(0.45, 0, 0, 6),
		Size = UDim2.new(0.18, 0, 0, 22),
		Parent = button,
	})
	local spark = UI.Sparkline(sparkHolder, 30)
	local mood = frame({
		Name = "Mood",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 46, 1, -8),
		Size = UDim2.fromOffset(8, 8),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Muted,
		Visible = view.Simple,
		Parent = button,
	})
	UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = mood })
	local moodText = text({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 58, 1, -4),
		Size = UDim2.new(0.6, -58, 0, 14),
		TextSize = 11,
		TextColor3 = Theme.Muted,
		Visible = view.Simple,
		Parent = button,
	})
	local star: TextButton = UI.Create("TextButton", {
		Name = "Star",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -4, 0.5, 0),
		Size = UDim2.fromOffset(24, 28),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.BodyBold,
		TextSize = 18,
		TextColor3 = Theme.Muted,
		Text = "☆",
		Parent = button,
	})
	local row = {
		Button = button,
		Stroke = stroke,
		Stripe = stripe,
		Ticker = tickerLabel,
		Name = nameLabel,
		Price = priceLabel,
		Change = changeLabel,
		Spark = spark,
		Mood = mood,
		MoodText = moodText,
		Star = star,
		Logo = nil :: Frame?,
		I = 0,
	}
	button.Activated:Connect(function()
		if row.I > 0 then
			sfx("UIClick")
			if view.OnPick then
				view.OnPick(row.I)
			else
				selectInst(row.I)
			end
		end
	end)
	star.Activated:Connect(function()
		if row.I > 0 then
			toggleWatch(row.I)
		end
	end)
	return row
end

local function updateList(view: { [string]: any }?, sparks: boolean)
	if not view then
		return
	end
	local ids = listIds()
	local watchCount = math.max(1, math.floor(num(perks().Watchlists, 1)))
	view.WatchCycler.Frame.Visible = listMode == "Watch" and watchCount > 1
	view.WatchCycler.SetText(T("term.list.watch", math.clamp(watchIndex, 1, watchCount)) .. "  ▸")
	local offset = if listMode == "Watch" and watchCount > 1 then 72 else 40
	if view.List.Position.Y.Offset ~= offset then
		view.List.Position = UDim2.fromOffset(0, offset)
		view.List.Size = UDim2.new(1, 0, 1, -offset)
	end
	view.Empty.Visible = #ids == 0
	setText(
		view.Empty,
		if listMode == "Watch"
			then T("term.watch.empty")
			elseif listMode == "Depot" then T("term.pos.empty")
			else T("mkt.notReady") -- noch kein Kurs-Frame (Beitritt, Markt startet)
	)
	for index, i in ipairs(ids) do
		local row = view.Rows[index]
		if not row then
			row = listRow(view, index)
			view.Rows[index] = row
		end
		local inst = instOf(i)
		if row.I ~= i then
			row.I = i
			if row.Logo then
				row.Logo:Destroy()
			end
			row.Logo = logo(row.Button, i, if view.Simple then 34 else 30, UDim2.new(0, 8, 0.5, 0))
			local ok, sector = call("MarketClient", "Sector", i)
			row.Stripe.BackgroundColor3 = if ok and type(sector) == "table" then sector.Color else Theme.Accent
			row.Spark.Set(table.create(0))
			sparks = true
		end
		setText(row.Ticker, if type(inst) == "table" then inst.Ticker else "?")
		setText(row.Name, if type(inst) == "table" then inst.Name else "")
		local close, change = quote(i)
		setText(row.Price, if close then price(close) else "–")
		if change then
			setText(
				row.Change,
				string.format(
					'<font color="%s">%s %s</font>',
					UI.ColorHex(UI.TrendColor(change)),
					UI.TrendArrow(change),
					pct(change)
				)
			)
		else
			setText(row.Change, "")
		end
		if sparks then
			local okSpark, points = call("MarketClient", "Spark", i)
			if okSpark and type(points) == "table" then
				row.Spark.Set(points)
			end
		end
		if view.Simple then
			-- Stimmungspunkt: Tiko-Ampel der letzten Meldung, sonst Tagestrend
			local okNews, item = call("NewsFeed", "LatestFor", i, true)
			local stateName = "none"
			if okNews and item then
				local okAmpel, value = call("NewsFeed", "Ampel", item)
				if okAmpel and type(value) == "string" then
					stateName = value
				end
			end
			local moodColor = Theme.Muted
			local moodKey = "term.mood.flat"
			if stateName == "up" or (stateName == "none" and change and change > 0.002) then
				moodColor, moodKey = UI.UpColor(), "term.mood.up"
			elseif stateName == "down" or (stateName == "none" and change and change < -0.002) then
				moodColor, moodKey = UI.DownColor(), "term.mood.down"
			elseif stateName == "rumor" or stateName == "expected" then
				moodColor, moodKey = Theme.Warn, "term.mood.unclear"
			end
			row.Mood.BackgroundColor3 = moodColor
			setText(row.MoodText, T(moodKey))
		end
		local watchedNow = isWatched(i)
		row.Star.Text = if watchedNow then "★" else "☆"
		row.Star.TextColor3 = if watchedNow then Theme.Gold else Theme.Muted
		local active = i == sel
		row.Stroke.Color = if active then Theme.Accent else Theme.Border
		row.Button.BackgroundColor3 = if active then Theme.Hover else Theme.Surface2
		row.Button.Visible = true
	end
	for index = #ids + 1, #view.Rows do
		local row = view.Rows[index]
		row.Button.Visible = false
	end
end

