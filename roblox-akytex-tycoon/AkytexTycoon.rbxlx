		put(
			c.List,
			g,
			{ 0.25, 3.5, 3.5 },
			0,
			6,
			0,
			"#22d3ee",
			"Neon",
			{ Shape = "Cylinder", Rot = VERTICAL, Shadow = false }
		)
	end
	return {
		{
			function(c, g)
				arm(c, g)
			end,
