	p(list, s, { 5.2, 0.2, 0.2 }, { 0, 2.8, 0 }, r.A, r.M, cyl())
	p(list, s, { 1.4, 1.8, 1.8 }, { 0, 5.7, 0 }, r.B, "Fabric", cyl({ Transparency = 0.15 }))
