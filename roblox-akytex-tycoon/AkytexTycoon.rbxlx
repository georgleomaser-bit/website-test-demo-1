-- Buchstaben ΛKYTEX: je Buchstabe die Striche { x1, y1, x2, y2 } in Zeichenreihenfolge (REUSE §8.5)
local LETTERS = {
	{ { 60, 285, 81, 227 }, { 81, 227, 102, 285 } }, -- Λ
	{ { 132, 227, 132, 285 }, { 170, 227, 134, 258 }, { 144, 250, 172, 285 } }, -- K
