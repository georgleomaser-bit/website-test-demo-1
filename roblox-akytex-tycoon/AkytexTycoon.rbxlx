R.Clock = function(list, r, s)
	p(list, s, { 1.8, 7, 1.2 }, { 0, 3.5, 0 }, r.A, r.M, { Collide = true })
	p(list, s, { 0.15, 1.5, 1.5 }, { 0, 5.9, -0.62 }, r.B, "SmoothPlastic", { Shape = "Cylinder", Rot = { 0, 90, 0 } })
	p(list, s, { 0.08, 0.6, 0.08 }, { 0, 6.1, -0.72 }, r.C, "Metal")
