        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Texte "ui." (Shared/Lang/Ui)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Nur Schlüssel mit Präfix "ui." (DESIGN §C15). Wortliste §0.7 beachtet.
--  Platzhalter wie string.format: %s = Text, %d = ganze Zahl. "%%s" überlebt die erste Ersetzung
--  (wird danach mit der Restzeit gefüllt – Pillen im HUD).
--  Inhalt: Ladebildschirm, Willkommen, HUD (Knöpfe, Tresor, Pillen, Multiplikator-Sheet), Touch-Knöpfe, Fotomodus,
--  Einstellungen (Abschnitte, jede Einstellung "ui.set.<Key>", Optionen "ui.opt.<Key>.<Wert>"), Info, Effekt-Hinweise.
--  AKYTEX-Look: keine Deko-Emojis in Titeln/Toasts (die Toast-Pill hat ihren farbigen Punkt).
-- =====================================================================

return {
	de = {
		-- Ladebildschirm (ReplicatedFirst)
