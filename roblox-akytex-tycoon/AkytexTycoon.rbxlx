	Exam = 20, -- Lizenzprüfung (außerhalb des Deckels)
	Thresholds = { 10, 30, 60, 100, 150, 210, 280, 360, 450, 550 }, -- Ruf 1 … 10 (5 Sterne mit Halben)
	DecayPct = 0.08, -- je UTC-Tag ohne zählenden Börsentag
	DecayMaxDays = 30,
