	)
end

-- Aquarium: Glasbecken, Wasser, Sockel, Deckel-Licht, Pflanzen, drei Fische (Client lässt sie schwimmen)
R.Aquarium = function(list, r, s)
	p(list, s, { 4.4, 2.6, 2 }, { 0, 1.3, 0 }, r.B, "Metal", { Collide = true })
	p(list, s, { 4.4, 2.8, 2 }, { 0, 4.0, 0 }, "#cfe3f7", "Glass", { Transparency = 0.7, Collide = true })
	p(list, s, { 4.2, 2.4, 1.8 }, { 0, 3.9, 0 }, r.A, "Glass", { Transparency = 0.55 })
	p(list, s, { 4.4, 0.2, 2 }, { 0, 5.5, 0 }, r.B, "Metal")
	p(list, s, { 4.2, 0.1, 0.2 }, { 0, 5.38, -0.85 }, "#e6f0ff", "Neon", { Shadow = false })
	p(list, s, { 0.6, 1.4, 0.6 }, { -1.4, 3.3, 0.3 }, "#2f9e5b", "Grass", { Rot = { 0, 0, 8 } })
	p(list, s, { 0.5, 1.0, 0.5 }, { 1.5, 3.1, 0.4 }, "#2f9e5b", "Grass", { Rot = { 0, 0, -10 } })
	for i = 1, 3 do
		p(
			list,
			s,
			{ 0.55, 0.32, 0.22 },
			{ -1 + (i - 1) * 0.9, 3.4 + i * 0.35, -0.2 + (i % 2) * 0.4 },
			r.C,
			"SmoothPlastic",
			{
				Tag = "Fish",
				Group = "Fish" .. i,
				Anim = "Fish",
				Shadow = false,
			}
		)
	end
end

R.ArcLamp = function(list, r, s)
	p(list, s, { 1.6, 0.4, 1.6 }, { -1.6, 0.2, 0 }, r.B, "Marble", { Collide = true })
	p(list, s, { 0.2, 5.4, 0.2 }, { -1.6, 2.9, 0 }, r.A, r.M, { Rot = { 0, 0, -12 } })
	p(list, s, { 0.2, 3.4, 0.2 }, { -0.2, 6.2, 0 }, r.A, r.M, { Rot = { 0, 0, -65 } })
	p(list, s, { 1.6, 1.0, 1.6 }, { 1.2, 6.4, 0 }, r.A, r.M, ball())
	local o = light(14, 1.2, r.C)
	o.Shape = "Ball"
	o.Tag = "Light"
	p(list, s, { 0.6, 0.6, 0.6 }, { 1.2, 5.9, 0 }, r.C, "Neon", o)
end

R.LowTable = function(list, r, s)
	p(
		list,
		s,
		{ 4, 0.3, 2.4 },
		{ 0, 1.4, 0 },
		r.A,
		r.M,
		{ Collide = true, Transparency = if r.M == "Glass" then 0.3 else 0 }
	)
	p(list, s, { 3.4, 1.25, 1.8 }, { 0, 0.62, 0 }, r.B, "Metal", { Transparency = 0.4 })
	p(list, s, { 0.5, 0.7, 0.5 }, { -1.1, 1.9, 0 }, r.C, "Ceramic", cyl())
	p(list, s, { 1.2, 0.1, 0.8 }, { 0.8, 1.6, 0.2 }, "#e6ecf5", "SmoothPlastic")
end

R.Prism = function(list, r, s)
	p(list, s, { 1.6, 1.8, 1.6 }, { 0, 0.9, 0 }, "#1f2937", "Marble", { Collide = true })
	p(list, s, { 2.2, 3.4, 2.2 }, { 0, 3.6, 0 }, r.A, r.M, { Kind = "Wedge", Transparency = 0.25, Reflectance = 0.3 })
	p(list, s, { 2.2, 3.4, 2.2 }, { 0, 3.6, 0 }, r.C, r.M, { Kind = "Wedge", Rot = { 0, 180, 0 }, Transparency = 0.45 })
	p(list, s, { 0.15, 4, 0.15 }, { 0, 3.6, -1.2 }, r.B, "Neon", { Rot = { 0, 0, 20 }, Shadow = false })
end

R.Screen = function(list, r, s)
	p(list, s, { 0.3, 2.4, 2.4 }, { 0, 0.15, 0 }, r.B, "Metal", cyl({ Collide = true }))
	p(list, s, { 0.3, 3.6, 0.3 }, { 0, 2.0, 0.3 }, r.B, "Metal")
	p(list, s, { 4.6, 2.8, 0.3 }, { 0, 4.8, 0.3 }, r.B, "Metal")
	p(list, s, { 4.3, 2.5, 0.1 }, { 0, 4.8, 0.1 }, r.A, r.M, {
		Tag = "Monitor",
		Attr = { Monitor = "Chart", Face = "Front" },
	})
	p(list, s, { 4.6, 0.12, 0.12 }, { 0, 3.35, 0.15 }, r.C, "Neon", { Shadow = false })
end

R.Bamboo = function(list, r, s)
	p(list, s, { 2.2, 2.6, 2.2 }, { 0, 1.3, 0 }, r.B, r.M, { Transparency = 0.45, Collide = true })
	for i = 1, 4 do
		local x = (i - 2.5) * 0.45
		p(list, s, { 6.4 - i * 0.4, 0.22, 0.22 }, { x, 3.4 - i * 0.2, (i % 2) * 0.3 - 0.15 }, r.A, "Wood", cyl())
	end
	p(list, s, { 1.8, 1.2, 1.8 }, { 0, 6.4, 0 }, r.C, "Grass", ball())
end

-- ΛKYTEX-Neonschild: Λ aus zwei Strichen + Ring nach logo.svg (Code, kein Upload)
R.LambdaSign = function(list, r, s)
	p(list, s, { 3.6, 3.6, 0.2 }, { 0, 4.4, 0.25 }, r.B, r.M)
	p(
		list,
		s,
		{ 0.25, 3.4, 3.4 },
		{ 0, 4.4, 0.1 },
		r.C,
		"Neon",
		{ Shape = "Cylinder", Rot = { 0, 90, 0 }, Transparency = 0.55, Shadow = false }
	)
	p(list, s, { 0.35, 2.6, 0.2 }, { -0.5, 4.3, -0.05 }, r.A, "Neon", { Rot = { 0, 0, -20 }, Shadow = false })
	p(list, s, { 0.35, 2.6, 0.2 }, { 0.5, 4.3, -0.05 }, r.A, "Neon", { Rot = { 0, 0, 20 }, Shadow = false })
	p(list, s, { 0.3, 2.6, 0.3 }, { 0, 1.3, 0.3 }, r.B, "Metal")
	p(list, s, { 0.3, 2, 2 }, { 0, 0.15, 0.3 }, r.B, "Metal", cyl({ Collide = true }))
end

R.HoloGlobe = function(list, r, s)
	p(list, s, { 0.6, 2.4, 2.4 }, { 0, 0.3, 0 }, r.B, r.M, cyl({ Collide = true }))
	p(list, s, { 0.2, 2.6, 2.6 }, { 0, 0.7, 0 }, r.A, "Neon", cyl({ Shadow = false }))
	p(
		list,
		s,
		{ 3, 3, 3 },
		{ 0, 3.4, 0 },
		r.A,
		"Neon",
		ball({ Transparency = 0.6, Group = "Holo", Anim = "Spin", Shadow = false })
	)
	p(list, s, { 0.15, 3.8, 3.8 }, { 0, 3.4, 0 }, r.C, "Neon", {
		Shape = "Cylinder",
		Rot = { 0, 0, 70 },
		Transparency = 0.3,
		Group = "Holo",
		Anim = "Spin",
		Shadow = false,
	})
end

R.PodChair = function(list, r, s)
	p(list, s, { 3, 0.8, 3 }, { 0, 0.4, 0 }, r.A, r.M, { Collide = true })
	p(list, s, { 3, 1.0, 2.6 }, { 0, 1.3, -0.1 }, r.B, "Fabric")
	p(list, s, { 3, 3.2, 1.0 }, { 0, 2.6, 1.1 }, r.A, r.M, { Kind = "Wedge", Rot = { 0, 180, 0 } })
	p(list, s, { 3.1, 0.12, 0.12 }, { 0, 0.82, -1.5 }, r.C, "Neon", { Shadow = false })
	p(list, s, { 0.12, 3, 0.12 }, { -1.5, 2.4, 1.0 }, r.C, "Neon", { Shadow = false })
end

R.Totem = function(list, r, s)
	p(list, s, { 2, 0.6, 2 }, { 0, 0.3, 0 }, r.B, r.M, { Collide = true })
	p(list, s, { 1.4, 6.4, 1.4 }, { 0, 3.8, 0 }, r.A, r.M)
	p(list, s, { 1.2, 5.6, 0.1 }, { 0, 3.8, -0.72 }, "#0b0f17", "SmoothPlastic", {
		Tag = "Monitor",
		Attr = { Monitor = "Chart", Face = "Front" },
	})
	p(list, s, { 1.5, 0.15, 1.5 }, { 0, 7.05, 0 }, r.C, "Neon", { Shadow = false })
	p(list, s, { 1.5, 0.15, 1.5 }, { 0, 0.65, 0 }, r.C, "Neon", { Shadow = false })
end

R.NeonTree = function(list, r, s)
	p(list, s, { 1.6, 0.8, 1.6 }, { 0, 0.4, 0 }, r.B, r.M, { Collide = true })
	p(list, s, { 4.4, 0.3, 0.3 }, { 0, 3.0, 0 }, r.B, r.M, cyl())
	for i = 1, 4 do
		local a = (i - 1) * 90
		p(list, s, { 0.18, 2.2, 0.18 }, { 0, 4.8, 0 }, if i % 2 == 0 then r.C else r.A, "Neon", {
			Rot = { 0, a, 40 },
			Shadow = false,
		})
	end
	p(list, s, { 2.4, 2.4, 2.4 }, { 0, 5.6, 0 }, r.A, "Neon", ball({ Transparency = 0.55, Shadow = false }))
end

R.RoboDog = function(list, r, s)
	p(list, s, { 1.6, 1.0, 2.6 }, { 0, 1.6, 0 }, r.A, r.M, { Group = "Dog", Anim = "Bob" })
	p(list, s, { 1.1, 1.0, 1.1 }, { 0, 2.3, -1.5 }, r.A, r.M, { Group = "Dog", Anim = "Bob" })
	p(list, s, { 0.9, 0.18, 0.1 }, { 0, 2.4, -2.07 }, r.C, "Neon", { Group = "Dog", Anim = "Bob", Shadow = false })
	for _, q in ipairs({ { -0.6, -0.9 }, { 0.6, -0.9 }, { -0.6, 0.9 }, { 0.6, 0.9 } }) do
		p(list, s, { 0.3, 1.2, 0.3 }, { q[1], 0.6, q[2] }, r.B, "Metal")
	end
	p(
		list,
		s,
		{ 0.2, 0.2, 1.0 },
		{ 0, 2.2, 1.6 },
		r.C,
		"Neon",
		{ Rot = { 30, 0, 0 }, Group = "Dog", Anim = "Bob", Shadow = false }
	)
end

R.LightCube = function(list, r, s)
	p(list, s, { 1.8, 0.8, 1.8 }, { 0, 0.4, 0 }, r.B, "Metal", { Collide = true })
	local o = light(12, 1.0, r.C)
	o.Transparency = 0.35
	o.Rot = { 0, 45, 0 }
	o.Group = "Cube"
	o.Anim = "Spin"
	o.Tag = "Light"
	p(list, s, { 2.4, 2.4, 2.4 }, { 0, 2.6, 0 }, r.A, r.M, o)
	p(
		list,
		s,
		{ 1.2, 1.2, 1.2 },
		{ 0, 2.6, 0 },
		r.C,
		"Neon",
		{ Rot = { 45, 45, 0 }, Group = "Cube", Anim = "Spin", Shadow = false }
	)
end

R.Console = function(list, r, s)
	p(list, s, { 3, 5.6, 2.4 }, { 0, 2.8, 0 }, r.A, r.M, { Collide = true })
	p(list, s, { 2.4, 1.8, 0.1 }, { 0, 4.3, -1.22 }, "#0b0f17", "SmoothPlastic", {
		Tag = "Monitor",
		Attr = { Monitor = "Chart", Face = "Front" },
	})
	p(list, s, { 3, 0.8, 1.2 }, { 0, 2.8, -1.6 }, r.A, r.M, { Kind = "Wedge", Rot = { 0, 180, 0 } })
	p(list, s, { 0.4, 0.4, 0.4 }, { -0.6, 3.25, -1.7 }, r.C, "Neon", ball({ Shadow = false }))
	p(list, s, { 0.4, 0.4, 0.4 }, { 0.3, 3.25, -1.7 }, r.B, "Neon", ball({ Shadow = false }))
	p(list, s, { 3.1, 0.15, 2.5 }, { 0, 5.65, 0 }, r.B, "Neon", { Shadow = false })
end

R.Chandelier = function(list, r, s)
	p(list, s, { 0.15, 1.6, 0.15 }, { 0, 7.8, 0 }, r.A, r.M)
	p(list, s, { 0.4, 3.2, 3.2 }, { 0, 6.9, 0 }, r.A, r.M, cyl())
	local o = light(16, 1.3, r.C)
	o.Tag = "Light"
	o.Shape = "Ball"
	p(list, s, { 1.0, 1.0, 1.0 }, { 0, 6.4, 0 }, r.C, "Neon", o)
	for i = 1, 6 do
		local a = (i - 1) / 6 * math.pi * 2
		p(list, s, { 0.35, 0.8, 0.35 }, { math.cos(a) * 1.4, 6.3, math.sin(a) * 1.4 }, r.B, "Glass", {
			Transparency = 0.2,
			Shadow = false,
		})
	end
	p(list, s, { 2.2, 0.3, 0.3 }, { 0, 0.15, 0 }, r.A, r.M, cyl())
end

R.Piano = function(list, r, s)
	p(list, s, { 4.2, 1.2, 4.6 }, { 0, 2.6, 0.3 }, r.A, r.M, { Collide = true })
	p(list, s, { 4.2, 1.6, 2.4 }, { 0, 3.4, 1.4 }, r.A, r.M, { Kind = "Wedge", Rot = { 0, 180, 0 } })
	p(list, s, { 3.8, 0.2, 0.8 }, { 0, 2.3, -2.2 }, r.B, "SmoothPlastic")
	p(list, s, { 3.8, 0.22, 0.25 }, { 0, 2.42, -2.0 }, "#0b0f17", "SmoothPlastic")
	for _, x in ipairs({ -1.7, 1.7 }) do
		p(list, s, { 0.4, 2.0, 0.4 }, { x, 1.0, -1.6 }, r.A, r.M, cyl())
	end
	p(list, s, { 0.4, 2.0, 0.4 }, { 0, 1.0, 2.2 }, r.A, r.M, cyl())
	p(list, s, { 4.25, 0.1, 0.1 }, { 0, 3.2, -1.95 }, r.C, "Metal")
end

R.Vase = function(list, r, s)
	p(list, s, { 1.4, 1.2, 1.4 }, { 0, 0.6, 0 }, "#1a1410", "Marble", { Collide = true })
	p(list, s, { 1.8, 1.8, 1.8 }, { 0, 2.0, 0 }, r.A, r.M, ball())
	p(list, s, { 1.6, 0.8, 0.8 }, { 0, 3.4, 0 }, r.A, r.M, cyl())
	p(list, s, { 0.15, 1.9, 1.9 }, { 0, 2.0, 0 }, r.B, "Metal", cyl())
	p(list, s, { 0.8, 0.8, 0.8 }, { 0.3, 4.6, 0 }, r.C, "Grass", ball())
	p(list, s, { 0.7, 0.7, 0.7 }, { -0.35, 4.4, 0.2 }, r.C, "Grass", ball())
end

R.Fountain = function(list, r, s)
	p(list, s, { 0.8, 4.4, 4.4 }, { 0, 0.4, 0 }, r.B, r.M, cyl({ Collide = true }))
	p(list, s, { 0.3, 3.8, 3.8 }, { 0, 0.85, 0 }, r.C, "Glass", cyl({ Transparency = 0.35, Reflectance = 0.2 }))
	p(list, s, { 2.8, 0.6, 0.6 }, { 0, 2.2, 0 }, r.A, r.M, cyl())
	p(list, s, { 0.3, 2.2, 2.2 }, { 0, 3.6, 0 }, r.A, r.M, cyl())
	p(list, s, { 1.4, 0.4, 0.4 }, { 0, 4.4, 0 }, r.C, "Neon", cyl({ Transparency = 0.4, Shadow = false }))
	p(list, s, { 0.9, 0.9, 0.9 }, { 0, 5.2, 0 }, r.A, r.M, ball())
end

R.Bonsai = function(list, r, s)
	p(list, s, { 2.6, 0.8, 1.8 }, { 0, 1.8, 0 }, r.C, r.M, { Collide = true })
	p(list, s, { 2.2, 1.4, 1.6 }, { 0, 0.7, 0 }, "#1f2937", "Wood")
	p(list, s, { 0.35, 1.6, 0.35 }, { 0, 3.0, 0 }, r.B, "Wood", { Rot = { 0, 0, 20 } })
	p(list, s, { 0.3, 1.2, 0.3 }, { 0.4, 3.6, 0 }, r.B, "Wood", { Rot = { 0, 0, -50 } })
	p(list, s, { 1.6, 0.8, 1.2 }, { -0.5, 3.9, 0 }, r.A, "Grass", ball())
	p(list, s, { 1.3, 0.7, 1.0 }, { 0.9, 4.1, 0.1 }, r.A, "Grass", ball())
end

R.SandGarden = function(list, r, s)
	p(list, s, { 4.6, 0.6, 3.4 }, { 0, 0.3, 0 }, "#3a2418", "Wood", { Collide = true })
	p(list, s, { 4.2, 0.2, 3.0 }, { 0, 0.62, 0 }, r.A, r.M)
	p(list, s, { 1.0, 0.8, 0.9 }, { -1.1, 0.9, 0.3 }, r.B, "Slate", ball())
	p(list, s, { 0.7, 0.6, 0.6 }, { 1.2, 0.85, -0.5 }, r.B, "Slate", ball())
	for i = 1, 3 do
		p(list, s, { 3.8, 0.04, 0.08 }, { 0, 0.73, -1.1 + i * 0.5 }, mix(r.A, "#ffffff", 0.3), "Sand")
	end
	p(list, s, { 0.5, 0.5, 0.5 }, { 1.5, 0.95, 1.0 }, r.C, "Grass", ball())
end

R.Lantern = function(list, r, s)
	p(list, s, { 1.8, 0.6, 1.8 }, { 0, 0.3, 0 }, r.B, r.M, { Collide = true })
	p(list, s, { 2.4, 0.6, 0.6 }, { 0, 1.8, 0 }, r.A, r.M, cyl())
	p(list, s, { 1.6, 1.4, 1.6 }, { 0, 3.6, 0 }, r.A, r.M)
	local o = light(12, 1.0, r.C)
	o.Tag = "Light"
	p(list, s, { 1.0, 1.0, 1.7 }, { 0, 3.6, 0 }, r.C, "Neon", o)
	p(list, s, { 2.4, 0.5, 2.4 }, { 0, 4.55, 0 }, r.B, r.M)
	p(list, s, { 0.8, 0.6, 0.8 }, { 0, 5.1, 0 }, r.B, r.M, ball())
end

R.WaterBowl = function(list, r, s)
	p(list, s, { 1.6, 1.6, 1.6 }, { 0, 0.8, 0 }, r.A, r.M, cyl({ Collide = true }))
	p(list, s, { 0.8, 3.8, 3.8 }, { 0, 1.9, 0 }, r.A, r.M, cyl())
	p(list, s, { 0.2, 3.4, 3.4 }, { 0, 2.32, 0 }, r.B, "Glass", cyl({ Transparency = 0.25, Reflectance = 0.3 }))
	p(list, s, { 0.6, 0.12, 0.6 }, { 0.8, 2.45, 0.4 }, r.C, "SmoothPlastic", cyl())
	p(list, s, { 0.5, 0.12, 0.5 }, { -0.6, 2.45, -0.5 }, r.C, "SmoothPlastic", cyl())
end

R.BlossomTree = function(list, r, s)
	p(list, s, { 2.2, 1.0, 2.2 }, { 0, 0.5, 0 }, "#5b5f66", "Slate", { Collide = true })
	p(list, s, { 4.6, 0.45, 0.45 }, { 0, 3.2, 0 }, r.B, r.M, cyl({ Rot = { 0, 0, 80 } }))
	p(list, s, { 0.3, 2.2, 0.3 }, { 0.6, 5.2, 0 }, r.B, r.M, { Rot = { 0, 0, -40 } })
	p(list, s, { 3, 2.0, 3 }, { -0.3, 6.0, 0 }, r.A, "Grass", ball())
	p(list, s, { 2.2, 1.6, 2.2 }, { 1.2, 6.5, 0.3 }, r.C, "Grass", ball())
	p(list, s, { 1.8, 1.4, 1.8 }, { -1.4, 5.6, -0.4 }, r.A, "Grass", ball())
	p(list, s, { 3.2, 0.06, 3.2 }, { 0, 1.03, 0 }, r.C, "SmoothPlastic", cyl())
end

R.Gong = function(list, r, s)
	p(list, s, { 0.5, 6, 0.5 }, { -2, 3, 0 }, r.B, "Wood", { Collide = true })
	p(list, s, { 0.5, 6, 0.5 }, { 2, 3, 0 }, r.B, "Wood", { Collide = true })
	p(list, s, { 4.8, 0.5, 0.5 }, { 0, 6.1, 0 }, r.B, "Wood")
	p(
		list,
		s,
		{ 0.2, 3.4, 3.4 },
		{ 0, 3.8, 0 },
		r.A,
		r.M,
		{ Shape = "Cylinder", Rot = { 0, 90, 0 }, Group = "Gong", Anim = "Swing" }
	)
	p(
		list,
		s,
		{ 0.25, 1.2, 1.2 },
		{ 0, 3.8, -0.15 },
		r.C,
		"Metal",
		{ Shape = "Cylinder", Rot = { 0, 90, 0 }, Group = "Gong", Anim = "Swing" }
	)
	p(list, s, { 4.4, 0.4, 1.4 }, { 0, 0.2, 0 }, r.B, "Wood")
end

R.Pond = function(list, r, s)
	p(list, s, { 0.6, 4.6, 4.6 }, { 0, 0.3, 0 }, r.A, r.M, cyl({ Collide = true }))
	p(list, s, { 0.2, 4.0, 4.0 }, { 0, 0.62, 0 }, r.B, "Glass", cyl({ Transparency = 0.2, Reflectance = 0.35 }))
	for i = 1, 3 do
		p(
			list,
			s,
			{ 0.6, 0.2, 0.25 },
			{ -0.8 + i * 0.5, 0.7, -0.6 + (i % 2) * 1.0 },
			if i == 2 then "#f4f6fa" else r.C,
			"SmoothPlastic",
			{
				Tag = "Fish",
				Group = "Koi" .. i,
				Anim = "Fish",
				Shadow = false,
			}
		)
	end
	p(list, s, { 0.9, 0.7, 0.8 }, { 1.6, 0.9, 1.1 }, "#8a8f98", "Slate", ball())
	p(list, s, { 0.6, 0.06, 0.6 }, { -1.1, 0.74, 0.9 }, "#3f8f3a", "SmoothPlastic", cyl())
end

R.Screenwall = function(list, r, s)
	for i = 1, 3 do
		local x = (i - 2) * 1.6
		p(
			list,
			s,
			{ 1.5, 5.6, 0.2 },
			{ x, 3.0, 0 },
			r.A,
			r.M,
			{ Rot = { 0, if i == 2 then 0 else (i - 2) * -25, 0 }, Collide = true }
		)
		p(
			list,
			s,
			{ 1.5, 0.15, 0.25 },
			{ x, 5.9, 0 },
			r.B,
			"Wood",
			{ Rot = { 0, if i == 2 then 0 else (i - 2) * -25, 0 } }
		)
	end
	p(list, s, { 0.6, 0.6, 0.6 }, { 0, 6.2, 0 }, r.C, "Grass", ball())
end

R.CalmPod = function(list, r, s)
	p(list, s, { 3.6, 0.8, 4.4 }, { 0, 0.4, 0 }, r.B, "SmoothPlastic", { Collide = true })
	p(list, s, { 3.4, 3.4, 4.2 }, { 0, 2.0, 0 }, r.A, r.M, ball())
	p(list, s, { 2.4, 1.8, 0.3 }, { 0, 2.1, -1.95 }, "#121824", "Glass", { Transparency = 0.3 })
	local o = light(10, 0.8, r.C)
	o.Tag = "Light"
	p(list, s, { 3.5, 0.15, 4.3 }, { 0, 0.85, 0 }, r.C, "Neon", o)
end

R.SkylineModel = function(list, r, s)
	p(list, s, { 4.2, 2.6, 2.6 }, { 0, 1.3, 0 }, r.A, "Marble", { Collide = true })
	p(list, s, { 4.4, 0.2, 2.8 }, { 0, 2.7, 0 }, r.B, "Neon", { Shadow = false, Transparency = 0.2 })
	local heights = { 1.6, 2.8, 4.2, 2.2, 3.4 }
	for i, h in ipairs(heights) do
		p(
			list,
			s,
			{ 0.6, h, 0.6 },
			{ (i - 3) * 0.8, 2.8 + h / 2, (i % 2) * 0.5 - 0.25 },
			if i == 3 then r.C else r.B,
			r.M,
			{
				Transparency = 0.25,
				Reflectance = 0.25,
			}
		)
	end
end

R.Bench = function(list, r, s)
	p(list, s, { 4.6, 0.4, 1.6 }, { 0, 1.6, 0 }, r.A, r.M, { Collide = true })
	p(list, s, { 4.6, 1.6, 0.3 }, { 0, 2.6, 0.65 }, r.A, r.M)
	p(list, s, { 0.3, 1.4, 1.4 }, { -2.0, 0.7, 0 }, r.A, r.M)
	p(list, s, { 0.3, 1.4, 1.4 }, { 2.0, 0.7, 0 }, r.A, r.M)
	p(list, s, { 4.6, 0.12, 0.12 }, { 0, 1.38, -0.8 }, r.B, "Neon", { Shadow = false })
	p(list, s, { 4.6, 0.12, 0.12 }, { 0, 3.42, 0.65 }, r.C, "Neon", { Shadow = false })
end

R.Palm = function(list, r, s)
	p(list, s, { 2, 1, 2 }, { 0, 0.5, 0 }, r.B, "Metal", { Collide = true })
	p(list, s, { 5.2, 0.35, 0.35 }, { 0, 3.6, 0 }, r.B, r.M, cyl())
	for i = 1, 5 do
		p(list, s, { 0.25, 2.6, 0.6 }, { 0, 6.4, 0 }, if i % 2 == 0 then r.C else r.A, "Neon", {
			Rot = { 0, (i - 1) * 72, 62 },
			Shadow = false,
		})
	end
end

R.OrbitLamp = function(list, r, s)
	p(list, s, { 0.3, 1.8, 1.8 }, { 0, 0.15, 0 }, r.B, r.M, cyl({ Collide = true }))
	p(list, s, { 3.6, 0.2, 0.2 }, { 0, 1.9, 0 }, r.B, r.M, cyl())
	local o = light(12, 1.1, r.C)
	o.Shape = "Ball"
	o.Tag = "Light"
	p(list, s, { 1.4, 1.4, 1.4 }, { 0, 4.4, 0 }, r.C, "Neon", o)
	p(list, s, { 0.15, 3.0, 3.0 }, { 0, 4.4, 0 }, r.A, "Neon", {
		Shape = "Cylinder",
		Rot = { 0, 0, 60 },
		Group = "Orbit",
		Anim = "Spin",
		Transparency = 0.2,
		Shadow = false,
	})
	p(
		list,
		s,
		{ 0.5, 0.5, 0.5 },
		{ 1.5, 4.4, 0 },
		r.A,
		"Neon",
		ball({ Group = "Orbit", Anim = "Spin", Shadow = false })
	)
end

R.Blimp = function(list, r, s)
	p(list, s, { 0.3, 1.6, 1.6 }, { 0, 0.15, 0 }, r.B, "Metal", cyl({ Collide = true }))
	p(list, s, { 0.15, 3.6, 0.15 }, { 0, 2.0, 0 }, r.B, "Metal")
	p(list, s, { 1.6, 1.6, 4.4 }, { 0, 4.6, 0 }, r.A, r.M, ball({ Group = "Blimp", Anim = "Bob" }))
	p(list, s, { 0.6, 0.5, 1.2 }, { 0, 3.7, 0 }, r.B, r.M, { Group = "Blimp", Anim = "Bob" })
	p(list, s, { 0.12, 0.9, 0.8 }, { 0, 4.9, 2.0 }, r.C, "Neon", { Group = "Blimp", Anim = "Bob", Shadow = false })
	p(list, s, { 1.65, 0.15, 2.6 }, { 0, 4.6, 0 }, r.C, "Neon", { Group = "Blimp", Anim = "Bob", Shadow = false })
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API
-- ---------------------------------------------------------------------
local cache: { [string]: { PartSpec } } = {}
local cacheCount = 0
local MAX_CACHE = 128

local function entryOf(key: string): any
	local cfg = DecorConfig
	if type(cfg) ~= "table" or type(cfg.ByKey) ~= "table" then
		return nil
	end
	return cfg.ByKey[key]
end

function DecorModels.Has(kind: string): boolean
	return R[kind] ~= nil
end

function DecorModels.Kinds(): { string }
	local list: { string } = {}
	for kind in pairs(R) do
		table.insert(list, kind)
	end
	table.sort(list)
	return list
end

function DecorModels.SpecsFor(recipe: Recipe): { PartSpec }
	local list: { PartSpec } = {}
	if type(recipe) ~= "table" or type(recipe.Kind) ~= "string" then
		return list
	end
	local builder = R[recipe.Kind] or R.Plant
	local scale = if type(recipe.S) == "number" and recipe.S == recipe.S then math.clamp(recipe.S, 0.3, 2) else 1
	local r: Recipe = {
		A = if type(recipe.A) == "string" then recipe.A else "#4f8cff",
		B = if type(recipe.B) == "string" then recipe.B else "#1a2130",
		C = if type(recipe.C) == "string" then recipe.C else "#e6ecf5",
		M = if type(recipe.M) == "string" then recipe.M else "SmoothPlastic",
	}
	builder(list, r, scale)
	while #list > MAX_PARTS do
		table.remove(list)
	end
	return list
end

function DecorModels.Specs(key: string): { PartSpec }
	local cached = cache[key]
	if cached then
		return cached
	end
	local entry = entryOf(key)
	if not entry then
		return {}
	end
	local list = DecorModels.SpecsFor(entry.Recipe)
	if cacheCount < MAX_CACHE then
		cache[key] = list
		cacheCount += 1
	end
	return list
end

-- Model mit Pivot im Ursprung (Asset-Platz -> MeshPart-Vorlage; 0/Fehler -> Code-Rezept)
function DecorModels.Build(key: string): any
	local entry = entryOf(key)
	local function recipe(): any
		local model = (Instance :: any).new("Model")
		model.Name = "Decor_" .. tostring(key)
		local origin = (CFrame :: any).identity
		for _, spec in ipairs(DecorModels.Specs(key)) do
			if TowerModels then
				TowerModels.Instantiate(spec, origin, model)
			end
		end
		model.WorldPivot = origin
		return model
	end
	local slot = if entry then entry.Asset else nil
	local here: any = script
	if slot and typeof(here) == "Instance" then
		local assetModule = here.Parent and here.Parent:FindFirstChild("AssetSlot")
		if assetModule then
			local ok, AssetSlot = pcall(require, assetModule :: any)
			if ok and type(AssetSlot) == "table" then
				local built = AssetSlot.Mesh(AssetSlot.KeyOf("Decor", key), slot, recipe)
				return built
			end
		end
	end
	return recipe()
end

-- Deko-Lieferant für TowerModels.Interior
if TowerModels and type(TowerModels.SetDecorProvider) == "function" then
	TowerModels.SetDecorProvider(DecorModels.Specs)
end

return DecorModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- =====================================================================
--  AKYTEX TYCOON – Zahlen-Anzeige DE/EN (Shared/Format)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C6.1 + §C15 (Zahlen) + Muss-Regel 9 (MAX ab 9e15).
--  Reines Modul (keine Roblox-Dienste) -> mit der Luau-CLI testbar (tests/format.test.luau).
--  DE: Tausender "." · Dezimal "," · Kürzel Tsd./Mio./Mrd./Bio./Brd. (mit Leerzeichen)
--  EN: Tausender "," · Dezimal "." · Kürzel K/M/B/T/Qa (ohne Leerzeichen)
--  Geld-Kürzel werden ABGESCHNITTEN (nie mehr anzeigen als da ist, nie "1000 Tsd."), Prozente/Multiplikatoren gerundet.
--
--  Öffentliche API:
--    Format.Credits(n, lang): string              "9.999" · "1,25 Mio." / "1.25M"; |n| ≥ 9e15 -> "MAX"
--    Format.Aky(cents, lang, compact?): string    "1.234,56 AKY" / "1,234.56 AKY"; compact ab 1.000 AKY: "1,23 Tsd. AKY" / "1.23K AKY"
--    Format.Price(cents, lang): string            "123,45" / "123.45" (mit Tausendertrennzeichen)
--    Format.Pct(fraction, lang, digits?, signed?) "+2,35 %" / "+2.35%" (fraction 0.0235; digits 0–4, Std. 2)
--    Format.Mult(x, lang): string                 "x7,4" / "x7.4" (max. 2 Nachkommastellen, Nullen weg)
--    Format.Duration(seconds, lang): string       "3:07" · "5 h 12 min" · DE "2 T 3 h" / EN "2 d 3 h"
--    Format.Compact(n, lang): string              "12,3 Tsd." / "12.3K" … bis Brd./Qa; |n| < 1000 ganzzahlig; ≥ 9e15 "MAX"
--    Format.Int(n, lang): string                  ganze Zahl mit Tausendertrennzeichen ("1.234.567")
--  Ungültige Eingaben (NaN, ±unendlich, kein number) ergeben "0" bzw. die 0-Darstellung – nie ein Fehler.
-- =====================================================================

local Format = {}

type Lang = "de" | "en"

local MAX_MONEY = 9e15
local EPS = 1e-9
local HUGE = math.huge

local SUFFIX: { [string]: { string } } = {
	de = { "Tsd.", "Mio.", "Mrd.", "Bio.", "Brd." },
	en = { "K", "M", "B", "T", "Qa" },
}

local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= HUGE and n ~= -HUGE
end

local function langOf(lang: any): Lang
	if lang == "de" then
		return "de"
	end
	return "en"
end

-- (Tausender, Dezimal)
local function separators(lang: Lang): (string, string)
	if lang == "de" then
		return ".", ","
	end
	return ",", "."
end

-- ganze Zahl ≥ 0 mit Tausendertrennzeichen
local function groupDigits(n: number, sep: string): string
	local digits = string.format("%.0f", math.floor(n))
	if #digits <= 3 then
		return digits
	end
	local head = #digits % 3
	local parts: { string } = {}
	if head > 0 then
		table.insert(parts, string.sub(digits, 1, head))
	end
	for i = head + 1, #digits, 3 do
		table.insert(parts, string.sub(digits, i, i + 2))
	end
	return table.concat(parts, sep)
end

-- "1.50" -> "1.5", "2.00" -> "2" (nur für Texte mit Punkt als Dezimalzeichen)
local function stripZeros(text: string): string
	if string.find(text, ".", 1, true) then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text
end

local function withDecimal(text: string, dec: string): string
	if dec == "." then
		return text
	end
	return (string.gsub(text, "%.", dec))
end

-- ---------------------------------------------------------------------
-- GANZE ZAHLEN & KÜRZEL
-- ---------------------------------------------------------------------
function Format.Int(n: number, lang: Lang): string
	if not finite(n) then
		return "0"
	end
	local thousands = separators(langOf(lang))
	local negative = n <= -1 -- -0,5 -> "0"
	local text = groupDigits(math.abs(n), thousands)
	return if negative then "-" .. text else text
end

function Format.Compact(n: number, lang: Lang): string
	if not finite(n) then
		return "0"
	end
	local language: Lang = langOf(lang)
	local negative = n <= -1
	local value = math.abs(n)
	if value >= MAX_MONEY then
		return if negative then "-MAX" else "MAX"
	end
	if value < 1000 then
		return Format.Int(n, language)
	end
	local suffixes = SUFFIX[language]
	-- Stufe über Vergleiche (kein wiederholtes Teilen -> keine Rundungsfehler an den Grenzen)
	local index, scale = 1, 1000
	while index < #suffixes and value * (1 + EPS) >= scale * 1000 do
		scale *= 1000
		index += 1
	end
	local v = value / scale
	local text: string
	if v >= 100 then
		text = string.format("%.0f", math.floor(v * (1 + EPS)))
	elseif v >= 10 then
		text = string.format("%.1f", math.floor(v * 10 + EPS) / 10)
	else
		text = string.format("%.2f", math.floor(v * 100 + EPS) / 100)
	end
	local _, dec = separators(language)
	text = withDecimal(stripZeros(text), dec)
	local spacer = if language == "de" then " " else ""
	return (if negative then "-" else "") .. text .. spacer .. suffixes[index]
end

-- ---------------------------------------------------------------------
-- GELD
-- ---------------------------------------------------------------------
function Format.Credits(n: number, lang: Lang): string
	if not finite(n) then
		return "0"
	end
	local value = math.abs(n)
	if value >= MAX_MONEY then
		return if n < 0 then "-MAX" else "MAX"
	end
	if value < 10000 then
		return Format.Int(n, lang)
	end
	return Format.Compact(n, lang)
end

function Format.Price(cents: number, lang: Lang): string
	local language: Lang = langOf(lang)
	local thousands, dec = separators(language)
	if not finite(cents) then
		return "0" .. dec .. "00"
	end
	local whole = math.floor(math.abs(cents) + 0.5) -- ganze Cent
	local units = math.floor(whole / 100)
	local rest = whole - units * 100
	local text = groupDigits(units, thousands) .. dec .. string.format("%02d", rest)
	return if cents < 0 and whole > 0 then "-" .. text else text
end

function Format.Aky(cents: number, lang: Lang, compact: boolean?): string
	local language: Lang = langOf(lang)
	if not finite(cents) then
		return Format.Price(0, language) .. " AKY"
	end
	if math.abs(cents) >= MAX_MONEY then
		return (if cents < 0 then "-MAX" else "MAX") .. " AKY"
	end
	if compact == true and math.abs(cents) >= 100000 then -- ab 1.000 AKY kurz
		return Format.Compact(cents / 100, language) .. " AKY"
	end
	return Format.Price(cents, language) .. " AKY"
end

-- ---------------------------------------------------------------------
-- VERHÄLTNISSE (gerundet)
-- ---------------------------------------------------------------------
function Format.Pct(fraction: number, lang: Lang, digits: number?, signed: boolean?): string
	local language: Lang = langOf(lang)
	local thousands, dec = separators(language)
	local places = if finite(digits) then math.clamp(math.floor(digits :: number), 0, 4) else 2
	local percent = if finite(fraction) then fraction * 100 else 0
	local factor = 10 ^ places
	local scaled = math.floor(math.abs(percent) * factor + 0.5)
	local units = math.floor(scaled / factor)
	local rest = scaled - units * factor
	local text = groupDigits(units, thousands)
	if places > 0 then
		text ..= dec .. string.format("%0" .. places .. "d", rest)
	end
	local sign = ""
	if scaled > 0 then
		if percent < 0 then
			sign = "-"
		elseif signed == true then
			sign = "+"
		end
	end
	local unit = if language == "de" then " %" else "%"
	return sign .. text .. unit
end

function Format.Mult(x: number, lang: Lang): string
	local language: Lang = langOf(lang)
	local _, dec = separators(language)
	if not finite(x) then
		return "x1"
	end
	local rounded = math.floor(math.abs(x) * 100 + 0.5) / 100
	local text = withDecimal(stripZeros(string.format("%.2f", rounded)), dec)
	return "x" .. (if x < 0 and rounded > 0 then "-" else "") .. text
end

-- ---------------------------------------------------------------------
-- DAUER
-- ---------------------------------------------------------------------
function Format.Duration(seconds: number, lang: Lang): string
	local language: Lang = langOf(lang)
	local total = if finite(seconds) then math.clamp(math.floor(seconds), 0, 999999999) else 0
	if total < 3600 then
		return string.format("%d:%02d", math.floor(total / 60), total % 60)
	end
	if total < 86400 then
		local h = math.floor(total / 3600)
		local m = math.floor((total % 3600) / 60)
		return string.format("%d h %d min", h, m)
	end
	local d = math.floor(total / 86400)
	local h = math.floor((total % 86400) / 3600)
	if language == "de" then
		return string.format("%d T %d h", d, h)
	end
	return string.format("%d d %d h", d, h)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Lang</string>
          <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Sprachen DE/EN (Shared/Lang)
--  Besitzer: WP1 (Kern & Plattform). Vertrag: DESIGN.md §C15 + §C6.1 (CC-Kopie 1:1, nur FILES neu).
--
--  Domänen-Dateien (jedes Paket pflegt seine, Präfix-Pflicht; gleiche Liste = LANG_PREFIX in contract_check.py):
--    Core core. (WP1) · Ui ui. (WP2) · Market mkt. · News news. (WP3) · Trade trade. (WP4) · Terminal term. (WP5) ·
--    Tower tower. (WP6) · TowerUi tui. · Life life. (WP8) · World world. · Vehicle car. (WP7) ·
--    Progress prog. · Tutorial tut. · Social soc. (WP9) · Shop shop./item. (WP10) · Admin admin. · Events evt. (WP11)
--  Jede Datei gibt { de = { [key] = text }, en = { [key] = text } } zurück. Doppelte Schlüssel -> warn.
--
--  Öffentliche API:
--    Lang.T(lang, key, ...): string      string.format(text, ...) in pcall; fehlt der Schlüssel -> Englisch -> Schlüssel
--    Lang.Pick(lang, { de, en }): string Config-Anzeigenamen
--    Lang.For(p, override?): "de" | "en" override "de"/"en" aus Einstellungen, sonst LocaleId "de…" -> "de", sonst "en"
--    Lang.Missing(): { string }          Schlüssel, die in einer Sprache fehlen (+ fehlende/kaputte Dateien)
--    Lang.Has(key): boolean
-- =====================================================================

local RunService = game:GetService("RunService")

local Types = require(script.Parent:WaitForChild("Types"))

local Lang = {}

local LANGUAGES: { Types.Lang } = { "de", "en" }
local MAX_ARGS = 16

local FILES: { { Name: string, Prefixes: { string } } } = {
	{ Name = "Core", Prefixes = { "core." } },
	{ Name = "Ui", Prefixes = { "ui." } },
	{ Name = "Market", Prefixes = { "mkt." } },
	{ Name = "News", Prefixes = { "news." } },
	{ Name = "Trade", Prefixes = { "trade." } },
	{ Name = "Terminal", Prefixes = { "term." } },
	{ Name = "Tower", Prefixes = { "tower." } },
	{ Name = "TowerUi", Prefixes = { "tui." } },
	{ Name = "World", Prefixes = { "world." } },
	{ Name = "Vehicle", Prefixes = { "car." } },
	{ Name = "Life", Prefixes = { "life." } },
	{ Name = "Progress", Prefixes = { "prog." } },
	{ Name = "Tutorial", Prefixes = { "tut." } },
	{ Name = "Social", Prefixes = { "soc." } },
	{ Name = "Shop", Prefixes = { "shop.", "item." } },
	{ Name = "Admin", Prefixes = { "admin." } },
	{ Name = "Events", Prefixes = { "evt." } },
}

local dict: { [string]: { [string]: string } } = { de = {}, en = {} }
local sourceOf: { [string]: { [string]: string } } = { de = {}, en = {} } -- Schlüssel -> Datei (für Doppelte)
local loadIssues: { string } = {}

-- Client: erst warten, bis die erste Replikation fertig ist (sonst fehlen Dateien evtl. noch)
if RunService:IsClient() and not RunService:IsServer() and not game:IsLoaded() then
	game.Loaded:Wait()
end

local function hasPrefix(key: string, prefixes: { string }): boolean
	for _, prefix in ipairs(prefixes) do
		if string.sub(key, 1, #prefix) == prefix then
			return true
		end
	end
	return false
end

local function loadFile(name: string, prefixes: { string })
	local module = script:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		table.insert(loadIssues, "Lang." .. name .. " (Datei fehlt)")
		return
	end
	local ok, result = pcall(require, module)
	if not ok or type(result) ~= "table" then
		table.insert(loadIssues, "Lang." .. name .. " (Fehler beim Laden)")
		warn("[Lang] Lang." .. name .. " konnte nicht geladen werden: " .. tostring(result))
		return
	end
	for _, lang in ipairs(LANGUAGES) do
		local entries = result[lang]
		if type(entries) ~= "table" then
			table.insert(loadIssues, ("Lang.%s.%s (Tabelle fehlt)"):format(name, lang))
			continue
		end
		local target, sources = dict[lang], sourceOf[lang]
		for key, text in pairs(entries) do
			if type(key) ~= "string" or type(text) ~= "string" then
				warn(
					("[Lang] Lang.%s.%s: Schlüssel und Text müssen Strings sein (%s)"):format(
						name,
						lang,
						tostring(key)
					)
				)
			elseif sources[key] ~= nil then
				warn(
					("[Lang] Doppelter Schlüssel %s (%s) in Lang.%s, schon in Lang.%s"):format(
						key,
						lang,
						name,
						sources[key]
					)
				)
			else
				if not hasPrefix(key, prefixes) then
					warn(
						("[Lang] Lang.%s: Schlüssel %s hat das falsche Präfix (erwartet %s)"):format(
							name,
							key,
							table.concat(prefixes, " / ")
						)
					)
				end
				target[key] = text
				sources[key] = name
			end
		end
	end
end

for _, file in ipairs(FILES) do
	loadFile(file.Name, file.Prefixes)
end

-- Text in der gewünschten Sprache; fehlt er -> Englisch -> der Schlüssel selbst.
-- Argumente wie string.format (%d, %s, …). Kaputtes Format -> Text ohne Ersetzung.
function Lang.T(lang: Types.Lang, key: string, ...: any): string
	local name = if type(key) == "string" then key else tostring(key)
	local entries = dict[lang]
	local text = (entries and entries[name]) or dict.en[name] or name
	local count = select("#", ...)
	if count == 0 and not string.find(text, "%", 1, true) then
		return text
	end
	-- nil/Tabellen/Instanzen sicher in Text verwandeln (string.format würde sonst scheitern)
	local args = table.create(math.min(count, MAX_ARGS))
	for i = 1, math.min(count, MAX_ARGS) do
		local value = select(i, ...)
		local kind = type(value)
		if kind == "number" then
			args[i] = if value == value then value else 0
		elseif kind == "string" then
			args[i] = value
		elseif value == nil then
			args[i] = ""
		else
			args[i] = tostring(value)
		end
	end
	local ok, result = pcall(string.format, text, table.unpack(args, 1, math.min(count, MAX_ARGS)))
	if ok then
		return result
	end
	return text
end

-- { de = "…", en = "…" } -> Text in der Sprache (Fallback Englisch, dann Deutsch)
function Lang.Pick(lang: Types.Lang, t: { de: string, en: string }): string
	local raw: any = t
	if type(raw) == "string" then
		return raw
	elseif type(raw) ~= "table" then
		return ""
	end
	local value = raw[lang]
	if type(value) ~= "string" then
		value = raw.en
	end
	if type(value) ~= "string" then
		value = raw.de
	end
	return if type(value) == "string" then value else ""
end

-- Sprache eines Spielers: Einstellung "de"/"en" gewinnt, sonst LocaleId ("de-de" -> "de"), sonst "en"
function Lang.For(p: Player, override: string?): Types.Lang
	if override == "de" or override == "en" then
		return override
	end
	local ok, locale = pcall(function()
		return p.LocaleId
	end)
	if ok and type(locale) == "string" and string.lower(string.sub(locale, 1, 2)) == "de" then
		return "de"
	end
	return "en"
end

function Lang.Has(key: string): boolean
	return dict.en[key] ~= nil or dict.de[key] ~= nil
end

-- Schlüssel, die in einer Sprache fehlen (sortiert) + fehlende/kaputte Dateien. Leer = alles ok.
function Lang.Missing(): { string }
	local missing: { string } = {}
	for _, lang in ipairs(LANGUAGES) do
		for _, other in ipairs(LANGUAGES) do
			if other ~= lang then
				for key in pairs(dict[other]) do
					if dict[lang][key] == nil then
						table.insert(missing, ("%s (fehlt in %s)"):format(key, lang))
					end
				end
			end
		end
	end
	table.sort(missing)
	for _, issue in ipairs(loadIssues) do
		table.insert(missing, issue)
	end
	return missing
end

return Lang
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Admin</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Texte "admin." (Shared/Lang/Admin)
