        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Core</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Texte "core." (Shared/Lang/Core)
--  Besitzer: WP1 (Kern & Plattform). Nur Schlüssel mit Präfix "core.". Vertrag: DESIGN.md §C15, §A1/§A2, §0.5.
--  Platzhalter wie string.format: %s = Text, %d = ganze Zahl.
--  Pflicht-Schlüssel (§C15): core.gameName, core.disclaimer (wörtlich §A2), core.loading, core.error, core.noAnswer,
--  core.studioNoSave, core.localMarket.
--  Vom Server benutzt: core.tooFast, core.unknownAction, core.invalid, core.studioNoApi, core.loadFailed, core.dataReset.
--  Wortliste §0.7 beachten (der Vertrags-Prüfer BANNED_WORDS scannt jeden Wert).
-- =====================================================================

