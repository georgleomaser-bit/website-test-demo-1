local function buildLicencePage(page: Frame)
	ui.Level = text(page, { Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 1, Face = "Display", MaxText = 20 })
	ui.LevelBar = UI.Bar({ Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 2, Color = Theme.Accent, Parent = page })
	ui.Mult = text(page, { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 3, MaxText = 14, TextColor3 = Theme.Gold })
	UI.Section(page, T("prog.lbl.current"), 4, Theme.Gold)
	local current = UI.Card({ Size = UDim2.new(1, 0, 0, 112), LayoutOrder = 5, Parent = page })
	UI.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 10),
		Parent = current,
	})
	UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = current })
	ui.CurName =
		text(current, { Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 1, Face = "Display", TextColor3 = Theme.Gold })
	ui.CurBasis = text(current, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 2, Face = "Mono", MaxText = 15 })
	ui.CurKurs = text(current, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 3, Face = "Mono", MaxText = 15 })
	ui.CurBonus = text(current, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 4, Face = "Mono", MaxText = 15 })
	ui.Factor = text(page, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 6, MaxText = 14, TextColor3 = Theme.Text2 })
	UI.Section(page, T("prog.lbl.next"), 7, Theme.Accent)
	ui.NextName = text(page, { Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 8, Face = "Display", MaxText = 18 })
	ui.NextBar = UI.Bar({ Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 9, Color = Theme.Gold, Parent = page })
	UI.Section(page, T("prog.lbl.tasks"), 10, Theme.Cyan)
	ui.Tasks = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 11,
		Parent = page,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }) })
	ui.TaskSig = ""
	local row = UI.Row(page, 12, 46)
	ui.ExamButton = UI.Button({
		Size = UDim2.fromOffset(240, 44),
		Text = T("prog.btn.exam"),
		Variant = "Premium",
		Parent = row,
	}, function()
		if busy then
			return
		end
		local idx = math.floor(num(prog().Licence, 1)) + 1
		busy = true
		task.spawn(function()
			ctx.RequestFull("ProgExam", { Licence = idx })
			busy = false
			Academy.Refresh()
		end)
	end)
end

local function refreshTasks(p: { [string]: any })
	local tasks = type(p.ExamTasks) == "table" and p.ExamTasks or {}
	local parts = { lang(), tostring(p.Licence) }
	for _, task in ipairs(tasks) do
		table.insert(parts, tostring(task.Key) .. tostring(task.Done))
	end
	local sig = table.concat(parts, ",")
	if sig == ui.TaskSig then
		return
	end
	ui.TaskSig = sig
	clear(ui.Tasks)
	if #tasks == 0 then
		paragraph(ui.Tasks, 1, 22, T("prog.lbl.noExam"), Theme.Muted)
		return
	end
	for i, task in ipairs(tasks) do
		local card = UI.RowCard(ui.Tasks, i, 58)
		local key = tostring(task.Key)
		UI.Label({
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.fromOffset(28, 58),
			Text = if task.Done then "✓" else "○",
			TextColor3 = if task.Done then Theme.Up else Theme.Muted,
			MaxText = 22,
			Parent = card,
		})
		UI.Label({
			Position = UDim2.fromOffset(46, 6),
			Size = UDim2.new(1, -60, 0, 24),
			Text = T("prog.exam." .. key),
			Face = "BodyBold",
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = if task.Done then Theme.Up else Theme.Text,
			MaxText = 16,
			Parent = card,
		})
		UI.Label({
			Position = UDim2.fromOffset(46, 30),
			Size = UDim2.new(1, -60, 0, 22),
			Text = T("prog.exam." .. key .. ".d"),
			Face = "Body",
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.Text2,
			MaxText = 13,
			Parent = card,
		})
	end
end

local function refreshLicence()
	local p = prog()
	local level = math.floor(num(p.Level, 1))
	local xp = num(p.Xp, 0)
	ui.Level.Text = T("prog.level", level)
	local maxLevel = num(pcfg().MaxLevel, 100)
	if level >= maxLevel then
		UI.SetBar(ui.LevelBar, 1, T("prog.xp", fmt("Int", xp, lang())))
	else
		UI.SetBar(
			ui.LevelBar,
			num(p.LevelProgress, 0),
			T("prog.lbl.xpNext", fmt("Int", xp, lang()), fmt("Int", num(p.NextLevelXp, 0), lang()))
		)
	end
	local mult = num(p.XpMult, 1)
	ui.Mult.Text = if p.PowerHour == true
		then T("prog.powerHour")
		elseif mult > 1 then T("prog.xpMult", (string.gsub(fmt("Mult", mult, lang()), "^x", "")))
		else ""
	local idx = math.floor(num(p.Licence, 1))
	local def = licenceDef(idx) or {}
	ui.CurName.Text = licenceName(idx)
	ui.CurBasis.Text = T("prog.lbl.basis", fmt("Aky", num(def.Basis, 0), lang()))
	ui.CurKurs.Text = T("prog.lbl.bauKurs", fmt("Int", num(def.BauKurs, 0), lang()))
	ui.CurBonus.Text = T("prog.lbl.towerBonus", fmt("Pct", num(def.TowerBonus, 0), lang(), 0, true))
	local factor = type(p.Factor) == "table" and p.Factor or {}
	local function mult2(v: any): string
		return (string.gsub(fmt("Mult", num(v, 1), lang()), "^x", ""))
	end
	ui.Factor.Text = T("prog.lbl.factor", mult2(factor.Total), mult2(factor.Licence), mult2(factor.Ruf))
	local maxIdx = #(pcfg().Licences or {})
	if idx >= maxIdx then
		ui.NextName.Text = T("prog.lbl.max")
		UI.SetBar(ui.NextBar, 1, "")
		ui.ExamButton.Frame.Visible = false
		refreshTasks({ Licence = idx, ExamTasks = {} })
		return
	end
	ui.NextName.Text = licenceName(idx + 1)
	local need = num(p.NextLicenceXp, 0)
	UI.SetBar(
		ui.NextBar,
		if need > 0 then xp / need else 1,
		T("prog.lbl.xpNext", fmt("Int", math.min(xp, need), lang()), fmt("Int", need, lang()))
	)
	refreshTasks(p)
	local tasksDone = true
	for _, task in ipairs(type(p.ExamTasks) == "table" and p.ExamTasks or {}) do
		if not task.Done then
			tasksDone = false
		end
	end
	ui.ExamButton.Frame.Visible = true
	ui.ExamButton.SetVariant(if xp >= need and tasksDone then "Premium" else "Muted")
end

-- ---------------------------------------------------------------------
-- 4) KNOW-HOW (Trading-Werkzeuge, nie Robux)
-- ---------------------------------------------------------------------
local function nodeRequirement(def: any, level: number): number
	if type(def.LevelLicence) == "table" and def.LevelLicence[level + 1] then
		return def.LevelLicence[level + 1]
	end
	return num(def.Licence, 1)
end

local function buildKhPage(page: Frame)
	ui.KhHeader = text(page, { Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 1, Face = "BodyBold", MaxText = 17 })
	ui.KhRows = {}
	for i, def in ipairs(pcfg().KnowHow and pcfg().KnowHow.Nodes or {}) do
		local card = UI.RowCard(page, 10 + i, 72)
		UI.Label({
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(1, -230, 0, 24),
			Text = T("prog.kh." .. def.Key),
			Face = "BodyBold",
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 17,
			Parent = card,
		})
		local desc = UI.Label({
			Position = UDim2.fromOffset(14, 34),
			Size = UDim2.new(1, -230, 0, 30),
			Text = T("prog.kh." .. def.Key .. ".d"),
			Face = "Body",
			TextWrapped = true,
			TextColor3 = Theme.Text2,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 13,
			Parent = card,
		})
		local actions = UI.RowActions(card, 210)
		local info = UI.Label({
			Size = UDim2.fromOffset(120, 40),
			Text = "",
			Face = "Mono",
			TextColor3 = Theme.Cyan,
			TextXAlignment = Enum.TextXAlignment.Right,
			MaxText = 14,
			LayoutOrder = 1,
			Parent = actions,
		})
		local key = def.Key
		local button = UI.Button({
			Size = UDim2.fromOffset(70, 40),
			Text = "+",
			Variant = "Primary",
			LayoutOrder = 2,
			Parent = actions,
		}, function()
			ctx.Request("ProgKnowHow", { Node = key })
		end)
		ui.KhRows[key] = { Def = def, Info = info, Button = button, Desc = desc }
	end
	local row = UI.Row(page, 60, 44)
	ui.KhReset = text(row, { Size = UDim2.new(1, -200, 1, 0), MaxText = 14, TextColor3 = Theme.Text2 })
	UI.Button(
		{ Size = UDim2.fromOffset(180, 42), Text = T("prog.btn.reset"), Variant = "Secondary", Parent = row },
		function()
			ctx.Request("ProgKnowHowReset", {})
		end
	)
end

local function refreshKh()
	local p = prog()
	local free = math.floor(num(p.KH, 0))
	ui.KhHeader.Text = T("prog.lbl.kh", free, math.floor(num(p.KHTotal, 0)))
	local levels = type(p.KnowHow) == "table" and p.KnowHow or {}
	local licence = math.floor(num(p.Licence, 1))
	for key, row in pairs(ui.KhRows) do
		local def = row.Def
		local level = math.floor(num(levels[key], 0))
		local max = math.floor(num(def.Max, 1))
		local cost = math.floor(num(def.Cost, 1))
		local need = nodeRequirement(def, level)
		if level >= max then
			row.Info.Text = T("prog.lbl.levelFree", level, max)
			row.Button.SetVariant("Muted")
		elseif licence < need then
			row.Info.Text = T("prog.lbl.levelFree", level, max)
			row.Desc.Text = T("prog.khLocked", licenceName(need))
			row.Button.SetVariant("Muted")
		else
			row.Info.Text = T("prog.lbl.levelFree", level, max) .. "\n" .. T("prog.lbl.cost", cost)
			row.Desc.Text = T("prog.kh." .. key .. ".d")
			row.Button.SetVariant(if free >= cost then "Primary" else "Muted")
		end
	end
	ui.KhReset.Text = if p.KHResetFree then T("prog.lbl.khResetFree") else T("prog.lbl.khResetUsed")
end

-- ---------------------------------------------------------------------
-- 5) RUF (5 Sterne mit Halben = Stufe 0–10)
-- ---------------------------------------------------------------------
local function buildRufPage(page: Frame)
	local starsRow = UI.Row(page, 1, 56)
	ui.Stars = {}
	for i = 1, 5 do
		local star = UI.Label({
			Size = UDim2.fromOffset(48, 48),
			Text = "★",
			TextColor3 = Theme.Gold,
			MaxText = 44,
			LayoutOrder = i,
			Parent = starsRow,
		})
		ui.Stars[i] = { Label = star, Gradient = UI.Create("UIGradient", { Parent = star }) }
	end
	ui.RufLevel = text(starsRow, {
		Size = UDim2.fromOffset(160, 48),
		LayoutOrder = 6,
		Face = "Display",
		MaxText = 20,
		TextColor3 = Theme.Gold,
	})
	ui.RufPts = text(page, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 2, Face = "Mono", MaxText = 15 })
	ui.RufToday = text(page, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 3, Face = "Mono", MaxText = 15 })
	ui.RufFloor = text(page, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 4, MaxText = 14, TextColor3 = Theme.Text2 })
	ui.RufFactor = text(page, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 5, MaxText = 14, TextColor3 = Theme.Up })
	UI.Divider(page, 6)
	paragraph(page, 7, 40, T("prog.ruf.info"))
	paragraph(page, 8, 40, T("prog.ruf.decay"))
end

local function refreshRuf()
	local p = prog()
	local level = math.clamp(math.floor(num(p.Ruf, 0)), 0, 10)
	for i, star in ipairs(ui.Stars) do
		local full = level >= i * 2
		local half = not full and level >= i * 2 - 1
		star.Gradient.Enabled = half
		star.Gradient.Transparency = HALF_STAR
		star.Label.TextTransparency = if full or half then 0 else 0.78
	end
	ui.RufLevel.Text = T("prog.lbl.rufLevel", level)
	ui.RufPts.Text = T("prog.lbl.rufPts", math.floor(num(p.RufPts, 0)), math.floor(num(p.RufNext, 0)))
	local cap = num(pcfg().Ruf and pcfg().Ruf.DailyCap, 20)
	ui.RufToday.Text = T("prog.lbl.rufToday", math.floor(num(p.RufToday, 0)), cap)
	local floorLevel = 0
	local licence = math.floor(num(p.Licence, 1))
	for _, entry in ipairs(pcfg().Ruf and pcfg().Ruf.Floors or {}) do
		if licence >= num(entry.Licence, math.huge) then
			floorLevel = math.max(floorLevel, num(entry.Level, 0))
		end
	end
	ui.RufFloor.Text = T("prog.lbl.rufFloor", floorLevel)
	local factor = type(p.Factor) == "table" and p.Factor or {}
	ui.RufFactor.Text = T("prog.lbl.rufFactor", (string.gsub(fmt("Mult", num(factor.Ruf, 1), lang()), "^x", "")))
end

-- ---------------------------------------------------------------------
-- 6) FENSTER
-- ---------------------------------------------------------------------
function Academy.Refresh()
	if not window then
		return
	end
	refreshLessons()
	refreshLicence()
	refreshKh()
	refreshRuf()
	if lesson then
		renderPlayer()
	end
end

local function buildWindow()
	window = UI.Window(T("prog.win.academy"), WINDOW_W, WINDOW_H, Theme.Cyan)
	segmented = UI.Segmented(window.Content, {
		{ Key = "lessons", Text = T("prog.tab.lessons") },
		{ Key = "licence", Text = T("prog.tab.licence") },
		{ Key = "kh", Text = T("prog.tab.kh") },
		{ Key = "ruf", Text = T("prog.tab.ruf") },
	}, function(key: string)
		showTab(key)
		Academy.Refresh()
	end)
	segmented.Frame.LayoutOrder = 0
	buildLessonPage(newPage("lessons", 1))
	buildLicencePage(newPage("licence", 2))
	buildKhPage(newPage("kh", 3))
	buildRufPage(newPage("ruf", 4))
	showTab(tab)
end

local function openWindow()
	if not window then
		buildWindow()
	end
	segmented.Set(tab, true)
	showTab(tab)
	UI.OpenWindow(window)
	local wanted = pendingLesson
	pendingLesson = nil
	if wanted then
		startLesson(wanted)
	elseif not lesson then
		showPlayer(false)
	end
	Academy.Refresh()
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
end

function Academy.OpenLesson(id: string)
	if type(id) ~= "string" or not lessonDef(id) then
		return
	end
	tab = "lessons"
	pendingLesson = id
	if window and window.IsOpen then
		segmented.Set(tab, true)
		showTab(tab)
		pendingLesson = nil
		startLesson(id)
		return
	end
	ctx.Windows.Open("Academy")
end

function Academy.Init(context: any)
	ctx = context
	ctx.Windows.Register("Academy", openWindow, closeWindow)
end

function Academy.Start()
	ctx.Hooks.On("State", function(_state: any, changed: any)
		if type(changed) == "table" and changed.Prog and window and window.IsOpen then
			Academy.Refresh()
		end
	end)
	ctx.Hooks.On("Settings", function()
		if window then
			ui.TaskSig = ""
		end
	end)
end

return Academy
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">AdminPanel</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Admin-Panel (Client/Modules/AdminPanel)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Vertrag: DESIGN.md §B15.1 (HUD-Knopf Order 99 + Taste P, Fenster
--  720 × 600, 5-s-Bestätigung globaler Aktionen), §B15.2 (11 Tabs), §B15.3 (Admin-Abuse-Katalog, 21 Events), §C7.3
--  (Fenster "Admin"), §C7.5 (AdminPanel.Toggle). Basis: CLUTCH-CLASH-AdminPanel (REUSE §1.4 ADAPT): Rahmen mit
--  Seitenleiste, gemeinsames Ziel-Feld (me/all/others/Name/Präfix/UserId), Status-Pill, needsConfirm, Schieberegler
--  (senden beim Loslassen), Listen, Zuschauen (Taste X). Bausteine aus dem UI-Kit (UI.Chip/StatTile/RowCard/RowActions/
--  Slider/Cycler/NavItem, REUSE §4.10). Look: AKYTEX-Dashboard (Glas, Akzent-Strich, Kennzahl-Kacheln).
--  Wird nur gebaut, wenn der Server dich als Admin markiert (Attribut IsAdmin). JEDE Aktion prüft der Server erneut.
--
--  Tabs: Dashboard · Spieler · Markt · Events · Geld & Items · Kräfte · Welt · Live-Ops · Statistik · Moderation · Debug
--
--  Öffentliche API (§C7.5):
--    AdminPanel.Toggle()
--    AdminPanel.Init(ctx) / AdminPanel.Start()
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local AdminPanel = {}

local player = Players.LocalPlayer
local ctx: any = nil
local UI: any = nil
local Theme: any = nil

local WINDOW_NAME = "Admin"
local MAX_LINES = 90
local SIDEBAR_W = 160
local TOP = 66 -- erste Zeile unter dem Fenster-Kopf (Kopf 58 + 8)
local GAP = 12
-- iOS-artige Feder: kurzes Überschwingen (Back) statt linearem Ausblenden
local STATUS_POP_INFO = TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TAB_FADE_INFO = TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local built = false
local win: any = nil
local spectating: Player? = nil
local worldPreview: string? = nil

-- ---------------------------------------------------------------------
-- KLEINE HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function lang(): string
	if ctx and type(ctx.Lang_) == "function" then
		return ctx.Lang_()
	end
	return "de"
end

local function module(name: string): any
	local modules = ctx and ctx.Modules
	return if type(modules) == "table" then modules[name] else nil
end

local function tryModule(name: string, fnName: string, ...: any): boolean
	local m = module(name)
	local fn = if type(m) == "table" then m[fnName] else nil
	if type(fn) ~= "function" then
		return false
	end
	return (pcall(fn, ...))
end

local function num(value: any, default: number): number
	return if type(value) == "number"
			and value == value
			and value ~= math.huge
			and value ~= -math.huge
		then value
		else default
end

local function pick(pair: any, fallback: string): string
	if type(pair) == "table" then
		return tostring(pair[lang()] or pair.de or fallback)
	end
	return if type(pair) == "string" then pair else fallback
end

local function keysOf(list: any): { string }
	local out: { string } = {}
	if type(list) == "table" then
		for _, entry in ipairs(list) do
			if type(entry) == "table" and type(entry.Key) == "string" then
				table.insert(out, entry.Key)
			end
		end
	end
	return out
end

local function sortedKeys(t: any): { string }
	local out: { string } = {}
	if type(t) == "table" then
		for key in pairs(t) do
			if type(key) == "string" then
				table.insert(out, key)
			end
		end
	end
	table.sort(out)
	return out
end

local function clearChildren(parent: Instance)
	for _, child in ipairs(parent:GetChildren()) do
		if
			not child:IsA("UIListLayout")
			and not child:IsA("UIGridLayout")
			and not child:IsA("UIPadding")
			and not child:IsA("UICorner")
			and not child:IsA("UIStroke")
		then
			child:Destroy()
		end
	end
end

local function fmtTime(t: any): string
	if type(t) ~= "number" or t <= 0 then
		return "-"
	end
	return os.date("%d.%m. %H:%M", math.floor(t)) :: string
end

local function fmtCredits(n: any): string
	local format = ctx and ctx.Format
	if format and type(format.Credits) == "function" then
		local ok, text = pcall(format.Credits, num(n, 0), lang())
		if ok then
			return text
		end
	end
	return tostring(n)
end

local function fmtAky(cents: any): string
	local format = ctx and ctx.Format
	if format and type(format.Aky) == "function" then
		local ok, text = pcall(format.Aky, num(cents, 0), lang(), true)
		if ok then
			return text
		end
	end
	return tostring(math.floor(num(cents, 0) / 100)) .. " AKY"
end

local function fmtDuration(seconds: number): string
	local format = ctx and ctx.Format
	if format and type(format.Duration) == "function" then
		local ok, text = pcall(format.Duration, math.max(0, seconds), lang())
		if ok then
			return text
		end
	end
	return ("%ds"):format(math.floor(seconds))
end

local function confirmSeconds(): number
	local security = ctx and ctx.Config and ctx.Config.Security
	return num(security and security.ConfirmSeconds, 5)
end

-- Instrument aus Ticker oder Id (Config.Companies)
local function resolveInstrument(text: string): number?
	local id = tonumber(text)
	if id and id % 1 == 0 then
		return id
	end
	local companies = ctx and ctx.Config and ctx.Config.Companies
	local list = companies and companies.Instruments
	if type(list) == "table" then
		local upper = string.upper(text)
		for _, inst in ipairs(list) do
			if type(inst) == "table" and inst.Ticker == upper then
				return inst.Id
			end
		end
	end
	return nil
end

local function tickerOf(i: any): string
	local companies = ctx and ctx.Config and ctx.Config.Companies
	local byId = companies and companies.ById
	local entry = byId and byId[i]
	if type(entry) == "table" and type(entry.Ticker) == "string" then
		return entry.Ticker
	end
	return tostring(i or "?")
end

-- ---------------------------------------------------------------------
-- ZUSCHAUEN (Client, Taste X beendet)
-- ---------------------------------------------------------------------
local spectateConn: RBXScriptConnection? = nil

-- Admin-Remote direkt (für Aufrufe außerhalb des Fensters, z. B. Zuschauen per Taste)
local function adminInvoke(action: string, args: { [string]: any }): any
	local remotes = ctx and ctx.Remotes
	local remote = remotes and remotes.Admin
	if not remote or not remote:IsA("RemoteFunction") then
		return nil
	end
	local ok, result = pcall(function()
		return remote:InvokeServer(action, args)
	end)
	return if ok then result else nil
end

local function stopSpectate()
	if not spectating then
		return
	end
	spectating = nil
	if spectateConn then
		spectateConn:Disconnect()
		spectateConn = nil
	end
	local camera = workspace.CurrentCamera
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if camera and humanoid then
		camera.CameraSubject = humanoid
	end
	tryModule("Controls", "SetContext", "World")
	task.spawn(function()
		adminInvoke("Spectate", { On = false }) -- Replikation wieder um die eigene Figur
	end)
	if ctx and type(ctx.Toast) == "function" then
		ctx.Toast(T("admin.spectateStop"), "Info")
	end
end

-- Kamera auf die Figur des Ziels; unter StreamingEnabled kommt eine ferne Figur erst nach dem Fokus-Wechsel an
local function followTarget(target: Player)
	task.spawn(function()
		adminInvoke("Spectate", { Target = tostring(target.UserId), On = true }) -- Server streamt um das Ziel
		local deadline = os.clock() + 5
		while spectating == target and os.clock() < deadline do
			local character = target.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local camera = workspace.CurrentCamera
			if humanoid and camera then
				camera.CameraSubject = humanoid
				return
			end
			task.wait(0.1)
		end
	end)
end

local function spectate(target: Player?): boolean
	if not target or target == player or target.Parent ~= Players then
		return false
	end
	spectating = target
	if spectateConn then
		spectateConn:Disconnect()
	end
	-- Respawn des Ziels: Fokus + Kamera auf die neue Figur
	spectateConn = target.CharacterAdded:Connect(function()
		if spectating == target then
			followTarget(target)
		end
	end)
	followTarget(target)
	tryModule("Controls", "SetContext", "Spectate")
	if ctx and type(ctx.Toast) == "function" then
		ctx.Toast(T("admin.spectating", target.DisplayName), "Info")
	end
	return true
end

local function findPlayer(text: string): Player?
	local lower = string.lower(text)
	local id = tonumber(text)
	for _, p in ipairs(Players:GetPlayers()) do
		if (id and p.UserId == id) or string.lower(p.Name) == lower or string.lower(p.DisplayName) == lower then
			return p
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if string.sub(string.lower(p.Name), 1, #lower) == lower then
			return p
		end
	end
	return nil
end

-- ---------------------------------------------------------------------
-- BAUSTEINE
-- ---------------------------------------------------------------------
local function listFrame(parent: Instance, order: number): Frame
	return UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
	})
end

-- Ausgabe-Konsole (Listen, Infos): dunkle Karte, erscheint erst mit Inhalt
local function outputBox(parent: Instance, order: number): Frame
	return UI.Create("Frame", {
		Name = "Output",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Bg2,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Visible = false,
		Parent = parent,
	}, {
		UI.Corner(10),
		UI.Stroke(nil, 1),
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }),
		UI.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 10),
		}),
	})
end

local function textLine(parent: Instance, text: string, order: number, color: Color3?): TextLabel
	return UI.Label({
		Size = UDim2.new(1, 0, 0, 20),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = text,
		Font = UI.Fonts.Body,
		TextScaled = false,
		TextSize = 15,
		TextWrapped = true,
		RichText = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color or Theme.Text,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function showLines(out: Frame, lines: { string })
	clearChildren(out)
	for i, line in ipairs(lines) do
		if i > MAX_LINES then
			textLine(out, ("… +%d"):format(#lines - MAX_LINES), i, Theme.Muted)
			break
		end
		textLine(out, line, i, Theme.Text2)
	end
	out.Visible = #lines > 0
end

-- Knopf in einer AKYTEX-Variante: "Primary" | "Secondary" | "Danger" | "Success" | "Ghost" | "Premium"
local function button(parent: Instance, text: string, variant: string, size: UDim2, onClick: () -> ()): any
	return UI.Button(
		{ Size = size, Text = text, Variant = variant, MaxText = 15, Corner = 10, Parent = parent },
		onClick
	)
end

local function textBox(parent: Instance, placeholder: string, size: UDim2, default: string?): TextBox
	return UI.TextBox({
		Size = size,
		Text = default or "",
		PlaceholderText = placeholder,
		Font = UI.Fonts.Body,
		Parent = parent,
	})
end

-- =====================================================================
-- AUFBAU
-- =====================================================================
local function build()
	if built then
		return
	end
	built = true
	local Config = ctx.Config or {}
	local remotes = ctx.Remotes or {}
	local EV = Config.Events or {}
	local LIMITS = EV.AdminLimits or {}

	win = UI.Window(T("admin.title"), 720, 600, Theme.Accent)
	local panel: Frame = win.Panel

	-- Fenster-Kopf: Rollen-Chips rechts neben dem Titel (vor dem ✕)
	local header = panel:FindFirstChild("Header")
	if header then
		local chips = UI.Create("Frame", {
			Name = "Chips",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -60, 0, 18),
			Size = UDim2.fromOffset(240, 22),
			BackgroundTransparency = 1,
			Parent = header,
		}, {
			UI.Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 6),
			}),
		})
		UI.Chip(chips, T("admin.badgeOwner"), Theme.Warn, { LayoutOrder = 1 })
		local studio = RunService:IsStudio()
		UI.Chip(
			chips,
			T(if studio then "admin.badgeStudio" else "admin.badgeLive"),
			if studio then Theme.Accent else Theme.Up,
			{ LayoutOrder = 2 }
		)
	end

	-- Seitenleiste mit den 11 Reitern
	local sidebar = UI.Create("Frame", {
		Name = "Sidebar",
		Position = UDim2.fromOffset(GAP, TOP),
		Size = UDim2.new(0, SIDEBAR_W, 1, -(TOP + GAP)),
		BackgroundColor3 = Theme.Bg2,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Parent = panel,
	}, { UI.Corner(12), UI.Stroke(nil, 1) })
	local tabBar = UI.Create("ScrollingFrame", {
		Name = "Tabs",
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 1, -16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = sidebar,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }),
	})

	-- Rechte Spalte: Ziel-Feld + Status-Pill, darunter der Inhalt
	local left = GAP + SIDEBAR_W + GAP
	local topRow = UI.Create("Frame", {
		Name = "TargetRow",
		Position = UDim2.fromOffset(left, TOP),
		Size = UDim2.new(1, -(left + GAP), 0, 36),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	local targetBox = textBox(topRow, T("admin.targetHint"), UDim2.new(0.34, 0, 1, 0), "me")
	local statusPill = UI.Create("Frame", {
		Name = "Status",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.66, -8, 1, 0),
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		Parent = topRow,
	}, { UI.Corner(10), UI.Stroke(nil, 1) })
	local statusDot = UI.Create("Frame", {
		Name = "Dot",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = statusPill,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local status = UI.Label({
		Name = "Text",
		Position = UDim2.fromOffset(28, 0),
		Size = UDim2.new(1, -38, 1, 0),
		Text = T("admin.ready"),
		Font = UI.Fonts.Body,
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		MaxText = 14,
		Parent = statusPill,
	})
	win.Content.Position = UDim2.fromOffset(left, TOP + 36 + 10)
	win.Content.Size = UDim2.new(1, -(left + 4), 1, -(TOP + 46 + GAP))

	local statusScale: UIScale = UI.Create("UIScale", { Scale = 1, Parent = statusPill })
	local function setStatus(text: string, color: Color3)
		status.Text = text
		status.TextColor3 = if color == Theme.Text2 then Theme.Text2 else Theme.Text
		statusDot.BackgroundColor3 = color
		statusScale.Scale = 1.03
		TweenService:Create(statusScale, STATUS_POP_INFO, { Scale = 1 }):Play()
	end

	local function admin(action: string, args: { [string]: any }?): any
		local remote = remotes.Admin
		if not remote or not remote:IsA("RemoteFunction") then
			setStatus(T("core.noAnswer"), Theme.Down)
			return nil
		end
		setStatus(T("admin.working"), Theme.Text2) -- sofortiges Feedback (Bann, Statistik, Shards lesen dauern)
		local ok, result = pcall(function()
			return remote:InvokeServer(action, args or {})
		end)
		if ok and type(result) == "table" then
			local message = tostring(result.Message or "")
			setStatus(
				if result.Ok then T("admin.ok", message) else T("admin.fail", message),
				if result.Ok then Theme.Up else Theme.Down
			)
			if not result.Ok then
				tryModule("Sfx", "Play", "UIError") -- hörbares Fehler-Feedback (Klick-Ton kommt vom Knopf)
			end
			return result
		end
		setStatus(T("core.noAnswer"), Theme.Down)
		tryModule("Sfx", "Play", "UIError")
		return nil
	end

	-- Gefährliche/globale Aktion: erst beim zweiten Klick (innerhalb von 5 s) ausführen
	local confirmKey: string? = nil
	local confirmAt = 0
	local function needsConfirm(key: string, label: string): boolean
		local now = os.clock()
		if confirmKey ~= key or now - confirmAt > confirmSeconds() then
			confirmKey = key
			confirmAt = now
			setStatus(T("admin.confirm", label), Theme.Warn)
			return true
		end
		confirmKey = nil
		return false
	end

	local function target(): string
		return targetBox.Text
	end

	-- Reiter-Seiten (§B15.2)
	local TABS = {
		{ Id = "Dashboard", Key = "admin.tabDashboard" },
		{ Id = "Players", Key = "admin.tabPlayers" },
		{ Id = "Market", Key = "admin.tabMarket" },
		{ Id = "Events", Key = "admin.tabEvents" },
		{ Id = "Give", Key = "admin.tabGive" },
		{ Id = "Powers", Key = "admin.tabPowers" },
		{ Id = "World", Key = "admin.tabWorld" },
		{ Id = "Live", Key = "admin.tabLive" },
		{ Id = "Stats", Key = "admin.tabStats" },
		{ Id = "Mod", Key = "admin.tabMod" },
		{ Id = "Debug", Key = "admin.tabDebug" },
	}
	local pages: { [string]: Frame } = {}
	local tabButtons: { [string]: any } = {}
	local onTabOpen: { [string]: () -> () } = {}
	local currentTab = "Dashboard"
	local function selectTab(id: string)
		currentTab = id
		for pageId, page in pairs(pages) do
			page.Visible = pageId == id
			local scale = page:FindFirstChildOfClass("UIScale")
			if pageId == id and scale then
				scale.Scale = 0.965
				TweenService:Create(scale, TAB_FADE_INFO, { Scale = 1 }):Play()
			end
		end
		for _, tab in ipairs(TABS) do
			local b = tabButtons[tab.Id]
			if b then
				b.SetActive(tab.Id == id)
			end
		end
		win.Content.CanvasPosition = Vector2.zero
		local hook = onTabOpen[id]
		if hook then
			task.spawn(hook)
		end
	end
	for i, tab in ipairs(TABS) do
		pages[tab.Id] = UI.Create("Frame", {
			Name = tab.Id,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = i,
			Visible = false,
			Parent = win.Content,
		}, {
			UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
			UI.Create("UIScale", { Scale = 1 }),
		})
		tabButtons[tab.Id] = UI.NavItem(tabBar, T(tab.Key), i, function()
			selectTab(tab.Id)
		end)
	end

	local FULL = UDim2.new(1, 0, 1, 0)
	local function part(scale: number): UDim2
		return UDim2.new(scale, -6, 1, 0)
	end
	local function tiles(parent: Instance, order: number): Frame
		return UI.Create("Frame", {
			Name = "Tiles",
			Size = UDim2.new(1, 0, 0, 64),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = parent,
		}, {
			UI.Create("UIGridLayout", {
				CellSize = UDim2.new(0.25, -8, 1, 0),
				CellPadding = UDim2.fromOffset(10, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
	end
	local function toggleButton(
		parent: Instance,
		labelKey: string,
		size: UDim2,
		get: () -> boolean,
		set: (boolean) -> ()
	): any
		local b: any = nil
		local function refresh()
			local on = get()
			b.SetText(("%s: %s"):format(T(labelKey), T(if on then "admin.on" else "admin.off")))
			b.SetVariant(if on then "Primary" else "Secondary")
		end
		b = button(parent, T(labelKey), "Secondary", size, function()
			set(not get())
			task.delay(0.3, refresh)
		end)
		refresh()
		return { Button = b, Refresh = refresh }
	end

	-- =================================================================
	-- 1) DASHBOARD
	-- =================================================================
	do
		local page = pages.Dashboard
		local row = tiles(page, 1)
		local kpiPlayers = UI.StatTile(row, T("admin.kpiPlayers"), 1)
		local kpiGlobal = UI.StatTile(row, T("admin.kpiGlobal"), 2)
		local kpiRegime = UI.StatTile(row, T("admin.kpiRegime"), 3)
		local kpiBus = UI.StatTile(row, T("admin.kpiBus"), 4)
		local localBanner = UI.Create("Frame", {
			Name = "LocalMarket",
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			LayoutOrder = 2,
			Visible = false,
			Parent = page,
		})
		UI.Chip(localBanner, T("core.localMarket"), Theme.Warn, { LayoutOrder = 1 })
		UI.Section(page, T("admin.secActiveEvents"), 3)
		local eventRow = UI.Create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = 4,
			Parent = page,
		}, {
			UI.Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Wraps = true,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 6),
			}),
		})
		UI.Section(page, T("admin.secServer"), 5)
		local actRow = UI.Row(page, 6, 40)
		local out: Frame
		local function refresh()
			local result = admin("Dashboard")
			if not result or not result.Ok or type(result.Data) ~= "table" then
				return
			end
			local d = result.Data
			kpiPlayers.Text = ("%d / %d"):format(num(d.Players, 0), num(d.MaxPlayers, 0))
			kpiGlobal.Text = ("%d · %d"):format(num(d.GlobalPlayers, 0), num(d.Servers, 0))
			local market = if type(d.Market) == "table" then d.Market else {}
			kpiRegime.Text = ("%.2f"):format(num(market.Regime, 1))
			kpiBus.Text = T(if market.BusOk then "admin.busOk" else "admin.busDown")
			kpiBus.TextColor3 = if market.BusOk then Theme.Up else Theme.Down
			localBanner.Visible = d.LocalMarket == true
			clearChildren(eventRow)
			local kinds = if type(d.Events) == "table" then d.Events else {}
			if #kinds == 0 then
				UI.Chip(eventRow, T("admin.noEvents"), Theme.Muted, { LayoutOrder = 1 })
			end
			for i, kind in ipairs(kinds) do
				UI.Chip(
					eventRow,
					tostring(kind),
					if d.AdminAbuse then Theme.Down else Theme.Accent,
					{ LayoutOrder = i }
				)
			end
			local lines: { string } = {
				T("admin.infoLoad", num(d.HeartbeatMs, 0), num(d.HeartbeatMaxMs, 0)),
				T("admin.infoMarket", num(market.TickMs, 0), num(market.Instruments, 0), num(market.Events, 0)),
				T("admin.infoMisc", num(d.MemoryMb, 0), fmtDuration(num(d.Uptime, 0))),
				T("admin.infoVersion", tostring(d.Version), tostring(d.JobId), num(d.LiveVersion, 0)),
			}
			if type(d.Jobs) == "table" then
				for _, job in ipairs(d.Jobs) do
					if type(job) == "table" then
						table.insert(
							lines,
							("  %s · Ø %.2f ms · max %.2f ms"):format(
								tostring(job.Name),
								num(job.AvgMs, 0),
								num(job.MaxMs, 0)
							)
						)
					end
				end
			end
			if d.Locked then
				table.insert(lines, T("admin.locked"))
			end
			if type(d.Maintenance) == "string" and d.Maintenance ~= "" then
				table.insert(lines, T("admin.maintenanceOn", d.Maintenance))
			end
			if d.AdminAbuse then
				table.insert(lines, T("evt.adminWindow"))
			end
			showLines(out, lines)
		end
		button(actRow, T("admin.refresh"), "Secondary", part(0.25), refresh)
		button(actRow, T("admin.lock"), "Danger", part(0.25), function()
			if needsConfirm("Lock", T("admin.lock")) then
				return
			end
			admin("LockServer", { On = true })
		end)
		button(actRow, T("admin.unlock"), "Success", part(0.25), function()
			admin("LockServer", { On = false })
		end)
		button(actRow, T("admin.debugOverlay"), "Ghost", part(0.25), function()
			tryModule("DebugOverlay", "Toggle")
		end)
		out = outputBox(page, 7)
		onTabOpen.Dashboard = refresh
	end

	-- =================================================================
	-- 2) SPIELER
	-- =================================================================
	do
		local page = pages.Players
		local row = tiles(page, 0)
		local kpiPlayers = UI.StatTile(row, T("admin.kpiPlayers"), 1)
		local kpiPing = UI.StatTile(row, T("admin.kpiPing"), 2)
		local kpiSus = UI.StatTile(row, T("admin.kpiSuspicion"), 3)
		local kpiFrozen = UI.StatTile(row, T("admin.kpiFrozen"), 4)

		UI.Section(page, T("admin.secPlayers"), 1)
		local listRow = UI.Row(page, 2, 40)
		local playerList = listFrame(page, 3)
		local function refresh()
			local result = admin("GetPlayers")
			if not result or not result.Ok or type(result.Data) ~= "table" then
				return
			end
			clearChildren(playerList)
			local count, pingSum, maxSus, frozen = 0, 0, 0, 0
			for i, info in ipairs(result.Data) do
				if type(info) == "table" then
					count += 1
					pingSum += num(info.PingMs, 0)
					local sus = num(info.Suspicion, 0)
					maxSus = math.max(maxSus, sus)
					if info.Frozen then
						frozen += 1
					end
					local card = UI.RowCard(playerList, i, 50)
					local nameRow = UI.Create("Frame", {
						Position = UDim2.fromOffset(14, 6),
						Size = UDim2.new(1, -220, 0, 20),
						BackgroundTransparency = 1,
						Parent = card,
					}, {
						UI.Create("UIListLayout", {
							FillDirection = Enum.FillDirection.Horizontal,
							VerticalAlignment = Enum.VerticalAlignment.Center,
							SortOrder = Enum.SortOrder.LayoutOrder,
							Padding = UDim.new(0, 8),
						}),
					})
					UI.Create("TextLabel", {
						Size = UDim2.fromScale(0, 1),
						AutomaticSize = Enum.AutomaticSize.X,
						BackgroundTransparency = 1,
						Font = UI.Fonts.Main,
						TextSize = 16,
						TextColor3 = Theme.Text,
						Text = tostring(info.DisplayName),
						LayoutOrder = 1,
						Parent = nameRow,
					})
					if info.IsAdmin then
						UI.Chip(nameRow, "ADMIN", Theme.Accent, { LayoutOrder = 2, Size = UDim2.fromOffset(0, 18) })
					end
					if info.Frozen then
						UI.Chip(
							nameRow,
							T("admin.frozenChip"),
							Theme.Warn,
							{ LayoutOrder = 3, Size = UDim2.fromOffset(0, 18) }
						)
					end
					UI.Label({
						Position = UDim2.fromOffset(14, 27),
						Size = UDim2.new(1, -220, 0, 16),
						Text = T(
							"admin.playerMeta",
							tostring(info.UserId),
							num(info.Licence, 1),
							num(info.Floors, 0),
							num(info.PingMs, 0),
							tostring(info.Suspicion or 0),
							num(info.Minutes, 0)
						),
						Font = UI.Fonts.Body,
						TextColor3 = if sus >= 60 then Theme.Down elseif sus >= 25 then Theme.Warn else Theme.Text2,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd,
						MaxText = 13,
						Parent = card,
					})
					local actions = UI.RowActions(card, 196)
					button(actions, T("admin.setTarget"), "Secondary", UDim2.new(0, 90, 1, 0), function()
						targetBox.Text = tostring(info.Name)
						setStatus(T("admin.targetSet", tostring(info.Name)), Theme.Up)
					end)
					button(actions, T("admin.view"), "Ghost", UDim2.new(0, 90, 1, 0), function()
						spectate(findPlayer(tostring(info.Name)))
					end)
				end
			end
			kpiPlayers.Text = tostring(count)
			kpiPing.Text = if count > 0 then ("%d ms"):format(math.floor(pingSum / count + 0.5)) else "–"
			kpiSus.Text = tostring(math.floor(maxSus + 0.5))
			kpiSus.TextColor3 = if maxSus >= 60 then Theme.Down elseif maxSus >= 25 then Theme.Warn else Theme.Text
			kpiFrozen.Text = tostring(frozen)
		end
		button(listRow, T("admin.refresh"), "Secondary", part(0.3), refresh)
		onTabOpen.Players = refresh

		UI.Section(page, T("admin.secActions"), 4)
		local reasonRow = UI.Row(page, 5, 36)
		local reasonBox = textBox(reasonRow, T("admin.reasonHint"), FULL)
		local grid = UI.Grid(page, 6, 122, 40)
		local function act(key: string, variant: string, fn: () -> ())
			button(grid, T(key), variant, UDim2.fromScale(1, 1), fn)
		end
		act("admin.kick", "Danger", function()
			if needsConfirm("Kick" .. target(), T("admin.kick")) then
				return
			end
			admin("Kick", { Target = target(), Reason = reasonBox.Text })
		end)
		act("admin.warn", "Primary", function()
			admin("Warn", { Target = target(), Text = reasonBox.Text })
		end)
		act("admin.freeze", "Secondary", function()
			admin("Freeze", { Target = target(), On = true })
		end)
		act("admin.unfreeze", "Secondary", function()
			admin("Freeze", { Target = target(), On = false })
		end)
		act("admin.bring", "Secondary", function()
			admin("Bring", { Target = target() })
		end)
		act("admin.goto", "Secondary", function()
			admin("Goto", { Target = target() })
		end)
		act("admin.visit", "Secondary", function()
			admin("Visit", { Target = target() })
		end)
		act("admin.spectate", "Ghost", function()
			if not spectate(findPlayer(target())) then
				setStatus(T("admin.noTarget"), Theme.Down)
			end
		end)
		act("admin.kickAll", "Danger", function()
			if needsConfirm("KickAll", T("admin.kickAll")) then
				return
			end
			admin("KickAll", { Reason = reasonBox.Text })
		end)

		UI.Section(page, T("admin.secBan"), 7)
		local banGrid = UI.Grid(page, 8, 96, 40)
		local privateRow = UI.Row(page, 9, 36)
		local privateBox = textBox(privateRow, T("admin.privateHint"), FULL)
		local idRow = UI.Row(page, 10, 40)
		local userIdBox = textBox(idRow, T("admin.userIdHint"), part(0.28))
		local out: Frame
		local function banArgs(duration: string): { [string]: any }
			local id = tonumber(userIdBox.Text)
			local args: { [string]: any } = { Duration = duration, Reason = reasonBox.Text, Private = privateBox.Text }
			if id then
				args.UserId = id
			else
				args.Target = target()
			end
			return args
		end
		for _, duration in ipairs({ "1h", "1d", "7d", "30d", "perm" }) do
			button(banGrid, T("admin.banFor", duration), "Danger", UDim2.fromScale(1, 1), function()
				local label = T("admin.banFor", duration)
				if needsConfirm("Ban" .. duration .. target() .. userIdBox.Text, label) then
					return
				end
				admin("Ban", banArgs(duration))
			end)
		end
		button(idRow, T("admin.unban"), "Success", part(0.24), function()
			if needsConfirm("Unban" .. userIdBox.Text, T("admin.unban")) then
				return
			end
			admin("Unban", { UserId = tonumber(userIdBox.Text) })
		end)
		button(idRow, T("admin.banListBtn"), "Secondary", part(0.24), function()
			local result = admin("BanList")
			if result and result.Ok and type(result.Data) == "table" then
				local lines: { string } = {}
				for _, e in ipairs(result.Data) do
					if type(e) == "table" then
						table.insert(
							lines,
							T(
								"admin.banLine",
								tostring(e.Name),
								tostring(e.UserId),
								fmtTime(e.T),
								tostring(e.Duration),
								tostring(e.Reason),
								if e.Active then "" else " ✔"
							)
						)
					end
				end
				showLines(out, lines)
			end
		end)
		button(idRow, T("admin.banHistoryBtn"), "Secondary", part(0.24), function()
			local result = admin("BanHistory", { UserId = tonumber(userIdBox.Text) })
			if result and result.Ok and type(result.Data) == "table" then
				local lines: { string } = {}
				for _, e in ipairs(result.Data) do
					if type(e) == "table" then
						table.insert(
							lines,
							("%s · %s · %ss · %s"):format(
								if e.Ban then "BAN" else "UNBAN",
								tostring(e.StartTime),
								tostring(e.Duration),
								tostring(e.DisplayReason)
							)
						)
					end
				end
				showLines(out, lines)
			end
		end)

		UI.Section(page, T("admin.secData"), 11)
		local dataRow = UI.Row(page, 12, 40)
		button(dataRow, T("admin.playerData"), "Secondary", part(0.2), function()
			local result = admin("PlayerData", { Target = target() })
			if result and result.Ok and type(result.Data) == "table" then
				local lines: { string } = {}
				for _, key in ipairs(sortedKeys(result.Data)) do
					table.insert(lines, ("%s: %s"):format(key, tostring(result.Data[key])))
				end
				showLines(out, lines)
			end
		end)
		button(dataRow, T("admin.receiptsBtn"), "Secondary", part(0.18), function()
			local result = admin("Receipts", { Target = target() })
			if result and result.Ok and type(result.Data) == "table" then
				local lines: { string } = {}
				for _, r in ipairs(result.Data) do
					if type(r) == "table" then
						table.insert(lines, ("%s · %s %s"):format(tostring(r.Id), fmtTime(r.T), tostring(r.Key or "")))
					end
				end
				showLines(out, lines)
			end
		end)
		local productKeys: { string } = {}
		for _, list in ipairs({ Config.Shop and Config.Shop.Products, Config.Shop and Config.Shop.GamePasses }) do
			for _, key in ipairs(keysOf(list)) do
				table.insert(productKeys, key)
			end
		end
		local productCycler = UI.Cycler(dataRow, T("admin.product"), productKeys, part(0.24))
		button(dataRow, T("admin.regrant"), "Primary", part(0.18), function()
			local key = productCycler.Get()
			if needsConfirm("Regrant" .. tostring(key) .. target(), T("admin.regrant")) then
				return
			end
			admin("Regrant", { Target = target(), ProductKey = key })
		end)
		button(dataRow, T("admin.resetData"), "Danger", part(0.2), function()
			if needsConfirm("Reset" .. target(), T("admin.resetData")) then
				return
			end
			admin("ResetData", { Target = target(), Confirm = true })
		end)
		out = outputBox(page, 20)
	end

	-- =================================================================
	-- 3) MARKT (nur MarketService.Admin, immer global; Admin-Fenster = Liga-Taint)
	-- =================================================================
	do
		local page = pages.Market
		local strengthRange = LIMITS.MarketStrength or { 5, 50 }
		local rampRange = LIMITS.Ramp or { 30, 300 }
		local decayRange = LIMITS.DecayMinutes or { 5, 60 }
		local haltRange = LIMITS.HaltSeconds or { 10, 600 }
		local volRange = LIMITS.Vol or { 0.5, 3 }
		local volMinutes = LIMITS.VolMinutes or { 5, 30 }
		textLine(page, T("admin.marketHint"), 0, Theme.Warn)

		UI.Section(page, T("admin.secScope"), 1)
		local scopeRow = UI.Row(page, 2, 40)
		local scopeCycler = UI.Cycler(scopeRow, T("admin.scope"), { "All", "Sector", "Inst" }, part(0.34))
		local sectorKeys: { string } = {}
		local sectors = Config.Companies and Config.Companies.Sectors
		if type(sectors) == "table" then
			for _, s in ipairs(sectors) do
				if type(s) == "table" and type(s.Key) == "string" then
					table.insert(sectorKeys, s.Key)
				end
			end
		end
		local sectorCycler = UI.Cycler(scopeRow, T("admin.sector"), sectorKeys, part(0.3))
		local instBox = textBox(scopeRow, T("admin.instHint"), part(0.36))
		local function scopeArgs(): { [string]: any }?
			local scope = scopeCycler.Get() or "All"
			if scope == "Sector" then
				return { Scope = "Sector", Target = sectorCycler.Get() }
			elseif scope == "Inst" then
				local id = resolveInstrument(instBox.Text)
				if not id then
					setStatus(T("admin.badTarget"), Theme.Down)
					return nil
				end
				return { Scope = "Inst", Target = id }
			end
			return { Scope = "All" }
		end

		UI.Section(page, T("admin.secMove"), 3)
		local strength = UI.Slider(page, 4, T("admin.strength"), strengthRange[1], strengthRange[2], 15, function() end)
		local ramp = UI.Slider(page, 5, T("admin.ramp"), rampRange[1], rampRange[2], 60, function() end)
		local decay = UI.Slider(page, 6, T("admin.decay"), decayRange[1], decayRange[2], 15, function() end)
		local moveRow = UI.Row(page, 7, 40)
		local crashWarn = false -- Vorwarnung (Config.Events.AdminLimits.CrashWarnSeconds) nur für Mega-Crash
		toggleButton(moveRow, "admin.crashWarn", part(0.25), function()
			return crashWarn
		end, function(v)
			crashWarn = v
		end)
		local function market(kind: string, extra: { [string]: any }, labelKey: string)
			if needsConfirm("Market" .. kind, T(labelKey)) then
				return
			end
			local args = extra
			args.Kind = kind
			admin("Market", args)
		end
		button(moveRow, T("admin.ev.MegaRally"), "Success", part(0.25), function()
			local args = scopeArgs()
			if not args then
				return
			end
			args.Strength, args.Ramp, args.Decay = strength.Get(), ramp.Get(), decay.Get()
			market("MegaRally", args, "admin.ev.MegaRally")
		end)
		button(moveRow, T("admin.ev.MegaCrash"), "Danger", part(0.25), function()
			local args = scopeArgs()
			if not args then
				return
			end
			args.Strength, args.Ramp, args.Decay, args.Warn = strength.Get(), ramp.Get(), decay.Get(), crashWarn
			market("MegaCrash", args, "admin.ev.MegaCrash")
		end)
		button(moveRow, T("admin.ev.Normalize"), "Secondary", part(0.25), function()
			market("Normalize", {}, "admin.ev.Normalize")
		end)
		local companyRow = UI.Row(page, 8, 40)
		local companyBox = textBox(companyRow, T("admin.instHint"), part(0.34))
		button(companyRow, T("admin.ev.Pump"), "Success", part(0.33), function()
			local id = resolveInstrument(companyBox.Text)
			if not id then
				setStatus(T("admin.badTarget"), Theme.Down)
				return
			end
			market(
				"Pump",
				{ Target = id, Strength = strength.Get(), Ramp = ramp.Get(), Decay = decay.Get() },
				"admin.ev.Pump"
			)
		end)
		button(companyRow, T("admin.ev.Dump"), "Danger", part(0.33), function()
			local id = resolveInstrument(companyBox.Text)
			if not id then
				setStatus(T("admin.badTarget"), Theme.Down)
				return
			end
			market(
				"Dump",
				{ Target = id, Strength = strength.Get(), Ramp = ramp.Get(), Decay = decay.Get() },
				"admin.ev.Dump"
			)
		end)

		UI.Section(page, T("admin.ev.News"), 9)
		local maxChars = num(LIMITS.NewsChars, 80)
		local deRow = UI.Row(page, 10, 36)
		local newsDe = textBox(deRow, T("admin.newsDeHint", maxChars), FULL)
		local enRow = UI.Row(page, 11, 36)
		local newsEn = textBox(enRow, T("admin.newsEnHint", maxChars), FULL)
		local band = UI.Slider(page, 12, T("admin.band"), 1, 4, 2, function() end)
		local newsRow = UI.Row(page, 13, 40)
		local up = true
		toggleButton(newsRow, "admin.newsUp", part(0.3), function()
			return up
		end, function(v)
			up = v
		end)
		button(newsRow, T("admin.newsSend"), "Premium", part(0.7), function()
			local args = scopeArgs()
			if not args or args.Scope == "All" then
				setStatus(T("admin.newsScope"), Theme.Down)
				return
			end
			args.Band = band.Get()
			args.Dir = if up then 1 else -1
			args.Text = { de = newsDe.Text, en = if newsEn.Text ~= "" then newsEn.Text else newsDe.Text }
			market("News", args, "admin.ev.News")
		end)

		UI.Section(page, T("admin.secHalt"), 14)
		local haltSlider = UI.Slider(page, 15, T("admin.seconds"), haltRange[1], haltRange[2], 60, function() end)
		local haltRow = UI.Row(page, 16, 40)
		button(haltRow, T("admin.ev.Halt"), "Danger", part(0.5), function()
			local args = scopeArgs()
			if not args then
				return
			end
			if args.Scope == "Sector" then
				args = { Scope = "All" }
			end
			args.Seconds = haltSlider.Get()
			market("Halt", args, "admin.ev.Halt")
		end)
		button(haltRow, T("admin.ev.Resume"), "Success", part(0.5), function()
			admin("Market", { Kind = "Resume", Scope = "All" })
		end)

		UI.Section(page, T("admin.secIpoVol"), 17)
		local ipoRow = UI.Row(page, 18, 40)
		local pipeline = Config.Market and Config.Market.IpoPipeline
		local ipoIds: { string } = {}
		if pipeline and type(pipeline.Season) == "table" then
			for _, ids in pairs(pipeline.Season) do
				if type(ids) == "table" then
					for _, id in ipairs(ids) do
						table.insert(ipoIds, ("%s (%d)"):format(tickerOf(id), id))
					end
				end
			end
		end
		table.sort(ipoIds)
		local ipoCycler = UI.Cycler(ipoRow, T("admin.ipo"), ipoIds, part(0.6))
		button(ipoRow, T("admin.ev.Ipo"), "Premium", part(0.4), function()
			local value = ipoCycler.Get()
			local id = if value then tonumber(string.match(value, "%((%d+)%)")) else nil
			if not id then
				setStatus(T("admin.badTarget"), Theme.Down)
				return
			end
			market("Ipo", { Target = id }, "admin.ev.Ipo")
		end)
		local volSlider = UI.Slider(
			page,
			19,
			T("admin.volTenths"),
			math.floor(volRange[1] * 10),
			math.floor(volRange[2] * 10),
			15,
			function() end
		)
		local volMin = UI.Slider(
			page,
			20,
			T("admin.minutes"),
			volMinutes[1],
			volMinutes[2],
			volMinutes[1],
			function() end
		)
		local volRow = UI.Row(page, 21, 40)
		button(volRow, T("admin.ev.Vol"), "Primary", part(0.5), function()
			market("Vol", { Strength = volSlider.Get() / 10, Minutes = volMin.Get() }, "admin.ev.Vol")
		end)

		UI.Section(page, T("admin.secMarketLog"), 22)
		local logRow = UI.Row(page, 23, 40)
		local out: Frame
		local function loadLog()
			local result = admin("MarketLog")
			if not result or not result.Ok or type(result.Data) ~= "table" then
				return
			end
			local d = result.Data
			local lines: { string } = {}
			if d.LocalMarket then
				table.insert(lines, T("core.localMarket"))
			end
			if d.Blocked then
				table.insert(lines, T("admin.tradeBlocked"))
			end
			local tick = num(d.Tick, 0)
			local epoch = num(ctx.Clock and ctx.Clock.EPOCH, 0)
			if type(d.Windows) == "table" then
				for _, w in ipairs(d.Windows) do
					if type(w) == "table" then
						table.insert(
							lines,
							T(
								"admin.windowLine",
								fmtTime(num(w[1], 0) + epoch),
								fmtTime(num(w[2], 0) + epoch),
								if num(w[2], 0) >= tick then "●" else ""
							)
						)
					end
				end
			end
			if type(d.News) == "table" then
				for _, n in ipairs(d.News) do
					if type(n) == "table" then
						local text = if type(n.Text) == "table" then pick(n.Text, "") else T(tostring(n.Key or ""))
						table.insert(
							lines,
							("%s · %s · %s %s"):format(
								fmtTime(num(n.T, 0) + epoch),
								tostring(n.Kind),
								if n.I then tickerOf(n.I) elseif n.Sector then tostring(n.Sector) else "",
								string.sub(text, 1, 80)
							)
						)
					end
				end
			end
			if #lines == 0 then
				table.insert(lines, T("admin.nothing"))
			end
			showLines(out, lines)
		end
		button(logRow, T("admin.refresh"), "Secondary", part(0.3), loadLog)
		out = outputBox(page, 24)
		onTabOpen.Market = loadLog
	end

	-- =================================================================
	-- 4) EVENTS (Ansage, Admin-Abuse-Katalog Nicht-Markt, Samstags-Show, Kalender)
	-- =================================================================
	do
		local page = pages.Events
		local security = Config.Security or {}
		UI.Section(page, T("admin.secAnnounce"), 1)
		local textRow = UI.Row(page, 2, 40)
		local announceBox = textBox(textRow, T("admin.announceHint", security.AnnounceMax or 200), FULL)
		local announceRow = UI.Row(page, 3, 40)
		button(announceRow, T("admin.announce"), "Primary", part(0.5), function()
			admin("Announce", { Text = announceBox.Text, Global = false })
		end)
		button(announceRow, T("admin.announceGlobal"), "Premium", part(0.5), function()
			if needsConfirm("AnnounceGlobal", T("admin.announceGlobal")) then
				return
			end
			admin("Announce", { Text = announceBox.Text, Global = true })
		end)

		UI.Section(page, T("admin.secAbuse"), 4)
		local scopeRow = UI.Row(page, 5, 40)
		local global = false
		toggleButton(scopeRow, "admin.allServers", part(0.5), function()
			return global
		end, function(v)
			global = v
		end)
		textLine(page, T("admin.abuseHint"), 6, Theme.Muted)
		local rainRange = LIMITS.MoneyRain and LIMITS.MoneyRain.Seconds or { 60, 300 }
		local goldenMinutes = LIMITS.GoldenHour and LIMITS.GoldenHour.Minutes or { 5, 60 }
		local xpMinutes = LIMITS.XpRush and LIMITS.XpRush.Minutes or { 15, 60 }
		local bossRange = LIMITS.Boss and LIMITS.Boss.Seconds or { 60, 300 }
		local rainSlider = UI.Slider(page, 7, T("admin.rainSeconds"), rainRange[1], rainRange[2], 120, function() end)
		local goldenSlider = UI.Slider(
			page,
			8,
			T("admin.goldenMinutes"),
			goldenMinutes[1],
			goldenMinutes[2],
			15,
			function() end
		)
		local xpSlider = UI.Slider(page, 9, T("admin.xpMinutes"), xpMinutes[1], xpMinutes[2], 30, function() end)
		local bossSlider = UI.Slider(page, 10, T("admin.bossSeconds"), bossRange[1], bossRange[2], 120, function() end)
		local multRow = UI.Row(page, 11, 40)
		local goldenMult = UI.Cycler(multRow, T("admin.goldenMult"), { "×2", "×3" }, part(0.4))
		local grid = UI.Grid(page, 12, 122, 40)
		local function abuse(kind: string, args: { [string]: any }?)
			local label = T("admin.ev." .. kind)
			if (global or kind == "SaturdayShow") and needsConfirm("Abuse" .. kind, label) then
				return
			end
			admin("Abuse", { Event = kind, Args = args or {}, Global = global })
		end
		button(grid, T("admin.ev.MoneyRain"), "Success", UDim2.fromScale(1, 1), function()
			abuse("MoneyRain", { Seconds = rainSlider.Get() })
		end)
		button(grid, T("admin.ev.GoldenHour"), "Premium", UDim2.fromScale(1, 1), function()
			abuse("GoldenHour", { Mult = if goldenMult.Get() == "×3" then 3 else 2, Minutes = goldenSlider.Get() })
		end)
		button(grid, T("admin.ev.XpRush"), "Primary", UDim2.fromScale(1, 1), function()
			abuse("XpRush", { Minutes = xpSlider.Get() })
		end)
		button(grid, T("admin.ev.BuildBoom"), "Secondary", UDim2.fromScale(1, 1), function()
			abuse("BuildBoom", nil)
		end)
		button(grid, T("admin.ev.Lightshow"), "Secondary", UDim2.fromScale(1, 1), function()
			abuse("Lightshow", nil)
		end)
		button(grid, T("admin.ev.Fireworks"), "Secondary", UDim2.fromScale(1, 1), function()
			abuse("Fireworks", nil)
		end)
		button(grid, T("admin.ev.Confetti"), "Secondary", UDim2.fromScale(1, 1), function()
			abuse("Confetti", nil)
		end)
		button(grid, T("admin.ev.BellShow"), "Secondary", UDim2.fromScale(1, 1), function()
			abuse("BellShow", nil)
		end)
		button(grid, T("admin.ev.Boss"), "Primary", UDim2.fromScale(1, 1), function()
			abuse("Boss", { Seconds = bossSlider.Get() })
		end)
		button(grid, T("admin.ev.AllToHall"), "Secondary", UDim2.fromScale(1, 1), function()
			if needsConfirm("AllToHall", T("admin.ev.AllToHall")) then
				return
			end
			admin("Abuse", { Event = "AllToHall", Args = {}, Global = false })
		end)
		button(grid, T("admin.ev.SaturdayShow"), "Premium", UDim2.fromScale(1, 1), function()
			abuse("SaturdayShow", nil)
		end)
		local stopRow = UI.Row(page, 13, 40)
		local stopCycler = UI.Cycler(
			stopRow,
			T("admin.stopKind"),
			{ "GoldenHour", "XpRush", "MoneyRain", "Boss", "Bear", "GoldenBull", "Fireworks", "Lightshow" },
			part(0.6)
		)
		button(stopRow, T("admin.stop"), "Danger", part(0.4), function()
			admin("AbuseStop", { Event = stopCycler.Get() })
		end)
		for i, entry in ipairs(EV.Catalogue or {}) do
			if type(entry) == "table" and type(entry.Key) == "string" and not entry.Market then
				textLine(
					page,
					("· %s – %s"):format(T("admin.ev." .. entry.Key), T("admin.evHint." .. entry.Key)),
					13 + i,
					Theme.Muted
				)
			end
		end

		UI.Section(page, T("admin.secCalendar"), 40)
		local calRow = UI.Row(page, 41, 40)
		local out: Frame
		local function loadCalendar()
			local clock = ctx.Clock
			if not clock or type(clock.NextBerlin) ~= "function" then
				return
			end
			local now = clock.Now()
			local rows: { { At: number, Text: string } } = {}
			local function add(entry: any, label: string)
				if type(entry) ~= "table" or type(entry.HH) ~= "number" or type(entry.MM) ~= "number" then
					return
				end
				local ok, at = pcall(clock.NextBerlin, entry.Dow, entry.HH, entry.MM, now)
				if ok and type(at) == "number" then
					table.insert(rows, {
						At = at,
						Text = T("admin.calLine", fmtTime(at), label, fmtDuration(at - now)),
					})
				end
			end
			-- Markt-Termine (WP3) und Nicht-Markt-Termine (WP11); gleicher Key (z. B. AutoShow) nur einmal
			local seen: { [string]: boolean } = {}
			for _, list in ipairs({ EV.Weekly or {}, Config.Market and Config.Market.Weekly or {} }) do
				for _, entry in ipairs(list) do
					local key = if type(entry) == "table" then tostring(entry.Key) else ""
					if key ~= "" and not seen[key] then
						seen[key] = true
						add(entry, T("admin.cal." .. key))
					end
				end
			end
			table.sort(rows, function(a, b)
				return a.At < b.At
			end)
			local lines: { string } = {}
			for _, r in ipairs(rows) do
				table.insert(lines, r.Text)
			end
			showLines(out, lines)
		end
		button(calRow, T("admin.refresh"), "Secondary", part(0.3), loadCalendar)
		out = outputBox(page, 42)
		onTabOpen.Events = loadCalendar
	end

	-- =================================================================
	-- 5) GELD & ITEMS (Turm-Seite; AKY/Lizenz taint die Liga-Woche des Empfängers)
	-- =================================================================
	do
		local page = pages.Give
		textLine(page, T("admin.giveHint"), 0, Theme.Warn)
		UI.Section(page, T("admin.secMoney"), 1)
		-- Großer Betrag, Abzug oder mehrere Empfänger -> erst beim zweiten Tippen (5 s)
		local function moneyConfirm(kind: string, amount: number, label: string): boolean
			local who = string.lower(target())
			local big = math.abs(amount) >= 1e6 or amount < 0 or who == "all" or who == "others"
			if not big then
				return false
			end
			local shown = (if amount < 0 then "−" else "") .. fmtCredits(math.abs(amount))
			return needsConfirm(
				("%s|%s|%s"):format(kind, target(), tostring(amount)),
				("%s %s → %s"):format(label, shown, target())
			)
		end
		local crRow = UI.Row(page, 2, 40)
		local crBox = textBox(crRow, T("admin.creditsHint"), part(0.5))
		button(crRow, T("admin.giveCredits"), "Success", part(0.5), function()
			local amount = tonumber(crBox.Text)
			if not amount or amount ~= amount or math.abs(amount) < 1 then
				setStatus(T("core.invalid"), Theme.Down)
				return
			end
			if moneyConfirm("CR", amount, T("admin.giveCredits")) then
				return
			end
			admin("Give", { Target = target(), Grant = { Credits = amount } })
		end)
		local akyRow = UI.Row(page, 3, 40)
		local akyBox = textBox(akyRow, T("admin.akyHint"), part(0.5))
		button(akyRow, T("admin.giveAky"), "Primary", part(0.5), function()
			local amount = tonumber(akyBox.Text)
			if not amount or amount ~= amount or math.abs(amount) < 1 then
				setStatus(T("core.invalid"), Theme.Down)
				return
			end
			-- AKY markiert immer die Liga-Woche des Empfängers -> immer bestätigen
			if needsConfirm(("AKY|%s|%s"):format(target(), tostring(amount)), T("admin.giveAky")) then
				return
			end
			admin("GiveAky", { Target = target(), Aky = amount })
		end)
		local quickRain = UI.Slider(page, 4, T("admin.rainSeconds"), 60, 300, 120, function() end)
		local rainRow = UI.Row(page, 5, 40)
		button(rainRow, T("admin.moneyRainAll"), "Success", part(0.5), function()
			if needsConfirm("GiveRain", T("admin.moneyRainAll")) then
				return
			end
			admin("Abuse", { Event = "MoneyRain", Args = { Seconds = quickRain.Get() }, Global = false })
		end)
		button(rainRow, T("admin.ev.GoldenHour") .. " ×2", "Premium", part(0.5), function()
			if needsConfirm("GiveGolden", T("admin.ev.GoldenHour")) then
				return
			end
			admin("Abuse", { Event = "GoldenHour", Args = { Mult = 2, Minutes = 15 }, Global = false })
		end)

		-- Tempo & Sprung schenken (Wunsch 18): Ziel-Feld oben, befristet oder bis zum Zurücksetzen
		UI.Section(page, T("admin.secSpeed"), 6)
		textLine(page, T("admin.giftHint"), 7, Theme.Muted)
		local powers = Config.Security and Config.Security.Powers or {}
		local speedRange = powers.Speed or { Min = 16, Max = 200 }
		local jumpRange = powers.Jump or { Min = 7.2, Max = 100 }
		local giftSpeed = UI.Slider(
			page,
			8,
			T("admin.giftSpeedLabel"),
			math.floor(speedRange.Min),
			math.floor(speedRange.Max),
			50,
			function() end
		)
		local giftJump = UI.Slider(
			page,
			9,
			T("admin.giftJumpLabel"),
			math.floor(jumpRange.Min),
			math.floor(jumpRange.Max),
			math.floor(jumpRange.Min),
			function() end
		)
		-- exakte Zahl statt Ziehen (Handy, genaue Werte): Eingabe setzt den Regler, der Regler zeigt den Wert
		local exactRow = UI.Row(page, 10, 36)
		local function exactBox(slider: any, key: string, lo: number, hi: number)
			local box = textBox(exactRow, T(key, lo, hi), part(0.5))
			box.FocusLost:Connect(function()
				local n = tonumber(box.Text)
				if n and n == n then
					slider.Set(n)
					box.Text = tostring(slider.Get())
				elseif box.Text ~= "" then
					box.Text = ""
					setStatus(T("core.invalid"), Theme.Down)
				end
			end)
		end
		exactBox(giftSpeed, "admin.giftSpeedExact", math.floor(speedRange.Min), math.floor(speedRange.Max))
		exactBox(giftJump, "admin.giftJumpExact", math.floor(jumpRange.Min), math.floor(jumpRange.Max))
		local giftRow = UI.Row(page, 11, 40)
		local durationMinutes: { [string]: number } =
			{ ["5 min"] = 5, ["15 min"] = 15, ["30 min"] = 30, ["60 min"] = 60 }
		local durationCycler = UI.Cycler(
			giftRow,
			T("admin.giftDuration"),
			{ "15 min", "30 min", "60 min", T("admin.giftForever"), "5 min" },
			part(0.4)
		)
		button(giftRow, T("admin.giveSpeed"), "Success", part(0.3), function()
			local who = string.lower(target())
			if (who == "all" or who == "others") and needsConfirm("GiftSpeed" .. who, T("admin.secSpeed")) then
				return
			end
			local choice = durationCycler.Get() or ""
			admin("GiveSpeed", {
				Target = target(),
				Speed = giftSpeed.Get(),
				Jump = giftJump.Get(),
				Minutes = durationMinutes[choice] or 0,
			})
		end)
		button(giftRow, T("admin.giftResetBtn"), "Ghost", part(0.3), function()
			admin("GiveSpeed", { Target = target(), Reset = true })
		end)

		UI.Section(page, T("admin.secProgress"), 12)
		local licRow = UI.Row(page, 13, 40)
		local licences: { string } = {}
		local licenceList = Config.Progression and Config.Progression.Licences or {}
		for i, def in ipairs(licenceList) do
			table.insert(licences, ("%d · %s"):format(i, pick(def.Name, tostring(def.Key))))
		end
		local licCycler = UI.Cycler(licRow, T("admin.licence"), licences, part(0.6))
		button(licRow, T("admin.setLicence"), "Primary", part(0.4), function()
			local value = licCycler.Get()
			local idx = if value then tonumber(string.match(value, "^(%d+)")) else nil
			if needsConfirm("Licence" .. tostring(idx) .. target(), T("admin.setLicence")) then
				return
			end
			admin("SetLicence", { Target = target(), Licence = idx })
		end)
		local floorRow = UI.Row(page, 14, 40)
		local floorBox = textBox(floorRow, T("admin.floorsHint"), part(0.5))
		button(floorRow, T("admin.setFloors"), "Primary", part(0.5), function()
			if needsConfirm("Floors" .. target(), T("admin.setFloors")) then
				return
			end
			admin("SetFloors", { Target = target(), Floors = tonumber(floorBox.Text) })
		end)
		UI.Section(page, T("admin.secItems"), 15)
		local itemRow = UI.Row(page, 16, 40)
		local kindCycler = UI.Cycler(
			itemRow,
			T("admin.itemKind"),
			{ "Cars", "Watches", "Accessories", "Decor", "Cosmetics", "Titles" },
			part(0.34)
		)
		local itemBox = textBox(itemRow, T("admin.itemKeyHint"), part(0.36))
		button(itemRow, T("admin.give"), "Success", part(0.3), function()
			local kind = kindCycler.Get() or "Cars"
			local key = itemBox.Text
			local grant: { [string]: any } = {}
			if kind == "Decor" then
				grant.Decor = { [key] = 1 }
			else
				grant[kind] = { key }
			end
			admin("Give", { Target = target(), Grant = grant })
		end)
		local allGrid = UI.Grid(page, 17, 122, 40)
		for _, kind in ipairs({ "Cars", "Watches", "Accessories", "Decor" }) do
			button(allGrid, T("admin.giveAll" .. kind), "Secondary", UDim2.fromScale(1, 1), function()
				if needsConfirm("GiveAll" .. kind .. target(), T("admin.giveAll" .. kind)) then
					return
				end
				admin("GiveAllItems", { Target = target(), Kind = kind })
			end)
		end
		UI.Section(page, T("admin.secTokens"), 18)
		local tokenRow = UI.Row(page, 19, 40)
		local tokenKind = UI.Cycler(
			tokenRow,
			T("admin.tokenKind"),
			{ "SeasonTiers", "SeasonXp", "BoostX2", "BoostX5", "ExpressTokens", "InstantTokens" },
			part(0.4)
		)
		local tokenBox = textBox(tokenRow, T("admin.amount"), part(0.3))
		button(tokenRow, T("admin.give"), "Success", part(0.3), function()
			local kind = tokenKind.Get() or "SeasonTiers"
			admin("Give", { Target = target(), Grant = { [kind] = tonumber(tokenBox.Text) } })
		end)
	end

	-- =================================================================
	-- 6) KRÄFTE (eigene Attribute; der Server ehrt sie nur bei IsAdmin)
	-- =================================================================
	do
		local page = pages.Powers
		textLine(page, T("admin.powersHint"), 1, Theme.Warn)
		local grid = UI.Grid(page, 2, 166, 40)
		for _, info in ipairs({
			{ Name = "CanFly", Key = "admin.pFly", Default = true },
			{ Name = "AdminNoclip", Key = "admin.pNoclip", Default = false },
			{ Name = "AdminInvisible", Key = "admin.pInvisible", Default = false },
			{ Name = "AdminESP", Key = "admin.pESP", Default = false },
		}) do
			local b: any = nil
			local function refresh()
				local value = player:GetAttribute(info.Name)
				local on = value == true or (info.Default and value == nil)
				b.SetText(("%s: %s"):format(T(info.Key), T(if on then "admin.on" else "admin.off")))
				b.SetVariant(if on then "Primary" else "Secondary")
			end
			b = UI.Button({ Size = UDim2.fromScale(1, 1), Text = T(info.Key), MaxText = 15, Parent = grid }, function()
				local value = player:GetAttribute(info.Name)
				local on = value == true or (info.Default and value == nil)
				admin("SetPower", { Name = info.Name, Value = not on })
			end)
			player:GetAttributeChangedSignal(info.Name):Connect(refresh)
			refresh()
		end
		local powers = Config.Security and Config.Security.Powers or {}
		local speed = powers.Speed or { Min = 16, Max = 150 }
		local jump = powers.Jump or { Min = 7.2, Max = 100 }
		local speedMin = math.floor(speed.Min)
		local jumpMin = math.floor(jump.Min)
		local speedSlider = UI.Slider(
			page,
			3,
			T("admin.pSpeed"),
			speedMin,
			math.floor(speed.Max),
			num(player:GetAttribute("AdminSpeed"), speedMin),
			function(value: number)
				admin("SetPower", { Name = "AdminSpeed", Value = if value <= speedMin then nil else value })
			end
		)
		local jumpSlider = UI.Slider(
			page,
			4,
			T("admin.pJump"),
			jumpMin,
			math.floor(jump.Max),
			num(player:GetAttribute("AdminJump"), jumpMin),
			function(value: number)
				admin("SetPower", { Name = "AdminJump", Value = if value <= jumpMin then nil else value })
			end
		)
		player:GetAttributeChangedSignal("AdminSpeed"):Connect(function()
			speedSlider.Set(num(player:GetAttribute("AdminSpeed"), speedMin))
		end)
		player:GetAttributeChangedSignal("AdminJump"):Connect(function()
			jumpSlider.Set(num(player:GetAttribute("AdminJump"), jumpMin))
		end)
		local toolGrid = UI.Grid(page, 5, 166, 40)
		button(toolGrid, T("admin.flyNow"), "Secondary", UDim2.fromScale(1, 1), function()
			if not tryModule("Fly", "Toggle") then
				setStatus(T("admin.moduleMissing", "Fly"), Theme.Down)
			end
		end)
		button(toolGrid, T("admin.photo"), "Secondary", UDim2.fromScale(1, 1), function()
			if not tryModule("PhotoMode", "Toggle") then
				setStatus(T("admin.moduleMissing", "PhotoMode"), Theme.Down)
			end
		end)
		button(toolGrid, T("admin.showCam"), "Premium", UDim2.fromScale(1, 1), function()
			if not tryModule("AdminTools", "ToggleShowCam") then
				setStatus(T("admin.moduleMissing", "AdminTools"), Theme.Down)
			end
		end)
		button(toolGrid, T("admin.debugOverlay"), "Secondary", UDim2.fromScale(1, 1), function()
			tryModule("DebugOverlay", "Toggle")
		end)
		button(toolGrid, T("admin.visit"), "Secondary", UDim2.fromScale(1, 1), function()
			admin("Visit", { Target = target() })
		end)
		button(toolGrid, T("admin.spectate"), "Ghost", UDim2.fromScale(1, 1), function()
			if not spectate(findPlayer(target())) then
				setStatus(T("admin.noTarget"), Theme.Down)
			end
		end)
	end

	-- =================================================================
	-- 7) WELT (Vorschau nur lokal; Welt-Event jetzt starten = nur dieser Server)
	-- =================================================================
	do
		local page = pages.World
		UI.Section(page, T("admin.secLook"), 1)
		local lookRow = UI.Row(page, 2, 40)
		local lookCycler = UI.Cycler(
			lookRow,
			T("admin.look"),
			{ "Day", "Night", "Clear", "Clouds", "Storm", "Golden", "Crash", "Rally" },
			part(0.5),
			T("admin.auto")
		)
		button(lookRow, T("admin.apply"), "Primary", part(0.25), function()
			worldPreview = lookCycler.Get()
			if not tryModule("WorldLook", "SetOverride", worldPreview) then
				setStatus(T("admin.moduleMissing", "WorldLook"), Theme.Down)
			else
				setStatus(T("admin.lookSet", worldPreview or T("admin.auto")), Theme.Up)
			end
		end)
		button(lookRow, T("admin.auto"), "Ghost", part(0.25), function()
			worldPreview = nil
			lookCycler.Set(nil)
			tryModule("WorldLook", "SetOverride", nil)
			setStatus(T("admin.lookSet", T("admin.auto")), Theme.Up)
		end)
		UI.Slider(page, 3, T("admin.traffic"), 0, 200, 100, function(value: number)
			if tryModule("CityLife", "SetDensity", value / 100) then
				setStatus(T("admin.trafficSet", value), Theme.Up)
			end
		end)
		UI.Section(page, T("admin.secWorldEvents"), 4)
		local grid = UI.Grid(page, 5, 122, 40)
		for _, kind in ipairs({ "Truck", "Drones", "BuildBoom", "Press", "BellMoment", "SkyShow", "Bear", "GoldenBull" }) do
			button(grid, T("admin.world." .. kind), "Secondary", UDim2.fromScale(1, 1), function()
				admin("WorldEvent", { Event = kind })
			end)
		end
		textLine(page, T("admin.worldHint"), 6, Theme.Muted)
	end

	-- =================================================================
	-- 8) LIVE-OPS (AT_Live_v1, geprüft + geklemmt, Notschalter)
	-- =================================================================
	do
		local page = pages.Live
		local headRow = UI.Row(page, 1, 40)
		local info = UI.Label({
			Size = UDim2.new(0.7, -6, 1, 0),
			Text = T("admin.liveHint"),
			Font = UI.Fonts.Body,
			TextColor3 = Theme.Text2,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 14,
			LayoutOrder = 2,
			Parent = headRow,
		})
		local list = listFrame(page, 3)
		local function load()
			local result = admin("LiveGet")
			if not result or not result.Ok or type(result.Data) ~= "table" then
				return
			end
			local d = result.Data
			info.Text =
				T("admin.liveInfo", num(d.Version, 0), fmtTime(d.At), if d.Local then T("admin.liveLocalOnly") else "")
			clearChildren(list)
			local current = if type(d.Current) == "table" then d.Current else {}
			local cards = 0
			for i, spec in ipairs(if type(d.Specs) == "table" then d.Specs else {}) do
				if
					type(spec) == "table"
					and type(spec.Path) == "string"
					and not string.find(spec.Path, "*", 1, true)
				then
					cards += 1
					local card = UI.RowCard(list, i, 46)
					local value = current[spec.Path]
					local shown = if value == nil
						then T("admin.liveDefault")
						elseif type(value) == "table" then table.concat(value :: any, ",")
						else tostring(value)
					local range = if spec.Type == "number"
						then ("%s … %s"):format(tostring(spec.Min), tostring(spec.Max))
						elseif spec.Type == "list" then table.concat(
							if type(spec.Options) == "table" then spec.Options else {},
							","
						)
						else spec.Type
					UI.Label({
						Position = UDim2.fromOffset(12, 4),
						Size = UDim2.new(0.55, -12, 0, 20),
						Text = spec.Path,
						Font = UI.Fonts.Main,
						TextColor3 = Theme.Text,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd,
						MaxText = 14,
						Parent = card,
					})
					UI.Label({
						Position = UDim2.fromOffset(12, 24),
						Size = UDim2.new(0.55, -12, 0, 16),
						Text = ("%s · %s"):format(shown, range),
						Font = UI.Fonts.Body,
						TextColor3 = if value == nil then Theme.Muted else Theme.Accent,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd,
						MaxText = 12,
						Parent = card,
					})
					local actions = UI.RowActions(card, 230)
					if spec.Type == "boolean" then
						button(actions, T("admin.on"), "Primary", UDim2.new(0, 70, 1, 0), function()
							admin("LiveSet", { Path = spec.Path, Value = true })
							task.delay(0.3, load)
						end)
						button(actions, T("admin.off"), "Secondary", UDim2.new(0, 70, 1, 0), function()
							admin("LiveSet", { Path = spec.Path, Value = false })
							task.delay(0.3, load)
						end)
					else
						local box = UI.TextBox({
							Size = UDim2.new(0, 110, 1, 0),
							PlaceholderText = T("admin.value"),
							Text = "",
							Font = UI.Fonts.Body,
							Parent = actions,
						})
						button(actions, T("admin.setBtn"), "Primary", UDim2.new(0, 60, 1, 0), function()
							local raw = box.Text
							local valueToSend: any
							if spec.Type == "list" then
								local items: { string } = {}
								for item in string.gmatch(raw, "[^,%s]+") do
									table.insert(items, item)
								end
								valueToSend = items
							else
								valueToSend = tonumber(raw)
							end
							if valueToSend == nil then
								setStatus(T("core.invalid"), Theme.Down)
								return
							end
							if needsConfirm("Live" .. spec.Path, spec.Path) then
								return
							end
							admin("LiveSet", { Path = spec.Path, Value = valueToSend })
							task.delay(0.3, load)
						end)
					end
					button(actions, "↺", "Ghost", UDim2.new(0, 40, 1, 0), function()
						admin("LiveSet", { Path = spec.Path, Clear = true })
						task.delay(0.3, load)
					end)
				end
			end
			if cards == 0 then
				textLine(list, T("admin.nothing"), 1, Theme.Muted) -- Leerzustand statt leerer Fläche
			end
		end
		local loadBtn = button(headRow, T("admin.refresh"), "Secondary", part(0.3), load)
		loadBtn.Frame.LayoutOrder = 1
		onTabOpen.Live = load

		UI.Section(page, T("admin.secEmergency"), 10)
		local productRow = UI.Row(page, 11, 40)
		local productCycler: any = nil
		local shopKeys: { string } = {}
		for _, l in ipairs({ Config.Shop and Config.Shop.Products, Config.Shop and Config.Shop.GamePasses }) do
			for _, key in ipairs(keysOf(l)) do
				table.insert(shopKeys, key)
			end
		end
		productCycler = UI.Cycler(productRow, T("admin.product"), shopKeys, part(0.4))
		button(productRow, T("admin.productOff"), "Danger", part(0.3), function()
			local key = productCycler.Get()
			if not key or needsConfirm("ProductOff" .. key, T("admin.productOff")) then
				return
			end
			admin("LiveSet", { Path = "Shop.Disabled." .. key, Value = true })
		end)
		button(productRow, T("admin.productOn"), "Success", part(0.3), function()
			local key = productCycler.Get()
			if key then
				admin("LiveSet", { Path = "Shop.Disabled." .. key, Clear = true })
			end
		end)
		local boostRow = UI.Row(page, 12, 40)
		button(boostRow, T("admin.boostPause"), "Danger", part(0.5), function()
			if needsConfirm("BoostPause", T("admin.boostPause")) then
				return
			end
			admin("LiveSet", { Path = "Events.BoostPause", Value = true })
		end)
		button(boostRow, T("admin.boostResume"), "Success", part(0.5), function()
			admin("LiveSet", { Path = "Events.BoostPause", Clear = true })
		end)
		local bannerRow = UI.Row(page, 13, 40)
		local bannerBox = textBox(bannerRow, T("admin.bannerHint"), part(0.5))
		button(bannerRow, T("admin.bannerSet"), "Premium", part(0.25), function()
			if needsConfirm("Banner", T("admin.bannerSet")) then
				return
			end
			admin("LiveBanner", { Text = bannerBox.Text })
		end)
		button(bannerRow, T("admin.bannerOff"), "Ghost", part(0.25), function()
			admin("LiveBanner", { Text = "" })
		end)
		UI.Section(page, T("admin.secCodes"), 14)
		local codeRow = UI.Row(page, 15, 40)
		local codeBox = textBox(codeRow, T("admin.codeHint"), part(0.3))
		local codeCredits = textBox(codeRow, T("admin.creditsHint"), part(0.25))
		local codeExpires = textBox(codeRow, T("admin.expiresHint"), part(0.25))
		button(codeRow, T("admin.setBtn"), "Primary", part(0.2), function()
			local code = string.upper(codeBox.Text)
			local credits = tonumber(codeCredits.Text)
			if code == "" or not credits then
				setStatus(T("core.invalid"), Theme.Down)
				return
			end
			local value: { [string]: any } = { Grant = { Credits = math.floor(credits) } }
			if codeExpires.Text ~= "" then
				value.Expires = codeExpires.Text
			end
			if needsConfirm("Code" .. code, code) then
				return
			end
			admin("LiveSet", { Path = "Rewards.Codes." .. code, Value = value })
		end)
	end

	-- =================================================================
	-- 9) STATISTIK
	-- =================================================================
	do
		local page = pages.Stats
		local row = tiles(page, 1)
		local kpiOnline = UI.StatTile(row, T("admin.kpiOnline"), 1)
		local kpiGlobal = UI.StatTile(row, T("admin.kpiGlobal"), 2)
		local kpiFills = UI.StatTile(row, T("admin.kpiFills"), 3)
		local kpiAudit = UI.StatTile(row, T("admin.kpiAudit"), 4)
		local actRow = UI.Row(page, 2, 40)
		local out: Frame
		local function load()
			setStatus(T("core.loading"), Theme.Text2)
			local result = admin("Stats")
			if not result or not result.Ok or type(result.Data) ~= "table" then
				return
			end
			local d = result.Data
			kpiOnline.Text = tostring(num(d.Online, 0))
			kpiGlobal.Text = ("%d · %d"):format(num(d.GlobalPlayers, 0), num(d.Servers, 0))
			kpiFills.Text = tostring(num(d.FillsPerMin, 0))
			local audit = if type(d.Audit) == "table" then d.Audit else {}
			kpiAudit.Text = ("%d / %d"):format(num(audit.Failed, 0), num(audit.Checked, 0))
			kpiAudit.TextColor3 = if num(audit.Failed, 0) > 0 then Theme.Down else Theme.Text
			local lines: { string } = {
				T("admin.statsMoney", fmtCredits(d.Credits), fmtAky(d.AkyCents)),
			}
			local today = if type(d.Today) == "table" then d.Today else {}
			local yesterday = if type(d.Yesterday) == "table" then d.Yesterday else {}
			table.insert(
				lines,
				T(
					"admin.statsPurchases",
					num(today.Count, 0),
					num(today.Robux, 0),
					num(yesterday.Count, 0),
					num(yesterday.Robux, 0)
				)
			)
			if d.Local then
				table.insert(lines, T("admin.statsLocal"))
			end
			if type(d.Traded) == "table" and #d.Traded > 0 then
				local parts: { string } = {}
				for _, e in ipairs(d.Traded) do
					if type(e) == "table" then
						table.insert(parts, ("%s ×%d"):format(tickerOf(e.I), num(e.N, 0)))
					end
				end
				table.insert(lines, T("admin.statsTraded", table.concat(parts, " · ")))
			end
			local ac = if type(d.AntiCheat) == "table" then d.AntiCheat else {}
			table.insert(
				lines,
				T("admin.statsAc", num(ac.Tracked, 0), num(ac.Flags, 0), num(ac.Reports, 0), num(ac.Kicks, 0))
			)
			local ev = if type(d.Events) == "table" then d.Events else {}
			table.insert(
				lines,
				T("admin.statsEvents", num(ev.Started, 0), num(ev.Pickups, 0), num(ev.Rejected, 0), num(ev.BearWins, 0))
			)
			if type(d.Suspicious) == "table" then
				for _, s in ipairs(d.Suspicious) do
					if type(s) == "table" then
						table.insert(
							lines,
							T("admin.statsSuspicious", tostring(s.Name), tostring(s.UserId), num(s.Score, 0))
						)
					end
				end
			end
			table.insert(lines, T("admin.statsSinks"))
			showLines(out, lines)
		end
		button(actRow, T("admin.refresh"), "Secondary", part(0.3), load)
		out = outputBox(page, 3)
		onTabOpen.Stats = load
	end

	-- =================================================================
	-- 10) MODERATION (Flags, Meldungen, Bann-Log, Admin-Log)
	-- =================================================================
	do
		local page = pages.Mod
		local row = UI.Row(page, 1, 40)
		local list = listFrame(page, 2)
		local mode = "Flags"
		local function load(kind: string)
			mode = kind
			local result = admin(kind)
			if not result or not result.Ok or type(result.Data) ~= "table" then
				return
			end
			clearChildren(list)
			if #result.Data == 0 then
				textLine(list, T("admin.nothing"), 1, Theme.Muted)
			end
			for i, e in ipairs(result.Data) do
				if i > 100 then -- letzte 100 Admin-Aktionen (Wunsch 18)
					break
				end
				if type(e) ~= "table" then
					continue
				end
				if kind == "AdminLog" then
					textLine(
						list,
						T(
							"admin.logLine",
							fmtTime(e.T),
							tostring(e.Name),
							tostring(e.Action),
							if e.Ok then "✔" else "✖",
							tostring(e.Msg or "")
						),
						i,
						if e.Ok then Theme.Text2 else Theme.Warn
					)
					continue
				end
				if kind == "BanList" then
					textLine(
						list,
						T(
							"admin.banLine",
							tostring(e.Name),
							tostring(e.UserId),
							fmtTime(e.T),
							tostring(e.Duration),
							tostring(e.Reason),
							if e.Active then "" else " ✔"
						),
						i,
						Theme.Text2
					)
					continue
				end
				local text
				if kind == "Flags" then
					local reasons = if type(e.Reasons) == "table" then table.concat(e.Reasons, ", ") else ""
					text = T(
						"admin.flagLine",
						tostring(e.Name),
						tostring(e.UserId),
						num(e.Score, 0),
						reasons,
						fmtTime(e.T)
					)
				else
					local snap = if type(e.Snapshot) == "table" then e.Snapshot else {}
					text = T(
						"admin.reportLine",
						tostring(e.FromName),
						tostring(e.Name),
						T("admin.reason." .. tostring(e.Reason)),
						tostring(snap.Score or "?"),
						fmtTime(e.T)
					)
				end
				local card = UI.Card({
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					LayoutOrder = i,
					Parent = list,
				})
				UI.Create(
					"UIListLayout",
					{ SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = card }
				)
				UI.Create("UIPadding", {
					PaddingLeft = UDim.new(0, 6),
					PaddingRight = UDim.new(0, 6),
					PaddingTop = UDim.new(0, 4),
					PaddingBottom = UDim.new(0, 4),
					Parent = card,
				})
				textLine(card, text, 1)
				local actions = UI.Row(card, 2, 34)
				local userId = tonumber(e.UserId)
				button(actions, T("admin.view"), "Ghost", part(0.14), function()
					spectate(if userId then Players:GetPlayerByUserId(userId) else nil)
				end)
				for _, duration in ipairs({ "1d", "7d", "perm" }) do
					button(actions, T("admin.banFor", duration), "Danger", part(0.18), function()
						if needsConfirm("ModBan" .. tostring(userId) .. duration, T("admin.banFor", duration)) then
							return
						end
						admin("Ban", { UserId = userId, Duration = duration, Reason = T("admin.modReason") })
					end)
				end
				button(actions, T("admin.dismiss"), "Ghost", part(0.32), function()
					admin("DismissFlag", { Id = e.Id })
					load(mode)
				end)
			end
		end
		button(row, T("admin.flagsBtn"), "Secondary", part(0.25), function()
			load("Flags")
		end)
		button(row, T("admin.reportsBtn"), "Secondary", part(0.25), function()
			load("Reports")
		end)
		button(row, T("admin.banListBtn"), "Secondary", part(0.25), function()
			load("BanList")
		end)
		button(row, T("admin.adminLogBtn"), "Secondary", part(0.25), function()
			load("AdminLog")
		end)
		onTabOpen.Mod = function()
			load(mode)
		end
	end

	-- =================================================================
	-- 11) DEBUG
	-- =================================================================
	do
		local page = pages.Debug
		local products: { string } = keysOf(Config.Shop and Config.Shop.Products)
		for _, key in ipairs(keysOf(Config.Shop and Config.Shop.GamePasses)) do
			table.insert(products, key)
		end
		UI.Section(page, T("admin.secShopTest"), 1)
		local buyRow = UI.Row(page, 2, 40)
		local productCycler = UI.Cycler(buyRow, T("admin.product"), products, part(0.6))
		button(buyRow, T("admin.simPurchase"), "Primary", part(0.4), function()
			admin("SimulatePurchase", { ProductKey = productCycler.Get() })
		end)
		local policyRow = UI.Row(page, 3, 40)
		local fieldCycler =
			UI.Cycler(policyRow, T("admin.policyField"), { "Random", "Trading", "Subscription" }, part(0.31))
		button(policyRow, T("admin.policyAllowedBtn"), "Secondary", part(0.23), function()
			admin("SimulatePolicy", { Field = fieldCycler.Get(), Allowed = true })
		end)
		button(policyRow, T("admin.policyRestrictedBtn"), "Secondary", part(0.23), function()
			admin("SimulatePolicy", { Field = fieldCycler.Get(), Allowed = false })
		end)
		button(policyRow, T("admin.policyAutoBtn"), "Ghost", part(0.23), function()
			admin("SimulatePolicy", { Field = fieldCycler.Get() })
		end)
		UI.Section(page, T("admin.secTools"), 4)
		local toolRow = UI.Row(page, 5, 40)
		button(toolRow, T("admin.skipDay"), "Secondary", part(0.33), function()
			admin("SkipDay")
		end)
		button(toolRow, T("admin.selfTestBtn"), "Primary", part(0.33), function()
			admin("RunSelfTest")
		end)
		button(toolRow, T("admin.debugOverlay"), "Secondary", part(0.34), function()
			tryModule("DebugOverlay", "Toggle")
		end)
		local flagRow = UI.Row(page, 6, 40)
		for _, info in ipairs({
			{ Key = "LogRejects", Label = "admin.dbgRejects" },
			{ Key = "ForceRestricted", Label = "admin.dbgRestricted" },
			{ Key = "ShowTriggers", Label = "admin.dbgTriggers" },
		}) do
			local b: any = nil
			local function refresh()
				local on = workspace:GetAttribute("Debug" .. info.Key) == true
				b.SetText(("%s: %s"):format(T(info.Label), T(if on then "admin.on" else "admin.off")))
				b.SetVariant(if on then "Primary" else "Secondary")
			end
			b = button(flagRow, T(info.Label), "Secondary", part(0.333), function()
				local on = workspace:GetAttribute("Debug" .. info.Key) == true
				admin("SetDebug", { [info.Key] = not on })
			end)
			workspace:GetAttributeChangedSignal("Debug" .. info.Key):Connect(refresh)
			refresh()
		end
		local probeRow = UI.Row(page, 7, 40)
		button(probeRow, T("admin.crashProbe"), "Danger", part(0.5), function()
			-- Crash-Freitag-Probe (lokal): Bär auf diesem Server + roter Himmel nur bei dir, kein Markteinfluss
			local result = admin("WorldEvent", { Event = "Bear", Probe = true })
			if result and result.Ok then
				tryModule("WorldLook", "SetOverride", "Crash")
				task.delay(20, function()
					if worldPreview == nil then
						tryModule("WorldLook", "SetOverride", nil)
					end
				end)
			end
		end)
		button(probeRow, T("admin.rallyProbe"), "Success", part(0.5), function()
			local result = admin("WorldEvent", { Event = "GoldenBull" })
			if result and result.Ok then
				tryModule("WorldLook", "SetOverride", "Rally")
				task.delay(20, function()
					if worldPreview == nil then
						tryModule("WorldLook", "SetOverride", nil)
					end
				end)
			end
		end)
	end

	selectTab(currentTab)
	-- Beim Öffnen den aktuellen Reiter auffrischen
	win.OnOpen = function()
		local hook = onTabOpen[currentTab]
		if hook then
			task.spawn(hook)
		end
	end
end

-- =====================================================================
-- ÖFFENTLICHE API + LEBENSZYKLUS
-- =====================================================================
local function openWindow()
	if player:GetAttribute("IsAdmin") ~= true then
		return
	end
	build()
	if win and not win.IsOpen then
		UI.OpenWindow(win) -- ruft win.OnOpen selbst auf (aktueller Reiter wird aufgefrischt)
	end
end

local function closeWindow()
	if win and win.IsOpen then
		UI.CloseWindow(win)
	end
end

function AdminPanel.Toggle()
	local windows = ctx and ctx.Windows
	if windows and type(windows.IsOpen) == "function" and type(windows.Open) == "function" then
		if windows.IsOpen(WINDOW_NAME) then
			windows.Close(WINDOW_NAME)
		else
			windows.Open(WINDOW_NAME)
		end
		return
	end
	if win and win.IsOpen then
		closeWindow()
	else
		openWindow()
	end
end

function AdminPanel.Init(context: any)
	ctx = context
	UI = ctx.UI or require(script.Parent:WaitForChild("UI"))
	Theme = UI.Theme
	local windows = ctx.Windows
	if windows and type(windows.Register) == "function" then
		windows.Register(WINDOW_NAME, openWindow, closeWindow)
	end
end

function AdminPanel.Start()
	if player:GetAttribute("IsAdmin") ~= true then
		return
	end
	-- Rechter HUD-Knopf (Order 99)
	local hud = module("Hud")
	if hud and type(hud.AddRightButton) == "function" then
		pcall(hud.AddRightButton, "🛠️", "admin.button", Theme.Down, 99, AdminPanel.Toggle)
	end
	-- Taste P (über Controls, sonst direkt) + X beendet das Zuschauen
	local controls = module("Controls")
	local bound = false
	if controls and type(controls.Bind) == "function" then
		bound = pcall(controls.Bind, "AdminPanel", function(state: string)
			if state == "Begin" then
				AdminPanel.Toggle()
			end
		end)
		pcall(controls.Bind, "Spectate", function(state: string)
			if state == "Begin" and spectating then
				stopSpectate()
			end
		end)
	end
	local keys = ctx.Config and ctx.Config.Client and ctx.Config.Client.Keys or {}
	local function codeOf(list: any, fallback: Enum.KeyCode): Enum.KeyCode
		if type(list) == "table" and type(list[1]) == "string" then
			local ok, code = pcall(function()
				return (Enum.KeyCode :: any)[list[1]]
			end)
			if ok and typeof(code) == "EnumItem" then
				return code :: any
			end
		end
		return fallback
	end
	local panelKey = codeOf(keys.AdminPanel, Enum.KeyCode.P)
	local spectateKey = codeOf(keys.Spectate, Enum.KeyCode.X)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		if not bound and input.KeyCode == panelKey then
			AdminPanel.Toggle()
		elseif not bound and input.KeyCode == spectateKey and spectating then
			stopSpectate()
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		if p == spectating then
			stopSpectate()
		end
	end)
end

return AdminPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">AdminTools</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Admin-Kräfte auf dem Client (Client/Modules/AdminTools)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Vertrag: DESIGN.md §B15.2 (Tab "Kräfte"), §C11.3 (Noclip/Fly exempt),
--  REUSE §1.4 (CC-AdminTools ADAPT: nur lokales Noclip/Tempo/Sprung + ESP über Highlights; Aimbot/Silent Aim/Triggerbot/
--  Taint-Schild sind entfernt). Nur für den Besitzer (Modul lädt nur bei IsAdmin). Alle Kräfte sind Attribute am eigenen
--  Player, die NUR der Server setzt (SetPower) – und der Server ehrt sie nur bei IsAdmin. Hier passiert nur die lokale Seite:
--    * Noclip (AdminNoclip), Tempo (AdminSpeed), Sprung (AdminJump) am eigenen Humanoid (vor der Physik)
--    * ESP (AdminESP): ≤ 20 Highlights über den zentralen Verteiler "Highlights" + Name/Abstand über dem Kopf (4 Hz)
--    * Show-Kamera (Kino für Streams): langsamer Kreisflug um die Plaza, HUD aus, Taste X oder Panel beendet
--  Look: ESP-Schilder BuilderSansBold, Accent-Kontur (AKYTEX), feine 1-px-Kante.
--
--  Öffentliche API:
--    AdminTools.ToggleShowCam()        AdminTools.IsShowCam(): boolean
--    AdminTools.Init(ctx) / AdminTools.Start()
-- =====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local AdminTools = {}

local player = Players.LocalPlayer
local ctx: any = nil

local ESP_OWNER = "AdminESP"
local ESP_HZ = 4
local ESP_RANGE = 2500
local ESP_COLOR = Color3.fromRGB(79, 140, 255) -- AKYTEX Accent (#4f8cff)
local TEXT_COLOR = Color3.fromRGB(230, 236, 245) -- AKYTEX Text (#e6ecf5)
local DEFAULT_WALK = 16
local DEFAULT_JUMP = 7.2
local CAM_RADIUS = 280
local CAM_HEIGHT = 130
local CAM_SPEED = 0.045 -- Radiant je Sekunde
local CAM_BOB = 18

type EspSlot = { Gui: BillboardGui, Label: TextLabel, Model: Model?, Handle: any? }

local photoHidden = false
local espSlots: { EspSlot } = {}
local espAcc = 0
local espActive = false
local noclipParts: { [BasePart]: boolean } = {}
local speedOverridden = false
local jumpOverridden = false
local showCam = false
local showAngle = 0
local showTime = 0
local savedCameraType: Enum.CameraType? = nil

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function module(name: string): any
	local modules = ctx and ctx.Modules
	return if type(modules) == "table" then modules[name] else nil
end

local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function toast(text: string, kind: string)
	if ctx and type(ctx.Toast) == "function" then
		ctx.Toast(text, kind)
	end
end

local function power(name: string): any
	if player:GetAttribute("IsAdmin") ~= true then
		return nil
	end
	return player:GetAttribute(name)
end

local function espMax(): number
	local security = ctx and ctx.Config and ctx.Config.Security
	local powers = security and security.Powers
	local n = powers and tonumber(powers.EspMax)
	return math.clamp(math.floor(n or 20), 1, 20)
end

-- ---------------------------------------------------------------------
-- ESP (≤ 20, über Highlights)
-- ---------------------------------------------------------------------
local function espSlot(index: number): EspSlot
	local slot = espSlots[index]
	if slot then
		return slot
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "AT_AdminESP"
	gui.Size = UDim2.fromOffset(200, 30)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = ESP_RANGE
	gui.ResetOnSpawn = false
	gui.Enabled = false
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.BuilderSansBold
	label.TextScaled = true
	label.TextColor3 = ESP_COLOR:Lerp(TEXT_COLOR, 0.35)
	label.Text = ""
	local sizeLimit = Instance.new("UITextSizeConstraint")
	sizeLimit.MaxTextSize = 17
	sizeLimit.Parent = label
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Transparency = 0.45
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = player:FindFirstChildOfClass("PlayerGui")
	local created: EspSlot = { Gui = gui, Label = label, Model = nil, Handle = nil }
	espSlots[index] = created
	return created
end

local function releaseSlot(slot: EspSlot)
	local highlights = module("Highlights")
	if slot.Handle ~= nil and highlights and type(highlights.Release) == "function" then
		pcall(highlights.Release, slot.Handle)
	end
	slot.Handle = nil
	slot.Model = nil
	slot.Gui.Enabled = false
	(slot.Gui :: any).Adornee = nil -- Typdefinition kennt kein optionales Adornee
end

local function clearEsp()
	for _, slot in ipairs(espSlots) do
		releaseSlot(slot)
	end
	local highlights = module("Highlights")
	if highlights and type(highlights.ReleaseOwner) == "function" then
		pcall(highlights.ReleaseOwner, ESP_OWNER)
	end
	espActive = false
end

local function updateEsp()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local camPos = camera.CFrame.Position
	local list: { { Model: Model, Head: BasePart, Dist: number, Name: string } } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local character = p.Character
		if p ~= player and character then
			local head = character:FindFirstChild("Head")
			local root = character:FindFirstChild("HumanoidRootPart")
			if head and root and head:IsA("BasePart") and root:IsA("BasePart") then
				local dist = (root.Position - camPos).Magnitude
				if dist <= ESP_RANGE then
					table.insert(list, { Model = character, Head = head, Dist = dist, Name = p.DisplayName })
				end
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Dist < b.Dist
	end)
	local maxSlots = espMax()
	local used = math.min(#list, maxSlots)
	local wanted: { [Model]: boolean } = {}
	for i = 1, used do
		wanted[list[i].Model] = true
	end
	for _, slot in ipairs(espSlots) do
		if slot.Model and not wanted[slot.Model] then
			releaseSlot(slot)
		end
	end
	local highlights = module("Highlights")
	for i = 1, used do
		local entry = list[i]
		local slot: EspSlot? = nil
		for _, s in ipairs(espSlots) do
			if s.Model == entry.Model then
				slot = s
				break
			end
		end
		if not slot then
			for index = 1, maxSlots do
				local s = espSlot(index)
				if s.Model == nil then
					slot = s
					break
				end
			end
		end
		if slot then
			if slot.Model ~= entry.Model then
				slot.Model = entry.Model
				slot.Gui.Adornee = entry.Head
				if highlights and type(highlights.Acquire) == "function" then
					local ok, handle = pcall(highlights.Acquire, ESP_OWNER, entry.Model, {
						Outline = ESP_COLOR,
						Fill = ESP_COLOR,
						FillTransparency = 0.8,
						Depth = Enum.HighlightDepthMode.AlwaysOnTop,
					})
					slot.Handle = if ok then handle else nil
				end
			end
			local text = ("%s · %dm"):format(entry.Name, math.floor(entry.Dist))
			if slot.Label.Text ~= text then
				slot.Label.Text = text
			end
			slot.Gui.Enabled = not photoHidden
		end
	end
	espActive = true
end

-- ---------------------------------------------------------------------
-- NOCLIP / TEMPO / SPRUNG (vor der Physik, damit die Steuerung sie nicht überschreibt)
-- ---------------------------------------------------------------------
local function restoreNoclip()
	for part, original in pairs(noclipParts) do
		if part.Parent then
			part.CanCollide = original
		end
	end
	table.clear(noclipParts)
end

local function preSimulation()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid then
		return
	end
	if power("AdminNoclip") == true then
		for _, d in ipairs(character:GetDescendants()) do
			if d:IsA("BasePart") and d.CanCollide then
				if noclipParts[d] == nil then
					noclipParts[d] = true
				end
				d.CanCollide = false
			end
		end
	elseif next(noclipParts) ~= nil then
		restoreNoclip()
	end
	local speed = power("AdminSpeed")
	if type(speed) == "number" then
		if humanoid.WalkSpeed ~= speed then
			humanoid.WalkSpeed = speed
		end
		speedOverridden = true
	elseif speedOverridden then
		speedOverridden = false
		-- zurück auf ein laufendes Speed-Geschenk ("me"), sonst Standard
		local gift = player:GetAttribute("GiftSpeed")
		humanoid.WalkSpeed = if type(gift) == "number" then gift else DEFAULT_WALK
	end
	local jump = power("AdminJump")
	if type(jump) == "number" then
		humanoid.UseJumpPower = false
		if humanoid.JumpHeight ~= jump then
			humanoid.JumpHeight = jump
		end
		jumpOverridden = true
	elseif jumpOverridden then
		jumpOverridden = false
		local gift = player:GetAttribute("GiftJump")
		humanoid.JumpHeight = if type(gift) == "number" then gift else DEFAULT_JUMP
	end
end

-- ---------------------------------------------------------------------
-- SHOW-KAMERA (Kino für Streams)
-- ---------------------------------------------------------------------
local function plazaCenter(): Vector3
	local city = ctx and ctx.Config and ctx.Config.City
	local zones = city and city.Zones
	local plaza = zones and zones.Plaza
	if plaza and typeof(plaza.Center) == "Vector3" then
		return plaza.Center
	end
	return Vector3.zero
end

local function setHudHidden(hidden: boolean)
	local hud = module("Hud")
	if hud and type(hud.SetVisible) == "function" then
		pcall(hud.SetVisible, not hidden)
	end
end

local function stopShowCam()
	if not showCam then
		return
	end
	showCam = false
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = savedCameraType or Enum.CameraType.Custom
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
	savedCameraType = nil
	setHudHidden(false)
	toast(T("admin.showCamOff"), "Info")
end

function AdminTools.IsShowCam(): boolean
	return showCam
end

function AdminTools.ToggleShowCam()
	if showCam then
		stopShowCam()
		return
	end
	if player:GetAttribute("IsAdmin") ~= true then
		return
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local windows = ctx and ctx.Windows
	if windows and type(windows.Close) == "function" then
		pcall(windows.Close)
	end
	savedCameraType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable
	local offset = camera.CFrame.Position - plazaCenter()
	showAngle = math.atan2(offset.Z, offset.X)
	showTime = 0
	showCam = true
	setHudHidden(true)
	toast(T("admin.showCamOn"), "Success")
end

local function stepShowCam(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	showTime += dt
	showAngle += CAM_SPEED * dt
	local center = plazaCenter()
	local height = CAM_HEIGHT + math.sin(showTime * 0.12) * CAM_BOB
	local radius = CAM_RADIUS + math.sin(showTime * 0.07) * 40
	local pos = center + Vector3.new(math.cos(showAngle) * radius, height, math.sin(showAngle) * radius)
	local target = CFrame.lookAt(pos, center + Vector3.new(0, 30, 0))
	camera.CFrame = camera.CFrame:Lerp(target, math.clamp(dt * 2, 0, 1))
end

local function preRender(dt: number)
	if showCam then
		stepShowCam(dt)
	end
	espAcc += dt
	if espAcc >= 1 / ESP_HZ then
		espAcc = 0
		if power("AdminESP") == true and not photoHidden then
			updateEsp()
		elseif espActive then
			clearEsp()
		end
	end
end

function AdminTools.Init(context: any)
	ctx = context
end

function AdminTools.Start()
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		hooks.On("PhotoMode", function(on: any)
			photoHidden = on == true
			if photoHidden then
				clearEsp()
			end
		end)
	end
	RunService.PreRender:Connect(preRender)
	RunService.PreSimulation:Connect(preSimulation)
	player:GetAttributeChangedSignal("AdminESP"):Connect(function()
		if player:GetAttribute("AdminESP") ~= true then
			clearEsp()
		end
	end)
	player.CharacterAdded:Connect(function()
		table.clear(noclipParts)
		speedOverridden = false
		jumpOverridden = false
		if showCam then
			stopShowCam()
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		local character = p.Character
		for _, slot in ipairs(espSlots) do
			if slot.Model ~= nil and slot.Model == character then
				releaseSlot(slot)
			end
		end
	end)
	-- Show-Kamera mit X beenden (Zuschauen benutzt X ebenfalls – nur wenn die Show-Kamera läuft)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		if showCam and (input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.ButtonB) then
			stopShowCam()
		end
	end)
	-- Handy: HUD ist aus -> lange auf den Bildschirm drücken beendet die Show-Kamera (REUSE §7 #37)
	UserInputService.TouchLongPress:Connect(function(_positions, state)
		if showCam and state == Enum.UserInputState.Begin then
			stopShowCam()
		end
	end)
end

return AdminTools
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="126">
            <Properties>
              <string name="Name">Boards</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Bestenlisten & Wochen-Liga (Client/Modules/Boards)
--  Besitzer: WP9 (Fortschritt, Tutorial, Sozial, Bestenlisten). Vertrag: DESIGN.md §B11.1 (6 Bestenlisten, Ansicht
--  Global / Freunde / Server, Liga nach Skill-Score statt Kontogröße, absolute Liga-Stufen, Admin-Fenster ausgenommen),
--  §B11.5 (kein öffentliches Verlust-Zeigen), §C7.3 (Fenster "Boards"), §C7.5 (Boards.Open(board?)).
--
--  Öffentliche API (§C7.5):  Boards.Open(board?)   Fenster öffnen, optional direkt auf einer Liste ("League" …)
--  Zusätzlich: Boards.Init(ctx), Boards.Start()
--  Anfragen: BoardsGet { Board, Scope } (1/s, Server antwortet aus dem Cache).  State: "League" (eigene Stufe).
--  Avatare über rbxthumb:// (keine Web-Anfrage vom Client nötig).
-- =====================================================================

local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local Boards = {}

local Theme = UI.Theme

local WINDOW_W, WINDOW_H = 680, 620
local CACHE_SECONDS = 30 -- gleiche Liste/Ansicht höchstens so oft neu anfragen
local REQUEST_GAP = 1.05 -- Server-Rate 1/s
local SCOPES = { "Global", "Friends", "Server" }
local MEDALS = { Theme.Gold, Color3.fromRGB(192, 199, 212), Color3.fromRGB(205, 127, 50) }
local ROW_IN = TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local ctx: any = nil
local window: any = nil
local boardSeg: any = nil
local scopeSeg: any = nil
local board = "League"
local scope = "Global"
local ui: { [string]: any } = {}
local cache: { [string]: { At: number, Reply: any } } = {}
local lastRequestAt = 0
local loadingKey: string? = nil
local token = 0

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

local function boardList(): { any }
	local p = ctx.Config.Progression
	local list = type(p) == "table" and p.Boards and p.Boards.List or nil
	return if type(list) == "table" then list else {}
end

local function isBoard(key: any): boolean
	for _, def in ipairs(boardList()) do
		if def.Key == key then
			return true
		end
	end
	return false
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	props.Parent = parent
	if props.TextXAlignment == nil then
		props.TextXAlignment = Enum.TextXAlignment.Left
	end
	return UI.Label(props)
end

local function clear(frame: Instance)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function tierName(key: any): string
	if type(key) ~= "string" or key == "" then
		key = "None"
	end
	return T("prog.tier." .. key)
end

-- ---------------------------------------------------------------------
-- 2) ZEILEN
-- ---------------------------------------------------------------------
local function row(parent: Instance, order: number, entry: { [string]: any }, mine: boolean)
	local card = UI.RowCard(parent, order, 52)
	local rank = math.floor(num(entry.Rank, order))
	local medal = MEDALS[rank]
	if mine then
		-- eigene Zeile: Akzent-Tönung als eigene Ebene (RowCard setzt die Hintergrundfarbe beim Hover zurück)
		UI.Create("Frame", {
			Name = "MineTint",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.AccentDeep,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			ZIndex = card.ZIndex,
			Parent = card,
		}, { UI.Corner(10) })
		local stroke = card:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = Theme.Accent
			stroke.Transparency = 0
		end
	end
	if medal or mine then
		UI.Create("Frame", {
			Name = "Stripe",
			Position = UDim2.new(0, 0, 0.2, 0),
			Size = UDim2.new(0, 3, 0.6, 0),
			BackgroundColor3 = if mine then Theme.Accent else medal,
			BorderSizePixel = 0,
			Parent = card,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	end
	UI.Label({
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.fromOffset(44, 52),
		Text = "#" .. tostring(rank),
		Face = "MonoBold",
		TextColor3 = medal or Theme.Text2,
		MaxText = 18,
		Parent = card,
	})
	local userId = math.floor(num(entry.UserId, 0))
	local avatar = UI.Create("ImageLabel", {
		Position = UDim2.fromOffset(56, 6),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = Theme.Bg2,
		Image = if userId > 0 then string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", userId) else "",
		Parent = card,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.Stroke(medal or Theme.Border, 1) })
	avatar.ScaleType = Enum.ScaleType.Crop
	local gifted = entry.AdminGift == true
	UI.Label({
		Position = UDim2.fromOffset(106, if gifted then 4 else 0),
		Size = UDim2.new(1, -290, 0, if gifted then 28 else 52),
		Text = tostring(entry.Name or ""),
		Face = "BodyBold",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Text,
		MaxText = 17,
		Parent = card,
	})
	if gifted then
		-- Admin-Geschenk im Vermögen (Wunsch 18: darf zählen, wird aber markiert)
		UI.Label({
			Position = UDim2.fromOffset(106, 32),
			Size = UDim2.new(1, -290, 0, 16),
			Text = T("soc.board.adminGift"),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.Muted,
			MaxText = 12,
			Parent = card,
		})
	end
	UI.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 0),
		Size = UDim2.fromOffset(170, 52),
		Text = tostring(entry.Text or ""),
		Face = "Mono",
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = if mine then Theme.Text else Theme.Gold,
		MaxText = 16,
		Parent = card,
	})
	-- sanftes, gestaffeltes Einblenden (Feder-Gefühl wie in den anderen Fenstern)
	local scale = UI.Create("UIScale", { Scale = 0.94, Parent = card })
	task.delay(math.min(order, 10) * 0.025, function()
		if scale.Parent then
			TweenService:Create(scale, ROW_IN, { Scale = 1 }):Play()
		end
	end)
end

local function renderReply(reply: any)
	if not window then
		return
	end
	clear(ui.List)
	local rows = type(reply) == "table" and type(reply.Rows) == "table" and reply.Rows or {}
	local myId = ctx.Player.UserId
	if #rows == 0 then
		text(ui.List, {
			Size = UDim2.new(1, 0, 0, 40),
			LayoutOrder = 1,
			Text = T("soc.board.empty"),
			MaxText = 16,
			TextColor3 = Theme.Muted,
		})
	end
	for i, entry in ipairs(rows) do
		if type(entry) == "table" then
			row(ui.List, i, entry, entry.UserId == myId)
		end
	end
	local me = type(reply) == "table" and type(reply.Me) == "table" and reply.Me or {}
	local rankText = if type(me.Rank) == "number" then T("soc.board.rank", me.Rank) else T("soc.board.noRank")
	ui.Me.Text = T("soc.board.you", tostring(me.Text or "—")) .. "  ·  " .. rankText
end

local function renderStatic()
	ui.Info.Text = T("soc.board.info." .. board)
	local league = ctx.State.League
	league = if type(league) == "table" then league else {}
	local isLeague = board == "League" or board == "Return"
	ui.Tiers.Visible = isLeague
	ui.Tier.Visible = isLeague
	ui.Admin.Visible = isLeague
	if isLeague then
		ui.Tiers.Text = T("soc.board.tiers")
		ui.Tier.Text = T("soc.board.tier", tierName(league.Tier), math.floor(num(league.SkillScore, 0)))
		ui.Admin.Text = T("soc.board.adminWindow")
	end
end

local function load(force: boolean?)
	if not window then
		return
	end
	renderStatic()
	local key = board .. "|" .. scope
	local hit = cache[key]
	if hit and not force and os.clock() - hit.At < CACHE_SECONDS then
		renderReply(hit.Reply)
		return
	end
	if loadingKey == key then
		return
	end
	loadingKey = key
	token += 1
	local mine = token
	ui.Me.Text = T("soc.board.loading")
	task.spawn(function()
		local wait = REQUEST_GAP - (os.clock() - lastRequestAt)
		if wait > 0 then
			task.wait(wait)
		end
		lastRequestAt = os.clock()
		local reply = ctx.RequestFull("BoardsGet", { Board = board, Scope = scope }, true)
		if loadingKey == key then
			loadingKey = nil
		end
		if reply.Ok then
			cache[key] = { At = os.clock(), Reply = reply }
		end
		if mine == token and board .. "|" .. scope == key then
			renderReply(if reply.Ok then reply else hit and hit.Reply or {})
			if not reply.Ok and not hit then
				ui.Me.Text = T("soc.board.error") -- Fehlerzustand statt stiller Leere
			end
		end
	end)
end

-- ---------------------------------------------------------------------
-- 3) FENSTER
-- ---------------------------------------------------------------------
local function buildWindow()
	window = UI.Window(T("soc.win.boards"), WINDOW_W, WINDOW_H, Theme.Gold)
	local content = window.Content
	local options = {}
	for _, def in ipairs(boardList()) do
		table.insert(options, { Key = def.Key, Text = T("soc.board." .. def.Key) })
	end
	boardSeg = UI.Segmented(content, options, function(key: string)
		board = key
		load(false)
	end)
	boardSeg.Frame.LayoutOrder = 1
	local scopeOptions = {}
	for _, key in ipairs(SCOPES) do
		table.insert(scopeOptions, { Key = key, Text = T("soc.scope." .. key) })
	end
	scopeSeg = UI.Segmented(content, scopeOptions, function(key: string)
		scope = key
		load(false)
	end)
	scopeSeg.Frame.LayoutOrder = 2
	ui.Info = text(content, {
		Size = UDim2.new(1, 0, 0, 36),
		LayoutOrder = 3,
		Face = "Body",
		TextWrapped = true,
		MaxText = 13,
		TextColor3 = Theme.Text2,
	})
	ui.Tiers = text(content, { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 4, Face = "Mono", MaxText = 13 })
	ui.Tier = text(content, {
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = 5,
		Face = "BodyBold",
		MaxText = 15,
		TextColor3 = Theme.Gold,
	})
	ui.Admin = text(content, { Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 6, MaxText = 12, TextColor3 = Theme.Muted })
	local meRow = UI.Row(content, 7, 40)
	ui.Me = text(meRow, { Size = UDim2.new(1, -60, 1, 0), Face = "BodyBold", MaxText = 15, LayoutOrder = 1 })
	UI.Button(
		{ Size = UDim2.fromOffset(44, 38), Text = "↻", Variant = "Ghost", LayoutOrder = 2, Parent = meRow },
		function()
			load(true)
		end
	)
	ui.List = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 8,
		Parent = content,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }) })
end

local function openWindow()
	if not window then
		buildWindow()
	end
	boardSeg.Set(board, true)
	scopeSeg.Set(scope, true)
	UI.OpenWindow(window)
	load(false)
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
end

function Boards.Open(which: string?)
	if which ~= nil and isBoard(which) then
		board = which :: string
	end
	ctx.Windows.Open("Boards")
end

function Boards.Init(context: any)
	ctx = context
	ctx.Windows.Register("Boards", openWindow, closeWindow)
end

function Boards.Start()
	ctx.Hooks.On("State", function(_state: any, changed: any)
		if type(changed) == "table" and changed.League and window and window.IsOpen then
			renderStatic()
		end
	end)
	ctx.Hooks.On("Settings", function()
		table.clear(cache) -- Werte-Texte sind serverseitig lokalisiert
	end)
end

return Boards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="127">
            <Properties>
              <string name="Name">Boutique</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Chronohaus-Boutique + Uhrzeiger am Handgelenk (Client/Modules/Boutique)
--  Besitzer: WP8 (Turm-Optik, Interiors, Lifestyle). Vertrag: DESIGN.md §D WP8 (Boutique: Uhren, Accessoires, Deko,
--  4-h-Rotation aus ShopService.Rotation), §B12.2 (Uhren am Handgelenk für alle sichtbar, Zeiger drehen im PreRender-
--  Loop, nur ≤ 60 Studs), §B12.3 (Accessoires, max. 3 gleichzeitig), §B4.8 (Deko: Kauf ins Lager, Platzieren gratis
--  über das Tower-Menü), §B9.6 (Vorstand „Lifestyle“: −5 % je Stufe auf Uhren/Deko), §C7.3 (Fenster "Boutique"),
--  §C9 (Requests LifeBuy {Key}, LifeEquip {Slot, Key?}).
--
--  Der Server entscheidet alles (Preis, Rabatt, Besitz, Lager); dieses Fenster zeigt nur den State
--  (State.Life, State.Storage, State.Credits) und schickt Absichten. Robux kaufen hier nichts – Pass-Teile führen
--  nur in den Shop (Shop.Open), CR kommen nie aus AKY.
--
--  Aufbau: Tabs Auslage (Rotation + Countdown) · Uhren · Accessoires · Deko (Set-Filter) · Lager;
--  oben eine große, langsam drehende Vorschau (ViewportFrame, gleiche PartSpec-Rezepte wie am Körper/im Tower)
--  mit Detail-Karte (Preis, Quelle, Besitz, Knopf Kaufen/Tragen/Ablegen/Platzieren).
--
--  Öffentliche API:
--    Boutique.Open(tabOrKey?)   tab ∈ "Showcase" | "Watches" | "Accessories" | "Decor" | "Storage" oder ein Teil-Schlüssel
--    Boutique.Step(dt)          von TowerView.Frame (EIN PreRender-Loop): Vorschau drehen + Uhrzeiger aller Spieler
--                               + Neon-Jetpack (Pass, §B12.4): in der Luft nochmal springen = zünden, Sprung halten =
--                               steigen, loslassen = gleiten; Tank 8 s / 12 s Nachladen (Server prüft, LifeEquip "Jetpack")
--    Boutique.Init(ctx) · Boutique.Start()
-- =====================================================================

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local DecorModels = require(Shared:WaitForChild("DecorModels"))
local LifestyleModels = require(Shared:WaitForChild("LifestyleModels"))

local Boutique = {}

local Theme = UI.Theme

local WINDOW_W, WINDOW_H = 820, 640
local TABS = { "Showcase", "Watches", "Accessories", "Decor", "Storage" }
local CARD_W, CARD_H = 176, 132
local PREVIEW_W, PREVIEW_H = 300, 250
local REFRESH_GAP = 0.25
local CONFIRM_SECONDS = 3
local CONFIRM_SHARE = 0.25 -- Käufe über 25 % des Guthabens brauchen einen zweiten Tipp
local SPIN_SPEED = 0.5 -- rad/s: Deko dreht sich ganz
local SWING = 0.9 -- rad: Uhren/Accessoires pendeln (Zifferblatt bleibt sichtbar)
local SWING_SPEED = 0.7
local SCAN_GAP = 0.5 -- s: Charaktere nach Uhren absuchen
local HAND_GAP = 1 / 20 -- s: Zeiger-Takt (Minutenzeiger läuft in Weltzeit)
local MAX_WATCHES = 48
local MAX_PREVIEW_PARTS = 400
local TWO_PI = math.pi * 2
local DEFAULT_RANGE = 60
local SOURCES_WITH_PAGE: { [string]: boolean } = { Pass = true, Starter = true, Season = true, Login = true }

local ctx: any = nil
local window: any = nil
local tabs: any = nil
local top: Frame? = nil
local detail: Frame? = nil
local body: Frame? = nil
local tab = "Showcase"
local pendingTab: string? = nil
local decorSet = ""
local selected: string? = nil
local busy = false
local confirm: { Key: string, Until: number }? = nil
local builtLang = ""
local lastSig = ""
local refreshQueued = false
local lastRefresh = 0
local countdownLabel: TextLabel? = nil
local countdownSecond = -1

-- Großvorschau (ein ViewportFrame, Modell wird nur beim Auswählen getauscht)
type Hand = { Part: BasePart, Z: number, Len: number, Minute: boolean }
local viewport: ViewportFrame? = nil
local previewCamera: Camera? = nil
local previewModel: Model? = nil
local previewKey = ""
local previewKind = ""
local previewCenter = Vector3.zero
local previewDistance = 4
local previewHeight = 1
local previewTime = 0
local previewHands: { Hand } = {}
local previewEmpty: TextLabel? = nil

-- Uhrzeiger am Handgelenk (alle Spieler, nur ≤ WatchRange zur Kamera)
type WristWatch = { Root: BasePart, Hour: Weld, Minute: Weld, HZ: number, HL: number, MZ: number, ML: number }
local wrist: { WristWatch } = {}
local scanIn = 0
local handIn = 0

-- Neon-Jetpack (nur die eigene Figur; Effekt-Teile baut der Server -> alle sehen den Flug)
local player = Players.LocalPlayer
local JET_REQUEST_GAP = 0.4
local JET_MIN_AIR = 0.2 -- s in der Luft, bevor ein Sprung zündet (der Boden-Sprung selbst zählt nicht)
local JET_HEIGHT_MARGIN = 6 -- Studs unter der Anti-Cheat-Höhe bleiben
local jet = {
	Active = false,
	Pending = false,
	Fuel = 8,
	Flight = 0,
	GroundFor = 0,
	AirFor = 0,
	GroundRootY = 0,
	LastRequest = -math.huge,
	PrevRequest = -math.huge, -- vorletzte Anfrage: LifeEquip erlaubt 2/s (Zünden + Landen + neu Zünden)
	HintShown = false,
	CheckIn = 0,
	UiIn = 0,
}
local jetBar: Frame? = nil
local jetFill: Frame? = nil
local jetRay = RaycastParams.new()
jetRay.FilterType = Enum.RaycastFilterType.Exclude
jetRay.IgnoreWater = false

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

local function credits(n: number): string
	local ok, text = pcall(ctx.Format.Credits, n, lang())
	return if ok then text else tostring(math.floor(n))
end

local function duration(seconds: number): string
	local ok, text = pcall(ctx.Format.Duration, math.max(0, seconds), lang())
	return if ok then text else tostring(math.floor(seconds))
end

local function pick(pair: any): string
	if type(pair) ~= "table" then
		return "?"
	end
	local ok, text = pcall(ctx.Lang.Pick, lang(), pair)
	return if ok and type(text) == "string" then text else tostring(pair.en or pair.de or "?")
end

local function hex(value: any, fallback: Color3): Color3
	if type(value) ~= "string" then
		return fallback
	end
	local ok, color = pcall(Color3.fromHex, value)
	return if ok then color else fallback
end

local function lifeCfg(): { [string]: any }
	local cfg = ctx.Config.Lifestyle
	return if type(cfg) == "table" then cfg else {}
end

local function decorCfg(): { [string]: any }
	local cfg = ctx.Config.Decor
	return if type(cfg) == "table" then cfg else {}
end

local function life(): { [string]: any }
	local l = ctx.State.Life
	return if type(l) == "table" then l else {}
end

local function storage(): { [string]: any }
	local s = ctx.State.Storage
	return if type(s) == "table" then s else {}
end

local function balance(): number
	return math.max(0, num(ctx.State.Credits, 0))
end

local function inList(list: any, key: string): boolean
	return type(list) == "table" and table.find(list, key) ~= nil
end

-- Eintrag + Art eines Schlüssels: "Watch" | "Accessory" | "Decor"
local function entryOf(key: string): (any, string?)
	local lc = lifeCfg()
	local kind = if type(lc.KindOf) == "table" then lc.KindOf[key] else nil
	if kind and type(lc.ByKey) == "table" and lc.ByKey[key] then
		return lc.ByKey[key], kind
	end
	local dc = decorCfg()
	local entry = if type(dc.ByKey) == "table" then dc.ByKey[key] else nil
	if type(entry) == "table" then
		return entry, "Decor"
	end
	return nil, nil
end

local function storedCount(key: string): number
	local decor = storage().Decor
	return if type(decor) == "table" then math.max(0, math.floor(num(decor[key], 0))) else 0
end

local function placedCount(key: string): number
	local placed = storage().Placed
	return if type(placed) == "table" then math.max(0, math.floor(num(placed[key], 0))) else 0
end

local function owns(key: string, kind: string?): boolean
	local l = life()
	if kind == "Watch" then
		return inList(l.Watches, key) or inList(l.Unlocked, key)
	elseif kind == "Accessory" then
		return inList(l.Accessories, key) or inList(l.Unlocked, key)
	elseif kind == "Decor" then
		return storedCount(key) > 0 or placedCount(key) > 0
	end
	return false
end

local function worn(key: string, kind: string?): boolean
	local eq = life().Equipped
	if type(eq) ~= "table" then
		return false
	end
	if kind == "Watch" then
		return eq.Watch == key
	elseif kind == "Accessory" then
		return inList(eq.Acc, key)
	end
	return false
end

local function wornAccCount(): number
	local eq = life().Equipped
	return if type(eq) == "table" and type(eq.Acc) == "table" then #eq.Acc else 0
end

local function maxAcc(): number
	return math.clamp(math.floor(num(lifeCfg().MaxAccessories, 3)), 1, 6)
end

-- gleicher Preis wie der Server (LifestyleService Core.Price): Rabatt nur auf Uhren und Deko
local function priceOf(entry: any, kind: string?): number
	local base = num(entry and entry.Price, 0)
	if base <= 0 then
		return 0
	end
	local discount = if kind == "Accessory" then 0 else math.clamp(num(life().Discount, 0), 0, 0.9)
	return math.max(1, math.min(9e15, math.floor(base * (1 - discount) + 0.5)))
end

local function forSale(entry: any): boolean
	return type(entry) == "table" and entry.Source == "Shop" and num(entry.Price, 0) > 0
end

local function licenceName(index: number): string
	local prog = ctx.Config.Progression
	local list = if type(prog) == "table" then prog.Licences else nil
	local entry = if type(list) == "table" then list[index] else nil
	if type(entry) == "table" and type(entry.Name) == "table" then
		return pick(entry.Name)
	end
	return T("life.licenceN", index)
end

-- Woher kommt ein nicht kaufbares Teil? (kurzer, ehrlicher Hinweis)
local function sourceHint(entry: any): string
	local source = tostring(entry.Source or "")
	if source == "Licence" then
		return T("life.src.Licence", licenceName(math.floor(num(entry.Licence, 1))))
	elseif source == "Perk" then
		local perk = if type(entry.Perk) == "table" then entry.Perk else {}
		return T("life.src.Perk", tostring(perk.Branch or "Lifestyle"), math.floor(num(perk.Level, 5)))
	elseif source == "Pass" or source == "Starter" or source == "Season" or source == "Login" then
		return T("life.src." .. source)
	elseif source == "League" or source == "Group" then
		return T("life.src." .. source)
	end
	return T("life.src.Other")
end

-- Sammlungswert (gleiche Formel wie LifestyleService.CollectionValue)
local function collectionValue(): number
	local total = 0
	local lc = lifeCfg()
	if type(lc.ByKey) == "table" and type(lc.KindOf) == "table" then
		for key, entry in pairs(lc.ByKey) do
			if owns(key, lc.KindOf[key]) then
				total += math.max(0, num(entry.Value, num(entry.Price, 0)))
			end
		end
	end
	local items = decorCfg().Items
	if type(items) == "table" then
		for _, entry in ipairs(items) do
			local count = storedCount(entry.Key) + placedCount(entry.Key)
			if count > 0 then
				local value = num(entry.Price, 0)
				if value <= 0 then
					value = num(entry.Comfort, 1) * 50000
				end
				total += value * count
			end
		end
	end
	return math.clamp(math.floor(total), 0, 9e15)
end

-- Farben eines Rezepts für die Karten-Grafik (3 Punkte)
local function swatchColors(entry: any, kind: string?): { Color3 }
	local r = if type(entry) == "table" and type(entry.Recipe) == "table" then entry.Recipe else {}
	if kind == "Watch" then
		return { hex(r.Case, Theme.Muted), hex(r.Dial, Theme.Bg), hex(r.Glow, Theme.Accent) }
	end
	return { hex(r.A, Theme.Muted), hex(r.B, Theme.Surface2), hex(r.C, Theme.Accent) }
end

-- ---------------------------------------------------------------------
-- 2) ANFRAGEN (Busy-Flag nur UX – der Server dedupliziert und prüft alles)
-- ---------------------------------------------------------------------
local refresh: () -> ()

local function Request(action: string, arg: any, onOk: ((reply: any) -> ())?)
	if busy then
		return
	end
	busy = true
	lastSig = ""
	refresh()
	task.spawn(function()
		local ok, reply = pcall(ctx.RequestFull, action, arg)
		busy = false
		if ok and type(reply) == "table" and reply.Ok then
			if onOk then
				onOk(reply)
			end
		else
			call("Sfx", "Play", "UIError")
		end
		lastSig = ""
		refresh()
	end)
end

local function buy(key: string)
	local entry, kind = entryOf(key)
	if not entry or not forSale(entry) then
		return
	end
	local price = priceOf(entry, kind)
	local have = balance()
	if price > have then
		ctx.Toast(T("life.missing", credits(price - have)), "Error")
		call("Sfx", "Play", "UIError")
		return
	end
	-- teure Käufe: zweiter Tipp innerhalb von 3 s
	local now = os.clock()
	if price > have * CONFIRM_SHARE then
		local c = confirm
		if not c or c.Key ~= key or now > c.Until then
			confirm = { Key = key, Until = now + CONFIRM_SECONDS }
			lastSig = ""
			refresh()
			task.delay(CONFIRM_SECONDS + 0.05, function()
				local current = confirm
				if current and current.Key == key and os.clock() >= current.Until then
					confirm = nil
					lastSig = ""
					refresh()
				end
			end)
			return
		end
	end
	confirm = nil
	Request("LifeBuy", { Key = key }, function()
		call("Sfx", "Play", "CashRegister")
	end)
end

local function equip(slot: string, key: string?)
	local arg: { [string]: any } = { Slot = slot }
	if key then
		arg.Key = key
	end
	Request("LifeEquip", arg, function()
		call("Sfx", "Play", "UIClick")
	end)
end

local function openSourcePage(entry: any)
	local source = tostring(entry.Source or "")
	if source == "Pass" then
		call("Shop", "Open", if type(entry.Pass) == "string" then entry.Pass else "Passes") -- direkt die Pass-Details
	elseif source == "Starter" then
		call("Shop", "Open", "Starter")
	elseif source == "Season" then
		ctx.Windows.Open("Season")
	elseif source == "Login" then
		ctx.Windows.Open("Calendar")
	end
end

-- ---------------------------------------------------------------------
-- 3) GROSSVORSCHAU (ViewportFrame)
-- ---------------------------------------------------------------------
local function clearPreview()
	local model = previewModel
	previewModel = nil
	if model then
		model:Destroy()
	end
	table.clear(previewHands)
	previewKey = ""
	previewKind = ""
end

local function buildModel(key: string, kind: string): Model?
	local ok, model = pcall(function(): any
		if kind == "Watch" then
			return LifestyleModels.Watch(key)
		elseif kind == "Accessory" then
			return LifestyleModels.Accessory(key)
		end
		return DecorModels.Build(key)
	end)
	if not ok or typeof(model) ~= "Instance" or not model:IsA("Model") then
		if not ok then
			warn("[Boutique] Vorschau " .. key .. ": " .. tostring(model))
		end
		return nil
	end
	return model
end

local function placeCamera()
	local camera = previewCamera
	if not camera then
		return
	end
	local d = previewDistance
	local angle: number
	if previewKind == "Decor" then
		angle = previewTime * SPIN_SPEED + 0.6
	else
		angle = math.sin(previewTime * SWING_SPEED) * SWING
	end
	-- Vorderseite der Rezepte = −Z -> Kamera startet auf der −Z-Seite
	local eye = previewCenter + Vector3.new(math.sin(angle) * d, d * previewHeight, -math.cos(angle) * d)
	camera.CFrame = CFrame.lookAt(eye, previewCenter)
end

local function setPreview(key: string?)
	local vp = viewport
	if not vp then
		return
	end
	if key == previewKey and previewModel then
		return
	end
	clearPreview()
	local empty = previewEmpty
	if not key then
		if empty then
			empty.Visible = true
		end
		return
	end
	local entry, kind = entryOf(key)
	if not entry or not kind then
		if empty then
			empty.Visible = true
		end
		return
	end
	local model = buildModel(key, kind)
	if not model then
		if empty then
			empty.Visible = true
		end
		return
	end
	if empty then
		empty.Visible = false
	end
	-- alles verankern (keine Physik im Viewport), Zeiger merken; Teilezahl begrenzt
	local count = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			count += 1
			if count > MAX_PREVIEW_PARTS then
				d:Destroy()
			else
				d.Anchored = true
				local tag = d:GetAttribute("Tag")
				if tag == "HourHand" or tag == "MinuteHand" then
					table.insert(previewHands, {
						Part = d,
						Z = num(d:GetAttribute("HandZ"), -0.135),
						Len = num(d:GetAttribute("HandLen"), 0.2),
						Minute = tag == "MinuteHand",
					})
				end
			end
		elseif d:IsA("Light") then
			d.Enabled = false
		elseif d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			d:Destroy() -- nur Optik: Zeiger werden direkt gestellt, keine Gelenke nötig
		end
	end
	model:PivotTo(CFrame.identity)
	model.Parent = vp
	local cf, size = model:GetBoundingBox()
	previewCenter = cf.Position
	local radius = math.max(size.Magnitude / 2, 0.15)
	local fov = if previewCamera then previewCamera.FieldOfView else 30
	previewDistance = radius / math.tan(math.rad(fov / 2)) * 1.08
	previewHeight = if kind == "Decor" then 0.42 else 0.12
	previewModel = model
	previewKey = key
	previewKind = kind
	previewTime = 0
	placeCamera()
end

-- Weltzeit als Zeigerwinkel (Minuten, Stunden) in Bogenmaß
local function clockAngles(): (number, number)
	local hours: number
	local clock = ctx and ctx.Clock
	local ok, value = false, nil
	if clock and type(clock.Now) == "function" and type(clock.ClockTime) == "function" then
		ok, value = pcall(function(): number
			return clock.ClockTime(clock.Now() - num(clock.EPOCH, 0))
		end)
	end
	hours = if ok and type(value) == "number" and value == value then value else Lighting.ClockTime
	local minute = (hours % 1) * TWO_PI
	local hour = ((hours % 12) / 12) * TWO_PI
	return minute, hour
end

local function stepPreview(dt: number, minute: number?, hour: number?)
	local model = previewModel
	if not model or not window or not window.IsOpen then
		return
	end
	previewTime += dt
	placeCamera()
	if #previewHands > 0 and minute and hour then
		local pivot = model:GetPivot()
		for _, hand in ipairs(previewHands) do
			if hand.Part.Parent then
				local angle = if hand.Minute then minute else hour
				hand.Part.CFrame = pivot * LifestyleModels.HandC0(hand.Z, hand.Len, angle)
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- 4) UHRZEIGER AM HANDGELENK (§B12.2: nur ≤ WatchRange Studs, im einen PreRender-Loop)
-- ---------------------------------------------------------------------
local function attr(inst: Instance, name: string, default: number): number
	return num(inst:GetAttribute(name), default)
end

local function scanWrists()
	table.clear(wrist)
	for _, p in ipairs(Players:GetPlayers()) do
		if #wrist >= MAX_WATCHES then
			break
		end
		local character = p.Character
		local model = character and character:FindFirstChild("AkyWatch")
		if model and model:IsA("Model") then
			local root = model.PrimaryPart or model:FindFirstChild("Root")
			local hourHand = model:FindFirstChild("HourHand")
			local minuteHand = model:FindFirstChild("MinuteHand")
			local hourWeld = hourHand and hourHand:FindFirstChild("HourWeld")
			local minuteWeld = minuteHand and minuteHand:FindFirstChild("MinuteWeld")
			if
				root
				and root:IsA("BasePart")
				and hourHand
				and minuteHand
				and hourWeld
				and hourWeld:IsA("Weld")
				and minuteWeld
				and minuteWeld:IsA("Weld")
			then
				table.insert(wrist, {
					Root = root,
					Hour = hourWeld,
					Minute = minuteWeld,
					HZ = attr(hourHand, "HandZ", -0.135),
					HL = attr(hourHand, "HandLen", 0.17),
					MZ = attr(minuteHand, "HandZ", -0.15),
					ML = attr(minuteHand, "HandLen", 0.24),
				})
			end
		end
	end
end

local function stepWrists(minute: number, hour: number)
	local camera = workspace.CurrentCamera
	if not camera or #wrist == 0 then
		return
	end
	local eye = camera.CFrame.Position
	local range = math.max(1, num(lifeCfg().WatchRange, DEFAULT_RANGE))
	for _, w in ipairs(wrist) do
		if w.Root.Parent and w.Hour.Parent and w.Minute.Parent then
			if (w.Root.Position - eye).Magnitude <= range then
				w.Hour.C0 = LifestyleModels.HandC0(w.HZ, w.HL, hour)
				w.Minute.C0 = LifestyleModels.HandC0(w.MZ, w.ML, minute)
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- 4b) NEON-JETPACK (Pass): zünden per Doppelsprung, Steigen/Gleiten, Tank-Anzeige
-- ---------------------------------------------------------------------
local function jetCfg(): { [string]: any }
	local cfg = lifeCfg().Jetpack
	return if type(cfg) == "table" then cfg else {}
end

local function jetMaxFuel(): number
	return math.clamp(num(jetCfg().Fuel, 8), 1, 60)
end

local function ownsJetpack(): boolean
	local passes = ctx and ctx.State and ctx.State.Passes
	local key = jetCfg().Pass or "Jetpack"
	return type(passes) == "table" and passes[key] == true
end

local function myRig(): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

local function inForeignTower(): boolean
	local okPlot, plot = call("TowerView", "InsideTower")
	if not okPlot or type(plot) ~= "number" then
		return false
	end
	local okInfo, info = call("TowerView", "PlotInfo", plot)
	local owner = if okInfo and type(info) == "table" then num(info.Owner, 0) else 0
	return owner > 0 and owner ~= player.UserId
end

local function jetSend(on: boolean)
	local arg: { [string]: any } = { Slot = "Jetpack" }
	if on then
		arg.Key = "On"
	end
	jet.PrevRequest = jet.LastRequest
	jet.LastRequest = os.clock()
	task.spawn(function()
		local okReply, reply = pcall(ctx.RequestFull, "LifeEquip", arg, true)
		if not on then
			return
		end
		jet.Pending = false
		local character, humanoid = myRig()
		if not okReply or type(reply) ~= "table" or not reply.Ok then
			local message = if okReply and type(reply) == "table" then reply.Message else nil
			if type(message) == "string" and message ~= "" then
				ctx.Toast(message, "Error")
			end
			return
		end
		if not character or not humanoid or humanoid.Health <= 0 or humanoid.SeatPart ~= nil then
			jetSend(false)
			return
		end
		jet.Active = true
		jet.Flight = 0
		jet.GroundFor = 0
		if type(reply.Fuel) == "number" then
			jet.Fuel = math.clamp(reply.Fuel, 0, jetMaxFuel())
		end
		call("Sfx", "Play", "Whoosh")
	end)
end

local function jetStop()
	if jet.Active then
		jet.Active = false
		jetSend(false)
	end
	jet.Pending = false
end

local function onJumpRequest()
	if jet.Active or jet.Pending or not ctx or not ownsJetpack() then
		return
	end
	local _, humanoid = myRig()
	if not humanoid or humanoid.Health <= 0 or humanoid.SeatPart ~= nil then
		return
	end
	if humanoid.FloorMaterial ~= Enum.Material.Air or jet.AirFor < JET_MIN_AIR then
		return -- der Sprung vom Boden ist ein normaler Sprung
	end
	local okRide, riding = call("Elevator", "IsRiding")
	if okRide and riding == true then
		return
	end
	local now = os.clock()
	if now - jet.LastRequest < JET_REQUEST_GAP or now - jet.PrevRequest < 1.05 then
		return -- sonst greift die Anfrage-Bremse des Servers (2/s)
	end
	if jet.Fuel < 1 then
		ctx.Toast(T("life.jet.recharge", math.ceil((1 - jet.Fuel) * num(jetCfg().Recharge, 12) / jetMaxFuel())), "Info")
		return
	end
	if inForeignTower() then
		ctx.Toast(T("life.jet.foreign"), "Info")
		return
	end
	jet.Pending = true
	jetSend(true)
end

local function buildJetBar()
	local frame: Frame = UI.Create("Frame", {
		Name = "JetpackFuel",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -150),
		Size = UDim2.fromOffset(220, 40),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
		Visible = false,
		Parent = ctx.Gui,
	}, { UI.Corner(12), UI.Stroke(Theme.Cosmic2, 1) })
	UI.Label({
		Name = "Caption",
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 0, 14),
		Text = T("life.jet.label"),
		Face = "MonoBold",
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 12,
		Parent = frame,
	})
	local back: Frame = UI.Create("Frame", {
		Name = "Track",
		Position = UDim2.new(0, 12, 1, -14),
		Size = UDim2.new(1, -24, 0, 7),
		BackgroundColor3 = Theme.Bg2,
		BorderSizePixel = 0,
		Parent = frame,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	jetFill = UI.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = back,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.Gradient(Theme.Accent, Theme.Cosmic3, 0),
	})
	jetBar = frame
end

local function updateJetBar()
	local frame = jetBar
	if not frame then
		return
	end
	local okCar, car = call("Vehicles", "Current")
	local maxFuel = jetMaxFuel()
	local show = ownsJetpack() and (jet.Active or jet.Fuel < maxFuel - 0.05) and not (okCar and car ~= nil)
	if frame.Visible ~= show then
		frame.Visible = show
	end
	local fill = jetFill
	if show and fill then
		fill.Size = UDim2.fromScale(math.clamp(jet.Fuel / maxFuel, 0, 1), 1)
		fill.BackgroundTransparency = if jet.Active or jet.Fuel >= 1 then 0 else 0.5
	end
end

local function stepJetpack(dt: number)
	local maxFuel = jetMaxFuel()
	local _, humanoid, root = myRig()
	if humanoid and root then
		local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
		if grounded then
			jet.GroundRootY = root.Position.Y -- gleiche Bezugshöhe wie der Anti-Cheat (letzter Boden)
			jet.AirFor = 0
		else
			jet.AirFor += dt
		end
	end
	if not jet.Active then
		jet.Fuel = math.min(maxFuel, jet.Fuel + dt * maxFuel / math.clamp(num(jetCfg().Recharge, 12), 1, 120))
	else
		local cfg = jetCfg()
		if not humanoid or not root or humanoid.Health <= 0 or humanoid.SeatPart ~= nil then
			jetStop()
		else
			jet.Fuel = math.max(0, jet.Fuel - dt)
			jet.Flight += dt
			local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
			jet.GroundFor = if grounded and jet.Flight > 0.6 then jet.GroundFor + dt else 0
			jet.CheckIn -= dt
			local foreign = false
			if jet.CheckIn <= 0 then
				jet.CheckIn = 0.5
				foreign = inForeignTower()
			end
			if jet.Fuel <= 0.05 or jet.GroundFor > 0.25 or foreign then
				jetStop()
			else
				local maxHeight = math.clamp(num(cfg.MaxHeight, 120), 10, 400) - JET_HEIGHT_MARGIN
				local character = player.Character
				if character then
					jetRay.FilterDescendantsInstances = { character }
				end
				local hit = workspace:Raycast(root.Position, Vector3.new(0, -(maxHeight + 40), 0), jetRay)
				local above = if hit then root.Position.Y - hit.Position.Y else math.huge
				local relative = root.Position.Y - jet.GroundRootY
				local thrust = humanoid.Jump and relative < maxHeight and above < maxHeight
				local vy = if thrust then num(cfg.Thrust, 30) else -num(cfg.Glide, 8)
				local move = humanoid.MoveDirection * num(cfg.AirSpeed, 44)
				root.AssemblyLinearVelocity = Vector3.new(move.X, vy, move.Z)
			end
		end
	end
	jet.UiIn -= dt
	if jet.UiIn <= 0 then
		jet.UiIn = 0.1
		updateJetBar()
		if not jet.HintShown and ownsJetpack() then
			jet.HintShown = true
			ctx.Toast(T("life.jet.hint"), "Info")
		end
	end
end

-- ---------------------------------------------------------------------
-- 5) BAUSTEINE
-- ---------------------------------------------------------------------
local function card(parent: Instance, order: number, color: Color3?): Frame
	local frame = UI.Card({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Parent = parent,
	})
	UI.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 12),
		Parent = frame,
	})
	UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = frame })
	if color then
		UI.Create("Frame", {
			Name = "Accent",
			Position = UDim2.new(0, -14, 0, -10),
			Size = UDim2.new(0, 3, 0, 22),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = frame,
		})
	end
	return frame
end

local function text(parent: Instance, value: string, order: number, opts: { [string]: any }?): TextLabel
	local props: { [string]: any } = {
		Size = UDim2.new(1, 0, 0, 22),
		Text = value,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Text2,
		MaxText = 16,
		LayoutOrder = order,
		Parent = parent,
	}
	if opts then
		for k, v in pairs(opts) do
			props[k] = v
		end
	end
	return UI.Label(props)
end

local function button(
	parent: Instance,
	label: string,
	variant: string,
	order: number,
	onClick: () -> (),
	width: number?
): any
	return UI.Button({
		Size = UDim2.fromOffset(width or 190, 40),
		Text = label,
		Variant = variant,
		MaxText = 16,
		LayoutOrder = order,
		Corner = 10,
		Parent = parent,
	}, onClick)
end

local function row(parent: Instance, order: number, height: number?): Frame
	return UI.Row(parent, order, height or 42)
end

local function swatch(parent: Instance, colors: { Color3 }, position: UDim2)
	for i, color in ipairs(colors) do
		UI.Create("Frame", {
			Name = "Dot" .. i,
			Position = position + UDim2.fromOffset((i - 1) * 16, 0),
			Size = UDim2.fromOffset(18, 18),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = parent,
		}, { UI.Corner(9), UI.Stroke(Theme.Border, 1) })
	end
end

local function statusOf(key: string, entry: any, kind: string?): (string, Color3)
	if worn(key, kind) then
		return T("life.state.worn"), Theme.Up
	end
	if kind == "Decor" then
		local stored = storedCount(key)
		if stored > 0 then
			return T("life.state.stored", stored), Theme.Accent
		end
		if placedCount(key) > 0 then
			return T("life.state.placed", placedCount(key)), Theme.Accent
		end
	elseif owns(key, kind) then
		return T("life.state.owned"), Theme.Accent
	end
	if forSale(entry) then
		local price = priceOf(entry, kind)
		return credits(price), if price <= balance() then Theme.Text else Theme.Muted
	end
	return T("life.state.locked"), Theme.Muted
end

local function choose(key: string)
	selected = key
	confirm = nil
	setPreview(key)
	lastSig = ""
	refresh()
end

-- Kachel eines Teils (Farbpunkte, Name, Preis/Status) – Klick wählt es für die Großansicht
local function itemCard(parent: Instance, key: string, order: number, badge: string?)
	local entry, kind = entryOf(key)
	if not entry then
		return
	end
	local isSelected = selected == key
	local frame = UI.Card({ Size = UDim2.fromOffset(CARD_W, CARD_H), LayoutOrder = order, Parent = parent })
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if stroke and isSelected then
		stroke.Color = Theme.Accent
		stroke.Thickness = 2
		stroke.Transparency = 0
	end
	local imageId = math.floor(num(entry.ImageId, 0))
	if imageId > 0 then
		UI.Create("ImageLabel", {
			Position = UDim2.fromOffset(12, 10),
			Size = UDim2.fromOffset(44, 44),
			BackgroundTransparency = 1,
			Image = "rbxassetid://" .. imageId,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 2,
			Parent = frame,
		})
	else
		swatch(frame, swatchColors(entry, kind), UDim2.fromOffset(12, 12))
	end
	if badge then
		UI.Chip(frame, badge, Theme.Warn, { Position = UDim2.new(1, -10, 0, 10), AnchorPoint = Vector2.new(1, 0) })
	end
	UI.Label({
		Position = UDim2.fromOffset(12, 58),
		Size = UDim2.new(1, -24, 0, 22),
		Text = pick(entry.Name),
		Face = "Display",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 15,
		ZIndex = 2,
		Parent = frame,
	})
	local status, color = statusOf(key, entry, kind)
	UI.Label({
		Position = UDim2.fromOffset(12, 84),
		Size = UDim2.new(1, -24, 0, 18),
		Text = status,
		Face = if forSale(entry) and not owns(key, kind) then "Mono" else nil,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 14,
		ZIndex = 2,
		Parent = frame,
	})
	local sub = if kind == "Decor"
		then T("life.comfort", math.floor(num(entry.Comfort, 0)))
		else T("life.kind." .. kind)
	UI.Label({
		Position = UDim2.fromOffset(12, 104),
		Size = UDim2.new(1, -24, 0, 16),
		Text = sub,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 12,
		ZIndex = 2,
		Parent = frame,
	})
	local hit: TextButton = UI.Create("TextButton", {
		Name = "Hit",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 3,
		Parent = frame,
	})
	hit.Activated:Connect(function()
		call("Sfx", "Play", "UIClick")
		choose(key)
	end)
end

local function grid(parent: Instance, order: number): Frame
	return UI.Grid(parent, order, CARD_W, CARD_H)
end

-- ---------------------------------------------------------------------
-- 6) DETAIL-KARTE (rechts neben der Vorschau)
-- ---------------------------------------------------------------------
local function buildDetail(parent: Frame)
	local key = selected
	local entry: any, kind: string? = nil, nil
	if key then
		entry, kind = entryOf(key)
	end
	if not key or not entry or not kind then
		text(parent, T("life.pickHint"), 1, { TextWrapped = true, Size = UDim2.new(1, 0, 0, 44) })
		text(parent, T("life.balance", credits(balance())), 2, { Face = "Mono", TextColor3 = Theme.Text })
		local discount = num(life().Discount, 0)
		if discount > 0 then
			text(parent, T("life.discount", math.floor(discount * 100 + 0.5)), 3, { TextColor3 = Theme.Up })
		end
		return
	end
	text(parent, pick(entry.Name), 1, {
		Face = "Display",
		TextColor3 = Theme.Text,
		MaxText = 22,
		Size = UDim2.new(1, 0, 0, 30),
	})
	-- Art / Set / Platz
	local chips = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = parent,
	}, {
		UI.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	UI.Chip(chips, T("life.kind." .. kind), Theme.Accent, { LayoutOrder = 1 })
	if kind == "Decor" then
		local sets = decorCfg().Sets
		if type(sets) == "table" then
			for _, set in ipairs(sets) do
				if set.Key == entry.Set then
					UI.Chip(chips, pick(set.Name), Theme.Cosmic2, { LayoutOrder = 2 })
					break
				end
			end
		end
		UI.Chip(chips, T("life.comfort", math.floor(num(entry.Comfort, 0))), Theme.Up, { LayoutOrder = 3 })
	elseif kind == "Accessory" then
		UI.Chip(chips, T("life.attach." .. tostring(entry.Attach or "Torso")), Theme.Cyan, { LayoutOrder = 2 })
	else
		UI.Chip(chips, T("life.wrist"), Theme.Cyan, { LayoutOrder = 2 })
	end
	if inList(life().Rotation, key) then
		UI.Chip(chips, T("life.inShowcase"), Theme.Warn, { LayoutOrder = 4 })
	end

	local isOwned = owns(key, kind)
	local isWorn = worn(key, kind)
	-- Preis bzw. Quelle
	if forSale(entry) then
		local price = priceOf(entry, kind)
		local base = math.floor(num(entry.Price, 0))
		local line = if price < base
			then T("life.priceDiscount", credits(price), credits(base))
			else T("life.price", credits(price))
		text(parent, line, 3, { Face = "Mono", TextColor3 = Theme.Text, MaxText = 17 })
	elseif not isOwned then
		text(
			parent,
			sourceHint(entry),
			3,
			{ TextColor3 = Theme.Warn, TextWrapped = true, Size = UDim2.new(1, 0, 0, 40) }
		)
	end
	if kind == "Decor" then
		text(parent, T("life.inStorage", storedCount(key), placedCount(key)), 4)
	elseif isOwned then
		text(parent, if isWorn then T("life.state.worn") else T("life.state.owned"), 4, { TextColor3 = Theme.Up })
	end
	text(parent, T("life.balance", credits(balance())), 5, { Face = "Mono", TextColor3 = Theme.Muted, MaxText = 14 })

	local actions = row(parent, 6, 42)
	if busy then
		button(actions, T("life.busy"), "Muted", 1, function() end)
		return
	end
	if kind == "Watch" then
		if isWorn then
			button(actions, T("life.takeOff"), "Secondary", 1, function()
				equip("Watch", nil)
			end)
		elseif isOwned then
			button(actions, T("life.wear"), "Primary", 1, function()
				equip("Watch", key)
			end)
		end
	elseif kind == "Accessory" then
		if isWorn then
			button(actions, T("life.takeOff"), "Secondary", 1, function()
				equip("Acc", key)
			end)
		elseif isOwned then
			if wornAccCount() >= maxAcc() then
				button(actions, T("life.accFullShort", maxAcc()), "Muted", 1, function()
					ctx.Toast(T("life.accFull", maxAcc()), "Info")
				end)
			else
				button(actions, T("life.wear"), "Primary", 1, function()
					equip("Acc", key)
				end)
			end
		end
	else
		if storedCount(key) > 0 then
			button(actions, T("life.place"), "Secondary", 2, function()
				call("TowerUI", "Open", "Floors")
			end)
		end
	end
	local buyable = forSale(entry) and (kind == "Decor" or not isOwned)
	if buyable then
		local price = priceOf(entry, kind)
		local c = confirm
		local confirming = c ~= nil and c.Key == key and os.clock() <= c.Until
		local label = if confirming
			then T("life.buyConfirm", credits(price))
			elseif kind == "Decor" and storedCount(key) + placedCount(key) > 0 then T(
				"life.buyMore",
				credits(price)
			)
			else T("life.buy", credits(price))
		local variant = if price > balance() then "Muted" elseif confirming then "Premium" else "Success"
		button(actions, label, variant, 1, function()
			buy(key)
		end, 240)
	elseif not isOwned and SOURCES_WITH_PAGE[tostring(entry.Source)] then
		button(actions, T("life.sourceOpen." .. tostring(entry.Source)), "Secondary", 1, function()
			openSourcePage(entry)
		end, 220)
	end
end

-- ---------------------------------------------------------------------
-- 7) TABS
-- ---------------------------------------------------------------------
local function updateCountdown()
	local label = countdownLabel
	if not label or not label.Parent then
		return
	end
	local ends = num(life().RotationEnds, 0)
	local left = math.max(0, ends - workspace:GetServerTimeNow())
	local second = math.floor(left)
	if second ~= countdownSecond then
		countdownSecond = second
		label.Text = if ends > 0 then T("life.rotationEnds", duration(left)) else T("life.rotationSoon")
	end
end

local function buildShowcase(parent: Frame)
	local head = card(parent, 1, Theme.Warn)
	text(head, UI.Upper(T("life.showcase.title")), 1, { Face = "Display", TextColor3 = Theme.Text, MaxText = 18 })
	countdownLabel = text(head, "", 2, { Face = "Mono" })
	countdownSecond = -1
	updateCountdown()
	local discount = num(life().Discount, 0)
	if discount > 0 then
		text(head, T("life.discount", math.floor(discount * 100 + 0.5)), 3, { TextColor3 = Theme.Up })
	end
	local rotation = life().Rotation
	local g = grid(parent, 2)
	local shown = 0
	if type(rotation) == "table" then
		for i, key in ipairs(rotation) do
			if i > 24 then
				break
			end
			if entryOf(key) then
				shown += 1
				itemCard(g, key, i, T("life.new"))
			end
		end
	end
	if shown == 0 then
		text(parent, T("life.rotationEmpty"), 3, { TextColor3 = Theme.Muted })
	end
end

local function buildList(parent: Frame, list: any, order: number)
	local g = grid(parent, order)
	if type(list) ~= "table" then
		return
	end
	for i, entry in ipairs(list) do
		if i > 120 then
			break
		end
		if type(entry) == "table" and type(entry.Key) == "string" then
			itemCard(g, entry.Key, i, nil)
		end
	end
end

local function buildWatches(parent: Frame)
	local head = card(parent, 1, Theme.Cyan)
	local eq = life().Equipped
	local current = if type(eq) == "table" then eq.Watch else nil
	local entry = if type(current) == "string" and current ~= "" then entryOf(current) else nil
	text(head, if entry then T("life.onWrist", pick(entry.Name)) else T("life.noWatch"), 1, { TextColor3 = Theme.Text })
	text(head, T("life.watchHint"), 2, { TextColor3 = Theme.Muted, MaxText = 13 })
	buildList(parent, lifeCfg().Watches, 2)
end

local function buildAccessories(parent: Frame)
	local head = card(parent, 1, Theme.Cyan)
	text(head, T("life.accCount", wornAccCount(), maxAcc()), 1, { TextColor3 = Theme.Text })
	if wornAccCount() > 0 and not busy then
		local actions = row(head, 2, 40)
		button(actions, T("life.accClear"), "Ghost", 1, function()
			equip("Acc", nil)
		end)
	end
	buildList(parent, lifeCfg().Accessories, 2)
end

local function buildDecor(parent: Frame)
	local sets = decorCfg().Sets
	local options = {}
	if type(sets) == "table" then
		for _, set in ipairs(sets) do
			table.insert(options, { Key = set.Key, Text = pick(set.Name) })
		end
	end
	if decorSet == "" and options[1] then
		decorSet = options[1].Key
	end
	if #options > 0 then
		local filter = UI.Segmented(parent, options, function(key: string)
			decorSet = key
			lastSig = ""
			refresh()
		end)
		filter.Frame.LayoutOrder = 1
		filter.Set(decorSet, true)
	end
	if type(sets) == "table" then
		for _, set in ipairs(sets) do
			if set.Key == decorSet and type(set.Desc) == "table" then
				text(parent, pick(set.Desc), 2, { TextColor3 = Theme.Muted, MaxText = 14 })
			end
		end
	end
	local items = decorCfg().Items
	local g = grid(parent, 3)
	if type(items) == "table" then
		local n = 0
		for _, entry in ipairs(items) do
			if type(entry) == "table" and entry.Set == decorSet then
				n += 1
				itemCard(g, entry.Key, n, nil)
			end
		end
	end
end

local function buildStorage(parent: Frame)
	local head = card(parent, 1, Theme.Accent)
	local items = decorCfg().Items
	local stored, placed = 0, 0
	local keys: { string } = {}
	if type(items) == "table" then
		for _, entry in ipairs(items) do
			local s = storedCount(entry.Key)
			local p = placedCount(entry.Key)
			stored += s
			placed += p
			if s + p > 0 then
				table.insert(keys, entry.Key)
			end
		end
	end
	text(head, UI.Upper(T("life.storage.title")), 1, { Face = "Display", TextColor3 = Theme.Text, MaxText = 18 })
	text(head, T("life.storage.summary", stored, placed), 2)
	text(head, T("life.collection", credits(collectionValue())), 3, { Face = "Mono", TextColor3 = Theme.Up })
	local actions = row(head, 4, 40)
	if stored > 0 then
		button(actions, T("life.place"), "Primary", 1, function()
			call("TowerUI", "Open", "Floors")
		end)
	end
	-- am Körper
	local body2 = card(parent, 2, Theme.Cyan)
	text(body2, UI.Upper(T("life.worn.title")), 1, { Face = "Display", TextColor3 = Theme.Text, MaxText = 16 })
	local eq = life().Equipped
	local watchKey = if type(eq) == "table" then eq.Watch else nil
	local watchEntry = if type(watchKey) == "string" and watchKey ~= "" then entryOf(watchKey) else nil
	text(body2, if watchEntry then T("life.onWrist", pick(watchEntry.Name)) else T("life.noWatch"), 2)
	local accNames: { string } = {}
	if type(eq) == "table" and type(eq.Acc) == "table" then
		for i, key in ipairs(eq.Acc) do
			if i > 6 then
				break
			end
			local accEntry = entryOf(key)
			if accEntry then
				table.insert(accNames, pick(accEntry.Name))
			end
		end
	end
	text(body2, if #accNames > 0 then table.concat(accNames, " · ") else T("life.noAcc"), 3, { TextWrapped = true })
	if #keys == 0 then
		text(parent, T("life.storage.empty"), 3, { TextColor3 = Theme.Muted, TextWrapped = true })
		return
	end
	local g = grid(parent, 3)
	for i, key in ipairs(keys) do
		itemCard(g, key, i, nil)
	end
end

-- ---------------------------------------------------------------------
-- 8) FENSTER
-- ---------------------------------------------------------------------
local function clearChildren(holder: Instance)
	for _, child in ipairs(holder:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function signature(): string
	local l = life()
	local parts: { string } = { tab, decorSet, selected or "", lang(), tostring(math.floor(balance())) }
	table.insert(parts, if busy then "B" else "-")
	local c = confirm
	table.insert(parts, if c and os.clock() <= c.Until then c.Key else "")
	for _, list in ipairs({ l.Watches, l.Accessories, l.Unlocked, l.Rotation }) do
		table.insert(parts, if type(list) == "table" then table.concat(list, ",") else "")
	end
	local eq = l.Equipped
	if type(eq) == "table" then
		table.insert(parts, tostring(eq.Watch))
		table.insert(parts, if type(eq.Acc) == "table" then table.concat(eq.Acc, ",") else "")
	end
	table.insert(parts, tostring(num(l.Discount, 0)))
	table.insert(parts, tostring(num(l.RotationEnds, 0)))
	local s = storage()
	for _, map in ipairs({ s.Decor, s.Placed }) do
		if type(map) == "table" then
			local keys: { string } = {}
			for key, n in pairs(map) do
				if #keys >= 200 then
					break
				end
				table.insert(keys, tostring(key) .. "=" .. tostring(n))
			end
			table.sort(keys)
			table.insert(parts, table.concat(keys, ","))
		end
	end
	return table.concat(parts, "|")
end

local function rebuild()
	local holder = body
	local side = detail
	if not holder or not side then
		return
	end
	clearChildren(holder)
	clearChildren(side)
	countdownLabel = nil
	local ok, err = pcall(function()
		if tab == "Showcase" then
			buildShowcase(holder)
		elseif tab == "Watches" then
			buildWatches(holder)
		elseif tab == "Accessories" then
			buildAccessories(holder)
		elseif tab == "Decor" then
			buildDecor(holder)
		else
			buildStorage(holder)
		end
		buildDetail(side)
	end)
	if not ok then
		warn("[Boutique] " .. tab .. ": " .. tostring(err))
	end
end

refresh = function()
	if not window or not window.IsOpen then
		return
	end
	local sig = signature()
	if sig ~= lastSig then
		lastSig = sig
		rebuild()
	end
end

local function queueRefresh()
	if refreshQueued then
		return
	end
	refreshQueued = true
	local wait = math.max(0, REFRESH_GAP - (os.clock() - lastRefresh))
	task.delay(wait, function()
		refreshQueued = false
		lastRefresh = os.clock()
		refresh()
	end)
end

local function makeTabs()
	if not window then
		return
	end
	if tabs then
		tabs.Frame:Destroy()
	end
	local options = {}
	for _, key in ipairs(TABS) do
		table.insert(options, { Key = key, Text = T("life.tab." .. string.lower(key)) })
	end
	tabs = UI.Segmented(window.Content, options, function(key: string)
		tab = key
		confirm = nil
		lastSig = ""
		refresh()
	end)
	tabs.Frame.LayoutOrder = 1
	builtLang = lang()
	if previewEmpty then
		previewEmpty.Text = T("life.preview")
	end
end

local function buildWindow()
	if window then
		return
	end
	window = UI.Window(T("life.title"), WINDOW_W, WINDOW_H, Theme.Accent)
	local topFrame: Frame = UI.Create("Frame", {
		Name = "Top",
		Size = UDim2.new(1, 0, 0, PREVIEW_H),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = window.Content,
	})
	top = topFrame
	local holder = UI.Card({ Size = UDim2.fromOffset(PREVIEW_W, PREVIEW_H), Parent = topFrame })
	-- Studio-Verlauf hinter dem Modell (UIGradient wirkt nur auf die Karte, nicht auf das 3D-Bild)
	UI.Gradient(Theme.Surface2, Theme.Bg, 90).Parent = holder
	local vp: ViewportFrame = UI.Create("ViewportFrame", {
		Name = "Preview",
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.new(1, -12, 1, -12),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(150, 160, 185),
		LightColor = Color3.fromRGB(255, 246, 228),
		LightDirection = Vector3.new(-0.4, -1, 0.5),
		Parent = holder,
	}, { UI.Corner(10) })
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = vp
	vp.CurrentCamera = camera
	viewport = vp
	previewCamera = camera
	previewEmpty = UI.Label({
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(1, -40, 0, 24),
		Text = T("life.preview"),
		TextColor3 = Theme.Muted,
		MaxText = 14,
		ZIndex = 2,
		Parent = holder,
	})
	local side: Frame = UI.Create("ScrollingFrame", {
		Name = "Detail",
		Position = UDim2.fromOffset(PREVIEW_W + 12, 0),
		Size = UDim2.new(1, -(PREVIEW_W + 12), 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Border,
		Parent = topFrame,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
		UI.Create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingRight = UDim.new(0, 6) }),
	})
	detail = side
	body = UI.Create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = window.Content,
	}, { UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }) })
	makeTabs()
end

local function openWindow()
	buildWindow()
	if window and builtLang ~= lang() then
		window.TitleLabel.Text = UI.Upper(T("life.title"))
		makeTabs()
	end
	if pendingTab then
		tab = pendingTab
		pendingTab = nil
	end
	if tabs then
		tabs.Set(tab, true)
	end
	-- Handy: schmale Fenster -> Vorschau kleiner, Detail darunter bleibt lesbar
	local topFrame = top
	if topFrame and window then
		local narrow = window.Content.AbsoluteSize.X > 0 and window.Content.AbsoluteSize.X < 560
		topFrame.Size = UDim2.new(1, 0, 0, if narrow then 200 else PREVIEW_H)
	end
	UI.OpenWindow(window)
	if selected then
		setPreview(selected)
	end
	lastSig = ""
	refresh()
end

local function closeWindow()
	if window and window.IsOpen then
		UI.CloseWindow(window)
	end
	confirm = nil
	clearPreview()
	if previewEmpty then
		previewEmpty.Visible = true
	end
end

function Boutique.Open(which: string?)
	if not ctx then
		return
	end
	if type(which) == "string" then
		if table.find(TABS, which) then
			pendingTab = which
		else
			local entry, kind = entryOf(which)
			if entry and kind then
				pendingTab = if kind == "Watch" then "Watches" elseif kind == "Accessory" then "Accessories" else "Decor"
				if kind == "Decor" and type(entry.Set) == "string" then
					decorSet = entry.Set
				end
				selected = which
			end
		end
	end
	if ctx and ctx.Windows then
		ctx.Windows.Open("Boutique")
	end
end

-- jedes Frame von TowerView (kein eigener Loop): Vorschau + Uhrzeiger, Countdown 1×/s
function Boutique.Step(dt: number)
	if not ctx then
		return
	end
	local step = math.clamp(num(dt, 0), 0, 0.25)
	local okJet, errJet = pcall(stepJetpack, step)
	if not okJet then
		warn("[Boutique] Jetpack: " .. tostring(errJet))
		jet.Active = false
	end
	scanIn -= step
	if scanIn <= 0 then
		scanIn = SCAN_GAP
		scanWrists()
	end
	handIn -= step
	local open = window ~= nil and window.IsOpen
	local minute: number?, hour: number? = nil, nil
	if handIn <= 0 and (#wrist > 0 or (open and #previewHands > 0)) then
		handIn = HAND_GAP
		minute, hour = clockAngles()
		stepWrists(minute :: number, hour :: number)
	end
	if open then
		stepPreview(step, minute, hour)
		if countdownLabel then
			updateCountdown()
		end
	end
end

function Boutique.Init(context: any)
	ctx = context
	ctx.Windows.Register("Boutique", openWindow, closeWindow)
	buildJetBar()
	ctx.Hooks.On("State", function(_state: { [string]: any }, changed: { [any]: any })
		if changed.Life or changed.Storage or changed.Credits then
			queueRefresh()
		end
	end)
	ctx.Hooks.On("Settings", function()
		if window and builtLang ~= lang() then
			window.TitleLabel.Text = UI.Upper(T("life.title"))
			makeTabs()
			if tabs then
				tabs.Set(tab, true)
			end
			lastSig = ""
			refresh()
		end
	end)
end

function Boutique.Start()
	-- Spieler weg -> Uhr-Liste beim nächsten Abtasten ohnehin neu; sofort leeren, damit nichts Totes bleibt
	Players.PlayerRemoving:Connect(function()
		scanIn = 0
	end)
	UserInputService.JumpRequest:Connect(function()
		local ok, err = pcall(onJumpRequest)
		if not ok then
			warn("[Boutique] Jetpack: " .. tostring(err))
		end
	end)
	player.CharacterAdded:Connect(function()
		jet.Active = false -- Server beendet den Flug beim Respawn selbst
		jet.Pending = false
	end)
end

return Boutique
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">ChartView</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Kerzen-Chart aus GUI-Frames, 60 FPS (Client/Modules/ChartView)
--  Besitzer: WP5 (Charts, Terminal, Markt-UI). Bibliothek (Main.client ruft nur Init, kein Start/Frame).
--  Vertrag: DESIGN.md §C7.5 (WP5), §B7.5 Renderer-Vertrag; MARKET.md §9.4, §10.4; REUSE.md §5.4.
--
--  Renderer-Vertrag (§B7.5), so umgesetzt:
--    * ein ungedrehter Wurzel-Frame mit ClipsDescendants; Preisfläche ≈ 72 %, Volumen ≈ 14 %, Indikator-Bereich
--      optional, rechte Achse 56 px, Zeitachse 18 px; KEIN CanvasGroup, kein TextScaled auf Achsen (BuilderMono, feste Größe)
--    * Pool beim new(): je Kerzen-Slot Körper + Docht + Volumen (+ Flächen-Streifen nur bei AreaFill) für N + 1 Slots
--      (N = 60 Handy / 90 / 120 PC je Grafikstufe), Achsen-Labels, Gitter, Alarm-Linien, Fadenkreuz – nie Instance.new
--      beim Ticken; ≤ 900 GuiObjects je Chart (Stats().Objects)
--    * Scale-Koordinaten x = (i − 0,5)/N, y = 1 − (p − lo)/(hi − lo); geschrieben wird nur bei Änderung (Cache je Slot)
--    * je Frame bewegt sich nur die Live-Kerze (alpha = 1 − e^(−12·dt)); der y-Bereich gleitet mit 1 − e^(−6·dt) –
--      als O(1)-Transformation eines Zwischen-Frames (Höhe/Lage), die Kerzen selbst bleiben stehen. Neu ausgelegt
--      (O(N)) wird höchstens 1×/s, wenn der Zielbereich die Referenz verlässt oder um > 5 % schrumpft (MARKET §10.4)
--    * neue Kerze = ältesten Slot recyceln + die Streifen-Container per Tween 0,25 s Quint Out um eine Slot-Breite
--      schieben (O(1))
--    * Linien (Kurs-Linie, SMA/EMA/Bollinger/VWAP, RSI/MACD/Stochastik/ATR) per Path2D (Laufzeit-Prüfung in Init,
--      in Studio verifizieren); sonst gedrehte Segment-Frames in Pixeln ÷ akkumulierte UIScale, auf das Plot-Rechteck
--      geklemmt (dann gleitet der y-Bereich nicht, sondern springt höchstens 1×/s – Segmente würden sonst verzerren)
--    * Fadenkreuz + OHLC-Pille: Maus (InputChanged), Touch (halten + ziehen), Steuerkreuz (MoveCrosshair)
--
--  Öffentliche API (§C7.5):
--    ChartView.new(parent, opts): View
--      opts { Candles: number, Volume: boolean, Pane: string?, Style: string, Labels: boolean,
--             AreaFill: boolean?, Smooth: boolean?, MaxLines: number?, ZIndex: number?,
--             OnPick: ((price) -> ())?, OnSwipe: ((dir) -> ())?, OnCrosshair: ((candle?) -> ())? }
--      Style "Candles" | "Hollow" | "Line" | "Area" | "HeikinAshi"; Pane "RSI" | "MACD" | "Stoch" | "ATR"
--    View:SetData(candles, tf)   View:PushQuote(close, tick, high?, low?, vol?)   View:SetIndicators(map)
--    View:SetStyle(s)   View:Step(dt)   View:Destroy()
--  Zusätzlich: View:SetAlerts({ {Px, Dir} })  View:SetMarks({ {Px, Color, Text} })  View:SetPlaceholder(text?)
--    View:SetPickMode(on)  View:MoveCrosshair(delta)  View:HideCrosshair()  View:Repaint()  View:SetVisible(on)
--    View:Stats(): { Objects, Path2D, Candles }   View:PriceRange(): (lo, hi)   View:Count(): number
--    ChartView.Init(ctx), ChartView.HasPath2D(): boolean, ChartView.Colors (Indikator-Farben aus js/chart.js)
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Indicators = require(Shared:WaitForChild("Market"):WaitForChild("Indicators"))

-- selene: allow(undefined_variable)
local Path2DPoint = Path2DControlPoint

type Candle = Types.Candle

local ChartView = {}
ChartView.__index = ChartView

local Theme = UI.Theme
local WHITE = Color3.new(1, 1, 1)

-- Indikator-Farben exakt wie js/chart.js der Website (§B7.5)
ChartView.Colors = {
	SMA20 = Color3.fromHex("#f5b942"),
	SMA50 = Color3.fromHex("#4f8cff"),
	SMA200 = Color3.fromHex("#e056fd"),
	EMA9 = Color3.fromHex("#00d1b2"),
	EMA21 = Color3.fromHex("#ff7a45"),
	BB = Color3.fromHex("#7c8cff"),
	VWAP = Color3.fromHex("#ffd166"),
	RSI = Color3.fromHex("#b388ff"),
	MACD = Color3.fromHex("#4f8cff"),
	MACDSignal = Color3.fromHex("#ff7a45"),
	StochK = Color3.fromHex("#00d1b2"),
	StochD = Color3.fromHex("#ff7a45"),
	ATR = Color3.fromHex("#b388ff"),
}

local MAX_OBJECTS = 900 -- GuiObjects je Chart (Renderer-Vertrag)
local AXIS_W = 56
local AXIS_H = 18
local PRICE_LABELS = 8
local TIME_LABELS = 6
local MAX_ALERTS = 18
local MAX_MARKS = 8
local LIVE_K = 12 -- Live-Kerze: alpha = 1 − e^(−12·dt)
local RANGE_K = 6 -- y-Bereich: 1 − e^(−6·dt)
local REBASE_GAP = 1 -- höchstens 1× je Sekunde neu auslegen
local SHRINK_REBASE = 0.05 -- Zielbereich > 5 % kleiner als angezeigt -> neu skalieren (MARKET §10.4)
local PAD = 0.08 -- Rand oben/unten im Preisbereich
local SCROLL_INFO = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local PLACEHOLDER_PULSE = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local HOLD_FOR_CROSSHAIR = 0.25 -- Touch: so lange halten -> Fadenkreuz statt Wischen
local SWIPE_MIN = 70 -- px
local SWIPE_TIME = 0.4
local DATA_KEEP_EXTRA = 220 -- Kerzen über N hinaus für das Aufwärmen der Indikatoren (SMA200)
local INDICATOR_GAP = 1 -- Indikatoren höchstens 1× je Sekunde neu rechnen (Kurse kommen mit 1 Hz)
local PANES = { RSI = true, MACD = true, Stoch = true, ATR = true }
local PANE_ORDER = { "RSI", "MACD", "Stoch", "ATR" }
local OVERLAY_ORDER = { "SMA20", "SMA50", "SMA200", "EMA9", "EMA21", "BB", "VWAP" }

local ctx: any = nil
local path2dOk = false
local path2dMax = 0

-- ---------------------------------------------------------------------
-- TYPEN
-- ---------------------------------------------------------------------
type Slot = {
	Body: Frame,
	Wick: Frame,
	Stroke: UIStroke,
	Vol: Frame?,
	Fill: Frame?,
	A: number,
	Bx: number,
	By: number,
	Bh: number,
	Wx: number,
	Wy: number,
	Wh: number,
	Vx: number,
	Vh: number,
	Fx: number,
	Fy: number,
	Color: Color3?,
	Hollow: boolean?,
	Shown: boolean,
}

type Line = {
	Key: string,
	Color: Color3,
	Thickness: number,
	Transparency: number,
	Pane: boolean,
	Values: { number? },
	Paths: { any },
	Segs: { Frame },
	Parent: Frame,
	Live: Line?, -- 2-Punkte-Segment vorletzte -> letzte Kerze (je Kurs O(1) statt O(N))
}

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function finite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function langNow(): string
	if ctx and type(ctx.Lang_) == "function" then
		local ok, lang = pcall(ctx.Lang_)
		if ok and (lang == "de" or lang == "en") then
			return lang
		end
	end
	return "en"
end

local function formatPrice(cents: number): string
	local format = ctx and ctx.Format
	if format and type(format.Price) == "function" then
		local ok, text = pcall(format.Price, cents, langNow())
		if ok and type(text) == "string" then
			return text
		end
	end
	return string.format("%.2f", cents / 100)
end

local function formatCompact(n: number): string
	local format = ctx and ctx.Format
	if format and type(format.Compact) == "function" then
		local ok, text = pcall(format.Compact, n, langNow())
		if ok and type(text) == "string" then
			return text
		end
	end
	return tostring(math.floor(n))
end

local function niceStep(span: number, count: number): number
	if span <= 0 or not finite(span) then
		return 1
	end
	local raw = span / math.max(1, count)
	local mag = 10 ^ math.floor(math.log10(raw))
	local norm = raw / mag
	local step = if norm < 1.5 then 1 elseif norm < 3 then 2 elseif norm < 7 then 5 else 10
	return step * mag
end

local function copyCandle(c: any): Candle?
	if type(c) ~= "table" then
		return nil
	end
	local t, o, h, l, cl, v = c.T, c.O, c.H, c.L, c.C, c.V
	if not (finite(t) and finite(o) and finite(h) and finite(l) and finite(cl)) or cl <= 0 then
		return nil
	end
	return {
		T = t,
		O = o,
		H = math.max(h, o, cl),
		L = math.min(l, o, cl),
		C = cl,
		V = if finite(v) then math.max(0, v) else 0,
	}
end

local function timeLabel(t: number, tfTicks: number): string
	local clock = ctx and ctx.Clock
	local epoch = if clock and type(clock.EPOCH) == "number" then clock.EPOCH else 1767571200
	if tfTicks >= 1200 and tfTicks < 8400 then
		local day = t // 1200
		if ctx then
			return ctx.T("term.axis.day", day % 504 + 1)
		end
		return "#" .. tostring(day % 504 + 1)
	end
	local unix = t + epoch
	local pattern: any = if tfTicks < 60 then "%H:%M:%S" else "%H:%M"
	local ok, text = pcall(os.date, pattern, unix)
	if ok and type(text) == "string" then
		return text
	end
	return tostring(t)
end

local function newFrame(props: { [string]: any }): Frame
	local base: { [string]: any } = { BackgroundTransparency = 1, BorderSizePixel = 0 }
	for k, v in pairs(props) do
		base[k] = v
	end
	return UI.Create("Frame", base)
end

local function newLabel(props: { [string]: any }): TextLabel
	local base: { [string]: any } = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		FontFace = UI.Faces.Mono,
		TextSize = 11,
		TextColor3 = Theme.Muted,
		Text = "",
		TextScaled = false,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return UI.Create("TextLabel", base)
end

-- ---------------------------------------------------------------------
-- AUFBAU
-- ---------------------------------------------------------------------
function ChartView.new(parent: Instance, opts: { [string]: any }?): any
	local o = opts or {}
	local self = setmetatable({}, ChartView) :: any
	local n = math.clamp(math.floor(tonumber(o.Candles) or 60), 10, 120)
	self.N = n
	self.Labels = o.Labels ~= false
	self.VolumeOn = o.Volume ~= false
	self.AreaAlloc = o.AreaFill == true
	self.Smooth = o.Smooth ~= false
	self.MaxLines = math.clamp(math.floor(tonumber(o.MaxLines) or 6), 0, 8)
	self.Style = if type(o.Style) == "string" then o.Style else "Candles"
	self.OnPick = o.OnPick
	self.OnSwipe = o.OnSwipe
	self.OnCrosshair = o.OnCrosshair
	self.Z = math.floor(tonumber(o.ZIndex) or 1)
	self.Objects = 0
	self.Alive = true
	self.Visible = true
	self.Conns = {} :: { RBXScriptConnection }
	self.Tweens = {} :: { Tween }
	self.Data = {} :: { Candle }
	self.Source = {} :: { Candle }
	self.Seq0 = 0
	self.Base = 0
	self.TfTicks = 60
	self.LastTick = 0
	self.Lines = {} :: { Line }
	self.IndMap = {} :: { [string]: boolean }
	self.PaneKind = if type(o.Pane) == "string" and PANES[o.Pane] then o.Pane else nil
	self.IndDirty = false
	self.IndAt = 0
	self.RefLo, self.RefHi = 0, 1
	self.Lo, self.Hi = 0, 1
	self.TLo, self.THi = 0, 1
	self.RebaseAt = -math.huge
	self.NeedRebase = true
	self.VolRef = 1
	self.PaneLo, self.PaneHi = 0, 100
	self.Live = { O = 0, H = 0, L = 0, C = 0 }
	self.Shown = { O = 0, H = 0, L = 0, C = 0 }
	self.Alerts = {} :: { { Px: number, Dir: string } }
	self.Marks = {} :: { { Px: number, Color: Color3, Text: string } }
	self.Cross = nil :: number?
	self.CrossY = nil :: number?
	self.PickMode = false
	self.Scale = 1
	self.ScaleAt = -math.huge
	self.YScale = 1
	self.YPos = 0
	self.VMaxTarget = 1
	self.PlaceholderPulse = nil :: Tween?

	local z = self.Z
	local root = newFrame({
		Name = "ChartView",
		Size = UDim2.fromScale(1, 1),
		ClipsDescendants = true,
		ZIndex = z,
		Parent = parent,
	})
	self.Root = root
	local axisW = if self.Labels then AXIS_W else 0
	local axisH = if self.Labels then AXIS_H else 0
	self.AxisW, self.AxisH = axisW, axisH

	local plot = newFrame({
		Name = "Plot",
		Size = UDim2.new(1, -axisW, 1, -axisH),
		ZIndex = z,
		Parent = root,
	})
	self.Plot = plot
	-- Preisfläche (Clip) -> YFrame (Transformation des y-Bereichs) -> XStrip (Laufband)
	local pricePlot = newFrame({ Name = "Price", ClipsDescendants = true, ZIndex = z, Parent = plot })
	self.PricePlot = pricePlot
	local gridStrip = newFrame({ Name = "GridX", Size = UDim2.fromScale(1, 1), ZIndex = z, Parent = pricePlot })
	self.GridStrip = gridStrip
	local yFrame = newFrame({ Name = "Y", Size = UDim2.fromScale(1, 1), ZIndex = z, Parent = pricePlot })
	self.YFrame = yFrame
	local xStrip = newFrame({ Name = "X", Size = UDim2.fromScale(1, 1), ZIndex = z + 1, Parent = yFrame })
	self.XStrip = xStrip
	-- Volumen
	local volPlot = newFrame({ Name = "Volume", ClipsDescendants = true, ZIndex = z, Parent = plot })
	self.VolPlot = volPlot
	local volStrip = newFrame({ Name = "X", Size = UDim2.fromScale(1, 1), ZIndex = z, Parent = volPlot })
	self.VolStrip = volStrip
	-- Indikator-Bereich (RSI/MACD/…)
	local panePlot = newFrame({ Name = "Pane", ClipsDescendants = true, Visible = false, ZIndex = z, Parent = plot })
	self.PanePlot = panePlot
	local paneStrip = newFrame({ Name = "X", Size = UDim2.fromScale(1, 1), ZIndex = z + 1, Parent = panePlot })
	self.PaneStrip = paneStrip
	self.Objects += 9

	-- Slots (N + 1: einer gleitet beim Schieben links hinaus)
	self.Slots = {} :: { Slot }
	local bodyW = 0.7 / n
	for k = 1, n + 1 do
		local fill: Frame? = nil
		if self.AreaAlloc then
			local f = newFrame({
				Name = "Fill",
				AnchorPoint = Vector2.new(0.5, 0),
				Size = UDim2.new(1 / n, 1, 3, 0),
				BackgroundColor3 = Theme.Accent,
				BackgroundTransparency = 0.55,
				Visible = false,
				ZIndex = z,
				Parent = xStrip,
			})
			UI.Create("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.35),
					NumberSequenceKeypoint.new(0.3, 0.92),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Parent = f,
			})
			fill = f
			self.Objects += 1
		end
		local wick = newFrame({
			Name = "Wick",
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.new(0, 1, 0, 0),
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Up,
			Visible = false,
			ZIndex = z + 1,
			Parent = xStrip,
		})
		local body = newFrame({
			Name = "Body",
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.new(bodyW, 0, 0, 1),
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Up,
			Visible = false,
			ZIndex = z + 2,
			Parent = xStrip,
		})
		local stroke = UI.Create("UIStroke", {
			Thickness = 1,
			Color = Theme.Up,
			Enabled = false,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = body,
		})
		local vol: Frame? = nil
		if self.VolumeOn then
			vol = newFrame({
				Name = "Vol",
				AnchorPoint = Vector2.new(0.5, 1),
				Size = UDim2.new(bodyW, 0, 0, 0),
				BackgroundTransparency = 0.35,
				BackgroundColor3 = Theme.Up,
				Visible = false,
				ZIndex = z,
				Parent = volStrip,
			})
			self.Objects += 1
		end
		self.Objects += 2
		local slot: Slot = {
			Body = body,
			Wick = wick,
			Stroke = stroke,
			Vol = vol,
			Fill = fill,
			A = -1,
			Bx = -1,
			By = -1,
			Bh = -1,
			Wx = -1,
			Wy = -1,
			Wh = -1,
			Vx = -1,
			Vh = -1,
			Fx = -1,
			Fy = -1,
			Color = nil,
			Hollow = nil,
			Shown = false,
		}
		self.Slots[k] = slot
	end

	-- Gitter + Achsen
	self.GridY = {} :: { Frame }
	self.PriceLabels = {} :: { TextLabel }
	self.GridX = {} :: { Frame }
	self.TimeLabels = {} :: { { Label: TextLabel, A: number } }
	if self.Labels then
		for _ = 1, PRICE_LABELS do
			table.insert(
				self.GridY,
				newFrame({
					Name = "GridY",
					AnchorPoint = Vector2.new(0, 0.5),
					Size = UDim2.new(1, 0, 0, 1),
					BackgroundTransparency = 0.45,
					BackgroundColor3 = Theme.Border,
					Visible = false,
					ZIndex = z,
					Parent = yFrame,
				})
			)
		end
		for _ = 1, TIME_LABELS do
			table.insert(
				self.GridX,
				newFrame({
					Name = "GridX",
					AnchorPoint = Vector2.new(0.5, 0),
					Size = UDim2.new(0, 1, 1, 0),
					BackgroundTransparency = 0.55,
					BackgroundColor3 = Theme.Border,
					Visible = false,
					ZIndex = z,
					Parent = gridStrip,
				})
			)
		end
		self.Objects += PRICE_LABELS + TIME_LABELS
		local axisY = newFrame({
			Name = "AxisY",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			ClipsDescendants = true,
			ZIndex = z,
			Parent = root,
		})
		self.AxisY = axisY
		local axisYFrame = newFrame({ Name = "Y", Size = UDim2.fromScale(1, 1), ZIndex = z, Parent = axisY })
		self.AxisYFrame = axisYFrame
		for _ = 1, PRICE_LABELS do
			table.insert(
				self.PriceLabels,
				newLabel({
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.fromOffset(6, 0),
					Size = UDim2.new(1, -8, 0, 14),
					TextXAlignment = Enum.TextXAlignment.Left,
					Visible = false,
					ZIndex = z + 1,
					Parent = axisYFrame,
				})
			)
		end
		local axisX = newFrame({
			Name = "AxisX",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, -axisW, 0, axisH),
			ClipsDescendants = true,
			ZIndex = z,
			Parent = root,
		})
		local axisXStrip = newFrame({ Name = "X", Size = UDim2.fromScale(1, 1), ZIndex = z, Parent = axisX })
		self.AxisXStrip = axisXStrip
		for _ = 1, TIME_LABELS do
			table.insert(self.TimeLabels, {
				Label = newLabel({
					AnchorPoint = Vector2.new(0.5, 0.5),
					Size = UDim2.fromOffset(64, 14),
					Position = UDim2.fromScale(0, 0.5),
					Visible = false,
					ZIndex = z + 1,
					Parent = axisXStrip,
				}),
				A = -1,
			})
		end
		self.Objects += 4 + PRICE_LABELS + TIME_LABELS
		-- Letzter Kurs: Linie + Pille an der Achse
		self.LastLine = newFrame({
			Name = "LastLine",
			AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundTransparency = 0.45,
			BackgroundColor3 = Theme.Up,
			Visible = false,
			ZIndex = z + 3,
			Parent = yFrame,
		})
		local pill = newLabel({
			Name = "LastPill",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromOffset(2, 0),
			Size = UDim2.new(1, -2, 0, 16),
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Up,
			TextColor3 = WHITE,
			FontFace = UI.Faces.MonoBold,
			Visible = false,
			ZIndex = z + 4,
			Parent = axisYFrame,
		})
		UI.Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = pill })
		self.LastPill = pill
		-- Fadenkreuz
		self.CrossV = newFrame({
			Name = "CrossV",
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.new(0, 1, 1, 0),
			BackgroundTransparency = 0.35,
			BackgroundColor3 = Theme.Text2,
			Visible = false,
			ZIndex = z + 6,
			Parent = plot,
		})
		self.CrossH = newFrame({
			Name = "CrossH",
			AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundTransparency = 0.35,
			BackgroundColor3 = Theme.Text2,
			Visible = false,
			ZIndex = z + 6,
			Parent = plot,
		})
		local ohlc = newLabel({
			Name = "Ohlc",
			Position = UDim2.fromOffset(6, 4),
			Size = UDim2.new(1, -12, 0, 16),
			BackgroundTransparency = 0.15,
			BackgroundColor3 = Theme.Bg2,
			TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			RichText = true,
			Visible = false,
			ZIndex = z + 7,
			Parent = plot,
		})
		UI.Create("UIPadding", { PaddingLeft = UDim.new(0, 6), Parent = ohlc })
		UI.Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = ohlc })
		self.Ohlc = ohlc
		local crossPill = newLabel({
			Name = "CrossPill",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromOffset(2, 0),
			Size = UDim2.new(1, -2, 0, 16),
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Surface2,
			TextColor3 = Theme.Text,
			Visible = false,
			ZIndex = z + 8,
			Parent = axisY,
		})
		UI.Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = crossPill })
		self.CrossPill = crossPill
		self.Objects += 7
	end

	-- Alarm-Linien (Know-how-Basis 3, max. 18) und Markierungen (Einstand, Order-Preise) – gepoolt
	self.AlertPool = {} :: { { Line: Frame, Tag: TextLabel } }
	self.MarkPool = {} :: { { Line: Frame, Tag: TextLabel } }
	local function makeMarker(pool: { any }, count: number, color: Color3)
		for _ = 1, count do
			local line = newFrame({
				Name = "Marker",
				AnchorPoint = Vector2.new(0, 0.5),
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundTransparency = 0.2,
				BackgroundColor3 = color,
				Visible = false,
				ZIndex = z + 3,
				Parent = yFrame,
			})
			local tag = newLabel({
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -4, 0, -1),
				Size = UDim2.fromOffset(120, 12),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = color,
				TextSize = 10,
				Visible = self.Labels,
				ZIndex = z + 3,
				Parent = line,
			})
			table.insert(pool, { Line = line, Tag = tag })
			self.Objects += 2
		end
	end
	if self.Labels then
		-- Welt-Monitore (ohne Beschriftung) brauchen keine Alarm-/Order-Linien -> Objekt-Budget sparen
		makeMarker(self.AlertPool, MAX_ALERTS, Theme.Warn)
		makeMarker(self.MarkPool, MAX_MARKS, Theme.Accent)
	end

	-- Platzhalter ("Historie lädt …")
	self.Placeholder = UI.Create("TextLabel", {
		Name = "Placeholder",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(1, -20, 0, 20),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Body,
		TextSize = 14,
		TextColor3 = Theme.Muted,
		Text = "",
		Visible = false,
		ZIndex = z + 9,
		Parent = root,
	})
	self.Objects += 1

	-- Linien: Kurs-Linie (statischer Teil + Live-Segment)
	self.PriceLine = self:_newLine("Price", Theme.Accent, 2, 0, false)
	self.LiveSeg = self:_newLine("Live", Theme.Accent, 2, 0, false)

	self:_layout()
	self:_bindInput()
	table.insert(
		self.Conns,
		plot:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if not path2dOk then
				self.NeedRebase = true -- Segmente sind in Pixeln
			end
		end)
	)
	return self
end

-- Fraktionen der Bereiche (Preis/Volumen/Indikator) setzen
function ChartView._layout(self: any)
	local pane = self.PaneKind ~= nil
	local priceF, volTop, volF, paneTop, paneF
	if pane and self.VolumeOn then
		priceF, volTop, volF, paneTop, paneF = 0.58, 0.61, 0.12, 0.76, 0.24
	elseif pane then
		priceF, volTop, volF, paneTop, paneF = 0.72, 1, 0, 0.76, 0.24
	elseif self.VolumeOn then
		priceF, volTop, volF, paneTop, paneF = 0.80, 0.84, 0.16, 1, 0
	else
		priceF, volTop, volF, paneTop, paneF = 0.97, 1, 0, 1, 0
	end
	self.PriceF = priceF
	self.PricePlot.Size = UDim2.fromScale(1, priceF)
	self.VolPlot.Position = UDim2.fromScale(0, volTop)
	self.VolPlot.Size = UDim2.fromScale(1, volF)
	self.VolPlot.Visible = self.VolumeOn
	self.PanePlot.Position = UDim2.fromScale(0, paneTop)
	self.PanePlot.Size = UDim2.fromScale(1, paneF)
	self.PanePlot.Visible = pane
	if self.AxisY then
		-- Achsen-Spalte = Höhe der Preisfläche (Wurzel minus Zeitachse)
		self.AxisY.Size = UDim2.new(0, self.AxisW, priceF, -priceF * self.AxisH)
	end
end

-- ---------------------------------------------------------------------
-- LINIEN (Path2D oder Segment-Rückfall)
-- ---------------------------------------------------------------------
function ChartView._newLine(
	self: any,
	key: string,
	color: Color3,
	thickness: number,
	transparency: number,
	pane: boolean
)
	local line: Line = {
		Key = key,
		Color = color,
		Thickness = thickness,
		Transparency = transparency,
		Pane = pane,
		Values = {},
		Paths = {},
		Segs = {},
		Parent = if pane then self.PaneStrip else self.XStrip,
		Live = nil,
	}
	return line
end

function ChartView._releaseLine(self: any, line: Line)
	local live = line.Live
	if live then
		self:_releaseLine(live)
		line.Live = nil
	end
	for _, path in ipairs(line.Paths) do
		path:Destroy()
		self.Objects -= 1
	end
	table.clear(line.Paths)
	for _, seg in ipairs(line.Segs) do
		seg:Destroy()
		self.Objects -= 1
	end
	table.clear(line.Segs)
end

-- Pfad-Punkte setzen; points = { {x, y} } in Strip-Scale
function ChartView._drawPath(self: any, line: Line, points: { { number } })
	local count = #points
	if path2dOk then
		local chunk = math.max(2, path2dMax)
		local needed = if count >= 2 then math.ceil((count - 1) / (chunk - 1)) else 0
		while #line.Paths < needed do
			local okPath, path = pcall(Instance.new, "Path2D")
			if not okPath then
				break
			end
			path.Thickness = line.Thickness
			path.Color3 = line.Color
			path.Transparency = line.Transparency
			path.ZIndex = self.Z + 2
			path.Parent = line.Parent
			table.insert(line.Paths, path)
			self.Objects += 1
		end
		for index, path in ipairs(line.Paths) do
			if index <= needed then
				local from = (index - 1) * (chunk - 1) + 1
				local to = math.min(count, from + chunk - 1)
				local cps = table.create(to - from + 1)
				for k = from, to do
					local p = points[k]
					table.insert(cps, Path2DPoint.new(UDim2.fromScale(p[1], p[2])))
				end
				pcall(path.SetControlPoints, path, cps)
				if not path.Visible then
					path.Visible = true
				end
				if path.Color3 ~= line.Color then
					path.Color3 = line.Color
				end
			elseif path.Visible then
				path.Visible = false
			end
		end
		return
	end
	-- Rückfall: gedrehte Segment-Frames in Pixeln, Budget beachten
	local strip: Frame = line.Parent
	local size = strip.AbsoluteSize
	local scale = self:_scale()
	local w, h = size.X / scale, size.Y / scale
	-- sichtbares Rechteck in Strip-Koordinaten (gedrehte Frames werden nicht geclippt -> selbst klemmen)
	local sy = if line.Pane then 1 else math.max(self.YScale or 1, 1e-6)
	local py = if line.Pane then 0 else (self.YPos or 0)
	local yMin, yMax = -py / sy, (1 - py) / sy
	local sx = strip.Position.X.Scale
	local xMin, xMax = -sx, 1 - sx
	local need = math.max(0, count - 1)
	local budget = MAX_OBJECTS - self.Objects + #line.Segs
	local step = 1
	if need > budget and budget > 0 then
		step = math.ceil(need / budget)
	elseif budget <= 0 then
		need = 0
	end
	local used = 0
	local k = 1
	while k < count and used < budget do
		local nextK = math.min(count, k + step)
		local p1, p2 = points[k], points[nextK]
		if p2[1] < xMin or p1[1] > xMax then
			k = nextK
			continue
		end
		used += 1
		local seg = line.Segs[used]
		if not seg then
			seg = newFrame({
				Name = "Seg",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = line.Transparency,
				BackgroundColor3 = line.Color,
				ZIndex = self.Z + 2,
				Parent = strip,
			})
			table.insert(line.Segs, seg)
			self.Objects += 1
		end
		-- im Plot-Rechteck klemmen (Drehung hebelt ClipsDescendants aus)
		local x1, x2 = math.clamp(p1[1], xMin, xMax), math.clamp(p2[1], xMin, xMax)
		local y1 = math.clamp(p1[2], yMin, yMax)
		local y2 = math.clamp(p2[2], yMin, yMax)
		local dx, dy = (x2 - x1) * w, (y2 - y1) * h
		local length = math.sqrt(dx * dx + dy * dy)
		seg.Position = UDim2.fromScale((x1 + x2) / 2, (y1 + y2) / 2)
		seg.Size = UDim2.fromOffset(length + 1, line.Thickness)
		seg.Rotation = math.deg(math.atan2(dy, dx))
		seg.BackgroundColor3 = line.Color
		seg.Visible = true
		k = nextK
	end
	for index = used + 1, #line.Segs do
		local seg = line.Segs[index]
		if seg.Visible then
			seg.Visible = false
		end
	end
end

function ChartView._hideLine(self: any, line: Line)
	local live = line.Live
	if live then
		self:_hideLine(live)
	end
	for _, path in ipairs(line.Paths) do
		if path.Visible then
			path.Visible = false
		end
	end
	for _, seg in ipairs(line.Segs) do
		if seg.Visible then
			seg.Visible = false
		end
	end
end

function ChartView._scale(self: any): number
	local now = os.clock()
	if now - self.ScaleAt > 1 then
		self.ScaleAt = now
		self.Scale = UI.ScaleOf(self.Root)
	end
	return self.Scale
end

-- ---------------------------------------------------------------------
-- KOORDINATEN
-- ---------------------------------------------------------------------
function ChartView._x(self: any, a: number): number
	return (a - self.Base + 0.5) / self.N
end

function ChartView._y(self: any, p: number): number
	local range = self.RefHi - self.RefLo
	if range <= 0 then
		return 0.5
	end
	return (self.RefHi - p) / range
end

function ChartView._lastA(self: any): number
	return self.Seq0 + #self.Data - 1
end

function ChartView._stripX(self: any): number
	-- Live-Kerze (lastA) steht bei (N − 0,5)/N
	return -(self:_lastA() - self.Base - self.N + 1) / self.N
end

function ChartView._candleAt(self: any, a: number): Candle?
	return self.Source[a - self.Seq0 + 1]
end

-- ---------------------------------------------------------------------
-- BEREICH (Ziel, Referenz, Transformation)
-- ---------------------------------------------------------------------
function ChartView._targetRange(self: any)
	local source = self.Source
	local count = #source
	local lo, hi = math.huge, -math.huge
	local first = math.max(1, count - self.N + 1)
	for k = first, count do
		local c = source[k]
		if c.L < lo then
			lo = c.L
		end
		if c.H > hi then
			hi = c.H
		end
	end
	-- Overlay-Linien (Bollinger usw.) mit einbeziehen, damit sie nicht abgeschnitten werden
	for _, line in ipairs(self.Lines) do
		if not line.Pane then
			for k = first, count do
				local v = line.Values[k]
				if v then
					if v < lo then
						lo = v
					end
					if v > hi then
						hi = v
					end
				end
			end
		end
	end
	if lo == math.huge then
		lo, hi = 0, 1
	end
	local mid = (lo + hi) / 2
	local span = math.max(hi - lo, math.max(1, mid * 0.004))
	self.TLo = mid - span / 2 - span * PAD
	self.THi = mid + span / 2 + span * PAD
	-- Volumen-Referenz
	local vmax = 0
	for k = first, count do
		local v = source[k].V
		if v > vmax then
			vmax = v
		end
	end
	self.VMaxTarget = math.max(1, vmax)
end

function ChartView._applyTransform(self: any)
	local lo, hi = self.Lo, self.Hi
	local span = hi - lo
	if span <= 0 then
		return
	end
	local sy = (self.RefHi - self.RefLo) / span
	local py = (hi - self.RefHi) / span
	if self.YScale ~= sy or self.YPos ~= py then
		self.YScale, self.YPos = sy, py
		local size = UDim2.fromScale(1, sy)
		local pos = UDim2.fromScale(0, py)
		self.YFrame.Size = size
		self.YFrame.Position = pos
		if self.AxisYFrame then
			self.AxisYFrame.Size = size
			self.AxisYFrame.Position = pos
		end
	end
end

-- ---------------------------------------------------------------------
-- SLOTS
-- ---------------------------------------------------------------------
function ChartView._slotFor(self: any, a: number): Slot
	return self.Slots[(a % (self.N + 1)) + 1]
end

function ChartView._paintSlot(self: any, slot: Slot, a: number, o: number, h: number, l: number, c: number, v: number)
	local style = self.Style
	local candleStyle = style == "Candles" or style == "Hollow" or style == "HeikinAshi"
	local range = self.RefHi - self.RefLo
	if range <= 0 then
		return
	end
	local x = self:_x(a)
	local up = c >= o
	local color = if up then UI.UpColor() else UI.DownColor()
	if slot.A ~= a then
		slot.A = a
	end
	if candleStyle then
		local top = math.max(o, c)
		local by = (self.RefHi - top) / range
		local bh = math.abs(o - c) / range
		local wy = (self.RefHi - h) / range
		local wh = (h - l) / range
		if slot.Bx ~= x or slot.By ~= by or slot.Bh ~= bh then
			slot.Bx, slot.By, slot.Bh = x, by, bh
			slot.Body.Position = UDim2.fromScale(x, by)
			slot.Body.Size = UDim2.new(0.7 / self.N, 0, bh, 1)
		end
		if slot.Wx ~= x or slot.Wy ~= wy or slot.Wh ~= wh then
			slot.Wx, slot.Wy, slot.Wh = x, wy, wh
			slot.Wick.Position = UDim2.fromScale(x, wy)
			slot.Wick.Size = UDim2.new(0, 1, wh, 1)
		end
		local hollow = style == "Hollow" and up
		if slot.Color ~= color or slot.Hollow ~= hollow then
			slot.Color = color
			slot.Hollow = hollow
			slot.Body.BackgroundColor3 = color
			slot.Body.BackgroundTransparency = if hollow then 1 else 0
			slot.Stroke.Color = color
			slot.Stroke.Enabled = hollow
			slot.Wick.BackgroundColor3 = color
		end
		if not slot.Body.Visible then
			slot.Body.Visible = true
			slot.Wick.Visible = true
		end
	elseif slot.Body.Visible then
		slot.Body.Visible = false
		slot.Wick.Visible = false
	end
	local fill = slot.Fill
	if fill then
		local want = style == "Area"
		if want then
			local fy = (self.RefHi - c) / range
			if slot.Fx ~= x or slot.Fy ~= fy then
				slot.Fx, slot.Fy = x, fy
				fill.Position = UDim2.fromScale(x, fy)
			end
		end
		if fill.Visible ~= want then
			fill.Visible = want
		end
	end
	local vol = slot.Vol
	if vol then
		local vh = math.clamp(v / math.max(1, self.VolRef), 0, 1)
		if slot.Vx ~= x or slot.Vh ~= vh then
			slot.Vx, slot.Vh = x, vh
			vol.Position = UDim2.fromScale(x, 1)
			vol.Size = UDim2.new(0.7 / self.N, 0, vh, 0)
		end
		if vol.BackgroundColor3 ~= color then
			vol.BackgroundColor3 = color
		end
		if not vol.Visible then
			vol.Visible = true
		end
	end
	slot.Shown = true
end

function ChartView._hideSlot(_self: any, slot: Slot)
	if not slot.Shown then
		return
	end
	slot.Shown = false
	slot.A = -1
	slot.Body.Visible = false
	slot.Wick.Visible = false
	if slot.Vol then
		slot.Vol.Visible = false
	end
	if slot.Fill then
		slot.Fill.Visible = false
	end
end

-- ---------------------------------------------------------------------
-- NEU AUSLEGEN (O(N), höchstens 1×/s)
-- ---------------------------------------------------------------------
function ChartView._rebase(self: any)
	self.RebaseAt = os.clock()
	self.NeedRebase = false
	self:_targetRange()
	local span = self.THi - self.TLo
	self.RefLo = self.TLo - span * 0.5
	self.RefHi = self.THi + span * 0.5
	if not self.Smooth or not path2dOk or self.Lo >= self.Hi then
		self.Lo, self.Hi = self.TLo, self.THi
	end
	self.VolRef = self.VMaxTarget or 1
	self.Base = self:_lastA() - self.N
	-- laufende Schiebe-Tweens zielen auf die alte Basis -> abbrechen, Lage direkt setzen
	for _, tween in ipairs(self.Tweens) do
		tween:Cancel()
	end
	table.clear(self.Tweens)
	self.XStrip.Position = UDim2.fromScale(self:_stripX(), 0)
	self.GridStrip.Position = self.XStrip.Position
	self.VolStrip.Position = self.XStrip.Position
	self.PaneStrip.Position = self.XStrip.Position
	if self.AxisXStrip then
		self.AxisXStrip.Position = self.XStrip.Position
	end
	self:_applyTransform()
	self:_relayoutAll()
end

function ChartView._relayoutAll(self: any)
	local lastA = self:_lastA()
	local firstA = lastA - self.N + 1
	for _, slot in ipairs(self.Slots) do
		slot.A = -1
	end
	for a = firstA, lastA do
		local c = self:_candleAt(a)
		local slot = self:_slotFor(a)
		if c then
			if a == lastA and self.Smooth then
				local s = self.Shown
				self:_paintSlot(slot, a, s.O, s.H, s.L, s.C, c.V)
			else
				self:_paintSlot(slot, a, c.O, c.H, c.L, c.C, c.V)
			end
		end
	end
	for _, slot in ipairs(self.Slots) do
		if slot.A < firstA or slot.A > lastA or self:_candleAt(slot.A) == nil then
			self:_hideSlot(slot)
		end
	end
	self:_drawLines()
	self:_drawAxes()
	self:_drawMarkers()
	self:_drawLast()
end

function ChartView._drawAxes(self: any)
	if not self.Labels then
		return
	end
	local step = niceStep(self.THi - self.TLo, 4)
	local first = math.ceil(self.RefLo / step) * step
	local index = 0
	local level = first
	while level <= self.RefHi and index < PRICE_LABELS do
		index += 1
		local y = self:_y(level)
		local grid = self.GridY[index]
		grid.Position = UDim2.fromScale(0, y)
		grid.Visible = true
		local label = self.PriceLabels[index]
		label.Position = UDim2.new(0, 6, y, 0)
		label.Text = formatPrice(level)
		label.Visible = true
		level += step
	end
	for k = index + 1, PRICE_LABELS do
		self.GridY[k].Visible = false
		self.PriceLabels[k].Visible = false
	end
	-- Zeit-Labels: Kerzen mit a % step == 0
	local tstep = math.max(1, math.floor(self.N / 5 + 0.5))
	local lastA = self:_lastA()
	local firstA = lastA - self.N + 1
	local a = lastA - (lastA % tstep)
	local used = 0
	while a >= firstA and used < TIME_LABELS do
		local c = self:_candleAt(a)
		if c then
			used += 1
			local entry = self.TimeLabels[used]
			entry.A = a
			local x = self:_x(a)
			entry.Label.Position = UDim2.fromScale(x, 0.5)
			entry.Label.Text = timeLabel(c.T, self.TfTicks)
			entry.Label.Visible = true
			local grid = self.GridX[used]
			grid.Position = UDim2.fromScale(x, 0)
			grid.Visible = true
		end
		a -= tstep
	end
	for k = used + 1, TIME_LABELS do
		self.TimeLabels[k].A = -1
		self.TimeLabels[k].Label.Visible = false
		self.GridX[k].Visible = false
	end
end

-- neue Kerze: höchstens ein Zeit-Label neu vergeben (O(1))
function ChartView._advanceTimeLabel(self: any, a: number)
	if not self.Labels then
		return
	end
	local tstep = math.max(1, math.floor(self.N / 5 + 0.5))
	if a % tstep ~= 0 then
		return
	end
	local oldest, oldestA = nil, math.huge
	for index, entry in ipairs(self.TimeLabels) do
		if entry.A < oldestA then
			oldest, oldestA = index, entry.A
		end
	end
	if not oldest then
		return
	end
	local c = self:_candleAt(a)
	if not c then
		return
	end
	local entry = self.TimeLabels[oldest]
	entry.A = a
	local x = self:_x(a)
	entry.Label.Position = UDim2.fromScale(x, 0.5)
	entry.Label.Text = timeLabel(c.T, self.TfTicks)
	entry.Label.Visible = true
	local grid = self.GridX[oldest]
	grid.Position = UDim2.fromScale(x, 0)
	grid.Visible = true
end

function ChartView._drawMarkers(self: any)
	local range = self.RefHi - self.RefLo
	for index, entry in ipairs(self.AlertPool) do
		local alert = self.Alerts[index]
		if alert and range > 0 then
			entry.Line.Position = UDim2.fromScale(0, self:_y(alert.Px))
			entry.Tag.Text = (if alert.Dir == "Up" then "▲ " else "▼ ") .. formatPrice(alert.Px)
			entry.Line.Visible = true
		else
			entry.Line.Visible = false
		end
	end
	for index, entry in ipairs(self.MarkPool) do
		local mark = self.Marks[index]
		if mark and range > 0 then
			entry.Line.Position = UDim2.fromScale(0, self:_y(mark.Px))
			entry.Line.BackgroundColor3 = mark.Color
			entry.Tag.TextColor3 = mark.Color
			entry.Tag.Text = mark.Text
			entry.Line.Visible = true
		else
			entry.Line.Visible = false
		end
	end
end

function ChartView._drawLast(self: any)
	if not self.Labels or not self.LastLine then
		return
	end
	local count = #self.Source
	local last = self.Source[count]
	if not last then
		self.LastLine.Visible = false
		self.LastPill.Visible = false
		return
	end
	local shown = self.Shown
	local price = if self.Smooth then shown.C else last.C
	local prev = self.Source[count - 1]
	local ref = if prev then prev.C else last.O
	local color = UI.TrendColor(last.C - ref)
	if last.C == ref then
		color = Theme.Accent
	end
	local y = self:_y(price)
	self.LastLine.Position = UDim2.fromScale(0, y)
	if self.LastLine.BackgroundColor3 ~= color then
		self.LastLine.BackgroundColor3 = color
		self.LastPill.BackgroundColor3 = color
	end
	self.LastLine.Visible = true
	self.LastPill.Position = UDim2.new(0, 2, y, 0)
	local text = formatPrice(last.C)
	if self.LastPill.Text ~= text then
		self.LastPill.Text = text
	end
	self.LastPill.Visible = true
end

-- Linien neu zeichnen (O(N); bei neuer Kerze, Neu-Auslegen, Indikator-Wechsel)
function ChartView._drawLines(self: any)
	local lastA = self:_lastA()
	local firstA = lastA - self.N + 1
	local style = self.Style
	local lineStyle = style == "Line" or style == "Area"
	-- Kurs-Linie: statischer Teil bis zur vorletzten Kerze, Live-Segment separat
	if lineStyle and #self.Source >= 2 then
		local color = Theme.Accent
		self.PriceLine.Color = color
		self.LiveSeg.Color = color
		local points: { { number } } = {}
		for a = math.max(firstA, self.Seq0), lastA - 1 do
			local c = self:_candleAt(a)
			if c then
				table.insert(points, { self:_x(a), self:_y(c.C) })
			end
		end
		if #points >= 2 then
			self:_drawPath(self.PriceLine, points)
		else
			self:_hideLine(self.PriceLine)
		end
		self:_drawLiveSegment()
	else
		self:_hideLine(self.PriceLine)
		self:_hideLine(self.LiveSeg)
	end
	-- Indikatoren: statischer Teil bis zur vorletzten Kerze (ändert sich nur bei neuer Kerze), Live-Segment separat
	for _, line in ipairs(self.Lines) do
		local points: { { number } } = {}
		for a = math.max(firstA, self.Seq0), lastA - 1 do
			local v = line.Values[a - self.Seq0 + 1]
			if v and finite(v) then
				local y = if line.Pane then self:_paneY(v) else self:_y(v)
				table.insert(points, { self:_x(a), y })
			end
		end
		if #points >= 2 then
			self:_drawPath(line, points)
		else
			for _, path in ipairs(line.Paths) do
				path.Visible = false
			end
			for _, seg in ipairs(line.Segs) do
				seg.Visible = false
			end
		end
	end
	self:_drawLiveIndicators()
end

-- nur die Live-Segmente der Indikatoren (bei jedem neuen Kurs derselben Kerze)
function ChartView._drawLiveIndicators(self: any)
	local lastA = self:_lastA()
	local count = #self.Source
	for _, line in ipairs(self.Lines) do
		local live = line.Live
		if not live then
			live = self:_newLine(line.Key .. "Live", line.Color, line.Thickness, line.Transparency, line.Pane)
			line.Live = live
		end
		local liveLine = live :: Line
		local v1 = line.Values[count - 1]
		local v2 = line.Values[count]
		if v1 and v2 and finite(v1) and finite(v2) then
			local y1 = if line.Pane then self:_paneY(v1) else self:_y(v1)
			local y2 = if line.Pane then self:_paneY(v2) else self:_y(v2)
			self:_drawPath(liveLine, { { self:_x(lastA - 1), y1 }, { self:_x(lastA), y2 } })
		else
			self:_hideLine(liveLine)
		end
	end
end

function ChartView._drawLiveSegment(self: any)
	local count = #self.Source
	if count < 2 then
		self:_hideLine(self.LiveSeg)
		return
	end
	local lastA = self:_lastA()
	local prev = self.Source[count - 1]
	local price = if self.Smooth then self.Shown.C else self.Source[count].C
	self:_drawPath(self.LiveSeg, {
		{ self:_x(lastA - 1), self:_y(prev.C) },
		{ self:_x(lastA), self:_y(price) },
	})
end

function ChartView._paneY(self: any, v: number): number
	local span = self.PaneHi - self.PaneLo
	if span <= 0 then
		return 0.5
	end
	return math.clamp(0.06 + 0.88 * (self.PaneHi - v) / span, 0, 1)
end

-- ---------------------------------------------------------------------
-- INDIKATOREN
-- ---------------------------------------------------------------------
-- keepPane: Bereich des Indikator-Felds beibehalten (Live-Neuberechnung derselben Kerze – der statische Teil
-- wurde mit diesem Bereich gezeichnet, ein neuer Bereich käme erst mit der nächsten Kerze)
function ChartView._computeIndicators(self: any, keepPane: boolean?)
	self.IndDirty = false
	self.IndAt = os.clock()
	local source = self.Source
	local count = #source
	if count == 0 or #self.Lines == 0 then
		return
	end
	local closes = table.create(count)
	for k = 1, count do
		closes[k] = source[k].C
	end
	local bb: any = nil
	local macd: any = nil
	local stoch: any = nil
	for _, line in ipairs(self.Lines) do
		local key = line.Key
		local values: { number? } = {}
		if key == "SMA20" then
			values = Indicators.SMA(closes, 20)
		elseif key == "SMA50" then
			values = Indicators.SMA(closes, 50)
		elseif key == "SMA200" then
			values = Indicators.SMA(closes, 200)
		elseif key == "EMA9" then
			values = Indicators.EMA(closes, 9)
		elseif key == "EMA21" then
			values = Indicators.EMA(closes, 21)
		elseif key == "VWAP" then
			values = Indicators.VWAP(source)
		elseif key == "BBU" or key == "BBM" or key == "BBL" then
			bb = bb or Indicators.Bollinger(closes, 20, 2)
			values = if key == "BBU" then bb.Upper elseif key == "BBM" then bb.Mid else bb.Lower
		elseif key == "RSI" then
			values = Indicators.RSI(closes, 14)
		elseif key == "MACD" or key == "MACDSignal" then
			macd = macd or Indicators.MACD(closes, 12, 26, 9)
			values = if key == "MACD" then macd.Line else macd.Signal
		elseif key == "StochK" or key == "StochD" then
			stoch = stoch or Indicators.Stoch(source, 14, 3)
			values = if key == "StochK" then stoch.K else stoch.D
		elseif key == "ATR" then
			values = Indicators.ATR(source, 14)
		end
		line.Values = values
	end
	-- Bereich des Indikator-Felds
	local pane = self.PaneKind
	if keepPane and self.PaneHi > self.PaneLo then
		return
	end
	if pane == "RSI" or pane == "Stoch" then
		self.PaneLo, self.PaneHi = 0, 100
	elseif pane then
		local lo, hi = math.huge, -math.huge
		local first = math.max(1, count - self.N + 1)
		for _, line in ipairs(self.Lines) do
			if line.Pane then
				for k = first, count do
					local v = line.Values[k]
					if v then
						lo = math.min(lo, v)
						hi = math.max(hi, v)
					end
				end
			end
		end
		if lo == math.huge then
			lo, hi = 0, 1
		end
		if pane == "MACD" then
			local m = math.max(math.abs(lo), math.abs(hi), 1e-6)
			lo, hi = -m, m
		elseif hi - lo < 1e-6 then
			hi = lo + 1
		end
		self.PaneLo, self.PaneHi = lo, hi
	end
end

function ChartView._paneGuides(self: any)
	local guides = self.PaneGuides
	if not guides then
		guides = {}
		for _ = 1, 3 do
			table.insert(
				guides,
				newFrame({
					Name = "Guide",
					AnchorPoint = Vector2.new(0, 0.5),
					Size = UDim2.new(1, 0, 0, 1),
					BackgroundColor3 = Theme.Border,
					BackgroundTransparency = 0.2,
					Visible = false,
					ZIndex = self.Z,
					Parent = self.PanePlot,
				})
			)
			self.Objects += 1
		end
		self.PaneGuides = guides
	end
	local levels: { number } = {}
	if self.PaneKind == "RSI" then
		levels = { 30, 50, 70 }
	elseif self.PaneKind == "Stoch" then
		levels = { 20, 50, 80 }
	elseif self.PaneKind == "MACD" then
		levels = { 0 }
	end
	for index, guide in ipairs(guides) do
		local level = levels[index]
		if level then
			guide.Position = UDim2.fromScale(0, self:_paneY(level))
			guide.Visible = true
		else
			guide.Visible = false
		end
	end
end

-- ---------------------------------------------------------------------
-- EINGABE (Fadenkreuz, Wischen, Alarm setzen)
-- ---------------------------------------------------------------------
function ChartView._bindInput(self: any)
	if not self.Labels then
		return
	end
	local plot: Frame = self.Plot
	plot.Active = true
	local touchStart: InputObject? = nil
	local touchPos = Vector2.zero
	local touchAt = 0
	local touchCross = false
	table.insert(
		self.Conns,
		plot.InputBegan:Connect(function(input: InputObject)
			local kind = input.UserInputType
			if kind == Enum.UserInputType.MouseButton1 then
				if self.PickMode and self.OnPick then
					local price = self:PriceAtScreen(input.Position.Y)
					if price then
						task.spawn(self.OnPick, price)
					end
				end
			elseif kind == Enum.UserInputType.Touch then
				touchStart = input
				touchPos = Vector2.new(input.Position.X, input.Position.Y)
				touchAt = os.clock()
				touchCross = false
			end
		end)
	)
	table.insert(
		self.Conns,
		plot.InputChanged:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				self:_crossAt(input.Position.X, input.Position.Y)
			end
		end)
	)
	table.insert(
		self.Conns,
		plot.MouseLeave:Connect(function()
			self:HideCrosshair()
		end)
	)
	table.insert(
		self.Conns,
		UserInputService.InputChanged:Connect(function(input: InputObject)
			if input ~= touchStart then
				return
			end
			local pos = Vector2.new(input.Position.X, input.Position.Y)
			if not touchCross and os.clock() - touchAt >= HOLD_FOR_CROSSHAIR then
				touchCross = true
			end
			if touchCross then
				self:_crossAt(pos.X, pos.Y)
			end
		end)
	)
	table.insert(
		self.Conns,
		UserInputService.InputEnded:Connect(function(input: InputObject)
			if input ~= touchStart then
				return
			end
			touchStart = nil
			local pos = Vector2.new(input.Position.X, input.Position.Y)
			local delta = pos - touchPos
			local quick = os.clock() - touchAt <= SWIPE_TIME
			if touchCross then
				task.delay(1.5, function()
					if self.Alive and touchStart == nil then
						self:HideCrosshair()
					end
				end)
			elseif quick and math.abs(delta.X) >= SWIPE_MIN and math.abs(delta.Y) < math.abs(delta.X) * 0.6 then
				if self.OnSwipe then
					task.spawn(self.OnSwipe, if delta.X < 0 then 1 else -1)
				end
			elseif quick and delta.Magnitude < 12 and self.PickMode and self.OnPick then
				local price = self:PriceAtScreen(pos.Y)
				if price then
					task.spawn(self.OnPick, price)
				end
			end
		end)
	)
end

-- Preis an einer Bildschirm-Höhe (angezeigter Bereich)
function ChartView.PriceAtScreen(self: any, screenY: number): number?
	local plot: Frame = self.PricePlot
	local top = plot.AbsolutePosition.Y
	local height = plot.AbsoluteSize.Y
	if height <= 1 then
		return nil
	end
	local frac = (screenY - top) / height
	if frac < 0 or frac > 1 then
		return nil
	end
	return math.max(1, math.floor(self.Hi - frac * (self.Hi - self.Lo) + 0.5))
end

function ChartView._crossAt(self: any, screenX: number, screenY: number)
	if not self.Labels or #self.Source == 0 then
		return
	end
	local plot: Frame = self.Plot
	local size = plot.AbsoluteSize
	if size.X <= 1 then
		return
	end
	local rel = math.clamp((screenX - plot.AbsolutePosition.X) / size.X, 0, 0.9999)
	local slotIndex = math.floor(rel * self.N)
	local a = self:_lastA() - (self.N - 1 - slotIndex)
	if self:_candleAt(a) == nil then
		a = math.max(self.Seq0, a)
	end
	self.Cross = a
	self.CrossY = screenY
	self:_drawCross()
end

function ChartView._drawCross(self: any)
	local a = self.Cross
	if not a or not self.Labels then
		return
	end
	local c = self:_candleAt(a)
	if not c then
		self:HideCrosshair()
		return
	end
	local slotIndex = a - (self:_lastA() - self.N + 1)
	self.CrossV.Position = UDim2.fromScale((slotIndex + 0.5) / self.N, 0)
	self.CrossV.Visible = true
	local plot: Frame = self.Plot
	local y = self.CrossY
	local price: number? = nil
	if y then
		price = self:PriceAtScreen(y)
	end
	if not price then
		price = c.C
		y = nil
	end
	local pricePlot: Frame = self.PricePlot
	local frac = (self.Hi - (price :: number)) / math.max(1e-9, self.Hi - self.Lo)
	local yPlot = frac * pricePlot.AbsoluteSize.Y / math.max(1, plot.AbsoluteSize.Y)
	self.CrossH.Position = UDim2.fromScale(0, math.clamp(yPlot, 0, 1))
	self.CrossH.Visible = true
	self.CrossPill.Position = UDim2.new(0, 2, math.clamp(frac, 0, 1), 0)
	self.CrossPill.Text = formatPrice(price :: number)
	self.CrossPill.Visible = true
	local up = UI.ColorHex(UI.TrendColor(c.C - c.O))
	local text = string.format(
		'<font color="%s">%s</font>',
		up,
		if ctx
			then ctx.T(
				"term.ohlc",
				formatPrice(c.O),
				formatPrice(c.H),
				formatPrice(c.L),
				formatPrice(c.C),
				formatCompact(c.V * 10)
			)
			else formatPrice(c.C)
	)
	self.Ohlc.Text = text
	self.Ohlc.Visible = true
	if self.OnCrosshair then
		task.spawn(self.OnCrosshair, c)
	end
end

function ChartView.HideCrosshair(self: any)
	self.Cross = nil
	self.CrossY = nil
	if self.Labels and self.CrossV then
		self.CrossV.Visible = false
		self.CrossH.Visible = false
		self.CrossPill.Visible = false
		self.Ohlc.Visible = false
	end
	if self.OnCrosshair then
		task.spawn(self.OnCrosshair, nil)
	end
end

-- Steuerkreuz: Fadenkreuz kerzenweise bewegen
function ChartView.MoveCrosshair(self: any, delta: number)
	if #self.Source == 0 or not self.Labels then
		return
	end
	local lastA = self:_lastA()
	local a = self.Cross or lastA
	if self.Cross ~= nil then
		a += math.floor(delta)
	end
	a = math.clamp(a, math.max(self.Seq0, lastA - self.N + 1), lastA)
	self.Cross = a
	self.CrossY = nil
	self:_drawCross()
end

function ChartView.SetPickMode(self: any, on: boolean)
	self.PickMode = on == true
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH
-- ---------------------------------------------------------------------
function ChartView.SetPlaceholder(self: any, text: string?)
	local label: TextLabel = self.Placeholder
	local show = type(text) == "string" and text ~= ""
	if show and label.Text ~= text then
		label.Text = text :: string
	end
	if label.Visible ~= show then
		label.Visible = show
		-- Lade-Zustand: ruhiges Atmen des Textes (ein Tween je Chart, nur solange sichtbar)
		local pulse = self.PlaceholderPulse
		if pulse then
			pulse:Cancel()
			self.PlaceholderPulse = nil
		end
		label.TextTransparency = 0
		if show and self.Labels then
			local tween = TweenService:Create(label, PLACEHOLDER_PULSE, { TextTransparency = 0.5 })
			self.PlaceholderPulse = tween
			tween:Play()
		end
	end
end

function ChartView._rebuildSource(self: any)
	if self.Style == "HeikinAshi" and #self.Data > 0 then
		local ok, ha = pcall(Indicators.HeikinAshi, self.Data)
		self.Source = if ok and type(ha) == "table" and #ha == #self.Data then ha else self.Data
	else
		self.Source = self.Data
	end
	local last = self.Source[#self.Source]
	if last then
		self.Live.O, self.Live.H, self.Live.L, self.Live.C = last.O, last.H, last.L, last.C
	end
end

function ChartView.SetData(self: any, candles: { Candle }, tf: any)
	if not self.Alive then
		return
	end
	local ticks = tonumber(tf)
	if not ticks and type(tf) == "string" then
		local map = { ["1s"] = 1, ["5s"] = 5, ["1m"] = 60, ["5m"] = 300, ["15m"] = 900, ["1T"] = 1200, ["1W"] = 8400 }
		ticks = map[tf]
	end
	self.TfTicks = math.max(1, math.floor(ticks or 60))
	local data: { Candle } = {}
	if type(candles) == "table" then
		local keep = self.N + DATA_KEEP_EXTRA
		for k = math.max(1, #candles - keep + 1), #candles do
			local c = copyCandle(candles[k])
			if c and (#data == 0 or c.T > data[#data].T) then
				table.insert(data, c)
			end
		end
	end
	self.Data = data
	self.Seq0 = 0
	local last = data[#data]
	self.LastTick = if last then last.T else 0
	self:_rebuildSource()
	local src = self.Source[#self.Source]
	if src then
		self.Shown.O, self.Shown.H, self.Shown.L, self.Shown.C = src.O, src.H, src.L, src.C
	end
	self.Lo, self.Hi = 0, 0
	self:_computeIndicators()
	self:HideCrosshair()
	if #data == 0 then
		for _, slot in ipairs(self.Slots) do
			self:_hideSlot(slot)
		end
		self:_hideLine(self.PriceLine)
		self:_hideLine(self.LiveSeg)
		for _, line in ipairs(self.Lines) do
			self:_hideLine(line)
		end
		return
	end
	self:SetPlaceholder(nil)
	self:_rebase()
	if self.PaneKind then
		self:_paneGuides()
	end
end

-- Neuer Kurs (1s-Kerze aus dem Frame): gleicher Bucket -> Live-Kerze, neuer Bucket -> neue Kerze (O(1))
function ChartView.PushQuote(self: any, close: number, tick: number, high: number?, low: number?, vol: number?)
	if not self.Alive or not finite(close) or close <= 0 or not finite(tick) then
		return
	end
	local data = self.Data
	local last = data[#data]
	if not last then
		return -- ohne Historie keine erfundenen Kerzen
	end
	local h = if finite(high) then math.max(high :: number, close) else close
	local l = if finite(low) then math.min(low :: number, close) else close
	local v = if finite(vol) then math.max(0, vol :: number) else 0
	local bucket = (tick // self.TfTicks) * self.TfTicks
	if bucket == last.T then
		if tick <= self.LastTick then
			last.C = close -- schon gezählt: nur den Schluss nachziehen
		else
			last.H = math.max(last.H, h)
			last.L = math.min(last.L, l)
			last.C = close
			last.V += v
		end
		self.LastTick = math.max(self.LastTick, tick)
		if self.Style == "HeikinAshi" then
			self:_rebuildSource()
		else
			self.Live.O, self.Live.H, self.Live.L, self.Live.C = last.O, last.H, last.L, last.C
		end
		self.IndDirty = #self.Lines > 0
		if not self.Smooth then
			self:_snapLive()
		end
		return
	elseif bucket < last.T then
		return
	end
	-- neue Kerze: Vorgänger endgültig zeichnen
	local prevA = self:_lastA()
	local prevSource = self.Source[#self.Source]
	if prevSource then
		self.Shown.O, self.Shown.H, self.Shown.L, self.Shown.C = prevSource.O, prevSource.H, prevSource.L, prevSource.C
		local slot = self:_slotFor(prevA)
		self:_paintSlot(slot, prevA, prevSource.O, prevSource.H, prevSource.L, prevSource.C, prevSource.V)
	end
	local open = last.C
	table.insert(data, {
		T = bucket,
		O = open,
		H = math.max(open, h),
		L = math.min(open, l),
		C = close,
		V = v,
	})
	self.LastTick = tick
	if #data > self.N + DATA_KEEP_EXTRA then
		table.remove(data, 1)
		self.Seq0 += 1
	end
	self:_rebuildSource()
	local src = self.Source[#self.Source]
	self.Shown.O, self.Shown.H, self.Shown.L, self.Shown.C = src.O, src.O, src.O, src.O
	if not self.Smooth then
		self.Shown.H, self.Shown.L, self.Shown.C = src.H, src.L, src.C
	end
	local lastA = self:_lastA()
	-- ältester Slot wird recycelt: neuer Index lastA
	local slot = self:_slotFor(lastA)
	self:_paintSlot(slot, lastA, self.Shown.O, self.Shown.H, self.Shown.L, self.Shown.C, src.V)
	-- Streifen um eine Slot-Breite schieben
	if lastA - self.Base > self.N + 400 then
		self.NeedRebase = true -- Koordinaten zu groß -> beim nächsten Step neu auslegen
	end
	local goal = UDim2.fromScale(self:_stripX(), 0)
	local strips = { self.XStrip, self.GridStrip, self.VolStrip, self.PaneStrip, self.AxisXStrip }
	for _, tween in ipairs(self.Tweens) do
		tween:Cancel()
	end
	table.clear(self.Tweens)
	for _, strip in ipairs(strips) do
		if strip then
			if self.Smooth then
				local tween = TweenService:Create(strip, SCROLL_INFO, { Position = goal })
				table.insert(self.Tweens, tween)
				tween:Play()
			else
				strip.Position = goal
			end
		end
	end
	self:_advanceTimeLabel(lastA)
	-- Ziel-Bereich und Linien (einmal je neuer Kerze)
	self:_targetRange()
	if self.THi > self.RefHi or self.TLo < self.RefLo then
		self.NeedRebase = true
	end
	if self.VMaxTarget > self.VolRef * 1.15 or self.VMaxTarget < self.VolRef * 0.6 then
		self.NeedRebase = true
	end
	if #self.Lines > 0 then
		self:_computeIndicators()
	end
	self:_drawLines()
	if self.Cross then
		self:_drawCross()
	end
end

-- ohne Glätten (Welt-Monitore): Live-Kerze sofort zeichnen
function ChartView._snapLive(self: any)
	local live = self.Live
	local s = self.Shown
	s.O, s.H, s.L, s.C = live.O, live.H, live.L, live.C
	local lastA = self:_lastA()
	local src = self.Source[#self.Source]
	if src then
		self:_paintSlot(self:_slotFor(lastA), lastA, s.O, s.H, s.L, s.C, src.V)
	end
	if self.Style == "Line" or self.Style == "Area" then
		self:_drawLiveSegment()
	end
	self:_drawLast()
end

function ChartView.SetIndicators(self: any, map: { [string]: boolean }?)
	local want = if type(map) == "table" then map else {}
	self.IndMap = table.clone(want)
	for _, line in ipairs(self.Lines) do
		self:_releaseLine(line)
	end
	table.clear(self.Lines)
	local budget = self.MaxLines
	local colors = ChartView.Colors
	for _, key in ipairs(OVERLAY_ORDER) do
		if want[key] and budget > 0 then
			budget -= 1
			if key == "BB" then
				table.insert(self.Lines, self:_newLine("BBU", colors.BB, 1, 0.15, false))
				table.insert(self.Lines, self:_newLine("BBM", colors.BB, 1, 0.55, false))
				table.insert(self.Lines, self:_newLine("BBL", colors.BB, 1, 0.15, false))
			else
				table.insert(self.Lines, self:_newLine(key, (colors :: any)[key], 1.5, 0, false))
			end
		end
	end
	local pane: string? = nil
	for _, key in ipairs(PANE_ORDER) do
		if want[key] and budget > 0 and pane == nil then
			pane = key
			budget -= 1
		end
	end
	if pane == "RSI" then
		table.insert(self.Lines, self:_newLine("RSI", colors.RSI, 1.5, 0, true))
	elseif pane == "MACD" then
		table.insert(self.Lines, self:_newLine("MACD", colors.MACD, 1.5, 0, true))
		table.insert(self.Lines, self:_newLine("MACDSignal", colors.MACDSignal, 1.5, 0, true))
	elseif pane == "Stoch" then
		table.insert(self.Lines, self:_newLine("StochK", colors.StochK, 1.5, 0, true))
		table.insert(self.Lines, self:_newLine("StochD", colors.StochD, 1.5, 0, true))
	elseif pane == "ATR" then
		table.insert(self.Lines, self:_newLine("ATR", colors.ATR, 1.5, 0, true))
	end
	if pane ~= self.PaneKind then
		self.PaneKind = pane
		self:_layout()
	end
	self:_computeIndicators()
	if pane then
		self:_paneGuides()
	elseif self.PaneGuides then
		for _, guide in ipairs(self.PaneGuides) do
			guide.Visible = false
		end
	end
	if #self.Data > 0 then
		self:_rebase()
	end
end

function ChartView.SetStyle(self: any, style: string)
	local valid = { Candles = true, Hollow = true, Line = true, Area = true, HeikinAshi = true }
	if not valid[style] then
		return
	end
	if style == "Area" and not self.AreaAlloc then
		style = "Line" -- Fläche nur mit vorbereiteten Streifen (High/Ultra)
	end
	if self.Style == style then
		return
	end
	self.Style = style
	self:_rebuildSource()
	local src = self.Source[#self.Source]
	if src then
		self.Shown.O, self.Shown.H, self.Shown.L, self.Shown.C = src.O, src.H, src.L, src.C
	end
	if #self.Lines > 0 then
		self:_computeIndicators()
	end
	if #self.Data > 0 then
		self:_rebase()
	end
end

function ChartView.SetAlerts(self: any, list: { any }?)
	local clean: { { Px: number, Dir: string } } = {}
	if type(list) == "table" then
		for _, alert in ipairs(list) do
			if type(alert) == "table" and finite(alert.Px) and #clean < MAX_ALERTS then
				table.insert(clean, { Px = alert.Px, Dir = if alert.Dir == "Up" then "Up" else "Down" })
			end
		end
	end
	self.Alerts = clean
	self:_drawMarkers()
end

function ChartView.SetMarks(self: any, list: { any }?)
	local clean: { { Px: number, Color: Color3, Text: string } } = {}
	if type(list) == "table" then
		for _, mark in ipairs(list) do
			if type(mark) == "table" and finite(mark.Px) and #clean < MAX_MARKS then
				table.insert(clean, {
					Px = mark.Px,
					Color = if typeof(mark.Color) == "Color3" then mark.Color else Theme.Accent,
					Text = if type(mark.Text) == "string" then mark.Text else "",
				})
			end
		end
	end
	self.Marks = clean
	self:_drawMarkers()
end

-- Farben neu (Farbenblind-Modus)
function ChartView.Repaint(self: any)
	for _, slot in ipairs(self.Slots) do
		slot.Color = nil
	end
	if #self.Data > 0 then
		self:_relayoutAll()
	end
end

function ChartView.SetVisible(self: any, on: boolean)
	self.Visible = on == true
	if self.Root.Visible ~= self.Visible then
		self.Root.Visible = self.Visible
	end
end

function ChartView.Count(self: any): number
	return #self.Data
end

function ChartView.PriceRange(self: any): (number, number)
	return self.Lo, self.Hi
end

function ChartView.Stats(self: any): { [string]: any }
	return { Objects = self.Objects, Path2D = path2dOk, Candles = self.N }
end

-- Je Frame (Terminal/Monitors): nur Live-Kerze + y-Transformation (O(1)); Neu-Auslegen höchstens 1×/s
function ChartView.Step(self: any, dt: number)
	if not self.Alive or not self.Visible or #self.Data == 0 then
		return
	end
	local now = os.clock()
	if self.IndDirty and now - self.IndAt >= INDICATOR_GAP then
		self:_computeIndicators(true)
		self:_drawLiveIndicators()
	end
	if now - self.RebaseAt >= REBASE_GAP then
		self:_targetRange()
		local shownSpan = self.Hi - self.Lo
		local targetSpan = self.THi - self.TLo
		local outside = self.THi > self.RefHi or self.TLo < self.RefLo
		local tooWide = (self.RefHi - self.RefLo) > 3.2 * targetSpan
		local shrink = shownSpan > 0 and targetSpan < shownSpan * (1 - SHRINK_REBASE)
		if self.NeedRebase or outside or tooWide or (not path2dOk and shrink) then
			self:_rebase()
		else
			self.RebaseAt = now
		end
	end
	-- y-Bereich gleitet (nur mit Path2D; Segmente würden verzerren)
	if self.Smooth and path2dOk then
		local a = 1 - math.exp(-RANGE_K * math.max(0, dt))
		local lo = self.Lo + (self.TLo - self.Lo) * a
		local hi = self.Hi + (self.THi - self.Hi) * a
		if math.abs(lo - self.Lo) > 1e-4 or math.abs(hi - self.Hi) > 1e-4 then
			self.Lo, self.Hi = lo, hi
			self:_applyTransform()
		end
	end
	-- Live-Kerze gleitet zum neuesten Kurs (keine erfundenen Zwischenkurse: Ziel = echter Schluss)
	if self.Smooth then
		local live = self.Live
		local s = self.Shown
		local a = 1 - math.exp(-LIVE_K * math.max(0, dt))
		local moved = false
		local function ease(cur: number, target: number): number
			local nextValue = cur + (target - cur) * a
			if math.abs(target - nextValue) < 0.05 then
				nextValue = target
			end
			if nextValue ~= cur then
				moved = true
			end
			return nextValue
		end
		s.O = ease(s.O, live.O)
		s.H = ease(s.H, live.H)
		s.L = ease(s.L, live.L)
		s.C = ease(s.C, live.C)
		if moved then
			local lastA = self:_lastA()
			local src = self.Source[#self.Source]
			self:_paintSlot(
				self:_slotFor(lastA),
				lastA,
				s.O,
				math.max(s.H, s.O, s.C),
				math.min(s.L, s.O, s.C),
				s.C,
				src.V
			)
			if self.Style == "Line" or self.Style == "Area" then
				self:_drawLiveSegment()
			end
			self:_drawLast()
		end
	end
end

function ChartView.Destroy(self: any)
	if not self.Alive then
		return
	end
	self.Alive = false
	for _, conn in ipairs(self.Conns) do
		conn:Disconnect()
	end
	table.clear(self.Conns)
	for _, tween in ipairs(self.Tweens) do
		tween:Cancel()
	end
	table.clear(self.Tweens)
	if self.PlaceholderPulse then
		self.PlaceholderPulse:Cancel()
		self.PlaceholderPulse = nil
	end
	self.Root:Destroy()
end

-- ---------------------------------------------------------------------
-- BIBLIOTHEK
-- ---------------------------------------------------------------------
function ChartView.HasPath2D(): boolean
	return path2dOk
end

function ChartView.Init(context: any)
	ctx = context
	local ok, result = pcall(function(): number
		if Path2DPoint == nil then
			return 0
		end
		local path = Instance.new("Path2D")
		path:SetControlPoints({
			Path2DPoint.new(UDim2.fromScale(0, 0)),
			Path2DPoint.new(UDim2.fromScale(1, 1)),
		})
		local max = path:GetMaxControlPoints()
		path:Destroy()
		return max
	end)
	if ok and type(result) == "number" and result >= 2 then
		path2dOk = true
		path2dMax = math.min(result, 512)
	else
		path2dOk = false
		path2dMax = 0
		warn("[ChartView] Path2D nicht verfügbar – Linien als Segment-Frames (Rückfall)")
	end
end

return ChartView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">CityLife</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Umgebungsleben: Verkehr, Drohnen, Luftschiff, Hologramme, Firmen-Läden (Client/Modules/CityLife)
--  Besitzer: WP7 (Stadt, Grafik, Fahrzeuge). Vertrag: DESIGN.md §A5 (Umgebungsleben nur Client, Budget je Grafikstufe:
--  Verkehr 0/10/20/32 auf Splines, Lieferdrohnen 0/4/8/14, Hologramm-Werbetafeln fiktiver Firmen, Luftschiff mit ΛKYTEX-Logo;
--  Firmen-Läden bekommen Spot + Mini-Ticker, solange ihre Firma eine aktive News hat; keine Fußgänger-NPCs), §C7.5
--  (CityLife.SetDensity), §C16 (CityLife < 0,5 ms/Frame), §C14.3 (Asset-Plätze City.TrafficCar/Drone/Blimp mit Rezept).
--
--  Alles hier ist lokal (nie repliziert, nie kollidierend, kein Schatten) und gepoolt: Positionen kommen aus der
--  Server-Zeit (Clock.Now) -> Verkehr und Luftschiff stehen auf allen Clients an derselben Stelle. Bewegung über
--  workspace:BulkMoveTo, weit entfernte Autos werden nicht bewegt (unsichtbar geparkt).
--  Laden-Mini-Ticker: ein lokales Teil mit Attribut Monitor = Kürzel am Platz "ShopTicker" -> das Modul Monitors (WP5)
--  zeichnet den Live-Chart; Spot = SpotLight am Teil mit Attribut "ShopSpot".
--
--  Öffentliche API (§C7.5):
--    CityLife.SetDensity(mult)        0 … 2 (Tutorial/Fotomodus können das Leben dämpfen), Standard 1
--  Zusätzlich: CityLife.Counts(): { Traffic, Drones, Billboards } · CityLife.Frame(dt) · CityLife.Init(ctx) · CityLife.Start()
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CityLife = {}

type Lane = { Points: { Vector3 }, Spacing: number, Length: number, Dir: number, Speed: number }
type Mover = { Parts: { BasePart }, Offsets: { CFrame }, Lane: Lane?, Phase: number, Hidden: boolean }
type Drone = {
	Parts: { BasePart },
	Offsets: { CFrame },
	Center: Vector3,
	Radius: number,
	Height: number,
	Speed: number,
	Phase: number,
}
type Board = {
	Root: BasePart,
	Ring: BasePart,
	Gui: BillboardGui,
	Ticker: TextLabel,
	Change: TextLabel,
	I: number,
	Base: CFrame,
	Angle: number,
}
type ShopState = { Until: number, Shown: boolean, Monitor: BasePart? }

local ctx: any = nil
local cityCfg: any = {}
local lifeCfg: any = {}
local folder: Folder? = nil
local density = 1
local lanes: { Lane } = {}
local laneWeights: { number } = {}
local traffic: { Mover } = {}
local drones: { Drone } = {}
local boards: { Board } = {}
local blimp: { Parts: { BasePart }, Offsets: { CFrame } }? = nil
local shopStates: { [number]: ShopState } = {}
local tickerSlots: { [number]: BasePart } = {}
local spotParts: { [number]: BasePart } = {}
local shopFronts: { [number]: BasePart } = {}
local signals: { [BasePart]: { Lamp: string, Group: number } } = {}
local signalAccum = 0
local AssetSlot: any = nil

local LANE_SPACING = 8
local MAX_TRAFFIC = 48
local MAX_DRONES = 20
local SHOP_CHECK = 0.5
local BOARD_REFRESH = 1
local HIDE_Y = -2000
local shopAccum = 0
local boardAccum = 0
local SIGNAL_HZ = 4
local SIGNAL_CYCLE = 30 -- Sekunden: Grün 0–14, Gelb 14–17, Rot 17–30 (alle Clients gleich, aus der Server-Zeit)
local SIGNAL_LIT: { [string]: Color3 } = {
	Red = Color3.fromRGB(255, 64, 64),
	Amber = Color3.fromRGB(250, 190, 40),
	Green = Color3.fromRGB(34, 197, 94),
}
local SIGNAL_DIM: { [string]: Color3 } = {
	Red = Color3.fromRGB(70, 24, 24),
	Amber = Color3.fromRGB(70, 54, 16),
	Green = Color3.fromRGB(14, 52, 28),
}

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function call(name: string, fnName: string, ...: any): (boolean, any, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil, nil
	end
	return pcall(fn, ...)
end

local function tier(): string
	local ok, value = call("Quality", "Tier")
	return if ok and type(value) == "string" then value else "Medium"
end

local function budget(key: string, fallback: number): number
	local ok, value = call("Quality", "Budget", key)
	if ok and type(value) == "number" then
		return value
	end
	return fallback
end

local function serverTime(): number
	return ctx.Clock.Now()
end

local function localPart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		(part :: any)[key] = value
	end
	return part
end

local function ensureFolder(): Folder
	local f = folder
	if f and f.Parent then
		return f
	end
	local created = Instance.new("Folder")
	created.Name = "AT_CityLife"
	created.Parent = workspace
	folder = created
	return created
end

-- Ein Asset-Platz (City.<key>) als lokales Modell, sonst Rezept; Rückgabe: Teile + relative Lagen zum Pivot
local function assetOrRecipe(key: string, recipe: () -> { BasePart }): { BasePart }
	local slots = cityCfg.Assets
	local slot = type(slots) == "table" and slots[key] or nil
	if AssetSlot and slot and AssetSlot.IsSet(slot) then
		local ok, inst = pcall(AssetSlot.Mesh, AssetSlot.KeyOf("City", key), slot, function(): Instance
			local empty = Instance.new("Model")
			empty.Name = "Recipe"
			return empty
		end)
		if ok and typeof(inst) == "Instance" and inst.Name ~= "Recipe" then
			local parts: { BasePart } = {}
			for _, d in ipairs(inst:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					d.CastShadow = false
					table.insert(parts, d)
				end
			end
			if inst:IsA("BasePart") then
				table.insert(parts, inst)
			end
			for _, part in ipairs(parts) do
				part.Parent = ensureFolder()
			end
			if inst:IsA("Model") then
				inst:Destroy()
			end
			if #parts > 0 then
				return parts
			end
		elseif ok and typeof(inst) == "Instance" then
			inst:Destroy()
		end
	end
	return recipe()
end

local function offsetsOf(parts: { BasePart }, pivot: CFrame): { CFrame }
	local offsets: { CFrame } = {}
	for i, part in ipairs(parts) do
		offsets[i] = pivot:Inverse() * part.CFrame
	end
	return offsets
end

local function destroyParts(parts: { BasePart })
	for _, part in ipairs(parts) do
		part:Destroy()
	end
end

-- ---------------------------------------------------------------------
-- 1) SPUREN (gleichmäßig abgetastete Ringe mit Spur-Versatz)
-- ---------------------------------------------------------------------
local function buildLane(def: any): Lane?
	local roadRadius = cityCfg.RoadRadius
	if type(roadRadius) ~= "function" then
		return nil
	end
	local y = (cityCfg.Levels and cityCfg.Levels.Road or 0.25)
	local samples = 1080
	local fine: { Vector3 } = {}
	for i = 0, samples - 1 do
		local deg = i * 360 / samples
		local okR, r = pcall(roadRadius, def.Road, deg, def.Offset)
		if not okR then
			return nil
		end
		local a = math.rad(deg)
		table.insert(fine, Vector3.new(r * math.cos(a), y, r * math.sin(a)))
	end
	local cumulative = { 0 }
	local total = 0
	for i = 1, samples do
		total += (fine[(i % samples) + 1] - fine[i]).Magnitude
		cumulative[i + 1] = total
	end
	local count = math.max(16, math.floor(total / LANE_SPACING))
	local spacing = total / count
	local points: { Vector3 } = {}
	local j = 1
	for k = 0, count - 1 do
		local s = k * spacing
		while j < samples and cumulative[j + 1] < s do
			j += 1
		end
		local seg = cumulative[j + 1] - cumulative[j]
		local f = if seg > 0 then (s - cumulative[j]) / seg else 0
		table.insert(points, fine[j]:Lerp(fine[(j % samples) + 1], f))
	end
	return { Points = points, Spacing = spacing, Length = total, Dir = def.Dir or 1, Speed = def.Speed or 40 }
end

-- Lage auf einer Spur bei Bogenlänge s (geschlossen)
local function laneCFrame(lane: Lane, s: number): CFrame
	local n = #lane.Points
	local u = (s % lane.Length) / lane.Spacing
	local i = math.floor(u)
	local f = u - i
	local a = lane.Points[(i % n) + 1]
	local b = lane.Points[((i + 1) % n) + 1]
	local pos = a:Lerp(b, f)
	local dir = (b - a) * lane.Dir
	if dir.Magnitude < 1e-4 then
		dir = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(pos, pos + dir)
end

-- ---------------------------------------------------------------------
-- 2) VERKEHR
-- ---------------------------------------------------------------------
local function makeTrafficCar(index: number): { BasePart }
	local colors = lifeCfg.TrafficColors or { Color3.fromRGB(30, 34, 44) }
	local color = colors[(index % #colors) + 1]
	local parts: { BasePart } = {}
	local function add(props: { [string]: any })
		local part = localPart(props)
		part.Parent = ensureFolder()
		table.insert(parts, part)
	end
	add({
		Size = Vector3.new(6, 1.8, 12.5),
		CFrame = CFrame.new(0, 1.7, 0),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		Reflectance = 0.15,
	})
	add({
		Size = Vector3.new(5.2, 1.6, 6),
		CFrame = CFrame.new(0, 3.4, 0.6),
		Color = Color3.fromRGB(14, 20, 32),
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		Reflectance = 0.3,
	})
	for _, z in ipairs({ -3.8, 3.8 }) do
		local wheel = localPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(6.3, 2.3, 2.3),
			CFrame = CFrame.new(0, 1.15, z),
			Color = Color3.fromRGB(22, 23, 27),
			Material = Enum.Material.SmoothPlastic,
		})
		wheel.Parent = ensureFolder()
		table.insert(parts, wheel)
	end
	add({
		Size = Vector3.new(5, 0.25, 0.1),
		CFrame = CFrame.new(0, 1.9, -6.3),
		Color = Color3.fromRGB(235, 242, 255),
		Material = Enum.Material.Neon,
	})
	add({
		Size = Vector3.new(5, 0.25, 0.1),
		CFrame = CFrame.new(0, 2.1, 6.3),
		Color = Color3.fromRGB(239, 48, 56),
		Material = Enum.Material.Neon,
	})
	return parts
end

local function wantedTraffic(): number
	return math.clamp(math.floor(budget("Traffic", 10) * density + 0.5), 0, MAX_TRAFFIC)
end

local function pickLane(index: number): Lane?
	if #lanes == 0 then
		return nil
	end
	-- nach Länge gewichtet, deterministisch
	local total = 0
	for _, w in ipairs(laneWeights) do
		total += w
	end
	local x = ((index * 0.6180339887) % 1) * total
	for i, w in ipairs(laneWeights) do
		x -= w
		if x <= 0 then
			return lanes[i]
		end
	end
	return lanes[#lanes]
end

local function syncTraffic()
	local want = wantedTraffic()
	while #traffic > want do
		local mover = table.remove(traffic) :: Mover
		destroyParts(mover.Parts)
	end
	while #traffic < want do
		local index = #traffic + 1
		local parts = assetOrRecipe("TrafficCar", function()
			return makeTrafficCar(index)
		end)
		table.insert(traffic, {
			Parts = parts,
			Offsets = offsetsOf(parts, CFrame.identity),
			Lane = pickLane(index),
			Phase = (index * 0.37) % 1,
			Hidden = false,
		})
	end
end

local moveParts: { BasePart } = {}
local moveCFrames: { CFrame } = {}

local function updateTraffic()
	local camera = workspace.CurrentCamera
	local origin = if camera then camera.CFrame.Position else Vector3.zero
	local radius = lifeCfg.UpdateRadius or 900
	local t = serverTime()
	table.clear(moveParts)
	table.clear(moveCFrames)
	for _, mover in ipairs(traffic) do
		local lane = mover.Lane
		if not lane then
			continue
		end
		local s = mover.Phase * lane.Length + lane.Dir * lane.Speed * t -- Dir −1 fährt die Punktliste rückwärts
		local cf = laneCFrame(lane, s)
		local far = (cf.Position - origin).Magnitude > radius
		if far and mover.Hidden then
			continue
		end
		if far then
			cf = CFrame.new(cf.X, HIDE_Y, cf.Z)
			mover.Hidden = true
		else
			mover.Hidden = false
		end
		for i, part in ipairs(mover.Parts) do
			table.insert(moveParts, part)
			table.insert(moveCFrames, cf * mover.Offsets[i])
		end
	end
	if #moveParts > 0 then
		workspace:BulkMoveTo(moveParts, moveCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- ---------------------------------------------------------------------
-- 3) DROHNEN
-- ---------------------------------------------------------------------
local function makeDrone(): { BasePart }
	local parts: { BasePart } = {}
	local function add(props: { [string]: any })
		local part = localPart(props)
		part.Parent = ensureFolder()
		table.insert(parts, part)
	end
	add({
		Size = Vector3.new(1.8, 0.5, 1.8),
		CFrame = CFrame.new(0, 0, 0),
		Color = Color3.fromRGB(26, 33, 48),
		Material = Enum.Material.Metal,
	})
	for _, x in ipairs({ -1.4, 1.4 }) do
		for _, z in ipairs({ -1.4, 1.4 }) do
			add({
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.08, 1.6, 1.6),
				CFrame = CFrame.new(x, 0.3, z) * CFrame.Angles(0, 0, math.pi / 2),
				Color = Color3.fromRGB(79, 140, 255),
				Material = Enum.Material.Neon,
				Transparency = 0.45,
			})
		end
	end
	add({
		Size = Vector3.new(1.2, 1, 1.2),
		CFrame = CFrame.new(0, -0.9, 0),
		Color = Color3.fromRGB(245, 158, 11),
		Material = Enum.Material.SmoothPlastic,
	})
	-- Positionslicht (blinkt, nachts gut sichtbar)
	local blink = localPart({
		Name = "NavBlink",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.45, 0.45, 0.45),
		CFrame = CFrame.new(0, 0.45, 0),
		Color = Color3.fromRGB(239, 68, 68),
		Material = Enum.Material.Neon,
	})
	blink.Parent = ensureFolder()
	table.insert(parts, blink)
	return parts
end

local function syncDrones()
	local want = math.clamp(math.floor(budget("Drones", 4) * density + 0.5), 0, MAX_DRONES)
	local cfgD = lifeCfg.Drones or {}
	while #drones > want do
		local drone = table.remove(drones) :: Drone
		destroyParts(drone.Parts)
	end
	while #drones < want do
		local index = #drones + 1
		local parts = assetOrRecipe("Drone", makeDrone)
		local u = (index * 0.6180339887) % 1
		local v = (index * 0.3819660113) % 1
		local minR, maxR = cfgD.MinRadius or 160, cfgD.MaxRadius or 700
		local angle = u * 2 * math.pi
		local dist = minR + v * (maxR - minR) * 0.6
		table.insert(drones, {
			Parts = parts,
			Offsets = offsetsOf(parts, CFrame.identity),
			Center = Vector3.new(dist * math.cos(angle), 0, dist * math.sin(angle)),
			Radius = 60 + v * 140,
			Height = (cfgD.MinHeight or 70) + u * ((cfgD.MaxHeight or 150) - (cfgD.MinHeight or 70)),
			Speed = cfgD.Speed or 26,
			Phase = u * 2 * math.pi,
		})
	end
end

local function updateDrones()
	local t = serverTime()
	table.clear(moveParts)
	table.clear(moveCFrames)
	for _, drone in ipairs(drones) do
		local w = drone.Speed / drone.Radius
		local a = drone.Phase + w * t
		local pos = drone.Center
			+ Vector3.new(
				drone.Radius * math.cos(a),
				drone.Height + math.sin(t * 1.3 + drone.Phase) * 2.5,
				drone.Radius * math.sin(a)
			)
		local tangent = Vector3.new(-math.sin(a), 0, math.cos(a))
		local cf = CFrame.lookAt(pos, pos + tangent) * CFrame.Angles(math.rad(-8), 0, 0)
		local blinkOn = (t * 1.2 + drone.Phase) % 1 < 0.18
		for i, part in ipairs(drone.Parts) do
			table.insert(moveParts, part)
			table.insert(moveCFrames, cf * drone.Offsets[i])
			if part.Name == "NavBlink" then
				local transparency = if blinkOn then 0 else 0.85
				if part.Transparency ~= transparency then
					part.Transparency = transparency
				end
			end
		end
	end
	if #moveParts > 0 then
		workspace:BulkMoveTo(moveParts, moveCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- ---------------------------------------------------------------------
-- 4) LUFTSCHIFF MIT ΛKYTEX-LOGO
-- ---------------------------------------------------------------------
local function logoText(): string
	for _, sign in ipairs(cityCfg.Signs or {}) do
		if sign.Key == "Logo" then
			return sign.Name
		end
	end
	return ctx.T("core.gameName")
end

local function makeBlimp(): { BasePart }
	local parts: { BasePart } = {}
	local function add(props: { [string]: any }): Part
		local part = localPart(props)
		part.Parent = ensureFolder()
		table.insert(parts, part)
		return part
	end
	local envelope = add({
		Size = Vector3.new(26, 22, 70),
		CFrame = CFrame.identity,
		Color = Color3.fromRGB(226, 230, 238),
		Material = Enum.Material.SmoothPlastic,
	})
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = envelope
	add({
		Size = Vector3.new(6, 3.4, 14),
		CFrame = CFrame.new(0, -12, -2),
		Color = Color3.fromRGB(26, 33, 48),
		Material = Enum.Material.Metal,
	})
	add({
		Size = Vector3.new(26.4, 0.6, 30),
		CFrame = CFrame.new(0, -2, 0),
		Color = Color3.fromRGB(79, 140, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.1,
	})
	for _, def in ipairs({
		{ CFrame.new(0, 7, 32), Vector3.new(0.6, 8, 8) },
		{ CFrame.new(0, -7, 32), Vector3.new(0.6, 8, 8) },
		{ CFrame.new(7, 0, 32), Vector3.new(8, 0.6, 8) },
		{ CFrame.new(-7, 0, 32), Vector3.new(8, 0.6, 8) },
	}) do
		add({
			Size = def[2],
			CFrame = def[1],
			Color = Color3.fromRGB(26, 33, 48),
			Material = Enum.Material.SmoothPlastic,
		})
	end
	for _, side in ipairs({ -1, 1 }) do
		local plate = add({
			Size = Vector3.new(0.2, 7, 26),
			CFrame = CFrame.new(side * 13.1, 3, -2),
			Color = Color3.fromRGB(11, 15, 23),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 1,
		})
		local gui = Instance.new("SurfaceGui")
		gui.Face = if side > 0 then Enum.NormalId.Right else Enum.NormalId.Left
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 20
		gui.LightInfluence = 0
		gui.Brightness = 2
		gui.MaxDistance = 2000
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Text = logoText()
		label.TextColor3 = Color3.fromRGB(110, 162, 242)
		label.TextScaled = true
		label.FontFace = Font.new("rbxasset://fonts/families/BuilderExtended.json", Enum.FontWeight.Bold)
		label.Parent = gui
		gui.Parent = plate
	end
	return parts
end

local function syncBlimp()
	local cfgB = lifeCfg.Blimp or {}
	local want = cfgB[tier()] ~= false
	if want and not blimp then
		local parts = assetOrRecipe("Blimp", makeBlimp)
		blimp = { Parts = parts, Offsets = offsetsOf(parts, CFrame.identity) }
	elseif not want and blimp then
		destroyParts(blimp.Parts)
		blimp = nil
	end
end

local function updateBlimp()
	local b = blimp
	if not b then
		return
	end
	local cfgB = lifeCfg.Blimp or {}
	local r = cfgB.Radius or 720
	local a = serverTime() * (cfgB.Speed or 11) / r
	local pos = Vector3.new(r * math.cos(a), (cfgB.Height or 270) + math.sin(a * 3) * 4, r * math.sin(a))
	local tangent = Vector3.new(-math.sin(a), 0, math.cos(a))
	local cf = CFrame.lookAt(pos, pos + tangent) -- Nase (-Z) in Flugrichtung, Leitwerke (+Z) hinten
	table.clear(moveParts)
	table.clear(moveCFrames)
	for i, part in ipairs(b.Parts) do
		table.insert(moveParts, part)
		table.insert(moveCFrames, cf * b.Offsets[i])
	end
	workspace:BulkMoveTo(moveParts, moveCFrames, Enum.BulkMoveMode.FireCFrameChanged)
end

-- ---------------------------------------------------------------------
-- 5) HOLOGRAMM-WERBETAFELN (fiktive Firmen, Live-Kurs aus dem Frame)
-- ---------------------------------------------------------------------
local function companyOf(i: number): any?
	local companies = ctx.Config.Companies
	local byId = type(companies) == "table" and companies.ById or nil
	return if type(byId) == "table" then byId[i] else nil
end

local function sectorColor(sector: string?): Color3
	local colors = ctx.Config.Colors and ctx.Config.Colors.Sectors
	if type(colors) == "table" and sector and typeof(colors[sector]) == "Color3" then
		return colors[sector]
	end
	return Color3.fromRGB(79, 140, 255)
end

local function makeBoard(def: any): Board?
	local company = companyOf(def.I)
	if not company then
		return nil
	end
	local color = sectorColor(company.Sector)
	local a = math.rad(def.Angle)
	local pos = Vector3.new(def.Radius * math.cos(a), def.Height, def.Radius * math.sin(a))
	local root = localPart({
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(pos),
		Transparency = 1,
	})
	root.Parent = ensureFolder()
	local ring = localPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.15, 14, 14),
		CFrame = CFrame.new(pos - Vector3.new(0, 6, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.25,
	})
	ring.Parent = ensureFolder()
	-- Hologramm-Projektor: Lichtkegel vom Ring zur Tafel + aufsteigende Funken (Partikel im Budget)
	local beamFrom = Instance.new("Attachment")
	beamFrom.Name = "HoloFrom"
	beamFrom.Parent = ring
	local beamTo = Instance.new("Attachment")
	beamTo.Name = "HoloTo"
	beamTo.Parent = root
	local cone = Instance.new("Beam")
	cone.Name = "HoloCone"
	cone.Attachment0 = beamFrom
	cone.Attachment1 = beamTo
	cone.Width0 = 12
	cone.Width1 = 17
	cone.FaceCamera = true
	cone.LightEmission = 1
	cone.LightInfluence = 0
	cone.Texture = "rbxasset://textures/gradient.png"
	cone.TextureMode = Enum.TextureMode.Stretch
	cone.Color = ColorSequence.new(color)
	cone.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.55),
		NumberSequenceKeypoint.new(1, 0.92),
	})
	cone.Segments = 2
	cone.Parent = ring
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "HoloSparks"
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color = ColorSequence.new(color)
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	sparks.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	sparks.Lifetime = NumberRange.new(1.2, 2)
	sparks.Speed = NumberRange.new(2, 4)
	sparks.SpreadAngle = Vector2.new(25, 25)
	sparks.Acceleration = Vector3.new(0, 1.5, 0)
	sparks.EmissionDirection = Enum.NormalId.Right -- Zylinder-Achse X = senkrecht
	sparks.Rate = math.floor(6 * budget("Particles", 0.6) + 0.5)
	sparks.Parent = ring
	local gui = Instance.new("BillboardGui")
	gui.Name = "Hologram"
	gui.Size = UDim2.fromScale(18, 8)
	gui.LightInfluence = 0
	gui.Brightness = 2
	gui.MaxDistance = 700
	gui.Adornee = root
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(11, 15, 23)
	frame.BackgroundTransparency = 0.45
	frame.BorderSizePixel = 0
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.12, 0)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 2
	stroke.Transparency = 0.2
	stroke.Parent = frame
	local ticker = Instance.new("TextLabel")
	ticker.BackgroundTransparency = 1
	ticker.Position = UDim2.fromScale(0.06, 0.06)
	ticker.Size = UDim2.fromScale(0.88, 0.48)
	ticker.FontFace = Font.new("rbxasset://fonts/families/BuilderExtended.json", Enum.FontWeight.Bold)
	ticker.Text = company.Ticker
	ticker.TextColor3 = color
	ticker.TextScaled = true
	ticker.Parent = frame
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Position = UDim2.fromScale(0.06, 0.56)
	name.Size = UDim2.fromScale(0.56, 0.36)
	name.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
	name.Text = company.Name
	name.TextColor3 = Color3.fromRGB(230, 236, 245)
	name.TextScaled = true
	name.TextXAlignment = Enum.TextXAlignment.Left
	name.Parent = frame
	local change = Instance.new("TextLabel")
	change.BackgroundTransparency = 1
	change.Position = UDim2.fromScale(0.62, 0.56)
	change.Size = UDim2.fromScale(0.32, 0.36)
	change.FontFace = Font.new("rbxasset://fonts/families/BuilderMono.json", Enum.FontWeight.Bold)
	change.Text = ""
	change.TextColor3 = Color3.fromRGB(170, 180, 195)
	change.TextScaled = true
	change.TextXAlignment = Enum.TextXAlignment.Right
	change.Parent = frame
	gui.Parent = root
	return {
		Root = root,
		Ring = ring,
		Gui = gui,
		Ticker = ticker,
		Change = change,
		I = def.I,
		Base = ring.CFrame,
		Angle = 0,
	}
end

local function syncBoards()
	local counts = lifeCfg.Billboards or {}
	local list = cityCfg.Billboards or {}
	local want = math.clamp(math.floor((counts[tier()] or 8) * math.min(1, density) + 0.5), 0, #list)
	while #boards > want do
		local board = table.remove(boards) :: Board
		board.Root:Destroy()
		board.Ring:Destroy()
	end
	while #boards < want do
		local def = list[#boards + 1]
		local board = makeBoard(def)
		if not board then
			break
		end
		table.insert(boards, board)
	end
end

local function refreshBoards()
	local lang = ctx.Lang_()
	for _, board in ipairs(boards) do
		local ok, _close, change = call("MarketClient", "Quote", board.I)
		if ok and type(change) == "number" then
			local okText, text = pcall(ctx.Format.Pct, change, lang, 2, true)
			local okArrow, arrow = call("UI", "TrendArrow", change)
			board.Change.Text = (if okArrow then tostring(arrow) .. " " else "") .. (if okText then text else "")
			local okColor, color = call("UI", "TrendColor", change)
			if okColor and typeof(color) == "Color3" then
				board.Change.TextColor3 = color
			end
		end
	end
end

local function spinBoards(dt: number)
	for _, board in ipairs(boards) do
		board.Angle = (board.Angle + dt * 0.6) % (2 * math.pi)
		board.Ring.CFrame = CFrame.new(board.Base.Position)
			* CFrame.Angles(0, board.Angle, 0)
			* CFrame.Angles(0, 0, math.pi / 2)
	end
end

-- ---------------------------------------------------------------------
-- 6) FIRMEN-LÄDEN: Spot + Mini-Ticker bei aktiver News
-- ---------------------------------------------------------------------
local function shopActive(i: number, seconds: number)
	local state = shopStates[i]
	if not state then
		return
	end
	state.Until = math.max(state.Until, serverTime() + seconds)
end

local function showShop(i: number, on: boolean)
	local state = shopStates[i]
	if not state or state.Shown == on then
		return
	end
	state.Shown = on
	local spot = spotParts[i]
	if spot and spot.Parent then
		local light = spot:FindFirstChildWhichIsA("SpotLight")
		if light then
			light.Enabled = on
		end
	end
	local front = shopFronts[i]
	if front and front.Parent then
		local gui = front:FindFirstChildWhichIsA("SurfaceGui")
		if gui then
			gui.Brightness = if on then 3.6 else 2.2
		end
	end
	if on then
		local slot = tickerSlots[i]
		local company = companyOf(i)
		if slot and slot.Parent and company then
			local monitor = localPart({
				Name = "ShopTickerLive",
				Size = slot.Size,
				CFrame = slot.CFrame,
				Color = Color3.fromRGB(11, 15, 23),
				Material = Enum.Material.SmoothPlastic,
			})
			monitor:SetAttribute("Monitor", company.Ticker) -- Modul Monitors zeichnet den Live-Chart
			monitor.Parent = ensureFolder()
			state.Monitor = monitor
		end
	else
		local monitor = state.Monitor
		state.Monitor = nil
		if monitor then
			monitor:Destroy()
		end
	end
end

local function checkShops()
	local t = serverTime()
	for i, state in pairs(shopStates) do
		local on = state.Until > t
		if on and state.Shown and (not state.Monitor or not state.Monitor.Parent) and tickerSlots[i] then
			state.Shown = false -- Platz neu hereingestreamt -> Ticker neu anlegen
		end
		showShop(i, on)
	end
end

local function considerWorld(inst: Instance)
	if not inst:IsA("BasePart") then
		return
	end
	local ticker = inst:GetAttribute("ShopTicker")
	if type(ticker) == "number" then
		tickerSlots[ticker] = inst
	end
	local spot = inst:GetAttribute("ShopSpot")
	if type(spot) == "number" then
		spotParts[spot] = inst
		local state = shopStates[spot]
		local light = inst:FindFirstChildWhichIsA("SpotLight")
		if light and state then
			light.Enabled = state.Shown
		end
	end
	local shop = inst:GetAttribute("Shop")
	if type(shop) == "number" then
		shopFronts[shop] = inst
	end
	local lamp = inst:GetAttribute("Signal")
	if type(lamp) == "string" and SIGNAL_LIT[lamp] then
		signals[inst] = { Lamp = lamp, Group = tonumber(inst:GetAttribute("SignalGroup")) or 0 }
	end
end

-- Ampeln an den Avenue-Einmündungen schalten (rein optisch, alle Clients gleich)
local function stepSignals()
	local t = serverTime()
	for part, info in pairs(signals) do
		if not part.Parent then
			signals[part] = nil
			continue
		end
		local phase = (t + info.Group / 12) % SIGNAL_CYCLE
		local active = if phase < 14 then "Green" elseif phase < 17 then "Amber" else "Red"
		local lit = info.Lamp == active
		local color = if lit then SIGNAL_LIT[info.Lamp] else SIGNAL_DIM[info.Lamp]
		if part.Color ~= color then
			part.Color = color
			part.Material = if lit then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
	end
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API
-- ---------------------------------------------------------------------
local function syncAll()
	syncTraffic()
	syncDrones()
	syncBlimp()
	syncBoards()
end

function CityLife.SetDensity(mult: number)
	if type(mult) ~= "number" or mult ~= mult then
		return
	end
	density = math.clamp(mult, 0, 2)
	syncAll()
end

function CityLife.Counts(): { [string]: number }
	return { Traffic = #traffic, Drones = #drones, Billboards = #boards }
end

function CityLife.Frame(dt: number)
	updateTraffic()
	updateDrones()
	updateBlimp()
	spinBoards(dt)
	shopAccum += dt
	if shopAccum >= SHOP_CHECK then
		shopAccum = 0
		checkShops()
	end
	boardAccum += dt
	if boardAccum >= BOARD_REFRESH then
		boardAccum = 0
		refreshBoards()
	end
	signalAccum += dt
	if signalAccum >= 1 / SIGNAL_HZ then
		signalAccum = 0
		stepSignals()
	end
end

function CityLife.Init(context: any)
	ctx = context
	cityCfg = ctx.Config.City or {}
	lifeCfg = cityCfg.Life or {}
	local assetModule = ReplicatedStorage:FindFirstChild("Shared")
		and ReplicatedStorage.Shared:FindFirstChild("AssetSlot")
	if assetModule and assetModule:IsA("ModuleScript") then
		local ok, result = pcall(require, assetModule)
		AssetSlot = if ok then result else nil
	end
	for _, def in ipairs(cityCfg.Lanes or {}) do
		local lane = buildLane(def)
		if lane then
			table.insert(lanes, lane)
			table.insert(laneWeights, lane.Length)
		end
	end
	for instId in pairs(cityCfg.Shops or {}) do
		shopStates[instId] = { Until = 0, Shown = false, Monitor = nil }
	end
	local newsSeconds = cityCfg.ShopNewsSeconds or 120
	local hooks = ctx.Hooks
	hooks.On("Market:News", function(news: any)
		if type(news) == "table" and type(news.I) == "number" then
			shopActive(news.I, newsSeconds)
		end
	end)
	hooks.On("Quotes", function(frame: any)
		if type(frame) ~= "table" or type(frame.Rows) ~= "table" then
			return
		end
		for _, row in ipairs(frame.Rows) do
			if shopStates[row.Id] and bit32.band(row.Flags or 0, 2) ~= 0 then -- QuoteCodec.ROW_FLAGS.News
				shopActive(row.Id, 3)
			end
		end
	end)
	hooks.On("Quality", function()
		syncAll()
	end)
end

function CityLife.Start()
	syncAll()
	workspace.DescendantAdded:Connect(considerWorld)
	task.spawn(function()
		local ok, list = pcall(function()
			return workspace:GetDescendants()
		end)
		if ok and type(list) == "table" then
			for index, inst in ipairs(list) do
				considerWorld(inst)
				if index % 2000 == 0 then
					task.wait()
				end
			end
		end
	end)
end

return CityLife
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">Controls</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Eingabe-Belegung über ContextActionService (Client/Modules/Controls)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §C7.5. Basis: CC-Controls (CAS-Motor, REUSE §3.18).
--
--  Alle Tasten/Knöpfe aus Config.Client.Keys (PC) und Config.Client.Gamepad laufen über
--  ContextActionService:BindActionAtPriority (createTouchButton = false). Eigene Touch-Knöpfe
--  (Modul TouchControls) speisen dieselben Aktionen über Controls.Emit ein. Andere Module hören
--  NUR hier zu – egal ob Maus, Controller oder Touch.
--
--  Öffentliche API (§C7.5):
--    Controls.Bind(action, fn(state, input?), priority?): () -> ()    state "Begin" | "End" | "Change"
--    Controls.IsDown(action): boolean
--    Controls.Input(): "KBM" | "Gamepad" | "Touch"                    folgt UserInputService.PreferredInput (live)
--    Controls.SetContext(c)   "World" | "Vehicle" | "Terminal" | "Menu" | "Spectate"
--  Zusätzlich: Controls.Context(): string (wirksamer Kontext), Controls.Emit(action, state, source?) (virtuelle Eingabe),
--    Controls.Init(ctx), Controls.Start()
--  Aktionen: Interact, Terminal, Tower, Shop, Quests, Menu, Sprint, Boost, Handbrake, ChartTf, ChartType, React,
--    AdminPanel, Fly, Spectate, Debug, PhotoMode.
--  Kontext-Regeln: Terminal-Fenster offen -> "Terminal"; anderes Fenster offen -> "Menu"; Auto -> "Vehicle"
--  (Hooks "Vehicle:Enter"/"Vehicle:Exit"). Interact wird nie verschluckt (ProximityPrompts bleiben bedienbar).
--  Sprinten ist hier eingebaut (WalkSpeed aus Config.Client.Movement, fremde Werte – z. B. Admin-Speed – bleiben).
--  Hook "Input"(kind) bei jedem Wechsel der Eingabe-Art.
-- =====================================================================

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Controls = {}

type State = "Begin" | "End" | "Change"
type Listener = { Fn: (State, InputObject?) -> (), Priority: number, Order: number, Alive: boolean }

local player = Players.LocalPlayer

local ACTIONS = {
	"Interact",
	"Terminal",
	"Tower",
	"Shop",
	"Quests",
	"Menu",
	"Sprint",
	"Boost",
	"Handbrake",
	"ChartTf",
	"ChartType",
	"React",
	"AdminPanel",
	"Fly",
	"Spectate",
	"Debug",
	"PhotoMode",
}

local function set(list: { string }): { [string]: boolean }
	local result: { [string]: boolean } = {}
	for _, name in ipairs(list) do
		result[name] = true
	end
	return result
end

-- Welche Aktionen in welchem Kontext wirken (alles andere wird an Roblox weitergereicht)
local ALWAYS = { "Menu", "AdminPanel", "Fly", "Spectate", "Debug", "PhotoMode" }
local function withAlways(list: { string }): { [string]: boolean }
	local result = set(list)
	for _, name in ipairs(ALWAYS) do
		result[name] = true
	end
	return result
end

local CONTEXT_ACTIONS: { [string]: { [string]: boolean } } = {
	World = withAlways({ "Interact", "Terminal", "Tower", "Shop", "Quests", "Sprint", "React" }),
	Vehicle = withAlways({ "Interact", "Terminal", "Tower", "Shop", "Quests", "Boost", "Handbrake" }),
	Terminal = withAlways({ "Terminal", "ChartTf", "ChartType" }),
	Menu = withAlways({ "Terminal", "Tower", "Shop", "Quests" }),
	Spectate = withAlways({}),
}
-- Diese Aktionen "verschlucken" die Eingabe in ihrem Kontext (Leertaste = Handbremse statt Aussteigen,
-- Shift = Sprint/Boost statt Shift-Lock links; ProximityPrompts (Interact) werden nie verschluckt)
local SINK: { [string]: { [string]: boolean } } = {
	World = { Sprint = true },
	Vehicle = { Boost = true, Handbrake = true },
	Terminal = { ChartTf = true, ChartType = true },
}

local BASE_PRIORITY = Enum.ContextActionPriority.High.Value

local ctx: any = nil
local listeners: { [string]: { Listener } } = {}
local listenerOrder = 0
local held: { [string]: { [string]: boolean } } = {} -- [action][quelle] = true
local downState: { [string]: boolean } = {}
local baseContext = "World"
local lastEffective = "World"
local inVehicle = false
local inputKind: "KBM" | "Gamepad" | "Touch" = "KBM"

-- Sprinten (eingebaut)
local sprintApplied: number? = nil -- zuletzt von uns gesetzte WalkSpeed (nur die setzen wir zurück)

-- ---------------------------------------------------------------------
-- KONTEXT
-- ---------------------------------------------------------------------
local function windows(): any
	return ctx and ctx.Windows
end

local function terminalOpen(): boolean
	local w = windows()
	if w and type(w.IsOpen) == "function" then
		local ok, open = pcall(w.IsOpen, "Terminal")
		return ok and open == true
	end
	return false
end

local function anyWindowOpen(): boolean
	local ui = ctx and ctx.UI
	if ui and type(ui.IsAnyWindowOpen) == "function" then
		local ok, open = pcall(ui.IsAnyWindowOpen)
		return ok and open == true
	end
	return false
end

function Controls.Context(): string
	if baseContext == "Spectate" then
		return "Spectate"
	end
	if baseContext == "Terminal" or terminalOpen() then
		return "Terminal"
	end
	if baseContext == "Menu" or anyWindowOpen() then
		return "Menu"
	end
	if inVehicle or baseContext == "Vehicle" then
		return "Vehicle"
	end
	return "World"
end

local function allowed(action: string, context: string?): boolean
	local actions = CONTEXT_ACTIONS[context or Controls.Context()]
	return actions ~= nil and actions[action] == true
end

local function dispatch(action: string, state: State, input: InputObject?)
	local list = listeners[action]
	if not list or #list == 0 then
		return
	end
	local snapshot = table.clone(list)
	for _, entry in ipairs(snapshot) do
		if entry.Alive then
			local ok, err = pcall(entry.Fn, state, input)
			if not ok then
				warn(("[Controls] Fehler in %s-Listener: %s"):format(action, tostring(err)))
			end
		end
	end
end

-- Quelle drückt/lässt los -> Begin/End nur beim Wechsel des Gesamtzustands
local function setHeld(action: string, source: string, down: boolean, input: InputObject?)
	local sources = held[action]
	if not sources then
		sources = {}
		held[action] = sources
	end
	if down then
		sources[source] = true
	else
		sources[source] = nil
	end
	local isDown = next(sources) ~= nil
	if isDown ~= (downState[action] == true) then
		downState[action] = isDown
		dispatch(action, if isDown then "Begin" else "End", input)
	end
end

-- Kontextwechsel: Aktionen, die jetzt gesperrt sind, sauber loslassen (nichts bleibt "hängen")
local function releaseBlocked()
	local effective = Controls.Context()
	if effective == lastEffective then
		return
	end
	lastEffective = effective
	for action, isDown in pairs(downState) do
		if isDown and not allowed(action, effective) then
			held[action] = {}
			downState[action] = false
			dispatch(action, "End", nil)
		end
	end
end

function Controls.SetContext(c: string)
	if CONTEXT_ACTIONS[c] == nil then
		warn("[Controls] Unbekannter Kontext: " .. tostring(c))
		return
	end
	baseContext = c
	releaseBlocked()
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH: Bind / IsDown / Emit / Input
-- ---------------------------------------------------------------------
function Controls.Bind(action: string, fn: (State, InputObject?) -> (), priority: number?): () -> ()
	if type(action) ~= "string" or type(fn) ~= "function" then
		warn("[Controls] Bind: Aktion (string) und Funktion erwartet")
		return function() end
	end
	local list = listeners[action]
	if not list then
		list = {}
		listeners[action] = list
	end
	listenerOrder += 1
	local entry: Listener = { Fn = fn, Priority = priority or 0, Order = listenerOrder, Alive = true }
	table.insert(list, entry)
	-- höhere Priorität zuerst, bei Gleichstand der zuerst angemeldete
	table.sort(list, function(a, b)
		if a.Priority ~= b.Priority then
			return a.Priority > b.Priority
		end
		return a.Order < b.Order
	end)
	return function()
		if not entry.Alive then
			return
		end
		entry.Alive = false
		local current = listeners[action]
		if current then
			local index = table.find(current, entry)
			if index then
				table.remove(current, index)
			end
		end
	end
end

function Controls.IsDown(action: string): boolean
	return downState[action] == true
end

function Controls.Input(): "KBM" | "Gamepad" | "Touch"
	return inputKind
end

-- Virtuelle Eingabe (Touch-Knöpfe, automatisches Sprinten am Stick): gleiche Regeln wie echte Tasten
function Controls.Emit(action: string, state: State, source: string?)
	if type(action) ~= "string" then
		return
	end
	local key = "virtual:" .. (source or "touch")
	if state == "Begin" then
		if allowed(action) then
			setHeld(action, key, true, nil)
		end
	elseif state == "End" then
		setHeld(action, key, false, nil)
	elseif state == "Change" and allowed(action) then
		dispatch(action, "Change", nil)
	end
end

-- ---------------------------------------------------------------------
-- CONTEXTACTIONSERVICE
-- ---------------------------------------------------------------------
local function enumFromName(name: string): (Enum.KeyCode | Enum.UserInputType)?
	local key = Enum.KeyCode:FromName(name)
	if key then
		return key
	end
	return Enum.UserInputType:FromName(name)
end

local function sourceOf(input: InputObject): string
	if input.KeyCode.Name ~= "Unknown" then
		return input.KeyCode.Name
	end
	return input.UserInputType.Name
end

local function typingInTextBox(): boolean
	return UserInputService:GetFocusedTextBox() ~= nil
end

local function handle(action: string, inputState: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
	local source = sourceOf(input)
	local ending = inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel
	if typingInTextBox() then
		-- beim Tippen keine Aktionen auslösen – aber Loslassen trotzdem zählen (sonst klebt z. B. Sprint, wenn man
		-- Shift hält, ins Chat-/Betragsfeld klickt und dort loslässt)
		if ending then
			setHeld(action, source, false, input)
		end
		return Enum.ContextActionResult.Pass
	end
	local context = Controls.Context()
	-- In Fenstern navigiert das Steuerkreuz die Oberfläche (GuiService) – dort keine Fenster-Kürzel vom D-Pad
	local dpadInMenu = context == "Menu" and string.sub(input.KeyCode.Name, 1, 4) == "DPad"
	if dpadInMenu or not allowed(action, context) then
		-- gesperrt: evtl. gehaltene Quelle trotzdem loslassen
		if ending then
			setHeld(action, source, false, input)
		end
		return Enum.ContextActionResult.Pass
	end
	local sinks = SINK[context]
	local result = if sinks and sinks[action] then Enum.ContextActionResult.Sink else Enum.ContextActionResult.Pass
	if inputState == Enum.UserInputState.Begin then
		setHeld(action, source, true, input)
	elseif ending then
		setHeld(action, source, false, input)
	elseif inputState == Enum.UserInputState.Change then
		dispatch(action, "Change", input)
	end
	return result
end

local function bindAll()
	local config = ctx.Config
	local client = config and config.Client or {}
	local keys: { [string]: { string } } = client.Keys or {}
	local pad: { [string]: any } = client.Gamepad or {}
	for index, action in ipairs(ACTIONS) do
		local inputs: { Enum.KeyCode | Enum.UserInputType } = {}
		local seen: { [string]: boolean } = {}
		local function add(name: any)
			if type(name) ~= "string" or seen[name] then
				return
			end
			local value = enumFromName(name)
			if value then
				seen[name] = true
				table.insert(inputs, value)
			end
		end
		for _, name in ipairs(keys[action] or {}) do
			add(name)
		end
		local padValue = pad[action]
		if type(padValue) == "table" then
			for _, name in ipairs(padValue) do
				add(name)
			end
		else
			add(padValue)
		end
		if #inputs > 0 then
			-- spätere Aktionen leicht niedriger (gleiche Taste: der nicht erlaubte Eintrag reicht weiter)
			local priority = BASE_PRIORITY + (#ACTIONS - index)
			ContextActionService:BindActionAtPriority("AT_" .. action, function(_, state, input)
				return handle(action, state, input)
			end, false, priority, table.unpack(inputs))
		end
	end
end

-- ---------------------------------------------------------------------
-- SPRINTEN (eingebaut): Lauf-Geschwindigkeit nur dann setzen/zurücksetzen, wenn niemand anderes sie geändert hat
-- ---------------------------------------------------------------------
local function movement(): (number, number)
	local config = ctx and ctx.Config
	local move = config and config.Client and config.Client.Movement
	local walk = move and tonumber(move.WalkSpeed) or 16
	local sprint = move and tonumber(move.SprintSpeed) or 24
	return walk, math.max(walk, sprint)
end

local function humanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function applySprint(on: boolean)
	local hum = humanoid()
	if not hum then
		sprintApplied = nil
		return
	end
	local walk, sprint = movement()
	if on then
		-- nur von der normalen Geschwindigkeit aus (Admin-Speed, Jetpack o. Ä. bleiben unberührt)
		if math.abs(hum.WalkSpeed - walk) < 0.01 then
			hum.WalkSpeed = sprint
			sprintApplied = sprint
		end
	else
		if sprintApplied and math.abs(hum.WalkSpeed - sprintApplied) < 0.01 then
			hum.WalkSpeed = walk
		end
		sprintApplied = nil
	end
end

-- ---------------------------------------------------------------------
-- EINGABE-ART (Maus/Tastatur, Controller, Touch) – live
-- ---------------------------------------------------------------------
local function computeInput(): "KBM" | "Gamepad" | "Touch"
	local ok, preferred = pcall(function()
		return UserInputService.PreferredInput
	end)
	if ok and preferred then
		if preferred == Enum.PreferredInput.Touch then
			return "Touch"
		elseif preferred == Enum.PreferredInput.Gamepad or preferred == Enum.PreferredInput.MicroGamepad then
			return "Gamepad"
		end
		return "KBM"
	end
	-- Rückfall: letzte Eingabe
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "Touch"
	elseif string.sub(last.Name, 1, 7) == "Gamepad" then
		return "Gamepad"
	end
	return "KBM"
end

local function updateInput(force: boolean?)
	local kind = computeInput()
	if kind ~= inputKind or force then
		inputKind = kind
		ctx.Hooks.Fire("Input", kind)
	end
end

local function releaseAll()
	for action, isDown in pairs(downState) do
		if isDown then
			held[action] = {}
			downState[action] = false
			dispatch(action, "End", nil)
		end
	end
end

function Controls.Init(context: any)
	ctx = context
	inputKind = computeInput()
	local hooks = ctx.Hooks
	hooks.On("WindowOpened", releaseBlocked)
	hooks.On("WindowClosed", releaseBlocked)
	-- Auto (WP7 Vehicles feuert die Hooks): Kontext "Vehicle"
	hooks.On("Vehicle:Enter", function()
		inVehicle = true
		releaseBlocked()
	end)
	hooks.On("Vehicle:Exit", function()
		inVehicle = false
		releaseBlocked()
	end)
	-- eingebautes Sprinten (andere Module können zusätzlich auf "Sprint" hören)
	Controls.Bind("Sprint", function(state)
		if state == "Begin" then
			applySprint(true)
		elseif state == "End" then
			applySprint(false)
		end
	end, -100)
end

function Controls.Start()
	bindAll()
	UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(function()
		updateInput(false)
	end)
	-- Rückfall, falls PreferredInput auf einem Gerät nicht wechselt
	UserInputService.LastInputTypeChanged:Connect(function()
		updateInput(false)
	end)
	updateInput(true)
	-- neuer Charakter: nichts darf gedrückt bleiben (auch kein Sprint-Rest)
	player.CharacterAdded:Connect(function()
		sprintApplied = nil
		releaseAll()
	end)
	-- Fenster verlieren den Fokus (Alt-Tab): gehaltene Tasten lösen
	UserInputService.WindowFocusReleased:Connect(releaseAll)
end

return Controls
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">DebugOverlay</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Debug-Anzeige F8 (Client/Modules/DebugOverlay)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Vertrag: DESIGN.md §C16 (DebugOverlay-Werte), §B15.2 (Tab Debug),
--  REUSE §1.4 (CC-DebugOverlay ADAPT: Glas-Karte, Abfrage 1×/s nur solange sichtbar, Scheduler-Statistik + teuerste
--  Takte, Speicher, FPS/Ping, Ersatz-Farben falls das UI-Kit fehlt – REUSE §7 #38; Arena/Bots/Projektile ersetzt).
--  Nur für den Besitzer (Modul lädt nur bei IsAdmin; der Server prüft "ServerInfo" trotzdem erneut).
--  Zeigt (§C16): Markt-Tick-ms, Frames/s, Teilezahl (Server: Stadt + Tower), Live-Monitore, Scheduler-Top-5,
--  Speicher (Server + Client), Ping – dazu Quotes/s, Frame-Größe, Bus-Status, Tower, offene Pickups, Grafikstufe.
--  Look: Glas-Karte (Surface, 1-px-Rahmen, Ecke 12), Titel Michroma + Akzent-Strich, Werte BuilderMono/RobotoMono.
--
--  Öffentliche API (§C7.5):
--    DebugOverlay.Toggle()
--    DebugOverlay.Init(ctx) / DebugOverlay.Start()
-- =====================================================================

local Players = game:GetService("Players")
local Stats = game:GetService("Stats")
local UserInputService = game:GetService("UserInputService")

local DebugOverlay = {}

local player = Players.LocalPlayer
local ctx: any = nil

local POLL_SECONDS = 1
-- AKYTEX-Farben als Ersatz, falls das UI-Kit fehlt (sonst UI.Theme)
local FALLBACK_THEME = {
	Surface = Color3.fromRGB(18, 24, 36),
	Border = Color3.fromRGB(31, 41, 55),
	Text = Color3.fromRGB(230, 236, 245),
	Text2 = Color3.fromRGB(170, 180, 195),
	Accent = Color3.fromRGB(79, 140, 255),
	Up = Color3.fromRGB(34, 197, 94),
	Warn = Color3.fromRGB(234, 179, 8),
	Down = Color3.fromRGB(239, 68, 68),
}

local visible = false
local hiddenByPhoto = false
local frame: Frame? = nil
local lines: TextLabel? = nil
local titleLabel: TextLabel? = nil
local statusDot: Frame? = nil
local pollToken = 0
local lastInfo: { [string]: any }? = nil
local lastAt = 0

local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function module(name: string): any
	local modules = ctx and ctx.Modules
	return if type(modules) == "table" then modules[name] else nil
end

local function formatTime(seconds: number): string
	local util = ctx and ctx.Util
	if util and type(util.FormatTime) == "function" then
		local ok, text = pcall(util.FormatTime, seconds)
		if ok and type(text) == "string" then
			return text
		end
	end
	return ("%ds"):format(math.floor(seconds))
end

local function theme(): { [string]: Color3 }
	local ui = ctx and ctx.UI
	local t = ui and ui.Theme
	return if type(t) == "table" then t else FALLBACK_THEME
end

local function color(key: string): Color3
	local th = theme()
	local value = th[key]
	return if typeof(value) == "Color3" then value else (FALLBACK_THEME :: any)[key]
end

local function build()
	if frame then
		return
	end
	local parent = ctx and ctx.Gui
	if typeof(parent) ~= "Instance" then
		return
	end
	local box = Instance.new("Frame")
	box.Name = "AT_DebugOverlay"
	box.Position = UDim2.fromOffset(12, 140)
	box.Size = UDim2.fromOffset(440, 0)
	box.AutomaticSize = Enum.AutomaticSize.Y
	box.BackgroundColor3 = color("Surface")
	box.BackgroundTransparency = 0.1
	box.BorderSizePixel = 0
	box.ZIndex = 50
	box.Visible = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = box
	local stroke = Instance.new("UIStroke")
	stroke.Color = color("Border")
	stroke.Thickness = 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = box
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 12)
	pad.Parent = box
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)
	layout.Parent = box
	local head = Instance.new("Frame")
	head.Name = "Head"
	head.BackgroundTransparency = 1
	head.Size = UDim2.new(1, 0, 0, 18)
	head.LayoutOrder = 1
	head.ZIndex = 51
	head.Parent = box
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, -20, 1, 0)
	title.Font = Enum.Font.Michroma
	title.TextSize = 13
	title.TextColor3 = color("Text")
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = T("admin.dbgTitle")
	title.ZIndex = 51
	title.Parent = head
	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.AnchorPoint = Vector2.new(1, 0.5)
	dot.Position = UDim2.new(1, 0, 0.5, 0)
	dot.Size = UDim2.fromOffset(8, 8)
	dot.BackgroundColor3 = color("Up")
	dot.BorderSizePixel = 0
	dot.ZIndex = 51
	dot.Parent = head
	local dotCorner = Instance.new("UICorner")
	dotCorner.CornerRadius = UDim.new(0.5, 0)
	dotCorner.Parent = dot
	local underline = Instance.new("Frame")
	underline.Name = "Underline"
	underline.Size = UDim2.fromOffset(24, 2)
	underline.BackgroundColor3 = color("Accent")
	underline.BorderSizePixel = 0
	underline.LayoutOrder = 2
	underline.ZIndex = 51
	underline.Parent = box
	local label = Instance.new("TextLabel")
	label.Name = "Lines"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.Font = Enum.Font.RobotoMono
	label.TextSize = 13
	label.LineHeight = 1.1
	label.TextColor3 = color("Text2")
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.TextWrapped = true
	label.RichText = false
	label.Text = ""
	label.LayoutOrder = 3
	label.ZIndex = 51
	label.Parent = box
	box.Parent = parent
	frame = box
	lines = label
	titleLabel = title
	statusDot = dot
end

local function clientFps(): number
	local fps = ctx and ctx.Fps
	return if type(fps) == "number" and fps == fps then fps else 60
end

local function render()
	if not lines then
		return
	end
	local out: { string } = {}
	if titleLabel then
		titleLabel.Text = T("admin.dbgTitle")
	end
	local info = lastInfo
	if info then
		table.insert(out, T("admin.dbgHeartbeat", tonumber(info.HeartbeatMs) or 0, tonumber(info.HeartbeatMaxMs) or 0))
		table.insert(
			out,
			T(
				"admin.dbgMarket",
				tonumber(info.MarketTickMs) or 0,
				tonumber(info.Instruments) or 0,
				tonumber(info.FrameBytes) or 0,
				T(if info.BusOk then "admin.on" else "admin.off")
			)
		)
		if type(info.Jobs) == "table" then
			for _, job in ipairs(info.Jobs) do
				if type(job) == "table" then
					table.insert(
						out,
						("  %-22s %5.2f / %5.2f ms"):format(
							string.sub(tostring(job.Name), 1, 22),
							tonumber(job.AvgMs) or 0,
							tonumber(job.MaxMs) or 0
						)
					)
				end
			end
		end
		table.insert(
			out,
			T(
				"admin.dbgCounts",
				tonumber(info.Players) or 0,
				tonumber(info.Towers) or 0,
				tonumber(info.Parts) or 0,
				tonumber(info.Pickups) or 0
			)
		)
		table.insert(out, T("admin.dbgMem", tonumber(info.MemoryMb) or 0, formatTime(tonumber(info.Uptime) or 0)))
	else
		table.insert(out, T("core.loading"))
	end
	-- Client-Seite
	local live, guis, monitors = 0, 0, 0
	local monitorModule = module("Monitors")
	if monitorModule and type(monitorModule.Count) == "function" then
		local ok, a, b, c = pcall(monitorModule.Count)
		if ok then
			live, guis, monitors = tonumber(a) or 0, tonumber(b) or 0, tonumber(c) or 0
		end
	end
	table.insert(out, T("admin.dbgMonitors", live, monitors, guis))
	local okMem, clientMem = pcall(function()
		return Stats:GetTotalMemoryUsageMb()
	end)
	local tier = "?"
	local quality = module("Quality")
	if quality and type(quality.Tier) == "function" then
		local ok, value = pcall(quality.Tier)
		if ok and type(value) == "string" then
			tier = value
		end
	end
	table.insert(
		out,
		T(
			"admin.dbgClient",
			math.floor(clientFps() + 0.5),
			tonumber(player:GetAttribute("PingMs")) or 0,
			if okMem and type(clientMem) == "number" then math.floor(clientMem) else 0,
			tier
		)
	)
	lines.Text = table.concat(out, "\n")
	local dot = statusDot
	if dot then
		local stale = os.clock() - lastAt > POLL_SECONDS * 3
		local heavy = info ~= nil and (tonumber(info.HeartbeatMs) or 0) > 3
		dot.BackgroundColor3 = if stale then color("Down") elseif heavy then color("Warn") else color("Up")
	end
end

local function poll(token: number)
	-- Abfrage-Schleife nur solange sichtbar; endet sofort bei Ausblenden (Token)
	while visible and token == pollToken do
		local remotes = ctx and ctx.Remotes
		local admin = remotes and remotes.Admin
		if admin and admin:IsA("RemoteFunction") then
			local ok, result = pcall(function()
				return admin:InvokeServer("ServerInfo", {})
			end)
			if ok and type(result) == "table" and result.Ok and type(result.Data) == "table" then
				lastInfo = result.Data
				lastAt = os.clock()
			end
		end
		if not visible or token ~= pollToken then
			break
		end
		render()
		task.wait(POLL_SECONDS)
	end
end

local function applyVisible()
	build()
	if frame then
		frame.Visible = visible and not hiddenByPhoto
	end
end

function DebugOverlay.Toggle()
	if player:GetAttribute("IsAdmin") ~= true then
		return
	end
	visible = not visible
	pollToken += 1
	applyVisible()
	if visible then
		render()
		task.spawn(poll, pollToken)
	end
end

function DebugOverlay.Init(context: any)
	ctx = context
end

function DebugOverlay.Start()
	local controls = module("Controls")
	local bound = false
	if controls and type(controls.Bind) == "function" then
		bound = pcall(controls.Bind, "Debug", function(state: string)
			if state == "Begin" then
				DebugOverlay.Toggle()
			end
		end)
	end
	if not bound then
		local key = Enum.KeyCode.F8
		local keys = ctx and ctx.Config and ctx.Config.Client and ctx.Config.Client.Keys
		if keys and type(keys.Debug) == "table" and type(keys.Debug[1]) == "string" then
			local ok, code = pcall(function()
				return (Enum.KeyCode :: any)[keys.Debug[1]]
			end)
			if ok and typeof(code) == "EnumItem" then
				key = code :: any
			end
		end
		UserInputService.InputBegan:Connect(function(input, processed)
			-- F8 wird nie von Roblox-Menüs "verbraucht"; andere Tasten nur, wenn kein Textfeld/Menü sie nimmt
			if input.KeyCode ~= key or UserInputService:GetFocusedTextBox() then
				return
			end
			if processed and key ~= Enum.KeyCode.F8 then
				return
			end
			DebugOverlay.Toggle()
		end)
	end
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		hooks.On("PhotoMode", function(on: any)
			hiddenByPhoto = on == true
			applyVisible()
		end)
	end
end

return DebugOverlay
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">DepotView</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Depot-Ansichten: Positionen, Orders, Alarme, Übersicht mit Gewinn-Transfer, Bots, Performance
--  (Client/Modules/DepotView)
--  Besitzer: WP5 (Charts, Terminal, Markt-UI). Vertrag: DESIGN.md §B7.1 (Tabs Positionen/Orders/Alarme), §B8.1–§B8.5
--  (Basis, Gewinn-Transfer „Verfügbar 1.240 AKY → 49.600 CR (Bau-Kurs 40)“, Starthilfe, Strategie-Bots), §B7.2 (Profi:
--  Performance-Analyse TWR/Drawdown/Skill-Score), §C9 (TradeCancel, TradeModify, AlertRemove, BotSet, BotToggle,
--  TradeRefill, DepotHistory, TowerTransfer), §C10 (State Depot, League).
--
--  Das Terminal hängt die Ansichten in seine Tabs (DepotView.Mount(parent, section)). Alle Zahlen live: Depotwert und
--  G/V aus dem letzten Frame (Geldkurse), Rest aus State "Depot"/"League". Zeilen sind gepoolt (kein Neuaufbau je Tick),
--  Texte werden nur bei Änderung geschrieben. Geld fließt nur AKY -> CR (Gewinn-Transfer über den Turm, §0.4);
--  die CR-Zahl ist eine Vorschau: floor(Abhebbar × Bau-Kurs / 100) – gebucht wird serverseitig.
--
--  Öffentliche API (WP5-intern):
--    DepotView.Mount(parent, section): { Frame, Refresh, Destroy }
--      section "Positions" | "Orders" | "Alerts" | "Overview" | "Bots" | "Performance"
--    DepotView.Open(section?)                    öffnet das Terminal auf dem Depot-Tab
--    DepotView.Nav(): number                     Depotwert live (Cent)
--    DepotView.Free(): number                    freies Geld (Cash − Reservierungen offener Kauf-Orders)
--    DepotView.Position(i): (qty, avgCents, freeQty)
--    DepotView.Init(ctx), DepotView.Start()
-- =====================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent:WaitForChild("UI"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PortfolioMath = require(Shared:WaitForChild("Market"):WaitForChild("PortfolioMath"))

local DepotView = {}

type View = {
	Section: string,
	Frame: ScrollingFrame,
	Alive: boolean,
	Rows: { any },
	Parts: { [string]: any },
	Update: (View) -> (),
}

local Theme = UI.Theme
local ROW_H = 52
local REFRESH_GAP = 0.25
local HISTORY_GAP = 10
local MAX_FILL_ROWS = 10

local ctx: any = nil
local views: { View } = {}
local pending = false
local history: { Fills: { any }, Nav: { any } }? = nil
local historyAt = -math.huge
local historyBusy = false

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function lang(): string
	return ctx.Lang_()
end

local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function call(name: string, fnName: string, ...: any): (boolean, any, any, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil, nil, nil
	end
	return pcall(fn, ...)
end

local function num(v: any, fallback: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else fallback
end

local function depot(): { [string]: any }
	local d = ctx.State.Depot
	return if type(d) == "table" then d else {}
end

local function league(): { [string]: any }
	local l = ctx.State.League
	return if type(l) == "table" then l else {}
end

local function aky(cents: number, compact: boolean?): string
	local ok, text = pcall(ctx.Format.Aky, cents, lang(), compact)
	return if ok then text else tostring(math.floor(cents / 100))
end

local function price(cents: number): string
	local ok, text = pcall(ctx.Format.Price, cents, lang())
	return if ok then text else string.format("%.2f", cents / 100)
end

-- Zahl aus Freitext lesen – DE "1.234,56" und EN "1,234.56" ergeben beide 1234.56
local function parseNumber(text: string): number?
	local raw = string.gsub(text or "", "[^%d,%.]", "")
	if raw == "" then
		return nil
	end
	local lastComma = string.find(raw, ",[^,]*$")
	local lastDot = string.find(raw, "%.[^%.]*$")
	if lastComma and (not lastDot or lastComma > lastDot) then
		raw = string.gsub(raw, "%.", "")
		raw = string.gsub(raw, ",", ".")
	else
		raw = string.gsub(raw, ",", "")
	end
	local n = tonumber(raw)
	if n and n == n and n < 1e12 then
		return n
	end
	return nil
end

-- Dezimalzahl in Landesschreibweise (DE mit Komma)
local function decimal(v: number, places: number): string
	local text = string.format("%." .. places .. "f", v)
	if lang() == "de" then
		text = (string.gsub(text, "%.", ","))
	end
	return text
end

local function pct(fraction: number, digits: number?): string
	local ok, text = pcall(ctx.Format.Pct, fraction, lang(), digits or 2, true)
	return if ok then text else string.format("%+.2f %%", fraction * 100)
end

local function credits(n: number): string
	local ok, text = pcall(ctx.Format.Credits, n, lang())
	return if ok then text else tostring(math.floor(n))
end

local function setText(label: TextLabel, text: string)
	if label.Text ~= text then
		label.Text = text
	end
end

local function instOf(i: number): any
	local ok, inst = call("MarketClient", "Instrument", i)
	return if ok then inst else nil
end

local function tickerOf(i: number): string
	local inst = instOf(i)
	return if type(inst) == "table" then inst.Ticker else ("#" .. tostring(i))
end

local function bidOf(i: number): number?
	local ok, bid = call("MarketClient", "BidAsk", i)
	if ok and type(bid) == "number" then
		return bid
	end
	return nil
end

local function licenceDef(): { [string]: any }
	local ok, def = call("MarketClient", "LicenceDef")
	return if ok and type(def) == "table" then def else {}
end

local function perks(): { [string]: any }
	local ok, value = call("MarketClient", "Perks")
	return if ok and type(value) == "table" then value else {}
end

local function trading(): { [string]: any }
	local t = ctx.Config.Trading
	return if type(t) == "table" then t else {}
end

local function nextSeq(): number
	local ok, seq = call("MarketClient", "NextSeq")
	if ok and type(seq) == "number" then
		return seq
	end
	return (math.floor(os.time()) % 2097152) * 1024
end

local function sfx(role: string)
	call("Sfx", "Play", role)
end

-- ---------------------------------------------------------------------
-- DEPOT-RECHNUNG (gleiche Mathematik wie der Server: PortfolioMath)
-- ---------------------------------------------------------------------
function DepotView.Free(): number
	local d = depot()
	local cash = num(d.Cash, 0)
	local reserved = 0
	if type(d.Orders) == "table" then
		for _, order in ipairs(d.Orders) do
			if type(order) == "table" and order.Side == "B" then
				reserved += num(order.Res, 0)
			end
		end
	end
	return math.max(0, cash - reserved)
end

function DepotView.Nav(): number
	local d = depot()
	if type(d.Pos) ~= "table" then
		return num(d.Nav, num(d.Cash, 0))
	end
	local bids: { [number]: number } = {}
	for key in pairs(d.Pos) do
		local i = tonumber(key)
		if i then
			local bid = bidOf(i)
			if bid then
				bids[i] = bid
			end
		end
	end
	local ok, nav = pcall(PortfolioMath.Nav, { Cash = num(d.Cash, 0), Pos = d.Pos }, bids)
	if ok and type(nav) == "number" then
		return nav
	end
	return num(d.Nav, 0)
end

function DepotView.Position(i: number): (number, number, number)
	local pos = depot().Pos
	local p = type(pos) == "table" and pos[tostring(i)] or nil
	if type(p) ~= "table" then
		return 0, 0, 0
	end
	local q = num(p.Q, 0)
	local avg = if q > 0 then num(p.C, 0) / q else 0
	return q, avg, math.max(0, q - num(p.R, 0))
end

-- ---------------------------------------------------------------------
-- BAUSTEINE
-- ---------------------------------------------------------------------
local function newList(parent: Instance): ScrollingFrame
	return UI.Create("ScrollingFrame", {
		Name = "DepotList",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Muted,
		ScrollBarImageTransparency = 0.3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
		UI.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 2),
			PaddingRight = UDim.new(0, 8),
			PaddingTop = UDim.new(0, 2),
			PaddingBottom = UDim.new(0, 8),
		}),
	})
end

local function cell(parent: Instance, x: number, w: number, props: { [string]: any }?): TextLabel
	local base: { [string]: any } = {
		Position = UDim2.new(x, 0, 0, 0),
		Size = UDim2.new(w, 0, 1, 0),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Mono,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		RichText = true,
		Text = "",
	}
	if props then
		for k, v in pairs(props) do
			base[k] = v
		end
	end
	base.Parent = parent
	return UI.Create("TextLabel", base)
end

local function logoChip(parent: Instance, i: number): Frame
	local inst = instOf(i)
	local okSector, sector = call("MarketClient", "Sector", i)
	local color = if okSector and type(sector) == "table" then sector.Color else Theme.Accent
	local chip: Frame = UI.Create("Frame", {
		Name = "Logo",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Parent = parent,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	UI.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Display,
		TextSize = 13,
		TextColor3 = Color3.new(1, 1, 1),
		Text = if type(inst) == "table" and type(inst.Logo) == "table" then tostring(inst.Logo.Letter) else "?",
		Parent = chip,
	})
	return chip
end

local function emptyLabel(parent: Instance, order: number): TextLabel
	return UI.Create("TextLabel", {
		Name = "Empty",
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Body,
		TextSize = 14,
		TextColor3 = Theme.Muted,
		TextWrapped = true,
		Text = "",
		LayoutOrder = order,
		Parent = parent,
	})
end

local function smallButton(parent: Instance, text: string, variant: string, order: number, onClick: () -> ()): any
	return UI.Button({
		Size = UDim2.fromOffset(96, 34),
		Text = text,
		Variant = variant,
		MaxText = 13,
		Corner = 9,
		LayoutOrder = order,
		Parent = parent,
	}, onClick)
end

-- ---------------------------------------------------------------------
-- ABSCHNITT: POSITIONEN
-- ---------------------------------------------------------------------
local function placeProtect(i: number)
	local bid = bidOf(i)
	if not bid then
		return
	end
	local protect = trading().Protect or { Sl = 0.08, Tp = 0.15 }
	local reply = ctx.RequestFull("TradePlace", {
		I = i,
		Side = "S",
		Type = "OCO",
		Pct = "Max",
		Stp = math.max(1, math.floor(bid * (1 - num(protect.Sl, 0.08)))),
		Tp = math.ceil(bid * (1 + num(protect.Tp, 0.15))),
		Seq = nextSeq(),
	})
	sfx(if reply.Ok then "UIClick" else "UIError")
end

local function hasProtection(i: number): boolean
	local orders = depot().Orders
	if type(orders) ~= "table" then
		return false
	end
	for _, order in ipairs(orders) do
		if type(order) == "table" and order.I == i and order.Side == "S" then
			if order.Type == "OCO" or order.Type == "STP" or order.Type == "TRL" then
				return true
			end
		end
	end
	return false
end

local function positionRow(view: View, index: number): any
	local card = UI.RowCard(view.Frame, 10 + index, ROW_H)
	local button: TextButton = UI.Create("TextButton", {
		Name = "Hit",
		Size = UDim2.new(1, -210, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = card,
	})
	local row = {
		Card = card,
		I = 0,
		Logo = nil :: Frame?,
		Name = cell(card, 0, 0.3, {
			Position = UDim2.new(0, 46, 0, 0),
			Size = UDim2.new(0.26, -46, 1, 0),
			FontFace = UI.Faces.BodyBold,
		}),
		Qty = cell(card, 0.26, 0.12),
		Avg = cell(card, 0.38, 0.14, { TextColor3 = Theme.Text2 }),
		Now = cell(card, 0.52, 0.14),
		Pnl = cell(card, 0.66, 0.2),
		Actions = UI.RowActions(card, 200),
		Sell = nil :: any,
		Protect = nil :: any,
	}
	button.Activated:Connect(function()
		if row.I > 0 then
			call("Terminal", "OpenAt", row.I)
		end
	end)
	row.Sell = smallButton(row.Actions, T("term.pos.sell"), "Danger", 1, function()
		if row.I > 0 then
			call("Terminal", "OpenTicket", row.I, "S")
		end
	end)
	row.Protect = smallButton(row.Actions, T("term.pos.protect"), "Secondary", 2, function()
		if row.I > 0 then
			placeProtect(row.I)
		end
	end)
	return row
end

local function updatePositions(view: View)
	local d = depot()
	local list: { { I: number, Q: number, C: number, Value: number } } = {}
	if type(d.Pos) == "table" then
		for key, p in pairs(d.Pos) do
			local i = tonumber(key)
			if i and type(p) == "table" and num(p.Q, 0) > 0 then
				local bid = bidOf(i) or (num(p.C, 0) / math.max(1, num(p.Q, 1)))
				table.insert(list, { I = i, Q = num(p.Q, 0), C = num(p.C, 0), Value = num(p.Q, 0) * bid })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Value > b.Value
	end)
	local header = view.Parts.Header
	if not header then
		local frame: Frame = UI.Create("Frame", {
			Name = "Header",
			Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1,
			LayoutOrder = 1,
			Parent = view.Frame,
		})
		local cols = {
			{ "term.col.inst", 0, 0.26, 46 },
			{ "term.col.qty", 0.26, 0.12, 0 },
			{ "term.col.cost", 0.38, 0.14, 0 },
			{ "term.col.price", 0.52, 0.14, 0 },
			{ "term.col.pnl", 0.66, 0.2, 0 },
		}
		local labels = {}
		for _, col in ipairs(cols) do
			local label = cell(frame, col[2], col[3], {
				Position = UDim2.new(col[2], col[4], 0, 0),
				TextSize = 11,
				TextColor3 = Theme.Muted,
				FontFace = UI.Faces.BodyBold,
			})
			table.insert(labels, { Label = label, Key = col[1] })
		end
		header = { Frame = frame, Labels = labels }
		view.Parts.Header = header
		view.Parts.Empty = emptyLabel(view.Frame, 2)
	end
	for _, entry in ipairs(header.Labels) do
		setText(entry.Label, UI.Upper(T(entry.Key)))
	end
	header.Frame.Visible = #list > 0
	view.Parts.Empty.Visible = #list == 0
	setText(view.Parts.Empty, if d.Syncing then T("trade.syncing") else T("term.pos.empty"))
	for index, entry in ipairs(list) do
		local row = view.Rows[index]
		if not row then
			row = positionRow(view, index)
			view.Rows[index] = row
		end
		if row.I ~= entry.I then
			row.I = entry.I
			if row.Logo then
				row.Logo:Destroy()
			end
			row.Logo = logoChip(row.Card, entry.I)
		end
		local inst = instOf(entry.I)
		setText(row.Name, if type(inst) == "table" then inst.Ticker else tickerOf(entry.I))
		local okQty, qtyText = pcall(ctx.Format.Int, entry.Q, lang())
		setText(row.Qty, if okQty and type(qtyText) == "string" then qtyText else tostring(entry.Q))
		local avg = entry.C / math.max(1, entry.Q)
		setText(row.Avg, price(math.floor(avg + 0.5)))
		local bid = entry.Value / math.max(1, entry.Q)
		setText(row.Now, price(math.floor(bid + 0.5)))
		local pnl = entry.Value - entry.C
		local frac = if entry.C > 0 then pnl / entry.C else 0
		local color = UI.ColorHex(UI.TrendColor(pnl))
		setText(
			row.Pnl,
			string.format(
				'<font color="%s">%s %s (%s)</font>',
				color,
				UI.TrendArrow(pnl),
				aky(math.floor(pnl + 0.5), true),
				pct(frac)
			)
		)
		row.Sell.SetText(T("term.pos.sell"))
		row.Protect.SetText(T("term.pos.protect"))
		row.Protect.Frame.Visible = not hasProtection(entry.I)
		row.Card.Visible = true
	end
	for index = #list + 1, #view.Rows do
		view.Rows[index].Card.Visible = false
	end
end

-- ---------------------------------------------------------------------
-- ABSCHNITT: ORDERS (Streichen, Ändern)
-- ---------------------------------------------------------------------
local TYPE_KEY: { [string]: string } = {
	MKT = "trade.typeMKT",
	LMT = "trade.typeLMT",
	STP = "trade.typeSTP",
	TP = "trade.typeTP",
	OCO = "trade.typeOCO",
	TRL = "trade.typeTRL",
}

local function orderPrices(order: any): string
	local parts: { string } = {}
	if type(order.Lim) == "number" then
		table.insert(parts, T("term.ord.lim", price(order.Lim)))
	end
	if type(order.Stp) == "number" then
		table.insert(parts, T("term.ord.stp", price(order.Stp)))
	end
	if type(order.Tp) == "number" then
		table.insert(parts, T("term.ord.tp", price(order.Tp)))
	end
	if type(order.Trl) == "number" then
		table.insert(parts, T("term.ord.trl", pct(order.Trl / 10000, 1)))
	end
	return table.concat(parts, " · ")
end

local function orderRow(view: View, index: number): any
	local card: Frame = UI.RowCard(view.Frame, 10 + index, ROW_H)
	local row = {
		Card = card,
		Order = nil :: any,
		Title = cell(card, 0, 0.36, {
			Position = UDim2.new(0, 12, 0, 6),
			Size = UDim2.new(0.42, -12, 0, 20),
			FontFace = UI.Faces.BodyBold,
		}),
		Prices = cell(card, 0, 0.42, {
			Position = UDim2.new(0, 12, 0, 26),
			Size = UDim2.new(0.42, -12, 0, 18),
			TextSize = 12,
			TextColor3 = Theme.Text2,
		}),
		Exp = cell(card, 0.42, 0.2, { TextSize = 12, TextColor3 = Theme.Muted }),
		Actions = UI.RowActions(card, 200),
		Edit = nil :: any,
		Cancel = nil :: any,
		Editor = nil :: Frame?,
	}
	row.Edit = smallButton(row.Actions, T("term.ord.edit"), "Secondary", 1, function()
		local order = row.Order
		if not order then
			return
		end
		local editor = row.Editor
		if editor then
			editor:Destroy()
			row.Editor = nil
			card.Size = UDim2.new(1, 0, 0, ROW_H)
			return
		end
		-- kleiner Editor: je Preisfeld ein Eingabefeld + Speichern
		card.Size = UDim2.new(1, 0, 0, ROW_H + 48)
		local holder: Frame = UI.Create("Frame", {
			Name = "Editor",
			Position = UDim2.new(0, 12, 0, ROW_H),
			Size = UDim2.new(1, -24, 0, 40),
			BackgroundTransparency = 1,
			Parent = card,
		}, {
			UI.Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		row.Editor = holder
		local boxes: { [string]: TextBox } = {}
		local fields = { "Lim", "Stp", "Tp", "Trl" }
		for order_, key in ipairs(fields) do
			local value = order[key]
			if type(value) == "number" then
				local text = if key == "Trl" then decimal(value / 100, 1) else price(value)
				boxes[key] = UI.TextBox({
					Size = UDim2.fromOffset(110, 32),
					Text = text,
					PlaceholderText = T("term.ord.field." .. key),
					LayoutOrder = order_,
					Parent = holder,
				})
			end
		end
		smallButton(holder, T("term.ord.save"), "Primary", 10, function()
			local arg: { [string]: any } = { OrderId = order.Id, Seq = nextSeq() }
			for key, box in pairs(boxes) do
				local n = parseNumber(box.Text)
				if not n or n <= 0 then
					ctx.Toast(T("term.priceInvalid"), "Error")
					return
				end
				if key == "Trl" then
					arg.Trl = math.clamp(math.floor(n * 100 + 0.5), 50, 2000)
				else
					arg[key] = math.floor(n * 100 + 0.5)
				end
			end
			local reply = ctx.RequestFull("TradeModify", arg)
			if reply.Ok then
				holder:Destroy()
				row.Editor = nil
				card.Size = UDim2.new(1, 0, 0, ROW_H)
			end
		end)
	end)
	row.Cancel = smallButton(row.Actions, T("term.ord.cancel"), "Danger", 2, function()
		local order = row.Order
		if order then
			local reply = ctx.RequestFull("TradeCancel", { OrderId = order.Id, Seq = nextSeq() })
			sfx(if reply.Ok then "UIClick" else "UIError")
		end
	end)
	return row
end

local function updateOrders(view: View)
	local d = depot()
	local orders: { any } = {}
	if type(d.Orders) == "table" then
		for _, order in ipairs(d.Orders) do
			if type(order) == "table" and type(order.Id) == "number" then
				table.insert(orders, order)
			end
		end
	end
	if not view.Parts.Empty then
		view.Parts.Empty = emptyLabel(view.Frame, 1)
		view.Parts.Count = UI.Create("TextLabel", {
			Name = "Count",
			Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1,
			FontFace = UI.Faces.Body,
			TextSize = 12,
			TextColor3 = Theme.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 2,
			Parent = view.Frame,
		})
	end
	view.Parts.Empty.Visible = #orders == 0
	setText(view.Parts.Empty, T("term.ord.empty"))
	local maxOrders = num(licenceDef().MaxOrders, 5)
	setText(view.Parts.Count, T("term.ord.count", #orders, maxOrders))
	local now = 0
	local okTick, tick = pcall(ctx.Clock.Tick)
	if okTick and type(tick) == "number" then
		now = tick
	end
	for index, order in ipairs(orders) do
		local row = view.Rows[index]
		if not row then
			row = orderRow(view, index)
			view.Rows[index] = row
		end
		if row.Order and row.Order.Id ~= order.Id and row.Editor then
			row.Editor:Destroy()
			row.Editor = nil
			row.Card.Size = UDim2.new(1, 0, 0, ROW_H)
		end
		row.Order = order
		local sideText = T(if order.Side == "B" then "term.side.B" else "term.side.S")
		local typeText = T(TYPE_KEY[order.Type] or "trade.typeMKT")
		if order.Type == "STP" and order.Side == "B" then
			typeText = T("trade.typeBuyStop")
		end
		local okQ, qText = pcall(ctx.Format.Int, math.floor(num(order.Q, 0)), lang())
		local title = string.format(
			"%s · %s %s · %s",
			tickerOf(order.I),
			sideText,
			typeText,
			if okQ and type(qText) == "string" then qText else tostring(num(order.Q, 0))
		)
		if type(order.Bot) == "number" then
			title ..= " · " .. T("term.ord.bot")
		end
		setText(row.Title, title)
		setText(row.Prices, orderPrices(order))
		local left = num(order.Exp, 0) - now
		setText(row.Exp, if left > 0 then T("term.ord.expires", ctx.Format.Duration(left, lang())) else "")
		local editable = type(order.Bot) ~= "number" and order.Type ~= "MKT"
		row.Edit.Frame.Visible = editable
		row.Cancel.Frame.Visible = type(order.Bot) ~= "number"
		row.Edit.SetText(T("term.ord.edit"))
		row.Cancel.SetText(T("term.ord.cancel"))
		row.Card.Visible = true
	end
	for index = #orders + 1, #view.Rows do
		local row = view.Rows[index]
		row.Card.Visible = false
		row.Order = nil
	end
end

-- ---------------------------------------------------------------------
-- ABSCHNITT: ALARME
-- ---------------------------------------------------------------------
local function updateAlerts(view: View)
	local d = depot()
	local alerts: { any } = {}
	if type(d.Alerts) == "table" then
		for _, alert in ipairs(d.Alerts) do
			if type(alert) == "table" and type(alert.Id) == "number" then
				table.insert(alerts, alert)
			end
		end
	end
	if not view.Parts.Hint then
		view.Parts.Hint = UI.Create("TextLabel", {
			Name = "Hint",
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundTransparency = 1,
			FontFace = UI.Faces.Body,
			TextSize = 13,
			TextColor3 = Theme.Muted,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 1,
			Parent = view.Frame,
		})
	end
	local limit = math.floor(num(perks().Alerts, 3))
	setText(view.Parts.Hint, T("term.alarm.count", #alerts, limit) .. " · " .. T("term.alert.hint"))
	for index, alert in ipairs(alerts) do
		local row = view.Rows[index]
		if not row then
			local card: Frame = UI.RowCard(view.Frame, 10 + index, 44)
			row = {
				Card = card,
				Alert = nil :: any,
				Text = cell(card, 0, 0.6, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.6, -12, 1, 0) }),
				Actions = UI.RowActions(card, 110),
				Remove = nil :: any,
			}
			local current = row
			row.Remove = smallButton(row.Actions, T("term.alert.remove"), "Secondary", 1, function()
				local entry = current.Alert
				if entry then
					local reply = ctx.RequestFull("AlertRemove", { Id = entry.Id })
					sfx(if reply.Ok then "UIClick" else "UIError")
				end
			end)
			view.Rows[index] = row
		end
		row.Alert = alert
		local color = UI.ColorHex(if alert.Dir == "Up" then UI.UpColor() else UI.DownColor())
		setText(
			row.Text,
			string.format(
				'%s  <font color="%s">%s</font>  %s',
				tickerOf(alert.I),
				color,
				if alert.Dir == "Up" then "▲" else "▼",
				price(num(alert.Px, 0))
			)
		)
		row.Remove.SetText(T("term.alert.remove"))
		row.Card.Visible = true
	end
	for index = #alerts + 1, #view.Rows do
		view.Rows[index].Card.Visible = false
		view.Rows[index].Alert = nil
	end
end

-- ---------------------------------------------------------------------
-- ABSCHNITT: ÜBERSICHT (Depotwert, Basis, Gewinn-Transfer, Starthilfe, Auto-Transfer)
-- ---------------------------------------------------------------------
local function transferStatus(): (string, boolean)
	local d = depot()
	if d.Syncing then
		return T("trade.syncing"), false
	end
	local withdrawable = num(d.Withdrawable, 0)
	local basis = num(d.Basis, 0)
	local nav = DepotView.Nav()
	local threshold = num((trading().Transfer or {}).Threshold, 1.02)
	if d.TransferReady == true and withdrawable > 0 then
		local rate = num(licenceDef().BauKurs, 40)
		local cr = math.floor(withdrawable * rate / 100)
		local rateText = credits(rate)
		return T("trade.transferAvail", aky(withdrawable, true), credits(cr) .. " CR", rateText), true
	end
	if basis > 0 and nav < basis * threshold then
		return T("trade.transferBelow"), false
	end
	if withdrawable > 0 then
		return T("trade.transferUsed"), false
	end
	return T("trade.transferNone"), false
end

local function buildOverview(view: View)
	local frame = view.Frame
	local grid: Frame = UI.Create("Frame", {
		Name = "Tiles",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = frame,
	}, {
		UI.Create("UIGridLayout", {
			CellSize = UDim2.new(0.25, -8, 0, 64),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local tiles = {
		Value = UI.StatTile(grid, T("term.depot.value"), 1),
		Cash = UI.StatTile(grid, T("term.depot.cash"), 2),
		Basis = UI.StatTile(grid, T("term.depot.basis"), 3),
		Return = UI.StatTile(grid, T("term.depot.return"), 4),
	}
	view.Parts.Tiles = tiles
	view.Parts.TileGrid = grid
	-- Gewinn-Transfer-Karte
	local transfer = UI.Card({
		Name = "Transfer",
		Size = UDim2.new(1, 0, 0, 118),
		LayoutOrder = 2,
		Parent = frame,
	})
	view.Parts.TransferTitle = UI.Label({
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.new(1, -28, 0, 20),
		Text = "",
		Face = "Display",
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 16,
		Parent = transfer,
	})
	view.Parts.TransferText = UI.Create("TextLabel", {
		Position = UDim2.fromOffset(14, 34),
		Size = UDim2.new(1, -28, 0, 20),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Mono,
		TextSize = 15,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Text = "",
		Parent = transfer,
	})
	view.Parts.RateText = UI.Create("TextLabel", {
		Position = UDim2.fromOffset(14, 56),
		Size = UDim2.new(1, -28, 0, 16),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Body,
		TextSize = 12,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Parent = transfer,
	})
	view.Parts.TransferButton = UI.Button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -10),
		Size = UDim2.fromOffset(230, 36),
		Text = T("trade.transferButton"),
		Variant = "Success",
		MaxText = 15,
		Corner = 10,
		Parent = transfer,
	}, function()
		local reply = ctx.RequestFull("TowerTransfer", {})
		sfx(if reply.Ok then "CashRegister" else "UIError")
	end)
	view.Parts.AutoButton = UI.Button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -10),
		Size = UDim2.fromOffset(250, 36),
		Text = "",
		Variant = "Secondary",
		MaxText = 13,
		Corner = 10,
		Parent = transfer,
	}, function()
		local current = depot().AutoTransfer ~= false
		-- Einstellung und Depot können auseinanderlaufen (z. B. anderes Gerät): steht die Einstellung schon auf dem
		-- Zielwert, würde Settings.Set nichts senden -> dann direkt an das Depot (WP4)
		local okGet, settings = call("Settings", "Get")
		local already = okGet and type(settings) == "table" and settings.AutoTransfer == not current
		local okSet = not already and call("Settings", "Set", "AutoTransfer", not current)
		if not okSet then
			task.spawn(ctx.RequestFull, "TradeAuto", { On = not current })
		end
	end)
	-- Starthilfe (Rettungsschirm, §B8.4)
	local refill = UI.Card({
		Name = "Refill",
		Size = UDim2.new(1, 0, 0, 60),
		LayoutOrder = 3,
		Visible = false,
		Parent = frame,
	})
	view.Parts.Refill = refill
	view.Parts.RefillText = UI.Create("TextLabel", {
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -190, 1, 0),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Body,
		TextSize = 13,
		TextWrapped = true,
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Parent = refill,
	})
	view.Parts.RefillButton = UI.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(160, 36),
		Text = T("trade.refillButton"),
		Variant = "Primary",
		MaxText = 15,
		Corner = 10,
		Parent = refill,
	}, function()
		local reply = ctx.RequestFull("TradeRefill", {})
		sfx(if reply.Ok then "CashRegister" else "UIError")
	end)
	view.Parts.Footer = UI.Create("TextLabel", {
		Name = "Disclaimer",
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Body,
		TextSize = 11,
		TextWrapped = true,
		TextColor3 = Theme.Muted,
		Text = "",
		LayoutOrder = 9,
		Parent = frame,
	})
end

local function updateOverview(view: View)
	if not view.Parts.Tiles then
		buildOverview(view)
	end
	local d = depot()
	local tiles = view.Parts.Tiles
	local nav = DepotView.Nav()
	local basis = num(d.Basis, 0)
	setText(tiles.Value, aky(nav, true))
	setText(tiles.Cash, aky(DepotView.Free(), true))
	setText(tiles.Basis, aky(basis, true))
	local ret = if basis > 0 then nav / basis - 1 else 0
	setText(tiles.Return, pct(ret))
	tiles.Return.TextColor3 = UI.TrendColor(ret)
	-- Kachel-Überschriften (Sprache)
	for key, label in pairs(tiles) do
		local caption = label.Parent and label.Parent:FindFirstChild("Caption")
		if caption and caption:IsA("TextLabel") then
			local textKey = ({
				Value = "term.depot.value",
				Cash = "term.depot.cash",
				Basis = "term.depot.basis",
				Return = "term.depot.return",
			})[key]
			if textKey then
				setText(caption, T(textKey))
			end
		end
	end
	setText(view.Parts.TransferTitle, UI.Upper(T("trade.transferButton")))
	local text, ready = transferStatus()
	setText(view.Parts.TransferText, text)
	setText(view.Parts.RateText, T("trade.bauKurs", credits(num(licenceDef().BauKurs, 40))))
	view.Parts.TransferButton.SetText(T("trade.transferButton"))
	view.Parts.TransferButton.SetVariant(if ready then "Success" else "Muted")
	view.Parts.AutoButton.SetText(T(if d.AutoTransfer ~= false then "trade.autoOn" else "trade.autoOff"))
	local refillReady = d.RefillReady == true
	view.Parts.Refill.Visible = refillReady
	if refillReady then
		local target = math.floor(basis * num((trading().Refill or {}).To, 0.5))
		setText(view.Parts.RefillText, T("term.depot.refillHint", aky(math.max(0, target - nav), true)))
		view.Parts.RefillButton.SetText(T("trade.refillButton"))
	end
	setText(view.Parts.Footer, T("core.disclaimer"))
end

-- ---------------------------------------------------------------------
-- ABSCHNITT: STRATEGIE-BOTS (§B8.5 – nur Lizenz + Know-how, nie Robux)
-- ---------------------------------------------------------------------
local function botPresets(): { string }
	local order = trading().BotOrder
	return if type(order) == "table" then order else { "Sparplan", "Trend", "Dividend", "Dip" }
end

local function botDef(preset: string): { [string]: any }?
	local bots = trading().Bots
	local def = type(bots) == "table" and bots[preset] or nil
	return if type(def) == "table" then def else nil
end

local function botTargets(def: { [string]: any }): { number }
	local out: { number } = {}
	local okIds, ids = call("MarketClient", "AllowedIds")
	if not okIds or type(ids) ~= "table" then
		return out
	end
	for _, i in ipairs(ids) do
		local inst = instOf(i)
		if type(inst) == "table" then
			local isEtf = inst.Class == "ETF"
			if (def.Target == "ETF" and isEtf) or (def.Target == "Inst" and not isEtf) then
				table.insert(out, i)
			end
		end
	end
	return out
end

local function openBotEditor(row: any, slotIndex: number)
	if row.Editor then
		row.Editor:Destroy()
		row.Editor = nil
		row.Card.Size = UDim2.new(1, 0, 0, 92)
		return
	end
	local licence = 1
	local okLic, value = call("MarketClient", "Licence")
	if okLic and type(value) == "number" then
		licence = value
	end
	local unlocked: { string } = {}
	for _, preset in ipairs(botPresets()) do
		local def = botDef(preset)
		if def and num(def.Licence, 99) <= licence then
			table.insert(unlocked, preset)
		end
	end
	if #unlocked == 0 then
		return
	end
	local existing = depot().Bots
	local current = type(existing) == "table" and existing[slotIndex] or nil
	local preset = if type(current) == "table" and table.find(unlocked, current.Preset)
		then current.Preset
		else unlocked[1]
	row.Card.Size = UDim2.new(1, 0, 0, 92 + 150)
	local holder: Frame = UI.Create("Frame", {
		Name = "Editor",
		Position = UDim2.fromOffset(12, 92),
		Size = UDim2.new(1, -24, 0, 144),
		BackgroundTransparency = 1,
		Parent = row.Card,
	}, {
		UI.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
	})
	row.Editor = holder
	local names: { string } = {}
	for _, key in ipairs(unlocked) do
		local def = botDef(key)
		table.insert(names, if def then ctx.Lang.Pick(lang(), def.Name) else key)
	end
	local cycler = UI.Cycler(holder, T("term.bot.pick"), names, UDim2.new(1, 0, 0, 34))
	cycler.Button.Frame.LayoutOrder = 1
	cycler.Set(names[table.find(unlocked, preset) or 1])
	local sliderHolder: Frame = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = holder,
	})
	local targetHolder: Frame = UI.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = holder,
	})
	local slider: any = nil
	local target: any = nil
	local targetIds: { number } = {}
	local function rebuild()
		for _, child in ipairs(sliderHolder:GetChildren()) do
			child:Destroy()
		end
		for _, child in ipairs(targetHolder:GetChildren()) do
			child:Destroy()
		end
		local def = botDef(preset)
		if not def then
			return
		end
		local lo, hi = math.floor(num(def.Min, 0.05) * 100 + 0.5), math.floor(num(def.Max, 0.3) * 100 + 0.5)
		local start = math.floor(num(def.Default, 0.1) * 100 + 0.5)
		if type(current) == "table" and current.Preset == preset and type(current.Pct) == "number" then
			start = math.floor(current.Pct * 100 + 0.5)
		end
		slider = UI.Slider(sliderHolder, 1, T("term.bot.param." .. tostring(def.Param)), lo, hi, start, function() end)
		slider.Frame.Size = UDim2.fromScale(1, 1)
		target = nil
		targetIds = {}
		if def.Target == "ETF" or def.Target == "Inst" then
			targetIds = botTargets(def)
			local labels: { string } = {}
			for _, i in ipairs(targetIds) do
				table.insert(labels, tickerOf(i))
			end
			target = UI.Cycler(targetHolder, T("term.bot.targetPick"), labels, UDim2.fromScale(1, 1))
			local wanted = if type(current) == "table" and current.Preset == preset
				then current.Target
				else def.DefaultTarget
			if type(wanted) == "number" and table.find(targetIds, wanted) then
				target.Set(tickerOf(wanted))
			end
		end
	end
	cycler.OnChange = function(name: string?)
		local index = table.find(names, name or "")
		if index then
			preset = unlocked[index]
			rebuild()
		end
	end
	rebuild()
	smallButton(holder, T("term.bot.save"), "Primary", 4, function()
		local def = botDef(preset)
		if not def or not slider then
			return
		end
		local arg: { [string]: any } = { Slot = slotIndex, Preset = preset, Pct = slider.Get() / 100 }
		if target then
			local chosen = target.Get()
			for _, i in ipairs(targetIds) do
				if tickerOf(i) == chosen then
					arg.Target = i
				end
			end
			if def.Target == "Inst" and arg.Target == nil then
				ctx.Toast(T("trade.botTarget"), "Error")
				return
			end
		end
		local reply = ctx.RequestFull("BotSet", arg)
		if reply.Ok then
			holder:Destroy()
			row.Editor = nil
			row.Card.Size = UDim2.new(1, 0, 0, 92)
		end
	end)
end

local function updateBots(view: View)
	local slots = math.floor(num(perks().BotSlots, num(licenceDef().BotSlots, 0)))
	local bots = depot().Bots
	if not view.Parts.Hint then
		view.Parts.Hint = UI.Create("TextLabel", {
			Name = "Hint",
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundTransparency = 1,
			FontFace = UI.Faces.Body,
			TextSize = 12,
			TextColor3 = Theme.Muted,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 1,
			Parent = view.Frame,
		})
	end
	setText(
		view.Parts.Hint,
		if slots <= 0 then T("term.bot.none") else T("trade.botWage") .. " · " .. T("trade.botTotal")
	)
	for index = 1, slots do
		local row = view.Rows[index]
		if not row then
			local card: Frame = UI.Card({
				Name = "Bot",
				Size = UDim2.new(1, 0, 0, 92),
				LayoutOrder = 10 + index,
				Parent = view.Frame,
			})
			row = {
				Card = card,
				Editor = nil :: Frame?,
				Title = UI.Label({
					Position = UDim2.fromOffset(14, 8),
					Size = UDim2.new(1, -240, 0, 20),
					Text = "",
					Face = "Display",
					TextXAlignment = Enum.TextXAlignment.Left,
					MaxText = 15,
					Parent = card,
				}),
				Desc = UI.Create("TextLabel", {
					Position = UDim2.fromOffset(14, 30),
					Size = UDim2.new(1, -240, 0, 34),
					BackgroundTransparency = 1,
					FontFace = UI.Faces.Body,
					TextSize = 12,
					TextWrapped = true,
					TextColor3 = Theme.Text2,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Top,
					Text = "",
					Parent = card,
				}),
				Status = UI.Create("TextLabel", {
					Position = UDim2.fromOffset(14, 66),
					Size = UDim2.new(1, -240, 0, 18),
					BackgroundTransparency = 1,
					FontFace = UI.Faces.Mono,
					TextSize = 12,
					TextColor3 = Theme.Muted,
					TextXAlignment = Enum.TextXAlignment.Left,
					RichText = true,
					Text = "",
					Parent = card,
				}),
				Toggle = nil :: any,
				Change = nil :: any,
			}
			local current = row
			local slotIndex = index
			row.Toggle = UI.Button({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -12, 0, 12),
				Size = UDim2.fromOffset(104, 34),
				Text = "",
				Variant = "Secondary",
				MaxText = 13,
				Corner = 9,
				Parent = card,
			}, function()
				local list = depot().Bots
				local slot = type(list) == "table" and list[slotIndex] or nil
				if type(slot) ~= "table" then
					openBotEditor(current, slotIndex)
					return
				end
				local reply = ctx.RequestFull("BotToggle", { Slot = slotIndex, On = slot.On ~= true })
				sfx(if reply.Ok then "UIClick" else "UIError")
			end)
			row.Change = UI.Button({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -124, 0, 12),
				Size = UDim2.fromOffset(104, 34),
				Text = "",
				Variant = "Ghost",
				MaxText = 13,
				Corner = 9,
				Parent = card,
			}, function()
				openBotEditor(current, slotIndex)
			end)
			view.Rows[index] = row
		end
		local slot = type(bots) == "table" and bots[index] or nil
		if type(slot) == "table" and type(slot.Preset) == "string" then
			local def = botDef(slot.Preset)
			setText(
				row.Title,
				T("term.bot.slot", index) .. " · " .. (if def then ctx.Lang.Pick(lang(), def.Name) else slot.Preset)
			)
			setText(row.Desc, if def then ctx.Lang.Pick(lang(), def.Desc) else "")
			local status: string
			if slot.Paused == true then
				status = string.format('<font color="%s">%s</font>', UI.ColorHex(Theme.Warn), T("term.bot.paused"))
			elseif slot.On == true then
				status = string.format('<font color="%s">%s</font>', UI.ColorHex(UI.UpColor()), T("term.bot.running"))
			else
				status = T("term.bot.stopped")
			end
			status ..= "  ·  " .. T("term.bot.share", pct(num(slot.Pct, 0), 0))
			if type(slot.Target) == "number" then
				status ..= "  ·  " .. T("term.bot.target", tickerOf(slot.Target))
			end
			setText(row.Status, status)
			row.Toggle.SetText(T(if slot.On == true then "term.bot.off" else "term.bot.on"))
			row.Toggle.SetVariant(if slot.On == true then "Danger" else "Success")
			row.Change.SetText(T("term.bot.change"))
			row.Change.Frame.Visible = true
		else
			setText(row.Title, T("term.bot.slot", index) .. " · " .. T("term.bot.empty"))
			setText(row.Desc, T("term.bot.emptyHint"))
			setText(row.Status, "")
			row.Toggle.SetText(T("term.bot.pick"))
			row.Toggle.SetVariant("Primary")
			row.Change.Frame.Visible = false
		end
		row.Card.Visible = true
	end
	for index = slots + 1, #view.Rows do
		view.Rows[index].Card.Visible = false
	end
	-- gesperrte Strategien zeigen (Lernziel), nie kaufbar
	if not view.Parts.Locked then
		view.Parts.Locked = UI.Create("TextLabel", {
			Name = "Locked",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			FontFace = UI.Faces.Body,
			TextSize = 12,
			TextWrapped = true,
			TextColor3 = Theme.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 99,
			Parent = view.Frame,
		})
	end
	local licence = 1
	local okLic, value = call("MarketClient", "Licence")
	if okLic and type(value) == "number" then
		licence = value
	end
	local locked: { string } = {}
	for _, preset in ipairs(botPresets()) do
		local def = botDef(preset)
		if def and num(def.Licence, 99) > licence then
			local okName, licName = call("MarketClient", "LicenceName", def.Licence)
			table.insert(
				locked,
				ctx.Lang.Pick(lang(), def.Name) .. " – " .. T("term.bot.locked", if okName then licName else "?")
			)
		end
	end
	setText(view.Parts.Locked, table.concat(locked, "\n"))
end

-- ---------------------------------------------------------------------
-- ABSCHNITT: PERFORMANCE (Profi: TWR, Drawdown, Skill-Score; alle: Trefferquote, Liga)
-- ---------------------------------------------------------------------
local function requestHistory()
	if historyBusy or os.clock() - historyAt < HISTORY_GAP then
		return
	end
	historyBusy = true
	historyAt = os.clock()
	task.spawn(function()
		local reply = ctx.RequestFull("DepotHistory", {}, true)
		historyBusy = false
		if reply.Ok then
			history = {
				Fills = if type(reply.Fills) == "table" then reply.Fills else {},
				Nav = if type(reply.Nav) == "table" then reply.Nav else {},
			}
			DepotView.Refresh()
		end
	end)
end

local function dayReturns(): ({ number }, { number })
	local returns: { number } = {}
	local navs: { number } = {}
	local h = history
	if not h then
		return returns, navs
	end
	for _, entry in ipairs(h.Nav) do
		if type(entry) == "table" then
			local navStart, navEnd, flow = num(entry[2], 0), num(entry[3], 0), num(entry[4], 0)
			if navStart > 0 then
				local ok, r = pcall(PortfolioMath.DayReturn, navStart, navEnd, flow)
				if ok and type(r) == "number" then
					table.insert(returns, r)
				end
			end
			table.insert(navs, navEnd)
		end
	end
	return returns, navs
end

local function updatePerformance(view: View)
	requestHistory()
	local layer = "Simple"
	local okLayer, value = call("MarketClient", "Layer")
	if okLayer and type(value) == "string" then
		layer = value
	end
	local pro = layer == "Pro"
	if not view.Parts.Grid then
		local grid: Frame = UI.Create("Frame", {
			Name = "Tiles",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = 1,
			Parent = view.Frame,
		}, {
			UI.Create("UIGridLayout", {
				CellSize = UDim2.new(0.25, -8, 0, 64),
				CellPadding = UDim2.fromOffset(8, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		local keys = {
			"term.perf.trades",
			"term.perf.hit",
			"term.perf.best",
			"term.perf.tier",
			"term.perf.twr",
			"term.perf.dd",
			"trade.skillScore",
			"trade.avgDaily",
		}
		local tiles: { [string]: TextLabel } = {}
		for index, key in ipairs(keys) do
			tiles[key] = UI.StatTile(grid, T(key), index)
		end
		view.Parts.Grid = grid
		view.Parts.Tiles = tiles
		local sparkCard = UI.Card({
			Name = "NavCurve",
			Size = UDim2.new(1, 0, 0, 90),
			LayoutOrder = 2,
			Parent = view.Frame,
		})
		view.Parts.SparkTitle = UI.Create("TextLabel", {
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -24, 0, 16),
			BackgroundTransparency = 1,
			FontFace = UI.Faces.BodyBold,
			TextSize = 12,
			TextColor3 = Theme.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "",
			Parent = sparkCard,
		})
		local sparkHolder: Frame = UI.Create("Frame", {
			Position = UDim2.fromOffset(12, 26),
			Size = UDim2.new(1, -24, 1, -34),
			BackgroundTransparency = 1,
			Parent = sparkCard,
		})
		view.Parts.Spark = UI.Sparkline(sparkHolder, 72)
		view.Parts.FillsTitle = UI.Section(view.Frame, "", 3)
		view.Parts.Fills = {}
		for index = 1, MAX_FILL_ROWS do
			local card: Frame = UI.RowCard(view.Frame, 10 + index, 34)
			table.insert(view.Parts.Fills, {
				Card = card,
				Text = cell(card, 0, 1, {
					Position = UDim2.fromOffset(12, 0),
					Size = UDim2.new(1, -24, 1, 0),
					TextSize = 12,
				}),
			})
			card.Visible = false
		end
	end
	local tiles = view.Parts.Tiles
	for key, label in pairs(tiles) do
		local caption = label.Parent and label.Parent:FindFirstChild("Caption")
		if caption and caption:IsA("TextLabel") then
			setText(caption, T(key))
		end
	end
	local stats = depot().Stats
	stats = if type(stats) == "table" then stats else {}
	local wins, losses = num(stats.Wins, 0), num(stats.Losses, 0)
	setText(tiles["term.perf.trades"], tostring(math.floor(num(stats.Trades, 0))))
	setText(tiles["term.perf.hit"], if wins + losses > 0 then pct(wins / (wins + losses), 0) else "–")
	setText(tiles["term.perf.best"], if num(stats.BestPct, 0) ~= 0 then pct(num(stats.BestPct, 0)) else "–")
	local l = league()
	local tier = if type(l.Tier) == "string" then l.Tier else "None"
	setText(tiles["term.perf.tier"], T("trade.tier" .. (if tier == "None" then "None" else tier)))
	local returns, navs = dayReturns()
	local twr = 0
	local dd = 0
	if #returns > 0 then
		local okTwr, valueTwr = pcall(PortfolioMath.Twr, returns)
		twr = if okTwr and type(valueTwr) == "number" then valueTwr else 0
		local okDd, valueDd = pcall(PortfolioMath.MaxDrawdown, returns)
		dd = if okDd and type(valueDd) == "number" then valueDd else 0
	end
	-- Profi-Kennzahlen nur in der Profi-Schicht (§B7.2)
	for _, key in ipairs({ "term.perf.twr", "term.perf.dd", "trade.skillScore", "trade.avgDaily" }) do
		local tile = tiles[key]
		if tile.Parent and tile.Parent:IsA("GuiObject") then
			tile.Parent.Visible = pro
		end
	end
	if pro then
		setText(tiles["term.perf.twr"], if #returns > 0 then pct(twr) else "–")
		tiles["term.perf.twr"].TextColor3 = UI.TrendColor(twr)
		setText(tiles["term.perf.dd"], if #returns > 0 then pct(-dd) else "–")
		setText(tiles["trade.skillScore"], tostring(math.floor(num(l.SkillScore, 0))))
		local avg = num(l.AvgDailyBp, 0) / 10000
		setText(tiles["trade.avgDaily"], pct(avg))
		tiles["trade.avgDaily"].TextColor3 = UI.TrendColor(avg)
	end
	setText(view.Parts.SparkTitle, UI.Upper(T("term.perf.curve")))
	view.Parts.Spark.Set(navs)
	setText(view.Parts.FillsTitle, T("term.perf.fills"))
	local fills = if history then history.Fills else {}
	local shown = 0
	for index = #fills, 1, -1 do
		if shown >= MAX_FILL_ROWS then
			break
		end
		local fill = fills[index]
		if type(fill) == "table" then
			shown += 1
			local row = view.Parts.Fills[shown]
			local side = T(if fill[3] == "B" or fill[3] == 1 then "term.side.B" else "term.side.S")
			local text = string.format(
				"%s · %s %d × %s",
				tickerOf(num(fill[2], 0)),
				side,
				num(fill[4], 0),
				price(num(fill[5], 0))
			)
			local pnl = fill[7]
			if type(pnl) == "number" and pnl ~= 0 then
				text ..= string.format(
					'  <font color="%s">%s %s</font>',
					UI.ColorHex(UI.TrendColor(pnl)),
					UI.TrendArrow(pnl),
					aky(pnl, true)
				)
			end
			setText(row.Text, text)
			row.Card.Visible = true
		end
	end
	for index = shown + 1, MAX_FILL_ROWS do
		view.Parts.Fills[index].Card.Visible = false
	end
end

-- ---------------------------------------------------------------------
-- MONTIEREN / AKTUALISIEREN
-- ---------------------------------------------------------------------
local UPDATERS: { [string]: (View) -> () } = {
	Positions = updatePositions,
	Orders = updateOrders,
	Alerts = updateAlerts,
	Overview = updateOverview,
	Bots = updateBots,
	Performance = updatePerformance,
}

local function onScreen(inst: Instance): boolean
	local current: Instance? = inst
	local guard = 0
	while current and guard < 32 do
		guard += 1
		if current:IsA("GuiObject") then
			if not current.Visible then
				return false
			end
		elseif current:IsA("LayerCollector") then
			return current.Enabled
		end
		current = current.Parent
	end
	return false
end

local function updateView(view: View)
	if not view.Alive then
		return
	end
	local ok, err = pcall(view.Update, view)
	if not ok then
		warn("[DepotView] " .. view.Section .. ": " .. tostring(err))
	end
end

function DepotView.Refresh()
	for _, view in ipairs(views) do
		if view.Alive and onScreen(view.Frame) then
			updateView(view)
		end
	end
end

local function schedule()
	if pending then
		return
	end
	pending = true
	task.delay(REFRESH_GAP, function()
		pending = false
		DepotView.Refresh()
	end)
end

function DepotView.Mount(parent: Instance, section: string): { [string]: any }
	local update = UPDATERS[section] or updatePositions
	local view: View = {
		Section = if UPDATERS[section] then section else "Positions",
		Frame = newList(parent),
		Alive = true,
		Rows = {},
		Parts = {},
		Update = update,
	}
	table.insert(views, view)
	updateView(view)
	return {
		Frame = view.Frame,
		Refresh = function()
			updateView(view)
		end,
		Destroy = function()
			view.Alive = false
			local index = table.find(views, view)
			if index then
				table.remove(views, index)
			end
			view.Frame:Destroy()
		end,
	}
end

function DepotView.Open(section: string?)
	call("Terminal", "Open")
	call("Terminal", "ShowTab", section or "Overview")
end

function DepotView.Init(context: any)
	ctx = context
	local hooks = ctx.Hooks
	hooks.On("State", function(_state, changed)
		if type(changed) ~= "table" then
			return
		end
		if changed.Depot or changed.League or changed.Prog then
			schedule()
		end
	end)
	hooks.On("Quotes", function()
		schedule() -- G/V und Depotwert live (1 Hz)
	end)
	hooks.On("Settings", schedule)
end

function DepotView.Start() end

return DepotView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Effekt-Registry + Kern-Effekte (Client/Modules/Effects)
--  Besitzer: WP2 (Client-Plattform & UI-Kit). Vertrag: DESIGN.md §C7.4 (frozen Registry), §C7.5. Basis: CC-Effects
--  (announce/adminWarn/Konfetti/Münzflug 1:1, REUSE §1.4) + Register/Play.
--
--  Remote "Effect"(name, strength, data) -> Main.client -> Effects.Play -> danach Hook "Effect:<Name>".
--  Ein Effekt = ein Besitzer (CC-Fix „eine Meldung, ein Weg“): Kern-Effekte gehören diesem Modul, alle anderen
--  registriert ihr Besitzer-Modul in seinem Init mit Effects.Register(name, fn(strength, data)).
--  Kern-Effekte (WP2):
--    "Announce"  {Text, UserId, Name}  Besitzer-Ansage oben in der Mitte: rundes Kopfbild, Name in Accent + selbst
--                gezeichneter Haken, ":" und Text – ohne Kasten, ~8 s. Ohne UserId/Name (System-Ansage von
--                CommunityService.Announce) = Toast "Announce" (kein falscher Haken, REUSE §7 #6).
--    "AdminWarn" {Text}                Hinweis in der Bildschirmmitte: Titel in Down + Unterstrich
--    "Confetti"  (strength = Menge)    Konfetti-Kanonen links/rechts (nur Meilensteine – §0.3 Punkt 6)
--    "CoinFly"   (strength = CR)       grüne CR-Chips fliegen zum CR-Zähler im HUD (Tresor einsammeln)
--    "Flash"     {Color?, Text?, Key?, Args?}  Akzent-Glühen an den Rändern + zentrierter Titel (BuilderExtended)
--    "Shake"     (strength)            Kamera wackeln (Einstellung "Kamerawackeln" 0–100 %, ReducedFx dämpft)
--    "Toast"     {Text? | Key?, Args?, Kind?}  lokalisierte Meldung als Toast
--  Frozen Namen anderer Besitzer (§C7.4): Bell, ReadWell, DayRecap (WP5) · BuildDone, StageUp, TransferTube, Collect,
--  Crane (WP8) · Reveal (WP7) · IpoCeremony, LicenceUp, TitleUp, QuestDone, Achievement (WP9) · MoneyRain, BullParade,
--  Bear, GoldenBull, SkyShow, Fireworks, BossAppear, AbuseBanner, BellMoment (WP11).
--
--  Öffentliche API (§C7.5):
--    Effects.Register(name, fn)   Effects.Play(name, strength, data?)   Effects.SetHidden(on)
--  Zusätzlich: Effects.IsHidden(), Effects.Overlay(): ScreenGui? (unskalierte Effekt-Ebene für andere Besitzer),
--    Effects.Flash(color, text?), Effects.Burst(pos, color, amount, flash?), Effects.Ring(pos, color, size, time?),
--    Effects.Puff(pos, color, amount), Effects.Shake(strength), Effects.Confetti(amount?), Effects.Frame(dt),
--    Effects.Init(ctx), Effects.Start()
-- =====================================================================

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local Effects = {}

local player = Players.LocalPlayer
local ctx: any = nil
local fxFolder: Folder? = nil
local overlay: ScreenGui? = nil -- eigene Ebene (ohne UIScale -> Pixel = Bildschirm-Pixel)
local hidden = false

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

-- Kern-Effekte (gehören diesem Modul) und eingefrorene Namen der anderen Besitzer (§C7.4)
local CORE: { [string]: boolean } = {
	Announce = true,
	AdminWarn = true,
	Confetti = true,
	CoinFly = true,
	Flash = true,
	Shake = true,
	Toast = true,
}
local FROZEN: { [string]: string } = {
	Bell = "WP5",
	ReadWell = "WP5",
	DayRecap = "WP5",
	BuildDone = "WP8",
	StageUp = "WP8",
	TransferTube = "WP8",
	Collect = "WP8",
	Crane = "WP8",
	Reveal = "WP7",
	IpoCeremony = "WP9",
	LicenceUp = "WP9",
	TitleUp = "WP9",
	QuestDone = "WP9",
	Achievement = "WP9",
	MoneyRain = "WP11",
	BullParade = "WP11",
	Bear = "WP11",
	GoldenBull = "WP11",
	SkyShow = "WP11",
	Fireworks = "WP11",
	BossAppear = "WP11",
	AbuseBanner = "WP11",
	BellMoment = "WP11",
}

local registered: { [string]: (number, any) -> () } = {}
local warnedName: { [string]: boolean } = {}

local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function sfx(role: string, pos: Vector3?, opts: any?)
	local module = ctx and ctx.Modules and ctx.Modules.Sfx
	if module and type(module.Play) == "function" then
		pcall(module.Play, role, pos, opts)
	end
end

local function setting(key: string): any
	local module = ctx and ctx.Modules and ctx.Modules.Settings
	if module and type(module.Get) == "function" then
		local ok, settings = pcall(module.Get)
		if ok and type(settings) == "table" then
			return settings[key]
		end
	end
	return nil
end

local function reducedFx(): boolean
	return setting("ReducedFx") == true
end

-- Partikel-Faktor der Grafikstufe (Low 0.3 … Ultra 1)
local function particleFactor(): number
	local quality = ctx and ctx.Modules and ctx.Modules.Quality
	if quality and type(quality.Budget) == "function" then
		local ok, value = pcall(quality.Budget, "Particles")
		if ok and type(value) == "number" and value == value then
			return math.clamp(value, 0, 1)
		end
	end
	return 1
end

-- Farbe aus Daten: Color3 oder Theme-Token ("Accent", "Up", "Down", "Warn", "Gold" …)
local function colorFrom(value: any, fallback: Color3): Color3
	if typeof(value) == "Color3" then
		return value
	end
	if type(value) == "string" then
		local token = (UI.Theme :: any)[value]
		if typeof(token) == "Color3" then
			return token
		end
	end
	return fallback
end

-- Text aus Daten: fertiger Text (Server hat lokalisiert) oder Lang-Schlüssel + Argumente
local function textFrom(data: any): string?
	if type(data) ~= "table" then
		return nil
	end
	if type(data.Text) == "string" and data.Text ~= "" then
		return string.sub(data.Text, 1, 500)
	end
	if type(data.Key) == "string" and data.Key ~= "" then
		local args = if type(data.Args) == "table" then data.Args else {}
		local ok, text = pcall(T, data.Key, table.unpack(args, 1, math.min(#args, 16)))
		if ok and type(text) == "string" then
			return text
		end
	end
	return nil
end

-- ---------------------------------------------------------------------
-- WELT-BAUSTEINE: Funken, Druckwelle, Puff – Reichweiten-Grenze + Licht-Budget
-- ---------------------------------------------------------------------
local BURST_RANGE = 450
local FLASH_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SHELL_INFO = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FLASH_WINDOW = 0.25
local MAX_FLASHES = 3
local flashWindowStart = 0
local flashCount = 0

local function localPart(props: { [string]: any }): Part
	local base: { [string]: any } = {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	}
	for key, value in pairs(props) do
		base[key] = value
	end
	return UI.Create("Part", base)
end

local function makeEmitter(color: Color3, parent: Instance, big: boolean): ParticleEmitter
	return UI.Create("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(color:Lerp(WHITE, 0.45), color),
		LightEmission = 0.4,
		LightInfluence = 0,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, big and 1.4 or 0.8),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.7, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.5, big and 1.2 or 0.7),
		Speed = NumberRange.new(big and 16 or 8, big and 34 or 16),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -28, 0),
		Drag = 2,
		RotSpeed = NumberRange.new(-220, 220),
		Rate = 0,
		Parent = parent,
	})
end

local function inRange(position: Vector3): boolean
	local camera = workspace.CurrentCamera
	return not camera or (camera.CFrame.Position - position).Magnitude <= BURST_RANGE
end

local function burst(position: Vector3, color: Color3, amount: number, flash: boolean)
	local folder = fxFolder
	if not folder or hidden or typeof(position) ~= "Vector3" or not inRange(position) then
		return
	end
	amount *= particleFactor()
	if reducedFx() then
		flash = false
		amount *= 0.5
	end
	if flash then
		local t = os.clock()
		if t - flashWindowStart > FLASH_WINDOW then
			flashWindowStart = t
			flashCount = 0
		end
		flashCount += 1
		if flashCount > MAX_FLASHES then
			flash = false
			amount *= 0.5
		end
	end
	local holder = localPart({
		Name = "Burst",
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
		CFrame = CFrame.new(position),
		Parent = folder,
	})
	local emitter = makeEmitter(color, holder, flash)
	emitter:Emit(math.clamp(math.floor(amount), 1, 120))
	if flash then
		local light: PointLight = UI.Create("PointLight", {
			Color = color,
			Range = 26,
			Brightness = 8,
			Shadows = false,
			Parent = holder,
		})
		TweenService:Create(light, FLASH_INFO, { Brightness = 0, Range = 6 }):Play()
		local shell = localPart({
			Name = "Flash",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1),
			Material = Enum.Material.Neon,
			Color = color,
			Transparency = 0.2,
			CFrame = CFrame.new(position),
			Parent = folder,
		})
		TweenService:Create(shell, SHELL_INFO, { Size = Vector3.new(13, 13, 13), Transparency = 1 }):Play()
		Debris:AddItem(shell, 0.5)
	end
	Debris:AddItem(holder, 2)
end

local function ring(position: Vector3, color: Color3, size: number, time: number)
	local folder = fxFolder
	if not folder or hidden or typeof(position) ~= "Vector3" or not inRange(position) then
		return
	end
	local cf = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2)
	local wave = localPart({
		Name = "Shockwave",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.15, 1, 1),
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.25,
		CFrame = cf,
		Parent = folder,
	})
	local info = TweenInfo.new(time, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	TweenService:Create(wave, info, { Size = Vector3.new(0.05, size, size), Transparency = 1 }):Play()
	Debris:AddItem(wave, time + 0.05)
end

local function puff(position: Vector3, color: Color3, amount: number)
	local folder = fxFolder
	if not folder or hidden or typeof(position) ~= "Vector3" or not inRange(position) then
		return
	end
	local holder = localPart({
		Name = "Puff",
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
		CFrame = CFrame.new(position),
		Parent = folder,
	})
	local poof: ParticleEmitter = UI.Create("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/smoke_main.dds",
		Color = ColorSequence.new(WHITE, color:Lerp(WHITE, 0.3)),
		LightEmission = 0.3,
		LightInfluence = 0,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(0.35, 1.5),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.7, 0.25),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.4, 0.7),
		Speed = NumberRange.new(7, 13),
		SpreadAngle = Vector2.new(80, 10),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -8, 0),
		Drag = 5,
		RotSpeed = NumberRange.new(-120, 120),
		Rotation = NumberRange.new(0, 360),
		Rate = 0,
		Parent = holder,
	})
	local count = math.clamp(math.floor(amount * 0.7 * particleFactor()), 1, 20)
	if reducedFx() then
		count = math.max(1, math.floor(count / 2))
	end
	poof:Emit(count)
	Debris:AddItem(holder, 1)
end

-- ---------------------------------------------------------------------
-- WACKELN: weicher Kameraversatz über Humanoid.CameraOffset (dezent, abklingend)
-- ---------------------------------------------------------------------
local SHAKE_TIME = 0.4
local SHAKE_SCALE = 0.55
local SHAKE_MAX = 1.2
local SHAKE_FREQ = 18
local shakeStrength = 0
local shakeClock = 0
local shakeLeft = 0
local shakeHumanoid: Humanoid? = nil

local function shake(strength: number)
	if type(strength) ~= "number" or strength ~= strength or strength <= 0 then
		return
	end
	local mult = setting("Shake")
	if type(mult) == "number" then
		strength *= math.clamp(mult, 0, 1)
	end
	if reducedFx() then
		strength *= 0.3
	end
	if strength <= 0.001 then
		return
	end
	strength = math.min(strength * SHAKE_SCALE, SHAKE_MAX)
	local current = if shakeLeft > 0 then shakeStrength * (shakeLeft / SHAKE_TIME) else 0
	if strength >= current then
		shakeStrength = strength
		shakeLeft = SHAKE_TIME
	end
end

local function stepShake(dt: number)
	if shakeLeft <= 0 then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid ~= shakeHumanoid and shakeHumanoid and shakeHumanoid.Parent then
		shakeHumanoid.CameraOffset = Vector3.zero
	end
	shakeHumanoid = humanoid
	shakeLeft -= dt
	if not humanoid then
		return
	end
	if shakeLeft <= 0 then
		humanoid.CameraOffset = Vector3.zero
		return
	end
	local fade = shakeLeft / SHAKE_TIME
	local power = shakeStrength * fade * fade
	shakeClock += dt * SHAKE_FREQ
	humanoid.CameraOffset = Vector3.new(math.noise(shakeClock, 0.5), math.noise(0.5, shakeClock), 0) * power
end

-- ---------------------------------------------------------------------
-- CR-FLUG zum CR-Zähler (fester Vorrat aus Sechskant-Chips)
-- ---------------------------------------------------------------------
type Coin = { Holder: Frame, Busy: boolean }
local COIN_OUT_INFO = TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local coinPool: { Coin } = {}

local function buildCoins()
	local gui = overlay
	if not gui then
		return
	end
	local count = 16
	local config = ctx and ctx.Config
	local pools = config and config.Client and config.Client.Pools
	if pools and type(pools.CoinFly) == "number" then
		count = math.clamp(math.floor(pools.CoinFly), 4, 32)
	end
	for _ = 1, count do
		local holder: Frame = UI.Create("Frame", {
			Name = "Coin",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(28, 28),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 30,
			Parent = gui,
		})
		local icon = UI.CurrencyIcon(holder, "CR", 28)
		icon.Size = UDim2.fromScale(1, 1)
		table.insert(coinPool, { Holder = holder, Busy = false })
	end
end

local function hudCall(fnName: string, ...: any): (boolean, any)
	local hud = ctx and ctx.Modules and ctx.Modules.Hud
	local fn = hud and hud[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function flyCoins(amount: number)
	local gui = overlay
	local camera = workspace.CurrentCamera
	if not gui or hidden or not camera or #coinPool == 0 then
		return
	end
	local ok, target = hudCall("CreditsAnchor")
	if not ok or typeof(target) ~= "Vector2" then
		return
	end
	local goal = UDim2.fromOffset(target.X, target.Y)
	local size = gui.AbsoluteSize
	local start = Vector2.new(size.X / 2, size.Y * 0.55)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local point, onScreen = camera:WorldToScreenPoint(root.Position)
		if onScreen then
			start = Vector2.new(point.X, point.Y)
		end
	end
	local count = math.clamp(math.floor(3 + math.log10(math.max(amount, 1)) * 1.5), 4, #coinPool)
	if reducedFx() then
		count = math.max(3, math.floor(count / 2))
	end
	sfx("CashRegister")
	local launched = 0
	for _, coin in ipairs(coinPool) do
		if launched >= count then
			break
		end
		if not coin.Busy then
			launched += 1
			coin.Busy = true
			local holder = coin.Holder
			local angle = math.random() * math.pi * 2
			local spread = 40 + math.random() * 70
			local midX = start.X + math.cos(angle) * spread
			local midY = start.Y + math.sin(angle) * spread * 0.7 - 30
			holder.Position = UDim2.fromOffset(start.X, start.Y)
			holder.Size = UDim2.fromOffset(12, 12)
			holder.Rotation = math.random(-40, 40)
			holder.Visible = true
			local out = TweenService:Create(holder, COIN_OUT_INFO, {
				Position = UDim2.fromOffset(midX, midY),
				Size = UDim2.fromOffset(28, 28),
				Rotation = holder.Rotation + math.random(-120, 120),
			})
			local delay = launched * 0.04
			out.Completed:Once(function()
				local flyInfo = TweenInfo.new(
					0.4 + math.random() * 0.15,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In,
					0,
					false,
					delay
				)
				local fly = TweenService:Create(holder, flyInfo, {
					Position = goal,
					Size = UDim2.fromOffset(16, 16),
					Rotation = 0,
				})
				fly.Completed:Once(function()
					holder.Visible = false
					coin.Busy = false
					if not hidden then
						hudCall("PulseCredits", 0.06)
					end
				end)
				fly:Play()
			end)
			out:Play()
		end
	end
end

-- ---------------------------------------------------------------------
-- KONFETTI: Kanonen links und rechts unten, Wurfparabel, Drehen + Flattern (nur Meilensteine)
-- ---------------------------------------------------------------------
local CONFETTI_GRAVITY = 1500
local maxConfetti = 140
local confettiAlive = 0

local function confettiPiece(gui: ScreenGui, x: number, y: number, vx: number, vy: number, color: Color3)
	local screen = gui.AbsoluteSize
	local tUp = vy / CONFETTI_GRAVITY
	local peak = y - vy * vy / (2 * CONFETTI_GRAVITY)
	local fallDistance = screen.Y + 30 - peak
	local tDown = math.sqrt(2 * math.max(1, fallDistance) / CONFETTI_GRAVITY) * 1.9
	local life = tUp + tDown
	local width, height = math.random(8, 14), math.random(10, 16)
	local holder: Frame = UI.Create("Frame", {
		Size = UDim2.fromOffset(0, 0),
		Position = UDim2.fromOffset(x, y),
		BackgroundTransparency = 1,
		ZIndex = 25,
		Parent = gui,
	})
	local piece: Frame = UI.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Rotation = math.random(0, 360),
		ZIndex = 25,
		Parent = holder,
	})
	if math.random() < 0.35 then
		UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = piece })
	end
	TweenService:Create(
		holder,
		TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(x + vx * 0.9, y) }
	):Play()
	TweenService:Create(piece, TweenInfo.new(life, Enum.EasingStyle.Linear), {
		Rotation = piece.Rotation + math.random(-720, 720),
	}):Play()
	TweenService:Create(
		piece,
		TweenInfo.new(0.18 + math.random() * 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Size = UDim2.fromOffset(math.max(2, width * 0.15), height) }
	):Play()
	local up = TweenService:Create(
		piece,
		TweenInfo.new(tUp, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(0, peak - y) }
	)
	up.Completed:Once(function()
		local down = TweenService:Create(
			piece,
			TweenInfo.new(tDown, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Position = UDim2.fromOffset(0, screen.Y + 30 - y) }
		)
		down.Completed:Once(function()
			confettiAlive -= 1
			holder:Destroy()
		end)
		down:Play()
	end)
	up:Play()
end

local function confetti(amount: number)
	local gui = overlay
	if not gui or hidden then
		return
	end
	local theme = UI.Theme
	local colors = { theme.Accent, theme.Up, theme.Gold, theme.Cosmic2, theme.Cosmic3, theme.Cyan }
	local mult = math.clamp(tonumber(amount) or 1, 0.3, 3)
	local count = math.floor(32 * mult * math.max(0.4, particleFactor()))
	if reducedFx() then
		count = math.floor(count / 2)
	end
	count = math.min(count, maxConfetti - confettiAlive)
	local screen = gui.AbsoluteSize
	if screen.Y < 10 or count <= 0 then
		return
	end
	for i = 1, count do
		confettiAlive += 1
		local left = i % 2 == 0
		local x = if left then screen.X * 0.04 else screen.X * 0.96
		local y = screen.Y + 10
		local rise = screen.Y * (0.35 + math.random() * 0.5)
		local vy = math.sqrt(2 * CONFETTI_GRAVITY * rise)
		local vx = (screen.X * (0.12 + math.random() * 0.4)) * (if left then 1 else -1)
		confettiPiece(gui, x, y, vx, vy, colors[math.random(1, #colors)])
	end
end

-- ---------------------------------------------------------------------
-- GROSSER BLITZ MIT TEXT (Meilensteine): Akzent-Glühen an den Rändern + Titel in BuilderExtended
-- ---------------------------------------------------------------------
local FLASH_FADE_INFO = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FLASH_POP_INFO = TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local FLASH_OUT_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 1.1)
local flashBusy = false

function Effects.Flash(color: Color3, text: string?)
	local gui = overlay
	if not gui or hidden or flashBusy then
		return
	end
	flashBusy = true
	local tint = if typeof(color) == "Color3" then color else UI.Theme.Accent
	local glow: Frame = UI.Create("Frame", {
		Name = "BigFlash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = tint,
		BackgroundTransparency = if reducedFx() then 0.8 else 0.55,
		BorderSizePixel = 0,
		ZIndex = 40,
		Parent = gui,
	}, {
		-- Mitte durchsichtig, Ränder farbig (Vignette statt weißem Vollbild)
		UI.Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.3, 0.85),
				NumberSequenceKeypoint.new(0.7, 0.85),
				NumberSequenceKeypoint.new(1, 0),
			}),
		}),
	})
	local label: TextLabel? = nil
	if text and text ~= "" then
		local textScale: UIScale = UI.Create("UIScale", { Scale = 0.9 })
		local newLabel = UI.Label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.4),
			Size = UDim2.new(0.8, 0, 0, 80),
			Text = text,
			Face = "Display",
			TextColor3 = WHITE,
			MaxText = 56,
			ZIndex = 41,
			Parent = gui,
		})
		textScale.Parent = newLabel
		local glowStroke: UIStroke = UI.Create("UIStroke", {
			Color = tint,
			Thickness = 3,
			Transparency = 0.6,
			LineJoinMode = Enum.LineJoinMode.Round,
			Parent = newLabel,
		})
		local line: Frame = UI.Create("Frame", {
			Name = "Underline",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 1, 4),
			Size = UDim2.fromOffset(96, 3),
			BackgroundColor3 = tint,
			BorderSizePixel = 0,
			ZIndex = 41,
			Parent = newLabel,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
		newLabel.TextTransparency = 1
		TweenService:Create(newLabel, FLASH_POP_INFO, { TextTransparency = 0 }):Play()
		TweenService:Create(textScale, FLASH_POP_INFO, { Scale = 1 }):Play()
		TweenService:Create(glowStroke, FLASH_OUT_INFO, { Transparency = 1 }):Play()
		TweenService:Create(line, FLASH_OUT_INFO, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(newLabel, FLASH_OUT_INFO, { TextTransparency = 1 }):Play()
		label = newLabel
	end
	TweenService:Create(glow, FLASH_FADE_INFO, { BackgroundTransparency = 1 }):Play()
	task.delay(1.6, function()
		glow:Destroy()
		if label then
			label:Destroy()
		end
		flashBusy = false
	end)
end

-- ---------------------------------------------------------------------
-- BESITZER-ANSAGE (CC 1:1): Kopfbild, Name in Accent + Haken, ":" und Text – ohne Kasten
-- ---------------------------------------------------------------------
local ANNOUNCE_BLUE = UI.Theme.Accent
local ANNOUNCE_TIME = 8
local ANNOUNCE_MAX_QUEUE = 5
local ANNOUNCE_AVATAR = 64
local ANNOUNCE_NAME_SIZE = 28
local ANNOUNCE_BADGE = 24
local ANNOUNCE_Y = 14
local ANNOUNCE_IN = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local ANNOUNCE_FADE_IN = TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local ANNOUNCE_FONT = UI.Fonts.Main
local ANNOUNCE_OUT = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local THUMB_CACHE_MAX = 64

type AnnounceUI = {
	Group: CanvasGroup,
	Scale: UIScale,
	Avatar: ImageLabel,
	Name: TextLabel,
	Badge: Frame,
	Colon: TextLabel,
	Text: TextLabel,
}
local announceUI: AnnounceUI? = nil
local announceQueue: { any } = {}
local announceBusy = false
local thumbCache: { [number]: string } = {}
local thumbCount = 0

local function textStroke(parent: Instance)
	UI.Create("UIStroke", {
		Thickness = 1,
		Color = BLACK,
		Transparency = 0.45,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

local function buildAnnounce(): AnnounceUI?
	local gui = overlay
	if not gui then
		return nil
	end
	local group: CanvasGroup = UI.Create("CanvasGroup", {
		Name = "OwnerAnnounce",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, ANNOUNCE_Y),
		Size = UDim2.new(0.86, 0, 0, 96),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	local scale: UIScale = UI.Create("UIScale", { Scale = 1, Parent = group })
	local avatar: ImageLabel = UI.Create("ImageLabel", {
		Name = "Avatar",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 4, 0.5, 0),
		Size = UDim2.fromOffset(ANNOUNCE_AVATAR, ANNOUNCE_AVATAR),
		BackgroundColor3 = UI.Theme.Surface2,
		Image = "",
		ZIndex = 31,
		Parent = group,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	UI.Create("UIStroke", {
		Thickness = 1.5,
		Color = ANNOUNCE_BLUE,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = avatar,
	})
	local nameLabel: TextLabel = UI.Create("TextLabel", {
		Name = "Name",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, ANNOUNCE_AVATAR + 14, 0.5, 0),
		Size = UDim2.fromOffset(100, 44),
		BackgroundTransparency = 1,
		Font = ANNOUNCE_FONT,
		TextSize = ANNOUNCE_NAME_SIZE,
		TextColor3 = ANNOUNCE_BLUE,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
		Parent = group,
	})
	textStroke(nameLabel)
	-- Haken-Badge (selbst gezeichnet): zwei gedrehte blaue Quadrate = Zackenkreis, weißer Haken
	local badge: Frame = UI.Create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(ANNOUNCE_BADGE, ANNOUNCE_BADGE),
		BackgroundTransparency = 1,
		ZIndex = 31,
		Parent = group,
	})
	for _, rotation in ipairs({ 0, 45 }) do
		UI.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.78, 0.78),
			Rotation = rotation,
			BackgroundColor3 = ANNOUNCE_BLUE,
			BorderSizePixel = 0,
			ZIndex = 31,
			Parent = badge,
		}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.2, 0) }) })
	end
	UI.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = UI.Fonts.Strong,
		Text = "✓",
		TextScaled = true,
		TextColor3 = WHITE,
		ZIndex = 32,
		Parent = badge,
	})
	local colon: TextLabel = UI.Create("TextLabel", {
		Name = "Colon",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(14, 44),
		BackgroundTransparency = 1,
		Font = ANNOUNCE_FONT,
		TextSize = ANNOUNCE_NAME_SIZE,
		Text = ":",
		TextColor3 = UI.Theme.Text2,
		ZIndex = 31,
		Parent = group,
	})
	textStroke(colon)
	local text: TextLabel = UI.Create("TextLabel", {
		Name = "Text",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		Font = ANNOUNCE_FONT,
		TextScaled = true,
		TextWrapped = true,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
		Parent = group,
	})
	UI.Create("UITextSizeConstraint", { MaxTextSize = 34, MinTextSize = 14, Parent = text })
	textStroke(text)
	return {
		Group = group,
		Scale = scale,
		Avatar = avatar,
		Name = nameLabel,
		Badge = badge,
		Colon = colon,
		Text = text,
	}
end

local function headshot(userId: number): string
	local cached = thumbCache[userId]
	if cached then
		return cached
	end
	if userId <= 0 then
		return ""
	end
	local ok, image = pcall(function()
		return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
	end)
	if ok and type(image) == "string" then
		if thumbCount >= THUMB_CACHE_MAX then
			table.clear(thumbCache)
			thumbCount = 0
		end
		thumbCache[userId] = image
		thumbCount += 1
		return image
	end
	return ""
end

local function layoutAnnounce(ui: AnnounceUI, name: string)
	local nameWidth = TextService:GetTextSize(name, ANNOUNCE_NAME_SIZE, ANNOUNCE_FONT, Vector2.new(1000, 100)).X + 4
	local x = ANNOUNCE_AVATAR + 14
	ui.Name.Size = UDim2.fromOffset(nameWidth, 44)
	x += nameWidth + 6
	ui.Badge.Position = UDim2.new(0, x, 0.5, 0)
	x += ANNOUNCE_BADGE + 2
	ui.Colon.Position = UDim2.new(0, x, 0.5, 0)
	x += 18
	ui.Text.Position = UDim2.new(0, x, 0.5, 0)
	ui.Text.Size = UDim2.new(1, -x - 4, 1, -4)
end

local function showNextAnnounce()
	local ui = announceUI
	if not ui then
		return
	end
	announceBusy = true
	local guard = 0
	while #announceQueue > 0 and guard < 64 do
		guard += 1
		local data = table.remove(announceQueue, 1)
		local name = string.sub(tostring(data.Name or "Admin"), 1, 40)
		ui.Name.Text = name
		ui.Text.Text = string.sub(tostring(data.Text), 1, 500)
		ui.Avatar.Image = headshot(tonumber(data.UserId) or 0)
		layoutAnnounce(ui, name)
		ui.Group.Visible = not hidden
		ui.Group.GroupTransparency = 1
		ui.Group.Position = UDim2.new(0.5, 0, 0, ANNOUNCE_Y - 8)
		ui.Scale.Scale = 0.96
		TweenService:Create(ui.Group, ANNOUNCE_FADE_IN, { GroupTransparency = 0 }):Play()
		TweenService:Create(ui.Group, ANNOUNCE_IN, { Position = UDim2.new(0.5, 0, 0, ANNOUNCE_Y) }):Play()
		TweenService:Create(ui.Scale, ANNOUNCE_IN, { Scale = 1 }):Play()
		sfx("Notify")
		task.wait(ANNOUNCE_TIME)
		local out = TweenService:Create(ui.Group, ANNOUNCE_OUT, { GroupTransparency = 1 })
		out:Play()
		out.Completed:Wait()
		ui.Group.Visible = false
		task.wait(0.2)
	end
	announceBusy = false
end

local function announce(data: any)
	if type(data) ~= "table" or type(data.Text) ~= "string" or data.Text == "" then
		return
	end
	-- System-Ansage ohne Absender: schlanke Pill statt Besitzer-Banner (sonst stünde dort ein falscher Haken)
	local userId = tonumber(data.UserId) or 0
	if userId <= 0 and (type(data.Name) ~= "string" or data.Name == "") then
		UI.Toast(string.sub(data.Text, 1, 500), "Announce")
		return
	end
	if not announceUI then
		announceUI = buildAnnounce()
	end
	if #announceQueue >= ANNOUNCE_MAX_QUEUE then
		table.remove(announceQueue, 1) -- die älteste wartende Ansage fällt weg
	end
	table.insert(announceQueue, data)
	if not announceBusy then
		task.spawn(showNextAnnounce)
	end
end

-- ---------------------------------------------------------------------
-- ADMIN-WARNUNG (CC 1:1): große Überschrift in Down + weißer Text, feine Kontur, ohne Kasten
-- ---------------------------------------------------------------------
local WARN_TIME = 7
local WARN_IN = TweenInfo.new(0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local WARN_OUT = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local warnToken = 0
local warnFrame: Frame? = nil
local warnTitle: TextLabel? = nil
local warnText: TextLabel? = nil
local warnScale: UIScale? = nil

local function buildWarn()
	local gui = overlay
	if not gui or warnFrame then
		return
	end
	local frame: Frame = UI.Create("Frame", {
		Name = "AdminWarn",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.new(0.7, 0, 0, 170),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	}, {
		UI.Create("UISizeConstraint", { MinSize = Vector2.new(300, 0), MaxSize = Vector2.new(820, 400) }),
	})
	local scale: UIScale = UI.Create("UIScale", { Scale = 1, Parent = frame })
	local title = UI.Label({
		Size = UDim2.new(1, 0, 0, 44),
		Text = "",
		Face = "Display",
		TextColor3 = UI.Theme.Down,
		MaxText = 34,
		Outline = 1,
		ZIndex = 41,
		Parent = frame,
	})
	UI.Create("Frame", {
		Name = "Underline",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 50),
		Size = UDim2.fromOffset(84, 3),
		BackgroundColor3 = UI.Theme.Down,
		BorderSizePixel = 0,
		ZIndex = 41,
		Parent = frame,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local text = UI.Label({
		Position = UDim2.fromOffset(0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		Text = "",
		TextColor3 = WHITE,
		TextWrapped = true,
		MaxText = 30,
		Outline = 1,
		ZIndex = 41,
		Parent = frame,
	})
	warnFrame, warnTitle, warnText, warnScale = frame, title, text, scale
end

local function adminWarn(data: any)
	local message = textFrom(data)
	if not message then
		return
	end
	buildWarn()
	local frame, title, text, scale = warnFrame, warnTitle, warnText, warnScale
	if not frame or not title or not text or not scale then
		return
	end
	warnToken += 1
	local token = warnToken
	title.Text = T("ui.adminWarn")
	text.Text = message
	frame.Visible = not hidden
	scale.Scale = 0.94
	title.TextTransparency = 0
	text.TextTransparency = 0
	TweenService:Create(scale, WARN_IN, { Scale = 1 }):Play()
	shake(0.5)
	sfx("UIError")
	task.delay(WARN_TIME, function()
		if warnToken ~= token then
			return
		end
		TweenService:Create(title, WARN_OUT, { TextTransparency = 1 }):Play()
		TweenService:Create(text, WARN_OUT, { TextTransparency = 1 }):Play()
		local out = TweenService:Create(scale, WARN_OUT, { Scale = 0.96 })
		out.Completed:Once(function()
			if warnToken == token then
				frame.Visible = false
			end
		end)
		out:Play()
	end)
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICH: Registry + Abspielen
-- ---------------------------------------------------------------------
function Effects.Register(name: string, fn: (strength: number, data: any) -> ())
	if type(name) ~= "string" or name == "" or type(fn) ~= "function" then
		warn("[Effects] Register: Name (string) und Funktion erwartet")
		return
	end
	if CORE[name] then
		warn("[Effects] " .. name .. " ist ein Kern-Effekt von WP2 und kann nicht neu registriert werden")
		return
	end
	if registered[name] then
		warn("[Effects] " .. name .. " ist schon registriert – ein Effekt hat genau einen Besitzer (§C7.4)")
		return
	end
	if not FROZEN[name] and not warnedName[name] then
		warnedName[name] = true
		warn("[Effects] " .. name .. " steht nicht in der eingefrorenen Liste §C7.4 (Vertrags-Prüfer meldet das)")
	end
	registered[name] = fn
end

function Effects.Play(name: string, strength: number, data: any?)
	if type(name) ~= "string" then
		return
	end
	local amount = tonumber(strength) or 0
	if amount ~= amount or amount == math.huge or amount == -math.huge then
		amount = 0
	end
	if name == "Announce" then
		announce(data)
	elseif name == "AdminWarn" then
		adminWarn(data)
	elseif name == "Confetti" then
		confetti(if amount > 0 then amount else 1)
	elseif name == "CoinFly" then
		flyCoins(math.max(1, amount))
	elseif name == "Flash" then
		local tint = colorFrom(type(data) == "table" and data.Color or nil, UI.Theme.Accent)
		Effects.Flash(tint, textFrom(data))
	elseif name == "Shake" then
		shake(amount)
	elseif name == "Toast" then
		local message = textFrom(data)
		if message then
			local kind = if type(data) == "table" and type(data.Kind) == "string" then data.Kind else "Info"
			UI.Toast(message, kind)
		end
	else
		local fn = registered[name]
		if fn then
			local ok, err = pcall(fn, amount, data)
			if not ok then
				warn(("[Effects] %s: %s"):format(name, tostring(err)))
			end
		elseif not warnedName[name] then
			-- Besitzer-Modul (noch) nicht geladen: einmal melden, dann still ignorieren
			warnedName[name] = true
			warn("[Effects] Kein Besitzer für Effekt " .. name .. " geladen – wird ignoriert")
		end
	end
end

function Effects.Burst(position: Vector3, color: Color3, amount: number, flash: boolean?)
	burst(position, color, amount, flash == true)
end

function Effects.Ring(position: Vector3, color: Color3, size: number, time: number?)
	ring(position, color, size, time or 0.6)
end

function Effects.Puff(position: Vector3, color: Color3, amount: number)
	puff(position, color, amount)
end

function Effects.Shake(strength: number)
	shake(strength)
end

function Effects.Confetti(amount: number?)
	confetti(amount or 1)
end

function Effects.IsHidden(): boolean
	return hidden
end

-- Unskalierte Effekt-Ebene (Pixel = Bildschirm-Pixel) für Effekte anderer Besitzer
function Effects.Overlay(): ScreenGui?
	return overlay
end

-- Foto-Modus: Overlay (CR-Flug, Konfetti, Ansagen) aus
function Effects.SetHidden(on: boolean)
	hidden = on == true
	if overlay then
		overlay.Enabled = not hidden
	end
end

function Effects.Frame(dt: number)
	stepShake(dt)
end

function Effects.Init(context: any)
	ctx = context
	local config = ctx and ctx.Config
	local pools = config and config.Client and config.Client.Pools
	if pools and type(pools.Confetti) == "number" then
		maxConfetti = math.clamp(math.floor(pools.Confetti), 20, 300)
	end
	local folder = Instance.new("Folder")
	folder.Name = "AkytexTycoonClientFX"
	folder.Parent = workspace
	fxFolder = folder
	overlay = UI.Create("ScreenGui", {
		Name = "AkytexTycoonFX",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildCoins()
	player.CharacterAdded:Connect(function()
		shakeLeft = 0
		shakeHumanoid = nil
	end)
end

function Effects.Start() end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="134">
            <Properties>
              <string name="Name">EffectsEvent</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Event-Effekte (Client/Modules/EffectsEvent)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Vertrag: DESIGN.md §C7.4 (frozen Registry: MoneyRain, BullParade, Bear,
--  GoldenBull, SkyShow, Fireworks, BossAppear, AbuseBanner, BellMoment – ein Effekt = ein Besitzer), §A7 #6/#7
--  (Crash-Alarm: Bär, Rally: goldener Bulle), §B10 (Sky-Show, Feuerwerk, Bullen-Parade, Geldregen, Glocken-Moment),
--  §B15.3 (Admin-Abuse-Banner, Boss-Auftritt mit getweenter Winke-Pose), §0 Regel 2 (keine Animationen: Tweens/CFrames).
--
--  Effekte (Daten {Seconds, Plot?, UserId?, Text?, …} vom Server über PlayerStateService.Effect/EffectAll):
--    "AbuseBanner" {Kind, Seconds, Mult?, Until?, Sector?}  Glas-Banner oben (Golden Hour, XP-Rausch, Bau-Boom,
--                                                            Samstags-Show/Auto-Show, Alle in den Börsensaal …)
--    "MoneyRain"   {Seconds}            Banner + Neon-Münzen-Schauer um die Kamera (die echten Münzen sind Pickups)
--    "BullParade"  {Seconds, UserId, Name, Until}   Dank-Banner „Danke, <Name>!“ (ohne Robux-Betrag) + Fanfare
--    "Bear"        {Phase = "Arrive" | "Success" | "Leave", Goal?}   Crash-Alarm-Banner / Erfolg
--    "GoldenBull"  {Phase = "Run" | "Touch", Seconds?}               Rally-Banner / Bullen-Bonus-Blitz
--    "SkyShow"     {Seconds, Admin?, Finale?}   Fassaden-Lichtshow (Beams über allen Plots) + Feuerwerks-Beams
--    "Fireworks"   {Seconds, Plot?, UserId?}    20-s-Feuerwerk über dem Tower des Käufers (sonst über der Plaza)
--    "BossAppear"  {Seconds, UserId, Name}      Banner + Winke-Pose der Besitzer-Avatare auf dem Börsensaal-Dach
--    "BellMoment"  {Seconds, Count?, Mult?, Show?}   goldene Glocken-Welle an der Glocken-Zone + Blitz
--  Ruhig nach §0.3: kein Blinken, keine Münz-Kaskade pro Trade; Partikel nach Quality.Budget("Particles") und ReducedFx.
--  Läuft im EINEN PreRender-Loop: EventsClient.Frame ruft EffectsEvent.Step(dt) auf.
--
--  Öffentliche API:
--    EffectsEvent.Step(dt)          EffectsEvent.Init(ctx) · EffectsEvent.Start()
-- =====================================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local EffectsEvent = {}

local player = Players.LocalPlayer
local ctx: any = nil
local Theme = UI.Theme

local GOLD = Color3.fromRGB(250, 204, 21)
local COSMIC1 = Color3.fromRGB(59, 91, 219)
local COSMIC2 = Color3.fromRGB(124, 92, 255)
local COSMIC3 = Color3.fromRGB(179, 107, 255)
local WHITE = Color3.new(1, 1, 1)

local TEX_SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_SQUARE = "rbxasset://textures/particles/SquareParticle.png"
local TEX_RING = "rbxasset://textures/particles/explosion01_shockwave_main.dds"
local TEX_GLOW = "rbxasset://textures/particles/explosion01_implosion_main.dds"
local TEX_BEAM = "rbxasset://textures/gradient.png"

local BANNER_SECONDS = 6
local BANNER_QUEUE = 4
local SHOW_BEAMS_MAX = 10
local FIREWORK_GAP = 0.7
local MAX_SHOWS = 4
local BOSS_WAVE_SPEED = 3.2

type Banner = { Title: string, Sub: string, Color: Color3, Until: number?, Seconds: number }
type Show = {
	Kind: string, -- "Sky" | "Fireworks"
	Until: number,
	Next: number,
	Center: Vector3,
	Spread: number,
	Height: number,
	Parts: { Instance },
	Beams: { { Beam: Beam, Phase: number } },
}

-- ---------------------------------------------------------------------
-- ZUSTAND
-- ---------------------------------------------------------------------
local overlay: ScreenGui? = nil
local fxFolder: Folder? = nil
local bannerFrame: Frame? = nil
local bannerTitle: TextLabel? = nil
local bannerSub: TextLabel? = nil
local bannerBar: Frame? = nil
local bannerScale: UIScale? = nil
local bannerQueue: { Banner } = {}
local bannerCurrent: Banner? = nil
local bannerShownAt = 0
local shows: { Show } = {}
local rainPart: Part? = nil
local rainEmitter: ParticleEmitter? = nil
local rainUntil = 0
local rainSoundAt = 0
local boss: { Motors: { { Motor: Motor6D, Base: CFrame } }, Until: number, Phase: number }? = nil

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function module(name: string): any
	local modules = ctx and ctx.Modules
	return if type(modules) == "table" then modules[name] else nil
end

local function tryModule(name: string, fnName: string, ...: any): (boolean, any)
	local m = module(name)
	local fn = if type(m) == "table" then m[fnName] else nil
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function num(value: any, default: number): number
	return if type(value) == "number"
			and value == value
			and value ~= math.huge
			and value ~= -math.huge
		then value
		else default
end

local function now(): number
	local clock = ctx and ctx.Clock
	if clock and type(clock.Now) == "function" then
		local ok, value = pcall(clock.Now)
		if ok and type(value) == "number" then
			return value
		end
	end
	return workspace:GetServerTimeNow()
end

local function lang(): string
	if ctx and type(ctx.Lang_) == "function" then
		return ctx.Lang_()
	end
	return "en"
end

local function reducedFx(): boolean
	local ok, settings = tryModule("Settings", "Get")
	return ok and type(settings) == "table" and settings.ReducedFx == true
end

local function particleFactor(): number
	local ok, value = tryModule("Quality", "Budget", "Particles")
	local factor = if ok and type(value) == "number" then value else 1
	if reducedFx() then
		factor *= 0.4
	end
	return math.clamp(factor, 0.1, 1)
end

local function sfx(role: string, pos: Vector3?, opts: any?)
	tryModule("Sfx", "Play", role, pos, opts)
end

local function flash(color: Color3, text: string?)
	local effects = module("Effects")
	if effects and type(effects.Flash) == "function" then
		pcall(effects.Flash, color, text)
	end
end

local function plazaCenter(): Vector3
	local city = ctx and ctx.Config and ctx.Config.City
	local zones = city and city.Zones
	local plaza = zones and zones.Plaza
	if plaza and typeof(plaza.Center) == "Vector3" then
		return plaza.Center
	end
	return Vector3.zero
end

local function plotCFrame(plot: number?): CFrame?
	if type(plot) ~= "number" then
		return nil
	end
	local city = ctx and ctx.Config and ctx.Config.City
	if city and type(city.PlotCFrame) == "function" then
		local ok, cf = pcall(city.PlotCFrame, plot)
		if ok and typeof(cf) == "CFrame" then
			return cf
		end
	end
	return nil
end

local function plotSites(): { CFrame }
	local out: { CFrame } = {}
	local plots = math.floor(num(ctx and ctx.Config and ctx.Config.Server and ctx.Config.Server.Plots, 10))
	for k = 1, plots do
		local cf = plotCFrame(k)
		if cf then
			table.insert(out, cf)
		end
	end
	return out
end

local function localPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	for key, value in pairs(props) do
		(p :: any)[key] = value
	end
	p.Parent = fxFolder
	return p
end

local function emitter(
	parent: Instance,
	texture: string,
	color: ColorSequence,
	props: { [string]: any }
): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = color
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Enabled = false
	e.Rate = 0
	for key, value in pairs(props) do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

-- ---------------------------------------------------------------------
-- BANNER (Glas-Karte oben Mitte, eine nach der anderen)
-- ---------------------------------------------------------------------
local function buildBanner()
	local parent = overlay
	if not parent then
		return
	end
	local frame = UI.Create("Frame", {
		Name = "AT_EventBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 132),
		Size = UDim2.fromOffset(520, 78),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	}, { UI.Corner(16), UI.Stroke(nil, 1) })
	local scale = UI.Create("UIScale", { Scale = 1, Parent = frame })
	local bar = UI.Create("Frame", {
		Name = "Bar",
		Position = UDim2.fromOffset(14, 14),
		Size = UDim2.new(0, 4, 1, -28),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 21,
		Parent = frame,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local title = UI.Create("TextLabel", {
		Name = "Title",
		Position = UDim2.fromOffset(30, 10),
		Size = UDim2.new(1, -44, 0, 30),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Display,
		TextSize = 22,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "",
		ZIndex = 21,
		Parent = frame,
	})
	local sub = UI.Create("TextLabel", {
		Name = "Sub",
		Position = UDim2.fromOffset(30, 42),
		Size = UDim2.new(1, -44, 0, 24),
		BackgroundTransparency = 1,
		FontFace = UI.Faces.Body,
		TextSize = 15,
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "",
		ZIndex = 21,
		Parent = frame,
	})
	bannerFrame, bannerTitle, bannerSub, bannerBar, bannerScale = frame, title, sub, bar, scale
end

local function countdown(untilT: number?): string
	if type(untilT) ~= "number" then
		return ""
	end
	local left = math.max(0, untilT - now())
	local format = ctx and ctx.Format
	if format and type(format.Duration) == "function" then
		local ok, text = pcall(format.Duration, left, lang())
		if ok and type(text) == "string" then
			return text
		end
	end
	return ("%d:%02d"):format(math.floor(left / 60), math.floor(left % 60))
end

local function showBanner(b: Banner)
	local frame, title, sub, bar, scale = bannerFrame, bannerTitle, bannerSub, bannerBar, bannerScale
	if not frame or not title or not sub or not bar or not scale then
		return
	end
	bannerCurrent = b
	bannerShownAt = os.clock()
	title.Text = b.Title
	sub.Text = if b.Until then ("%s · %s"):format(b.Sub, countdown(b.Until)) else b.Sub
	bar.BackgroundColor3 = b.Color
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = b.Color
		stroke.Transparency = 0.5
	end
	frame.Visible = true
	frame.Position = UDim2.new(0.5, 0, 0, 108)
	scale.Scale = 0.96
	TweenService:Create(frame, TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 0, 132),
	}):Play()
	TweenService:Create(scale, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()
end

local function hideBanner()
	local frame = bannerFrame
	bannerCurrent = nil
	if not frame then
		return
	end
	local tween = TweenService:Create(frame, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Position = UDim2.new(0.5, 0, 0, 112),
	})
	tween.Completed:Once(function()
		if bannerCurrent == nil then
			frame.Visible = false
		end
	end)
	tween:Play()
end

local function queueBanner(title: string, sub: string, color: Color3, untilT: number?, seconds: number?)
	local b: Banner = {
		Title = title,
		Sub = sub,
		Color = color,
		Until = untilT,
		Seconds = math.clamp(num(seconds, BANNER_SECONDS), 3, 10),
	}
	if bannerCurrent == nil then
		showBanner(b)
		return
	end
	table.insert(bannerQueue, b)
	while #bannerQueue > BANNER_QUEUE do
		table.remove(bannerQueue, 1)
	end
end

local function stepBanner()
	local current = bannerCurrent
	if not current then
		return
	end
	local sub = bannerSub
	if sub and current.Until then
		sub.Text = ("%s · %s"):format(current.Sub, countdown(current.Until))
	end
	if os.clock() - bannerShownAt >= current.Seconds then
		local nextBanner = table.remove(bannerQueue, 1)
		if nextBanner then
			showBanner(nextBanner)
		else
			hideBanner()
		end
	end
end

local function sectorName(key: any): string
	local companies = ctx and ctx.Config and ctx.Config.Companies
	local sectors = companies and companies.Sectors
	if type(sectors) == "table" then
		for _, entry in ipairs(sectors) do
			if type(entry) == "table" and entry.Key == key then
				local name = entry.Name
				if type(name) == "table" then
					return tostring(name[lang()] or name.de or key)
				end
				return tostring(name or key)
			end
		end
	end
	return tostring(key or "?")
end

-- ---------------------------------------------------------------------
-- SHOWS (Sky-Show-Beams, Feuerwerk)
-- ---------------------------------------------------------------------
local function clearShow(show: Show)
	for _, inst in ipairs(show.Parts) do
		inst:Destroy()
	end
	table.clear(show.Parts)
	table.clear(show.Beams)
end

local function addShow(show: Show)
	table.insert(shows, show)
	while #shows > MAX_SHOWS do
		local old = table.remove(shows, 1)
		if old then
			clearShow(old)
		end
	end
end

local function skyBeams(show: Show)
	local sites = plotSites()
	local factor = particleFactor()
	local count = math.clamp(math.floor(#sites * factor + 0.5), 2, SHOW_BEAMS_MAX)
	for i = 1, math.min(count, #sites) do
		local site = sites[i]
		local base = localPart({ CFrame = CFrame.new(site.Position + Vector3.new(0, 2, 0)) })
		local top = localPart({ CFrame = CFrame.new(site.Position + Vector3.new(0, 260, 0)) })
		local a0 = Instance.new("Attachment")
		a0.Parent = base
		local a1 = Instance.new("Attachment")
		a1.Parent = top
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Texture = TEX_BEAM
		beam.TextureMode = Enum.TextureMode.Stretch
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.FaceCamera = true
		beam.Width0 = 6
		beam.Width1 = 2
		beam.Color = ColorSequence.new(COSMIC1, COSMIC3)
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		beam.Parent = base
		table.insert(show.Parts, base)
		table.insert(show.Parts, top)
		table.insert(show.Beams, { Beam = beam, Phase = i * 0.6 })
	end
end

local function burst(show: Show)
	local factor = particleFactor()
	local rng = math.random
	local center = show.Center
	local pos = center
		+ Vector3.new((rng() * 2 - 1) * show.Spread, show.Height + rng() * 30, (rng() * 2 - 1) * show.Spread)
	local holder = localPart({ CFrame = CFrame.new(pos) })
	local palette = { Theme.Accent, Theme.Up, GOLD, COSMIC2, COSMIC3, Color3.fromRGB(34, 211, 238) }
	local c1 = palette[rng(1, #palette)]
	local c2 = palette[rng(1, #palette)]
	local spark = emitter(holder, TEX_SPARKLE, ColorSequence.new(c1, c2), {
		Lifetime = NumberRange.new(1.2, 2),
		Speed = NumberRange.new(28, 46),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 2.4,
		Acceleration = Vector3.new(0, -12, 0),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 2.4),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.7, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
	local bits = emitter(holder, TEX_SQUARE, ColorSequence.new(c2, WHITE), {
		Lifetime = NumberRange.new(1.4, 2.4),
		Speed = NumberRange.new(16, 30),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 1.6,
		Acceleration = Vector3.new(0, -18, 0),
		Size = NumberSequence.new(0.5),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-180, 180),
	})
	local glow = emitter(holder, TEX_GLOW, ColorSequence.new(c1), {
		Lifetime = NumberRange.new(0.35, 0.5),
		Speed = NumberRange.new(0, 0),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 6),
			NumberSequenceKeypoint.new(1, 22),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
	spark:Emit(math.floor(60 * factor) + 10)
	bits:Emit(math.floor(40 * factor) + 6)
	glow:Emit(1)
	-- echter Lichtblitz (Future-Licht färbt Glasfassaden/Dächer in der Burst-Farbe), nur im Licht-Budget hoher Stufen
	local okBudget, lights = tryModule("Quality", "Budget", "Lights")
	if okBudget and type(lights) == "number" and lights >= 32 and not reducedFx() then
		local flashLight = Instance.new("PointLight")
		flashLight.Color = c1
		flashLight.Range = 60
		flashLight.Brightness = 5
		flashLight.Shadows = false
		flashLight.Parent = holder
		TweenService:Create(
			flashLight,
			TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Brightness = 0, Range = 24 }
		):Play()
	end
	if math.random() < 0.5 then
		sfx("Whoosh", pos, { Volume = 0.35, Speed = 1.4 + math.random() * 0.4 })
	end
	task.delay(3, function()
		holder:Destroy()
	end)
end

local function stepShows()
	local t = os.clock()
	local i = 1
	while i <= #shows do
		local show = shows[i]
		if t >= show.Until then
			clearShow(show)
			table.remove(shows, i)
		else
			for _, entry in ipairs(show.Beams) do
				local phase = t * 0.9 + entry.Phase
				local mix = (math.sin(phase) + 1) * 0.5
				local color = COSMIC1:Lerp(COSMIC3, mix)
				entry.Beam.Color = ColorSequence.new(color, Theme.Accent:Lerp(GOLD, mix))
				entry.Beam.Width0 = 4 + math.sin(phase * 1.7) * 2
				local tilt = math.sin(phase * 0.5) * 40
				local a1 = entry.Beam.Attachment1
				if a1 then
					a1.Position = Vector3.new(tilt, 0, math.cos(phase * 0.4) * 40)
				end
			end
			if t >= show.Next then
				show.Next = t + FIREWORK_GAP / particleFactor() * (0.7 + math.random() * 0.6)
				burst(show)
			end
			i += 1
		end
	end
end

-- ---------------------------------------------------------------------
-- GELDREGEN (Münz-Schauer um die Kamera)
-- ---------------------------------------------------------------------
local function startRain(seconds: number)
	rainUntil = os.clock() + seconds
	if not rainPart then
		local holder = localPart({ Size = Vector3.new(90, 1, 90), CFrame = CFrame.new(0, 80, 0) })
		holder.Name = "AT_RainCloud"
		local e = emitter(holder, TEX_SPARKLE, ColorSequence.new(Theme.Up, GOLD), {
			Lifetime = NumberRange.new(2.4, 3.2),
			Speed = NumberRange.new(26, 34),
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(6, 6),
			Size = NumberSequence.new(1.2),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-120, 120),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.1),
				NumberSequenceKeypoint.new(1, 0.6),
			}),
		})
		rainPart = holder
		rainEmitter = e
	end
	local e = rainEmitter
	if e then
		e.Rate = math.floor(28 * particleFactor()) + 4
		e.Enabled = true
	end
end

local function stepRain()
	local e = rainEmitter
	local holder = rainPart
	if not e or not holder then
		return
	end
	local t = os.clock()
	if t >= rainUntil then
		if e.Enabled then
			e.Enabled = false
		end
		return
	end
	local camera = workspace.CurrentCamera
	if camera then
		local pos = camera.CFrame.Position
		holder.CFrame = CFrame.new(pos.X, pos.Y + 60, pos.Z)
	end
	if t >= rainSoundAt and t < rainUntil - 2 then
		rainSoundAt = t + 0.5 + math.random() * 0.9
		sfx("MoneyRain", nil, { Volume = 0.25 })
	end
end

-- ---------------------------------------------------------------------
-- BOSS-AUFTRITT (getweente Winke-Pose, rein lokal)
-- ---------------------------------------------------------------------
local function startBoss(seconds: number)
	task.spawn(function()
		local world = workspace:FindFirstChild("AT_EventWorld") or workspace:WaitForChild("AT_EventWorld", 10)
		local show = world and (world:FindFirstChild("AT_BossShow") or world:WaitForChild("AT_BossShow", 15))
		if not show then
			return
		end
		local motors: { { Motor: Motor6D, Base: CFrame } } = {}
		for _, d in ipairs(show:GetDescendants()) do
			if d:IsA("Motor6D") and (d.Name == "RightShoulder" or d.Name == "Right Shoulder") then
				table.insert(motors, { Motor = d, Base = d.C0 })
			end
			if #motors >= 8 then
				break
			end
		end
		boss = { Motors = motors, Until = os.clock() + seconds, Phase = 0 }
	end)
end

local function stepBoss(dt: number)
	local b = boss
	if not b then
		return
	end
	local t = os.clock()
	if t >= b.Until then
		for _, entry in ipairs(b.Motors) do
			if entry.Motor.Parent then
				entry.Motor.C0 = entry.Base
			end
		end
		boss = nil
		return
	end
	b.Phase += dt * BOSS_WAVE_SPEED
	for i, entry in ipairs(b.Motors) do
		if entry.Motor.Parent then
			local wave = math.sin(b.Phase + i * 0.4) * 0.35
			-- Arm hoch (≈ 150°) und hin und her winken
			entry.Motor.C0 = entry.Base * CFrame.Angles(0, 0, math.rad(150) + wave)
		end
	end
end

-- ---------------------------------------------------------------------
-- GLOCKEN-MOMENT (Welle an der Glocken-Zone)
-- ---------------------------------------------------------------------
local function bellWave()
	local center = workspace:GetAttribute("AT_BellZone")
	local pos: Vector3 = if typeof(center) == "Vector3" then center else plazaCenter()
	local holder = localPart({ CFrame = CFrame.new(pos + Vector3.new(0, 1, 0)) })
	local ring = emitter(holder, TEX_RING, ColorSequence.new(GOLD), {
		Lifetime = NumberRange.new(1.4, 1.4),
		Speed = NumberRange.new(0, 0),
		Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
		EmissionDirection = Enum.NormalId.Top,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 4),
			NumberSequenceKeypoint.new(1, 70),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
	ring.Acceleration = Vector3.zero
	ring:Emit(1)
	task.delay(0.35, function()
		if ring.Parent then
			ring:Emit(1)
		end
	end)
	local sparks = emitter(holder, TEX_SPARKLE, ColorSequence.new(GOLD, WHITE), {
		Lifetime = NumberRange.new(1, 1.8),
		Speed = NumberRange.new(10, 22),
		SpreadAngle = Vector2.new(60, 60),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -6, 0),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1.6),
			NumberSequenceKeypoint.new(1, 0),
		}),
	})
	sparks:Emit(math.floor(40 * particleFactor()) + 8)
	task.delay(3, function()
		holder:Destroy()
	end)
end

-- ---------------------------------------------------------------------
-- EFFEKT-HANDLER
-- ---------------------------------------------------------------------
local BANNER_COLORS: { [string]: Color3 } = {
	GoldenHour = GOLD,
	XpRush = Theme.Accent,
	BuildBoom = Theme.Warn,
	SaturdayShow = COSMIC2,
	AutoShow = COSMIC2,
	AllToHall = Theme.Accent,
}

local function onAbuseBanner(_strength: number, data: any)
	if type(data) ~= "table" or type(data.Kind) ~= "string" then
		return
	end
	local kind = data.Kind
	local color = BANNER_COLORS[kind] or Theme.Accent
	local untilT = if type(data.Until) == "number" then data.Until else nil
	local sub: string
	if kind == "GoldenHour" then
		sub = T("evt.banner.GoldenHourSub", ("%g"):format(num(data.Mult, 2)))
	elseif kind == "XpRush" then
		sub = T("evt.banner.XpRushSub")
	elseif kind == "BuildBoom" then
		sub = T("evt.banner.BuildBoomSub")
	elseif kind == "SaturdayShow" or kind == "AutoShow" then
		sub = T("evt.banner.ShowSub", sectorName(data.Sector))
		sfx("RallyFanfare", nil, nil)
		tryModule("Sfx", "Duck", 0.5, 3)
	elseif kind == "AllToHall" then
		sub = T("evt.banner.AllToHallSub")
	else
		sub = ""
	end
	local titleKey = ({
		GoldenHour = "evt.banner.GoldenHour",
		XpRush = "evt.banner.XpRush",
		BuildBoom = "evt.banner.BuildBoom",
		SaturdayShow = "evt.banner.SaturdayShow",
		AutoShow = "evt.banner.AutoShow",
		AllToHall = "evt.banner.AllToHall",
	})[kind] or "evt.banner.Generic"
	if kind ~= "SaturdayShow" and kind ~= "AutoShow" then
		sfx("Notify", nil, nil)
	end
	queueBanner(T(titleKey), sub, color, untilT, nil)
end

local function onMoneyRain(_strength: number, data: any)
	local seconds = math.clamp(num(type(data) == "table" and data.Seconds, 120), 5, 300)
	queueBanner(T("evt.banner.MoneyRain"), T("evt.banner.MoneyRainSub"), Theme.Up, now() + seconds, nil)
	startRain(seconds)
	sfx("MoneyRain", nil, nil)
end

local function onBullParade(_strength: number, data: any)
	if type(data) ~= "table" then
		return
	end
	local name = if type(data.Name) == "string" then data.Name else "?"
	local untilT = if type(data.Until) == "number" then data.Until else now() + num(data.Seconds, 900)
	queueBanner(T("evt.paradeBanner", name), T("evt.banner.ParadeSub"), GOLD, untilT, 8)
	sfx("RallyFanfare", nil, nil)
end

local function onBear(_strength: number, data: any)
	local phase = type(data) == "table" and data.Phase or "Arrive"
	if phase == "Arrive" then
		queueBanner(T("evt.banner.Bear"), T("evt.banner.BearSub", math.floor(num(data.Goal, 0))), Theme.Down, nil, 8)
		sfx("CrashAlarm", nil, nil)
	elseif phase == "Success" then
		queueBanner(T("evt.banner.BearCalm"), T("evt.banner.BearCalmSub"), Theme.Up, nil, 6)
		flash(Theme.Up, nil)
		sfx("Achievement", nil, nil)
	end
end

local function onGoldenBull(_strength: number, data: any)
	local phase = type(data) == "table" and data.Phase or "Run"
	if phase == "Run" then
		queueBanner(T("evt.banner.GoldenBull"), T("evt.banner.GoldenBullSub"), GOLD, nil, 7)
		sfx("RallyFanfare", nil, nil)
	elseif phase == "Touch" then
		flash(GOLD, T("evt.bullBonus"))
		sfx("LevelUp", nil, nil)
	end
end

local function onSkyShow(_strength: number, data: any)
	local seconds = math.clamp(num(type(data) == "table" and data.Seconds, 75), 5, 600)
	local finale = type(data) == "table" and data.Finale == true
	local show: Show = {
		Kind = "Sky",
		Until = os.clock() + seconds,
		Next = os.clock() + 1.5,
		Center = plazaCenter(),
		Spread = 120,
		Height = 140,
		Parts = {},
		Beams = {},
	}
	skyBeams(show)
	addShow(show)
	queueBanner(
		T(if finale then "evt.banner.Finale" else "evt.banner.SkyShow"),
		T(if finale then "evt.banner.FinaleSub" else "evt.banner.SkyShowSub"),
		COSMIC3,
		nil,
		6
	)
	sfx("RallyFanfare", nil, { Volume = 0.6 })
end

local function onFireworks(_strength: number, data: any)
	local seconds = math.clamp(num(type(data) == "table" and data.Seconds, 20), 3, 60)
	local cf = plotCFrame(type(data) == "table" and data.Plot or nil)
	local center = if cf then cf.Position else plazaCenter()
	addShow({
		Kind = "Fireworks",
		Until = os.clock() + seconds,
		Next = os.clock() + 0.3,
		Center = center,
		Spread = if cf then 40 else 90,
		Height = if cf then 170 else 120,
		Parts = {},
		Beams = {},
	})
end

local function onBossAppear(_strength: number, data: any)
	local seconds = math.clamp(num(type(data) == "table" and data.Seconds, 120), 10, 300)
	local name = if type(data) == "table" and type(data.Name) == "string" then data.Name else "?"
	queueBanner(T("evt.banner.Boss", name), T("evt.banner.BossSub"), Theme.Accent, now() + seconds, 7)
	sfx("RallyFanfare", nil, nil)
	startBoss(seconds)
end

local function onBellMoment(_strength: number, data: any)
	local show = type(data) == "table" and data.Show == true
	bellWave()
	sfx("MarketBell", nil, nil)
	if show then
		queueBanner(T("evt.banner.BellShow"), T("evt.banner.BellShowSub"), GOLD, nil, 5)
	else
		local mult = num(type(data) == "table" and data.Mult, 1.2)
		flash(GOLD, T("evt.banner.BellMoment", ("%g"):format(mult)))
	end
end

-- ---------------------------------------------------------------------
-- ÖFFENTLICHE API + LEBENSZYKLUS
-- ---------------------------------------------------------------------
function EffectsEvent.Step(dt: number)
	stepBanner()
	stepShows()
	stepRain()
	stepBoss(dt)
end

function EffectsEvent.Init(context: any)
	ctx = context
	local folder = Instance.new("Folder")
	folder.Name = "AT_EventFX"
	folder.Parent = workspace
	fxFolder = folder
	local Effects = module("Effects")
	local shared: any = nil
	if Effects and type(Effects.Overlay) == "function" then
		local ok, result = pcall(Effects.Overlay)
		if ok and typeof(result) == "Instance" and result:IsA("ScreenGui") then
			shared = result
		end
	end
	if not shared then
		shared = UI.Create("ScreenGui", {
			Name = "AkytexTycoonEventFX",
			ResetOnSpawn = false,
			IgnoreGuiInset = false,
			DisplayOrder = 5,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			Parent = player:WaitForChild("PlayerGui"),
		})
	end
	overlay = shared
	buildBanner()
	if Effects and type(Effects.Register) == "function" then
		Effects.Register("AbuseBanner", onAbuseBanner)
		Effects.Register("MoneyRain", onMoneyRain)
		Effects.Register("BullParade", onBullParade)
		Effects.Register("Bear", onBear)
		Effects.Register("GoldenBull", onGoldenBull)
		Effects.Register("SkyShow", onSkyShow)
		Effects.Register("Fireworks", onFireworks)
		Effects.Register("BossAppear", onBossAppear)
		Effects.Register("BellMoment", onBellMoment)
	else
		warn("[EffectsEvent] Effects-Registry fehlt – Event-Effekte inaktiv")
	end
end

function EffectsEvent.Start()
	local hooks = ctx and ctx.Hooks
	if hooks and type(hooks.On) == "function" then
		-- Foto-Modus: Shows bleiben (Welt), nur das Banner verschwindet mit dem Overlay (Effects.SetHidden)
		hooks.On("PhotoMode", function(on: any)
			if on == true and bannerFrame then
				bannerFrame.Visible = false
				bannerCurrent = nil
				table.clear(bannerQueue)
			end
		end)
	end
	player.CharacterAdded:Connect(function()
		-- Regen-Wolke folgt der Kamera; nichts zu tun außer sicherstellen, dass sie noch existiert
		if rainPart and not rainPart.Parent then
			rainPart = nil
			rainEmitter = nil
		end
	end)
end

return EffectsEvent
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">EffectsMarket</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Markt-Effekte: Glocke, „Gut gelesen!“, Tagesbilanz, G/V-Tick (Client/Modules/EffectsMarket)
--  Besitzer: WP5 (Charts, Terminal, Markt-UI). Vertrag: DESIGN.md §C7.4 (Effekte Bell, ReadWell, DayRecap – Daten
--  {Day, Return?, Transfer?}), §A7 #3 (Glocke bei Sonnenaufgang: Glocke schwingt, Lichtwelle über alle Ticker-Wände,
--  „Gewinn-Transfer wieder frei“, Tagesbilanz-Karte federt von rechts), §A7 #4 („Gut gelesen“: kleiner Chip + 10 XP),
--  §B7.6 + §0.3 Punkt 6 (ruhiges Feedback: Gewinn = grüner G/V-Tick + Profit-Arpeggio, Verlust = grauer Tick +
--  Lerntipp; kein Konfetti/Geldregen für einzelne Trades), §A4 (Sfx-Rollen MarketBell/Profit/Loss).
--
--  Auslöser: Remote "Market" Bell -> Hook "Market:Bell" -> Effects.Play("Bell") · Remote "Market" DayClose (je Spieler)
--  -> Hook "Market:DayClose" -> Effects.Play("DayRecap") · Server-Effekt "ReadWell" (OrderService) -> Effects.Play.
--  Je Börsentag höchstens eine Glocke und eine Tagesbilanz (doppelte Pakete werden ignoriert). Nach lokalem Abspielen
--  feuert das Modul den Hook "Effect:<Name>" (gleicher Vertrag wie bei Server-Effekten).
--  Reduzierte Effekte (Einstellung ReducedFx): keine Schwing-Animation, kürzere Einblendungen.
--
--  Öffentliche API:
--    Effekte (Registry §C7.4): "Bell", "ReadWell", "DayRecap"
--    EffectsMarket.TradeTick(pnlCents, anchor?)   ruhiger G/V-Tick nach einem Verkauf (Terminal, Übung)
--    EffectsMarket.Init(ctx), EffectsMarket.Start()
-- =====================================================================

local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local EffectsMarket = {}

local Theme = UI.Theme
local BELL_STAY = 3.4
local RECAP_STAY = 8
local READWELL_STAY = 2.6
local TICK_STAY = 1.6
local LOSS_TIP_GAP = 60
local IN_INFO = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local SOFT_IN = TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local OUT_INFO = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local SWING_INFO = TweenInfo.new(0.36, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 5, true)

local ctx: any = nil
local lastBellDay = -1
local lastRecapDay = -1
local lastLossTip = -math.huge
local bellToken = 0
local recapToken = 0
local readToken = 0

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function lang(): string
	return ctx.Lang_()
end

local function reduced(): boolean
	local ok, settings = call("Settings", "Get")
	if ok and type(settings) == "table" then
		return settings.ReducedFx == true
	end
	local s = ctx.State.Settings
	return type(s) == "table" and s.ReducedFx == true
end

local function hidden(): boolean
	local ok, value = call("Effects", "IsHidden")
	return ok and value == true
end

local function aky(cents: number, compact: boolean?): string
	local ok, text = pcall(ctx.Format.Aky, cents, lang(), compact)
	return if ok then text else tostring(math.floor(cents / 100))
end

local function pct(fraction: number): string
	local ok, text = pcall(ctx.Format.Pct, fraction, lang(), 2, true)
	return if ok then text else string.format("%+.2f %%", fraction * 100)
end

local function credits(n: number): string
	local ok, text = pcall(ctx.Format.Credits, n, lang())
	return if ok then text else tostring(math.floor(n))
end

local function dayOfWeek(day: any): number
	if type(day) == "number" and day == day then
		return math.floor(day) % 504 + 1
	end
	local ok, tick = pcall(ctx.Clock.Tick)
	return if ok then (tick // 1200) % 504 + 1 else 1
end

local function label(props: { [string]: any }): TextLabel
	local base: { [string]: any } = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		FontFace = UI.Faces.Body,
		TextSize = 14,
		TextColor3 = Theme.Text,
		Text = "",
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return UI.Create("TextLabel", base)
end

-- ---------------------------------------------------------------------
-- GLOCKE (Börsentag-Beginn, §A7 #3)
-- ---------------------------------------------------------------------
local bellUi: { [string]: any }? = nil

local function buildBell(): { [string]: any }
	local root: Frame = UI.Create("Frame", {
		Name = "MarketBell",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -220),
		Size = UDim2.fromOffset(460, 150),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 45,
		Parent = ctx.Gui,
	}, {
		UI.Corner(20),
		UI.Create("UIStroke", { Color = Theme.Gold, Thickness = 1, Transparency = 0.35 }),
	})
	local scale = UI.Create("UIScale", { Parent = root })
	-- goldene Glocke aus Frames (Krone, Kuppel, Rand, Klöppel) – schwingt um den Aufhängepunkt oben
	local pivot: Frame = UI.Create("Frame", {
		Name = "Bell",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(70, 18),
		Size = UDim2.fromOffset(84, 110),
		BackgroundTransparency = 1,
		ZIndex = 46,
		Parent = root,
	})
	local swing: Frame = UI.Create("Frame", {
		Name = "Swing",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 46,
		Parent = pivot,
	})
	UI.Create("Frame", {
		Name = "Crown",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(18, 14),
		BackgroundColor3 = Theme.Gold,
		BorderSizePixel = 0,
		ZIndex = 47,
		Parent = swing,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0, 6) }) })
	UI.Create("Frame", {
		Name = "Dome",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(60, 70),
		BackgroundColor3 = Theme.Gold,
		BorderSizePixel = 0,
		ZIndex = 47,
		Parent = swing,
	}, {
		UI.Create("UICorner", { CornerRadius = UDim.new(0.48, 0) }),
		UI.Gradient(Theme.SpaceGold, Theme.Gold:Lerp(Color3.new(0, 0, 0), 0.25), 0),
	})
	UI.Create("Frame", {
		Name = "Rim",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 66),
		Size = UDim2.fromOffset(84, 16),
		BackgroundColor3 = Theme.Gold,
		BorderSizePixel = 0,
		ZIndex = 48,
		Parent = swing,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	UI.Create("Frame", {
		Name = "Clapper",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Theme.SpaceGold,
		BorderSizePixel = 0,
		ZIndex = 47,
		Parent = swing,
	}, { UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local title = label({
		Position = UDim2.fromOffset(130, 22),
		Size = UDim2.new(1, -150, 0, 30),
		FontFace = UI.Faces.Display,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 46,
		Parent = root,
	})
	local sub = label({
		Position = UDim2.fromOffset(130, 58),
		Size = UDim2.new(1, -150, 0, 24),
		FontFace = UI.Faces.BodyBold,
		TextSize = 17,
		TextColor3 = UI.UpColor(),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 46,
		Parent = root,
	})
	local tagline = label({
		Position = UDim2.fromOffset(130, 96),
		Size = UDim2.new(1, -150, 0, 18),
		FontFace = UI.Faces.DisplayRegular,
		TextSize = 12,
		TextColor3 = Theme.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 46,
		Parent = root,
	})
	return { Root = root, Scale = scale, Swing = swing, Title = title, Sub = sub, Tagline = tagline }
end

local function playBell(_strength: number, data: any)
	local day = if type(data) == "table" then data.Day else nil
	local dayKey = if type(day) == "number" then day else -2
	if dayKey == lastBellDay and dayKey ~= -2 then
		return
	end
	lastBellDay = dayKey
	call("Sfx", "Play", "MarketBell")
	call("Sfx", "Duck", 0.4, 2)
	call("Ticker", "Wave", Theme.Gold)
	if hidden() then
		return
	end
	if not bellUi then
		bellUi = buildBell()
	end
	local b = bellUi :: { [string]: any }
	bellToken += 1
	local token = bellToken
	b.Title.Text = T("term.bell.title", dayOfWeek(day))
	b.Sub.Text = T("term.bell.sub")
	b.Tagline.Text = T("core.bellTagline")
	b.Sub.TextColor3 = UI.UpColor()
	local root: Frame = b.Root
	local rest = UDim2.new(0.5, 0, 0, 84)
	root.Visible = true
	local quick = reduced()
	if quick then
		root.Position = rest
		b.Scale.Scale = 1
		b.Swing.Rotation = 0
	else
		root.Position = UDim2.new(0.5, 0, 0, -220)
		b.Scale.Scale = 0.92
		TweenService:Create(root, IN_INFO, { Position = rest }):Play()
		TweenService:Create(b.Scale, IN_INFO, { Scale = 1 }):Play()
		b.Swing.Rotation = -16
		TweenService:Create(b.Swing, SWING_INFO, { Rotation = 16 }):Play()
	end
	task.delay(if quick then BELL_STAY * 0.6 else BELL_STAY, function()
		if bellToken ~= token then
			return
		end
		local out = TweenService:Create(root, OUT_INFO, { Position = UDim2.new(0.5, 0, 0, -220) })
		out.Completed:Once(function()
			if bellToken == token then
				root.Visible = false
				b.Swing.Rotation = 0
			end
		end)
		out:Play()
	end)
end

-- ---------------------------------------------------------------------
-- TAGESBILANZ (federt von rechts herein)
-- ---------------------------------------------------------------------
local recapUi: { [string]: any }? = nil

local function hideRecap()
	local r = recapUi
	if not r or not r.Root.Visible then
		return
	end
	recapToken += 1
	local token = recapToken
	local root: Frame = r.Root
	local out = TweenService:Create(root, OUT_INFO, { Position = UDim2.new(1, 360, 0.5, 0) })
	out.Completed:Once(function()
		if recapToken == token then
			root.Visible = false
		end
	end)
	out:Play()
end

local function buildRecap(): { [string]: any }
	local root: Frame = UI.Create("Frame", {
		Name = "DayRecap",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 360, 0.5, 0),
		Size = UDim2.fromOffset(330, 196),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 44,
		Parent = ctx.Gui,
	}, { UI.Corner(18), UI.Stroke(nil, 1) })
	local title = label({
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.new(1, -70, 0, 24),
		FontFace = UI.Faces.Display,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 45,
		Parent = root,
	})
	local day = label({
		Position = UDim2.fromOffset(18, 40),
		Size = UDim2.new(1, -36, 0, 16),
		TextSize = 12,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 45,
		Parent = root,
	})
	local caption = label({
		Position = UDim2.fromOffset(18, 66),
		Size = UDim2.new(1, -36, 0, 16),
		FontFace = UI.Faces.BodyBold,
		TextSize = 12,
		TextColor3 = Theme.Text2,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 45,
		Parent = root,
	})
	local value = label({
		Position = UDim2.fromOffset(18, 84),
		Size = UDim2.new(1, -36, 0, 34),
		FontFace = UI.Faces.MonoBold,
		TextSize = 28,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 45,
		Parent = root,
	})
	local transfer = label({
		Position = UDim2.fromOffset(18, 124),
		Size = UDim2.new(1, -36, 0, 36),
		FontFace = UI.Faces.Mono,
		TextSize = 12,
		TextWrapped = true,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 45,
		Parent = root,
	})
	local tip = label({
		Position = UDim2.new(0, 18, 1, -26),
		Size = UDim2.new(1, -36, 0, 16),
		TextSize = 11,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 45,
		Parent = root,
	})
	UI.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(32, 32),
		Text = "✕",
		Variant = "Ghost",
		MaxText = 16,
		Corner = 10,
		ZIndex = 46,
		Parent = root,
	}, hideRecap)
	return {
		Root = root,
		Title = title,
		Day = day,
		Caption = caption,
		Value = value,
		Transfer = transfer,
		Tip = tip,
	}
end

local function transferLine(data: any): string
	local depot = ctx.State.Depot
	depot = if type(depot) == "table" then depot else {}
	if type(data) == "table" and type(data.Transfer) == "number" and data.Transfer > 0 then
		return T("term.recap.transfer", aky(data.Transfer, true))
	end
	local withdrawable = if type(depot.Withdrawable) == "number" then depot.Withdrawable else 0
	if depot.TransferReady == true and withdrawable > 0 then
		local okDef, def = call("MarketClient", "LicenceDef")
		local rate = if okDef and type(def) == "table" and type(def.BauKurs) == "number" then def.BauKurs else 40
		return T(
			"trade.transferAvail",
			aky(withdrawable, true),
			credits(math.floor(withdrawable * rate / 100)) .. " CR",
			credits(rate)
		)
	end
	if depot.AutoTransfer ~= false then
		return T("trade.autoOn")
	end
	return T("term.bell.sub")
end

local function playRecap(_strength: number, data: any)
	local day = if type(data) == "table" then data.Day else nil
	local dayKey = if type(day) == "number" then day else -2
	if dayKey == lastRecapDay and dayKey ~= -2 then
		return
	end
	lastRecapDay = dayKey
	if hidden() then
		return
	end
	if not recapUi then
		recapUi = buildRecap()
	end
	local r = recapUi :: { [string]: any }
	recapToken += 1
	local token = recapToken
	r.Title.Text = UI.Upper(T("term.recap.title"))
	r.Day.Text = T("term.recap.day", dayOfWeek(day))
	r.Caption.Text = T("term.recap.return")
	local ret = if type(data) == "table" then data.Return else nil
	if type(ret) == "number" and ret == ret then
		r.Value.Text = string.format(
			'<font color="%s">%s %s</font>',
			UI.ColorHex(UI.TrendColor(ret)),
			UI.TrendArrow(ret),
			pct(ret)
		)
		r.Value.TextSize = 28
	else
		r.Value.Text = T("term.recap.none")
		r.Value.TextSize = 15
	end
	r.Transfer.Text = transferLine(data)
	r.Tip.Text = T("term.recap.tip")
	local root: Frame = r.Root
	local rest = UDim2.new(1, -24, 0.5, 0)
	root.Visible = true
	if reduced() then
		root.Position = rest
	else
		root.Position = UDim2.new(1, 360, 0.5, 0)
		TweenService:Create(root, IN_INFO, { Position = rest }):Play()
	end
	task.delay(RECAP_STAY, function()
		if recapToken == token then
			hideRecap()
		end
	end)
end

-- ---------------------------------------------------------------------
-- „GUT GELESEN!“ (kleiner Chip, §A7 #4)
-- ---------------------------------------------------------------------
local readUi: { [string]: any }? = nil

local function playReadWell(_strength: number, data: any)
	if hidden() then
		return
	end
	if not readUi then
		local root: Frame = UI.Create("Frame", {
			Name = "ReadWell",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -150),
			Size = UDim2.fromOffset(0, 40),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Theme.Surface,
			BackgroundTransparency = 0.04,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 46,
			Parent = ctx.Gui,
		}, {
			UI.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
			UI.Create("UIStroke", { Color = UI.UpColor(), Thickness = 1, Transparency = 0.3 }),
			UI.Create("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }),
		})
		local text = label({
			Size = UDim2.fromScale(0, 1),
			AutomaticSize = Enum.AutomaticSize.X,
			FontFace = UI.Faces.BodyBold,
			TextSize = 16,
			RichText = true,
			ZIndex = 47,
			Parent = root,
		})
		readUi = { Root = root, Text = text, Scale = UI.Create("UIScale", { Parent = root }) }
	end
	local r = readUi :: { [string]: any }
	readToken += 1
	local token = readToken
	local ticker = if type(data) == "table" and type(data.Ticker) == "string" then data.Ticker else ""
	r.Text.Text = string.format(
		'<font color="%s">✓ %s</font>  %s',
		UI.ColorHex(UI.UpColor()),
		T("term.readWell"),
		T("term.readWell.sub", ticker)
	)
	local root: Frame = r.Root
	root.Visible = true
	root.Position = UDim2.new(0.5, 0, 1, -130)
	r.Scale.Scale = 0.9
	TweenService:Create(root, SOFT_IN, { Position = UDim2.new(0.5, 0, 1, -150) }):Play()
	TweenService:Create(r.Scale, SOFT_IN, { Scale = 1 }):Play()
	call("Sfx", "Play", "Notify")
	task.delay(READWELL_STAY, function()
		if readToken ~= token then
			return
		end
		local out = TweenService:Create(root, OUT_INFO, { Position = UDim2.new(0.5, 0, 1, -170) })
		out.Completed:Once(function()
			if readToken == token then
				root.Visible = false
			end
		end)
		out:Play()
	end)
end

-- ---------------------------------------------------------------------
-- G/V-TICK NACH EINEM VERKAUF (ruhig, §0.3 Punkt 6)
-- ---------------------------------------------------------------------
function EffectsMarket.TradeTick(pnl: number, anchor: GuiObject?)
	if type(pnl) ~= "number" or pnl ~= pnl then
		return
	end
	local profit = pnl > 0
	call("Sfx", "Play", if profit then "Profit" else "Loss")
	if not profit then
		local now = os.clock()
		if now - lastLossTip >= LOSS_TIP_GAP then
			lastLossTip = now
			ctx.Toast(T("trade.lossTip"), "Info")
		end
	end
	if hidden() then
		return
	end
	local gui: ScreenGui = ctx.Gui
	local scale = UI.ScaleOf(gui)
	local origin = gui.AbsolutePosition
	local start: Vector2
	if typeof(anchor) == "Instance" and anchor:IsA("GuiObject") and anchor.Parent then
		local pos = anchor.AbsolutePosition + anchor.AbsoluteSize * Vector2.new(0.5, 0)
		start = (pos - origin) / scale
	else
		start = (gui.AbsoluteSize * Vector2.new(0.5, 0.62)) / scale
	end
	local color = if profit then UI.UpColor() else Theme.Muted
	local text = (if profit then "+" else "") .. aky(math.floor(pnl + 0.5), true)
	local tickLabel = label({
		Name = "PnlTick",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromOffset(start.X, start.Y),
		Size = UDim2.fromOffset(240, 28),
		FontFace = UI.Faces.MonoBold,
		TextSize = 22,
		TextColor3 = color,
		Text = text,
		ZIndex = 48,
		Parent = gui,
	})
	UI.Create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.6, Parent = tickLabel })
	local rise = if reduced() then 12 else 46
	TweenService:Create(
		tickLabel,
		TweenInfo.new(TICK_STAY, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(start.X, start.Y - rise), TextTransparency = 1 }
	):Play()
	task.delay(TICK_STAY + 0.1, function()
		tickLabel:Destroy()
	end)
end

-- ---------------------------------------------------------------------
-- START
-- ---------------------------------------------------------------------
function EffectsMarket.Init(context: any)
	ctx = context
	local Effects = ctx.Modules.Effects
	if Effects then
		Effects.Register("Bell", playBell)
		Effects.Register("ReadWell", playReadWell)
		Effects.Register("DayRecap", playRecap)
	end
	local hooks = ctx.Hooks
	-- Glocke kommt als Markt-Nachricht an alle (kein Server-Effekt) -> lokal abspielen + Hook wie bei Server-Effekten
	hooks.On("Market:Bell", function(data)
		local before = lastBellDay
		if Effects then
			Effects.Play("Bell", 1, data)
		else
			playBell(1, data)
		end
		if lastBellDay ~= before then
			hooks.Fire("Effect:Bell", 1, data)
		end
	end)
	hooks.On("Market:DayClose", function(data)
		local before = lastRecapDay
		if Effects then
			Effects.Play("DayRecap", 1, data)
		else
			playRecap(1, data)
		end
		if lastRecapDay ~= before then
			hooks.Fire("Effect:DayRecap", 1, data)
		end
	end)
end

function EffectsMarket.Start() end

return EffectsMarket
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">EffectsTower</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Tower-Effekte: Bau, Stufen-Morph, Gewinn-Röhre, Sammeln, Kran (Client/Modules/EffectsTower)
--  Besitzer: WP8 (Turm-Optik, Interiors, Lifestyle). Vertrag: DESIGN.md §C7.4 (Effekte BuildDone, StageUp,
--  TransferTube, Collect, Crane – Daten {Plot, Floor, Stage, Amount}), §A7 #1 (Etage gebaut: Kran hebt die Platte
--  2,5 s, Kamera-Orbit (überspringbar, bei ReducedFx sofort), Fenster leuchten auf, „+14 CR/s“ fliegt), §A7 #2
--  (Stufen-Morph 2,5 s: alte Teile faden, neue erscheinen, Krone leuchtet, Konfetti-Beams), §A7 #5 (Gewinn-
--  Transfer: leuchtende Röhre fliegt von der Börse zum eigenen Tower, CR-Zähler rollt), §B3 (Kran-Abbau 1,5 s
--  beim Verlassen), §0.3 Punkt 6 (Konfetti nur für Meilensteine – hier: Stufen-Morph).
--
--  Ein Effekt = ein Besitzer: die fünf Namen registriert NUR dieses Modul (Effects.Register in Init). Server
--  schickt sie über PlayerStateService.Effect/EffectAll; Main.client feuert danach Hook "Effect:<Name>".
--  Kein eigener Render-Loop: TowerView.Frame ruft EffectsTower.Step(dt) (Muss-Regel 2, ein PreRender-Loop).
--
--  Öffentliche API:
--    Effekte (Registry §C7.4): "BuildDone", "StageUp", "TransferTube", "Collect", "Crane"
--    EffectsTower.Step(dt)                     von TowerView.Frame
--    EffectsTower.OnTowerModel(plot, model)    von TowerView: neue Hülle eingehängt (Morph-Einblendung)
--    EffectsTower.Teardown(plot)               von TowerView: Plot frei geworden (Kran-Abbau-Staub)
--    EffectsTower.Init(ctx), EffectsTower.Start()
-- =====================================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UI"))
local TowerModels = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("TowerModels"))

local EffectsTower = {}

local Theme = UI.Theme
local player = Players.LocalPlayer

local ORBIT_SECONDS = 2.5
local LIFT_SECONDS = 2.5
local TUBE_SECONDS = 1.6
local MORPH_WINDOW = 4 -- Sekunden nach "StageUp", in denen eine neue Hülle eingeblendet wird
local REVEAL_SECONDS = 1.6
local VIEW_RANGE = 900
local EXCHANGE_FALLBACK = Vector3.new(0, 72, -190) -- §A5: Börsensaal (0, 0, −190), Höhe 70
local FLASH_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FLOAT_INFO = TweenInfo.new(1.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

type Lift = { Plot: number, Part: BasePart, From: CFrame, To: CFrame, Start: number, Seconds: number }
type Reveal = {
	Plot: number,
	Model: Model,
	Start: number,
	Floors: { { Floor: number, Parts: { BasePart } } },
	Done: number,
}
type Tube = { Ball: BasePart, From: Vector3, Mid: Vector3, To: Vector3, Start: number, Amount: number }
type Beam = { Part: BasePart, From: CFrame, Start: number, Seconds: number, Height: number }

local ctx: any = nil
local fxFolder: Folder? = nil
local lifts: { Lift } = {}
local reveals: { Reveal } = {}
local tubes: { Tube } = {}
local beams: { Beam } = {}
local morphUntil: { [number]: number } = {}
local orbit: { Start: number, Center: Vector3, Radius: number, Height: number, Conn: RBXScriptConnection?, Saved: Enum.CameraType }? =
	nil

-- ---------------------------------------------------------------------
-- 1) HELFER
-- ---------------------------------------------------------------------
local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else default
end

local function reduced(): boolean
	local ok, settings = call("Settings", "Get")
	return ok and type(settings) == "table" and settings.ReducedFx == true
end

local function hidden(): boolean
	local ok, value = call("Effects", "IsHidden")
	return ok and value == true
end

local function sfx(role: string, pos: Vector3?)
	call("Sfx", "Play", role, pos)
end

local function credits(n: number): string
	local ok, text = pcall(ctx.Format.Credits, n, ctx.Lang_())
	return if ok then text else tostring(math.floor(n))
end

local function payload(data: any): (number?, { [string]: any })
	if type(data) ~= "table" then
		return nil, {}
	end
	local plot = data.Plot
	return if type(plot) == "number" and plot >= 1 then plot else nil, data
end

local function isMine(data: { [string]: any }): boolean
	return data.UserId == player.UserId
end

local function topCFrame(plot: number): CFrame?
	local ok, cf = call("TowerView", "TopCFrame", plot)
	return if ok and typeof(cf) == "CFrame" then cf else nil
end

local function cameraPos(): Vector3
	local camera = workspace.CurrentCamera
	return if camera then camera.CFrame.Position else Vector3.zero
end

local function inView(pos: Vector3): boolean
	return (pos - cameraPos()).Magnitude <= VIEW_RANGE
end

local function localPart(props: { [string]: any }): BasePart
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		(part :: any)[key] = value
	end
	part.Parent = fxFolder
	return part
end

-- schwebender Text über einem Punkt („+14 CR/s“)
local function floatText(position: Vector3, text: string, color: Color3)
	local anchor = localPart({ Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, CFrame = CFrame.new(position) })
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(260, 60)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 1200
	local label = UI.Label({
		Size = UDim2.fromScale(1, 1),
		Text = text,
		Face = "Display",
		TextColor3 = color,
		MaxText = 40,
		Outline = 1,
		Parent = billboard,
	})
	billboard.Parent = anchor
	TweenService:Create(billboard, FLOAT_INFO, { StudsOffset = Vector3.new(0, 10, 0) }):Play()
	local fade = TweenService:Create(
		label,
		TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.6),
		{ TextTransparency = 1 }
	)
	fade.Completed:Once(function()
		anchor:Destroy()
	end)
	fade:Play()
end

-- ---------------------------------------------------------------------
-- 2) KAMERA-ORBIT (eigener Bau, überspringbar, nicht bei ReducedFx/offenem Fenster/Auto)
-- ---------------------------------------------------------------------
local function endOrbit()
	local o = orbit
	if not o then
		return
	end
	orbit = nil
	if o.Conn then
		o.Conn:Disconnect()
	end
	call("WorldLook", "SetCinematic", false)
	local camera = workspace.CurrentCamera
	if camera and camera.CameraType == Enum.CameraType.Scriptable then
		camera.CameraType = o.Saved
	end
end

local function canOrbit(): boolean
	if reduced() or hidden() then
		return false
	end
	local camera = workspace.CurrentCamera
	if not camera or camera.CameraType ~= Enum.CameraType.Custom then
		return false
	end
	if ctx.Windows and ctx.Windows.IsOpen() then
		return false
	end
	local okVehicle, vehicle = call("Vehicles", "Current")
	return not (okVehicle and vehicle ~= nil)
end

local function startOrbit(plot: number)
	if orbit or not canOrbit() then
		return
	end
	local top = topCFrame(plot)
	local camera = workspace.CurrentCamera
	if not top or not camera then
		return
	end
	local o = {
		Start = os.clock(),
		Center = top.Position + Vector3.new(0, 6, 0),
		Radius = 70,
		Height = 22,
		Conn = nil :: RBXScriptConnection?,
		Saved = camera.CameraType,
	}
	camera.CameraType = Enum.CameraType.Scriptable
	call("WorldLook", "SetCinematic", true, o.Radius) -- Tower scharf, Stadt dahinter weich (High/Ultra)
	o.Conn = UserInputService.InputBegan:Connect(function(input: InputObject)
		local kind = input.UserInputType
		if
			kind == Enum.UserInputType.MouseButton1
			or kind == Enum.UserInputType.Touch
			or kind == Enum.UserInputType.Keyboard
			or kind == Enum.UserInputType.Gamepad1
		then
			endOrbit()
		end
	end)
	orbit = o
end

local function stepOrbit()
	local o = orbit
	local camera = workspace.CurrentCamera
	if not o or not camera then
		return
	end
	local alpha = (os.clock() - o.Start) / ORBIT_SECONDS
	if alpha >= 1 or camera.CameraType ~= Enum.CameraType.Scriptable then
		endOrbit()
		return
	end
	local ease = 1 - (1 - alpha) ^ 3
	local angle = math.rad(-35 + ease * 110)
	local position = o.Center + Vector3.new(math.cos(angle) * o.Radius, o.Height - ease * 6, math.sin(angle) * o.Radius)
	camera.CFrame = CFrame.lookAt(position, o.Center)
end

-- ---------------------------------------------------------------------
-- 3) EFFEKT "Crane" – Kran erscheint, hebt die Platte (Bau gestartet)
-- ---------------------------------------------------------------------
local function onCrane(_strength: number, data: any)
	local plot, d = payload(data)
	if not plot or hidden() then
		return
	end
	local floor = math.max(1, math.floor(num(d.Floor, 1)))
	local seconds = num(d.Seconds, 3)
	call("TowerView", "ShowCrane", plot, floor, seconds)
	local ok, info = call("TowerView", "PlotInfo", plot)
	if not ok or type(info) ~= "table" then
		return
	end
	local pivot: CFrame = info.Pivot
	if not inView(pivot.Position) then
		return
	end
	if isMine(d) then
		sfx("Construct", pivot.Position)
	end
	-- nur kurze Szenen (≤ 6 s) zeigen die Platte am Haken – lange Bauten zeigen den Kran mit Restzeit
	if seconds > 6 or reduced() then
		return
	end
	local stage = math.max(1, math.floor(num(d.Stage, info.Stage)))
	local w = TowerModels.Footprint(stage, floor)
	local fh = TowerModels.FloorHeight()
	local target = pivot * CFrame.new(0, (floor - 1) * fh + 0.5, 0)
	local slab = localPart({
		Name = "LiftSlab",
		Size = Vector3.new(w, 1, w),
		Color = Color3.fromRGB(42, 51, 66),
		Material = Enum.Material.Concrete,
		CFrame = target * CFrame.new(0, 26, 0),
	})
	local glow = Instance.new("SelectionBox")
	glow.Adornee = slab
	glow.Color3 = Theme.Warn
	glow.LineThickness = 0.08
	glow.SurfaceTransparency = 1
	glow.Parent = slab
	table.insert(lifts, {
		Plot = plot,
		Part = slab,
		From = target * CFrame.new(0, 26, 0),
		To = target,
		Start = os.clock(),
		Seconds = math.clamp(math.min(seconds - 0.4, LIFT_SECONDS), 0.8, LIFT_SECONDS),
	})
end

local function stepLifts()
	local t = os.clock()
	for i = #lifts, 1, -1 do
		local lift = lifts[i]
		local alpha = math.clamp((t - lift.Start) / lift.Seconds, 0, 1)
		if lift.Part.Parent == nil then
			table.remove(lifts, i)
			continue
		end
		local ease = 1 - (1 - alpha) ^ 2
		lift.Part.CFrame = lift.From:Lerp(lift.To, ease)
		local ok, hook = call("TowerView", "CraneHook", lift.Plot)
		if ok and typeof(hook) == "Instance" and hook:IsA("BasePart") then
			hook.CFrame = CFrame.new(Vector3.new(hook.Position.X, lift.Part.Position.Y + 4, hook.Position.Z))
		end
		if alpha >= 1 and t - lift.Start > lift.Seconds + 1.2 then
			lift.Part:Destroy()
			table.remove(lifts, i)
		end
	end
end

local function dropLift(plot: number)
	for i = #lifts, 1, -1 do
		if lifts[i].Plot == plot then
			local part = lifts[i].Part
			TweenService:Create(part, TweenInfo.new(0.4), { Transparency = 1 }):Play()
			task.delay(0.45, function()
				part:Destroy()
			end)
			table.remove(lifts, i)
		end
	end
end

-- ---------------------------------------------------------------------
-- 4) EFFEKT "BuildDone" – Fenster leuchten auf, „+X CR/s“, Kamera-Orbit (eigener Bau)
-- ---------------------------------------------------------------------
local function flashFloor(plot: number, floor: number)
	local ok, bands = call("TowerView", "NeonBands", plot)
	if not ok or type(bands) ~= "table" then
		return
	end
	for _, part in ipairs(bands) do
		if part:GetAttribute("Floor") == floor and part.Parent then
			local color = part.Color
			part.Color = Color3.new(1, 1, 1)
			part.Material = Enum.Material.Neon
			TweenService:Create(part, FLASH_INFO, { Color = color }):Play()
		end
	end
end

local function onBuildDone(_strength: number, data: any)
	local plot, d = payload(data)
	if not plot or hidden() then
		return
	end
	dropLift(plot)
	local floor = math.max(1, math.floor(num(d.Floor, 1)))
	flashFloor(plot, floor)
	local top = topCFrame(plot)
	if not top or not inView(top.Position) then
		return
	end
	if isMine(d) then
		local amount = num(d.Amount, 0)
		if amount > 0 then
			floatText(top.Position + Vector3.new(0, 8, 0), T("tui.fx.perSec", credits(amount)), UI.UpColor())
		end
		sfx("Construct", top.Position)
		call("Hud", "PulseCredits", amount)
		startOrbit(plot)
	else
		call("Effects", "Burst", top.Position + Vector3.new(0, 4, 0), Theme.Accent, 12, false)
	end
end

-- ---------------------------------------------------------------------
-- 5) EFFEKT "StageUp" – Morph: alte Hülle blendet aus (TowerView), neue erscheint von unten nach oben
-- ---------------------------------------------------------------------
local function startReveal(plot: number, model: Model)
	local floors: { [number]: { BasePart } } = {}
	local maxFloor = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local f = num(d:GetAttribute("Floor"), -1)
			local key = if f >= 1 then f else 999 -- Säulen/Krone/Plot zuletzt
			floors[key] = floors[key] or {}
			table.insert(floors[key], d)
			if f > maxFloor then
				maxFloor = f
			end
			d.LocalTransparencyModifier = 1
		end
	end
	local ordered: { { Floor: number, Parts: { BasePart } } } = {}
	for f, parts in pairs(floors) do
		table.insert(ordered, { Floor = f, Parts = parts })
	end
	table.sort(ordered, function(a, b)
		return a.Floor < b.Floor
	end)
	table.insert(reveals, { Plot = plot, Model = model, Start = os.clock(), Floors = ordered, Done = 0 })
end

local function stepReveals()
	local t = os.clock()
	for i = #reveals, 1, -1 do
		local reveal = reveals[i]
		local count = #reveal.Floors
		local alpha = math.clamp((t - reveal.Start) / REVEAL_SECONDS, 0, 1)
		local target = math.ceil(alpha * count)
		while reveal.Done < target do
			reveal.Done += 1
			for _, part in ipairs(reveal.Floors[reveal.Done].Parts) do
				if part.Parent then
					part.LocalTransparencyModifier = 0
				end
			end
		end
		if reveal.Done >= count or reveal.Model.Parent == nil then
			for _, entry in ipairs(reveal.Floors) do
				for _, part in ipairs(entry.Parts) do
					part.LocalTransparencyModifier = 0
				end
			end
			table.remove(reveals, i)
		end
	end
end

-- Konfetti-Beams: leuchtende Säulen schießen aus dem Dach
local function launchBeams(top: CFrame, color: Color3)
	for i = 1, 6 do
		local a = (i - 1) / 6 * math.pi * 2
		local from = top * CFrame.new(math.cos(a) * 9, 2, math.sin(a) * 9)
		local part = localPart({
			Name = "StageBeam",
			Size = Vector3.new(0.8, 2, 0.8),
			Color = if i % 2 == 0 then Theme.Gold else color,
			Material = Enum.Material.Neon,
			CFrame = from,
		})
		table.insert(
			beams,
			{ Part = part, From = from, Start = os.clock() + i * 0.05, Seconds = 1.5, Height = 70 + i * 6 }
		)
	end
end

local function stepBeams()
	local t = os.clock()
	for i = #beams, 1, -1 do
		local beam = beams[i]
		local alpha = math.clamp((t - beam.Start) / beam.Seconds, 0, 1)
		if beam.Part.Parent == nil or alpha >= 1 then
			beam.Part:Destroy()
			table.remove(beams, i)
		else
			local height = math.max(2, beam.Height * (1 - (1 - alpha) ^ 3))
			beam.Part.Size = Vector3.new(0.8, height, 0.8)
			beam.Part.CFrame = beam.From * CFrame.new(0, height / 2, 0)
			beam.Part.Transparency = alpha ^ 2
		end
	end
end

local function stageName(stage: number): string
	local tower = ctx.Config.Tower
	local list = if type(tower) == "table" then tower.Stages else nil
	local entry = if type(list) == "table" then list[stage] else nil
	if type(entry) == "table" and type(entry.Name) == "table" then
		return ctx.Lang.Pick(ctx.Lang_(), entry.Name)
	end
	return tostring(stage)
end

local function onStageUp(_strength: number, data: any)
	local plot, d = payload(data)
	if not plot or hidden() then
		return
	end
	morphUntil[plot] = os.clock() + MORPH_WINDOW
	local top = topCFrame(plot)
	local stage = math.max(1, math.floor(num(d.Stage, 1)))
	if top and inView(top.Position) and not reduced() then
		launchBeams(top, Theme.Accent)
	end
	if isMine(d) then
		call("Effects", "Confetti", 1.5)
		call("Effects", "Flash", Theme.Gold, T("tui.fx.stage", stage, stageName(stage)))
		sfx("LevelUp")
		sfx("RallyFanfare")
	end
end

-- ---------------------------------------------------------------------
-- 6) EFFEKT "TransferTube" – leuchtende Röhre von der Börse zum eigenen Tower
-- ---------------------------------------------------------------------
local function exchangePosition(): Vector3
	local city = ctx.Config.City
	local zones = if type(city) == "table" then city.Zones else nil
	local exchange = if type(zones) == "table" then zones.Exchange else nil
	if type(exchange) == "table" then
		local c = exchange.Center
		if typeof(c) == "Vector3" then
			return c + Vector3.new(0, 70, 0)
		elseif type(c) == "table" and type(c[1]) == "number" then
			return Vector3.new(c[1], num(c[2], 0) + 70, num(c[3], -190))
		end
	end
	return EXCHANGE_FALLBACK
end

local function onTransferTube(_strength: number, data: any)
	local plot, d = payload(data)
	local amount = num(d.Amount, 0)
	if not plot or not isMine(d) then
		return
	end
	local top = topCFrame(plot)
	if not top or reduced() or hidden() then
		call("Effects", "Play", "CoinFly", math.max(1, amount))
		call("Hud", "PulseCredits", amount)
		return
	end
	local from = exchangePosition()
	local to = top.Position + Vector3.new(0, 6, 0)
	local mid = (from + to) / 2 + Vector3.new(0, math.max(60, (from - to).Magnitude * 0.25), 0)
	local ball = localPart({
		Name = "TransferTube",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3, 3, 3),
		Color = Theme.Up,
		Material = Enum.Material.Neon,
		CFrame = CFrame.new(from),
	})
	local light = Instance.new("PointLight")
	light.Color = Theme.Up
	light.Range = 18
	light.Brightness = 3
	light.Parent = ball
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = ball
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent = ball
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.9
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(Theme.Up, Theme.Accent)
	trail.Transparency = NumberSequence.new(0, 1)
	trail.WidthScale = NumberSequence.new(1, 0.2)
	trail.Parent = ball
	table.insert(tubes, { Ball = ball, From = from, Mid = mid, To = to, Start = os.clock(), Amount = amount })
	sfx("Whoosh")
end

local function stepTubes()
	local t = os.clock()
	for i = #tubes, 1, -1 do
		local tube = tubes[i]
		local alpha = math.clamp((t - tube.Start) / TUBE_SECONDS, 0, 1)
		local ease = alpha * alpha * (3 - 2 * alpha)
		local a = tube.From:Lerp(tube.Mid, ease)
		local b = tube.Mid:Lerp(tube.To, ease)
		if tube.Ball.Parent then
			tube.Ball.CFrame = CFrame.new(a:Lerp(b, ease))
		end
		if alpha >= 1 then
			table.remove(tubes, i)
			local ball = tube.Ball
			call("Effects", "Burst", tube.To, Theme.Up, 16, true)
			call("Effects", "Play", "CoinFly", math.max(1, tube.Amount))
			call("Hud", "PulseCredits", tube.Amount)
			if tube.Amount > 0 then
				floatText(tube.To + Vector3.new(0, 4, 0), T("tui.fx.credits", credits(tube.Amount)), UI.UpColor())
			end
			task.delay(0.9, function()
				ball:Destroy()
			end)
			ball.Transparency = 1
		end
	end
end

-- ---------------------------------------------------------------------
-- 7) EFFEKT "Collect" – Tresor geleert (Kassen-Tor, HUD, Hausmeister, Auto-Kassierer)
-- ---------------------------------------------------------------------
local function onCollect(strength: number, data: any)
	local plot, d = payload(data)
	if not plot or not isMine(d) then
		return
	end
	local amount = num(d.Amount, 0)
	local ok, model = call("TowerView", "TowerModel", plot)
	local vault: BasePart? = nil
	if ok and typeof(model) == "Instance" then
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") and part:GetAttribute("Vault") == true then
				vault = part
				break
			end
		end
	end
	if vault then
		call(
			"Effects",
			"Burst",
			vault.Position + Vector3.new(0, 2, 0),
			Theme.Gold,
			if strength < 1 then 8 else 18,
			false
		)
	end
	call("Effects", "Play", "CoinFly", math.max(1, amount))
	call("Hud", "PulseCredits", amount)
end

-- ---------------------------------------------------------------------
-- 8) VON TOWERVIEW: neue Hülle (Morph) / Plot frei (Abbau)
-- ---------------------------------------------------------------------
function EffectsTower.OnTowerModel(plot: number, model: Model)
	local untilT = morphUntil[plot]
	if not untilT or os.clock() > untilT or reduced() then
		return
	end
	morphUntil[plot] = nil
	startReveal(plot, model)
end

function EffectsTower.Teardown(plot: number)
	local ok, info = call("TowerView", "PlotInfo", plot)
	if not ok or type(info) ~= "table" or hidden() then
		return
	end
	local pivot: CFrame = info.Pivot
	if not inView(pivot.Position) then
		return
	end
	for i = 1, 4 do
		local a = (i - 1) / 4 * math.pi * 2
		call("Effects", "Puff", (pivot * CFrame.new(math.cos(a) * 18, 2, math.sin(a) * 18)).Position, Theme.Muted, 6)
	end
	sfx("Construct", pivot.Position)
end

function EffectsTower.Step(_dt: number)
	if #lifts > 0 then
		stepLifts()
	end
	if #reveals > 0 then
		stepReveals()
	end
	if #beams > 0 then
		stepBeams()
	end
	if #tubes > 0 then
		stepTubes()
	end
	if orbit then
		stepOrbit()
	end
end

function EffectsTower.Init(context: any)
	ctx = context
	local folder = Instance.new("Folder")
	folder.Name = "AkyTowerFX"
	folder.Parent = workspace
	fxFolder = folder
	local effects = ctx.Modules.Effects
	if not effects or type(effects.Register) ~= "function" then
		warn("[EffectsTower] Effects-Registry fehlt – Tower-Effekte aus")
		return
	end
	effects.Register("BuildDone", onBuildDone)
	effects.Register("StageUp", onStageUp)
	effects.Register("TransferTube", onTransferTube)
	effects.Register("Collect", onCollect)
	effects.Register("Crane", onCrane)
	player.CharacterAdded:Connect(function()
		endOrbit()
	end)
end

function EffectsTower.Start() end

return EffectsTower
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">Elevator</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Aufzug: Etagen-Panel + Kinoszene (Client/Modules/Elevator)
--  Besitzer: WP8 (Turm-Optik, Interiors, Lifestyle). Vertrag: DESIGN.md §B4.10 (Etagen-Panel (UI) -> Client-
--  Kinoszene 1,5 s: Türen zu, Kabine fährt im Schacht, Kamera innen, ElevatorDing, Türen auf; der Server
--  teleportiert die Figur (Request "TowerElevator" {Floor}, Ziel-CFrame + Wurzelhöhen-Versatz, NoteTeleport);
--  keine physikalischen Plattformen; Privat-Etagen für Besucher gesperrt), §D WP8 Abnahme (4) (Ankunft mit Füßen auf
--  dem Boden, kein AntiCheat-Flag – macht PlotService serverseitig), §A4 (ReducedFx = ohne Fahrt).
--
--  Kein eigener Render-Loop: TowerView.Frame ruft Elevator.Step(dt). Kabine, Türen und Licht sind lokale Parts.
--  Öffentliche API (§C7.5):
--    Elevator.Go(floor)            fährt im Tower, in dem man steht (1 = Lobby/Erdgeschoss)
--  Ergänzungen: Elevator.OpenPanel(plot?) · Elevator.ClosePanel() · Elevator.IsRiding(): boolean · Elevator.Step(dt)
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent:WaitForChild("UI"))
local TowerModels = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TowerModels"))

local Elevator = {}

local Theme = UI.Theme
local player = Players.LocalPlayer

local DOOR_SECONDS = 0.3
local RIDE_SECONDS = 0.9
local REPLY_WAIT = 3.5 -- Sekunden: länger wartet die Kabine nicht (Server antwortet erst nach dem Versetzen, ≤ 2 s Streaming)
local PANEL_RANGE = 16 -- Studs: weiter weg -> Panel schließt
local CORE = 10
local CABIN = 8.6
local CABIN_H = 9
local DOOR_Z = -CORE / 2 + 0.45 -- Kabinentür innen im Schacht (nicht auf der Ebene der Etagen-Türen: kein Flimmern)
local HALL_CLOSE_DELAY = 0.7 -- Etagen-Türen bleiben nach der Ankunft so lange offen

type Ride = {
	Plot: number,
	From: number,
	To: number,
	Start: number,
	MoveStart: number?,
	OpenAt: number?,
	EndAt: number?,
	Ok: boolean?,
	Base: CFrame,
	Parts: { BasePart },
	DoorL: BasePart,
	DoorR: BasePart,
	Saved: Enum.CameraType,
	Dinged: boolean,
}

local ctx: any = nil
local panel: Frame? = nil
local grid: Frame? = nil
local titleLabel: TextLabel? = nil
local panelPlot: number? = nil
local panelOrigin: Vector3? = nil
local ride: Ride? = nil
local fxFolder: Folder? = nil
local hallClose: { Plot: number, Floor: number, Start: number }? = nil

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function call(name: string, fnName: string, ...: any): (boolean, any)
	local modules = ctx and ctx.Modules
	local m = modules and modules[name]
	local fn = m and m[fnName]
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function T(key: string, ...: any): string
	return ctx.T(key, ...)
end

local function reduced(): boolean
	local ok, settings = call("Settings", "Get")
	return ok and type(settings) == "table" and settings.ReducedFx == true
end

local function sfx(role: string)
	call("Sfx", "Play", role)
end

local function rootPart(): BasePart?
	local character = player.Character
	local part = character and character:FindFirstChild("HumanoidRootPart")
	return if part and part:IsA("BasePart") then part else nil
end

local function plotInfo(plot: number): { [string]: any }?
	local ok, info = call("TowerView", "PlotInfo", plot)
	return if ok and type(info) == "table" then info else nil
end

-- Privat-Etagen aus dem Layout ("!" am Etagen-Eintrag)
local function privateSet(info: { [string]: any }): { [number]: boolean }
	local set: { [number]: boolean } = {}
	local layout = info.Layout
	if type(layout) ~= "string" or layout == "" then
		return set
	end
	local index = 0
	for chunk in string.gmatch(layout .. ";", "([^;]*);") do
		index += 1
		if string.sub(chunk, 1, 1) == "!" then
			set[index] = true
		end
		if index >= 50 then
			break
		end
	end
	return set
end

local function currentFloor(): number?
	local ok, floor = call("TowerView", "CurrentFloor")
	return if ok and type(floor) == "number" then floor else nil
end

-- ---------------------------------------------------------------------
-- PANEL (Glas-Karte unten in der Mitte, Knöpfe 1 … N, Controller-tauglich)
-- ---------------------------------------------------------------------
local function buildPanel()
	local frame: Frame = UI.Panel({
		Name = "ElevatorPanel",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -130),
		Size = UDim2.fromOffset(520, 300),
		Visible = false,
		ZIndex = 40,
		Parent = ctx.Gui,
	})
	titleLabel = UI.Label({
		Name = "Title",
		Position = UDim2.fromOffset(18, 12),
		Size = UDim2.new(1, -80, 0, 26),
		Face = "Display",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 20,
		ZIndex = 41,
		Parent = frame,
	})
	UI.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(36, 36),
		Text = "✕",
		Variant = "Ghost",
		ZIndex = 41,
		Parent = frame,
	}, function()
		Elevator.ClosePanel()
	end)
	local scroller: ScrollingFrame = UI.Create("ScrollingFrame", {
		Name = "Floors",
		Position = UDim2.fromOffset(14, 48),
		Size = UDim2.new(1, -28, 1, -60),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Muted,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 41,
		Parent = frame,
	})
	local holder = UI.Grid(scroller, 1, 52, 44)
	grid = holder
	panel = frame
end

local function fillPanel(plot: number)
	local holder = grid
	local info = plotInfo(plot)
	if not holder or not info then
		return
	end
	for _, child in ipairs(holder:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local floors = math.max(1, math.floor(tonumber(info.Floors) or 1))
	local private = privateSet(info)
	local owner = info.Owner == player.UserId
	local current = currentFloor() or 1
	if titleLabel then
		titleLabel.Text = UI.Upper(T("tui.elevator.title"))
	end
	for floor = 1, floors do
		local locked = private[floor] == true and not owner
		local here = floor == current
		UI.Button({
			Name = "F" .. floor,
			Size = UDim2.fromOffset(52, 44),
			LayoutOrder = floor,
			Text = if floor == 1 then T("tui.elevator.lobby") elseif locked then "🔒" else tostring(floor),
			Variant = if here then "Primary" elseif locked then "Muted" else "Secondary",
			MaxText = 16,
			Corner = 10,
			ZIndex = 42,
			Parent = holder,
		}, function()
			if locked then
				ctx.Toast(T("tui.elevator.private"), "Error")
				return
			end
			Elevator.Go(floor)
		end)
	end
end

function Elevator.OpenPanel(plot: number?)
	if ride then
		return
	end
	local okInside, inside = call("TowerView", "InsideTower")
	local target = plot or (if okInside then inside else nil)
	if type(target) ~= "number" then
		ctx.Toast(T("tui.elevator.notInside"), "Error")
		return
	end
	if not panel then
		buildPanel()
	end
	panelPlot = target
	local part = rootPart()
	panelOrigin = if part then part.Position else nil
	fillPanel(target)
	local frame = panel
	if frame then
		frame.Visible = true
		local scale = frame:FindFirstChildOfClass("UIScale") or UI.Create("UIScale", { Parent = frame })
		UI.Pulse(scale :: UIScale, 0.04)
	end
	sfx("UIClick")
end

function Elevator.ClosePanel()
	if panel then
		panel.Visible = false
	end
	panelPlot = nil
	panelOrigin = nil
end

function Elevator.IsRiding(): boolean
	return ride ~= nil
end

-- ---------------------------------------------------------------------
-- KINOSZENE: Kabine im Kern, Kamera innen, Türen zu -> Fahrt -> Türen auf (1,5 s)
-- ---------------------------------------------------------------------
local function cabinPart(
	parts: { BasePart },
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material,
	t: number?
): BasePart
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material
	part.Transparency = t or 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = fxFolder
	table.insert(parts, part)
	return part
end

local function cabinBase(info: { [string]: any }, floor: number): CFrame
	local fh = TowerModels.FloorHeight()
	local slab = TowerModels.SlabHeight()
	return (info.Pivot :: CFrame) * CFrame.new(0, (floor - 1) * fh + slab, 0)
end

local function buildCabin(base: CFrame): ({ BasePart }, BasePart, BasePart)
	local parts: { BasePart } = {}
	local glass = Color3.fromRGB(207, 227, 247)
	local metal = Color3.fromRGB(31, 41, 55)
	cabinPart(
		parts,
		Vector3.new(CABIN, 0.3, CABIN),
		base * CFrame.new(0, 0.15, 0),
		Color3.fromRGB(26, 33, 48),
		Enum.Material.Marble
	)
	cabinPart(parts, Vector3.new(CABIN, 0.3, CABIN), base * CFrame.new(0, CABIN_H, 0), metal, Enum.Material.Metal)
	cabinPart(
		parts,
		Vector3.new(0.2, CABIN_H, CABIN),
		base * CFrame.new(-CABIN / 2, CABIN_H / 2, 0),
		glass,
		Enum.Material.Glass,
		0.6
	)
	cabinPart(
		parts,
		Vector3.new(0.2, CABIN_H, CABIN),
		base * CFrame.new(CABIN / 2, CABIN_H / 2, 0),
		glass,
		Enum.Material.Glass,
		0.6
	)
	cabinPart(
		parts,
		Vector3.new(CABIN, CABIN_H, 0.2),
		base * CFrame.new(0, CABIN_H / 2, CABIN / 2),
		glass,
		Enum.Material.Glass,
		0.55
	)
	local strip = cabinPart(
		parts,
		Vector3.new(CABIN - 1, 0.15, 0.6),
		base * CFrame.new(0, CABIN_H - 0.3, 0),
		Theme.Accent,
		Enum.Material.Neon
	)
	local light = Instance.new("PointLight")
	light.Range = 12
	light.Brightness = 1.4
	light.Color = Color3.fromRGB(230, 240, 255)
	light.Parent = strip
	-- Türflügel vorn (−Z), anfangs offen
	local doorW = 2.4
	local doorL = cabinPart(
		parts,
		Vector3.new(doorW, 7.2, 0.2),
		base * CFrame.new(-3.4, 3.6, DOOR_Z),
		Color3.fromRGB(192, 199, 212),
		Enum.Material.Metal
	)
	local doorR = cabinPart(
		parts,
		Vector3.new(doorW, 7.2, 0.2),
		base * CFrame.new(3.4, 3.6, DOOR_Z),
		Color3.fromRGB(192, 199, 212),
		Enum.Material.Metal
	)
	return parts, doorL, doorR
end

local function hallDoors(plot: number, floor: number, openness: number)
	call("TowerView", "SetDoors", plot, floor, openness)
end

local function setDoors(r: Ride, base: CFrame, openness: number)
	local x = 1.2 + openness * 2.2
	r.DoorL.CFrame = base * CFrame.new(-x, 3.6, DOOR_Z)
	r.DoorR.CFrame = base * CFrame.new(x, 3.6, DOOR_Z)
end

local function endRide()
	local r = ride
	if not r then
		return
	end
	ride = nil
	call("WorldLook", "SetCinematic", false)
	local closing = hallClose
	local arrived = closing ~= nil and closing.Plot == r.Plot and closing.Floor == r.To and closing.Start >= r.Start
	if not arrived then
		-- abgebrochen (Respawn, Kamera übernommen): Etagen-Türen nicht halb offen stehen lassen
		hallDoors(r.Plot, r.From, 0)
		hallDoors(r.Plot, r.To, 0)
	end
	for _, part in ipairs(r.Parts) do
		part:Destroy()
	end
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = if r.Saved == Enum.CameraType.Scriptable then Enum.CameraType.Custom else r.Saved
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
end

local function request(floor: number)
	task.spawn(function()
		local reply = ctx.RequestFull("TowerElevator", { Floor = floor })
		local r = ride
		if r and r.To == floor then
			r.Ok = reply.Ok == true
		end
	end)
end

function Elevator.Go(floor: number)
	if type(floor) ~= "number" or floor ~= floor or ride then
		return
	end
	local okInside, plot = call("TowerView", "InsideTower")
	if not okInside or type(plot) ~= "number" then
		ctx.Toast(T("tui.elevator.notInside"), "Error")
		return
	end
	local info = plotInfo(plot)
	if not info then
		return
	end
	local floors = math.max(1, math.floor(tonumber(info.Floors) or 1))
	local target = math.clamp(math.floor(floor), 1, floors)
	local current = currentFloor() or 1
	Elevator.ClosePanel()
	if target == current then
		return
	end
	if privateSet(info)[target] and info.Owner ~= player.UserId then
		ctx.Toast(T("tui.elevator.private"), "Error")
		return
	end
	local camera = workspace.CurrentCamera
	if reduced() or not camera then
		request(target)
		sfx("ElevatorDing")
		return
	end
	local base = cabinBase(info, current)
	local parts, doorL, doorR = buildCabin(base)
	local r: Ride = {
		Plot = plot,
		From = current,
		To = target,
		Start = os.clock(),
		MoveStart = nil,
		OpenAt = nil,
		EndAt = nil,
		Ok = nil,
		Base = base,
		Parts = parts,
		DoorL = doorL,
		DoorR = doorR,
		Saved = camera.CameraType,
		Dinged = false,
	}
	ride = r
	camera.CameraType = Enum.CameraType.Scriptable
	call("WorldLook", "SetCinematic", true, 8) -- Kabine scharf, Schacht/Stadt durchs Glas weich
	camera.CFrame = CFrame.lookAt((base * CFrame.new(0, 5.2, 2.8)).Position, (base * CFrame.new(0, 4.6, -8)).Position)
	request(target)
	sfx("UIClick")
end

local function moveCabin(r: Ride, base: CFrame)
	local delta = base.Position - r.Base.Position
	for _, part in ipairs(r.Parts) do
		part.CFrame = part.CFrame + delta
	end
	r.Base = base
end

function Elevator.Step(_dt: number)
	-- Panel schließt, wenn man weggeht
	local frame = panel
	if frame and frame.Visible and panelOrigin then
		local part = rootPart()
		local okInside, inside = call("TowerView", "InsideTower")
		local left = okInside and panelPlot ~= nil and inside ~= panelPlot
		if not part or left or (part.Position - panelOrigin).Magnitude > PANEL_RANGE then
			Elevator.ClosePanel()
		end
	end
	-- Etagen-Türen nach der Ankunft wieder schließen (die Figur steht schon davor)
	local closing = hallClose
	if closing and not ride then
		local alpha = math.clamp((os.clock() - closing.Start - HALL_CLOSE_DELAY) / (DOOR_SECONDS * 1.5), 0, 1)
		hallDoors(closing.Plot, closing.Floor, 1 - alpha)
		if alpha >= 1 then
			hallClose = nil
		end
	end
	local r = ride
	if not r then
		return
	end
	local camera = workspace.CurrentCamera
	local info = plotInfo(r.Plot)
	if not camera or not info then
		endRide()
		return
	end
	local t = os.clock()
	local elapsed = t - r.Start
	-- 1) Türen schließen (Kabine + Etage)
	if not r.MoveStart then
		local openness = 1 - math.clamp(elapsed / DOOR_SECONDS, 0, 1)
		setDoors(r, r.Base, openness)
		hallDoors(r.Plot, r.From, openness)
		if elapsed >= DOOR_SECONDS then
			if r.Ok == true then
				r.MoveStart = t
			elseif r.Ok == false or elapsed > REPLY_WAIT then
				-- abgelehnt/keine Antwort: Türen wieder auf, zurück zur Figur
				r.MoveStart = t - RIDE_SECONDS
				r.To = r.From
			end
		end
	end
	-- 2) Fahrt im Schacht (Kamera fährt mit)
	local moveStart = r.MoveStart
	if moveStart and not r.OpenAt then
		local alpha = math.clamp((t - moveStart) / RIDE_SECONDS, 0, 1)
		local ease = alpha * alpha * (3 - 2 * alpha)
		local fromBase = cabinBase(info, r.From)
		local toBase = cabinBase(info, r.To)
		moveCabin(r, fromBase:Lerp(toBase, ease))
		setDoors(r, r.Base, 0)
		if alpha >= 1 then
			r.OpenAt = t
			if not r.Dinged then
				r.Dinged = true
				sfx("ElevatorDing")
			end
		end
	end
	-- 3) Türen auf (Kabine + Ziel-Etage), dann Kamera zurück; die Etagen-Türen schließen kurz danach
	local openAt = r.OpenAt
	if openAt then
		local alpha = math.clamp((t - openAt) / DOOR_SECONDS, 0, 1)
		setDoors(r, r.Base, alpha)
		hallDoors(r.Plot, r.To, alpha)
		if alpha >= 1 then
			hallClose = { Plot = r.Plot, Floor = r.To, Start = t }
			endRide()
			return
		end
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		endRide()
		return
	end
	camera.CFrame =
		CFrame.lookAt((r.Base * CFrame.new(0, 5.2, 2.8)).Position, (r.Base * CFrame.new(0, 4.6, -8)).Position)
end

function Elevator.Init(context: any)
	ctx = context
	local folder = Instance.new("Folder")
	folder.Name = "AkyElevatorFX"
	folder.Parent = workspace
	fxFolder = folder
	player.CharacterAdded:Connect(function()
		endRide()
		Elevator.ClosePanel()
	end)
	ctx.Hooks.On("WindowOpened", function()
		Elevator.ClosePanel()
	end)
end

function Elevator.Start() end

return Elevator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">EventsClient</string>
              <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Welt-Events auf dem Client (Client/Modules/EventsClient)
--  Besitzer: WP11 (Admin, Events, Anti-Cheat). Vertrag: DESIGN.md §B10 (Welt-Events, Glocken-Moment, Sky-Show, Bär/Bulle,
--  Bullen-Parade, Geldregen, Samstags-Show), §C7.2 (Hooks World:*), §C7.5 (EventsClient.Active), §C8 (Remote "World"),
--  §C9 (EventPickup), §C16 (Budgets), §0 Regel 2 (keine Animationen: prozedurale CFrame-Bewegung im EINEN PreRender-Loop).
--
--  Aufgaben:
--    * Pickups pro Spieler (World:Pickups / World:PickupGone): Bündel, Pakete, Kugeln, Münzen, Quiz-Felder als LOKALE
--      Teile (kein Wegschnappen, nichts repliziert); automatisches Einsammeln in Reichweite (Request "EventPickup" {Id},
--      Server prüft Abstand ≤ 12, Fenster, Eigentum); "+CR"-Schild, CR-Puls im HUD.
--    * Welt-Darsteller aus State "Event" + World:Event: Geldtransporter (Ring), Liefer-Drohnen, Bau-Boom-Kräne,
--      Roboter-CEO-Hologramm mit Quartalszahlen + Quiz, Bär (stapft auf die Plaza, verbeugt sich bei Erfolg), goldener
--      Bulle (Ring), Bullen-Parade (5 Bullen + „Danke, Name!“), Top-10-Hologramm am Bilanz-Sonntag, Glocken-Zone.
--    * Golden Hour: WorldLook.SetOverride("Golden") solange sie läuft (nur wenn wir es gesetzt haben).
--    * Wartungs-Banner (workspace-Attribut "AT_Maintenance", Live-Ops-Notschalter) und Bär-Fortschritt (World:Bear).
--  Alle Modelle über AssetSlot (Config.Events.Assets, 0 = Code-Rezept aus Parts); Teile gepoolt, Bewegung per
--  workspace:BulkMoveTo. Frame(dt) kommt aus dem einen PreRender-Loop (FRAME_MODULES) und treibt auch EffectsEvent.Step.
--  HUD-Pillen (Welt-Event, ADMIN-ABUSE) zeigt Hud selbst aus State.Event (ein Besitzer je Anzeige, REUSE §7 #39).
--
--  Öffentliche API (§C7.5):
--    EventsClient.Active(): { Types.EventState }
--    EventsClient.Init(ctx) · EventsClient.Start() · EventsClient.Frame(dt)
-- =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent:WaitForChild("UI"))

local EventsClient = {}

local player = Players.LocalPlayer
local ctx: any = nil
local Theme = UI.Theme
local AssetSlot: any = nil

type Visual = { Model: Instance, Parts: { BasePart }, Offsets: { CFrame } }
type TokenVis = {
	Id: number,
	Kind: string,
	Pos: Vector3,
	Until: number,
	Born: number,
	Ready: number, -- ab dann einsammelbar (Fall/Anflug vorbei)
	Visual: Visual,
	Base: string, -- Pool-Schlüssel
	Requested: number,
	Q: number,
	O: number,
	Gui: BillboardGui?,
	Phase: number,
}
type Actor = {
	Key: string,
	Kind: string,
	Started: number,
	Until: number,
	Data: { [string]: any },
	Visuals: { Visual },
	Extra: { [string]: any },
	Leaving: number?,
}
type Route = { Points: { Vector3 }, Cum: { number }, Length: number }

local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(250, 204, 21)
local BROWN = Color3.fromRGB(139, 90, 43)
local BROWN_LIGHT = Color3.fromRGB(210, 166, 121)
local CARDBOARD = Color3.fromRGB(176, 138, 90)
local DARK = Color3.fromRGB(11, 15, 23)
local METAL = Color3.fromRGB(31, 41, 55)
local COSMIC = Color3.fromRGB(124, 156, 255)

local AUTO_RANGE = 9 -- Client sammelt ab hier automatisch (Server erlaubt 12)
local QUIZ_RANGE = 3.6 -- Antwort-Felder: drauf stehen
local REQUEST_GAP = 1.0 -- je Token höchstens 1 Anfrage pro Sekunde
local REQUESTS_PER_SECOND = 8 -- Server-Limit EventPickup 10/s
local COLLECT_CHECK = 0.1
local BELL_CHECK = 0.25
local POOL_MAX = 30
local FLOAT_TEXTS = 6
local COIN_FALL = 40
local DRONE_HEIGHT = 70
local BEAR_WALK = 7 -- Sekunden: Bär stapft vom Rand zur Mitte
local PARADE_GAP = 16 -- Studs zwischen den Parade-Bullen
local MAX_ACTORS = 24

-- ---------------------------------------------------------------------
-- ZUSTAND
-- ---------------------------------------------------------------------
local folder: Folder? = nil
local gui: ScreenGui? = nil
local tokens: { [number]: TokenVis } = {}
local pools: { [string]: { Visual } } = {}
local actors: { [string]: Actor } = {}
local routeCache: { [string]: Route } = {}
local requestTimes: { number } = {}
local floatPool: { { Gui: BillboardGui, Label: TextLabel, Anchor: Part, Until: number } } = {}
local collectAcc = 0
local bellAcc = 0
local goldenSet = false
local photoHidden = false
local bearHave, bearGoal = 0, 0
local profileCache: { [number]: { At: number, Profile: any } } = {}
local pressRequested: { [string]: boolean } = {}

-- UI-Elemente
local bearBar: Frame? = nil
local bearFill: Frame? = nil
local bearLabel: TextLabel? = nil
local banner: Frame? = nil
local bannerLabel: TextLabel? = nil
local bellRing: Part? = nil
local bellGui: BillboardGui? = nil
local bellLabel: TextLabel? = nil

-- ---------------------------------------------------------------------
-- HELFER
-- ---------------------------------------------------------------------
local function T(key: string, ...: any): string
	if ctx and type(ctx.T) == "function" then
		return ctx.T(key, ...)
	end
	return key
end

local function lang(): string
	if ctx and type(ctx.Lang_) == "function" then
		return ctx.Lang_()
	end
	return "en"
end

local function module(name: string): any
	local modules = ctx and ctx.Modules
	return if type(modules) == "table" then modules[name] else nil
end

local function tryModule(name: string, fnName: string, ...: any): (boolean, any)
	local m = module(name)
	local fn = if type(m) == "table" then m[fnName] else nil
	if type(fn) ~= "function" then
		return false, nil
	end
	return pcall(fn, ...)
end

local function now(): number
	local clock = ctx and ctx.Clock
	if clock and type(clock.Now) == "function" then
		local ok, value = pcall(clock.Now)
		if ok and type(value) == "number" then
			return value
		end
	end
	return workspace:GetServerTimeNow()
end

local function num(value: any, default: number): number
	return if type(value) == "number"
			and value == value
			and value ~= math.huge
			and value ~= -math.huge
		then value
		else default
end

local function eventsCfg(): any
	local config = ctx and ctx.Config
	return (config and config.Events) or {}
end

local function sfx(role: string, pos: Vector3?, opts: any?)
	tryModule("Sfx", "Play", role, pos, opts)
end

local function rootOf(): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function plazaCenter(): Vector3
	local city = ctx and ctx.Config and ctx.Config.City
	local zones = city and city.Zones
	local plaza = zones and zones.Plaza
	if plaza and typeof(plaza.Center) == "Vector3" then
		return plaza.Center
	end
	return Vector3.zero
end

local function attrVector(name: string): Vector3?
	local value = workspace:GetAttribute(name)
	return if typeof(value) == "Vector3" then value else nil
end

-- ---------------------------------------------------------------------
-- BAUSTEINE (lokale Teile, nie kollidierend, nie abfragbar)
-- ---------------------------------------------------------------------
local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Mesh" then
			(p :: any)[key] = value
		end
	end
	if props.Mesh == "Sphere" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	return p
end

-- Echte Lichter an den Darstellern (Future-Licht), nur im Licht-Budget der Grafikstufe (Config.Quality.Lights)
local function lightBudget(): number
	local ok, value = tryModule("Quality", "Budget", "Lights")
	return if ok and type(value) == "number" then value else 16
end

local function addLight(parent: BasePart, className: string, minBudget: number, props: { [string]: any })
	if lightBudget() < minBudget then
		return
	end
	local light = Instance.new(className)
	light.Name = "AT_EventLight"
	for key, value in pairs(props) do
		(light :: any)[key] = value
	end
	(light :: any).Shadows = false -- bewegte Darsteller: keine Schatten-Kosten
	light.Parent = parent
end

local function newModel(name: string, parts: { Part }): Model
	local m = Instance.new("Model")
	m.Name = name
	for _, p in ipairs(parts) do
		p.Parent = m
	end
	m.WorldPivot = CFrame.identity
	return m
end

-- Hybrid-Asset (Config.Events.Assets[key]) oder Code-Rezept; alles lokal, verankert, ohne Kollision
local function build(key: string, recipe: () -> Instance): Instance
	local cfg = eventsCfg()
	local slot = cfg.Assets and cfg.Assets[key] or nil
	local inst: Instance
	if AssetSlot and type(AssetSlot.Mesh) == "function" then
		local ok, result = pcall(AssetSlot.Mesh, "Events." .. key, slot, recipe)
		inst = if ok and typeof(result) == "Instance" then result else recipe()
	else
		inst = recipe()
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	if inst:IsA("BasePart") then
		inst.Anchored = true
		inst.CanCollide = false
		inst.CanQuery = false
		inst.CanTouch = false
	end
	return inst
end

local function toVisual(inst: Instance): Visual
	local pivot = if inst:IsA("Model")
		then inst:GetPivot()
		elseif inst:IsA("BasePart") then inst.CFrame
		else CFrame.identity
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	local list = inst:GetDescendants()
	if inst:IsA("BasePart") then
		table.insert(list, 1, inst)
	end
	for _, d in ipairs(list) do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			table.insert(offsets, pivot:ToObjectSpace(d.CFrame))
		end
	end
	inst.Parent = folder
	return { Model = inst, Parts = parts, Offsets = offsets }
end

local bulkParts: { BasePart } = {}
local bulkFrames: { CFrame } = {}

local function queueMove(v: Visual, cf: CFrame)
	for i, p in ipairs(v.Parts) do
		table.insert(bulkParts, p)
		table.insert(bulkFrames, cf * v.Offsets[i])
	end
end

local function flushMoves()
	if #bulkParts > 0 then
		workspace:BulkMoveTo(bulkParts, bulkFrames, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(bulkParts)
		table.clear(bulkFrames)
	end
end

local function setVisible(v: Visual, on: boolean)
	local target = if on then nil else 1
	for _, p in ipairs(v.Parts) do
		local orig = p:GetAttribute("AT_T")
		if orig == nil then
			p:SetAttribute("AT_T", p.Transparency)
			orig = p.Transparency
		end
		p.Transparency = if target then target else orig
	end
end

local function destroyVisual(v: Visual)
	v.Model:Destroy()
end

