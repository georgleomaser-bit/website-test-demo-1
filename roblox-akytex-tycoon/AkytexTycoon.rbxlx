	Minute = 15,
	DayEvery = 3,
}

-- ---------------------------------------------------------------------
-- 3) CRASH & RALLY IN DER WELT (§B10.2; serverlokal, OHNE Markteinfluss)
-- ---------------------------------------------------------------------
Events.Bear = {
	OrbsPerPlayer = 8, -- gleichzeitig sichtbare Vertrauens-Kugeln je Spieler (respawnen nach dem Sammeln)
	GoalPerPlayer = 25, -- Server-Ziel = 25 × anwesende Spieler
	RewardMinutes = 10, -- Erfolg: 10 min Dauer-Einkommen für jeden Teilnehmer
	Seconds = 150, -- Fallphase des Crashs (+ Puffer)
	RadiusMin = 20, -- Kugeln im Ring um die Plaza-Mitte
	RadiusMax = 110,
	OrbsMaxPerPlayer = 60, -- Schutz: höchstens so viele Kugeln je Spieler und Bär
}

Events.GoldenBull = {
	Seconds = 180, -- eine Runde um den Ring-Boulevard
	Route = "Ring",
	TouchRange = 14, -- Berühren = Abstand Wurzel ↔ Bulle (Server misst 1×/s)
	BonusSeconds = 300, -- persönlicher Bullen-Bonus ×1,5 (TowerService.AddBoost "Bull"), 1× je Rally
}

-- ---------------------------------------------------------------------
-- 4) ROBUX-SHOWS (§B10.3; Kauf/Boost macht MonetizationService – hier nur die Welt)
-- ---------------------------------------------------------------------
Events.Parade = {
	Route = "Parade",
	Bulls = 5, -- goldene Bullen hintereinander
	LapSeconds = 150,
	MaxSeconds = 3600, -- Warteschlange höchstens 60 min
}
Events.Fireworks = { Seconds = 20 }

-- ---------------------------------------------------------------------
-- 5) GELDREGEN & PICKUPS
-- ---------------------------------------------------------------------
Events.RainCoinsMax = 30 -- höchstens so viele Münzen je Spieler und Geldregen (live 5 … 30)
Events.RainCoinMinutes = 2 -- je Münze 2 min Dauer-Einkommen
Events.MoneyRain = {
	DefaultSeconds = 120,
	FallSeconds = 1.6, -- Münze fällt so lange, erst danach einsammelbar
	NearShare = 0.5, -- Anteil der Münzen in der Nähe des Spielers, Rest über Plaza und eigenem Plot
	NearMin = 10,
	NearMax = 40,
	Linger = 25, -- liegende Münzen bleiben nach dem Ende noch so lange
}
Events.PickupRange = 12 -- Abstand Wurzel ↔ Pickup (Server)
Events.PickupMaxPerPlayer = 60 -- offene Pickup-Token je Spieler (§C16)
Events.MinPickupCredits = 10 -- Untergrenze je Pickup (neue Spieler mit kleinem Einkommen)
Events.WorldSeasonXp = 50 -- Saison-XP für die Teilnahme an einem Welt-Event (Config.Season.WorldEvent)

-- ---------------------------------------------------------------------
-- 6) WOCHEN-KALENDER (Berlin-Ortszeit über Clock.NextBerlin -> alle Server gleich; Markt-Termine: Config.Market.Weekly)
--    Dow 1 = Mo … 7 = So, fehlt = täglich. Kind: PowerHour | Reminder | AutoShow | LeagueFinale
-- ---------------------------------------------------------------------
Events.Weekly = {
	{ Key = "PowerHour", HH = 19, MM = 0, Kind = "PowerHour", Args = { Minutes = 60 } },
	{ Key = "UpdatePublish", Dow = 6, HH = 16, MM = 0, Kind = "Reminder", Args = { Text = "evt.cal.update" } },
	{ Key = "AdminAbuse", Dow = 6, HH = 18, MM = 0, Kind = "Reminder", Args = { Text = "evt.cal.abuse" } },
	{
		Key = "AutoShow",
		Dow = 6,
		HH = 18,
		MM = 15,
		Kind = "AutoShow",
		Args = { GoldenMult = 2, GoldenMinutes = 30, RainDelay = 75, RainSeconds = 180, FireworksDelay = 260 },
	},
	{ Key = "LeagueFinale", Dow = 7, HH = 20, MM = 0, Kind = "LeagueFinale", Args = { Seconds = 150, Top = 10 } },
}
Events.LeagueBoard = "League" -- LeaderboardService-Brett für die Top-10-Hologramme am Bilanz-Sonntag
Events.KindsHud = { -- Kinds mit Anzeigenamen ui.event.<Kind> (HUD-Pille; Rest = "Welt-Event")
	"Truck",
	"Drones",
	"BuildBoom",
	"Press",
	"BellMoment",
	"SkyShow",
	"Bear",
	"GoldenBull",
	"Parade",
	"Fireworks",
	"MoneyRain",
	"GoldenHour",
	"PowerHour",
	"AutoShow",
}

-- ---------------------------------------------------------------------
-- 7) ADMIN-ABUSE-KATALOG (§B15.3, 21 Events; Texte admin.ev.<Key>) – alles geklemmt, angekündigt, geloggt.
--    Market = true: läuft IMMER global über MarketService.Admin (GlobalBus) und öffnet ein Admin-Fenster (Liga-Taint).
-- ---------------------------------------------------------------------
Events.Catalogue = {
	{ Key = "MegaRally", Market = true },
	{ Key = "MegaCrash", Market = true },
	{ Key = "Pump", Market = true },
	{ Key = "Dump", Market = true },
	{ Key = "News", Market = true },
	{ Key = "Halt", Market = true },
	{ Key = "Resume", Market = true },
	{ Key = "Ipo", Market = true },
	{ Key = "Vol", Market = true },
	{ Key = "Normalize", Market = true },
	{ Key = "MoneyRain", Market = false },
	{ Key = "GoldenHour", Market = false },
	{ Key = "XpRush", Market = false },
	{ Key = "BuildBoom", Market = false },
	{ Key = "Lightshow", Market = false },
	{ Key = "Fireworks", Market = false },
	{ Key = "Confetti", Market = false },
	{ Key = "BellShow", Market = false },
	{ Key = "Boss", Market = false },
	{ Key = "AllToHall", Market = false, LocalOnly = true },
	{ Key = "SaturdayShow", Market = false },
}

Events.AdminLimits = {
	-- Markt (MarketService klemmt zusätzlich; Prozent 5 … 50, Abklingen in Minuten)
	MarketStrength = { 5, 50 },
	Ramp = { 30, 300 },
	DecayMinutes = { 5, 60 },
	CrashWarnSeconds = 180, -- optionale 3-min-Warnung
	HaltSeconds = { 10, 600 },
	Vol = { 0.5, 3 },
	VolMinutes = { 5, 30 },
	NewsChars = 80,
	NewsBand = { 1, 4 },
	-- Nicht-Markt
	MoneyRain = { Seconds = { 60, 300 } },
	GoldenHour = { Mult = { 2, 3 }, Minutes = { 5, 60 } },
	XpRush = { Mult = 2, Minutes = { 15, 60 } },
	BuildBoom = { Minutes = 10, CostMult = 0.5, BuildMult = 0.1 }, -- Etagenkosten −50 %, Bauzeit −90 %
	Lightshow = { Seconds = 75 },
	Fireworks = { Seconds = 20 },
	Confetti = { Seconds = 6 },
	BellShow = { Seconds = 30 },
	Boss = { Seconds = { 60, 300 }, Count = 8, Spacing = 9 },
	SaturdayShow = {
		GoldenMult = 2,
		GoldenMinutes = 30,
		RallyPct = 15,
		RainDelay = 75,
		RainSeconds = 180,
		FireworksDelay = 260,
	},
	AllToHall = { Ring = 4, Spacing = 5 },
}

-- ---------------------------------------------------------------------
-- 8) GLOBALE NACHRICHTEN & NOTSCHALTER
-- ---------------------------------------------------------------------
Events.MaxGlobalSeconds = 3600 -- globale Nachricht: Until ≤ now + 3600 (sonst verworfen)
Events.GlobalLead = 5 -- globale Nicht-Markt-Events starten so viele Sekunden nach dem Senden (alle Server gleich)
Events.GlobalDedupe = 200 -- Dedupe der letzten 200 Ids
Events.BoostPause = false -- Notschalter (live): persönliche Boosts pausieren (TowerService liest das)
Events.AnnounceGap = 1 -- Mindestabstand zweier Ansagen (s)

-- ---------------------------------------------------------------------
-- 9) ASSET-PLÄTZE (Hybrid, §C14.3; 0 = Code-Rezept aus Parts)
-- ---------------------------------------------------------------------
Events.Assets = {
	Truck = slot(), -- gepanzerter Geldtransporter
	Drone = slot(), -- Liefer-Drohne
	Bull = slot(), -- goldener Bulle (Rally, Parade)
	Bear = slot(), -- freundlicher Part-Bär
	Coin = slot(), -- Neon-Münze (Geldregen)
	Bundle = slot(), -- Geld-Bündel (Transporter)
	Package = slot(), -- Drohnen-Paket
	Orb = slot(), -- Vertrauens-Kugel
	Hologram = slot(), -- Roboter-CEO der Pressekonferenz
	Crane = slot(), -- Bau-Boom-Kran
}

-- =====================================================================
-- PRÜFEN (Config.Validate sammelt das) – leere Liste = alles ok
-- =====================================================================
local KNOWN_ROTATION = { Truck = true, Drones = true, BuildBoom = true, Press = true }
local WEEKLY_KINDS = { PowerHour = true, Reminder = true, AutoShow = true, LeagueFinale = true }

local function isNum(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function isInt(value: any): boolean
	return isNum(value) and value % 1 == 0
end

function Events.Validate(_config: any): { string }
	local errors: { string } = {}
	local function add(text: string)
		table.insert(errors, "Config.Events." .. text)
	end
	local function positive(path: string, value: any)
		if not isNum(value) or value <= 0 then
			add(path .. ": Zahl > 0 erwartet")
		end
	end
	local function range(path: string, value: any)
		if type(value) ~= "table" or not isNum(value[1]) or not isNum(value[2]) or value[1] > value[2] then
			add(path .. ": { min, max } mit min ≤ max erwartet")
		end
	end

	-- 1) Rotation + Welt-Events
	if type(Events.Rotation) ~= "table" or #Events.Rotation < 1 or #Events.Rotation > 4 then
		add("Rotation: 1 … 4 Einträge erwartet")
	else
		local seen: { [string]: boolean } = {}
		for _, kind in ipairs(Events.Rotation) do
			if not KNOWN_ROTATION[kind] or seen[kind] then
				add("Rotation: unbekannter oder doppelter Eintrag " .. tostring(kind))
			end
			seen[kind] = true
		end
	end
	if not isInt(Events.WorldMinute) or Events.WorldMinute < 1 or Events.WorldMinute > 18 then
		add("WorldMinute: 1 … 18 erwartet")
	end
	if not isInt(Events.Truck.Bundles) or Events.Truck.Bundles < 1 or Events.Truck.Bundles > 60 then
		add("Truck.Bundles: 1 … 60 erwartet")
	end
	for _, key in ipairs({ "IncomeSeconds", "Seconds", "Lateral", "Linger" }) do
		positive("Truck." .. key, (Events.Truck :: any)[key])
	end
	if not isInt(Events.Drones.Packages) or Events.Drones.Packages < 1 or Events.Drones.Packages > 30 then
		add("Drones.Packages: 1 … 30 erwartet")
	end
	for _, key in ipairs({ "IncomeSeconds", "Seconds", "DropSeconds", "Spread" }) do
		positive("Drones." .. key, (Events.Drones :: any)[key])
	end
	if not isNum(Events.BuildBoom.Pct) or Events.BuildBoom.Pct <= 0 or Events.BuildBoom.Pct >= 1 then
		add("BuildBoom.Pct: 0 < x < 1 erwartet")
	end
	positive("BuildBoom.Seconds", Events.BuildBoom.Seconds)
	local press = Events.Press
	positive("Press.Seconds", press.Seconds)
	positive("Press.QuizXp", press.QuizXp)
	if not isInt(press.Questions) or press.Questions < 1 or press.Questions > #press.Quiz then
		add("Press.Questions: 1 … #Quiz erwartet")
	end
	if not isInt(press.PassCorrect) or press.PassCorrect < 1 or press.PassCorrect > press.Questions then
		add("Press.PassCorrect: 1 … Questions erwartet")
	end
	local quizIds: { [number]: boolean } = {}
	for index, q in ipairs(press.Quiz) do
		if not isInt(q.Id) or quizIds[q.Id] then
			add(("Press.Quiz[%d].Id: eindeutige ganze Zahl erwartet"):format(index))
		else
			quizIds[q.Id] = true
		end
		if not isInt(q.Correct) or q.Correct < 1 or q.Correct > 3 then
			add(("Press.Quiz[%d].Correct: 1 … 3 erwartet"):format(index))
		end
	end

	-- 2) Stündlich
	local bell = Events.BellMoment
	if not isInt(bell.MinPlayers) or bell.MinPlayers < 1 then
		add("BellMoment.MinPlayers: ganze Zahl ≥ 1 erwartet")
	end
	if not isNum(bell.Mult) or bell.Mult < 1 or bell.Mult > 1.5 then
		add("BellMoment.Mult: 1 … 1,5 erwartet")
	end
	for _, key in ipairs({ "Seconds", "DayEvery", "WindowSeconds", "ZoneRadius" }) do
		positive("BellMoment." .. key, (bell :: any)[key])
	end
	local sky = Events.SkyShow
	for _, key in ipairs({ "RespektMult", "Seconds", "ShowSeconds", "DayEvery" }) do
		positive("SkyShow." .. key, (sky :: any)[key])
	end
	if not isInt(sky.Minute) or sky.Minute < 0 or sky.Minute > 19 then
		add("SkyShow.Minute: 0 … 19 erwartet")
	end

	-- 3) Bär/Bulle
	local bear = Events.Bear
	for _, key in ipairs({ "OrbsPerPlayer", "GoalPerPlayer", "RewardMinutes", "Seconds", "OrbsMaxPerPlayer" }) do
		positive("Bear." .. key, (bear :: any)[key])
	end
	if not isNum(bear.RadiusMin) or not isNum(bear.RadiusMax) or bear.RadiusMin >= bear.RadiusMax then
		add("Bear.RadiusMin/RadiusMax: min < max erwartet")
	end
	for _, key in ipairs({ "Seconds", "TouchRange", "BonusSeconds" }) do
		positive("GoldenBull." .. key, (Events.GoldenBull :: any)[key])
	end

	-- 4/5) Shows, Geldregen, Pickups
	positive("Parade.Bulls", Events.Parade.Bulls)
	positive("Parade.LapSeconds", Events.Parade.LapSeconds)
	positive("Fireworks.Seconds", Events.Fireworks.Seconds)
	if not isInt(Events.RainCoinsMax) or Events.RainCoinsMax < 1 or Events.RainCoinsMax > 30 then
		add("RainCoinsMax: 1 … 30 erwartet (§B15.3)")
	end
	positive("RainCoinMinutes", Events.RainCoinMinutes)
	positive("MoneyRain.FallSeconds", Events.MoneyRain.FallSeconds)
	if not isNum(Events.MoneyRain.NearShare) or Events.MoneyRain.NearShare < 0 or Events.MoneyRain.NearShare > 1 then
		add("MoneyRain.NearShare: 0 … 1 erwartet")
	end
	positive("PickupRange", Events.PickupRange)
	if not isInt(Events.PickupMaxPerPlayer) or Events.PickupMaxPerPlayer < 10 or Events.PickupMaxPerPlayer > 60 then
		add("PickupMaxPerPlayer: 10 … 60 erwartet (§C16)")
	end
	if not isInt(Events.MinPickupCredits) or Events.MinPickupCredits < 0 then
		add("MinPickupCredits: ganze Zahl ≥ 0 erwartet")
	end

	-- 6) Wochen-Kalender
	local weeklyKeys: { [string]: boolean } = {}
	for index, entry in ipairs(Events.Weekly) do
		local where = ("Weekly[%d]"):format(index)
		if type(entry.Key) ~= "string" or weeklyKeys[entry.Key] then
			add(where .. ".Key: eindeutiger Text erwartet")
		else
			weeklyKeys[entry.Key] = true
		end
		if entry.Dow ~= nil and (not isInt(entry.Dow) or entry.Dow < 1 or entry.Dow > 7) then
			add(where .. ".Dow: 1 … 7 oder leer (täglich) erwartet")
		end
		if
			not isInt(entry.HH)
			or entry.HH < 0
			or entry.HH > 23
			or not isInt(entry.MM)
			or entry.MM < 0
			or entry.MM > 59
		then
			add(where .. ": HH 0 … 23 und MM 0 … 59 erwartet")
		end
		if not WEEKLY_KINDS[entry.Kind] then
			add(where .. ".Kind: PowerHour/Reminder/AutoShow/LeagueFinale erwartet")
		end
		if type(entry.Args) ~= "table" then
			add(where .. ".Args: Tabelle erwartet")
		end
	end

	-- 7) Katalog + Grenzen
	if #Events.Catalogue ~= 21 then
		add(("Catalogue: 21 Admin-Abuse-Events erwartet (§B15.3), gefunden %d"):format(#Events.Catalogue))
	end
	local catKeys: { [string]: boolean } = {}
	for index, entry in ipairs(Events.Catalogue) do
		if type(entry.Key) ~= "string" or catKeys[entry.Key] then
			add(("Catalogue[%d].Key: eindeutiger Text erwartet"):format(index))
		else
			catKeys[entry.Key] = true
		end
		if type(entry.Market) ~= "boolean" then
			add(("Catalogue[%d].Market: true/false erwartet"):format(index))
		end
	end
	local limits = Events.AdminLimits
	for _, key in ipairs({ "MarketStrength", "Ramp", "DecayMinutes", "HaltSeconds", "Vol", "VolMinutes", "NewsBand" }) do
		range("AdminLimits." .. key, (limits :: any)[key])
	end
	if isNum(limits.MarketStrength[2]) and limits.MarketStrength[2] > 50 then
		add("AdminLimits.MarketStrength: höchstens 50 % (§B15.3)")
	end
	range("AdminLimits.MoneyRain.Seconds", limits.MoneyRain.Seconds)
	range("AdminLimits.GoldenHour.Mult", limits.GoldenHour.Mult)
	range("AdminLimits.GoldenHour.Minutes", limits.GoldenHour.Minutes)
	range("AdminLimits.XpRush.Minutes", limits.XpRush.Minutes)
	range("AdminLimits.Boss.Seconds", limits.Boss.Seconds)
	if isNum(limits.GoldenHour.Mult[2]) and limits.GoldenHour.Mult[2] > 3 then
		add("AdminLimits.GoldenHour.Mult: höchstens ×3 (Deckel Config.Tower.Mult.EventMax)")
	end
	positive("AdminLimits.NewsChars", limits.NewsChars)
	positive("AdminLimits.CrashWarnSeconds", limits.CrashWarnSeconds)
	positive("AdminLimits.BuildBoom.Minutes", limits.BuildBoom.Minutes)
	positive("AdminLimits.Boss.Count", limits.Boss.Count)

	-- 8) Global
	if not isNum(Events.MaxGlobalSeconds) or Events.MaxGlobalSeconds < 60 or Events.MaxGlobalSeconds > 3600 then
		add("MaxGlobalSeconds: 60 … 3600 erwartet (§C13)")
	end
	positive("GlobalLead", Events.GlobalLead)
	if not isInt(Events.GlobalDedupe) or Events.GlobalDedupe < 50 then
		add("GlobalDedupe: ganze Zahl ≥ 50 erwartet")
	end
	if type(Events.BoostPause) ~= "boolean" then
		add("BoostPause: true/false erwartet")
	end
	if type(Events.LeagueBoard) ~= "string" then
		add("LeagueBoard: Text erwartet")
	end
	return errors
end

return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Lifestyle</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Lifestyle: Uhren, Accessoires, Jetpack (Config.Lifestyle)
--  Besitzer: WP8 (Turm-Optik, Interiors, Lifestyle). Vertrag: DESIGN.md §C14.2 (Lifestyle), §B12.2 (Uhren), §B12.3
--  (Accessoires), §B12.4 (Neon-Jetpack, nur Werte), §B9.6 (Vorstand „Lifestyle“), §C14.3 (Asset-/Bild-Plätze).
--  Jugendfrei: kein Alkohol, keine Zigarren, keine Partys. Alles aus Parts (keine hochgeladene Kleidung).
--  Wird an alle Clients repliziert -> KEINE Geheimnisse hier! Lädt keine Roblox-Dienste (Luau-CLI-ladbar).
--
--  Abschnitte:
--    1) Regeln (max. 3 Accessoires, Vorstand-Rabatt, Zeiger-Reichweite)
--    2) Boutique-Rotation (Ersatzwerte, falls Config.Shop / ShopService.Rotation fehlen)
--    3) Uhren (15)        4) Accessoires (8)        5) Neon-Jetpack (Pass, §B12.4)
--  Quelle (Source): "Shop" (CR, Price > 0) · "Starter" (Starter-Paket) · "Login" (Login-Kalender) · "Season"
--    (Skyline-Pass) · "Perk" (Vorstand-Ast Perk.Branch ab Perk.Level) · "Pass" (Gamepass Pass) · "Licence"
--    (ab Lizenz-Index Licence) · "Group" (Gruppe „AKYTEX Games“, Data.Social.Group). Nicht-Shop-Teile: Price = 0,
--    Value = Sammlungswert für das Vermögen (LifestyleService.CollectionValue).
--  Recipe = Bau-Rezept für Shared/LifestyleModels. Asset = Mesh-Platz, ImageId = Boutique-Bild (0 = Code-Grafik).
--  Helfer: Lifestyle.ByKey[key] (Uhr ODER Accessoire), Lifestyle.Validate(Config): { string }
-- =====================================================================

local Lifestyle = {}

local IDENTITY: any = nil
pcall(function()
	IDENTITY = (CFrame :: any).identity
end)

local function slot(): { [string]: any }
	return { MeshId = 0, TextureId = 0, Scale = 1, Offset = IDENTITY }
end

-- ---------------------------------------------------------------------
-- 1) REGELN
-- ---------------------------------------------------------------------
Lifestyle.MaxAccessories = 3 -- höchstens 3 Accessoires gleichzeitig (§B12.3)
Lifestyle.Perk = { Branch = "Lifestyle", Pct = 0.05, Max = 5 } -- −5 % Uhren-/Deko-Preise je Stufe (§B9.6)
Lifestyle.WatchRange = 60 -- Zeiger drehen nur ≤ 60 Studs von der Kamera (§B12.2)
Lifestyle.SlotNames = { "Watch", "Acc" } -- LifeEquip { Slot = "Watch" | "Acc", Key? }

-- ---------------------------------------------------------------------
-- 2) BOUTIQUE-ROTATION (Ersatz; maßgeblich ist ShopService.Rotation / Config.Shop.BoutiqueHours/-Slots)
-- ---------------------------------------------------------------------
Lifestyle.Boutique = { Hours = 4, Slots = 6 }

-- ---------------------------------------------------------------------
-- 3) UHREN (15) – am Handgelenk für alle sichtbar, 6–10 Parts (§B12.2)
-- ---------------------------------------------------------------------
local function watch(
	key: string,
	de: string,
	en: string,
	price: number,
	source: string,
	recipe: { [string]: any },
	extra: { [string]: any }?
): { [string]: any }
	local entry: { [string]: any } = {
		Key = key,
		Name = { de = de, en = en },
		Price = price,
		Source = source,
		Value = price,
		Recipe = recipe,
		Asset = slot(),
		ImageId = 0,
	}
	if extra then
		for k, v in pairs(extra) do
			entry[k] = v
		end
	end
	return entry
end

-- Recipe: Case (Gehäuse), Dial (Zifferblatt), Strap (Armband), Hands (Zeiger), Glow (Neon-Akzent),
--         M (Gehäuse-Material), Shape ("Round" | "Square"), Bezel (Lünette ja/nein)
-- stylua: ignore start
Lifestyle.Watches = {
	watch("FirstBell",      "Erste Glocke",        "First Bell",           0,             "Starter", { Case = "#c0c7d4", Dial = "#0b0f17", Strap = "#1f2937", Hands = "#facc15", Glow = "#4f8cff", M = "Metal", Shape = "Round", Bezel = false }, { Value = 25000 }),
	watch("Copper",         "Kupfer Classic",      "Copper Classic",       50000,         "Shop",    { Case = "#b8733d", Dial = "#f4e3c1", Strap = "#5b3a24", Hands = "#1a1410", Glow = "#b8733d", M = "Metal", Shape = "Round", Bezel = false }),
	watch("NeonPulse",      "Neon Pulse",          "Neon Pulse",           2000000,       "Shop",    { Case = "#121824", Dial = "#0b0f17", Strap = "#121824", Hands = "#22d3ee", Glow = "#22d3ee", M = "SmoothPlastic", Shape = "Square", Bezel = false }),
	watch("ChronoL",        "Chrono Λ",            "Chrono Λ",             80000000,      "Shop",    { Case = "#d7dee8", Dial = "#1a2130", Strap = "#d7dee8", Hands = "#4f8cff", Glow = "#4f8cff", M = "Metal", Shape = "Round", Bezel = true }),
	watch("OrbitGold",      "Orbit Gold",          "Orbit Gold",           3000000000,    "Shop",    { Case = "#facc15", Dial = "#0b0f17", Strap = "#1a1410", Hands = "#ffcf6e", Glow = "#facc15", M = "Metal", Shape = "Round", Bezel = true }),
	watch("DiamondTicker",  "Diamant-Ticker",      "Diamond Ticker",       2000000000000, "Shop",    { Case = "#e0f2fe", Dial = "#0b0f17", Strap = "#c0c7d4", Hands = "#a5f3fc", Glow = "#a5f3fc", M = "Glass", Shape = "Square", Bezel = true }),
	watch("WeekChrono",     "Wochen-Chrono",       "Week Chrono",          0,             "Login",   { Case = "#7d889a", Dial = "#121824", Strap = "#2a3342", Hands = "#22c55e", Glow = "#22c55e", M = "Metal", Shape = "Round", Bezel = true }, { Value = 500000 }),
	watch("SkylineChrono",  "Skyline-Chrono",      "Skyline Chrono",       0,             "Season",  { Case = "#1a1440", Dial = "#0b0f17", Strap = "#7c5cff", Hands = "#b36bff", Glow = "#7c5cff", M = "Metal", Shape = "Square", Bezel = true }, { Value = 50000000 }),
	watch("BellTourbillon", "Glocken-Tourbillon",  "Bell Tourbillon",      0,             "Perk",    { Case = "#facc15", Dial = "#f4f6fa", Strap = "#3a2418", Hands = "#1a1410", Glow = "#ffcf6e", M = "Metal", Shape = "Round", Bezel = true }, { Perk = { Branch = "Lifestyle", Level = 5 }, Value = 1000000000 }),
	watch("ChronoNight",    "Chrono Nacht",        "Chrono Night",         0,             "Pass",    { Case = "#0b0f17", Dial = "#03040a", Strap = "#0b0f17", Hands = "#7c9cff", Glow = "#3b5bdb", M = "Metal", Shape = "Round", Bezel = true }, { Pass = "Chrono", Value = 5000000 }),
	watch("ChronoAurora",   "Chrono Aurora",       "Chrono Aurora",        0,             "Pass",    { Case = "#1a2130", Dial = "#0b0f17", Strap = "#1a2130", Hands = "#22c55e", Glow = "#22d3ee", M = "Metal", Shape = "Round", Bezel = true }, { Pass = "Chrono", Value = 5000000 }),
	watch("ChronoArctic",   "Chrono Arktis",       "Chrono Arctic",        0,             "Pass",    { Case = "#e6ecf5", Dial = "#dbeafe", Strap = "#f4f6fa", Hands = "#2563eb", Glow = "#93c5fd", M = "Metal", Shape = "Square", Bezel = false }, { Pass = "Chrono", Value = 5000000 }),
	watch("ChronoSolar",    "Chrono Solar",        "Chrono Solar",         0,             "Pass",    { Case = "#f59e0b", Dial = "#1a1410", Strap = "#3a2418", Hands = "#facc15", Glow = "#f59e0b", M = "Metal", Shape = "Round", Bezel = true }, { Pass = "Chrono", Value = 5000000 }),
	watch("ChronoMidnight", "Chrono Mitternacht",  "Chrono Midnight",      0,             "Pass",    { Case = "#1e1b4b", Dial = "#03040a", Strap = "#1e1b4b", Hands = "#b36bff", Glow = "#7c5cff", M = "Metal", Shape = "Square", Bezel = true }, { Pass = "Chrono", Value = 5000000 }),
	watch("Legend",         "Legenden-Uhr",        "Legend Watch",         0,             "Licence", { Case = "#facc15", Dial = "#03040a", Strap = "#facc15", Hands = "#f4f6fa", Glow = "#7c5cff", M = "Metal", Shape = "Round", Bezel = true }, { Licence = 10, Value = 10000000000 }),
}

-- ---------------------------------------------------------------------
-- 4) ACCESSOIRES (8) – aus Parts, max. 3 gleichzeitig (§B12.3). Attach: Head | Torso | RightHand | Root
-- ---------------------------------------------------------------------
local function acc(
	key: string,
	de: string,
	en: string,
	price: number,
	source: string,
	attach: string,
	recipe: { [string]: any },
	extra: { [string]: any }?
): { [string]: any }
	local entry: { [string]: any } = {
		Key = key,
		Name = { de = de, en = en },
		Price = price,
		Source = source,
		Value = price,
		Attach = attach,
		Recipe = recipe,
		Asset = slot(),
		ImageId = 0,
	}
	if extra then
		for k, v in pairs(extra) do
			entry[k] = v
		end
	end
	return entry
end

Lifestyle.Accessories = {
	acc("Sunglasses",     "Sonnenbrille",     "Sunglasses",       10000,       "Shop",    "Head",      { Kind = "Sunglasses", A = "#0b0f17", B = "#1f2937", C = "#4f8cff" }),
	acc("TiePin",         "Krawattennadel",   "Tie Pin",          100000,      "Shop",    "Torso",     { Kind = "TiePin", A = "#facc15", B = "#c0c7d4", C = "#4f8cff" }),
	acc("Briefcase",      "Aktentasche",      "Briefcase",        1000000,     "Shop",    "RightHand", { Kind = "Briefcase", A = "#3a2418", B = "#c8a165", C = "#1a1410" }),
	acc("LapelNeon",      "Revers-Neon",      "Lapel Neon",       20000000,    "Shop",    "Torso",     { Kind = "Lapel", A = "#22d3ee", B = "#121824", C = "#22d3ee" }),
	acc("AuraBlue",       "Aura-Ring Blau",   "Aura Ring Blue",   500000000,   "Shop",    "Root",      { Kind = "Aura", A = "#4f8cff", B = "#7c9cff", C = "#4f8cff" }),
	acc("AuraGold",       "Aura-Ring Gold",   "Aura Ring Gold",   10000000000, "Shop",    "Root",      { Kind = "Aura", A = "#facc15", B = "#ffcf6e", C = "#facc15" }),
	acc("HoloBadge",      "Holo-Abzeichen",   "Holo Badge",       0,           "Licence", "Torso",     { Kind = "Badge", A = "#7c5cff", B = "#121824", C = "#b36bff" }, { Licence = 7, Value = 400000000 }),
	acc("CommunityCrown", "Community-Krone",  "Community Crown",  0,           "Group",   "Head",      { Kind = "Crown", A = "#4f8cff", B = "#facc15", C = "#7c9cff" }, { Value = 100000 }),
}
-- stylua: ignore end

-- ---------------------------------------------------------------------
-- 5) NEON-JETPACK (Gamepass „Jetpack“, §B12.4) – Werte für Flug-Code und Anti-Cheat-Erlaubnis
-- ---------------------------------------------------------------------
Lifestyle.Jetpack = {
	Pass = "Jetpack",
	Fuel = 8, -- Sekunden Schub
	Recharge = 12, -- Sekunden bis voll
	MaxHeight = 120, -- Studs über Boden (und über dem Startpunkt – so rechnet auch der Anti-Cheat)
	VerticalMult = 3, -- Untergrenze; LifestyleService nimmt max(diesen Wert, Security-Erlaubnis, MaxHeight-Bedarf)
	SpeedMult = 1.6, -- Anti-Cheat-Erlaubnis (waagerecht) nur während aktiv (SetAllowance)
	Thrust = 30, -- Studs/s Steigen (Sprung gehalten)
	Glide = 8, -- Studs/s Sinken (Sprung los)
	AirSpeed = 44, -- Studs/s waagerecht (bleibt unter 32 × SpeedMult × 1,15 + 6)
	Asset = slot(),
}

-- Nachschlagen: Schlüssel -> Eintrag (Uhren und Accessoires teilen sich den Namensraum)
Lifestyle.ByKey = {} :: { [string]: { [string]: any } }
Lifestyle.KindOf = {} :: { [string]: string } -- Schlüssel -> "Watch" | "Accessory"
for _, entry in ipairs(Lifestyle.Watches) do
	assert(Lifestyle.ByKey[entry.Key] == nil, "[Config.Lifestyle] doppelter Schlüssel " .. entry.Key)
	Lifestyle.ByKey[entry.Key] = entry
	Lifestyle.KindOf[entry.Key] = "Watch"
end
for _, entry in ipairs(Lifestyle.Accessories) do
	assert(Lifestyle.ByKey[entry.Key] == nil, "[Config.Lifestyle] doppelter Schlüssel " .. entry.Key)
	Lifestyle.ByKey[entry.Key] = entry
	Lifestyle.KindOf[entry.Key] = "Accessory"
end

-- =====================================================================
-- PRÜFUNG
-- =====================================================================
local SOURCES: { [string]: boolean } = {
	Shop = true,
	Starter = true,
	Login = true,
	Season = true,
	Perk = true,
	Pass = true,
	Licence = true,
	Group = true,
}
local ATTACH: { [string]: boolean } = { Head = true, Torso = true, RightHand = true, Root = true }

local function isNum(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function isPair(v: any): boolean
	return type(v) == "table" and type(v.de) == "string" and v.de ~= "" and type(v.en) == "string" and v.en ~= ""
end

local function isHex(v: any): boolean
	return type(v) == "string" and string.match(v, "^#%x%x%x%x%x%x$") ~= nil
end

function Lifestyle.Validate(_config: any): { string }
	local errors: { string } = {}
	local function add(text: string)
		table.insert(errors, "Config.Lifestyle." .. text)
	end
	local function int(path: string, v: any, lo: number, hi: number)
		if not isNum(v) or v % 1 ~= 0 or v < lo or v > hi then
			add(("%s: ganze Zahl %s … %s erwartet"):format(path, tostring(lo), tostring(hi)))
		end
	end
	int("MaxAccessories", Lifestyle.MaxAccessories, 1, 6)
	int("WatchRange", Lifestyle.WatchRange, 10, 500)
	int("Perk.Max", Lifestyle.Perk.Max, 0, 10)
	if not isNum(Lifestyle.Perk.Pct) or Lifestyle.Perk.Pct < 0 or Lifestyle.Perk.Pct * Lifestyle.Perk.Max >= 1 then
		add("Perk.Pct: Rabatt muss unter 100 % bleiben")
	end
	int("Boutique.Hours", Lifestyle.Boutique.Hours, 1, 48)
	int("Boutique.Slots", Lifestyle.Boutique.Slots, 1, 24)
	local function common(list: { any }, label: string, count: number, check: (entry: any, where: string) -> ())
		if #list ~= count then
			add(("%s: genau %d Einträge erwartet, gefunden %d"):format(label, count, #list))
		end
		for i, entry in ipairs(list) do
			local where = ("%s[%d] (%s)"):format(label, i, tostring(entry.Key))
			if type(entry.Key) ~= "string" or not string.match(entry.Key, "^[%w_]+$") or #entry.Key > 40 then
				add(where .. ".Key: Buchstaben/Ziffern (≤ 40) erwartet")
			end
			if not isPair(entry.Name) then
				add(where .. ".Name: { de, en } erwartet")
			end
			if not SOURCES[entry.Source] then
				add(where .. ".Source: unbekannte Quelle")
			elseif entry.Source == "Shop" then
				int(where .. ".Price", entry.Price, 1, 1e14 - 1)
			elseif entry.Price ~= 0 then
				add(where .. ".Price: 0 erwartet (nicht kaufbar)")
			end
			if entry.Source == "Pass" and (type(entry.Pass) ~= "string" or entry.Pass == "") then
				add(where .. ".Pass: Pass-Schlüssel erwartet")
			end
			if entry.Source == "Licence" then
				int(where .. ".Licence", entry.Licence, 1, 10)
			end
			if entry.Source == "Perk" then
				local perk = entry.Perk
				if type(perk) ~= "table" or type(perk.Branch) ~= "string" then
					add(where .. ".Perk: { Branch, Level } erwartet")
				else
					int(where .. ".Perk.Level", perk.Level, 1, 10)
				end
			end
			int(where .. ".Value", entry.Value, 0, 1e14 - 1)
			if type(entry.Recipe) ~= "table" then
				add(where .. ".Recipe: Tabelle erwartet")
			end
			check(entry, where)
		end
	end
	common(Lifestyle.Watches, "Watches", 15, function(entry: any, where: string)
		local r = entry.Recipe
		if type(r) == "table" then
			for _, field in ipairs({ "Case", "Dial", "Strap", "Hands", "Glow" }) do
				if not isHex(r[field]) then
					add(where .. ".Recipe." .. field .. ": #rrggbb erwartet")
				end
			end
			if r.Shape ~= "Round" and r.Shape ~= "Square" then
				add(where .. ".Recipe.Shape: Round/Square erwartet")
			end
		end
	end)
	common(Lifestyle.Accessories, "Accessories", 8, function(entry: any, where: string)
		if not ATTACH[entry.Attach] then
			add(where .. ".Attach: Head/Torso/RightHand/Root erwartet")
		end
		local r = entry.Recipe
		if type(r) == "table" then
			if type(r.Kind) ~= "string" then
				add(where .. ".Recipe.Kind: Text erwartet")
			end
			for _, field in ipairs({ "A", "B", "C" }) do
				if not isHex(r[field]) then
					add(where .. ".Recipe." .. field .. ": #rrggbb erwartet")
				end
			end
		end
	end)
	local jet = Lifestyle.Jetpack
	int("Jetpack.Fuel", jet.Fuel, 1, 60)
	int("Jetpack.Recharge", jet.Recharge, 1, 120)
	int("Jetpack.MaxHeight", jet.MaxHeight, 10, 400)
	if not isNum(jet.VerticalMult) or jet.VerticalMult < 1 or jet.VerticalMult > 10 then
		add("Jetpack.VerticalMult: Zahl 1 … 10 erwartet")
	end
	if not isNum(jet.SpeedMult) or jet.SpeedMult < 1 or jet.SpeedMult > 5 then
		add("Jetpack.SpeedMult: Zahl 1 … 5 erwartet")
	end
	for _, field in ipairs({ "Thrust", "Glide", "AirSpeed" }) do
		local value = jet[field]
		if not isNum(value) or value < 1 or value > 120 then
			add("Jetpack." .. field .. ": Zahl 1 … 120 erwartet")
		end
	end
	if isNum(jet.AirSpeed) and isNum(jet.SpeedMult) and jet.AirSpeed > 32 * jet.SpeedMult * 1.15 then
		add("Jetpack.AirSpeed: muss unter der Anti-Cheat-Erlaubnis bleiben (32 × SpeedMult × 1,15)")
	end
	return errors
end

return Lifestyle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Market</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Stellschrauben der Markt-Engine (Config.Market)
--  Besitzer: WP3 (Markt-Engine). Vertrag: DESIGN.md §B6, §B6.3, §B10.4, §B15.3, §C14.2, §C19; MARKET.md §3–§10, §13, §17.
--  Jede Zahl hier ist ein Startwert aus der Spec und wurde mit tools/market_calibrate.py geprüft (Gates G5/G6).
--  Nach JEDER Änderung an Rauschen, News, Bändern oder Bremse: `python3 tools/market_calibrate.py` laufen lassen.
--
--  WICHTIG – Determinismus: Alle Server rechnen denselben Kurs aus Wochen-Seed + Tick + Event-Liste. Werte, die den
--  Kurs verändern, nur zum Wochenwechsel ändern (Montag 00:00 UTC) – sonst sehen Server mit alter/neuer Config
--  verschiedene Kurse. Einzige Live-Stellschraube: NewsMeanGap (wird beim Anlegen einer Woche als Tune_W<w>
--  im DataStore eingefroren, gilt also für alle Server dieser Woche gleich).
--  Der Seed steht NIE hier (Config wird an alle Clients repliziert).
--
--  Abschnitte: 1 Zeit · 2 Rauschen · 3 Risikoklassen · 4 Fundament & Bewertungs-Bremse · 5 Firmen-News ·
--  6 Sektor-News & Makro-Matrix · 7 Quartalszahlen & Analysten · 8 Dividenden · 9 Crash & Rallye ·
--  10 Wochen-Termine (Berlin-Zeit) · 11 Handelspausen · 12 Admin-Markt (§B15.3) · 13 GlobalBus · 14 Kerzen & Historie ·
--  15 Anfragen · 16 IPO-Pipeline · 17 Seed · 18 Fundamentaldaten-Anzeige · Validate(Config)
-- =====================================================================

local Market = {}

-- ---------------------------------------------------------------------
-- 1) ZEIT (EPOCH und Tick kommen aus Shared/Clock: EPOCH = Mo 2026-01-05 00:00 UTC)
-- ---------------------------------------------------------------------
Market.DayTicks = 1200 -- ein Börsentag = 20 min = 1200 Ticks (= Clock.DAY_TICKS)
Market.Delay = 8 -- Lesefenster: so viele Sekunden nach einer Schlagzeile reagiert der Kurs noch NICHT
Market.Tau = 45 -- Reaktions-Rampe (Smoothstep) in Sekunden
Market.Overshoot = { Max = 0.3, Decay = 300, Span = 3600 } -- Übertreibung 0…30 %, bildet sich mit e^(−x/300) zurück
Market.RumorResolve = 120 -- Gerücht: Bestätigung/Dementi nach 2 min (danach wieder 8 s Lesefenster)
Market.QuietEnd = 300 -- in den letzten 5 min einer Woche keine neuen Firmen-News (kein Überhang in die neue Woche)

-- ---------------------------------------------------------------------
-- 2) RAUSCHEN (MARKET §5.1/§5.2): Markt-, Sektor-, Firmen-Feld (14 Oktaven, 2 s … 16.384 s) + Mikrostruktur
-- ---------------------------------------------------------------------
Market.Noise = {
	Beta = 0.45, -- Markt-Feld
	Gamma = 0.55, -- Sektor-Feld
	Eps = 0.70, -- Firmen-Feld (Quadratsumme ≈ 1 -> Korrelation gleicher Sektor 0,52, sonst 0,18)
	Micro = 0.010, -- Mikrostruktur je Sekunde relativ zu Sigma (Bid/Ask-Bounce)
	RegimeK = 0.25, -- R(t) = exp(0,25 · V(t)) · Volatilitäts-Faktor (Crash/Rallye/Admin)
	RegimeOctaves = { 10, 14 }, -- V(t): langsames Feld, Perioden 1.024 s … 16.384 s (≈ 15 min … 4,5 h)
	RegimeRange = { 0.3, 4 }, -- R wird hierauf geklemmt
	Weather = { Calm = 0.85, Storm = 1.2 }, -- R < 0,85 sonnig · bis 1,2 wolkig · darüber Sturm (Markt-Wetter)
}

-- ---------------------------------------------------------------------
-- 3) RISIKOKLASSEN (MARKET §4.1). SpreadBps = voller Spread in Basispunkten (× R(t)), Sigma1s = 1s-Std für die
--    Kerzen-Dochte, VolBase = Grund-Umsatz je Sekunde (Stück), CrashBeta = Stärke bei Crash/Rallye
-- ---------------------------------------------------------------------
Market.Classes = {
	Stabil = { Sigma = 0.030, SpreadBps = 4, NewsFactor = 0.74, Sigma1s = 0.0006, VolBase = 600, CrashBeta = 0.7 },
	Normal = { Sigma = 0.055, SpreadBps = 8, NewsFactor = 1.00, Sigma1s = 0.0011, VolBase = 900, CrashBeta = 1.0 },
	Wild = { Sigma = 0.100, SpreadBps = 16, NewsFactor = 1.35, Sigma1s = 0.0019, VolBase = 1400, CrashBeta = 1.4 },
	ETF = { Sigma = 0, SpreadBps = 3, NewsFactor = 0, Sigma1s = 0.0007, VolBase = 2500, CrashBeta = 1.0 },
}

-- ---------------------------------------------------------------------
-- 4) FUNDAMENT & BEWERTUNGS-BREMSE (MARKET §4.3, §5.4)
--    Drift je Börsentag = Base + Quality · q − Revert · C (q ∈ [−1, 1] je Firma und Woche, geheim, aus dem Seed),
--    C = Bewertung = ln(Wochenbasis / Startkurs) + Drift seit Wochenstart + dauerhafte Sprünge der Woche.
--    Bei C = 0 ist das genau die Spec-Drift (+0,2 % + 0,4 % · q). Der Anker (Revert, Halbwertszeit ≈ 28 Börsentage
--    ≈ 9 h) verhindert, dass Drift, Quartals-Überraschungen (Mittel 0,6 · q) und Dividenden-Abschläge über 504
--    Börsentage je Woche exponentiell wachsen (gemessen ohne Anker: Faktor 100 in einer Woche). C enthält dafür auch
--    die Dividenden (Nennrendite).
--    Liegt C über Above, sinkt zusätzlich die Chance positiver Firmen-News auf PosP (unter −Above spiegelbildlich).
-- ---------------------------------------------------------------------
Market.Drift = { Base = 0.002, Quality = 0.004, Revert = 0.025, MaxRate = 0.04 }
Market.Brake = {
	PosBase = 0.52, -- normal: 52 % der Firmen-News sind positiv
	Steps = { { Above = 0.9, PosP = 0.30 }, { Above = 1.6, PosP = 0.15 } },
}
Market.Price = { MinCents = 50, MaxCents = 9999999 } -- 0,50 … 99.999,99 AKY
Market.Activity = { EdgeMinutes = 3, EdgeMult = 1.4 } -- Umsatz ×1,4 in den ersten/letzten 3 Minuten jedes Börsentags

-- ---------------------------------------------------------------------
-- 5) FIRMEN-NEWS (MARKET §6.1/§6.2)
-- ---------------------------------------------------------------------
Market.NewsMeanGap = 1500 -- Ø Sekunden zwischen zwei News derselben Firma (Live-Stellschraube, 300 … 6000)
Market.Bands = { -- Stärke-Wortschatz: Anteil, |J| von/bis (Klasse Normal; × NewsFactor der Klasse)
	{ P = 0.50, Lo = 0.01, Hi = 0.03 }, -- 1 leicht
	{ P = 0.30, Lo = 0.03, Hi = 0.06 }, -- 2 deutlich
	{ P = 0.15, Lo = 0.06, Hi = 0.12 }, -- 3 massiv
	{ P = 0.05, Lo = 0.12, Hi = 0.25 }, -- 4 historisch
}
Market.Kinds = { Fact = 0.55, Rumor = 0.25, AsExpected = 0.20 }
Market.Rumor = {
	StarsMix = { 0.45, 0.35, 0.20 }, -- Anteil ★ / ★★ / ★★★
	Confirm = { 0.35, 0.60, 0.85 }, -- Bestätigungsquote je Sterne (sichtbar, lernbar)
}

-- ---------------------------------------------------------------------
-- 6) SEKTOR-NEWS & MAKRO (MARKET §6.2, §6.4). Matrix-Faktor × Grundsprung 1,5 % × Überraschung bzw. Themen-Stärke.
-- ---------------------------------------------------------------------
Market.Sector = {
	MeanGap = 600, -- Ø alle 10 min eine Sektor-Nachricht im ganzen Markt
	Sensitivity = { 0.6, 1.4 }, -- Firmen-Sensitivität
	ThemeShare = 0.4, -- Anteil Themen-News (KI-Durchbruch, Chip-Knappheit …) statt einfacher Sektor-News
	ThemeMult = { 1, 2, 3.5 }, -- Themen-Stärke leicht / deutlich / massiv
}
Market.Macro = {
	Minute = 10, -- Ergebnis um :10
	PreviewMinute = 2, -- Konsens um :02
	BaseJump = 0.015,
	SurpriseMax = 2, -- Überraschung s ∈ [−2, 2]
	FlatBelow = 0.25, -- |s| darunter = "wie erwartet" (kein Sprung)
	Kinds = { "Rates", "Growth", "Energy" },
}
Market.Themes = { "Ai", "Chips", "Heat", "Esport", "Space" }
Market.Matrix = { -- Faktor je Sektor (T Tech · E Energie · M Mobilität · K Konsum · G Gaming · F Finanzen)
	Rates = { T = -1.0, E = -0.3, M = -0.6, K = -0.3, G = -0.5, F = 0.8 }, -- Zinsen höher als erwartet
	Growth = { T = 0.6, E = 0.5, M = 0.8, K = 0.6, G = 0.5, F = 0.6 }, -- Konjunktur stärker
	Energy = { T = -0.2, E = 1.0, M = -0.8, K = -0.4, G = -0.1, F = 0 }, -- Energiepreis steigt
	Ai = { T = 1.2, E = 0.4, M = 0.3, K = 0, G = 0.6, F = 0.2 }, -- KI-Durchbruch
	Chips = { T = -0.8, E = 0, M = -0.7, K = 0, G = -0.6, F = 0 }, -- Chip-Knappheit
	Heat = { T = 0, E = 0.5, M = 0, K = 0.6, G = 0.2, F = -0.2 }, -- Hitzewelle
	Esport = { T = 0, E = 0, M = 0, K = 0.2, G = 1.0, F = 0 }, -- Esport-WM
	Space = { T = 0.2, E = 0, M = 0.9, K = 0, G = 0.2, F = 0 }, -- Raumfahrt-Mission
}

-- ---------------------------------------------------------------------
-- 7) QUARTALSZAHLEN & ANALYSTEN (MARKET §6.3, DESIGN §B8.7)
-- ---------------------------------------------------------------------
Market.Earnings = {
	EveryDays = 3, -- Firma i berichtet, wenn (Börsentag + i) % 3 == 0
	Slots = { 3, 7, 11, 15 }, -- Minuten (je 3 Firmen)
	PreviewMinutes = 5, -- Schlagzeile "Zahlen um :xx – Konsens …" 5 min vorher
	SurpriseQ = 0.6, -- s = 0,6 · q + 0,8 · z
	SurpriseZ = 0.8,
	JumpPerS = 0.03, -- J = clamp(0,03 · s · NewsFactor, ±0,20)
	JumpMax = 0.20,
	InlineBelow = 0.004, -- |J| darunter = "im Rahmen der Erwartungen"
	Covering = 3, -- so viele Analysten urteilen je Termin
}
Market.Analysts = { -- erfundene Personen, feste Genauigkeit; angezeigt wird die LIVE gemessene Trefferquote
	{ Key = "MiraSommer", Name = "Mira Sommer", Accuracy = 0.85 },
	{ Key = "JonasFalk", Name = "Jonas Falk", Accuracy = 0.62 },
	{ Key = "LeaBrandt", Name = "Lea Brandt", Accuracy = 0.78 },
	{ Key = "KenjiMori", Name = "Kenji Mori", Accuracy = 0.55 },
	{ Key = "AvaLindqvist", Name = "Ava Lindqvist", Accuracy = 0.81 },
	{ Key = "OmarHaddad", Name = "Omar Haddad", Accuracy = 0.67 },
	{ Key = "ClaraWeiss", Name = "Clara Weiß", Accuracy = 0.72 },
	{ Key = "TheoKranz", Name = "Theo Kranz", Accuracy = 0.58 },
}
Market.AnalystWindow = 30 -- Trefferquote über die letzten 30 Urteile
Market.Research = { BaseLeadMinutes = 2, MaxLeadMinutes = 5 } -- Analysten-Urteile 2 min vor den Zahlen (Know-how: bis 5)

-- ---------------------------------------------------------------------
-- 8) DIVIDENDEN (MARKET §6.3): Zahler schütten am Quartalstag um :19 aus, Betrag je Aktie = round(mid · DivBps/10000),
--    der Kurs fällt im selben Tick um genau diesen Betrag (Dividenden-Mitnahme bringt nichts).
-- ---------------------------------------------------------------------
Market.Dividend = { Minute = 19 }

-- ---------------------------------------------------------------------
-- 9) CRASH & RALLYE (MARKET §6.5): unangekündigt Ø alle 3,5 h, immer mit 3-min-Warnphase
-- ---------------------------------------------------------------------
Market.CrashRally = {
	Rate = 1 / 12600, -- je Tick
	CrashShare = 0.5, -- Anteil Crash (Rest Rallye)
	WarnSeconds = 180,
	WarnRegime = { 1.3, 1.6 }, -- Regime-Faktor steigt in der Warnphase
	PeakRegime = 2.0, -- in der Fallphase
	CrashDrop = { 0.12, 0.30 }, -- × CrashBeta der Klasse
	RallyRise = { 0.08, 0.20 },
	FallSeconds = { 60, 120 },
	RecoverShare = { 0.4, 0.6 }, -- Erholung in Anteilen des Falls
	RecoverSeconds = { 600, 1200 },
	MaxMove = 0.6, -- kein Einzelsprung über 60 %
	QuietEndDays = 3, -- keine Plan-Crashs in den letzten 3 Börsentagen der Woche
	MinGap = 3600, -- Mindestabstand zwischen zwei Plan-Crashs/-Rallyes (s)
}

-- ---------------------------------------------------------------------
-- 10) WOCHEN-TERMINE (Berlin-Ortszeit, über Clock.NextBerlin -> alle Server gleich; DESIGN §B6.3/§B10.4)
--     Dow 1 = Mo … 7 = So. Strength = Bewegung (Anteil), Recover = Rückgabe danach, Scope "Sector" = Sektor (Woche % 6) + 1.
-- ---------------------------------------------------------------------
Market.Weekly = {
	{ Key = "CrashFriday", Dow = 5, HH = 19, MM = 0, Kind = "Crash", Scope = "All", Strength = 0.18, Recover = 0.5 },
	{
		Key = "RallyWednesday",
		Dow = 3,
		HH = 19,
		MM = 0,
		Kind = "Rally",
		Scope = "Sector",
		Strength = 0.12,
		Recover = 0.5,
	},
	{ -- automatische Samstags-Show: abgesagt, wenn bis 18:14:50 ein CancelAutoShow im GlobalBus steht
		Key = "AutoShow",
		Dow = 6,
		HH = 18,
		MM = 15,
		Kind = "Rally",
		Scope = "Sector",
		Strength = 0.15,
		Recover = 0.5,
		Cancelable = true,
		CancelLead = 10,
		Offset = 30, -- Rallye-Schlagzeile 30 s nach Show-Beginn (Banner zuerst)
	},
	{ Key = "Ipo", Dow = 6, HH = 17, MM = 0, Kind = "Ipo" },
}
Market.ShowWindow = { Dow = 6, HH = 18, MM = 0 } -- Admin-Abuse-Termin: Markt-Admin-Events ab hier sagen die Auto-Show ab
Market.CalendarWeeklyDays = 7 -- Wochen-Termine stehen 7 echte Tage vorher im Kalender

-- ---------------------------------------------------------------------
-- 11) HANDELSPAUSEN (MARKET §6.5, §8.4)
-- ---------------------------------------------------------------------
Market.Halts = { AdminSeconds = 10, LateSeconds = 10, IpoSeconds = 60 }

-- ---------------------------------------------------------------------
-- 12) ADMIN-MARKT (§B15.3, MARKET §17) – alles geklemmt, immer global über den GlobalBus
-- ---------------------------------------------------------------------
Market.Admin = {
	Strength = { 0.05, 0.50 }, -- ±5 … 50 %
	Ramp = { 30, 300 },
	Decay = { 300, 3600 }, -- Abklingen 5 … 60 min (gesamt höchstens MaxSpan)
	MaxSpan = 3600, -- Ankündigung bis Ende höchstens 1 h (globale Nachrichten: Until ≤ now + 3600)
	HaltSeconds = { 10, 600 },
	Vol = { 0.5, 3 },
	VolSeconds = { 300, 1800 },
	VolRamp = 30,
	NormalizeSeconds = 60,
	Cooldown = 3, -- Sekunden je Markt-Aktion
	Lead = 10, -- Vorlauf: Aktivierung = jetzt + 10 s (> Poll + Messaging-Latenz)
	WarnSeconds = 180, -- optionale Crash-Warnung
	WindowAfter = 600, -- Admin-Fenster läuft bis 10 min nach dem Abklingen
	NewsMaxChars = 80,
	NewsDecay = 600, -- Admin-Eilmeldung klingt nach 10 min zum Modellkurs zurück
	PeakRegime = 1.6,
}

-- ---------------------------------------------------------------------
-- 13) GLOBALBUS (MARKET §8.2–§8.4; MemoryStore = Wahrheit, Messaging = Schnellweg)
-- ---------------------------------------------------------------------
Market.Bus = {
	PollSeconds = 5,
	ExpirySeconds = 93600, -- 26 h
	PageSize = 50,
	MaxPages = 20,
	Dedupe = 200,
	MaxEvents = 200, -- so viele Bus-Events hält ein Server höchstens
	LogMax = 200, -- Einträge im Admin-Log AdminLog_W<w>
	MaxFuture = 60, -- StartTick höchstens so weit in der Zukunft (Vorlauf + Puffer)
	PollLookback = 30, -- jeder Poll liest die letzten 30 s erneut (Events, die ein anderer Server spät geschrieben hat)
}

-- ---------------------------------------------------------------------
-- 14) KERZEN & HISTORIE (MARKET §9)
-- ---------------------------------------------------------------------
Market.Rings = { S1 = 300, S5 = 360, M1 = 1440 }
Market.Backfill = { ExactHours = 6, SampleHours = 24, SampleStep = 10, FrameMs = 2 }
Market.History = { Candles = 120 } -- je Anfrage höchstens 120 Kerzen (+ 1 Eröffnungsreferenz)
Market.CatchUp = { MaxTicksPerRun = 10, JumpAfter = 60 }
Market.WeekHighCandles = 140 -- Wochen-Hoch-Flag = Hoch der letzten 140 1m-Kerzen (eine 1W-Kerze)

-- ---------------------------------------------------------------------
-- 15) ANFRAGEN (§C9; B = Token-Bucket {Kapazität, Nachfüllen/s})
-- ---------------------------------------------------------------------
Market.Buckets = { MktCandles = { 6, 2 }, MktProfile = { 6, 1 }, MktCalendar = { 6, 1 } }
Market.NewsRate = { 2, 1 } -- MktNews 2/s
Market.NewsKeep = 50 -- News-Liste endlich (letzte 50)

-- ---------------------------------------------------------------------
-- 16) IPO-PIPELINE (v1 Erstnotiz ohne Zeichnung, §B6.3). Saison s, Woche k der Saison -> Season[s][k] notiert
--     Samstag 17:00 Berlin. Eröffnung = Ausgabepreis · (1 + pop), pop ∈ Pop, korreliert mit der Prospekt-Qualität.
-- ---------------------------------------------------------------------
Market.IpoPipeline = {
	FirstWeek = 41, -- Woche seit EPOCH, in der Saison 1 beginnt (41 = Mo 2026-10-19)
	SeasonWeeks = 4,
	Season = { [1] = { 100, 101, 102, 103 } },
	Pop = { -0.10, 0.40 },
	PopBase = 0.15,
	PopQuality = 0.25,
	PopNoise = 0.08,
	ProspectLead = 86400, -- Prospekt 24 h vorher im Kalender
	AdminLead = 600, -- Admin-IPO: Erstnotiz 10 min nach dem Start
	FirstDayClass = "Wild",
	ClassBlend = 300, -- Übergang Wild -> eigene Klasse über 5 min (kein Kurssprung)
}

-- ---------------------------------------------------------------------
-- 17) SEED (MARKET §5.6): DataStore AT_Market_v1 (Config.Tech.MarketStore). Studio -> lokaler Testmarkt.
-- ---------------------------------------------------------------------
Market.Seed = { RetrySeconds = 60, Backoff = { 2, 4, 8, 15, 30 }, PrefetchBefore = 3600 }
Market.StudioSalt = 0x2A7E5713 -- Fallback-Seed = hash4(StudioSalt, w, …) (+ Server-Geheimnis, siehe MarketSeed)

-- ---------------------------------------------------------------------
-- 18) FUNDAMENTALDATEN-ANZEIGE (Firmenprofil; deterministisch, verrät q nur über die Quartale)
-- ---------------------------------------------------------------------
Market.Fundamentals = {
	Pe = { Stabil = 16, Normal = 24, Wild = -40 }, -- Start-KGV (negativ = schreibt Verluste)
	Revenue = { 0.5, 20 }, -- Umsatz je Quartal in Mrd. AKY
	GrowthBase = 0.02,
	GrowthQ = 0.03,
	GrowthS = 0.02,
	EpsS = 0.05,
}

-- =====================================================================
-- PRÜFUNG
-- =====================================================================
local function isNum(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function isInt(n: any): boolean
	return isNum(n) and n % 1 == 0
end

local function pair(t: any): boolean
	return type(t) == "table" and isNum(t[1]) and isNum(t[2]) and t[1] <= t[2]
end

function Market.Validate(config: any): { string }
	local errors: { string } = {}
	local function add(text: string)
		table.insert(errors, "Config.Market: " .. text)
	end
	if Market.DayTicks ~= 1200 then
		add("DayTicks muss 1200 sein (= Clock.DAY_TICKS)")
	end
	for _, key in ipairs({ "Delay", "Tau", "RumorResolve", "NewsMeanGap", "QuietEnd" }) do
		local v = (Market :: any)[key]
		if not isNum(v) or v <= 0 then
			add(key .. ": Zahl > 0 erwartet")
		end
	end
	if isNum(Market.NewsMeanGap) and (Market.NewsMeanGap < 300 or Market.NewsMeanGap > 6000) then
		add("NewsMeanGap: 300 … 6000 erwartet")
	end
	local noise = Market.Noise
	for _, key in ipairs({ "Beta", "Gamma", "Eps", "Micro", "RegimeK" }) do
		if not isNum((noise :: any)[key]) or (noise :: any)[key] < 0 then
			add("Noise." .. key .. ": Zahl ≥ 0 erwartet")
		end
	end
	local oct = noise.RegimeOctaves
	if not pair(oct) or not isInt(oct[1]) or not isInt(oct[2]) or oct[1] < 1 or oct[2] > 14 then
		add("Noise.RegimeOctaves: { von, bis } mit 1 ≤ von ≤ bis ≤ 14 erwartet")
	end
	if not pair(noise.RegimeRange) or noise.RegimeRange[1] <= 0 then
		add("Noise.RegimeRange: { min > 0, max } erwartet")
	end
	for _, name in ipairs({ "Stabil", "Normal", "Wild", "ETF" }) do
		local c = (Market.Classes :: any)[name]
		if type(c) ~= "table" then
			add("Classes." .. name .. " fehlt")
		else
			for _, key in ipairs({ "Sigma", "SpreadBps", "NewsFactor", "Sigma1s", "VolBase", "CrashBeta" }) do
				if not isNum(c[key]) or c[key] < 0 then
					add(("Classes.%s.%s: Zahl ≥ 0 erwartet"):format(name, key))
				end
			end
			if isNum(c.SpreadBps) and c.SpreadBps < 1 then
				add(("Classes.%s.SpreadBps: mindestens 1"):format(name))
			end
		end
	end
	local sum = 0
	for index, band in ipairs(Market.Bands) do
		if not isNum(band.P) or not isNum(band.Lo) or not isNum(band.Hi) or band.Lo > band.Hi or band.Lo < 0 then
			add("Bands[" .. index .. "]: { P, Lo ≤ Hi } erwartet")
		else
			sum += band.P
		end
	end
	if #Market.Bands ~= 4 or math.abs(sum - 1) > 1e-6 then
		add("Bands: genau 4 Bänder mit Anteilen Summe 1 erwartet")
	end
	local kinds = Market.Kinds
	if math.abs((kinds.Fact or 0) + (kinds.Rumor or 0) + (kinds.AsExpected or 0) - 1) > 1e-6 then
		add("Kinds: Fact + Rumor + AsExpected müssen 1 ergeben")
	end
	local mix = 0
	for index = 1, 3 do
		local share = Market.Rumor.StarsMix[index]
		local confirm = Market.Rumor.Confirm[index]
		if not isNum(share) or not isNum(confirm) or confirm < 0 or confirm > 1 then
			add("Rumor: StarsMix/Confirm je 3 Werte erwartet")
			break
		end
		mix += share
	end
	if math.abs(mix - 1) > 1e-6 then
		add("Rumor.StarsMix: Summe 1 erwartet")
	end
	local sectors = { "T", "E", "M", "K", "G", "F" }
	for row, factors in pairs(Market.Matrix) do
		for _, key in ipairs(sectors) do
			if not isNum((factors :: any)[key]) then
				add(("Matrix.%s.%s: Zahl erwartet"):format(tostring(row), key))
			end
		end
	end
	for _, kind in ipairs(Market.Macro.Kinds) do
		if (Market.Matrix :: any)[kind] == nil then
			add("Macro.Kinds: " .. kind .. " fehlt in der Matrix")
		end
	end
	for _, theme in ipairs(Market.Themes) do
		if (Market.Matrix :: any)[theme] == nil then
			add("Themes: " .. theme .. " fehlt in der Matrix")
		end
	end
	if #Market.Earnings.Slots ~= 4 then
		add("Earnings.Slots: 4 Minuten erwartet")
	end
	for _, minute in ipairs(Market.Earnings.Slots) do
		if not isInt(minute) or minute < 1 or minute > 18 then
			add("Earnings.Slots: Minuten 1…18 erwartet")
		end
	end
	if #Market.Analysts ~= 8 then
		add("Analysts: genau 8 erwartet")
	end
	for _, analyst in ipairs(Market.Analysts) do
		if type(analyst.Name) ~= "string" or not isNum(analyst.Accuracy) then
			add("Analysts: { Key, Name, Accuracy } erwartet")
		elseif analyst.Accuracy < 0.5 or analyst.Accuracy > 0.95 then
			add("Analysts." .. tostring(analyst.Key) .. ": Genauigkeit 0,5 … 0,95 erwartet")
		end
	end
	if not isInt(Market.Earnings.Covering) or Market.Earnings.Covering < 1 or Market.Earnings.Covering > 8 then
		add("Earnings.Covering: 1…8 erwartet")
	end
	local cr = Market.CrashRally
	for _, key in ipairs({ "CrashDrop", "RallyRise", "FallSeconds", "RecoverShare", "RecoverSeconds", "WarnRegime" }) do
		if not pair((cr :: any)[key]) then
			add("CrashRally." .. key .. ": { von ≤ bis } erwartet")
		end
	end
	local seenWeekly: { [string]: boolean } = {}
	for _, entry in ipairs(Market.Weekly) do
		local key = tostring(entry.Key)
		if seenWeekly[key] then
			add("Weekly: doppelter Schlüssel " .. key)
		end
		seenWeekly[key] = true
		if not isInt(entry.Dow) or entry.Dow < 1 or entry.Dow > 7 then
			add("Weekly." .. key .. ".Dow: 1…7 erwartet")
		end
		if
			not isInt(entry.HH)
			or entry.HH < 0
			or entry.HH > 23
			or not isInt(entry.MM)
			or entry.MM < 0
			or entry.MM > 59
		then
			add("Weekly." .. key .. ": HH 0…23 und MM 0…59 erwartet")
		end
		if entry.Kind ~= "Crash" and entry.Kind ~= "Rally" and entry.Kind ~= "Ipo" then
			add("Weekly." .. key .. ".Kind: Crash/Rally/Ipo erwartet")
		end
		if entry.Kind ~= "Ipo" and (not isNum(entry.Strength) or entry.Strength <= 0 or entry.Strength > 0.5) then
			add("Weekly." .. key .. ".Strength: 0 … 0,5 erwartet")
		end
	end
	local admin = Market.Admin
	for _, key in ipairs({ "Strength", "Ramp", "Decay", "HaltSeconds", "Vol", "VolSeconds" }) do
		if not pair((admin :: any)[key]) then
			add("Admin." .. key .. ": { von ≤ bis } erwartet")
		end
	end
	if not isNum(admin.MaxSpan) or admin.MaxSpan > 3600 then
		add("Admin.MaxSpan: höchstens 3600 (globale Nachrichten §C13)")
	end
	if not isNum(admin.Lead) or admin.Lead < 6 then
		add("Admin.Lead: mindestens 6 s (Poll + Messaging-Latenz)")
	end
	if not isNum(Market.Bus.PollSeconds) or Market.Bus.PollSeconds < 1 then
		add("Bus.PollSeconds: mindestens 1")
	end
	if isNum(admin.Lead) and isNum(Market.Bus.PollSeconds) and admin.Lead <= Market.Bus.PollSeconds then
		add("Admin.Lead muss größer als Bus.PollSeconds sein")
	end
	for _, key in ipairs({ "S1", "S5", "M1" }) do
		local v = (Market.Rings :: any)[key]
		if not isInt(v) or v < 60 or v > 5000 then
			add("Rings." .. key .. ": 60 … 5000 erwartet")
		end
	end
	if not isInt(Market.History.Candles) or Market.History.Candles < 10 or Market.History.Candles > 300 then
		add("History.Candles: 10 … 300 erwartet")
	end
	for name, bucket in pairs(Market.Buckets) do
		if not pair(bucket) or bucket[1] < 1 then
			add("Buckets." .. tostring(name) .. ": { Kapazität ≥ 1, Nachfüllen } erwartet")
		end
	end
	local pipeline = Market.IpoPipeline
	if not isInt(pipeline.FirstWeek) or not isInt(pipeline.SeasonWeeks) or pipeline.SeasonWeeks < 1 then
		add("IpoPipeline: FirstWeek/SeasonWeeks ganzzahlig erwartet")
	end
	if not pair(pipeline.Pop) or pipeline.Pop[1] < -0.5 or pipeline.Pop[2] > 1 then
		add("IpoPipeline.Pop: { −0,5 … 1 } erwartet")
	end
	if type(pipeline.Season) == "table" then
		local companies = type(config) == "table" and config.Companies or nil
		local byId = type(companies) == "table" and companies.ById or nil
		local used: { [number]: boolean } = {}
		for season, ids in pairs(pipeline.Season) do
			if not isInt(season) or type(ids) ~= "table" then
				add("IpoPipeline.Season: { [Saison] = { Id … } } erwartet")
				continue
			end
			if #ids > (pipeline.SeasonWeeks or 4) then
				add(("IpoPipeline.Season[%d]: höchstens %d IPOs (eins je Woche)"):format(season, pipeline.SeasonWeeks))
			end
			for _, id in ipairs(ids) do
				if used[id] then
					add("IpoPipeline: Id " .. tostring(id) .. " doppelt")
				end
				used[id] = true
				local inst = type(byId) == "table" and byId[id] or nil
				if type(byId) == "table" and (type(inst) ~= "table" or inst.Ipo ~= true) then
					add("IpoPipeline: Id " .. tostring(id) .. " ist keine IPO-Firma in Config.Companies")
				end
			end
		end
	else
		add("IpoPipeline.Season: Tabelle erwartet")
	end
	if not isInt(Market.StudioSalt) or Market.StudioSalt < 1 then
		add("StudioSalt: ganze Zahl > 0 erwartet")
	end
	return errors
end

return Market
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">News</string>
            <string name="Source"><![CDATA[-- =====================================================================
--  AKYTEX TYCOON – Schlagzeilen-Vorlagen der Markt-Engine (Config.News)
--  Besitzer: WP3 (Markt-Engine). Vertrag: DESIGN.md §C14.2 ("Vorlagen-Schlüssel je Art mit Parametern"), §C15, §B7.4;
--  MARKET.md §6.2. Die Texte selbst stehen DE/EN in Shared/Lang/News.luau (Präfix "news.").
--
--  So funktioniert eine News (Types.NewsItem): der Server schickt NUR Schlüssel + Parameter, der CLIENT lokalisiert.
--    Key  = einer der Schlüssel unten          Args = { name = "Cognivo KI", band = "news.band.2", … }
--    Platzhalter im Text: {name} {band} {amt} {stars} {buyer} {product} {sector} {cons} {min} {secs}
--    Ersetzen (Client, z. B. NewsFeed):  text = Lang.T(lang, item.Key)
--      text = text:gsub("{(%a+)}", function(k) local v = item.Args[k]
--        if type(v) == "string" and Lang.Has(v) then return Lang.T(lang, v) end; return tostring(v or "") end)
--    -> Werte, die selbst "news."-Schlüssel sind (band, sector, product, cons), werden ebenfalls übersetzt.
--    {band} ist das Stärke-Wort (fett anzeigen), NewsItem.Band = 1…4, Stars = 1…3 bei Gerüchten,
--    Dir = +1/−1 = Ton der Schlagzeile (bei Fakt/Bestätigung/Dementi/Zahlen = echte Kursrichtung).
--    Admin-Eilmeldung: Key "news.admin", der gefilterte Text steht in NewsItem.Text { de, en }.
--  Wortliste §0.7 beachten (keine Glücksspiel-/Hebel-/Krypto-Wörter, kein "garantiert").
--
--  Inhalt: Fact/Rumor/AsExpected { Up, Down } · Confirm · Deny · Sector · Theme · Macro · Earnings · Dividend · Warn ·
--          Crash · Rally · Weekly · Ipo · Admin · Halt · Resume · Bands · Sectors · Products · Cons · Stars · Validate
-- =====================================================================

local News = {}

-- ---------------------------------------------------------------------
-- 1) FIRMEN-NEWS (Fakt 55 % · Gerücht 25 % · "wie erwartet" 20 %)
-- ---------------------------------------------------------------------
News.Fact = {
	Up = {
		"news.fact.up.contract", -- {name} {amt} {band}
		"news.fact.up.product", -- {name} {product} {band}
		"news.fact.up.partner", -- {name} {buyer} {band}
		"news.fact.up.sales",
		"news.fact.up.expansion",
		"news.fact.up.award",
		"news.fact.up.record",
		"news.fact.up.patent", -- {product}
		"news.fact.up.customers",
	},
	Down = {
		"news.fact.down.recall",
		"news.fact.down.outage",
		"news.fact.down.delay", -- {product}
		"news.fact.down.lostdeal", -- {buyer}
		"news.fact.down.fine",
		"news.fact.down.supply",
		"news.fact.down.hack",
		"news.fact.down.strike",
		"news.fact.down.costs",
	},
}
News.Rumor = { -- immer mit {stars}
	Up = { "news.rumor.up.takeover", "news.rumor.up.deal", "news.rumor.up.product", "news.rumor.up.partner" },
	Down = { "news.rumor.down.ceo", "news.rumor.down.problems", "news.rumor.down.probe", "news.rumor.down.delay" },
}
News.AsExpected = { -- klingt gut (Up) bzw. schlecht (Down) – der Kurs reagiert umgekehrt ("sell the news")
	Up = { "news.expected.up.profit", "news.expected.up.sales", "news.expected.up.outlook" },
	Down = { "news.expected.down.profit", "news.expected.down.sales", "news.expected.down.outlook" },
}
News.Confirm = "news.confirm"
News.Deny = "news.deny"

-- ---------------------------------------------------------------------
-- 2) SEKTOR, THEMEN, MAKRO
-- ---------------------------------------------------------------------
News.Sector = { Up = "news.sector.up", Down = "news.sector.down" } -- {sector} {band}
